# the MIR-to-SPIR-V module emitter: the SPIR-V back-half spine
#
# This is the whole back half for the SPIR-V target. Where a machine target runs
# instruction selection, register allocation, frame layout, and byte encoding, a
# SPIR-V target does none of those: `codegen_module` forks after MIR lowering and
# calls `emit_module` here, which consumes the post-lower MIR and emits a finished
# SPIR-V module directly. There are no registers to allocate and no linear machine
# code - the output is a typed, SSA-flavoured word stream.
#
# The value model (the key move): every MIR virtual register becomes an
# `OpVariable` in the function's local (`Function`) storage class, and every MIR
# operation becomes load-operands / compute / store-result. Post-lower MIR is
# already out of SSA (phis are predecessor-end moves), so a vreg may be assigned in
# several blocks; the variable model expresses that as plain stores without
# reconstructing phis. A downstream consumer runs mem2reg to recover SSA.
#
# Scalar types are rebuilt from MIR facts (width + float/int register class) per
# the machine-neutral type mapping; integer signedness rides the operation
# (OpSDiv vs OpUDiv), never the type. The function signature and linkage come from
# the IR function.
#
# A TYPE ID, never a width, is what travels with a value here. MIR is width-typed
# and class-typed separately - an operand is "four bytes" and its vreg is "in the
# float bank" - but SPIR-V wants one id, and an operand that is not a vreg (an
# immediate, or a value sitting in the ABI's nominal register file) has no bank to
# read. So every read of an operand is told the SPIR-V type the CONSUMER declares
# for that position, and an immediate is minted against it: an f32 literal reaches
# MIR as its IEEE bit pattern in a plain integer immediate, and only the consumer's
# declared type says to spell those bits `OpConstant %float` rather than
# `OpConstant %uint`. Threading a width instead is what let `ret 1.5;` emit a
# 64-bit integer constant out of an f32 function - a module mach's own reader
# round-tripped happily and spirv-val rejected.
#
# Control flow is reconstructed rather than laid out: SPIR-V requires structured
# regions, so `cfg.analyze` derives the merge blocks, continue targets, and block
# order from the MIR CFG, and this module emits that structure. A shape the
# reconstruction cannot express is refused by name.
#
# Milestone scope: scalar functions over the reconstructed control flow - integer
# and floating-point arithmetic, comparisons, negation, the width and int/float
# conversions, bit reinterpretation, moves, branches, direct calls, returns.
# Aggregates, memory addressing, inline asm, and vectors are out of this milestone
# and raise a loud, precise diagnostic rather than emitting an invalid module.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.source;
use mach.lang.target.resolved;
use mach.lang.me.ir;
use mach.lang.me.ir.type;
use mach.lang.be.codegen.mir;
use mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.cfg;
use mach.lang.target.isa.spirv.types;

# the per-module emission state threaded through the walk
#
# The allocator and interner come from the MIR module (as they do for the machine
# encoders), never a session: this module is composed under `mach.lang.target` and
# so cannot depend on `session`, which imports the composition root.
# ---
# alloc:    allocator backing every emitter allocation (the MIR module's)
# interner: session interner, for resolving function names
# tgt:      the resolved target (its model supplies the default machine word width)
# ir:       the IR module (function signatures + linkage)
# b:        the SPIR-V module builder
# tt:       the type / constant dedup table over `b`
# fn_ids:   SPIR-V id per IR function index, allocated before any body is emitted
#           so a call can name a callee defined later in the module (0 for a
#           function with no body)
# has_entry: whether any function in the module declares a pipeline stage, which
#           decides whether this is a shader module (entry points, no Linkage) or a
#           library module (Linkage exports, no entry point)
# gvar_ids: SPIR-V OpVariable id per IR global index, allocated before any body is
#           emitted so a load or store can name a variable declared later (0 for a
#           global carrying no interface role)
# iface_ids: the Input / Output variable ids, in declaration order; an entry point
#           lists the subset of these it can reach
# iface_len: how many of `iface_ids` are live
# gslot:    per IR global index, one more than its slot in `iface_ids`, or 0 when
#           the global is not entry-point interface
# iface_use: an (IR function) x (interface slot) matrix, 1 where that function can
#           reach that variable, transitively through its calls. an entry point
#           lists exactly its own row
rec Emit {
    alloc:     *A.Allocator;
    interner:  *intern.Interner;
    tgt:       *resolved.Target;
    ir:        *ir.Module;
    b:         *spirv.Builder;
    tt:        *types.TypeTable;
    fn_ids:    *u32;
    has_entry: bool;
    gvar_ids:  *u32;
    iface_ids: *u32;
    iface_len: u32;
    gslot:     *u32;
    iface_use: *u8;

    # the refusal context: which function is being emitted and which instruction
    # is being translated, so a refusal can say so without every site threading
    # them (#2656). stamped at the two chokepoints below - function entry and
    # instruction dispatch - the same way MIR stamps `loc` at `push_instr`, and
    # read only by `unsupported`. `cur_instr` is cleared on entering a function so
    # a whole-function refusal cannot inherit the previous function's last one.
    srcmap:    *source.SourceMap;
    cur_fn:    *mir.MirFunction;
    cur_instr: *mir.MirInstr;
}

# the per-function value maps, sized to the function's vreg count
#
# ---
# type_id: SPIR-V element type id per vreg (0 when the vreg has no determined type)
# var_id:  SPIR-V OpVariable id per vreg (0 when the vreg needs no variable)
# is_bool: whether the vreg holds a boolean (defined by a comparison)
# n:       number of vregs
rec VMaps {
    type_id: *u32;
    var_id:  *u32;
    is_bool: *bool;
    n:       u32;
}

# the identity convention's nominal register file during one block's emission
#
# A value moved into "register" k is the k-th argument of the call that follows or
# the function's result, and both are typed by the callee's declaration, not by the
# move. An immediate therefore rides here unmaterialized: `is_imm` marks the slot as
# carrying `imm` rather than an id, and the constant is minted at the use site with
# the width the declaration asks for. A parameter's slot holds its
# OpFunctionParameter id from the start.
# ---
# val_id: the SSA id held in each register index (0 when empty or pending)
# imm:    the pending immediate value per register index
# is_imm: whether the slot holds a pending immediate rather than an id
rec Regs {
    val_id: [16]u32;
    imm:    [16]i64;
    is_imm: [16]bool;
}

# emit a complete SPIR-V module for one lowered MIR module
#
# Builds the module preamble (Shader + Linkage capabilities, the logical GLSL450
# memory model), then emits one exported `OpFunction` per defined MIR function,
# and serializes the whole into a little-endian byte image. The bytes are
# allocated from the session allocator and handed back through the out-params; the
# `codegen_module` fork wraps them into an object image.
#
# This is the concrete `EmitModuleFn` the SPIR-V `ModuleEmitter.emit_module` erased
# pointer is cast back to. The allocator and interner ride the MIR module.
# ---
# tgt:      the resolved target
# irmod:    the IR module (signatures + linkage)
# mirmod:   the post-lower MIR module (also supplies the allocator + interner)
# out_bytes: receives the owned little-endian module image
# out_len:   receives the image byte length
# ret:      true on success, or a precise error string
pub fun emit_module(tgt: *resolved.Target, irmod: *ir.Module,
                    mirmod: *mir.MirModule, out_bytes: **u8, out_len: *u32) R.Result[bool, str] {
    if (tgt == nil || irmod == nil || mirmod == nil) {
        ret R.err[bool, str]("spirv.emit: nil argument");
    }

    var b: spirv.Builder = spirv.builder_init(mirmod.alloc);
    var tt: types.TypeTable = types.types_init(?b);

    var e: Emit;
    e.alloc = mirmod.alloc; e.interner = mirmod.interner;
    e.tgt = tgt; e.ir = irmod; e.b = ?b; e.tt = ?tt; e.fn_ids = nil;
    e.gvar_ids = nil; e.iface_ids = nil; e.iface_len = 0;
    e.gslot = nil; e.iface_use = nil;
    e.srcmap = mirmod.srcmap; e.cur_fn = nil; e.cur_instr = nil;

    # a module is a shader module or a library module, never both, and which one is
    # settled before any function is emitted: the answer decides both the capability
    # set and whether each function is published under a linkage export.
    e.has_entry = false;
    var si: u32 = 0;
    for (si < irmod.function_len) {
        if (irmod.functions[si].stage != ir.STAGE_NONE
            && (irmod.functions[si].flags & ir.FN_FLAG_EXTERN) == 0) { e.has_entry = true; }
        si = si + 1;
    }

    # every defined function gets its id before any body is emitted, so a call can
    # name a callee that appears later in the module (or itself).
    if (irmod.function_len > 0) {
        val rf: R.Result[*u32, str] = A.allocate[u32](mirmod.alloc, irmod.function_len::usize);
        if (R.is_err[*u32, str](rf)) {
            types.types_dnit(?tt);
            spirv.builder_dnit(?b);
            ret R.err[bool, str](R.unwrap_err[*u32, str](rf));
        }
        e.fn_ids = R.unwrap_ok[*u32, str](rf);
        var ii: u32 = 0;
        for (ii < irmod.function_len) {
            e.fn_ids[ii] = 0;
            if ((irmod.functions[ii].flags & ir.FN_FLAG_EXTERN) == 0) {
                e.fn_ids[ii] = spirv.alloc_id(?b);
            }
            ii = ii + 1;
        }
    }

    # interface variables are declared before any body, both because a SPIR-V global
    # must precede the functions that use it and because every entry point has to
    # name the same interface list.
    val gr: R.Result[bool, str] = declare_interface(?e);
    if (R.is_err[bool, str](gr)) {
        emit_dnit(?e, irmod.function_len);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gr;
    }

    val ur: R.Result[bool, str] = build_iface_uses(?e, mirmod);
    if (R.is_err[bool, str](ur)) {
        emit_dnit(?e, irmod.function_len);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret ur;
    }

    var fi: u32 = 0;
    for (fi < mirmod.function_len) {
        val mf: *mir.MirFunction = ?mirmod.functions[fi];
        # a body-less MIR function (an extern declaration) lowers to an empty shell;
        # it contributes no OpFunction (SPIR-V imports are a later phase).
        if (mf.block_count == 0) { fi = fi + 1; cnt; }
        val fr: R.Result[bool, str] = emit_function(?e, mf);
        if (R.is_err[bool, str](fr)) {
            emit_dnit(?e, irmod.function_len);
            types.types_dnit(?tt);
            spirv.builder_dnit(?b);
            ret fr;
        }
        fi = fi + 1;
    }
    emit_dnit(?e, irmod.function_len);

    # the preamble is emitted last so it can declare exactly the width capabilities
    # the functions' types accumulated; it still serializes first (fixed section order).
    emit_preamble(?e);

    var len: u32 = 0;
    val rs: R.Result[*u8, str] = spirv.serialize(?b, ?len);
    types.types_dnit(?tt);
    spirv.builder_dnit(?b);
    if (R.is_err[*u8, str](rs)) { ret R.err[bool, str](R.unwrap_err[*u8, str](rs)); }
    @out_bytes = R.unwrap_ok[*u8, str](rs);
    @out_len   = len;
    ret R.ok[bool, str](true);
}

# release the per-module function-id table
# ---
# e: the emission state
# n: the IR module's function count (the table's length)
fun emit_dnit(e: *Emit, n: u32) {
    if (e.fn_ids != nil && n > 0) { A.deallocate[u32](e.alloc, e.fn_ids, n::usize); }
    e.fn_ids = nil;
    if (e.gvar_ids != nil && e.ir.global_len > 0) {
        A.deallocate[u32](e.alloc, e.gvar_ids, e.ir.global_len::usize);
    }
    e.gvar_ids = nil;
    if (e.iface_ids != nil && e.ir.global_len > 0) {
        A.deallocate[u32](e.alloc, e.iface_ids, e.ir.global_len::usize);
    }
    e.iface_ids = nil;
    if (e.gslot != nil && e.ir.global_len > 0) {
        A.deallocate[u32](e.alloc, e.gslot, e.ir.global_len::usize);
    }
    e.gslot = nil;
    if (e.iface_use != nil && n > 0 && e.iface_len > 0) {
        A.deallocate[u8](e.alloc, e.iface_use, (n * e.iface_len)::usize);
    }
    e.iface_use = nil;
    e.iface_len = 0;
}

# declare one global OpVariable per interface-roled global, with its decorations
#
# A shader stage does not receive its inputs or hand back its outputs through a
# call: it reads and writes module-scope variables in the Input, Output, and
# Uniform storage classes, and the pipeline binds them by the decorations attached
# here. So a mach global carrying `#[input(N)]`, `#[output(N)]`, `#[builtin("...")]`,
# or `#[uniform(set, binding)]` becomes one of those variables rather than an
# ordinary data symbol.
#
# The Input and Output variables are also collected into the entry-point interface
# list, which every OpEntryPoint must name in full.
# ---
# e:   the emission state
# ret: true on success, or a precise error string
fun declare_interface(e: *Emit) R.Result[bool, str] {
    val n: u32 = e.ir.global_len;
    if (n == 0) { ret R.ok[bool, str](true); }

    val rg: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rg)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rg)); }
    e.gvar_ids = R.unwrap_ok[*u32, str](rg);
    val ri: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](ri)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ri)); }
    e.iface_ids = R.unwrap_ok[*u32, str](ri);

    val rs: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rs)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rs)); }
    e.gslot = R.unwrap_ok[*u32, str](rs);

    var i: u32 = 0;
    for (i < n) { e.gvar_ids[i] = 0; e.iface_ids[i] = 0; e.gslot[i] = 0; i = i + 1; }

    i = 0;
    for (i < n) {
        val g: *ir.Global = ?e.ir.globals[i];
        if (g.iface == ir.IFACE_NONE) { i = i + 1; cnt; }

        var storage: u32 = spirv.STORAGE_INPUT;
        if (g.iface == ir.IFACE_OUTPUT)      { storage = spirv.STORAGE_OUTPUT; }
        or (g.iface == ir.IFACE_UNIFORM)     { storage = spirv.STORAGE_UNIFORM; }
        or (g.iface == ir.IFACE_BUILTIN)     { storage = builtin_storage(g.iface_a); }

        var value_ty: u32 = 0;
        if (g.iface == ir.IFACE_UNIFORM) {
            # a Uniform variable must be a Block-decorated struct: Vulkan rejects a
            # bare scalar or vector in that storage class outright, so the mach type
            # has to be a record and the block layout is emitted with it.
            val ur: R.Result[u32, str] = uniform_block_type(e, g.ty);
            if (R.is_err[u32, str](ur)) { ret R.err[bool, str](R.unwrap_err[u32, str](ur)); }
            value_ty = R.unwrap_ok[u32, str](ur);
        }
        or { value_ty = ir_value_spv_type(e, g.ty); }
        if (value_ty == 0) {
            ret unsupported(e, unsupported_ir_type(e, g.ty,
                "unsupported shader interface variable type in the SPIR-V target"));
        }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, value_ty);
        val var_id: u32 = spirv.alloc_id(e.b);
        var vop: [3]u32;
        vop[0] = ptr_ty; vop[1] = var_id; vop[2] = storage;
        spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], 3);
        e.gvar_ids[i] = var_id;

        if (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) {
            decorate(e, var_id, spirv.DECOR_LOCATION, g.iface_a);
        }
        if (g.iface == ir.IFACE_BUILTIN) {
            decorate(e, var_id, spirv.DECOR_BUILTIN, builtin_selector(g.iface_a));
        }
        if (g.iface == ir.IFACE_UNIFORM) {
            decorate(e, var_id, spirv.DECOR_DESCRIPTOR_SET, g.iface_a);
            decorate(e, var_id, spirv.DECOR_BINDING, g.iface_b);
        }
        # only the per-invocation classes are entry-point interface; a descriptor is
        # reached through its binding, not through the interface list.
        if (g.iface != ir.IFACE_UNIFORM) {
            e.iface_ids[e.iface_len] = var_id;
            e.gslot[i] = e.iface_len + 1;
            e.iface_len = e.iface_len + 1;
        }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# build the Block-decorated struct type behind a uniform variable
#
# A Uniform variable's type is not the mach record directly: it is an
# `OpTypeStruct` carrying a `Block` decoration and an explicit `Offset` on every
# member. Vulkan requires all three - a bare scalar or vector in Uniform storage is
# rejected, and a block whose members carry no offsets has no defined layout for a
# host to write into. The offsets come from the same layout the rest of the
# compiler uses, so what the shader reads is what the host wrote.
# ---
# e:   the emission state
# id:  the IR type of the uniform global
# ret: the OpTypeStruct id, or a precise error string
fun uniform_block_type(e: *Emit, id: type.IrTypeId) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(?e.ir.types, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform global has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind != type.IRT_STRUCT) {
        ret R.err[u32, str]("a `#[uniform(...)]` variable must be a `rec`: a uniform is a descriptor-bound BLOCK with a host-visible layout, and a bare scalar or vector has no block layout for a pipeline to bind. wrap the value in a record with one field");
    }
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret R.err[u32, str]("a `#[uniform(...)]` block must have between 1 and 16 fields");
    }

    var members: [16]u32;
    var i: u32 = 0;
    for (i < n) {
        val mt: u32 = ir_value_spv_type(e, t.data.struct_.fields[i]);
        if (mt == 0) {
            ret R.err[u32, str](unsupported_ir_type(e, t.data.struct_.fields[i],
                "unsupported uniform block member type in the SPIR-V target"));
        }
        members[i] = mt;
        i = i + 1;
    }
    val struct_id: u32 = types.type_struct(e.tt, ?members[0], n);
    if (struct_id == 0) { ret R.err[u32, str]("spirv.emit: could not build a uniform block type"); }

    var bops: [2]u32;
    bops[0] = struct_id; bops[1] = spirv.DECOR_BLOCK;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?bops[0], 2);

    i = 0;
    for (i < n) {
        var mops: [4]u32;
        mops[0] = struct_id; mops[1] = i; mops[2] = spirv.DECOR_OFFSET;
        mops[3] = type.byte_offset(?e.ir.types, id, i, e.tgt);
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_MEMBER_DECORATE, ?mops[0], 4);
        i = i + 1;
    }
    ret R.ok[u32, str](struct_id);
}

# compute, per IR function, which interface variables it can reach
#
# An entry point's interface list must name the Input and Output variables THAT
# entry point uses, not every one the module declares. Listing them all is legal
# SPIR-V from 1.4 on, but it makes each stage inherit every other stage's
# variables, and Vulkan's rules are per stage: an integer Input on a fragment entry
# point needs a Flat decoration, so a vertex stage's `vertex_index` dragged into a
# fragment stage's list makes that fragment stage invalid. The variable is not
# really the fragment stage's at all, so the fix is to stop claiming it.
#
# Reachability is transitive: a stage that calls a helper touching an interface
# variable uses that variable. The closure is a fixpoint over direct calls, which
# terminates because the matrix only ever gains entries.
# ---
# e:      the emission state
# mirmod: the lowered MIR module
# ret:    true on success, or an allocation error
fun build_iface_uses(e: *Emit, mirmod: *mir.MirModule) R.Result[bool, str] {
    if (e.iface_len == 0 || e.ir.function_len == 0) { ret R.ok[bool, str](true); }
    val cells: u32 = e.ir.function_len * e.iface_len;
    val ru: R.Result[*u8, str] = A.allocate[u8](e.alloc, cells::usize);
    if (R.is_err[*u8, str](ru)) { ret R.err[bool, str](R.unwrap_err[*u8, str](ru)); }
    e.iface_use = R.unwrap_ok[*u8, str](ru);
    var c: u32 = 0;
    for (c < cells) { e.iface_use[c] = 0; c = c + 1; }

    # direct uses: any symbol operand naming an interface variable.
    var fi: u32 = 0;
    for (fi < mirmod.function_len) {
        val mf: *mir.MirFunction = ?mirmod.functions[fi];
        val fx: u32 = ir_function_index(e.ir, mf.name);
        if (fx == IR_FN_NONE) { fi = fi + 1; cnt; }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32 = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM) {
                        val slot: u32 = iface_slot_of(e, mi.operands[oi].sym);
                        if (slot != 0) { e.iface_use[fx * e.iface_len + slot - 1] = 1; }
                    }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }

    # transitive closure over direct calls.
    var changed: bool = true;
    for (changed) {
        changed = false;
        fi = 0;
        for (fi < mirmod.function_len) {
            val mf: *mir.MirFunction = ?mirmod.functions[fi];
            val fx: u32 = ir_function_index(e.ir, mf.name);
            if (fx == IR_FN_NONE) { fi = fi + 1; cnt; }
            var bi: u32 = 0;
            for (bi < mf.block_count) {
                val blk: *mir.MirBlock = ?mf.blocks[bi];
                var ii: u32 = 0;
                for (ii < blk.instr_count) {
                    val mi: *mir.MirInstr = ?blk.instrs[ii];
                    if (mi.opcode == mir.MIR_CALL && mi.operand_count >= 1
                        && mi.operands[0].kind == mir.MIR_OP_SYM) {
                        val cx: u32 = ir_function_index(e.ir, mi.operands[0].sym);
                        if (cx != IR_FN_NONE) {
                            var s: u32 = 0;
                            for (s < e.iface_len) {
                                if (e.iface_use[cx * e.iface_len + s] != 0
                                    && e.iface_use[fx * e.iface_len + s] == 0) {
                                    e.iface_use[fx * e.iface_len + s] = 1;
                                    changed = true;
                                }
                                s = s + 1;
                            }
                        }
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            fi = fi + 1;
        }
    }
    ret R.ok[bool, str](true);
}

# whether an IR function can reach the interface variable in `slot`
# ---
# e:    the emission state
# fn_ix: the IR function index
# slot: the interface slot
# ret:  true when the function uses that variable
fun uses_iface(e: *Emit, fn_ix: u32, slot: u32) bool {
    if (e.iface_use == nil || fn_ix >= e.ir.function_len || slot >= e.iface_len) { ret false; }
    ret e.iface_use[fn_ix * e.iface_len + slot] != 0;
}

# one more than an interface variable's slot for an interned global name, or 0
# ---
# e:    the emission state
# name: the global's interned name
# ret:  slot + 1, or 0 when the name is not entry-point interface
fun iface_slot_of(e: *Emit, name: intern.StrId) u32 {
    if (e.gslot == nil) { ret 0; }
    var i: u32 = 0;
    for (i < e.ir.global_len) {
        if (e.ir.globals[i].name == name) { ret e.gslot[i]; }
        i = i + 1;
    }
    ret 0;
}

# emit a one-operand OpDecorate
# ---
# e:      the emission state
# target: the id being decorated
# decor:  the decoration
# operand: the decoration's single literal operand
fun decorate(e: *Emit, target: u32, decor: u32, operand: u32) {
    var ops: [3]u32;
    ops[0] = target; ops[1] = decor; ops[2] = operand;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 3);
}

# the SPIR-V BuiltIn selector for one of mach's built-in names
# ---
# which: the ir.BUILTIN_* value
# ret:   the SPIR-V BuiltIn decoration operand
fun builtin_selector(which: u32) u32 {
    if (which == ir.BUILTIN_VERTEX_INDEX)      { ret spirv.BUILTIN_VERTEX_INDEX; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)    { ret spirv.BUILTIN_INSTANCE_INDEX; }
    if (which == ir.BUILTIN_FRAG_COORD)        { ret spirv.BUILTIN_FRAG_COORD; }
    if (which == ir.BUILTIN_POINT_SIZE)        { ret spirv.BUILTIN_POINT_SIZE; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION) { ret spirv.BUILTIN_GLOBAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)  { ret spirv.BUILTIN_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_WORKGROUP_ID)      { ret spirv.BUILTIN_WORKGROUP_ID; }
    ret spirv.BUILTIN_POSITION;
}

# the storage class a built-in lives in
#
# A built-in's direction is a property of the built-in, not something the author
# restates: a stage WRITES its position and point size and READS everything the
# pipeline hands it. Deriving it here is what keeps `#[builtin("...")]` a single
# directive rather than one that must be paired with an input/output marker that
# could disagree with it.
# ---
# which: the ir.BUILTIN_* value
# ret:   spirv.STORAGE_INPUT or spirv.STORAGE_OUTPUT
fun builtin_storage(which: u32) u32 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE) {
        ret spirv.STORAGE_OUTPUT;
    }
    ret spirv.STORAGE_INPUT;
}

# the SPIR-V variable id backing an IR global, or 0 when it has no interface role
# ---
# e:    the emission state
# name: the global's interned name
# ret:  the OpVariable id, or 0
fun global_var_id(e: *Emit, name: intern.StrId) u32 {
    if (e.gvar_ids == nil) { ret 0; }
    var i: u32 = 0;
    for (i < e.ir.global_len) {
        if (e.ir.globals[i].name == name) { ret e.gvar_ids[i]; }
        i = i + 1;
    }
    ret 0;
}

# emit the module preamble: capabilities and the memory model
#
# Declares Shader + Linkage plus the width capabilities the functions' types
# accumulated (Int64 for a 64-bit integer, Float64 for an f64, and so on). Called
# after every function so `caps_needed` is complete.
# ---
# e: the emission state
fun emit_preamble(e: *Emit) {
    emit_cap(e, spirv.CAP_SHADER);
    # Linkage is what lets a module with no entry point publish its functions to a
    # consumer, and it is the RIGHT thing for a compiled mach library. It is also
    # forbidden in a module meant for a Vulkan pipeline: a shader module is complete
    # in itself and declares no external linkage, and spirv-val rejects the
    # capability outright under a Vulkan environment. So the two are exclusive, and
    # the presence of an entry point is what decides which module this is.
    if (!e.has_entry) { emit_cap(e, spirv.CAP_LINKAGE); }
    val need: u32 = e.b.caps_needed;
    if ((need & spirv.NEED_INT8) != 0)    { emit_cap(e, spirv.CAP_INT8); }
    if ((need & spirv.NEED_INT16) != 0)   { emit_cap(e, spirv.CAP_INT16); }
    if ((need & spirv.NEED_INT64) != 0)   { emit_cap(e, spirv.CAP_INT64); }
    if ((need & spirv.NEED_FLOAT16) != 0) { emit_cap(e, spirv.CAP_FLOAT16); }
    if ((need & spirv.NEED_FLOAT64) != 0) { emit_cap(e, spirv.CAP_FLOAT64); }
    var mm: [2]u32;
    mm[0] = spirv.ADDRESSING_LOGICAL;
    mm[1] = spirv.MEMORY_GLSL450;
    spirv.inst(e.b, ?e.b.memory_model, spirv.OP_MEMORY_MODEL, ?mm[0], 2);
}

# emit one OpCapability
# ---
# e:   the emission state
# cap: the capability operand
fun emit_cap(e: *Emit, cap: u32) {
    var o: [1]u32;
    o[0] = cap;
    spirv.inst(e.b, ?e.b.caps, spirv.OP_CAPABILITY, ?o[0], 1);
}

# emit one exported OpFunction for a defined MIR function
#
# Rebuilds the signature from the IR function, declares the parameters, emits an
# OpVariable per body vreg at the entry, reconstructs the structured control flow,
# then translates each block in the reconstruction's order. The function is
# decorated Export under its own name.
# ---
# e:  the emission state
# mf: the MIR function to emit
# ret: true on success, or a precise error string
fun emit_function(e: *Emit, mf: *mir.MirFunction) R.Result[bool, str] {
    e.cur_fn = mf;
    e.cur_instr = nil;
    val fix: u32 = ir_function_index(e.ir, mf.name);
    if (fix == IR_FN_NONE) {
        ret R.err[bool, str]("spirv.emit: no IR function matches a lowered MIR function");
    }
    val irfn: *ir.Function = ?e.ir.functions[fix];

    # signature: return type + parameter types from the IR function.
    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        ret unsupported(e, unsupported_ir_type(e, ir_return_type(e, irfn),
                                               "unsupported return type in the SPIR-V target"));
    }
    var ptypes: [16]u32;
    if (irfn.param_count > 16) { ret unsupported(e, "more than 16 parameters is not supported by the SPIR-V target"); }
    var pi: u32 = 0;
    for (pi < irfn.param_count) {
        val pt: u32 = ir_value_spv_type(e, irfn.params[pi].ty);
        if (pt == 0) {
            ret unsupported(e, unsupported_ir_type(e, irfn.params[pi].ty,
                                                   "unsupported parameter type in the SPIR-V target"));
        }
        ptypes[pi] = pt;
        pi = pi + 1;
    }
    val fnty: u32 = types.type_fn(e.tt, ret_ty, ?ptypes[0], irfn.param_count);

    val fn_id: u32 = e.fn_ids[fix];

    val name_opt: O.Option[str] = intern.lookup(e.interner, mf.name);
    if (O.is_none[str](name_opt)) { ret R.err[bool, str]("spirv.emit: function name not interned"); }
    val fn_name: str = O.unwrap[str](name_opt);

    # a staged function becomes an entry point; in a library module every function is
    # published under a linkage export instead. The two are exclusive: SPIR-V forbids
    # decorating an entry point with LinkageAttributes, and a Vulkan module may not
    # declare the Linkage capability at all.
    if (irfn.stage != ir.STAGE_NONE) {
        val er: R.Result[bool, str] = emit_entry_point(e, irfn, fix, fn_id, entry_name(e, irfn, fn_name), returns_void);
        if (R.is_err[bool, str](er)) { ret er; }
    }
    or (!e.has_entry) { emit_linkage_export(e, fn_id, fn_name); }

    # a vector materialized through memory is refused up front, under its own name.
    # Reaching it instruction by instruction would report the `alloca` that opens the
    # sequence, which is the least informative part of it.
    if (builds_vector_through_memory(e, mf)) {
        ret unsupported(e, "constructing a vector from a literal or an uninitialized local is not yet supported by the SPIR-V target: the front end materializes one as an array allocation written lane by lane and read back as a whole vector, and reinterpreting an allocation through its pointer is not expressible under the logical addressing model. derive the vector from an existing vector value instead - lane assignment onto a parameter, or arithmetic");
    }

    # the structured shape of the body, or a refusal naming the construct.
    val cr: R.Result[cfg.Structure, str] = cfg.analyze(mf, e.alloc);
    if (R.is_err[cfg.Structure, str](cr)) { ret R.err[bool, str](R.unwrap_err[cfg.Structure, str](cr)); }
    var st: cfg.Structure = R.unwrap_ok[cfg.Structure, str](cr);
    if (st.status != cfg.CFG_OK) {
        val msg: str = cfg_refusal(e, fn_name, ?st);
        cfg.dnit(?st);
        ret R.err[bool, str](msg);
    }

    # OpFunction <ret_ty> <fn_id> None <fnty>.
    var fop: [4]u32;
    fop[0] = ret_ty; fop[1] = fn_id; fop[2] = spirv.FUNCTION_CONTROL_NONE; fop[3] = fnty;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION, ?fop[0], 4);

    # one OpFunctionParameter per IR parameter, in order.
    var param_ids: [16]u32;
    pi = 0;
    for (pi < irfn.param_count) {
        val pid: u32 = spirv.alloc_id(e.b);
        var pp: [2]u32;
        pp[0] = ptypes[pi]; pp[1] = pid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_PARAMETER, ?pp[0], 2);
        param_ids[pi] = pid;
        pi = pi + 1;
    }

    # one label id per node, allocated before any block is emitted so a branch can
    # name a block the walk has not reached.
    val rl: R.Result[*u32, str] = A.allocate[u32](e.alloc, st.count::usize);
    if (R.is_err[*u32, str](rl)) {
        cfg.dnit(?st);
        ret R.err[bool, str](R.unwrap_err[*u32, str](rl));
    }
    val labels: *u32 = R.unwrap_ok[*u32, str](rl);
    var li: u32 = 0;
    for (li < st.count) { labels[li] = spirv.alloc_id(e.b); li = li + 1; }

    # the entry label opens the body; every Function-storage variable lives here.
    var lb: [1]u32;
    lb[0] = labels[st.order[0]];
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);

    var vm: VMaps;
    val mr: R.Result[bool, str] = build_vmaps(e, mf, irfn, ?vm);
    if (R.is_err[bool, str](mr)) {
        A.deallocate[u32](e.alloc, labels, st.count::usize);
        cfg.dnit(?st);
        ret mr;
    }

    var body: R.Result[bool, str] = R.ok[bool, str](true);
    var oi: u32 = 0;
    for (oi < st.count) {
        body = emit_node(e, mf, ?st, st.order[oi], oi == 0, labels, ?vm,
                         ?param_ids[0], irfn.param_count, returns_void, ret_ty);
        if (R.is_err[bool, str](body)) { oi = st.count; cnt; }
        oi = oi + 1;
    }

    vmaps_dnit(e, ?vm);
    A.deallocate[u32](e.alloc, labels, st.count::usize);
    cfg.dnit(?st);
    if (R.is_err[bool, str](body)) { ret body; }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_END, nil, 0);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: module builder hit an allocation error"); }
    ret R.ok[bool, str](true);
}

# whether a function materializes a vector by reading one out of addressed memory
#
# The signature of the vector-literal / zero-init lowering: an `alloca [4]f32`
# written lane by lane, then a whole-vector `load f32x4` off the same pointer. The
# vector-tagged load is the identifying part, since the allocation itself is an
# ordinary array and carries no lane descriptor.
# ---
# An access that names a shader interface variable directly is excluded: that is a
# vector arriving from or leaving through the pipeline, not one built out of a
# reinterpreted allocation, and it is exactly what the interface support exists for.
# ---
# e:   the emission state
# mf:  the MIR function
# ret: true when a vector-typed load or store reads addressed memory
fun builds_vector_through_memory(e: *Emit, mf: *mir.MirFunction) bool {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if ((mi.opcode == mir.MIR_LOAD || mi.opcode == mir.MIR_STORE)
                && mir.vec_lane_is_vector(mi.vec_lane)
                && mi.operand_count == 2) {
                # a load addresses through operand 1, a store through operand 0.
                var addr: u32 = 0;
                if (mi.opcode == mir.MIR_LOAD) { addr = 1; }
                if (interface_target(e, ?mi.operands[addr]) == 0) { ret true; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# the diagnostic for a CFG the reconstruction cannot express, naming the function
# and the block the shape was found at
#
# The message is interned so the caller need not own it; interning failure falls
# back to the bare reason, which still names the construct.
# ---
# e:    the emission state
# name: the function's exported name
# st:   the failed reconstruction
# ret:  the diagnostic text
fun cfg_refusal(e: *Emit, name: str, st: *cfg.Structure) str {
    val reason: str = cfg.status_message(st.status);
    val jr: R.Result[str, str] = str_join(e.alloc, "spirv.emit: ", name, ": ", reason);
    if (R.is_err[str, str](jr)) { ret reason; }
    val buf: str = R.unwrap_ok[str, str](jr);
    val ir: R.Result[intern.StrId, str] = intern.intern(e.interner, buf);
    A.deallocate[u8](e.alloc, buf::*u8, str_len(buf) + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret reason; }
    val io: O.Option[str] = intern.lookup(e.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_none[str](io)) { ret reason; }
    ret O.unwrap[str](io);
}

# emit one node of the reconstruction: its label, its body, its merge declaration,
# and its terminator
#
# A real block contributes its MIR instructions; the synthesized nodes carry no MIR
# and exist only to give the structure the shape SPIR-V requires - a loop's single
# back edge, a construct's merge point, a header's displaced branch.
# ---
# e:            the emission state
# mf:           the MIR function
# st:           the reconstructed structure
# ix:           the node to emit
# is_entry:     whether this is the function's first block (its label is already out)
# labels:       the per-node label ids
# vm:           the per-vreg value maps
# param_ids:    the OpFunctionParameter ids, in order
# param_count:  number of parameters
# returns_void: whether the function returns void
# ret_ty:       the SPIR-V return type id, which types a returned immediate
# ret:          true on success, or a precise error string
fun emit_node(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, is_entry: bool,
              labels: *u32, vm: *VMaps, param_ids: *u32, param_count: u32,
              returns_void: bool, ret_ty: u32) R.Result[bool, str] {
    if (!is_entry) {
        var lb: [1]u32;
        lb[0] = labels[ix];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
    }

    val role: u8 = st.nodes[ix].role;
    if (role == cfg.ROLE_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret R.ok[bool, str](true);
    }
    if (role == cfg.ROLE_CONTINUE || role == cfg.ROLE_FORWARD) {
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret R.ok[bool, str](true);
    }

    # the register file is per block: the ABI pre-coloring a lowered call or return
    # emits never spans one, and a physical register index is otherwise a parameter
    # position, valid for the whole function.
    var rg: Regs;
    var i: u32 = 0;
    for (i < 16) { rg.val_id[i] = 0; rg.imm[i] = 0; rg.is_imm[i] = false; i = i + 1; }
    i = 0;
    for (i < param_count && i < 16) { rg.val_id[i] = param_ids[i]; i = i + 1; }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    if (role == cfg.ROLE_REAL) {
        var ii: u32 = 0;
        for (ii + 1 < blk.instr_count) {
            val r: R.Result[bool, str] = emit_instr(e, mf, vm, ?rg, ?blk.instrs[ii]);
            if (R.is_err[bool, str](r)) { ret r; }
            ii = ii + 1;
        }
    }

    ret emit_terminator(e, mf, st, ix, labels, vm, ?rg, returns_void, ret_ty);
}

# declare where a construct's control reconverges, ahead of its branch
# ---
# e:      the emission state
# st:     the reconstructed structure
# ix:     the header node
# labels: the per-node label ids
fun emit_merge(e: *Emit, st: *cfg.Structure, ix: u32, labels: *u32) {
    if (st.nodes[ix].kind == cfg.CK_LOOP) {
        var lm: [3]u32;
        lm[0] = labels[st.nodes[ix].merge];
        lm[1] = labels[st.nodes[ix].cont];
        lm[2] = spirv.LOOP_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOOP_MERGE, ?lm[0], 3);
        ret;
    }
    if (st.nodes[ix].kind == cfg.CK_SELECTION) {
        var sm: [2]u32;
        sm[0] = labels[st.nodes[ix].merge];
        sm[1] = spirv.SELECTION_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECTION_MERGE, ?sm[0], 2);
    }
}

# emit one OpBranch
# ---
# e:     the emission state
# label: the target label id
fun emit_branch(e: *Emit, label: u32) {
    var o: [1]u32;
    o[0] = label;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH, ?o[0], 1);
}

# emit a node's terminator from the reconstruction's successor edges
#
# The branch targets come from the structure, not the MIR terminator: a back edge
# was rewritten to the loop's continue block, and a header whose branch was
# displaced falls into its split block instead. Only the condition and the returned
# value still come from the MIR.
# ---
# e:            the emission state
# mf:           the MIR function
# st:           the reconstructed structure
# ix:           the node being terminated
# labels:       the per-node label ids
# vm:           the per-vreg value maps
# preg_val:     the identity convention's nominal register file
# returns_void: whether the function returns void
# ret_ty:       the SPIR-V return type id, which types a returned immediate
# ret:          true on success, or a precise error string
fun emit_terminator(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, labels: *u32,
                    vm: *VMaps, preg_val: *Regs, returns_void: bool, ret_ty: u32) R.Result[bool, str] {
    # a header that kept no branch of its own falls into the block carrying it.
    if (st.nodes[ix].split != cfg.NO_BLOCK) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].split]);
        ret R.ok[bool, str](true);
    }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    # the terminator is the instruction any refusal below is about; without this
    # stamp one would name the last BODY instruction instead, which is a wrong
    # attribution rather than a missing one
    e.cur_instr = term;

    if (term.opcode == mir.MIR_BR) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret R.ok[bool, str](true);
    }
    if (term.opcode == mir.MIR_CBR) {
        # the condition is materialized ahead of the merge declaration: SPIR-V wants
        # the merge instruction immediately before the branch it describes.
        val cond: u32 = read_condition(e, vm, preg_val, ?term.operands[0]);
        if (cond == 0) { ret R.err[bool, str]("spirv.emit: unreadable branch condition"); }
        emit_merge(e, st, ix, labels);
        var bc: [3]u32;
        bc[0] = cond;
        bc[1] = labels[st.nodes[ix].succ0];
        bc[2] = labels[st.nodes[ix].succ1];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH_CONDITIONAL, ?bc[0], 3);
        ret R.ok[bool, str](true);
    }
    if (term.opcode == mir.MIR_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret R.ok[bool, str](true);
    }
    if (term.opcode == mir.MIR_RET) {
        if (returns_void) {
            spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN, nil, 0);
            ret R.ok[bool, str](true);
        }
        val rid: u32 = reg_value(e, preg_val, 0, ret_ty);
        if (rid == 0) { ret R.err[bool, str]("spirv.emit: value return with no pre-colored result"); }
        var rv: [1]u32;
        rv[0] = rid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN_VALUE, ?rv[0], 1);
        ret R.ok[bool, str](true);
    }
    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

# produce a boolean SSA value for a conditional branch's condition
#
# A vreg defined by a comparison already holds a SPIR-V boolean; anything else is
# a numeric flag, which is compared against a zero of its own type to become one.
# The float form uses the UNORDERED inequality, so a NaN flag reads as true - the
# same reading the x86-64 float compare gives it.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# op:       the condition operand
# ret:      the boolean SSA id, or 0 on failure
fun read_condition(e: *Emit, vm: *VMaps, preg_val: *Regs, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_VREG) { e.b.err = true; ret 0; }
    val v: u32 = op.vreg;
    if (v >= vm.n) { e.b.err = true; ret 0; }
    val ty: u32 = vm.type_id[v];
    val raw: u32 = read_operand(e, vm, preg_val, op, ty);
    if (e.b.err || raw == 0) { ret 0; }
    if (vm.is_bool[v]) { ret raw; }

    var cmp_ty: u32 = ty;
    if (cmp_ty == 0) { cmp_ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    var opcode: u32 = spirv.OP_I_NOT_EQUAL;
    if (types.type_is_float(e.tt, cmp_ty)) { opcode = spirv.OP_F_UNORD_NOT_EQUAL; }
    val zero: u32 = types.const_scalar(e.tt, cmp_ty, 0, 0);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = types.type_bool(e.tt); ops[1] = result; ops[2] = raw; ops[3] = zero;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], 4);
    ret result;
}

# the name a consumer looks an entry point up by: the function's BARE source name
#
# Not the mangled linkage name the rest of the back end uses. An entry point name is
# a lookup key passed to a pipeline-creation call, not a linker symbol - and a
# shader module declares no Linkage capability at all, so the mangled name has
# nothing to refer to inside one. Falls back to the linkage name only for a
# synthesized function carrying no source spelling, which cannot currently declare a
# stage anyway.
# ---
# e:       the emission state
# irfn:    the IR function
# linkage: the mangled linkage name, the fallback
# ret:     the entry point name
fun entry_name(e: *Emit, irfn: *ir.Function, linkage: str) str {
    if (irfn.disp == intern.STR_NIL) { ret linkage; }
    val opt: O.Option[str] = intern.lookup(e.interner, irfn.disp);
    if (O.is_none[str](opt)) { ret linkage; }
    ret O.unwrap[str](opt);
}

# emit the OpEntryPoint, and the execution modes the stage requires
#
# SPIR-V constrains an entry function's signature hard: it takes no parameters and
# returns void, because a pipeline stage's inputs and outputs travel through
# interface VARIABLES rather than through a call. That is checked here rather than
# left to the validator, so a mach signature that cannot be a stage is reported
# against the function that declared the stage.
#
# The interface operand list names every Input and Output variable the entry point
# statically uses. It is empty until interface variables exist, which is valid: an
# entry point that reads and writes nothing has nothing to list.
#
# Two execution modes are not optional under Vulkan and are emitted with the stage
# rather than left to the author: a fragment stage must fix its framebuffer origin,
# and a compute stage must declare its workgroup size.
# ---
# e:            the emission state
# irfn:         the IR function (its stage and workgroup dimensions)
# fn_ix:        the function's IR index, which selects its interface-use row
# fn_id:        the function's SPIR-V id
# name:         the entry point's name, as a consumer will look it up
# returns_void: whether the function returns void
# ret:          true on success, or a precise error string
fun emit_entry_point(e: *Emit, irfn: *ir.Function, fn_ix: u32, fn_id: u32, name: str,
                     returns_void: bool) R.Result[bool, str] {
    if (!returns_void) {
        ret unsupported(e, "a function declaring a `#[stage(...)]` must return nothing: a pipeline stage's results leave through its output interface variables, not through a return value");
    }
    if (irfn.param_count != 0) {
        ret unsupported(e, "a function declaring a `#[stage(...)]` must take no parameters: a pipeline stage's inputs arrive through its input interface variables, not as arguments");
    }

    var model: u32 = spirv.EXEC_MODEL_VERTEX;
    if (irfn.stage == ir.STAGE_FRAGMENT) { model = spirv.EXEC_MODEL_FRAGMENT; }
    or (irfn.stage == ir.STAGE_COMPUTE)  { model = spirv.EXEC_MODEL_GLCOMPUTE; }

    # OpEntryPoint <model> <fn> "<name>" <interface...>. The interface names every
    # Input and Output variable the entry point can reach. Listing the module's whole
    # set rather than the subset one stage touches is permitted from SPIR-V 1.4 on and
    # is what a module targeting 1.6 wants: the alternative is a reachability walk
    # whose only effect would be to shorten a list a consumer does not read for size.
    val sw: u32 = spirv.string_words(name);
    var used: u32 = 0;
    var si: u32 = 0;
    for (si < e.iface_len) {
        if (uses_iface(e, fn_ix, si)) { used = used + 1; }
        si = si + 1;
    }
    val total: u32 = 2 + sw + used;
    val ra: R.Result[*u32, str] = A.allocate[u32](e.alloc, total::usize);
    if (R.is_err[*u32, str](ra)) { ret R.err[bool, str](R.unwrap_err[*u32, str](ra)); }
    val ops: *u32 = R.unwrap_ok[*u32, str](ra);
    ops[0] = model;
    ops[1] = fn_id;
    spirv.pack_string(name, ?ops[2]);
    var ii: u32 = 0;
    si = 0;
    for (si < e.iface_len) {
        if (uses_iface(e, fn_ix, si)) { ops[2 + sw + ii] = e.iface_ids[si]; ii = ii + 1; }
        si = si + 1;
    }
    spirv.inst(e.b, ?e.b.entry_points, spirv.OP_ENTRY_POINT, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);

    if (irfn.stage == ir.STAGE_FRAGMENT) {
        var fm: [2]u32;
        fm[0] = fn_id; fm[1] = spirv.EXEC_MODE_ORIGIN_UPPER_LEFT;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?fm[0], 2);
    }
    if (irfn.stage == ir.STAGE_COMPUTE) {
        var cm: [5]u32;
        cm[0] = fn_id; cm[1] = spirv.EXEC_MODE_LOCAL_SIZE;
        cm[2] = irfn.wg_x; cm[3] = irfn.wg_y; cm[4] = irfn.wg_z;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?cm[0], 5);
    }
    ret R.ok[bool, str](true);
}

# emit the LinkageAttributes Export decoration for a function
# ---
# e:    the emission state
# fn:   the function id to decorate
# name: the exported symbol name
fun emit_linkage_export(e: *Emit, fn: u32, name: str) {
    val sw: u32 = spirv.string_words(name);
    # target + decoration + string words + linkage type.
    val total: u32 = 3 + sw;
    val ra: R.Result[*u32, str] = A.allocate[u32](e.alloc, total::usize);
    if (R.is_err[*u32, str](ra)) { e.b.err = true; ret; }
    val ops: *u32 = R.unwrap_ok[*u32, str](ra);
    ops[0] = fn;
    ops[1] = spirv.DECOR_LINKAGE_ATTRIBUTES;
    spirv.pack_string(name, ?ops[2]);
    ops[2 + sw] = spirv.LINKAGE_EXPORT;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);
}

# build the per-vreg type and variable maps, emitting one Function-storage
# OpVariable per defined vreg at the current (entry) position
#
# A vreg's element type is its definition's width and register class: a vreg
# defined by a comparison is boolean; otherwise it is the integer / float type of
# the defining instruction's result width. Every defined vreg gets a variable so a
# later block's store and a use's load resolve to the same storage.
# ---
# A parameter vreg is typed from the IR signature rather than its pre-coloring
# move width: an i32 parameter rides a word-width register move but is logically
# i32, so trusting the move width would over-widen it.
# ---
# e:    the emission state
# mf:   the MIR function
# irfn: the IR function (for parameter types)
# out:  receives the initialized maps (owned; freed by vmaps_dnit)
# ret:  true on success, or a precise error string
fun build_vmaps(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) R.Result[bool, str] {
    val n: u32 = mf.vreg_count;
    out.n = n;
    out.type_id = nil;
    out.var_id  = nil;
    out.is_bool = nil;
    if (n == 0) { ret R.ok[bool, str](true); }

    val rt: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rt)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rt)); }
    out.type_id = R.unwrap_ok[*u32, str](rt);
    val rv: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rv)) { ret R.err[bool, str](R.unwrap_err[*u32, str](rv)); }
    out.var_id = R.unwrap_ok[*u32, str](rv);
    val rb: R.Result[*bool, str] = A.allocate[bool](e.alloc, n::usize);
    if (R.is_err[*bool, str](rb)) { ret R.err[bool, str](R.unwrap_err[*bool, str](rb)); }
    out.is_bool = R.unwrap_ok[*bool, str](rb);

    var i: u32 = 0;
    for (i < n) { out.type_id[i] = 0; out.var_id[i] = 0; out.is_bool[i] = false; i = i + 1; }

    # a vreg fed from a nominal register is typed by the DECLARATION behind that
    # register, never by the move: the ABI pre-coloring is emitted at the machine
    # word, so an i32 parameter or an i32 call result would over-widen. Register k
    # means parameter k at the head of the function and the return value right after
    # a call, so the two are told apart by the call that precedes the move.
    var pb: u32 = 0;
    for (pb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[pb];
        var ei: u32 = 0;
        var callee: intern.StrId = intern.STR_NIL;
        for (ei < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ei];
            if (mi.opcode == mir.MIR_CALL && mi.operand_count >= 1 && mi.operands[0].kind == mir.MIR_OP_SYM) {
                callee = mi.operands[0].sym;
            }
            or (mi.opcode == mir.MIR_CALL_RES) { callee = intern.STR_NIL; }
            or (mi.opcode == mir.MIR_MOV && mi.operand_count == 2 &&
                mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[1].kind == mir.MIR_OP_PREG) {
                val k: u32 = mi.operands[1].preg;
                val v: u32 = mi.operands[0].vreg;
                var t: u32 = 0;
                if (callee != intern.STR_NIL) {
                    val cix: u32 = ir_function_index(e.ir, callee);
                    if (cix != IR_FN_NONE) {
                        var cvoid: bool = false;
                        t = ir_return_spv_type(e, ?e.ir.functions[cix], ?cvoid);
                        if (cvoid) { t = 0; }
                    }
                    callee = intern.STR_NIL;
                }
                or (k < irfn.param_count) {
                    t = ir_value_spv_type(e, irfn.params[k].ty);
                }
                if (t != 0 && v < n && out.type_id[v] == 0) {
                    out.type_id[v] = t;
                    out.is_bool[v] = false;
                }
            }
            ei = ei + 1;
        }
        pb = pb + 1;
    }

    # a vreg's type comes from the operation that computes it. A register copy is
    # not one - it moves a value already typed elsewhere - so copies are left for the
    # propagation below and only revisited if nothing typed them.
    val r1: R.Result[bool, str] = type_computed_defs(e, mf, out, true);
    if (R.is_err[bool, str](r1)) { ret r1; }
    propagate_copy_types(mf, out);
    val r2: R.Result[bool, str] = type_computed_defs(e, mf, out, false);
    if (R.is_err[bool, str](r2)) { ret r2; }

    # emit one OpVariable(Function) per defined vreg, at the entry, and record its id.
    i = 0;
    for (i < n) {
        if (out.type_id[i] != 0) {
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, out.type_id[i]);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop: [3]u32;
            vop[0] = ptr_ty; vop[1] = var_id; vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            out.var_id[i] = var_id;
        }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

# type every vreg a computing instruction defines, from its result width and class
#
# A comparison yields a boolean; anything else yields the integer or float type of
# the defining instruction's result width. When `skip_copies` is set, a register-to-
# register move is passed over: its width is the machine word the ABI and phi
# lowering copy at, not the value's, so its destination is typed by propagation
# instead.
# ---
# e:           the emission state
# mf:          the MIR function
# out:         the maps being filled
# skip_copies: leave register-to-register moves untyped
# ret:         true on success, or a precise error string
fun type_computed_defs(e: *Emit, mf: *mir.MirFunction, out: *VMaps, skip_copies: bool) R.Result[bool, str] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg;
                if (v < out.n && out.type_id[v] == 0 && !(skip_copies && is_reg_copy(mi))) {
                    # a LANE-WISE comparison yields mach's mask vector, not a
                    # boolean: only a scalar comparison defines a SPIR-V bool.
                    val boolean: bool = (mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP)
                                     && !mir.vec_lane_is_vector(mi.vec_lane);
                    out.is_bool[v] = boolean;
                    if (boolean) {
                        out.type_id[v] = types.type_bool(e.tt);
                    }
                    or {
                        var bytes: u32 = mi.width::u32;
                        if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
                        val t: u32 = value_type_for(e, mf, mi, v, bytes::u8);
                        if (t == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
                        out.type_id[v] = t;
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok[bool, str](true);
}

# whether an instruction is a register-to-register copy, whose destination type is
# the source's rather than the move's width
# ---
# mi:  the instruction
# ret: true for a move or declassify from a virtual or physical register
fun is_reg_copy(mi: *mir.MirInstr) bool {
    if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_DECLASSIFY) { ret false; }
    if (mi.operand_count != 2) { ret false; }
    ret mi.operands[1].kind == mir.MIR_OP_VREG || mi.operands[1].kind == mir.MIR_OP_PREG;
}

# carry types across register copies to a fixed point
#
# The phi edge copies a lowered `if` / `for` leaves behind are emitted at the machine
# word, so a copied i32 or boolean would come out 64 bits wide. The destination takes
# the source's type instead.
# ---
# mf:  the MIR function
# out: the maps being filled
fun propagate_copy_types(mf: *mir.MirFunction, out: *VMaps) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG &&
                    mi.operands[1].kind == mir.MIR_OP_VREG) {
                    val d:  u32 = mi.operands[0].vreg;
                    val sv: u32 = mi.operands[1].vreg;
                    if (d < out.n && sv < out.n && out.type_id[d] == 0 && out.type_id[sv] != 0) {
                        out.type_id[d] = out.type_id[sv];
                        out.is_bool[d] = out.is_bool[sv];
                        changed = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

# free the per-vreg maps
# ---
# e:  the emission state (its allocator owns the maps)
# vm: the maps to free
fun vmaps_dnit(e: *Emit, vm: *VMaps) {
    if (vm.type_id != nil) { A.deallocate[u32](e.alloc, vm.type_id, vm.n::usize); }
    if (vm.var_id != nil)  { A.deallocate[u32](e.alloc, vm.var_id, vm.n::usize); }
    if (vm.is_bool != nil) { A.deallocate[bool](e.alloc, vm.is_bool, vm.n::usize); }
    vm.type_id = nil; vm.var_id = nil; vm.is_bool = nil; vm.n = 0;
}

# the SPIR-V scalar type of one lane of a lane descriptor, or 0 when unmappable
# ---
# e:    the emission state
# lane: the packed lane descriptor
# ret:  the lane's SPIR-V scalar type id, or 0
fun lane_type_of(e: *Emit, lane: u8) u32 {
    val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
    if (mir.vec_lane_kind(lane) == mir.VEC_LANE_FLOAT) {
        if (bits != 32 && bits != 64) { ret 0; }
        ret types.type_float(e.tt, bits);
    }
    if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
    ret types.type_int(e.tt, bits);
}

# the SPIR-V vector type a lane descriptor names, or 0 when unmappable
# ---
# e:       the emission state
# lane:    the packed lane descriptor
# as_int:  force integer lanes at the descriptor's width, for a comparison mask
# ret:     the OpTypeVector id, or 0
fun vector_type_of(e: *Emit, lane: u8, as_int: bool) u32 {
    var lane_ty: u32 = 0;
    if (as_int) {
        val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
        lane_ty = types.type_int(e.tt, bits);
    }
    or { lane_ty = lane_type_of(e, lane); }
    if (lane_ty == 0) { ret 0; }
    ret types.type_vector(e.tt, lane_ty, mir.vec_lane_count(lane));
}

# the SPIR-V type a defining instruction gives its result vreg
#
# For a scalar result the register class picks integer vs float and the width
# (defaulting to the machine word when unset) picks the bit width. For a vector
# result the instruction's `vec_lane` descriptor carries both the LANE class and
# the lane width - and it, not the register class, is the authority there, because
# the whole vector rides one nominal bank. Returns 0 for a shape the milestone does
# not map, including a lane count SPIR-V reserves for Kernel modules.
# ---
# e:     the emission state
# mf:    the MIR function (for the vreg's register class)
# mi:    the defining instruction
# vreg:  the vreg id
# width: the defining instruction's result width in bytes (0 = unset)
# ret:   the SPIR-V type id, or 0
fun value_type_for(e: *Emit, mf: *mir.MirFunction, mi: *mir.MirInstr, vreg: u32, width: u8) u32 {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        # a lane read is the one vector-tagged instruction whose RESULT is a scalar:
        # the descriptor describes the vector it reads out of, not what it produces.
        if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret lane_type_of(e, mi.vec_lane); }
        # a comparison's result is mach's mask: the UNSIGNED INTEGER vector of the
        # compared lanes' width, never a vector of the compared class. SPIR-V's own
        # boolean vector is an intermediate inside emit_vector_compare, not this type.
        val as_int: bool = mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP;
        ret vector_type_of(e, mi.vec_lane, as_int);
    }
    var bytes: u32 = width::u32;
    if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
    val bits: u32 = bytes * 8;
    if (mir.vreg_is_fp(mf, vreg)) {
        if (bits == 32 || bits == 64) { ret types.type_float(e.tt, bits); }
        ret 0;
    }
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) { ret types.type_int(e.tt, bits); }
    ret 0;
}

# the SPIR-V type of an IR value type id (int / float / vector), or 0 when
# unsupported
#
# A vector maps lane-for-lane onto `OpTypeVector`, which is why the SPIR-V target
# declares a vector unit and lets vectors through MIR intact rather than
# scalarizing them. A lane count SPIR-V reserves for Kernel modules comes back 0
# here and is reported by the caller under the type's own name.
# ---
# e:  the emission state
# id: the IR type id
# ret: the SPIR-V type id, or 0
fun ir_value_spv_type(e: *Emit, id: type.IrTypeId) u32 {
    val opt: O.Option[*type.IrType] = type.get(?e.ir.types, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_INT)   { ret types.type_int(e.tt, t.data.bits); }
    if (t.kind == type.IRT_FLOAT) { ret types.type_float(e.tt, t.data.bits); }
    if (t.kind == type.IRT_VECTOR) {
        val elem: u32 = ir_value_spv_type(e, t.data.vector_.element);
        if (elem == 0) { ret 0; }
        ret types.type_vector(e.tt, elem, t.data.vector_.lanes);
    }
    ret 0;
}

# the SPIR-V return type of an IR function: void, or a scalar; 0 when unsupported
#
# Also reports whether the return is void, which the terminator needs to choose
# OpReturn over OpReturnValue.
# ---
# e:        the emission state
# irfn:     the IR function
# out_void: receives whether the return type is void
# ret:      the SPIR-V type id, or 0
fun ir_return_spv_type(e: *Emit, irfn: *ir.Function, out_void: *bool) u32 {
    @out_void = false;
    val sig_opt: O.Option[*type.IrType] = type.get(?e.ir.types, irfn.sig);
    if (O.is_none[*type.IrType](sig_opt)) { ret 0; }
    val sig: *type.IrType = O.unwrap[*type.IrType](sig_opt);
    if (sig.kind != type.IRT_FN) { ret 0; }
    val rt: type.IrTypeId = sig.data.fn.ret_type;
    val rt_opt: O.Option[*type.IrType] = type.get(?e.ir.types, rt);
    if (O.is_none[*type.IrType](rt_opt)) { ret 0; }
    val rtt: *type.IrType = O.unwrap[*type.IrType](rt_opt);
    if (rtt.kind == type.IRT_VOID) { @out_void = true; ret types.type_void(e.tt); }
    ret ir_value_spv_type(e, rt);
}

# the IR return type id of a function, or the void-ish sentinel 0 when its
# signature does not read as a function type
# ---
# e:    the emission state
# irfn: the IR function
# ret:  the return type id
fun ir_return_type(e: *Emit, irfn: *ir.Function) type.IrTypeId {
    val sig_opt: O.Option[*type.IrType] = type.get(?e.ir.types, irfn.sig);
    if (O.is_none[*type.IrType](sig_opt)) { ret 0; }
    val sig: *type.IrType = O.unwrap[*type.IrType](sig_opt);
    if (sig.kind != type.IRT_FN) { ret 0; }
    ret sig.data.fn.ret_type;
}

# no IR function carries the requested name
val IR_FN_NONE: u32 = 0xFFFFFFFF;

# the index of the defined (non-extern) IR function of the given interned name
#
# The index, not the pointer: it also selects the function's pre-allocated SPIR-V
# id, which is what a call needs to name its callee.
# ---
# irmod: the IR module
# name:  the interned function name
# ret:   the function's index, or IR_FN_NONE
fun ir_function_index(irmod: *ir.Module, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < irmod.function_len) {
        val fn: *ir.Function = ?irmod.functions[i];
        if (fn.name == name && (fn.flags & ir.FN_FLAG_EXTERN) == 0) { ret i; }
        i = i + 1;
    }
    ret IR_FN_NONE;
}

# the diagnostic for a value type the emitter cannot map, naming the mach type
#
# The interesting case by far is a vector whose lane count SPIR-V reserves for
# Kernel modules: a Shader vector holds 2, 3, or 4 components, and 8 or 16 need the
# Vector16 capability, which a Shader module may not declare. Since every mach
# vector is 128 bits, that is exactly the four narrow-lane types, and naming which
# one was reached is the difference between an actionable message and a hunt.
# ---
# e:   the emission state
# mi:  the instruction whose result type failed to map
# ret: the diagnostic text
fun unsupported_value_type(e: *Emit, mi: *mir.MirInstr) str {
    if (!mir.vec_lane_is_vector(mi.vec_lane)) {
        ret "unsupported value type in the SPIR-V target";
    }
    val over: str = wide_vector_refusal(mir.vec_lane_count(mi.vec_lane),
                                        mir.vec_lane_elem_bytes(mi.vec_lane)::u32);
    if (over != nil) { ret over; }
    ret "unsupported vector lane type in the SPIR-V target";
}

# the refusal for a vector whose lane count no Shader module may declare, or nil
# when the count is fine
#
# Every mach vector is 128 bits, so a count past 4 is exactly one of the four
# narrow-lane types, and the lane width tells which pair was reached.
# ---
# count:      the lane count
# elem_bytes: the lane width in bytes
# ret:        the diagnostic, or nil when the count is Shader-legal
fun wide_vector_refusal(count: u32, elem_bytes: u32) str {
    if (count <= types.MAX_VECTOR_COMPONENTS) { ret nil; }
    if (elem_bytes == 1) {
        ret "the SPIR-V target has no vector form for `i8x16` / `u8x16`: a Shader module's vector holds at most 4 components, and a 16-component vector needs the Vector16 capability, which only a Kernel module may declare";
    }
    ret "the SPIR-V target has no vector form for `i16x8` / `u16x8`: a Shader module's vector holds at most 4 components, and an 8-component vector needs the Vector16 capability, which only a Kernel module may declare";
}

# the refusal for an IR type the emitter cannot map at a signature position,
# preferring the vector-specific reason over the positional one
# ---
# e:        the emission state
# id:       the IR type id that failed to map
# fallback: the positional message ("unsupported parameter type ...")
# ret:      the diagnostic text
fun unsupported_ir_type(e: *Emit, id: type.IrTypeId, fallback: str) str {
    val opt: O.Option[*type.IrType] = type.get(?e.ir.types, id);
    if (O.is_none[*type.IrType](opt)) { ret fallback; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind != type.IRT_VECTOR) { ret fallback; }
    var is_float: bool = false;
    var elem_bytes: u8 = 0;
    if (!type.vector_lane(?e.ir.types, id, ?is_float, ?elem_bytes)) { ret fallback; }
    val over: str = wide_vector_refusal(t.data.vector_.lanes, elem_bytes::u32);
    if (over != nil) { ret over; }
    ret fallback;
}

# the interface variable an address operand names, or 0 when it names something else
#
# Only a direct symbol reference resolves: an interface variable is read and written
# by name, and anything that computes an address off it is genuine addressed memory
# the milestone does not carry.
# ---
# e:   the emission state
# op:  the address operand
# ret: the OpVariable id, or 0
fun interface_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    ret global_var_id(e, op.sym);
}

# the diagnostic for an addressed access that is not a plain interface variable read
# or write
# ---
# ret: the diagnostic text
fun addressed_memory_refusal() str {
    ret "addressed memory is not yet supported by the SPIR-V target: a module-scope variable is reachable only when it carries a shader interface role (`#[input]`, `#[output]`, `#[builtin]`, or `#[uniform]`), and only as a whole-variable read or write";
}

# emit an OpLoad of a shader interface variable
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_LOAD instruction ([dst, address])
# ret:      true on success, or a precise error string
fun emit_global_load(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal());
    }
    val var_id: u32 = interface_target(e, ?mi.operands[1]);
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal()); }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n || vm.type_id[dst] == 0) {
        ret R.err[bool, str]("spirv.emit: interface load result vreg has no type");
    }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = var_id;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

# emit an OpStore into a shader interface variable
#
# The stored value is typed by the VARIABLE, not by the store's width: the ABI
# emits a move at the machine word, and an immediate stored into an f32x4 output
# has to be minted at the output's type or the module is ill-typed.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_STORE instruction ([address, value])
# ret:      true on success, or a precise error string
fun emit_global_store(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2) { ret unsupported(e, addressed_memory_refusal()); }
    val var_id: u32 = interface_target(e, ?mi.operands[0]);
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal()); }
    val value_ty: u32 = interface_value_type(e, ?mi.operands[0]);
    val value: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], value_ty);
    if (e.b.err || value == 0) { ret R.err[bool, str]("spirv.emit: unreadable value in an interface store"); }
    var ops: [2]u32;
    ops[0] = var_id; ops[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?ops[0], 2);
    ret R.ok[bool, str](true);
}

# the SPIR-V type of the value an interface variable holds, or 0 when the operand
# does not name one
# ---
# e:   the emission state
# op:  the address operand
# ret: the value type id, or 0
fun interface_value_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    var i: u32 = 0;
    for (i < e.ir.global_len) {
        if (e.ir.globals[i].name == op.sym && e.ir.globals[i].iface != ir.IFACE_NONE) {
            ret ir_value_spv_type(e, e.ir.globals[i].ty);
        }
        i = i + 1;
    }
    ret 0;
}

# select the integer or float form of a class-polymorphic opcode
# ---
# lane_float: whether the operation's lanes are float
# int_op:     the integer form
# float_op:   the float form
# ret:        the selected SPIR-V opcode
fun by_class(lane_float: bool, int_op: u32, float_op: u32) u32 {
    if (lane_float) { ret float_op; }
    ret int_op;
}

# raise a precise unsupported-feature diagnostic, located
#
# The backend's own sentence is composed with the opcode, the enclosing function
# and the source position through the shared `mir.instr_refusal`, so a refusal
# says WHICH instruction it is about. Before #2656 every one of these read
# identically no matter what was at fault, which made localizing a bisection.
#
# The three context values are read off `Emit` rather than threaded through the
# thirty call sites: a refusal names whatever the emitter was working on, and the
# stamps are the only thing that has to be right.
# ---
# e:   the emission state, carrying the function / instruction being emitted
# msg: the feature description
# ret: an err result carrying the located message
fun unsupported(e: *Emit, msg: str) R.Result[bool, str] {
    ret R.err[bool, str](mir.instr_refusal(e.alloc, e.srcmap, refusal_fn_name(e),
                                           e.cur_instr, msg));
}

# what to call the function currently being emitted
#
# The MIR function carries only the mangled link name, which is unambiguous but
# reads badly and does not match the source. The IR function beside it carries the
# bare source name, so prefer that and fall back through the mangled name to a
# stand-in, since this is only ever read by a diagnostic.
fun refusal_fn_name(e: *Emit) str {
    if (e.cur_fn == nil) { ret "<unknown function>"; }
    val fix: u32 = ir_function_index(e.ir, e.cur_fn.name);
    if (fix != IR_FN_NONE) {
        val d: O.Option[str] = intern.lookup(e.interner, (?e.ir.functions[fix]).disp);
        if (O.is_some[str](d)) { ret O.unwrap[str](d); }
    }
    val m: O.Option[str] = intern.lookup(e.interner, e.cur_fn.name);
    if (O.is_some[str](m)) { ret O.unwrap[str](m); }
    ret "<unresolved function name>";
}

# translate one MIR instruction into SPIR-V, using the value-variable model
# ---
# e:            the emission state
# mf:           the MIR function
# vm:           the per-vreg value maps
# preg_val:     the identity convention's nominal register file (16 wide)
# returns_void: whether the function returns void
# ret_bits:     the integer return width in bits
# mi:           the instruction to translate
# ret:          true on success, or a precise error string
fun emit_instr(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    e.cur_instr = mi;
    val op: mir.MirOpcode = mi.opcode;

    # a VECTOR operation rides the integer-spelled shared opcode whatever its lanes
    # hold: a vector is IRT_VECTOR rather than IRT_FLOAT, so the scalar float
    # dispatch that would have produced MIR_FADD never fires for one, and the lane
    # class survives only in `vec_lane`. Read it here and let the arithmetic family
    # pick its class from it. On a scalar the opcode already says which class it is
    # and this reads false, leaving the integer forms selected as before.
    val lf: bool = mir.vec_lane_is_vector(mi.vec_lane)
                && mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT;

    # binary arithmetic / bitwise / shift: dst = a <op> b.
    if (op == mir.MIR_ADD)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_ADD, spirv.OP_F_ADD)); }
    if (op == mir.MIR_SUB)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_SUB, spirv.OP_F_SUB)); }
    if (op == mir.MIR_MUL)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_MUL, spirv.OP_F_MUL)); }
    if (op == mir.MIR_DIV_S) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_DIV, spirv.OP_F_DIV)); }
    if (op == mir.MIR_DIV_U) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_DIV, spirv.OP_F_DIV)); }
    if (op == mir.MIR_REM_S) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_REM, spirv.OP_F_REM)); }
    if (op == mir.MIR_REM_U) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_MOD, spirv.OP_F_REM)); }
    if (op == mir.MIR_AND)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_AND); }
    if (op == mir.MIR_OR)    { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_OR); }
    if (op == mir.MIR_XOR)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_XOR); }
    if (op == mir.MIR_SHL)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_LEFT_LOGICAL); }
    if (op == mir.MIR_SHR_U) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_RIGHT_LOGICAL); }
    if (op == mir.MIR_SHR_S) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_RIGHT_ARITHMETIC); }

    # the dedicated scalar float opcodes MIR lowering emits instead of the shared
    # integer forms, so the class is already settled here.
    if (op == mir.MIR_FADD) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_ADD); }
    if (op == mir.MIR_FSUB) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_SUB); }
    if (op == mir.MIR_FMUL) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_MUL); }
    if (op == mir.MIR_FDIV) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_DIV); }

    # unary: dst = <op> a.
    if (op == mir.MIR_NEG)  { ret emit_unary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_NEGATE, spirv.OP_F_NEGATE)); }
    if (op == mir.MIR_NOT)  { ret emit_unary(e, vm, preg_val, mi, spirv.OP_NOT); }
    if (op == mir.MIR_FNEG) { ret emit_unary(e, vm, preg_val, mi, spirv.OP_F_NEGATE); }

    # comparisons. the shared integer-spelled opcodes carry a float VECTOR compare
    # too, so each picks its class the same way the arithmetic family does.
    if (op == mir.MIR_CMP_EQ)   { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_EQUAL, spirv.OP_F_ORD_EQUAL)); }
    if (op == mir.MIR_CMP_NE)   { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_NOT_EQUAL, spirv.OP_F_UNORD_NOT_EQUAL)); }
    if (op == mir.MIR_CMP_LT_S) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_LESS_THAN, spirv.OP_F_ORD_LESS_THAN)); }
    if (op == mir.MIR_CMP_LT_U) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_LESS_THAN, spirv.OP_F_ORD_LESS_THAN)); }
    if (op == mir.MIR_CMP_LE_S) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_LESS_THAN_EQUAL, spirv.OP_F_ORD_LESS_THAN_EQUAL)); }
    if (op == mir.MIR_CMP_LE_U) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_LESS_THAN_EQUAL, spirv.OP_F_ORD_LESS_THAN_EQUAL)); }

    # float comparison: one MIR opcode carrying its relation as a condition code.
    if (op == mir.MIR_FCMP) { ret emit_float_compare(e, vm, preg_val, mi); }

    # vector lane access. these reach the emitter only because the SPIR-V target
    # declares native lane ops; the alternative lowering rewrites them to the
    # vector's memory image, which logical addressing cannot express.
    if (op == mir.MIR_VEC_EXTRACT) { ret emit_vec_extract(e, vm, preg_val, mi); }
    if (op == mir.MIR_VEC_INSERT)  { ret emit_vec_insert(e, vm, preg_val, mi); }

    # integer width conversions: dst = convert(a), the source read as an integer.
    if (op == mir.MIR_TRUNC) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_U_CONVERT, false); }
    if (op == mir.MIR_ZEXT)  { ret emit_convert(e, vm, preg_val, mi, spirv.OP_U_CONVERT, false); }
    if (op == mir.MIR_SEXT)  { ret emit_convert(e, vm, preg_val, mi, spirv.OP_S_CONVERT, false); }

    # float conversions. the source class is fixed by the opcode, which is what
    # says how to read an immediate operand's bits; the destination class comes
    # from the result type as usual.
    if (op == mir.MIR_FP_TRUNC) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_F_CONVERT, true); }
    if (op == mir.MIR_FP_EXT)   { ret emit_convert(e, vm, preg_val, mi, spirv.OP_F_CONVERT, true); }
    if (op == mir.MIR_FP_TO_SI) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_F_TO_S, true); }
    if (op == mir.MIR_FP_TO_UI) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_F_TO_U, true); }
    if (op == mir.MIR_SI_TO_FP) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_S_TO_F, false); }
    if (op == mir.MIR_UI_TO_FP) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_U_TO_F, false); }

    # a `:~` bit reinterpret. the operand keeps its bits and takes the result type,
    # which is exactly OpBitcast; an immediate source is already the pattern, so it
    # is read at the source width in the integer class.
    if (op == mir.MIR_BITCAST) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_BITCAST, false); }

    if (op == mir.MIR_MOV) { ret emit_mov(e, vm, preg_val, mi); }
    # a `:^` declassify is a register copy plus a compile-time taint barrier; SPIR-V is
    # not rule-based (no isel retag), so its emitter handles MIR_DECLASSIFY directly as
    # the same value copy as MIR_MOV - identical runtime semantics (#1646).
    if (op == mir.MIR_DECLASSIFY) { ret emit_mov(e, vm, preg_val, mi); }

    if (op == mir.MIR_CALL) { ret emit_call(e, preg_val, mi); }
    # the liveness marker pairing the call with its result move: nothing to emit.
    if (op == mir.MIR_CALL_RES) { ret R.ok[bool, str](true); }

    # a whole-variable read or write of a shader interface variable. This is the ONLY
    # addressed memory the milestone supports, and it is supported because it is not
    # really addressing: an interface variable is named directly, so the access is an
    # OpLoad or OpStore on the variable's id with no address computed at all.
    if (op == mir.MIR_LOAD)  { ret emit_global_load(e, vm, preg_val, mi); }
    if (op == mir.MIR_STORE) { ret emit_global_store(e, vm, preg_val, mi); }
    if (op == mir.MIR_GEP && mi.operand_count >= 2 && interface_target(e, ?mi.operands[1]) != 0) {
        ret unsupported(e, "reading a member of a `#[uniform(...)]` block is not yet supported by the SPIR-V target: SPIR-V reaches one through an OpAccessChain naming the member's ORDINAL, and MIR has already folded the member walk into a byte displacement, which the ordinal cannot be recovered from in general. the block itself is declared correctly, with its Block decoration and member offsets; only the member read is missing. bind the whole block and read it as one value, or wait for the GEP to keep its index list");
    }
    if (op == mir.MIR_ALLOCA || op == mir.MIR_GEP) {
        ret unsupported(e, addressed_memory_refusal());
    }

    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

# emit an OpFunctionCall for a lowered direct call
#
# The identity convention put argument `i` in register `i`, so the argument list is
# the register map's prefix, as wide as the callee's declared parameter count. The
# result goes back into register 0, where the pre-coloring move that follows the
# call reads it. SPIR-V has no call through a value and no imports in this
# milestone, so an indirect call and a call to a body-less function are refused.
# ---
# e:        the emission state
# preg_val: the identity convention's nominal register file
# mi:       the MIR_CALL instruction (operand 0 is the callee)
# ret:      true on success, or a precise error string
fun emit_call(e: *Emit, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count < 1) { ret R.err[bool, str]("spirv.emit: call with no callee operand"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret unsupported(e, "a call through a function pointer is not yet supported by the SPIR-V target");
    }
    val fix: u32 = ir_function_index(e.ir, callee.sym);
    if (fix == IR_FN_NONE || e.fn_ids == nil || e.fn_ids[fix] == 0) {
        ret unsupported(e, "a call to a function defined outside the module is not yet supported by the SPIR-V target");
    }
    val irfn: *ir.Function = ?e.ir.functions[fix];

    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) { ret unsupported(e, "unsupported return type in the SPIR-V target"); }
    if (irfn.param_count > 16) {
        ret unsupported(e, "more than 16 parameters is not supported by the SPIR-V target");
    }

    val total: u32 = 3 + irfn.param_count;
    var ops: [19]u32;
    ops[0] = ret_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    ops[2] = e.fn_ids[fix];
    var i: u32 = 0;
    for (i < irfn.param_count) {
        val aid: u32 = reg_value(e, preg_val, i, ir_value_spv_type(e, irfn.params[i].ty));
        if (aid == 0) { ret R.err[bool, str]("spirv.emit: call argument with no pre-colored value"); }
        ops[3 + i] = aid;
        i = i + 1;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_CALL, ?ops[0], total);
    # the return register, which the result move reads next.
    if (!returns_void) {
        preg_val.val_id[0] = result;
        preg_val.is_imm[0] = false;
    }
    ret R.ok[bool, str](true);
}

# produce an SSA value id for an operand, materializing a load / constant as needed
#
# A vreg operand is loaded from its backing variable, at the type the variable was
# declared with - its own type is the truth, so `want_ty` is not consulted. An
# immediate has no type of its own: it is a bare bit pattern, minted against
# `want_ty`. A physical-register operand reads the identity register map (an
# incoming parameter, or a value moved into a register), where a pending immediate
# is likewise minted against `want_ty`. Returns 0 and latches an error for an
# operand kind the milestone cannot read as a scalar.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the register-index -> SSA id map
# op:       the operand
# want_ty:  the SPIR-V type the consumer declares for this position, which types an
#           immediate; 0 falls back to a machine-word integer
# ret:      the SSA value id, or 0 on failure
fun read_operand(e: *Emit, vm: *VMaps, preg_val: *Regs, op: *mir.MirOperand, want_ty: u32) u32 {
    if (op.kind == mir.MIR_OP_VREG) {
        val v: u32 = op.vreg;
        if (v >= vm.n || vm.var_id[v] == 0) { e.b.err = true; ret 0; }
        val result: u32 = spirv.alloc_id(e.b);
        var lo: [3]u32;
        lo[0] = vm.type_id[v]; lo[1] = result; lo[2] = vm.var_id[v];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?lo[0], 3);
        ret result;
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret immediate(e, want_ty, op.imm);
    }
    if (op.kind == mir.MIR_OP_PREG) {
        if (op.preg >= 16) { e.b.err = true; ret 0; }
        ret reg_value(e, preg_val, op.preg, want_ty);
    }
    e.b.err = true;
    ret 0;
}

# mint the constant of type `want_ty` holding the bit pattern `imm`
#
# A MIR immediate is a representation, not a number: an f32 literal arrives as its
# already-narrowed IEEE pattern in the same `i64` field an integer literal uses, so
# the consumer's declared type is the only thing that says how to spell it. A
# boolean position takes `OpConstantTrue` / `OpConstantFalse`, which carry no
# literal at all.
# ---
# e:       the emission state
# want_ty: the declared type, or 0 for a machine-word integer
# imm:     the immediate's bit pattern
# ret:     the constant's SSA id
fun immediate(e: *Emit, want_ty: u32, imm: i64) u32 {
    var ty: u32 = want_ty;
    if (ty == 0) { ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    if (types.type_is_bool(e.tt, ty)) { ret types.const_bool(e.tt, imm != 0); }
    val pattern: u64 = imm::u64;
    ret types.const_scalar(e.tt, ty, (pattern & 0xFFFFFFFF)::u32, ((pattern >> 32) & 0xFFFFFFFF)::u32);
}

# store an SSA value into a vreg's backing variable
# ---
# e:     the emission state
# vm:    the per-vreg value maps
# vreg:  the destination vreg id
# value: the SSA value id to store
# ret:   true on success, or an error string
fun store_vreg(e: *Emit, vm: *VMaps, vreg: u32, value: u32) R.Result[bool, str] {
    if (vreg >= vm.n || vm.var_id[vreg] == 0) {
        ret R.err[bool, str]("spirv.emit: store to an undeclared vreg");
    }
    var so: [2]u32;
    so[0] = vm.var_id[vreg]; so[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?so[0], 2);
    ret R.ok[bool, str](true);
}

# emit a binary op `dst = a <spv_op> b`, both operands at the result's type
#
# Every binary MIR op this handles is same-type in all three positions (the shifts
# included: a shift count is an integer of the shifted value's width by the time it
# reaches MIR), so the destination's type is what the operands are read at.
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a, b])
# spv_op: the SPIR-V opcode
# ret:    true on success, or an error string
fun emit_binary(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, spv_op: u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed binary instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: binary result vreg out of range"); }
    val ty: u32 = vm.type_id[dst];
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in binary instruction"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a; ops[3] = b;
    spirv.inst(e.b, ?e.b.functions, spv_op, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

# emit a unary op `dst = <spv_op> a`, the operand at the result's type
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a])
# spv_op: the SPIR-V opcode
# ret:    true on success, or an error string
fun emit_unary(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, spv_op: u32) R.Result[bool, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed unary instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: unary result vreg out of range"); }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vm.type_id[dst]);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in unary instruction"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a;
    spirv.inst(e.b, ?e.b.functions, spv_op, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

# emit an integer comparison `dst(bool) = a <spv_op> b`
#
# The compared operands ride at the comparison width (`mi.width`), while the result
# is a boolean stored into the destination's bool variable.
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a, b])
# spv_op: the SPIR-V comparison opcode
# ret:    true on success, or an error string
fun emit_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, spv_op: u32) R.Result[bool, str] {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        ret emit_vector_compare(e, vm, preg_val, mi, spv_op);
    }
    var cbits: u32 = mi.width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    ret emit_compare_typed(e, vm, preg_val, mi, spv_op, types.type_int(e.tt, cbits));
}

# emit a lane-wise vector comparison as mach's unsigned MASK vector
#
# The two languages disagree about what a vector comparison IS, and this is where
# that is reconciled. SPIR-V yields a vector of booleans; mach has no vector-bool
# type and defines the result as a same-shape unsigned vector whose lanes are
# all-ones for true and all-zeros for false - what the SSE / NEON compare hardware
# hands back directly. So the boolean vector is widened through an `OpSelect`
# between an all-ones and an all-zeros constant of the mask type. A consumer's
# mem2reg and peephole collapse that back to its own compare form; emitting the
# boolean vector raw would be a different, narrower type than the mach program
# declared.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the vector comparison instruction ([dst, a, b])
# spv_op:   the SPIR-V comparison opcode, already class-selected
# ret:      true on success, or an error string
fun emit_vector_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, spv_op: u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: comparison result vreg out of range"); }

    val lanes: u32 = mir.vec_lane_count(mi.vec_lane);
    val operand_ty: u32 = vector_type_of(e, mi.vec_lane, false);
    val bvec_ty: u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    val mask_ty: u32 = vm.type_id[dst];
    if (operand_ty == 0 || bvec_ty == 0 || mask_ty == 0) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }

    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in vector comparison"); }

    val bvec: u32 = spirv.alloc_id(e.b);
    var cops: [4]u32;
    cops[0] = bvec_ty; cops[1] = bvec; cops[2] = a; cops[3] = b;
    spirv.inst(e.b, ?e.b.functions, spv_op, ?cops[0], 4);

    val ones: u32 = mask_splat(e, mask_ty, lanes, 0xFFFFFFFF, 0xFFFFFFFF);
    val zeros: u32 = mask_splat(e, mask_ty, lanes, 0, 0);
    if (ones == 0 || zeros == 0) {
        ret R.err[bool, str]("spirv.emit: could not build a vector comparison mask constant");
    }

    val result: u32 = spirv.alloc_id(e.b);
    var sops: [5]u32;
    sops[0] = mask_ty; sops[1] = result; sops[2] = bvec; sops[3] = ones; sops[4] = zeros;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# a vector constant of `lanes` copies of one bit pattern, for a comparison mask
# ---
# e:       the emission state
# vec_ty:  the mask vector type
# lanes:   the lane count
# lo:      the low word of each lane's pattern
# hi:      the high word of each lane's pattern (used only for 64-bit lanes)
# ret:     the constant's id, or 0 when the shape is out of range
fun mask_splat(e: *Emit, vec_ty: u32, lanes: u32, lo: u32, hi: u32) u32 {
    var count: u32 = 0;
    val lane_ty: u32 = types.vector_shape(e.tt, vec_ty, ?count);
    if (lane_ty == 0 || count == 0 || count > types.MAX_VECTOR_COMPONENTS) { ret 0; }
    val lane: u32 = types.const_scalar(e.tt, lane_ty, lo, hi);
    var parts: [4]u32;
    var i: u32 = 0;
    for (i < count) { parts[i] = lane; i = i + 1; }
    ret types.const_composite(e.tt, vec_ty, ?parts[0], count);
}

# emit a vector lane read `dst = a[k]`
#
# The lane index is a compile-time constant by the language's rule, so this is
# `OpCompositeExtract` with a literal index rather than the dynamic form.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_VEC_EXTRACT instruction ([dst, vector, lane index])
# ret:      true on success, or an error string
fun emit_vec_extract(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector extract instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: vector extract result vreg out of range"); }
    val vec_ty: u32 = operand_vector_type(e, vm, mi, ?mi.operands[1]);
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    val src: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vec_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in vector extract"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = src; ops[3] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

# emit a vector lane write `dst = a with [k] = v`
#
# `OpCompositeInsert` is functional rather than in-place: it takes the whole source
# vector and yields a new one, which is what the MIR form means too.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_VEC_INSERT instruction ([dst, vector, lane index, value])
# ret:      true on success, or an error string
fun emit_vec_insert(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 4 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed vector insert instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: vector insert result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes: u32 = 0;
    val lane_ty: u32 = types.vector_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val src: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vec_ty);
    val lane: u32 = read_operand(e, vm, preg_val, ?mi.operands[3], lane_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in vector insert"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = vec_ty; ops[1] = result; ops[2] = lane; ops[3] = src; ops[4] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_INSERT, ?ops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

# the vector type of an instruction's source operand
#
# A vreg source carries its own declared type, which is the truth. Otherwise the
# shape is rebuilt from the instruction's lane descriptor, which for a lane access
# describes the VECTOR side rather than the scalar result.
# ---
# e:   the emission state
# vm:  the per-vreg value maps
# mi:  the instruction (for its lane descriptor)
# op:  the source operand
# ret: the SPIR-V vector type id, or 0
fun operand_vector_type(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_VREG && op.vreg < vm.n && vm.type_id[op.vreg] != 0) {
        ret vm.type_id[op.vreg];
    }
    if (!mir.vec_lane_is_vector(mi.vec_lane)) { ret 0; }
    ret vector_type_of(e, mi.vec_lane, false);
}

# emit a float comparison, choosing the ordered / unordered SPIR-V relation the
# MIR condition code names
#
# The relation rides in `src_width` (a float compare has no narrower operand width
# to carry there), and the operand type is the compare width in the float class.
# Every relation but `!=` is ORDERED, so a NaN operand reads false; `!=` is the
# unordered one, so it reads true. That is the IEEE-754 reading of mach's
# operators, and it matches instruction-for-instruction what the x86-64 encoder
# builds out of UCOMISx plus a parity fold - a shader and a native build of the
# same source agree about NaN.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:       the MIR_FCMP instruction ([dst, a, b]) carrying its FCC_* code
# ret:      true on success, or an error string
fun emit_float_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    var fbits: u32 = mi.width::u32 * 8;
    if (fbits != 32 && fbits != 64) {
        ret unsupported(e, "unsupported float comparison width in the SPIR-V target");
    }
    val cc: u8 = mi.src_width;
    var spv_op: u32 = spirv.OP_F_ORD_GREATER_THAN_EQUAL;
    if (cc == mir.FCC_EQ)      { spv_op = spirv.OP_F_ORD_EQUAL; }
    or (cc == mir.FCC_NE)      { spv_op = spirv.OP_F_UNORD_NOT_EQUAL; }
    or (cc == mir.FCC_LT)      { spv_op = spirv.OP_F_ORD_LESS_THAN; }
    or (cc == mir.FCC_LE)      { spv_op = spirv.OP_F_ORD_LESS_THAN_EQUAL; }
    or (cc == mir.FCC_GT)      { spv_op = spirv.OP_F_ORD_GREATER_THAN; }
    or (cc != mir.FCC_GE)      { ret unsupported(e, "unknown float comparison condition in the SPIR-V target"); }
    ret emit_compare_typed(e, vm, preg_val, mi, spv_op, types.type_float(e.tt, fbits));
}

# emit a comparison whose operands are read at `operand_ty` and whose result is a
# boolean stored into the destination's variable
# ---
# e:          the emission state
# vm:         the per-vreg value maps
# preg_val:   the identity convention's nominal register file
# mi:         the MIR instruction ([dst, a, b])
# spv_op:     the SPIR-V comparison opcode
# operand_ty: the type both compared operands are read at
# ret:        true on success, or an error string
fun emit_compare_typed(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr,
                       spv_op: u32, operand_ty: u32) R.Result[bool, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: comparison result vreg out of range"); }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in comparison"); }
    val bool_ty: u32 = types.type_bool(e.tt);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = bool_ty; ops[1] = result; ops[2] = a; ops[3] = b;
    spirv.inst(e.b, ?e.b.functions, spv_op, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

# emit a conversion `dst = <spv_op>(a)`
#
# A conversion is the one shape whose operand type is NOT the result type, so the
# source side is reconstructed here: `src_width` gives the width and the opcode
# fixes the class. That only matters for a source that carries no type of its own -
# an immediate or a nominal register - since a vreg source is loaded at its own
# declared type.
# ---
# e:      the emission state
# vm:     the per-vreg value maps
# preg_val: the identity convention's nominal register file
# mi:     the MIR instruction ([dst, a]) carrying the source width in src_width
# spv_op: the SPIR-V conversion opcode
# src_is_float: whether the source side is read in the float class
# ret:    true on success, or an error string
fun emit_convert(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr,
                 spv_op: u32, src_is_float: bool) R.Result[bool, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret R.err[bool, str]("spirv.emit: malformed conversion instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret R.err[bool, str]("spirv.emit: conversion result vreg out of range"); }
    var sbits: u32 = mi.src_width::u32 * 8;
    if (sbits == 0) { sbits = e.tgt.model.gpr_width * 8; }
    var src_ty: u32 = types.type_int(e.tt, sbits);
    if (src_is_float) {
        if (sbits != 32 && sbits != 64) {
            ret unsupported(e, "unsupported float conversion width in the SPIR-V target");
        }
        src_ty = types.type_float(e.tt, sbits);
    }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], src_ty);
    if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable operand in conversion"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a;
    spirv.inst(e.b, ?e.b.functions, spv_op, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

# emit a MIR_MOV: a register-to-register / immediate copy
#
# A move into a value vreg stores the source into the vreg's variable. A move into
# a physical register records the source SSA id in the identity register map - the
# return-value pre-coloring the bare MIR_RET later consumes.
# ---
# e:        the emission state
# vm:       the per-vreg value maps
# preg_val: the identity convention's nominal register file
# ret_bits: the integer return width, used to type an immediate moved into a register
# mi:       the MIR instruction ([dst, src])
# ret:      true on success, or an error string
fun emit_mov(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2) { ret R.err[bool, str]("spirv.emit: malformed move instruction"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_VREG) {
        if (dst.vreg >= vm.n) { ret R.err[bool, str]("spirv.emit: move destination vreg out of range"); }
        val val_id: u32 = read_operand(e, vm, preg_val, src, vm.type_id[dst.vreg]);
        if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable move source"); }
        ret store_vreg(e, vm, dst.vreg, val_id);
    }
    if (dst.kind == mir.MIR_OP_PREG) {
        if (dst.preg >= 16) { ret R.err[bool, str]("spirv.emit: move destination register out of range"); }
        # an immediate waits here untyped: the type it takes is the one the callee's
        # parameter or the function's return type declares, not the move's, which the
        # ABI pre-coloring always emits at the machine word in the integer class.
        if (src.kind == mir.MIR_OP_IMM) {
            preg_val.val_id[dst.preg] = 0;
            preg_val.imm[dst.preg]    = src.imm;
            preg_val.is_imm[dst.preg] = true;
            ret R.ok[bool, str](true);
        }
        val val_id: u32 = read_operand(e, vm, preg_val, src, 0);
        if (e.b.err) { ret R.err[bool, str]("spirv.emit: unreadable move source"); }
        preg_val.val_id[dst.preg] = val_id;
        preg_val.is_imm[dst.preg] = false;
        ret R.ok[bool, str](true);
    }
    ret unsupported(e, "memory-destination move is not yet supported by the SPIR-V target");
}

# the SSA value in a nominal register, minting a pending immediate at `want_ty`
# ---
# e:       the emission state
# rg:      the register file
# k:       the register index
# want_ty: the SPIR-V type the consumer declares for this position
# ret:     the SSA value id, or 0 when the register holds nothing
fun reg_value(e: *Emit, rg: *Regs, k: u32, want_ty: u32) u32 {
    if (!rg.is_imm[k]) { ret rg.val_id[k]; }
    ret immediate(e, want_ty, rg.imm[k]);
}
