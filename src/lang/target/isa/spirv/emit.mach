use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use std.allocator.page;
use std.format;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.layout;
use mach.lang.source;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa;
use mach.lang.me.ir;
use mach.lang.me.ir.type;
use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.unit;
use mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.cfg;
use mach.lang.target.isa.spirv.types;
use semtype: mach.lang.type;

rec Emit {
    alloc:     *A.Allocator;
    interner:  *intern.Interner;
    tgt:       *isa.BackendTarget;
    layout:    layout.Machine;
    u:         *unit.Unit;
    root:      *ir.Module;
    ir:        *ir.Module;
    cur_mi:    u32;
    b:         *spirv.Builder;
    tt:        *types.TypeTable;
    fns:       *FnEnt;
    fn_len:    u32;
    has_entry: bool;
    gls:       *GlobalEnt;
    gl_len:    u32;
    gvar_ids:  *u32;
    gtype_ids: *u32;
    gstorage:  *u32;
    iface_ids: *u32;
    iface_len: u32;
    gslot:     *u32;
    iface_use: *u8;

    gwrite:    *u8;

    ext_ids:   [8]u32;

    srcmap:    *source.SourceMap;
    cur_fn:    *mir.MirFunction;
    cur_instr: *mir.MirInstr;
}

rec VMaps {
    type_id: *u32;
    var_id:  *u32;
    is_bool: *bool;
    chain_id: *u32;
    chain_ty: *u32;
    chain_sc: *u32;
    opq_var: *u32;
    opq_ssa: *u32;
    n:       u32;
}

rec Regs {
    val_id:  [16]u32;
    imm:     [16]i64;
    is_imm:  [16]bool;
    is_bool: [16]bool;
}

rec FnEnt {
    mi:     u32;
    ir_ix:  u32;
    mir_ix: u32;
    name:   intern.StrId;
    id:     u32;
    emit:   bool;
}

rec GlobalEnt {
    mi:    u32;
    ir_ix: u32;
    name:  intern.StrId;
}

pub fun emit_module(out_alloc: *A.Allocator, tgt: *isa.BackendTarget, u: *unit.Unit,
                    out_bytes: **u8, out_len: *u32) R.Result[R.Void, str] {
    if (out_alloc == nil || tgt == nil || u == nil || u.len == 0 || u.mods == nil) {
        ret R.err[R.Void, str]("spirv.emit: nil argument");
    }
    val irmod:  *ir.Module     = unit.root_ir(u);
    val mirmod: *mir.MirModule = unit.root_mir(u);
    if (irmod == nil || mirmod == nil) { ret R.err[R.Void, str]("spirv.emit: nil argument"); }

    var b: spirv.Builder = spirv.builder_init(out_alloc);
    var tt: types.TypeTable = types.types_init(?b);

    var e: Emit;
    e.alloc = out_alloc; e.interner = mirmod.interner;
    e.tgt = tgt; e.layout = layout.machine(tgt.model.pointer_width, tgt.model.vector_bits);
    e.u = u; e.root = irmod; e.ir = irmod; e.cur_mi = u.root;
    e.b = ?b; e.tt = ?tt; e.fns = nil; e.fn_len = 0; e.gls = nil; e.gl_len = 0;
    e.gvar_ids = nil; e.gtype_ids = nil; e.gstorage = nil; e.iface_ids = nil; e.iface_len = 0;
    e.gslot = nil; e.iface_use = nil; e.gwrite = nil;
    var xi: u32 = 0;
    for (xi < 8) { e.ext_ids[xi] = 0; xi = xi + 1; }
    e.srcmap = mirmod.srcmap; e.cur_fn = nil; e.cur_instr = nil;

    e.has_entry = false;
    var si: u32 = 0;
    for (si < irmod.function_len) {
        if (irmod.functions[si].stage != ir.STAGE_NONE
            && (irmod.functions[si].flags & ir.FN_FLAG_EXTERN) == 0) { e.has_entry = true; }
        si = si + 1;
    }

    val tr: R.Result[R.Void, str] = build_fn_table(?e);
    if (R.is_err[R.Void, str](tr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret tr;
    }

    val rr: R.Result[R.Void, str] = mark_emitted(?e);
    if (R.is_err[R.Void, str](rr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret rr;
    }

    val gtr: R.Result[R.Void, str] = build_gl_table(?e);
    if (R.is_err[R.Void, str](gtr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gtr;
    }

    val wr: R.Result[R.Void, str] = build_gl_writes(?e);
    if (R.is_err[R.Void, str](wr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret wr;
    }

    val gr: R.Result[R.Void, str] = declare_interface(?e);
    if (R.is_err[R.Void, str](gr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret gr;
    }

    val ur: R.Result[R.Void, str] = build_iface_uses(?e);
    if (R.is_err[R.Void, str](ur)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret ur;
    }

    val cgr: R.Result[R.Void, str] = check_call_graph(?e);
    if (R.is_err[R.Void, str](cgr)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cgr;
    }

    val sir: R.Result[R.Void, str] = check_stage_interfaces(?e);
    if (R.is_err[R.Void, str](sir)) {
        emit_dnit(?e);
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret sir;
    }

    var fi: u32 = 0;
    for (fi < e.fn_len) {
        if (!e.fns[fi].emit) { fi = fi + 1; cnt; }
        val fr: R.Result[R.Void, str] = emit_function(?e, fi);
        if (R.is_err[R.Void, str](fr)) {
            emit_dnit(?e);
            types.types_dnit(?tt);
            spirv.builder_dnit(?b);
            ret fr;
        }
        fi = fi + 1;
    }
    emit_dnit(?e);

    val cr: R.Result[R.Void, str] = check_environment(?e);
    if (R.is_err[R.Void, str](cr)) {
        types.types_dnit(?tt);
        spirv.builder_dnit(?b);
        ret cr;
    }
    emit_preamble(?e);

    var len: u32 = 0;
    val rs: R.Result[*u8, str] = spirv.serialize(?b, ?len);
    types.types_dnit(?tt);
    spirv.builder_dnit(?b);
    if (R.is_err[*u8, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](rs)); }
    @out_bytes = R.unwrap_ok[*u8, str](rs);
    @out_len   = len;
    ret R.ok_void[str]();
}

fun emit_dnit(e: *Emit) {
    if (e.iface_use != nil && e.fn_len > 0 && e.iface_len > 0) {
        A.deallocate[u8](e.alloc, e.iface_use, (e.fn_len * e.iface_len)::usize);
    }
    e.iface_use = nil;
    e.iface_len = 0;
    if (e.fns != nil && e.fn_len > 0) { A.deallocate[FnEnt](e.alloc, e.fns, e.fn_len::usize); }
    e.fns    = nil;
    e.fn_len = 0;
    if (e.gvar_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gvar_ids, e.gl_len::usize);
    }
    e.gvar_ids = nil;
    if (e.iface_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.iface_ids, e.gl_len::usize);
    }
    e.iface_ids = nil;
    if (e.gslot != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gslot, e.gl_len::usize);
    }
    e.gslot = nil;
    if (e.gtype_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gtype_ids, e.gl_len::usize);
    }
    e.gtype_ids = nil;
    if (e.gstorage != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gstorage, e.gl_len::usize);
    }
    e.gstorage = nil;
    if (e.gwrite != nil && e.gl_len > 0) {
        A.deallocate[u8](e.alloc, e.gwrite, e.gl_len::usize);
    }
    e.gwrite = nil;
    if (e.gls != nil && e.gl_len > 0) { A.deallocate[GlobalEnt](e.alloc, e.gls, e.gl_len::usize); }
    e.gls    = nil;
    e.gl_len = 0;
}

fun build_fn_table(e: *Emit) R.Result[R.Void, str] {
    var n: u32 = 0;
    var mi: u32 = 0;
    for (mi < e.u.len) {
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32 = 0;
        for (i < m.function_len) {
            if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) == 0) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret R.ok_void[str](); }

    val rt: R.Result[*FnEnt, str] = A.allocate[FnEnt](e.alloc, n::usize);
    if (R.is_err[*FnEnt, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*FnEnt, str](rt)); }
    e.fns    = R.unwrap_ok[*FnEnt, str](rt);
    e.fn_len = n;

    var k: u32 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        mi = 0;
        for (mi < e.u.len) {
            val is_root: bool = mi == e.u.root;
            if ((pass == 0) != is_root) { mi = mi + 1; cnt; }
            val m: *ir.Module = e.u.mods[mi].ir;
            var i: u32 = 0;
            for (i < m.function_len) {
                if ((m.functions[i].flags & ir.FN_FLAG_EXTERN) != 0) { i = i + 1; cnt; }
                e.fns[k].mi     = mi;
                e.fns[k].ir_ix  = i;
                e.fns[k].name   = m.functions[i].name;
                e.fns[k].mir_ix = unit.mir_index(e.u, mi, m.functions[i].name);
                e.fns[k].id     = 0;
                e.fns[k].emit   = false;
                k = k + 1;
                i = i + 1;
            }
            mi = mi + 1;
        }
        pass = pass + 1;
    }
    ret R.ok_void[str]();
}

fun mark_emitted(e: *Emit) R.Result[R.Void, str] {
    if (e.fn_len == 0) { ret R.ok_void[str](); }

    var i: u32 = 0;
    for (i < e.fn_len) {
        val fn: *ir.Function = fn_ir(e, i);
        val root_fn: bool = e.fns[i].mi == e.u.root;
        var seed: bool = false;
        if (e.has_entry) { seed = root_fn && fn.stage != ir.STAGE_NONE; }
        or              { seed = root_fn; }
        if (seed && emittable(e, i)) { e.fns[i].emit = true; }
        i = i + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        i = 0;
        for (i < e.fn_len) {
            if (!e.fns[i].emit) { i = i + 1; cnt; }
            var ci: u32 = 0;
            for (ci < callee_count(e, i)) {
                val cx: u32 = callee_at(e, i, ci);
                if (cx != FN_NONE && !e.fns[cx].emit && emittable(e, cx)) {
                    e.fns[cx].emit = true;
                    changed = true;
                }
                ci = ci + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    for (i < e.fn_len) {
        if (e.fns[i].emit) { e.fns[i].id = spirv.alloc_id(e.b); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun emittable(e: *Emit, ix: u32) bool {
    val fn: *ir.Function = fn_ir(e, ix);
    if (fn.op_set != defs.SPV_SET_NONE) { ret false; }
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil || mf.block_count == 0)   { ret false; }
    ret true;
}

fun callee_count(e: *Emit, ix: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret 0; }
    var n: u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (blk.instrs[ii].opcode == mir.MIR_CALL) { n = n + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

fun callee_at(e: *Emit, ix: u32, k: u32) u32 {
    val mf: *mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret FN_NONE; }
    var n: u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_CALL) {
                if (n == k) {
                    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_SYM) { ret FN_NONE; }
                    ret fn_lookup(e, mi.operands[0].sym);
                }
                n = n + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret FN_NONE;
}

fun fn_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.fn_len) {
        if (e.fns[i].name == name) { ret i; }
        i = i + 1;
    }
    ret FN_NONE;
}

fun fn_ir(e: *Emit, ix: u32) *ir.Function {
    ret ?e.u.mods[e.fns[ix].mi].ir.functions[e.fns[ix].ir_ix];
}

fun fn_mod(e: *Emit, ix: u32) *ir.Module {
    ret e.u.mods[e.fns[ix].mi].ir;
}

fun fn_mir(e: *Emit, ix: u32) *mir.MirFunction {
    if (e.fns[ix].mir_ix == FN_NONE) { ret nil; }
    ret ?e.u.mods[e.fns[ix].mi].mir.functions[e.fns[ix].mir_ix];
}

fun build_gl_table(e: *Emit) R.Result[R.Void, str] {
    var n: u32 = 0;
    var i0: u32 = 0;
    for (i0 < e.root.global_len) {
        if (gl_eligible(?e.root.globals[i0])) { n = n + 1; }
        i0 = i0 + 1;
    }
    var mi: u32 = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) { mi = mi + 1; cnt; }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32 = 0;
        for (i < m.global_len) {
            if (gl_eligible(?m.globals[i]) && global_is_reached(e, m.globals[i].name)) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret R.ok_void[str](); }

    val rt: R.Result[*GlobalEnt, str] = A.allocate[GlobalEnt](e.alloc, n::usize);
    if (R.is_err[*GlobalEnt, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*GlobalEnt, str](rt)); }
    e.gls    = R.unwrap_ok[*GlobalEnt, str](rt);
    e.gl_len = n;

    var k: u32 = 0;
    var i2: u32 = 0;
    for (i2 < e.root.global_len) {
        if (!gl_eligible(?e.root.globals[i2])) { i2 = i2 + 1; cnt; }
        e.gls[k].mi    = e.u.root;
        e.gls[k].ir_ix = i2;
        e.gls[k].name  = e.root.globals[i2].name;
        k = k + 1;
        i2 = i2 + 1;
    }
    mi = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) { mi = mi + 1; cnt; }
        val m: *ir.Module = e.u.mods[mi].ir;
        var i: u32 = 0;
        for (i < m.global_len) {
            if (!gl_eligible(?m.globals[i]) || !global_is_reached(e, m.globals[i].name)) { i = i + 1; cnt; }
            e.gls[k].mi    = mi;
            e.gls[k].ir_ix = i;
            e.gls[k].name  = m.globals[i].name;
            k = k + 1;
            i = i + 1;
        }
        mi = mi + 1;
    }
    ret R.ok_void[str]();
}

fun build_gl_writes(e: *Emit) R.Result[R.Void, str] {
    if (e.gl_len == 0) { ret R.ok_void[str](); }
    val rw: R.Result[*u8, str] = A.allocate[u8](e.alloc, e.gl_len::usize);
    if (R.is_err[*u8, str](rw)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](rw)); }
    e.gwrite = R.unwrap_ok[*u8, str](rw);
    var i: u32 = 0;
    for (i < e.gl_len) { e.gwrite[i] = 0; i = i + 1; }

    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) { fx = fx + 1; cnt; }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) { fx = fx + 1; cnt; }
        val r: R.Result[R.Void, str] = scan_fn_writes(e, fx, mf);
        if (R.is_err[R.Void, str](r)) { ret r; }
        fx = fx + 1;
    }
    ret R.ok_void[str]();
}

fun scan_fn_writes(e: *Emit, fx: u32, mf: *mir.MirFunction) R.Result[R.Void, str] {
    val n: u32 = mf.vreg_count;
    var origin: *u32 = nil;
    if (n > 0) {
        val ro: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
        if (R.is_err[*u32, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ro)); }
        origin = R.unwrap_ok[*u32, str](ro);
        var v: u32 = 0;
        for (v < n) { origin[v] = GL_NONE; v = v + 1; }
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                ii = ii + 1;
                if (mi.opcode != mir.MIR_GEP || mi.operand_count < 2) { cnt; }
                if (mi.operands[0].kind != mir.MIR_OP_VREG) { cnt; }
                val dst: u32 = mi.operands[0].vreg;
                if (origin == nil || dst == mir.MIR_VREG_NIL || dst >= n) { cnt; }
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[1]);
                if (g == GL_NONE || origin[dst] == g) { cnt; }
                if (origin[dst] != GL_NONE) {
                    val ra: R.Result[R.Void, str] = mark_written(e, fx, mi, origin[dst]);
                    if (R.is_err[R.Void, str](ra)) { A.deallocate[u32](e.alloc, origin, n::usize); ret ra; }
                    val rb: R.Result[R.Void, str] = mark_written(e, fx, mi, g);
                    if (R.is_err[R.Void, str](rb)) { A.deallocate[u32](e.alloc, origin, n::usize); ret rb; }
                    cnt;
                }
                origin[dst] = g;
                changed = true;
            }
            bi = bi + 1;
        }
    }

    var bi2: u32 = 0;
    for (bi2 < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi2];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                val g: u32 = operand_origin(e, origin, n, ?mi.operands[oi]);
                if (g == GL_NONE) { oi = oi + 1; cnt; }
                if (operand_only_reads(mi.opcode, oi)) { oi = oi + 1; cnt; }
                val rm: R.Result[R.Void, str] = mark_written(e, fx, mi, g);
                if (R.is_err[R.Void, str](rm)) {
                    if (origin != nil) { A.deallocate[u32](e.alloc, origin, n::usize); }
                    ret rm;
                }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi2 = bi2 + 1;
    }
    if (origin != nil) { A.deallocate[u32](e.alloc, origin, n::usize); }
    ret R.ok_void[str]();
}

fun operand_only_reads(op: mir.MirOpcode, oi: u32) bool {
    if (op == mir.MIR_LOAD)      { ret oi == 1; }
    if (op == mir.MIR_GEP)       { ret oi < 2; }
    if (op == mir.MIR_MEMCPY)    { ret oi == 1; }
    if (op == mir.MIR_AGG_LOAD)  { ret oi == 1; }
    ret false;
}

fun operand_origin(e: *Emit, origin: *u32, n: u32, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_SYM) { ret gl_lookup(e, op.sym); }
    if (op.kind != mir.MIR_OP_VREG && op.kind != mir.MIR_OP_MEM) { ret GL_NONE; }
    if (origin == nil || op.vreg == mir.MIR_VREG_NIL || op.vreg >= n) { ret GL_NONE; }
    ret origin[op.vreg];
}

fun mark_written(e: *Emit, fx: u32, mi: *mir.MirInstr, gix: u32) R.Result[R.Void, str] {
    if (gix >= e.gl_len || e.gwrite == nil) { ret R.ok_void[str](); }
    if (e.gwrite[gix] != 0) { ret R.ok_void[str](); }
    e.gwrite[gix] = 1;
    val g: *ir.Global = gl_ir(e, gix);
    if (g.iface != ir.IFACE_STORAGE || (g.iface_flags & ir.IFACE_FLAG_READONLY) == 0) {
        ret R.ok_void[str]();
    }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "a store reaches the `#[storage({}, {}, \"readonly\")]` binding{}: the qualifier declares that nothing writes it, which is what lets this module mark the descriptor `NonWritable` and a vertex stage read it without `vertexPipelineStoresAndAtomics`. drop the `\"readonly\"` qualifier to write it",
        g.iface_a, g.iface_b, gl_mod_prefix(e, gix));
    if (R.is_err[str, str](r)) {
        ret R.err[R.Void, str]("spirv.emit: a store reaches a `\"readonly\"` storage binding");
    }
    ret R.err[R.Void, str](mir.instr_refusal(e.alloc, e.srcmap, ir_fn_spelling(e, fx), mi,
                                           R.unwrap_ok[str, str](r)));
}

fun gl_written(e: *Emit, ix: u32) bool {
    if (e.gwrite == nil || ix >= e.gl_len) { ret true; }
    ret e.gwrite[ix] != 0;
}

fun global_is_reached(e: *Emit, name: intern.StrId) bool {
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) { fx = fx + 1; cnt; }
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) { fx = fx + 1; cnt; }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32 = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM
                        && mi.operands[oi].sym == name) { ret true; }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }
    ret false;
}

fun gl_eligible(g: *ir.Global) bool {
    ret !g.is_extern && !g.is_import;
}

fun gl_ir(e: *Emit, ix: u32) *ir.Global {
    ret ?e.u.mods[e.gls[ix].mi].ir.globals[e.gls[ix].ir_ix];
}

fun gl_types(e: *Emit, ix: u32) *type.IrTypeTable {
    ret ?e.u.mods[e.gls[ix].mi].ir.types;
}

fun gl_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.gl_len) {
        if (e.gls[i].name == name) { ret i; }
        i = i + 1;
    }
    ret GL_NONE;
}

fun gl_mod_prefix(e: *Emit, ix: u32) str {
    if (ix >= e.gl_len || e.gls[ix].mi == e.u.root) { ret ""; }
    val mo: O.Option[str] = intern.lookup(e.interner, e.u.mods[e.gls[ix].mi].ir.name);
    if (O.is_none[str](mo)) { ret ""; }
    val q: R.Result[str, str] = format.sprint(e.alloc, ", declared in `{}`", O.unwrap[str](mo));
    if (R.is_err[str, str](q)) { ret ""; }
    ret R.unwrap_ok[str, str](q);
}

fun declare_interface(e: *Emit) R.Result[R.Void, str] {
    val n: u32 = e.gl_len;
    if (n == 0) { ret R.ok_void[str](); }

    val rg: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rg)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rg)); }
    e.gvar_ids = R.unwrap_ok[*u32, str](rg);
    val ri: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](ri)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ri)); }
    e.iface_ids = R.unwrap_ok[*u32, str](ri);

    val rs: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rs)); }
    e.gslot = R.unwrap_ok[*u32, str](rs);
    val rt: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rt)); }
    e.gtype_ids = R.unwrap_ok[*u32, str](rt);
    val rc: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rc)); }
    e.gstorage = R.unwrap_ok[*u32, str](rc);

    var i: u32 = 0;
    for (i < n) { e.gvar_ids[i] = 0; e.iface_ids[i] = 0; e.gslot[i] = 0; e.gtype_ids[i] = 0; e.gstorage[i] = 0; i = i + 1; }

    i = 0;
    for (i < n) {
        val g: *ir.Global = gl_ir(e, i);
        val gt: *type.IrTypeTable = gl_types(e, i);
        if (g.iface == ir.IFACE_NONE) { i = i + 1; cnt; }

        if (g.iface == ir.IFACE_BUILTIN) {
            val br: str = builtin_type_refusal(gt, e.alloc, g.iface_a, g.ty);
            if (br != nil) { ret R.err[R.Void, str](br); }
        }

        var storage: u32 = spirv.STORAGE_INPUT;
        if (g.iface == ir.IFACE_OUTPUT)      { storage = spirv.STORAGE_OUTPUT; }
        or (g.iface == ir.IFACE_UNIFORM)     { storage = spirv.STORAGE_UNIFORM; }
        or (g.iface == ir.IFACE_STORAGE)     { storage = spirv.STORAGE_STORAGE_BUFFER; }
        or (g.iface == ir.IFACE_SAMPLER)     { storage = spirv.STORAGE_UNIFORM_CONSTANT; }
        or (g.iface == ir.IFACE_BUILTIN)     { storage = builtin_storage(g.iface_a); }

        val handle: bool = is_image_type(e, gt, g.ty);
        if (handle && g.iface != ir.IFACE_SAMPLER) {
            ret R.err[R.Void, str]("spirv.emit: an image handle carries an interface role other than `#[sampler(set, binding)]`; a handle is bound as a descriptor and reaches no other storage class");
        }
        if (!handle && g.iface == ir.IFACE_SAMPLER) {
            ret R.err[R.Void, str]("spirv.emit: a `#[sampler(set, binding)]` binding is not of an image handle type; a descriptor-bound block or buffer of an ordinary type is `#[uniform]` or `#[storage]`");
        }

        var value_ty: u32 = 0;
        if (g.iface == ir.IFACE_UNIFORM || g.iface == ir.IFACE_STORAGE) {
            val ur: R.Result[u32, str] = block_type(e, gt, g.ty, g.iface == ir.IFACE_STORAGE);
            if (R.is_err[u32, str](ur)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ur)); }
            value_ty = R.unwrap_ok[u32, str](ur);
        }
        or { value_ty = global_spv_type(e, gt, g.ty); }
        if (value_ty == 0) {
            ret unsupported(e, "unsupported shader interface variable type in the SPIR-V target");
        }
        val ptr_ty: u32 = types.type_ptr(e.tt, storage, value_ty);
        val var_id: u32 = spirv.alloc_id(e.b);
        var vop: [3]u32;
        vop[0] = ptr_ty; vop[1] = var_id; vop[2] = storage;
        spirv.inst(e.b, ?e.b.types_consts, spirv.OP_VARIABLE, ?vop[0], 3);
        e.gvar_ids[i]  = var_id;
        e.gtype_ids[i] = value_ty;
        e.gstorage[i]  = storage;

        if (g.iface == ir.IFACE_INPUT || g.iface == ir.IFACE_OUTPUT) {
            decorate(e, var_id, spirv.DECOR_LOCATION, g.iface_a);
        }
        if (g.iface == ir.IFACE_BUILTIN) {
            decorate(e, var_id, spirv.DECOR_BUILTIN, builtin_selector(g.iface_a));
        }
        if (g.iface == ir.IFACE_UNIFORM || g.iface == ir.IFACE_STORAGE
            || g.iface == ir.IFACE_SAMPLER) {
            decorate(e, var_id, spirv.DECOR_DESCRIPTOR_SET, g.iface_a);
            decorate(e, var_id, spirv.DECOR_BINDING, g.iface_b);
        }
        if (g.iface == ir.IFACE_STORAGE && !gl_written(e, i)) {
            decorate_bare(e, var_id, spirv.DECOR_NON_WRITABLE);
        }
        e.iface_ids[e.iface_len] = var_id;
        e.gslot[i] = e.iface_len + 1;
        e.iface_len = e.iface_len + 1;
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun block_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, relaxed_stride: bool) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform global has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind != type.IRT_STRUCT) {
        ret R.err[u32, str]("a `#[uniform(...)]` variable must be a `rec`: a uniform is a descriptor-bound BLOCK with a host-visible layout, and a bare scalar or vector has no block layout for a pipeline to bind. wrap the value in a record with one field");
    }
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret R.err[u32, str]("a `#[uniform(...)]` / `#[storage(...)]` block must have between 1 and 16 fields");
    }

    val sr: R.Result[u32, str] = laid_out_struct(e, gt, id, relaxed_stride);
    if (R.is_err[u32, str](sr)) { ret sr; }
    val struct_id: u32 = R.unwrap_ok[u32, str](sr);

    var bops: [2]u32;
    bops[0] = struct_id; bops[1] = spirv.DECOR_BLOCK;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?bops[0], 2);
    ret R.ok[u32, str](struct_id);
}

fun laid_out_struct(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, relaxed_stride: bool) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform block member has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    val n: u32 = t.data.struct_.field_count;
    if (n == 0 || n > types.MAX_STRUCT_MEMBERS) {
        ret R.err[u32, str]("a `#[uniform(...)]` / `#[storage(...)]` block must have between 1 and 16 fields");
    }

    var members: [16]u32;
    var i: u32 = 0;
    for (i < n) {
        val mr: R.Result[u32, str] = laid_out_type(e, gt, t.data.struct_.fields[i], relaxed_stride);
        if (R.is_err[u32, str](mr)) { ret mr; }
        members[i] = R.unwrap_ok[u32, str](mr);
        i = i + 1;
    }

    val lr: R.Result[R.Void, str] = check_block_layout(e, gt, id, relaxed_stride);
    if (R.is_err[R.Void, str](lr)) { ret R.err[u32, str](R.unwrap_err[R.Void, str](lr)); }
    val struct_id: u32 = types.type_struct(e.tt, ?members[0], n, true);
    if (struct_id == 0) { ret R.err[u32, str]("spirv.emit: could not build a uniform block type"); }

    i = 0;
    for (i < n) {
        var mops: [4]u32;
        mops[0] = struct_id; mops[1] = i; mops[2] = spirv.DECOR_OFFSET;
        mops[3] = type.byte_offset_for_machine(gt, id, i, e.layout);
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_MEMBER_DECORATE, ?mops[0], 4);
        i = i + 1;
    }
    ret R.ok[u32, str](struct_id);
}

fun laid_out_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, relaxed_stride: bool) R.Result[u32, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.err[u32, str]("spirv.emit: uniform block member has no IR type"); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    if (t.kind == type.IRT_STRUCT) { ret laid_out_struct(e, gt, id, relaxed_stride); }

    if (t.kind == type.IRT_ARRAY) {
        val er: R.Result[u32, str] = laid_out_type(e, gt, t.data.array_.element, relaxed_stride);
        if (R.is_err[u32, str](er)) { ret er; }
        val elem_ty: u32 = R.unwrap_ok[u32, str](er);
        val stride: u32 = type.byte_size_for_machine(gt, t.data.array_.element, e.layout);
        val want: u32 = required_stride(e, gt, t.data.array_.element, relaxed_stride);
        if (want == 0) {
            ret R.err[u32, str]("unsupported uniform block member type in the SPIR-V target");
        }
        if (stride != want) {
            val ar: R.Result[str, str] = format.sprint(e.alloc,
                "an array inside a `{}` block needs an element stride of {} bytes in the SPIR-V target, and mach's layout packs it at {}: a block's array stride is rounded up to the element's base alignment, which mach's own layout does not do, so the shader and the host would disagree about where the elements are. pad the element to {} bytes, or use an element that is that wide already (`f32x4`){}",
                block_role(relaxed_stride), want, stride, want, storage_hint(relaxed_stride));
            if (R.is_err[str, str](ar)) {
                ret R.err[u32, str]("an array inside a `#[uniform(...)]` / `#[storage(...)]` block has an element stride mach's layout does not give it");
            }
            ret R.err[u32, str](R.unwrap_ok[str, str](ar));
        }
        val arr_id: u32 = types.type_array(e.tt, elem_ty, t.data.array_.count, true);
        if (arr_id == 0) { ret R.err[u32, str]("spirv.emit: could not build a uniform block array type"); }
        var aops: [3]u32;
        aops[0] = arr_id; aops[1] = spirv.DECOR_ARRAY_STRIDE; aops[2] = stride;
        spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?aops[0], 3);
        ret R.ok[u32, str](arr_id);
    }

    val mt: u32 = global_spv_type(e, gt, id);
    if (mt == 0) {
        ret R.err[u32, str]("unsupported uniform block member type in the SPIR-V target");
    }
    ret R.ok[u32, str](mt);
}

fun round_up_to(v: u32, a: u32) u32 {
    if (a == 0) { ret v; }
    val up: u32 = ((v + a - 1) / a) * a;
    if (up < v) { ret 0; }
    ret up;
}

fun block_role(std430: bool) str {
    if (std430) { ret "#[storage(...)]"; }
    ret "#[uniform(...)]";
}

fun storage_hint(std430: bool) str {
    if (std430) { ret ""; }
    ret ", and a `#[storage(...)]` buffer accepts any element width where read-write descriptor semantics are acceptable";
}

fun std_base_align(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    if (t.kind == type.IRT_STRUCT) {
        var a: u32 = 1;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val ma: u32 = std_base_align(e, gt, t.data.struct_.fields[i], std430);
            if (ma == 0) { ret 0; }
            if (ma > a) { a = ma; }
            i = i + 1;
        }
        if (!std430) { ret round_up_to(a, 16); }
        ret a;
    }
    if (t.kind == type.IRT_ARRAY) {
        val ea: u32 = std_base_align(e, gt, t.data.array_.element, std430);
        if (ea == 0) { ret 0; }
        if (!std430) { ret round_up_to(ea, 16); }
        ret ea;
    }
    if (t.kind == type.IRT_VECTOR) {
        val lane: u32 = type.byte_size_for_machine(gt, t.data.vector_.element, e.layout);
        if (t.data.vector_.lanes == 2) { ret 2 * lane; }
        ret 4 * lane;
    }
    if (t.kind == type.IRT_INT || t.kind == type.IRT_FLOAT) {
        ret type.byte_size_for_machine(gt, id, e.layout);
    }
    ret 0;
}

fun std_extent(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) u32 {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    if (t.kind == type.IRT_STRUCT) {
        val a: u32 = std_base_align(e, gt, id, std430);
        if (a == 0) { ret 0; }
        var end: u32 = 0;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            val me: u32 = std_extent(e, gt, t.data.struct_.fields[i], std430);
            if (me == 0) { ret 0; }
            val moff: u32 = type.byte_offset_for_machine(gt, id, i, e.layout);
            if (moff + me > end) { end = moff + me; }
            i = i + 1;
        }
        ret round_up_to(end, a);
    }
    if (t.kind == type.IRT_ARRAY) {
        val s: u32 = required_stride(e, gt, t.data.array_.element, std430);
        if (s == 0) { ret 0; }
        ret s * t.data.array_.count;
    }
    ret type.byte_size_for_machine(gt, id, e.layout);
}

fun required_stride(e: *Emit, gt: *type.IrTypeTable, elem: type.IrTypeId, std430: bool) u32 {
    var a: u32 = std_base_align(e, gt, elem, std430);
    if (a == 0) { ret 0; }
    if (!std430) { a = round_up_to(a, 16); }
    val ext: u32 = std_extent(e, gt, elem, std430);
    if (ext == 0) { ret 0; }
    ret round_up_to(ext, a);
}

fun check_block_layout(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId, std430: bool) R.Result[R.Void, str] {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret R.ok_void[str](); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);

    var prev_end: u32 = 0;
    var i: u32 = 0;
    for (i < t.data.struct_.field_count) {
        val fty: type.IrTypeId = t.data.struct_.fields[i];
        val a: u32 = std_base_align(e, gt, fty, std430);
        if (a == 0) { i = i + 1; cnt; }
        val off: u32 = type.byte_offset_for_machine(gt, id, i, e.layout);

        if ((off % a) != 0 || off < prev_end) {
            var want: u32 = round_up_to(prev_end, a);
            if (want < round_up_to(off, a)) { want = round_up_to(off, a); }
            ret R.err[R.Void, str](layout_refusal(e, gt, std430, i, fty, off, want, a,
                                                off < prev_end, prev_end));
        }
        val ext: u32 = std_extent(e, gt, fty, std430);
        if (ext == 0) { i = i + 1; cnt; }
        prev_end = off + ext;
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun layout_refusal(e: *Emit, gt: *type.IrTypeTable, std430: bool, ix: u32, fty: type.IrTypeId, off: u32,
                   want: u32, align: u32, overlaps: bool, prev_end: u32) str {
    var why: str = nil;
    if (overlaps) {
        val wr: R.Result[str, str] = format.sprint(e.alloc,
            "the member before it runs to offset {} under those rules and mach's layout ends it sooner, so the two overlap",
            prev_end);
        if (R.is_ok[str, str](wr)) { why = R.unwrap_ok[str, str](wr); }
    }
    or {
        val wr: R.Result[str, str] = format.sprint(e.alloc,
            "a member of this type has a base alignment of {} bytes under those rules and mach's layout does not place it on one",
            align);
        if (R.is_ok[str, str](wr)) { why = R.unwrap_ok[str, str](wr); }
    }
    if (why == nil) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }

    val r: R.Result[str, str] = format.sprint(e.alloc,
        "member {} of this `{}` block, a {}, is placed at offset {} by mach's layout and the SPIR-V block layout rules require offset {}: {}. the offsets are the host's contract, so this is refused rather than repacked - repacking would move the members out from under a host writing by `$offset_of`. pad the block explicitly so the member lands where the rules put it, or promote a nested record's members into the block{}",
        ix, block_role(std430), ir_type_spelling(gt, e.alloc, fty), off, want,
        why, storage_hint(std430));
    if (R.is_err[str, str](r)) {
        ret "a member of this block is placed at an offset the SPIR-V block layout rules do not allow";
    }
    ret R.unwrap_ok[str, str](r);
}

fun build_iface_uses(e: *Emit) R.Result[R.Void, str] {
    if (e.iface_len == 0 || e.fn_len == 0) { ret R.ok_void[str](); }
    val cells: u32 = e.fn_len * e.iface_len;
    val ru: R.Result[*u8, str] = A.allocate[u8](e.alloc, cells::usize);
    if (R.is_err[*u8, str](ru)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](ru)); }
    e.iface_use = R.unwrap_ok[*u8, str](ru);
    var c: u32 = 0;
    for (c < cells) { e.iface_use[c] = 0; c = c + 1; }

    var fx: u32 = 0;
    for (fx < e.fn_len) {
        val mf: *mir.MirFunction = fn_mir(e, fx);
        if (mf == nil) { fx = fx + 1; cnt; }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                var oi: u32 = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == mir.MIR_OP_SYM) {
                        val slot: u32 = iface_slot_of(e, mi.operands[oi].sym);
                        if (slot != 0) { e.iface_use[fx * e.iface_len + slot - 1] = 1; }
                    }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        fx = 0;
        for (fx < e.fn_len) {
            var ci: u32 = 0;
            for (ci < callee_count(e, fx)) {
                val cx: u32 = callee_at(e, fx, ci);
                if (cx != FN_NONE) {
                    var s: u32 = 0;
                    for (s < e.iface_len) {
                        if (e.iface_use[cx * e.iface_len + s] != 0
                            && e.iface_use[fx * e.iface_len + s] == 0) {
                            e.iface_use[fx * e.iface_len + s] = 1;
                            changed = true;
                        }
                        s = s + 1;
                    }
                }
                ci = ci + 1;
            }
            fx = fx + 1;
        }
    }
    ret R.ok_void[str]();
}

fun uses_iface(e: *Emit, fn_ix: u32, slot: u32) bool {
    if (e.iface_use == nil || fn_ix >= e.fn_len || slot >= e.iface_len) { ret false; }
    ret e.iface_use[fn_ix * e.iface_len + slot] != 0;
}

fun iface_slot_of(e: *Emit, name: intern.StrId) u32 {
    if (e.gslot == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gslot[gx];
}

fun check_call_graph(e: *Emit) R.Result[R.Void, str] {
    val n: u32 = e.fn_len;
    if (n == 0) { ret R.ok_void[str](); }

    val rs: R.Result[*u8, str] = A.allocate[u8](e.alloc, n::usize);
    if (R.is_err[*u8, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](rs)); }
    val state: *u8 = R.unwrap_ok[*u8, str](rs);
    val rp: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rp)) {
        A.deallocate[u8](e.alloc, state, n::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](rp));
    }
    val path: *u32 = R.unwrap_ok[*u32, str](rp);

    var i: u32 = 0;
    for (i < n) { state[i] = 0; path[i] = 0; i = i + 1; }

    var msg: str = nil;
    i = 0;
    for (i < n && msg == nil) {
        if (state[i] == 0 && e.fns[i].emit) { msg = cg_visit(e, state, path, 0, i); }
        i = i + 1;
    }

    A.deallocate[u8](e.alloc, state, n::usize);
    A.deallocate[u32](e.alloc, path, n::usize);
    if (msg != nil) { ret R.err[R.Void, str](msg); }
    ret R.ok_void[str]();
}

fun cg_visit(e: *Emit, state: *u8, path: *u32, depth: u32, ix: u32) str {
    state[ix] = 1;
    path[depth] = ix;

    var ci: u32 = 0;
    for (ci < callee_count(e, ix)) {
        val cx: u32 = callee_at(e, ix, ci);
        if (cx != FN_NONE && emittable(e, cx)) {
            if (state[cx] == 1) { ret cycle_refusal(e, path, depth + 1, cx); }
            if (state[cx] == 0) {
                val sub: str = cg_visit(e, state, path, depth + 1, cx);
                if (sub != nil) { ret sub; }
            }
        }
        ci = ci + 1;
    }

    state[ix] = 2;
    ret nil;
}

fun cycle_refusal(e: *Emit, path: *u32, depth: u32, closes: u32) str {
    var chain: str = ir_fn_spelling(e, closes);
    var i: u32 = 0;
    for (i < depth && path[i] != closes) { i = i + 1; }
    for (i < depth) {
        val r: R.Result[str, str] = format.sprint(e.alloc, "{} -> {}", chain,
                                                  ir_fn_spelling(e, path[i]));
        if (R.is_err[str, str](r)) { i = depth; cnt; }
        chain = R.unwrap_ok[str, str](r);
        i = i + 1;
    }
    val r2: R.Result[str, str] = format.sprint(e.alloc,
        "this call graph is a cycle and the SPIR-V target cannot express it: {}. a SPIR-V execution model has no call stack, so a function may not be reachable from itself. rewrite the recursion as a loop",
        chain);
    if (R.is_err[str, str](r2)) {
        ret "a recursive call is not expressible in the SPIR-V target: a SPIR-V execution model has no call stack, so a function may not be reachable from itself";
    }
    ret R.unwrap_ok[str, str](r2);
}

fun check_stage_interfaces(e: *Emit) R.Result[R.Void, str] {
    val n: u32 = e.gl_len;
    if (e.iface_len == 0 || n == 0) { ret R.ok_void[str](); }

    val rf: R.Result[*u8, str] = A.allocate[u8](e.alloc, n::usize);
    if (R.is_err[*u8, str](rf)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](rf)); }
    val flat: *u8 = R.unwrap_ok[*u8, str](rf);
    var i: u32 = 0;
    for (i < n) { flat[i] = 0; i = i + 1; }

    var msg: str = nil;
    var fx: u32 = 0;
    for (fx < e.fn_len && msg == nil) {
        if (!e.fns[fx].emit) { fx = fx + 1; cnt; }
        val fn: *ir.Function = fn_ir(e, fx);
        if (fn.stage == ir.STAGE_NONE) { fx = fx + 1; cnt; }
        i = 0;
        for (i < n) {
            if (e.gslot[i] == 0 || !uses_iface(e, fx, e.gslot[i] - 1)) { i = i + 1; cnt; }
            val gi: *ir.Global = gl_ir(e, i);
            if (e.gstorage[i] == spirv.STORAGE_INPUT && needs_flat(gl_types(e, i), gi.ty)) {
                if (fn.stage == ir.STAGE_FRAGMENT) { flat[i] = flat[i] | 1; }
                or (fn.stage == ir.STAGE_VERTEX)   { flat[i] = flat[i] | 2; }
                if (flat[i] == 3) {
                    msg = flat_conflict(e, i);
                    i = n; cnt;
                }
            }
            if (gi.iface == ir.IFACE_INPUT || gi.iface == ir.IFACE_OUTPUT) {
                msg = location_overlap(e, fx, i);
                if (msg != nil) { i = n; cnt; }
            }
            if (gi.iface == ir.IFACE_UNIFORM || gi.iface == ir.IFACE_STORAGE
                || gi.iface == ir.IFACE_SAMPLER) {
                msg = descriptor_overlap(e, fx, i);
                if (msg != nil) { i = n; cnt; }
            }
            i = i + 1;
        }
        fx = fx + 1;
    }

    if (msg == nil) {
        i = 0;
        for (i < n) {
            if ((flat[i] & 1) != 0) { decorate_bare(e, e.gvar_ids[i], spirv.DECOR_FLAT); }
            i = i + 1;
        }
    }
    A.deallocate[u8](e.alloc, flat, n::usize);
    if (msg != nil) { ret R.err[R.Void, str](msg); }
    ret R.ok_void[str]();
}

fun flat_conflict(e: *Emit, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "this `#[input({})]` variable, {}{}, is read by a vertex stage and by a fragment stage, and no SPIR-V module serves both: a fragment stage's integer or 64-bit input MUST carry a Flat decoration because such a value cannot be interpolated, and a vertex stage's input must NOT carry one. declare two variables. the two are different things anyway - a vertex stage's input is a vertex attribute, and a fragment stage's is the interpolated output of the stage before it",
        g.iface_a, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
    if (R.is_err[str, str](r)) {
        ret "an integer or 64-bit `#[input(...)]` cannot be read by a vertex stage and a fragment stage at once: the fragment stage requires a Flat decoration and the vertex stage forbids one";
    }
    ret R.unwrap_ok[str, str](r);
}

fun location_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    val lo: u32 = g.iface_a;
    val span: u32 = location_span(e, gl_types(e, gi), g.ty);
    var j: u32 = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != g.iface) { j = j + 1; cnt; }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) { j = j + 1; cnt; }
        val olo: u32 = o.iface_a;
        val ospan: u32 = location_span(e, gl_types(e, j), o.ty);
        if (lo < olo + ospan && olo < lo + span) {
            var what: str = "input";
            if (g.iface == ir.IFACE_OUTPUT) { what = "output"; }
            val fr: R.Result[str, str] = format.sprint(e.alloc,
                "two `#[{}(...)]` variables overlap in the stage `{}`: `#[{}({})]`, {}{}, occupies {} location(s) and so runs through location {}, and `#[{}({})]`, {}{}, starts inside it. a type wider than one location consumes the ones that follow it, so the numbers an author writes have to leave room for the type",
                what, ir_fn_spelling(e, fx), what, olo,
                ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
                ospan, olo + ospan - 1,
                what, lo, ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
            if (R.is_err[str, str](fr)) {
                ret "two shader interface variables occupy the same location: a type wider than one location consumes the ones that follow it";
            }
            ret R.unwrap_ok[str, str](fr);
        }
        j = j + 1;
    }
    ret nil;
}

fun descriptor_overlap(e: *Emit, fx: u32, gi: u32) str {
    val g: *ir.Global = gl_ir(e, gi);
    var j: u32 = 0;
    for (j < gi) {
        val o: *ir.Global = gl_ir(e, j);
        if (o.iface != ir.IFACE_UNIFORM && o.iface != ir.IFACE_STORAGE
            && o.iface != ir.IFACE_SAMPLER) { j = j + 1; cnt; }
        if (e.gslot[j] == 0 || !uses_iface(e, fx, e.gslot[j] - 1)) { j = j + 1; cnt; }
        if (o.iface_a != g.iface_a || o.iface_b != g.iface_b) { j = j + 1; cnt; }
        val fr: R.Result[str, str] = format.sprint(e.alloc,
            "two descriptor-bound variables claim the same `(set = {}, binding = {})` in the stage `{}`: `{}`, {}{}, and `{}`, {}{}. a host binds one resource to a descriptor slot, so a pipeline layout can satisfy only one of them and the other would read whatever the first was bound to. give them different bindings",
            g.iface_a, g.iface_b, ir_fn_spelling(e, fx),
            descriptor_role(o.iface), ir_type_spelling(gl_types(e, j), e.alloc, o.ty), gl_mod_prefix(e, j),
            descriptor_role(g.iface), ir_type_spelling(gl_types(e, gi), e.alloc, g.ty), gl_mod_prefix(e, gi));
        if (R.is_err[str, str](fr)) {
            ret "two descriptor-bound variables claim the same descriptor set and binding: a pipeline layout can satisfy only one of them";
        }
        ret R.unwrap_ok[str, str](fr);
    }
    ret nil;
}

fun descriptor_role(iface: u8) str {
    if (iface == ir.IFACE_STORAGE) { ret "#[storage(...)]"; }
    if (iface == ir.IFACE_SAMPLER) { ret "#[sampler(...)]"; }
    ret "#[uniform(...)]";
}

fun location_span(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret 1; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_STRUCT) {
        var total: u32 = 0;
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            total = total + location_span(e, gt, t.data.struct_.fields[i]);
            i = i + 1;
        }
        if (total == 0) { ret 1; }
        ret total;
    }
    if (t.kind == type.IRT_ARRAY) {
        val es: u32 = location_span(e, gt, t.data.array_.element);
        if (t.data.array_.count == 0) { ret 1; }
        ret es * t.data.array_.count;
    }
    val bytes: u32 = type.byte_size_for_machine(gt, id, e.layout);
    if (bytes <= 16) { ret 1; }
    ret (bytes + 15) / 16;
}

fun needs_flat(tt: *type.IrTypeTable, id: type.IrTypeId) bool {
    var lanes: u32     = 0;
    var bits: u32      = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) { ret false; }
    if (!is_float) { ret true; }
    ret bits == 64;
}

fun decorate_bare(e: *Emit, target: u32, decor: u32) {
    var ops: [2]u32;
    ops[0] = target; ops[1] = decor;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 2);
}

fun ir_fn_spelling(e: *Emit, ix: u32) str {
    if (ix >= e.fn_len) { ret "<unknown function>"; }
    val fn: *ir.Function = fn_ir(e, ix);
    var name: str = nil;
    if (fn.disp != intern.STR_NIL) {
        val d: O.Option[str] = intern.lookup(e.interner, fn.disp);
        if (O.is_some[str](d)) { name = O.unwrap[str](d); }
    }
    if (name == nil) {
        val o: O.Option[str] = intern.lookup(e.interner, fn.name);
        if (O.is_none[str](o)) { ret "<unknown function>"; }
        name = O.unwrap[str](o);
    }
    if (e.fns[ix].mi == e.u.root) { ret name; }
    val mo: O.Option[str] = intern.lookup(e.interner, fn_mod(e, ix).name);
    if (O.is_none[str](mo)) { ret name; }
    val q: R.Result[str, str] = format.sprint(e.alloc, "{}.{}", O.unwrap[str](mo), name);
    if (R.is_err[str, str](q)) { ret name; }
    ret R.unwrap_ok[str, str](q);
}

fun decorate(e: *Emit, target: u32, decor: u32, operand: u32) {
    var ops: [3]u32;
    ops[0] = target; ops[1] = decor; ops[2] = operand;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ?ops[0], 3);
}

fun builtin_required_type(which: u32, out_lanes: *u32, out_bits: *u32, out_is_float: *bool) str {
    @out_lanes = 1; @out_bits = 32; @out_is_float = true;
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_FRAG_COORD) {
        @out_lanes = 4;
        ret "`f32x4`, a four-component float vector";
    }
    if (which == ir.BUILTIN_POINT_SIZE) {
        ret "`f32`, a scalar float";
    }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION || which == ir.BUILTIN_LOCAL_INVOCATION
        || which == ir.BUILTIN_WORKGROUP_ID) {
        @out_lanes = 3; @out_is_float = false;
        ret "`u32x3`, a three-component 32-bit unsigned vector";
    }
    @out_is_float = false;
    ret "`u32` or `i32`, a scalar 32-bit integer";
}

fun builtin_type_refusal(tt: *type.IrTypeTable, alloc: *A.Allocator, which: u32,
                         ty: type.IrTypeId) str {
    var want_lanes: u32    = 0;
    var want_bits: u32     = 0;
    var want_is_float: bool = false;
    val want: str = builtin_required_type(which, ?want_lanes, ?want_bits, ?want_is_float);

    var got_lanes: u32     = 0;
    var got_bits: u32      = 0;
    var got_is_float: bool = false;
    if (ir_scalar_shape(tt, ty, ?got_lanes, ?got_bits, ?got_is_float)
        && got_lanes == want_lanes && got_bits == want_bits && got_is_float == want_is_float) {
        ret nil;
    }

    val r: R.Result[str, str] = format.sprint(alloc,
        "this `#[builtin(\"{}\")]` variable is declared {}, and SPIR-V specifies it as {}. the requirement is on the variable's TYPE rather than on how it is read, so a wider or narrower one is an invalid module rather than a wasteful one",
        builtin_spelling(which), ir_type_spelling(tt, alloc, ty), want);
    if (R.is_err[str, str](r)) {
        ret "this `#[builtin(\"...\")]` variable is declared at a type SPIR-V does not specify for it";
    }
    ret R.unwrap_ok[str, str](r);
}

fun builtin_spelling(which: u32) str {
    if (which == ir.BUILTIN_VERTEX_INDEX)      { ret "vertex_index"; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)    { ret "instance_index"; }
    if (which == ir.BUILTIN_FRAG_COORD)        { ret "frag_coord"; }
    if (which == ir.BUILTIN_POINT_SIZE)        { ret "point_size"; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION) { ret "global_invocation"; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)  { ret "local_invocation"; }
    if (which == ir.BUILTIN_WORKGROUP_ID)      { ret "workgroup_id"; }
    ret "position";
}

fun ir_scalar_shape(tt: *type.IrTypeTable, id: type.IrTypeId, out_lanes: *u32,
                    out_bits: *u32, out_is_float: *bool) bool {
    @out_lanes = 0; @out_bits = 0; @out_is_float = false;
    val opt: O.Option[*type.IrType] = type.get(tt, id);
    if (O.is_none[*type.IrType](opt)) { ret false; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_FLOAT) { @out_lanes = 1; @out_bits = t.data.bits; @out_is_float = true; ret true; }
    if (t.kind == type.IRT_INT)   { @out_lanes = 1; @out_bits = t.data.bits; ret true; }
    if (t.kind != type.IRT_VECTOR) { ret false; }
    val eopt: O.Option[*type.IrType] = type.get(tt, t.data.vector_.element);
    if (O.is_none[*type.IrType](eopt)) { ret false; }
    val et: *type.IrType = O.unwrap[*type.IrType](eopt);
    if (et.kind != type.IRT_FLOAT && et.kind != type.IRT_INT) { ret false; }
    @out_lanes = t.data.vector_.lanes;
    @out_bits = et.data.bits;
    @out_is_float = et.kind == type.IRT_FLOAT;
    ret true;
}

fun ir_type_spelling(tt: *type.IrTypeTable, alloc: *A.Allocator, id: type.IrTypeId) str {
    var lanes: u32     = 0;
    var bits: u32      = 0;
    var is_float: bool = false;
    if (!ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float)) {
        val opt: O.Option[*type.IrType] = type.get(tt, id);
        if (O.is_none[*type.IrType](opt)) { ret "an unresolved type"; }
        val k: type.IrTypeKind = O.unwrap[*type.IrType](opt).kind;
        if (k == type.IRT_PTR)    { ret "a pointer"; }
        if (k == type.IRT_ARRAY)  { ret "an array"; }
        if (k == type.IRT_STRUCT) { ret "a record"; }
        if (k == type.IRT_UNION)  { ret "a union"; }
        ret "a type with no scalar shape";
    }
    var r: R.Result[str, str];
    if (is_float && lanes == 1)  { r = format.sprint(alloc, "`f{}`", bits); }
    or (is_float)                { r = format.sprint(alloc, "`f{}x{}`", bits, lanes); }
    or (lanes == 1)              { r = format.sprint(alloc, "`i{}` / `u{}`", bits, bits); }
    or                           { r = format.sprint(alloc, "`i{}x{}` / `u{}x{}`", bits, lanes, bits, lanes); }
    if (R.is_err[str, str](r)) { ret "a type this diagnostic could not render"; }
    ret R.unwrap_ok[str, str](r);
}

fun builtin_selector(which: u32) u32 {
    if (which == ir.BUILTIN_VERTEX_INDEX)      { ret spirv.BUILTIN_VERTEX_INDEX; }
    if (which == ir.BUILTIN_INSTANCE_INDEX)    { ret spirv.BUILTIN_INSTANCE_INDEX; }
    if (which == ir.BUILTIN_FRAG_COORD)        { ret spirv.BUILTIN_FRAG_COORD; }
    if (which == ir.BUILTIN_POINT_SIZE)        { ret spirv.BUILTIN_POINT_SIZE; }
    if (which == ir.BUILTIN_GLOBAL_INVOCATION) { ret spirv.BUILTIN_GLOBAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_LOCAL_INVOCATION)  { ret spirv.BUILTIN_LOCAL_INVOCATION_ID; }
    if (which == ir.BUILTIN_WORKGROUP_ID)      { ret spirv.BUILTIN_WORKGROUP_ID; }
    ret spirv.BUILTIN_POSITION;
}

fun builtin_storage(which: u32) u32 {
    if (which == ir.BUILTIN_POSITION || which == ir.BUILTIN_POINT_SIZE) {
        ret spirv.STORAGE_OUTPUT;
    }
    ret spirv.STORAGE_INPUT;
}

fun global_var_id(e: *Emit, name: intern.StrId) u32 {
    if (e.gvar_ids == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gvar_ids[gx];
}

fun check_environment(e: *Emit) R.Result[R.Void, str] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa.ENV_NONE) { ret R.ok_void[str](); }
    val profile: *spirv.EnvProfile = spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret R.err[R.Void, str]("spirv: the target names an environment this backend has no profile for"); }
    e.b.version = profile.version;
    val excess: u32 = e.b.caps_needed & ~profile.ceiling;
    if (excess == 0) { ret R.ok_void[str](); }
    var bit: u32 = 1;
    for ((excess & bit) == 0) { bit = bit << 1; }
    val msg: R.Result[str, str] = format.sprint(e.alloc,
        "spirv: this module needs the {} capability, which the `{}` environment does not guarantee; raise `env` on the target or avoid the type that needs it",
        spirv.need_name(bit), profile.name);
    if (R.is_err[str, str](msg)) { ret R.err[R.Void, str]("spirv: this module needs a capability its environment does not guarantee"); }
    ret R.err[R.Void, str](R.unwrap_ok[str, str](msg));
}

fun emit_preamble(e: *Emit) {
    emit_cap(e, spirv.CAP_SHADER);
    if (!e.has_entry) { emit_cap(e, spirv.CAP_LINKAGE); }
    val need: u32 = e.b.caps_needed;
    if ((need & spirv.NEED_INT8) != 0)    { emit_cap(e, spirv.CAP_INT8); }
    if ((need & spirv.NEED_INT16) != 0)   { emit_cap(e, spirv.CAP_INT16); }
    if ((need & spirv.NEED_INT64) != 0)   { emit_cap(e, spirv.CAP_INT64); }
    if ((need & spirv.NEED_FLOAT16) != 0) { emit_cap(e, spirv.CAP_FLOAT16); }
    if ((need & spirv.NEED_FLOAT64) != 0) { emit_cap(e, spirv.CAP_FLOAT64); }
    if ((need & spirv.NEED_SAMPLED_1D) != 0)         { emit_cap(e, spirv.CAP_SAMPLED_1D); }
    if ((need & spirv.NEED_SAMPLED_CUBE_ARRAY) != 0) { emit_cap(e, spirv.CAP_SAMPLED_CUBE_ARRAY); }
    var mm: [2]u32;
    mm[0] = spirv.ADDRESSING_LOGICAL;
    mm[1] = spirv.MEMORY_GLSL450;
    spirv.inst(e.b, ?e.b.memory_model, spirv.OP_MEMORY_MODEL, ?mm[0], 2);
}

fun emit_cap(e: *Emit, cap: u32) {
    var o: [1]u32;
    o[0] = cap;
    spirv.inst(e.b, ?e.b.caps, spirv.OP_CAPABILITY, ?o[0], 1);
}

fun emit_function(e: *Emit, fx: u32) R.Result[R.Void, str] {
    val mf: *mir.MirFunction = fn_mir(e, fx);
    if (mf == nil) { ret R.err[R.Void, str]("spirv.emit: an emitted function has no lowered body"); }
    e.cur_fn = mf;
    e.cur_instr = nil;
    e.cur_mi = e.fns[fx].mi;
    e.ir = fn_mod(e, fx);
    val irfn: *ir.Function = fn_ir(e, fx);

    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        ret unsupported(e, "unsupported return type in the SPIR-V target");
    }
    var ptypes: [16]u32;
    if (irfn.param_count > types.MAX_FN_PARAMS) {
        ret unsupported(e, "more than 16 parameters is not supported by the SPIR-V target");
    }
    var pi: u32 = 0;
    for (pi < irfn.param_count) {
        val pt: u32 = ir_value_spv_type(e, irfn.params[pi].ty);
        if (pt == 0) {
            ret unsupported(e, "unsupported parameter type in the SPIR-V target");
        }
        ptypes[pi] = pt;
        pi = pi + 1;
    }
    val fnty: u32 = types.type_fn(e.tt, ret_ty, ?ptypes[0], irfn.param_count);
    if (fnty == 0) {
        ret unsupported(e, "this signature has no SPIR-V function type in the SPIR-V target");
    }

    val fn_id: u32 = e.fns[fx].id;

    val name_opt: O.Option[str] = intern.lookup(e.interner, mf.name);
    if (O.is_none[str](name_opt)) { ret R.err[R.Void, str]("spirv.emit: function name not interned"); }
    val fn_name: str = O.unwrap[str](name_opt);

    if (irfn.stage != ir.STAGE_NONE) {
        val er: R.Result[R.Void, str] = emit_entry_point(e, irfn, fx, fn_id, entry_name(e, irfn, fn_name), returns_void);
        if (R.is_err[R.Void, str](er)) { ret er; }
    }
    or (!e.has_entry && e.fns[fx].mi == e.u.root) { emit_linkage_export(e, fn_id, fn_name); }

    val cr: R.Result[cfg.Structure, str] = cfg.analyze(mf, e.alloc);
    if (R.is_err[cfg.Structure, str](cr)) { ret R.err[R.Void, str](R.unwrap_err[cfg.Structure, str](cr)); }
    var st: cfg.Structure = R.unwrap_ok[cfg.Structure, str](cr);
    if (st.status != cfg.CFG_OK) {
        val msg: str = cfg_refusal(e, fn_name, ?st);
        cfg.dnit(?st);
        ret R.err[R.Void, str](msg);
    }

    var fop: [4]u32;
    fop[0] = ret_ty; fop[1] = fn_id; fop[2] = spirv.FUNCTION_CONTROL_NONE; fop[3] = fnty;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION, ?fop[0], 4);

    var param_ids: [16]u32;
    pi = 0;
    for (pi < irfn.param_count) {
        val pid: u32 = spirv.alloc_id(e.b);
        var pp: [2]u32;
        pp[0] = ptypes[pi]; pp[1] = pid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_PARAMETER, ?pp[0], 2);
        param_ids[pi] = pid;
        pi = pi + 1;
    }

    val rl: R.Result[*u32, str] = A.allocate[u32](e.alloc, st.count::usize);
    if (R.is_err[*u32, str](rl)) {
        cfg.dnit(?st);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](rl));
    }
    val labels: *u32 = R.unwrap_ok[*u32, str](rl);
    var li: u32 = 0;
    for (li < st.count) { labels[li] = spirv.alloc_id(e.b); li = li + 1; }

    var lb: [1]u32;
    lb[0] = labels[st.order[0]];
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);

    var vm: VMaps;
    val mr: R.Result[R.Void, str] = build_vmaps(e, mf, irfn, ?vm);
    if (R.is_err[R.Void, str](mr)) {
        A.deallocate[u32](e.alloc, labels, st.count::usize);
        cfg.dnit(?st);
        ret mr;
    }

    var body: R.Result[R.Void, str] = R.ok_void[str]();
    var oi: u32 = 0;
    for (oi < st.count) {
        body = emit_node(e, mf, ?st, st.order[oi], oi == 0, labels, ?vm,
                         ?param_ids[0], irfn.param_count, returns_void, ret_ty);
        if (R.is_err[R.Void, str](body)) { oi = st.count; cnt; }
        oi = oi + 1;
    }

    vmaps_dnit(e, ?vm);
    A.deallocate[u32](e.alloc, labels, st.count::usize);
    cfg.dnit(?st);
    if (R.is_err[R.Void, str](body)) { ret body; }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_END, nil, 0);
    if (e.b.err) { ret R.err[R.Void, str]("spirv.emit: module builder hit an allocation error"); }
    ret R.ok_void[str]();
}

val ADDR_UNKNOWN: u8 = 0;
val ADDR_GLOBAL:  u8 = 1;
val ADDR_ALLOCA:  u8 = 2;

fun address_origin(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand, out_ix: *u32) u8 {
    @out_ix = 0;
    if (op.kind == mir.MIR_OP_SYM) {
        val gx: u32 = gl_lookup(e, op.sym);
        if (gx != GL_NONE) { @out_ix = gx; ret ADDR_GLOBAL; }
        ret ADDR_UNKNOWN;
    }
    var base: u32 = mir.MIR_VREG_NIL;
    if (op.kind == mir.MIR_OP_VREG) { base = op.vreg; }
    or (op.kind == mir.MIR_OP_MEM) { base = op.vreg; }
    if (base == mir.MIR_VREG_NIL) { ret ADDR_UNKNOWN; }

    val def: *mir.MirInstr = defining_instr(mf, base);
    if (def == nil) { ret ADDR_UNKNOWN; }
    if (def.opcode == mir.MIR_ALLOCA) { ret ADDR_ALLOCA; }
    if (def.opcode == mir.MIR_GEP && def.operand_count >= 2
        && def.operands[1].kind == mir.MIR_OP_SYM) {
        ret address_origin(e, mf, ?def.operands[1], out_ix);
    }
    ret ADDR_UNKNOWN;
}

fun defining_instr(mf: *mir.MirFunction, vreg: u32) *mir.MirInstr {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mir.instr_defines_shape(mi) && mi.operand_count > 0
                && mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[0].vreg == vreg) {
                ret mi;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret nil;
}

fun address_operand_index(mi: *mir.MirInstr) u32 {
    if (mi.opcode == mir.MIR_LOAD) { ret 1; }
    ret 0;
}

fun cfg_refusal(e: *Emit, name: str, st: *cfg.Structure) str {
    val reason: str = cfg.status_message(st.status);
    val jr: R.Result[str, str] = str_join(e.alloc, "spirv.emit: ", name, ": ", reason);
    if (R.is_err[str, str](jr)) { ret reason; }
    val buf: str = R.unwrap_ok[str, str](jr);
    val ir: R.Result[intern.StrId, str] = intern.intern(e.interner, buf);
    A.deallocate[u8](e.alloc, buf::*u8, str_len(buf) + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret reason; }
    val io: O.Option[str] = intern.lookup(e.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_none[str](io)) { ret reason; }
    ret O.unwrap[str](io);
}

fun emit_node(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, is_entry: bool,
              labels: *u32, vm: *VMaps, param_ids: *u32, param_count: u32,
              returns_void: bool, ret_ty: u32) R.Result[R.Void, str] {
    if (!is_entry) {
        var lb: [1]u32;
        lb[0] = labels[ix];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LABEL, ?lb[0], 1);
    }

    val role: u8 = st.nodes[ix].role;
    if (role == cfg.ROLE_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret R.ok_void[str]();
    }
    if (role == cfg.ROLE_CONTINUE || role == cfg.ROLE_FORWARD) {
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret R.ok_void[str]();
    }

    var rg: Regs;
    var i: u32 = 0;
    for (i < types.MAX_FN_PARAMS) { rg.val_id[i] = 0; rg.imm[i] = 0; rg.is_imm[i] = false; rg.is_bool[i] = false; i = i + 1; }

    if (param_count > types.MAX_FN_PARAMS) {
        ret R.err[R.Void, str]("spirv.emit: a function reached body emission with more parameters than the register file holds");
    }
    i = 0;
    for (i < param_count) { rg.val_id[i] = param_ids[i]; i = i + 1; }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    if (role == cfg.ROLE_REAL) {
        var ii: u32 = 0;
        for (ii + 1 < blk.instr_count) {
            val r: R.Result[R.Void, str] = emit_instr(e, mf, vm, ?rg, ?blk.instrs[ii]);
            if (R.is_err[R.Void, str](r)) { ret r; }
            ii = ii + 1;
        }
    }

    ret emit_terminator(e, mf, st, ix, labels, vm, ?rg, returns_void, ret_ty);
}

fun emit_merge(e: *Emit, st: *cfg.Structure, ix: u32, labels: *u32) {
    if (st.nodes[ix].kind == cfg.CK_LOOP) {
        var lm: [3]u32;
        lm[0] = labels[st.nodes[ix].merge];
        lm[1] = labels[st.nodes[ix].cont];
        lm[2] = spirv.LOOP_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOOP_MERGE, ?lm[0], 3);
        ret;
    }
    if (st.nodes[ix].kind == cfg.CK_SELECTION) {
        var sm: [2]u32;
        sm[0] = labels[st.nodes[ix].merge];
        sm[1] = spirv.SELECTION_CONTROL_NONE;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECTION_MERGE, ?sm[0], 2);
    }
}

fun emit_branch(e: *Emit, label: u32) {
    var o: [1]u32;
    o[0] = label;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH, ?o[0], 1);
}

fun emit_terminator(e: *Emit, mf: *mir.MirFunction, st: *cfg.Structure, ix: u32, labels: *u32,
                    vm: *VMaps, preg_val: *Regs, returns_void: bool, ret_ty: u32) R.Result[R.Void, str] {
    if (st.nodes[ix].split != cfg.NO_BLOCK) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].split]);
        ret R.ok_void[str]();
    }

    val blk: *mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    val term: *mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    e.cur_instr = term;

    if (term.opcode == mir.MIR_BR) {
        emit_merge(e, st, ix, labels);
        emit_branch(e, labels[st.nodes[ix].succ0]);
        ret R.ok_void[str]();
    }
    if (term.opcode == mir.MIR_CBR) {
        val cond: u32 = read_condition(e, vm, preg_val, ?term.operands[0]);
        if (cond == 0) { ret emit_fail(e, "spirv.emit: unreadable branch condition"); }
        emit_merge(e, st, ix, labels);
        var bc: [3]u32;
        bc[0] = cond;
        bc[1] = labels[st.nodes[ix].succ0];
        bc[2] = labels[st.nodes[ix].succ1];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_BRANCH_CONDITIONAL, ?bc[0], 3);
        ret R.ok_void[str]();
    }
    if (term.opcode == mir.MIR_UNREACHABLE) {
        spirv.inst(e.b, ?e.b.functions, spirv.OP_UNREACHABLE, nil, 0);
        ret R.ok_void[str]();
    }
    if (term.opcode == mir.MIR_RET) {
        if (returns_void) {
            spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN, nil, 0);
            ret R.ok_void[str]();
        }
        val rid: u32 = reg_value(e, preg_val, 0, ret_ty);
        if (rid == 0) { ret emit_fail(e, "spirv.emit: value return with no pre-colored result"); }
        var rv: [1]u32;
        rv[0] = rid;
        spirv.inst(e.b, ?e.b.functions, spirv.OP_RETURN_VALUE, ?rv[0], 1);
        ret R.ok_void[str]();
    }
    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

fun read_condition(e: *Emit, vm: *VMaps, preg_val: *Regs, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_VREG) { e.b.err = true; ret 0; }
    val v: u32 = op.vreg;
    if (v >= vm.n) { e.b.err = true; ret 0; }
    val ty: u32 = vm.type_id[v];
    val raw: u32 = read_operand(e, vm, preg_val, op, ty);
    if (e.b.err || raw == 0) { ret 0; }
    if (vm.is_bool[v]) { ret raw; }

    var cmp_ty: u32 = ty;
    if (cmp_ty == 0) { cmp_ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    var opcode: u32 = spirv.OP_I_NOT_EQUAL;
    if (types.type_is_float(e.tt, cmp_ty)) { opcode = spirv.OP_F_UNORD_NOT_EQUAL; }
    val zero: u32 = types.const_scalar(e.tt, cmp_ty, 0, 0);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = types.type_bool(e.tt); ops[1] = result; ops[2] = raw; ops[3] = zero;
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], 4);
    ret result;
}

fun entry_name(e: *Emit, irfn: *ir.Function, linkage: str) str {
    if (irfn.disp == intern.STR_NIL) { ret linkage; }
    val opt: O.Option[str] = intern.lookup(e.interner, irfn.disp);
    if (O.is_none[str](opt)) { ret linkage; }
    ret O.unwrap[str](opt);
}

fun emit_entry_point(e: *Emit, irfn: *ir.Function, fn_ix: u32, fn_id: u32, name: str,
                     returns_void: bool) R.Result[R.Void, str] {
    if (!returns_void) {
        ret unsupported(e, "a function declaring a `#[stage(...)]` must return nothing: a pipeline stage's results leave through its output interface variables, not through a return value");
    }
    if (irfn.param_count != 0) {
        ret unsupported(e, "a function declaring a `#[stage(...)]` must take no parameters: a pipeline stage's inputs arrive through its input interface variables, not as arguments");
    }

    var model: u32 = spirv.EXEC_MODEL_VERTEX;
    if (irfn.stage == ir.STAGE_FRAGMENT) { model = spirv.EXEC_MODEL_FRAGMENT; }
    or (irfn.stage == ir.STAGE_COMPUTE)  { model = spirv.EXEC_MODEL_GLCOMPUTE; }

    val sw_r: R.Result[u32, str] = spirv.string_words(name);
    if (R.is_err[u32, str](sw_r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](sw_r)); }
    val sw: u32 = R.unwrap_ok[u32, str](sw_r);
    var used: u32 = 0;
    var si: u32 = 0;
    for (si < e.iface_len) {
        if (uses_iface(e, fn_ix, si)) { used = used + 1; }
        si = si + 1;
    }
    val total: u32 = 2 + sw + used;
    val ra: R.Result[*u32, str] = A.allocate[u32](e.alloc, total::usize);
    if (R.is_err[*u32, str](ra)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ra)); }
    val ops: *u32 = R.unwrap_ok[*u32, str](ra);
    ops[0] = model;
    ops[1] = fn_id;
    spirv.pack_string(name, sw, ?ops[2]);
    var ii: u32 = 0;
    si = 0;
    for (si < e.iface_len) {
        if (uses_iface(e, fn_ix, si)) { ops[2 + sw + ii] = e.iface_ids[si]; ii = ii + 1; }
        si = si + 1;
    }
    spirv.inst(e.b, ?e.b.entry_points, spirv.OP_ENTRY_POINT, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);

    if (irfn.stage == ir.STAGE_FRAGMENT) {
        var fm: [2]u32;
        fm[0] = fn_id; fm[1] = spirv.EXEC_MODE_ORIGIN_UPPER_LEFT;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?fm[0], 2);
    }
    if (irfn.stage == ir.STAGE_COMPUTE) {
        var cm: [5]u32;
        cm[0] = fn_id; cm[1] = spirv.EXEC_MODE_LOCAL_SIZE;
        cm[2] = irfn.wg_x; cm[3] = irfn.wg_y; cm[4] = irfn.wg_z;
        spirv.inst(e.b, ?e.b.exec_modes, spirv.OP_EXECUTION_MODE, ?cm[0], 5);
    }
    ret R.ok_void[str]();
}

fun emit_linkage_export(e: *Emit, fn: u32, name: str) {
    val sw_r: R.Result[u32, str] = spirv.string_words(name);
    if (R.is_err[u32, str](sw_r)) { e.b.err = true; ret; }
    val sw: u32 = R.unwrap_ok[u32, str](sw_r);
    val total: u32 = 3 + sw;
    val ra: R.Result[*u32, str] = A.allocate[u32](e.alloc, total::usize);
    if (R.is_err[*u32, str](ra)) { e.b.err = true; ret; }
    val ops: *u32 = R.unwrap_ok[*u32, str](ra);
    ops[0] = fn;
    ops[1] = spirv.DECOR_LINKAGE_ATTRIBUTES;
    spirv.pack_string(name, sw, ?ops[2]);
    ops[2 + sw] = spirv.LINKAGE_EXPORT;
    spirv.inst(e.b, ?e.b.decorations, spirv.OP_DECORATE, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);
}

fun build_vmaps(e: *Emit, mf: *mir.MirFunction, irfn: *ir.Function, out: *VMaps) R.Result[R.Void, str] {
    val n: u32 = mf.vreg_count;
    out.n = n;
    out.type_id = nil;
    out.var_id  = nil;
    out.is_bool = nil;
    out.chain_id = nil;
    out.chain_ty = nil;
    out.chain_sc = nil;
    out.opq_var = nil;
    out.opq_ssa = nil;
    if (n == 0) { ret R.ok_void[str](); }

    val rt: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rt)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rt)); }
    out.type_id = R.unwrap_ok[*u32, str](rt);
    val rv: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rv)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rv)); }
    out.var_id = R.unwrap_ok[*u32, str](rv);
    val rb: R.Result[*bool, str] = A.allocate[bool](e.alloc, n::usize);
    if (R.is_err[*bool, str](rb)) { ret R.err[R.Void, str](R.unwrap_err[*bool, str](rb)); }
    out.is_bool = R.unwrap_ok[*bool, str](rb);
    val rch: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rch)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rch)); }
    out.chain_id = R.unwrap_ok[*u32, str](rch);
    val rct: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rct)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rct)); }
    out.chain_ty = R.unwrap_ok[*u32, str](rct);
    val rcs: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rcs)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rcs)); }
    out.chain_sc = R.unwrap_ok[*u32, str](rcs);
    val rov: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](rov)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rov)); }
    out.opq_var = R.unwrap_ok[*u32, str](rov);
    val ros: R.Result[*u32, str] = A.allocate[u32](e.alloc, n::usize);
    if (R.is_err[*u32, str](ros)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ros)); }
    out.opq_ssa = R.unwrap_ok[*u32, str](ros);

    var i: u32 = 0;
    for (i < n) { out.type_id[i] = 0; out.var_id[i] = 0; out.is_bool[i] = false; out.chain_id[i] = 0; out.chain_ty[i] = 0; out.chain_sc[i] = 0; out.opq_var[i] = 0; out.opq_ssa[i] = 0; i = i + 1; }

    var pb: u32 = 0;
    for (pb < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[pb];
        var ei: u32 = 0;
        var callee: intern.StrId = intern.STR_NIL;
        for (ei < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ei];
            if (mi.opcode == mir.MIR_CALL && mi.operand_count >= 1 && mi.operands[0].kind == mir.MIR_OP_SYM) {
                callee = mi.operands[0].sym;
            }
            or (mi.opcode == mir.MIR_CALL_RES) { callee = intern.STR_NIL; }
            or (mi.opcode == mir.MIR_MOV && mi.operand_count == 2 &&
                mi.operands[0].kind == mir.MIR_OP_VREG && mi.operands[1].kind == mir.MIR_OP_PREG) {
                val k: u32 = mi.operands[1].preg;
                val v: u32 = mi.operands[0].vreg;
                var t: u32 = 0;
                if (callee != intern.STR_NIL) {
                    val cfn: *ir.Function = ir_function_record(e.ir, callee);
                    if (cfn != nil) {
                        var cvoid: bool = false;
                        t = ir_return_spv_type(e, cfn, ?cvoid);
                        if (cvoid) { t = 0; }
                    }
                    callee = intern.STR_NIL;
                }
                or (k < irfn.param_count) {
                    t = ir_value_spv_type(e, irfn.params[k].ty);
                }
                if (t != 0 && v < n && out.type_id[v] == 0) {
                    out.type_id[v] = t;
                    out.is_bool[v] = types.type_is_bool(e.tt, t);
                }
            }
            ei = ei + 1;
        }
        pb = pb + 1;
    }

    val r1: R.Result[R.Void, str] = type_computed_defs(e, mf, out, true);
    if (R.is_err[R.Void, str](r1)) { ret r1; }
    propagate_copy_types(mf, out);
    seed_declared_copy_types(e, mf, out);
    propagate_copy_types(mf, out);
    val r2: R.Result[R.Void, str] = type_computed_defs(e, mf, out, false);
    if (R.is_err[R.Void, str](r2)) { ret r2; }

    val ar: R.Result[R.Void, str] = declare_allocas(e, mf, out);
    if (R.is_err[R.Void, str](ar)) { ret ar; }

    i = 0;
    for (i < n) {
        if (out.type_id[i] != 0 && !types.type_is_opaque(e.tt, out.type_id[i])) {
            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, out.type_id[i]);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop: [3]u32;
            vop[0] = ptr_ty; vop[1] = var_id; vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            out.var_id[i] = var_id;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun declare_allocas(e: *Emit, mf: *mir.MirFunction, out: *VMaps) R.Result[R.Void, str] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode != mir.MIR_ALLOCA || mi.operand_count < 2
                || mi.operands[0].kind != mir.MIR_OP_VREG) { ii = ii + 1; cnt; }
            val dst: u32 = mi.operands[0].vreg;
            if (dst >= out.n) { ii = ii + 1; cnt; }

            val slot: *mir.MirSlot = find_slot(mf, mi.operands[1].vreg);
            if (slot == nil || slot.ty == mir.SLOT_TY_NIL) {
                ret unsupported(e, "a local allocation whose type was not recorded is not supported by the SPIR-V target: a shader variable needs a type, and a size and alignment do not determine one");
            }
            val ty: u32 = ir_value_spv_type(e, slot.ty);
            if (ty == 0) {
                ret unsupported(e, "unsupported local allocation type in the SPIR-V target");
            }
            if (slot.size != type.byte_size_for_machine(?e.ir.types, slot.ty, e.layout)) {
                ret unsupported(e, "a multi-element local allocation is not supported by the SPIR-V target: it is an array of whole objects reached by pointer arithmetic, which the logical addressing model has no form for");
            }

            val ptr_ty: u32 = types.type_ptr(e.tt, spirv.STORAGE_FUNCTION, ty);
            val var_id: u32 = spirv.alloc_id(e.b);
            var vop: [3]u32;
            vop[0] = ptr_ty; vop[1] = var_id; vop[2] = spirv.STORAGE_FUNCTION;
            spirv.inst(e.b, ?e.b.functions, spirv.OP_VARIABLE, ?vop[0], 3);
            out.chain_id[dst] = var_id;
            out.chain_ty[dst] = ty;
            out.chain_sc[dst] = spirv.STORAGE_FUNCTION;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun find_slot(mf: *mir.MirFunction, key: u32) *mir.MirSlot {
    var i: u32 = 0;
    for (i < mf.frame.slot_count) {
        if (mf.frame.slots[i].value == key) { ret ?mf.frame.slots[i]; }
        i = i + 1;
    }
    ret nil;
}

fun type_computed_defs(e: *Emit, mf: *mir.MirFunction, out: *VMaps, skip_copies: bool) R.Result[R.Void, str] {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == mir.MIR_GEP || mi.opcode == mir.MIR_ALLOCA) { ii = ii + 1; cnt; }
            if (mi.opcode == mir.MIR_LOAD && mi.operand_count == 2
                && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val lv: u32 = mi.operands[0].vreg;
                val lt: u32 = interface_value_type(e, ?mi.operands[1]);
                if (lv < out.n && out.type_id[lv] == 0 && lt != 0) {
                    out.type_id[lv] = lt;
                    out.is_bool[lv] = types.type_is_bool(e.tt, lt);
                    ii = ii + 1;
                    cnt;
                }
            }
            if (mir.instr_defines_shape(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg;
                if (v < out.n && out.type_id[v] == 0 && !(skip_copies && is_reg_copy(mi))) {
                    val boolean: bool = (mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP)
                                     && !mir.vec_lane_is_vector(mi.vec_lane);
                    out.is_bool[v] = boolean;
                    if (boolean) {
                        out.type_id[v] = types.type_bool(e.tt);
                    }
                    or {
                        var bytes: u32 = mi.width::u32;
                        if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
                        val t: u32 = value_type_for(e, mf, mi, v, bytes::u8);
                        if (t == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
                        out.type_id[v] = t;
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun is_reg_copy(mi: *mir.MirInstr) bool {
    if (mi.opcode != mir.MIR_MOV && mi.opcode != mir.MIR_DECLASSIFY) { ret false; }
    if (mi.operand_count != 2) { ret false; }
    ret mi.operands[1].kind == mir.MIR_OP_VREG || mi.operands[1].kind == mir.MIR_OP_PREG
     || mi.operands[1].kind == mir.MIR_OP_IMM;
}

fun propagate_copy_types(mf: *mir.MirFunction, out: *VMaps) {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *mir.MirBlock = ?mf.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val mi: *mir.MirInstr = ?blk.instrs[ii];
                if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG &&
                    mi.operands[1].kind == mir.MIR_OP_VREG) {
                    val d:  u32 = mi.operands[0].vreg;
                    val sv: u32 = mi.operands[1].vreg;
                    if (d < out.n && sv < out.n && out.type_id[d] == 0 && out.type_id[sv] != 0) {
                        out.type_id[d] = out.type_id[sv];
                        out.is_bool[d] = out.is_bool[sv];
                        changed = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

fun seed_declared_copy_types(e: *Emit, mf: *mir.MirFunction, out: *VMaps) {
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *mir.MirBlock = ?mf.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (is_reg_copy(mi) && mi.operands[0].kind == mir.MIR_OP_VREG) {
                val v: u32 = mi.operands[0].vreg;
                if (v < out.n && v < mf.vreg_count && out.type_id[v] == 0
                    && mf.vregs[v].ty != mir.VREG_TY_NIL) {
                    val t: u32 = ir_value_spv_type(e, mf.vregs[v].ty);
                    if (t != 0) {
                        out.type_id[v] = t;
                        out.is_bool[v] = types.type_is_bool(e.tt, t);
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun vmaps_dnit(e: *Emit, vm: *VMaps) {
    if (vm.type_id != nil) { A.deallocate[u32](e.alloc, vm.type_id, vm.n::usize); }
    if (vm.var_id != nil)  { A.deallocate[u32](e.alloc, vm.var_id, vm.n::usize); }
    if (vm.is_bool != nil) { A.deallocate[bool](e.alloc, vm.is_bool, vm.n::usize); }
    if (vm.opq_var != nil) { A.deallocate[u32](e.alloc, vm.opq_var, vm.n::usize); }
    if (vm.opq_ssa != nil) { A.deallocate[u32](e.alloc, vm.opq_ssa, vm.n::usize); }
    if (vm.chain_id != nil) { A.deallocate[u32](e.alloc, vm.chain_id, vm.n::usize); }
    if (vm.chain_ty != nil) { A.deallocate[u32](e.alloc, vm.chain_ty, vm.n::usize); }
    if (vm.chain_sc != nil) { A.deallocate[u32](e.alloc, vm.chain_sc, vm.n::usize); }
    vm.type_id = nil; vm.var_id = nil; vm.is_bool = nil;
    vm.chain_id = nil; vm.chain_ty = nil; vm.chain_sc = nil; vm.n = 0;
}

fun lane_type_of(e: *Emit, lane: u32) u32 {
    val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
    if (mir.vec_lane_kind(lane) == mir.VEC_LANE_FLOAT) {
        if (bits != 32 && bits != 64) { ret 0; }
        ret types.type_float(e.tt, bits);
    }
    if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
    ret types.type_int(e.tt, bits);
}

fun vector_type_of(e: *Emit, lane: u32, as_int: bool) u32 {
    var lane_ty: u32 = 0;
    if (as_int) {
        val bits: u32 = mir.vec_lane_elem_bytes(lane)::u32 * 8;
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
        lane_ty = types.type_int(e.tt, bits);
    }
    or { lane_ty = lane_type_of(e, lane); }
    if (lane_ty == 0) { ret 0; }
    ret types.type_vector_value(e.tt, lane_ty, mir.vec_lane_count(lane));
}

fun value_type_for(e: *Emit, mf: *mir.MirFunction, mi: *mir.MirInstr, vreg: u32, width: u8) u32 {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret lane_type_of(e, mi.vec_lane); }
        val as_int: bool = mir.is_cmp_opcode(mi.opcode) || mi.opcode == mir.MIR_FCMP;
        ret vector_type_of(e, mi.vec_lane, as_int);
    }
    var bytes: u32 = width::u32;
    if (bytes == 0) { bytes = e.tgt.model.gpr_width; }
    val bits: u32 = bytes * 8;
    if (mir.vreg_is_fp(mf, vreg)) {
        if (bits == 32 || bits == 64) { ret types.type_float(e.tt, bits); }
        ret 0;
    }
    if (bits == 8 || bits == 16 || bits == 32 || bits == 64) { ret types.type_int(e.tt, bits); }
    ret 0;
}

fun spv_type_of(e: *Emit, tys: *type.IrTypeTable, id: type.IrTypeId) u32 {
    val opt: O.Option[*type.IrType] = type.get(tys, id);
    if (O.is_none[*type.IrType](opt)) { ret 0; }
    val t: *type.IrType = O.unwrap[*type.IrType](opt);
    if (t.kind == type.IRT_INT)   { ret types.type_int(e.tt, t.data.bits); }
    if (t.kind == type.IRT_FLOAT) { ret types.type_float(e.tt, t.data.bits); }
    if (t.kind == type.IRT_VECTOR) {
        val elem: u32 = spv_type_of(e, tys, t.data.vector_.element);
        if (elem == 0) { ret 0; }
        ret types.type_vector_value(e.tt, elem, t.data.vector_.lanes);
    }
    if (t.kind == type.IRT_ARRAY) {
        val elem: u32 = spv_type_of(e, tys, t.data.array_.element);
        if (elem == 0) { ret 0; }
        ret types.type_array(e.tt, elem, t.data.array_.count, false);
    }
    if (t.kind == type.IRT_HANDLE) { ret handle_spv_type(e, tys, t); }
    if (t.kind == type.IRT_STRUCT) {
        val n: u32 = t.data.struct_.field_count;
        if (n == 0 || n > types.MAX_STRUCT_MEMBERS) { ret 0; }
        var members: [16]u32;
        var i: u32 = 0;
        for (i < n) {
            val mt: u32 = spv_type_of(e, tys, t.data.struct_.fields[i]);
            if (mt == 0) { ret 0; }
            members[i] = mt;
            i = i + 1;
        }
        ret types.type_struct(e.tt, ?members[0], n, false);
    }
    ret 0;
}

fun ir_value_spv_type(e: *Emit, id: type.IrTypeId) u32 {
    ret spv_type_of(e, ?e.ir.types, id);
}

fun global_spv_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) u32 {
    ret spv_type_of(e, gt, id);
}

fun handle_spv_type(e: *Emit, tys: *type.IrTypeTable, t: *type.IrType) u32 {
    val ctor: u32 = t.data.handle_.ctor;
    val n:    u32 = t.data.handle_.count;

    if (ctor == defs.SPV_CTOR_SAMPLER) { ret types.type_sampler(e.tt); }

    if (ctor == defs.SPV_CTOR_SAMPLED_IMAGE) {
        if (n != 1) { ret 0; }
        val img: u32 = spv_type_of(e, tys, t.data.handle_.operands[0]);
        if (img == 0) { ret 0; }
        ret types.type_sampled_image(e.tt, img);
    }

    if (ctor == defs.SPV_CTOR_IMAGE) {
        if (n != defs.IMAGE_ARITY) { ret 0; }
        ret types.type_image(e.tt,
            texel_spv_type(e, t.data.handle_.operands[defs.IMAGE_OP_TEXEL]::u32),
            t.data.handle_.operands[defs.IMAGE_OP_DIM]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_DEPTH]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_ARRAYED]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_MS]::u32,
            t.data.handle_.operands[defs.IMAGE_OP_SAMPLED]::u32);
    }

    ret 0;
}

fun texel_spv_type(e: *Emit, texel: u32) u32 {
    if (texel == defs.TEXEL_I32 || texel == defs.TEXEL_U32) { ret types.type_int(e.tt, 32); }
    ret types.type_float(e.tt, 32);
}

fun ir_return_spv_type(e: *Emit, irfn: *ir.Function, out_void: *bool) u32 {
    @out_void = false;
    val sig_opt: O.Option[*type.IrType] = type.get(?e.ir.types, irfn.sig);
    if (O.is_none[*type.IrType](sig_opt)) { ret 0; }
    val sig: *type.IrType = O.unwrap[*type.IrType](sig_opt);
    if (sig.kind != type.IRT_FN) { ret 0; }
    val rt: type.IrTypeId = sig.data.fn.ret_type;
    val rt_opt: O.Option[*type.IrType] = type.get(?e.ir.types, rt);
    if (O.is_none[*type.IrType](rt_opt)) { ret 0; }
    val rtt: *type.IrType = O.unwrap[*type.IrType](rt_opt);
    if (rtt.kind == type.IRT_VOID) { @out_void = true; ret types.type_void(e.tt); }
    ret ir_value_spv_type(e, rt);
}

val FN_NONE: u32 = unit.UNIT_NONE;

val GL_NONE: u32 = unit.UNIT_NONE;

fun unsupported_value_type(e: *Emit, mi: *mir.MirInstr) str {
    if (!mir.vec_lane_is_vector(mi.vec_lane)) {
        ret "unsupported value type in the SPIR-V target";
    }
    ret "unsupported vector lane type in the SPIR-V target";
}

fun interface_target(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM || op.sym_off != 0) { ret 0; }
    ret global_var_id(e, op.sym);
}

fun addressed_memory_refusal(e: *Emit, mf: *mir.MirFunction, op: *mir.MirOperand) str {
    var gix: u32 = 0;
    val origin: u8 = address_origin(e, mf, op, ?gix);
    if (origin == ADDR_ALLOCA) {
        ret "a function-local object is reachable from the SPIR-V target only as a whole value: this access arrived as an address into its storage rather than as a load or a store of the object itself, which logical addressing has no pointer to express. it is a lowering that ran where it should not have, not something the program asked for";
    }
    if (origin != ADDR_GLOBAL) {
        ret "addressed memory is not yet supported by the SPIR-V target: this access reached the back end as a computed address with no object behind it that the emitter can name, and logical addressing has no general pointer to follow";
    }
    val g: *ir.Global = gl_ir(e, gix);
    if (g.iface == ir.IFACE_NONE) {
        ret "a plain module-scope variable is not reachable from the SPIR-V target: a shader has no general global storage, so a module-scope `val` / `var` reaches a stage only by carrying an interface role (`#[input]`, `#[output]`, `#[builtin]`, or `#[uniform]`)";
    }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "this shader interface variable carries a role, so it is reachable - but the access reached the back end as COMPUTED ADDRESSING rather than as a direct reference to the variable, which is the one shape the SPIR-V target can name. that is a lowering that ran where it should not have, not a limit of the declaration: the variable is {}",
        ir_type_spelling(gl_types(e, gix), e.alloc, g.ty));
    if (R.is_err[str, str](r)) {
        ret "this shader interface variable is reachable only as a whole-variable read or write in the SPIR-V target";
    }
    ret R.unwrap_ok[str, str](r);
}

fun is_image_type(e: *Emit, gt: *type.IrTypeTable, id: type.IrTypeId) bool {
    val opt: O.Option[*type.IrType] = type.get(gt, id);
    if (O.is_none[*type.IrType](opt)) { ret false; }
    ret O.unwrap[*type.IrType](opt).kind == type.IRT_HANDLE;
}

fun memory_load(e: *Emit, ty: u32, result: u32, ptr: u32, flags: u8) {
    var ops: [4]u32;
    ops[0] = ty; ops[1] = result; ops[2] = ptr;
    var count: u32 = 3;
    if ((flags & mir.MEMORY_VOLATILE) != 0) { ops[3] = 1; count = 4; }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ops[0], count);
}

fun memory_store(e: *Emit, ptr: u32, value: u32, flags: u8) {
    var ops: [3]u32;
    ops[0] = ptr; ops[1] = value;
    var count: u32 = 2;
    if ((flags & mir.MEMORY_VOLATILE) != 0) { ops[2] = 1; count = 3; }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?ops[0], count);
}

fun emit_global_load(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    var chain_ty: u32 = 0;
    var var_id: u32 = chain_target(vm, ?mi.operands[1], ?chain_ty);
    if (var_id == 0) { var_id = interface_target(e, ?mi.operands[1]); }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n || vm.type_id[dst] == 0) {
        ret emit_fail(e, "spirv.emit: interface load result vreg has no type");
    }
    if (types.type_is_opaque(e.tt, vm.type_id[dst])) {
        if (chain_ty != 0) {
            ret unsupported(e, "an image handle reached through a member walk is not supported by the SPIR-V target: a handle has no members, so this is an access chain into something that is not an aggregate");
        }
        if ((mi.memory_flags & mir.MEMORY_VOLATILE) == 0) {
            vm.opq_var[dst] = var_id;
            ret R.ok_void[str]();
        }
        vm.opq_var[dst] = 0;
    }
    val result: u32 = spirv.alloc_id(e.b);
    memory_load(e, vm.type_id[dst], result, var_id, mi.memory_flags);
    ret store_vreg(e, vm, dst, result);
}

fun emit_global_store(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    var chain_ty: u32 = 0;
    var var_id: u32 = chain_target(vm, ?mi.operands[0], ?chain_ty);
    var value_ty: u32 = chain_ty;
    if (var_id == 0) {
        var_id = interface_target(e, ?mi.operands[0]);
        value_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (var_id == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }
    val value: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], value_ty);
    if (e.b.err || value == 0) { ret emit_fail(e, "spirv.emit: unreadable value in an interface store"); }
    memory_store(e, var_id, value, mi.memory_flags);
    ret R.ok_void[str]();
}

fun interface_value_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.iface == ir.IFACE_NONE) { ret 0; }
    ret e.gtype_ids[gx];
}

fun interface_position_type(e: *Emit, op: *mir.MirOperand) u32 {
    if (op.kind != mir.MIR_OP_SYM) { ret 0; }
    val gx: u32 = gl_lookup(e, op.sym);
    if (gx == GL_NONE) { ret 0; }
    val g: *ir.Global = gl_ir(e, gx);
    if (g.iface == ir.IFACE_NONE) { ret 0; }
    ret global_spv_type(e, gl_types(e, gx), g.ty);
}

fun whole_value_as(e: *Emit, value: u32, from_ty: u32, to_ty: u32) u32 {
    if (value == 0 || from_ty == 0 || to_ty == 0) { ret 0; }
    if (from_ty == to_ty) { ret value; }
    if (!types.logically_match(e.tt, from_ty, to_ty)) { ret 0; }
    val res: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = to_ty; ops[1] = res; ops[2] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COPY_LOGICAL, ?ops[0], 3);
    ret res;
}

fun emit_access_chain(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs,
                      mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
    }
    var base_id: u32 = 0;
    var base_ty: u32 = 0;
    var base_sc: u32 = 0;
    var prior_ty: u32 = 0;
    val prior: u32 = chain_target(vm, ?mi.operands[1], ?prior_ty);
    if (prior != 0) {
        base_id = prior;
        base_ty = prior_ty;
        base_sc = chain_storage(vm, ?mi.operands[1]);
    }
    or {
        var gix: u32 = 0;
        if (address_origin(e, mf, ?mi.operands[1], ?gix) != ADDR_GLOBAL) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        val g: *ir.Global = gl_ir(e, gix);
        if (g.iface == ir.IFACE_NONE || e.gvar_ids[gix] == 0) {
            ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1]));
        }
        base_id = e.gvar_ids[gix];
        base_ty = e.gtype_ids[gix];
        base_sc = e.gstorage[gix];
    }

    if (mi.operands[2].kind != mir.MIR_OP_IMM || mi.operands[2].imm != 0) {
        ret unsupported(e, "pointer arithmetic across whole objects is not supported by the SPIR-V target: a logical pointer names one object, so a getelementptr's leading index may only be 0");
    }

    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: access chain result vreg out of range"); }

    val count: u32 = mi.operand_count - 3;
    if (count == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }
    if (count > 8) {
        ret unsupported(e, "an access chain of more than 8 levels is not supported by the SPIR-V target");
    }

    var idx: [8]u32;
    var cur: u32 = base_ty;
    var k: u32 = 0;
    for (k < count) {
        val opnd: *mir.MirOperand = ?mi.operands[3 + k];
        if (opnd.kind == mir.MIR_OP_IMM) {
            if (opnd.imm < 0) { ret unsupported(e, "a negative index is not supported by the SPIR-V target"); }
            cur = types.composite_member(e.tt, cur, opnd.imm::u32);
            idx[k] = types.const_int(e.tt, 32, opnd.imm);
        }
        or {
            val elem: u32 = types.composite_member(e.tt, cur, 0);
            var lanes: u32 = 0;
            if (elem == 0 || types.vector_shape(e.tt, cur, ?lanes) != 0) {
                ret unsupported(e, "a runtime index into a record or vector is not supported by the SPIR-V target: SPIR-V takes a struct member and a vector lane by a constant ordinal, since the type reached depends on which one it is");
            }
            idx[k] = read_operand(e, vm, preg_val, opnd, types.type_int(e.tt, 32));
            cur = elem;
        }
        if (cur == 0 || idx[k] == 0) {
            ret unsupported(e, "an index reaches past the end of its aggregate in the SPIR-V target");
        }
        k = k + 1;
    }
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable index in an access chain"); }

    val ptr_ty: u32 = types.type_ptr(e.tt, base_sc, cur);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [11]u32;
    ops[0] = ptr_ty; ops[1] = result; ops[2] = base_id;
    k = 0;
    for (k < count) { ops[3 + k] = idx[k]; k = k + 1; }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_ACCESS_CHAIN, ?ops[0], count + 3);

    vm.chain_id[dst] = result;
    vm.chain_ty[dst] = cur;
    vm.chain_sc[dst] = base_sc;
    ret R.ok_void[str]();
}

fun chain_target(vm: *VMaps, op: *mir.MirOperand, out_ty: *u32) u32 {
    @out_ty = 0;
    var v: u32 = mir.MIR_VREG_NIL;
    if (op.kind == mir.MIR_OP_VREG) { v = op.vreg; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg; }
    if (v == mir.MIR_VREG_NIL || v >= vm.n) { ret 0; }
    @out_ty = vm.chain_ty[v];
    ret vm.chain_id[v];
}

fun chain_storage(vm: *VMaps, op: *mir.MirOperand) u32 {
    var v: u32 = mir.MIR_VREG_NIL;
    if (op.kind == mir.MIR_OP_VREG) { v = op.vreg; }
    or (op.kind == mir.MIR_OP_MEM && op.imm == 0) { v = op.vreg; }
    if (v == mir.MIR_VREG_NIL || v >= vm.n) { ret 0; }
    ret vm.chain_sc[v];
}

fun emit_memzero(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 1) { ret emit_fail(e, "spirv.emit: memzero with no destination"); }
    var target_ty: u32 = 0;
    var target: u32 = chain_target(vm, ?mi.operands[0], ?target_ty);
    if (target == 0) {
        target = interface_target(e, ?mi.operands[0]);
        target_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (target == 0 || target_ty == 0) {
        ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0]));
    }
    memory_store(e, target, types.const_null(e.tt, target_ty), mi.memory_flags);
    ret R.ok_void[str]();
}

fun emit_memcpy(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret emit_fail(e, "spirv.emit: memcpy with no source or destination"); }

    var dst_ty: u32 = 0;
    var dst: u32 = chain_target(vm, ?mi.operands[0], ?dst_ty);
    if (dst == 0) {
        dst = interface_target(e, ?mi.operands[0]);
        dst_ty = interface_value_type(e, ?mi.operands[0]);
    }
    if (dst == 0 || dst_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }

    var src_ty: u32 = 0;
    var src: u32 = chain_target(vm, ?mi.operands[1], ?src_ty);
    if (src == 0) {
        src = interface_target(e, ?mi.operands[1]);
        src_ty = interface_value_type(e, ?mi.operands[1]);
    }
    if (src == 0 || src_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }

    val value: u32 = spirv.alloc_id(e.b);
    memory_load(e, src_ty, value, src, mi.memory_flags);

    val stored: u32 = whole_value_as(e, value, src_ty, dst_ty);
    if (stored == 0) {
        ret unsupported(e, "copying between two objects of different types is not supported by the SPIR-V target: logical addressing carries an object as a value of its own type, so a copy that reinterprets one type as another has no pointer to perform it through");
    }

    memory_store(e, dst, stored, mi.memory_flags);
    ret R.ok_void[str]();
}

fun emit_agg_load(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_PREG) {
        ret emit_fail(e, "spirv.emit: malformed whole-object load");
    }
    val pos: u32 = mi.operands[0].preg;
    if (pos >= 16) { ret emit_fail(e, "spirv.emit: whole-object load into a position out of range"); }

    var src_ty: u32 = 0;
    var pos_ty: u32 = 0;
    var src: u32 = chain_target(vm, ?mi.operands[1], ?src_ty);
    pos_ty = src_ty;
    if (src == 0) {
        src = interface_target(e, ?mi.operands[1]);
        src_ty = interface_value_type(e, ?mi.operands[1]);
        pos_ty = interface_position_type(e, ?mi.operands[1]);
    }
    if (src == 0 || src_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[1])); }

    val loaded: u32 = spirv.alloc_id(e.b);
    memory_load(e, src_ty, loaded, src, mi.memory_flags);

    val value: u32 = whole_value_as(e, loaded, src_ty, pos_ty);
    if (value == 0) {
        ret unsupported(e, "this object cannot be handed to a call or a return by value in the SPIR-V target: the type it is stored at and the type its position takes describe different objects, so no whole value crosses between them");
    }

    preg_val.val_id[pos]  = value;
    preg_val.is_imm[pos]  = false;
    preg_val.is_bool[pos] = false;
    ret R.ok_void[str]();
}

fun emit_agg_store(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2 || mi.operands[1].kind != mir.MIR_OP_PREG) {
        ret emit_fail(e, "spirv.emit: malformed whole-object store");
    }

    var dst_ty: u32 = 0;
    var pos_ty: u32 = 0;
    var dst: u32 = chain_target(vm, ?mi.operands[0], ?dst_ty);
    pos_ty = dst_ty;
    if (dst == 0) {
        dst = interface_target(e, ?mi.operands[0]);
        dst_ty = interface_value_type(e, ?mi.operands[0]);
        pos_ty = interface_position_type(e, ?mi.operands[0]);
    }
    if (dst == 0 || dst_ty == 0) { ret unsupported(e, addressed_memory_refusal(e, mf, ?mi.operands[0])); }

    val held: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], pos_ty);
    if (e.b.err || held == 0) { ret emit_fail(e, "spirv.emit: whole-object store with no value in its position"); }

    val value: u32 = whole_value_as(e, held, pos_ty, dst_ty);
    if (value == 0) {
        ret unsupported(e, "this object cannot be written from a call or a return position in the SPIR-V target: the type its position takes and the type it is stored at describe different objects, so no whole value crosses between them");
    }

    memory_store(e, dst, value, mi.memory_flags);
    ret R.ok_void[str]();
}

fun by_class(lane_float: bool, int_op: u32, float_op: u32) u32 {
    if (lane_float) { ret float_op; }
    ret int_op;
}

fun unsupported(e: *Emit, msg: str) R.Result[R.Void, str] {
    ret emit_fail(e, msg);
}

fun emit_fail(e: *Emit, msg: str) R.Result[R.Void, str] {
    ret R.err[R.Void, str](mir.instr_refusal(e.alloc, e.srcmap, refusal_fn_name(e),
                                           e.cur_instr, msg));
}

fun refusal_fn_name(e: *Emit) str {
    if (e.cur_fn == nil) { ret "<unknown function>"; }
    val fx: u32 = fn_lookup(e, e.cur_fn.name);
    if (fx != FN_NONE) { ret ir_fn_spelling(e, fx); }
    val m: O.Option[str] = intern.lookup(e.interner, e.cur_fn.name);
    if (O.is_some[str](m)) { ret O.unwrap[str](m); }
    ret "<unresolved function name>";
}

fun emit_instr(e: *Emit, mf: *mir.MirFunction, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    e.cur_instr = mi;
    val op: mir.MirOpcode = mi.opcode;

    val lf: bool = mir.vec_lane_is_vector(mi.vec_lane)
                && mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT;

    if (op == mir.MIR_ADD)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_ADD, spirv.OP_F_ADD)); }
    if (op == mir.MIR_SUB)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_SUB, spirv.OP_F_SUB)); }
    if (op == mir.MIR_MUL)   { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_MUL, spirv.OP_F_MUL)); }
    if (op == mir.MIR_DIV_S) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_DIV, spirv.OP_F_DIV)); }
    if (op == mir.MIR_DIV_U) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_DIV, spirv.OP_F_DIV)); }
    if (op == mir.MIR_REM_S) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_REM, spirv.OP_F_REM)); }
    if (op == mir.MIR_REM_U) { ret emit_binary(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_MOD, spirv.OP_F_REM)); }
    if (op == mir.MIR_AND)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_AND); }
    if (op == mir.MIR_OR)    { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_OR); }
    if (op == mir.MIR_XOR)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_BITWISE_XOR); }
    if (op == mir.MIR_SHL)   { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_LEFT_LOGICAL); }
    if (op == mir.MIR_SHR_U) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_RIGHT_LOGICAL); }
    if (op == mir.MIR_SHR_S) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_SHIFT_RIGHT_ARITHMETIC); }

    if (op == mir.MIR_FADD) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_ADD); }
    if (op == mir.MIR_FSUB) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_SUB); }
    if (op == mir.MIR_FMUL) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_MUL); }
    if (op == mir.MIR_FDIV) { ret emit_binary(e, vm, preg_val, mi, spirv.OP_F_DIV); }

    if (op == mir.MIR_NEG)  { ret emit_unary(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_NEGATE, spirv.OP_F_NEGATE)); }
    if (op == mir.MIR_NOT)  { ret emit_unary(e, vm, preg_val, mi, spirv.OP_NOT); }
    if (op == mir.MIR_FNEG) { ret emit_unary(e, vm, preg_val, mi, spirv.OP_F_NEGATE); }

    if (op == mir.MIR_CMP_EQ)   { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_EQUAL, spirv.OP_F_ORD_EQUAL)); }
    if (op == mir.MIR_CMP_NE)   { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_I_NOT_EQUAL, spirv.OP_F_UNORD_NOT_EQUAL)); }
    if (op == mir.MIR_CMP_LT_S) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_LESS_THAN, spirv.OP_F_ORD_LESS_THAN)); }
    if (op == mir.MIR_CMP_LT_U) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_LESS_THAN, spirv.OP_F_ORD_LESS_THAN)); }
    if (op == mir.MIR_CMP_LE_S) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_S_LESS_THAN_EQUAL, spirv.OP_F_ORD_LESS_THAN_EQUAL)); }
    if (op == mir.MIR_CMP_LE_U) { ret emit_compare(e, vm, preg_val, mi, by_class(lf, spirv.OP_U_LESS_THAN_EQUAL, spirv.OP_F_ORD_LESS_THAN_EQUAL)); }

    if (op == mir.MIR_FCMP) { ret emit_float_compare(e, vm, preg_val, mi); }

    if (op == mir.MIR_VEC_EXTRACT) { ret emit_vec_extract(e, vm, preg_val, mi); }
    if (op == mir.MIR_VEC_INSERT)  { ret emit_vec_insert(e, vm, preg_val, mi); }
    if (op == mir.MIR_VEC_BUILD)   { ret emit_vec_build(e, vm, preg_val, mi); }

    if (op == mir.MIR_TRUNC) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_U_CONVERT, false); }
    if (op == mir.MIR_ZEXT)  { ret emit_convert(e, vm, preg_val, mi, spirv.OP_U_CONVERT, false); }
    if (op == mir.MIR_SEXT)  { ret emit_convert(e, vm, preg_val, mi, spirv.OP_S_CONVERT, false); }

    if (op == mir.MIR_FP_TRUNC) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_F_CONVERT, true); }
    if (op == mir.MIR_FP_EXT)   { ret emit_convert(e, vm, preg_val, mi, spirv.OP_F_CONVERT, true); }
    if (op == mir.MIR_FP_TO_SI) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_F_TO_S, true); }
    if (op == mir.MIR_FP_TO_UI) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_F_TO_U, true); }
    if (op == mir.MIR_SI_TO_FP) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_S_TO_F, false); }
    if (op == mir.MIR_UI_TO_FP) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_CONVERT_U_TO_F, false); }

    if (op == mir.MIR_BITCAST) { ret emit_convert(e, vm, preg_val, mi, spirv.OP_BITCAST, false); }

    if (op == mir.MIR_MOV) { ret emit_mov(e, vm, preg_val, mi); }
    if (op == mir.MIR_DECLASSIFY) { ret emit_mov(e, vm, preg_val, mi); }

    if (op == mir.MIR_CALL) { ret emit_call(e, preg_val, mi); }
    if (op == mir.MIR_CALL_RES) { ret R.ok_void[str](); }

    if (op == mir.MIR_LOAD)  { ret emit_global_load(e, mf, vm, preg_val, mi); }
    if (op == mir.MIR_STORE) { ret emit_global_store(e, mf, vm, preg_val, mi); }
    if (op == mir.MIR_GEP) { ret emit_access_chain(e, mf, vm, preg_val, mi); }
    if (op == mir.MIR_ALLOCA) { ret R.ok_void[str](); }
    if (op == mir.MIR_MEMZERO) { ret emit_memzero(e, mf, vm, mi); }
    if (op == mir.MIR_MEMCPY) { ret emit_memcpy(e, mf, vm, mi); }
    if (op == mir.MIR_AGG_LOAD)  { ret emit_agg_load(e, mf, vm, preg_val, mi); }
    if (op == mir.MIR_AGG_STORE) { ret emit_agg_store(e, mf, vm, preg_val, mi); }

    ret unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

fun emit_call(e: *Emit, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 1) { ret emit_fail(e, "spirv.emit: call with no callee operand"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret unsupported(e, "a call through a function pointer is not yet supported by the SPIR-V target");
    }

    val xfn: *ir.Function = ir_function_record(e.ir, callee.sym);
    if (xfn != nil && xfn.op_set != defs.SPV_SET_NONE) {
        ret emit_spirv_op(e, preg_val, xfn);
    }
    if (xfn != nil && xfn.is_import) {
        ret unsupported(e, foreign_call_refusal(e, xfn));
    }

    val fx: u32 = fn_lookup(e, callee.sym);
    if (fx == FN_NONE || e.fns[fx].id == 0) {
        ret unsupported(e, unresolved_call_refusal(e, callee.sym, fx));
    }

    val saved_ir: *ir.Module = e.ir;
    val saved_mi: u32 = e.cur_mi;
    e.ir = fn_mod(e, fx);
    e.cur_mi = e.fns[fx].mi;
    val irfn: *ir.Function = fn_ir(e, fx);

    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        e.ir = saved_ir; e.cur_mi = saved_mi;
        ret unsupported(e, "unsupported return type in the SPIR-V target");
    }
    if (irfn.param_count > types.MAX_FN_PARAMS) {
        e.ir = saved_ir; e.cur_mi = saved_mi;
        ret unsupported(e, "more than 16 parameters is not supported by the SPIR-V target");
    }

    var argty: [16]u32;
    var i: u32 = 0;
    for (i < irfn.param_count) {
        argty[i] = ir_value_spv_type(e, irfn.params[i].ty);
        i = i + 1;
    }
    val param_count: u32 = irfn.param_count;
    e.ir = saved_ir;
    e.cur_mi = saved_mi;

    val total: u32 = 3 + param_count;
    var ops: [19]u32;
    ops[0] = ret_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    ops[2] = e.fns[fx].id;
    i = 0;
    for (i < param_count) {
        val aid: u32 = reg_value(e, preg_val, i, argty[i]);
        if (aid == 0) { ret emit_fail(e, "spirv.emit: call argument with no pre-colored value"); }
        ops[3 + i] = aid;
        i = i + 1;
    }
    spirv.inst(e.b, ?e.b.functions, spirv.OP_FUNCTION_CALL, ?ops[0], total);
    if (!returns_void) {
        preg_val.val_id[0]  = result;
        preg_val.is_imm[0]  = false;
        preg_val.is_bool[0] = types.type_is_bool(e.tt, ret_ty);
    }
    ret R.ok_void[str]();
}

fun foreign_call_refusal(e: *Emit, fn: *ir.Function) str {
    val nm: O.Option[str] = intern.lookup(e.interner, fn.name);
    var who: str = "this function";
    if (O.is_some[str](nm)) { who = O.unwrap[str](nm); }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "`{}` is declared `ext`, and a SPIR-V module cannot call a foreign import: the module a shader compiles to is self-contained, so there is no symbol to bind at load time. give the operation a `#[spirv_op(set, name)]` mapping so the call becomes that instruction, or write it in mach so its body can be emitted here",
        who);
    if (R.is_err[str, str](r)) {
        ret "a SPIR-V module cannot call a foreign `ext` import: the module is self-contained and has no symbol to bind at load time";
    }
    ret R.unwrap_ok[str, str](r);
}

fun unresolved_call_refusal(e: *Emit, name: intern.StrId, fx: u32) str {
    val nm: O.Option[str] = intern.lookup(e.interner, name);
    var who: str = "this function";
    if (O.is_some[str](nm)) { who = O.unwrap[str](nm); }
    if (fx != FN_NONE) {
        var where: str = "the module it belongs to";
        val mo: O.Option[str] = intern.lookup(e.interner, fn_mod(e, fx).name);
        if (O.is_some[str](mo)) { where = O.unwrap[str](mo); }
        val r2: R.Result[str, str] = format.sprint(e.alloc,
            "`{}` is declared in `{}` but has no body the SPIR-V target can emit, so there is nothing to call: a self-contained module cannot leave the call for a linker to resolve",
            who, where);
        if (R.is_ok[str, str](r2)) { ret R.unwrap_ok[str, str](r2); }
        ret "the SPIR-V target has no body to emit for this callee, and a self-contained module cannot leave the call for a linker to resolve";
    }
    val r: R.Result[str, str] = format.sprint(e.alloc,
        "no module in this build defines `{}`, so the SPIR-V target has no body to emit for it: a self-contained module cannot leave the call for a linker to resolve",
        who);
    if (R.is_err[str, str](r)) {
        ret "no module in this build defines this callee, so the SPIR-V target has no body to emit for it";
    }
    ret R.unwrap_ok[str, str](r);
}

fun emit_spirv_op(e: *Emit, preg_val: *Regs, fn: *ir.Function) R.Result[R.Void, str] {
    val sig_opt: O.Option[*type.IrType] = type.get(?e.ir.types, fn.sig);
    if (O.is_none[*type.IrType](sig_opt)) {
        ret emit_fail(e, "spirv.emit: a `spirv_op` callee has no signature type");
    }
    val sig: *type.IrType = O.unwrap[*type.IrType](sig_opt);
    if (sig.kind != type.IRT_FN) {
        ret emit_fail(e, "spirv.emit: a `spirv_op` callee's signature is not a function type");
    }
    val argc: u32 = sig.data.fn.param_count;
    if (argc > 12) {
        ret unsupported(e, "a `spirv_op` function takes at most 12 parameters on the SPIR-V target");
    }

    var returns_void: bool = false;
    val ret_ty: u32 = ir_return_spv_type(e, fn, ?returns_void);
    if (ret_ty == 0) { ret unsupported(e, "unsupported return type in the SPIR-V target"); }
    if (returns_void) {
        ret unsupported(e, "a `spirv_op` function must return a value; a SPIR-V instruction has a result id");
    }

    var ops: [16]u32;
    var base: u32 = 2;
    ops[0] = ret_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    if (fn.op_set != defs.SPV_SET_CORE) {
        val set_id: u32 = ext_set_id(e, fn.op_set);
        if (set_id == 0) {
            ret emit_fail(e, "spirv.emit: a `spirv_op` names an instruction set with no import name");
        }
        ops[2] = set_id;
        ops[3] = fn.op_code;
        base = 4;
    }

    var i: u32 = 0;
    for (i < argc) {
        val aid: u32 = reg_value(e, preg_val, i, ir_value_spv_type(e, sig.data.fn.params[i]));
        if (aid == 0) { ret emit_fail(e, "spirv.emit: `spirv_op` argument with no pre-colored value"); }
        ops[base + i] = aid;
        i = i + 1;
    }

    var opcode: u32 = spirv.OP_EXT_INST;
    if (fn.op_set == defs.SPV_SET_CORE) { opcode = fn.op_code; }
    spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], base + argc);

    preg_val.val_id[0]  = result;
    preg_val.is_imm[0]  = false;
    preg_val.is_bool[0] = types.type_is_bool(e.tt, ret_ty);
    ret R.ok_void[str]();
}

fun ext_set_id(e: *Emit, set: u32) u32 {
    if (set >= 8) { ret 0; }
    if (e.ext_ids[set] != 0) { ret e.ext_ids[set]; }
    val name: str = defs.set_import_name(set::u8);
    if (str_len(name) == 0::usize) { ret 0; }
    val id: u32 = spirv.ext_inst_import(e.b, name);
    e.ext_ids[set::u32] = id;
    ret id;
}

fun ir_function_record(irmod: *ir.Module, name: intern.StrId) *ir.Function {
    var i: u32 = 0;
    for (i < irmod.function_len) {
        if (irmod.functions[i].name == name) { ret ?irmod.functions[i]; }
        i = i + 1;
    }
    ret nil;
}

fun read_operand(e: *Emit, vm: *VMaps, preg_val: *Regs, op: *mir.MirOperand, want_ty: u32) u32 {
    if (op.kind == mir.MIR_OP_VREG) {
        val v: u32 = op.vreg;
        if (v < vm.n && vm.opq_var[v] != 0) {
            val fresh: u32 = spirv.alloc_id(e.b);
            var ol: [3]u32;
            ol[0] = vm.type_id[v]; ol[1] = fresh; ol[2] = vm.opq_var[v];
            spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?ol[0], 3);
            ret fresh;
        }
        if (v < vm.n && vm.opq_ssa[v] != 0) { ret vm.opq_ssa[v]; }
        if (v >= vm.n || vm.var_id[v] == 0) { e.b.err = true; ret 0; }
        val result: u32 = spirv.alloc_id(e.b);
        var lo: [3]u32;
        lo[0] = vm.type_id[v]; lo[1] = result; lo[2] = vm.var_id[v];
        spirv.inst(e.b, ?e.b.functions, spirv.OP_LOAD, ?lo[0], 3);
        if (vm.is_bool[v] && want_ty != 0 && !types.type_is_bool(e.tt, want_ty)) {
            ret widen_bool(e, result, want_ty);
        }
        ret result;
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret immediate(e, want_ty, op.imm);
    }
    if (op.kind == mir.MIR_OP_PREG) {
        if (op.preg >= 16) { e.b.err = true; ret 0; }
        ret reg_value(e, preg_val, op.preg, want_ty);
    }
    e.b.err = true;
    ret 0;
}

fun operand_carries_type(vm: *VMaps, op: *mir.MirOperand) bool {
    if (op.kind != mir.MIR_OP_VREG) { ret false; }
    if (op.vreg >= vm.n || vm.type_id[op.vreg] == 0) { ret false; }
    ret !vm.is_bool[op.vreg];
}

fun operand_matches_type(vm: *VMaps, op: *mir.MirOperand, want_ty: u32) bool {
    if (!operand_carries_type(vm, op)) { ret true; }
    ret vm.type_id[op.vreg] == want_ty;
}

fun widen_bool(e: *Emit, boolean: u32, want_ty: u32) u32 {
    val one:  u32 = types.const_scalar(e.tt, want_ty, 1, 0);
    val zero: u32 = types.const_scalar(e.tt, want_ty, 0, 0);
    if (one == 0 || zero == 0) { e.b.err = true; ret 0; }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = want_ty; ops[1] = result; ops[2] = boolean; ops[3] = one; ops[4] = zero;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?ops[0], 5);
    ret result;
}

fun immediate(e: *Emit, want_ty: u32, imm: i64) u32 {
    var ty: u32 = want_ty;
    if (ty == 0) { ty = types.type_int(e.tt, e.tgt.model.gpr_width * 8); }
    if (types.type_is_bool(e.tt, ty)) { ret types.const_bool(e.tt, imm != 0); }
    val pattern: u64 = imm::u64;
    ret types.const_scalar(e.tt, ty, (pattern & 0xFFFFFFFF)::u32, ((pattern >> 32) & 0xFFFFFFFF)::u32);
}

fun store_vreg(e: *Emit, vm: *VMaps, vreg: u32, value: u32) R.Result[R.Void, str] {
    if (vreg < vm.n && vm.type_id[vreg] != 0 && types.type_is_opaque(e.tt, vm.type_id[vreg])) {
        vm.opq_ssa[vreg] = value;
        ret R.ok_void[str]();
    }
    if (vreg >= vm.n || vm.var_id[vreg] == 0) {
        ret emit_fail(e, "spirv.emit: store to an undeclared vreg");
    }
    var so: [2]u32;
    so[0] = vm.var_id[vreg]; so[1] = value;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_STORE, ?so[0], 2);
    ret R.ok_void[str]();
}

fun emit_binary(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[R.Void, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed binary instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: binary result vreg out of range"); }
    val ty: u32 = vm.type_id[dst];
    if (!operand_matches_type(vm, ?mi.operands[1], ty)
     || !operand_matches_type(vm, ?mi.operands[2], ty)) {
        ret emit_fail(e, "spirv.emit: binary instruction mixes operand types");
    }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in binary instruction"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a; ops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

fun emit_unary(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[R.Void, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed unary instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: unary result vreg out of range"); }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vm.type_id[dst]);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in unary instruction"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

fun emit_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[R.Void, str] {
    if (mir.vec_lane_is_vector(mi.vec_lane)) {
        ret emit_vector_compare(e, vm, preg_val, mi, op_code);
    }
    var cbits: u32 = mi.width::u32 * 8;
    if (cbits == 0) { cbits = e.tgt.model.gpr_width * 8; }
    val cmp_ty: u32 = types.type_int(e.tt, cbits);
    if (cmp_ty == 0) {
        ret unsupported(e, "unsupported comparison width in the SPIR-V target");
    }
    ret emit_compare_typed(e, vm, preg_val, mi, op_code, cmp_ty);
}

fun emit_vector_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr, op_code: u32) R.Result[R.Void, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: comparison result vreg out of range"); }

    val lanes: u32 = mir.vec_lane_count(mi.vec_lane);
    val operand_ty: u32 = vector_type_of(e, mi.vec_lane, false);
    val bvec_ty: u32 = types.type_vector(e.tt, types.type_bool(e.tt), lanes);
    val mask_ty: u32 = vm.type_id[dst];
    if (operand_ty == 0 || bvec_ty == 0 || mask_ty == 0) {
        ret unsupported(e, unsupported_value_type(e, mi));
    }

    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector comparison"); }

    val bvec: u32 = spirv.alloc_id(e.b);
    var cops: [4]u32;
    cops[0] = bvec_ty; cops[1] = bvec; cops[2] = a; cops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?cops[0], 4);

    val ones: u32 = mask_splat(e, mask_ty, lanes, 0xFFFFFFFF, 0xFFFFFFFF);
    val zeros: u32 = mask_splat(e, mask_ty, lanes, 0, 0);
    if (ones == 0 || zeros == 0) {
        ret emit_fail(e, "spirv.emit: could not build a vector comparison mask constant");
    }

    val result: u32 = spirv.alloc_id(e.b);
    var sops: [5]u32;
    sops[0] = mask_ty; sops[1] = result; sops[2] = bvec; sops[3] = ones; sops[4] = zeros;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_SELECT, ?sops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun mask_splat(e: *Emit, vec_ty: u32, lanes: u32, lo: u32, hi: u32) u32 {
    var count: u32 = 0;
    val lane_ty: u32 = types.vector_shape(e.tt, vec_ty, ?count);
    if (lane_ty == 0 || count == 0 || count > types.MAX_VECTOR_COMPONENTS) { ret 0; }
    val lane: u32 = types.const_scalar(e.tt, lane_ty, lo, hi);
    var parts: [4]u32;
    var i: u32 = 0;
    for (i < count) { parts[i] = lane; i = i + 1; }
    ret types.const_composite(e.tt, vec_ty, ?parts[0], count);
}

fun emit_vec_extract(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector extract instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector extract result vreg out of range"); }
    val vec_ty: u32 = operand_vector_type(e, vm, mi, ?mi.operands[1]);
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    val src: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vec_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector extract"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = src; ops[3] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_EXTRACT, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

fun emit_vec_insert(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 4 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector insert instruction");
    }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret unsupported(e, "a runtime vector lane index is not supported by the SPIR-V target");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector insert result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes: u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val src: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], vec_ty);
    val lane: u32 = read_operand(e, vm, preg_val, ?mi.operands[3], lane_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in vector insert"); }

    val result: u32 = spirv.alloc_id(e.b);
    var ops: [5]u32;
    ops[0] = vec_ty; ops[1] = result; ops[2] = lane; ops[3] = src; ops[4] = mi.operands[2].imm::u32;
    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_INSERT, ?ops[0], 5);
    ret store_vreg(e, vm, dst, result);
}

fun emit_vec_build(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed vector build instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: vector build result vreg out of range"); }
    val vec_ty: u32 = vm.type_id[dst];
    if (vec_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }
    var lanes: u32 = 0;
    val lane_ty: u32 = types.vector_value_shape(e.tt, vec_ty, ?lanes);
    if (lane_ty == 0) { ret unsupported(e, unsupported_value_type(e, mi)); }

    val given: u32 = mi.operand_count - 1;
    if (given != lanes) {
        ret emit_fail(e, "spirv.emit: vector build lane count does not match its vector type");
    }
    val ro: R.Result[*u32, str] = A.allocate[u32](e.alloc, (given + 2)::usize);
    if (R.is_err[*u32, str](ro)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](ro)); }
    val ops: *u32 = R.unwrap_ok[*u32, str](ro);
    ops[0] = vec_ty;
    val result: u32 = spirv.alloc_id(e.b);
    ops[1] = result;
    var i: u32 = 0;
    for (i < given) {
        ops[2 + i] = read_operand(e, vm, preg_val, ?mi.operands[1 + i], lane_ty);
        i = i + 1;
    }
    if (e.b.err) {
        A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
        ret emit_fail(e, "spirv.emit: unreadable operand in vector build");
    }

    spirv.inst(e.b, ?e.b.functions, spirv.OP_COMPOSITE_CONSTRUCT, ops, 2 + given);
    A.deallocate[u32](e.alloc, ops, (given + 2)::usize);
    ret store_vreg(e, vm, dst, result);
}

fun operand_vector_type(e: *Emit, vm: *VMaps, mi: *mir.MirInstr, op: *mir.MirOperand) u32 {
    if (op.kind == mir.MIR_OP_VREG && op.vreg < vm.n && vm.type_id[op.vreg] != 0) {
        ret vm.type_id[op.vreg];
    }
    if (!mir.vec_lane_is_vector(mi.vec_lane)) { ret 0; }
    ret vector_type_of(e, mi.vec_lane, false);
}

fun emit_float_compare(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    var fbits: u32 = mi.width::u32 * 8;
    if (fbits != 32 && fbits != 64) {
        ret unsupported(e, "unsupported float comparison width in the SPIR-V target");
    }
    val cc: u8 = mi.src_width;
    var op_code: u32 = spirv.OP_F_ORD_GREATER_THAN_EQUAL;
    if (cc == mir.FCC_EQ)      { op_code = spirv.OP_F_ORD_EQUAL; }
    or (cc == mir.FCC_NE)      { op_code = spirv.OP_F_UNORD_NOT_EQUAL; }
    or (cc == mir.FCC_LT)      { op_code = spirv.OP_F_ORD_LESS_THAN; }
    or (cc == mir.FCC_LE)      { op_code = spirv.OP_F_ORD_LESS_THAN_EQUAL; }
    or (cc == mir.FCC_GT)      { op_code = spirv.OP_F_ORD_GREATER_THAN; }
    or (cc != mir.FCC_GE)      { ret unsupported(e, "unknown float comparison condition in the SPIR-V target"); }
    ret emit_compare_typed(e, vm, preg_val, mi, op_code, types.type_float(e.tt, fbits));
}

fun emit_compare_typed(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr,
                       op_code: u32, operand_ty: u32) R.Result[R.Void, str] {
    if (mi.operand_count != 3 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed comparison instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: comparison result vreg out of range"); }
    if (!operand_matches_type(vm, ?mi.operands[1], operand_ty)
     || !operand_matches_type(vm, ?mi.operands[2], operand_ty)) {
        ret emit_fail(e, "spirv.emit: comparison mixes operand types");
    }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], operand_ty);
    val b: u32 = read_operand(e, vm, preg_val, ?mi.operands[2], operand_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in comparison"); }
    val bool_ty: u32 = types.type_bool(e.tt);
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [4]u32;
    ops[0] = bool_ty; ops[1] = result; ops[2] = a; ops[3] = b;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 4);
    ret store_vreg(e, vm, dst, result);
}

fun emit_convert(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr,
                 op_code: u32, src_is_float: bool) R.Result[R.Void, str] {
    if (mi.operand_count != 2 || mi.operands[0].kind != mir.MIR_OP_VREG) {
        ret emit_fail(e, "spirv.emit: malformed conversion instruction");
    }
    val dst: u32 = mi.operands[0].vreg;
    if (dst >= vm.n) { ret emit_fail(e, "spirv.emit: conversion result vreg out of range"); }
    var src_ty: u32 = 0;
    if (!operand_carries_type(vm, ?mi.operands[1])) {
        var sbits: u32 = mi.src_width::u32 * 8;
        if (sbits == 0) { sbits = e.tgt.model.gpr_width * 8; }
        if (src_is_float) { src_ty = types.type_float(e.tt, sbits); }
        or { src_ty = types.type_int(e.tt, sbits); }
        if (src_ty == 0) {
            ret unsupported(e, "unsupported conversion source width in the SPIR-V target");
        }
    }
    val a: u32 = read_operand(e, vm, preg_val, ?mi.operands[1], src_ty);
    if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable operand in conversion"); }
    val result: u32 = spirv.alloc_id(e.b);
    var ops: [3]u32;
    ops[0] = vm.type_id[dst]; ops[1] = result; ops[2] = a;
    spirv.inst(e.b, ?e.b.functions, op_code, ?ops[0], 3);
    ret store_vreg(e, vm, dst, result);
}

fun emit_mov(e: *Emit, vm: *VMaps, preg_val: *Regs, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2) { ret emit_fail(e, "spirv.emit: malformed move instruction"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_VREG) {
        if (dst.vreg >= vm.n) { ret emit_fail(e, "spirv.emit: move destination vreg out of range"); }
        val val_id: u32 = read_operand(e, vm, preg_val, src, vm.type_id[dst.vreg]);
        if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable move source"); }
        ret store_vreg(e, vm, dst.vreg, val_id);
    }
    if (dst.kind == mir.MIR_OP_PREG) {
        if (dst.preg >= 16) { ret emit_fail(e, "spirv.emit: move destination register out of range"); }
        if (src.kind == mir.MIR_OP_IMM) {
            preg_val.val_id[dst.preg]  = 0;
            preg_val.imm[dst.preg]     = src.imm;
            preg_val.is_imm[dst.preg]  = true;
            preg_val.is_bool[dst.preg] = false;
            ret R.ok_void[str]();
        }
        val boolean: bool = operand_is_bool(vm, preg_val, src);
        val val_id: u32 = read_operand(e, vm, preg_val, src, 0);
        if (e.b.err) { ret emit_fail(e, "spirv.emit: unreadable move source"); }
        preg_val.val_id[dst.preg]  = val_id;
        preg_val.is_imm[dst.preg]  = false;
        preg_val.is_bool[dst.preg] = boolean;
        ret R.ok_void[str]();
    }
    ret unsupported(e, "memory-destination move is not yet supported by the SPIR-V target");
}

fun reg_value(e: *Emit, rg: *Regs, k: u32, want_ty: u32) u32 {
    if (rg.is_imm[k]) { ret immediate(e, want_ty, rg.imm[k]); }
    if (rg.is_bool[k] && rg.val_id[k] != 0 && want_ty != 0 && !types.type_is_bool(e.tt, want_ty)) {
        ret widen_bool(e, rg.val_id[k], want_ty);
    }
    ret rg.val_id[k];
}

fun operand_is_bool(vm: *VMaps, rg: *Regs, op: *mir.MirOperand) bool {
    if (op.kind == mir.MIR_OP_VREG) { ret op.vreg < vm.n && vm.is_bool[op.vreg]; }
    if (op.kind == mir.MIR_OP_PREG) { ret op.preg < 16 && rg.is_bool[op.preg]; }
    ret false;
}

test "mach.lang.target.isa.spirv.emit:builtin_type_table" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var tt: type.IrTypeTable;
    if (O.is_some[str](type.init(?tt, ?alloc))) { ret 1; }

    val f32t: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 32));
    val i32t: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 32));
    val f64t: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 64));
    val v4f: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 4));
    val v3f: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 3));
    val v3i: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 3));
    val v4i: type.IrTypeId   = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 4));

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4f) != nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, v4f) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v3f) == nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POSITION, v4i) == nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_FRAG_COORD, f32t) == nil) { type.dnit(?tt); ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f32t) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, f64t) == nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_POINT_SIZE, v4f) == nil)  { type.dnit(?tt); ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, i32t) != nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, i32t) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_VERTEX_INDEX, f32t) == nil)   { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_INSTANCE_INDEX, v3i) == nil)  { type.dnit(?tt); ret 1; }

    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v3i) != nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3i) != nil)  { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, v3i) != nil)      { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_GLOBAL_INVOCATION, v4i) == nil) { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_LOCAL_INVOCATION, v3f) == nil)  { type.dnit(?tt); ret 1; }
    if (builtin_type_refusal(?tt, ?alloc, ir.BUILTIN_WORKGROUP_ID, i32t) == nil)     { type.dnit(?tt); ret 1; }

    type.dnit(?tt);
    ret 0;
}

test "mach.lang.target.isa.spirv.emit:ir_type_spelling" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var tt: type.IrTypeTable;
    if (O.is_some[str](type.init(?tt, ?alloc))) { ret 1; }

    val f32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 32));
    val i32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 32));
    val v3f: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 3));
    val v3i: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 3));
    val arr: type.IrTypeId  = R.unwrap_ok[type.IrTypeId, str](type.intern_array(?tt, f32t, 4));

    if (!str_equals(ir_type_spelling(?tt, ?alloc, f32t), "`f32`"))    { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3f), "`f32x3`"))   { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, i32t), "`i32` / `u32`"))       { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, v3i), "`i32x3` / `u32x3`"))    { type.dnit(?tt); ret 1; }
    if (!str_equals(ir_type_spelling(?tt, ?alloc, arr), "an array"))  { type.dnit(?tt); ret 1; }

    type.dnit(?tt);
    ret 0;
}

test "mach.lang.target.isa.spirv.emit:flat_element_classes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var tt: type.IrTypeTable;
    if (O.is_some[str](type.init(?tt, ?alloc))) { ret 1; }

    val f32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 32));
    val f64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_float(?tt, 64));
    val i32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 32));
    val i8t:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_int(?tt, 8));
    val v4f:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f32t, 4));
    val v3i:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, i32t, 3));
    val v2d:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_vector(?tt, f64t, 2));
    val arr:  type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](type.intern_array(?tt, f32t, 4));

    if (!needs_flat(?tt, i32t)) { type.dnit(?tt); ret 1; }
    if (!needs_flat(?tt, i8t))  { type.dnit(?tt); ret 1; }
    if (!needs_flat(?tt, v3i))  { type.dnit(?tt); ret 1; }

    if (!needs_flat(?tt, f64t)) { type.dnit(?tt); ret 1; }
    if (!needs_flat(?tt, v2d))  { type.dnit(?tt); ret 1; }

    if (needs_flat(?tt, f32t)) { type.dnit(?tt); ret 1; }
    if (needs_flat(?tt, v4f))  { type.dnit(?tt); ret 1; }

    if (needs_flat(?tt, arr)) { type.dnit(?tt); ret 1; }

    type.dnit(?tt);
    ret 0;
}

test "mach.lang.target.isa.spirv.emit.round_up_to:overflow_is_unrepresentable_not_a_wrap" {
    if (round_up_to(5, 16) != 16)                  { ret 1; }
    if (round_up_to(32, 16) != 32)                 { ret 1; }
    if (round_up_to(7, 0) != 7)                    { ret 1; }
    if (round_up_to(0xFFFFFFE0, 32) != 0xFFFFFFE0) { ret 1; }
    if (round_up_to(0xFFFFFFF0, 32) != 0)          { ret 1; }
    if (round_up_to(0xFFFFFFFF, 2) != 0)           { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.spirv.emit:volatile_whole_object_self_copy_keeps_load_and_store" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: spirv.Builder = spirv.builder_init(?alloc);
    fin { spirv.builder_dnit(?b); }
    var e: Emit;
    e.alloc = ?alloc;
    e.b = ?b;
    var ids: [1]u32 = [1]u32{37};
    var tys: [1]u32 = [1]u32{42};
    var vm: VMaps;
    vm.n = 1;
    vm.chain_id = ?ids[0];
    vm.chain_ty = ?tys[0];
    var mf: mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_mem_value(0, 0);
    ops[1] = mir.op_mem_value(0, 0);
    ops[2] = mir.op_imm(16);
    var mi: mir.MirInstr = mir.instr(mir.MIR_MEMCPY, ?ops[0], 3, 8, 8);
    var mode: u32 = 0;
    for (mode < 2) {
        b.functions.len = 0;
        mi.memory_flags = 0;
        if (mode == 1) { mi.memory_flags = mir.MEMORY_VOLATILE; }
        val rr: R.Result[R.Void, str] = emit_memcpy(?e, ?mf, ?vm, ?mi);
        if (R.is_err[R.Void, str](rr) || b.err) { ret 2; }
        val load_words: u32 = 4 + mode;
        val store_words: u32 = 3 + mode;
        if (b.functions.len != load_words + store_words) { ret 3; }
        val words: *u32 = b.functions.words;
        if (words[0] != ((load_words << 16) | spirv.OP_LOAD)) { ret 4; }
        if (words[1] != 42 || words[3] != 37) { ret 5; }
        if (words[load_words] != ((store_words << 16) | spirv.OP_STORE)) { ret 6; }
        if (words[load_words + 1] != 37 || words[load_words + 2] != words[2]) { ret 7; }
        if (mode == 1 && (words[4] != 1 || words[load_words + 3] != 1)) { ret 8; }
        mode = mode + 1;
    }
    ret 0;
}
