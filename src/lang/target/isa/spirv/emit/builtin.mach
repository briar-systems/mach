# the builtin variables a stage reads or writes: their types, stages and capabilities
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator.page;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.float;
use me_ir:   mach.lang.me.ir;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use target_definition: mach.lang.target.definition;
use isa_spirv:         mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.emit.emitter;
use emit_global: mach.lang.target.isa.spirv.emit.global;

fun required_type(which: u32, out_lanes: *u32, out_bits: *u32, out_is_float: *bool) str {
    @out_lanes    = 1;
    @out_bits     = 32;
    @out_is_float = true;
    if (which == me_ir.BUILTIN_POSITION || which == me_ir.BUILTIN_FRAG_COORD) {
        @out_lanes = 4;
        ret "`f32x4`, a four-component float vector";
    }
    if (which == me_ir.BUILTIN_POINT_SIZE) {
        ret "`f32`, a scalar float";
    }
    if (which == me_ir.BUILTIN_GLOBAL_INVOCATION || which == me_ir.BUILTIN_LOCAL_INVOCATION
        || which == me_ir.BUILTIN_WORKGROUP_ID || which == me_ir.BUILTIN_NUM_WORKGROUPS) {
        @out_lanes    = 3;
        @out_is_float = false;
        ret "`u32x3`, a three-component 32-bit unsigned vector";
    }
    @out_is_float = false;
    ret "`u32` or `i32`, a scalar 32-bit integer";
}

# why a `#[builtin]` variable's type is not the one SPIR-V specifies, nil when it is
pub fun type_refusal(tt: *ir_type.IrTypeTable, alloc: *A.Allocator, which: u32,
    ty: ir_type.IrTypeId) res[str, fail.Fail] {
    var want_lanes:    u32  = 0;
    var want_bits:     u32  = 0;
    var want_is_float: bool = false;
    val want:          str  = required_type(which, ?want_lanes, ?want_bits, ?want_is_float);

    var got_lanes:    u32  = 0;
    var got_bits:     u32  = 0;
    var got_is_float: bool = false;
    if (ir_scalar_shape(tt, ty, ?got_lanes, ?got_bits, ?got_is_float)
        && got_lanes == want_lanes && got_bits == want_bits && got_is_float == want_is_float) {
        ret res[str, fail.Fail].ok{nil};
    }

    val got: res[str, fail.Fail] = ir_type_spelling(tt, alloc, ty);
    if (sel got.err) { ret got; }
    ret fail.format(alloc,
        "this `#[builtin(\"{}\")]` variable is declared {}, and SPIR-V specifies it as {}. the requirement is on the variable's TYPE rather than on how it is read, so a wider or narrower one is an invalid module rather than a wasteful one",
        spelling_of(which), got.ok, want);
}

pub fun spelling_of(which: u32) str {
    if (which == me_ir.BUILTIN_VERTEX_INDEX)           { ret "vertex_index"; }
    if (which == me_ir.BUILTIN_INSTANCE_INDEX)         { ret "instance_index"; }
    if (which == me_ir.BUILTIN_FRAG_COORD)             { ret "frag_coord"; }
    if (which == me_ir.BUILTIN_POINT_SIZE)             { ret "point_size"; }
    if (which == me_ir.BUILTIN_GLOBAL_INVOCATION)      { ret "global_invocation"; }
    if (which == me_ir.BUILTIN_LOCAL_INVOCATION)       { ret "local_invocation"; }
    if (which == me_ir.BUILTIN_WORKGROUP_ID)           { ret "workgroup_id"; }
    if (which == me_ir.BUILTIN_NUM_WORKGROUPS)         { ret "num_workgroups"; }
    if (which == me_ir.BUILTIN_LOCAL_INVOCATION_INDEX) { ret "local_invocation_index"; }
    if (which == me_ir.BUILTIN_SUBGROUP_SIZE)          { ret "subgroup_size"; }
    if (which == me_ir.BUILTIN_SUBGROUP_INVOCATION)    { ret "subgroup_invocation"; }
    if (which == me_ir.BUILTIN_SUBGROUP_ID)            { ret "subgroup_id"; }
    if (which == me_ir.BUILTIN_NUM_SUBGROUPS)          { ret "num_subgroups"; }
    ret "position";
}

pub fun ir_scalar_shape(tt: *ir_type.IrTypeTable, id: ir_type.IrTypeId, out_lanes: *u32,
    out_bits: *u32, out_is_float: *bool) bool {
    @out_lanes    = 0;
    @out_bits     = 0;
    @out_is_float = false;
    val opt_: opt[*ir_type.IrType] = ir_type.get(tt, id);
    if (sel opt_.none) { ret false; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind == ir_type.IRT_FLOAT) {
        @out_lanes    = 1;
        @out_bits     = t.data.bits;
        @out_is_float = true;
        ret true;
    }
    # an f16 is carried in the ir as a binary16 integer, and is the float it stands for
    if (t.kind == ir_type.IRT_INT) {
        @out_lanes    = 1;
        @out_bits     = t.data.bits;
        @out_is_float = ir_type.int_form(tt, id) == ir_type.INT_FORM_BINARY16;
        ret true;
    }
    if (t.kind != ir_type.IRT_VECTOR) { ret false; }
    val eopt: opt[*ir_type.IrType] = ir_type.get(tt, t.data.vector_.element);
    if (sel eopt.none) { ret false; }
    val et: *ir_type.IrType = eopt.some;
    if (et.kind != ir_type.IRT_FLOAT && et.kind != ir_type.IRT_INT) { ret false; }
    @out_lanes    = t.data.vector_.lanes;
    @out_bits     = et.data.bits;
    @out_is_float = et.kind == ir_type.IRT_FLOAT || ir_type.int_form(tt, t.data.vector_.element) == ir_type.INT_FORM_BINARY16;
    ret true;
}

pub fun ir_type_spelling(tt: *ir_type.IrTypeTable, alloc: *A.Allocator, id: ir_type.IrTypeId) res[str, fail.Fail] {
    var lanes:    u32  = 0;
    var bits:     u32  = 0;
    var is_float: bool = false;
    val shaped:   bool = ir_scalar_shape(tt, id, ?lanes, ?bits, ?is_float);
    if (!shaped) {
        val opt_: opt[*ir_type.IrType] = ir_type.get(tt, id);
        if (sel opt_.none) { ret res[str, fail.Fail].err{fail.message("spirv.emit: a diagnostic names a type its table does not hold")}; }
        val k: ir_type.IrTypeKind = opt_.some.kind;
        if (k == ir_type.IRT_PTR)    { ret res[str, fail.Fail].ok{"a pointer"}; }
        if (k == ir_type.IRT_ARRAY)  { ret res[str, fail.Fail].ok{"an array"}; }
        if (k == ir_type.IRT_STRUCT) { ret res[str, fail.Fail].ok{"a record"}; }
        if (k == ir_type.IRT_UNION)  { ret res[str, fail.Fail].ok{"a union"}; }
        if (k == ir_type.IRT_TAG)    { ret res[str, fail.Fail].ok{"a tag"}; }
        ret res[str, fail.Fail].ok{"a type with no scalar shape"};
    }
    if (is_float && lanes == 1) { ret fail.format(alloc, "`f{}`", bits); }
    if (is_float)               { ret fail.format(alloc, "`f{}x{}`", bits, lanes); }
    if (lanes == 1)             { ret fail.format(alloc, "`i{}` / `u{}`", bits, bits); }
    ret fail.format(alloc, "`i{}x{}` / `u{}x{}`", bits, lanes, bits, lanes);
}

pub fun selector(which: u32) u32 {
    if (which == me_ir.BUILTIN_VERTEX_INDEX)           { ret isa_spirv.BUILTIN_VERTEX_INDEX; }
    if (which == me_ir.BUILTIN_INSTANCE_INDEX)         { ret isa_spirv.BUILTIN_INSTANCE_INDEX; }
    if (which == me_ir.BUILTIN_FRAG_COORD)             { ret isa_spirv.BUILTIN_FRAG_COORD; }
    if (which == me_ir.BUILTIN_POINT_SIZE)             { ret isa_spirv.BUILTIN_POINT_SIZE; }
    if (which == me_ir.BUILTIN_GLOBAL_INVOCATION)      { ret isa_spirv.BUILTIN_GLOBAL_INVOCATION_ID; }
    if (which == me_ir.BUILTIN_LOCAL_INVOCATION)       { ret isa_spirv.BUILTIN_LOCAL_INVOCATION_ID; }
    if (which == me_ir.BUILTIN_WORKGROUP_ID)           { ret isa_spirv.BUILTIN_WORKGROUP_ID; }
    if (which == me_ir.BUILTIN_NUM_WORKGROUPS)         { ret isa_spirv.BUILTIN_NUM_WORKGROUPS; }
    if (which == me_ir.BUILTIN_LOCAL_INVOCATION_INDEX) { ret isa_spirv.BUILTIN_LOCAL_INVOCATION_INDEX; }
    if (which == me_ir.BUILTIN_SUBGROUP_SIZE)          { ret isa_spirv.BUILTIN_SUBGROUP_SIZE; }
    if (which == me_ir.BUILTIN_SUBGROUP_INVOCATION)    { ret isa_spirv.BUILTIN_SUBGROUP_LOCAL_INVOCATION_ID; }
    if (which == me_ir.BUILTIN_SUBGROUP_ID)            { ret isa_spirv.BUILTIN_SUBGROUP_ID; }
    if (which == me_ir.BUILTIN_NUM_SUBGROUPS)          { ret isa_spirv.BUILTIN_NUM_SUBGROUPS; }
    ret isa_spirv.BUILTIN_POSITION;
}

# a set of pipeline stages, one bit per ir stage
pub fun stage_bit(stage: u8) u8 {
    if (stage == me_ir.STAGE_NONE) { ret 0; }
    ret (1 << stage)::u8;
}

val STAGES_ALL: u8 = 0x0E;

pub val STAGES_GRAPHICS: u8 = 0x06;

# the stages a built-in exists in, per the SPIR-V and vulkan built-in tables for the
# vertex, fragment and glcompute execution models, in the direction storage gives it
fun stages(which: u32) u8 {
    if (which == me_ir.BUILTIN_POSITION || which == me_ir.BUILTIN_POINT_SIZE
        || which == me_ir.BUILTIN_VERTEX_INDEX || which == me_ir.BUILTIN_INSTANCE_INDEX) {
        ret stage_bit(me_ir.STAGE_VERTEX);
    }
    if (which == me_ir.BUILTIN_FRAG_COORD) {
        ret stage_bit(me_ir.STAGE_FRAGMENT);
    }
    if (which == me_ir.BUILTIN_GLOBAL_INVOCATION || which == me_ir.BUILTIN_LOCAL_INVOCATION
        || which == me_ir.BUILTIN_WORKGROUP_ID || which == me_ir.BUILTIN_NUM_WORKGROUPS
        || which == me_ir.BUILTIN_LOCAL_INVOCATION_INDEX || which == me_ir.BUILTIN_SUBGROUP_ID
        || which == me_ir.BUILTIN_NUM_SUBGROUPS) {
        ret stage_bit(me_ir.STAGE_COMPUTE);
    }
    ret STAGES_ALL;
}

# the capability a built-in needs declared, NO_OP_CAPABILITY for one the Shader capability covers
pub fun capability(which: u32) u32 {
    if (which == me_ir.BUILTIN_SUBGROUP_SIZE || which == me_ir.BUILTIN_SUBGROUP_INVOCATION
        || which == me_ir.BUILTIN_SUBGROUP_ID || which == me_ir.BUILTIN_NUM_SUBGROUPS) {
        ret isa_spirv.CAP_GROUP_NON_UNIFORM;
    }
    ret target_definition.NO_OP_CAPABILITY;
}

fun stage_spelling(stage: u8) str {
    if (stage == me_ir.STAGE_VERTEX)   { ret "vertex"; }
    if (stage == me_ir.STAGE_FRAGMENT) { ret "fragment"; }
    if (stage == me_ir.STAGE_COMPUTE)  { ret "compute"; }
    ret "none";
}

# "compute", "vertex or fragment"
pub fun stages_spelling(e: *emitter.Emit, stages: u8) res[str, fail.Fail] {
    var out: str = nil;
    var st:  u8  = me_ir.STAGE_VERTEX;
    for (st <= me_ir.STAGE_COMPUTE) {
        if ((stages & stage_bit(st)) != 0) {
            if (out == nil) { out = stage_spelling(st); }
            or {
                val r: res[str, fail.Fail] = fail.format(e.alloc, "{} or {}", out, stage_spelling(st));
                if (sel r.err) { ret r; }
                out = r.ok;
            }
        }
        st = st + 1;
    }
    if (out == nil) { ret res[str, fail.Fail].ok{"none"}; }
    ret res[str, fail.Fail].ok{out};
}

# the refusal of a built-in used by a stage SPIR-V does not define it in, nil when it does
pub fun stage_refusal(e: *emitter.Emit, fx: u32, gi: u32) res[str, fail.Fail] {
    val g:    *me_ir.Global = emit_global.ir_of(e, gi);
    val want: u8            = stages(g.iface_a);
    val have: u8            = emitter.fn_ir(e, fx).stage;
    if ((want & stage_bit(have)) != 0) { ret res[str, fail.Fail].ok{nil}; }
    val user: res[str, fail.Fail] = emitter.ir_fn_spelling(e, fx);
    if (sel user.err) { ret user; }
    val where: res[str, fail.Fail] = emit_global.mod_prefix(e, gi);
    if (sel where.err) { ret where; }
    val stages: res[str, fail.Fail] = stages_spelling(e, want);
    if (sel stages.err) { ret stages; }
    if (storage(g.iface_a) == isa_spirv.STORAGE_OUTPUT) {
        ret fail.format(e.alloc,
            "the {} stage `{}` uses the `#[builtin(\"{}\")]` variable{}, and SPIR-V defines that built-in only as an output of a {} stage: the pipeline consumes it from that execution model alone, so no other stage may use it",
            stage_spelling(have), user.ok, spelling_of(g.iface_a),
            where.ok, stages.ok);
    }
    ret fail.format(e.alloc,
        "the {} stage `{}` uses the `#[builtin(\"{}\")]` variable{}, and SPIR-V defines that built-in only in a {} stage: the pipeline supplies it to that execution model alone, so no other stage has a value to read",
        stage_spelling(have), user.ok, spelling_of(g.iface_a),
        where.ok, stages.ok);
}

pub fun storage(which: u32) u32 {
    if (which == me_ir.BUILTIN_POSITION || which == me_ir.BUILTIN_POINT_SIZE) {
        ret isa_spirv.STORAGE_OUTPUT;
    }
    ret isa_spirv.STORAGE_INPUT;
}

# a refusal text was made
#[testing]
fun t_refuses(r: res[str, fail.Fail]) bool {
    ret sel r.ok && r.ok != nil;
}

# no refusal was made, and nothing failed in deciding so
#[testing]
fun t_accepts(r: res[str, fail.Fail]) bool {
    ret sel r.ok && r.ok == nil;
}

#[testing]
fun t_spelled(r: res[str, fail.Fail], want: str) bool {
    ret sel r.ok && str_equals(r.ok, want);
}

test type_refusal__each_builtin_takes_its_own_type {
    var alloc:  A.Allocator;
    val r_3498: err[A.Error] = page.make(?alloc);
    if (sel r_3498.err) { ret 1; }
    var tt:     ir_type.IrTypeTable;
    val r_3500: err[fail.Fail] = ir_type.init(?tt, ?alloc);
    if (sel r_3500.err) { ret 1; }
    fin { ir_type.dnit(?tt); }

    val f32t_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   ir_type.IrTypeId                 = f32t_r.ok;
    val i32t_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:   ir_type.IrTypeId                 = i32t_r.ok;
    val f64t_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?tt, 64);
    if (sel f64t_r.err) { ret 1; }
    val f64t:  ir_type.IrTypeId                 = f64t_r.ok;
    val v4f_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, f32t, 4);
    if (sel v4f_r.err) { ret 1; }
    val v4f:   ir_type.IrTypeId                 = v4f_r.ok;
    val v3f_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, f32t, 3);
    if (sel v3f_r.err) { ret 1; }
    val v3f:   ir_type.IrTypeId                 = v3f_r.ok;
    val v3i_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   ir_type.IrTypeId                 = v3i_r.ok;
    val v4i_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, i32t, 4);
    if (sel v4i_r.err) { ret 1; }
    val v4i: ir_type.IrTypeId = v4i_r.ok;

    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_POSITION, v4f)))    { ret 1; }
    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_FRAG_COORD, v4f)))  { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_POSITION, v3f)))    { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_POSITION, v4i)))    { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_FRAG_COORD, f32t))) { ret 1; }

    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_POINT_SIZE, f32t))) { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_POINT_SIZE, f64t))) { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_POINT_SIZE, v4f)))  { ret 1; }

    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_VERTEX_INDEX, i32t)))   { ret 1; }
    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_INSTANCE_INDEX, i32t))) { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_VERTEX_INDEX, f32t)))   { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_INSTANCE_INDEX, v3i)))  { ret 1; }

    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_GLOBAL_INVOCATION, v3i)))       { ret 1; }
    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_LOCAL_INVOCATION, v3i)))        { ret 1; }
    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_WORKGROUP_ID, v3i)))            { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_GLOBAL_INVOCATION, v4i)))       { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_LOCAL_INVOCATION, v3f)))        { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_WORKGROUP_ID, i32t)))           { ret 1; }
    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_NUM_WORKGROUPS, v3i)))          { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_NUM_WORKGROUPS, i32t)))         { ret 1; }
    if (t_refuses(type_refusal(?tt, ?alloc, me_ir.BUILTIN_LOCAL_INVOCATION_INDEX, i32t))) { ret 1; }
    if (t_accepts(type_refusal(?tt, ?alloc, me_ir.BUILTIN_LOCAL_INVOCATION_INDEX, v3i)))  { ret 1; }

    var sb: u32 = me_ir.BUILTIN_SUBGROUP_SIZE;
    for (sb <= me_ir.BUILTIN_NUM_SUBGROUPS) {
        if (t_refuses(type_refusal(?tt, ?alloc, sb, i32t))) { ret 2; }
        if (t_accepts(type_refusal(?tt, ?alloc, sb, v3i)))  { ret 2; }
        if (t_accepts(type_refusal(?tt, ?alloc, sb, f32t))) { ret 2; }
        sb = sb + 1;
    }

    ret 0;
}

test ir_type_spelling__scalars_vectors_and_aggregates {
    var alloc:  A.Allocator;
    val r_3538: err[A.Error] = page.make(?alloc);
    if (sel r_3538.err) { ret 1; }
    var tt:     ir_type.IrTypeTable;
    val r_3540: err[fail.Fail] = ir_type.init(?tt, ?alloc);
    if (sel r_3540.err) { ret 1; }
    fin { ir_type.dnit(?tt); }

    val f32t_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?tt, 32);
    if (sel f32t_r.err) { ret 1; }
    val f32t:   ir_type.IrTypeId                 = f32t_r.ok;
    val i32t_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?tt, 32);
    if (sel i32t_r.err) { ret 1; }
    val i32t:  ir_type.IrTypeId                 = i32t_r.ok;
    val v3f_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, f32t, 3);
    if (sel v3f_r.err) { ret 1; }
    val v3f:   ir_type.IrTypeId                 = v3f_r.ok;
    val v3i_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, i32t, 3);
    if (sel v3i_r.err) { ret 1; }
    val v3i:   ir_type.IrTypeId                 = v3i_r.ok;
    val arr_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?tt, f32t, 4);
    if (sel arr_r.err) { ret 1; }
    val arr: ir_type.IrTypeId = arr_r.ok;

    if (!t_spelled(ir_type_spelling(?tt, ?alloc, f32t), "`f32`"))            { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, v3f), "`f32x3`"))           { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, i32t), "`i32` / `u32`"))    { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, v3i), "`i32x3` / `u32x3`")) { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, arr), "an array"))          { ret 1; }

    # an f16 and a vector of them are their binary16 carriers in the ir
    val h_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int_form(?tt, 16, ir_type.INT_FORM_BINARY16);
    if (sel h_r.err) { ret 1; }
    val v4h_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?tt, h_r.ok, 4);
    if (sel v4h_r.err) { ret 1; }
    val i16_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?tt, 16);
    if (sel i16_r.err)                                                        { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, h_r.ok), "`f16`"))           { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, v4h_r.ok), "`f16x4`"))       { ret 1; }
    if (!t_spelled(ir_type_spelling(?tt, ?alloc, i16_r.ok), "`i16` / `u16`")) { ret 1; }

    ret 0;
}
