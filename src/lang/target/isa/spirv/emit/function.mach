# one function emitted: its parameters, structured control flow and entry point
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std_format: std.format;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use me_ir:   mach.lang.me.ir;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_mir:      mach.lang.mir;
use mir_structure: mach.lang.mir.structure;
use lang_source:   mach.lang.source;
use isa_spirv:     mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.debug;
use emit_copy: mach.lang.target.isa.spirv.emit.copy;
use mach.lang.target.isa.spirv.emit.emitter;
use emit_global:      mach.lang.target.isa.spirv.emit.global;
use emit_instruction: mach.lang.target.isa.spirv.emit.instruction;
use emit_interface:   mach.lang.target.isa.spirv.emit.interface;
use emit_layout:      mach.lang.target.isa.spirv.emit.layout;
use emit_memory:      mach.lang.target.isa.spirv.emit.memory;
use emit_op:          mach.lang.target.isa.spirv.emit.op;
use mach.lang.target.isa.spirv.emit.spelling;
use emit_value: mach.lang.target.isa.spirv.emit.value;
use mach.lang.target.isa.spirv.ops;
use mach.lang.target.isa.spirv.types;

pub fun function_emit(e: *emitter.Emit, cx: u32) err[fail.Fail] {
    val fx:  u32                   = e.copies.data[cx].fx;
    val key: u32                   = e.copies.data[cx].key_at;
    val mf:  *lang_mir.MirFunction = emitter.fn_mir(e, fx);
    if (mf == nil) { ret err[fail.Fail].err{fail.message("spirv.emit: an emitted function has no lowered body")}; }
    e.cur_fn     = mf;
    e.cur_instr  = nil;
    e.cur_mi     = e.fns[fx].mi;
    e.cur_stages = 0;
    if (e.fn_stages != nil) { e.cur_stages = e.fn_stages[fx]; }
    emit_layout.use_at(e, mf.decl_loc);
    e.ir = emitter.fn_mod(e, fx);
    val irfn: *me_ir.Function = emitter.fn_ir(e, fx);

    var bi: u32 = 0;
    for (bi < mf.block_count && e.cur_instr == nil) {
        var ii: u32 = 0;
        for (ii < mf.blocks[bi].instr_count && e.cur_instr == nil) {
            if (!lang_source.file_is_nil(mf.blocks[bi].instrs[ii].loc.file)) { e.cur_instr = ?mf.blocks[bi].instrs[ii]; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    val flow: err[fail.Fail] = emit_interface.confined_flow(e, fx, mf);
    if (sel flow.err) { ret flow; }

    var returns_void: bool = false;
    val ret_ty:       u32  = emit_value.ir_return_spv_type(e, irfn, ?returns_void);
    if (ret_ty == 0) {
        ret emitter.unsupported(e, "unsupported return type in the SPIR-V target");
    }
    # each source parameter's SPIR-V parameters: one, or a path's root and runtime indices
    val rs: res[*u32, A.Error] = A.allocate[u32](e.alloc, (irfn.param_count + 1)::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val pslot: *u32 = rs.ok;
    fin { A.deallocate[u32](e.alloc, pslot, (irfn.param_count + 1)::usize); }
    var slots: u32 = 0;
    var pk:    u32 = 0;
    for (pk < irfn.param_count) {
        pslot[pk] = slots;
        slots     = slots + emit_copy.binding_arity(e, emit_value.key_param(e, key, pk));
        pk        = pk + 1;
    }
    pslot[irfn.param_count] = slots;
    if (!types.instruction_operands_fit(2, slots)) {
        ret emitter.unsupported(e, "SPIR-V OpTypeFunction parameter count exceeds its 65535-word instruction encoding");
    }
    val pr: res[*u32, A.Error] = A.allocate[u32](e.alloc, (slots + 1)::usize);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    val ptypes: *u32 = pr.ok;
    fin { A.deallocate[u32](e.alloc, ptypes, (slots + 1)::usize); }
    val pir: res[*u32, A.Error] = A.allocate[u32](e.alloc, (slots + 1)::usize);
    if (sel pir.err) { ret err[fail.Fail].err{fail.refused(pir.err)}; }
    val param_ids: *u32 = pir.ok;
    fin { A.deallocate[u32](e.alloc, param_ids, (slots + 1)::usize); }
    var pi: u32 = 0;
    for (pi < irfn.param_count) {
        val at:   u32 = emit_value.key_param(e, key, pi);
        val bind: u32 = e.keys.data[at];
        if (bind == emitter.BIND_GLOBAL || bind == emitter.BIND_LOCAL) {
            emit_instruction.path_param_types(e, at, ?ptypes[pslot[pi]]);
            pi = pi + 1;
            cnt;
        }
        if (bind == emitter.BIND_PHYSICAL) {
            val pp: res[u32, fail.Fail] = emit_layout.phys_pointer(e, ?e.ir.types, irfn.params[pi].ty);
            if (sel pp.err) { ret err[fail.Fail].err{pp.err}; }
            ptypes[pslot[pi]] = pp.ok;
            pi                = pi + 1;
            cnt;
        }
        val pt: u32 = emit_value.ir_value_spv_type(e, irfn.params[pi].ty);
        if (pt == 0) {
            val reason: res[str, fail.Fail] = spelling.type_refusal_reason(e, irfn.params[pi].ty);
            if (sel reason.err) { ret err[fail.Fail].err{reason.err}; }
            var shown:   spelling.TypeText;
            val spelled: res[str, fail.Fail] = spelling.type_text(e, ?shown, irfn.params[pi].ty);
            if (sel spelled.err) {
                spelling.text_dnit(?shown);
                ret err[fail.Fail].err{spelled.err};
            }
            val refused: err[fail.Fail] = emitter.unsupported_made(e, fail.format_intern(e.interner, e.alloc,
                "unsupported parameter {} of type `{}` in the SPIR-V Logical Shader environment: {}",
                pi + 1, spelled.ok, reason.ok));
            spelling.text_dnit(?shown);
            ret refused;
        }
        ptypes[pslot[pi]] = pt;
        pi                = pi + 1;
    }
    val fnty: u32 = types.type_fn(e.tt, ret_ty, ?ptypes[0], slots);
    if (fnty == 0) {
        ret emitter.unsupported(e, "this signature has no SPIR-V function type in the SPIR-V target");
    }

    val fn_id: u32 = e.copies.data[cx].id;

    val fn_name: str = intern.text(e.interner, mf.name);

    if (irfn.stage != me_ir.STAGE_NONE) {
        val er: err[fail.Fail] = entry_point_emit(e, irfn, fx, fn_id, entry_name(e, irfn, fn_name), returns_void);
        if (sel er.err) { ret er; }
    }
    or (!e.has_entry && e.fns[fx].mi == e.u.root && emit_copy.copy_is_primary(e, cx)) { linkage_export_emit(e, fn_id, fn_name); }

    val shapes: *mir_structure.Structure = e.u.mods[e.fns[fx].mi].shapes;
    if (shapes == nil) { ret emitter.defect(e, "spirv.emit: the unit reached the emitter without its control-flow structure"); }
    val st: *mir_structure.Structure = ?shapes[e.fns[fx].mir_ix];
    if (st.status != mir_structure.CFG_OK) {
        ret err[fail.Fail].err{emitter.reject_made_at(e, diagnostic_kind.SPIRV_CONTROL_FLOW, mf.decl_loc, structure_refusal(e, fn_name, st))};
    }

    var fop: [4]u32;
    fop[0] = ret_ty;
    fop[1] = fn_id;
    fop[2] = isa_spirv.FUNCTION_CONTROL_NONE;
    fop[3] = fnty;
    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_FUNCTION, ?fop[0], 4);
    debug.name_shown(?e.dbg, fn_id, irfn.disp, mf.name);
    if (e.fns[fx].mi == e.u.root && e.cur_instr != nil) { debug.source_of(?e.dbg, e.cur_instr.loc); }

    pi = 0;
    for (pi < slots) {
        val pid: u32 = isa_spirv.alloc_id(e.b);
        var pp:  [2]u32;
        pp[0] = ptypes[pi];
        pp[1] = pid;
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_FUNCTION_PARAMETER, ?pp[0], 2);
        # a physical pointer parameter says whether what it points at is aliased
        if (emit_value.physical_type(e, ptypes[pi])) { emit_value.decorate_bare(e, pid, isa_spirv.DECOR_ALIASED); }
        param_ids[pi] = pid;
        pi            = pi + 1;
    }

    val rl: res[*u32, A.Error] = A.allocate[u32](e.alloc, st.count::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    val labels: *u32 = rl.ok;
    var li:     u32  = 0;
    for (li < st.count) {
        labels[li] = isa_spirv.alloc_id(e.b);
        li         = li + 1;
    }

    # a stage that zeroes its `#[shared]` memory opens on a block of its own, so the
    # first user block is an ordinary one the prologue branches to
    val zeroing: bool = zeroes_shared(e, fx, irfn);
    var lb:      [1]u32;
    lb[0] = labels[st.order[0]];
    if (zeroing) { lb[0] = isa_spirv.alloc_id(e.b); }
    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_LABEL, ?lb[0], 1);
    debug.block(?e.dbg);

    var vm: emitter.VMaps;
    e.cur_copy = cx;
    val mr: err[fail.Fail] = emit_value.build_vmaps(e, mf, irfn, ?vm);
    if (sel mr.err) {
        emit_value.vmaps_dnit(e, ?vm);
        A.deallocate[u32](e.alloc, labels, st.count::usize);
        ret mr;
    }
    # a dispatch reads the case its exits stored in a variable of its own
    var selectors: *u32 = nil;
    if (has_dispatch(st)) {
        val rv: res[*u32, A.Error] = A.allocate[u32](e.alloc, st.count::usize);
        if (sel rv.err) {
            emit_value.vmaps_dnit(e, ?vm);
            A.deallocate[u32](e.alloc, labels, st.count::usize);
            ret err[fail.Fail].err{fail.refused(rv.err)};
        }
        selectors = rv.ok;
        declare_selectors(e, st, selectors);
    }
    emit_layout.use_at(e, mf.decl_loc);

    e.cur_copy   = cx;
    e.cur_pslot  = pslot;
    e.cur_params = param_ids;
    var body: err[fail.Fail] = err[fail.Fail].ok{};
    if (irfn.stage != me_ir.STAGE_NONE) { body = emit_interface.output_zeroing_emit(e, fx); }
    var opened: bool = true;
    if (sel body.err)      { opened = false; }
    if (zeroing && opened) { body = shared_zeroing_emit(e, fx, irfn, lb[0], labels[st.order[0]]); }
    var oi: u32 = 0;
    if (sel body.err) { oi = st.count; }
    for (oi < st.count) {
        body = node_emit(e, mf, st, st.order[oi], oi == 0 && !zeroing, labels, selectors, ?vm, returns_void, ret_ty);
        if (sel body.err) {
            oi = st.count;
            cnt;
        }
        oi = oi + 1;
    }
    e.cur_copy   = emitter.COPY_NONE;
    e.cur_pslot  = nil;
    e.cur_params = nil;

    emit_value.vmaps_dnit(e, ?vm);
    A.deallocate[u32](e.alloc, labels, st.count::usize);
    if (selectors != nil) { A.deallocate[u32](e.alloc, selectors, st.count::usize); }
    if (sel body.err)     { ret body; }

    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_FUNCTION_END, nil, 0);
    if (e.b.err) { ret err[fail.Fail].err{fail.message("spirv.emit: module builder hit an allocation error")}; }
    ret err[fail.Fail].ok{};
}

fun structure_refusal(e: *emitter.Emit, name: str, st: *mir_structure.Structure) res[str, fail.Fail] {
    val jr: res[str, std_format.FormatError] = mir_structure.refusal_text(e.alloc, name, st.status, e.tgt.identity.arch_name);
    if (sel jr.err) { ret res[str, fail.Fail].err{fail.format_refused(jr.err)}; }
    ret fail.text_intern(e.interner, e.alloc, jr.ok);
}

fun has_dispatch(st: *mir_structure.Structure) bool {
    var i: u32 = st.real;
    for (i < st.count) {
        if (st.nodes[i].role == mir_structure.ROLE_DISPATCH) { ret true; }
        i = i + 1;
    }
    ret false;
}

# one Function variable per dispatch, in the function's first block with the
# other variables
fun declare_selectors(e: *emitter.Emit, st: *mir_structure.Structure, selectors: *u32) {
    val ty:     u32 = types.type_int(e.tt, 32);
    val ptr_ty: u32 = types.type_ptr(e.tt, isa_spirv.STORAGE_FUNCTION, ty);
    var i:      u32 = 0;
    for (i < st.count) {
        selectors[i] = 0;
        if (st.nodes[i].role == mir_structure.ROLE_DISPATCH) {
            val id:  u32 = isa_spirv.alloc_id(e.b);
            var vop: [3]u32;
            vop[0] = ptr_ty;
            vop[1] = id;
            vop[2] = isa_spirv.STORAGE_FUNCTION;
            isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_VARIABLE, ?vop[0], 3);
            selectors[i] = id;
        }
        i = i + 1;
    }
}

fun node_emit(e: *emitter.Emit, mf: *lang_mir.MirFunction, st: *mir_structure.Structure, ix: u32, is_entry: bool,
    labels: *u32, selectors: *u32, vm: *emitter.VMaps, returns_void: bool, ret_ty: u32) err[fail.Fail] {
    if (!is_entry) {
        var lb: [1]u32;
        lb[0] = labels[ix];
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_LABEL, ?lb[0], 1);
        debug.block(?e.dbg);
    }

    val role: u8 = st.nodes[ix].role;
    if (role == mir_structure.ROLE_UNREACHABLE) {
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_UNREACHABLE, nil, 0);
        ret err[fail.Fail].ok{};
    }
    if (role == mir_structure.ROLE_CONTINUE || role == mir_structure.ROLE_FORWARD) {
        branch_emit(e, labels[mir_structure.succ(st, ix, 0)]);
        ret err[fail.Fail].ok{};
    }
    if (role == mir_structure.ROLE_EXIT) {
        var so: [2]u32;
        so[0] = selectors[st.nodes[ix].dispatch];
        so[1] = types.const_scalar(e.tt, types.type_int(e.tt, 32), st.nodes[ix].case, 0);
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_STORE, ?so[0], 2);
        branch_emit(e, labels[mir_structure.succ(st, ix, 0)]);
        ret err[fail.Fail].ok{};
    }
    if (role == mir_structure.ROLE_DISPATCH) {
        dispatch_emit(e, st, ix, labels, selectors);
        ret err[fail.Fail].ok{};
    }

    val blk: *lang_mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    if (role == mir_structure.ROLE_REAL) {
        var ii: u32 = 0;
        for (ii + 1 < blk.instr_count) {
            debug.line(?e.dbg, blk.instrs[ii].loc);
            val r: err[fail.Fail] = emit_instruction.instr_emit(e, mf, vm, ?blk.instrs[ii]);
            if (sel r.err) { ret r; }
            ii = ii + 1;
        }
    }

    ret terminator_emit(e, mf, st, ix, labels, vm, returns_void, ret_ty);
}

fun merge_emit(e: *emitter.Emit, st: *mir_structure.Structure, ix: u32, labels: *u32) {
    if (st.nodes[ix].kind == mir_structure.CK_LOOP) {
        var lm: [3]u32;
        lm[0] = labels[st.nodes[ix].merge];
        lm[1] = labels[st.nodes[ix].cont];
        lm[2] = isa_spirv.LOOP_CONTROL_NONE;
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_LOOP_MERGE, ?lm[0], 3);
        ret;
    }
    if (st.nodes[ix].kind == mir_structure.CK_SELECTION || st.nodes[ix].kind == mir_structure.CK_SWITCH) {
        var sm: [2]u32;
        sm[0] = labels[st.nodes[ix].merge];
        sm[1] = isa_spirv.SELECTION_CONTROL_NONE;
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_SELECTION_MERGE, ?sm[0], 2);
    }
}

# a switch over the case the dispatch's exits stored: the first successor is the
# default, and case k branches to successor k
fun dispatch_emit(e: *emitter.Emit, st: *mir_structure.Structure, ix: u32, labels: *u32, selectors: *u32) {
    val ty:     u32 = types.type_int(e.tt, 32);
    val chosen: u32 = isa_spirv.alloc_id(e.b);
    var lo:     [3]u32;
    lo[0] = ty;
    lo[1] = chosen;
    lo[2] = selectors[ix];
    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_LOAD, ?lo[0], 3);
    merge_emit(e, st, ix, labels);

    val n:  u32                = st.nodes[ix].nsucc;
    val wn: u32                = 2 + (n - 1) * 2;
    val ra: res[*u32, A.Error] = A.allocate[u32](e.alloc, wn::usize);
    if (sel ra.err) {
        e.b.err = true;
        ret;
    }
    val ops: *u32 = ra.ok;
    ops[0] = chosen;
    ops[1] = labels[mir_structure.succ(st, ix, 0)];
    var k: u32 = 1;
    for (k < n) {
        ops[2 + (k - 1) * 2]     = k;
        ops[2 + (k - 1) * 2 + 1] = labels[mir_structure.succ(st, ix, k)];
        k                        = k + 1;
    }
    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_SWITCH, ops, wn);
    A.deallocate[u32](e.alloc, ops, wn::usize);
}

fun branch_emit(e: *emitter.Emit, label: u32) {
    var o: [1]u32;
    o[0] = label;
    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_BRANCH, ?o[0], 1);
}

fun terminator_emit(e: *emitter.Emit, mf: *lang_mir.MirFunction, st: *mir_structure.Structure, ix: u32, labels: *u32,
    vm: *emitter.VMaps, returns_void: bool, ret_ty: u32) err[fail.Fail] {
    if (st.nodes[ix].split != mir_structure.NO_BLOCK) {
        merge_emit(e, st, ix, labels);
        branch_emit(e, labels[st.nodes[ix].split]);
        ret err[fail.Fail].ok{};
    }

    val blk:  *lang_mir.MirBlock = ?mf.blocks[st.nodes[ix].block];
    val term: *lang_mir.MirInstr = ?blk.instrs[blk.instr_count - 1];
    e.cur_instr = term;
    emit_layout.use_at(e, lang_mir.refusal_loc(e.cur_fn, term));
    debug.line(?e.dbg, term.loc);

    if (term.opcode == lang_mir.MIR_BR) {
        merge_emit(e, st, ix, labels);
        branch_emit(e, labels[mir_structure.succ(st, ix, 0)]);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == lang_mir.MIR_CBR) {
        val cond: u32 = emit_op.read_condition(e, vm, ?term.operands[0], term.width::u32 * 8);
        if (cond == 0) { ret emitter.defect(e, "spirv.emit: unreadable branch condition"); }
        merge_emit(e, st, ix, labels);
        var bc: [3]u32;
        bc[0] = cond;
        bc[1] = labels[mir_structure.succ(st, ix, 0)];
        bc[2] = labels[mir_structure.succ(st, ix, 1)];
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_BRANCH_CONDITIONAL, ?bc[0], 3);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == lang_mir.MIR_UNREACHABLE) {
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_UNREACHABLE, nil, 0);
        ret err[fail.Fail].ok{};
    }
    if (term.opcode == lang_mir.MIR_RET) {
        if (returns_void) {
            if (term.operand_count != 0) { ret emitter.defect(e, "spirv.emit: void return carries a value"); }
            isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_RETURN, nil, 0);
            ret err[fail.Fail].ok{};
        }
        if (term.operand_count != 1) { ret emitter.defect(e, "spirv.emit: logical return requires one value"); }
        if (emit_instruction.pointer_operand(vm, ?term.operands[0]) && (vm.prov[term.operands[0].vreg.n] & emitter.PROV_LOGICAL) != 0) {
            # a returned pointer is a physical one, so a logical one is refused naming what it points into
            ret emitter.unsupported_made(e, fail.format(e.alloc,
                "the current SPIR-V Logical Shader environment does not support {}-storage reference results: a returned pointer is a physical pointer, an address in a buffer the host passes, and this one names memory the module declares, which has no address. return the value it points at, or take the pointer as a parameter",
                emit_op.storage_class_name(emit_interface.return_storage(e, e.copies.data[e.cur_copy].fx, e.copies.data[e.cur_copy].key_at))));
        }
        val rr: res[u32, fail.Fail] = emit_memory.read_value(e, mf, vm, ?term.operands[0], ret_ty, term.memory_flags);
        if (sel rr.err) { ret emitter.read_failure(e, rr.err); }
        val rid: u32 = rr.ok;
        var rv:  [1]u32;
        rv[0] = rid;
        isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_RETURN_VALUE, ?rv[0], 1);
        ret err[fail.Fail].ok{};
    }
    ret emitter.unsupported(e, "instruction is not yet supported by the SPIR-V target");
}

fun entry_name(e: *emitter.Emit, irfn: *me_ir.Function, linkage: str) str {
    if (intern.str_is_nil(irfn.disp)) { ret linkage; }
    ret intern.text(e.interner, irfn.disp);
}

fun entry_point_emit(e: *emitter.Emit, irfn: *me_ir.Function, fn_ix: u32, fn_id: u32, name: str,
    returns_void: bool) err[fail.Fail] {
    if (!returns_void) {
        ret emitter.refuse(e, diagnostic_kind.SPIRV_STAGE_SIGNATURE, "a function declaring a `#[stage(...)]` must return nothing: a pipeline stage's results leave through its output interface variables, not through a return value");
    }
    if (irfn.param_count != 0) {
        ret emitter.refuse(e, diagnostic_kind.SPIRV_STAGE_SIGNATURE, "a function declaring a `#[stage(...)]` must take no parameters: a pipeline stage's inputs arrive through its input interface variables, not as arguments");
    }

    var model: u32 = isa_spirv.EXEC_MODEL_VERTEX;
    if (irfn.stage == me_ir.STAGE_FRAGMENT) { model = isa_spirv.EXEC_MODEL_FRAGMENT; }
    or (irfn.stage == me_ir.STAGE_COMPUTE)  { model = isa_spirv.EXEC_MODEL_GLCOMPUTE; }

    val sw_r: res[u32, fail.Fail] = isa_spirv.string_words(name);
    if (sel sw_r.err) { ret err[fail.Fail].err{sw_r.err}; }
    val sw:   u32 = sw_r.ok;
    var used: u32 = 0;
    var gi:   u32 = 0;
    for (gi < e.gl_len) {
        if (entry_lists(e, fn_ix, gi)) { used = used + 1; }
        gi = gi + 1;
    }
    # the zeroing reads LocalInvocationIndex, an Input the interface names even where
    # the stage's own code never reads it
    var lid: u32 = 0;
    if (zeroes_shared(e, fn_ix, irfn)) {
        val lx: u32 = local_invocation_global(e);
        if (lx == emit_global.GL_NONE || !entry_lists(e, fn_ix, lx)) {
            var lty: u32 = 0;
            lid  = zero_lid(e, ?lty);
            used = used + 1;
        }
    }
    val total: u32                = 2 + sw + used;
    val ra:    res[*u32, A.Error] = A.allocate[u32](e.alloc, total::usize);
    if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
    val ops: *u32 = ra.ok;
    ops[0] = model;
    ops[1] = fn_id;
    isa_spirv.pack_string(name, sw, ?ops[2]);
    var ii: u32 = 0;
    gi = 0;
    for (gi < e.gl_len) {
        if (entry_lists(e, fn_ix, gi)) {
            ops[2 + sw + ii] = e.gvar_ids[gi];
            ii               = ii + 1;
        }
        gi = gi + 1;
    }
    if (lid != 0) { ops[2 + sw + ii] = lid; }
    isa_spirv.inst(e.b, ?e.b.entry_points, isa_spirv.OP_ENTRY_POINT, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);

    if (irfn.stage == me_ir.STAGE_FRAGMENT) {
        var fm: [2]u32;
        fm[0] = fn_id;
        fm[1] = isa_spirv.EXEC_MODE_ORIGIN_UPPER_LEFT;
        isa_spirv.inst(e.b, ?e.b.exec_modes, isa_spirv.OP_EXECUTION_MODE, ?fm[0], 2);
    }
    if (irfn.stage == me_ir.STAGE_COMPUTE && !e.wg_builtin) {
        var cm: [5]u32;
        cm[0] = fn_id;
        if (emit_interface.wg_is_spec(irfn)) {
            cm[1] = isa_spirv.EXEC_MODE_LOCAL_SIZE_ID;
            var d: u32 = 0;
            for (d < 3) {
                val r: res[u32, fail.Fail] = emit_interface.wg_dim_id(e, irfn, d);
                if (sel r.err) { ret err[fail.Fail].err{r.err}; }
                cm[2 + d] = r.ok;
                d         = d + 1;
            }
            isa_spirv.inst(e.b, ?e.b.exec_modes, isa_spirv.OP_EXECUTION_MODE_ID, ?cm[0], 5);
        }
        or {
            cm[1] = isa_spirv.EXEC_MODE_LOCAL_SIZE;
            cm[2] = irfn.wg_x;
            cm[3] = irfn.wg_y;
            cm[4] = irfn.wg_z;
            isa_spirv.inst(e.b, ?e.b.exec_modes, isa_spirv.OP_EXECUTION_MODE, ?cm[0], 5);
        }
    }
    ret err[fail.Fail].ok{};
}

# a `#[shared]` variable holding a physical pointer is zeroed by the stage even where the
# environment zeroes workgroup memory, since a physical pointer has no null constant
fun shared_zeroed_natively(e: *emitter.Emit, gx: u32) bool {
    ret emit_interface.shared_native_zero(e) && !emit_memory.holds_physical(e, e.gtype_ids[gx]);
}

fun zeroes_shared(e: *emitter.Emit, fx: u32, irfn: *me_ir.Function) bool {
    if (irfn.stage != me_ir.STAGE_COMPUTE) { ret false; }
    var gx: u32 = 0;
    for (gx < e.gl_len) {
        if (emit_global.ir_of(e, gx).iface == me_ir.IFACE_SHARED && e.gslot[gx] != 0 && !shared_zeroed_natively(e, gx)
            && emit_interface.uses_iface(e, fx, e.gslot[gx] - 1)) {
            ret true;
        }
        gx = gx + 1;
    }
    ret false;
}

fun local_invocation_global(e: *emitter.Emit) u32 {
    var gx: u32 = 0;
    for (gx < e.gl_len) {
        val g: *me_ir.Global = emit_global.ir_of(e, gx);
        if (g.iface == me_ir.IFACE_BUILTIN && g.iface_a == me_ir.BUILTIN_LOCAL_INVOCATION_INDEX
            && e.gvar_ids[gx] != 0) {
            ret gx;
        }
        gx = gx + 1;
    }
    ret emit_global.GL_NONE;
}

# the LocalInvocationIndex variable and its value type: a declared
# `#[builtin("local_invocation_index")]` where there is one, else one the emitter adds once
fun zero_lid(e: *emitter.Emit, out_ty: *u32) u32 {
    val gx: u32 = local_invocation_global(e);
    if (gx != emit_global.GL_NONE) {
        @out_ty = e.gtype_ids[gx];
        ret e.gvar_ids[gx];
    }
    val u32t: u32 = types.type_int(e.tt, 32);
    @out_ty = u32t;
    if (e.zero_lid != 0) { ret e.zero_lid; }
    val var_id: u32 = isa_spirv.alloc_id(e.b);
    var vop:    [3]u32;
    vop[0] = types.type_ptr(e.tt, isa_spirv.STORAGE_INPUT, u32t);
    vop[1] = var_id;
    vop[2] = isa_spirv.STORAGE_INPUT;
    isa_spirv.inst(e.b, ?e.b.types_consts, isa_spirv.OP_VARIABLE, ?vop[0], 3);
    emit_memory.decorate(e, var_id, isa_spirv.DECOR_BUILTIN, isa_spirv.BUILTIN_LOCAL_INVOCATION_INDEX);
    e.zero_lid = var_id;
    ret var_id;
}

# the prologue of a compute stage that zeroes the `#[shared]` memory it reaches:
# invocation i of a workgroup of w stores zero to the elements i, i + w, ... of each
# array and invocation 0 to each whole value, then one workgroup barrier makes the
# stores visible. it precedes all user code, so every invocation reaches the barrier
fun shared_zeroing_emit(e: *emitter.Emit, fx: u32, irfn: *me_ir.Function, first: u32, next: u32) err[fail.Fail] {
    var lty: u32 = 0;
    val lid: u32 = zero_lid(e, ?lty);
    val idx: u32 = isa_spirv.alloc_id(e.b);
    emitter.words_emit(e, isa_spirv.OP_LOAD, lty, idx, lid, 0, 3);
    val sr: res[u32, fail.Fail] = workgroup_invocations(e, irfn);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val step: u32 = sr.ok;

    var pred: u32 = first;
    var gx:   u32 = 0;
    for (gx < e.gl_len) {
        val g: *me_ir.Global = emit_global.ir_of(e, gx);
        if (g.iface != me_ir.IFACE_SHARED || e.gslot[gx] == 0 || shared_zeroed_natively(e, gx) || !emit_interface.uses_iface(e, fx, e.gslot[gx] - 1)) {
            gx = gx + 1;
            cnt;
        }
        var count:   u32                  = 1;
        var elem_ty: u32                  = e.gtype_ids[gx];
        var indexed: bool                 = false;
        val gt:      *ir_type.IrTypeTable = emit_global.types_of(e, gx);
        val to:      opt[*ir_type.IrType] = ir_type.get(gt, g.ty);
        if (sel to.some) {
            val t: *ir_type.IrType = to.some;
            if (t.kind == ir_type.IRT_ARRAY && t.data.array_.count > 0) {
                count   = t.data.array_.count;
                elem_ty = emit_layout.member_spv_type(e, gt, t.data.array_.element);
                indexed = true;
            }
        }
        if (elem_ty == 0) {
            ret emitter.unsupported(e, "unsupported `#[shared]` variable type in the SPIR-V target");
        }
        pred = zero_loop_emit(e, pred, e.gvar_ids[gx], elem_ty, indexed, count, idx, step);
        gx   = gx + 1;
    }

    val wg:  u32 = types.const_int(e.tt, 32, isa_spirv.SCOPE_WORKGROUP::i64);
    val sem: u32 = types.const_int(e.tt, 32,
        (isa_spirv.SEMANTICS_ACQUIRE_RELEASE | isa_spirv.SEMANTICS_WORKGROUP_MEMORY)::i64);
    emitter.words_emit(e, isa_spirv.OP_CONTROL_BARRIER, wg, wg, sem, 0, 3);
    branch_emit(e, next);
    if (e.b.err) { ret err[fail.Fail].err{fail.message("spirv.emit: module builder hit an allocation error")}; }
    ret err[fail.Fail].ok{};
}

# the id of the stage's invocation count per workgroup: a constant, or where a
# `#[spec]` var sizes a dimension the product the specialized size gives
fun workgroup_invocations(e: *emitter.Emit, irfn: *me_ir.Function) res[u32, fail.Fail] {
    if (!emit_interface.wg_is_spec(irfn)) {
        ret res[u32, fail.Fail].ok{types.const_int(e.tt, 32, (irfn.wg_x * irfn.wg_y * irfn.wg_z)::i64)};
    }
    val u32t: u32 = types.type_int(e.tt, 32);
    var n:    u32 = 0;
    var d:    u32 = 0;
    for (d < 3) {
        val r: res[u32, fail.Fail] = emit_interface.wg_dim_id(e, irfn, d);
        if (sel r.err) { ret r; }
        if (d == 0)    { n = r.ok; }
        or             { n = emitter.pair_emit(e, isa_spirv.OP_I_MUL, u32t, n, r.ok); }
        d = d + 1;
    }
    ret res[u32, fail.Fail].ok{n};
}

# for (j = idx; j < count; j += step) var[j] = null, or the whole variable when
# not indexed; returns the merge block, where the code after it continues
fun zero_loop_emit(e: *emitter.Emit, pred: u32, var_id: u32, elem_ty: u32, indexed: bool,
    count: u32, idx: u32, step: u32) u32 {
    val u32t:   u32 = types.type_int(e.tt, 32);
    val header: u32 = isa_spirv.alloc_id(e.b);
    val body:   u32 = isa_spirv.alloc_id(e.b);
    val cont:   u32 = isa_spirv.alloc_id(e.b);
    val merge:  u32 = isa_spirv.alloc_id(e.b);
    val j:      u32 = isa_spirv.alloc_id(e.b);
    val jn:     u32 = isa_spirv.alloc_id(e.b);
    branch_emit(e, header);

    emitter.label_emit(e, header);
    var phi: [6]u32;
    phi[0] = u32t;
    phi[1] = j;
    phi[2] = idx;
    phi[3] = pred;
    phi[4] = jn;
    phi[5] = cont;
    isa_spirv.inst(e.b, ?e.b.functions, isa_spirv.OP_PHI, ?phi[0], 6);
    val more: u32 = emitter.pair_emit(e, isa_spirv.OP_U_LESS_THAN, types.type_bool(e.tt), j,
        types.const_int(e.tt, 32, count::i64));
    emitter.words_emit(e, isa_spirv.OP_LOOP_MERGE, merge, cont, isa_spirv.LOOP_CONTROL_NONE, 0, 3);
    emitter.words_emit(e, isa_spirv.OP_BRANCH_CONDITIONAL, more, body, merge, 0, 3);

    emitter.label_emit(e, body);
    var ptr: u32 = var_id;
    if (indexed) {
        ptr = isa_spirv.alloc_id(e.b);
        emitter.words_emit(e, isa_spirv.OP_ACCESS_CHAIN, types.type_ptr(e.tt, isa_spirv.STORAGE_WORKGROUP, elem_ty), ptr, var_id, j, 4);
        emit_memory.chain_memory_scope(e, ptr, var_id);
    }
    emit_memory.memory_store(e, ptr, emit_memory.zero_value(e, elem_ty), 0);
    branch_emit(e, cont);

    emitter.label_emit(e, cont);
    emitter.words_emit(e, isa_spirv.OP_I_ADD, u32t, jn, j, step, 4);
    branch_emit(e, header);

    emitter.label_emit(e, merge);
    ret merge;
}

fun entry_lists(e: *emitter.Emit, fn_ix: u32, gx: u32) bool {
    if (e.gslot[gx] == 0 || !emit_interface.uses_iface(e, fn_ix, e.gslot[gx] - 1)) { ret false; }
    ret isa_spirv.entry_interface_lists(e.b.version, e.gstorage[gx]);
}

fun linkage_export_emit(e: *emitter.Emit, fn: u32, name: str) {
    val sw_r: res[u32, fail.Fail] = isa_spirv.string_words(name);
    if (sel sw_r.err) {
        e.b.err = true;
        ret;
    }
    val sw:    u32                = sw_r.ok;
    val total: u32                = 3 + sw;
    val ra:    res[*u32, A.Error] = A.allocate[u32](e.alloc, total::usize);
    if (sel ra.err) {
        e.b.err = true;
        ret;
    }
    val ops: *u32 = ra.ok;
    ops[0] = fn;
    ops[1] = isa_spirv.DECOR_LINKAGE_ATTRIBUTES;
    isa_spirv.pack_string(name, sw, ?ops[2]);
    ops[2 + sw] = isa_spirv.LINKAGE_EXPORT;
    isa_spirv.inst(e.b, ?e.b.decorations, isa_spirv.OP_DECORATE, ops, total);
    A.deallocate[u32](e.alloc, ops, total::usize);
}
