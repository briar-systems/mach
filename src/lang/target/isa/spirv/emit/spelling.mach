# a type spelled as source text for the diagnostics that name it
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std_format: std.format;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.growth;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.target.isa.spirv.emit.emitter;
use mach.lang.target.isa.spirv.types;

# a type's spelling as it is built: its bytes, and the first failure a
# spelling met, which type_text returns
pub rec TypeText {
    alloc:   *A.Allocator;
    buf:     *u8;
    len:     usize;
    cap:     usize;
    failed:  bool;
    failure: fail.Fail;
}

val TYPE_TEXT_DEPTH: u32 = 6;

fun text_fail(out: *TypeText, f: fail.Fail) {
    if (out.failed) { ret; }
    out.failed  = true;
    out.failure = f;
}

fun text_byte(out: *TypeText, c: u8) {
    if (out.failed) { ret; }
    val grown: err[A.Error] = growth.reserve_usize[u8](out.alloc, ?out.buf, ?out.cap, out.len + 1);
    if (sel grown.err) {
        text_fail(out, fail.refused(grown.err));
        ret;
    }
    out.buf[out.len] = c;
    out.len          = out.len + 1;
}

fun text_put(out: *TypeText, s: str) {
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        text_byte(out, s[i]);
        i = i + 1;
    }
}

fun text_put_u32(out: *TypeText, n: u32) {
    var digits: [std_format.DECIMAL_MAX]u8;
    val len:    usize = std_format.put_u64(?digits[0], n::u64);
    var k:      usize = 0;
    for (k < len) {
        text_byte(out, digits[k]);
        k = k + 1;
    }
}

pub fun text_dnit(out: *TypeText) {
    if (out.buf != nil && out.cap > 0) { A.deallocate[u8](out.alloc, out.buf, out.cap); }
    out.buf = nil;
    out.cap = 0;
    out.len = 0;
}

fun spell_members(e: *emitter.Emit, tys: *ir_type.IrTypeTable, out: *TypeText, members: *ir_type.IrTypeId, count: u32, depth: u32) {
    var i: u32 = 0;
    for (i < count) {
        if (i > 0) { text_put(out, ", "); }
        spell_type(e, tys, out, members[i], depth + 1);
        i = i + 1;
    }
}

# a source-shaped spelling of an IR type for a diagnostic, bounded in depth
fun spell_type(e: *emitter.Emit, tys: *ir_type.IrTypeTable, out: *TypeText, id: ir_type.IrTypeId, depth: u32) {
    if (depth > TYPE_TEXT_DEPTH) {
        text_put(out, "...");
        ret;
    }
    val opt_: opt[*ir_type.IrType] = ir_type.get(tys, id);
    if (sel opt_.none) {
        text_fail(out, fail.message("spirv.emit: a diagnostic spells a type its module does not define"));
        ret;
    }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind == ir_type.IRT_VOID) {
        text_put(out, "void");
        ret;
    }
    if (t.kind == ir_type.IRT_INT) {
        text_put(out, "i");
        text_put_u32(out, t.data.bits);
        ret;
    }
    if (t.kind == ir_type.IRT_FLOAT) {
        text_put(out, "f");
        text_put_u32(out, t.data.bits);
        ret;
    }
    if (t.kind == ir_type.IRT_HANDLE) {
        text_put(out, "handle");
        ret;
    }
    if (t.kind == ir_type.IRT_VECTOR) {
        spell_type(e, tys, out, t.data.vector_.element, depth + 1);
        text_put(out, "x");
        text_put_u32(out, t.data.vector_.lanes);
        ret;
    }
    if (t.kind == ir_type.IRT_ARRAY) {
        text_put(out, "[");
        text_put_u32(out, t.data.array_.count);
        text_put(out, "]");
        spell_type(e, tys, out, t.data.array_.element, depth + 1);
        ret;
    }
    if (t.kind == ir_type.IRT_PTR) {
        text_put(out, "*");
        if (!ir_type.is_nil(t.data.pointee)) { spell_type(e, tys, out, t.data.pointee, depth + 1); }
        ret;
    }
    # a record a cycle reaches, named rather than spelled out again
    if (t.kind == ir_type.IRT_RECREF) {
        text_put(out, "rec{...}");
        ret;
    }
    if (t.kind == ir_type.IRT_FN) {
        text_put(out, "fun(");
        spell_members(e, tys, out, t.data.fn.params, t.data.fn.param_count, depth);
        if (t.data.fn.variadic) { text_put(out, ", ..."); }
        text_put(out, ")");
        val rt: opt[*ir_type.IrType] = ir_type.get(tys, t.data.fn.ret_type);
        if (sel rt.some && rt.some.kind != ir_type.IRT_VOID) {
            text_put(out, " ");
            spell_type(e, tys, out, t.data.fn.ret_type, depth + 1);
        }
        ret;
    }
    if (t.kind == ir_type.IRT_TAG) {
        text_put(out, "tag: i");
        text_put_u32(out, t.data.tag_.disc_bytes * 8);
        text_put(out, "{");
        var ci: u32 = 0;
        for (ci < t.data.tag_.case_count) {
            if (ci > 0)                                     { text_put(out, ", "); }
            if (!ir_type.tag_case_has_payload(tys, id, ci)) { text_put(out, "_"); }
            or                                              { spell_type(e, tys, out, t.data.tag_.cases[ci], depth + 1); }
            ci = ci + 1;
        }
        text_put(out, "}");
        ret;
    }
    if (t.kind == ir_type.IRT_STRUCT) { text_put(out, "rec{"); }
    or (t.kind == ir_type.IRT_UNION)  { text_put(out, "uni{"); }
    or {
        text_fail(out, fail.message("spirv.emit: a diagnostic spells a type of a kind it has no spelling for"));
        ret;
    }
    spell_members(e, tys, out, t.data.struct_.fields, t.data.struct_.field_count, depth);
    text_put(out, "}");
}

# the spelling of `id`, held in `out` until text_dnit
pub fun type_text(e: *emitter.Emit, out: *TypeText, id: ir_type.IrTypeId) res[str, fail.Fail] {
    out.alloc  = e.alloc;
    out.buf    = nil;
    out.len    = 0;
    out.cap    = 0;
    out.failed = false;
    spell_type(e, ?e.ir.types, out, id, 0);
    text_byte(out, 0);
    if (out.failed) { ret res[str, fail.Fail].err{out.failure}; }
    ret res[str, fail.Fail].ok{?out.buf[0]};
}

pub fun type_refusal_reason(e: *emitter.Emit, id: ir_type.IrTypeId) res[str, fail.Fail] {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?e.ir.types, id);
    if (sel opt_.none) { ret res[str, fail.Fail].err{fail.message("spirv.emit: a parameter names a type its module does not define")}; }
    val k: ir_type.IrTypeKind = opt_.some.kind;
    if (k == ir_type.IRT_FN)                               { ret res[str, fail.Fail].ok{"logical addressing has no function pointers, so a function value cannot cross a call"}; }
    if (k == ir_type.IRT_UNION)                            { ret res[str, fail.Fail].ok{"SPIR-V has no untyped union, so a raw union has no type to declare"}; }
    if (k == ir_type.IRT_PTR)                              { ret res[str, fail.Fail].ok{"a logical reference must name a Function-storage object whose type SPIR-V can declare, and may not itself contain a reference"}; }
    if (k == ir_type.IRT_STRUCT || k == ir_type.IRT_ARRAY) { ret res[str, fail.Fail].ok{"a member of this composite has no SPIR-V type"}; }
    if (k == ir_type.IRT_TAG) {
        if (opt_.some.data.tag_.case_count + 1 > types.MAX_STRUCT_MEMBERS) {
            ret res[str, fail.Fail].ok{"a tag's SPIR-V composite holds its discriminator and one member per case, and a composite may have at most 16 members, so a tag on this target may declare at most 15 cases"};
        }
        ret res[str, fail.Fail].ok{"a case payload of this tag has no SPIR-V type"};
    }
    ret res[str, fail.Fail].ok{"this type has no SPIR-V form"};
}
