# the module's global table: which IR globals the module holds and how each is reached
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.page;
use collections_vector: std.collections.vector;
use std_format: std.format;

use A: std.allocator;

use lang_checked: mach.lang.checked;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.float;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.layout;
use me_ir:   mach.lang.me.ir;
use ir_id:   mach.lang.me.ir.id;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_mir:          mach.lang.mir;
use mir_debug:         mach.lang.mir.debug;
use mir_structure:     mach.lang.mir.structure;
use mir_unit:          mach.lang.mir.unit;
use lang_source:       mach.lang.source;
use target_definition: mach.lang.target.definition;
use mach.lang.target.extension;
use extension_spirv: mach.lang.target.extension.spirv;
use mach.lang.target.isa;
use isa_spirv: mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.debug;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.ops;
use mach.lang.target.isa.spirv.types;
use target_model: mach.lang.target.model;
use model_spirv:  mach.lang.target.model.spirv;
use target_of:    mach.lang.target.of;
use mach.lang.textbuild;
use emitter: mach.lang.target.isa.spirv.emit.emitter;

pub fun build_gl_table(e: *emitter.Emit) err[fail.Fail] {
    var n:  u32 = 0;
    var i0: u32 = 0;
    for (i0 < e.root.global_len) {
        if (gl_eligible(?e.root.globals[i0])) { n = n + 1; }
        i0 = i0 + 1;
    }
    var mi: u32 = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) {
            mi = mi + 1;
            cnt;
        }
        val m: *me_ir.Module = e.u.mods[mi].ir;
        var i: u32           = 0;
        for (i < m.global_len) {
            if (gl_eligible(?m.globals[i]) && global_is_reached(e, m.globals[i].name)) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*emitter.GlobalEnt, A.Error] = A.allocate[emitter.GlobalEnt](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.gls    = rt.ok;
    e.gl_len = n;

    var k:  u32 = 0;
    var i2: u32 = 0;
    for (i2 < e.root.global_len) {
        if (!gl_eligible(?e.root.globals[i2])) {
            i2 = i2 + 1;
            cnt;
        }
        e.gls[k].mi    = e.u.root;
        e.gls[k].ir_ix = i2;
        e.gls[k].name  = e.root.globals[i2].name;
        k              = k + 1;
        i2             = i2 + 1;
    }
    mi = 0;
    for (mi < e.u.len) {
        if (mi == e.u.root) {
            mi = mi + 1;
            cnt;
        }
        val m: *me_ir.Module = e.u.mods[mi].ir;
        var i: u32           = 0;
        for (i < m.global_len) {
            if (!gl_eligible(?m.globals[i]) || !global_is_reached(e, m.globals[i].name)) {
                i = i + 1;
                cnt;
            }
            e.gls[k].mi    = mi;
            e.gls[k].ir_ix = i;
            e.gls[k].name  = m.globals[i].name;
            k              = k + 1;
            i              = i + 1;
        }
        mi = mi + 1;
    }
    ret err[fail.Fail].ok{};
}

pub val ACCESS_WRITE: u8 = 1;

pub fun gl_written(e: *emitter.Emit, ix: u32) bool {
    if (e.gaccess == nil || ix >= e.gl_len) { ret true; }
    ret (e.gaccess[ix] & ACCESS_WRITE) != 0;
}

fun global_is_reached(e: *emitter.Emit, name: intern.StrId) bool {
    var fx: u32 = 0;
    for (fx < e.fn_len) {
        if (!e.fns[fx].emit) {
            fx = fx + 1;
            cnt;
        }
        val fn: *me_ir.Function = emitter.fn_ir(e, fx);
        if (intern.str_same(fn.wg_spec[0], name) || intern.str_same(fn.wg_spec[1], name) || intern.str_same(fn.wg_spec[2], name)) { ret true; }
        val mf: *lang_mir.MirFunction = emitter.fn_mir(e, fx);
        if (mf == nil) {
            fx = fx + 1;
            cnt;
        }
        var bi: u32 = 0;
        for (bi < mf.block_count) {
            val blk: *lang_mir.MirBlock = ?mf.blocks[bi];
            var ii:  u32                = 0;
            for (ii < blk.instr_count) {
                val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
                var oi: u32                = 0;
                for (oi < mi.operand_count) {
                    if (mi.operands[oi].kind == lang_mir.MIR_OP_SYM
                        && intern.str_same(mi.operands[oi].sym, name)) { ret true; }
                    oi = oi + 1;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        fx = fx + 1;
    }
    ret false;
}

fun gl_eligible(g: *me_ir.Global) bool {
    ret !g.is_extern && !g.is_import;
}

pub fun gl_ir(e: *emitter.Emit, ix: u32) *me_ir.Global {
    ret ?e.u.mods[e.gls[ix].mi].ir.globals[e.gls[ix].ir_ix];
}

pub fun gl_types(e: *emitter.Emit, ix: u32) *ir_type.IrTypeTable {
    ret ?e.u.mods[e.gls[ix].mi].ir.types;
}

pub fun gl_lookup(e: *emitter.Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.gl_len) {
        if (intern.str_same(e.gls[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret GL_NONE;
}

# ", declared in `module`" for a variable outside the root module, empty in it
pub fun gl_mod_prefix(e: *emitter.Emit, ix: u32) res[str, fail.Fail] {
    if (ix >= e.gl_len || e.gls[ix].mi == e.u.root) { ret res[str, fail.Fail].ok{""}; }
    ret fail.format(e.alloc, ", declared in `{}`", intern.text(e.interner, e.u.mods[e.gls[ix].mi].ir.name));
}

pub fun gl_spelling(e: *emitter.Emit, ix: u32) str {
    val g: *me_ir.Global = gl_ir(e, ix);
    var n: intern.StrId  = g.disp;
    if (intern.str_is_nil(n)) { n = g.name; }
    ret intern.text(e.interner, n);
}

pub fun global_var_id(e: *emitter.Emit, name: intern.StrId) u32 {
    if (e.gvar_ids == nil) { ret 0; }
    val gx: u32 = gl_lookup(e, name);
    if (gx == GL_NONE) { ret 0; }
    ret e.gvar_ids[gx];
}

pub val GL_NONE: u32 = mir_unit.UNIT_NONE;
