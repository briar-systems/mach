# the version, capabilities and extensions a module requires, checked against
# the target's environment and written in the module's preamble
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use std_format: std.format;

use diagnostic_kind:   mach.lang.diagnostic.kind;
use lang_mir:          mach.lang.mir;
use lang_source:       mach.lang.source;
use target_definition: mach.lang.target.definition;
use mach.lang.target.extension;
use isa_environment: mach.lang.target.isa.environment;
use isa_spirv:       mach.lang.target.isa.spirv;
use emit_builtin:    mach.lang.target.isa.spirv.emit.builtin;
use mach.lang.target.isa.spirv.emit.emitter;
use emit_global: mach.lang.target.isa.spirv.emit.global;
use mach.lang.target.isa.spirv.types;

# the environment pins the version before anything is emitted, since which forms a
# module may use depends on it
pub fun select_version(e: *emitter.Emit) err[fail.Fail] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa_environment.NONE) { ret err[fail.Fail].ok{}; }
    val profile: *isa_spirv.EnvProfile = isa_spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret err[fail.Fail].err{fail.message("spirv: the target names an environment this backend has no profile for")}; }
    e.b.version = profile.version;
    if (e.vulkan_mm && e.b.version < isa_spirv.SPV_VERSION_1_3) {
        val r: res[str, std_format.FormatError] = std_format.sprint(e.alloc,
            "the target selects the `vulkan_memory_model` extension, and the Vulkan memory model is defined from SPIR-V 1.3, where SPV_KHR_vulkan_memory_model brings it, while the `{}` environment selects SPIR-V {}.{}: raise `env` to `{}` or later, or leave the extension out for the GLSL450 model",
            profile.name, isa_spirv.version_major(e.b.version), isa_spirv.version_minor(e.b.version), isa_spirv.env_name_from(isa_spirv.SPV_VERSION_1_3));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{emitter.reject_module(e, diagnostic_kind.SPIRV_CAPABILITY, r.ok)};
    }
    ret err[fail.Fail].ok{};
}

pub fun check_environment(e: *emitter.Emit) err[fail.Fail] {
    val env_id: u32 = e.tgt.identity.env_id;
    if (env_id == isa_environment.NONE) { ret err[fail.Fail].ok{}; }
    val profile: *isa_spirv.EnvProfile = isa_spirv.env_profile(e.tgt.identity.env_profile);
    if (profile == nil) { ret err[fail.Fail].err{fail.message("spirv: the target names an environment this backend has no profile for")}; }
    val excess: u64 = e.b.caps_needed & isa_spirv.CEILING_DOMAIN & ~profile.ceiling;
    if (excess != 0) {
        var bit: u64 = 1;
        for ((excess & bit) == 0) { bit = bit << 1; }
        val msg: res[str, std_format.FormatError] = std_format.sprint(e.alloc,
            "this module needs the {} capability, which the `{}` environment does not admit; raise `env` on the target or avoid the type that needs it",
            isa_spirv.need_name(bit), profile.name);
        if (sel msg.err) { ret err[fail.Fail].err{fail.format_refused(msg.err)}; }
        ret err[fail.Fail].err{emitter.reject_at(e, diagnostic_kind.SPIRV_CAPABILITY, types.need_loc(e.tt, bit), msg.ok)};
    }
    ret check_type_features(e, profile);
}

# a type's capability the ceiling admits still needs its device feature, which no
# Vulkan version guarantees. a narrow integer in a function never reaches
# here without it, since it is carried at 32 bits; what does is a width nothing
# carries: a member, memory the host shares, or a 64-bit type
fun check_type_features(e: *emitter.Emit, profile: *isa_spirv.EnvProfile) err[fail.Fail] {
    var i: u32 = 0;
    for (i < isa_spirv.CAPABILITY_COUNT) {
        val c: *isa_spirv.Capability = ?isa_spirv.CAPABILITIES[i];
        if ((e.b.caps_needed & c.need) != 0 && (c.feature & ~e.tgt.model.extensions) != 0) {
            val name: str                              = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, c.feature);
            val msg:  res[str, std_format.FormatError] = std_format.sprint(e.alloc,
                "this module needs the {} capability, which the `{}` environment admits but leaves to a device feature: name `{}` in the target's `extensions` once the consumer enables the feature, or avoid the type that needs it",
                c.name, profile.name, name);
            if (sel msg.err) { ret err[fail.Fail].err{fail.format_refused(msg.err)}; }
            ret err[fail.Fail].err{emitter.reject_at(e, diagnostic_kind.SPIRV_CAPABILITY, types.need_loc(e.tt, e.b.caps_needed & c.need), msg.ok)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the one path a requirement takes, whatever raised it: an instruction row, a literal's
# value, or an operand's type (such as a 64-bit atomic's Int64Atomics). `what` names the
# use in a refusal. the extensions must be selected and the capability's SPIR-V version
# reached, and the capability is then declared, with the SPIR-V extension defining it
pub fun require(e: *emitter.Emit, mf: *lang_mir.MirFunction, capability: u32, requires: u64, what: str) err[fail.Fail] {
    ret require_at(e, lang_mir.refusal_loc(mf, e.cur_instr), e.cur_stages, capability, requires, what);
}

# `require` naming the use by a made text, or the failure that refused to make it
pub fun require_made(e: *emitter.Emit, mf: *lang_mir.MirFunction, capability: u32, requires: u64, made: res[str, fail.Fail]) err[fail.Fail] {
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    ret require(e, mf, capability, requires, made.ok);
}

pub fun require_at_made(e: *emitter.Emit, loc: lang_source.Location, stages: u8, capability: u32, requires: u64, made: res[str, fail.Fail]) err[fail.Fail] {
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    ret require_at(e, loc, stages, capability, requires, made.ok);
}

# `stages` are the stages the use is reached from, which a capability guaranteed only in
# compute holds to its `graphics` extension
pub fun require_at(e: *emitter.Emit, loc: lang_source.Location, stages: u8, capability: u32, requires: u64, what: str) err[fail.Fail] {
    val missing: u64 = requires & ~e.tgt.model.extensions;
    if (missing != 0) {
        val name: str                              = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, missing);
        val r:    res[str, std_format.FormatError] = std_format.sprint(e.alloc,
            "{} needs the `{}` extension, a device feature the target does not select: name it in the target's `extensions` once the consumer enables the feature",
            what, name);
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{emitter.reject_at(e, diagnostic_kind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    if (capability == target_definition.NO_OP_CAPABILITY) { ret err[fail.Fail].ok{}; }
    val c: *isa_spirv.Capability = isa_spirv.capability_of(capability);
    if (c == nil) { ret emitter.defect(e, "spirv.emit: a requirement names a capability the capability table does not carry"); }
    if (e.b.version < c.min_version) {
        val r: res[str, std_format.FormatError] = std_format.sprint(e.alloc,
            "{} needs the {} capability, which SPIR-V defines from {}.{}, and the `{}` environment selects SPIR-V {}.{}: raise `env` to `{}` or later",
            what, c.name, isa_spirv.version_major(c.min_version), isa_spirv.version_minor(c.min_version),
            isa_spirv.env_profile_name(e.tgt.identity.env_profile), isa_spirv.version_major(e.b.version),
            isa_spirv.version_minor(e.b.version), isa_spirv.env_name_from(c.min_version));
        if (sel r.err) { ret err[fail.Fail].err{fail.format_refused(r.err)}; }
        ret err[fail.Fail].err{emitter.reject_at(e, diagnostic_kind.SPIRV_CAPABILITY, loc, r.ok)};
    }
    val graphics: u8 = stages & emit_builtin.STAGES_GRAPHICS;
    if (c.graphics != 0 && graphics != 0 && (c.graphics & ~e.tgt.model.extensions) != 0) {
        val name:  str                 = extension.first_name(e.tgt.model.extension_table, e.tgt.model.extension_count, c.graphics);
        val reach: res[str, fail.Fail] = emit_builtin.stages_spelling(e, graphics);
        if (sel reach.err) { ret err[fail.Fail].err{reach.err}; }
        ret err[fail.Fail].err{emitter.reject_made_at(e, diagnostic_kind.SPIRV_CAPABILITY, loc, fail.format(e.alloc,
            "{} is reached from a {} stage, and Vulkan guarantees the {} capability only in compute stages: a use from another stage needs the `{}` extension, named in the target's `extensions` once the consumer's device supports the stage",
            what, reach.ok, c.name, name))};
    }
    types.raise_at(e.tt, c.need, loc);
    ret err[fail.Fail].ok{};
}

# "the `#[builtin(\"subgroup_size\")]` variable", for a requirement the declaration raises
pub fun builtin_decl_text(e: *emitter.Emit, gi: u32) res[str, fail.Fail] {
    val where: res[str, fail.Fail] = emit_global.mod_prefix(e, gi);
    if (sel where.err) { ret where; }
    ret fail.format(e.alloc, "the `#[builtin(\"{}\")]` variable{}", emit_builtin.spelling_of(emit_global.ir_of(e, gi).iface_a), where.ok);
}

# the same, used by the stage `fx`
pub fun builtin_use_text(e: *emitter.Emit, fx: u32, gi: u32) res[str, fail.Fail] {
    val decl: res[str, fail.Fail] = builtin_decl_text(e, gi);
    if (sel decl.err) { ret decl; }
    val user: res[str, fail.Fail] = emitter.ir_fn_spelling(e, fx);
    if (sel user.err) { ret user; }
    ret fail.format(e.alloc, "{} used by `{}`", decl.ok, user.ok);
}

# the capabilities in the table's order, then each SPIR-V extension one of them needs, once
pub fun preamble_emit(e: *emitter.Emit) {
    cap_emit(e, isa_spirv.CAP_SHADER);
    if (!e.has_entry) { cap_emit(e, isa_spirv.CAP_LINKAGE); }
    if (e.vulkan_mm)  { e.b.caps_needed = e.b.caps_needed | isa_spirv.NEED_VULKAN_MEMORY_MODEL; }
    val need: u64 = e.b.caps_needed;
    var i:    u32 = 0;
    for (i < isa_spirv.CAPABILITY_COUNT) {
        if ((need & isa_spirv.CAPABILITIES[i].need) != 0) { cap_emit(e, isa_spirv.CAPABILITIES[i].word); }
        i = i + 1;
    }
    i = 0;
    for (i < isa_spirv.CAPABILITY_COUNT) {
        val ext: str = isa_spirv.CAPABILITIES[i].extension;
        if ((need & isa_spirv.CAPABILITIES[i].need) != 0 && extension_needed(e, i) && !extension_declared_before(e, need, i, ext)) {
            isa_spirv.inst_string(e.b, ?e.b.extensions, isa_spirv.OP_EXTENSION, nil, 0, ext);
        }
        i = i + 1;
    }
    var mm: [2]u32;
    mm[0] = isa_spirv.ADDRESSING_LOGICAL;
    mm[1] = isa_spirv.MEMORY_GLSL450;
    # a module holding a physical pointer addresses PhysicalStorageBuffer64, which every
    # logical storage class keeps its logical rules under
    if ((need & isa_spirv.NEED_PHYSICAL_STORAGE_BUFFER) != 0) {
        mm[0] = isa_spirv.ADDRESSING_PHYSICAL_STORAGE_BUFFER_64;
        if (e.b.version < isa_spirv.SPV_VERSION_1_5) {
            isa_spirv.inst_string(e.b, ?e.b.extensions, isa_spirv.OP_EXTENSION, nil, 0, isa_spirv.SPV_KHR_PHYSICAL_STORAGE_BUFFER);
        }
    }
    if (e.vulkan_mm) {
        mm[1] = isa_spirv.MEMORY_VULKAN;
        if (e.b.version < isa_spirv.SPV_VERSION_1_5) {
            isa_spirv.inst_string(e.b, ?e.b.extensions, isa_spirv.OP_EXTENSION, nil, 0, isa_spirv.SPV_KHR_VULKAN_MEMORY_MODEL);
        }
    }
    isa_spirv.inst(e.b, ?e.b.memory_model, isa_spirv.OP_MEMORY_MODEL, ?mm[0], 2);
}

# the table row `i` names an extension the module's version has not taken into the core
fun extension_needed(e: *emitter.Emit, i: u32) bool {
    val c: *isa_spirv.Capability = ?isa_spirv.CAPABILITIES[i];
    ret c.extension != nil && (c.ext_core == 0 || e.b.version < c.ext_core);
}

fun extension_declared_before(e: *emitter.Emit, need: u64, upto: u32, ext: str) bool {
    var i: u32 = 0;
    for (i < upto) {
        if ((need & isa_spirv.CAPABILITIES[i].need) != 0 && extension_needed(e, i) && str_equals(isa_spirv.CAPABILITIES[i].extension, ext)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun cap_emit(e: *emitter.Emit, cap: u32) {
    var o: [1]u32;
    o[0] = cap;
    isa_spirv.inst(e.b, ?e.b.caps, isa_spirv.OP_CAPABILITY, ?o[0], 1);
}
