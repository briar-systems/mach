# the state one module's emission threads through every phase, the refusals
# it reports, and the word writers every phase uses
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use mach.lang.layout;
use me_ir:       mach.lang.me.ir;
use ir_type:     mach.lang.me.ir.type;
use lang_mir:    mach.lang.mir;
use mir_unit:    mach.lang.mir.unit;
use lang_source: mach.lang.source;
use mach.lang.target.isa;
use isa_spirv: mach.lang.target.isa.spirv;
use mach.lang.target.isa.spirv.debug;
use mach.lang.target.isa.spirv.defs;
use mach.lang.target.isa.spirv.ops;
use mach.lang.target.isa.spirv.types;

pub rec Emit {
    alloc:     *A.Allocator;
    interner:  *intern.Interner;
    tgt:       *isa.BackendTarget;
    layout:    layout.Machine;
    u:         *mir_unit.Unit;
    root:      *me_ir.Module;
    ir:        *me_ir.Module;
    cur_mi:    u32;
    b:         *isa_spirv.Builder;
    tt:        *types.TypeTable;
    fns:       *FnEnt;
    fn_len:    u32;
    has_entry: bool;
    gls:       *GlobalEnt;
    gl_len:    u32;
    gvar_ids:  *u32;
    gtype_ids: *u32;
    gstorage:  *u32;
    iface_len: u32;
    gslot:     *u32;
    iface_use: *u8;
    # the LocalInvocationIndex variable the emitter adds for the zeroing of `#[shared]`
    # memory when no global declares one, 0 until a stage needs it
    zero_lid: u32;

    # what each reached global's memory may undergo, as ACCESS_* bits
    gaccess: *u8;
    # what each function does through each of its parameters, as ACCESS_* bits,
    # function fx's parameter k at pacc[pbase[fx] + k]
    pacc:     *u8;
    pbase:    *u32;
    pacc_len: u32;
    # the root of the handle each function returns: a global, a parameter's origin,
    # GL_NONE while none is seen, ORIGIN_UNKNOWN once two meet, or ORIGIN_UNROOTED
    # once one names no binding
    rsum:     *u32;
    sum_grew: bool;
    # the root of a pointer each function returns, which the refusal of the result names
    rptr: *u32;
    # the OpSpecConstant id of each `#[spec]` global, 0 for any other
    gspec: *u32;
    # the module sizes its compute stages through one WorkgroupSize built-in
    wg_builtin: bool;
    # a stage input or output's type is being built, where an f16 is OpTypeFloat 16
    half_interface: bool;
    # the module declares the Vulkan memory model, where an access is private unless it
    # says otherwise: `pscope` is the scope each pointer id's accesses are made available
    # and visible at, by its id, 0 for a private access. a coherent storage image is
    # read and written through handles, and `coherent_images` says the module binds one
    vulkan_mm:       bool;
    pscope:          Vector[u8];
    coherent_images: bool;

    # the module holds a physical pointer, so it addresses PhysicalStorageBuffer64.
    # `palign` is the alignment each physical pointer id's accesses carry, by its id, 0 for
    # a logical pointer, and `talign` and `tsize` the alignment and extent of each type
    # physical memory holds, by its id. `pkeys` holds the explicit-layout types built for
    # physical memory, each once, and `precs` each record a cycle of pointers reaches
    physical: bool;
    palign:   Vector[u32];
    talign:   Vector[u32];
    tsize:    Vector[u32];
    pkeys:    Vector[PhysKey];
    precs:    Vector[PhysRec];
    strided:  Vector[u32];
    # a refusal a type query put on the store, which the next refusal returns in place of its own
    held:     fail.Fail;
    has_held: bool;

    ext_ids: [8]u32;

    # the copies of the emitted functions, one per way a caller binds their pointer
    # parameters, each keyed by its words in `keys`
    copies: Vector[Copy];
    keys:   Vector[u32];
    # the copy under emission, where its source parameter k lands among its
    # SPIR-V parameters, and their ids
    cur_copy:   u32;
    cur_pslot:  *u32;
    cur_params: *u32;

    srcmap: *lang_source.SourceMap;
    # the root module's diagnostic store, where a refusal of the program lands
    diags:     *diagnostic.DiagnosticStore;
    dbg:       debug.Debug;
    cur_fn:    *lang_mir.MirFunction;
    cur_instr: *lang_mir.MirInstr;
    # the stages each function is reached from, as stage_bit sets, and the set of the one
    # being emitted
    fn_stages:  *u8;
    cur_stages: u8;
}

pub rec VMaps {
    type_id:  *u32;
    var_id:   *u32;
    is_bool:  *bool;
    chain_id: *u32;
    chain_ty: *u32;
    chain_sc: *u32;
    opq_var:  *u32;
    opq_ssa:  *u32;
    # where the index ids an access chain read begin in `gep_ids`, plus one, 0 for none
    gep_at:  *u32;
    gep_ids: Vector[u32];
    # each register's pointer provenance, PROV_* bits
    prov: *u8;
    n:    u32;
}

pub rec FnEnt {
    mi:     u32;
    ir_ix:  u32;
    mir_ix: u32;
    name:   intern.StrId;
    id:     u32;
    emit:   bool;
}

pub rec GlobalEnt {
    mi:    u32;
    ir_ix: u32;
    name:  intern.StrId;
}

# one emitted OpFunction of a source function. logical addressing admits only a
# memory object declaration as a call's pointer argument, and no StorageBuffer or
# other block pointer at all, so a pointer parameter bound to a subobject or to an
# interface variable is split into the root it points into and the path from there:
# the copy names a global root itself, takes a Function-storage root whole, and
# takes the path's runtime indices as integers. its key is one binding per source
# parameter, spelled in words:
#   BIND_VALUE                                  not a pointer parameter
#   BIND_WHOLE                                  a whole Function-storage object
#   BIND_GLOBAL, global, n, step * n            a path into a global, named in the copy
#   BIND_LOCAL, module, ir type, n, step * n    a path into a Function-storage root of
#                                               that type, passed first
#   BIND_PHYSICAL                               a physical pointer, passed as the value it is
# where a step is a member ordinal, which OpAccessChain takes only as a constant, or
# STEP_RUNTIME for an array element, whose index (constant or not) is passed after the root
pub rec Copy {
    fx:      u32;
    id:      u32;
    key_at:  u32;
    key_len: u32;
}

pub val BIND_VALUE: u32 = 0;

pub val BIND_WHOLE: u32 = 1;

pub val BIND_GLOBAL: u32 = 2;

pub val BIND_LOCAL: u32 = 3;

pub val BIND_PHYSICAL: u32 = 4;

pub val STEP_RUNTIME: u32 = 0xFFFFFFFF;

pub val COPY_NONE: u32 = 0xFFFFFFFF;

# an explicit-layout type built for physical memory: a struct of `n` members at their
# offsets, or an array of `n` elements of `ids[0]` at the stride `offs[0]`
pub rec PhysKey {
    array: bool;
    n:     u32;
    ids:   [16]u32;
    offs:  [16]u32;
    id:    u32;
}

# a record a cycle of pointers reaches, by its key: the pointer to it, reserved before the
# record is declared so a member of its cycle can name it, and its explicit-layout struct
pub rec PhysRec {
    key:       u32;
    ptr:       u32;
    strct:     u32;
    building:  bool;
    forwarded: bool;
}

# the provenance of a pointer register: a logical pointer names memory the module declares,
# a physical one an address in a buffer the host passes
pub val PROV_LOGICAL: u8 = 1;

pub val PROV_PHYSICAL: u8 = 2;

# the role whose layout rules physical memory follows, beside the interface roles
pub val ROLE_PHYSICAL: u8 = 0xFE;

pub val ROOT_GLOBAL: u8 = 1;

pub val ROOT_ALLOCA: u8 = 2;

pub val ROOT_PARAM: u8 = 3;

# one step of an address: a member ordinal, or an element index that a chain of this
# function read (its result vreg and the index's position) or that this copy receives
# (the parameter and the index's slot among that parameter's runtime indices)
pub rec AddrStep {
    ord:        u32;
    from_param: bool;
    a:          u32;
    b:          u32;
}

# where a pointer argument points: its root and the steps from there
pub rec Addr {
    root:    u8;
    gix:     u32;
    vreg:    u32;
    param:   u32;
    root_mi: u32;
    root_ty: ir_type.IrTypeId;
    # the type the address points at so far, in module cur_mi's types, which says
    # whether the next step selects a member or an element
    cur_mi: u32;
    cur_ty: ir_type.IrTypeId;
    steps:  Vector[AddrStep];
}

pub fun dnit(e: *Emit) {
    if (e.fn_stages != nil && e.fn_len > 0) { A.deallocate[u8](e.alloc, e.fn_stages, e.fn_len::usize); }
    e.fn_stages = nil;
    if (e.iface_use != nil && e.fn_len > 0 && e.iface_len > 0) {
        A.deallocate[u8](e.alloc, e.iface_use, (e.fn_len * e.iface_len)::usize);
    }
    e.iface_use = nil;
    e.iface_len = 0;
    if (e.pbase != nil && e.fn_len > 0) { A.deallocate[u32](e.alloc, e.pbase, e.fn_len::usize); }
    e.pbase = nil;
    if (e.rsum != nil && e.fn_len > 0) { A.deallocate[u32](e.alloc, e.rsum, e.fn_len::usize); }
    e.rsum = nil;
    if (e.rptr != nil && e.fn_len > 0) { A.deallocate[u32](e.alloc, e.rptr, e.fn_len::usize); }
    e.rptr = nil;
    if (e.fns != nil && e.fn_len > 0) { A.deallocate[FnEnt](e.alloc, e.fns, e.fn_len::usize); }
    e.fns    = nil;
    e.fn_len = 0;
    if (e.gvar_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gvar_ids, e.gl_len::usize);
    }
    e.gvar_ids = nil;
    if (e.gslot != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gslot, e.gl_len::usize);
    }
    e.gslot = nil;
    if (e.gtype_ids != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gtype_ids, e.gl_len::usize);
    }
    e.gtype_ids = nil;
    if (e.gstorage != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gstorage, e.gl_len::usize);
    }
    e.gstorage = nil;
    if (e.gaccess != nil && e.gl_len > 0) {
        A.deallocate[u8](e.alloc, e.gaccess, e.gl_len::usize);
    }
    e.gaccess = nil;
    if (e.pacc != nil && e.pacc_len > 0) { A.deallocate[u8](e.alloc, e.pacc, e.pacc_len::usize); }
    e.pacc     = nil;
    e.pacc_len = 0;
    collections_vector.dnit[Copy](?e.copies);
    collections_vector.dnit[u32](?e.keys);
    collections_vector.dnit[u8](?e.pscope);
    collections_vector.dnit[u32](?e.palign);
    collections_vector.dnit[u32](?e.talign);
    collections_vector.dnit[u32](?e.tsize);
    collections_vector.dnit[PhysKey](?e.pkeys);
    collections_vector.dnit[PhysRec](?e.precs);
    collections_vector.dnit[u32](?e.strided);
    if (e.gspec != nil && e.gl_len > 0) {
        A.deallocate[u32](e.alloc, e.gspec, e.gl_len::usize);
    }
    e.gspec = nil;
    if (e.gls != nil && e.gl_len > 0) { A.deallocate[GlobalEnt](e.alloc, e.gls, e.gl_len::usize); }
    e.gls    = nil;
    e.gl_len = 0;
}

pub fun build_fn_table(e: *Emit) err[fail.Fail] {
    var n:  u32 = 0;
    var mi: u32 = 0;
    for (mi < e.u.len) {
        val m: *me_ir.Module = e.u.mods[mi].ir;
        var i: u32           = 0;
        for (i < m.function_len) {
            if ((m.functions[i].flags & me_ir.FN_FLAG_EXTERN) == 0) { n = n + 1; }
            i = i + 1;
        }
        mi = mi + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val rt: res[*FnEnt, A.Error] = A.allocate[FnEnt](e.alloc, n::usize);
    if (sel rt.err) { ret err[fail.Fail].err{fail.refused(rt.err)}; }
    e.fns    = rt.ok;
    e.fn_len = n;

    var k:    u32 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        mi = 0;
        for (mi < e.u.len) {
            val is_root: bool = mi == e.u.root;
            if ((pass == 0) != is_root) {
                mi = mi + 1;
                cnt;
            }
            val m: *me_ir.Module = e.u.mods[mi].ir;
            var i: u32           = 0;
            for (i < m.function_len) {
                if ((m.functions[i].flags & me_ir.FN_FLAG_EXTERN) != 0) {
                    i = i + 1;
                    cnt;
                }
                e.fns[k].mi     = mi;
                e.fns[k].ir_ix  = i;
                e.fns[k].name   = m.functions[i].name;
                e.fns[k].mir_ix = mir_unit.mir_index(e.u, mi, m.functions[i].name);
                e.fns[k].id     = 0;
                e.fns[k].emit   = false;
                k               = k + 1;
                i               = i + 1;
            }
            mi = mi + 1;
        }
        pass = pass + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun mark_emitted(e: *Emit) err[fail.Fail] {
    if (e.fn_len == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < e.fn_len) {
        if (fn_is_seed(e, i) && emittable(e, i)) { e.fns[i].emit = true; }
        i = i + 1;
    }

    var changed: bool = true;
    for (changed) {
        changed = false;
        i       = 0;
        for (i < e.fn_len) {
            if (!e.fns[i].emit) {
                i = i + 1;
                cnt;
            }
            var ci: u32 = 0;
            for (ci < callee_count(e, i)) {
                val cx: u32 = callee_at(e, i, ci);
                if (cx != FN_NONE && !e.fns[cx].emit && emittable(e, cx)) {
                    e.fns[cx].emit = true;
                    changed        = true;
                }
                ci = ci + 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    for (i < e.fn_len) {
        if (e.fns[i].emit) { e.fns[i].id = isa_spirv.alloc_id(e.b); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a function the module holds for its own sake: a stage, or with no stage any
# function of the root module, exported for a linker
pub fun fn_is_seed(e: *Emit, ix: u32) bool {
    if (e.fns[ix].mi != e.u.root) { ret false; }
    if (e.has_entry)              { ret fn_ir(e, ix).stage != me_ir.STAGE_NONE; }
    ret true;
}

pub fun emittable(e: *Emit, ix: u32) bool {
    val fn: *me_ir.Function = fn_ir(e, ix);
    if (fn.op_set != defs.SPV_SET_NONE) { ret false; }
    val mf: *lang_mir.MirFunction = fn_mir(e, ix);
    if (mf == nil || mf.block_count == 0) { ret false; }
    ret true;
}

pub fun callee_count(e: *Emit, ix: u32) u32 {
    val mf: *lang_mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret 0; }
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *lang_mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            if (blk.instrs[ii].opcode == lang_mir.MIR_VALUE_CALL) { n = n + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

pub fun callee_at(e: *Emit, ix: u32, k: u32) u32 {
    val mf: *lang_mir.MirFunction = fn_mir(e, ix);
    if (mf == nil) { ret FN_NONE; }
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < mf.block_count) {
        val blk: *lang_mir.MirBlock = ?mf.blocks[bi];
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            if (mi.opcode == lang_mir.MIR_VALUE_CALL) {
                if (n == k) {
                    if (mi.operand_count < 1 || mi.operands[0].kind != lang_mir.MIR_OP_SYM) { ret FN_NONE; }
                    ret fn_lookup(e, mi.operands[0].sym);
                }
                n = n + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret FN_NONE;
}

pub fun fn_lookup(e: *Emit, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < e.fn_len) {
        if (intern.str_same(e.fns[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret FN_NONE;
}

pub fun fn_ir(e: *Emit, ix: u32) *me_ir.Function {
    ret ?e.u.mods[e.fns[ix].mi].ir.functions[e.fns[ix].ir_ix];
}

pub fun fn_mod(e: *Emit, ix: u32) *me_ir.Module {
    ret e.u.mods[e.fns[ix].mi].ir;
}

pub fun fn_mir(e: *Emit, ix: u32) *lang_mir.MirFunction {
    if (e.fns[ix].mir_ix == FN_NONE) { ret nil; }
    ret ?e.u.mods[e.fns[ix].mi].mir.functions[e.fns[ix].mir_ix];
}

# a function's name as its author wrote it, qualified by its module outside the root
pub fun ir_fn_spelling(e: *Emit, ix: u32) res[str, fail.Fail] {
    if (ix >= e.fn_len) { ret res[str, fail.Fail].err{fail.message("spirv.emit: a function index is past the unit's functions")}; }
    val fn: *me_ir.Function = fn_ir(e, ix);
    var id: intern.StrId    = fn.disp;
    if (intern.str_is_nil(id)) { id = fn.name; }
    val name: str = intern.text(e.interner, id);
    if (e.fns[ix].mi == e.u.root) { ret res[str, fail.Fail].ok{name}; }
    ret fail.format(e.alloc, "{}.{}", intern.text(e.interner, fn_mod(e, ix).name), name);
}

pub fun words_emit(e: *Emit, opcode: u32, w0: u32, w1: u32, w2: u32, w3: u32, n: u32) {
    var ops: [4]u32;
    ops[0] = w0;
    ops[1] = w1;
    ops[2] = w2;
    ops[3] = w3;
    isa_spirv.inst(e.b, ?e.b.functions, opcode, ?ops[0], n);
}

pub fun label_emit(e: *Emit, label: u32) {
    words_emit(e, isa_spirv.OP_LABEL, label, 0, 0, 0, 1);
    debug.block(?e.dbg);
}

pub fun pair_emit(e: *Emit, opcode: u32, ty: u32, a: u32, b: u32) u32 {
    val result: u32 = isa_spirv.alloc_id(e.b);
    words_emit(e, opcode, ty, result, a, b, 4);
    ret result;
}

pub val FN_NONE: u32 = mir_unit.UNIT_NONE;

# the program asks for what this backend cannot express: an error located at
# the instruction under emission (else its function) on the module's store,
# naming the function
pub fun refuse(e: *Emit, k: diagnostic_kind.Kind, msg: str) err[fail.Fail] {
    if (e.has_held) {
        e.has_held = false;
        ret err[fail.Fail].err{e.held};
    }
    if (e.cur_fn == nil) { ret err[fail.Fail].err{reject_at(e, k, lang_source.location_nil(), msg)}; }
    val fn_name: res[str, fail.Fail] = refusal_fn_name(e);
    if (sel fn_name.err) { ret err[fail.Fail].err{fn_name.err}; }
    ret err[fail.Fail].err{reject_made_at(e, k, lang_mir.refusal_loc(e.cur_fn, e.cur_instr), fail.format(e.alloc, "{} (in `{}`)", msg, fn_name.ok))};
}

pub fun unsupported(e: *Emit, msg: str) err[fail.Fail] {
    ret refuse(e, diagnostic_kind.SPIRV_UNSUPPORTED, msg);
}

pub fun reject_at(e: *Emit, k: diagnostic_kind.Kind, loc: lang_source.Location, msg: str) fail.Fail {
    ret lang_mir.reject(e.diags, k, loc, msg);
}

# the rejection carrying a made text, or the failure that refused to make it
pub fun reject_made_at(e: *Emit, k: diagnostic_kind.Kind, loc: lang_source.Location, made: res[str, fail.Fail]) fail.Fail {
    if (sel made.err) { ret made.err; }
    ret reject_at(e, k, loc, made.ok);
}

pub fun unsupported_made(e: *Emit, made: res[str, fail.Fail]) err[fail.Fail] {
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    ret unsupported(e, made.ok);
}

# a refusal of the module or its interface, which no one instruction locates
pub fun reject_module(e: *Emit, k: diagnostic_kind.Kind, msg: str) fail.Fail {
    ret reject_at(e, k, lang_source.location_nil(), msg);
}

# an operand read's failure at the instruction that read it: a rejection is
# already on the store and passes through, a defect is named with its place
pub fun read_failure(e: *Emit, f: fail.Fail) err[fail.Fail] {
    if (sel f.reported) { ret err[fail.Fail].err{f}; }
    ret defect(e, fail.describe(f));
}

# a compiler defect met while emitting, named with its instruction and place
pub fun defect(e: *Emit, msg: str) err[fail.Fail] {
    val named: res[str, fail.Fail] = refusal_fn_name(e);
    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
    ret err[fail.Fail].err{fail.message_of(lang_mir.instr_refusal(e.alloc, e.srcmap, named.ok,
        e.cur_instr, msg))};
}

# the function under emission as a refusal names it; module scope when none is
pub fun refusal_fn_name(e: *Emit) res[str, fail.Fail] {
    if (e.cur_fn == nil) { ret res[str, fail.Fail].ok{"module scope"}; }
    val fx: u32 = fn_lookup(e, e.cur_fn.name);
    if (fx != FN_NONE) { ret ir_fn_spelling(e, fx); }
    ret res[str, fail.Fail].ok{intern.text(e.interner, e.cur_fn.name)};
}
