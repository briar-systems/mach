    spv_ops[94] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicUMax", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_U_MAX, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_INTEGER), isa.OP_RELATION_DATA, "---=");
    spv_ops[95] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicAnd", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_AND, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_INTEGER), isa.OP_RELATION_DATA, "---=");
    spv_ops[96] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicOr", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_OR, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_INTEGER), isa.OP_RELATION_DATA, "---=");
    spv_ops[97] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicXor", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_XOR, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_INTEGER), isa.OP_RELATION_DATA, "---=");
    spv_ops[98] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicFAddEXT", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_F_ADD_EXT, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_FLOAT_ADD), isa.OP_RELATION_DATA, "---=");
    spv_ops[99] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicFMinEXT", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_F_MIN_EXT, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_FLOAT_MIN_MAX), isa.OP_RELATION_DATA, "---=");
    spv_ops[100] = isa.op_related(isa.op_typed(isa.op_def_shaped(SET_CORE_NAME, "OpAtomicFMaxEXT", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_F_MAX_EXT, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "usmv"), ?ATOMIC_FLOAT_MIN_MAX), isa.OP_RELATION_DATA, "---=");

    var i: u32 = 0;
    for (i < IMAGE_ARITY) {
        spv_img_ops[i] = isa.TYPE_OPERAND_WORD;
        i              = i + 1;
    }
    spv_smp_ops[0] = SPV_CTOR_IMAGE;

    spv_types[0] = isa.type_def(CTOR_IMAGE_NAME, SPV_CTOR_IMAGE,
        ?spv_img_ops[0], IMAGE_ARITY, refuse_image);
    spv_types[0].bind       = bind_image;
    spv_types[0].sampled    = sampled_image_scalar;
    spv_types[0].components = image_components;
    spv_types[0].address    = image_address;
    spv_types[1]            = isa.type_def(CTOR_SAMPLED_IMAGE_NAME, SPV_CTOR_SAMPLED_IMAGE,
        ?spv_smp_ops[0], 1, nil);
    spv_types[1].compose   = compose_sampled_image;
    spv_types[1].texels_of = 0;
    spv_types[2]           = isa.type_def(CTOR_SAMPLER_NAME, SPV_CTOR_SAMPLER, nil, 0, nil);

    # the four texels a sample would filter, one component of each: the component a constant
    # id, then an optional Image Operands mask of offsets
    spv_ops[101] = isa.op_texel_counted(isa.op_related(isa.op_typed(isa.op_enumerated(isa.op_def_shaped(SET_CORE_NAME, "OpImageGather", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_GATHER, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "ivc|l"), 3, ?GATHER_OPERANDS), ?FIRST_OPERAND), isa.OP_RELATION_TEXEL, ""), ?GATHER_TEXEL_COUNT);
    storage.defs = isa.target_defs(spv_ops, OP_DEF_COUNT::u32, spv_types, TYPE_DEF_COUNT::u32);
    ret ?storage.defs;
}

fun refuse_image(ops: *u32, n: u32) str {
    if (n != IMAGE_ARITY) { ret nil; }

    val sampled: u32 = ops[IMAGE_OP_SAMPLED];
    if (sampled != spirv.IMAGE_SAMPLED_YES && sampled != spirv.IMAGE_SAMPLED_STORAGE) {
        ret "the `Sampled` operand is neither `1` nor `2`: `1` is an image read through a sampler and bound by `#[sampler(set, binding)]`, `2` a storage image read and written directly and bound by `#[storage(set, binding)]`. Vulkan admits no other, since `0` defers the choice to run time";
    }
    if (ops[IMAGE_OP_TEXEL] > TEXEL_U64) {
        ret "the texel-scalar operand names no scalar this target reads: an image's texels are `f32`, `i32`, `u32`, `i64` or `u64`, and a read's or a sample's result type must share the image's component type, so a word outside that set would declare an image no result type can match";
    }
    if (ops[IMAGE_OP_DEPTH] != 0) {
        ret "the `Depth` operand is not `0`, and depth-comparison sampling is out of scope: a depth image is sampled by `OpImageSampleDref*`, which takes a reference value the sampling operation here has no operand for. it is refused rather than emitted as an ordinary image, which would compile and compare nothing";
    }
    if (ops[IMAGE_OP_MS] > 1) {
        ret "the `MS` operand is neither `0` nor `1`: it is a flag, `1` a multisampled image read per sample, and a word outside that set would be written into the module verbatim as a multisampling the spec does not define";
    }
    val dim: u32 = ops[IMAGE_OP_DIM];
    if (dim > spirv.DIM_CUBE && dim != spirv.DIM_BUFFER) {
        ret "the `Dim` operand names a dimensionality this target does not bind: `Rect` is an unnormalized-coordinate image and `SubpassData` an input attachment read within a render pass. `1D`, `2D`, `3D`, `Cube` and `Buffer` are the dimensionalities this target binds";
    }
    if (ops[IMAGE_OP_MS] == 1 && dim != spirv.DIM_2D) {
        ret multisample_dim_refusal(dim);
    }
    if (ops[IMAGE_OP_ARRAYED] > 1) {
        ret "the `Arrayed` operand is neither `0` nor `1`: it is a flag, and a word outside that set would be written into the module verbatim as an arrayedness the spec does not define";
    }
    if (dim == spirv.DIM_BUFFER && ops[IMAGE_OP_ARRAYED] != 0) {
        ret "the `Arrayed` operand is `1` on a `Buffer` image: a texel buffer is one run of texels in a buffer view, which has no layers to index";
    }
    val fmt: u32 = ops[IMAGE_OP_FORMAT];
    if (fmt > spirv.IMAGE_FORMAT_R64I) {
        ret "the `Image Format` operand names no format at all: `0` is `Unknown`, `1` to `39` the formats `Rgba32f` to `R8ui`, and `40` and `41` the 64-bit `R64ui` and `R64i`";
    }
    if (fmt != spirv.IMAGE_FORMAT_UNKNOWN && format_texel(fmt) != ops[IMAGE_OP_TEXEL]) {
        ret "the `Image Format` operand does not match the texel-scalar operand: a float or normalized format is read as `f32`, a signed integer format as `i32` and an unsigned one as `u32`, `R64i` as `i64` and `R64ui` as `u64`, and Vulkan requires the image's texel type to be the one its format converts to";
    }
    ret nil;
}

# whether `en` is an instruction's view of the Image Operands mask
pub fun is_image_operands(en: *isa.OpEnum) bool {
    ret en != nil && (en == ?IMPLICIT_LOD_OPERANDS || en == ?SAMPLE_LOD_OPERANDS || en == ?FETCH_OPERANDS
        || en == ?GATHER_OPERANDS || en == ?STORAGE_OPERANDS);
}

# how many components an image of `dim` is addressed by, besides an array layer: what
# an offset added to its coordinate, and each derivative of it, has
pub fun image_coordinate_components(dim: u32) u32 {
    if (dim == spirv.DIM_2D)                          { ret 2; }
    if (dim == spirv.DIM_3D || dim == spirv.DIM_CUBE) { ret 3; }
    ret 1;
}

# why the operands the Image Operands bit `bit` brings do not fit an image of `dim`, nil
# when they do: each is a `float` (else integer) scalar or vector of `components`
# components, or an array of `elements` of them (0 for none). an offset or a derivative
# has one component per dimension of the image's coordinate, a least level of detail is
# one float, and only a gather's four offsets are an array
pub fun image_operand_shape_refusal(bit: u32, dim: u32, float: bool, components: u32, elements: u32) str {
    val want: u32 = image_coordinate_components(dim);
    if (bit == IMAGE_OPERANDS_CONST_OFFSETS && (float || components != want || elements != 4)) {
        ret "the `ConstOffsets` image operand is the offsets of the four texels a gather reads, an array of four integers with one component per dimension of the image's coordinate: `[4]i32x2` for a `2D` image";
    }
    if (bit != IMAGE_OPERANDS_CONST_OFFSETS && elements != 0) {
        ret "an image operand is a scalar or a vector, and only the `ConstOffsets` of a gather is an array: pass one value, not an array of them";
    }
    if ((bit == IMAGE_OPERANDS_CONST_OFFSET || bit == IMAGE_OPERANDS_OFFSET) && (float || components != want)) {
        ret "an offset image operand is an integer with one component per dimension of the image's coordinate, the array layer aside: a scalar for a `1D` image, two for `2D`, three for `3D`";
    }
    if (bit == IMAGE_OPERANDS_GRAD && (!float || components != want)) {
        ret "the `Grad` image operands are the coordinate's derivatives along x and then y, each a float with one component per dimension of the image's coordinate, the array layer aside: a scalar for a `1D` image, two for `2D`, three for `3D` and `Cube`";
    }
    if ((bit == IMAGE_OPERANDS_MIN_LOD || bit == IMAGE_OPERANDS_BIAS) && (!float || components != 1)) {
        ret "the `Bias` and `MinLod` image operands are a level of detail, one float: the bias added to the level a sample derives, and the least level it may read";
    }
    ret nil;
}

# why a multisampled image of `dim`, which is not `2D`, is no image Vulkan binds
fun multisample_dim_refusal(dim: u32) str {
    if (dim == spirv.DIM_1D) {
        ret "the `MS` operand is `1` on a `1D` image: only a `2D` image, arrayed or not, is multisampled, since a sample count is a property of a render target's pixels, and Vulkan creates no multisampled image of another type";
    }
    if (dim == spirv.DIM_3D) {
        ret "the `MS` operand is `1` on a `3D` image: only a `2D` image, arrayed or not, is multisampled, and a volume's texels have no samples. a multisampled image's sample count is queried by `OpImageQuerySamples`, which requires `Dim` `2D`";
    }
    if (dim == spirv.DIM_CUBE) {
        ret "the `MS` operand is `1` on a `Cube` image: only a `2D` image, arrayed or not, is multisampled, and Vulkan creates no multisampled cube-compatible image";
    }
    ret "the `MS` operand is `1` on a `Buffer` image: a texel buffer is one run of texels in a buffer view, which has no samples, so only a `2D` image, arrayed or not, is multisampled";
}

# the dimensionality of an instruction's first operand when it is neither an image nor
# a sampled image of one
pub val NO_IMAGE_DIM: u32 = 0xFFFFFFFF;

# why an image instruction's use is invalid, nil when it is valid: `image` says whether
# its first operand is an image, `ms` whether that image is multisampled, `storage`
# whether it is a storage image and `dim` the dimensionality of the image it is or
# samples (NO_IMAGE_DIM for neither), and `mask` is the Image
# Operands mask it passes, 0 when it passes none. a multisampled image's texel is named
# by its sample, and only a multisampled image has samples
pub fun image_use_refusal(opcode: u32, image: bool, ms: bool, storage: bool, dim: u32, mask: u32) str {
    if (opcode == spirv.OP_IMAGE_SAMPLE_EXPLICIT_LOD && (mask & (IMAGE_OPERANDS_LOD | IMAGE_OPERANDS_GRAD)) == 0) {
        ret "`OpImageSampleExplicitLod` reads the level of detail it is given, so its Image Operands mask must set `Lod` and pass that level after it, or set `Grad` and pass the coordinate's derivatives: a mask with neither leaves the level undefined, which is an invalid module";
    }
    if ((mask & IMAGE_OPERANDS_LOD) != 0 && (mask & IMAGE_OPERANDS_GRAD) != 0) {
        ret "the `Lod` and `Grad` image operands are two ways of choosing the level of detail, so a sample sets one of them: `Lod` names the level and `Grad` derives it from the coordinate's derivatives";
    }
    if (opcode == spirv.OP_IMAGE_SAMPLE_EXPLICIT_LOD && (mask & IMAGE_OPERANDS_MIN_LOD) != 0 && (mask & IMAGE_OPERANDS_GRAD) == 0) {
        ret "the `MinLod` image operand clamps a level of detail the sample derives, so an explicit-lod sample takes it only with `Grad`: under `Lod` the level is the one given, and there is nothing to clamp";
    }
    val offsets: u32 = mask & IMAGE_OPERANDS_OFFSETS;
    if ((offsets & (offsets - 1)) != 0) {
        ret "the `ConstOffset`, `Offset` and `ConstOffsets` image operands each say how the coordinate is offset, so an instruction takes one of them";
    }
    if (offsets != 0 && dim == spirv.DIM_CUBE) {
        ret "an offset image operand offsets a coordinate in texels, and a `Cube` image is addressed by a direction, which has no texel to offset: Vulkan admits no offset on a cube image";
    }
    if (opcode == spirv.OP_IMAGE_GATHER && dim != NO_IMAGE_DIM && dim != spirv.DIM_2D && dim != spirv.DIM_CUBE) {
        ret "`OpImageGather` reads the four texels a bilinear sample of a `2D` or `Cube` image would filter, and this image is neither: a `1D`, `3D` or `Buffer` image has no such footprint";
    }
    if (!image) { ret nil; }
    if (opcode == spirv.OP_IMAGE_QUERY_SIZE_LOD && ms) {
        ret "`OpImageQuerySizeLod` reads the extent of one mip level, and a multisampled image has a single level and no level of detail: query its extent with `OpImageQuerySize`";
    }
    if (opcode == spirv.OP_IMAGE_QUERY_SIZE && !ms && !storage && dim != spirv.DIM_BUFFER) {
        ret "`OpImageQuerySize` reads the extent of an image that has no level of detail to choose: a multisampled image, a storage image or a texel buffer. a single-sampled sampled image has mip levels, so query the extent of one with `OpImageQuerySizeLod`";
    }
    if (opcode == spirv.OP_IMAGE_QUERY_SAMPLES && !ms) {
        ret "`OpImageQuerySamples` reads a multisampled image's sample count, and this image's `MS` operand is `0`: a single-sampled image has one sample and nothing to query";
    }
    if (opcode != spirv.OP_IMAGE_FETCH && opcode != spirv.OP_IMAGE_READ && opcode != spirv.OP_IMAGE_WRITE) { ret nil; }
    val sample: bool = (mask & IMAGE_OPERANDS_SAMPLE) != 0;
    if (ms && !sample) {
        ret "a multisampled image's texel is one of several samples, so reading or writing it takes the `Sample` image operand: set `Sample` (0x40) in the Image Operands mask and pass the sample index after it";
    }
    if (!ms && sample) {
        ret "the `Sample` image operand names one sample of a multisampled image, and this image's `MS` operand is `0`: a single-sampled image has one sample, so pass no `Sample` bit";
    }
    if (ms && (mask & IMAGE_OPERANDS_LOD) != 0) {
        ret "a multisampled image has a single level, so a fetch from one takes no `Lod` image operand: name the texel by its `Sample` alone";
    }
    ret nil;
}

# the texel scalar a known format converts to
fun format_texel(fmt: u32) u32 {
    if (fmt <= spirv.IMAGE_FORMAT_LAST_FLOAT) { ret TEXEL_F32; }
    if (fmt <= spirv.IMAGE_FORMAT_LAST_SINT)  { ret TEXEL_I32; }
    if (fmt <= spirv.IMAGE_FORMAT_LAST_UINT)  { ret TEXEL_U32; }
    if (fmt == spirv.IMAGE_FORMAT_R64UI)      { ret TEXEL_U64; }
    ret TEXEL_I64;
}

# a texel pointer addresses one texel of a storage image, and only an atomic uses it, so
# Vulkan admits it into an image of `R32ui`, `R32i`, `R32f`, `R64ui` or `R64i` format.
# its pointee is the image's sampled type, which the row's pointee relation holds it to
fun image_address(ops: *u32, n: u32) str {
    if (n != IMAGE_ARITY) { ret nil; }
    if (ops[IMAGE_OP_SAMPLED] != spirv.IMAGE_SAMPLED_STORAGE) {
        ret "a texel pointer addresses a storage image's texels, and this image's `Sampled` operand is `1`: a sampled image is read through a sampler, and only an image whose `Sampled` operand is `2` holds texels an atomic can reach";
    }
    val fmt: u32 = ops[IMAGE_OP_FORMAT];
    if (fmt == spirv.IMAGE_FORMAT_R32UI || fmt == spirv.IMAGE_FORMAT_R32I || fmt == spirv.IMAGE_FORMAT_R32F
        || fmt == spirv.IMAGE_FORMAT_R64UI || fmt == spirv.IMAGE_FORMAT_R64I) { ret nil; }
    ret "a texel pointer is used only by an atomic, and Vulkan defines an image atomic only on an image of `R32ui`, `R32i`, `R32f`, `R64ui` or `R64i` format: this image's `Image Format` operand is none of them";
}

# the scalar an image's texels are read and written as, its texel-scalar operand
fun sampled_image_scalar(ops: *u32, n: u32) isa.OpScalar {
    if (n != IMAGE_ARITY) { ret isa.OpScalar{class: isa.OP_DATA_OTHER, bits: 0, signed: false}; }
    val texel: u32 = ops[IMAGE_OP_TEXEL];
    if (texel == TEXEL_I32) { ret isa.OpScalar{class: isa.OP_DATA_INT, bits: 32, signed: true}; }
    if (texel == TEXEL_U32) { ret isa.OpScalar{class: isa.OP_DATA_INT, bits: 32, signed: false}; }
    if (texel == TEXEL_I64) { ret isa.OpScalar{class: isa.OP_DATA_INT, bits: 64, signed: true}; }
    if (texel == TEXEL_U64) { ret isa.OpScalar{class: isa.OP_DATA_INT, bits: 64, signed: false}; }
    ret isa.OpScalar{class: isa.OP_DATA_FLOAT, bits: 32, signed: true};
}

# the components each known format stores a texel in, by Image Format word, from the
# VkFormat the Vulkan spec's SPIR-V image format compatibility table matches it to:
# `R11fG11fB10f` is three, the packed `Rgb10A2` formats four and the 64-bit ones one. `Unknown` is 0
val FORMAT_COMPONENTS: [42]u8 = [42]u8{
    0, 4, 4, 1, 4, 4, 2, 2, 3, 1,
    4, 4, 2, 2, 1, 1, 4, 2, 2, 1,
    1, 4, 4, 4, 1, 2, 2, 2, 1, 1,
    4, 4, 4, 1, 4, 2, 2, 2, 1, 1,
    1, 1,
};

# the components an image's format stores each texel in, 0 when its format is unknown
fun image_components(ops: *u32, n: u32) u32 {
    if (n != IMAGE_ARITY || ops[IMAGE_OP_FORMAT] > spirv.IMAGE_FORMAT_R64I) { ret 0; }
    ret FORMAT_COMPONENTS[ops[IMAGE_OP_FORMAT]]::u32;
}

# a storage image binds as a storage descriptor, and a sampled one as a sampler
fun bind_image(ops: *u32, n: u32) u32 {
    if (n == IMAGE_ARITY && ops[IMAGE_OP_SAMPLED] == spirv.IMAGE_SAMPLED_STORAGE) { ret isa.HANDLE_BIND_STORAGE; }
    ret isa.HANDLE_BIND_SAMPLER;
}

fun compose_sampled_image(index: u32, ops: *u32, n: u32) str {
    if (n != IMAGE_ARITY) { ret nil; }
    if (ops[IMAGE_OP_SAMPLED] == spirv.IMAGE_SAMPLED_STORAGE) {
        ret "a sampled image composes over an image whose `Sampled` operand is `1`: the image named here is a storage image, which is read and written directly by `OpImageRead` and `OpImageWrite` and is never sampled";
    }
    if (ops[IMAGE_OP_DIM] == spirv.DIM_BUFFER) {
        ret "a sampled image cannot compose over a `Buffer` image: a uniform texel buffer is read texel by texel, never sampled, and from SPIR-V 1.6 a sampled image of one is an invalid module";
    }
    if (ops[IMAGE_OP_MS] != 0) {
        ret "a sampled image cannot compose over a multisampled image: a multisampled image is never sampled, which filters between texels it has no single value for. fetch each sample with `OpImageFetch` and its `Sample` image operand";
    }
    ret nil;
}

#[testing]
pub fun opcode_of(definitions: *isa.TargetDefs, set: u8, name: str) u32 {
    var set_name: str = SET_CORE_NAME;
    if (set == SPV_SET_GLSL450) { set_name = SET_GLSL450_NAME; }
    or (set != SPV_SET_CORE)    { ret SPV_OP_NONE; }
    val d: *isa.OpDef = isa.op_def_of(definitions, set_name, name);
    if (d == nil) { ret SPV_OP_NONE; }
    ret d.opcode;
}

#[testing]
pub fun set_of(name: str) u8 {
    if (str_equals(name, SET_CORE_NAME))    { ret SPV_SET_CORE; }
    if (str_equals(name, SET_GLSL450_NAME)) { ret SPV_SET_GLSL450; }
    ret SPV_SET_NONE;
}

# a name resolves only in its own set, and only as a whole name, never as a prefix
test opcode_of__sets_are_separate_and_names_match_whole {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    if (opcode_of(definitions, SPV_SET_CORE, "OpDot") != 148)            { ret 1; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "OpDot") != SPV_OP_NONE) { ret 1; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Sqrt") != 31)           { ret 1; }
    if (opcode_of(definitions, SPV_SET_CORE, "Sqrt") != SPV_OP_NONE)     { ret 1; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Exp2") != 29)           { ret 2; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Exp") != 27)            { ret 2; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Atan2") != 25)          { ret 2; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Atan") != 18)           { ret 2; }
    ret 0;
}

test op_def__arity_is_per_instruction {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    val refl:        *isa.OpDef      = isa.op_def_of(definitions, SET_GLSL450_NAME, "Reflect");
    val refr:        *isa.OpDef      = isa.op_def_of(definitions, SET_GLSL450_NAME, "Refract");
    if (refl == nil || refr == nil) { ret 1; }
    if (refl.arity != 2)            { ret 1; }
    if (refr.arity != 3)            { ret 1; }
    # a signature row carries its arity, its operand kinds and its result shape
    val add: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpAtomicIAdd");
    if (add == nil || add.arity != 4 || add.result != isa.OP_RESULT_VALUE) { ret 2; }
    if (isa.op_operand_kind(add, 0) != isa.OP_OPERAND_POINTER_UPDATE
        || isa.op_operand_kind(add, 1) != isa.OP_OPERAND_SCOPE || isa.op_operand_kind(add, 2) != isa.OP_OPERAND_SEMANTICS
        || isa.op_operand_kind(add, 3) != isa.OP_OPERAND_VALUE) { ret 2; }
    val bar: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpControlBarrier");
    if (bar == nil || bar.result != isa.OP_RESULT_NONE) { ret 3; }
    val mem: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpMemoryBarrier");
    if (mem == nil || mem.arity != 2 || mem.result != isa.OP_RESULT_NONE || mem.opcode != spirv.OP_MEMORY_BARRIER)      { ret 3; }
    if (isa.op_operand_kind(mem, 0) != isa.OP_OPERAND_SCOPE || isa.op_operand_kind(mem, 1) != isa.OP_OPERAND_SEMANTICS) { ret 3; }
    # a control barrier's execution scope is a plain constant, its memory scope is held to the model
    if (isa.op_operand_kind(bar, 0) != isa.OP_OPERAND_CONSTANT || isa.op_operand_kind(bar, 1) != isa.OP_OPERAND_SCOPE) { ret 3; }
    val tex: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageTexelPointer");
    if (tex == nil || tex.result != isa.OP_RESULT_POINTER || tex.result_space != spirv.STORAGE_IMAGE) { ret 4; }
    # a texel pointer points into its image, a sampled image holds its image, and an atomic derives nothing
    val smp: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpSampledImage");
    if (tex.source != 0 || smp == nil || smp.source != 0 || add.source != isa.NO_OP_SOURCE)         { ret 4; }
    if (isa.op_operand_kind(refl, 0) != isa.OP_OPERAND_VALUE || refl.result != isa.OP_RESULT_VALUE) { ret 5; }
    val rd: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageRead");
    val wr: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageWrite");
    if (rd == nil || rd.result != isa.OP_RESULT_VALUE || isa.op_operand_kind(rd, 0) != isa.OP_OPERAND_HANDLE_READ) { ret 6; }
    if (wr == nil || wr.result != isa.OP_RESULT_NONE || isa.op_operand_kind(wr, 0) != isa.OP_OPERAND_HANDLE_WRITE) { ret 6; }
    val qs: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageQuerySize");
    if (qs == nil || qs.capability != spirv.CAP_IMAGE_QUERY || rd.capability != isa.NO_OP_CAPABILITY) { ret 7; }
    # an optional tail and the literal whose value decides it
    val iadd: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpGroupNonUniformIAdd");
    if (iadd == nil || iadd.arity != 4 || iadd.min_arity != 3)                { ret 6; }
    if (isa.op_operand_enum(iadd, 1) != ?ARITHMETIC_GROUP_OPERATION)          { ret 6; }
    if (add.min_arity != add.arity || add.capability != isa.NO_OP_CAPABILITY) { ret 7; }
    # the image reads, writes and fetches take an optional Image Operands mask leading their
    # tail, and an explicit-lod sample a required one
    val fetch: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageFetch");
    val lod:   *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageSampleExplicitLod");
    if (fetch == nil || lod == nil || isa.op_tail_literal(fetch) != ?FETCH_OPERANDS)                  { ret 8; }
    if (isa.op_tail_literal(rd) != ?STORAGE_OPERANDS || isa.op_tail_literal(wr) != ?STORAGE_OPERANDS) { ret 8; }
    if (isa.op_tail_literal(lod) != nil || isa.op_operand_enum(lod, 2) != ?SAMPLE_LOD_OPERANDS)       { ret 8; }
    # relations against the typing's operand: a pointee, a value, an image's sampled type
    if (add.result_relation != isa.OP_RELATION_DATA || isa.op_operand_relation(add, 3) != isa.OP_RELATION_DATA) { ret 9; }
    if (rd.result_relation != isa.OP_RELATION_TEXEL || isa.op_operand_relation(wr, 2) != isa.OP_RELATION_TEXEL) { ret 9; }
    if (iadd.typing == nil || iadd.typing.operand != 2 || iadd.result_relation != isa.OP_RELATION_DATA)         { ret 9; }
    if (bar.result_relation != isa.OP_RELATION_NONE || refr.relations[2] != isa.OP_RELATION_NONE)               { ret 9; }
    # each image row states its texel's component count
    val implicit: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageSampleImplicitLod");
    if (rd.texel_count != ?READ_TEXEL_COUNT || fetch.texel_count != ?FETCH_TEXEL_COUNT || wr.texel_count != ?WRITE_TEXEL_COUNT) { ret 10; }
    if (implicit == nil || implicit.texel_count != ?SAMPLE_TEXEL_COUNT || lod.texel_count != ?SAMPLE_TEXEL_COUNT)               { ret 10; }
    val gather: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageGather");
    if (gather == nil || gather.texel_count != ?GATHER_TEXEL_COUNT || isa.op_operand_kind(gather, 0) != isa.OP_OPERAND_HANDLE_READ) { ret 10; }
    if (implicit.result_relation != isa.OP_RELATION_TEXEL || isa.op_operand_kind(implicit, 0) != isa.OP_OPERAND_HANDLE_READ)        { ret 10; }
    # an image's format states its components, and a sampled image has its image's texels
    var ops:   [IMAGE_ARITY]u32 = [IMAGE_ARITY]u32{TEXEL_F32, spirv.DIM_2D, 0, 0, 0, spirv.IMAGE_SAMPLED_STORAGE, 8};
    val image: *isa.TypeDef     = isa.type_def_by_tag(definitions, SPV_CTOR_IMAGE);
    if (isa.type_def_components(image, ?ops[0], IMAGE_ARITY) != 3) { ret 11; }
    ops[IMAGE_OP_FORMAT] = spirv.IMAGE_FORMAT_UNKNOWN;
    if (isa.type_def_components(image, ?ops[0], IMAGE_ARITY) != 0) { ret 11; }
    val sampled: *isa.TypeDef = isa.type_def_by_tag(definitions, SPV_CTOR_SAMPLED_IMAGE);
    if (sampled == nil || sampled.texels_of != 0 || image.texels_of != isa.NO_TEXEL_OPERAND) { ret 12; }
    # a combined sampled image composes over its image operand and stays in its block
    val combine: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpSampledImage");
    if (combine == nil || combine.result_relation != isa.OP_RELATION_COMPOSED || combine.typing != ?FIRST_OPERAND || !combine.confined) { ret 13; }
    if (implicit.confined || rd.confined)                                                                                               { ret 13; }
    ret 0;
}

# every capability a row or an enumerant names is one the capability table declares
test op_def__every_capability_is_in_the_table {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    var i:           u32             = 0;
    for (i < definitions.op_count) {
        val d: *isa.OpDef = ?definitions.ops[i];
        if (isa.op_def_shape_refusal(d) != nil)                                               { ret 1; }
        if (d.capability != isa.NO_OP_CAPABILITY && spirv.capability_of(d.capability) == nil) { ret 2; }
        var k: u32 = 0;
        for (k < d.arity) {
            val en: *isa.OpEnum = isa.op_operand_enum(d, k);
            var v:  u32         = 0;
            for (en != nil && v < en.count) {
                val cap: u32 = en.values[v].capability;
                if (cap != isa.NO_OP_CAPABILITY && spirv.capability_of(cap) == nil) { ret 3; }
                v = v + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test set_of__an_unknown_set_matches_nothing {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    if (!isa.op_set_exists(definitions, SET_GLSL450_NAME)) { ret 1; }
    if (!isa.op_set_exists(definitions, SET_CORE_NAME))    { ret 1; }
    if (isa.op_set_exists(definitions, "GLSL.std.451"))    { ret 1; }
    if (set_of("GLSL.std.451") != SPV_SET_NONE)            { ret 1; }
    if (set_of("core") != SPV_SET_CORE)                    { ret 1; }
    ret 0;
}
