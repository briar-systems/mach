pub val SPV_SET_NONE:    u8 = 0;
pub val SPV_SET_CORE:    u8 = 1;
pub val SPV_SET_GLSL450: u8 = 2;

#[testing]
pub val SPV_OP_NONE: u32 = 0xFFFFFFFF;

pub val SET_CORE_NAME:    str = "core";
pub val SET_GLSL450_NAME: str = "GLSL.std.450";

pub val CTOR_IMAGE_NAME:         str = "image";
pub val CTOR_SAMPLED_IMAGE_NAME: str = "sampled_image";
pub val CTOR_SAMPLER_NAME:       str = "sampler";

pub val SPV_CTOR_IMAGE:         u32 = 0;
pub val SPV_CTOR_SAMPLED_IMAGE: u32 = 1;
pub val SPV_CTOR_SAMPLER:       u32 = 2;

pub val TEXEL_F32: u32 = 0;
pub val TEXEL_I32: u32 = 1;
pub val TEXEL_U32: u32 = 2;
pub val TEXEL_I64: u32 = 3;
pub val TEXEL_U64: u32 = 4;

pub val IMAGE_ARITY:      u32 = 7;
pub val IMAGE_OP_TEXEL:   u32 = 0;
pub val IMAGE_OP_DIM:     u32 = 1;
pub val IMAGE_OP_DEPTH:   u32 = 2;
pub val IMAGE_OP_ARRAYED: u32 = 3;
pub val IMAGE_OP_MS:      u32 = 4;
pub val IMAGE_OP_SAMPLED: u32 = 5;
pub val IMAGE_OP_FORMAT:  u32 = 6;

pub val OP_DEF_COUNT:   usize = 102;
pub val TYPE_DEF_COUNT: usize = 3;

pub val GROUP_OPERATION_REDUCE:           u32 = 0;
pub val GROUP_OPERATION_INCLUSIVE_SCAN:   u32 = 1;
pub val GROUP_OPERATION_EXCLUSIVE_SCAN:   u32 = 2;
pub val GROUP_OPERATION_CLUSTERED_REDUCE: u32 = 3;

# the GroupOperation a non-uniform arithmetic instruction takes: a reduction or scan
# needs the GroupNonUniformArithmetic capability, and a clustered reduction needs
# GroupNonUniformClustered and is followed by its ClusterSize operand
val ARITHMETIC_GROUP_OPERATIONS: [4]isa.OpEnumerant = [4]isa.OpEnumerant{
    isa.OpEnumerant{value: GROUP_OPERATION_REDUCE, name: "Reduce", capability: spirv.CAP_GROUP_NON_UNIFORM_ARITHMETIC, requires: spirv.EXT_SUBGROUP_ARITHMETIC, operands: ""},
    isa.OpEnumerant{value: GROUP_OPERATION_INCLUSIVE_SCAN, name: "InclusiveScan", capability: spirv.CAP_GROUP_NON_UNIFORM_ARITHMETIC, requires: spirv.EXT_SUBGROUP_ARITHMETIC, operands: ""},
    isa.OpEnumerant{value: GROUP_OPERATION_EXCLUSIVE_SCAN, name: "ExclusiveScan", capability: spirv.CAP_GROUP_NON_UNIFORM_ARITHMETIC, requires: spirv.EXT_SUBGROUP_ARITHMETIC, operands: ""},
    isa.OpEnumerant{value: GROUP_OPERATION_CLUSTERED_REDUCE, name: "ClusteredReduce", capability: spirv.CAP_GROUP_NON_UNIFORM_CLUSTERED, requires: spirv.EXT_SUBGROUP_CLUSTERED, operands: "c"},
};

pub val ARITHMETIC_GROUP_OPERATION: isa.OpEnum = isa.OpEnum{name: "GroupOperation", values: ?ARITHMETIC_GROUP_OPERATIONS[0], count: 4, mask: false};

pub val IMAGE_OPERANDS_BIAS:          u32 = 0x1;
pub val IMAGE_OPERANDS_LOD:           u32 = 0x2;
pub val IMAGE_OPERANDS_GRAD:          u32 = 0x4;
pub val IMAGE_OPERANDS_CONST_OFFSET:  u32 = 0x8;
pub val IMAGE_OPERANDS_OFFSET:        u32 = 0x10;
pub val IMAGE_OPERANDS_CONST_OFFSETS: u32 = 0x20;
pub val IMAGE_OPERANDS_SAMPLE:        u32 = 0x40;
pub val IMAGE_OPERANDS_MIN_LOD:       u32 = 0x80;

# the bits that offset a coordinate, of which an instruction takes one
pub val IMAGE_OPERANDS_OFFSETS: u32 = IMAGE_OPERANDS_CONST_OFFSET | IMAGE_OPERANDS_OFFSET | IMAGE_OPERANDS_CONST_OFFSETS;

# the Image Operands the emitter adds to a coherent storage image's access under the
# Vulkan memory model. no row admits them from a call yet
pub val IMAGE_OPERANDS_MAKE_TEXEL_AVAILABLE: u32 = 0x100;
pub val IMAGE_OPERANDS_MAKE_TEXEL_VISIBLE:   u32 = 0x200;
pub val IMAGE_OPERANDS_NON_PRIVATE_TEXEL:    u32 = 0x400;

# the Image Operands bits this target carries and the operands each brings: a bias added
# to an implicit-lod sample's level of detail, the level an explicit-lod sample or a fetch
# reads, the two coordinate derivatives an explicit-lod sample takes instead, an integer
# offset added to the coordinate, constant or computed at run time, the sample a
# multisampled image's texel is read from, the least level of detail a sample may read,
# and the constant offsets of the four texels a gather reads. a run-time offset, and a
# gather's four offsets, need ImageGatherExtended, and Vulkan admits one outside a gather only under
# maintenance8 (VUID-RuntimeSpirv-Offset-10213). each instruction admits the bits valid
# on it, in bit order
val IMAGE_BIAS:          isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_BIAS, name: "Bias", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "v"};
val IMAGE_LOD:           isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_LOD, name: "Lod", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "v"};
val IMAGE_GRAD:          isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_GRAD, name: "Grad", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "vv"};
val IMAGE_CONST_OFFSET:  isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_CONST_OFFSET, name: "ConstOffset", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "c"};
val IMAGE_OFFSET:        isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_OFFSET, name: "Offset", capability: spirv.CAP_IMAGE_GATHER_EXTENDED, requires: spirv.EXT_IMAGE_GATHER_EXTENDED | spirv.EXT_MAINTENANCE8, operands: "v"};
val IMAGE_GATHER_OFFSET: isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_OFFSET, name: "Offset", capability: spirv.CAP_IMAGE_GATHER_EXTENDED, requires: spirv.EXT_IMAGE_GATHER_EXTENDED, operands: "v"};
val IMAGE_CONST_OFFSETS: isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_CONST_OFFSETS, name: "ConstOffsets", capability: spirv.CAP_IMAGE_GATHER_EXTENDED, requires: spirv.EXT_IMAGE_GATHER_EXTENDED, operands: "c"};
val IMAGE_SAMPLE:        isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_SAMPLE, name: "Sample", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: "v"};
val IMAGE_MIN_LOD:       isa.OpEnumerant = isa.OpEnumerant{value: IMAGE_OPERANDS_MIN_LOD, name: "MinLod", capability: spirv.CAP_MIN_LOD, requires: spirv.EXT_RESOURCE_MIN_LOD, operands: "v"};

val IMPLICIT_LOD_BITS: [4]isa.OpEnumerant = [4]isa.OpEnumerant{IMAGE_BIAS, IMAGE_CONST_OFFSET, IMAGE_OFFSET, IMAGE_MIN_LOD};
val EXPLICIT_LOD_BITS: [5]isa.OpEnumerant = [5]isa.OpEnumerant{IMAGE_LOD, IMAGE_GRAD, IMAGE_CONST_OFFSET, IMAGE_OFFSET, IMAGE_MIN_LOD};
val FETCH_BITS:        [4]isa.OpEnumerant = [4]isa.OpEnumerant{IMAGE_LOD, IMAGE_CONST_OFFSET, IMAGE_OFFSET, IMAGE_SAMPLE};
val GATHER_BITS:       [3]isa.OpEnumerant = [3]isa.OpEnumerant{IMAGE_CONST_OFFSET, IMAGE_GATHER_OFFSET, IMAGE_CONST_OFFSETS};
val STORAGE_BITS:      [1]isa.OpEnumerant = [1]isa.OpEnumerant{IMAGE_SAMPLE};

pub val IMPLICIT_LOD_OPERANDS: isa.OpEnum = isa.OpEnum{name: "Image Operands", values: ?IMPLICIT_LOD_BITS[0], count: 4, mask: true};
pub val SAMPLE_LOD_OPERANDS:   isa.OpEnum = isa.OpEnum{name: "Image Operands", values: ?EXPLICIT_LOD_BITS[0], count: 5, mask: true};
pub val FETCH_OPERANDS:        isa.OpEnum = isa.OpEnum{name: "Image Operands", values: ?FETCH_BITS[0], count: 4, mask: true};
pub val GATHER_OPERANDS:       isa.OpEnum = isa.OpEnum{name: "Image Operands", values: ?GATHER_BITS[0], count: 3, mask: true};
pub val STORAGE_OPERANDS:      isa.OpEnum = isa.OpEnum{name: "Image Operands", values: ?STORAGE_BITS[0], count: 1, mask: true};

# the GroupOperation OpGroupNonUniformBallotBitCount takes: its row's Ballot capability
# covers every value, and a ballot has no clustered count
val BALLOT_GROUP_OPERATIONS: [3]isa.OpEnumerant = [3]isa.OpEnumerant{
    isa.OpEnumerant{value: GROUP_OPERATION_REDUCE, name: "Reduce", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: ""},
    isa.OpEnumerant{value: GROUP_OPERATION_INCLUSIVE_SCAN, name: "InclusiveScan", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: ""},
    isa.OpEnumerant{value: GROUP_OPERATION_EXCLUSIVE_SCAN, name: "ExclusiveScan", capability: isa.NO_OP_CAPABILITY, requires: 0, operands: ""},
};

pub val BALLOT_GROUP_OPERATION: isa.OpEnum = isa.OpEnum{name: "GroupOperation", values: ?BALLOT_GROUP_OPERATIONS[0], count: 3, mask: false};

# a subgroup row: its family's capability and the feature that family is
fun subgroup_row(name: str, opcode: u32, result: isa.OpResult, signature: str, capability: u32, requires: u64) isa.OpDef {
    ret isa.op_requiring(isa.op_def_shaped(SET_CORE_NAME, name, SPV_SET_CORE::u32, opcode,
        result, isa.NO_OP_SPACE, signature), capability, requires);
}

# a non-uniform arithmetic row: the Subgroup scope, the GroupOperation whose value decides
# the capability, the value, and the ClusterSize a `ClusteredReduce` brings
fun arithmetic_row(name: str, opcode: u32) isa.OpDef {
    ret isa.op_related(isa.op_typed(isa.op_enumerated(isa.op_def_shaped(SET_CORE_NAME, name, SPV_SET_CORE::u32, opcode,
        isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "clv"), 1, ?ARITHMETIC_GROUP_OPERATION), ?GROUP_OPERATION_VALUE), isa.OP_RELATION_DATA, "");
}

# a math row whose result and operands relate to its first operand's type: `result` the
# result's relation and `operands` each operand's, as `isa.op_related` spells them
fun math_row(d: isa.OpDef, result: isa.OpRelation, operands: str) isa.OpDef {
    ret isa.op_related(isa.op_typed(d, ?FIRST_OPERAND), result, operands);
}

# a logical reduction over truth values, its result one
fun logical_row(name: str, opcode: u32) isa.OpDef {
    ret isa.op_enumerated(isa.op_def_shaped(SET_CORE_NAME, name, SPV_SET_CORE::u32, opcode,
        isa.OP_RESULT_BOOL, isa.NO_OP_SPACE, "clb"), 1, ?ARITHMETIC_GROUP_OPERATION);
}

# the data types an atomic operates on, its pointer operand's pointee. a 32-bit integer
# is core in every storage class. a 64-bit integer, and a float of any width, needs the
# Vulkan feature of its storage class: `buffer_*` for a storage buffer (the StorageBuffer
# class, or Uniform before SPIR-V 1.3), `shared_*` for `#[shared]` workgroup memory,
# `image_*` for a storage image texel (the Image class), where only f32 floats are defined.
# an f16 also needs `float16`, under which f16 memory is the OpTypeFloat 16 the atomic
# operates on (#4299)
val ATOMIC_INTEGER_TYPES: [5]isa.OpTypeRequirement = [5]isa.OpTypeRequirement{
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 32, space: isa.NO_OP_SPACE, capability: isa.NO_OP_CAPABILITY, requires: 0},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_STORAGE_BUFFER, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_BUFFER_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_UNIFORM, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_BUFFER_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_WORKGROUP, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_SHARED_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_IMAGE, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_IMAGE_INT64_ATOMICS},
};

# a load, a store and an exchange also take floats, under the plain `*_atomics` features
val ATOMIC_MEMORY_TYPES: [15]isa.OpTypeRequirement = [15]isa.OpTypeRequirement{
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 32, space: isa.NO_OP_SPACE, capability: isa.NO_OP_CAPABILITY, requires: 0},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_STORAGE_BUFFER, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_BUFFER_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_UNIFORM, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_BUFFER_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_WORKGROUP, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_SHARED_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_INT, bits: 64, space: spirv.STORAGE_IMAGE, capability: spirv.CAP_INT64_ATOMICS, requires: spirv.EXT_IMAGE_INT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 32, space: spirv.STORAGE_STORAGE_BUFFER, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_BUFFER_FLOAT32_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 32, space: spirv.STORAGE_UNIFORM, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_BUFFER_FLOAT32_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 32, space: spirv.STORAGE_WORKGROUP, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_SHARED_FLOAT32_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 32, space: spirv.STORAGE_IMAGE, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_IMAGE_FLOAT32_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 64, space: spirv.STORAGE_STORAGE_BUFFER, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_BUFFER_FLOAT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 64, space: spirv.STORAGE_UNIFORM, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_BUFFER_FLOAT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 64, space: spirv.STORAGE_WORKGROUP, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_SHARED_FLOAT64_ATOMICS},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 16, space: spirv.STORAGE_STORAGE_BUFFER, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_BUFFER_FLOAT16_ATOMICS | spirv.EXT_FLOAT16},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 16, space: spirv.STORAGE_UNIFORM, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_BUFFER_FLOAT16_ATOMICS | spirv.EXT_FLOAT16},
    isa.OpTypeRequirement{class: isa.OP_DATA_FLOAT, bits: 16, space: spirv.STORAGE_WORKGROUP, capability: isa.NO_OP_CAPABILITY, requires: spirv.EXT_SHARED_FLOAT16_ATOMICS | spirv.EXT_FLOAT16},
};

