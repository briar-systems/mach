pub val ATOMIC_INTEGER:       isa.OpTyping = isa.OpTyping{name: "an integer atomic", operand: 0, entries: ?ATOMIC_INTEGER_TYPES[0], count: 5};
pub val ATOMIC_MEMORY:        isa.OpTyping = isa.OpTyping{name: "an atomic load, store or exchange", operand: 0, entries: ?ATOMIC_MEMORY_TYPES[0], count: 15};
pub val ATOMIC_FLOAT_ADD:     isa.OpTyping = isa.OpTyping{name: "a float atomic add", operand: 0, entries: ?ATOMIC_FLOAT_ADD_TYPES[0], count: 10};
pub val ATOMIC_FLOAT_MIN_MAX: isa.OpTyping = isa.OpTyping{name: "a float atomic min or max", operand: 0, entries: ?ATOMIC_FLOAT_MIN_MAX_TYPES[0], count: 10};

# the operand an untyped row's relations are stated against, holding its type to nothing:
# the first for a math instruction or an image's handle, the value for a subgroup operation
pub val FIRST_OPERAND:         isa.OpTyping = isa.OpTyping{name: "its first operand", operand: 0, entries: nil, count: 0};
pub val SUBGROUP_VALUE:        isa.OpTyping = isa.OpTyping{name: "its value", operand: 1, entries: nil, count: 0};
pub val GROUP_OPERATION_VALUE: isa.OpTyping = isa.OpTyping{name: "its value", operand: 2, entries: nil, count: 0};

# how many components each image instruction's texel has. a read's result is a 4-vector in
# Vulkan, a fetch's, a sample's and a gather's in every environment, and a write's texel needs at
# least the components its image's format stores, which spirv-val cannot see: the format
# is matched to a VkFormat only when the descriptor is bound
pub val READ_TEXEL_COUNT:   isa.OpTexelCount = isa.OpTexelCount{rule: "Vulkan requires the result of an image read to be a vector of four components (VUID-StandaloneSpirv-Result-04780)", kind: isa.OP_COUNT_EXACT, components: 4};
pub val FETCH_TEXEL_COUNT:  isa.OpTexelCount = isa.OpTexelCount{rule: "SPIR-V requires the result of an image fetch to be a vector of four components", kind: isa.OP_COUNT_EXACT, components: 4};
pub val SAMPLE_TEXEL_COUNT: isa.OpTexelCount = isa.OpTexelCount{rule: "SPIR-V requires the result of an image sample to be a vector of four components", kind: isa.OP_COUNT_EXACT, components: 4};
pub val GATHER_TEXEL_COUNT: isa.OpTexelCount = isa.OpTexelCount{rule: "SPIR-V requires the result of an image gather to be a vector of four components, one from each texel", kind: isa.OP_COUNT_EXACT, components: 4};
pub val WRITE_TEXEL_COUNT:  isa.OpTexelCount = isa.OpTexelCount{rule: "Vulkan requires the texel of an image write to have at least as many components as the image's format (VUID-RuntimeSpirv-OpImageWrite-07112)", kind: isa.OP_COUNT_FORMAT, components: 0};

pub rec DefStorage {
    ops:     [OP_DEF_COUNT]isa.OpDef;
    types:   [TYPE_DEF_COUNT]isa.TypeDef;
    img_ops: [IMAGE_ARITY]u32;
    smp_ops: [1]u32;
    defs:    isa.TargetDefs;
}

pub fun set_import_name(set: u8) str {
    if (set == SPV_SET_GLSL450) { ret SET_GLSL450_NAME; }
    ret "";
}

pub fun register_defs(storage: *DefStorage) *isa.TargetDefs {
    val spv_ops:     *isa.OpDef   = ?storage.ops[0];
    val spv_types:   *isa.TypeDef = ?storage.types[0];
    val spv_img_ops: *u32         = ?storage.img_ops[0];
    val spv_smp_ops: *u32         = ?storage.smp_ops[0];
    spv_ops[0] = math_row(isa.op_def(SET_CORE_NAME, "OpDot", SPV_SET_CORE::u32, spirv.OP_DOT, 2), isa.OP_RELATION_NONE, "-=");
    # an image and a sampler combined into the sampled image over that image, holding the
    # image's descriptor. SPIR-V lets the result be consumed only by an image instruction in
    # the block that produces it, never by an OpReturnValue, an OpFunctionCall or an OpPhi
