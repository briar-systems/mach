# the SPIR-V instruction table, published to the compiler as target definitions
#
# This is the single place a `(set, name)` pair becomes a number. The front end
# reads it to close the value set, so a typo is a compile error on the declaration
# rather than a module that quietly calls nothing, and the emitter reads it to write
# the instruction. One table, two readers, so the accepted spellings and the emitted
# opcodes cannot drift apart.
#
# It used to sit at `src/lang/spirvop.mach`, outside the target, and the reason given
# was that the front end must be able to check a spelling without depending on a back
# end. That reason is right and this move keeps it: the table reaches the front end as
# DATA on the ISA vtable, so `fe` names no back end and, unlike before, holds no
# SPIR-V numbers of its own.
#
# THE GROWTH AXIS IS A ROW. Adding a GLSL.std.450 instruction is one row here. Adding
# a whole extended set is a `SPV_SET_*` tag, its import string, and its rows. The set
# is carried explicitly rather than inferred from the instruction name so a second set
# whose names collide with GLSL.std.450's stays unambiguous.
#
# WHAT IS DELIBERATELY ABSENT from the GLSL.std.450 rows, since the spec's set is far
# larger than this:
#
#   - `Modf` and `Frexp` take a pointer operand to write their second result through.
#     SPIR-V here is LOGICAL addressing: a pointer has exactly one pointee type and no
#     pointer may be cast, and mach has no way to hand the back end a Function-storage
#     out-pointer at a call site. The `*Struct` forms avoid the pointer but return a
#     two-member struct mach cannot spell as a return type.
#   - `Determinant` and `MatrixInverse` need a matrix type, which mach does not have
#     by design - doc/types.md puts matrices in a library over vectors.
#   - the `Pack*` / `Unpack*` family reinterprets one width's bits as another's, which
#     is exactly what logical addressing forbids.
#   - `InterpolateAt*` require the InterpolationFunction capability, which the module
#     does not declare.
#   - the integer `UMin` / `SMin` / `UMax` / `SMax` / `UClamp` / `SClamp` and the
#     `Find*Msb` bit-scan family are ordinary integer arithmetic a CPU target computes
#     identically. They are not the shader gap, and routing them through a shader-only
#     module would make code less portable, not more.
#   - `NMin` / `NMax` / `NClamp` differ from the `F` forms only in NaN handling. Both
#     spellings existing with no visible difference is a trap; the `F` forms are what
#     GLSL's own `min` / `max` / `clamp` compile to.
#
# WHAT IS DELIBERATELY ABSENT from the core rows, on the image side (#2794). The
# uniform contract - a result type from the declared return, operands from the
# parameters in order - is what admits `OpSampledImage` and
# `OpImageSampleImplicitLod`, and what excludes the rest of the family:
#
#   - `OpImageSampleExplicitLod` and every `*Dref*` / `*Proj*` form take an IMAGE
#     OPERANDS mask, a literal bitfield followed by its own operands, which is not a
#     parameter and has no mach spelling. A declaration carrying one as an ordinary
#     argument would assemble as a mask of whatever that value happened to be, which
#     is the silently-wrong-image failure the closed table exists to avoid.
#   - `OpImageFetch` and `OpImageRead` / `OpImageWrite` are how a multisampled or
#     storage image is reached, and both are refused at the TYPE, so an instruction
#     for them would have no image to name.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_equals;

use isa: mach.lang.target.isa;

# the instruction set an operation is drawn from. NONE is the absence of the
# declaration, which is every ordinary function
pub val SPV_SET_NONE:    u8 = 0;
pub val SPV_SET_CORE:    u8 = 1;
pub val SPV_SET_GLSL450: u8 = 2;

# no instruction of that name exists in that set. distinct from opcode 0, which is
# the core `OpNop`
pub val SPV_OP_NONE: u32 = 0xFFFFFFFF;

# the set names as a declaration spells them. `SET_GLSL450_NAME` is also the string
# the module's OpExtInstImport carries, so the accepted spelling and the imported set
# are one constant rather than two that can drift
pub val SET_CORE_NAME:    str = "core";
pub val SET_GLSL450_NAME: str = "GLSL.std.450";

# the instruction rows and the table over them. borrowed by the vtable for the
# process lifetime, filled once by `register_defs`
var spv_ops:  [38]isa.OpDef;
var spv_defs: isa.TargetDefs;

# the literal name an extended set is imported under, or the empty string for the
# core set, which is never imported
# ---
# set: one of SPV_SET_*
# ret: the OpExtInstImport operand string
pub fun set_import_name(set: u8) str {
    if (set == SPV_SET_GLSL450) { ret SET_GLSL450_NAME; }
    ret "";
}

# fill the table and return it
#
# The arity is the row's own, not a shape the reader assumes: `Reflect` takes two
# operands where `Refract` takes three, and `FMin` two where `FClamp` takes three, so
# a declaration whose parameter list disagrees with the instruction is a diagnostic
# rather than an instruction assembled with the wrong operand count.
# ---
# ret: the borrowed table
pub fun register_defs() *isa.TargetDefs {
    # core. `OpDot` is NOT a GLSL.std.450 instruction, which is the single easiest
    # thing here to get wrong: GLSL spells `dot` alongside `normalize` and `length`,
    # so it reads like one of the set, and an OpExtInst carrying some invented number
    # for it would assemble and validate as whatever instruction that number happens
    # to be.
    spv_ops[0] = isa.op_def(SET_CORE_NAME, "OpDot", SPV_SET_CORE::u32, 148, 2);
    # the two instructions a textured shader is written with (#2794).
    # `OpSampledImage` combines a separately-bound image and sampler into the value a
    # lookup takes, and `OpImageSampleImplicitLod` reads it at a coordinate with the
    # level of detail derived from the fragment stage's own derivatives.
    spv_ops[1] = isa.op_def(SET_CORE_NAME, "OpSampledImage", SPV_SET_CORE::u32, 86, 2);
    spv_ops[2] = isa.op_def(SET_CORE_NAME, "OpImageSampleImplicitLod", SPV_SET_CORE::u32, 87, 2);

    # common-value maths
    spv_ops[3] = isa.op_def(SET_GLSL450_NAME, "FAbs", SPV_SET_GLSL450::u32, 4, 1);
    spv_ops[4] = isa.op_def(SET_GLSL450_NAME, "FSign", SPV_SET_GLSL450::u32, 6, 1);
    spv_ops[5] = isa.op_def(SET_GLSL450_NAME, "Floor", SPV_SET_GLSL450::u32, 8, 1);
    spv_ops[6] = isa.op_def(SET_GLSL450_NAME, "Ceil", SPV_SET_GLSL450::u32, 9, 1);
    spv_ops[7] = isa.op_def(SET_GLSL450_NAME, "Fract", SPV_SET_GLSL450::u32, 10, 1);

    # trigonometry, including the angle conversions GLSL exposes beside it
    spv_ops[8] = isa.op_def(SET_GLSL450_NAME, "Radians", SPV_SET_GLSL450::u32, 11, 1);
    spv_ops[9] = isa.op_def(SET_GLSL450_NAME, "Degrees", SPV_SET_GLSL450::u32, 12, 1);
    spv_ops[10] = isa.op_def(SET_GLSL450_NAME, "Sin", SPV_SET_GLSL450::u32, 13, 1);
    spv_ops[11] = isa.op_def(SET_GLSL450_NAME, "Cos", SPV_SET_GLSL450::u32, 14, 1);
    spv_ops[12] = isa.op_def(SET_GLSL450_NAME, "Tan", SPV_SET_GLSL450::u32, 15, 1);
    spv_ops[13] = isa.op_def(SET_GLSL450_NAME, "Asin", SPV_SET_GLSL450::u32, 16, 1);
    spv_ops[14] = isa.op_def(SET_GLSL450_NAME, "Acos", SPV_SET_GLSL450::u32, 17, 1);
    spv_ops[15] = isa.op_def(SET_GLSL450_NAME, "Atan", SPV_SET_GLSL450::u32, 18, 1);
    spv_ops[16] = isa.op_def(SET_GLSL450_NAME, "Atan2", SPV_SET_GLSL450::u32, 25, 2);

    # exponentials
    spv_ops[17] = isa.op_def(SET_GLSL450_NAME, "Pow", SPV_SET_GLSL450::u32, 26, 2);
    spv_ops[18] = isa.op_def(SET_GLSL450_NAME, "Exp", SPV_SET_GLSL450::u32, 27, 1);
    spv_ops[19] = isa.op_def(SET_GLSL450_NAME, "Log", SPV_SET_GLSL450::u32, 28, 1);
    spv_ops[20] = isa.op_def(SET_GLSL450_NAME, "Exp2", SPV_SET_GLSL450::u32, 29, 1);
    spv_ops[21] = isa.op_def(SET_GLSL450_NAME, "Log2", SPV_SET_GLSL450::u32, 30, 1);
    spv_ops[22] = isa.op_def(SET_GLSL450_NAME, "Sqrt", SPV_SET_GLSL450::u32, 31, 1);
    spv_ops[23] = isa.op_def(SET_GLSL450_NAME, "InverseSqrt", SPV_SET_GLSL450::u32, 32, 1);

    # range and interpolation
    spv_ops[24] = isa.op_def(SET_GLSL450_NAME, "FMin", SPV_SET_GLSL450::u32, 37, 2);
    spv_ops[25] = isa.op_def(SET_GLSL450_NAME, "FMax", SPV_SET_GLSL450::u32, 40, 2);
    spv_ops[26] = isa.op_def(SET_GLSL450_NAME, "FClamp", SPV_SET_GLSL450::u32, 43, 3);
    spv_ops[27] = isa.op_def(SET_GLSL450_NAME, "FMix", SPV_SET_GLSL450::u32, 46, 3);
    spv_ops[28] = isa.op_def(SET_GLSL450_NAME, "Step", SPV_SET_GLSL450::u32, 48, 2);
    spv_ops[29] = isa.op_def(SET_GLSL450_NAME, "SmoothStep", SPV_SET_GLSL450::u32, 49, 3);
    spv_ops[30] = isa.op_def(SET_GLSL450_NAME, "Fma", SPV_SET_GLSL450::u32, 50, 3);

    # geometry. every one takes and returns whole vectors, which is why these belong
    # to the set rather than to a scalar library. `Cross` is the one row defined only
    # for 3-component float vectors, so it waited on #2687 for a type to declare it
    # at (#2745)
    spv_ops[31] = isa.op_def(SET_GLSL450_NAME, "Length", SPV_SET_GLSL450::u32, 66, 1);
    spv_ops[32] = isa.op_def(SET_GLSL450_NAME, "Distance", SPV_SET_GLSL450::u32, 67, 2);
    spv_ops[33] = isa.op_def(SET_GLSL450_NAME, "Cross", SPV_SET_GLSL450::u32, 68, 2);
    spv_ops[34] = isa.op_def(SET_GLSL450_NAME, "Normalize", SPV_SET_GLSL450::u32, 69, 1);
    spv_ops[35] = isa.op_def(SET_GLSL450_NAME, "FaceForward", SPV_SET_GLSL450::u32, 70, 3);
    spv_ops[36] = isa.op_def(SET_GLSL450_NAME, "Reflect", SPV_SET_GLSL450::u32, 71, 2);
    spv_ops[37] = isa.op_def(SET_GLSL450_NAME, "Refract", SPV_SET_GLSL450::u32, 72, 3);

    spv_defs = isa.target_defs(?spv_ops[0], 38);
    ret ?spv_defs;
}

# the opcode a `(set, name)` pair names, or SPV_OP_NONE
#
# The emitter's own reader. It answers from the same rows the front end validated
# against, so an accepted spelling and an emitted opcode cannot disagree.
# ---
# set:  one of SPV_SET_*
# name: the instruction name
# ret:  the opcode, or SPV_OP_NONE
pub fun opcode_of(set: u8, name: str) u32 {
    var set_name: str = SET_CORE_NAME;
    if (set == SPV_SET_GLSL450) { set_name = SET_GLSL450_NAME; }
    or (set != SPV_SET_CORE)    { ret SPV_OP_NONE; }
    val d: *isa.OpDef = isa.op_def_of(?spv_defs, set_name, name);
    if (d == nil) { ret SPV_OP_NONE; }
    ret d.opcode;
}

# the set a name denotes, or SPV_SET_NONE
# ---
# name: the set name as spelled
# ret:  one of SPV_SET_*
pub fun set_of(name: str) u8 {
    if (str_equals(name, SET_CORE_NAME))    { ret SPV_SET_CORE; }
    if (str_equals(name, SET_GLSL450_NAME)) { ret SPV_SET_GLSL450; }
    ret SPV_SET_NONE;
}

test "mach.lang.target.isa.spirv.defs:sets_are_separate" {
    register_defs();
    # `OpDot` is core, not extended, and the extended set must not answer for it.
    if (opcode_of(SPV_SET_CORE, "OpDot") != 148) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "OpDot") != SPV_OP_NONE) { ret 1; }
    # and the extended names must not answer from the core set.
    if (opcode_of(SPV_SET_GLSL450, "Sqrt") != 31) { ret 1; }
    if (opcode_of(SPV_SET_CORE, "Sqrt") != SPV_OP_NONE) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.spirv.defs:image_rows_are_core" {
    register_defs();
    # both image instructions are CORE, like OpDot and unlike the maths family around
    # them, and the extended set must not answer for either (#2794).
    if (opcode_of(SPV_SET_CORE, "OpSampledImage") != 86) { ret 1; }
    if (opcode_of(SPV_SET_CORE, "OpImageSampleImplicitLod") != 87) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "OpImageSampleImplicitLod") != SPV_OP_NONE) { ret 1; }

    # the neighbours this cut does NOT emit stay closed, so a shader asking for one is
    # a compile error on the declaration rather than an instruction whose
    # image-operands mask was never written (#2794).
    if (opcode_of(SPV_SET_CORE, "OpImageSampleExplicitLod") != SPV_OP_NONE) { ret 1; }
    if (opcode_of(SPV_SET_CORE, "OpImageSampleDrefImplicitLod") != SPV_OP_NONE) { ret 1; }
    if (opcode_of(SPV_SET_CORE, "OpImageFetch") != SPV_OP_NONE) { ret 1; }
    if (opcode_of(SPV_SET_CORE, "OpImageRead") != SPV_OP_NONE) { ret 1; }
    if (opcode_of(SPV_SET_CORE, "OpImageWrite") != SPV_OP_NONE) { ret 1; }
    # a whole-name compare, not a prefix one: `OpImageSample` is the head of the
    # implicit-LOD name and must not answer for it.
    if (opcode_of(SPV_SET_CORE, "OpImageSample") != SPV_OP_NONE) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.spirv.defs:a_prefix_is_not_a_match" {
    register_defs();
    # `Exp` is not `Exp2` and `Log` is not the head of `Log2`.
    if (opcode_of(SPV_SET_GLSL450, "Exp2") != 29) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "Exp")  != 27) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "Log2") != 30) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "Log")  != 28) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "Atan2") != 25) { ret 1; }
    if (opcode_of(SPV_SET_GLSL450, "Atan")  != 18) { ret 1; }
    ret 0;
}

# the arity is per row, so a family that looks uniform but is not cannot be
# assembled with the wrong operand count. this is the fact nothing checked before
test "mach.lang.target.isa.spirv.defs:arity_is_per_instruction" {
    val defs: *isa.TargetDefs = register_defs();
    val refl: *isa.OpDef = isa.op_def_of(defs, SET_GLSL450_NAME, "Reflect");
    val refr: *isa.OpDef = isa.op_def_of(defs, SET_GLSL450_NAME, "Refract");
    val fmin: *isa.OpDef = isa.op_def_of(defs, SET_GLSL450_NAME, "FMin");
    val fcla: *isa.OpDef = isa.op_def_of(defs, SET_GLSL450_NAME, "FClamp");
    if (refl == nil || refr == nil || fmin == nil || fcla == nil) { ret 1; }
    if (refl.arity != 2) { ret 1; }
    if (refr.arity != 3) { ret 1; }
    if (fmin.arity != 2) { ret 1; }
    if (fcla.arity != 3) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.spirv.defs:an_unknown_set_matches_nothing" {
    val defs: *isa.TargetDefs = register_defs();
    if (!isa.op_set_exists(defs, SET_GLSL450_NAME)) { ret 1; }
    if (!isa.op_set_exists(defs, SET_CORE_NAME))    { ret 1; }
    # a typo in the set name is refused rather than defaulted to the extended set,
    # which is what keeps it from silently importing GLSL.std.450.
    if (isa.op_set_exists(defs, "GLSL.std.451"))    { ret 1; }
    if (set_of("GLSL.std.451") != SPV_SET_NONE)     { ret 1; }
    if (set_of("core") != SPV_SET_CORE)             { ret 1; }
    ret 0;
}
