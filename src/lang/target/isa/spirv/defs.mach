use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mach.lang.target.isa;
use mach.lang.target.isa.spirv;

pub val SPV_SET_NONE:    u8 = 0;
pub val SPV_SET_CORE:    u8 = 1;
pub val SPV_SET_GLSL450: u8 = 2;

#[testing]
pub val SPV_OP_NONE: u32 = 0xFFFFFFFF;

pub val SET_CORE_NAME:    str = "core";
pub val SET_GLSL450_NAME: str = "GLSL.std.450";

pub val CTOR_IMAGE_NAME:         str = "image";
pub val CTOR_SAMPLED_IMAGE_NAME: str = "sampled_image";
pub val CTOR_SAMPLER_NAME:       str = "sampler";

pub val SPV_CTOR_IMAGE:         u32 = 0;
pub val SPV_CTOR_SAMPLED_IMAGE: u32 = 1;
pub val SPV_CTOR_SAMPLER:       u32 = 2;

pub val TEXEL_F32: u32 = 0;
pub val TEXEL_I32: u32 = 1;
pub val TEXEL_U32: u32 = 2;

pub val IMAGE_ARITY:      u32 = 7;
pub val IMAGE_OP_TEXEL:   u32 = 0;
pub val IMAGE_OP_DIM:     u32 = 1;
pub val IMAGE_OP_DEPTH:   u32 = 2;
pub val IMAGE_OP_ARRAYED: u32 = 3;
pub val IMAGE_OP_MS:      u32 = 4;
pub val IMAGE_OP_SAMPLED: u32 = 5;
pub val IMAGE_OP_FORMAT:  u32 = 6;

pub val OP_DEF_COUNT:   usize = 53;
pub val TYPE_DEF_COUNT: usize = 3;

pub val GROUP_OPERATION_REDUCE:           u32 = 0;
pub val GROUP_OPERATION_INCLUSIVE_SCAN:   u32 = 1;
pub val GROUP_OPERATION_EXCLUSIVE_SCAN:   u32 = 2;
pub val GROUP_OPERATION_CLUSTERED_REDUCE: u32 = 3;

# the GroupOperation a non-uniform arithmetic instruction takes: a reduction or scan
# needs the GroupNonUniformArithmetic capability, and a clustered reduction needs
# GroupNonUniformClustered and is followed by its ClusterSize operand
val ARITHMETIC_GROUP_OPERATIONS: [4]isa.OpEnumerant = [4]isa.OpEnumerant{
    isa.OpEnumerant{value: GROUP_OPERATION_REDUCE, name: "Reduce", capability: spirv.CAP_GROUP_NON_UNIFORM_ARITHMETIC, requires: spirv.EXT_SUBGROUP_ARITHMETIC, trailing: 0},
    isa.OpEnumerant{value: GROUP_OPERATION_INCLUSIVE_SCAN, name: "InclusiveScan", capability: spirv.CAP_GROUP_NON_UNIFORM_ARITHMETIC, requires: spirv.EXT_SUBGROUP_ARITHMETIC, trailing: 0},
    isa.OpEnumerant{value: GROUP_OPERATION_EXCLUSIVE_SCAN, name: "ExclusiveScan", capability: spirv.CAP_GROUP_NON_UNIFORM_ARITHMETIC, requires: spirv.EXT_SUBGROUP_ARITHMETIC, trailing: 0},
    isa.OpEnumerant{value: GROUP_OPERATION_CLUSTERED_REDUCE, name: "ClusteredReduce", capability: spirv.CAP_GROUP_NON_UNIFORM_CLUSTERED, requires: spirv.EXT_SUBGROUP_CLUSTERED, trailing: 1},
};

pub val ARITHMETIC_GROUP_OPERATION: isa.OpEnum = isa.OpEnum{name: "GroupOperation", values: ?ARITHMETIC_GROUP_OPERATIONS[0], count: 4, mask: false};

pub rec DefStorage {
    ops:     [OP_DEF_COUNT]isa.OpDef;
    types:   [TYPE_DEF_COUNT]isa.TypeDef;
    img_ops: [IMAGE_ARITY]u32;
    smp_ops: [1]u32;
    defs:    isa.TargetDefs;
}

pub fun set_import_name(set: u8) str {
    if (set == SPV_SET_GLSL450) { ret SET_GLSL450_NAME; }
    ret "";
}

pub fun register_defs(storage: *DefStorage) *isa.TargetDefs {
    val spv_ops:     *isa.OpDef   = ?storage.ops[0];
    val spv_types:   *isa.TypeDef = ?storage.types[0];
    val spv_img_ops: *u32         = ?storage.img_ops[0];
    val spv_smp_ops: *u32         = ?storage.smp_ops[0];
    spv_ops[0] = isa.op_def(SET_CORE_NAME, "OpDot", SPV_SET_CORE::u32, spirv.OP_DOT, 2);
    spv_ops[1] = isa.op_def(SET_CORE_NAME, "OpSampledImage", SPV_SET_CORE::u32, spirv.OP_SAMPLED_IMAGE, 2);
    spv_ops[2] = isa.op_def(SET_CORE_NAME, "OpImageSampleImplicitLod", SPV_SET_CORE::u32, spirv.OP_IMAGE_SAMPLE_IMPLICIT_LOD, 2);

    spv_ops[3] = isa.op_def(SET_GLSL450_NAME, "FAbs", SPV_SET_GLSL450::u32, 4, 1);
    spv_ops[4] = isa.op_def(SET_GLSL450_NAME, "FSign", SPV_SET_GLSL450::u32, 6, 1);
    spv_ops[5] = isa.op_def(SET_GLSL450_NAME, "Floor", SPV_SET_GLSL450::u32, 8, 1);
    spv_ops[6] = isa.op_def(SET_GLSL450_NAME, "Ceil", SPV_SET_GLSL450::u32, 9, 1);
    spv_ops[7] = isa.op_def(SET_GLSL450_NAME, "Fract", SPV_SET_GLSL450::u32, 10, 1);

    spv_ops[8]  = isa.op_def(SET_GLSL450_NAME, "Radians", SPV_SET_GLSL450::u32, 11, 1);
    spv_ops[9]  = isa.op_def(SET_GLSL450_NAME, "Degrees", SPV_SET_GLSL450::u32, 12, 1);
    spv_ops[10] = isa.op_def(SET_GLSL450_NAME, "Sin", SPV_SET_GLSL450::u32, 13, 1);
    spv_ops[11] = isa.op_def(SET_GLSL450_NAME, "Cos", SPV_SET_GLSL450::u32, 14, 1);
    spv_ops[12] = isa.op_def(SET_GLSL450_NAME, "Tan", SPV_SET_GLSL450::u32, 15, 1);
    spv_ops[13] = isa.op_def(SET_GLSL450_NAME, "Asin", SPV_SET_GLSL450::u32, 16, 1);
    spv_ops[14] = isa.op_def(SET_GLSL450_NAME, "Acos", SPV_SET_GLSL450::u32, 17, 1);
    spv_ops[15] = isa.op_def(SET_GLSL450_NAME, "Atan", SPV_SET_GLSL450::u32, 18, 1);
    spv_ops[16] = isa.op_def(SET_GLSL450_NAME, "Atan2", SPV_SET_GLSL450::u32, 25, 2);

    spv_ops[17] = isa.op_def(SET_GLSL450_NAME, "Pow", SPV_SET_GLSL450::u32, 26, 2);
    spv_ops[18] = isa.op_def(SET_GLSL450_NAME, "Exp", SPV_SET_GLSL450::u32, 27, 1);
    spv_ops[19] = isa.op_def(SET_GLSL450_NAME, "Log", SPV_SET_GLSL450::u32, 28, 1);
    spv_ops[20] = isa.op_def(SET_GLSL450_NAME, "Exp2", SPV_SET_GLSL450::u32, 29, 1);
    spv_ops[21] = isa.op_def(SET_GLSL450_NAME, "Log2", SPV_SET_GLSL450::u32, 30, 1);
    spv_ops[22] = isa.op_def(SET_GLSL450_NAME, "Sqrt", SPV_SET_GLSL450::u32, 31, 1);
    spv_ops[23] = isa.op_def(SET_GLSL450_NAME, "InverseSqrt", SPV_SET_GLSL450::u32, 32, 1);

    spv_ops[24] = isa.op_def(SET_GLSL450_NAME, "FMin", SPV_SET_GLSL450::u32, 37, 2);
    spv_ops[25] = isa.op_def(SET_GLSL450_NAME, "FMax", SPV_SET_GLSL450::u32, 40, 2);
    spv_ops[26] = isa.op_def(SET_GLSL450_NAME, "FClamp", SPV_SET_GLSL450::u32, 43, 3);
    spv_ops[27] = isa.op_def(SET_GLSL450_NAME, "FMix", SPV_SET_GLSL450::u32, 46, 3);
    spv_ops[28] = isa.op_def(SET_GLSL450_NAME, "Step", SPV_SET_GLSL450::u32, 48, 2);
    spv_ops[29] = isa.op_def(SET_GLSL450_NAME, "SmoothStep", SPV_SET_GLSL450::u32, 49, 3);
    spv_ops[30] = isa.op_def(SET_GLSL450_NAME, "Fma", SPV_SET_GLSL450::u32, 50, 3);

    spv_ops[31] = isa.op_def(SET_GLSL450_NAME, "Length", SPV_SET_GLSL450::u32, 66, 1);
    spv_ops[32] = isa.op_def(SET_GLSL450_NAME, "Distance", SPV_SET_GLSL450::u32, 67, 2);
    spv_ops[33] = isa.op_def(SET_GLSL450_NAME, "Cross", SPV_SET_GLSL450::u32, 68, 2);
    spv_ops[34] = isa.op_def(SET_GLSL450_NAME, "Normalize", SPV_SET_GLSL450::u32, 69, 1);
    spv_ops[35] = isa.op_def(SET_GLSL450_NAME, "FaceForward", SPV_SET_GLSL450::u32, 70, 3);
    spv_ops[36] = isa.op_def(SET_GLSL450_NAME, "Reflect", SPV_SET_GLSL450::u32, 71, 2);
    spv_ops[37] = isa.op_def(SET_GLSL450_NAME, "Refract", SPV_SET_GLSL450::u32, 72, 3);

    # operand signatures: `v` value, `c` constant id (Scope, MemorySemantics), `l` literal
    # word, `r`/`w`/`u` a pointer read, stored or read and written through, its storage
    # class the call site's
    # execution scope, memory scope and semantics. every invocation of the execution scope
    # must reach it in uniform control flow, which is the program's obligation
    spv_ops[38] = isa.op_def_shaped(SET_CORE_NAME, "OpControlBarrier", SPV_SET_CORE::u32,
        spirv.OP_CONTROL_BARRIER, isa.OP_RESULT_NONE, isa.NO_OP_SPACE, "ccc");
    spv_ops[39] = isa.op_def_shaped(SET_CORE_NAME, "OpAtomicLoad", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_LOAD, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "rcc");
    spv_ops[40] = isa.op_def_shaped(SET_CORE_NAME, "OpAtomicIAdd", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_I_ADD, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "uccv");
    # the image-operands mask is a literal word, and the `Lod` bit it sets takes the fourth operand
    spv_ops[41] = isa.op_def_shaped(SET_CORE_NAME, "OpImageSampleExplicitLod", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_SAMPLE_EXPLICIT_LOD, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "vvlv");
    # a texel's address inside an image variable, the pointer an image atomic takes
    spv_ops[42] = isa.op_def_shaped(SET_CORE_NAME, "OpImageTexelPointer", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_TEXEL_POINTER, isa.OP_RESULT_POINTER, spirv.STORAGE_IMAGE, "rvv");
    spv_ops[43] = isa.op_def_shaped(SET_CORE_NAME, "OpAtomicStore", SPV_SET_CORE::u32,
        spirv.OP_ATOMIC_STORE, isa.OP_RESULT_NONE, isa.NO_OP_SPACE, "wccv");
    # memory scope and semantics, ordering memory without waiting for other invocations
    spv_ops[44] = isa.op_def_shaped(SET_CORE_NAME, "OpMemoryBarrier", SPV_SET_CORE::u32,
        spirv.OP_MEMORY_BARRIER, isa.OP_RESULT_NONE, isa.NO_OP_SPACE, "cc");
    # the Subgroup scope, the GroupOperation, the value, and the ClusterSize a
    # `ClusteredReduce` brings. the operation's value decides the capability
    spv_ops[45] = isa.op_enumerated(isa.op_def_shaped(SET_CORE_NAME, "OpGroupNonUniformIAdd", SPV_SET_CORE::u32,
        spirv.OP_GROUP_NON_UNIFORM_I_ADD, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "clv|c"), 1, ?ARITHMETIC_GROUP_OPERATION);
    # a storage image's texel read and written directly, and a sampled image's or a
    # uniform texel buffer's fetched, the image a handle value whose memory it touches
    spv_ops[46] = isa.op_def_shaped(SET_CORE_NAME, "OpImageRead", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_READ, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "iv");
    spv_ops[47] = isa.op_def_shaped(SET_CORE_NAME, "OpImageWrite", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_WRITE, isa.OP_RESULT_NONE, isa.NO_OP_SPACE, "ovv");
    spv_ops[48] = isa.op_def_shaped(SET_CORE_NAME, "OpImageFetch", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_FETCH, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "iv");
    # an image's extent, level count and sample count, which read its descriptor and none of its texels
    spv_ops[49] = isa.op_requiring(isa.op_def_shaped(SET_CORE_NAME, "OpImageQuerySizeLod", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_QUERY_SIZE_LOD, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "vv"), spirv.CAP_IMAGE_QUERY, 0);
    spv_ops[50] = isa.op_requiring(isa.op_def_shaped(SET_CORE_NAME, "OpImageQuerySize", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_QUERY_SIZE, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "v"), spirv.CAP_IMAGE_QUERY, 0);
    spv_ops[51] = isa.op_requiring(isa.op_def_shaped(SET_CORE_NAME, "OpImageQueryLevels", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_QUERY_LEVELS, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "v"), spirv.CAP_IMAGE_QUERY, 0);
    spv_ops[52] = isa.op_requiring(isa.op_def_shaped(SET_CORE_NAME, "OpImageQuerySamples", SPV_SET_CORE::u32,
        spirv.OP_IMAGE_QUERY_SAMPLES, isa.OP_RESULT_VALUE, isa.NO_OP_SPACE, "v"), spirv.CAP_IMAGE_QUERY, 0);

    var i: u32 = 0;
    for (i < IMAGE_ARITY) {
        spv_img_ops[i] = isa.TYPE_OPERAND_WORD;
        i              = i + 1;
    }
    spv_smp_ops[0] = SPV_CTOR_IMAGE;

    spv_types[0] = isa.type_def(CTOR_IMAGE_NAME, SPV_CTOR_IMAGE,
        ?spv_img_ops[0], IMAGE_ARITY, refuse_image);
    spv_types[0].bind = bind_image;
    spv_types[1]      = isa.type_def(CTOR_SAMPLED_IMAGE_NAME, SPV_CTOR_SAMPLED_IMAGE,
        ?spv_smp_ops[0], 1, nil);
    spv_types[1].compose = compose_sampled_image;
    spv_types[2]         = isa.type_def(CTOR_SAMPLER_NAME, SPV_CTOR_SAMPLER, nil, 0, nil);

    storage.defs = isa.target_defs(spv_ops, OP_DEF_COUNT::u32, spv_types, TYPE_DEF_COUNT::u32);
    ret ?storage.defs;
}

fun refuse_image(ops: *u32, n: u32) str {
    if (n != IMAGE_ARITY) { ret nil; }

    val sampled: u32 = ops[IMAGE_OP_SAMPLED];
    if (sampled != spirv.IMAGE_SAMPLED_YES && sampled != spirv.IMAGE_SAMPLED_STORAGE) {
        ret "the `Sampled` operand is neither `1` nor `2`: `1` is an image read through a sampler and bound by `#[sampler(set, binding)]`, `2` a storage image read and written directly and bound by `#[storage(set, binding)]`. Vulkan admits no other, since `0` defers the choice to run time";
    }
    if (ops[IMAGE_OP_TEXEL] > TEXEL_U32) {
        ret "the texel-scalar operand names no scalar this target reads: an image's texels are `f32`, `i32` or `u32`, and a read's or a sample's result type must share the image's component type, so a word outside that set would declare an image no result type can match";
    }
    if (ops[IMAGE_OP_DEPTH] != 0) {
        ret "the `Depth` operand is not `0`, and depth-comparison sampling is out of scope: a depth image is sampled by `OpImageSampleDref*`, which takes a reference value the sampling operation here has no operand for. it is refused rather than emitted as an ordinary image, which would compile and compare nothing";
    }
    if (ops[IMAGE_OP_MS] != 0) {
        ret "the `MS` operand is not `0`, and a multisampled image is not sampled at all: it is FETCHED per sample by `OpImageFetch` with a `Sample` image operand, which is a different instruction with an operand mask this cut does not carry. a multisampled image sampled as an ordinary one would be an invalid module";
    }
    val dim: u32 = ops[IMAGE_OP_DIM];
    if (dim > spirv.DIM_CUBE && dim != spirv.DIM_BUFFER) {
        ret "the `Dim` operand names a dimensionality this target does not bind: `Rect` is an unnormalized-coordinate image and `SubpassData` an input attachment read within a render pass. `1D`, `2D`, `3D`, `Cube` and `Buffer` are the dimensionalities this target binds";
    }
    if (ops[IMAGE_OP_ARRAYED] > 1) {
        ret "the `Arrayed` operand is neither `0` nor `1`: it is a flag, and a word outside that set would be written into the module verbatim as an arrayedness the spec does not define";
    }
    if (dim == spirv.DIM_BUFFER && ops[IMAGE_OP_ARRAYED] != 0) {
        ret "the `Arrayed` operand is `1` on a `Buffer` image: a texel buffer is one run of texels in a buffer view, which has no layers to index";
    }
    val fmt: u32 = ops[IMAGE_OP_FORMAT];
    if (fmt >= spirv.IMAGE_FORMAT_FIRST_INT64) {
        ret "the `Image Format` operand names no format this target declares: `R64ui` and `R64i` need the `Int64ImageEXT` capability and 64-bit texels, and every word past them is no format at all. `0` is `Unknown`, and `1` to `39` the formats `Rgba32f` to `R8ui`";
    }
    if (fmt != spirv.IMAGE_FORMAT_UNKNOWN && format_texel(fmt) != ops[IMAGE_OP_TEXEL]) {
        ret "the `Image Format` operand does not match the texel-scalar operand: a float or normalized format is read as `f32`, a signed integer format as `i32` and an unsigned one as `u32`, and Vulkan requires the image's texel type to be the one its format converts to";
    }
    ret nil;
}

# the texel scalar a known format converts to
fun format_texel(fmt: u32) u32 {
    if (fmt <= spirv.IMAGE_FORMAT_LAST_FLOAT) { ret TEXEL_F32; }
    if (fmt <= spirv.IMAGE_FORMAT_LAST_SINT)  { ret TEXEL_I32; }
    ret TEXEL_U32;
}

# a storage image binds as a storage descriptor, and a sampled one as a sampler
fun bind_image(ops: *u32, n: u32) u32 {
    if (n == IMAGE_ARITY && ops[IMAGE_OP_SAMPLED] == spirv.IMAGE_SAMPLED_STORAGE) { ret isa.HANDLE_BIND_STORAGE; }
    ret isa.HANDLE_BIND_SAMPLER;
}

fun compose_sampled_image(index: u32, ops: *u32, n: u32) str {
    if (n != IMAGE_ARITY) { ret nil; }
    if (ops[IMAGE_OP_SAMPLED] == spirv.IMAGE_SAMPLED_STORAGE) {
        ret "a sampled image composes over an image whose `Sampled` operand is `1`: the image named here is a storage image, which is read and written directly by `OpImageRead` and `OpImageWrite` and is never sampled";
    }
    if (ops[IMAGE_OP_DIM] == spirv.DIM_BUFFER) {
        ret "a sampled image cannot compose over a `Buffer` image: a uniform texel buffer is read texel by texel, never sampled, and from SPIR-V 1.6 a sampled image of one is an invalid module";
    }
    ret nil;
}

#[testing]
pub fun opcode_of(definitions: *isa.TargetDefs, set: u8, name: str) u32 {
    var set_name: str = SET_CORE_NAME;
    if (set == SPV_SET_GLSL450) { set_name = SET_GLSL450_NAME; }
    or (set != SPV_SET_CORE)    { ret SPV_OP_NONE; }
    val d: *isa.OpDef = isa.op_def_of(definitions, set_name, name);
    if (d == nil) { ret SPV_OP_NONE; }
    ret d.opcode;
}

#[testing]
pub fun set_of(name: str) u8 {
    if (str_equals(name, SET_CORE_NAME))    { ret SPV_SET_CORE; }
    if (str_equals(name, SET_GLSL450_NAME)) { ret SPV_SET_GLSL450; }
    ret SPV_SET_NONE;
}

# a name resolves only in its own set, and only as a whole name, never as a prefix
test opcode_of__sets_are_separate_and_names_match_whole {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    if (opcode_of(definitions, SPV_SET_CORE, "OpDot") != 148)            { ret 1; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "OpDot") != SPV_OP_NONE) { ret 1; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Sqrt") != 31)           { ret 1; }
    if (opcode_of(definitions, SPV_SET_CORE, "Sqrt") != SPV_OP_NONE)     { ret 1; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Exp2") != 29)           { ret 2; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Exp") != 27)            { ret 2; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Atan2") != 25)          { ret 2; }
    if (opcode_of(definitions, SPV_SET_GLSL450, "Atan") != 18)           { ret 2; }
    ret 0;
}

test op_def__arity_is_per_instruction {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    val refl:        *isa.OpDef      = isa.op_def_of(definitions, SET_GLSL450_NAME, "Reflect");
    val refr:        *isa.OpDef      = isa.op_def_of(definitions, SET_GLSL450_NAME, "Refract");
    if (refl == nil || refr == nil) { ret 1; }
    if (refl.arity != 2)            { ret 1; }
    if (refr.arity != 3)            { ret 1; }
    # a signature row carries its arity, its operand kinds and its result shape
    val add: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpAtomicIAdd");
    if (add == nil || add.arity != 4 || add.result != isa.OP_RESULT_VALUE) { ret 2; }
    if (isa.op_operand_kind(add, 0) != isa.OP_OPERAND_POINTER_UPDATE
        || isa.op_operand_kind(add, 1) != isa.OP_OPERAND_CONSTANT
        || isa.op_operand_kind(add, 3) != isa.OP_OPERAND_VALUE) { ret 2; }
    val bar: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpControlBarrier");
    if (bar == nil || bar.result != isa.OP_RESULT_NONE) { ret 3; }
    val mem: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpMemoryBarrier");
    if (mem == nil || mem.arity != 2 || mem.result != isa.OP_RESULT_NONE || mem.opcode != spirv.OP_MEMORY_BARRIER)        { ret 3; }
    if (isa.op_operand_kind(mem, 0) != isa.OP_OPERAND_CONSTANT || isa.op_operand_kind(mem, 1) != isa.OP_OPERAND_CONSTANT) { ret 3; }
    val tex: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageTexelPointer");
    if (tex == nil || tex.result != isa.OP_RESULT_POINTER || tex.result_space != spirv.STORAGE_IMAGE) { ret 4; }
    if (isa.op_operand_kind(refl, 0) != isa.OP_OPERAND_VALUE || refl.result != isa.OP_RESULT_VALUE)   { ret 5; }
    val rd: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageRead");
    val wr: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageWrite");
    if (rd == nil || rd.result != isa.OP_RESULT_VALUE || isa.op_operand_kind(rd, 0) != isa.OP_OPERAND_HANDLE_READ) { ret 6; }
    if (wr == nil || wr.result != isa.OP_RESULT_NONE || isa.op_operand_kind(wr, 0) != isa.OP_OPERAND_HANDLE_WRITE) { ret 6; }
    val qs: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpImageQuerySize");
    if (qs == nil || qs.capability != spirv.CAP_IMAGE_QUERY || rd.capability != isa.NO_OP_CAPABILITY) { ret 7; }
    # an optional tail and the literal whose value decides it
    val iadd: *isa.OpDef = isa.op_def_of(definitions, SET_CORE_NAME, "OpGroupNonUniformIAdd");
    if (iadd == nil || iadd.arity != 4 || iadd.min_arity != 3)                { ret 6; }
    if (isa.op_operand_enum(iadd, 1) != ?ARITHMETIC_GROUP_OPERATION)          { ret 6; }
    if (add.min_arity != add.arity || add.capability != isa.NO_OP_CAPABILITY) { ret 7; }
    ret 0;
}

# every capability a row or an enumerant names is one the capability table declares
test op_def__every_capability_is_in_the_table {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    var i:           u32             = 0;
    for (i < definitions.op_count) {
        val d: *isa.OpDef = ?definitions.ops[i];
        if (isa.op_def_shape_refusal(d) != nil)                                               { ret 1; }
        if (d.capability != isa.NO_OP_CAPABILITY && spirv.capability_of(d.capability) == nil) { ret 2; }
        var k: u32 = 0;
        for (k < d.arity) {
            val en: *isa.OpEnum = isa.op_operand_enum(d, k);
            var v:  u32         = 0;
            for (en != nil && v < en.count) {
                val cap: u32 = en.values[v].capability;
                if (cap != isa.NO_OP_CAPABILITY && spirv.capability_of(cap) == nil) { ret 3; }
                v = v + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test set_of__an_unknown_set_matches_nothing {
    var storage:     DefStorage;
    val definitions: *isa.TargetDefs = register_defs(?storage);
    if (!isa.op_set_exists(definitions, SET_GLSL450_NAME)) { ret 1; }
    if (!isa.op_set_exists(definitions, SET_CORE_NAME))    { ret 1; }
    if (isa.op_set_exists(definitions, "GLSL.std.451"))    { ret 1; }
    if (set_of("GLSL.std.451") != SPV_SET_NONE)            { ret 1; }
    if (set_of("core") != SPV_SET_CORE)                    { ret 1; }
    ret 0;
}
