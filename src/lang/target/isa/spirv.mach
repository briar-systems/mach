pub rec Builder {
    alloc:        *A.Allocator;
    next_id:      u32;
    caps:         Vec;
    ext_imports:  Vec;
    memory_model: Vec;
    entry_points: Vec;
    exec_modes:   Vec;
    decorations:  Vec;
    types_consts: Vec;
    functions:    Vec;
    caps_needed:  u32;
    version:      u32;
    err:          bool;
}

pub rec Vec {
    words: *u32;
    len:   u32;
    cap:   u32;
}

rec SpvWordUnit {
}

val VEC_INIT_CAP: u32 = 32;

fun vec_init() Vec {
    var v: Vec;
    v.words = nil;
    v.len   = 0;
    v.cap   = 0;
    ret v;
}

fun vec_push(b: *Builder, v: *Vec, w: u32) {
    if (b.err) { ret; }
    if (v.len >= v.cap) {
        var new_cap: u32 = VEC_INIT_CAP;
        if (v.cap > 0) {
            val doubled: R.Result[layout.CheckedCount[SpvWordUnit], layout.CheckCause] =
                layout.count_mul[SpvWordUnit](layout.count[SpvWordUnit](v.cap::usize), 2::usize);
            if (R.is_err[layout.CheckedCount[SpvWordUnit], layout.CheckCause](doubled)) {
                b.err = true; ret;
            }
            val fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
                R.unwrap_ok[layout.CheckedCount[SpvWordUnit], layout.CheckCause](doubled).value);
            if (R.is_err[u32, layout.CheckCause](fits)) { b.err = true; ret; }
            new_cap = R.unwrap_ok[u32, layout.CheckCause](fits);
        }
        if (v.words == nil) {
            val ra: R.Result[*u32, str] = A.allocate[u32](b.alloc, new_cap::usize);
            if (R.is_err[*u32, str](ra)) { b.err = true; ret; }
            v.words = R.unwrap_ok[*u32, str](ra);
        }
        or {
            val rr: R.Result[*u32, str] = A.reallocate[u32](b.alloc, v.words, v.cap::usize, new_cap::usize);
            if (R.is_err[*u32, str](rr)) { b.err = true; ret; }
            v.words = R.unwrap_ok[*u32, str](rr);
        }
        v.cap = new_cap;
    }
    v.words[v.len] = w;
    v.len = v.len + 1;
}

fun vec_dnit(b: *Builder, v: *Vec) {
    if (v.words != nil && v.cap > 0) {
        A.deallocate[u32](b.alloc, v.words, v.cap::usize);
    }
    v.words = nil;
    v.len   = 0;
    v.cap   = 0;
}

pub fun builder_init(alloc: *A.Allocator) Builder {
    var b: Builder;
    b.alloc        = alloc;
    b.next_id      = 1;
    b.caps         = vec_init();
    b.ext_imports  = vec_init();
    b.memory_model = vec_init();
    b.entry_points = vec_init();
    b.exec_modes   = vec_init();
    b.decorations  = vec_init();
    b.types_consts = vec_init();
    b.functions    = vec_init();
    b.caps_needed  = 0;
    b.version      = SPV_VERSION_1_6;
    b.err          = false;
    ret b;
}

pub fun builder_dnit(b: *Builder) {
    vec_dnit(b, ?b.caps);
    vec_dnit(b, ?b.ext_imports);
    vec_dnit(b, ?b.memory_model);
    vec_dnit(b, ?b.entry_points);
    vec_dnit(b, ?b.exec_modes);
    vec_dnit(b, ?b.decorations);
    vec_dnit(b, ?b.types_consts);
    vec_dnit(b, ?b.functions);
}

pub fun alloc_id(b: *Builder) u32 {
    val id: u32 = b.next_id;
    b.next_id = b.next_id + 1;
    ret id;
}

pub fun inst_word(opcode: u32, words: u32) u32 {
    ret (words << 16) | (opcode & 0xFFFF);
}

pub fun inst(b: *Builder, v: *Vec, opcode: u32, ops: *u32, n: u32) {
    vec_push(b, v, inst_word(opcode, n + 1));
    var i: u32 = 0;
    for (i < n) {
        vec_push(b, v, ops[i]);
        i = i + 1;
    }
}

pub fun ext_inst_import(b: *Builder, set: str) u32 {
    val id: u32 = alloc_id(b);
    var ops: [17]u32;
    ops[0] = id;
    val n_r: R.Result[u32, str] = string_words(set);
    if (R.is_err[u32, str](n_r)) { b.err = true; ret id; }
    val n: u32 = R.unwrap_ok[u32, str](n_r);
    if (n > 16) { b.err = true; ret id; }
    pack_string(set, n, ?ops[1]);
    inst(b, ?b.ext_imports, OP_EXT_INST_IMPORT, ?ops[0], 1 + n);
    ret id;
}

pub fun string_words(s: str) R.Result[u32, str] {
    val len_r: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(str_len(s));
    if (R.is_err[u32, layout.CheckCause](len_r)) {
        ret R.err[u32, str]("spirv: identifier length exceeds the u32 limit");
    }
    val len: usize = R.unwrap_ok[u32, layout.CheckCause](len_r)::usize;
    ret R.ok[u32, str](((len + 4) / 4)::u32);
}

pub fun pack_string(s: str, words: u32, out: *u32) {
    val n: usize = str_len(s);
    var wi: u32 = 0;
    for (wi < words) {
        var w: u32 = 0;
        var byte: u32 = 0;
        for (byte < 4) {
            val idx: usize = (wi * 4 + byte)::usize;
            var b: u32 = 0;
            if (idx < n) { b = s[idx]::u32; }
            w = w | (b << (byte * 8));
            byte = byte + 1;
        }
        out[wi] = w;
        wi = wi + 1;
    }
}

fun word_count_add(acc: R.Result[layout.CheckedCount[SpvWordUnit], layout.CheckCause], len: u32)
                   R.Result[layout.CheckedCount[SpvWordUnit], layout.CheckCause] {
    if (R.is_err[layout.CheckedCount[SpvWordUnit], layout.CheckCause](acc)) { ret acc; }
    ret layout.count_add[SpvWordUnit](
        R.unwrap_ok[layout.CheckedCount[SpvWordUnit], layout.CheckCause](acc),
        layout.count[SpvWordUnit](len::usize));
}

pub fun serialize(b: *Builder, out_len: *u32) R.Result[*u8, str] {
    if (b.err) { ret R.err[*u8, str]("spirv: module builder hit an allocation error"); }

    var words_r: R.Result[layout.CheckedCount[SpvWordUnit], layout.CheckCause] =
        R.ok[layout.CheckedCount[SpvWordUnit], layout.CheckCause](layout.count[SpvWordUnit](5::usize));
    words_r = word_count_add(words_r, b.caps.len);
    words_r = word_count_add(words_r, b.ext_imports.len);
    words_r = word_count_add(words_r, b.memory_model.len);
    words_r = word_count_add(words_r, b.entry_points.len);
    words_r = word_count_add(words_r, b.exec_modes.len);
    words_r = word_count_add(words_r, b.decorations.len);
    words_r = word_count_add(words_r, b.types_consts.len);
    words_r = word_count_add(words_r, b.functions.len);
    if (R.is_err[layout.CheckedCount[SpvWordUnit], layout.CheckCause](words_r)) {
        ret R.err[*u8, str]("spirv: module word count overflow");
    }
    val total_words_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[SpvWordUnit], layout.CheckCause](words_r).value);
    if (R.is_err[u32, layout.CheckCause](total_words_fits)) {
        ret R.err[*u8, str]("spirv: module word count exceeds the u32 limit");
    }
    val total_words: u32 = R.unwrap_ok[u32, layout.CheckCause](total_words_fits);

    val bytes_r: R.Result[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
        layout.count_mul[layout.ByteUnit](layout.count[layout.ByteUnit](total_words::usize), 4::usize);
    if (R.is_err[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](bytes_r)) {
        ret R.err[*u8, str]("spirv: module byte size overflow");
    }
    val total_bytes_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[layout.ByteUnit], layout.CheckCause](bytes_r).value);
    if (R.is_err[u32, layout.CheckCause](total_bytes_fits)) {
        ret R.err[*u8, str]("spirv: module byte size exceeds the u32 limit");
    }
    val total_bytes: u32 = R.unwrap_ok[u32, layout.CheckCause](total_bytes_fits);

    val rb: R.Result[*u8, str] = A.allocate[u8](b.alloc, total_bytes::usize);
    if (R.is_err[*u8, str](rb)) { ret rb; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var pos: u32 = 0;
    pos = put_word(buf, pos, SPV_MAGIC);
    pos = put_word(buf, pos, b.version);
    pos = put_word(buf, pos, SPV_GENERATOR);
    pos = put_word(buf, pos, b.next_id);
    pos = put_word(buf, pos, 0);

    pos = put_section(buf, pos, ?b.caps);
    pos = put_section(buf, pos, ?b.ext_imports);
    pos = put_section(buf, pos, ?b.memory_model);
    pos = put_section(buf, pos, ?b.entry_points);
    pos = put_section(buf, pos, ?b.exec_modes);
    pos = put_section(buf, pos, ?b.decorations);
    pos = put_section(buf, pos, ?b.types_consts);
    pos = put_section(buf, pos, ?b.functions);

    @out_len = total_bytes;
    ret R.ok[*u8, str](buf);
}

fun put_word(buf: *u8, pos: u32, w: u32) u32 {
    buf[pos]     = (w & 0xFF)::u8;
    buf[pos + 1] = ((w >> 8) & 0xFF)::u8;
    buf[pos + 2] = ((w >> 16) & 0xFF)::u8;
    buf[pos + 3] = ((w >> 24) & 0xFF)::u8;
    ret pos + 4;
}

fun put_section(buf: *u8, pos: u32, v: *Vec) u32 {
    var p: u32 = pos;
    var i: u32 = 0;
    for (i < v.len) {
        p = put_word(buf, p, v.words[i]);
        i = i + 1;
    }
    ret p;
}

test "mach.lang.target.isa.spirv.inst_word:pack" {
    if (inst_word(OP_I_ADD, 5) != 0x00050080) { ret 1; }
    if (inst_word(OP_CAPABILITY, 2) != 0x00020011) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.spirv.pack_string:linkage_name" {
    val n1_r: R.Result[u32, str] = string_words("add");
    if (R.is_err[u32, str](n1_r)) { ret 1; }
    val n1: u32 = R.unwrap_ok[u32, str](n1_r);
    if (n1 != 1) { ret 1; }
    var w: [4]u32;
    pack_string("add", n1, ?w[0]);
    if (w[0] != 0x00646461) { ret 1; }

    val n2_r: R.Result[u32, str] = string_words("main");
    if (R.is_err[u32, str](n2_r)) { ret 1; }
    if (R.unwrap_ok[u32, str](n2_r) != 2) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.spirv.serialize:header_and_bound" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var b: Builder = builder_init(?alloc);

    var caps: [1]u32;
    caps[0] = CAP_SHADER;
    inst(?b, ?b.caps, OP_CAPABILITY, ?caps[0], 1);
    caps[0] = CAP_LINKAGE;
    inst(?b, ?b.caps, OP_CAPABILITY, ?caps[0], 1);
    var mm: [2]u32;
    mm[0] = ADDRESSING_LOGICAL;
    mm[1] = MEMORY_GLSL450;
    inst(?b, ?b.memory_model, OP_MEMORY_MODEL, ?mm[0], 2);

    alloc_id(?b); alloc_id(?b); alloc_id(?b);

    var len: u32 = 0;
    val rs: R.Result[*u8, str] = serialize(?b, ?len);
    builder_dnit(?b);
    if (R.is_err[*u8, str](rs)) { ret 1; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rs);

    if (read_word(buf, 0) != SPV_MAGIC)        { A.deallocate[u8](?alloc, buf, len::usize); ret 1; }
    if (read_word(buf, 4) != SPV_VERSION_1_6)  { A.deallocate[u8](?alloc, buf, len::usize); ret 1; }
    if (read_word(buf, 12) != 4)               { A.deallocate[u8](?alloc, buf, len::usize); ret 1; }
    if (read_word(buf, 20) != 0x00020011)      { A.deallocate[u8](?alloc, buf, len::usize); ret 1; }
    if (read_word(buf, 24) != CAP_SHADER)      { A.deallocate[u8](?alloc, buf, len::usize); ret 1; }

    A.deallocate[u8](?alloc, buf, len::usize);
    ret 0;
}

fun read_word(buf: *u8, pos: u32) u32 {
    ret buf[pos]::u32 | (buf[pos + 1]::u32 << 8) | (buf[pos + 2]::u32 << 16) | (buf[pos + 3]::u32 << 24);
}

rec SpvGrowthProbe {
    reallocate_calls: u32;
    allocate_calls:   u32;
}

fun spv_growth_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val g: *SpvGrowthProbe = ctx::*SpvGrowthProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret O.none[ptr]();
}

fun spv_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *SpvGrowthProbe = ctx::*SpvGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun spv_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.target.isa.spirv.vec_push:refuses_capacity_overflow_before_reallocating" {
    var probe: SpvGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *SpvGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = spv_growth_probe_allocate;
    alloc.fn_reallocate = spv_growth_probe_reallocate;
    alloc.fn_deallocate = spv_growth_probe_deallocate;

    var b: Builder = builder_init(?alloc);
    var dummy: u32;
    b.caps.words = ?dummy;
    b.caps.cap   = 0x80000000;
    b.caps.len   = 0x80000000;

    vec_push(?b, ?b.caps, 7);

    var bad: i32 = 0;
    if (!b.err)                       { bad = 1; }
    if (probe.reallocate_calls != 0)  { bad = 2; }
    if (b.caps.cap != 0x80000000)     { bad = 3; }
    if (b.caps.len != 0x80000000)     { bad = 4; }
    ret bad;
}

test "mach.lang.target.isa.spirv.serialize:refuses_word_count_overflow_before_allocating" {
    var probe: SpvGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *SpvGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = spv_growth_probe_allocate;
    alloc.fn_reallocate = spv_growth_probe_reallocate;
    alloc.fn_deallocate = spv_growth_probe_deallocate;

    var b: Builder = builder_init(?alloc);
    b.caps.len = 0xFFFFFFFF;

    var len: u32 = 0;
    val rs: R.Result[*u8, str] = serialize(?b, ?len);
    var bad: i32 = 0;
    if (!R.is_err[*u8, str](rs))     { bad = 1; }
    if (probe.allocate_calls != 0)   { bad = 2; }
    ret bad;
}

test "mach.lang.target.isa.spirv.serialize:refuses_byte_size_overflow_past_the_word_boundary_before_allocating" {
    var probe: SpvGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp: *SpvGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = spv_growth_probe_allocate;
    alloc.fn_reallocate = spv_growth_probe_reallocate;
    alloc.fn_deallocate = spv_growth_probe_deallocate;

    var b: Builder = builder_init(?alloc);
    b.caps.len = 0x40000000 - 5;

    var len: u32 = 0;
    val rs: R.Result[*u8, str] = serialize(?b, ?len);
    var bad: i32 = 0;
    if (!R.is_err[*u8, str](rs))     { bad = 1; }
    if (probe.allocate_calls != 0)   { bad = 2; }
    ret bad;
}
