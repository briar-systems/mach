    extension.Extension{name: "shared_float16_atomics", bit: EXT_SHARED_FLOAT16_ATOMICS, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "shared_float16_atomic_add", bit: EXT_SHARED_FLOAT16_ATOMIC_ADD, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "shared_float16_atomic_min_max", bit: EXT_SHARED_FLOAT16_ATOMIC_MIN_MAX, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "storage_buffer_16bit_access", bit: EXT_STORAGE_BUFFER_16BIT_ACCESS, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "uniform_and_storage_buffer_16bit_access", bit: EXT_UNIFORM_AND_STORAGE_BUFFER_16BIT_ACCESS, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "storage_push_constant16", bit: EXT_STORAGE_PUSH_CONSTANT16, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "storage_input_output16", bit: EXT_STORAGE_INPUT_OUTPUT16, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "storage_buffer_8bit_access", bit: EXT_STORAGE_BUFFER_8BIT_ACCESS, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "uniform_and_storage_buffer_8bit_access", bit: EXT_UNIFORM_AND_STORAGE_BUFFER_8BIT_ACCESS, implies: 0, target_only: ONLY_DEVICE},
    extension.Extension{name: "storage_push_constant8", bit: EXT_STORAGE_PUSH_CONSTANT8, implies: 0, target_only: ONLY_DEVICE},
};

# every extension of the vocabulary, which a module naming no environment holds
pub val EXT_OPEN: u64 = EXT_FLOAT16 | EXT_ZERO_INIT_WORKGROUP | EXT_SUBGROUP_ARITHMETIC | EXT_SUBGROUP_CLUSTERED
    | EXT_STORAGE_READ_WITHOUT_FORMAT | EXT_STORAGE_WRITE_WITHOUT_FORMAT
    | EXT_SUBGROUP_VOTE | EXT_SUBGROUP_BALLOT | EXT_SUBGROUP_SHUFFLE | EXT_SUBGROUP_SHUFFLE_RELATIVE | EXT_SUBGROUP_QUAD
    | EXT_SUBGROUP_GRAPHICS_STAGES | EXT_ATOMICS | EXT_STORAGE_IMAGE_MULTISAMPLE | EXT_RESOURCE_MIN_LOD
    | EXT_IMAGE_GATHER_EXTENDED | EXT_MAINTENANCE8 | EXT_VULKAN_MEMORY_MODEL | EXT_VULKAN_MEMORY_MODEL_DEVICE_SCOPE
    | EXT_INT8 | EXT_INT16 | EXT_BUFFER_DEVICE_ADDRESS | EXT_INT64 | EXT_FLOAT64 | EXT_STORAGE_ACCESS;

# the extensions an environment guarantees: from vulkan1.3 zero_init_workgroup, where
# the feature is core, the two without-format features, whose capabilities it accepts
# with none enabled, and the two memory model features and buffer device address, which
# vulkan1.3 requires of every device. no version guarantees a type's feature, which its
# ceiling only admits
pub fun env_extensions(id: u32) u64 {
    val p: *EnvProfile = env_profile(id);
    if (p == nil) { ret 0; }
    var exts: u64 = 0;
    if (p.version >= SPV_VERSION_1_6) {
        exts = exts | EXT_ZERO_INIT_WORKGROUP | EXT_STORAGE_READ_WITHOUT_FORMAT | EXT_STORAGE_WRITE_WITHOUT_FORMAT
            | EXT_VULKAN_MEMORY_MODEL | EXT_VULKAN_MEMORY_MODEL_DEVICE_SCOPE | EXT_BUFFER_DEVICE_ADDRESS;
    }
    ret exts;
}

pub fun env_profile(id: u32) *EnvProfile {
    if (id >= ENV_PROFILE_COUNT) { ret nil; }
    ret ?ENV_PROFILES[id];
}

pub fun env_profile_name(id: u32) str {
    if (id >= ENV_PROFILE_COUNT) { ret ""; }
    ret ENV_PROFILES[id].name;
}

# the first environment whose version reaches `version`
pub fun env_name_from(version: u32) str {
    var i: u32 = 0;
    for (i < ENV_PROFILE_COUNT) {
        if (ENV_PROFILES[i].version >= version) { ret ENV_PROFILES[i].name; }
        i = i + 1;
    }
    ret ENV_PROFILES[ENV_PROFILE_COUNT - 1].name;
}

pub fun need_name(bit: u64) str {
    var i: u32 = 0;
    for (i < CAPABILITY_COUNT) {
        if (CAPABILITIES[i].need == bit) { ret CAPABILITIES[i].name; }
        i = i + 1;
    }
    ret "unknown";
}

pub val EXEC_MODEL_VERTEX:    u32 = 0;
pub val EXEC_MODEL_FRAGMENT:  u32 = 4;
