# the semantics bits only the Vulkan memory model defines
pub val SEMANTICS_VULKAN_ONLY: u32 = SEMANTICS_MAKE_AVAILABLE | SEMANTICS_MAKE_VISIBLE | SEMANTICS_VOLATILE;

# the Memory Operands of OpLoad and OpStore. Aligned is followed by its literal, the
# availability and visibility bits by their scope id, each needing NonPrivatePointer beside
# it, and the operands follow the bits in their order
pub val MEMORY_ACCESS_VOLATILE:               u32 = 0x1;
pub val MEMORY_ACCESS_ALIGNED:                u32 = 0x2;
pub val MEMORY_ACCESS_MAKE_POINTER_AVAILABLE: u32 = 0x8;
pub val MEMORY_ACCESS_MAKE_POINTER_VISIBLE:   u32 = 0x10;
pub val MEMORY_ACCESS_NON_PRIVATE_POINTER:    u32 = 0x20;

pub rec Builder {
    alloc:        *A.Allocator;
    next_id:      u32;
    caps:         Vec;
    extensions:   Vec;
    ext_imports:  Vec;
    memory_model: Vec;
    entry_points: Vec;
    exec_modes:   Vec;
    debug_source: Vec;
    debug_names:  Vec;
    decorations:  Vec;
    types_consts: Vec;
    functions:    Vec;
    caps_needed:  u64;
    version:      u32;
    err:          bool;
}

pub rec Vec {
    words: *u32;
    len:   u32;
    cap:   u32;
}

rec SpvWordUnit {}

val VEC_INIT_CAP: u32 = 32;

fun vec_init() Vec {
    var v: Vec;
    v.words = nil;
    v.len   = 0;
    v.cap   = 0;
    ret v;
}

fun vec_push(b: *Builder, v: *Vec, w: u32) {
    if (b.err) { ret; }
    if (v.len >= v.cap) {
        var new_cap: u32 = VEC_INIT_CAP;
        if (v.cap > 0) {
            val doubled: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] =
                layout.count_mul[SpvWordUnit](layout.count[SpvWordUnit](v.cap::usize), 2::usize);
            if (sel doubled.err) {
                b.err = true;
                ret;
            }
            val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
                doubled.ok.value);
            if (sel fits.err) {
                b.err = true;
                ret;
            }
            new_cap = fits.ok;
        }
        if (v.words == nil) {
            val ra: res[*u32, A.Error] = A.allocate[u32](b.alloc, new_cap::usize);
            if (sel ra.err) {
                b.err = true;
                ret;
            }
            v.words = ra.ok;
        }
        or {
            val rr: res[*u32, A.Error] = A.reallocate[u32](b.alloc, v.words, v.cap::usize, new_cap::usize);
            if (sel rr.err) {
                b.err = true;
                ret;
            }
            v.words = rr.ok;
        }
        v.cap = new_cap;
    }
    v.words[v.len] = w;
    v.len          = v.len + 1;
}

fun vec_dnit(b: *Builder, v: *Vec) {
    if (v.words != nil && v.cap > 0) {
        A.deallocate[u32](b.alloc, v.words, v.cap::usize);
    }
    v.words = nil;
    v.len   = 0;
    v.cap   = 0;
}

pub fun builder_init(alloc: *A.Allocator) Builder {
    var b: Builder;
    b.alloc        = alloc;
    b.next_id      = 1;
    b.caps         = vec_init();
    b.extensions   = vec_init();
    b.ext_imports  = vec_init();
    b.memory_model = vec_init();
    b.entry_points = vec_init();
    b.exec_modes   = vec_init();
    b.debug_source = vec_init();
    b.debug_names  = vec_init();
    b.decorations  = vec_init();
    b.types_consts = vec_init();
    b.functions    = vec_init();
    b.caps_needed  = 0;
    b.version      = SPV_VERSION_1_6;
    b.err          = false;
    ret b;
}

pub fun builder_dnit(b: *Builder) {
    vec_dnit(b, ?b.caps);
    vec_dnit(b, ?b.extensions);
    vec_dnit(b, ?b.ext_imports);
    vec_dnit(b, ?b.memory_model);
    vec_dnit(b, ?b.entry_points);
    vec_dnit(b, ?b.exec_modes);
    vec_dnit(b, ?b.debug_source);
    vec_dnit(b, ?b.debug_names);
    vec_dnit(b, ?b.decorations);
    vec_dnit(b, ?b.types_consts);
    vec_dnit(b, ?b.functions);
}

pub fun alloc_id(b: *Builder) u32 {
    val id: u32 = b.next_id;
    b.next_id = b.next_id + 1;
    ret id;
}

pub fun inst_word(opcode: u32, words: u32) u32 {
    ret (words << 16) | (opcode & 0xFFFF);
}

pub fun inst(b: *Builder, v: *Vec, opcode: u32, ops: *u32, n: u32) {
    vec_push(b, v, inst_word(opcode, n + 1));
    var i: u32 = 0;
    for (i < n) {
        vec_push(b, v, ops[i]);
        i = i + 1;
    }
}

pub fun ext_inst_import(b: *Builder, set: str) u32 {
    val id:  u32 = alloc_id(b);
    var ops: [17]u32;
    ops[0] = id;
    val n_r: res[u32, fail.Fail] = string_words(set);
    if (sel n_r.err) {
        b.err = true;
        ret id;
    }
    val n: u32 = n_r.ok;
    if (n > 16) {
        b.err = true;
        ret id;
    }
    pack_string(set, n, ?ops[1]);
    inst(b, ?b.ext_imports, OP_EXT_INST_IMPORT, ?ops[0], 1 + n);
    ret id;
}

# an instruction of lead operands followed by one literal string, the shape of OpString,
# OpName and OpMemberName
pub fun inst_string(b: *Builder, v: *Vec, opcode: u32, lead: *u32, lead_n: u32, s: str) {
    val sw_r: res[u32, fail.Fail] = string_words(s);
    if (sel sw_r.err) {
        b.err = true;
        ret;
    }
    val sw: u32 = sw_r.ok;
    if (lead_n + sw + 1 > 0xFFFF) {
        b.err = true;
        ret;
    }
    vec_push(b, v, inst_word(opcode, lead_n + sw + 1));
    var i: u32 = 0;
    for (i < lead_n) {
        vec_push(b, v, lead[i]);
        i = i + 1;
    }
    val n:  usize = str_len(s);
    var wi: u32   = 0;
    for (wi < sw) {
        var w:    u32 = 0;
        var byte: u32 = 0;
        for (byte < 4) {
            val idx: usize = (wi * 4 + byte)::usize;
            var c:   u32   = 0;
            if (idx < n) { c = s[idx]::u32; }
            w    = w | (c << (byte * 8));
            byte = byte + 1;
        }
        vec_push(b, v, w);
        wi = wi + 1;
    }
}

pub fun string_words(s: str) res[u32, fail.Fail] {
    val len_r: res[u32, layout.CheckCause] = layout.usize_to_u32(str_len(s));
    if (sel len_r.err) {
        ret res[u32, fail.Fail].err{fail.message("spirv: identifier length exceeds the u32 limit")};
    }
    val len: usize = len_r.ok::usize;
    ret res[u32, fail.Fail].ok{((len + 4) / 4)::u32};
}

pub fun pack_string(s: str, words: u32, out: *u32) {
    val n:  usize = str_len(s);
    var wi: u32   = 0;
    for (wi < words) {
        var w:    u32 = 0;
        var byte: u32 = 0;
        for (byte < 4) {
            val idx: usize = (wi * 4 + byte)::usize;
            var b:   u32   = 0;
            if (idx < n) { b = s[idx]::u32; }
            w    = w | (b << (byte * 8));
            byte = byte + 1;
        }
        out[wi] = w;
        wi      = wi + 1;
    }
}

fun word_count_add(acc: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause], len: u32)
    res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] {
    if (sel acc.err) { ret acc; }
    ret layout.count_add[SpvWordUnit](
        acc.ok,
        layout.count[SpvWordUnit](len::usize));
}

pub fun serialize(b: *Builder, out_len: *u32) res[*u8, fail.Fail] {
    if (b.err) { ret res[*u8, fail.Fail].err{fail.message("spirv: module builder hit an allocation error")}; }

    var words_r:   res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = res[layout.CheckedCount[SpvWordUnit], layout.CheckCause].ok{layout.count[SpvWordUnit](5::usize)};
    val words_r_1: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r, b.caps.len);
    val words_r_x: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_1, b.extensions.len);
    val words_r_2: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_x, b.ext_imports.len);
    val words_r_3: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_2, b.memory_model.len);
    val words_r_4: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_3, b.entry_points.len);
    val words_r_5: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_4, b.exec_modes.len);
    val words_r_d: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_5, b.debug_source.len);
    val words_r_n: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_d, b.debug_names.len);
    val words_r_6: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_n, b.decorations.len);
    val words_r_7: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_6, b.types_consts.len);
    val words_r_8: res[layout.CheckedCount[SpvWordUnit], layout.CheckCause] = word_count_add(words_r_7, b.functions.len);
    if (sel words_r_8.err) {
        ret res[*u8, fail.Fail].err{fail.message("spirv: module word count overflow")};
    }
    val total_words_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
        words_r_8.ok.value);
    if (sel total_words_fits.err) {
        ret res[*u8, fail.Fail].err{fail.message("spirv: module word count exceeds the u32 limit")};
    }
    val total_words: u32 = total_words_fits.ok;

    val bytes_r: res[layout.CheckedCount[layout.ByteUnit], layout.CheckCause] =
        layout.count_mul[layout.ByteUnit](layout.count[layout.ByteUnit](total_words::usize), 4::usize);
    if (sel bytes_r.err) {
        ret res[*u8, fail.Fail].err{fail.message("spirv: module byte size overflow")};
    }
    val total_bytes_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
        bytes_r.ok.value);
    if (sel total_bytes_fits.err) {
        ret res[*u8, fail.Fail].err{fail.message("spirv: module byte size exceeds the u32 limit")};
    }
    val total_bytes: u32 = total_bytes_fits.ok;

    val rb: res[*u8, A.Error] = A.allocate[u8](b.alloc, total_bytes::usize);
    if (sel rb.err) { ret res[*u8, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;

    var pos: u32 = 0;
    pos = put_word(buf, pos, SPV_MAGIC);
    pos = put_word(buf, pos, b.version);
    pos = put_word(buf, pos, SPV_GENERATOR);
    pos = put_word(buf, pos, b.next_id);
    pos = put_word(buf, pos, 0);

    pos = put_section(buf, pos, ?b.caps);
    pos = put_section(buf, pos, ?b.extensions);
    pos = put_section(buf, pos, ?b.ext_imports);
    pos = put_section(buf, pos, ?b.memory_model);
    pos = put_section(buf, pos, ?b.entry_points);
    pos = put_section(buf, pos, ?b.exec_modes);
    pos = put_section(buf, pos, ?b.debug_source);
    pos = put_section(buf, pos, ?b.debug_names);
    pos = put_section(buf, pos, ?b.decorations);
    pos = put_section(buf, pos, ?b.types_consts);
    pos = put_section(buf, pos, ?b.functions);

    @out_len = total_bytes;
    ret res[*u8, fail.Fail].ok{buf};
}

fun put_word(buf: *u8, pos: u32, w: u32) u32 {
    buf[pos]     = (w & 0xFF)::u8;
    buf[pos + 1] = ((w >> 8) & 0xFF)::u8;
    buf[pos + 2] = ((w >> 16) & 0xFF)::u8;
    buf[pos + 3] = ((w >> 24) & 0xFF)::u8;
    ret pos + 4;
}

fun put_section(buf: *u8, pos: u32, v: *Vec) u32 {
    var p: u32 = pos;
    var i: u32 = 0;
    for (i < v.len) {
        p = put_word(buf, p, v.words[i]);
        i = i + 1;
    }
    ret p;
}

test pack_string__linkage_name {
    val n1_r: res[u32, fail.Fail] = string_words("add");
    if (sel n1_r.err) { ret 1; }
    val n1: u32 = n1_r.ok;
    if (n1 != 1) { ret 1; }
    var w: [4]u32;
    pack_string("add", n1, ?w[0]);
    if (w[0] != 0x00646461) { ret 1; }

    val n2_r: res[u32, fail.Fail] = string_words("main");
    if (sel n2_r.err) { ret 1; }
    if (n2_r.ok != 2) { ret 1; }
    ret 0;
}

test serialize__header_and_bound {
    var alloc: A.Allocator;
    val r_507: err[A.Error] = page.make(?alloc);
    if (sel r_507.err) { ret 1; }

    var b: Builder = builder_init(?alloc);

    var caps: [1]u32;
    caps[0] = CAP_SHADER;
    inst(?b, ?b.caps, OP_CAPABILITY, ?caps[0], 1);
    caps[0] = CAP_LINKAGE;
    inst(?b, ?b.caps, OP_CAPABILITY, ?caps[0], 1);
    var mm: [2]u32;
    mm[0] = ADDRESSING_LOGICAL;
    mm[1] = MEMORY_GLSL450;
    inst(?b, ?b.memory_model, OP_MEMORY_MODEL, ?mm[0], 2);

    alloc_id(?b);
    alloc_id(?b);
    alloc_id(?b);

    var len: u32                 = 0;
    val rs:  res[*u8, fail.Fail] = serialize(?b, ?len);
    builder_dnit(?b);
    if (sel rs.err) { ret 1; }
    val buf: *u8 = rs.ok;

    if (read_word(buf, 0) != SPV_MAGIC) {
        A.deallocate[u8](?alloc, buf, len::usize);
        ret 1;
    }
    if (read_word(buf, 4) != SPV_VERSION_1_6) {
        A.deallocate[u8](?alloc, buf, len::usize);
        ret 1;
    }
    if (read_word(buf, 12) != 4) {
        A.deallocate[u8](?alloc, buf, len::usize);
        ret 1;
    }
    if (read_word(buf, 20) != 0x00020011) {
        A.deallocate[u8](?alloc, buf, len::usize);
        ret 1;
    }
    if (read_word(buf, 24) != CAP_SHADER) {
        A.deallocate[u8](?alloc, buf, len::usize);
        ret 1;
    }

    A.deallocate[u8](?alloc, buf, len::usize);
    ret 0;
}

#[testing]
fun read_word(buf: *u8, pos: u32) u32 {
    ret buf[pos]::u32 | (buf[pos + 1]::u32 << 8) | (buf[pos + 2]::u32 << 16) | (buf[pos + 3]::u32 << 24);
}

#[testing]
rec SpvGrowthProbe {
    reallocate_calls: u32;
    allocate_calls:   u32;
}

#[testing]
fun spv_growth_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val g: *SpvGrowthProbe = ctx::*SpvGrowthProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret opt[ptr].none{};
}

#[testing]
fun spv_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *SpvGrowthProbe = ctx::*SpvGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

#[testing]
fun spv_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test vec_push__refuses_capacity_overflow_before_reallocating {
    var probe: SpvGrowthProbe;
    probe.reallocate_calls = 0;
    probe.allocate_calls   = 0;
    var pp:    *SpvGrowthProbe = ?probe;
    var alloc: A.Allocator;
    alloc.ctx           = pp::ptr;
    alloc.fn_allocate   = spv_growth_probe_allocate;
    alloc.fn_reallocate = spv_growth_probe_reallocate;
    alloc.fn_deallocate = spv_growth_probe_deallocate;

    var b:     Builder = builder_init(?alloc);
    var dummy: u32;
    b.caps.words = ?dummy;
    b.caps.cap   = 0x80000000;
    b.caps.len   = 0x80000000;

    vec_push(?b, ?b.caps, 7);

    var bad: i32 = 0;
    if (!b.err)                      { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (b.caps.cap != 0x80000000)    { bad = 3; }
    if (b.caps.len != 0x80000000)    { bad = 4; }
    ret bad;
}

# the word count overflows u32 on its own, and a count just past a quarter of it
# overflows only once scaled to bytes
test serialize__refuses_size_overflow_before_allocating {
    var lens: [2]u32 = [2]u32{0xFFFFFFFF, 0x40000000 - 5};
    var i:    usize  = 0;
    for (i < 2) {
        var probe: SpvGrowthProbe;
        probe.reallocate_calls = 0;
        probe.allocate_calls   = 0;
        var pp:    *SpvGrowthProbe = ?probe;
        var alloc: A.Allocator;
        alloc.ctx           = pp::ptr;
        alloc.fn_allocate   = spv_growth_probe_allocate;
        alloc.fn_reallocate = spv_growth_probe_reallocate;
        alloc.fn_deallocate = spv_growth_probe_deallocate;

        var b: Builder = builder_init(?alloc);
        b.caps.len = lens[i];

        var len: u32                 = 0;
        val rs:  res[*u8, fail.Fail] = serialize(?b, ?len);
        if (!sel rs.err)               { ret 1; }
        if (probe.allocate_calls != 0) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

# every capability bit is its own, and a word resolves to the row that declares it
test capabilities__one_bit_per_word {
    var seen: u64 = 0;
    var i:    u32 = 0;
    for (i < CAPABILITY_COUNT) {
        val c: *Capability = ?CAPABILITIES[i];
        if (c.need == 0 || (c.need & (c.need - 1)) != 0 || (seen & c.need) != 0) { ret 1; }
        if (capability_of(c.word) != c)                                          { ret 2; }
        seen = seen | c.need;
        i    = i + 1;
    }
    if (!str_equals(need_name(NEED_GROUP_NON_UNIFORM_CLUSTERED), "GroupNonUniformClustered")) { ret 3; }
    if ((VULKAN_12_CEILING & ~CEILING_DOMAIN) != 0)                                           { ret 4; }
    if (capability_of(CAP_SHADER) != nil)                                                     { ret 5; }
    ret 0;
}

# a module naming no environment holds every extension, and no environment grants a
# type's feature, which a capability row names and its ceiling only admits (#4318)
test extensions__no_environment_grants_a_type_feature {
    var types: u64 = 0;
    var i:     u32 = 0;
    for (i < CAPABILITY_COUNT) {
        types = types | CAPABILITIES[i].feature;
        i     = i + 1;
    }
    if (types != (EXT_INT8 | EXT_INT16 | EXT_INT64 | EXT_FLOAT16 | EXT_FLOAT64)) { ret 1; }
    i = 0;
    for (i < EXTENSION_COUNT) {
        if ((EXT_OPEN & EXTENSIONS[i].bit) == 0) { ret 2; }
        i = i + 1;
    }
    i = 0;
    for (i < ENV_PROFILE_COUNT) {
        if ((env_extensions(i) & types) != 0) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

test version_forms__each_environment_version_takes_its_own_forms {
    var bad: i32 = 0;
    if (!entry_interface_lists(SPV_VERSION_1_0, STORAGE_INPUT))            { bad = 1; }
    if (!entry_interface_lists(SPV_VERSION_1_3, STORAGE_OUTPUT))           { bad = 1; }
    if (entry_interface_lists(SPV_VERSION_1_0, STORAGE_UNIFORM))           { bad = 2; }
    if (entry_interface_lists(SPV_VERSION_1_3, STORAGE_STORAGE_BUFFER))    { bad = 2; }
    if (entry_interface_lists(SPV_VERSION_1_3, STORAGE_UNIFORM_CONSTANT))  { bad = 2; }
    if (!entry_interface_lists(SPV_VERSION_1_4, STORAGE_UNIFORM_CONSTANT)) { bad = 3; }
    if (!entry_interface_lists(SPV_VERSION_1_6, STORAGE_STORAGE_BUFFER))   { bad = 3; }

    if (storage_buffer_class(SPV_VERSION_1_0) != STORAGE_UNIFORM)               { bad = 4; }
    if (storage_block_decoration(SPV_VERSION_1_0) != DECOR_BUFFER_BLOCK)        { bad = 4; }
    if (storage_buffer_class(SPV_VERSION_1_3) != STORAGE_STORAGE_BUFFER)        { bad = 5; }
    if (storage_block_decoration(SPV_VERSION_1_3) != DECOR_BLOCK)               { bad = 5; }
    if (storage_buffer_class(env_profile(0).version) != STORAGE_UNIFORM)        { bad = 6; }
    if (storage_buffer_class(env_profile(1).version) != STORAGE_STORAGE_BUFFER) { bad = 6; }
    ret bad;
}
