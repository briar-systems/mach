pub val CAP_SAMPLED_1D:         u32 = 43;
pub val CAP_SAMPLED_CUBE_ARRAY: u32 = 45;

pub val NEED_INT8:    u32 = 0x01;
pub val NEED_INT16:   u32 = 0x02;
pub val NEED_INT64:   u32 = 0x04;
pub val NEED_FLOAT16: u32 = 0x08;
pub val NEED_FLOAT64: u32 = 0x10;
pub val NEED_SAMPLED_1D:         u32 = 0x20;
pub val NEED_SAMPLED_CUBE_ARRAY: u32 = 0x40;

val VULKAN_CORE_CEILING: u32 = NEED_INT16 | NEED_INT64 | NEED_FLOAT64 | NEED_SAMPLED_1D | NEED_SAMPLED_CUBE_ARRAY;
val VULKAN_12_CEILING:   u32 = VULKAN_CORE_CEILING | NEED_INT8 | NEED_FLOAT16;

val ENV_PROFILES: [ENV_PROFILE_COUNT]EnvProfile = [ENV_PROFILE_COUNT]EnvProfile{
    EnvProfile{ name: "vulkan1.0", version: SPV_VERSION_1_0, ceiling: VULKAN_CORE_CEILING },
    EnvProfile{ name: "vulkan1.1", version: SPV_VERSION_1_3, ceiling: VULKAN_CORE_CEILING },
    EnvProfile{ name: "vulkan1.2", version: SPV_VERSION_1_5, ceiling: VULKAN_12_CEILING },
    EnvProfile{ name: "vulkan1.3", version: SPV_VERSION_1_6, ceiling: VULKAN_12_CEILING },
};

pub fun env_profile(id: u32) *EnvProfile {
    if (id >= ENV_PROFILE_COUNT) { ret nil; }
    ret ?ENV_PROFILES[id];
}

pub fun env_profile_name(id: u32) str {
    if (id >= ENV_PROFILE_COUNT) { ret ""; }
    ret ENV_PROFILES[id].name;
}

pub fun need_name(bit: u32) str {
    if (bit == NEED_INT8)    { ret "Int8"; }
    if (bit == NEED_INT16)   { ret "Int16"; }
    if (bit == NEED_INT64)   { ret "Int64"; }
    if (bit == NEED_FLOAT16) { ret "Float16"; }
    if (bit == NEED_FLOAT64) { ret "Float64"; }
    if (bit == NEED_SAMPLED_1D)         { ret "Sampled1D"; }
    if (bit == NEED_SAMPLED_CUBE_ARRAY) { ret "SampledCubeArray"; }
    ret "unknown";
}

