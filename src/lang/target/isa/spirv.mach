pub rec EnvProfile {
    name:    str;
    version: u32;
    ceiling: u64;
    # the environment admits the LocalSizeId execution mode: SPIR-V 1.2 and, on Vulkan,
    # the maintenance4 feature, which only Vulkan 1.3 requires of every device
    local_size_id: bool;
}

