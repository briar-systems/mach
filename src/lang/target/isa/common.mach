# the target-independent helpers every isa backend reads: predicates over the
# selected MIR, bit and decimal arithmetic, and the relocation type a backend
# may leave unset
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;

use mach.lang.be.codegen.mir;

pub fun is_mir_compare(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_CMP_EQ || op == mir.MIR_SEL_CMP_NE ||
        op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U ||
        op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U;
}

pub fun is_mir_divide(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_DIV_U ||
        op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;
}

pub fun is_mir_float_conv(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT ||
        op == mir.MIR_FP_TO_SI || op == mir.MIR_FP_TO_UI ||
        op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP;
}

# the byte widths a scalar float takes
pub fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

pub fun popcount32(m: u32) u32 {
    var n: u32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    ret n;
}

# writes n in decimal at dst, which holds at least 20 bytes, and returns the length
pub fun u64_to_dec(n: u64, dst: *u8) usize {
    if (n == 0) {
        dst[0] = '0'::u8;
        ret 1;
    }
    var tmp: [20]u8;
    var len: usize = 0;
    var v:   u64   = n;
    for (v > 0) {
        tmp[len] = (v % 10)::u8 + '0'::u8;
        v        = v / 10;
        len      = len + 1;
    }
    var k: usize = 0;
    for (k < len) {
        dst[k] = tmp[len - 1 - k];
        k      = k + 1;
    }
    ret len;
}

# the declared ELF type, or zero for an absent one
#[testing]
pub fun reloc_type_or_zero(t: opt[u32]) u32 {
    if (sel t.none) { ret 0; }
    ret t.some;
}
