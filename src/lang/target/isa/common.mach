# the target-independent helpers every isa backend reads: predicates over the
# selected MIR, bit arithmetic, and the relocation type a backend
# may leave unset
use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;

use lang_checked: mach.lang.checked;
use mach.lang.fail;
use lang_mir: mach.lang.mir;

pub fun is_mir_compare(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_SEL_CMP_EQ || op == lang_mir.MIR_SEL_CMP_NE ||
        op == lang_mir.MIR_SEL_CMP_LT_S || op == lang_mir.MIR_SEL_CMP_LT_U ||
        op == lang_mir.MIR_SEL_CMP_LE_S || op == lang_mir.MIR_SEL_CMP_LE_U;
}

pub fun is_mir_divide(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_SEL_DIV_S || op == lang_mir.MIR_SEL_DIV_U ||
        op == lang_mir.MIR_SEL_REM_S || op == lang_mir.MIR_SEL_REM_U;
}

pub fun is_mir_float_conv(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_FP_TRUNC || op == lang_mir.MIR_FP_EXT ||
        op == lang_mir.MIR_FP_TO_SI || op == lang_mir.MIR_FP_TO_UI ||
        op == lang_mir.MIR_SI_TO_FP || op == lang_mir.MIR_UI_TO_FP;
}

# the byte widths a scalar float takes
pub fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

pub fun popcount32(m: u32) u32 {
    var n: u32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    ret n;
}

# the declared ELF type, or zero for an absent one
#[testing]
pub fun reloc_type_or_zero(t: opt[u32]) u32 {
    if (sel t.none) { ret 0; }
    ret t.some;
}

# a frame extent rounded up to `align`, a power of two or 0 for none. the
# extent is summed in 64 bits by the caller, so no part of it wraps, and an
# extent past 4 GiB is refused
pub fun frame_align_up(n: u64, align: u32) res[u32, fail.Fail] {
    var aligned: u64 = n;
    if (align != 0) {
        val up: res[u64, lang_checked.Cause] = lang_checked.align_u64_up(n, align::u64);
        if (sel up.err) { ret res[u32, fail.Fail].err{fail.message("isa: a frame extent overflowed its alignment")}; }
        aligned = up.ok;
    }
    if (aligned > 0xFFFFFFFF) { ret res[u32, fail.Fail].err{fail.message("isa: a frame extent overflowed its alignment")}; }
    ret res[u32, fail.Fail].ok{aligned::u32};
}

# an extent past 4 GiB is refused, whether it arrives past the limit or the
# round-up carries it there, rather than wrapping
test frame_align_up__refuses_an_extent_past_4_gib {
    val fits: res[u32, fail.Fail] = frame_align_up(0xFFFFFFF0, 16);
    if (sel fits.err)          { ret 1; }
    if (fits.ok != 0xFFFFFFF0) { ret 1; }
    val over: res[u32, fail.Fail] = frame_align_up(0x100000000, 0);
    if (sel over.ok) { ret 2; }
    val carried: res[u32, fail.Fail] = frame_align_up(0xFFFFFFF1, 16);
    if (sel carried.ok) { ret 3; }
    ret 0;
}
