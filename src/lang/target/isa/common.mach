# the target-independent helpers every isa backend reads: predicates over the
# selected MIR, bit arithmetic, and the relocation type a backend
# may leave unset
use std.types.bool.bool;
use std.system.panic.panic;
use std.types.option.opt;
use std.types.result.res;

use codegen_mir: mach.lang.be.codegen.mir;
use mach.lang.layout;

pub fun is_mir_compare(op: codegen_mir.MirOpcode) bool {
    ret op == codegen_mir.MIR_SEL_CMP_EQ || op == codegen_mir.MIR_SEL_CMP_NE ||
        op == codegen_mir.MIR_SEL_CMP_LT_S || op == codegen_mir.MIR_SEL_CMP_LT_U ||
        op == codegen_mir.MIR_SEL_CMP_LE_S || op == codegen_mir.MIR_SEL_CMP_LE_U;
}

pub fun is_mir_divide(op: codegen_mir.MirOpcode) bool {
    ret op == codegen_mir.MIR_SEL_DIV_S || op == codegen_mir.MIR_SEL_DIV_U ||
        op == codegen_mir.MIR_SEL_REM_S || op == codegen_mir.MIR_SEL_REM_U;
}

pub fun is_mir_float_conv(op: codegen_mir.MirOpcode) bool {
    ret op == codegen_mir.MIR_FP_TRUNC || op == codegen_mir.MIR_FP_EXT ||
        op == codegen_mir.MIR_FP_TO_SI || op == codegen_mir.MIR_FP_TO_UI ||
        op == codegen_mir.MIR_SI_TO_FP || op == codegen_mir.MIR_UI_TO_FP;
}

# the byte widths a scalar float takes
pub fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

pub fun popcount32(m: u32) u32 {
    var n: u32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    ret n;
}

# the declared ELF type, or zero for an absent one
#[testing]
pub fun reloc_type_or_zero(t: opt[u32]) u32 {
    if (sel t.none) { ret 0; }
    ret t.some;
}

# a frame extent rounded up to `align`, a power of two or 0 for none; a frame
# is bounded far below 4 GiB, so a round-up past it is a compiler defect
pub fun frame_align_up(n: u32, align: u32) u32 {
    if (align == 0) { ret n; }
    val aligned: res[u64, layout.CheckCause] = layout.align_u64_up(n::u64, align::u64);
    if (sel aligned.ok) {
        if (aligned.ok <= 0xFFFFFFFF) { ret aligned.ok::u32; }
    }
    panic("isa: a frame extent overflowed its alignment\n");
    ret 0;
}
