pub val PSLLQ: Opcode = 189;

pub val PSRLW: Opcode = 190;

pub val PSRLD: Opcode = 191;

# subtract with borrow: `sbb r, r` spreads the carry into every bit, the mask
# a compare leaves
pub val SBB: Opcode = 192;

# the aes rounds and key-schedule steps, and the carry-less multiply under
# pclmul, reached only from inline asm
pub val AESENC: Opcode = 193;

pub val AESENCLAST: Opcode = 194;

pub val AESDEC: Opcode = 195;

pub val AESDECLAST: Opcode = 196;

pub val AESIMC: Opcode = 197;

pub val AESKEYGENASSIST: Opcode = 198;

pub val PCLMULQDQ: Opcode = 199;

# the lane join of two register parts: the low quadwords of two
# registers side by side, and the byte shift up that meets a part below
# a quadword with the one above it
pub val PUNPCKLQDQ: Opcode = 200;

pub val PSLLDQ: Opcode = 201;

# the conditional moves: the r/m source into the register when the condition
# holds, the register kept otherwise, the branch-free select
pub val CMOVE: Opcode = 202;

pub val CMOVNE: Opcode = 203;

pub val CMOVL: Opcode = 204;

