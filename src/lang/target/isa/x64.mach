pub val PMULHW: Opcode = 155;

pub val PMULHUW: Opcode = 156;

pub val PMULUDQ: Opcode = 157;

# the extension rows, reached only from inline asm: sha, ssse3 and sse41, and
# the baseline cpuid that detects them
pub val SHA256RNDS2: Opcode = 158;

pub val SHA256MSG1: Opcode = 159;

pub val SHA256MSG2: Opcode = 160;

