pub val HAS_FLOAT: bool = true;

# the x86_64 extension vocabulary over the SSE2 baseline. a row is a name the
# manifest, `$mach.build.extensions.<name>`, `#[extensions(...)]` and the
# inline-asm `requires:` rows all spell; a row nothing encodes against yet is
# still a declared, probed requirement (#3741)
pub val EXT_SSSE3:    u64 = 0x1;
pub val EXT_SSE41:    u64 = 0x2;
pub val EXT_SHA:      u64 = 0x4;
pub val EXT_FSGSBASE: u64 = 0x8;
pub val EXT_POPCNT:   u64 = 0x10;
pub val EXT_LZCNT:    u64 = 0x20;
pub val EXT_BMI1:     u64 = 0x40;
pub val EXT_SSE42:    u64 = 0x80;
pub val EXT_CX16:     u64 = 0x100;
pub val EXT_AVX:      u64 = 0x200;
pub val EXT_AVX2:     u64 = 0x400;
pub val EXT_BMI2:     u64 = 0x800;
pub val EXT_FMA:      u64 = 0x1000;
pub val EXT_MOVBE:    u64 = 0x2000;
pub val EXT_F16C:     u64 = 0x4000;
pub val EXT_AVX512F:  u64 = 0x8000;
pub val EXT_AVX512BW: u64 = 0x10000;
pub val EXT_AVX512CD: u64 = 0x20000;
pub val EXT_AVX512DQ: u64 = 0x40000;
pub val EXT_AVX512VL: u64 = 0x80000;
pub val EXT_AES:      u64 = 0x100000;
pub val EXT_PCLMUL:   u64 = 0x200000;

pub val EXTENSION_COUNT: u32 = 22;

# sse41 brings ssse3 (sse3 is not modelled, so the chain stops there), sse42
# brings sse41, avx brings sse42, avx2, fma and f16c bring avx, and every
# avx512 set brings avx512f, which brings avx2
pub val EXTENSIONS: [EXTENSION_COUNT]extension.Extension = [EXTENSION_COUNT]extension.Extension{
    extension.Extension{name: "ssse3", bit: EXT_SSSE3, implies: 0, target_only: nil},
    extension.Extension{name: "sse41", bit: EXT_SSE41, implies: EXT_SSSE3, target_only: nil},
    extension.Extension{name: "sha", bit: EXT_SHA, implies: 0, target_only: nil},
    extension.Extension{name: "fsgsbase", bit: EXT_FSGSBASE, implies: 0, target_only: nil},
    extension.Extension{name: "popcnt", bit: EXT_POPCNT, implies: 0, target_only: nil},
    extension.Extension{name: "lzcnt", bit: EXT_LZCNT, implies: 0, target_only: nil},
    extension.Extension{name: "bmi1", bit: EXT_BMI1, implies: 0, target_only: nil},
    extension.Extension{name: "sse42", bit: EXT_SSE42, implies: EXT_SSE41, target_only: nil},
    extension.Extension{name: "cx16", bit: EXT_CX16, implies: 0, target_only: nil},
    extension.Extension{name: "avx", bit: EXT_AVX, implies: EXT_SSE42, target_only: nil},
    extension.Extension{name: "avx2", bit: EXT_AVX2, implies: EXT_AVX, target_only: nil},
    extension.Extension{name: "bmi2", bit: EXT_BMI2, implies: 0, target_only: nil},
    extension.Extension{name: "fma", bit: EXT_FMA, implies: EXT_AVX, target_only: nil},
    extension.Extension{name: "movbe", bit: EXT_MOVBE, implies: 0, target_only: nil},
    extension.Extension{name: "f16c", bit: EXT_F16C, implies: EXT_AVX, target_only: nil},
    extension.Extension{name: "avx512f", bit: EXT_AVX512F, implies: EXT_AVX2, target_only: nil},
    extension.Extension{name: "avx512bw", bit: EXT_AVX512BW, implies: EXT_AVX512F, target_only: nil},
    extension.Extension{name: "avx512cd", bit: EXT_AVX512CD, implies: EXT_AVX512F, target_only: nil},
    extension.Extension{name: "avx512dq", bit: EXT_AVX512DQ, implies: EXT_AVX512F, target_only: nil},
    extension.Extension{name: "avx512vl", bit: EXT_AVX512VL, implies: EXT_AVX512F, target_only: nil},
    extension.Extension{name: "aes", bit: EXT_AES, implies: 0, target_only: nil},
    extension.Extension{name: "pclmul", bit: EXT_PCLMUL, implies: 0, target_only: nil},
};

# the published x86-64 microarchitecture levels as manifest spellings. each
# level lists its own members over the v1 baseline (sse2, cmpxchg8b and
# lahf-sahf are the baseline and are not rows) and includes every lower level;
# closing the selection over `implies` adds nothing a level does not already
# name. doc/language/manifest.md carries the same table and a test holds the
# two together (#3741)
pub val LEVEL_V2: u64 = EXT_SSSE3 | EXT_SSE41 | EXT_SSE42 | EXT_POPCNT | EXT_CX16;
pub val LEVEL_V3: u64 = LEVEL_V2 | EXT_AVX | EXT_AVX2 | EXT_BMI1 | EXT_BMI2 | EXT_FMA | EXT_LZCNT | EXT_MOVBE | EXT_F16C;
pub val LEVEL_V4: u64 = LEVEL_V3 | EXT_AVX512F | EXT_AVX512BW | EXT_AVX512CD | EXT_AVX512DQ | EXT_AVX512VL;

pub val LEVEL_COUNT: u32 = 3;

pub val LEVELS: [LEVEL_COUNT]extension.Level = [LEVEL_COUNT]extension.Level{
    extension.Level{name: "x86-64-v2", members: LEVEL_V2},
    extension.Level{name: "x86-64-v3", members: LEVEL_V3},
    extension.Level{name: "x86-64-v4", members: LEVEL_V4},
};

