pub val MEM_BASE_ABS: i32 = -2;

pub fun is_fp_opcode(op: u16) bool {
    if (op >= MOVSS && op <= DIVSD)      { ret true; }
    if (op >= CVTSI2SS && op <= UCOMISD) { ret true; }
    if (op == MOVQ || op == XORPS)       { ret true; }
    ret false;
}

pub fun reg_name(ctx: ptr, id: i32, size: u8) str {
    if (size == 1) {
        if (id == RAX) { ret "al"; }
        if (id == RCX) { ret "cl"; }
        if (id == RDX) { ret "dl"; }
        if (id == RBX) { ret "bl"; }
        if (id == RSP) { ret "spl"; }
        if (id == RBP) { ret "bpl"; }
        if (id == RSI) { ret "sil"; }
        if (id == RDI) { ret "dil"; }
        if (id == R8)  { ret "r8b"; }
        if (id == R9)  { ret "r9b"; }
        if (id == R10) { ret "r10b"; }
        if (id == R11) { ret "r11b"; }
        if (id == R12) { ret "r12b"; }
        if (id == R13) { ret "r13b"; }
        if (id == R14) { ret "r14b"; }
        if (id == R15) { ret "r15b"; }
    }

    if (size == 2) {
        if (id == RAX) { ret "ax"; }
        if (id == RCX) { ret "cx"; }
        if (id == RDX) { ret "dx"; }
        if (id == RBX) { ret "bx"; }
        if (id == RSP) { ret "sp"; }
        if (id == RBP) { ret "bp"; }
        if (id == RSI) { ret "si"; }
        if (id == RDI) { ret "di"; }
        if (id == R8)  { ret "r8w"; }
        if (id == R9)  { ret "r9w"; }
        if (id == R10) { ret "r10w"; }
        if (id == R11) { ret "r11w"; }
        if (id == R12) { ret "r12w"; }
        if (id == R13) { ret "r13w"; }
        if (id == R14) { ret "r14w"; }
        if (id == R15) { ret "r15w"; }
    }

    if (size == 4) {
        if (id == RAX) { ret "eax"; }
        if (id == RCX) { ret "ecx"; }
        if (id == RDX) { ret "edx"; }
        if (id == RBX) { ret "ebx"; }
        if (id == RSP) { ret "esp"; }
        if (id == RBP) { ret "ebp"; }
        if (id == RSI) { ret "esi"; }
        if (id == RDI) { ret "edi"; }
        if (id == R8)  { ret "r8d"; }
        if (id == R9)  { ret "r9d"; }
        if (id == R10) { ret "r10d"; }
        if (id == R11) { ret "r11d"; }
        if (id == R12) { ret "r12d"; }
        if (id == R13) { ret "r13d"; }
        if (id == R14) { ret "r14d"; }
        if (id == R15) { ret "r15d"; }
    }

    if (id == RAX) { ret "rax"; }
    if (id == RCX) { ret "rcx"; }
    if (id == RDX) { ret "rdx"; }
    if (id == RBX) { ret "rbx"; }
    if (id == RSP) { ret "rsp"; }
    if (id == RBP) { ret "rbp"; }
    if (id == RSI) { ret "rsi"; }
    if (id == RDI) { ret "rdi"; }
    if (id == R8)  { ret "r8"; }
    if (id == R9)  { ret "r9"; }
    if (id == R10) { ret "r10"; }
    if (id == R11) { ret "r11"; }
    if (id == R12) { ret "r12"; }
    if (id == R13) { ret "r13"; }
    if (id == R14) { ret "r14"; }
    if (id == R15) { ret "r15"; }

    ret "???";
}

pub fun fp_reg_name(cid: i32) str {
    val id: i32 = isa.regid_index(cid);
    if (id == 0)  { ret "xmm0"; }
    if (id == 1)  { ret "xmm1"; }
    if (id == 2)  { ret "xmm2"; }
    if (id == 3)  { ret "xmm3"; }
    if (id == 4)  { ret "xmm4"; }
    if (id == 5)  { ret "xmm5"; }
    if (id == 6)  { ret "xmm6"; }
    if (id == 7)  { ret "xmm7"; }
    if (id == 8)  { ret "xmm8"; }
    if (id == 9)  { ret "xmm9"; }
    if (id == 10) { ret "xmm10"; }
    if (id == 11) { ret "xmm11"; }
    if (id == 12) { ret "xmm12"; }
    if (id == 13) { ret "xmm13"; }
    if (id == 14) { ret "xmm14"; }
    if (id == 15) { ret "xmm15"; }
    ret "???";
}

pub val CALLEE_SAVED_GP_MAX: i32 = GP_COUNT;

pub fun callee_saved_gp_list(abi_vt: *abi.AbiVTable, out: *i32) i32 {
    ret callee_saved_gp_list_from(abi_vt.callee_saved, out);
}

pub fun callee_saved_gp_list_from(fill: isa.RegFileFn, out: *i32) i32 {
    var file: [32]isa.Register;
    var total: i32 = fill(?file[0]);
    if (total > 32) { total = 32; }

    var n: i32 = 0;
    var i: i32 = 0;
    for (i < total) {
        val id: i32 = file[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_GP &&
            id >= 0 && id < GP_COUNT &&
            id != STACK_REG && id != FRAME_REG) {
            out[n] = id;
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}
