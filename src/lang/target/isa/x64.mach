    OpRow{op: CVTTPS2DQ, name: "cvttps2dq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: CVTDQ2PD, name: "cvtdq2pd", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: CVTTPD2DQ, name: "cvttpd2dq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: CVTPS2PD, name: "cvtps2pd", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: CVTPD2PS, name: "cvtpd2ps", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: MOVDQA, name: "movdqa", form: FORM_SSE_MOVA, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: MOVDQU, name: "movdqu", form: FORM_SSE_MOVA, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: RDFSBASE, name: "rdfsbase", form: FORM_FSGSBASE, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: RDGSBASE, name: "rdgsbase", form: FORM_FSGSBASE, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: WRFSBASE, name: "wrfsbase", form: FORM_FSGSBASE, shape: SHAPE_USE, arity: 1, mem: MEM_BASE, flags: FL_KEEP},
    OpRow{op: WRGSBASE, name: "wrgsbase", form: FORM_FSGSBASE, shape: SHAPE_USE, arity: 1, mem: MEM_BASE, flags: FL_KEEP},
    OpRow{op: PMULHW, name: "pmulhw", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, mul: ct.CT_MUL_HIGH_S, lanes: 16},
    OpRow{op: PMULHUW, name: "pmulhuw", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, mul: ct.CT_MUL_HIGH_U, lanes: 16},
    OpRow{op: PMULUDQ, name: "pmuludq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, mul: ct.CT_MUL_WIDE_U, lanes: 32},
    # the sha rounds and schedule steps run in fixed time whatever their data
    OpRow{op: SHA256RNDS2, name: "sha256rnds2", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: SHA256MSG1, name: "sha256msg1", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: SHA256MSG2, name: "sha256msg2", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    # a table shuffle whose index is data, never an address
    OpRow{op: PSHUFB, name: "pshufb", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PALIGNR, name: "palignr", form: FORM_PACKED, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PBLENDW, name: "pblendw", form: FORM_PACKED, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PINSRD, name: "pinsrd", form: FORM_PINSR, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PEXTRD, name: "pextrd", form: FORM_PINSR, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    # ptest defines zf and cf, tighten to defined once the seed assembles ptest for the probe
    OpRow{op: PTEST, name: "ptest", form: FORM_PACKED, shape: SHAPE_USE, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: CPUID, name: "cpuid", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: MUL, name: "mul", form: FORM_MUL1, shape: SHAPE_USE, arity: 1, mem: MEM_OPERAND, flags: FL_WRITTEN, mul: ct.CT_MUL_WIDE_U, one: ct.CT_MUL_WIDE_U},
    # bsf and bsr define zf and leave cf undefined; the three counts define
    # both, but a defining row must be measured by the hardware probe, which
    # the seed cannot assemble yet, so written is their reading until it can
    OpRow{op: BSF, name: "bsf", form: FORM_BITSCAN, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: BSR, name: "bsr", form: FORM_BITSCAN, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: POPCNT, name: "popcnt", form: FORM_BITSCAN, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: LZCNT, name: "lzcnt", form: FORM_BITSCAN, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: TZCNT, name: "tzcnt", form: FORM_BITSCAN, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: BSWAP, name: "bswap", form: FORM_BSWAP, shape: SHAPE_RW, arity: 1, mem: MEM_NONE, flags: FL_KEEP},
    # a double shift leaves the flags alone for a zero count and writes them otherwise
    OpRow{op: SHLD, name: "shld", form: FORM_DSHIFT, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_VAR_SHIFT},
    OpRow{op: SHRD, name: "shrd", form: FORM_DSHIFT, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_VAR_SHIFT},
    OpRow{op: PMULLD, name: "pmulld", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, mul: ct.CT_MUL_LOW, lanes: 32},
    OpRow{op: PUNPCKHBW, name: "punpckhbw", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PUNPCKHWD, name: "punpckhwd", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PUNPCKHDQ, name: "punpckhdq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PSRLDQ, name: "psrldq", form: FORM_PSLL, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    # an extend writes every lane of its destination from its source's low half
    OpRow{op: PMOVSXBW, name: "pmovsxbw", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVSXWD, name: "pmovsxwd", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVSXDQ, name: "pmovsxdq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVZXBW, name: "pmovzxbw", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVZXWD, name: "pmovzxwd", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVZXDQ, name: "pmovzxdq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PSRLQ, name: "psrlq", form: FORM_PSLL, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: PSLLQ, name: "psllq", form: FORM_PSLL, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: PSRLW, name: "psrlw", form: FORM_PSLL, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: PSRLD, name: "psrld", form: FORM_PSLL, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    # sbb reads the carry and writes the flags; written until the probe can
    # measure it, since the seed cannot assemble it yet
    OpRow{op: SBB, name: "sbb", form: FORM_CARRY, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_CARRY},
    # the aes rounds and the carry-less multiply take a fixed number of cycles
    # whatever their data (intel's data operand independent timing list)
    OpRow{op: AESENC, name: "aesenc", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: AESENCLAST, name: "aesenclast", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: AESDEC, name: "aesdec", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: AESDECLAST, name: "aesdeclast", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: AESIMC, name: "aesimc", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: AESKEYGENASSIST, name: "aeskeygenassist", form: FORM_PACKED, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PCLMULQDQ, name: "pclmulqdq", form: FORM_PACKED, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
};

fun class_of(r: *OpRow) ct.AsmClass {
    if (r.flags == FL_UNKNOWN)      { ret ct.asm_unknown(); }
    if (r.flags == FL_BRANCH_FLAGS) { ret ct.asm_branch_flags(); }
    if (r.flags == FL_BRANCH_REG)   { ret ct.untouched_branch_reg(); }
    var a: ct.AsmClass = ct.asm_op(r.ctop);
    if (r.mul != ct.CT_MUL_NONE && r.lanes != 0) { a = ct.asm_mul_lanes(r.mul, r.lanes); }
    if (r.mul != ct.CT_MUL_NONE && r.lanes == 0) { a = ct.asm_mul_forms(r.mul, r.one); }
    if (r.flags == FL_DEFINED)                   { ret ct.flags_defined(a); }
    if (r.flags == FL_WRITTEN)                   { ret ct.flags_written(a); }
    if (r.flags == FL_READ)                      { ret ct.flags_read(a); }
    if (r.flags == FL_OPAQUE)                    { ret ct.flags_opaque(a); }
    if (r.flags == FL_CARRY)                     { ret ct.flags_written(ct.flags_read(a)); }
    ret ct.flags_untouched(a);
}

# the row of an opcode; the inline-asm block marker and anything outside the
# catalog describe as the marker's row, FORM_NONE with an unknown class
pub fun describe(op: u16) OpDesc {
    var r: *OpRow = ?OPS[ASM_BLOCK];
    if (op::u32 < OPCODE_COUNT) { r = ?OPS[op]; }
    var d: OpDesc;
    d.name  = r.name;
    d.form  = r.form;
    d.shape = r.shape;
    d.arity = r.arity;
    d.mem   = r.mem;
    d.cls   = class_of(r);
    ret d;
}

# every row sits at its opcode's value, so an opcode added without a row, or
# two opcodes merged in at one value, fails here
test describe__every_row_sits_at_its_opcode {
    var i: u32 = 0;
    for (i < OPCODE_COUNT) {
        if (OPS[i].op::u32 != i) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the forms whose operands live in the xmm file, wholly or on one side
#[testing]
pub fun form_is_float(form: Form) bool {
    ret form == FORM_MOVQ || form == FORM_SSE_MOV || form == FORM_SSE_MOVA ||
        form == FORM_SSE_ALU || form == FORM_UCOMIS || form == FORM_CVT ||
        form == FORM_XORPS || form == FORM_PACKED || form == FORM_PSHUF || form == FORM_PSLL ||
        form == FORM_PINSR;
}

#[testing]
pub fun is_fp_opcode(op: u16) bool {
    ret form_is_float(describe(op).form);
}

pub fun reg_name(ctx: ptr, id: i32, size: u8) str {
    if (size == 1) {
        if (id == RAX) { ret "al"; }
        if (id == RCX) { ret "cl"; }
        if (id == RDX) { ret "dl"; }
        if (id == RBX) { ret "bl"; }
        if (id == RSP) { ret "spl"; }
        if (id == RBP) { ret "bpl"; }
        if (id == RSI) { ret "sil"; }
        if (id == RDI) { ret "dil"; }
        if (id == R8)  { ret "r8b"; }
        if (id == R9)  { ret "r9b"; }
        if (id == R10) { ret "r10b"; }
        if (id == R11) { ret "r11b"; }
        if (id == R12) { ret "r12b"; }
        if (id == R13) { ret "r13b"; }
        if (id == R14) { ret "r14b"; }
        if (id == R15) { ret "r15b"; }
    }

    if (size == 2) {
        if (id == RAX) { ret "ax"; }
        if (id == RCX) { ret "cx"; }
        if (id == RDX) { ret "dx"; }
        if (id == RBX) { ret "bx"; }
        if (id == RSP) { ret "sp"; }
        if (id == RBP) { ret "bp"; }
        if (id == RSI) { ret "si"; }
        if (id == RDI) { ret "di"; }
        if (id == R8)  { ret "r8w"; }
        if (id == R9)  { ret "r9w"; }
        if (id == R10) { ret "r10w"; }
        if (id == R11) { ret "r11w"; }
        if (id == R12) { ret "r12w"; }
        if (id == R13) { ret "r13w"; }
        if (id == R14) { ret "r14w"; }
        if (id == R15) { ret "r15w"; }
    }

    if (size == 4) {
        if (id == RAX) { ret "eax"; }
        if (id == RCX) { ret "ecx"; }
        if (id == RDX) { ret "edx"; }
        if (id == RBX) { ret "ebx"; }
        if (id == RSP) { ret "esp"; }
        if (id == RBP) { ret "ebp"; }
        if (id == RSI) { ret "esi"; }
        if (id == RDI) { ret "edi"; }
        if (id == R8)  { ret "r8d"; }
        if (id == R9)  { ret "r9d"; }
        if (id == R10) { ret "r10d"; }
        if (id == R11) { ret "r11d"; }
        if (id == R12) { ret "r12d"; }
        if (id == R13) { ret "r13d"; }
        if (id == R14) { ret "r14d"; }
        if (id == R15) { ret "r15d"; }
    }

    if (id == RAX) { ret "rax"; }
    if (id == RCX) { ret "rcx"; }
    if (id == RDX) { ret "rdx"; }
    if (id == RBX) { ret "rbx"; }
    if (id == RSP) { ret "rsp"; }
    if (id == RBP) { ret "rbp"; }
    if (id == RSI) { ret "rsi"; }
    if (id == RDI) { ret "rdi"; }
    if (id == R8)  { ret "r8"; }
    if (id == R9)  { ret "r9"; }
    if (id == R10) { ret "r10"; }
    if (id == R11) { ret "r11"; }
    if (id == R12) { ret "r12"; }
    if (id == R13) { ret "r13"; }
    if (id == R14) { ret "r14"; }
    if (id == R15) { ret "r15"; }

    ret "???";
}

pub fun fp_reg_name(cid: i32) str {
    val id: i32 = isa.regid_index(cid);
    if (id == 0)  { ret "xmm0"; }
    if (id == 1)  { ret "xmm1"; }
    if (id == 2)  { ret "xmm2"; }
    if (id == 3)  { ret "xmm3"; }
    if (id == 4)  { ret "xmm4"; }
    if (id == 5)  { ret "xmm5"; }
    if (id == 6)  { ret "xmm6"; }
    if (id == 7)  { ret "xmm7"; }
    if (id == 8)  { ret "xmm8"; }
    if (id == 9)  { ret "xmm9"; }
    if (id == 10) { ret "xmm10"; }
    if (id == 11) { ret "xmm11"; }
    if (id == 12) { ret "xmm12"; }
    if (id == 13) { ret "xmm13"; }
    if (id == 14) { ret "xmm14"; }
    if (id == 15) { ret "xmm15"; }
    ret "???";
}

#[testing]
pub fun callee_saved_gp_list(abi_vt: *abi.AbiVTable, out: *i32) i32 {
    ret callee_saved_gp_list_from(abi_vt.callee_saved, out);
}

pub fun callee_saved_gp_list_from(fill: isa.RegFileFn, out: *i32) i32 {
    var file:  [32]isa.Register;
    var total: i32 = fill(?file[0]);
    if (total > 32) { total = 32; }

    var n: i32 = 0;
    var i: i32 = 0;
    for (i < total) {
        val id: i32 = file[i].id;
        if (isa.regid_class(id) == isa.REG_CLASS_ID_GP &&
            id >= 0 && id < GP_COUNT &&
            id != STACK_REG && id != FRAME_REG) {
            out[n] = id;
            n      = n + 1;
        }
        i = i + 1;
    }
    ret n;
}
