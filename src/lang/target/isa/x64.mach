# the avx2 per-lane variable shifts: each lane of the first source
# shifted by the count in the same lane of the second, vex-encoded with the
# first source in vvvv
pub val VPSLLVD: Opcode = 212;
pub val VPSRLVD: Opcode = 213;
pub val VPSRAVD: Opcode = 214;
pub val VPSLLVQ: Opcode = 215;
