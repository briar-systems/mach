# register ids: the hardware number is regid_index of each
pub val RAX: i32 = isa_inst.REG_GP_BASE | 0;

pub val RCX: i32 = isa_inst.REG_GP_BASE | 1;

pub val RDX: i32 = isa_inst.REG_GP_BASE | 2;

pub val RBX: i32 = isa_inst.REG_GP_BASE | 3;

pub val RSP: i32 = isa_inst.REG_GP_BASE | 4;

pub val RBP: i32 = isa_inst.REG_GP_BASE | 5;

pub val RSI: i32 = isa_inst.REG_GP_BASE | 6;

pub val RDI: i32 = isa_inst.REG_GP_BASE | 7;

pub val R8: i32 = isa_inst.REG_GP_BASE | 8;

pub val R9: i32 = isa_inst.REG_GP_BASE | 9;

pub val R10: i32 = isa_inst.REG_GP_BASE | 10;

pub val R11: i32 = isa_inst.REG_GP_BASE | 11;

pub val R12: i32 = isa_inst.REG_GP_BASE | 12;

pub val R13: i32 = isa_inst.REG_GP_BASE | 13;

pub val R14: i32 = isa_inst.REG_GP_BASE | 14;

pub val R15: i32 = isa_inst.REG_GP_BASE | 15;

pub val XMM0: i32 = isa_inst.REG_FP_BASE | 0;

#[testing]
pub val XMM1: i32 = isa_inst.REG_FP_BASE | 1;

#[testing]
pub val XMM2: i32 = isa_inst.REG_FP_BASE | 2;

#[testing]
pub val XMM3: i32 = isa_inst.REG_FP_BASE | 3;

#[testing]
