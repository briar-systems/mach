    OpRow{op: STOSQ, name: "stosq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: LODSB, name: "lodsb", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
