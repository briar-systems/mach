# the avx2 per-lane variable shifts: each lane of the first source
# shifted by the count in the same lane of the second, vex-encoded with the
# first source in vvvv
pub val VPSLLVD: Opcode = 212;

pub val VPSRLVD: Opcode = 213;

pub val VPSRAVD: Opcode = 214;

pub val VPSLLVQ: Opcode = 215;

pub val VPSRLVQ: Opcode = 216;

# the 32-byte register moves of a ymm value an avx calling convention carries,
# and the clear of the ymm upper halves once one has left its register
pub val VMOVDQU: Opcode = 217;

pub val VZEROUPPER: Opcode = 218;

# the f16c conversions between f16 and binary32, and the 16-bit moves
# between an xmm register's low word and memory that carry an f16 there
pub val VCVTPH2PS: Opcode = 219;

pub val VCVTPS2PH: Opcode = 220;

pub val PINSRW: Opcode = 221;

pub val PEXTRW: Opcode = 222;

# the avx512dq low multiply of 64-bit lanes, evex-encoded with the first
# source in vvvv; its 128-bit form is avx512vl as well
pub val VPMULLQ: Opcode = 223;

# the string instructions at each width beside movsb: each steps rsi,
# rdi or both by its width, and a rep prefix (FLAG_REP, FLAG_REPNE) repeats it
# rcx times. movsd_string is the string move, not the scalar-double MOVSD
pub val MOVSW: Opcode = 224;

pub val MOVSD_STRING: Opcode = 225;

pub val MOVSQ: Opcode = 226;

