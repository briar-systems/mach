};

pub fun reg_name(ctx: ptr, id: i32, size: u8) str {
    var width: u8 = 8;
    if (size == 1 || size == 2 || size == 4) { width = size; }
    var i: u32 = 0;
    for (i < REG_NAME_COUNT) {
        if (REG_NAMES[i].id == id && REG_NAMES[i].width == width) { ret REG_NAMES[i].name; }
        i = i + 1;
    }
    ret "???";
}

# the ymm name of a vector register, the 32-byte view of its xmm
val YMM_NAMES: [16]str = [16]str{"ymm0", "ymm1", "ymm2", "ymm3", "ymm4", "ymm5", "ymm6", "ymm7", "ymm8", "ymm9", "ymm10", "ymm11", "ymm12", "ymm13", "ymm14", "ymm15"};

pub fun ymm_reg_name(cid: i32) str {
    val id: i32 = isa_inst.regid_index(cid);
    if (id < 0 || id >= 16) { ret "???"; }
    ret YMM_NAMES[id];
}

val XMM_NAMES: [16]str = [16]str{"xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"};

pub fun fp_reg_name(cid: i32) str {
    val id: i32 = isa_inst.regid_index(cid);
    if (id < 0 || id >= 16) { ret "???"; }
    ret XMM_NAMES[id];
}

#[testing]
pub fun callee_saved_gp_list(abi_vt: *abi.AbiVTable, out: *i32) i32 {
    ret callee_saved_gp_list_from(abi_vt.callee_saved, out);
}

pub fun callee_saved_gp_list_from(file: target_model.RegFile, out: *i32) i32 {
    var total: i32 = file.count;
    if (total > 32) { total = 32; }

    var n: i32 = 0;
    var i: i32 = 0;
    for (i < total) {
        val id: i32 = file.regs[i].id;
        if (isa_inst.regid_class(id) == isa_inst.REG_CLASS_ID_GP &&
            isa_inst.regid_index(id) < GP_COUNT &&
            id != STACK_REG && id != FRAME_REG) {
            out[n] = id;
            n      = n + 1;
        }
        i = i + 1;
    }
    ret n;
}
