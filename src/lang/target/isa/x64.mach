    OpRow{op: VPSRLVQ, name: "vpsrlvq", form: FORM_VEX3, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: VMOVDQU, name: "vmovdqu", form: FORM_SSE_MOVA, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: VZEROUPPER, name: "vzeroupper", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: VCVTPH2PS, name: "vcvtph2ps", form: FORM_SSE_MOVA, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: VCVTPS2PH, name: "vcvtps2ph", form: FORM_PINSR, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: PINSRW, name: "pinsrw", form: FORM_PINSR, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
