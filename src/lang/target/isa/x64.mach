# the sse41 extensions over more than one doubling of the lane: bytes
# to doublewords and quadwords, words to quadwords
pub val PMOVSXBD: Opcode = 243;

pub val PMOVSXBQ: Opcode = 244;

pub val PMOVSXWQ: Opcode = 245;

pub val PMOVZXBD: Opcode = 246;

pub val PMOVZXBQ: Opcode = 247;

pub val PMOVZXWQ: Opcode = 248;

# the sum of absolute byte differences into each quadword, the widening sum
# of a byte vector's eight lanes per quadword against zero
pub val PSADBW: Opcode = 249;

# the 256-bit lane crossings of a ymm register: a 128-bit half out
# of it and into it (avx), and a permutation of its quadwords (avx2)
pub val VEXTRACTF128: Opcode = 250;

pub val VINSERTF128: Opcode = 251;

pub val VPERMQ: Opcode = 252;

# the sse42 signed compare of 64-bit lanes, all ones where the first is the
# greater
pub val PCMPGTQ: Opcode = 253;

# the sse41 equality of 64-bit lanes, all ones where they are equal
pub val PCMPEQQ: Opcode = 254;

