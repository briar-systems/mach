    OpRow{op: SCASD, name: "scasd", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: SCASQ, name: "scasq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: PMOVSXBD, name: "pmovsxbd", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVSXBQ, name: "pmovsxbq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVSXWQ, name: "pmovsxwq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVZXBD, name: "pmovzxbd", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVZXBQ, name: "pmovzxbq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PMOVZXWQ, name: "pmovzxwq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PSADBW, name: "psadbw", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: VEXTRACTF128, name: "vextractf128", form: FORM_PSHUF, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: VINSERTF128, name: "vinsertf128", form: FORM_VEX3, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: VPERMQ, name: "vpermq", form: FORM_PSHUF, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PCMPGTQ, name: "pcmpgtq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: PCMPEQQ, name: "pcmpeqq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
};

fun class_of(r: *OpRow) ct.AsmClass {
    if (r.flags == FL_UNKNOWN)      { ret ct.asm_unknown(); }
    if (r.flags == FL_BRANCH_FLAGS) { ret ct.asm_branch_flags(); }
    if (r.flags == FL_BRANCH_REG)   { ret ct.untouched_branch_reg(); }
    var a: ct.AsmClass = ct.asm_op(r.ctop);
    if (r.mul != ct.CT_MUL_NONE && r.lanes != 0) { a = ct.asm_mul_lanes(r.mul, r.lanes); }
    if (r.mul != ct.CT_MUL_NONE && r.lanes == 0) { a = ct.asm_mul_forms(r.mul, r.one); }
    if (r.flags == FL_DEFINED)                   { ret ct.flags_defined(a); }
    if (r.flags == FL_WRITTEN)                   { ret ct.flags_written(a); }
    if (r.flags == FL_READ)                      { ret ct.flags_read(a); }
    if (r.flags == FL_OPAQUE)                    { ret ct.flags_opaque(a); }
    if (r.flags == FL_CARRY)                     { ret ct.flags_written(ct.flags_read(a)); }
    ret ct.flags_untouched(a);
}

# the row of an opcode; the inline-asm block marker and anything outside the
# catalog describe as the marker's row, FORM_NONE with an unknown class
pub fun describe(op: u16) OpDesc {
    var r: *OpRow = ?OPS[ASM_BLOCK];
    if (op::u32 < OPCODE_COUNT) { r = ?OPS[op]; }
    var d: OpDesc;
    d.name  = r.name;
    d.form  = r.form;
    d.shape = r.shape;
    d.arity = r.arity;
    d.mem   = r.mem;
    d.cls   = class_of(r);
    ret d;
}

# every row sits at its opcode's value, so an opcode added without a row, or
# two opcodes merged in at one value, fails here
test describe__every_row_sits_at_its_opcode {
    var i: u32 = 0;
    for (i < OPCODE_COUNT) {
        if (OPS[i].op::u32 != i) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the forms whose operands live in the xmm file, wholly or on one side
#[testing]
pub fun form_is_float(form: Form) bool {
    ret form == FORM_MOVQ || form == FORM_SSE_MOV || form == FORM_SSE_MOVA ||
        form == FORM_SSE_ALU || form == FORM_UCOMIS || form == FORM_CVT ||
        form == FORM_XORPS || form == FORM_PACKED || form == FORM_PSHUF || form == FORM_PSLL ||
        form == FORM_PINSR || form == FORM_VEX3;
}

#[testing]
pub fun is_fp_opcode(op: u16) bool {
    ret form_is_float(describe(op).form);
}

# a general register's name at one operand width, the one table the listing
# prints from and the inline assembly grammar reads
pub rec RegName {
    name:  str;
    id:    i32;
    width: u8;
}

pub val REG_NAME_COUNT: u32 = 64;

pub val REG_NAMES: [REG_NAME_COUNT]RegName = [REG_NAME_COUNT]RegName{
    RegName{name: "al", id: RAX, width: 1},
    RegName{name: "cl", id: RCX, width: 1},
    RegName{name: "dl", id: RDX, width: 1},
    RegName{name: "bl", id: RBX, width: 1},
    RegName{name: "spl", id: RSP, width: 1},
    RegName{name: "bpl", id: RBP, width: 1},
    RegName{name: "sil", id: RSI, width: 1},
    RegName{name: "dil", id: RDI, width: 1},
    RegName{name: "r8b", id: R8, width: 1},
    RegName{name: "r9b", id: R9, width: 1},
    RegName{name: "r10b", id: R10, width: 1},
    RegName{name: "r11b", id: R11, width: 1},
    RegName{name: "r12b", id: R12, width: 1},
    RegName{name: "r13b", id: R13, width: 1},
    RegName{name: "r14b", id: R14, width: 1},
    RegName{name: "r15b", id: R15, width: 1},
    RegName{name: "ax", id: RAX, width: 2},
    RegName{name: "cx", id: RCX, width: 2},
    RegName{name: "dx", id: RDX, width: 2},
    RegName{name: "bx", id: RBX, width: 2},
    RegName{name: "sp", id: RSP, width: 2},
    RegName{name: "bp", id: RBP, width: 2},
    RegName{name: "si", id: RSI, width: 2},
    RegName{name: "di", id: RDI, width: 2},
    RegName{name: "r8w", id: R8, width: 2},
    RegName{name: "r9w", id: R9, width: 2},
    RegName{name: "r10w", id: R10, width: 2},
    RegName{name: "r11w", id: R11, width: 2},
    RegName{name: "r12w", id: R12, width: 2},
    RegName{name: "r13w", id: R13, width: 2},
    RegName{name: "r14w", id: R14, width: 2},
    RegName{name: "r15w", id: R15, width: 2},
