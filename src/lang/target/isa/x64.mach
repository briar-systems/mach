    OpRow{op: SHRD, name: "shrd", form: FORM_DSHIFT, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_VAR_SHIFT},
