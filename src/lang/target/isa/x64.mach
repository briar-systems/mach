# the one-operand unsigned widening multiply: r/m into rdx:rax
pub val MUL: Opcode = 168;

# the bit-scan family, reached only from inline asm: the baseline scans and
# byte swap, and the counts under popcnt, lzcnt and bmi1
pub val BSF: Opcode = 169;

pub val BSR: Opcode = 170;

pub val POPCNT: Opcode = 171;

pub val LZCNT: Opcode = 172;

pub val TZCNT: Opcode = 173;

pub val BSWAP: Opcode = 174;

# the double-precision shifts: r/m shifted with bits fed in from a register
pub val SHLD: Opcode = 175;

pub val SHRD: Opcode = 176;

# the sse41 packed lowering row: the 32-bit lane multiply the packed table
# gates on the extension, reached from lowering and from inline asm alike
pub val PMULLD: Opcode = 177;

# the lane-halving extensions: the baseline high unpacks and the
# byte shift that reach the high half, and the sse41 sign and zero extends
# the encoder chooses on the same declared cells
pub val PUNPCKHBW: Opcode = 178;

pub val PUNPCKHWD: Opcode = 179;

pub val PUNPCKHDQ: Opcode = 180;

pub val PSRLDQ: Opcode = 181;

