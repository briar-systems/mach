pub val XMM7: i32 = isa_inst.REG_FP_BASE | 7;

pub val XMM8: i32 = isa_inst.REG_FP_BASE | 8;

pub val XMM14: i32 = isa_inst.REG_FP_BASE | 14;

pub val XMM15: i32 = isa_inst.REG_FP_BASE | 15;

val GP_COUNT: i32 = 16;

pub val FP_COUNT: i32 = 16;

pub val STACK_REG: i32 = RSP;

pub val FRAME_REG: i32 = RBP;

pub val SCRATCH_REG: i32 = R11;

pub val SCRATCH_REG2: i32 = R10;

