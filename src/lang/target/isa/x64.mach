    # a cmov reads its destination too, which it keeps when the condition fails
    OpRow{op: CMOVE, name: "cmove", form: FORM_CMOV, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_READ},
    OpRow{op: CMOVNE, name: "cmovne", form: FORM_CMOV, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_READ},
