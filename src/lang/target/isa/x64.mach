    OpRow{op: TZCNT, name: "tzcnt", form: FORM_BITSCAN, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: BSWAP, name: "bswap", form: FORM_BSWAP, shape: SHAPE_RW, arity: 1, mem: MEM_NONE, flags: FL_KEEP},
