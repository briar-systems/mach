use std.types.string.str;

# hardware register numbers; a register id is regid_make of one
pub val X0:  i32 = 0;
pub val X1:  i32 = 1;
val     X2:  i32 = 2;
val     X3:  i32 = 3;
val     X4:  i32 = 4;
val     X5:  i32 = 5;
val     X6:  i32 = 6;
val     X7:  i32 = 7;
val     X8:  i32 = 8;
val     X28: i32 = 28;
pub val X29: i32 = 29;
pub val X31: i32 = 31;

pub val ZERO: i32 = X0;
pub val RA:   i32 = X1;
pub val SP:   i32 = X2;
pub val GP:   i32 = X3;
pub val TP:   i32 = X4;
pub val FP:   i32 = X8;

#[testing]
pub val STACK_REG: i32 = SP;
#[testing]
pub val FRAME_REG: i32 = FP;

val     T0: i32 = X5;
val     T1: i32 = X6;
pub val T2: i32 = X7;
pub val T3: i32 = X28;
pub val T4: i32 = X29;

pub val SCRATCH_REG:  i32 = T0;
pub val SCRATCH_REG2: i32 = T1;

pub val F0:  i32 = 0;
pub val F30: i32 = 30;
pub val F31: i32 = 31;

pub def Opcode: u16;

pub val NOP:    Opcode = 0;
pub val RET:    Opcode = 1;
pub val ADD:    Opcode = 2;
pub val SUB:    Opcode = 3;
pub val MUL:    Opcode = 4;
pub val AND:    Opcode = 5;
pub val OR:     Opcode = 6;
pub val XOR:    Opcode = 7;
pub val SLL:    Opcode = 8;
pub val SRL:    Opcode = 9;
pub val SRA:    Opcode = 10;
pub val NEG:    Opcode = 11;
pub val NOT:    Opcode = 12;
pub val MOV:    Opcode = 13;
pub val JMP:    Opcode = 14;
pub val EBREAK: Opcode = 15;
pub val FMV:    Opcode = 16;
pub val MULHU:  Opcode = 17;
pub val MULH:   Opcode = 18;

# the ABI name of each integer and float register, by index: the one table the
# listing prints from and the inline assembly grammar reads
pub val GP_NAMES: [32]str = [32]str{"zero", "ra", "sp", "gp", "tp", "t0", "t1", "t2", "s0", "s1", "a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "t3", "t4", "t5", "t6"};

pub val FP_NAMES: [32]str = [32]str{"ft0", "ft1", "ft2", "ft3", "ft4", "ft5", "ft6", "ft7", "fs0", "fs1", "fa0", "fa1", "fa2", "fa3", "fa4", "fa5", "fa6", "fa7", "fs2", "fs3", "fs4", "fs5", "fs6", "fs7", "fs8", "fs9", "fs10", "fs11", "ft8", "ft9", "ft10", "ft11"};
