use io_error: std.io.error;

pub rec Site {
    path: str;
    line: usize;
    fun:  str;
    decl: str;
}

#[testing]
val CENSUS_HARNESS: i32 = 1;
#[testing]
val CENSUS_UNPERMITTED: i32 = 2;
#[testing]
val CENSUS_COUNT: i32 = 3;

#[testing]
val ALLOWED_LEN: usize = 12;

#[testing]
fun allowed_fun(i: usize) str {
    if (i == 0)  { ret "operand_blank"; }
    if (i == 1)  { ret "inst_blank"; }
    if (i == 2)  { ret "isa_common"; }
    if (i == 3)  { ret "reg_machine"; }
    if (i == 4)  { ret "module_emitter"; }
    if (i == 5)  { ret "reloc_seam"; }
    if (i == 6)  { ret "op_none"; }
    if (i == 7)  { ret "instr"; }
    if (i == 8)  { ret "abi_vtable"; }
    if (i == 9)  { ret "vreg"; }
    if (i == 11) { ret "value_abi_vtable"; }
    ret "asm_bind";
}

#[testing]
fun allowed_file(i: usize) str {
    if (i == 0)            { ret "src/lang/target/isa.mach"; }
    if (i == 1)            { ret "src/lang/target/isa.mach"; }
    if (i == 2)            { ret "src/lang/target/isa.mach"; }
    if (i == 3)            { ret "src/lang/target/isa.mach"; }
    if (i == 4)            { ret "src/lang/target/isa.mach"; }
    if (i == 5)            { ret "src/lang/target/isa.mach"; }
    if (i == 6)            { ret "src/lang/target/isa/asm.mach"; }
    if (i == 7)            { ret "src/lang/be/codegen/mir.mach"; }
    if (i == 8 || i == 11) { ret "src/lang/target/abi.mach"; }
    ret "src/lang/be/codegen/mir.mach";
}

#[testing]
fun allowed_count(i: usize) usize {
    ret 1;
}

#[testing]
fun group_of(path: str, name: str) usize {
    var i: usize = 0;
    for (i < ALLOWED_LEN) {
        if (str_equals(path, allowed_file(i)) && str_equals(name, allowed_fun(i))) { ret i; }
        i = i + 1;
    }
    ret ALLOWED_LEN;
}

#[testing]
fun is_ident(c: char) bool {
    if (c >= 'a' && c <= 'z') { ret true; }
    if (c >= 'A' && c <= 'Z') { ret true; }
    if (c >= '0' && c <= '9') { ret true; }
    ret c == '_';
}

#[testing]
fun skip_blank(text: str, i: usize) usize {
    var p: usize = i;
    for (text[p] == ' ' || text[p] == '\t') { p = p + 1; }
    ret p;
}

#[testing]
fun decl_type(text: str, start: usize, tstart: *usize, tlen: *usize) opt[usize] {
    var p: usize = skip_blank(text, start);
    if (!str_region_equals(text, p, 4, "var ")) { ret opt[usize].none{}; }
    p = skip_blank(text, p + 3);

    val name_at: usize = p;
    for (is_ident(text[p])) { p = p + 1; }
    if (p == name_at) { ret opt[usize].none{}; }

    p = skip_blank(text, p);
    if (text[p] != ':') { ret opt[usize].none{}; }
    p = skip_blank(text, p + 1);

    val ty_at: usize = p;
    for (is_ident(text[p]) || text[p] == '.') { p = p + 1; }
    if (p == ty_at) { ret opt[usize].none{}; }

    @tstart = ty_at;
    @tlen   = p - ty_at;
    ret opt[usize].some{p};
}

#[testing]
fun is_model_type(text: str, at: usize, len: usize) bool {
    if (str_region_equals(text, at, len, "Inst"))              { ret true; }
    if (str_region_equals(text, at, len, "Operand"))           { ret true; }
    if (str_region_equals(text, at, len, "IsaVTable"))         { ret true; }
    if (str_region_equals(text, at, len, "RegMachine"))        { ret true; }
    if (str_region_equals(text, at, len, "ModuleEmitter"))     { ret true; }
    if (str_region_equals(text, at, len, "RelocSeam"))         { ret true; }
    if (str_region_equals(text, at, len, "MirInstr"))          { ret true; }
    if (str_region_equals(text, at, len, "MirVReg"))           { ret true; }
    if (str_region_equals(text, at, len, "MirAsmBind"))        { ret true; }
    if (str_region_equals(text, at, len, "AbiVTable"))         { ret true; }
    if (str_region_equals(text, at, len, "isa.Inst"))          { ret true; }
    if (str_region_equals(text, at, len, "isa.Operand"))       { ret true; }
    if (str_region_equals(text, at, len, "isa.IsaVTable"))     { ret true; }
    if (str_region_equals(text, at, len, "isa.RegMachine"))    { ret true; }
    if (str_region_equals(text, at, len, "isa.ModuleEmitter")) { ret true; }
    if (str_region_equals(text, at, len, "isa.RelocSeam"))     { ret true; }
    if (str_region_equals(text, at, len, "mir.MirInstr"))      { ret true; }
    if (str_region_equals(text, at, len, "mir.MirVReg"))       { ret true; }
    if (str_region_equals(text, at, len, "mir.MirAsmBind"))    { ret true; }
    if (str_region_equals(text, at, len, "abi.AbiVTable"))     { ret true; }
    ret false;
}

#[testing]
fun fun_name(text: str, start: usize, nstart: *usize, nlen: *usize) bool {
    var p: usize = start;
    if (str_region_equals(text, p, 8, "pub fun ")) { p = p + 8; }
    or (str_region_equals(text, p, 4, "fun "))     { p = p + 4; }
    or                                             { ret false; }

    p = skip_blank(text, p);
    val at: usize = p;
    for (is_ident(text[p])) { p = p + 1; }
    if (p == at) { ret false; }

    @nstart = at;
    @nlen   = p - at;
    ret true;
}

#[testing]
fun scan_file(alloc: *A.Allocator, path: str, sites: *Vector[Site]) err[fail.Fail] {
    val rt: res[str, fs.FsError] = fs.read_string(alloc, path);
    if (sel rt.err) { ret err[fail.Fail].err{fail.fs_refused(rt.err)}; }
    val text: str   = rt.ok;
    val n:    usize = str_len(text);

    var cur_at:  usize = 0;
    var cur_len: usize = 0;
    var has_fun: bool  = false;

    var line:  usize = 1;
    var start: usize = 0;
    for (start < n) {
        var end: usize = start;
        for (end < n && text[end] != '\n') { end = end + 1; }

        var na: usize = 0;
        var nl: usize = 0;
        if (fun_name(text, start, ?na, ?nl)) {
            cur_at  = na;
            cur_len = nl;
            has_fun = true;
        }

        var ta:    usize      = 0;
        var tl:    usize      = 0;
        val after: opt[usize] = decl_type(text, start, ?ta, ?tl);
        if (sel after.some) {
            if (is_model_type(text, ta, tl)) {
                val p: usize = skip_blank(text, after.some);
                if (p < end && text[p] == ';') {
                    val ds: usize               = skip_blank(text, start);
                    val rd: res[str, fail.Fail] = str_slice(alloc, text, ds, end - ds);
                    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }

                    var s: Site;
                    s.path = path;
                    s.line = line;
                    s.fun  = "<top>";
                    s.decl = rd.ok;
                    if (has_fun) {
                        val rn: res[str, fail.Fail] = str_slice(alloc, text, cur_at, cur_len);
                        if (sel rn.err) { ret err[fail.Fail].err{rn.err}; }
                        s.fun = rn.ok;
                    }
                    val r_196: res[usize, A.Error] = vector.push[Site](sites, s);
                    if (sel r_196.err) {
                        ret err[fail.Fail].err{fail.message("out of memory recording a construction site")};
                    }
                }
            }
        }

        start = end + 1;
        line  = line + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun str_slice(alloc: *A.Allocator, text: str, at: usize, len: usize) res[str, fail.Fail] {
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, len + 1);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.message("out of memory copying a name")}; }
    val buf: *u8   = rb.ok;
    var i:   usize = 0;
    for (i < len) {
        buf[i] = text[at + i]::u8;
        i      = i + 1;
    }
    buf[len] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

#[testing]
fun scan_tree(alloc: *A.Allocator, dir: str, sites: *Vector[Site]) err[fail.Fail] {
    val rd: res[Vector[str], fs.FsError] = fs.read_dir(alloc, dir);
    if (sel rd.err) { ret err[fail.Fail].err{fail.fs_refused(rd.err)}; }
    var names: Vector[str] = rd.ok;

    var i: usize = 0;
    for (i < names.len) {
        val rg: opt[*str] = vector.get[str](?names, i);
        if (sel rg.none) { ret err[fail.Fail].err{fail.message("index out of bounds")}; }
        val name: str = @rg.some;
        i = i + 1;
        if (str_equals(name, ".") || str_equals(name, "..")) { cnt; }

        val rj: res[str, fail.Fail] = join_path(alloc, dir, name);
        if (sel rj.err) { ret err[fail.Fail].err{rj.err}; }
        val path: str = rj.ok;

        if (probe(fs.is_dir(path))) {
            val e: err[fail.Fail] = scan_tree(alloc, path, sites);
            if (sel e.err) { ret e; }
            cnt;
        }
        if (!str_ends_with(path, ".mach")) { cnt; }

        val e2: err[fail.Fail] = scan_file(alloc, path, sites);
        if (sel e2.err) { ret e2; }
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun join_path(alloc: *A.Allocator, dir: str, name: str) res[str, fail.Fail] {
    val dl: usize             = str_len(dir);
    val nl: usize             = str_len(name);
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, dl + nl + 2);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.message("out of memory joining a path")}; }
    val buf: *u8 = rb.ok;

    var i: usize = 0;
    for (i < dl) {
        buf[i] = dir[i]::u8;
        i      = i + 1;
    }
    buf[dl] = '/'::u8;
    var j: usize = 0;
    for (j < nl) {
        buf[dl + 1 + j] = name[j]::u8;
        j               = j + 1;
    }
    buf[dl + 1 + nl] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

# a filesystem predicate that cannot be asked answers no
#[testing]
fun probe(r: res[bool, io_error.Error]) bool {
    if (sel r.ok) { ret r.ok; }
    ret false;
}

#[testing]
fun find_root(alloc: *A.Allocator) opt[str] {
    var prefix: str   = ".";
    var depth:  usize = 0;
    for (depth < 8) {
        val rj: res[str, fail.Fail] = join_path(alloc, prefix, "src/lang/target/isa.mach");
        if (sel rj.err)               { ret opt[str].none{}; }
        if (probe(fs.is_file(rj.ok))) { ret opt[str].some{prefix}; }

        val ru: res[str, fail.Fail] = join_path(alloc, prefix, "..");
        if (sel ru.err) { ret opt[str].none{}; }
        prefix = ru.ok;
        depth  = depth + 1;
    }
    ret opt[str].none{};
}

#[testing]
fun relative(path: str, root: str) str {
    val rl: usize = str_len(root);
    if (str_region_equals(path, 0, rl, root) && path[rl] == '/') {
        ret (path::usize + rl + 1)::str;
    }
    ret path;
}

test blank__every_construction_site_is_constructed {
    var alloc: A.Allocator;
    page.make(?alloc);

    val rr: opt[str] = find_root(?alloc);
    if (!sel rr.some) {
        print.eprintln("census: cannot locate the source root from the working directory");
        ret CENSUS_HARNESS;
    }
    val root: str = rr.some;

    var sites: Vector[Site] = vector.init[Site](?alloc);

    val rj: res[str, fail.Fail] = join_path(?alloc, root, "src");
    if (sel rj.err) {
        print.eprintln("census: cannot form the source path");
        ret CENSUS_HARNESS;
    }
    val we: err[fail.Fail] = scan_tree(?alloc, rj.ok, ?sites);
    if (sel we.err) {
        print.eprintlnf("census: the walk failed: {}", fail.describe(we.err));
        ret CENSUS_HARNESS;
    }

    val total: usize = sites.len;
    if (total == 0) {
        print.eprintln("census: the walk found no declarations at all, so it checked nothing");
        ret CENSUS_HARNESS;
    }

    var unpermitted: usize = 0;
    var i:           usize = 0;
    for (i < total) {
        val rg: opt[*Site] = vector.get[Site](?sites, i);
        if (sel rg.none) {
            print.eprintln("census: the recorded site list is unreadable");
            ret CENSUS_HARNESS;
        }
        val s: *Site = rg.some;
        if (group_of(relative(s.path, root), s.fun) == ALLOWED_LEN) {
            unpermitted = unpermitted + 1;
            print.eprintlnf("census: hand-built record at {}:{} fun={} {}",
                relative(s.path, root), s.line, s.fun, s.decl);
        }
        i = i + 1;
    }
    if (unpermitted != 0) {
        print.eprintlnf("census: {} site(s) build a censused record by hand; build each through its constructor", unpermitted);
        ret CENSUS_UNPERMITTED;
    }

    var expected: usize = 0;
    var g:        usize = 0;
    for (g < ALLOWED_LEN) {
        var found: usize = 0;
        var j:     usize = 0;
        for (j < total) {
            val rg2: opt[*Site] = vector.get[Site](?sites, j);
            if (sel rg2.none) {
                print.eprintln("census: the recorded site list is unreadable");
                ret CENSUS_HARNESS;
            }
            val s2: *Site = rg2.some;
            if (group_of(relative(s2.path, root), s2.fun) == g) { found = found + 1; }
            j = j + 1;
        }
        if (found != allowed_count(g)) {
            print.eprintlnf("census: {}  fun={}  permits {} declaration(s), found {}",
                allowed_file(g), allowed_fun(g), allowed_count(g), found);
            ret CENSUS_COUNT;
        }
        expected = expected + allowed_count(g);
        g        = g + 1;
    }

    if (total != expected) {
        print.eprintlnf("census: {} site(s) scanned but {} accounted for", total, expected);
        ret CENSUS_HARNESS;
    }
    ret 0;
}

# the names between backticks on one markdown table row from `at`, each looked
# up as a row of `table`; the bits of the row, or none when a name is not a row
# or the line holds no name. `at` lands on the row's first `|`
#[testing]
fun doc_row_bits(text: str, at: usize, table: *extension.Extension, count: u32) opt[u64] {
    var bits: u64   = 0;
    var seen: bool  = false;
    var p:    usize = at;
    val n:    usize = str_len(text);
    for (p < n && text[p] != '\n') {
        if (text[p] == '`') {
            val start: usize = p + 1;
            var e:     usize = start;
            for (e < n && text[e] != '`' && text[e] != '\n') { e = e + 1; }
            if (e >= n || text[e] != '`') { ret opt[u64].none{}; }
            val bit: u64 = extension.bit_of(table, count, (?text[start])::str, e - start);
            if (bit == 0) { ret opt[u64].none{}; }
            bits = bits | bit;
            seen = true;
            p    = e + 1;
        }
        or { p = p + 1; }
    }
    if (!seen) { ret opt[u64].none{}; }
    ret opt[u64].some{bits};
}

# the offset just past the first occurrence of `needle` at or after `from`, or n when absent
#[testing]
fun doc_find(text: str, from: usize, needle: str) usize {
    val n:  usize = str_len(text);
    val nl: usize = str_len(needle);
    var p:  usize = from;
    for (p + nl <= n) {
        if (str_region_equals(text, p, nl, needle)) { ret p + nl; }
        p = p + 1;
    }
    ret n;
}

# doc/language/manifest.md carries the x86-64 level table and the x86_64 row of
# the extension table; both are the compiler's tables spelled through the
# names, and drift between them fails here (#3741)
test manifest_doc__levels_match_the_compiler_table {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rr: opt[str] = find_root(?alloc);
    if (!sel rr.some) {
        print.eprintln("levels: cannot locate the source root from the working directory");
        ret CENSUS_HARNESS;
    }
    val rj: res[str, fail.Fail] = join_path(?alloc, rr.some, "doc/language/manifest.md");
    if (sel rj.err) { ret CENSUS_HARNESS; }
    val rt: res[str, fs.FsError] = fs.read_string(?alloc, rj.ok);
    if (sel rt.err) {
        print.eprintln("levels: cannot read doc/language/manifest.md");
        ret CENSUS_HARNESS;
    }
    val text: str   = rt.ok;
    val n:    usize = str_len(text);

    # the x86_64 row of the extension table names every row of the vocabulary once
    val xrow: usize = doc_find(text, 0, "| `x86_64` | SSE2 |");
    if (xrow >= n) {
        print.eprintln("levels: manifest.md has no x86_64 extension row");
        ret 1;
    }
    val xbits: opt[u64] = doc_row_bits(text, xrow, ?x64.EXTENSIONS[0], x64.EXTENSION_COUNT);
    if (!sel xbits.some) {
        print.eprintln("levels: the x86_64 extension row in manifest.md names something that is not an x86_64 extension");
        ret 2;
    }
    if (xbits.some != extension.domain(?x64.EXTENSIONS[0], x64.EXTENSION_COUNT)) {
        print.eprintln("levels: the x86_64 extension row in manifest.md does not spell the compiler's vocabulary");
        ret 2;
    }

    # each level row lists the members beyond the level before it, in table order
    var at:    usize = doc_find(text, 0, "#### Levels");
    var below: u64   = 0;
    var i:     u32   = 0;
    for (i < x64.LEVEL_COUNT) {
        val lv:     *extension.Level = ?x64.LEVELS[i];
        var needle: [32]u8;
        var o:      usize            = 0;
        needle[o] = '|'::u8;
        o         = o + 1;
        needle[o] = ' '::u8;
        o         = o + 1;
        needle[o] = '`'::u8;
        o         = o + 1;
        var k: usize = 0;
        for (k < str_len(lv.name)) {
            needle[o] = lv.name[k]::u8;
            o         = o + 1;
            k         = k + 1;
        }
        needle[o] = '`'::u8;
        o         = o + 1;
        needle[o] = ' '::u8;
        o         = o + 1;
        needle[o] = '|'::u8;
        o         = o + 1;
        needle[o] = 0;
        val row: usize = doc_find(text, at, (?needle[0])::str);
        if (row >= n) {
            print.eprintlnf("levels: manifest.md has no row for {}", lv.name);
            ret 3;
        }
        val add: opt[u64] = doc_row_bits(text, row, ?x64.EXTENSIONS[0], x64.EXTENSION_COUNT);
        if (!sel add.some) {
            print.eprintlnf("levels: the {} row names something that is not an x86_64 extension", lv.name);
            ret 4;
        }
        if ((add.some & below) != 0 || (below | add.some) != lv.members) {
            var doc_s: [512]u8;
            var tab_s: [512]u8;
            extension.spell_bits(?x64.EXTENSIONS[0], x64.EXTENSION_COUNT, below | add.some, ?doc_s[0], 512, 0);
            extension.spell_bits(?x64.EXTENSIONS[0], x64.EXTENSION_COUNT, lv.members, ?tab_s[0], 512, 0);
            print.eprintlnf("levels: {} in manifest.md is {} but x64.LEVELS has {}", lv.name, (?doc_s[0])::str, (?tab_s[0])::str);
            ret 5;
        }
        below = lv.members;
        at    = row;
        i     = i + 1;
    }
    ret 0;
}

# the x86-64 vocabulary and its levels are well formed, each level strictly
# grows the one before, and closing a level over `implies` adds nothing: a level
# already names everything its members bring (#3741)
test x64_levels__closed_bundles_of_the_vocabulary {
    if (!extension.table_valid(?x64.EXTENSIONS[0], x64.EXTENSION_COUNT))                                   { ret 1; }
    if (!extension.levels_valid(?x64.LEVELS[0], x64.LEVEL_COUNT, ?x64.EXTENSIONS[0], x64.EXTENSION_COUNT)) { ret 2; }
    var i: u32 = 0;
    for (i < x64.LEVEL_COUNT) {
        val m: u64 = x64.LEVELS[i].members;
        if (extension.close(?x64.EXTENSIONS[0], x64.EXTENSION_COUNT, m) != m) { ret 3; }
        i = i + 1;
    }
    if (x64.LEVEL_V2 != (x64.EXT_SSSE3 | x64.EXT_SSE41 | x64.EXT_SSE42 | x64.EXT_POPCNT | x64.EXT_CX16)) { ret 4; }
    if ((x64.LEVEL_V3 & x64.EXT_AVX2) == 0 || (x64.LEVEL_V3 & x64.EXT_AVX512F) != 0)                     { ret 5; }
    if ((x64.LEVEL_V4 & x64.EXT_AVX512VL) == 0)                                                          { ret 6; }
    if (extension.level_of(?x64.LEVELS[0], x64.LEVEL_COUNT, "x86-64-v3", 9) != x64.LEVEL_V3)             { ret 7; }
    if (extension.level_of(?x64.LEVELS[0], x64.LEVEL_COUNT, "x86-64-v5", 9) != 0)                        { ret 8; }
    ret 0;
}

# the extent of the markdown table cell that starts at `at` (just past a `|`):
# its first non-blank offset and its length without trailing blanks. `at` is
# left just past the cell's closing `|`, or at n when the line has none
#[testing]
fun doc_cell(text: str, at: *usize, start: *usize, len: *usize) bool {
    val n: usize = str_len(text);
    var p: usize = @at;
    for (p < n && text[p] == ' ') { p = p + 1; }
    @start = p;
    for (p < n && text[p] != '|' && text[p] != '\n') { p = p + 1; }
    if (p >= n || text[p] != '|') { ret false; }
    var e: usize = p;
    for (e > @start && text[e - 1] == ' ') { e = e - 1; }
    @len = e - @start;
    @at  = p + 1;
    ret true;
}

# the widths a table cell spells (`8, 16, 32, 64`) as a mask of the catalog's
# width slots, none when a number is not a multiply width
#[testing]
fun doc_widths(text: str, start: usize, len: usize) opt[u64] {
    var mask: u64   = 0;
    var p:    usize = start;
    val end:  usize = start + len;
    for (p < end) {
        if (text[p] >= '0' && text[p] <= '9') {
            var v: u64 = 0;
            for (p < end && text[p] >= '0' && text[p] <= '9') {
                v = v * 10 + (text[p]::u64 - '0'::u64);
                p = p + 1;
            }
            if (v > 255 || !ct.mul_width_valid(v::u8)) { ret opt[u64].none{}; }
            mask = mask | (1::u64 << (v / 8));
        }
        or { p = p + 1; }
    }
    ret opt[u64].some{mask};
}

# the names between backticks in a table cell, each a row of the isa's
# extension vocabulary; none when a name is not one or the cell names nothing
#[testing]
fun doc_ext_bits(text: str, start: usize, len: usize, m: *isa.MachineModel) opt[u64] {
    var bits: u64   = 0;
    var seen: bool  = false;
    var p:    usize = start;
    val end:  usize = start + len;
    for (p < end) {
        if (text[p] == '`') {
            val ns: usize = p + 1;
            var e:  usize = ns;
            for (e < end && text[e] != '`') { e = e + 1; }
            if (e >= end) { ret opt[u64].none{}; }
            val bit: u64 = extension.bit_of(m.extension_table, m.extension_count, (?text[ns])::str, e - ns);
            if (bit == 0) { ret opt[u64].none{}; }
            bits = bits | bit;
            seen = true;
            p    = e + 1;
        }
        or { p = p + 1; }
    }
    if (!seen) { ret opt[u64].none{}; }
    ret opt[u64].some{bits};
}

# the row needle `| \`<isa>\` | <op> |` into `buf`, `op` spelled as given
#[testing]
fun doc_mul_needle(buf: *u8, arch: str, op: str) str {
    var o: usize = 0;
    buf[o] = '|'::u8;
    o      = o + 1;
    buf[o] = ' '::u8;
    o      = o + 1;
    buf[o] = '`'::u8;
    o      = o + 1;
    var k: usize = 0;
    for (k < str_len(arch)) {
        buf[o] = arch[k]::u8;
        o      = o + 1;
        k      = k + 1;
    }
    buf[o] = '`'::u8;
    o      = o + 1;
    buf[o] = ' '::u8;
    o      = o + 1;
    buf[o] = '|'::u8;
    o      = o + 1;
    buf[o] = ' '::u8;
    o      = o + 1;
    k      = 0;
    for (k < str_len(op)) {
        buf[o] = op[k]::u8;
        o      = o + 1;
        k      = k + 1;
    }
    buf[o] = ' '::u8;
    o      = o + 1;
    buf[o] = '|'::u8;
    o      = o + 1;
    buf[o] = 0;
    ret buf::str;
}

# one instruction set's lines of the secrecy.md multiply table against its
# registered rows: every multiply with declared scalar rows has one line
# spelling exactly those widths and their one condition, a multiply without
# rows has no line, and an isa without rows has the `none` line. `at` and
# `end` bound the table's text. 0 when they agree
#[testing]
fun doc_mul_isa(text: str, at: usize, end: usize, arch: str, m: *isa.MachineModel) i32 {
    var needle: [64]u8;
    if (m.ct_mul_form_len == 0) {
        val row: usize = doc_find(text, at, doc_mul_needle(?needle[0], arch, "none"));
        if (row >= end) {
            print.eprintlnf("ct_mul: secrecy.md has no `none` line for {}, which declares no rows", arch);
            ret 1;
        }
        ret 0;
    }
    var op: u32 = 1;
    for (op < ct.CT_MUL_OP_COUNT) {
        val name: opt[str] = ct.mul_op_name(op::ct.CtMulOp);
        if (sel name.none) { ret CENSUS_HARNESS; }
        var widths: u64          = 0;
        var cond:   ct.CtMulCond = ct.CT_MUL_ALWAYS;
        var ext:    u64          = 0;
        var first:  bool         = true;
        var i:      u32          = 0;
        for (i < m.ct_mul_form_len) {
            val row: *ct.CtMulForm = ?m.ct_mul_forms[i];
            if (row.op == op::ct.CtMulOp && row.lanes == 0) {
                if (!first && (row.cond != cond || row.ext != ext)) {
                    print.eprintlnf("ct_mul: {} declares `{}` under two conditions, which the table cannot spell", arch, name.some);
                    ret 2;
                }
                widths = widths | (1::u64 << (row.width::u64 / 8));
                cond   = row.cond;
                ext    = row.ext;
                first  = false;
            }
            i = i + 1;
        }
        var opq: [16]u8;
        var o:   usize = 0;
        opq[o] = '`'::u8;
        o      = o + 1;
        var k: usize = 0;
        for (k < str_len(name.some)) {
            opq[o] = name.some[k]::u8;
            o      = o + 1;
            k      = k + 1;
        }
        opq[o] = '`'::u8;
        o      = o + 1;
        opq[o] = 0;
        var row_at: usize = doc_find(text, at, doc_mul_needle(?needle[0], arch, (?opq[0])::str));
        if (widths == 0) {
            if (row_at < end) {
                print.eprintlnf("ct_mul: secrecy.md lists `{}` for {}, which declares no such row", name.some, arch);
                ret 3;
            }
            op = op + 1;
            cnt;
        }
        if (row_at >= end) {
            print.eprintlnf("ct_mul: secrecy.md has no `{}` line for {}", name.some, arch);
            ret 4;
        }
        var ws: usize = 0;
        var wl: usize = 0;
        var cs: usize = 0;
        var cl: usize = 0;
        if (!doc_cell(text, ?row_at, ?ws, ?wl) || !doc_cell(text, ?row_at, ?cs, ?cl)) {
            print.eprintlnf("ct_mul: the {} `{}` line has no widths and condition cells", arch, name.some);
            ret 5;
        }
        val doc_w:      opt[u64] = doc_widths(text, ws, wl);
        var doc_w_bits: u64      = 0;
        if (sel doc_w.some) { doc_w_bits = doc_w.some; }
        if (sel doc_w.none || doc_w_bits != widths) {
            print.eprintlnf("ct_mul: the {} `{}` line does not spell the registered widths", arch, name.some);
            ret 6;
        }
        var doc_cond: ct.CtMulCond = ct.CT_MUL_EXTENSION;
        var doc_ext:  u64          = 0;
        if (str_region_equals(text, cs, cl, "always"))        { doc_cond = ct.CT_MUL_ALWAYS; }
        or (str_region_equals(text, cs, cl, "PSTATE.DIT on")) { doc_cond = ct.CT_MUL_DIT_MODE; }
        or {
            val bits: opt[u64] = doc_ext_bits(text, cs, cl, m);
            if (sel bits.none) {
                print.eprintlnf("ct_mul: the {} `{}` condition names something outside `always`, `PSTATE.DIT on` and the isa's extensions", arch, name.some);
                ret 7;
            }
            doc_ext = bits.some;
        }
        if (doc_cond != cond || doc_ext != ext) {
            print.eprintlnf("ct_mul: the {} `{}` line does not spell the registered condition", arch, name.some);
            ret 8;
        }
        op = op + 1;
    }
    ret 0;
}

# doc/language/secrecy.md carries the constant-time multiply table: one line
# per instruction set and multiply naming the declared widths and the
# condition they hold under. It is the registered catalog spelled through the
# names, and drift between them fails here (#3510)
test secrecy_doc__multiply_table_matches_the_registered_rows {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rr: opt[str] = find_root(?alloc);
    if (!sel rr.some) {
        print.eprintln("ct_mul: cannot locate the source root from the working directory");
        ret CENSUS_HARNESS;
    }
    val rj: res[str, fail.Fail] = join_path(?alloc, rr.some, "doc/language/secrecy.md");
    if (sel rj.err) { ret CENSUS_HARNESS; }
    val rt: res[str, fs.FsError] = fs.read_string(?alloc, rj.ok);
    if (sel rt.err) {
        print.eprintln("ct_mul: cannot read doc/language/secrecy.md");
        ret CENSUS_HARNESS;
    }
    val text: str   = rt.ok;
    val n:    usize = str_len(text);
    val at:   usize = doc_find(text, 0, "| Instruction set | Multiply | Widths | Condition |");
    if (at >= n) {
        print.eprintln("ct_mul: secrecy.md has no constant-time multiply table");
        ret 1;
    }
    val end: usize = doc_find(text, at, "\n\n");

    var reg: isa.IsaRegistry = isa.registry_init();
    fin { isa.registry_dnit(?reg); }
    val r_x64:   err[fail.Fail] = x64_register.register_x64(?reg);
    val r_arm64: err[fail.Fail] = arm64_register.register_arm64(?reg);
    val r_rv64:  err[fail.Fail] = riscv_register.register_riscv64(?reg);
    val r_rv32:  err[fail.Fail] = riscv_register.register_riscv32(?reg);
    val r_spirv: err[fail.Fail] = spirv_register.register_spirv(?reg);
    if (sel r_x64.err || sel r_arm64.err || sel r_rv64.err || sel r_rv32.err || sel r_spirv.err) { ret CENSUS_HARNESS; }

    val archs: [5]u32 = [5]u32{isa.ARCH_X86_64, isa.ARCH_AARCH64, isa.ARCH_RISCV64, isa.ARCH_RISCV32, isa.ARCH_SPIRV};
    var ai:    usize  = 0;
    for (ai < 5) {
        val name: str                 = isa.arch_name_for(archs[ai]);
        val v:    opt[*isa.IsaVTable] = isa.lookup(?reg, name);
        if (sel v.none) { ret CENSUS_HARNESS; }
        val bad: i32 = doc_mul_isa(text, at, end, name, v.some.model);
        if (bad != 0) { ret 10 + bad; }
        ai = ai + 1;
    }
    ret 0;
}

# each registered isa folds a symbol offset only within its +-16 MB window and a
# base-register displacement only where its encoding holds one: x86-64 alone
# bounds the displacement, at disp32, and spir-v, with no pc-relative symbol
# reference, bounds neither (#3907)
test offset_folds__only_within_each_reach {
    var reg: isa.IsaRegistry = isa.registry_init();
    fin { isa.registry_dnit(?reg); }
    val r_x64:   err[fail.Fail] = x64_register.register_x64(?reg);
    val r_arm64: err[fail.Fail] = arm64_register.register_arm64(?reg);
    val r_rv64:  err[fail.Fail] = riscv_register.register_riscv64(?reg);
    val r_rv32:  err[fail.Fail] = riscv_register.register_riscv32(?reg);
    val r_spirv: err[fail.Fail] = spirv_register.register_spirv(?reg);
    if (sel r_x64.err || sel r_arm64.err || sel r_rv64.err || sel r_rv32.err || sel r_spirv.err) { ret CENSUS_HARNESS; }

    val window: i64    = 16777216;
    val archs:  [5]u32 = [5]u32{isa.ARCH_X86_64, isa.ARCH_AARCH64, isa.ARCH_RISCV64, isa.ARCH_RISCV32, isa.ARCH_SPIRV};
    var ai:     usize  = 0;
    for (ai < 5) {
        val v: opt[*isa.IsaVTable] = isa.lookup(?reg, isa.arch_name_for(archs[ai]));
        if (sel v.none) { ret CENSUS_HARNESS; }
        val m:       *isa.MachineModel = v.some.model;
        val bounded: bool              = archs[ai] != isa.ARCH_SPIRV;
        val disp32:  bool              = archs[ai] == isa.ARCH_X86_64;
        val code:    i32               = 10 * (ai::i32 + 1);
        if (!isa.sym_offset_folds(m, window - 1) || !isa.sym_offset_folds(m, 0 - window)) { ret code + 1; }
        if (isa.sym_offset_folds(m, window) != !bounded)                                  { ret code + 2; }
        if (isa.sym_offset_folds(m, 0 - window - 1) != !bounded)                          { ret code + 3; }
        if (isa.sym_offset_folds(m, 2199999999) != !bounded)                              { ret code + 4; }
        if (!isa.mem_disp_folds(m, 2147483647) || !isa.mem_disp_folds(m, 0 - 2147483648)) { ret code + 5; }
        if (isa.mem_disp_folds(m, 2147483648) != !disp32)                                 { ret code + 6; }
        if (isa.mem_disp_folds(m, 0 - 2147483649) != !disp32)                             { ret code + 7; }
        ai = ai + 1;
    }
    if (!isa.offset_fits(0, 0x7FFFFFFFFFFFFFFF) || !isa.offset_fits(64, 0 - 0x7FFFFFFFFFFFFFFF)) { ret 60; }
    ret 0;
}
