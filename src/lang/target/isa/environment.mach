# the execution environments an instruction set defines and the profile and
# extensions each one grants a target that names it
use mach.lang.fail;
use std.types.error.err;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

# an execution environment an isa defines: its name, its profile, and the
# extensions of the isa's vocabulary it guarantees (spirv's `zero_init_workgroup`
# from vulkan1.3)
pub rec Environment {
    name:       str;
    profile:    u32;
    extensions: u64;
}

# the environments an isa defines, and what a target naming none of them is
# granted of the vocabulary
pub rec Set {
    rows:  *Environment;
    count: u32;
    open:  u64;
}

pub val NONE: u32 = 0xFFFFFFFF;

pub fun lookup(set: *Set, name: str) u32 {
    var i: u32 = 0;
    for (i < set.count) {
        if (str_equals(set.rows[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret NONE;
}

pub fun profile(set: *Set, env_id: u32) u32 {
    if (env_id == NONE || env_id >= set.count) { ret NONE; }
    ret set.rows[env_id].profile;
}

# the extensions the target's environment guarantees, which its selection holds
# beside the ones it names
pub fun extensions(set: *Set, env_id: u32) u64 {
    if (env_id == NONE)      { ret set.open; }
    if (env_id >= set.count) { ret 0; }
    ret set.rows[env_id].extensions;
}

# the set `isa_name` declares, refused when it is malformed
pub fun validate(a: *A.Allocator, set: *Set, isa_name: str) err[fail.Fail] {
    if (set.count > 0 && set.rows == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares environments without storage", isa_name)};
    }
    var ei: u32 = 0;
    for (ei < set.count) {
        if (str_len(set.rows[ei].name) == 0) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares an environment with an empty name", isa_name)};
        }
        var ej: u32 = 0;
        for (ej < ei) {
            if (str_equals(set.rows[ej].name, set.rows[ei].name)) {
                ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares one environment twice", isa_name)};
            }
            ej = ej + 1;
        }
        ei = ei + 1;
    }
    ret err[fail.Fail].ok{};
}
