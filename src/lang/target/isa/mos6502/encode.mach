use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.page;

use A: std.allocator;
use R: std.types.result;

use enc: mach.lang.be.codegen.encode;
use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.isa.mos6502;
use mach.lang.target.of;

val OP_LDA_IMM: u8 = 0xA9;  val OP_LDA_ZP: u8 = 0xA5;  val OP_LDA_ABS: u8 = 0xAD;
val OP_STA_ZP:  u8 = 0x85;  val OP_STA_ABS: u8 = 0x8D;
val OP_ADC_IMM: u8 = 0x69;  val OP_ADC_ZP: u8 = 0x65;
val OP_SBC_IMM: u8 = 0xE9;  val OP_SBC_ZP: u8 = 0xE5;
val OP_AND_IMM: u8 = 0x29;  val OP_AND_ZP: u8 = 0x25;
val OP_ORA_IMM: u8 = 0x09;  val OP_ORA_ZP: u8 = 0x05;
val OP_EOR_IMM: u8 = 0x49;  val OP_EOR_ZP: u8 = 0x45;
val OP_CMP_IMM: u8 = 0xC9;  val OP_CMP_ZP: u8 = 0xC5;
val OP_CLC:     u8 = 0x18;  val OP_SEC:    u8 = 0x38;
val OP_JMP_ABS: u8 = 0x4C;  val OP_JSR_ABS: u8 = 0x20;
val OP_RTS:     u8 = 0x60;  val OP_BRK:     u8 = 0x00;  val OP_NOP: u8 = 0xEA;
val OP_LDY_IMM: u8 = 0xA0;  val OP_LDA_IND_Y: u8 = 0xB1;  val OP_STA_IND_Y: u8 = 0x91;
val OP_BEQ: u8 = 0xF0;  val OP_BNE: u8 = 0xD0;  val OP_BCC: u8 = 0x90;  val OP_BCS: u8 = 0xB0;
val OP_ASL_A: u8 = 0x0A;  val OP_LSR_A: u8 = 0x4A;
val OP_ROL_A: u8 = 0x2A;  val OP_ROR_A: u8 = 0x6A;

pub fun encode_mos6502(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule) R.Result[enc.EncoderOutput, str] {
    var hooks: enc.EncodeHooks;
    hooks.encode_function = encode_function;
    hooks.patch_branch    = patch_branch;
    ret enc.encode_driver(alloc, tgt, m, ?hooks);
}

fun encode_function(st: *enc.EncodeState, f: *mir.MirFunction) R.Result[R.Void, str] {
    val fn_base: u32 = st.buf.len::u32;

    val res_sym: R.Result[R.Void, str] = enc.push_symbol(st, f.name, fn_base, of.SYM_OBJ_FLAG_FUNCTION);
    if (R.is_err[R.Void, str](res_sym)) { ret res_sym; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *mir.MirBlock = ?f.blocks[bi];
        val res_blk: R.Result[R.Void, str] = enc.push_block(st, fn_base, b.id, st.buf.len::u32);
        if (R.is_err[R.Void, str](res_blk)) { ret res_blk; }

        var ii: u32 = 0;
        for (ii < b.instr_count) {
            val res_i: R.Result[R.Void, str] = encode_instr(st, f, ?b.instrs[ii], fn_base);
            if (R.is_err[R.Void, str](res_i)) { ret res_i; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun encode_instr(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr, fn_base: u32) R.Result[R.Void, str] {
    val op: mir.MirOpcode = mi.opcode;

    if (op == mos6502.MOV::u32) { ret encode_mov(st, mi); }
    if (op == mos6502.RTS::u32) { enc.emit_byte(?st.buf, OP_RTS); ret R.ok_void[str](); }
    if (op == mos6502.BRK::u32) { enc.emit_byte(?st.buf, OP_BRK); ret R.ok_void[str](); }
    if (op == mos6502.NOP::u32) { enc.emit_byte(?st.buf, OP_NOP); ret R.ok_void[str](); }
    if (op == mos6502.JMP::u32) { ret encode_br(st, mi, fn_base); }

    if (op == mir.MIR_ADD || op == mir.MIR_SUB ||
        op == mir.MIR_AND || op == mir.MIR_OR || op == mir.MIR_XOR) {
        ret encode_alu(st, mi, op);
    }
    if (op == mir.MIR_LOAD)  { ret encode_load(st, mi); }
    if (op == mir.MIR_STORE) { ret encode_store(st, mi); }
    if (op == mir.MIR_NOT) { ret encode_not(st, mi); }
    if (op == mir.MIR_SHL || op == mir.MIR_SHR_U || op == mir.MIR_SHR_S) {
        ret encode_shift(st, mi, op);
    }
    if (op == mir.MIR_CMP_EQ || op == mir.MIR_CMP_NE || op == mir.MIR_CMP_LT_U) {
        ret encode_cmp(st, mi, op);
    }
    if (mir.is_fused_cbr(op)) { ret encode_sel_cbr(st, mi, fn_base); }
    if (op == mir.MIR_CALL) { ret encode_call(st, mi); }

    if (op == mir.MIR_CALL_RES || op == mir.MIR_ARG) { ret R.ok_void[str](); }

    ret R.err[R.Void, str](unencodable_message(op));
}

fun encode_mov(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2) { ret R.err[R.Void, str]("mos6502: malformed move"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[R.Void, str](unencodable_message(mos6502.MOV::u32)); }

    val res_ld: R.Result[R.Void, str] = emit_load_a(st, src);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok_void[str]();
}

fun encode_alu(st: *enc.EncodeState, mi: *mir.MirInstr, op: mir.MirOpcode) R.Result[R.Void, str] {
    if (mi.operand_count != 3) { ret R.err[R.Void, str]("mos6502: malformed binary op"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val a:   *mir.MirOperand = ?mi.operands[1];
    val b:   *mir.MirOperand = ?mi.operands[2];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[R.Void, str](unencodable_message(op)); }

    var imm_op: u8 = 0;
    var zp_op:  u8 = 0;
    if (op == mir.MIR_ADD) { imm_op = OP_ADC_IMM; zp_op = OP_ADC_ZP; }
    or (op == mir.MIR_SUB) { imm_op = OP_SBC_IMM; zp_op = OP_SBC_ZP; }
    or (op == mir.MIR_AND) { imm_op = OP_AND_IMM; zp_op = OP_AND_ZP; }
    or (op == mir.MIR_OR)  { imm_op = OP_ORA_IMM; zp_op = OP_ORA_ZP; }
    or (op == mir.MIR_XOR) { imm_op = OP_EOR_IMM; zp_op = OP_EOR_ZP; }
    or                     { ret R.err[R.Void, str](unencodable_message(op)); }

    val res_ld: R.Result[R.Void, str] = emit_load_a(st, a);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }

    if (op == mir.MIR_ADD) { enc.emit_byte(?st.buf, OP_CLC); }
    if (op == mir.MIR_SUB) { enc.emit_byte(?st.buf, OP_SEC); }

    val res_op: R.Result[R.Void, str] = emit_operand(st, b, imm_op, zp_op, op);
    if (R.is_err[R.Void, str](res_op)) { ret res_op; }
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok_void[str]();
}

fun encode_load(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2) { ret R.err[R.Void, str]("mos6502: malformed load"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[R.Void, str](unencodable_message(mir.MIR_LOAD)); }

    var base: i32 = 0;
    var disp: u8  = 0;
    val ra: R.Result[R.Void, str] = mem_base_disp(mi, ?mi.operands[1], ?base, ?disp);
    if (R.is_err[R.Void, str](ra)) { ret ra; }

    emit_imm1(st, OP_LDY_IMM, disp);
    emit_zp1(st, OP_LDA_IND_Y, mos6502.zp_addr(base));
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok_void[str]();
}

fun encode_store(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2) { ret R.err[R.Void, str]("mos6502: malformed store"); }

    var base: i32 = 0;
    var disp: u8  = 0;
    val ra: R.Result[R.Void, str] = mem_base_disp(mi, ?mi.operands[0], ?base, ?disp);
    if (R.is_err[R.Void, str](ra)) { ret ra; }

    val res_ld: R.Result[R.Void, str] = emit_load_a(st, ?mi.operands[1]);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }
    emit_imm1(st, OP_LDY_IMM, disp);
    emit_zp1(st, OP_STA_IND_Y, mos6502.zp_addr(base));
    ret R.ok_void[str]();
}

fun mem_base_disp(mi: *mir.MirInstr, mem: *mir.MirOperand, out_base: *i32, out_disp: *u8) R.Result[R.Void, str] {
    if (mem.kind != mir.MIR_OP_MEM) { ret R.err[R.Void, str](unencodable_message(mi.opcode)); }
    if (mi.width > 1) {
        ret R.err[R.Void, str]("mos6502: a memory access wider than one byte must be split by width legalization before encoding");
    }
    if (mem.index != mir.MIR_VREG_NIL) {
        ret R.err[R.Void, str]("mos6502: the 6502 has no scaled-index addressing");
    }
    if (mem.vreg != mir.MIR_VREG_NIL) {
        ret R.err[R.Void, str]("mos6502: frame-slot addressing is not yet implemented on this target");
    }
    val base: i32 = mem.preg::i32;
    if (!mos6502.is_ptr_pair(base)) {
        ret R.err[R.Void, str]("mos6502: a memory base must be a reserved zero-page pointer pair on this target");
    }
    if (mem.imm < 0 || mem.imm > 255) {
        ret R.err[R.Void, str]("mos6502: a memory displacement must fit the 8-bit Y index on this target");
    }
    @out_base = base;
    @out_disp = (mem.imm & 0xFF)::u8;
    ret R.ok_void[str]();
}

fun encode_not(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count != 2) { ret R.err[R.Void, str]("mos6502: malformed not"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[R.Void, str](unencodable_message(mir.MIR_NOT)); }
    val res_ld: R.Result[R.Void, str] = emit_load_a(st, ?mi.operands[1]);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }
    emit_imm1(st, OP_EOR_IMM, 0xFF);
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok_void[str]();
}

fun encode_shift(st: *enc.EncodeState, mi: *mir.MirInstr, op: mir.MirOpcode) R.Result[R.Void, str] {
    if (mi.operand_count != 3) { ret R.err[R.Void, str]("mos6502: malformed shift"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val cnt: *mir.MirOperand = ?mi.operands[2];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[R.Void, str](unencodable_message(op)); }
    if (mi.width > 1) {
        ret R.err[R.Void, str]("mos6502: a shift wider than one byte must be split by width legalization before encoding");
    }
    if (cnt.kind != mir.MIR_OP_IMM) {
        ret R.err[R.Void, str]("mos6502: the 6502 has no variable-count shift; a runtime count must be expanded by width legalization before encoding");
    }
    if (cnt.imm < 0 || cnt.imm > 7) {
        ret R.err[R.Void, str]("mos6502: a byte shift count must be normalized to the 8-bit operation width by width legalization before encoding");
    }
    if (op != mir.MIR_SHL && op != mir.MIR_SHR_U && op != mir.MIR_SHR_S) {
        ret R.err[R.Void, str](unencodable_message(op));
    }

    val res_ld: R.Result[R.Void, str] = emit_load_a(st, ?mi.operands[1]);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }

    var i: i64 = 0;
    for (i < cnt.imm) {
        if (op == mir.MIR_SHL)        { enc.emit_byte(?st.buf, OP_ASL_A); }
        or (op == mir.MIR_SHR_U)      { enc.emit_byte(?st.buf, OP_LSR_A); }
        or {
            emit_imm1(st, OP_CMP_IMM, 0x80);
            enc.emit_byte(?st.buf, OP_ROR_A);
        }
        i = i + 1;
    }

    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok_void[str]();
}

fun encode_cmp(st: *enc.EncodeState, mi: *mir.MirInstr, op: mir.MirOpcode) R.Result[R.Void, str] {
    if (mi.operand_count != 3) { ret R.err[R.Void, str]("mos6502: malformed compare"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[R.Void, str](unencodable_message(op)); }
    if (op != mir.MIR_CMP_EQ && op != mir.MIR_CMP_NE && op != mir.MIR_CMP_LT_U) {
        ret R.err[R.Void, str](unencodable_message(op));
    }

    val res_ld: R.Result[R.Void, str] = emit_load_a(st, ?mi.operands[1]);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }
    val b: *mir.MirOperand = ?mi.operands[2];

    if (op == mir.MIR_CMP_LT_U) {
        val res_c: R.Result[R.Void, str] = emit_cmp_operand(st, b, OP_CMP_IMM, OP_CMP_ZP);
        if (R.is_err[R.Void, str](res_c)) { ret res_c; }
    }
    or {
        val res_x: R.Result[R.Void, str] = emit_cmp_operand(st, b, OP_EOR_IMM, OP_EOR_ZP);
        if (R.is_err[R.Void, str](res_x)) { ret res_x; }
        emit_imm1(st, OP_CMP_IMM, 0x01);
    }

    emit_imm1(st, OP_LDA_IMM, 0x00);
    enc.emit_byte(?st.buf, OP_ROL_A);
    if (op != mir.MIR_CMP_NE) { emit_imm1(st, OP_EOR_IMM, 0x01); }

    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok_void[str]();
}

fun emit_cmp_operand(st: *enc.EncodeState, b: *mir.MirOperand, imm_op: u8, zp_op: u8) R.Result[R.Void, str] {
    if (b.kind == mir.MIR_OP_IMM)  { emit_imm1(st, imm_op, (b.imm & 0xFF)::u8); ret R.ok_void[str](); }
    if (b.kind == mir.MIR_OP_PREG) { emit_zp1(st, zp_op, mos6502.zp_addr(b.preg::i32)); ret R.ok_void[str](); }
    ret R.err[R.Void, str]("mos6502: unsupported compare operand");
}

fun encode_br(st: *enc.EncodeState, mi: *mir.MirInstr, fn_base: u32) R.Result[R.Void, str] {
    if (mi.operand_count == 0 || mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("mos6502: malformed unconditional branch");
    }
    ret emit_jmp(st, mi.operands[0].imm::u32, fn_base);
}

fun encode_sel_cbr(st: *enc.EncodeState, mi: *mir.MirInstr, fn_base: u32) R.Result[R.Void, str] {
    if (mi.operand_count != 4 ||
        mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("mos6502: malformed fused compare-and-branch");
    }
    val op:  mir.MirOpcode = mi.opcode;
    val lhs: *mir.MirOperand = ?mi.operands[0];
    val rhs: *mir.MirOperand = ?mi.operands[1];
    val then_block: u32 = mi.operands[2].imm::u32;
    val else_block: u32 = mi.operands[3].imm::u32;

    var load_op: *mir.MirOperand = lhs;
    var cmp_op:  *mir.MirOperand = rhs;
    var inv_branch: u8 = 0;
    if (op == mir.MIR_SEL_CBR_EQ)        { inv_branch = OP_BNE; }
    or (op == mir.MIR_SEL_CBR_NE)        { inv_branch = OP_BEQ; }
    or (op == mir.MIR_SEL_CBR_LT_U)      { inv_branch = OP_BCS; }
    or (op == mir.MIR_SEL_CBR_LE_U)      { load_op = rhs; cmp_op = lhs; inv_branch = OP_BCC; }
    or {
        ret R.err[R.Void, str]("mos6502: signed fused compare-and-branch is not yet encoded on this target");
    }

    val res_ld: R.Result[R.Void, str] = emit_load_a(st, load_op);
    if (R.is_err[R.Void, str](res_ld)) { ret res_ld; }
    val res_c: R.Result[R.Void, str] = emit_cmp_operand(st, cmp_op, OP_CMP_IMM, OP_CMP_ZP);
    if (R.is_err[R.Void, str](res_c)) { ret res_c; }

    enc.emit_byte(?st.buf, inv_branch);
    enc.emit_byte(?st.buf, 0x03);

    val res_then: R.Result[R.Void, str] = emit_jmp(st, then_block, fn_base);
    if (R.is_err[R.Void, str](res_then)) { ret res_then; }
    ret emit_jmp(st, else_block, fn_base);
}

fun emit_jmp(st: *enc.EncodeState, target_block: u32, fn_base: u32) R.Result[R.Void, str] {
    enc.emit_byte(?st.buf, OP_JMP_ABS);
    val patch_pos: u32 = st.buf.len::u32;
    enc.emit_byte(?st.buf, 0);
    enc.emit_byte(?st.buf, 0);
    val next_ip: u32 = st.buf.len::u32;
    ret enc.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
}

fun encode_call(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count == 0) { ret R.err[R.Void, str]("mos6502: malformed call"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret R.err[R.Void, str]("mos6502: indirect call is not yet encoded on this target");
    }
    enc.emit_byte(?st.buf, OP_JSR_ABS);
    val site: u32 = st.buf.len::u32;
    val res_rel: R.Result[R.Void, str] = enc.push_reloc(st, site, of.RK_ABS16, callee.sym, callee.sym_off);
    if (R.is_err[R.Void, str](res_rel)) { ret res_rel; }
    enc.emit_byte(?st.buf, 0);
    enc.emit_byte(?st.buf, 0);
    ret R.ok_void[str]();
}

fun emit_load_a(st: *enc.EncodeState, src: *mir.MirOperand) R.Result[R.Void, str] {
    if (src.kind == mir.MIR_OP_IMM)  { emit_imm1(st, OP_LDA_IMM, (src.imm & 0xFF)::u8); ret R.ok_void[str](); }
    if (src.kind == mir.MIR_OP_PREG) { emit_zp1(st, OP_LDA_ZP, mos6502.zp_addr(src.preg::i32)); ret R.ok_void[str](); }
    ret R.err[R.Void, str]("mos6502: unsupported source operand for accumulator load");
}

fun emit_operand(st: *enc.EncodeState, b: *mir.MirOperand, imm_op: u8, zp_op: u8, op: mir.MirOpcode) R.Result[R.Void, str] {
    if (b.kind == mir.MIR_OP_IMM)  { emit_imm1(st, imm_op, (b.imm & 0xFF)::u8); ret R.ok_void[str](); }
    if (b.kind == mir.MIR_OP_PREG) { emit_zp1(st, zp_op, mos6502.zp_addr(b.preg::i32)); ret R.ok_void[str](); }
    ret R.err[R.Void, str](unencodable_message(op));
}

fun emit_imm1(st: *enc.EncodeState, opcode: u8, value: u8) {
    enc.emit_byte(?st.buf, opcode);
    enc.emit_byte(?st.buf, value);
}

fun emit_zp1(st: *enc.EncodeState, opcode: u8, addr: i32) {
    enc.emit_byte(?st.buf, opcode);
    enc.emit_byte(?st.buf, (addr & 0xFF)::u8);
}

fun patch_branch(st: *enc.EncodeState, fx: *enc.BranchFixup, target_off: u32) R.Result[R.Void, str] {
    val abs: u32 = st.base_addr::u32 + target_off;
    st.buf.data[fx.patch_pos]     = (abs & 0xFF)::u8;
    st.buf.data[fx.patch_pos + 1] = ((abs >> 8) & 0xFF)::u8;
    ret R.ok_void[str]();
}

fun unencodable_message(op: mir.MirOpcode) str {
    if (op == mir.MIR_MUL)   { ret "mos6502: the 6502 has no hardware multiply; use a constant-multiplier strength reduction or a runtime routine"; }
    if (op == mir.MIR_DIV_S || op == mir.MIR_DIV_U ||
        op == mir.MIR_REM_S || op == mir.MIR_REM_U) {
        ret "mos6502: the 6502 has no hardware divide / remainder";
    }
    if (op == mir.MIR_GEP || op == mir.MIR_ALLOCA) {
        ret "mos6502: address arithmetic is not yet implemented on this target";
    }
    if (op == mir.MIR_LOAD || op == mir.MIR_STORE) {
        ret "mos6502: unsupported memory operand shape on this target";
    }
    if (op == mir.MIR_CBR || op == mir.MIR_BR ||
        op == mir.MIR_CMP_EQ || op == mir.MIR_CMP_NE ||
        op == mir.MIR_CMP_LT_S || op == mir.MIR_CMP_LT_U ||
        op == mir.MIR_CMP_LE_S || op == mir.MIR_CMP_LE_U) {
        ret "mos6502: compare / branch encoding is not yet implemented on this target";
    }
    ret "mos6502: instruction encoding is not yet implemented on this target";
}

test "mach.lang.target.isa.mos6502.encode:byte_pins" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    emit_imm1(?st, OP_LDA_IMM, 0x2A);
    if (st.buf.data[0] != 0xA9 || st.buf.data[1] != 0x2A) { ret 1; }

    emit_zp1(?st, OP_STA_ZP, mos6502.zp_addr(8));
    if (st.buf.data[2] != 0x85 || st.buf.data[3] != 0x18) { ret 1; }

    enc.emit_byte(?st.buf, OP_CLC);
    emit_zp1(?st, OP_ADC_ZP, mos6502.zp_addr(9));
    if (st.buf.data[4] != 0x18 || st.buf.data[5] != 0x65 || st.buf.data[6] != 0x19) { ret 1; }

    enc.emit_byte(?st.buf, OP_SEC);
    emit_imm1(?st, OP_SBC_IMM, 0x01);
    if (st.buf.data[7] != 0x38 || st.buf.data[8] != 0xE9 || st.buf.data[9] != 0x01) { ret 1; }

    emit_imm1(?st, OP_EOR_IMM, 0xFF);
    if (st.buf.data[10] != 0x49 || st.buf.data[11] != 0xFF) { ret 1; }

    enc.emit_byte(?st.buf, OP_RTS);
    if (st.buf.data[12] != 0x60) { ret 1; }

    emit_imm1(?st, OP_CMP_IMM, 0x0A);
    emit_zp1(?st, OP_CMP_ZP, mos6502.zp_addr(13));
    if (st.buf.data[13] != 0xC9 || st.buf.data[14] != 0x0A) { ret 1; }
    if (st.buf.data[15] != 0xC5 || st.buf.data[16] != 0x1D) { ret 1; }

    if (OP_BEQ != 0xF0 || OP_BNE != 0xD0 || OP_BCC != 0x90 || OP_BCS != 0xB0) { ret 1; }
    if (OP_JMP_ABS != 0x4C) { ret 1; }
    if (OP_ASL_A != 0x0A || OP_LSR_A != 0x4A) { ret 1; }
    if (OP_ROL_A != 0x2A || OP_ROR_A != 0x6A) { ret 1; }

    enc.buf_dnit(?st.buf);
    ret 0;
}

fun t_encode_cmp(st: *enc.EncodeState, op: mir.MirOpcode) R.Result[R.Void, str] {
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(8);
    ops[2] = mir.op_preg(9);
    var mi: mir.MirInstr = mir.instr(op, ?ops[0], 3, 1, 1);
    ret encode_cmp(st, ?mi, op);
}

fun t_has_branch(st: *enc.EncodeState) bool {
    var i: usize = 0;
    for (i < st.buf.len) {
        val b: u8 = st.buf.data[i];
        if (b == OP_BEQ || b == OP_BNE || b == OP_BCC || b == OP_BCS) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.target.isa.mos6502.encode:compare_is_branchless" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var eq: enc.EncodeState;
    eq.buf = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_cmp(?eq, mir.MIR_CMP_EQ))) { ret 1; }
    if (eq.buf.len != 13)                                            { ret 1; }
    if (eq.buf.data[0]  != 0xA5 || eq.buf.data[1]  != 0x18)          { ret 1; }
    if (eq.buf.data[2]  != 0x45 || eq.buf.data[3]  != 0x19)          { ret 1; }
    if (eq.buf.data[4]  != 0xC9 || eq.buf.data[5]  != 0x01)          { ret 1; }
    if (eq.buf.data[6]  != 0xA9 || eq.buf.data[7]  != 0x00)          { ret 1; }
    if (eq.buf.data[8]  != 0x2A)                                     { ret 1; }
    if (eq.buf.data[9]  != 0x49 || eq.buf.data[10] != 0x01)          { ret 1; }
    if (eq.buf.data[11] != 0x85 || eq.buf.data[12] != 0x1A)          { ret 1; }
    if (t_has_branch(?eq)) { ret 1; }
    enc.buf_dnit(?eq.buf);

    var ne: enc.EncodeState;
    ne.buf = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_cmp(?ne, mir.MIR_CMP_NE))) { ret 1; }
    if (ne.buf.len != 11)                                            { ret 1; }
    if (ne.buf.data[0] != 0xA5 || ne.buf.data[1] != 0x18)            { ret 1; }
    if (ne.buf.data[2] != 0x45 || ne.buf.data[3] != 0x19)            { ret 1; }
    if (ne.buf.data[4] != 0xC9 || ne.buf.data[5] != 0x01)            { ret 1; }
    if (ne.buf.data[6] != 0xA9 || ne.buf.data[7] != 0x00)            { ret 1; }
    if (ne.buf.data[8] != 0x2A)                                      { ret 1; }
    if (ne.buf.data[9] != 0x85 || ne.buf.data[10] != 0x1A)           { ret 1; }
    if (t_has_branch(?ne)) { ret 1; }
    enc.buf_dnit(?ne.buf);

    var lt: enc.EncodeState;
    lt.buf = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_cmp(?lt, mir.MIR_CMP_LT_U))) { ret 1; }
    if (lt.buf.len != 11)                                            { ret 1; }
    if (lt.buf.data[0] != 0xA5 || lt.buf.data[1] != 0x18)            { ret 1; }
    if (lt.buf.data[2] != 0xC5 || lt.buf.data[3] != 0x19)            { ret 1; }
    if (lt.buf.data[4] != 0xA9 || lt.buf.data[5] != 0x00)            { ret 1; }
    if (lt.buf.data[6] != 0x2A)                                      { ret 1; }
    if (lt.buf.data[7] != 0x49 || lt.buf.data[8] != 0x01)            { ret 1; }
    if (lt.buf.data[9] != 0x85 || lt.buf.data[10] != 0x1A)           { ret 1; }
    if (t_has_branch(?lt)) { ret 1; }
    enc.buf_dnit(?lt.buf);
    ret 0;
}

pub rec Core {
    a:      u32;
    y:      u32;
    c:      u32;
    pc:     u32;
    cycles: u32;
}

pub fun exec_reference(mem: *u8, size: usize, core: *Core) bool {
    var steps: u32 = 0;
    for (steps < 65536) {
        steps = steps + 1;
        if (core.pc::usize >= size) { ret false; }
        val op:  u8    = mem[core.pc::usize];
        val arg: usize = (core.pc + 1)::usize;
        if (op == 0x60) { core.cycles = core.cycles + 6; ret true; }
        if (arg >= size) { ret false; }
        val imm: u32   = mem[arg]::u32;
        val zpa: usize = mem[arg]::usize;

        if (op == 0xA9)      { core.a = imm;                       core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0xA5)      { core.a = mem[zpa]::u32;             core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0x85)      { mem[zpa] = (core.a & 0xFF)::u8;     core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0xA0)      { core.y = imm;                       core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0x49)      { core.a = core.a ^ imm;              core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0x45)      { core.a = core.a ^ mem[zpa]::u32;    core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0x29)      { core.a = core.a & imm;              core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0x25)      { core.a = core.a & mem[zpa]::u32;    core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0x09)      { core.a = core.a | imm;              core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0x05)      { core.a = core.a | mem[zpa]::u32;    core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0xC9)      { core.c = 0; if (core.a >= imm) { core.c = 1; }                    core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0xC5)      { core.c = 0; if (core.a >= mem[zpa]::u32) { core.c = 1; }          core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0x2A)      { val nc: u32 = (core.a >> 7) & 1; core.a = ((core.a << 1) | core.c) & 0xFF; core.c = nc; core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0x6A)      { val nc: u32 = core.a & 1; core.a = ((core.a >> 1) | (core.c << 7)) & 0xFF; core.c = nc; core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0x0A)      { core.c = (core.a >> 7) & 1; core.a = (core.a << 1) & 0xFF;                 core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0x4A)      { core.c = core.a & 1;        core.a = (core.a >> 1) & 0xFF;                 core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0x18)      { core.c = 0;                         core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0x38)      { core.c = 1;                         core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0xEA)      {                                     core.cycles = core.cycles + 2; core.pc = core.pc + 1; }
        or (op == 0x69)      { val t: u32 = core.a + imm + core.c;                     core.c = (t >> 8) & 1; core.a = t & 0xFF; core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0x65)      { val t: u32 = core.a + mem[zpa]::u32 + core.c;           core.c = (t >> 8) & 1; core.a = t & 0xFF; core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0xE9)      { val t: u32 = (core.a + (imm ^ 0xFF) + core.c);          core.c = (t >> 8) & 1; core.a = t & 0xFF; core.cycles = core.cycles + 2; core.pc = core.pc + 2; }
        or (op == 0xE5)      { val t: u32 = (core.a + (mem[zpa]::u32 ^ 0xFF) + core.c); core.c = (t >> 8) & 1; core.a = t & 0xFF; core.cycles = core.cycles + 3; core.pc = core.pc + 2; }
        or (op == 0xB1 || op == 0x91) {
            if (zpa + 1 >= size) { ret false; }
            val ptr:  u32   = mem[zpa]::u32 | (mem[zpa + 1]::u32 << 8);
            val addr: u32   = ptr + core.y;
            if (addr::usize >= size) { ret false; }
            if (op == 0xB1) {
                core.a = mem[addr::usize]::u32;
                core.cycles = core.cycles + 5;
                if ((addr & 0xFF00) != (ptr & 0xFF00)) { core.cycles = core.cycles + 1; }
            } or {
                mem[addr::usize] = (core.a & 0xFF)::u8;
                core.cycles = core.cycles + 6;
            }
            core.pc = core.pc + 2;
        }
        or { ret false; }
    }
    ret false;
}

fun t_run_cmp(code: *u8, n: usize, mem: *u8, size: usize, cycles: *u32) bool {
    val base: usize = T_CODE_BASE::usize;
    if (base + n >= size) { ret false; }
    var i: usize = 0;
    for (i < n) { mem[base + i] = code[i]; i = i + 1; }
    mem[base + n] = OP_RTS;

    var core: Core;
    core.a = 0; core.y = 0; core.c = 0; core.cycles = 0;
    core.pc = T_CODE_BASE;
    if (!exec_reference(mem, size, ?core)) { ret false; }
    @cycles = core.cycles - 6;
    ret true;
}

val T_CODE_BASE: u32 = 0x0200;

val T_MEM_SIZE: usize = 0x1000;

fun t_check_cmp(st: *enc.EncodeState, want: u32, mem: *u8) i32 {
    var fixed: u32 = 0;
    var x: u32 = 0;
    for (x < 256) {
        var y: u32 = 0;
        for (y < 256) {
            var k: usize = 0;
            for (k < 256) { mem[k] = 0; k = k + 1; }
            mem[0x18] = (x & 0xFF)::u8;
            mem[0x19] = (y & 0xFF)::u8;

            var cy: u32 = 0;
            if (!t_run_cmp(st.buf.data, st.buf.len, mem, T_MEM_SIZE, ?cy)) { ret 1; }

            var expect: u32 = 0;
            if (want == 0 && x == y) { expect = 1; }
            or (want == 1 && x != y) { expect = 1; }
            or (want == 2 && x <  y) { expect = 1; }
            if (mem[0x1A]::u32 != expect) { ret 1; }

            if (x == 0 && y == 0) { fixed = cy; }
            or (cy != fixed)      { ret 1; }
            y = y + 1;
        }
        x = x + 1;
    }
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:compare_executes_constant_time" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val mr: R.Result[*u8, str] = A.zallocate[u8](?alloc, T_MEM_SIZE);
    if (R.is_err[*u8, str](mr)) { ret 1; }
    val mem: *u8 = R.unwrap_ok[*u8, str](mr);

    var eq: enc.EncodeState;
    eq.buf = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_cmp(?eq, mir.MIR_CMP_EQ))) { ret 1; }
    if (t_check_cmp(?eq, 0, mem) != 0) { ret 1; }
    enc.buf_dnit(?eq.buf);

    var ne: enc.EncodeState;
    ne.buf = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_cmp(?ne, mir.MIR_CMP_NE))) { ret 1; }
    if (t_check_cmp(?ne, 1, mem) != 0) { ret 1; }
    enc.buf_dnit(?ne.buf);

    var lt: enc.EncodeState;
    lt.buf = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_cmp(?lt, mir.MIR_CMP_LT_U))) { ret 1; }
    if (t_check_cmp(?lt, 2, mem) != 0) { ret 1; }
    enc.buf_dnit(?lt.buf);

    A.deallocate[u8](?alloc, mem, T_MEM_SIZE);
    ret 0;
}

fun t_encode_shift(st: *enc.EncodeState, op: mir.MirOpcode, count: i64) R.Result[R.Void, str] {
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(8);
    ops[2] = mir.op_imm(count);
    var mi: mir.MirInstr = mir.instr(op, ?ops[0], 3, 1, 1);
    ret encode_shift(st, ?mi, op);
}

fun t_shift_ref(op: mir.MirOpcode, v: u32, count: u32) u32 {
    if (op == mir.MIR_SHL)   { ret (v << count) & 0xFF; }
    if (op == mir.MIR_SHR_U) { ret (v & 0xFF) >> count; }
    var s: u32 = v & 0xFF;
    if (s >= 0x80) { s = s | 0xFFFFFF00; }
    ret (s::i32 >> count::i32)::u32 & 0xFF;
}

test "mach.lang.target.isa.mos6502.encode:byte_shift_executes_constant_time" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val mr: R.Result[*u8, str] = A.zallocate[u8](?alloc, T_MEM_SIZE);
    if (R.is_err[*u8, str](mr)) { ret 1; }
    val mem: *u8 = R.unwrap_ok[*u8, str](mr);

    var ops: [3]mir.MirOpcode;
    ops[0] = mir.MIR_SHL; ops[1] = mir.MIR_SHR_U; ops[2] = mir.MIR_SHR_S;
    var oi: u32 = 0;
    for (oi < 3) {
        var c: u32 = 0;
        for (c < 8) {
            var st: enc.EncodeState;
            st.buf = enc.buf_init(?alloc);
            if (R.is_err[R.Void, str](t_encode_shift(?st, ops[oi], c::i64))) { ret 1; }
            if (t_has_branch(?st)) { ret 1; }

            var fixed: u32 = 0;
            var v: u32 = 0;
            for (v < 256) {
                var k: usize = 0;
                for (k < 256) { mem[k] = 0; k = k + 1; }
                mem[0x18] = (v & 0xFF)::u8;

                var cy: u32 = 0;
                if (!t_run_cmp(st.buf.data, st.buf.len, mem, T_MEM_SIZE, ?cy)) { ret 1; }
                if (mem[0x1A]::u32 != t_shift_ref(ops[oi], v, c)) { ret 1; }
                if (v == 0)      { fixed = cy; }
                or (cy != fixed) { ret 1; }
                v = v + 1;
            }
            enc.buf_dnit(?st.buf);
            c = c + 1;
        }
        oi = oi + 1;
    }

    A.deallocate[u8](?alloc, mem, T_MEM_SIZE);
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:refuses_an_unreduced_shift" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(8);
    var mi: mir.MirInstr = mir.instr(mir.MIR_SHL, ?ops[0], 3, 1, 1);

    ops[2] = mir.op_preg(9);
    if (!R.is_err[R.Void, str](encode_shift(?st, ?mi, mir.MIR_SHL))) { ret 1; }
    ops[2] = mir.op_imm(8);
    if (!R.is_err[R.Void, str](encode_shift(?st, ?mi, mir.MIR_SHL))) { ret 1; }
    ops[2] = mir.op_imm(-1);
    if (!R.is_err[R.Void, str](encode_shift(?st, ?mi, mir.MIR_SHL))) { ret 1; }
    ops[2] = mir.op_imm(1);
    mi.width = 2;
    if (!R.is_err[R.Void, str](encode_shift(?st, ?mi, mir.MIR_SHL))) { ret 1; }

    mi.width = 1;
    if (R.is_err[R.Void, str](encode_shift(?st, ?mi, mir.MIR_SHL))) { ret 1; }
    enc.buf_dnit(?st.buf);
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:refuses_a_base_that_is_not_a_pointer_pair" {
    if (!mos6502.is_ptr_pair(mos6502.FP_LO))       { ret 1; }
    if (!mos6502.is_ptr_pair(mos6502.SP_LO))       { ret 1; }
    if (!mos6502.is_ptr_pair(mos6502.PTR_LO))      { ret 1; }
    if (!mos6502.is_ptr_pair(mos6502.SCRATCH_REG)) { ret 1; }
    if (mos6502.is_ptr_pair(mos6502.FP_HI))        { ret 1; }
    if (mos6502.is_ptr_pair(mos6502.PTR_HI))       { ret 1; }
    if (mos6502.is_ptr_pair(mos6502.RELOAD0))      { ret 1; }
    if (mos6502.is_ptr_pair(mos6502.FIRST_VALUE_REG))     { ret 1; }
    if (mos6502.is_ptr_pair(mos6502.FIRST_VALUE_REG + 1)) { ret 1; }

    var ops: [2]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?ops[0], 2, 1, 1);
    var base: i32 = 0;
    var disp: u8  = 0;

    ops[1] = mir.op_mem_preg(mos6502.FIRST_VALUE_REG::u32, 0);
    if (!R.is_err[R.Void, str](mem_base_disp(?mi, ?ops[1], ?base, ?disp))) { ret 1; }
    ops[1] = mir.op_mem_slot(3, 0);
    if (!R.is_err[R.Void, str](mem_base_disp(?mi, ?ops[1], ?base, ?disp))) { ret 1; }
    ops[1] = mir.op_mem_preg(mos6502.FP_LO::u32, 256);
    if (!R.is_err[R.Void, str](mem_base_disp(?mi, ?ops[1], ?base, ?disp))) { ret 1; }
    mi.width = 2;
    ops[1] = mir.op_mem_preg(mos6502.FP_LO::u32, 0);
    if (!R.is_err[R.Void, str](mem_base_disp(?mi, ?ops[1], ?base, ?disp))) { ret 1; }

    mi.width = 1;
    ops[1] = mir.op_mem_preg(mos6502.FP_LO::u32, 7);
    if (R.is_err[R.Void, str](mem_base_disp(?mi, ?ops[1], ?base, ?disp))) { ret 1; }
    if (base != mos6502.FP_LO || disp != 7) { ret 1; }
    ret 0;
}

val T_PTR_REG:  i32 = mos6502.FIRST_VALUE_REG;
val T_DATA_REG: i32 = mos6502.FIRST_VALUE_REG + 2;

fun t_put(f: *mir.MirInstr, ops: *mir.MirOperand, ix: u32, opcode: mir.MirOpcode,
          a: mir.MirOperand, b: mir.MirOperand, nops: u32) {
    ops[ix * 2]     = a;
    ops[ix * 2 + 1] = b;
    f[ix].opcode        = opcode;
    f[ix].operands      = ?ops[ix * 2];
    f[ix].operand_count = nops;
    f[ix].width         = 1;
    f[ix].src_width     = 1;
    f[ix].vec_lane      = mir.VEC_LANE_NONE;
}

fun t_roundtrip_fn(f: *mir.MirInstr, ops: *mir.MirOperand, blocks: *mir.MirBlock,
                   fn: *mir.MirFunction, n: u32) {
    var ix: u32 = 0;
    var i:  u32 = 0;
    for (i < 2) {
        t_put(f, ops, ix, mos6502.MOV::u32, mir.op_preg((T_PTR_REG + i::i32)::u32),
              mir.op_preg((mos6502.PTR_LO + i::i32)::u32), 2);
        ix = ix + 1; i = i + 1;
    }
    i = 0;
    for (i < n) {
        t_put(f, ops, ix, mir.MIR_LOAD, mir.op_preg((T_DATA_REG + i::i32)::u32),
              mir.op_mem_preg(mos6502.FRAME_REG::u32, i::i64), 2);
        ix = ix + 1; i = i + 1;
    }
    i = 0;
    for (i < 2) {
        t_put(f, ops, ix, mos6502.MOV::u32, mir.op_preg((mos6502.SCRATCH_REG + i::i32)::u32),
              mir.op_preg((T_PTR_REG + i::i32)::u32), 2);
        ix = ix + 1; i = i + 1;
    }
    i = 0;
    for (i < n) {
        t_put(f, ops, ix, mir.MIR_STORE, mir.op_mem_preg(mos6502.SCRATCH_REG::u32, i::i64),
              mir.op_preg((T_DATA_REG + i::i32)::u32), 2);
        ix = ix + 1; i = i + 1;
    }
    i = 0;
    for (i < 2) {
        t_put(f, ops, ix, mos6502.MOV::u32, mir.op_preg((mos6502.PTR_LO + i::i32)::u32),
              mir.op_preg((T_PTR_REG + i::i32)::u32), 2);
        ix = ix + 1; i = i + 1;
    }
    t_put(f, ops, ix, mos6502.RTS::u32, mir.op_imm(0), mir.op_imm(0), 0);
    ix = ix + 1;

    blocks[0].id          = 0;
    blocks[0].instrs      = f;
    blocks[0].instr_count = ix;
    blocks[0].instr_cap   = ix;

    fn.name        = intern.STR_NIL;
    fn.blocks      = blocks;
    fn.block_count = 1;
    fn.block_cap   = 1;
}

fun t_encode_roundtrip(st: *enc.EncodeState, n: u32) R.Result[R.Void, str] {
    var instrs: [23]mir.MirInstr;
    var ops:    [46]mir.MirOperand;
    var blocks: [1]mir.MirBlock;
    var fn:     mir.MirFunction;
    t_roundtrip_fn(?instrs[0], ?ops[0], ?blocks[0], ?fn, n);
    ret encode_function(st, ?fn);
}

fun t_run_roundtrip(code: *u8, len: usize, mem: *u8, n: u32, arg: u32, store: u32,
                    value: u64, cycles: *u32) bool {
    val base: usize = T_CODE_BASE::usize;
    if (base + len >= T_MEM_SIZE) { ret false; }
    var i: usize = 0;
    for (i < len) { mem[base + i] = code[i]; i = i + 1; }

    mem[mos6502.zp_addr(mos6502.FP_LO)::usize] = (arg & 0xFF)::u8;
    mem[mos6502.zp_addr(mos6502.FP_HI)::usize] = ((arg >> 8) & 0xFF)::u8;
    mem[mos6502.zp_addr(mos6502.PTR_LO)::usize] = (store & 0xFF)::u8;
    mem[mos6502.zp_addr(mos6502.PTR_HI)::usize] = ((store >> 8) & 0xFF)::u8;

    var k: u32 = 0;
    for (k < n) {
        mem[(arg + k)::usize]   = ((value >> (k * 8)::u64) & 0xFF)::u8;
        mem[(store + k)::usize] = 0;
        k = k + 1;
    }

    var core: Core;
    core.a = 0; core.y = 0; core.c = 0; core.cycles = 0;
    core.pc = T_CODE_BASE;
    if (!exec_reference(mem, T_MEM_SIZE, ?core)) { ret false; }
    @cycles = core.cycles;

    k = 0;
    for (k < n) {
        if (mem[(store + k)::usize]::u64 != ((value >> (k * 8)::u64) & 0xFF)) { ret false; }
        k = k + 1;
    }
    if (mem[mos6502.zp_addr(mos6502.PTR_LO)::usize]::u32 != (store & 0xFF))        { ret false; }
    if (mem[mos6502.zp_addr(mos6502.PTR_HI)::usize]::u32 != ((store >> 8) & 0xFF)) { ret false; }
    ret true;
}

fun t_check_roundtrip(st: *enc.EncodeState, mem: *u8, n: u32, arg: u32, store: u32,
                      iters: u32, out: *u32) i32 {
    var fixed: u32 = 0;
    var seed:  u64 = 0x243F6A8885A308D3;
    var i: u32 = 0;
    for (i < iters) {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var v: u64 = seed;
        if (i == 0) { v = 0; }
        or (i == 1) { v = 0xFFFFFFFFFFFFFFFF; }
        or (i == 2) { v = 0xAA55AA55AA55AA55; }
        or (i == 3) { v = 0x0102040810204080; }

        var cy: u32 = 0;
        if (!t_run_roundtrip(st.buf.data, st.buf.len, mem, n, arg, store, v, ?cy)) { ret 1; }
        if (i == 0)      { fixed = cy; }
        or (cy != fixed) { ret 1; }
        i = i + 1;
    }
    @out = fixed;
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:wide_scalar_bytes_match_pipeline" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: enc.EncodeState;
    st.alloc = ?alloc;
    st.buf   = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_roundtrip(?st, 4))) { ret 1; }

    val want: [73]u8 = [73]u8{
        0xA5, 0x14, 0x85, 0x1B, 0xA5, 0x15, 0x85, 0x1C,
        0xA0, 0x00, 0xB1, 0x10, 0x85, 0x1D,
        0xA0, 0x01, 0xB1, 0x10, 0x85, 0x1E,
        0xA0, 0x02, 0xB1, 0x10, 0x85, 0x1F,
        0xA0, 0x03, 0xB1, 0x10, 0x85, 0x20,
        0xA5, 0x1B, 0x85, 0x16, 0xA5, 0x1C, 0x85, 0x17,
        0xA5, 0x1D, 0xA0, 0x00, 0x91, 0x16,
        0xA5, 0x1E, 0xA0, 0x01, 0x91, 0x16,
        0xA5, 0x1F, 0xA0, 0x02, 0x91, 0x16,
        0xA5, 0x20, 0xA0, 0x03, 0x91, 0x16,
        0xA5, 0x1B, 0x85, 0x14, 0xA5, 0x1C, 0x85, 0x15,
        0x60,
    };
    if (st.buf.len != 73) { ret 1; }
    var i: usize = 0;
    for (i < 73) {
        if (st.buf.data[i] != want[i]) { ret 1; }
        i = i + 1;
    }
    if (t_has_branch(?st)) { ret 1; }
    enc.buf_dnit(?st.buf);
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:wide_scalar_executes_constant_time" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val mr: R.Result[*u8, str] = A.zallocate[u8](?alloc, T_MEM_SIZE);
    if (R.is_err[*u8, str](mr)) { ret 1; }
    val mem: *u8 = R.unwrap_ok[*u8, str](mr);

    var widths: [3]u32;
    widths[0] = 2; widths[1] = 4; widths[2] = 8;
    var w: u32 = 0;
    for (w < 3) {
        var st: enc.EncodeState;
        st.alloc = ?alloc;
        st.buf   = enc.buf_init(?alloc);
        if (R.is_err[R.Void, str](t_encode_roundtrip(?st, widths[w]))) { ret 1; }
        if (t_has_branch(?st))                                       { ret 1; }
        var fixed: u32 = 0;
        if (t_check_roundtrip(?st, mem, widths[w], 0x0500, 0x0600, 4096, ?fixed) != 0) { ret 1; }
        enc.buf_dnit(?st.buf);
        w = w + 1;
    }

    A.deallocate[u8](?alloc, mem, T_MEM_SIZE);
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:page_crossing_costs_are_address_only" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val mr: R.Result[*u8, str] = A.zallocate[u8](?alloc, T_MEM_SIZE);
    if (R.is_err[*u8, str](mr)) { ret 1; }
    val mem: *u8 = R.unwrap_ok[*u8, str](mr);

    var st: enc.EncodeState;
    st.alloc = ?alloc;
    st.buf   = enc.buf_init(?alloc);
    if (R.is_err[R.Void, str](t_encode_roundtrip(?st, 4))) { ret 1; }

    var aligned: u32 = 0;
    var split:   u32 = 0;
    if (t_check_roundtrip(?st, mem, 4, 0x0500, 0x0600, 256, ?aligned) != 0) { ret 1; }
    if (t_check_roundtrip(?st, mem, 4, 0x04FE, 0x0600, 256, ?split)   != 0) { ret 1; }

    if (split != aligned + 2) { ret 1; }

    enc.buf_dnit(?st.buf);
    A.deallocate[u8](?alloc, mem, T_MEM_SIZE);
    ret 0;
}

test "mach.lang.target.isa.mos6502.encode:unnamed_operations_are_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);
    var bad: i32 = 0;

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(8);
    ops[2] = mir.op_imm(1);

    var alu: mir.MirInstr = mir.instr(mir.MIR_MUL, ?ops[0], 3, 1, 1);
    if (!R.is_err[R.Void, str](encode_alu(?st, ?alu, mir.MIR_MUL)))     { bad = 1; }
    if (st.buf.len != 0)                                             { bad = 1; }
    if (!R.is_err[R.Void, str](encode_alu(?st, ?alu, mir.MIR_SHL)))     { bad = 1; }
    if (st.buf.len != 0)                                             { bad = 1; }

    var sh: mir.MirInstr = mir.instr(mir.MIR_SHL, ?ops[0], 3, 1, 1);
    if (!R.is_err[R.Void, str](encode_shift(?st, ?sh, mir.MIR_MUL)))   { bad = 1; }
    if (st.buf.len != 0)                                             { bad = 1; }

    var cm: mir.MirInstr = mir.instr(mir.MIR_CMP_LT_S, ?ops[0], 3, 1, 1);
    if (!R.is_err[R.Void, str](encode_cmp(?st, ?cm, mir.MIR_CMP_LT_S))) { bad = 1; }
    if (st.buf.len != 0)                                             { bad = 1; }
    if (!R.is_err[R.Void, str](encode_cmp(?st, ?cm, mir.MIR_CMP_LE_U))) { bad = 1; }
    if (st.buf.len != 0)                                             { bad = 1; }

    if (R.is_err[R.Void, str](encode_alu(?st, ?alu, mir.MIR_XOR)))      { bad = 1; }
    if (st.buf.len == 0)                                             { bad = 1; }
    st.buf.len = 0;
    if (R.is_err[R.Void, str](encode_shift(?st, ?sh, mir.MIR_SHR_S)))   { bad = 1; }
    if (st.buf.len == 0)                                             { bad = 1; }
    st.buf.len = 0;
    if (R.is_err[R.Void, str](encode_cmp(?st, ?cm, mir.MIR_CMP_NE)))    { bad = 1; }
    if (st.buf.len == 0)                                             { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}
