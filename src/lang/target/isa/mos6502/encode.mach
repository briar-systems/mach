# MOS 6502 machine-code encoder
#
# Turns a fully-resolved (post-isel, post-regalloc, post-frame) MIR function into
# 6502 bytes through the shared two-pass driver (`be.codegen.encode.encode_driver`):
# it supplies the per-function encode hook and the per-branch patch hook and owns
# all opcode / addressing-mode / byte knowledge. The concrete opcode bytes are laid
# out as a regular ADDRESSING-MODE x OPERATION matrix (immediate / zero-page /
# absolute forms of each operation), the shape a second retro target would reuse.
#
# THE ACCUMULATOR MODEL. Every MIR value lives in a zero-page imaginary register
# (`mos6502.zp_addr` maps a register id to its zero-page byte). Because the 6502 has
# no register-to-register ALU, a byte operation `d = a op b` is materialized as
# `LDA a ; <op> b ; STA d` through the accumulator - a three-instruction sequence,
# the honest cost of an 8-bit machine. Addition and subtraction additionally clear
# / set carry first (`CLC` / `SEC`), since the legalizer's byte lanes each start a
# fresh single-byte add / subtract.
#
# SCOPE. This encoder realizes the straight-line register-arithmetic core - moves,
# the byte ALU (add / sub / and / or / xor / not), returns, and direct calls -
# byte-exact against the published 6502 opcode matrix. The frontiers documented in
# the backend's scorecard (conditional branches, memory access through the software
# frame, and the 16-bit-pointer forms) reach the encoder as passed-through generic
# opcodes and are rejected with a loud, specific diagnostic rather than mis-encoded.
#
# TIMING OBLIGATION (#2158). The constant-time guarantee treats selection, register
# allocation, and encoding as timing-PRESERVING: the `#[oblivious]` gate and the #1648
# validator both read pre-selection MIR, so a leak this encoder introduces is invisible
# to them. That makes it this file's standing obligation - an instruction NOT itself a
# control transfer must encode to a fixed-cycle sequence, never a data-dependent branch.
# `encode_cmp` once broke it, materializing the equality boolean with a `BNE` over a
# `LDA #1`; every relation now goes through the branchless carry read instead. A
# conditional branch remains legitimate only where the MIR op IS the branch
# (`encode_sel_cbr`), which the validator observes directly. The guard is not a reading
# of the code: `compare_executes_constant_time` below EXECUTES the emitted bytes over
# every operand pair, because that broken sequence also silently answered wrong and no
# amount of re-reading it had caught either fault.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use std.allocator.page;

use A: std.allocator;
use R: std.types.result;

use enc: mach.lang.be.codegen.encode;
use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.isa.mos6502;
use mach.lang.target.of;
use target: mach.lang.target.resolved;

# the published 6502 opcode bytes, grouped by operation with one constant per
# addressing mode this encoder emits (immediate / zero-page / absolute). the names
# match the standard mnemonics so a byte pin reads against the reference matrix
val OP_LDA_IMM: u8 = 0xA9;  val OP_LDA_ZP: u8 = 0xA5;  val OP_LDA_ABS: u8 = 0xAD;
val OP_STA_ZP:  u8 = 0x85;  val OP_STA_ABS: u8 = 0x8D;
val OP_ADC_IMM: u8 = 0x69;  val OP_ADC_ZP: u8 = 0x65;
val OP_SBC_IMM: u8 = 0xE9;  val OP_SBC_ZP: u8 = 0xE5;
val OP_AND_IMM: u8 = 0x29;  val OP_AND_ZP: u8 = 0x25;
val OP_ORA_IMM: u8 = 0x09;  val OP_ORA_ZP: u8 = 0x05;
val OP_EOR_IMM: u8 = 0x49;  val OP_EOR_ZP: u8 = 0x45;
val OP_CMP_IMM: u8 = 0xC9;  val OP_CMP_ZP: u8 = 0xC5;
val OP_CLC:     u8 = 0x18;  val OP_SEC:    u8 = 0x38;
val OP_JMP_ABS: u8 = 0x4C;  val OP_JSR_ABS: u8 = 0x20;
val OP_RTS:     u8 = 0x60;  val OP_BRK:     u8 = 0x00;  val OP_NOP: u8 = 0xEA;
# the conditional branch opcodes (pc-relative, signed 8-bit displacement)
val OP_BEQ: u8 = 0xF0;  val OP_BNE: u8 = 0xD0;  val OP_BCC: u8 = 0x90;  val OP_BCS: u8 = 0xB0;
# rotate the accumulator left through carry ($2A) - used to read the carry flag into
# a 0/1 boolean when materializing a standalone unsigned compare
val OP_ROL_A: u8 = 0x2A;

# encode one fully-resolved MIR module into `.text` bytes, symbol marks, and
# relocations
#
# The 6502 implementation behind the ISA vtable's `encode` slot; binds the 6502
# encode / patch hooks to the shared two-pass driver.
# ---
# alloc: backing allocator for the encoder's output arrays
# tgt:   resolved compilation target (must be mos6502)
# m:     the fully-resolved MIR module
# ret:   the populated EncoderOutput, or an error naming the failure
pub fun encode_mos6502(alloc: *A.Allocator, tgt: *target.Target, m: *mir.MirModule) R.Result[enc.EncoderOutput, str] {
    var hooks: enc.EncodeHooks;
    hooks.encode_function = encode_function;
    hooks.patch_branch    = patch_branch;
    ret enc.encode_driver(alloc, tgt, m, ?hooks);
}

# emit one function's 6502 bytes into the shared encode state (driver pass 1)
#
# Records the function's entry symbol mark, then walks its blocks in layout order -
# registering each block's `.text` offset for pass-2 branch resolution - and encodes
# every instruction. The 6502 has no register-save prologue: values live in
# zero-page and the software frame pointer is managed by the caller, so a leaf
# function is pure body plus its terminating RTS.
# ---
# st: the shared encode state (text sink + mark / reloc / fixup / block arrays)
# f:  the function to encode
# ret: ok(true) on success, or an error naming an unencodable instruction
fun encode_function(st: *enc.EncodeState, f: *mir.MirFunction) R.Result[bool, str] {
    val fn_base: u32 = st.buf.len::u32;

    val res_sym: R.Result[bool, str] = enc.push_symbol(st, f.name, fn_base, 0);
    if (R.is_err[bool, str](res_sym)) { ret res_sym; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *mir.MirBlock = ?f.blocks[bi];
        val res_blk: R.Result[bool, str] = enc.push_block(st, fn_base, b.id, st.buf.len::u32);
        if (R.is_err[bool, str](res_blk)) { ret res_blk; }

        var ii: u32 = 0;
        for (ii < b.instr_count) {
            val res_i: R.Result[bool, str] = encode_instr(st, f, ?b.instrs[ii], fn_base);
            if (R.is_err[bool, str](res_i)) { ret res_i; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok[bool, str](true);
}

# encode one resolved MIR instruction
# ---
# st:      the shared encode state
# f:       the owning function (for operand resolution)
# mi:      the instruction to encode
# fn_base: the owning function's first-block text offset (for branch fixups)
# ret:     ok(true) on success, or an error naming an unencodable instruction
fun encode_instr(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr, fn_base: u32) R.Result[bool, str] {
    val op: mir.MirOpcode = mi.opcode;

    if (op == mos6502.MOV::u32) { ret encode_mov(st, mi); }
    if (op == mos6502.RTS::u32) { enc.emit_byte(?st.buf, OP_RTS); ret R.ok[bool, str](true); }
    if (op == mos6502.BRK::u32) { enc.emit_byte(?st.buf, OP_BRK); ret R.ok[bool, str](true); }
    if (op == mos6502.NOP::u32) { enc.emit_byte(?st.buf, OP_NOP); ret R.ok[bool, str](true); }
    if (op == mos6502.JMP::u32) { ret encode_br(st, mi, fn_base); }

    if (op == mir.MIR_ADD || op == mir.MIR_SUB ||
        op == mir.MIR_AND || op == mir.MIR_OR || op == mir.MIR_XOR) {
        ret encode_alu(st, mi, op);
    }
    if (op == mir.MIR_NOT) { ret encode_not(st, mi); }
    if (op == mir.MIR_CMP_EQ || op == mir.MIR_CMP_NE || op == mir.MIR_CMP_LT_U) {
        ret encode_cmp(st, mi, op);
    }
    if (mir.is_fused_cbr(op)) { ret encode_sel_cbr(st, mi, fn_base); }
    if (op == mir.MIR_CALL) { ret encode_call(st, mi); }

    ret R.err[bool, str](unencodable_message(op));
}

# encode a byte move `dst <- src` as `LDA src ; STA dst`
#
# The source is an immediate (`LDA #imm`) or a zero-page value register (`LDA zp`);
# the destination is always a zero-page value register (`STA zp`).
fun encode_mov(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2) { ret R.err[bool, str]("mos6502: malformed move"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[bool, str](unencodable_message(mos6502.MOV::u32)); }

    val res_ld: R.Result[bool, str] = emit_load_a(st, src);
    if (R.is_err[bool, str](res_ld)) { ret res_ld; }
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok[bool, str](true);
}

# encode a byte ALU op `dst = a op b` as `LDA a ; [CLC|SEC ;] <op> b ; STA dst`
#
# Addition clears carry first and subtraction sets it, since each legalized byte
# lane begins a fresh single-byte add / subtract. The right operand rides an
# immediate or a zero-page value register.
fun encode_alu(st: *enc.EncodeState, mi: *mir.MirInstr, op: mir.MirOpcode) R.Result[bool, str] {
    if (mi.operand_count != 3) { ret R.err[bool, str]("mos6502: malformed binary op"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val a:   *mir.MirOperand = ?mi.operands[1];
    val b:   *mir.MirOperand = ?mi.operands[2];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[bool, str](unencodable_message(op)); }

    val res_ld: R.Result[bool, str] = emit_load_a(st, a);
    if (R.is_err[bool, str](res_ld)) { ret res_ld; }

    if (op == mir.MIR_ADD) { enc.emit_byte(?st.buf, OP_CLC); }
    if (op == mir.MIR_SUB) { enc.emit_byte(?st.buf, OP_SEC); }

    var imm_op: u8 = 0;
    var zp_op:  u8 = 0;
    if (op == mir.MIR_ADD) { imm_op = OP_ADC_IMM; zp_op = OP_ADC_ZP; }
    or (op == mir.MIR_SUB) { imm_op = OP_SBC_IMM; zp_op = OP_SBC_ZP; }
    or (op == mir.MIR_AND) { imm_op = OP_AND_IMM; zp_op = OP_AND_ZP; }
    or (op == mir.MIR_OR)  { imm_op = OP_ORA_IMM; zp_op = OP_ORA_ZP; }
    or                     { imm_op = OP_EOR_IMM; zp_op = OP_EOR_ZP; }

    val res_op: R.Result[bool, str] = emit_operand(st, b, imm_op, zp_op, op);
    if (R.is_err[bool, str](res_op)) { ret res_op; }
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok[bool, str](true);
}

# encode a byte complement `dst = ~a` as `LDA a ; EOR #$FF ; STA dst`
fun encode_not(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count != 2) { ret R.err[bool, str]("mos6502: malformed not"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[bool, str](unencodable_message(mir.MIR_NOT)); }
    val res_ld: R.Result[bool, str] = emit_load_a(st, ?mi.operands[1]);
    if (R.is_err[bool, str](res_ld)) { ret res_ld; }
    emit_imm1(st, OP_EOR_IMM, 0xFF);
    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok[bool, str](true);
}

# encode a standalone comparison `dst = (a rel b)` producing a 0 / 1 byte boolean
#
# BRANCHLESS for every relation encoded here, so a comparison of SECRET values is
# constant-time (#2158). The 6502 has no SETcc, but every relation lands in the
# carry flag and `LDA #0 ; ROL A` reads carry into a 0 / 1 byte without a branch:
#
#   a <u b   LDA a ; CMP b        -> C = (a >= b), the complement, so EOR #1 flips it
#   a != b   LDA a ; EOR b ; CMP #1 -> A is 0 exactly when equal, so C = (a != b)
#   a == b   the same, then EOR #1
#
# Every form is a fixed-cycle immediate / zero-page / accumulator instruction, so the
# sequence's cycle count is operand-INDEPENDENT, which is what `#[oblivious]` needs.
#
# THE CARRY IS THE ONLY FLAG THAT MAY CROSS an instruction here, and `LDA` / `EOR` do not
# write it. The equality form this replaced ended `CMP b ; LDA #$00 ; BNE +2 ; LDA #$01`,
# reading the compare's ZERO flag after a `LDA` - which sets Z from the byte it loads. Z
# was therefore always 1 at the branch, so the branch was a constant and the compare
# answered 1 for every `==` and 0 for every `!=`, regardless of its operands. A
# secret-dependent branch in an `#[oblivious]` function on top of a compare that never
# looked at its inputs. Signed and <= forms are a documented frontier.
fun encode_cmp(st: *enc.EncodeState, mi: *mir.MirInstr, op: mir.MirOpcode) R.Result[bool, str] {
    if (mi.operand_count != 3) { ret R.err[bool, str]("mos6502: malformed compare"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind != mir.MIR_OP_PREG) { ret R.err[bool, str](unencodable_message(op)); }

    val res_ld: R.Result[bool, str] = emit_load_a(st, ?mi.operands[1]);
    if (R.is_err[bool, str](res_ld)) { ret res_ld; }
    val b: *mir.MirOperand = ?mi.operands[2];

    if (op == mir.MIR_CMP_LT_U) {
        # CMP leaves carry set when a >= b.
        val res_c: R.Result[bool, str] = emit_cmp_operand(st, b, OP_CMP_IMM, OP_CMP_ZP);
        if (R.is_err[bool, str](res_c)) { ret res_c; }
    }
    or {
        # difference-to-zero: the accumulator is zero exactly when the operands are
        # equal, so comparing it against 1 puts (a != b) in the carry.
        val res_x: R.Result[bool, str] = emit_cmp_operand(st, b, OP_EOR_IMM, OP_EOR_ZP);
        if (R.is_err[bool, str](res_x)) { ret res_x; }
        emit_imm1(st, OP_CMP_IMM, 0x01);
    }

    # read the carry into a 0 / 1 boolean; LDA leaves the carry untouched.
    emit_imm1(st, OP_LDA_IMM, 0x00);
    enc.emit_byte(?st.buf, OP_ROL_A);
    # CMP_NE wants the carry as-is; a < b and a == b are both its complement.
    if (op != mir.MIR_CMP_NE) { emit_imm1(st, OP_EOR_IMM, 0x01); }

    emit_zp1(st, OP_STA_ZP, mos6502.zp_addr(dst.preg::i32));
    ret R.ok[bool, str](true);
}

# emit a compare's right operand in its immediate or zero-page form
#
# The one dispatch both the standalone compare and the fused compare-and-branch read
# their second operand through, so the accepted operand shapes and the diagnostic for
# an unexpected one cannot drift between them.
# ---
# st:     the shared encode state
# b:      the operand to emit
# imm_op: the operation's immediate-mode opcode
# zp_op:  the operation's zero-page opcode
# ret:    ok(true), or an error naming the unsupported operand shape
fun emit_cmp_operand(st: *enc.EncodeState, b: *mir.MirOperand, imm_op: u8, zp_op: u8) R.Result[bool, str] {
    if (b.kind == mir.MIR_OP_IMM)  { emit_imm1(st, imm_op, (b.imm & 0xFF)::u8); ret R.ok[bool, str](true); }
    if (b.kind == mir.MIR_OP_PREG) { emit_zp1(st, zp_op, mos6502.zp_addr(b.preg::i32)); ret R.ok[bool, str](true); }
    ret R.err[bool, str]("mos6502: unsupported compare operand");
}

# encode an unconditional branch `MIR_BR [block]` as `JMP block` (absolute)
#
# The target's absolute address is its `.text` offset, resolved in the driver's
# second pass: the freestanding flat image loads at base 0 with `.text` at address
# 0, so a block at `.text` offset O sits at address O. A non-zero load base would
# need a relocation (deferred with the call path).
fun encode_br(st: *enc.EncodeState, mi: *mir.MirInstr, fn_base: u32) R.Result[bool, str] {
    if (mi.operand_count == 0 || mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        ret R.err[bool, str]("mos6502: malformed unconditional branch");
    }
    ret emit_jmp(st, mi.operands[0].imm::u32, fn_base);
}

# encode a fused compare-and-branch `[lhs, rhs, then_block, else_block]` as the
# always-correct invert-and-jump long form
#
#   LDA lhs ; CMP rhs ; B!cc +3 ; JMP then ; JMP else
#
# The inverted conditional skips exactly the 3-byte then-JMP when the condition is
# false, so its displacement is a fixed +3 and can never exceed the branch range,
# and both real targets are absolute JMPs with no distance limit. Unsigned and
# equality conditions are realized directly; signed relations need the 6502's
# overflow-aware sequence and are a documented frontier.
fun encode_sel_cbr(st: *enc.EncodeState, mi: *mir.MirInstr, fn_base: u32) R.Result[bool, str] {
    if (mi.operand_count != 4 ||
        mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret R.err[bool, str]("mos6502: malformed fused compare-and-branch");
    }
    val op:  mir.MirOpcode = mi.opcode;
    val lhs: *mir.MirOperand = ?mi.operands[0];
    val rhs: *mir.MirOperand = ?mi.operands[1];
    val then_block: u32 = mi.operands[2].imm::u32;
    val else_block: u32 = mi.operands[3].imm::u32;

    # pick the accumulator operand, the compared operand, and the INVERTED branch
    # (taken when the fused condition is FALSE, to skip the then-JMP). LE_U swaps the
    # operands so `lhs <= rhs` becomes `rhs >= lhs`, a carry-set test.
    var load_op: *mir.MirOperand = lhs;
    var cmp_op:  *mir.MirOperand = rhs;
    var inv_branch: u8 = 0;
    if (op == mir.MIR_SEL_CBR_EQ)        { inv_branch = OP_BNE; }
    or (op == mir.MIR_SEL_CBR_NE)        { inv_branch = OP_BEQ; }
    or (op == mir.MIR_SEL_CBR_LT_U)      { inv_branch = OP_BCS; }
    or (op == mir.MIR_SEL_CBR_LE_U)      { load_op = rhs; cmp_op = lhs; inv_branch = OP_BCC; }
    or {
        ret R.err[bool, str]("mos6502: signed fused compare-and-branch is not yet encoded on this target");
    }

    val res_ld: R.Result[bool, str] = emit_load_a(st, load_op);
    if (R.is_err[bool, str](res_ld)) { ret res_ld; }
    val res_c: R.Result[bool, str] = emit_cmp_operand(st, cmp_op, OP_CMP_IMM, OP_CMP_ZP);
    if (R.is_err[bool, str](res_c)) { ret res_c; }

    # inverted branch over the 3-byte then-JMP (fixed +3, no fixup needed).
    enc.emit_byte(?st.buf, inv_branch);
    enc.emit_byte(?st.buf, 0x03);

    val res_then: R.Result[bool, str] = emit_jmp(st, then_block, fn_base);
    if (R.is_err[bool, str](res_then)) { ret res_then; }
    ret emit_jmp(st, else_block, fn_base);
}

# emit `JMP block` (absolute) and record a branch fixup so the driver's second pass
# patches the 16-bit target address once the block's `.text` offset is known
fun emit_jmp(st: *enc.EncodeState, target_block: u32, fn_base: u32) R.Result[bool, str] {
    enc.emit_byte(?st.buf, OP_JMP_ABS);
    val patch_pos: u32 = st.buf.len::u32;
    enc.emit_byte(?st.buf, 0);
    enc.emit_byte(?st.buf, 0);
    val next_ip: u32 = st.buf.len::u32;
    ret enc.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
}

# encode a direct call as `JSR callee` (absolute), recording a relocation against
# the callee symbol for the 16-bit address field
fun encode_call(st: *enc.EncodeState, mi: *mir.MirInstr) R.Result[bool, str] {
    if (mi.operand_count == 0) { ret R.err[bool, str]("mos6502: malformed call"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind != mir.MIR_OP_SYM) {
        ret R.err[bool, str]("mos6502: indirect call is not yet encoded on this target");
    }
    enc.emit_byte(?st.buf, OP_JSR_ABS);
    val site: u32 = st.buf.len::u32;
    val res_rel: R.Result[bool, str] = enc.push_reloc(st, site, of.RK_ABS64, callee.sym, callee.sym_off);
    if (R.is_err[bool, str](res_rel)) { ret res_rel; }
    # 16-bit absolute address placeholder patched by the linker via the relocation.
    enc.emit_byte(?st.buf, 0);
    enc.emit_byte(?st.buf, 0);
    ret R.ok[bool, str](true);
}

# load the accumulator from an immediate or a zero-page value register
fun emit_load_a(st: *enc.EncodeState, src: *mir.MirOperand) R.Result[bool, str] {
    if (src.kind == mir.MIR_OP_IMM)  { emit_imm1(st, OP_LDA_IMM, (src.imm & 0xFF)::u8); ret R.ok[bool, str](true); }
    if (src.kind == mir.MIR_OP_PREG) { emit_zp1(st, OP_LDA_ZP, mos6502.zp_addr(src.preg::i32)); ret R.ok[bool, str](true); }
    ret R.err[bool, str]("mos6502: unsupported source operand for accumulator load");
}

# emit an operation's right operand as an immediate or zero-page form
fun emit_operand(st: *enc.EncodeState, b: *mir.MirOperand, imm_op: u8, zp_op: u8, op: mir.MirOpcode) R.Result[bool, str] {
    if (b.kind == mir.MIR_OP_IMM)  { emit_imm1(st, imm_op, (b.imm & 0xFF)::u8); ret R.ok[bool, str](true); }
    if (b.kind == mir.MIR_OP_PREG) { emit_zp1(st, zp_op, mos6502.zp_addr(b.preg::i32)); ret R.ok[bool, str](true); }
    ret R.err[bool, str](unencodable_message(op));
}

# emit a two-byte immediate-mode instruction (opcode + 8-bit immediate)
fun emit_imm1(st: *enc.EncodeState, opcode: u8, value: u8) {
    enc.emit_byte(?st.buf, opcode);
    enc.emit_byte(?st.buf, value);
}

# emit a two-byte zero-page instruction (opcode + 8-bit zero-page address)
fun emit_zp1(st: *enc.EncodeState, opcode: u8, addr: i32) {
    enc.emit_byte(?st.buf, opcode);
    enc.emit_byte(?st.buf, (addr & 0xFF)::u8);
}

# write one resolved JMP target into the text (driver pass 2)
#
# Every 6502 fixup is an absolute `JMP` (the conditional-branch displacements are
# fixed +3 skips emitted directly, so they need no fixup). A block's absolute
# address is the image load base plus its `.text` offset, so the 16-bit
# little-endian address field is `base + target_off`. The load base is the OS's
# image base; a 6502 image must load ABOVE the zero page and hardware stack (the
# value register file lives in the zero page), which a base-0 flat image does not
# provide - the target-aware base is a documented layout frontier. At base 0 this
# is `target_off`, matching the flat-image default.
fun patch_branch(st: *enc.EncodeState, fx: *enc.BranchFixup, target_off: u32) R.Result[bool, str] {
    val abs: u32 = st.os.base_addr::u32 + target_off;
    st.buf.data[fx.patch_pos]     = (abs & 0xFF)::u8;
    st.buf.data[fx.patch_pos + 1] = ((abs >> 8) & 0xFF)::u8;
    ret R.ok[bool, str](true);
}

# the diagnostic for a generic opcode this encoder does not yet realize
# ---
# op:  the unencodable opcode
# ret: the diagnostic string
fun unencodable_message(op: mir.MirOpcode) str {
    if (op == mir.MIR_MUL)   { ret "mos6502: the 6502 has no hardware multiply; use a constant-multiplier strength reduction or a runtime routine"; }
    if (op == mir.MIR_DIV_S || op == mir.MIR_DIV_U ||
        op == mir.MIR_REM_S || op == mir.MIR_REM_U) {
        ret "mos6502: the 6502 has no hardware divide / remainder";
    }
    if (op == mir.MIR_FADD || op == mir.MIR_FSUB || op == mir.MIR_FMUL || op == mir.MIR_FDIV) {
        ret "mos6502: floating-point is unsupported on this target";
    }
    if (op == mir.MIR_LOAD || op == mir.MIR_STORE || op == mir.MIR_GEP || op == mir.MIR_ALLOCA) {
        ret "mos6502: memory access encoding is not yet implemented on this target";
    }
    if (op == mir.MIR_CBR || op == mir.MIR_BR ||
        op == mir.MIR_CMP_EQ || op == mir.MIR_CMP_NE ||
        op == mir.MIR_CMP_LT_S || op == mir.MIR_CMP_LT_U ||
        op == mir.MIR_CMP_LE_S || op == mir.MIR_CMP_LE_U) {
        ret "mos6502: compare / branch encoding is not yet implemented on this target";
    }
    ret "mos6502: instruction encoding is not yet implemented on this target";
}

# the byte encodings match the published 6502 opcode matrix: LDA #imm (A9),
# STA zp (85), the ADC/SBC/AND/ORA/EOR immediate and zero-page forms, CLC/SEC, and
# the implied RTS / BRK / NOP. this byte-pins the emitter helpers against the
# reference without needing the full pipeline
test "mach.lang.target.isa.mos6502.encode:byte_pins" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    # LDA #$2A -> A9 2A
    emit_imm1(?st, OP_LDA_IMM, 0x2A);
    if (st.buf.data[0] != 0xA9 || st.buf.data[1] != 0x2A) { ret 1; }

    # STA $18 -> 85 18  (value register id 8 maps to zero-page $18)
    emit_zp1(?st, OP_STA_ZP, mos6502.zp_addr(8));
    if (st.buf.data[2] != 0x85 || st.buf.data[3] != 0x18) { ret 1; }

    # CLC ; ADC $19 -> 18 65 19
    enc.emit_byte(?st.buf, OP_CLC);
    emit_zp1(?st, OP_ADC_ZP, mos6502.zp_addr(9));
    if (st.buf.data[4] != 0x18 || st.buf.data[5] != 0x65 || st.buf.data[6] != 0x19) { ret 1; }

    # SEC ; SBC #$01 -> 38 E9 01
    enc.emit_byte(?st.buf, OP_SEC);
    emit_imm1(?st, OP_SBC_IMM, 0x01);
    if (st.buf.data[7] != 0x38 || st.buf.data[8] != 0xE9 || st.buf.data[9] != 0x01) { ret 1; }

    # EOR #$FF -> 49 FF  (the complement idiom)
    emit_imm1(?st, OP_EOR_IMM, 0xFF);
    if (st.buf.data[10] != 0x49 || st.buf.data[11] != 0xFF) { ret 1; }

    # RTS -> 60
    enc.emit_byte(?st.buf, OP_RTS);
    if (st.buf.data[12] != 0x60) { ret 1; }

    # CMP #$0A -> C9 0A ; CMP $1D -> C5 1D
    emit_imm1(?st, OP_CMP_IMM, 0x0A);
    emit_zp1(?st, OP_CMP_ZP, mos6502.zp_addr(13));
    if (st.buf.data[13] != 0xC9 || st.buf.data[14] != 0x0A) { ret 1; }
    if (st.buf.data[15] != 0xC5 || st.buf.data[16] != 0x1D) { ret 1; }

    # the branch opcodes: BEQ F0, BNE D0, BCC 90, BCS B0.
    if (OP_BEQ != 0xF0 || OP_BNE != 0xD0 || OP_BCC != 0x90 || OP_BCS != 0xB0) { ret 1; }
    # JMP absolute is 4C.
    if (OP_JMP_ABS != 0x4C) { ret 1; }

    enc.buf_dnit(?st.buf);
    ret 0;
}

# encode one standalone `dst = a rel b` over zero-page value registers 8 / 9 -> 10 and
# report the bytes through `st` (test helper)
fun t_encode_cmp(st: *enc.EncodeState, op: mir.MirOpcode) R.Result[bool, str] {
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(8);
    ops[2] = mir.op_preg(9);
    var mi: mir.MirInstr;
    mi.opcode        = op;
    mi.operands      = ?ops[0];
    mi.operand_count = 3;
    mi.width         = 1;
    mi.src_width     = 1;
    ret encode_cmp(st, ?mi, op);
}

# whether the encoded range holds any pc-relative conditional-branch opcode
fun t_has_branch(st: *enc.EncodeState) bool {
    var i: usize = 0;
    for (i < st.buf.len) {
        val b: u8 = st.buf.data[i];
        if (b == OP_BEQ || b == OP_BNE || b == OP_BCC || b == OP_BCS) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a standalone compare encodes BRANCHLESS on every relation (#2158)
#
# The load-bearing property: a secret `==` reaches this encoder as an ordinary
# MIR_CMP_EQ, and NEITHER the `#[oblivious]` compile-time gate NOR the #1648 validator
# can see what happens here - both read pre-selection MIR - so materializing the 0 / 1
# boolean with a `BNE` over a `LDA #1` (2 cycles not-taken vs 3 taken) is a
# secret-dependent timing branch invisible to every other check. Each relation is pinned
# byte-exact against the published opcode matrix AND the encoded range is scanned for a
# conditional-branch opcode, so the invariant survives a rewrite of the sequence.
test "mach.lang.target.isa.mos6502.encode:compare_is_branchless" {
    var alloc: A.Allocator;
    page.make(?alloc);

    # a == b -> LDA $18 ; EOR $19 ; CMP #$01 ; LDA #$00 ; ROL A ; EOR #$01 ; STA $1A
    var eq: enc.EncodeState;
    eq.buf = enc.buf_init(?alloc);
    if (R.is_err[bool, str](t_encode_cmp(?eq, mir.MIR_CMP_EQ))) { ret 1; }
    if (eq.buf.len != 13)                                            { ret 1; }
    if (eq.buf.data[0]  != 0xA5 || eq.buf.data[1]  != 0x18)          { ret 1; }
    if (eq.buf.data[2]  != 0x45 || eq.buf.data[3]  != 0x19)          { ret 1; }
    if (eq.buf.data[4]  != 0xC9 || eq.buf.data[5]  != 0x01)          { ret 1; }
    if (eq.buf.data[6]  != 0xA9 || eq.buf.data[7]  != 0x00)          { ret 1; }
    if (eq.buf.data[8]  != 0x2A)                                     { ret 1; }
    if (eq.buf.data[9]  != 0x49 || eq.buf.data[10] != 0x01)          { ret 1; }
    if (eq.buf.data[11] != 0x85 || eq.buf.data[12] != 0x1A)          { ret 1; }
    if (t_has_branch(?eq)) { ret 1; }
    enc.buf_dnit(?eq.buf);

    # a != b -> the same carry read without the final complement.
    var ne: enc.EncodeState;
    ne.buf = enc.buf_init(?alloc);
    if (R.is_err[bool, str](t_encode_cmp(?ne, mir.MIR_CMP_NE))) { ret 1; }
    if (ne.buf.len != 11)                                            { ret 1; }
    if (ne.buf.data[0] != 0xA5 || ne.buf.data[1] != 0x18)            { ret 1; }
    if (ne.buf.data[2] != 0x45 || ne.buf.data[3] != 0x19)            { ret 1; }
    if (ne.buf.data[4] != 0xC9 || ne.buf.data[5] != 0x01)            { ret 1; }
    if (ne.buf.data[6] != 0xA9 || ne.buf.data[7] != 0x00)            { ret 1; }
    if (ne.buf.data[8] != 0x2A)                                      { ret 1; }
    if (ne.buf.data[9] != 0x85 || ne.buf.data[10] != 0x1A)           { ret 1; }
    if (t_has_branch(?ne)) { ret 1; }
    enc.buf_dnit(?ne.buf);

    # a <u b -> CMP straight into the carry, complemented (unchanged by #2158).
    var lt: enc.EncodeState;
    lt.buf = enc.buf_init(?alloc);
    if (R.is_err[bool, str](t_encode_cmp(?lt, mir.MIR_CMP_LT_U))) { ret 1; }
    if (lt.buf.len != 11)                                            { ret 1; }
    if (lt.buf.data[0] != 0xA5 || lt.buf.data[1] != 0x18)            { ret 1; }
    if (lt.buf.data[2] != 0xC5 || lt.buf.data[3] != 0x19)            { ret 1; }
    if (lt.buf.data[4] != 0xA9 || lt.buf.data[5] != 0x00)            { ret 1; }
    if (lt.buf.data[6] != 0x2A)                                      { ret 1; }
    if (lt.buf.data[7] != 0x49 || lt.buf.data[8] != 0x01)            { ret 1; }
    if (lt.buf.data[9] != 0x85 || lt.buf.data[10] != 0x1A)           { ret 1; }
    if (t_has_branch(?lt)) { ret 1; }
    enc.buf_dnit(?lt.buf);
    ret 0;
}

# execute an encoded compare sequence over a 256-byte zero page (test helper)
#
# A minimal 6502 core covering exactly the opcodes `encode_cmp` emits, with the REAL
# published flag semantics: `LDA` / `EOR` write N and Z but LEAVE CARRY ALONE, `CMP`
# writes N, Z and C, and `ROL A` reads C into bit 0 while taking C from bit 7. Modeling
# the flags honestly is the entire point. The sequence this replaced read as correct on
# the page - compare, then branch on the compare's flag - but its `LDA #$00` silently
# rewrote Z, so the branch tested a CONSTANT: every `==` answered 1 and every `!=`
# answered 0, for every input. An identity check over the intended algebra cannot see
# that; executing the bytes can.
# ---
# code:   the encoded bytes to execute
# n:      their length
# zp:     the 256-byte zero page (operands in, result out)
# cycles: receives the sequence's total cycle count
# ret:    true when every opcode was inside the pinned set
fun t_run_cmp(code: *u8, n: usize, zp: *u8, cycles: *u32) bool {
    var a:  u32 = 0;
    var c:  u32 = 0;
    var cy: u32 = 0;
    var i:  usize = 0;
    for (i < n) {
        val op:  u8    = code[i];
        val arg: usize = (i + 1);
        if (op == 0xA9)   { a = code[arg]::u32;                       cy = cy + 2; i = i + 2; }
        or (op == 0xA5)   { a = zp[code[arg]::usize]::u32;            cy = cy + 3; i = i + 2; }
        or (op == 0x49)   { a = a ^ code[arg]::u32;                   cy = cy + 2; i = i + 2; }
        or (op == 0x45)   { a = a ^ zp[code[arg]::usize]::u32;        cy = cy + 3; i = i + 2; }
        or (op == 0xC9)   { c = 0; if (a >= code[arg]::u32) { c = 1; }             cy = cy + 2; i = i + 2; }
        or (op == 0xC5)   { c = 0; if (a >= zp[code[arg]::usize]::u32) { c = 1; }  cy = cy + 3; i = i + 2; }
        or (op == 0x2A)   { val nc: u32 = (a >> 7) & 1; a = ((a << 1) | c) & 0xFF; c = nc; cy = cy + 2; i = i + 1; }
        or (op == 0x85)   { zp[code[arg]::usize] = (a & 0xFF)::u8;    cy = cy + 3; i = i + 2; }
        or { ret false; }
    }
    @cycles = cy;
    ret true;
}

# run one encoded relation over every ordered byte pair, checking the ANSWER and that the
# cycle count never varies with the operands (test helper)
# ---
# st:   the encode state holding the sequence to execute
# want: 0 for `==`, 1 for `!=`, 2 for `<u`
# ret:  0 when every pair answers correctly at one fixed cycle count
fun t_check_cmp(st: *enc.EncodeState, want: u32) i32 {
    var zp: [256]u8;
    var fixed: u32 = 0;
    var x: u32 = 0;
    for (x < 256) {
        var y: u32 = 0;
        for (y < 256) {
            var k: usize = 0;
            for (k < 256) { zp[k] = 0; k = k + 1; }
            zp[0x18] = (x & 0xFF)::u8;
            zp[0x19] = (y & 0xFF)::u8;

            var cy: u32 = 0;
            if (!t_run_cmp(st.buf.data, st.buf.len, ?zp[0], ?cy)) { ret 1; }

            var expect: u32 = 0;
            if (want == 0 && x == y) { expect = 1; }
            or (want == 1 && x != y) { expect = 1; }
            or (want == 2 && x <  y) { expect = 1; }
            if (zp[0x1A]::u32 != expect) { ret 1; }

            # the constant-time property, EXECUTED: one cycle count for all 65536 pairs.
            if (x == 0 && y == 0) { fixed = cy; }
            or (cy != fixed)      { ret 1; }
            y = y + 1;
        }
        x = x + 1;
    }
    ret 0;
}

# the encoded compare answers correctly and in a fixed number of cycles for every one of
# the 65536 ordered byte pairs, per relation (#2158)
#
# Executes the bytes `encode_cmp` actually produced under the published flag semantics,
# so this is a check of the MACHINE CODE, not of the algebra it was meant to implement.
# It is the guard that catches both halves of what the branch form got wrong: a
# data-dependent cycle count, and a compare whose answer never depended on its operands.
test "mach.lang.target.isa.mos6502.encode:compare_executes_constant_time" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var eq: enc.EncodeState;
    eq.buf = enc.buf_init(?alloc);
    if (R.is_err[bool, str](t_encode_cmp(?eq, mir.MIR_CMP_EQ))) { ret 1; }
    if (t_check_cmp(?eq, 0) != 0) { ret 1; }
    enc.buf_dnit(?eq.buf);

    var ne: enc.EncodeState;
    ne.buf = enc.buf_init(?alloc);
    if (R.is_err[bool, str](t_encode_cmp(?ne, mir.MIR_CMP_NE))) { ret 1; }
    if (t_check_cmp(?ne, 1) != 0) { ret 1; }
    enc.buf_dnit(?ne.buf);

    var lt: enc.EncodeState;
    lt.buf = enc.buf_init(?alloc);
    if (R.is_err[bool, str](t_encode_cmp(?lt, mir.MIR_CMP_LT_U))) { ret 1; }
    if (t_check_cmp(?lt, 2) != 0) { ret 1; }
    enc.buf_dnit(?lt.buf);
    ret 0;
}
