use std.types.canonical.res;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;


use mach.lang.target.of;
use rel: mach.lang.target.of.reloc;

pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) res[rel.RelocTraits, rel.RelocError] {
    if (kind != of.RK_ABS16) {
        ret res[rel.RelocTraits, rel.RelocError].err{rel.RELOC_UNSUPPORTED};
    }
    ret res[rel.RelocTraits, rel.RelocError].ok{rel.traits(2, rel.RELOC_ADDEND_SYMBOL, 0, 0)};
}

pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    target: rel.RelocTarget, addend: i64, patch_va: u64,
                    image_base: u64) res[bool, rel.RelocError] {
    if (kind == of.RK_ABS16) {
        ret rel.apply_abs16(dst, patch_off, sec_len, target.vaddr, addend);
    }
    ret res[bool, rel.RelocError].err{rel.RELOC_UNSUPPORTED};
}

test "mach.lang.target.isa.mos6502.reloc.catalog:admitted_kinds_are_exactly_the_applied_kinds" {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k: u32 = 0;
    for (k < of.RK_CATALOG_COUNT) {
        val kind: of.RelocKind = k::of.RelocKind;
        var i: usize = 0;
        for (i < 16) { dst[i] = 0; i = i + 1; }

        val tr: res[rel.RelocTraits, rel.RelocError] = reloc_traits(kind, of.SK_TEXT, true);
        val admitted: bool = sel tr.ok;
        if (sel tr.err) {
            if (tr.err != rel.RELOC_UNSUPPORTED) { bad = 1; brk; }
        }

        val ap: res[bool, rel.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (sel ap.err) {
            applied = ap.err != rel.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) { bad = 2; brk; }
        k = k + 1;
    }

    val past: of.RelocKind = 0xFF::of.RelocKind;
    val tr_past: res[rel.RelocTraits, rel.RelocError] = reloc_traits(past, of.SK_TEXT, true);
    if (!sel tr_past.err) { bad = 3; }
    or (sel tr_past.err) { if (tr_past.err != rel.RELOC_UNSUPPORTED) { bad = 3; } }
    val ap_past: res[bool, rel.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!sel ap_past.err) { bad = 4; }
    or (sel ap_past.err) { if (ap_past.err != rel.RELOC_UNSUPPORTED) { bad = 4; } }
    ret bad;
}

test "mach.lang.target.isa.mos6502.reloc.reloc_traits:abs16" {
    val tr: res[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_ABS16, of.SK_TEXT, true);
    if (sel tr.err) { ret 1; }
    val t: rel.RelocTraits = tr.ok;
    if (t.field_width != 2 || t.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.mos6502.reloc.reloc_traits:unsupported_kind_refused" {
    val bad: res[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_ABS64, of.SK_TEXT, true);
    if (!sel bad.err) { ret 1; }
    if (bad.err != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.mos6502.reloc.apply_reloc:abs16_boundary" {
    var dst: [4]u8;
    var i: usize = 0;
    for (i < 4) { dst[i] = 0; i = i + 1; }

    val r1: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS16, ?dst[0], 0, 4, rel.target(0x0600, 0, 0), 0, 0, 0);
    if (sel r1.err) { ret 1; }
    if (dst[0] != 0x00 || dst[1] != 0x06)   { ret 1; }

    val r2: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS16, ?dst[0], 0, 4, rel.target(0xFFFF, 0, 0), 0, 0, 0);
    if (sel r2.err) { ret 1; }
    if (dst[0] != 0xFF || dst[1] != 0xFF)   { ret 1; }

    val r3: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS16, ?dst[0], 0, 4, rel.target(0x10000, 0, 0), 0, 0, 0);
    if (!sel r3.err) { ret 1; }
    if (r3.err != rel.RELOC_OVERFLOW) { ret 1; }

    val r4: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS16, ?dst[0], 0, 4, rel.target(0xFFFF, 0, 0), 1, 0, 0);
    if (!sel r4.err) { ret 1; }

    val r5: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS16, ?dst[0], 3, 4, rel.target(0, 0, 0), 0, 0, 0);
    if (!sel r5.err) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.mos6502.reloc.apply_reloc:unsupported_kind" {
    var dst: [4]u8;
    var i: usize = 0;
    for (i < 4) { dst[i] = 0; i = i + 1; }

    val r: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS64, ?dst[0], 0, 4, rel.target(0x0600, 0, 0), 0, 0, 0);
    if (!sel r.err) { ret 1; }
    if (r.err != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}
