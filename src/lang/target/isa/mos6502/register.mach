use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use R: std.types.result;

use mach.lang.target.isa;
use mach.lang.target.isa.mos6502;
use mach.lang.target.isa.mos6502.encode;
use mach.lang.target.isa.mos6502.reloc;
use mach.lang.target.isa.mos6502.rules;
use mach.lang.be.codegen.mir;

fun mos6502_frame_dist(model: *isa.MachineModel, func: *mir.MirFunction, base_dist: *u32, fp_dist: *u32) {
    @base_dist = 0;
    @fp_dist   = 0;
}

pub fun register_mos6502(reg: *isa.IsaRegistry) R.Result[R.Void, str] {
    var mos6502_classes: [1]isa.RegClass;
    var mos6502_model:   isa.MachineModel;
    var mos6502_reserved_regs: [8]isa.Register;
    var mos6502_reload_scratch_regs: [3]isa.Register;

    mos6502_classes[0].name      = "gpr";
    mos6502_classes[0].kind      = isa.RC_GENERAL;
    mos6502_classes[0].len       = mos6502.GPR_COUNT::u32;

    mos6502_reserved_regs[0].id = mos6502.FP_LO;       mos6502_reserved_regs[0].size = 1;
    mos6502_reserved_regs[1].id = mos6502.FP_HI;       mos6502_reserved_regs[1].size = 1;
    mos6502_reserved_regs[2].id = mos6502.SP_LO;       mos6502_reserved_regs[2].size = 1;
    mos6502_reserved_regs[3].id = mos6502.SP_HI;       mos6502_reserved_regs[3].size = 1;
    mos6502_reserved_regs[4].id = mos6502.PTR_LO;      mos6502_reserved_regs[4].size = 1;
    mos6502_reserved_regs[5].id = mos6502.PTR_HI;      mos6502_reserved_regs[5].size = 1;
    mos6502_reserved_regs[6].id = mos6502.SCRATCH_REG; mos6502_reserved_regs[6].size = 1;
    mos6502_reserved_regs[7].id = mos6502.SCRATCH_REG2;mos6502_reserved_regs[7].size = 1;

    mos6502_reload_scratch_regs[0].id = mos6502.RELOAD0; mos6502_reload_scratch_regs[0].size = 1;
    mos6502_reload_scratch_regs[1].id = mos6502.RELOAD1; mos6502_reload_scratch_regs[1].size = 1;
    mos6502_reload_scratch_regs[2].id = mos6502.RELOAD2; mos6502_reload_scratch_regs[2].size = 1;

    var mos6502_machine: isa.RegMachine = isa.reg_machine(
        rules.select,
        encode.encode_mos6502,
        rules.is_reg_move,
        rules.is_trap_terminator,
        ?mos6502_reserved_regs[0], 8,
        ?mos6502_reload_scratch_regs[0], 3,
        mos6502.SCRATCH_REG, mos6502.SCRATCH_REG2,
        mos6502.FRAME_REG, mos6502.STACK_REG, 0,
        -1, -1, -1
    );
    isa.with_frame_dist(?mos6502_machine, mos6502_frame_dist);

    var mos6502_reloc: isa.RelocSeam = isa.reloc_seam(
        reloc.apply_reloc, reloc.reloc_traits, nil
    );

    var mos6502_vtable: isa.IsaVTable = isa.machine_isa(
        isa.ARCH_MOS6502, isa.arch_name_for(isa.ARCH_MOS6502), 0, 2,
        ?mos6502_model, ?mos6502_machine, ?mos6502_reloc
    );

    mos6502_model.pointer_width   = 2;
    mos6502_model.gpr_width       = 1;
    mos6502_model.max_alu_width   = 1;
    mos6502_model.alu_min_width   = 1;
    mos6502_model.spill_width     = 1;
    mos6502_model.endianness      = isa.ENDIAN_LITTLE;
    mos6502_model.flen_bits       = 0;
    mos6502_model.has_v128        = false;
    mos6502_model.vector_bits     = isa.VECTOR_BITS_128;
    mos6502_model.max_vector_lanes = isa.VECTOR_LANES_UNBOUNDED;
    mos6502_model.vec_mem_widths  = isa.VEC_MEM_NONE;
    mos6502_model.xbank_widths    = isa.XBANK_NONE;
    mos6502_model.vector_compute_generic = false;
    mos6502_model.ct_trust_mul = false;
    mos6502_model.has_var_shift = false;
    mos6502_model.ct_trust_var_shift = false;
    mos6502_model.has_mul = false;
    mos6502_model.has_float = mos6502.HAS_FLOAT;
    mos6502_model.mul_hi_width = 0;
    mos6502_model.flat_addressing = true;
    mos6502_model.index_width          = 16;
    mos6502_model.vector_op_bytes      = 16;
    mos6502_model.vectors_in_registers = true;
    mos6502_model.auto_vectorize       = true;

    mos6502_model.reg_classes     = ?mos6502_classes[0];
    mos6502_model.reg_class_len   = 1;
    mos6502_model.frame_ptr_reg   = mos6502.FRAME_REG;
    mos6502_model.stack_ptr_reg   = mos6502.STACK_REG;
    mos6502_model.reserved_regs   = ?mos6502_reserved_regs[0];
    mos6502_model.reserved_len    = 8;
    mos6502_model.div_reg         = -1;
    mos6502_model.div_hi_reg      = -1;
    mos6502_model.shift_count_reg = -1;

    mos6502_model.incoming_arg_base = 0;
    mos6502_model.stack_align       = 0;
    mos6502_model.red_zone          = 0;
    mos6502_model.shadow_space      = 0;

    ret isa.register(reg, ?mos6502_vtable);
}
