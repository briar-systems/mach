# the riscv selection strings, psABI variants and object attributes, resolved
# through the whole target registry
use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;

use A: std.allocator;

use lang_mir:    mach.lang.mir;
use lang_target: mach.lang.target;
use mach.lang.target.abi;
use mach.lang.target.binding;
use catalog_abi:     mach.lang.target.catalog.abi;
use catalog_arch:    mach.lang.target.catalog.arch;
use extension_riscv: mach.lang.target.extension.riscv;
use isa_inst:        mach.lang.target.isa.inst;
use target_model:    mach.lang.target.model;
use target_of:       mach.lang.target.of;
use mach.lang.target.of.elf;
use elf_riscv:      mach.lang.target.of.elf.riscv;
use target_testing: mach.lang.target.testing;

test select__riscv32_freestanding_raw {
    val reg: *lang_target.TargetRegistry = lang_target.t_registry();

    val res_target: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv32imafdc", "freestanding", "ilp32d");
    if (sel res_target.err) { ret 1; }
    val t: binding.Binding = res_target.ok;

    if (t.arch == nil)                         { ret 1; }
    if (t.isa.id != catalog_arch.RISCV32)      { ret 1; }
    if (elf.machine_for_arch(t.isa.id) != 243) { ret 1; }
    if (t.isa.pointer_width != 4)              { ret 1; }
    if (t.arch.select == nil)                  { ret 1; }
    if (t.arch.encode.encode_function == nil)  { ret 1; }

    if (t.target.model.pointer_width != 4)                { ret 1; }
    if (t.target.model.gpr_width != 4)                    { ret 1; }
    if (target_model.max_alu_width(?t.target.model) != 4) { ret 1; }
    if (t.target.model.spill_width != 4)                  { ret 1; }
    if (target_model.alu_min_width(?t.target.model) != 4) { ret 1; }
    if (t.target.model.flen_bits != 64)                   { ret 1; }

    if (t.target.model.reg_class_len != 2) { ret 1; }
    var gp_len: u32 = 0;
    var fp_len: u32 = 0;
    var ci:     u32 = 0;
    for (ci < t.target.model.reg_class_len) {
        if (t.target.model.reg_classes[ci].kind == target_model.RC_GENERAL) { gp_len = t.target.model.reg_classes[ci].len; }
        if (t.target.model.reg_classes[ci].kind == target_model.RC_FLOAT)   { fp_len = t.target.model.reg_classes[ci].len; }
        ci = ci + 1;
    }
    if (gp_len != 32)                                                             { ret 1; }
    if (fp_len != 30)                                                             { ret 1; }
    if (t.arch.frame_ptr_reg != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 8)) { ret 1; }
    if (t.arch.stack_ptr_reg != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)) { ret 1; }

    val res64: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "riscv64", "linux", "lp64d", "");
    if (sel res64.err) { ret 1; }
    val t64: binding.Binding = res64.ok;
    if (t64.target.model.gpr_width != 8) { ret 1; }
    if (t.target.model.gpr_width != 4)   { ret 1; }

    if (t.abi == nil)                    { ret 1; }
    if (t.abi.id != catalog_abi.ILP32D)  { ret 1; }
    if (t.abi.arg_slot_granularity != 4) { ret 1; }
    val ai: abi.ParamSlot = abi.arg_slot_for(t.abi, abi.arg_query(0, 4, 4, false, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (ai.class != abi.CLASS_GP)                                                         { ret 1; }
    if (lang_mir.preg_regid(ai.reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10)) { ret 1; }
    val af: abi.ParamSlot = abi.arg_slot_for(t.abi, abi.arg_query(0, 8, 8, true, 0, false, false, 0, 0, 0, 0, abi.agg_none(), 16));
    if (af.class != abi.CLASS_FP)                                                         { ret 1; }
    if (lang_mir.preg_regid(af.reg) != isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 10)) { ret 1; }

    if (t.of == nil)                         { ret 1; }
    if (!str_equals(t.os.default_of, "raw")) { ret 1; }

    val small_r: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv32imc", "freestanding", "ilp32");
    if (sel small_r.err) { ret 2; }
    val small: binding.Binding = small_r.ok;
    if (small.target.model.extensions != (extension_riscv.I | extension_riscv.M | extension_riscv.C)
        || small.target.model.has_float || small.target.model.flen_bits != 0 || small.target.model.reg_class_len != 1
        || !small.target.model.has_mul || extension_riscv.has(small.target.model.extensions, extension_riscv.A)) { ret 3; }
    val small_d: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv32imc", "freestanding", "ilp32d");
    if (sel small_d.ok)                                       { ret 4; }
    if (!str_contains(fail.describe(small_d.err), "rv32imc")) { ret 4; }
    val r_1522: res[binding.Binding, fail.Fail] = lang_target.select(reg, "riscv32", "freestanding", "ilp32f");
    if (sel r_1522.ok) { ret 5; }
    val default_r: res[binding.Binding, fail.Fail] = lang_target.select(reg, "riscv32", "freestanding", "ilp32");
    if (sel default_r.err)                                                 { ret 6; }
    if (default_r.ok.target.model.extensions != extension_riscv.DEFAULT32) { ret 7; }
    if (t.target.model.flen_bits != 64 || t.target.model.reg_class_len != 2
        || t.isa != small.isa || small.target.model.flen_bits != 0) { ret 8; }
    val f_r: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv64if", "freestanding", "lp64f");
    if (sel f_r.err) { ret 9; }
    val f_only: binding.Binding = f_r.ok;
    if (f_only.target.model.flen_bits != 32 || !f_only.target.model.has_float || f_only.target.model.has_mul) { ret 10; }
    val r_1532: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv64if", "freestanding", "lp64d");
    if (sel r_1532.ok) { ret 11; }
    val default64: res[binding.Binding, fail.Fail] = lang_target.select(reg, "riscv64", "linux", "lp64d");
    if (sel default64.err)                                                 { ret 12; }
    if (default64.ok.target.model.extensions != extension_riscv.DEFAULT64) { ret 12; }
    val r_1536: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv32e", "freestanding", "ilp32");
    if (sel r_1536.ok) { ret 13; }
    val r_1537: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv64iv", "linux", "lp64");
    if (sel r_1537.ok) { ret 13; }
    val r_1538: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv64i_zba", "linux", "lp64");
    if (sel r_1538.ok) { ret 13; }
    val compressed_flags: u32            = target_of.machine_flags(?elf.VTABLE, small.isa.id, 0, true);
    val r_1540:           err[fail.Fail] = target_of.attributes_validate(?elf.VTABLE, small.isa.id, small.target.model.gpr_width * 8, nil, 0, compressed_flags);
    if (sel r_1540.err) { ret 14; }
    # compressed code links into a target that does not select C: linking never asks for a capability
    val r_1541: err[fail.Fail] = target_of.attributes_validate(?elf.VTABLE, f_only.isa.id, f_only.target.model.gpr_width * 8, nil, 0, compressed_flags);
    if (sel r_1541.err) { ret 15; }
    ret 0;
}

#[testing]
rec RvMatrixRow {
    isa:  str;
    os:   str;
    abi:  str;
    exts: u64;
    flen: u32;
}

# one retained RISC-V tuple: the selection string, the model it narrows to, the
# ABI's float requirement and the emitted Tag_RISCV_arch must all say the same thing
#[testing]
fun t_rv_matrix_row(reg: *lang_target.TargetRegistry, alloc: *A.Allocator, row: *RvMatrixRow) i32 {
    val res_: res[binding.Binding, fail.Fail] = lang_target.select(reg, row.isa, row.os, row.abi);
    if (sel res_.err) { ret 1; }
    val t:      binding.Binding                           = res_.ok;
    val parsed: res[extension_riscv.Selection, fail.Fail] = extension_riscv.parse(row.isa);
    if (sel parsed.err) { ret 2; }
    val selection: extension_riscv.Selection = parsed.ok;
    if (selection.extensions != row.exts || t.target.model.extensions != row.exts)                      { ret 3; }
    if (t.target.model.gpr_width != selection.width || t.target.model.pointer_width != selection.width) { ret 4; }
    if (t.target.model.has_float != extension_riscv.has(row.exts, extension_riscv.F)
        || t.target.model.has_mul != extension_riscv.has(row.exts, extension_riscv.M)
        || t.target.model.flen_bits != row.flen) { ret 5; }
    val need: u64 = extension_riscv.float_requirement(t.abi.float_arg_bits);
    if (!extension_riscv.has(row.exts, need) || t.abi.float_arg_bits > t.target.model.flen_bits) { ret 6; }
    val has_c:      bool = extension_riscv.has(row.exts, extension_riscv.C);
    val flags:      u32  = target_of.machine_flags(?elf.VTABLE, t.isa.id, t.abi.float_arg_bits, has_c);
    var want_flags: u32  = elf_riscv.EF_FLOAT_ABI_SOFT;
    if (t.abi.float_arg_bits == 32) { want_flags = elf_riscv.EF_FLOAT_ABI_SINGLE; }
    if (t.abi.float_arg_bits == 64) { want_flags = elf_riscv.EF_FLOAT_ABI_DOUBLE; }
    if (has_c)                      { want_flags = want_flags | elf_riscv.EF_RVC; }
    if (flags != want_flags)        { ret 7; }
    var len:   u32                 = 0;
    val built: res[*u8, fail.Fail] = target_of.attributes_build(?elf.VTABLE, t.isa.id, alloc, t.target.model.gpr_width * 8,
        t.target.model.extensions, t.abi.float_arg_bits, has_c, ?len);
    if (sel built.err) { ret 8; }
    if (len == 0)      { ret 8; }
    val bytes:  *u8            = built.ok;
    var at:     elf_riscv.Attrs;
    val r_1582: err[fail.Fail] = elf_riscv.parse_body(bytes, len, ?at);
    if (sel r_1582.err)                      { ret 9; }
    if (!at.has_arch)                        { ret 9; }
    if (at.arch.xlen != selection.width * 8) { ret 10; }
    var ei:      usize = 0;
    var emitted: u32   = 0;
    for (ei < extension_riscv.EXT_COUNT) {
        val spec:    extension_riscv.ExtSpec = extension_riscv.EXTS[ei];
        var present: bool                    = false;
        var xi:      u32                     = 0;
        for (xi < at.arch.count) {
            val e: *elf_riscv.Ext = ?at.arch.exts[xi];
            if (extension_riscv.ext_index((?e.name[0])::str, e.name_len::usize) == ei) {
                present = true;
                if (e.major != spec.major || e.minor != spec.minor) { ret 11; }
            }
            xi = xi + 1;
        }
        val selected: bool = spec.emitted && extension_riscv.has(row.exts, spec.requires);
        if (present != selected) { ret 12; }
        if (present)             { emitted = emitted + 1; }
        ei = ei + 1;
    }
    if (emitted != at.arch.count) { ret 13; }
    val r_1605: err[fail.Fail] = target_of.attributes_validate(?elf.VTABLE, t.isa.id, t.target.model.gpr_width * 8, bytes, len, flags);
    if (sel r_1605.err) { ret 14; }
    ret 0;
}

#[testing]
fun t_rv_refused(reg: *lang_target.TargetRegistry, isa_name: str, os_name: str, abi_name: str, names: str) bool {
    val res_: res[binding.Binding, fail.Fail] = lang_target.select(reg, isa_name, os_name, abi_name);
    if (sel res_.ok) { ret false; }
    ret str_contains(fail.describe(res_.err), names);
}

test select__riscv_retained_matrix_agrees_on_selection_abi_and_attributes {
    val reg:    *lang_target.TargetRegistry = lang_target.t_registry();
    var alloc:  A.Allocator;
    val r_1620: err[A.Error]                = page.make(?alloc);
    if (sel r_1620.err) { ret 1; }

    val g:    u64             = extension_riscv.G;
    val rows: [13]RvMatrixRow = [13]RvMatrixRow{
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64d", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "rv64gc", os: "linux", abi: "lp64d", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64f", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "riscv64", os: "linux", abi: "lp64", exts: extension_riscv.DEFAULT64, flen: 64},
        RvMatrixRow{isa: "rv64imafd", os: "linux", abi: "lp64d", exts: g & ~extension_riscv.ZIFENCEI, flen: 64},
        RvMatrixRow{isa: "rv64imafc", os: "freestanding", abi: "lp64f", exts: extension_riscv.I | extension_riscv.M | extension_riscv.A | extension_riscv.F | extension_riscv.C | extension_riscv.ZICSR, flen: 32},
        RvMatrixRow{isa: "rv64if", os: "freestanding", abi: "lp64f", exts: extension_riscv.I | extension_riscv.F | extension_riscv.ZICSR, flen: 32},
        RvMatrixRow{isa: "rv64i", os: "freestanding", abi: "lp64", exts: extension_riscv.I, flen: 0},
        RvMatrixRow{isa: "riscv32", os: "freestanding", abi: "ilp32", exts: extension_riscv.DEFAULT32, flen: 0},
        RvMatrixRow{isa: "rv32imac", os: "freestanding", abi: "ilp32", exts: extension_riscv.DEFAULT32, flen: 0},
        RvMatrixRow{isa: "rv32imc", os: "freestanding", abi: "ilp32", exts: extension_riscv.I | extension_riscv.M | extension_riscv.C, flen: 0},
        RvMatrixRow{isa: "rv32imafdc", os: "freestanding", abi: "ilp32d", exts: (g & ~extension_riscv.ZIFENCEI) | extension_riscv.C, flen: 64},
        RvMatrixRow{isa: "rv32imafc", os: "freestanding", abi: "ilp32f", exts: extension_riscv.I | extension_riscv.M | extension_riscv.A | extension_riscv.F | extension_riscv.C | extension_riscv.ZICSR, flen: 32},
    };
    var i: usize = 0;
    for (i < 13) {
        val code: i32 = t_rv_matrix_row(reg, ?alloc, ?rows[i]);
        if (code != 0) { ret (i::i32 + 1) * 16 + code; }
        i = i + 1;
    }
    val rv32_d: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv32imafdc", "freestanding", "ilp32");
    val rv32_f: res[binding.Binding, fail.Fail] = lang_target.select(reg, "rv32imafdc", "freestanding", "ilp32f");
    if (sel rv32_d.err) { ret 2; }
    if (sel rv32_f.err) { ret 2; }

    # the ABI needs F or D the selection lacks: the letter and the selection are named
    if (!t_rv_refused(reg, "rv32imc", "freestanding", "ilp32d", "lacks the F and D extensions")
        || !t_rv_refused(reg, "rv32imc", "freestanding", "ilp32d", "'rv32imc'")) { ret 3; }
    if (!t_rv_refused(reg, "riscv32", "freestanding", "ilp32f", "lacks the F extension")
        || !t_rv_refused(reg, "riscv32", "freestanding", "ilp32f", "'riscv32'")) { ret 4; }
    if (!t_rv_refused(reg, "rv64if", "freestanding", "lp64d", "lacks the D extension")
        || !t_rv_refused(reg, "rv64if", "freestanding", "lp64d", "'rv64if'")) { ret 5; }
    if (!t_rv_refused(reg, "rv64i", "linux", "lp64f", "lacks the F extension")) { ret 6; }
    # the E base, an unknown extension, a noncanonical order, a version: token and string
    if (!t_rv_refused(reg, "rv32e", "freestanding", "ilp32", "E is unsupported")
        || !t_rv_refused(reg, "rv32e", "freestanding", "ilp32", "'rv32e'")) { ret 7; }
    if (!t_rv_refused(reg, "rv64iv", "linux", "lp64", "unknown or unavailable RISC-V extension: 'v' in selection 'rv64iv'"))            { ret 8; }
    if (!t_rv_refused(reg, "rv64i_zba", "linux", "lp64", "'zba' in selection 'rv64i_zba'"))                                             { ret 9; }
    if (!t_rv_refused(reg, "rv64icm", "linux", "lp64", "noncanonical RISC-V extension order: 'm' in selection 'rv64icm'"))              { ret 10; }
    if (!t_rv_refused(reg, "rv64imm", "linux", "lp64", "duplicate or noncanonical RISC-V extension order: 'm' in selection 'rv64imm'")) { ret 11; }
    if (!t_rv_refused(reg, "rv64i3p0", "linux", "lp64", "'3p0' in selection 'rv64i3p0'"))                                               { ret 12; }
    if (!t_rv_refused(reg, "rv64id", "linux", "lp64", "D extension requires F: selection 'rv64id'"))                                    { ret 13; }
    if (!t_rv_refused(reg, "rv64i_", "linux", "lp64", "trailing separator in RISC-V extension string: '_' in selection 'rv64i_'"))      { ret 14; }
    ret 0;
}

# a manifest list widens a selection string, closed over what each name implies
test resolve__extensions_widen_a_selection {
    val reg: *lang_target.TargetRegistry = lang_target.t_registry();

    var m:  [1]str                          = [1]str{"m"};
    val rv: res[binding.Binding, fail.Fail] = t_with_extensions(reg, "rv64i", "lp64", ?m[0], 1);
    if (sel rv.err)                                                               { ret 9; }
    if (rv.ok.target.model.extensions != (extension_riscv.I | extension_riscv.M)) { ret 10; }
    if (!rv.ok.target.model.has_mul)                                              { ret 11; }
    var d:   [1]str                          = [1]str{"d"};
    val rvd: res[binding.Binding, fail.Fail] = t_with_extensions(reg, "rv64i", "lp64d", ?d[0], 1);
    if (sel rvd.err)                                                                                                         { ret 12; }
    if (!extension_riscv.has(rvd.ok.target.model.extensions, extension_riscv.D | extension_riscv.F | extension_riscv.ZICSR)) { ret 12; }
    var fd:   [2]str                          = [2]str{"f", "d"};
    val rvfd: res[binding.Binding, fail.Fail] = t_with_extensions(reg, "rv64i", "lp64d", ?fd[0], 2);
    if (sel rvfd.err)                                                                                     { ret 13; }
    if (!extension_riscv.has(rvfd.ok.target.model.extensions, extension_riscv.D | extension_riscv.ZICSR)) { ret 13; }
    ret 0;
}

#[testing]
fun t_with_extensions(reg: *lang_target.TargetRegistry, isa_name: str, abi_name: str, names: *str, count: u32) res[binding.Binding, fail.Fail] {
    var req: lang_target.TargetRequest = lang_target.target_request(isa_name, "linux", abi_name);
    lang_target.with_extensions(?req, names, count);
    ret lang_target.resolve(reg, ?req);
}
