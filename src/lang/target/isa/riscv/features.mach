use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use R: std.types.result;

pub val I: u32 = 1;
pub val M: u32 = 2;
pub val A: u32 = 4;
pub val F: u32 = 8;
pub val D: u32 = 16;
pub val C: u32 = 32;
pub val ZICSR: u32 = 64;
pub val ZIFENCEI: u32 = 128;
pub val G: u32 = I | M | A | F | D | ZICSR | ZIFENCEI;
pub val DEFAULT32: u32 = I | M | A | C;
pub val DEFAULT64: u32 = G | C;
pub val ALL: u32 = DEFAULT64;

# the extensions a standard toolchain names in an object's Tag_RISCV_arch, and what
# a selection must hold for the object's use of one to be executable on the target.
# a ratified subset names its SUPERSET: zmmul is the multiply-only part of m, zaamo
# and zalrsc the two halves of a, zca/zcf/zcd the compressed encodings of c with f
# and d, so a toolchain that decomposes rv64gc into subsets admits against exactly
# the selection the undecomposed string admits against. the version is the revision
# mach models; an object naming another one is refused rather than assumed
# compatible. `emitted` rows are the ones mach writes into its own objects, in this
# order, when the selection holds them. adding an extension is one row here.
#
# this is the ADMISSION and EMISSION axis and is deliberately not `parse`'s table:
# parse reads a user's target selection, which is canonically ordered and may only
# name what the backend can generate, while an object's string is unordered and may
# name subsets no selection can spell.
pub rec ExtSpec {
    name:     str;
    requires: u32;
    major:    u32;
    minor:    u32;
    emitted:  bool;
}

pub val EXT_COUNT: usize = 14;

pub val EXTS: [EXT_COUNT]ExtSpec = [EXT_COUNT]ExtSpec{
    ExtSpec{ name: "i",        requires: I,        major: 2, minor: 1, emitted: true },
    ExtSpec{ name: "m",        requires: M,        major: 2, minor: 0, emitted: true },
    ExtSpec{ name: "a",        requires: A,        major: 2, minor: 1, emitted: true },
    ExtSpec{ name: "f",        requires: F,        major: 2, minor: 2, emitted: true },
    ExtSpec{ name: "d",        requires: D,        major: 2, minor: 2, emitted: true },
    ExtSpec{ name: "c",        requires: C,        major: 2, minor: 0, emitted: true },
    ExtSpec{ name: "zicsr",    requires: ZICSR,    major: 2, minor: 0, emitted: true },
    ExtSpec{ name: "zifencei", requires: ZIFENCEI, major: 2, minor: 0, emitted: true },
    ExtSpec{ name: "zmmul",    requires: M,        major: 1, minor: 0, emitted: false },
    ExtSpec{ name: "zaamo",    requires: A,        major: 1, minor: 0, emitted: false },
    ExtSpec{ name: "zalrsc",   requires: A,        major: 1, minor: 0, emitted: false },
    ExtSpec{ name: "zca",      requires: C,        major: 1, minor: 0, emitted: false },
    ExtSpec{ name: "zcf",      requires: C | F,    major: 1, minor: 0, emitted: false },
    ExtSpec{ name: "zcd",      requires: C | D,    major: 1, minor: 0, emitted: false },
};

# EXT_COUNT when the name is not one mach models
pub fun ext_index(name: str, len: usize) usize {
    var i: usize = 0;
    for (i < EXT_COUNT) {
        if (str_region_equals(name, 0, len, EXTS[i].name)) { ret i; }
        i = i + 1;
    }
    ret EXT_COUNT;
}

pub rec Selection {
    width: u32;
    extensions: u32;
}

pub fun has(bits: u32, required: u32) bool {
    ret (bits & required) == required;
}

pub fun valid(bits: u32) bool {
    if (!has(bits, I) || (bits & ~ALL) != 0) { ret false; }
    if (has(bits, D) && !has(bits, F)) { ret false; }
    if (has(bits, F) && !has(bits, ZICSR)) { ret false; }
    ret true;
}

pub fun is_name(name: str) bool {
    if (str_equals(name, "riscv32") || str_equals(name, "riscv64")) { ret true; }
    val len: usize = str_len(name);
    ret len >= 4 && (str_region_equals(name, 0, 4, "rv32")
        || str_region_equals(name, 0, 4, "rv64"));
}

fun version(name: str, len: usize, at: *usize, minor: u32) bool {
    if (@at == len || name[@at] < '0' || name[@at] > '9') { ret true; }
    if (name[@at] != '2') { ret false; }
    @at = @at + 1;
    if (@at == len || name[@at] != 'p') { ret minor == 0; }
    @at = @at + 1;
    if (@at == len || name[@at]::u32 != '0'::u32 + minor) { ret false; }
    @at = @at + 1;
    ret true;
}

# the token a refusal is about: its offset and length in the selection string,
# zero-length when the refusal is about the string as a whole
pub rec Span {
    at:  usize;
    len: usize;
}

pub fun parse(name: str) R.Result[Selection, str] {
    var bad: Span;
    ret parse_at(name, ?bad);
}

fun token_len(name: str, len: usize, at: usize) usize {
    var end: usize = at;
    for (end < len && name[end] != '_') { end = end + 1; }
    ret end - at;
}

fun refuse(bad: *Span, at: usize, len: usize, message: str) R.Result[Selection, str] {
    bad.at = at;
    bad.len = len;
    ret R.err[Selection, str](message);
}

pub fun parse_at(name: str, bad: *Span) R.Result[Selection, str] {
    bad.at = 0;
    bad.len = 0;
    if (str_equals(name, "riscv32")) {
        ret R.ok[Selection, str](Selection { width: 4, extensions: DEFAULT32 });
    }
    if (str_equals(name, "riscv64")) {
        ret R.ok[Selection, str](Selection { width: 8, extensions: DEFAULT64 });
    }
    val len: usize = str_len(name);
    if (!is_name(name) || len < 5) {
        ret refuse(bad, 0, 0, "target: expected an rv32 or rv64 I-base extension string");
    }
    var out: Selection;
    out.width = 4;
    if (name[2] == '6') { out.width = 8; }
    var at: usize = 5;
    var order: u32 = 0;
    if (name[4] == 'i') {
        out.extensions = I;
        if (!version(name, len, ?at, 1)) {
            ret refuse(bad, 5, token_len(name, len, 5), "target: unsupported RISC-V I extension version, expected 2p1");
        }
    } or (name[4] == 'g') {
        out.extensions = G;
        order = 4;
    } or {
        ret refuse(bad, 4, 1, "target: RISC-V selection requires the retained I base or G abbreviation, E is unsupported");
    }
    var multi: bool = false;
    for (at < len) {
        var separated: bool = false;
        if (name[at] == '_') { at = at + 1; separated = true; }
        if (at == len) { ret refuse(bad, at - 1, 1, "target: trailing separator in RISC-V extension string"); }
        val start: usize = at;
        var bit: u32 = 0;
        var next: u32 = 0;
        var minor: u32 = 0;
        if (name[at] == 'm') { bit = M; next = 1; }
        or (name[at] == 'a') { bit = A; next = 2; minor = 1; }
        or (name[at] == 'f') { bit = F; next = 3; minor = 2; }
        or (name[at] == 'd') { bit = D; next = 4; minor = 2; }
        or (name[at] == 'c') { bit = C; next = 5; }
        or (name[at] == 'z' && separated) {
            multi = true;
            if (at + 5 <= len && str_region_equals(name, at, 5, "zicsr")) {
                bit = ZICSR; next = 6; at = at + 4;
            } or (at + 8 <= len && str_region_equals(name, at, 8, "zifencei")) {
                bit = ZIFENCEI; next = 7; at = at + 7;
            }
        }
        if (bit == 0) {
            ret refuse(bad, start, token_len(name, len, start), "target: unknown or unavailable RISC-V extension");
        }
        if (next <= order || (multi && next < 6) || has(out.extensions, bit)) {
            ret refuse(bad, start, at + 1 - start, "target: duplicate or noncanonical RISC-V extension order");
        }
        order = next;
        at = at + 1;
        if (!version(name, len, ?at, minor)) {
            ret refuse(bad, start, token_len(name, len, start), "target: unsupported RISC-V extension version");
        }
        out.extensions = out.extensions | bit;
    }
    if (has(out.extensions, D) && !has(out.extensions, F)) {
        ret refuse(bad, 0, 0, "target: RISC-V D extension requires F");
    }
    if (has(out.extensions, F)) { out.extensions = out.extensions | ZICSR; }
    ret R.ok[Selection, str](out);
}

# the extension letters a mask holds, in canonical order, for diagnostics
pub fun letters(bits: u32) str {
    if (bits == F) { ret "F"; }
    if (bits == D) { ret "D"; }
    if (bits == (F | D)) { ret "F and D"; }
    if (bits == M) { ret "M"; }
    if (bits == A) { ret "A"; }
    if (bits == C) { ret "C"; }
    if (bits == ZICSR) { ret "Zicsr"; }
    if (bits == ZIFENCEI) { ret "Zifencei"; }
    ret "";
}

# the extension a floating-point width needs: F for 32-bit values, F and D for 64
pub fun float_requirement(bits: u32) u32 {
    if (bits == 32) { ret F; }
    if (bits == 64) { ret F | D; }
    ret 0;
}

test "mach.lang.target.isa.riscv.features.parse:canonical_selection_and_refusal" {
    val small: R.Result[Selection, str] = parse("rv32imc");
    if (R.is_err[Selection, str](small)) { ret 1; }
    val s: Selection = R.unwrap_ok[Selection, str](small);
    if (s.width != 4 || s.extensions != (I | M | C)) { ret 2; }
    val r32: R.Result[Selection, str] = parse("riscv32");
    val r64: R.Result[Selection, str] = parse("riscv64");
    val g64: R.Result[Selection, str] = parse("rv64gc");
    val v64: R.Result[Selection, str] = parse("rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0");
    if (R.is_err[Selection, str](r32) || R.is_err[Selection, str](r64)
        || R.is_err[Selection, str](g64) || R.is_err[Selection, str](v64)) { ret 3; }
    if (R.unwrap_ok[Selection, str](r32).extensions != DEFAULT32
        || R.unwrap_ok[Selection, str](r64).extensions != DEFAULT64
        || R.unwrap_ok[Selection, str](g64).extensions != DEFAULT64
        || R.unwrap_ok[Selection, str](v64).extensions != DEFAULT64) { ret 4; }
    val rejected: [12]str = [12]str { "rv32e", "rv64", "rv64id", "rv64imm",
        "rv64icm", "rv64iv", "rv64i_zba", "rv64i3p0", "rv64im2p1", "rv64i_",
        "rv64i_zicsr_zicsr", "rv64i_zifencei_zicsr" };
    var i: usize = 0;
    for (i < 12) {
        if (R.is_ok[Selection, str](parse(rejected[i]))) { ret 5; }
        i = i + 1;
    }
    var bad: Span;
    if (R.is_ok[Selection, str](parse_at("rv64iv", ?bad)) || bad.at != 5 || bad.len != 1) { ret 6; }
    if (R.is_ok[Selection, str](parse_at("rv64i_zba", ?bad)) || bad.at != 6 || bad.len != 3) { ret 7; }
    if (R.is_ok[Selection, str](parse_at("rv64icm", ?bad)) || bad.at != 6 || bad.len != 1) { ret 8; }
    if (R.is_ok[Selection, str](parse_at("rv64imm", ?bad)) || bad.at != 6 || bad.len != 1) { ret 9; }
    if (R.is_ok[Selection, str](parse_at("rv32e", ?bad)) || bad.at != 4 || bad.len != 1) { ret 10; }
    if (R.is_ok[Selection, str](parse_at("rv64im2p1", ?bad)) || bad.at != 5 || bad.len != 4) { ret 11; }
    if (R.is_ok[Selection, str](parse_at("rv64i3p0", ?bad)) || bad.at != 5 || bad.len != 3) { ret 12; }
    if (R.is_ok[Selection, str](parse_at("rv64id", ?bad)) || bad.len != 0) { ret 13; }
    if (R.is_ok[Selection, str](parse_at("rv64i_", ?bad)) || bad.at != 5 || bad.len != 1) { ret 14; }
    if (R.is_err[Selection, str](parse_at("rv32imafdc", ?bad)) || bad.len != 0) { ret 15; }
    if (!str_equals(letters(F), "F") || !str_equals(letters(F | D), "F and D") || !str_equals(letters(D), "D")
        || !str_equals(letters(0), "") || float_requirement(32) != F || float_requirement(64) != (F | D)
        || float_requirement(0) != 0) { ret 16; }
    ret 0;
}
