# what each riscv instruction reads, writes and leaks, for the constant-time checks
use std.types.bool.bool;
use std.types.size.usize;

use mach.lang.ct;
use isa_effect: mach.lang.target.isa.effect;
use isa_inst:   mach.lang.target.isa.inst;
use isa_riscv:  mach.lang.target.isa.riscv;
use riscv_emit: mach.lang.target.isa.riscv.emit;
use mach.lang.target.isa.riscv.inst;
use riscv_mnemonic: mach.lang.target.isa.riscv.mnemonic;

pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code == inst.DIV::u32 || code == inst.DIVU::u32 || code == inst.DIVW::u32 ||
        code == inst.DIVUW::u32 || code == inst.REM::u32 || code == inst.REMU::u32 ||
        code == inst.REMW::u32 || code == inst.REMUW::u32) {
        ret ct.asm_op(ct.CT_OP_INT_DIVMOD);
    }
    if (code == inst.MUL::u32)    { ret ct.asm_mul(ct.CT_MUL_LOW); }
    if (code == inst.MULH::u32)   { ret ct.asm_mul(ct.CT_MUL_HIGH_S); }
    if (code == inst.MULHU::u32)  { ret ct.asm_mul(ct.CT_MUL_HIGH_U); }
    if (code == inst.MULHSU::u32) { ret ct.asm_mul(ct.CT_MUL_HIGH_SU); }
    if (code == inst.MULW::u32)   { ret ct.asm_mul_width(ct.CT_MUL_LOW, 32); }
    if (code == inst.SLL::u32 || code == inst.SRL::u32 || code == inst.SRA::u32 ||
        code == inst.SLLW::u32 || code == inst.SRLW::u32 || code == inst.SRAW::u32) {
        ret ct.asm_op(ct.CT_OP_VAR_SHIFT);
    }
    if (code == inst.SLLI::u32 || code == inst.SRLI::u32 || code == inst.SRAI::u32 ||
        code == inst.SLLIW::u32 || code == inst.SRLIW::u32 || code == inst.SRAIW::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.ADD::u32 || code == inst.ADDI::u32 || code == inst.ADDW::u32 ||
        code == inst.ADDIW::u32 || code == inst.SUB::u32 || code == inst.SUBW::u32 ||
        code == inst.AND::u32 || code == inst.ANDI::u32 || code == inst.OR::u32 ||
        code == inst.ORI::u32 || code == inst.XOR::u32 || code == inst.XORI::u32 ||
        code == inst.SLT::u32 || code == inst.SLTU::u32 || code == inst.SLTI::u32 ||
        code == inst.SLTIU::u32 || code == inst.LUI::u32 || code == inst.AUIPC::u32 ||
        code == inst.CZERO_EQZ::u32 || code == inst.CZERO_NEZ::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.LB::u32 || code == inst.LBU::u32 || code == inst.LH::u32 ||
        code == inst.LHU::u32 || code == inst.LW::u32 || code == inst.LWU::u32 ||
        code == inst.LD::u32 || code == inst.SB::u32 || code == inst.SH::u32 ||
        code == inst.SW::u32 || code == inst.SD::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.LR_W::u32 || code == inst.LR_D::u32 ||
        code == inst.SC_W::u32 || code == inst.SC_D::u32 ||
        code == inst.AMOSWAP_W::u32 || code == inst.AMOSWAP_D::u32 ||
        code == inst.AMOADD_W::u32 || code == inst.AMOADD_D::u32 ||
        code == inst.AMOXOR_W::u32 || code == inst.AMOXOR_D::u32 ||
        code == inst.AMOAND_W::u32 || code == inst.AMOAND_D::u32 ||
        code == inst.AMOOR_W::u32 || code == inst.AMOOR_D::u32 ||
        code == inst.AMOMIN_W::u32 || code == inst.AMOMIN_D::u32 ||
        code == inst.AMOMAX_W::u32 || code == inst.AMOMAX_D::u32 ||
        code == inst.AMOMINU_W::u32 || code == inst.AMOMINU_D::u32 ||
        code == inst.AMOMAXU_W::u32 || code == inst.AMOMAXU_D::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }

    if (code == inst.FENCE::u32 || code == inst.PAUSE::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.JAL::u32 ||
        code == inst.ECALL::u32 || code == inst.EBREAK::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.CSRRW::u32 || code == inst.CSRRS::u32 || code == inst.CSRRC::u32 ||
        code == inst.CSRRWI::u32 || code == inst.CSRRSI::u32 || code == inst.CSRRCI::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.BEQ::u32 || code == inst.BNE::u32 || code == inst.BLT::u32 ||
        code == inst.BGE::u32 || code == inst.BLTU::u32 || code == inst.BGEU::u32 ||
        code == inst.JALR::u32) {
        ret ct.asm_branch_reg();
    }

    # rows for the opcodes the encoder emits that the inline-asm grammar has
    # no spelling for: the F, D, Zfhmin and Zfh sets. loads, stores, bit moves and the
    # sign-copy move are data movement; arithmetic, compares, the negating
    # and absolute sign injections (MIR_FNEG is float-classed) and every
    # conversion are floating-point operations
    if (code == inst.FLW::u32 || code == inst.FLD::u32 || code == inst.FSW::u32 || code == inst.FSD::u32 ||
        code == inst.FMV_X_W::u32 || code == inst.FMV_X_D::u32 || code == inst.FMV_W_X::u32 || code == inst.FMV_D_X::u32 ||
        code == inst.FSGNJ_S::u32 || code == inst.FSGNJ_D::u32 ||
        code == inst.FLH::u32 || code == inst.FSH::u32 || code == inst.FMV_X_H::u32 || code == inst.FMV_H_X::u32 ||
        code == inst.FSGNJ_H::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.FADD_S::u32 || code == inst.FADD_D::u32 || code == inst.FSUB_S::u32 || code == inst.FSUB_D::u32 ||
        code == inst.FMUL_S::u32 || code == inst.FMUL_D::u32 || code == inst.FDIV_S::u32 || code == inst.FDIV_D::u32 ||
        code == inst.FSGNJN_S::u32 || code == inst.FSGNJN_D::u32 || code == inst.FSGNJX_S::u32 || code == inst.FSGNJX_D::u32 ||
        code == inst.FEQ_S::u32 || code == inst.FEQ_D::u32 || code == inst.FLT_S::u32 || code == inst.FLT_D::u32 ||
        code == inst.FLE_S::u32 || code == inst.FLE_D::u32 ||
        code == inst.FCVT_S_D::u32 || code == inst.FCVT_D_S::u32 ||
        code == inst.FCVT_W_S::u32 || code == inst.FCVT_WU_S::u32 || code == inst.FCVT_L_S::u32 || code == inst.FCVT_LU_S::u32 ||
        code == inst.FCVT_W_D::u32 || code == inst.FCVT_WU_D::u32 || code == inst.FCVT_L_D::u32 || code == inst.FCVT_LU_D::u32 ||
        code == inst.FCVT_S_W::u32 || code == inst.FCVT_S_WU::u32 || code == inst.FCVT_S_L::u32 || code == inst.FCVT_S_LU::u32 ||
        code == inst.FCVT_D_W::u32 || code == inst.FCVT_D_WU::u32 || code == inst.FCVT_D_L::u32 || code == inst.FCVT_D_LU::u32 ||
        code == inst.FADD_H::u32 || code == inst.FSUB_H::u32 || code == inst.FMUL_H::u32 || code == inst.FDIV_H::u32 ||
        code == inst.FSGNJN_H::u32 || code == inst.FEQ_H::u32 || code == inst.FLT_H::u32 || code == inst.FLE_H::u32 ||
        code == inst.FCVT_S_H::u32 || code == inst.FCVT_H_S::u32 || code == inst.FCVT_D_H::u32 || code == inst.FCVT_H_D::u32 ||
        code == inst.FCVT_W_H::u32 || code == inst.FCVT_WU_H::u32 || code == inst.FCVT_L_H::u32 || code == inst.FCVT_LU_H::u32 ||
        code == inst.FCVT_H_W::u32 || code == inst.FCVT_H_WU::u32 || code == inst.FCVT_H_L::u32 || code == inst.FCVT_H_LU::u32) {
        ret ct.asm_op(ct.CT_OP_FLOAT);
    }
    ret ct.asm_unknown();
}

fun grammar_implicit(code: u32) u32 {
    var i: usize = 0;
    for (i < riscv_mnemonic.MNEMONIC_COUNT) {
        if (riscv_mnemonic.MNEMONICS[i].code == code) { ret riscv_mnemonic.MNEMONICS[i].implicit; }
        i = i + 1;
    }
    ret 0;
}

fun target(mi: *isa_inst.Inst, t: *isa_inst.Operand, e: *isa_effect.InstEffects) {
    if (t.kind == isa_inst.OPK_SYM) {
        e.target = isa_effect.TARGET_EXTERNAL;
        ret;
    }
    if (t.kind == isa_inst.OPK_LABEL) {
        if ((mi.flags & (inst.FLAG_LABEL_SKIP | inst.FLAG_LABEL_LOCAL)) == 0 && isa_inst.label_is_block(t)) {
            e.target       = isa_effect.TARGET_BLOCK;
            e.target_block = t.imm::u32;
            ret;
        }
        # a skip lies ahead by construction; a numbered label says which way it lies
        e.target = isa_effect.TARGET_LOCAL;
        if ((mi.flags & inst.FLAG_LABEL_SKIP) != 0 && t.imm > 0) {
            e.target     = isa_effect.TARGET_LOCAL_FWD;
            e.local_disp = t.imm::i32;
        }
        if ((mi.flags & inst.FLAG_LABEL_LOCAL) != 0 && (mi.flags & inst.FLAG_LABEL_FWD) != 0) { e.target = isa_effect.TARGET_LOCAL_FWD; }
        ret;
    }
    e.target = isa_effect.TARGET_LOCAL;
}

# the effect description of one emitted riscv64 instruction: the closed class
# row plus the operand roles of the notification shape (build_inst) and the
# implicit effects. x0 is never written; the walk holds it constant
pub fun inst_effects(mi: *isa_inst.Inst, e: *isa_effect.InstEffects) {
    @e = isa_effect.inst_effects_unknown();
    val op: inst.MachOp = mi.opcode::inst.MachOp;
    if (op == inst.MOP_NONE || op > inst.MOP_LAST) { ret; }
    e.cls = asm_ct_class(op::u32, 0);
    val shape: u8 = inst.shape_of(op);

    if (op == inst.JALR) {
        # the target register rides in the load-shaped memory operand; it is
        # read as a value, never as an address
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_ADDR;
        e.target   = isa_effect.TARGET_REGISTER;
        e.xfer     = isa_effect.XFER_JUMP;
        val rd: i32 = gp_index(?mi.dst);
        val rs: i32 = gp_index(?mi.src1);
        if (rd == isa_riscv.RA)                                              { e.xfer = isa_effect.XFER_CALL; }
        or (rd == isa_riscv.ZERO && rs == isa_riscv.RA && mi.src1.disp == 0) { e.xfer = isa_effect.XFER_RET; }
        or ((mi.flags & inst.FLAG_TARGET_BLOCK) != 0) {
            # a relaxation trampoline: auipc t0 then jalr through t0 to a known block
            e.target       = isa_effect.TARGET_BLOCK;
            e.target_block = mi.src1.imm::u32;
        }
        ret;
    }
    if (op == inst.JAL) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.xfer     = isa_effect.XFER_JUMP;
        if (mi.dst.kind == isa_inst.OPK_REG && isa_inst.regid_index(mi.dst.reg) == isa_riscv.RA) { e.xfer = isa_effect.XFER_CALL; }
        target(mi, ?mi.src1, e);
        ret;
    }
    if (shape == inst.SH_BRANCH) {
        e.roles[0] = isa_effect.ROLE_READ;
        e.roles[1] = isa_effect.ROLE_READ;
        e.xfer     = isa_effect.XFER_BRANCH;
        target(mi, ?mi.src2, e);
        ret;
    }
    if (op == inst.EBREAK) {
        e.xfer = isa_effect.XFER_TRAP;
        ret;
    }
    if (op == inst.ECALL) {
        val implicit: u64 = grammar_implicit(op::u32)::u64;
        e.implicit_reads  = implicit;
        e.implicit_writes = implicit;
        ret;
    }
    if (shape == inst.SH_NONE) { ret; }
    if (shape == inst.SH_STORE || shape == inst.SH_FSTORE) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_READ;
        ret;
    }
    if (shape == inst.SH_AMO) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_READ;
        e.roles[2] = isa_effect.ROLE_RW;
        if (op == inst.SC_W || op == inst.SC_D) { e.roles[2] = isa_effect.ROLE_WRITE; }
        ret;
    }
    if (shape == inst.SH_CSR) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[2] = isa_effect.ROLE_READ;
        ret;
    }
    if (shape == inst.SH_CSR_I) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        ret;
    }
    if (op == inst.SLL || op == inst.SRL || op == inst.SRA || op == inst.SLLW || op == inst.SRLW || op == inst.SRAW) {
        e.count_pos = 2;
    }
    # every remaining shape defines rd from its sources (RRR, RRI, RU, loads, the F and D forms)
    e.roles[0] = isa_effect.ROLE_WRITE;
    if (value_operand(?mi.src1)) { e.roles[1] = isa_effect.ROLE_READ; }
    if (value_operand(?mi.src2)) { e.roles[2] = isa_effect.ROLE_READ; }
}

fun gp_index(op: *isa_inst.Operand) i32 {
    if (op.kind == isa_inst.OPK_REG) { ret isa_inst.regid_index(op.reg); }
    if (op.kind == isa_inst.OPK_MEM) { ret isa_inst.regid_index(op.base); }
    ret -1;
}

fun value_operand(op: *isa_inst.Operand) bool {
    ret op.kind == isa_inst.OPK_REG || op.kind == isa_inst.OPK_MEM;
}

test asm_ct_class__m_extension_is_variable_latency {
    var bad: i32 = 0;

    if (asm_ct_class(inst.DIV::u32, 0).op != ct.CT_OP_INT_DIVMOD)     { bad = 1; }
    if (asm_ct_class(inst.DIVU::u32, 0).op != ct.CT_OP_INT_DIVMOD)    { bad = 1; }
    if (asm_ct_class(inst.DIVW::u32, 0).op != ct.CT_OP_INT_DIVMOD)    { bad = 1; }
    if (asm_ct_class(inst.DIVUW::u32, 0).op != ct.CT_OP_INT_DIVMOD)   { bad = 1; }
    if (asm_ct_class(inst.REM::u32, 0).op != ct.CT_OP_INT_DIVMOD)     { bad = 1; }
    if (asm_ct_class(inst.REMU::u32, 0).op != ct.CT_OP_INT_DIVMOD)    { bad = 1; }
    if (asm_ct_class(inst.REMW::u32, 0).op != ct.CT_OP_INT_DIVMOD)    { bad = 1; }
    if (asm_ct_class(inst.REMUW::u32, 0).op != ct.CT_OP_INT_DIVMOD)   { bad = 1; }
    if (ct.ct_cap_or_always(ct.CT_OP_INT_DIVMOD) != ct.CT_CAP_ALWAYS) { bad = 1; }

    if (asm_ct_class(inst.MUL::u32, 0).op != ct.CT_OP_INT_MUL)    { bad = 1; }
    if (asm_ct_class(inst.MULH::u32, 0).op != ct.CT_OP_INT_MUL)   { bad = 1; }
    if (asm_ct_class(inst.MULHSU::u32, 0).op != ct.CT_OP_INT_MUL) { bad = 1; }
    if (asm_ct_class(inst.MULHU::u32, 0).op != ct.CT_OP_INT_MUL)  { bad = 1; }
    if (asm_ct_class(inst.MULW::u32, 0).op != ct.CT_OP_INT_MUL)   { bad = 1; }
    if (ct.ct_cap_or_always(ct.CT_OP_INT_MUL) != ct.CT_CAP_MUL)   { bad = 1; }

    if (asm_ct_class(inst.SLL::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(inst.SRA::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(inst.SLLI::u32, 0).op != ct.CT_OP_NONE)     { bad = 1; }
    if (asm_ct_class(inst.SRAI::u32, 0).op != ct.CT_OP_NONE)     { bad = 1; }

    if (!asm_ct_class(inst.BEQ::u32, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(inst.JALR::u32, 0).cond_reg) { bad = 1; }

    var fi: usize = 0;
    for (fi < riscv_mnemonic.MNEMONIC_COUNT) {
        val fc: ct.AsmClass = asm_ct_class(riscv_mnemonic.MNEMONICS[fi].code, riscv_mnemonic.MNEMONICS[fi].flags);
        if (fc.cond_flags || fc.reads_flags || fc.defines_flags || fc.opaque_flags) { bad = 1; }
        fi = fi + 1;
    }
    ret bad;
}

# the census the walk depends on: every machine opcode a notification can
# carry (the whole MachOp space) has a row in the closed table
test asm_ct_class__every_notifiable_opcode_has_a_row {
    var missing: u32         = 0;
    var op:      inst.MachOp = 1;
    for (op <= inst.MOP_LAST) {
        val cls: ct.AsmClass = asm_ct_class(op::u32, 0);
        if (!cls.known) { missing = missing + 1; }
        op = op + 1;
    }
    if (asm_ct_class(inst.MOP_NONE::u32, 0).known)       { ret 2; }
    if (asm_ct_class((inst.MOP_LAST + 1)::u32, 0).known) { ret 3; }
    if (missing != 0)                                    { ret 1; }
    ret 0;
}

test inst_effects__roles_follow_the_notification_shape {
    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = riscv_emit.build_inst(inst.BNE, 0, 5, 0, 0);
    mi.src2 = isa_inst.make_block_label(2);
    inst_effects(?mi, ?e);
    if (!e.cls.cond_reg || e.roles[0] != isa_effect.ROLE_READ || e.roles[1] != isa_effect.ROLE_READ)    { ret 1; }
    if (e.xfer != isa_effect.XFER_BRANCH || e.target != isa_effect.TARGET_BLOCK || e.target_block != 2) { ret 2; }

    mi          = riscv_emit.build_inst(inst.BNE, 0, 5, 0, 0);
    mi.src2     = isa_inst.make_block_label(0);
    mi.src2.imm = 8;
    mi.flags    = inst.FLAG_LABEL_SKIP;
    inst_effects(?mi, ?e);
    if (e.target != isa_effect.TARGET_LOCAL_FWD || e.local_disp != 8) { ret 3; }
    mi.flags = inst.FLAG_LABEL_LOCAL;
    inst_effects(?mi, ?e);
    if (e.target != isa_effect.TARGET_LOCAL) { ret 17; }

    mi = riscv_emit.build_inst(inst.SD, 0, 8, 10, -16);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ || mi.dst.kind != isa_inst.OPK_MEM) { ret 4; }

    mi = riscv_emit.build_inst(inst.LD, 10, 8, 0, -16);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ || mi.src1.kind != isa_inst.OPK_MEM) { ret 5; }

    mi = riscv_emit.build_inst(inst.DIVU, 10, 11, 12, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_INT_DIVMOD || e.roles[0] != isa_effect.ROLE_WRITE || e.roles[2] != isa_effect.ROLE_READ) { ret 6; }

    mi = riscv_emit.build_inst(inst.MULHU, 10, 11, 12, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_INT_MUL) { ret 7; }

    mi = riscv_emit.build_inst(inst.SLL, 10, 11, 12, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_VAR_SHIFT || e.count_pos != 2) { ret 8; }

    mi          = riscv_emit.build_inst(inst.JALR, riscv_emit.RZERO, riscv_emit.SCRATCH, 0, 0);
    mi.flags    = inst.FLAG_TARGET_BLOCK;
    mi.src1.imm = 5;
    inst_effects(?mi, ?e);
    if (!e.cls.cond_reg || e.roles[1] != isa_effect.ROLE_ADDR || e.xfer != isa_effect.XFER_JUMP || e.target != isa_effect.TARGET_BLOCK || e.target_block != 5) { ret 9; }

    mi = riscv_emit.build_inst(inst.JALR, riscv_emit.RZERO, isa_riscv.RA::u32, 0, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_RET || e.target != isa_effect.TARGET_REGISTER || e.roles[1] != isa_effect.ROLE_ADDR) { ret 16; }

    mi = riscv_emit.build_inst(inst.JALR, isa_riscv.RA::u32, 10, 0, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_CALL) { ret 10; }

    mi      = riscv_emit.build_inst(inst.JAL, isa_riscv.RA::u32, 0, 0, 0);
    mi.src1 = isa_inst.make_sym(3, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_CALL || e.target != isa_effect.TARGET_EXTERNAL || e.roles[0] != isa_effect.ROLE_WRITE) { ret 11; }

    mi = riscv_emit.build_inst(inst.AUIPC, riscv_emit.SCRATCH, 0, 0, 0);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_NONE || e.cls.op != ct.CT_OP_NONE) { ret 12; }

    mi = riscv_emit.build_inst(inst.FCVT_L_D, 10, 0, 0, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_FLOAT || e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ) { ret 13; }

    mi = riscv_emit.build_inst(inst.EBREAK, 0, 0, 0, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_TRAP) { ret 14; }

    mi        = isa_inst.inst_blank();
    mi.opcode = inst.MOP_NONE::u16;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 15; }
    ret 0;
}
