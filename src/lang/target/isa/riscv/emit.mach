use isa_riscv:       mach.lang.target.isa.riscv;
use mach.lang.target.isa.riscv.inst;
use target_model: mach.lang.target.model;
use target_of:    mach.lang.target.of;

# the encoding vocabulary is the table's (inst.mach); these are the local
# spellings the field-passing emit sites use until they emit by opcode
pub val OPC_OP: u32 = inst.OPC_OP;

pub val OPC_OP_IMM: u32 = inst.OPC_OP_IMM;

pub val OPC_OP_32: u32 = inst.OPC_OP_32;

pub val OPC_OP_IMM_32: u32 = inst.OPC_OP_IMM_32;

pub val OPC_LOAD: u32 = inst.OPC_LOAD;

pub val OPC_STORE: u32 = inst.OPC_STORE;

pub val OPC_BRANCH: u32 = inst.OPC_BRANCH;

pub val OPC_JAL: u32 = inst.OPC_JAL;

pub val OPC_JALR: u32 = inst.OPC_JALR;

pub val OPC_LUI: u32 = inst.OPC_LUI;

pub val OPC_AUIPC: u32 = inst.OPC_AUIPC;

pub val OPC_SYSTEM: u32 = inst.OPC_SYSTEM;

val OPC_AMO: u32 = inst.OPC_AMO;

pub val OPC_OP_FP: u32 = inst.OPC_OP_FP;

pub val OPC_LOAD_FP: u32 = inst.OPC_LOAD_FP;

pub val OPC_STORE_FP: u32 = inst.OPC_STORE_FP;

pub val F3_ADD: u32 = inst.F3_ADD;

pub val F3_SLL: u32 = inst.F3_SLL;

pub val F3_SLT: u32 = inst.F3_SLT;

pub val F3_SLTU: u32 = inst.F3_SLTU;

pub val F3_XOR: u32 = inst.F3_XOR;

pub val F3_SRL: u32 = inst.F3_SRL;

pub val F3_OR: u32 = inst.F3_OR;

pub val F3_AND: u32 = inst.F3_AND;

pub val F7_ZERO: u32 = inst.F7_ZERO;

pub val F7_SUB: u32 = inst.F7_SUB;

pub val F7_MULDIV: u32 = inst.F7_MULDIV;

pub val F3_BEQ: u32 = inst.F3_BEQ;

pub val F3_BNE: u32 = inst.F3_BNE;

pub val F3_BLT: u32 = inst.F3_BLT;

pub val F3_BGE: u32 = inst.F3_BGE;

pub val F3_BLTU: u32 = inst.F3_BLTU;

pub val F3_BGEU: u32 = inst.F3_BGEU;

pub val F3_DIV: u32 = inst.F3_DIV;

pub val F3_DIVU: u32 = inst.F3_DIVU;

pub val F3_REM: u32 = inst.F3_REM;

pub val F3_REMU: u32 = inst.F3_REMU;

pub val F7_FADD: u32 = inst.F7_FADD;

pub val F7_FSUB: u32 = inst.F7_FSUB;

pub val F7_FMUL: u32 = inst.F7_FMUL;

pub val F7_FDIV: u32 = inst.F7_FDIV;

pub val F7_FSGNJ: u32 = inst.F7_FSGNJ;

pub val F7_FCMP: u32 = inst.F7_FCMP;

pub val F7_FCVT_F2F: u32 = inst.F7_FCVT_F2F;

pub val F7_FCVT_F2I: u32 = inst.F7_FCVT_F2I;

pub val F7_FCVT_I2F: u32 = inst.F7_FCVT_I2F;

pub val F7_FMV_F2I: u32 = inst.F7_FMV_F2I;

pub val F7_FMV_I2F: u32 = inst.F7_FMV_I2F;

pub val F3_FLE: u32 = inst.F3_FLE;

pub val F3_FLT: u32 = inst.F3_FLT;

pub val F3_FEQ: u32 = inst.F3_FEQ;

pub val RM_RNE: u32 = inst.RM_RNE;

pub val RM_RTZ: u32 = inst.RM_RTZ;

pub val RM_DYN: u32 = inst.RM_DYN;

pub val FCVT_W: u32 = inst.FCVT_W;

pub val FCVT_WU: u32 = inst.FCVT_WU;

pub val FCVT_L: u32 = inst.FCVT_L;

pub val FCVT_LU: u32 = inst.FCVT_LU;

pub val FMT_S: u32 = inst.FMT_S_BIT;

pub val FMT_D: u32 = inst.FMT_D_BIT;

pub val FP_SCRATCH: u32 = isa_riscv.F31::u32;

pub val FP_SCRATCH2: u32 = isa_riscv.F30::u32;

pub val RZERO: u32 = isa_riscv.ZERO::u32;

pub val RRA: u32 = isa_riscv.RA::u32;

pub val RSP: u32 = isa_riscv.SP::u32;

pub val RFP: u32 = isa_riscv.FP::u32;

pub val SCRATCH: u32 = isa_riscv.SCRATCH_REG::u32;

pub val SCRATCH2: u32 = isa_riscv.SCRATCH_REG2::u32;

pub val CALLER_SAVED_GP: u32 = 0xF003FCE2;

pub val RA_READ: u32 = 0x2;

pub fun b_imm(imm: u32) u32 {
    ret (((imm >> 12) & 0x1) << 31) | (((imm >> 5) & 0x3F) << 25) |
        (((imm >> 1) & 0xF) << 8) | (((imm >> 11) & 0x1) << 7);
}

fun j_imm(imm: u32) u32 {
    ret (((imm >> 20) & 0x1) << 31) | (((imm >> 1) & 0x3FF) << 21) |
        (((imm >> 11) & 0x1) << 20) | (((imm >> 12) & 0xFF) << 12);
}

pub fun pack_r(opcode: u32, funct3: u32, funct7: u32, rd: u32, rs1: u32, rs2: u32) u32 {
    ret ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) |
        ((funct3 & 0x7) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F);
}

pub fun pack_i(opcode: u32, funct3: u32, rd: u32, rs1: u32, imm12: u32) u32 {
    ret ((imm12 & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) |
        ((rd & 0x1F) << 7) | (opcode & 0x7F);
}

pub fun pack_s(opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm12: u32) u32 {
    val imm: u32 = imm12 & 0xFFF;
    ret (((imm >> 5) & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) |
        ((funct3 & 0x7) << 12) | ((imm & 0x1F) << 7) | (opcode & 0x7F);
}

pub fun pack_b(opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm: u32) u32 {
    ret b_imm(imm) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) |
        ((funct3 & 0x7) << 12) | (opcode & 0x7F);
}

pub fun pack_u(opcode: u32, rd: u32, imm20: u32) u32 {
    ret ((imm20 & 0xFFFFF) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F);
}

pub fun pack_j(opcode: u32, rd: u32, imm: u32) u32 {
    ret j_imm(imm) | ((rd & 0x1F) << 7) | (opcode & 0x7F);
}

pub fun raw_word(st: *isa_encode.EncodeState, word: u32) {
    isa_encode.emit_u32(?st.buf, word);
}

pub val WORD_SIZE: u32 = 4;

pub fun gpr(idx: u32) isa_inst.Operand {
    ret isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, idx::i32), 8);
}

fun fpr(idx: u32) isa_inst.Operand {
    ret isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, idx::i32), 8);
}

pub fun build_inst(op: inst.MachOp, rd: u32, rs1: u32, rs2: u32, imm: i64) isa_inst.Inst {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = op::u16;
    mi.size   = WORD_SIZE::u8;

    val shape: u8 = inst.shape_of(op);
    if (shape == inst.SH_RRR) {
        mi.dst  = gpr(rd);
        mi.src1 = gpr(rs1);
        mi.src2 = gpr(rs2);
        ret mi;
    }
    if (shape == inst.SH_RRI) {
        mi.dst  = gpr(rd);
        mi.src1 = gpr(rs1);
        mi.src2 = isa_inst.make_imm(imm, 8);
        ret mi;
    }
    if (shape == inst.SH_RU) {
        mi.dst  = gpr(rd);
        mi.src1 = isa_inst.make_imm(imm, 8);
        ret mi;
    }
    if (shape == inst.SH_LOAD) {
        mi.dst  = gpr(rd);
        mi.src1 = isa_inst.make_mem(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, rs1::i32), imm::i32, isa_inst.REG_NONE, 0, 8);
        ret mi;
    }
    if (shape == inst.SH_FLOAD) {
        mi.dst  = fpr(rd);
        mi.src1 = isa_inst.make_mem(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, rs1::i32), imm::i32, isa_inst.REG_NONE, 0, 8);
        ret mi;
    }
    if (shape == inst.SH_STORE) {
        mi.dst  = isa_inst.make_mem(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, rs1::i32), imm::i32, isa_inst.REG_NONE, 0, 8);
        mi.src1 = gpr(rs2);
        ret mi;
    }
    if (shape == inst.SH_FSTORE) {
        mi.dst  = isa_inst.make_mem(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, rs1::i32), imm::i32, isa_inst.REG_NONE, 0, 8);
        mi.src1 = fpr(rs2);
        ret mi;
    }
    if (shape == inst.SH_BRANCH) {
        mi.dst  = gpr(rs1);
        mi.src1 = gpr(rs2);
        mi.src2 = isa_inst.make_block_label(0);
        ret mi;
    }
    if (shape == inst.SH_JUMP) {
        mi.dst  = gpr(rd);
        mi.src1 = isa_inst.make_block_label(0);
        ret mi;
    }
    if (shape == inst.SH_FFF) {
        mi.dst  = fpr(rd);
        mi.src1 = fpr(rs1);
        mi.src2 = fpr(rs2);
        ret mi;
    }
    if (shape == inst.SH_FF) {
        mi.dst  = fpr(rd);
        mi.src1 = fpr(rs1);
        ret mi;
    }
    if (shape == inst.SH_GFF) {
        mi.dst  = gpr(rd);
        mi.src1 = fpr(rs1);
        mi.src2 = fpr(rs2);
        ret mi;
    }
    if (shape == inst.SH_GF) {
        mi.dst  = gpr(rd);
        mi.src1 = fpr(rs1);
        ret mi;
    }
    if (shape == inst.SH_FG) {
        mi.dst  = fpr(rd);
        mi.src1 = gpr(rs1);
        ret mi;
    }
    if (shape == inst.SH_AMO) {
        mi.dst  = gpr(rd);
        mi.src1 = gpr(rs2);
        mi.src2 = isa_inst.make_mem(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, rs1::i32), 0, isa_inst.REG_NONE, 0, 8);
        ret mi;
    }
    if (shape == inst.SH_AMO_LR) {
        mi.dst  = gpr(rd);
        mi.src1 = isa_inst.make_mem(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, rs1::i32), 0, isa_inst.REG_NONE, 0, 8);
        ret mi;
    }
    if (shape == inst.SH_CSR) {
        mi.dst  = gpr(rd);
        mi.src1 = isa_inst.make_imm(imm, 8);
        mi.src2 = gpr(rs1);
        ret mi;
    }
    if (shape == inst.SH_CSR_I) {
        mi.dst  = gpr(rd);
        mi.src1 = isa_inst.make_imm(imm, 8);
        mi.src2 = isa_inst.make_imm(rs1::i64, 8);
        ret mi;
    }
    ret mi;
}

pub fun r_type(st: *isa_encode.EncodeState, opcode: u32, funct3: u32, funct7: u32, rd: u32, rs1: u32, rs2: u32) {
    val word: u32 = pack_r(opcode, funct3, funct7, rd, rs1, rs2);
    raw_word(st, word);
    if (!isa_encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp   = inst.classify(word);
    var mi: isa_inst.Inst = build_inst(op, rd, rs1, rs2, 0);
    if (opcode == OPC_AMO) { mi.flags = amo_ordering_flags(funct7); }
    note(st, op, ?mi, "R", opcode);
}

pub fun i_type(st: *isa_encode.EncodeState, opcode: u32, funct3: u32, rd: u32, rs1: u32, imm12: u32) {
    val word: u32 = pack_i(opcode, funct3, rd, rs1, imm12);
    raw_word(st, word);
    if (!isa_encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp   = inst.classify(word);
    var mi: isa_inst.Inst = build_inst(op, rd, rs1, 0, imm_of_i(op, imm12));
    note(st, op, ?mi, "I", opcode);
}

pub fun s_type(st: *isa_encode.EncodeState, opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm12: u32) {
    val word: u32 = pack_s(opcode, funct3, rs1, rs2, imm12);
    raw_word(st, word);
    if (!isa_encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp   = inst.classify(word);
    var mi: isa_inst.Inst = build_inst(op, 0, rs1, rs2, sext12(imm12::i64));
    note(st, op, ?mi, "S", opcode);
}

# a displacement given here is a skip inside the expansion, and the note says
# so; a block, local or symbol target is patched later and its caller notes it
pub fun b_type(st: *isa_encode.EncodeState, opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm: u32) {
    val word: u32 = pack_b(opcode, funct3, rs1, rs2, imm);
    raw_word(st, word);
    if (!isa_encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp   = inst.classify(word);
    var mi: isa_inst.Inst = build_inst(op, 0, rs1, rs2, 0);
    note(st, op, ?mi, "B", opcode);
    if (imm != 0) { note_skip_target(st, sext_field(imm, 13)); }
}

pub fun u_type(st: *isa_encode.EncodeState, opcode: u32, rd: u32, imm20: u32) {
    val word: u32 = pack_u(opcode, rd, imm20);
    raw_word(st, word);
    if (!isa_encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp   = inst.classify(word);
    var mi: isa_inst.Inst = build_inst(op, rd, 0, 0, (imm20 & 0xFFFFF)::i64);
    note(st, op, ?mi, "U", opcode);
}

pub fun j_type(st: *isa_encode.EncodeState, opcode: u32, rd: u32, imm: u32) {
    val word: u32 = pack_j(opcode, rd, imm);
    raw_word(st, word);
    if (!isa_encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp   = inst.classify(word);
    var mi: isa_inst.Inst = build_inst(op, rd, 0, 0, 0);
    note(st, op, ?mi, "J", opcode);
    if (imm != 0) { note_skip_target(st, sext_field(imm, 21)); }
}

# the signed value of the low `bits` bits of an encoded displacement
fun sext_field(v: u32, bits: u32) i64 {
    val m: i64 = (v::u64 & ((1::u64 << bits::u64) - 1))::i64;
    if ((m & (1::i64 << (bits - 1)::i64)) != 0) { ret m - (1::i64 << bits::i64); }
    ret m;
}

fun note(st: *isa_encode.EncodeState, op: inst.MachOp, mi: *isa_inst.Inst, fmt: str, opcode: u32) {
    if (op == inst.MOP_NONE) {
        isa_encode.sink_fail(?st.buf, fail.describe(fail.message_of(unnamed_form_message(st, fmt, opcode))));
        ret;
    }
    var n: isa_encode.AsmNote = isa_encode.note_blank();
    n.off  = st.buf.bytes.len::u32 - WORD_SIZE;
    n.inst = @mi;
    val res_: err[fail.Fail] = isa_encode.note_push(?st.buf, ?n);
    if (sel res_.err) { isa_encode.sink_fail(?st.buf, fail.describe(res_.err)); }
}

fun unnamed_form_message(st: *isa_encode.EncodeState, fmt: str, opcode: u32) res[str, fail.Fail] {
    var buf: [32]u8;
    var i:   usize = 0;
    for (fmt[i] != 0) {
        buf[i] = fmt[i]::u8;
        i      = i + 1;
    }
    buf[i] = '-'::u8;
    i      = i + 1;
    buf[i] = 't'::u8;
    i      = i + 1;
    buf[i] = 'y'::u8;
    i      = i + 1;
    buf[i] = 'p'::u8;
    i      = i + 1;
    buf[i] = 'e'::u8;
    i      = i + 1;
    buf[i] = ' '::u8;
    i      = i + 1;
    i      = i + std_format.put_u64(?buf[i], opcode::u64);
    buf[i] = 0;
    ret isa_asm.named_message(st.alloc, st.interner,
        "encode: no riscv64 mnemonic for an emitted ", (?buf[0])::str, " instruction");
}

fun amo_ordering_flags(funct7: u32) u16 {
    var flags: u16 = 0;
    if ((funct7 & 0x2) != 0) { flags = flags | inst.FLAG_AQ; }
    if ((funct7 & 0x1) != 0) { flags = flags | inst.FLAG_RL; }
    ret flags;
}

fun imm_of_i(op: inst.MachOp, imm12: u32) i64 {
    if (op == inst.SLLI || op == inst.SRLI || op == inst.SRAI)    { ret (imm12 & 0x3F)::i64; }
    if (op == inst.SLLIW || op == inst.SRLIW || op == inst.SRAIW) { ret (imm12 & 0x1F)::i64; }
    if (op >= inst.CSRRW && op <= inst.CSRRCI)                    { ret (imm12 & 0xFFF)::i64; }
    ret sext12(imm12::i64);
}

fun last_inst(st: *isa_encode.EncodeState) *isa_inst.Inst {
    val count: u32 = isa_encode.note_count(?st.buf);
    if (count == 0) { ret nil; }
    val n: *isa_encode.AsmNote = isa_encode.note_at(?st.buf, count - 1);
    if (n == nil || n.kind != isa_encode.ASM_NOTE_INST) { ret nil; }
    ret ?n.inst;
}

fun target_operand(mi: *isa_inst.Inst) *isa_inst.Operand {
    val shape: u8 = inst.shape_of(mi.opcode::inst.MachOp);
    if (shape == inst.SH_RRI || shape == inst.SH_BRANCH)                                                 { ret ?mi.src2; }
    if (shape == inst.SH_RU || shape == inst.SH_JUMP || shape == inst.SH_LOAD || shape == inst.SH_FLOAD) { ret ?mi.src1; }
    if (shape == inst.SH_STORE || shape == inst.SH_FSTORE)                                               { ret ?mi.dst; }
    ret nil;
}

fun last_target(st: *isa_encode.EncodeState) *isa_inst.Operand {
    val mi: *isa_inst.Inst = last_inst(st);
    if (mi == nil) { ret nil; }
    val op: *isa_inst.Operand = target_operand(mi);
    if (op == nil) {
        isa_encode.sink_fail(?st.buf,
            "encode: a riscv64 instruction with no target field was given a branch or symbol target");
        ret nil;
    }
    ret op;
}

pub fun note_block_target(st: *isa_encode.EncodeState, block: u32) {
    val op: *isa_inst.Operand = last_target(st);
    if (op == nil) { ret; }
    @op = isa_inst.make_block_label(block);
}

fun note_skip_target(st: *isa_encode.EncodeState, bytes: i64) {
    val op: *isa_inst.Operand = last_target(st);
    if (op == nil) { ret; }
    @op                 = isa_inst.make_block_label(0);
    op.imm              = bytes;
    last_inst(st).flags = last_inst(st).flags | inst.FLAG_LABEL_SKIP;
}

pub fun note_local_target(st: *isa_encode.EncodeState, number: u32, fwd: bool) {
    val op: *isa_inst.Operand = last_target(st);
    if (op == nil) { ret; }
    val mi: *isa_inst.Inst = last_inst(st);
    @op      = isa_inst.make_block_label(0);
    op.imm   = number::i64;
    mi.flags = mi.flags | inst.FLAG_LABEL_LOCAL;
    if (fwd) { mi.flags = mi.flags | inst.FLAG_LABEL_FWD; }
}

pub fun note_sym_target(st: *isa_encode.EncodeState, sym: intern.StrId, mod: isa_inst.SymModifier, addend: i64) {
    val op: *isa_inst.Operand = last_target(st);
    if (op == nil) { ret; }
    if (op.kind == isa_inst.OPK_MEM) {
        op.sym_id     = sym::u32;
        op.sym_mod    = mod;
        op.disp       = 0;
        op.sym_addend = addend;
        ret;
    }
    @op = isa_inst.make_sym_addend(sym::u32, st.model.pointer_width::u8, mod, addend);
}

pub fun xlen(st: *isa_encode.EncodeState) u8 {
    ret st.model.gpr_width::u8;
}

pub fun flen(st: *isa_encode.EncodeState) u8 {
    ret (st.model.flen_bits / 8)::u8;
}

pub fun alu_opcode(width: u8, xl: u8) u32 {
    if (width == 4 && xl == 8) { ret OPC_OP_32; }
    ret OPC_OP;
}

pub fun alu_imm_opcode(width: u8, xl: u8) u32 {
    if (width == 4 && xl == 8) { ret OPC_OP_IMM_32; }
    ret OPC_OP_IMM;
}

# the funct3 of a memory access row; the machine that admits the row is the
# admission seam's question after the word is emitted
pub fun int_mem_funct3(width: u8, is_load: bool) res[u32, fail.Fail] {
    val op: inst.MachOp = inst.int_access(width, is_load);
    if (op == inst.MOP_NONE) {
        ret res[u32, fail.Fail].err{fail.message("internal compiler error: riscv has no integer memory access form for this width (expected 1, 2, 4, or 8)")};
    }
    ret res[u32, fail.Fail].ok{inst.row(op).funct3};
}

pub fun sext12(v: i64) i64 {
    var x: i64 = v & 0xFFF;
    if ((x & 0x800) != 0) { x = x - 0x1000; }
    ret x;
}

fun li32(st: *isa_encode.EncodeState, rd: u32, v: i32) {
    val hi20: u32 = ((v + 0x800) >> 12)::u32 & 0xFFFFF;
    val lo12: u32 = v::u32 & 0xFFF;
    u_type(st, OPC_LUI, rd, hi20);
    if (lo12 != 0) { i_type(st, alu_imm_opcode(4, xlen(st)), F3_ADD, rd, rd, lo12); }
}

pub fun li(st: *isa_encode.EncodeState, rd: u32, value: i64) {
    if (value >= -2048 && value <= 2047) {
        i_type(st, OPC_OP_IMM, F3_ADD, rd, RZERO, value::u32 & 0xFFF);
        ret;
    }
    if (value >= -2147483648 && value <= 2147483647) {
        li32(st, rd, value::i32);
        ret;
    }
    val lo12: i64 = sext12(value);
    val hi:   i64 = (value - lo12) >> 12;
    li(st, rd, hi);
    i_type(st, OPC_OP_IMM, F3_SLL, rd, rd, 12);
    if (lo12 != 0) { i_type(st, OPC_OP_IMM, F3_ADD, rd, rd, lo12::u32 & 0xFFF); }
}

pub fun pcrel_hi(st: *isa_encode.EncodeState, rd: u32, sym: intern.StrId, addend: i64) err[fail.Fail] {
    val pos: u32 = st.buf.bytes.len::u32;
    u_type(st, OPC_AUIPC, rd, 0);
    note_sym_target(st, sym, isa_inst.SYM_MOD_PCREL_HI, addend);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, pos, target_of.RK_PCREL_HI20, sym, addend);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    val site: err[fail.Fail] = isa_encode.bind_reloc_pair_site(st, target_of.RK_PCREL_HI20, sym, st.reloc_count - 1);
    if (sel site.err) { ret err[fail.Fail].err{site.err}; }
    ret err[fail.Fail].ok{};
}

val PCREL_LABEL_FLAGS: u32 = 0;

pub fun push_pcrel_lo(st: *isa_encode.EncodeState, lo_pos: u32, kind: target_of.RelocKind,
    sym: intern.StrId) err[fail.Fail] {
    ret push_pcrel_lo_of(st, lo_pos, kind, target_of.RK_PCREL_HI20, sym);
}

# a low part paired with the high part of `high_kind` that last named sym
pub fun push_pcrel_lo_of(st: *isa_encode.EncodeState, lo_pos: u32, kind: target_of.RelocKind,
    high_kind: target_of.RelocKind, sym: intern.StrId) err[fail.Fail] {
    val found: res[*isa_encode.RelocPairSite, fail.Fail] = isa_encode.reloc_pair_site(st, high_kind, sym);
    if (sel found.err) {
        if (high_kind == target_of.RK_GOT_PCREL_HI20) {
            ret err[fail.Fail].err{fail.message("encode: riscv64 GOT low-12 names a symbol no preceding 'auipc rd, %got_pcrel_hi(sym)' in this .text materialized")};
        }
        ret err[fail.Fail].err{fail.message("encode: riscv64 pc-relative low-12 names a symbol no preceding 'auipc rd, %pcrel_hi(sym)' in this .text materialized")};
    }
    val site: *isa_encode.RelocPairSite = found.ok;
    if (intern.str_is_nil(site.label)) {
        val named: res[intern.StrId, fail.Fail] = isa_encode.intern_local_label(st, ".Lpcrel_hi.", st.pcrel_label_count);
        if (sel named.err) {
            ret err[fail.Fail].err{named.err};
        }
        val label: intern.StrId = named.ok;
        st.pcrel_label_count = st.pcrel_label_count + 1;
        val high_offset: u32            = st.relocs[site.reloc_index].offset;
        val marked:      err[fail.Fail] = isa_encode.push_symbol(st, label, high_offset, PCREL_LABEL_FLAGS);
        if (sel marked.err) { ret err[fail.Fail].err{marked.err}; }
        site.label = label;
    }
    val high_index: u32            = site.reloc_index;
    val pushed:     err[fail.Fail] = isa_encode.push_reloc(st, lo_pos, kind, site.label, 0);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    val pair: err[fail.Fail] = isa_encode.bind_reloc_pair(st, st.reloc_count - 1, high_index);
    if (sel pair.err) { ret err[fail.Fail].err{pair.err}; }
    ret err[fail.Fail].ok{};
}

# the high part of the address of sym's GOT slot
pub fun got_hi(st: *isa_encode.EncodeState, rd: u32, sym: intern.StrId) err[fail.Fail] {
    val pos: u32 = st.buf.bytes.len::u32;
    u_type(st, OPC_AUIPC, rd, 0);
    note_sym_target(st, sym, isa_inst.SYM_MOD_GOT_HI, 0);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, pos, target_of.RK_GOT_PCREL_HI20, sym, 0);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret isa_encode.bind_reloc_pair_site(st, target_of.RK_GOT_PCREL_HI20, sym, st.reloc_count - 1);
}

pub val B_DISP_MIN: i64 = -4096;

pub val B_DISP_MAX: i64 = 4094;

pub val J_DISP_MIN: i64 = -1048576;

pub val J_DISP_MAX: i64 = 1048574;

# the extension a word needs and the selected machine lacks, by name; absent
# when every extension the word needs is selected
pub fun missing_extension(bits: u64, op: inst.MachOp) opt[str] {
    if (!inst.in_catalog(op)) { ret opt[str].none{}; }
    val required: u64 = inst.required_extensions(op);
    val missing:  u64 = required & ~bits;
    if (missing == 0)                           { ret opt[str].none{}; }
    if ((missing & extension_riscv.I) != 0)     { ret opt[str].some{"I"}; }
    if ((missing & extension_riscv.M) != 0)     { ret opt[str].some{"M"}; }
    if ((missing & extension_riscv.A) != 0)     { ret opt[str].some{"A"}; }
    if ((missing & extension_riscv.F) != 0)     { ret opt[str].some{"F"}; }
    if ((missing & extension_riscv.D) != 0)     { ret opt[str].some{"D"}; }
    if ((missing & extension_riscv.ZICSR) != 0) { ret opt[str].some{"Zicsr"}; }
    ret opt[str].none{};
}

# the one admission point: the table's xlen mask and extension bits against
# the selected machine
pub fun admission(bits: u64, xl: u8, op: inst.MachOp) err[fail.Fail] {
    if (!inst.in_catalog(op)) { ret err[fail.Fail].err{fail.message("internal compiler error: emitted RISC-V word spells no catalogued instruction")}; }
    if (!inst.admits(op, xl)) {
        if (xl == 4) { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction is not admitted on riscv32")}; }
        ret err[fail.Fail].err{fail.message("encode: RISC-V instruction is not admitted on riscv64")};
    }
    val required: u64 = inst.required_extensions(op);
    val missing:  u64 = required & ~bits;
    if (missing == 0)                           { ret err[fail.Fail].ok{}; }
    if ((missing & extension_riscv.I) != 0)     { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction requires the I extension")}; }
    if ((missing & extension_riscv.M) != 0)     { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction requires the M extension")}; }
    if ((missing & extension_riscv.A) != 0)     { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction requires the A extension")}; }
    if ((missing & extension_riscv.F) != 0)     { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction requires the F extension")}; }
    if ((missing & extension_riscv.D) != 0)     { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction requires the D extension")}; }
    if ((missing & extension_riscv.ZICSR) != 0) { ret err[fail.Fail].err{fail.message("encode: RISC-V instruction requires the Zicsr extension")}; }
    ret err[fail.Fail].err{fail.message("internal compiler error: RISC-V extension declaration is invalid")};
}

pub fun patch_branch(st: *isa_encode.EncodeState, fx: *isa_encode.BranchFixup, target_off: u32) err[fail.Fail] {
    val pos: usize = fx.patch_pos::usize;
    if (pos + 4 > st.buf.bytes.len) {
        ret err[fail.Fail].err{fail.message("encode: branch fixup site is outside the text buffer")};
    }
    val word:  u32 = isa_encode.word_read(?st.buf, pos);
    val sdisp: i64 = (target_off::i64) - (fx.patch_pos::i64);
    if ((sdisp & 1) != 0) {
        ret err[fail.Fail].err{fail.message("encode: riscv64 branch displacement is not 2-byte aligned")};
    }
    val disp:   u32 = target_off - fx.patch_pos;
    val opcode: u32 = word & 0x7F;

    if (opcode == OPC_JAL) {
        if (sdisp < J_DISP_MIN || sdisp > J_DISP_MAX) {
            ret err[fail.Fail].err{fail.message("encode: riscv64 jump displacement exceeds the +-1MiB range")};
        }
        isa_encode.word_write(?st.buf, pos, (word & 0xFFF) | j_imm(disp));
        ret err[fail.Fail].ok{};
    }
    if (opcode == OPC_BRANCH) {
        if (sdisp < B_DISP_MIN || sdisp > B_DISP_MAX) {
            ret err[fail.Fail].err{fail.message("encode: riscv64 branch displacement exceeds the +-4KiB range")};
        }
        isa_encode.word_write(?st.buf, pos, (word & 0x01FFF07F) | b_imm(disp));
        ret err[fail.Fail].ok{};
    }
    if (opcode == OPC_AUIPC) {
        if (pos + 8 > st.buf.bytes.len) {
            ret err[fail.Fail].err{fail.message("encode: riscv64 trampoline fixup site is outside the text buffer")};
        }
        if (sdisp < -2147483648 || sdisp > 2147483647) {
            ret err[fail.Fail].err{fail.message("encode: riscv64 trampoline displacement exceeds the 32-bit pc-relative range")};
        }
        val hi20: u32 = ((disp + 0x800) >> 12) & 0xFFFFF;
        val lo12: u32 = disp & 0xFFF;
        isa_encode.word_write(?st.buf, pos, pack_u(OPC_AUIPC, SCRATCH, hi20));
        isa_encode.word_write(?st.buf, pos + 4, pack_i(OPC_JALR, F3_ADD, RZERO, SCRATCH, lo12));
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: branch fixup site is not a B-type, J-type, or trampoline instruction")};
}

#[testing]
pub var t_model: target_model.Machine;

#[testing]
pub fun rv64_machine() *target_model.Machine {
    t_model.pointer_width = 8;
    t_model.gpr_width     = 8;
    target_model.declare_alu_widths(?t_model, target_model.ALU_WIDTHS_4_8);
    t_model.spill_width = 8;
    t_model.flen_bits   = 64;
    t_model.extensions  = extension_riscv.ALL;
    ret ?t_model;
}

#[testing]
pub fun tbuf(st: *isa_encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    isa_encode.state_blank(st, alloc, rv64_machine());
}

#[testing]
pub fun tbuf_interned(st: *isa_encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    isa_encode.state_blank(st, alloc, rv64_machine());
    st.interner = itn;
}

#[testing]
pub fun label_at(st: *isa_encode.EncodeState, name: intern.StrId, off: u32) bool {
    var i: u32 = 0;
    for (i < st.sym_count) {
        if (intern.str_same(st.syms[i].name, name) && st.syms[i].offset == off
            && st.syms[i].flags == PCREL_LABEL_FLAGS) { ret true; }
        i = i + 1;
    }
    ret false;
}

test pack__formats_and_immediate_scatter {
    var bad: i32 = 0;
    if (pack_r(OPC_OP, F3_ADD, F7_ZERO, 10, 11, 12) != 0x00C58533)      { bad = 1; }
    if (pack_r(OPC_OP, F3_ADD, F7_SUB, 10, 11, 12) != 0x40C58533)       { bad = 1; }
    if (pack_r(OPC_OP_32, F3_ADD, F7_ZERO, 10, 11, 12) != 0x00C5853B)   { bad = 1; }
    if (pack_i(OPC_OP_IMM, F3_ADD, 10, 11, 5) != 0x00558513)            { bad = 1; }
    if (pack_i(OPC_LOAD, F3_SLTU, 10, 11, 16) != 0x0105B503)            { bad = 1; }
    if (pack_i(OPC_JALR, F3_ADD, 0, 1, 0) != 0x00008067)                { bad = 1; }
    if (pack_s(OPC_STORE, F3_SLTU, 11, 10, 16) != 0x00A5B823)           { bad = 1; }
    if (pack_u(OPC_LUI, 10, 0x12345) != 0x12345537)                     { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BNE, 10, 11, 16) != 0x00B51863)           { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, (0 - 4)::u32) != 0xFEB50EE3) { bad = 1; }
    if (pack_j(OPC_JAL, 1, 16) != 0x010000EF)                           { bad = 1; }
    if (pack_j(OPC_JAL, 1, (0 - 4)::u32) != 0xFFDFF0EF)                 { bad = 1; }
    ret bad;
}

test emit_li__constant_materialization {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    li(?st, 10, 5);
    if (st.buf.bytes.len != 4) { bad = 1; }
    or {
        if (isa_encode.word_read(?st.buf, 0) != 0x00500513) { bad = 1; }
    }

    st.buf.bytes.len = 0;
    li(?st, 10, 0 - 1);
    if (isa_encode.word_read(?st.buf, 0) != 0xFFF00513) { bad = 1; }

    st.buf.bytes.len = 0;
    li(?st, 10, 0x12345678);
    if (st.buf.bytes.len != 8) { bad = 1; }
    or {
        if (isa_encode.word_read(?st.buf, 0) != 0x12345537) { bad = 1; }
        if (isa_encode.word_read(?st.buf, 4) != 0x6785051B) { bad = 1; }
    }

    st.buf.bytes.len = 0;
    li(?st, 10, 0x100000000);
    if (st.buf.bytes.len != 8) { bad = 1; }
    or {
        if (isa_encode.word_read(?st.buf, 0) != 0x00100537) { bad = 1; }
        if (isa_encode.word_read(?st.buf, 4) != 0x00C51513) { bad = 1; }
    }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test patch_branch__scatter_and_range {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    raw_word(?st, pack_j(OPC_JAL, RZERO, 0));
    raw_word(?st, pack_b(OPC_BRANCH, F3_BNE, 10, 0, 0));

    var fx: isa_encode.BranchFixup;
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    patch_branch(?st, ?fx, 16);
    if (isa_encode.word_read(?st.buf, 0) != 0x0100006F) { bad = 1; }
    fx.patch_pos = 4;
    fx.next_ip   = 8;
    patch_branch(?st, ?fx, 12);
    if (isa_encode.word_read(?st.buf, 4) != 0x00051463) { bad = 1; }

    fx.patch_pos = 4;
    fx.next_ip   = 8;
    raw_word(?st, pack_j(OPC_JAL, RZERO, 0));
    st.buf.bytes.data[4] = 0x6F;
    st.buf.bytes.data[5] = 0;
    st.buf.bytes.data[6] = 0;
    st.buf.bytes.data[7] = 0;
    patch_branch(?st, ?fx, 0);
    if (isa_encode.word_read(?st.buf, 4) != 0xFFDFF06F) { bad = 1; }

    st.buf.bytes.len = 0;
    raw_word(?st, pack_b(OPC_BRANCH, F3_BNE, 10, 0, 0));
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    val r1: err[fail.Fail] = patch_branch(?st, ?fx, 8192);
    if (!sel r1.err) { bad = 1; }

    st.buf.bytes.len = 0;
    raw_word(?st, pack_j(OPC_JAL, RZERO, 0));
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    val r2: err[fail.Fail] = patch_branch(?st, ?fx, 2000000);
    if (!sel r2.err) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test pcrel_pair__sites_are_indexed {
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    fin {
        isa_encode.buf_dnit(?st.buf);
        if (st.syms != nil && st.sym_cap > 0) {
            A.deallocate[isa_encode.SymbolMark](?alloc, st.syms, st.sym_cap::usize);
        }
        if (st.relocs != nil && st.reloc_cap > 0) {
            A.deallocate[isa_encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
        }
        map.dnit[u64, isa_encode.RelocPairSite](?st.reloc_pair_sites);
        intern.dnit(?itn);
    }

    val absent: err[fail.Fail] =
        push_pcrel_lo(?st, 0, target_of.RK_PCREL_LO12_I, intern.str_id(0x7FFFFFFF));
    if (sel absent.ok)       { ret 1; }
    if (st.reloc_count != 0) { ret 1; }
    if (st.sym_count != 0)   { ret 1; }

    val count: u32 = 64;
    var i:     u32 = 0;
    for (i < count) {
        val target: res[intern.StrId, fail.Fail] = isa_encode.intern_local_label(?st, ".Tpair_target.", i);
        if (sel target.err) { ret 2; }
        val sym:      intern.StrId   = target.ok;
        val high_off: u32            = st.buf.bytes.len::u32;
        val high:     err[fail.Fail] = pcrel_hi(?st, SCRATCH, sym, 0);
        if (sel high.err) { ret 3; }
        i_type(?st, OPC_OP_IMM, F3_ADD, SCRATCH, SCRATCH, 0);
        val low: err[fail.Fail] =
            push_pcrel_lo(?st, high_off + WORD_SIZE, target_of.RK_PCREL_LO12_I, sym);
        if (sel low.err) { ret 4; }
        i = i + 1;
    }

    var bad: i32 = 0;
    if (st.reloc_pair_sites.len != count::usize)              { bad = 5; }
    if (st.reloc_count != count * 2 || st.sym_count != count) { bad = 6; }
    i = 0;
    for (i < count) {
        val high_index: u32 = i * 2;
        val low_index:  u32 = high_index + 1;
        if (st.relocs[high_index].offset != i * 8
            || !intern.str_same(st.relocs[low_index].sym, st.syms[i].name)
            || st.syms[i].offset != i * 8) {
            bad = 7;
            brk;
        }
        if (st.relocs[high_index].pair != 0
            || st.relocs[low_index].pair != high_index + 1
            || st.relocs[st.relocs[low_index].pair - 1].kind != target_of.RK_PCREL_HI20) {
            bad = 20;
            brk;
        }
        i = i + 1;
    }

    val repeated_r: res[intern.StrId, fail.Fail] = isa_encode.intern_local_label(?st, ".Trepeated_target.", 0);
    if (sel repeated_r.err) { ret 8; }
    val repeated:  intern.StrId   = repeated_r.ok;
    val first_off: u32            = st.buf.bytes.len::u32;
    var emitted:   err[fail.Fail] = pcrel_hi(?st, SCRATCH, repeated, 0);
    if (sel emitted.err) { bad = 9; }
    val latest_off: u32 = st.buf.bytes.len::u32;
    emitted = pcrel_hi(?st, SCRATCH, repeated, 0);
    if (sel emitted.err) { bad = 10; }
    if (st.sym_count != count || st.reloc_pair_sites.len != count::usize + 1) {
        bad = 11;
    }
    val insert_text_r: err[fail.Fail] = isa_encode.insert_text(?st, latest_off, WORD_SIZE);
    if (sel insert_text_r.err) {
        bad = 12;
    }
    val shifted_latest_off: u32 = latest_off + WORD_SIZE;
    val first_low_off:      u32 = st.buf.bytes.len::u32;
    i_type(?st, OPC_OP_IMM, F3_ADD, SCRATCH, SCRATCH, 0);
    var pushed: err[fail.Fail] = push_pcrel_lo(?st, first_low_off, target_of.RK_PCREL_LO12_I, repeated);
    if (sel pushed.err) { bad = 13; }
    val latest_label: intern.StrId = st.relocs[st.reloc_count - 1].sym;
    if (latest_off == first_off || !label_at(?st, latest_label, shifted_latest_off)
        || label_at(?st, latest_label, first_off)) { bad = 14; }
    val symbols_after_first_low: u32                 = st.sym_count;
    val second_low_off:          u32                 = st.buf.bytes.len::u32;
    val store_f3_r:              res[u32, fail.Fail] = int_mem_funct3(8, false);
    if (sel store_f3_r.err) { ret 1; }
    val store_f3: u32 = store_f3_r.ok;
    s_type(?st, OPC_STORE, store_f3, SCRATCH, SCRATCH, 0);
    pushed = push_pcrel_lo(?st, second_low_off, target_of.RK_PCREL_LO12_S, repeated);
    if (sel pushed.err) { bad = 15; }
    if (st.sym_count != symbols_after_first_low
        || !intern.str_same(st.relocs[st.reloc_count - 1].sym, latest_label)) { bad = 16; }

    ret bad;
}
