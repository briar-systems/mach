# riscv instructions packed and appended to the encode buffer, with the relocations they carry
use mach.lang.fail;
use std.allocator.page;
use std.collections.map;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.target.extension;
use extension_riscv: mach.lang.target.extension.riscv;
use isa_asm:         mach.lang.target.isa.asm;
use isa_encode:      mach.lang.target.isa.encode;
