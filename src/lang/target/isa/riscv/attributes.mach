use std.types.canonical.res;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.page;

use mach.lang.target.isa.riscv.features;
use mach.lang.target.of.elf;

use A: std.allocator;
use R: std.types.result;

use mach.lang.layout;

pub val TAG_STACK_ALIGN:       u32 = 4;
pub val TAG_ARCH:              u32 = 5;
pub val TAG_UNALIGNED_ACCESS:  u32 = 6;
pub val TAG_PRIV_SPEC:         u32 = 8;
pub val TAG_PRIV_SPEC_MINOR:   u32 = 10;
pub val TAG_PRIV_SPEC_REVISION: u32 = 12;

pub val RISCV64_STACK_ALIGN: u32 = 16;

val MAX_EXTS:    u32 = 64;
val MAX_NAME:    u32 = 24;
val MAX_UNKNOWN: u32 = 16;
val MAX_UNKNOWN_VALUE: u32 = 64;

pub rec Ext {
    name:     [24]u8;
    name_len: u32;
    major:    u32;
    minor:    u32;
}

pub rec Arch {
    xlen:  u32;
    exts:  [64]Ext;
    count: u32;
}

pub rec Unknown {
    tag:       u32;
    is_str:    bool;
    value:     [64]u8;
    value_len: u32;
}

pub rec Attrs {
    arch:            Arch;
    has_arch:        bool;
    stack_align:     u32;
    has_stack_align: bool;
    unaligned:       u32;
    has_unaligned:   bool;
    priv:            [3]u32;
    has_priv:        [3]bool;
    unknown:         [16]Unknown;
    unknown_count:   u32;
}

val SINGLE_ORDER: str = "mafdqlcbkjtpvn";

pub fun attrs_blank(at: *Attrs) {
    at.arch.xlen = 0;
    at.arch.count = 0;
    at.has_arch = false;
    at.stack_align = 0;
    at.has_stack_align = false;
    at.unaligned = 0;
    at.has_unaligned = false;
    var i: u32 = 0;
    for (i < 3) { at.priv[i] = 0; at.has_priv[i] = false; i = i + 1; }
    at.unknown_count = 0;
}

fun is_lower(c: u8) bool { ret c >= 97 && c <= 122; }

fun is_digit(c: u8) bool { ret c >= 48 && c <= 57; }

fun single_rank(c: u8) i64 {
    val n: i64 = str_len(SINGLE_ORDER)::i64;
    var i: i64 = 0;
    for (i < n) {
        if (SINGLE_ORDER[i::usize]::u8 == c) { ret i; }
        i = i + 1;
    }
    ret -1;
}

fun name_cmp(a: *Ext, b: *Ext) i64 {
    var i: u32 = 0;
    for (i < a.name_len && i < b.name_len) {
        if (a.name[i] != b.name[i]) { ret (a.name[i]::i64) - (b.name[i]::i64); }
        i = i + 1;
    }
    ret (a.name_len::i64) - (b.name_len::i64);
}

fun same_ext(a: *Ext, b: *Ext) bool { ret name_cmp(a, b) == 0; }

fun read_uleb(buf: *u8, len: u32, pos: *u32, out: *u32) bool {
    var v: u64 = 0;
    var shift: u32 = 0;
    var p: u32 = @pos;
    for (p < len) {
        val b: u8 = buf[p];
        p = p + 1;
        if (shift > 28 && (b & 0x7F) > 15) { ret false; }
        v = v | (((b & 0x7F)::u64) << shift);
        if ((b & 0x80) == 0) {
            @pos = p;
            @out = v::u32;
            ret true;
        }
        shift = shift + 7;
        if (shift > 35) { ret false; }
    }
    ret false;
}

fun uleb_size(value: u32) u32 {
    var v: u32 = value;
    var n: u32 = 1;
    for (v > 127) { v = v >> 7; n = n + 1; }
    ret n;
}

fun write_uleb(buf: *u8, pos: u32, value: u32) u32 {
    var v: u32 = value;
    var n: u32 = 0;
    var more: bool = true;
    for (more) {
        var b: u8 = (v & 0x7F)::u8;
        v = v >> 7;
        if (v != 0) { b = b | 0x80; } or { more = false; }
        buf[pos + n] = b;
        n = n + 1;
    }
    ret n;
}

fun read_number(s: *u8, len: u32, p: *u32, out: *u32) bool {
    val start: u32 = @p;
    var acc: usize = 0;
    for (@p < len && is_digit(s[@p])) {
        val scaled: res[usize, layout.CheckCause] = layout.usize_mul(acc, 10);
        if (sel scaled.err) { ret false; }
        val summed: res[usize, layout.CheckCause] = layout.usize_add(
            scaled.ok, (s[@p] - 48)::usize);
        if (sel summed.err) { ret false; }
        acc = summed.ok;
        @p = @p + 1;
    }
    if (@p == start) { ret false; }
    val narrowed: res[u32, layout.CheckCause] = layout.usize_to_u32(acc);
    if (sel narrowed.err) { ret false; }
    @out = narrowed.ok;
    ret true;
}

pub fun parse_arch(s: *u8, len: u32, out: *Arch) bool {
    out.xlen = 0;
    out.count = 0;
    if (len < 5) { ret false; }
    if (s[0] != 114 || s[1] != 118) { ret false; }
    var p: u32 = 2;
    var xlen: u32 = 0;
    if (!read_number(s, len, ?p, ?xlen)) { ret false; }
    if (xlen != 32 && xlen != 64) { ret false; }
    out.xlen = xlen;

    for (p < len) {
        if (s[p] == 95) { p = p + 1; cnt; }
        if (!is_lower(s[p])) { ret false; }

        var e: Ext;
        e.name_len = 0;
        e.major = 0;
        e.minor = 0;

        val multi: bool = s[p] == 122 || s[p] == 115 || s[p] == 120;
        e.name[0] = s[p];
        e.name_len = 1;
        p = p + 1;
        if (multi) {
            for (p < len && is_lower(s[p])) {
                if (e.name_len >= MAX_NAME) { ret false; }
                e.name[e.name_len] = s[p];
                e.name_len = e.name_len + 1;
                p = p + 1;
            }
        }

        if (p < len && is_digit(s[p])) {
            if (!read_number(s, len, ?p, ?e.major)) { ret false; }
            if (p < len && s[p] == 112) {
                p = p + 1;
                if (p >= len || !is_digit(s[p])) { ret false; }
                if (!read_number(s, len, ?p, ?e.minor)) { ret false; }
            }
        }

        if (out.count >= MAX_EXTS) { ret false; }
        var i: u32 = 0;
        for (i < out.count) {
            if (same_ext(?out.exts[i], ?e)) { ret false; }
            i = i + 1;
        }
        out.exts[out.count] = e;
        out.count = out.count + 1;
    }
    ret out.count > 0;
}

pub fun merge_arch(a: *Arch, b: *Arch) err[fail.Fail] {
    if (a.xlen == 0) {
        @a = @b;
        ret err[fail.Fail].ok{};
    }
    if (b.xlen == 0) { ret err[fail.Fail].ok{}; }
    if (a.xlen != b.xlen) {
        ret err[fail.Fail].err{fail.message("link: riscv attribute merge: inputs disagree on register width (rv32 with rv64)")};
    }
    var i: u32 = 0;
    for (i < b.count) {
        var found: bool = false;
        var j: u32 = 0;
        for (j < a.count) {
            if (same_ext(?a.exts[j], ?b.exts[i])) {
                found = true;
                if (b.exts[i].major > a.exts[j].major
                    || (b.exts[i].major == a.exts[j].major
                        && b.exts[i].minor > a.exts[j].minor)) {
                    a.exts[j].major = b.exts[i].major;
                    a.exts[j].minor = b.exts[i].minor;
                }
                brk;
            }
            j = j + 1;
        }
        if (!found) {
            if (a.count >= MAX_EXTS) {
                ret err[fail.Fail].err{fail.message("link: riscv attribute merge: more extensions than the merger can hold")};
            }
            a.exts[a.count] = b.exts[i];
            a.count = a.count + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun merge_unknown(at: *Attrs, u: *Unknown) err[fail.Fail] {
    var i: u32 = 0;
    for (i < at.unknown_count) {
        if (at.unknown[i].tag == u.tag) {
            var same: bool = at.unknown[i].value_len == u.value_len;
            var k: u32 = 0;
            for (same && k < u.value_len) {
                if (at.unknown[i].value[k] != u.value[k]) { same = false; }
                k = k + 1;
            }
            if (same) { ret err[fail.Fail].ok{}; }
            at.unknown[i] = at.unknown[at.unknown_count - 1];
            at.unknown_count = at.unknown_count - 1;
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    if (at.unknown_count >= MAX_UNKNOWN) { ret err[fail.Fail].ok{}; }
    at.unknown[at.unknown_count] = @u;
    at.unknown_count = at.unknown_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun parse_body(body: *u8, len: u32, out: *Attrs) err[fail.Fail] {
    attrs_blank(out);
    if (body == nil || len == 0) { ret err[fail.Fail].ok{}; }
    var p: u32 = 0;
    for (p < len) {
        var tag: u32 = 0;
        if (!read_uleb(body, len, ?p, ?tag)) {
            ret err[fail.Fail].err{fail.message("link: riscv attributes: truncated attribute tag")};
        }
        val is_str: bool = (tag & 1) == 1;
        if (is_str) {
            val start: u32 = p;
            for (p < len && body[p] != 0) { p = p + 1; }
            if (p >= len) {
                ret err[fail.Fail].err{fail.message("link: riscv attributes: unterminated attribute string")};
            }
            val slen: u32 = p - start;
            p = p + 1;
            if (tag == TAG_ARCH) {
                if (out.has_arch) { ret err[fail.Fail].err{fail.message("link: riscv attributes: duplicate Tag_RISCV_arch")}; }
                if (!parse_arch(?body[start], slen, ?out.arch)) {
                    ret err[fail.Fail].err{fail.message("link: riscv attributes: Tag_RISCV_arch is not a readable ISA string")};
                }
                out.has_arch = true;
            }
            or {
                if (slen <= MAX_UNKNOWN_VALUE) {
                    var u: Unknown;
                    u.tag = tag;
                    u.is_str = true;
                    u.value_len = slen;
                    var k: u32 = 0;
                    for (k < slen) { u.value[k] = body[start + k]; k = k + 1; }
                    val mr: err[fail.Fail] = merge_unknown(out, ?u);
                    if (sel mr.err) { ret mr; }
                }
            }
            cnt;
        }

        var v: u32 = 0;
        if (!read_uleb(body, len, ?p, ?v)) {
            ret err[fail.Fail].err{fail.message("link: riscv attributes: truncated attribute value")};
        }
        if (tag == TAG_STACK_ALIGN)           { out.stack_align = v; out.has_stack_align = true; cnt; }
        if (tag == TAG_UNALIGNED_ACCESS)      { out.unaligned = v;   out.has_unaligned = true;   cnt; }
        if (tag == TAG_PRIV_SPEC)             { out.priv[0] = v; out.has_priv[0] = true; cnt; }
        if (tag == TAG_PRIV_SPEC_MINOR)       { out.priv[1] = v; out.has_priv[1] = true; cnt; }
        if (tag == TAG_PRIV_SPEC_REVISION)    { out.priv[2] = v; out.has_priv[2] = true; cnt; }

        var u2: Unknown;
        u2.tag = tag;
        u2.is_str = false;
        u2.value_len = uleb_size(v);
        write_uleb(?u2.value[0], 0, v);
        val mr2: err[fail.Fail] = merge_unknown(out, ?u2);
        if (sel mr2.err) { ret mr2; }
    }
    ret err[fail.Fail].ok{};
}

pub fun merge_attrs(a: *Attrs, b: *Attrs) err[fail.Fail] {
    if (b.has_arch) {
        val ar: err[fail.Fail] = merge_arch(?a.arch, ?b.arch);
        if (sel ar.err) { ret ar; }
        a.has_arch = true;
    }

    if (b.has_stack_align) {
        if (a.has_stack_align && a.stack_align != b.stack_align) {
            ret err[fail.Fail].err{fail.message("link: riscv attribute merge: inputs disagree on Tag_RISCV_stack_align")};
        }
        a.stack_align = b.stack_align;
        a.has_stack_align = true;
    }

    if (b.has_unaligned) {
        if (!a.has_unaligned || b.unaligned > a.unaligned) { a.unaligned = b.unaligned; }
        a.has_unaligned = true;
    }

    var i: u32 = 0;
    for (i < 3) {
        if (b.has_priv[i]) {
            if (a.has_priv[i] && a.priv[i] != b.priv[i]) {
                a.has_priv[i] = false;
                a.priv[i] = 0;
            }
            or {
                a.priv[i] = b.priv[i];
                a.has_priv[i] = true;
            }
        }
        i = i + 1;
    }

    var k: u32 = 0;
    for (k < b.unknown_count) {
        val ur: err[fail.Fail] = merge_unknown(a, ?b.unknown[k]);
        if (sel ur.err) { ret ur; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun arch_string_size(a: *Arch) u32 {
    var n: u32 = 2 + decimal_size(a.xlen);
    var i: u32 = 0;
    for (i < a.count) {
        if (i > 0) { n = n + 1; }
        n = n + a.exts[i].name_len;
        n = n + decimal_size(a.exts[i].major) + 1 + decimal_size(a.exts[i].minor);
        i = i + 1;
    }
    ret n;
}

fun decimal_size(v: u32) u32 {
    var n: u32 = 1;
    var x: u32 = v;
    for (x > 9) { x = x / 10; n = n + 1; }
    ret n;
}

fun write_decimal(buf: *u8, pos: u32, v: u32) u32 {
    val n: u32 = decimal_size(v);
    var x: u32 = v;
    var i: u32 = n;
    for (i > 0) {
        i = i - 1;
        buf[pos + i] = (48 + (x % 10))::u8;
        x = x / 10;
    }
    ret n;
}

fun sort_exts(a: *Arch) {
    var i: u32 = 1;
    for (i < a.count) {
        var j: u32 = i;
        for (j > 0 && ext_before(?a.exts[j], ?a.exts[j - 1])) {
            var tmp: Ext = a.exts[j];
            a.exts[j] = a.exts[j - 1];
            a.exts[j - 1] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }
}

fun ext_before(x: *Ext, y: *Ext) bool {
    val xk: u32 = ext_class(x);
    val yk: u32 = ext_class(y);
    if (xk != yk) { ret xk < yk; }
    if (xk == 1) { ret single_rank(x.name[0]) < single_rank(y.name[0]); }
    ret name_cmp(x, y) < 0;
}

fun ext_class(e: *Ext) u32 {
    if (e.name_len == 1 && (e.name[0] == 105 || e.name[0] == 101)) { ret 0; }
    if (e.name_len == 1) { ret 1; }
    ret 2;
}

pub fun serialize(alloc: *A.Allocator, at: *Attrs, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    sort_exts(?at.arch);

    var n: u32 = 0;
    if (at.has_stack_align) { n = n + uleb_size(TAG_STACK_ALIGN) + uleb_size(at.stack_align); }
    if (at.has_arch)        { n = n + uleb_size(TAG_ARCH) + arch_string_size(?at.arch) + 1; }
    if (at.has_unaligned)   { n = n + uleb_size(TAG_UNALIGNED_ACCESS) + uleb_size(at.unaligned); }
    var i: u32 = 0;
    for (i < 3) {
        if (at.has_priv[i]) { n = n + uleb_size(priv_tag(i)) + uleb_size(at.priv[i]); }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < at.unknown_count) {
        n = n + uleb_size(at.unknown[k].tag) + at.unknown[k].value_len;
        if (at.unknown[k].is_str) { n = n + 1; }
        k = k + 1;
    }
    if (n == 0) { ret res[*u8, fail.Fail].ok{nil}; }

    val br: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel br.err) { ret res[*u8, fail.Fail].err{fail.refused(br.err)}; }
    val buf: *u8 = br.ok;

    var p: u32 = 0;
    if (at.has_stack_align) {
        p = p + write_uleb(buf, p, TAG_STACK_ALIGN);
        p = p + write_uleb(buf, p, at.stack_align);
    }
    if (at.has_arch) {
        p = p + write_uleb(buf, p, TAG_ARCH);
        p = p + write_arch_string(buf, p, ?at.arch);
        buf[p] = 0;
        p = p + 1;
    }
    if (at.has_unaligned) {
        p = p + write_uleb(buf, p, TAG_UNALIGNED_ACCESS);
        p = p + write_uleb(buf, p, at.unaligned);
    }
    i = 0;
    for (i < 3) {
        if (at.has_priv[i]) {
            p = p + write_uleb(buf, p, priv_tag(i));
            p = p + write_uleb(buf, p, at.priv[i]);
        }
        i = i + 1;
    }
    k = 0;
    for (k < at.unknown_count) {
        p = p + write_uleb(buf, p, at.unknown[k].tag);
        var b: u32 = 0;
        for (b < at.unknown[k].value_len) {
            buf[p + b] = at.unknown[k].value[b];
            b = b + 1;
        }
        p = p + at.unknown[k].value_len;
        if (at.unknown[k].is_str) { buf[p] = 0; p = p + 1; }
        k = k + 1;
    }

    @out_len = n;
    ret res[*u8, fail.Fail].ok{buf};
}

fun priv_tag(i: u32) u32 {
    if (i == 0) { ret TAG_PRIV_SPEC; }
    if (i == 1) { ret TAG_PRIV_SPEC_MINOR; }
    ret TAG_PRIV_SPEC_REVISION;
}

fun write_arch_string(buf: *u8, pos: u32, a: *Arch) u32 {
    var p: u32 = pos;
    buf[p] = 114; buf[p + 1] = 118;
    p = p + 2;
    p = p + write_decimal(buf, p, a.xlen);
    var i: u32 = 0;
    for (i < a.count) {
        if (i > 0) { buf[p] = 95; p = p + 1; }
        var k: u32 = 0;
        for (k < a.exts[i].name_len) { buf[p + k] = a.exts[i].name[k]; k = k + 1; }
        p = p + a.exts[i].name_len;
        p = p + write_decimal(buf, p, a.exts[i].major);
        buf[p] = 112;
        p = p + 1;
        p = p + write_decimal(buf, p, a.exts[i].minor);
        i = i + 1;
    }
    ret p - pos;
}

fun push_ext(a: *Arch, name: str, major: u32, minor: u32) {
    if (a.count >= MAX_EXTS) { ret; }
    var e: Ext;
    e.name_len = 0;
    for (name[e.name_len::usize] != 0) {
        e.name[e.name_len] = name[e.name_len::usize]::u8;
        e.name_len = e.name_len + 1;
    }
    e.major = major;
    e.minor = minor;
    a.exts[a.count] = e;
    a.count = a.count + 1;
}

pub fun riscv64_build_attributes(alloc: *A.Allocator, xlen_bits: u32, extension_bits: u32, float_arg_bits: u32,
                                 has_compressed: bool, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if ((xlen_bits != 32 && xlen_bits != 64) || !features.valid(extension_bits)) {
        ret res[*u8, fail.Fail].err{fail.message("riscv attributes: invalid selected ISA capabilities")};
    }
    if ((float_arg_bits != 0 && float_arg_bits != 32 && float_arg_bits != 64)
        || (float_arg_bits == 32 && !features.has(extension_bits, features.F))
        || (float_arg_bits == 64 && !features.has(extension_bits, features.D))) {
        ret res[*u8, fail.Fail].err{fail.message("riscv attributes: float ABI requires an unavailable F or D extension")};
    }
    if (has_compressed && !features.has(extension_bits, features.C)) {
        ret res[*u8, fail.Fail].err{fail.message("riscv attributes: compressed instructions require the C extension")};
    }
    var at: Attrs;
    attrs_blank(?at);
    at.arch.xlen = xlen_bits;
    var ei: usize = 0;
    for (ei < features.EXT_COUNT) {
        val spec: features.ExtSpec = features.EXTS[ei];
        if (spec.emitted && features.has(extension_bits, spec.requires)) {
            push_ext(?at.arch, spec.name, spec.major, spec.minor);
        }
        ei = ei + 1;
    }
    at.has_arch = true;

    at.stack_align = RISCV64_STACK_ALIGN;
    at.has_stack_align = true;

    at.unaligned = 0;
    at.has_unaligned = true;

    ret serialize(alloc, ?at, out_len);
}

# translation shim (#3226): the vtable slot reads the legacy carrier until C5 retypes the contract
pub fun riscv64_build_attributes_legacy(alloc: *A.Allocator, xlen_bits: u32, extension_bits: u32, float_arg_bits: u32, has_compressed: bool, out_len: *u32) R.Result[*u8, str] {
    ret fail.lower[*u8](riscv64_build_attributes(alloc, xlen_bits, extension_bits, float_arg_bits, has_compressed, out_len));
}

# refuses an object whose Tag_RISCV_arch or header flags need something the selected
# target lacks: an unknown extension, an unavailable one, another revision or XLEN
pub fun validate_selected(bytes: *u8, len: u32, xlen_bits: u32, selected: u32, flags: u32) err[fail.Fail] {
    if (!features.valid(selected)) { ret err[fail.Fail].err{fail.message("link: invalid selected RISC-V extension model")}; }
    val float_mask: u32 = elf.EF_RISCV_FLOAT_ABI_SINGLE | elf.EF_RISCV_FLOAT_ABI_DOUBLE;
    if ((flags & ~(elf.EF_RISCV_RVC | float_mask)) != 0 || (flags & float_mask) == float_mask) {
        ret err[fail.Fail].err{fail.message("link: RISC-V object flags require an unavailable extension or ABI")};
    }
    if ((flags & elf.EF_RISCV_RVC) != 0 && !features.has(selected, features.C)) {
        ret err[fail.Fail].err{fail.message("link: RISC-V object flags require the C extension")};
    }
    if (len == 0) { ret err[fail.Fail].ok{}; }
    if (bytes == nil) { ret err[fail.Fail].err{fail.message("link: missing RISC-V attribute bytes")}; }
    var at: Attrs;
    val parsed: err[fail.Fail] = parse_body(bytes, len, ?at);
    if (sel parsed.err) { ret parsed; }
    if (!at.has_arch) { ret err[fail.Fail].ok{}; }
    if (at.arch.xlen != xlen_bits) { ret err[fail.Fail].err{fail.message("link: RISC-V object XLEN differs from the selected target")}; }
    var i: u32 = 0;
    for (i < at.arch.count) {
        val e: *Ext = ?at.arch.exts[i];
        val name: str = (?e.name[0])::str;
        val idx: usize = features.ext_index(name, e.name_len::usize);
        if (idx == features.EXT_COUNT) {
            ret err[fail.Fail].err{fail.message("link: RISC-V object declares an unknown or unavailable extension")};
        }
        val spec: features.ExtSpec = features.EXTS[idx];
        if (!features.has(selected, spec.requires)) {
            ret err[fail.Fail].err{fail.message(missing_message(spec.requires & ~selected))};
        }
        if (e.major != spec.major || e.minor != spec.minor) {
            ret err[fail.Fail].err{fail.message("link: RISC-V object declares an unsupported or unspecified extension version")};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# translation shim (#3226): the vtable slot reads the legacy carrier until C5 retypes the contract
pub fun validate_selected_legacy(bytes: *u8, len: u32, xlen_bits: u32, selected: u32, flags: u32) R.Result[R.Void, str] {
    ret fail.lower_unit(validate_selected(bytes, len, xlen_bits, selected, flags));
}

# names the lowest feature the object needs and the selection does not hold, so a
# subset extension reports the superset the target is actually missing
fun missing_message(absent: u32) str {
    if ((absent & features.I) != 0)        { ret "link: RISC-V object requires the I extension"; }
    if ((absent & features.M) != 0)        { ret "link: RISC-V object requires the M extension"; }
    if ((absent & features.A) != 0)        { ret "link: RISC-V object requires the A extension"; }
    if ((absent & features.F) != 0)        { ret "link: RISC-V object requires the F extension"; }
    if ((absent & features.D) != 0)        { ret "link: RISC-V object requires the D extension"; }
    if ((absent & features.C) != 0)        { ret "link: RISC-V object requires the C extension"; }
    if ((absent & features.ZICSR) != 0)    { ret "link: RISC-V object requires the Zicsr extension"; }
    if ((absent & features.ZIFENCEI) != 0) { ret "link: RISC-V object requires the Zifencei extension"; }
    ret "link: RISC-V object declares an unknown or unavailable extension";
}

pub fun riscv64_merge_attributes(alloc: *A.Allocator, a: *u8, a_len: u32,
                                 b: *u8, b_len: u32, out_len: *u32) res[*u8, fail.Fail] {
    var acc: Attrs;
    val pa: err[fail.Fail] = parse_body(a, a_len, ?acc);
    if (sel pa.err) { ret res[*u8, fail.Fail].err{pa.err}; }

    var other: Attrs;
    val pb: err[fail.Fail] = parse_body(b, b_len, ?other);
    if (sel pb.err) { ret res[*u8, fail.Fail].err{pb.err}; }

    val mr: err[fail.Fail] = merge_attrs(?acc, ?other);
    if (sel mr.err) { ret res[*u8, fail.Fail].err{mr.err}; }

    ret serialize(alloc, ?acc, out_len);
}

# translation shim (#3226): the vtable slot reads the legacy carrier until C5 retypes the contract
pub fun riscv64_merge_attributes_legacy(alloc: *A.Allocator, a: *u8, a_len: u32, b: *u8, b_len: u32, out_len: *u32) R.Result[*u8, str] {
    ret fail.lower[*u8](riscv64_merge_attributes(alloc, a, a_len, b, b_len, out_len));
}

fun t_arch_body(buf: *u8, s: str) u32 {
    var p: u32 = 0;
    p = p + write_uleb(buf, p, TAG_ARCH);
    var i: usize = 0;
    for (s[i] != 0) { buf[p + i::u32] = s[i]::u8; i = i + 1; }
    p = p + i::u32;
    buf[p] = 0;
    ret p + 1;
}

fun t_arch_is_direct(a: *Arch, want: str) bool {
    var out: [128]u8;
    val n: u32 = write_arch_string(?out[0], 0, a);
    var i: u32 = 0;
    for (i < n) {
        if (want[i::usize] == 0 || want[i::usize]::u8 != out[i]) { ret false; }
        i = i + 1;
    }
    ret want[n::usize] == 0;
}

fun t_arch_is(buf: *u8, len: u32, want: str) bool {
    var at: Attrs;
    val r_676: err[fail.Fail] = parse_body(buf, len, ?at);
    if (sel r_676.err) { ret false; }
    if (!at.has_arch) { ret false; }
    ret t_arch_is_direct(?at.arch, want);
}

test "mach.lang.target.isa.riscv.attributes.parse_arch:both_spellings_and_ordering" {
    var a: Arch;
    if (!parse_arch("rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0"::*u8, 33, ?a)) { ret 1; }
    if (a.xlen != 64 || a.count != 6) { ret 1; }
    if (a.exts[0].name[0] != 105 || a.exts[0].major != 2 || a.exts[0].minor != 1) { ret 1; }
    if (a.exts[5].name[0] != 99 || a.exts[5].major != 2 || a.exts[5].minor != 0) { ret 1; }

    var b: Arch;
    if (!parse_arch("rv64icma"::*u8, 8, ?b)) { ret 1; }
    if (b.xlen != 64 || b.count != 4) { ret 1; }
    sort_exts(?b);
    if (!t_arch_is_direct(?b, "rv64i0p0_m0p0_a0p0_c0p0")) { ret 1; }

    var z: Arch;
    if (!parse_arch("rv64i2p1_zicsr2p0_zifencei2p0"::*u8, 29, ?z)) { ret 1; }
    if (z.count != 3) { ret 1; }
    sort_exts(?z);
    if (!t_arch_is_direct(?z, "rv64i2p1_zicsr2p0_zifencei2p0")) { ret 1; }

    var bad: Arch;
    if (parse_arch("rv128i2p1"::*u8, 9, ?bad))  { ret 1; }
    if (parse_arch("x86_64"::*u8, 6, ?bad))     { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.attributes.parse_arch:a_digit_run_that_overflows_is_refused_not_wrapped" {
    var wrapped: Arch;
    if (parse_arch("rv4294967360i2p1"::*u8, 16, ?wrapped))                { ret 1; }
    if (parse_arch("rv18446744073709551680i2p1"::*u8, 26, ?wrapped))      { ret 1; }

    var version: Arch;
    if (parse_arch("rv64i4294967297p1"::*u8, 17, ?version))               { ret 2; }
    if (parse_arch("rv64i2p4294967297"::*u8, 17, ?version))               { ret 2; }

    var good: Arch;
    if (!parse_arch("rv64i2p1"::*u8, 8, ?good))                           { ret 3; }
    if (good.xlen != 64 || good.count != 1)                               { ret 3; }
    if (good.exts[0].major != 2 || good.exts[0].minor != 1)               { ret 3; }
    ret 0;
}

test "mach.lang.target.isa.riscv.attributes.parse_arch:an_arch_naming_no_extension_is_refused" {
    var none: Arch;
    if (parse_arch("rv64_"::*u8, 5, ?none))          { ret 1; }
    if (parse_arch("rv64_____"::*u8, 9, ?none))      { ret 1; }
    if (parse_arch("rv32_"::*u8, 5, ?none))          { ret 1; }

    var one: Arch;
    if (!parse_arch("rv64i"::*u8, 5, ?one))          { ret 2; }
    if (one.count != 1)                              { ret 2; }
    ret 0;
}

test "mach.lang.target.isa.riscv.attributes.merge_attributes:disagreeing_inputs" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var lhs: [96]u8;
    var rhs: [96]u8;
    val ln: u32 = t_arch_body(?lhs[0], "rv64i2p1_m2p0_a2p1_f2p2_d2p2");
    val rn: u32 = t_arch_body(?rhs[0], "rv64i2p1_c2p0_zicsr2p0");
    var out_len: u32 = 0;
    val mr: res[*u8, fail.Fail] =
        riscv64_merge_attributes(?alloc, ?lhs[0], ln, ?rhs[0], rn, ?out_len);
    if (sel mr.err) { ret 1; }
    if (!t_arch_is(mr.ok, out_len, "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0")) { ret 1; }

    val an: u32 = t_arch_body(?lhs[0], "rv64i2p0_m2p0");
    val bn: u32 = t_arch_body(?rhs[0], "rv64i2p1_m1p0");
    var vlen: u32 = 0;
    val vr: res[*u8, fail.Fail] =
        riscv64_merge_attributes(?alloc, ?lhs[0], an, ?rhs[0], bn, ?vlen);
    if (sel vr.err) { ret 1; }
    if (!t_arch_is(vr.ok, vlen, "rv64i2p1_m2p0")) { ret 1; }
    var wlen: u32 = 0;
    val wr: res[*u8, fail.Fail] =
        riscv64_merge_attributes(?alloc, ?rhs[0], bn, ?lhs[0], an, ?wlen);
    if (sel wr.err) { ret 1; }
    if (!t_arch_is(wr.ok, wlen, "rv64i2p1_m2p0")) { ret 1; }

    var elen: u32 = 0;
    val er: res[*u8, fail.Fail] =
        riscv64_merge_attributes(?alloc, ?lhs[0], an, nil, 0, ?elen);
    if (sel er.err) { ret 1; }
    if (!t_arch_is(er.ok, elen, "rv64i2p0_m2p0")) { ret 1; }

    val x32: u32 = t_arch_body(?lhs[0], "rv32i2p1");
    val x64: u32 = t_arch_body(?rhs[0], "rv64i2p1");
    var xo: u32 = 0;
    val r_770: res[*u8, fail.Fail] =  riscv64_merge_attributes(?alloc, ?lhs[0], x32, ?rhs[0], x64, ?xo);
    if (!sel r_770.err) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.attributes.merge_attrs:non_union_tags" {
    var a: Attrs;
    var b: Attrs;

    attrs_blank(?a); attrs_blank(?b);
    a.stack_align = 16; a.has_stack_align = true;
    b.stack_align = 8;  b.has_stack_align = true;
    val r_781: err[fail.Fail] = merge_attrs(?a, ?b);
    if (!sel r_781.err) { ret 1; }

    attrs_blank(?a); attrs_blank(?b);
    a.stack_align = 16; a.has_stack_align = true;
    val r_785: err[fail.Fail] = merge_attrs(?a, ?b);
    if (sel r_785.err) { ret 1; }
    if (!a.has_stack_align || a.stack_align != 16) { ret 1; }

    attrs_blank(?a); attrs_blank(?b);
    a.unaligned = 0; a.has_unaligned = true;
    b.unaligned = 1; b.has_unaligned = true;
    val r_791: err[fail.Fail] = merge_attrs(?a, ?b);
    if (sel r_791.err) { ret 1; }
    if (!a.has_unaligned || a.unaligned != 1) { ret 1; }
    attrs_blank(?a); attrs_blank(?b);
    a.unaligned = 1; a.has_unaligned = true;
    b.unaligned = 0; b.has_unaligned = true;
    val r_796: err[fail.Fail] = merge_attrs(?a, ?b);
    if (sel r_796.err) { ret 1; }
    if (a.unaligned != 1) { ret 1; }

    attrs_blank(?a); attrs_blank(?b);
    a.priv[0] = 1; a.has_priv[0] = true;
    b.priv[0] = 2; b.has_priv[0] = true;
    val r_802: err[fail.Fail] = merge_attrs(?a, ?b);
    if (sel r_802.err) { ret 1; }
    if (a.has_priv[0]) { ret 1; }

    attrs_blank(?a); attrs_blank(?b);
    a.unknown[0].tag = 14; a.unknown[0].is_str = false;
    a.unknown[0].value[0] = 7; a.unknown[0].value_len = 1;
    a.unknown_count = 1;
    b.unknown[0].tag = 14; b.unknown[0].is_str = false;
    b.unknown[0].value[0] = 7; b.unknown[0].value_len = 1;
    b.unknown_count = 1;
    val r_812: err[fail.Fail] = merge_attrs(?a, ?b);
    if (sel r_812.err) { ret 1; }
    if (a.unknown_count != 1) { ret 1; }
    b.unknown[0].value[0] = 9;
    val r_815: err[fail.Fail] = merge_attrs(?a, ?b);
    if (sel r_815.err) { ret 1; }
    if (a.unknown_count != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.attributes.build_attributes:selected_target_and_foreign_admission" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var plain_len: u32 = 0;
    val pr: res[*u8, fail.Fail] = riscv64_build_attributes(?alloc, 64, features.G, 64, false, ?plain_len);
    if (sel pr.err) { ret 1; }
    fin { A.deallocate[u8](?alloc, pr.ok, plain_len::usize); }
    if (!t_arch_is(pr.ok, plain_len, "rv64i2p1_m2p0_a2p1_f2p2_d2p2_zicsr2p0_zifencei2p0")) { ret 1; }

    var comp_len: u32 = 0;
    val cr: res[*u8, fail.Fail] = riscv64_build_attributes(?alloc, 64, features.DEFAULT64, 64, true, ?comp_len);
    if (sel cr.err) { ret 1; }
    fin { A.deallocate[u8](?alloc, cr.ok, comp_len::usize); }
    if (!t_arch_is(cr.ok, comp_len, "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0")) { ret 1; }

    var soft_len: u32 = 0;
    val sr: res[*u8, fail.Fail] = riscv64_build_attributes(?alloc, 64, features.I | features.M, 0, false, ?soft_len);
    if (sel sr.err) { ret 1; }
    fin { A.deallocate[u8](?alloc, sr.ok, soft_len::usize); }
    if (!t_arch_is(sr.ok, soft_len, "rv64i2p1_m2p0")) { ret 1; }

    var w32_len: u32 = 0;
    val wr: res[*u8, fail.Fail] = riscv64_build_attributes(?alloc, 32, features.DEFAULT32, 0, false, ?w32_len);
    if (sel wr.err) { ret 1; }
    fin { A.deallocate[u8](?alloc, wr.ok, w32_len::usize); }
    if (!t_arch_is(wr.ok, w32_len, "rv32i2p1_m2p0_a2p1_c2p0")) { ret 1; }

    var at: Attrs;
    val r_849: err[fail.Fail] = parse_body(pr.ok, plain_len, ?at);
    if (sel r_849.err) { ret 1; }
    if (!at.has_stack_align || at.stack_align != RISCV64_STACK_ALIGN) { ret 1; }
    if (!at.has_unaligned || at.unaligned != 0) { ret 1; }
    var refused_len: u32 = 99;
    val absent_float: res[*u8, fail.Fail] = riscv64_build_attributes(?alloc, 32, features.DEFAULT32, 64, false, ?refused_len);
    if (sel absent_float.ok) { ret 2; }
    if (refused_len != 0) { ret 2; }
    val absent_c: res[*u8, fail.Fail] = riscv64_build_attributes(?alloc, 64, features.I, 0, true, ?refused_len);
    if (sel absent_c.ok) { ret 3; }
    if (refused_len != 0) { ret 3; }
    val r_859: err[fail.Fail] = validate_selected(cr.ok, comp_len, 64, features.DEFAULT64, 0);
    if (sel r_859.err) { ret 4; }
    val r_860: err[fail.Fail] = validate_selected(sr.ok, soft_len, 64, features.DEFAULT64, 0);
    if (sel r_860.err) { ret 5; }
    val r_861: err[fail.Fail] = validate_selected(cr.ok, comp_len, 64, features.I | features.M, 0);
    if (sel r_861.ok) { ret 6; }
    val r_862: err[fail.Fail] = validate_selected(wr.ok, w32_len, 64, features.DEFAULT64, 0);
    if (sel r_862.ok) { ret 7; }
    var raw: [128]u8;
    var raw_len: u32 = t_arch_body(?raw[0], "rv64i2p1_zba1p0");
    val r_865: err[fail.Fail] = validate_selected(?raw[0], raw_len, 64, features.DEFAULT64, 0);
    if (sel r_865.ok) { ret 8; }
    raw_len = t_arch_body(?raw[0], "rv64i2p0");
    val r_867: err[fail.Fail] = validate_selected(?raw[0], raw_len, 64, features.DEFAULT64, 0);
    if (sel r_867.ok) { ret 9; }
    raw_len = t_arch_body(?raw[0], "rv64i");
    val r_869: err[fail.Fail] = validate_selected(?raw[0], raw_len, 64, features.DEFAULT64, 0);
    if (sel r_869.ok) { ret 10; }
    raw_len = t_arch_body(?raw[0], "rv64i2p1");
    val r_871: err[fail.Fail] = validate_selected(?raw[0], raw_len, 64, features.DEFAULT64, 0);
    if (sel r_871.err) { ret 11; }
    val r_872: err[fail.Fail] = validate_selected(?raw[0], raw_len - 1, 64, features.DEFAULT64, 0);
    if (sel r_872.ok) { ret 12; }
    raw_len = t_arch_body(?raw[0], "rv64i2p0_i2p1");
    val r_874: err[fail.Fail] = validate_selected(?raw[0], raw_len, 64, features.DEFAULT64, 0);
    if (sel r_874.ok) { ret 13; }
    raw_len = t_arch_body(?raw[0], "rv64i2p0");
    raw_len = raw_len + t_arch_body(?raw[raw_len], "rv64i2p1");
    val r_877: err[fail.Fail] = validate_selected(?raw[0], raw_len, 64, features.DEFAULT64, 0);
    if (sel r_877.ok) { ret 14; }
    val r_878: err[fail.Fail] = validate_selected(nil, 0, 64, features.I, elf.EF_RISCV_RVC);
    if (sel r_878.ok) { ret 15; }
    val r_879: err[fail.Fail] = validate_selected(nil, 0, 64, features.I | features.C, elf.EF_RISCV_RVC);
    if (sel r_879.err) { ret 16; }
    val unavailable_flags: [5]u32 = [5]u32 { 6, 8, 16, 32, 0x1000000 };
    var flag_i: usize = 0;
    for (flag_i < 5) {
        val r_883: err[fail.Fail] = validate_selected(nil, 0, 64, features.DEFAULT64, unavailable_flags[flag_i]);
        if (sel r_883.ok) { ret 17; }
        flag_i = flag_i + 1;
    }
    ret 0;
}

test "mach.lang.target.isa.riscv.attributes.validate_selected:toolchain_decomposed_extensions" {
    var raw: [192]u8;
    var n: u32 = t_arch_body(?raw[0],
        "rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0_zmmul1p0_zaamo1p0_zalrsc1p0_zca1p0_zcd1p0");
    val r_893: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.DEFAULT64, 0);
    if (sel r_893.err) { ret 1; }

    n = t_arch_body(?raw[0], "rv64i2p1_zmmul1p0");
    val r_896: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.I | features.M, 0);
    if (sel r_896.err) { ret 2; }
    val r_897: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.I, 0);
    if (sel r_897.ok) { ret 3; }

    n = t_arch_body(?raw[0], "rv64i2p1_zcd1p0");
    val r_900: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.I | features.C, 0);
    if (sel r_900.ok) { ret 4; }
    val r_901: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.DEFAULT64, 0);
    if (sel r_901.err) { ret 5; }

    n = t_arch_body(?raw[0], "rv64i2p1_zbb1p0");
    val r_904: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.DEFAULT64, 0);
    if (sel r_904.ok) { ret 6; }
    n = t_arch_body(?raw[0], "rv64i2p1_v1p0");
    val r_906: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.DEFAULT64, 0);
    if (sel r_906.ok) { ret 7; }

    n = t_arch_body(?raw[0], "rv64i2p1_zmmul2p0");
    val r_909: err[fail.Fail] = validate_selected(?raw[0], n, 64, features.DEFAULT64, 0);
    if (sel r_909.ok) { ret 8; }
    ret 0;
}
