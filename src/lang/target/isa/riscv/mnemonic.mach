    isa_asm.Mnemonic{name: "mulhsu", code: inst.MULHSU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "mulhu", code: inst.MULHU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "mulh", code: inst.MULH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "mul", code: inst.MUL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "divu", code: inst.DIVU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "div", code: inst.DIV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "remu", code: inst.REMU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "rem", code: inst.REM::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},

