    isa_asm.Mnemonic{name: "lh", code: inst.LH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOAD, words: 1},
    isa_asm.Mnemonic{name: "lw", code: inst.LW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOAD, words: 1},
    isa_asm.Mnemonic{name: "ld", code: inst.LD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOAD, words: 1},
