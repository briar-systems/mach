    isa_asm.Mnemonic{name: "slli", code: inst.SLLI::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "srli", code: inst.SRLI::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "srai", code: inst.SRAI::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},

    isa_asm.Mnemonic{name: "lbu", code: inst.LBU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOAD, words: 1},
    isa_asm.Mnemonic{name: "lhu", code: inst.LHU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOAD, words: 1},
    isa_asm.Mnemonic{name: "lwu", code: inst.LWU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOAD, words: 1},
