    isa_asm.Mnemonic{name: "blez", code: inst.BGE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH_Z2, words: 1},
    isa_asm.Mnemonic{name: "bgtz", code: inst.BLT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH_Z2, words: 1},
    isa_asm.Mnemonic{name: "bltu", code: inst.BLTU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 1},
    isa_asm.Mnemonic{name: "bgeu", code: inst.BGEU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 1},
    isa_asm.Mnemonic{name: "bgtu", code: inst.BLTU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH_SW, words: 1},
    isa_asm.Mnemonic{name: "bleu", code: inst.BGEU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH_SW, words: 1},
