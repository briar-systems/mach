# the inline assembly mnemonic rows: each spelling, its operand pattern and the machines that take it
use std.types.size.usize;

use isa_asm:    mach.lang.target.isa.asm;
use riscv_emit: mach.lang.target.isa.riscv.emit;
use mach.lang.target.isa.riscv.inst;

pub val PATTERN_ECALL: u16 = 1;

pub val PATTERN_EBREAK: u16 = 2;

pub val PATTERN_NOP: u16 = 3;

pub val PATTERN_RET: u16 = 4;

pub val PATTERN_FENCE: u16 = 5;

pub val PATTERN_PAUSE: u16 = 6;

pub val PATTERN_RRR: u16 = 7;

pub val PATTERN_RRI: u16 = 8;

pub val PATTERN_SHIFT: u16 = 9;

pub val PATTERN_LOAD: u16 = 10;

pub val PATTERN_STORE: u16 = 11;

pub val PATTERN_UIMM: u16 = 12;

pub val PATTERN_BRANCH: u16 = 13;

pub val PATTERN_BRANCH_SW: u16 = 14;

pub val PATTERN_BRANCH_Z1: u16 = 15;

pub val PATTERN_BRANCH_Z2: u16 = 16;

pub val PATTERN_J: u16 = 17;

pub val PATTERN_JAL: u16 = 18;

pub val PATTERN_JR: u16 = 19;

pub val PATTERN_JALR: u16 = 20;

pub val PATTERN_MV: u16 = 21;

pub val PATTERN_NOT: u16 = 22;

pub val PATTERN_SEQZ: u16 = 23;

pub val PATTERN_NEG: u16 = 24;

pub val PATTERN_SNEZ: u16 = 25;

pub val PATTERN_LI: u16 = 26;

pub val PATTERN_LA: u16 = 27;

pub val PATTERN_CALL: u16 = 28;

pub val PATTERN_TAIL: u16 = 29;

pub val PATTERN_AMO: u16 = 30;

pub val PATTERN_AMO_LR: u16 = 31;

pub val PATTERN_CSR: u16 = 32;

pub val PATTERN_CSR_I: u16 = 33;

pub val PATTERN_CSRR: u16 = 34;

pub val PATTERN_CSRW: u16 = 35;

pub val PATTERN_CSRWI: u16 = 36;

pub val PATTERN_RDCYCLE: u16 = 37;

pub val PATTERN_RDTIME: u16 = 38;

pub val PATTERN_RDINSTRET: u16 = 39;

pub val FLAG_AQ: u16 = 0x0100;

pub val FLAG_RL: u16 = 0x0200;

pub fun pattern(flags: u16) u16 {
    ret flags & 0x00FF;
}

pub val ROW_COUNT: usize = 107;

pub val ROWS: [ROW_COUNT]isa_asm.Mnemonic = [ROW_COUNT]isa_asm.Mnemonic{
    isa_asm.Mnemonic{name: "ecall", code: inst.ECALL::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_ECALL, words: 1},
    isa_asm.Mnemonic{name: "ebreak", code: inst.EBREAK::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_EBREAK, words: 1},
    isa_asm.Mnemonic{name: "nop", code: inst.ADDI::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NOP, words: 1},
    isa_asm.Mnemonic{name: "ret", code: inst.JALR::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: riscv_emit.RA_READ, flags: PATTERN_RET, words: 1},
    isa_asm.Mnemonic{name: "fence", code: inst.FENCE::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_FENCE, words: 1},
    isa_asm.Mnemonic{name: "pause", code: inst.PAUSE::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_PAUSE, words: 1},

    isa_asm.Mnemonic{name: "addw", code: inst.ADDW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "subw", code: inst.SUBW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "sllw", code: inst.SLLW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "srlw", code: inst.SRLW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "sraw", code: inst.SRAW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "mulw", code: inst.MULW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "divuw", code: inst.DIVUW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "divw", code: inst.DIVW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "remuw", code: inst.REMUW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "remw", code: inst.REMW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "add", code: inst.ADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "sub", code: inst.SUB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "sll", code: inst.SLL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "sltu", code: inst.SLTU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "slt", code: inst.SLT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "xor", code: inst.XOR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "srl", code: inst.SRL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "sra", code: inst.SRA::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
    isa_asm.Mnemonic{name: "or", code: inst.OR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_RRR, words: 1},
