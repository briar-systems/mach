    iasm.Mnemonic{ name: "csrs",   code: inst.CSRRS::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRW,  words: 1 },
    iasm.Mnemonic{ name: "csrc",   code: inst.CSRRC::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRW,  words: 1 },
    iasm.Mnemonic{ name: "csrwi",  code: inst.CSRRWI::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRWI, words: 1 },
    iasm.Mnemonic{ name: "csrsi",  code: inst.CSRRSI::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRWI, words: 1 },
    iasm.Mnemonic{ name: "csrci",  code: inst.CSRRCI::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRWI, words: 1 },

    iasm.Mnemonic{ name: "rdcycle",   code: inst.CSRRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_RDCYCLE,   words: 1 },
    iasm.Mnemonic{ name: "rdtime",    code: inst.CSRRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_RDTIME,    words: 1 },
    iasm.Mnemonic{ name: "rdinstret", code: inst.CSRRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_RDINSTRET, words: 1 },
};

fun rv_decode_amo(body: str, lo: usize, hi: usize, m: *iasm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !iasm.is_space(body[end])) { end = end + 1; }
    var len: usize = end - lo;
    if (len < 4) { ret false; }

    var order: u16 = 0;
    if (len >= 5 && str_region_equals(body, lo + len - 5, 5, ".aqrl")) { order = RVF_AQ | RVF_RL; len = len - 5; }
    or (len >= 3 && str_region_equals(body, lo + len - 3, 3, ".aq"))   { order = RVF_AQ;           len = len - 3; }
    or (len >= 3 && str_region_equals(body, lo + len - 3, 3, ".rl"))   { order = RVF_RL;           len = len - 3; }
    if (len < 4) { ret false; }

    var word: bool = false;
    if (str_region_equals(body, lo + len - 2, 2, ".w"))      { word = true; }
    or (str_region_equals(body, lo + len - 2, 2, ".d"))      { word = false; }
    or { ret false; }
    val blen: usize = len - 2;

    var code: u32 = 0;
    var pat: u16 = RVP_AMO;
    if (str_region_equals(body, lo, blen, "lr"))           { code = inst.LR_W::u32; pat = RVP_AMO_LR; }
    or (str_region_equals(body, lo, blen, "sc"))           { code = inst.SC_W::u32; }
    or (str_region_equals(body, lo, blen, "amoswap"))      { code = inst.AMOSWAP_W::u32; }
    or (str_region_equals(body, lo, blen, "amoadd"))       { code = inst.AMOADD_W::u32; }
    or (str_region_equals(body, lo, blen, "amoxor"))       { code = inst.AMOXOR_W::u32; }
    or (str_region_equals(body, lo, blen, "amoand"))       { code = inst.AMOAND_W::u32; }
    or (str_region_equals(body, lo, blen, "amoor"))        { code = inst.AMOOR_W::u32; }
    or (str_region_equals(body, lo, blen, "amominu"))      { code = inst.AMOMINU_W::u32; }
    or (str_region_equals(body, lo, blen, "amomaxu"))      { code = inst.AMOMAXU_W::u32; }
    or (str_region_equals(body, lo, blen, "amomin"))       { code = inst.AMOMIN_W::u32; }
    or (str_region_equals(body, lo, blen, "amomax"))       { code = inst.AMOMAX_W::u32; }
    or { ret false; }
    if (!word) { code = code + 1; }

    m.name     = nil;
    m.code     = code;
    m.form     = iasm.AF_OPS;
    m.writes   = iasm.AW_OP0;
    m.implicit = 0;
    m.flags    = pat | order;
    m.words    = 1;
    @n_out     = end - lo;
    ret true;
}

val RVFMT_R: u8 = 0;
val RVFMT_I: u8 = 1;
val RVFMT_S: u8 = 2;
val RVFMT_B: u8 = 3;
val RVFMT_U: u8 = 4;
val RVFMT_J: u8 = 5;

fun rv_fields(op: inst.MachOp, fmt: *u8, opcode: *u32, f3: *u32, f7: *u32) bool {
    @fmt = RVFMT_R; @opcode = 0; @f3 = 0; @f7 = F7_ZERO;

    if (op == inst.ADD)  { @opcode = OPC_OP; @f3 = F3_ADD;  ret true; }
    if (op == inst.SLL)  { @opcode = OPC_OP; @f3 = F3_SLL;  ret true; }
    if (op == inst.SLT)  { @opcode = OPC_OP; @f3 = F3_SLT;  ret true; }
    if (op == inst.SLTU) { @opcode = OPC_OP; @f3 = F3_SLTU; ret true; }
    if (op == inst.XOR)  { @opcode = OPC_OP; @f3 = F3_XOR;  ret true; }
    if (op == inst.SRL)  { @opcode = OPC_OP; @f3 = F3_SRL;  ret true; }
    if (op == inst.OR)   { @opcode = OPC_OP; @f3 = F3_OR;   ret true; }
    if (op == inst.AND)  { @opcode = OPC_OP; @f3 = F3_AND;  ret true; }
    if (op == inst.SUB)  { @opcode = OPC_OP; @f3 = F3_ADD; @f7 = F7_SUB; ret true; }
    if (op == inst.SRA)  { @opcode = OPC_OP; @f3 = F3_SRL; @f7 = F7_SUB; ret true; }
    if (op == inst.ADDW) { @opcode = OPC_OP_32; @f3 = F3_ADD; ret true; }
    if (op == inst.SLLW) { @opcode = OPC_OP_32; @f3 = F3_SLL; ret true; }
    if (op == inst.SRLW) { @opcode = OPC_OP_32; @f3 = F3_SRL; ret true; }
    if (op == inst.SUBW) { @opcode = OPC_OP_32; @f3 = F3_ADD; @f7 = F7_SUB; ret true; }
    if (op == inst.SRAW) { @opcode = OPC_OP_32; @f3 = F3_SRL; @f7 = F7_SUB; ret true; }

    if (op == inst.MUL)    { @opcode = OPC_OP; @f3 = F3_ADD;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULH)   { @opcode = OPC_OP; @f3 = F3_SLL;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULHSU) { @opcode = OPC_OP; @f3 = F3_SLT;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULHU)  { @opcode = OPC_OP; @f3 = F3_SLTU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIV)    { @opcode = OPC_OP; @f3 = F3_DIV;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIVU)   { @opcode = OPC_OP; @f3 = F3_DIVU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.REM)    { @opcode = OPC_OP; @f3 = F3_REM;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.REMU)   { @opcode = OPC_OP; @f3 = F3_REMU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULW)   { @opcode = OPC_OP_32; @f3 = F3_ADD;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIVW)   { @opcode = OPC_OP_32; @f3 = F3_DIV;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIVUW)  { @opcode = OPC_OP_32; @f3 = F3_DIVU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.REMW)   { @opcode = OPC_OP_32; @f3 = F3_REM;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.REMUW)  { @opcode = OPC_OP_32; @f3 = F3_REMU; @f7 = F7_MULDIV; ret true; }

    if (op == inst.ADDI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_ADD;  ret true; }
    if (op == inst.SLTI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SLT;  ret true; }
    if (op == inst.SLTIU) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SLTU; ret true; }
    if (op == inst.XORI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_XOR;  ret true; }
    if (op == inst.ORI)   { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_OR;   ret true; }
    if (op == inst.ANDI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_AND;  ret true; }
    if (op == inst.SLLI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SLL;  ret true; }
    if (op == inst.SRLI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SRL;  ret true; }
    if (op == inst.SRAI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SRL;  ret true; }
    if (op == inst.ADDIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_ADD; ret true; }
    if (op == inst.SLLIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_SLL; ret true; }
    if (op == inst.SRLIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_SRL; ret true; }
    if (op == inst.SRAIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_SRL; ret true; }

    if (op == inst.LB)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x0; ret true; }
    if (op == inst.LH)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x1; ret true; }
    if (op == inst.LW)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x2; ret true; }
    if (op == inst.LD)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x3; ret true; }
    if (op == inst.LBU)  { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x4; ret true; }
    if (op == inst.LHU)  { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x5; ret true; }
    if (op == inst.LWU)  { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x6; ret true; }
    if (op == inst.JALR) { @fmt = RVFMT_I; @opcode = OPC_JALR; @f3 = F3_ADD; ret true; }
    if (op == inst.SB) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x0; ret true; }
    if (op == inst.SH) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x1; ret true; }
    if (op == inst.SW) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x2; ret true; }
    if (op == inst.SD) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x3; ret true; }

    if (op == inst.ECALL || op == inst.EBREAK) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM;   @f3 = F3_ADD; ret true; }
    if (op == inst.FENCE || op == inst.PAUSE)  { @fmt = RVFMT_I; @opcode = OPC_MISC_MEM; @f3 = F3_ADD; ret true; }

    if (op == inst.CSRRW)  { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRW;  ret true; }
    if (op == inst.CSRRS)  { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRS;  ret true; }
    if (op == inst.CSRRC)  { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRC;  ret true; }
    if (op == inst.CSRRWI) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRWI; ret true; }
    if (op == inst.CSRRSI) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRSI; ret true; }
    if (op == inst.CSRRCI) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRCI; ret true; }

    if (op == inst.BEQ)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BEQ;  ret true; }
    if (op == inst.BNE)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BNE;  ret true; }
    if (op == inst.BLT)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BLT;  ret true; }
    if (op == inst.BGE)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BGE;  ret true; }
    if (op == inst.BLTU) { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BLTU; ret true; }
    if (op == inst.BGEU) { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BGEU; ret true; }
    if (op == inst.LUI)   { @fmt = RVFMT_U; @opcode = OPC_LUI;   ret true; }
    if (op == inst.AUIPC) { @fmt = RVFMT_U; @opcode = OPC_AUIPC; ret true; }
    if (op == inst.JAL)   { @fmt = RVFMT_J; @opcode = OPC_JAL;   ret true; }

    if (op >= inst.LR_W && op <= inst.AMOMAXU_D) {
        @opcode = OPC_AMO;
        @f3     = F3_AMO_D;
        if (rv_amo_is_word(op)) { @f3 = F3_AMO_W; }
        @f7 = rv_amo_funct5(op) << 2;
        ret true;
    }
    ret false;
}

fun rv_amo_is_word(op: inst.MachOp) bool {
    ret ((op - inst.LR_W) & 1) == 0;
}

fun rv_amo_funct5(op: inst.MachOp) u32 {
    if (op == inst.LR_W || op == inst.LR_D)             { ret A5_LR; }
    if (op == inst.SC_W || op == inst.SC_D)             { ret A5_SC; }
    if (op == inst.AMOSWAP_W || op == inst.AMOSWAP_D)   { ret A5_AMOSWAP; }
    if (op == inst.AMOADD_W || op == inst.AMOADD_D)     { ret A5_AMOADD; }
    if (op == inst.AMOXOR_W || op == inst.AMOXOR_D)     { ret A5_AMOXOR; }
    if (op == inst.AMOAND_W || op == inst.AMOAND_D)     { ret A5_AMOAND; }
    if (op == inst.AMOOR_W || op == inst.AMOOR_D)       { ret A5_AMOOR; }
    if (op == inst.AMOMIN_W || op == inst.AMOMIN_D)     { ret A5_AMOMIN; }
    if (op == inst.AMOMAX_W || op == inst.AMOMAX_D)     { ret A5_AMOMAX; }
    if (op == inst.AMOMINU_W || op == inst.AMOMINU_D)   { ret A5_AMOMINU; }
    ret A5_AMOMAXU;
}

fun rv_operand(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    @op = iasm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm operand")}; }

    if (c.body[lo] == '{'::char) {
        var off: i64 = 0;
        val bound_r: res[bool, fail.Fail] = iasm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op = iasm.op_mem(RSP::i32, off, -1, 0, 8);
            ret err[fail.Fail].ok{};
        }
        op.kind     = iasm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    val ri: i32 = asm_reg_index_region(c.body, lo, hi);
    if (ri >= 0) { @op = iasm.op_reg(ri, 8); ret err[fail.Fail].ok{}; }

    if (c.body[lo] == '%'::char) { ret rv_modifier(c, lo, hi, op); }

    if (c.body[hi - 1] == ')'::char) { ret rv_mem(c, lo, hi, op); }

    val iv: opt[i64] = iasm.region_i64(c.body, lo, hi);
    if (sel iv.some) { @op = iasm.op_imm(iv.some, 8); ret err[fail.Fail].ok{}; }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: malformed inline-asm operand")};
}

fun rv_modifier(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    if (c.body[hi - 1] != ')'::char) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm relocation modifier")}; }
    var open: usize = lo;
    var found: bool = false;
    for (open < hi && !found) {
        if (c.body[open] == '('::char) { found = true; } or { open = open + 1; }
    }
    if (!found) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm relocation modifier")}; }

    var mod: isa.SymModifier = isa.SYM_MOD_NONE;
    val nlen: usize = open - lo - 1;
    if (str_region_equals(c.body, lo + 1, nlen, "pcrel_hi") && nlen == 8)      { mod = isa.SYM_MOD_PCREL_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "pcrel_lo") && nlen == 8)      { mod = isa.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_pcrel_hi") && nlen == 12) { mod = isa.SYM_MOD_GOT_HI; }
    or {
        ret err[fail.Fail].err{fail.message(iasm.span_message(c,
            "encode: unsupported riscv64 inline-asm relocation modifier '", lo, hi, "'",
            "encode: unsupported riscv64 inline-asm relocation modifier"))};
    }
    if (!iasm.is_sym_region(c.body, open + 1, hi - 1)) {
        ret err[fail.Fail].err{fail.message("encode: malformed inline-asm relocation modifier")};
    }
    @op = iasm.op_sym(open + 1, hi - 1 - (open + 1), mod, 8);
    ret err[fail.Fail].ok{};
}

fun rv_mem(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    var open: usize = lo;
    var found: bool = false;
    for (open < hi && !found) {
        if (c.body[open] == '('::char) { found = true; } or { open = open + 1; }
    }
    if (!found) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }

    var bbuf: [24]u8;
    if (!iasm.copy_region(c.body, open + 1, hi - 1, ?bbuf[0], 24)) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }
    val base: i32 = asm_reg_index((?bbuf[0])::str);
    if (base < 0) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }

    var disp: i64 = 0;
    var flags: u8 = 0;
    var a: usize = lo;
    var b: usize = open;
    for (a < b && iasm.is_space(c.body[a])) { a = a + 1; }
    for (b > a && iasm.is_space(c.body[b - 1])) { b = b - 1; }
    if (b > a) {
        val dv: opt[i64] = iasm.region_i64(c.body, a, b);
        if (!sel dv.some) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }
        disp  = dv.some;
        flags = iasm.AOF_HAS_DISP;
    }
    @op = iasm.op_mem(base, disp, -1, 0, 8);
    op.flags = flags;
    ret err[fail.Fail].ok{};
}

fun rv_is_addr(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_MEM || op.kind == iasm.AOP_BIND;
}

fun rv_name_eq(name: str, want: str) bool {
    val n: usize = str_len(name);
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var c: u32 = name[i]::u32;
        if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
        if (c != want[i]::u32) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun rv_csr_name(name: str, out: *u32) bool {
    if (rv_name_eq(name, "sstatus")) { @out = 0x100; ret true; }
    if (rv_name_eq(name, "sie"))     { @out = 0x104; ret true; }
    if (rv_name_eq(name, "stvec"))   { @out = 0x105; ret true; }
    if (rv_name_eq(name, "sepc"))    { @out = 0x141; ret true; }
    if (rv_name_eq(name, "scause"))  { @out = 0x142; ret true; }
    if (rv_name_eq(name, "sip"))     { @out = 0x144; ret true; }
    if (rv_name_eq(name, "satp"))    { @out = 0x180; ret true; }

    if (rv_name_eq(name, "mstatus")) { @out = 0x300; ret true; }
    if (rv_name_eq(name, "mie"))     { @out = 0x304; ret true; }
    if (rv_name_eq(name, "mtvec"))   { @out = 0x305; ret true; }
    if (rv_name_eq(name, "mepc"))    { @out = 0x341; ret true; }
    if (rv_name_eq(name, "mcause"))  { @out = 0x342; ret true; }
    if (rv_name_eq(name, "mip"))     { @out = 0x344; ret true; }
    if (rv_name_eq(name, "mhartid")) { @out = 0xF14; ret true; }

    if (rv_name_eq(name, "cycle"))   { @out = 0xC00; ret true; }
    if (rv_name_eq(name, "time"))    { @out = 0xC01; ret true; }
    if (rv_name_eq(name, "instret")) { @out = 0xC02; ret true; }

    ret false;
}

fun rv_csr_operand(c: *iasm.Cursor, s: *iasm.Stmt, idx: u32, op: *iasm.Operand, out: *u32) bool {
    if (op.kind == iasm.AOP_IMM) {
        if (op.imm < 0 || op.imm > 0xFFF) { ret false; }
        @out = op.imm::u32;
        ret true;
    }
    var buf: [16]u8;
    if (!iasm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 16)) { ret false; }
    ret rv_csr_name((?buf[0])::str, out);
}

fun rv_label_operand(pat: u16, n: u32) u32 {
    if (pat == RVP_BRANCH || pat == RVP_BRANCH_SW)       { ret 2; }
    if (pat == RVP_BRANCH_Z1 || pat == RVP_BRANCH_Z2)    { ret 1; }
    if (pat == RVP_J)                                    { ret 0; }
    if (pat == RVP_JAL)                                  { ret n - 1; }
    ret 0xFFFFFFFF;
}

fun rv_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = rv_pattern(s.m.flags);
    val n: u32 = s.nargs;

    val label_at: u32 = rv_label_operand(pat, n);
    var i: u32 = 0;
    for (i < n) {
        if (i != label_at) {
            val r: err[fail.Fail] = rv_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }

    if (pat == RVP_RRR || pat == RVP_RRI || pat == RVP_SHIFT) {
        if (n != 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction expects three operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm instruction operand must be a register")};
        }
        if (pat == RVP_RRR) {
            if (item.ops[2].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction source must be a register")}; }
            ret err[fail.Fail].ok{};
        }
        if (pat == RVP_RRI && item.ops[2].kind == iasm.AOP_SYM) { ret err[fail.Fail].ok{}; }
        if (item.ops[2].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm operand must be an immediate")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_LOAD || pat == RVP_STORE) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm load/store expects rd, off(base)")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm load/store value must be a register")}; }
        if (!rv_is_addr(?item.ops[1]))        { ret err[fail.Fail].err{fail.message("encode: inline-asm load/store address must be off(base)")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_UIMM) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm lui/auipc expects rd, imm")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm destination must be a register")}; }
        if (item.ops[1].kind == iasm.AOP_SYM) { ret err[fail.Fail].ok{}; }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm lui/auipc needs an immediate")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_BRANCH || pat == RVP_BRANCH_SW) {
        if (n != 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm branch expects rs1, rs2, label")}; }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm branch operand must be a register")};
        }
        ret rv_local_target(c, s, item, 2);
    }
    if (pat == RVP_BRANCH_Z1 || pat == RVP_BRANCH_Z2) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm branch expects rs, label")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm branch operand must be a register")}; }
        ret rv_local_target(c, s, item, 1);
    }
    if (pat == RVP_J) {
        if (n != 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm jump expects a label")}; }
        ret rv_local_target(c, s, item, 0);
    }
    if (pat == RVP_JAL) {
        if (n == 1) { item.writes = iasm.AW_NONE; ret rv_local_target(c, s, item, 0); }
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm jump expects label or rd, label")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'jal' destination must be a register")}; }
        ret rv_local_target(c, s, item, 1);
    }
    if (pat == RVP_JR) {
        if (n != 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'jr' expects a register")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm jr/jalr operand must be a register")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_JALR) {
        if (n == 1) {
            if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm jr/jalr operand must be a register")}; }
            ret err[fail.Fail].ok{};
        }
        if (n != 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm jalr expects rs or rd, rs, imm")}; }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm jalr operand must be a register")};
        }
        if (item.ops[2].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm jalr needs an immediate")}; }
        item.writes = iasm.AW_OP0;
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_MV || pat == RVP_NOT || pat == RVP_SEQZ || pat == RVP_NEG || pat == RVP_SNEZ) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction expects rd, rs")}; }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm instruction operand must be a register")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_LI) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'li' expects rd, imm")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'li' destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'li' needs an immediate")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_LA) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'la' expects rd, sym")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'la' destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_SYM) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'la' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CALL || pat == RVP_TAIL) {
        if (n != 1)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm call/tail expects a symbol")}; }
        if (item.ops[0].kind != iasm.AOP_SYM) { ret err[fail.Fail].err{fail.message("encode: inline-asm call/tail target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_AMO) {
        if (n != 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm atomic expects rd, rs2, (rs1)")}; }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm atomic operand must be a register")};
        }
        ret rv_amo_addr(?item.ops[2]);
    }
    if (pat == RVP_AMO_LR) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm 'lr' expects rd, (rs1)")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'lr' destination must be a register")}; }
        ret rv_amo_addr(?item.ops[1]);
    }
    if (pat == RVP_CSR) {
        if (n != 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm csrrw/csrrs/csrrc expects rd, csr, rs1")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm csr destination must be a register")}; }
        if (item.ops[2].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm csr source must be a register")}; }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 1, ?item.ops[1], ?addr)) { ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm CSR")}; }
        item.ops[1] = iasm.op_imm(addr::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSR_I) {
        if (n != 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm csrrwi/csrrsi/csrrci expects rd, csr, uimm5")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm csr destination must be a register")}; }
        if (item.ops[2].kind != iasm.AOP_IMM || item.ops[2].imm < 0 || item.ops[2].imm > 31) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm csr immediate must be 0-31")};
        }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 1, ?item.ops[1], ?addr)) { ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm CSR")}; }
        item.ops[1] = iasm.op_imm(addr::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSRR) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'csrr' expects rd, csr")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'csrr' destination must be a register")}; }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 1, ?item.ops[1], ?addr)) { ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm CSR")}; }
        item.ops[1] = iasm.op_imm(addr::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSRW) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm csrw/csrs/csrc expects csr, rs1")}; }
        if (item.ops[1].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm csr source must be a register")}; }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 0, ?item.ops[0], ?addr)) { ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm CSR")}; }
        item.ops[0] = iasm.op_imm(addr::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSRWI) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm csrwi/csrsi/csrci expects csr, uimm5")}; }
        if (item.ops[1].kind != iasm.AOP_IMM || item.ops[1].imm < 0 || item.ops[1].imm > 31) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm csr immediate must be 0-31")};
        }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 0, ?item.ops[0], ?addr)) { ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm CSR")}; }
        item.ops[0] = iasm.op_imm(addr::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_RDCYCLE || pat == RVP_RDTIME || pat == RVP_RDINSTRET) {
        if (n != 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm rdcycle/rdtime/rdinstret expects a register")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm rdcycle/rdtime/rdinstret destination must be a register")}; }
        ret err[fail.Fail].ok{};
    }
    if (n != 0) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction takes no operands")}; }
    ret err[fail.Fail].ok{};
}

fun rv_amo_addr(op: *iasm.Operand) err[fail.Fail] {
    if (!rv_is_addr(op))                   { ret err[fail.Fail].err{fail.message("encode: inline-asm atomic address must be (rs1)")}; }
    if ((op.flags & iasm.AOF_HAS_DISP) != 0 || op.imm != 0) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm atomic address takes no displacement")};
    }
    ret err[fail.Fail].ok{};
}

fun rv_local_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32) err[fail.Fail] {
    var num: u64 = 0;
    var fwd: bool = false;
    if (!iasm.label_ref_span(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?num, ?fwd)) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm branch/jump target must be a numeric local label (Nf / Nb)")};
    }
    item.ref     = iasm.AR_LOCAL;
    item.ref_num = num;
    item.ref_fwd = fwd;
    ret err[fail.Fail].ok{};
}

fun rv_reg(op: *iasm.Operand) u32 {
    if (op.kind != iasm.AOP_REG || op.reg < 0) { ret RZERO; }
    ret op.reg::u32;
}

fun rv_absent_message(c: *iasm.Cursor, item: *iasm.Item, xl: u8) str {
    val end: usize = item.src_off + item.src_len;
    var i: usize = item.src_off;
    for (i < end && !iasm.is_space(c.body[i])) { i = i + 1; }

    if (xl == 4) {
        ret iasm.span_message(c, "encode: inline-asm instruction '", item.src_off, i,
            "' is not implemented on riscv32",
            "encode: inline-asm instruction is not implemented on riscv32");
    }
    ret iasm.span_message(c, "encode: inline-asm instruction '", item.src_off, i,
        "' is not implemented on riscv64",
        "encode: inline-asm instruction is not implemented on riscv64");
}

fun rv_emit(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = rv_pattern(item.flags);
    val op: inst.MachOp = item.code::inst.MachOp;

    if (!inst.admits(op, xlen(st))) { ret err[fail.Fail].err{fail.message(rv_absent_message(c, item, xlen(st)))}; }
    val admitted: err[fail.Fail] = extension_admission(st.model.riscv_extensions, op);
    if (sel admitted.err) { ret admitted; }

    var fmt: u8 = 0;
    var opcode: u32 = 0;
    var f3: u32 = 0;
    var f7: u32 = 0;
    if (pat != RVP_LI && pat != RVP_LA && pat != RVP_CALL && pat != RVP_TAIL) {
        if (!rv_fields(op, ?fmt, ?opcode, ?f3, ?f7)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm riscv64 instruction has no encoding")};
        }
    }

    if (pat == RVP_ECALL)  { emit_i(st, OPC_SYSTEM, F3_ADD, RZERO, RZERO, 0); ret err[fail.Fail].ok{}; }
    if (pat == RVP_EBREAK) { emit_i(st, OPC_SYSTEM, F3_ADD, RZERO, RZERO, 1); ret err[fail.Fail].ok{}; }
    if (pat == RVP_NOP)    { emit_i(st, OPC_OP_IMM, F3_ADD, RZERO, RZERO, 0); ret err[fail.Fail].ok{}; }
    if (pat == RVP_RET)    { emit_i(st, OPC_JALR, F3_ADD, RZERO, RRA, 0); ret err[fail.Fail].ok{}; }
    if (pat == RVP_FENCE)  { emit_i(st, OPC_MISC_MEM, F3_ADD, RZERO, RZERO, 0xFF); ret err[fail.Fail].ok{}; }
    if (pat == RVP_PAUSE)  { emit_i(st, OPC_MISC_MEM, F3_ADD, RZERO, RZERO, 0x010); ret err[fail.Fail].ok{}; }

    if (pat == RVP_RRR) {
        emit_r(st, opcode, f3, f7, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), rv_reg(?item.ops[2]));
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_RRI) {
        if (item.ops[2].kind == iasm.AOP_SYM) { ret rv_emit_pcrel_lo(st, c, item, opcode, f3); }
        val v: i64 = item.ops[2].imm;
        if (v < -2048 || v > 2047) { ret err[fail.Fail].err{fail.message("encode: inline-asm immediate is out of the 12-bit signed range")}; }
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), v::u32 & 0xFFF);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_SHIFT) {
        var mask: u32 = 0x3F;
        if (opcode == OPC_OP_IMM_32 || xlen(st) == 4) { mask = 0x1F; }
        val v: i64 = item.ops[2].imm;
        if (v < 0 || v::u32 > mask) { ret err[fail.Fail].err{fail.message("encode: inline-asm shift amount is out of range")}; }
        var imm: u32 = v::u32 & mask;
        if (op == inst.SRAI || op == inst.SRAIW) { imm = imm | 0x400; }
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), imm);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_LOAD || pat == RVP_STORE) {
        val mem: *iasm.Operand = ?item.ops[1];
        if (mem.imm < -2048 || mem.imm > 2047) { ret err[fail.Fail].err{fail.message("encode: inline-asm load/store offset is out of the 12-bit signed range")}; }
        if (pat == RVP_LOAD) {
            emit_i(st, opcode, f3, rv_reg(?item.ops[0]), mem.reg::u32, mem.imm::u32 & 0xFFF);
        } or {
            emit_s(st, opcode, f3, mem.reg::u32, rv_reg(?item.ops[0]), mem.imm::u32 & 0xFFF);
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_UIMM) { ret rv_emit_uimm(st, c, item, opcode); }
    if (pat == RVP_BRANCH || pat == RVP_BRANCH_SW || pat == RVP_BRANCH_Z1 || pat == RVP_BRANCH_Z2) {
        var rs1: u32 = RZERO;
        var rs2: u32 = RZERO;
        if (pat == RVP_BRANCH)         { rs1 = rv_reg(?item.ops[0]); rs2 = rv_reg(?item.ops[1]); }
        or (pat == RVP_BRANCH_SW)      { rs1 = rv_reg(?item.ops[1]); rs2 = rv_reg(?item.ops[0]); }
        or (pat == RVP_BRANCH_Z1)      { rs1 = rv_reg(?item.ops[0]); }
        or                             { rs2 = rv_reg(?item.ops[0]); }
        val pos: u32 = st.buf.len::u32;
        emit_b(st, opcode, f3, rs1, rs2, 0);
        note_local_target(st, item.ref_num, item.ref_fwd);
        ret iasm.resolve_local(st, c.g, l, pos, item.ref_num, item.ref_fwd);
    }
    if (pat == RVP_J || pat == RVP_JAL) {
        var rd: u32 = RZERO;
        if (pat == RVP_JAL) {
            rd = RRA;
            if (item.nops == 2) { rd = rv_reg(?item.ops[0]); }
        }
        val pos: u32 = st.buf.len::u32;
        emit_j(st, OPC_JAL, rd, 0);
        note_local_target(st, item.ref_num, item.ref_fwd);
        ret iasm.resolve_local(st, c.g, l, pos, item.ref_num, item.ref_fwd);
    }
    if (pat == RVP_JR)   { emit_i(st, OPC_JALR, F3_ADD, RZERO, rv_reg(?item.ops[0]), 0); ret err[fail.Fail].ok{}; }
    if (pat == RVP_JALR) {
        if (item.nops == 1) { emit_i(st, OPC_JALR, F3_ADD, RRA, rv_reg(?item.ops[0]), 0); ret err[fail.Fail].ok{}; }
        val v: i64 = item.ops[2].imm;
        if (v < -2048 || v > 2047) { ret err[fail.Fail].err{fail.message("encode: inline-asm jalr offset is out of the 12-bit signed range")}; }
        emit_i(st, OPC_JALR, F3_ADD, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), v::u32 & 0xFFF);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_MV)   { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 0); ret err[fail.Fail].ok{}; }
    if (pat == RVP_NOT)  { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 0xFFF); ret err[fail.Fail].ok{}; }
    if (pat == RVP_SEQZ) { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 1); ret err[fail.Fail].ok{}; }
    if (pat == RVP_NEG)  { emit_r(st, opcode, f3, f7, rv_reg(?item.ops[0]), RZERO, rv_reg(?item.ops[1])); ret err[fail.Fail].ok{}; }
    if (pat == RVP_SNEZ) { emit_r(st, opcode, f3, f7, rv_reg(?item.ops[0]), RZERO, rv_reg(?item.ops[1])); ret err[fail.Fail].ok{}; }
    if (pat == RVP_LI)   { emit_li(st, rv_reg(?item.ops[0]), item.ops[1].imm); ret err[fail.Fail].ok{}; }
    if (pat == RVP_LA)   { ret rv_emit_la(st, c, item); }
    if (pat == RVP_CALL) { ret rv_emit_call(st, c, item, RRA, RRA); }
    if (pat == RVP_TAIL) { ret rv_emit_call(st, c, item, SCRATCH2, RZERO); }
    if (pat == RVP_AMO || pat == RVP_AMO_LR) {
        var f7o: u32 = f7;
        if ((item.flags & RVF_AQ) != 0) { f7o = f7o | 0x2; }
        if ((item.flags & RVF_RL) != 0) { f7o = f7o | 0x1; }
        if (pat == RVP_AMO_LR) {
            emit_r(st, opcode, f3, f7o, rv_reg(?item.ops[0]), item.ops[1].reg::u32, RZERO);
            ret err[fail.Fail].ok{};
        }
        emit_r(st, opcode, f3, f7o, rv_reg(?item.ops[0]), item.ops[2].reg::u32, rv_reg(?item.ops[1]));
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSR) {
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[2]), item.ops[1].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSR_I) {
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), item.ops[2].imm::u32, item.ops[1].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSRR) {
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, item.ops[1].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSRW) {
        emit_i(st, opcode, f3, RZERO, rv_reg(?item.ops[1]), item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_CSRWI) {
        emit_i(st, opcode, f3, RZERO, item.ops[1].imm::u32, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == RVP_RDCYCLE)   { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, 0xC00); ret err[fail.Fail].ok{}; }
    if (pat == RVP_RDTIME)    { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, 0xC01); ret err[fail.Fail].ok{}; }
    if (pat == RVP_RDINSTRET) { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, 0xC02); ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm riscv64 form has no emitter")};
}

fun rv_emit_uimm(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item, opcode: u32) err[fail.Fail] {
    val src: *iasm.Operand = ?item.ops[1];
    if (src.kind == iasm.AOP_SYM) {
        if (src.mod == isa.SYM_MOD_GOT_HI) {
            ret err[fail.Fail].err{fail.message("encode: riscv64 has no GOT-relative relocation kind, so inline-asm '%got_pcrel_hi' cannot be encoded")};
        }
        if (opcode != OPC_AUIPC || src.mod != isa.SYM_MOD_PCREL_HI) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm upper-immediate symbol reference must be an 'auipc rd, %pcrel_hi(sym)'")};
        }
        val sr: res[intern.StrId, fail.Fail] = rv_intern(st, c, src);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        ret emit_pcrel_hi(st, rv_reg(?item.ops[0]), sr.ok, 0);
    }
    if (src.imm < 0 || src.imm > 0xFFFFF) { ret err[fail.Fail].err{fail.message("encode: inline-asm lui/auipc immediate is out of the 20-bit range")}; }
    emit_u(st, opcode, rv_reg(?item.ops[0]), src.imm::u32 & 0xFFFFF);
    ret err[fail.Fail].ok{};
}

fun rv_emit_pcrel_lo(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item, opcode: u32, f3: u32) err[fail.Fail] {
    val src: *iasm.Operand = ?item.ops[2];
    if (src.mod != isa.SYM_MOD_PCREL_LO) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm register-immediate symbol reference must be a '%pcrel_lo(sym)'")};
    }
    val sr: res[intern.StrId, fail.Fail] = rv_intern(st, c, src);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sym: intern.StrId = sr.ok;
    val pos: u32 = st.buf.len::u32;
    emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, pos, of.RK_PCREL_LO12_I, sym);
}

fun rv_emit_la(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val sr: res[intern.StrId, fail.Fail] = rv_intern(st, c, ?item.ops[1]);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sym: intern.StrId = sr.ok;
    val rd: u32 = rv_reg(?item.ops[0]);
    val hr: err[fail.Fail] = emit_pcrel_hi(st, rd, sym, 0);
    if (sel hr.err) { ret hr; }
    val lo_pos: u32 = st.buf.len::u32;
    emit_i(st, OPC_OP_IMM, F3_ADD, rd, rd, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, lo_pos, of.RK_PCREL_LO12_I, sym);
}

fun rv_emit_call(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item, link: u32, ret_reg: u32) err[fail.Fail] {
    val sr: res[intern.StrId, fail.Fail] = rv_intern(st, c, ?item.ops[0]);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sym: intern.StrId = sr.ok;
    val pos: u32 = st.buf.len::u32;
    emit_u(st, OPC_AUIPC, link, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_HI, 0);
    emit_i(st, OPC_JALR, F3_ADD, ret_reg, link, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    val r_3474: err[fail.Fail] = encode.push_reloc(st, pos, of.RK_PLT32, sym, 0);
    if (sel r_3474.err) { ret err[fail.Fail].err{r_3474.err}; }
    ret err[fail.Fail].ok{};
}

fun rv_intern(st: *encode.EncodeState, c: *iasm.Cursor, op: *iasm.Operand) res[intern.StrId, fail.Fail] {
    val r_3478: res[intern.StrId, A.Error] = intern.intern_bytes(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
    if (sel r_3478.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_3478.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_3478.ok};
}

fun rv_patch(st: *encode.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    var fx: encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret patch_branch_riscv64(st, ?fx, target_off);
}

fun rv_slot_from_sp(f: *mir.MirFunction) bool { ret true; }

fun rv_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << RSP)) != 0; }
        ret true;
    }
    if ((item.implicit & (1::u32 << RSP)) != 0) { ret true; }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && rv_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && rv_is_sp(?item.ops[1])) { ret true; }
    ret false;
}

fun rv_is_sp(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_REG && op.reg == RSP::i32;
}

fun rv_isa_tag(xl: u8) str {
    if (xl == 4) { ret "riscv32"; }
    ret "riscv64";
}

fun rv_grammar_tagged(tag: str) iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = tag;
    g.unknown    = "unknown riscv inline-asm instruction '";
    g.rows       = ?RV_MNEMONICS[0];
    g.row_count  = RV_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD32[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = rv_decode_amo;
    g.parse      = rv_parse;
    g.emit       = rv_emit;
    g.patch      = rv_patch;
    g.slot       = asm_slot_offset;
    g.slot_sp    = rv_slot_from_sp;
    g.writes_sp  = rv_writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = rv_decl_reg;
    g.no_fall    = rv_no_fall;
    ret g;
}

fun rv_grammar(st: *encode.EncodeState) iasm.Grammar {
    ret rv_grammar_tagged(rv_isa_tag(xlen(st)));
}

fun rv_grammar_analysis() iasm.Grammar {
    ret rv_grammar_tagged("riscv");
}

fun rv_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == inst.EBREAK::u32;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = rv_grammar_analysis();
    ret iasm.returns(?g, body);
}

fun rv_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    val gp: i32 = asm_reg_index(name);
    if (gp >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = gp::u32;
        ret true;
    }
    val fp: i32 = asm_fp_reg_index(name);
    if (fp >= 0) {
        @bank = iasm.ABANK_FP;
        @idx  = fp::u32;
        ret true;
    }
    ret false;
}

fun asm_fp_reg_index(tok: str) i32 {
    var i: u32 = 0;
    for (i < 32) {
        if (str_equals(tok, printer.fp_name(i))) { ret i::i32; }
        i = i + 1;
    }
    if (tok[0] != 'f'::char || tok[1] == 0) { ret -1; }
    var n: i32 = 0;
    var k: usize = 1;
    for (tok[k] != 0) {
        if (tok[k] < '0'::char || tok[k] > '9'::char) { ret -1; }
        n = n * 10 + (tok[k]::i32 - '0'::char::i32);
        k = k + 1;
    }
    if (n >= 0 && n < 32) { ret n; }
    ret -1;
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = rv_grammar_analysis();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block_riscv64(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    var g: iasm.Grammar = rv_grammar(st);
    ret iasm.encode_block(st, ?g, f, mi);
}

fun rv_asm_text(st: *encode.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) err[fail.Fail] {
    var g: iasm.Grammar = rv_grammar(st);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

var t_model_rv64: isa.MachineModel;
fun rv64_machine() *isa.MachineModel {
    t_model_rv64.pointer_width = 8;
    t_model_rv64.gpr_width     = 8;
    t_model_rv64.max_alu_width = 8;
    t_model_rv64.alu_min_width = 4;
    t_model_rv64.spill_width   = 8;
    t_model_rv64.flen_bits     = 64;
    t_model_rv64.riscv_extensions = features.ALL;
    ret ?t_model_rv64;
}

fun tbuf(st: *encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    encode.state_blank(st, alloc, rv64_machine());
}

fun tbuf_interned(st: *encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    encode.state_blank(st, alloc, rv64_machine());
    st.interner = itn;
}

fun label_at(st: *encode.EncodeState, name: intern.StrId, off: u32) bool {
    var i: u32 = 0;
    for (i < st.sym_count) {
        if (st.syms[i].name == name && st.syms[i].offset == off
            && st.syms[i].flags == PCREL_LABEL_FLAGS) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.target.isa.riscv.encode:rtype_itype_stype_utype_packers" {
    var bad: i32 = 0;
    if (pack_r(OPC_OP, F3_ADD, F7_ZERO, 10, 11, 12)  != 0x00C58533) { bad = 1; }
    if (pack_r(OPC_OP, F3_ADD, F7_SUB, 10, 11, 12)   != 0x40C58533) { bad = 1; }
    if (pack_r(OPC_OP_32, F3_ADD, F7_ZERO, 10, 11, 12) != 0x00C5853B) { bad = 1; }
    if (pack_r(OPC_OP_32, F3_ADD, F7_SUB, 10, 11, 12)  != 0x40C5853B) { bad = 1; }
    if (pack_r(OPC_OP, F3_AND, F7_ZERO, 10, 11, 12) != 0x00C5F533) { bad = 1; }
    if (pack_r(OPC_OP, F3_OR, F7_ZERO, 10, 11, 12)  != 0x00C5E533) { bad = 1; }
    if (pack_r(OPC_OP, F3_XOR, F7_ZERO, 10, 11, 12) != 0x00C5C533) { bad = 1; }
    if (pack_r(OPC_OP, F3_ADD, F7_MULDIV, 10, 11, 12) != 0x02C58533) { bad = 1; }
    if (pack_r(OPC_OP, F3_SLL, F7_ZERO, 10, 11, 12)   != 0x00C59533) { bad = 1; }
    if (pack_r(OPC_OP, F3_SRL, F7_ZERO, 10, 11, 12)   != 0x00C5D533) { bad = 1; }
    if (pack_r(OPC_OP, F3_SRL, F7_SUB, 10, 11, 12)    != 0x40C5D533) { bad = 1; }
    if (pack_i(OPC_OP_IMM, F3_ADD, 10, 11, 5) != 0x00558513) { bad = 1; }
    if (pack_i(OPC_OP_IMM, F3_AND, 10, 11, 5) != 0x0055F513) { bad = 1; }
    if (pack_i(OPC_OP_IMM_32, F3_ADD, 10, 11, 5) != 0x0055851B) { bad = 1; }
    if (pack_i(OPC_LOAD, F3_SLTU, 10, 11, 16) != 0x0105B503) { bad = 1; }
    if (pack_i(OPC_LOAD, F3_SLT, 10, 11, 16)  != 0x0105A503) { bad = 1; }
    if (pack_i(OPC_LOAD, F3_XOR, 10, 11, 16)  != 0x0105C503) { bad = 1; }
    if (pack_i(OPC_JALR, F3_ADD, 1, 10, 0) != 0x000500E7) { bad = 1; }
    if (pack_i(OPC_JALR, F3_ADD, 0, 1, 0)  != 0x00008067) { bad = 1; }
    if (pack_s(OPC_STORE, F3_SLTU, 11, 10, 16) != 0x00A5B823) { bad = 1; }
    if (pack_s(OPC_STORE, F3_SLT, 11, 10, 16)  != 0x00A5A823) { bad = 1; }
    if (pack_s(OPC_STORE, F3_ADD, 11, 10, 16)  != 0x00A58823) { bad = 1; }
    if (pack_u(OPC_LUI, 10, 0x12345) != 0x12345537) { bad = 1; }
    if (pack_u(OPC_AUIPC, 10, 0)     != 0x00000517) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:btype_jtype_immediate_scatter" {
    var bad: i32 = 0;
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, 0)  != 0x00B50063) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, 16) != 0x00B50863) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BNE, 10, 11, 16) != 0x00B51863) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, (0 - 4)::u32) != 0xFEB50EE3) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BNE, 10, 0, 8) != 0x00051463) { bad = 1; }
    if (pack_j(OPC_JAL, 1, 0)  != 0x000000EF) { bad = 1; }
    if (pack_j(OPC_JAL, 1, 16) != 0x010000EF) { bad = 1; }
    if (pack_j(OPC_JAL, 0, 0)  != 0x0000006F) { bad = 1; }
    if (pack_j(OPC_JAL, 1, (0 - 4)::u32) != 0xFFDFF0EF) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:li_constant_materialization" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_li(?st, 10, 5);
    if (st.buf.len != 4) { bad = 1; }
    or { if (read_word(?st.buf, 0) != 0x00500513) { bad = 1; } }

    st.buf.len = 0;
    emit_li(?st, 10, 0 - 1);
    if (read_word(?st.buf, 0) != 0xFFF00513) { bad = 1; }

    st.buf.len = 0;
    emit_li(?st, 10, 0x12345678);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != 0x12345537) { bad = 1; }
        if (read_word(?st.buf, 4) != 0x6785051B) { bad = 1; }
    }

    st.buf.len = 0;
    emit_li(?st, 10, 0x100000000);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != 0x00100537) { bad = 1; }
        if (read_word(?st.buf, 4) != 0x00C51513) { bad = 1; }
    }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:width_driven_loads_stores_and_alu" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_mem_access(?st, 10, 11, 0, 1, true);
    emit_mem_access(?st, 10, 11, 0, 2, true);
    emit_mem_access(?st, 10, 11, 0, 4, true);
    emit_mem_access(?st, 10, 11, 0, 8, true);
    if (read_word(?st.buf, 0)  != 0x0005C503) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x0005D503) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x0005A503) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x0005B503) { bad = 1; }

    st.buf.len = 0;
    emit_mem_access(?st, 10, 11, 0, 1, false);
    emit_mem_access(?st, 10, 11, 0, 2, false);
    emit_mem_access(?st, 10, 11, 0, 4, false);
    emit_mem_access(?st, 10, 11, 0, 8, false);
    if (read_word(?st.buf, 0)  != 0x00A58023) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00A59023) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x00A5A023) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00A5B023) { bad = 1; }

    if (alu_opcode(8, 8) != OPC_OP)         { bad = 1; }
    if (alu_opcode(4, 8) != OPC_OP_32)      { bad = 1; }
    if (alu_opcode(1, 8) != OPC_OP)         { bad = 1; }
    if (alu_imm_opcode(8, 8) != OPC_OP_IMM) { bad = 1; }
    if (alu_imm_opcode(4, 8) != OPC_OP_IMM_32) { bad = 1; }
    if (alu_opcode(4, 4) != OPC_OP)         { bad = 1; }
    if (alu_opcode(1, 4) != OPC_OP)         { bad = 1; }
    if (alu_imm_opcode(4, 4) != OPC_OP_IMM) { bad = 1; }
    if (alu_imm_opcode(1, 4) != OPC_OP_IMM) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:mir_subword_load_store_widths" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    var ldops: [2]mir.MirOperand;
    ldops[0] = mir.op_preg(10);
    ldops[1] = mir.op_mem_preg(11, 0);
    var ld: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?ldops[0], 2, 0, 0);

    ld.width = 4; ld.src_width = 1; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005C503) { bad = 1; }
    st.buf.len = 0; ld.width = 4; ld.src_width = 2; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005D503) { bad = 1; }
    st.buf.len = 0; ld.width = 4; ld.src_width = 4; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005A503) { bad = 1; }
    st.buf.len = 0; ld.width = 8; ld.src_width = 8; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005B503) { bad = 1; }

    var srops: [2]mir.MirOperand;
    srops[0] = mir.op_mem_preg(11, 0);
    srops[1] = mir.op_preg(10);
    var sr: mir.MirInstr = mir.instr(mir.MIR_STORE, ?srops[0], 2, 0, 0);

    st.buf.len = 0; sr.width = 1; sr.src_width = 1; encode_store(?st, nil, ?sr);
    if (read_word(?st.buf, 0) != 0x00A58023) { bad = 1; }
    st.buf.len = 0; sr.width = 2; sr.src_width = 2; encode_store(?st, nil, ?sr);
    if (read_word(?st.buf, 0) != 0x00A59023) { bad = 1; }

    st.buf.len = 0; st.reloc_count = 0;
    var glops: [2]mir.MirOperand;
    glops[0] = mir.op_preg(10);
    glops[1] = mir.op_sym(7::intern.StrId, 0);
    var gl: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?glops[0], 2, 0, 0);
    gl.width = 4; gl.src_width = 1; encode_load(?st, nil, ?gl);
    if (read_word(?st.buf, 0) != 0x00000297) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x0002C503) { bad = 1; }

    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:mir_alu_shift_mov_neg_not" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10); ops[1] = mir.op_preg(11); ops[2] = mir.op_preg(12);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);

    mi.width = 8; encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 0) != 0x00C58533) { bad = 1; }
    mi.width = 4; encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 4) != 0x00C5853B) { bad = 1; }

    st.buf.len = 0;
    ops[2] = mir.op_imm(5);
    mi.width = 8; encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 0) != 0x00558513) { bad = 1; }
    encode_addsub(?st, ?mi, true);
    if (read_word(?st.buf, 4) != 0xFFB58513) { bad = 1; }

    st.buf.len = 0;
    ops[2] = mir.op_imm(3);
    mi.width = 8; encode_shift(?st, ?mi, F3_SLL, false);
    if (read_word(?st.buf, 0) != 0x00359513) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, F3_SLL, false);
    if (read_word(?st.buf, 4) != 0x0035951B) { bad = 1; }
    mi.width = 8; encode_shift(?st, ?mi, F3_SRL, true);
    if (read_word(?st.buf, 8) != 0x4035D513) { bad = 1; }

    st.buf.len = 0;
    var mvo: [2]mir.MirOperand;
    mvo[0] = mir.op_preg(10); mvo[1] = mir.op_preg(11);
    var mv: mir.MirInstr = mir.instr(mir.MIR_ADD, ?mvo[0], 2, 8, 0);
    encode_mov(?st, nil, ?mv);
    if (read_word(?st.buf, 0) != 0x00058513) { bad = 1; }
    encode_neg(?st, ?mv);
    if (read_word(?st.buf, 4) != 0x40B00533) { bad = 1; }
    encode_not(?st, ?mv);
    if (read_word(?st.buf, 8) != 0xFFF5C513) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:const_value_variable_shift_materializes" {
