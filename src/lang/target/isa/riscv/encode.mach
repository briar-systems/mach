use std.format;
use std.allocator.page;
use std.collections.map;
use std.io.writer;
use std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_index_of;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.be.codegen.encode;
use codegen_frame: mach.lang.be.codegen.frame;
use mach.lang.be.codegen.mir;
use mach.lang.ct;
use mach.lang.intern;
use mach.lang.target.isa;
use iasm: mach.lang.target.isa.asm;
use mach.lang.target.isa.riscv;
use mach.lang.target.isa.riscv.printer;
use mach.lang.target.isa.riscv.inst;
use mach.lang.target.of;

val OPC_OP:        u32 = 0x33;
val OPC_OP_IMM:    u32 = 0x13;
val OPC_OP_32:     u32 = 0x3B;
val OPC_OP_IMM_32: u32 = 0x1B;
val OPC_LOAD:      u32 = 0x03;
val OPC_STORE:     u32 = 0x23;
val OPC_BRANCH:    u32 = 0x63;
val OPC_JAL:       u32 = 0x6F;
val OPC_JALR:      u32 = 0x67;
val OPC_LUI:       u32 = 0x37;
val OPC_AUIPC:     u32 = 0x17;
val OPC_SYSTEM:    u32 = 0x73;
val OPC_MISC_MEM:  u32 = 0x0F;
val OPC_AMO:       u32 = 0x2F;

val F3_ADD:  u32 = 0x0;
val F3_SLL:  u32 = 0x1;
val F3_SLT:  u32 = 0x2;
val F3_SLTU: u32 = 0x3;
val F3_XOR:  u32 = 0x4;
val F3_SRL:  u32 = 0x5;
val F3_OR:   u32 = 0x6;
val F3_AND:  u32 = 0x7;

val F3_CSRRW:  u32 = 0x1;
val F3_CSRRS:  u32 = 0x2;
val F3_CSRRC:  u32 = 0x3;
val F3_CSRRWI: u32 = 0x5;
val F3_CSRRSI: u32 = 0x6;
val F3_CSRRCI: u32 = 0x7;

val F7_ZERO:   u32 = 0x00;
val F7_SUB:    u32 = 0x20;
val F7_MULDIV: u32 = 0x01;

val F3_BEQ:  u32 = 0x0;
val F3_BNE:  u32 = 0x1;
val F3_BLT:  u32 = 0x4;
val F3_BGE:  u32 = 0x5;
val F3_BLTU: u32 = 0x6;
val F3_BGEU: u32 = 0x7;

val F3_DIV:  u32 = 0x4;
val F3_DIVU: u32 = 0x5;
val F3_REM:  u32 = 0x6;
val F3_REMU: u32 = 0x7;

val OPC_OP_FP:    u32 = 0x53;
val OPC_LOAD_FP:  u32 = 0x07;
val OPC_STORE_FP: u32 = 0x27;

val F7_FADD:    u32 = 0x00;
val F7_FSUB:    u32 = 0x04;
val F7_FMUL:    u32 = 0x08;
val F7_FDIV:    u32 = 0x0C;
val F7_FSGNJ:   u32 = 0x10;
val F7_FCMP:    u32 = 0x50;
val F7_FCVT_F2F: u32 = 0x20;
val F7_FCVT_F2I: u32 = 0x60;
val F7_FCVT_I2F: u32 = 0x68;
val F7_FMV_F2I:  u32 = 0x70;
val F7_FMV_I2F:  u32 = 0x78;

val F3_FLE: u32 = 0x0;
val F3_FLT: u32 = 0x1;
val F3_FEQ: u32 = 0x2;

val RM_RNE: u32 = 0x0;
val RM_RTZ: u32 = 0x1;
val RM_DYN: u32 = 0x7;

val FCVT_W:  u32 = 0x0;
val FCVT_WU: u32 = 0x1;
val FCVT_L:  u32 = 0x2;
val FCVT_LU: u32 = 0x3;

val FMT_S: u32 = 0x0;
val FMT_D: u32 = 0x1;

val FP_SCRATCH:  u32 = 31;
val FP_SCRATCH2: u32 = 30;

val F3_AMO_W: u32 = 0x2;
val F3_AMO_D: u32 = 0x3;

val A5_LR:      u32 = 0x02;
val A5_SC:      u32 = 0x03;
val A5_AMOSWAP: u32 = 0x01;
val A5_AMOADD:  u32 = 0x00;
val A5_AMOXOR:  u32 = 0x04;
val A5_AMOAND:  u32 = 0x0C;
val A5_AMOOR:   u32 = 0x08;
val A5_AMOMIN:  u32 = 0x10;
val A5_AMOMAX:  u32 = 0x14;
val A5_AMOMINU: u32 = 0x18;
val A5_AMOMAXU: u32 = 0x1C;

val RZERO:    u32 = 0;
val RRA:      u32 = 1;
val RSP:      u32 = 2;
val RFP:      u32 = 8;
val SCRATCH:  u32 = 5;
val SCRATCH2: u32 = 6;

val CALLER_SAVED_GP: u32 = 0xF003FCE2;

val RA_READ: u32 = 0x2;

fun b_imm(imm: u32) u32 {
    ret (((imm >> 12) & 0x1) << 31) | (((imm >> 5) & 0x3F) << 25) |
        (((imm >> 1) & 0xF) << 8)   | (((imm >> 11) & 0x1) << 7);
}

fun j_imm(imm: u32) u32 {
    ret (((imm >> 20) & 0x1) << 31) | (((imm >> 1) & 0x3FF) << 21) |
        (((imm >> 11) & 0x1) << 20) | (((imm >> 12) & 0xFF) << 12);
}

fun pack_r(opcode: u32, funct3: u32, funct7: u32, rd: u32, rs1: u32, rs2: u32) u32 {
    ret ((funct7 & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) |
        ((funct3 & 0x7) << 12)  | ((rd & 0x1F) << 7)   | (opcode & 0x7F);
}

fun pack_i(opcode: u32, funct3: u32, rd: u32, rs1: u32, imm12: u32) u32 {
    ret ((imm12 & 0xFFF) << 20) | ((rs1 & 0x1F) << 15) | ((funct3 & 0x7) << 12) |
        ((rd & 0x1F) << 7)      | (opcode & 0x7F);
}

fun pack_s(opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm12: u32) u32 {
    val imm: u32 = imm12 & 0xFFF;
    ret (((imm >> 5) & 0x7F) << 25) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) |
        ((funct3 & 0x7) << 12)      | ((imm & 0x1F) << 7)  | (opcode & 0x7F);
}

fun pack_b(opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm: u32) u32 {
    ret b_imm(imm) | ((rs2 & 0x1F) << 20) | ((rs1 & 0x1F) << 15) |
        ((funct3 & 0x7) << 12) | (opcode & 0x7F);
}

fun pack_u(opcode: u32, rd: u32, imm20: u32) u32 {
    ret ((imm20 & 0xFFFFF) << 12) | ((rd & 0x1F) << 7) | (opcode & 0x7F);
}

fun pack_j(opcode: u32, rd: u32, imm: u32) u32 {
    ret j_imm(imm) | ((rd & 0x1F) << 7) | (opcode & 0x7F);
}

fun emit_word(st: *encode.EncodeState, word: u32) {
    encode.emit_u32(?st.buf, word);
}

val WORD_SIZE: u32 = 4;

val SH_NONE:    u8 = 0;
val SH_RRR:     u8 = 1;
val SH_RRI:     u8 = 2;
val SH_RU:      u8 = 3;
val SH_LOAD:    u8 = 4;
val SH_FLOAD:   u8 = 5;
val SH_STORE:   u8 = 6;
val SH_FSTORE:  u8 = 7;
val SH_BRANCH:  u8 = 8;
val SH_JUMP:    u8 = 9;
val SH_FFF:     u8 = 10;
val SH_FF:      u8 = 11;
val SH_GFF:     u8 = 12;
val SH_GF:      u8 = 13;
val SH_FG:      u8 = 14;
val SH_AMO:     u8 = 15;
val SH_AMO_LR:  u8 = 16;
val SH_CSR:     u8 = 17;
val SH_CSR_I:   u8 = 18;

fun gpr(idx: u32) isa.Operand {
    ret isa.make_reg(idx::i32, 8);
}

fun fpr(idx: u32) isa.Operand {
    ret isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx::i32), 8);
}

fun build_inst(op: inst.MachOp, rd: u32, rs1: u32, rs2: u32, imm: i64) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = op::u16;
    mi.size   = WORD_SIZE::u8;

    val shape: u8 = shape_of(op);
    if (shape == SH_RRR) { mi.dst = gpr(rd); mi.src1 = gpr(rs1); mi.src2 = gpr(rs2); ret mi; }
    if (shape == SH_RRI) { mi.dst = gpr(rd); mi.src1 = gpr(rs1); mi.src2 = isa.make_imm(imm, 8); ret mi; }
    if (shape == SH_RU)  { mi.dst = gpr(rd); mi.src1 = isa.make_imm(imm, 8); ret mi; }
    if (shape == SH_LOAD)   { mi.dst = gpr(rd); mi.src1 = isa.make_mem(rs1::i32, imm::i32, -1, 0, 8); ret mi; }
    if (shape == SH_FLOAD)  { mi.dst = fpr(rd); mi.src1 = isa.make_mem(rs1::i32, imm::i32, -1, 0, 8); ret mi; }
    if (shape == SH_STORE)  { mi.dst = isa.make_mem(rs1::i32, imm::i32, -1, 0, 8); mi.src1 = gpr(rs2); ret mi; }
    if (shape == SH_FSTORE) { mi.dst = isa.make_mem(rs1::i32, imm::i32, -1, 0, 8); mi.src1 = fpr(rs2); ret mi; }
    if (shape == SH_BRANCH) { mi.dst = gpr(rs1); mi.src1 = gpr(rs2); mi.src2 = isa.make_block_label(0); ret mi; }
    if (shape == SH_JUMP)   { mi.dst = gpr(rd); mi.src1 = isa.make_block_label(0); ret mi; }
    if (shape == SH_FFF) { mi.dst = fpr(rd); mi.src1 = fpr(rs1); mi.src2 = fpr(rs2); ret mi; }
    if (shape == SH_FF)  { mi.dst = fpr(rd); mi.src1 = fpr(rs1); ret mi; }
    if (shape == SH_GFF) { mi.dst = gpr(rd); mi.src1 = fpr(rs1); mi.src2 = fpr(rs2); ret mi; }
    if (shape == SH_GF)  { mi.dst = gpr(rd); mi.src1 = fpr(rs1); ret mi; }
    if (shape == SH_FG)  { mi.dst = fpr(rd); mi.src1 = gpr(rs1); ret mi; }
    if (shape == SH_AMO) {
        mi.dst  = gpr(rd);
        mi.src1 = gpr(rs2);
        mi.src2 = isa.make_mem(rs1::i32, 0, -1, 0, 8);
        ret mi;
    }
    if (shape == SH_AMO_LR) { mi.dst = gpr(rd); mi.src1 = isa.make_mem(rs1::i32, 0, -1, 0, 8); ret mi; }
    if (shape == SH_CSR)   { mi.dst = gpr(rd); mi.src1 = isa.make_imm(imm, 8); mi.src2 = gpr(rs1); ret mi; }
    if (shape == SH_CSR_I) { mi.dst = gpr(rd); mi.src1 = isa.make_imm(imm, 8); mi.src2 = isa.make_imm(rs1::i64, 8); ret mi; }
    ret mi;
}

fun shape_of(op: inst.MachOp) u8 {
    if (op >= inst.ADD && op <= inst.REMUW) { ret SH_RRR; }
    if (op >= inst.ADDI && op <= inst.SRAIW) { ret SH_RRI; }
    if (op >= inst.LB && op <= inst.LWU) { ret SH_LOAD; }
    if (op >= inst.SB && op <= inst.SD) { ret SH_STORE; }
    if (op >= inst.BEQ && op <= inst.BGEU) { ret SH_BRANCH; }
    if (op == inst.JAL)  { ret SH_JUMP; }
    if (op == inst.JALR) { ret SH_LOAD; }
    if (op == inst.LUI || op == inst.AUIPC) { ret SH_RU; }
    if (op >= inst.ECALL && op <= inst.PAUSE) { ret SH_NONE; }
    if (op == inst.FLW || op == inst.FLD) { ret SH_FLOAD; }
    if (op == inst.FSW || op == inst.FSD) { ret SH_FSTORE; }
    if (op >= inst.FADD_S && op <= inst.FSGNJX_D) { ret SH_FFF; }
    if (op >= inst.FEQ_S && op <= inst.FLE_D) { ret SH_GFF; }
    if (op == inst.FCVT_S_D || op == inst.FCVT_D_S) { ret SH_FF; }
    if (op >= inst.FCVT_W_S && op <= inst.FCVT_LU_D) { ret SH_GF; }
    if (op >= inst.FCVT_S_W && op <= inst.FCVT_D_LU) { ret SH_FG; }
    if (op == inst.FMV_X_W || op == inst.FMV_X_D) { ret SH_GF; }
    if (op == inst.FMV_W_X || op == inst.FMV_D_X) { ret SH_FG; }
    if (op == inst.LR_W || op == inst.LR_D) { ret SH_AMO_LR; }
    if (op >= inst.SC_W && op <= inst.AMOMAXU_D) { ret SH_AMO; }
    if (op >= inst.CSRRW && op <= inst.CSRRC)   { ret SH_CSR; }
    if (op >= inst.CSRRWI && op <= inst.CSRRCI) { ret SH_CSR_I; }
    ret SH_NONE;
}

fun emit_r(st: *encode.EncodeState, opcode: u32, funct3: u32, funct7: u32, rd: u32, rs1: u32, rs2: u32) {
    emit_word(st, pack_r(opcode, funct3, funct7, rd, rs1, rs2));
    if (!encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp = classify_r(opcode, funct3, funct7, rs2);
    var mi: isa.Inst = build_inst(op, rd, rs1, rs2, 0);
    if (opcode == OPC_AMO) { mi.flags = amo_ordering_flags(funct7); }
    note(st, op, ?mi, "R", opcode);
}

fun emit_i(st: *encode.EncodeState, opcode: u32, funct3: u32, rd: u32, rs1: u32, imm12: u32) {
    emit_word(st, pack_i(opcode, funct3, rd, rs1, imm12));
    if (!encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp = classify_i(opcode, funct3, imm12);
    var mi: isa.Inst = build_inst(op, rd, rs1, 0, imm_of_i(op, imm12));
    note(st, op, ?mi, "I", opcode);
}

fun emit_s(st: *encode.EncodeState, opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm12: u32) {
    emit_word(st, pack_s(opcode, funct3, rs1, rs2, imm12));
    if (!encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp = classify_s(opcode, funct3);
    var mi: isa.Inst = build_inst(op, 0, rs1, rs2, sext12(imm12::i64));
    note(st, op, ?mi, "S", opcode);
}

fun emit_b(st: *encode.EncodeState, opcode: u32, funct3: u32, rs1: u32, rs2: u32, imm: u32) {
    emit_word(st, pack_b(opcode, funct3, rs1, rs2, imm));
    if (!encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp = classify_b(opcode, funct3);
    var mi: isa.Inst = build_inst(op, 0, rs1, rs2, 0);
    note(st, op, ?mi, "B", opcode);
}

fun emit_u(st: *encode.EncodeState, opcode: u32, rd: u32, imm20: u32) {
    emit_word(st, pack_u(opcode, rd, imm20));
    if (!encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp = classify_u(opcode);
    var mi: isa.Inst = build_inst(op, rd, 0, 0, (imm20 & 0xFFFFF)::i64);
    note(st, op, ?mi, "U", opcode);
}

fun emit_j(st: *encode.EncodeState, opcode: u32, rd: u32, imm: u32) {
    emit_word(st, pack_j(opcode, rd, imm));
    if (!encode.sink_active(?st.buf)) { ret; }
    val op: inst.MachOp = classify_j(opcode);
    var mi: isa.Inst = build_inst(op, rd, 0, 0, 0);
    note(st, op, ?mi, "J", opcode);
}

fun note(st: *encode.EncodeState, op: inst.MachOp, mi: *isa.Inst, fmt: str, opcode: u32) {
    if (op == inst.MOP_NONE) {
        encode.sink_fail(?st.buf, unnamed_form_message(st, fmt, opcode));
        ret;
    }
    var n: encode.AsmNote = encode.note_blank();
    n.off  = st.buf.len::u32 - WORD_SIZE;
    n.inst = @mi;
    val res: R.Result[R.Void, str] = encode.note_push(?st.buf, ?n);
    if (R.is_err[R.Void, str](res)) { encode.sink_fail(?st.buf, R.unwrap_err[R.Void, str](res)); }
}

fun unnamed_form_message(st: *encode.EncodeState, fmt: str, opcode: u32) str {
    var buf: [32]u8;
    var i: usize = 0;
    for (fmt[i] != 0) { buf[i] = fmt[i]::u8; i = i + 1; }
    buf[i] = '-'::u8; i = i + 1;
    buf[i] = 't'::u8; i = i + 1;
    buf[i] = 'y'::u8; i = i + 1;
    buf[i] = 'p'::u8; i = i + 1;
    buf[i] = 'e'::u8; i = i + 1;
    buf[i] = ' '::u8; i = i + 1;
    i = i + rv_dec_into(?buf[i], opcode::u64);
    buf[i] = 0;
    ret iasm.named_message(st.alloc, st.interner,
        "--emit-asm: no riscv64 mnemonic for an emitted ", (?buf[0])::str, " instruction",
        "--emit-asm: no riscv64 mnemonic for an emitted instruction");
}

fun rv_dec_into(dst: *u8, n: u64) usize {
    var tmp: [20]u8;
    var len: usize = 0;
    var v: u64 = n;
    if (v == 0) { tmp[0] = '0'::u8; len = 1; }
    for (v > 0) {
        tmp[len] = ('0'::u64 + (v % 10))::u8;
        v = v / 10;
        len = len + 1;
    }
    var i: usize = 0;
    for (i < len) {
        dst[i] = tmp[len - 1 - i];
        i = i + 1;
    }
    ret len;
}

fun amo_ordering_flags(funct7: u32) u16 {
    var flags: u16 = 0;
    if ((funct7 & 0x2) != 0) { flags = flags | inst.FLAG_AQ; }
    if ((funct7 & 0x1) != 0) { flags = flags | inst.FLAG_RL; }
    ret flags;
}

fun imm_of_i(op: inst.MachOp, imm12: u32) i64 {
    if (op == inst.SLLI || op == inst.SRLI || op == inst.SRAI) { ret (imm12 & 0x3F)::i64; }
    if (op == inst.SLLIW || op == inst.SRLIW || op == inst.SRAIW) { ret (imm12 & 0x1F)::i64; }
    if (op >= inst.CSRRW && op <= inst.CSRRCI) { ret (imm12 & 0xFFF)::i64; }
    ret sext12(imm12::i64);
}

fun classify_r(opcode: u32, funct3: u32, funct7: u32, rs2: u32) inst.MachOp {
    if (opcode == OPC_OP_FP) { ret classify_fp(funct3, funct7, rs2); }
    if (opcode == OPC_AMO)   { ret classify_amo(funct3, funct7); }
    if (opcode != OPC_OP && opcode != OPC_OP_32) { ret inst.MOP_NONE; }
    val word: bool = opcode == OPC_OP_32;

    if (funct7 == F7_MULDIV) {
        if (funct3 == F3_ADD)  { if (word) { ret inst.MULW; }  ret inst.MUL; }
        if (funct3 == F3_DIV)  { if (word) { ret inst.DIVW; }  ret inst.DIV; }
        if (funct3 == F3_DIVU) { if (word) { ret inst.DIVUW; } ret inst.DIVU; }
        if (funct3 == F3_REM)  { if (word) { ret inst.REMW; }  ret inst.REM; }
        if (funct3 == F3_REMU) { if (word) { ret inst.REMUW; } ret inst.REMU; }
        if (word) { ret inst.MOP_NONE; }
        if (funct3 == F3_SLL)  { ret inst.MULH; }
        if (funct3 == F3_SLT)  { ret inst.MULHSU; }
        if (funct3 == F3_SLTU) { ret inst.MULHU; }
        ret inst.MOP_NONE;
    }
    if (funct7 == F7_SUB) {
        if (funct3 == F3_ADD) { if (word) { ret inst.SUBW; } ret inst.SUB; }
        if (funct3 == F3_SRL) { if (word) { ret inst.SRAW; } ret inst.SRA; }
        ret inst.MOP_NONE;
    }
    if (funct7 != F7_ZERO) { ret inst.MOP_NONE; }
    if (funct3 == F3_ADD) { if (word) { ret inst.ADDW; } ret inst.ADD; }
    if (funct3 == F3_SLL) { if (word) { ret inst.SLLW; } ret inst.SLL; }
    if (funct3 == F3_SRL) { if (word) { ret inst.SRLW; } ret inst.SRL; }
    if (word) { ret inst.MOP_NONE; }
    if (funct3 == F3_SLT)  { ret inst.SLT; }
    if (funct3 == F3_SLTU) { ret inst.SLTU; }
    if (funct3 == F3_XOR)  { ret inst.XOR; }
    if (funct3 == F3_OR)   { ret inst.OR; }
    if (funct3 == F3_AND)  { ret inst.AND; }
    ret inst.MOP_NONE;
}

fun classify_fp(funct3: u32, funct7: u32, rs2: u32) inst.MachOp {
    val dbl: bool = (funct7 & 1) != 0;
    val base: u32 = funct7 & 0xFE;

    if (base == F7_FADD) { if (dbl) { ret inst.FADD_D; } ret inst.FADD_S; }
    if (base == F7_FSUB) { if (dbl) { ret inst.FSUB_D; } ret inst.FSUB_S; }
    if (base == F7_FMUL) { if (dbl) { ret inst.FMUL_D; } ret inst.FMUL_S; }
    if (base == F7_FDIV) { if (dbl) { ret inst.FDIV_D; } ret inst.FDIV_S; }
    if (base == F7_FSGNJ) {
        if (funct3 == 0) { if (dbl) { ret inst.FSGNJ_D; }  ret inst.FSGNJ_S; }
        if (funct3 == 1) { if (dbl) { ret inst.FSGNJN_D; } ret inst.FSGNJN_S; }
        if (funct3 == 2) { if (dbl) { ret inst.FSGNJX_D; } ret inst.FSGNJX_S; }
        ret inst.MOP_NONE;
    }
    if (base == F7_FCMP) {
        if (funct3 == F3_FLE) { if (dbl) { ret inst.FLE_D; } ret inst.FLE_S; }
        if (funct3 == F3_FLT) { if (dbl) { ret inst.FLT_D; } ret inst.FLT_S; }
        if (funct3 == F3_FEQ) { if (dbl) { ret inst.FEQ_D; } ret inst.FEQ_S; }
        ret inst.MOP_NONE;
    }
    if (base == F7_FCVT_F2F) { if (dbl) { ret inst.FCVT_D_S; } ret inst.FCVT_S_D; }
    if (base == F7_FCVT_F2I) {
        if (rs2 == FCVT_W)  { if (dbl) { ret inst.FCVT_W_D; }  ret inst.FCVT_W_S; }
        if (rs2 == FCVT_WU) { if (dbl) { ret inst.FCVT_WU_D; } ret inst.FCVT_WU_S; }
        if (rs2 == FCVT_L)  { if (dbl) { ret inst.FCVT_L_D; }  ret inst.FCVT_L_S; }
        if (rs2 == FCVT_LU) { if (dbl) { ret inst.FCVT_LU_D; } ret inst.FCVT_LU_S; }
        ret inst.MOP_NONE;
    }
    if (base == F7_FCVT_I2F) {
        if (rs2 == FCVT_W)  { if (dbl) { ret inst.FCVT_D_W; }  ret inst.FCVT_S_W; }
        if (rs2 == FCVT_WU) { if (dbl) { ret inst.FCVT_D_WU; } ret inst.FCVT_S_WU; }
        if (rs2 == FCVT_L)  { if (dbl) { ret inst.FCVT_D_L; }  ret inst.FCVT_S_L; }
        if (rs2 == FCVT_LU) { if (dbl) { ret inst.FCVT_D_LU; } ret inst.FCVT_S_LU; }
        ret inst.MOP_NONE;
    }
    if (base == F7_FMV_F2I) { if (dbl) { ret inst.FMV_X_D; } ret inst.FMV_X_W; }
    if (base == F7_FMV_I2F) { if (dbl) { ret inst.FMV_D_X; } ret inst.FMV_W_X; }
    ret inst.MOP_NONE;
}

fun classify_amo(funct3: u32, funct7: u32) inst.MachOp {
    if (funct3 != F3_AMO_W && funct3 != F3_AMO_D) { ret inst.MOP_NONE; }
    val word: bool = funct3 == F3_AMO_W;
    val funct5: u32 = (funct7 >> 2) & 0x1F;

    if (funct5 == A5_LR)      { if (word) { ret inst.LR_W; }      ret inst.LR_D; }
    if (funct5 == A5_SC)      { if (word) { ret inst.SC_W; }      ret inst.SC_D; }
    if (funct5 == A5_AMOSWAP) { if (word) { ret inst.AMOSWAP_W; } ret inst.AMOSWAP_D; }
    if (funct5 == A5_AMOADD)  { if (word) { ret inst.AMOADD_W; }  ret inst.AMOADD_D; }
    if (funct5 == A5_AMOXOR)  { if (word) { ret inst.AMOXOR_W; }  ret inst.AMOXOR_D; }
    if (funct5 == A5_AMOAND)  { if (word) { ret inst.AMOAND_W; }  ret inst.AMOAND_D; }
    if (funct5 == A5_AMOOR)   { if (word) { ret inst.AMOOR_W; }   ret inst.AMOOR_D; }
    if (funct5 == A5_AMOMIN)  { if (word) { ret inst.AMOMIN_W; }  ret inst.AMOMIN_D; }
    if (funct5 == A5_AMOMAX)  { if (word) { ret inst.AMOMAX_W; }  ret inst.AMOMAX_D; }
    if (funct5 == A5_AMOMINU) { if (word) { ret inst.AMOMINU_W; } ret inst.AMOMINU_D; }
    if (funct5 == A5_AMOMAXU) { if (word) { ret inst.AMOMAXU_W; } ret inst.AMOMAXU_D; }
    ret inst.MOP_NONE;
}

fun classify_i(opcode: u32, funct3: u32, imm12: u32) inst.MachOp {
    if (opcode == OPC_LOAD) {
        if (funct3 == 0x0) { ret inst.LB; }
        if (funct3 == 0x1) { ret inst.LH; }
        if (funct3 == 0x2) { ret inst.LW; }
        if (funct3 == 0x3) { ret inst.LD; }
        if (funct3 == 0x4) { ret inst.LBU; }
        if (funct3 == 0x5) { ret inst.LHU; }
        if (funct3 == 0x6) { ret inst.LWU; }
        ret inst.MOP_NONE;
    }
    if (opcode == OPC_LOAD_FP) {
        if (funct3 == 0x2) { ret inst.FLW; }
        if (funct3 == 0x3) { ret inst.FLD; }
        ret inst.MOP_NONE;
    }
    if (opcode == OPC_JALR)   { ret inst.JALR; }
    if (opcode == OPC_SYSTEM) {
        if (funct3 == F3_CSRRW)  { ret inst.CSRRW; }
        if (funct3 == F3_CSRRS)  { ret inst.CSRRS; }
        if (funct3 == F3_CSRRC)  { ret inst.CSRRC; }
        if (funct3 == F3_CSRRWI) { ret inst.CSRRWI; }
        if (funct3 == F3_CSRRSI) { ret inst.CSRRSI; }
        if (funct3 == F3_CSRRCI) { ret inst.CSRRCI; }
        if (imm12 == 0) { ret inst.ECALL; }
        if (imm12 == 1) { ret inst.EBREAK; }
        ret inst.MOP_NONE;
    }
    if (opcode == OPC_MISC_MEM) {
        if (imm12 == 0x010) { ret inst.PAUSE; }
        ret inst.FENCE;
    }
    if (opcode != OPC_OP_IMM && opcode != OPC_OP_IMM_32) { ret inst.MOP_NONE; }
    val word: bool = opcode == OPC_OP_IMM_32;

    if (funct3 == F3_SLL) { if (word) { ret inst.SLLIW; } ret inst.SLLI; }
    if (funct3 == F3_SRL) {
        if ((imm12 & 0x400) != 0) { if (word) { ret inst.SRAIW; } ret inst.SRAI; }
        if (word) { ret inst.SRLIW; }
        ret inst.SRLI;
    }
    if (funct3 == F3_ADD) { if (word) { ret inst.ADDIW; } ret inst.ADDI; }
    if (word) { ret inst.MOP_NONE; }
    if (funct3 == F3_SLT)  { ret inst.SLTI; }
    if (funct3 == F3_SLTU) { ret inst.SLTIU; }
    if (funct3 == F3_XOR)  { ret inst.XORI; }
    if (funct3 == F3_OR)   { ret inst.ORI; }
    if (funct3 == F3_AND)  { ret inst.ANDI; }
    ret inst.MOP_NONE;
}

fun classify_s(opcode: u32, funct3: u32) inst.MachOp {
    if (opcode == OPC_STORE) {
        if (funct3 == 0x0) { ret inst.SB; }
        if (funct3 == 0x1) { ret inst.SH; }
        if (funct3 == 0x2) { ret inst.SW; }
        if (funct3 == 0x3) { ret inst.SD; }
        ret inst.MOP_NONE;
    }
    if (opcode == OPC_STORE_FP) {
        if (funct3 == 0x2) { ret inst.FSW; }
        if (funct3 == 0x3) { ret inst.FSD; }
        ret inst.MOP_NONE;
    }
    ret inst.MOP_NONE;
}

fun classify_b(opcode: u32, funct3: u32) inst.MachOp {
    if (opcode != OPC_BRANCH) { ret inst.MOP_NONE; }
    if (funct3 == F3_BEQ)  { ret inst.BEQ; }
    if (funct3 == F3_BNE)  { ret inst.BNE; }
    if (funct3 == F3_BLT)  { ret inst.BLT; }
    if (funct3 == F3_BGE)  { ret inst.BGE; }
    if (funct3 == F3_BLTU) { ret inst.BLTU; }
    if (funct3 == F3_BGEU) { ret inst.BGEU; }
    ret inst.MOP_NONE;
}

fun classify_u(opcode: u32) inst.MachOp {
    if (opcode == OPC_LUI)   { ret inst.LUI; }
    if (opcode == OPC_AUIPC) { ret inst.AUIPC; }
    ret inst.MOP_NONE;
}

fun classify_j(opcode: u32) inst.MachOp {
    if (opcode != OPC_JAL) { ret inst.MOP_NONE; }
    ret inst.JAL;
}

fun last_inst(st: *encode.EncodeState) *isa.Inst {
    val count: u32 = encode.note_count(?st.buf);
    if (count == 0) { ret nil; }
    val n: *encode.AsmNote = encode.note_at(?st.buf, count - 1);
    if (n == nil || n.kind != encode.ASM_NOTE_INST) { ret nil; }
    ret ?n.inst;
}

fun target_operand(mi: *isa.Inst) *isa.Operand {
    val shape: u8 = shape_of(mi.opcode::inst.MachOp);
    if (shape == SH_RRI || shape == SH_BRANCH) { ret ?mi.src2; }
    if (shape == SH_RU || shape == SH_JUMP || shape == SH_LOAD || shape == SH_FLOAD) { ret ?mi.src1; }
    if (shape == SH_STORE || shape == SH_FSTORE) { ret ?mi.dst; }
    ret nil;
}

fun last_target(st: *encode.EncodeState) *isa.Operand {
    val mi: *isa.Inst = last_inst(st);
    if (mi == nil) { ret nil; }
    val op: *isa.Operand = target_operand(mi);
    if (op == nil) {
        encode.sink_fail(?st.buf,
            "--emit-asm: a riscv64 instruction with no target field was given a branch or symbol target");
        ret nil;
    }
    ret op;
}

fun note_block_target(st: *encode.EncodeState, block: u32) {
    val op: *isa.Operand = last_target(st);
    if (op == nil) { ret; }
    @op = isa.make_block_label(block);
}

fun note_skip_target(st: *encode.EncodeState, bytes: i64) {
    val op: *isa.Operand = last_target(st);
    if (op == nil) { ret; }
    @op = isa.make_block_label(0);
    op.imm = bytes;
    last_inst(st).flags = last_inst(st).flags | inst.FLAG_LABEL_SKIP;
}

fun note_local_target(st: *encode.EncodeState, number: u64, fwd: bool) {
    val op: *isa.Operand = last_target(st);
    if (op == nil) { ret; }
    val mi: *isa.Inst = last_inst(st);
    @op = isa.make_block_label(0);
    op.imm   = number::i64;
    mi.flags = mi.flags | inst.FLAG_LABEL_LOCAL;
    if (fwd) { mi.flags = mi.flags | inst.FLAG_LABEL_FWD; }
}

fun note_sym_target(st: *encode.EncodeState, sym: intern.StrId, mod: isa.SymModifier, addend: i32) {
    val op: *isa.Operand = last_target(st);
    if (op == nil) { ret; }
    if (op.kind == isa.OPK_MEM) {
        op.sym_id     = sym::u32;
        op.sym_mod    = mod;
        op.disp       = 0;
        op.sym_addend = addend;
        ret;
    }
    @op = isa.make_sym_addend(sym::u32, st.model.pointer_width::u8, mod, addend);
}

fun read_word(buf: *encode.ByteBuf, pos: usize) u32 {
    ret buf.data[pos]::u32 |
        (buf.data[pos + 1]::u32 << 8) |
        (buf.data[pos + 2]::u32 << 16) |
        (buf.data[pos + 3]::u32 << 24);
}

fun write_word(buf: *encode.ByteBuf, pos: usize, word: u32) {
    buf.data[pos]     = (word & 0xFF)::u8;
    buf.data[pos + 1] = ((word >> 8) & 0xFF)::u8;
    buf.data[pos + 2] = ((word >> 16) & 0xFF)::u8;
    buf.data[pos + 3] = ((word >> 24) & 0xFF)::u8;
}

fun xlen(st: *encode.EncodeState) u8 { ret st.model.gpr_width::u8; }

fun flen(st: *encode.EncodeState) u8 { ret (st.model.flen_bits / 8)::u8; }

fun alu_opcode(width: u8, xl: u8) u32 {
    if (width == 4 && xl == 8) { ret OPC_OP_32; }
    ret OPC_OP;
}

fun alu_imm_opcode(width: u8, xl: u8) u32 {
    if (width == 4 && xl == 8) { ret OPC_OP_IMM_32; }
    ret OPC_OP_IMM;
}

fun int_mem_funct3(width: u8, is_load: bool, xl: u8) R.Result[u32, str] {
    if (width > xl) {
        ret R.err[u32, str]("internal compiler error: this RISC-V machine has no integer memory access wider than its registers");
    }
    if (width == 1) { if (is_load) { ret R.ok[u32, str](0x4); } ret R.ok[u32, str](0x0); }
    if (width == 2) { if (is_load) { ret R.ok[u32, str](0x5); } ret R.ok[u32, str](0x1); }
    if (width == 4) { if (is_load) { ret R.ok[u32, str](0x2); } ret R.ok[u32, str](0x2); }
    if (width == 8) { if (is_load) { ret R.ok[u32, str](0x3); } ret R.ok[u32, str](0x3); }
    ret R.err[u32, str]("internal compiler error: riscv has no integer memory access form for this width (expected 1, 2, 4, or 8)");
}

fun req_gpr(op: *mir.MirOperand) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_PREG) {
        if (isa.regid_class(op.preg::i32) != isa.REG_CLASS_ID_GP) {
            ret R.err[i32, str]("internal compiler error: a float register reached a general-purpose operand position");
        }
        ret R.ok[i32, str](isa.regid_index(op.preg::i32));
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret R.err[i32, str]("encode: virtual register survived register allocation");
    }
    ret R.err[i32, str]("encode: expected a register operand");
}

fun sext12(v: i64) i64 {
    var x: i64 = v & 0xFFF;
    if ((x & 0x800) != 0) { x = x - 0x1000; }
    ret x;
}

fun emit_li32(st: *encode.EncodeState, rd: u32, v: i32) {
    val hi20: u32 = ((v + 0x800) >> 12)::u32 & 0xFFFFF;
    val lo12: u32 = v::u32 & 0xFFF;
    emit_u(st, OPC_LUI, rd, hi20);
    if (lo12 != 0) { emit_i(st, alu_imm_opcode(4, xlen(st)), F3_ADD, rd, rd, lo12); }
}

fun emit_li(st: *encode.EncodeState, rd: u32, value: i64) {
    if (value >= -2048 && value <= 2047) {
        emit_i(st, OPC_OP_IMM, F3_ADD, rd, RZERO, value::u32 & 0xFFF);
        ret;
    }
    if (value >= -2147483648 && value <= 2147483647) {
        emit_li32(st, rd, value::i32);
        ret;
    }
    val lo12: i64 = sext12(value);
    val hi: i64 = (value - lo12) >> 12;
    emit_li(st, rd, hi);
    emit_i(st, OPC_OP_IMM, F3_SLL, rd, rd, 12);
    if (lo12 != 0) { emit_i(st, OPC_OP_IMM, F3_ADD, rd, rd, lo12::u32 & 0xFFF); }
}

fun imm_sext_for_width(value: i64, width: u8) i64 {
    if (width != 4) { ret value; }
    var x: i64 = value & 0xFFFFFFFF;
    if ((x & 0x80000000) != 0) { x = x - 0x100000000; }
    ret x;
}

fun resolve_source(st: *encode.EncodeState, op: *mir.MirOperand, scratch: u32, width: u8) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_IMM) {
        emit_li(st, scratch, imm_sext_for_width(op.imm, width));
        ret R.ok[i32, str](scratch::i32);
    }
    ret req_gpr(op);
}

fun emit_addi(st: *encode.EncodeState, rd: u32, rs1: u32, off: i64) {
    if (off >= -2048 && off <= 2047) {
        emit_i(st, OPC_OP_IMM, F3_ADD, rd, rs1, off::u32 & 0xFFF);
        ret;
    }
    emit_li(st, SCRATCH, off);
    emit_r(st, OPC_OP, F3_ADD, F7_ZERO, rd, rs1, SCRATCH);
}

fun emit_mem_access(st: *encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) R.Result[R.Void, str] {
    val f3r: R.Result[u32, str] = int_mem_funct3(width, is_load, xlen(st));
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }
    val f3: u32 = R.unwrap_ok[u32, str](f3r);
    var b: u32 = base;
    var d: i64 = off;
    if (off < -2048 || off > 2047) {
        emit_li(st, SCRATCH2, off);
        emit_r(st, OPC_OP, F3_ADD, F7_ZERO, SCRATCH2, base, SCRATCH2);
        b = SCRATCH2;
        d = 0;
    }
    if (is_load) {
        emit_i(st, OPC_LOAD, f3, rt, b, d::u32 & 0xFFF);
        ret R.ok_void[str]();
    }
    emit_s(st, OPC_STORE, f3, b, rt, d::u32 & 0xFFF);
    ret R.ok_void[str]();
}

pub fun frame_reserved_top(st: *encode.EncodeState, f: *mir.MirFunction) i64 {
    val gp_bytes: u32 = popcount32(f.callee_mask) * xlen(st)::u32;
    val fp_bytes: u32 = popcount32(f.callee_mask_fp) * flen(st)::u32;
    val n: u32 = (2 * xlen(st)::u32) + gp_bytes + fp_bytes;
    if (f.frame.realign != 0) {
        val rmask: u32 = f.frame.realign - 1;
        ret ((n + rmask) & ~rmask)::i64;
    }
    ret n::i64;
}

fun frame_slot_offset(f: *mir.MirFunction, v: u32) O.Option[i64] {
    if (codegen_frame.slots_from_sp(?f.frame)) {
        ret codegen_frame.slot_sp_offset(?f.frame, v);
    }
    ret codegen_frame.slot_offset(?f.frame, v);
}

fun slot_base_reg(f: *mir.MirFunction) u32 {
    if (codegen_frame.slots_from_sp(?f.frame)) { ret RSP; }
    ret RFP;
}

fun asm_slot_offset(f: *mir.MirFunction, v: u32) O.Option[i64] {
    ret codegen_frame.slot_sp_offset(?f.frame, v);
}

rec RvMem {
    base:      u32;
    off:       i64;
    has_index: bool;
    index:     u32;
    scale:     u8;
}

fun resolve_mem(f: *mir.MirFunction, op: *mir.MirOperand) R.Result[RvMem, str] {
    if (op.kind != mir.MIR_OP_MEM) {
        ret R.err[RvMem, str]("encode: expected a memory operand");
    }
    var m: RvMem;
    m.has_index = false;
    m.index     = 0;
    m.scale     = 0;
    if (op.index != mir.MIR_VREG_NIL) {
        if (!op.index_is_preg) {
            ret R.err[RvMem, str]("encode: value vreg survived in a memory-operand index");
        }
        m.has_index = true;
        m.index     = op.index;
        m.scale     = op.scale;
    }
    if (op.vreg != mir.MIR_VREG_NIL) {
        val slot: O.Option[i64] = frame_slot_offset(f, op.vreg);
        if (!O.is_some[i64](slot)) {
            ret R.err[RvMem, str]("encode: value vreg survived in a memory-operand base");
        }
        m.base = slot_base_reg(f);
        m.off  = O.unwrap[i64](slot) + op.imm;
        ret R.ok[RvMem, str](m);
    }
    m.base = op.preg;
    m.off  = op.imm;
    ret R.ok[RvMem, str](m);
}

fun scale_shift(scale: u8) R.Result[u32, str] {
    if (scale == 1) { ret R.ok[u32, str](0); }
    if (scale == 2) { ret R.ok[u32, str](1); }
    if (scale == 4) { ret R.ok[u32, str](2); }
    if (scale == 8) { ret R.ok[u32, str](3); }
    ret R.err[u32, str]("encode: a scaled-index address must have a scale of 1, 2, 4, or 8");
}

fun encode_alu3(st: *encode.EncodeState, mi: *mir.MirInstr, funct3: u32, funct7: u32, word_form: bool) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: ALU op missing operands"); }

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH2, mi.width);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rs1: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_source(st, ?mi.operands[2], SCRATCH, mi.width);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rs2: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    var opcode: u32 = OPC_OP;
    if (word_form) { opcode = alu_opcode(mi.width, xlen(st)); }
    emit_r(st, opcode, funct3, funct7, rd, rs1, rs2);
    ret R.ok_void[str]();
}

fun encode_addsub(st: *encode.EncodeState, mi: *mir.MirInstr, is_sub: bool) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: add/sub missing operands"); }

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH2, mi.width);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rs1: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rhs: *mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == mir.MIR_OP_IMM) {
        var v: i64 = rhs.imm;
        if (is_sub) { v = 0 - v; }
        if (v >= -2048 && v <= 2047) {
            emit_i(st, alu_imm_opcode(mi.width, xlen(st)), F3_ADD, rd, rs1, v::u32 & 0xFFF);
            ret R.ok_void[str]();
        }
    }

    val rmr: R.Result[i32, str] = resolve_source(st, rhs, SCRATCH, mi.width);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rs2: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    var f7: u32 = F7_ZERO;
    if (is_sub) { f7 = F7_SUB; }
    emit_r(st, alu_opcode(mi.width, xlen(st)), F3_ADD, f7, rd, rs1, rs2);
    ret R.ok_void[str]();
}

fun encode_shift(st: *encode.EncodeState, mi: *mir.MirInstr, funct3: u32, is_arith: bool) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: shift missing operands"); }

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH2, mi.width);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rs1: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rhs: *mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == mir.MIR_OP_IMM) {
        var mask: u32 = 0x3F;
        if (mi.width == 4) { mask = 0x1F; }
        var imm: u32 = rhs.imm::u32 & mask;
        if (is_arith) { imm = imm | 0x400; }
        emit_i(st, alu_imm_opcode(mi.width, xlen(st)), funct3, rd, rs1, imm);
        ret R.ok_void[str]();
    }

    val rmr: R.Result[i32, str] = req_gpr(rhs);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rs2: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    var f7: u32 = F7_ZERO;
    if (is_arith) { f7 = F7_SUB; }
    emit_r(st, alu_opcode(mi.width, xlen(st)), funct3, f7, rd, rs1, rs2);
    ret R.ok_void[str]();
}

fun encode_neg(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: neg missing operands"); }
    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    val rsr: R.Result[i32, str] = req_gpr(?mi.operands[1]);
    if (R.is_err[i32, str](rsr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rsr)); }
    val rs: u32 = R.unwrap_ok[i32, str](rsr)::u32;
    emit_r(st, alu_opcode(mi.width, xlen(st)), F3_ADD, F7_SUB, rd, RZERO, rs);
    ret R.ok_void[str]();
}

fun encode_not(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: not missing operands"); }
    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    val rsr: R.Result[i32, str] = req_gpr(?mi.operands[1]);
    if (R.is_err[i32, str](rsr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rsr)); }
    val rs: u32 = R.unwrap_ok[i32, str](rsr)::u32;
    emit_i(st, OPC_OP_IMM, F3_XOR, rd, rs, 0xFFF);
    ret R.ok_void[str]();
}

fun encode_mov(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: mov missing operands"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_MEM) {
        ret emit_store_mem(st, f, dst, src, mi.width);
    }

    val rdr: R.Result[i32, str] = req_gpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    if (src.kind == mir.MIR_OP_MEM) {
        val mr: R.Result[RvMem, str] = resolve_mem(f, src);
        if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
        val m: RvMem = R.unwrap_ok[RvMem, str](mr);
        ret emit_mem_access(st, rd, m.base, m.off, mi.width, true);
    }
    if (src.kind == mir.MIR_OP_IMM) {
        emit_li(st, rd, imm_sext_for_width(src.imm, mi.width));
        ret R.ok_void[str]();
    }

    val rsr: R.Result[i32, str] = req_gpr(src);
    if (R.is_err[i32, str](rsr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rsr)); }
    val rs: u32 = R.unwrap_ok[i32, str](rsr)::u32;
    emit_i(st, OPC_OP_IMM, F3_ADD, rd, rs, 0);
    ret R.ok_void[str]();
}

fun emit_store_mem(st: *encode.EncodeState, f: *mir.MirFunction, dst_mem: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) R.Result[R.Void, str] {
    if (reg_is_fp(val_op)) {
        if (dst_mem.kind == mir.MIR_OP_SYM) {
            ret R.err[R.Void, str]("encode: float store to a folded-global symbol is unsupported");
        }
        val rr: R.Result[i32, str] = req_fpr(val_op);
        if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
        ret emit_fp_slot_store(st, f, dst_mem, R.unwrap_ok[i32, str](rr)::u32, width);
    }
    if (is_fp_slot(f, val_op)) {
        if (dst_mem.kind == mir.MIR_OP_SYM) {
            ret R.err[R.Void, str]("encode: float store to a folded-global symbol is unsupported");
        }
        val ldr: R.Result[R.Void, str] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH, width);
        if (R.is_err[R.Void, str](ldr)) { ret ldr; }
        ret emit_fp_slot_store(st, f, dst_mem, FP_SCRATCH, width);
    }
    if (dst_mem.kind == mir.MIR_OP_SYM) {
        ret emit_global_store(st, dst_mem, val_op, width);
    }
    val mr: R.Result[RvMem, str] = resolve_mem(f, dst_mem);
    if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
    val m: RvMem = R.unwrap_ok[RvMem, str](mr);

    var rt: u32 = RZERO;
    if (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_li(st, SCRATCH, val_op.imm);
            rt = SCRATCH;
        }
    } or {
        val rr: R.Result[i32, str] = req_gpr(val_op);
        if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
        rt = R.unwrap_ok[i32, str](rr)::u32;
    }
    ret emit_mem_access(st, rt, m.base, m.off, width, false);
}

fun emit_pcrel_hi(st: *encode.EncodeState, rd: u32, sym: intern.StrId, addend: i32) R.Result[R.Void, str] {
    val pos: u32 = st.buf.len::u32;
    emit_u(st, OPC_AUIPC, rd, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_HI, addend);
    val pushed: R.Result[R.Void, str] =
        encode.push_reloc(st, pos, of.RK_PCREL_HI20, sym, addend);
    if (R.is_err[R.Void, str](pushed)) { ret pushed; }
    ret encode.bind_reloc_pair_site(st, of.RK_PCREL_HI20, sym, st.reloc_count - 1);
}

val PCREL_LABEL_FLAGS: u32 = 0;

fun push_pcrel_lo(st: *encode.EncodeState, lo_pos: u32, kind: of.RelocKind,
                  sym: intern.StrId) R.Result[R.Void, str] {
    val found: R.Result[*encode.RelocPairSite, str] =
        encode.reloc_pair_site(st, of.RK_PCREL_HI20, sym);
    if (R.is_err[*encode.RelocPairSite, str](found)) {
        ret R.err[R.Void, str]("encode: riscv64 pc-relative low-12 names a symbol no preceding 'auipc rd, %pcrel_hi(sym)' in this .text materialized");
    }
    val site: *encode.RelocPairSite = R.unwrap_ok[*encode.RelocPairSite, str](found);
    if (site.label == intern.STR_NIL) {
        val named: R.Result[intern.StrId, str] =
            encode.intern_local_label(st, ".Lpcrel_hi.", st.pcrel_label_count);
        if (R.is_err[intern.StrId, str](named)) {
            ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](named));
        }
        val label: intern.StrId = R.unwrap_ok[intern.StrId, str](named);
        st.pcrel_label_count = st.pcrel_label_count + 1;
        val high_offset: u32 = st.relocs[site.reloc_index].offset;
        val marked: R.Result[R.Void, str] =
            encode.push_symbol(st, label, high_offset, PCREL_LABEL_FLAGS);
        if (R.is_err[R.Void, str](marked)) { ret marked; }
        site.label = label;
    }
    val high_index: u32 = site.reloc_index;
    val pushed: R.Result[R.Void, str] = encode.push_reloc(st, lo_pos, kind, site.label, 0);
    if (R.is_err[R.Void, str](pushed)) { ret pushed; }
    ret encode.bind_reloc_pair(st, st.reloc_count - 1, high_index);
}

fun emit_global_addr(st: *encode.EncodeState, rd: u32, symop: *mir.MirOperand) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: address-of has no resolved symbol name");
    }
    val hr: R.Result[R.Void, str] = emit_pcrel_hi(st, rd, symop.sym, symop.sym_off);
    if (R.is_err[R.Void, str](hr)) { ret hr; }
    val lo_pos: u32 = st.buf.len::u32;
    emit_i(st, OPC_OP_IMM, F3_ADD, rd, rd, 0);
    note_sym_target(st, symop.sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, lo_pos, of.RK_PCREL_LO12_I, symop.sym);
}

fun emit_global_load(st: *encode.EncodeState, rt: u32, symop: *mir.MirOperand, width: u8) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: folded-global load has no resolved symbol name");
    }
    val f3r: R.Result[u32, str] = int_mem_funct3(width, true, xlen(st));
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }
    val hr: R.Result[R.Void, str] = emit_pcrel_hi(st, SCRATCH, symop.sym, symop.sym_off);
    if (R.is_err[R.Void, str](hr)) { ret hr; }
    val lo_pos: u32 = st.buf.len::u32;
    emit_i(st, OPC_LOAD, R.unwrap_ok[u32, str](f3r), rt, SCRATCH, 0);
    note_sym_target(st, symop.sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, lo_pos, of.RK_PCREL_LO12_I, symop.sym);
}

fun emit_global_store(st: *encode.EncodeState, symop: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: folded-global store has no resolved symbol name");
    }
    val f3r: R.Result[u32, str] = int_mem_funct3(width, false, xlen(st));
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }
    var rt: u32 = RZERO;
    if (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_li(st, SCRATCH2, val_op.imm);
            rt = SCRATCH2;
        }
    } or {
        val rr: R.Result[i32, str] = req_gpr(val_op);
        if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
        rt = R.unwrap_ok[i32, str](rr)::u32;
    }
    val hr: R.Result[R.Void, str] = emit_pcrel_hi(st, SCRATCH, symop.sym, symop.sym_off);
    if (R.is_err[R.Void, str](hr)) { ret hr; }
    val lo_pos: u32 = st.buf.len::u32;
    emit_s(st, OPC_STORE, R.unwrap_ok[u32, str](f3r), SCRATCH, rt, 0);
    note_sym_target(st, symop.sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, lo_pos, of.RK_PCREL_LO12_S, symop.sym);
}

fun encode_load(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: load missing operands"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];
    if (is_fp_slot(f, dst)) {
        val ldr: R.Result[R.Void, str] = emit_fp_slot_load(st, f, src, FP_SCRATCH, mi.src_width);
        if (R.is_err[R.Void, str](ldr)) { ret ldr; }
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, mi.src_width);
    }
    if (reg_is_fp(dst)) {
        if (src.kind == mir.MIR_OP_SYM) {
            ret R.err[R.Void, str]("encode: float load from a folded-global symbol is unsupported");
        }
        val frd: R.Result[i32, str] = req_fpr(dst);
        if (R.is_err[i32, str](frd)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](frd)); }
        val fmr: R.Result[RvMem, str] = resolve_mem(f, src);
        if (R.is_err[RvMem, str](fmr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](fmr)); }
        val fm: RvMem = R.unwrap_ok[RvMem, str](fmr);
        ret emit_fp_mem(st, R.unwrap_ok[i32, str](frd)::u32, fm.base, fm.off, mi.src_width, true);
    }
    val rdr: R.Result[i32, str] = req_gpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    if (src.kind == mir.MIR_OP_SYM) { ret emit_global_load(st, rd, src, mi.src_width); }
    val mr: R.Result[RvMem, str] = resolve_mem(f, src);
    if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
    val m: RvMem = R.unwrap_ok[RvMem, str](mr);
    ret emit_mem_access(st, rd, m.base, m.off, mi.src_width, true);
}

fun encode_store(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: store missing operands"); }
    ret emit_store_mem(st, f, ?mi.operands[0], ?mi.operands[1], mi.width);
}

fun encode_addr(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: address op missing operands"); }
    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    val memop: *mir.MirOperand = ?mi.operands[1];
    if (memop.kind == mir.MIR_OP_SYM) { ret emit_global_addr(st, rd, memop); }
    val mr: R.Result[RvMem, str] = resolve_mem(f, memop);
    if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
    val m: RvMem = R.unwrap_ok[RvMem, str](mr);

    if (m.has_index) {
        var idx: u32 = m.index;
        val shr: R.Result[u32, str] = scale_shift(m.scale);
        if (R.is_err[u32, str](shr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](shr)); }
        val sh: u32 = R.unwrap_ok[u32, str](shr);
        if (sh != 0) {
            emit_i(st, OPC_OP_IMM, F3_SLL, SCRATCH, m.index, sh);
            idx = SCRATCH;
        }
        emit_r(st, OPC_OP, F3_ADD, F7_ZERO, rd, m.base, idx);
        if (m.off != 0) { emit_addi(st, rd, rd, m.off); }
        ret R.ok_void[str]();
    }
    emit_addi(st, rd, m.base, m.off);
    ret R.ok_void[str]();
}

fun is_mir_compare(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_CMP_EQ || op == mir.MIR_SEL_CMP_NE ||
        op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U ||
        op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U;
}

fun narrow_cmp_source(st: *encode.EncodeState, reg: u32, scratch: u32, width: u8, signed: bool) u32 {
    if (width == 0 || width >= 4) { ret reg; }
    val sh: u32 = (xlen(st)::u32 * 8) - (width::u32 * 8);
    if (signed) {
        emit_i(st, OPC_OP_IMM, F3_SLL, scratch, reg, sh);
        emit_i(st, OPC_OP_IMM, F3_SRL, scratch, scratch, sh | 0x400);
        ret scratch;
    }
    if (width == 1) {
        emit_i(st, OPC_OP_IMM, F3_AND, scratch, reg, 0xFF);
        ret scratch;
    }
    emit_i(st, OPC_OP_IMM, F3_SLL, scratch, reg, sh);
    emit_i(st, OPC_OP_IMM, F3_SRL, scratch, scratch, sh);
    ret scratch;
}

fun resolve_cmp_sources(st: *encode.EncodeState, lhs_op: *mir.MirOperand, rhs_op: *mir.MirOperand,
                        width: u8, signed: bool, out_lhs: *u32, out_rhs: *u32) R.Result[R.Void, str] {
    val rnr: R.Result[i32, str] = resolve_source(st, lhs_op, SCRATCH2, width);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    var lhs: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_source(st, rhs_op, SCRATCH, width);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    var rhs: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    @out_lhs = narrow_cmp_source(st, lhs, SCRATCH2, width, signed);
    @out_rhs = narrow_cmp_source(st, rhs, SCRATCH, width, signed);
    ret R.ok_void[str]();
}

fun encode_compare(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: compare missing operands"); }

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    var lhs: u32 = 0;
    var rhs: u32 = 0;
    val rs: R.Result[R.Void, str] = resolve_cmp_sources(st, ?mi.operands[1], ?mi.operands[2], mi.width, mir.is_signed_cmp(mi.opcode), ?lhs, ?rhs);
    if (R.is_err[R.Void, str](rs)) { ret rs; }

    val op: mir.MirOpcode = mi.opcode;
    if (op == mir.MIR_SEL_CMP_EQ) {
        emit_r(st, OPC_OP, F3_XOR, F7_ZERO, rd, lhs, rhs);
        emit_i(st, OPC_OP_IMM, F3_SLTU, rd, rd, 1);
        ret R.ok_void[str]();
    }
    if (op == mir.MIR_SEL_CMP_NE) {
        emit_r(st, OPC_OP, F3_XOR, F7_ZERO, rd, lhs, rhs);
        emit_r(st, OPC_OP, F3_SLTU, F7_ZERO, rd, RZERO, rd);
        ret R.ok_void[str]();
    }
    if (op == mir.MIR_SEL_CMP_LT_S) {
        emit_r(st, OPC_OP, F3_SLT, F7_ZERO, rd, lhs, rhs);
        ret R.ok_void[str]();
    }
    if (op == mir.MIR_SEL_CMP_LT_U) {
        emit_r(st, OPC_OP, F3_SLTU, F7_ZERO, rd, lhs, rhs);
        ret R.ok_void[str]();
    }
    if (op == mir.MIR_SEL_CMP_LE_S) {
        emit_r(st, OPC_OP, F3_SLT, F7_ZERO, rd, rhs, lhs);
        emit_i(st, OPC_OP_IMM, F3_XOR, rd, rd, 1);
        ret R.ok_void[str]();
    }
    emit_r(st, OPC_OP, F3_SLTU, F7_ZERO, rd, rhs, lhs);
    emit_i(st, OPC_OP_IMM, F3_XOR, rd, rd, 1);
    ret R.ok_void[str]();
}

fun encode_branch(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: branch target is not a block");
    }
    val target_block: u32 = mi.operands[0].imm::u32;
    if (encode.branch_falls_through(st, target_block)) { ret R.ok_void[str](); }
    val patch_pos: u32 = st.buf.len::u32;
    emit_j(st, OPC_JAL, RZERO, 0);
    note_block_target(st, target_block);
    val next_ip: u32 = st.buf.len::u32;
    ret encode.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
}

fun encode_cbr(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: conditional branch missing operands"); }
    if (mi.operands[1].kind != mir.MIR_OP_BLOCK || mi.operands[2].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: conditional branch target is not a block");
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;

    val rcr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rcr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rcr)); }
    val cond: u32 = R.unwrap_ok[i32, str](rcr)::u32;

    val bne_pos: u32 = st.buf.len::u32;
    emit_b(st, OPC_BRANCH, F3_BNE, cond, RZERO, 0);
    note_block_target(st, then_block);
    val bne_next: u32 = st.buf.len::u32;
    val f1: R.Result[R.Void, str] = encode.push_fixup(st, bne_pos, bne_next, then_block, fn_base);
    if (R.is_err[R.Void, str](f1)) { ret f1; }

    if (encode.branch_falls_through(st, else_block)) { ret R.ok_void[str](); }
    val j_pos: u32 = st.buf.len::u32;
    emit_j(st, OPC_JAL, RZERO, 0);
    note_block_target(st, else_block);
    val j_next: u32 = st.buf.len::u32;
    ret encode.push_fixup(st, j_pos, j_next, else_block, fn_base);
}

fun fused_cbr_funct3(op: mir.MirOpcode, swap: *bool) R.Result[u32, str] {
    @swap = false;
    if (op == mir.MIR_SEL_CBR_EQ)   { ret R.ok[u32, str](F3_BEQ); }
    if (op == mir.MIR_SEL_CBR_NE)   { ret R.ok[u32, str](F3_BNE); }
    if (op == mir.MIR_SEL_CBR_LT_S) { ret R.ok[u32, str](F3_BLT); }
    if (op == mir.MIR_SEL_CBR_LT_U) { ret R.ok[u32, str](F3_BLTU); }
    @swap = true;
    if (op == mir.MIR_SEL_CBR_LE_S) { ret R.ok[u32, str](F3_BGE); }
    if (op == mir.MIR_SEL_CBR_LE_U) { ret R.ok[u32, str](F3_BGEU); }
    @swap = false;
    ret R.err[u32, str]("encode: riscv64 has no fused compare-and-branch form for this relation");
}

fun encode_fused_cbr(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 4) {
        ret R.err[R.Void, str]("encode: fused compare-branch missing operands");
    }
    if (mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: fused compare-branch target is not a block");
    }
    val then_block: u32 = mi.operands[2].imm::u32;
    val else_block: u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.len::u32;

    var lhs: u32 = 0;
    var rhs: u32 = 0;
    val rs: R.Result[R.Void, str] = resolve_cmp_sources(st, ?mi.operands[0], ?mi.operands[1], mi.width, mir.is_signed_cmp(mi.opcode), ?lhs, ?rhs);
    if (R.is_err[R.Void, str](rs)) { ret rs; }

    var swap: bool = false;
    val f3r: R.Result[u32, str] = fused_cbr_funct3(mi.opcode, ?swap);
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }
    val funct3: u32 = R.unwrap_ok[u32, str](f3r);
    var rs1: u32 = lhs;
    var rs2: u32 = rhs;
    if (swap) {
        rs1 = rhs;
        rs2 = lhs;
    }

    val bcc_pos: u32 = st.buf.len::u32;
    emit_b(st, OPC_BRANCH, funct3, rs1, rs2, 0);
    note_block_target(st, then_block);
    val bcc_next: u32 = st.buf.len::u32;
    val f1: R.Result[R.Void, str] = encode.push_fixup(st, bcc_pos, bcc_next, then_block, fn_base);
    if (R.is_err[R.Void, str](f1)) { ret f1; }

    if (encode.branch_falls_through(st, else_block)) {
        encode.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
        ret R.ok_void[str]();
    }
    val j_pos: u32 = st.buf.len::u32;
    emit_j(st, OPC_JAL, RZERO, 0);
    note_block_target(st, else_block);
    val j_next: u32 = st.buf.len::u32;
    encode.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
    ret encode.push_fixup(st, j_pos, j_next, else_block, fn_base);
}

fun encode_call(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 1) { ret R.err[R.Void, str]("encode: call missing callee operand"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind == mir.MIR_OP_SYM) {
        if (callee.sym == intern.STR_NIL) {
            ret R.err[R.Void, str]("encode: direct call has no resolved symbol name");
        }
        val pos: u32 = st.buf.len::u32;
        emit_u(st, OPC_AUIPC, RRA, 0);
        note_sym_target(st, callee.sym, isa.SYM_MOD_PCREL_HI, callee.sym_off);
        emit_i(st, OPC_JALR, F3_ADD, RRA, RRA, 0);
        note_sym_target(st, callee.sym, isa.SYM_MOD_PCREL_LO, 0);
        ret encode.push_reloc(st, pos, of.RK_PLT32, callee.sym, callee.sym_off);
    }
    val rr: R.Result[i32, str] = req_gpr(callee);
    if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
    emit_i(st, OPC_JALR, F3_ADD, RRA, R.unwrap_ok[i32, str](rr)::u32, 0);
    ret R.ok_void[str]();
}

fun is_mir_divide(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_DIV_U ||
        op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;
}

fun divide_funct3(op: mir.MirOpcode) R.Result[u32, str] {
    if (op == mir.MIR_SEL_DIV_S) { ret R.ok[u32, str](F3_DIV); }
    if (op == mir.MIR_SEL_DIV_U) { ret R.ok[u32, str](F3_DIVU); }
    if (op == mir.MIR_SEL_REM_S) { ret R.ok[u32, str](F3_REM); }
    if (op == mir.MIR_SEL_REM_U) { ret R.ok[u32, str](F3_REMU); }
    ret R.err[u32, str]("encode: riscv64 has no M-extension form for this divide / remainder opcode");
}

fun encode_divide(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: divide missing operands"); }

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH2, mi.width);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rs1: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_source(st, ?mi.operands[2], SCRATCH, mi.width);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rs2: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val f3r: R.Result[u32, str] = divide_funct3(mi.opcode);
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }

    val signed: bool = mi.opcode == mir.MIR_SEL_DIV_S || mi.opcode == mir.MIR_SEL_REM_S;
    emit_divide_guard(st, mi, rs1, rs2, signed);
    emit_r(st, alu_opcode(mi.width, xlen(st)), R.unwrap_ok[u32, str](f3r), F7_MULDIV, rd, rs1, rs2);
    ret R.ok_void[str]();
}

fun emit_ebreak(st: *encode.EncodeState) {
    emit_i(st, OPC_SYSTEM, F3_ADD, RZERO, RZERO, 1);
}

fun divide_width_is_word(st: *encode.EncodeState, width: u8) bool {
    ret width <= 4 && xlen(st) == 8;
}

fun divide_int_min(width: u8) i64 {
    if (width <= 4) { ret -2147483648; }
    ret -9223372036854775807 - 1;
}

fun min_check_length(st: *encode.EncodeState, width: u8) u32 {
    if (divide_width_is_word(st, width) || xlen(st) == 4) { ret 4; }
    ret 5;
}

fun emit_min_check(st: *encode.EncodeState, rs1: u32, t: u32, width: u8) {
    if (divide_width_is_word(st, width)) {
        emit_u(st, OPC_LUI, t, 0x80000);
        emit_r(st, OPC_OP_32, F3_ADD, F7_SUB, t, rs1, t);
    } or (xlen(st) == 4) {
        emit_u(st, OPC_LUI, t, 0x80000);
        emit_r(st, OPC_OP, F3_ADD, F7_SUB, t, rs1, t);
    } or {
        emit_i(st, OPC_OP_IMM, F3_ADD, t, RZERO, 1);
        emit_i(st, OPC_OP_IMM, F3_SLL, t, t, 63);
        emit_r(st, OPC_OP, F3_ADD, F7_SUB, t, rs1, t);
    }
    emit_b(st, OPC_BRANCH, F3_BNE, t, RZERO, 8);
    emit_ebreak(st);
}

fun emit_divide_guard(st: *encode.EncodeState, mi: *mir.MirInstr, rs1: u32, rs2: u32, signed: bool) {
    val w: u8 = mi.width;
    val den_imm: bool = mi.operands[2].kind == mir.MIR_OP_IMM;
    val num_imm: bool = mi.operands[1].kind == mir.MIR_OP_IMM;
    if (den_imm) {
        val d: i64 = imm_sext_for_width(mi.operands[2].imm, w);
        if (d == 0) { emit_ebreak(st); ret; }
        if (!signed || d != -1) { ret; }
        if (num_imm) {
            if (imm_sext_for_width(mi.operands[1].imm, w) == divide_int_min(w)) { emit_ebreak(st); }
            ret;
        }
        emit_min_check(st, rs1, SCRATCH2, w);
        ret;
    }

    val t: u32 = SCRATCH;
    if (divide_width_is_word(st, w)) {
        emit_i(st, OPC_OP_IMM_32, F3_ADD, t, rs2, 0);
        emit_b(st, OPC_BRANCH, F3_BNE, t, RZERO, 8);
    } or {
        emit_b(st, OPC_BRANCH, F3_BNE, rs2, RZERO, 8);
    }
    emit_ebreak(st);

    if (!signed) { ret; }
    emit_i(st, alu_imm_opcode(w, xlen(st)), F3_ADD, t, rs2, 1);
    emit_b(st, OPC_BRANCH, F3_BNE, t, RZERO, 4 * (min_check_length(st, w) + 1));
    emit_min_check(st, rs1, t, w);
}

fun encode_convert(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: conversion missing operands"); }
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rsr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH, mi.width);
    if (R.is_err[i32, str](rsr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rsr)); }
    val rs: u32 = R.unwrap_ok[i32, str](rsr)::u32;

    if (mi.opcode == mir.MIR_TRUNC) {
        emit_i(st, alu_imm_opcode(4, xlen(st)), F3_ADD, rd, rs, 0);
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_BITCAST) {
        if (dw >= xlen(st)) { emit_i(st, OPC_OP_IMM, F3_ADD, rd, rs, 0); }
        or                  { emit_i(st, alu_imm_opcode(4, xlen(st)), F3_ADD, rd, rs, 0); }
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_SEXT) {
        if (sw >= xlen(st)) { emit_i(st, OPC_OP_IMM, F3_ADD, rd, rs, 0); ret R.ok_void[str](); }
        if (sw == 4) { emit_i(st, alu_imm_opcode(4, xlen(st)), F3_ADD, rd, rs, 0); ret R.ok_void[str](); }
        val sh: u32 = (xlen(st)::u32 * 8) - (sw::u32 * 8);
        emit_i(st, OPC_OP_IMM, F3_SLL, rd, rs, sh);
        emit_i(st, OPC_OP_IMM, F3_SRL, rd, rd, sh | 0x400);
        ret R.ok_void[str]();
    }
    if (sw == 1) {
        emit_i(st, OPC_OP_IMM, F3_AND, rd, rs, 0xFF);
        ret R.ok_void[str]();
    }
    val sh: u32 = (xlen(st)::u32 * 8) - (sw::u32 * 8);
    emit_i(st, OPC_OP_IMM, F3_SLL, rd, rs, sh);
    emit_i(st, OPC_OP_IMM, F3_SRL, rd, rd, sh);
    ret R.ok_void[str]();
}

fun req_fpr(op: *mir.MirOperand) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_PREG) {
        if (isa.regid_class(op.preg::i32) != isa.REG_CLASS_ID_XMM) {
            ret R.err[i32, str]("internal compiler error: a general-purpose register reached a float operand position");
        }
        ret R.ok[i32, str](isa.regid_index(op.preg::i32));
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret R.err[i32, str]("encode: virtual register survived register allocation");
    }
    ret R.err[i32, str]("encode: expected a float register operand");
}

fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

fun reg_is_fp(op: *mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_PREG && isa.regid_class(op.preg::i32) == isa.REG_CLASS_ID_XMM;
}

fun fp_mem_funct3(width: u8, is_load: bool) R.Result[u32, str] {
    if (width == 4) { ret R.ok[u32, str](0x2); }
    if (width == 8) { ret R.ok[u32, str](0x3); }
    ret R.err[u32, str]("internal compiler error: riscv64 has no float memory access form for this width (expected 4 or 8)");
}

fun emit_fp_mem(st: *encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) R.Result[R.Void, str] {
    val f3r: R.Result[u32, str] = fp_mem_funct3(width, is_load);
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }
    val f3: u32 = R.unwrap_ok[u32, str](f3r);
    var b: u32 = base;
    var d: i64 = off;
    if (off < -2048 || off > 2047) {
        emit_li(st, SCRATCH2, off);
        emit_r(st, OPC_OP, F3_ADD, F7_ZERO, SCRATCH2, base, SCRATCH2);
        b = SCRATCH2;
        d = 0;
    }
    if (is_load) {
        emit_i(st, OPC_LOAD_FP, f3, rt, b, d::u32 & 0xFFF);
        ret R.ok_void[str]();
    }
    emit_s(st, OPC_STORE_FP, f3, b, rt, d::u32 & 0xFFF);
    ret R.ok_void[str]();
}

fun emit_fp_slot_store(st: *encode.EncodeState, f: *mir.MirFunction, memop: *mir.MirOperand, rt: u32, width: u8) R.Result[R.Void, str] {
    val mr: R.Result[RvMem, str] = resolve_mem(f, memop);
    if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
    val m: RvMem = R.unwrap_ok[RvMem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill destination not expected"); }
    ret emit_fp_mem(st, rt, m.base, m.off, width, false);
}

fun emit_fp_slot_load(st: *encode.EncodeState, f: *mir.MirFunction, memop: *mir.MirOperand, rt: u32, width: u8) R.Result[R.Void, str] {
    val mr: R.Result[RvMem, str] = resolve_mem(f, memop);
    if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
    val m: RvMem = R.unwrap_ok[RvMem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill source not expected"); }
    ret emit_fp_mem(st, rt, m.base, m.off, width, true);
}

fun is_fp_slot(f: *mir.MirFunction, op: *mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL && mir.vreg_is_fp(f, op.vreg);
}

fun fmv_i2f_funct7(width: u8) u32 {
    if (width == 4) { ret F7_FMV_I2F; }
    ret F7_FMV_I2F | 1;
}

fun fmv_f2i_funct7(width: u8) u32 {
    if (width == 4) { ret F7_FMV_F2I; }
    ret F7_FMV_F2I | 1;
}

fun li_words(value: i64) u32 {
    if (value >= -2048 && value <= 2047) { ret 1; }
    if (value >= -2147483648 && value <= 2147483647) {
        val v: i32 = value::i32;
        if ((v::u32 & 0xFFF) == 0) { ret 1; }
        ret 2;
    }
    val lo12: i64 = sext12(value);
    var n: u32 = li_words((value - lo12) >> 12) + 1;
    if (lo12 != 0) { n = n + 1; }
    ret n;
}

fun emit_fp_const(st: *encode.EncodeState, vd: u32, bits: i64, width: u8) R.Result[R.Void, str] {
    var pattern: i64 = bits;
    if (width == 4) { pattern = bits & 0xFFFFFFFF; }

    if (pattern == 0) {
        emit_r(st, OPC_OP_FP, RM_RNE, fmv_i2f_funct7(width), vd, RZERO, 0);
        ret R.ok_void[str]();
    }
    if (li_words(pattern) <= 1) {
        emit_li(st, SCRATCH, pattern);
        emit_r(st, OPC_OP_FP, RM_RNE, fmv_i2f_funct7(width), vd, SCRATCH, 0);
        ret R.ok_void[str]();
    }

    val sr: R.Result[intern.StrId, str] = encode.intern_float_const(st, pattern::u64, width);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);

    val f3r: R.Result[u32, str] = fp_mem_funct3(width, true);
    if (R.is_err[u32, str](f3r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f3r)); }
    val hr: R.Result[R.Void, str] = emit_pcrel_hi(st, SCRATCH, sym, 0);
    if (R.is_err[R.Void, str](hr)) { ret hr; }
    val lo_pos: u32 = st.buf.len::u32;
    emit_i(st, OPC_LOAD_FP, R.unwrap_ok[u32, str](f3r), vd, SCRATCH, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, lo_pos, of.RK_PCREL_LO12_I, sym);
}

fun resolve_fp_source(st: *encode.EncodeState, f: *mir.MirFunction, op: *mir.MirOperand, scratch: u32, width: u8) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_MEM) {
        val mr: R.Result[RvMem, str] = resolve_mem(f, op);
        if (R.is_err[RvMem, str](mr)) { ret R.err[i32, str](R.unwrap_err[RvMem, str](mr)); }
        val m: RvMem = R.unwrap_ok[RvMem, str](mr);
        if (m.has_index) { ret R.err[i32, str]("encode: indexed float spill operand not expected"); }
        val lr: R.Result[R.Void, str] = emit_fp_mem(st, scratch, m.base, m.off, width, true);
        if (R.is_err[R.Void, str](lr)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](lr)); }
        ret R.ok[i32, str](scratch::i32);
    }
    if (op.kind == mir.MIR_OP_IMM) {
        val cr: R.Result[R.Void, str] = emit_fp_const(st, scratch, op.imm, width);
        if (R.is_err[R.Void, str](cr)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](cr)); }
        ret R.ok[i32, str](scratch::i32);
    }
    ret req_fpr(op);
}

fun fp_arith_funct7(op: mir.MirOpcode, dbl: bool) R.Result[u32, str] {
    var base: u32 = F7_FADD;
    if (op == mir.MIR_FADD)      { base = F7_FADD; }
    or (op == mir.MIR_FSUB)      { base = F7_FSUB; }
    or (op == mir.MIR_FMUL)      { base = F7_FMUL; }
    or (op == mir.MIR_FDIV)      { base = F7_FDIV; }
    or {
        ret R.err[u32, str]("encode: riscv64 has no float arithmetic form for this opcode");
    }
    if (dbl) { ret R.ok[u32, str](base | 1); }
    ret R.ok[u32, str](base);
}

fun is_mir_float_arith(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FADD || op == mir.MIR_FSUB ||
        op == mir.MIR_FMUL || op == mir.MIR_FDIV;
}

fun is_mir_float_conv(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT ||
        op == mir.MIR_FP_TO_SI || op == mir.MIR_FP_TO_UI ||
        op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP;
}

fun encode_fp_arith(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: float arithmetic missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float arithmetic has a non-float operand width (expected 4 or 8)");
    }
    val dbl: bool = w == 8;

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH, w);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH2, w);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val f7r: R.Result[u32, str] = fp_arith_funct7(mi.opcode, dbl);
    if (R.is_err[u32, str](f7r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](f7r)); }
    val f7: u32 = R.unwrap_ok[u32, str](f7r);
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind == mir.MIR_OP_MEM) {
        emit_r(st, OPC_OP_FP, RM_DYN, f7, FP_SCRATCH, rn, rm);
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, w);
    }
    val rdr: R.Result[i32, str] = req_fpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    emit_r(st, OPC_OP_FP, RM_DYN, f7, R.unwrap_ok[i32, str](rdr)::u32, rn, rm);
    ret R.ok_void[str]();
}

fun encode_fp_neg(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: float negate missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float negate has a non-float operand width (expected 4 or 8)");
    }
    var f7: u32 = F7_FSGNJ;
    if (w == 8) { f7 = F7_FSGNJ | 1; }

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH, w);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind == mir.MIR_OP_MEM) {
        emit_r(st, OPC_OP_FP, F3_FLT, f7, FP_SCRATCH, rn, rn);
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, w);
    }
    val rdr: R.Result[i32, str] = req_fpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    emit_r(st, OPC_OP_FP, F3_FLT, f7, R.unwrap_ok[i32, str](rdr)::u32, rn, rn);
    ret R.ok_void[str]();
}

fun fp_cmp_relation(cc: u8, out_funct3: *u32, out_swap: *bool, out_invert: *bool) R.Result[R.Void, str] {
    @out_swap   = false;
    @out_invert = false;
    @out_funct3 = F3_FEQ;
    if (cc == mir.FCC_EQ) { @out_funct3 = F3_FEQ; ret R.ok_void[str](); }
    if (cc == mir.FCC_NE) { @out_funct3 = F3_FEQ; @out_invert = true; ret R.ok_void[str](); }
    if (cc == mir.FCC_LT) { @out_funct3 = F3_FLT; ret R.ok_void[str](); }
    if (cc == mir.FCC_LE) { @out_funct3 = F3_FLE; ret R.ok_void[str](); }
    if (cc == mir.FCC_GT) { @out_funct3 = F3_FLT; @out_swap = true; ret R.ok_void[str](); }
    if (cc == mir.FCC_GE) { @out_funct3 = F3_FLE; @out_swap = true; ret R.ok_void[str](); }
    ret R.err[R.Void, str]("encode: riscv64 has no float comparison form for this condition code");
}

fun encode_fp_cmp(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: float comparison missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float comparison has a non-float operand width (expected 4 or 8)");
    }
    var f7: u32 = F7_FCMP;
    if (w == 8) { f7 = F7_FCMP | 1; }

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH, w);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH2, w);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    var funct3: u32 = F3_FEQ;
    var swap:   bool = false;
    var invert: bool = false;
    val rel: R.Result[R.Void, str] = fp_cmp_relation(mi.src_width, ?funct3, ?swap, ?invert);
    if (R.is_err[R.Void, str](rel)) { ret rel; }

    var a: u32 = rn;
    var b: u32 = rm;
    if (swap) { a = rm; b = rn; }
    emit_r(st, OPC_OP_FP, funct3, f7, rd, a, b);
    if (invert) { emit_i(st, OPC_OP_IMM, F3_XOR, rd, rd, 1); }
    ret R.ok_void[str]();
}

fun int_to_fp_rm(dbl: bool, src_is_word: bool) u32 {
    if (dbl && src_is_word) { ret RM_RNE; }
    ret RM_DYN;
}

fun encode_fp_conv(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: float conversion missing operands"); }
    val op: mir.MirOpcode = mi.opcode;
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    if (op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT) {
        if (!is_float_width(dw) || !is_float_width(sw)) {
            ret R.err[R.Void, str]("internal compiler error: float conversion has a non-float width on a float side (expected 4 or 8)");
        }
        val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH, sw);
        if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
        val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
        var f7: u32 = F7_FCVT_F2F;
        var rs2: u32 = FMT_D;
        var rm: u32 = RM_DYN;
        if (op == mir.MIR_FP_EXT) {
            f7  = F7_FCVT_F2F | 1;
            rs2 = FMT_S;
            rm  = RM_RNE;
        }
        val dst: *mir.MirOperand = ?mi.operands[0];
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_r(st, OPC_OP_FP, rm, f7, FP_SCRATCH, rn, rs2);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, dw);
        }
        val rdr: R.Result[i32, str] = req_fpr(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        emit_r(st, OPC_OP_FP, rm, f7, R.unwrap_ok[i32, str](rdr)::u32, rn, rs2);
        ret R.ok_void[str]();
    }

    if (op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP) {
        if (!is_float_width(dw)) {
            ret R.err[R.Void, str]("internal compiler error: integer-to-float conversion has a non-float result width (expected 4 or 8)");
        }
        val signed: bool = op == mir.MIR_SI_TO_FP;
        val gpr: R.Result[i32, str] = req_gpr(?mi.operands[1]);
        if (R.is_err[i32, str](gpr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](gpr)); }
        var gp: u32 = R.unwrap_ok[i32, str](gpr)::u32;
        var src_word: bool = sw <= 4;
        if (sw < 4) {
            val shamt: u32 = (xlen(st)::u32 * 8) - (sw::u32 * 8);
            if (signed) {
                emit_i(st, OPC_OP_IMM, F3_SLL, SCRATCH, gp, shamt);
                emit_i(st, OPC_OP_IMM, F3_SRL, SCRATCH, SCRATCH, shamt | 0x400);
            } or (sw == 1) {
                emit_i(st, OPC_OP_IMM, F3_AND, SCRATCH, gp, 0xFF);
            } or {
                emit_i(st, OPC_OP_IMM, F3_SLL, SCRATCH, gp, shamt);
                emit_i(st, OPC_OP_IMM, F3_SRL, SCRATCH, SCRATCH, shamt);
            }
            gp = SCRATCH;
            src_word = true;
        }
        if (!src_word && xlen(st) == 4) {
            ret R.err[R.Void, str]("internal compiler error: a 64-bit integer reached the rv32 int-to-float encoder unlegalized (fcvt.s.l / fcvt.d.l are RV64-only)");
        }
        val dbl: bool = dw == 8;
        var f7: u32 = F7_FCVT_I2F;
        if (dbl) { f7 = F7_FCVT_I2F | 1; }
        var rs2: u32 = FCVT_L;
        if (src_word && signed)     { rs2 = FCVT_W; }
        or (src_word && !signed)    { rs2 = FCVT_WU; }
        or (!src_word && !signed)   { rs2 = FCVT_LU; }
        val rm: u32 = int_to_fp_rm(dbl, src_word);
        val dst: *mir.MirOperand = ?mi.operands[0];
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_r(st, OPC_OP_FP, rm, f7, FP_SCRATCH, gp, rs2);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, dw);
        }
        val rdr: R.Result[i32, str] = req_fpr(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        emit_r(st, OPC_OP_FP, rm, f7, R.unwrap_ok[i32, str](rdr)::u32, gp, rs2);
        ret R.ok_void[str]();
    }

    if (!is_float_width(sw)) {
        ret R.err[R.Void, str]("internal compiler error: float-to-integer conversion has a non-float source width (expected 4 or 8)");
    }
    val signed: bool = op == mir.MIR_FP_TO_SI;
    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH, sw);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    if (dw > 4 && xlen(st) == 4) {
        ret R.err[R.Void, str]("internal compiler error: a 64-bit integer destination reached the rv32 float-to-int encoder unlegalized (fcvt.l.s / fcvt.l.d are RV64-only)");
    }
    var f7: u32 = F7_FCVT_F2I;
    if (sw == 8) { f7 = F7_FCVT_F2I | 1; }
    var rs2: u32 = FCVT_L;
    if (dw <= 4 && signed)   { rs2 = FCVT_W; }
    or (dw <= 4 && !signed)  { rs2 = FCVT_WU; }
    or (dw > 4 && !signed)   { rs2 = FCVT_LU; }
    emit_r(st, OPC_OP_FP, RM_RTZ, f7, rd, rn, rs2);
    ret R.ok_void[str]();
}

fun encode_fmov(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: fmov missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float move has a non-float operand width (expected 4 or 8)");
    }
    val dbl: bool = w == 8;
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (src.kind == mir.MIR_OP_IMM) {
        if (dst.kind == mir.MIR_OP_MEM) {
            val cr: R.Result[R.Void, str] = emit_fp_const(st, FP_SCRATCH, src.imm, w);
            if (R.is_err[R.Void, str](cr)) { ret cr; }
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, w);
        }
        val rdr: R.Result[i32, str] = req_fpr(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        ret emit_fp_const(st, R.unwrap_ok[i32, str](rdr)::u32, src.imm, w);
    }

    if (dst.kind != mir.MIR_OP_MEM && src.kind != mir.MIR_OP_MEM) {
        val dfp: bool = reg_is_fp(dst);
        val sfp: bool = reg_is_fp(src);
        if (dfp && sfp) {
            val rdr: R.Result[i32, str] = req_fpr(dst);
            if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
            val rnr: R.Result[i32, str] = req_fpr(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            var f7: u32 = F7_FSGNJ;
            if (dbl) { f7 = F7_FSGNJ | 1; }
            val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
            emit_r(st, OPC_OP_FP, F3_FLE, f7, R.unwrap_ok[i32, str](rdr)::u32, rn, rn);
            ret R.ok_void[str]();
        }
        if ((dfp || sfp) && w == 8 && xlen(st) == 4) {
            ret R.err[R.Void, str]("encode: rv32 has no cross-bank move for a 64-bit value (fmv.d.x / fmv.x.d are RV64-only); see briar-systems/mach#2860");
        }
        if (dfp) {
            val rdr: R.Result[i32, str] = req_fpr(dst);
            if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
            val rnr: R.Result[i32, str] = req_gpr(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            emit_r(st, OPC_OP_FP, RM_RNE, fmv_i2f_funct7(w), R.unwrap_ok[i32, str](rdr)::u32, R.unwrap_ok[i32, str](rnr)::u32, 0);
            ret R.ok_void[str]();
        }
        if (sfp) {
            val rdr: R.Result[i32, str] = req_gpr(dst);
            if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
            val rnr: R.Result[i32, str] = req_fpr(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            emit_r(st, OPC_OP_FP, RM_RNE, fmv_f2i_funct7(w), R.unwrap_ok[i32, str](rdr)::u32, R.unwrap_ok[i32, str](rnr)::u32, 0);
            ret R.ok_void[str]();
        }
        ret R.err[R.Void, str]("encode: fmov names two general-purpose registers");
    }

    if (dst.kind == mir.MIR_OP_MEM) {
        if (src.kind == mir.MIR_OP_MEM) {
            val mr: R.Result[RvMem, str] = resolve_mem(f, src);
            if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
            val m: RvMem = R.unwrap_ok[RvMem, str](mr);
            if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill operand not expected"); }
            val lr: R.Result[R.Void, str] = emit_fp_mem(st, FP_SCRATCH, m.base, m.off, w, true);
            if (R.is_err[R.Void, str](lr)) { ret lr; }
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH, w);
        }
        if (reg_is_fp(src)) {
            val rnr: R.Result[i32, str] = req_fpr(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            ret emit_fp_slot_store(st, f, dst, R.unwrap_ok[i32, str](rnr)::u32, w);
        }
        ret emit_store_mem(st, f, dst, src, w);
    }

    if (reg_is_fp(dst)) {
        val rdr: R.Result[i32, str] = req_fpr(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        val mr: R.Result[RvMem, str] = resolve_mem(f, src);
        if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
        val m: RvMem = R.unwrap_ok[RvMem, str](mr);
        if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill operand not expected"); }
        ret emit_fp_mem(st, R.unwrap_ok[i32, str](rdr)::u32, m.base, m.off, w, true);
    }
    val rdr: R.Result[i32, str] = req_gpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val mr: R.Result[RvMem, str] = resolve_mem(f, src);
    if (R.is_err[RvMem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[RvMem, str](mr)); }
    val m: RvMem = R.unwrap_ok[RvMem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill operand not expected"); }
    ret emit_mem_access(st, R.unwrap_ok[i32, str](rdr)::u32, m.base, m.off, w, true);
}

fun popcount32(m: u32) u32 {
    var n: u32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    ret n;
}

fun align16(n: u32) u32 {
    ret (n + 15) & ~15::u32;
}

pub fun frame_total(st: *encode.EncodeState, f: *mir.MirFunction) u32 {
    val reserved: u32 = frame_reserved_top(st, f)::u32;
    val n: u32 = align16(reserved + f.frame.size + f.frame.outgoing_size);
    if (f.frame.realign != 0) {
        val rmask: u32 = f.frame.realign - 1;
        ret (n + rmask) & ~rmask;
    }
    ret n;
}

fun emit_sp_adjust(st: *encode.EncodeState, delta: u32, subtract: bool) {
    var signed: i64 = delta::i64;
    if (subtract) { signed = 0 - signed; }
    if (signed >= -2048 && signed <= 2047) {
        emit_i(st, OPC_OP_IMM, F3_ADD, RSP, RSP, signed::u32 & 0xFFF);
        ret;
    }
    emit_li(st, SCRATCH, delta::i64);
    if (subtract) { emit_r(st, OPC_OP, F3_ADD, F7_SUB, RSP, RSP, SCRATCH); }
    or            { emit_r(st, OPC_OP, F3_ADD, F7_ZERO, RSP, RSP, SCRATCH); }
}

fun save_callee_gp(st: *encode.EncodeState, f: *mir.MirFunction, total: u32, store: bool) {
    val w: u8 = xlen(st);
    val rec: i64 = (2 * w::i64);
    var n: u32 = 0;
    var r: u32 = 0;
    for (r < 32) {
        if ((f.callee_mask & (1::u32 << r)) != 0) {
            val off: i64 = (total::i64) - rec - w::i64 - (w::i64 * n::i64);
            emit_mem_access(st, r, RSP, off, w, !store);
            n = n + 1;
        }
        r = r + 1;
    }
}

fun save_callee_fp(st: *encode.EncodeState, f: *mir.MirFunction, total: u32, store: bool) {
    val xw: u8 = xlen(st);
    val fw: u8 = flen(st);
    val rec: i64 = (2 * xw::i64);
    val gp_bytes: i64 = (popcount32(f.callee_mask)::i64 * xw::i64);
    var n: u32 = 0;
    var r: u32 = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) {
            val off: i64 = (total::i64) - rec - gp_bytes - fw::i64 - (fw::i64 * n::i64);
            emit_fp_mem(st, r, RSP, off, fw, !store);
            n = n + 1;
        }
        r = r + 1;
    }
}

fun emit_prologue(st: *encode.EncodeState, f: *mir.MirFunction, total: u32) {
    if (f.frame.realign != 0) {
        emit_mem_access(st, RRA, RSP, 0 - xlen(st)::i64, xlen(st), false);
        emit_mem_access(st, RFP, RSP, 0 - (2 * xlen(st)::i64), xlen(st), false);
        emit_addi(st, RFP, RSP, 0);
        emit_sp_realign(st, f.frame.realign);
        emit_sp_adjust(st, total, true);
        save_callee_gp(st, f, total, true);
        save_callee_fp(st, f, total, true);
        ret;
    }
    emit_sp_adjust(st, total, true);
    emit_mem_access(st, RRA, RSP, (total::i64) - xlen(st)::i64, xlen(st), false);
    emit_mem_access(st, RFP, RSP, (total::i64) - (2 * xlen(st)::i64), xlen(st), false);
    emit_addi(st, RFP, RSP, total::i64);
    save_callee_gp(st, f, total, true);
    save_callee_fp(st, f, total, true);
}

fun emit_sp_realign(st: *encode.EncodeState, realign: u32) {
    if (realign == 0) { ret; }
    val m: i64 = 0 - realign::i64;
    if (m >= -2048) {
        emit_i(st, OPC_OP_IMM, F3_AND, RSP, RSP, m::u32 & 0xFFF);
        ret;
    }
    emit_li(st, SCRATCH, m);
    emit_r(st, OPC_OP, F3_AND, F7_ZERO, RSP, RSP, SCRATCH);
}

fun emit_epilogue(st: *encode.EncodeState, f: *mir.MirFunction, total: u32) {
    save_callee_gp(st, f, total, false);
    save_callee_fp(st, f, total, false);
    if (f.frame.realign != 0) {
        emit_addi(st, RSP, RFP, 0);
        emit_mem_access(st, RRA, RSP, 0 - xlen(st)::i64, xlen(st), true);
        emit_mem_access(st, RFP, RSP, 0 - (2 * xlen(st)::i64), xlen(st), true);
        ret;
    }
    emit_mem_access(st, RRA, RSP, (total::i64) - xlen(st)::i64, xlen(st), true);
    emit_mem_access(st, RFP, RSP, (total::i64) - (2 * xlen(st)::i64), xlen(st), true);
    emit_sp_adjust(st, total, false);
}

fun encode_mir_instr(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    val op: u16 = mi.opcode::u16;

    val rv_vb: R.Result[R.Void, str] = encode.emit_var_bindings(st, f, mi);
    if (R.is_err[R.Void, str](rv_vb)) { ret rv_vb; }

    if (op == isa.ISA_PCOPY || op == isa.ISA_PCOPY_FENCE ||
        op == isa.ISA_USE || op == isa.ISA_LABEL) {
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_CALL_RES || mi.opcode == mir.MIR_ARG) {
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_PHI) {
        ret R.err[R.Void, str]("internal compiler error: phi survived register allocation");
    }

    if (is_mir_compare(mi.opcode))    { ret encode_compare(st, mi); }
    if (mi.opcode == mir.MIR_SEL_CBR) { ret encode_cbr(st, fn_base, mi); }

    if (mir.is_fused_cbr(mi.opcode)) { ret encode_fused_cbr(st, fn_base, mi); }

    if (is_mir_divide(mi.opcode)) { ret encode_divide(st, mi); }

    if (mi.opcode == mir.MIR_MOV) {
        if (reg_is_fp(?mi.operands[0]) || reg_is_fp(?mi.operands[1])) { ret encode_fmov(st, f, mi); }
        ret encode_mov(st, f, mi);
    }

    if (mi.opcode == mir.MIR_ALLOCA || mi.opcode == mir.MIR_GEP) { ret encode_addr(st, f, mi); }
    if (mi.opcode == mir.MIR_LOAD)                               { ret encode_load(st, f, mi); }
    if (mi.opcode == mir.MIR_STORE)                              { ret encode_store(st, f, mi); }

    if (mi.opcode == mir.MIR_TRUNC || mi.opcode == mir.MIR_SEXT ||
        mi.opcode == mir.MIR_ZEXT || mi.opcode == mir.MIR_BITCAST) {
        ret encode_convert(st, mi);
    }

    if (is_mir_float_arith(mi.opcode)) { ret encode_fp_arith(st, f, mi); }
    if (mi.opcode == mir.MIR_FNEG)     { ret encode_fp_neg(st, f, mi); }
    if (mi.opcode == mir.MIR_FCMP)     { ret encode_fp_cmp(st, f, mi); }

    if (is_mir_float_conv(mi.opcode)) { ret encode_fp_conv(st, f, mi); }

    if (mi.opcode == mir.MIR_CALL) { ret encode_call(st, mi); }

    if (mi.opcode == mir.MIR_ASM) { ret encode_asm_block_riscv64(st, f, fn_base, mi); }

    if (op == riscv.ADD::u16)    { ret encode_addsub(st, mi, false); }
    if (op == riscv.SUB::u16)    { ret encode_addsub(st, mi, true); }
    if (op == riscv.MUL::u16)    { ret encode_alu3(st, mi, F3_ADD, F7_MULDIV, true); }
    if (op == riscv.MULHU::u16)  { ret encode_alu3(st, mi, F3_SLTU, F7_MULDIV, false); }
    if (op == riscv.AND::u16)    { ret encode_alu3(st, mi, F3_AND, F7_ZERO, false); }
    if (op == riscv.OR::u16)     { ret encode_alu3(st, mi, F3_OR, F7_ZERO, false); }
    if (op == riscv.XOR::u16)    { ret encode_alu3(st, mi, F3_XOR, F7_ZERO, false); }
    if (op == riscv.SLL::u16)    { ret encode_shift(st, mi, F3_SLL, false); }
    if (op == riscv.SRL::u16)    { ret encode_shift(st, mi, F3_SRL, false); }
    if (op == riscv.SRA::u16)    { ret encode_shift(st, mi, F3_SRL, true); }
    if (op == riscv.NEG::u16)    { ret encode_neg(st, mi); }
    if (op == riscv.NOT::u16)    { ret encode_not(st, mi); }
    if (op == riscv.MOV::u16)    { ret encode_mov(st, f, mi); }
    if (op == riscv.FMV::u16)    { ret encode_fmov(st, f, mi); }
    if (op == riscv.JMP::u16)    { ret encode_branch(st, fn_base, mi); }
    if (op == riscv.RET::u16)    { emit_i(st, OPC_JALR, F3_ADD, RZERO, RRA, 0); ret R.ok_void[str](); }
    if (op == riscv.NOP::u16)    { emit_i(st, OPC_OP_IMM, F3_ADD, RZERO, RZERO, 0); ret R.ok_void[str](); }
    if (op == riscv.EBREAK::u16) { emit_i(st, OPC_SYSTEM, F3_ADD, RZERO, RZERO, 1); ret R.ok_void[str](); }

    ret R.err[R.Void, str]("encode: unhandled opcode in riscv64 encode");
}

val B_DISP_MIN: i64 = -4096;
val B_DISP_MAX: i64 = 4094;
val J_DISP_MIN: i64 = -1048576;
val J_DISP_MAX: i64 = 1048574;

fun set_branch_disp(buf: *encode.ByteBuf, pos: usize, disp: u32) {
    val word: u32 = read_word(buf, pos);
    write_word(buf, pos, (word & 0x01FFF07F) | b_imm(disp));
}

fun write_inverted_guard(buf: *encode.ByteBuf, pos: usize, bne_word: u32, disp: u32) {
    val funct3: u32 = ((bne_word >> 12) & 0x7) ^ 0x1;
    val rs1: u32 = (bne_word >> 15) & 0x1F;
    val rs2: u32 = (bne_word >> 20) & 0x1F;
    write_word(buf, pos, pack_b(OPC_BRANCH, funct3, rs1, rs2, disp));
}

fun invert_branch(op: inst.MachOp) inst.MachOp {
    if (op == inst.BEQ)  { ret inst.BNE; }
    if (op == inst.BNE)  { ret inst.BEQ; }
    if (op == inst.BLT)  { ret inst.BGE; }
    if (op == inst.BGE)  { ret inst.BLT; }
    if (op == inst.BLTU) { ret inst.BGEU; }
    if (op == inst.BGEU) { ret inst.BLTU; }
    ret inst.MOP_NONE;
}

fun renote_relaxed_branch(st: *encode.EncodeState, guard_pos: u32, jal_pos: u32, target_block: u32) R.Result[R.Void, str] {
    if (!encode.sink_active(?st.buf)) { ret R.ok_void[str](); }
    val idx: i32 = encode.note_index_at(?st.buf, guard_pos);
    if (idx < 0) {
        ret R.err[R.Void, str]("--emit-asm: riscv64 branch relaxation found no notification for the branch it widened");
    }
    val guard: *encode.AsmNote = encode.note_at(?st.buf, idx::u32);
    val inverted: inst.MachOp = invert_branch(guard.inst.opcode::inst.MachOp);
    if (inverted == inst.MOP_NONE) {
        ret R.err[R.Void, str]("--emit-asm: riscv64 branch relaxation widened an instruction that is not a conditional branch");
    }

    var jump: encode.AsmNote = encode.note_blank();
    jump.off  = jal_pos;
    jump.inst = build_inst(inst.JAL, RZERO, 0, 0, 0);
    jump.inst.src1 = isa.make_block_label(target_block);

    guard.inst.opcode = inverted::u16;
    guard.inst.src2   = isa.make_block_label(0);
    guard.inst.src2.imm = 8;
    guard.inst.flags  = guard.inst.flags | inst.FLAG_LABEL_SKIP;

    ret encode.note_insert_after(?st.buf, idx::u32, ?jump, WORD_SIZE);
}

fun renote_trampoline(st: *encode.EncodeState, auipc_pos: u32, jalr_pos: u32, target_block: u32) R.Result[R.Void, str] {
    if (!encode.sink_active(?st.buf)) { ret R.ok_void[str](); }
    val idx: i32 = encode.note_index_at(?st.buf, auipc_pos);
    if (idx < 0) {
        ret R.err[R.Void, str]("--emit-asm: riscv64 branch relaxation found no notification for the jump it widened");
    }
    val hi: *encode.AsmNote = encode.note_at(?st.buf, idx::u32);
    hi.inst = build_inst(inst.AUIPC, SCRATCH, 0, 0, 0);
    hi.inst.src1 = isa.make_block_label(target_block);
    hi.inst.src1.sym_mod = isa.SYM_MOD_PCREL_HI;

    var lo: encode.AsmNote = encode.note_blank();
    lo.off  = jalr_pos;
    lo.inst = build_inst(inst.JALR, RZERO, SCRATCH, 0, 0);
    lo.inst.src1.sym_mod = isa.SYM_MOD_PCREL_LO;
    lo.inst.src1.imm     = target_block::i64;
    lo.inst.flags        = inst.FLAG_TARGET_BLOCK;

    ret encode.note_insert_after(?st.buf, idx::u32, ?lo, WORD_SIZE);
}

fun renote_guard_skip(st: *encode.EncodeState, guard_pos: u32, disp: i64) R.Result[R.Void, str] {
    if (!encode.sink_active(?st.buf)) { ret R.ok_void[str](); }
    val idx: i32 = encode.note_index_at(?st.buf, guard_pos);
    if (idx < 0) {
        ret R.err[R.Void, str]("--emit-asm: riscv64 branch relaxation found no notification for the guard it widened");
    }
    val guard: *encode.AsmNote = encode.note_at(?st.buf, idx::u32);
    guard.inst.src2.imm = disp;
    ret R.ok_void[str]();
}

fun relax_function_riscv64(st: *encode.EncodeState, fn_base: u32, fixup_start: u32) R.Result[R.Void, str] {
    ret relax_function_bounded(st, fn_base, fixup_start,
                               relax_round_bound(st.fixup_count - fixup_start));
}

fun relax_round_bound(count: u32) u64 {
    ret 2 * count::u64 + 1;
}

fun relax_bound_message(st: *encode.EncodeState, rounds: u64) str {
    val r: R.Result[str, str] = format.sprint(st.alloc,
        "encode: riscv branch relaxation did not settle within its {}-round bound; each branch widens at most twice, so exceeding the bound means a widening made no progress",
        rounds);
    if (R.is_err[str, str](r)) { ret RELAX_BOUND_GENERIC; }
    ret R.unwrap_ok[str, str](r);
}

val RELAX_BOUND_GENERIC: str = "encode: riscv branch relaxation did not settle within its proven round bound";

fun relax_function_bounded(st: *encode.EncodeState, fn_base: u32, fixup_start: u32,
                           max_rounds: u64) R.Result[R.Void, str] {
    val count: u32 = st.fixup_count - fixup_start;
    if (count == 0) { ret R.ok_void[str](); }

    val res_marks: R.Result[*u8, str] = A.allocate[u8](st.alloc, count::usize);
    if (R.is_err[*u8, str](res_marks)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](res_marks)); }
    val relaxed: *u8 = R.unwrap_ok[*u8, str](res_marks);
    fin { A.deallocate[u8](st.alloc, relaxed, count::usize); }
    var z: u32 = 0;
    for (z < count) { relaxed[z] = 0; z = z + 1; }

    var rounds: u64 = 0;
    var changed: bool = true;
    for (changed) {
        if (rounds >= max_rounds) {
            ret R.err[R.Void, str](relax_bound_message(st, max_rounds));
        }
        rounds = rounds + 1;
        changed = false;
        var i: u32 = fixup_start;
        for (i < st.fixup_count) {
            val fx: *encode.BranchFixup = ?st.fixups[i];
            val res_off: R.Result[u32, str] = encode.block_offset(st, fn_base, fx.target_block);
            if (R.is_err[u32, str](res_off)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](res_off)); }
            val target_off: u32 = R.unwrap_ok[u32, str](res_off);
            val word: u32 = read_word(?st.buf, fx.patch_pos::usize);
            val opcode: u32 = word & 0x7F;
            val sdisp: i64 = (target_off::i64) - (fx.patch_pos::i64);

            if (opcode == OPC_BRANCH && (sdisp < B_DISP_MIN || sdisp > B_DISP_MAX)) {
                val guard_pos: u32 = fx.patch_pos;
                val jal_pos: u32 = fx.patch_pos + 4;
                val ins: R.Result[R.Void, str] = encode.insert_text(st, jal_pos, 4);
                if (R.is_err[R.Void, str](ins)) { ret ins; }
                write_inverted_guard(?st.buf, guard_pos::usize, word, 8);
                write_word(?st.buf, jal_pos::usize, pack_j(OPC_JAL, RZERO, 0));
                val rn: R.Result[R.Void, str] = renote_relaxed_branch(st, guard_pos, jal_pos, fx.target_block);
                if (R.is_err[R.Void, str](rn)) { ret rn; }
                fx.patch_pos = jal_pos;
                fx.next_ip   = jal_pos + 4;
                relaxed[i - fixup_start] = 1;
                changed = true;
                brk;
            }
            if (opcode == OPC_JAL && (sdisp < J_DISP_MIN || sdisp > J_DISP_MAX)) {
                val auipc_pos: u32 = fx.patch_pos;
                val jalr_pos: u32 = fx.patch_pos + 4;
                val ins: R.Result[R.Void, str] = encode.insert_text(st, jalr_pos, 4);
                if (R.is_err[R.Void, str](ins)) { ret ins; }
                write_word(?st.buf, auipc_pos::usize, pack_u(OPC_AUIPC, SCRATCH, 0));
                write_word(?st.buf, jalr_pos::usize, pack_i(OPC_JALR, F3_ADD, RZERO, SCRATCH, 0));
                val rn: R.Result[R.Void, str] = renote_trampoline(st, auipc_pos, jalr_pos, fx.target_block);
                if (R.is_err[R.Void, str](rn)) { ret rn; }
                fx.next_ip = auipc_pos + 8;
                if (relaxed[i - fixup_start] != 0) {
                    val guard_pos: u32 = auipc_pos - 4;
                    set_branch_disp(?st.buf, guard_pos::usize, fx.next_ip - guard_pos);
                    val rg: R.Result[R.Void, str] = renote_guard_skip(st, guard_pos, (fx.next_ip - guard_pos)::i64);
                    if (R.is_err[R.Void, str](rg)) { ret rg; }
                }
                changed = true;
                brk;
            }
            i = i + 1;
        }
    }
    ret R.ok_void[str]();
}

fun encode_function_riscv64(st: *encode.EncodeState, f: *mir.MirFunction) R.Result[R.Void, str] {
    if (f.block_count == 0) { ret R.ok_void[str](); }
    if (!encode.sink_active(?st.buf)) { ret encode_function_body(st, f); }

    var head: encode.AsmNote = encode.note_blank();
    head.kind = encode.ASM_NOTE_FUNC;
    head.off  = st.buf.len::u32;
    head.name = f.name;
    val rh: R.Result[R.Void, str] = encode.note_push(?st.buf, ?head);
    if (R.is_err[R.Void, str](rh)) { ret rh; }

    val res: R.Result[R.Void, str] = encode_function_body(st, f);
    if (R.is_err[R.Void, str](res)) {
        encode.notes_reset(?st.buf);
        ret res;
    }
    val rr: R.Result[R.Void, str] = printer.render_notes(?st.buf);
    encode.notes_reset(?st.buf);
    ret rr;
}

fun encode_function_body(st: *encode.EncodeState, f: *mir.MirFunction) R.Result[R.Void, str] {
    val fn_base: u32 = st.buf.len::u32;
    val fixup_start: u32 = st.fixup_count;

    val ms: R.Result[R.Void, str] = encode.push_symbol(st, f.name, fn_base, of.SYM_OBJ_FLAG_FUNCTION);
    if (R.is_err[R.Void, str](ms)) { ret ms; }

    val naked: bool = f.frame.omit;
    val total: u32 = f.frame.base_dist + f.frame.fp_dist;
    if (!naked) { emit_prologue(st, f, total); }
    val rp: R.Result[R.Void, str] = check_accounted(st, fn_base, PROLOGUE_REGION);
    if (R.is_err[R.Void, str](rp)) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        val rb: R.Result[R.Void, str] = encode.push_block(st, fn_base, blk.id, st.buf.len::u32);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        encode.set_fallthrough(st, f, bi);

        if (encode.sink_active(?st.buf)) {
            var label: encode.AsmNote = encode.note_blank();
            label.kind = encode.ASM_NOTE_BLOCK;
            label.off  = st.buf.len::u32;
            label.id   = blk.id;
            val rl: R.Result[R.Void, str] = encode.note_push(?st.buf, ?label);
            if (R.is_err[R.Void, str](rl)) { ret rl; }
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (!mir.emits_instr(f, mi)) { ii = ii + 1; cnt; }
            val rr: R.Result[R.Void, str] = encode.push_row(st, st.buf.len::u32, mi.loc);
            if (R.is_err[R.Void, str](rr)) { ret rr; }
            val rip: R.Result[R.Void, str] = encode.push_inline_pc(st, st.buf.len::u32, mi.inline_site);
            if (R.is_err[R.Void, str](rip)) { ret rip; }
            if (mi.opcode::u16 == riscv.RET::u16 && !naked) {
                emit_epilogue(st, f, total);
            }
            val ei: R.Result[R.Void, str] = encode_mir_instr(st, f, fn_base, mi);
            if (R.is_err[R.Void, str](ei)) { ret ei; }
            val ra: R.Result[R.Void, str] = check_accounted(st, fn_base, mi.opcode::u16);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    val rx: R.Result[R.Void, str] = relax_function_riscv64(st, fn_base, fixup_start);
    if (R.is_err[R.Void, str](rx)) { ret rx; }
    ret check_accounted(st, fn_base, RELAX_REGION);
}

val PROLOGUE_REGION: u16 = 0xFFFF;
val RELAX_REGION:    u16 = 0xFFFE;

fun check_accounted(st: *encode.EncodeState, fn_base: u32, opcode: u16) R.Result[R.Void, str] {
    if (!encode.sink_active(?st.buf)) { ret R.ok_void[str](); }
    val emitted:  u32 = st.buf.len::u32 - fn_base;
    val notified: u32 = encode.note_inst_count(?st.buf) * WORD_SIZE;
    if (emitted == notified) { ret R.ok_void[str](); }

    var num: [24]u8;
    var label: str = "prologue";
    if (opcode == RELAX_REGION) { label = "branch relaxation"; }
    or (opcode != PROLOGUE_REGION) {
        val n: usize = rv_dec_into(?num[0], opcode::u64);
        num[n] = 0;
        label = (?num[0])::str;
    }
    ret R.err[R.Void, str](iasm.named_message(st.alloc, st.interner,
        "--emit-asm: ", label, " emitted instructions the riscv64 assembly printer did not render",
        "--emit-asm: an opcode emitted instructions the riscv64 assembly printer did not render"));
}

fun patch_branch_riscv64(st: *encode.EncodeState, fx: *encode.BranchFixup, target_off: u32) R.Result[R.Void, str] {
    val pos: usize = fx.patch_pos::usize;
    if (pos + 4 > st.buf.len) {
        ret R.err[R.Void, str]("encode: branch fixup site is outside the text buffer");
    }
    val word: u32 = read_word(?st.buf, pos);
    val sdisp: i64 = (target_off::i64) - (fx.patch_pos::i64);
    if ((sdisp & 1) != 0) {
        ret R.err[R.Void, str]("encode: riscv64 branch displacement is not 2-byte aligned");
    }
    val disp: u32 = target_off - fx.patch_pos;
    val opcode: u32 = word & 0x7F;

    if (opcode == OPC_JAL) {
        if (sdisp < J_DISP_MIN || sdisp > J_DISP_MAX) {
            ret R.err[R.Void, str]("encode: riscv64 jump displacement exceeds the +-1MiB range");
        }
        write_word(?st.buf, pos, (word & 0xFFF) | j_imm(disp));
        ret R.ok_void[str]();
    }
    if (opcode == OPC_BRANCH) {
        if (sdisp < B_DISP_MIN || sdisp > B_DISP_MAX) {
            ret R.err[R.Void, str]("encode: riscv64 branch displacement exceeds the +-4KiB range");
        }
        write_word(?st.buf, pos, (word & 0x01FFF07F) | b_imm(disp));
        ret R.ok_void[str]();
    }
    if (opcode == OPC_AUIPC) {
        if (pos + 8 > st.buf.len) {
            ret R.err[R.Void, str]("encode: riscv64 trampoline fixup site is outside the text buffer");
        }
        if (sdisp < -2147483648 || sdisp > 2147483647) {
            ret R.err[R.Void, str]("encode: riscv64 trampoline displacement exceeds the 32-bit pc-relative range");
        }
        val hi20: u32 = ((disp + 0x800) >> 12) & 0xFFFFF;
        val lo12: u32 = disp & 0xFFF;
        write_word(?st.buf, pos, pack_u(OPC_AUIPC, SCRATCH, hi20));
        write_word(?st.buf, pos + 4, pack_i(OPC_JALR, F3_ADD, RZERO, SCRATCH, lo12));
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: branch fixup site is not a B-type, J-type, or trampoline instruction");
}

pub fun encode_riscv64(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule) R.Result[encode.EncoderOutput, str] {
    var hooks: encode.EncodeHooks;
    hooks.encode_function = encode_function_riscv64;
    hooks.patch_branch    = patch_branch_riscv64;
    ret encode.encode_driver(alloc, tgt, m, ?hooks);
}

pub fun encode_riscv64_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule,
                           out: *writer.Writer) R.Result[encode.EncoderOutput, str] {
    var hooks: encode.EncodeHooks;
    hooks.encode_function = encode_function_riscv64;
    hooks.patch_branch    = patch_branch_riscv64;
    ret encode.encode_driver_asm(alloc, tgt, m, ?hooks, out);
}

fun asm_is_space(c: char) bool {
    ret c == ' '::char || c == '\t'::char || c == '\r'::char;
}

fun asm_reg_index_region(body: str, lo: usize, hi: usize) i32 {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "zero")) { ret 0; }
    if (str_region_equals(body, lo, len, "ra"))   { ret 1; }
    if (str_region_equals(body, lo, len, "sp"))   { ret 2; }
    if (str_region_equals(body, lo, len, "gp"))   { ret 3; }
    if (str_region_equals(body, lo, len, "tp"))   { ret 4; }
    if (str_region_equals(body, lo, len, "t0"))   { ret 5; }
    if (str_region_equals(body, lo, len, "t1"))   { ret 6; }
    if (str_region_equals(body, lo, len, "t2"))   { ret 7; }
    if (str_region_equals(body, lo, len, "s0"))   { ret 8; }
    if (str_region_equals(body, lo, len, "fp"))   { ret 8; }
    if (str_region_equals(body, lo, len, "s1"))   { ret 9; }
    if (str_region_equals(body, lo, len, "a0"))   { ret 10; }
    if (str_region_equals(body, lo, len, "a1"))   { ret 11; }
    if (str_region_equals(body, lo, len, "a2"))   { ret 12; }
    if (str_region_equals(body, lo, len, "a3"))   { ret 13; }
    if (str_region_equals(body, lo, len, "a4"))   { ret 14; }
    if (str_region_equals(body, lo, len, "a5"))   { ret 15; }
    if (str_region_equals(body, lo, len, "a6"))   { ret 16; }
    if (str_region_equals(body, lo, len, "a7"))   { ret 17; }
    if (str_region_equals(body, lo, len, "s2"))   { ret 18; }
    if (str_region_equals(body, lo, len, "s3"))   { ret 19; }
    if (str_region_equals(body, lo, len, "s4"))   { ret 20; }
    if (str_region_equals(body, lo, len, "s5"))   { ret 21; }
    if (str_region_equals(body, lo, len, "s6"))   { ret 22; }
    if (str_region_equals(body, lo, len, "s7"))   { ret 23; }
    if (str_region_equals(body, lo, len, "s8"))   { ret 24; }
    if (str_region_equals(body, lo, len, "s9"))   { ret 25; }
    if (str_region_equals(body, lo, len, "s10"))  { ret 26; }
    if (str_region_equals(body, lo, len, "s11"))  { ret 27; }
    if (str_region_equals(body, lo, len, "t3"))   { ret 28; }
    if (str_region_equals(body, lo, len, "t4"))   { ret 29; }
    if (str_region_equals(body, lo, len, "t5"))   { ret 30; }
    if (str_region_equals(body, lo, len, "t6"))   { ret 31; }
    if (len >= 2 && body[lo] == 'x'::char) {
        var n: i32 = 0;
        var i: usize = lo + 1;
        for (i < hi) {
            if (body[i] < '0'::char || body[i] > '9'::char) { ret -1; }
            n = n * 10 + (body[i]::i32 - '0'::char::i32);
            i = i + 1;
        }
        if (n >= 0 && n < 32) { ret n; }
    }
    ret -1;
}

fun asm_reg_index(tok: str) i32 {
    ret asm_reg_index_region(tok, 0, str_len(tok));
}

