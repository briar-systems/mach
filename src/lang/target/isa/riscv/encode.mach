    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_symbol_relocs" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "call foo");
    if (read_word(?st.buf, 0) != 0x00000097) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x000080E7) { bad = 1; }
    if (st.reloc_count != 1) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PLT32) { bad = 1; }
        if (st.relocs[0].offset != 0)         { bad = 1; }
    }

    rv_asm_text(?st, ?f, ?labels, "tail foo");
    if (read_word(?st.buf, 8)  != 0x00000317) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00030067) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[1].kind != of.RK_PLT32) { bad = 1; }
        if (st.relocs[1].offset != 8)         { bad = 1; }
    }

    rv_asm_text(?st, ?f, ?labels, "la a0, foo");
    if (read_word(?st.buf, 16) != 0x00000517) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x00050513) { bad = 1; }
    if (st.reloc_count != 4) { bad = 1; }
    or {
        if (st.relocs[2].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[2].offset != 16)               { bad = 1; }
        if (st.relocs[3].kind != of.RK_PCREL_LO12_I) { bad = 1; }
        if (st.relocs[3].offset != 20)               { bad = 1; }
    }

    val ur: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "frobnicate a0, a1");
    if (!sel ur.err) { bad = 1; }
    or (sel ur.err) { if (!str_contains(fail.describe(ur.err), "unknown riscv inline-asm instruction")) { bad = 1; } }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_atomics" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "lr.w a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.d a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoand.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoand.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoor.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoor.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoxor.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoxor.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomax.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomax.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomin.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomin.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomaxu.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomaxu.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amominu.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amominu.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.w.aq a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.d.aq a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.w.aqrl a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.w.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.d.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.d.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.w.aq a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.d.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.w.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d.aq a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomaxu.d.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "pause");

    if (read_word(?st.buf, 0)   != 0x1005A52F) { bad = 1; }
    if (read_word(?st.buf, 4)   != 0x1005B52F) { bad = 1; }
    if (read_word(?st.buf, 8)   != 0x18C5A52F) { bad = 1; }
    if (read_word(?st.buf, 12)  != 0x18C5B52F) { bad = 1; }
    if (read_word(?st.buf, 16)  != 0x08C5A52F) { bad = 1; }
    if (read_word(?st.buf, 20)  != 0x08C5B52F) { bad = 1; }
    if (read_word(?st.buf, 24)  != 0x00C5A52F) { bad = 1; }
    if (read_word(?st.buf, 28)  != 0x00C5B52F) { bad = 1; }
    if (read_word(?st.buf, 32)  != 0x60C5A52F) { bad = 1; }
    if (read_word(?st.buf, 36)  != 0x60C5B52F) { bad = 1; }
    if (read_word(?st.buf, 40)  != 0x40C5A52F) { bad = 1; }
    if (read_word(?st.buf, 44)  != 0x40C5B52F) { bad = 1; }
    if (read_word(?st.buf, 48)  != 0x20C5A52F) { bad = 1; }
    if (read_word(?st.buf, 52)  != 0x20C5B52F) { bad = 1; }
    if (read_word(?st.buf, 56)  != 0xA0C5A52F) { bad = 1; }
    if (read_word(?st.buf, 60)  != 0xA0C5B52F) { bad = 1; }
    if (read_word(?st.buf, 64)  != 0x80C5A52F) { bad = 1; }
    if (read_word(?st.buf, 68)  != 0x80C5B52F) { bad = 1; }
    if (read_word(?st.buf, 72)  != 0xE0C5A52F) { bad = 1; }
    if (read_word(?st.buf, 76)  != 0xE0C5B52F) { bad = 1; }
    if (read_word(?st.buf, 80)  != 0xC0C5A52F) { bad = 1; }
    if (read_word(?st.buf, 84)  != 0xC0C5B52F) { bad = 1; }
    if (read_word(?st.buf, 88)  != 0x1405A52F) { bad = 1; }
    if (read_word(?st.buf, 92)  != 0x1405B52F) { bad = 1; }
    if (read_word(?st.buf, 96)  != 0x1605A52F) { bad = 1; }
    if (read_word(?st.buf, 100) != 0x1AC5A52F) { bad = 1; }
    if (read_word(?st.buf, 104) != 0x1AC5B52F) { bad = 1; }
    if (read_word(?st.buf, 108) != 0x1EC5B52F) { bad = 1; }
    if (read_word(?st.buf, 112) != 0x0CC5A52F) { bad = 1; }
    if (read_word(?st.buf, 116) != 0x0AC5B52F) { bad = 1; }
    if (read_word(?st.buf, 120) != 0x06C5A52F) { bad = 1; }
    if (read_word(?st.buf, 124) != 0x04C5B52F) { bad = 1; }
    if (read_word(?st.buf, 128) != 0x02C5B52F) { bad = 1; }
    if (read_word(?st.buf, 132) != 0x06C5B52F) { bad = 1; }
    if (read_word(?st.buf, 136) != 0xE6C5B52F) { bad = 1; }
    if (read_word(?st.buf, 140) != 0x0100000F) { bad = 1; }

    val dr: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "lr.d a0, 8(a1)");
    if (!sel dr.err) { bad = 1; }
    or (sel dr.err) { if (!str_contains(fail.describe(dr.err), "no displacement")) { bad = 1; } }

    val ur: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "amobogus.q a0, a2, (a1)");
    if (!sel ur.err) { bad = 1; }
    or (sel ur.err) { if (!str_contains(fail.describe(ur.err), "unknown riscv inline-asm instruction")) { bad = 1; } }

    val settled: usize = st.buf.len;
    val br: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "amoadd.d.aqrl a0, a2, {slot}");
    if (!sel br.err) { bad = 1; }
    or (sel br.err) { if (!str_contains(fail.describe(br.err), "unresolved '{name}'")) { bad = 1; } }
    val r_5123: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "lr.d a0, {slot}");
    if (!sel r_5123.err) { bad = 1; }
    val r_5124: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "ld a0, {slot}");
    if (!sel r_5124.err) { bad = 1; }
    val r_5125: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "sd a0, {slot}");
    if (!sel r_5125.err) { bad = 1; }
    if (st.buf.len != settled) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

