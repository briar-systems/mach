    iasm.Mnemonic{ name: "not",    code: inst.XORI::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_NOT,  words: 1 },
    iasm.Mnemonic{ name: "seqz",   code: inst.SLTIU::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_SEQZ, words: 1 },
    iasm.Mnemonic{ name: "snez",   code: inst.SLTU::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_SNEZ, words: 1 },

    iasm.Mnemonic{ name: "csrrw",  code: inst.CSRRW::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_CSR,   words: 1 },
    iasm.Mnemonic{ name: "csrrs",  code: inst.CSRRS::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_CSR,   words: 1 },
    iasm.Mnemonic{ name: "csrrc",  code: inst.CSRRC::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_CSR,   words: 1 },
    iasm.Mnemonic{ name: "csrrwi", code: inst.CSRRWI::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_CSR_I, words: 1 },
    iasm.Mnemonic{ name: "csrrsi", code: inst.CSRRSI::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_CSR_I, words: 1 },
    iasm.Mnemonic{ name: "csrrci", code: inst.CSRRCI::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_CSR_I, words: 1 },

    iasm.Mnemonic{ name: "csrr",   code: inst.CSRRS::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: RVP_CSRR,  words: 1 },

    iasm.Mnemonic{ name: "csrw",   code: inst.CSRRW::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRW,  words: 1 },
    iasm.Mnemonic{ name: "csrs",   code: inst.CSRRS::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRW,  words: 1 },
    iasm.Mnemonic{ name: "csrc",   code: inst.CSRRC::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRW,  words: 1 },
    iasm.Mnemonic{ name: "csrwi",  code: inst.CSRRWI::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRWI, words: 1 },
    iasm.Mnemonic{ name: "csrsi",  code: inst.CSRRSI::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRWI, words: 1 },
    iasm.Mnemonic{ name: "csrci",  code: inst.CSRRCI::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: RVP_CSRWI, words: 1 },

    iasm.Mnemonic{ name: "rdcycle",   code: inst.CSRRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_RDCYCLE,   words: 1 },
    iasm.Mnemonic{ name: "rdtime",    code: inst.CSRRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_RDTIME,    words: 1 },
    iasm.Mnemonic{ name: "rdinstret", code: inst.CSRRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: RVP_RDINSTRET, words: 1 },
};

fun rv_decode_amo(body: str, lo: usize, hi: usize, m: *iasm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !iasm.is_space(body[end])) { end = end + 1; }
    var len: usize = end - lo;
    if (len < 4) { ret false; }

    var order: u16 = 0;
    if (len >= 5 && str_region_equals(body, lo + len - 5, 5, ".aqrl")) { order = RVF_AQ | RVF_RL; len = len - 5; }
    or (len >= 3 && str_region_equals(body, lo + len - 3, 3, ".aq"))   { order = RVF_AQ;           len = len - 3; }
    or (len >= 3 && str_region_equals(body, lo + len - 3, 3, ".rl"))   { order = RVF_RL;           len = len - 3; }
    if (len < 4) { ret false; }

    var word: bool = false;
    if (str_region_equals(body, lo + len - 2, 2, ".w"))      { word = true; }
    or (str_region_equals(body, lo + len - 2, 2, ".d"))      { word = false; }
    or { ret false; }
    val blen: usize = len - 2;

    var code: u32 = 0;
    var pat: u16 = RVP_AMO;
    if (str_region_equals(body, lo, blen, "lr"))           { code = inst.LR_W::u32; pat = RVP_AMO_LR; }
    or (str_region_equals(body, lo, blen, "sc"))           { code = inst.SC_W::u32; }
    or (str_region_equals(body, lo, blen, "amoswap"))      { code = inst.AMOSWAP_W::u32; }
    or (str_region_equals(body, lo, blen, "amoadd"))       { code = inst.AMOADD_W::u32; }
    or (str_region_equals(body, lo, blen, "amoxor"))       { code = inst.AMOXOR_W::u32; }
    or (str_region_equals(body, lo, blen, "amoand"))       { code = inst.AMOAND_W::u32; }
    or (str_region_equals(body, lo, blen, "amoor"))        { code = inst.AMOOR_W::u32; }
    or (str_region_equals(body, lo, blen, "amominu"))      { code = inst.AMOMINU_W::u32; }
    or (str_region_equals(body, lo, blen, "amomaxu"))      { code = inst.AMOMAXU_W::u32; }
    or (str_region_equals(body, lo, blen, "amomin"))       { code = inst.AMOMIN_W::u32; }
    or (str_region_equals(body, lo, blen, "amomax"))       { code = inst.AMOMAX_W::u32; }
    or { ret false; }
    if (!word) { code = code + 1; }

    m.name     = nil;
    m.code     = code;
    m.form     = iasm.AF_OPS;
    m.writes   = iasm.AW_OP0;
    m.implicit = 0;
    m.flags    = pat | order;
    m.words    = 1;
    @n_out     = end - lo;
    ret true;
}

val RVFMT_R: u8 = 0;
val RVFMT_I: u8 = 1;
val RVFMT_S: u8 = 2;
val RVFMT_B: u8 = 3;
val RVFMT_U: u8 = 4;
val RVFMT_J: u8 = 5;

fun rv_fields(op: inst.MachOp, fmt: *u8, opcode: *u32, f3: *u32, f7: *u32) bool {
    @fmt = RVFMT_R; @opcode = 0; @f3 = 0; @f7 = F7_ZERO;

    if (op == inst.ADD)  { @opcode = OPC_OP; @f3 = F3_ADD;  ret true; }
    if (op == inst.SLL)  { @opcode = OPC_OP; @f3 = F3_SLL;  ret true; }
    if (op == inst.SLT)  { @opcode = OPC_OP; @f3 = F3_SLT;  ret true; }
    if (op == inst.SLTU) { @opcode = OPC_OP; @f3 = F3_SLTU; ret true; }
    if (op == inst.XOR)  { @opcode = OPC_OP; @f3 = F3_XOR;  ret true; }
    if (op == inst.SRL)  { @opcode = OPC_OP; @f3 = F3_SRL;  ret true; }
    if (op == inst.OR)   { @opcode = OPC_OP; @f3 = F3_OR;   ret true; }
    if (op == inst.AND)  { @opcode = OPC_OP; @f3 = F3_AND;  ret true; }
    if (op == inst.SUB)  { @opcode = OPC_OP; @f3 = F3_ADD; @f7 = F7_SUB; ret true; }
    if (op == inst.SRA)  { @opcode = OPC_OP; @f3 = F3_SRL; @f7 = F7_SUB; ret true; }
    if (op == inst.ADDW) { @opcode = OPC_OP_32; @f3 = F3_ADD; ret true; }
    if (op == inst.SLLW) { @opcode = OPC_OP_32; @f3 = F3_SLL; ret true; }
    if (op == inst.SRLW) { @opcode = OPC_OP_32; @f3 = F3_SRL; ret true; }
    if (op == inst.SUBW) { @opcode = OPC_OP_32; @f3 = F3_ADD; @f7 = F7_SUB; ret true; }
    if (op == inst.SRAW) { @opcode = OPC_OP_32; @f3 = F3_SRL; @f7 = F7_SUB; ret true; }

    if (op == inst.MUL)    { @opcode = OPC_OP; @f3 = F3_ADD;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULH)   { @opcode = OPC_OP; @f3 = F3_SLL;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULHSU) { @opcode = OPC_OP; @f3 = F3_SLT;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULHU)  { @opcode = OPC_OP; @f3 = F3_SLTU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIV)    { @opcode = OPC_OP; @f3 = F3_DIV;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIVU)   { @opcode = OPC_OP; @f3 = F3_DIVU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.REM)    { @opcode = OPC_OP; @f3 = F3_REM;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.REMU)   { @opcode = OPC_OP; @f3 = F3_REMU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.MULW)   { @opcode = OPC_OP_32; @f3 = F3_ADD;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIVW)   { @opcode = OPC_OP_32; @f3 = F3_DIV;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.DIVUW)  { @opcode = OPC_OP_32; @f3 = F3_DIVU; @f7 = F7_MULDIV; ret true; }
    if (op == inst.REMW)   { @opcode = OPC_OP_32; @f3 = F3_REM;  @f7 = F7_MULDIV; ret true; }
    if (op == inst.REMUW)  { @opcode = OPC_OP_32; @f3 = F3_REMU; @f7 = F7_MULDIV; ret true; }

    if (op == inst.ADDI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_ADD;  ret true; }
    if (op == inst.SLTI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SLT;  ret true; }
    if (op == inst.SLTIU) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SLTU; ret true; }
    if (op == inst.XORI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_XOR;  ret true; }
    if (op == inst.ORI)   { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_OR;   ret true; }
    if (op == inst.ANDI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_AND;  ret true; }
    if (op == inst.SLLI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SLL;  ret true; }
    if (op == inst.SRLI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SRL;  ret true; }
    if (op == inst.SRAI)  { @fmt = RVFMT_I; @opcode = OPC_OP_IMM; @f3 = F3_SRL;  ret true; }
    if (op == inst.ADDIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_ADD; ret true; }
    if (op == inst.SLLIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_SLL; ret true; }
    if (op == inst.SRLIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_SRL; ret true; }
    if (op == inst.SRAIW) { @fmt = RVFMT_I; @opcode = OPC_OP_IMM_32; @f3 = F3_SRL; ret true; }

    if (op == inst.LB)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x0; ret true; }
    if (op == inst.LH)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x1; ret true; }
    if (op == inst.LW)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x2; ret true; }
    if (op == inst.LD)   { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x3; ret true; }
    if (op == inst.LBU)  { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x4; ret true; }
    if (op == inst.LHU)  { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x5; ret true; }
    if (op == inst.LWU)  { @fmt = RVFMT_I; @opcode = OPC_LOAD; @f3 = 0x6; ret true; }
    if (op == inst.JALR) { @fmt = RVFMT_I; @opcode = OPC_JALR; @f3 = F3_ADD; ret true; }
    if (op == inst.SB) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x0; ret true; }
    if (op == inst.SH) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x1; ret true; }
    if (op == inst.SW) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x2; ret true; }
    if (op == inst.SD) { @fmt = RVFMT_S; @opcode = OPC_STORE; @f3 = 0x3; ret true; }

    if (op == inst.ECALL || op == inst.EBREAK) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM;   @f3 = F3_ADD; ret true; }
    if (op == inst.FENCE || op == inst.PAUSE)  { @fmt = RVFMT_I; @opcode = OPC_MISC_MEM; @f3 = F3_ADD; ret true; }

    if (op == inst.CSRRW)  { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRW;  ret true; }
    if (op == inst.CSRRS)  { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRS;  ret true; }
    if (op == inst.CSRRC)  { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRC;  ret true; }
    if (op == inst.CSRRWI) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRWI; ret true; }
    if (op == inst.CSRRSI) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRSI; ret true; }
    if (op == inst.CSRRCI) { @fmt = RVFMT_I; @opcode = OPC_SYSTEM; @f3 = F3_CSRRCI; ret true; }

    if (op == inst.BEQ)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BEQ;  ret true; }
    if (op == inst.BNE)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BNE;  ret true; }
    if (op == inst.BLT)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BLT;  ret true; }
    if (op == inst.BGE)  { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BGE;  ret true; }
    if (op == inst.BLTU) { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BLTU; ret true; }
    if (op == inst.BGEU) { @fmt = RVFMT_B; @opcode = OPC_BRANCH; @f3 = F3_BGEU; ret true; }
    if (op == inst.LUI)   { @fmt = RVFMT_U; @opcode = OPC_LUI;   ret true; }
    if (op == inst.AUIPC) { @fmt = RVFMT_U; @opcode = OPC_AUIPC; ret true; }
    if (op == inst.JAL)   { @fmt = RVFMT_J; @opcode = OPC_JAL;   ret true; }

    if (op >= inst.LR_W && op <= inst.AMOMAXU_D) {
        @opcode = OPC_AMO;
        @f3     = F3_AMO_D;
        if (rv_amo_is_word(op)) { @f3 = F3_AMO_W; }
        @f7 = rv_amo_funct5(op) << 2;
        ret true;
    }
    ret false;
}

fun rv_amo_is_word(op: inst.MachOp) bool {
    ret ((op - inst.LR_W) & 1) == 0;
}

fun rv_amo_funct5(op: inst.MachOp) u32 {
    if (op == inst.LR_W || op == inst.LR_D)             { ret A5_LR; }
    if (op == inst.SC_W || op == inst.SC_D)             { ret A5_SC; }
    if (op == inst.AMOSWAP_W || op == inst.AMOSWAP_D)   { ret A5_AMOSWAP; }
    if (op == inst.AMOADD_W || op == inst.AMOADD_D)     { ret A5_AMOADD; }
    if (op == inst.AMOXOR_W || op == inst.AMOXOR_D)     { ret A5_AMOXOR; }
    if (op == inst.AMOAND_W || op == inst.AMOAND_D)     { ret A5_AMOAND; }
    if (op == inst.AMOOR_W || op == inst.AMOOR_D)       { ret A5_AMOOR; }
    if (op == inst.AMOMIN_W || op == inst.AMOMIN_D)     { ret A5_AMOMIN; }
    if (op == inst.AMOMAX_W || op == inst.AMOMAX_D)     { ret A5_AMOMAX; }
    if (op == inst.AMOMINU_W || op == inst.AMOMINU_D)   { ret A5_AMOMINU; }
    ret A5_AMOMAXU;
}

fun rv_operand(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) R.Result[R.Void, str] {
    @op = iasm.op_none();
    if (hi <= lo) { ret R.err[R.Void, str]("encode: malformed inline-asm operand"); }

    if (c.body[lo] == '{'::char) {
        var off: i64 = 0;
        val bound_r: R.Result[bool, str] = iasm.bind_offset(c, lo, hi, ?off);
        if (R.is_err[bool, str](bound_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](bound_r)); }
        if (R.unwrap_ok[bool, str](bound_r)) {
            @op = iasm.op_mem(RSP::i32, off, -1, 0, 8);
            ret R.ok_void[str]();
        }
        op.kind     = iasm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret R.ok_void[str]();
    }

    val ri: i32 = asm_reg_index_region(c.body, lo, hi);
    if (ri >= 0) { @op = iasm.op_reg(ri, 8); ret R.ok_void[str](); }

    if (c.body[lo] == '%'::char) { ret rv_modifier(c, lo, hi, op); }

    if (c.body[hi - 1] == ')'::char) { ret rv_mem(c, lo, hi, op); }

    val iv: O.Option[i64] = iasm.region_i64(c.body, lo, hi);
    if (O.is_some[i64](iv)) { @op = iasm.op_imm(O.unwrap[i64](iv), 8); ret R.ok_void[str](); }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: malformed inline-asm operand");
}

fun rv_modifier(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) R.Result[R.Void, str] {
    if (c.body[hi - 1] != ')'::char) { ret R.err[R.Void, str]("encode: malformed inline-asm relocation modifier"); }
    var open: usize = lo;
    var found: bool = false;
    for (open < hi && !found) {
        if (c.body[open] == '('::char) { found = true; } or { open = open + 1; }
    }
    if (!found) { ret R.err[R.Void, str]("encode: malformed inline-asm relocation modifier"); }

    var mod: isa.SymModifier = isa.SYM_MOD_NONE;
    val nlen: usize = open - lo - 1;
    if (str_region_equals(c.body, lo + 1, nlen, "pcrel_hi") && nlen == 8)      { mod = isa.SYM_MOD_PCREL_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "pcrel_lo") && nlen == 8)      { mod = isa.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_pcrel_hi") && nlen == 12) { mod = isa.SYM_MOD_GOT_HI; }
    or {
        ret R.err[R.Void, str](iasm.span_message(c,
            "encode: unsupported riscv64 inline-asm relocation modifier '", lo, hi, "'",
            "encode: unsupported riscv64 inline-asm relocation modifier"));
    }
    if (!iasm.is_sym_region(c.body, open + 1, hi - 1)) {
        ret R.err[R.Void, str]("encode: malformed inline-asm relocation modifier");
    }
    @op = iasm.op_sym(open + 1, hi - 1 - (open + 1), mod, 8);
    ret R.ok_void[str]();
}

fun rv_mem(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) R.Result[R.Void, str] {
    var open: usize = lo;
    var found: bool = false;
    for (open < hi && !found) {
        if (c.body[open] == '('::char) { found = true; } or { open = open + 1; }
    }
    if (!found) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }

    var bbuf: [24]u8;
    if (!iasm.copy_region(c.body, open + 1, hi - 1, ?bbuf[0], 24)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
    val base: i32 = asm_reg_index((?bbuf[0])::str);
    if (base < 0) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }

    var disp: i64 = 0;
    var flags: u8 = 0;
    var a: usize = lo;
    var b: usize = open;
    for (a < b && iasm.is_space(c.body[a])) { a = a + 1; }
    for (b > a && iasm.is_space(c.body[b - 1])) { b = b - 1; }
    if (b > a) {
        val dv: O.Option[i64] = iasm.region_i64(c.body, a, b);
        if (!O.is_some[i64](dv)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        disp  = O.unwrap[i64](dv);
        flags = iasm.AOF_HAS_DISP;
    }
    @op = iasm.op_mem(base, disp, -1, 0, 8);
    op.flags = flags;
    ret R.ok_void[str]();
}

fun rv_is_addr(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_MEM || op.kind == iasm.AOP_BIND;
}

fun rv_name_eq(name: str, want: str) bool {
    val n: usize = str_len(name);
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var c: u32 = name[i]::u32;
        if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
        if (c != want[i]::u32) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun rv_csr_name(name: str, out: *u32) bool {
    if (rv_name_eq(name, "sstatus")) { @out = 0x100; ret true; }
    if (rv_name_eq(name, "sie"))     { @out = 0x104; ret true; }
    if (rv_name_eq(name, "stvec"))   { @out = 0x105; ret true; }
    if (rv_name_eq(name, "sepc"))    { @out = 0x141; ret true; }
    if (rv_name_eq(name, "scause"))  { @out = 0x142; ret true; }
    if (rv_name_eq(name, "sip"))     { @out = 0x144; ret true; }
    if (rv_name_eq(name, "satp"))    { @out = 0x180; ret true; }

    if (rv_name_eq(name, "mstatus")) { @out = 0x300; ret true; }
    if (rv_name_eq(name, "mie"))     { @out = 0x304; ret true; }
    if (rv_name_eq(name, "mtvec"))   { @out = 0x305; ret true; }
    if (rv_name_eq(name, "mepc"))    { @out = 0x341; ret true; }
    if (rv_name_eq(name, "mcause"))  { @out = 0x342; ret true; }
    if (rv_name_eq(name, "mip"))     { @out = 0x344; ret true; }
    if (rv_name_eq(name, "mhartid")) { @out = 0xF14; ret true; }

    if (rv_name_eq(name, "cycle"))   { @out = 0xC00; ret true; }
    if (rv_name_eq(name, "time"))    { @out = 0xC01; ret true; }
    if (rv_name_eq(name, "instret")) { @out = 0xC02; ret true; }

    ret false;
}

fun rv_csr_operand(c: *iasm.Cursor, s: *iasm.Stmt, idx: u32, op: *iasm.Operand, out: *u32) bool {
    if (op.kind == iasm.AOP_IMM) {
        if (op.imm < 0 || op.imm > 0xFFF) { ret false; }
        @out = op.imm::u32;
        ret true;
    }
    var buf: [16]u8;
    if (!iasm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 16)) { ret false; }
    ret rv_csr_name((?buf[0])::str, out);
}

fun rv_label_operand(pat: u16, n: u32) u32 {
    if (pat == RVP_BRANCH || pat == RVP_BRANCH_SW)       { ret 2; }
    if (pat == RVP_BRANCH_Z1 || pat == RVP_BRANCH_Z2)    { ret 1; }
    if (pat == RVP_J)                                    { ret 0; }
    if (pat == RVP_JAL)                                  { ret n - 1; }
    ret 0xFFFFFFFF;
}

fun rv_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val pat: u16 = rv_pattern(s.m.flags);
    val n: u32 = s.nargs;

    val label_at: u32 = rv_label_operand(pat, n);
    var i: u32 = 0;
    for (i < n) {
        if (i != label_at) {
            val r: R.Result[R.Void, str] = rv_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (R.is_err[R.Void, str](r)) { ret r; }
        }
        i = i + 1;
    }

    if (pat == RVP_RRR || pat == RVP_RRI || pat == RVP_SHIFT) {
        if (n != 3) { ret R.err[R.Void, str]("encode: inline-asm instruction expects three operands"); }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm instruction operand must be a register");
        }
        if (pat == RVP_RRR) {
            if (item.ops[2].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm instruction source must be a register"); }
            ret R.ok_void[str]();
        }
        if (pat == RVP_RRI && item.ops[2].kind == iasm.AOP_SYM) { ret R.ok_void[str](); }
        if (item.ops[2].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm operand must be an immediate"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_LOAD || pat == RVP_STORE) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm load/store expects rd, off(base)"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm load/store value must be a register"); }
        if (!rv_is_addr(?item.ops[1]))        { ret R.err[R.Void, str]("encode: inline-asm load/store address must be off(base)"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_UIMM) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm lui/auipc expects rd, imm"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm destination must be a register"); }
        if (item.ops[1].kind == iasm.AOP_SYM) { ret R.ok_void[str](); }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm lui/auipc needs an immediate"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_BRANCH || pat == RVP_BRANCH_SW) {
        if (n != 3) { ret R.err[R.Void, str]("encode: inline-asm branch expects rs1, rs2, label"); }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm branch operand must be a register");
        }
        ret rv_local_target(c, s, item, 2);
    }
    if (pat == RVP_BRANCH_Z1 || pat == RVP_BRANCH_Z2) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm branch expects rs, label"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm branch operand must be a register"); }
        ret rv_local_target(c, s, item, 1);
    }
    if (pat == RVP_J) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm jump expects a label"); }
        ret rv_local_target(c, s, item, 0);
    }
    if (pat == RVP_JAL) {
        if (n == 1) { item.writes = iasm.AW_NONE; ret rv_local_target(c, s, item, 0); }
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm jump expects label or rd, label"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'jal' destination must be a register"); }
        ret rv_local_target(c, s, item, 1);
    }
    if (pat == RVP_JR) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm 'jr' expects a register"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm jr/jalr operand must be a register"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_JALR) {
        if (n == 1) {
            if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm jr/jalr operand must be a register"); }
            ret R.ok_void[str]();
        }
        if (n != 3) { ret R.err[R.Void, str]("encode: inline-asm jalr expects rs or rd, rs, imm"); }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm jalr operand must be a register");
        }
        if (item.ops[2].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm jalr needs an immediate"); }
        item.writes = iasm.AW_OP0;
        ret R.ok_void[str]();
    }
    if (pat == RVP_MV || pat == RVP_NOT || pat == RVP_SEQZ || pat == RVP_NEG || pat == RVP_SNEZ) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm instruction expects rd, rs"); }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm instruction operand must be a register");
        }
        ret R.ok_void[str]();
    }
    if (pat == RVP_LI) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm 'li' expects rd, imm"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'li' destination must be a register"); }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm 'li' needs an immediate"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_LA) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm 'la' expects rd, sym"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'la' destination must be a register"); }
        if (item.ops[1].kind != iasm.AOP_SYM) { ret R.err[R.Void, str]("encode: inline-asm 'la' target must be a symbol"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_CALL || pat == RVP_TAIL) {
        if (n != 1)                           { ret R.err[R.Void, str]("encode: inline-asm call/tail expects a symbol"); }
        if (item.ops[0].kind != iasm.AOP_SYM) { ret R.err[R.Void, str]("encode: inline-asm call/tail target must be a symbol"); }
        ret R.ok_void[str]();
    }
    if (pat == RVP_AMO) {
        if (n != 3) { ret R.err[R.Void, str]("encode: inline-asm atomic expects rd, rs2, (rs1)"); }
        if (item.ops[0].kind != iasm.AOP_REG || item.ops[1].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm atomic operand must be a register");
        }
        ret rv_amo_addr(?item.ops[2]);
    }
    if (pat == RVP_AMO_LR) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm 'lr' expects rd, (rs1)"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'lr' destination must be a register"); }
        ret rv_amo_addr(?item.ops[1]);
    }
    if (pat == RVP_CSR) {
        if (n != 3) { ret R.err[R.Void, str]("encode: inline-asm csrrw/csrrs/csrrc expects rd, csr, rs1"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm csr destination must be a register"); }
        if (item.ops[2].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm csr source must be a register"); }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 1, ?item.ops[1], ?addr)) { ret R.err[R.Void, str]("encode: unsupported inline-asm CSR"); }
        item.ops[1] = iasm.op_imm(addr::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSR_I) {
        if (n != 3) { ret R.err[R.Void, str]("encode: inline-asm csrrwi/csrrsi/csrrci expects rd, csr, uimm5"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm csr destination must be a register"); }
        if (item.ops[2].kind != iasm.AOP_IMM || item.ops[2].imm < 0 || item.ops[2].imm > 31) {
            ret R.err[R.Void, str]("encode: inline-asm csr immediate must be 0-31");
        }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 1, ?item.ops[1], ?addr)) { ret R.err[R.Void, str]("encode: unsupported inline-asm CSR"); }
        item.ops[1] = iasm.op_imm(addr::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSRR) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm 'csrr' expects rd, csr"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'csrr' destination must be a register"); }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 1, ?item.ops[1], ?addr)) { ret R.err[R.Void, str]("encode: unsupported inline-asm CSR"); }
        item.ops[1] = iasm.op_imm(addr::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSRW) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm csrw/csrs/csrc expects csr, rs1"); }
        if (item.ops[1].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm csr source must be a register"); }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 0, ?item.ops[0], ?addr)) { ret R.err[R.Void, str]("encode: unsupported inline-asm CSR"); }
        item.ops[0] = iasm.op_imm(addr::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSRWI) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm csrwi/csrsi/csrci expects csr, uimm5"); }
        if (item.ops[1].kind != iasm.AOP_IMM || item.ops[1].imm < 0 || item.ops[1].imm > 31) {
            ret R.err[R.Void, str]("encode: inline-asm csr immediate must be 0-31");
        }
        var addr: u32 = 0;
        if (!rv_csr_operand(c, s, 0, ?item.ops[0], ?addr)) { ret R.err[R.Void, str]("encode: unsupported inline-asm CSR"); }
        item.ops[0] = iasm.op_imm(addr::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == RVP_RDCYCLE || pat == RVP_RDTIME || pat == RVP_RDINSTRET) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm rdcycle/rdtime/rdinstret expects a register"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm rdcycle/rdtime/rdinstret destination must be a register"); }
        ret R.ok_void[str]();
    }
    if (n != 0) { ret R.err[R.Void, str]("encode: inline-asm instruction takes no operands"); }
    ret R.ok_void[str]();
}

fun rv_amo_addr(op: *iasm.Operand) R.Result[R.Void, str] {
    if (!rv_is_addr(op))                   { ret R.err[R.Void, str]("encode: inline-asm atomic address must be (rs1)"); }
    if ((op.flags & iasm.AOF_HAS_DISP) != 0 || op.imm != 0) {
        ret R.err[R.Void, str]("encode: inline-asm atomic address takes no displacement");
    }
    ret R.ok_void[str]();
}

fun rv_local_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32) R.Result[R.Void, str] {
    var num: u64 = 0;
    var fwd: bool = false;
    if (!iasm.label_ref_span(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?num, ?fwd)) {
        ret R.err[R.Void, str]("encode: inline-asm branch/jump target must be a numeric local label (Nf / Nb)");
    }
    item.ref     = iasm.AR_LOCAL;
    item.ref_num = num;
    item.ref_fwd = fwd;
    ret R.ok_void[str]();
}

fun rv_reg(op: *iasm.Operand) u32 {
    if (op.kind != iasm.AOP_REG || op.reg < 0) { ret RZERO; }
    ret op.reg::u32;
}

fun rv_absent_message(c: *iasm.Cursor, item: *iasm.Item, xl: u8) str {
    val end: usize = item.src_off + item.src_len;
    var i: usize = item.src_off;
    for (i < end && !iasm.is_space(c.body[i])) { i = i + 1; }

    if (xl == 4) {
        ret iasm.span_message(c, "encode: inline-asm instruction '", item.src_off, i,
            "' is not implemented on riscv32",
            "encode: inline-asm instruction is not implemented on riscv32");
    }
    ret iasm.span_message(c, "encode: inline-asm instruction '", item.src_off, i,
        "' is not implemented on riscv64",
        "encode: inline-asm instruction is not implemented on riscv64");
}

fun rv_emit(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) R.Result[R.Void, str] {
    val pat: u16 = rv_pattern(item.flags);
    val op: inst.MachOp = item.code::inst.MachOp;

    if (!inst.admits(op, xlen(st))) { ret R.err[R.Void, str](rv_absent_message(c, item, xlen(st))); }

    var fmt: u8 = 0;
    var opcode: u32 = 0;
    var f3: u32 = 0;
    var f7: u32 = 0;
    if (pat != RVP_LI && pat != RVP_LA && pat != RVP_CALL && pat != RVP_TAIL) {
        if (!rv_fields(op, ?fmt, ?opcode, ?f3, ?f7)) {
            ret R.err[R.Void, str]("internal compiler error: inline-asm riscv64 instruction has no encoding");
        }
    }

    if (pat == RVP_ECALL)  { emit_i(st, OPC_SYSTEM, F3_ADD, RZERO, RZERO, 0); ret R.ok_void[str](); }
    if (pat == RVP_EBREAK) { emit_i(st, OPC_SYSTEM, F3_ADD, RZERO, RZERO, 1); ret R.ok_void[str](); }
    if (pat == RVP_NOP)    { emit_i(st, OPC_OP_IMM, F3_ADD, RZERO, RZERO, 0); ret R.ok_void[str](); }
    if (pat == RVP_RET)    { emit_i(st, OPC_JALR, F3_ADD, RZERO, RRA, 0); ret R.ok_void[str](); }
    if (pat == RVP_FENCE)  { emit_i(st, OPC_MISC_MEM, F3_ADD, RZERO, RZERO, 0xFF); ret R.ok_void[str](); }
    if (pat == RVP_PAUSE)  { emit_i(st, OPC_MISC_MEM, F3_ADD, RZERO, RZERO, 0x010); ret R.ok_void[str](); }

    if (pat == RVP_RRR) {
        emit_r(st, opcode, f3, f7, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), rv_reg(?item.ops[2]));
        ret R.ok_void[str]();
    }
    if (pat == RVP_RRI) {
        if (item.ops[2].kind == iasm.AOP_SYM) { ret rv_emit_pcrel_lo(st, c, item, opcode, f3); }
        val v: i64 = item.ops[2].imm;
        if (v < -2048 || v > 2047) { ret R.err[R.Void, str]("encode: inline-asm immediate is out of the 12-bit signed range"); }
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), v::u32 & 0xFFF);
        ret R.ok_void[str]();
    }
    if (pat == RVP_SHIFT) {
        var mask: u32 = 0x3F;
        if (opcode == OPC_OP_IMM_32 || xlen(st) == 4) { mask = 0x1F; }
        val v: i64 = item.ops[2].imm;
        if (v < 0 || v::u32 > mask) { ret R.err[R.Void, str]("encode: inline-asm shift amount is out of range"); }
        var imm: u32 = v::u32 & mask;
        if (op == inst.SRAI || op == inst.SRAIW) { imm = imm | 0x400; }
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), imm);
        ret R.ok_void[str]();
    }
    if (pat == RVP_LOAD || pat == RVP_STORE) {
        val mem: *iasm.Operand = ?item.ops[1];
        if (mem.imm < -2048 || mem.imm > 2047) { ret R.err[R.Void, str]("encode: inline-asm load/store offset is out of the 12-bit signed range"); }
        if (pat == RVP_LOAD) {
            emit_i(st, opcode, f3, rv_reg(?item.ops[0]), mem.reg::u32, mem.imm::u32 & 0xFFF);
        } or {
            emit_s(st, opcode, f3, mem.reg::u32, rv_reg(?item.ops[0]), mem.imm::u32 & 0xFFF);
        }
        ret R.ok_void[str]();
    }
    if (pat == RVP_UIMM) { ret rv_emit_uimm(st, c, item, opcode); }
    if (pat == RVP_BRANCH || pat == RVP_BRANCH_SW || pat == RVP_BRANCH_Z1 || pat == RVP_BRANCH_Z2) {
        var rs1: u32 = RZERO;
        var rs2: u32 = RZERO;
        if (pat == RVP_BRANCH)         { rs1 = rv_reg(?item.ops[0]); rs2 = rv_reg(?item.ops[1]); }
        or (pat == RVP_BRANCH_SW)      { rs1 = rv_reg(?item.ops[1]); rs2 = rv_reg(?item.ops[0]); }
        or (pat == RVP_BRANCH_Z1)      { rs1 = rv_reg(?item.ops[0]); }
        or                             { rs2 = rv_reg(?item.ops[0]); }
        val pos: u32 = st.buf.len::u32;
        emit_b(st, opcode, f3, rs1, rs2, 0);
        note_local_target(st, item.ref_num, item.ref_fwd);
        ret iasm.resolve_local(st, c.g, l, pos, item.ref_num, item.ref_fwd);
    }
    if (pat == RVP_J || pat == RVP_JAL) {
        var rd: u32 = RZERO;
        if (pat == RVP_JAL) {
            rd = RRA;
            if (item.nops == 2) { rd = rv_reg(?item.ops[0]); }
        }
        val pos: u32 = st.buf.len::u32;
        emit_j(st, OPC_JAL, rd, 0);
        note_local_target(st, item.ref_num, item.ref_fwd);
        ret iasm.resolve_local(st, c.g, l, pos, item.ref_num, item.ref_fwd);
    }
    if (pat == RVP_JR)   { emit_i(st, OPC_JALR, F3_ADD, RZERO, rv_reg(?item.ops[0]), 0); ret R.ok_void[str](); }
    if (pat == RVP_JALR) {
        if (item.nops == 1) { emit_i(st, OPC_JALR, F3_ADD, RRA, rv_reg(?item.ops[0]), 0); ret R.ok_void[str](); }
        val v: i64 = item.ops[2].imm;
        if (v < -2048 || v > 2047) { ret R.err[R.Void, str]("encode: inline-asm jalr offset is out of the 12-bit signed range"); }
        emit_i(st, OPC_JALR, F3_ADD, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), v::u32 & 0xFFF);
        ret R.ok_void[str]();
    }
    if (pat == RVP_MV)   { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 0); ret R.ok_void[str](); }
    if (pat == RVP_NOT)  { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 0xFFF); ret R.ok_void[str](); }
    if (pat == RVP_SEQZ) { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 1); ret R.ok_void[str](); }
    if (pat == RVP_NEG)  { emit_r(st, opcode, f3, f7, rv_reg(?item.ops[0]), RZERO, rv_reg(?item.ops[1])); ret R.ok_void[str](); }
    if (pat == RVP_SNEZ) { emit_r(st, opcode, f3, f7, rv_reg(?item.ops[0]), RZERO, rv_reg(?item.ops[1])); ret R.ok_void[str](); }
    if (pat == RVP_LI)   { emit_li(st, rv_reg(?item.ops[0]), item.ops[1].imm); ret R.ok_void[str](); }
    if (pat == RVP_LA)   { ret rv_emit_la(st, c, item); }
    if (pat == RVP_CALL) { ret rv_emit_call(st, c, item, RRA, RRA); }
    if (pat == RVP_TAIL) { ret rv_emit_call(st, c, item, SCRATCH2, RZERO); }
    if (pat == RVP_AMO || pat == RVP_AMO_LR) {
        var f7o: u32 = f7;
        if ((item.flags & RVF_AQ) != 0) { f7o = f7o | 0x2; }
        if ((item.flags & RVF_RL) != 0) { f7o = f7o | 0x1; }
        if (pat == RVP_AMO_LR) {
            emit_r(st, opcode, f3, f7o, rv_reg(?item.ops[0]), item.ops[1].reg::u32, RZERO);
            ret R.ok_void[str]();
        }
        emit_r(st, opcode, f3, f7o, rv_reg(?item.ops[0]), item.ops[2].reg::u32, rv_reg(?item.ops[1]));
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSR) {
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[2]), item.ops[1].imm::u32);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSR_I) {
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), item.ops[2].imm::u32, item.ops[1].imm::u32);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSRR) {
        emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, item.ops[1].imm::u32);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSRW) {
        emit_i(st, opcode, f3, RZERO, rv_reg(?item.ops[1]), item.ops[0].imm::u32);
        ret R.ok_void[str]();
    }
    if (pat == RVP_CSRWI) {
        emit_i(st, opcode, f3, RZERO, item.ops[1].imm::u32, item.ops[0].imm::u32);
        ret R.ok_void[str]();
    }
    if (pat == RVP_RDCYCLE)   { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, 0xC00); ret R.ok_void[str](); }
    if (pat == RVP_RDTIME)    { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, 0xC01); ret R.ok_void[str](); }
    if (pat == RVP_RDINSTRET) { emit_i(st, opcode, f3, rv_reg(?item.ops[0]), RZERO, 0xC02); ret R.ok_void[str](); }
    ret R.err[R.Void, str]("internal compiler error: inline-asm riscv64 form has no emitter");
}

fun rv_emit_uimm(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item, opcode: u32) R.Result[R.Void, str] {
    val src: *iasm.Operand = ?item.ops[1];
    if (src.kind == iasm.AOP_SYM) {
        if (src.mod == isa.SYM_MOD_GOT_HI) {
            ret R.err[R.Void, str]("encode: riscv64 has no GOT-relative relocation kind, so inline-asm '%got_pcrel_hi' cannot be encoded");
        }
        if (opcode != OPC_AUIPC || src.mod != isa.SYM_MOD_PCREL_HI) {
            ret R.err[R.Void, str]("encode: inline-asm upper-immediate symbol reference must be an 'auipc rd, %pcrel_hi(sym)'");
        }
        val sr: R.Result[intern.StrId, str] = rv_intern(st, c, src);
        if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
        ret emit_pcrel_hi(st, rv_reg(?item.ops[0]), R.unwrap_ok[intern.StrId, str](sr), 0);
    }
    if (src.imm < 0 || src.imm > 0xFFFFF) { ret R.err[R.Void, str]("encode: inline-asm lui/auipc immediate is out of the 20-bit range"); }
    emit_u(st, opcode, rv_reg(?item.ops[0]), src.imm::u32 & 0xFFFFF);
    ret R.ok_void[str]();
}

fun rv_emit_pcrel_lo(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item, opcode: u32, f3: u32) R.Result[R.Void, str] {
    val src: *iasm.Operand = ?item.ops[2];
    if (src.mod != isa.SYM_MOD_PCREL_LO) {
        ret R.err[R.Void, str]("encode: inline-asm register-immediate symbol reference must be a '%pcrel_lo(sym)'");
    }
    val sr: R.Result[intern.StrId, str] = rv_intern(st, c, src);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
    val pos: u32 = st.buf.len::u32;
    emit_i(st, opcode, f3, rv_reg(?item.ops[0]), rv_reg(?item.ops[1]), 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, pos, of.RK_PCREL_LO12_I, sym);
}

fun rv_emit_la(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) R.Result[R.Void, str] {
    val sr: R.Result[intern.StrId, str] = rv_intern(st, c, ?item.ops[1]);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
    val rd: u32 = rv_reg(?item.ops[0]);
    val hr: R.Result[R.Void, str] = emit_pcrel_hi(st, rd, sym, 0);
    if (R.is_err[R.Void, str](hr)) { ret hr; }
    val lo_pos: u32 = st.buf.len::u32;
    emit_i(st, OPC_OP_IMM, F3_ADD, rd, rd, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    ret push_pcrel_lo(st, lo_pos, of.RK_PCREL_LO12_I, sym);
}

fun rv_emit_call(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item, link: u32, ret_reg: u32) R.Result[R.Void, str] {
    val sr: R.Result[intern.StrId, str] = rv_intern(st, c, ?item.ops[0]);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
    val pos: u32 = st.buf.len::u32;
    emit_u(st, OPC_AUIPC, link, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_HI, 0);
    emit_i(st, OPC_JALR, F3_ADD, ret_reg, link, 0);
    note_sym_target(st, sym, isa.SYM_MOD_PCREL_LO, 0);
    ret encode.push_reloc(st, pos, of.RK_PLT32, sym, 0);
}

fun rv_intern(st: *encode.EncodeState, c: *iasm.Cursor, op: *iasm.Operand) R.Result[intern.StrId, str] {
    ret intern.intern_bytes(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
}

fun rv_patch(st: *encode.EncodeState, patch_pos: u32, target_off: u32) R.Result[R.Void, str] {
    var fx: encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret patch_branch_riscv64(st, ?fx, target_off);
}

fun rv_slot_from_sp(f: *mir.MirFunction) bool { ret true; }

fun rv_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << RSP)) != 0; }
        ret true;
    }
    if ((item.implicit & (1::u32 << RSP)) != 0) { ret true; }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && rv_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && rv_is_sp(?item.ops[1])) { ret true; }
    ret false;
}

fun rv_is_sp(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_REG && op.reg == RSP::i32;
}

fun rv_isa_tag(xl: u8) str {
    if (xl == 4) { ret "riscv32"; }
    ret "riscv64";
}

fun rv_grammar_tagged(tag: str) iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = tag;
    g.unknown    = "unknown riscv inline-asm instruction '";
    g.rows       = ?RV_MNEMONICS[0];
    g.row_count  = RV_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD32[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = rv_decode_amo;
    g.parse      = rv_parse;
    g.emit       = rv_emit;
    g.patch      = rv_patch;
    g.slot       = asm_slot_offset;
    g.slot_sp    = rv_slot_from_sp;
    g.writes_sp  = rv_writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = rv_decl_reg;
    g.no_fall    = rv_no_fall;
    ret g;
}

fun rv_grammar(st: *encode.EncodeState) iasm.Grammar {
    ret rv_grammar_tagged(rv_isa_tag(xlen(st)));
}

fun rv_grammar_analysis() iasm.Grammar {
    ret rv_grammar_tagged("riscv");
}

fun rv_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == inst.EBREAK::u32;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = rv_grammar_analysis();
    ret iasm.returns(?g, body);
}

fun rv_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    val gp: i32 = asm_reg_index(name);
    if (gp >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = gp::u32;
        ret true;
    }
    val fp: i32 = asm_fp_reg_index(name);
    if (fp >= 0) {
        @bank = iasm.ABANK_FP;
        @idx  = fp::u32;
        ret true;
    }
    ret false;
}

fun asm_fp_reg_index(tok: str) i32 {
    var i: u32 = 0;
    for (i < 32) {
        if (str_equals(tok, printer.fp_name(i))) { ret i::i32; }
        i = i + 1;
    }
    if (tok[0] != 'f'::char || tok[1] == 0) { ret -1; }
    var n: i32 = 0;
    var k: usize = 1;
    for (tok[k] != 0) {
        if (tok[k] < '0'::char || tok[k] > '9'::char) { ret -1; }
        n = n * 10 + (tok[k]::i32 - '0'::char::i32);
        k = k + 1;
    }
    if (n >= 0 && n < 32) { ret n; }
    ret -1;
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = rv_grammar_analysis();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block_riscv64(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    var g: iasm.Grammar = rv_grammar(st);
    ret iasm.encode_block(st, ?g, f, mi);
}

fun rv_asm_text(st: *encode.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) R.Result[R.Void, str] {
    var g: iasm.Grammar = rv_grammar(st);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

var t_model_rv64: isa.MachineModel;
fun rv64_machine() *isa.MachineModel {
    t_model_rv64.pointer_width = 8;
    t_model_rv64.gpr_width     = 8;
    t_model_rv64.max_alu_width = 8;
    t_model_rv64.alu_min_width = 4;
    t_model_rv64.spill_width   = 8;
    t_model_rv64.flen_bits     = 64;
    ret ?t_model_rv64;
}

fun tbuf(st: *encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    encode.state_blank(st, alloc, rv64_machine());
}

fun tbuf_interned(st: *encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    encode.state_blank(st, alloc, rv64_machine());
    st.interner = itn;
}

fun label_at(st: *encode.EncodeState, name: intern.StrId, off: u32) bool {
    var i: u32 = 0;
    for (i < st.sym_count) {
        if (st.syms[i].name == name && st.syms[i].offset == off
            && st.syms[i].flags == PCREL_LABEL_FLAGS) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.target.isa.riscv.encode:rtype_itype_stype_utype_packers" {
    var bad: i32 = 0;
    if (pack_r(OPC_OP, F3_ADD, F7_ZERO, 10, 11, 12)  != 0x00C58533) { bad = 1; }
    if (pack_r(OPC_OP, F3_ADD, F7_SUB, 10, 11, 12)   != 0x40C58533) { bad = 1; }
    if (pack_r(OPC_OP_32, F3_ADD, F7_ZERO, 10, 11, 12) != 0x00C5853B) { bad = 1; }
    if (pack_r(OPC_OP_32, F3_ADD, F7_SUB, 10, 11, 12)  != 0x40C5853B) { bad = 1; }
    if (pack_r(OPC_OP, F3_AND, F7_ZERO, 10, 11, 12) != 0x00C5F533) { bad = 1; }
    if (pack_r(OPC_OP, F3_OR, F7_ZERO, 10, 11, 12)  != 0x00C5E533) { bad = 1; }
    if (pack_r(OPC_OP, F3_XOR, F7_ZERO, 10, 11, 12) != 0x00C5C533) { bad = 1; }
    if (pack_r(OPC_OP, F3_ADD, F7_MULDIV, 10, 11, 12) != 0x02C58533) { bad = 1; }
    if (pack_r(OPC_OP, F3_SLL, F7_ZERO, 10, 11, 12)   != 0x00C59533) { bad = 1; }
    if (pack_r(OPC_OP, F3_SRL, F7_ZERO, 10, 11, 12)   != 0x00C5D533) { bad = 1; }
    if (pack_r(OPC_OP, F3_SRL, F7_SUB, 10, 11, 12)    != 0x40C5D533) { bad = 1; }
    if (pack_i(OPC_OP_IMM, F3_ADD, 10, 11, 5) != 0x00558513) { bad = 1; }
    if (pack_i(OPC_OP_IMM, F3_AND, 10, 11, 5) != 0x0055F513) { bad = 1; }
    if (pack_i(OPC_OP_IMM_32, F3_ADD, 10, 11, 5) != 0x0055851B) { bad = 1; }
    if (pack_i(OPC_LOAD, F3_SLTU, 10, 11, 16) != 0x0105B503) { bad = 1; }
    if (pack_i(OPC_LOAD, F3_SLT, 10, 11, 16)  != 0x0105A503) { bad = 1; }
    if (pack_i(OPC_LOAD, F3_XOR, 10, 11, 16)  != 0x0105C503) { bad = 1; }
    if (pack_i(OPC_JALR, F3_ADD, 1, 10, 0) != 0x000500E7) { bad = 1; }
    if (pack_i(OPC_JALR, F3_ADD, 0, 1, 0)  != 0x00008067) { bad = 1; }
    if (pack_s(OPC_STORE, F3_SLTU, 11, 10, 16) != 0x00A5B823) { bad = 1; }
    if (pack_s(OPC_STORE, F3_SLT, 11, 10, 16)  != 0x00A5A823) { bad = 1; }
    if (pack_s(OPC_STORE, F3_ADD, 11, 10, 16)  != 0x00A58823) { bad = 1; }
    if (pack_u(OPC_LUI, 10, 0x12345) != 0x12345537) { bad = 1; }
    if (pack_u(OPC_AUIPC, 10, 0)     != 0x00000517) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:btype_jtype_immediate_scatter" {
    var bad: i32 = 0;
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, 0)  != 0x00B50063) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, 16) != 0x00B50863) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BNE, 10, 11, 16) != 0x00B51863) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BEQ, 10, 11, (0 - 4)::u32) != 0xFEB50EE3) { bad = 1; }
    if (pack_b(OPC_BRANCH, F3_BNE, 10, 0, 8) != 0x00051463) { bad = 1; }
    if (pack_j(OPC_JAL, 1, 0)  != 0x000000EF) { bad = 1; }
    if (pack_j(OPC_JAL, 1, 16) != 0x010000EF) { bad = 1; }
    if (pack_j(OPC_JAL, 0, 0)  != 0x0000006F) { bad = 1; }
    if (pack_j(OPC_JAL, 1, (0 - 4)::u32) != 0xFFDFF0EF) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:li_constant_materialization" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_li(?st, 10, 5);
    if (st.buf.len != 4) { bad = 1; }
    or { if (read_word(?st.buf, 0) != 0x00500513) { bad = 1; } }

    st.buf.len = 0;
    emit_li(?st, 10, 0 - 1);
    if (read_word(?st.buf, 0) != 0xFFF00513) { bad = 1; }

    st.buf.len = 0;
    emit_li(?st, 10, 0x12345678);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != 0x12345537) { bad = 1; }
        if (read_word(?st.buf, 4) != 0x6785051B) { bad = 1; }
    }

    st.buf.len = 0;
    emit_li(?st, 10, 0x100000000);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != 0x00100537) { bad = 1; }
        if (read_word(?st.buf, 4) != 0x00C51513) { bad = 1; }
    }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:width_driven_loads_stores_and_alu" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_mem_access(?st, 10, 11, 0, 1, true);
    emit_mem_access(?st, 10, 11, 0, 2, true);
    emit_mem_access(?st, 10, 11, 0, 4, true);
    emit_mem_access(?st, 10, 11, 0, 8, true);
    if (read_word(?st.buf, 0)  != 0x0005C503) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x0005D503) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x0005A503) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x0005B503) { bad = 1; }

    st.buf.len = 0;
    emit_mem_access(?st, 10, 11, 0, 1, false);
    emit_mem_access(?st, 10, 11, 0, 2, false);
    emit_mem_access(?st, 10, 11, 0, 4, false);
    emit_mem_access(?st, 10, 11, 0, 8, false);
    if (read_word(?st.buf, 0)  != 0x00A58023) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00A59023) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x00A5A023) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00A5B023) { bad = 1; }

    if (alu_opcode(8, 8) != OPC_OP)         { bad = 1; }
    if (alu_opcode(4, 8) != OPC_OP_32)      { bad = 1; }
    if (alu_opcode(1, 8) != OPC_OP)         { bad = 1; }
    if (alu_imm_opcode(8, 8) != OPC_OP_IMM) { bad = 1; }
    if (alu_imm_opcode(4, 8) != OPC_OP_IMM_32) { bad = 1; }
    if (alu_opcode(4, 4) != OPC_OP)         { bad = 1; }
    if (alu_opcode(1, 4) != OPC_OP)         { bad = 1; }
    if (alu_imm_opcode(4, 4) != OPC_OP_IMM) { bad = 1; }
    if (alu_imm_opcode(1, 4) != OPC_OP_IMM) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:mir_subword_load_store_widths" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    var ldops: [2]mir.MirOperand;
    ldops[0] = mir.op_preg(10);
    ldops[1] = mir.op_mem_preg(11, 0);
    var ld: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?ldops[0], 2, 0, 0);

    ld.width = 4; ld.src_width = 1; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005C503) { bad = 1; }
    st.buf.len = 0; ld.width = 4; ld.src_width = 2; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005D503) { bad = 1; }
    st.buf.len = 0; ld.width = 4; ld.src_width = 4; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005A503) { bad = 1; }
    st.buf.len = 0; ld.width = 8; ld.src_width = 8; encode_load(?st, nil, ?ld);
    if (read_word(?st.buf, 0) != 0x0005B503) { bad = 1; }

    var srops: [2]mir.MirOperand;
    srops[0] = mir.op_mem_preg(11, 0);
    srops[1] = mir.op_preg(10);
    var sr: mir.MirInstr = mir.instr(mir.MIR_STORE, ?srops[0], 2, 0, 0);

    st.buf.len = 0; sr.width = 1; sr.src_width = 1; encode_store(?st, nil, ?sr);
    if (read_word(?st.buf, 0) != 0x00A58023) { bad = 1; }
    st.buf.len = 0; sr.width = 2; sr.src_width = 2; encode_store(?st, nil, ?sr);
    if (read_word(?st.buf, 0) != 0x00A59023) { bad = 1; }

    st.buf.len = 0; st.reloc_count = 0;
    var glops: [2]mir.MirOperand;
    glops[0] = mir.op_preg(10);
    glops[1] = mir.op_sym(7::intern.StrId, 0);
    var gl: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?glops[0], 2, 0, 0);
    gl.width = 4; gl.src_width = 1; encode_load(?st, nil, ?gl);
    if (read_word(?st.buf, 0) != 0x00000297) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x0002C503) { bad = 1; }

    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:mir_alu_shift_mov_neg_not" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10); ops[1] = mir.op_preg(11); ops[2] = mir.op_preg(12);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);

    mi.width = 8; encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 0) != 0x00C58533) { bad = 1; }
    mi.width = 4; encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 4) != 0x00C5853B) { bad = 1; }

    st.buf.len = 0;
    ops[2] = mir.op_imm(5);
    mi.width = 8; encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 0) != 0x00558513) { bad = 1; }
    encode_addsub(?st, ?mi, true);
    if (read_word(?st.buf, 4) != 0xFFB58513) { bad = 1; }

    st.buf.len = 0;
    ops[2] = mir.op_imm(3);
    mi.width = 8; encode_shift(?st, ?mi, F3_SLL, false);
    if (read_word(?st.buf, 0) != 0x00359513) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, F3_SLL, false);
    if (read_word(?st.buf, 4) != 0x0035951B) { bad = 1; }
    mi.width = 8; encode_shift(?st, ?mi, F3_SRL, true);
    if (read_word(?st.buf, 8) != 0x4035D513) { bad = 1; }

    st.buf.len = 0;
    var mvo: [2]mir.MirOperand;
    mvo[0] = mir.op_preg(10); mvo[1] = mir.op_preg(11);
    var mv: mir.MirInstr = mir.instr(mir.MIR_ADD, ?mvo[0], 2, 8, 0);
    encode_mov(?st, nil, ?mv);
    if (read_word(?st.buf, 0) != 0x00058513) { bad = 1; }
    encode_neg(?st, ?mv);
    if (read_word(?st.buf, 4) != 0x40B00533) { bad = 1; }
    encode_not(?st, ?mv);
    if (read_word(?st.buf, 8) != 0xFFF5C513) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:const_value_variable_shift_materializes" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_imm(1);
    ops[2] = mir.op_preg(12);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 8, 0);

    encode_shift(?st, ?mi, F3_SLL, false);
    if (read_word(?st.buf, 0) != 0x00100313) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00C31533) { bad = 1; }

    st.buf.len = 0;
    encode_shift(?st, ?mi, F3_SRL, false);
    if (read_word(?st.buf, 0) != 0x00100313) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00C35533) { bad = 1; }

    st.buf.len = 0;
    encode_shift(?st, ?mi, F3_SRL, true);
    if (read_word(?st.buf, 0) != 0x00100313) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x40C35533) { bad = 1; }

    st.buf.len = 0;
    mi.width = 4;
    encode_shift(?st, ?mi, F3_SLL, false);
    if (read_word(?st.buf, 0) != 0x00100313) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00C3153B) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:integer_compare_sequences" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10); ops[1] = mir.op_preg(11); ops[2] = mir.op_preg(12);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 8, 0);

    mi.opcode = mir.MIR_SEL_CMP_EQ; encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5C533) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00153513) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CMP_NE; encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5C533) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00A03533) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CMP_LT_S; encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5A533) { bad = 1; }
    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CMP_LT_U; encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5B533) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CMP_LE_S; encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x00B62533) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00154513) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CMP_LT_S; mi.width = 1;
    encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0)  != 0x03859313) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x43835313) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x03861293) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x4382D293) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x00532533) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CMP_LT_U;
    encode_compare(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x0FF5F313) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x0FF67293) { bad = 1; }
    if (read_word(?st.buf, 8) != 0x00533533) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:fused_cbr_sequences" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;

    var ops: [4]mir.MirOperand;
    ops[0] = mir.op_preg(11);
    ops[1] = mir.op_preg(12);
    ops[2] = mir.op_block(3);
    ops[3] = mir.op_block(4);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 4, 8, 0);

    mi.opcode = mir.MIR_SEL_CBR_EQ; encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0) != 0x00C58063) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x0000006F) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CBR_NE; encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0) != 0x00C59063) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CBR_LT_S; encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5C063) { bad = 1; }
    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CBR_LT_U; encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5E063) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CBR_LE_S; encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0) != 0x00B65063) { bad = 1; }
    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CBR_LE_U; encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0) != 0x00B67063) { bad = 1; }

    if (st.fixup_count != 12)                          { bad = 1; }
    if (st.fixups[10].patch_pos != 0)                  { bad = 1; }
    if (st.fixups[10].target_block != 3)               { bad = 1; }
    if (st.fixups[11].patch_pos != 4)                  { bad = 1; }
    if (st.fixups[11].target_block != 4)               { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEL_CBR_LT_U; mi.width = 2;
    encode_fused_cbr(?st, 0, ?mi);
    if (read_word(?st.buf, 0)  != 0x03059313) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x03035313) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x03061293) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x0302D293) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x00536063) { bad = 1; }
    if (st.fixups[12].patch_pos != 16)         { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:branch_to_fallthrough_elided" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    st.alloc = ?alloc; st.fixups = nil; st.fixup_count = 0; st.fixup_cap = 0;

    var uops: [1]mir.MirOperand;
    uops[0] = mir.op_block(4);
    var ub: mir.MirInstr = mir.instr(mir.MIR_BR, ?uops[0], 1, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.len != 4)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.len != 0)     { bad = 1; }
    if (st.fixup_count != 0) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 9; st.buf.len = 0; st.fixup_count = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.len != 4)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(10); cops[1] = mir.op_block(3); cops[2] = mir.op_block(4);
    var cbr: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR, ?cops[0], 3, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_cbr(?st, 0, ?cbr);
    if (st.buf.len != 8)     { bad = 1; }
    if (st.fixup_count != 2) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_cbr(?st, 0, ?cbr);
    if (st.buf.len != 4)                    { bad = 1; }
    if (st.fixup_count != 1)                { bad = 1; }
    if (st.fixups[0].target_block != 3)     { bad = 1; }

    var ops: [4]mir.MirOperand;
    ops[0] = mir.op_preg(11); ops[1] = mir.op_preg(12);
    ops[2] = mir.op_block(3); ops[3] = mir.op_block(4);
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR_EQ, ?ops[0], 4, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_fused_cbr(?st, 0, ?mi);
    if (st.buf.len != 8)     { bad = 1; }
    if (st.fixup_count != 2) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_fused_cbr(?st, 0, ?mi);
    if (st.buf.len != 4)                    { bad = 1; }
    if (st.fixup_count != 1)                { bad = 1; }
    if (st.fixups[0].target_block != 3)     { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:leaf_prologue_epilogue" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var f: mir.MirFunction;
    f.callee_mask = 0; f.callee_mask_fp = 0;
    f.frame.size = 0; f.frame.outgoing_size = 0; f.frame.slots = nil; f.frame.slot_count = 0;

    val total: u32 = frame_total(?st, ?f);
    if (total != 16) { bad = 1; }

    emit_prologue(?st, ?f, total);
    if (read_word(?st.buf, 0)  != 0xFF010113) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00113423) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x00813023) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x01010413) { bad = 1; }

    st.buf.len = 0;
    emit_epilogue(?st, ?f, total);
    if (read_word(?st.buf, 0)  != 0x00813083) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00013403) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x01010113) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:callee_save_gp_frame" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var f: mir.MirFunction;
    f.callee_mask = (1::u32 << 9) | (1::u32 << 18);
    f.callee_mask_fp = 0;
    f.frame.size = 0; f.frame.outgoing_size = 0; f.frame.slots = nil; f.frame.slot_count = 0;

    val total: u32 = frame_total(?st, ?f);
    if (total != 32) { bad = 1; }

    emit_prologue(?st, ?f, total);
    if (read_word(?st.buf, 0)  != 0xFE010113) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00113C23) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x00813823) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x02010413) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x00913423) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x01213023) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:branch_fixups_scatter_and_range" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_word(?st, pack_j(OPC_JAL, RZERO, 0));
    emit_word(?st, pack_b(OPC_BRANCH, F3_BNE, 10, 0, 0));

    var fx: encode.BranchFixup;
    fx.patch_pos = 0; fx.next_ip = 4;
    patch_branch_riscv64(?st, ?fx, 16);
    if (read_word(?st.buf, 0) != 0x0100006F) { bad = 1; }
    fx.patch_pos = 4; fx.next_ip = 8;
    patch_branch_riscv64(?st, ?fx, 12);
    if (read_word(?st.buf, 4) != 0x00051463) { bad = 1; }

    fx.patch_pos = 4; fx.next_ip = 8;
    emit_word(?st, pack_j(OPC_JAL, RZERO, 0));
    st.buf.data[4] = 0x6F; st.buf.data[5] = 0; st.buf.data[6] = 0; st.buf.data[7] = 0;
    patch_branch_riscv64(?st, ?fx, 0);
    if (read_word(?st.buf, 4) != 0xFFDFF06F) { bad = 1; }

    st.buf.len = 0;
    emit_word(?st, pack_b(OPC_BRANCH, F3_BNE, 10, 0, 0));
    fx.patch_pos = 0; fx.next_ip = 4;
    val r1: R.Result[R.Void, str] = patch_branch_riscv64(?st, ?fx, 8192);
    if (!R.is_err[R.Void, str](r1)) { bad = 1; }

    st.buf.len = 0;
    emit_word(?st, pack_j(OPC_JAL, RZERO, 0));
    fx.patch_pos = 0; fx.next_ip = 4;
    val r2: R.Result[R.Void, str] = patch_branch_riscv64(?st, ?fx, 2000000);
    if (!R.is_err[R.Void, str](r2)) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_far_branch(st: *encode.EncodeState, alloc: *A.Allocator) bool {
    tbuf(st, alloc);
    emit_word(st, pack_b(OPC_BRANCH, F3_BNE, 10, 0, 0));
    if (R.is_err[R.Void, str](encode.push_block(st, 0, 1, 4000000))) { ret false; }
    if (R.is_err[R.Void, str](encode.push_fixup(st, 0, 4, 1, 0)))    { ret false; }
    ret true;
}

test "mach.lang.target.isa.riscv.encode.relax:round_bound_is_proven_and_enforced" {
    var bad: i32 = 0;

    if (relax_round_bound(0) != 1) { bad = 1; }
    if (relax_round_bound(1) != 3) { bad = 1; }
    if (relax_round_bound(7) != 15) { bad = 1; }

    var starved: encode.EncodeState;
    var starved_alloc: A.Allocator;
    if (!t_far_branch(?starved, ?starved_alloc)) { ret 1; }
    val short_budget: R.Result[R.Void, str] = relax_function_bounded(?starved, 0, 0, 2);
    if (!R.is_err[R.Void, str](short_budget)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](short_budget), "round bound")) { bad = 1; } }
    encode.buf_dnit(?starved.buf);

    var st: encode.EncodeState;
    var alloc: A.Allocator;
    if (!t_far_branch(?st, ?alloc)) { ret 1; }
    val settled: R.Result[R.Void, str] = relax_function_riscv64(?st, 0, 0);
    if (R.is_err[R.Void, str](settled)) { bad = 1; }
    if (st.buf.len != 12)                              { bad = 1; }
    if ((read_word(?st.buf, 0) & 0x7F) != OPC_BRANCH)  { bad = 1; }
    if ((read_word(?st.buf, 4) & 0x7F) != OPC_AUIPC)   { bad = 1; }
    if ((read_word(?st.buf, 8) & 0x7F) != OPC_JALR)    { bad = 1; }

    var again: encode.EncodeState;
    var again_alloc: A.Allocator;
    if (!t_far_branch(?again, ?again_alloc)) { ret 1; }
    if (R.is_err[R.Void, str](relax_function_riscv64(?again, 0, 0))) { bad = 1; }
    if (again.buf.len != st.buf.len) { bad = 1; }
    or {
        var k: usize = 0;
        for (k < st.buf.len) {
            if (again.buf.data[k] != st.buf.data[k]) { bad = 1; }
            k = k + 1;
        }
    }
    encode.buf_dnit(?again.buf);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:call_records_plt32_marker" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    val sym: intern.StrId = 7::intern.StrId;

    var cops: [1]mir.MirOperand;
    cops[0] = mir.op_sym(sym, 0);
    var ci: mir.MirInstr = mir.instr(mir.MIR_CALL, ?cops[0], 1, 0, 0);
    encode_call(?st, ?ci);
    if (read_word(?st.buf, 0) != 0x00000097) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x000080E7) { bad = 1; }
    if (st.reloc_count != 1)                 { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PLT32) { bad = 1; }
        if (st.relocs[0].offset != 0)         { bad = 1; }
        if (st.relocs[0].sym != sym)          { bad = 1; }
    }

    var iops: [1]mir.MirOperand;
    iops[0] = mir.op_preg(10);
    var ii: mir.MirInstr = mir.instr(mir.MIR_CALL, ?iops[0], 1, 0, 0);
    encode_call(?st, ?ii);
    if (read_word(?st.buf, 8) != 0x000500E7) { bad = 1; }
    if (st.reloc_count != 1)                 { bad = 1; }

    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:global_la_sequences" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    val sym: intern.StrId = 9::intern.StrId;

    var ao: mir.MirOperand = mir.op_sym(sym, 0);
    emit_global_addr(?st, 10, ?ao);
    if (read_word(?st.buf, 0) != 0x00000517) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00050513) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[0].offset != 0)                { bad = 1; }
        if (st.relocs[0].sym != sym)                 { bad = 1; }
        if (st.relocs[1].kind != of.RK_PCREL_LO12_I) { bad = 1; }
        if (st.relocs[1].offset != 4)                { bad = 1; }
        if (st.relocs[1].sym == sym)                 { bad = 1; }
        if (!label_at(?st, st.relocs[1].sym, 0))     { bad = 1; }
    }

    st.buf.len = 0; st.reloc_count = 0;
    var lo: mir.MirOperand = mir.op_sym(sym, 0);
    emit_global_load(?st, 10, ?lo, 8);
    if (read_word(?st.buf, 0) != 0x00000297) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x0002B503) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[1].kind != of.RK_PCREL_LO12_I) { bad = 1; }
        if (st.relocs[1].offset != 4)                { bad = 1; }
    }

    st.buf.len = 0; st.reloc_count = 0;
    var l1: mir.MirOperand = mir.op_sym(sym, 0);
    emit_global_load(?st, 10, ?l1, 1);
    if (read_word(?st.buf, 4) != 0x0002C503) { bad = 1; }

    st.buf.len = 0; st.reloc_count = 0;
    var so: mir.MirOperand = mir.op_sym(sym, 0);
    var sv: mir.MirOperand = mir.op_preg(11);
    emit_global_store(?st, ?so, ?sv, 8);
    if (read_word(?st.buf, 0) != 0x00000297) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00B2B023) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[1].kind != of.RK_PCREL_LO12_S) { bad = 1; }
        if (st.relocs[1].offset != 4)                { bad = 1; }
    }

    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:pcrel_pair_sites_are_indexed" {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    fin {
        encode.buf_dnit(?st.buf);
        if (st.syms != nil && st.sym_cap > 0) {
            A.deallocate[encode.SymbolMark](?alloc, st.syms, st.sym_cap::usize);
        }
        if (st.relocs != nil && st.reloc_cap > 0) {
            A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
        }
        map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
        intern.dnit(?itn);
    }

    val absent: R.Result[R.Void, str] =
        push_pcrel_lo(?st, 0, of.RK_PCREL_LO12_I, 0x7FFFFFFF::intern.StrId);
    if (R.is_ok[R.Void, str](absent) || st.reloc_count != 0 || st.sym_count != 0) {
        ret 1;
    }

    val count: u32 = 1024;
    var i: u32 = 0;
    for (i < count) {
        val target: R.Result[intern.StrId, str] =
            encode.intern_local_label(?st, ".Tpair_target.", i);
        if (R.is_err[intern.StrId, str](target)) { ret 2; }
        val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](target);
        val high_off: u32 = st.buf.len::u32;
        val high: R.Result[R.Void, str] = emit_pcrel_hi(?st, SCRATCH, sym, 0);
        if (R.is_err[R.Void, str](high)) { ret 3; }
        emit_i(?st, OPC_OP_IMM, F3_ADD, SCRATCH, SCRATCH, 0);
        val low: R.Result[R.Void, str] =
            push_pcrel_lo(?st, high_off + WORD_SIZE, of.RK_PCREL_LO12_I, sym);
        if (R.is_err[R.Void, str](low)) { ret 4; }
        i = i + 1;
    }

    var bad: i32 = 0;
    if (st.reloc_pair_sites.len != count::usize) { bad = 5; }
    if (st.reloc_count != count * 2 || st.sym_count != count) { bad = 6; }
    i = 0;
    for (i < count) {
        val high_index: u32 = i * 2;
        val low_index: u32 = high_index + 1;
        if (st.relocs[high_index].offset != i * 8
            || st.relocs[low_index].sym != st.syms[i].name
            || st.syms[i].offset != i * 8) { bad = 7; brk; }
        if (st.relocs[high_index].pair != 0
            || st.relocs[low_index].pair != high_index + 1
            || st.relocs[st.relocs[low_index].pair - 1].kind != of.RK_PCREL_HI20) {
            bad = 20; brk;
        }
        i = i + 1;
    }

    val repeated_r: R.Result[intern.StrId, str] =
        encode.intern_local_label(?st, ".Trepeated_target.", 0);
    if (R.is_err[intern.StrId, str](repeated_r)) { ret 8; }
    val repeated: intern.StrId = R.unwrap_ok[intern.StrId, str](repeated_r);
    val first_off: u32 = st.buf.len::u32;
    if (R.is_err[R.Void, str](emit_pcrel_hi(?st, SCRATCH, repeated, 0))) { bad = 9; }
    val latest_off: u32 = st.buf.len::u32;
    if (R.is_err[R.Void, str](emit_pcrel_hi(?st, SCRATCH, repeated, 0))) { bad = 10; }
    if (st.sym_count != count || st.reloc_pair_sites.len != count::usize + 1) {
        bad = 11;
    }
    if (R.is_err[R.Void, str](encode.insert_text(?st, latest_off, WORD_SIZE))) {
        bad = 12;
    }
    val shifted_latest_off: u32 = latest_off + WORD_SIZE;
    val first_low_off: u32 = st.buf.len::u32;
    emit_i(?st, OPC_OP_IMM, F3_ADD, SCRATCH, SCRATCH, 0);
    if (R.is_err[R.Void, str](push_pcrel_lo(?st, first_low_off,
                                         of.RK_PCREL_LO12_I, repeated))) { bad = 13; }
    val latest_label: intern.StrId = st.relocs[st.reloc_count - 1].sym;
    if (latest_off == first_off || !label_at(?st, latest_label, shifted_latest_off)
        || label_at(?st, latest_label, first_off)) { bad = 14; }
    val symbols_after_first_low: u32 = st.sym_count;
    val second_low_off: u32 = st.buf.len::u32;
    val store_f3: u32 = R.unwrap_ok[u32, str](int_mem_funct3(8, false, 8));
    emit_s(?st, OPC_STORE, store_f3, SCRATCH, SCRATCH, 0);
    if (R.is_err[R.Void, str](push_pcrel_lo(?st, second_low_off,
                                         of.RK_PCREL_LO12_S, repeated))) { bad = 15; }
    if (st.sym_count != symbols_after_first_low
        || st.relocs[st.reloc_count - 1].sym != latest_label) { bad = 16; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode:asm_clobbers_classification" {
    var bad: i32 = 0;
    var gp: u32 = 0;
    var fp: u32 = 0;

    asm_clobbers("ld a0, 0(sp)\naddi a1, sp, 8\nsd a0, 0(a1)\ncall main", ?gp, ?fp);
    if ((gp & (1::u32 << 10)) == 0) { bad = 1; }
    if ((gp & (1::u32 << 11)) == 0) { bad = 1; }
    if ((gp & CALLER_SAVED_GP) != CALLER_SAVED_GP) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("sd a0, 0(sp)\nbeq a0, a1, 1f\necall\n1:", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("ld a0, {v}\nsd a1, {out}", ?gp, ?fp);
    if (gp != (1::u32 << 10)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("1: addi t0, t0, 1", ?gp, ?fp);
    if ((gp & (1::u32 << 5)) == 0) { bad = 1; }
    if ((gp & ~(1::u32 << 5)) != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("beq a0, a1, end", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("lr.d t0, (a1)\nsc.d t1, a2, (a1)\namoadd.d.aqrl a0, a2, (a1)\npause", ?gp, ?fp);
    if ((gp & (1::u32 << 5)) == 0)  { bad = 1; }
    if ((gp & (1::u32 << 6)) == 0)  { bad = 1; }
    if ((gp & (1::u32 << 10)) == 0) { bad = 1; }
    val amo_mask: u32 = (1::u32 << 5) | (1::u32 << 6) | (1::u32 << 10);
    if ((gp & ~amo_mask) != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("frobnicate a0, a1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    if (asm_reg_index("x0") != 0)   { bad = 1; }
    if (asm_reg_index("x31") != 31) { bad = 1; }
    if (asm_reg_index("sp") != 2)   { bad = 1; }
    if (asm_reg_index("fp") != 8)   { bad = 1; }
    if (asm_reg_index("a7") != 17)  { bad = 1; }
    if (asm_reg_index("t6") != 31)  { bad = 1; }
    if (asm_reg_index("notareg") != (0 - 1)) { bad = 1; }

    ret bad;
}

fun tasm(st: *encode.EncodeState, alloc: *A.Allocator, interner: *intern.Interner) {
    page.make(alloc);
    @interner = intern.init(alloc);
    encode.state_blank(st, alloc, rv64_machine());
    st.interner = interner;
}

var t_model_rv32: isa.MachineModel;
fun rv32_machine() *isa.MachineModel {
    t_model_rv32.pointer_width = 4;
    t_model_rv32.gpr_width     = 4;
    t_model_rv32.max_alu_width = 4;
    t_model_rv32.alu_min_width = 4;
    t_model_rv32.spill_width   = 4;
    t_model_rv32.flen_bits     = 64;
    ret ?t_model_rv32;
}

fun tasm32(st: *encode.EncodeState, alloc: *A.Allocator, interner: *intern.Interner) {
    page.make(alloc);
    @interner = intern.init(alloc);
    encode.state_blank(st, alloc, rv32_machine());
    st.interner = interner;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_core_forms" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "ecall");
    rv_asm_text(?st, ?f, ?labels, "ebreak");
    rv_asm_text(?st, ?f, ?labels, "nop");
    rv_asm_text(?st, ?f, ?labels, "ret");
    rv_asm_text(?st, ?f, ?labels, "fence");
    rv_asm_text(?st, ?f, ?labels, "li a7, 93");
    rv_asm_text(?st, ?f, ?labels, "li a0, 0");
    rv_asm_text(?st, ?f, ?labels, "mv a0, a1");
    rv_asm_text(?st, ?f, ?labels, "add a0, a1, a2");
    rv_asm_text(?st, ?f, ?labels, "sub a0, a1, a2");
    rv_asm_text(?st, ?f, ?labels, "addi a0, a1, 5");
    rv_asm_text(?st, ?f, ?labels, "ld a0, 8(sp)");
    rv_asm_text(?st, ?f, ?labels, "sd a0, 16(sp)");
    rv_asm_text(?st, ?f, ?labels, "lw a0, 0(a1)");
    rv_asm_text(?st, ?f, ?labels, "lbu a0, 0(a1)");
    rv_asm_text(?st, ?f, ?labels, "sb a0, 0(a1)");
    rv_asm_text(?st, ?f, ?labels, "lui a0, 0x12345");
    rv_asm_text(?st, ?f, ?labels, "auipc a0, 0");
    rv_asm_text(?st, ?f, ?labels, "slli a0, a1, 3");
    rv_asm_text(?st, ?f, ?labels, "srai a0, a1, 3");
    rv_asm_text(?st, ?f, ?labels, "addiw a0, a1, 1");
    rv_asm_text(?st, ?f, ?labels, "neg a0, a1");
    rv_asm_text(?st, ?f, ?labels, "not a0, a1");
    rv_asm_text(?st, ?f, ?labels, "sext.w a0, a1");
    rv_asm_text(?st, ?f, ?labels, "seqz a0, a1");
    rv_asm_text(?st, ?f, ?labels, "snez a0, a1");
    rv_asm_text(?st, ?f, ?labels, "mul a0, a1, a2");
    rv_asm_text(?st, ?f, ?labels, "divu a0, a1, a2");
    rv_asm_text(?st, ?f, ?labels, "addw a0, a1, a2");

    if (read_word(?st.buf, 0)   != 0x00000073) { bad = 1; }
    if (read_word(?st.buf, 4)   != 0x00100073) { bad = 1; }
    if (read_word(?st.buf, 8)   != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 12)  != 0x00008067) { bad = 1; }
    if (read_word(?st.buf, 16)  != 0x0FF0000F) { bad = 1; }
    if (read_word(?st.buf, 20)  != 0x05D00893) { bad = 1; }
    if (read_word(?st.buf, 24)  != 0x00000513) { bad = 1; }
    if (read_word(?st.buf, 28)  != 0x00058513) { bad = 1; }
    if (read_word(?st.buf, 32)  != 0x00C58533) { bad = 1; }
    if (read_word(?st.buf, 36)  != 0x40C58533) { bad = 1; }
    if (read_word(?st.buf, 40)  != 0x00558513) { bad = 1; }
    if (read_word(?st.buf, 44)  != 0x00813503) { bad = 1; }
    if (read_word(?st.buf, 48)  != 0x00A13823) { bad = 1; }
    if (read_word(?st.buf, 52)  != 0x0005A503) { bad = 1; }
    if (read_word(?st.buf, 56)  != 0x0005C503) { bad = 1; }
    if (read_word(?st.buf, 60)  != 0x00A58023) { bad = 1; }
    if (read_word(?st.buf, 64)  != 0x12345537) { bad = 1; }
    if (read_word(?st.buf, 68)  != 0x00000517) { bad = 1; }
    if (read_word(?st.buf, 72)  != 0x00359513) { bad = 1; }
    if (read_word(?st.buf, 76)  != 0x4035D513) { bad = 1; }
    if (read_word(?st.buf, 80)  != 0x0015851B) { bad = 1; }
    if (read_word(?st.buf, 84)  != 0x40B00533) { bad = 1; }
    if (read_word(?st.buf, 88)  != 0xFFF5C513) { bad = 1; }
    if (read_word(?st.buf, 92)  != 0x0005851B) { bad = 1; }
    if (read_word(?st.buf, 96)  != 0x0015B513) { bad = 1; }
    if (read_word(?st.buf, 100) != 0x00B03533) { bad = 1; }
    if (read_word(?st.buf, 104) != 0x02C58533) { bad = 1; }
    if (read_word(?st.buf, 108) != 0x02C5D533) { bad = 1; }
    if (read_word(?st.buf, 112) != 0x00C5853B) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

val RV64_ONLY_COUNT: usize = 30;
val RV64_ONLY_ASM: [RV64_ONLY_COUNT]str = [RV64_ONLY_COUNT]str{
    "ld a0, 8(sp)",
    "sd a0, 16(sp)",
    "lwu a0, 0(a1)",
    "addw a0, a1, a2",
    "subw a0, a1, a2",
    "sllw a0, a1, a2",
    "srlw a0, a1, a2",
    "sraw a0, a1, a2",
    "mulw a0, a1, a2",
    "divw a0, a1, a2",
    "divuw a0, a1, a2",
    "remw a0, a1, a2",
    "remuw a0, a1, a2",
    "addiw a0, a1, 1",
    "slliw a0, a1, 3",
    "srliw a0, a1, 3",
    "sraiw a0, a1, 3",
    "sext.w a0, a1",
    "negw a0, a1",
    "lr.d a0, (a1)",
    "sc.d a0, a2, (a1)",
    "amoswap.d a0, a2, (a1)",
    "amoadd.d a0, a2, (a1)",
    "amoand.d a0, a2, (a1)",
    "amoor.d a0, a2, (a1)",
    "amoxor.d a0, a2, (a1)",
    "amomax.d a0, a2, (a1)",
    "amomin.d a0, a2, (a1)",
    "amomaxu.d a0, a2, (a1)",
    "amominu.d a0, a2, (a1)",
};

val RV_BOTH_COUNT: usize = 32;
val RV_BOTH_ASM: [RV_BOTH_COUNT]str = [RV_BOTH_COUNT]str{
    "ecall",
    "ebreak",
    "nop",
    "ret",
    "fence",
    "pause",
    "add a0, a1, a2",
    "sub a0, a1, a2",
    "sll a0, a1, a2",
    "srl a0, a1, a2",
    "sra a0, a1, a2",
    "slt a0, a1, a2",
    "and a0, a1, a2",
    "mul a0, a1, a2",
    "div a0, a1, a2",
    "rem a0, a1, a2",
    "addi a0, a1, 5",
    "andi a0, a1, 5",
    "slli a0, a1, 3",
    "srai a0, a1, 3",
    "lb a0, 0(a1)",
    "lh a0, 0(a1)",
    "lw a0, 0(a1)",
    "lbu a0, 0(a1)",
    "sb a0, 0(a1)",
    "sw a0, 0(a1)",
    "lui a0, 0x12345",
    "auipc a0, 0",
    "mv a0, a1",
    "neg a0, a1",
    "lr.w a0, (a1)",
    "amoadd.w a0, a2, (a1)",
};

test "mach.lang.target.isa.riscv.encode:rv64_only_forms_are_refused_on_rv32" {
    var bad: i32 = 0;

    var st64: encode.EncodeState;
    var alloc64: A.Allocator;
    var itn64: intern.Interner;
    tasm(?st64, ?alloc64, ?itn64);
    var lab64: iasm.Labels;
    iasm.labels_init(?lab64, ?alloc64);

    var st32: encode.EncodeState;
    var alloc32: A.Allocator;
    var itn32: intern.Interner;
    tasm32(?st32, ?alloc32, ?itn32);
    var lab32: iasm.Labels;
    iasm.labels_init(?lab32, ?alloc32);

    var f: mir.MirFunction;

    var i: usize = 0;
    for (i < RV64_ONLY_COUNT) {
        st32.buf.len = 0;
        val r32: R.Result[R.Void, str] = rv_asm_text(?st32, ?f, ?lab32, RV64_ONLY_ASM[i]);
        if (!t_refused(r32, ?st32.buf)) { bad = 1; }
        or {
            if (!str_contains(R.unwrap_err[R.Void, str](r32), "is not implemented on riscv32")) { bad = 1; }
        }

        st64.buf.len = 0;
        if (!t_accepted(rv_asm_text(?st64, ?f, ?lab64, RV64_ONLY_ASM[i]), ?st64.buf)) { bad = 1; }
        i = i + 1;
    }

    i = 0;
    for (i < RV_BOTH_COUNT) {
        st32.buf.len = 0;
        if (!t_accepted(rv_asm_text(?st32, ?f, ?lab32, RV_BOTH_ASM[i]), ?st32.buf)) { bad = 1; }
        st64.buf.len = 0;
        if (!t_accepted(rv_asm_text(?st64, ?f, ?lab64, RV_BOTH_ASM[i]), ?st64.buf)) { bad = 1; }
        i = i + 1;
    }

    st32.buf.len = 0;
    val ur: R.Result[R.Void, str] = rv_asm_text(?st32, ?f, ?lab32, "frobnicate a0, a1");
    if (!t_refused(ur, ?st32.buf)) { bad = 1; }
    or {
        if (!str_contains(R.unwrap_err[R.Void, str](ur), "unknown riscv inline-asm instruction")) { bad = 1; }
    }

    st32.buf.len = 0;
    if (!t_refused(rv_asm_text(?st32, ?f, ?lab32, "slli a0, a1, 32"), ?st32.buf)) { bad = 1; }
    st32.buf.len = 0;
    if (!t_accepted(rv_asm_text(?st32, ?f, ?lab32, "slli a0, a1, 31"), ?st32.buf)) { bad = 1; }
    st64.buf.len = 0;
    if (!t_accepted(rv_asm_text(?st64, ?f, ?lab64, "slli a0, a1, 32"), ?st64.buf)) { bad = 1; }

    iasm.labels_dnit(?lab32);
    encode.buf_dnit(?st32.buf);
    iasm.labels_dnit(?lab64);
    encode.buf_dnit(?st64.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:every_grammar_row_states_its_machines" {
    var bad: i32 = 0;

    var i: usize = 0;
    for (i < RV_MNEMONIC_COUNT) {
        if (inst.xlens(RV_MNEMONICS[i].code::inst.MachOp) == 0) { bad = 1; }
        i = i + 1;
    }

    var op: inst.MachOp = inst.LR_W;
    for (op <= inst.AMOMAXU_D) {
        if (inst.xlens(op) == 0) { bad = 1; }
        op = op + 1;
    }

    if (inst.xlens(inst.MOP_NONE) != 0)     { bad = 1; }
    if (inst.xlens(inst.MOP_LAST + 1) != 0) { bad = 1; }

    if (inst.xlens(inst.LD) != inst.XL64)   { bad = 1; }
    if (inst.xlens(inst.LW) != inst.XL_ANY) { bad = 1; }
    if (inst.admits(inst.LD, 4))            { bad = 1; }
    if (!inst.admits(inst.LD, 8))           { bad = 1; }
    if (!inst.admits(inst.LW, 4))           { bad = 1; }
    if (!inst.admits(inst.LW, 8))           { bad = 1; }

    if (inst.admits(inst.ADD, 0)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_long_symbol_operand" {
    var bad: i32 = 0;

    var st1: encode.EncodeState;
    var alloc1: A.Allocator;
    var interner1: intern.Interner;
    tasm(?st1, ?alloc1, ?interner1);
    var labels1: iasm.Labels;
    iasm.labels_init(?labels1, ?alloc1);
    var f1: mir.MirFunction;
    val r1: R.Result[R.Void, str] = rv_asm_text(?st1, ?f1, ?labels1, "call short_sym");
    if (R.is_err[R.Void, str](r1)) { bad = 1; }

    val long_name: str =
        "sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    val long_call: str =
        "call sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    var st2: encode.EncodeState;
    var alloc2: A.Allocator;
    var interner2: intern.Interner;
    tasm(?st2, ?alloc2, ?interner2);
    var labels2: iasm.Labels;
    iasm.labels_init(?labels2, ?alloc2);
    var f2: mir.MirFunction;
    val r2: R.Result[R.Void, str] = rv_asm_text(?st2, ?f2, ?labels2, long_call);
    if (R.is_err[R.Void, str](r2)) { bad = 1; }

    if (st1.buf.len != st2.buf.len) { bad = 1; }
    or {
        var i: usize = 0;
        for (i < st1.buf.len) {
            if (st1.buf.data[i] != st2.buf.data[i]) { bad = 1; }
            i = i + 1;
        }
    }

    if (st2.reloc_count == 0) { bad = 1; }
    or {
        val nm: O.Option[str] = intern.lookup(st2.interner, st2.relocs[st2.reloc_count - 1].sym);
        if (!O.is_some[str](nm)) { bad = 1; }
        or (!str_equals(O.unwrap[str](nm), long_name)) { bad = 1; }
    }

    var st3: encode.EncodeState;
    var alloc3: A.Allocator;
    var interner3: intern.Interner;
    tasm(?st3, ?alloc3, ?interner3);
    var labels3: iasm.Labels;
    iasm.labels_init(?labels3, ?alloc3);
    var f3: mir.MirFunction;
    val r3: R.Result[R.Void, str] = rv_asm_text(?st3, ?f3, ?labels3, "ld a0, )(sp");
    if (R.is_ok[R.Void, str](r3)) { bad = 1; }

    iasm.labels_dnit(?labels1);
    encode.buf_dnit(?st1.buf);
    iasm.labels_dnit(?labels2);
    encode.buf_dnit(?st2.buf);
    iasm.labels_dnit(?labels3);
    encode.buf_dnit(?st3.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_data_directives" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "nop");
    rv_asm_text(?st, ?f, ?labels, ".word 0x00000013");
    rv_asm_text(?st, ?f, ?labels, ".long 0x00000013");
    rv_asm_text(?st, ?f, ?labels, ".byte 0x13, 0x00, 0x00, 0x00");
    rv_asm_text(?st, ?f, ?labels, ".quad 0x0000001300000013");
    rv_asm_text(?st, ?f, ?labels, ".word 0xc0102573");

    if (read_word(?st.buf, 0)  != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xC0102573) { bad = 1; }
    if (st.buf.len != 28) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_data_directive_refusals" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, ".byte 0x13");
    if (!R.is_err[R.Void, str](r1))                                                                { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r1), "whole number of instruction words")) { bad = 1; } }

    val r2: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, ".byte 0x13, 0x00, 0x00");
    if (!R.is_err[R.Void, str](r2))                                                                { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r2), "whole number of instruction words")) { bad = 1; } }

    val r3: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, ".word 0x100000013");
    if (!R.is_err[R.Void, str](r3))                                                    { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r3), "cannot hold")) { bad = 1; } }

    val r4: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, ".half 0x1234");
    if (!R.is_err[R.Void, str](r4))                                                                       { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r4), "unknown riscv inline-asm instruction")) { bad = 1; } }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:emit_asm_renders_data_directives" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = printer.test_sink_write;
    printer.test_sink_reset();
    var sink: encode.AsmSink = encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    val r1: R.Result[R.Void, str] =
        rv_asm_text(?st, ?f, ?labels, ".byte 0x13, 0x05, 0x00, 0x00, 0x93, 0x05, 0x10, 0x00");
    if (R.is_err[R.Void, str](r1)) { bad = 1; }
    val r2: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, "addi zero, zero, 0");
    if (R.is_err[R.Void, str](r2)) { bad = 1; }

    if (encode.note_inst_count(?st.buf) * WORD_SIZE != st.buf.len::u32) { bad = 1; }

    val rr: R.Result[R.Void, str] = printer.render_notes(?st.buf);
    if (R.is_err[R.Void, str](rr)) { bad = 1; }
    or {
        val text: str = printer.test_sink_text();
        val di: O.Option[usize] = str_index_of(text, ".byte 0x13, 0x05, 0x00, 0x00");
        val dj: O.Option[usize] = str_index_of(text, ".byte 0x93, 0x05, 0x10, 0x00");
        val ii: O.Option[usize] = str_index_of(text, "addi zero, zero, 0");
        if (O.is_none[usize](di) || O.is_none[usize](dj) || O.is_none[usize](ii)) { bad = 1; }
        or {
            if (O.unwrap[usize](di) >= O.unwrap[usize](dj)) { bad = 1; }
            if (O.unwrap[usize](dj) >= O.unwrap[usize](ii)) { bad = 1; }
        }
    }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:asm_clobbers_data_directives_are_opaque" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xc0102573", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers("nop", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode:declared_raw_encodings" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xc0102573 :: writes(a0)", ?gp, ?fp);
    if (gp != (1::u32 << 10)) { bad = 1; }
    if (fp != 0)              { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xc0102573", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xc0102573 :: writes(x10)", ?gp, ?fp);
    if (gp != (1::u32 << 10)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0x00000013 :: writes(ft2, fa0)", ?gp, ?fp);
    if (gp != 0)                                    { bad = 1; }
    if (fp != ((1::u32 << 2) | (1::u32 << 10)))     { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers(".word 0x00000013 :: writes(f2)", ?gp, ?fp);
    if (fp != (1::u32 << 2)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0x0ff0000f :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0x00000013 :: writes(x32)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers(".word 0x00000013 :: writes(a8)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("addi a0, a1, 1 :: writes()", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_local_labels" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "1:");
    rv_asm_text(?st, ?f, ?labels, "addi a0, a0, 1");
    rv_asm_text(?st, ?f, ?labels, "bne a0, a1, 1b");
    rv_asm_text(?st, ?f, ?labels, "j 2f");
    rv_asm_text(?st, ?f, ?labels, "nop");
    rv_asm_text(?st, ?f, ?labels, "2:");
    rv_asm_text(?st, ?f, ?labels, "ret");

    if (read_word(?st.buf, 0)  != 0x00150513) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0xFEB51EE3) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x0080006F) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00000013) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x00008067) { bad = 1; }
    if (labels.fixup_count != 0) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_symbol_relocs" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "call foo");
    if (read_word(?st.buf, 0) != 0x00000097) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x000080E7) { bad = 1; }
    if (st.reloc_count != 1) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PLT32) { bad = 1; }
        if (st.relocs[0].offset != 0)         { bad = 1; }
    }

    rv_asm_text(?st, ?f, ?labels, "tail foo");
    if (read_word(?st.buf, 8)  != 0x00000317) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00030067) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[1].kind != of.RK_PLT32) { bad = 1; }
        if (st.relocs[1].offset != 8)         { bad = 1; }
    }

    rv_asm_text(?st, ?f, ?labels, "la a0, foo");
    if (read_word(?st.buf, 16) != 0x00000517) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x00050513) { bad = 1; }
    if (st.reloc_count != 4) { bad = 1; }
    or {
        if (st.relocs[2].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[2].offset != 16)               { bad = 1; }
        if (st.relocs[3].kind != of.RK_PCREL_LO12_I) { bad = 1; }
        if (st.relocs[3].offset != 20)               { bad = 1; }
    }

    val ur: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, "frobnicate a0, a1");
    if (!R.is_err[R.Void, str](ur)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](ur), "unknown riscv inline-asm instruction")) { bad = 1; } }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_atomics" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "lr.w a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.d a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoand.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoand.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoor.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoor.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoxor.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoxor.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomax.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomax.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomin.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomin.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomaxu.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomaxu.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amominu.w a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amominu.d a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.w.aq a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.d.aq a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "lr.w.aqrl a0, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.w.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.d.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "sc.d.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.w.aq a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoswap.d.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.w.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d.aq a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d.rl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amoadd.d.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "amomaxu.d.aqrl a0, a2, (a1)");
    rv_asm_text(?st, ?f, ?labels, "pause");

    if (read_word(?st.buf, 0)   != 0x1005A52F) { bad = 1; }
    if (read_word(?st.buf, 4)   != 0x1005B52F) { bad = 1; }
    if (read_word(?st.buf, 8)   != 0x18C5A52F) { bad = 1; }
    if (read_word(?st.buf, 12)  != 0x18C5B52F) { bad = 1; }
    if (read_word(?st.buf, 16)  != 0x08C5A52F) { bad = 1; }
    if (read_word(?st.buf, 20)  != 0x08C5B52F) { bad = 1; }
    if (read_word(?st.buf, 24)  != 0x00C5A52F) { bad = 1; }
    if (read_word(?st.buf, 28)  != 0x00C5B52F) { bad = 1; }
    if (read_word(?st.buf, 32)  != 0x60C5A52F) { bad = 1; }
    if (read_word(?st.buf, 36)  != 0x60C5B52F) { bad = 1; }
    if (read_word(?st.buf, 40)  != 0x40C5A52F) { bad = 1; }
    if (read_word(?st.buf, 44)  != 0x40C5B52F) { bad = 1; }
    if (read_word(?st.buf, 48)  != 0x20C5A52F) { bad = 1; }
    if (read_word(?st.buf, 52)  != 0x20C5B52F) { bad = 1; }
    if (read_word(?st.buf, 56)  != 0xA0C5A52F) { bad = 1; }
    if (read_word(?st.buf, 60)  != 0xA0C5B52F) { bad = 1; }
    if (read_word(?st.buf, 64)  != 0x80C5A52F) { bad = 1; }
    if (read_word(?st.buf, 68)  != 0x80C5B52F) { bad = 1; }
    if (read_word(?st.buf, 72)  != 0xE0C5A52F) { bad = 1; }
    if (read_word(?st.buf, 76)  != 0xE0C5B52F) { bad = 1; }
    if (read_word(?st.buf, 80)  != 0xC0C5A52F) { bad = 1; }
    if (read_word(?st.buf, 84)  != 0xC0C5B52F) { bad = 1; }
    if (read_word(?st.buf, 88)  != 0x1405A52F) { bad = 1; }
    if (read_word(?st.buf, 92)  != 0x1405B52F) { bad = 1; }
    if (read_word(?st.buf, 96)  != 0x1605A52F) { bad = 1; }
    if (read_word(?st.buf, 100) != 0x1AC5A52F) { bad = 1; }
    if (read_word(?st.buf, 104) != 0x1AC5B52F) { bad = 1; }
    if (read_word(?st.buf, 108) != 0x1EC5B52F) { bad = 1; }
    if (read_word(?st.buf, 112) != 0x0CC5A52F) { bad = 1; }
    if (read_word(?st.buf, 116) != 0x0AC5B52F) { bad = 1; }
    if (read_word(?st.buf, 120) != 0x06C5A52F) { bad = 1; }
    if (read_word(?st.buf, 124) != 0x04C5B52F) { bad = 1; }
    if (read_word(?st.buf, 128) != 0x02C5B52F) { bad = 1; }
    if (read_word(?st.buf, 132) != 0x06C5B52F) { bad = 1; }
    if (read_word(?st.buf, 136) != 0xE6C5B52F) { bad = 1; }
    if (read_word(?st.buf, 140) != 0x0100000F) { bad = 1; }

    val dr: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, "lr.d a0, 8(a1)");
    if (!R.is_err[R.Void, str](dr)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](dr), "no displacement")) { bad = 1; } }

    val ur: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, "amobogus.q a0, a2, (a1)");
    if (!R.is_err[R.Void, str](ur)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](ur), "unknown riscv inline-asm instruction")) { bad = 1; } }

    val settled: usize = st.buf.len;
    val br: R.Result[R.Void, str] = rv_asm_text(?st, ?f, ?labels, "amoadd.d.aqrl a0, a2, {slot}");
    if (!R.is_err[R.Void, str](br)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](br), "unresolved '{name}'")) { bad = 1; } }
    if (!R.is_err[R.Void, str](rv_asm_text(?st, ?f, ?labels, "lr.d a0, {slot}")))  { bad = 1; }
    if (!R.is_err[R.Void, str](rv_asm_text(?st, ?f, ?labels, "ld a0, {slot}")))    { bad = 1; }
    if (!R.is_err[R.Void, str](rv_asm_text(?st, ?f, ?labels, "sd a0, {slot}")))    { bad = 1; }
    if (st.buf.len != settled) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_csr_forms" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    rv_asm_text(?st, ?f, ?labels, "csrrw a0, mstatus, a1");
    rv_asm_text(?st, ?f, ?labels, "csrrs a0, mstatus, a1");
    rv_asm_text(?st, ?f, ?labels, "csrrc a0, mstatus, a1");
    rv_asm_text(?st, ?f, ?labels, "csrrwi a0, mstatus, 5");
    rv_asm_text(?st, ?f, ?labels, "csrrsi a0, mstatus, 5");
    rv_asm_text(?st, ?f, ?labels, "csrrci a0, mstatus, 5");
    rv_asm_text(?st, ?f, ?labels, "csrr a0, mstatus");
    rv_asm_text(?st, ?f, ?labels, "csrw mstatus, a1");
    rv_asm_text(?st, ?f, ?labels, "csrs mstatus, a1");
    rv_asm_text(?st, ?f, ?labels, "csrc mstatus, a1");
    rv_asm_text(?st, ?f, ?labels, "csrwi mstatus, 5");
    rv_asm_text(?st, ?f, ?labels, "csrsi mstatus, 5");
    rv_asm_text(?st, ?f, ?labels, "csrci mstatus, 5");
    rv_asm_text(?st, ?f, ?labels, "rdcycle a0");
    rv_asm_text(?st, ?f, ?labels, "rdtime a0");
    rv_asm_text(?st, ?f, ?labels, "rdinstret a0");

    if (read_word(?st.buf, 0)  != 0x30059573) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x3005A573) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x3005B573) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x3002D573) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x3002E573) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x3002F573) { bad = 1; }
    if (read_word(?st.buf, 24) != 0x30002573) { bad = 1; }
    if (read_word(?st.buf, 28) != 0x30059073) { bad = 1; }
    if (read_word(?st.buf, 32) != 0x3005A073) { bad = 1; }
    if (read_word(?st.buf, 36) != 0x3005B073) { bad = 1; }
    if (read_word(?st.buf, 40) != 0x3002D073) { bad = 1; }
    if (read_word(?st.buf, 44) != 0x3002E073) { bad = 1; }
    if (read_word(?st.buf, 48) != 0x3002F073) { bad = 1; }
    if (read_word(?st.buf, 52) != 0xC0002573) { bad = 1; }
    if (read_word(?st.buf, 56) != 0xC0102573) { bad = 1; }
    if (read_word(?st.buf, 60) != 0xC0202573) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

