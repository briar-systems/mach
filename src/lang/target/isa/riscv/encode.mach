test "mach.lang.target.isa.riscv.encode:inline_asm_csr_names" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, sstatus");
    val r2: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, sie");
    val r3: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, stvec");
    val r4: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, sepc");
    val r5: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, scause");
    val r6: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, sip");
    val r7: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, satp");
    val r8: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mstatus");
    val r9: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mie");
    val r10: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mtvec");
    val r11: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mepc");
    val r12: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mcause");
    val r13: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mip");
    val r14: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, mhartid");
    val r15: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, cycle");
    val r16: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, time");
    val r17: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, instret");
    if (sel r1.err)  { bad = 1; }
    if (sel r2.err)  { bad = 1; }
    if (sel r3.err)  { bad = 1; }
    if (sel r4.err)  { bad = 1; }
    if (sel r5.err)  { bad = 1; }
    if (sel r6.err)  { bad = 1; }
    if (sel r7.err)  { bad = 1; }
    if (sel r8.err)  { bad = 1; }
    if (sel r9.err)  { bad = 1; }
    if (sel r10.err) { bad = 1; }
    if (sel r11.err) { bad = 1; }
    if (sel r12.err) { bad = 1; }
    if (sel r13.err) { bad = 1; }
    if (sel r14.err) { bad = 1; }
    if (sel r15.err) { bad = 1; }
    if (sel r16.err) { bad = 1; }
    if (sel r17.err) { bad = 1; }

    if (read_word(?st.buf, 0)  != 0x10002573) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x10402573) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x10502573) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x14102573) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x14202573) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x14402573) { bad = 1; }
    if (read_word(?st.buf, 24) != 0x18002573) { bad = 1; }
    if (read_word(?st.buf, 28) != 0x30002573) { bad = 1; }
    if (read_word(?st.buf, 32) != 0x30402573) { bad = 1; }
    if (read_word(?st.buf, 36) != 0x30502573) { bad = 1; }
    if (read_word(?st.buf, 40) != 0x34102573) { bad = 1; }
    if (read_word(?st.buf, 44) != 0x34202573) { bad = 1; }
    if (read_word(?st.buf, 48) != 0x34402573) { bad = 1; }
    if (read_word(?st.buf, 52) != 0xF1402573) { bad = 1; }
    if (read_word(?st.buf, 56) != 0xC0002573) { bad = 1; }
    if (read_word(?st.buf, 60) != 0xC0102573) { bad = 1; }
    if (read_word(?st.buf, 64) != 0xC0202573) { bad = 1; }

    val settled: usize = st.buf.len;
    rv_asm_text(?st, ?f, ?labels, "csrr a0, MTVEC");
    rv_asm_text(?st, ?f, ?labels, "csrr a0, MtVeC");
    rv_asm_text(?st, ?f, ?labels, "csrr a0, 0xC01");
    if (read_word(?st.buf, settled)     != 0x30502573) { bad = 1; }
    if (read_word(?st.buf, settled + 4) != 0x30502573) { bad = 1; }
    if (read_word(?st.buf, settled + 8) != 0xC0102573) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:inline_asm_csr_refusals" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val nr: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, frobnicate");
    if (!sel nr.err) { bad = 1; }
    or (sel nr.err) { if (!str_contains(fail.describe(nr.err), "unsupported inline-asm CSR")) { bad = 1; } }

    val or_: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrr a0, 0x1000");
    if (!sel or_.err) { bad = 1; }
    or (sel or_.err) { if (!str_contains(fail.describe(or_.err), "unsupported inline-asm CSR")) { bad = 1; } }

    val ir: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrrwi a0, mstatus, 32");
    if (!sel ir.err) { bad = 1; }
    or (sel ir.err) { if (!str_contains(fail.describe(ir.err), "immediate must be 0-31")) { bad = 1; } }
    val iw: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrwi mstatus, 32");
    if (!sel iw.err) { bad = 1; }
    or (sel iw.err) { if (!str_contains(fail.describe(iw.err), "immediate must be 0-31")) { bad = 1; } }

    if (st.buf.len != 0) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:emit_asm_renders_csr" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = printer.test_sink_write;
    printer.test_sink_reset();
    var sink: encode.AsmSink = encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    val r1: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "csrrw a0, mstatus, a1");
    if (sel r1.err) { bad = 1; }
    val r2: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "rdtime a1");
    if (sel r2.err) { bad = 1; }

    if (encode.note_inst_count(?st.buf) * WORD_SIZE != st.buf.len::u32) { bad = 1; }

    val rr: err[fail.Fail] = printer.render_notes(?st.buf);
    if (sel rr.err) { bad = 1; }
    if (sel rr.ok) {
        val text: str = printer.test_sink_text();
        val ci: opt[usize] = str_index_of(text, "csrrw a0, 768, a1");
        val ti: opt[usize] = str_index_of(text, "csrrs a1, 3073, zero");
        if (sel ci.none) { ret 99; }
        if (sel ci.some) { if (sel ti.some) { if (ci.some >= ti.some) { bad = 1; } } }
    }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:asm_fields_classify_round_trip" {
    var bad: i32 = 0;
    var i: usize = 0;
    for (i < RV_MNEMONIC_COUNT) {
        val op: inst.MachOp = RV_MNEMONICS[i].code::inst.MachOp;
        var fmt: u8 = 0;
        var opcode: u32 = 0;
        var f3: u32 = 0;
        var f7: u32 = 0;
        if (!rv_fields(op, ?fmt, ?opcode, ?f3, ?f7)) { bad = 1; }
        or {
            var imm: u32 = 0;
            if (op == inst.SRAI || op == inst.SRAIW) { imm = 0x400; }
            or (op == inst.EBREAK)                   { imm = 1; }
            or (op == inst.PAUSE)                    { imm = 0x010; }
            or (op == inst.FENCE)                    { imm = 0xFF; }

            var back: inst.MachOp = inst.MOP_NONE;
            if (fmt == RVFMT_R)      { back = classify_r(opcode, f3, f7, 0); }
            or (fmt == RVFMT_I)      { back = classify_i(opcode, f3, imm); }
            or (fmt == RVFMT_S)      { back = classify_s(opcode, f3); }
            or (fmt == RVFMT_B)      { back = classify_b(opcode, f3); }
            or (fmt == RVFMT_U)      { back = classify_u(opcode); }
            or                       { back = classify_j(opcode); }
            if (back != op) { bad = 1; }
        }
        i = i + 1;
    }

    var op2: inst.MachOp = inst.LR_W;
    for (op2 <= inst.AMOMAXU_D) {
        var fmt: u8 = 0;
        var opcode: u32 = 0;
        var f3: u32 = 0;
        var f7: u32 = 0;
        if (!rv_fields(op2, ?fmt, ?opcode, ?f3, ?f7)) { bad = 1; }
        or { if (classify_r(opcode, f3, f7 | 0x3, 0) != op2) { bad = 1; } }
        op2 = op2 + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:asm_byte_accounting" {
    var bad: i32 = 0;
    var gp: u32 = 0;
    var fp: u32 = 0;

    asm_clobbers("fence rw, rw", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("addi a0, a1, 1 junk", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("  addi a0 , a1 , 1  ;  mv a2, a3  ", ?gp, ?fp);
    if (gp != ((1::u32 << 10) | (1::u32 << 12))) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:asm_relocation_modifiers" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val hr: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "auipc a0, %pcrel_hi(foo)");
    if (sel hr.err) { bad = 1; }
    val lr: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "addi a0, a0, %pcrel_lo(foo)");
    if (sel lr.err) { bad = 1; }
    if (read_word(?st.buf, 0) != 0x00000517) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00050513) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[1].kind != of.RK_PCREL_LO12_I) { bad = 1; }
    }

    val gr: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "auipc a0, %got_pcrel_hi(foo)");
    if (!sel gr.err) { bad = 1; }
    or (sel gr.err) { if (!str_contains(fail.describe(gr.err), "no GOT-relative relocation kind")) { bad = 1; } }

    val br: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, "auipc a0, %bogus(foo)");
    if (!sel br.err) { bad = 1; }
    or (sel br.err) { if (!str_contains(fail.describe(br.err), "unsupported riscv64 inline-asm relocation modifier")) { bad = 1; } }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    ret bad;
}

fun fp_op(idx: i32) mir.MirOperand {
    ret mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx)::u32);
}

fun t_words_match(st: *encode.EncodeState, want: *u32, n: u32) bool {
    if (st.buf.len != (n * 4)::usize) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        if (read_word(?st.buf, (i * 4)::usize) != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.target.isa.riscv.encode:divide_family" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10); ops[1] = mir.op_preg(11); ops[2] = mir.op_preg(12);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 8, 0);

    var sdiv64: [10]u32;
    sdiv64[0] = 0x00061463; sdiv64[1] = 0x00100073;
    sdiv64[2] = 0x00160293; sdiv64[3] = 0x00029C63; sdiv64[4] = 0x00100293; sdiv64[5] = 0x03F29293;
    sdiv64[6] = 0x405582B3; sdiv64[7] = 0x00029463; sdiv64[8] = 0x00100073;
    sdiv64[9] = 0x02C5C533;
    mi.opcode = mir.MIR_SEL_DIV_S; encode_divide(?st, ?mi);
    if (!t_words_match(?st, ?sdiv64[0], 10)) { bad = 1; }

    st.buf.len = 0;
    var udiv64: [3]u32;
    udiv64[0] = 0x00061463; udiv64[1] = 0x00100073; udiv64[2] = 0x02C5D533;
    mi.opcode = mir.MIR_SEL_DIV_U; encode_divide(?st, ?mi);
    if (!t_words_match(?st, ?udiv64[0], 3)) { bad = 2; }

    st.buf.len = 0;
    sdiv64[9] = 0x02C5E533;
    mi.opcode = mir.MIR_SEL_REM_S; encode_divide(?st, ?mi);
    if (!t_words_match(?st, ?sdiv64[0], 10)) { bad = 3; }

    st.buf.len = 0;
    udiv64[2] = 0x02C5F533;
    mi.opcode = mir.MIR_SEL_REM_U; encode_divide(?st, ?mi);
    if (!t_words_match(?st, ?udiv64[0], 3)) { bad = 4; }

    st.buf.len = 0; mi.width = 4;
    var sdiv32: [10]u32;
    sdiv32[0] = 0x0006029B; sdiv32[1] = 0x00029463; sdiv32[2] = 0x00100073;
    sdiv32[3] = 0x0016029B; sdiv32[4] = 0x00029A63; sdiv32[5] = 0x800002B7; sdiv32[6] = 0x405582BB;
    sdiv32[7] = 0x00029463; sdiv32[8] = 0x00100073;
    sdiv32[9] = 0x02C5C53B;
    mi.opcode = mir.MIR_SEL_DIV_S; encode_divide(?st, ?mi);
    if (!t_words_match(?st, ?sdiv32[0], 10)) { bad = 5; }

    st.buf.len = 0;
    sdiv32[9] = 0x02C5E53B;
    mi.opcode = mir.MIR_SEL_REM_S; encode_divide(?st, ?mi);
    if (!t_words_match(?st, ?sdiv32[0], 10)) { bad = 6; }

    st.buf.len = 0; mi.width = 8;
    ops[2] = mir.op_imm(0);
    mi.opcode = mir.MIR_SEL_DIV_U; encode_divide(?st, ?mi);
    if (st.buf.len < 8 || read_word(?st.buf, 0) != 0x00000293 || read_word(?st.buf, 4) != 0x00100073) { bad = 7; }

    st.buf.len = 0;
    ops[2] = mir.op_imm(7);
    mi.opcode = mir.MIR_SEL_DIV_S; encode_divide(?st, ?mi);
    if (st.buf.len != 8 || read_word(?st.buf, 0) != 0x00700293 || read_word(?st.buf, 4) != 0x0255C533) { bad = 8; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:integer_conversions" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(10); ops[1] = mir.op_preg(11);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 2, 0, 0);

    mi.opcode = mir.MIR_TRUNC; mi.width = 4; mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x0005851B) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_BITCAST; mi.width = 8; mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x00058513) { bad = 1; }
    mi.width = 4; mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 4) != 0x0005851B) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_SEXT; mi.width = 8; mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x0005851B) { bad = 1; }
    st.buf.len = 0; mi.src_width = 2;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x03059513) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x43055513) { bad = 1; }
    st.buf.len = 0; mi.src_width = 1;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x03859513) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x43855513) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_ZEXT; mi.width = 8; mi.src_width = 1;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x0FF5F513) { bad = 1; }
    st.buf.len = 0; mi.src_width = 2;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x03059513) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x03055513) { bad = 1; }
    st.buf.len = 0; mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x02059513) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x02055513) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:float_arith_neg_cmp" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = fp_op(10); ops[1] = fp_op(11); ops[2] = fp_op(12);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 8, 0);

    mi.opcode = mir.MIR_FADD; encode_fp_arith(?st, nil, ?mi);
    if (read_word(?st.buf, 0)  != 0x02C5F553) { bad = 1; }
    mi.opcode = mir.MIR_FSUB; encode_fp_arith(?st, nil, ?mi);
    if (read_word(?st.buf, 4)  != 0x0AC5F553) { bad = 1; }
    mi.opcode = mir.MIR_FMUL; encode_fp_arith(?st, nil, ?mi);
    if (read_word(?st.buf, 8)  != 0x12C5F553) { bad = 1; }
    mi.opcode = mir.MIR_FDIV; encode_fp_arith(?st, nil, ?mi);
    if (read_word(?st.buf, 12) != 0x1AC5F553) { bad = 1; }

    st.buf.len = 0; mi.width = 4;
    mi.opcode = mir.MIR_FADD; encode_fp_arith(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0x00C5F553) { bad = 1; }

    st.buf.len = 0; mi.width = 8; mi.operand_count = 2;
    mi.opcode = mir.MIR_FNEG; encode_fp_neg(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0x22B59553) { bad = 1; }

    st.buf.len = 0;
    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(10); cops[1] = fp_op(11); cops[2] = fp_op(12);
    var ci: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?cops[0], 3, 8, 0);
    ci.src_width = mir.FCC_EQ; encode_fp_cmp(?st, nil, ?ci);
    if (read_word(?st.buf, 0) != 0xA2C5A553) { bad = 1; }
    st.buf.len = 0; ci.src_width = mir.FCC_LT; encode_fp_cmp(?st, nil, ?ci);
    if (read_word(?st.buf, 0) != 0xA2C59553) { bad = 1; }
    st.buf.len = 0; ci.src_width = mir.FCC_LE; encode_fp_cmp(?st, nil, ?ci);
    if (read_word(?st.buf, 0) != 0xA2C58553) { bad = 1; }
    st.buf.len = 0; ci.src_width = mir.FCC_NE; encode_fp_cmp(?st, nil, ?ci);
    if (read_word(?st.buf, 0) != 0xA2C5A553) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x00154513) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:float_conversions" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [2]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 2, 0, 0);

    ops[0] = fp_op(10); ops[1] = fp_op(11);
    mi.opcode = mir.MIR_FP_TRUNC; mi.width = 4; mi.src_width = 8;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0x4015F553) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_FP_EXT; mi.width = 8; mi.src_width = 4;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0x42058553) { bad = 1; }

    st.buf.len = 0;
    ops[0] = fp_op(10); ops[1] = mir.op_preg(11);
    mi.opcode = mir.MIR_SI_TO_FP; mi.width = 8; mi.src_width = 8;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xD225F553) { bad = 1; }
    st.buf.len = 0; mi.src_width = 4;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xD2058553) { bad = 1; }

    st.buf.len = 0;
    ops[0] = mir.op_preg(10); ops[1] = fp_op(11);
    mi.opcode = mir.MIR_FP_TO_SI; mi.width = 8; mi.src_width = 8;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xC2259553) { bad = 1; }
    st.buf.len = 0; mi.width = 4;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xC2059553) { bad = 1; }

    st.buf.len = 0;
    mi.opcode = mir.MIR_FP_TO_UI; mi.width = 8; mi.src_width = 8;
    encode_fp_conv(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xC2359553) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:fmov_and_float_memory" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [2]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 0);

    ops[0] = fp_op(10); ops[1] = fp_op(11);
    encode_fmov(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0x22B58553) { bad = 1; }

    st.buf.len = 0;
    ops[0] = fp_op(10); ops[1] = mir.op_preg(11);
    encode_fmov(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xF2058553) { bad = 1; }

    st.buf.len = 0;
    ops[0] = mir.op_preg(10); ops[1] = fp_op(11);
    encode_fmov(?st, nil, ?mi);
    if (read_word(?st.buf, 0) != 0xE2058553) { bad = 1; }

    var mw: mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 4, 0);

    st.buf.len = 0;
    ops[0] = fp_op(10); ops[1] = fp_op(11);
    encode_fmov(?st, nil, ?mw);
    if (read_word(?st.buf, 0) != 0x20B58553) { bad = 1; }

    st.buf.len = 0;
    ops[0] = fp_op(10); ops[1] = mir.op_preg(11);
    encode_fmov(?st, nil, ?mw);
    if (read_word(?st.buf, 0) != 0xF0058553) { bad = 1; }

    st.buf.len = 0;
    ops[0] = mir.op_preg(10); ops[1] = fp_op(11);
    encode_fmov(?st, nil, ?mw);
    if (read_word(?st.buf, 0) != 0xE0058553) { bad = 1; }

    st.buf.len = 0;
    emit_fp_mem(?st, 10, 11, 16, 8, true);
    emit_fp_mem(?st, 10, 11, 16, 8, false);
    emit_fp_mem(?st, 10, 11, 16, 4, true);
    emit_fp_mem(?st, 10, 11, 16, 4, false);
    if (read_word(?st.buf, 0)  != 0x0105B507) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x00A5B827) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x0105A507) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x00A5A827) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_refused(r: err[fail.Fail], buf: *encode.ByteBuf) bool {
    if (!sel r.err) { ret false; }
    ret buf.len == 0;
}

fun t_accepted(r: err[fail.Fail], buf: *encode.ByteBuf) bool {
    if (sel r.err) { ret false; }
    ret buf.len > 0;
}

test "mach.lang.target.isa.riscv.encode:access_width_refusals_emit_nothing" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;

    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 16, 16, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 16, 16, false), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 16, 32, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 16, 1, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 16, 2, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 16, 0, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 10, 11, 100000, 16, true), ?st.buf)) { bad = 1; }

    st.buf.len = 0;
    if (!t_accepted(emit_fp_mem(?st, 10, 11, 16, 4, true), ?st.buf)) { bad = 1; }
    if (read_word(?st.buf, 0) != 0x0105A507) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 10, 11, 16, 8, true);
    if (read_word(?st.buf, 0) != 0x0105B507) { bad = 1; }

    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 10, 11, 0, 16, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 10, 11, 0, 16, false), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 10, 11, 0, 3, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 10, 11, 0, 32, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 10, 11, 100000, 16, true), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 10, 11, 0, 1, true);
    if (read_word(?st.buf, 0) != 0x0005C503) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 10, 11, 0, 2, true);
    if (read_word(?st.buf, 0) != 0x0005D503) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 10, 11, 0, 4, true);
    if (read_word(?st.buf, 0) != 0x0005A503) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 10, 11, 0, 8, true);
    if (read_word(?st.buf, 0) != 0x0005B503) { bad = 1; }

    var lops: [2]mir.MirOperand;
    lops[0] = fp_op(10);
    lops[1] = mir.op_mem_preg(11, 0);
    var ld: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?lops[0], 2, 16, 0);
    ld.src_width = 16; st.buf.len = 0;
    if (!t_refused(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }
    ld.width = 8; ld.src_width = 8; st.buf.len = 0;
    if (!t_accepted(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }

    var sops: [2]mir.MirOperand;
    sops[0] = mir.op_mem_preg(11, 0);
    sops[1] = fp_op(10);
    st.buf.len = 0;
    if (!t_refused(emit_store_mem(?st, ?f, ?sops[0], ?sops[1], 16), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_accepted(emit_store_mem(?st, ?f, ?sops[0], ?sops[1], 8), ?st.buf)) { bad = 1; }

    var sym: mir.MirOperand = mir.op_preg(0);
    sym.kind = mir.MIR_OP_SYM;
    sym.sym  = 1;
    var gv: mir.MirOperand = mir.op_preg(10);
    st.buf.len = 0;
    if (!t_refused(emit_global_load(?st, 10, ?sym, 16), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_global_store(?st, ?sym, ?gv, 16), ?st.buf)) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode:float_width_refusals_emit_nothing" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = fp_op(10); ops[1] = fp_op(11); ops[2] = fp_op(12);

    var mv: mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 16, 0);
    st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 12; st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 32; st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 0;  st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 1;  st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }

    mv.width = 4; st.buf.len = 0;
    if (!t_accepted(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fmov(?st, nil, ?mv), ?st.buf)) { bad = 1; }

    var ar: mir.MirInstr = mir.instr(mir.MIR_FADD, ?ops[0], 3, 16, 0);
    st.buf.len = 0;
    if (!t_refused(encode_fp_arith(?st, nil, ?ar), ?st.buf)) { bad = 1; }
    ar.width = 4; st.buf.len = 0;
    if (!t_accepted(encode_fp_arith(?st, nil, ?ar), ?st.buf)) { bad = 1; }

    var ng: mir.MirInstr = mir.instr(mir.MIR_FNEG, ?ops[0], 2, 16, 0);
    st.buf.len = 0;
    if (!t_refused(encode_fp_neg(?st, nil, ?ng), ?st.buf)) { bad = 1; }
    ng.width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_neg(?st, nil, ?ng), ?st.buf)) { bad = 1; }

    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(10); cops[1] = fp_op(11); cops[2] = fp_op(12);
    var cm: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?cops[0], 3, 16, mir.FCC_EQ);
    cm.src_width = mir.FCC_EQ;
    st.buf.len = 0;
    if (!t_refused(encode_fp_cmp(?st, nil, ?cm), ?st.buf)) { bad = 1; }
    cm.width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_cmp(?st, nil, ?cm), ?st.buf)) { bad = 1; }

    var cv: mir.MirInstr = mir.instr(mir.MIR_FP_TRUNC, ?ops[0], 2, 16, 0);
    cv.src_width = 8;
    st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, nil, ?cv), ?st.buf)) { bad = 1; }
    cv.width = 4; cv.src_width = 16; st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, nil, ?cv), ?st.buf)) { bad = 1; }
    cv.width = 4; cv.src_width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_conv(?st, nil, ?cv), ?st.buf)) { bad = 1; }

    var i2f: mir.MirInstr = mir.instr(mir.MIR_SI_TO_FP, ?ops[0], 2, 16, 0);
    ops[0] = fp_op(10); ops[1] = mir.op_preg(11);
    i2f.src_width = 8;
    st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, nil, ?i2f), ?st.buf)) { bad = 1; }
    i2f.width = 8; i2f.src_width = 1; st.buf.len = 0;
    if (!t_accepted(encode_fp_conv(?st, nil, ?i2f), ?st.buf)) { bad = 1; }

    var f2i: mir.MirInstr = mir.instr(mir.MIR_FP_TO_SI, ?ops[0], 2, 8, 0);
    ops[0] = mir.op_preg(10); ops[1] = fp_op(11);
    f2i.src_width = 16;
    st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, nil, ?f2i), ?st.buf)) { bad = 1; }
    f2i.width = 1; f2i.src_width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_conv(?st, nil, ?f2i), ?st.buf)) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_f3(r: res[u32, fail.Fail]) u32 {
    if (sel r.err) { ret 0xFFFFFFFF; }
    ret r.ok;
}

fun t_fcmp(cc: u8, funct3: u32, swap: bool, invert: bool) bool {
    var got_f3: u32  = 0xFFFFFFFF;
    var got_sw: bool = false;
    var got_iv: bool = false;
    val r: err[fail.Fail] = fp_cmp_relation(cc, ?got_f3, ?got_sw, ?got_iv);
    if (sel r.err) { ret false; }
    ret got_f3 == funct3 && got_sw == swap && got_iv == invert;
}

test "mach.lang.target.isa.riscv.encode:classifiers_are_total_over_named_forms" {
    var bad: i32 = 0;
    var swap: bool = false;

    if (t_f3(fused_cbr_funct3(mir.MIR_SEL_CBR_EQ,   ?swap)) != F3_BEQ)  { bad = 1; }
    if (swap)                                                          { bad = 1; }
    if (t_f3(fused_cbr_funct3(mir.MIR_SEL_CBR_NE,   ?swap)) != F3_BNE)  { bad = 1; }
    if (swap)                                                          { bad = 1; }
    if (t_f3(fused_cbr_funct3(mir.MIR_SEL_CBR_LT_S, ?swap)) != F3_BLT)  { bad = 1; }
    if (swap)                                                          { bad = 1; }
    if (t_f3(fused_cbr_funct3(mir.MIR_SEL_CBR_LT_U, ?swap)) != F3_BLTU) { bad = 1; }
    if (swap)                                                          { bad = 1; }
    if (t_f3(fused_cbr_funct3(mir.MIR_SEL_CBR_LE_S, ?swap)) != F3_BGE)  { bad = 1; }
    if (!swap)                                                         { bad = 1; }
    if (t_f3(fused_cbr_funct3(mir.MIR_SEL_CBR_LE_U, ?swap)) != F3_BGEU) { bad = 1; }
    if (!swap)                                                         { bad = 1; }

    if (t_f3(divide_funct3(mir.MIR_SEL_DIV_S)) != F3_DIV)  { bad = 1; }
    if (t_f3(divide_funct3(mir.MIR_SEL_DIV_U)) != F3_DIVU) { bad = 1; }
    if (t_f3(divide_funct3(mir.MIR_SEL_REM_S)) != F3_REM)  { bad = 1; }
    if (t_f3(divide_funct3(mir.MIR_SEL_REM_U)) != F3_REMU) { bad = 1; }

    if (t_f3(fp_arith_funct7(mir.MIR_FADD, false)) != F7_FADD)     { bad = 1; }
    if (t_f3(fp_arith_funct7(mir.MIR_FSUB, false)) != F7_FSUB)     { bad = 1; }
    if (t_f3(fp_arith_funct7(mir.MIR_FMUL, false)) != F7_FMUL)     { bad = 1; }
    if (t_f3(fp_arith_funct7(mir.MIR_FDIV, false)) != F7_FDIV)     { bad = 1; }
    if (t_f3(fp_arith_funct7(mir.MIR_FADD, true))  != (F7_FADD | 1)) { bad = 1; }
    if (t_f3(fp_arith_funct7(mir.MIR_FDIV, true))  != (F7_FDIV | 1)) { bad = 1; }

    if (!t_fcmp(mir.FCC_EQ, F3_FEQ, false, false)) { bad = 1; }
    if (!t_fcmp(mir.FCC_NE, F3_FEQ, false, true))  { bad = 1; }
    if (!t_fcmp(mir.FCC_LT, F3_FLT, false, false)) { bad = 1; }
    if (!t_fcmp(mir.FCC_LE, F3_FLE, false, false)) { bad = 1; }
    if (!t_fcmp(mir.FCC_GT, F3_FLT, true,  false)) { bad = 1; }
    if (!t_fcmp(mir.FCC_GE, F3_FLE, true,  false)) { bad = 1; }

    if (t_f3(scale_shift(1)) != 0) { bad = 1; }
    if (t_f3(scale_shift(2)) != 1) { bad = 1; }
    if (t_f3(scale_shift(4)) != 2) { bad = 1; }
    if (t_f3(scale_shift(8)) != 3) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode:unnamed_forms_are_refused" {
    var bad: i32 = 0;
    var swap: bool = false;

    val r_5931: res[u32, fail.Fail] = fused_cbr_funct3(mir.MIR_ADD, ?swap);
    if (!sel r_5931.err) { bad = 1; }
    val r_5932: res[u32, fail.Fail] = fused_cbr_funct3(mir.MIR_SEL_CBR_LE_U + 1, ?swap);
    if (!sel r_5932.err) { bad = 1; }
    val r_5933: res[u32, fail.Fail] = divide_funct3(mir.MIR_ADD);
    if (!sel r_5933.err) { bad = 1; }
    val r_5934: res[u32, fail.Fail] = divide_funct3(mir.MIR_MUL);
    if (!sel r_5934.err) { bad = 1; }
    val r_5935: res[u32, fail.Fail] = fp_arith_funct7(mir.MIR_ADD, false);
    if (!sel r_5935.err) { bad = 1; }
    val r_5936: res[u32, fail.Fail] = fp_arith_funct7(mir.MIR_FNEG, true);
    if (!sel r_5936.err) { bad = 1; }

    var funct3: u32 = 0;
    var sw: bool = false;
    var inv: bool = false;
    val r_5941: err[fail.Fail] = fp_cmp_relation(mir.FCC_GE + 1, ?funct3, ?sw, ?inv);
    if (!sel r_5941.err) { bad = 1; }
    val r_5942: err[fail.Fail] = fp_cmp_relation(200, ?funct3, ?sw, ?inv);
    if (!sel r_5942.err) { bad = 1; }

    val r_5944: res[u32, fail.Fail] = scale_shift(0);
    if (!sel r_5944.err) { bad = 1; }
    val r_5945: res[u32, fail.Fail] = scale_shift(3);
    if (!sel r_5945.err) { bad = 1; }
    val r_5946: res[u32, fail.Fail] = scale_shift(16);
    if (!sel r_5946.err) { bad = 1; }

    ret bad;
}

pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code == inst.DIV::u32   || code == inst.DIVU::u32 || code == inst.DIVW::u32 ||
        code == inst.DIVUW::u32 || code == inst.REM::u32  || code == inst.REMU::u32 ||
        code == inst.REMW::u32  || code == inst.REMUW::u32) {
        ret ct.asm_op(ct.CT_OP_INT_DIVMOD);
    }
    if (code == inst.MUL::u32   || code == inst.MULH::u32 || code == inst.MULHSU::u32 ||
        code == inst.MULHU::u32 || code == inst.MULW::u32) {
        ret ct.asm_op(ct.CT_OP_INT_MUL);
    }
    if (code == inst.SLL::u32  || code == inst.SRL::u32  || code == inst.SRA::u32 ||
        code == inst.SLLW::u32 || code == inst.SRLW::u32 || code == inst.SRAW::u32) {
        ret ct.asm_op(ct.CT_OP_VAR_SHIFT);
    }
    if (code == inst.SLLI::u32  || code == inst.SRLI::u32  || code == inst.SRAI::u32 ||
        code == inst.SLLIW::u32 || code == inst.SRLIW::u32 || code == inst.SRAIW::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.ADD::u32   || code == inst.ADDI::u32 || code == inst.ADDW::u32 ||
        code == inst.ADDIW::u32 || code == inst.SUB::u32  || code == inst.SUBW::u32 ||
        code == inst.AND::u32   || code == inst.ANDI::u32 || code == inst.OR::u32 ||
        code == inst.ORI::u32   || code == inst.XOR::u32  || code == inst.XORI::u32 ||
        code == inst.SLT::u32   || code == inst.SLTU::u32 || code == inst.SLTI::u32 ||
        code == inst.SLTIU::u32 || code == inst.LUI::u32  || code == inst.AUIPC::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.LB::u32  || code == inst.LBU::u32 || code == inst.LH::u32 ||
        code == inst.LHU::u32 || code == inst.LW::u32  || code == inst.LWU::u32 ||
        code == inst.LD::u32  || code == inst.SB::u32  || code == inst.SH::u32 ||
        code == inst.SW::u32  || code == inst.SD::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.LR_W::u32      || code == inst.LR_D::u32      ||
        code == inst.SC_W::u32      || code == inst.SC_D::u32      ||
        code == inst.AMOSWAP_W::u32 || code == inst.AMOSWAP_D::u32 ||
        code == inst.AMOADD_W::u32  || code == inst.AMOADD_D::u32  ||
        code == inst.AMOXOR_W::u32  || code == inst.AMOXOR_D::u32  ||
        code == inst.AMOAND_W::u32  || code == inst.AMOAND_D::u32  ||
        code == inst.AMOOR_W::u32   || code == inst.AMOOR_D::u32   ||
        code == inst.AMOMIN_W::u32  || code == inst.AMOMIN_D::u32  ||
        code == inst.AMOMAX_W::u32  || code == inst.AMOMAX_D::u32  ||
        code == inst.AMOMINU_W::u32 || code == inst.AMOMINU_D::u32 ||
        code == inst.AMOMAXU_W::u32 || code == inst.AMOMAXU_D::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }

    if (code == inst.FENCE::u32 || code == inst.PAUSE::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.JAL::u32   ||
        code == inst.ECALL::u32 || code == inst.EBREAK::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.CSRRW::u32  || code == inst.CSRRS::u32  || code == inst.CSRRC::u32 ||
        code == inst.CSRRWI::u32 || code == inst.CSRRSI::u32 || code == inst.CSRRCI::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.BEQ::u32 || code == inst.BNE::u32  || code == inst.BLT::u32 ||
        code == inst.BGE::u32 || code == inst.BLTU::u32 || code == inst.BGEU::u32 ||
        code == inst.JALR::u32) {
        ret ct.asm_branch_reg();
    }

    # rows for the opcodes the encoder emits that the inline-asm grammar has
    # no spelling for: the F and D sets. loads, stores, bit moves and the
    # sign-copy move are data movement; arithmetic, compares, the negating
    # and absolute sign injections (MIR_FNEG is float-classed) and every
    # conversion are floating-point operations
    if (code == inst.FLW::u32 || code == inst.FLD::u32 || code == inst.FSW::u32 || code == inst.FSD::u32 ||
        code == inst.FMV_X_W::u32 || code == inst.FMV_X_D::u32 || code == inst.FMV_W_X::u32 || code == inst.FMV_D_X::u32 ||
        code == inst.FSGNJ_S::u32 || code == inst.FSGNJ_D::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == inst.FADD_S::u32 || code == inst.FADD_D::u32 || code == inst.FSUB_S::u32 || code == inst.FSUB_D::u32 ||
        code == inst.FMUL_S::u32 || code == inst.FMUL_D::u32 || code == inst.FDIV_S::u32 || code == inst.FDIV_D::u32 ||
        code == inst.FSGNJN_S::u32 || code == inst.FSGNJN_D::u32 || code == inst.FSGNJX_S::u32 || code == inst.FSGNJX_D::u32 ||
        code == inst.FEQ_S::u32 || code == inst.FEQ_D::u32 || code == inst.FLT_S::u32 || code == inst.FLT_D::u32 ||
        code == inst.FLE_S::u32 || code == inst.FLE_D::u32 ||
        code == inst.FCVT_S_D::u32 || code == inst.FCVT_D_S::u32 ||
        code == inst.FCVT_W_S::u32 || code == inst.FCVT_WU_S::u32 || code == inst.FCVT_L_S::u32 || code == inst.FCVT_LU_S::u32 ||
        code == inst.FCVT_W_D::u32 || code == inst.FCVT_WU_D::u32 || code == inst.FCVT_L_D::u32 || code == inst.FCVT_LU_D::u32 ||
        code == inst.FCVT_S_W::u32 || code == inst.FCVT_S_WU::u32 || code == inst.FCVT_S_L::u32 || code == inst.FCVT_S_LU::u32 ||
        code == inst.FCVT_D_W::u32 || code == inst.FCVT_D_WU::u32 || code == inst.FCVT_D_L::u32 || code == inst.FCVT_D_LU::u32) {
        ret ct.asm_op(ct.CT_OP_FLOAT);
    }
    ret ct.asm_unknown();
}

fun rv_grammar_implicit(code: u32) u32 {
    var i: usize = 0;
    for (i < RV_MNEMONIC_COUNT) {
        if (RV_MNEMONICS[i].code == code) { ret RV_MNEMONICS[i].implicit; }
        i = i + 1;
    }
    ret 0;
}

fun rv_target(mi: *isa.Inst, t: *isa.Operand, e: *ct.InstEffects) {
    if (t.kind == isa.OPK_SYM) { e.target = ct.TARGET_EXTERNAL; ret; }
    if (t.kind == isa.OPK_LABEL) {
        if ((mi.flags & (inst.FLAG_LABEL_SKIP | inst.FLAG_LABEL_LOCAL)) == 0 && isa.label_is_block(t)) {
            e.target = ct.TARGET_BLOCK;
            e.target_block = t.imm::u32;
            ret;
        }
        # a skip lies ahead by construction; a numbered label says which way it lies
        e.target = ct.TARGET_LOCAL;
        if ((mi.flags & inst.FLAG_LABEL_SKIP) != 0 && t.imm > 0) { e.target = ct.TARGET_LOCAL_FWD; e.local_disp = t.imm::i32; }
        if ((mi.flags & inst.FLAG_LABEL_LOCAL) != 0 && (mi.flags & inst.FLAG_LABEL_FWD) != 0) { e.target = ct.TARGET_LOCAL_FWD; }
        ret;
    }
    e.target = ct.TARGET_LOCAL;
}

# the effect description of one emitted riscv64 instruction: the closed class
# row plus the operand roles of the notification shape (build_inst) and the
# implicit effects. x0 is never written; the walk holds it constant
pub fun inst_effects(mi: *isa.Inst, e: *ct.InstEffects) {
    @e = ct.inst_effects_unknown();
    val op: inst.MachOp = mi.opcode::inst.MachOp;
    if (op == inst.MOP_NONE || op > inst.MOP_LAST) { ret; }
    e.cls = asm_ct_class(op::u32, 0);
    val shape: u8 = shape_of(op);

    if (op == inst.JALR) {
        # the target register rides in the load-shaped memory operand; it is
        # read as a value, never as an address
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_ADDR;
        e.target   = ct.TARGET_REGISTER;
        e.xfer     = ct.XFER_JUMP;
        val rd: i32 = rv_gp_index(?mi.dst);
        val rs: i32 = rv_gp_index(?mi.src1);
        if (rd == riscv.RA) { e.xfer = ct.XFER_CALL; }
        or (rd == riscv.ZERO && rs == riscv.RA && mi.src1.disp == 0) { e.xfer = ct.XFER_RET; }
        or ((mi.flags & inst.FLAG_TARGET_BLOCK) != 0) {
            # a relaxation trampoline: auipc t0 then jalr through t0 to a known block
            e.target       = ct.TARGET_BLOCK;
            e.target_block = mi.src1.imm::u32;
        }
        ret;
    }
    if (op == inst.JAL) {
        e.roles[0] = ct.ROLE_WRITE;
        e.xfer     = ct.XFER_JUMP;
        if (mi.dst.kind == isa.OPK_REG && isa.regid_index(mi.dst.reg) == riscv.RA) { e.xfer = ct.XFER_CALL; }
        rv_target(mi, ?mi.src1, e);
        ret;
    }
    if (shape == SH_BRANCH) {
        e.roles[0] = ct.ROLE_READ;
        e.roles[1] = ct.ROLE_READ;
        e.xfer     = ct.XFER_BRANCH;
        rv_target(mi, ?mi.src2, e);
        ret;
    }
    if (op == inst.EBREAK) { e.xfer = ct.XFER_TRAP; ret; }
    if (op == inst.ECALL) {
        val implicit: u64 = rv_grammar_implicit(op::u32)::u64;
        e.implicit_reads  = implicit;
        e.implicit_writes = implicit;
        ret;
    }
    if (shape == SH_NONE) { ret; }
    if (shape == SH_STORE || shape == SH_FSTORE) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_READ;
        ret;
    }
    if (shape == SH_AMO) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_READ;
        e.roles[2] = ct.ROLE_RW;
        if (op == inst.SC_W || op == inst.SC_D) { e.roles[2] = ct.ROLE_WRITE; }
        ret;
    }
    if (shape == SH_CSR) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[2] = ct.ROLE_READ;
        ret;
    }
    if (shape == SH_CSR_I) { e.roles[0] = ct.ROLE_WRITE; ret; }
    if (op == inst.SLL || op == inst.SRL || op == inst.SRA || op == inst.SLLW || op == inst.SRLW || op == inst.SRAW) {
        e.count_pos = 2;
    }
    # every remaining shape defines rd from its sources (RRR, RRI, RU, loads, the F and D forms)
    e.roles[0] = ct.ROLE_WRITE;
    if (rv_value_operand(?mi.src1)) { e.roles[1] = ct.ROLE_READ; }
    if (rv_value_operand(?mi.src2)) { e.roles[2] = ct.ROLE_READ; }
}

fun rv_gp_index(op: *isa.Operand) i32 {
    if (op.kind == isa.OPK_REG) { ret isa.regid_index(op.reg); }
    if (op.kind == isa.OPK_MEM) { ret isa.regid_index(op.base); }
    ret -1;
}

fun rv_value_operand(op: *isa.Operand) bool {
    ret op.kind == isa.OPK_REG || op.kind == isa.OPK_MEM;
}

test "mach.lang.target.isa.riscv.encode.asm_ct_scan:a_spill_does_not_launder_a_secret" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val addr: str = "ld a0, {r}\nsd a0, 0(sp)\nld a1, 0(sp)\nld a2, 0(a1)";
    val r_6161: err[fail.Fail] = asm_ct_scan(addr, ?names[0], 1, false, false, ?alloc);
    if (!sel r_6161.err) { bad = bad + 1; }
    val r_6162: err[fail.Fail] = asm_ct_scan(addr, ?names[0], 0, false, false, ?alloc);
    if (sel r_6162.err) { bad = bad + 2; }

    val lat: str = "ld a0, {r}\nsd a0, 0(sp)\nld a1, 0(sp)\ndiv a2, a3, a1";
    val r_6165: err[fail.Fail] = asm_ct_scan(lat, ?names[0], 1, false, false, ?alloc);
    if (!sel r_6165.err) { bad = bad + 4; }
    val r_6166: err[fail.Fail] = asm_ct_scan(lat, ?names[0], 0, false, false, ?alloc);
    if (sel r_6166.err) { bad = bad + 8; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode.asm_ct_class:indirect_transfers_are_register_conditioned" {
    var bad: i32 = 0;

    if (!asm_ct_class(inst.JALR::u32, 0).cond_reg) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode.asm_ct_scan:register_indirect_transfer_on_secret_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var names: [1]str;
    names[0] = "r";

    val jrt: str = "ld a1, {r}\njr a1";
    val r_6188: err[fail.Fail] = asm_ct_scan(jrt, ?names[0], 1, false, false, ?alloc);
    if (!sel r_6188.err) { ret 1; }
    val r_6189: err[fail.Fail] = asm_ct_scan(jrt, ?names[0], 0, false, false, ?alloc);
    if (sel r_6189.err) { ret 2; }

    val jalrt: str = "ld a1, {r}\njalr ra, a1, 0";
    val r_6192: err[fail.Fail] = asm_ct_scan(jalrt, ?names[0], 1, false, false, ?alloc);
    if (!sel r_6192.err) { ret 3; }
    val r_6193: err[fail.Fail] = asm_ct_scan(jalrt, ?names[0], 0, false, false, ?alloc);
    if (sel r_6193.err) { ret 4; }

    val rett: str = "ld ra, {r}\nret";
    val r_6196: err[fail.Fail] = asm_ct_scan(rett, ?names[0], 1, false, false, ?alloc);
    if (!sel r_6196.err) { ret 5; }
    val r_6197: err[fail.Fail] = asm_ct_scan(rett, ?names[0], 0, false, false, ?alloc);
    if (sel r_6197.err) { ret 6; }

    val pubjr: str = "li a1, 5\njr a1";
    val r_6200: err[fail.Fail] = asm_ct_scan(pubjr, ?names[0], 1, false, false, ?alloc);
    if (sel r_6200.err) { ret 7; }

    val ordinaryret: str = "ld a0, {r}\nret";
    val r_6203: err[fail.Fail] = asm_ct_scan(ordinaryret, ?names[0], 1, false, false, ?alloc);
    if (sel r_6203.err) { ret 8; }

    val direct: str = "j 1f\n1:";
    val r_6206: err[fail.Fail] = asm_ct_scan(direct, ?names[0], 1, false, false, ?alloc);
    if (sel r_6206.err) { ret 9; }

    ret 0;
}

test "mach.lang.target.isa.riscv.encode.asm_ct_class:every_grammar_row_is_classified" {
    var bad: i32 = 0;
    var i: usize = 0;
    for (i < RV_MNEMONIC_COUNT) {
        if (!asm_ct_class(RV_MNEMONICS[i].code, RV_MNEMONICS[i].flags).known) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.riscv.encode.asm_ct_class:m_extension_is_variable_latency" {
    var bad: i32 = 0;

    if (asm_ct_class(inst.DIV::u32, 0).op   != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.DIVU::u32, 0).op  != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.DIVW::u32, 0).op  != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.DIVUW::u32, 0).op != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.REM::u32, 0).op   != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.REMU::u32, 0).op  != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.REMW::u32, 0).op  != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (asm_ct_class(inst.REMUW::u32, 0).op != ct.CT_OP_INT_DIVMOD) { bad = 1; }
    if (ct.ct_cap_or_always(ct.CT_OP_INT_DIVMOD)   != ct.CT_CAP_ALWAYS)    { bad = 1; }

    if (asm_ct_class(inst.MUL::u32, 0).op    != ct.CT_OP_INT_MUL) { bad = 1; }
    if (asm_ct_class(inst.MULH::u32, 0).op   != ct.CT_OP_INT_MUL) { bad = 1; }
    if (asm_ct_class(inst.MULHSU::u32, 0).op != ct.CT_OP_INT_MUL) { bad = 1; }
    if (asm_ct_class(inst.MULHU::u32, 0).op  != ct.CT_OP_INT_MUL) { bad = 1; }
    if (asm_ct_class(inst.MULW::u32, 0).op   != ct.CT_OP_INT_MUL) { bad = 1; }
    if (ct.ct_cap_or_always(ct.CT_OP_INT_MUL)       != ct.CT_CAP_MUL)    { bad = 1; }

    if (asm_ct_class(inst.SLL::u32, 0).op  != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(inst.SRA::u32, 0).op  != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(inst.SLLI::u32, 0).op != ct.CT_OP_NONE)      { bad = 1; }
    if (asm_ct_class(inst.SRAI::u32, 0).op != ct.CT_OP_NONE)      { bad = 1; }

    if (!asm_ct_class(inst.BEQ::u32, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(inst.BNE::u32, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(inst.BLTU::u32, 0).cond_reg) { bad = 1; }
    var i: usize = 0;
    for (i < RV_MNEMONIC_COUNT) {
        if (asm_ct_class(RV_MNEMONICS[i].code, RV_MNEMONICS[i].flags).cond_flags) { bad = 1; }
        i = i + 1;
    }

    var fi: usize = 0;
    for (fi < RV_MNEMONIC_COUNT) {
        val fc: ct.AsmClass = asm_ct_class(RV_MNEMONICS[fi].code, RV_MNEMONICS[fi].flags);
        if (fc.reads_flags)   { bad = 1; }
        if (fc.defines_flags) { bad = 1; }
        if (fc.opaque_flags)  { bad = 1; }
        fi = fi + 1;
    }
    ret bad;
}

pub fun asm_ct_scan(body: str, secret_names: *str, n_secret: u32,
                    trust_mul: bool, trust_shift: bool, alloc: *A.Allocator) err[fail.Fail] {
    var g: iasm.Grammar = rv_grammar_analysis();
    ret iasm.ct_scan(?g, body, secret_names, n_secret, trust_mul, trust_shift);
}

test "mach.lang.target.isa.riscv.encode.asm_ct_class:decode_channel_is_classified" {
    var bad: i32 = 0;

    var bases: [11]str;
    bases[0] = "lr";      bases[1] = "sc";       bases[2] = "amoswap";
    bases[3] = "amoadd";  bases[4] = "amoxor";   bases[5] = "amoand";
    bases[6] = "amoor";   bases[7] = "amominu";  bases[8] = "amomaxu";
    bases[9] = "amomin";  bases[10] = "amomax";

    var sfx: [8]str;
    sfx[0] = ".w";       sfx[1] = ".d";
    sfx[2] = ".w.aq";    sfx[3] = ".d.aq";
    sfx[4] = ".w.rl";    sfx[5] = ".d.rl";
    sfx[6] = ".w.aqrl";  sfx[7] = ".d.aqrl";

    var accepted: u32 = 0;
    var i: usize = 0;
    for (i < 11) {
        var j: usize = 0;
        for (j < 8) {
            var buf: [32]u8;
            val n1: usize = t_copy_str(?buf[0], 0, bases[i]);
            val n2: usize = t_copy_str(?buf[0], n1, sfx[j]);
            buf[n2] = 0;
            val body: str = (?buf[0])::str;

            var m: iasm.Mnemonic;
            var used: usize = 0;
            if (rv_decode_amo(body, 0, n2, ?m, ?used)) {
                accepted = accepted + 1;
                if (!asm_ct_class(m.code, m.flags).known) { bad = 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    if (accepted != 88) { bad = 1; }
    ret bad;
}

fun t_copy_str(dst: *u8, at: usize, s: str) usize {
    var i: usize = 0;
    for (s[i] != 0) { dst[at + i] = s[i]; i = i + 1; }
    ret at + i;
}

fun asm_note_bytes(st: *encode.EncodeState, bytes: *u8, n: usize, start: usize) err[fail.Fail] {
    var note: encode.AsmNote = encode.note_blank();
    note.kind = encode.ASM_NOTE_BYTES;
    note.off  = start::u32;
    var j: usize = 0;
    for (j < n) {
        note.bytes[j] = bytes[j];
        j = j + 1;
    }
    val r_6328: err[fail.Fail] = encode.note_push(?st.buf, ?note);
    if (sel r_6328.err) { ret err[fail.Fail].err{r_6328.err}; }
    ret err[fail.Fail].ok{};
}

test "mach.lang.target.isa.riscv.encode:float_constant_materialization" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);

    var probe: [6]i64;
    probe[0] = 7;
    probe[1] = 0x12345000;
    probe[2] = 0x12345678;
    probe[3] = 0x4000000000000000;
    probe[4] = 0x3FB999999999999A;
    probe[5] = 0x3FC0000000000000;
    var pi: u32 = 0;
    for (pi < 6) {
        st.buf.len = 0;
        emit_li(?st, SCRATCH, probe[pi]);
        if ((st.buf.len / 4)::u32 != li_words(probe[pi])) { bad = 1; }
        pi = pi + 1;
    }

    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 0);

    ops[0] = fp_op(10); ops[1] = mir.op_imm(0);
    st.buf.len = 0;
    encode_fmov(?st, nil, ?mi);
    if (st.buf.len != 4)                     { bad = 1; }
    if (read_word(?st.buf, 0) != 0xF2000553) { bad = 1; }
    if (st.const_count != 0)                 { bad = 1; }
    if (st.reloc_count != 0)                 { bad = 1; }

    ops[1] = mir.op_imm(7);
    st.buf.len = 0;
    encode_fmov(?st, nil, ?mi);
    if (st.buf.len != 8)                     { bad = 1; }
    if (read_word(?st.buf, 0) != 0x00700293) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xF2028553) { bad = 1; }
    if (st.const_count != 0)                 { bad = 1; }

    ops[1] = mir.op_imm(0x3FB999999999999A);
    st.buf.len = 0;
    encode_fmov(?st, nil, ?mi);
    if (st.buf.len != 8)                     { bad = 1; }
    if (read_word(?st.buf, 0) != 0x00000297) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x0002B507) { bad = 1; }
    if (st.const_count != 1)                 { bad = 1; }
    if (st.reloc_count != 2)                 { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PCREL_HI20)   { bad = 1; }
        if (st.relocs[1].kind != of.RK_PCREL_LO12_I) { bad = 1; }
        if (st.relocs[0].sym != st.consts[0].sym)  { bad = 1; }
        if (st.relocs[1].sym == st.consts[0].sym)  { bad = 1; }
        if (!label_at(?st, st.relocs[1].sym, st.relocs[0].offset)) { bad = 1; }
    }
    if (st.consts[0].len != 8 || st.consts[0].align != 8) { bad = 1; }
    or {
        if (st.consts[0].bytes[0] != 0x9A) { bad = 1; }
        if (st.consts[0].bytes[7] != 0x3F) { bad = 1; }
    }

    st.buf.len = 0;
    encode_fmov(?st, nil, ?mi);
    if (st.const_count != 1) { bad = 1; }

    mi.width = 4;
    ops[1] = mir.op_imm(0x3DCCCCCD);
    st.buf.len = 0;
    encode_fmov(?st, nil, ?mi);
    if (read_word(?st.buf, 4) != 0x0002A507) { bad = 1; }
    if (st.const_count != 2)                 { bad = 1; }
    if (st.consts[1].len != 4 || st.consts[1].align != 4) { bad = 1; }

    encode.consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    encode.buf_dnit(?st.buf);
    map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites);
    intern.dnit(?itn);
    ret bad;
}

test "mach.lang.target.isa.riscv.encode.asm_returns:trap_ends_control" {
    var bad: i32 = 0;

    if (asm_returns("li a7, 94\necall\nebreak")) { bad = 1; }
    if (asm_returns("ebreak"))                    { bad = 1; }

    if (!asm_returns("li a7, 64\necall")) { bad = 1; }
    if (!asm_returns("nop"))               { bad = 1; }
    if (!asm_returns("ebreak\nnop"))      { bad = 1; }
    if (!asm_returns("1:\nebreak"))       { bad = 1; }
    if (!asm_returns(".word 0x00100073"))  { bad = 1; }
    if (!asm_returns("this is not asm"))   { bad = 1; }
    if (!asm_returns(""))                  { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.riscv.encode:native_opcode_domain_refuses_unknown_and_truncated_aliases" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var st: encode.EncodeState;
    encode.state_blank(?st, ?alloc, rv64_machine());
    st.interner = ?interner;
    fin { encode.buf_dnit(?st.buf); }
    var f: mir.MirFunction;
    val name: res[intern.StrId, A.Error] = intern.intern(?interner, "opcode_probe");
    if (sel name.err) { ret 8; }
    f.name = name.ok;
    var instruction: mir.MirInstr = mir.instr(riscv.NOP::u32, nil, 0, 8, 0);
    val r_6444: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
    if (sel r_6444.err) { ret 1; }
    if (st.buf.len != 4) { ret 2; }
    st.buf.len = 0;
    instruction.opcode = isa.ISA_USE::u32;
    val r_6448: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
    if (sel r_6448.err) { ret 3; }
    if (st.buf.len != 0) { ret 3; }
    var codes: [3]u32;
    codes[0] = 0xFFFA;
    codes[1] = 0x10000 | riscv.NOP::u32;
    codes[2] = 0x10000 | isa.ISA_USE::u32;
    var messages: [3]str;
    messages[0] = "unknown riscv.Opcode tag 65530 in 'opcode_probe'";
    messages[1] = "unknown riscv.Opcode tag 65536 in 'opcode_probe'";
    messages[2] = "unknown riscv.Opcode tag 131067 in 'opcode_probe'";
    var i: u32 = 0;
    for (i < 3) {
        instruction.opcode = codes[i];
        val refused: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
        if (sel refused.ok) { ret 4; }
        if (!str_contains(fail.describe(refused.err), messages[i])) { ret 5; }
        if (st.buf.len != 0) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.isa.riscv.encode:selected_extensions_bound_generated_and_named_instructions" {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    fin { intern.dnit(?interner); encode.buf_dnit(?st.buf); map.dnit[u64, encode.RelocPairSite](?st.reloc_pair_sites); }
    var selected: isa.MachineModel = @st.model;
    selected.riscv_extensions = features.I;
    st.model = ?selected;
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    fin { iasm.labels_dnit(?labels); }
    var f: mir.MirFunction;
    val names: [3]str = [3]str { "mul a0, a1, a2", "lr.w a0, (a1)", "csrr a0, time" };
    val errors: [3]str = [3]str { "M extension", "A extension", "Zicsr extension" };
    var i: usize = 0;
    for (i < 3) {
        val r: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, names[i]);
        if (sel r.ok) { ret 1; }
        if (!str_contains(fail.describe(r.err), errors[i])) { ret 2; }
        if (st.buf.len != 0) { ret 2; }
        i = i + 1;
    }
    emit_r(?st, OPC_OP, F3_ADD, F7_MULDIV, 10, 11, 12);
    val mul: err[fail.Fail] = check_generated_extensions(?st, 0);
    if (sel mul.ok) { ret 3; }
    if (!str_contains(fail.describe(mul.err), "M extension")) { ret 3; }
    selected.riscv_extensions = features.I | features.M;
    val r_6498: err[fail.Fail] = check_generated_extensions(?st, 0);
    if (sel r_6498.err) { ret 4; }
    st.buf.len = 0;
    emit_r(?st, OPC_OP_FP, 0, 0, 10, 11, 12);
    val fp: err[fail.Fail] = check_generated_extensions(?st, 0);
    if (sel fp.ok) { ret 5; }
    if (!str_contains(fail.describe(fp.err), "F extension")) { ret 5; }
    selected.riscv_extensions = features.I | features.F | features.ZICSR;
    val r_6505: err[fail.Fail] = check_generated_extensions(?st, 0);
    if (sel r_6505.err) { ret 6; }
    st.buf.len = 0;
    emit_r(?st, OPC_OP_FP, 0, 1, 10, 11, 12);
    val dp: err[fail.Fail] = check_generated_extensions(?st, 0);
    if (sel dp.ok) { ret 7; }
    if (!str_contains(fail.describe(dp.err), "D extension")) { ret 7; }
    selected.riscv_extensions = features.ALL;
    val r_6512: err[fail.Fail] = check_generated_extensions(?st, 0);
    if (sel r_6512.err) { ret 8; }
    selected.riscv_extensions = features.I;
    st.buf.len = 0;
    val r_6515: err[fail.Fail] = rv_asm_text(?st, ?f, ?labels, ".word 0xc0102573 :: writes(a0)");
    if (sel r_6515.err) { ret 9; }
    if (st.buf.len != 4 || read_word(?st.buf, 0) != 0xc0102573) { ret 10; }
    var op: inst.MachOp = 1;
    for (op <= inst.MOP_LAST) {
        if (inst.required_extensions(op) == 0) { ret 11; }
        op = op + 1;
    }
    if (inst.required_extensions(inst.MOP_NONE) != 0 || inst.required_extensions(inst.MOP_LAST + 1) != 0) { ret 12; }
    ret 0;
}

# every notification names the MirInstr whose encoding emitted it, in
# emission order, and a declassify marker reaches the stream as a barrier
# with no bytes between the instructions around it
test "mach.lang.target.isa.riscv.encode.stream:notes_name_their_instruction_and_carry_the_barrier" {
    var alloc: A.Allocator;
    val r_6531: err[A.Error] = page.make(?alloc);
    if (sel r_6531.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    var st: encode.EncodeState;
    encode.state_blank(?st, ?alloc, rv64_machine());
    st.interner = ?interner;
    var sink: encode.AsmSink = encode.sink_init(nil, ?interner);
    st.buf.asm = ?sink;

    var vregs: [1]mir.MirVReg;
    vregs[0] = mir.vreg(0, mir.REG_CLASS_GP, false, true);
    vregs[0].assigned = isa.regid_make(isa.REG_CLASS_ID_GP, 10)::u32;
    var mov_ops: [2]mir.MirOperand;
    mov_ops[0] = mir.op_preg_of(isa.regid_make(isa.REG_CLASS_ID_GP, 10)::u32, 0);
    mov_ops[0].required_bank = mir.BANK_GP;
    mov_ops[1] = mir.op_imm(5);
    var instrs: [3]mir.MirInstr;
    instrs[0] = mir.instr(riscv.MOV::u32, ?mov_ops[0], 2, 8, 8);
    instrs[1] = mir.declassify_marker(?instrs[0], 0);
    instrs[2] = mir.instr(riscv.RET::u32, nil, 0, 0, 0);
    var blk: mir.MirBlock;
    blk.id = 0; blk.instrs = ?instrs[0]; blk.instr_count = 3;
    var f: mir.MirFunction;
    f.name = intern.STR_NIL;
    f.blocks = ?blk; f.block_count = 1;
    f.vregs = ?vregs[0]; f.vreg_count = 1;
    f.frame.omit = true;
    f.oblivious = true;

    val r: err[fail.Fail] = encode_function_riscv64(?st, ?f);
    if (sel r.err) { ret 2; }
    if (sink.failed || sink.refused != 0)              { ret 3; }
    if (encode.sink_unaccounted(?st.buf) != 0)          { ret 4; }
    if (encode.note_inst_count(?st.buf) != 2)           { ret 5; }

    # FUNC, BLOCK, then one INST for the move, the BARRIER, one INST for the return
    val n: u32 = encode.note_count(?st.buf);
    if (n != 5) { ret 6; }
    val head: *encode.AsmNote = encode.note_at(?st.buf, 0);
    val label: *encode.AsmNote = encode.note_at(?st.buf, 1);
    val mov: *encode.AsmNote = encode.note_at(?st.buf, 2);
    val bar: *encode.AsmNote = encode.note_at(?st.buf, 3);
    val fin_note: *encode.AsmNote = encode.note_at(?st.buf, 4);
    if (head.kind != encode.ASM_NOTE_FUNC || label.kind != encode.ASM_NOTE_BLOCK) { ret 7; }
    if (mov.kind != encode.ASM_NOTE_INST || mov.mi != ?instrs[0] || mov.byte_len == 0) { ret 8; }
    if (bar.kind != encode.ASM_NOTE_BARRIER || bar.mi != ?instrs[1]) { ret 9; }
    if (bar.off != mov.off + mov.byte_len) { ret 10; }
    if (fin_note.kind != encode.ASM_NOTE_INST || fin_note.mi != ?instrs[2] || fin_note.off != bar.off) { ret 11; }

    var seeds: encode.NoteSeeds;
    encode.note_seeds(?f, mov, ?seeds);
    if (seeds.barrier || seeds.count != 2 || seeds.origin[0] != 0 || !seeds.secret[0] || seeds.secret[1]) { ret 12; }
    encode.note_seeds(?f, bar, ?seeds);
    if (!seeds.barrier || seeds.count != 1 || seeds.origin[0] != 0 || !seeds.secret[0]) { ret 13; }
    encode.note_seeds(?f, head, ?seeds);
    if (seeds.count != 0 || seeds.barrier) { ret 14; }

    encode.notes_free(?st.buf);
    encode.buf_dnit(?st.buf);
    ret 0;
}

# the census the walk depends on: every machine opcode a notification can
# carry (the whole MachOp space) has a row in the closed table
test "mach.lang.target.isa.riscv.encode.asm_ct_class:every_notifiable_opcode_has_a_row" {
    var missing: u32 = 0;
    var op: inst.MachOp = 1;
    for (op <= inst.MOP_LAST) {
        val cls: ct.AsmClass = asm_ct_class(op::u32, 0);
        if (!cls.known) { missing = missing + 1; }
        op = op + 1;
    }
    if (asm_ct_class(inst.MOP_NONE::u32, 0).known)        { ret 2; }
    if (asm_ct_class((inst.MOP_LAST + 1)::u32, 0).known)  { ret 3; }
    if (missing != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.encode.inst_effects:roles_follow_the_notification_shape" {
    var e: ct.InstEffects;
    var mi: isa.Inst = build_inst(inst.BNE, 0, 5, 0, 0);
    mi.src2 = isa.make_block_label(2);
    inst_effects(?mi, ?e);
    if (!e.cls.cond_reg || e.roles[0] != ct.ROLE_READ || e.roles[1] != ct.ROLE_READ) { ret 1; }
    if (e.xfer != ct.XFER_BRANCH || e.target != ct.TARGET_BLOCK || e.target_block != 2) { ret 2; }

    mi = build_inst(inst.BNE, 0, 5, 0, 0);
    mi.src2 = isa.make_block_label(0); mi.src2.imm = 8; mi.flags = inst.FLAG_LABEL_SKIP;
    inst_effects(?mi, ?e);
    if (e.target != ct.TARGET_LOCAL_FWD || e.local_disp != 8) { ret 3; }
    mi.flags = inst.FLAG_LABEL_LOCAL;
    inst_effects(?mi, ?e);
    if (e.target != ct.TARGET_LOCAL) { ret 17; }

    mi = build_inst(inst.SD, 0, 8, 10, -16);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ || mi.dst.kind != isa.OPK_MEM) { ret 4; }

    mi = build_inst(inst.LD, 10, 8, 0, -16);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ || mi.src1.kind != isa.OPK_MEM) { ret 5; }

    mi = build_inst(inst.DIVU, 10, 11, 12, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_INT_DIVMOD || e.roles[0] != ct.ROLE_WRITE || e.roles[2] != ct.ROLE_READ) { ret 6; }

    mi = build_inst(inst.MULHU, 10, 11, 12, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_INT_MUL) { ret 7; }

    mi = build_inst(inst.SLL, 10, 11, 12, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_VAR_SHIFT || e.count_pos != 2) { ret 8; }

    mi = build_inst(inst.JALR, RZERO, SCRATCH, 0, 0);
    mi.flags = inst.FLAG_TARGET_BLOCK;
    mi.src1.imm = 5;
    inst_effects(?mi, ?e);
    if (!e.cls.cond_reg || e.roles[1] != ct.ROLE_ADDR || e.xfer != ct.XFER_JUMP || e.target != ct.TARGET_BLOCK || e.target_block != 5) { ret 9; }

    mi = build_inst(inst.JALR, RZERO, riscv.RA::u32, 0, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_RET || e.target != ct.TARGET_REGISTER || e.roles[1] != ct.ROLE_ADDR) { ret 16; }

    mi = build_inst(inst.JALR, riscv.RA::u32, 10, 0, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_CALL) { ret 10; }

    mi = build_inst(inst.JAL, riscv.RA::u32, 0, 0, 0);
    mi.src1 = isa.make_sym(3, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_CALL || e.target != ct.TARGET_EXTERNAL || e.roles[0] != ct.ROLE_WRITE) { ret 11; }

    mi = build_inst(inst.AUIPC, SCRATCH, 0, 0, 0);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_NONE || e.cls.op != ct.CT_OP_NONE) { ret 12; }

    mi = build_inst(inst.FCVT_L_D, 10, 0, 0, 0);
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_FLOAT || e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ) { ret 13; }

    mi = build_inst(inst.EBREAK, 0, 0, 0, 0);
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_TRAP) { ret 14; }

    mi = isa.inst_blank(); mi.opcode = inst.MOP_NONE::u16;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 15; }
    ret 0;
}

var t_walk_inputs_rv: [1]mir.MirAbiInput;

# a0 is a declared secret at entry; no callee-saved list, no flags class
fun t_walk_rv_target() isa.BackendTarget {
    var bt: isa.BackendTarget;
    bt.model = @rv64_machine();
    bt.model.frame_ptr_reg      = riscv.FRAME_REG;
    bt.model.stack_ptr_reg      = riscv.STACK_REG;
    bt.model.ct_trust_mul       = false;
    bt.model.ct_trust_var_shift = true;
    bt.model.reg_classes        = nil;
    bt.model.reg_class_len      = 0;
    bt.abi.callee_saved         = nil;
    bt.identity.arch_name       = "riscv64";
    ret bt;
}

fun t_walk_rv_function(f: *mir.MirFunction) {
    f.name        = intern.STR_NIL;
    f.oblivious   = true;
    f.vregs       = nil;
    f.vreg_count  = 0;
    f.blocks      = nil;
    f.block_count = 0;
    f.frame.omit  = false;
    t_walk_inputs_rv[0].argument      = 0;
    t_walk_inputs_rv[0].location      = mir.ABI_INPUT_REGISTER;
    t_walk_inputs_rv[0].reg           = isa.regid_make(isa.REG_CLASS_ID_GP, 10)::u32;
    t_walk_inputs_rv[0].offset        = 0;
    t_walk_inputs_rv[0].width         = 8;
    t_walk_inputs_rv[0].logical_width = 8;
    t_walk_inputs_rv[0].secret        = true;
    t_walk_inputs_rv[0].content       = mir.ABI_CONTENT_NONE;
    t_walk_inputs_rv[0].content_size  = 0;
    f.abi_inputs      = ?t_walk_inputs_rv[0];
    f.abi_input_count = 1;
    f.abi_input_cap   = 1;
}

# 0 accepted, 1 refused naming the needle, 2 refused otherwise
fun t_walk_rv(st: *encode.EncodeState, f: *mir.MirFunction, needle: str) i32 {
    var bt: isa.BackendTarget = t_walk_rv_target();
    val hooks: encode.EncodeHooks = riscv64_hooks();
    val s: *encode.AsmSink = st.buf.asm;
    val r: err[ctwalk.Refusal] = ctwalk.walk(f, s.notes, s.note_count, ?hooks.effects, ?bt, st.alloc);
    if (sel r.ok) { ret 0; }
    var refusal: ctwalk.Refusal = r.err;
    var code: i32 = 2;
    if (refusal.detail != nil && needle != nil && str_contains(refusal.detail, needle)) { code = 1; }
    if (code == 2 && refusal.detail != nil) { print.eprintlnf("unexpected refusal at note {}: {}", refusal.index, refusal.detail); }
    ctwalk.refusal_free(st.alloc, ?refusal);
    ret code;
}

fun t_note_block_rv(st: *encode.EncodeState, id: u32) bool {
    var label: encode.AsmNote = encode.note_blank();
    label.kind = encode.ASM_NOTE_BLOCK;
    label.off  = st.buf.len::u32;
    label.id   = id;
    val note_push_r: err[fail.Fail] = encode.note_push(?st.buf, ?label);
    ret sel note_push_r.ok;
}

# a relaxed jump's trampoline: `mv t0, a0` taints the scratch, the far
# branch becomes `guard; auipc t0; jalr zero, t0`. the walk reaches the
# inserted instructions through their notifications: auipc redefines t0
# publicly and the jump through it is accepted; the stream before
# relaxation (the vreg walk's view, a plain branch) is accepted too; a
# stream in which the trampoline's register still carries the secret at
# the jump is refused at the jalr
test "mach.lang.target.isa.riscv.encode.walk:a_relaxed_jump_is_validated_through_its_trampoline" {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    var sink: encode.AsmSink = encode.sink_init(nil, ?itn);
    st.buf.asm = ?sink;
    var f: mir.MirFunction;
    t_walk_rv_function(?f);

    var head: encode.AsmNote = encode.note_blank();
    head.kind = encode.ASM_NOTE_FUNC;
    val note_push_r: err[fail.Fail] = encode.note_push(?st.buf, ?head);
    if (sel note_push_r.err) { ret 1; }
    if (!t_note_block_rv(?st, 0)) { ret 1; }
    emit_i(?st, OPC_OP_IMM, F3_ADD, SCRATCH, 10, 0);
    emit_b(?st, OPC_BRANCH, F3_BNE, 11, 0, 0);
    note_block_target(?st, 1);
    val push_block_r: err[fail.Fail] = encode.push_block(?st, 0, 1, 4000000);
    if (sel push_block_r.err) { ret 2; }
    val push_fixup_r: err[fail.Fail] = encode.push_fixup(?st, 4, 8, 1, 0);
    if (sel push_fixup_r.err)    { ret 2; }
    emit_i(?st, OPC_JALR, F3_ADD, RZERO, riscv.RA::u32, 0);

    # before relaxation: one conditional branch on a public register
    if (t_walk_rv(?st, ?f, nil) != 0) { ret 3; }

    val r_6775: err[fail.Fail] = relax_function_riscv64(?st, 0, 0);
    if (sel r_6775.err) { ret 4; }
    if (encode.note_inst_count(?st.buf) != 5) { ret 5; }
    val auipc: *encode.AsmNote = encode.note_at(?st.buf, 4);
    val jalr:  *encode.AsmNote = encode.note_at(?st.buf, 5);
    if (auipc.inst.opcode != inst.AUIPC::u16 || jalr.inst.opcode != inst.JALR::u16) { ret 6; }
    if (t_walk_rv(?st, ?f, nil) != 0) { ret 7; }

    # the same stream whose trampoline never redefined the register it jumps through
    auipc.inst.dst = gpr(SCRATCH2);
    if (t_walk_rv(?st, ?f, "transfers control through a secret") != 1) { ret 8; }
    # and with a public write into the scratch instead, the jump is fine again
    val mv: *encode.AsmNote = encode.note_at(?st.buf, 2);
    mv.inst.src1 = gpr(11);
    if (t_walk_rv(?st, ?f, nil) != 0) { ret 9; }

    encode.notes_free(?st.buf);
    encode.buf_dnit(?st.buf);
    ret 0;
}

# the zero register never carries a value: a write to it from a secret does
# not taint the reads that compare against it
test "mach.lang.target.isa.riscv.encode.walk:the_zero_register_is_constant" {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    var sink: encode.AsmSink = encode.sink_init(nil, ?itn);
    st.buf.asm = ?sink;
    var f: mir.MirFunction;
    t_walk_rv_function(?f);
    var head: encode.AsmNote = encode.note_blank();
    head.kind = encode.ASM_NOTE_FUNC;
    val note_push_r: err[fail.Fail] = encode.note_push(?st.buf, ?head);
    if (sel note_push_r.err) { ret 1; }
    if (!t_note_block_rv(?st, 0)) { ret 1; }
    emit_i(?st, OPC_OP_IMM, F3_ADD, RZERO, 10, 0);
    emit_b(?st, OPC_BRANCH, F3_BNE, 11, RZERO, 0);
    note_block_target(?st, 1);
    if (!t_note_block_rv(?st, 1)) { ret 1; }
    emit_i(?st, OPC_JALR, F3_ADD, RZERO, riscv.RA::u32, 0);
    if (t_walk_rv(?st, ?f, nil) != 0) { ret 2; }
    # the branch on the secret itself is refused
    val b: *encode.AsmNote = encode.note_at(?st.buf, 3);
    b.inst.dst = gpr(10);
    if (t_walk_rv(?st, ?f, "branches on") != 1) { ret 3; }
    encode.notes_free(?st.buf);
    encode.buf_dnit(?st.buf);
    ret 0;
}
