use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.size.usize;
use std.allocator.page;
use std.collections.map;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use rel: mach.lang.target.of.reloc;

pub fun is_local_got_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_GOT_PCREL_HI20;
}

fun is_pcrel_high(kind: of.RelocKind) bool {
    ret kind == of.RK_PCREL_HI20 || kind == of.RK_GOT_PCREL_HI20;
}

fun reloc_traits_admitted(kind: of.RelocKind) bool {
    ret kind == of.RK_ABS64 || kind == of.RK_ABS32  || kind == of.RK_PC32
     || kind == of.RK_PLT32 || is_pcrel_high(kind)
     || kind == of.RK_PCREL_LO12_I || kind == of.RK_PCREL_LO12_S;
}

pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) res[rel.RelocTraits, rel.RelocError] {
    if (!reloc_traits_admitted(kind)) {
        ret res[rel.RelocTraits, rel.RelocError].err{rel.RELOC_UNSUPPORTED};
    }

    var width: u32 = 4;
    if (kind == of.RK_ABS64 || kind == of.RK_PLT32) { width = 8; }

    ret res[rel.RelocTraits, rel.RelocError].ok{rel.traits(width, rel.RELOC_ADDEND_SYMBOL, 0, 0)};
}

pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    target: rel.RelocTarget, addend: i64, patch_va: u64,
                    image_base: u64) res[bool, rel.RelocError] {
    if (kind == of.RK_ABS64) {
        ret rel.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_ABS32) {
        ret rel.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_PC32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == of.RK_PLT32) {
        if (patch_off::u64 + 8 > sec_len::u64) {
            ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
        }
        val displaced: res[i64, rel.RelocError] =
            rel.displacement(target.vaddr, addend, patch_va);
        if (sel displaced.err) {
            ret res[bool, rel.RelocError].err{displaced.err};
        }
        val delta: i64 = displaced.ok;
        if (!pcrel32_ok(delta)) {
            ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
        }
        val auipc: u32 = bin.read_u32_le(dst, patch_off::usize);
        bin.write_u32_le(dst, patch_off::usize, set_hi20(auipc, delta));
        val jalr: u32 = bin.read_u32_le(dst, (patch_off + 4)::usize);
        bin.write_u32_le(dst, (patch_off + 4)::usize, set_lo12_i(jalr, delta));
        ret res[bool, rel.RelocError].ok{true};
    }

    if (patch_off::u64 + 4 > sec_len::u64) {
        ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(dst, patch_off::usize);

    if (is_pcrel_high(kind)) {
        if (kind == of.RK_GOT_PCREL_HI20 && addend != 0) { ret res[bool, rel.RelocError].err{rel.RELOC_UNSUPPORTED}; }
        val displaced: res[i64, rel.RelocError] =
            rel.displacement(target.vaddr, addend, patch_va);
        if (sel displaced.err) {
            ret res[bool, rel.RelocError].err{displaced.err};
        }
        val delta: i64 = displaced.ok;
        if (!pcrel32_ok(delta)) {
            ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
        }
        bin.write_u32_le(dst, patch_off::usize, set_hi20(word, delta));
        ret res[bool, rel.RelocError].ok{true};
    }

    if (kind == of.RK_PCREL_LO12_I) {
        val displaced: res[i64, rel.RelocError] =
            rel.displacement(target.vaddr, addend, patch_va);
        if (sel displaced.err) {
            ret res[bool, rel.RelocError].err{displaced.err};
        }
        val delta: i64 = displaced.ok;
        bin.write_u32_le(dst, patch_off::usize, set_lo12_i(word, delta));
        ret res[bool, rel.RelocError].ok{true};
    }
    if (kind == of.RK_PCREL_LO12_S) {
        val displaced: res[i64, rel.RelocError] =
            rel.displacement(target.vaddr, addend, patch_va);
        if (sel displaced.err) {
            ret res[bool, rel.RelocError].err{displaced.err};
        }
        val delta: i64 = displaced.ok;
        bin.write_u32_le(dst, patch_off::usize, set_lo12_s(word, delta));
        ret res[bool, rel.RelocError].ok{true};
    }

    ret res[bool, rel.RelocError].err{rel.RELOC_UNSUPPORTED};
}

test "mach.lang.target.isa.riscv.reloc.catalog:admitted_kinds_are_exactly_the_applied_kinds" {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k: u32 = 0;
    for (k < of.RK_CATALOG_COUNT) {
        val kind: of.RelocKind = k::of.RelocKind;
        var i: usize = 0;
        for (i < 16) { dst[i] = 0; i = i + 1; }

        val tr: res[rel.RelocTraits, rel.RelocError] = reloc_traits(kind, of.SK_TEXT, true);
        val admitted: bool = sel tr.ok;
        if (sel tr.err) {
            if (tr.err != rel.RELOC_UNSUPPORTED) { bad = 1; brk; }
        }

        val ap: res[bool, rel.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (sel ap.err) {
            applied = ap.err != rel.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) { bad = 2; brk; }
        k = k + 1;
    }

    val past: of.RelocKind = 0xFF::of.RelocKind;
    val tr_past: res[rel.RelocTraits, rel.RelocError] = reloc_traits(past, of.SK_TEXT, true);
    if (!sel tr_past.err) { bad = 3; }
    or (sel tr_past.err) { if (tr_past.err != rel.RELOC_UNSUPPORTED) { bad = 3; } }
    val ap_past: res[bool, rel.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!sel ap_past.err) { bad = 4; }
    or (sel ap_past.err) { if (ap_past.err != rel.RELOC_UNSUPPORTED) { bad = 4; } }
    ret bad;
}

test "mach.lang.target.isa.riscv.reloc.reloc_traits:plt32" {
    val tr: res[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_PLT32, of.SK_TEXT, false);
    if (sel tr.err) { ret 1; }
    val t: rel.RelocTraits = tr.ok;
    if (t.field_width != 8 || t.addend_mode != rel.RELOC_ADDEND_SYMBOL
        || t.text_bias_min != 0 || t.text_bias_max != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.reloc.reloc_traits:unsupported_kind_refused" {
    val bad: res[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_SECTION, of.SK_TEXT, false);
    if (!sel bad.err) { ret 1; }
    if (bad.err != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}

fun pcrel32_ok(delta: i64) bool {
    ret delta >= -2147485696 && delta <= 2147481599;
}

fun set_hi20(word: u32, delta: i64) u32 {
    val hi20: u32 = (((delta + 0x800) >> 12)::u64 & 0xFFFFF)::u32;
    ret (word & 0xFFF) | (hi20 << 12);
}

fun set_lo12_i(word: u32, delta: i64) u32 {
    val lo12: u32 = (delta::u64 & 0xFFF)::u32;
    ret (word & 0x000FFFFF) | (lo12 << 20);
}

fun set_lo12_s(word: u32, delta: i64) u32 {
    val lo12: u32 = (delta::u64 & 0xFFF)::u32;
    ret (word & 0x01FFF07F) | ((lo12 >> 5) << 25) | ((lo12 & 0x1F) << 7);
}

test "mach.lang.target.isa.riscv.reloc.apply_reloc:bitpackers" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x00000297);
    val h1: res[bool, rel.RelocError] = apply_reloc(of.RK_PCREL_HI20, ?dst[0], 0, 8, rel.target(0x12345678, 0, 0), 0, 0, 0);
    if (sel h1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x12345297) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x00028293);
    val li: res[bool, rel.RelocError] = apply_reloc(of.RK_PCREL_LO12_I, ?dst[0], 0, 8, rel.target(0x12345678, 0, 0), 4, 4, 0);
    if (sel li.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x67828293) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x00028293);
    val lf: res[bool, rel.RelocError] = apply_reloc(of.RK_PCREL_LO12_I, ?dst[0], 0, 8, rel.target(0x12345678, 0, 0), 20, 20, 0);
    if (sel lf.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x67828293) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x0052B023);
    val ls: res[bool, rel.RelocError] = apply_reloc(of.RK_PCREL_LO12_S, ?dst[0], 0, 8, rel.target(0x12345678, 0, 0), 4, 4, 0);
    if (sel ls.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x6652BC23) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x00000097);
    bin.write_u32_le(?dst[0], 4, 0x000080E7);
    val c1: res[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x12345678, 0, 0), 0, 0, 0);
    if (sel c1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x12345097) { ret 1; }
    if (bin.read_u32_le(?dst[0], 4) != 0x678080E7) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0); bin.write_u32_le(?dst[0], 4, 0);
    val a1: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS64, ?dst[0], 0, 8, rel.target(0xDEADBEEF, 0, 0), 0x11, 0, 0);
    if (sel a1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xDEADBF00) { ret 1; }
    if (bin.read_u32_le(?dst[0], 4) != 0)          { ret 1; }

    ret 0;
}

test "mach.lang.target.isa.riscv.reloc.apply_reloc:overflow_rejection" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x00000297);
    val o1: res[bool, rel.RelocError] = apply_reloc(of.RK_PCREL_HI20, ?dst[0], 0, 8, rel.target(0x80000000, 0, 0), 0, 0, 0);
    if (!sel o1.err) { ret 1; }
    if (o1.err != rel.RELOC_OVERFLOW) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x00000297);
    val o2: res[bool, rel.RelocError] = apply_reloc(of.RK_PCREL_HI20, ?dst[0], 0, 8, rel.target(2147481599, 0, 0), 0, 0, 0);
    if (sel o2.err) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x00000097);
    bin.write_u32_le(?dst[0], 4, 0x000080E7);
    val o3: res[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x80000000, 0, 0), 0, 0, 0);
    if (!sel o3.err) { ret 1; }

    val o4: res[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(0x1000, 0, 0), 0, 0, 0);
    if (!sel o4.err) { ret 1; }
    if (o4.err != rel.RELOC_UNSUPPORTED) { ret 1; }

    val o5: res[bool, rel.RelocError] = apply_reloc(
        of.RK_PCREL_LO12_I, ?dst[0], 0, 8,
        rel.target(0xFFFFFFFFFFFFFFFF, 0, 0), 1, 0, 0);
    val o6: res[bool, rel.RelocError] = apply_reloc(
        of.RK_PCREL_HI20, ?dst[0], 0, 8,
        rel.target(0xFFFFFFFFFFFFFFFF, 0, 0), -9223372036854775807 - 1, 0, 0);
    if (!sel o5.err) { ret 1; }
    if (!sel o6.err) { ret 1; }

    ret 0;
}

fun is_pcrel_low(kind: of.RelocKind) bool {
    ret kind == of.RK_PCREL_LO12_I || kind == of.RK_PCREL_LO12_S;
}

fun pcrel_location_key(section: u32, offset: u32) u64 {
    ret (section::u64 << 32) | offset::u64;
}

fun validate_riscv_pcrel_pair(img: *of.ObjectImage, low_index: u32,
                              high_index: u32) err[fail.Fail] {
    if (low_index >= img.reloc_count || high_index >= img.reloc_count) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative relocation pair index is out of range")};
    }
    val low: *of.Relocation = ?img.relocations[low_index];
    val high: *of.Relocation = ?img.relocations[high_index];
    if (!is_pcrel_low(low.kind) || !is_pcrel_high(high.kind)) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation does not pair with a high relocation")};
    }
    if (low.sym == of.SYMBOL_NONE || low.sym >= img.symbol_count) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation refers to an absent label symbol")};
    }
    if (high.sym == of.SYMBOL_NONE || high.sym >= img.symbol_count) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative high relocation refers to an absent target symbol")};
    }
    if (high.kind == of.RK_GOT_PCREL_HI20 && high.addend != 0) {
        ret err[fail.Fail].err{fail.message("riscv: GOT high relocation requires a zero addend")};
    }
    val label: *of.Symbol = ?img.symbols[low.sym];
    if (label.flags != 0 || low.addend != 0 || !of.section_same(label.section, low.section)) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation is not a local zero-addend label reference")};
    }
    if (!of.section_same(high.section, label.section) || high.offset != label.offset) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation label does not identify its paired high relocation")};
    }
    val adjusted: res[i64, rel.RelocError] =
        rel.displacement(low.offset::u64, high.addend, high.offset::u64);
    if (sel adjusted.err) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative relocation pair addend is outside the signed 64-bit range")};
    }
    ret err[fail.Fail].ok{};
}

pub fun resolve_riscv_pcrel_pairs(alloc: *A.Allocator,
                                  img: *of.ObjectImage) err[fail.Fail] {
    if (img == nil) {
        ret err[fail.Fail].err{fail.message("riscv: cannot normalize a nil object image")};
    }
    var unpaired: u32 = 0;
    var i: u32 = 0;
    for (i < img.reloc_count) {
        if (img.relocations[i].kind == of.RK_GOT_PCREL_HI20 && img.relocations[i].addend != 0) {
            ret err[fail.Fail].err{fail.message("riscv: GOT high relocation requires a zero addend")};
        }
        if (is_pcrel_low(img.relocations[i].kind)) {
            if (img.relocations[i].pair == 0) { unpaired = unpaired + 1; }
            or {
                val vr: err[fail.Fail] =
                    validate_riscv_pcrel_pair(img, i, img.relocations[i].pair - 1);
                if (sel vr.err) { ret vr; }
            }
        }
        i = i + 1;
    }
    if (unpaired == 0) { ret err[fail.Fail].ok{}; }
    if (alloc == nil) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative pair indexing requires an allocator")};
    }

    var highs: map.Map[u64, u32] = map.init[u64, u32](alloc, map.hash_u64, map.eq_u64);
    fin { map.dnit[u64, u32](?highs); }

    i = 0;
    for (i < img.reloc_count) {
        if (is_pcrel_high(img.relocations[i].kind)) {
            val key: u64 = pcrel_location_key(of.section_index(img.relocations[i].section),
                                              img.relocations[i].offset);
            val prior: opt[*u32] = map.get[u64, u32](?highs, ?key);
            if (sel prior.some) {
                @prior.some = 0;
            }
            if (sel prior.none) {
                val inserted: res[bool, A.Error] = map.insert[u64, u32](?highs, key, i + 1);
                if (sel inserted.err) {
                    ret err[fail.Fail].err{fail.message("riscv: could not allocate the pc-relative relocation pair index")};
                }
            }
        }
        i = i + 1;
    }

    i = 0;
    for (i < img.reloc_count) {
        val low: *of.Relocation = ?img.relocations[i];
        if (!is_pcrel_low(low.kind) || low.pair != 0) { i = i + 1; cnt; }
        if (low.sym == of.SYMBOL_NONE || low.sym >= img.symbol_count) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation refers to an absent label symbol")};
        }
        val label: *of.Symbol = ?img.symbols[low.sym];
        if (label.flags != 0 || low.addend != 0 || !of.section_same(label.section, low.section)) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation is not a local zero-addend label reference")};
        }
        val key: u64 = pcrel_location_key(of.section_index(label.section), label.offset);
        val found: opt[*u32] = map.get[u64, u32](?highs, ?key);
        if (sel found.none) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation has no matching high relocation")};
        }
        val encoded: u32 = @found.some;
        if (encoded == 0) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation has ambiguous matching high relocations")};
        }
        val vr: err[fail.Fail] = validate_riscv_pcrel_pair(img, i, encoded - 1);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }

    i = 0;
    for (i < img.reloc_count) {
        val low: *of.Relocation = ?img.relocations[i];
        if (is_pcrel_low(low.kind) && low.pair == 0) {
            val label: *of.Symbol = ?img.symbols[low.sym];
            val key: u64 = pcrel_location_key(of.section_index(label.section), label.offset);
            val found: opt[*u32] = map.get[u64, u32](?highs, ?key);
            if (sel found.none) { ret err[fail.Fail].err{fail.message("riscv reloc: a pcrel low relocation names a label without a paired high relocation")}; }
            low.pair = @found.some;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun resolve_riscv_reloc_operand(img: *of.ObjectImage,
                                    reloc_index: u32) res[of.RelocOperand, fail.Fail] {
    if (img == nil || reloc_index >= img.reloc_count) {
        ret res[of.RelocOperand, fail.Fail].err{fail.message("riscv: relocation operand index is out of range")};
    }
    val low: *of.Relocation = ?img.relocations[reloc_index];
    var operand: of.RelocOperand;
    if (low.kind == of.RK_GOT_PCREL_HI20 && low.addend != 0) {
        ret res[of.RelocOperand, fail.Fail].err{fail.message("riscv: GOT high relocation requires a zero addend")};
    }
    operand.target_kind = low.kind;
    operand.sym = low.sym;
    operand.addend = low.addend;
    if (!is_pcrel_low(low.kind)) { ret res[of.RelocOperand, fail.Fail].ok{operand}; }
    if (low.pair == 0) {
        ret res[of.RelocOperand, fail.Fail].err{fail.message("riscv: pc-relative low relocation was not paired before application")};
    }
    val high_index: u32 = low.pair - 1;
    val vr: err[fail.Fail] = validate_riscv_pcrel_pair(img, reloc_index, high_index);
    if (sel vr.err) {
        ret res[of.RelocOperand, fail.Fail].err{vr.err};
    }
    val adjusted: res[i64, rel.RelocError] = rel.displacement(
        low.offset::u64, img.relocations[high_index].addend,
        img.relocations[high_index].offset::u64);
    if (sel adjusted.err) {
        ret res[of.RelocOperand, fail.Fail].err{fail.message("riscv reloc: a pcrel pair displacement does not fit its addend")};
    }
    operand.target_kind = img.relocations[high_index].kind;
    operand.sym = img.relocations[high_index].sym;
    operand.addend = adjusted.ok;
    ret res[of.RelocOperand, fail.Fail].ok{operand};
}

test "mach.lang.target.isa.riscv.reloc.resolve_riscv_pcrel_pairs:index_preserves_raw_records" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var syms: [2]of.Symbol;
    syms[0].name = 0::intern.StrId; syms[0].section = of.section_id(1); syms[0].offset = 0x40;
    syms[0].size = 0; syms[0].flags = 0; syms[0].fallback = 0;
    syms[1].name = 1::intern.StrId; syms[1].section = of.section_id(2); syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_OBJECT; syms[1].fallback = 0;

    var rels: [3]of.Relocation;
    rels[0].section = of.section_id(1); rels[0].offset = 0x40; rels[0].kind = of.RK_PCREL_HI20;
    rels[0].sym = 1; rels[0].addend = 0x18;
    rels[1].section = of.section_id(1); rels[1].offset = 0x58; rels[1].kind = of.RK_PCREL_LO12_I;
    rels[1].sym = 0; rels[1].addend = 0;
    rels[2].section = of.section_id(1); rels[2].offset = 0x5C; rels[2].kind = of.RK_PCREL_LO12_S;
    rels[2].sym = 0; rels[2].addend = 0;

    var img: of.ObjectImage;
    img.symbols = ?syms[0];     img.symbol_count = 2;
    img.relocations = ?rels[0]; img.reloc_count = 3;

    val r1: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (sel r1.err) { ret 1; }
    if (img.relocations[1].sym != 0 || img.relocations[1].addend != 0
        || img.relocations[1].pair != 1) { ret 1; }
    if (img.relocations[2].sym != 0 || img.relocations[2].addend != 0
        || img.relocations[2].pair != 1) { ret 1; }

    val op1: res[of.RelocOperand, fail.Fail] = resolve_riscv_reloc_operand(?img, 1);
    val op2: res[of.RelocOperand, fail.Fail] = resolve_riscv_reloc_operand(?img, 2);
    if (sel op1.err) { ret 1; }
    if (sel op2.err) { ret 1; }
    if (op1.ok.sym != 1) { ret 1; }
    if (op1.ok.addend != 0x30) { ret 1; }
    if (op2.ok.sym != 1) { ret 1; }
    if (op2.ok.addend != 0x34) { ret 1; }

    val r2: err[fail.Fail] = resolve_riscv_pcrel_pairs(nil::*A.Allocator, ?img);
    if (sel r2.err) { ret 1; }
    if (img.relocations[1].pair != 1) { ret 1; }
    if (img.relocations[2].pair != 1) { ret 1; }

    ret 0;
}

test "mach.lang.target.isa.riscv.reloc.resolve_riscv_pcrel_pairs:malformed_is_transactional" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var syms: [4]of.Symbol;
    syms[0].section = of.section_id(1); syms[0].offset = 0x40; syms[0].flags = 0;
    syms[1].section = of.section_id(2); syms[1].offset = 0; syms[1].flags = of.SYM_OBJ_FLAG_OBJECT;
    syms[2].section = of.section_id(1); syms[2].offset = 0x80; syms[2].flags = 0;
    syms[3].section = of.section_id(1); syms[3].offset = 0x40; syms[3].flags = of.SYM_OBJ_FLAG_FUNCTION;

    var rels: [4]of.Relocation;
    rels[0].section = of.section_id(1); rels[0].offset = 0x40; rels[0].kind = of.RK_PCREL_HI20;
    rels[0].sym = 1; rels[0].addend = 0;
    rels[1].section = of.section_id(1); rels[1].offset = 0x48; rels[1].kind = of.RK_PCREL_LO12_I;
    rels[1].sym = 0; rels[1].addend = 0;
    rels[2].section = of.section_id(1); rels[2].offset = 0x4C; rels[2].kind = of.RK_PCREL_LO12_S;
    rels[2].sym = 2; rels[2].addend = 0;

    var img: of.ObjectImage;
    img.symbols = ?syms[0]; img.symbol_count = 4;
    img.relocations = ?rels[0]; img.reloc_count = 3;

    val missing: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (!sel missing.err) { ret 1; }
    if (rels[1].pair != 0) { ret 1; }

    rels[2].sym = 3;
    val typed: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (!sel typed.err) { ret 1; }
    if (rels[1].pair != 0) { ret 1; }

    rels[2].sym = 0; rels[2].addend = 4;
    val added: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (!sel added.err) { ret 1; }
    if (rels[1].pair != 0) { ret 1; }

    rels[2].kind = of.RK_ABS32; rels[2].sym = 1; rels[2].addend = 0;
    rels[3].section = of.section_id(1); rels[3].offset = 0x40; rels[3].kind = of.RK_PCREL_HI20;
    rels[3].sym = 1; rels[3].addend = 0;
    img.reloc_count = 4;
    val ambiguous: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (!sel ambiguous.err) { ret 1; }
    if (rels[1].pair != 0) { ret 1; }

    img.reloc_count = 2;
    rels[0].addend = 9223372036854775807;
    val overflow: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (!sel overflow.err) { ret 1; }
    if (rels[1].pair != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.reloc.resolve_riscv_pcrel_pairs:large_indexed_join" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val count: u32 = 1024;
    val syms_r: res[*of.Symbol, A.Error] = A.zallocate[of.Symbol](?alloc, (count + 1)::usize);
    if (sel syms_r.err) { ret 1; }
    val syms: *of.Symbol = syms_r.ok;
    fin { A.deallocate[of.Symbol](?alloc, syms, (count + 1)::usize); }
    val rels_r: res[*of.Relocation, A.Error] =
        A.zallocate[of.Relocation](?alloc, (count * 2)::usize);
    if (sel rels_r.err) { ret 1; }
    val rels: *of.Relocation = rels_r.ok;
    fin { A.deallocate[of.Relocation](?alloc, rels, (count * 2)::usize); }

    syms[count].section = of.section_id(1);
    syms[count].flags = of.SYM_OBJ_FLAG_OBJECT;
    var i: u32 = 0;
    for (i < count) {
        val high: u32 = i * 2;
        val low: u32 = high + 1;
        syms[i].section = of.section_id(0);
        syms[i].offset = i * 8;
        rels[high].section = of.section_id(0);
        rels[high].offset = i * 8;
        rels[high].kind = of.RK_PCREL_HI20;
        rels[high].sym = count;
        rels[low].section = of.section_id(0);
        rels[low].offset = i * 8 + 4;
        rels[low].kind = of.RK_PCREL_LO12_I;
        rels[low].sym = i;
        i = i + 1;
    }

    var img: of.ObjectImage;
    img.symbols = syms; img.symbol_count = count + 1;
    img.relocations = rels; img.reloc_count = count * 2;
    val indexed: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?img);
    if (sel indexed.err) { ret 1; }
    i = 0;
    for (i < count) {
        if (rels[i * 2 + 1].pair != i * 2 + 1) { ret 1; }
        i = i + 1;
    }
    val r_568: err[fail.Fail] = resolve_riscv_pcrel_pairs(nil::*A.Allocator, ?img);
    if (sel r_568.err) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.reloc.resolve_riscv_pcrel_pairs:got_target_kind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var symbols: [2]of.Symbol;
    symbols[0].section = of.external_section();
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    symbols[1].section = of.section_id(0); symbols[1].offset = 0x100;
    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0x100;
    relocs[0].kind = of.RK_GOT_PCREL_HI20; relocs[0].sym = 0;
    relocs[1].section = of.section_id(0); relocs[1].offset = 0x108;
    relocs[1].kind = of.RK_PCREL_LO12_I; relocs[1].sym = 1;
    var image: of.ObjectImage;
    image.symbols = ?symbols[0]; image.symbol_count = 2;
    image.relocations = ?relocs[0]; image.reloc_count = 2;
    val paired: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?image);
    if (sel paired.err) { ret 1; }
    val resolved: res[of.RelocOperand, fail.Fail] = resolve_riscv_reloc_operand(?image, 1);
    if (sel resolved.err) { ret 2; }
    val operand: of.RelocOperand = resolved.ok;
    if (operand.target_kind != of.RK_GOT_PCREL_HI20 || operand.sym != 0 || operand.addend != 8) { ret 3; }
    if (relocs[1].kind != of.RK_PCREL_LO12_I || relocs[1].sym != 1 || relocs[1].addend != 0 || relocs[1].pair != 1) { ret 4; }
    relocs[0].addend = 1;
    val r_595: err[fail.Fail] = resolve_riscv_pcrel_pairs(?alloc, ?image);
    if (!sel r_595.err) { ret 5; }
    val r_596: res[of.RelocOperand, fail.Fail] = resolve_riscv_reloc_operand(?image, 0);
    if (!sel r_596.err) { ret 5; }
    val r_597: res[of.RelocOperand, fail.Fail] = resolve_riscv_reloc_operand(?image, 1);
    if (!sel r_597.err) { ret 5; }
    ret 0;
}
