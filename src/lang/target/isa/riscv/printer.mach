use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.canonical.res;
use io_error: std.io.error;
use os: std.system.os;
use std.allocator.page;
use std.format;
use std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use R: std.types.result;

use enc: mach.lang.be.codegen.encode;
use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.isa.riscv.inst;

pub fun render_notes(buf: *enc.ByteBuf) err[fail.Fail] {
    val out: *writer.Writer = buf.asm.out;
    val count: u32 = enc.note_count(buf);
    var i: u32 = 0;
    for (i < count) {
        val res_: err[fail.Fail] = render_note(out, buf.asm.interner, enc.note_at(buf, i));
        if (sel res_.err) { ret res_; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun render_note(out: *writer.Writer, interner: *intern.Interner, n: *enc.AsmNote) err[fail.Fail] {
    if (n.kind == enc.ASM_NOTE_FUNC) {
        val res_open: err[fail.Fail] = emit_str(out, "\n# ");
        if (sel res_open.err) { ret res_open; }
        val res_name: err[fail.Fail] = emit_name(out, interner, n.name);
        if (sel res_name.err) { ret res_name; }
        ret emit_str(out, ":\n");
    }
    if (n.kind == enc.ASM_NOTE_BLOCK) {
        val res_label: err[fail.Fail] = emit_block(out, n.id);
        if (sel res_label.err) { ret res_label; }
        ret emit_str(out, ":\n");
    }
    if (n.kind == enc.ASM_NOTE_BYTES) {
        val r_94975: R.Result[R.Void, str] = enc.render_bytes_text(out, ?n.bytes[0], enc.ASM_NOTE_BYTES_WIDTH);
        if (R.is_err[R.Void, str](r_94975)) { ret err[fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](r_94975))}; }
        ret err[fail.Fail].ok{};
    }
    if (n.kind == enc.ASM_NOTE_BARRIER) { ret err[fail.Fail].ok{}; }
    ret render_inst(out, interner, ?n.inst);
}

fun render_inst(out: *writer.Writer, interner: *intern.Interner, mi: *isa.Inst) err[fail.Fail] {
    val res_indent: err[fail.Fail] = emit_str(out, "  ");
    if (sel res_indent.err) { ret res_indent; }

    val mnem: str = mnemonic(mi.opcode::inst.MachOp);
    if (mnem == nil) {
        ret err[fail.Fail].err{fail.message("--emit-asm: no riscv64 mnemonic for the emitted opcode")};
    }
    val res_mnem: err[fail.Fail] = emit_str(out, mnem);
    if (sel res_mnem.err) { ret res_mnem; }
    val res_order: err[fail.Fail] = emit_str(out, ordering_suffix(mi.flags));
    if (sel res_order.err) { ret res_order; }

    val res_ops: err[fail.Fail] = render_operands(out, interner, mi);
    if (sel res_ops.err) { ret res_ops; }
    val res_rm: err[fail.Fail] = emit_str(out, rounding_operand(mi.opcode::inst.MachOp));
    if (sel res_rm.err) { ret res_rm; }
    ret emit_str(out, "\n");
}

fun rounding_operand(op: inst.MachOp) str {
    if (op >= inst.FCVT_W_S && op <= inst.FCVT_LU_D) { ret ", rtz"; }
    ret "";
}

fun render_operands(out: *writer.Writer, interner: *intern.Interner, mi: *isa.Inst) err[fail.Fail] {
    if (mi.dst.kind == isa.OPK_MEM) {
        var printed: u32 = 0;
        val res_src: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.src1, printed);
        if (sel res_src.err) { ret err[fail.Fail].err{res_src.err}; }
        printed = res_src.ok;
        val res_dst: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.dst, printed);
        if (sel res_dst.err) { ret err[fail.Fail].err{res_dst.err}; }
        ret err[fail.Fail].ok{};
    }

    var printed: u32 = 0;
    val res_dst: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.dst, printed);
    if (sel res_dst.err) { ret err[fail.Fail].err{res_dst.err}; }
    printed = res_dst.ok;

    val res_src1: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.src1, printed);
    if (sel res_src1.err) { ret err[fail.Fail].err{res_src1.err}; }
    printed = res_src1.ok;

    val res_src2: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.src2, printed);
    if (sel res_src2.err) { ret err[fail.Fail].err{res_src2.err}; }
    ret err[fail.Fail].ok{};
}

fun render_operand(out: *writer.Writer, interner: *intern.Interner, mi: *isa.Inst,
                   op: *isa.Operand, printed: u32) res[u32, fail.Fail] {
    if (op.kind == isa.OPK_NONE) { ret res[u32, fail.Fail].ok{printed}; }

    var sep: str = ", ";
    if (printed == 0) { sep = " "; }
    val res_sep: err[fail.Fail] = emit_str(out, sep);
    if (sel res_sep.err) { ret res[u32, fail.Fail].err{res_sep.err}; }

    val res_: err[fail.Fail] = render_operand_body(out, interner, mi, op);
    if (sel res_.err) { ret res[u32, fail.Fail].err{res_.err}; }
    ret res[u32, fail.Fail].ok{printed + 1};
}

fun render_operand_body(out: *writer.Writer, interner: *intern.Interner, mi: *isa.Inst,
                        op: *isa.Operand) err[fail.Fail] {
    if (op.kind == isa.OPK_REG)   { ret emit_str(out, reg_name(op.reg)); }
    if (op.kind == isa.OPK_IMM)   { ret emit_i64(out, op.imm); }
    if (op.kind == isa.OPK_SYM)   { ret emit_sym(out, interner, op); }
    if (op.kind == isa.OPK_LABEL) { ret emit_target(out, interner, mi, op); }
    if (op.kind == isa.OPK_MEM) {
        val res_disp: err[fail.Fail] = emit_mem_disp(out, interner, mi, op);
        if (sel res_disp.err) { ret res_disp; }
        val res_open: err[fail.Fail] = emit_str(out, "(");
        if (sel res_open.err) { ret res_open; }
        val res_base: err[fail.Fail] = emit_str(out, reg_name(op.base));
        if (sel res_base.err) { ret res_base; }
        ret emit_str(out, ")");
    }
    ret err[fail.Fail].err{fail.message("--emit-asm: riscv64 instruction operand has no renderable kind")};
}

fun emit_mem_disp(out: *writer.Writer, interner: *intern.Interner, mi: *isa.Inst, op: *isa.Operand) err[fail.Fail] {
    if (op.sym_mod == isa.SYM_MOD_NONE) { ret emit_i64(out, op.disp::i64); }
    if ((mi.flags & inst.FLAG_TARGET_BLOCK) == 0) { ret emit_sym(out, interner, op); }

    val res_open: err[fail.Fail] = emit_str(out, modifier_text(op.sym_mod));
    if (sel res_open.err) { ret res_open; }
    val res_blk: err[fail.Fail] = emit_block(out, op.imm::u32);
    if (sel res_blk.err) { ret res_blk; }
    ret emit_str(out, ")");
}

fun emit_target(out: *writer.Writer, interner: *intern.Interner, mi: *isa.Inst, op: *isa.Operand) err[fail.Fail] {
    if ((mi.flags & inst.FLAG_LABEL_SKIP) != 0) {
        val res_dot: err[fail.Fail] = emit_str(out, ".+");
        if (sel res_dot.err) { ret res_dot; }
        ret emit_i64(out, op.imm);
    }
    if ((mi.flags & inst.FLAG_LABEL_LOCAL) != 0 && op.sym_mod == isa.SYM_MOD_NONE) {
        val res_num: err[fail.Fail] = emit_u64(out, op.imm::u64);
        if (sel res_num.err) { ret res_num; }
        if ((mi.flags & inst.FLAG_LABEL_FWD) != 0) { ret emit_str(out, "f"); }
        ret emit_str(out, "b");
    }
    if (op.sym_mod == isa.SYM_MOD_NONE) { ret emit_block(out, op.imm::u32); }

    val res_open: err[fail.Fail] = emit_str(out, modifier_text(op.sym_mod));
    if (sel res_open.err) { ret res_open; }
    val res_blk: err[fail.Fail] = emit_block(out, op.imm::u32);
    if (sel res_blk.err) { ret res_blk; }
    ret emit_str(out, ")");
}

fun emit_sym(out: *writer.Writer, interner: *intern.Interner, op: *isa.Operand) err[fail.Fail] {
    if (op.sym_mod == isa.SYM_MOD_NONE) {
        val res_bare: err[fail.Fail] = emit_name(out, interner, op.sym_id::intern.StrId);
        if (sel res_bare.err) { ret res_bare; }
        ret emit_addend(out, op.sym_addend);
    }
    val res_open: err[fail.Fail] = emit_str(out, modifier_text(op.sym_mod));
    if (sel res_open.err) { ret res_open; }
    val res_name: err[fail.Fail] = emit_name(out, interner, op.sym_id::intern.StrId);
    if (sel res_name.err) { ret res_name; }
    val res_add: err[fail.Fail] = emit_addend(out, op.sym_addend);
    if (sel res_add.err) { ret res_add; }
    ret emit_str(out, ")");
}

fun emit_addend(out: *writer.Writer, addend: i32) err[fail.Fail] {
    if (addend == 0) { ret err[fail.Fail].ok{}; }
    if (addend < 0) {
        val res_neg: err[fail.Fail] = emit_str(out, "-");
        if (sel res_neg.err) { ret res_neg; }
        ret emit_i64(out, 0 - addend::i64);
    }
    val res_pos: err[fail.Fail] = emit_str(out, "+");
    if (sel res_pos.err) { ret res_pos; }
    ret emit_i64(out, addend::i64);
}

fun modifier_text(mod: isa.SymModifier) str {
    if (mod == isa.SYM_MOD_PCREL_HI) { ret "%pcrel_hi("; }
    if (mod == isa.SYM_MOD_PCREL_LO) { ret "%pcrel_lo("; }
    if (mod == isa.SYM_MOD_GOT_HI)   { ret "%got_pcrel_hi("; }
    if (mod == isa.SYM_MOD_GOT_LO)   { ret "%got_pcrel_lo("; }
    ret "";
}

fun ordering_suffix(flags: u16) str {
    val aq: bool = (flags & inst.FLAG_AQ) != 0;
    val rl: bool = (flags & inst.FLAG_RL) != 0;
    if (aq && rl) { ret ".aqrl"; }
    if (aq)       { ret ".aq"; }
    if (rl)       { ret ".rl"; }
    ret "";
}

fun emit_block(out: *writer.Writer, id: u32) err[fail.Fail] {
    val res_dot: err[fail.Fail] = emit_str(out, ".");
    if (sel res_dot.err) { ret res_dot; }
    ret emit_u64(out, id::u64);
}

fun reg_name(id: i32) str {
    if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM) { ret fp_name(isa.regid_index(id)::u32); }
    ret gp_name(id::u32);
}

pub fun gp_name(idx: u32) str {
    if (idx == 0)  { ret "zero"; }
    if (idx == 1)  { ret "ra"; }
    if (idx == 2)  { ret "sp"; }
    if (idx == 3)  { ret "gp"; }
    if (idx == 4)  { ret "tp"; }
    if (idx == 5)  { ret "t0"; }
    if (idx == 6)  { ret "t1"; }
    if (idx == 7)  { ret "t2"; }
    if (idx == 8)  { ret "s0"; }
    if (idx == 9)  { ret "s1"; }
    if (idx == 10) { ret "a0"; }
    if (idx == 11) { ret "a1"; }
    if (idx == 12) { ret "a2"; }
    if (idx == 13) { ret "a3"; }
    if (idx == 14) { ret "a4"; }
    if (idx == 15) { ret "a5"; }
    if (idx == 16) { ret "a6"; }
    if (idx == 17) { ret "a7"; }
    if (idx == 18) { ret "s2"; }
    if (idx == 19) { ret "s3"; }
    if (idx == 20) { ret "s4"; }
    if (idx == 21) { ret "s5"; }
    if (idx == 22) { ret "s6"; }
    if (idx == 23) { ret "s7"; }
    if (idx == 24) { ret "s8"; }
    if (idx == 25) { ret "s9"; }
    if (idx == 26) { ret "s10"; }
    if (idx == 27) { ret "s11"; }
    if (idx == 28) { ret "t3"; }
    if (idx == 29) { ret "t4"; }
    if (idx == 30) { ret "t5"; }
    if (idx == 31) { ret "t6"; }
    ret "x?";
}

pub fun fp_name(idx: u32) str {
    if (idx == 0)  { ret "ft0"; }
    if (idx == 1)  { ret "ft1"; }
    if (idx == 2)  { ret "ft2"; }
    if (idx == 3)  { ret "ft3"; }
    if (idx == 4)  { ret "ft4"; }
    if (idx == 5)  { ret "ft5"; }
    if (idx == 6)  { ret "ft6"; }
    if (idx == 7)  { ret "ft7"; }
    if (idx == 8)  { ret "fs0"; }
    if (idx == 9)  { ret "fs1"; }
    if (idx == 10) { ret "fa0"; }
    if (idx == 11) { ret "fa1"; }
    if (idx == 12) { ret "fa2"; }
    if (idx == 13) { ret "fa3"; }
    if (idx == 14) { ret "fa4"; }
    if (idx == 15) { ret "fa5"; }
    if (idx == 16) { ret "fa6"; }
    if (idx == 17) { ret "fa7"; }
    if (idx == 18) { ret "fs2"; }
    if (idx == 19) { ret "fs3"; }
    if (idx == 20) { ret "fs4"; }
    if (idx == 21) { ret "fs5"; }
    if (idx == 22) { ret "fs6"; }
    if (idx == 23) { ret "fs7"; }
    if (idx == 24) { ret "fs8"; }
    if (idx == 25) { ret "fs9"; }
    if (idx == 26) { ret "fs10"; }
    if (idx == 27) { ret "fs11"; }
    if (idx == 28) { ret "ft8"; }
    if (idx == 29) { ret "ft9"; }
    if (idx == 30) { ret "ft10"; }
    if (idx == 31) { ret "ft11"; }
    ret "f?";
}

pub fun mnemonic(op: inst.MachOp) str {
    if (op == inst.ADD)  { ret "add"; }
    if (op == inst.SUB)  { ret "sub"; }
    if (op == inst.SLL)  { ret "sll"; }
    if (op == inst.SLT)  { ret "slt"; }
    if (op == inst.SLTU) { ret "sltu"; }
    if (op == inst.XOR)  { ret "xor"; }
    if (op == inst.SRL)  { ret "srl"; }
    if (op == inst.SRA)  { ret "sra"; }
    if (op == inst.OR)   { ret "or"; }
    if (op == inst.AND)  { ret "and"; }

    if (op == inst.ADDW) { ret "addw"; }
    if (op == inst.SUBW) { ret "subw"; }
    if (op == inst.SLLW) { ret "sllw"; }
    if (op == inst.SRLW) { ret "srlw"; }
    if (op == inst.SRAW) { ret "sraw"; }

    if (op == inst.MUL)    { ret "mul"; }
    if (op == inst.MULH)   { ret "mulh"; }
    if (op == inst.MULHSU) { ret "mulhsu"; }
    if (op == inst.MULHU)  { ret "mulhu"; }
    if (op == inst.DIV)    { ret "div"; }
    if (op == inst.DIVU)   { ret "divu"; }
    if (op == inst.REM)    { ret "rem"; }
    if (op == inst.REMU)   { ret "remu"; }

    if (op == inst.MULW)  { ret "mulw"; }
    if (op == inst.DIVW)  { ret "divw"; }
    if (op == inst.DIVUW) { ret "divuw"; }
    if (op == inst.REMW)  { ret "remw"; }
    if (op == inst.REMUW) { ret "remuw"; }

    if (op == inst.ADDI)  { ret "addi"; }
    if (op == inst.SLTI)  { ret "slti"; }
    if (op == inst.SLTIU) { ret "sltiu"; }
    if (op == inst.XORI)  { ret "xori"; }
    if (op == inst.ORI)   { ret "ori"; }
    if (op == inst.ANDI)  { ret "andi"; }
    if (op == inst.SLLI)  { ret "slli"; }
    if (op == inst.SRLI)  { ret "srli"; }
    if (op == inst.SRAI)  { ret "srai"; }

    if (op == inst.ADDIW) { ret "addiw"; }
    if (op == inst.SLLIW) { ret "slliw"; }
    if (op == inst.SRLIW) { ret "srliw"; }
    if (op == inst.SRAIW) { ret "sraiw"; }

    if (op == inst.LB)  { ret "lb"; }
    if (op == inst.LH)  { ret "lh"; }
    if (op == inst.LW)  { ret "lw"; }
    if (op == inst.LD)  { ret "ld"; }
    if (op == inst.LBU) { ret "lbu"; }
    if (op == inst.LHU) { ret "lhu"; }
    if (op == inst.LWU) { ret "lwu"; }

    if (op == inst.SB) { ret "sb"; }
    if (op == inst.SH) { ret "sh"; }
    if (op == inst.SW) { ret "sw"; }
    if (op == inst.SD) { ret "sd"; }

    if (op == inst.BEQ)  { ret "beq"; }
    if (op == inst.BNE)  { ret "bne"; }
    if (op == inst.BLT)  { ret "blt"; }
    if (op == inst.BGE)  { ret "bge"; }
    if (op == inst.BLTU) { ret "bltu"; }
    if (op == inst.BGEU) { ret "bgeu"; }

    if (op == inst.JAL)  { ret "jal"; }
    if (op == inst.JALR) { ret "jalr"; }

    if (op == inst.LUI)   { ret "lui"; }
    if (op == inst.AUIPC) { ret "auipc"; }

    if (op == inst.ECALL)  { ret "ecall"; }
    if (op == inst.EBREAK) { ret "ebreak"; }
    if (op == inst.FENCE)  { ret "fence"; }
    if (op == inst.PAUSE)  { ret "pause"; }

    if (op == inst.FLW) { ret "flw"; }
    if (op == inst.FLD) { ret "fld"; }
    if (op == inst.FSW) { ret "fsw"; }
    if (op == inst.FSD) { ret "fsd"; }

    if (op == inst.FADD_S) { ret "fadd.s"; }
    if (op == inst.FADD_D) { ret "fadd.d"; }
    if (op == inst.FSUB_S) { ret "fsub.s"; }
    if (op == inst.FSUB_D) { ret "fsub.d"; }
    if (op == inst.FMUL_S) { ret "fmul.s"; }
    if (op == inst.FMUL_D) { ret "fmul.d"; }
    if (op == inst.FDIV_S) { ret "fdiv.s"; }
    if (op == inst.FDIV_D) { ret "fdiv.d"; }

    if (op == inst.FSGNJ_S)  { ret "fsgnj.s"; }
    if (op == inst.FSGNJ_D)  { ret "fsgnj.d"; }
    if (op == inst.FSGNJN_S) { ret "fsgnjn.s"; }
    if (op == inst.FSGNJN_D) { ret "fsgnjn.d"; }
    if (op == inst.FSGNJX_S) { ret "fsgnjx.s"; }
    if (op == inst.FSGNJX_D) { ret "fsgnjx.d"; }

    if (op == inst.FEQ_S) { ret "feq.s"; }
    if (op == inst.FEQ_D) { ret "feq.d"; }
    if (op == inst.FLT_S) { ret "flt.s"; }
    if (op == inst.FLT_D) { ret "flt.d"; }
    if (op == inst.FLE_S) { ret "fle.s"; }
    if (op == inst.FLE_D) { ret "fle.d"; }

    if (op == inst.FCVT_S_D) { ret "fcvt.s.d"; }
    if (op == inst.FCVT_D_S) { ret "fcvt.d.s"; }

    if (op == inst.FCVT_W_S)  { ret "fcvt.w.s"; }
    if (op == inst.FCVT_WU_S) { ret "fcvt.wu.s"; }
    if (op == inst.FCVT_L_S)  { ret "fcvt.l.s"; }
    if (op == inst.FCVT_LU_S) { ret "fcvt.lu.s"; }
    if (op == inst.FCVT_W_D)  { ret "fcvt.w.d"; }
    if (op == inst.FCVT_WU_D) { ret "fcvt.wu.d"; }
    if (op == inst.FCVT_L_D)  { ret "fcvt.l.d"; }
    if (op == inst.FCVT_LU_D) { ret "fcvt.lu.d"; }

    if (op == inst.FCVT_S_W)  { ret "fcvt.s.w"; }
    if (op == inst.FCVT_S_WU) { ret "fcvt.s.wu"; }
    if (op == inst.FCVT_S_L)  { ret "fcvt.s.l"; }
    if (op == inst.FCVT_S_LU) { ret "fcvt.s.lu"; }
    if (op == inst.FCVT_D_W)  { ret "fcvt.d.w"; }
    if (op == inst.FCVT_D_WU) { ret "fcvt.d.wu"; }
    if (op == inst.FCVT_D_L)  { ret "fcvt.d.l"; }
    if (op == inst.FCVT_D_LU) { ret "fcvt.d.lu"; }

    if (op == inst.FMV_X_W) { ret "fmv.x.w"; }
    if (op == inst.FMV_X_D) { ret "fmv.x.d"; }
    if (op == inst.FMV_W_X) { ret "fmv.w.x"; }
    if (op == inst.FMV_D_X) { ret "fmv.d.x"; }

    if (op == inst.LR_W) { ret "lr.w"; }
    if (op == inst.LR_D) { ret "lr.d"; }
    if (op == inst.SC_W) { ret "sc.w"; }
    if (op == inst.SC_D) { ret "sc.d"; }

    if (op == inst.AMOSWAP_W) { ret "amoswap.w"; }
    if (op == inst.AMOSWAP_D) { ret "amoswap.d"; }
    if (op == inst.AMOADD_W)  { ret "amoadd.w"; }
    if (op == inst.AMOADD_D)  { ret "amoadd.d"; }
    if (op == inst.AMOXOR_W)  { ret "amoxor.w"; }
    if (op == inst.AMOXOR_D)  { ret "amoxor.d"; }
    if (op == inst.AMOAND_W)  { ret "amoand.w"; }
    if (op == inst.AMOAND_D)  { ret "amoand.d"; }
    if (op == inst.AMOOR_W)   { ret "amoor.w"; }
    if (op == inst.AMOOR_D)   { ret "amoor.d"; }
    if (op == inst.AMOMIN_W)  { ret "amomin.w"; }
    if (op == inst.AMOMIN_D)  { ret "amomin.d"; }
    if (op == inst.AMOMAX_W)  { ret "amomax.w"; }
    if (op == inst.AMOMAX_D)  { ret "amomax.d"; }
    if (op == inst.AMOMINU_W) { ret "amominu.w"; }
    if (op == inst.AMOMINU_D) { ret "amominu.d"; }
    if (op == inst.AMOMAXU_W) { ret "amomaxu.w"; }
    if (op == inst.AMOMAXU_D) { ret "amomaxu.d"; }

    if (op == inst.CSRRW)  { ret "csrrw"; }
    if (op == inst.CSRRS)  { ret "csrrs"; }
    if (op == inst.CSRRC)  { ret "csrrc"; }
    if (op == inst.CSRRWI) { ret "csrrwi"; }
    if (op == inst.CSRRSI) { ret "csrrsi"; }
    if (op == inst.CSRRCI) { ret "csrrci"; }
    ret nil;
}

fun emit_str(out: *writer.Writer, s: str) err[fail.Fail] {
    val res_write: res[usize, writer.WriteError] = format.write_str(out, s);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_u64(out: *writer.Writer, n: u64) err[fail.Fail] {
    val res_write: res[usize, writer.WriteError] = format.write_u64(out, n);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_i64(out: *writer.Writer, n: i64) err[fail.Fail] {
    val res_write: res[usize, writer.WriteError] = format.write_i64(out, n);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_name(out: *writer.Writer, interner: *intern.Interner, id: intern.StrId) err[fail.Fail] {
    val opt_name: opt[str] = intern.lookup_typed(interner, id);
    if (sel opt_name.none) {
        ret err[fail.Fail].err{fail.message("--emit-asm: a symbol name did not resolve in the interner")};
    }
    ret emit_str(out, opt_name.some);
}

var test_sink_buf: [4096]u8;
var test_sink_len: usize = 0;

pub fun test_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    var i: usize = 0;
    for (i < len) {
        if (test_sink_len < 4095) {
            test_sink_buf[test_sink_len] = buf[i];
            test_sink_len = test_sink_len + 1;
        }
        i = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

pub fun test_sink_reset() {
    test_sink_len = 0;
}

pub fun test_sink_text() str {
    test_sink_buf[test_sink_len] = 0;
    ret (?test_sink_buf[0])::str;
}

test "mach.lang.target.isa.riscv.printer.names:abi_mnemonics" {
    if (!str_equals(gp_name(0), "zero"))  { ret 1; }
    if (!str_equals(gp_name(1), "ra"))    { ret 1; }
    if (!str_equals(gp_name(2), "sp"))    { ret 1; }
    if (!str_equals(gp_name(8), "s0"))    { ret 1; }
    if (!str_equals(gp_name(10), "a0"))   { ret 1; }
    if (!str_equals(gp_name(5), "t0"))    { ret 1; }
    if (!str_equals(gp_name(17), "a7"))   { ret 1; }
    if (!str_equals(gp_name(31), "t6"))   { ret 1; }
    if (!str_equals(gp_name(99), "x?"))   { ret 1; }

    if (!str_equals(fp_name(0), "ft0"))   { ret 1; }
    if (!str_equals(fp_name(8), "fs0"))   { ret 1; }
    if (!str_equals(fp_name(10), "fa0"))  { ret 1; }
    if (!str_equals(fp_name(31), "ft11")) { ret 1; }
    if (!str_equals(fp_name(99), "f?"))   { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.printer.render_inst:rounding_mode_is_named" {
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;

    val a0:  isa.Operand = isa.make_reg(10, 8);
    val fa0: isa.Operand = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 10), 8);

    var f2i: isa.Inst = isa.inst_blank();
    f2i.opcode = inst.FCVT_W_S::u16;
    f2i.size   = 4;
    f2i.dst    = a0;
    f2i.src1   = fa0;
    test_sink_reset();
    val r_545: err[fail.Fail] = render_inst(?w, nil, ?f2i);
    if (sel r_545.err) { ret 1; }
    if (!str_equals(test_sink_text(), "  fcvt.w.s a0, fa0, rtz\n")) { ret 1; }

    var i2f: isa.Inst = isa.inst_blank();
    i2f.opcode = inst.FCVT_S_W::u16;
    i2f.size   = 4;
    i2f.dst    = fa0;
    i2f.src1   = a0;
    test_sink_reset();
    val r_554: err[fail.Fail] = render_inst(?w, nil, ?i2f);
    if (sel r_554.err) { ret 1; }
    if (!str_equals(test_sink_text(), "  fcvt.s.w fa0, a0\n")) { ret 1; }

    if (!str_equals(rounding_operand(inst.FCVT_LU_D), ", rtz")) { ret 1; }
    if (!str_equals(rounding_operand(inst.FCVT_W_D), ", rtz"))  { ret 1; }
    if (!str_equals(rounding_operand(inst.FADD_D), ""))   { ret 1; }
    if (!str_equals(rounding_operand(inst.FCVT_S_D), "")) { ret 1; }
    if (!str_equals(rounding_operand(inst.FMV_X_W), "")) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.printer.mnemonic:opcode_names" {
    if (!str_equals(mnemonic(inst.ADD), "add"))     { ret 1; }
    if (!str_equals(mnemonic(inst.ADDW), "addw"))   { ret 1; }
    if (!str_equals(mnemonic(inst.ADDI), "addi"))   { ret 1; }
    if (!str_equals(mnemonic(inst.ADDIW), "addiw")) { ret 1; }

    if (!str_equals(mnemonic(inst.JAL), "jal"))   { ret 1; }
    if (!str_equals(mnemonic(inst.JALR), "jalr")) { ret 1; }
    if (!str_equals(mnemonic(inst.BLT), "blt"))   { ret 1; }
    if (!str_equals(mnemonic(inst.SD), "sd"))     { ret 1; }
    if (!str_equals(mnemonic(inst.LD), "ld"))     { ret 1; }

    if (!str_equals(mnemonic(inst.FADD_D), "fadd.d"))     { ret 1; }
    if (!str_equals(mnemonic(inst.FSGNJN_S), "fsgnjn.s")) { ret 1; }
    if (!str_equals(mnemonic(inst.FCVT_W_D), "fcvt.w.d")) { ret 1; }
    if (!str_equals(mnemonic(inst.FMV_X_W), "fmv.x.w"))   { ret 1; }

    if (!str_equals(mnemonic(inst.AMOADD_D), "amoadd.d")) { ret 1; }
    if (!str_equals(mnemonic(inst.LR_W), "lr.w"))         { ret 1; }
    if (!str_equals(ordering_suffix(inst.FLAG_AQ), ".aq")) { ret 1; }
    if (!str_equals(ordering_suffix(inst.FLAG_AQ | inst.FLAG_RL), ".aqrl")) { ret 1; }
    if (!str_equals(ordering_suffix(0), "")) { ret 1; }

    if (mnemonic(inst.MOP_NONE) != nil) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.riscv.printer.render_inst:a_symbol_addend_is_part_of_the_address" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val gr: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "g");
    if (sel gr.err) { ret 1; }
    val g: intern.StrId = gr.ok;

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;

    var hi_lo: isa.Inst = isa.inst_blank();
    hi_lo.opcode = inst.AUIPC::u16;
    hi_lo.size   = 8;
    hi_lo.dst    = isa.make_reg(10, 8);
    hi_lo.src1   = isa.make_sym_addend(g::u32, 8, isa.SYM_MOD_PCREL_HI, 0);
    test_sink_reset();
    val r_610: err[fail.Fail] = render_inst(?w, ?itn, ?hi_lo);
    if (sel r_610.err) { intern.dnit(?itn); ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, %pcrel_hi(g)\n"))       { intern.dnit(?itn); ret 1; }

    var hi_hi: isa.Inst = hi_lo;
    hi_hi.src1 = isa.make_sym_addend(g::u32, 8, isa.SYM_MOD_PCREL_HI, 8);
    test_sink_reset();
    val r_616: err[fail.Fail] = render_inst(?w, ?itn, ?hi_hi);
    if (sel r_616.err) { intern.dnit(?itn); ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, %pcrel_hi(g+8)\n"))     { intern.dnit(?itn); ret 1; }

    var hi_neg: isa.Inst = hi_lo;
    hi_neg.src1 = isa.make_sym_addend(g::u32, 8, isa.SYM_MOD_PCREL_HI, 0 - 8);
    test_sink_reset();
    val r_622: err[fail.Fail] = render_inst(?w, ?itn, ?hi_neg);
    if (sel r_622.err) { intern.dnit(?itn); ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, %pcrel_hi(g-8)\n"))     { intern.dnit(?itn); ret 1; }

    var lo_half: isa.Inst = isa.inst_blank();
    lo_half.opcode = inst.ADDI::u16;
    lo_half.size   = 8;
    lo_half.dst    = isa.make_reg(10, 8);
    lo_half.src1   = isa.make_reg(10, 8);
    lo_half.src2   = isa.make_sym_addend(g::u32, 8, isa.SYM_MOD_PCREL_LO, 0);
    test_sink_reset();
    val r_632: err[fail.Fail] = render_inst(?w, ?itn, ?lo_half);
    if (sel r_632.err) { intern.dnit(?itn); ret 1; }
    if (!str_equals(test_sink_text(), "  addi a0, a0, %pcrel_lo(g)\n"))    { intern.dnit(?itn); ret 1; }

    var bare: isa.Inst = isa.inst_blank();
    bare.opcode = inst.AUIPC::u16;
    bare.size   = 8;
    bare.dst    = isa.make_reg(10, 8);
    bare.src1   = isa.make_sym(g::u32, 8);
    bare.src1.sym_addend = 8;
    test_sink_reset();
    val r_642: err[fail.Fail] = render_inst(?w, ?itn, ?bare);
    if (sel r_642.err) { intern.dnit(?itn); ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, g+8\n"))                { intern.dnit(?itn); ret 1; }

    intern.dnit(?itn);
    ret 0;
}
