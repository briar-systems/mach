use mach.lang.fail;
use std.allocator.page;
use std_format: std.format;
use io_writer:  std.io.writer;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;

use mach.lang.intern;
use isa_encode: mach.lang.target.isa.encode;
use isa_inst:   mach.lang.target.isa.inst;
use isa_riscv:  mach.lang.target.isa.riscv;
use mach.lang.target.isa.riscv.inst;

pub fun render_notes(buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val out:   *io_writer.Writer = buf.asm.out;
    val count: u32               = isa_encode.note_count(buf);
    var i:     u32               = 0;
    for (i < count) {
        val res_: err[fail.Fail] = render_note(out, buf.asm.interner, isa_encode.note_at(buf, i));
        if (sel res_.err) { ret res_; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun render_note(out: *io_writer.Writer, interner: *intern.Interner, n: *isa_encode.AsmNote) err[fail.Fail] {
    if (n.kind == isa_encode.ASM_NOTE_FUNC) {
        val res_open: err[fail.Fail] = emit_str(out, "\n# ");
        if (sel res_open.err) { ret res_open; }
        val res_name: err[fail.Fail] = emit_name(out, interner, n.name);
        if (sel res_name.err) { ret res_name; }
        ret emit_str(out, ":\n");
    }
    if (n.kind == isa_encode.ASM_NOTE_BLOCK) {
        val res_label: err[fail.Fail] = emit_block(out, n.id);
        if (sel res_label.err) { ret res_label; }
        ret emit_str(out, ":\n");
    }
    if (n.kind == isa_encode.ASM_NOTE_BYTES) {
        val text: err[fail.Fail] = isa_encode.render_bytes_text(out, ?n.bytes[0], isa_encode.ASM_NOTE_BYTES_WIDTH);
        if (sel text.err) { ret err[fail.Fail].err{text.err}; }
        ret err[fail.Fail].ok{};
    }
    if (n.kind == isa_encode.ASM_NOTE_BARRIER) { ret err[fail.Fail].ok{}; }
    if (n.kind == isa_encode.ASM_NOTE_LABEL) {
        val res_n: err[fail.Fail] = emit_u64(out, n.id::u64);
        if (sel res_n.err) { ret res_n; }
        ret emit_str(out, ":\n");
    }
    ret render_inst(out, interner, ?n.inst);
}

fun render_inst(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst) err[fail.Fail] {
    val res_indent: err[fail.Fail] = emit_str(out, "  ");
    if (sel res_indent.err) { ret res_indent; }

    val mnem: opt[str] = inst.mnemonic(mi.opcode::inst.MachOp);
    if (sel mnem.none) {
        ret err[fail.Fail].err{fail.message("printer: unknown riscv.MachOp tag in the printer")};
    }
    val res_mnem: err[fail.Fail] = emit_str(out, mnem.some);
    if (sel res_mnem.err) { ret res_mnem; }
    val res_order: err[fail.Fail] = emit_str(out, ordering_suffix(mi.flags));
    if (sel res_order.err) { ret res_order; }

    val res_ops: err[fail.Fail] = render_operands(out, interner, mi);
    if (sel res_ops.err) { ret res_ops; }
    val res_rm: err[fail.Fail] = emit_str(out, rounding_operand(mi.opcode::inst.MachOp));
    if (sel res_rm.err) { ret res_rm; }
    ret emit_str(out, "\n");
}

fun rounding_operand(op: inst.MachOp) str {
    if (op >= inst.FCVT_W_S && op <= inst.FCVT_LU_D) { ret ", rtz"; }
    ret "";
}

fun render_operands(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst) err[fail.Fail] {
    # a store spells its value before its address
    if (inst.mem_role(mi.opcode::inst.MachOp) == inst.MEM_STORE) {
        var printed: u32                 = 0;
        val res_src: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.src1, printed);
        if (sel res_src.err) { ret err[fail.Fail].err{res_src.err}; }
        printed = res_src.ok;
        val res_dst: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.dst, printed);
        if (sel res_dst.err) { ret err[fail.Fail].err{res_dst.err}; }
        ret err[fail.Fail].ok{};
    }

    var printed: u32                 = 0;
    val res_dst: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.dst, printed);
    if (sel res_dst.err) { ret err[fail.Fail].err{res_dst.err}; }
    printed = res_dst.ok;

    val res_src1: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.src1, printed);
    if (sel res_src1.err) { ret err[fail.Fail].err{res_src1.err}; }
    printed = res_src1.ok;

    val res_src2: res[u32, fail.Fail] = render_operand(out, interner, mi, ?mi.src2, printed);
    if (sel res_src2.err) { ret err[fail.Fail].err{res_src2.err}; }
    ret err[fail.Fail].ok{};
}

fun render_operand(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst,
    op: *isa_inst.Operand, printed: u32) res[u32, fail.Fail] {
    if (op.kind == isa_inst.OPK_NONE) { ret res[u32, fail.Fail].ok{printed}; }

    var sep: str = ", ";
    if (printed == 0) { sep = " "; }
    val res_sep: err[fail.Fail] = emit_str(out, sep);
    if (sel res_sep.err) { ret res[u32, fail.Fail].err{res_sep.err}; }

    val res_: err[fail.Fail] = render_operand_body(out, interner, mi, op);
    if (sel res_.err) { ret res[u32, fail.Fail].err{res_.err}; }
    ret res[u32, fail.Fail].ok{printed + 1};
}

fun render_operand_body(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst,
    op: *isa_inst.Operand) err[fail.Fail] {
    if (op.kind == isa_inst.OPK_REG)   { ret emit_str(out, reg_name(op.reg)); }
    if (op.kind == isa_inst.OPK_IMM)   { ret emit_i64(out, op.imm); }
    if (op.kind == isa_inst.OPK_SYM)   { ret emit_sym(out, interner, op); }
    if (op.kind == isa_inst.OPK_LABEL) { ret emit_target(out, interner, mi, op); }
    if (op.kind == isa_inst.OPK_MEM) {
        val res_disp: err[fail.Fail] = emit_mem_disp(out, interner, mi, op);
        if (sel res_disp.err) { ret res_disp; }
        val res_open: err[fail.Fail] = emit_str(out, "(");
        if (sel res_open.err) { ret res_open; }
        val res_base: err[fail.Fail] = emit_str(out, reg_name(op.base));
        if (sel res_base.err) { ret res_base; }
        ret emit_str(out, ")");
    }
    ret err[fail.Fail].err{fail.message("printer: riscv64 instruction operand has no renderable kind")};
}

fun emit_mem_disp(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst, op: *isa_inst.Operand) err[fail.Fail] {
    if (op.sym_mod == isa_inst.SYM_MOD_NONE)      { ret emit_i64(out, op.disp::i64); }
    if ((mi.flags & inst.FLAG_TARGET_BLOCK) == 0) { ret emit_sym(out, interner, op); }

    val res_open: err[fail.Fail] = emit_modifier(out, op.sym_mod);
    if (sel res_open.err) { ret res_open; }
    val res_blk: err[fail.Fail] = emit_block(out, op.imm::u32);
    if (sel res_blk.err) { ret res_blk; }
    ret emit_str(out, ")");
}

fun emit_target(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst, op: *isa_inst.Operand) err[fail.Fail] {
    if ((mi.flags & inst.FLAG_LABEL_SKIP) != 0) {
        val res_dot: err[fail.Fail] = emit_str(out, ".+");
        if (sel res_dot.err) { ret res_dot; }
        ret emit_i64(out, op.imm);
    }
    if ((mi.flags & inst.FLAG_LABEL_LOCAL) != 0 && op.sym_mod == isa_inst.SYM_MOD_NONE) {
        val res_num: err[fail.Fail] = emit_u64(out, op.imm::u64);
        if (sel res_num.err)                       { ret res_num; }
        if ((mi.flags & inst.FLAG_LABEL_FWD) != 0) { ret emit_str(out, "f"); }
        ret emit_str(out, "b");
    }
    if (op.sym_mod == isa_inst.SYM_MOD_NONE) { ret emit_block(out, op.imm::u32); }

    val res_open: err[fail.Fail] = emit_modifier(out, op.sym_mod);
    if (sel res_open.err) { ret res_open; }
    val res_blk: err[fail.Fail] = emit_block(out, op.imm::u32);
    if (sel res_blk.err) { ret res_blk; }
    ret emit_str(out, ")");
}

fun emit_sym(out: *io_writer.Writer, interner: *intern.Interner, op: *isa_inst.Operand) err[fail.Fail] {
    if (op.sym_mod == isa_inst.SYM_MOD_NONE) {
        val res_bare: err[fail.Fail] = emit_name(out, interner, op.sym_id::intern.StrId);
        if (sel res_bare.err) { ret res_bare; }
        ret emit_addend(out, op.sym_addend);
    }
    val res_open: err[fail.Fail] = emit_modifier(out, op.sym_mod);
    if (sel res_open.err) { ret res_open; }
    val res_name: err[fail.Fail] = emit_name(out, interner, op.sym_id::intern.StrId);
    if (sel res_name.err) { ret res_name; }
    val res_add: err[fail.Fail] = emit_addend(out, op.sym_addend);
    if (sel res_add.err) { ret res_add; }
    ret emit_str(out, ")");
}

fun emit_addend(out: *io_writer.Writer, addend: i64) err[fail.Fail] {
    if (addend == 0) { ret err[fail.Fail].ok{}; }
    if (addend < 0) {
        val res_neg: err[fail.Fail] = emit_str(out, "-");
        if (sel res_neg.err) { ret res_neg; }
        ret emit_i64(out, 0 - addend);
    }
    val res_pos: err[fail.Fail] = emit_str(out, "+");
    if (sel res_pos.err) { ret res_pos; }
    ret emit_i64(out, addend);
}

# the opener of a symbol modifier, empty for none; absent for a tag outside
# the catalog, which the emitter refuses by name
fun modifier_text(mod: isa_inst.SymModifier) opt[str] {
    if (mod == isa_inst.SYM_MOD_NONE)     { ret opt[str].some{""}; }
    if (mod == isa_inst.SYM_MOD_PCREL_HI) { ret opt[str].some{"%pcrel_hi("}; }
    if (mod == isa_inst.SYM_MOD_PCREL_LO) { ret opt[str].some{"%pcrel_lo("}; }
    if (mod == isa_inst.SYM_MOD_GOT_HI)   { ret opt[str].some{"%got_pcrel_hi("}; }
    if (mod == isa_inst.SYM_MOD_GOT_LO)   { ret opt[str].some{"%got_pcrel_lo("}; }
    ret opt[str].none{};
}

fun emit_modifier(out: *io_writer.Writer, mod: isa_inst.SymModifier) err[fail.Fail] {
    val text: opt[str] = modifier_text(mod);
    if (sel text.none) { ret err[fail.Fail].err{fail.message("printer: unknown isa_inst.SymModifier tag in the riscv64 printer")}; }
    ret emit_str(out, text.some);
}

fun ordering_suffix(flags: u16) str {
    val aq: bool = (flags & inst.FLAG_AQ) != 0;
    val rl: bool = (flags & inst.FLAG_RL) != 0;
    if (aq && rl) { ret ".aqrl"; }
    if (aq)       { ret ".aq"; }
    if (rl)       { ret ".rl"; }
    ret "";
}

fun emit_block(out: *io_writer.Writer, id: u32) err[fail.Fail] {
    val res_dot: err[fail.Fail] = emit_str(out, ".");
    if (sel res_dot.err) { ret res_dot; }
    ret emit_u64(out, id::u64);
}

fun reg_name(id: i32) str {
    if (isa_inst.regid_class(id) == isa_inst.REG_CLASS_ID_FP) { ret fp_name(isa_inst.regid_index(id)::u32); }
    ret gp_name(isa_inst.regid_index(id)::u32);
}

pub fun gp_name(idx: u32) str {
    if (idx >= 32) { ret "x?"; }
    ret isa_riscv.GP_NAMES[idx];
}

pub fun fp_name(idx: u32) str {
    if (idx >= 32) { ret "f?"; }
    ret isa_riscv.FP_NAMES[idx];
}

fun emit_str(out: *io_writer.Writer, s: str) err[fail.Fail] {
    val res_write: res[usize, io_writer.WriteError] = std_format.write_str(out, s);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_u64(out: *io_writer.Writer, n: u64) err[fail.Fail] {
    val res_write: res[usize, io_writer.WriteError] = std_format.write_u64(out, n);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_i64(out: *io_writer.Writer, n: i64) err[fail.Fail] {
    val res_write: res[usize, io_writer.WriteError] = std_format.write_i64(out, n);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_name(out: *io_writer.Writer, interner: *intern.Interner, id: intern.StrId) err[fail.Fail] {
    val opt_name: opt[str] = intern.get(interner, id);
    if (sel opt_name.none) {
        ret err[fail.Fail].err{fail.message("printer: a symbol name did not resolve in the interner")};
    }
    ret emit_str(out, opt_name.some);
}

#[testing]
var test_sink_buf: [4096]u8;
#[testing]
var test_sink:     io_writer.Memory;

# a writer into the test buffer, emptied
#[testing]
pub fun test_sink_writer(w: *io_writer.Writer) {
    @w = io_writer.memory(?test_sink, ?test_sink_buf[0], 4096);
}

#[testing]
pub fun test_sink_reset() {
    test_sink.len = 0;
}

#[testing]
pub fun test_sink_text() str {
    ret io_writer.memory_text(?test_sink);
}

# whether render_inst refuses its arguments
#[testing]
fun t_render_inst_refused(out: *io_writer.Writer, interner: *intern.Interner, mi: *isa_inst.Inst) bool {
    val got: err[fail.Fail] = render_inst(out, interner, mi);
    ret sel got.err;
}

test names__abi_mnemonics {
    if (!str_equals(gp_name(0), "zero")) { ret 1; }
    if (!str_equals(gp_name(1), "ra"))   { ret 1; }
    if (!str_equals(gp_name(2), "sp"))   { ret 1; }
    if (!str_equals(gp_name(8), "s0"))   { ret 1; }
    if (!str_equals(gp_name(10), "a0"))  { ret 1; }
    if (!str_equals(gp_name(5), "t0"))   { ret 1; }
    if (!str_equals(gp_name(17), "a7"))  { ret 1; }
    if (!str_equals(gp_name(31), "t6"))  { ret 1; }
    if (!str_equals(gp_name(99), "x?"))  { ret 1; }

    if (!str_equals(fp_name(0), "ft0"))   { ret 1; }
    if (!str_equals(fp_name(8), "fs0"))   { ret 1; }
    if (!str_equals(fp_name(10), "fa0"))  { ret 1; }
    if (!str_equals(fp_name(31), "ft11")) { ret 1; }
    if (!str_equals(fp_name(99), "f?"))   { ret 1; }
    ret 0;
}

test render_inst__rounding_mode_is_named {
    var w: io_writer.Writer;
    test_sink_writer(?w);

    val a0:  isa_inst.Operand = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10), 8);
    val fa0: isa_inst.Operand = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 10), 8);

    var f2i: isa_inst.Inst = isa_inst.inst_blank();
    f2i.opcode = inst.FCVT_W_S::u16;
    f2i.size   = 4;
    f2i.dst    = a0;
    f2i.src1   = fa0;
    test_sink_reset();
    if (t_render_inst_refused(?w, nil, ?f2i))                       { ret 1; }
    if (!str_equals(test_sink_text(), "  fcvt.w.s a0, fa0, rtz\n")) { ret 1; }

    var i2f: isa_inst.Inst = isa_inst.inst_blank();
    i2f.opcode = inst.FCVT_S_W::u16;
    i2f.size   = 4;
    i2f.dst    = fa0;
    i2f.src1   = a0;
    test_sink_reset();
    if (t_render_inst_refused(?w, nil, ?i2f))                  { ret 1; }
    if (!str_equals(test_sink_text(), "  fcvt.s.w fa0, a0\n")) { ret 1; }

    if (!str_equals(rounding_operand(inst.FCVT_LU_D), ", rtz")) { ret 1; }
    if (!str_equals(rounding_operand(inst.FCVT_W_D), ", rtz"))  { ret 1; }
    if (!str_equals(rounding_operand(inst.FADD_D), ""))         { ret 1; }
    if (!str_equals(rounding_operand(inst.FCVT_S_D), ""))       { ret 1; }
    if (!str_equals(rounding_operand(inst.FMV_X_W), ""))        { ret 1; }
    ret 0;
}

test ordering_suffix__aq_rl_spellings {
    if (!str_equals(ordering_suffix(inst.FLAG_AQ), ".aq"))                  { ret 1; }
    if (!str_equals(ordering_suffix(inst.FLAG_RL), ".rl"))                  { ret 1; }
    if (!str_equals(ordering_suffix(inst.FLAG_AQ | inst.FLAG_RL), ".aqrl")) { ret 1; }
    if (!str_equals(ordering_suffix(0), ""))                                { ret 1; }
    ret 0;
}

test render_inst__a_symbol_addend_is_part_of_the_address {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val gr: res[intern.StrId, A.Error] = intern.add(?itn, "g");
    if (sel gr.err) { ret 1; }
    val g: intern.StrId = gr.ok;

    var w: io_writer.Writer;
    test_sink_writer(?w);

    var hi_lo: isa_inst.Inst = isa_inst.inst_blank();
    hi_lo.opcode = inst.AUIPC::u16;
    hi_lo.size   = 8;
    hi_lo.dst    = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10), 8);
    hi_lo.src1   = isa_inst.make_sym_addend(g::u32, 8, isa_inst.SYM_MOD_PCREL_HI, 0);
    test_sink_reset();
    if (t_render_inst_refused(?w, ?itn, ?hi_lo))                     { ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, %pcrel_hi(g)\n")) { ret 1; }

    var hi_hi: isa_inst.Inst = hi_lo;
    hi_hi.src1 = isa_inst.make_sym_addend(g::u32, 8, isa_inst.SYM_MOD_PCREL_HI, 8);
    test_sink_reset();
    if (t_render_inst_refused(?w, ?itn, ?hi_hi))                       { ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, %pcrel_hi(g+8)\n")) { ret 1; }

    var hi_neg: isa_inst.Inst = hi_lo;
    hi_neg.src1 = isa_inst.make_sym_addend(g::u32, 8, isa_inst.SYM_MOD_PCREL_HI, 0 - 8);
    test_sink_reset();
    if (t_render_inst_refused(?w, ?itn, ?hi_neg))                      { ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, %pcrel_hi(g-8)\n")) { ret 1; }

    var lo_half: isa_inst.Inst = isa_inst.inst_blank();
    lo_half.opcode = inst.ADDI::u16;
    lo_half.size   = 8;
    lo_half.dst    = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10), 8);
    lo_half.src1   = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10), 8);
    lo_half.src2   = isa_inst.make_sym_addend(g::u32, 8, isa_inst.SYM_MOD_PCREL_LO, 0);
    test_sink_reset();
    if (t_render_inst_refused(?w, ?itn, ?lo_half))                      { ret 1; }
    if (!str_equals(test_sink_text(), "  addi a0, a0, %pcrel_lo(g)\n")) { ret 1; }

    var bare: isa_inst.Inst = isa_inst.inst_blank();
    bare.opcode          = inst.AUIPC::u16;
    bare.size            = 8;
    bare.dst             = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10), 8);
    bare.src1            = isa_inst.make_sym(g::u32, 8);
    bare.src1.sym_addend = 8;
    test_sink_reset();
    if (t_render_inst_refused(?w, ?itn, ?bare))             { ret 1; }
    if (!str_equals(test_sink_text(), "  auipc a0, g+8\n")) { ret 1; }

    ret 0;
}
