use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;

use codegen_mir:   mach.lang.be.codegen.mir;
use codegen_rules: mach.lang.be.codegen.rules;
use mach.lang.target.isa;
use isa_riscv: mach.lang.target.isa.riscv;

pub val RULE_COUNT: usize = 68;

pub val COPY_OPCODE_COUNT: usize = 3;

pub val FUSED_CC_COUNT: usize = 6;

pub val RULES: [RULE_COUNT]codegen_rules.Rule = [RULE_COUNT]codegen_rules.Rule{
    codegen_rules.Rule{op: codegen_mir.MIR_ADD, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.ADD::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SUB, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.SUB::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MUL::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MULHU::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_S, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MULH::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_AND, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.AND::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_OR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.OR::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_XOR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.XOR::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_SHL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.SLL::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SHR_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.SRL::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SHR_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.SRA::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_DIV_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_DIV_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DIV_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_DIV_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_REM_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_REM_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_REM_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_REM_U, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_NEG, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.NEG::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_NOT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.NOT::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_MOV, gate: codegen_rules.GATE_ANY, guard: codegen_rules.guard_fp_bank_move, kind: codegen_rules.RULE_RETAG, to: isa_riscv.FMV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MOV, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DECLASSIFY, gate: codegen_rules.GATE_ANY, guard: codegen_rules.guard_fp_bank_move, kind: codegen_rules.RULE_RETAG, to: isa_riscv.FMV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DECLASSIFY, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_BR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.JMP::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_RET, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.RET::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_UNREACHABLE, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: isa_riscv.EBREAK::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CMP_EQ, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_EQ, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_NE, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_NE, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LT_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LT_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LT_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LT_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LE_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LE_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LE_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LE_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MASK_LT_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_MASK_LT_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SELECT, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SELECT, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SELECT_CMP, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SELECT_CMP, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CBR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CBR, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_EQ, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_NE, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LT_S, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LT_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LE_S, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LE_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_ALLOCA, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_LOAD, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_STORE, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_GEP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CALL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_ARG, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CALL_RES, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_PHI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_FADD, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FSUB, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FMUL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FDIV, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FCMP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FNEG, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_BITCAST, gate: codegen_rules.GATE_ANY, guard: codegen_rules.guard_fp_bank_move, kind: codegen_rules.RULE_RETAG, to: isa_riscv.FMV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_BITCAST, gate: codegen_rules.GATE_ANY, guard: guard_identity_copy, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_BITCAST, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_TRUNC, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEXT, gate: codegen_rules.GATE_ANY, guard: guard_identity_copy, kind: codegen_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_ZEXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TRUNC, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_EXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TO_SI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TO_UI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SI_TO_FP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_UI_TO_FP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_ASM, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
};

pub val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    isa_riscv.MOV::u32,
    isa_riscv.FMV::u32,
    codegen_mir.MIR_MOV,
};

pub val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    codegen_mir.MIR_CMP_EQ,
    codegen_mir.MIR_CMP_NE,
    codegen_mir.MIR_CMP_LT_S,
    codegen_mir.MIR_CMP_LT_U,
    codegen_mir.MIR_CMP_LE_S,
    codegen_mir.MIR_CMP_LE_U,
};

pub val PACK: codegen_rules.RulePack = codegen_rules.RulePack{
    name:               "riscv64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction) err[fail.Fail] {
    ret codegen_rules.select_function(?PACK, a, tgt, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret codegen_rules.is_reg_move(?PACK, opcode);
}

# one addi builds a 12-bit signed value and one lui a 32-bit one whose low 12
# bits are zero; any other takes lui and addi or more, the rule the middle end
# hoists a loop's constants by (#3807). the value is read sign-extended from
# its width, as the materialization reads it
pub fun int_imm_fits(value: u64, bits: u32) bool {
    var v: i64 = value:~i64;
    if (bits < 64) {
        val sh: u64 = (64 - bits)::u64;
        v = (v << sh) >> sh;
    }
    if (v >= -2048 && v <= 2047) { ret true; }
    ret (v & 0xFFF) == 0 && v >= -2147483648 && v <= 2147483647;
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == isa_riscv.EBREAK::u32;
}

fun guard_identity_copy(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    if (mi.operand_count != 2)                { ret false; }
    if (mi.opcode == codegen_mir.MIR_BITCAST) { ret mi.width >= tgt.model.gpr_width; }
    ret mi.src_width >= tgt.model.gpr_width;
}

#[testing]
fun fp_preg(idx: i32) codegen_mir.MirOperand {
    ret codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, idx)));
}

test select__opcode_rewrites {
    var bad:   i32 = 0;
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_RISCV64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    var instrs: [14]codegen_mir.MirInstr;
    var ops:    [14][3]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < 14) {
        ops[i][0]               = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]               = codegen_mir.op_preg(codegen_mir.preg_id(11));
        ops[i][2]               = codegen_mir.op_preg(codegen_mir.preg_id(12));
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 3;
        instrs[i].width         = 8;
        i                       = i + 1;
    }

    instrs[0].opcode  = codegen_mir.MIR_ADD;
    instrs[1].opcode  = codegen_mir.MIR_SHL;
    instrs[2].opcode  = codegen_mir.MIR_DIV_S;
    instrs[3].opcode  = codegen_mir.MIR_NEG;
    instrs[4].opcode  = codegen_mir.MIR_CMP_EQ;
    instrs[5].opcode  = codegen_mir.MIR_CBR;
    instrs[6].opcode  = codegen_mir.MIR_FADD;
    instrs[7].opcode  = codegen_mir.MIR_MOV;
    instrs[8].opcode  = codegen_mir.MIR_MOV;
    ops[8][0]         = fp_preg(10);
    ops[8][1]         = fp_preg(11);
    instrs[9].opcode  = codegen_mir.MIR_BITCAST;
    ops[9][0]         = fp_preg(10);
    ops[9][1]         = codegen_mir.op_preg(codegen_mir.preg_id(11));
    instrs[10].opcode = codegen_mir.MIR_BITCAST;
    instrs[13].opcode = codegen_mir.MIR_BITCAST;
    ops[13][0]        = fp_preg(10);
    ops[13][1]        = fp_preg(11);
    instrs[11].opcode = codegen_mir.MIR_BR;
    instrs[12].opcode = codegen_mir.MIR_RET;

    ops[5][1]                = codegen_mir.op_block(0);
    ops[5][2]                = codegen_mir.op_block(1);
    ops[6][0]                = fp_preg(10);
    ops[6][1]                = fp_preg(11);
    ops[6][2]                = fp_preg(12);
    instrs[11].operand_count = 1;
    ops[11][0]               = codegen_mir.op_block(0);
    instrs[12].operand_count = 0;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 14;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (instrs[0].opcode != isa_riscv.ADD::u32)         { bad = 1; }
    if (instrs[1].opcode != isa_riscv.SLL::u32)         { bad = 1; }
    if (instrs[2].opcode != codegen_mir.MIR_SEL_DIV_S)  { bad = 1; }
    if (instrs[3].opcode != isa_riscv.NEG::u32)         { bad = 1; }
    if (instrs[4].opcode != codegen_mir.MIR_SEL_CMP_EQ) { bad = 1; }
    if (instrs[5].opcode != codegen_mir.MIR_SEL_CBR)    { bad = 1; }
    if (instrs[6].opcode != codegen_mir.MIR_FADD)       { bad = 1; }
    if (instrs[7].opcode != isa_riscv.MOV::u32)         { bad = 1; }
    if (instrs[8].opcode != isa_riscv.FMV::u32)         { bad = 1; }
    if (instrs[9].opcode != isa_riscv.FMV::u32)         { bad = 1; }
    if (instrs[10].opcode != codegen_mir.MIR_BITCAST)   { bad = 1; }
    if (instrs[11].opcode != isa_riscv.JMP::u32)        { bad = 1; }
    if (instrs[12].opcode != isa_riscv.RET::u32)        { bad = 1; }
    if (instrs[13].opcode != isa_riscv.FMV::u32)        { bad = 1; }

    ret bad;
}

test is_reg_move__moves_across_banks_and_nothing_else {
    if (!is_reg_move(isa_riscv.MOV::u32))     { ret 1; }
    if (!is_reg_move(isa_riscv.FMV::u32))     { ret 1; }
    if (!is_reg_move(codegen_mir.MIR_MOV))    { ret 1; }
    if (is_reg_move(isa_riscv.ADD::u32))      { ret 1; }
    if (is_reg_move(codegen_mir.MIR_BITCAST)) { ret 1; }
    if (is_reg_move(codegen_mir.MIR_SEXT))    { ret 1; }
    ret 0;
}

test rule_pack__generic_opcode_coverage {
    var tgt: isa.BackendTarget;
    tgt.model.gpr_width = 8;
    val pack: *codegen_rules.RulePack = ?PACK;
    if (pack.rule_count != 68) { ret 1; }

    var reachable: [codegen_mir.SELECTION_REACHABLE_COUNT]u32;
    codegen_mir.selection_reachable(?reachable[0]);

    var eliminated: [codegen_mir.SELECTION_ELIMINATED_COUNT]u32;
    codegen_mir.selection_eliminated(?eliminated[0]);

    var ops: [3]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(10));
    ops[1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
    ops[2] = codegen_mir.op_preg(codegen_mir.preg_id(12));
    var probe: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ADD, ?ops[0], 3, 8, 0);

    var f: codegen_mir.MirFunction;

    var fused: [codegen_mir.SELECTION_FUSED_COUNT]u32;
    codegen_mir.selection_fused(?fused[0]);

    var i: u32 = 0;
    for (i < codegen_mir.SELECTION_REACHABLE_COUNT) {
        probe.opcode = reachable[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < codegen_mir.SELECTION_ELIMINATED_COUNT) {
        probe.opcode = eliminated[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < codegen_mir.SELECTION_FUSED_COUNT) {
        probe.opcode = fused[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    # no lane is ever packed here, so a packed widening multiply has no rule
    var pwide: [codegen_mir.SELECTION_PACKED_WIDENING_COUNT]u32;
    codegen_mir.selection_packed_widening(?pwide[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_WIDENING_COUNT) {
        probe.opcode = pwide[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 2; }
        i = i + 1;
    }
    # no lane range or join is packed here, so neither has a rule
    var perm: [codegen_mir.SELECTION_PACKED_PERMUTE_COUNT]u32;
    codegen_mir.selection_packed_permute(?perm[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_PERMUTE_COUNT) {
        probe.opcode   = perm[i];
        probe.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8);
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 6; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        i              = i + 1;
    }

    var wmul: [codegen_mir.SELECTION_WIDENING_MUL_COUNT]u32;
    codegen_mir.selection_widening_mul(?wmul[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_WIDENING_MUL_COUNT) {
        probe.opcode = wmul[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }

    if (isa_riscv.HAS_FLOAT) {
        var rfloat: [codegen_mir.SELECTION_REACHABLE_FLOAT_COUNT]u32;
        codegen_mir.selection_reachable_float(?rfloat[0]);
        i = 0;
        for (i < codegen_mir.SELECTION_REACHABLE_FLOAT_COUNT) {
            probe.opcode = rfloat[i];
            if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
            i = i + 1;
        }
    }

    if (pack.fused_cbr_cc_count != 6) { ret 1; }
    ret 0;
}

test select__identity_conversions_are_a_move {
    var bad:   i32 = 0;
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_RISCV64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    var instrs: [7]codegen_mir.MirInstr;
    var ops:    [7][2]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < 7) {
        ops[i][0]               = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]               = codegen_mir.op_preg(codegen_mir.preg_id(11));
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 2;
        instrs[i].width         = 8;
        instrs[i].src_width     = 8;
        i                       = i + 1;
    }

    instrs[0].opcode    = codegen_mir.MIR_BITCAST;
    instrs[1].opcode    = codegen_mir.MIR_BITCAST;
    instrs[1].width     = 4;
    instrs[2].opcode    = codegen_mir.MIR_SEXT;
    instrs[3].opcode    = codegen_mir.MIR_SEXT;
    instrs[3].src_width = 4;
    instrs[4].opcode    = codegen_mir.MIR_SEXT;
    instrs[4].src_width = 1;
    instrs[5].opcode    = codegen_mir.MIR_BITCAST;
    ops[5][0]           = fp_preg(10);
    instrs[6].opcode    = codegen_mir.MIR_SEXT;
    instrs[6].width     = 4;
    instrs[6].src_width = 4;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 7;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (instrs[0].opcode != isa_riscv.MOV::u32)      { bad = 1; }
    if (instrs[1].opcode != codegen_mir.MIR_BITCAST) { bad = 1; }
    if (instrs[2].opcode != isa_riscv.MOV::u32)      { bad = 1; }
    if (instrs[3].opcode != codegen_mir.MIR_SEXT)    { bad = 1; }
    if (instrs[4].opcode != codegen_mir.MIR_SEXT)    { bad = 1; }
    if (instrs[5].opcode != isa_riscv.FMV::u32)      { bad = 1; }
    if (instrs[6].opcode != codegen_mir.MIR_SEXT)    { bad = 1; }

    ret bad;
}

# one addi or one lui builds the value; anything else takes two or more (#3807)
test int_imm_fits__one_addi_or_one_lui {
    if (!int_imm_fits(2047, 64) || !int_imm_fits(0xFFFFFFFFFFFFF800, 64)) { ret 1; }
    if (!int_imm_fits(0x7FFFF000, 64) || !int_imm_fits(0xFFFFF000, 32))   { ret 2; }
    if (int_imm_fits(4097, 64) || int_imm_fits(0x80000000, 64))           { ret 3; }
    if (int_imm_fits(0x123456789, 64))                                    { ret 4; }
    ret 0;
}
