use mach.lang.fail;
use mach.lang.float;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

use mach.lang.ct;
use lang_mir:        mach.lang.mir;
use catalog_arch:    mach.lang.target.catalog.arch;
use extension_riscv: mach.lang.target.extension.riscv;
use mach.lang.target.isa;
use mach.lang.target.isa.common;
use isa_inst:     mach.lang.target.isa.inst;
use isa_riscv:    mach.lang.target.isa.riscv;
use riscv_encode: mach.lang.target.isa.riscv.encode;
use riscv_reloc:  mach.lang.target.isa.riscv.reloc;
use riscv_rules:  mach.lang.target.isa.riscv.rules;
use target_model: mach.lang.target.model;
use model_riscv:  mach.lang.target.model.riscv;
use target_of:    mach.lang.target.of;

fun riscv_frame_dist(model: *target_model.Machine, func: *lang_mir.MirFunction, base_dist: *u32, fp_dist: *u32) err[fail.Fail] {
    val flen_bytes: u32 = model.flen_bits / 8;
    val gp_bytes:   u32 = common.popcount32(func.callee_mask) * model.gpr_width;
    val fp_bytes:   u32 = common.popcount32(func.callee_mask_fp) * flen_bytes;
    var reserved:   u32 = gp_bytes + fp_bytes;
    # a frame record holds ra and fp, except in a leaf the stack pointer addresses
    if (!func.frame.sp_frame) { reserved = reserved + 2 * model.gpr_width; }
    # slots are addressed below the saved registers, so that area ends on a stack-aligned boundary
    val stacked: res[u32, fail.Fail] = common.frame_align_up(reserved::u64, 16);
    if (sel stacked.err) { ret err[fail.Fail].err{stacked.err}; }
    val saved: res[u32, fail.Fail] = common.frame_align_up(stacked.ok::u64, func.frame.realign);
    if (sel saved.err) { ret err[fail.Fail].err{saved.err}; }
    val framed: res[u32, fail.Fail] = common.frame_align_up(saved.ok::u64 + func.frame.size::u64 + func.frame.outgoing_size::u64, 16);
    if (sel framed.err) { ret err[fail.Fail].err{framed.err}; }
    val total: res[u32, fail.Fail] = common.frame_align_up(framed.ok::u64, func.frame.realign);
    if (sel total.err) { ret err[fail.Fail].err{total.err}; }
    @fp_dist   = saved.ok;
    @base_dist = total.ok - saved.ok;
    ret err[fail.Fail].ok{};
}

val DWARF_F0: i32 = 32;

fun riscv64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa_inst.regid_class(regid);
    val idx: i32 = isa_inst.regid_index(regid);

    if (cls == isa_inst.REG_CLASS_ID_GP) {
        if (idx >= isa_riscv.X0 && idx <= isa_riscv.X31) { ret idx; }
        ret -1;
    }

    if (cls == isa_inst.REG_CLASS_ID_FP) {
        if (idx >= isa_riscv.F0 && idx <= isa_riscv.F31) { ret DWARF_F0 + idx; }
        ret -1;
    }

    ret -1;
}

val RESERVED64: [6]target_model.Register = [6]target_model.Register{
    target_model.Register{id: isa_riscv.ZERO, size: 8},
    target_model.Register{id: isa_riscv.RA, size: 8},
    target_model.Register{id: isa_riscv.SP, size: 8},
    target_model.Register{id: isa_riscv.GP, size: 8},
    target_model.Register{id: isa_riscv.TP, size: 8},
    target_model.Register{id: isa_riscv.FP, size: 8},
};

val RELOAD_SCRATCH64: [3]target_model.Register = [3]target_model.Register{
    target_model.Register{id: isa_riscv.T2, size: 8},
    target_model.Register{id: isa_riscv.T3, size: 8},
    target_model.Register{id: isa_riscv.T4, size: 8},
};

val RESERVED32: [6]target_model.Register = [6]target_model.Register{
    target_model.Register{id: isa_riscv.ZERO, size: 4},
    target_model.Register{id: isa_riscv.RA, size: 4},
    target_model.Register{id: isa_riscv.SP, size: 4},
    target_model.Register{id: isa_riscv.GP, size: 4},
    target_model.Register{id: isa_riscv.TP, size: 4},
    target_model.Register{id: isa_riscv.FP, size: 4},
};

val RELOAD_SCRATCH32: [3]target_model.Register = [3]target_model.Register{
    target_model.Register{id: isa_riscv.T2, size: 4},
    target_model.Register{id: isa_riscv.T3, size: 4},
    target_model.Register{id: isa_riscv.T4, size: 4},
};

pub val MACHINE64: isa.RegMachine = isa.RegMachine{
    select:               riscv_rules.select,
    encode:               ?riscv_encode.HOOKS,
    is_reg_move:          riscv_rules.is_reg_move,
    is_trap_terminator:   riscv_rules.is_trap_terminator,
    reserved_regs:        ?RESERVED64[0],
    reserved_reg_count:   6,
    reload_scratch_regs:  ?RELOAD_SCRATCH64[0],
    reload_scratch_count: 3,
    scratch_reg:          isa_riscv.SCRATCH_REG,
    scratch_reg2:         isa_riscv.SCRATCH_REG2,
    frame_ptr_reg:        isa_riscv.FP,
    stack_ptr_reg:        isa_riscv.SP,
    incoming_arg_base:    0,
    has_assembly:         true,
    assembly:             isa.AssemblyCapabilities{
        grammar: riscv_encode.grammar,
        returns: riscv_encode.returns,
    },
    dwarf_reg:    riscv64_dwarf_reg,
    frame_dist:   riscv_frame_dist,
    int_imm_fits: riscv_rules.int_imm_fits,
};

pub val MACHINE32: isa.RegMachine = isa.RegMachine{
    select:               riscv_rules.select,
    encode:               ?riscv_encode.HOOKS,
    is_reg_move:          riscv_rules.is_reg_move,
    is_trap_terminator:   riscv_rules.is_trap_terminator,
    reserved_regs:        ?RESERVED32[0],
    reserved_reg_count:   6,
    reload_scratch_regs:  ?RELOAD_SCRATCH32[0],
    reload_scratch_count: 3,
    scratch_reg:          isa_riscv.SCRATCH_REG,
    scratch_reg2:         isa_riscv.SCRATCH_REG2,
    frame_ptr_reg:        isa_riscv.FP,
    stack_ptr_reg:        isa_riscv.SP,
    incoming_arg_base:    0,
    has_assembly:         true,
    assembly:             isa.AssemblyCapabilities{
        grammar: riscv_encode.grammar,
        returns: riscv_encode.returns,
    },
    dwarf_reg:    riscv64_dwarf_reg,
    frame_dist:   riscv_frame_dist,
    int_imm_fits: riscv_rules.int_imm_fits,
};

pub val RELOC: target_of.RelocationCapabilities = target_of.RelocationCapabilities{
    apply:           riscv_reloc.apply_reloc,
    traits:          riscv_reloc.reloc_traits,
    normalize:       riscv_reloc.resolve_riscv_pcrel_pairs,
    resolve_operand: riscv_reloc.resolve_riscv_reloc_operand,
    local_got_kind:  riscv_reloc.is_local_got_kind,
};

pub val VTABLE64: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.RISCV64,
    name:          "riscv64",
    pointer_width: 8,
    page_size:     4096,
    reloc:         ?RELOC,
    machine:       ?MACHINE64,
    model:         ?model_riscv.MACHINE64,
    # a name of the selection syntax narrows the template to its extensions
    extensions_select: model_riscv.features_select,
};

pub val VTABLE32: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.RISCV32,
    name:          "riscv32",
    pointer_width: 4,
    page_size:     4096,
    reloc:         ?RELOC,
    machine:       ?MACHINE32,
    model:         ?model_riscv.MACHINE32,
    # a name of the selection syntax narrows the template to its extensions
    extensions_select: model_riscv.features_select,
};

test vtable64__pairs_its_relocations {
    val riscv64_vtable: *isa.IsaVTable = ?VTABLE64;
    if (riscv64_vtable.reloc == nil)                            { ret 1; }
    if (riscv64_vtable.reloc.normalize == nil)                  { ret 1; }
    if (riscv64_vtable.reloc.resolve_operand == nil)            { ret 1; }
    if (riscv64_vtable.model.extensions != extension_riscv.ALL) { ret 2; }
    ret 0;
}

test machines__both_members_are_wired_alike {
    val m64: *isa.RegMachine = ?MACHINE64;
    val m32: *isa.RegMachine = ?MACHINE32;
    if (m64 == nil || m32 == nil) { ret 1; }
    if (m64 == m32)               { ret 1; }

    if (m64.has_assembly != m32.has_assembly)                                       { ret 1; }
    if ((m64.assembly.header == nil) != (m32.assembly.header == nil))               { ret 1; }
    if ((m64.assembly.grammar == nil) != (m32.assembly.grammar == nil))             { ret 1; }
    if ((m64.assembly.returns == nil) != (m32.assembly.returns == nil))             { ret 1; }
    if ((m64.dwarf_reg == nil) != (m32.dwarf_reg == nil))                           { ret 1; }
    if ((m64.cv_reg == nil) != (m32.cv_reg == nil))                                 { ret 1; }
    if ((m64.select == nil) != (m32.select == nil))                                 { ret 1; }
    if ((m64.encode.encode_function == nil) != (m32.encode.encode_function == nil)) { ret 1; }
    if (!m32.has_assembly || m32.assembly.grammar == nil || m32.dwarf_reg == nil)   { ret 1; }

    if (m64.reserved_regs == m32.reserved_regs)             { ret 1; }
    if (m64.reload_scratch_regs == m32.reload_scratch_regs) { ret 1; }
    if (m64.reserved_reg_count != m32.reserved_reg_count)   { ret 1; }
    if (m32.reserved_regs[0].size != 4)                     { ret 1; }
    if (m64.reserved_regs[0].size != 8)                     { ret 1; }
    if (m32.reserved_regs[0].id != m64.reserved_regs[0].id) { ret 1; }
    if (m32.scratch_reg != m64.scratch_reg)                 { ret 1; }
    ret 0;
}

test riscv64_dwarf_reg__psabi_numbers {
    if (riscv64_dwarf_reg(isa_riscv.X0) != 0)   { ret 1; }
    if (riscv64_dwarf_reg(isa_riscv.RA) != 1)   { ret 1; }
    if (riscv64_dwarf_reg(isa_riscv.SP) != 2)   { ret 1; }
    if (riscv64_dwarf_reg(isa_riscv.FP) != 8)   { ret 1; }
    if (riscv64_dwarf_reg(isa_riscv.X31) != 31) { ret 1; }

    if (riscv64_dwarf_reg(isa_riscv.FRAME_REG) != 8) { ret 1; }

    if (riscv64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, isa_riscv.F0)) != 32)  { ret 1; }
    if (riscv64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, isa_riscv.F31)) != 63) { ret 1; }

    if (riscv64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 32)) != -1) { ret 1; }
    ret 0;
}

test riscv_frame_dist__saved_registers_keep_slots_stack_aligned {
    var model: target_model.Machine;
    model.gpr_width = 8;
    model.flen_bits = 64;
    var func: lang_mir.MirFunction;
    func.frame.size          = 32;
    func.frame.outgoing_size = 0;
    func.frame.realign       = 0;
    func.callee_mask_fp      = 0;
    var saved: u32 = 0;
    for (saved < 5) {
        func.callee_mask = (1::u32 << (saved + 9)) - (1::u32 << 9);
        var base_dist: u32            = 0;
        var fp_dist:   u32            = 0;
        val laid:      err[fail.Fail] = riscv_frame_dist(?model, ?func, ?base_dist, ?fp_dist);
        if (sel laid.err)                    { ret 1; }
        if (fp_dist < 16 + saved * 8)        { ret 1; }
        if (fp_dist % 16 != 0)               { ret 2; }
        if ((fp_dist + base_dist) % 16 != 0) { ret 3; }
        if (base_dist < func.frame.size)     { ret 4; }
        saved = saved + 1;
    }
    func.frame.realign = 32;
    func.callee_mask   = 1::u32 << 9;
    var base_over: u32            = 0;
    var fp_over:   u32            = 0;
    val over:      err[fail.Fail] = riscv_frame_dist(?model, ?func, ?base_over, ?fp_over);
    if (sel over.err)                             { ret 5; }
    if (fp_over % 32 != 0 || base_over % 32 != 0) { ret 5; }
    # a frame whose round-up passes 4 GiB is refused, never wrapped
    func.frame.realign = 0;
    func.frame.size    = 0xFFFFFFDF;
    var base_big: u32            = 0;
    var fp_big:   u32            = 0;
    val big:      err[fail.Fail] = riscv_frame_dist(?model, ?func, ?base_big, ?fp_big);
    if (!sel big.err) { ret 6; }
    ret 0;
}
