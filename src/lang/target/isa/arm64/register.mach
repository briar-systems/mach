use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

use mach.lang.be.codegen.mir;
use mach.lang.ct;
use mach.lang.target.isa;
use mach.lang.target.isa.arm64;
use mach.lang.target.isa.arm64.encode;
use mach.lang.target.isa.arm64.reloc;
use mach.lang.target.isa.arm64.rules;
use mach.lang.target.of;
use mach.lang.target.of.elf;

fun frame_saved(mask: u32) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < 32) {
        if ((mask & (1::u32 << i)) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun frame_align_up(n: u32, align: u32) u32 {
    if (align == 0) { ret n; }
    val mask: u32 = align - 1;
    ret (n + mask) & ~mask;
}

fun arm64_frame_dist(model: *isa.MachineModel, func: *mir.MirFunction, base_dist: *u32, fp_dist: *u32) {
    val gp_bytes: u32 = frame_saved(func.callee_mask) * 8;
    val fp_bytes: u32 = frame_saved(func.callee_mask_fp) * 8;
    var n:        u32 = frame_align_up(gp_bytes + fp_bytes + func.frame.size + func.frame.outgoing_size, 16);
    n          = frame_align_up(n, func.frame.realign);
    @base_dist = n;
    @fp_dist   = 0;
}

fun arm64_elf_reloc_type(kind: of.RelocKind) opt[u32] {
    if (kind == of.RK_ABS64)        { ret opt[u32].some{elf.R_AARCH64_ABS64}; }
    if (kind == of.RK_PC32)         { ret opt[u32].some{elf.R_AARCH64_PREL32}; }
    if (kind == of.RK_PLT32)        { ret opt[u32].some{elf.R_AARCH64_CALL26}; }
    if (kind == of.RK_JUMP26)       { ret opt[u32].some{elf.R_AARCH64_JUMP26}; }
    if (kind == of.RK_PAGE21)       { ret opt[u32].some{elf.R_AARCH64_ADR_PREL_PG_HI21}; }
    if (kind == of.RK_ADD_LO12)     { ret opt[u32].some{elf.R_AARCH64_ADD_ABS_LO12_NC}; }
    if (kind == of.RK_LDST8_LO12)   { ret opt[u32].some{elf.R_AARCH64_LDST8_ABS_LO12_NC}; }
    if (kind == of.RK_LDST16_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST16_ABS_LO12_NC}; }
    if (kind == of.RK_LDST32_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST32_ABS_LO12_NC}; }
    if (kind == of.RK_LDST64_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST64_ABS_LO12_NC}; }
    if (kind == of.RK_LDST128_LO12) { ret opt[u32].some{elf.R_AARCH64_LDST128_ABS_LO12_NC}; }
    if (kind == of.RK_ABS32)        { ret opt[u32].some{elf.R_AARCH64_ABS32}; }
    if (kind == of.RK_GOT_PAGE21)   { ret opt[u32].some{elf.R_AARCH64_ADR_GOT_PAGE}; }
    if (kind == of.RK_GOT_LO12)     { ret opt[u32].some{elf.R_AARCH64_LD64_GOT_LO12_NC}; }
    ret opt[u32].none{};
}

# tests: the declared ELF type, or zero for an absent one
fun reloc_type_or_zero(t: opt[u32]) u32 {
    if (sel t.none) { ret 0; }
    ret t.some;
}

val DWARF_V0: i32 = 64;

fun arm64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa.regid_class(regid);
    val idx: i32 = isa.regid_index(regid);

    if (cls == isa.REG_CLASS_ID_GP) {
        if (idx >= arm64.X0 && idx <= arm64.SP) { ret idx; }
        ret -1;
    }

    if (cls == isa.REG_CLASS_ID_XMM) {
        if (idx >= arm64.V0 && idx <= arm64.V31) { ret DWARF_V0 + idx; }
        ret -1;
    }

    ret -1;
}

pub fun register_arm64(reg: *isa.IsaRegistry) err[fail.Fail] {
    var arm64_classes:             [3]isa.RegClass;
    var arm64_model:               isa.MachineModel;
    var arm64_reserved_regs:       [3]isa.Register;
    var arm64_reload_scratch_regs: [3]isa.Register;

    arm64_classes[0].name = "gpr";
    arm64_classes[0].kind = isa.RC_GENERAL;
    arm64_classes[0].len  = arm64.GPR_COUNT::u32;

    arm64_classes[1].name = "vector";
    arm64_classes[1].kind = isa.RC_FLOAT;
    arm64_classes[1].len  = arm64.VECTOR_COUNT::u32;

    arm64_classes[2].name = "flags";
    arm64_classes[2].kind = isa.RC_FLAGS;
    arm64_classes[2].len  = 1;

    arm64_reserved_regs[0].id   = arm64.SP;
    arm64_reserved_regs[0].size = 8;
    arm64_reserved_regs[1].id   = arm64.FP;
    arm64_reserved_regs[1].size = 8;
    arm64_reserved_regs[2].id   = arm64.LR;
    arm64_reserved_regs[2].size = 8;

    arm64_reload_scratch_regs[0].id   = arm64.X9;
    arm64_reload_scratch_regs[0].size = 8;
    arm64_reload_scratch_regs[1].id   = arm64.X10;
    arm64_reload_scratch_regs[1].size = 8;
    arm64_reload_scratch_regs[2].id   = arm64.X11;
    arm64_reload_scratch_regs[2].size = 8;

    var arm64_machine: isa.RegMachine = isa.reg_machine(
        rules.select,
        encode.encode_arm64,
        rules.is_reg_move,
        rules.is_trap_terminator,
        ?arm64_reserved_regs[0], 3,
        ?arm64_reload_scratch_regs[0], 3,
        arm64.IP0, arm64.IP1,
        arm64.FP, arm64.SP, 16,
        -1, -1, -1);
    isa.with_assembly(?arm64_machine, encode.encode_arm64_asm, encode.asm_clobbers,
        encode.asm_returns, encode.asm_ct_scan);
    isa.with_dwarf_regs(?arm64_machine, arm64_dwarf_reg);
    isa.with_frame_dist(?arm64_machine, arm64_frame_dist);

    var arm64_reloc: isa.RelocSeam = isa.reloc_seam(
        reloc.apply_reloc, reloc.reloc_traits, arm64_elf_reloc_type);
    isa.with_local_got_kinds(?arm64_reloc, reloc.is_local_got_kind);

    var arm64_vtable: isa.IsaVTable = isa.machine_isa(
        isa.ARCH_AARCH64, isa.arch_name_for(isa.ARCH_AARCH64), 183, 8,
        ?arm64_model, ?arm64_machine, ?arm64_reloc);

    arm64_model.pointer_width       = 8;
    arm64_model.max_alu_width       = 8;
    arm64_model.alu_min_width       = 4;
    arm64_model.gpr_width           = 8;
    arm64_model.gp_unaligned_widths = 2 + 4 + 8;
    arm64_model.spill_width         = 8;
    arm64_model.endianness          = isa.ENDIAN_LITTLE;
    arm64_model.flen_bits           = 64;
    arm64_model.has_v128            = true;
    arm64_model.vector_bits         = isa.VECTOR_BITS_128;
    arm64_model.max_vector_lanes    = isa.VECTOR_LANES_UNBOUNDED;
    arm64_model.vec_mem_widths      = isa.VEC_MEM_ALL_128;
    arm64_model.xbank_widths        = isa.XBANK_4_8;
    var arm64_packed_forms: [91]isa.PackedForm;
    arm64_packed_forms[0]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[1]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[2]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[3]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[4]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[5]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[6]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[7]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[8]  = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[9]  = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[10] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[11] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[12] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[13] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[14] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[15] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[16] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[17] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[18] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[19] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[20] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[21] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[22] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[23] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[24] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[25] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[26] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[27] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[28] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[29] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[30] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[31] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[32] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[33] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[34] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[35] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[36] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[37] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[38] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[39] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[40] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64};
    # the NEON conversions agree with the scalar lane conversion bit for bit:
    # lengthening and narrowing are exact, a float lane converts under the same
    # rounding and NaN rules, and a float to integer lane saturates where the
    # scalar fcvtz* does. a 64-bit integer lane has no single-step conversion
    # to a single-precision lane, so those two cells stay the scalar expansion
    arm64_packed_forms[41]      = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[42]      = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[43]      = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[44]      = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[45]      = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[46]      = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[47]      = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[48]      = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[49]      = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[50]      = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[51]      = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[52]      = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[53]      = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16};
    arm64_packed_forms[54]      = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32};
    arm64_packed_forms[55]      = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64};
    arm64_packed_forms[56]      = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[57]      = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64};
    arm64_packed_forms[58]      = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[59]      = isa.PackedForm{op: isa.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[60]      = isa.PackedForm{op: isa.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[61]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[62]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[63]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[64]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[65]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[66]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[67]      = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[68]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[69]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[70]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[71]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[72]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[73]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[74]      = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[75]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 32};
    arm64_packed_forms[76]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[77]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[78]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[79]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 64};
    arm64_packed_forms[80]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 64};
    arm64_packed_forms[81]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[82]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[83]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 8, from_bits: 32};
    arm64_packed_forms[84]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[85]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[86]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[87]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 8, from_bits: 64};
    arm64_packed_forms[88]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 16, from_bits: 64};
    arm64_packed_forms[89]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[90]      = isa.PackedForm{op: isa.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_model.packed_forms    = ?arm64_packed_forms[0];
    arm64_model.packed_form_len = 91;
    # NEON has no 64-bit lane multiply and no packed integer divide
    var arm64_scalar_forms: [57]isa.ScalarForm;
    arm64_scalar_forms[0]              = isa.ScalarForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_scalar_forms[1]              = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_scalar_forms[2]              = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_scalar_forms[3]              = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_scalar_forms[4]              = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_model.scalar_forms           = ?arm64_scalar_forms[0];
    arm64_model.scalar_form_len        = 5 + isa.scalar_conversion_rows(?arm64_model, ?arm64_scalar_forms[0], 5);
    arm64_model.vector_compute_generic = false;
    arm64_model.has_lane_ops           = true;
    # Arm's DIT list names MADD (MUL), SMADDL (SMULL), UMADDL (UMULL), SMULH and UMULH;
    # each holds only with PSTATE.DIT set (#3508 decides it)
    var arm64_ct_mul: [8]ct.CtMulForm = [8]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0}
    };
    arm64_model.ct_mul_forms            = ?arm64_ct_mul[0];
    arm64_model.ct_mul_form_len         = 8;
    arm64_model.has_var_shift           = true;
    arm64_model.has_mul                 = true;
    arm64_model.has_float               = arm64.HAS_FLOAT;
    arm64_model.mul_hi_width            = 0;
    arm64_model.flat_addressing         = true;
    arm64_model.indexed_memory          = false;
    arm64_model.structured_control_flow = false;
    arm64_model.index_width             = 64;
    arm64_model.vector_op_bytes         = 16;
    arm64_model.vectors_in_registers    = true;
    arm64_model.auto_vectorize          = true;
    arm64_model.ct_trust_var_shift      = true;

    arm64_model.reg_classes     = ?arm64_classes[0];
    arm64_model.reg_class_len   = 3;
    arm64_model.frame_ptr_reg   = arm64.FP;
    arm64_model.stack_ptr_reg   = arm64.SP;
    arm64_model.reserved_regs   = ?arm64_reserved_regs[0];
    arm64_model.reserved_len    = 3;
    arm64_model.div_reg         = -1;
    arm64_model.div_hi_reg      = -1;
    arm64_model.shift_count_reg = -1;

    arm64_model.incoming_arg_base = 16;
    arm64_model.stack_align       = 0;
    arm64_model.red_zone          = 0;
    arm64_model.shadow_space      = 0;

    ret isa.register(reg, ?arm64_vtable);
}

test "mach.lang.target.isa.arm64.register.arm64_elf_reloc_type:forward_map" {
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_ABS64)) != elf.R_AARCH64_ABS64)                      { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_PC32)) != elf.R_AARCH64_PREL32)                      { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_PLT32)) != elf.R_AARCH64_CALL26)                     { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_PAGE21)) != elf.R_AARCH64_ADR_PREL_PG_HI21)          { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_ADD_LO12)) != elf.R_AARCH64_ADD_ABS_LO12_NC)         { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_LDST8_LO12)) != elf.R_AARCH64_LDST8_ABS_LO12_NC)     { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_LDST16_LO12)) != elf.R_AARCH64_LDST16_ABS_LO12_NC)   { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_LDST32_LO12)) != elf.R_AARCH64_LDST32_ABS_LO12_NC)   { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_LDST64_LO12)) != elf.R_AARCH64_LDST64_ABS_LO12_NC)   { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_LDST128_LO12)) != elf.R_AARCH64_LDST128_ABS_LO12_NC) { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_ABS32)) != elf.R_AARCH64_ABS32)                      { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_GOT_PAGE21)) != elf.R_AARCH64_ADR_GOT_PAGE)          { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_GOT_LO12)) != elf.R_AARCH64_LD64_GOT_LO12_NC)        { ret 1; }
    if (reloc_type_or_zero(arm64_elf_reloc_type(of.RK_JUMP26)) != elf.R_AARCH64_JUMP26)                    { ret 1; }

    val r_257: opt[u32] = arm64_elf_reloc_type(of.RK_GOTPCREL);
    if (sel r_257.some) { ret 1; }
    val r_258: opt[u32] = arm64_elf_reloc_type(of.RK_ABS32S);
    if (sel r_258.some) { ret 1; }
    val r_259: opt[u32] = arm64_elf_reloc_type(of.RK_ADDR32NB);
    if (sel r_259.some) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.register.arm64_dwarf_reg:aapcs64_numbers" {
    if (arm64_dwarf_reg(arm64.X0) != 0)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X1) != 1)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X29) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.X30) != 30) { ret 1; }
    if (arm64_dwarf_reg(arm64.SP) != 31)  { ret 1; }

    if (arm64_dwarf_reg(arm64.FP) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.LR) != 30) { ret 1; }

    if (arm64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, arm64.V0)) != 64)  { ret 1; }
    if (arm64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, arm64.V31)) != 95) { ret 1; }

    if (arm64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_GP, 32)) != -1) { ret 1; }
    ret 0;
}

# the rows are Arm's DIT multiply list (MADD, SMADDL, UMADDL, SMULH, UMULH), each
# held only with PSTATE.DIT set
test "mach.lang.target.isa.arm64.register.register_arm64:declares_the_dit_multiply_list" {
    var reg: isa.IsaRegistry = isa.registry_init();
    fin { isa.registry_dnit(?reg); }
    val r_reg: err[fail.Fail] = register_arm64(?reg);
    if (sel r_reg.err) { ret 1; }
    val v: opt[*isa.IsaVTable] = isa.lookup(?reg, isa.arch_name_for(isa.ARCH_AARCH64));
    if (sel v.none) { ret 1; }
    val m: *isa.MachineModel = v.some.model;
    if (m.ct_mul_form_len != 8) { ret 2; }
    var want: ct.CtMulMask = ct.mul_mask_none();
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 8, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 16, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_U, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_S, 32, false));
    if (!ct.mul_mask_equals(isa.ct_mul_rows_admit(m, true), want))                { ret 3; }
    if (!ct.mul_mask_equals(isa.ct_mul_rows_admit(m, false), ct.mul_mask_none())) { ret 4; }
    var i: u32 = 0;
    for (i < m.ct_mul_form_len) {
        if (m.ct_mul_forms[i].cond != ct.CT_MUL_DIT_MODE || m.ct_mul_forms[i].ext != 0) { ret 5; }
        i = i + 1;
    }
    ret 0;
}
