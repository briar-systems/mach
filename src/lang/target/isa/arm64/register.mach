use mach.lang.fail;
use mach.lang.float;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

use mach.lang.ct;
use lang_mir:        mach.lang.mir;
use catalog_arch:    mach.lang.target.catalog.arch;
use extension_arm64: mach.lang.target.extension.arm64;
use mach.lang.target.isa;
use mach.lang.target.isa.arm64;
use arm64_encode:    mach.lang.target.isa.arm64.encode;
use isa_arm64_reloc: mach.lang.target.isa.arm64.reloc;
use arm64_rules:     mach.lang.target.isa.arm64.rules;
use mach.lang.target.isa.common;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;
use model_arm64:  mach.lang.target.model.arm64;
use target_of:    mach.lang.target.of;

fun arm64_frame_dist(model: *target_model.Machine, func: *lang_mir.MirFunction, base_dist: *u32, fp_dist: *u32) err[fail.Fail] {
    val gp_bytes: u32                 = common.popcount32(func.callee_mask) * 8;
    val fp_bytes: u32                 = common.popcount32(func.callee_mask_fp) * 8;
    val stacked:  res[u32, fail.Fail] = common.frame_align_up(gp_bytes::u64 + fp_bytes::u64 + func.frame.size::u64 + func.frame.outgoing_size::u64, 16);
    if (sel stacked.err) { ret err[fail.Fail].err{stacked.err}; }
    val n: res[u32, fail.Fail] = common.frame_align_up(stacked.ok::u64, func.frame.realign);
    if (sel n.err) { ret err[fail.Fail].err{n.err}; }
    @base_dist = n.ok;
    @fp_dist   = 0;
    ret err[fail.Fail].ok{};
}

val DWARF_V0: i32 = 64;

fun arm64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa_inst.regid_class(regid);
    val idx: i32 = isa_inst.regid_index(regid);

    if (cls == isa_inst.REG_CLASS_ID_GP) {
        if (idx >= arm64.X0 && idx <= arm64.SP) { ret idx; }
        ret -1;
    }

    if (cls == isa_inst.REG_CLASS_ID_FP) {
        if (idx >= arm64.V0 && idx <= arm64.V31) { ret DWARF_V0 + idx; }
        ret -1;
    }

    ret -1;
}

val RESERVED: [3]target_model.Register = [3]target_model.Register{
    target_model.Register{id: isa_inst.REG_GP_BASE | arm64.SP, size: 8},
    target_model.Register{id: isa_inst.REG_GP_BASE | arm64.FP, size: 8},
    target_model.Register{id: isa_inst.REG_GP_BASE | arm64.LR, size: 8},
};

val RELOAD_SCRATCH: [3]target_model.Register = [3]target_model.Register{
    target_model.Register{id: isa_inst.REG_GP_BASE | arm64.X9, size: 8},
    target_model.Register{id: isa_inst.REG_GP_BASE | arm64.X10, size: 8},
    target_model.Register{id: isa_inst.REG_GP_BASE | arm64.X11, size: 8},
};

pub val MACHINE: isa.RegMachine = isa.RegMachine{
    select:               arm64_rules.select,
    encode:               ?arm64_encode.HOOKS,
    is_reg_move:          arm64_rules.is_reg_move,
    is_trap_terminator:   arm64_rules.is_trap_terminator,
    reserved_regs:        ?RESERVED[0],
    reserved_reg_count:   3,
    reload_scratch_regs:  ?RELOAD_SCRATCH[0],
    reload_scratch_count: 3,
    scratch_reg:          isa_inst.REG_GP_BASE | arm64.IP0,
    scratch_reg2:         isa_inst.REG_GP_BASE | arm64.IP1,
    frame_ptr_reg:        isa_inst.REG_GP_BASE | arm64.FP,
    stack_ptr_reg:        isa_inst.REG_GP_BASE | arm64.SP,
    incoming_arg_base:    16,
    has_assembly:         true,
    assembly:             isa.AssemblyCapabilities{
        grammar: arm64_encode.grammar,
        returns: arm64_encode.returns,
    },
    dwarf_reg:    arm64_dwarf_reg,
    frame_dist:   arm64_frame_dist,
    int_imm_fits: arm64_encode.int_imm_fits,
};

pub val RELOC: target_of.RelocationCapabilities = target_of.RelocationCapabilities{
    apply:          isa_arm64_reloc.apply_reloc,
    traits:         isa_arm64_reloc.reloc_traits,
    local_got_kind: isa_arm64_reloc.is_local_got_kind,
    branch_reach:   isa_arm64_reloc.branch_reach,
    branch_thunk:   isa_arm64_reloc.branch_thunk,
};

pub val VTABLE: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.AARCH64,
    name:          "aarch64",
    pointer_width: 8,
    # the 4 KiB translation granule every aarch64 implementation supports
    page_size: 4096,
    reloc:     ?RELOC,
    machine:   ?MACHINE,
    model:     ?model_arm64.MACHINE,
};

test arm64_dwarf_reg__aapcs64_numbers {
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.X0)) != 0)   { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.X1)) != 1)   { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.X29)) != 29) { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.X30)) != 30) { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.SP)) != 31)  { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.FP)) != 29) { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.LR)) != 30) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V0)) != 64)  { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V31)) != 95) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 32)) != -1) { ret 1; }
    ret 0;
}
