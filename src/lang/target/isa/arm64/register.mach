    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 16, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 64},
    # smull and umull take the low halves of two operand registers into the
    # doubled lanes of one, at every integer operand lane but 64 bits
    target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 32, from_bits: 16},
