fun arm64_frame_dist(model: *target_model.Machine, func: *lang_mir.MirFunction, base_dist: *u32, fp_dist: *u32) err[fail.Fail] {
    val gp_bytes: u32                 = common.popcount32(func.callee_mask) * 8;
    val fp_bytes: u32                 = common.popcount32(func.callee_mask_fp) * 8;
    val stacked:  res[u32, fail.Fail] = common.frame_align_up(gp_bytes + fp_bytes + func.frame.size + func.frame.outgoing_size, 16);
    if (sel stacked.err) { ret err[fail.Fail].err{stacked.err}; }
    val n: res[u32, fail.Fail] = common.frame_align_up(stacked.ok, func.frame.realign);
    if (sel n.err) { ret err[fail.Fail].err{n.err}; }
    @base_dist = n.ok;
    @fp_dist   = 0;
    ret err[fail.Fail].ok{};
}

fun arm64_elf_reloc_type(kind: target_of.RelocKind) opt[u32] {
    if (kind == target_of.RK_ABS64)        { ret opt[u32].some{elf.R_AARCH64_ABS64}; }
    if (kind == target_of.RK_PC32)         { ret opt[u32].some{elf.R_AARCH64_PREL32}; }
    if (kind == target_of.RK_PC64)         { ret opt[u32].some{elf.R_AARCH64_PREL64}; }
    if (kind == target_of.RK_PLT32)        { ret opt[u32].some{elf.R_AARCH64_CALL26}; }
    if (kind == target_of.RK_JUMP26)       { ret opt[u32].some{elf.R_AARCH64_JUMP26}; }
    if (kind == target_of.RK_PAGE21)       { ret opt[u32].some{elf.R_AARCH64_ADR_PREL_PG_HI21}; }
    if (kind == target_of.RK_ADD_LO12)     { ret opt[u32].some{elf.R_AARCH64_ADD_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST8_LO12)   { ret opt[u32].some{elf.R_AARCH64_LDST8_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST16_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST16_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST32_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST32_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST64_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST64_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST128_LO12) { ret opt[u32].some{elf.R_AARCH64_LDST128_ABS_LO12_NC}; }
    if (kind == target_of.RK_ABS32)        { ret opt[u32].some{elf.R_AARCH64_ABS32}; }
    if (kind == target_of.RK_GOT_PAGE21)   { ret opt[u32].some{elf.R_AARCH64_ADR_GOT_PAGE}; }
    if (kind == target_of.RK_GOT_LO12)     { ret opt[u32].some{elf.R_AARCH64_LD64_GOT_LO12_NC}; }
    ret opt[u32].none{};
}

val DWARF_V0: i32 = 64;

fun arm64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa_inst.regid_class(regid);
    val idx: i32 = isa_inst.regid_index(regid);

    if (cls == isa_inst.REG_CLASS_ID_GP) {
        if (idx >= arm64.X0 && idx <= arm64.SP) { ret idx; }
        ret -1;
    }

    if (cls == isa_inst.REG_CLASS_ID_XMM) {
        if (idx >= arm64.V0 && idx <= arm64.V31) { ret DWARF_V0 + idx; }
        ret -1;
    }

    ret -1;
}

pub fun register_arm64(reg: *isa.IsaRegistry) err[fail.Fail] {
    var arm64_classes:             [3]target_model.RegClass;
    var arm64_model:               target_model.Machine;
    var arm64_reserved_regs:       [3]target_model.Register;
    var arm64_reload_scratch_regs: [3]target_model.Register;

    arm64_classes[0].name = "gpr";
    arm64_classes[0].kind = target_model.RC_GENERAL;
    arm64_classes[0].len  = arm64.GPR_COUNT::u32;

    arm64_classes[1].name = "vector";
    arm64_classes[1].kind = target_model.RC_FLOAT;
    arm64_classes[1].len  = arm64.VECTOR_COUNT::u32;

    arm64_classes[2].name = "flags";
    arm64_classes[2].kind = target_model.RC_FLAGS;
    arm64_classes[2].len  = 1;

    arm64_reserved_regs[0].id   = arm64.SP;
    arm64_reserved_regs[0].size = 8;
    arm64_reserved_regs[1].id   = arm64.FP;
    arm64_reserved_regs[1].size = 8;
    arm64_reserved_regs[2].id   = arm64.LR;
    arm64_reserved_regs[2].size = 8;

    arm64_reload_scratch_regs[0].id   = arm64.X9;
    arm64_reload_scratch_regs[0].size = 8;
    arm64_reload_scratch_regs[1].id   = arm64.X10;
    arm64_reload_scratch_regs[1].size = 8;
    arm64_reload_scratch_regs[2].id   = arm64.X11;
    arm64_reload_scratch_regs[2].size = 8;

    var arm64_machine: isa.RegMachine = isa.reg_machine(
        arm64_rules.select,
        arm64_encode.encode_arm64,
        arm64_rules.is_reg_move,
        arm64_rules.is_trap_terminator,
        ?arm64_reserved_regs[0], 3,
        ?arm64_reload_scratch_regs[0], 3,
        arm64.IP0, arm64.IP1,
        arm64.FP, arm64.SP, 16,
        -1, -1, -1);
    isa.with_assembly(?arm64_machine, arm64_encode.encode_arm64_asm, arm64_encode.asm_clobbers,
        arm64_encode.asm_returns, arm64_encode.asm_ct_scan, arm64_encode.asm_writes_sp);
    isa.with_dwarf_regs(?arm64_machine, arm64_dwarf_reg);
    isa.with_frame_dist(?arm64_machine, arm64_frame_dist);
    isa.with_int_imm_rule(?arm64_machine, arm64_encode.int_imm_fits);

    var arm64_reloc: isa.RelocSeam = isa.reloc_seam(
        isa_arm64_reloc.apply_reloc, isa_arm64_reloc.reloc_traits, arm64_elf_reloc_type);
    isa.with_local_got_kinds(?arm64_reloc, isa_arm64_reloc.is_local_got_kind);
    isa.with_branch_thunks(?arm64_reloc, isa_arm64_reloc.branch_reach, isa_arm64_reloc.branch_thunk);

    var arm64_vtable: isa.IsaVTable = isa.machine_isa(
        isa.ARCH_AARCH64, catalog_arch.name_for(isa.ARCH_AARCH64), 183, 8,
        ?arm64_model, ?arm64_machine, ?arm64_reloc);
    # the 4 KiB translation granule every aarch64 implementation supports
    isa.with_page_size(?arm64_vtable, 4096);

    target_model.declare_alu_widths(?arm64_model, target_model.ALU_WIDTHS_4_8);
    arm64_model.pointer_width       = 8;
    arm64_model.gpr_width           = 8;
    arm64_model.gp_unaligned_widths = 2 + 4 + 8;
    arm64_model.spill_width         = 8;
    arm64_model.endianness          = target_model.ENDIAN_LITTLE;
    arm64_model.flen_bits           = 64;
    arm64_model.has_v128            = true;
    arm64_model.vector_bits         = target_model.VECTOR_BITS_128;
    arm64_model.max_vector_lanes    = target_model.VECTOR_LANES_UNBOUNDED;
    arm64_model.vec_mem_widths      = target_model.VEC_MEM_ALL_128;
    arm64_model.xbank_widths        = target_model.XBANK_4_8;
    arm64_model.slot_read_widths    = target_model.SLOT_READ_NONE;
    arm64_model.lifetime_holes      = false;

    # fcvt with FPCR.DN clear, as every os mach targets leaves it
    arm64_model.nan_rule = float.NAN_PRESERVE;
    # a signaling NaN operand takes priority over a quiet one (FPProcessNaNs)
    arm64_model.nan_first_operand = false;

    var arm64_packed_forms: [148]target_model.PackedForm;
    arm64_packed_forms[0]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[1]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[2]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[3]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[4]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[5]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[6]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[7]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[8]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[9]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[10] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[11] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[12] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[13] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[14] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[15] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[16] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[17] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[18] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[19] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[20] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[21] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[22] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[23] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[24] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[25] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[26] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[27] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[28] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[29] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[30] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[31] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[32] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[33] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[34] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[35] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[36] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[37] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[38] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[39] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[40] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64};
    # the NEON conversions agree with the scalar lane conversion bit for bit:
    # lengthening and narrowing are exact, a float lane converts under the same
    # rounding and NaN rules, and a float to integer lane saturates where the
    # scalar fcvtz* does. a 64-bit integer lane has no single-step conversion
    # to a single-precision lane, so those two cells stay the scalar expansion
    arm64_packed_forms[41] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[42] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[43] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[44] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[45] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[46] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[47] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[48] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[49] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[50] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[51] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[52] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[53] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16};
    arm64_packed_forms[54] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32};
    arm64_packed_forms[55] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64};
    arm64_packed_forms[56] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[57] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64};
    arm64_packed_forms[58] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[59] = target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[60] = target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[61] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[62] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[63] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[64] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[65] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[66] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[67] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[68] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    arm64_packed_forms[69] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[70] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[71] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    arm64_packed_forms[72] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    arm64_packed_forms[73] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[74] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[75] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 32};
    arm64_packed_forms[76] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[77] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[78] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[79] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 64};
    arm64_packed_forms[80] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 64};
    arm64_packed_forms[81] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[82] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[83] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 8, from_bits: 32};
    arm64_packed_forms[84] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[85] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[86] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[87] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 8, from_bits: 64};
    arm64_packed_forms[88] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 16, from_bits: 64};
    arm64_packed_forms[89] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 64};
    arm64_packed_forms[90] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 64};
    # smull and umull take the low halves of two operand registers into the
    # doubled lanes of one, at every integer operand lane but 64 bits
    arm64_packed_forms[91] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[92] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[93] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[94] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[95] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[96] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 64, from_bits: 32};
    # sxtl and uxtl lengthen the low half of one register, sxtl2 and uxtl2 the high half
    arm64_packed_forms[97]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[98]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[99]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32};
    arm64_packed_forms[100] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8};
    arm64_packed_forms[101] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[102] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32};
    # ext moves a range of lanes to the bottom of one register, and joins two
    # parts as zip1 when the low part fills a doubleword and otherwise as ext
    # rotating the low part to the top then ext against the high part
    arm64_packed_forms[103] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[104] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[105] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[106] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[107] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[108] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[109] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[110] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[111] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[112] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[113] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[114] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 64, from_bits: 64};
    # f16 lanes: a range or join moves the 16-bit lanes it is, fcvtl and
    # fcvtn convert the low four lanes to and from single precision in the base
    # FP, with the rounding and NaN rule of the scalar fcvt, and FEAT_FP16
    # computes the .8h and .4h arithmetic and comparisons as the scalar h forms do
    arm64_packed_forms[115] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[116] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[117] = target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16};
    arm64_packed_forms[118] = target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32};
    arm64_packed_forms[119] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16};
    arm64_packed_forms[120] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16};
    arm64_packed_forms[121] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16};
    arm64_packed_forms[122] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16};
    arm64_packed_forms[123] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16};
    # every shift cell packs: a constant count is shl, ushr or sshr by
    # the immediate, and any other count is ushl or sshl by a count vector,
    # dup'd from the register for a uniform one. ushl and sshl read each count
    # lane's low byte as signed, so the count is first clamped to 127 by uqshl
    # and ushr, which leaves a count below 128 as it is and makes any larger
    # one 127, at or above every lane width; a right shift then negates it.
    # a count at or above the width shifts every bit out, to 0 or the sign
    # fill, as the scalar shift saturates
    arm64_packed_forms[124]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[125]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[126]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[127]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[128]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[129]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[130]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[131]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[132]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[133]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[134]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[135]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[136]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[137]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[138]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[139]     = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[140]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[141]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[142]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[143]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_packed_forms[144]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 8, from_bits: 8};
    arm64_packed_forms[145]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 16, from_bits: 16};
    arm64_packed_forms[146]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32};
    arm64_packed_forms[147]     = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 64, from_bits: 64};
    arm64_model.packed_forms    = ?arm64_packed_forms[0];
    arm64_model.packed_form_len = 148;
    # fcvt between half and single or double precision is the base FP: it rounds
    # once to nearest even and keeps a NaN's sign and the top of its payload,
    # quieting it, aarch64's PRESERVE rule the expansion follows too (FPCR.DN
    # and AHP clear). FEAT_FP16 adds arithmetic, comparison and the 32- and
    # 64-bit integer conversions on the h registers, each the correctly rounded
    # binary16 result, with a NaN propagated by the rule the binary64 unit applies
    var arm64_half_forms: [17]target_model.PackedForm = [17]target_model.PackedForm{
        target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 64},
        target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 16, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: arm64.EXT_FP16},
        target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: arm64.EXT_FP16},
    };
    arm64_model.half_forms    = ?arm64_half_forms[0];
    arm64_model.half_form_len = 17;
    # NEON has no 64-bit lane multiply and no packed integer divide
    var arm64_scalar_forms: [5]target_model.ScalarForm = [5]target_model.ScalarForm{
        target_model.ScalarForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64},
    };
    # every shift cell and every lane range and join is packed above, so those
    # families leave no row here
    val arm64_rows: err[fail.Fail] = isa.declare_scalar_rows(reg, ?arm64_model, ?arm64_scalar_forms[0], 5,
        target_model.SCALAR_CONVERSIONS | target_model.SCALAR_WIDENING | target_model.SCALAR_SHIFTS | target_model.SCALAR_PERMUTES | target_model.SCALAR_HALF_LANES);
    if (sel arm64_rows.err) { ret arm64_rows; }
    fin { isa.release_scalar_rows(reg, ?arm64_model); }
    arm64_model.vector_compute_generic = false;
    arm64_model.has_lane_ops           = true;
    # Arm ARM (DDI 0487, "About PSTATE.DIT") and the DIT register page (DDI 0601) list the
    # data-processing (3 source) instructions MADD (MUL), MSUB, SMADDL (SMULL), SMSUBL,
    # SMULH, UMADDL (UMULL), UMSUBL and UMULH; each holds only with PSTATE.DIT set, which
    # the os declares it guarantees (os.dit_guaranteed_for: linux and darwin on aarch64)
    # and the linked program's start code turns on when the object marks the need
    #. the 8- and 16-bit low halves are the 32-bit MADD
    var arm64_ct_mul: [8]ct.CtMulForm = [8]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0}
    };
    arm64_model.extensions              = 0;
    arm64_model.extension_table         = ?arm64.EXTENSIONS[0];
    arm64_model.extension_count         = arm64.EXTENSION_COUNT;
    arm64_model.ct_mul_forms            = ?arm64_ct_mul[0];
    arm64_model.ct_mul_form_len         = 8;
    arm64_model.dit_mode                = "PSTATE.DIT";
    arm64_model.has_var_shift           = true;
    arm64_model.shift_count_mod_widths  = target_model.SHIFT_MOD_4_8;
    arm64_model.has_mul                 = true;
    arm64_model.has_float               = arm64.HAS_FLOAT;
    arm64_model.mul_hi_width            = 8;
    arm64_model.int_widths              = target_model.INT_WIDTHS_1_2_4_8_16;
    arm64_model.mul_wide_form           = target_model.MULW_THREE_ADDRESS;
    arm64_model.flat_addressing         = true;
    arm64_model.indexed_memory          = false;
    arm64_model.sym_offset_bits         = 25;
    arm64_model.mem_disp_bits           = 0;
    arm64_model.function_align          = 16;
    arm64_model.code_fill               = 0;
    arm64_model.structured_control_flow = false;
    arm64_model.index_width             = 64;
    arm64_model.vector_op_bytes         = 16;
    arm64_model.vectors_in_registers    = true;
    arm64_model.auto_vectorize          = true;
    arm64_model.ct_trust_var_shift      = true;

    arm64_model.reg_classes     = ?arm64_classes[0];
    arm64_model.reg_class_len   = 3;
    arm64_model.frame_ptr_reg   = arm64.FP;
    arm64_model.stack_ptr_reg   = arm64.SP;
    arm64_model.reserved_regs   = ?arm64_reserved_regs[0];
    arm64_model.reserved_len    = 3;
    arm64_model.div_reg         = -1;
    arm64_model.div_hi_reg      = -1;
    arm64_model.shift_count_reg = -1;
    # NEON shifts every lane width, 8-bit lanes included
    arm64_model.packed_shift_min_bits = 8;

    arm64_model.incoming_arg_base = 16;
    arm64_model.stack_align       = 0;
    arm64_model.red_zone          = 0;
    arm64_model.shadow_space      = 0;

    ret isa.register(reg, ?arm64_vtable);
}

test arm64_elf_reloc_type__forward_map {
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ABS64)) != elf.R_AARCH64_ABS64)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PC32)) != elf.R_AARCH64_PREL32)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PLT32)) != elf.R_AARCH64_CALL26)                     { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PAGE21)) != elf.R_AARCH64_ADR_PREL_PG_HI21)          { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ADD_LO12)) != elf.R_AARCH64_ADD_ABS_LO12_NC)         { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST8_LO12)) != elf.R_AARCH64_LDST8_ABS_LO12_NC)     { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST16_LO12)) != elf.R_AARCH64_LDST16_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST32_LO12)) != elf.R_AARCH64_LDST32_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST64_LO12)) != elf.R_AARCH64_LDST64_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST128_LO12)) != elf.R_AARCH64_LDST128_ABS_LO12_NC) { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ABS32)) != elf.R_AARCH64_ABS32)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_GOT_PAGE21)) != elf.R_AARCH64_ADR_GOT_PAGE)          { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_GOT_LO12)) != elf.R_AARCH64_LD64_GOT_LO12_NC)        { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_JUMP26)) != elf.R_AARCH64_JUMP26)                    { ret 1; }

    val r_257: opt[u32] = arm64_elf_reloc_type(target_of.RK_GOTPCREL);
    if (sel r_257.some) { ret 1; }
    val r_258: opt[u32] = arm64_elf_reloc_type(target_of.RK_ABS32S);
    if (sel r_258.some) { ret 1; }
    val r_259: opt[u32] = arm64_elf_reloc_type(target_of.RK_ADDR32NB);
    if (sel r_259.some) { ret 1; }
    ret 0;
}

test arm64_dwarf_reg__aapcs64_numbers {
    if (arm64_dwarf_reg(arm64.X0) != 0)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X1) != 1)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X29) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.X30) != 30) { ret 1; }
    if (arm64_dwarf_reg(arm64.SP) != 31)  { ret 1; }

    if (arm64_dwarf_reg(arm64.FP) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.LR) != 30) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_XMM, arm64.V0)) != 64)  { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_XMM, arm64.V31)) != 95) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 32)) != -1) { ret 1; }
    ret 0;
}

# the rows are Arm's DIT multiply list (MADD, SMADDL, UMADDL, SMULH, UMULH), each
# held only with PSTATE.DIT set
test register_arm64__declares_the_dit_multiply_list {
    var reg: isa.IsaRegistry = isa.registry_init();
    fin { isa.registry_dnit(?reg); }
    val r_reg: err[fail.Fail] = register_arm64(?reg);
    if (sel r_reg.err) { ret 1; }
    val v: opt[*isa.IsaVTable] = isa.lookup(?reg, catalog_arch.name_for(isa.ARCH_AARCH64));
    if (sel v.none) { ret 1; }
    val m: *target_model.Machine = v.some.model;
    if (m.ct_mul_form_len != 8) { ret 2; }
    var want: ct.CtMulMask = ct.mul_mask_none();
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 8, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 16, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_U, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_S, 32, false));
    # realized, not declared: the full product is mul + umulh/smulh, and the
    # low half of a 128-bit product is the schoolbook over those
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 128, false));
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(m, true), want))                { ret 3; }
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(m, false), ct.mul_mask_none())) { ret 4; }
    var i: u32 = 0;
    for (i < m.ct_mul_form_len) {
        if (m.ct_mul_forms[i].cond != ct.CT_MUL_DIT_MODE || m.ct_mul_forms[i].ext != 0) { ret 5; }
        i = i + 1;
    }
    ret 0;
}
