    target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 64, from_bits: 32},
    # sxtl and uxtl lengthen the low half of one register, sxtl2 and uxtl2 the high half
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32},
    # ext moves a range of lanes to the bottom of one register, and joins two
    # parts as zip1 when the low part fills a doubleword and otherwise as ext
    # rotating the low part to the top then ext against the high part
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 64, from_bits: 64},
    # f16 lanes: a range or join moves the 16-bit lanes it is, fcvtl and
    # fcvtn convert the low four lanes to and from single precision in the base
    # FP, with the rounding and NaN rule of the scalar fcvt, and FEAT_FP16
    # computes the .8h and .4h arithmetic and comparisons as the scalar h forms do
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    # every shift cell packs: a constant count is shl, ushr or sshr by
    # the immediate, and any other count is ushl or sshl by a count vector,
    # dup'd from the register for a uniform one. ushl and sshl read each count
    # lane's low byte as signed, so the count is first clamped to 127 by uqshl
    # and ushr, which leaves a count below 128 as it is and makes any larger
    # one 127, at or above every lane width; a right shift then negates it.
    # a count at or above the width shifts every bit out, to 0 or the sign
    # fill, as the scalar shift saturates
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 64, from_bits: 64},
};

# fcvt between half and single or double precision is the base FP: it rounds
# once to nearest even and keeps a NaN's sign and the top of its payload,
# quieting it, aarch64's PRESERVE rule the expansion follows too (FPCR.DN
# and AHP clear). FEAT_FP16 adds arithmetic, comparison and the 32- and
# 64-bit integer conversions on the h registers, each the correctly rounded
# binary16 result, with a NaN propagated by the rule the binary64 unit applies
val HALF_FORMS: [17]target_model.PackedForm = [17]target_model.PackedForm{
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 16, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: arm64.EXT_FP16},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: arm64.EXT_FP16},
};

# NEON has no 64-bit lane multiply and no packed integer divide
val SCALAR_FORMS: [5]target_model.ScalarForm = [5]target_model.ScalarForm{
    target_model.ScalarForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64},
};

# Arm ARM (DDI 0487, "About PSTATE.DIT") and the DIT register page (DDI 0601) list the
# data-processing (3 source) instructions MADD (MUL), MSUB, SMADDL (SMULL), SMSUBL,
# SMULH, UMADDL (UMULL), UMSUBL and UMULH; each holds only with PSTATE.DIT set, which
# the os declares it guarantees (os.dit_guaranteed_for: linux and darwin on aarch64)
# and the linked program's start code turns on when the object marks the need
#. the 8- and 16-bit low halves are the 32-bit MADD
val CT_MUL: [8]ct.CtMulForm = [8]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 32, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0}
};

val ALU_WIDTHS: [2]target_model.AluWidth = [2]target_model.AluWidth{
    target_model.AluWidth{bytes: 4, ext: 0},
    target_model.AluWidth{bytes: 8, ext: 0},
};

pub val MODEL: target_model.Machine = target_model.Machine{
    pointer_width:          8,
    gpr_width:              8,
    gp_unaligned_widths:    2 + 4 + 8,
    alu_widths:             ?ALU_WIDTHS[0],
    alu_width_len:          2,
    spill_width:            8,
    endianness:             target_model.ENDIAN_LITTLE,
    reg_classes:            ?CLASSES[0],
    reg_class_len:          3,
    frame_ptr_reg:          arm64.FP,
    stack_ptr_reg:          arm64.SP,
    reserved_regs:          ?RESERVED[0],
    reserved_len:           3,
    div_reg:                -1,
    div_hi_reg:             -1,
    shift_count_reg:        -1,
    incoming_arg_base:      16,
    has_v128:               true,
    vector_bits:            target_model.VECTOR_BITS_128,
    max_vector_lanes:       target_model.VECTOR_LANES_UNBOUNDED,
    has_lane_ops:           true,
    vec_mem_widths:         target_model.VEC_MEM_ALL_128,
    xbank_widths:           target_model.XBANK_4_8,
    slot_read_widths:       target_model.SLOT_READ_NONE,
    ct_mul_forms:           ?CT_MUL[0],
    ct_mul_form_len:        8,
    dit_mode:               "PSTATE.DIT",
    has_var_shift:          true,
    shift_count_mod_widths: target_model.SHIFT_MOD_4_8,
    # NEON shifts every lane width, 8-bit lanes included
    packed_shift_min_bits:   8,
    has_mul:                 true,
    has_float:               arm64.HAS_FLOAT,
    mul_hi_width:            8,
    int_widths:              target_model.INT_WIDTHS_1_2_4_8_16,
    mul_wide_form:           target_model.MULW_THREE_ADDRESS,
    flat_addressing:         true,
    indexed_memory:          false,
    sym_offset_bits:         25,
    mem_disp_bits:           0,
    function_align:          16,
    code_fill:               0,
    structured_control_flow: false,
    ct_trust_var_shift:      true,
    packed_forms:            ?PACKED_FORMS[0],
    packed_form_len:         148,
    scalar_forms:            ?SCALAR_FORMS[0],
    scalar_form_len:         5,
    # every shift cell and every lane range and join is packed above, so those
    # families leave no cell here
    scalar_families: target_model.SCALAR_CONVERSIONS | target_model.SCALAR_WIDENING | target_model.SCALAR_SHIFTS | target_model.SCALAR_PERMUTES | target_model.SCALAR_HALF_LANES,
    half_forms:      ?HALF_FORMS[0],
    half_form_len:   17,
    flen_bits:       64,
    # fcvt with FPCR.DN clear, as every os mach targets leaves it
    nan_rule: float.NAN_PRESERVE,
    # a signaling NaN operand takes priority over a quiet one (FPProcessNaNs)
    nan_first_operand:    false,
    extensions:           0,
    extension_table:      ?arm64.EXTENSIONS[0],
    extension_count:      arm64.EXTENSION_COUNT,
    index_width:          64,
    vector_op_bytes:      16,
    vectors_in_registers: true,
    auto_vectorize:       true,
};

pub val MACHINE: isa.RegMachine = isa.RegMachine{
    select:               arm64_rules.select,
    encode:               ?arm64_encode.HOOKS,
    is_reg_move:          arm64_rules.is_reg_move,
    is_trap_terminator:   arm64_rules.is_trap_terminator,
    reserved_regs:        ?RESERVED[0],
    reserved_reg_count:   3,
    reload_scratch_regs:  ?RELOAD_SCRATCH[0],
    reload_scratch_count: 3,
    scratch_reg:          arm64.IP0,
    scratch_reg2:         arm64.IP1,
    frame_ptr_reg:        arm64.FP,
    stack_ptr_reg:        arm64.SP,
    incoming_arg_base:    16,
    div_reg:              -1,
    div_hi_reg:           -1,
    shift_count_reg:      -1,
    has_assembly:         true,
    assembly:             isa.AssemblyCapabilities{
        clobbers:  arm64_encode.asm_clobbers,
        returns:   arm64_encode.asm_returns,
        ct_scan:   arm64_encode.asm_ct_scan,
        writes_sp: arm64_encode.asm_writes_sp,
    },
    dwarf_reg:    arm64_dwarf_reg,
    frame_dist:   arm64_frame_dist,
    int_imm_fits: arm64_encode.int_imm_fits,
};

pub val RELOC: target_of.RelocationCapabilities = target_of.RelocationCapabilities{
    apply:          isa_arm64_reloc.apply_reloc,
    traits:         isa_arm64_reloc.reloc_traits,
    local_got_kind: isa_arm64_reloc.is_local_got_kind,
    branch_reach:   isa_arm64_reloc.branch_reach,
    branch_thunk:   isa_arm64_reloc.branch_thunk,
    elf:            target_of.ElfRelocationCapabilities{reloc_type: arm64_elf_reloc_type},
    has_elf:        true,
};

pub val VTABLE: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.AARCH64,
    name:          "aarch64",
    elf_machine:   183,
    pointer_width: 8,
    # the 4 KiB translation granule every aarch64 implementation supports
    page_size: 4096,
    reloc:     ?RELOC,
    machine:   ?MACHINE,
    model:     ?MODEL,
};

test arm64_elf_reloc_type__forward_map {
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ABS64)) != elf.R_AARCH64_ABS64)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PC32)) != elf.R_AARCH64_PREL32)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PLT32)) != elf.R_AARCH64_CALL26)                     { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PAGE21)) != elf.R_AARCH64_ADR_PREL_PG_HI21)          { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ADD_LO12)) != elf.R_AARCH64_ADD_ABS_LO12_NC)         { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST8_LO12)) != elf.R_AARCH64_LDST8_ABS_LO12_NC)     { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST16_LO12)) != elf.R_AARCH64_LDST16_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST32_LO12)) != elf.R_AARCH64_LDST32_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST64_LO12)) != elf.R_AARCH64_LDST64_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST128_LO12)) != elf.R_AARCH64_LDST128_ABS_LO12_NC) { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ABS32)) != elf.R_AARCH64_ABS32)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_GOT_PAGE21)) != elf.R_AARCH64_ADR_GOT_PAGE)          { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_GOT_LO12)) != elf.R_AARCH64_LD64_GOT_LO12_NC)        { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_JUMP26)) != elf.R_AARCH64_JUMP26)                    { ret 1; }

    val r_257: opt[u32] = arm64_elf_reloc_type(target_of.RK_GOTPCREL);
    if (sel r_257.some) { ret 1; }
    val r_258: opt[u32] = arm64_elf_reloc_type(target_of.RK_ABS32S);
    if (sel r_258.some) { ret 1; }
    val r_259: opt[u32] = arm64_elf_reloc_type(target_of.RK_ADDR32NB);
    if (sel r_259.some) { ret 1; }
    ret 0;
}

test arm64_dwarf_reg__aapcs64_numbers {
    if (arm64_dwarf_reg(arm64.X0) != 0)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X1) != 1)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X29) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.X30) != 30) { ret 1; }
    if (arm64_dwarf_reg(arm64.SP) != 31)  { ret 1; }

    if (arm64_dwarf_reg(arm64.FP) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.LR) != 30) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V0)) != 64)  { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V31)) != 95) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 32)) != -1) { ret 1; }
    ret 0;
}

# the rows are Arm's DIT multiply list (MADD, SMADDL, UMADDL, SMULH, UMULH), each
# held only with PSTATE.DIT set
test model__declares_the_dit_multiply_list {
    val m: *target_model.Machine = ?MODEL;
    if (m.ct_mul_form_len != 8) { ret 2; }
    var want: ct.CtMulMask = ct.mul_mask_none();
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 8, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 16, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_U, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_S, 32, false));
    # realized, not declared: the full product is mul + umulh/smulh, and the
    # low half of a 128-bit product is the schoolbook over those
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 128, false));
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(m, true), want))                { ret 3; }
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(m, false), ct.mul_mask_none())) { ret 4; }
    var i: u32 = 0;
    for (i < m.ct_mul_form_len) {
        if (m.ct_mul_forms[i].cond != ct.CT_MUL_DIT_MODE || m.ct_mul_forms[i].ext != 0) { ret 5; }
        i = i + 1;
    }
    ret 0;
}
