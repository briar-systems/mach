fun arm64_frame_dist(model: *target_model.Machine, func: *lang_mir.MirFunction, base_dist: *u32, fp_dist: *u32) err[fail.Fail] {
    val gp_bytes: u32                 = common.popcount32(func.callee_mask) * 8;
    val fp_bytes: u32                 = common.popcount32(func.callee_mask_fp) * 8;
    val stacked:  res[u32, fail.Fail] = common.frame_align_up(gp_bytes::u64 + fp_bytes::u64 + func.frame.size::u64 + func.frame.outgoing_size::u64, 16);
    if (sel stacked.err) { ret err[fail.Fail].err{stacked.err}; }
    val n: res[u32, fail.Fail] = common.frame_align_up(stacked.ok::u64, func.frame.realign);
    if (sel n.err) { ret err[fail.Fail].err{n.err}; }
    @base_dist = n.ok;
    @fp_dist   = 0;
    ret err[fail.Fail].ok{};
}

fun arm64_elf_reloc_type(kind: target_of.RelocKind) opt[u32] {
    if (kind == target_of.RK_ABS64)        { ret opt[u32].some{elf.R_AARCH64_ABS64}; }
    if (kind == target_of.RK_PC32)         { ret opt[u32].some{elf.R_AARCH64_PREL32}; }
    if (kind == target_of.RK_PC64)         { ret opt[u32].some{elf.R_AARCH64_PREL64}; }
    if (kind == target_of.RK_PLT32)        { ret opt[u32].some{elf.R_AARCH64_CALL26}; }
    if (kind == target_of.RK_JUMP26)       { ret opt[u32].some{elf.R_AARCH64_JUMP26}; }
    if (kind == target_of.RK_PAGE21)       { ret opt[u32].some{elf.R_AARCH64_ADR_PREL_PG_HI21}; }
    if (kind == target_of.RK_ADD_LO12)     { ret opt[u32].some{elf.R_AARCH64_ADD_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST8_LO12)   { ret opt[u32].some{elf.R_AARCH64_LDST8_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST16_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST16_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST32_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST32_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST64_LO12)  { ret opt[u32].some{elf.R_AARCH64_LDST64_ABS_LO12_NC}; }
    if (kind == target_of.RK_LDST128_LO12) { ret opt[u32].some{elf.R_AARCH64_LDST128_ABS_LO12_NC}; }
    if (kind == target_of.RK_ABS32)        { ret opt[u32].some{elf.R_AARCH64_ABS32}; }
    if (kind == target_of.RK_GOT_PAGE21)   { ret opt[u32].some{elf.R_AARCH64_ADR_GOT_PAGE}; }
    if (kind == target_of.RK_GOT_LO12)     { ret opt[u32].some{elf.R_AARCH64_LD64_GOT_LO12_NC}; }
    ret opt[u32].none{};
}

val DWARF_V0: i32 = 64;

fun arm64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa_inst.regid_class(regid);
    val idx: i32 = isa_inst.regid_index(regid);

    if (cls == isa_inst.REG_CLASS_ID_GP) {
        if (idx >= arm64.X0 && idx <= arm64.SP) { ret idx; }
        ret -1;
    }

    if (cls == isa_inst.REG_CLASS_ID_FP) {
        if (idx >= arm64.V0 && idx <= arm64.V31) { ret DWARF_V0 + idx; }
        ret -1;
    }

    ret -1;
}

val RESERVED: [3]target_model.Register = [3]target_model.Register{
    target_model.Register{id: arm64.SP, size: 8},
    target_model.Register{id: arm64.FP, size: 8},
    target_model.Register{id: arm64.LR, size: 8},
};

val RELOAD_SCRATCH: [3]target_model.Register = [3]target_model.Register{
    target_model.Register{id: arm64.X9, size: 8},
    target_model.Register{id: arm64.X10, size: 8},
    target_model.Register{id: arm64.X11, size: 8},
};

pub val MACHINE: isa.RegMachine = isa.RegMachine{
    select:               arm64_rules.select,
    encode:               ?arm64_encode.HOOKS,
    is_reg_move:          arm64_rules.is_reg_move,
    is_trap_terminator:   arm64_rules.is_trap_terminator,
    reserved_regs:        ?RESERVED[0],
    reserved_reg_count:   3,
    reload_scratch_regs:  ?RELOAD_SCRATCH[0],
    reload_scratch_count: 3,
    scratch_reg:          arm64.IP0,
    scratch_reg2:         arm64.IP1,
    frame_ptr_reg:        arm64.FP,
    stack_ptr_reg:        arm64.SP,
    incoming_arg_base:    16,
    has_assembly:         true,
    assembly:             isa.AssemblyCapabilities{
        clobbers:  arm64_encode.asm_clobbers,
        returns:   arm64_encode.asm_returns,
        ct_scan:   arm64_encode.asm_ct_scan,
        writes_sp: arm64_encode.asm_writes_sp,
    },
    dwarf_reg:    arm64_dwarf_reg,
    frame_dist:   arm64_frame_dist,
    int_imm_fits: arm64_encode.int_imm_fits,
};

pub val RELOC: target_of.RelocationCapabilities = target_of.RelocationCapabilities{
    apply:          isa_arm64_reloc.apply_reloc,
    traits:         isa_arm64_reloc.reloc_traits,
    local_got_kind: isa_arm64_reloc.is_local_got_kind,
    branch_reach:   isa_arm64_reloc.branch_reach,
    branch_thunk:   isa_arm64_reloc.branch_thunk,
    elf:            target_of.ElfRelocationCapabilities{reloc_type: arm64_elf_reloc_type},
    has_elf:        true,
};

pub val VTABLE: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.AARCH64,
    name:          "aarch64",
    elf_machine:   183,
    pointer_width: 8,
    # the 4 KiB translation granule every aarch64 implementation supports
    page_size: 4096,
    reloc:     ?RELOC,
    machine:   ?MACHINE,
    model:     ?model_arm64.MACHINE,
};

test arm64_elf_reloc_type__forward_map {
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ABS64)) != elf.R_AARCH64_ABS64)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PC32)) != elf.R_AARCH64_PREL32)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PLT32)) != elf.R_AARCH64_CALL26)                     { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_PAGE21)) != elf.R_AARCH64_ADR_PREL_PG_HI21)          { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ADD_LO12)) != elf.R_AARCH64_ADD_ABS_LO12_NC)         { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST8_LO12)) != elf.R_AARCH64_LDST8_ABS_LO12_NC)     { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST16_LO12)) != elf.R_AARCH64_LDST16_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST32_LO12)) != elf.R_AARCH64_LDST32_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST64_LO12)) != elf.R_AARCH64_LDST64_ABS_LO12_NC)   { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_LDST128_LO12)) != elf.R_AARCH64_LDST128_ABS_LO12_NC) { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_ABS32)) != elf.R_AARCH64_ABS32)                      { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_GOT_PAGE21)) != elf.R_AARCH64_ADR_GOT_PAGE)          { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_GOT_LO12)) != elf.R_AARCH64_LD64_GOT_LO12_NC)        { ret 1; }
    if (common.reloc_type_or_zero(arm64_elf_reloc_type(target_of.RK_JUMP26)) != elf.R_AARCH64_JUMP26)                    { ret 1; }

    val r_257: opt[u32] = arm64_elf_reloc_type(target_of.RK_GOTPCREL);
    if (sel r_257.some) { ret 1; }
    val r_258: opt[u32] = arm64_elf_reloc_type(target_of.RK_ABS32S);
    if (sel r_258.some) { ret 1; }
    val r_259: opt[u32] = arm64_elf_reloc_type(target_of.RK_ADDR32NB);
    if (sel r_259.some) { ret 1; }
    ret 0;
}

test arm64_dwarf_reg__aapcs64_numbers {
    if (arm64_dwarf_reg(arm64.X0) != 0)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X1) != 1)   { ret 1; }
    if (arm64_dwarf_reg(arm64.X29) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.X30) != 30) { ret 1; }
    if (arm64_dwarf_reg(arm64.SP) != 31)  { ret 1; }

    if (arm64_dwarf_reg(arm64.FP) != 29) { ret 1; }
    if (arm64_dwarf_reg(arm64.LR) != 30) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V0)) != 64)  { ret 1; }
    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V31)) != 95) { ret 1; }

    if (arm64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 32)) != -1) { ret 1; }
    ret 0;
}
