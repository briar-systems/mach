    a64_asm_text(?st, ?f, ?labels, "msr DIT, 1");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, 0");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, 15");
    a64_asm_text(?st, ?f, ?labels, "mrs x0, DIT");
    a64_asm_text(?st, ?f, ?labels, "mrs x19, DIT");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, x1");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, x9");
    a64_asm_text(?st, ?f, ?labels, "msr dit, 1");
    a64_asm_text(?st, ?f, ?labels, "mrs x0, dit");

    if (read_word(?st.buf, 0) != 0xD503415F)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0xD503405F)  { bad = 1; }
    if (read_word(?st.buf, 8) != 0xD5034F5F)  { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD53B42A0) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD53B42B3) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD51B42A1) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD51B42A9) { bad = 1; }
    if (read_word(?st.buf, 28) != 0xD503415F) { bad = 1; }
    if (read_word(?st.buf, 32) != 0xD53B42A0) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_directives" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "nop");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd503201f");
    a64_asm_text(?st, ?f, ?labels, ".long 0xd503201f");
    a64_asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03, 0xd5");
    a64_asm_text(?st, ?f, ?labels, ".quad 0xd503201fd503201f");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd53be040");

    if (read_word(?st.buf, 0) != 0xD503201F)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0xD503201F)  { bad = 1; }
    if (read_word(?st.buf, 8) != 0xD503201F)  { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD53BE040) { bad = 1; }
    if (st.buf.len != 28)                     { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_directive_refusals" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".byte 0x1f");
    if (!sel r1.err) { bad = 1; }
    or (sel r1.err) {
        if (!str_contains(fail.describe(r1.err), "whole number of instruction words")) { bad = 1; }
    }

    val r2: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03");
    if (!sel r2.err) { bad = 1; }
    or (sel r2.err) {
        if (!str_contains(fail.describe(r2.err), "whole number of instruction words")) { bad = 1; }
    }

    val r3: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".word 0x1d503201f");
    if (!sel r3.err) { bad = 1; }
    or (sel r3.err) {
        if (!str_contains(fail.describe(r3.err), "cannot hold")) { bad = 1; }
    }

    val r4: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".hword 0x1234");
    if (!sel r4.err) { bad = 1; }
    or (sel r4.err) {
        if (!str_contains(fail.describe(r4.err), "unknown aarch64 inline-asm instruction")) { bad = 1; }
    }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_clobbers_data_directives_are_opaque" {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xd503201f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers(".quad 0xd503201fd503201f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers("nop", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    ret bad;
}

fun t_word(text: str, want: u32) bool {
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r:  err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool           = false;
    if (!sel r.err && st.buf.len == 4) { ok = read_word(?st.buf, 0) == want; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

fun t_word_refused(text: str, want: str) bool {
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r:  err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool           = false;
    if (sel r.err) { ok = str_contains(fail.describe(r.err), want); }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

# goldens from clang 22 (aarch64-linux-gnu) and llvm-objdump
test "mach.lang.target.isa.arm64.encode:inline_asm_vector_forms_are_byte_exact" {
    if (!t_word("ld1 {v0.16b}, [x1]", 0x4C407020))         { ret 1; }
    if (!t_word("ld1 { v3.4s }, [x1], 16", 0x4CDF7823))    { ret 2; }
    if (!t_word("ld1 {v17.2d}, [x2], x9", 0x4CC97C51))     { ret 3; }
    if (!t_word("st1 {v0.16b}, [x1]", 0x4C007020))         { ret 4; }
    if (!t_word("st1 {v3.4s}, [sp], 16", 0x4C9F7BE3))      { ret 5; }
    if (!t_word("st1 {v31.8h}, [x2], x9", 0x4C89745F))     { ret 6; }
    if (!t_word("add v0.4s, v1.4s, v2.4s", 0x4EA28420))    { ret 7; }
    if (!t_word("sub v8.2d, v9.2d, v10.2d", 0x6EEA8528))   { ret 8; }
    if (!t_word("and v0.16b, v1.16b, v2.16b", 0x4E221C20)) { ret 9; }
    if (!t_word("orr v3.16b, v4.16b, v5.16b", 0x4EA51C83)) { ret 10; }
    if (!t_word("eor v6.16b, v7.16b, v8.16b", 0x6E281CE6)) { ret 11; }
    if (!t_word("mov v1.16b, v2.16b", 0x4EA21C41))         { ret 12; }
    if (!t_word("mvn v1.16b, v2.16b", 0x6E205841))         { ret 13; }
    if (!t_word("cmeq v1.8h, v2.8h, v3.8h", 0x6E638C41))   { ret 14; }
    if (!t_word("mul v1.4s, v2.4s, v3.4s", 0x4EA39C41))    { ret 15; }
    if (!t_word("fadd v0.4s, v1.4s, v2.4s", 0x4E22D420))   { ret 16; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_vector_forms_refuse_what_they_cannot_encode" {
    if (!t_word_refused("add x0, v1.4s, v2.4s", "lane arrangement"))                     { ret 1; }
    if (!t_word_refused("add v0.4s, v1.4s, v2.8h", "different lane arrangements"))       { ret 2; }
    if (!t_word_refused("and v0.4s, v1.4s, v2.4s", "no form at this lane arrangement"))  { ret 3; }
    if (!t_word_refused("mul v0.2d, v1.2d, v2.2d", "no form at this lane arrangement"))  { ret 4; }
    if (!t_word_refused("fadd v0.8h, v1.8h, v2.8h", "no form at this lane arrangement")) { ret 5; }
    if (!t_word_refused("ldr x0, [x1, v2.4s]", "malformed inline-asm memory operand"))   { ret 6; }
    if (!t_word_refused("ldr q0, [x1]", "takes general-purpose registers"))              { ret 7; }
    if (!t_word_refused("cmp v0.4s, x1", "takes general-purpose registers"))             { ret 8; }
    if (!t_word_refused("ld1 v0.16b, [x1]", "in braces"))                                { ret 9; }
    if (!t_word_refused("ld1 {q0}, [x1]", "lane arrangement"))                           { ret 10; }
    if (!t_word_refused("ld1 {v0.16b}, [x1], 8", "structure size, 16"))                  { ret 11; }
    if (!t_word_refused("ld1 {v0.16b}, [x1, 16]", "bare [Xn]"))                          { ret 12; }
    if (!t_word_refused("st1 {v0.16b}, [x1]!", "bare [Xn]"))                             { ret 13; }
    if (!t_word_refused("ld1 {v0.16b}, [x1], xzr", "other than xzr and sp"))             { ret 14; }
    if (!t_word_refused("ld1 {v0.16b}, [x1], w9", "other than xzr and sp"))              { ret 15; }
    if (!t_word_refused("mvn v0.4s, v1.4s", "no form at this lane arrangement"))         { ret 16; }
    if (!t_word_refused("add v32.4s, v1.4s, v2.4s", "lane arrangement"))                 { ret 17; }
    ret 0;
}

# one sha2 row under a target selecting `exts` in a function admitting `f_exts`:
# its word, or its refusal text, and the listing when rendering
fun t_sha_run(text: str, exts: u64, f_exts: u64, word: *u32, why: *str, listing: bool) bool {
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;
    f.extensions             = f_exts;
    t_model_arm64.extensions = exts;
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = printer.test_sink_write;
    printer.test_sink_reset();
    var sink: encode.AsmSink = encode.sink_init(?w, ?interner);
    if (listing) { st.buf.asm = ?sink; }
    val r: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    t_model_arm64.extensions = 0;
    var ok: bool = false;
    if (sel r.err) { @why = fail.describe(r.err); }
    or (st.buf.len == 4 && !sink.failed) {
        @word = read_word(?st.buf, 0);
        ok    = true;
    }
    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

# the word clang 22 gives the row, and its listing assembles back to it
fun t_sha_word(text: str, want: u32) bool {
    var word: u32 = 0;
    var why:  str = nil;
    if (!t_sha_run(text, arm64.EXT_SHA2, 0, ?word, ?why, true) || word != want) { ret false; }
    val listed: str   = printer.test_sink_text();
    var line:   [96]u8;
    var n:      usize = 0;
    var i:      usize = 0;
    for (listed[i] == ' '::char) { i = i + 1; }
    for (listed[i] != 0 && listed[i] != '\n'::char && n < 95) {
        line[n] = listed[i]::u8;
        n       = n + 1;
        i       = i + 1;
    }
    line[n] = 0;
    if (!str_equals((?line[0])::str, text)) { ret false; }
    var again: u32 = 0;
    ret t_sha_run((?line[0])::str, arm64.EXT_SHA2, 0, ?again, ?why, false) && again == want;
}

fun t_sha_refused(text: str, exts: u64, f_exts: u64, want: str) bool {
    var word: u32 = 0;
    var why:  str = nil;
    if (t_sha_run(text, exts, f_exts, ?word, ?why, false)) { ret false; }
    ret why != nil && str_contains(why, want);
}

fun t_sha_admitted(text: str, exts: u64, f_exts: u64) bool {
    var word: u32 = 0;
    var why:  str = nil;
    ret t_sha_run(text, exts, f_exts, ?word, ?why, false);
}

# goldens from clang 22 (aarch64-linux-gnu, +crypto) and llvm-objdump; the
# listing spells each row as llvm-objdump does and assembles back
test "mach.lang.target.isa.arm64.encode:inline_asm_sha2_rows_are_byte_exact_and_round_trip" {
    if (!t_sha_word("sha256h q0, q1, v2.4s", 0x5E024020))            { ret 1; }
    if (!t_sha_word("sha256h q31, q16, v5.4s", 0x5E05421F))          { ret 2; }
    if (!t_sha_word("sha256h2 q3, q4, v5.4s", 0x5E055083))           { ret 3; }
    if (!t_sha_word("sha256h2 q29, q30, v31.4s", 0x5E1F53DD))        { ret 4; }
    if (!t_sha_word("sha256su0 v0.4s, v1.4s", 0x5E282820))           { ret 5; }
    if (!t_sha_word("sha256su0 v17.4s, v30.4s", 0x5E282BD1))         { ret 6; }
    if (!t_sha_word("sha256su1 v0.4s, v1.4s, v2.4s", 0x5E026020))    { ret 7; }
    if (!t_sha_word("sha256su1 v18.4s, v19.4s, v20.4s", 0x5E146272)) { ret 8; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_sha2_needs_the_extension_or_an_outlier" {
    if (!t_sha_refused("sha256h q0, q1, v2.4s", 0, 0,
        "inline-asm instruction 'sha256h' needs the `sha2` extension, which this target does not select; add `extensions = [\"sha2\"]` to the target, or mark the function `#[extensions(sha2)]` and call it only after detecting the extension at run time")) { ret 1; }
    if (!t_sha_refused("sha256su0 v0.4s, v1.4s", 0, 0, "#[extensions(sha2)]")) { ret 2; }
    if (!t_sha_admitted("sha256h2 q0, q1, v2.4s", 0, arm64.EXT_SHA2))          { ret 3; }
    if (!t_sha_admitted("sha256su1 v0.4s, v1.4s, v2.4s", arm64.EXT_SHA2, 0))   { ret 4; }
    if (!t_sha_admitted("add v0.4s, v1.4s, v2.4s", 0, 0))                      { ret 5; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_sha2_refuses_other_operands" {
    t_model_arm64.extensions = arm64.EXT_SHA2;
    var bad: i32 = 0;
    if (!t_word_refused("sha256h v0.4s, v1.4s, v2.4s", "two q registers and a v.4s register")) { bad = 1; }
    if (!t_word_refused("sha256h q0, q1, q2", "two q registers and a v.4s register"))          { bad = 2; }
    if (!t_word_refused("sha256h2 q0, q1", "two q registers and a v.4s register"))             { bad = 3; }
    if (!t_word_refused("sha256su0 v0.4s, v1.16b", "two v.4s registers"))                      { bad = 4; }
    if (!t_word_refused("sha256su0 v0.4s, v1.4s, v2.4s", "two v.4s registers"))                { bad = 5; }
    if (!t_word_refused("sha256su1 v0.4s, v1.4s, x2", "three v.4s registers"))                 { bad = 6; }
    if (!t_word_refused("sha256su1 q0, q1, q2", "three v.4s registers"))                       { bad = 7; }
    t_model_arm64.extensions = 0;
    ret bad;
}

# each row writes its first operand and nothing else; the state and schedule
# registers are read and written, the rest read
test "mach.lang.target.isa.arm64.encode:inline_asm_sha2_clobbers_and_effects" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    asm_clobbers("sha256h q3, q4, v5.4s\nsha256h2 q6, q7, v8.4s\nsha256su0 v9.4s, v10.4s\nsha256su1 v11.4s, v12.4s, v13.4s", ?gp, ?fp);
    if (gp != 0 || fp != ((1::u32 << 3) | (1::u32 << 6) | (1::u32 << 9) | (1::u32 << 11))) { ret 1; }
    var e:  ct.InstEffects;
    var mi: isa.Inst = inst_of(mop.SHA256H, mop.vec(0, 16), mop.vec(1, 16), mop.vec(2, 16));
    inst_effects(?mi, ?e);
    if (!e.cls.known || e.cls.writes_flags || e.cls.op != ct.CT_OP_NONE)                      { ret 2; }
    if (e.roles[0] != ct.ROLE_RW || e.roles[1] != ct.ROLE_READ || e.roles[2] != ct.ROLE_READ) { ret 3; }
    mi = inst_of(mop.SHA256SU0, mop.vec(0, 16), mop.vec(1, 16), isa.make_none());
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_RW || e.roles[1] != ct.ROLE_READ || e.roles[2] != ct.ROLE_NONE) { ret 4; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:asm_clobbers_vector_writes_land_in_the_fp_mask" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    asm_clobbers("ld1 {v3.16b}, [x0], 16\nadd v3.4s, v3.4s, v9.4s\nst1 {v3.16b}, [x1]", ?gp, ?fp);
    if (gp != 1)        { ret 1; }
    if (fp != (1 << 3)) { ret 2; }
    asm_clobbers("st1 {v4.16b}, [x2], x9", ?gp, ?fp);
    if (gp != (1 << 2) || fp != 0) { ret 3; }
    asm_clobbers("mov v31.16b, v0.16b\nmvn v30.16b, v31.16b", ?gp, ?fp);
    if (gp != 0 || fp != ((1::u32 << 31) | (1::u32 << 30))) { ret 4; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:asm_ct_scan_vector_taint_is_its_own_bank" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    val apart: err[fail.Fail] = asm_ct_scan("ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\nldr x3, [x1]", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel apart.err) { ret 1; }
    val lanes: err[fail.Fail] = asm_ct_scan("ldr x0, {k}\nld1 {v1.16b}, [x2]\nmul v1.4s, v1.4s, v1.4s", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel lanes.err) { ret 2; }
    val secret: err[fail.Fail] = asm_ct_scan("ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\nmul v1.4s, v1.4s, v1.4s", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel secret.err) { ret 3; }
    val wb: err[fail.Fail] = asm_ct_scan("ldr x1, {k}\nld1 {v0.16b}, [x2], x1", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel wb.err) { ret 4; }
    ret 0;
}

