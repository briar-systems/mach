    if (read_word(?st.buf, 20) != 0x35FFFFC1) { bad = 1; }
    if (labels.fixup_count != 0) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_name_local_resolves_to_a_frame_slot" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_SPILL;
    slots[0].offset = -8192;
    slots[0].size   = 4;
    slots[0].align  = 4;
    var f: mir.MirFunction;
    f.frame.slots         = ?slots[0];
    f.frame.slot_count    = 1;
    f.frame.size          = 8192;
    f.frame.outgoing_size = 64;
    f.frame.realign       = 0;
    f.callee_mask         = 0;
    f.callee_mask_fp      = 0;
    f.frame.base_dist     = frame_subsize(?f);

    if (frame_subsize(?f) != 8256) { bad = 1; }

    val xr: R.Result[intern.StrId, str] = intern.intern(?interner, "x");
    if (R.is_err[intern.StrId, str](xr)) { ret 1; }
    var binds: [1]mir.MirAsmBind;
    binds[0].name      = R.unwrap_ok[intern.StrId, str](xr);
    binds[0].slot_vreg = 100;

    var pl: mir.MirAsm;
    pl.isa        = "aarch64";
    pl.body       = "ldr w0, {x}\nstr w0, {x}";
    pl.binds      = ?binds[0];
    pl.bind_count = 1;

    var mi: mir.MirInstr = mir.instr(mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block     = ?pl;

    val r: R.Result[R.Void, str] = encode_asm_block_arm64(?st, ?f, 0, ?mi);
    if (R.is_err[R.Void, str](r)) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != 0xB94043E0) { bad = 1; }
        if (read_word(?st.buf, 4) != 0xB90043E0) { bad = 1; }
    }

    val nsr: R.Result[bool, str] = mem_access_needs_no_scratch(-8192, 4);
    if (R.is_err[bool, str](nsr)) { bad = 1; }
    or (R.unwrap_ok[bool, str](nsr)) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_name_local_refuses_a_body_that_moves_sp" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_SPILL;
    slots[0].offset = -16;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;
    f.frame.size       = 16;

    val xr: R.Result[intern.StrId, str] = intern.intern(?interner, "x");
    if (R.is_err[intern.StrId, str](xr)) { ret 1; }
    var binds: [1]mir.MirAsmBind;
    binds[0].name      = R.unwrap_ok[intern.StrId, str](xr);
    binds[0].slot_vreg = 100;

    var pl: mir.MirAsm;
    pl.isa        = "aarch64";
    pl.binds      = ?binds[0];
    pl.bind_count = 1;

    var mi: mir.MirInstr = mir.instr(mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block     = ?pl;

    pl.body = "ldr x0, {x}\nsub sp, sp, 16";
    if (!R.is_err[R.Void, str](encode_asm_block_arm64(?st, ?f, 0, ?mi))) { bad = 1; }

    pl.body = "ldr x0, {x}\nstp x1, x2, [sp, -16]!";
    if (!R.is_err[R.Void, str](encode_asm_block_arm64(?st, ?f, 0, ?mi))) { bad = 2; }

    pl.body = "ldr x0, {x}\n.word 0xd10043ff";
    if (!R.is_err[R.Void, str](encode_asm_block_arm64(?st, ?f, 0, ?mi))) { bad = 3; }

    pl.body = "ldr x0, {x}\nmov xzr, x1\nldr x2, [sp, 8]";
    if (R.is_err[R.Void, str](encode_asm_block_arm64(?st, ?f, 0, ?mi))) { bad = 4; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

