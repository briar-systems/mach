test spill__slot_load_store_and_move {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var slots: [1]lang_mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = lang_mir.SLOT_SPILL;
    slots[0].offset = -8;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: lang_mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;

    var sops: [2]lang_mir.MirOperand;
    sops[0] = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    sops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 9)));
    var sst: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?sops[0], 2, 8, 8);
    encode_store(?st, ?f, ?sst);
    if (isa_encode.word_read(?st.buf, 0) != 0xF81F83A9) { bad = 1; }

    var lops: [2]lang_mir.MirOperand;
    lops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 9)));
    lops[1] = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    var lst: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?lops[0], 2, 8, 8);
    encode_load(?st, ?f, ?lst);
    if (isa_encode.word_read(?st.buf, 4) != 0xF85F83A9) { bad = 1; }

    var mvl: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, ?lops[0], 2, 8, 8);
    encode_mov(?st, ?f, ?mvl);
    if (isa_encode.word_read(?st.buf, 8) != 0xF85F83A9) { bad = 1; }
    var mvs: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, ?sops[0], 2, 8, 8);
    encode_mov(?st, ?f, ?mvs);
    if (isa_encode.word_read(?st.buf, 12) != 0xF81F83A9) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_fp_arith__op_and_width {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f:   lang_mir.MirFunction;
    var ops: [3]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);

    ops[0]           = tvec(0);
    ops[1]           = tvec(1);
    ops[2]           = tvec(2);
    mi.opcode        = lang_mir.MIR_FADD;
    mi.width         = 4;
    mi.src_width     = 4;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E222820) { bad = 1; }
    ops[0]           = tvec(13);
    ops[1]           = tvec(17);
    ops[2]           = tvec(20);
    mi.width         = 8;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E742A2D) { bad = 1; }
    ops[0]           = tvec(3);
    ops[1]           = tvec(4);
    ops[2]           = tvec(5);
    mi.opcode        = lang_mir.MIR_FSUB;
    mi.width         = 4;
    mi.src_width     = 4;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E253883) { bad = 1; }
    ops[0]           = tvec(6);
    ops[1]           = tvec(7);
    ops[2]           = tvec(8);
    mi.opcode        = lang_mir.MIR_FMUL;
    mi.width         = 8;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E6808E6) { bad = 1; }
    ops[0]           = tvec(9);
    ops[1]           = tvec(10);
    ops[2]           = tvec(11);
    mi.opcode        = lang_mir.MIR_FDIV;
    mi.width         = 4;
    mi.src_width     = 4;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E2B1949) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

