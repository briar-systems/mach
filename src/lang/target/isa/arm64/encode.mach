    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "frobnicate x0, x1");
    if (!R.is_err[R.Void, str](r1))                                                                   { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r1), "unknown aarch64 inline-asm instruction")) { bad = 1; } }

    val r2: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "cbz x0, some_symbol");
    if (!R.is_err[R.Void, str](r2))                                                    { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r2), "no imm19 relocation kind")) { bad = 1; } }

    val r3: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "b.eq some_symbol");
    if (!R.is_err[R.Void, str](r3)) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_clobbers_classification" {
    var bad: i32 = 0;
    var gp: u32 = 0;
    var fp: u32 = 0;

    asm_clobbers("ldr x0, [x1]\nstr x0, [x1, 8]\nbl main", ?gp, ?fp);
    if ((gp & 1) == 0)                              { bad = 1; }
    if ((gp & A64_CALLER_SAVED) != A64_CALLER_SAVED) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("mov x8, 93\nsvc 0", ?gp, ?fp);
    if (gp != ((1::u32 << 8) | 1)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("ldr x0, {v}\nstr x1, {out}", ?gp, ?fp);
    if (gp != 1) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("dmb ish\ncmp x0, x1\nstlr x9, [x12]\nstlxr w11, x10, [x12]", ?gp, ?fp);
    if (gp != (1::u32 << 11)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("ldp x1, x2, [sp], 16", ?gp, ?fp);
    if (gp != ((1::u32 << 1) | (1::u32 << 2) | (1::u32 << 31))) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers("stp x1, x2, [sp, -16]!", ?gp, ?fp);
    if (gp != (1::u32 << 31)) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers("stp x1, x2, [sp, 16]", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("frobnicate x0, x1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:systems_mnemonics_byte_exact" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "hvc 0");
    a64_asm_text(?st, ?f, ?labels, "smc 0");
    a64_asm_text(?st, ?f, ?labels, "hvc 0x1234");
    a64_asm_text(?st, ?f, ?labels, "smc 0x1234");
    a64_asm_text(?st, ?f, ?labels, "wfi");
    a64_asm_text(?st, ?f, ?labels, "wfe");
    a64_asm_text(?st, ?f, ?labels, "svc 0");

    if (read_word(?st.buf, 0)  != 0xD4000002) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0xD4000003) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0xD4024682) { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD4024683) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD503207F) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD503205F) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD4000001) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:systems_mnemonics_clobbers" {
    var bad: i32 = 0;
    var gp: u32 = 0;
    var fp: u32 = 0;

    asm_clobbers("mov x0, 0x84000008\nhvc 0", ?gp, ?fp);
    if (gp != (A64_SMCCC_CLOBBER | 1)) { bad = 1; }
    if (fp != 0)                       { bad = 1; }
    if ((gp & (1::u32 << 18)) != 0) { bad = 1; }
    if ((gp & (1::u32 << 30)) != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("smc 0", ?gp, ?fp);
    if (gp != A64_SMCCC_CLOBBER) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("wfi", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers("wfe", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503207f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("wfi 0", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers("hvc", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:declared_raw_encodings" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xd4000002 :: writes(x0, x1, x2, x3)", ?gp, ?fp);
    if (gp != 0xF) { bad = 1; }
    if (fp != 0)   { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xd4000002", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503207f :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(v7, v31)", ?gp, ?fp);
    if (gp != 0)                                  { bad = 1; }
    if (fp != ((1::u32 << 7) | (1::u32 << 31)))   { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(x30)", ?gp, ?fp);
    if (gp != (1::u32 << 30)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(w0)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(v2.4s)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(x31)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("mov x0, x1 :: writes()", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:declared_raw_encodings_emit_unchanged" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, ".word 0xd4000002 :: writes(x0)");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd4000002");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd503207f :: writes()");

    if (read_word(?st.buf, 0) != 0xD4000002) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xD4000002) { bad = 1; }
    if (read_word(?st.buf, 8) != 0xD503207F) { bad = 1; }
    if (st.buf.len != 12) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_ldst_offset_needing_a_scratch_is_refused" {
    var bad: i32 = 0;

    if (!t_a64_accepts("ldr x9, [x12, 32760]"))  { bad = 1; }
    if (!t_a64_accepts("str x9, [x12, 32760]"))  { bad = 1; }
    if (!t_a64_refuses("ldr x9, [x12, 32768]"))  { bad = 1; }
    if (!t_a64_refuses("str x9, [x12, 32768]"))  { bad = 1; }

    if (!t_a64_accepts("ldr x9, [x12, 255]"))    { bad = 1; }
    if (!t_a64_accepts("ldr x9, [x12, -256]"))   { bad = 1; }
    if (!t_a64_refuses("ldr x9, [x12, 257]"))    { bad = 1; }
    if (!t_a64_refuses("ldr x9, [x12, -257]"))   { bad = 1; }

    if (!t_a64_accepts("ldrb w9, [x12, 4095]"))  { bad = 1; }
    if (!t_a64_refuses("ldrb w9, [x12, 4096]"))  { bad = 1; }
    if (!t_a64_accepts("ldrh w9, [x12, 8190]"))  { bad = 1; }
    if (!t_a64_refuses("ldrh w9, [x12, 8192]"))  { bad = 1; }

    if (!t_a64_accepts("ldr x9, [x12]"))         { bad = 1; }
    if (!t_a64_accepts("ldr x9, [x12, 8]"))      { bad = 1; }
    if (!t_a64_accepts("str x9, [x12, 16]"))     { bad = 1; }

    ret bad;
}

fun t_a64_accepts(text: str) bool {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;
    val r: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, text);
    val ok: bool = !R.is_err[R.Void, str](r) && st.buf.len == 4;
    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

fun t_a64_refuses(text: str) bool {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;
    val r: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool = false;
    if (R.is_err[R.Void, str](r)) {
        ok = str_contains(R.unwrap_err[R.Void, str](r), "scratch register this body may be using");
    }
    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

test "mach.lang.target.isa.arm64.encode:asm_byte_accounting" {
    var bad: i32 = 0;
    var gp: u32 = 0;
    var fp: u32 = 0;

    asm_clobbers("add x0, x1, x2 junk", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("nop 1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("  add x0 , x1 , x2  ;  mov x3, x4  ", ?gp, ?fp);
    if (gp != (1 | (1::u32 << 3))) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_relocation_modifiers" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val ar: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "adrp x0, :got:foo");
    if (R.is_err[R.Void, str](ar)) { bad = 1; }
    val lr: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "ldr x0, [x0, :got_lo12:foo]");
    if (R.is_err[R.Void, str](lr)) { bad = 1; }
    if (read_word(?st.buf, 0) != 0x90000000) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[1].kind != of.RK_GOT_LO12)   { bad = 1; }
    }

    val br: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "adrp x0, :bogus:foo");
    if (!R.is_err[R.Void, str](br)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](br), "unsupported aarch64 inline-asm relocation modifier")) { bad = 1; } }

    val lo: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, "adrp x0, :lo12:foo");
    if (!R.is_err[R.Void, str](lo)) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_vector_base_words" {
    var bad: i32 = 0;

    if (pack_neon_3same(VFADD, 0, 0, 0, 1) != 0x4E21D400) { bad = 1; }
    if (pack_neon_3same(VFADD, 1, 0, 0, 1) != 0x4E61D400) { bad = 1; }
    if (pack_neon_3same(VFSUB, 0, 0, 0, 1) != 0x4EA1D400) { bad = 1; }
    if (pack_neon_3same(VFSUB, 1, 0, 0, 1) != 0x4EE1D400) { bad = 1; }
    if (pack_neon_3same(VFMUL, 0, 0, 0, 1) != 0x6E21DC00) { bad = 1; }
    if (pack_neon_3same(VFDIV, 0, 0, 0, 1) != 0x6E21FC00) { bad = 1; }

    if (pack_neon_3same(VADD, 0, 0, 0, 1) != 0x4E218400) { bad = 1; }
    if (pack_neon_3same(VADD, 1, 0, 0, 1) != 0x4E618400) { bad = 1; }
    if (pack_neon_3same(VADD, 2, 0, 0, 1) != 0x4EA18400) { bad = 1; }
    if (pack_neon_3same(VADD, 3, 0, 0, 1) != 0x4EE18400) { bad = 1; }
    if (pack_neon_3same(VSUB, 0, 0, 0, 1) != 0x6E218400) { bad = 1; }

    if (pack_neon_3same(VAND, 0, 0, 0, 1) != 0x4E211C00) { bad = 1; }
    if (pack_neon_3same(VORR, 0, 0, 0, 1) != 0x4EA11C00) { bad = 1; }
    if (pack_neon_3same(VEOR, 0, 0, 0, 1) != 0x6E211C00) { bad = 1; }
    if (pack_neon_3same(VORR, 0, 0, 1, 1) != 0x4EA11C20) { bad = 1; }
    if (pack_neon_2misc(VNOT, 0, 1)       != 0x6E205820) { bad = 1; }

    if (pack_neon_3same(VCMEQ,  0, 0, 0, 1) != 0x6E218C00) { bad = 1; }
    if (pack_neon_3same(VCMGT_S, 0, 0, 0, 1) != 0x4E213400) { bad = 1; }
    if (pack_neon_3same(VCMGE_S, 0, 0, 0, 1) != 0x4E213C00) { bad = 1; }
    if (pack_neon_3same(VCMHI_U, 0, 0, 0, 1) != 0x6E213400) { bad = 1; }
    if (pack_neon_3same(VCMHS_U, 0, 0, 0, 1) != 0x6E213C00) { bad = 1; }
    if (pack_neon_3same(VFCMEQ, 0, 0, 0, 1) != 0x4E21E400) { bad = 1; }
    if (pack_neon_3same(VFCMGT, 0, 0, 0, 1) != 0x6EA1E400) { bad = 1; }
    if (pack_neon_3same(VFCMGE, 0, 0, 0, 1) != 0x6E21E400) { bad = 1; }

    if (pack_neon_lane_read(VUMOV_W, 0, 0, 0, 1) != 0x0E013C20) { bad = 1; }
    if (pack_neon_lane_read(VUMOV_W, 1, 3, 0, 1) != 0x0E0E3C20) { bad = 1; }
    if (pack_neon_lane_read(VUMOV_W, 2, 2, 0, 1) != 0x0E143C20) { bad = 1; }
    if (pack_neon_lane_read(VUMOV_X, 3, 1, 0, 1) != 0x4E183C20) { bad = 1; }
    if (pack_neon_lane_read(VSMOV_X, 0, 0, 0, 1) != 0x4E012C20) { bad = 1; }
    if (pack_neon_ins_gp(0, 0, 0, 1) != 0x4E011C20) { bad = 1; }
    if (pack_neon_ins_gp(2, 2, 0, 1) != 0x4E141C20) { bad = 1; }
    if (pack_neon_ins_gp(3, 1, 0, 1) != 0x4E181C20) { bad = 1; }

    if (pack_neon_dup_el(2, 1, 0, 2) != 0x5E0C0440) { bad = 1; }
    if (pack_neon_dup_el(3, 1, 0, 2) != 0x5E180440) { bad = 1; }
    if (pack_neon_dup_el(2, 0, 1, 0) != 0x5E040401) { bad = 1; }
    if (pack_neon_ins_el(2, 3, 0, 0, 1) != 0x6E1C0420) { bad = 1; }
    if (pack_neon_ins_el(3, 1, 0, 0, 1) != 0x6E180420) { bad = 1; }
    if (pack_neon_ins_el(2, 3, 2, 0, 1) != 0x6E1C4420) { bad = 1; }
    if (pack_neon_ins_el(3, 1, 1, 0, 1) != 0x6E184420) { bad = 1; }
    if (pack_neon_ins_el(0, 5, 3, 0, 1) != 0x6E0B1C20) { bad = 1; }
    if (pack_neon_ins_el(1, 2, 7, 0, 1) != 0x6E0A7420) { bad = 1; }

    if (pack_ldst(LDR_Q_OFF, 0, 0, 0) != 0x3DC00000) { bad = 1; }
    if (pack_ldst(STR_Q_OFF, 0, 0, 0) != 0x3D800000) { bad = 1; }
    if (pack_ldst(LDR_Q_OFF, 0, 1, 1) != 0x3DC00420) { bad = 1; }
    if (pack_ldst(STR_Q_OFF, 2, 3, 2) != 0x3D800862) { bad = 1; }
    if (pack_ldur(LDUR_Q_FP, 0, 0, 0x1F8::u32) != 0x3CDF8000) { bad = 1; }
    if (pack_ldst_reg(LDR_Q_REG, 0, 0, 1) != 0x3CE16800) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_integer_multiply_arrangements" {
    var bad: i32 = 0;

    if (pack_neon_3same(VMUL, 0, 3, 5, 7) != 0x4E279CA3) { bad = 1; }
    if (pack_neon_3same(VMUL, 1, 3, 5, 7) != 0x4E679CA3) { bad = 2; }
    if (pack_neon_3same(VMUL, 2, 3, 5, 7) != 0x4EA79CA3) { bad = 3; }

    if (!neon_3same_size_ok(VMUL, 0)) { bad = 4; }
    if (!neon_3same_size_ok(VMUL, 1)) { bad = 5; }
    if (!neon_3same_size_ok(VMUL, 2)) { bad = 6; }
    if (neon_3same_size_ok(VMUL, 3))  { bad = 7; }

    if (!neon_3same_size_ok(VADD, 3)) { bad = 8; }
    if (!neon_3same_size_ok(VSUB, 3)) { bad = 9; }
    if (!neon_3same_size_ok(VCMEQ, 3)) { bad = 10; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_vector_op_selection" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    ops[0] = tvec(0); ops[1] = tvec(1); ops[2] = tvec(2);

    mi.opcode = arm64.VEC_ADD::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4E22D420) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4E228420) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4EA28420) { bad = 1; }

    mi.opcode = arm64.VEC_SUB::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 8, 2); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4EE2D420) { bad = 1; }
    mi.opcode = arm64.VEC_MUL::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 2, 8); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4E629C20) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4E229C20) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4EA29C20) { bad = 1; }
    mi.opcode = arm64.VEC_DIV::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6E22FC20) { bad = 1; }

    mi.opcode = arm64.VEC_AND::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4E221C20) { bad = 1; }
    mi.opcode = arm64.VEC_ORR::u32; st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4EA21C20) { bad = 1; }
    mi.opcode = arm64.VEC_EOR::u32; st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6E221C20) { bad = 1; }

    mi.opcode = arm64.VEC_CMEQ::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6EA28C20) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4E22E420) { bad = 1; }
    mi.opcode = arm64.VEC_CMGT::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x4EA23420) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6EA2E420) { bad = 1; }
    mi.opcode = arm64.VEC_CMHI::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6EA23420) { bad = 1; }
    mi.opcode = arm64.VEC_CMHS::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6E223C20) { bad = 1; }

    mi.opcode = arm64.VEC_CMNE::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6E228C20) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x6E205800) { bad = 1; }

    ops[0] = tvec(0); ops[1] = tvec(1);
    mi.opcode = arm64.VEC_NOT::u32; mi.operand_count = 2; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16); st.buf.len = 0;
    encode_neon(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x6E205820) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_integer_multiply_refuses_64bit_lanes" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    ops[0] = tvec(0); ops[1] = tvec(1); ops[2] = tvec(2);

    mi.opcode = arm64.VEC_MUL::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 8, 2); st.buf.len = 0;
    val r: R.Result[R.Void, str] = encode_neon(?st, ?f, ?mi);
    if (!R.is_err[R.Void, str](r)) { bad = 1; }
    if (st.buf.len != 0)         { bad = 2; }

    st.buf.len = 0;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    if (R.is_err[R.Void, str](encode_neon(?st, ?f, ?mi))) { bad = 3; }
    if (st.buf.len != 4)                                { bad = 4; }

    st.buf.len = 0;
    mi.opcode = arm64.VEC_ADD::u32; mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 8, 2);
    if (R.is_err[R.Void, str](encode_neon(?st, ?f, ?mi))) { bad = 5; }
    if (read_word(?st.buf, 0) != 0x4EE28420)            { bad = 6; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:vec_lane_index_refuses_out_of_range" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;

    var rops: [3]mir.MirOperand;
    var rmi: mir.MirInstr = mir.instr(mir.MIR_VEC_EXTRACT, ?rops[0], 3, 4, 0);
    rops[0] = mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_GP, 0)::u32);
    rops[1] = tvec(1);
    rops[2] = mir.op_imm(3);
    rmi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len = 0;
    if (R.is_err[R.Void, str](encode_vec_lane_read(?st, ?f, ?rmi))) { bad = 1; }

    rops[2] = mir.op_imm(4);
    st.buf.len = 0;
    if (!R.is_err[R.Void, str](encode_vec_lane_read(?st, ?f, ?rmi))) { bad = 2; }
    if (st.buf.len != 0)                                           { bad = 3; }

    var wops: [4]mir.MirOperand;
    var wmi: mir.MirInstr = mir.instr(mir.MIR_VEC_INSERT, ?wops[0], 4, 4, 4);
    wops[0] = tvec(0);
    wops[1] = tvec(1);
    wops[2] = mir.op_imm(3);
    wops[3] = mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_GP, 0)::u32);
    wmi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len = 0;
    if (R.is_err[R.Void, str](encode_vec_lane_write(?st, ?f, ?wmi))) { bad = 4; }

    wops[2] = mir.op_imm(4);
    st.buf.len = 0;
    if (!R.is_err[R.Void, str](encode_vec_lane_write(?st, ?f, ?wmi))) { bad = 5; }
    if (st.buf.len != 0)                                            { bad = 6; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.check_accounted:rejects_unrendered_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: encode.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = encode.buf_init(?alloc);
    st.interner = nil;

    var sink: encode.AsmSink = encode.sink_init(nil, nil);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    if (R.is_err[R.Void, str](check_accounted(?st, arm64.NOP::u16))) { bad = 1; }

    encode.emit_u32(?st.buf, NOP_WORD);
    if (!R.is_err[R.Void, str](check_accounted(?st, arm64.NOP::u16))) { bad = 1; }

    encode.sink_claim(?st.buf, 0);
    if (R.is_err[R.Void, str](check_accounted(?st, arm64.NOP::u16))) { bad = 1; }

    encode.emit_u32(?st.buf, NOP_WORD);
    encode.emit_u32(?st.buf, NOP_WORD);
    encode.sink_claim(?st.buf, 8);
    if (!R.is_err[R.Void, str](check_accounted(?st, arm64.NOP::u16))) { bad = 1; }

    st.buf.asm = nil;
    encode.emit_u32(?st.buf, NOP_WORD);
    if (R.is_err[R.Void, str](check_accounted(?st, arm64.NOP::u16))) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:emitters_notify_once_per_word" {
    var alloc: A.Allocator;
    var interner: intern.Interner;
    var st: encode.EncodeState;
    tasm(?st, ?alloc, ?interner);

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = printer.test_sink_write;
    printer.test_sink_reset();

    var sink: encode.AsmSink = encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    emit_movewide_seq(?st, 0, 0x123456789ABCDEF0, true);
    if (st.buf.len != 16)                          { bad = 1; }
    if (encode.sink_unaccounted(?st.buf) != 0)     { bad = 1; }

    emit_mem_access(?st, 0, 1, 100000, 8, true);
    if (encode.sink_unaccounted(?st.buf) != 0)     { bad = 1; }

    if (sink.failed) { bad = 1; }
    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_cc(r: R.Result[u32, str]) u32 {
    if (R.is_err[u32, str](r)) { ret 0xFFFFFFFF; }
    ret R.unwrap_ok[u32, str](r);
}

test "mach.lang.target.isa.arm64.encode:classifiers_are_total_over_named_forms" {
    var bad: i32 = 0;

    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_EQ))   != CC_EQ) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_NE))   != CC_NE) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LT_S)) != CC_LT) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LT_U)) != CC_CC) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LE_S)) != CC_LE) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LE_U)) != CC_LS) { bad = 1; }

    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_EQ))   != CC_EQ) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_NE))   != CC_NE) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LT_S)) != CC_LT) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LT_U)) != CC_CC) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LE_S)) != CC_LE) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LE_U)) != CC_LS) { bad = 1; }

    if (t_cc(fp_cond(mir.FCC_EQ)) != CC_EQ) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_NE)) != CC_NE) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_LT)) != CC_MI) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_LE)) != CC_LS) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_GT)) != CC_GT) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_GE)) != CC_GE) { bad = 1; }

    if (t_cc(fp_arith_base(mir.MIR_FADD, false)) != FADD_S) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FADD, true))  != FADD_D) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FSUB, false)) != FSUB_S) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FSUB, true))  != FSUB_D) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FMUL, false)) != FMUL_S) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FMUL, true))  != FMUL_D) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FDIV, false)) != FDIV_S) { bad = 1; }
    if (t_cc(fp_arith_base(mir.MIR_FDIV, true))  != FDIV_D) { bad = 1; }

    if (t_cc(scale_shift(1)) != 0) { bad = 1; }
    if (t_cc(scale_shift(2)) != 1) { bad = 1; }
    if (t_cc(scale_shift(4)) != 2) { bad = 1; }
    if (t_cc(scale_shift(8)) != 3) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:unnamed_forms_are_refused" {
    var bad: i32 = 0;

    if (!R.is_err[u32, str](cmp_cond(mir.MIR_ADD)))                    { bad = 1; }
    if (!R.is_err[u32, str](cmp_cond(mir.MIR_SEL_CBR_EQ)))             { bad = 1; }
    if (!R.is_err[u32, str](fused_cbr_cond(mir.MIR_ADD)))              { bad = 1; }
    if (!R.is_err[u32, str](fused_cbr_cond(mir.MIR_SEL_CBR_LE_U + 1))) { bad = 1; }
    if (!R.is_err[u32, str](fp_arith_base(mir.MIR_ADD, false)))        { bad = 1; }
    if (!R.is_err[u32, str](fp_arith_base(mir.MIR_FNEG, true)))        { bad = 1; }

    if (!R.is_err[u32, str](fp_cond(mir.FCC_GE + 1))) { bad = 1; }
    if (!R.is_err[u32, str](fp_cond(200)))            { bad = 1; }

    if (!R.is_err[u32, str](scale_shift(0)))  { bad = 1; }
    if (!R.is_err[u32, str](scale_shift(3)))  { bad = 1; }
    if (!R.is_err[u32, str](scale_shift(16))) { bad = 1; }

    ret bad;
}

pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code == A64M_MOV  || code == A64M_MOVZ || code == A64M_MOVK ||
        code == A64M_ADRP || code == A64M_LDR  || code == A64M_STR  ||
        code == A64M_LDRB || code == A64M_STRB || code == A64M_LDRH ||
        code == A64M_STRH || code == A64M_LDP  || code == A64M_STP) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == A64M_ADD || code == A64M_SUB || code == A64M_AND ||
        code == A64M_ORR || code == A64M_EOR) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == A64M_CMP) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == A64M_CSET) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == A64M_LSL || code == A64M_LSR || code == A64M_ASR) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == A64M_LSLV || code == A64M_LSRV || code == A64M_ASRV) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_VAR_SHIFT));
    }
    if (code == A64M_LDAXR || code == A64M_LDAR || code == A64M_STLXR ||
        code == A64M_STLR  || code == A64M_DMB  || code == A64M_YIELD) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (a64_pattern(flags) == A64P_BCOND) { ret ct.asm_branch_flags(); }

    if (code == A64M_B   || code == A64M_BL  || code == A64M_SVC || code == A64M_BRK ||
        code == A64M_NOP || code == A64M_MSR ||
        code == A64M_HVC || code == A64M_SMC || code == A64M_WFI || code == A64M_WFE) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == A64M_MRS) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == A64M_CBZ  || code == A64M_CBNZ || code == A64M_BLR ||
        code == A64M_BR   || code == A64M_RET) {
        ret ct.asm_branch_reg();
    }
    ret ct.asm_unknown();
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:every_grammar_row_is_classified" {
    var bad: i32 = 0;
    var i: usize = 0;
    for (i < A64_MNEMONIC_COUNT) {
        if (!asm_ct_class(A64_MNEMONICS[i].code, A64_MNEMONICS[i].flags).known) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:a_spill_does_not_launder_a_secret" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val addr: str = "ldr x0, {r}\nstr x0, [sp]\nldr x1, [sp]\nldr x2, [x1]";
    if (!R.is_err[R.Void, str](asm_ct_scan(addr, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(addr, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val br: str = "ldr x0, {r}\nstr x0, [sp]\nldr x1, [sp]\ncbnz x1, 1f\n1:\nnop";
    if (!R.is_err[R.Void, str](asm_ct_scan(br, ?names[0], 1, false, false, ?alloc)))   { bad = bad + 4; }
    if (R.is_err[R.Void, str](asm_ct_scan(br, ?names[0], 0, false, false, ?alloc)))    { bad = bad + 8; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:branches_are_register_conditioned" {
    var bad: i32 = 0;

    if (!asm_ct_class(A64M_CBZ, 0).cond_reg)   { bad = 1; }
    if (!asm_ct_class(A64M_CBNZ, 0).cond_reg)  { bad = 1; }
    var i: usize = 0;
    for (i < A64_MNEMONIC_COUNT) {
        if (asm_ct_class(A64_MNEMONICS[i].code, A64_MNEMONICS[i].flags).cond_flags) { bad = 1; }
        i = i + 1;
    }
    if (asm_ct_class(A64M_B, 0).cond_reg)  { bad = 1; }
    if (asm_ct_class(A64M_BL, 0).cond_reg) { bad = 1; }

    var fi: usize = 0;
    for (fi < A64_MNEMONIC_COUNT) {
        val fc: ct.AsmClass = asm_ct_class(A64_MNEMONICS[fi].code, A64_MNEMONICS[fi].flags);
        if (fc.reads_flags && A64_MNEMONICS[fi].code != A64M_CSET && A64_MNEMONICS[fi].code != A64M_MRS) { bad = 1; }
        if (fc.defines_flags && A64_MNEMONICS[fi].code != A64M_CMP) { bad = 1; }
        if (fc.opaque_flags)  { bad = 1; }
        fi = fi + 1;
    }
    if (!asm_ct_class(A64M_CSET, 0).reads_flags) { bad = 1; }
    if (!asm_ct_class(A64M_MRS, 0).reads_flags)  { bad = 1; }
    if (!asm_ct_class(A64M_CMP, 0).defines_flags) { bad = 1; }

    if (asm_ct_class(A64M_LSLV, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(A64M_LSRV, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(A64M_ASRV, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(A64M_LSL, 0).op != ct.CT_OP_NONE) { bad = 1; }
    i = 0;
    for (i < A64_MNEMONIC_COUNT) {
        val op: ct.CtOp = asm_ct_class(A64_MNEMONICS[i].code, A64_MNEMONICS[i].flags).op;
        if (op == ct.CT_OP_INT_DIVMOD) { bad = 1; }
        if (op == ct.CT_OP_INT_MUL)    { bad = 1; }
        if (op == ct.CT_OP_FLOAT)      { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:indirect_transfers_are_register_conditioned" {
    var bad: i32 = 0;

    if (!asm_ct_class(A64M_BR, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(A64M_BLR, 0).cond_reg) { bad = 1; }
    if (!asm_ct_class(A64M_RET, 0).cond_reg) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:register_indirect_transfer_on_secret_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val brt: str = "ldr x9, {r}\nbr x9";
    if (!R.is_err[R.Void, str](asm_ct_scan(brt, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(brt, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val blrt: str = "ldr x9, {r}\nblr x9";
    if (!R.is_err[R.Void, str](asm_ct_scan(blrt, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }
    if (R.is_err[R.Void, str](asm_ct_scan(blrt, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 8; }

    val rett: str = "ldr x30, {r}\nret";
    if (!R.is_err[R.Void, str](asm_ct_scan(rett, ?names[0], 1, false, false, ?alloc))) { bad = bad + 16; }
    if (R.is_err[R.Void, str](asm_ct_scan(rett, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 32; }

    val retreg: str = "ldr x9, {r}\nret x9";
    if (!R.is_err[R.Void, str](asm_ct_scan(retreg, ?names[0], 1, false, false, ?alloc))) { bad = bad + 64; }

    val pubbr: str = "mov x9, 5\nbr x9";
    if (R.is_err[R.Void, str](asm_ct_scan(pubbr, ?names[0], 1, false, false, ?alloc))) { bad = bad + 128; }

    val pubret: str = "mov x30, 5\nret";
    if (R.is_err[R.Void, str](asm_ct_scan(pubret, ?names[0], 1, false, false, ?alloc))) { bad = bad + 256; }

    val ordinaryret: str = "ldr x0, {r}\nret";
    if (R.is_err[R.Void, str](asm_ct_scan(ordinaryret, ?names[0], 1, false, false, ?alloc))) { bad = bad + 512; }

    val direct: str = "b some_symbol";
    if (R.is_err[R.Void, str](asm_ct_scan(direct, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1024; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:cset_flags_taint_reaches_destination_register" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val leak: str = "ldr x0, {r}\ncmp x0, x1\ncset x2, eq\nldr x3, [x2]";
    if (!R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val pubcmp: str = "mov x0, 5\ncmp x0, x1\ncset x2, eq\nldr x3, [x2]";
    if (R.is_err[R.Void, str](asm_ct_scan(pubcmp, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }

    val nocmp: str = "ldr x0, {r}\ncset x2, eq\nldr x3, [x2]";
    if (R.is_err[R.Void, str](asm_ct_scan(nocmp, ?names[0], 1, false, false, ?alloc))) { bad = bad + 8; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:mrs_nzcv_flags_taint_reaches_destination_register" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val leak: str = "ldr x0, {r}\ncmp x0, x1\nmrs x2, nzcv\nldr x3, [x2]";
    if (!R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val pubcmp: str = "mov x0, 5\ncmp x0, x1\nmrs x2, nzcv\nldr x3, [x2]";
    if (R.is_err[R.Void, str](asm_ct_scan(pubcmp, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }

    val nocmp: str = "ldr x0, {r}\nmrs x2, nzcv\nldr x3, [x2]";
    if (R.is_err[R.Void, str](asm_ct_scan(nocmp, ?names[0], 1, false, false, ?alloc))) { bad = bad + 8; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:cmp_defines_rather_than_merely_writes_flags" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val leak: str = "ldr x0, {r}\ncmp x0, x1\nb.eq 1f\n1:\nnop";
    if (!R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val pubcmp: str = "mov x0, 5\ncmp x0, x1\nb.eq 1f\n1:\nnop";
    if (R.is_err[R.Void, str](asm_ct_scan(pubcmp, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }

    val redefined: str = "ldr x0, {r}\ncmp x0, x1\nmov x2, 5\ncmp x2, x1\nb.eq 1f\n1:\nnop";
    if (R.is_err[R.Void, str](asm_ct_scan(redefined, ?names[0], 1, false, false, ?alloc))) { bad = bad + 8; }

    ret bad;
}

pub fun asm_ct_scan(body: str, secret_names: *str, n_secret: u32,
                    trust_mul: bool, trust_shift: bool, alloc: *A.Allocator) R.Result[R.Void, str] {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.ct_scan(?g, body, secret_names, n_secret, trust_mul, trust_shift);
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:decode_channel_is_classified" {
    var bad: i32 = 0;
    var accepted: u32 = 0;

    var a: u32 = 0;
    for (a < 26) {
        var b: u32 = 0;
        for (b < 26) {
            var buf: [8]u8;
            buf[0] = 98;
            buf[1] = 46;
            buf[2] = (97 + a)::u8;
            buf[3] = (97 + b)::u8;
            buf[4] = 0;
            val body: str = (?buf[0])::str;

            var m: iasm.Mnemonic;
            var n: usize = 0;
            if (a64_decode_bcond(body, 0, 4, ?m, ?n)) {
                accepted = accepted + 1;
                val cls: ct.AsmClass = asm_ct_class(m.code, m.flags);
                if (!cls.cond_flags) { bad = 1; }
                if (m.code != A64M_B) { bad = 1; }
            }
            b = b + 1;
        }
        a = a + 1;
    }

    if (accepted == 0) { bad = 1; }
    ret bad;
}

fun asm_note_bytes(st: *encode.EncodeState, bytes: *u8, n: usize, start: usize) R.Result[R.Void, str] {
    ret encode.render_bytes_directive(?st.buf, bytes, n, start);
}

test "mach.lang.target.isa.arm64.encode.render_bytes_directive:reaches_the_sink" {
    var bad: i32 = 0;
    var alloc: A.Allocator;
    page.make(?alloc);
    var interner: intern.Interner;
    var st: encode.EncodeState;
    tasm(?st, ?alloc, ?interner);

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = printer.test_sink_write;
    printer.test_sink_reset();
    var sink: encode.AsmSink = encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    var payload: [3]u8;
    payload[0] = 0xEC; payload[1] = 0x90; payload[2] = 0x0F;
    val start: usize = st.buf.len;
    var i: usize = 0;
    for (i < 3) { encode.emit_byte(?st.buf, payload[i]); i = i + 1; }

    if (encode.sink_unaccounted(?st.buf) == 0) { bad = 1; }

    if (R.is_err[R.Void, str](encode.render_bytes_directive(?st.buf, ?payload[0], 3, start))) { ret 1; }

    if (encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_returns:trap_ends_control" {
    var bad: i32 = 0;

    if (asm_returns("mov x8, 94\nsvc 0\nbrk 0")) { bad = 1; }
    if (asm_returns("brk 0"))                    { bad = 1; }

    if (!asm_returns("mov x8, 64\nsvc 0")) { bad = 1; }
    if (!asm_returns("nop"))               { bad = 1; }
    if (!asm_returns("brk 0\nnop"))        { bad = 1; }
    if (!asm_returns("1:\nbrk 0"))         { bad = 1; }
    if (!asm_returns(".word 0xd4200000"))     { bad = 1; }
    if (!asm_returns("this is not asm"))      { bad = 1; }
    if (!asm_returns(""))                     { bad = 1; }

    ret bad;
}
