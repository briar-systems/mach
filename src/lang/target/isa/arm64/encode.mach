    var bad: i32 = 0;
    if (t_alu(mop.SUB, 8, 0, ZR, 1) != 0xCB0103E0) { bad = 1; }
    if (t_alu(mop.SUB, 4, 0, ZR, 1) != 0x4B0103E0) { bad = 1; }
    if (t_alu(mop.ORN, 8, 0, ZR, 1) != 0xAA2103E0) { bad = 1; }
    if (t_alu(mop.ORN, 4, 0, ZR, 1) != 0x2A2103E0) { bad = 1; }
    if (t_alu(mop.ORR, 8, 0, ZR, 1) != 0xAA0103E0) { bad = 1; }
    if (t_alu(mop.ORR, 4, 0, ZR, 1) != 0x2A0103E0) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:movz_movk_materialization" {
    var bad: i32 = 0;
    if (t_mw(mop.MOVZ, 8, 0, 0, 0x1234) != 0xD2824680) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 0, 1, 0x1234) != 0xD2A24680) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 0, 2, 0x1234) != 0xD2C24680) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 0, 3, 0x1234) != 0xD2E24680) { bad = 1; }
    if (t_mw(mop.MOVK, 8, 0, 0, 0x5678) != 0xF28ACF00) { bad = 1; }
    if (t_mw(mop.MOVK, 8, 0, 1, 0x5678) != 0xF2AACF00) { bad = 1; }
    if (t_mw(mop.MOVZ, 4, 0, 0, 0x1234) != 0x52824680) { bad = 1; }
    if (t_mw(mop.MOVK, 4, 0, 1, 0x5678) != 0x72AACF00) { bad = 1; }

    var st:    encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    emit_movewide_seq(?st, 0, 0x12345678, false);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != t_mw(mop.MOVZ, 4, 0, 0, 0x5678)) { bad = 1; }
        if (read_word(?st.buf, 4) != t_mw(mop.MOVK, 4, 0, 1, 0x1234)) { bad = 1; }
    }
    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_seq(value: u64, use64: bool, words: *u32, count: u32) bool {
    var st:    encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    fin { encode.buf_dnit(?st.buf); }
    emit_movewide_seq(?st, 16, value, use64);
    if (st.buf.len != (count * 4)::usize || movewide_words(value, use64) != count) { ret false; }
    var i: u32 = 0;
    for (i < count) {
        if (read_word(?st.buf, (i * 4)::usize) != words[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a constant is built from ones when that takes fewer words, and the word
# count the size estimate reads matches what is emitted (#3527)
test "mach.lang.target.isa.arm64.encode:movn_materialization" {
    if (t_mw(mop.MOVN, 8, 16, 0, 0x1A7) != 0x928034F0) { ret 1; }
    if (t_mw(mop.MOVN, 4, 16, 0, 0x1A7) != 0x128034F0) { ret 2; }
    if (t_mw(mop.MOVN, 8, 16, 1, 0x1) != 0x92A00030)   { ret 3; }
    var w: [4]u32;
    # x29 - 0x1a8, the frame slot the issue shows: one movn
    w[0] = t_mw(mop.MOVN, 8, 16, 0, 0x1A7);
    if (!t_seq(0xFFFFFFFFFFFFFE58, true, ?w[0], 1)) { ret 4; }
    # all ones, at both widths
    w[0] = t_mw(mop.MOVN, 8, 16, 0, 0);
    if (!t_seq(0xFFFFFFFFFFFFFFFF, true, ?w[0], 1)) { ret 5; }
    w[0] = t_mw(mop.MOVN, 4, 16, 0, 0);
    if (!t_seq(0xFFFFFFFF, false, ?w[0], 1)) { ret 6; }
    # a 32-bit negative constant
    w[0] = t_mw(mop.MOVN, 4, 16, 0, 0x7);
    if (!t_seq(0xFFFFFFF8, false, ?w[0], 1)) { ret 7; }
    # mixed: two chunks differ from ones, so movn and one movk
    w[0] = t_mw(mop.MOVN, 8, 16, 0, 0xEDCB);
    w[1] = t_mw(mop.MOVK, 8, 16, 2, 0x1234);
    if (!t_seq(0xFFFF1234FFFF1234, true, ?w[0], 2)) { ret 8; }
    # ones only in a middle chunk: movn at the first chunk that is not ones
    w[0] = t_mw(mop.MOVN, 8, 16, 1, 0x0FFF);
    if (!t_seq(0xFFFFFFFFF000FFFF, true, ?w[0], 1)) { ret 9; }
    # a tie keeps movz: two zero chunks and two one chunks
    w[0] = t_mw(mop.MOVZ, 8, 16, 1, 0xFFFF);
    w[1] = t_mw(mop.MOVK, 8, 16, 2, 0xFFFF);
    if (!t_seq(0x0000FFFFFFFF0000, true, ?w[0], 2)) { ret 10; }
    # zero and positive values are unchanged
    w[0] = t_mw(mop.MOVZ, 8, 16, 0, 0);
    if (!t_seq(0, true, ?w[0], 1)) { ret 11; }
    w[0] = t_mw(mop.MOVZ, 4, 16, 0, 0x5678);
    w[1] = t_mw(mop.MOVK, 4, 16, 1, 0x1234);
    if (!t_seq(0x12345678, false, ?w[0], 2)) { ret 12; }
    # a 64-bit value with no zero and no ones chunk takes four words from zero
    w[0] = t_mw(mop.MOVZ, 8, 16, 0, 0xDEF0);
    w[1] = t_mw(mop.MOVK, 8, 16, 1, 0x9ABC);
    w[2] = t_mw(mop.MOVK, 8, 16, 2, 0x5678);
    w[3] = t_mw(mop.MOVK, 8, 16, 3, 0x1234);
    if (!t_seq(0x123456789ABCDEF0, true, ?w[0], 4)) { ret 13; }
    # the upper half is ignored at 32 bits
    w[0] = t_mw(mop.MOVN, 4, 16, 0, 0);
    if (!t_seq(0x12345678FFFFFFFF, false, ?w[0], 1)) { ret 14; }
    ret 0;
}

