}

test encode_fp_conv__precision_and_bitcast {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f:   lang_mir.MirFunction;
    var ops: [2]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 2, 0, 0);

    ops[0]           = tvec(18);
    ops[1]           = tvec(19);
    mi.opcode        = lang_mir.MIR_FP_EXT;
    mi.width         = 8;
    mi.src_width     = 4;
    st.buf.bytes.len = 0;
    encode_fp_conv(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E22C272) { bad = 1; }
    mi.opcode        = lang_mir.MIR_FP_TRUNC;
    mi.width         = 4;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_conv(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E624272) { bad = 1; }

    ops[0]           = tvec(0);
    ops[1]           = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    mi.opcode        = arm64.FMOV::u32;
    mi.width         = 4;
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E270020) { bad = 1; }
    ops[0]           = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1]           = tvec(1);
    mi.width         = 8;
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x9E660020) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_fmov__constant_materialization {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    var f:   lang_mir.MirFunction;
    var ops: [3]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 2, 0, 0);

    ops[0]           = tvec(0);
    ops[1]           = lang_mir.op_imm(0);
    mi.opcode        = arm64.FMOV::u32;
    mi.width         = 8;
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.bytes.len != 4)                          { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x9E6703E0) { bad = 1; }
    if (st.const_count != 0)                            { bad = 1; }
    if (st.reloc_count != 0)                            { bad = 1; }

    ops[1]           = lang_mir.op_imm(0x4000000000000000);
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.bytes.len != 4)                          { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x1E601000) { bad = 1; }
    if (st.const_count != 0)                            { bad = 1; }
    if (st.reloc_count != 0)                            { bad = 1; }

    ops[1]           = lang_mir.op_imm(0x7FF0000000000000);
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.bytes.len != 8)                          { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0xD2EFFE10) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x9E670200) { bad = 1; }
    if (st.const_count != 0)                            { bad = 1; }
    if (st.reloc_count != 0)                            { bad = 1; }

    ops[1]           = lang_mir.op_imm(0x3FB999999999999A);
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.bytes.len != 8)                          { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x90000010) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xFD400200) { bad = 1; }
    if (st.const_count != 1)                            { bad = 1; }
    if (st.reloc_count != 2)                            { bad = 1; }
    or {
        if (st.relocs[0].kind != target_of.RK_PAGE21)             { bad = 1; }
        if (st.relocs[0].offset != 0)                             { bad = 1; }
        if (st.relocs[1].kind != target_of.RK_LDST64_LO12)        { bad = 1; }
        if (st.relocs[1].offset != 4)                             { bad = 1; }
        if (!intern.str_same(st.relocs[0].sym, st.relocs[1].sym)) { bad = 1; }
        if (!intern.str_same(st.relocs[0].sym, st.consts[0].sym)) { bad = 1; }
    }
    if (st.consts[0].len != 8 || st.consts[0].align != 8) { bad = 1; }
    or {
        if (st.consts[0].bytes[0] != 0x9A) { bad = 1; }
        if (st.consts[0].bytes[7] != 0x3F) { bad = 1; }
    }

    ops[1]           = lang_mir.op_imm(0x3DCCCCCD);
    mi.width         = 4;
    st.buf.bytes.len = 0;
    val reloc_before: u32 = st.reloc_count;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.bytes.len != 8)                          { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x90000010) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xBD400200) { bad = 1; }
    if (st.const_count != 2)                            { bad = 1; }
    if (st.reloc_count != reloc_before + 2)             { bad = 1; }
    or {
        if (st.relocs[reloc_before + 1].kind != target_of.RK_LDST32_LO12) { bad = 1; }
    }
    if (st.consts[1].len != 4 || st.consts[1].align != 4) { bad = 1; }

    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.const_count != 2) { bad = 1; }

    mi.operand_count = 3;
    ops[0]           = tvec(0);
    ops[1]           = tvec(1);
    ops[2]           = lang_mir.op_imm(0x4000000000000000);
    mi.opcode        = lang_mir.MIR_FMUL;
    mi.width         = 8;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (st.buf.bytes.len != 8)                          { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x1E60101E) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x1E7E0820) { bad = 1; }

    isa_encode.consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    isa_encode.buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret bad;
}

test fmov_imm8__encodable_and_boundary {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    var itn:   intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    var f:   lang_mir.MirFunction;
    var ops: [2]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(arm64.FMOV::u32, ?ops[0], 2, 8, 0);
    ops[0] = tvec(0);

    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x3FF0000000000000, 8, 0x1E6E1000) != 0)      { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0xBFF8000000000000::i64, 8, 0x1E7F1000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x3FC0000000000000, 8, 0x1E681000) != 0)      { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x403F000000000000, 8, 0x1E67F000) != 0)      { bad = 1; }

    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0xBFC00000, 4, 0x1E3F1000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x41F80000, 4, 0x1E27F000) != 0) { bad = 1; }

    var imm8: opt[u32] = fmov_imm8(0x3FB0000000000000, true);
    if (sel imm8.some) { bad = 1; }
    imm8 = fmov_imm8(0x4040000000000000, true);
    if (sel imm8.some) { bad = 1; }
    imm8 = fmov_imm8(0x3FF0800000000000, true);
    if (sel imm8.some) { bad = 1; }
    imm8 = fmov_imm8(0x3F840000, false);
    if (sel imm8.some) { bad = 1; }
    imm8 = fmov_imm8(0, true);
    if (sel imm8.some) { bad = 1; }
    imm8 = fmov_imm8(0x7FF0000000000000, true);
    if (sel imm8.some) { bad = 1; }

    ops[1]           = lang_mir.op_imm(0x3FB0000000000000);
    mi.width         = 8;
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.bytes.len != 8) { bad = 1; }

    isa_encode.consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    isa_encode.buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret bad;
}

#[testing]
fun t_fmov_imm(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr,
    src: *lang_mir.MirOperand, bits: i64, w: u8, want: u32) i32 {
    @src             = lang_mir.op_imm(bits);
    mi.width         = w;
    st.buf.bytes.len = 0;
    encode_fmov(st, f, mi);
    if (st.buf.bytes.len != 4)                    { ret 1; }
    if (isa_encode.word_read(?st.buf, 0) != want) { ret 1; }
    ret 0;
}

test encode_fp__spilled_operands_route_through_scratch {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var slots: [1]lang_mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = lang_mir.SLOT_SPILL;
    slots[0].offset = -8;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: lang_mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;

    var ops: [3]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);

    ops[0]           = tvec(0);
    ops[1]           = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    ops[2]           = tvec(2);
    mi.opcode        = lang_mir.MIR_FADD;
    mi.width         = 8;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0xFC5F83BF) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x1E622BE0) { bad = 1; }

    ops[0]           = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    ops[1]           = tvec(1);
    ops[2]           = tvec(2);
    st.buf.bytes.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E62283F) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xFC1F83BF) { bad = 1; }

    var mops: [2]lang_mir.MirOperand;
    var mv:   lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_MOV, ?mops[0], 2, 8, 0);
    mops[0]          = tvec(5);
    mops[1]          = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mv);
    if (isa_encode.word_read(?st.buf, 0) != 0xFC5F83A5) { bad = 1; }
    mops[0]          = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    mops[1]          = tvec(5);
    st.buf.bytes.len = 0;
    encode_fmov(?st, ?f, ?mv);
    if (isa_encode.word_read(?st.buf, 0) != 0xFC1F83A5) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_addr__alloca_and_gep {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var slots: [1]lang_mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = lang_mir.SLOT_ALLOCA;
    slots[0].offset = -16;
    slots[0].size   = 16;
    slots[0].align  = 16;
    var f: lang_mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;

    var aops: [2]lang_mir.MirOperand;
    aops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    aops[1] = lang_mir.op_mem_slot(lang_mir.vreg_id(100), 0);
    var al: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ALLOCA, ?aops[0], 2, 0, 0);
    al.width     = 8;
    al.src_width = 8;
    encode_addr(?st, ?f, ?al);
    if (isa_encode.word_read(?st.buf, 0) != 0xD10043A0) { bad = 1; }

    var g1ops: [2]lang_mir.MirOperand;
    g1ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    g1ops[1] = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 29)), 16);
    var g1: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_GEP, ?g1ops[0], 2, 0, 0);
    g1.width     = 8;
    g1.src_width = 8;
    encode_addr(?st, ?f, ?g1);
    if (isa_encode.word_read(?st.buf, 4) != 0x910043A0) { bad = 1; }

    var g2ops: [2]lang_mir.MirOperand;
    g2ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    var m2: lang_mir.MirOperand = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)), 0);
    m2.index = lang_mir.index_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)));
    m2.scale = 8;
    g2ops[1] = m2;
    var g2: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_GEP, ?g2ops[0], 2, 0, 0);
    g2.width     = 8;
    g2.src_width = 8;
    encode_addr(?st, ?f, ?g2);
    if (isa_encode.word_read(?st.buf, 8) != 0x8B020C20) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_convert__each_form {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var ops: [2]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 2, 0, 0);

    mi.opcode    = lang_mir.MIR_SEXT;
    mi.width     = 8;
    mi.src_width = 1;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x93401C20) { bad = 1; }
    mi.src_width = 2;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 4) != 0x93403C20) { bad = 1; }
    mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 8) != 0x93407C20) { bad = 1; }
    mi.opcode    = lang_mir.MIR_ZEXT;
    mi.width     = 4;
    mi.src_width = 1;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 12) != 0x53001C20) { bad = 1; }
    mi.src_width = 2;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 16) != 0x53003C20) { bad = 1; }
    mi.width     = 8;
    mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 20) != 0x2A0103E0) { bad = 1; }
    mi.opcode    = lang_mir.MIR_TRUNC;
    mi.width     = 4;
    mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 24) != 0x2A0103E0) { bad = 1; }
    mi.opcode    = lang_mir.MIR_BITCAST;
    mi.width     = 8;
    mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 28) != 0xAA0103E0) { bad = 1; }

    ops[1]       = lang_mir.op_imm(5);
    mi.opcode    = lang_mir.MIR_BITCAST;
    mi.width     = 8;
    mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 32) != 0xD28000B0) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 36) != 0xAA1003E0) { bad = 1; }
    mi.width     = 4;
    mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (isa_encode.word_read(?st.buf, 40) != 0x528000B0) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 44) != 0x2A1003E0) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_branch__fallthrough_elided {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;

    var uops: [1]lang_mir.MirOperand;
    uops[0] = lang_mir.op_block(4);
    var ub: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_BR, ?uops[0], 1, 8, 0);

    st.has_next_block = false;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.bytes.len != 4) { bad = 1; }
    if (st.fixup_count != 1)   { bad = 1; }

    st.has_next_block = true;
    st.next_block_id  = 4;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.bytes.len != 0) { bad = 1; }
    if (st.fixup_count != 0)   { bad = 1; }

    st.has_next_block = true;
    st.next_block_id  = 9;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.bytes.len != 4) { bad = 1; }
    if (st.fixup_count != 1)   { bad = 1; }

    var cops: [3]lang_mir.MirOperand;
    cops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 10)));
    cops[1] = lang_mir.op_block(3);
    cops[2] = lang_mir.op_block(4);
    var cbr: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_SEL_CBR, ?cops[0], 3, 8, 0);

    st.has_next_block = false;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_cbr(?st, 0, ?cbr);
    val cbr_len: usize = st.buf.bytes.len;
    val cbr_fx:  u32   = st.fixup_count;
    st.has_next_block = true;
    st.next_block_id  = 4;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_cbr(?st, 0, ?cbr);
    if (st.buf.bytes.len != cbr_len - 4) { bad = 1; }
    if (st.fixup_count != cbr_fx - 1)    { bad = 1; }
    if (st.fixups[0].target_block != 3)  { bad = 1; }

    var ops: [4]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 11)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 12)));
    ops[2] = lang_mir.op_block(3);
    ops[3] = lang_mir.op_block(4);
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_SEL_CBR_EQ, ?ops[0], 4, 8, 0);

    st.has_next_block = false;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_fused_cbr(?st, 0, ?mi);
    val fus_len: usize = st.buf.bytes.len;
    val fus_fx:  u32   = st.fixup_count;
    st.has_next_block = true;
    st.next_block_id  = 4;
    st.buf.bytes.len  = 0;
    st.fixup_count    = 0;
    encode_fused_cbr(?st, 0, ?mi);
    if (st.buf.bytes.len != fus_len - 4) { bad = 1; }
    if (st.fixup_count != fus_fx - 1)    { bad = 1; }
    if (st.fixups[0].target_block != 3)  { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_addsub__register_form {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var ops: [3]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[2] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 0, 0, 0);
    mi.operand_count = 3;
    mi.width         = 4;
    encode_addsub(?st, ?mi, false);
    if (isa_encode.word_read(?st.buf, 0) != 0x0B010000) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test global_access__call_address_load_store_relocs {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    var f:     lang_mir.MirFunction;
    arm64_emit.tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    val sym: intern.StrId = intern.str_id(7);

    var cops: [1]lang_mir.MirOperand;
    cops[0] = lang_mir.op_sym(sym, 0);
    var ci: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_CALL, ?cops[0], 1, 0, 0);
    encode_call(?st, ?ci);
    if (isa_encode.word_read(?st.buf, 0) != 0x94000000) { bad = 1; }
    if (st.reloc_count != 1)                            { bad = 1; }
    or {
        if (st.relocs[0].kind != target_of.RK_PLT32) { bad = 1; }
        if (st.relocs[0].offset != 0)                { bad = 1; }
        if (!intern.str_same(st.relocs[0].sym, sym)) { bad = 1; }
        if (st.relocs[0].addend != 0)                { bad = 1; }
    }

    var iops: [1]lang_mir.MirOperand;
    iops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 9)));
    var ii: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_CALL, ?iops[0], 1, 0, 0);
    encode_call(?st, ?ii);
    if (isa_encode.word_read(?st.buf, 4) != 0xD63F0120) { bad = 1; }
    if (st.reloc_count != 1)                            { bad = 1; }

    var ao: lang_mir.MirOperand = lang_mir.op_sym(sym, 0);
    emit_global_addr(?st, 0, ?ao);
    if (isa_encode.word_read(?st.buf, 8) != 0x90000000)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 12) != 0x91000000) { bad = 1; }
    if (st.reloc_count != 3)                             { bad = 1; }
    or {
        if (st.relocs[1].kind != target_of.RK_PAGE21)   { bad = 1; }
        if (st.relocs[1].offset != 8)                   { bad = 1; }
        if (st.relocs[2].kind != target_of.RK_ADD_LO12) { bad = 1; }
        if (st.relocs[2].offset != 12)                  { bad = 1; }
    }

    var lo: lang_mir.MirOperand = lang_mir.op_sym(sym, 0);
    emit_global_load(?st, 0, ?lo, 8, false);
    if (isa_encode.word_read(?st.buf, 16) != 0x90000010) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 20) != 0xF9400200) { bad = 1; }
    if (st.reloc_count != 5)                             { bad = 1; }
    or {
        if (st.relocs[3].kind != target_of.RK_PAGE21)      { bad = 1; }
        if (st.relocs[4].kind != target_of.RK_LDST64_LO12) { bad = 1; }
        if (st.relocs[4].offset != 20)                     { bad = 1; }
    }

    var so: lang_mir.MirOperand = lang_mir.op_sym(sym, 0);
    var sv: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    emit_global_store(?st, ?f, ?so, ?sv, 4);
    if (isa_encode.word_read(?st.buf, 24) != 0x90000010) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 28) != 0xB9000201) { bad = 1; }
    if (st.reloc_count != 7)                             { bad = 1; }
    or {
        if (st.relocs[6].kind != target_of.RK_LDST32_LO12) { bad = 1; }
        if (st.relocs[6].offset != 28)                     { bad = 1; }
    }

    isa_encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test global_access__got_relocs {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    var f:     lang_mir.MirFunction;
    arm64_emit.tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    val sym: intern.StrId = intern.str_id(7);

    var ao: lang_mir.MirOperand = lang_mir.op_sym(sym, 0);
    ao.sym_got = true;
    emit_global_addr_got(?st, 0, ?ao);
    if (isa_encode.word_read(?st.buf, 0) != 0x90000000) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 2)                            { bad = 1; }
    or {
        if (st.relocs[0].kind != target_of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[0].offset != 0)                     { bad = 1; }
        if (st.relocs[0].addend != 0)                     { bad = 1; }
        if (st.relocs[1].kind != target_of.RK_GOT_LO12)   { bad = 1; }
        if (st.relocs[1].offset != 4)                     { bad = 1; }
        if (st.relocs[1].addend != 0)                     { bad = 1; }
    }

    var lo: lang_mir.MirOperand = lang_mir.op_sym(sym, 0);
    lo.sym_got = true;
    emit_global_load_got(?st, 0, ?lo, 8, false);
    if (isa_encode.word_read(?st.buf, 8) != 0x90000000)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 12) != 0xF9400000) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 4)                             { bad = 1; }
    or {
        if (st.relocs[2].kind != target_of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[3].kind != target_of.RK_GOT_LO12)   { bad = 1; }
        if (st.relocs[3].offset != 12)                    { bad = 1; }
    }

    var so: lang_mir.MirOperand = lang_mir.op_sym(sym, 0);
    so.sym_got = true;
    var sv: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    emit_global_store_got(?st, ?f, ?so, ?sv, 4);
    if (isa_encode.word_read(?st.buf, 20) != 0x90000010) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 24) != 0xF9400210) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 28) != 0xB9000201) { bad = 1; }
    if (st.reloc_count != 6)                             { bad = 1; }
    or {
        if (st.relocs[4].kind != target_of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[5].kind != target_of.RK_GOT_LO12)   { bad = 1; }
        if (st.relocs[5].offset != 24)                    { bad = 1; }
    }

    isa_encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test frame__oversized_callee_save_uses_a_scratch_base {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var f: lang_mir.MirFunction;
    f.callee_mask         = (1::u32 << 19) | (1::u32 << 20) | (1::u32 << 21);
    f.callee_mask_fp      = 0;
    f.frame.size          = 4000;
    f.frame.outgoing_size = 0;

    save_callee_gp(?st, ?f, true);
    if (isa_encode.word_read(?st.buf, 0) != 0xD13EC3B0) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xA9005213) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0xF81F8215) { bad = 1; }

    save_callee_gp(?st, ?f, false);
    if (isa_encode.word_read(?st.buf, 12) != 0xD13EC3B0) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0xA9405213) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 20) != 0xF85F8215) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test emit_sp_sub__oversized_uses_the_register_form {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    emit_sp_sub(?st, 0x1000000);
    if (isa_encode.word_read(?st.buf, 0) != arm64_emit.t_mw(arm64_inst.MOVZ, 8, 16, 1, 0x100)) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xCB3063FF)                                        { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

# the half-precision forms the f16 rows emit: arithmetic, compare and
# the integer conversions under FEAT_FP16, fcvt and the h load and store in
# the base FP. goldens from llvm-mc 22 (aarch64, +fullfp16)
test half_forms__byte_exact {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    fin { isa_encode.buf_dnit(?st.buf); }
    arm64_emit.fp3(?st, arm64_inst.FADD, 2, 1, 2, 3);
    arm64_emit.fp3(?st, arm64_inst.FSUB, 2, 1, 2, 3);
    arm64_emit.fp3(?st, arm64_inst.FMUL, 2, 1, 2, 3);
    arm64_emit.fp3(?st, arm64_inst.FDIV, 2, 1, 2, 3);
    arm64_emit.fcmp(?st, 2, 2, 3);
    arm64_emit.fcvt(?st, 4, 2, 1, 2);
    arm64_emit.fcvt(?st, 8, 2, 1, 2);
    arm64_emit.fcvt(?st, 2, 4, 1, 2);
    arm64_emit.fcvt(?st, 2, 8, 1, 2);
    arm64_emit.cvt(?st, arm64_inst.SCVTF, arm64_inst.vec(1, 2), arm64_inst.gp(2, 4));
    arm64_emit.cvt(?st, arm64_inst.SCVTF, arm64_inst.vec(1, 2), arm64_inst.gp(2, 8));
    arm64_emit.cvt(?st, arm64_inst.UCVTF, arm64_inst.vec(1, 2), arm64_inst.gp(2, 4));
    arm64_emit.cvt(?st, arm64_inst.UCVTF, arm64_inst.vec(1, 2), arm64_inst.gp(2, 8));
    arm64_emit.cvt(?st, arm64_inst.FCVTZS, arm64_inst.gp(1, 4), arm64_inst.vec(2, 2));
    arm64_emit.cvt(?st, arm64_inst.FCVTZS, arm64_inst.gp(1, 8), arm64_inst.vec(2, 2));
    arm64_emit.cvt(?st, arm64_inst.FCVTZU, arm64_inst.gp(1, 4), arm64_inst.vec(2, 2));
    arm64_emit.cvt(?st, arm64_inst.FCVTZU, arm64_inst.gp(1, 8), arm64_inst.vec(2, 2));
    val ld: err[fail.Fail] = emit_fp_mem(?st, 1, 2, 6, 2, true);
    if (sel ld.err) { ret 1; }
    val sv: err[fail.Fail] = emit_fp_mem(?st, 1, 2, 6, 2, false);
    if (sel sv.err) { ret 2; }
    val want: [19]u32 = [19]u32{
        0x1EE32841, 0x1EE33841, 0x1EE30841, 0x1EE31841, 0x1EE32040,
        0x1EE24041, 0x1EE2C041, 0x1E23C041, 0x1E63C041,
        0x1EE20041, 0x9EE20041, 0x1EE30041, 0x9EE30041,
        0x1EF80041, 0x9EF80041, 0x1EF90041, 0x9EF90041,
        0x7D400C41, 0x7D000C41
    };
    if (st.buf.bytes.len != 19 * 4) { ret 3; }
    var i: u32 = 0;
    for (i < 19) {
        if (isa_encode.word_read(?st.buf, (i * 4)::usize) != want[i]) { ret 4 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

# the words one store (or load) of a frame slot encodes to, in a frame whose
# sp sits base_dist below fp and whose sp_fixed is as given
#[testing]
fun t_slot_access(sp_fixed: bool, base_dist: u32, slot_off: i64, disp: i64, width: u8, vec: bool, load: bool,
    want: *u32, n: usize) bool {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);

    var slots: [1]lang_mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = lang_mir.SLOT_ALLOCA;
    slots[0].offset = slot_off;
    slots[0].size   = 64;
    slots[0].align  = 1;
    var f: lang_mir.MirFunction;
    f.vregs            = nil;
    f.vreg_count       = 0;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;
    f.frame.realign    = 0;
    f.frame.fp_dist    = 0;
    f.frame.base_dist  = base_dist;
    f.frame.sp_fixed   = sp_fixed;

    var reg: i32 = isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.X1);
    if (vec) { reg = isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, arm64.V1); }
    var mem: lang_mir.MirOperand = lang_mir.op_mem_slot(lang_mir.vreg_id(100), disp);
    var rop: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(reg));
    var r:   err[fail.Fail]      = err[fail.Fail].ok{};
    if (load) {
        var ops: [2]lang_mir.MirOperand;
        ops[0] = rop;
        ops[1] = mem;
        var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_LOAD, ?ops[0], 2, width, width);
        r = encode_load(?st, ?f, ?mi);
    }
    or { r = emit_store_mem(?st, ?f, ?mem, ?rop, width); }

    var ok: bool  = !sel r.err && st.buf.bytes.len == n * 4;
    var i:  usize = 0;
    for (ok && i < n) {
        if (isa_encode.word_read(?st.buf, i * 4) != want[i]) { ok = false; }
        i = i + 1;
    }
    isa_encode.buf_dnit(?st.buf);
    ret ok;
}

#[testing]
fun t_slot_one(sp_fixed: bool, base_dist: u32, slot_off: i64, disp: i64, width: u8, vec: bool, load: bool, word: u32) bool {
    var w: [1]u32;
    w[0] = word;
    ret t_slot_access(sp_fixed, base_dist, slot_off, disp, width, vec, load, ?w[0], 1);
}

# mov x16, #-512 then the register-offset form from x29
#[testing]
fun t_slot_indexed(sp_fixed: bool, base_dist: u32, slot_off: i64, disp: i64, width: u8, second: u32) bool {
    var w: [2]u32;
    w[0] = 0x92800000 | (((0 - slot_off - disp - 1)::u32 & 0xFFFF) << 5) | 16;
    w[1] = second;
    ret t_slot_access(sp_fixed, base_dist, slot_off, disp, width, false, false, ?w[0], 2);
}

test frame_slot__deep_slot_takes_one_scaled_word_from_a_fixed_sp {
    var bad: i32 = 0;
    # str x1, [sp, #512] and ldr x1, [sp, #512]
    if (!t_slot_one(true, 1024, -512, 0, 8, false, false, 0xF90103E1)) { bad = bad | 1; }
    if (!t_slot_one(true, 1024, -512, 0, 8, false, true, 0xF94103E1))  { bad = bad | 2; }
    # an aggregate field: slot -520, field +12, four bytes: str w1, [sp, #516]
    if (!t_slot_one(true, 1024, -520, 12, 4, false, false, 0xB90207E1)) { bad = bad | 4; }
    # a byte needs no alignment: strb w1, [sp, #509]
    if (!t_slot_one(true, 1024, -520, 5, 1, false, false, 0x3907F7E1)) { bad = bad | 8; }
    # a whole vector: str q1, [sp, #512]
    if (!t_slot_one(true, 1024, -512, 0, 16, true, false, 0x3D8083E1)) { bad = bad | 16; }
    # a shallow slot keeps its one fp-relative word: stur x1, [x29, #-16]
    if (!t_slot_one(true, 1024, -16, 0, 8, false, false, 0xF81F03A1)) { bad = bad | 32; }
    ret bad;
}

test frame_slot__deep_slot_keeps_the_index_form_otherwise {
    var bad:         i32 = 0;
    val str_x29_x16: u32 = 0xF8306BA1;
    # the frame does not declare sp fixed
    if (!t_slot_indexed(false, 1024, -512, 0, 8, str_x29_x16)) { bad = bad | 1; }
    # a packed field at an offset eight does not divide
    if (!t_slot_indexed(true, 1024, -520, 3, 8, str_x29_x16)) { bad = bad | 2; }
    # four bytes at an offset four does not divide: str w1, [x29, x16]
    if (!t_slot_indexed(true, 1024, -520, 2, 4, 0xB8306BA1)) { bad = bad | 4; }
    # the slot lies below sp's reach: a negative sp offset
    if (!t_slot_indexed(true, 256, -512, 0, 8, str_x29_x16)) { bad = bad | 8; }
    # past the scaled range: 8 * 4096 above sp
    if (!t_slot_indexed(true, 40000, -512, 0, 8, str_x29_x16)) { bad = bad | 16; }
    ret bad;
}

# the integer multiply is the one member without a size-3 arrangement
test neon_3same_refusal__only_the_integer_multiply_lacks_size_3 {
    if (!t_neon3_allocated(arm64_inst.V_MUL, 0)) { ret 1; }
    if (!t_neon3_allocated(arm64_inst.V_MUL, 2)) { ret 2; }
    if (t_neon3_allocated(arm64_inst.V_MUL, 3))  { ret 3; }
    if (!t_neon3_allocated(arm64_inst.V_ADD, 3)) { ret 4; }
    ret 0;
}

test encode_neon__op_selection {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f:   lang_mir.MirFunction;
    var ops: [3]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);
    ops[0] = tvec(0);
    ops[1] = tvec(1);
    ops[2] = tvec(2);

    mi.opcode        = arm64.VEC_ADD::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4E22D420) { bad = 1; }
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4E228420) { bad = 1; }
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4EA28420) { bad = 1; }

    mi.opcode        = arm64.VEC_SUB::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 8, 2);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4EE2D420) { bad = 1; }
    mi.opcode        = arm64.VEC_MUL::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 2, 8);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4E629C20) { bad = 1; }
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4E229C20) { bad = 1; }
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4EA29C20) { bad = 1; }
    mi.opcode        = arm64.VEC_DIV::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6E22FC20) { bad = 1; }

    mi.opcode        = arm64.VEC_AND::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4E221C20) { bad = 1; }
    mi.opcode        = arm64.VEC_ORR::u32;
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4EA21C20) { bad = 1; }
    mi.opcode        = arm64.VEC_EOR::u32;
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6E221C20) { bad = 1; }

    mi.opcode        = arm64.VEC_CMEQ::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6EA28C20) { bad = 1; }
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4E22E420) { bad = 1; }
    mi.opcode        = arm64.VEC_CMGT::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x4EA23420) { bad = 1; }
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6EA2E420) { bad = 1; }
    mi.opcode        = arm64.VEC_CMHI::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6EA23420) { bad = 1; }
    mi.opcode        = arm64.VEC_CMHS::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6E223C20) { bad = 1; }

    mi.opcode        = arm64.VEC_CMNE::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6E228C20) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x6E205800) { bad = 1; }

    ops[0]           = tvec(0);
    ops[1]           = tvec(1);
    mi.opcode        = arm64.VEC_NOT::u32;
    mi.operand_count = 2;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16);
    st.buf.bytes.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x6E205820) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_neon__integer_multiply_refuses_64bit_lanes {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f:   lang_mir.MirFunction;
    var ops: [3]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);
    ops[0] = tvec(0);
    ops[1] = tvec(1);
    ops[2] = tvec(2);

    mi.opcode        = arm64.VEC_MUL::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2);
    st.buf.bytes.len = 0;
    val r: err[fail.Fail] = encode_neon(?st, ?f, ?mi);
    if (!sel r.err)            { bad = 1; }
    if (st.buf.bytes.len != 0) { bad = 2; }

    st.buf.bytes.len = 0;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    var neon: err[fail.Fail] = encode_neon(?st, ?f, ?mi);
    if (sel neon.err)          { bad = 3; }
    if (st.buf.bytes.len != 4) { bad = 4; }

    st.buf.bytes.len = 0;
    mi.opcode        = arm64.VEC_ADD::u32;
    mi.vec_lane      = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2);
    neon             = encode_neon(?st, ?f, ?mi);
    if (sel neon.err)                                   { bad = 5; }
    if (isa_encode.word_read(?st.buf, 0) != 0x4EE28420) { bad = 6; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

#[testing]
fun t_shift_words(st: *isa_encode.EncodeState, op: arm64.Opcode, lane: u32, count: lang_mir.MirOperand, want: *u32, n: u32) bool {
    var f:   lang_mir.MirFunction;
    var ops: [3]lang_mir.MirOperand;
    ops[0] = tvec(0);
    ops[1] = tvec(1);
    ops[2] = count;
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);
    mi.opcode        = op::u32;
    mi.vec_lane      = lane;
    st.buf.bytes.len = 0;
    val r: err[fail.Fail] = encode_neon_shift(st, ?f, ?mi);
    if (sel r.err || st.buf.bytes.len != (n * 4)::usize) { ret false; }
    var i: u32 = 0;
    for (i < n) {
        if (isa_encode.word_read(?st.buf, (i * 4)::usize) != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# each vector shift form against the words llvm-mc assembles for it: a count
# vector or a dup'd register count is clamped by uqshl and ushr, negated for a
# right shift and shifted by, and a constant is the immediate form or, out of
# range, the fill
test encode_neon_shift__forms_are_byte_exact {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    val x3: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3)));

    val lanes_s32: [4]u32 = [4]u32{0x6F39745E, 0x6F2707DE, 0x6EA0BBDE, 0x4EBE4420};
    if (!t_shift_words(?st, arm64.VEC_SHR_S, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4), tvec(2), ?lanes_s32[0], 4)) { bad = 1; }
    val lanes_u8: [3]u32 = [3]u32{0x6F09745E, 0x6F0F07DE, 0x6E3E4420};
    if (!t_shift_words(?st, arm64.VEC_SHL, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16), tvec(2), ?lanes_u8[0], 3)) { bad = 2; }
    val uniform_u16: [4]u32 = [4]u32{0x4E020C7E, 0x6F1977DE, 0x6F1707DE, 0x6E7E4420};
    if (!t_shift_words(?st, arm64.VEC_SHL, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 2, 8), x3, ?uniform_u16[0], 4)) { bad = 3; }
    val uniform_u64: [5]u32 = [5]u32{0x4E080C7E, 0x6F7977DE, 0x6F4707DE, 0x6EE0BBDE, 0x6EFE4420};
    if (!t_shift_words(?st, arm64.VEC_SHR_U, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2), x3, ?uniform_u64[0], 5)) { bad = 4; }

    var one: [1]u32 = [1]u32{0x4F0B5420};
    if (!t_shift_words(?st, arm64.VEC_SHL, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16), lang_mir.op_imm(3), ?one[0], 1)) { bad = 5; }
    one[0] = 0x6F3B0420;
    if (!t_shift_words(?st, arm64.VEC_SHR_U, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4), lang_mir.op_imm(5), ?one[0], 1)) { bad = 6; }
    one[0] = 0x4EA11C20;
    if (!t_shift_words(?st, arm64.VEC_SHR_U, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4), lang_mir.op_imm(0), ?one[0], 1)) { bad = 7; }
    one[0] = 0x4F400420;
    if (!t_shift_words(?st, arm64.VEC_SHR_S, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2), lang_mir.op_imm(64), ?one[0], 1)) { bad = 8; }
    one[0] = 0x6E201C00;
    if (!t_shift_words(?st, arm64.VEC_SHR_U, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 2, 8), lang_mir.op_imm(20), ?one[0], 1)) { bad = 9; }
    if (!t_shift_words(?st, arm64.VEC_SHL, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 2, 8), lang_mir.op_imm(-1), ?one[0], 1))   { bad = 10; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test vec_lane__index_out_of_range_refused {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f: lang_mir.MirFunction;

    var rops: [3]lang_mir.MirOperand;
    var rmi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_VEC_EXTRACT, ?rops[0], 3, 4, 0);
    rops[0]          = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    rops[1]          = tvec(1);
    rops[2]          = lang_mir.op_imm(3);
    rmi.vec_lane     = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    var read: err[fail.Fail] = encode_vec_lane_read(?st, ?f, ?rmi);
    if (sel read.err) { bad = 1; }

    rops[2]          = lang_mir.op_imm(4);
    st.buf.bytes.len = 0;
    read             = encode_vec_lane_read(?st, ?f, ?rmi);
    if (!sel read.err)         { bad = 2; }
    if (st.buf.bytes.len != 0) { bad = 3; }

    var wops: [4]lang_mir.MirOperand;
    var wmi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_VEC_INSERT, ?wops[0], 4, 4, 4);
    wops[0]          = tvec(0);
    wops[1]          = tvec(1);
    wops[2]          = lang_mir.op_imm(3);
    wops[3]          = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    wmi.vec_lane     = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    st.buf.bytes.len = 0;
    var written: err[fail.Fail] = encode_vec_lane_write(?st, ?f, ?wmi);
    if (sel written.err) { bad = 4; }

    wops[2]          = lang_mir.op_imm(4);
    st.buf.bytes.len = 0;
    written          = encode_vec_lane_write(?st, ?f, ?wmi);
    if (!sel written.err)      { bad = 5; }
    if (st.buf.bytes.len != 0) { bad = 6; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

#[testing]
fun t_cc(r: res[u32, fail.Fail]) u32 {
    if (sel r.err) { ret 0xFFFFFFFF; }
    ret r.ok;
}

test classifiers__map_named_forms_and_refuse_the_rest {
    var bad: i32 = 0;

    if (t_cc(cmp_cond(lang_mir.MIR_SEL_CMP_EQ)) != arm64_emit.CC_EQ)   { bad = 1; }
    if (t_cc(cmp_cond(lang_mir.MIR_SEL_CMP_NE)) != arm64_emit.CC_NE)   { bad = 1; }
    if (t_cc(cmp_cond(lang_mir.MIR_SEL_CMP_LT_S)) != arm64_emit.CC_LT) { bad = 1; }
    if (t_cc(cmp_cond(lang_mir.MIR_SEL_CMP_LT_U)) != arm64_emit.CC_CC) { bad = 1; }
    if (t_cc(cmp_cond(lang_mir.MIR_SEL_CMP_LE_S)) != arm64_emit.CC_LE) { bad = 1; }
    if (t_cc(cmp_cond(lang_mir.MIR_SEL_CMP_LE_U)) != arm64_emit.CC_LS) { bad = 1; }

    if (t_cc(fused_cbr_cond(lang_mir.MIR_SEL_CBR_EQ)) != arm64_emit.CC_EQ)   { bad = 1; }
    if (t_cc(fused_cbr_cond(lang_mir.MIR_SEL_CBR_NE)) != arm64_emit.CC_NE)   { bad = 1; }
    if (t_cc(fused_cbr_cond(lang_mir.MIR_SEL_CBR_LT_S)) != arm64_emit.CC_LT) { bad = 1; }
    if (t_cc(fused_cbr_cond(lang_mir.MIR_SEL_CBR_LT_U)) != arm64_emit.CC_CC) { bad = 1; }
    if (t_cc(fused_cbr_cond(lang_mir.MIR_SEL_CBR_LE_S)) != arm64_emit.CC_LE) { bad = 1; }
    if (t_cc(fused_cbr_cond(lang_mir.MIR_SEL_CBR_LE_U)) != arm64_emit.CC_LS) { bad = 1; }

    if (t_cc(scale_shift(1)) != 0) { bad = 1; }
    if (t_cc(scale_shift(2)) != 1) { bad = 1; }
    if (t_cc(scale_shift(4)) != 2) { bad = 1; }
    if (t_cc(scale_shift(8)) != 3) { bad = 1; }

    var cond: res[u32, fail.Fail] = cmp_cond(lang_mir.MIR_ADD);
    if (!sel cond.err) { bad = 1; }
    cond = cmp_cond(lang_mir.MIR_SEL_CBR_EQ);
    if (!sel cond.err) { bad = 1; }
    cond = fused_cbr_cond(lang_mir.MIR_ADD);
    if (!sel cond.err) { bad = 1; }
    cond = fused_cbr_cond(lang_mir.MIR_SEL_CBR_LE_U + 1);
    if (!sel cond.err) { bad = 1; }
    var op: res[arm64_inst.MachOp, fail.Fail] = fp_arith_op(lang_mir.MIR_ADD);
    if (!sel op.err) { bad = 1; }
    op = fp_arith_op(lang_mir.MIR_FNEG);
    if (!sel op.err) { bad = 1; }

    cond = fp_cond(lang_mir.FCC_GE + 1);
    if (!sel cond.err) { bad = 1; }

    var shift: res[u32, fail.Fail] = scale_shift(0);
    if (!sel shift.err) { bad = 1; }
    shift = scale_shift(3);
    if (!sel shift.err) { bad = 1; }
    shift = scale_shift(16);
    if (!sel shift.err) { bad = 1; }

    ret bad;
}

# a select is a compare and a csel, never a branch: the folded compare's own,
# or the condition against zero as a conditional branch reads it
test encode_select__csel_with_no_branch {
    var alloc: A.Allocator;
    var st:    isa_encode.EncodeState;
    arm64_emit.tbuf(?st, ?alloc);
    fin { isa_encode.buf_dnit(?st.buf); }
    var f: lang_mir.MirFunction;

    var ops: [6]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    ops[2] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)));
    ops[3] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3)));
    ops[4] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 4)));
    ops[5] = lang_mir.op_imm(lang_mir.MIR_CMP_LT_S::i64);
    var fused: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_SEL_SELECT_CMP, ?ops[0], 6, 8, 8);
    val rf:    err[fail.Fail]    = encode_mir_instr(?st, ?f, 0, ?fused);
    if (sel rf.err)                                     { ret 1; }
    if (st.buf.bytes.len != 8)                          { ret 2; }
    if (isa_encode.word_read(?st.buf, 0) != 0xEB02003F) { ret 3; }
    if (isa_encode.word_read(?st.buf, 4) != 0x9A84B060) { ret 4; }

    ops[2] = ops[3];
    ops[3] = ops[4];
    var plain: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_SEL_SELECT, ?ops[0], 4, 4, 1);
    st.buf.bytes.len = 0;
    val rp: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?plain);
    if (sel rp.err)                                     { ret 5; }
    if (st.buf.bytes.len != 8)                          { ret 6; }
    if (isa_encode.word_read(?st.buf, 0) != 0x7100003F) { ret 7; }
    if (isa_encode.word_read(?st.buf, 4) != 0x1A841060) { ret 8; }
    ret 0;
}

test encode_mir_instr__refuses_unknown_and_truncated_opcodes {
    var alloc: A.Allocator;
    page.make(?alloc);
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var st: isa_encode.EncodeState;
    isa_encode.state_blank(?st, ?alloc, arm64_emit.machine());
    st.interner = ?interner;
    fin { isa_encode.buf_dnit(?st.buf); }
    var f:    lang_mir.MirFunction;
    val name: res[intern.StrId, A.Error] = intern.add(?interner, "opcode_probe");
    if (sel name.err) { ret 8; }
    f.name = name.ok;
    var instruction: lang_mir.MirInstr = lang_mir.instr(arm64.NOP::u32, nil, 0, 8, 0);
    val encoded:     err[fail.Fail]    = encode_mir_instr(?st, ?f, 0, ?instruction);
    if (sel encoded.err)       { ret 1; }
    if (st.buf.bytes.len != 4) { ret 2; }
    st.buf.bytes.len   = 0;
    instruction.opcode = lang_mir.ISA_USE;
    val instr_encoded: err[fail.Fail] = isa_encode.instr_encode(?st, ?f, 0, ?instruction, ?HOOKS);
    if (sel instr_encoded.err) { ret 3; }
    if (st.buf.bytes.len != 0) { ret 3; }
    var codes: [3]u32;
    codes[0] = 0xFFFA;
    codes[1] = 0x10000 | arm64.NOP::u32;
    codes[2] = 0x10000 | lang_mir.ISA_USE;
    var messages: [3]str;
    messages[0] = "unknown arm64.Opcode tag 65530 in 'opcode_probe'";
    messages[1] = "unknown arm64.Opcode tag 65536 in 'opcode_probe'";
    messages[2] = "unknown arm64.Opcode tag 131067 in 'opcode_probe'";
    var i: u32 = 0;
    for (i < 3) {
        instruction.opcode = codes[i];
        val refused: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
        if (sel refused.ok)                                         { ret 4; }
        if (!str_contains(fail.describe(refused.err), messages[i])) { ret 5; }
        if (st.buf.bytes.len != 0)                                  { ret 6; }
        i = i + 1;
    }
    ret 0;
}

# every notification names the MirInstr whose encoding emitted it, in
# emission order, and a declassify marker reaches the stream as a barrier
# with no bytes between the instructions around it
test stream__notes_name_their_instruction_and_carry_the_barrier {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    var st:       isa_encode.EncodeState;
    isa_encode.state_blank(?st, ?alloc, nil);
    st.interner = ?interner;
    var sink: isa_encode.AsmSink = isa_encode.sink_init(nil, ?interner);
    st.buf.asm = ?sink;

    var vregs: [1]lang_mir.MirVReg;
    vregs[0]          = lang_mir.vreg(0, lang_mir.REG_CLASS_GP, 0, true);
    vregs[0].assigned = lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0));
    var mov_ops: [2]lang_mir.MirOperand;
    mov_ops[0]               = lang_mir.op_preg_of(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)), lang_mir.vreg_id(0));
    mov_ops[0].required_bank = lang_mir.BANK_GP;
    mov_ops[1]               = lang_mir.op_imm(5);
    var instrs: [3]lang_mir.MirInstr;
    instrs[0] = lang_mir.instr(arm64.MOV::u32, ?mov_ops[0], 2, 8, 8);
    instrs[1] = lang_mir.declassify_marker(?instrs[0], lang_mir.vreg_id(0));
    instrs[2] = lang_mir.instr(arm64.RET::u32, nil, 0, 0, 0);
    var blk: lang_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 3;
    var f: lang_mir.MirFunction;
    f.name        = intern.STR_NIL;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vregs       = ?vregs[0];
    f.vreg_count  = 1;
    f.frame.omit  = true;
    f.oblivious   = true;

    val r: err[fail.Fail] = encode_function(?st, ?f);
    if (sel r.err)                                 { ret 2; }
    if (sink.failed || sink.refused != 0)          { ret 3; }
    if (isa_encode.sink_unaccounted(?st.buf) != 0) { ret 4; }
    if (isa_encode.note_inst_count(?st.buf) != 2)  { ret 5; }

    # FUNC, BLOCK, then one INST for the move, the BARRIER, one INST for the return
    val n: u32 = isa_encode.note_count(?st.buf);
    if (n != 5) { ret 6; }
    val head:     *isa_encode.AsmNote = isa_encode.note_at(?st.buf, 0);
    val label:    *isa_encode.AsmNote = isa_encode.note_at(?st.buf, 1);
    val mov:      *isa_encode.AsmNote = isa_encode.note_at(?st.buf, 2);
    val bar:      *isa_encode.AsmNote = isa_encode.note_at(?st.buf, 3);
    val fin_note: *isa_encode.AsmNote = isa_encode.note_at(?st.buf, 4);
    if (head.kind != isa_encode.ASM_NOTE_FUNC || label.kind != isa_encode.ASM_NOTE_BLOCK)                  { ret 7; }
    if (mov.kind != isa_encode.ASM_NOTE_INST || mov.mi != ?instrs[0] || mov.byte_len == 0)                 { ret 8; }
    if (bar.kind != isa_encode.ASM_NOTE_BARRIER || bar.mi != ?instrs[1])                                   { ret 9; }
    if (bar.off != mov.off + mov.byte_len)                                                                 { ret 10; }
    if (fin_note.kind != isa_encode.ASM_NOTE_INST || fin_note.mi != ?instrs[2] || fin_note.off != bar.off) { ret 11; }

    var seeds: isa_encode.NoteSeeds;
    isa_encode.note_seeds(?f, mov, ?seeds);
    if (seeds.barrier || seeds.count != 2 || seeds.origin[0].n != 0 || !seeds.secret[0] || seeds.secret[1]) { ret 12; }
    isa_encode.note_seeds(?f, bar, ?seeds);
    if (!seeds.barrier || seeds.count != 1 || seeds.origin[0].n != 0 || !seeds.secret[0]) { ret 13; }
    isa_encode.note_seeds(?f, head, ?seeds);
    if (seeds.count != 0 || seeds.barrier) { ret 14; }

    isa_encode.notes_free(?st.buf);
    isa_encode.buf_dnit(?st.buf);
    ret 0;
}

# the code of the grammar row spelled `name` in the general-purpose or the vector bank
#[testing]
fun t_grammar_code(name: str, vector: bool) u32 {
    var r: u32 = 0;
    for (r < arm64_mnemonic.MNEMONIC_COUNT) {
        val m: *isa_asm.Mnemonic = ?arm64_mnemonic.MNEMONICS[r];
        if (arm64_effects.t_vector_row(m) == vector && str_equals(m.name, name)) { ret m.code; }
        r = r + 1;
    }
    if (!vector) { ret 0xFFFFFFFF; }
    r = 0;
    for (r < arm64_mnemonic.VEC_TWIN_COUNT) {
        if (str_equals(arm64_mnemonic.VEC_TWINS[r].name, name)) { ret arm64_mnemonic.VEC_TWINS[r].code; }
        r = r + 1;
    }
    ret 0xFFFFFFFF;
}

#[testing]
fun t_grammar_agrees(code: u32, op: arm64_inst.MachOp) bool {
    if (code == op::u32)                                      { ret true; }
    if (op == arm64_inst.LSLV && code == arm64_inst.LSL::u32) { ret true; }
    if (op == arm64_inst.LSRV && code == arm64_inst.LSR::u32) { ret true; }
    if (op == arm64_inst.ASRV && code == arm64_inst.ASR::u32) { ret true; }
    ret false;
}

# the rendered mnemonic of each instruction note equals the machine-opcode
# spelling the notification carries, and wherever the inline-asm grammar
# has a row for that spelling its code is the same opcode: the notification
# names what an assembler would read back from the printed line
#[testing]
fun t_roundtrip_check(st: *isa_encode.EncodeState, text: str) i32 {
    val n:             u32   = isa_encode.note_count(?st.buf);
    var pos:           usize = 0;
    var ni:            u32   = 0;
    var cross_checked: u32   = 0;
    for (ni < n) {
        val note: *isa_encode.AsmNote = isa_encode.note_at(?st.buf, ni);
        if (note.kind != isa_encode.ASM_NOTE_INST) {
            ni = ni + 1;
            cnt;
        }
        val op: arm64_inst.MachOp = note.inst.opcode::arm64_inst.MachOp;
        if (!arm64_inst.known(op)) { ret 100 + ni::i32; }
        val want_o: opt[str] = arm64_inst.mnemonic(op);
        if (sel want_o.none) { ret 100 + ni::i32; }
        val want: str = want_o.some;
        # the next instruction line: two spaces, then the mnemonic token
        for (pos < str_len(text) && !(text[pos] == ' '::char && text[pos + 1] == ' '::char)) {
            for (pos < str_len(text) && text[pos] != '\n'::char) { pos = pos + 1; }
            if (pos < str_len(text)) { pos = pos + 1; }
        }
        if (pos >= str_len(text)) { ret 200 + ni::i32; }
        pos = pos + 2;
        val wl: usize = str_len(want);
        if (!str_region_equals(text, pos, wl, want)) { ret 300 + ni::i32; }
        val tail: char = text[pos + wl];
        if (op == arm64_inst.BCOND) {
            if (tail == ' '::char || tail == '\n'::char) { ret 400 + ni::i32; }
        }
        or (tail != ' '::char && tail != '\n'::char) { ret 500 + ni::i32; }
        # a NEON spelling shared with a scalar row (add, mov) names the vector twin;
        # the lane moves (mov w0, v1.s[1]) have no grammar row in either bank
        val lay:    arm64_inst.Layout = arm64_inst.layout(op);
        val vector: bool              = lay == arm64_inst.L_NEON_3SAME || lay == arm64_inst.L_NEON_2MISC || lay == arm64_inst.L_NEON_ELEM;
        if (op != arm64_inst.BCOND && (vector || op < arm64_inst.V_FADD)) {
            val code: u32 = t_grammar_code(want, vector);
            if (code != 0xFFFFFFFF) {
                if (!t_grammar_agrees(code, op)) { ret 600 + ni::i32; }
                cross_checked = cross_checked + 1;
            }
        }
        for (pos < str_len(text) && text[pos] != '\n'::char) { pos = pos + 1; }
        if (pos < str_len(text)) { pos = pos + 1; }
        ni = ni + 1;
    }
    if (cross_checked < 60) { ret 700 + cross_checked::i32; }
    ret 0;
}

# every base word the encoder can emit, through the helper that emits it,
# translates to a known machine opcode whose spelling is the mnemonic the
# printer renders for the same form record
test stream__translation_round_trips_against_the_printer_for_every_emitted_base {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    val gr: res[intern.StrId, A.Error] = intern.add(?interner, "g");
    if (sel gr.err) { ret 1; }
    val g: intern.StrId = gr.ok;

    var w: io_writer.Writer;
    arm64_printer.test_sink_writer(?w);
    arm64_printer.test_sink_reset();
    var sink: isa_encode.AsmSink = isa_encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    val alu: [26]arm64_inst.MachOp = [26]arm64_inst.MachOp{
        arm64_inst.ADD, arm64_inst.SUB, arm64_inst.AND, arm64_inst.ORR, arm64_inst.EOR, arm64_inst.ORN, arm64_inst.MUL, arm64_inst.MNEG, arm64_inst.LSLV, arm64_inst.LSRV, arm64_inst.ASRV,
        arm64_inst.SDIV, arm64_inst.UDIV, arm64_inst.SUBS, arm64_inst.ADDS,
        arm64_inst.ADD, arm64_inst.SUB, arm64_inst.AND, arm64_inst.ORR, arm64_inst.EOR, arm64_inst.ORN, arm64_inst.MUL, arm64_inst.LSLV, arm64_inst.SDIV, arm64_inst.UDIV, arm64_inst.SUBS
    };
    var i: u32 = 0;
    for (i < 26) {
        arm64_emit.alu3(?st, alu[i], i < 15, 1, 2, 3);
        i = i + 1;
    }
    val fp3: [4]arm64_inst.MachOp = [4]arm64_inst.MachOp{arm64_inst.FADD, arm64_inst.FSUB, arm64_inst.FMUL, arm64_inst.FDIV};
    i = 0;
    for (i < 4) {
        arm64_emit.fp3(?st, fp3[i], 4, 1, 2, 3);
        arm64_emit.fp3(?st, fp3[i], 8, 1, 2, 3);
        i = i + 1;
    }
    arm64_emit.fp2(?st, arm64_inst.FNEG, 4, 1, 2);
    arm64_emit.fp2(?st, arm64_inst.FNEG, 8, 1, 2);
    arm64_emit.fp2(?st, arm64_inst.FMOV, 4, 1, 2);
    arm64_emit.fp2(?st, arm64_inst.FMOV, 8, 1, 2);
    arm64_emit.fcvt(?st, 8, 4, 1, 2);
    arm64_emit.fcvt(?st, 4, 8, 1, 2);
    arm64_emit.fcmp(?st, 4, 2, 3);
    arm64_emit.fcmp(?st, 8, 2, 3);
    arm64_emit.cvt(?st, arm64_inst.SCVTF, arm64_inst.vec(1, 4), arm64_inst.gp(2, 4));
    arm64_emit.cvt(?st, arm64_inst.SCVTF, arm64_inst.vec(1, 8), arm64_inst.gp(2, 8));
    arm64_emit.cvt(?st, arm64_inst.UCVTF, arm64_inst.vec(1, 4), arm64_inst.gp(2, 4));
    arm64_emit.cvt(?st, arm64_inst.UCVTF, arm64_inst.vec(1, 8), arm64_inst.gp(2, 8));
    arm64_emit.cvt(?st, arm64_inst.FCVTZS, arm64_inst.gp(1, 4), arm64_inst.vec(2, 4));
    arm64_emit.cvt(?st, arm64_inst.FCVTZS, arm64_inst.gp(1, 8), arm64_inst.vec(2, 8));
    arm64_emit.cvt(?st, arm64_inst.FCVTZU, arm64_inst.gp(1, 4), arm64_inst.vec(2, 4));
    arm64_emit.cvt(?st, arm64_inst.FCVTZU, arm64_inst.gp(1, 8), arm64_inst.vec(2, 8));
    arm64_emit.cvt(?st, arm64_inst.FMOV_GEN, arm64_inst.vec(1, 4), arm64_inst.gp(2, 4));
    arm64_emit.cvt(?st, arm64_inst.FMOV_GEN, arm64_inst.gp(1, 8), arm64_inst.vec(2, 8));
    # the aliases: mov, neg, mvn, cmp, and the sp-relative sub
    arm64_emit.alu3(?st, arm64_inst.ORR, true, 1, arm64_emit.ZR, 3);
    arm64_emit.alu3(?st, arm64_inst.SUB, true, 1, arm64_emit.ZR, 3);
    arm64_emit.alu3(?st, arm64_inst.ORN, true, 1, arm64_emit.ZR, 3);
    arm64_emit.alu3(?st, arm64_inst.SUBS, true, arm64_emit.ZR, 2, 3);
    arm64_emit.alu3(?st, arm64_inst.SUB, true, arm64_emit.SP_REG, arm64_emit.SP_REG, 16);
    arm64_emit.alu3_sh(?st, arm64_inst.ADD, true, 1, 2, 3, 4);

    val asi: [4]arm64_inst.MachOp = [4]arm64_inst.MachOp{arm64_inst.ADD, arm64_inst.SUB, arm64_inst.ADDS, arm64_inst.SUBS};
    i = 0;
    for (i < 4) {
        arm64_emit.addsub_imm(?st, asi[i], true, 1, 2, 5, 0);
        arm64_emit.addsub_imm(?st, asi[i], false, 1, 2, 5, 0);
        i = i + 1;
    }
    arm64_emit.addsub_imm(?st, arm64_inst.ADD, true, 29, arm64_emit.ZR, 0, 0);
    arm64_emit.addsub_imm(?st, arm64_inst.ADDS, true, arm64_emit.ZR, 2, 1, 0);
    arm64_emit.addsub_imm(?st, arm64_inst.SUBS, true, arm64_emit.ZR, 2, 1, 0);
    arm64_emit.addsub_imm(?st, arm64_inst.SUB, true, arm64_emit.ZR, arm64_emit.ZR, 2, 1);
    arm64_emit.addsub_imm_sym(?st, arm64_inst.ADD, true, 0, 0, g, isa_inst.SYM_MOD_PCREL_LO, 0);

    # bitfield aliases: uxtb, uxth, sxtb, sxth, sxtw, lsr, asr, lsl, ubfx, ubfiz, sbfx, sbfiz
    arm64_emit.bitfield(?st, arm64_inst.UXTB, false, 0, 1, 0, 0);
    arm64_emit.bitfield(?st, arm64_inst.UXTH, false, 0, 1, 0, 0);
    arm64_emit.bitfield(?st, arm64_inst.SXTB, false, 0, 1, 0, 0);
    arm64_emit.bitfield(?st, arm64_inst.SXTH, true, 0, 1, 0, 0);
    arm64_emit.bitfield(?st, arm64_inst.SXTW, true, 0, 1, 0, 0);
    arm64_emit.bitfield(?st, arm64_inst.LSR, true, 4, 5, 4, 0);
    arm64_emit.bitfield(?st, arm64_inst.ASR, true, 4, 5, 4, 0);
    arm64_emit.bitfield(?st, arm64_inst.LSL, true, 0, 3, 32, 0);
    arm64_emit.bitfield(?st, arm64_inst.UBFX, true, 0, 1, 3, 8);
    arm64_emit.bitfield(?st, arm64_inst.UBFIZ, true, 0, 1, 4, 4);
    arm64_emit.bitfield(?st, arm64_inst.SBFX, true, 0, 1, 3, 8);
    arm64_emit.bitfield(?st, arm64_inst.SBFIZ, true, 0, 1, 4, 4);

    arm64_emit.movewide(?st, arm64_inst.MOVZ, true, 17, 3, 0x8000);
    arm64_emit.movewide(?st, arm64_inst.MOVZ, false, 17, 0, 0);
    arm64_emit.movewide(?st, arm64_inst.MOVZ, true, 17, 1, 0);
    arm64_emit.movewide(?st, arm64_inst.MOVK, true, 16, 1, 0xFFFF);
    arm64_emit.movewide(?st, arm64_inst.MOVK, false, 16, 0, 1);
    emit_fmov_imm(?st, 0, 0x70, true);
    emit_fmov_imm(?st, 0, 0x70, false);

    arm64_emit.madd(?st, arm64_inst.MSUB, true, 0, 1, 2, 3);
    arm64_emit.madd(?st, arm64_inst.MSUB, false, 0, 1, 2, arm64_emit.ZR);
    arm64_emit.madd(?st, arm64_inst.MADD, true, 0, 1, 2, 3);
    arm64_emit.madd(?st, arm64_inst.MADD, false, 0, 1, 2, arm64_emit.ZR);
    arm64_emit.cset(?st, true, 0, arm64_emit.CC_EQ);
    arm64_emit.cset(?st, false, 0, arm64_emit.CC_NE);

    val lds: [6]arm64_inst.MachOp = [6]arm64_inst.MachOp{arm64_inst.STRB, arm64_inst.LDRB, arm64_inst.STRH, arm64_inst.LDRH, arm64_inst.STR, arm64_inst.LDR};
    i = 0;
    for (i < 6) {
        arm64_emit.ldst(?st, lds[i], false, 4, 1, 2, 1);
        i = i + 1;
    }
    arm64_emit.ldst(?st, arm64_inst.STR, false, 8, 1, 2, 1);
    arm64_emit.ldst(?st, arm64_inst.LDR, false, 8, 1, 2, 1);
    val fw: [5]u8 = [5]u8{1, 2, 4, 8, 16};
    i = 0;
    for (i < 5) {
        arm64_emit.ldst(?st, arm64_inst.LDR, true, fw[i], 1, 2, 1);
        arm64_emit.ldst(?st, arm64_inst.STR, true, fw[i], 1, 2, 1);
        arm64_emit.ldur(?st, arm64_inst.LDUR, true, fw[i], 1, 2, 0x1FF);
        arm64_emit.ldur(?st, arm64_inst.STUR, true, fw[i], 1, 2, 0x1FF);
        arm64_emit.ldst_reg(?st, arm64_inst.LDR, true, fw[i], 1, 2, 3);
        arm64_emit.ldst_reg(?st, arm64_inst.STR, true, fw[i], 1, 2, 3);
        i = i + 1;
    }
    val ord: [3]arm64_inst.MachOp = [3]arm64_inst.MachOp{arm64_inst.LDAR, arm64_inst.STLR, arm64_inst.LDAXR};
    i = 0;
    for (i < 3) {
        arm64_emit.ldord(?st, ord[i], true, 1, 2);
        arm64_emit.ldord(?st, ord[i], false, 1, 2);
        i = i + 1;
    }
    arm64_emit.ldst_sym(?st, arm64_inst.LDR, false, 8, 1, 2, g, isa_inst.SYM_MOD_PCREL_LO, 0);
    val ldu: [6]arm64_inst.MachOp = [6]arm64_inst.MachOp{arm64_inst.STURB, arm64_inst.LDURB, arm64_inst.STURH, arm64_inst.LDURH, arm64_inst.STUR, arm64_inst.LDUR};
    i = 0;
    for (i < 6) {
        arm64_emit.ldur(?st, ldu[i], false, 4, 1, 2, 0x1FF);
        i = i + 1;
    }
    arm64_emit.ldur(?st, arm64_inst.STUR, false, 8, 1, 2, 0x1FF);
    arm64_emit.ldur(?st, arm64_inst.LDUR, false, 8, 1, 2, 0x1FF);
    i = 0;
    for (i < 6) {
        arm64_emit.ldst_reg(?st, lds[i], false, 4, 1, 2, 3);
        i = i + 1;
    }
    arm64_emit.ldst_reg(?st, arm64_inst.STR, false, 8, 1, 2, 3);
    arm64_emit.ldst_reg(?st, arm64_inst.LDR, false, 8, 1, 2, 3);
    arm64_emit.ldstp(?st, arm64_inst.STP, false, 29, 30, 31, 2, arm64_inst.FLAG_WB_PRE);
    arm64_emit.ldstp(?st, arm64_inst.LDP, false, 29, 30, 31, 2, arm64_inst.FLAG_WB_POST);
    arm64_emit.ldstp(?st, arm64_inst.STP, false, 29, 30, 31, 2, 0);
    arm64_emit.ldstp(?st, arm64_inst.LDP, false, 29, 30, 31, 2, 0);
    arm64_emit.ldstp(?st, arm64_inst.STP, true, 29, 30, 31, 2, 0);
    arm64_emit.ldstp(?st, arm64_inst.LDP, true, 29, 30, 31, 2, 0);
    arm64_emit.ldstp(?st, arm64_inst.STP, false, 29, 30, 31, 2, arm64_inst.FLAG_WB_POST);
    arm64_emit.ldstp(?st, arm64_inst.LDP, false, 29, 30, 31, 2, arm64_inst.FLAG_WB_PRE);

    val lane:  u32                   = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 4, 4);
    val flane: u32                   = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 4, 4);
    val neon:  [18]arm64_inst.MachOp = [18]arm64_inst.MachOp{
        arm64_inst.V_FADD, arm64_inst.V_FSUB, arm64_inst.V_FMUL, arm64_inst.V_FDIV, arm64_inst.V_ADD, arm64_inst.V_SUB, arm64_inst.V_MUL, arm64_inst.V_AND, arm64_inst.V_ORR, arm64_inst.V_EOR,
        arm64_inst.V_CMEQ, arm64_inst.V_CMGT, arm64_inst.V_CMGE, arm64_inst.V_CMHI, arm64_inst.V_CMHS, arm64_inst.V_FCMEQ, arm64_inst.V_FCMGT, arm64_inst.V_FCMGE
    };
    i = 0;
    for (i < 18) {
        var l: u32 = lane;
        if (i < 4 || i >= 15) { l = flane; }
        arm64_emit.neon_3same(?st, neon[i], 2, 0, 1, l);
        i = i + 1;
    }
    arm64_emit.neon_3same(?st, arm64_inst.V_ORR, 5, 6, 6, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16));
    arm64_emit.neon_2misc(?st, arm64_inst.V_MVN, 0, 1);
    arm64_emit.neon_3same(?st, arm64_inst.V_USHL, 0, 1, 2, lane);
    arm64_emit.neon_3same(?st, arm64_inst.V_SSHL, 0, 1, 2, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2));
    arm64_emit.neon_2misc_lanes(?st, arm64_inst.V_NEG, 0, 1, lane);
    arm64_emit.neon_shift_imm(?st, arm64_inst.V_SHL, 0, 1, 3, lane);
    arm64_emit.neon_shift_imm(?st, arm64_inst.V_USHR, 0, 1, 32, lane);
    arm64_emit.neon_shift_imm(?st, arm64_inst.V_SSHR, 0, 1, 1, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16));
    arm64_emit.neon_shift_imm(?st, arm64_inst.V_UQSHL, 0, 1, 57, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2));
    arm64_emit.neon_dup_gp(?st, 0, 1, lane);
    arm64_emit.neon_dup_gp(?st, 0, 1, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2));
    arm64_emit.neon_umov(?st, 1, 0, 1, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16));
    arm64_emit.neon_umov(?st, 1, 0, 1, lane);
    arm64_emit.neon_umov(?st, 1, 0, 1, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2));
    arm64_emit.neon_dup_el(?st, 1, 0, 1, lane);
    arm64_emit.neon_ins_gp(?st, 1, 0, 1, lane, 4);
    arm64_emit.neon_ins_el(?st, 1, 2, 0, 1, lane);
    arm64_emit.neon_elem(?st, arm64_inst.LD1, 1, 0, 1, false, isa_inst.REG_NONE);
    arm64_emit.neon_elem(?st, arm64_inst.LD1, 4, 3, 31, true, isa_inst.REG_NONE);
    arm64_emit.neon_elem(?st, arm64_inst.ST1, 8, 17, 2, true, arm64_inst.gp_id(9));

    arm64_emit.branch_block(?st, arm64_inst.B, 0, false, 0, 3);
    arm64_emit.branch_block(?st, arm64_inst.CBNZ, 0, true, 1, 3);
    arm64_emit.branch_block(?st, arm64_inst.CBZ, 0, false, 1, 3);
    arm64_emit.branch_block(?st, arm64_inst.BCOND, arm64_emit.CC_EQ, false, 0, 3);
    arm64_emit.branch_block(?st, arm64_inst.BCOND, arm64_emit.CC_LT, false, 0, 3);
    arm64_emit.branch_sym(?st, arm64_inst.BL, g, 0);
    arm64_emit.branch_pcrel(?st, arm64_inst.CBNZ, 0, false, 1, 2);
    arm64_emit.branch_local(?st, arm64_inst.B, 0, false, 0, 1, true);
    arm64_emit.branch_reg(?st, arm64_inst.BLR, 1);
    arm64_emit.branch_reg(?st, arm64_inst.BR, 1);
    arm64_emit.branch_reg(?st, arm64_inst.RET, 30);
    arm64_emit.adrp(?st, 0, g, isa_inst.SYM_MOD_PCREL_HI, 0);
    arm64_emit.return_lr(?st);
    arm64_emit.nullary(?st, arm64_inst.NOP);
    arm64_emit.nullary(?st, arm64_inst.YIELD);
    arm64_emit.nullary(?st, arm64_inst.WFE);
    arm64_emit.nullary(?st, arm64_inst.WFI);
    arm64_emit.imm16_inst(?st, arm64_inst.BRK, 0);
    arm64_emit.imm16_inst(?st, arm64_inst.SVC, 0);
    arm64_emit.imm16_inst(?st, arm64_inst.HVC, 0);
    arm64_emit.imm16_inst(?st, arm64_inst.SMC, 1);
    arm64_emit.barrier(?st, 15);
    arm64_emit.msr_imm(?st, 3, 6, 1);
    arm64_emit.mrs(?st, arm64_emit.sysreg_pack(3, 3, 14, 0, 2), 0);
    arm64_emit.msr_reg(?st, arm64_emit.sysreg_pack(3, 3, 14, 3, 1), 1);
    arm64_emit.stxr(?st, true, 0, 1, 2);
    arm64_emit.stxr(?st, false, 0, 1, 2);

    if (sink.failed)                                                      { ret 2; }
    if (sink.refused != 0 || isa_encode.sink_unaccounted(?st.buf) != 0)   { ret 3; }
    if (isa_encode.note_inst_count(?st.buf) * 4 != st.buf.bytes.len::u32) { ret 4; }
    val code: i32 = t_roundtrip_check(?st, arm64_printer.test_sink_text());
    isa_encode.notes_free(?st.buf);
    isa_encode.buf_dnit(?st.buf);
    ret code;
}

#[testing]
fun t_neon3_allocated(op: arm64_inst.MachOp, size: u32) bool {
    val refusal: opt[str] = neon_3same_refusal(op, size);
    ret sel refusal.none;
}

test neon_convert__the_work_register_follows_the_plan_alias_property {
    var ops: [8]lang_mir.MirOpcode = [8]lang_mir.MirOpcode{lang_mir.MIR_SEXT, lang_mir.MIR_ZEXT, lang_mir.MIR_TRUNC, lang_mir.MIR_FP_EXT,
        lang_mir.MIR_FP_TRUNC, lang_mir.MIR_SI_TO_FP, lang_mir.MIR_UI_TO_FP, lang_mir.MIR_FP_TO_SI};
    var widths: [4]u8 = [4]u8{1, 2, 4, 8};
    var plans:  u32   = 0;
    var oi:     u32   = 0;
    for (oi < 8) {
        var fi: u32 = 0;
        for (fi < 16) {
            val from:       u8                 = widths[fi / 4];
            val to:         u8                 = widths[fi % 4];
            val from_float: bool               = ops[oi] == lang_mir.MIR_FP_EXT || ops[oi] == lang_mir.MIR_FP_TRUNC || ops[oi] == lang_mir.MIR_FP_TO_SI;
            val to_float:   bool               = ops[oi] == lang_mir.MIR_FP_EXT || ops[oi] == lang_mir.MIR_FP_TRUNC || ops[oi] == lang_mir.MIR_SI_TO_FP || ops[oi] == lang_mir.MIR_UI_TO_FP;
            val planned:    opt[convplan.Plan] = nconv_plan(ops[oi], to_float, to, from_float, from);
            if (sel planned.some) {
                var p: convplan.Plan = planned.some;
                if (!convplan.alias_safe(?p))                                                  { ret 1; }
                if (nconv_work(?p, 3, 3) != 3)                                                 { ret 2; }
                if (nconv_work(?p, arm64_emit.FP_SCRATCH0, NO_DEST) != arm64_emit.FP_SCRATCH0) { ret 3; }
                plans = plans + 1;
            }
            fi = fi + 1;
        }
        oi = oi + 1;
    }
    if (plans == 0) { ret 4; }
    # a plan reading its operand after writing keeps an aliasing destination and the loaded operand apart
    var late: convplan.Plan = convplan.plan();
    nconv_step(?late, arm64_inst.V_SXTL, 1);
    convplan.push(?late, arm64_inst.V_SXTL::u32, convplan.PLACE_WORK, convplan.PLACE_OPERAND, 1);
    if (nconv_work(?late, 3, 3) == 3)                                                                { ret 5; }
    if (nconv_work(?late, 3, 4) != 4)                                                                { ret 6; }
    if (nconv_work(?late, arm64_emit.FP_SCRATCH0, NO_DEST) != arm64_emit.FP_SCRATCH1)                { ret 7; }
    if (nconv_work(?late, arm64_emit.FP_SCRATCH0, arm64_emit.FP_SCRATCH0) == arm64_emit.FP_SCRATCH0) { ret 8; }
    ret 0;
}

# an offset past 2^31 reaches both halves of the adrp pair whole: the page
# relocation and the low-12 one of an address, a load and a store
test regression__far_symbol_offset_reaches_both_relocations {
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    var f: lang_mir.MirFunction;

    val far: i64                 = 2199999999;
    var ao:  lang_mir.MirOperand = lang_mir.op_sym(intern.str_id(9), far);
    val ar:  err[fail.Fail]      = emit_global_addr(?st, 1, ?ao);
    if (sel ar.err)                                               { ret 1; }
    if (st.reloc_count != 2)                                      { ret 2; }
    if (st.relocs[0].kind != target_of.RK_PAGE21)                 { ret 3; }
    if (st.relocs[1].kind != target_of.RK_ADD_LO12)               { ret 4; }
    if (st.relocs[0].addend != far || st.relocs[1].addend != far) { ret 5; }

    var gval: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)));
    val sr:   err[fail.Fail]      = emit_store_mem(?st, ?f, ?ao, ?gval, 1);
    if (sel sr.err)                                               { ret 6; }
    if (st.reloc_count != 4)                                      { ret 7; }
    if (st.relocs[2].kind != target_of.RK_PAGE21)                 { ret 8; }
    if (st.relocs[2].addend != far || st.relocs[3].addend != far) { ret 9; }

    var lops: [2]lang_mir.MirOperand;
    lops[0] = gval;
    lops[1] = lang_mir.op_sym(intern.str_id(9), 0 - far);
    var ld: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_LOAD, ?lops[0], 2, 8, 8);
    val lr: err[fail.Fail]    = encode_load(?st, ?f, ?ld);
    if (sel lr.err)                                                       { ret 10; }
    if (st.reloc_count != 6)                                              { ret 11; }
    if (st.relocs[4].addend != 0 - far || st.relocs[5].addend != 0 - far) { ret 12; }
    ret 0;
}

# a frame past one probe interval is dropped an interval at a time, each one
# touched, then the remainder; a frame of an interval or less is one drop
test emit_frame_sub__probes_each_interval_of_a_large_frame {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    fin { isa_encode.buf_dnit(?st.buf); }
    st.stack_probe = true;
    emit_frame_sub(?st, 0x5000);
    val words: [7]u32 = [7]u32{
        0xD28A0010, # movz x16, #0x5000
        0xD14007FF, # sub sp, sp, #1, lsl #12
        0xF90003FF, # str xzr, [sp]
        0xD1400610, # sub x16, x16, #1, lsl #12
        0xF140061F, # cmp x16, #1, lsl #12
        0x54FFFF88, # b.hi to the drop
        0xCB3063FF, # sub sp, sp, x16
    };
    if (st.buf.bytes.len != 28) { ret 1; }
    var i: usize = 0;
    for (i < 7) {
        if (isa_encode.word_read(?st.buf, i * 4) != words[i]) { bad = 2; }
        i = i + 1;
    }
    val before: usize = st.buf.bytes.len;
    emit_frame_sub(?st, 0x1000);
    if (st.buf.bytes.len != before + 4 || isa_encode.word_read(?st.buf, before) != 0xD14007FF) { bad = 3; }
    ret bad;
}
