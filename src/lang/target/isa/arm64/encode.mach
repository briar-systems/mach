# the vector members that share a spelling with a general-purpose row; vector operands select them
val A64_VEC_TWIN_COUNT: usize = 6;

val A64_VEC_TWINS: [A64_VEC_TWIN_COUNT]iasm.Mnemonic = [A64_VEC_TWIN_COUNT]iasm.Mnemonic{
    iasm.Mnemonic{name: "add", code: mop.V_ADD::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_V3, words: 1},
    iasm.Mnemonic{name: "sub", code: mop.V_SUB::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_V3, words: 1},
    iasm.Mnemonic{name: "and", code: mop.V_AND::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_V3, words: 1},
    iasm.Mnemonic{name: "orr", code: mop.V_ORR::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_V3, words: 1},
    iasm.Mnemonic{name: "eor", code: mop.V_EOR::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_V3, words: 1},
    iasm.Mnemonic{name: "mov", code: mop.V_MOV::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_V2, words: 1},
};

fun a64_pattern(flags: u16) u16 {
    ret flags & 0x00FF;
}

fun a64_cond(flags: u16) u32 {
    ret ((flags & A64F_COND_MASK) >> A64F_COND_SHIFT)::u32;
}

fun a64_decode_bcond(body: str, lo: usize, hi: usize, m: *iasm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !iasm.is_space(body[end])) { end = end + 1; }
    val len: usize = end - lo;
    if (len < 4)                               { ret false; }
    if (!str_region_equals(body, lo, 2, "b.")) { ret false; }

    var buf: [8]u8;
    if (!iasm.copy_region(body, lo + 2, end, ?buf[0], 8)) { ret false; }
    var cc: u32 = 0;
    if (!asm_parse_cond((?buf[0])::str, ?cc)) { ret false; }

    m.name     = nil;
    m.code     = mop.B::u32;
    m.form     = iasm.AF_OPS;
    m.writes   = iasm.AW_NONE;
    m.implicit = 0;
    m.flags    = A64P_BCOND | ((cc::u16 << A64F_COND_SHIFT) & A64F_COND_MASK);
    m.words    = 1;
    @n_out     = len;
    ret true;
}

fun a64_name_operand(pat: u16) u32 {
    if (pat == A64P_B || pat == A64P_BCOND || pat == A64P_DMB)  { ret 0; }
    if (pat == A64P_VELEM)                                      { ret 0; }
    if (pat == A64P_MSR)                                        { ret 0; }
    if (pat == A64P_CBR || pat == A64P_CSET || pat == A64P_MRS) { ret 1; }
    if (pat == A64P_MOVEWIDE)                                   { ret 2; }
    ret 0xFFFFFFFF;
}

fun a64_operand(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    @op = iasm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm operand")}; }

    if (c.body[lo] == '{'::char) {
        var off:     i64                  = 0;
        val bound_r: res[bool, fail.Fail] = iasm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op      = iasm.op_mem(SP_REG::i32, off, -1, 0, 8);
            op.flags = iasm.AOF_HAS_DISP | iasm.AOF_STACK_PTR;
            ret err[fail.Fail].ok{};
        }
        op.kind     = iasm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    if (c.body[lo] == '['::char) { ret a64_mem(c, lo, hi, op); }
    if (c.body[lo] == ':'::char) { ret a64_modifier(c, lo, hi, op); }

    if (a64_reg_region(c.body, lo, hi, op))  { ret err[fail.Fail].ok{}; }
    if (a64_vreg_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }

    val iv: opt[i64] = iasm.region_i64(c.body, lo, hi);
    if (sel iv.some) {
        @op = iasm.op_imm(iv.some, 8);
        ret err[fail.Fail].ok{};
    }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm operand")};
}

fun a64_reg_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "xzr")) {
        @op = iasm.op_reg(31, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "wzr")) {
        @op = iasm.op_reg(31, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "sp")) {
        @op      = iasm.op_reg(31, 8);
        op.flags = iasm.AOF_STACK_PTR;
        ret true;
    }
    if (str_region_equals(body, lo, len, "wsp")) {
        @op      = iasm.op_reg(31, 4);
        op.flags = iasm.AOF_STACK_PTR;
        ret true;
    }

    if (len < 2 || len > 3) { ret false; }
    val c0: char = body[lo];
    if (c0 != 'x'::char && c0 != 'w'::char) { ret false; }
    var n: u32   = 0;
    var i: usize = lo + 1;
    for (i < hi) {
        if (!iasm.is_digit(body[i])) { ret false; }
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 30) { ret false; }
    var w: u8 = 4;
    if (c0 == 'x'::char) { w = 8; }
    @op = iasm.op_reg(n::i32, w);
    ret true;
}

# `vN.16b`, `vN.8h`, `vN.4s` or `vN.2d` (elem names the lane bytes), or `qN` (no arrangement)
fun a64_vreg_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    if (hi < lo + 2) { ret false; }
    val c0:  char  = body[lo];
    var end: usize = lo + 1;
    for (end < hi && iasm.is_digit(body[end])) { end = end + 1; }
    if (end == lo + 1 || end > lo + 3) { ret false; }
    var n: u32   = 0;
    var i: usize = lo + 1;
    for (i < end) {
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    var elem: u8 = 0;
    if (c0 == 'q'::char) {
        if (end != hi) { ret false; }
    }
    or (c0 == 'v'::char) {
        val len: usize = hi - end;
        if (str_region_equals(body, end, len, ".16b")) { elem = 1; }
        or (str_region_equals(body, end, len, ".8h"))  { elem = 2; }
        or (str_region_equals(body, end, len, ".4s"))  { elem = 4; }
        or (str_region_equals(body, end, len, ".2d"))  { elem = 8; }
        or                                             { ret false; }
    }
    or { ret false; }
    @op     = iasm.op_vreg(n::i32, 16);
    op.elem = elem;
    ret true;
}

fun a64_reg(name: str, op: *iasm.Operand) bool {
    ret a64_reg_region(name, 0, str_len(name), op);
}

fun a64_modifier(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    var close: usize = lo + 1;
    var found: bool  = false;
    for (close < hi && !found) {
        if (c.body[close] == ':'::char) { found = true; }
        or                              { close = close + 1; }
    }
    if (!found) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm relocation modifier")}; }
    val nlen: usize = close - lo - 1;

    var mod: isa.SymModifier = isa.SYM_MOD_NONE;
    if (str_region_equals(c.body, lo + 1, nlen, "lo12"))     { mod = isa.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got"))      { mod = isa.SYM_MOD_GOT_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_lo12")) { mod = isa.SYM_MOD_GOT_LO; }
    or {
        ret err[fail.Fail].err{iasm.reject(c, iasm.span_message(c,
            "unsupported aarch64 inline-asm relocation modifier '", lo, hi, "'",
            "unsupported aarch64 inline-asm relocation modifier"))};
    }
    if (!iasm.is_sym_region(c.body, close + 1, hi)) {
        ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm relocation modifier")};
    }
    @op = iasm.op_sym(close + 1, hi - close - 1, mod, 8);
    ret err[fail.Fail].ok{};
}

fun a64_mem(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    @op     = iasm.op_none();
    op.kind = iasm.AOP_MEM;
    op.size = 8;

    var end: usize = hi;
    if (c.body[end - 1] == '!'::char) {
        op.flags = op.flags | iasm.AOF_WRITEBACK;
        end      = end - 1;
    }
    if (end < lo + 2 || c.body[end - 1] != ']'::char) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }

    val ilo:   usize = lo + 1;
    val ihi:   usize = end - 1;
    var comma: usize = ilo;
    var found: bool  = false;
    for (comma < ihi && !found) {
        if (c.body[comma] == ','::char) { found = true; }
        or                              { comma = comma + 1; }
    }

    var bbuf: [24]u8;
    var bend: usize = ihi;
    if (found)                                              { bend = comma; }
    if (!iasm.copy_region(c.body, ilo, bend, ?bbuf[0], 24)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
    var base: iasm.Operand = iasm.op_none();
    if (!a64_reg((?bbuf[0])::str, ?base)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
    op.reg   = base.reg;
    op.flags = op.flags | (base.flags & iasm.AOF_STACK_PTR);
    if (!found) { ret err[fail.Fail].ok{}; }

    var s: usize = comma + 1;
    var e: usize = ihi;
    for (s < e && iasm.is_space(c.body[s])) { s = s + 1; }
    for (e > s && iasm.is_space(c.body[e - 1])) { e = e - 1; }
    if (e <= s) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }

    if (c.body[s] == ':'::char) {
        var sym: iasm.Operand   = iasm.op_none();
        val mr:  err[fail.Fail] = a64_modifier(c, s, e, ?sym);
        if (sel mr.err) { ret mr; }
        op.flags    = op.flags | iasm.AOF_MEM_SYM;
        op.mod      = sym.mod;
        op.name_off = sym.name_off;
        op.name_len = sym.name_len;
        ret err[fail.Fail].ok{};
    }

    var ibuf: [24]u8;
    if (iasm.copy_region(c.body, s, e, ?ibuf[0], 24)) {
        var idx: iasm.Operand = iasm.op_none();
        if (a64_reg((?ibuf[0])::str, ?idx)) {
            if (a64_is_sp(?idx)) {
                ret err[fail.Fail].err{iasm.reject(c, "inline-asm memory index register has no sp form; register 31 there is always xzr")};
            }
            op.flags = op.flags | iasm.AOF_HAS_INDEX;
            op.index = idx.reg;
            if (idx.size == 8) { op.flags = op.flags | iasm.AOF_WIDE; }
            ret err[fail.Fail].ok{};
        }
    }
    val dv: opt[i64] = iasm.region_i64(c.body, s, e);
    if (!sel dv.some) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
    op.imm   = dv.some;
    op.flags = op.flags | iasm.AOF_HAS_DISP;
    ret err[fail.Fail].ok{};
}

fun a64_is_addr(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_MEM || op.kind == iasm.AOP_BIND;
}

fun a64_is64(op: *iasm.Operand) bool {
    ret op.size == 8;
}

fun a64_is_sp(op: *iasm.Operand) bool {
    ret (op.flags & iasm.AOF_STACK_PTR) != 0;
}

fun a64_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val pat:     u16 = a64_pattern(s.m.flags);
    val n:       u32 = s.nargs;
    val name_at: u32 = a64_name_operand(pat);

    var i: u32 = 0;
    for (i < n) {
        if (i != name_at) {
            val r: err[fail.Fail] = a64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }

    if (pat == A64P_V3 || pat == A64P_V2 || pat == A64P_VELEM) { ret a64_parse_vec(c, s, item, pat); }
    if (pat == A64P_VSHA)                                      { ret a64_parse_sha(c, s, item); }
    if (a64_names_vreg(item, n)) {
        val twin: *iasm.Mnemonic = a64_vec_twin(s.m.code);
        if (twin == nil) {
            ret err[fail.Fail].err{iasm.reject(c, a64_named_message(c, s, "' takes general-purpose registers, not a vector register",
                "an inline-asm instruction takes general-purpose registers, not a vector register"))};
        }
        item.code   = twin.code;
        item.flags  = twin.flags;
        item.writes = twin.writes;
        ret a64_parse_vec(c, s, item, a64_pattern(twin.flags));
    }

    if (pat == A64P_NULLARY) {
        if (n != 0) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm instruction takes no operands")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_RET_REG || pat == A64P_BR_REG) {
        if (n != 1)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm instruction expects one register")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ret/blr/br operand must be a register")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_IMM16) {
        if (n != 1)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].imm < 0 || item.ops[0].imm > 0xFFFF) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm svc/brk immediate is out of 16-bit range")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MOV) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'mov' expects two operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'mov' destination must be a register")}; }
        if (item.ops[1].kind == iasm.AOP_REG) {
            if (item.ops[0].size != item.ops[1].size) {
                ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'mov' operands are different widths; aarch64 has one size flag for the whole instruction")};
            }
            item.words = 1;
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind == iasm.AOP_IMM) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'mov' source must be a register or immediate")};
    }
    if (pat == A64P_MOVEWIDE) {
        if (n < 2 || n > 3)                   { ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk expects Rd, imm [, lsl N]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk needs an immediate")}; }
        if (item.ops[1].imm < 0 || item.ops[1].imm > 0xFFFF) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk immediate is out of 16-bit range")};
        }
        if (n == 3) { ret a64_shift_amount(c, s, item, 2); }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_ADDSUB || pat == A64P_LOGICAL || pat == A64P_SHIFT || pat == A64P_MULH) {
        if (n != 3)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm instruction expects three operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm first source must be a register")}; }
        if (item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        if (pat == A64P_LOGICAL && item.ops[2].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm and/orr/eor immediate (bitmask) form unsupported; use a register operand")};
        }
        if (pat == A64P_MULH && item.ops[2].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm umulh/smulh takes three registers")};
        }
        if (pat == A64P_MULH && item.ops[0].size != 8) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm umulh/smulh has no 32-bit form; use x registers")};
        }
        if (pat == A64P_SHIFT && item.ops[2].kind != iasm.AOP_REG && item.ops[2].kind != iasm.AOP_IMM) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm shift count must be a register or immediate")};
        }
        # `lsl` with a register count is the lslv alias: the variable-latency
        # member, and the constant-time class must see it as one
        if (pat == A64P_SHIFT && item.ops[2].kind == iasm.AOP_REG) {
            if (item.code == mop.LSL::u32) { item.code = mop.LSLV::u32; }
            if (item.code == mop.LSR::u32) { item.code = mop.LSRV::u32; }
            if (item.code == mop.ASR::u32) { item.code = mop.ASRV::u32; }
        }
        if (item.ops[2].kind == iasm.AOP_REG && item.ops[0].size != item.ops[2].size) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_CMP) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cmp' expects two operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cmp' first operand must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_REG && item.ops[1].kind != iasm.AOP_IMM) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cmp' second operand must be a register or imm12")};
        }
        if (item.ops[1].kind == iasm.AOP_REG && item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cmp' operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_CSET) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cset' expects Rd, cond")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cset' destination must be a register")}; }
        var buf: [8]u8;
        var cc:  u32 = 0;
        if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?buf[0], 8) || !asm_parse_cond((?buf[0])::str, ?cc)) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cset' condition is unrecognized")};
        }
        item.flags = item.flags | ((cc::u16 << A64F_COND_SHIFT) & A64F_COND_MASK);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_ADRP) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'adrp' expects Xd, symbol")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'adrp' destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_SYM) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'adrp' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_BL) {
        if (n != 1)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'bl' expects a symbol")}; }
        if (item.ops[0].kind != iasm.AOP_SYM) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'bl' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_B) {
        if (n != 1) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'b' expects a target")}; }
        ret a64_branch_target(c, s, item, 0, true);
    }
    if (pat == A64P_BCOND) {
        if (n != 1) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm conditional branch expects a target")}; }
        ret a64_branch_target(c, s, item, 0, false);
    }
    if (pat == A64P_CBR) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm cbz/cbnz expects Rt, target")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm cbz/cbnz first operand must be a register")}; }
        ret a64_branch_target(c, s, item, 1, false);
    }
    if (pat == A64P_LDST) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldr/str expects Rt, [mem]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldr/str value must be a register")}; }
        if (!a64_is_addr(?item.ops[1]))       { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldr/str address must be a memory operand")}; }
        if ((item.ops[1].flags & iasm.AOF_WRITEBACK) != 0) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldr/str writeback addressing unsupported")};
        }
        if ((item.ops[1].flags & iasm.AOF_HAS_DISP) != 0) { item.words = iasm.WORDS_VARIABLE; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_LDSTP) {
        if (n < 3 || n > 4)                                              { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp expects Xa, Xb, [mem] [, imm]")}; }
        if (item.ops[0].kind != iasm.AOP_REG || !a64_is64(?item.ops[0])) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[1].kind != iasm.AOP_REG || !a64_is64(?item.ops[1])) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[2].kind != iasm.AOP_MEM)                            { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp address must be a memory operand")}; }
        if ((item.ops[2].flags & (iasm.AOF_HAS_INDEX | iasm.AOF_MEM_SYM)) != 0) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp address must be [Xn] or [Xn, imm]")};
        }
        if (n == 4) {
            if ((item.ops[2].flags & (iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK)) != 0) {
                ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp post-index base must be a bare [Xn]")};
            }
            if (item.ops[3].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp post-index needs an immediate")}; }
            item.ops[2].flags = item.ops[2].flags | iasm.AOF_WRITEBACK;
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_DMB) {
        if (n != 1) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm dmb expects one barrier option")}; }
        var buf:  [8]u8;
        var opt_: u32 = 0;
        if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?buf[0], 8) || !asm_barrier_option((?buf[0])::str, ?opt_)) {
            ret err[fail.Fail].err{iasm.reject(c, "unsupported inline-asm dmb barrier option")};
        }
        item.ops[0] = iasm.op_imm(opt_::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MSR) {
        if (n != 2) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm msr expects a system register or PSTATE field and a source")}; }
        var nbuf: [A64_SYSREG_NAME_MAX]u8;
        if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?nbuf[0], A64_SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm msr destination name is too long")};
        }
        var op1: u32 = 0;
        var op2: u32 = 0;
        if (item.ops[1].kind == iasm.AOP_IMM) {
            if (!a64_pstate_field((?nbuf[0])::str, ?op1, ?op2)) {
                ret err[fail.Fail].err{iasm.reject(c, "unsupported inline-asm msr PSTATE field")};
            }
            if (item.ops[1].imm < 0 || item.ops[1].imm > 15) {
                ret err[fail.Fail].err{iasm.reject(c, "inline-asm msr immediate must be 0-15")};
            }
            item.ops[0] = iasm.op_imm(((op1 << 8) | op2)::i64, 1);
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm msr source must be an immediate or a register")};
        }
        var op0: u32 = 0;
        var crn: u32 = 0;
        var crm: u32 = 0;
        if (!a64_sysreg((?nbuf[0])::str, ?op0, ?op1, ?crn, ?crm, ?op2)) {
            ret err[fail.Fail].err{iasm.reject(c, "unsupported inline-asm msr system register")};
        }
        item.ops[0] = iasm.op_imm(a64_sysreg_pack(op0, op1, crn, crm, op2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MRS) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm mrs expects Xt, <sysreg>")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm mrs destination must be a register")}; }
        var mbuf: [A64_SYSREG_NAME_MAX]u8;
        if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?mbuf[0], A64_SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm mrs system register name is too long")};
        }
        var m0: u32 = 0;
        var m1: u32 = 0;
        var mn: u32 = 0;
        var mm: u32 = 0;
        var m2: u32 = 0;
        if (!a64_sysreg((?mbuf[0])::str, ?m0, ?m1, ?mn, ?mm, ?m2)) {
            ret err[fail.Fail].err{iasm.reject(c, "unsupported inline-asm mrs system register")};
        }
        item.ops[1] = iasm.op_imm(a64_sysreg_pack(m0, m1, mn, mm, m2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_LDORD) {
        if (n != 2)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldar/stlr/ldaxr expects Rt, [Xn]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldar/stlr/ldaxr value must be a register")}; }
        ret a64_bare_addr(c, ?item.ops[1]);
    }
    if (pat == A64P_STLXR) {
        if (n != 3)                           { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stlxr expects Ws, Rt, [Xn]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stlxr status must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stlxr value must be a register")}; }
        ret a64_bare_addr(c, ?item.ops[2]);
    }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no parser")};
}

fun a64_names_vreg(item: *iasm.Item, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (iasm.is_vreg(?item.ops[i::usize])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun a64_vec_twin(code: u32) *iasm.Mnemonic {
    var gp: u32 = mop.MOP_NONE::u32;
    if (code == mop.ADD::u32) { gp = mop.V_ADD::u32; }
    or (code == mop.SUB::u32) { gp = mop.V_SUB::u32; }
    or (code == mop.AND::u32) { gp = mop.V_AND::u32; }
    or (code == mop.ORR::u32) { gp = mop.V_ORR::u32; }
    or (code == mop.EOR::u32) { gp = mop.V_EOR::u32; }
    or (code == mop.MOV::u32) { gp = mop.V_MOV::u32; }
    var i: usize = 0;
    for (i < A64_VEC_TWIN_COUNT) {
        if (A64_VEC_TWINS[i].code == gp) { ret ?A64_VEC_TWINS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun a64_named_message(c: *iasm.Cursor, s: *iasm.Stmt, suffix: str, fallback: str) str {
    ret iasm.named_message(c.alloc, c.interner, "inline-asm instruction '", s.m.name, suffix, fallback);
}

fun a64_vec_refused(c: *iasm.Cursor, s: *iasm.Stmt, suffix: str, fallback: str) err[fail.Fail] {
    ret err[fail.Fail].err{iasm.reject(c, a64_named_message(c, s, suffix, fallback))};
}

# whether a member's lanes may be `elem` bytes wide
fun a64_lane_admits(code: u32, elem: u8) bool {
    if (elem == 0) { ret false; }
    val lane: mop.LaneClass = mop.form(code::mop.MachOp).lane;
    if (lane == mop.LANE_BITS)  { ret elem == 1; }
    if (lane == mop.LANE_FLOAT) { ret elem == 4 || elem == 8; }
    if (code == mop.V_MUL::u32) { ret elem != 8; }
    ret true;
}

fun a64_parse_vec(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, pat: u16) err[fail.Fail] {
    val n: u32 = s.nargs;
    if (pat == A64P_VELEM) { ret a64_parse_velem(c, s, item); }

    var want: u32 = 3;
    if (pat == A64P_V2) { want = 2; }
    if (n != want) {
        if (want == 2) { ret a64_vec_refused(c, s, "' expects two vector registers", "an inline-asm vector instruction expects two vector registers"); }
        ret a64_vec_refused(c, s, "' expects three vector registers", "an inline-asm vector instruction expects three vector registers");
    }
    var i: u32 = 0;
    for (i < n) {
        if (!iasm.is_vreg(?item.ops[i::usize]) || item.ops[i::usize].elem == 0) {
            ret a64_vec_refused(c, s, "' takes vector registers with a lane arrangement, such as v0.4s",
                "an inline-asm vector instruction takes vector registers with a lane arrangement, such as v0.4s");
        }
        if (item.ops[i::usize].elem != item.ops[0].elem) {
            ret a64_vec_refused(c, s, "' names different lane arrangements; its operands share one",
                "an inline-asm vector instruction names different lane arrangements; its operands share one");
        }
        i = i + 1;
    }

    var member: u32 = item.code;
    if (member == mop.V_MOV::u32) { member = mop.V_ORR::u32; }
    if (!a64_lane_admits(member, item.ops[0].elem)) {
        ret a64_vec_refused(c, s, "' has no form at this lane arrangement",
            "an inline-asm vector instruction has no form at this lane arrangement");
    }
    if (item.code == mop.V_MOV::u32) {
        item.code   = mop.V_ORR::u32;
        item.ops[2] = item.ops[1];
        item.nops   = 3;
    }
    item.flags = mop.with_elem_bytes(item.flags, item.ops[0].elem);
    ret err[fail.Fail].ok{};
}

# ld1/st1 {vT.<lanes>}, [Xn] [, #16 | , Xm]: one element structure, optionally post-indexed
fun a64_parse_velem(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val n: u32 = s.nargs;
    if (n < 2 || n > 3) {
        ret a64_vec_refused(c, s, "' expects {vT.<lanes>}, [Xn] and an optional post-index",
            "an inline-asm ld1/st1 expects {vT.<lanes>}, [Xn] and an optional post-index");
    }
    var lo: usize = s.arg_lo[0];
    var hi: usize = s.arg_hi[0];
    if (hi < lo + 2 || c.body[lo] != '{'::char || c.body[hi - 1] != '}'::char) {
        ret a64_vec_refused(c, s, "' names its register list in braces, such as {v0.16b}",
            "an inline-asm ld1/st1 names its register list in braces, such as {v0.16b}");
    }
    lo = lo + 1;
    hi = hi - 1;
    for (lo < hi && iasm.is_space(c.body[lo])) { lo = lo + 1; }
    for (hi > lo && iasm.is_space(c.body[hi - 1])) { hi = hi - 1; }
    if (!a64_vreg_region(c.body, lo, hi, ?item.ops[0]) || item.ops[0].elem == 0) {
        ret a64_vec_refused(c, s, "' takes one vector register with a lane arrangement, such as {v0.16b}",
            "an inline-asm ld1/st1 takes one vector register with a lane arrangement, such as {v0.16b}");
    }

    val mem: *iasm.Operand = ?item.ops[1];
    if (mem.kind != iasm.AOP_MEM
        || (mem.flags & (iasm.AOF_HAS_INDEX | iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK | iasm.AOF_MEM_SYM)) != 0) {
        ret a64_vec_refused(c, s, "' addresses a bare [Xn]", "an inline-asm ld1/st1 addresses a bare [Xn]");
    }
    if (n == 3) {
        val post: *iasm.Operand = ?item.ops[2];
        if (post.kind == iasm.AOP_IMM) {
            if (post.imm != 16) {
                ret a64_vec_refused(c, s, "' post-indexes by the structure size, 16",
                    "an inline-asm ld1/st1 post-indexes by the structure size, 16");
            }
            mem.imm = 16;
        }
        or (post.kind == iasm.AOP_REG && !iasm.is_vreg(post) && post.size == 8 && post.reg != 31) {
            mem.index = post.reg;
        }
        or {
            ret a64_vec_refused(c, s, "' post-indexes by 16 or by an X register other than xzr and sp",
                "an inline-asm ld1/st1 post-indexes by 16 or by an X register other than xzr and sp");
        }
        mem.flags = mem.flags | iasm.AOF_WRITEBACK;
        item.nops = 2;
    }
    item.flags = mop.with_elem_bytes(item.flags, item.ops[0].elem);
    ret err[fail.Fail].ok{};
}

# sha256h and sha256h2 take q, q, v.4s; sha256su0 two and sha256su1 three v.4s
fun a64_parse_sha(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val state: bool = item.code == mop.SHA256H::u32 || item.code == mop.SHA256H2::u32;
    var want:  u32  = 3;
    if (item.code == mop.SHA256SU0::u32) { want = 2; }
    var ok: bool = s.nargs == want;
    var i:  u32  = 0;
    for (ok && i < want) {
        val op:   *iasm.Operand = ?item.ops[i::usize];
        var elem: u8            = 4;
        if (state && i < 2)                       { elem = 0; }
        if (!iasm.is_vreg(op) || op.elem != elem) { ok = false; }
        i = i + 1;
    }
    if (ok) { ret err[fail.Fail].ok{}; }
    if (state) {
        ret a64_vec_refused(c, s, "' takes two q registers and a v.4s register, such as q0, q1, v2.4s",
            "an inline-asm sha256h instruction takes two q registers and a v.4s register, such as q0, q1, v2.4s");
    }
    if (want == 2) {
        ret a64_vec_refused(c, s, "' takes two v.4s registers", "an inline-asm sha256su0 instruction takes two v.4s registers");
    }
    ret a64_vec_refused(c, s, "' takes three v.4s registers", "an inline-asm sha256su1 instruction takes three v.4s registers");
}

fun a64_emit_sha(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    var src2: isa.Operand = isa.make_none();
    if (item.nops > 2) { src2 = mop.vec(item.ops[2].reg::u32, 16); }
    var mi: isa.Inst = inst_of(item.code::mop.MachOp, mop.vec(item.ops[0].reg::u32, 16), mop.vec(item.ops[1].reg::u32, 16), src2);
    emit_inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun a64_emit_vec(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val op: mop.MachOp = item.code::mop.MachOp;
    val eb: u8         = mop.elem_bytes(item.flags);
    val rt: u32        = item.ops[0].reg::u32;
    if (a64_pattern(item.flags) == A64P_VELEM) {
        val base: *iasm.Operand = ?item.ops[1];
        emit_neon_elem(st, op, eb, rt, base.reg::u32, (base.flags & iasm.AOF_WRITEBACK) != 0, base.index);
        ret err[fail.Fail].ok{};
    }
    var src2: isa.Operand = isa.make_none();
    if (item.nops > 2) { src2 = mop.vec(item.ops[2].reg::u32, 16); }
    var mi: isa.Inst = inst_of(op, mop.vec(rt, 16), mop.vec(item.ops[1].reg::u32, 16), src2);
    mi.flags = mop.with_elem_bytes(0, eb);
    emit_inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

# ld1/st1 of one eb-laned register at [rn]; a post-index advances rn by 16, or by x`rm` when rm >= 0
fun emit_neon_elem(st: *encode.EncodeState, op: mop.MachOp, eb: u8, rt: u32, rn: u32, post: bool, rm: i32) {
    var index: i32 = -1;
    var disp:  i32 = 0;
    if (post && rm >= 0) { index = mop.gp_id(rm::u32); }
    or (post)            { disp = 16; }
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), disp, index, 1, 16);
    var mi:  isa.Inst    = inst_of(op, mop.vec(rt, 16), mem, isa.make_none());
    if (op == mop.ST1) { mi = inst_of(op, mem, mop.vec(rt, 16), isa.make_none()); }
    mi.flags = mop.with_elem_bytes(0, eb);
    if (post) { mi.flags = mi.flags | mop.FLAG_WB_POST; }
    emit_inst(st, ?mi);
}

fun a64_bare_addr(c: *iasm.Cursor, op: *iasm.Operand) err[fail.Fail] {
    if (op.kind != iasm.AOP_MEM) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ordered access address must be a memory operand")}; }
    if ((op.flags & (iasm.AOF_HAS_INDEX | iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK | iasm.AOF_MEM_SYM)) != 0) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm ordered access addressing must be a bare [Xn]")};
    }
    ret err[fail.Fail].ok{};
}

fun a64_shift_amount(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32) err[fail.Fail] {
    var buf: [24]u8;
    var hw:  u32 = 0;
    if (!iasm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 24)
        || !asm_parse_lsl_amount((?buf[0])::str, ?hw)) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk shift must be 'lsl N'")};
    }
    if ((hw & 0xF) != 0) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk shift must be a multiple of 16")}; }
    hw = hw / 16;
    if (a64_is64(?item.ops[0])) {
        if (hw > 3) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk 64-bit shift exceeds lsl 48")}; }
    }
    or {
        if (hw > 1) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm movz/movk 32-bit shift exceeds lsl 16")}; }
    }
    item.ops[idx::usize] = iasm.op_imm(hw::i64, 1);
    ret err[fail.Fail].ok{};
}

fun a64_branch_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32, allow_sym: bool) err[fail.Fail] {
    val lo:  usize = s.arg_lo[idx::usize];
    val hi:  usize = s.arg_hi[idx::usize];
    var num: u64   = 0;
    var fwd: bool  = false;
    if (iasm.label_ref_span(c.body, lo, hi, ?num, ?fwd)) {
        item.ref     = iasm.AR_LOCAL;
        item.ref_num = num;
        item.ref_fwd = fwd;
        ret err[fail.Fail].ok{};
    }
    if (iasm.is_digit(c.body[lo])) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm numeric local-label reference must be 'Nf' or 'Nb'")};
    }
    if (!allow_sym) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm conditional branch to a symbol is unsupported (no imm19 relocation kind); branch to a numeric local label instead")};
    }
    if (!iasm.is_sym_region(c.body, lo, hi)) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'b' target must be a symbol or a numeric local label")};
    }
    item.ref     = iasm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret err[fail.Fail].ok{};
}

fun a64_emit(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = a64_pattern(item.flags);

    if (pat == A64P_NULLARY) {
        if (item.code == mop.RET::u32) {
            emit_ret(st);
            ret err[fail.Fail].ok{};
        }
        emit_nullary(st, item.code::mop.MachOp);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_RET_REG || pat == A64P_BR_REG) {
        emit_branch_reg(st, item.code::mop.MachOp, item.ops[0].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_IMM16) {
        emit_imm16(st, item.code::mop.MachOp, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MOV)      { ret a64_emit_mov(st, item); }
    if (pat == A64P_MOVEWIDE) { ret a64_emit_movewide(st, item); }
    if (pat == A64P_ADDSUB)   { ret a64_emit_addsub(st, c, item); }
    if (pat == A64P_LOGICAL)  { ret a64_emit_logical(st, c, item); }
    if (pat == A64P_MULH)     { ret a64_emit_logical(st, c, item); }
    if (pat == A64P_CMP)      { ret a64_emit_cmp(st, c, item); }
    if (pat == A64P_CSET) {
        val use64: bool = a64_is64(?item.ops[0]);
        emit_cset(st, use64, item.ops[0].reg::u32, a64_cond(item.flags));
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_ADRP)                                      { ret a64_emit_adrp(st, c, item); }
    if (pat == A64P_BL)                                        { ret a64_emit_call(st, c, item); }
    if (pat == A64P_B || pat == A64P_BCOND || pat == A64P_CBR) { ret a64_emit_branch(st, c, l, item); }
    if (pat == A64P_LDST)                                      { ret a64_emit_ldst(st, c, item); }
    if (pat == A64P_LDSTP)                                     { ret a64_emit_ldstp(st, c, item); }
    if (pat == A64P_DMB) {
        emit_barrier(st, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MSR) {
        if (item.ops[1].kind == iasm.AOP_IMM) {
            val f: u32 = item.ops[0].imm::u32;
            emit_msr_imm(st, (f >> 8) & 0x7, f & 0x7, item.ops[1].imm::u32);
            ret err[fail.Fail].ok{};
        }
        emit_msr_reg(st, item.ops[0].imm::u32, item.ops[1].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MRS) {
        emit_mrs(st, item.ops[1].imm::u32, item.ops[0].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_LDORD) { ret a64_emit_ldord(st, item); }
    if (pat == A64P_STLXR) {
        emit_stxr(st, a64_is64(?item.ops[1]), item.ops[0].reg::u32, item.ops[1].reg::u32, item.ops[2].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_SHIFT)                                     { ret a64_emit_shift(st, c, item); }
    if (pat == A64P_V3 || pat == A64P_V2 || pat == A64P_VELEM) { ret a64_emit_vec(st, item); }
    if (pat == A64P_VSHA)                                      { ret a64_emit_sha(st, item); }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no emitter")};
}

fun a64_emit_mov(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val dst:   *iasm.Operand = ?item.ops[0];
    val src:   *iasm.Operand = ?item.ops[1];
    val use64: bool          = a64_is64(dst);
    if (src.kind == iasm.AOP_REG) {
        if (a64_is_sp(dst) || a64_is_sp(src)) {
            emit_addsub_imm(st, mop.ADD, use64, dst.reg::u32, src.reg::u32, 0, 0);
        }
        or {
            emit_alu3(st, mop.ORR, use64, dst.reg::u32, ZR, src.reg::u32);
        }
        ret err[fail.Fail].ok{};
    }
    emit_asm_mov_imm(st, dst.reg::u32, src.imm::u64, use64);
    ret err[fail.Fail].ok{};
}

fun a64_emit_movewide(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val use64: bool = a64_is64(?item.ops[0]);
    var hw:    u32  = 0;
    if (item.nops == 3) { hw = item.ops[2].imm::u32; }
    emit_movewide(st, item.code::mop.MachOp, use64, item.ops[0].reg::u32, hw, item.ops[1].imm::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_addsub(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val rd:     *iasm.Operand = ?item.ops[0];
    val rn:     *iasm.Operand = ?item.ops[1];
    val op3:    *iasm.Operand = ?item.ops[2];
    val use64:  bool          = a64_is64(rd);
    val is_sub: bool          = item.code == mop.SUB::u32;

    val aop: mop.MachOp = item.code::mop.MachOp;
    if (op3.kind == iasm.AOP_IMM) {
        val v: i64 = op3.imm;
        if (v >= 0 && v <= 4095) {
            emit_addsub_imm(st, aop, use64, rd.reg::u32, rn.reg::u32, v::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            emit_addsub_imm(st, aop, use64, rd.reg::u32, rn.reg::u32, (v >> 12)::u32, 1);
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm add/sub immediate is out of imm12 range")};
    }
    if (op3.kind == iasm.AOP_SYM) {
        if (is_sub)                          { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'sub' has no :lo12: form")}; }
        if (op3.mod != isa.SYM_MOD_PCREL_LO) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'add' symbol operand must be a ':lo12:sym'")}; }
        val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, op3);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.len::u32;
        emit_addsub_imm_sym(st, mop.ADD, use64, rd.reg::u32, rn.reg::u32, sid, isa.SYM_MOD_PCREL_LO, 0);
        val r_3680: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_ADD_LO12, sid, 0);
        if (sel r_3680.err) { ret err[fail.Fail].err{r_3680.err}; }
        ret err[fail.Fail].ok{};
    }
    if (a64_is_sp(rd) || a64_is_sp(rn) || a64_is_sp(op3)) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm add/sub with SP and a register operand requires the extended-register form (unsupported)")};
    }
    emit_alu3(st, aop, use64, rd.reg::u32, rn.reg::u32, op3.reg::u32);
    ret err[fail.Fail].ok{};
}

# the logical rows and the high multiplies: three registers, index 31 is xzr
fun a64_emit_logical(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    if (a64_is_sp(?item.ops[0]) || a64_is_sp(?item.ops[1]) || a64_is_sp(?item.ops[2])) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm three-register form has no sp operand; register 31 there is always xzr")};
    }
    val use64: bool = a64_is64(?item.ops[0]);
    emit_alu3(st, item.code::mop.MachOp, use64, item.ops[0].reg::u32, item.ops[1].reg::u32, item.ops[2].reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_cmp(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val rn:    *iasm.Operand = ?item.ops[0];
    val op2:   *iasm.Operand = ?item.ops[1];
    val use64: bool          = a64_is64(rn);
    if (op2.kind == iasm.AOP_IMM) {
        if (op2.imm < 0 || op2.imm > 4095) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cmp' second operand must be a register or imm12")}; }
        emit_addsub_imm(st, mop.SUBS, use64, ZR, rn.reg::u32, op2.imm::u32, 0);
        ret err[fail.Fail].ok{};
    }
    if (a64_is_sp(rn) || a64_is_sp(op2)) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'cmp' with sp and a register operand requires the extended-register form (unsupported)")};
    }
    emit_alu3(st, mop.SUBS, use64, ZR, rn.reg::u32, op2.reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_adrp(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val sym: *iasm.Operand = ?item.ops[1];
    if (sym.mod == isa.SYM_MOD_PCREL_LO || sym.mod == isa.SYM_MOD_GOT_LO) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm 'adrp' names a page, so its symbol takes no low-half modifier")};
    }
    val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, sym);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    if (sym.mod == isa.SYM_MOD_GOT_HI) { ret emit_adrp_got_reloc(st, item.ops[0].reg::u32, sid); }
    ret emit_adrp_reloc(st, item.ops[0].reg::u32, sid, 0);
}

fun a64_emit_call(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, ?item.ops[0]);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    val pos: u32          = st.buf.len::u32;
    emit_branch_sym(st, mop.BL, sid, 0);
    val r_3738: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PLT32, sid, 0);
    if (sel r_3738.err) { ret err[fail.Fail].err{r_3738.err}; }
    ret err[fail.Fail].ok{};
}

fun a64_emit_branch(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = a64_pattern(item.flags);

    if (item.ref == iasm.AR_SYM) {
        val name: str                        = (c.body::usize + item.ref_off)::str;
        val sr:   res[intern.StrId, A.Error] = intern.intern_bytes(st.interner, name, item.ref_len);
        if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.len::u32;
        emit_branch_sym(st, mop.B, sid, 0);
        val r_3751: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_JUMP26, sid, 0);
        if (sel r_3751.err) { ret err[fail.Fail].err{r_3751.err}; }
        ret err[fail.Fail].ok{};
    }

    var bop:   mop.MachOp = mop.B;
    var cc:    u32        = 0;
    var rt:    u32        = 0;
    var use64: bool       = false;
    if (pat == A64P_BCOND) {
        bop = mop.BCOND;
        cc  = a64_cond(item.flags) & 0xF;
    }
    or (pat == A64P_CBR) {
        bop   = item.code::mop.MachOp;
        use64 = a64_is64(?item.ops[0]);
        rt    = item.ops[0].reg::u32;
    }

    val pos: u32 = st.buf.len::u32;
    emit_branch_local(st, bop, cc, use64, rt, item.ref_num, item.ref_fwd);
    ret iasm.resolve_local(st, c, l, pos, item.ref_num, item.ref_fwd);
}

fun a64_emit_ldst(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val rt:      *iasm.Operand = ?item.ops[0];
    val mem:     *iasm.Operand = ?item.ops[1];
    val is_load: bool          = item.code == mop.LDR::u32 || item.code == mop.LDRB::u32 || item.code == mop.LDRH::u32;
    var w:       u8            = 4;
    if (a64_is64(rt))                                             { w = 8; }
    if (item.code == mop.LDRB::u32 || item.code == mop.STRB::u32) { w = 1; }
    or (item.code == mop.LDRH::u32 || item.code == mop.STRH::u32) { w = 2; }

    val fr: res[A64Access, fail.Fail] = int_access(w, is_load);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val acf: A64Access = fr.ok;

    if ((mem.flags & iasm.AOF_MEM_SYM) != 0) {
        if (mem.mod != isa.SYM_MOD_PCREL_LO && mem.mod != isa.SYM_MOD_GOT_LO) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm ldr/str symbol offset must be a ':lo12:sym' or ':got_lo12:sym'")};
        }
        val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, mem);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.len::u32;
        if (mem.mod == isa.SYM_MOD_GOT_LO) {
            if (!is_load || w != 8) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm ':got_lo12:' offset takes a 64-bit load")}; }
            emit_ldst_sym(st, mop.LDR, false, 8, rt.reg::u32, mem.reg::u32, sid, isa.SYM_MOD_GOT_LO, 0);
            val r_3800: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_LO12, sid, 0);
            if (sel r_3800.err) { ret err[fail.Fail].err{r_3800.err}; }
            ret err[fail.Fail].ok{};
        }
        emit_ldst_sym(st, acf.op, acf.fp, acf.width, rt.reg::u32, mem.reg::u32, sid, isa.SYM_MOD_PCREL_LO, 0);
        val r_3803: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), acf.lo12, sid, 0);
        if (sel r_3803.err) { ret err[fail.Fail].err{r_3803.err}; }
        ret err[fail.Fail].ok{};
    }
    if ((mem.flags & iasm.AOF_HAS_INDEX) != 0) {
        emit_ldst_reg(st, acf.op, acf.fp, acf.width, rt.reg::u32, mem.reg::u32, mem.index::u32);
        ret err[fail.Fail].ok{};
    }
    val no_scratch_r: res[bool, fail.Fail] = mem_access_needs_no_scratch(mem.imm, w);
    if (sel no_scratch_r.err) { ret err[fail.Fail].err{no_scratch_r.err}; }
    if (!no_scratch_r.ok) {
        ret err[fail.Fail].err{iasm.reject(c, a64_offset_message(c, mem.imm))};
    }
    ret emit_mem_access(st, rt.reg::u32, mem.reg::u32, mem.imm, w, is_load);
}

fun a64_offset_message(c: *iasm.Cursor, off: i64) str {
    if (c.interner == nil) {
        ret "inline-asm ldr/str offset is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first";
    }
    var buf: [24]u8;
    var v:   i64 = off;
    if (v < 0) { v = 0 - v; }
    val n: usize = u64_to_dec(v::u64, ?buf[0]);
    buf[n] = 0;
    ret iasm.named_message(c.alloc, c.interner,
        "inline-asm ldr/str offset ", (?buf[0])::str,
        " is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first",
        "inline-asm ldr/str offset is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first");
}

fun a64_emit_ldstp(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val mem:     *iasm.Operand = ?item.ops[2];
    val is_load: bool          = item.code == mop.LDP::u32;
    var disp:    i64           = 0;
    var wb:      u16           = 0;
    if (item.nops == 4) {
        disp = item.ops[3].imm;
        wb   = mop.FLAG_WB_POST;
    }
    or {
        disp = mem.imm;
        if ((mem.flags & iasm.AOF_WRITEBACK) != 0) { wb = mop.FLAG_WB_PRE; }
    }
    if ((disp & 7) != 0) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp offset must be a multiple of 8")}; }
    val q: i64 = disp / 8;
    if (q < -64 || q > 63) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm stp/ldp offset is out of the imm7 range")}; }
    var pop: mop.MachOp = mop.STP;
    if (is_load) { pop = mop.LDP; }
    emit_ldstp(st, pop, false, item.ops[0].reg::u32, item.ops[1].reg::u32, mem.reg::u32, q::u32 & 0x7F, wb);
    ret err[fail.Fail].ok{};
}

fun a64_emit_ldord(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val use64: bool = a64_is64(?item.ops[0]);
    emit_ldord(st, item.code::mop.MachOp, use64, item.ops[0].reg::u32, item.ops[1].reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_shift(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val rd:  *iasm.Operand = ?item.ops[0];
    val rn:  *iasm.Operand = ?item.ops[1];
    val cnt: *iasm.Operand = ?item.ops[2];
    if (a64_is_sp(rd) || a64_is_sp(rn) || (cnt.kind == iasm.AOP_REG && a64_is_sp(cnt))) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm shift has no sp operand form; register 31 there is always xzr")};
    }
    val use64: bool = a64_is64(rd);
    var width: u32  = 32;
    if (use64) { width = 64; }

    val vform:  bool = item.code == mop.LSLV::u32 || item.code == mop.LSRV::u32 || item.code == mop.ASRV::u32;
    val is_lsr: bool = item.code == mop.LSR::u32 || item.code == mop.LSRV::u32;
    val is_asr: bool = item.code == mop.ASR::u32 || item.code == mop.ASRV::u32;

    if (cnt.kind == iasm.AOP_IMM && !vform) {
        val sh:  u32        = cnt.imm::u32 & (width - 1);
        var sop: mop.MachOp = mop.LSL;
        if (is_asr) { sop = mop.ASR; }
        or (is_lsr) { sop = mop.LSR; }
        emit_bitfield(st, sop, use64, rd.reg::u32, rn.reg::u32, sh, 0);
        ret err[fail.Fail].ok{};
    }
    if (cnt.kind != iasm.AOP_REG) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm shift count must be a register or immediate")}; }
    var vop: mop.MachOp = mop.LSLV;
    if (is_lsr) { vop = mop.LSRV; }
    or (is_asr) { vop = mop.ASRV; }
    emit_alu3(st, vop, use64, rd.reg::u32, rn.reg::u32, cnt.reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_intern(st: *encode.EncodeState, c: *iasm.Cursor, op: *iasm.Operand) res[intern.StrId, fail.Fail] {
    val r_3895: res[intern.StrId, A.Error] = intern.intern_bytes(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
    if (sel r_3895.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_3895.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_3895.ok};
}

fun a64_patch(st: *encode.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    var fx: encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret patch_branch_arm64(st, ?fx, target_off);
}

fun a64_slot_from_sp(f: *mir.MirFunction) bool {
    ret true;
}

fun a64_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << SP_REG)) != 0; }
        ret true;
    }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && a64_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && a64_is_sp(?item.ops[1])) { ret true; }
    if ((item.writes & iasm.AW_WB_BASE) != 0) {
        var i: u32 = 0;
        for (i < item.nops) {
            val op: *iasm.Operand = ?item.ops[i::usize];
            if (op.kind == iasm.AOP_MEM && (op.flags & iasm.AOF_WRITEBACK) != 0 && a64_is_sp(op)) {
                ret true;
            }
            i = i + 1;
        }
    }
    ret false;
}

fun a64_grammar() iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = "aarch64";
    g.unknown    = "unknown aarch64 inline-asm instruction '";
    g.rows       = ?A64_MNEMONICS[0];
    g.row_count  = A64_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD32[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = a64_decode_bcond;
    g.parse      = a64_parse;
    g.emit       = a64_emit;
    g.patch      = a64_patch;
    g.slot       = asm_slot_offset;
    g.slot_sp    = a64_slot_from_sp;
    g.writes_sp  = a64_writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = a64_decl_reg;
    g.no_fall    = a64_no_fall;
    ret g;
}

fun a64_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == mop.BRK::u32;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.returns(?g, body);
}

fun a64_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: iasm.Operand = iasm.op_none();
    if (a64_reg(name, ?op) && op.size == 8 && op.reg >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = op.reg::u32;
        ret true;
    }
    var n: u32 = 0;
    if (a64_vec_index(name, ?n)) {
        @bank = iasm.ABANK_FP;
        @idx  = n;
        ret true;
    }
    ret false;
}

fun a64_vec_index(name: str, out: *u32) bool {
    val len: usize = str_len(name);
    if (len < 2 || len > 3)   { ret false; }
    if (name[0] != 'v'::char) { ret false; }
    var n: u32   = 0;
    var i: usize = 1;
    for (i < len) {
        if (!iasm.is_digit(name[i])) { ret false; }
        n = n * 10 + (name[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    @out = n;
    ret true;
}

pub fun asm_writes_sp(body: str) bool {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.writes_sp(?g, body);
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = a64_grammar();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block_arm64(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.encode_block(st, ?g, f, mi);
}

fun a64_asm_text(st: *encode.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) err[fail.Fail] {
    var g: iasm.Grammar = a64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

var t_model_arm64: isa.MachineModel;

fun arm64_machine() *isa.MachineModel {
    t_model_arm64.extension_table = ?arm64.EXTENSIONS[0];
    t_model_arm64.extension_count = arm64.EXTENSION_COUNT;
    t_model_arm64.pointer_width   = 8;
    t_model_arm64.gpr_width       = 8;
    t_model_arm64.max_alu_width   = 8;
    t_model_arm64.alu_min_width   = 4;
    t_model_arm64.spill_width     = 8;
    t_model_arm64.flen_bits       = 64;
    ret ?t_model_arm64;
}

fun tbuf(st: *encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    encode.state_blank(st, alloc, arm64_machine());
}

fun tbuf_interned(st: *encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    encode.state_blank(st, alloc, arm64_machine());
    st.interner = itn;
}

fun tvec(n: i32) mir.MirOperand {
    ret mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, n)));
}

# the words the assembler produces for a spelled instruction: the packer
# tests state each expectation against `llvm-mc` output through these
fun t_asm(op: mop.MachOp, dst: isa.Operand, src1: isa.Operand, src2: isa.Operand) u32 {
    var mi: isa.Inst = inst_of(op, dst, src1, src2);
    ret mop.assemble(?mi);
}

fun t_alu(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    ret t_asm(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
}

fun t_alu_sp(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    mi.flags = mop.FLAG_SP;
    ret mop.assemble(?mi);
}

fun t_fp3(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    ret t_asm(op, mop.vec(rd, w), mop.vec(rn, w), mop.vec(rm, w));
}

fun t_imm(op: mop.MachOp, w: u8, rd: u32, rn: u32, imm12: u32, sh: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), isa.make_imm(imm12::i64, w));
    if (sh != 0) { mi.src3 = isa.make_imm(12, 1); }
    mi.flags = mop.FLAG_SP;
    ret mop.assemble(?mi);
}

fun t_mw(op: mop.MachOp, w: u8, rd: u32, hw: u32, imm16: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), isa.make_none(), isa.make_imm(imm16::i64, w));
    if (hw != 0) { mi.src3 = isa.make_imm((hw * 16)::i64, 1); }
    ret mop.assemble(?mi);
}

fun t_cset(w: u8, rd: u32, cc: u32) u32 {
    var mi: isa.Inst = inst_of(mop.CSET, mop.gp(rd, w), isa.make_none(), isa.make_none());
    mi.flags = mop.with_cond(0, cc);
    ret mop.assemble(?mi);
}

fun t_madd(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32, ra: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    mi.src3 = mop.gp(ra, w);
    ret mop.assemble(?mi);
}

fun t_skip(op: mop.MachOp, cc: u32, w: u8, rt: u32, imm19: u32) u32 {
    var target: isa.Operand = isa.make_local_label(true);
    target.disp = (imm19 * 4)::i32;
    var mi: isa.Inst = branch_inst(op, cc, w == 8, rt, target);
    mi.flags = mi.flags | mop.FLAG_LABEL_SKIP;
    ret mop.assemble(?mi);
}

fun t_ldst(op: mop.MachOp, fp: bool, w: u8, rt: u32, rn: u32, imm12: u32) u32 {
    val bytes: u8       = access_bytes(op, w);
    var mi:    isa.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa.make_mem(mop.gp_id(rn), (imm12 * bytes::u32)::i32, -1, 0, bytes));
    ret mop.assemble(?mi);
}

fun t_ldur(op: mop.MachOp, fp: bool, w: u8, rt: u32, rn: u32, imm9: u32) u32 {
    val bytes: u8       = access_bytes(op, w);
    var mi:    isa.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa.make_mem(mop.gp_id(rn), sign_extend_field(imm9, 9)::i32, -1, 0, bytes));
    ret mop.assemble(?mi);
}

fun t_ldst_reg(op: mop.MachOp, fp: bool, w: u8, rt: u32, rn: u32, rm: u32) u32 {
    val bytes: u8       = access_bytes(op, w);
    var mi:    isa.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa.make_mem(mop.gp_id(rn), 0, mop.gp_id(rm), 1, bytes));
    ret mop.assemble(?mi);
}

fun t_ldstp(op: mop.MachOp, fp: bool, rt: u32, rt2: u32, rn: u32, imm7: u32) u32 {
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), (sign_extend_field(imm7, 7) * 8)::i32, -1, 0, 8);
    var mi:  isa.Inst    = inst_of(op, mem, shaped_reg(fp, rt, 8), shaped_reg(fp, rt2, 8));
    if (op == mop.LDP) { mi = inst_of(op, shaped_reg(fp, rt, 8), shaped_reg(fp, rt2, 8), mem); }
    ret mop.assemble(?mi);
}

fun t_neon3(op: mop.MachOp, eb: u8, rd: u32, rn: u32, rm: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.vec(rd, 16), mop.vec(rn, 16), mop.vec(rm, 16));
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_neon2(op: mop.MachOp, rd: u32, rn: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.vec(rd, 16), mop.vec(rn, 16), isa.make_none());
    mi.flags = mop.with_elem_bytes(0, 1);
    ret mop.assemble(?mi);
}

fun t_lane_rd(op: mop.MachOp, dst: isa.Operand, eb: u8, index: u32, rn: u32) u32 {
    var mi: isa.Inst = inst_of(op, dst, mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_ins_gp(eb: u8, index: u32, rd: u32, rn: u32) u32 {
    var src_w: u8 = 4;
    if (eb == 8) { src_w = 8; }
    var mi: isa.Inst = inst_of(mop.INS, mop.vec(rd, 16), mop.gp(rn, src_w), isa.make_imm(index::i64, 1));
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_ins_el(eb: u8, index: u32, src_index: u32, rd: u32, rn: u32) u32 {
    var mi: isa.Inst = inst_of(mop.INS_EL, mop.vec(rd, 16), mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.src3  = isa.make_imm(src_index::i64, 1);
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_reg1(op: mop.MachOp, rn: u32) u32 {
    ret t_asm(op, isa.make_none(), mop.gp(rn, 8), isa.make_none());
}

test "mach.lang.target.isa.arm64.encode:three_address_alu_register_forms" {
    var bad: i32 = 0;
    if (t_alu(mop.ADD, 8, 0, 1, 2) != 0x8B020020)   { bad = 1; }
    if (t_alu(mop.ADD, 4, 0, 1, 2) != 0x0B020020)   { bad = 1; }
    if (t_alu(mop.SUB, 8, 0, 1, 2) != 0xCB020020)   { bad = 1; }
    if (t_alu(mop.SUB, 4, 0, 1, 2) != 0x4B020020)   { bad = 1; }
    if (t_alu(mop.MUL, 8, 0, 1, 2) != 0x9B027C20)   { bad = 1; }
    if (t_alu(mop.MUL, 4, 0, 1, 2) != 0x1B027C20)   { bad = 1; }
    if (t_alu(mop.UMULH, 8, 0, 1, 2) != 0x9BC27C20) { bad = 1; }
    if (t_alu(mop.SMULH, 8, 3, 4, 5) != 0x9B457C83) { bad = 1; }
    if (t_alu(mop.AND, 8, 0, 1, 2) != 0x8A020020)   { bad = 1; }
    if (t_alu(mop.ORR, 8, 0, 1, 2) != 0xAA020020)   { bad = 1; }
    if (t_alu(mop.EOR, 8, 0, 1, 2) != 0xCA020020)   { bad = 1; }
    if (t_alu(mop.AND, 4, 0, 1, 2) != 0x0A020020)   { bad = 1; }
    if (t_alu(mop.ORR, 4, 0, 1, 2) != 0x2A020020)   { bad = 1; }
    if (t_alu(mop.EOR, 4, 0, 1, 2) != 0x4A020020)   { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:register_shifts" {
    var bad: i32 = 0;
    if (t_alu(mop.LSLV, 8, 0, 1, 2) != 0x9AC22020) { bad = 1; }
    if (t_alu(mop.LSLV, 4, 0, 1, 2) != 0x1AC22020) { bad = 1; }
    if (t_alu(mop.LSRV, 8, 0, 1, 2) != 0x9AC22420) { bad = 1; }
    if (t_alu(mop.LSRV, 4, 0, 1, 2) != 0x1AC22420) { bad = 1; }
    if (t_alu(mop.ASRV, 8, 0, 1, 2) != 0x9AC22820) { bad = 1; }
    if (t_alu(mop.ASRV, 4, 0, 1, 2) != 0x1AC22820) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:immediate_shifts" {
    var bad:   i32 = 0;
    var st:    encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(0));
    ops[1] = mir.op_preg(mir.preg_id(1));
    ops[2] = mir.op_imm(3);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 0, 0, 0);
    mi.operand_count = 3;

    mi.width = 8;
    encode_shift(?st, ?mi, arm64.LSL::u32);
    if (read_word(?st.buf, 0) != 0xD37DF020) { bad = 1; }
    mi.width = 4;
    encode_shift(?st, ?mi, arm64.LSL::u32);
    if (read_word(?st.buf, 4) != 0x531D7020) { bad = 1; }
    mi.width = 8;
    encode_shift(?st, ?mi, arm64.LSR::u32);
    if (read_word(?st.buf, 8) != 0xD343FC20) { bad = 1; }
    mi.width = 4;
    encode_shift(?st, ?mi, arm64.LSR::u32);
    if (read_word(?st.buf, 12) != 0x53037C20) { bad = 1; }
    mi.width = 8;
    encode_shift(?st, ?mi, arm64.ASR::u32);
    if (read_word(?st.buf, 16) != 0x9343FC20) { bad = 1; }
    mi.width = 4;
    encode_shift(?st, ?mi, arm64.ASR::u32);
    if (read_word(?st.buf, 20) != 0x13037C20) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

