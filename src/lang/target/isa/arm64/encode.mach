test "mach.lang.target.isa.arm64.encode:float_constant_materialization" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    var f: mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 2, 0, 0);

    ops[0] = tvec(0); ops[1] = mir.op_imm(0);
    mi.opcode = arm64.FMOV::u32; mi.width = 8; st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.len != 4)                      { bad = 1; }
    if (read_word(?st.buf, 0) != 0x9E6703E0)  { bad = 1; }
    if (st.const_count != 0)                  { bad = 1; }
    if (st.reloc_count != 0)                  { bad = 1; }

    ops[1] = mir.op_imm(0x4000000000000000);
    st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.len != 4)                      { bad = 1; }
    if (read_word(?st.buf, 0) != 0x1E601000)  { bad = 1; }
    if (st.const_count != 0)                  { bad = 1; }
    if (st.reloc_count != 0)                  { bad = 1; }

    ops[1] = mir.op_imm(0x7FF0000000000000);
    st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.len != 8)                      { bad = 1; }
    if (read_word(?st.buf, 0) != 0xD2EFFE10)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0x9E670200)  { bad = 1; }
    if (st.const_count != 0)                  { bad = 1; }
    if (st.reloc_count != 0)                  { bad = 1; }

    ops[1] = mir.op_imm(0x3FB999999999999A);
    st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.len != 8)                      { bad = 1; }
    if (read_word(?st.buf, 0) != 0x90000010)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0xFD400200)  { bad = 1; }
    if (st.const_count != 1)                  { bad = 1; }
    if (st.reloc_count != 2)                  { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PAGE21)       { bad = 1; }
        if (st.relocs[0].offset != 0)                { bad = 1; }
        if (st.relocs[1].kind != of.RK_LDST64_LO12)  { bad = 1; }
        if (st.relocs[1].offset != 4)                { bad = 1; }
        if (st.relocs[0].sym != st.relocs[1].sym)    { bad = 1; }
        if (st.relocs[0].sym != st.consts[0].sym)    { bad = 1; }
    }
    if (st.consts[0].len != 8 || st.consts[0].align != 8) { bad = 1; }
    or {
        if (st.consts[0].bytes[0] != 0x9A) { bad = 1; }
        if (st.consts[0].bytes[7] != 0x3F) { bad = 1; }
    }

    ops[1] = mir.op_imm(0x3DCCCCCD);
    mi.width = 4; st.buf.len = 0;
    val reloc_before: u32 = st.reloc_count;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.len != 8)                      { bad = 1; }
    if (read_word(?st.buf, 0) != 0x90000010)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0xBD400200)  { bad = 1; }
    if (st.const_count != 2)                  { bad = 1; }
    if (st.reloc_count != reloc_before + 2)   { bad = 1; }
    or {
        if (st.relocs[reloc_before + 1].kind != of.RK_LDST32_LO12) { bad = 1; }
    }
    if (st.consts[1].len != 4 || st.consts[1].align != 4) { bad = 1; }

    st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.const_count != 2) { bad = 1; }

    mi.operand_count = 3;
    ops[0] = tvec(0); ops[1] = tvec(1); ops[2] = mir.op_imm(0x4000000000000000);
    mi.opcode = mir.MIR_FMUL; mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (st.buf.len != 8)                      { bad = 1; }
    if (read_word(?st.buf, 0) != 0x1E60101E)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0x1E7E0820)  { bad = 1; }

    encode.consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    encode.buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:fmov_scalar_immediate_and_boundary" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var itn: intern.Interner;
    tbuf_interned(?st, ?alloc, ?itn);
    var f: mir.MirFunction;
    var ops: [2]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(arm64.FMOV::u32, ?ops[0], 2, 8, 0);
    ops[0] = tvec(0);

    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x3FF0000000000000, 8, 0x1E6E1000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x4000000000000000, 8, 0x1E601000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x3FE0000000000000, 8, 0x1E6C1000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0xBFF8000000000000::i64, 8, 0x1E7F1000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x3FC0000000000000, 8, 0x1E681000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x403F000000000000, 8, 0x1E67F000) != 0) { bad = 1; }

    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0xBFC00000, 4, 0x1E3F1000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x3E000000, 4, 0x1E281000) != 0) { bad = 1; }
    if (t_fmov_imm(?st, ?f, ?mi, ?ops[1], 0x41F80000, 4, 0x1E27F000) != 0) { bad = 1; }

    val r_5072: opt[u32] = fmov_imm8(0x3FB0000000000000, true);
    if (sel r_5072.some) { bad = 1; }
    val r_5073: opt[u32] = fmov_imm8(0x4040000000000000, true);
    if (sel r_5073.some) { bad = 1; }
    val r_5074: opt[u32] = fmov_imm8(0x3FF0800000000000, true);
    if (sel r_5074.some) { bad = 1; }
    val r_5075: opt[u32] = fmov_imm8(0x3D800000, false);
    if (sel r_5075.some) { bad = 1; }
    val r_5076: opt[u32] = fmov_imm8(0x42000000, false);
    if (sel r_5076.some) { bad = 1; }
    val r_5077: opt[u32] = fmov_imm8(0x3F840000, false);
    if (sel r_5077.some) { bad = 1; }
    val r_5078: opt[u32] = fmov_imm8(0, true);
    if (sel r_5078.some) { bad = 1; }
    val r_5079: opt[u32] = fmov_imm8(0x7FF0000000000000, true);
    if (sel r_5079.some) { bad = 1; }

    ops[1] = mir.op_imm(0x3FB0000000000000);
    mi.width = 8; st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi);
    if (st.buf.len != 8) { bad = 1; }

    encode.consts_free(?alloc, st.consts, st.const_count, st.const_cap);
    encode.buf_dnit(?st.buf);
    intern.dnit(?itn);
    ret bad;
}

fun t_fmov_imm(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr,
               src: *mir.MirOperand, bits: i64, w: u8, want: u32) i32 {
    @src = mir.op_imm(bits);
    mi.width = w;
    st.buf.len = 0;
    encode_fmov(st, f, mi);
    if (st.buf.len != 4)            { ret 1; }
    if (read_word(?st.buf, 0) != want) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:spilled_float_operands_route_through_fp_scratch" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_SPILL;
    slots[0].offset = -8;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;

    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);

    ops[0] = tvec(0); ops[1] = mir.op_mem_slot(mir.vreg_id(100), 0); ops[2] = tvec(2);
    mi.opcode = mir.MIR_FADD; mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0xFC5F83BF) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x1E622BE0) { bad = 1; }

    ops[0] = mir.op_mem_slot(mir.vreg_id(100), 0); ops[1] = tvec(1); ops[2] = tvec(2);
    st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x1E62283F) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xFC1F83BF) { bad = 1; }

    var mops: [2]mir.MirOperand;
    var mv: mir.MirInstr = mir.instr(mir.MIR_MOV, ?mops[0], 2, 8, 0);
    mops[0] = tvec(5); mops[1] = mir.op_mem_slot(mir.vreg_id(100), 0);
    st.buf.len = 0;
    encode_fmov(?st, ?f, ?mv); if (read_word(?st.buf, 0) != 0xFC5F83A5) { bad = 1; }
    mops[0] = mir.op_mem_slot(mir.vreg_id(100), 0); mops[1] = tvec(5);
    st.buf.len = 0;
    encode_fmov(?st, ?f, ?mv); if (read_word(?st.buf, 0) != 0xFC1F83A5) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:ldr_str_addressing_mode_legalization" {
    var bad: i32 = 0;
