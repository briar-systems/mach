val A64_SYSREG_NAME_MAX: usize = 32;

fun a64_name_eq(name: str, want: str) bool {
    val n: usize = str_len(name);
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var c: u32 = name[i]::u32;
        if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
        if (c != want[i]::u32) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun a64_sysreg_field(name: str, pos: *usize, max: u32, out: *u32) bool {
    val n: usize = str_len(name);
    var i: usize = @pos;
    var v: u32 = 0;
    var digits: u32 = 0;
    for (i < n && name[i]::u32 >= '0'::u32 && name[i]::u32 <= '9'::u32) {
        v      = v * 10 + (name[i]::u32 - '0'::u32);
        digits = digits + 1;
        if (digits > 2) { ret false; }
        i = i + 1;
    }
    if (digits == 0 || v > max) { ret false; }
    @pos = i;
    @out = v;
    ret true;
}

fun a64_sysreg_char(name: str, pos: *usize, want: char) bool {
    if (@pos >= str_len(name)) { ret false; }
    var c: u32 = name[@pos]::u32;
    if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
    if (c != want::u32) { ret false; }
    @pos = @pos + 1;
    ret true;
}

fun a64_sysreg_numeric(name: str, op0_out: *u32, op1_out: *u32, crn_out: *u32, crm_out: *u32, op2_out: *u32) bool {
    var i: usize = 0;
    if (!a64_sysreg_char(name, ?i, 's'::char)) { ret false; }

    var op0: u32 = 0;
    if (!a64_sysreg_field(name, ?i, 3, ?op0)) { ret false; }
    if (op0 < 2)                              { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var op1: u32 = 0;
    if (!a64_sysreg_field(name, ?i, 7, ?op1))  { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var crn: u32 = 0;
    if (!a64_sysreg_char(name, ?i, 'c'::char)) { ret false; }
    if (!a64_sysreg_field(name, ?i, 15, ?crn)) { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var crm: u32 = 0;
    if (!a64_sysreg_char(name, ?i, 'c'::char)) { ret false; }
    if (!a64_sysreg_field(name, ?i, 15, ?crm)) { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var op2: u32 = 0;
    if (!a64_sysreg_field(name, ?i, 7, ?op2)) { ret false; }
    if (i != str_len(name)) { ret false; }

    @op0_out = op0; @op1_out = op1; @crn_out = crn; @crm_out = crm; @op2_out = op2;
    ret true;
}

fun a64_pstate_field(name: str, op1_out: *u32, op2_out: *u32) bool {
    if (a64_name_eq(name, "daifset")) { @op1_out = 3; @op2_out = 6; ret true; }
    if (a64_name_eq(name, "daifclr")) { @op1_out = 3; @op2_out = 7; ret true; }
    if (a64_name_eq(name, "spsel"))   { @op1_out = 0; @op2_out = 5; ret true; }
    if (a64_name_eq(name, "pan"))     { @op1_out = 0; @op2_out = 4; ret true; }
    if (a64_name_eq(name, "uao"))     { @op1_out = 0; @op2_out = 3; ret true; }
    if (a64_name_eq(name, "ssbs"))    { @op1_out = 3; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "dit"))     { @op1_out = 3; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "tco"))     { @op1_out = 3; @op2_out = 4; ret true; }
    ret false;
}

fun a64_sysreg(name: str, op0_out: *u32, op1_out: *u32, crn_out: *u32, crm_out: *u32, op2_out: *u32) bool {
    if (a64_name_eq(name, "cntvct_el0"))    { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 0; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "cntpct_el0"))    { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "cntfrq_el0"))    { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "cntv_ctl_el0"))  { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 3; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "cntv_cval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 3; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "cntv_tval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 3; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "cntp_ctl_el0"))  { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 2; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "cntp_cval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 2; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "cntp_tval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "cntkctl_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out = 14; @crm_out = 1; @op2_out = 0; ret true; }

    if (a64_name_eq(name, "vbar_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out = 12; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "elr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "spsr_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "esr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  5; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "far_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  6; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "sp_el0"))    { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 1; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "sp_el1"))    { @op0_out = 3; @op1_out = 4; @crn_out =  4; @crm_out = 1; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "spsel"))     { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "currentel")) { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 2; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "daif"))      { @op0_out = 3; @op1_out = 3; @crn_out =  4; @crm_out = 2; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "nzcv"))      { @op0_out = 3; @op1_out = 3; @crn_out =  4; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "dit"))       { @op0_out = 3; @op1_out = 3; @crn_out =  4; @crm_out = 2; @op2_out = 5; ret true; }

    if (a64_name_eq(name, "vbar_el2"))  { @op0_out = 3; @op1_out = 4; @crn_out = 12; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "elr_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  4; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "spsr_el2"))  { @op0_out = 3; @op1_out = 4; @crn_out =  4; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "esr_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  5; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "far_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  6; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "sctlr_el2")) { @op0_out = 3; @op1_out = 4; @crn_out =  1; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "hcr_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  1; @crm_out = 1; @op2_out = 0; ret true; }

    if (a64_name_eq(name, "sctlr_el1")) { @op0_out = 3; @op1_out = 0; @crn_out =  1; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "tcr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  2; @crm_out = 0; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "ttbr0_el1")) { @op0_out = 3; @op1_out = 0; @crn_out =  2; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "ttbr1_el1")) { @op0_out = 3; @op1_out = 0; @crn_out =  2; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "mair_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out = 10; @crm_out = 2; @op2_out = 0; ret true; }

    if (a64_name_eq(name, "tpidr_el0"))   { @op0_out = 3; @op1_out = 3; @crn_out = 13; @crm_out = 0; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "tpidrro_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 13; @crm_out = 0; @op2_out = 3; ret true; }
    if (a64_name_eq(name, "tpidr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out = 13; @crm_out = 0; @op2_out = 4; ret true; }

    if (a64_name_eq(name, "midr_el1"))         { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "mpidr_el1"))        { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 0; @op2_out = 5; ret true; }
    if (a64_name_eq(name, "ctr_el0"))          { @op0_out = 3; @op1_out = 3; @crn_out = 0; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "dczid_el0"))        { @op0_out = 3; @op1_out = 3; @crn_out = 0; @crm_out = 0; @op2_out = 7; ret true; }
    if (a64_name_eq(name, "id_aa64pfr0_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 4; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "id_aa64isar0_el1")) { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 6; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "id_aa64mmfr0_el1")) { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 7; @op2_out = 0; ret true; }

    ret a64_sysreg_numeric(name, op0_out, op1_out, crn_out, crm_out, op2_out);
}

fun pack_alu3(base: u32, rd: u32, rn: u32, rm: u32) u32 {
    ret base | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_addsub_imm(base: u32, rd: u32, rn: u32, imm12: u32, sh: u32) u32 {
    ret base | ((sh & 0x1) << 22) | ((imm12 & 0xFFF) << 10) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_bitfield(base: u32, rd: u32, rn: u32, immr: u32, imms: u32) u32 {
    ret base | ((immr & 0x3F) << 16) | ((imms & 0x3F) << 10) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_movewide(base: u32, rd: u32, hw: u32, imm16: u32) u32 {
    ret base | ((hw & 0x3) << 21) | ((imm16 & 0xFFFF) << 5) | (rd & 0x1F);
}

fun pack_neon_3same(base: u32, size: u32, rd: u32, rn: u32, rm: u32) u32 {
    ret base | ((size & 0x3) << 22) | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_neon_2misc(base: u32, rd: u32, rn: u32) u32 {
    ret base | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun neon_imm5(size: u32, index: u32) u32 {
    ret (index << (size + 1)) | (1 << size);
}

fun pack_neon_lane_read(base: u32, size: u32, index: u32, rd: u32, rn: u32) u32 {
    ret base | ((neon_imm5(size, index) & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_neon_ins_gp(size: u32, index: u32, rd: u32, rn: u32) u32 {
    ret VINS_GP | ((neon_imm5(size, index) & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_neon_ins_el(size: u32, index: u32, src_index: u32, rd: u32, rn: u32) u32 {
    ret VINS_EL | ((neon_imm5(size, index) & 0x1F) << 16) | (((src_index << size) & 0xF) << 11)
        | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_neon_dup_el(size: u32, index: u32, rd: u32, rn: u32) u32 {
    ret VDUP_EL | ((neon_imm5(size, index) & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_cmp_reg(base: u32, rn: u32, rm: u32) u32 {
    ret base | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | ZR;
}

fun pack_cmp_imm(base: u32, rn: u32, imm12: u32) u32 {
    ret base | ((imm12 & 0xFFF) << 10) | ((rn & 0x1F) << 5) | ZR;
}

fun pack_cset(base: u32, rd: u32, cc: u32) u32 {
    val inv: u32 = cc ^ 1;
    ret base | (ZR << 16) | ((inv & 0xF) << 12) | (ZR << 5) | (rd & 0x1F);
}

fun pack_ldstp(base: u32, rt: u32, rt2: u32, rn: u32, imm7: u32) u32 {
    ret base | ((imm7 & 0x7F) << 15) | ((rt2 & 0x1F) << 10) | ((rn & 0x1F) << 5) | (rt & 0x1F);
}

fun pack_ldst(base: u32, rt: u32, rn: u32, imm12: u32) u32 {
    ret base | ((imm12 & 0xFFF) << 10) | ((rn & 0x1F) << 5) | (rt & 0x1F);
}

fun pack_cbnz(base: u32, rt: u32) u32 {
    ret base | (rt & 0x1F);
}

fun pack_cbnz_off(base: u32, rt: u32, imm19: u32) u32 {
    ret base | ((imm19 & 0x7FFFF) << 5) | (rt & 0x1F);
}

fun pack_bcond(imm19: u32, cond: u32) u32 {
    ret BCOND | ((imm19 & 0x7FFFF) << 5) | (cond & 0xF);
}

fun pack_madd(base: u32, rd: u32, rn: u32, rm: u32, ra: u32) u32 {
    ret base | ((rm & 0x1F) << 16) | ((ra & 0x1F) << 10) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_alu3_sh(base: u32, rd: u32, rn: u32, rm: u32, sh: u32) u32 {
    ret base | ((rm & 0x1F) << 16) | ((sh & 0x3F) << 10) | ((rn & 0x1F) << 5) | (rd & 0x1F);
}

fun pack_ldur(base: u32, rt: u32, rn: u32, imm9: u32) u32 {
    ret base | ((imm9 & 0x1FF) << 12) | ((rn & 0x1F) << 5) | (rt & 0x1F);
}

fun pack_ldst_reg(base: u32, rt: u32, rn: u32, rm: u32) u32 {
    ret base | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rt & 0x1F);
}

fun pack_blr(rn: u32) u32 {
    ret BLR_BASE | ((rn & 0x1F) << 5);
}

fun pack_adrp(rd: u32) u32 {
    ret ADRP_BASE | (rd & 0x1F);
}

rec A64Access {
    scaled:   u32;
    unscaled: u32;
    reg:      u32;
    shift:    u32;
    lo12:     of.RelocKind;
}

fun acc(scaled: u32, unscaled: u32, reg: u32, shift: u32, lo12: of.RelocKind) R.Result[A64Access, str] {
    var a: A64Access;
    a.scaled   = scaled;
    a.unscaled = unscaled;
    a.reg      = reg;
    a.shift    = shift;
    a.lo12     = lo12;
    ret R.ok[A64Access, str](a);
}

fun int_access(w: u8, is_load: bool) R.Result[A64Access, str] {
    if (w == 1) {
        if (is_load) { ret acc(LDRB_OFF, LDURB, LDRB_REG, 0, of.RK_LDST8_LO12); }
        ret acc(STRB_OFF, STURB, STRB_REG, 0, of.RK_LDST8_LO12);
    }
    if (w == 2) {
        if (is_load) { ret acc(LDRH_OFF, LDURH, LDRH_REG, 1, of.RK_LDST16_LO12); }
        ret acc(STRH_OFF, STURH, STRH_REG, 1, of.RK_LDST16_LO12);
    }
    if (w == 4) {
        if (is_load) { ret acc(LDRW_OFF, LDURW, LDRW_REG, 2, of.RK_LDST32_LO12); }
        ret acc(STRW_OFF, STURW, STRW_REG, 2, of.RK_LDST32_LO12);
    }
    if (w == 8) {
        if (is_load) { ret acc(LDR_OFF_X, LDUR_X, LDR_REG_X, 3, of.RK_LDST64_LO12); }
        ret acc(STR_OFF_X, STUR_X, STR_REG_X, 3, of.RK_LDST64_LO12);
    }
    ret R.err[A64Access, str]("internal compiler error: aarch64 has no integer memory access form for this width (expected 1, 2, 4, or 8)");
}

fun fp_access(w: u8, is_load: bool) R.Result[A64Access, str] {
    if (w == 1) {
        if (is_load) { ret acc(LDR_B_OFF, LDUR_B_FP, LDR_B_REG, 0, of.RK_LDST8_LO12); }
        ret acc(STR_B_OFF, STUR_B_FP, STR_B_REG, 0, of.RK_LDST8_LO12);
    }
    if (w == 2) {
        if (is_load) { ret acc(LDR_H_OFF, LDUR_H_FP, LDR_H_REG, 1, of.RK_LDST16_LO12); }
        ret acc(STR_H_OFF, STUR_H_FP, STR_H_REG, 1, of.RK_LDST16_LO12);
    }
    if (w == 4) {
        if (is_load) { ret acc(LDR_S_OFF, LDUR_S_FP, LDR_S_REG, 2, of.RK_LDST32_LO12); }
        ret acc(STR_S_OFF, STUR_S_FP, STR_S_REG, 2, of.RK_LDST32_LO12);
    }
    if (w == 8) {
        if (is_load) { ret acc(LDR_D_OFF, LDUR_D_FP, LDR_D_REG, 3, of.RK_LDST64_LO12); }
        ret acc(STR_D_OFF, STUR_D_FP, STR_D_REG, 3, of.RK_LDST64_LO12);
    }
    if (w == 16) {
        if (is_load) { ret acc(LDR_Q_OFF, LDUR_Q_FP, LDR_Q_REG, 4, of.RK_LDST128_LO12); }
        ret acc(STR_Q_OFF, STUR_Q_FP, STR_Q_REG, 4, of.RK_LDST128_LO12);
    }
    ret R.err[A64Access, str]("internal compiler error: aarch64 has no float memory access form for this width (expected 1, 2, 4, 8, or 16)");
}

fun emit_word(st: *encode.EncodeState, word: u32) {
    encode.emit_u32(?st.buf, word);
}

rec Alu3Shape {
    dst_fp: bool;
    dst_w:  u8;
    src_fp: bool;
    src_w:  u8;
    arity:  u8;
}

fun a3(dst_fp: bool, dst_w: u8, src_fp: bool, src_w: u8, arity: u8) Alu3Shape {
    var s: Alu3Shape;
    s.dst_fp = dst_fp;
    s.dst_w  = dst_w;
    s.src_fp = src_fp;
    s.src_w  = src_w;
    s.arity  = arity;
    ret s;
}

fun alu3_shape(base: u32) Alu3Shape {
    if (base == ADD_X || base == SUB_X || base == AND_X || base == ORR_X ||
        base == EOR_X || base == ORN_X || base == MUL_X || base == LSLV_X ||
        base == LSRV_X || base == ASRV_X || base == SDIV_X || base == UDIV_X ||
        base == SUBS_REG_X || base == SUB_SP_REG_X) { ret a3(false, 8, false, 8, 3); }
    if (base == ADD_W || base == SUB_W || base == AND_W || base == ORR_W ||
        base == EOR_W || base == ORN_W || base == MUL_W || base == LSLV_W ||
        base == LSRV_W || base == ASRV_W || base == SDIV_W || base == UDIV_W ||
        base == SUBS_REG_W)                         { ret a3(false, 4, false, 4, 3); }

    if (base == FADD_S || base == FSUB_S || base == FMUL_S || base == FDIV_S) { ret a3(true, 4, true, 4, 3); }
    if (base == FADD_D || base == FSUB_D || base == FMUL_D || base == FDIV_D) { ret a3(true, 8, true, 8, 3); }
    if (base == FNEG_S || base == FMOV_S) { ret a3(true, 4, true, 4, 2); }
    if (base == FNEG_D || base == FMOV_D) { ret a3(true, 8, true, 8, 2); }
    if (base == FCVT_S2D)                 { ret a3(true, 8, true, 4, 2); }
    if (base == FCVT_D2S)                 { ret a3(true, 4, true, 8, 2); }
    if (base == FCMP_S)                   { ret a3(true, 4, true, 4, 0); }
    if (base == FCMP_D)                   { ret a3(true, 8, true, 8, 0); }

    if (base == SCVTF_S_W || base == UCVTF_S_W) { ret a3(true, 4, false, 4, 2); }
    if (base == SCVTF_D_W || base == UCVTF_D_W) { ret a3(true, 8, false, 4, 2); }
    if (base == SCVTF_S_X || base == UCVTF_S_X) { ret a3(true, 4, false, 8, 2); }
    if (base == SCVTF_D_X || base == UCVTF_D_X) { ret a3(true, 8, false, 8, 2); }

    if (base == FCVTZS_W_S || base == FCVTZU_W_S) { ret a3(false, 4, true, 4, 2); }
    if (base == FCVTZS_X_S || base == FCVTZU_X_S) { ret a3(false, 8, true, 4, 2); }
    if (base == FCVTZS_W_D || base == FCVTZU_W_D) { ret a3(false, 4, true, 8, 2); }
    if (base == FCVTZS_X_D || base == FCVTZU_X_D) { ret a3(false, 8, true, 8, 2); }

    if (base == FMOV_S_FROM_W) { ret a3(true,  4, false, 4, 2); }
    if (base == FMOV_D_FROM_X) { ret a3(true,  8, false, 8, 2); }
    if (base == FMOV_W_FROM_S) { ret a3(false, 4, true,  4, 2); }
    if (base == FMOV_X_FROM_D) { ret a3(false, 8, true,  8, 2); }
    ret a3(false, 0, false, 0, 255);
}

fun shaped_reg(fp: bool, n: u32, bytes: u8) isa.Operand {
    if (fp) { ret printer.vec(n, bytes); }
    ret printer.gp(n, bytes);
}

fun noting(st: *encode.EncodeState) bool {
    ret encode.sink_active(?st.buf);
}

fun emit_alu3(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, rm: u32) {
    emit_word(st, pack_alu3(base, rd, rn, rm));
    note_alu3(st, base, rd, rn, rm, 0, false);
}

fun emit_alu3_sh(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, rm: u32, sh: u32) {
    emit_word(st, pack_alu3_sh(base, rd, rn, rm, sh));
    note_alu3(st, base, rd, rn, rm, sh, sh != 0);
}

fun note_alu3(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, rm: u32, sh: u32, shifted: bool) {
    if (!noting(st)) { ret; }
    val s: Alu3Shape = alu3_shape(base);
    if (s.arity == 255) {
        encode.sink_fail(?st.buf, "--emit-asm: no aarch64 operand shape for an emitted three-register base word");
        ret;
    }
    var i: printer.Inst = printer.inst(printer.FORM_ALU3, base);
    if (s.arity != 0) { i.dst = shaped_reg(s.dst_fp, rd, s.dst_w); }
    i.src1 = shaped_reg(s.src_fp, rn, s.src_w);
    if (s.arity != 2) { i.src2 = shaped_reg(s.src_fp, rm, s.src_w); }
    if (shifted)      { i.src3 = isa.make_imm(sh::i64, 1); }
    printer.note_inst(?st.buf, ?i);
}

fun emit_addsub_imm(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, imm12: u32, sh: u32) {
    emit_word(st, pack_addsub_imm(base, rd, rn, imm12, sh));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if ((base & 0x80000000) != 0) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_ADDSUB_IMM, base);
    i.dst  = printer.gp(rd, w);
    i.src1 = printer.gp(rn, w);
    i.src2 = isa.make_imm(imm12::i64, w);
    if (sh != 0) { i.src3 = isa.make_imm(12, 1); }
    printer.note_inst(?st.buf, ?i);
}

fun emit_addsub_imm_sym(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, sym: intern.StrId, mod: u8, addend: i32) {
    emit_word(st, pack_addsub_imm(base, rd, rn, 0, 0));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if ((base & 0x80000000) != 0) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_ADDSUB_IMM, base);
    i.dst     = printer.gp(rd, w);
    i.src1    = printer.gp(rn, w);
    i.src2    = isa.make_sym(sym::u32, w);
    i.src2.sym_addend = addend;
    i.sym_mod = mod;
    printer.note_inst(?st.buf, ?i);
}

fun emit_bitfield(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, immr: u32, imms: u32) {
    emit_word(st, pack_bitfield(base, rd, rn, immr, imms));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if (base == UBFM_X || base == SBFM_X) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_BITFIELD, base);
    i.dst  = printer.gp(rd, w);
    i.src1 = printer.gp(rn, w);
    i.src2 = isa.make_imm(immr::i64, 1);
    i.src3 = isa.make_imm(imms::i64, 1);
    printer.note_inst(?st.buf, ?i);
}

fun emit_movewide(st: *encode.EncodeState, base: u32, rd: u32, hw: u32, imm16: u32) {
    emit_word(st, pack_movewide(base, rd, hw, imm16));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if (base == MOVZ_X || base == MOVK_X) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_MOVEWIDE, base);
    i.dst  = printer.gp(rd, w);
    i.src2 = isa.make_imm(imm16::i64, w);
    if (hw != 0) { i.src3 = isa.make_imm((hw * 16)::i64, 1); }
    printer.note_inst(?st.buf, ?i);
}

fun emit_madd(st: *encode.EncodeState, base: u32, rd: u32, rn: u32, rm: u32, ra: u32) {
    emit_word(st, pack_madd(base, rd, rn, rm, ra));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if (base == MSUB_X) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_MADD, base);
    i.dst  = printer.gp(rd, w);
    i.src1 = printer.gp(rn, w);
    i.src2 = printer.gp(rm, w);
    i.src3 = printer.gp(ra, w);
    printer.note_inst(?st.buf, ?i);
}

fun emit_cset(st: *encode.EncodeState, base: u32, rd: u32, cc: u32) {
    emit_word(st, pack_cset(base, rd, cc));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if (base == CSINC_X) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_CSET, base);
    i.dst   = printer.gp(rd, w);
    i.flags = ((cc ^ 1) & 0xF)::u16;
    printer.note_inst(?st.buf, ?i);
}

rec LdStShape {
    fp:    bool;
    w:     u8;
    scale: u32;
}

fun ls(fp: bool, w: u8, scale: u32) LdStShape {
    var s: LdStShape;
    s.fp    = fp;
    s.w     = w;
    s.scale = scale;
    ret s;
}

fun ldst_shape(base: u32) LdStShape {
    if (base == LDRB_OFF || base == STRB_OFF) { ret ls(false, 4, 1); }
    if (base == LDRH_OFF || base == STRH_OFF) { ret ls(false, 4, 2); }
    if (base == LDRW_OFF || base == STRW_OFF) { ret ls(false, 4, 4); }
    if (base == LDR_OFF_X || base == STR_OFF_X) { ret ls(false, 8, 8); }
    if (base == LDR_D_OFF || base == STR_D_OFF) { ret ls(true, 8, 8); }
    if (base == LDR_S_OFF || base == STR_S_OFF) { ret ls(true, 4, 4); }
    if (base == LDR_H_OFF || base == STR_H_OFF) { ret ls(true, 2, 2); }
    if (base == LDR_B_OFF || base == STR_B_OFF) { ret ls(true, 1, 1); }
    if (base == LDR_Q_OFF || base == STR_Q_OFF) { ret ls(true, 16, 16); }
    if (base == LDAR_X || base == STLR_X || base == LDAXR_X) { ret ls(false, 8, 0); }
    if (base == LDAR_W || base == STLR_W || base == LDAXR_W) { ret ls(false, 4, 0); }
    ret ls(false, 0, 255);
}

fun ldur_shape(base: u32) LdStShape {
    if (base == LDURB || base == STURB || base == LDURH || base == STURH ||
        base == LDURW || base == STURW) { ret ls(false, 4, 1); }
    if (base == LDUR_X || base == STUR_X)       { ret ls(false, 8, 1); }
    if (base == LDUR_D_FP || base == STUR_D_FP) { ret ls(true, 8, 1); }
    if (base == LDUR_S_FP || base == STUR_S_FP) { ret ls(true, 4, 1); }
    if (base == LDUR_H_FP || base == STUR_H_FP) { ret ls(true, 2, 1); }
    if (base == LDUR_B_FP || base == STUR_B_FP) { ret ls(true, 1, 1); }
    if (base == LDUR_Q_FP || base == STUR_Q_FP) { ret ls(true, 16, 1); }
    ret ls(false, 0, 255);
}

fun ldst_reg_shape(base: u32) LdStShape {
    if (base == LDRB_REG || base == STRB_REG || base == LDRH_REG || base == STRH_REG ||
        base == LDRW_REG || base == STRW_REG)     { ret ls(false, 4, 1); }
    if (base == LDR_REG_X || base == STR_REG_X)   { ret ls(false, 8, 1); }
    if (base == LDR_D_REG || base == STR_D_REG)   { ret ls(true, 8, 1); }
    if (base == LDR_S_REG || base == STR_S_REG)   { ret ls(true, 4, 1); }
    if (base == LDR_H_REG || base == STR_H_REG)   { ret ls(true, 2, 1); }
    if (base == LDR_B_REG || base == STR_B_REG)   { ret ls(true, 1, 1); }
    if (base == LDR_Q_REG || base == STR_Q_REG)   { ret ls(true, 16, 1); }
    ret ls(false, 0, 255);
}

fun ldst_loads(base: u32) bool {
    ret base == LDRB_OFF || base == LDRH_OFF || base == LDRW_OFF || base == LDR_OFF_X ||
        base == LDR_D_OFF || base == LDR_S_OFF || base == LDR_Q_OFF ||
        base == LDR_B_OFF || base == LDR_H_OFF ||
        base == LDUR_B_FP || base == LDUR_H_FP ||
        base == LDR_B_REG || base == LDR_H_REG ||
        base == LDAR_X || base == LDAR_W || base == LDAXR_X || base == LDAXR_W ||
        base == LDURB || base == LDURH || base == LDURW || base == LDUR_X ||
        base == LDUR_D_FP || base == LDUR_S_FP || base == LDUR_Q_FP ||
        base == LDRB_REG || base == LDRH_REG || base == LDRW_REG || base == LDR_REG_X ||
        base == LDR_D_REG || base == LDR_S_REG || base == LDR_Q_REG;
}

fun note_ldst(st: *encode.EncodeState, base: u32, s: *LdStShape, rt: u32, mem: isa.Operand) {
    if (s.scale == 255) {
        encode.sink_fail(?st.buf, "--emit-asm: no aarch64 operand shape for an emitted load/store base word");
        ret;
    }
    var i: printer.Inst = printer.inst(printer.FORM_LDST, base);
    val reg: isa.Operand = shaped_reg(s.fp, rt, s.w);
    if (ldst_loads(base)) { i.dst = reg; i.src1 = mem; }
    or                    { i.dst = mem; i.src1 = reg; }
    printer.note_inst(?st.buf, ?i);
}

fun emit_ldst(st: *encode.EncodeState, base: u32, rt: u32, rn: u32, imm12: u32) {
    emit_word(st, pack_ldst(base, rt, rn, imm12));
    if (!noting(st)) { ret; }
    val s: LdStShape = ldst_shape(base);
    var disp: i32 = 0;
    if (s.scale != 0 && s.scale != 255) { disp = (imm12 * s.scale)::i32; }
    note_ldst(st, base, ?s, rt, isa.make_mem(printer.gp_id(rn), disp, -1, 0, s.w));
}

fun emit_ldst_sym(st: *encode.EncodeState, base: u32, rt: u32, rn: u32, sym: intern.StrId, mod: u8, addend: i32) {
    emit_word(st, pack_ldst(base, rt, rn, 0));
    if (!noting(st)) { ret; }
    val s: LdStShape = ldst_shape(base);
    if (s.scale == 255) {
        encode.sink_fail(?st.buf, "--emit-asm: no aarch64 operand shape for an emitted load/store base word");
        ret;
    }
    var mem: isa.Operand = isa.make_mem(printer.gp_id(rn), 0, -1, 0, s.w);
    mem.sym_id     = sym::u32;
    mem.sym_addend = addend;
    var i: printer.Inst = printer.inst(printer.FORM_LDST, base);
    i.sym_mod = mod;
    val reg: isa.Operand = shaped_reg(s.fp, rt, s.w);
    if (ldst_loads(base)) { i.dst = reg; i.src1 = mem; }
    or                    { i.dst = mem; i.src1 = reg; }
    printer.note_inst(?st.buf, ?i);
}

fun emit_ldur(st: *encode.EncodeState, base: u32, rt: u32, rn: u32, imm9: u32) {
    emit_word(st, pack_ldur(base, rt, rn, imm9));
    if (!noting(st)) { ret; }
    val s: LdStShape = ldur_shape(base);
    note_ldst(st, base, ?s, rt, isa.make_mem(printer.gp_id(rn), sign_extend_field(imm9, 9)::i32, -1, 0, s.w));
}

fun emit_ldst_reg(st: *encode.EncodeState, base: u32, rt: u32, rn: u32, rm: u32) {
    emit_word(st, pack_ldst_reg(base, rt, rn, rm));
    if (!noting(st)) { ret; }
    val s: LdStShape = ldst_reg_shape(base);
    note_ldst(st, base, ?s, rt, isa.make_mem(printer.gp_id(rn), 0, printer.gp_id(rm), 1, s.w));
}

fun emit_ldstp(st: *encode.EncodeState, base: u32, rt: u32, rt2: u32, rn: u32, imm7: u32) {
    emit_word(st, pack_ldstp(base, rt, rt2, rn, imm7));
    if (!noting(st)) { ret; }
    val fp: bool = base == STP_OFF_D || base == LDP_OFF_D;
    val load: bool = base == LDP_OFF_X || base == LDP_PRE_X || base == LDP_POST_X || base == LDP_OFF_D;
    var i: printer.Inst = printer.inst(printer.FORM_LDSTP, base);
    if (base == STP_PRE_X || base == LDP_PRE_X)   { i.flags = printer.FLAG_WB_PRE; }
    if (base == STP_POST_X || base == LDP_POST_X) { i.flags = printer.FLAG_WB_POST; }

    val mem: isa.Operand = isa.make_mem(printer.gp_id(rn), (sign_extend_field(imm7, 7) * 8)::i32, -1, 0, 8);
    val ra: isa.Operand = shaped_reg(fp, rt, 8);
    val rb: isa.Operand = shaped_reg(fp, rt2, 8);
    if (load) { i.dst = ra; i.src1 = rb; i.src2 = mem; }
    or        { i.dst = mem; i.src1 = ra; i.src2 = rb; }
    printer.note_inst(?st.buf, ?i);
}

fun emit_neon_3same(st: *encode.EncodeState, base: u32, size: u32, rd: u32, rn: u32, rm: u32, lane: u32) {
    emit_word(st, pack_neon_3same(base, size, rd, rn, rm));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_NEON_3SAME, base);
    i.dst      = printer.vec(rd, 16);
    i.src1     = printer.vec(rn, 16);
    i.src2     = printer.vec(rm, 16);
    i.vec_lane = lane;
    printer.note_inst(?st.buf, ?i);
}

fun emit_neon_2misc(st: *encode.EncodeState, base: u32, rd: u32, rn: u32) {
    emit_word(st, pack_neon_2misc(base, rd, rn));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_NEON_2MISC, base);
    i.dst  = printer.vec(rd, 16);
    i.src1 = printer.vec(rn, 16);
    printer.note_inst(?st.buf, ?i);
}

fun emit_neon_umov(st: *encode.EncodeState, base: u32, size: u32, index: u32, rd: u32, rn: u32, lane: u32) {
    emit_word(st, pack_neon_lane_read(base, size, index, rd, rn));
    if (!noting(st)) { ret; }
    var dst_bytes: u8 = 4;
    if (base == VUMOV_X) { dst_bytes = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_NEON_LANE_RD, base);
    i.dst      = printer.gp(rd, dst_bytes);
    i.src1     = printer.vec(rn, 16);
    i.src2     = isa.make_imm(index::i64, 1);
    i.vec_lane = lane;
    printer.note_inst(?st.buf, ?i);
}

fun emit_neon_dup_el(st: *encode.EncodeState, size: u32, index: u32, rd: u32, rn: u32, lane: u32) {
    emit_word(st, pack_neon_dup_el(size, index, rd, rn));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_NEON_LANE_RD, VDUP_EL);
    i.dst      = printer.vec(rd, mir.vec_lane_elem_bytes(lane));
    i.src1     = printer.vec(rn, 16);
    i.src2     = isa.make_imm(index::i64, 1);
    i.vec_lane = lane;
    printer.note_inst(?st.buf, ?i);
}

fun emit_neon_ins_gp(st: *encode.EncodeState, size: u32, index: u32, rd: u32, rn: u32, lane: u32, src_bytes: u8) {
    emit_word(st, pack_neon_ins_gp(size, index, rd, rn));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_NEON_LANE_WR, VINS_GP);
    i.dst      = printer.vec(rd, 16);
    i.src1     = printer.gp(rn, src_bytes);
    i.src2     = isa.make_imm(index::i64, 1);
    i.vec_lane = lane;
    printer.note_inst(?st.buf, ?i);
}

fun emit_neon_ins_el(st: *encode.EncodeState, size: u32, index: u32, src_index: u32, rd: u32, rn: u32, lane: u32) {
    emit_word(st, pack_neon_ins_el(size, index, src_index, rd, rn));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_NEON_LANE_WR, VINS_EL);
    i.dst      = printer.vec(rd, 16);
    i.src1     = printer.vec(rn, 16);
    i.src2     = isa.make_imm(index::i64, 1);
    i.src3     = isa.make_imm(src_index::i64, 1);
    i.vec_lane = lane;
    printer.note_inst(?st.buf, ?i);
}

fun branch_reg_operand(base: u32, rt: u32, has_rt: bool) isa.Operand {
    if (!has_rt) { ret printer.none_operand(); }
    if (base == CBNZ_X || base == CBZ_X) { ret printer.gp(rt, 8); }
    ret printer.gp(rt, 4);
}

fun emit_branch_block(st: *encode.EncodeState, base: u32, rt: u32, has_rt: bool, block: u32) {
    var word: u32 = base;
    if (has_rt) { word = base | (rt & 0x1F); }
    emit_word(st, word);
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_BRANCH, base);
    i.src1   = branch_reg_operand(base, rt, has_rt);
    i.target = printer.TGT_BLOCK;
    i.block  = block;
    printer.note_inst(?st.buf, ?i);
}

fun emit_branch_sym(st: *encode.EncodeState, base: u32, sym: intern.StrId, addend: i32) {
    emit_word(st, base);
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_BRANCH, base);
    i.src2   = isa.make_sym(sym::u32, 0);
    i.src2.sym_addend = addend;
    i.target = printer.TGT_SYM;
    printer.note_inst(?st.buf, ?i);
}

fun emit_branch_pcrel(st: *encode.EncodeState, base: u32, rt: u32, has_rt: bool, imm19: u32) {
    var word: u32 = base | ((imm19 & 0x7FFFF) << 5);
    if (has_rt) { word = word | (rt & 0x1F); }
    emit_word(st, word);
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_BRANCH, base);
    i.src1   = branch_reg_operand(base, rt, has_rt);
    i.src2   = isa.make_imm(imm19::i64, 4);
    i.target = printer.TGT_PCREL;
    printer.note_inst(?st.buf, ?i);
}

fun emit_branch_local(st: *encode.EncodeState, word: u32, base: u32, rt: u32, has_rt: bool, number: u64, fwd: bool) {
    emit_word(st, word);
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_BRANCH, base);
    i.src1   = branch_reg_operand(base, rt, has_rt);
    i.src2   = isa.make_imm(number::i64, 8);
    i.target = printer.TGT_LOCAL_BACK;
    if (fwd) { i.target = printer.TGT_LOCAL_FWD; }
    printer.note_inst(?st.buf, ?i);
}

fun emit_branch_reg(st: *encode.EncodeState, base: u32, rn: u32) {
    emit_word(st, base | ((rn & 0x1F) << 5));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_BRANCH_REG, base);
    i.src1 = printer.gp(rn, 8);
    printer.note_inst(?st.buf, ?i);
}

fun emit_adrp(st: *encode.EncodeState, rd: u32, sym: intern.StrId, mod: u8, addend: i32) {
    emit_word(st, pack_adrp(rd));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_ADRP, ADRP_BASE);
    i.dst     = printer.gp(rd, 8);
    i.src1    = isa.make_sym(sym::u32, 0);
    i.src1.sym_addend = addend;
    i.sym_mod = mod;
    printer.note_inst(?st.buf, ?i);
}

fun emit_nullary(st: *encode.EncodeState, word: u32) {
    emit_word(st, word);
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_NULLARY, word);
    printer.note_inst(?st.buf, ?i);
}

fun emit_imm16(st: *encode.EncodeState, base: u32, imm16: u32) {
    emit_word(st, base | ((imm16 & 0xFFFF) << 5));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_IMM16, base);
    i.src1 = isa.make_imm(imm16::i64, 2);
    printer.note_inst(?st.buf, ?i);
}

fun emit_barrier(st: *encode.EncodeState, crm: u32) {
    emit_word(st, DMB_BASE | ((crm & 0xF) << 8));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_BARRIER, DMB_BASE);
    i.src1 = isa.make_imm(crm::i64, 1);
    printer.note_inst(?st.buf, ?i);
}

fun emit_msr_imm(st: *encode.EncodeState, op1: u32, op2: u32, imm: u32) {
    emit_word(st, MSR_IMM_BASE | ((op1 & 0x7) << 16) | ((imm & 0xF) << 8) | ((op2 & 0x7) << 5));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_SYSREG_IMM, MSR_IMM_BASE);
    i.src1 = isa.make_imm((((op1 & 0x7) << 3) | (op2 & 0x7))::i64, 1);
    i.src2 = isa.make_imm(imm::i64, 1);
    printer.note_inst(?st.buf, ?i);
}

fun a64_sysreg_pack(op0: u32, op1: u32, crn: u32, crm: u32, op2: u32) u32 {
    ret ((op0 & 0x3) << 16) | ((op1 & 0x7) << 12) | ((crn & 0xF) << 8) | ((crm & 0xF) << 4) | (op2 & 0x7);
}

fun a64_emit_sysreg(st: *encode.EncodeState, base: u32, packed: u32, rt: u32) {
    val op0: u32 = (packed >> 16) & 0x3;
    val op1: u32 = (packed >> 12) & 0x7;
    val crn: u32 = (packed >> 8) & 0xF;
    val crm: u32 = (packed >> 4) & 0xF;
    val op2: u32 = packed & 0x7;
    emit_word(st, base | ((op0 & 0x1) << 19) | (op1 << 16)
                       | (crn << 12) | (crm << 8) | (op2 << 5) | (rt & 0x1F));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_SYSREG, base);
    i.dst  = printer.gp(rt, 8);
    i.src1 = isa.make_imm(packed::i64, 4);
    printer.note_inst(?st.buf, ?i);
}

fun emit_stxr(st: *encode.EncodeState, base: u32, rs: u32, rt: u32, rn: u32) {
    emit_word(st, pack_ldst(base, rt, rn, 0) | ((rs & 0x1F) << 16));
    if (!noting(st)) { ret; }
    var w: u8 = 4;
    if (base == STLXR_X) { w = 8; }
    var i: printer.Inst = printer.inst(printer.FORM_STXR, base);
    i.dst  = printer.gp(rs, 4);
    i.src1 = printer.gp(rt, w);
    i.src2 = isa.make_mem(printer.gp_id(rn), 0, -1, 0, w);
    printer.note_inst(?st.buf, ?i);
}

fun sign_extend_field(v: u32, bits: u32) i64 {
    val mask: u32 = (1::u32 << bits) - 1;
    val x: u32 = v & mask;
    if ((x & (1::u32 << (bits - 1))) != 0) { ret (x::i64) - ((mask::i64) + 1); }
    ret x::i64;
}

fun read_word(buf: *encode.ByteBuf, pos: usize) u32 {
    ret buf.data[pos]::u32 |
        (buf.data[pos + 1]::u32 << 8) |
        (buf.data[pos + 2]::u32 << 16) |
        (buf.data[pos + 3]::u32 << 24);
}

fun write_word(buf: *encode.ByteBuf, pos: usize, word: u32) {
    buf.data[pos]     = (word & 0xFF)::u8;
    buf.data[pos + 1] = ((word >> 8) & 0xFF)::u8;
    buf.data[pos + 2] = ((word >> 16) & 0xFF)::u8;
    buf.data[pos + 3] = ((word >> 24) & 0xFF)::u8;
}

fun sel(use64: bool, base_x: u32, base_w: u32) u32 {
    if (use64) { ret base_x; }
    ret base_w;
}

fun is64(width: u8) bool {
    if (width == 0) { ret true; }
    ret width >= 8;
}

fun emit_movewide_seq(st: *encode.EncodeState, rd: u32, value: u64, use64: bool) {
    val base_z: u32 = sel(use64, MOVZ_X, MOVZ_W);
    val base_k: u32 = sel(use64, MOVK_X, MOVK_W);
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var v: u64 = value;
    if (!use64) { v = value & 0xFFFFFFFF; }

    if (v == 0) {
        emit_movewide(st, base_z, rd, 0, 0);
        ret;
    }

    var first: bool = true;
    var i: u32 = 0;
    for (i < chunks) {
        val chunk: u32 = ((v >> (16::u64 * i::u64)) & 0xFFFF)::u32;
        if (chunk != 0) {
            if (first) {
                emit_movewide(st, base_z, rd, i, chunk);
                first = false;
            } or {
                emit_movewide(st, base_k, rd, i, chunk);
            }
        }
        i = i + 1;
    }
}

fun req_gpr(op: *mir.MirOperand) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_PREG) {
        if (isa.regid_class(op.preg::i32) != isa.REG_CLASS_ID_GP) {
            ret R.err[i32, str]("internal compiler error: a float/vector register reached a general-purpose operand position");
        }
        ret R.ok[i32, str](isa.regid_index(op.preg::i32));
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret R.err[i32, str]("encode: virtual register survived register allocation");
    }
    ret R.err[i32, str]("encode: expected a register operand");
}

fun resolve_source(st: *encode.EncodeState, op: *mir.MirOperand, scratch: u32, use64: bool) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_IMM) {
        emit_movewide_seq(st, scratch, op.imm::u64, use64);
        ret R.ok[i32, str](scratch::i32);
    }
    ret req_gpr(op);
}

rec A64Mem {
    base:      u32;
    off:       i64;
    has_index: bool;
    index:     u32;
    scale:     u8;
}

fun frame_slot_offset(f: *mir.MirFunction, v: u32) O.Option[i64] {
    if (codegen_frame.slots_from_sp(?f.frame)) {
        ret codegen_frame.slot_sp_offset(?f.frame, v);
    }
    ret codegen_frame.slot_offset(?f.frame, v);
}

fun slot_base_reg(f: *mir.MirFunction) u32 {
    if (codegen_frame.slots_from_sp(?f.frame)) { ret ZR; }
    ret arm64.FP::u32;
}

fun asm_slot_offset(f: *mir.MirFunction, v: u32) O.Option[i64] {
    ret codegen_frame.slot_sp_offset(?f.frame, v);
}

fun resolve_mem(f: *mir.MirFunction, op: *mir.MirOperand) R.Result[A64Mem, str] {
    if (op.kind != mir.MIR_OP_MEM) {
        ret R.err[A64Mem, str]("encode: expected a memory operand");
    }
    var m: A64Mem;
    m.has_index = false;
    m.index     = 0;
    m.scale     = 0;
    if (op.index != mir.MIR_VREG_NIL) {
        if (!op.index_is_preg) {
            ret R.err[A64Mem, str]("encode: value vreg survived in a memory-operand index");
        }
        m.has_index = true;
        m.index     = op.index;
        m.scale     = op.scale;
    }
    if (op.vreg != mir.MIR_VREG_NIL) {
        val slot: O.Option[i64] = frame_slot_offset(f, op.vreg);
        if (!O.is_some[i64](slot)) {
            ret R.err[A64Mem, str]("encode: value vreg survived in a memory-operand base");
        }
        m.base = slot_base_reg(f);
        m.off  = O.unwrap[i64](slot) + op.imm;
        ret R.ok[A64Mem, str](m);
    }
    m.base = op.preg;
    m.off  = op.imm;
    ret R.ok[A64Mem, str](m);
}

fun mem_access_needs_no_scratch(off: i64, width: u8) R.Result[bool, str] {
    val ar: R.Result[A64Access, str] = int_access(width, true);
    if (R.is_err[A64Access, str](ar)) { ret R.err[bool, str](R.unwrap_err[A64Access, str](ar)); }
    val sh: u32 = R.unwrap_ok[A64Access, str](ar).shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) { ret R.ok[bool, str](true); }
    }
    ret R.ok[bool, str](off >= -256 && off <= 255);
}

fun emit_mem_access(st: *encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) R.Result[R.Void, str] {
    val ar: R.Result[A64Access, str] = int_access(width, is_load);
    if (R.is_err[A64Access, str](ar)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](ar)); }
    val a: A64Access = R.unwrap_ok[A64Access, str](ar);
    val sh: u32 = a.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) {
            emit_ldst(st, a.scaled, rt, base, (off >> sh::i64)::u32);
            ret R.ok_void[str]();
        }
    }
    if (off >= -256 && off <= 255) {
        emit_ldur(st, a.unscaled, rt, base, off::u32 & 0x1FF);
        ret R.ok_void[str]();
    }
    emit_movewide_seq(st, SCRATCH0, off::u64, true);
    emit_ldst_reg(st, a.reg, rt, base, SCRATCH0);
    ret R.ok_void[str]();
}

fun emit_add_imm(st: *encode.EncodeState, rd: u32, rn: u32, off: i64) {
    if (off >= 0 && off <= 4095) {
        emit_addsub_imm(st, ADDI_X, rd, rn, off::u32, 0);
        ret;
    }
    if (off < 0 && off >= -4095) {
        emit_addsub_imm(st, SUBI_X, rd, rn, (-off)::u32, 0);
        ret;
    }
    if (off > 0 && (off & 0xFFF) == 0 && (off >> 12) <= 4095) {
        emit_addsub_imm(st, ADDI_X, rd, rn, (off >> 12)::u32, 1);
        ret;
    }
    if (off < 0 && ((-off) & 0xFFF) == 0 && ((-off) >> 12) <= 4095) {
        emit_addsub_imm(st, SUBI_X, rd, rn, ((-off) >> 12)::u32, 1);
        ret;
    }
    emit_movewide_seq(st, SCRATCH0, off::u64, true);
    if (rn == ZR) {
        emit_addsub_imm(st, ADDI_X, SCRATCH1, ZR, 0, 0);
        emit_alu3(st, ADD_X, rd, SCRATCH1, SCRATCH0);
        ret;
    }
    emit_alu3(st, ADD_X, rd, rn, SCRATCH0);
}

fun scale_shift(scale: u8) R.Result[u32, str] {
    if (scale == 1) { ret R.ok[u32, str](0); }
    if (scale == 2) { ret R.ok[u32, str](1); }
    if (scale == 4) { ret R.ok[u32, str](2); }
    if (scale == 8) { ret R.ok[u32, str](3); }
    ret R.err[u32, str]("encode: a scaled-index address must have a scale of 1, 2, 4, or 8");
}

fun emit_adrp_reloc(st: *encode.EncodeState, rd: u32, sym: intern.StrId, addend: i32) R.Result[R.Void, str] {
    val pos: u32 = st.buf.len::u32;
    emit_adrp(st, rd, sym, printer.MOD_PCREL_HI, addend);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PAGE21, sym, addend);
}

fun emit_global_addr(st: *encode.EncodeState, rd: u32, symop: *mir.MirOperand) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: address-of has no resolved symbol name");
    }
    val ar: R.Result[R.Void, str] = emit_adrp_reloc(st, rd, symop.sym, symop.sym_off);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_addsub_imm_sym(st, ADDI_X, rd, rd, symop.sym, printer.MOD_PCREL_LO, symop.sym_off);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_ADD_LO12, symop.sym, symop.sym_off);
}

fun emit_global_load(st: *encode.EncodeState, rt: u32, symop: *mir.MirOperand, width: u8, is_vec: bool) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: folded-global load has no resolved symbol name");
    }
    var fr: R.Result[A64Access, str] = int_access(width, true);
    if (is_vec) { fr = fp_access(width, true); }
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }
    val a: A64Access = R.unwrap_ok[A64Access, str](fr);
    val ar: R.Result[R.Void, str] = emit_adrp_reloc(st, SCRATCH0, symop.sym, symop.sym_off);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, a.scaled, rt, SCRATCH0, symop.sym, printer.MOD_PCREL_LO, symop.sym_off);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), a.lo12, symop.sym, symop.sym_off);
}

fun emit_global_store(st: *encode.EncodeState, f: *mir.MirFunction, symop: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: folded-global store has no resolved symbol name");
    }
    val vec_val: bool = reg_is_vec(val_op) || is_fp_slot(f, val_op);
    var fr: R.Result[A64Access, str] = int_access(width, false);
    if (vec_val) { fr = fp_access(width, false); }
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }
    val a: A64Access = R.unwrap_ok[A64Access, str](fr);

    var rt: u32 = ZR;
    if (vec_val) {
        if (reg_is_vec(val_op)) {
            val vr: R.Result[i32, str] = req_vec(val_op);
            if (R.is_err[i32, str](vr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](vr)); }
            rt = R.unwrap_ok[i32, str](vr)::u32;
        } or {
            val lr: R.Result[R.Void, str] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH0, width);
            if (R.is_err[R.Void, str](lr)) { ret lr; }
            rt = FP_SCRATCH0;
        }
    } or (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_movewide_seq(st, SCRATCH1, val_op.imm::u64, is64(width));
            rt = SCRATCH1;
        }
    } or {
        val rr: R.Result[i32, str] = req_gpr(val_op);
        if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
        rt = R.unwrap_ok[i32, str](rr)::u32;
    }

    val ar: R.Result[R.Void, str] = emit_adrp_reloc(st, SCRATCH0, symop.sym, symop.sym_off);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, a.scaled, rt, SCRATCH0, symop.sym, printer.MOD_PCREL_LO, symop.sym_off);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), a.lo12, symop.sym, symop.sym_off);
}

fun emit_adrp_got_reloc(st: *encode.EncodeState, rd: u32, sym: intern.StrId) R.Result[R.Void, str] {
    val pos: u32 = st.buf.len::u32;
    emit_adrp(st, rd, sym, printer.MOD_GOT_HI, 0);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_PAGE21, sym, 0);
}

fun emit_global_addr_got(st: *encode.EncodeState, rd: u32, symop: *mir.MirOperand) R.Result[R.Void, str] {
    if (symop.sym == intern.STR_NIL) {
        ret R.err[R.Void, str]("encode: GOT address-of has no resolved symbol name");
    }
    val ar: R.Result[R.Void, str] = emit_adrp_got_reloc(st, rd, symop.sym);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, LDR_OFF_X, rd, rd, symop.sym, printer.MOD_GOT_LO, 0);
    val pr: R.Result[R.Void, str] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_LO12, symop.sym, 0);
    if (R.is_err[R.Void, str](pr)) { ret pr; }
    if (symop.sym_off != 0) { emit_add_imm(st, rd, rd, symop.sym_off::i64); }
    ret R.ok_void[str]();
}

fun emit_global_load_got(st: *encode.EncodeState, rt: u32, symop: *mir.MirOperand, width: u8, is_vec: bool) R.Result[R.Void, str] {
    var fr: R.Result[A64Access, str] = int_access(width, true);
    if (is_vec) { fr = fp_access(width, true); }
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }
    if (is_vec) {
        val vr: R.Result[R.Void, str] = emit_global_addr_got(st, SCRATCH0, symop);
        if (R.is_err[R.Void, str](vr)) { ret vr; }
        ret emit_fp_mem(st, rt, SCRATCH0, 0, width, true);
    }
    val ar: R.Result[R.Void, str] = emit_global_addr_got(st, rt, symop);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    ret emit_mem_access(st, rt, rt, 0, width, true);
}

fun emit_global_store_got(st: *encode.EncodeState, f: *mir.MirFunction, symop: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) R.Result[R.Void, str] {
    val vec_val: bool = reg_is_vec(val_op) || is_fp_slot(f, val_op);
    var fr: R.Result[A64Access, str] = int_access(width, false);
    if (vec_val) { fr = fp_access(width, false); }
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }

    var rt: u32 = ZR;
    if (vec_val) {
        if (reg_is_vec(val_op)) {
            val vr: R.Result[i32, str] = req_vec(val_op);
            if (R.is_err[i32, str](vr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](vr)); }
            rt = R.unwrap_ok[i32, str](vr)::u32;
        } or {
            val lr: R.Result[R.Void, str] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH0, width);
            if (R.is_err[R.Void, str](lr)) { ret lr; }
            rt = FP_SCRATCH0;
        }
        val vr2: R.Result[R.Void, str] = emit_global_addr_got(st, SCRATCH0, symop);
        if (R.is_err[R.Void, str](vr2)) { ret vr2; }
        ret emit_fp_mem(st, rt, SCRATCH0, 0, width, false);
    }
    if (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_movewide_seq(st, SCRATCH1, val_op.imm::u64, is64(width));
            rt = SCRATCH1;
        }
    } or {
        val rr: R.Result[i32, str] = req_gpr(val_op);
        if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
        rt = R.unwrap_ok[i32, str](rr)::u32;
    }

    val ar: R.Result[R.Void, str] = emit_global_addr_got(st, SCRATCH0, symop);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    ret emit_mem_access(st, rt, SCRATCH0, 0, width, false);
}

fun encode_call(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 1) { ret R.err[R.Void, str]("encode: call missing callee operand"); }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind == mir.MIR_OP_SYM) {
        if (callee.sym == intern.STR_NIL) {
            ret R.err[R.Void, str]("encode: direct call has no resolved symbol name");
        }
        val pos: u32 = st.buf.len::u32;
        emit_branch_sym(st, BL_BASE, callee.sym, callee.sym_off);
        ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PLT32, callee.sym, callee.sym_off);
    }
    val rr: R.Result[i32, str] = req_gpr(callee);
    if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
    emit_branch_reg(st, BLR_BASE, R.unwrap_ok[i32, str](rr)::u32);
    ret R.ok_void[str]();
}

fun encode_alu3(st: *encode.EncodeState, mi: *mir.MirInstr, base_x: u32, base_w: u32) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: ALU op missing operands"); }
    val use64: bool = is64(mi.width);

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH1, use64);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_source(st, ?mi.operands[2], SCRATCH0, use64);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    emit_alu3(st, sel(use64, base_x, base_w), rd, rn, rm);
    ret R.ok_void[str]();
}

fun encode_addsub(st: *encode.EncodeState, mi: *mir.MirInstr, is_sub: bool) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: add/sub missing operands"); }
    val use64: bool = is64(mi.width);

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH1, use64);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rhs: *mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == mir.MIR_OP_IMM) {
        val v: i64 = rhs.imm;
        if (v >= 0 && v <= 4095) {
            var base_i: u32 = sel(use64, ADDI_X, ADDI_W);
            if (is_sub) { base_i = sel(use64, SUBI_X, SUBI_W); }
            emit_addsub_imm(st, base_i, rd, rn, v::u32, 0);
            ret R.ok_void[str]();
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            var base_i: u32 = sel(use64, ADDI_X, ADDI_W);
            if (is_sub) { base_i = sel(use64, SUBI_X, SUBI_W); }
            emit_addsub_imm(st, base_i, rd, rn, (v >> 12)::u32, 1);
            ret R.ok_void[str]();
        }
    }

    val rmr: R.Result[i32, str] = resolve_source(st, rhs, SCRATCH0, use64);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;
    var base_r: u32 = sel(use64, ADD_X, ADD_W);
    if (is_sub) { base_r = sel(use64, SUB_X, SUB_W); }
    emit_alu3(st, base_r, rd, rn, rm);
    ret R.ok_void[str]();
}

fun encode_shift(st: *encode.EncodeState, mi: *mir.MirInstr, kind: u32) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: shift missing operands"); }
    val use64: bool = is64(mi.width);

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH1, use64);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val cnt: *mir.MirOperand = ?mi.operands[2];
    if (cnt.kind == mir.MIR_OP_IMM) {
        var width_bits: u32 = 32;
        if (use64) { width_bits = 64; }
        val sh: u32 = cnt.imm::u32 & (width_bits - 1);
        if (kind == arm64.LSL::u32) {
            val immr: u32 = (width_bits - sh) & (width_bits - 1);
            val imms: u32 = (width_bits - 1) - sh;
            emit_bitfield(st, sel(use64, UBFM_X, UBFM_W), rd, rn, immr, imms);
            ret R.ok_void[str]();
        }
        if (kind == arm64.LSR::u32) {
            emit_bitfield(st, sel(use64, UBFM_X, UBFM_W), rd, rn, sh, width_bits - 1);
            ret R.ok_void[str]();
        }
        emit_bitfield(st, sel(use64, SBFM_X, SBFM_W), rd, rn, sh, width_bits - 1);
        ret R.ok_void[str]();
    }

    val rmr: R.Result[i32, str] = req_gpr(cnt);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;
    var base_x: u32 = LSLV_X; var base_w: u32 = LSLV_W;
    if (kind == arm64.LSR::u32) { base_x = LSRV_X; base_w = LSRV_W; }
    or (kind == arm64.ASR::u32) { base_x = ASRV_X; base_w = ASRV_W; }
    emit_alu3(st, sel(use64, base_x, base_w), rd, rn, rm);
    ret R.ok_void[str]();
}

fun encode_neg_mvn(st: *encode.EncodeState, mi: *mir.MirInstr, base_x: u32, base_w: u32) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: neg/not missing operands"); }
    val use64: bool = is64(mi.width);

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rmr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH0, use64);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    emit_alu3(st, sel(use64, base_x, base_w), rd, ZR, rm);
    ret R.ok_void[str]();
}

fun encode_mov(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: mov missing operands"); }
    val use64: bool = is64(mi.width);

    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_MEM) {
        ret emit_store_mem(st, f, dst, src, mi.width);
    }

    val rdr: R.Result[i32, str] = req_gpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    if (src.kind == mir.MIR_OP_MEM) {
        val mr: R.Result[A64Mem, str] = resolve_mem(f, src);
        if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
        val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
        if (m.has_index) { ret R.err[R.Void, str]("encode: indexed spill reload not expected"); }
        ret emit_mem_access(st, rd, m.base, m.off, mi.width, true);
    }

    if (src.kind == mir.MIR_OP_IMM) {
        emit_movewide_seq(st, rd, src.imm::u64, use64);
        ret R.ok_void[str]();
    }
    val rmr: R.Result[i32, str] = req_gpr(src);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;
    emit_alu3(st, sel(use64, ORR_X, ORR_W), rd, ZR, rm);
    ret R.ok_void[str]();
}

fun emit_store_mem(st: *encode.EncodeState, f: *mir.MirFunction, dst_mem: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) R.Result[R.Void, str] {
    if (dst_mem.kind == mir.MIR_OP_SYM) {
        if (dst_mem.sym_got) { ret emit_global_store_got(st, f, dst_mem, val_op, width); }
        ret emit_global_store(st, f, dst_mem, val_op, width);
    }
    val mr: R.Result[A64Mem, str] = resolve_mem(f, dst_mem);
    if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
    val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed store not expected"); }

    if (reg_is_vec(val_op)) {
        val rvr: R.Result[i32, str] = req_vec(val_op);
        if (R.is_err[i32, str](rvr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rvr)); }
        ret emit_fp_mem(st, R.unwrap_ok[i32, str](rvr)::u32, m.base, m.off, width, false);
    }

    if (is_fp_slot(f, val_op)) {
        val ldr: R.Result[R.Void, str] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH0, width);
        if (R.is_err[R.Void, str](ldr)) { ret ldr; }
        ret emit_fp_mem(st, FP_SCRATCH0, m.base, m.off, width, false);
    }

    var rt: u32 = ZR;
    if (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_movewide_seq(st, SCRATCH1, val_op.imm::u64, is64(width));
            rt = SCRATCH1;
        }
    } or {
        val rr: R.Result[i32, str] = req_gpr(val_op);
        if (R.is_err[i32, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rr)); }
        rt = R.unwrap_ok[i32, str](rr)::u32;
    }
    ret emit_mem_access(st, rt, m.base, m.off, width, false);
}

fun encode_load(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: load missing operands"); }
    val dstop: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (is_fp_slot(f, dstop)) {
        val ldr: R.Result[R.Void, str] = emit_fp_slot_load(st, f, src, FP_SCRATCH0, mi.src_width);
        if (R.is_err[R.Void, str](ldr)) { ret ldr; }
        ret emit_fp_slot_store(st, f, dstop, FP_SCRATCH0, mi.src_width);
    }

    if (reg_is_vec(dstop)) {
        val rvr: R.Result[i32, str] = req_vec(dstop);
        if (R.is_err[i32, str](rvr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rvr)); }
        if (src.kind == mir.MIR_OP_SYM) {
            if (src.sym_got) {
                ret emit_global_load_got(st, R.unwrap_ok[i32, str](rvr)::u32, src, mi.src_width, true);
            }
            ret emit_global_load(st, R.unwrap_ok[i32, str](rvr)::u32, src, mi.src_width, true);
        }
        val fmr: R.Result[A64Mem, str] = resolve_mem(f, src);
        if (R.is_err[A64Mem, str](fmr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](fmr)); }
        val fm: A64Mem = R.unwrap_ok[A64Mem, str](fmr);
        if (fm.has_index) { ret R.err[R.Void, str]("encode: indexed float load not expected"); }
        ret emit_fp_mem(st, R.unwrap_ok[i32, str](rvr)::u32, fm.base, fm.off, mi.src_width, true);
    }

    val rdr: R.Result[i32, str] = req_gpr(dstop);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    if (src.kind == mir.MIR_OP_SYM) {
        if (src.sym_got) { ret emit_global_load_got(st, rd, src, mi.src_width, false); }
        ret emit_global_load(st, rd, src, mi.src_width, false);
    }
    val mr: R.Result[A64Mem, str] = resolve_mem(f, src);
    if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
    val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed load not expected"); }
    ret emit_mem_access(st, rd, m.base, m.off, mi.src_width, true);
}

fun encode_store(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: store missing operands"); }
    ret emit_store_mem(st, f, ?mi.operands[0], ?mi.operands[1], mi.width);
}

fun encode_addr(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: address op missing operands"); }
    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val memop: *mir.MirOperand = ?mi.operands[1];
    if (memop.kind == mir.MIR_OP_SYM) {
        if (memop.sym_got) { ret emit_global_addr_got(st, rd, memop); }
        ret emit_global_addr(st, rd, memop);
    }
    val mr: R.Result[A64Mem, str] = resolve_mem(f, memop);
    if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
    val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);

    if (!m.has_index) {
        emit_add_imm(st, rd, m.base, m.off);
        ret R.ok_void[str]();
    }
    val shr: R.Result[u32, str] = scale_shift(m.scale);
    if (R.is_err[u32, str](shr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](shr)); }
    val sh: u32 = R.unwrap_ok[u32, str](shr);
    var ibase: u32 = m.base;
    if (ibase == ZR) {
        emit_addsub_imm(st, ADDI_X, SCRATCH0, ZR, 0, 0);
        ibase = SCRATCH0;
    }
    if (m.off == 0) {
        emit_alu3_sh(st, ADD_X, rd, ibase, m.index, sh);
        ret R.ok_void[str]();
    }
    emit_add_imm(st, rd, ibase, m.off);
    emit_alu3_sh(st, ADD_X, rd, rd, m.index, sh);
    ret R.ok_void[str]();
}

fun encode_convert(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: conversion missing operands"); }
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    val rsr: R.Result[i32, str] = resolve_source(st, ?mi.operands[1], SCRATCH0, is64(sw));
    if (R.is_err[i32, str](rsr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rsr)); }
    val rs: u32 = R.unwrap_ok[i32, str](rsr)::u32;

    if (mi.opcode == mir.MIR_TRUNC) {
        emit_alu3(st, ORR_W, rd, ZR, rs);
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_BITCAST) {
        emit_alu3(st, sel(is64(dw), ORR_X, ORR_W), rd, ZR, rs);
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_SEXT) {
        if (sw >= 8) {
            emit_alu3(st, ORR_X, rd, ZR, rs);
            ret R.ok_void[str]();
        }
        val imms: u32 = (sw::u32 * 8) - 1;
        emit_bitfield(st, sel(is64(dw), SBFM_X, SBFM_W), rd, rs, 0, imms);
        ret R.ok_void[str]();
    }
    if (sw >= 4) {
        emit_alu3(st, ORR_W, rd, ZR, rs);
        ret R.ok_void[str]();
    }
    val imms: u32 = (sw::u32 * 8) - 1;
    emit_bitfield(st, UBFM_W, rd, rs, 0, imms);
    ret R.ok_void[str]();
}

fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

fun reg_is_vec(op: *mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_PREG && isa.regid_class(op.preg::i32) == isa.REG_CLASS_ID_XMM;
}

fun req_vec(op: *mir.MirOperand) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_PREG) {
        if (isa.regid_class(op.preg::i32) != isa.REG_CLASS_ID_XMM) {
            ret R.err[i32, str]("internal compiler error: a general-purpose register reached a float/vector operand position");
        }
        ret R.ok[i32, str](isa.regid_index(op.preg::i32));
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret R.err[i32, str]("encode: virtual register survived register allocation");
    }
    ret R.err[i32, str]("encode: expected a float register operand");
}

fun emit_fp_mem(st: *encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) R.Result[R.Void, str] {
    val fr: R.Result[A64Access, str] = fp_access(width, is_load);
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }
    val a: A64Access = R.unwrap_ok[A64Access, str](fr);
    val sh: u32 = a.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) {
            emit_ldst(st, a.scaled, rt, base, (off >> sh::i64)::u32);
            ret R.ok_void[str]();
        }
    }
    if (off >= -256 && off <= 255) {
        emit_ldur(st, a.unscaled, rt, base, off::u32 & 0x1FF);
        ret R.ok_void[str]();
    }
    emit_movewide_seq(st, SCRATCH0, off::u64, true);
    emit_ldst_reg(st, a.reg, rt, base, SCRATCH0);
    ret R.ok_void[str]();
}

fun emit_fp_slot_store(st: *encode.EncodeState, f: *mir.MirFunction, memop: *mir.MirOperand, rt: u32, width: u8) R.Result[R.Void, str] {
    val mr: R.Result[A64Mem, str] = resolve_mem(f, memop);
    if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
    val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill destination not expected"); }
    ret emit_fp_mem(st, rt, m.base, m.off, width, false);
}

fun emit_fp_slot_load(st: *encode.EncodeState, f: *mir.MirFunction, memop: *mir.MirOperand, rt: u32, width: u8) R.Result[R.Void, str] {
    val mr: R.Result[A64Mem, str] = resolve_mem(f, memop);
    if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
    val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill source not expected"); }
    ret emit_fp_mem(st, rt, m.base, m.off, width, true);
}

fun is_fp_slot(f: *mir.MirFunction, op: *mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_MEM && op.vreg != mir.MIR_VREG_NIL && mir.vreg_is_fp(f, op.vreg);
}

fun fmov_imm8(bits: u64, use64: bool) O.Option[u32] {
    var sign: u32 = 0;
    var exp:  u32 = 0;
    var frac: u32 = 0;
    var reps: u32 = 0;
    if (use64) {
        if ((bits & 0xFFFFFFFFFFFF) != 0) { ret O.none[u32](); }
        sign = ((bits >> 63) & 0x1)::u32;
        exp  = ((bits >> 52) & 0x7FF)::u32;
        frac = ((bits >> 48) & 0xF)::u32;
        reps = 8;
    } or {
        val b32: u32 = (bits & 0xFFFFFFFF)::u32;
        if ((b32 & 0x7FFFF) != 0) { ret O.none[u32](); }
        sign = (b32 >> 31) & 0x1;
        exp  = (b32 >> 23) & 0xFF;
        frac = (b32 >> 19) & 0xF;
        reps = 5;
    }
    val top: u32 = (exp >> (reps + 2)) & 0x1;
    val b:   u32 = (exp >> (reps + 1)) & 0x1;
    if (top == b) { ret O.none[u32](); }
    var i: u32 = 0;
    for (i < reps) {
        if (((exp >> (2 + i)) & 0x1) != b) { ret O.none[u32](); }
        i = i + 1;
    }
    ret O.some[u32]((sign << 7) | (b << 6) | ((exp & 0x3) << 4) | frac);
}

fun pack_fmov_imm(base: u32, rd: u32, imm8: u32) u32 {
    ret base | ((imm8 & 0xFF) << 13) | (rd & 0x1F);
}

fun emit_fmov_imm(st: *encode.EncodeState, rd: u32, imm8: u32, use64: bool) {
    var base: u32 = FMOV_S_IMM;
    var w: u8 = 4;
    if (use64) { base = FMOV_D_IMM; w = 8; }
    emit_word(st, pack_fmov_imm(base, rd, imm8));
    if (!noting(st)) { ret; }
    var i: printer.Inst = printer.inst(printer.FORM_FMOV_IMM, base);
    i.dst  = printer.vec(rd, w);
    i.src2 = isa.make_imm(imm8::i64, 1);
    printer.note_inst(?st.buf, ?i);
}

fun movewide_words(bits: u64, use64: bool) u32 {
    var v: u64 = bits;
    if (!use64) { v = bits & 0xFFFFFFFF; }
    if (v == 0) { ret 1; }
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < chunks) {
        if (((v >> (16::u64 * i::u64)) & 0xFFFF) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun emit_fp_const(st: *encode.EncodeState, vd: u32, bits: u64, width: u8) R.Result[R.Void, str] {
    if (!is_float_width(width)) {
        ret R.err[R.Void, str]("internal compiler error: float constant has a non-float width (expected 4 or 8)");
    }
    val use64: bool = width == 8;
    var pattern: u64 = bits;
    if (!use64) { pattern = bits & 0xFFFFFFFF; }

    var fmov_base: u32 = FMOV_S_FROM_W;
    if (use64) { fmov_base = FMOV_D_FROM_X; }

    if (pattern == 0) {
        emit_alu3(st, fmov_base, vd, ZR, 0);
        ret R.ok_void[str]();
    }
    val i8: O.Option[u32] = fmov_imm8(pattern, use64);
    if (O.is_some[u32](i8)) {
        emit_fmov_imm(st, vd, O.unwrap[u32](i8), use64);
        ret R.ok_void[str]();
    }
    if (movewide_words(pattern, use64) <= 1) {
        emit_movewide_seq(st, SCRATCH0, pattern, use64);
        emit_alu3(st, fmov_base, vd, SCRATCH0, 0);
        ret R.ok_void[str]();
    }

    val sr: R.Result[intern.StrId, str] = encode.intern_float_const(st, pattern, width);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sym: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);

    val fr: R.Result[A64Access, str] = fp_access(width, true);
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }
    val a: A64Access = R.unwrap_ok[A64Access, str](fr);
    val ar: R.Result[R.Void, str] = emit_adrp_reloc(st, SCRATCH0, sym, 0);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, a.scaled, vd, SCRATCH0, sym, printer.MOD_PCREL_LO, 0);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), a.lo12, sym, 0);
}

fun resolve_fp_source(st: *encode.EncodeState, f: *mir.MirFunction, op: *mir.MirOperand, scratch: u32, width: u8) R.Result[i32, str] {
    if (op.kind == mir.MIR_OP_MEM) {
        val mr: R.Result[A64Mem, str] = resolve_mem(f, op);
        if (R.is_err[A64Mem, str](mr)) { ret R.err[i32, str](R.unwrap_err[A64Mem, str](mr)); }
        val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
        if (m.has_index) { ret R.err[i32, str]("encode: indexed float spill operand not expected"); }
        val lr: R.Result[R.Void, str] = emit_fp_mem(st, scratch, m.base, m.off, width, true);
        if (R.is_err[R.Void, str](lr)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](lr)); }
        ret R.ok[i32, str](scratch::i32);
    }
    if (op.kind == mir.MIR_OP_IMM) {
        val cr: R.Result[R.Void, str] = emit_fp_const(st, scratch, op.imm::u64, width);
        if (R.is_err[R.Void, str](cr)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](cr)); }
        ret R.ok[i32, str](scratch::i32);
    }
    ret req_vec(op);
}

fun fp_arith_base(op: mir.MirOpcode, dbl: bool) R.Result[u32, str] {
    if (op == mir.MIR_FADD) { if (dbl) { ret R.ok[u32, str](FADD_D); } ret R.ok[u32, str](FADD_S); }
    if (op == mir.MIR_FSUB) { if (dbl) { ret R.ok[u32, str](FSUB_D); } ret R.ok[u32, str](FSUB_S); }
    if (op == mir.MIR_FMUL) { if (dbl) { ret R.ok[u32, str](FMUL_D); } ret R.ok[u32, str](FMUL_S); }
    if (op == mir.MIR_FDIV) { if (dbl) { ret R.ok[u32, str](FDIV_D); } ret R.ok[u32, str](FDIV_S); }
    ret R.err[u32, str]("encode: aarch64 has no float arithmetic form for this opcode");
}

fun fp_cond(cc: u8) R.Result[u32, str] {
    if (cc == mir.FCC_EQ) { ret R.ok[u32, str](CC_EQ); }
    if (cc == mir.FCC_NE) { ret R.ok[u32, str](CC_NE); }
    if (cc == mir.FCC_LT) { ret R.ok[u32, str](CC_MI); }
    if (cc == mir.FCC_LE) { ret R.ok[u32, str](CC_LS); }
    if (cc == mir.FCC_GT) { ret R.ok[u32, str](CC_GT); }
    if (cc == mir.FCC_GE) { ret R.ok[u32, str](CC_GE); }
    ret R.err[u32, str]("encode: aarch64 has no float comparison condition for this condition code");
}

fun is_mir_float_arith(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FADD || op == mir.MIR_FSUB ||
        op == mir.MIR_FMUL || op == mir.MIR_FDIV;
}

fun is_mir_float_conv(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT ||
        op == mir.MIR_FP_TO_SI || op == mir.MIR_FP_TO_UI ||
        op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP;
}

fun encode_fp_arith(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: float arithmetic missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float arithmetic has a non-float operand width (expected 4 or 8)");
    }
    val dbl: bool = w == 8;

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, w);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH1, w);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val baser: R.Result[u32, str] = fp_arith_base(mi.opcode, dbl);
    if (R.is_err[u32, str](baser)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](baser)); }
    val base: u32 = R.unwrap_ok[u32, str](baser);
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind == mir.MIR_OP_MEM) {
        emit_alu3(st, base, FP_SCRATCH0, rn, rm);
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
    }
    val rdr: R.Result[i32, str] = req_vec(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, rn, rm);
    ret R.ok_void[str]();
}

fun neon_size(vl: u32) u32 {
    val eb: u8 = mir.vec_lane_elem_bytes(vl);
    if (mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT) {
        if (eb == 8) { ret 1; }
        ret 0;
    }
    if (eb == 2) { ret 1; }
    if (eb == 4) { ret 2; }
    if (eb == 8) { ret 3; }
    ret 0;
}

fun neon_lane_size(vl: u32) u32 {
    val eb: u8 = mir.vec_lane_elem_bytes(vl);
    if (eb == 2) { ret 1; }
    if (eb == 4) { ret 2; }
    if (eb == 8) { ret 3; }
    ret 0;
}

fun encode_vec_lane_read(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: vector lane read missing operands"); }
    val vl: u32 = mi.vec_lane;
    if (!mir.vec_lane_is_vector(vl)) { ret R.err[R.Void, str]("encode: vector lane read carries no lane descriptor"); }
    val lane_op: *mir.MirOperand = ?mi.operands[2];
    if (lane_op.kind != mir.MIR_OP_IMM) { ret R.err[R.Void, str]("encode: vector lane index is not an immediate"); }
    val index: u32 = lane_op.imm::u32;
    if (index >= mir.vec_lane_count(vl)) { ret R.err[R.Void, str]("encode: vector lane index out of range for lane arrangement"); }
    val size:  u32 = neon_lane_size(vl);

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    val is_float: bool = mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT;

    if (is_float) {
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_neon_dup_el(st, size, index, FP_SCRATCH1, rn, vl);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH1, mi.width);
        }
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        emit_neon_dup_el(st, size, index, R.unwrap_ok[i32, str](rdr)::u32, rn, vl);
        ret R.ok_void[str]();
    }

    var base: u32 = VUMOV_W;
    if (mir.vec_lane_elem_bytes(vl) == 8) { base = VUMOV_X; }

    if (dst.kind == mir.MIR_OP_MEM) {
        emit_neon_umov(st, base, size, index, SCRATCH0, rn, vl);
        val mr: R.Result[A64Mem, str] = resolve_mem(f, dst);
        if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
        val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
        if (m.has_index) { ret R.err[R.Void, str]("encode: indexed lane-read spill not expected"); }
        ret emit_mem_access(st, SCRATCH0, m.base, m.off, mi.width, false);
    }
    val rdr: R.Result[i32, str] = req_gpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    emit_neon_umov(st, base, size, index, R.unwrap_ok[i32, str](rdr)::u32, rn, vl);
    ret R.ok_void[str]();
}

fun encode_vec_lane_write(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 4) { ret R.err[R.Void, str]("encode: vector lane write missing operands"); }
    val vl: u32 = mi.vec_lane;
    if (!mir.vec_lane_is_vector(vl)) { ret R.err[R.Void, str]("encode: vector lane write carries no lane descriptor"); }
    val lane_op: *mir.MirOperand = ?mi.operands[2];
    if (lane_op.kind != mir.MIR_OP_IMM) { ret R.err[R.Void, str]("encode: vector lane index is not an immediate"); }
    val index: u32 = lane_op.imm::u32;
    if (index >= mir.vec_lane_count(vl)) { ret R.err[R.Void, str]("encode: vector lane index out of range for lane arrangement"); }
    val size:  u32 = neon_lane_size(vl);

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    var rd: u32 = FP_SCRATCH1;
    var to_slot: bool = false;
    if (dst.kind == mir.MIR_OP_MEM) {
        to_slot = true;
    }
    or {
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        rd = R.unwrap_ok[i32, str](rdr)::u32;
    }

    if (rd != rn) { emit_neon_3same(st, VORR, 0, rd, rn, rn, mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16)); }

    if (mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT) {
        val rvr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[3], FP_SCRATCH0, mi.src_width);
        if (R.is_err[i32, str](rvr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rvr)); }
        emit_neon_ins_el(st, size, index, 0, rd, R.unwrap_ok[i32, str](rvr)::u32, vl);
    }
    or {
        val rvr: R.Result[i32, str] = resolve_source(st, ?mi.operands[3], SCRATCH0, mir.vec_lane_elem_bytes(vl) == 8);
        if (R.is_err[i32, str](rvr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rvr)); }
        var src_bytes: u8 = 4;
        if (mir.vec_lane_elem_bytes(vl) == 8) { src_bytes = 8; }
        emit_neon_ins_gp(st, size, index, rd, R.unwrap_ok[i32, str](rvr)::u32, vl, src_bytes);
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret R.ok_void[str]();
}

fun neon_base(opcode: u32, is_float: bool) u32 {
    if (opcode == arm64.VEC_ADD::u32)  { if (is_float) { ret VFADD; } ret VADD; }
    if (opcode == arm64.VEC_SUB::u32)  { if (is_float) { ret VFSUB; } ret VSUB; }
    if (opcode == arm64.VEC_MUL::u32)  { if (is_float) { ret VFMUL; } ret VMUL; }
    if (opcode == arm64.VEC_DIV::u32)  { ret VFDIV; }
    if (opcode == arm64.VEC_AND::u32)  { ret VAND; }
    if (opcode == arm64.VEC_ORR::u32)  { ret VORR; }
    if (opcode == arm64.VEC_EOR::u32)  { ret VEOR; }
    if (opcode == arm64.VEC_CMEQ::u32) { if (is_float) { ret VFCMEQ; } ret VCMEQ; }
    if (opcode == arm64.VEC_CMGT::u32) { if (is_float) { ret VFCMGT; } ret VCMGT_S; }
    if (opcode == arm64.VEC_CMGE::u32) { if (is_float) { ret VFCMGE; } ret VCMGE_S; }
    if (opcode == arm64.VEC_CMHI::u32) { ret VCMHI_U; }
    if (opcode == arm64.VEC_CMHS::u32) { ret VCMHS_U; }
    ret 0;
}

fun neon_3same_size_ok(base: u32, size: u32) bool {
    if (base == VMUL) { ret size != 3; }
    ret true;
}

fun neon_arrangement_err(base: u32, size: u32) str {
    if (base == VMUL) { ret "encode: NEON integer multiply has no 64-bit lane arrangement (MUL (vector) leaves size 3 unallocated)"; }
    ret "encode: NEON three-register-same word has no encoding at this arrangement";
}

fun encode_neon(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    val vl: u32 = mi.vec_lane;
    val is_float: bool = mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT;
    val size: u32 = neon_size(vl);
    val op: u32 = mi.opcode;

    if (op == arm64.VEC_NOT::u32) {
        if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: vector NOT missing operands"); }
        val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
        if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
        val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
        val ndst: *mir.MirOperand = ?mi.operands[0];
        if (ndst.kind == mir.MIR_OP_MEM) {
            emit_neon_2misc(st, VNOT, FP_SCRATCH0, rn);
            ret emit_fp_slot_store(st, f, ndst, FP_SCRATCH0, 16);
        }
        val rdr: R.Result[i32, str] = req_vec(ndst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        emit_neon_2misc(st, VNOT, R.unwrap_ok[i32, str](rdr)::u32, rn);
        ret R.ok_void[str]();
    }

    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: vector op missing operands"); }
    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
    val rmr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH1, 16);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    var rd: u32 = FP_SCRATCH0;
    var to_slot: bool = false;
    if (dst.kind == mir.MIR_OP_MEM) {
        to_slot = true;
    }
    or {
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        rd = R.unwrap_ok[i32, str](rdr)::u32;
    }

    if (op == arm64.VEC_CMNE::u32) {
        var eqbase: u32 = VCMEQ;
        if (is_float) { eqbase = VFCMEQ; }
        if (!neon_3same_size_ok(eqbase, size)) { ret R.err[R.Void, str](neon_arrangement_err(eqbase, size)); }
        emit_neon_3same(st, eqbase, size, rd, rn, rm, vl);
        emit_neon_2misc(st, VNOT, rd, rd);
    }
    or {
        var eff_size: u32 = size;
        if (op == arm64.VEC_AND::u32 || op == arm64.VEC_ORR::u32 || op == arm64.VEC_EOR::u32) { eff_size = 0; }
        val base: u32 = neon_base(op, is_float);
        if (!neon_3same_size_ok(base, eff_size)) { ret R.err[R.Void, str](neon_arrangement_err(base, eff_size)); }
        emit_neon_3same(st, base, eff_size, rd, rn, rm, vl);
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret R.ok_void[str]();
}

fun encode_fp_neg(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: float negate missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float negate has a non-float operand width (expected 4 or 8)");
    }
    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, w);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    var base: u32 = FNEG_S;
    if (w == 8) { base = FNEG_D; }
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind == mir.MIR_OP_MEM) {
        emit_alu3(st, base, FP_SCRATCH0, rn, 0);
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
    }
    val rdr: R.Result[i32, str] = req_vec(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, rn, 0);
    ret R.ok_void[str]();
}

fun encode_fp_cmp(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: float comparison missing operands"); }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float comparison has a non-float operand width (expected 4 or 8)");
    }
    val cc: u8 = mi.src_width;

    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, w);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH1, w);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    var base: u32 = FCMP_S;
    if (w == 8) { base = FCMP_D; }
    emit_alu3(st, base, 0, rn, rm);
    val ccr: R.Result[u32, str] = fp_cond(cc);
    if (R.is_err[u32, str](ccr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ccr)); }
    emit_cset(st, CSINC_W, rd, R.unwrap_ok[u32, str](ccr));
    ret R.ok_void[str]();
}

fun cvt_int_to_fp_base(signed: bool, dbl: bool, src_x: bool) u32 {
    if (signed) {
        if (dbl) { if (src_x) { ret SCVTF_D_X; } ret SCVTF_D_W; }
        if (src_x)            { ret SCVTF_S_X; }
        ret SCVTF_S_W;
    }
    if (dbl) { if (src_x) { ret UCVTF_D_X; } ret UCVTF_D_W; }
    if (src_x)            { ret UCVTF_S_X; }
    ret UCVTF_S_W;
}

fun cvt_fp_to_int_base(signed: bool, dst_x: bool, src_d: bool) u32 {
    if (signed) {
        if (dst_x) { if (src_d) { ret FCVTZS_X_D; } ret FCVTZS_X_S; }
        if (src_d)              { ret FCVTZS_W_D; }
        ret FCVTZS_W_S;
    }
    if (dst_x) { if (src_d) { ret FCVTZU_X_D; } ret FCVTZU_X_S; }
    if (src_d)              { ret FCVTZU_W_D; }
    ret FCVTZU_W_S;
}

fun encode_fp_conv(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: float conversion missing operands"); }
    val op: mir.MirOpcode = mi.opcode;
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    if (op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT) {
        if (!is_float_width(dw) || !is_float_width(sw)) {
            ret R.err[R.Void, str]("internal compiler error: float conversion has a non-float width on a float side (expected 4 or 8)");
        }
        val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, sw);
        if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
        val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
        var base: u32 = FCVT_D2S;
        if (op == mir.MIR_FP_EXT) { base = FCVT_S2D; }
        val dst: *mir.MirOperand = ?mi.operands[0];
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_alu3(st, base, FP_SCRATCH0, rn, 0);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, dw);
        }
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, rn, 0);
        ret R.ok_void[str]();
    }

    if (op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP) {
        if (!is_float_width(dw)) {
            ret R.err[R.Void, str]("internal compiler error: integer-to-float conversion has a non-float result width (expected 4 or 8)");
        }
        val signed: bool = op == mir.MIR_SI_TO_FP;
        val gpr: R.Result[i32, str] = req_gpr(?mi.operands[1]);
        if (R.is_err[i32, str](gpr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](gpr)); }
        var gp: u32 = R.unwrap_ok[i32, str](gpr)::u32;
        var src_x: bool = sw >= 8;
        if (sw < 4) {
            val imms: u32 = (sw::u32 * 8) - 1;
            if (signed) { emit_bitfield(st, SBFM_W, SCRATCH0, gp, 0, imms); }
            or          { emit_bitfield(st, UBFM_W, SCRATCH0, gp, 0, imms); }
            gp = SCRATCH0;
            src_x = false;
        }
        val dbl: bool = dw == 8;
        val base: u32 = cvt_int_to_fp_base(signed, dbl, src_x);
        val dst: *mir.MirOperand = ?mi.operands[0];
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_alu3(st, base, FP_SCRATCH0, gp, 0);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, dw);
        }
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, gp, 0);
        ret R.ok_void[str]();
    }

    if (!is_float_width(sw)) {
        ret R.err[R.Void, str]("internal compiler error: float-to-integer conversion has a non-float source width (expected 4 or 8)");
    }
    val signed: bool = op == mir.MIR_FP_TO_SI;
    val rnr: R.Result[i32, str] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, sw);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
    val base: u32 = cvt_fp_to_int_base(signed, dw >= 8, sw == 8);
    emit_alu3(st, base, rd, rn, 0);
    ret R.ok_void[str]();
}

fun encode_fmov(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: fmov missing operands"); }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (mi.width == 16) {
        if (dst.kind == mir.MIR_OP_MEM) {
            val rnr: R.Result[i32, str] = resolve_fp_source(st, f, src, FP_SCRATCH0, 16);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            ret emit_fp_slot_store(st, f, dst, R.unwrap_ok[i32, str](rnr)::u32, 16);
        }
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;
        if (src.kind == mir.MIR_OP_MEM) {
            ret emit_fp_slot_load(st, f, src, rd, 16);
        }
        val rnr: R.Result[i32, str] = req_vec(src);
        if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
        val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
        emit_neon_3same(st, VORR, 0, rd, rn, rn, mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16));
        ret R.ok_void[str]();
    }

    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float move has a non-float operand width (expected 4, 8 or 16)");
    }
    val dbl: bool = w == 8;

    if (src.kind == mir.MIR_OP_IMM) {
        if (dst.kind == mir.MIR_OP_MEM) {
            val cr: R.Result[R.Void, str] = emit_fp_const(st, FP_SCRATCH0, src.imm::u64, w);
            if (R.is_err[R.Void, str](cr)) { ret cr; }
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
        }
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        ret emit_fp_const(st, R.unwrap_ok[i32, str](rdr)::u32, src.imm::u64, w);
    }

    if (dst.kind != mir.MIR_OP_MEM && src.kind != mir.MIR_OP_MEM) {
        val dvec: bool = reg_is_vec(dst);
        val svec: bool = reg_is_vec(src);
        if (dvec && svec) {
            val rdr: R.Result[i32, str] = req_vec(dst);
            if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
            val rnr: R.Result[i32, str] = req_vec(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            var base: u32 = FMOV_S;
            if (dbl) { base = FMOV_D; }
            emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, R.unwrap_ok[i32, str](rnr)::u32, 0);
            ret R.ok_void[str]();
        }
        if (dvec) {
            val rdr: R.Result[i32, str] = req_vec(dst);
            if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
            val rnr: R.Result[i32, str] = req_gpr(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            var base: u32 = FMOV_S_FROM_W;
            if (dbl) { base = FMOV_D_FROM_X; }
            emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, R.unwrap_ok[i32, str](rnr)::u32, 0);
            ret R.ok_void[str]();
        }
        if (svec) {
            val rdr: R.Result[i32, str] = req_gpr(dst);
            if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
            val rnr: R.Result[i32, str] = req_vec(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            var base: u32 = FMOV_W_FROM_S;
            if (dbl) { base = FMOV_X_FROM_D; }
            emit_alu3(st, base, R.unwrap_ok[i32, str](rdr)::u32, R.unwrap_ok[i32, str](rnr)::u32, 0);
            ret R.ok_void[str]();
        }
        ret R.err[R.Void, str]("encode: fmov names two general-purpose registers");
    }

    if (dst.kind == mir.MIR_OP_MEM) {
        if (src.kind == mir.MIR_OP_MEM) {
            val mr: R.Result[A64Mem, str] = resolve_mem(f, src);
            if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
            val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
            if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill operand not expected"); }
            val lr: R.Result[R.Void, str] = emit_fp_mem(st, FP_SCRATCH0, m.base, m.off, w, true);
            if (R.is_err[R.Void, str](lr)) { ret lr; }
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
        }
        if (reg_is_vec(src)) {
            val rnr: R.Result[i32, str] = req_vec(src);
            if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
            ret emit_fp_slot_store(st, f, dst, R.unwrap_ok[i32, str](rnr)::u32, w);
        }
        ret emit_store_mem(st, f, dst, src, w);
    }

    if (reg_is_vec(dst)) {
        val rdr: R.Result[i32, str] = req_vec(dst);
        if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
        val mr: R.Result[A64Mem, str] = resolve_mem(f, src);
        if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
        val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
        if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill operand not expected"); }
        ret emit_fp_mem(st, R.unwrap_ok[i32, str](rdr)::u32, m.base, m.off, w, true);
    }
    val rdr: R.Result[i32, str] = req_gpr(dst);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val mr: R.Result[A64Mem, str] = resolve_mem(f, src);
    if (R.is_err[A64Mem, str](mr)) { ret R.err[R.Void, str](R.unwrap_err[A64Mem, str](mr)); }
    val m: A64Mem = R.unwrap_ok[A64Mem, str](mr);
    if (m.has_index) { ret R.err[R.Void, str]("encode: indexed float spill operand not expected"); }
    ret emit_mem_access(st, R.unwrap_ok[i32, str](rdr)::u32, m.base, m.off, w, true);
}

fun cmp_cond(op: mir.MirOpcode) R.Result[u32, str] {
    if (op == mir.MIR_SEL_CMP_EQ)   { ret R.ok[u32, str](CC_EQ); }
    if (op == mir.MIR_SEL_CMP_NE)   { ret R.ok[u32, str](CC_NE); }
    if (op == mir.MIR_SEL_CMP_LT_S) { ret R.ok[u32, str](CC_LT); }
    if (op == mir.MIR_SEL_CMP_LT_U) { ret R.ok[u32, str](CC_CC); }
    if (op == mir.MIR_SEL_CMP_LE_S) { ret R.ok[u32, str](CC_LE); }
    if (op == mir.MIR_SEL_CMP_LE_U) { ret R.ok[u32, str](CC_LS); }
    ret R.err[u32, str]("encode: aarch64 has no comparison condition for this relation");
}

fun is_mir_compare(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_CMP_EQ || op == mir.MIR_SEL_CMP_NE ||
        op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U ||
        op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U;
}

fun narrow_cmp_source(st: *encode.EncodeState, reg: u32, scratch: u32, width: u8, signed: bool) u32 {
    if (width == 0 || width >= 4) { ret reg; }
    val imms: u32 = (width::u32 * 8) - 1;
    if (signed) { emit_bitfield(st, SBFM_W, scratch, reg, 0, imms); }
    or          { emit_bitfield(st, UBFM_W, scratch, reg, 0, imms); }
    ret scratch;
}

fun cmp_imm_value(imm: i64, width: u8, signed: bool) i64 {
    if (width == 1) {
        var v: i64 = imm & 0xFF;
        if (signed && (v & 0x80) != 0) { v = v - 0x100; }
        ret v;
    }
    if (width == 2) {
        var v: i64 = imm & 0xFFFF;
        if (signed && (v & 0x8000) != 0) { v = v - 0x10000; }
        ret v;
    }
    ret imm;
}

fun emit_flag_cmp(st: *encode.EncodeState, lhs_op: *mir.MirOperand, rhs_op: *mir.MirOperand,
                  width: u8, signed: bool) R.Result[R.Void, str] {
    val use64: bool = is64(width);

    val rnr: R.Result[i32, str] = resolve_source(st, lhs_op, SCRATCH1, use64);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    var rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;
    rn = narrow_cmp_source(st, rn, SCRATCH1, width, signed);

    val rhs_val: i64 = cmp_imm_value(rhs_op.imm, width, signed);
    if (rhs_op.kind == mir.MIR_OP_IMM && rhs_val >= 0 && rhs_val <= 4095) {
        emit_addsub_imm(st, sel(use64, SUBS_IMM_X, SUBS_IMM_W), ZR, rn, rhs_val::u32, 0);
    } or {
        val rmr: R.Result[i32, str] = resolve_source(st, rhs_op, SCRATCH0, use64);
        if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
        var rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;
        rm = narrow_cmp_source(st, rm, SCRATCH0, width, signed);
        emit_alu3(st, sel(use64, SUBS_REG_X, SUBS_REG_W), ZR, rn, rm);
    }
    ret R.ok_void[str]();
}

fun encode_compare(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: compare missing operands"); }

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rc: R.Result[R.Void, str] = emit_flag_cmp(st, ?mi.operands[1], ?mi.operands[2], mi.width, mir.is_signed_cmp(mi.opcode));
    if (R.is_err[R.Void, str](rc)) { ret rc; }

    val ccr: R.Result[u32, str] = cmp_cond(mi.opcode);
    if (R.is_err[u32, str](ccr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ccr)); }
    emit_cset(st, CSINC_W, rd, R.unwrap_ok[u32, str](ccr));
    ret R.ok_void[str]();
}

fun encode_branch(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: branch target is not a block");
    }
    val target_block: u32 = mi.operands[0].imm::u32;
    if (encode.branch_falls_through(st, target_block)) { ret R.ok_void[str](); }
    val patch_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, B_BASE, 0, false, target_block);
    val next_ip: u32 = st.buf.len::u32;
    ret encode.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
}

fun encode_cbr(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: conditional branch missing operands"); }
    if (mi.operands[1].kind != mir.MIR_OP_BLOCK || mi.operands[2].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: conditional branch target is not a block");
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;
    val use64: bool = is64(mi.width);

    val rcr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rcr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rcr)); }
    val cond: u32 = R.unwrap_ok[i32, str](rcr)::u32;

    val cbnz_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, sel(use64, CBNZ_X, CBNZ_W), cond, true, then_block);
    val cbnz_next: u32 = st.buf.len::u32;
    val f1: R.Result[R.Void, str] = encode.push_fixup(st, cbnz_pos, cbnz_next, then_block, fn_base);
    if (R.is_err[R.Void, str](f1)) { ret f1; }

    if (encode.branch_falls_through(st, else_block)) { ret R.ok_void[str](); }
    val b_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, B_BASE, 0, false, else_block);
    val b_next: u32 = st.buf.len::u32;
    ret encode.push_fixup(st, b_pos, b_next, else_block, fn_base);
}

fun fused_cbr_cond(op: mir.MirOpcode) R.Result[u32, str] {
    if (op == mir.MIR_SEL_CBR_EQ)   { ret R.ok[u32, str](CC_EQ); }
    if (op == mir.MIR_SEL_CBR_NE)   { ret R.ok[u32, str](CC_NE); }
    if (op == mir.MIR_SEL_CBR_LT_S) { ret R.ok[u32, str](CC_LT); }
    if (op == mir.MIR_SEL_CBR_LT_U) { ret R.ok[u32, str](CC_CC); }
    if (op == mir.MIR_SEL_CBR_LE_S) { ret R.ok[u32, str](CC_LE); }
    if (op == mir.MIR_SEL_CBR_LE_U) { ret R.ok[u32, str](CC_LS); }
    ret R.err[u32, str]("encode: aarch64 has no fused compare-and-branch condition for this relation");
}

fun encode_fused_cbr(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 4) {
        ret R.err[R.Void, str]("encode: fused compare-branch missing operands");
    }
    if (mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: fused compare-branch target is not a block");
    }
    val then_block: u32 = mi.operands[2].imm::u32;
    val else_block: u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.len::u32;

    val rc: R.Result[R.Void, str] = emit_flag_cmp(st, ?mi.operands[0], ?mi.operands[1], mi.width, mir.is_signed_cmp(mi.opcode));
    if (R.is_err[R.Void, str](rc)) { ret rc; }

    val bcc_pos: u32 = st.buf.len::u32;
    val ccr: R.Result[u32, str] = fused_cbr_cond(mi.opcode);
    if (R.is_err[u32, str](ccr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ccr)); }
    emit_branch_block(st, BCOND | (R.unwrap_ok[u32, str](ccr) & 0xF), 0, false, then_block);
    val bcc_next: u32 = st.buf.len::u32;
    val f1: R.Result[R.Void, str] = encode.push_fixup(st, bcc_pos, bcc_next, then_block, fn_base);
    if (R.is_err[R.Void, str](f1)) { ret f1; }

    if (encode.branch_falls_through(st, else_block)) {
        encode.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
        ret R.ok_void[str]();
    }
    val b_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, B_BASE, 0, false, else_block);
    val b_next: u32 = st.buf.len::u32;
    encode.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
    ret encode.push_fixup(st, b_pos, b_next, else_block, fn_base);
}

fun is_mir_divide(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_DIV_U ||
        op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;
}

fun encode_divide(st: *encode.EncodeState, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: divide missing operands"); }
    val use64: bool = is64(mi.width);

    val rdr: R.Result[i32, str] = req_gpr(?mi.operands[0]);
    if (R.is_err[i32, str](rdr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rdr)); }
    val rd: u32 = R.unwrap_ok[i32, str](rdr)::u32;

    val rnr: R.Result[i32, str] = req_gpr(?mi.operands[1]);
    if (R.is_err[i32, str](rnr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rnr)); }
    val rn: u32 = R.unwrap_ok[i32, str](rnr)::u32;

    val rmr: R.Result[i32, str] = req_gpr(?mi.operands[2]);
    if (R.is_err[i32, str](rmr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](rmr)); }
    val rm: u32 = R.unwrap_ok[i32, str](rmr)::u32;

    val op: mir.MirOpcode = mi.opcode;
    val signed: bool = op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_REM_S;
    val rem:    bool = op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;

    emit_branch_pcrel(st, sel(use64, CBNZ_X, CBNZ_W), rm, true, 2);
    emit_imm16(st, BRK_BASE, 0);

    if (signed) {
        emit_addsub_imm(st, sel(use64, ADDS_IMM_X, ADDS_IMM_W), ZR, rm, 1, 0);
        emit_branch_pcrel(st, BCOND | CC_NE, 0, false, 5);
        var hw: u32 = 1;
        if (use64) { hw = 3; }
        emit_movewide(st, sel(use64, MOVZ_X, MOVZ_W), SCRATCH1, hw, 0x8000);
        emit_alu3(st, sel(use64, SUBS_REG_X, SUBS_REG_W), ZR, rn, SCRATCH1);
        emit_branch_pcrel(st, BCOND | CC_NE, 0, false, 2);
        emit_imm16(st, BRK_BASE, 0);
    }

    var dbase_x: u32 = SDIV_X; var dbase_w: u32 = SDIV_W;
    if (!signed) { dbase_x = UDIV_X; dbase_w = UDIV_W; }

    if (rem) {
        emit_alu3(st, sel(use64, dbase_x, dbase_w), SCRATCH0, rn, rm);
        emit_madd(st, sel(use64, MSUB_X, MSUB_W), rd, SCRATCH0, rm, rn);
        ret R.ok_void[str]();
    }
    emit_alu3(st, sel(use64, dbase_x, dbase_w), rd, rn, rm);
    ret R.ok_void[str]();
}

fun popcount32(m: u32) u32 {
    var n: u32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    ret n;
}

fun align16(n: u32) u32 {
    ret (n + 15) & ~15::u32;
}

fun frame_subsize(f: *mir.MirFunction) u32 {
    val gp_bytes: u32 = popcount32(f.callee_mask) * 8;
    val fp_bytes: u32 = popcount32(f.callee_mask_fp) * 8;
    val n: u32 = align16(gp_bytes + fp_bytes + f.frame.size + f.frame.outgoing_size);
    if (f.frame.realign != 0) {
        val rmask: u32 = f.frame.realign - 1;
        ret (n + rmask) & ~rmask;
    }
    ret n;
}

fun emit_sp_sub(st: *encode.EncodeState, subsize: u32) {
    if (subsize <= 0xFFF) {
        emit_addsub_imm(st, SUBI_X, ZR, ZR, subsize, 0);
        ret;
    }
    if (subsize <= MAX_FRAME_SUB) {
        val hi: u32 = subsize >> 12;
        val lo: u32 = subsize & 0xFFF;
        emit_addsub_imm(st, SUBI_X, ZR, ZR, hi, 1);
        if (lo != 0) { emit_addsub_imm(st, SUBI_X, ZR, ZR, lo, 0); }
        ret;
    }
    emit_movewide_seq(st, SCRATCH0, subsize::u64, true);
    emit_alu3(st, SUB_SP_REG_X, ZR, ZR, SCRATCH0);
}

fun emit_prologue(st: *encode.EncodeState, f: *mir.MirFunction, subsize: u32) {
    emit_ldstp(st, STP_PRE_X, 29, 30, ZR, (0::u32 - 2) & 0x7F);
    emit_addsub_imm(st, ADDI_X, 29, ZR, 0, 0);
    emit_sp_realign(st, f.frame.realign);
    if (subsize > 0) { emit_sp_sub(st, subsize); }
    save_callee_gp(st, f, true);
    save_callee_fp(st, f, true);
}

fun emit_sp_realign(st: *encode.EncodeState, realign: u32) {
    if (realign == 0) { ret; }
    val k: u32 = log2_u32(realign);
    emit_addsub_imm(st, ADDI_X, SCRATCH0, ZR, 0, 0);
    emit_bitfield(st, UBFM_X, SCRATCH0, SCRATCH0, k, 63);
    emit_bitfield(st, UBFM_X, SCRATCH0, SCRATCH0, (64 - k) & 63, 63 - k);
    emit_addsub_imm(st, ADDI_X, ZR, SCRATCH0, 0, 0);
}

fun log2_u32(n: u32) u32 {
    var k: u32 = 0;
    var v: u32 = n;
    for (v > 1) { v = v >> 1; k = k + 1; }
    ret k;
}

fun emit_epilogue(st: *encode.EncodeState, f: *mir.MirFunction, subsize: u32) {
    save_callee_fp(st, f, false);
    save_callee_gp(st, f, false);
    if (subsize > 0) {
        emit_addsub_imm(st, ADDI_X, ZR, 29, 0, 0);
    }
    emit_ldstp(st, LDP_POST_X, 29, 30, ZR, 2);
}

fun save_callee_gp(st: *encode.EncodeState, f: *mir.MirFunction, store: bool) {
    var regs: [32]u32;
    var n: u32 = 0;
    var r: u32 = 0;
    for (r < 31) {
        if ((f.callee_mask & (1::u32 << r)) != 0) { regs[n] = r; n = n + 1; }
        r = r + 1;
    }
    if (n == 0) { ret; }

    val fs: i32 = f.frame.size::i32;
    val gp_bytes: u32 = n * 8;
    val num_pairs: u32 = n / 2;

    var base_reg: u32 = 29;
    var anchor: i32 = fs + 16;
    if (codegen_frame.slots_from_sp(?f.frame)) {
        emit_add_imm(st, SCRATCH0, ZR, frame_subsize(f)::i64 - (fs + 16)::i64);
        base_reg = SCRATCH0;
        anchor = 0;
    } or (f.frame.size + gp_bytes > MAX_CALLEE_SAVE_REACH) {
        emit_add_imm(st, SCRATCH0, 29, 0 - ((fs + 16)::i64));
        base_reg = SCRATCH0;
        anchor = 0;
    }

    var p: u32 = 0;
    for (p < num_pairs) {
        val base_off: i32 = 0 - (anchor + (16 * p)::i32);
        val imm7: u32 = (base_off / 8)::u32 & 0x7F;
        if (store) { emit_ldstp(st, STP_OFF_X, regs[2 * p], regs[2 * p + 1], base_reg, imm7); }
        or         { emit_ldstp(st, LDP_OFF_X, regs[2 * p], regs[2 * p + 1], base_reg, imm7); }
        p = p + 1;
    }
    if ((n & 1) == 1) {
        val single_off: i32 = 0 - (anchor + (16 * num_pairs)::i32 - 8);
        emit_mem_access(st, regs[n - 1], base_reg, single_off::i64, 8, !store);
    }
}

fun save_callee_fp(st: *encode.EncodeState, f: *mir.MirFunction, store: bool) {
    var regs: [32]u32;
    var n: u32 = 0;
    var r: u32 = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) { regs[n] = r; n = n + 1; }
        r = r + 1;
    }
    if (n == 0) { ret; }

    val fs: i32 = f.frame.size::i32;
    val gp_bytes: u32 = popcount32(f.callee_mask) * 8;
    val fp_bytes: u32 = n * 8;
    val num_pairs: u32 = n / 2;

    var base_reg: u32 = 29;
    var anchor: i32 = fs + gp_bytes::i32 + 16;
    if (codegen_frame.slots_from_sp(?f.frame)) {
        emit_add_imm(st, SCRATCH0, ZR, frame_subsize(f)::i64 - (fs + gp_bytes::i32 + 16)::i64);
        base_reg = SCRATCH0;
        anchor = 0;
    } or (f.frame.size + gp_bytes + fp_bytes > MAX_CALLEE_SAVE_REACH) {
        emit_add_imm(st, SCRATCH0, 29, 0 - ((fs + gp_bytes::i32 + 16)::i64));
        base_reg = SCRATCH0;
        anchor = 0;
    }

    var p: u32 = 0;
    for (p < num_pairs) {
        val base_off: i32 = 0 - (anchor + (16 * p)::i32);
        val imm7: u32 = (base_off / 8)::u32 & 0x7F;
        if (store) { emit_ldstp(st, STP_OFF_D, regs[2 * p], regs[2 * p + 1], base_reg, imm7); }
        or         { emit_ldstp(st, LDP_OFF_D, regs[2 * p], regs[2 * p + 1], base_reg, imm7); }
        p = p + 1;
    }
    if ((n & 1) == 1) {
        val single_off: i32 = 0 - (anchor + (16 * num_pairs)::i32 - 8);
        emit_fp_mem(st, regs[n - 1], base_reg, single_off::i64, 8, !store);
    }
}

fun encode_mir_instr(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    val op: u16 = mi.opcode::u16;

    val rv_vb: R.Result[R.Void, str] = encode.emit_var_bindings(st, f, mi);
    if (R.is_err[R.Void, str](rv_vb)) { ret rv_vb; }

    if (op == isa.ISA_PCOPY || op == isa.ISA_PCOPY_FENCE ||
        op == isa.ISA_USE || op == isa.ISA_LABEL) {
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_CALL_RES || mi.opcode == mir.MIR_ARG) {
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_PHI) {
        ret R.err[R.Void, str]("internal compiler error: phi survived register allocation");
    }

    if (is_mir_compare(mi.opcode))    { ret encode_compare(st, mi); }
    if (mi.opcode == mir.MIR_SEL_CBR) { ret encode_cbr(st, fn_base, mi); }

    if (mir.is_fused_cbr(mi.opcode)) { ret encode_fused_cbr(st, fn_base, mi); }

    if (is_mir_divide(mi.opcode)) { ret encode_divide(st, mi); }

    if (mi.opcode == mir.MIR_MOV) { ret encode_mov(st, f, mi); }

    if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret encode_vec_lane_read(st, f, mi); }
    if (mi.opcode == mir.MIR_VEC_INSERT)  { ret encode_vec_lane_write(st, f, mi); }

    if (mi.opcode == mir.MIR_ALLOCA || mi.opcode == mir.MIR_GEP) { ret encode_addr(st, f, mi); }
    if (mi.opcode == mir.MIR_LOAD)                               { ret encode_load(st, f, mi); }
    if (mi.opcode == mir.MIR_STORE)                              { ret encode_store(st, f, mi); }

    if (mi.opcode == mir.MIR_TRUNC || mi.opcode == mir.MIR_SEXT ||
        mi.opcode == mir.MIR_ZEXT || mi.opcode == mir.MIR_BITCAST) {
        ret encode_convert(st, mi);
    }

    if (is_mir_float_arith(mi.opcode)) { ret encode_fp_arith(st, f, mi); }
    if (mi.opcode == mir.MIR_FNEG)     { ret encode_fp_neg(st, f, mi); }
    if (mi.opcode == mir.MIR_FCMP)     { ret encode_fp_cmp(st, f, mi); }

    if (is_mir_float_conv(mi.opcode)) { ret encode_fp_conv(st, f, mi); }

    if (mi.opcode == mir.MIR_CALL) {
        ret encode_call(st, mi);
    }
    if (mi.opcode == mir.MIR_ASM) {
        ret encode_asm_block_arm64(st, f, fn_base, mi);
    }

    if (op >= arm64.VEC_ADD::u16 && op <= arm64.VEC_CMHS::u16) { ret encode_neon(st, f, mi); }
    if (op == arm64.ADD::u16)  { ret encode_addsub(st, mi, false); }
    if (op == arm64.SUB::u16)  { ret encode_addsub(st, mi, true); }
    if (op == arm64.MUL::u16)  { ret encode_alu3(st, mi, MUL_X, MUL_W); }
    if (op == arm64.AND::u16)  { ret encode_alu3(st, mi, AND_X, AND_W); }
    if (op == arm64.ORR::u16)  { ret encode_alu3(st, mi, ORR_X, ORR_W); }
    if (op == arm64.EOR::u16)  { ret encode_alu3(st, mi, EOR_X, EOR_W); }
    if (op == arm64.LSL::u16)  { ret encode_shift(st, mi, arm64.LSL::u32); }
    if (op == arm64.LSR::u16)  { ret encode_shift(st, mi, arm64.LSR::u32); }
    if (op == arm64.ASR::u16)  { ret encode_shift(st, mi, arm64.ASR::u32); }
    if (op == arm64.NEG::u16)  { ret encode_neg_mvn(st, mi, SUB_X, SUB_W); }
    if (op == arm64.MVN::u16)  { ret encode_neg_mvn(st, mi, ORN_X, ORN_W); }
    if (op == arm64.MOV::u16)  { ret encode_mov(st, f, mi); }
    if (op == arm64.FMOV::u16) { ret encode_fmov(st, f, mi); }
    if (op == arm64.B::u16)    { ret encode_branch(st, fn_base, mi); }
    if (op == arm64.RET::u16)  { emit_nullary(st, RET_WORD); ret R.ok_void[str](); }
    if (op == arm64.BRK::u16)  { emit_imm16(st, BRK_BASE, 0); ret R.ok_void[str](); }
    if (op == arm64.NOP::u16)  { emit_nullary(st, NOP_WORD); ret R.ok_void[str](); }

    ret R.err[R.Void, str]("internal compiler error: unhandled opcode in arm64 encode");
}

fun encode_function_arm64(st: *encode.EncodeState, f: *mir.MirFunction) R.Result[R.Void, str] {
    val fn_base: u32 = st.buf.len::u32;
    if (f.block_count == 0) { ret R.ok_void[str](); }

    val ms: R.Result[R.Void, str] = encode.push_symbol(st, f.name, fn_base, of.SYM_OBJ_FLAG_FUNCTION);
    if (R.is_err[R.Void, str](ms)) { ret ms; }

    val naked: bool = f.frame.omit;
    val subsize: u32 = f.frame.base_dist;

    if (encode.sink_active(?st.buf)) {
        val rh: R.Result[R.Void, str] = printer.note_function(?st.buf, st.interner, f);
        if (R.is_err[R.Void, str](rh)) { ret rh; }
    }

    if (!naked) { emit_prologue(st, f, subsize); }
    val rp: R.Result[R.Void, str] = check_accounted(st, PROLOGUE_REGION);
    if (R.is_err[R.Void, str](rp)) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        val rb: R.Result[R.Void, str] = encode.push_block(st, fn_base, blk.id, st.buf.len::u32);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        encode.set_fallthrough(st, f, bi);

        if (encode.sink_active(?st.buf)) {
            val rl: R.Result[R.Void, str] = printer.note_block(?st.buf, blk.id);
            if (R.is_err[R.Void, str](rl)) { ret rl; }
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (!mir.emits_instr(f, mi)) { ii = ii + 1; cnt; }
            val rr: R.Result[R.Void, str] = encode.push_row(st, st.buf.len::u32, mi.loc);
            if (R.is_err[R.Void, str](rr)) { ret rr; }
            val rip: R.Result[R.Void, str] = encode.push_inline_pc(st, st.buf.len::u32, mi.inline_site);
            if (R.is_err[R.Void, str](rip)) { ret rip; }
            if (mi.opcode::u16 == arm64.RET::u16 && !naked) {
                emit_epilogue(st, f, subsize);
            }
            val ei: R.Result[R.Void, str] = encode_mir_instr(st, f, fn_base, mi);
            if (R.is_err[R.Void, str](ei)) { ret ei; }
            val ra: R.Result[R.Void, str] = check_accounted(st, mi.opcode::u16);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun patch_branch_arm64(st: *encode.EncodeState, fx: *encode.BranchFixup, target_off: u32) R.Result[R.Void, str] {
    val pos: usize = fx.patch_pos::usize;
    if (pos + 4 > st.buf.len) {
        ret R.err[R.Void, str]("encode: branch fixup site is outside the text buffer");
    }
    val word: u32 = read_word(?st.buf, pos);
    val sdisp: i64 = (target_off::i64) - (fx.patch_pos::i64);
    if ((sdisp & 3) != 0) {
        ret R.err[R.Void, str]("encode: aarch64 branch displacement is not 4-byte aligned");
    }
    val disp: u32 = target_off - fx.patch_pos;

    var patched: u32 = 0;
    if ((word & 0xFC000000) == B_BASE) {
        if (sdisp < -134217728 || sdisp >= 134217728) {
            ret R.err[R.Void, str]("encode: aarch64 B displacement exceeds the +-128MB branch range");
        }
        patched = (word & 0xFC000000) | ((disp & 0x0FFFFFFC) >> 2);
    } or {
        if (sdisp < -1048576 || sdisp >= 1048576) {
            ret R.err[R.Void, str]("encode: aarch64 conditional-branch displacement exceeds the +-1MB range");
        }
        patched = (word & 0xFF00001F) | (((disp >> 2) & 0x7FFFF) << 5);
    }
    write_word(?st.buf, pos, patched);
    ret R.ok_void[str]();
}

fun arm64_reloc_offset(inst_start: u32) u32 {
    ret inst_start;
}

pub fun encode_arm64(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule) R.Result[encode.EncoderOutput, str] {
    var hooks: encode.EncodeHooks;
    hooks.encode_function = encode_function_arm64;
    hooks.patch_branch    = patch_branch_arm64;
    ret encode.encode_driver(alloc, tgt, m, ?hooks);
}

val PROLOGUE_REGION: u16 = 0xFFFF;

fun check_accounted(st: *encode.EncodeState, opcode: u16) R.Result[R.Void, str] {
    val gap: usize = encode.sink_unaccounted(?st.buf);
    if (gap == 0) { ret R.ok_void[str](); }

    var num: [20]u8;
    var label: str = "prologue";
    if (opcode != PROLOGUE_REGION) {
        val n: usize = u64_to_dec(opcode::u64, ?num[0]);
        num[n] = 0;
        label = (?num[0])::str;
    }
    ret R.err[R.Void, str](iasm.named_message(st.alloc, st.interner,
        "--emit-asm: opcode ", label,
        " emitted bytes the aarch64 assembly printer did not render",
        "--emit-asm: an opcode emitted bytes the assembly printer did not render"));
}

fun u64_to_dec(n: u64, dst: *u8) usize {
    if (n == 0) { dst[0] = '0'::u8; ret 1; }
    var tmp: [20]u8;
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) { tmp[len] = (v % 10)::u8 + '0'::u8; v = v / 10; len = len + 1; }
    var k: usize = 0;
    for (k < len) { dst[k] = tmp[len - 1 - k]; k = k + 1; }
    ret len;
}

pub fun encode_arm64_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule,
                         out: *writer.Writer) R.Result[encode.EncoderOutput, str] {
    var hooks: encode.EncodeHooks;
    hooks.encode_function = encode_function_arm64;
    hooks.patch_branch    = patch_branch_arm64;
    ret encode.encode_driver_asm(alloc, tgt, m, ?hooks, out);
}

fun asm_parse_cond(s: str, out: *u32) bool {
    if (str_equals(s, "eq"))                        { @out = CC_EQ; ret true; }
    if (str_equals(s, "ne"))                        { @out = CC_NE; ret true; }
    if (str_equals(s, "cs") || str_equals(s, "hs")) { @out = CC_HS; ret true; }
    if (str_equals(s, "cc") || str_equals(s, "lo")) { @out = CC_CC; ret true; }
    if (str_equals(s, "mi"))                        { @out = CC_MI; ret true; }
    if (str_equals(s, "pl"))                        { @out = CC_PL; ret true; }
    if (str_equals(s, "vs"))                        { @out = CC_VS; ret true; }
    if (str_equals(s, "vc"))                        { @out = CC_VC; ret true; }
    if (str_equals(s, "hi"))                        { @out = CC_HI; ret true; }
    if (str_equals(s, "ls"))                        { @out = CC_LS; ret true; }
    if (str_equals(s, "ge"))                        { @out = CC_GE; ret true; }
    if (str_equals(s, "lt"))                        { @out = CC_LT; ret true; }
    if (str_equals(s, "gt"))                        { @out = CC_GT; ret true; }
    if (str_equals(s, "le"))                        { @out = CC_LE; ret true; }
    if (str_equals(s, "al"))                        { @out = CC_AL; ret true; }
    ret false;
}

fun asm_parse_lsl_amount(s: str, out: *u32) bool {
    if (!str_starts_with(s, "lsl")) { ret false; }
    var i: usize = 3;
    for (s[i] != 0 && iasm.is_space(s[i])) { i = i + 1; }
    val rest: str = (s::usize + i)::str;
    val r: R.Result[i64, str] = parse.parse_i64_exact(rest, 0);
    if (R.is_err[i64, str](r)) { ret false; }
    val v: i64 = R.unwrap_ok[i64, str](r);
    if (v < 0) { ret false; }
    @out = v::u32;
    ret true;
}

fun asm_barrier_option(name: str, out: *u32) bool {
    if (str_equals(name, "sy"))    { @out = 15; ret true; }
    if (str_equals(name, "st"))    { @out = 14; ret true; }
    if (str_equals(name, "ld"))    { @out = 13; ret true; }
    if (str_equals(name, "ish"))   { @out = 11; ret true; }
    if (str_equals(name, "ishst")) { @out = 10; ret true; }
    if (str_equals(name, "ishld")) { @out = 9;  ret true; }
    if (str_equals(name, "nsh"))   { @out = 7;  ret true; }
    if (str_equals(name, "nshst")) { @out = 6;  ret true; }
    if (str_equals(name, "nshld")) { @out = 5;  ret true; }
    if (str_equals(name, "osh"))   { @out = 3;  ret true; }
    if (str_equals(name, "oshst")) { @out = 2;  ret true; }
    if (str_equals(name, "oshld")) { @out = 1;  ret true; }
    ret false;
}

fun emit_asm_mov_imm(st: *encode.EncodeState, rd: u32, value: u64, use64: bool) {
    var v: u64 = value;
    if (!use64) { v = value & 0xFFFFFFFF; }
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var i: u32 = 0;
    for (i < chunks) {
        val sh: u64 = 16::u64 * i::u64;
        val chunk: u64 = (v >> sh) & 0xFFFF;
        if ((chunk << sh) == v) {
            emit_movewide(st, sel(use64, MOVZ_X, MOVZ_W), rd, i, chunk::u32);
            ret;
        }
        i = i + 1;
    }
    emit_movewide_seq(st, rd, value, use64);
}

val A64P_NULLARY:  u16 = 1;
val A64P_RET_REG:  u16 = 2;
val A64P_IMM16:    u16 = 3;
val A64P_MOV:      u16 = 4;
val A64P_MOVEWIDE: u16 = 5;
val A64P_ADDSUB:   u16 = 6;
val A64P_LOGICAL:  u16 = 7;
val A64P_CMP:      u16 = 8;
val A64P_CSET:     u16 = 9;
val A64P_ADRP:     u16 = 10;
val A64P_BL:       u16 = 11;
val A64P_BR_REG:   u16 = 12;
val A64P_B:        u16 = 13;
val A64P_BCOND:    u16 = 14;
val A64P_CBR:      u16 = 15;
val A64P_LDST:     u16 = 16;
val A64P_LDSTP:    u16 = 17;
val A64P_DMB:      u16 = 18;
val A64P_LDORD:    u16 = 19;
val A64P_STLXR:    u16 = 20;
val A64P_SHIFT:    u16 = 21;
val A64P_MSR:      u16 = 22;
val A64P_MRS:      u16 = 23;

val A64F_COND_SHIFT: u16 = 8;
val A64F_COND_MASK:  u16 = 0x0F00;

val A64M_NOP:   u32 = 0;
val A64M_YIELD: u32 = 1;
val A64M_RET:   u32 = 2;
val A64M_SVC:   u32 = 3;
val A64M_BRK:   u32 = 4;
val A64M_MOV:   u32 = 5;
val A64M_MOVZ:  u32 = 6;
val A64M_MOVK:  u32 = 7;
val A64M_ADD:   u32 = 8;
val A64M_SUB:   u32 = 9;
val A64M_AND:   u32 = 10;
val A64M_ORR:   u32 = 11;
val A64M_EOR:   u32 = 12;
val A64M_CMP:   u32 = 13;
val A64M_CSET:  u32 = 14;
val A64M_ADRP:  u32 = 15;
val A64M_BL:    u32 = 16;
val A64M_BLR:   u32 = 17;
val A64M_BR:    u32 = 18;
val A64M_B:     u32 = 19;
val A64M_CBZ:   u32 = 20;
val A64M_CBNZ:  u32 = 21;
val A64M_LDR:   u32 = 22;
val A64M_STR:   u32 = 23;
val A64M_LDRB:  u32 = 24;
val A64M_STRB:  u32 = 25;
val A64M_LDRH:  u32 = 26;
val A64M_STRH:  u32 = 27;
val A64M_LDP:   u32 = 28;
val A64M_STP:   u32 = 29;
val A64M_DMB:   u32 = 30;
val A64M_LDAR:  u32 = 31;
val A64M_STLR:  u32 = 32;
val A64M_LDAXR: u32 = 33;
val A64M_STLXR: u32 = 34;
val A64M_LSL:   u32 = 35;
val A64M_LSR:   u32 = 36;
val A64M_ASR:   u32 = 37;
val A64M_LSLV:  u32 = 38;
val A64M_LSRV:  u32 = 39;
val A64M_ASRV:  u32 = 40;
val A64M_MSR:   u32 = 41;
val A64M_MRS:   u32 = 42;
val A64M_HVC:   u32 = 43;
val A64M_SMC:   u32 = 44;
val A64M_WFI:   u32 = 45;
val A64M_WFE:   u32 = 46;

val A64_CALLER_SAVED: u32 = 0x4007FFFF;

val A64_SMCCC_CLOBBER: u32 = 0x0003FFFF;

val A64_LR_READ: u32 = 0x40000000;

val A64_MNEMONIC_COUNT: usize = 48;

val A64_MNEMONICS: [A64_MNEMONIC_COUNT]iasm.Mnemonic = [A64_MNEMONIC_COUNT]iasm.Mnemonic{
    iasm.Mnemonic{ name: "nop",   code: A64M_NOP,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "yield", code: A64M_YIELD, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "ret",   code: A64M_RET,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: A64_LR_READ, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "ret",   code: A64M_RET,   form: iasm.AF_OPS,  writes: iasm.AW_NONE, implicit: 0, flags: A64P_RET_REG, words: 1 },

    iasm.Mnemonic{ name: "wfi", code: A64M_WFI, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "wfe", code: A64M_WFE, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },

    iasm.Mnemonic{ name: "svc", code: A64M_SVC, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 1, flags: A64P_IMM16, words: 1 },
    iasm.Mnemonic{ name: "brk", code: A64M_BRK, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_IMM16, words: 1 },
    iasm.Mnemonic{ name: "hvc", code: A64M_HVC, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_SMCCC_CLOBBER, flags: A64P_IMM16, words: 1 },
    iasm.Mnemonic{ name: "smc", code: A64M_SMC, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_SMCCC_CLOBBER, flags: A64P_IMM16, words: 1 },

    iasm.Mnemonic{ name: "movz", code: A64M_MOVZ, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_MOVEWIDE, words: 1 },
    iasm.Mnemonic{ name: "movk", code: A64M_MOVK, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_MOVEWIDE, words: 1 },
    iasm.Mnemonic{ name: "mov",  code: A64M_MOV,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_MOV,      words: iasm.WORDS_VARIABLE },
    iasm.Mnemonic{ name: "add",  code: A64M_ADD,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_ADDSUB,   words: 1 },
    iasm.Mnemonic{ name: "sub",  code: A64M_SUB,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_ADDSUB,   words: 1 },
    iasm.Mnemonic{ name: "and",  code: A64M_AND,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_LOGICAL,  words: 1 },
    iasm.Mnemonic{ name: "orr",  code: A64M_ORR,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_LOGICAL,  words: 1 },
    iasm.Mnemonic{ name: "eor",  code: A64M_EOR,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_LOGICAL,  words: 1 },
    iasm.Mnemonic{ name: "cset", code: A64M_CSET, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_CSET,     words: 1 },
    iasm.Mnemonic{ name: "adrp", code: A64M_ADRP, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_ADRP,     words: 1 },

    iasm.Mnemonic{ name: "cmp", code: A64M_CMP, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_CMP, words: 1 },

    iasm.Mnemonic{ name: "blr",  code: A64M_BLR,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_CALLER_SAVED, flags: A64P_BR_REG, words: 1 },
    iasm.Mnemonic{ name: "bl",   code: A64M_BL,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_CALLER_SAVED, flags: A64P_BL,     words: 1 },
    iasm.Mnemonic{ name: "br",   code: A64M_BR,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_CALLER_SAVED, flags: A64P_BR_REG, words: 1 },
    iasm.Mnemonic{ name: "b",    code: A64M_B,    form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0,                flags: A64P_B,      words: 1 },
    iasm.Mnemonic{ name: "cbz",  code: A64M_CBZ,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0,                flags: A64P_CBR,    words: 1 },
    iasm.Mnemonic{ name: "cbnz", code: A64M_CBNZ, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0,                flags: A64P_CBR,    words: 1 },

    iasm.Mnemonic{ name: "ldrb", code: A64M_LDRB, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "strb", code: A64M_STRB, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "ldrh", code: A64M_LDRH, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "strh", code: A64M_STRH, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "ldr",  code: A64M_LDR,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "str",  code: A64M_STR,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDST, words: 1 },

    iasm.Mnemonic{ name: "ldp", code: A64M_LDP, form: iasm.AF_OPS, writes: iasm.AW_OP0 | iasm.AW_OP1 | iasm.AW_WB_BASE, implicit: 0, flags: A64P_LDSTP, words: 1 },
    iasm.Mnemonic{ name: "stp", code: A64M_STP, form: iasm.AF_OPS, writes: iasm.AW_WB_BASE,                             implicit: 0, flags: A64P_LDSTP, words: 1 },

    iasm.Mnemonic{ name: "ldaxr", code: A64M_LDAXR, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDORD, words: 1 },
    iasm.Mnemonic{ name: "ldar",  code: A64M_LDAR,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDORD, words: 1 },
    iasm.Mnemonic{ name: "stlxr", code: A64M_STLXR, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_STLXR, words: 1 },
    iasm.Mnemonic{ name: "stlr",  code: A64M_STLR,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDORD, words: 1 },
    iasm.Mnemonic{ name: "dmb",   code: A64M_DMB,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_DMB,   words: 1 },

    iasm.Mnemonic{ name: "lslv", code: A64M_LSLV, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "lsrv", code: A64M_LSRV, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "asrv", code: A64M_ASRV, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },

    iasm.Mnemonic{ name: "msr", code: A64M_MSR, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_MSR, words: 1 },
    iasm.Mnemonic{ name: "mrs", code: A64M_MRS, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_MRS, words: 1 },
    iasm.Mnemonic{ name: "lsl",  code: A64M_LSL,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "lsr",  code: A64M_LSR,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "asr",  code: A64M_ASR,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
};

fun a64_pattern(flags: u16) u16 { ret flags & 0x00FF; }

fun a64_cond(flags: u16) u32 { ret ((flags & A64F_COND_MASK) >> A64F_COND_SHIFT)::u32; }

fun a64_decode_bcond(body: str, lo: usize, hi: usize, m: *iasm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !iasm.is_space(body[end])) { end = end + 1; }
    val len: usize = end - lo;
    if (len < 4)                                  { ret false; }
    if (!str_region_equals(body, lo, 2, "b."))    { ret false; }

    var buf: [8]u8;
    if (!iasm.copy_region(body, lo + 2, end, ?buf[0], 8)) { ret false; }
    var cc: u32 = 0;
    if (!asm_parse_cond((?buf[0])::str, ?cc)) { ret false; }

    m.name     = nil;
    m.code     = A64M_B;
    m.form     = iasm.AF_OPS;
    m.writes   = iasm.AW_NONE;
    m.implicit = 0;
    m.flags    = A64P_BCOND | ((cc::u16 << A64F_COND_SHIFT) & A64F_COND_MASK);
    m.words    = 1;
    @n_out     = len;
    ret true;
}

fun a64_name_operand(pat: u16) u32 {
    if (pat == A64P_B || pat == A64P_BCOND || pat == A64P_DMB)  { ret 0; }
    if (pat == A64P_MSR)                                        { ret 0; }
    if (pat == A64P_CBR || pat == A64P_CSET || pat == A64P_MRS) { ret 1; }
    if (pat == A64P_MOVEWIDE)                                   { ret 2; }
    ret 0xFFFFFFFF;
}

fun a64_operand(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) R.Result[R.Void, str] {
    @op = iasm.op_none();
    if (hi <= lo) { ret R.err[R.Void, str]("encode: malformed inline-asm operand"); }

    if (c.body[lo] == '{'::char) {
        var off: i64 = 0;
        val bound_r: R.Result[bool, str] = iasm.bind_offset(c, lo, hi, ?off);
        if (R.is_err[bool, str](bound_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](bound_r)); }
        if (R.unwrap_ok[bool, str](bound_r)) {
            @op = iasm.op_mem(SP_REG::i32, off, -1, 0, 8);
            op.flags = iasm.AOF_HAS_DISP | iasm.AOF_STACK_PTR;
            ret R.ok_void[str]();
        }
        op.kind     = iasm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret R.ok_void[str]();
    }

    if (c.body[lo] == '['::char) { ret a64_mem(c, lo, hi, op); }
    if (c.body[lo] == ':'::char) { ret a64_modifier(c, lo, hi, op); }

    if (a64_reg_region(c.body, lo, hi, op)) { ret R.ok_void[str](); }

    val iv: O.Option[i64] = iasm.region_i64(c.body, lo, hi);
    if (O.is_some[i64](iv)) { @op = iasm.op_imm(O.unwrap[i64](iv), 8); ret R.ok_void[str](); }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: malformed inline-asm operand");
}

fun a64_reg_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "xzr")) { @op = iasm.op_reg(31, 8); ret true; }
    if (str_region_equals(body, lo, len, "wzr")) { @op = iasm.op_reg(31, 4); ret true; }
    if (str_region_equals(body, lo, len, "sp"))  { @op = iasm.op_reg(31, 8); op.flags = iasm.AOF_STACK_PTR; ret true; }
    if (str_region_equals(body, lo, len, "wsp")) { @op = iasm.op_reg(31, 4); op.flags = iasm.AOF_STACK_PTR; ret true; }

    if (len < 2 || len > 3) { ret false; }
    val c0: char = body[lo];
    if (c0 != 'x'::char && c0 != 'w'::char) { ret false; }
    var n: u32 = 0;
    var i: usize = lo + 1;
    for (i < hi) {
        if (!iasm.is_digit(body[i])) { ret false; }
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 30) { ret false; }
    var w: u8 = 4;
    if (c0 == 'x'::char) { w = 8; }
    @op = iasm.op_reg(n::i32, w);
    ret true;
}

fun a64_reg(name: str, op: *iasm.Operand) bool {
    ret a64_reg_region(name, 0, str_len(name), op);
}

fun a64_modifier(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) R.Result[R.Void, str] {
    var close: usize = lo + 1;
    var found: bool = false;
    for (close < hi && !found) {
        if (c.body[close] == ':'::char) { found = true; } or { close = close + 1; }
    }
    if (!found) { ret R.err[R.Void, str]("encode: malformed inline-asm relocation modifier"); }
    val nlen: usize = close - lo - 1;

    var mod: isa.SymModifier = isa.SYM_MOD_NONE;
    if (str_region_equals(c.body, lo + 1, nlen, "lo12"))      { mod = isa.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got"))       { mod = isa.SYM_MOD_GOT_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_lo12"))  { mod = isa.SYM_MOD_GOT_LO; }
    or {
        ret R.err[R.Void, str](iasm.span_message(c,
            "encode: unsupported aarch64 inline-asm relocation modifier '", lo, hi, "'",
            "encode: unsupported aarch64 inline-asm relocation modifier"));
    }
    if (!iasm.is_sym_region(c.body, close + 1, hi)) {
        ret R.err[R.Void, str]("encode: malformed inline-asm relocation modifier");
    }
    @op = iasm.op_sym(close + 1, hi - close - 1, mod, 8);
    ret R.ok_void[str]();
}

fun a64_mem(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) R.Result[R.Void, str] {
    @op = iasm.op_none();
    op.kind = iasm.AOP_MEM;
    op.size = 8;

    var end: usize = hi;
    if (c.body[end - 1] == '!'::char) { op.flags = op.flags | iasm.AOF_WRITEBACK; end = end - 1; }
    if (end < lo + 2 || c.body[end - 1] != ']'::char) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }

    val ilo: usize = lo + 1;
    val ihi: usize = end - 1;
    var comma: usize = ilo;
    var found: bool = false;
    for (comma < ihi && !found) {
        if (c.body[comma] == ','::char) { found = true; } or { comma = comma + 1; }
    }

    var bbuf: [24]u8;
    var bend: usize = ihi;
    if (found) { bend = comma; }
    if (!iasm.copy_region(c.body, ilo, bend, ?bbuf[0], 24)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
    var base: iasm.Operand = iasm.op_none();
    if (!a64_reg((?bbuf[0])::str, ?base)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
    op.reg   = base.reg;
    op.flags = op.flags | (base.flags & iasm.AOF_STACK_PTR);
    if (!found) { ret R.ok_void[str](); }

    var s: usize = comma + 1;
    var e: usize = ihi;
    for (s < e && iasm.is_space(c.body[s])) { s = s + 1; }
    for (e > s && iasm.is_space(c.body[e - 1])) { e = e - 1; }
    if (e <= s) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }

    if (c.body[s] == ':'::char) {
        var sym: iasm.Operand = iasm.op_none();
        val mr: R.Result[R.Void, str] = a64_modifier(c, s, e, ?sym);
        if (R.is_err[R.Void, str](mr)) { ret mr; }
        op.flags    = op.flags | iasm.AOF_MEM_SYM;
        op.mod      = sym.mod;
        op.name_off = sym.name_off;
        op.name_len = sym.name_len;
        ret R.ok_void[str]();
    }

    var ibuf: [24]u8;
    if (iasm.copy_region(c.body, s, e, ?ibuf[0], 24)) {
        var idx: iasm.Operand = iasm.op_none();
        if (a64_reg((?ibuf[0])::str, ?idx)) {
            if (a64_is_sp(?idx)) {
                ret R.err[R.Void, str]("encode: inline-asm memory index register has no sp form; register 31 there is always xzr");
            }
            op.flags = op.flags | iasm.AOF_HAS_INDEX;
            op.index = idx.reg;
            if (idx.size == 8) { op.flags = op.flags | iasm.AOF_WIDE; }
            ret R.ok_void[str]();
        }
    }
    val dv: O.Option[i64] = iasm.region_i64(c.body, s, e);
    if (!O.is_some[i64](dv)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
    op.imm   = O.unwrap[i64](dv);
    op.flags = op.flags | iasm.AOF_HAS_DISP;
    ret R.ok_void[str]();
}

fun a64_is_addr(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_MEM || op.kind == iasm.AOP_BIND;
}

fun a64_is64(op: *iasm.Operand) bool { ret op.size == 8; }

fun a64_is_sp(op: *iasm.Operand) bool { ret (op.flags & iasm.AOF_STACK_PTR) != 0; }

fun a64_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val pat: u16 = a64_pattern(s.m.flags);
    val n: u32 = s.nargs;
    val name_at: u32 = a64_name_operand(pat);

    var i: u32 = 0;
    for (i < n) {
        if (i != name_at) {
            val r: R.Result[R.Void, str] = a64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (R.is_err[R.Void, str](r)) { ret r; }
        }
        i = i + 1;
    }

    if (pat == A64P_NULLARY) {
        if (n != 0) { ret R.err[R.Void, str]("encode: inline-asm instruction takes no operands"); }
        ret R.ok_void[str]();
    }
    if (pat == A64P_RET_REG || pat == A64P_BR_REG) {
        if (n != 1)                            { ret R.err[R.Void, str]("encode: inline-asm instruction expects one register"); }
        if (item.ops[0].kind != iasm.AOP_REG)  { ret R.err[R.Void, str]("encode: inline-asm ret/blr/br operand must be a register"); }
        ret R.ok_void[str]();
    }
    if (pat == A64P_IMM16) {
        if (n != 1)                           { ret R.err[R.Void, str]("encode: inline-asm svc/brk needs an immediate"); }
        if (item.ops[0].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm svc/brk needs an immediate"); }
        if (item.ops[0].imm < 0 || item.ops[0].imm > 0xFFFF) {
            ret R.err[R.Void, str]("encode: inline-asm svc/brk immediate is out of 16-bit range");
        }
        ret R.ok_void[str]();
    }
    if (pat == A64P_MOV) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm 'mov' expects two operands"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'mov' destination must be a register"); }
        if (item.ops[1].kind == iasm.AOP_REG) {
            if (item.ops[0].size != item.ops[1].size) {
                ret R.err[R.Void, str]("encode: inline-asm 'mov' operands are different widths; aarch64 has one size flag for the whole instruction");
            }
            item.words = 1; ret R.ok_void[str]();
        }
        if (item.ops[1].kind == iasm.AOP_IMM) { ret R.ok_void[str](); }
        ret R.err[R.Void, str]("encode: inline-asm 'mov' source must be a register or immediate");
    }
    if (pat == A64P_MOVEWIDE) {
        if (n < 2 || n > 3)                   { ret R.err[R.Void, str]("encode: inline-asm movz/movk expects Rd, imm [, lsl N]"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm movz/movk destination must be a register"); }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm movz/movk needs an immediate"); }
        if (item.ops[1].imm < 0 || item.ops[1].imm > 0xFFFF) {
            ret R.err[R.Void, str]("encode: inline-asm movz/movk immediate is out of 16-bit range");
        }
        if (n == 3) { ret a64_shift_amount(c, s, item, 2); }
        ret R.ok_void[str]();
    }
    if (pat == A64P_ADDSUB || pat == A64P_LOGICAL || pat == A64P_SHIFT) {
        if (n != 3)                           { ret R.err[R.Void, str]("encode: inline-asm instruction expects three operands"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm destination must be a register"); }
        if (item.ops[1].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm first source must be a register"); }
        if (item.ops[0].size != item.ops[1].size) {
            ret R.err[R.Void, str]("encode: inline-asm operands are different widths; aarch64 has one size flag for the whole instruction");
        }
        if (pat == A64P_LOGICAL && item.ops[2].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm and/orr/eor immediate (bitmask) form unsupported; use a register operand");
        }
        if (pat == A64P_SHIFT && item.ops[2].kind != iasm.AOP_REG && item.ops[2].kind != iasm.AOP_IMM) {
            ret R.err[R.Void, str]("encode: inline-asm shift count must be a register or immediate");
        }
        if (item.ops[2].kind == iasm.AOP_REG && item.ops[0].size != item.ops[2].size) {
            ret R.err[R.Void, str]("encode: inline-asm operands are different widths; aarch64 has one size flag for the whole instruction");
        }
        ret R.ok_void[str]();
    }
    if (pat == A64P_CMP) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm 'cmp' expects two operands"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'cmp' first operand must be a register"); }
        if (item.ops[1].kind != iasm.AOP_REG && item.ops[1].kind != iasm.AOP_IMM) {
            ret R.err[R.Void, str]("encode: inline-asm 'cmp' second operand must be a register or imm12");
        }
        if (item.ops[1].kind == iasm.AOP_REG && item.ops[0].size != item.ops[1].size) {
            ret R.err[R.Void, str]("encode: inline-asm 'cmp' operands are different widths; aarch64 has one size flag for the whole instruction");
        }
        ret R.ok_void[str]();
    }
    if (pat == A64P_CSET) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm 'cset' expects Rd, cond"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'cset' destination must be a register"); }
        var buf: [8]u8;
        var cc: u32 = 0;
        if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?buf[0], 8) || !asm_parse_cond((?buf[0])::str, ?cc)) {
            ret R.err[R.Void, str]("encode: inline-asm 'cset' condition is unrecognized");
        }
        item.flags = item.flags | ((cc::u16 << A64F_COND_SHIFT) & A64F_COND_MASK);
        ret R.ok_void[str]();
    }
    if (pat == A64P_ADRP) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm 'adrp' expects Xd, symbol"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm 'adrp' destination must be a register"); }
        if (item.ops[1].kind != iasm.AOP_SYM) { ret R.err[R.Void, str]("encode: inline-asm 'adrp' target must be a symbol"); }
        ret R.ok_void[str]();
    }
    if (pat == A64P_BL) {
        if (n != 1)                           { ret R.err[R.Void, str]("encode: inline-asm 'bl' expects a symbol"); }
        if (item.ops[0].kind != iasm.AOP_SYM) { ret R.err[R.Void, str]("encode: inline-asm 'bl' target must be a symbol"); }
        ret R.ok_void[str]();
    }
    if (pat == A64P_B) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm 'b' expects a target"); }
        ret a64_branch_target(c, s, item, 0, true);
    }
    if (pat == A64P_BCOND) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm conditional branch expects a target"); }
        ret a64_branch_target(c, s, item, 0, false);
    }
    if (pat == A64P_CBR) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm cbz/cbnz expects Rt, target"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm cbz/cbnz first operand must be a register"); }
        ret a64_branch_target(c, s, item, 1, false);
    }
    if (pat == A64P_LDST) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm ldr/str expects Rt, [mem]"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm ldr/str value must be a register"); }
        if (!a64_is_addr(?item.ops[1]))       { ret R.err[R.Void, str]("encode: inline-asm ldr/str address must be a memory operand"); }
        if ((item.ops[1].flags & iasm.AOF_WRITEBACK) != 0) {
            ret R.err[R.Void, str]("encode: inline-asm ldr/str writeback addressing unsupported");
        }
        if ((item.ops[1].flags & iasm.AOF_HAS_DISP) != 0) { item.words = iasm.WORDS_VARIABLE; }
        ret R.ok_void[str]();
    }
    if (pat == A64P_LDSTP) {
        if (n < 3 || n > 4) { ret R.err[R.Void, str]("encode: inline-asm stp/ldp expects Xa, Xb, [mem] [, imm]"); }
        if (item.ops[0].kind != iasm.AOP_REG || !a64_is64(?item.ops[0])) { ret R.err[R.Void, str]("encode: inline-asm stp/ldp registers must be X registers"); }
        if (item.ops[1].kind != iasm.AOP_REG || !a64_is64(?item.ops[1])) { ret R.err[R.Void, str]("encode: inline-asm stp/ldp registers must be X registers"); }
        if (item.ops[2].kind != iasm.AOP_MEM)                            { ret R.err[R.Void, str]("encode: inline-asm stp/ldp address must be a memory operand"); }
        if ((item.ops[2].flags & (iasm.AOF_HAS_INDEX | iasm.AOF_MEM_SYM)) != 0) {
            ret R.err[R.Void, str]("encode: inline-asm stp/ldp address must be [Xn] or [Xn, imm]");
        }
        if (n == 4) {
            if ((item.ops[2].flags & (iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK)) != 0) {
                ret R.err[R.Void, str]("encode: inline-asm stp/ldp post-index base must be a bare [Xn]");
            }
            if (item.ops[3].kind != iasm.AOP_IMM) { ret R.err[R.Void, str]("encode: inline-asm stp/ldp post-index needs an immediate"); }
            item.ops[2].flags = item.ops[2].flags | iasm.AOF_WRITEBACK;
        }
        ret R.ok_void[str]();
    }
    if (pat == A64P_DMB) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm dmb expects one barrier option"); }
        var buf: [8]u8;
        var opt: u32 = 0;
        if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?buf[0], 8) || !asm_barrier_option((?buf[0])::str, ?opt)) {
            ret R.err[R.Void, str]("encode: unsupported inline-asm dmb barrier option");
        }
        item.ops[0] = iasm.op_imm(opt::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == A64P_MSR) {
        if (n != 2) { ret R.err[R.Void, str]("encode: inline-asm msr expects a system register or PSTATE field and a source"); }
        var nbuf: [A64_SYSREG_NAME_MAX]u8;
        if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?nbuf[0], A64_SYSREG_NAME_MAX)) {
            ret R.err[R.Void, str]("encode: inline-asm msr destination name is too long");
        }
        var op1: u32 = 0; var op2: u32 = 0;
        if (item.ops[1].kind == iasm.AOP_IMM) {
            if (!a64_pstate_field((?nbuf[0])::str, ?op1, ?op2)) {
                ret R.err[R.Void, str]("encode: unsupported inline-asm msr PSTATE field");
            }
            if (item.ops[1].imm < 0 || item.ops[1].imm > 15) {
                ret R.err[R.Void, str]("encode: inline-asm msr immediate must be 0-15");
            }
            item.ops[0] = iasm.op_imm(((op1 << 8) | op2)::i64, 1);
            ret R.ok_void[str]();
        }
        if (item.ops[1].kind != iasm.AOP_REG) {
            ret R.err[R.Void, str]("encode: inline-asm msr source must be an immediate or a register");
        }
        var op0: u32 = 0; var crn: u32 = 0; var crm: u32 = 0;
        if (!a64_sysreg((?nbuf[0])::str, ?op0, ?op1, ?crn, ?crm, ?op2)) {
            ret R.err[R.Void, str]("encode: unsupported inline-asm msr system register");
        }
        item.ops[0] = iasm.op_imm(a64_sysreg_pack(op0, op1, crn, crm, op2)::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == A64P_MRS) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm mrs expects Xt, <sysreg>"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm mrs destination must be a register"); }
        var mbuf: [A64_SYSREG_NAME_MAX]u8;
        if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?mbuf[0], A64_SYSREG_NAME_MAX)) {
            ret R.err[R.Void, str]("encode: inline-asm mrs system register name is too long");
        }
        var m0: u32 = 0; var m1: u32 = 0; var mn: u32 = 0; var mm: u32 = 0; var m2: u32 = 0;
        if (!a64_sysreg((?mbuf[0])::str, ?m0, ?m1, ?mn, ?mm, ?m2)) {
            ret R.err[R.Void, str]("encode: unsupported inline-asm mrs system register");
        }
        item.ops[1] = iasm.op_imm(a64_sysreg_pack(m0, m1, mn, mm, m2)::i64, 1);
        ret R.ok_void[str]();
    }
    if (pat == A64P_LDORD) {
        if (n != 2)                           { ret R.err[R.Void, str]("encode: inline-asm ldar/stlr/ldaxr expects Rt, [Xn]"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm ldar/stlr/ldaxr value must be a register"); }
        ret a64_bare_addr(?item.ops[1]);
    }
    if (pat == A64P_STLXR) {
        if (n != 3)                           { ret R.err[R.Void, str]("encode: inline-asm stlxr expects Ws, Rt, [Xn]"); }
        if (item.ops[0].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm stlxr status must be a register"); }
        if (item.ops[1].kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm stlxr value must be a register"); }
        ret a64_bare_addr(?item.ops[2]);
    }
    ret R.err[R.Void, str]("internal compiler error: inline-asm aarch64 form has no parser");
}

fun a64_bare_addr(op: *iasm.Operand) R.Result[R.Void, str] {
    if (op.kind != iasm.AOP_MEM) { ret R.err[R.Void, str]("encode: inline-asm ordered access address must be a memory operand"); }
    if ((op.flags & (iasm.AOF_HAS_INDEX | iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK | iasm.AOF_MEM_SYM)) != 0) {
        ret R.err[R.Void, str]("encode: inline-asm ordered access addressing must be a bare [Xn]");
    }
    ret R.ok_void[str]();
}

fun a64_shift_amount(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32) R.Result[R.Void, str] {
    var buf: [24]u8;
    var hw: u32 = 0;
    if (!iasm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 24)
        || !asm_parse_lsl_amount((?buf[0])::str, ?hw)) {
        ret R.err[R.Void, str]("encode: inline-asm movz/movk shift must be 'lsl N'");
    }
    if ((hw & 0xF) != 0) { ret R.err[R.Void, str]("encode: inline-asm movz/movk shift must be a multiple of 16"); }
    hw = hw / 16;
    if (a64_is64(?item.ops[0])) {
        if (hw > 3) { ret R.err[R.Void, str]("encode: inline-asm movz/movk 64-bit shift exceeds lsl 48"); }
    } or {
        if (hw > 1) { ret R.err[R.Void, str]("encode: inline-asm movz/movk 32-bit shift exceeds lsl 16"); }
    }
    item.ops[idx::usize] = iasm.op_imm(hw::i64, 1);
    ret R.ok_void[str]();
}

fun a64_branch_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32, allow_sym: bool) R.Result[R.Void, str] {
    val lo: usize = s.arg_lo[idx::usize];
    val hi: usize = s.arg_hi[idx::usize];
    var num: u64 = 0;
    var fwd: bool = false;
    if (iasm.label_ref_span(c.body, lo, hi, ?num, ?fwd)) {
        item.ref     = iasm.AR_LOCAL;
        item.ref_num = num;
        item.ref_fwd = fwd;
        ret R.ok_void[str]();
    }
    if (iasm.is_digit(c.body[lo])) {
        ret R.err[R.Void, str]("encode: inline-asm numeric local-label reference must be 'Nf' or 'Nb'");
    }
    if (!allow_sym) {
        ret R.err[R.Void, str]("encode: inline-asm conditional branch to a symbol is unsupported (no imm19 relocation kind); branch to a numeric local label instead");
    }
    if (!iasm.is_sym_region(c.body, lo, hi)) {
        ret R.err[R.Void, str]("encode: inline-asm 'b' target must be a symbol or a numeric local label");
    }
    item.ref     = iasm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret R.ok_void[str]();
}

fun a64_emit(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) R.Result[R.Void, str] {
    val pat: u16 = a64_pattern(item.flags);

    if (pat == A64P_NULLARY) {
        if (item.code == A64M_NOP)   { emit_nullary(st, NOP_WORD);   ret R.ok_void[str](); }
        if (item.code == A64M_YIELD) { emit_nullary(st, YIELD_WORD); ret R.ok_void[str](); }
        if (item.code == A64M_WFE)   { emit_nullary(st, WFE_WORD);   ret R.ok_void[str](); }
        if (item.code == A64M_WFI)   { emit_nullary(st, WFI_WORD);   ret R.ok_void[str](); }
        emit_nullary(st, RET_WORD);
        ret R.ok_void[str]();
    }
    if (pat == A64P_RET_REG) { emit_branch_reg(st, RET_BASE, item.ops[0].reg::u32); ret R.ok_void[str](); }
    if (pat == A64P_BR_REG) {
        var base: u32 = BR_BASE;
        if (item.code == A64M_BLR) { base = BLR_BASE; }
        emit_branch_reg(st, base, item.ops[0].reg::u32);
        ret R.ok_void[str]();
    }
    if (pat == A64P_IMM16) {
        var base: u32 = BRK_BASE;
        if (item.code == A64M_SVC) { base = SVC_BASE; }
        or (item.code == A64M_HVC) { base = HVC_BASE; }
        or (item.code == A64M_SMC) { base = SMC_BASE; }
        emit_imm16(st, base, item.ops[0].imm::u32);
        ret R.ok_void[str]();
    }
    if (pat == A64P_MOV)      { ret a64_emit_mov(st, item); }
    if (pat == A64P_MOVEWIDE) { ret a64_emit_movewide(st, item); }
    if (pat == A64P_ADDSUB)   { ret a64_emit_addsub(st, c, item); }
    if (pat == A64P_LOGICAL)  { ret a64_emit_logical(st, item); }
    if (pat == A64P_CMP)      { ret a64_emit_cmp(st, item); }
    if (pat == A64P_CSET) {
        val use64: bool = a64_is64(?item.ops[0]);
        emit_cset(st, sel(use64, CSINC_X, CSINC_W), item.ops[0].reg::u32, a64_cond(item.flags));
        ret R.ok_void[str]();
    }
    if (pat == A64P_ADRP)  { ret a64_emit_adrp(st, c, item); }
    if (pat == A64P_BL)    { ret a64_emit_call(st, c, item); }
    if (pat == A64P_B || pat == A64P_BCOND || pat == A64P_CBR) { ret a64_emit_branch(st, c, l, item); }
    if (pat == A64P_LDST)  { ret a64_emit_ldst(st, c, item); }
    if (pat == A64P_LDSTP) { ret a64_emit_ldstp(st, item); }
    if (pat == A64P_DMB)   { emit_barrier(st, item.ops[0].imm::u32); ret R.ok_void[str](); }
    if (pat == A64P_MSR) {
        if (item.ops[1].kind == iasm.AOP_IMM) {
            val f: u32 = item.ops[0].imm::u32;
            emit_msr_imm(st, (f >> 8) & 0x7, f & 0x7, item.ops[1].imm::u32);
            ret R.ok_void[str]();
        }
        a64_emit_sysreg(st, MSR_REG_BASE, item.ops[0].imm::u32, item.ops[1].reg::u32);
        ret R.ok_void[str]();
    }
    if (pat == A64P_MRS) {
        a64_emit_sysreg(st, MRS_BASE, item.ops[1].imm::u32, item.ops[0].reg::u32);
        ret R.ok_void[str]();
    }
    if (pat == A64P_LDORD) { ret a64_emit_ldord(st, item); }
    if (pat == A64P_STLXR) {
        val base: u32 = sel(a64_is64(?item.ops[1]), STLXR_X, STLXR_W);
        emit_stxr(st, base, item.ops[0].reg::u32, item.ops[1].reg::u32, item.ops[2].reg::u32);
        ret R.ok_void[str]();
    }
    if (pat == A64P_SHIFT) { ret a64_emit_shift(st, item); }
    ret R.err[R.Void, str]("internal compiler error: inline-asm aarch64 form has no emitter");
}

fun a64_emit_mov(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    val dst: *iasm.Operand = ?item.ops[0];
    val src: *iasm.Operand = ?item.ops[1];
    val use64: bool = a64_is64(dst);
    if (src.kind == iasm.AOP_REG) {
        if (a64_is_sp(dst) || a64_is_sp(src)) {
            emit_addsub_imm(st, sel(use64, ADDI_X, ADDI_W), dst.reg::u32, src.reg::u32, 0, 0);
        } or {
            emit_alu3(st, sel(use64, ORR_X, ORR_W), dst.reg::u32, ZR, src.reg::u32);
        }
        ret R.ok_void[str]();
    }
    emit_asm_mov_imm(st, dst.reg::u32, src.imm::u64, use64);
    ret R.ok_void[str]();
}

fun a64_emit_movewide(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    val use64: bool = a64_is64(?item.ops[0]);
    var hw: u32 = 0;
    if (item.nops == 3) { hw = item.ops[2].imm::u32; }
    var base: u32 = sel(use64, MOVZ_X, MOVZ_W);
    if (item.code == A64M_MOVK) { base = sel(use64, MOVK_X, MOVK_W); }
    emit_movewide(st, base, item.ops[0].reg::u32, hw, item.ops[1].imm::u32);
    ret R.ok_void[str]();
}

fun a64_emit_addsub(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) R.Result[R.Void, str] {
    val rd: *iasm.Operand = ?item.ops[0];
    val rn: *iasm.Operand = ?item.ops[1];
    val op3: *iasm.Operand = ?item.ops[2];
    val use64: bool = a64_is64(rd);
    val is_sub: bool = item.code == A64M_SUB;

    if (op3.kind == iasm.AOP_IMM) {
        var base: u32 = sel(use64, ADDI_X, ADDI_W);
        if (is_sub) { base = sel(use64, SUBI_X, SUBI_W); }
        val v: i64 = op3.imm;
        if (v >= 0 && v <= 4095) {
            emit_addsub_imm(st, base, rd.reg::u32, rn.reg::u32, v::u32, 0);
            ret R.ok_void[str]();
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            emit_addsub_imm(st, base, rd.reg::u32, rn.reg::u32, (v >> 12)::u32, 1);
            ret R.ok_void[str]();
        }
        ret R.err[R.Void, str]("encode: inline-asm add/sub immediate is out of imm12 range");
    }
    if (op3.kind == iasm.AOP_SYM) {
        if (is_sub)                            { ret R.err[R.Void, str]("encode: inline-asm 'sub' has no :lo12: form"); }
        if (op3.mod != isa.SYM_MOD_PCREL_LO)   { ret R.err[R.Void, str]("encode: inline-asm 'add' symbol operand must be a ':lo12:sym'"); }
        val sr: R.Result[intern.StrId, str] = a64_intern(st, c, op3);
        if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
        val sid: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
        val pos: u32 = st.buf.len::u32;
        emit_addsub_imm_sym(st, sel(use64, ADDI_X, ADDI_W), rd.reg::u32, rn.reg::u32, sid, printer.MOD_PCREL_LO, 0);
        ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_ADD_LO12, sid, 0);
    }
    if (a64_is_sp(rd) || a64_is_sp(rn) || a64_is_sp(op3)) {
        ret R.err[R.Void, str]("encode: inline-asm add/sub with SP and a register operand requires the extended-register form (unsupported)");
    }
    var base_r: u32 = sel(use64, ADD_X, ADD_W);
    if (is_sub) { base_r = sel(use64, SUB_X, SUB_W); }
    emit_alu3(st, base_r, rd.reg::u32, rn.reg::u32, op3.reg::u32);
    ret R.ok_void[str]();
}

fun a64_emit_logical(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    if (a64_is_sp(?item.ops[0]) || a64_is_sp(?item.ops[1]) || a64_is_sp(?item.ops[2])) {
        ret R.err[R.Void, str]("encode: inline-asm logical (shifted register) has no sp operand form; register 31 there is always xzr");
    }
    val use64: bool = a64_is64(?item.ops[0]);
    var bx: u32 = AND_X;
    var bw: u32 = AND_W;
    if (item.code == A64M_ORR)      { bx = ORR_X; bw = ORR_W; }
    or (item.code == A64M_EOR)      { bx = EOR_X; bw = EOR_W; }
    emit_alu3(st, sel(use64, bx, bw), item.ops[0].reg::u32, item.ops[1].reg::u32, item.ops[2].reg::u32);
    ret R.ok_void[str]();
}

fun a64_emit_cmp(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    val rn: *iasm.Operand = ?item.ops[0];
    val op2: *iasm.Operand = ?item.ops[1];
    val use64: bool = a64_is64(rn);
    if (op2.kind == iasm.AOP_IMM) {
        if (op2.imm < 0 || op2.imm > 4095) { ret R.err[R.Void, str]("encode: inline-asm 'cmp' second operand must be a register or imm12"); }
        emit_addsub_imm(st, sel(use64, SUBS_IMM_X, SUBS_IMM_W), ZR, rn.reg::u32, op2.imm::u32, 0);
        ret R.ok_void[str]();
    }
    if (a64_is_sp(rn) || a64_is_sp(op2)) {
        ret R.err[R.Void, str]("encode: inline-asm 'cmp' with sp and a register operand requires the extended-register form (unsupported)");
    }
    emit_alu3(st, sel(use64, SUBS_REG_X, SUBS_REG_W), ZR, rn.reg::u32, op2.reg::u32);
    ret R.ok_void[str]();
}

fun a64_emit_adrp(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) R.Result[R.Void, str] {
    val sym: *iasm.Operand = ?item.ops[1];
    if (sym.mod == isa.SYM_MOD_PCREL_LO || sym.mod == isa.SYM_MOD_GOT_LO) {
        ret R.err[R.Void, str]("encode: inline-asm 'adrp' names a page, so its symbol takes no low-half modifier");
    }
    val sr: R.Result[intern.StrId, str] = a64_intern(st, c, sym);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sid: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
    if (sym.mod == isa.SYM_MOD_GOT_HI) { ret emit_adrp_got_reloc(st, item.ops[0].reg::u32, sid); }
    ret emit_adrp_reloc(st, item.ops[0].reg::u32, sid, 0);
}

fun a64_emit_call(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) R.Result[R.Void, str] {
    val sr: R.Result[intern.StrId, str] = a64_intern(st, c, ?item.ops[0]);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
    val sid: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
    val pos: u32 = st.buf.len::u32;
    emit_branch_sym(st, BL_BASE, sid, 0);
    ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PLT32, sid, 0);
}

fun a64_emit_branch(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) R.Result[R.Void, str] {
    val pat: u16 = a64_pattern(item.flags);

    if (item.ref == iasm.AR_SYM) {
        val name: str = (c.body::usize + item.ref_off)::str;
        val sr: R.Result[intern.StrId, str] = intern.intern_bytes(st.interner, name, item.ref_len);
        if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
        val sid: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
        val pos: u32 = st.buf.len::u32;
        emit_branch_sym(st, B_BASE, sid, 0);
        ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_JUMP26, sid, 0);
    }

    var base: u32 = B_BASE;
    var word: u32 = B_BASE;
    var rt: u32 = 0;
    var has_rt: bool = false;
    if (pat == A64P_BCOND) {
        base = BCOND | (a64_cond(item.flags) & 0xF);
        word = base;
    }
    or (pat == A64P_CBR) {
        val use64: bool = a64_is64(?item.ops[0]);
        base = sel(use64, CBZ_X, CBZ_W);
        if (item.code == A64M_CBNZ) { base = sel(use64, CBNZ_X, CBNZ_W); }
        rt     = item.ops[0].reg::u32;
        has_rt = true;
        word   = pack_cbnz(base, rt);
    }

    val pos: u32 = st.buf.len::u32;
    emit_branch_local(st, word, base, rt, has_rt, item.ref_num, item.ref_fwd);
    ret iasm.resolve_local(st, c.g, l, pos, item.ref_num, item.ref_fwd);
}

fun a64_emit_ldst(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) R.Result[R.Void, str] {
    val rt: *iasm.Operand = ?item.ops[0];
    val mem: *iasm.Operand = ?item.ops[1];
    val is_load: bool = item.code == A64M_LDR || item.code == A64M_LDRB || item.code == A64M_LDRH;
    var w: u8 = 4;
    if (a64_is64(rt))                                          { w = 8; }
    if (item.code == A64M_LDRB || item.code == A64M_STRB)      { w = 1; }
    or (item.code == A64M_LDRH || item.code == A64M_STRH)      { w = 2; }

    val fr: R.Result[A64Access, str] = int_access(w, is_load);
    if (R.is_err[A64Access, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[A64Access, str](fr)); }
    val acf: A64Access = R.unwrap_ok[A64Access, str](fr);

    if ((mem.flags & iasm.AOF_MEM_SYM) != 0) {
        if (mem.mod != isa.SYM_MOD_PCREL_LO && mem.mod != isa.SYM_MOD_GOT_LO) {
            ret R.err[R.Void, str]("encode: inline-asm ldr/str symbol offset must be a ':lo12:sym' or ':got_lo12:sym'");
        }
        val sr: R.Result[intern.StrId, str] = a64_intern(st, c, mem);
        if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }
        val sid: intern.StrId = R.unwrap_ok[intern.StrId, str](sr);
        val pos: u32 = st.buf.len::u32;
        if (mem.mod == isa.SYM_MOD_GOT_LO) {
            if (!is_load || w != 8) { ret R.err[R.Void, str]("encode: inline-asm ':got_lo12:' offset takes a 64-bit load"); }
            emit_ldst_sym(st, LDR_OFF_X, rt.reg::u32, mem.reg::u32, sid, printer.MOD_GOT_LO, 0);
            ret encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_LO12, sid, 0);
        }
        emit_ldst_sym(st, acf.scaled, rt.reg::u32, mem.reg::u32, sid, printer.MOD_PCREL_LO, 0);
        ret encode.push_reloc(st, arm64_reloc_offset(pos), acf.lo12, sid, 0);
    }
    if ((mem.flags & iasm.AOF_HAS_INDEX) != 0) {
        emit_ldst_reg(st, acf.reg, rt.reg::u32, mem.reg::u32, mem.index::u32);
        ret R.ok_void[str]();
    }
    val no_scratch_r: R.Result[bool, str] = mem_access_needs_no_scratch(mem.imm, w);
    if (R.is_err[bool, str](no_scratch_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](no_scratch_r)); }
    if (!R.unwrap_ok[bool, str](no_scratch_r)) {
        ret R.err[R.Void, str](a64_offset_message(c, mem.imm));
    }
    ret emit_mem_access(st, rt.reg::u32, mem.reg::u32, mem.imm, w, is_load);
}

fun a64_offset_message(c: *iasm.Cursor, off: i64) str {
    if (c.interner == nil) {
        ret "encode: inline-asm ldr/str offset is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first";
    }
    var buf: [24]u8;
    var v: i64 = off;
    if (v < 0) { v = 0 - v; }
    val n: usize = u64_to_dec(v::u64, ?buf[0]);
    buf[n] = 0;
    ret iasm.named_message(c.alloc, c.interner,
        "encode: inline-asm ldr/str offset ", (?buf[0])::str,
        " is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first",
        "encode: inline-asm ldr/str offset is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first");
}

fun a64_emit_ldstp(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    val mem: *iasm.Operand = ?item.ops[2];
    val is_load: bool = item.code == A64M_LDP;
    var disp: i64 = 0;
    var base_word: u32 = sel(is_load, LDP_OFF_X, STP_OFF_X);
    if (item.nops == 4) {
        disp      = item.ops[3].imm;
        base_word = sel(is_load, LDP_POST_X, STP_POST_X);
    } or {
        disp = mem.imm;
        if ((mem.flags & iasm.AOF_WRITEBACK) != 0) { base_word = sel(is_load, LDP_PRE_X, STP_PRE_X); }
    }
    if ((disp & 7) != 0)   { ret R.err[R.Void, str]("encode: inline-asm stp/ldp offset must be a multiple of 8"); }
    val q: i64 = disp / 8;
    if (q < -64 || q > 63) { ret R.err[R.Void, str]("encode: inline-asm stp/ldp offset is out of the imm7 range"); }
    emit_ldstp(st, base_word, item.ops[0].reg::u32, item.ops[1].reg::u32, mem.reg::u32, q::u32 & 0x7F);
    ret R.ok_void[str]();
}

fun a64_emit_ldord(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    val use64: bool = a64_is64(?item.ops[0]);
    var base: u32 = sel(use64, LDAXR_X, LDAXR_W);
    if (item.code == A64M_LDAR)      { base = sel(use64, LDAR_X, LDAR_W); }
    or (item.code == A64M_STLR)      { base = sel(use64, STLR_X, STLR_W); }
    emit_ldst(st, base, item.ops[0].reg::u32, item.ops[1].reg::u32, 0);
    ret R.ok_void[str]();
}

fun a64_emit_shift(st: *encode.EncodeState, item: *iasm.Item) R.Result[R.Void, str] {
    val rd: *iasm.Operand = ?item.ops[0];
    val rn: *iasm.Operand = ?item.ops[1];
    val cnt: *iasm.Operand = ?item.ops[2];
    if (a64_is_sp(rd) || a64_is_sp(rn) || (cnt.kind == iasm.AOP_REG && a64_is_sp(cnt))) {
        ret R.err[R.Void, str]("encode: inline-asm shift has no sp operand form; register 31 there is always xzr");
    }
    val use64: bool = a64_is64(rd);
    var width: u32 = 32;
    if (use64) { width = 64; }

    val vform: bool = item.code == A64M_LSLV || item.code == A64M_LSRV || item.code == A64M_ASRV;
    val is_lsr: bool = item.code == A64M_LSR || item.code == A64M_LSRV;
    val is_asr: bool = item.code == A64M_ASR || item.code == A64M_ASRV;

    if (cnt.kind == iasm.AOP_IMM && !vform) {
        val sh: u32 = cnt.imm::u32 & (width - 1);
        if (is_asr) {
            emit_bitfield(st, sel(use64, SBFM_X, SBFM_W), rd.reg::u32, rn.reg::u32, sh, width - 1);
        } or (is_lsr) {
            emit_bitfield(st, sel(use64, UBFM_X, UBFM_W), rd.reg::u32, rn.reg::u32, sh, width - 1);
        } or {
            val immr: u32 = (width - sh) & (width - 1);
            val imms: u32 = (width - 1) - sh;
            emit_bitfield(st, sel(use64, UBFM_X, UBFM_W), rd.reg::u32, rn.reg::u32, immr, imms);
        }
        ret R.ok_void[str]();
    }
    if (cnt.kind != iasm.AOP_REG) { ret R.err[R.Void, str]("encode: inline-asm shift count must be a register or immediate"); }
    var bx: u32 = LSLV_X;
    var bw: u32 = LSLV_W;
    if (is_lsr)      { bx = LSRV_X; bw = LSRV_W; }
    or (is_asr)      { bx = ASRV_X; bw = ASRV_W; }
    emit_alu3(st, sel(use64, bx, bw), rd.reg::u32, rn.reg::u32, cnt.reg::u32);
    ret R.ok_void[str]();
}

fun a64_intern(st: *encode.EncodeState, c: *iasm.Cursor, op: *iasm.Operand) R.Result[intern.StrId, str] {
    ret intern.intern_bytes(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
}

fun a64_patch(st: *encode.EncodeState, patch_pos: u32, target_off: u32) R.Result[R.Void, str] {
    var fx: encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret patch_branch_arm64(st, ?fx, target_off);
}

fun a64_slot_from_sp(f: *mir.MirFunction) bool { ret true; }

fun a64_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << SP_REG)) != 0; }
        ret true;
    }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && a64_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && a64_is_sp(?item.ops[1])) { ret true; }
    if ((item.writes & iasm.AW_WB_BASE) != 0) {
        var i: u32 = 0;
        for (i < item.nops) {
            val op: *iasm.Operand = ?item.ops[i::usize];
            if (op.kind == iasm.AOP_MEM && (op.flags & iasm.AOF_WRITEBACK) != 0 && a64_is_sp(op)) {
                ret true;
            }
            i = i + 1;
        }
    }
    ret false;
}

fun a64_grammar() iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = "aarch64";
    g.unknown    = "unknown aarch64 inline-asm instruction '";
    g.rows       = ?A64_MNEMONICS[0];
    g.row_count  = A64_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD32[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = a64_decode_bcond;
    g.parse      = a64_parse;
    g.emit       = a64_emit;
    g.patch      = a64_patch;
    g.slot       = asm_slot_offset;
    g.slot_sp    = a64_slot_from_sp;
    g.writes_sp  = a64_writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = a64_decl_reg;
    g.no_fall    = a64_no_fall;
    ret g;
}

fun a64_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == A64M_BRK;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.returns(?g, body);
}

fun a64_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: iasm.Operand = iasm.op_none();
    if (a64_reg(name, ?op) && op.size == 8 && op.reg >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = op.reg::u32;
        ret true;
    }
    var n: u32 = 0;
    if (a64_vec_index(name, ?n)) {
        @bank = iasm.ABANK_FP;
        @idx  = n;
        ret true;
    }
    ret false;
}

fun a64_vec_index(name: str, out: *u32) bool {
    val len: usize = str_len(name);
    if (len < 2 || len > 3)       { ret false; }
    if (name[0] != 'v'::char)     { ret false; }
    var n: u32 = 0;
    var i: usize = 1;
    for (i < len) {
        if (!iasm.is_digit(name[i])) { ret false; }
        n = n * 10 + (name[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    @out = n;
    ret true;
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = a64_grammar();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block_arm64(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.encode_block(st, ?g, f, mi);
}

fun a64_asm_text(st: *encode.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) R.Result[R.Void, str] {
    var g: iasm.Grammar = a64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

var t_model_arm64: isa.MachineModel;
fun arm64_machine() *isa.MachineModel {
    t_model_arm64.pointer_width = 8;
    t_model_arm64.gpr_width     = 8;
    t_model_arm64.max_alu_width = 8;
    t_model_arm64.alu_min_width = 4;
    t_model_arm64.spill_width   = 8;
    t_model_arm64.flen_bits     = 64;
    ret ?t_model_arm64;
}

fun tbuf(st: *encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    encode.state_blank(st, alloc, arm64_machine());
}

fun tbuf_interned(st: *encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    encode.state_blank(st, alloc, arm64_machine());
    st.interner = itn;
}

fun tvec(n: i32) mir.MirOperand {
    ret mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_XMM, n)::u32);
}

test "mach.lang.target.isa.arm64.encode:three_address_alu_register_forms" {
    var bad: i32 = 0;
    if (pack_alu3(ADD_X, 0, 1, 2) != 0x8B020020) { bad = 1; }
    if (pack_alu3(ADD_W, 0, 1, 2) != 0x0B020020) { bad = 1; }
    if (pack_alu3(SUB_X, 0, 1, 2) != 0xCB020020) { bad = 1; }
    if (pack_alu3(SUB_W, 0, 1, 2) != 0x4B020020) { bad = 1; }
    if (pack_alu3(MUL_X, 0, 1, 2) != 0x9B027C20) { bad = 1; }
    if (pack_alu3(MUL_W, 0, 1, 2) != 0x1B027C20) { bad = 1; }
    if (pack_alu3(AND_X, 0, 1, 2) != 0x8A020020) { bad = 1; }
    if (pack_alu3(ORR_X, 0, 1, 2) != 0xAA020020) { bad = 1; }
    if (pack_alu3(EOR_X, 0, 1, 2) != 0xCA020020) { bad = 1; }
    if (pack_alu3(AND_W, 0, 1, 2) != 0x0A020020) { bad = 1; }
    if (pack_alu3(ORR_W, 0, 1, 2) != 0x2A020020) { bad = 1; }
    if (pack_alu3(EOR_W, 0, 1, 2) != 0x4A020020) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:register_shifts" {
    var bad: i32 = 0;
    if (pack_alu3(LSLV_X, 0, 1, 2) != 0x9AC22020) { bad = 1; }
    if (pack_alu3(LSLV_W, 0, 1, 2) != 0x1AC22020) { bad = 1; }
    if (pack_alu3(LSRV_X, 0, 1, 2) != 0x9AC22420) { bad = 1; }
    if (pack_alu3(LSRV_W, 0, 1, 2) != 0x1AC22420) { bad = 1; }
    if (pack_alu3(ASRV_X, 0, 1, 2) != 0x9AC22820) { bad = 1; }
    if (pack_alu3(ASRV_W, 0, 1, 2) != 0x1AC22820) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:immediate_shifts" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(0);
    ops[1] = mir.op_preg(1);
    ops[2] = mir.op_imm(3);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 0, 0, 0);
    mi.operand_count = 3;

    mi.width = 8; encode_shift(?st, ?mi, arm64.LSL::u32);
    if (read_word(?st.buf, 0) != 0xD37DF020) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, arm64.LSL::u32);
    if (read_word(?st.buf, 4) != 0x531D7020) { bad = 1; }
    mi.width = 8; encode_shift(?st, ?mi, arm64.LSR::u32);
    if (read_word(?st.buf, 8) != 0xD343FC20) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, arm64.LSR::u32);
    if (read_word(?st.buf, 12) != 0x53037C20) { bad = 1; }
    mi.width = 8; encode_shift(?st, ?mi, arm64.ASR::u32);
    if (read_word(?st.buf, 16) != 0x9343FC20) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, arm64.ASR::u32);
    if (read_word(?st.buf, 20) != 0x13037C20) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neg_mvn_mov_register_forms" {
    var bad: i32 = 0;
    if (pack_alu3(SUB_X, 0, ZR, 1) != 0xCB0103E0) { bad = 1; }
    if (pack_alu3(SUB_W, 0, ZR, 1) != 0x4B0103E0) { bad = 1; }
    if (pack_alu3(ORN_X, 0, ZR, 1) != 0xAA2103E0) { bad = 1; }
    if (pack_alu3(ORN_W, 0, ZR, 1) != 0x2A2103E0) { bad = 1; }
    if (pack_alu3(ORR_X, 0, ZR, 1) != 0xAA0103E0) { bad = 1; }
    if (pack_alu3(ORR_W, 0, ZR, 1) != 0x2A0103E0) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:movz_movk_materialization" {
    var bad: i32 = 0;
    if (pack_movewide(MOVZ_X, 0, 0, 0x1234) != 0xD2824680) { bad = 1; }
    if (pack_movewide(MOVZ_X, 0, 1, 0x1234) != 0xD2A24680) { bad = 1; }
    if (pack_movewide(MOVZ_X, 0, 2, 0x1234) != 0xD2C24680) { bad = 1; }
    if (pack_movewide(MOVZ_X, 0, 3, 0x1234) != 0xD2E24680) { bad = 1; }
    if (pack_movewide(MOVK_X, 0, 0, 0x5678) != 0xF28ACF00) { bad = 1; }
    if (pack_movewide(MOVK_X, 0, 1, 0x5678) != 0xF2AACF00) { bad = 1; }
    if (pack_movewide(MOVZ_W, 0, 0, 0x1234) != 0x52824680) { bad = 1; }
    if (pack_movewide(MOVK_W, 0, 1, 0x5678) != 0x72AACF00) { bad = 1; }

    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    emit_movewide_seq(?st, 0, 0x12345678, false);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != pack_movewide(MOVZ_W, 0, 0, 0x5678)) { bad = 1; }
        if (read_word(?st.buf, 4) != pack_movewide(MOVK_W, 0, 1, 0x1234)) { bad = 1; }
    }
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:add_sub_immediate_forms" {
    var bad: i32 = 0;
    if (pack_addsub_imm(ADDI_X, 0, 1, 5, 0) != 0x91001420) { bad = 1; }
    if (pack_addsub_imm(SUBI_X, 0, 1, 5, 0) != 0xD1001420) { bad = 1; }
    if (pack_addsub_imm(ADDI_W, 0, 1, 5, 0) != 0x11001420) { bad = 1; }
    if (pack_addsub_imm(SUBI_W, 0, 1, 5, 0) != 0x51001420) { bad = 1; }
    if (pack_addsub_imm(ADDI_X, 0, 1, 5, 1) != 0x91401420) { bad = 1; }
    if (pack_addsub_imm(ADDI_W, 0, 1, 5, 1) != 0x11401420) { bad = 1; }
    if (pack_addsub_imm(ADDI_X, ZR, ZR, 16, 0) != 0x910043FF) { bad = 1; }
    if (pack_addsub_imm(SUBI_X, ZR, ZR, 16, 0) != 0xD10043FF) { bad = 1; }
    if (pack_addsub_imm(ADDI_X, 29, ZR, 0, 0) != 0x910003FD)  { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:cmp_plus_cset" {
    var bad: i32 = 0;
    if (pack_cmp_reg(SUBS_REG_X, 0, 1) != 0xEB01001F) { bad = 1; }
    if (pack_cmp_reg(SUBS_REG_W, 0, 1) != 0x6B01001F) { bad = 1; }
    if (pack_cmp_imm(SUBS_IMM_X, 0, 5) != 0xF100141F) { bad = 1; }
    if (pack_cmp_imm(SUBS_IMM_W, 0, 5) != 0x7100141F) { bad = 1; }
    if (pack_cset(CSINC_W, 0, CC_EQ) != 0x1A9F17E0) { bad = 1; }
    if (pack_cset(CSINC_W, 0, CC_NE) != 0x1A9F07E0) { bad = 1; }
    if (pack_cset(CSINC_W, 0, CC_LT) != 0x1A9FA7E0) { bad = 1; }
    if (pack_cset(CSINC_W, 0, CC_LE) != 0x1A9FC7E0) { bad = 1; }
    if (pack_cset(CSINC_W, 0, CC_CC) != 0x1A9F27E0) { bad = 1; }
    if (pack_cset(CSINC_W, 0, CC_LS) != 0x1A9F87E0) { bad = 1; }
    if (pack_cset(CSINC_X, 0, CC_EQ) != 0x9A9F17E0) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:compare_with_an_immediate_lhs_materializes" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(0);
    ops[1] = mir.op_imm(48);
    ops[2] = mir.op_preg(1);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    mi.opcode = mir.MIR_SEL_CMP_LE_U; mi.width = 1;

    val r: R.Result[R.Void, str] = encode_compare(?st, ?mi);
    if (R.is_err[R.Void, str](r)) { bad = 1; }
    if (read_word(?st.buf, 0)  != 0x52800611) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x53001E31) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x53001C30) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x6B10023F) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x1A9F87E0) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:sdiv_udiv_msub_plus_divide_trap_packers" {
    var bad: i32 = 0;
    if (pack_alu3(SDIV_W, 0, 1, 2) != 0x1AC20C20) { bad = 1; }
    if (pack_alu3(SDIV_X, 0, 1, 2) != 0x9AC20C20) { bad = 1; }
    if (pack_alu3(UDIV_W, 0, 1, 2) != 0x1AC20820) { bad = 1; }
    if (pack_alu3(UDIV_X, 0, 1, 2) != 0x9AC20820) { bad = 1; }
    if (pack_madd(MSUB_W, 0, 16, 2, 1) != 0x1B028600) { bad = 1; }
    if (pack_madd(MSUB_X, 0, 16, 2, 1) != 0x9B028600) { bad = 1; }
    if (pack_cbnz_off(CBNZ_W, 2, 2) != 0x35000042) { bad = 1; }
    if (pack_cbnz_off(CBNZ_X, 2, 2) != 0xB5000042) { bad = 1; }
    if (pack_addsub_imm(ADDS_IMM_W, ZR, 2, 1, 0) != 0x3100045F) { bad = 1; }
    if (pack_addsub_imm(ADDS_IMM_X, ZR, 2, 1, 0) != 0xB100045F) { bad = 1; }
    if (pack_bcond(5, CC_NE) != 0x540000A1) { bad = 1; }
    if (pack_bcond(2, CC_NE) != 0x54000041) { bad = 1; }
    if (pack_movewide(MOVZ_W, 17, 1, 0x8000) != 0x52B00011) { bad = 1; }
    if (pack_movewide(MOVZ_X, 17, 3, 0x8000) != 0xD2F00011) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:unsigned_divide_plus_div_by_zero_trap" {
    var bad: i32 = 0;
