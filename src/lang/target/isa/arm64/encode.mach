test "mach.lang.target.isa.arm64.encode:inline_asm_cset_forms" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "cset x9, cs");
    a64_asm_text(?st, ?f, ?labels, "cset w9, cs");
    a64_asm_text(?st, ?f, ?labels, "cset x0, eq");
    a64_asm_text(?st, ?f, ?labels, "cset w0, eq");
    a64_asm_text(?st, ?f, ?labels, "cset x5, ne");
    a64_asm_text(?st, ?f, ?labels, "cset w5, ne");
    a64_asm_text(?st, ?f, ?labels, "cset x9, lt");
    a64_asm_text(?st, ?f, ?labels, "cset w19, le");
    a64_asm_text(?st, ?f, ?labels, "cset x3, hi");
    a64_asm_text(?st, ?f, ?labels, "cset w7, ge");

    if (read_word(?st.buf, 0)  != 0x9A9F37E9) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x1A9F37E9) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x9A9F17E0) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x1A9F17E0) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x9A9F07E5) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x1A9F07E5) { bad = 1; }
    if (read_word(?st.buf, 24) != 0x9A9FA7E9) { bad = 1; }
    if (read_word(?st.buf, 28) != 0x1A9FC7F3) { bad = 1; }
    if (read_word(?st.buf, 32) != 0x9A9F97E3) { bad = 1; }
    if (read_word(?st.buf, 36) != 0x1A9FB7E7) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_load_store_forms" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1]");
    a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1, 8]");
    a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1, x2]");
    a64_asm_text(?st, ?f, ?labels, "str w0, [x1, 4]");
    a64_asm_text(?st, ?f, ?labels, "ldrb w0, [x1]");
    a64_asm_text(?st, ?f, ?labels, "ldrh w0, [x1, 2]");
    a64_asm_text(?st, ?f, ?labels, "strb w0, [x1, 1]");
    a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1, -8]");
    a64_asm_text(?st, ?f, ?labels, "str x0, [sp, 8]");
    a64_asm_text(?st, ?f, ?labels, "ldr x0, [sp]");
    a64_asm_text(?st, ?f, ?labels, "stp x29, x30, [sp, -16]!");
    a64_asm_text(?st, ?f, ?labels, "ldp x29, x30, [sp], 16");
    a64_asm_text(?st, ?f, ?labels, "stp x19, x20, [sp, 16]");
    a64_asm_text(?st, ?f, ?labels, "ldp x19, x20, [sp, 16]");
    a64_asm_text(?st, ?f, ?labels, "stp x0, x1, [sp]");
    a64_asm_text(?st, ?f, ?labels, "stp x0, x1, [sp], 16");
    a64_asm_text(?st, ?f, ?labels, "ldp x0, x1, [sp, 16]!");

    if (read_word(?st.buf, 0)  != 0xF9400020) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0xF9400420) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0xF8626820) { bad = 1; }
    if (read_word(?st.buf, 12) != 0xB9000420) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x39400020) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x79400420) { bad = 1; }
    if (read_word(?st.buf, 24) != 0x39000420) { bad = 1; }
    if (read_word(?st.buf, 28) != 0xF85F8020) { bad = 1; }
    if (read_word(?st.buf, 32) != 0xF90007E0) { bad = 1; }
    if (read_word(?st.buf, 36) != 0xF94003E0) { bad = 1; }
    if (read_word(?st.buf, 40) != 0xA9BF7BFD) { bad = 1; }
    if (read_word(?st.buf, 44) != 0xA8C17BFD) { bad = 1; }
    if (read_word(?st.buf, 48) != 0xA90153F3) { bad = 1; }
    if (read_word(?st.buf, 52) != 0xA94153F3) { bad = 1; }
    if (read_word(?st.buf, 56) != 0xA90007E0) { bad = 1; }
    if (read_word(?st.buf, 60) != 0xA88107E0) { bad = 1; }
    if (read_word(?st.buf, 64) != 0xA9C107E0) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

