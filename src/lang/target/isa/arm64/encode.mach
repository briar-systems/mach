val ZR: u32 = arm64.SP::u32;
val SP_REG: u32 = arm64.SP::u32;
val SCRATCH0: u32 = arm64.IP0::u32;
val SCRATCH1: u32 = arm64.IP1::u32;
val FP_REG: u32 = arm64.FP::u32;
val LR_REG: u32 = arm64.LR::u32;

val MAX_CALLEE_SAVE_REACH: u32 = 504;
val MAX_FRAME_SUB: u32 = 0xFFFFF0;

val CC_EQ: u32 = 0;
val CC_NE: u32 = 1;
val CC_HS: u32 = 2;
val CC_CC: u32 = 3;
val CC_MI: u32 = 4;
val CC_PL: u32 = 5;
val CC_VS: u32 = 6;
val CC_VC: u32 = 7;
val CC_HI: u32 = 8;
val CC_LS: u32 = 9;
val CC_GE: u32 = 10;
val CC_LT: u32 = 11;
val CC_GT: u32 = 12;
val CC_LE: u32 = 13;
val CC_AL: u32 = 14;

val FP_SCRATCH0: u32 = arm64.V31::u32;
val FP_SCRATCH1: u32 = arm64.V30::u32;







val A64_SYSREG_NAME_MAX: usize = 32;

fun a64_name_eq(name: str, want: str) bool {
    val n: usize = str_len(name);
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var c: u32 = name[i]::u32;
        if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
        if (c != want[i]::u32) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun a64_sysreg_field(name: str, pos: *usize, max: u32, out: *u32) bool {
    val n: usize = str_len(name);
    var i: usize = @pos;
    var v: u32 = 0;
    var digits: u32 = 0;
    for (i < n && name[i]::u32 >= '0'::u32 && name[i]::u32 <= '9'::u32) {
        v      = v * 10 + (name[i]::u32 - '0'::u32);
        digits = digits + 1;
        if (digits > 2) { ret false; }
        i = i + 1;
    }
    if (digits == 0 || v > max) { ret false; }
    @pos = i;
    @out = v;
    ret true;
}

fun a64_sysreg_char(name: str, pos: *usize, want: char) bool {
    if (@pos >= str_len(name)) { ret false; }
    var c: u32 = name[@pos]::u32;
    if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
    if (c != want::u32) { ret false; }
    @pos = @pos + 1;
    ret true;
}

fun a64_sysreg_numeric(name: str, op0_out: *u32, op1_out: *u32, crn_out: *u32, crm_out: *u32, op2_out: *u32) bool {
    var i: usize = 0;
    if (!a64_sysreg_char(name, ?i, 's'::char)) { ret false; }

    var op0: u32 = 0;
    if (!a64_sysreg_field(name, ?i, 3, ?op0)) { ret false; }
    if (op0 < 2)                              { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var op1: u32 = 0;
    if (!a64_sysreg_field(name, ?i, 7, ?op1))  { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var crn: u32 = 0;
    if (!a64_sysreg_char(name, ?i, 'c'::char)) { ret false; }
    if (!a64_sysreg_field(name, ?i, 15, ?crn)) { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var crm: u32 = 0;
    if (!a64_sysreg_char(name, ?i, 'c'::char)) { ret false; }
    if (!a64_sysreg_field(name, ?i, 15, ?crm)) { ret false; }
    if (!a64_sysreg_char(name, ?i, '_'::char)) { ret false; }

    var op2: u32 = 0;
    if (!a64_sysreg_field(name, ?i, 7, ?op2)) { ret false; }
    if (i != str_len(name)) { ret false; }

    @op0_out = op0; @op1_out = op1; @crn_out = crn; @crm_out = crm; @op2_out = op2;
    ret true;
}

fun a64_pstate_field(name: str, op1_out: *u32, op2_out: *u32) bool {
    if (a64_name_eq(name, "daifset")) { @op1_out = 3; @op2_out = 6; ret true; }
    if (a64_name_eq(name, "daifclr")) { @op1_out = 3; @op2_out = 7; ret true; }
    if (a64_name_eq(name, "spsel"))   { @op1_out = 0; @op2_out = 5; ret true; }
    if (a64_name_eq(name, "pan"))     { @op1_out = 0; @op2_out = 4; ret true; }
    if (a64_name_eq(name, "uao"))     { @op1_out = 0; @op2_out = 3; ret true; }
    if (a64_name_eq(name, "ssbs"))    { @op1_out = 3; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "dit"))     { @op1_out = 3; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "tco"))     { @op1_out = 3; @op2_out = 4; ret true; }
    ret false;
}

fun a64_sysreg(name: str, op0_out: *u32, op1_out: *u32, crn_out: *u32, crm_out: *u32, op2_out: *u32) bool {
    if (a64_name_eq(name, "cntvct_el0"))    { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 0; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "cntpct_el0"))    { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "cntfrq_el0"))    { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "cntv_ctl_el0"))  { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 3; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "cntv_cval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 3; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "cntv_tval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 3; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "cntp_ctl_el0"))  { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 2; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "cntp_cval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 2; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "cntp_tval_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 14; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "cntkctl_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out = 14; @crm_out = 1; @op2_out = 0; ret true; }

    if (a64_name_eq(name, "vbar_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out = 12; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "elr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "spsr_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "esr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  5; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "far_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  6; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "sp_el0"))    { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 1; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "sp_el1"))    { @op0_out = 3; @op1_out = 4; @crn_out =  4; @crm_out = 1; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "spsel"))     { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "currentel")) { @op0_out = 3; @op1_out = 0; @crn_out =  4; @crm_out = 2; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "daif"))      { @op0_out = 3; @op1_out = 3; @crn_out =  4; @crm_out = 2; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "nzcv"))      { @op0_out = 3; @op1_out = 3; @crn_out =  4; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "dit"))       { @op0_out = 3; @op1_out = 3; @crn_out =  4; @crm_out = 2; @op2_out = 5; ret true; }

    if (a64_name_eq(name, "vbar_el2"))  { @op0_out = 3; @op1_out = 4; @crn_out = 12; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "elr_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  4; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "spsr_el2"))  { @op0_out = 3; @op1_out = 4; @crn_out =  4; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "esr_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  5; @crm_out = 2; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "far_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  6; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "sctlr_el2")) { @op0_out = 3; @op1_out = 4; @crn_out =  1; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "hcr_el2"))   { @op0_out = 3; @op1_out = 4; @crn_out =  1; @crm_out = 1; @op2_out = 0; ret true; }

    if (a64_name_eq(name, "sctlr_el1")) { @op0_out = 3; @op1_out = 0; @crn_out =  1; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "tcr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out =  2; @crm_out = 0; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "ttbr0_el1")) { @op0_out = 3; @op1_out = 0; @crn_out =  2; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "ttbr1_el1")) { @op0_out = 3; @op1_out = 0; @crn_out =  2; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "mair_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out = 10; @crm_out = 2; @op2_out = 0; ret true; }

    if (a64_name_eq(name, "tpidr_el0"))   { @op0_out = 3; @op1_out = 3; @crn_out = 13; @crm_out = 0; @op2_out = 2; ret true; }
    if (a64_name_eq(name, "tpidrro_el0")) { @op0_out = 3; @op1_out = 3; @crn_out = 13; @crm_out = 0; @op2_out = 3; ret true; }
    if (a64_name_eq(name, "tpidr_el1"))   { @op0_out = 3; @op1_out = 0; @crn_out = 13; @crm_out = 0; @op2_out = 4; ret true; }

    if (a64_name_eq(name, "midr_el1"))         { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 0; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "mpidr_el1"))        { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 0; @op2_out = 5; ret true; }
    if (a64_name_eq(name, "ctr_el0"))          { @op0_out = 3; @op1_out = 3; @crn_out = 0; @crm_out = 0; @op2_out = 1; ret true; }
    if (a64_name_eq(name, "dczid_el0"))        { @op0_out = 3; @op1_out = 3; @crn_out = 0; @crm_out = 0; @op2_out = 7; ret true; }
    if (a64_name_eq(name, "id_aa64pfr0_el1"))  { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 4; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "id_aa64isar0_el1")) { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 6; @op2_out = 0; ret true; }
    if (a64_name_eq(name, "id_aa64mmfr0_el1")) { @op0_out = 3; @op1_out = 0; @crn_out = 0; @crm_out = 7; @op2_out = 0; ret true; }

    ret a64_sysreg_numeric(name, op0_out, op1_out, crn_out, crm_out, op2_out);
}

# the access row of an integer or float load/store at one width: the
# member for each addressing form, the register the data travels in and the
# immediate scale, together with the `:lo12:` relocation kind. a width with no
# row is refused
rec A64Access {
    op:       mop.MachOp;
    unscaled: mop.MachOp;
    fp:       bool;
    width:    u8;
    shift:    u32;
    lo12:     of.RelocKind;
}

fun acc(op: mop.MachOp, unscaled: mop.MachOp, fp: bool, width: u8, shift: u32, lo12: of.RelocKind) res[A64Access, fail.Fail] {
    var a: A64Access;
    a.op       = op;
    a.unscaled = unscaled;
    a.fp       = fp;
    a.width    = width;
    a.shift    = shift;
    a.lo12     = lo12;
    ret res[A64Access, fail.Fail].ok{a};
}

fun int_access(w: u8, is_load: bool) res[A64Access, fail.Fail] {
    if (w == 1) {
        if (is_load) { ret acc(mop.LDRB, mop.LDURB, false, 4, 0, of.RK_LDST8_LO12); }
        ret acc(mop.STRB, mop.STURB, false, 4, 0, of.RK_LDST8_LO12);
    }
    if (w == 2) {
        if (is_load) { ret acc(mop.LDRH, mop.LDURH, false, 4, 1, of.RK_LDST16_LO12); }
        ret acc(mop.STRH, mop.STURH, false, 4, 1, of.RK_LDST16_LO12);
    }
    if (w == 4) {
        if (is_load) { ret acc(mop.LDR, mop.LDUR, false, 4, 2, of.RK_LDST32_LO12); }
        ret acc(mop.STR, mop.STUR, false, 4, 2, of.RK_LDST32_LO12);
    }
    if (w == 8) {
        if (is_load) { ret acc(mop.LDR, mop.LDUR, false, 8, 3, of.RK_LDST64_LO12); }
        ret acc(mop.STR, mop.STUR, false, 8, 3, of.RK_LDST64_LO12);
    }
    ret res[A64Access, fail.Fail].err{fail.message("internal compiler error: aarch64 has no integer memory access form for this width (expected 1, 2, 4, or 8)")};
}

fun fp_access(w: u8, is_load: bool) res[A64Access, fail.Fail] {
    var lo12: of.RelocKind = of.RK_LDST8_LO12;
    var shift: u32 = 0;
    if (w == 2)       { lo12 = of.RK_LDST16_LO12;  shift = 1; }
    or (w == 4)       { lo12 = of.RK_LDST32_LO12;  shift = 2; }
    or (w == 8)       { lo12 = of.RK_LDST64_LO12;  shift = 3; }
    or (w == 16)      { lo12 = of.RK_LDST128_LO12; shift = 4; }
    or (w != 1) {
        ret res[A64Access, fail.Fail].err{fail.message("internal compiler error: aarch64 has no float memory access form for this width (expected 1, 2, 4, 8, or 16)")};
    }
    if (is_load) { ret acc(mop.LDR, mop.LDUR, true, w, shift, lo12); }
    ret acc(mop.STR, mop.STUR, true, w, shift, lo12);
}

fun emit_word(st: *encode.EncodeState, word: u32) {
    encode.emit_u32(?st.buf, word);
}

fun shaped_reg(fp: bool, n: u32, bytes: u8) isa.Operand {
    if (fp) { ret mop.vec(n, bytes); }
    ret mop.gp(n, bytes);
}

fun width_bytes(use64: bool) u8 {
    if (use64) { ret 8; }
    ret 4;
}

fun noting(st: *encode.EncodeState) bool {
    ret encode.sink_active(?st.buf);
}

fun inst_of(op: mop.MachOp, dst: isa.Operand, src1: isa.Operand, src2: isa.Operand) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = op::u16;
    mi.dst    = dst;
    mi.src1   = src1;
    mi.src2   = src2;
    ret mi;
}

fun operation_width(mi: *isa.Inst) u8 {
    if (mi.dst.kind == isa.OPK_REG)  { ret mi.dst.size; }
    if (mi.src1.kind == isa.OPK_REG) { ret mi.src1.size; }
    if (mi.src2.kind == isa.OPK_REG) { ret mi.src2.size; }
    if (mi.dst.kind == isa.OPK_MEM)  { ret mi.dst.size; }
    if (mi.src1.kind == isa.OPK_MEM) { ret mi.src1.size; }
    ret 0;
}

# every instruction word leaves through here: the row assembles the word
# from the instruction, the word is emitted, and the same instruction, spelled
# as an assembler reads it back, is what the stream is notified with. a member
# whose row cannot hold what it was given emits nothing and refuses the buffer
fun emit_inst(st: *encode.EncodeState, mi: *isa.Inst) {
    val word: u32 = mop.assemble(mi);
    if (word == 0) {
        encode.buf_refuse(?st.buf, "internal compiler error: an aarch64 instruction has no encoding row for its operands");
        ret;
    }
    emit_word(st, word);
    if (!noting(st)) { ret; }
    mi.size = operation_width(mi);
    mop.spell(mi);
    printer.note_inst(?st.buf, mi);
}

fun emit_alu3(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, rn: u32, rm: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    # add/sub writing index 31 writes the stack pointer, which is the
    # extended-register form; in every other position of the shifted form
    # index 31 is the zero register (neg is sub from it)
    if ((op == mop.ADD || op == mop.SUB) && rd == SP_REG) { mi.flags = mop.FLAG_SP; }
    emit_inst(st, ?mi);
}

fun emit_alu3_sh(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, rn: u32, rm: u32, sh: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    if (sh != 0) { mi.src3 = isa.make_imm(sh::i64, 1); }
    emit_inst(st, ?mi);
}

fun emit_fp3(st: *encode.EncodeState, op: mop.MachOp, dbl: bool, rd: u32, rn: u32, rm: u32) {
    val w: u8 = width_bytes(dbl);
    var mi: isa.Inst = inst_of(op, mop.vec(rd, w), mop.vec(rn, w), mop.vec(rm, w));
    emit_inst(st, ?mi);
}

fun emit_fp2(st: *encode.EncodeState, op: mop.MachOp, dbl: bool, rd: u32, rn: u32) {
    val w: u8 = width_bytes(dbl);
    var mi: isa.Inst = inst_of(op, mop.vec(rd, w), mop.vec(rn, w), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_fcmp(st: *encode.EncodeState, dbl: bool, rn: u32, rm: u32) {
    val w: u8 = width_bytes(dbl);
    var mi: isa.Inst = inst_of(mop.FCMP, isa.make_none(), mop.vec(rn, w), mop.vec(rm, w));
    emit_inst(st, ?mi);
}

fun emit_fcvt(st: *encode.EncodeState, to_dbl: bool, rd: u32, rn: u32) {
    var mi: isa.Inst = inst_of(mop.FCVT, mop.vec(rd, width_bytes(to_dbl)), mop.vec(rn, width_bytes(!to_dbl)), isa.make_none());
    emit_inst(st, ?mi);
}

# a conversion between the banks: the operands carry the bank and width of
# each side, the row's rule places them in the word
fun emit_cvt(st: *encode.EncodeState, op: mop.MachOp, dst: isa.Operand, src: isa.Operand) {
    var mi: isa.Inst = inst_of(op, dst, src, isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_addsub_imm(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, rn: u32, imm12: u32, sh: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), isa.make_imm(imm12::i64, w));
    if (sh != 0) { mi.src3 = isa.make_imm(12, 1); }
    mi.flags = mop.FLAG_SP;
    emit_inst(st, ?mi);
}

fun emit_addsub_imm_sym(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, rn: u32, sym: intern.StrId, mod: isa.SymModifier, addend: i32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), isa.make_sym_addend(sym::u32, w, mod, addend));
    mi.flags = mop.FLAG_SP;
    emit_inst(st, ?mi);
}

# a bitfield alias with its own immediates: a shift count for lsl/lsr/asr,
# a position and a width for the extract and insert forms, none for the
# extends (whose source is always the 32-bit register)
fun emit_bitfield(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, rn: u32, a: u32, b: u32) {
    val w: u8 = width_bytes(use64);
    var src_w: u8 = w;
    val extend: bool = op == mop.UXTB || op == mop.UXTH || op == mop.SXTB || op == mop.SXTH || op == mop.SXTW;
    if (extend) { src_w = 4; }
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, src_w), isa.make_none());
    if (!extend) {
        mi.src2 = isa.make_imm(a::i64, 1);
        if (op == mop.UBFX || op == mop.UBFIZ || op == mop.SBFX || op == mop.SBFIZ) { mi.src3 = isa.make_imm(b::i64, 1); }
    }
    emit_inst(st, ?mi);
}

fun emit_movewide(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, hw: u32, imm16: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), isa.make_none(), isa.make_imm(imm16::i64, w));
    if (hw != 0) { mi.src3 = isa.make_imm((hw * 16)::i64, 1); }
    emit_inst(st, ?mi);
}

fun emit_madd(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rd: u32, rn: u32, rm: u32, ra: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    mi.src3 = mop.gp(ra, w);
    emit_inst(st, ?mi);
}

fun emit_cset(st: *encode.EncodeState, use64: bool, rd: u32, cc: u32) {
    var mi: isa.Inst = inst_of(mop.CSET, mop.gp(rd, width_bytes(use64)), isa.make_none(), isa.make_none());
    mi.flags = mop.with_cond(0, cc);
    emit_inst(st, ?mi);
}

fun access_bytes(op: mop.MachOp, width: u8) u8 {
    if (op == mop.LDRB || op == mop.STRB || op == mop.LDURB || op == mop.STURB) { ret 1; }
    if (op == mop.LDRH || op == mop.STRH || op == mop.LDURH || op == mop.STURH) { ret 2; }
    ret width;
}

fun ldst_inst(op: mop.MachOp, reg: isa.Operand, mem: isa.Operand) isa.Inst {
    val load: bool = op == mop.LDR || op == mop.LDRB || op == mop.LDRH || op == mop.LDUR ||
                     op == mop.LDURB || op == mop.LDURH || op == mop.LDAR || op == mop.LDAXR;
    if (load) { ret inst_of(op, reg, mem, isa.make_none()); }
    ret inst_of(op, mem, reg, isa.make_none());
}

fun emit_ldst(st: *encode.EncodeState, op: mop.MachOp, fp: bool, width: u8, rt: u32, rn: u32, imm12: u32) {
    val bytes: u8 = access_bytes(op, width);
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), (imm12 * bytes::u32)::i32, -1, 0, bytes);
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    emit_inst(st, ?mi);
}

fun emit_ldst_sym(st: *encode.EncodeState, op: mop.MachOp, fp: bool, width: u8, rt: u32, rn: u32, sym: intern.StrId, mod: isa.SymModifier, addend: i32) {
    val bytes: u8 = access_bytes(op, width);
    var mem: isa.Operand = isa.make_mem(mop.gp_id(rn), 0, -1, 0, bytes);
    mem.sym_id     = sym::u32;
    mem.sym_mod    = mod;
    mem.sym_addend = addend;
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    emit_inst(st, ?mi);
}

fun emit_ldur(st: *encode.EncodeState, op: mop.MachOp, fp: bool, width: u8, rt: u32, rn: u32, imm9: u32) {
    val bytes: u8 = access_bytes(op, width);
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), sign_extend_field(imm9, 9)::i32, -1, 0, bytes);
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    emit_inst(st, ?mi);
}

fun emit_ldst_reg(st: *encode.EncodeState, op: mop.MachOp, fp: bool, width: u8, rt: u32, rn: u32, rm: u32) {
    val bytes: u8 = access_bytes(op, width);
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), 0, mop.gp_id(rm), 1, bytes);
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    emit_inst(st, ?mi);
}

fun emit_ldord(st: *encode.EncodeState, op: mop.MachOp, use64: bool, rt: u32, rn: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = ldst_inst(op, mop.gp(rt, w), isa.make_mem(mop.gp_id(rn), 0, -1, 0, w));
    emit_inst(st, ?mi);
}

fun emit_ldstp(st: *encode.EncodeState, op: mop.MachOp, fp: bool, rt: u32, rt2: u32, rn: u32, imm7: u32, wb: u16) {
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), (sign_extend_field(imm7, 7) * 8)::i32, -1, 0, 8);
    val ra: isa.Operand = shaped_reg(fp, rt, 8);
    val rb: isa.Operand = shaped_reg(fp, rt2, 8);
    var mi: isa.Inst = inst_of(op, mem, ra, rb);
    if (op == mop.LDP) { mi = inst_of(op, ra, rb, mem); }
    mi.flags = wb;
    emit_inst(st, ?mi);
}

fun lane_flags(lane: u32) u16 {
    ret mop.with_elem_bytes(0, mir.vec_lane_elem_bytes(lane));
}

fun emit_neon_3same(st: *encode.EncodeState, op: mop.MachOp, rd: u32, rn: u32, rm: u32, lane: u32) {
    var mi: isa.Inst = inst_of(op, mop.vec(rd, 16), mop.vec(rn, 16), mop.vec(rm, 16));
    mi.flags = lane_flags(lane);
    emit_inst(st, ?mi);
}

fun emit_neon_2misc(st: *encode.EncodeState, op: mop.MachOp, rd: u32, rn: u32) {
    var mi: isa.Inst = inst_of(op, mop.vec(rd, 16), mop.vec(rn, 16), isa.make_none());
    mi.flags = mop.with_elem_bytes(0, 1);
    emit_inst(st, ?mi);
}

fun emit_neon_umov(st: *encode.EncodeState, index: u32, rd: u32, rn: u32, lane: u32) {
    var dst_bytes: u8 = 4;
    if (mir.vec_lane_elem_bytes(lane) == 8) { dst_bytes = 8; }
    var mi: isa.Inst = inst_of(mop.UMOV, mop.gp(rd, dst_bytes), mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.flags = lane_flags(lane);
    emit_inst(st, ?mi);
}

fun emit_neon_dup_el(st: *encode.EncodeState, index: u32, rd: u32, rn: u32, lane: u32) {
    var mi: isa.Inst = inst_of(mop.DUP, mop.vec(rd, mir.vec_lane_elem_bytes(lane)), mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.flags = lane_flags(lane);
    emit_inst(st, ?mi);
}

fun emit_neon_ins_gp(st: *encode.EncodeState, index: u32, rd: u32, rn: u32, lane: u32, src_bytes: u8) {
    var mi: isa.Inst = inst_of(mop.INS, mop.vec(rd, 16), mop.gp(rn, src_bytes), isa.make_imm(index::i64, 1));
    mi.flags = lane_flags(lane);
    emit_inst(st, ?mi);
}

fun emit_neon_ins_el(st: *encode.EncodeState, index: u32, src_index: u32, rd: u32, rn: u32, lane: u32) {
    var mi: isa.Inst = inst_of(mop.INS_EL, mop.vec(rd, 16), mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.src3  = isa.make_imm(src_index::i64, 1);
    mi.flags = lane_flags(lane);
    emit_inst(st, ?mi);
}

# a compare-and-branch names its register in src1; the other branches none
fun branch_inst(op: mop.MachOp, cc: u32, use64: bool, rt: u32, target: isa.Operand) isa.Inst {
    var reg: isa.Operand = isa.make_none();
    if (op == mop.CBZ || op == mop.CBNZ) { reg = mop.gp(rt, width_bytes(use64)); }
    var mi: isa.Inst = inst_of(op, isa.make_none(), reg, target);
    if (op == mop.BCOND) { mi.flags = mop.with_cond(0, cc); }
    ret mi;
}

fun emit_branch_block(st: *encode.EncodeState, op: mop.MachOp, cc: u32, use64: bool, rt: u32, block: u32) {
    var mi: isa.Inst = branch_inst(op, cc, use64, rt, isa.make_block_label(block));
    mi.flags = mi.flags | mop.FLAG_TARGET_BLOCK;
    emit_inst(st, ?mi);
}

fun emit_branch_sym(st: *encode.EncodeState, op: mop.MachOp, sym: intern.StrId, addend: i32) {
    var mi: isa.Inst = branch_inst(op, 0, false, 0, isa.make_sym_addend(sym::u32, 0, isa.SYM_MOD_NONE, addend));
    emit_inst(st, ?mi);
}

# a pc-relative skip inside the same expansion: the target travels as a
# local label whose displacement is the bytes skipped
fun emit_branch_pcrel(st: *encode.EncodeState, op: mop.MachOp, cc: u32, use64: bool, rt: u32, imm19: u32) {
    val disp: i64 = sign_extend_field(imm19, 19) * 4;
    var target: isa.Operand = isa.make_local_label(disp > 0);
    target.disp = disp::i32;
    var mi: isa.Inst = branch_inst(op, cc, use64, rt, target);
    mi.flags = mi.flags | mop.FLAG_LABEL_SKIP;
    emit_inst(st, ?mi);
}

# a numbered inline-asm local: the number travels in the label's sym_id
fun emit_branch_local(st: *encode.EncodeState, op: mop.MachOp, cc: u32, use64: bool, rt: u32, number: u64, fwd: bool) {
    var target: isa.Operand = isa.make_local_label(fwd);
    target.sym_id = number::u32;
    var mi: isa.Inst = branch_inst(op, cc, use64, rt, target);
    mi.flags = mi.flags | mop.FLAG_LABEL_LOCAL;
    if (fwd) { mi.flags = mi.flags | mop.FLAG_LABEL_FWD; }
    emit_inst(st, ?mi);
}

fun emit_branch_reg(st: *encode.EncodeState, op: mop.MachOp, rn: u32) {
    var mi: isa.Inst = inst_of(op, isa.make_none(), mop.gp(rn, 8), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_ret(st: *encode.EncodeState) {
    var mi: isa.Inst = inst_of(mop.RET, isa.make_none(), isa.make_none(), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_adrp(st: *encode.EncodeState, rd: u32, sym: intern.StrId, mod: isa.SymModifier, addend: i32) {
    var mi: isa.Inst = inst_of(mop.ADRP, mop.gp(rd, 8), isa.make_sym_addend(sym::u32, 0, mod, addend), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_nullary(st: *encode.EncodeState, op: mop.MachOp) {
    var mi: isa.Inst = inst_of(op, isa.make_none(), isa.make_none(), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_imm16(st: *encode.EncodeState, op: mop.MachOp, imm16: u32) {
    var mi: isa.Inst = inst_of(op, isa.make_none(), isa.make_imm(imm16::i64, 2), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_barrier(st: *encode.EncodeState, crm: u32) {
    var mi: isa.Inst = inst_of(mop.DMB, isa.make_none(), isa.make_imm(crm::i64, 1), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_msr_imm(st: *encode.EncodeState, op1: u32, op2: u32, imm: u32) {
    var mi: isa.Inst = inst_of(mop.MSR, isa.make_none(),
                               isa.make_imm((((op1 & 0x7) << 3) | (op2 & 0x7))::i64, 1),
                               isa.make_imm(imm::i64, 1));
    emit_inst(st, ?mi);
}

fun a64_sysreg_pack(op0: u32, op1: u32, crn: u32, crm: u32, op2: u32) u32 {
    ret ((op0 & 0x3) << 16) | ((op1 & 0x7) << 12) | ((crn & 0xF) << 8) | ((crm & 0xF) << 4) | (op2 & 0x7);
}

fun emit_mrs(st: *encode.EncodeState, packed: u32, rt: u32) {
    var mi: isa.Inst = inst_of(mop.MRS, mop.gp(rt, 8), isa.make_imm(packed::i64, 4), isa.make_none());
    emit_inst(st, ?mi);
}

fun emit_msr_reg(st: *encode.EncodeState, packed: u32, rt: u32) {
    var mi: isa.Inst = inst_of(mop.MSR, isa.make_none(), isa.make_imm(packed::i64, 4), mop.gp(rt, 8));
    emit_inst(st, ?mi);
}

fun emit_stxr(st: *encode.EncodeState, use64: bool, rs: u32, rt: u32, rn: u32) {
    val w: u8 = width_bytes(use64);
    var mi: isa.Inst = inst_of(mop.STLXR, mop.gp(rs, 4), mop.gp(rt, w), isa.make_mem(mop.gp_id(rn), 0, -1, 0, w));
    emit_inst(st, ?mi);
}

fun sign_extend_field(v: u32, bits: u32) i64 {
    val mask: u32 = (1::u32 << bits) - 1;
    val x: u32 = v & mask;
    if ((x & (1::u32 << (bits - 1))) != 0) { ret (x::i64) - ((mask::i64) + 1); }
    ret x::i64;
}

fun read_word(buf: *encode.ByteBuf, pos: usize) u32 {
    ret buf.data[pos]::u32 |
        (buf.data[pos + 1]::u32 << 8) |
        (buf.data[pos + 2]::u32 << 16) |
        (buf.data[pos + 3]::u32 << 24);
}

fun write_word(buf: *encode.ByteBuf, pos: usize, word: u32) {
    buf.data[pos]     = (word & 0xFF)::u8;
    buf.data[pos + 1] = ((word >> 8) & 0xFF)::u8;
    buf.data[pos + 2] = ((word >> 16) & 0xFF)::u8;
    buf.data[pos + 3] = ((word >> 24) & 0xFF)::u8;
}

fun is64(width: u8) bool {
    if (width == 0) { ret true; }
    ret width >= 8;
}

fun emit_movewide_seq(st: *encode.EncodeState, rd: u32, value: u64, use64: bool) {
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var v: u64 = value;
    if (!use64) { v = value & 0xFFFFFFFF; }

    if (v == 0) {
        emit_movewide(st, mop.MOVZ, use64, rd, 0, 0);
        ret;
    }

    var first: bool = true;
    var i: u32 = 0;
    for (i < chunks) {
        val chunk: u32 = ((v >> (16::u64 * i::u64)) & 0xFFFF)::u32;
        if (chunk != 0) {
            if (first) {
                emit_movewide(st, mop.MOVZ, use64, rd, i, chunk);
                first = false;
            } or {
                emit_movewide(st, mop.MOVK, use64, rd, i, chunk);
            }
        }
        i = i + 1;
    }
}

fun req_gpr(op: *mir.MirOperand) res[i32, fail.Fail] {
    if (op.kind == mir.MIR_OP_PREG) {
        if (isa.regid_class(mir.preg_regid(op.preg)) != isa.REG_CLASS_ID_GP) {
            ret res[i32, fail.Fail].err{fail.message("internal compiler error: a float/vector register reached a general-purpose operand position")};
        }
        ret res[i32, fail.Fail].ok{isa.regid_index(mir.preg_regid(op.preg))};
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret res[i32, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    ret res[i32, fail.Fail].err{fail.message("encode: expected a register operand")};
}

fun resolve_source(st: *encode.EncodeState, op: *mir.MirOperand, scratch: u32, use64: bool) res[i32, fail.Fail] {
    if (op.kind == mir.MIR_OP_IMM) {
        emit_movewide_seq(st, scratch, op.imm::u64, use64);
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    ret req_gpr(op);
}

rec A64Mem {
    base:      u32;
    off:       i64;
    has_index: bool;
    index:     u32;
    scale:     u8;
}

fun frame_slot_offset(f: *mir.MirFunction, v: u32) opt[i64] {
    if (codegen_frame.slots_from_sp(?f.frame)) {
        val r_1085: opt[i64] = codegen_frame.slot_sp_offset(?f.frame, v);
        if (sel r_1085.some) { ret opt[i64].some{r_1085.some}; }
        ret opt[i64].none{};
    }
    val r_1087: opt[i64] = codegen_frame.slot_offset(?f.frame, v);
    if (sel r_1087.some) { ret opt[i64].some{r_1087.some}; }
    ret opt[i64].none{};
}

fun slot_base_reg(f: *mir.MirFunction) u32 {
    if (codegen_frame.slots_from_sp(?f.frame)) { ret ZR; }
    ret arm64.FP::u32;
}

fun asm_slot_offset(f: *mir.MirFunction, v: u32) opt[i64] {
    val r_1096: opt[i64] = codegen_frame.slot_sp_offset(?f.frame, v);
    if (sel r_1096.some) { ret opt[i64].some{r_1096.some}; }
    ret opt[i64].none{};
}

fun resolve_mem(f: *mir.MirFunction, op: *mir.MirOperand) res[A64Mem, fail.Fail] {
    if (op.kind != mir.MIR_OP_MEM) {
        ret res[A64Mem, fail.Fail].err{fail.message("encode: expected a memory operand")};
    }
    var m: A64Mem;
    m.has_index = false;
    m.index     = 0;
    m.scale     = 0;
    if (sel op.index.vreg) {
        ret res[A64Mem, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand index")};
    }
    if (sel op.index.preg) {
        m.has_index = true;
        m.index     = mir.preg_regid(op.index.preg)::u32;
        m.scale     = op.scale;
    }
    if (!mir.vreg_is_nil(op.vreg)) {
        val slot: opt[i64] = frame_slot_offset(f, op.vreg.n);
        if (!sel slot.some) {
            ret res[A64Mem, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand base")};
        }
        m.base = slot_base_reg(f);
        m.off  = slot.some + op.imm;
        ret res[A64Mem, fail.Fail].ok{m};
    }
    m.base = mir.preg_regid(op.preg)::u32;
    m.off  = op.imm;
    ret res[A64Mem, fail.Fail].ok{m};
}

fun mem_access_needs_no_scratch(off: i64, width: u8) res[bool, fail.Fail] {
    val ar: res[A64Access, fail.Fail] = int_access(width, true);
    if (sel ar.err) { ret res[bool, fail.Fail].err{ar.err}; }
    val sh: u32 = ar.ok.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) { ret res[bool, fail.Fail].ok{true}; }
    }
    ret res[bool, fail.Fail].ok{off >= -256 && off <= 255};
}

fun emit_mem_access(st: *encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) err[fail.Fail] {
    val ar: res[A64Access, fail.Fail] = int_access(width, is_load);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val a: A64Access = ar.ok;
    val sh: u32 = a.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) {
            emit_ldst(st, a.op, a.fp, a.width, rt, base, (off >> sh::i64)::u32);
            ret err[fail.Fail].ok{};
        }
    }
    if (off >= -256 && off <= 255) {
        emit_ldur(st, a.unscaled, a.fp, a.width, rt, base, off::u32 & 0x1FF);
        ret err[fail.Fail].ok{};
    }
    emit_movewide_seq(st, SCRATCH0, off::u64, true);
    emit_ldst_reg(st, a.op, a.fp, a.width, rt, base, SCRATCH0);
    ret err[fail.Fail].ok{};
}

fun emit_add_imm(st: *encode.EncodeState, rd: u32, rn: u32, off: i64) {
    if (off >= 0 && off <= 4095) {
        emit_addsub_imm(st, mop.ADD, true, rd, rn, off::u32, 0);
        ret;
    }
    if (off < 0 && off >= -4095) {
        emit_addsub_imm(st, mop.SUB, true, rd, rn, (-off)::u32, 0);
        ret;
    }
    if (off > 0 && (off & 0xFFF) == 0 && (off >> 12) <= 4095) {
        emit_addsub_imm(st, mop.ADD, true, rd, rn, (off >> 12)::u32, 1);
        ret;
    }
    if (off < 0 && ((-off) & 0xFFF) == 0 && ((-off) >> 12) <= 4095) {
        emit_addsub_imm(st, mop.SUB, true, rd, rn, ((-off) >> 12)::u32, 1);
        ret;
    }
    emit_movewide_seq(st, SCRATCH0, off::u64, true);
    if (rn == ZR) {
        emit_addsub_imm(st, mop.ADD, true, SCRATCH1, ZR, 0, 0);
        emit_alu3(st, mop.ADD, true, rd, SCRATCH1, SCRATCH0);
        ret;
    }
    emit_alu3(st, mop.ADD, true, rd, rn, SCRATCH0);
}

fun scale_shift(scale: u8) res[u32, fail.Fail] {
    if (scale == 1) { ret res[u32, fail.Fail].ok{0}; }
    if (scale == 2) { ret res[u32, fail.Fail].ok{1}; }
    if (scale == 4) { ret res[u32, fail.Fail].ok{2}; }
    if (scale == 8) { ret res[u32, fail.Fail].ok{3}; }
    ret res[u32, fail.Fail].err{fail.message("encode: a scaled-index address must have a scale of 1, 2, 4, or 8")};
}

fun emit_adrp_reloc(st: *encode.EncodeState, rd: u32, sym: intern.StrId, addend: i32) err[fail.Fail] {
    val pos: u32 = st.buf.len::u32;
    emit_adrp(st, rd, sym, isa.SYM_MOD_PCREL_HI, addend);
    val r_1198: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PAGE21, sym, addend);
    if (sel r_1198.err) { ret err[fail.Fail].err{r_1198.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_addr(st: *encode.EncodeState, rd: u32, symop: *mir.MirOperand) err[fail.Fail] {
    if (symop.sym == intern.STR_NIL) {
        ret err[fail.Fail].err{fail.message("encode: address-of has no resolved symbol name")};
    }
    val ar: err[fail.Fail] = emit_adrp_reloc(st, rd, symop.sym, symop.sym_off);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_addsub_imm_sym(st, mop.ADD, true, rd, rd, symop.sym, isa.SYM_MOD_PCREL_LO, symop.sym_off);
    val r_1209: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_ADD_LO12, symop.sym, symop.sym_off);
    if (sel r_1209.err) { ret err[fail.Fail].err{r_1209.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_load(st: *encode.EncodeState, rt: u32, symop: *mir.MirOperand, width: u8, is_vec: bool) err[fail.Fail] {
    if (symop.sym == intern.STR_NIL) {
        ret err[fail.Fail].err{fail.message("encode: folded-global load has no resolved symbol name")};
    }
    var fr: res[A64Access, fail.Fail] = int_access(width, true);
    if (is_vec) { fr = fp_access(width, true); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a: A64Access = fr.ok;
    val ar: err[fail.Fail] = emit_adrp_reloc(st, SCRATCH0, symop.sym, symop.sym_off);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, a.op, a.fp, a.width, rt, SCRATCH0, symop.sym, isa.SYM_MOD_PCREL_LO, symop.sym_off);
    val r_1224: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), a.lo12, symop.sym, symop.sym_off);
    if (sel r_1224.err) { ret err[fail.Fail].err{r_1224.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_store(st: *encode.EncodeState, f: *mir.MirFunction, symop: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) err[fail.Fail] {
    if (symop.sym == intern.STR_NIL) {
        ret err[fail.Fail].err{fail.message("encode: folded-global store has no resolved symbol name")};
    }
    val vec_val: bool = reg_is_vec(val_op) || is_fp_slot(f, val_op);
    var fr: res[A64Access, fail.Fail] = int_access(width, false);
    if (vec_val) { fr = fp_access(width, false); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a: A64Access = fr.ok;

    var rt: u32 = ZR;
    if (vec_val) {
        if (reg_is_vec(val_op)) {
            val vr: res[i32, fail.Fail] = req_vec(val_op);
            if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }
            rt = vr.ok::u32;
        } or {
            val lr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH0, width);
            if (sel lr.err) { ret lr; }
            rt = FP_SCRATCH0;
        }
    } or (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_movewide_seq(st, SCRATCH1, val_op.imm::u64, is64(width));
            rt = SCRATCH1;
        }
    } or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }

    val ar: err[fail.Fail] = emit_adrp_reloc(st, SCRATCH0, symop.sym, symop.sym_off);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, a.op, a.fp, a.width, rt, SCRATCH0, symop.sym, isa.SYM_MOD_PCREL_LO, symop.sym_off);
    val r_1263: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), a.lo12, symop.sym, symop.sym_off);
    if (sel r_1263.err) { ret err[fail.Fail].err{r_1263.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_adrp_got_reloc(st: *encode.EncodeState, rd: u32, sym: intern.StrId) err[fail.Fail] {
    val pos: u32 = st.buf.len::u32;
    emit_adrp(st, rd, sym, isa.SYM_MOD_GOT_HI, 0);
    val r_1269: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_PAGE21, sym, 0);
    if (sel r_1269.err) { ret err[fail.Fail].err{r_1269.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_addr_got(st: *encode.EncodeState, rd: u32, symop: *mir.MirOperand) err[fail.Fail] {
    if (symop.sym == intern.STR_NIL) {
        ret err[fail.Fail].err{fail.message("encode: GOT address-of has no resolved symbol name")};
    }
    val ar: err[fail.Fail] = emit_adrp_got_reloc(st, rd, symop.sym);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, mop.LDR, false, 8, rd, rd, symop.sym, isa.SYM_MOD_GOT_LO, 0);
    val pr: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_LO12, symop.sym, 0);
    if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
    if (symop.sym_off != 0) { emit_add_imm(st, rd, rd, symop.sym_off::i64); }
    ret err[fail.Fail].ok{};
}

fun emit_global_load_got(st: *encode.EncodeState, rt: u32, symop: *mir.MirOperand, width: u8, is_vec: bool) err[fail.Fail] {
    var fr: res[A64Access, fail.Fail] = int_access(width, true);
    if (is_vec) { fr = fp_access(width, true); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    if (is_vec) {
        val vr: err[fail.Fail] = emit_global_addr_got(st, SCRATCH0, symop);
        if (sel vr.err) { ret vr; }
        ret emit_fp_mem(st, rt, SCRATCH0, 0, width, true);
    }
    val ar: err[fail.Fail] = emit_global_addr_got(st, rt, symop);
    if (sel ar.err) { ret ar; }
    ret emit_mem_access(st, rt, rt, 0, width, true);
}

fun emit_global_store_got(st: *encode.EncodeState, f: *mir.MirFunction, symop: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) err[fail.Fail] {
    val vec_val: bool = reg_is_vec(val_op) || is_fp_slot(f, val_op);
    var fr: res[A64Access, fail.Fail] = int_access(width, false);
    if (vec_val) { fr = fp_access(width, false); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }

    var rt: u32 = ZR;
    if (vec_val) {
        if (reg_is_vec(val_op)) {
            val vr: res[i32, fail.Fail] = req_vec(val_op);
            if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }
            rt = vr.ok::u32;
        } or {
            val lr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH0, width);
            if (sel lr.err) { ret lr; }
            rt = FP_SCRATCH0;
        }
        val vr2: err[fail.Fail] = emit_global_addr_got(st, SCRATCH0, symop);
        if (sel vr2.err) { ret vr2; }
        ret emit_fp_mem(st, rt, SCRATCH0, 0, width, false);
    }
    if (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_movewide_seq(st, SCRATCH1, val_op.imm::u64, is64(width));
            rt = SCRATCH1;
        }
    } or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }

    val ar: err[fail.Fail] = emit_global_addr_got(st, SCRATCH0, symop);
    if (sel ar.err) { ret ar; }
    ret emit_mem_access(st, rt, SCRATCH0, 0, width, false);
}

fun encode_call(st: *encode.EncodeState, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1) { ret err[fail.Fail].err{fail.message("encode: call missing callee operand")}; }
    val callee: *mir.MirOperand = ?mi.operands[0];
    if (callee.kind == mir.MIR_OP_SYM) {
        if (callee.sym == intern.STR_NIL) {
            ret err[fail.Fail].err{fail.message("encode: direct call has no resolved symbol name")};
        }
        val pos: u32 = st.buf.len::u32;
        emit_branch_sym(st, mop.BL, callee.sym, callee.sym_off);
        val r_1346: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PLT32, callee.sym, callee.sym_off);
        if (sel r_1346.err) { ret err[fail.Fail].err{r_1346.err}; }
        ret err[fail.Fail].ok{};
    }
    val rr: res[i32, fail.Fail] = req_gpr(callee);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    emit_branch_reg(st, mop.BLR, rr.ok::u32);
    ret err[fail.Fail].ok{};
}

fun encode_alu3(st: *encode.EncodeState, mi: *mir.MirInstr, op: mop.MachOp) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: ALU op missing operands")}; }
    val use64: bool = is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[2], SCRATCH0, use64);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    emit_alu3(st, op, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun encode_addsub(st: *encode.EncodeState, mi: *mir.MirInstr, is_sub: bool) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: add/sub missing operands")}; }
    val use64: bool = is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rhs: *mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == mir.MIR_OP_IMM) {
        val v: i64 = rhs.imm;
        var op_i: mop.MachOp = mop.ADD;
        if (is_sub) { op_i = mop.SUB; }
        if (v >= 0 && v <= 4095) {
            emit_addsub_imm(st, op_i, use64, rd, rn, v::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            emit_addsub_imm(st, op_i, use64, rd, rn, (v >> 12)::u32, 1);
            ret err[fail.Fail].ok{};
        }
    }

    val rmr: res[i32, fail.Fail] = resolve_source(st, rhs, SCRATCH0, use64);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;
    var op_r: mop.MachOp = mop.ADD;
    if (is_sub) { op_r = mop.SUB; }
    emit_alu3(st, op_r, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun encode_shift(st: *encode.EncodeState, mi: *mir.MirInstr, kind: u32) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: shift missing operands")}; }
    val use64: bool = is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val cnt: *mir.MirOperand = ?mi.operands[2];
    if (cnt.kind == mir.MIR_OP_IMM) {
        var width_bits: u32 = 32;
        if (use64) { width_bits = 64; }
        val sh: u32 = cnt.imm::u32 & (width_bits - 1);
        var op_i: mop.MachOp = mop.LSL;
        if (kind == arm64.LSR::u32) { op_i = mop.LSR; }
        or (kind == arm64.ASR::u32) { op_i = mop.ASR; }
        emit_bitfield(st, op_i, use64, rd, rn, sh, 0);
        ret err[fail.Fail].ok{};
    }

    val rmr: res[i32, fail.Fail] = req_gpr(cnt);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;
    var op_v: mop.MachOp = mop.LSLV;
    if (kind == arm64.LSR::u32) { op_v = mop.LSRV; }
    or (kind == arm64.ASR::u32) { op_v = mop.ASRV; }
    emit_alu3(st, op_v, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun encode_neg_mvn(st: *encode.EncodeState, mi: *mir.MirInstr, op: mop.MachOp) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: neg/not missing operands")}; }
    val use64: bool = is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], SCRATCH0, use64);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    emit_alu3(st, op, use64, rd, ZR, rm);
    ret err[fail.Fail].ok{};
}

fun encode_mov(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: mov missing operands")}; }
    val use64: bool = is64(mi.width);

    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (dst.kind == mir.MIR_OP_MEM) {
        ret emit_store_mem(st, f, dst, src, mi.width);
    }

    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    if (src.kind == mir.MIR_OP_MEM) {
        val mr: res[A64Mem, fail.Fail] = resolve_mem(f, src);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: A64Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed spill reload not expected")}; }
        ret emit_mem_access(st, rd, m.base, m.off, mi.width, true);
    }

    if (src.kind == mir.MIR_OP_IMM) {
        emit_movewide_seq(st, rd, src.imm::u64, use64);
        ret err[fail.Fail].ok{};
    }
    val rmr: res[i32, fail.Fail] = req_gpr(src);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;
    emit_alu3(st, mop.ORR, use64, rd, ZR, rm);
    ret err[fail.Fail].ok{};
}

fun emit_store_mem(st: *encode.EncodeState, f: *mir.MirFunction, dst_mem: *mir.MirOperand, val_op: *mir.MirOperand, width: u8) err[fail.Fail] {
    if (dst_mem.kind == mir.MIR_OP_SYM) {
        if (dst_mem.sym_got) { ret emit_global_store_got(st, f, dst_mem, val_op, width); }
        ret emit_global_store(st, f, dst_mem, val_op, width);
    }
    val mr: res[A64Mem, fail.Fail] = resolve_mem(f, dst_mem);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: A64Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed store not expected")}; }

    if (reg_is_vec(val_op)) {
        val rvr: res[i32, fail.Fail] = req_vec(val_op);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        ret emit_fp_mem(st, rvr.ok::u32, m.base, m.off, width, false);
    }

    if (is_fp_slot(f, val_op)) {
        val ldr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, FP_SCRATCH0, width);
        if (sel ldr.err) { ret ldr; }
        ret emit_fp_mem(st, FP_SCRATCH0, m.base, m.off, width, false);
    }

    var rt: u32 = ZR;
    if (val_op.kind == mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            emit_movewide_seq(st, SCRATCH1, val_op.imm::u64, is64(width));
            rt = SCRATCH1;
        }
    } or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }
    ret emit_mem_access(st, rt, m.base, m.off, width, false);
}

fun encode_load(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: load missing operands")}; }
    val dstop: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (is_fp_slot(f, dstop)) {
        val ldr: err[fail.Fail] = emit_fp_slot_load(st, f, src, FP_SCRATCH0, mi.src_width);
        if (sel ldr.err) { ret ldr; }
        ret emit_fp_slot_store(st, f, dstop, FP_SCRATCH0, mi.src_width);
    }

    if (reg_is_vec(dstop)) {
        val rvr: res[i32, fail.Fail] = req_vec(dstop);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        if (src.kind == mir.MIR_OP_SYM) {
            if (src.sym_got) {
                ret emit_global_load_got(st, rvr.ok::u32, src, mi.src_width, true);
            }
            ret emit_global_load(st, rvr.ok::u32, src, mi.src_width, true);
        }
        val fmr: res[A64Mem, fail.Fail] = resolve_mem(f, src);
        if (sel fmr.err) { ret err[fail.Fail].err{fmr.err}; }
        val fm: A64Mem = fmr.ok;
        if (fm.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float load not expected")}; }
        ret emit_fp_mem(st, rvr.ok::u32, fm.base, fm.off, mi.src_width, true);
    }

    val rdr: res[i32, fail.Fail] = req_gpr(dstop);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    if (src.kind == mir.MIR_OP_SYM) {
        if (src.sym_got) { ret emit_global_load_got(st, rd, src, mi.src_width, false); }
        ret emit_global_load(st, rd, src, mi.src_width, false);
    }
    val mr: res[A64Mem, fail.Fail] = resolve_mem(f, src);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: A64Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed load not expected")}; }
    ret emit_mem_access(st, rd, m.base, m.off, mi.src_width, true);
}

fun encode_store(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: store missing operands")}; }
    ret emit_store_mem(st, f, ?mi.operands[0], ?mi.operands[1], mi.width);
}

fun encode_addr(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: address op missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val memop: *mir.MirOperand = ?mi.operands[1];
    if (memop.kind == mir.MIR_OP_SYM) {
        if (memop.sym_got) { ret emit_global_addr_got(st, rd, memop); }
        ret emit_global_addr(st, rd, memop);
    }
    val mr: res[A64Mem, fail.Fail] = resolve_mem(f, memop);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: A64Mem = mr.ok;

    if (!m.has_index) {
        emit_add_imm(st, rd, m.base, m.off);
        ret err[fail.Fail].ok{};
    }
    val shr: res[u32, fail.Fail] = scale_shift(m.scale);
    if (sel shr.err) { ret err[fail.Fail].err{shr.err}; }
    val sh: u32 = shr.ok;
    var ibase: u32 = m.base;
    if (ibase == ZR) {
        emit_addsub_imm(st, mop.ADD, true, SCRATCH0, ZR, 0, 0);
        ibase = SCRATCH0;
    }
    if (m.off == 0) {
        emit_alu3_sh(st, mop.ADD, true, rd, ibase, m.index, sh);
        ret err[fail.Fail].ok{};
    }
    emit_add_imm(st, rd, ibase, m.off);
    emit_alu3_sh(st, mop.ADD, true, rd, rd, m.index, sh);
    ret err[fail.Fail].ok{};
}

fun encode_convert(st: *encode.EncodeState, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: conversion missing operands")}; }
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;
    val rsr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], SCRATCH0, is64(sw));
    if (sel rsr.err) { ret err[fail.Fail].err{rsr.err}; }
    val rs: u32 = rsr.ok::u32;

    if (mi.opcode == mir.MIR_TRUNC) {
        emit_alu3(st, mop.ORR, false, rd, ZR, rs);
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == mir.MIR_BITCAST) {
        emit_alu3(st, mop.ORR, is64(dw), rd, ZR, rs);
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == mir.MIR_SEXT) {
        if (sw >= 8) {
            emit_alu3(st, mop.ORR, true, rd, ZR, rs);
            ret err[fail.Fail].ok{};
        }
        emit_bitfield(st, extend_op(true, sw), is64(dw), rd, rs, 0, 0);
        ret err[fail.Fail].ok{};
    }
    if (sw >= 4) {
        emit_alu3(st, mop.ORR, false, rd, ZR, rs);
        ret err[fail.Fail].ok{};
    }
    emit_bitfield(st, extend_op(false, sw), false, rd, rs, 0, 0);
    ret err[fail.Fail].ok{};
}

# the extend alias that widens a narrow source: sxtb/sxth/sxtw or uxtb/uxth
fun extend_op(signed: bool, sw: u8) mop.MachOp {
    if (signed) {
        if (sw == 1) { ret mop.SXTB; }
        if (sw == 2) { ret mop.SXTH; }
        ret mop.SXTW;
    }
    if (sw == 1) { ret mop.UXTB; }
    ret mop.UXTH;
}

fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

fun reg_is_vec(op: *mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_PREG && isa.regid_class(mir.preg_regid(op.preg)) == isa.REG_CLASS_ID_XMM;
}

fun req_vec(op: *mir.MirOperand) res[i32, fail.Fail] {
    if (op.kind == mir.MIR_OP_PREG) {
        if (isa.regid_class(mir.preg_regid(op.preg)) != isa.REG_CLASS_ID_XMM) {
            ret res[i32, fail.Fail].err{fail.message("internal compiler error: a general-purpose register reached a float/vector operand position")};
        }
        ret res[i32, fail.Fail].ok{isa.regid_index(mir.preg_regid(op.preg))};
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret res[i32, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    ret res[i32, fail.Fail].err{fail.message("encode: expected a float register operand")};
}

fun emit_fp_mem(st: *encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) err[fail.Fail] {
    val fr: res[A64Access, fail.Fail] = fp_access(width, is_load);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a: A64Access = fr.ok;
    val sh: u32 = a.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) {
            emit_ldst(st, a.op, a.fp, a.width, rt, base, (off >> sh::i64)::u32);
            ret err[fail.Fail].ok{};
        }
    }
    if (off >= -256 && off <= 255) {
        emit_ldur(st, a.unscaled, a.fp, a.width, rt, base, off::u32 & 0x1FF);
        ret err[fail.Fail].ok{};
    }
    emit_movewide_seq(st, SCRATCH0, off::u64, true);
    emit_ldst_reg(st, a.op, a.fp, a.width, rt, base, SCRATCH0);
    ret err[fail.Fail].ok{};
}

fun emit_fp_slot_store(st: *encode.EncodeState, f: *mir.MirFunction, memop: *mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    val mr: res[A64Mem, fail.Fail] = resolve_mem(f, memop);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: A64Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill destination not expected")}; }
    ret emit_fp_mem(st, rt, m.base, m.off, width, false);
}

fun emit_fp_slot_load(st: *encode.EncodeState, f: *mir.MirFunction, memop: *mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    val mr: res[A64Mem, fail.Fail] = resolve_mem(f, memop);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: A64Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill source not expected")}; }
    ret emit_fp_mem(st, rt, m.base, m.off, width, true);
}

fun is_fp_slot(f: *mir.MirFunction, op: *mir.MirOperand) bool {
    ret op.kind == mir.MIR_OP_MEM && !mir.vreg_is_nil(op.vreg) && mir.vreg_is_fp(f, op.vreg);
}

fun fmov_imm8(bits: u64, use64: bool) opt[u32] {
    var sign: u32 = 0;
    var exp:  u32 = 0;
    var frac: u32 = 0;
    var reps: u32 = 0;
    if (use64) {
        if ((bits & 0xFFFFFFFFFFFF) != 0) { ret opt[u32].none{}; }
        sign = ((bits >> 63) & 0x1)::u32;
        exp  = ((bits >> 52) & 0x7FF)::u32;
        frac = ((bits >> 48) & 0xF)::u32;
        reps = 8;
    } or {
        val b32: u32 = (bits & 0xFFFFFFFF)::u32;
        if ((b32 & 0x7FFFF) != 0) { ret opt[u32].none{}; }
        sign = (b32 >> 31) & 0x1;
        exp  = (b32 >> 23) & 0xFF;
        frac = (b32 >> 19) & 0xF;
        reps = 5;
    }
    val top: u32 = (exp >> (reps + 2)) & 0x1;
    val b:   u32 = (exp >> (reps + 1)) & 0x1;
    if (top == b) { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < reps) {
        if (((exp >> (2 + i)) & 0x1) != b) { ret opt[u32].none{}; }
        i = i + 1;
    }
    ret opt[u32].some{(sign << 7) | (b << 6) | ((exp & 0x3) << 4) | frac};
}

fun emit_fmov_imm(st: *encode.EncodeState, rd: u32, imm8: u32, use64: bool) {
    var mi: isa.Inst = inst_of(mop.FMOV_IMM, mop.vec(rd, width_bytes(use64)), isa.make_none(), isa.make_imm(imm8::i64, 1));
    emit_inst(st, ?mi);
}

fun movewide_words(bits: u64, use64: bool) u32 {
    var v: u64 = bits;
    if (!use64) { v = bits & 0xFFFFFFFF; }
    if (v == 0) { ret 1; }
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < chunks) {
        if (((v >> (16::u64 * i::u64)) & 0xFFFF) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun emit_fp_const(st: *encode.EncodeState, vd: u32, bits: u64, width: u8) err[fail.Fail] {
    if (!is_float_width(width)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float constant has a non-float width (expected 4 or 8)")};
    }
    val use64: bool = width == 8;
    var pattern: u64 = bits;
    if (!use64) { pattern = bits & 0xFFFFFFFF; }

    val w: u8 = width_bytes(use64);

    if (pattern == 0) {
        emit_cvt(st, mop.FMOV_GEN, mop.vec(vd, w), mop.gp(ZR, w));
        ret err[fail.Fail].ok{};
    }
    val i8: opt[u32] = fmov_imm8(pattern, use64);
    if (sel i8.some) {
        emit_fmov_imm(st, vd, i8.some, use64);
        ret err[fail.Fail].ok{};
    }
    if (movewide_words(pattern, use64) <= 1) {
        emit_movewide_seq(st, SCRATCH0, pattern, use64);
        emit_cvt(st, mop.FMOV_GEN, mop.vec(vd, w), mop.gp(SCRATCH0, w));
        ret err[fail.Fail].ok{};
    }

    val sr: res[intern.StrId, fail.Fail] = encode.intern_float_const(st, pattern, width);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sym: intern.StrId = sr.ok;

    val fr: res[A64Access, fail.Fail] = fp_access(width, true);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a: A64Access = fr.ok;
    val ar: err[fail.Fail] = emit_adrp_reloc(st, SCRATCH0, sym, 0);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.len::u32;
    emit_ldst_sym(st, a.op, a.fp, a.width, vd, SCRATCH0, sym, isa.SYM_MOD_PCREL_LO, 0);
    val r_1820: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), a.lo12, sym, 0);
    if (sel r_1820.err) { ret err[fail.Fail].err{r_1820.err}; }
    ret err[fail.Fail].ok{};
}

fun resolve_fp_source(st: *encode.EncodeState, f: *mir.MirFunction, op: *mir.MirOperand, scratch: u32, width: u8) res[i32, fail.Fail] {
    if (op.kind == mir.MIR_OP_MEM) {
        val mr: res[A64Mem, fail.Fail] = resolve_mem(f, op);
        if (sel mr.err) { ret res[i32, fail.Fail].err{mr.err}; }
        val m: A64Mem = mr.ok;
        if (m.has_index) { ret res[i32, fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
        val lr: err[fail.Fail] = emit_fp_mem(st, scratch, m.base, m.off, width, true);
        if (sel lr.err) { ret res[i32, fail.Fail].err{lr.err}; }
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    if (op.kind == mir.MIR_OP_IMM) {
        val cr: err[fail.Fail] = emit_fp_const(st, scratch, op.imm::u64, width);
        if (sel cr.err) { ret res[i32, fail.Fail].err{cr.err}; }
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    ret req_vec(op);
}

fun fp_arith_op(op: mir.MirOpcode) res[mop.MachOp, fail.Fail] {
    if (op == mir.MIR_FADD) { ret res[mop.MachOp, fail.Fail].ok{mop.FADD}; }
    if (op == mir.MIR_FSUB) { ret res[mop.MachOp, fail.Fail].ok{mop.FSUB}; }
    if (op == mir.MIR_FMUL) { ret res[mop.MachOp, fail.Fail].ok{mop.FMUL}; }
    if (op == mir.MIR_FDIV) { ret res[mop.MachOp, fail.Fail].ok{mop.FDIV}; }
    ret res[mop.MachOp, fail.Fail].err{fail.message("encode: aarch64 has no float arithmetic form for this opcode")};
}

fun fp_cond(cc: u8) res[u32, fail.Fail] {
    if (cc == mir.FCC_EQ) { ret res[u32, fail.Fail].ok{CC_EQ}; }
    if (cc == mir.FCC_NE) { ret res[u32, fail.Fail].ok{CC_NE}; }
    if (cc == mir.FCC_LT) { ret res[u32, fail.Fail].ok{CC_MI}; }
    if (cc == mir.FCC_LE) { ret res[u32, fail.Fail].ok{CC_LS}; }
    if (cc == mir.FCC_GT) { ret res[u32, fail.Fail].ok{CC_GT}; }
    if (cc == mir.FCC_GE) { ret res[u32, fail.Fail].ok{CC_GE}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 has no float comparison condition for this condition code")};
}

fun is_mir_float_arith(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FADD || op == mir.MIR_FSUB ||
        op == mir.MIR_FMUL || op == mir.MIR_FDIV;
}

fun is_mir_float_conv(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT ||
        op == mir.MIR_FP_TO_SI || op == mir.MIR_FP_TO_UI ||
        op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP;
}

fun encode_fp_arith(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: float arithmetic missing operands")}; }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float arithmetic has a non-float operand width (expected 4 or 8)")};
    }
    val dbl: bool = w == 8;

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH1, w);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val opr: res[mop.MachOp, fail.Fail] = fp_arith_op(mi.opcode);
    if (sel opr.err) { ret err[fail.Fail].err{opr.err}; }
    val fop: mop.MachOp = opr.ok;
    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind == mir.MIR_OP_MEM) {
        emit_fp3(st, fop, dbl, FP_SCRATCH0, rn, rm);
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    emit_fp3(st, fop, dbl, rdr.ok::u32, rn, rm);
    ret err[fail.Fail].ok{};
}

fun neon_size(vl: u32) u32 {
    val eb: u8 = mir.vec_lane_elem_bytes(vl);
    if (mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT) {
        if (eb == 8) { ret 1; }
        ret 0;
    }
    if (eb == 2) { ret 1; }
    if (eb == 4) { ret 2; }
    if (eb == 8) { ret 3; }
    ret 0;
}

fun encode_vec_lane_read(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: vector lane read missing operands")}; }
    val vl: u32 = mi.vec_lane;
    if (!mir.vec_lane_is_vector(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane read carries no lane descriptor")}; }
    val lane_op: *mir.MirOperand = ?mi.operands[2];
    if (lane_op.kind != mir.MIR_OP_IMM) { ret err[fail.Fail].err{fail.message("encode: vector lane index is not an immediate")}; }
    val index: u32 = lane_op.imm::u32;
    if (index >= mir.vec_lane_count(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane index out of range for lane arrangement")}; }

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    val is_float: bool = mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT;

    if (is_float) {
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_neon_dup_el(st, index, FP_SCRATCH1, rn, vl);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH1, mi.width);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        emit_neon_dup_el(st, index, rdr.ok::u32, rn, vl);
        ret err[fail.Fail].ok{};
    }

    if (dst.kind == mir.MIR_OP_MEM) {
        emit_neon_umov(st, index, SCRATCH0, rn, vl);
        val mr: res[A64Mem, fail.Fail] = resolve_mem(f, dst);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: A64Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed lane-read spill not expected")}; }
        ret emit_mem_access(st, SCRATCH0, m.base, m.off, mi.width, false);
    }
    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    emit_neon_umov(st, index, rdr.ok::u32, rn, vl);
    ret err[fail.Fail].ok{};
}

fun encode_vec_lane_write(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) { ret err[fail.Fail].err{fail.message("encode: vector lane write missing operands")}; }
    val vl: u32 = mi.vec_lane;
    if (!mir.vec_lane_is_vector(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane write carries no lane descriptor")}; }
    val lane_op: *mir.MirOperand = ?mi.operands[2];
    if (lane_op.kind != mir.MIR_OP_IMM) { ret err[fail.Fail].err{fail.message("encode: vector lane index is not an immediate")}; }
    val index: u32 = lane_op.imm::u32;
    if (index >= mir.vec_lane_count(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane index out of range for lane arrangement")}; }

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    var rd: u32 = FP_SCRATCH1;
    var to_slot: bool = false;
    if (dst.kind == mir.MIR_OP_MEM) {
        to_slot = true;
    }
    or {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        rd = rdr.ok::u32;
    }

    if (rd != rn) { emit_neon_3same(st, mop.V_ORR, rd, rn, rn, mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16)); }

    if (mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT) {
        val rvr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[3], FP_SCRATCH0, mi.src_width);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        emit_neon_ins_el(st, index, 0, rd, rvr.ok::u32, vl);
    }
    or {
        val rvr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[3], SCRATCH0, mir.vec_lane_elem_bytes(vl) == 8);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        var src_bytes: u8 = 4;
        if (mir.vec_lane_elem_bytes(vl) == 8) { src_bytes = 8; }
        emit_neon_ins_gp(st, index, rd, rvr.ok::u32, vl, src_bytes);
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret err[fail.Fail].ok{};
}

fun neon_op(opcode: u32, is_float: bool) mop.MachOp {
    if (opcode == arm64.VEC_ADD::u32)  { if (is_float) { ret mop.V_FADD; } ret mop.V_ADD; }
    if (opcode == arm64.VEC_SUB::u32)  { if (is_float) { ret mop.V_FSUB; } ret mop.V_SUB; }
    if (opcode == arm64.VEC_MUL::u32)  { if (is_float) { ret mop.V_FMUL; } ret mop.V_MUL; }
    if (opcode == arm64.VEC_DIV::u32)  { ret mop.V_FDIV; }
    if (opcode == arm64.VEC_AND::u32)  { ret mop.V_AND; }
    if (opcode == arm64.VEC_ORR::u32)  { ret mop.V_ORR; }
    if (opcode == arm64.VEC_EOR::u32)  { ret mop.V_EOR; }
    if (opcode == arm64.VEC_CMEQ::u32) { if (is_float) { ret mop.V_FCMEQ; } ret mop.V_CMEQ; }
    if (opcode == arm64.VEC_CMGT::u32) { if (is_float) { ret mop.V_FCMGT; } ret mop.V_CMGT; }
    if (opcode == arm64.VEC_CMGE::u32) { if (is_float) { ret mop.V_FCMGE; } ret mop.V_CMGE; }
    if (opcode == arm64.VEC_CMHI::u32) { ret mop.V_CMHI; }
    if (opcode == arm64.VEC_CMHS::u32) { ret mop.V_CMHS; }
    ret mop.MOP_NONE;
}

fun neon_3same_size_ok(op: mop.MachOp, size: u32) bool {
    if (op == mop.V_MUL) { ret size != 3; }
    ret true;
}

fun neon_arrangement_err(op: mop.MachOp, size: u32) str {
    if (op == mop.V_MUL) { ret "encode: NEON integer multiply has no 64-bit lane arrangement (MUL (vector) leaves size 3 unallocated)"; }
    ret "encode: NEON three-register-same word has no encoding at this arrangement";
}

fun encode_neon(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    val vl: u32 = mi.vec_lane;
    val is_float: bool = mir.vec_lane_kind(vl) == mir.VEC_LANE_FLOAT;
    val size: u32 = neon_size(vl);
    val op: u32 = mi.opcode;

    if (op == arm64.VEC_NOT::u32) {
        if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: vector NOT missing operands")}; }
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn: u32 = rnr.ok::u32;
        val ndst: *mir.MirOperand = ?mi.operands[0];
        if (ndst.kind == mir.MIR_OP_MEM) {
            emit_neon_2misc(st, mop.V_MVN, FP_SCRATCH0, rn);
            ret emit_fp_slot_store(st, f, ndst, FP_SCRATCH0, 16);
        }
        val rdr: res[i32, fail.Fail] = req_vec(ndst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        emit_neon_2misc(st, mop.V_MVN, rdr.ok::u32, rn);
        ret err[fail.Fail].ok{};
    }

    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: vector op missing operands")}; }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;
    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH1, 16);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    var rd: u32 = FP_SCRATCH0;
    var to_slot: bool = false;
    if (dst.kind == mir.MIR_OP_MEM) {
        to_slot = true;
    }
    or {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        rd = rdr.ok::u32;
    }

    if (op == arm64.VEC_CMNE::u32) {
        var eqop: mop.MachOp = mop.V_CMEQ;
        if (is_float) { eqop = mop.V_FCMEQ; }
        if (!neon_3same_size_ok(eqop, size)) { ret err[fail.Fail].err{fail.message(neon_arrangement_err(eqop, size))}; }
        emit_neon_3same(st, eqop, rd, rn, rm, vl);
        emit_neon_2misc(st, mop.V_MVN, rd, rd);
    }
    or {
        var eff_size: u32 = size;
        if (op == arm64.VEC_AND::u32 || op == arm64.VEC_ORR::u32 || op == arm64.VEC_EOR::u32) { eff_size = 0; }
        val vop: mop.MachOp = neon_op(op, is_float);
        if (!neon_3same_size_ok(vop, eff_size)) { ret err[fail.Fail].err{fail.message(neon_arrangement_err(vop, eff_size))}; }
        emit_neon_3same(st, vop, rd, rn, rm, vl);
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret err[fail.Fail].ok{};
}

fun encode_fp_neg(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: float negate missing operands")}; }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float negate has a non-float operand width (expected 4 or 8)")};
    }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst: *mir.MirOperand = ?mi.operands[0];
    if (dst.kind == mir.MIR_OP_MEM) {
        emit_fp2(st, mop.FNEG, w == 8, FP_SCRATCH0, rn);
        ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    emit_fp2(st, mop.FNEG, w == 8, rdr.ok::u32, rn);
    ret err[fail.Fail].ok{};
}

fun encode_fp_cmp(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: float comparison missing operands")}; }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float comparison has a non-float operand width (expected 4 or 8)")};
    }
    val cc: u8 = mi.src_width;

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], FP_SCRATCH1, w);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    emit_fcmp(st, w == 8, rn, rm);
    val ccr: res[u32, fail.Fail] = fp_cond(cc);
    if (sel ccr.err) { ret err[fail.Fail].err{ccr.err}; }
    emit_cset(st, false, rd, ccr.ok);
    ret err[fail.Fail].ok{};
}

fun encode_fp_conv(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: float conversion missing operands")}; }
    val op: mir.MirOpcode = mi.opcode;
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    if (op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT) {
        if (!is_float_width(dw) || !is_float_width(sw)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: float conversion has a non-float width on a float side (expected 4 or 8)")};
        }
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, sw);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn: u32 = rnr.ok::u32;
        val to_dbl: bool = op == mir.MIR_FP_EXT;
        val dst: *mir.MirOperand = ?mi.operands[0];
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_fcvt(st, to_dbl, FP_SCRATCH0, rn);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, dw);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        emit_fcvt(st, to_dbl, rdr.ok::u32, rn);
        ret err[fail.Fail].ok{};
    }

    if (op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP) {
        if (!is_float_width(dw)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: integer-to-float conversion has a non-float result width (expected 4 or 8)")};
        }
        val signed: bool = op == mir.MIR_SI_TO_FP;
        val gpr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
        if (sel gpr.err) { ret err[fail.Fail].err{gpr.err}; }
        var gp: u32 = gpr.ok::u32;
        var src_x: bool = sw >= 8;
        if (sw < 4) {
            emit_bitfield(st, extend_op(signed, sw), false, SCRATCH0, gp, 0, 0);
            gp = SCRATCH0;
            src_x = false;
        }
        var cop: mop.MachOp = mop.UCVTF;
        if (signed) { cop = mop.SCVTF; }
        val src: isa.Operand = mop.gp(gp, width_bytes(src_x));
        val dst: *mir.MirOperand = ?mi.operands[0];
        if (dst.kind == mir.MIR_OP_MEM) {
            emit_cvt(st, cop, mop.vec(FP_SCRATCH0, dw), src);
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, dw);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        emit_cvt(st, cop, mop.vec(rdr.ok::u32, dw), src);
        ret err[fail.Fail].ok{};
    }

    if (!is_float_width(sw)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float-to-integer conversion has a non-float source width (expected 4 or 8)")};
    }
    val signed: bool = op == mir.MIR_FP_TO_SI;
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], FP_SCRATCH0, sw);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;
    var cop: mop.MachOp = mop.FCVTZU;
    if (signed) { cop = mop.FCVTZS; }
    emit_cvt(st, cop, mop.gp(rd, width_bytes(dw >= 8)), mop.vec(rn, sw));
    ret err[fail.Fail].ok{};
}

fun encode_fmov(st: *encode.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: fmov missing operands")}; }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];

    if (mi.width == 16) {
        if (dst.kind == mir.MIR_OP_MEM) {
            val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, src, FP_SCRATCH0, 16);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            ret emit_fp_slot_store(st, f, dst, rnr.ok::u32, 16);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        val rd: u32 = rdr.ok::u32;
        if (src.kind == mir.MIR_OP_MEM) {
            ret emit_fp_slot_load(st, f, src, rd, 16);
        }
        val rnr: res[i32, fail.Fail] = req_vec(src);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn: u32 = rnr.ok::u32;
        emit_neon_3same(st, mop.V_ORR, rd, rn, rn, mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16));
        ret err[fail.Fail].ok{};
    }

    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float move has a non-float operand width (expected 4, 8 or 16)")};
    }
    val dbl: bool = w == 8;

    if (src.kind == mir.MIR_OP_IMM) {
        if (dst.kind == mir.MIR_OP_MEM) {
            val cr: err[fail.Fail] = emit_fp_const(st, FP_SCRATCH0, src.imm::u64, w);
            if (sel cr.err) { ret cr; }
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        ret emit_fp_const(st, rdr.ok::u32, src.imm::u64, w);
    }

    if (dst.kind != mir.MIR_OP_MEM && src.kind != mir.MIR_OP_MEM) {
        val dvec: bool = reg_is_vec(dst);
        val svec: bool = reg_is_vec(src);
        if (dvec && svec) {
            val rdr: res[i32, fail.Fail] = req_vec(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_vec(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            emit_fp2(st, mop.FMOV, dbl, rdr.ok::u32, rnr.ok::u32);
            ret err[fail.Fail].ok{};
        }
        if (dvec) {
            val rdr: res[i32, fail.Fail] = req_vec(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_gpr(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            emit_cvt(st, mop.FMOV_GEN, mop.vec(rdr.ok::u32, w), mop.gp(rnr.ok::u32, w));
            ret err[fail.Fail].ok{};
        }
        if (svec) {
            val rdr: res[i32, fail.Fail] = req_gpr(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_vec(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            emit_cvt(st, mop.FMOV_GEN, mop.gp(rdr.ok::u32, w), mop.vec(rnr.ok::u32, w));
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{fail.message("encode: fmov names two general-purpose registers")};
    }

    if (dst.kind == mir.MIR_OP_MEM) {
        if (src.kind == mir.MIR_OP_MEM) {
            val mr: res[A64Mem, fail.Fail] = resolve_mem(f, src);
            if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
            val m: A64Mem = mr.ok;
            if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
            val lr: err[fail.Fail] = emit_fp_mem(st, FP_SCRATCH0, m.base, m.off, w, true);
            if (sel lr.err) { ret lr; }
            ret emit_fp_slot_store(st, f, dst, FP_SCRATCH0, w);
        }
        if (reg_is_vec(src)) {
            val rnr: res[i32, fail.Fail] = req_vec(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            ret emit_fp_slot_store(st, f, dst, rnr.ok::u32, w);
        }
        ret emit_store_mem(st, f, dst, src, w);
    }

    if (reg_is_vec(dst)) {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        val mr: res[A64Mem, fail.Fail] = resolve_mem(f, src);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: A64Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
        ret emit_fp_mem(st, rdr.ok::u32, m.base, m.off, w, true);
    }
    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val mr: res[A64Mem, fail.Fail] = resolve_mem(f, src);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: A64Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
    ret emit_mem_access(st, rdr.ok::u32, m.base, m.off, w, true);
}

fun cmp_cond(op: mir.MirOpcode) res[u32, fail.Fail] {
    if (op == mir.MIR_SEL_CMP_EQ)   { ret res[u32, fail.Fail].ok{CC_EQ}; }
    if (op == mir.MIR_SEL_CMP_NE)   { ret res[u32, fail.Fail].ok{CC_NE}; }
    if (op == mir.MIR_SEL_CMP_LT_S) { ret res[u32, fail.Fail].ok{CC_LT}; }
    if (op == mir.MIR_SEL_CMP_LT_U) { ret res[u32, fail.Fail].ok{CC_CC}; }
    if (op == mir.MIR_SEL_CMP_LE_S) { ret res[u32, fail.Fail].ok{CC_LE}; }
    if (op == mir.MIR_SEL_CMP_LE_U) { ret res[u32, fail.Fail].ok{CC_LS}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 has no comparison condition for this relation")};
}

fun is_mir_compare(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_CMP_EQ || op == mir.MIR_SEL_CMP_NE ||
        op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U ||
        op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U;
}

fun narrow_cmp_source(st: *encode.EncodeState, reg: u32, scratch: u32, width: u8, signed: bool) u32 {
    if (width == 0 || width >= 4) { ret reg; }
    emit_bitfield(st, extend_op(signed, width), false, scratch, reg, 0, 0);
    ret scratch;
}

fun cmp_imm_value(imm: i64, width: u8, signed: bool) i64 {
    if (width == 1) {
        var v: i64 = imm & 0xFF;
        if (signed && (v & 0x80) != 0) { v = v - 0x100; }
        ret v;
    }
    if (width == 2) {
        var v: i64 = imm & 0xFFFF;
        if (signed && (v & 0x8000) != 0) { v = v - 0x10000; }
        ret v;
    }
    ret imm;
}

fun emit_flag_cmp(st: *encode.EncodeState, lhs_op: *mir.MirOperand, rhs_op: *mir.MirOperand,
                  width: u8, signed: bool) err[fail.Fail] {
    val use64: bool = is64(width);

    val rnr: res[i32, fail.Fail] = resolve_source(st, lhs_op, SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    var rn: u32 = rnr.ok::u32;
    rn = narrow_cmp_source(st, rn, SCRATCH1, width, signed);

    val rhs_val: i64 = cmp_imm_value(rhs_op.imm, width, signed);
    if (rhs_op.kind == mir.MIR_OP_IMM && rhs_val >= 0 && rhs_val <= 4095) {
        emit_addsub_imm(st, mop.SUBS, use64, ZR, rn, rhs_val::u32, 0);
    } or {
        val rmr: res[i32, fail.Fail] = resolve_source(st, rhs_op, SCRATCH0, use64);
        if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
        var rm: u32 = rmr.ok::u32;
        rm = narrow_cmp_source(st, rm, SCRATCH0, width, signed);
        emit_alu3(st, mop.SUBS, use64, ZR, rn, rm);
    }
    ret err[fail.Fail].ok{};
}

fun encode_compare(st: *encode.EncodeState, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: compare missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rc: err[fail.Fail] = emit_flag_cmp(st, ?mi.operands[1], ?mi.operands[2], mi.width, mir.is_signed_cmp(mi.opcode));
    if (sel rc.err) { ret rc; }

    val ccr: res[u32, fail.Fail] = cmp_cond(mi.opcode);
    if (sel ccr.err) { ret err[fail.Fail].err{ccr.err}; }
    emit_cset(st, false, rd, ccr.ok);
    ret err[fail.Fail].ok{};
}

fun encode_branch(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1 || mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: branch target is not a block")};
    }
    val target_block: u32 = mi.operands[0].imm::u32;
    if (encode.branch_falls_through(st, target_block)) { ret err[fail.Fail].ok{}; }
    val patch_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, mop.B, 0, false, 0, target_block);
    val next_ip: u32 = st.buf.len::u32;
    val r_2439: err[fail.Fail] = encode.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
    if (sel r_2439.err) { ret err[fail.Fail].err{r_2439.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_cbr(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: conditional branch missing operands")}; }
    if (mi.operands[1].kind != mir.MIR_OP_BLOCK || mi.operands[2].kind != mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch target is not a block")};
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;
    val use64: bool = is64(mi.width);

    val rcr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rcr.err) { ret err[fail.Fail].err{rcr.err}; }
    val cond: u32 = rcr.ok::u32;

    val cbnz_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, mop.CBNZ, 0, use64, cond, then_block);
    val cbnz_next: u32 = st.buf.len::u32;
    val f1: err[fail.Fail] = encode.push_fixup(st, cbnz_pos, cbnz_next, then_block, fn_base);
    if (sel f1.err) { ret err[fail.Fail].err{f1.err}; }

    if (encode.branch_falls_through(st, else_block)) { ret err[fail.Fail].ok{}; }
    val b_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, mop.B, 0, false, 0, else_block);
    val b_next: u32 = st.buf.len::u32;
    val r_2465: err[fail.Fail] = encode.push_fixup(st, b_pos, b_next, else_block, fn_base);
    if (sel r_2465.err) { ret err[fail.Fail].err{r_2465.err}; }
    ret err[fail.Fail].ok{};
}

fun fused_cbr_cond(op: mir.MirOpcode) res[u32, fail.Fail] {
    if (op == mir.MIR_SEL_CBR_EQ)   { ret res[u32, fail.Fail].ok{CC_EQ}; }
    if (op == mir.MIR_SEL_CBR_NE)   { ret res[u32, fail.Fail].ok{CC_NE}; }
    if (op == mir.MIR_SEL_CBR_LT_S) { ret res[u32, fail.Fail].ok{CC_LT}; }
    if (op == mir.MIR_SEL_CBR_LT_U) { ret res[u32, fail.Fail].ok{CC_CC}; }
    if (op == mir.MIR_SEL_CBR_LE_S) { ret res[u32, fail.Fail].ok{CC_LE}; }
    if (op == mir.MIR_SEL_CBR_LE_U) { ret res[u32, fail.Fail].ok{CC_LS}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 has no fused compare-and-branch condition for this relation")};
}

fun encode_fused_cbr(st: *encode.EncodeState, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch missing operands")};
    }
    if (mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch target is not a block")};
    }
    val then_block: u32 = mi.operands[2].imm::u32;
    val else_block: u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.len::u32;

    val rc: err[fail.Fail] = emit_flag_cmp(st, ?mi.operands[0], ?mi.operands[1], mi.width, mir.is_signed_cmp(mi.opcode));
    if (sel rc.err) { ret rc; }

    val bcc_pos: u32 = st.buf.len::u32;
    val ccr: res[u32, fail.Fail] = fused_cbr_cond(mi.opcode);
    if (sel ccr.err) { ret err[fail.Fail].err{ccr.err}; }
    emit_branch_block(st, mop.BCOND, ccr.ok, false, 0, then_block);
    val bcc_next: u32 = st.buf.len::u32;
    val f1: err[fail.Fail] = encode.push_fixup(st, bcc_pos, bcc_next, then_block, fn_base);
    if (sel f1.err) { ret err[fail.Fail].err{f1.err}; }

    if (encode.branch_falls_through(st, else_block)) {
        encode.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
        ret err[fail.Fail].ok{};
    }
    val b_pos: u32 = st.buf.len::u32;
    emit_branch_block(st, mop.B, 0, false, 0, else_block);
    val b_next: u32 = st.buf.len::u32;
    encode.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
    val r_2508: err[fail.Fail] = encode.push_fixup(st, b_pos, b_next, else_block, fn_base);
    if (sel r_2508.err) { ret err[fail.Fail].err{r_2508.err}; }
    ret err[fail.Fail].ok{};
}

fun is_mir_divide(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_DIV_U ||
        op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;
}

fun encode_divide(st: *encode.EncodeState, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: divide missing operands")}; }
    val use64: bool = is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = req_gpr(?mi.operands[2]);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val op: mir.MirOpcode = mi.opcode;
    val signed: bool = op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_REM_S;
    val rem:    bool = op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;

    emit_branch_pcrel(st, mop.CBNZ, 0, use64, rm, 2);
    emit_imm16(st, mop.BRK, 0);

    if (signed) {
        emit_addsub_imm(st, mop.ADDS, use64, ZR, rm, 1, 0);
        emit_branch_pcrel(st, mop.BCOND, CC_NE, false, 0, 5);
        var hw: u32 = 1;
        if (use64) { hw = 3; }
        emit_movewide(st, mop.MOVZ, use64, SCRATCH1, hw, 0x8000);
        emit_alu3(st, mop.SUBS, use64, ZR, rn, SCRATCH1);
        emit_branch_pcrel(st, mop.BCOND, CC_NE, false, 0, 2);
        emit_imm16(st, mop.BRK, 0);
    }

    var dop: mop.MachOp = mop.SDIV;
    if (!signed) { dop = mop.UDIV; }

    if (rem) {
        emit_alu3(st, dop, use64, SCRATCH0, rn, rm);
        emit_madd(st, mop.MSUB, use64, rd, SCRATCH0, rm, rn);
        ret err[fail.Fail].ok{};
    }
    emit_alu3(st, dop, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun popcount32(m: u32) u32 {
    var n: u32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1);
        x = x >> 1;
    }
    ret n;
}

fun align16(n: u32) u32 {
    ret (n + 15) & ~15::u32;
}

fun frame_subsize(f: *mir.MirFunction) u32 {
    val gp_bytes: u32 = popcount32(f.callee_mask) * 8;
    val fp_bytes: u32 = popcount32(f.callee_mask_fp) * 8;
    val n: u32 = align16(gp_bytes + fp_bytes + f.frame.size + f.frame.outgoing_size);
    if (f.frame.realign != 0) {
        val rmask: u32 = f.frame.realign - 1;
        ret (n + rmask) & ~rmask;
    }
    ret n;
}

fun emit_sp_sub(st: *encode.EncodeState, subsize: u32) {
    if (subsize <= 0xFFF) {
        emit_addsub_imm(st, mop.SUB, true, ZR, ZR, subsize, 0);
        ret;
    }
    if (subsize <= MAX_FRAME_SUB) {
        val hi: u32 = subsize >> 12;
        val lo: u32 = subsize & 0xFFF;
        emit_addsub_imm(st, mop.SUB, true, ZR, ZR, hi, 1);
        if (lo != 0) { emit_addsub_imm(st, mop.SUB, true, ZR, ZR, lo, 0); }
        ret;
    }
    emit_movewide_seq(st, SCRATCH0, subsize::u64, true);
    emit_alu3(st, mop.SUB, true, SP_REG, SP_REG, SCRATCH0);
}

fun emit_prologue(st: *encode.EncodeState, f: *mir.MirFunction, subsize: u32) {
    emit_ldstp(st, mop.STP, false, FP_REG, LR_REG, SP_REG, (0::u32 - 2) & 0x7F, mop.FLAG_WB_PRE);
    emit_addsub_imm(st, mop.ADD, true, FP_REG, ZR, 0, 0);
    emit_sp_realign(st, f.frame.realign);
    if (subsize > 0) { emit_sp_sub(st, subsize); }
    save_callee_gp(st, f, true);
    save_callee_fp(st, f, true);
}

fun emit_sp_realign(st: *encode.EncodeState, realign: u32) {
    if (realign == 0) { ret; }
    val k: u32 = log2_u32(realign);
    emit_addsub_imm(st, mop.ADD, true, SCRATCH0, ZR, 0, 0);
    emit_bitfield(st, mop.LSR, true, SCRATCH0, SCRATCH0, k, 0);
    emit_bitfield(st, mop.LSL, true, SCRATCH0, SCRATCH0, k, 0);
    emit_addsub_imm(st, mop.ADD, true, ZR, SCRATCH0, 0, 0);
}

fun log2_u32(n: u32) u32 {
    var k: u32 = 0;
    var v: u32 = n;
    for (v > 1) { v = v >> 1; k = k + 1; }
    ret k;
}

fun emit_epilogue(st: *encode.EncodeState, f: *mir.MirFunction, subsize: u32) {
    save_callee_fp(st, f, false);
    save_callee_gp(st, f, false);
    if (subsize > 0) {
        emit_addsub_imm(st, mop.ADD, true, ZR, FP_REG, 0, 0);
    }
    emit_ldstp(st, mop.LDP, false, FP_REG, LR_REG, SP_REG, 2, mop.FLAG_WB_POST);
}

fun save_callee_gp(st: *encode.EncodeState, f: *mir.MirFunction, store: bool) {
    var regs: [32]u32;
    var n: u32 = 0;
    var r: u32 = 0;
    for (r < 31) {
        if ((f.callee_mask & (1::u32 << r)) != 0) { regs[n] = r; n = n + 1; }
        r = r + 1;
    }
    if (n == 0) { ret; }

    val fs: i32 = f.frame.size::i32;
    val gp_bytes: u32 = n * 8;
    val num_pairs: u32 = n / 2;

    var base_reg: u32 = FP_REG;
    var anchor: i32 = fs + 16;
    if (codegen_frame.slots_from_sp(?f.frame)) {
        emit_add_imm(st, SCRATCH0, ZR, frame_subsize(f)::i64 - (fs + 16)::i64);
        base_reg = SCRATCH0;
        anchor = 0;
    } or (f.frame.size + gp_bytes > MAX_CALLEE_SAVE_REACH) {
        emit_add_imm(st, SCRATCH0, FP_REG, 0 - ((fs + 16)::i64));
        base_reg = SCRATCH0;
        anchor = 0;
    }

    var p: u32 = 0;
    for (p < num_pairs) {
        val base_off: i32 = 0 - (anchor + (16 * p)::i32);
        val imm7: u32 = (base_off / 8)::u32 & 0x7F;
        if (store) { emit_ldstp(st, mop.STP, false, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        or         { emit_ldstp(st, mop.LDP, false, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        p = p + 1;
    }
    if ((n & 1) == 1) {
        val single_off: i32 = 0 - (anchor + (16 * num_pairs)::i32 - 8);
        emit_mem_access(st, regs[n - 1], base_reg, single_off::i64, 8, !store);
    }
}

fun save_callee_fp(st: *encode.EncodeState, f: *mir.MirFunction, store: bool) {
    var regs: [32]u32;
    var n: u32 = 0;
    var r: u32 = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) { regs[n] = r; n = n + 1; }
        r = r + 1;
    }
    if (n == 0) { ret; }

    val fs: i32 = f.frame.size::i32;
    val gp_bytes: u32 = popcount32(f.callee_mask) * 8;
    val fp_bytes: u32 = n * 8;
    val num_pairs: u32 = n / 2;

    var base_reg: u32 = FP_REG;
    var anchor: i32 = fs + gp_bytes::i32 + 16;
    if (codegen_frame.slots_from_sp(?f.frame)) {
        emit_add_imm(st, SCRATCH0, ZR, frame_subsize(f)::i64 - (fs + gp_bytes::i32 + 16)::i64);
        base_reg = SCRATCH0;
        anchor = 0;
    } or (f.frame.size + gp_bytes + fp_bytes > MAX_CALLEE_SAVE_REACH) {
        emit_add_imm(st, SCRATCH0, FP_REG, 0 - ((fs + gp_bytes::i32 + 16)::i64));
        base_reg = SCRATCH0;
        anchor = 0;
    }

    var p: u32 = 0;
    for (p < num_pairs) {
        val base_off: i32 = 0 - (anchor + (16 * p)::i32);
        val imm7: u32 = (base_off / 8)::u32 & 0x7F;
        if (store) { emit_ldstp(st, mop.STP, true, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        or         { emit_ldstp(st, mop.LDP, true, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        p = p + 1;
    }
    if ((n & 1) == 1) {
        val single_off: i32 = 0 - (anchor + (16 * num_pairs)::i32 - 8);
        emit_fp_mem(st, regs[n - 1], base_reg, single_off::i64, 8, !store);
    }
}

fun encode_mir_instr(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    val op: u32 = mi.opcode;

    val rv_vb: err[fail.Fail] = encode.emit_var_bindings(st, f, mi);
    if (sel rv_vb.err) { ret err[fail.Fail].err{rv_vb.err}; }

    if (op == isa.ISA_PCOPY::u32 || op == isa.ISA_PCOPY_FENCE::u32 ||
        op == isa.ISA_USE::u32 || op == isa.ISA_LABEL::u32) {
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == mir.MIR_CALL_RES || mi.opcode == mir.MIR_ARG) {
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == mir.MIR_PHI) {
        ret err[fail.Fail].err{fail.message("internal compiler error: phi survived register allocation")};
    }

    if (is_mir_compare(mi.opcode))    { ret encode_compare(st, mi); }
    if (mi.opcode == mir.MIR_SEL_CBR) { ret encode_cbr(st, fn_base, mi); }

    if (mir.is_fused_cbr(mi.opcode)) { ret encode_fused_cbr(st, fn_base, mi); }

    if (is_mir_divide(mi.opcode)) { ret encode_divide(st, mi); }

    if (mi.opcode == mir.MIR_MOV) { ret encode_mov(st, f, mi); }

    if (mi.opcode == mir.MIR_VEC_EXTRACT) { ret encode_vec_lane_read(st, f, mi); }
    if (mi.opcode == mir.MIR_VEC_INSERT)  { ret encode_vec_lane_write(st, f, mi); }

    if (mi.opcode == mir.MIR_ALLOCA || mi.opcode == mir.MIR_GEP) { ret encode_addr(st, f, mi); }
    if (mi.opcode == mir.MIR_LOAD)                               { ret encode_load(st, f, mi); }
    if (mi.opcode == mir.MIR_STORE)                              { ret encode_store(st, f, mi); }

    if (mi.opcode == mir.MIR_TRUNC || mi.opcode == mir.MIR_SEXT ||
        mi.opcode == mir.MIR_ZEXT || mi.opcode == mir.MIR_BITCAST) {
        ret encode_convert(st, mi);
    }

    if (is_mir_float_arith(mi.opcode)) { ret encode_fp_arith(st, f, mi); }
    if (mi.opcode == mir.MIR_FNEG)     { ret encode_fp_neg(st, f, mi); }
    if (mi.opcode == mir.MIR_FCMP)     { ret encode_fp_cmp(st, f, mi); }

    if (is_mir_float_conv(mi.opcode)) { ret encode_fp_conv(st, f, mi); }

    if (mi.opcode == mir.MIR_CALL) {
        ret encode_call(st, mi);
    }
    if (mi.opcode == mir.MIR_ASM) {
        ret encode_asm_block_arm64(st, f, fn_base, mi);
    }

    if (op >= arm64.VEC_ADD::u32 && op <= arm64.VEC_CMHS::u32) { ret encode_neon(st, f, mi); }
    if (op == arm64.ADD::u32)  { ret encode_addsub(st, mi, false); }
    if (op == arm64.SUB::u32)  { ret encode_addsub(st, mi, true); }
    if (op == arm64.MUL::u32)  { ret encode_alu3(st, mi, mop.MUL); }
    if (op == arm64.AND::u32)  { ret encode_alu3(st, mi, mop.AND); }
    if (op == arm64.ORR::u32)  { ret encode_alu3(st, mi, mop.ORR); }
    if (op == arm64.EOR::u32)  { ret encode_alu3(st, mi, mop.EOR); }
    if (op == arm64.LSL::u32)  { ret encode_shift(st, mi, arm64.LSL::u32); }
    if (op == arm64.LSR::u32)  { ret encode_shift(st, mi, arm64.LSR::u32); }
    if (op == arm64.ASR::u32)  { ret encode_shift(st, mi, arm64.ASR::u32); }
    if (op == arm64.NEG::u32)  { ret encode_neg_mvn(st, mi, mop.SUB); }
    if (op == arm64.MVN::u32)  { ret encode_neg_mvn(st, mi, mop.ORN); }
    if (op == arm64.MOV::u32)  { ret encode_mov(st, f, mi); }
    if (op == arm64.FMOV::u32) { ret encode_fmov(st, f, mi); }
    if (op == arm64.B::u32)    { ret encode_branch(st, fn_base, mi); }
    if (op == arm64.RET::u32)  { emit_ret(st); ret err[fail.Fail].ok{}; }
    if (op == arm64.BRK::u32)  { emit_imm16(st, mop.BRK, 0); ret err[fail.Fail].ok{}; }
    if (op == arm64.NOP::u32)  { emit_nullary(st, mop.NOP); ret err[fail.Fail].ok{}; }

    val r_2788: err[fail.Fail] = encode.opcode_failure(st, f, "arm64", mi.opcode);
    if (sel r_2788.err) { ret err[fail.Fail].err{r_2788.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_function_arm64(st: *encode.EncodeState, f: *mir.MirFunction) err[fail.Fail] {
    val fn_base: u32 = st.buf.len::u32;
    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }

    val ms: err[fail.Fail] = encode.push_symbol(st, f.name, fn_base, of.SYM_OBJ_FLAG_FUNCTION);
    if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }

    val naked: bool = f.frame.omit;
    val subsize: u32 = f.frame.base_dist;

    if (encode.sink_active(?st.buf)) {
        val rh: err[fail.Fail] = printer.note_function(?st.buf, st.interner, f);
        if (sel rh.err) { ret rh; }
    }

    if (!naked) { emit_prologue(st, f, subsize); }
    val rp: err[fail.Fail] = check_accounted(st, PROLOGUE_REGION);
    if (sel rp.err) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        val rb: err[fail.Fail] = encode.push_block(st, fn_base, blk.id, st.buf.len::u32);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        encode.set_fallthrough(st, f, bi);

        if (encode.sink_active(?st.buf)) {
            val rl: err[fail.Fail] = printer.note_block(?st.buf, blk.id);
            if (sel rl.err) { ret rl; }
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (!mir.emits_instr(f, mi)) { ii = ii + 1; cnt; }
            val rr: err[fail.Fail] = encode.push_row(st, st.buf.len::u32, mi.loc);
            if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
            val rip: err[fail.Fail] = encode.push_inline_pc(st, st.buf.len::u32, mi.inline_site);
            if (sel rip.err) { ret err[fail.Fail].err{rip.err}; }
            if (mi.opcode == arm64.RET::u32 && !naked) {
                emit_epilogue(st, f, subsize);
            }
            encode.sink_set_mir(?st.buf, mi);
            val ei: err[fail.Fail] = encode_mir_instr(st, f, fn_base, mi);
            val eb: err[fail.Fail] = encode.note_barrier(?st.buf, mi);
            encode.sink_set_mir(?st.buf, nil);
            if (sel ei.err) { ret ei; }
            if (sel eb.err) { ret err[fail.Fail].err{eb.err}; }
            val ra: err[fail.Fail] = check_accounted(st, mi.opcode::u16);
            if (sel ra.err) { ret ra; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun patch_branch_arm64(st: *encode.EncodeState, fx: *encode.BranchFixup, target_off: u32) err[fail.Fail] {
    val pos: usize = fx.patch_pos::usize;
    if (pos + 4 > st.buf.len) {
        ret err[fail.Fail].err{fail.message("encode: branch fixup site is outside the text buffer")};
    }
    val word: u32 = read_word(?st.buf, pos);
    val sdisp: i64 = (target_off::i64) - (fx.patch_pos::i64);
    if ((sdisp & 3) != 0) {
        ret err[fail.Fail].err{fail.message("encode: aarch64 branch displacement is not 4-byte aligned")};
    }
    val disp: u32 = target_off - fx.patch_pos;

    var patched: u32 = 0;
    if ((word & 0xFC000000) == mop.form(mop.B).base) {
        if (sdisp < -134217728 || sdisp >= 134217728) {
            ret err[fail.Fail].err{fail.message("encode: aarch64 B displacement exceeds the +-128MB branch range")};
        }
        patched = (word & 0xFC000000) | ((disp & 0x0FFFFFFC) >> 2);
    } or {
        if (sdisp < -1048576 || sdisp >= 1048576) {
            ret err[fail.Fail].err{fail.message("encode: aarch64 conditional-branch displacement exceeds the +-1MB range")};
        }
        patched = (word & 0xFF00001F) | (((disp >> 2) & 0x7FFFF) << 5);
    }
    write_word(?st.buf, pos, patched);
    ret err[fail.Fail].ok{};
}

fun arm64_reloc_offset(inst_start: u32) u32 {
    ret inst_start;
}

fun arm64_hooks() encode.EncodeHooks {
    var hooks: encode.EncodeHooks = encode.hooks_blank();
    hooks.encode_function = encode_function_arm64;
    hooks.patch_branch    = patch_branch_arm64;
    hooks.stream          = true;
    hooks.effects.describe   = inst_effects;
    hooks.effects.mnemonic   = a64_mnemonic;
    hooks.effects.reg_name   = printer.reg_name;
    # index 31 is the zero register in a data position and the stack pointer
    # as a base: neither carries a value
    hooks.effects.const_regs = ct.reg_bit(31);
    ret hooks;
}

fun a64_mnemonic(op: u16) str {
    ret mop.mnemonic(op::mop.MachOp);
}

pub fun encode_arm64(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule) res[encode.EncoderOutput, fail.Fail] {
    val hooks: encode.EncodeHooks = arm64_hooks();
    ret encode.encode_module(alloc, tgt, m, ?hooks);
}

val PROLOGUE_REGION: u16 = 0xFFFF;

fun check_accounted(st: *encode.EncodeState, opcode: u16) err[fail.Fail] {
    val gap: usize = encode.sink_unaccounted(?st.buf);
    if (gap == 0) { ret err[fail.Fail].ok{}; }

    var num: [20]u8;
    var label: str = "prologue";
    if (opcode != PROLOGUE_REGION) {
        val n: usize = u64_to_dec(opcode::u64, ?num[0]);
        num[n] = 0;
        label = (?num[0])::str;
    }
    ret err[fail.Fail].err{fail.message(iasm.named_message(st.alloc, st.interner,
        "--emit-asm: opcode ", label,
        " emitted bytes the aarch64 assembly printer did not render",
        "--emit-asm: an opcode emitted bytes the assembly printer did not render"))};
}

fun u64_to_dec(n: u64, dst: *u8) usize {
    if (n == 0) { dst[0] = '0'::u8; ret 1; }
    var tmp: [20]u8;
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) { tmp[len] = (v % 10)::u8 + '0'::u8; v = v / 10; len = len + 1; }
    var k: usize = 0;
    for (k < len) { dst[k] = tmp[len - 1 - k]; k = k + 1; }
    ret len;
}

pub fun encode_arm64_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule,
                         out: *writer.Writer) res[encode.EncoderOutput, fail.Fail] {
    val hooks: encode.EncodeHooks = arm64_hooks();
    ret encode.encode_module_asm(alloc, tgt, m, ?hooks, out);
}

fun asm_parse_cond(s: str, out: *u32) bool {
    if (str_equals(s, "eq"))                        { @out = CC_EQ; ret true; }
    if (str_equals(s, "ne"))                        { @out = CC_NE; ret true; }
    if (str_equals(s, "cs") || str_equals(s, "hs")) { @out = CC_HS; ret true; }
    if (str_equals(s, "cc") || str_equals(s, "lo")) { @out = CC_CC; ret true; }
    if (str_equals(s, "mi"))                        { @out = CC_MI; ret true; }
    if (str_equals(s, "pl"))                        { @out = CC_PL; ret true; }
    if (str_equals(s, "vs"))                        { @out = CC_VS; ret true; }
    if (str_equals(s, "vc"))                        { @out = CC_VC; ret true; }
    if (str_equals(s, "hi"))                        { @out = CC_HI; ret true; }
    if (str_equals(s, "ls"))                        { @out = CC_LS; ret true; }
    if (str_equals(s, "ge"))                        { @out = CC_GE; ret true; }
    if (str_equals(s, "lt"))                        { @out = CC_LT; ret true; }
    if (str_equals(s, "gt"))                        { @out = CC_GT; ret true; }
    if (str_equals(s, "le"))                        { @out = CC_LE; ret true; }
    if (str_equals(s, "al"))                        { @out = CC_AL; ret true; }
    ret false;
}

fun asm_parse_lsl_amount(s: str, out: *u32) bool {
    if (!str_starts_with(s, "lsl")) { ret false; }
    var i: usize = 3;
    for (s[i] != 0 && iasm.is_space(s[i])) { i = i + 1; }
    val rest: str = (s::usize + i)::str;
    val r: res[i64, parse.ParseError] = parse.parse_i64_exact(rest, 0);
    if (sel r.err) { ret false; }
    val v: i64 = r.ok;
    if (v < 0) { ret false; }
    @out = v::u32;
    ret true;
}

fun asm_barrier_option(name: str, out: *u32) bool {
    if (str_equals(name, "sy"))    { @out = 15; ret true; }
    if (str_equals(name, "st"))    { @out = 14; ret true; }
    if (str_equals(name, "ld"))    { @out = 13; ret true; }
    if (str_equals(name, "ish"))   { @out = 11; ret true; }
    if (str_equals(name, "ishst")) { @out = 10; ret true; }
    if (str_equals(name, "ishld")) { @out = 9;  ret true; }
    if (str_equals(name, "nsh"))   { @out = 7;  ret true; }
    if (str_equals(name, "nshst")) { @out = 6;  ret true; }
    if (str_equals(name, "nshld")) { @out = 5;  ret true; }
    if (str_equals(name, "osh"))   { @out = 3;  ret true; }
    if (str_equals(name, "oshst")) { @out = 2;  ret true; }
    if (str_equals(name, "oshld")) { @out = 1;  ret true; }
    ret false;
}

fun emit_asm_mov_imm(st: *encode.EncodeState, rd: u32, value: u64, use64: bool) {
    var v: u64 = value;
    if (!use64) { v = value & 0xFFFFFFFF; }
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var i: u32 = 0;
    for (i < chunks) {
        val sh: u64 = 16::u64 * i::u64;
        val chunk: u64 = (v >> sh) & 0xFFFF;
        if ((chunk << sh) == v) {
            emit_movewide(st, mop.MOVZ, use64, rd, i, chunk::u32);
            ret;
        }
        i = i + 1;
    }
    emit_movewide_seq(st, rd, value, use64);
}

val A64P_NULLARY:  u16 = 1;
val A64P_RET_REG:  u16 = 2;
val A64P_IMM16:    u16 = 3;
val A64P_MOV:      u16 = 4;
val A64P_MOVEWIDE: u16 = 5;
val A64P_ADDSUB:   u16 = 6;
val A64P_LOGICAL:  u16 = 7;
val A64P_CMP:      u16 = 8;
val A64P_CSET:     u16 = 9;
val A64P_ADRP:     u16 = 10;
val A64P_BL:       u16 = 11;
val A64P_BR_REG:   u16 = 12;
val A64P_B:        u16 = 13;
val A64P_BCOND:    u16 = 14;
val A64P_CBR:      u16 = 15;
val A64P_LDST:     u16 = 16;
val A64P_LDSTP:    u16 = 17;
val A64P_DMB:      u16 = 18;
val A64P_LDORD:    u16 = 19;
val A64P_STLXR:    u16 = 20;
val A64P_SHIFT:    u16 = 21;
val A64P_MSR:      u16 = 22;
val A64P_MRS:      u16 = 23;

val A64F_COND_SHIFT: u16 = 8;
val A64F_COND_MASK:  u16 = 0x0F00;

val A64_CALLER_SAVED: u32 = 0x4007FFFF;

val A64_SMCCC_CLOBBER: u32 = 0x0003FFFF;

val A64_LR_READ: u32 = 0x40000000;

val A64_MNEMONIC_COUNT: usize = 48;

val A64_MNEMONICS: [A64_MNEMONIC_COUNT]iasm.Mnemonic = [A64_MNEMONIC_COUNT]iasm.Mnemonic{
    iasm.Mnemonic{ name: "nop",   code: mop.NOP::u32,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "yield", code: mop.YIELD::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "ret",   code: mop.RET::u32,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: A64_LR_READ, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "ret",   code: mop.RET::u32,   form: iasm.AF_OPS,  writes: iasm.AW_NONE, implicit: 0, flags: A64P_RET_REG, words: 1 },

    iasm.Mnemonic{ name: "wfi", code: mop.WFI::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },
    iasm.Mnemonic{ name: "wfe", code: mop.WFE::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: A64P_NULLARY, words: 1 },

    iasm.Mnemonic{ name: "svc", code: mop.SVC::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 1, flags: A64P_IMM16, words: 1 },
    iasm.Mnemonic{ name: "brk", code: mop.BRK::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_IMM16, words: 1 },
    iasm.Mnemonic{ name: "hvc", code: mop.HVC::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_SMCCC_CLOBBER, flags: A64P_IMM16, words: 1 },
    iasm.Mnemonic{ name: "smc", code: mop.SMC::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_SMCCC_CLOBBER, flags: A64P_IMM16, words: 1 },

    iasm.Mnemonic{ name: "movz", code: mop.MOVZ::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_MOVEWIDE, words: 1 },
    iasm.Mnemonic{ name: "movk", code: mop.MOVK::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_MOVEWIDE, words: 1 },
    iasm.Mnemonic{ name: "mov",  code: mop.MOV::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_MOV,      words: iasm.WORDS_VARIABLE },
    iasm.Mnemonic{ name: "add",  code: mop.ADD::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_ADDSUB,   words: 1 },
    iasm.Mnemonic{ name: "sub",  code: mop.SUB::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_ADDSUB,   words: 1 },
    iasm.Mnemonic{ name: "and",  code: mop.AND::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_LOGICAL,  words: 1 },
    iasm.Mnemonic{ name: "orr",  code: mop.ORR::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_LOGICAL,  words: 1 },
    iasm.Mnemonic{ name: "eor",  code: mop.EOR::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_LOGICAL,  words: 1 },
    iasm.Mnemonic{ name: "cset", code: mop.CSET::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_CSET,     words: 1 },
    iasm.Mnemonic{ name: "adrp", code: mop.ADRP::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_ADRP,     words: 1 },

    iasm.Mnemonic{ name: "cmp", code: mop.CMP::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_CMP, words: 1 },

    iasm.Mnemonic{ name: "blr",  code: mop.BLR::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_CALLER_SAVED, flags: A64P_BR_REG, words: 1 },
    iasm.Mnemonic{ name: "bl",   code: mop.BL::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_CALLER_SAVED, flags: A64P_BL,     words: 1 },
    iasm.Mnemonic{ name: "br",   code: mop.BR::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: A64_CALLER_SAVED, flags: A64P_BR_REG, words: 1 },
    iasm.Mnemonic{ name: "b",    code: mop.B::u32,    form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0,                flags: A64P_B,      words: 1 },
    iasm.Mnemonic{ name: "cbz",  code: mop.CBZ::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0,                flags: A64P_CBR,    words: 1 },
    iasm.Mnemonic{ name: "cbnz", code: mop.CBNZ::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0,                flags: A64P_CBR,    words: 1 },

    iasm.Mnemonic{ name: "ldrb", code: mop.LDRB::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "strb", code: mop.STRB::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "ldrh", code: mop.LDRH::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "strh", code: mop.STRH::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "ldr",  code: mop.LDR::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDST, words: 1 },
    iasm.Mnemonic{ name: "str",  code: mop.STR::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDST, words: 1 },

    iasm.Mnemonic{ name: "ldp", code: mop.LDP::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0 | iasm.AW_OP1 | iasm.AW_WB_BASE, implicit: 0, flags: A64P_LDSTP, words: 1 },
    iasm.Mnemonic{ name: "stp", code: mop.STP::u32, form: iasm.AF_OPS, writes: iasm.AW_WB_BASE,                             implicit: 0, flags: A64P_LDSTP, words: 1 },

    iasm.Mnemonic{ name: "ldaxr", code: mop.LDAXR::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDORD, words: 1 },
    iasm.Mnemonic{ name: "ldar",  code: mop.LDAR::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_LDORD, words: 1 },
    iasm.Mnemonic{ name: "stlxr", code: mop.STLXR::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_STLXR, words: 1 },
    iasm.Mnemonic{ name: "stlr",  code: mop.STLR::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_LDORD, words: 1 },
    iasm.Mnemonic{ name: "dmb",   code: mop.DMB::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_DMB,   words: 1 },

    iasm.Mnemonic{ name: "lslv", code: mop.LSLV::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "lsrv", code: mop.LSRV::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "asrv", code: mop.ASRV::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },

    iasm.Mnemonic{ name: "msr", code: mop.MSR::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: A64P_MSR, words: 1 },
    iasm.Mnemonic{ name: "mrs", code: mop.MRS::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: A64P_MRS, words: 1 },
    iasm.Mnemonic{ name: "lsl",  code: mop.LSL::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "lsr",  code: mop.LSR::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
    iasm.Mnemonic{ name: "asr",  code: mop.ASR::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: A64P_SHIFT, words: 1 },
};

fun a64_pattern(flags: u16) u16 { ret flags & 0x00FF; }

fun a64_cond(flags: u16) u32 { ret ((flags & A64F_COND_MASK) >> A64F_COND_SHIFT)::u32; }

fun a64_decode_bcond(body: str, lo: usize, hi: usize, m: *iasm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !iasm.is_space(body[end])) { end = end + 1; }
    val len: usize = end - lo;
    if (len < 4)                                  { ret false; }
    if (!str_region_equals(body, lo, 2, "b."))    { ret false; }

    var buf: [8]u8;
    if (!iasm.copy_region(body, lo + 2, end, ?buf[0], 8)) { ret false; }
    var cc: u32 = 0;
    if (!asm_parse_cond((?buf[0])::str, ?cc)) { ret false; }

    m.name     = nil;
    m.code     = mop.B::u32;
    m.form     = iasm.AF_OPS;
    m.writes   = iasm.AW_NONE;
    m.implicit = 0;
    m.flags    = A64P_BCOND | ((cc::u16 << A64F_COND_SHIFT) & A64F_COND_MASK);
    m.words    = 1;
    @n_out     = len;
    ret true;
}

fun a64_name_operand(pat: u16) u32 {
    if (pat == A64P_B || pat == A64P_BCOND || pat == A64P_DMB)  { ret 0; }
    if (pat == A64P_MSR)                                        { ret 0; }
    if (pat == A64P_CBR || pat == A64P_CSET || pat == A64P_MRS) { ret 1; }
    if (pat == A64P_MOVEWIDE)                                   { ret 2; }
    ret 0xFFFFFFFF;
}

fun a64_operand(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    @op = iasm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm operand")}; }

    if (c.body[lo] == '{'::char) {
        var off: i64 = 0;
        val bound_r: res[bool, fail.Fail] = iasm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op = iasm.op_mem(SP_REG::i32, off, -1, 0, 8);
            op.flags = iasm.AOF_HAS_DISP | iasm.AOF_STACK_PTR;
            ret err[fail.Fail].ok{};
        }
        op.kind     = iasm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    if (c.body[lo] == '['::char) { ret a64_mem(c, lo, hi, op); }
    if (c.body[lo] == ':'::char) { ret a64_modifier(c, lo, hi, op); }

    if (a64_reg_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }

    val iv: opt[i64] = iasm.region_i64(c.body, lo, hi);
    if (sel iv.some) { @op = iasm.op_imm(iv.some, 8); ret err[fail.Fail].ok{}; }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: malformed inline-asm operand")};
}

fun a64_reg_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "xzr")) { @op = iasm.op_reg(31, 8); ret true; }
    if (str_region_equals(body, lo, len, "wzr")) { @op = iasm.op_reg(31, 4); ret true; }
    if (str_region_equals(body, lo, len, "sp"))  { @op = iasm.op_reg(31, 8); op.flags = iasm.AOF_STACK_PTR; ret true; }
    if (str_region_equals(body, lo, len, "wsp")) { @op = iasm.op_reg(31, 4); op.flags = iasm.AOF_STACK_PTR; ret true; }

    if (len < 2 || len > 3) { ret false; }
    val c0: char = body[lo];
    if (c0 != 'x'::char && c0 != 'w'::char) { ret false; }
    var n: u32 = 0;
    var i: usize = lo + 1;
    for (i < hi) {
        if (!iasm.is_digit(body[i])) { ret false; }
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 30) { ret false; }
    var w: u8 = 4;
    if (c0 == 'x'::char) { w = 8; }
    @op = iasm.op_reg(n::i32, w);
    ret true;
}

fun a64_reg(name: str, op: *iasm.Operand) bool {
    ret a64_reg_region(name, 0, str_len(name), op);
}

fun a64_modifier(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    var close: usize = lo + 1;
    var found: bool = false;
    for (close < hi && !found) {
        if (c.body[close] == ':'::char) { found = true; } or { close = close + 1; }
    }
    if (!found) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm relocation modifier")}; }
    val nlen: usize = close - lo - 1;

    var mod: isa.SymModifier = isa.SYM_MOD_NONE;
    if (str_region_equals(c.body, lo + 1, nlen, "lo12"))      { mod = isa.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got"))       { mod = isa.SYM_MOD_GOT_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_lo12"))  { mod = isa.SYM_MOD_GOT_LO; }
    or {
        ret err[fail.Fail].err{fail.message(iasm.span_message(c,
            "encode: unsupported aarch64 inline-asm relocation modifier '", lo, hi, "'",
            "encode: unsupported aarch64 inline-asm relocation modifier"))};
    }
    if (!iasm.is_sym_region(c.body, close + 1, hi)) {
        ret err[fail.Fail].err{fail.message("encode: malformed inline-asm relocation modifier")};
    }
    @op = iasm.op_sym(close + 1, hi - close - 1, mod, 8);
    ret err[fail.Fail].ok{};
}

fun a64_mem(c: *iasm.Cursor, lo: usize, hi: usize, op: *iasm.Operand) err[fail.Fail] {
    @op = iasm.op_none();
    op.kind = iasm.AOP_MEM;
    op.size = 8;

    var end: usize = hi;
    if (c.body[end - 1] == '!'::char) { op.flags = op.flags | iasm.AOF_WRITEBACK; end = end - 1; }
    if (end < lo + 2 || c.body[end - 1] != ']'::char) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }

    val ilo: usize = lo + 1;
    val ihi: usize = end - 1;
    var comma: usize = ilo;
    var found: bool = false;
    for (comma < ihi && !found) {
        if (c.body[comma] == ','::char) { found = true; } or { comma = comma + 1; }
    }

    var bbuf: [24]u8;
    var bend: usize = ihi;
    if (found) { bend = comma; }
    if (!iasm.copy_region(c.body, ilo, bend, ?bbuf[0], 24)) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }
    var base: iasm.Operand = iasm.op_none();
    if (!a64_reg((?bbuf[0])::str, ?base)) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }
    op.reg   = base.reg;
    op.flags = op.flags | (base.flags & iasm.AOF_STACK_PTR);
    if (!found) { ret err[fail.Fail].ok{}; }

    var s: usize = comma + 1;
    var e: usize = ihi;
    for (s < e && iasm.is_space(c.body[s])) { s = s + 1; }
    for (e > s && iasm.is_space(c.body[e - 1])) { e = e - 1; }
    if (e <= s) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }

    if (c.body[s] == ':'::char) {
        var sym: iasm.Operand = iasm.op_none();
        val mr: err[fail.Fail] = a64_modifier(c, s, e, ?sym);
        if (sel mr.err) { ret mr; }
        op.flags    = op.flags | iasm.AOF_MEM_SYM;
        op.mod      = sym.mod;
        op.name_off = sym.name_off;
        op.name_len = sym.name_len;
        ret err[fail.Fail].ok{};
    }

    var ibuf: [24]u8;
    if (iasm.copy_region(c.body, s, e, ?ibuf[0], 24)) {
        var idx: iasm.Operand = iasm.op_none();
        if (a64_reg((?ibuf[0])::str, ?idx)) {
            if (a64_is_sp(?idx)) {
                ret err[fail.Fail].err{fail.message("encode: inline-asm memory index register has no sp form; register 31 there is always xzr")};
            }
            op.flags = op.flags | iasm.AOF_HAS_INDEX;
            op.index = idx.reg;
            if (idx.size == 8) { op.flags = op.flags | iasm.AOF_WIDE; }
            ret err[fail.Fail].ok{};
        }
    }
    val dv: opt[i64] = iasm.region_i64(c.body, s, e);
    if (!sel dv.some) { ret err[fail.Fail].err{fail.message("encode: malformed inline-asm memory operand")}; }
    op.imm   = dv.some;
    op.flags = op.flags | iasm.AOF_HAS_DISP;
    ret err[fail.Fail].ok{};
}

fun a64_is_addr(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_MEM || op.kind == iasm.AOP_BIND;
}

fun a64_is64(op: *iasm.Operand) bool { ret op.size == 8; }

fun a64_is_sp(op: *iasm.Operand) bool { ret (op.flags & iasm.AOF_STACK_PTR) != 0; }

fun a64_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = a64_pattern(s.m.flags);
    val n: u32 = s.nargs;
    val name_at: u32 = a64_name_operand(pat);

    var i: u32 = 0;
    for (i < n) {
        if (i != name_at) {
            val r: err[fail.Fail] = a64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }

    if (pat == A64P_NULLARY) {
        if (n != 0) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction takes no operands")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_RET_REG || pat == A64P_BR_REG) {
        if (n != 1)                            { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction expects one register")}; }
        if (item.ops[0].kind != iasm.AOP_REG)  { ret err[fail.Fail].err{fail.message("encode: inline-asm ret/blr/br operand must be a register")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_IMM16) {
        if (n != 1)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].imm < 0 || item.ops[0].imm > 0xFFFF) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm svc/brk immediate is out of 16-bit range")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MOV) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm 'mov' expects two operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'mov' destination must be a register")}; }
        if (item.ops[1].kind == iasm.AOP_REG) {
            if (item.ops[0].size != item.ops[1].size) {
                ret err[fail.Fail].err{fail.message("encode: inline-asm 'mov' operands are different widths; aarch64 has one size flag for the whole instruction")};
            }
            item.words = 1; ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind == iasm.AOP_IMM) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.message("encode: inline-asm 'mov' source must be a register or immediate")};
    }
    if (pat == A64P_MOVEWIDE) {
        if (n < 2 || n > 3)                   { ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk expects Rd, imm [, lsl N]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk needs an immediate")}; }
        if (item.ops[1].imm < 0 || item.ops[1].imm > 0xFFFF) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk immediate is out of 16-bit range")};
        }
        if (n == 3) { ret a64_shift_amount(c, s, item, 2); }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_ADDSUB || pat == A64P_LOGICAL || pat == A64P_SHIFT) {
        if (n != 3)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction expects three operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm first source must be a register")}; }
        if (item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        if (pat == A64P_LOGICAL && item.ops[2].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm and/orr/eor immediate (bitmask) form unsupported; use a register operand")};
        }
        if (pat == A64P_SHIFT && item.ops[2].kind != iasm.AOP_REG && item.ops[2].kind != iasm.AOP_IMM) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm shift count must be a register or immediate")};
        }
        # `lsl` with a register count is the lslv alias: the variable-latency
        # member, and the constant-time class must see it as one
        if (pat == A64P_SHIFT && item.ops[2].kind == iasm.AOP_REG) {
            if (item.code == mop.LSL::u32) { item.code = mop.LSLV::u32; }
            if (item.code == mop.LSR::u32) { item.code = mop.LSRV::u32; }
            if (item.code == mop.ASR::u32) { item.code = mop.ASRV::u32; }
        }
        if (item.ops[2].kind == iasm.AOP_REG && item.ops[0].size != item.ops[2].size) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_CMP) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm 'cmp' expects two operands")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'cmp' first operand must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_REG && item.ops[1].kind != iasm.AOP_IMM) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm 'cmp' second operand must be a register or imm12")};
        }
        if (item.ops[1].kind == iasm.AOP_REG && item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm 'cmp' operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_CSET) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm 'cset' expects Rd, cond")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'cset' destination must be a register")}; }
        var buf: [8]u8;
        var cc: u32 = 0;
        if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?buf[0], 8) || !asm_parse_cond((?buf[0])::str, ?cc)) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm 'cset' condition is unrecognized")};
        }
        item.flags = item.flags | ((cc::u16 << A64F_COND_SHIFT) & A64F_COND_MASK);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_ADRP) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm 'adrp' expects Xd, symbol")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'adrp' destination must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_SYM) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'adrp' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_BL) {
        if (n != 1)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm 'bl' expects a symbol")}; }
        if (item.ops[0].kind != iasm.AOP_SYM) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'bl' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_B) {
        if (n != 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'b' expects a target")}; }
        ret a64_branch_target(c, s, item, 0, true);
    }
    if (pat == A64P_BCOND) {
        if (n != 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm conditional branch expects a target")}; }
        ret a64_branch_target(c, s, item, 0, false);
    }
    if (pat == A64P_CBR) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm cbz/cbnz expects Rt, target")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm cbz/cbnz first operand must be a register")}; }
        ret a64_branch_target(c, s, item, 1, false);
    }
    if (pat == A64P_LDST) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm ldr/str expects Rt, [mem]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm ldr/str value must be a register")}; }
        if (!a64_is_addr(?item.ops[1]))       { ret err[fail.Fail].err{fail.message("encode: inline-asm ldr/str address must be a memory operand")}; }
        if ((item.ops[1].flags & iasm.AOF_WRITEBACK) != 0) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm ldr/str writeback addressing unsupported")};
        }
        if ((item.ops[1].flags & iasm.AOF_HAS_DISP) != 0) { item.words = iasm.WORDS_VARIABLE; }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_LDSTP) {
        if (n < 3 || n > 4) { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp expects Xa, Xb, [mem] [, imm]")}; }
        if (item.ops[0].kind != iasm.AOP_REG || !a64_is64(?item.ops[0])) { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[1].kind != iasm.AOP_REG || !a64_is64(?item.ops[1])) { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[2].kind != iasm.AOP_MEM)                            { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp address must be a memory operand")}; }
        if ((item.ops[2].flags & (iasm.AOF_HAS_INDEX | iasm.AOF_MEM_SYM)) != 0) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp address must be [Xn] or [Xn, imm]")};
        }
        if (n == 4) {
            if ((item.ops[2].flags & (iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK)) != 0) {
                ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp post-index base must be a bare [Xn]")};
            }
            if (item.ops[3].kind != iasm.AOP_IMM) { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp post-index needs an immediate")}; }
            item.ops[2].flags = item.ops[2].flags | iasm.AOF_WRITEBACK;
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_DMB) {
        if (n != 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm dmb expects one barrier option")}; }
        var buf: [8]u8;
        var opt_: u32 = 0;
        if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?buf[0], 8) || !asm_barrier_option((?buf[0])::str, ?opt_)) {
            ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm dmb barrier option")};
        }
        item.ops[0] = iasm.op_imm(opt_::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MSR) {
        if (n != 2) { ret err[fail.Fail].err{fail.message("encode: inline-asm msr expects a system register or PSTATE field and a source")}; }
        var nbuf: [A64_SYSREG_NAME_MAX]u8;
        if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?nbuf[0], A64_SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm msr destination name is too long")};
        }
        var op1: u32 = 0;
        var op2: u32 = 0;
        if (item.ops[1].kind == iasm.AOP_IMM) {
            if (!a64_pstate_field((?nbuf[0])::str, ?op1, ?op2)) {
                ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm msr PSTATE field")};
            }
            if (item.ops[1].imm < 0 || item.ops[1].imm > 15) {
                ret err[fail.Fail].err{fail.message("encode: inline-asm msr immediate must be 0-15")};
            }
            item.ops[0] = iasm.op_imm(((op1 << 8) | op2)::i64, 1);
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind != iasm.AOP_REG) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm msr source must be an immediate or a register")};
        }
        var op0: u32 = 0;
        var crn: u32 = 0;
        var crm: u32 = 0;
        if (!a64_sysreg((?nbuf[0])::str, ?op0, ?op1, ?crn, ?crm, ?op2)) {
            ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm msr system register")};
        }
        item.ops[0] = iasm.op_imm(a64_sysreg_pack(op0, op1, crn, crm, op2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MRS) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm mrs expects Xt, <sysreg>")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm mrs destination must be a register")}; }
        var mbuf: [A64_SYSREG_NAME_MAX]u8;
        if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?mbuf[0], A64_SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm mrs system register name is too long")};
        }
        var m0: u32 = 0;
        var m1: u32 = 0;
        var mn: u32 = 0;
        var mm: u32 = 0;
        var m2: u32 = 0;
        if (!a64_sysreg((?mbuf[0])::str, ?m0, ?m1, ?mn, ?mm, ?m2)) {
            ret err[fail.Fail].err{fail.message("encode: unsupported inline-asm mrs system register")};
        }
        item.ops[1] = iasm.op_imm(a64_sysreg_pack(m0, m1, mn, mm, m2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_LDORD) {
        if (n != 2)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm ldar/stlr/ldaxr expects Rt, [Xn]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm ldar/stlr/ldaxr value must be a register")}; }
        ret a64_bare_addr(?item.ops[1]);
    }
    if (pat == A64P_STLXR) {
        if (n != 3)                           { ret err[fail.Fail].err{fail.message("encode: inline-asm stlxr expects Ws, Rt, [Xn]")}; }
        if (item.ops[0].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm stlxr status must be a register")}; }
        if (item.ops[1].kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm stlxr value must be a register")}; }
        ret a64_bare_addr(?item.ops[2]);
    }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no parser")};
}

fun a64_bare_addr(op: *iasm.Operand) err[fail.Fail] {
    if (op.kind != iasm.AOP_MEM) { ret err[fail.Fail].err{fail.message("encode: inline-asm ordered access address must be a memory operand")}; }
    if ((op.flags & (iasm.AOF_HAS_INDEX | iasm.AOF_HAS_DISP | iasm.AOF_WRITEBACK | iasm.AOF_MEM_SYM)) != 0) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm ordered access addressing must be a bare [Xn]")};
    }
    ret err[fail.Fail].ok{};
}

fun a64_shift_amount(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32) err[fail.Fail] {
    var buf: [24]u8;
    var hw: u32 = 0;
    if (!iasm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 24)
        || !asm_parse_lsl_amount((?buf[0])::str, ?hw)) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk shift must be 'lsl N'")};
    }
    if ((hw & 0xF) != 0) { ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk shift must be a multiple of 16")}; }
    hw = hw / 16;
    if (a64_is64(?item.ops[0])) {
        if (hw > 3) { ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk 64-bit shift exceeds lsl 48")}; }
    } or {
        if (hw > 1) { ret err[fail.Fail].err{fail.message("encode: inline-asm movz/movk 32-bit shift exceeds lsl 16")}; }
    }
    item.ops[idx::usize] = iasm.op_imm(hw::i64, 1);
    ret err[fail.Fail].ok{};
}

fun a64_branch_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item, idx: u32, allow_sym: bool) err[fail.Fail] {
    val lo: usize = s.arg_lo[idx::usize];
    val hi: usize = s.arg_hi[idx::usize];
    var num: u64 = 0;
    var fwd: bool = false;
    if (iasm.label_ref_span(c.body, lo, hi, ?num, ?fwd)) {
        item.ref     = iasm.AR_LOCAL;
        item.ref_num = num;
        item.ref_fwd = fwd;
        ret err[fail.Fail].ok{};
    }
    if (iasm.is_digit(c.body[lo])) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm numeric local-label reference must be 'Nf' or 'Nb'")};
    }
    if (!allow_sym) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm conditional branch to a symbol is unsupported (no imm19 relocation kind); branch to a numeric local label instead")};
    }
    if (!iasm.is_sym_region(c.body, lo, hi)) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm 'b' target must be a symbol or a numeric local label")};
    }
    item.ref     = iasm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret err[fail.Fail].ok{};
}

fun a64_emit(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = a64_pattern(item.flags);

    if (pat == A64P_NULLARY) {
        if (item.code == mop.RET::u32) { emit_ret(st); ret err[fail.Fail].ok{}; }
        emit_nullary(st, item.code::mop.MachOp);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_RET_REG || pat == A64P_BR_REG) {
        emit_branch_reg(st, item.code::mop.MachOp, item.ops[0].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_IMM16) {
        emit_imm16(st, item.code::mop.MachOp, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MOV)      { ret a64_emit_mov(st, item); }
    if (pat == A64P_MOVEWIDE) { ret a64_emit_movewide(st, item); }
    if (pat == A64P_ADDSUB)   { ret a64_emit_addsub(st, c, item); }
    if (pat == A64P_LOGICAL)  { ret a64_emit_logical(st, item); }
    if (pat == A64P_CMP)      { ret a64_emit_cmp(st, item); }
    if (pat == A64P_CSET) {
        val use64: bool = a64_is64(?item.ops[0]);
        emit_cset(st, use64, item.ops[0].reg::u32, a64_cond(item.flags));
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_ADRP)  { ret a64_emit_adrp(st, c, item); }
    if (pat == A64P_BL)    { ret a64_emit_call(st, c, item); }
    if (pat == A64P_B || pat == A64P_BCOND || pat == A64P_CBR) { ret a64_emit_branch(st, c, l, item); }
    if (pat == A64P_LDST)  { ret a64_emit_ldst(st, c, item); }
    if (pat == A64P_LDSTP) { ret a64_emit_ldstp(st, item); }
    if (pat == A64P_DMB)   { emit_barrier(st, item.ops[0].imm::u32); ret err[fail.Fail].ok{}; }
    if (pat == A64P_MSR) {
        if (item.ops[1].kind == iasm.AOP_IMM) {
            val f: u32 = item.ops[0].imm::u32;
            emit_msr_imm(st, (f >> 8) & 0x7, f & 0x7, item.ops[1].imm::u32);
            ret err[fail.Fail].ok{};
        }
        emit_msr_reg(st, item.ops[0].imm::u32, item.ops[1].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_MRS) {
        emit_mrs(st, item.ops[1].imm::u32, item.ops[0].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_LDORD) { ret a64_emit_ldord(st, item); }
    if (pat == A64P_STLXR) {
        emit_stxr(st, a64_is64(?item.ops[1]), item.ops[0].reg::u32, item.ops[1].reg::u32, item.ops[2].reg::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == A64P_SHIFT) { ret a64_emit_shift(st, item); }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no emitter")};
}

fun a64_emit_mov(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val dst: *iasm.Operand = ?item.ops[0];
    val src: *iasm.Operand = ?item.ops[1];
    val use64: bool = a64_is64(dst);
    if (src.kind == iasm.AOP_REG) {
        if (a64_is_sp(dst) || a64_is_sp(src)) {
            emit_addsub_imm(st, mop.ADD, use64, dst.reg::u32, src.reg::u32, 0, 0);
        } or {
            emit_alu3(st, mop.ORR, use64, dst.reg::u32, ZR, src.reg::u32);
        }
        ret err[fail.Fail].ok{};
    }
    emit_asm_mov_imm(st, dst.reg::u32, src.imm::u64, use64);
    ret err[fail.Fail].ok{};
}

fun a64_emit_movewide(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val use64: bool = a64_is64(?item.ops[0]);
    var hw: u32 = 0;
    if (item.nops == 3) { hw = item.ops[2].imm::u32; }
    emit_movewide(st, item.code::mop.MachOp, use64, item.ops[0].reg::u32, hw, item.ops[1].imm::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_addsub(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val rd: *iasm.Operand = ?item.ops[0];
    val rn: *iasm.Operand = ?item.ops[1];
    val op3: *iasm.Operand = ?item.ops[2];
    val use64: bool = a64_is64(rd);
    val is_sub: bool = item.code == mop.SUB::u32;

    val aop: mop.MachOp = item.code::mop.MachOp;
    if (op3.kind == iasm.AOP_IMM) {
        val v: i64 = op3.imm;
        if (v >= 0 && v <= 4095) {
            emit_addsub_imm(st, aop, use64, rd.reg::u32, rn.reg::u32, v::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            emit_addsub_imm(st, aop, use64, rd.reg::u32, rn.reg::u32, (v >> 12)::u32, 1);
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{fail.message("encode: inline-asm add/sub immediate is out of imm12 range")};
    }
    if (op3.kind == iasm.AOP_SYM) {
        if (is_sub)                            { ret err[fail.Fail].err{fail.message("encode: inline-asm 'sub' has no :lo12: form")}; }
        if (op3.mod != isa.SYM_MOD_PCREL_LO)   { ret err[fail.Fail].err{fail.message("encode: inline-asm 'add' symbol operand must be a ':lo12:sym'")}; }
        val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, op3);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32 = st.buf.len::u32;
        emit_addsub_imm_sym(st, mop.ADD, use64, rd.reg::u32, rn.reg::u32, sid, isa.SYM_MOD_PCREL_LO, 0);
        val r_3680: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_ADD_LO12, sid, 0);
        if (sel r_3680.err) { ret err[fail.Fail].err{r_3680.err}; }
        ret err[fail.Fail].ok{};
    }
    if (a64_is_sp(rd) || a64_is_sp(rn) || a64_is_sp(op3)) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm add/sub with SP and a register operand requires the extended-register form (unsupported)")};
    }
    emit_alu3(st, aop, use64, rd.reg::u32, rn.reg::u32, op3.reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_logical(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    if (a64_is_sp(?item.ops[0]) || a64_is_sp(?item.ops[1]) || a64_is_sp(?item.ops[2])) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm logical (shifted register) has no sp operand form; register 31 there is always xzr")};
    }
    val use64: bool = a64_is64(?item.ops[0]);
    emit_alu3(st, item.code::mop.MachOp, use64, item.ops[0].reg::u32, item.ops[1].reg::u32, item.ops[2].reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_cmp(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val rn: *iasm.Operand = ?item.ops[0];
    val op2: *iasm.Operand = ?item.ops[1];
    val use64: bool = a64_is64(rn);
    if (op2.kind == iasm.AOP_IMM) {
        if (op2.imm < 0 || op2.imm > 4095) { ret err[fail.Fail].err{fail.message("encode: inline-asm 'cmp' second operand must be a register or imm12")}; }
        emit_addsub_imm(st, mop.SUBS, use64, ZR, rn.reg::u32, op2.imm::u32, 0);
        ret err[fail.Fail].ok{};
    }
    if (a64_is_sp(rn) || a64_is_sp(op2)) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm 'cmp' with sp and a register operand requires the extended-register form (unsupported)")};
    }
    emit_alu3(st, mop.SUBS, use64, ZR, rn.reg::u32, op2.reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_adrp(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val sym: *iasm.Operand = ?item.ops[1];
    if (sym.mod == isa.SYM_MOD_PCREL_LO || sym.mod == isa.SYM_MOD_GOT_LO) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm 'adrp' names a page, so its symbol takes no low-half modifier")};
    }
    val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, sym);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    if (sym.mod == isa.SYM_MOD_GOT_HI) { ret emit_adrp_got_reloc(st, item.ops[0].reg::u32, sid); }
    ret emit_adrp_reloc(st, item.ops[0].reg::u32, sid, 0);
}

fun a64_emit_call(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, ?item.ops[0]);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    val pos: u32 = st.buf.len::u32;
    emit_branch_sym(st, mop.BL, sid, 0);
    val r_3738: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_PLT32, sid, 0);
    if (sel r_3738.err) { ret err[fail.Fail].err{r_3738.err}; }
    ret err[fail.Fail].ok{};
}

fun a64_emit_branch(st: *encode.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = a64_pattern(item.flags);

    if (item.ref == iasm.AR_SYM) {
        val name: str = (c.body::usize + item.ref_off)::str;
        val sr: res[intern.StrId, A.Error] = intern.intern_bytes(st.interner, name, item.ref_len);
        if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32 = st.buf.len::u32;
        emit_branch_sym(st, mop.B, sid, 0);
        val r_3751: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_JUMP26, sid, 0);
        if (sel r_3751.err) { ret err[fail.Fail].err{r_3751.err}; }
        ret err[fail.Fail].ok{};
    }

    var bop: mop.MachOp = mop.B;
    var cc: u32 = 0;
    var rt: u32 = 0;
    var use64: bool = false;
    if (pat == A64P_BCOND) {
        bop = mop.BCOND;
        cc  = a64_cond(item.flags) & 0xF;
    }
    or (pat == A64P_CBR) {
        bop   = item.code::mop.MachOp;
        use64 = a64_is64(?item.ops[0]);
        rt    = item.ops[0].reg::u32;
    }

    val pos: u32 = st.buf.len::u32;
    emit_branch_local(st, bop, cc, use64, rt, item.ref_num, item.ref_fwd);
    ret iasm.resolve_local(st, c.g, l, pos, item.ref_num, item.ref_fwd);
}

fun a64_emit_ldst(st: *encode.EncodeState, c: *iasm.Cursor, item: *iasm.Item) err[fail.Fail] {
    val rt: *iasm.Operand = ?item.ops[0];
    val mem: *iasm.Operand = ?item.ops[1];
    val is_load: bool = item.code == mop.LDR::u32 || item.code == mop.LDRB::u32 || item.code == mop.LDRH::u32;
    var w: u8 = 4;
    if (a64_is64(rt))                                          { w = 8; }
    if (item.code == mop.LDRB::u32 || item.code == mop.STRB::u32)      { w = 1; }
    or (item.code == mop.LDRH::u32 || item.code == mop.STRH::u32)      { w = 2; }

    val fr: res[A64Access, fail.Fail] = int_access(w, is_load);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val acf: A64Access = fr.ok;

    if ((mem.flags & iasm.AOF_MEM_SYM) != 0) {
        if (mem.mod != isa.SYM_MOD_PCREL_LO && mem.mod != isa.SYM_MOD_GOT_LO) {
            ret err[fail.Fail].err{fail.message("encode: inline-asm ldr/str symbol offset must be a ':lo12:sym' or ':got_lo12:sym'")};
        }
        val sr: res[intern.StrId, fail.Fail] = a64_intern(st, c, mem);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32 = st.buf.len::u32;
        if (mem.mod == isa.SYM_MOD_GOT_LO) {
            if (!is_load || w != 8) { ret err[fail.Fail].err{fail.message("encode: inline-asm ':got_lo12:' offset takes a 64-bit load")}; }
            emit_ldst_sym(st, mop.LDR, false, 8, rt.reg::u32, mem.reg::u32, sid, isa.SYM_MOD_GOT_LO, 0);
            val r_3800: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), of.RK_GOT_LO12, sid, 0);
            if (sel r_3800.err) { ret err[fail.Fail].err{r_3800.err}; }
            ret err[fail.Fail].ok{};
        }
        emit_ldst_sym(st, acf.op, acf.fp, acf.width, rt.reg::u32, mem.reg::u32, sid, isa.SYM_MOD_PCREL_LO, 0);
        val r_3803: err[fail.Fail] = encode.push_reloc(st, arm64_reloc_offset(pos), acf.lo12, sid, 0);
        if (sel r_3803.err) { ret err[fail.Fail].err{r_3803.err}; }
        ret err[fail.Fail].ok{};
    }
    if ((mem.flags & iasm.AOF_HAS_INDEX) != 0) {
        emit_ldst_reg(st, acf.op, acf.fp, acf.width, rt.reg::u32, mem.reg::u32, mem.index::u32);
        ret err[fail.Fail].ok{};
    }
    val no_scratch_r: res[bool, fail.Fail] = mem_access_needs_no_scratch(mem.imm, w);
    if (sel no_scratch_r.err) { ret err[fail.Fail].err{no_scratch_r.err}; }
    if (!no_scratch_r.ok) {
        ret err[fail.Fail].err{fail.message(a64_offset_message(c, mem.imm))};
    }
    ret emit_mem_access(st, rt.reg::u32, mem.reg::u32, mem.imm, w, is_load);
}

fun a64_offset_message(c: *iasm.Cursor, off: i64) str {
    if (c.interner == nil) {
        ret "encode: inline-asm ldr/str offset is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first";
    }
    var buf: [24]u8;
    var v: i64 = off;
    if (v < 0) { v = 0 - v; }
    val n: usize = u64_to_dec(v::u64, ?buf[0]);
    buf[n] = 0;
    ret iasm.named_message(c.alloc, c.interner,
        "encode: inline-asm ldr/str offset ", (?buf[0])::str,
        " is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first",
        "encode: inline-asm ldr/str offset is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first");
}

fun a64_emit_ldstp(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val mem: *iasm.Operand = ?item.ops[2];
    val is_load: bool = item.code == mop.LDP::u32;
    var disp: i64 = 0;
    var wb: u16 = 0;
    if (item.nops == 4) {
        disp = item.ops[3].imm;
        wb   = mop.FLAG_WB_POST;
    } or {
        disp = mem.imm;
        if ((mem.flags & iasm.AOF_WRITEBACK) != 0) { wb = mop.FLAG_WB_PRE; }
    }
    if ((disp & 7) != 0)   { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp offset must be a multiple of 8")}; }
    val q: i64 = disp / 8;
    if (q < -64 || q > 63) { ret err[fail.Fail].err{fail.message("encode: inline-asm stp/ldp offset is out of the imm7 range")}; }
    var pop: mop.MachOp = mop.STP;
    if (is_load) { pop = mop.LDP; }
    emit_ldstp(st, pop, false, item.ops[0].reg::u32, item.ops[1].reg::u32, mem.reg::u32, q::u32 & 0x7F, wb);
    ret err[fail.Fail].ok{};
}

fun a64_emit_ldord(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val use64: bool = a64_is64(?item.ops[0]);
    emit_ldord(st, item.code::mop.MachOp, use64, item.ops[0].reg::u32, item.ops[1].reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_emit_shift(st: *encode.EncodeState, item: *iasm.Item) err[fail.Fail] {
    val rd: *iasm.Operand = ?item.ops[0];
    val rn: *iasm.Operand = ?item.ops[1];
    val cnt: *iasm.Operand = ?item.ops[2];
    if (a64_is_sp(rd) || a64_is_sp(rn) || (cnt.kind == iasm.AOP_REG && a64_is_sp(cnt))) {
        ret err[fail.Fail].err{fail.message("encode: inline-asm shift has no sp operand form; register 31 there is always xzr")};
    }
    val use64: bool = a64_is64(rd);
    var width: u32 = 32;
    if (use64) { width = 64; }

    val vform: bool = item.code == mop.LSLV::u32 || item.code == mop.LSRV::u32 || item.code == mop.ASRV::u32;
    val is_lsr: bool = item.code == mop.LSR::u32 || item.code == mop.LSRV::u32;
    val is_asr: bool = item.code == mop.ASR::u32 || item.code == mop.ASRV::u32;

    if (cnt.kind == iasm.AOP_IMM && !vform) {
        val sh: u32 = cnt.imm::u32 & (width - 1);
        var sop: mop.MachOp = mop.LSL;
        if (is_asr)     { sop = mop.ASR; }
        or (is_lsr)     { sop = mop.LSR; }
        emit_bitfield(st, sop, use64, rd.reg::u32, rn.reg::u32, sh, 0);
        ret err[fail.Fail].ok{};
    }
    if (cnt.kind != iasm.AOP_REG) { ret err[fail.Fail].err{fail.message("encode: inline-asm shift count must be a register or immediate")}; }
    var vop: mop.MachOp = mop.LSLV;
    if (is_lsr)      { vop = mop.LSRV; }
    or (is_asr)      { vop = mop.ASRV; }
    emit_alu3(st, vop, use64, rd.reg::u32, rn.reg::u32, cnt.reg::u32);
    ret err[fail.Fail].ok{};
}

fun a64_intern(st: *encode.EncodeState, c: *iasm.Cursor, op: *iasm.Operand) res[intern.StrId, fail.Fail] {
    val r_3895: res[intern.StrId, A.Error] = intern.intern_bytes(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
    if (sel r_3895.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_3895.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_3895.ok};
}

fun a64_patch(st: *encode.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    var fx: encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret patch_branch_arm64(st, ?fx, target_off);
}

fun a64_slot_from_sp(f: *mir.MirFunction) bool { ret true; }

fun a64_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << SP_REG)) != 0; }
        ret true;
    }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && a64_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && a64_is_sp(?item.ops[1])) { ret true; }
    if ((item.writes & iasm.AW_WB_BASE) != 0) {
        var i: u32 = 0;
        for (i < item.nops) {
            val op: *iasm.Operand = ?item.ops[i::usize];
            if (op.kind == iasm.AOP_MEM && (op.flags & iasm.AOF_WRITEBACK) != 0 && a64_is_sp(op)) {
                ret true;
            }
            i = i + 1;
        }
    }
    ret false;
}

fun a64_grammar() iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = "aarch64";
    g.unknown    = "unknown aarch64 inline-asm instruction '";
    g.rows       = ?A64_MNEMONICS[0];
    g.row_count  = A64_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD32[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = a64_decode_bcond;
    g.parse      = a64_parse;
    g.emit       = a64_emit;
    g.patch      = a64_patch;
    g.slot       = asm_slot_offset;
    g.slot_sp    = a64_slot_from_sp;
    g.writes_sp  = a64_writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = a64_decl_reg;
    g.no_fall    = a64_no_fall;
    ret g;
}

fun a64_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == mop.BRK::u32;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.returns(?g, body);
}

fun a64_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: iasm.Operand = iasm.op_none();
    if (a64_reg(name, ?op) && op.size == 8 && op.reg >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = op.reg::u32;
        ret true;
    }
    var n: u32 = 0;
    if (a64_vec_index(name, ?n)) {
        @bank = iasm.ABANK_FP;
        @idx  = n;
        ret true;
    }
    ret false;
}

fun a64_vec_index(name: str, out: *u32) bool {
    val len: usize = str_len(name);
    if (len < 2 || len > 3)       { ret false; }
    if (name[0] != 'v'::char)     { ret false; }
    var n: u32 = 0;
    var i: usize = 1;
    for (i < len) {
        if (!iasm.is_digit(name[i])) { ret false; }
        n = n * 10 + (name[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    @out = n;
    ret true;
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = a64_grammar();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block_arm64(st: *encode.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    var g: iasm.Grammar = a64_grammar();
    ret iasm.encode_block(st, ?g, f, mi);
}

fun a64_asm_text(st: *encode.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) err[fail.Fail] {
    var g: iasm.Grammar = a64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

var t_model_arm64: isa.MachineModel;
fun arm64_machine() *isa.MachineModel {
    t_model_arm64.pointer_width = 8;
    t_model_arm64.gpr_width     = 8;
    t_model_arm64.max_alu_width = 8;
    t_model_arm64.alu_min_width = 4;
    t_model_arm64.spill_width   = 8;
    t_model_arm64.flen_bits     = 64;
    ret ?t_model_arm64;
}

fun tbuf(st: *encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    encode.state_blank(st, alloc, arm64_machine());
}

fun tbuf_interned(st: *encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    encode.state_blank(st, alloc, arm64_machine());
    st.interner = itn;
}

fun tvec(n: i32) mir.MirOperand {
    ret mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, n)));
}

# the words the assembler produces for a spelled instruction: the packer
# tests state each expectation against `llvm-mc` output through these
fun t_asm(op: mop.MachOp, dst: isa.Operand, src1: isa.Operand, src2: isa.Operand) u32 {
    var mi: isa.Inst = inst_of(op, dst, src1, src2);
    ret mop.assemble(?mi);
}

fun t_alu(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    ret t_asm(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
}

fun t_alu_sp(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    mi.flags = mop.FLAG_SP;
    ret mop.assemble(?mi);
}

fun t_fp3(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    ret t_asm(op, mop.vec(rd, w), mop.vec(rn, w), mop.vec(rm, w));
}

fun t_imm(op: mop.MachOp, w: u8, rd: u32, rn: u32, imm12: u32, sh: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), isa.make_imm(imm12::i64, w));
    if (sh != 0) { mi.src3 = isa.make_imm(12, 1); }
    mi.flags = mop.FLAG_SP;
    ret mop.assemble(?mi);
}

fun t_mw(op: mop.MachOp, w: u8, rd: u32, hw: u32, imm16: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), isa.make_none(), isa.make_imm(imm16::i64, w));
    if (hw != 0) { mi.src3 = isa.make_imm((hw * 16)::i64, 1); }
    ret mop.assemble(?mi);
}

fun t_cset(w: u8, rd: u32, cc: u32) u32 {
    var mi: isa.Inst = inst_of(mop.CSET, mop.gp(rd, w), isa.make_none(), isa.make_none());
    mi.flags = mop.with_cond(0, cc);
    ret mop.assemble(?mi);
}

fun t_madd(op: mop.MachOp, w: u8, rd: u32, rn: u32, rm: u32, ra: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.gp(rd, w), mop.gp(rn, w), mop.gp(rm, w));
    mi.src3 = mop.gp(ra, w);
    ret mop.assemble(?mi);
}

fun t_skip(op: mop.MachOp, cc: u32, w: u8, rt: u32, imm19: u32) u32 {
    var target: isa.Operand = isa.make_local_label(true);
    target.disp = (imm19 * 4)::i32;
    var mi: isa.Inst = branch_inst(op, cc, w == 8, rt, target);
    mi.flags = mi.flags | mop.FLAG_LABEL_SKIP;
    ret mop.assemble(?mi);
}

fun t_ldst(op: mop.MachOp, fp: bool, w: u8, rt: u32, rn: u32, imm12: u32) u32 {
    val bytes: u8 = access_bytes(op, w);
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa.make_mem(mop.gp_id(rn), (imm12 * bytes::u32)::i32, -1, 0, bytes));
    ret mop.assemble(?mi);
}

fun t_ldur(op: mop.MachOp, fp: bool, w: u8, rt: u32, rn: u32, imm9: u32) u32 {
    val bytes: u8 = access_bytes(op, w);
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa.make_mem(mop.gp_id(rn), sign_extend_field(imm9, 9)::i32, -1, 0, bytes));
    ret mop.assemble(?mi);
}

fun t_ldst_reg(op: mop.MachOp, fp: bool, w: u8, rt: u32, rn: u32, rm: u32) u32 {
    val bytes: u8 = access_bytes(op, w);
    var mi: isa.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa.make_mem(mop.gp_id(rn), 0, mop.gp_id(rm), 1, bytes));
    ret mop.assemble(?mi);
}

fun t_ldstp(op: mop.MachOp, fp: bool, rt: u32, rt2: u32, rn: u32, imm7: u32) u32 {
    val mem: isa.Operand = isa.make_mem(mop.gp_id(rn), (sign_extend_field(imm7, 7) * 8)::i32, -1, 0, 8);
    var mi: isa.Inst = inst_of(op, mem, shaped_reg(fp, rt, 8), shaped_reg(fp, rt2, 8));
    if (op == mop.LDP) { mi = inst_of(op, shaped_reg(fp, rt, 8), shaped_reg(fp, rt2, 8), mem); }
    ret mop.assemble(?mi);
}

fun t_neon3(op: mop.MachOp, eb: u8, rd: u32, rn: u32, rm: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.vec(rd, 16), mop.vec(rn, 16), mop.vec(rm, 16));
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_neon2(op: mop.MachOp, rd: u32, rn: u32) u32 {
    var mi: isa.Inst = inst_of(op, mop.vec(rd, 16), mop.vec(rn, 16), isa.make_none());
    mi.flags = mop.with_elem_bytes(0, 1);
    ret mop.assemble(?mi);
}

fun t_lane_rd(op: mop.MachOp, dst: isa.Operand, eb: u8, index: u32, rn: u32) u32 {
    var mi: isa.Inst = inst_of(op, dst, mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_ins_gp(eb: u8, index: u32, rd: u32, rn: u32) u32 {
    var src_w: u8 = 4;
    if (eb == 8) { src_w = 8; }
    var mi: isa.Inst = inst_of(mop.INS, mop.vec(rd, 16), mop.gp(rn, src_w), isa.make_imm(index::i64, 1));
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_ins_el(eb: u8, index: u32, src_index: u32, rd: u32, rn: u32) u32 {
    var mi: isa.Inst = inst_of(mop.INS_EL, mop.vec(rd, 16), mop.vec(rn, 16), isa.make_imm(index::i64, 1));
    mi.src3  = isa.make_imm(src_index::i64, 1);
    mi.flags = mop.with_elem_bytes(0, eb);
    ret mop.assemble(?mi);
}

fun t_reg1(op: mop.MachOp, rn: u32) u32 {
    ret t_asm(op, isa.make_none(), mop.gp(rn, 8), isa.make_none());
}

test "mach.lang.target.isa.arm64.encode:three_address_alu_register_forms" {
    var bad: i32 = 0;
    if (t_alu(mop.ADD, 8, 0, 1, 2) != 0x8B020020) { bad = 1; }
    if (t_alu(mop.ADD, 4, 0, 1, 2) != 0x0B020020) { bad = 1; }
    if (t_alu(mop.SUB, 8, 0, 1, 2) != 0xCB020020) { bad = 1; }
    if (t_alu(mop.SUB, 4, 0, 1, 2) != 0x4B020020) { bad = 1; }
    if (t_alu(mop.MUL, 8, 0, 1, 2) != 0x9B027C20) { bad = 1; }
    if (t_alu(mop.MUL, 4, 0, 1, 2) != 0x1B027C20) { bad = 1; }
    if (t_alu(mop.AND, 8, 0, 1, 2) != 0x8A020020) { bad = 1; }
    if (t_alu(mop.ORR, 8, 0, 1, 2) != 0xAA020020) { bad = 1; }
    if (t_alu(mop.EOR, 8, 0, 1, 2) != 0xCA020020) { bad = 1; }
    if (t_alu(mop.AND, 4, 0, 1, 2) != 0x0A020020) { bad = 1; }
    if (t_alu(mop.ORR, 4, 0, 1, 2) != 0x2A020020) { bad = 1; }
    if (t_alu(mop.EOR, 4, 0, 1, 2) != 0x4A020020) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:register_shifts" {
    var bad: i32 = 0;
    if (t_alu(mop.LSLV, 8, 0, 1, 2) != 0x9AC22020) { bad = 1; }
    if (t_alu(mop.LSLV, 4, 0, 1, 2) != 0x1AC22020) { bad = 1; }
    if (t_alu(mop.LSRV, 8, 0, 1, 2) != 0x9AC22420) { bad = 1; }
    if (t_alu(mop.LSRV, 4, 0, 1, 2) != 0x1AC22420) { bad = 1; }
    if (t_alu(mop.ASRV, 8, 0, 1, 2) != 0x9AC22820) { bad = 1; }
    if (t_alu(mop.ASRV, 4, 0, 1, 2) != 0x1AC22820) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:immediate_shifts" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(0));
    ops[1] = mir.op_preg(mir.preg_id(1));
    ops[2] = mir.op_imm(3);
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 0, 0, 0);
    mi.operand_count = 3;

    mi.width = 8; encode_shift(?st, ?mi, arm64.LSL::u32);
    if (read_word(?st.buf, 0) != 0xD37DF020) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, arm64.LSL::u32);
    if (read_word(?st.buf, 4) != 0x531D7020) { bad = 1; }
    mi.width = 8; encode_shift(?st, ?mi, arm64.LSR::u32);
    if (read_word(?st.buf, 8) != 0xD343FC20) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, arm64.LSR::u32);
    if (read_word(?st.buf, 12) != 0x53037C20) { bad = 1; }
    mi.width = 8; encode_shift(?st, ?mi, arm64.ASR::u32);
    if (read_word(?st.buf, 16) != 0x9343FC20) { bad = 1; }
    mi.width = 4; encode_shift(?st, ?mi, arm64.ASR::u32);
    if (read_word(?st.buf, 20) != 0x13037C20) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neg_mvn_mov_register_forms" {
    var bad: i32 = 0;
    if (t_alu(mop.SUB, 8, 0, ZR, 1) != 0xCB0103E0) { bad = 1; }
    if (t_alu(mop.SUB, 4, 0, ZR, 1) != 0x4B0103E0) { bad = 1; }
    if (t_alu(mop.ORN, 8, 0, ZR, 1) != 0xAA2103E0) { bad = 1; }
    if (t_alu(mop.ORN, 4, 0, ZR, 1) != 0x2A2103E0) { bad = 1; }
    if (t_alu(mop.ORR, 8, 0, ZR, 1) != 0xAA0103E0) { bad = 1; }
    if (t_alu(mop.ORR, 4, 0, ZR, 1) != 0x2A0103E0) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:movz_movk_materialization" {
    var bad: i32 = 0;
    if (t_mw(mop.MOVZ, 8, 0, 0, 0x1234) != 0xD2824680) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 0, 1, 0x1234) != 0xD2A24680) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 0, 2, 0x1234) != 0xD2C24680) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 0, 3, 0x1234) != 0xD2E24680) { bad = 1; }
    if (t_mw(mop.MOVK, 8, 0, 0, 0x5678) != 0xF28ACF00) { bad = 1; }
    if (t_mw(mop.MOVK, 8, 0, 1, 0x5678) != 0xF2AACF00) { bad = 1; }
    if (t_mw(mop.MOVZ, 4, 0, 0, 0x1234) != 0x52824680) { bad = 1; }
    if (t_mw(mop.MOVK, 4, 0, 1, 0x5678) != 0x72AACF00) { bad = 1; }

    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    emit_movewide_seq(?st, 0, 0x12345678, false);
    if (st.buf.len != 8) { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != t_mw(mop.MOVZ, 4, 0, 0, 0x5678)) { bad = 1; }
        if (read_word(?st.buf, 4) != t_mw(mop.MOVK, 4, 0, 1, 0x1234)) { bad = 1; }
    }
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:add_sub_immediate_forms" {
    var bad: i32 = 0;
    if (t_imm(mop.ADD, 8, 0, 1, 5, 0) != 0x91001420) { bad = 1; }
    if (t_imm(mop.SUB, 8, 0, 1, 5, 0) != 0xD1001420) { bad = 1; }
    if (t_imm(mop.ADD, 4, 0, 1, 5, 0) != 0x11001420) { bad = 1; }
    if (t_imm(mop.SUB, 4, 0, 1, 5, 0) != 0x51001420) { bad = 1; }
    if (t_imm(mop.ADD, 8, 0, 1, 5, 1) != 0x91401420) { bad = 1; }
    if (t_imm(mop.ADD, 4, 0, 1, 5, 1) != 0x11401420) { bad = 1; }
    if (t_imm(mop.ADD, 8, ZR, ZR, 16, 0) != 0x910043FF) { bad = 1; }
    if (t_imm(mop.SUB, 8, ZR, ZR, 16, 0) != 0xD10043FF) { bad = 1; }
    if (t_imm(mop.ADD, 8, 29, ZR, 0, 0) != 0x910003FD)  { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:cmp_plus_cset" {
    var bad: i32 = 0;
    if (t_alu(mop.SUBS, 8, ZR, 0, 1) != 0xEB01001F) { bad = 1; }
    if (t_alu(mop.SUBS, 4, ZR, 0, 1) != 0x6B01001F) { bad = 1; }
    if (t_imm(mop.SUBS, 8, ZR, 0, 5, 0) != 0xF100141F) { bad = 1; }
    if (t_imm(mop.SUBS, 4, ZR, 0, 5, 0) != 0x7100141F) { bad = 1; }
    if (t_cset(4, 0, CC_EQ) != 0x1A9F17E0) { bad = 1; }
    if (t_cset(4, 0, CC_NE) != 0x1A9F07E0) { bad = 1; }
    if (t_cset(4, 0, CC_LT) != 0x1A9FA7E0) { bad = 1; }
    if (t_cset(4, 0, CC_LE) != 0x1A9FC7E0) { bad = 1; }
    if (t_cset(4, 0, CC_CC) != 0x1A9F27E0) { bad = 1; }
    if (t_cset(4, 0, CC_LS) != 0x1A9F87E0) { bad = 1; }
    if (t_cset(8, 0, CC_EQ) != 0x9A9F17E0) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:compare_with_an_immediate_lhs_materializes" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(0));
    ops[1] = mir.op_imm(48);
    ops[2] = mir.op_preg(mir.preg_id(1));
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    mi.opcode = mir.MIR_SEL_CMP_LE_U; mi.width = 1;

    val r: err[fail.Fail] = encode_compare(?st, ?mi);
    if (sel r.err) { bad = 1; }
    if (read_word(?st.buf, 0)  != 0x52800611) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0x53001E31) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0x53001C30) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x6B10023F) { bad = 1; }
    if (read_word(?st.buf, 16) != 0x1A9F87E0) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:sdiv_udiv_msub_plus_divide_trap_packers" {
    var bad: i32 = 0;
    if (t_alu(mop.SDIV, 4, 0, 1, 2) != 0x1AC20C20) { bad = 1; }
    if (t_alu(mop.SDIV, 8, 0, 1, 2) != 0x9AC20C20) { bad = 1; }
    if (t_alu(mop.UDIV, 4, 0, 1, 2) != 0x1AC20820) { bad = 1; }
    if (t_alu(mop.UDIV, 8, 0, 1, 2) != 0x9AC20820) { bad = 1; }
    if (t_madd(mop.MSUB, 4, 0, 16, 2, 1) != 0x1B028600) { bad = 1; }
    if (t_madd(mop.MSUB, 8, 0, 16, 2, 1) != 0x9B028600) { bad = 1; }
    if (t_skip(mop.CBNZ, 0, 4, 2, 2) != 0x35000042) { bad = 1; }
    if (t_skip(mop.CBNZ, 0, 8, 2, 2) != 0xB5000042) { bad = 1; }
    if (t_imm(mop.ADDS, 4, ZR, 2, 1, 0) != 0x3100045F) { bad = 1; }
    if (t_imm(mop.ADDS, 8, ZR, 2, 1, 0) != 0xB100045F) { bad = 1; }
    if (t_skip(mop.BCOND, CC_NE, 8, 0, 5) != 0x540000A1) { bad = 1; }
    if (t_skip(mop.BCOND, CC_NE, 8, 0, 2) != 0x54000041) { bad = 1; }
    if (t_mw(mop.MOVZ, 4, 17, 1, 0x8000) != 0x52B00011) { bad = 1; }
    if (t_mw(mop.MOVZ, 8, 17, 3, 0x8000) != 0xD2F00011) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:unsigned_divide_plus_div_by_zero_trap" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(0)); ops[1] = mir.op_preg(mir.preg_id(1)); ops[2] = mir.op_preg(mir.preg_id(2));
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    mi.opcode = mir.MIR_SEL_DIV_U; mi.width = 8;

    val r: err[fail.Fail] = encode_divide(?st, ?mi);
    if (sel r.err) { bad = 1; }
    if (st.buf.len != 12)       { bad = 1; }
    or {
        if (read_word(?st.buf, 0) != 0xB5000042) { bad = 1; }
        if (read_word(?st.buf, 4) != 0xD4200000) { bad = 1; }
        if (read_word(?st.buf, 8) != 0x9AC20820) { bad = 1; }
    }
    encode.buf_dnit(?st.buf);
    ret bad;
}

