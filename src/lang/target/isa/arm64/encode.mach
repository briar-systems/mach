}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_directives" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "nop");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd503201f");
    a64_asm_text(?st, ?f, ?labels, ".long 0xd503201f");
    a64_asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03, 0xd5");
    a64_asm_text(?st, ?f, ?labels, ".quad 0xd503201fd503201f");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd53be040");

    if (read_word(?st.buf, 0)  != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD53BE040) { bad = 1; }
    if (st.buf.len != 28) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_directive_refusals" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".byte 0x1f");
    if (!sel r1.err)                                                                { bad = 1; }
    or (sel r1.err) { if (!str_contains(fail.describe(r1.err), "whole number of instruction words")) { bad = 1; } }

    val r2: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03");
    if (!sel r2.err)                                                                { bad = 1; }
    or (sel r2.err) { if (!str_contains(fail.describe(r2.err), "whole number of instruction words")) { bad = 1; } }

    val r3: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".word 0x1d503201f");
    if (!sel r3.err)                                                    { bad = 1; }
    or (sel r3.err) { if (!str_contains(fail.describe(r3.err), "cannot hold")) { bad = 1; } }

    val r4: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, ".hword 0x1234");
    if (!sel r4.err)                                                                       { bad = 1; }
    or (sel r4.err) { if (!str_contains(fail.describe(r4.err), "unknown aarch64 inline-asm instruction")) { bad = 1; } }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_clobbers_data_directives_are_opaque" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xd503201f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers(".quad 0xd503201fd503201f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers("nop", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    ret bad;
}

fun t_word(text: str, want: u32) bool {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool = false;
    if (!sel r.err && st.buf.len == 4) { ok = read_word(?st.buf, 0) == want; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

fun t_word_refused(text: str, want: str) bool {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool = false;
    if (sel r.err) { ok = str_contains(fail.describe(r.err), want); }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

