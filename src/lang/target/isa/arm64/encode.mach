}

test "mach.lang.target.isa.arm64.encode:callee_save_stp_ldp_stur_pair_words" {
    var bad: i32 = 0;
    if (t_ldstp(mop.STP, false, 19, 20, 29, (0::u32 - 2) & 0x7F) != 0xA93F53B3) { bad = 1; }
    if (t_ldstp(mop.LDP, false, 19, 20, 29, (0::u32 - 2) & 0x7F) != 0xA97F53B3) { bad = 1; }
    if (t_ldstp(mop.STP, false, 21, 22, 29, (0::u32 - 4) & 0x7F) != 0xA93E5BB5) { bad = 1; }
    if (t_ldur(mop.STUR, false, 8, 21, 29, (0::u32 - 40) & 0x1FF) != 0xF81D83B5) { bad = 1; }
    if (t_ldur(mop.LDUR, false, 8, 21, 29, (0::u32 - 40) & 0x1FF) != 0xF85D83B5) { bad = 1; }
    if (t_ldstp(mop.STP, true, 8, 9, 29, (0::u32 - 2) & 0x7F) != 0x6D3F27A8) { bad = 1; }
    if (t_ldstp(mop.LDP, true, 8, 9, 29, (0::u32 - 2) & 0x7F) != 0x6D7F27A8) { bad = 1; }
    if (t_ldur(mop.STUR, true, 8, 10, 29, (0::u32 - 40) & 0x1FF) != 0xFC1D83AA) { bad = 1; }
    if (t_ldur(mop.LDUR, true, 8, 10, 29, (0::u32 - 40) & 0x1FF) != 0xFC5D83AA) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:frame_slot_ldr_str_and_spill_reload_store" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_SPILL;
    slots[0].offset = -8;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;

    var sops: [2]mir.MirOperand;
    sops[0] = mir.op_mem_slot(mir.vreg_id(100), 0);
    sops[1] = mir.op_preg(mir.preg_id(9));
    var sst: mir.MirInstr = mir.instr(mir.MIR_ADD, ?sops[0], 2, 8, 8);
    encode_store(?st, ?f, ?sst);
    if (read_word(?st.buf, 0) != 0xF81F83A9) { bad = 1; }

    var lops: [2]mir.MirOperand;
    lops[0] = mir.op_preg(mir.preg_id(9));
    lops[1] = mir.op_mem_slot(mir.vreg_id(100), 0);
    var lst: mir.MirInstr = mir.instr(mir.MIR_ADD, ?lops[0], 2, 8, 8);
    encode_load(?st, ?f, ?lst);
    if (read_word(?st.buf, 4) != 0xF85F83A9) { bad = 1; }

    var mvl: mir.MirInstr = mir.instr(mir.MIR_MOV, ?lops[0], 2, 8, 8);
    encode_mov(?st, ?f, ?mvl);
    if (read_word(?st.buf, 8) != 0xF85F83A9) { bad = 1; }
    var mvs: mir.MirInstr = mir.instr(mir.MIR_MOV, ?sops[0], 2, 8, 8);
    encode_mov(?st, ?f, ?mvs);
    if (read_word(?st.buf, 12) != 0xF81F83A9) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:scalar_fp_arithmetic_fadd_fsub_fmul_fdiv" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);

    ops[0] = tvec(0); ops[1] = tvec(1); ops[2] = tvec(2);
    mi.opcode = mir.MIR_FADD; mi.width = 4; mi.src_width = 4; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E222820) { bad = 1; }
    ops[0] = tvec(13); ops[1] = tvec(17); ops[2] = tvec(20);
    mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E742A2D) { bad = 1; }
    ops[0] = tvec(3); ops[1] = tvec(4); ops[2] = tvec(5);
    mi.opcode = mir.MIR_FSUB; mi.width = 4; mi.src_width = 4; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E253883) { bad = 1; }
    mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E653883) { bad = 1; }
    ops[0] = tvec(6); ops[1] = tvec(7); ops[2] = tvec(8);
    mi.opcode = mir.MIR_FMUL; mi.width = 4; mi.src_width = 4; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E2808E6) { bad = 1; }
    mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E6808E6) { bad = 1; }
    ops[0] = tvec(9); ops[1] = tvec(10); ops[2] = tvec(11);
    mi.opcode = mir.MIR_FDIV; mi.width = 4; mi.src_width = 4; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E2B1949) { bad = 1; }
    mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_arith(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E6B1949) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:fneg_plus_fmov_float_copy" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;
    var ops: [2]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 2, 0, 0);

    ops[0] = tvec(12); ops[1] = tvec(13);
    mi.opcode = mir.MIR_FNEG; mi.width = 4; mi.src_width = 4; st.buf.len = 0;
    encode_fp_neg(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E2141AC) { bad = 1; }
    mi.width = 8; mi.src_width = 8; st.buf.len = 0;
    encode_fp_neg(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E6141AC) { bad = 1; }

    ops[0] = tvec(16); ops[1] = tvec(17);
    mi.opcode = arm64.FMOV::u32; mi.width = 4; st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E204230) { bad = 1; }
    mi.width = 8; st.buf.len = 0;
    encode_fmov(?st, ?f, ?mi); if (read_word(?st.buf, 0) != 0x1E604230) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_refused(r: err[fail.Fail], buf: *encode.ByteBuf) bool {
    if (!sel r.err) { ret false; }
    ret buf.len == 0;
}

test "mach.lang.target.isa.arm64.encode.store:every_destination_kind_keeps_the_bank" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    var f: mir.MirFunction;

    val v_bit: u32 = 1 << 26;
    var vval: mir.MirOperand = tvec(2);
    var gval: mir.MirOperand = mir.op_preg(mir.preg_id(2));

    var pmem: mir.MirOperand = mir.op_mem_preg(mir.preg_id(1), 0);
    st.buf.len = 0;
    emit_store_mem(?st, ?f, ?pmem, ?vval, 8);
    if ((read_word(?st.buf, 0) & v_bit) == 0) { bad = 1; }
    st.buf.len = 0;
    emit_store_mem(?st, ?f, ?pmem, ?gval, 8);
    if ((read_word(?st.buf, 0) & v_bit) != 0) { bad = 1; }

    var smem: mir.MirOperand = mir.op_sym(9::intern.StrId, 0);
    st.buf.len = 0;
    emit_store_mem(?st, ?f, ?smem, ?vval, 8);
    if ((read_word(?st.buf, 4) & v_bit) == 0) { bad = 1; }
    st.buf.len = 0;
    emit_store_mem(?st, ?f, ?smem, ?gval, 8);
    if ((read_word(?st.buf, 4) & v_bit) != 0) { bad = 1; }

    var lops: [2]mir.MirOperand;
    lops[0] = tvec(2);
    lops[1] = mir.op_sym(9::intern.StrId, 0);
    var ld: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?lops[0], 2, 8, 8);
    st.buf.len = 0;
    if (!t_accepted(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }
    or { if ((read_word(?st.buf, 4) & v_bit) == 0) { bad = 1; } }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.resolvers:reject_the_wrong_bank" {
    var gp:  mir.MirOperand = mir.op_preg(mir.preg_id(2));
    var vec: mir.MirOperand = tvec(2);

    val g: res[i32, fail.Fail] = req_gpr(?gp);
    if (sel g.err)              { ret 1; }
    if (g.ok != 2)      { ret 1; }
    val v: res[i32, fail.Fail] = req_vec(?vec);
    if (sel v.err)              { ret 1; }
    if (v.ok != 2)      { ret 1; }

    val r_4599: res[i32, fail.Fail] = req_gpr(?vec);
    if (!sel r_4599.err) { ret 1; }
    val r_4600: res[i32, fail.Fail] = req_vec(?gp);
    if (!sel r_4600.err) { ret 1; }
    ret 0;
}

fun t_accepted(r: err[fail.Fail], buf: *encode.ByteBuf) bool {
    if (sel r.err) { ret false; }
    ret buf.len > 0;
}

test "mach.lang.target.isa.arm64.encode:float_width_refusals_emit_nothing" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;

    var ops: [3]mir.MirOperand;
    ops[0] = tvec(12); ops[1] = tvec(13); ops[2] = tvec(14);

    var mv: mir.MirInstr = mir.instr(arm64.FMOV::u32, ?ops[0], 2, 12, 0);
    st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 32; st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 0;  st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 1;  st.buf.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }

    mv.width = 4;  st.buf.len = 0;
    if (!t_accepted(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 8;  st.buf.len = 0;
    if (!t_accepted(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width = 16; st.buf.len = 0;
    if (!t_accepted(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }

    var ar: mir.MirInstr = mir.instr(mir.MIR_FADD, ?ops[0], 3, 16, 0);
    st.buf.len = 0;
    if (!t_refused(encode_fp_arith(?st, ?f, ?ar), ?st.buf)) { bad = 1; }
    ar.width = 4; st.buf.len = 0;
    if (!t_accepted(encode_fp_arith(?st, ?f, ?ar), ?st.buf)) { bad = 1; }

    var ng: mir.MirInstr = mir.instr(mir.MIR_FNEG, ?ops[0], 2, 16, 0);
    ng.src_width = 16; st.buf.len = 0;
    if (!t_refused(encode_fp_neg(?st, ?f, ?ng), ?st.buf)) { bad = 1; }
    ng.width = 8; ng.src_width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_neg(?st, ?f, ?ng), ?st.buf)) { bad = 1; }

    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(mir.preg_id(0)); cops[1] = tvec(13); cops[2] = tvec(14);
    var cm: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?cops[0], 3, 16, 0);
    cm.src_width = mir.FCC_EQ; st.buf.len = 0;
    if (!t_refused(encode_fp_cmp(?st, ?f, ?cm), ?st.buf)) { bad = 1; }
    cm.width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_cmp(?st, ?f, ?cm), ?st.buf)) { bad = 1; }

    var cv: mir.MirInstr = mir.instr(mir.MIR_FP_TRUNC, ?ops[0], 2, 16, 0);
    cv.src_width = 8; st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?cv), ?st.buf)) { bad = 1; }
    cv.width = 4; cv.src_width = 16; st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?cv), ?st.buf)) { bad = 1; }
    cv.width = 4; cv.src_width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_conv(?st, ?f, ?cv), ?st.buf)) { bad = 1; }

    var iops: [2]mir.MirOperand;
    iops[0] = tvec(12); iops[1] = mir.op_preg(mir.preg_id(1));
    var i2f: mir.MirInstr = mir.instr(mir.MIR_SI_TO_FP, ?iops[0], 2, 16, 0);
    i2f.src_width = 8; st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?i2f), ?st.buf)) { bad = 1; }
    i2f.width = 8; i2f.src_width = 1; st.buf.len = 0;
    if (!t_accepted(encode_fp_conv(?st, ?f, ?i2f), ?st.buf)) { bad = 1; }

    var fops: [2]mir.MirOperand;
    fops[0] = mir.op_preg(mir.preg_id(0)); fops[1] = tvec(13);
    var f2i: mir.MirInstr = mir.instr(mir.MIR_FP_TO_SI, ?fops[0], 2, 8, 0);
    f2i.src_width = 16; st.buf.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?f2i), ?st.buf)) { bad = 1; }
    f2i.width = 1; f2i.src_width = 8; st.buf.len = 0;
    if (!t_accepted(encode_fp_conv(?st, ?f, ?f2i), ?st.buf)) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:access_width_refusals_emit_nothing" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;

    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 32, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 32, false), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 0, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 12, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 100000, 32, true), ?st.buf)) { bad = 1; }

    st.buf.len = 0;
    if (!t_accepted(emit_fp_mem(?st, 0, 1, 16, 1, true), ?st.buf))  { bad = 1; }
    if (read_word(?st.buf, 0) != 0x3D404020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 1, false);
    if (read_word(?st.buf, 0) != 0x3D004020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 2, true);
    if (read_word(?st.buf, 0) != 0x7D402020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 2, false);
    if (read_word(?st.buf, 0) != 0x7D002020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 1, true);
    if (read_word(?st.buf, 0) != 0x3C5F8020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 2, true);
    if (read_word(?st.buf, 0) != 0x7C5F8020) { bad = 1; }

    st.buf.len = 0;
    if (!t_accepted(emit_fp_mem(?st, 0, 1, 16, 4, true), ?st.buf))  { bad = 1; }
    if (read_word(?st.buf, 0) != 0xBD401020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 4, false);
    if (read_word(?st.buf, 0) != 0xBD001020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 8, true);
    if (read_word(?st.buf, 0) != 0xFD400820) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 8, false);
    if (read_word(?st.buf, 0) != 0xFD000820) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 16, true);
    if (read_word(?st.buf, 0) != 0x3DC00420) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 16, false);
    if (read_word(?st.buf, 0) != 0x3D800420) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 16, true);
    if (read_word(?st.buf, 0) != 0x3CDF8020) { bad = 1; }
    st.buf.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 16, false);
    if (read_word(?st.buf, 0) != 0x3C9F8020) { bad = 1; }

    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 0, 1, 0, 16, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 0, 1, 0, 16, false), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 0, 1, 0, 3, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 0, 1, 0, 32, true), ?st.buf))  { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 0, 1, 0, 0, true), ?st.buf))   { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_mem_access(?st, 0, 1, 0, 0, false), ?st.buf))  { bad = 1; }

    st.buf.len = 0;
    emit_mem_access(?st, 0, 1, 1, 1, true);
    if (read_word(?st.buf, 0) != 0x39400420) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 0, 1, 2, 2, true);
    if (read_word(?st.buf, 0) != 0x79400420) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 0, 1, 4, 4, true);
    if (read_word(?st.buf, 0) != 0xB9400420) { bad = 1; }
    st.buf.len = 0;
    emit_mem_access(?st, 0, 1, 8, 8, true);
    if (read_word(?st.buf, 0) != 0xF9400420) { bad = 1; }

    var lops: [2]mir.MirOperand;
    lops[0] = tvec(0);
    lops[1] = mir.op_mem_preg(mir.preg_id(1), 0);
    var ld: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?lops[0], 2, 32, 0);
    ld.src_width = 32; st.buf.len = 0;
    if (!t_refused(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }
    ld.width = 16; ld.src_width = 16; st.buf.len = 0;
    if (!t_accepted(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }

    var sops: [2]mir.MirOperand;
    sops[0] = mir.op_mem_preg(mir.preg_id(1), 0);
    sops[1] = tvec(0);
    st.buf.len = 0;
    if (!t_refused(emit_store_mem(?st, ?f, ?sops[0], ?sops[1], 32), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_accepted(emit_store_mem(?st, ?f, ?sops[0], ?sops[1], 16), ?st.buf)) { bad = 1; }

    var sym: mir.MirOperand = mir.op_preg(mir.preg_id(0));
    sym.kind = mir.MIR_OP_SYM;
    sym.sym  = 1;
    var sgp: mir.MirOperand = mir.op_preg(mir.preg_id(0));
    st.buf.len = 0;
    if (!t_refused(emit_global_load(?st, 0, ?sym, 16, false), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_global_store(?st, ?f, ?sym, ?sgp, 16), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_global_load(?st, 0, ?sym, 0, false), ?st.buf))     { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_global_load_got(?st, 0, ?sym, 0, false), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_global_store_got(?st, ?f, ?sym, ?sops[1], 0), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_refused(emit_global_load(?st, 0, ?sym, 0, true), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_accepted(emit_global_store(?st, ?f, ?sym, ?sops[1], 16), ?st.buf)) { bad = 1; }
    st.buf.len = 0;
    if (!t_accepted(emit_global_load(?st, 0, ?sym, 16, true), ?st.buf)) { bad = 1; }

    st.buf.len = 0;
    if (!t_refused(emit_fp_const(?st, 0, 0x123456789ABCDEF, 16), ?st.buf)) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:fcmp_plus_cset_float_condition_mapping" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);

    ops[0] = mir.op_preg(mir.preg_id(0)); ops[1] = tvec(14); ops[2] = tvec(15);
    mi.opcode = mir.MIR_FCMP; mi.width = 8; mi.src_width = mir.FCC_EQ; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x1E6F21C0) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x1A9F17E0) { bad = 1; }

    mi.src_width = mir.FCC_NE; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi); if (read_word(?st.buf, 4) != 0x1A9F07E0) { bad = 1; }
    mi.src_width = mir.FCC_LT; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi); if (read_word(?st.buf, 4) != 0x1A9F57E0) { bad = 1; }
    mi.src_width = mir.FCC_LE; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi); if (read_word(?st.buf, 4) != 0x1A9F87E0) { bad = 1; }
    mi.src_width = mir.FCC_GT; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi); if (read_word(?st.buf, 4) != 0x1A9FD7E0) { bad = 1; }
    mi.src_width = mir.FCC_GE; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi); if (read_word(?st.buf, 4) != 0x1A9FB7E0) { bad = 1; }

    ops[0] = mir.op_preg(mir.preg_id(3)); ops[1] = tvec(21); ops[2] = tvec(9);
    mi.width = 4; mi.src_width = mir.FCC_LT; st.buf.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x1E2922A0) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x1A9F57E3) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

