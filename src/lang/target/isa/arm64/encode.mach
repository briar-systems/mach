test "mach.lang.target.isa.arm64.encode:inline_asm_symbol_relocations_record_1163_kinds" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val gr: res[intern.StrId, A.Error] = intern.intern(?interner, "gsym");
    val fr: res[intern.StrId, A.Error] = intern.intern(?interner, "fsym");
    if (sel gr.err) { ret 1; }
    if (sel fr.err) { ret 1; }
    val g:    intern.StrId = gr.ok;
    val fsym: intern.StrId = fr.ok;

    a64_asm_text(?st, ?f, ?labels, "adrp x0, gsym");
    a64_asm_text(?st, ?f, ?labels, "add x0, x0, :lo12:gsym");
    a64_asm_text(?st, ?f, ?labels, "bl fsym");
    a64_asm_text(?st, ?f, ?labels, "ldr x0, [x16, :lo12:gsym]");
    a64_asm_text(?st, ?f, ?labels, "str w1, [x16, :lo12:gsym]");
    a64_asm_text(?st, ?f, ?labels, "ldrb w0, [x16, :lo12:gsym]");

    if (read_word(?st.buf, 0) != 0x90000000)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0x91000000)  { bad = 1; }
    if (read_word(?st.buf, 8) != 0x94000000)  { bad = 1; }
    if (read_word(?st.buf, 12) != 0xF9400200) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xB9000201) { bad = 1; }
    if (read_word(?st.buf, 20) != 0x39400200) { bad = 1; }

    if (st.reloc_count != 6) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PAGE21 || st.relocs[0].offset != 0 || st.relocs[0].sym != g)       { bad = 1; }
        if (st.relocs[1].kind != of.RK_ADD_LO12 || st.relocs[1].offset != 4 || st.relocs[1].sym != g)     { bad = 1; }
        if (st.relocs[2].kind != of.RK_PLT32 || st.relocs[2].offset != 8 || st.relocs[2].sym != fsym)     { bad = 1; }
        if (st.relocs[3].kind != of.RK_LDST64_LO12 || st.relocs[3].offset != 12 || st.relocs[3].sym != g) { bad = 1; }
        if (st.relocs[4].kind != of.RK_LDST32_LO12 || st.relocs[4].offset != 16 || st.relocs[4].sym != g) { bad = 1; }
        if (st.relocs[5].kind != of.RK_LDST8_LO12 || st.relocs[5].offset != 20 || st.relocs[5].sym != g)  { bad = 1; }
    }

    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_long_symbol_operand" {
    var bad: i32 = 0;

    var st1:       encode.EncodeState;
    var alloc1:    A.Allocator;
    var interner1: intern.Interner;
    tasm(?st1, ?alloc1, ?interner1);
    var labels1: iasm.Labels;
    iasm.labels_init(?labels1, ?alloc1);
    var f1: mir.MirFunction;
    val r1: err[fail.Fail] = a64_asm_text(?st1, ?f1, ?labels1, "bl short_sym");
    if (sel r1.err) { bad = 1; }

    val long_name: str =
        "sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    val long_call: str =
        "bl sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    var st2:       encode.EncodeState;
    var alloc2:    A.Allocator;
    var interner2: intern.Interner;
    tasm(?st2, ?alloc2, ?interner2);
    var labels2: iasm.Labels;
    iasm.labels_init(?labels2, ?alloc2);
    var f2: mir.MirFunction;
    val r2: err[fail.Fail] = a64_asm_text(?st2, ?f2, ?labels2, long_call);
    if (sel r2.err) { bad = 1; }

    if (st1.buf.len != st2.buf.len) { bad = 1; }
    or {
        var i: usize = 0;
        for (i < st1.buf.len) {
            if (st1.buf.data[i] != st2.buf.data[i]) { bad = 1; }
            i = i + 1;
        }
    }

    if (st2.reloc_count == 0) { bad = 1; }
    or {
        val nm: opt[str] = intern.lookup(st2.interner, st2.relocs[st2.reloc_count - 1].sym);
        if (sel nm.some && !str_equals(nm.some, long_name)) { bad = 1; }
    }

    var st3:       encode.EncodeState;
    var alloc3:    A.Allocator;
    var interner3: intern.Interner;
    tasm(?st3, ?alloc3, ?interner3);
    var labels3: iasm.Labels;
    iasm.labels_init(?labels3, ?alloc3);
    var f3: mir.MirFunction;
    val r3: err[fail.Fail] = a64_asm_text(?st3, ?f3, ?labels3, "ldr x0, [x0");
    if (sel r3.ok) { bad = 1; }

    if (st1.relocs != nil && st1.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc1, st1.relocs, st1.reloc_cap::usize);
    }
    if (st2.relocs != nil && st2.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc2, st2.relocs, st2.reloc_cap::usize);
    }
    if (st3.relocs != nil && st3.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc3, st3.relocs, st3.reloc_cap::usize);
    }
    iasm.labels_dnit(?labels1);
    encode.buf_dnit(?st1.buf);
    iasm.labels_dnit(?labels2);
    encode.buf_dnit(?st2.buf);
    iasm.labels_dnit(?labels3);
    encode.buf_dnit(?st3.buf);
    ret bad;
}

