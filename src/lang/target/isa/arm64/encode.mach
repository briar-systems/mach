    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

#[testing]
fun t_refused(r: err[fail.Fail], buf: *isa_encode.ByteBuf) bool {
    if (!sel r.err) { ret false; }
    ret buf.bytes.len == 0;
}

test store__every_destination_kind_keeps_the_bank {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    var f: lang_mir.MirFunction;

    val v_bit: u32                 = 1 << 26;
    var vval:  lang_mir.MirOperand = tvec(2);
    var gval:  lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)));

    var pmem: lang_mir.MirOperand = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)), 0);
    st.buf.bytes.len = 0;
    emit_store_mem(?st, ?f, ?pmem, ?vval, 8);
    if ((isa_encode.word_read(?st.buf, 0) & v_bit) == 0) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_store_mem(?st, ?f, ?pmem, ?gval, 8);
    if ((isa_encode.word_read(?st.buf, 0) & v_bit) != 0) { bad = 1; }

    var smem: lang_mir.MirOperand = lang_mir.op_sym(intern.str_id(9), 0);
    st.buf.bytes.len = 0;
    emit_store_mem(?st, ?f, ?smem, ?vval, 8);
    if ((isa_encode.word_read(?st.buf, 4) & v_bit) == 0) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_store_mem(?st, ?f, ?smem, ?gval, 8);
    if ((isa_encode.word_read(?st.buf, 4) & v_bit) != 0) { bad = 1; }

    var lops: [2]lang_mir.MirOperand;
    lops[0] = tvec(2);
    lops[1] = lang_mir.op_sym(intern.str_id(9), 0);
    var ld: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_LOAD, ?lops[0], 2, 8, 8);
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }
    or {
        if ((isa_encode.word_read(?st.buf, 4) & v_bit) == 0) { bad = 1; }
    }

    ret bad;
}

test resolvers__reject_the_wrong_bank {
    var gp:  lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)));
    var vec: lang_mir.MirOperand = tvec(2);

    val g: res[i32, fail.Fail] = req_gpr(?gp);
    if (sel g.err) { ret 1; }
    if (g.ok != 2) { ret 1; }
    val v: res[i32, fail.Fail] = req_vec(?vec);
    if (sel v.err) { ret 1; }
    if (v.ok != 2) { ret 1; }

    val gpr: res[i32, fail.Fail] = req_gpr(?vec);
    if (!sel gpr.err) { ret 1; }
    val vec_reg: res[i32, fail.Fail] = req_vec(?gp);
    if (!sel vec_reg.err) { ret 1; }
    ret 0;
}

#[testing]
fun t_accepted(r: err[fail.Fail], buf: *isa_encode.ByteBuf) bool {
    if (sel r.err) { ret false; }
    ret buf.bytes.len > 0;
}

test float_width__refusals_emit_nothing {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f: lang_mir.MirFunction;

    var ops: [3]lang_mir.MirOperand;
    ops[0] = tvec(12);
    ops[1] = tvec(13);
    ops[2] = tvec(14);

    var mv: lang_mir.MirInstr = lang_mir.instr(arm64.FMOV::u32, ?ops[0], 2, 12, 0);
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width         = 32;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width         = 0;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width         = 1;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }

    mv.width         = 4;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width         = 8;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }
    mv.width         = 16;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fmov(?st, ?f, ?mv), ?st.buf)) { bad = 1; }

    var ar: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_FADD, ?ops[0], 3, 16, 0);
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_arith(?st, ?f, ?ar), ?st.buf)) { bad = 1; }
    ar.width         = 4;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fp_arith(?st, ?f, ?ar), ?st.buf)) { bad = 1; }

    var ng: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_FNEG, ?ops[0], 2, 16, 0);
    ng.src_width     = 16;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_neg(?st, ?f, ?ng), ?st.buf)) { bad = 1; }
    ng.width         = 8;
    ng.src_width     = 8;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fp_neg(?st, ?f, ?ng), ?st.buf)) { bad = 1; }

    var cops: [3]lang_mir.MirOperand;
    cops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    cops[1] = tvec(13);
    cops[2] = tvec(14);
    var cm: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_FCMP, ?cops[0], 3, 16, 0);
    cm.src_width     = lang_mir.FCC_EQ;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_cmp(?st, ?f, ?cm), ?st.buf)) { bad = 1; }
    cm.width         = 8;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fp_cmp(?st, ?f, ?cm), ?st.buf)) { bad = 1; }

    var cv: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_FP_TRUNC, ?ops[0], 2, 16, 0);
    cv.src_width     = 8;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?cv), ?st.buf)) { bad = 1; }
    cv.width         = 4;
    cv.src_width     = 16;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?cv), ?st.buf)) { bad = 1; }
    cv.width         = 4;
    cv.src_width     = 8;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fp_conv(?st, ?f, ?cv), ?st.buf)) { bad = 1; }

    var iops: [2]lang_mir.MirOperand;
    iops[0] = tvec(12);
    iops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    var i2f: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_SI_TO_FP, ?iops[0], 2, 16, 0);
    i2f.src_width    = 8;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?i2f), ?st.buf)) { bad = 1; }
    i2f.width        = 8;
    i2f.src_width    = 1;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fp_conv(?st, ?f, ?i2f), ?st.buf)) { bad = 1; }

    var fops: [2]lang_mir.MirOperand;
    fops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    fops[1] = tvec(13);
    var f2i: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_FP_TO_SI, ?fops[0], 2, 8, 0);
    f2i.src_width    = 16;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_fp_conv(?st, ?f, ?f2i), ?st.buf)) { bad = 1; }
    f2i.width        = 1;
    f2i.src_width    = 8;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_fp_conv(?st, ?f, ?f2i), ?st.buf)) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test access_width__refusals_emit_nothing {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f: lang_mir.MirFunction;

    st.buf.bytes.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 32, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 32, false), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 0, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 0, 12, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_fp_mem(?st, 0, 1, 100000, 32, true), ?st.buf)) { bad = 1; }

    st.buf.bytes.len = 0;
    if (!t_accepted(emit_fp_mem(?st, 0, 1, 16, 1, true), ?st.buf)) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x3D404020)            { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 1, false);
    if (isa_encode.word_read(?st.buf, 0) != 0x3D004020) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 2, true);
    if (isa_encode.word_read(?st.buf, 0) != 0x7D402020) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 1, true);
    if (isa_encode.word_read(?st.buf, 0) != 0x3C5F8020) { bad = 1; }

    st.buf.bytes.len = 0;
    if (!t_accepted(emit_fp_mem(?st, 0, 1, 16, 4, true), ?st.buf)) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0xBD401020)            { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 8, true);
    if (isa_encode.word_read(?st.buf, 0) != 0xFD400820) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 16, true);
    if (isa_encode.word_read(?st.buf, 0) != 0x3DC00420) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 16, 16, false);
    if (isa_encode.word_read(?st.buf, 0) != 0x3D800420) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 16, true);
    if (isa_encode.word_read(?st.buf, 0) != 0x3CDF8020) { bad = 1; }
    st.buf.bytes.len = 0;
    emit_fp_mem(?st, 0, 1, 0 - 8, 16, false);
    if (isa_encode.word_read(?st.buf, 0) != 0x3C9F8020) { bad = 1; }

    st.buf.bytes.len = 0;
    if (!t_refused(arm64_emit.mem_access(?st, 0, 1, 0, 16, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(arm64_emit.mem_access(?st, 0, 1, 0, 16, false), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(arm64_emit.mem_access(?st, 0, 1, 0, 3, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(arm64_emit.mem_access(?st, 0, 1, 0, 32, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(arm64_emit.mem_access(?st, 0, 1, 0, 0, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(arm64_emit.mem_access(?st, 0, 1, 0, 0, false), ?st.buf)) { bad = 1; }

    var lops: [2]lang_mir.MirOperand;
    lops[0] = tvec(0);
    lops[1] = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)), 0);
    var ld: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_LOAD, ?lops[0], 2, 32, 0);
    ld.src_width     = 32;
    st.buf.bytes.len = 0;
    if (!t_refused(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }
    ld.width         = 16;
    ld.src_width     = 16;
    st.buf.bytes.len = 0;
    if (!t_accepted(encode_load(?st, ?f, ?ld), ?st.buf)) { bad = 1; }

    var sops: [2]lang_mir.MirOperand;
    sops[0]          = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)), 0);
    sops[1]          = tvec(0);
    st.buf.bytes.len = 0;
    if (!t_refused(emit_store_mem(?st, ?f, ?sops[0], ?sops[1], 32), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_accepted(emit_store_mem(?st, ?f, ?sops[0], ?sops[1], 16), ?st.buf)) { bad = 1; }

    var sym: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    sym.kind = lang_mir.MIR_OP_SYM;
    sym.sym  = intern.str_id(1);
    var sgp: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    st.buf.bytes.len = 0;
    if (!t_refused(emit_global_load(?st, 0, ?sym, 16, false), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_global_store(?st, ?f, ?sym, ?sgp, 16), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_global_load(?st, 0, ?sym, 0, false), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_global_load_got(?st, 0, ?sym, 0, false), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_global_store_got(?st, ?f, ?sym, ?sops[1], 0), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_refused(emit_global_load(?st, 0, ?sym, 0, true), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_accepted(emit_global_store(?st, ?f, ?sym, ?sops[1], 16), ?st.buf)) { bad = 1; }
    st.buf.bytes.len = 0;
    if (!t_accepted(emit_global_load(?st, 0, ?sym, 16, true), ?st.buf)) { bad = 1; }

    st.buf.bytes.len = 0;
    if (!t_refused(emit_fp_const(?st, 0, 0x123456789ABCDEF, 16), ?st.buf)) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_fp_cmp__condition_mapping {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f:   lang_mir.MirFunction;
    var ops: [3]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);

    ops[0]           = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1]           = tvec(14);
    ops[2]           = tvec(15);
    mi.opcode        = lang_mir.MIR_FCMP;
    mi.width         = 8;
    mi.src_width     = lang_mir.FCC_EQ;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E6F21C0) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9F17E0) { bad = 1; }

    mi.src_width     = lang_mir.FCC_NE;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9F07E0) { bad = 1; }
    mi.src_width     = lang_mir.FCC_LT;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9F57E0) { bad = 1; }
    mi.src_width     = lang_mir.FCC_LE;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9F87E0) { bad = 1; }
    mi.src_width     = lang_mir.FCC_GT;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9FD7E0) { bad = 1; }
    mi.src_width     = lang_mir.FCC_GE;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9FB7E0) { bad = 1; }

    ops[0]           = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 3)));
    ops[1]           = tvec(21);
    ops[2]           = tvec(9);
    mi.width         = 4;
    mi.src_width     = lang_mir.FCC_LT;
    st.buf.bytes.len = 0;
    encode_fp_cmp(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E2922A0) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x1A9F57E3) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_fp_conv__int_to_float {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    var f:   lang_mir.MirFunction;
    var ops: [2]lang_mir.MirOperand;
    var mi:  lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 2, 0, 0);

    ops[0]           = tvec(0);
    ops[1]           = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    mi.opcode        = lang_mir.MIR_SI_TO_FP;
    mi.width         = 4;
    mi.src_width     = 4;
    st.buf.bytes.len = 0;
    encode_fp_conv(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E220020) { bad = 1; }
    mi.opcode        = lang_mir.MIR_UI_TO_FP;
    mi.width         = 8;
    mi.src_width     = 4;
    st.buf.bytes.len = 0;
    encode_fp_conv(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x1E630020) { bad = 1; }
    mi.width         = 4;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_conv(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x9E230020) { bad = 1; }
    ops[0]           = tvec(22);
    ops[1]           = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 13)));
    mi.opcode        = lang_mir.MIR_SI_TO_FP;
    mi.width         = 8;
    mi.src_width     = 8;
    st.buf.bytes.len = 0;
    encode_fp_conv(?st, ?f, ?mi);
    if (isa_encode.word_read(?st.buf, 0) != 0x9E6201B6) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

