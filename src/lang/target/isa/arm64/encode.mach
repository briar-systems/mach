    if (!sel r_7611.err) { bad = bad + 1; }
    val r_7612: err[fail.Fail] = asm_ct_scan(leak, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7612.err) { bad = bad + 2; }

    val pubcmp: str            = "mov x0, 5\ncmp x0, x1\ncset x2, eq\nldr x3, [x2]";
