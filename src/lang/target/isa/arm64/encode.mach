    emit_mem_access(?st, 0, 1, 8, 8, true);
    if (read_word(?st.buf, 0) != 0xF9400420) { bad = 1; }
    emit_mem_access(?st, 0, 1, 8, 8, false);
    if (read_word(?st.buf, 4) != 0xF9000420) { bad = 1; }
    emit_mem_access(?st, 0, 1, 32760, 8, true);
    if (read_word(?st.buf, 8) != 0xF97FFC20) { bad = 1; }
    emit_mem_access(?st, 0, 1, -8, 8, true);
    if (read_word(?st.buf, 12) != 0xF85F8020) { bad = 1; }
    emit_mem_access(?st, 0, 1, -8, 8, false);
    if (read_word(?st.buf, 16) != 0xF81F8020) { bad = 1; }
    emit_mem_access(?st, 0, 1, 32768, 8, true);
    if (read_word(?st.buf, 20) != 0xD2900010) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xF8706820) { bad = 1; }
    emit_mem_access(?st, 0, 1, 1, 1, true);
    if (read_word(?st.buf, 28) != 0x39400420) { bad = 1; }
    emit_mem_access(?st, 0, 1, 2, 2, true);
    if (read_word(?st.buf, 32) != 0x79400420) { bad = 1; }
    emit_mem_access(?st, 0, 1, 4, 4, true);
    if (read_word(?st.buf, 36) != 0xB9400420) { bad = 1; }
    emit_mem_access(?st, 0, 1, 1, 1, false);
    if (read_word(?st.buf, 40) != 0x39000420) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:gep_alloca_address_arithmetic" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = -16;
    slots[0].size   = 16;
    slots[0].align  = 16;
    var f: mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;

    var aops: [2]mir.MirOperand;
    aops[0] = mir.op_preg(mir.preg_id(0));
    aops[1] = mir.op_mem_slot(mir.vreg_id(100), 0);
    var al: mir.MirInstr = mir.instr(mir.MIR_ALLOCA, ?aops[0], 2, 0, 0);
    al.width = 8; al.src_width = 8;
    encode_addr(?st, ?f, ?al);
    if (read_word(?st.buf, 0) != 0xD10043A0) { bad = 1; }

    var g1ops: [2]mir.MirOperand;
    g1ops[0] = mir.op_preg(mir.preg_id(0));
    g1ops[1] = mir.op_mem_preg(mir.preg_id(29), 16);
    var g1: mir.MirInstr = mir.instr(mir.MIR_GEP, ?g1ops[0], 2, 0, 0);
    g1.width = 8; g1.src_width = 8;
    encode_addr(?st, ?f, ?g1);
    if (read_word(?st.buf, 4) != 0x910043A0) { bad = 1; }

    var g2ops: [2]mir.MirOperand;
    g2ops[0] = mir.op_preg(mir.preg_id(0));
    var m2: mir.MirOperand = mir.op_mem_preg(mir.preg_id(1), 0);
    m2.index = mir.index_preg(mir.preg_id(2)); m2.scale = 8;
    g2ops[1] = m2;
    var g2: mir.MirInstr = mir.instr(mir.MIR_GEP, ?g2ops[0], 2, 0, 0);
    g2.width = 8; g2.src_width = 8;
    encode_addr(?st, ?f, ?g2);
    if (read_word(?st.buf, 8) != 0x8B020C20) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:integer_conversions" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(0));
    ops[1] = mir.op_preg(mir.preg_id(1));
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 2, 0, 0);

    mi.opcode = mir.MIR_SEXT; mi.width = 8; mi.src_width = 1;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 0) != 0x93401C20) { bad = 1; }
    mi.src_width = 2; encode_convert(?st, ?mi);
    if (read_word(?st.buf, 4) != 0x93403C20) { bad = 1; }
    mi.src_width = 4; encode_convert(?st, ?mi);
    if (read_word(?st.buf, 8) != 0x93407C20) { bad = 1; }
    mi.opcode = mir.MIR_ZEXT; mi.width = 4; mi.src_width = 1;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 12) != 0x53001C20) { bad = 1; }
    mi.src_width = 2; encode_convert(?st, ?mi);
    if (read_word(?st.buf, 16) != 0x53003C20) { bad = 1; }
    mi.width = 8; mi.src_width = 4; encode_convert(?st, ?mi);
    if (read_word(?st.buf, 20) != 0x2A0103E0) { bad = 1; }
    mi.opcode = mir.MIR_TRUNC; mi.width = 4; mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 24) != 0x2A0103E0) { bad = 1; }
    mi.opcode = mir.MIR_BITCAST; mi.width = 8; mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 28) != 0xAA0103E0) { bad = 1; }

    ops[1] = mir.op_imm(5);
    mi.opcode = mir.MIR_BITCAST; mi.width = 8; mi.src_width = 8;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 32) != 0xD28000B0) { bad = 1; }
    if (read_word(?st.buf, 36) != 0xAA1003E0) { bad = 1; }
    mi.width = 4; mi.src_width = 4;
    encode_convert(?st, ?mi);
    if (read_word(?st.buf, 40) != 0x528000B0) { bad = 1; }
    if (read_word(?st.buf, 44) != 0x2A1003E0) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:branch_fixups_insert_imm26_imm19" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_word(?st, mop.form(mop.B).base);
    emit_word(?st, mop.form(mop.BCOND).base | CC_EQ);
    emit_word(?st, 0xB4000000);
    emit_word(?st, 0xB5000001);

    var fx: encode.BranchFixup;
    fx.patch_pos = 0; fx.next_ip = 4;
    patch_branch_arm64(?st, ?fx, 8);
    if (read_word(?st.buf, 0) != 0x14000002) { bad = 1; }
    fx.patch_pos = 4; fx.next_ip = 8;
    patch_branch_arm64(?st, ?fx, 12);
    if (read_word(?st.buf, 4) != 0x54000040) { bad = 1; }
    fx.patch_pos = 8; fx.next_ip = 12;
    patch_branch_arm64(?st, ?fx, 16);
    if (read_word(?st.buf, 8) != 0xB4000040) { bad = 1; }
    fx.patch_pos = 12; fx.next_ip = 16;
    patch_branch_arm64(?st, ?fx, 12);
    if (read_word(?st.buf, 12) != 0xB5000001) { bad = 1; }

    st.buf.len = 0;
    var k: u32 = 0;
    for (k < 8) { emit_word(?st, mop.form(mop.B).base); k = k + 1; }
    fx.patch_pos = 28; fx.next_ip = 32;
    patch_branch_arm64(?st, ?fx, 0);
    if (read_word(?st.buf, 28) != 0x17FFFFF9) { bad = 1; }
    emit_word(?st, mop.form(mop.BCOND).base | CC_EQ);
    fx.patch_pos = 32; fx.next_ip = 36;
    patch_branch_arm64(?st, ?fx, 0);
    if (read_word(?st.buf, 32) != 0x54FFFF00) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:branch_to_fallthrough_elided" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    st.alloc = ?alloc; st.fixups = nil; st.fixup_count = 0; st.fixup_cap = 0;

    var uops: [1]mir.MirOperand;
    uops[0] = mir.op_block(4);
    var ub: mir.MirInstr = mir.instr(mir.MIR_BR, ?uops[0], 1, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.len != 4)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.len != 0)     { bad = 1; }
    if (st.fixup_count != 0) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 9; st.buf.len = 0; st.fixup_count = 0;
    encode_branch(?st, 0, ?ub);
    if (st.buf.len != 4)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(mir.preg_id(10)); cops[1] = mir.op_block(3); cops[2] = mir.op_block(4);
    var cbr: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR, ?cops[0], 3, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_cbr(?st, 0, ?cbr);
    val cbr_len: usize = st.buf.len;
    val cbr_fx:  u32   = st.fixup_count;
    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_cbr(?st, 0, ?cbr);
    if (st.buf.len != cbr_len - 4)          { bad = 1; }
    if (st.fixup_count != cbr_fx - 1)       { bad = 1; }
    if (st.fixups[0].target_block != 3)     { bad = 1; }

    var ops: [4]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(11)); ops[1] = mir.op_preg(mir.preg_id(12));
    ops[2] = mir.op_block(3); ops[3] = mir.op_block(4);
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR_EQ, ?ops[0], 4, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_fused_cbr(?st, 0, ?mi);
    val fus_len: usize = st.buf.len;
    val fus_fx:  u32   = st.fixup_count;
    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_fused_cbr(?st, 0, ?mi);
    if (st.buf.len != fus_len - 4)          { bad = 1; }
    if (st.fixup_count != fus_fx - 1)       { bad = 1; }
    if (st.fixups[0].target_block != 3)     { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:branch_fixups_reject_out_of_range_displacements" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_word(?st, mop.form(mop.BCOND).base | CC_EQ);
    var fx: encode.BranchFixup;
    fx.patch_pos = 0; fx.next_ip = 4;
    val r1: err[fail.Fail] = patch_branch_arm64(?st, ?fx, 2000000);
    if (!sel r1.err) { bad = 1; }

    st.buf.len = 0;
    emit_word(?st, mop.form(mop.B).base);
    fx.patch_pos = 0; fx.next_ip = 4;
    val r2: err[fail.Fail] = patch_branch_arm64(?st, ?fx, 200000000);
    if (!sel r2.err) { bad = 1; }

    st.buf.len = 0;
    emit_word(?st, mop.form(mop.BCOND).base | CC_EQ);
    fx.patch_pos = 0; fx.next_ip = 4;
    val r3: err[fail.Fail] = patch_branch_arm64(?st, ?fx, 1048572);
    if (sel r3.err) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:end_to_end_leaf_add_body" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(0));
    ops[1] = mir.op_preg(mir.preg_id(0));
    ops[2] = mir.op_preg(mir.preg_id(1));
    var mi: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 0, 0, 0);
    mi.operand_count = 3;
    mi.width = 4;
    encode_addsub(?st, ?mi, false);
    if (read_word(?st.buf, 0) != 0x0B010000) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:call_plus_symbol_reloc_base_words" {
    var bad: i32 = 0;
    if (mop.form(mop.BL).base != 0x94000000) { bad = 1; }
    if (t_reg1(mop.BLR, 0)  != 0xD63F0000) { bad = 1; }
    if (t_reg1(mop.BLR, 9)  != 0xD63F0120) { bad = 1; }
    if (t_reg1(mop.BLR, 16) != 0xD63F0200) { bad = 1; }
    if (t_asm(mop.ADRP, mop.gp(0, 8), isa.make_sym(0, 0), isa.make_none())  != 0x90000000) { bad = 1; }
    if (t_asm(mop.ADRP, mop.gp(16, 8), isa.make_sym(0, 0), isa.make_none()) != 0x90000010) { bad = 1; }
    if (t_imm(mop.ADD, 8, 0, 0, 0, 0)   != 0x91000000) { bad = 1; }
    if (t_imm(mop.ADD, 8, 16, 16, 0, 0) != 0x91000210) { bad = 1; }
    if (t_int_row(1, 0x39400200, 0x39000200, of.RK_LDST8_LO12)  != 0) { bad = 1; }
    if (t_int_row(2, 0x79400200, 0x79000200, of.RK_LDST16_LO12) != 0) { bad = 1; }
    if (t_int_row(4, 0xB9400200, 0xB9000200, of.RK_LDST32_LO12) != 0) { bad = 1; }
    if (t_int_row(8, 0xF9400200, 0xF9000200, of.RK_LDST64_LO12) != 0) { bad = 1; }
    ret bad;
}

fun t_int_row(w: u8, ldw: u32, stw: u32, kind: of.RelocKind) i32 {
    val lr: res[A64Access, fail.Fail] = int_access(w, true);
    val sr: res[A64Access, fail.Fail] = int_access(w, false);
    if (sel lr.err) { ret 1; }
    if (sel sr.err) { ret 1; }
    val l: A64Access = lr.ok;
    val s: A64Access = sr.ok;
    if (t_ldst(l.op, l.fp, l.width, 0, 16, 0) != ldw) { ret 1; }
    if (t_ldst(s.op, s.fp, s.width, 0, 16, 0) != stw) { ret 1; }
    if (l.lo12 != kind || s.lo12 != kind)     { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.encode:call_global_emitters_record_relocs_plus_base_words" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var f: mir.MirFunction;
    tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    val sym: intern.StrId = 7::intern.StrId;

    var cops: [1]mir.MirOperand;
    cops[0] = mir.op_sym(sym, 0);
    var ci: mir.MirInstr = mir.instr(mir.MIR_CALL, ?cops[0], 1, 0, 0);
    encode_call(?st, ?ci);
    if (read_word(?st.buf, 0) != 0x94000000) { bad = 1; }
    if (st.reloc_count != 1)                 { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PLT32) { bad = 1; }
        if (st.relocs[0].offset != 0)         { bad = 1; }
        if (st.relocs[0].sym != sym)          { bad = 1; }
        if (st.relocs[0].addend != 0)         { bad = 1; }
    }

    var iops: [1]mir.MirOperand;
    iops[0] = mir.op_preg(mir.preg_id(9));
    var ii: mir.MirInstr = mir.instr(mir.MIR_CALL, ?iops[0], 1, 0, 0);
    encode_call(?st, ?ii);
    if (read_word(?st.buf, 4) != 0xD63F0120) { bad = 1; }
    if (st.reloc_count != 1)                 { bad = 1; }

    var ao: mir.MirOperand = mir.op_sym(sym, 0);
    emit_global_addr(?st, 0, ?ao);
    if (read_word(?st.buf, 8)  != 0x90000000) { bad = 1; }
    if (read_word(?st.buf, 12) != 0x91000000) { bad = 1; }
    if (st.reloc_count != 3)                  { bad = 1; }
    or {
        if (st.relocs[1].kind != of.RK_PAGE21)   { bad = 1; }
        if (st.relocs[1].offset != 8)            { bad = 1; }
        if (st.relocs[2].kind != of.RK_ADD_LO12) { bad = 1; }
        if (st.relocs[2].offset != 12)           { bad = 1; }
    }

    var lo: mir.MirOperand = mir.op_sym(sym, 0);
    emit_global_load(?st, 0, ?lo, 8, false);
    if (read_word(?st.buf, 16) != 0x90000010) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xF9400200) { bad = 1; }
    if (st.reloc_count != 5)                  { bad = 1; }
    or {
        if (st.relocs[3].kind != of.RK_PAGE21)      { bad = 1; }
        if (st.relocs[4].kind != of.RK_LDST64_LO12) { bad = 1; }
        if (st.relocs[4].offset != 20)              { bad = 1; }
    }

    var so: mir.MirOperand = mir.op_sym(sym, 0);
    var sv: mir.MirOperand = mir.op_preg(mir.preg_id(1));
    emit_global_store(?st, ?f, ?so, ?sv, 4);
    if (read_word(?st.buf, 24) != 0x90000010) { bad = 1; }
    if (read_word(?st.buf, 28) != 0xB9000201) { bad = 1; }
    if (st.reloc_count != 7)                  { bad = 1; }
    or {
        if (st.relocs[6].kind != of.RK_LDST32_LO12) { bad = 1; }
        if (st.relocs[6].offset != 28)              { bad = 1; }
    }

    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:got_indirect_emitters_record_relocs_plus_base_words" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var f: mir.MirFunction;
    tbuf(?st, ?alloc);
    st.alloc       = ?alloc;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;

    val sym: intern.StrId = 7::intern.StrId;

    var ao: mir.MirOperand = mir.op_sym(sym, 0);
    ao.sym_got = true;
    emit_global_addr_got(?st, 0, ?ao);
    if (read_word(?st.buf, 0) != 0x90000000) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 2)                 { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[0].offset != 0)              { bad = 1; }
        if (st.relocs[0].addend != 0)              { bad = 1; }
        if (st.relocs[1].kind != of.RK_GOT_LO12)   { bad = 1; }
        if (st.relocs[1].offset != 4)              { bad = 1; }
        if (st.relocs[1].addend != 0)              { bad = 1; }
    }

    var lo: mir.MirOperand = mir.op_sym(sym, 0);
    lo.sym_got = true;
    emit_global_load_got(?st, 0, ?lo, 8, false);
    if (read_word(?st.buf, 8)  != 0x90000000) { bad = 1; }
    if (read_word(?st.buf, 12) != 0xF9400000) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 4)                  { bad = 1; }
    or {
        if (st.relocs[2].kind != of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[3].kind != of.RK_GOT_LO12)   { bad = 1; }
        if (st.relocs[3].offset != 12)             { bad = 1; }
    }

    var so: mir.MirOperand = mir.op_sym(sym, 0);
    so.sym_got = true;
    var sv: mir.MirOperand = mir.op_preg(mir.preg_id(1));
    emit_global_store_got(?st, ?f, ?so, ?sv, 4);
    if (read_word(?st.buf, 20) != 0x90000010) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xF9400210) { bad = 1; }
    if (read_word(?st.buf, 28) != 0xB9000201) { bad = 1; }
    if (st.reloc_count != 6)                  { bad = 1; }
    or {
        if (st.relocs[4].kind != of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[5].kind != of.RK_GOT_LO12)   { bad = 1; }
        if (st.relocs[5].offset != 24)             { bad = 1; }
    }

    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:oversized_callee_save_frame_uses_scratch_base_stp" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    var f: mir.MirFunction;
    f.callee_mask = (1::u32 << 19) | (1::u32 << 20) | (1::u32 << 21);
    f.callee_mask_fp = 0;
    f.frame.size = 4000;
    f.frame.outgoing_size = 0;

    save_callee_gp(?st, ?f, true);
    if (read_word(?st.buf, 0) != 0xD13EC3B0) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xA9005213) { bad = 1; }
    if (read_word(?st.buf, 8) != 0xF81F8215) { bad = 1; }

    save_callee_gp(?st, ?f, false);
    if (read_word(?st.buf, 12) != 0xD13EC3B0) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xA9405213) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xF85F8215) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:oversized_sub_sp_uses_the_register_form" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    emit_sp_sub(?st, 0x1000000);
    if (read_word(?st.buf, 0) != t_mw(mop.MOVZ, 8, 16, 1, 0x100)) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xCB3063FF)         { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

fun tasm(st: *encode.EncodeState, alloc: *A.Allocator, interner: *intern.Interner) {
    page.make(alloc);
    @interner = intern.init(alloc);
    st.alloc       = alloc;
    st.buf         = encode.buf_init(alloc);
    st.interner    = interner;
    st.syms        = nil; st.sym_count   = 0; st.sym_cap   = 0;
    st.relocs      = nil; st.reloc_count = 0; st.reloc_cap = 0;
    st.fixups      = nil; st.fixup_count = 0; st.fixup_cap = 0;
    st.blocks      = nil; st.block_count = 0; st.block_cap = 0;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_processing_forms" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
