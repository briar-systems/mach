    val r_5765: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cmp x0, x1");
    if (sel r_5765.err) { bad = 11; }
    val r_5766: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cmp x0, w1");
    if (!sel r_5766.err) { bad = 12; }
    val r_5767: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cmp x0, 5");
    if (sel r_5767.err) { bad = 13; }

    val r_5769: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lslv x0, x1, x2");
    if (sel r_5769.err) { bad = 14; }
    val r_5770: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lslv x0, x1, w2");
    if (!sel r_5770.err) { bad = 15; }
    val r_5771: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lsl x0, x1, 3");
    if (sel r_5771.err) { bad = 16; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_call_and_jump_relocations_differ" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val fr: res[intern.StrId, A.Error] = intern.intern(?interner, "fsym");
    if (sel fr.err) { ret 1; }
    val fsym: intern.StrId = fr.ok;

    a64_asm_text(?st, ?f, ?labels, "bl fsym");
    a64_asm_text(?st, ?f, ?labels, "b fsym");

    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PLT32)  { bad = 2; }
        if (st.relocs[0].sym  != fsym)         { bad = 3; }
        if (st.relocs[1].kind != of.RK_JUMP26) { bad = 4; }
        if (st.relocs[1].sym  != fsym)         { bad = 5; }
    }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

