test "mach.lang.target.isa.arm64.encode:inline_asm_name_local_resolves_to_a_frame_slot" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_SPILL;
    slots[0].offset = -8192;
    slots[0].size   = 4;
    slots[0].align  = 4;
    var f: mir.MirFunction;
    f.frame.slots         = ?slots[0];
    f.frame.slot_count    = 1;
    f.frame.size          = 8192;
    f.frame.outgoing_size = 64;
    f.frame.realign       = 0;
    f.callee_mask         = 0;
    f.callee_mask_fp      = 0;
    f.frame.base_dist     = frame_subsize(?f);

    if (frame_subsize(?f) != 8256) { bad = 1; }

    val xr: res[intern.StrId, A.Error] = intern.intern(?interner, "x");
    if (sel xr.err) { ret 1; }
    var binds: [1]mir.MirAsmBind;
    binds[0].name      = xr.ok;
    binds[0].slot_vreg = 100;

    var pl: mir.MirAsm;
    pl.isa        = "aarch64";
    pl.body       = "ldr w0, {x}\nstr w0, {x}";
    pl.binds      = ?binds[0];
    pl.bind_count = 1;

    var mi: mir.MirInstr = mir.instr(mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block = ?pl;

    val r: err[fail.Fail] = encode_asm_block_arm64(?st, ?f, 0, ?mi);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        if (read_word(?st.buf, 0) != 0xB94043E0) { bad = 1; }
        if (read_word(?st.buf, 4) != 0xB90043E0) { bad = 1; }
    }

    val nsr: res[bool, fail.Fail] = mem_access_needs_no_scratch(-8192, 4);
    if (sel nsr.ok && nsr.ok) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_name_local_refuses_a_body_that_moves_sp" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_SPILL;
    slots[0].offset = -16;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;
    f.frame.size       = 16;

    val xr: res[intern.StrId, A.Error] = intern.intern(?interner, "x");
    if (sel xr.err) { ret 1; }
    var binds: [1]mir.MirAsmBind;
    binds[0].name      = xr.ok;
    binds[0].slot_vreg = 100;

    var pl: mir.MirAsm;
    pl.isa        = "aarch64";
    pl.binds      = ?binds[0];
    pl.bind_count = 1;

    var mi: mir.MirInstr = mir.instr(mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block = ?pl;

    pl.body = "ldr x0, {x}\nsub sp, sp, 16";
    val r_6547: err[fail.Fail] = encode_asm_block_arm64(?st, ?f, 0, ?mi);
    if (!sel r_6547.err) { bad = 1; }

    pl.body = "ldr x0, {x}\nstp x1, x2, [sp, -16]!";
    val r_6550: err[fail.Fail] = encode_asm_block_arm64(?st, ?f, 0, ?mi);
    if (!sel r_6550.err) { bad = 2; }

    pl.body = "ldr x0, {x}\n.word 0xd10043ff";
    val r_6553: err[fail.Fail] = encode_asm_block_arm64(?st, ?f, 0, ?mi);
    if (!sel r_6553.err) { bad = 3; }

    pl.body = "ldr x0, {x}\nmov xzr, x1\nldr x2, [sp, 8]";
    val r_6556: err[fail.Fail] = encode_asm_block_arm64(?st, ?f, 0, ?mi);
    if (sel r_6556.err) { bad = 4; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

# the words one store (or load) of a frame slot encodes to, in a frame whose
# sp sits base_dist below fp and whose sp_fixed is as given
fun t_slot_access(sp_fixed: bool, base_dist: u32, slot_off: i64, disp: i64, width: u8, vec: bool, load: bool,
    want: *u32, n: usize) bool {
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);

    var slots: [1]mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = mir.SLOT_ALLOCA;
    slots[0].offset = slot_off;
    slots[0].size   = 64;
    slots[0].align  = 1;
    var f: mir.MirFunction;
    f.vregs            = nil;
    f.vreg_count       = 0;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;
    f.frame.realign    = 0;
    f.frame.fp_dist    = 0;
    f.frame.base_dist  = base_dist;
    f.frame.sp_fixed   = sp_fixed;

    var reg: i32 = arm64.X1;
    if (vec) { reg = isa.regid_make(isa.REG_CLASS_ID_XMM, arm64.V1); }
    var mem: mir.MirOperand = mir.op_mem_slot(mir.vreg_id(100), disp);
    var rop: mir.MirOperand = mir.op_preg(mir.preg_id(reg));
    var r:   err[fail.Fail] = err[fail.Fail].ok{};
    if (load) {
        var ops: [2]mir.MirOperand;
        ops[0] = rop;
        ops[1] = mem;
        var mi: mir.MirInstr = mir.instr(mir.MIR_LOAD, ?ops[0], 2, width, width);
        r = encode_load(?st, ?f, ?mi);
    }
    or { r = emit_store_mem(?st, ?f, ?mem, ?rop, width); }

    var ok: bool  = !sel r.err && st.buf.len == n * 4;
    var i:  usize = 0;
    for (ok && i < n) {
        if (read_word(?st.buf, i * 4) != want[i]) { ok = false; }
        i = i + 1;
    }
    encode.buf_dnit(?st.buf);
    ret ok;
}

fun t_slot_one(sp_fixed: bool, base_dist: u32, slot_off: i64, disp: i64, width: u8, vec: bool, load: bool, word: u32) bool {
    var w: [1]u32;
    w[0] = word;
    ret t_slot_access(sp_fixed, base_dist, slot_off, disp, width, vec, load, ?w[0], 1);
}

# mov x16, #-512 then the register-offset form from x29
fun t_slot_indexed(sp_fixed: bool, base_dist: u32, slot_off: i64, disp: i64, width: u8, second: u32) bool {
    var w: [2]u32;
    w[0] = 0x92800000 | (((0 - slot_off - disp - 1)::u32 & 0xFFFF) << 5) | 16;
    w[1] = second;
    ret t_slot_access(sp_fixed, base_dist, slot_off, disp, width, false, false, ?w[0], 2);
}

test "mach.lang.target.isa.arm64.encode:deep_slot_takes_one_scaled_word_from_a_fixed_sp" {
    var bad: i32 = 0;
    # str x1, [sp, #512] and ldr x1, [sp, #512]
    if (!t_slot_one(true, 1024, -512, 0, 8, false, false, 0xF90103E1)) { bad = bad | 1; }
    if (!t_slot_one(true, 1024, -512, 0, 8, false, true, 0xF94103E1))  { bad = bad | 2; }
    # an aggregate field: slot -520, field +12, four bytes: str w1, [sp, #516]
    if (!t_slot_one(true, 1024, -520, 12, 4, false, false, 0xB90207E1)) { bad = bad | 4; }
    # a byte needs no alignment: strb w1, [sp, #509]
    if (!t_slot_one(true, 1024, -520, 5, 1, false, false, 0x3907F7E1)) { bad = bad | 8; }
    # a whole vector: str q1, [sp, #512]
    if (!t_slot_one(true, 1024, -512, 0, 16, true, false, 0x3D8083E1)) { bad = bad | 16; }
    # a shallow slot keeps its one fp-relative word: stur x1, [x29, #-16]
    if (!t_slot_one(true, 1024, -16, 0, 8, false, false, 0xF81F03A1)) { bad = bad | 32; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:deep_slot_keeps_the_index_form_otherwise" {
    var bad:         i32 = 0;
    val str_x29_x16: u32 = 0xF8306BA1;
    # the frame does not declare sp fixed
    if (!t_slot_indexed(false, 1024, -512, 0, 8, str_x29_x16)) { bad = bad | 1; }
    # a packed field at an offset eight does not divide
    if (!t_slot_indexed(true, 1024, -520, 3, 8, str_x29_x16)) { bad = bad | 2; }
    # four bytes at an offset four does not divide: str w1, [x29, x16]
    if (!t_slot_indexed(true, 1024, -520, 2, 4, 0xB8306BA1)) { bad = bad | 4; }
    # the slot lies below sp's reach: a negative sp offset
    if (!t_slot_indexed(true, 256, -512, 0, 8, str_x29_x16)) { bad = bad | 8; }
    # past the scaled range: 8 * 4096 above sp
    if (!t_slot_indexed(true, 40000, -512, 0, 8, str_x29_x16)) { bad = bad | 16; }
    ret bad;
}

fun t_asm_instr(mi: *mir.MirInstr, pl: *mir.MirAsm, body: str) {
    pl.isa        = "aarch64";
    pl.body       = body;
    pl.binds      = nil;
    pl.bind_count = 0;
    @mi           = mir.instr(mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block  = pl;
}

fun t_writes_sp(m: *isa.RegMachine, instrs: *mir.MirInstr, n: u32) bool {
    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = n;
    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    ret codegen_frame.body_writes_sp(m, ?f, mir.preg_id(arm64.SP));
}

test "mach.lang.target.isa.arm64.encode:a_body_that_writes_sp_clears_the_fixed_sp" {
    var bad: i32 = 0;
    if (!asm_writes_sp("sub sp, sp, 16"))              { bad = bad | 1; }
    if (!asm_writes_sp("stp x1, x2, [sp, -16]!"))      { bad = bad | 2; }
    if (!asm_writes_sp(".word 0xd10043ff"))            { bad = bad | 4; }
    if (!asm_writes_sp("frobnicate"))                  { bad = bad | 8; }
    if (asm_writes_sp("mov xzr, x1\nldr x2, [sp, 8]")) { bad = bad | 16; }
    if (asm_writes_sp("nop"))                          { bad = bad | 32; }

    var m: isa.RegMachine = isa.reg_machine(nil, nil, nil, nil, nil, 0, nil, 0, -1, -1, -1, -1, 0, -1, -1, -1);
    isa.with_assembly(?m, encode_arm64_asm, asm_clobbers, asm_returns, asm_ct_scan, asm_writes_sp);
    var pl:     [2]mir.MirAsm;
    var instrs: [2]mir.MirInstr;
    t_asm_instr(?instrs[0], ?pl[0], "nop");
    t_asm_instr(?instrs[1], ?pl[1], "sub sp, sp, 64");
    if (t_writes_sp(?m, ?instrs[0], 1))  { bad = bad | 64; }
    if (!t_writes_sp(?m, ?instrs[0], 2)) { bad = bad | 128; }

    # a machine without the assembly group cannot read the body, so it assumes a write
    var bare: isa.RegMachine = isa.reg_machine(nil, nil, nil, nil, nil, 0, nil, 0, -1, -1, -1, -1, 0, -1, -1, -1);
    if (!t_writes_sp(?bare, ?instrs[0], 1)) { bad = bad | 256; }

    # an instruction naming sp as a register operand
    var ops: [2]mir.MirOperand;
    ops[0]    = mir.op_preg(mir.preg_id(arm64.SP));
    ops[1]    = mir.op_preg(mir.preg_id(arm64.X1));
    instrs[1] = mir.instr(mir.MIR_MOV, ?ops[0], 2, 8, 8);
    if (!t_writes_sp(?m, ?instrs[1], 1)) { bad = bad | 512; }
    # sp as a memory base is a read
    ops[0] = mir.op_mem_preg(mir.preg_id(arm64.SP), 8);
    if (t_writes_sp(?m, ?instrs[1], 1)) { bad = bad | 1024; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_bare_immediates" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "mov x8, 93");
    a64_asm_text(?st, ?f, ?labels, "add x0, x1, 5");
    a64_asm_text(?st, ?f, ?labels, "cmp x0, 5");
    a64_asm_text(?st, ?f, ?labels, "svc 0");
    a64_asm_text(?st, ?f, ?labels, "movz x0, 0x1234, lsl 16");
    a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1, 8]");
    a64_asm_text(?st, ?f, ?labels, "str x0, [x1, -8]");
    a64_asm_text(?st, ?f, ?labels, "stp x29, x30, [sp, -16]!");
    a64_asm_text(?st, ?f, ?labels, "ldp x29, x30, [sp], 16");

    if (read_word(?st.buf, 0) != 0xD2800BA8)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0x91001420)  { bad = 1; }
    if (read_word(?st.buf, 8) != 0xF100141F)  { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD4000001) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD2A24680) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xF9400420) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xF81F8020) { bad = 1; }
    if (read_word(?st.buf, 28) != 0xA9BF7BFD) { bad = 1; }
    if (read_word(?st.buf, 32) != 0xA8C17BFD) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_rejects_unknown_mnemonic_and_condbr_to_symbol" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "frobnicate x0, x1");
    if (!sel r1.err) { bad = 1; }
    or (sel r1.err) {
        if (!str_contains(fail.describe(r1.err), "unknown aarch64 inline-asm instruction")) { bad = 1; }
    }

    val r2: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cbz x0, some_symbol");
    if (!sel r2.err) { bad = 1; }
    or (sel r2.err) {
        if (!str_contains(fail.describe(r2.err), "no imm19 relocation kind")) { bad = 1; }
    }

    val r3: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "b.eq some_symbol");
    if (!sel r3.err) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_clobbers_classification" {
    var bad: i32 = 0;
    var gp:  u32 = 0;
    var fp:  u32 = 0;

    asm_clobbers("ldr x0, [x1]\nstr x0, [x1, 8]\nbl main", ?gp, ?fp);
    if ((gp & 1) == 0)                               { bad = 1; }
    if ((gp & A64_CALLER_SAVED) != A64_CALLER_SAVED) { bad = 1; }
    if (fp != 0)                                     { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("mov x8, 93\nsvc 0", ?gp, ?fp);
    if (gp != ((1::u32 << 8) | 1)) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("ldr x0, {v}\nstr x1, {out}", ?gp, ?fp);
    if (gp != 1) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("dmb ish\ncmp x0, x1\nstlr x9, [x12]\nstlxr w11, x10, [x12]", ?gp, ?fp);
    if (gp != (1::u32 << 11)) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("ldp x1, x2, [sp], 16", ?gp, ?fp);
    if (gp != ((1::u32 << 1) | (1::u32 << 2) | (1::u32 << 31))) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers("stp x1, x2, [sp, -16]!", ?gp, ?fp);
    if (gp != (1::u32 << 31)) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers("stp x1, x2, [sp, 16]", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("frobnicate x0, x1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:systems_mnemonics_byte_exact" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "hvc 0");
    a64_asm_text(?st, ?f, ?labels, "smc 0");
    a64_asm_text(?st, ?f, ?labels, "hvc 0x1234");
    a64_asm_text(?st, ?f, ?labels, "smc 0x1234");
    a64_asm_text(?st, ?f, ?labels, "wfi");
    a64_asm_text(?st, ?f, ?labels, "wfe");
    a64_asm_text(?st, ?f, ?labels, "svc 0");

    if (read_word(?st.buf, 0) != 0xD4000002)  { bad = 1; }
    if (read_word(?st.buf, 4) != 0xD4000003)  { bad = 1; }
    if (read_word(?st.buf, 8) != 0xD4024682)  { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD4024683) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD503207F) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD503205F) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD4000001) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:systems_mnemonics_clobbers" {
    var bad: i32 = 0;
    var gp:  u32 = 0;
    var fp:  u32 = 0;

    asm_clobbers("mov x0, 0x84000008\nhvc 0", ?gp, ?fp);
    if (gp != (A64_SMCCC_CLOBBER | 1)) { bad = 1; }
    if (fp != 0)                       { bad = 1; }
    if ((gp & (1::u32 << 18)) != 0)    { bad = 1; }
    if ((gp & (1::u32 << 30)) != 0)    { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("smc 0", ?gp, ?fp);
    if (gp != A64_SMCCC_CLOBBER) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("wfi", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers("wfe", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503207f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("wfi 0", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers("hvc", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:declared_raw_encodings" {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xd4000002 :: writes(x0, x1, x2, x3)", ?gp, ?fp);
    if (gp != 0xF) { bad = 1; }
    if (fp != 0)   { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd4000002", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503207f :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(v7, v31)", ?gp, ?fp);
    if (gp != 0)                                { bad = 1; }
    if (fp != ((1::u32 << 7) | (1::u32 << 31))) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(x30)", ?gp, ?fp);
    if (gp != (1::u32 << 30)) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(w0)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(v2.4s)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers(".word 0xd503201f :: writes(x31)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("mov x0, x1 :: writes()", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:declared_raw_encodings_emit_unchanged" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, ".word 0xd4000002 :: writes(x0)");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd4000002");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd503207f :: writes()");

    if (read_word(?st.buf, 0) != 0xD4000002) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xD4000002) { bad = 1; }
    if (read_word(?st.buf, 8) != 0xD503207F) { bad = 1; }
    if (st.buf.len != 12)                    { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_ldst_offset_needing_a_scratch_is_refused" {
    var bad: i32 = 0;

    if (!t_a64_accepts("ldr x9, [x12, 32760]")) { bad = 1; }
    if (!t_a64_accepts("str x9, [x12, 32760]")) { bad = 1; }
    if (!t_a64_refuses("ldr x9, [x12, 32768]")) { bad = 1; }
    if (!t_a64_refuses("str x9, [x12, 32768]")) { bad = 1; }

    if (!t_a64_accepts("ldr x9, [x12, 255]"))  { bad = 1; }
    if (!t_a64_accepts("ldr x9, [x12, -256]")) { bad = 1; }
    if (!t_a64_refuses("ldr x9, [x12, 257]"))  { bad = 1; }
    if (!t_a64_refuses("ldr x9, [x12, -257]")) { bad = 1; }

    if (!t_a64_accepts("ldrb w9, [x12, 4095]")) { bad = 1; }
    if (!t_a64_refuses("ldrb w9, [x12, 4096]")) { bad = 1; }
    if (!t_a64_accepts("ldrh w9, [x12, 8190]")) { bad = 1; }
    if (!t_a64_refuses("ldrh w9, [x12, 8192]")) { bad = 1; }

    if (!t_a64_accepts("ldr x9, [x12]"))     { bad = 1; }
    if (!t_a64_accepts("ldr x9, [x12, 8]"))  { bad = 1; }
    if (!t_a64_accepts("str x9, [x12, 16]")) { bad = 1; }

    ret bad;
}

fun t_a64_accepts(text: str) bool {
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f:  mir.MirFunction;
    val r:  err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    val ok: bool           = !sel r.err && st.buf.len == 4;
    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

fun t_a64_refuses(text: str) bool {
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f:  mir.MirFunction;
    val r:  err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool           = false;
    if (sel r.err) {
        ok = str_contains(fail.describe(r.err), "scratch register this body may be using");
    }
    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

test "mach.lang.target.isa.arm64.encode:asm_byte_accounting" {
    var bad: i32 = 0;
    var gp:  u32 = 0;
    var fp:  u32 = 0;

    asm_clobbers("add x0, x1, x2 junk", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("nop 1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("  add x0 , x1 , x2  ;  mov x3, x4  ", ?gp, ?fp);
    if (gp != (1 | (1::u32 << 3))) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_relocation_modifiers" {
    var bad:      i32 = 0;
    var st:       encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val ar: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "adrp x0, :got:foo");
    if (sel ar.err) { bad = 1; }
    val lr: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "ldr x0, [x0, :got_lo12:foo]");
    if (sel lr.err)                          { bad = 1; }
    if (read_word(?st.buf, 0) != 0x90000000) { bad = 1; }
    if (read_word(?st.buf, 4) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 2)                 { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[1].kind != of.RK_GOT_LO12)   { bad = 1; }
    }

    val br: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "adrp x0, :bogus:foo");
    if (!sel br.err) { bad = 1; }
    or (sel br.err) {
        if (!str_contains(fail.describe(br.err), "unsupported aarch64 inline-asm relocation modifier")) { bad = 1; }
    }

    val lo: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "adrp x0, :lo12:foo");
    if (!sel lo.err) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_vector_base_words" {
    var bad: i32 = 0;

    if (t_neon3(mop.V_FADD, 4, 0, 0, 1) != 0x4E21D400) { bad = 1; }
    if (t_neon3(mop.V_FADD, 8, 0, 0, 1) != 0x4E61D400) { bad = 1; }
    if (t_neon3(mop.V_FSUB, 4, 0, 0, 1) != 0x4EA1D400) { bad = 1; }
    if (t_neon3(mop.V_FSUB, 8, 0, 0, 1) != 0x4EE1D400) { bad = 1; }
    if (t_neon3(mop.V_FMUL, 4, 0, 0, 1) != 0x6E21DC00) { bad = 1; }
    if (t_neon3(mop.V_FDIV, 4, 0, 0, 1) != 0x6E21FC00) { bad = 1; }

    if (t_neon3(mop.V_ADD, 1, 0, 0, 1) != 0x4E218400) { bad = 1; }
    if (t_neon3(mop.V_ADD, 2, 0, 0, 1) != 0x4E618400) { bad = 1; }
    if (t_neon3(mop.V_ADD, 4, 0, 0, 1) != 0x4EA18400) { bad = 1; }
    if (t_neon3(mop.V_ADD, 8, 0, 0, 1) != 0x4EE18400) { bad = 1; }
    if (t_neon3(mop.V_SUB, 1, 0, 0, 1) != 0x6E218400) { bad = 1; }

    if (t_neon3(mop.V_AND, 1, 0, 0, 1) != 0x4E211C00) { bad = 1; }
    if (t_neon3(mop.V_ORR, 1, 0, 0, 1) != 0x4EA11C00) { bad = 1; }
    if (t_neon3(mop.V_EOR, 1, 0, 0, 1) != 0x6E211C00) { bad = 1; }
    if (t_neon3(mop.V_ORR, 1, 0, 1, 1) != 0x4EA11C20) { bad = 1; }
    if (t_neon2(mop.V_MVN, 0, 1) != 0x6E205820)       { bad = 1; }

    if (t_neon3(mop.V_CMEQ, 1, 0, 0, 1) != 0x6E218C00)  { bad = 1; }
    if (t_neon3(mop.V_CMGT, 1, 0, 0, 1) != 0x4E213400)  { bad = 1; }
    if (t_neon3(mop.V_CMGE, 1, 0, 0, 1) != 0x4E213C00)  { bad = 1; }
    if (t_neon3(mop.V_CMHI, 1, 0, 0, 1) != 0x6E213400)  { bad = 1; }
    if (t_neon3(mop.V_CMHS, 1, 0, 0, 1) != 0x6E213C00)  { bad = 1; }
    if (t_neon3(mop.V_FCMEQ, 4, 0, 0, 1) != 0x4E21E400) { bad = 1; }
    if (t_neon3(mop.V_FCMGT, 4, 0, 0, 1) != 0x6EA1E400) { bad = 1; }
    if (t_neon3(mop.V_FCMGE, 4, 0, 0, 1) != 0x6E21E400) { bad = 1; }

    if (t_lane_rd(mop.UMOV, mop.gp(0, 4), 1, 0, 1) != 0x0E013C20) { bad = 1; }
    if (t_lane_rd(mop.UMOV, mop.gp(0, 4), 2, 3, 1) != 0x0E0E3C20) { bad = 1; }
    if (t_lane_rd(mop.UMOV, mop.gp(0, 4), 4, 2, 1) != 0x0E143C20) { bad = 1; }
    if (t_lane_rd(mop.UMOV, mop.gp(0, 8), 8, 1, 1) != 0x4E183C20) { bad = 1; }
    if (t_ins_gp(1, 0, 0, 1) != 0x4E011C20)                       { bad = 1; }
    if (t_ins_gp(4, 2, 0, 1) != 0x4E141C20)                       { bad = 1; }
    if (t_ins_gp(8, 1, 0, 1) != 0x4E181C20)                       { bad = 1; }

    if (t_lane_rd(mop.DUP, mop.vec(0, 4), 4, 1, 2) != 0x5E0C0440) { bad = 1; }
    if (t_lane_rd(mop.DUP, mop.vec(0, 8), 8, 1, 2) != 0x5E180440) { bad = 1; }
    if (t_lane_rd(mop.DUP, mop.vec(1, 4), 4, 0, 0) != 0x5E040401) { bad = 1; }
    if (t_ins_el(4, 3, 0, 0, 1) != 0x6E1C0420)                    { bad = 1; }
    if (t_ins_el(8, 1, 0, 0, 1) != 0x6E180420)                    { bad = 1; }
    if (t_ins_el(4, 3, 2, 0, 1) != 0x6E1C4420)                    { bad = 1; }
    if (t_ins_el(8, 1, 1, 0, 1) != 0x6E184420)                    { bad = 1; }
    if (t_ins_el(1, 5, 3, 0, 1) != 0x6E0B1C20)                    { bad = 1; }
    if (t_ins_el(2, 2, 7, 0, 1) != 0x6E0A7420)                    { bad = 1; }

    if (t_ldst(mop.LDR, true, 16, 0, 0, 0) != 0x3DC00000)           { bad = 1; }
    if (t_ldst(mop.STR, true, 16, 0, 0, 0) != 0x3D800000)           { bad = 1; }
    if (t_ldst(mop.LDR, true, 16, 0, 1, 1) != 0x3DC00420)           { bad = 1; }
    if (t_ldst(mop.STR, true, 16, 2, 3, 2) != 0x3D800862)           { bad = 1; }
    if (t_ldur(mop.LDUR, true, 16, 0, 0, 0x1F8::u32) != 0x3CDF8000) { bad = 1; }
    if (t_ldst_reg(mop.LDR, true, 16, 0, 0, 1) != 0x3CE16800)       { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_integer_multiply_arrangements" {
    var bad: i32 = 0;

    if (t_neon3(mop.V_MUL, 1, 3, 5, 7) != 0x4E279CA3) { bad = 1; }
    if (t_neon3(mop.V_MUL, 2, 3, 5, 7) != 0x4E679CA3) { bad = 2; }
    if (t_neon3(mop.V_MUL, 4, 3, 5, 7) != 0x4EA79CA3) { bad = 3; }

    if (!t_neon3_allocated(mop.V_MUL, 0)) { bad = 4; }
    if (!t_neon3_allocated(mop.V_MUL, 1)) { bad = 5; }
    if (!t_neon3_allocated(mop.V_MUL, 2)) { bad = 6; }
    if (t_neon3_allocated(mop.V_MUL, 3))  { bad = 7; }

    if (!t_neon3_allocated(mop.V_ADD, 3))  { bad = 8; }
    if (!t_neon3_allocated(mop.V_SUB, 3))  { bad = 9; }
    if (!t_neon3_allocated(mop.V_CMEQ, 3)) { bad = 10; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_vector_op_selection" {
    var bad:   i32 = 0;
    var st:    encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f:   mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi:  mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    ops[0] = tvec(0);
    ops[1] = tvec(1);
    ops[2] = tvec(2);

    mi.opcode   = arm64.VEC_ADD::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4E22D420) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4E228420) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4EA28420) { bad = 1; }

    mi.opcode   = arm64.VEC_SUB::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 8, 2);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4EE2D420) { bad = 1; }
    mi.opcode   = arm64.VEC_MUL::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 2, 8);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4E629C20) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4E229C20) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4EA29C20) { bad = 1; }
    mi.opcode   = arm64.VEC_DIV::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6E22FC20) { bad = 1; }

    mi.opcode   = arm64.VEC_AND::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4E221C20) { bad = 1; }
    mi.opcode  = arm64.VEC_ORR::u32;
    st.buf.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4EA21C20) { bad = 1; }
    mi.opcode  = arm64.VEC_EOR::u32;
    st.buf.len = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6E221C20) { bad = 1; }

    mi.opcode   = arm64.VEC_CMEQ::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6EA28C20) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4E22E420) { bad = 1; }
    mi.opcode   = arm64.VEC_CMGT::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x4EA23420) { bad = 1; }
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6EA2E420) { bad = 1; }
    mi.opcode   = arm64.VEC_CMHI::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6EA23420) { bad = 1; }
    mi.opcode   = arm64.VEC_CMHS::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6E223C20) { bad = 1; }

    mi.opcode   = arm64.VEC_CMNE::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16);
    st.buf.len  = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6E228C20) { bad = 1; }
    if (read_word(?st.buf, 4) != 0x6E205800) { bad = 1; }

    ops[0]           = tvec(0);
    ops[1]           = tvec(1);
    mi.opcode        = arm64.VEC_NOT::u32;
    mi.operand_count = 2;
    mi.vec_lane      = mir.vec_lane_make(mir.VEC_LANE_INT, 1, 16);
    st.buf.len       = 0;
    encode_neon(?st, ?f, ?mi);
    if (read_word(?st.buf, 0) != 0x6E205820) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:neon_integer_multiply_refuses_64bit_lanes" {
    var bad:   i32 = 0;
    var st:    encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f:   mir.MirFunction;
    var ops: [3]mir.MirOperand;
    var mi:  mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 0, 0);
    ops[0] = tvec(0);
    ops[1] = tvec(1);
    ops[2] = tvec(2);

    mi.opcode   = arm64.VEC_MUL::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 8, 2);
    st.buf.len  = 0;
    val r: err[fail.Fail] = encode_neon(?st, ?f, ?mi);
    if (!sel r.err)      { bad = 1; }
    if (st.buf.len != 0) { bad = 2; }

    st.buf.len  = 0;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    val r_7070: err[fail.Fail] = encode_neon(?st, ?f, ?mi);
    if (sel r_7070.err)  { bad = 3; }
    if (st.buf.len != 4) { bad = 4; }

    st.buf.len  = 0;
    mi.opcode   = arm64.VEC_ADD::u32;
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 8, 2);
    val r_7075: err[fail.Fail] = encode_neon(?st, ?f, ?mi);
    if (sel r_7075.err)                      { bad = 5; }
    if (read_word(?st.buf, 0) != 0x4EE28420) { bad = 6; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:vec_lane_index_refuses_out_of_range" {
    var bad:   i32 = 0;
    var st:    encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    var f: mir.MirFunction;

    var rops: [3]mir.MirOperand;
    var rmi:  mir.MirInstr = mir.instr(mir.MIR_VEC_EXTRACT, ?rops[0], 3, 4, 0);
    rops[0]      = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 0)));
    rops[1]      = tvec(1);
    rops[2]      = mir.op_imm(3);
    rmi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len   = 0;
    val r_7096: err[fail.Fail] = encode_vec_lane_read(?st, ?f, ?rmi);
    if (sel r_7096.err) { bad = 1; }

    rops[2]    = mir.op_imm(4);
    st.buf.len = 0;
    val r_7100: err[fail.Fail] = encode_vec_lane_read(?st, ?f, ?rmi);
    if (!sel r_7100.err) { bad = 2; }
    if (st.buf.len != 0) { bad = 3; }

    var wops: [4]mir.MirOperand;
    var wmi:  mir.MirInstr = mir.instr(mir.MIR_VEC_INSERT, ?wops[0], 4, 4, 4);
    wops[0]      = tvec(0);
    wops[1]      = tvec(1);
    wops[2]      = mir.op_imm(3);
    wops[3]      = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 0)));
    wmi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    st.buf.len   = 0;
    val r_7111: err[fail.Fail] = encode_vec_lane_write(?st, ?f, ?wmi);
    if (sel r_7111.err) { bad = 4; }

    wops[2]    = mir.op_imm(4);
    st.buf.len = 0;
    val r_7115: err[fail.Fail] = encode_vec_lane_write(?st, ?f, ?wmi);
    if (!sel r_7115.err) { bad = 5; }
    if (st.buf.len != 0) { bad = 6; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.check_accounted:rejects_unrendered_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: encode.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = encode.buf_init(?alloc);
    st.interner = nil;

    var sink: encode.AsmSink = encode.sink_init(nil, nil);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    val r_7136: err[fail.Fail] = check_accounted(?st, arm64.NOP::u16);
    if (sel r_7136.err) { bad = 1; }

    encode.emit_u32(?st.buf, mop.form(mop.NOP).base);
    val r_7139: err[fail.Fail] = check_accounted(?st, arm64.NOP::u16);
    if (!sel r_7139.err) { bad = 1; }

    encode.sink_claim(?st.buf, 0);
    val r_7142: err[fail.Fail] = check_accounted(?st, arm64.NOP::u16);
    if (sel r_7142.err) { bad = 1; }

    encode.emit_u32(?st.buf, mop.form(mop.NOP).base);
    encode.emit_u32(?st.buf, mop.form(mop.NOP).base);
    encode.sink_claim(?st.buf, 8);
    val r_7147: err[fail.Fail] = check_accounted(?st, arm64.NOP::u16);
    if (!sel r_7147.err) { bad = 1; }

    st.buf.asm = nil;
    encode.emit_u32(?st.buf, mop.form(mop.NOP).base);
    val r_7151: err[fail.Fail] = check_accounted(?st, arm64.NOP::u16);
    if (sel r_7151.err) { bad = 1; }

    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:emitters_notify_once_per_word" {
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    var st:       encode.EncodeState;
    tasm(?st, ?alloc, ?interner);

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = printer.test_sink_write;
    printer.test_sink_reset();

    var sink: encode.AsmSink = encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    emit_movewide_seq(?st, 0, 0x123456789ABCDEF0, true);
    if (st.buf.len != 16)                      { bad = 1; }
    if (encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    emit_mem_access(?st, 0, 1, 100000, 8, true);
    if (encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    if (sink.failed) { bad = 1; }
    encode.buf_dnit(?st.buf);
    ret bad;
}

fun t_cc(r: res[u32, fail.Fail]) u32 {
    if (sel r.err) { ret 0xFFFFFFFF; }
    ret r.ok;
}

fun t_fop(r: res[mop.MachOp, fail.Fail]) mop.MachOp {
    if (sel r.err) { ret mop.MOP_NONE; }
    ret r.ok;
}

test "mach.lang.target.isa.arm64.encode:classifiers_are_total_over_named_forms" {
    var bad: i32 = 0;

    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_EQ)) != CC_EQ)   { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_NE)) != CC_NE)   { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LT_S)) != CC_LT) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LT_U)) != CC_CC) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LE_S)) != CC_LE) { bad = 1; }
    if (t_cc(cmp_cond(mir.MIR_SEL_CMP_LE_U)) != CC_LS) { bad = 1; }

    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_EQ)) != CC_EQ)   { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_NE)) != CC_NE)   { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LT_S)) != CC_LT) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LT_U)) != CC_CC) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LE_S)) != CC_LE) { bad = 1; }
    if (t_cc(fused_cbr_cond(mir.MIR_SEL_CBR_LE_U)) != CC_LS) { bad = 1; }

    if (t_cc(fp_cond(mir.FCC_EQ)) != CC_EQ) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_NE)) != CC_NE) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_LT)) != CC_MI) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_LE)) != CC_LS) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_GT)) != CC_GT) { bad = 1; }
    if (t_cc(fp_cond(mir.FCC_GE)) != CC_GE) { bad = 1; }

    if (t_fop(fp_arith_op(mir.MIR_FADD)) != mop.FADD) { bad = 1; }
    if (t_fop(fp_arith_op(mir.MIR_FSUB)) != mop.FSUB) { bad = 1; }
    if (t_fop(fp_arith_op(mir.MIR_FMUL)) != mop.FMUL) { bad = 1; }
    if (t_fop(fp_arith_op(mir.MIR_FDIV)) != mop.FDIV) { bad = 1; }

    if (t_cc(scale_shift(1)) != 0) { bad = 1; }
    if (t_cc(scale_shift(2)) != 1) { bad = 1; }
    if (t_cc(scale_shift(4)) != 2) { bad = 1; }
    if (t_cc(scale_shift(8)) != 3) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode:unnamed_forms_are_refused" {
    var bad: i32 = 0;

    val r_7234: res[u32, fail.Fail] = cmp_cond(mir.MIR_ADD);
    if (!sel r_7234.err) { bad = 1; }
    val r_7235: res[u32, fail.Fail] = cmp_cond(mir.MIR_SEL_CBR_EQ);
    if (!sel r_7235.err) { bad = 1; }
    val r_7236: res[u32, fail.Fail] = fused_cbr_cond(mir.MIR_ADD);
    if (!sel r_7236.err) { bad = 1; }
    val r_7237: res[u32, fail.Fail] = fused_cbr_cond(mir.MIR_SEL_CBR_LE_U + 1);
    if (!sel r_7237.err) { bad = 1; }
    val r_7238: res[mop.MachOp, fail.Fail] = fp_arith_op(mir.MIR_ADD);
    if (!sel r_7238.err) { bad = 1; }
    val r_7239: res[mop.MachOp, fail.Fail] = fp_arith_op(mir.MIR_FNEG);
    if (!sel r_7239.err) { bad = 1; }

    val r_7241: res[u32, fail.Fail] = fp_cond(mir.FCC_GE + 1);
    if (!sel r_7241.err) { bad = 1; }
    val r_7242: res[u32, fail.Fail] = fp_cond(200);
    if (!sel r_7242.err) { bad = 1; }

    val r_7244: res[u32, fail.Fail] = scale_shift(0);
    if (!sel r_7244.err) { bad = 1; }
    val r_7245: res[u32, fail.Fail] = scale_shift(3);
    if (!sel r_7245.err) { bad = 1; }
    val r_7246: res[u32, fail.Fail] = scale_shift(16);
    if (!sel r_7246.err) { bad = 1; }

    ret bad;
}

pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code == mop.MOV::u32 || code == mop.MOVZ::u32 || code == mop.MOVK::u32 || code == mop.MOVN::u32 ||
        code == mop.ADRP::u32 || code == mop.LDR::u32 || code == mop.STR::u32 ||
        code == mop.LDRB::u32 || code == mop.STRB::u32 || code == mop.LDRH::u32 ||
        code == mop.STRH::u32 || code == mop.LDP::u32 || code == mop.STP::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.ADD::u32 || code == mop.SUB::u32 || code == mop.AND::u32 ||
        code == mop.ORR::u32 || code == mop.EOR::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.CMP::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.CSET::u32) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.LSL::u32 || code == mop.LSR::u32 || code == mop.ASR::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.LSLV::u32 || code == mop.LSRV::u32 || code == mop.ASRV::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_VAR_SHIFT));
    }
    if (code == mop.LDAXR::u32 || code == mop.LDAR::u32 || code == mop.STLXR::u32 ||
        code == mop.STLR::u32 || code == mop.DMB::u32 || code == mop.YIELD::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (a64_pattern(flags) == A64P_BCOND) { ret ct.asm_branch_flags(); }

    if (code == mop.B::u32 || code == mop.BL::u32 || code == mop.SVC::u32 || code == mop.BRK::u32 ||
        code == mop.NOP::u32 || code == mop.MSR::u32 ||
        code == mop.HVC::u32 || code == mop.SMC::u32 || code == mop.WFI::u32 || code == mop.WFE::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == mop.MRS::u32) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.CBZ::u32 || code == mop.CBNZ::u32 || code == mop.BLR::u32 ||
        code == mop.BR::u32 || code == mop.RET::u32) {
        ret ct.asm_branch_reg();
    }

    # rows for the opcodes the encoder emits that the inline-asm grammar has
    # no spelling for: the same closed table, extended, not paralleled
    if (code == mop.BCOND::u32) { ret ct.asm_branch_flags(); }
    if (code == mop.ADDS::u32 || code == mop.SUBS::u32 || code == mop.CMN::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.MUL::u32 || code == mop.MNEG::u32 || code == mop.MADD::u32 || code == mop.MSUB::u32) {
        ret ct.flags_untouched(ct.asm_mul(ct.CT_MUL_LOW));
    }
    if (code == mop.UMULH::u32) { ret ct.flags_untouched(ct.asm_mul(ct.CT_MUL_HIGH_U)); }
    if (code == mop.SMULH::u32) { ret ct.flags_untouched(ct.asm_mul(ct.CT_MUL_HIGH_S)); }
    if (code == mop.V_MUL::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_LOW, mop.elem_bytes(flags) * 8));
    }
    if (code == mop.V_SMULL::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_WIDE_S, mop.elem_bytes(flags) * 8));
    }
    if (code == mop.V_UMULL::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_WIDE_U, mop.elem_bytes(flags) * 8));
    }
    if (code == mop.SDIV::u32 || code == mop.UDIV::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_INT_DIVMOD));
    }
    if (code == mop.MVN::u32 || code == mop.NEG::u32 || code == mop.ORN::u32 ||
        code == mop.UBFX::u32 || code == mop.UBFIZ::u32 || code == mop.SBFX::u32 || code == mop.SBFIZ::u32 ||
        code == mop.UXTB::u32 || code == mop.UXTH::u32 || code == mop.SXTB::u32 || code == mop.SXTH::u32 ||
        code == mop.SXTW::u32 ||
        code == mop.LDUR::u32 || code == mop.STUR::u32 || code == mop.LDURB::u32 || code == mop.STURB::u32 ||
        code == mop.LDURH::u32 || code == mop.STURH::u32 ||
        code == mop.FMOV::u32 || code == mop.FMOV_GEN::u32 || code == mop.FMOV_IMM::u32 ||
        code == mop.V_ADD::u32 || code == mop.V_SUB::u32 || code == mop.V_AND::u32 || code == mop.V_ORR::u32 ||
        code == mop.V_EOR::u32 || code == mop.V_MVN::u32 || code == mop.V_MOV::u32 ||
        code == mop.V_CMEQ::u32 || code == mop.V_CMGT::u32 || code == mop.V_CMGE::u32 ||
        code == mop.V_CMHI::u32 || code == mop.V_CMHS::u32 ||
        code == mop.UMOV::u32 || code == mop.MOV_LANE::u32 || code == mop.INS::u32 || code == mop.DUP::u32 ||
        code == mop.INS_EL::u32 ||
        code == mop.V_SXTL::u32 || code == mop.V_UXTL::u32 || code == mop.V_XTN::u32 ||
        code == mop.V_SQXTN::u32 || code == mop.V_UQXTN::u32 || code == mop.LD1::u32 || code == mop.ST1::u32 ||
        code == mop.SHA256H::u32 || code == mop.SHA256H2::u32 || code == mop.SHA256SU0::u32 || code == mop.SHA256SU1::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == mop.FADD::u32 || code == mop.FSUB::u32 || code == mop.FMUL::u32 || code == mop.FDIV::u32 ||
        code == mop.FNEG::u32 || code == mop.FCVT::u32 || code == mop.SCVTF::u32 || code == mop.UCVTF::u32 ||
        code == mop.FCVTZS::u32 || code == mop.FCVTZU::u32 ||
        code == mop.V_FADD::u32 || code == mop.V_FSUB::u32 || code == mop.V_FMUL::u32 || code == mop.V_FDIV::u32 ||
        code == mop.V_FCMEQ::u32 || code == mop.V_FCMGT::u32 || code == mop.V_FCMGE::u32 ||
        code == mop.V_FCVTL::u32 || code == mop.V_FCVTN::u32 || code == mop.V_SCVTF::u32 ||
        code == mop.V_UCVTF::u32 || code == mop.V_FCVTZS::u32 || code == mop.V_FCVTZU::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_FLOAT));
    }
    if (code == mop.FCMP::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_FLOAT));
    }
    ret ct.asm_unknown();
}

val A64_X30: u64 = 0x40000000;

fun a64_grammar_implicit(code: u32) u32 {
    var i: usize = 0;
    for (i < A64_MNEMONIC_COUNT) {
        if (A64_MNEMONICS[i].code == code) { ret A64_MNEMONICS[i].implicit; }
        i = i + 1;
    }
    ret 0;
}

fun a64_value_operand(op: *isa.Operand) bool {
    ret op.kind == isa.OPK_REG || op.kind == isa.OPK_MEM;
}

fun a64_reads_rest(e: *ct.InstEffects, mi: *isa.Inst, from: u32) {
    if (from <= 1 && a64_value_operand(?mi.src1)) { e.roles[1] = ct.ROLE_READ; }
    if (from <= 2 && a64_value_operand(?mi.src2)) { e.roles[2] = ct.ROLE_READ; }
    if (from <= 3 && a64_value_operand(?mi.src3)) { e.roles[3] = ct.ROLE_READ; }
}

fun a64_target(mi: *isa.Inst, e: *ct.InstEffects) {
    val t: *isa.Operand = ?mi.src2;
    if (t.kind == isa.OPK_SYM) {
        e.target = ct.TARGET_EXTERNAL;
        ret;
    }
    if (t.kind == isa.OPK_LABEL) {
        if ((mi.flags & mop.FLAG_TARGET_BLOCK) != 0 && isa.label_is_block(t)) {
            e.target       = ct.TARGET_BLOCK;
            e.target_block = t.imm::u32;
            ret;
        }
        e.target = ct.TARGET_LOCAL;
        if (isa.label_is_forward_local(t)) {
            e.target     = ct.TARGET_LOCAL_FWD;
            e.local_disp = t.disp;
        }
        ret;
    }
    e.target = ct.TARGET_LOCAL;
}

# the effect description of one emitted aarch64 instruction: the closed class
# row plus the operand roles of the translated form record (dst, src1, src2,
# src3 as to_inst lays them out) and the implicit effects
pub fun inst_effects(mi: *isa.Inst, e: *ct.InstEffects) {
    @e = ct.inst_effects_unknown();
    val op: mop.MachOp = mi.opcode::mop.MachOp;
    if (!mop.known(op)) { ret; }
    e.cls = asm_ct_class(op::u32, 0);
    if (op == mop.V_MUL || op == mop.V_SMULL || op == mop.V_UMULL) { e.cls = asm_ct_class(op::u32, mi.flags); }

    if (op == mop.NOP || op == mop.YIELD || op == mop.WFE || op == mop.WFI || op == mop.DMB) { ret; }
    if (op == mop.BRK) {
        e.xfer = ct.XFER_TRAP;
        ret;
    }
    if (op == mop.SVC || op == mop.HVC || op == mop.SMC) {
        val implicit: u64 = a64_grammar_implicit(op::u32)::u64;
        e.implicit_reads  = implicit;
        e.implicit_writes = implicit;
        ret;
    }
    if (op == mop.MSR) {
        a64_reads_rest(e, mi, 1);
        ret;
    }
    if (op == mop.MRS) {
        e.roles[0] = ct.ROLE_WRITE;
        ret;
    }

    if (op == mop.RET) {
        e.xfer   = ct.XFER_RET;
        e.target = ct.TARGET_REGISTER;
        if (mi.src1.kind == isa.OPK_REG) { e.roles[1] = ct.ROLE_READ; }
        or                               { e.implicit_reads = A64_X30; }
        ret;
    }
    if (op == mop.BR || op == mop.BLR) {
        e.xfer = ct.XFER_JUMP;
        if (op == mop.BLR) {
            e.xfer            = ct.XFER_CALL;
            e.implicit_writes = A64_X30;
        }
        e.target   = ct.TARGET_REGISTER;
        e.roles[1] = ct.ROLE_READ;
        ret;
    }
    if (op == mop.B || op == mop.BL) {
        e.xfer = ct.XFER_JUMP;
        if (op == mop.BL) {
            e.xfer            = ct.XFER_CALL;
            e.implicit_writes = A64_X30;
        }
        a64_target(mi, e);
        ret;
    }
    if (op == mop.BCOND) {
        e.xfer = ct.XFER_BRANCH;
        a64_target(mi, e);
        ret;
    }
    if (op == mop.CBZ || op == mop.CBNZ) {
        e.xfer     = ct.XFER_BRANCH;
        e.roles[1] = ct.ROLE_READ;
        a64_target(mi, e);
        ret;
    }

    if (op == mop.CMP || op == mop.CMN || op == mop.FCMP) {
        a64_reads_rest(e, mi, 1);
        ret;
    }

    if (op == mop.LDR || op == mop.LDRB || op == mop.LDRH || op == mop.LDUR || op == mop.LDURB ||
        op == mop.LDURH || op == mop.LDAR || op == mop.LDAXR) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_READ;
        ret;
    }
    if (op == mop.LD1) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_READ;
        ret;
    }
    if (op == mop.STR || op == mop.STRB || op == mop.STRH || op == mop.STUR || op == mop.STURB ||
        op == mop.STURH || op == mop.STLR || op == mop.ST1) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_READ;
        ret;
    }
    if (op == mop.LDP) {
        e.roles[0]  = ct.ROLE_WRITE;
        e.roles[1]  = ct.ROLE_WRITE;
        e.roles[2]  = ct.ROLE_READ;
        e.mem_bytes = (mi.dst.size * 2)::u8;
        ret;
    }
    if (op == mop.STP) {
        e.roles[0]  = ct.ROLE_WRITE;
        e.roles[1]  = ct.ROLE_READ;
        e.roles[2]  = ct.ROLE_READ;
        e.mem_bytes = (mi.src1.size * 2)::u8;
        ret;
    }
    if (op == mop.STLXR) {
        e.roles[0] = ct.ROLE_WRITE;
        e.roles[1] = ct.ROLE_READ;
        e.roles[2] = ct.ROLE_WRITE;
        ret;
    }

    if (op == mop.MOVK || op == mop.INS || op == mop.INS_EL || op == mop.MOV_LANE ||
        op == mop.SHA256H || op == mop.SHA256H2 || op == mop.SHA256SU0 || op == mop.SHA256SU1) {
        e.roles[0] = ct.ROLE_RW;
        a64_reads_rest(e, mi, 1);
        ret;
    }
    if (op == mop.LSLV || op == mop.LSRV || op == mop.ASRV) { e.count_pos = 2; }

    # every remaining member defines its destination from its sources
    if (mi.dst.kind != isa.OPK_NONE) { e.roles[0] = ct.ROLE_WRITE; }
    a64_reads_rest(e, mi, 1);
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:every_grammar_row_is_classified" {
    var bad: i32   = 0;
    var i:   usize = 0;
    for (i < A64_MNEMONIC_COUNT) {
        if (!asm_ct_class(A64_MNEMONICS[i].code, A64_MNEMONICS[i].flags).known) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:a_spill_does_not_launder_a_secret" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val addr:   str            = "ldr x0, {r}\nstr x0, [sp]\nldr x1, [sp]\nldr x2, [x1]";
    val r_7484: err[fail.Fail] = asm_ct_scan(addr, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7484.err) { bad = bad + 1; }
    val r_7485: err[fail.Fail] = asm_ct_scan(addr, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7485.err) { bad = bad + 2; }

    val br:     str            = "ldr x0, {r}\nstr x0, [sp]\nldr x1, [sp]\ncbnz x1, 1f\n1:\nnop";
    val r_7488: err[fail.Fail] = asm_ct_scan(br, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7488.err) { bad = bad + 4; }
    val r_7489: err[fail.Fail] = asm_ct_scan(br, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7489.err) { bad = bad + 8; }

    ret bad;
}

# a `*^T` binding is a public address whose loads produce a secret; a `^T` binding is a
# secret value, so it is a secret address (#3640)
test "mach.lang.target.isa.arm64.encode.asm_ct_scan:a_pointer_to_a_secret_is_a_public_address_and_a_secret_load" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var binds: [2]ct.AsmSecret;
    binds[0] = ct.asm_secret_pointee("p");
    binds[1] = ct.asm_secret_value("k");

    val rmw: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nldr w1, [x0]\nadd w1, w1, 1\nstr w1, [x0]", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel rmw.err) { bad = bad + 1; }
    val vec: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nld1 {v0.16b}, [x0]\neor v0.16b, v0.16b, v1.16b\nst1 {v0.16b}, [x0]", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel vec.err) { bad = bad + 2; }

    val secret_addr: err[fail.Fail] = asm_ct_scan("ldr x0, {k}\nldr w1, [x0]", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel secret_addr.err) {
        if (!str_contains(fail.describe(secret_addr.err), "addresses memory with a secret value")) { bad = bad + 4; }
    }
    or { bad = bad + 4; }

    val branch: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nldr w1, [x0]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel branch.err) {
        if (!str_contains(fail.describe(branch.err), "branches on a secret value")) { bad = bad + 8; }
    }
    or { bad = bad + 8; }
    val flags: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nldr w1, [x0]\ncmp w1, w2\nb.eq 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel flags.err) { bad = bad + 16; }
    val loaded_addr: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nldr x1, [x0]\nldr x2, [x1]", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel loaded_addr.err) { bad = bad + 32; }
    val copied: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nmov x3, x0\nldr w1, [x3]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel copied.err) { bad = bad + 64; }

    val untracked: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nldr w1, [x0]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel untracked.err) { bad = bad + 128; }
    val spilled: err[fail.Fail] = asm_ct_scan("ldr x0, {p}\nstr x0, [sp]\nldr x3, [sp]\nldr w1, [x3]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel spilled.err) { bad = bad + 256; }

    ret bad;
}

fun t_mul_cell_is(mi: *isa.Inst, op: ct.CtMulOp, width: u8, vector: bool) bool {
    var e: ct.InstEffects;
    inst_effects(mi, ?e);
    val cell: ct.CtMulCell = ctwalk.emitted_mul_cell(mi, ?e);
    ret e.cls.op == ct.CT_OP_INT_MUL && cell.op == op && cell.width == width && cell.vector == vector;
}

# the inline-asm grammar spells no multiply, so the emitted form is the one
# the walk classifies: the low half at the register width, a lane multiply at
# its element width
test "mach.lang.target.isa.arm64.encode.inst_effects:a_multiply_names_its_cell" {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = mop.MUL::u16;
    mi.dst    = mop.gp(0, 8);
    mi.src1   = mop.gp(1, 8);
    mi.src2   = mop.gp(2, 8);
    if (!t_mul_cell_is(?mi, ct.CT_MUL_LOW, 64, false)) { ret 1; }
    mi.dst  = mop.gp(0, 4);
    mi.src1 = mop.gp(1, 4);
    mi.src2 = mop.gp(2, 4);
    if (!t_mul_cell_is(?mi, ct.CT_MUL_LOW, 32, false)) { ret 2; }
    mi.opcode = mop.MSUB::u16;
    if (!t_mul_cell_is(?mi, ct.CT_MUL_LOW, 32, false)) { ret 3; }
    var v: isa.Inst = inst_of(mop.V_MUL, mop.vec(0, 16), mop.vec(1, 16), mop.vec(2, 16));
    v.flags = mop.with_elem_bytes(0, 4);
    if (!t_mul_cell_is(?v, ct.CT_MUL_LOW, 32, true)) { ret 4; }
    var h: isa.Inst = inst_of(mop.UMULH, mop.gp(0, 8), mop.gp(1, 8), mop.gp(2, 8));
    if (!t_mul_cell_is(?h, ct.CT_MUL_HIGH_U, 64, false)) { ret 5; }
    h.opcode = mop.SMULH::u16;
    if (!t_mul_cell_is(?h, ct.CT_MUL_HIGH_S, 64, false)) { ret 6; }
    ret 0;
}

# the preferred `lsl` spelling with a register count is lslv: the variable
# shift class, refused on a secret count when the target does not trust it
test "mach.lang.target.isa.arm64.encode.asm_ct_scan:register_count_shift_alias_is_a_variable_shift" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad:   i32 = 0;
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("c");

    val alias:     str            = "ldr x2, {c}\nlsl x0, x1, x2";
    val spelled:   str            = "ldr x2, {c}\nlslv x0, x1, x2";
    val immediate: str            = "ldr x2, {c}\nlsl x0, x2, 3";
    val r_7506:    err[fail.Fail] = asm_ct_scan(alias, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7506.err) { bad = bad + 1; }
    val r_7507: err[fail.Fail] = asm_ct_scan(spelled, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7507.err) { bad = bad + 2; }
    val r_7508: err[fail.Fail] = asm_ct_scan(alias, ?names[0], 1, ct.mul_mask_none(), true, ?alloc);
    if (sel r_7508.err) { bad = bad + 4; }
    val r_7509: err[fail.Fail] = asm_ct_scan(immediate, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7509.err) { bad = bad + 8; }
    val r_7510: err[fail.Fail] = asm_ct_scan(alias, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7510.err) { bad = bad + 16; }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:branches_are_register_conditioned" {
    var bad: i32 = 0;

    if (!asm_ct_class(mop.CBZ::u32, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(mop.CBNZ::u32, 0).cond_reg) { bad = 1; }
    var i: usize = 0;
    for (i < A64_MNEMONIC_COUNT) {
        if (asm_ct_class(A64_MNEMONICS[i].code, A64_MNEMONICS[i].flags).cond_flags) { bad = 1; }
        i = i + 1;
    }
    if (asm_ct_class(mop.B::u32, 0).cond_reg)  { bad = 1; }
    if (asm_ct_class(mop.BL::u32, 0).cond_reg) { bad = 1; }

    var fi: usize = 0;
    for (fi < A64_MNEMONIC_COUNT) {
        val fc: ct.AsmClass = asm_ct_class(A64_MNEMONICS[fi].code, A64_MNEMONICS[fi].flags);
        if (fc.reads_flags && A64_MNEMONICS[fi].code != mop.CSET::u32 && A64_MNEMONICS[fi].code != mop.MRS::u32) { bad = 1; }
        if (fc.defines_flags && A64_MNEMONICS[fi].code != mop.CMP::u32)                                          { bad = 1; }
        if (fc.opaque_flags)                                                                                     { bad = 1; }
        fi = fi + 1;
    }
    if (!asm_ct_class(mop.CSET::u32, 0).reads_flags)  { bad = 1; }
    if (!asm_ct_class(mop.MRS::u32, 0).reads_flags)   { bad = 1; }
    if (!asm_ct_class(mop.CMP::u32, 0).defines_flags) { bad = 1; }

    if (asm_ct_class(mop.LSLV::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(mop.LSRV::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(mop.ASRV::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(mop.LSL::u32, 0).op != ct.CT_OP_NONE)       { bad = 1; }
    # past the shifts, the rows that vary in latency are the lane multiply,
    # the two scalar high multiplies and the float ops
    var mul:   u32 = 0;
    var mulh:  u32 = 0;
    var float: u32 = 0;
    i = 0;
    for (i < A64_MNEMONIC_COUNT) {
        val row: *iasm.Mnemonic = ?A64_MNEMONICS[i];
        val op:  ct.CtOp        = asm_ct_class(row.code, row.flags).op;
        val vec: bool           = t_vector_row(row);
        if (op == ct.CT_OP_INT_DIVMOD)                                     { bad = 1; }
        if (op == ct.CT_OP_INT_MUL && vec)                                 { mul = mul + 1; }
        or (op == ct.CT_OP_INT_MUL && a64_pattern(row.flags) == A64P_MULH) { mulh = mulh + 1; }
        or (op == ct.CT_OP_INT_MUL)                                        { bad = 1; }
        if (op == ct.CT_OP_FLOAT && vec)                                   { float = float + 1; }
        or (op == ct.CT_OP_FLOAT)                                          { bad = 1; }
        i = i + 1;
    }
    if (mul != 1 || mulh != 2 || float != 7) { bad = 1; }
    i = 0;
    for (i < A64_VEC_TWIN_COUNT) {
        if (asm_ct_class(A64_VEC_TWINS[i].code, A64_VEC_TWINS[i].flags).op != ct.CT_OP_NONE) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_class:indirect_transfers_are_register_conditioned" {
    var bad: i32 = 0;

    if (!asm_ct_class(mop.BR::u32, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(mop.BLR::u32, 0).cond_reg) { bad = 1; }
    if (!asm_ct_class(mop.RET::u32, 0).cond_reg) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:register_indirect_transfer_on_secret_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val brt:    str            = "ldr x9, {r}\nbr x9";
    val r_7573: err[fail.Fail] = asm_ct_scan(brt, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7573.err) { ret 1; }
    val r_7574: err[fail.Fail] = asm_ct_scan(brt, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7574.err) { ret 2; }

    val blrt:   str            = "ldr x9, {r}\nblr x9";
    val r_7577: err[fail.Fail] = asm_ct_scan(blrt, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7577.err) { ret 3; }
    val r_7578: err[fail.Fail] = asm_ct_scan(blrt, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7578.err) { ret 4; }

    val rett:   str            = "ldr x30, {r}\nret";
    val r_7581: err[fail.Fail] = asm_ct_scan(rett, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7581.err) { ret 5; }
    val r_7582: err[fail.Fail] = asm_ct_scan(rett, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7582.err) { ret 6; }

    val retreg: str            = "ldr x9, {r}\nret x9";
    val r_7585: err[fail.Fail] = asm_ct_scan(retreg, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_7585.err) { ret 7; }

    val pubbr:  str            = "mov x9, 5\nbr x9";
    val r_7588: err[fail.Fail] = asm_ct_scan(pubbr, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7588.err) { ret 8; }

    val pubret: str            = "mov x30, 5\nret";
    val r_7591: err[fail.Fail] = asm_ct_scan(pubret, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7591.err) { ret 9; }

    val ordinaryret: str            = "ldr x0, {r}\nret";
    val r_7594:      err[fail.Fail] = asm_ct_scan(ordinaryret, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7594.err) { ret 10; }

    val direct: str            = "b some_symbol";
    val r_7597: err[fail.Fail] = asm_ct_scan(direct, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_7597.err) { ret 11; }

    ret 0;
}

test "mach.lang.target.isa.arm64.encode.asm_ct_scan:cset_flags_taint_reaches_destination_register" {
    var alloc: A.Allocator;
