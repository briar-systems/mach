    if (R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "add x0, x1, 5")))  { bad = 8; }

    if (R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "and x0, x1, x2"))) { bad = 9; }
    if (!R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "and x0, w1, x2"))) { bad = 10; }

    if (R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "cmp x0, x1"))) { bad = 11; }
    if (!R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "cmp x0, w1"))) { bad = 12; }
    if (R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "cmp x0, 5")))  { bad = 13; }

    if (R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "lslv x0, x1, x2"))) { bad = 14; }
    if (!R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "lslv x0, x1, w2"))) { bad = 15; }
    if (R.is_err[R.Void, str](a64_asm_text(?st, ?f, ?labels, "lsl x0, x1, 3")))    { bad = 16; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_call_and_jump_relocations_differ" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val fr: R.Result[intern.StrId, str] = intern.intern(?interner, "fsym");
    if (R.is_err[intern.StrId, str](fr)) { ret 1; }
    val fsym: intern.StrId = R.unwrap_ok[intern.StrId, str](fr);

    a64_asm_text(?st, ?f, ?labels, "bl fsym");
    a64_asm_text(?st, ?f, ?labels, "b fsym");

    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PLT32)  { bad = 2; }
        if (st.relocs[0].sym  != fsym)         { bad = 3; }
        if (st.relocs[1].kind != of.RK_JUMP26) { bad = 4; }
        if (st.relocs[1].sym  != fsym)         { bad = 5; }
    }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_sysreg_moves" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "msr DIT, 1");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, 0");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, 15");
    a64_asm_text(?st, ?f, ?labels, "mrs x0, DIT");
    a64_asm_text(?st, ?f, ?labels, "mrs x19, DIT");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, x1");
    a64_asm_text(?st, ?f, ?labels, "msr DIT, x9");
    a64_asm_text(?st, ?f, ?labels, "msr dit, 1");
    a64_asm_text(?st, ?f, ?labels, "mrs x0, dit");

    if (read_word(?st.buf, 0)  != 0xD503415F) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0xD503405F) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0xD5034F5F) { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD53B42A0) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD53B42B3) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD51B42A1) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD51B42A9) { bad = 1; }
    if (read_word(?st.buf, 28) != 0xD503415F) { bad = 1; }
    if (read_word(?st.buf, 32) != 0xD53B42A0) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_directives" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "nop");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd503201f");
    a64_asm_text(?st, ?f, ?labels, ".long 0xd503201f");
    a64_asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03, 0xd5");
    a64_asm_text(?st, ?f, ?labels, ".quad 0xd503201fd503201f");
    a64_asm_text(?st, ?f, ?labels, ".word 0xd53be040");

    if (read_word(?st.buf, 0)  != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 4)  != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 8)  != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 12) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 16) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 20) != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 24) != 0xD53BE040) { bad = 1; }
    if (st.buf.len != 28) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_data_directive_refusals" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r1: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, ".byte 0x1f");
    if (!R.is_err[R.Void, str](r1))                                                                { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r1), "whole number of instruction words")) { bad = 1; } }

    val r2: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03");
    if (!R.is_err[R.Void, str](r2))                                                                { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r2), "whole number of instruction words")) { bad = 1; } }

    val r3: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, ".word 0x1d503201f");
    if (!R.is_err[R.Void, str](r3))                                                    { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r3), "cannot hold")) { bad = 1; } }

    val r4: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, ".hword 0x1234");
    if (!R.is_err[R.Void, str](r4))                                                                       { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](r4), "unknown aarch64 inline-asm instruction")) { bad = 1; } }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:asm_clobbers_data_directives_are_opaque" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".word 0xd503201f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers(".quad 0xd503201fd503201f", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    asm_clobbers("nop", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    ret bad;
}

fun t_word(text: str, want: u32) bool {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool = false;
    if (!R.is_err[R.Void, str](r) && st.buf.len == 4) { ok = read_word(?st.buf, 0) == want; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

fun t_word_refused(text: str, want: str) bool {
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r: R.Result[R.Void, str] = a64_asm_text(?st, ?f, ?labels, text);
    var ok: bool = false;
    if (R.is_err[R.Void, str](r)) { ok = str_contains(R.unwrap_err[R.Void, str](r), want); }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret ok;
}

