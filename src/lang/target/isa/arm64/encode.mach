# MIR lowered to arm64 instructions, with the frame each function lays out
use mach.lang.fail;
use std.allocator.page;
use io_writer: std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.intern;
use lang_mir: mach.lang.mir;
use mach.lang.target.isa;
use mach.lang.target.isa.arm64;
use arm64_effects:  mach.lang.target.isa.arm64.effects;
use arm64_emit:     mach.lang.target.isa.arm64.emit;
use arm64_grammar:  mach.lang.target.isa.arm64.grammar;
use arm64_inst:     mach.lang.target.isa.arm64.inst;
use arm64_mnemonic: mach.lang.target.isa.arm64.mnemonic;
use arm64_printer:  mach.lang.target.isa.arm64.printer;
use isa_asm:        mach.lang.target.isa.asm;
use mach.lang.target.isa.common;
use mach.lang.target.isa.convplan;
use isa_effect: mach.lang.target.isa.effect;
use isa_encode: mach.lang.target.isa.encode;
use isa_inst:   mach.lang.target.isa.inst;
use target_of:  mach.lang.target.of;

fun req_gpr(op: *lang_mir.MirOperand) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_PREG) {
        if (isa_inst.regid_class(lang_mir.preg_regid(op.preg)) != isa_inst.REG_CLASS_ID_GP) {
            ret res[i32, fail.Fail].err{fail.message("internal compiler error: a float/vector register reached a general-purpose operand position")};
        }
        ret res[i32, fail.Fail].ok{isa_inst.regid_index(lang_mir.preg_regid(op.preg))};
    }
    if (op.kind == lang_mir.MIR_OP_VREG) {
        ret res[i32, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    ret res[i32, fail.Fail].err{fail.message("encode: expected a register operand")};
}

fun resolve_source(st: *isa_encode.EncodeState, op: *lang_mir.MirOperand, scratch: u32, use64: bool) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_IMM) {
        arm64_emit.movewide_seq(st, scratch, op.imm::u64, use64);
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    ret req_gpr(op);
}

rec Mem {
    base:      u32;
    off:       i64;
    has_index: bool;
    index:     u32;
    scale:     u8;
}

# a memory operand as the encoder addresses it. width is the access width, or
# 0 for an address that is computed and never accessed
fun resolve_mem(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand, width: u8) res[Mem, fail.Fail] {
    val r: res[Mem, fail.Fail] = resolve_mem_base(f, op);
    if (sel r.err) { ret r; }
    ret res[Mem, fail.Fail].ok{frame_access(f, r.ok, width)};
}

fun scaled_reach(off: i64, width: u8) bool {
    ret off >= 0 && off % width::i64 == 0 && off / width::i64 <= 4095;
}

# a frame-pointer access neither one-word form reaches takes two words (a
# scratch index); where the frame declares sp fixed, the same byte is one
# scaled word from sp when its sp offset is a non-negative multiple of width
fun frame_access(f: *lang_mir.MirFunction, m: Mem, width: u8) Mem {
    if (width == 0 || m.has_index || m.base != arm64.FP::u32)          { ret m; }
    if (scaled_reach(m.off, width) || (m.off >= -256 && m.off <= 255)) { ret m; }
    if (!lang_mir.sp_fixed(?f.frame))                                  { ret m; }
    val sp_off: i64 = m.off + f.frame.base_dist::i64;
    if (!scaled_reach(sp_off, width)) { ret m; }
    var r: Mem = m;
    r.base = arm64_emit.ZR;
    r.off  = sp_off;
    ret r;
}

fun resolve_mem_base(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand) res[Mem, fail.Fail] {
    if (op.kind != lang_mir.MIR_OP_MEM) {
        ret res[Mem, fail.Fail].err{fail.message("encode: expected a memory operand")};
    }
    var m: Mem;
    m.has_index = false;
    m.index     = 0;
    m.scale     = 0;
    if (sel op.index.vreg) {
        ret res[Mem, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand index")};
    }
    if (sel op.index.preg) {
        m.has_index = true;
        m.index     = isa_inst.regid_index(lang_mir.preg_regid(op.index.preg))::u32;
        m.scale     = op.scale;
    }
    if (!lang_mir.vreg_is_nil(op.vreg)) {
        val slot: opt[i64] = lang_mir.slot_base_offset(?f.frame, op.vreg.n);
        if (!sel slot.some) {
            ret res[Mem, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand base")};
        }
        m.base = isa_encode.slot_base_reg(f, arm64.SP, arm64.FP)::u32;
        m.off  = slot.some + op.imm;
        ret res[Mem, fail.Fail].ok{m};
    }
    m.base = isa_inst.regid_index(lang_mir.preg_regid(op.preg))::u32;
    m.off  = op.imm;
    ret res[Mem, fail.Fail].ok{m};
}

fun emit_add_imm(st: *isa_encode.EncodeState, rd: u32, rn: u32, off: i64) {
    if (off >= 0 && off <= 4095) {
        arm64_emit.addsub_imm(st, arm64_inst.ADD, true, rd, rn, off::u32, 0);
        ret;
    }
    if (off < 0 && off >= -4095) {
        arm64_emit.addsub_imm(st, arm64_inst.SUB, true, rd, rn, (-off)::u32, 0);
        ret;
    }
    if (off > 0 && (off & 0xFFF) == 0 && (off >> 12) <= 4095) {
        arm64_emit.addsub_imm(st, arm64_inst.ADD, true, rd, rn, (off >> 12)::u32, 1);
        ret;
    }
    if (off < 0 && ((-off) & 0xFFF) == 0 && ((-off) >> 12) <= 4095) {
        arm64_emit.addsub_imm(st, arm64_inst.SUB, true, rd, rn, ((-off) >> 12)::u32, 1);
        ret;
    }
    arm64_emit.movewide_seq(st, arm64_emit.SCRATCH0, off::u64, true);
    if (rn == arm64_emit.ZR) {
        arm64_emit.addsub_imm(st, arm64_inst.ADD, true, arm64_emit.SCRATCH1, arm64_emit.ZR, 0, 0);
        arm64_emit.alu3(st, arm64_inst.ADD, true, rd, arm64_emit.SCRATCH1, arm64_emit.SCRATCH0);
        ret;
    }
    arm64_emit.alu3(st, arm64_inst.ADD, true, rd, rn, arm64_emit.SCRATCH0);
}

fun scale_shift(scale: u8) res[u32, fail.Fail] {
    if (scale == 1) { ret res[u32, fail.Fail].ok{0}; }
    if (scale == 2) { ret res[u32, fail.Fail].ok{1}; }
    if (scale == 4) { ret res[u32, fail.Fail].ok{2}; }
    if (scale == 8) { ret res[u32, fail.Fail].ok{3}; }
    ret res[u32, fail.Fail].err{fail.message("encode: a scaled-index address must have a scale of 1, 2, 4, or 8")};
}

fun emit_global_addr(st: *isa_encode.EncodeState, rd: u32, symop: *lang_mir.MirOperand) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: address-of has no resolved symbol name")};
    }
    val ar: err[fail.Fail] = arm64_emit.adrp_reloc(st, rd, symop.sym, symop.sym_off);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.addsub_imm_sym(st, arm64_inst.ADD, true, rd, rd, symop.sym, isa_inst.SYM_MOD_PCREL_LO, symop.sym_off);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_ADD_LO12, symop.sym, symop.sym_off);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_load(st: *isa_encode.EncodeState, rt: u32, symop: *lang_mir.MirOperand, width: u8, is_vec: bool) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: folded-global load has no resolved symbol name")};
    }
    var fr: res[arm64_emit.Access, fail.Fail] = arm64_emit.int_access(width, true);
    if (is_vec)     { fr = arm64_emit.fp_access(width, true); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a:  arm64_emit.Access = fr.ok;
    val ar: err[fail.Fail]    = arm64_emit.adrp_reloc(st, arm64_emit.SCRATCH0, symop.sym, symop.sym_off);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.ldst_sym(st, a.op, a.fp, a.width, rt, arm64_emit.SCRATCH0, symop.sym, isa_inst.SYM_MOD_PCREL_LO, symop.sym_off);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), a.lo12, symop.sym, symop.sym_off);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_store(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, symop: *lang_mir.MirOperand, val_op: *lang_mir.MirOperand, width: u8) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: folded-global store has no resolved symbol name")};
    }
    val vec_val: bool                              = reg_is_vec(val_op) || is_fp_slot(f, val_op);
    var fr:      res[arm64_emit.Access, fail.Fail] = arm64_emit.int_access(width, false);
    if (vec_val)    { fr = arm64_emit.fp_access(width, false); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a: arm64_emit.Access = fr.ok;

    var rt: u32 = arm64_emit.ZR;
    if (vec_val) {
        if (reg_is_vec(val_op)) {
            val vr: res[i32, fail.Fail] = req_vec(val_op);
            if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }
            rt = vr.ok::u32;
        }
        or {
            val lr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, arm64_emit.FP_SCRATCH0, width);
            if (sel lr.err) { ret lr; }
            rt = arm64_emit.FP_SCRATCH0;
        }
    }
    or (val_op.kind == lang_mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            arm64_emit.movewide_seq(st, arm64_emit.SCRATCH1, val_op.imm::u64, arm64_emit.is64(width));
            rt = arm64_emit.SCRATCH1;
        }
    }
    or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }

    val ar: err[fail.Fail] = arm64_emit.adrp_reloc(st, arm64_emit.SCRATCH0, symop.sym, symop.sym_off);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.ldst_sym(st, a.op, a.fp, a.width, rt, arm64_emit.SCRATCH0, symop.sym, isa_inst.SYM_MOD_PCREL_LO, symop.sym_off);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), a.lo12, symop.sym, symop.sym_off);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_global_addr_got(st: *isa_encode.EncodeState, rd: u32, symop: *lang_mir.MirOperand) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: GOT address-of has no resolved symbol name")};
    }
    val ar: err[fail.Fail] = arm64_emit.adrp_got_reloc(st, rd, symop.sym);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.ldst_sym(st, arm64_inst.LDR, false, 8, rd, rd, symop.sym, isa_inst.SYM_MOD_GOT_LO, 0);
    val pr: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_GOT_LO12, symop.sym, 0);
    if (sel pr.err)         { ret err[fail.Fail].err{pr.err}; }
    if (symop.sym_off != 0) { emit_add_imm(st, rd, rd, symop.sym_off::i64); }
    ret err[fail.Fail].ok{};
}

fun emit_global_load_got(st: *isa_encode.EncodeState, rt: u32, symop: *lang_mir.MirOperand, width: u8, is_vec: bool) err[fail.Fail] {
    var fr: res[arm64_emit.Access, fail.Fail] = arm64_emit.int_access(width, true);
    if (is_vec)     { fr = arm64_emit.fp_access(width, true); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    if (is_vec) {
        val vr: err[fail.Fail] = emit_global_addr_got(st, arm64_emit.SCRATCH0, symop);
        if (sel vr.err) { ret vr; }
        ret emit_fp_mem(st, rt, arm64_emit.SCRATCH0, 0, width, true);
    }
    val ar: err[fail.Fail] = emit_global_addr_got(st, rt, symop);
    if (sel ar.err) { ret ar; }
    ret arm64_emit.mem_access(st, rt, rt, 0, width, true);
}

fun emit_global_store_got(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, symop: *lang_mir.MirOperand, val_op: *lang_mir.MirOperand, width: u8) err[fail.Fail] {
    val vec_val: bool                              = reg_is_vec(val_op) || is_fp_slot(f, val_op);
    var fr:      res[arm64_emit.Access, fail.Fail] = arm64_emit.int_access(width, false);
    if (vec_val)    { fr = arm64_emit.fp_access(width, false); }
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }

    var rt: u32 = arm64_emit.ZR;
    if (vec_val) {
        if (reg_is_vec(val_op)) {
            val vr: res[i32, fail.Fail] = req_vec(val_op);
            if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }
            rt = vr.ok::u32;
        }
        or {
            val lr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, arm64_emit.FP_SCRATCH0, width);
            if (sel lr.err) { ret lr; }
            rt = arm64_emit.FP_SCRATCH0;
        }
        val vr2: err[fail.Fail] = emit_global_addr_got(st, arm64_emit.SCRATCH0, symop);
        if (sel vr2.err) { ret vr2; }
        ret emit_fp_mem(st, rt, arm64_emit.SCRATCH0, 0, width, false);
    }
    if (val_op.kind == lang_mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            arm64_emit.movewide_seq(st, arm64_emit.SCRATCH1, val_op.imm::u64, arm64_emit.is64(width));
            rt = arm64_emit.SCRATCH1;
        }
    }
    or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }

    val ar: err[fail.Fail] = emit_global_addr_got(st, arm64_emit.SCRATCH0, symop);
    if (sel ar.err) { ret ar; }
    ret arm64_emit.mem_access(st, rt, arm64_emit.SCRATCH0, 0, width, false);
}

fun encode_call(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1) { ret err[fail.Fail].err{fail.message("encode: call missing callee operand")}; }
    val callee: *lang_mir.MirOperand = ?mi.operands[0];
    if (callee.kind == lang_mir.MIR_OP_SYM) {
        if (intern.str_is_nil(callee.sym)) {
            ret err[fail.Fail].err{fail.message("encode: direct call has no resolved symbol name")};
        }
        val pos: u32 = st.buf.bytes.len::u32;
        # a tail call is the plain branch to the callee
        if (mi.tail) {
            arm64_emit.branch_sym(st, arm64_inst.B, callee.sym, callee.sym_off);
            ret isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_JUMP26, callee.sym, callee.sym_off);
        }
        arm64_emit.branch_sym(st, arm64_inst.BL, callee.sym, callee.sym_off);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_PLT32, callee.sym, callee.sym_off);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }
    val rr: res[i32, fail.Fail] = req_gpr(callee);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    if (mi.tail)    { arm64_emit.branch_reg(st, arm64_inst.BR, rr.ok::u32); }
    or              { arm64_emit.branch_reg(st, arm64_inst.BLR, rr.ok::u32); }
    ret err[fail.Fail].ok{};
}

fun encode_alu3(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, op: arm64_inst.MachOp) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: ALU op missing operands")}; }
    val use64: bool = arm64_emit.is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], arm64_emit.SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[2], arm64_emit.SCRATCH0, use64);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    arm64_emit.alu3(st, op, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

# the high multiplies have no 32-bit form: a narrower width is refused
# rather than silently widened
fun encode_mulh(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, op: arm64_inst.MachOp) err[fail.Fail] {
    if (!arm64_emit.is64(mi.width)) {
        ret err[fail.Fail].err{fail.message("encode: aarch64 umulh/smulh have no 32-bit form (the high half of a 64x64 product only)")};
    }
    ret encode_alu3(st, mi, op);
}

fun encode_addsub(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, is_sub: bool) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: add/sub missing operands")}; }
    val use64: bool = arm64_emit.is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], arm64_emit.SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rhs: *lang_mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == lang_mir.MIR_OP_IMM) {
        val v:    i64               = rhs.imm;
        var op_i: arm64_inst.MachOp = arm64_inst.ADD;
        if (is_sub) { op_i = arm64_inst.SUB; }
        if (v >= 0 && v <= 4095) {
            arm64_emit.addsub_imm(st, op_i, use64, rd, rn, v::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            arm64_emit.addsub_imm(st, op_i, use64, rd, rn, (v >> 12)::u32, 1);
            ret err[fail.Fail].ok{};
        }
    }

    val rmr: res[i32, fail.Fail] = resolve_source(st, rhs, arm64_emit.SCRATCH0, use64);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm:   u32               = rmr.ok::u32;
    var op_r: arm64_inst.MachOp = arm64_inst.ADD;
    if (is_sub) { op_r = arm64_inst.SUB; }
    arm64_emit.alu3(st, op_r, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun encode_shift(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, kind: u32) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: shift missing operands")}; }
    val use64: bool = arm64_emit.is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], arm64_emit.SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val cnt: *lang_mir.MirOperand = ?mi.operands[2];
    if (cnt.kind == lang_mir.MIR_OP_IMM) {
        var width_bits: u32 = 32;
        if (use64) { width_bits = 64; }
        val sh:   u32               = cnt.imm::u32 & (width_bits - 1);
        var op_i: arm64_inst.MachOp = arm64_inst.LSL;
        if (kind == arm64.LSR::u32) { op_i = arm64_inst.LSR; }
        or (kind == arm64.ASR::u32) { op_i = arm64_inst.ASR; }
        arm64_emit.bitfield(st, op_i, use64, rd, rn, sh, 0);
        ret err[fail.Fail].ok{};
    }

    val rmr: res[i32, fail.Fail] = req_gpr(cnt);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm:   u32               = rmr.ok::u32;
    var op_v: arm64_inst.MachOp = arm64_inst.LSLV;
    if (kind == arm64.LSR::u32) { op_v = arm64_inst.LSRV; }
    or (kind == arm64.ASR::u32) { op_v = arm64_inst.ASRV; }
    arm64_emit.alu3(st, op_v, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun encode_neg_mvn(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, op: arm64_inst.MachOp) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: neg/not missing operands")}; }
    val use64: bool = arm64_emit.is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], arm64_emit.SCRATCH0, use64);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    arm64_emit.alu3(st, op, use64, rd, arm64_emit.ZR, rm);
    ret err[fail.Fail].ok{};
}

fun encode_mov(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: mov missing operands")}; }
    val use64: bool = arm64_emit.is64(mi.width);

    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    val src: *lang_mir.MirOperand = ?mi.operands[1];

    if (dst.kind == lang_mir.MIR_OP_MEM) {
        ret emit_store_mem(st, f, dst, src, mi.width);
    }

    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    if (src.kind == lang_mir.MIR_OP_MEM) {
        val mr: res[Mem, fail.Fail] = resolve_mem(f, src, mi.width);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed spill reload not expected")}; }
        ret arm64_emit.mem_access(st, rd, m.base, m.off, mi.width, true);
    }

    if (src.kind == lang_mir.MIR_OP_IMM) {
        arm64_emit.movewide_seq(st, rd, src.imm::u64, use64);
        ret err[fail.Fail].ok{};
    }
    val rmr: res[i32, fail.Fail] = req_gpr(src);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;
    arm64_emit.alu3(st, arm64_inst.ORR, use64, rd, arm64_emit.ZR, rm);
    ret err[fail.Fail].ok{};
}

fun emit_store_mem(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, dst_mem: *lang_mir.MirOperand, val_op: *lang_mir.MirOperand, width: u8) err[fail.Fail] {
    if (dst_mem.kind == lang_mir.MIR_OP_SYM) {
        if (dst_mem.sym_got) { ret emit_global_store_got(st, f, dst_mem, val_op, width); }
        ret emit_global_store(st, f, dst_mem, val_op, width);
    }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, dst_mem, width);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed store not expected")}; }

    if (reg_is_vec(val_op)) {
        val rvr: res[i32, fail.Fail] = req_vec(val_op);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        ret emit_fp_mem(st, rvr.ok::u32, m.base, m.off, width, false);
    }

    if (is_fp_slot(f, val_op)) {
        val ldr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, arm64_emit.FP_SCRATCH0, width);
        if (sel ldr.err) { ret ldr; }
        ret emit_fp_mem(st, arm64_emit.FP_SCRATCH0, m.base, m.off, width, false);
    }

    var rt: u32 = arm64_emit.ZR;
    if (val_op.kind == lang_mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            arm64_emit.movewide_seq(st, arm64_emit.SCRATCH1, val_op.imm::u64, arm64_emit.is64(width));
            rt = arm64_emit.SCRATCH1;
        }
    }
    or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }
    ret arm64_emit.mem_access(st, rt, m.base, m.off, width, false);
}

fun encode_load(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: load missing operands")}; }
    val dstop: *lang_mir.MirOperand = ?mi.operands[0];
    val src:   *lang_mir.MirOperand = ?mi.operands[1];

    # a spilled destination takes the value through the scratch, so a
    # symbol source is read with its relocation like any other
    if (is_fp_slot(f, dstop)) {
        val ldr: err[fail.Fail] = emit_vec_load(st, f, src, arm64_emit.FP_SCRATCH0, mi.src_width);
        if (sel ldr.err) { ret ldr; }
        ret emit_fp_slot_store(st, f, dstop, arm64_emit.FP_SCRATCH0, mi.src_width);
    }

    if (reg_is_vec(dstop)) {
        val rvr: res[i32, fail.Fail] = req_vec(dstop);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        ret emit_vec_load(st, f, src, rvr.ok::u32, mi.src_width);
    }

    val rdr: res[i32, fail.Fail] = req_gpr(dstop);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    if (src.kind == lang_mir.MIR_OP_SYM) {
        if (src.sym_got) { ret emit_global_load_got(st, rd, src, mi.src_width, false); }
        ret emit_global_load(st, rd, src, mi.src_width, false);
    }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, src, mi.src_width);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed load not expected")}; }
    ret arm64_emit.mem_access(st, rd, m.base, m.off, mi.src_width, true);
}

fun emit_vec_load(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, src: *lang_mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    if (src.kind == lang_mir.MIR_OP_SYM) {
        if (src.sym_got) { ret emit_global_load_got(st, rt, src, width, true); }
        ret emit_global_load(st, rt, src, width, true);
    }
    val fmr: res[Mem, fail.Fail] = resolve_mem(f, src, width);
    if (sel fmr.err) { ret err[fail.Fail].err{fmr.err}; }
    val fm: Mem = fmr.ok;
    if (fm.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float load not expected")}; }
    ret emit_fp_mem(st, rt, fm.base, fm.off, width, true);
}

fun encode_store(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: store missing operands")}; }
    ret emit_store_mem(st, f, ?mi.operands[0], ?mi.operands[1], mi.width);
}

fun encode_addr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: address op missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val memop: *lang_mir.MirOperand = ?mi.operands[1];
    if (memop.kind == lang_mir.MIR_OP_SYM) {
        if (memop.sym_got) { ret emit_global_addr_got(st, rd, memop); }
        ret emit_global_addr(st, rd, memop);
    }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, memop, 0);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;

    if (!m.has_index) {
        emit_add_imm(st, rd, m.base, m.off);
        ret err[fail.Fail].ok{};
    }
    val shr: res[u32, fail.Fail] = scale_shift(m.scale);
    if (sel shr.err) { ret err[fail.Fail].err{shr.err}; }
    val sh:    u32 = shr.ok;
    var ibase: u32 = m.base;
    if (ibase == arm64_emit.ZR) {
        arm64_emit.addsub_imm(st, arm64_inst.ADD, true, arm64_emit.SCRATCH0, arm64_emit.ZR, 0, 0);
        ibase = arm64_emit.SCRATCH0;
    }
    if (m.off == 0) {
        arm64_emit.alu3_sh(st, arm64_inst.ADD, true, rd, ibase, m.index, sh);
        ret err[fail.Fail].ok{};
    }
    emit_add_imm(st, rd, ibase, m.off);
    arm64_emit.alu3_sh(st, arm64_inst.ADD, true, rd, rd, m.index, sh);
    ret err[fail.Fail].ok{};
}

fun encode_convert(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: conversion missing operands")}; }
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd:  u32                 = rdr.ok::u32;
    val rsr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], arm64_emit.SCRATCH0, arm64_emit.is64(sw));
    if (sel rsr.err) { ret err[fail.Fail].err{rsr.err}; }
    val rs: u32 = rsr.ok::u32;

    if (mi.opcode == lang_mir.MIR_TRUNC) {
        arm64_emit.alu3(st, arm64_inst.ORR, false, rd, arm64_emit.ZR, rs);
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == lang_mir.MIR_BITCAST) {
        arm64_emit.alu3(st, arm64_inst.ORR, arm64_emit.is64(dw), rd, arm64_emit.ZR, rs);
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == lang_mir.MIR_SEXT) {
        if (sw >= 8) {
            arm64_emit.alu3(st, arm64_inst.ORR, true, rd, arm64_emit.ZR, rs);
            ret err[fail.Fail].ok{};
        }
        arm64_emit.bitfield(st, extend_op(true, sw), arm64_emit.is64(dw), rd, rs, 0, 0);
        ret err[fail.Fail].ok{};
    }
    if (sw >= 4) {
        arm64_emit.alu3(st, arm64_inst.ORR, false, rd, arm64_emit.ZR, rs);
        ret err[fail.Fail].ok{};
    }
    arm64_emit.bitfield(st, extend_op(false, sw), false, rd, rs, 0, 0);
    ret err[fail.Fail].ok{};
}

# the extend alias that widens a narrow source: sxtb/sxth/sxtw or uxtb/uxth
fun extend_op(signed: bool, sw: u8) arm64_inst.MachOp {
    if (signed) {
        if (sw == 1) { ret arm64_inst.SXTB; }
        if (sw == 2) { ret arm64_inst.SXTH; }
        ret arm64_inst.SXTW;
    }
    if (sw == 1) { ret arm64_inst.UXTB; }
    ret arm64_inst.UXTH;
}

fun reg_is_vec(op: *lang_mir.MirOperand) bool {
    ret op.kind == lang_mir.MIR_OP_PREG && isa_inst.regid_class(lang_mir.preg_regid(op.preg)) == isa_inst.REG_CLASS_ID_FP;
}

fun req_vec(op: *lang_mir.MirOperand) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_PREG) {
        if (isa_inst.regid_class(lang_mir.preg_regid(op.preg)) != isa_inst.REG_CLASS_ID_FP) {
            ret res[i32, fail.Fail].err{fail.message("internal compiler error: a general-purpose register reached a float/vector operand position")};
        }
        ret res[i32, fail.Fail].ok{isa_inst.regid_index(lang_mir.preg_regid(op.preg))};
    }
    if (op.kind == lang_mir.MIR_OP_VREG) {
        ret res[i32, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    ret res[i32, fail.Fail].err{fail.message("encode: expected a float register operand")};
}

fun emit_fp_mem(st: *isa_encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) err[fail.Fail] {
    val fr: res[arm64_emit.Access, fail.Fail] = arm64_emit.fp_access(width, is_load);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a:  arm64_emit.Access = fr.ok;
    val sh: u32               = a.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) {
            arm64_emit.ldst(st, a.op, a.fp, a.width, rt, base, (off >> sh::i64)::u32);
            ret err[fail.Fail].ok{};
        }
    }
    if (off >= -256 && off <= 255) {
        arm64_emit.ldur(st, a.unscaled, a.fp, a.width, rt, base, off::u32 & 0x1FF);
        ret err[fail.Fail].ok{};
    }
    arm64_emit.movewide_seq(st, arm64_emit.SCRATCH0, off::u64, true);
    arm64_emit.ldst_reg(st, a.op, a.fp, a.width, rt, base, arm64_emit.SCRATCH0);
    ret err[fail.Fail].ok{};
}

fun emit_fp_slot_store(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, memop: *lang_mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    val mr: res[Mem, fail.Fail] = resolve_mem(f, memop, width);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill destination not expected")}; }
    ret emit_fp_mem(st, rt, m.base, m.off, width, false);
}

fun emit_fp_slot_load(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, memop: *lang_mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    val mr: res[Mem, fail.Fail] = resolve_mem(f, memop, width);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill source not expected")}; }
    ret emit_fp_mem(st, rt, m.base, m.off, width, true);
}

fun is_fp_slot(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand) bool {
    ret op.kind == lang_mir.MIR_OP_MEM && !lang_mir.vreg_is_nil(op.vreg) && lang_mir.vreg_is_fp(f, op.vreg);
}

fun fmov_imm8(bits: u64, use64: bool) opt[u32] {
    var sign: u32 = 0;
    var exp:  u32 = 0;
    var frac: u32 = 0;
    var reps: u32 = 0;
    if (use64) {
        if ((bits & 0xFFFFFFFFFFFF) != 0) { ret opt[u32].none{}; }
        sign = ((bits >> 63) & 0x1)::u32;
        exp  = ((bits >> 52) & 0x7FF)::u32;
        frac = ((bits >> 48) & 0xF)::u32;
        reps = 8;
    }
    or {
        val b32: u32 = (bits & 0xFFFFFFFF)::u32;
        if ((b32 & 0x7FFFF) != 0) { ret opt[u32].none{}; }
        sign = (b32 >> 31) & 0x1;
        exp  = (b32 >> 23) & 0xFF;
        frac = (b32 >> 19) & 0xF;
        reps = 5;
    }
    val top: u32 = (exp >> (reps + 2)) & 0x1;
    val b:   u32 = (exp >> (reps + 1)) & 0x1;
    if (top == b) { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < reps) {
        if (((exp >> (2 + i)) & 0x1) != b) { ret opt[u32].none{}; }
        i = i + 1;
    }
    ret opt[u32].some{(sign << 7) | (b << 6) | ((exp & 0x3) << 4) | frac};
}

fun emit_fmov_imm(st: *isa_encode.EncodeState, rd: u32, imm8: u32, use64: bool) {
    var mi: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.FMOV_IMM, arm64_inst.vec(rd, arm64_emit.width_bytes(use64)), isa_inst.make_none(), isa_inst.make_imm(imm8::i64, 1));
    arm64_emit.inst(st, ?mi);
}

fun emit_fp_const(st: *isa_encode.EncodeState, vd: u32, bits: u64, width: u8) err[fail.Fail] {
    if (width == 2) {
        # an f16 pattern is one movz into the low half of a single-precision register
        arm64_emit.movewide_seq(st, arm64_emit.SCRATCH0, bits & 0xFFFF, false);
        arm64_emit.cvt(st, arm64_inst.FMOV_GEN, arm64_inst.vec(vd, 4), arm64_inst.gp(arm64_emit.SCRATCH0, 4));
        ret err[fail.Fail].ok{};
    }
    if (!common.is_float_width(width)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float constant has a non-float width (expected 4 or 8)")};
    }
    val use64:   bool = width == 8;
    var pattern: u64  = bits;
    if (!use64) { pattern = bits & 0xFFFFFFFF; }

    val w: u8 = arm64_emit.width_bytes(use64);

    if (pattern == 0) {
        arm64_emit.cvt(st, arm64_inst.FMOV_GEN, arm64_inst.vec(vd, w), arm64_inst.gp(arm64_emit.ZR, w));
        ret err[fail.Fail].ok{};
    }
    val i8: opt[u32] = fmov_imm8(pattern, use64);
    if (sel i8.some) {
        emit_fmov_imm(st, vd, i8.some, use64);
        ret err[fail.Fail].ok{};
    }
    if (arm64_emit.const_words(pattern, use64) <= 1) {
        arm64_emit.movewide_seq(st, arm64_emit.SCRATCH0, pattern, use64);
        arm64_emit.cvt(st, arm64_inst.FMOV_GEN, arm64_inst.vec(vd, w), arm64_inst.gp(arm64_emit.SCRATCH0, w));
        ret err[fail.Fail].ok{};
    }

    val sr: res[intern.StrId, fail.Fail] = isa_encode.intern_float_const(st, pattern, width);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sym: intern.StrId = sr.ok;

    val fr: res[arm64_emit.Access, fail.Fail] = arm64_emit.fp_access(width, true);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val a:  arm64_emit.Access = fr.ok;
    val ar: err[fail.Fail]    = arm64_emit.adrp_reloc(st, arm64_emit.SCRATCH0, sym, 0);
    if (sel ar.err) { ret ar; }
    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.ldst_sym(st, a.op, a.fp, a.width, vd, arm64_emit.SCRATCH0, sym, isa_inst.SYM_MOD_PCREL_LO, 0);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), a.lo12, sym, 0);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun resolve_fp_source(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, op: *lang_mir.MirOperand, scratch: u32, width: u8) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_MEM) {
        val mr: res[Mem, fail.Fail] = resolve_mem(f, op, width);
        if (sel mr.err) { ret res[i32, fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        if (m.has_index) { ret res[i32, fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
        val lr: err[fail.Fail] = emit_fp_mem(st, scratch, m.base, m.off, width, true);
        if (sel lr.err) { ret res[i32, fail.Fail].err{lr.err}; }
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    if (op.kind == lang_mir.MIR_OP_IMM) {
        val cr: err[fail.Fail] = emit_fp_const(st, scratch, op.imm::u64, width);
        if (sel cr.err) { ret res[i32, fail.Fail].err{cr.err}; }
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    ret req_vec(op);
}

fun fp_arith_op(op: lang_mir.MirOpcode) res[arm64_inst.MachOp, fail.Fail] {
    if (op == lang_mir.MIR_FADD) { ret res[arm64_inst.MachOp, fail.Fail].ok{arm64_inst.FADD}; }
    if (op == lang_mir.MIR_FSUB) { ret res[arm64_inst.MachOp, fail.Fail].ok{arm64_inst.FSUB}; }
    if (op == lang_mir.MIR_FMUL) { ret res[arm64_inst.MachOp, fail.Fail].ok{arm64_inst.FMUL}; }
    if (op == lang_mir.MIR_FDIV) { ret res[arm64_inst.MachOp, fail.Fail].ok{arm64_inst.FDIV}; }
    ret res[arm64_inst.MachOp, fail.Fail].err{fail.message("encode: aarch64 has no float arithmetic form for this opcode")};
}

fun fp_cond(cc: u8) res[u32, fail.Fail] {
    if (cc == lang_mir.FCC_EQ) { ret res[u32, fail.Fail].ok{arm64_emit.CC_EQ}; }
    if (cc == lang_mir.FCC_NE) { ret res[u32, fail.Fail].ok{arm64_emit.CC_NE}; }
    if (cc == lang_mir.FCC_LT) { ret res[u32, fail.Fail].ok{arm64_emit.CC_MI}; }
    if (cc == lang_mir.FCC_LE) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LS}; }
    if (cc == lang_mir.FCC_GT) { ret res[u32, fail.Fail].ok{arm64_emit.CC_GT}; }
    if (cc == lang_mir.FCC_GE) { ret res[u32, fail.Fail].ok{arm64_emit.CC_GE}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 has no float comparison condition for this condition code")};
}

fun encode_fp_arith(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: float arithmetic missing operands")}; }
    val w: u8 = mi.width;
    if (!arm64_emit.scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float arithmetic has a non-float operand width (expected 2, 4 or 8)")};
    }

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], arm64_emit.FP_SCRATCH1, w);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val opr: res[arm64_inst.MachOp, fail.Fail] = fp_arith_op(mi.opcode);
    if (sel opr.err) { ret err[fail.Fail].err{opr.err}; }
    val fop: arm64_inst.MachOp    = opr.ok;
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        arm64_emit.fp3(st, fop, w, arm64_emit.FP_SCRATCH0, rn, rm);
        ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, w);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    arm64_emit.fp3(st, fop, w, rdr.ok::u32, rn, rm);
    ret err[fail.Fail].ok{};
}

fun neon_size(vl: u32) u32 {
    val eb: u8 = lang_mir.vec_lane_elem_bytes(vl);
    if (lang_mir.vec_lane_kind(vl) == lang_mir.VEC_LANE_FLOAT) {
        if (eb == 8) { ret 1; }
        ret 0;
    }
    if (eb == 2) { ret 1; }
    if (eb == 4) { ret 2; }
    if (eb == 8) { ret 3; }
    ret 0;
}

fun encode_vec_lane_read(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: vector lane read missing operands")}; }
    val vl: u32 = mi.vec_lane;
    if (!lang_mir.vec_lane_is_vector(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane read carries no lane descriptor")}; }
    val lane_op: *lang_mir.MirOperand = ?mi.operands[2];
    if (lane_op.kind != lang_mir.MIR_OP_IMM) { ret err[fail.Fail].err{fail.message("encode: vector lane index is not an immediate")}; }
    val index: u32 = lane_op.imm::u32;
    if (index >= lang_mir.vec_lane_count(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane index out of range for lane arrangement")}; }

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst:      *lang_mir.MirOperand = ?mi.operands[0];
    val is_float: bool                 = lang_mir.vec_lane_kind(vl) == lang_mir.VEC_LANE_FLOAT;

    if (is_float) {
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            arm64_emit.neon_dup_el(st, index, arm64_emit.FP_SCRATCH1, rn, vl);
            ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH1, mi.width);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        arm64_emit.neon_dup_el(st, index, rdr.ok::u32, rn, vl);
        ret err[fail.Fail].ok{};
    }

    if (dst.kind == lang_mir.MIR_OP_MEM) {
        arm64_emit.neon_umov(st, index, arm64_emit.SCRATCH0, rn, vl);
        val mr: res[Mem, fail.Fail] = resolve_mem(f, dst, mi.width);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed lane-read spill not expected")}; }
        ret arm64_emit.mem_access(st, arm64_emit.SCRATCH0, m.base, m.off, mi.width, false);
    }
    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    arm64_emit.neon_umov(st, index, rdr.ok::u32, rn, vl);
    ret err[fail.Fail].ok{};
}

fun encode_vec_lane_write(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) { ret err[fail.Fail].err{fail.message("encode: vector lane write missing operands")}; }
    val vl: u32 = mi.vec_lane;
    if (!lang_mir.vec_lane_is_vector(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane write carries no lane descriptor")}; }
    val lane_op: *lang_mir.MirOperand = ?mi.operands[2];
    if (lane_op.kind != lang_mir.MIR_OP_IMM) { ret err[fail.Fail].err{fail.message("encode: vector lane index is not an immediate")}; }
    val index: u32 = lane_op.imm::u32;
    if (index >= lang_mir.vec_lane_count(vl)) { ret err[fail.Fail].err{fail.message("encode: vector lane index out of range for lane arrangement")}; }

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst:     *lang_mir.MirOperand = ?mi.operands[0];
    var rd:      u32                  = arm64_emit.FP_SCRATCH1;
    var to_slot: bool                 = false;
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        to_slot = true;
    }
    or {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        rd = rdr.ok::u32;
    }

    if (rd != rn) { arm64_emit.neon_3same(st, arm64_inst.V_ORR, rd, rn, rn, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16)); }

    if (lang_mir.vec_lane_kind(vl) == lang_mir.VEC_LANE_FLOAT) {
        val rvr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[3], arm64_emit.FP_SCRATCH0, mi.src_width);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        arm64_emit.neon_ins_el(st, index, 0, rd, rvr.ok::u32, vl);
    }
    or {
        val rvr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[3], arm64_emit.SCRATCH0, lang_mir.vec_lane_elem_bytes(vl) == 8);
        if (sel rvr.err) { ret err[fail.Fail].err{rvr.err}; }
        var src_bytes: u8 = 4;
        if (lang_mir.vec_lane_elem_bytes(vl) == 8) { src_bytes = 8; }
        arm64_emit.neon_ins_gp(st, index, rd, rvr.ok::u32, vl, src_bytes);
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret err[fail.Fail].ok{};
}

fun neon_op(opcode: u32, is_float: bool) arm64_inst.MachOp {
    if (opcode == arm64.VEC_ADD::u32) {
        if (is_float) { ret arm64_inst.V_FADD; }
        ret arm64_inst.V_ADD;
    }
    if (opcode == arm64.VEC_SUB::u32) {
        if (is_float) { ret arm64_inst.V_FSUB; }
        ret arm64_inst.V_SUB;
    }
    if (opcode == arm64.VEC_MUL::u32) {
        if (is_float) { ret arm64_inst.V_FMUL; }
        ret arm64_inst.V_MUL;
    }
    if (opcode == arm64.VEC_DIV::u32) { ret arm64_inst.V_FDIV; }
    if (opcode == arm64.VEC_AND::u32) { ret arm64_inst.V_AND; }
    if (opcode == arm64.VEC_ORR::u32) { ret arm64_inst.V_ORR; }
    if (opcode == arm64.VEC_EOR::u32) { ret arm64_inst.V_EOR; }
    if (opcode == arm64.VEC_CMEQ::u32) {
        if (is_float) { ret arm64_inst.V_FCMEQ; }
        ret arm64_inst.V_CMEQ;
    }
    if (opcode == arm64.VEC_CMGT::u32) {
        if (is_float) { ret arm64_inst.V_FCMGT; }
        ret arm64_inst.V_CMGT;
    }
    if (opcode == arm64.VEC_CMGE::u32) {
        if (is_float) { ret arm64_inst.V_FCMGE; }
        ret arm64_inst.V_CMGE;
    }
    if (opcode == arm64.VEC_CMHI::u32) { ret arm64_inst.V_CMHI; }
    if (opcode == arm64.VEC_CMHS::u32) { ret arm64_inst.V_CMHS; }
    ret arm64_inst.MOP_NONE;
}

# the refusal for a three-register-same arrangement the ISA leaves
# unallocated: only the integer multiply lacks size 3, and every other opcode
# encodes at every size (a partition, enumerated by its test)
fun neon_3same_refusal(op: arm64_inst.MachOp, size: u32) opt[str] {
    if (op == arm64_inst.V_MUL && size == 3) {
        ret opt[str].some{"encode: NEON integer multiply has no 64-bit lane arrangement (MUL (vector) leaves size 3 unallocated)"};
    }
    ret opt[str].none{};
}

# one conversion step into the work register: the first step reads the operand, every later one the work register
fun nconv_step(p: *convplan.Plan, op: arm64_inst.MachOp, from_bytes: u8) {
    var src: convplan.Place = convplan.PLACE_WORK;
    if (p.len == 0) { src = convplan.PLACE_OPERAND; }
    convplan.push(p, op::u32, convplan.PLACE_WORK, src, from_bytes::u32);
}

fun nconv_narrow(p: *convplan.Plan, from: u8, to: u8) {
    var w: u8 = from;
    for (w > to) {
        nconv_step(p, arm64_inst.V_XTN, w);
        w = w / 2;
    }
}

# the NEON conversion sequence of each lane, for the cells the aarch64 packed table
# declares. a float to integer lane saturates at the 32 or 64 bits the scalar
# conversion saturates at and is then truncated as the scalar result is, so a
# 64-bit saturation narrows to 32 bits by saturating again
fun nconv_plan(op: lang_mir.MirOpcode, to_float: bool, to: u8, from_float: bool, from: u8) opt[convplan.Plan] {
    var p: convplan.Plan = convplan.plan();
    if (op == lang_mir.MIR_SEXT || op == lang_mir.MIR_ZEXT) {
        var lengthen: arm64_inst.MachOp = arm64_inst.V_UXTL;
        if (op == lang_mir.MIR_SEXT) { lengthen = arm64_inst.V_SXTL; }
        var w: u8 = from;
        for (w < to) {
            nconv_step(?p, lengthen, w);
            w = w * 2;
        }
    }
    or (op == lang_mir.MIR_TRUNC)                            { nconv_narrow(?p, from, to); }
    or (op == lang_mir.MIR_FP_EXT && from == 4 && to == 8)   { nconv_step(?p, arm64_inst.V_FCVTL, 4); }
    or (op == lang_mir.MIR_FP_TRUNC && from == 8 && to == 4) { nconv_step(?p, arm64_inst.V_FCVTN, 8); }
    or (op == lang_mir.MIR_FP_EXT && from == 2 && to == 4)   { nconv_step(?p, arm64_inst.V_FCVTL, 2); }
    or (op == lang_mir.MIR_FP_TRUNC && from == 4 && to == 2) { nconv_step(?p, arm64_inst.V_FCVTN, 4); }
    or ((op == lang_mir.MIR_SI_TO_FP || op == lang_mir.MIR_UI_TO_FP) && !from_float && to_float && from <= to) {
        var lengthen: arm64_inst.MachOp = arm64_inst.V_UXTL;
        var convert:  arm64_inst.MachOp = arm64_inst.V_UCVTF;
        if (op == lang_mir.MIR_SI_TO_FP) {
            lengthen = arm64_inst.V_SXTL;
            convert  = arm64_inst.V_SCVTF;
        }
        var w: u8 = from;
        for (w < to) {
            nconv_step(?p, lengthen, w);
            w = w * 2;
        }
        nconv_step(?p, convert, to);
    }
    or ((op == lang_mir.MIR_FP_TO_SI || op == lang_mir.MIR_FP_TO_UI) && from_float && !to_float) {
        var convert:  arm64_inst.MachOp = arm64_inst.V_FCVTZU;
        var saturate: arm64_inst.MachOp = arm64_inst.V_UQXTN;
        if (op == lang_mir.MIR_FP_TO_SI) {
            convert  = arm64_inst.V_FCVTZS;
            saturate = arm64_inst.V_SQXTN;
        }
        if (from == 4 && to == 8) {
            nconv_step(?p, arm64_inst.V_FCVTL, 4);
            nconv_step(?p, convert, 8);
        }
        or {
            nconv_step(?p, convert, from);
            var w: u8 = from;
            if (from == 8 && to < 8) {
                nconv_step(?p, saturate, 8);
                w = 4;
            }
            nconv_narrow(?p, w, to);
        }
    }
    or                            { ret opt[convplan.Plan].none{}; }
    if (p.overflow || p.len == 0) { ret opt[convplan.Plan].none{}; }
    ret opt[convplan.Plan].some{p};
}

fun nconv_place(place: convplan.Place, rn: u32, work: u32) res[u32, fail.Fail] {
    if (place == convplan.PLACE_OPERAND) { ret res[u32, fail.Fail].ok{rn}; }
    if (place == convplan.PLACE_WORK)    { ret res[u32, fail.Fail].ok{work}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 lane conversions take no temporary")};
}

# the register the result forms in: the destination unless it is a frame slot or aliases an operand the
# plan reads after writing, else a scratch register that does not alias the operand either
fun nconv_work(p: *convplan.Plan, rn: u32, rd: u32) u32 {
    if (convplan.in_destination(p, rd != NO_DEST, rd == rn, false)) { ret rd; }
    if (rn == arm64_emit.FP_SCRATCH0 && !convplan.alias_safe(p))    { ret arm64_emit.FP_SCRATCH1; }
    ret arm64_emit.FP_SCRATCH0;
}

fun emit_nconv(st: *isa_encode.EncodeState, p: *convplan.Plan, rn: u32, rd: u32) err[fail.Fail] {
    val work: u32 = nconv_work(p, rn, rd);
    var i:    u32 = 0;
    for (i < p.len) {
        val step: convplan.Step       = p.steps[i];
        val dst:  res[u32, fail.Fail] = nconv_place(step.dst, rn, work);
        if (sel dst.err) { ret err[fail.Fail].err{dst.err}; }
        val src: res[u32, fail.Fail] = nconv_place(step.src, rn, work);
        if (sel src.err) { ret err[fail.Fail].err{src.err}; }
        arm64_emit.neon_conv(st, step.op::arm64_inst.MachOp, dst.ok, src.ok, step.arg::u8);
        i = i + 1;
    }
    if (rd != NO_DEST && rd != work) { arm64_emit.neon_3same(st, arm64_inst.V_ORR, rd, work, work, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16)); }
    ret err[fail.Fail].ok{};
}

val NO_DEST: u32 = 0xFFFFFFFF;

# the widening multiplies the aarch64 packed table declares: the long
# multiply over the low halves, which hold every operand lane of a product
# that fits one register
fun encode_neon_widen_mul(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: widening multiply missing operands")}; }
    val vl:   u32 = mi.vec_lane;
    val from: u8  = lang_mir.vec_lane_from_bytes(vl);
    if (lang_mir.vec_lane_kind(vl) != lang_mir.VEC_LANE_INT || lang_mir.vec_lane_from_kind(vl) != lang_mir.VEC_LANE_INT
        || from > 4 || lang_mir.vec_lane_elem_bytes(vl) != from * 2
        || lang_mir.vec_lane_count(vl) * lang_mir.vec_lane_elem_bytes(vl)::u32 > 16) {
        ret err[fail.Fail].err{fail.message("encode: widening multiply outside the aarch64 packed table")};
    }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], arm64_emit.FP_SCRATCH1, 16);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    var long: arm64_inst.MachOp = arm64_inst.V_UMULL;
    if (mi.opcode == lang_mir.MIR_MUL_WIDE_S) { long = arm64_inst.V_SMULL; }
    # a fourth operand selects the upper halves, the second-part form
    if (mi.operand_count >= 4) {
        if (mi.operands[3].kind != lang_mir.MIR_OP_IMM) {
            ret err[fail.Fail].err{fail.message("encode: widening multiply half is not an immediate")};
        }
        if (mi.operands[3].imm != 0) {
            long = arm64_inst.V_UMULL2;
            if (mi.opcode == lang_mir.MIR_MUL_WIDE_S) { long = arm64_inst.V_SMULL2; }
        }
    }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        arm64_emit.neon_3diff(st, long, arm64_emit.FP_SCRATCH0, rnr.ok::u32, rmr.ok::u32, from);
        ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, 16);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    arm64_emit.neon_3diff(st, long, rdr.ok::u32, rnr.ok::u32, rmr.ok::u32, from);
    ret err[fail.Fail].ok{};
}

# the work register's value into the destination, a register or a frame slot
fun neon_result_to(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, dst: *lang_mir.MirOperand, work: u32) err[fail.Fail] {
    if (dst.kind == lang_mir.MIR_OP_MEM) { ret emit_fp_slot_store(st, f, dst, work, 16); }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    if (rdr.ok::u32 != work) {
        arm64_emit.neon_3same(st, arm64_inst.V_ORR, rdr.ok::u32, work, work, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16));
    }
    ret err[fail.Fail].ok{};
}

# a lane range: ext moves the source's bytes from the first lane on to the
# bottom of the register; the lanes past the range are left unspecified, as in
# any narrow vector
fun encode_neon_range(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3 || mi.operands[2].kind != lang_mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane range missing operands")};
    }
    val eb:  i64 = lang_mir.vec_lane_elem_bytes(mi.vec_lane)::i64;
    val off: i64 = mi.operands[2].imm * eb;
    if (eb == 0 || off < 0 || off >= 16) {
        ret err[fail.Fail].err{fail.message("encode: lane range starts outside the source register")};
    }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    if (off == 0)    { ret neon_result_to(st, f, ?mi.operands[0], rnr.ok::u32); }
    arm64_emit.neon_ext(st, arm64_emit.FP_SCRATCH0, rnr.ok::u32, rnr.ok::u32, off::u32);
    ret neon_result_to(st, f, ?mi.operands[0], arm64_emit.FP_SCRATCH0);
}

# a lane join of two parts, the low one `k` bytes: when it fills a doubleword
# the high part's doubleword is inserted above it; otherwise ext rotates the
# low part's bytes to the top and a second ext takes them and the high part's
# bytes below them
fun encode_neon_concat(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4 || mi.operands[3].kind != lang_mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane join missing operands")};
    }
    val k: i64 = mi.operands[3].imm * lang_mir.vec_lane_elem_bytes(mi.vec_lane)::i64;
    if (k <= 0 || k >= 16) {
        ret err[fail.Fail].err{fail.message("encode: lane join low part does not leave room in the register")};
    }
    val lor: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel lor.err) { ret err[fail.Fail].err{lor.err}; }
    val hir: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], arm64_emit.FP_SCRATCH1, 16);
    if (sel hir.err) { ret err[fail.Fail].err{hir.err}; }
    val lo: u32 = lor.ok::u32;
    val hi: u32 = hir.ok::u32;
    if (k == 8) {
        if (lo != arm64_emit.FP_SCRATCH0) {
            arm64_emit.neon_3same(st, arm64_inst.V_ORR, arm64_emit.FP_SCRATCH0, lo, lo, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16));
        }
        arm64_emit.neon_ins_el(st, 1, 0, arm64_emit.FP_SCRATCH0, hi, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 8, 2));
        ret neon_result_to(st, f, ?mi.operands[0], arm64_emit.FP_SCRATCH0);
    }
    arm64_emit.neon_ext(st, arm64_emit.FP_SCRATCH0, lo, lo, k::u32);
    arm64_emit.neon_ext(st, arm64_emit.FP_SCRATCH0, arm64_emit.FP_SCRATCH0, hi, (16 - k)::u32);
    ret neon_result_to(st, f, ?mi.operands[0], arm64_emit.FP_SCRATCH0);
}

# the lane-halving extension: the shift-left-long of the low half, or of the
# high half through its second-part form, widens every lane of one register
fun encode_neon_widen_half(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: lane-halving extension missing operands")}; }
    if (mi.operands[2].kind != lang_mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension base is not an immediate")};
    }
    val vl:    u32 = mi.vec_lane;
    val from:  u8  = lang_mir.vec_lane_from_bytes(vl);
    val lanes: u32 = lang_mir.vec_lane_count(vl);
    if (lang_mir.vec_lane_kind(vl) != lang_mir.VEC_LANE_INT || lang_mir.vec_lane_from_kind(vl) != lang_mir.VEC_LANE_INT
        || from > 4 || lang_mir.vec_lane_elem_bytes(vl) != from * 2 || lanes * lang_mir.vec_lane_elem_bytes(vl)::u32 != 16) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension outside the aarch64 packed table")};
    }
    val base: i64 = mi.operands[2].imm;
    if (base != 0 && base != lanes::i64) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension base names neither half")};
    }
    var op: arm64_inst.MachOp = arm64_inst.V_UXTL;
    if (mi.opcode == lang_mir.MIR_VEC_WIDEN_S) { op = arm64_inst.V_SXTL; }
    if (base != 0) {
        op = arm64_inst.V_UXTL2;
        if (mi.opcode == lang_mir.MIR_VEC_WIDEN_S) { op = arm64_inst.V_SXTL2; }
    }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        arm64_emit.neon_conv(st, op, arm64_emit.FP_SCRATCH0, rnr.ok::u32, from);
        ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, 16);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    arm64_emit.neon_conv(st, op, rdr.ok::u32, rnr.ok::u32, from);
    ret err[fail.Fail].ok{};
}

fun encode_neon_convert(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: vector conversion missing operands")}; }
    val vl:      u32                = mi.vec_lane;
    val planned: opt[convplan.Plan] = nconv_plan(mi.opcode,
        lang_mir.vec_lane_kind(vl) == lang_mir.VEC_LANE_FLOAT, lang_mir.vec_lane_elem_bytes(vl),
        lang_mir.vec_lane_from_kind(vl) == lang_mir.VEC_LANE_FLOAT, lang_mir.vec_lane_from_bytes(vl));
    if (sel planned.none) { ret err[fail.Fail].err{fail.message("encode: vector conversion outside the aarch64 packed table")}; }
    var p:   convplan.Plan       = planned.some;
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        val body: err[fail.Fail] = emit_nconv(st, ?p, rnr.ok::u32, NO_DEST);
        if (sel body.err) { ret body; }
        ret emit_fp_slot_store(st, f, dst, nconv_work(?p, rnr.ok::u32, NO_DEST), 16);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    ret emit_nconv(st, ?p, rnr.ok::u32, rdr.ok::u32);
}

fun encode_neon(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val vl:       u32  = mi.vec_lane;
    val is_float: bool = lang_mir.vec_lane_kind(vl) == lang_mir.VEC_LANE_FLOAT;
    val size:     u32  = neon_size(vl);
    val op:       u32  = mi.opcode;

    if (op == arm64.VEC_NOT::u32) {
        if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: vector NOT missing operands")}; }
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn:   u32                  = rnr.ok::u32;
        val ndst: *lang_mir.MirOperand = ?mi.operands[0];
        if (ndst.kind == lang_mir.MIR_OP_MEM) {
            arm64_emit.neon_2misc(st, arm64_inst.V_MVN, arm64_emit.FP_SCRATCH0, rn);
            ret emit_fp_slot_store(st, f, ndst, arm64_emit.FP_SCRATCH0, 16);
        }
        val rdr: res[i32, fail.Fail] = req_vec(ndst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        arm64_emit.neon_2misc(st, arm64_inst.V_MVN, rdr.ok::u32, rn);
        ret err[fail.Fail].ok{};
    }

    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: vector op missing operands")}; }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn:  u32                 = rnr.ok::u32;
    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], arm64_emit.FP_SCRATCH1, 16);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val dst:     *lang_mir.MirOperand = ?mi.operands[0];
    var rd:      u32                  = arm64_emit.FP_SCRATCH0;
    var to_slot: bool                 = false;
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        to_slot = true;
    }
    or {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        rd = rdr.ok::u32;
    }

    if (op == arm64.VEC_CMNE::u32) {
        var eqop: arm64_inst.MachOp = arm64_inst.V_CMEQ;
        if (is_float) { eqop = arm64_inst.V_FCMEQ; }
        val eq_refusal: opt[str] = neon_3same_refusal(eqop, size);
        if (sel eq_refusal.some) { ret err[fail.Fail].err{fail.message(eq_refusal.some)}; }
        arm64_emit.neon_3same(st, eqop, rd, rn, rm, vl);
        arm64_emit.neon_2misc(st, arm64_inst.V_MVN, rd, rd);
    }
    or {
        var eff_size: u32 = size;
        if (op == arm64.VEC_AND::u32 || op == arm64.VEC_ORR::u32 || op == arm64.VEC_EOR::u32) { eff_size = 0; }
        val vop:     arm64_inst.MachOp = neon_op(op, is_float);
        val refusal: opt[str]          = neon_3same_refusal(vop, eff_size);
        if (sel refusal.some) { ret err[fail.Fail].err{fail.message(refusal.some)}; }
        arm64_emit.neon_3same(st, vop, rd, rn, rm, vl);
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret err[fail.Fail].ok{};
}

# a shift count of lane counts, in a vector register or the frame slot of a
# spilled vector value; a uniform count is a general scalar
fun shift_count_is_vector(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand) bool {
    if (op.kind == lang_mir.MIR_OP_PREG) { ret reg_is_vec(op); }
    ret is_fp_slot(f, op);
}

# a lane-wise shift, whose lanes saturate as the scalar shift does: a
# count at or above the lane width answers 0, or the sign fill for an
# arithmetic right shift. a constant count is shl, ushr or sshr by the
# immediate, and a constant out of range is the fill itself. any other count
# is a vector of lane counts in scratch1, dup'd from a uniform count's
# register, and ushl or sshl shift by it. those read a lane count's low byte
# as signed, shifting right when it is negative, so a count is first clamped
# to 127 by uqshl then ushr by the lane width less 7, which keeps a count below
# 128 and makes any larger one 127, at or above every lane width; a right
# shift then negates it. shifted by 127 either way, every bit leaves the lane
fun encode_neon_shift(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: vector shift missing operands")}; }
    val vl: u32 = mi.vec_lane;
    val eb: u8  = lang_mir.vec_lane_elem_bytes(vl);
    if (lang_mir.vec_lane_kind(vl) != lang_mir.VEC_LANE_INT || (eb != 1 && eb != 2 && eb != 4 && eb != 8)) {
        ret err[fail.Fail].err{fail.message("encode: vector shift lane is not an integer lane NEON shifts")};
    }
    val esize: u32  = eb::u32 * 8;
    val right: bool = mi.opcode != arm64.VEC_SHL::u32;
    val arith: bool = mi.opcode == arm64.VEC_SHR_S::u32;
    val bytes: u32  = lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16);

    val dst:     *lang_mir.MirOperand = ?mi.operands[0];
    var rd:      u32                  = arm64_emit.FP_SCRATCH0;
    var to_slot: bool                 = dst.kind == lang_mir.MIR_OP_MEM;
    if (!to_slot) {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        rd = rdr.ok::u32;
    }

    val cnt: *lang_mir.MirOperand = ?mi.operands[2];
    if (cnt.kind != lang_mir.MIR_OP_IMM) {
        var counts: u32 = arm64_emit.FP_SCRATCH1;
        if (shift_count_is_vector(f, cnt)) {
            val cr: res[i32, fail.Fail] = resolve_fp_source(st, f, cnt, arm64_emit.FP_SCRATCH1, 16);
            if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
            counts = cr.ok::u32;
        }
        or {
            var g: u32 = arm64_emit.SCRATCH1;
            if (cnt.kind == lang_mir.MIR_OP_MEM) {
                val mr: res[Mem, fail.Fail] = resolve_mem(f, cnt, eb);
                if (sel mr.err)      { ret err[fail.Fail].err{mr.err}; }
                if (mr.ok.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed shift count spill not expected")}; }
                val lr: err[fail.Fail] = arm64_emit.mem_access(st, arm64_emit.SCRATCH1, mr.ok.base, mr.ok.off, eb, true);
                if (sel lr.err) { ret lr; }
            }
            or {
                val gr: res[i32, fail.Fail] = req_gpr(cnt);
                if (sel gr.err) { ret err[fail.Fail].err{gr.err}; }
                g = gr.ok::u32;
            }
            arm64_emit.neon_dup_gp(st, arm64_emit.FP_SCRATCH1, g, vl);
        }
        arm64_emit.neon_shift_imm(st, arm64_inst.V_UQSHL, arm64_emit.FP_SCRATCH1, counts, esize - 7, vl);
        arm64_emit.neon_shift_imm(st, arm64_inst.V_USHR, arm64_emit.FP_SCRATCH1, arm64_emit.FP_SCRATCH1, esize - 7, vl);
        if (right) { arm64_emit.neon_2misc_lanes(st, arm64_inst.V_NEG, arm64_emit.FP_SCRATCH1, arm64_emit.FP_SCRATCH1, vl); }
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        var by: arm64_inst.MachOp = arm64_inst.V_USHL;
        if (arith) { by = arm64_inst.V_SSHL; }
        arm64_emit.neon_3same(st, by, rd, rnr.ok::u32, arm64_emit.FP_SCRATCH1, vl);
    }
    or {
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, 16);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn:  u32  = rnr.ok::u32;
        val sh:  i64  = cnt.imm;
        val out: bool = sh < 0 || sh >= esize::i64;
        if (out && arith)        { arm64_emit.neon_shift_imm(st, arm64_inst.V_SSHR, rd, rn, esize, vl); }
        or (out)                 { arm64_emit.neon_3same(st, arm64_inst.V_EOR, rd, rd, rd, bytes); }
        or (!right)              { arm64_emit.neon_shift_imm(st, arm64_inst.V_SHL, rd, rn, sh::u32, vl); }
        or (sh == 0 && rd != rn) { arm64_emit.neon_3same(st, arm64_inst.V_ORR, rd, rn, rn, bytes); }
        or (sh != 0 && arith)    { arm64_emit.neon_shift_imm(st, arm64_inst.V_SSHR, rd, rn, sh::u32, vl); }
        or (sh != 0)             { arm64_emit.neon_shift_imm(st, arm64_inst.V_USHR, rd, rn, sh::u32, vl); }
    }

    if (to_slot) { ret emit_fp_slot_store(st, f, dst, rd, 16); }
    ret err[fail.Fail].ok{};
}

fun encode_fp_neg(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: float negate missing operands")}; }
    val w: u8 = mi.width;
    if (!arm64_emit.scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float negate has a non-float operand width (expected 2, 4 or 8)")};
    }
    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        arm64_emit.fp2(st, arm64_inst.FNEG, w, arm64_emit.FP_SCRATCH0, rn);
        ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, w);
    }
    val rdr: res[i32, fail.Fail] = req_vec(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    arm64_emit.fp2(st, arm64_inst.FNEG, w, rdr.ok::u32, rn);
    ret err[fail.Fail].ok{};
}

fun encode_fp_cmp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: float comparison missing operands")}; }
    val w: u8 = mi.width;
    if (!arm64_emit.scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float comparison has a non-float operand width (expected 2, 4 or 8)")};
    }
    val cc: u8 = mi.src_width;

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], arm64_emit.FP_SCRATCH1, w);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    arm64_emit.fcmp(st, w, rn, rm);
    val ccr: res[u32, fail.Fail] = fp_cond(cc);
    if (sel ccr.err) { ret err[fail.Fail].err{ccr.err}; }
    arm64_emit.cset(st, false, rd, ccr.ok);
    ret err[fail.Fail].ok{};
}

fun encode_fp_conv(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: float conversion missing operands")}; }
    val op: lang_mir.MirOpcode = mi.opcode;
    val dw: u8                 = mi.width;
    val sw: u8                 = mi.src_width;

    if (op == lang_mir.MIR_FP_TRUNC || op == lang_mir.MIR_FP_EXT) {
        if (!arm64_emit.scalar_float_width(dw) || !arm64_emit.scalar_float_width(sw) || dw == sw) {
            ret err[fail.Fail].err{fail.message("internal compiler error: float conversion has a non-float width on a float side (expected 2, 4 or 8)")};
        }
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, sw);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn:  u32                  = rnr.ok::u32;
        val dst: *lang_mir.MirOperand = ?mi.operands[0];
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            arm64_emit.fcvt(st, dw, sw, arm64_emit.FP_SCRATCH0, rn);
            ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, dw);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        arm64_emit.fcvt(st, dw, sw, rdr.ok::u32, rn);
        ret err[fail.Fail].ok{};
    }

    if (op == lang_mir.MIR_SI_TO_FP || op == lang_mir.MIR_UI_TO_FP) {
        if (!arm64_emit.scalar_float_width(dw)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: integer-to-float conversion has a non-float result width (expected 2, 4 or 8)")};
        }
        val signed: bool                = op == lang_mir.MIR_SI_TO_FP;
        val gpr:    res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
        if (sel gpr.err) { ret err[fail.Fail].err{gpr.err}; }
        var gp:    u32  = gpr.ok::u32;
        var src_x: bool = sw >= 8;
        if (sw < 4) {
            arm64_emit.bitfield(st, extend_op(signed, sw), false, arm64_emit.SCRATCH0, gp, 0, 0);
            gp    = arm64_emit.SCRATCH0;
            src_x = false;
        }
        var cop: arm64_inst.MachOp = arm64_inst.UCVTF;
        if (signed) { cop = arm64_inst.SCVTF; }
        val src: isa_inst.Operand     = arm64_inst.gp(gp, arm64_emit.width_bytes(src_x));
        val dst: *lang_mir.MirOperand = ?mi.operands[0];
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            arm64_emit.cvt(st, cop, arm64_inst.vec(arm64_emit.FP_SCRATCH0, dw), src);
            ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, dw);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        arm64_emit.cvt(st, cop, arm64_inst.vec(rdr.ok::u32, dw), src);
        ret err[fail.Fail].ok{};
    }

    if (!arm64_emit.scalar_float_width(sw)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float-to-integer conversion has a non-float source width (expected 2, 4 or 8)")};
    }
    val signed: bool                = op == lang_mir.MIR_FP_TO_SI;
    val rnr:    res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], arm64_emit.FP_SCRATCH0, sw);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn:  u32                 = rnr.ok::u32;
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd:  u32               = rdr.ok::u32;
    var cop: arm64_inst.MachOp = arm64_inst.FCVTZU;
    if (signed) { cop = arm64_inst.FCVTZS; }
    arm64_emit.cvt(st, cop, arm64_inst.gp(rd, arm64_emit.width_bytes(dw >= 8)), arm64_inst.vec(rn, sw));
    ret err[fail.Fail].ok{};
}

fun encode_fmov(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: fmov missing operands")}; }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    val src: *lang_mir.MirOperand = ?mi.operands[1];

    if (mi.width == 16) {
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, src, arm64_emit.FP_SCRATCH0, 16);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            ret emit_fp_slot_store(st, f, dst, rnr.ok::u32, 16);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        val rd: u32 = rdr.ok::u32;
        if (src.kind == lang_mir.MIR_OP_MEM) {
            ret emit_fp_slot_load(st, f, src, rd, 16);
        }
        val rnr: res[i32, fail.Fail] = req_vec(src);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn: u32 = rnr.ok::u32;
        arm64_emit.neon_3same(st, arm64_inst.V_ORR, rd, rn, rn, lang_mir.vec_lane_make(lang_mir.VEC_LANE_INT, 1, 16));
        ret err[fail.Fail].ok{};
    }

    val w: u8 = mi.width;
    if (!arm64_emit.scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float move has a non-float operand width (expected 2, 4, 8 or 16)")};
    }
    # an f16 moves between registers as the single-precision register it sits
    # in the low half of, since fmov at half precision is FEAT_FP16 and the
    # conversion rows it serves are not; bits above the half are no part of it
    var reg_w: u8 = w;
    if (w == 2) { reg_w = 4; }

    if (src.kind == lang_mir.MIR_OP_IMM) {
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            val cr: err[fail.Fail] = emit_fp_const(st, arm64_emit.FP_SCRATCH0, src.imm::u64, w);
            if (sel cr.err) { ret cr; }
            ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, w);
        }
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        ret emit_fp_const(st, rdr.ok::u32, src.imm::u64, w);
    }

    if (dst.kind != lang_mir.MIR_OP_MEM && src.kind != lang_mir.MIR_OP_MEM) {
        val dvec: bool = reg_is_vec(dst);
        val svec: bool = reg_is_vec(src);
        if (dvec && svec) {
            val rdr: res[i32, fail.Fail] = req_vec(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_vec(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            arm64_emit.fp2(st, arm64_inst.FMOV, reg_w, rdr.ok::u32, rnr.ok::u32);
            ret err[fail.Fail].ok{};
        }
        if (dvec) {
            val rdr: res[i32, fail.Fail] = req_vec(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_gpr(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            arm64_emit.cvt(st, arm64_inst.FMOV_GEN, arm64_inst.vec(rdr.ok::u32, reg_w), arm64_inst.gp(rnr.ok::u32, reg_w));
            ret err[fail.Fail].ok{};
        }
        if (svec) {
            val rdr: res[i32, fail.Fail] = req_gpr(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_vec(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            arm64_emit.cvt(st, arm64_inst.FMOV_GEN, arm64_inst.gp(rdr.ok::u32, reg_w), arm64_inst.vec(rnr.ok::u32, reg_w));
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{fail.message("encode: fmov names two general-purpose registers")};
    }

    if (dst.kind == lang_mir.MIR_OP_MEM) {
        if (src.kind == lang_mir.MIR_OP_MEM) {
            val mr: res[Mem, fail.Fail] = resolve_mem(f, src, w);
            if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
            val m: Mem = mr.ok;
            if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
            val lr: err[fail.Fail] = emit_fp_mem(st, arm64_emit.FP_SCRATCH0, m.base, m.off, w, true);
            if (sel lr.err) { ret lr; }
            ret emit_fp_slot_store(st, f, dst, arm64_emit.FP_SCRATCH0, w);
        }
        if (reg_is_vec(src)) {
            val rnr: res[i32, fail.Fail] = req_vec(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            ret emit_fp_slot_store(st, f, dst, rnr.ok::u32, w);
        }
        ret emit_store_mem(st, f, dst, src, w);
    }

    if (reg_is_vec(dst)) {
        val rdr: res[i32, fail.Fail] = req_vec(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        val mr: res[Mem, fail.Fail] = resolve_mem(f, src, w);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
        ret emit_fp_mem(st, rdr.ok::u32, m.base, m.off, w, true);
    }
    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, src, w);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
    ret arm64_emit.mem_access(st, rdr.ok::u32, m.base, m.off, w, true);
}

fun cmp_cond(op: lang_mir.MirOpcode) res[u32, fail.Fail] {
    if (op == lang_mir.MIR_SEL_CMP_EQ)   { ret res[u32, fail.Fail].ok{arm64_emit.CC_EQ}; }
    if (op == lang_mir.MIR_SEL_CMP_NE)   { ret res[u32, fail.Fail].ok{arm64_emit.CC_NE}; }
    if (op == lang_mir.MIR_SEL_CMP_LT_S) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LT}; }
    if (op == lang_mir.MIR_SEL_CMP_LT_U) { ret res[u32, fail.Fail].ok{arm64_emit.CC_CC}; }
    if (op == lang_mir.MIR_SEL_CMP_LE_S) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LE}; }
    if (op == lang_mir.MIR_SEL_CMP_LE_U) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LS}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 has no comparison condition for this relation")};
}

fun narrow_cmp_source(st: *isa_encode.EncodeState, reg: u32, scratch: u32, width: u8, signed: bool) u32 {
    if (width == 0 || width >= 4) { ret reg; }
    arm64_emit.bitfield(st, extend_op(signed, width), false, scratch, reg, 0, 0);
    ret scratch;
}

fun cmp_imm_value(imm: i64, width: u8, signed: bool) i64 {
    if (width == 1) {
        var v: i64 = imm & 0xFF;
        if (signed && (v & 0x80) != 0) { v = v - 0x100; }
        ret v;
    }
    if (width == 2) {
        var v: i64 = imm & 0xFFFF;
        if (signed && (v & 0x8000) != 0) { v = v - 0x10000; }
        ret v;
    }
    ret imm;
}

fun emit_flag_cmp(st: *isa_encode.EncodeState, lhs_op: *lang_mir.MirOperand, rhs_op: *lang_mir.MirOperand,
    width: u8, signed: bool) err[fail.Fail] {
    val use64: bool = arm64_emit.is64(width);

    val rnr: res[i32, fail.Fail] = resolve_source(st, lhs_op, arm64_emit.SCRATCH1, use64);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    var rn: u32 = rnr.ok::u32;
    rn = narrow_cmp_source(st, rn, arm64_emit.SCRATCH1, width, signed);

    val rhs_val: i64 = cmp_imm_value(rhs_op.imm, width, signed);
    if (rhs_op.kind == lang_mir.MIR_OP_IMM && rhs_val >= 0 && rhs_val <= 4095) {
        arm64_emit.addsub_imm(st, arm64_inst.SUBS, use64, arm64_emit.ZR, rn, rhs_val::u32, 0);
    }
    or {
        val rmr: res[i32, fail.Fail] = resolve_source(st, rhs_op, arm64_emit.SCRATCH0, use64);
        if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
        var rm: u32 = rmr.ok::u32;
        rm = narrow_cmp_source(st, rm, arm64_emit.SCRATCH0, width, signed);
        arm64_emit.alu3(st, arm64_inst.SUBS, use64, arm64_emit.ZR, rn, rm);
    }
    ret err[fail.Fail].ok{};
}

fun encode_compare(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: compare missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rc: err[fail.Fail] = emit_flag_cmp(st, ?mi.operands[1], ?mi.operands[2], mi.width, lang_mir.is_signed_cmp(mi.opcode));
    if (sel rc.err) { ret rc; }

    val ccr: res[u32, fail.Fail] = cmp_cond(mi.opcode);
    if (sel ccr.err) { ret err[fail.Fail].err{ccr.err}; }
    arm64_emit.cset(st, false, rd, ccr.ok);
    ret err[fail.Fail].ok{};
}

# `cmp a, b` leaves the carry clear exactly when a is below b unsigned, and
# `csetm d, lo` writes all ones or zero from it
fun encode_compare_mask(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: compare-to-mask missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rc: err[fail.Fail] = emit_flag_cmp(st, ?mi.operands[1], ?mi.operands[2], mi.src_width, false);
    if (sel rc.err) { ret rc; }
    var m: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.CSETM, arm64_inst.gp(rdr.ok::u32, arm64_emit.width_bytes(arm64_emit.is64(mi.width))), isa_inst.make_none(), isa_inst.make_none());
    m.flags = arm64_inst.with_cond(0, arm64_emit.CC_CC);
    arm64_emit.inst(st, ?m);
    ret err[fail.Fail].ok{};
}

# the condition an integer compare holds on after `cmp lhs, rhs`
fun compare_cond(op: lang_mir.MirOpcode) res[u32, fail.Fail] {
    if (op == lang_mir.MIR_CMP_EQ)   { ret res[u32, fail.Fail].ok{arm64_emit.CC_EQ}; }
    if (op == lang_mir.MIR_CMP_NE)   { ret res[u32, fail.Fail].ok{arm64_emit.CC_NE}; }
    if (op == lang_mir.MIR_CMP_LT_S) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LT}; }
    if (op == lang_mir.MIR_CMP_LT_U) { ret res[u32, fail.Fail].ok{arm64_emit.CC_CC}; }
    if (op == lang_mir.MIR_CMP_LE_S) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LE}; }
    if (op == lang_mir.MIR_CMP_LE_U) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LS}; }
    ret res[u32, fail.Fail].err{fail.message("encode: a select names no integer compare")};
}

# a select: the folded compare, or a compare of the condition with
# zero as the conditional branch tests it, and `csel d, a, b, cc`, so no
# branch is taken on a secret condition
fun encode_select(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val fused: bool = mi.opcode == lang_mir.MIR_SEL_SELECT_CMP;
    var need:  u32  = 4;
    var ai:    u32  = 2;
    if (fused) {
        need = 6;
        ai   = 3;
    }
    if (mi.operand_count < need) { ret err[fail.Fail].err{fail.message("encode: select missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rar: res[i32, fail.Fail] = req_gpr(?mi.operands[ai]);
    if (sel rar.err) { ret err[fail.Fail].err{rar.err}; }
    val rbr: res[i32, fail.Fail] = req_gpr(?mi.operands[ai + 1]);
    if (sel rbr.err) { ret err[fail.Fail].err{rbr.err}; }

    var cc: u32 = arm64_emit.CC_NE;
    if (fused) {
        val op: lang_mir.MirOpcode  = mi.operands[5].imm::lang_mir.MirOpcode;
        val cr: res[u32, fail.Fail] = compare_cond(op);
        if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
        cc = cr.ok;
        val signed: bool           = op == lang_mir.MIR_CMP_LT_S || op == lang_mir.MIR_CMP_LE_S;
        val rc:     err[fail.Fail] = emit_flag_cmp(st, ?mi.operands[1], ?mi.operands[2], mi.src_width, signed);
        if (sel rc.err) { ret rc; }
    }
    or {
        val rcr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
        if (sel rcr.err) { ret err[fail.Fail].err{rcr.err}; }
        arm64_emit.addsub_imm(st, arm64_inst.SUBS, arm64_emit.is64(mi.src_width), arm64_emit.ZR, rcr.ok::u32, 0, 0);
    }
    val w: u8            = arm64_emit.width_bytes(arm64_emit.is64(mi.width));
    var m: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.CSEL, arm64_inst.gp(rdr.ok::u32, w), arm64_inst.gp(rar.ok::u32, w), arm64_inst.gp(rbr.ok::u32, w));
    m.flags = arm64_inst.with_cond(0, cc);
    arm64_emit.inst(st, ?m);
    ret err[fail.Fail].ok{};
}

fun encode_branch(st: *isa_encode.EncodeState, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1 || mi.operands[0].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: branch target is not a block")};
    }
    val target_block: u32 = mi.operands[0].imm::u32;
    if (isa_encode.branch_falls_through(st, target_block)) { ret err[fail.Fail].ok{}; }
    val patch_pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.branch_block(st, arm64_inst.B, 0, false, 0, target_block);
    val next_ip: u32            = st.buf.bytes.len::u32;
    val pushed:  err[fail.Fail] = isa_encode.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_cbr(st: *isa_encode.EncodeState, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: conditional branch missing operands")}; }
    if (mi.operands[1].kind != lang_mir.MIR_OP_BLOCK || mi.operands[2].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch target is not a block")};
    }
    val then_block: u32  = mi.operands[1].imm::u32;
    val else_block: u32  = mi.operands[2].imm::u32;
    val use64:      bool = arm64_emit.is64(mi.width);

    val rcr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rcr.err) { ret err[fail.Fail].err{rcr.err}; }
    val cond: u32 = rcr.ok::u32;

    val invert: bool              = isa_encode.cbr_inverts(st, then_block, else_block);
    var op:     arm64_inst.MachOp = arm64_inst.CBNZ;
    var taken:  u32               = then_block;
    if (invert) {
        op    = arm64_inst.CBZ;
        taken = else_block;
    }
    val cbnz_pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.branch_block(st, op, 0, use64, cond, taken);
    val cbnz_next: u32            = st.buf.bytes.len::u32;
    val f1:        err[fail.Fail] = isa_encode.push_fixup(st, cbnz_pos, cbnz_next, taken, fn_base);
    if (sel f1.err) { ret err[fail.Fail].err{f1.err}; }

    if (invert || isa_encode.branch_falls_through(st, else_block)) { ret err[fail.Fail].ok{}; }
    val b_pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.branch_block(st, arm64_inst.B, 0, false, 0, else_block);
    val b_next: u32            = st.buf.bytes.len::u32;
    val pushed: err[fail.Fail] = isa_encode.push_fixup(st, b_pos, b_next, else_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun fused_cbr_cond(op: lang_mir.MirOpcode) res[u32, fail.Fail] {
    if (op == lang_mir.MIR_SEL_CBR_EQ)   { ret res[u32, fail.Fail].ok{arm64_emit.CC_EQ}; }
    if (op == lang_mir.MIR_SEL_CBR_NE)   { ret res[u32, fail.Fail].ok{arm64_emit.CC_NE}; }
    if (op == lang_mir.MIR_SEL_CBR_LT_S) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LT}; }
    if (op == lang_mir.MIR_SEL_CBR_LT_U) { ret res[u32, fail.Fail].ok{arm64_emit.CC_CC}; }
    if (op == lang_mir.MIR_SEL_CBR_LE_S) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LE}; }
    if (op == lang_mir.MIR_SEL_CBR_LE_U) { ret res[u32, fail.Fail].ok{arm64_emit.CC_LS}; }
    ret res[u32, fail.Fail].err{fail.message("encode: aarch64 has no fused compare-and-branch condition for this relation")};
}

fun encode_fused_cbr(st: *isa_encode.EncodeState, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch missing operands")};
    }
    if (mi.operands[2].kind != lang_mir.MIR_OP_BLOCK || mi.operands[3].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch target is not a block")};
    }
    val then_block:  u32 = mi.operands[2].imm::u32;
    val else_block:  u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.bytes.len::u32;

    val rc: err[fail.Fail] = emit_flag_cmp(st, ?mi.operands[0], ?mi.operands[1], mi.width, lang_mir.is_signed_cmp(mi.opcode));
    if (sel rc.err) { ret rc; }

    val bcc_pos: u32                 = st.buf.bytes.len::u32;
    val ccr:     res[u32, fail.Fail] = fused_cbr_cond(mi.opcode);
    if (sel ccr.err) { ret err[fail.Fail].err{ccr.err}; }
    val invert: bool = isa_encode.cbr_inverts(st, then_block, else_block);
    var cc:     u32  = ccr.ok;
    var taken:  u32  = then_block;
    # an aarch64 condition and its inverse differ in the low bit
    if (invert) {
        cc    = cc ^ 1;
        taken = else_block;
    }
    arm64_emit.branch_block(st, arm64_inst.BCOND, cc, false, 0, taken);
    val bcc_next: u32            = st.buf.bytes.len::u32;
    val f1:       err[fail.Fail] = isa_encode.push_fixup(st, bcc_pos, bcc_next, taken, fn_base);
    if (sel f1.err) { ret err[fail.Fail].err{f1.err}; }

    if (invert || isa_encode.branch_falls_through(st, else_block)) {
        isa_encode.close_cmp_varlocs(st, instr_start, st.buf.bytes.len::u32);
        ret err[fail.Fail].ok{};
    }
    val b_pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.branch_block(st, arm64_inst.B, 0, false, 0, else_block);
    val b_next: u32 = st.buf.bytes.len::u32;
    isa_encode.close_cmp_varlocs(st, instr_start, st.buf.bytes.len::u32);
    val pushed: err[fail.Fail] = isa_encode.push_fixup(st, b_pos, b_next, else_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_divide(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: divide missing operands")}; }
    val use64: bool = arm64_emit.is64(mi.width);

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = req_gpr(?mi.operands[2]);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val op:     lang_mir.MirOpcode = mi.opcode;
    val signed: bool               = op == lang_mir.MIR_SEL_DIV_S || op == lang_mir.MIR_SEL_REM_S;
    val rem:    bool               = op == lang_mir.MIR_SEL_REM_S || op == lang_mir.MIR_SEL_REM_U;

    arm64_emit.branch_pcrel(st, arm64_inst.CBNZ, 0, use64, rm, 2);
    arm64_emit.imm16_inst(st, arm64_inst.BRK, 0);

    if (signed) {
        arm64_emit.addsub_imm(st, arm64_inst.ADDS, use64, arm64_emit.ZR, rm, 1, 0);
        arm64_emit.branch_pcrel(st, arm64_inst.BCOND, arm64_emit.CC_NE, false, 0, 5);
        var hw: u32 = 1;
        if (use64) { hw = 3; }
        arm64_emit.movewide(st, arm64_inst.MOVZ, use64, arm64_emit.SCRATCH1, hw, 0x8000);
        arm64_emit.alu3(st, arm64_inst.SUBS, use64, arm64_emit.ZR, rn, arm64_emit.SCRATCH1);
        arm64_emit.branch_pcrel(st, arm64_inst.BCOND, arm64_emit.CC_NE, false, 0, 2);
        arm64_emit.imm16_inst(st, arm64_inst.BRK, 0);
    }

    var dop: arm64_inst.MachOp = arm64_inst.SDIV;
    if (!signed) { dop = arm64_inst.UDIV; }

    if (rem) {
        arm64_emit.alu3(st, dop, use64, arm64_emit.SCRATCH0, rn, rm);
        arm64_emit.madd(st, arm64_inst.MSUB, use64, rd, arm64_emit.SCRATCH0, rm, rn);
        ret err[fail.Fail].ok{};
    }
    arm64_emit.alu3(st, dop, use64, rd, rn, rm);
    ret err[fail.Fail].ok{};
}

fun emit_sp_sub(st: *isa_encode.EncodeState, subsize: u32) {
    emit_sp_move(st, arm64_inst.SUB, subsize);
}

# drops sp by a frame's subsize, touching each probe interval of it in order
# where the target probes, so a frame larger than the stack's guard faults at
# the guard instead of stepping over it. x16 counts what is left: no argument
# rides in it and the prologue has nothing live there
fun emit_frame_sub(st: *isa_encode.EncodeState, subsize: u32) {
    val step: u32 = isa_encode.STACK_PROBE_INTERVAL::u32;
    if (!st.stack_probe || subsize <= step) {
        emit_sp_sub(st, subsize);
        ret;
    }
    arm64_emit.movewide_seq(st, arm64_emit.SCRATCH0, subsize::u64, true);
    val loop_top: usize = st.buf.bytes.len;
    arm64_emit.addsub_imm(st, arm64_inst.SUB, true, arm64_emit.SP_REG, arm64_emit.SP_REG, step >> 12, 1);
    arm64_emit.ldst(st, arm64_inst.STR, false, 8, arm64_emit.ZR, arm64_emit.SP_REG, 0);
    arm64_emit.addsub_imm(st, arm64_inst.SUB, true, arm64_emit.SCRATCH0, arm64_emit.SCRATCH0, step >> 12, 1);
    arm64_emit.addsub_imm(st, arm64_inst.SUBS, true, arm64_emit.ZR, arm64_emit.SCRATCH0, step >> 12, 1);
    val back: i64 = (loop_top::i64 - st.buf.bytes.len::i64) / 4;
    arm64_emit.branch_pcrel(st, arm64_inst.BCOND, arm64_emit.CC_HI, true, 0, back::u32 & 0x7FFFF);
    arm64_emit.alu3(st, arm64_inst.SUB, true, arm64_emit.SP_REG, arm64_emit.SP_REG, arm64_emit.SCRATCH0);
}

fun emit_sp_add(st: *isa_encode.EncodeState, size: u32) {
    emit_sp_move(st, arm64_inst.ADD, size);
}

fun emit_sp_move(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, size: u32) {
    if (size <= 0xFFF) {
        arm64_emit.addsub_imm(st, op, true, arm64_emit.ZR, arm64_emit.ZR, size, 0);
        ret;
    }
    if (size <= arm64_emit.MAX_FRAME_SUB) {
        val hi: u32 = size >> 12;
        val lo: u32 = size & 0xFFF;
        arm64_emit.addsub_imm(st, op, true, arm64_emit.ZR, arm64_emit.ZR, hi, 1);
        if (lo != 0) { arm64_emit.addsub_imm(st, op, true, arm64_emit.ZR, arm64_emit.ZR, lo, 0); }
        ret;
    }
    arm64_emit.movewide_seq(st, arm64_emit.SCRATCH0, size::u64, true);
    arm64_emit.alu3(st, op, true, arm64_emit.SP_REG, arm64_emit.SP_REG, arm64_emit.SCRATCH0);
}

# a frame the stack pointer addresses: sp drops by subsize and the frame
# pointer's place is the incoming sp, since a leaf keeps no frame record
fun emit_sp_prologue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, subsize: u32, fn_base: u32) err[fail.Fail] {
    val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
    if (sel rf.err) { ret rf; }
    if (subsize > 0) {
        emit_frame_sub(st, subsize);
        val rsub: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, st.buf.bytes.len::u32 - fn_base, subsize::u64);
        if (sel rsub.err) { ret rsub; }
    }
    save_callee_gp(st, f, true);
    save_callee_fp(st, f, true);
    ret record_callee_saves(st, f, subsize, st.buf.bytes.len::u32 - fn_base);
}

fun emit_sp_epilogue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, subsize: u32) {
    save_callee_fp(st, f, false);
    save_callee_gp(st, f, false);
    if (subsize > 0) { emit_sp_add(st, subsize); }
}

fun emit_prologue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, subsize: u32, fn_base: u32) err[fail.Fail] {
    val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
    if (sel rf.err) { ret rf; }

    arm64_emit.ldstp(st, arm64_inst.STP, false, arm64_emit.FP_REG, arm64_emit.LR_REG, arm64_emit.SP_REG, (0::u32 - 2) & 0x7F, arm64_inst.FLAG_WB_PRE);
    val pair_end: u32            = st.buf.bytes.len::u32 - fn_base;
    val ra:       err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, pair_end, 16);
    if (sel ra.err) { ret ra; }
    val rfp: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, arm64_emit.FP_REG::u8, pair_end, 0);
    if (sel rfp.err) { ret rfp; }
    val rlr: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, arm64_emit.LR_REG::u8, pair_end, 8);
    if (sel rlr.err) { ret rlr; }

    arm64_emit.addsub_imm(st, arm64_inst.ADD, true, arm64_emit.FP_REG, arm64_emit.ZR, 0, 0);
    val rs: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SET_FP, arm64_emit.FP_REG::u8, st.buf.bytes.len::u32 - fn_base, 0);
    if (sel rs.err) { ret rs; }

    if (f.frame.realign != 0) {
        emit_sp_realign(st, f.frame.realign);
        val rr: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_REALIGN, 0, st.buf.bytes.len::u32 - fn_base, f.frame.realign::u64);
        if (sel rr.err) { ret rr; }
    }
    if (subsize > 0) {
        emit_frame_sub(st, subsize);
        val rsub: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, st.buf.bytes.len::u32 - fn_base, subsize::u64);
        if (sel rsub.err) { ret rsub; }
    }
    save_callee_gp(st, f, true);
    save_callee_fp(st, f, true);
    ret record_callee_saves(st, f, subsize, st.buf.bytes.len::u32 - fn_base);
}

# the callee-saved registers the prologue stored, each at its offset from the
# stack pointer the body runs with. save_callee_gp and save_callee_fp address
# them from the frame pointer's place above that stack pointer, and none is
# changed before the prologue ends, so every save holds from its end
fun record_callee_saves(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, subsize: u32, end_off: u32) err[fail.Fail] {
    val fs:       i64 = f.frame.size::i64;
    val gp_count: u32 = common.popcount32(f.callee_mask);
    val fp_count: u32 = common.popcount32(f.callee_mask_fp);
    val gp_bytes: i64 = gp_count::i64 * 8;
    var slot:     u32 = 0;
    var r:        u32 = 0;
    for (r < 31) {
        if ((f.callee_mask & (1::u32 << r)) != 0) {
            val sr: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, r::u8, end_off,
                callee_save_offset(subsize, fs + 16, slot, gp_count)::u64);
            if (sel sr.err) { ret sr; }
            slot = slot + 1;
        }
        r = r + 1;
    }
    slot = 0;
    r    = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) {
            val sr: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE_VEC, r::u8, end_off,
                callee_save_offset(subsize, fs + gp_bytes + 16, slot, fp_count)::u64);
            if (sel sr.err) { ret sr; }
            slot = slot + 1;
        }
        r = r + 1;
    }
    ret err[fail.Fail].ok{};
}

# the nth of `count` registers in a save run anchored `anchor` bytes below the
# frame pointer's place: pairs descend sixteen bytes at a time with the pair's
# first register below its second, and an odd last register takes the upper slot
fun callee_save_offset(subsize: u32, anchor: i64, n: u32, count: u32) i64 {
    val base: i64 = subsize::i64 - anchor - 16 * (n / 2)::i64;
    if ((n % 2) == 1 || n + 1 == count) { ret base + 8; }
    ret base;
}

fun emit_sp_realign(st: *isa_encode.EncodeState, realign: u32) {
    if (realign == 0) { ret; }
    val k: u32 = log2_u32(realign);
    arm64_emit.addsub_imm(st, arm64_inst.ADD, true, arm64_emit.SCRATCH0, arm64_emit.ZR, 0, 0);
    arm64_emit.bitfield(st, arm64_inst.LSR, true, arm64_emit.SCRATCH0, arm64_emit.SCRATCH0, k, 0);
    arm64_emit.bitfield(st, arm64_inst.LSL, true, arm64_emit.SCRATCH0, arm64_emit.SCRATCH0, k, 0);
    arm64_emit.addsub_imm(st, arm64_inst.ADD, true, arm64_emit.ZR, arm64_emit.SCRATCH0, 0, 0);
}

fun log2_u32(n: u32) u32 {
    var k: u32 = 0;
    var v: u32 = n;
    for (v > 1) {
        v = v >> 1;
        k = k + 1;
    }
    ret k;
}

fun emit_epilogue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, subsize: u32) {
    save_callee_fp(st, f, false);
    save_callee_gp(st, f, false);
    if (subsize > 0) {
        arm64_emit.addsub_imm(st, arm64_inst.ADD, true, arm64_emit.ZR, arm64_emit.FP_REG, 0, 0);
    }
    arm64_emit.ldstp(st, arm64_inst.LDP, false, arm64_emit.FP_REG, arm64_emit.LR_REG, arm64_emit.SP_REG, 2, arm64_inst.FLAG_WB_POST);
}

fun save_callee_gp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, store: bool) {
    var regs: [32]u32;
    var n:    u32 = 0;
    var r:    u32 = 0;
    for (r < 31) {
        if ((f.callee_mask & (1::u32 << r)) != 0) {
            regs[n] = r;
            n       = n + 1;
        }
        r = r + 1;
    }
    if (n == 0) { ret; }

    val fs:        i32 = f.frame.size::i32;
    val gp_bytes:  u32 = n * 8;
    val num_pairs: u32 = n / 2;

    var base_reg: u32 = arm64_emit.FP_REG;
    var anchor:   i32 = fs + 16;
    if (lang_mir.slots_from_sp(?f.frame)) {
        val top: i64 = f.frame.base_dist::i64 - (fs + 16)::i64;
        base_reg = arm64_emit.SP_REG;
        anchor   = (0 - top)::i32;
        if (top > arm64_emit.MAX_CALLEE_SAVE_REACH::i64) {
            emit_add_imm(st, arm64_emit.SCRATCH0, arm64_emit.ZR, top);
            base_reg = arm64_emit.SCRATCH0;
            anchor   = 0;
        }
    }
    or (f.frame.size + gp_bytes > arm64_emit.MAX_CALLEE_SAVE_REACH) {
        emit_add_imm(st, arm64_emit.SCRATCH0, arm64_emit.FP_REG, 0 - ((fs + 16)::i64));
        base_reg = arm64_emit.SCRATCH0;
        anchor   = 0;
    }

    var p: u32 = 0;
    for (p < num_pairs) {
        val base_off: i32 = 0 - (anchor + (16 * p)::i32);
        val imm7:     u32 = (base_off / 8)::u32 & 0x7F;
        if (store) { arm64_emit.ldstp(st, arm64_inst.STP, false, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        or         { arm64_emit.ldstp(st, arm64_inst.LDP, false, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        p = p + 1;
    }
    if ((n & 1) == 1) {
        val single_off: i32 = 0 - (anchor + (16 * num_pairs)::i32 - 8);
        arm64_emit.mem_access(st, regs[n - 1], base_reg, single_off::i64, 8, !store);
    }
}

fun save_callee_fp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, store: bool) {
    var regs: [32]u32;
    var n:    u32 = 0;
    var r:    u32 = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) {
            regs[n] = r;
            n       = n + 1;
        }
        r = r + 1;
    }
    if (n == 0) { ret; }

    val fs:        i32 = f.frame.size::i32;
    val gp_bytes:  u32 = common.popcount32(f.callee_mask) * 8;
    val fp_bytes:  u32 = n * 8;
    val num_pairs: u32 = n / 2;

    var base_reg: u32 = arm64_emit.FP_REG;
    var anchor:   i32 = fs + gp_bytes::i32 + 16;
    if (lang_mir.slots_from_sp(?f.frame)) {
        val top: i64 = f.frame.base_dist::i64 - (fs + gp_bytes::i32 + 16)::i64;
        base_reg = arm64_emit.SP_REG;
        anchor   = (0 - top)::i32;
        if (top > arm64_emit.MAX_CALLEE_SAVE_REACH::i64) {
            emit_add_imm(st, arm64_emit.SCRATCH0, arm64_emit.ZR, top);
            base_reg = arm64_emit.SCRATCH0;
            anchor   = 0;
        }
    }
    or (f.frame.size + gp_bytes + fp_bytes > arm64_emit.MAX_CALLEE_SAVE_REACH) {
        emit_add_imm(st, arm64_emit.SCRATCH0, arm64_emit.FP_REG, 0 - ((fs + gp_bytes::i32 + 16)::i64));
        base_reg = arm64_emit.SCRATCH0;
        anchor   = 0;
    }

    var p: u32 = 0;
    for (p < num_pairs) {
        val base_off: i32 = 0 - (anchor + (16 * p)::i32);
        val imm7:     u32 = (base_off / 8)::u32 & 0x7F;
        if (store) { arm64_emit.ldstp(st, arm64_inst.STP, true, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        or         { arm64_emit.ldstp(st, arm64_inst.LDP, true, regs[2 * p], regs[2 * p + 1], base_reg, imm7, 0); }
        p = p + 1;
    }
    if ((n & 1) == 1) {
        val single_off: i32 = 0 - (anchor + (16 * num_pairs)::i32 - 8);
        emit_fp_mem(st, regs[n - 1], base_reg, single_off::i64, 8, !store);
    }
}

fun encode_mir_instr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val op: u32 = mi.opcode;

    if (common.is_mir_compare(mi.opcode))                                                 { ret encode_compare(st, mi); }
    if (mi.opcode == lang_mir.MIR_SEL_MASK_LT_U)                                          { ret encode_compare_mask(st, mi); }
    if (mi.opcode == lang_mir.MIR_SEL_SELECT || mi.opcode == lang_mir.MIR_SEL_SELECT_CMP) { ret encode_select(st, mi); }
    if (mi.opcode == lang_mir.MIR_SEL_CBR)                                                { ret encode_cbr(st, fn_base, mi); }

    if (lang_mir.is_fused_cbr(mi.opcode)) { ret encode_fused_cbr(st, fn_base, mi); }

    if (common.is_mir_divide(mi.opcode)) { ret encode_divide(st, mi); }

    if (mi.opcode == lang_mir.MIR_MOV) { ret encode_mov(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_VEC_EXTRACT) { ret encode_vec_lane_read(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_VEC_INSERT)  { ret encode_vec_lane_write(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_ALLOCA || mi.opcode == lang_mir.MIR_GEP) { ret encode_addr(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_LOAD)                                    { ret encode_load(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_STORE)                                   { ret encode_store(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_MUL_WIDE_S || mi.opcode == lang_mir.MIR_MUL_WIDE_U)   { ret encode_neon_widen_mul(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_VEC_WIDEN_S || mi.opcode == lang_mir.MIR_VEC_WIDEN_U) { ret encode_neon_widen_half(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_VEC_RANGE)                                            { ret encode_neon_range(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_VEC_CONCAT)                                           { ret encode_neon_concat(st, f, mi); }
    if (lang_mir.vec_lane_is_convert(mi.vec_lane))                                      { ret encode_neon_convert(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_TRUNC || mi.opcode == lang_mir.MIR_SEXT ||
        mi.opcode == lang_mir.MIR_ZEXT || mi.opcode == lang_mir.MIR_BITCAST) {
        ret encode_convert(st, mi);
    }

    if (common.is_mir_float_arith(mi.opcode)) { ret encode_fp_arith(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_FNEG)       { ret encode_fp_neg(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_FCMP)       { ret encode_fp_cmp(st, f, mi); }

    if (common.is_mir_float_conv(mi.opcode)) { ret encode_fp_conv(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_CALL) {
        ret encode_call(st, mi);
    }
    if (mi.opcode == lang_mir.MIR_ASM) {
        ret arm64_grammar.encode_asm_block(st, f, fn_base, mi);
    }

    if (op >= arm64.VEC_ADD::u32 && op <= arm64.VEC_CMHS::u32)  { ret encode_neon(st, f, mi); }
    if (op >= arm64.VEC_SHL::u32 && op <= arm64.VEC_SHR_S::u32) { ret encode_neon_shift(st, f, mi); }
    if (op == arm64.ADD::u32)                                   { ret encode_addsub(st, mi, false); }
    if (op == arm64.SUB::u32)                                   { ret encode_addsub(st, mi, true); }
    if (op == arm64.MUL::u32)                                   { ret encode_alu3(st, mi, arm64_inst.MUL); }
    if (op == arm64.UMULH::u32)                                 { ret encode_mulh(st, mi, arm64_inst.UMULH); }
    if (op == arm64.SMULH::u32)                                 { ret encode_mulh(st, mi, arm64_inst.SMULH); }
    if (op == arm64.AND::u32)                                   { ret encode_alu3(st, mi, arm64_inst.AND); }
    if (op == arm64.ORR::u32)                                   { ret encode_alu3(st, mi, arm64_inst.ORR); }
    if (op == arm64.EOR::u32)                                   { ret encode_alu3(st, mi, arm64_inst.EOR); }
    if (op == arm64.LSL::u32)                                   { ret encode_shift(st, mi, arm64.LSL::u32); }
    if (op == arm64.LSR::u32)                                   { ret encode_shift(st, mi, arm64.LSR::u32); }
    if (op == arm64.ASR::u32)                                   { ret encode_shift(st, mi, arm64.ASR::u32); }
    if (op == arm64.NEG::u32)                                   { ret encode_neg_mvn(st, mi, arm64_inst.SUB); }
    if (op == arm64.MVN::u32)                                   { ret encode_neg_mvn(st, mi, arm64_inst.ORN); }
    if (op == arm64.MOV::u32)                                   { ret encode_mov(st, f, mi); }
    if (op == arm64.FMOV::u32)                                  { ret encode_fmov(st, f, mi); }
    if (op == arm64.B::u32)                                     { ret encode_branch(st, fn_base, mi); }
    if (op == arm64.RET::u32) {
        arm64_emit.return_lr(st);
        ret err[fail.Fail].ok{};
    }
    if (op == arm64.BRK::u32) {
        arm64_emit.imm16_inst(st, arm64_inst.BRK, 0);
        ret err[fail.Fail].ok{};
    }
    if (op == arm64.NOP::u32) {
        arm64_emit.nullary(st, arm64_inst.NOP);
        ret err[fail.Fail].ok{};
    }

    val failure: err[fail.Fail] = isa_encode.opcode_failure(st, f, "arm64", mi.opcode);
    if (sel failure.err) { ret err[fail.Fail].err{failure.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_function(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) err[fail.Fail] {
    val fn_base: u32 = st.buf.bytes.len::u32;
    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }

    val ms: err[fail.Fail] = isa_encode.push_symbol(st, f.name, fn_base, target_of.SYM_OBJ_FLAG_FUNCTION);
    if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }

    val naked:   bool = f.frame.omit;
    val subsize: u32  = f.frame.base_dist;

    if (isa_encode.sink_active(?st.buf)) {
        val rh: err[fail.Fail] = arm64_printer.note_function(?st.buf, st.interner, f);
        if (sel rh.err) { ret rh; }
    }

    if (f.frame.sp_frame) {
        val rpl: err[fail.Fail] = emit_sp_prologue(st, f, subsize, fn_base);
        if (sel rpl.err) { ret rpl; }
    }
    or (!naked) {
        val rpl: err[fail.Fail] = emit_prologue(st, f, subsize, fn_base);
        if (sel rpl.err) { ret rpl; }
    }
    or (!f.naked && !f.frame.opaque) {
        # a leaf without a frame keeps the frame its call left, which a record with no steps says
        val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
        if (sel rf.err) { ret rf; }
    }
    val rp: err[fail.Fail] = isa_encode.sink_check(st, HOOKS.isa, isa_encode.REGION_PROLOGUE);
    if (sel rp.err) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = ?f.blocks[bi];
        val rb:  err[fail.Fail]     = isa_encode.push_block(st, fn_base, blk.id, st.buf.bytes.len::u32);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        isa_encode.set_fallthrough(st, f, bi);

        if (isa_encode.sink_active(?st.buf)) {
            val rl: err[fail.Fail] = arm64_printer.note_block(?st.buf, blk.id);
            if (sel rl.err) { ret rl; }
        }

        var jumped: bool = false;
        var ii:     u32  = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            # the return a tail jump replaced is never reached
            if (!lang_mir.emits_instr(f, mi) || (jumped && mi.opcode == arm64.RET::u32)) {
                ii = ii + 1;
                cnt;
            }
            val rr: err[fail.Fail] = isa_encode.push_row(st, st.buf.bytes.len::u32, mi.loc);
            if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
            val rip: err[fail.Fail] = isa_encode.push_inline_pc(st, st.buf.bytes.len::u32, mi.inline_site);
            if (sel rip.err) { ret err[fail.Fail].err{rip.err}; }
            val leaves: bool = mi.opcode == arm64.RET::u32 || (mi.opcode == lang_mir.MIR_CALL && mi.tail);
            if (mi.opcode == lang_mir.MIR_CALL && mi.tail) { jumped = true; }
            if (leaves && f.frame.sp_frame) {
                emit_sp_epilogue(st, f, subsize);
            }
            or (leaves && !naked) {
                emit_epilogue(st, f, subsize);
            }
            val ei: err[fail.Fail] = isa_encode.instr_encode(st, f, fn_base, mi, ?HOOKS);
            if (sel ei.err) { ret ei; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

# the hooks the shared encode driver runs this encoder through
pub val HOOKS: isa_encode.EncodeHooks = isa_encode.EncodeHooks{
    isa:             "aarch64",
    encode_function: encode_function,
    encode_instr:    encode_mir_instr,
    patch_branch:    arm64_emit.patch_branch,
    stream:          true,
    effects:         isa_effect.Hooks{
        describe: arm64_effects.inst_effects,
        mnemonic: arm64_grammar.mnemonic,
        reg_name: arm64_printer.reg_name,
        # index 31 is the zero register in a data position and the stack pointer
        # as a base: neither carries a value
        const_regs: 1 << 31,
    },
};

#[testing]
fun tbuf_interned(st: *isa_encode.EncodeState, alloc: *A.Allocator, itn: *intern.Interner) {
    page.make(alloc);
    @itn = intern.init(alloc);
    isa_encode.state_blank(st, alloc, arm64_emit.machine());
    st.interner = itn;
}

#[testing]
fun tvec(n: i32) lang_mir.MirOperand {
    ret lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, n)));
}

test encode_shift__immediate_forms {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var ops: [3]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    ops[2] = lang_mir.op_imm(3);
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 0, 0, 0);
    mi.operand_count = 3;

    mi.width = 8;
    encode_shift(?st, ?mi, arm64.LSL::u32);
    if (isa_encode.word_read(?st.buf, 0) != 0xD37DF020) { bad = 1; }
    mi.width = 4;
    encode_shift(?st, ?mi, arm64.LSL::u32);
    if (isa_encode.word_read(?st.buf, 4) != 0x531D7020) { bad = 1; }
    mi.width = 8;
    encode_shift(?st, ?mi, arm64.LSR::u32);
    if (isa_encode.word_read(?st.buf, 8) != 0xD343FC20) { bad = 1; }
    mi.width = 4;
    encode_shift(?st, ?mi, arm64.ASR::u32);
    if (isa_encode.word_read(?st.buf, 12) != 0x13037C20) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test encode_compare__immediate_lhs_materializes {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var ops: [3]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1] = lang_mir.op_imm(48);
    ops[2] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);
    mi.opcode = lang_mir.MIR_SEL_CMP_LE_U;
    mi.width  = 1;

    val r: err[fail.Fail] = encode_compare(?st, ?mi);
    if (sel r.err)                                       { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x52800611)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x53001E31)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0x53001C30)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 12) != 0x6B10023F) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0x1A9F87E0) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

# the words encode_divide emits: the zero trap, the signed overflow trap, the
# divide, and for a remainder the multiply-subtract
#[testing]
fun t_divide(op: lang_mir.MirOpcode, width: u8, want: *u32, n: usize) bool {
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);
    fin { isa_encode.buf_dnit(?st.buf); }
    var ops: [3]lang_mir.MirOperand;
    ops[0] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 0)));
    ops[1] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 1)));
    ops[2] = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 2)));
    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ADD, ?ops[0], 3, 0, 0);
    mi.opcode = op;
    mi.width  = width;
    val r: err[fail.Fail] = encode_divide(?st, ?mi);
    if (sel r.err)                 { ret false; }
    if (st.buf.bytes.len != n * 4) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (isa_encode.word_read(?st.buf, i * 4) != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test encode_divide__trap_sequences {
    var udiv: [3]u32 = [3]u32{0xB5000042, 0xD4200000, 0x9AC20820};
    if (!t_divide(lang_mir.MIR_SEL_DIV_U, 8, ?udiv[0], 3)) { ret 1; }
    var urem: [4]u32 = [4]u32{0xB5000042, 0xD4200000, 0x9AC20830, 0x9B028600};
    if (!t_divide(lang_mir.MIR_SEL_REM_U, 8, ?urem[0], 4)) { ret 2; }
    var sdiv: [9]u32 = [9]u32{0xB5000042, 0xD4200000, 0xB100045F, 0x540000A1, 0xD2F00011, 0xEB11003F, 0x54000041,
        0xD4200000, 0x9AC20C20};
    if (!t_divide(lang_mir.MIR_SEL_DIV_S, 8, ?sdiv[0], 9)) { ret 3; }
    var srem: [10]u32 = [10]u32{0x35000042, 0xD4200000, 0x3100045F, 0x540000A1, 0x52B00011, 0x6B11003F, 0x54000041,
        0xD4200000, 0x1AC20C30, 0x1B028600};
    if (!t_divide(lang_mir.MIR_SEL_REM_S, 4, ?srem[0], 10)) { ret 4; }
    ret 0;
}

test frame__leaf_prologue_and_epilogue {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var f: lang_mir.MirFunction;
    f.callee_mask         = 0;
    f.callee_mask_fp      = 0;
    f.frame.size          = 0;
    f.frame.outgoing_size = 0;
    # the distance arm64_frame_dist records for an empty frame
    f.frame.base_dist = 0;
    val subsize: u32 = f.frame.base_dist;

    val pro: err[fail.Fail] = emit_prologue(?st, ?f, subsize, 0);
    if (sel pro.err)           { bad = 1; }
    if (st.buf.bytes.len != 8) { bad = 1; }
    or {
        if (isa_encode.word_read(?st.buf, 0) != 0xA9BF7BFD) { bad = 1; }
        if (isa_encode.word_read(?st.buf, 4) != 0x910003FD) { bad = 1; }
    }

    emit_epilogue(?st, ?f, subsize);
    if (st.buf.bytes.len != 12) { bad = 1; }
    or {
        if (isa_encode.word_read(?st.buf, 8) != 0xA8C17BFD) { bad = 1; }
    }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test frame__callee_saved_gp_prologue_and_epilogue {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    arm64_emit.tbuf(?st, ?alloc);

    var f: lang_mir.MirFunction;
    f.callee_mask         = 0;
    f.callee_mask_fp      = 0;
    f.frame.size          = 16;
    f.frame.outgoing_size = 0;
    f.frame.base_dist     = 16;
    val pro_f: err[fail.Fail] = emit_prologue(?st, ?f, 16, 0);
    if (sel pro_f.err)                                  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0xA9BF7BFD) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x910003FD) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0xD10043FF) { bad = 1; }
    emit_epilogue(?st, ?f, 16);
    if (isa_encode.word_read(?st.buf, 12) != 0x910003BF) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0xA8C17BFD) { bad = 1; }

    st.buf.bytes.len = 0;
    var g: lang_mir.MirFunction;
    g.callee_mask         = (1::u32 << 19) | (1::u32 << 20) | (1::u32 << 21);
    g.callee_mask_fp      = 0;
    g.frame.size          = 16;
    g.frame.outgoing_size = 0;
    g.frame.base_dist     = 48;
    val pro_g: err[fail.Fail] = emit_prologue(?st, ?g, 48, 0);
    if (sel pro_g.err)                                   { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0xA9BF7BFD)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x910003FD)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0xD100C3FF)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 12) != 0xA93E53B3) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0xF81D83B5) { bad = 1; }
    emit_epilogue(?st, ?g, 48);
    if (isa_encode.word_read(?st.buf, 20) != 0xA97E53B3) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 24) != 0xF85D83B5) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 28) != 0x910003BF) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 32) != 0xA8C17BFD) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

