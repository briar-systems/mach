    var f: mir.MirFunction;

    a64_asm_text(?st, ?f, ?labels, "nop");
    a64_asm_text(?st, ?f, ?labels, "ret");
    a64_asm_text(?st, ?f, ?labels, "svc 0");
    a64_asm_text(?st, ?f, ?labels, "svc 0x1");
    a64_asm_text(?st, ?f, ?labels, "brk 0");
    a64_asm_text(?st, ?f, ?labels, "mov x0, x1");
    a64_asm_text(?st, ?f, ?labels, "mov sp, x0");
    a64_asm_text(?st, ?f, ?labels, "mov x0, sp");
    a64_asm_text(?st, ?f, ?labels, "mov w0, w1");
    a64_asm_text(?st, ?f, ?labels, "mov x8, 93");
    a64_asm_text(?st, ?f, ?labels, "mov x0, 0");
    a64_asm_text(?st, ?f, ?labels, "movz x0, 0x1234");
    a64_asm_text(?st, ?f, ?labels, "movz x0, 0x1234, lsl 16");
    a64_asm_text(?st, ?f, ?labels, "movk x0, 0x5678, lsl 16");
    a64_asm_text(?st, ?f, ?labels, "add x0, x1, 5");
    a64_asm_text(?st, ?f, ?labels, "add x0, x1, x2");
    a64_asm_text(?st, ?f, ?labels, "sub x0, x1, 5");
    a64_asm_text(?st, ?f, ?labels, "sub sp, sp, 16");
    a64_asm_text(?st, ?f, ?labels, "and x0, x1, x2");
    a64_asm_text(?st, ?f, ?labels, "orr x0, x1, x2");
    a64_asm_text(?st, ?f, ?labels, "eor x0, x1, x2");
    a64_asm_text(?st, ?f, ?labels, "cmp x0, 5");
    a64_asm_text(?st, ?f, ?labels, "cmp x0, x1");
    a64_asm_text(?st, ?f, ?labels, "cmp w0, w1");
    a64_asm_text(?st, ?f, ?labels, "blr x0");
    a64_asm_text(?st, ?f, ?labels, "br x0");

    if (read_word(?st.buf, 0)   != 0xD503201F) { bad = 1; }
    if (read_word(?st.buf, 4)   != 0xD65F03C0) { bad = 1; }
    if (read_word(?st.buf, 8)   != 0xD4000001) { bad = 1; }
    if (read_word(?st.buf, 12)  != 0xD4000021) { bad = 1; }
    if (read_word(?st.buf, 16)  != 0xD4200000) { bad = 1; }
    if (read_word(?st.buf, 20)  != 0xAA0103E0) { bad = 1; }
    if (read_word(?st.buf, 24)  != 0x9100001F) { bad = 1; }
    if (read_word(?st.buf, 28)  != 0x910003E0) { bad = 1; }
    if (read_word(?st.buf, 32)  != 0x2A0103E0) { bad = 1; }
    if (read_word(?st.buf, 36)  != 0xD2800BA8) { bad = 1; }
    if (read_word(?st.buf, 40)  != 0xD2800000) { bad = 1; }
    if (read_word(?st.buf, 44)  != 0xD2824680) { bad = 1; }
    if (read_word(?st.buf, 48)  != 0xD2A24680) { bad = 1; }
    if (read_word(?st.buf, 52)  != 0xF2AACF00) { bad = 1; }
    if (read_word(?st.buf, 56)  != 0x91001420) { bad = 1; }
    if (read_word(?st.buf, 60)  != 0x8B020020) { bad = 1; }
    if (read_word(?st.buf, 64)  != 0xD1001420) { bad = 1; }
    if (read_word(?st.buf, 68)  != 0xD10043FF) { bad = 1; }
    if (read_word(?st.buf, 72)  != 0x8A020020) { bad = 1; }
    if (read_word(?st.buf, 76)  != 0xAA020020) { bad = 1; }
    if (read_word(?st.buf, 80)  != 0xCA020020) { bad = 1; }
    if (read_word(?st.buf, 84)  != 0xF100141F) { bad = 1; }
    if (read_word(?st.buf, 88)  != 0xEB01001F) { bad = 1; }
    if (read_word(?st.buf, 92)  != 0x6B01001F) { bad = 1; }
    if (read_word(?st.buf, 96)  != 0xD63F0000) { bad = 1; }
    if (read_word(?st.buf, 100) != 0xD61F0000) { bad = 1; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.arm64.encode:inline_asm_sp_refused_where_zr_only" {
    var bad: i32 = 0;
    var st: encode.EncodeState;
    var alloc: A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var f: mir.MirFunction;

    val r_5715: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "add x0, x1, x2");
    if (sel r_5715.err) { bad = 1; }
    val r_5716: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "add x0, sp, x2");
    if (!sel r_5716.err) { bad = 2; }
    val r_5717: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "add sp, x1, x2");
    if (!sel r_5717.err) { bad = 3; }

    val r_5719: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "and x0, x1, x2");
    if (sel r_5719.err) { bad = 4; }
    val r_5720: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "and x0, sp, x2");
    if (!sel r_5720.err) { bad = 5; }
    val r_5721: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "orr sp, x1, x2");
    if (!sel r_5721.err) { bad = 6; }
    val r_5722: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "eor x0, x1, sp");
    if (!sel r_5722.err) { bad = 7; }

    val r_5724: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cmp x0, x1");
    if (sel r_5724.err) { bad = 8; }
    val r_5725: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cmp sp, x1");
    if (!sel r_5725.err) { bad = 9; }
    val r_5726: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "cmp sp, 5");
    if (sel r_5726.err) { bad = 10; }

    val r_5728: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lsl x0, x1, 3");
    if (sel r_5728.err) { bad = 11; }
    val r_5729: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lsl sp, x1, 3");
    if (!sel r_5729.err) { bad = 12; }
    val r_5730: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lslv x0, x1, x2");
    if (sel r_5730.err) { bad = 13; }
    val r_5731: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "lslv x0, x1, sp");
    if (!sel r_5731.err) { bad = 14; }

    val r_5733: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1, x2]");
    if (sel r_5733.err) { bad = 15; }
    val r_5734: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "ldr x0, [sp, 16]");
    if (sel r_5734.err) { bad = 16; }
    val r_5735: err[fail.Fail] = a64_asm_text(?st, ?f, ?labels, "ldr x0, [x1, sp]");
    if (!sel r_5735.err) { bad = 17; }

    iasm.labels_dnit(?labels);
    encode.buf_dnit(?st.buf);
    ret bad;
}

