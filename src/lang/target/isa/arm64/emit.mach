    if (t_alu(arm64_inst.SUB, 4, 0, 1, 2) != 0x4B020020)  { bad = 1; }
    if (t_alu(arm64_inst.MUL, 8, 0, 1, 2) != 0x9B027C20)  { bad = 1; }
    if (t_alu(arm64_inst.MUL, 4, 0, 1, 2) != 0x1B027C20)  { bad = 1; }
    if (t_alu(arm64_inst.AND, 8, 0, 1, 2) != 0x8A020020)  { bad = 1; }
    if (t_alu(arm64_inst.AND, 4, 0, 1, 2) != 0x0A020020)  { bad = 1; }
    if (t_alu(arm64_inst.ASRV, 8, 0, 1, 2) != 0x9AC22820) { bad = 1; }
    if (t_alu(arm64_inst.ASRV, 4, 0, 1, 2) != 0x1AC22820) { bad = 1; }
    ret bad;
}

