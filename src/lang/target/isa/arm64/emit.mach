# arm64 instructions built and appended to the encode buffer, with the relocations they carry
use mach.lang.fail;
use std.allocator.page;
use io_writer: std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.intern;
use lang_mir:        mach.lang.mir;
use extension_arm64: mach.lang.target.extension.arm64;
use mach.lang.target.isa.arm64;
use arm64_inst:    mach.lang.target.isa.arm64.inst;
use arm64_printer: mach.lang.target.isa.arm64.printer;
use mach.lang.target.isa.common;
use isa_encode:   mach.lang.target.isa.encode;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;
use target_of:    mach.lang.target.of;

pub val ZR: u32 = arm64.SP::u32;

pub val SP_REG: u32 = arm64.SP::u32;

pub val SCRATCH0: u32 = arm64.IP0::u32;

pub val SCRATCH1: u32 = arm64.IP1::u32;

pub val FP_REG: u32 = arm64.FP::u32;

pub val LR_REG: u32 = arm64.LR::u32;

pub val MAX_CALLEE_SAVE_REACH: u32 = 504;

pub val MAX_FRAME_SUB: u32 = 0xFFFFF0;

pub val CC_EQ: u32 = 0;

pub val CC_NE: u32 = 1;

pub val CC_HS: u32 = 2;

pub val CC_CC: u32 = 3;

pub val CC_MI: u32 = 4;

pub val CC_PL: u32 = 5;

pub val CC_VS: u32 = 6;

pub val CC_VC: u32 = 7;

pub val CC_HI: u32 = 8;

pub val CC_LS: u32 = 9;

pub val CC_GE: u32 = 10;

pub val CC_LT: u32 = 11;

pub val CC_GT: u32 = 12;

pub val CC_LE: u32 = 13;

pub val CC_AL: u32 = 14;

pub val FP_SCRATCH0: u32 = arm64.V31::u32;

pub val FP_SCRATCH1: u32 = arm64.V30::u32;

pub val SYSREG_NAME_MAX: usize = 32;

fun name_eq(name: str, want: str) bool {
    val n: usize = str_len(name);
    if (n != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var c: u32 = name[i]::u32;
        if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
        if (c != want[i]::u32)              { ret false; }
        i = i + 1;
    }
    ret true;
}

fun sysreg_field(name: str, pos: *usize, max: u32, out: *u32) bool {
    val n:      usize = str_len(name);
    var i:      usize = @pos;
    var v:      u32   = 0;
    var digits: u32   = 0;
    for (i < n && name[i]::u32 >= '0'::u32 && name[i]::u32 <= '9'::u32) {
        v      = v * 10 + (name[i]::u32 - '0'::u32);
        digits = digits + 1;
        if (digits > 2) { ret false; }
        i = i + 1;
    }
    if (digits == 0 || v > max) { ret false; }
    @pos = i;
    @out = v;
    ret true;
}

fun sysreg_char(name: str, pos: *usize, want: char) bool {
    if (@pos >= str_len(name)) { ret false; }
    var c: u32 = name[@pos]::u32;
    if (c >= 'A'::u32 && c <= 'Z'::u32) { c = c + ('a'::u32 - 'A'::u32); }
    if (c != want::u32)                 { ret false; }
    @pos = @pos + 1;
    ret true;
}

fun sysreg_numeric(name: str, op0_out: *u32, op1_out: *u32, crn_out: *u32, crm_out: *u32, op2_out: *u32) bool {
    var i: usize = 0;
    if (!sysreg_char(name, ?i, 's'::char)) { ret false; }

    var op0: u32 = 0;
    if (!sysreg_field(name, ?i, 3, ?op0))  { ret false; }
    if (op0 < 2)                           { ret false; }
    if (!sysreg_char(name, ?i, '_'::char)) { ret false; }

    var op1: u32 = 0;
    if (!sysreg_field(name, ?i, 7, ?op1))  { ret false; }
    if (!sysreg_char(name, ?i, '_'::char)) { ret false; }

    var crn: u32 = 0;
    if (!sysreg_char(name, ?i, 'c'::char)) { ret false; }
    if (!sysreg_field(name, ?i, 15, ?crn)) { ret false; }
    if (!sysreg_char(name, ?i, '_'::char)) { ret false; }

    var crm: u32 = 0;
    if (!sysreg_char(name, ?i, 'c'::char)) { ret false; }
    if (!sysreg_field(name, ?i, 15, ?crm)) { ret false; }
    if (!sysreg_char(name, ?i, '_'::char)) { ret false; }

    var op2: u32 = 0;
    if (!sysreg_field(name, ?i, 7, ?op2)) { ret false; }
    if (i != str_len(name))               { ret false; }

    @op0_out = op0;
    @op1_out = op1;
    @crn_out = crn;
    @crm_out = crm;
    @op2_out = op2;
    ret true;
}

pub fun pstate_field(name: str, op1_out: *u32, op2_out: *u32) bool {
    var i: u32 = 0;
    for (i < arm64.PSTATE_FIELD_COUNT) {
        val row: *arm64.PstateField = ?arm64.PSTATE_FIELDS[i];
        if (name_eq(name, row.name)) {
            @op1_out = row.op1;
            @op2_out = row.op2;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

pub fun sysreg(name: str, op0_out: *u32, op1_out: *u32, crn_out: *u32, crm_out: *u32, op2_out: *u32) bool {
    var i: u32 = 0;
    for (i < arm64.SYSREG_COUNT) {
        val row: *arm64.SysReg = ?arm64.SYSREGS[i];
        if (name_eq(name, row.name)) {
            @op0_out = row.op0;
            @op1_out = row.op1;
            @crn_out = row.crn;
            @crm_out = row.crm;
            @op2_out = row.op2;
            ret true;
        }
        i = i + 1;
    }
    ret sysreg_numeric(name, op0_out, op1_out, crn_out, crm_out, op2_out);
}

# the access row of an integer or float load/store at one width: the
# member for each addressing form, the register the data travels in and the
# immediate scale, together with the `:lo12:` relocation kind. a width with no
# row is refused
pub rec Access {
    op:       arm64_inst.MachOp;
    unscaled: arm64_inst.MachOp;
    fp:       bool;
    width:    u8;
    shift:    u32;
    lo12:     target_of.RelocKind;
}

fun acc(op: arm64_inst.MachOp, unscaled: arm64_inst.MachOp, fp: bool, width: u8, shift: u32, lo12: target_of.RelocKind) res[Access, fail.Fail] {
    var a: Access;
    a.op       = op;
    a.unscaled = unscaled;
    a.fp       = fp;
    a.width    = width;
    a.shift    = shift;
    a.lo12     = lo12;
    ret res[Access, fail.Fail].ok{a};
}

pub fun int_access(w: u8, is_load: bool) res[Access, fail.Fail] {
    if (w == 1) {
        if (is_load) { ret acc(arm64_inst.LDRB, arm64_inst.LDURB, false, 4, 0, target_of.RK_LDST8_LO12); }
        ret acc(arm64_inst.STRB, arm64_inst.STURB, false, 4, 0, target_of.RK_LDST8_LO12);
    }
    if (w == 2) {
        if (is_load) { ret acc(arm64_inst.LDRH, arm64_inst.LDURH, false, 4, 1, target_of.RK_LDST16_LO12); }
        ret acc(arm64_inst.STRH, arm64_inst.STURH, false, 4, 1, target_of.RK_LDST16_LO12);
    }
    if (w == 4) {
        if (is_load) { ret acc(arm64_inst.LDR, arm64_inst.LDUR, false, 4, 2, target_of.RK_LDST32_LO12); }
        ret acc(arm64_inst.STR, arm64_inst.STUR, false, 4, 2, target_of.RK_LDST32_LO12);
    }
    if (w == 8) {
        if (is_load) { ret acc(arm64_inst.LDR, arm64_inst.LDUR, false, 8, 3, target_of.RK_LDST64_LO12); }
        ret acc(arm64_inst.STR, arm64_inst.STUR, false, 8, 3, target_of.RK_LDST64_LO12);
    }
    ret res[Access, fail.Fail].err{fail.message("internal compiler error: aarch64 has no integer memory access form for this width (expected 1, 2, 4, or 8)")};
}

pub fun fp_access(w: u8, is_load: bool) res[Access, fail.Fail] {
    var lo12:  target_of.RelocKind = target_of.RK_LDST8_LO12;
    var shift: u32                 = 0;
    if (w == 2) {
        lo12  = target_of.RK_LDST16_LO12;
        shift = 1;
    }
    or (w == 4) {
        lo12  = target_of.RK_LDST32_LO12;
        shift = 2;
    }
    or (w == 8) {
        lo12  = target_of.RK_LDST64_LO12;
        shift = 3;
    }
    or (w == 16) {
        lo12  = target_of.RK_LDST128_LO12;
        shift = 4;
    }
    or (w != 1) {
        ret res[Access, fail.Fail].err{fail.message("internal compiler error: aarch64 has no float memory access form for this width (expected 1, 2, 4, 8, or 16)")};
    }
    if (is_load) { ret acc(arm64_inst.LDR, arm64_inst.LDUR, true, w, shift, lo12); }
    ret acc(arm64_inst.STR, arm64_inst.STUR, true, w, shift, lo12);
}

fun raw_word(st: *isa_encode.EncodeState, word: u32) {
    isa_encode.emit_u32(?st.buf, word);
}

fun shaped_reg(fp: bool, n: u32, bytes: u8) isa_inst.Operand {
    if (fp) { ret arm64_inst.vec(n, bytes); }
    ret arm64_inst.gp(n, bytes);
}

pub fun width_bytes(use64: bool) u8 {
    if (use64) { ret 8; }
    ret 4;
}

fun noting(st: *isa_encode.EncodeState) bool {
    ret isa_encode.sink_active(?st.buf);
}

pub fun inst_of(op: arm64_inst.MachOp, dst: isa_inst.Operand, src1: isa_inst.Operand, src2: isa_inst.Operand) isa_inst.Inst {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = op::u16;
    mi.dst    = dst;
    mi.src1   = src1;
    mi.src2   = src2;
    ret mi;
}

fun operation_width(mi: *isa_inst.Inst) u8 {
    if (mi.dst.kind == isa_inst.OPK_REG)  { ret mi.dst.size; }
    if (mi.src1.kind == isa_inst.OPK_REG) { ret mi.src1.size; }
    if (mi.src2.kind == isa_inst.OPK_REG) { ret mi.src2.size; }
    if (mi.dst.kind == isa_inst.OPK_MEM)  { ret mi.dst.size; }
    if (mi.src1.kind == isa_inst.OPK_MEM) { ret mi.src1.size; }
    ret 0;
}

# every instruction word leaves through here: the row assembles the word
# from the instruction, the word is emitted, and the same instruction, spelled
# as an assembler reads it back, is what the stream is notified with. a member
# whose row cannot hold what it was given emits nothing and refuses the buffer
pub fun inst(st: *isa_encode.EncodeState, mi: *isa_inst.Inst) {
    val word: u32 = arm64_inst.assemble(mi);
    if (word == 0) {
        isa_encode.buf_refuse(?st.buf, "internal compiler error: an aarch64 instruction has no encoding row for its operands");
        ret;
    }
    raw_word(st, word);
    if (!noting(st)) { ret; }
    mi.size = operation_width(mi);
    arm64_inst.spell(mi);
    arm64_printer.note_inst(?st.buf, mi);
}

pub fun alu3(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, rn: u32, rm: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), arm64_inst.gp(rm, w));
    # add/sub writing index 31 writes the stack pointer, which is the
    # extended-register form; in every other position of the shifted form
    # index 31 is the zero register (neg is sub from it)
    if ((op == arm64_inst.ADD || op == arm64_inst.SUB) && rd == SP_REG) { mi.flags = arm64_inst.FLAG_SP; }
    inst(st, ?mi);
}

pub fun alu3_sh(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, rn: u32, rm: u32, sh: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), arm64_inst.gp(rm, w));
    if (sh != 0) { mi.src3 = isa_inst.make_imm(sh::i64, 1); }
    inst(st, ?mi);
}

# the scalar float forms at w bytes: 2 is half precision (FEAT_FP16), 4 single, 8 double
pub fun fp3(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, w: u8, rd: u32, rn: u32, rm: u32) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, w), arm64_inst.vec(rn, w), arm64_inst.vec(rm, w));
    inst(st, ?mi);
}

pub fun fp2(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, w: u8, rd: u32, rn: u32) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, w), arm64_inst.vec(rn, w), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun fcmp(st: *isa_encode.EncodeState, w: u8, rn: u32, rm: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.FCMP, isa_inst.make_none(), arm64_inst.vec(rn, w), arm64_inst.vec(rm, w));
    inst(st, ?mi);
}

# fcvt between any two of half, single and double; half on either side is
# the base FP conversion, not FEAT_FP16
pub fun fcvt(st: *isa_encode.EncodeState, to: u8, from: u8, rd: u32, rn: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.FCVT, arm64_inst.vec(rd, to), arm64_inst.vec(rn, from), isa_inst.make_none());
    inst(st, ?mi);
}

# a scalar float width the encoder takes: an f16 at 2 bytes beside binary32 and binary64
pub fun scalar_float_width(w: u8) bool {
    ret w == 2 || common.is_float_width(w);
}

# a conversion between the banks: the operands carry the bank and width of
# each side, the row's rule places them in the word
pub fun cvt(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, dst: isa_inst.Operand, src: isa_inst.Operand) {
    var mi: isa_inst.Inst = inst_of(op, dst, src, isa_inst.make_none());
    inst(st, ?mi);
}

pub fun addsub_imm(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, rn: u32, imm12: u32, sh: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), isa_inst.make_imm(imm12::i64, w));
    if (sh != 0) { mi.src3 = isa_inst.make_imm(12, 1); }
    mi.flags = arm64_inst.FLAG_SP;
    inst(st, ?mi);
}

pub fun addsub_imm_sym(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, rn: u32, sym: intern.StrId, mod: isa_inst.SymModifier, addend: i64) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), isa_inst.make_sym_addend(sym::u32, w, mod, addend));
    mi.flags = arm64_inst.FLAG_SP;
    inst(st, ?mi);
}

# a bitfield alias with its own immediates: a shift count for lsl/lsr/asr,
# a position and a width for the extract and insert forms, none for the
# extends (whose source is always the 32-bit register)
pub fun bitfield(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, rn: u32, a: u32, b: u32) {
    val w:      u8   = width_bytes(use64);
    var src_w:  u8   = w;
    val extend: bool = op == arm64_inst.UXTB || op == arm64_inst.UXTH || op == arm64_inst.SXTB || op == arm64_inst.SXTH || op == arm64_inst.SXTW;
    if (extend) { src_w = 4; }
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, src_w), isa_inst.make_none());
    if (!extend) {
        mi.src2 = isa_inst.make_imm(a::i64, 1);
        if (op == arm64_inst.UBFX || op == arm64_inst.UBFIZ || op == arm64_inst.SBFX || op == arm64_inst.SBFIZ) { mi.src3 = isa_inst.make_imm(b::i64, 1); }
    }
    inst(st, ?mi);
}

pub fun movewide(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, hw: u32, imm16: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), isa_inst.make_none(), isa_inst.make_imm(imm16::i64, w));
    if (hw != 0) { mi.src3 = isa_inst.make_imm((hw * 16)::i64, 1); }
    inst(st, ?mi);
}

pub fun madd(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rd: u32, rn: u32, rm: u32, ra: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), arm64_inst.gp(rm, w));
    mi.src3 = arm64_inst.gp(ra, w);
    inst(st, ?mi);
}

pub fun cset(st: *isa_encode.EncodeState, use64: bool, rd: u32, cc: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.CSET, arm64_inst.gp(rd, width_bytes(use64)), isa_inst.make_none(), isa_inst.make_none());
    mi.flags = arm64_inst.with_cond(0, cc);
    inst(st, ?mi);
}

fun access_bytes(op: arm64_inst.MachOp, width: u8) u8 {
    if (op == arm64_inst.LDRB || op == arm64_inst.STRB || op == arm64_inst.LDURB || op == arm64_inst.STURB) { ret 1; }
    if (op == arm64_inst.LDRH || op == arm64_inst.STRH || op == arm64_inst.LDURH || op == arm64_inst.STURH) { ret 2; }
    ret width;
}

fun ldst_inst(op: arm64_inst.MachOp, reg: isa_inst.Operand, mem: isa_inst.Operand) isa_inst.Inst {
    val load: bool = op == arm64_inst.LDR || op == arm64_inst.LDRB || op == arm64_inst.LDRH || op == arm64_inst.LDUR ||
        op == arm64_inst.LDURB || op == arm64_inst.LDURH || op == arm64_inst.LDAR || op == arm64_inst.LDAXR;
    if (load) { ret inst_of(op, reg, mem, isa_inst.make_none()); }
    ret inst_of(op, mem, reg, isa_inst.make_none());
}

pub fun ldst(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, fp: bool, width: u8, rt: u32, rn: u32, imm12: u32) {
    val bytes: u8               = access_bytes(op, width);
    val mem:   isa_inst.Operand = isa_inst.make_mem(arm64_inst.gp_id(rn), (imm12 * bytes::u32)::i32, isa_inst.REG_NONE, 0, bytes);
    var mi:    isa_inst.Inst    = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    inst(st, ?mi);
}

pub fun ldst_sym(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, fp: bool, width: u8, rt: u32, rn: u32, sym: intern.StrId, mod: isa_inst.SymModifier, addend: i64) {
    val bytes: u8               = access_bytes(op, width);
    var mem:   isa_inst.Operand = isa_inst.make_mem(arm64_inst.gp_id(rn), 0, isa_inst.REG_NONE, 0, bytes);
    mem.sym_id     = sym::u32;
    mem.sym_mod    = mod;
    mem.sym_addend = addend;
    var mi: isa_inst.Inst = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    inst(st, ?mi);
}

pub fun ldur(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, fp: bool, width: u8, rt: u32, rn: u32, imm9: u32) {
    val bytes: u8               = access_bytes(op, width);
    val mem:   isa_inst.Operand = isa_inst.make_mem(arm64_inst.gp_id(rn), sign_extend_field(imm9, 9)::i32, isa_inst.REG_NONE, 0, bytes);
    var mi:    isa_inst.Inst    = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    inst(st, ?mi);
}

pub fun ldst_reg(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, fp: bool, width: u8, rt: u32, rn: u32, rm: u32) {
    val bytes: u8               = access_bytes(op, width);
    val mem:   isa_inst.Operand = isa_inst.make_mem(arm64_inst.gp_id(rn), 0, arm64_inst.gp_id(rm), 1, bytes);
    var mi:    isa_inst.Inst    = ldst_inst(op, shaped_reg(fp, rt, width), mem);
    inst(st, ?mi);
}

pub fun ldord(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, use64: bool, rt: u32, rn: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = ldst_inst(op, arm64_inst.gp(rt, w), isa_inst.make_mem(arm64_inst.gp_id(rn), 0, isa_inst.REG_NONE, 0, w));
    inst(st, ?mi);
}

pub fun ldstp(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, fp: bool, rt: u32, rt2: u32, rn: u32, imm7: u32, wb: u16) {
    val mem: isa_inst.Operand = isa_inst.make_mem(arm64_inst.gp_id(rn), (sign_extend_field(imm7, 7) * 8)::i32, isa_inst.REG_NONE, 0, 8);
    val ra:  isa_inst.Operand = shaped_reg(fp, rt, 8);
    val rb:  isa_inst.Operand = shaped_reg(fp, rt2, 8);
    var mi:  isa_inst.Inst    = inst_of(op, mem, ra, rb);
    if (op == arm64_inst.LDP) { mi = inst_of(op, ra, rb, mem); }
    mi.flags = wb;
    inst(st, ?mi);
}

fun lane_flags(lane: u32) u16 {
    ret arm64_inst.with_elem_bytes(0, lang_mir.vec_lane_elem_bytes(lane));
}

pub fun neon_3same(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rd: u32, rn: u32, rm: u32, lane: u32) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), arm64_inst.vec(rm, 16));
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

pub fun neon_3diff(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rd: u32, rn: u32, rm: u32, from_bytes: u8) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), arm64_inst.vec(rm, 16));
    mi.flags = arm64_inst.with_elem_bytes(0, from_bytes);
    inst(st, ?mi);
}

pub fun neon_2misc(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rd: u32, rn: u32) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), isa_inst.make_none());
    mi.flags = arm64_inst.with_elem_bytes(0, 1);
    inst(st, ?mi);
}

# a 2misc member at the lane's arrangement
pub fun neon_2misc_lanes(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rd: u32, rn: u32, lane: u32) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), isa_inst.make_none());
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

pub fun neon_shift_imm(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rd: u32, rn: u32, sh: u32, lane: u32) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), isa_inst.make_imm(sh::i64, 1));
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

# every lane of `rd` the general register's low lane: w for lanes up to 32 bits, x for 64
pub fun neon_dup_gp(st: *isa_encode.EncodeState, rd: u32, rn: u32, lane: u32) {
    var w: u8 = 4;
    if (lang_mir.vec_lane_elem_bytes(lane) == 8) { w = 8; }
    var mi: isa_inst.Inst = inst_of(arm64_inst.DUP_GEN, arm64_inst.vec(rd, 16), arm64_inst.gp(rn, w), isa_inst.make_none());
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

pub fun neon_conv(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rd: u32, rn: u32, from_bytes: u8) {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), isa_inst.make_none());
    mi.flags = arm64_inst.with_elem_bytes(0, from_bytes);
    inst(st, ?mi);
}

pub fun neon_umov(st: *isa_encode.EncodeState, index: u32, rd: u32, rn: u32, lane: u32) {
    var dst_bytes: u8 = 4;
    if (lang_mir.vec_lane_elem_bytes(lane) == 8) { dst_bytes = 8; }
    var mi: isa_inst.Inst = inst_of(arm64_inst.UMOV, arm64_inst.gp(rd, dst_bytes), arm64_inst.vec(rn, 16), isa_inst.make_imm(index::i64, 1));
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

pub fun neon_dup_el(st: *isa_encode.EncodeState, index: u32, rd: u32, rn: u32, lane: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.DUP, arm64_inst.vec(rd, lang_mir.vec_lane_elem_bytes(lane)), arm64_inst.vec(rn, 16), isa_inst.make_imm(index::i64, 1));
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

pub fun neon_ins_gp(st: *isa_encode.EncodeState, index: u32, rd: u32, rn: u32, lane: u32, src_bytes: u8) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.INS, arm64_inst.vec(rd, 16), arm64_inst.gp(rn, src_bytes), isa_inst.make_imm(index::i64, 1));
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

pub fun neon_ins_el(st: *isa_encode.EncodeState, index: u32, src_index: u32, rd: u32, rn: u32, lane: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.INS_EL, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), isa_inst.make_imm(index::i64, 1));
    mi.src3  = isa_inst.make_imm(src_index::i64, 1);
    mi.flags = lane_flags(lane);
    inst(st, ?mi);
}

# a compare-and-branch names its register in src1; the other branches none
fun branch_inst(op: arm64_inst.MachOp, cc: u32, use64: bool, rt: u32, target: isa_inst.Operand) isa_inst.Inst {
    var reg: isa_inst.Operand = isa_inst.make_none();
    if (op == arm64_inst.CBZ || op == arm64_inst.CBNZ) { reg = arm64_inst.gp(rt, width_bytes(use64)); }
    var mi: isa_inst.Inst = inst_of(op, isa_inst.make_none(), reg, target);
    if (op == arm64_inst.BCOND) { mi.flags = arm64_inst.with_cond(0, cc); }
    ret mi;
}

pub fun branch_block(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, cc: u32, use64: bool, rt: u32, block: u32) {
    var mi: isa_inst.Inst = branch_inst(op, cc, use64, rt, isa_inst.make_block_label(block));
    mi.flags = mi.flags | arm64_inst.FLAG_TARGET_BLOCK;
    inst(st, ?mi);
}

pub fun branch_sym(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, sym: intern.StrId, addend: i64) {
    var mi: isa_inst.Inst = branch_inst(op, 0, false, 0, isa_inst.make_sym_addend(sym::u32, 0, isa_inst.SYM_MOD_NONE, addend));
    inst(st, ?mi);
}

# a pc-relative skip inside the same expansion: the target travels as a
# local label whose displacement is the bytes skipped
pub fun branch_pcrel(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, cc: u32, use64: bool, rt: u32, imm19: u32) {
    val disp:   i64              = sign_extend_field(imm19, 19) * 4;
    var target: isa_inst.Operand = isa_inst.make_local_label(disp > 0);
    target.disp = disp::i32;
    var mi: isa_inst.Inst = branch_inst(op, cc, use64, rt, target);
    mi.flags = mi.flags | arm64_inst.FLAG_LABEL_SKIP;
    inst(st, ?mi);
}

# a numbered inline-asm local: the number travels in the label's sym_id
pub fun branch_local(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, cc: u32, use64: bool, rt: u32, number: u32, fwd: bool) {
    var target: isa_inst.Operand = isa_inst.make_local_label(fwd);
    target.sym_id = number;
    var mi: isa_inst.Inst = branch_inst(op, cc, use64, rt, target);
    mi.flags = mi.flags | arm64_inst.FLAG_LABEL_LOCAL;
    if (fwd) { mi.flags = mi.flags | arm64_inst.FLAG_LABEL_FWD; }
    inst(st, ?mi);
}

pub fun branch_reg(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, rn: u32) {
    var mi: isa_inst.Inst = inst_of(op, isa_inst.make_none(), arm64_inst.gp(rn, 8), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun return_lr(st: *isa_encode.EncodeState) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.RET, isa_inst.make_none(), isa_inst.make_none(), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun adrp(st: *isa_encode.EncodeState, rd: u32, sym: intern.StrId, mod: isa_inst.SymModifier, addend: i64) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.ADRP, arm64_inst.gp(rd, 8), isa_inst.make_sym_addend(sym::u32, 0, mod, addend), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun nullary(st: *isa_encode.EncodeState, op: arm64_inst.MachOp) {
    var mi: isa_inst.Inst = inst_of(op, isa_inst.make_none(), isa_inst.make_none(), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun imm16_inst(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, imm16: u32) {
    var mi: isa_inst.Inst = inst_of(op, isa_inst.make_none(), isa_inst.make_imm(imm16::i64, 2), isa_inst.make_none());
    inst(st, ?mi);
}

#[testing]
pub fun barrier(st: *isa_encode.EncodeState, crm: u32) {
    barrier_op(st, arm64_inst.DMB, crm);
}

# dmb, dsb and isb: one word whose CRm is the barrier option
pub fun barrier_op(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, crm: u32) {
    var mi: isa_inst.Inst = inst_of(op, isa_inst.make_none(), isa_inst.make_imm(crm::i64, 1), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun msr_imm(st: *isa_encode.EncodeState, op1: u32, op2: u32, imm: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.MSR, isa_inst.make_none(),
        isa_inst.make_imm((((op1 & 0x7) << 3) | (op2 & 0x7))::i64, 1),
        isa_inst.make_imm(imm::i64, 1));
    inst(st, ?mi);
}

pub fun sysreg_pack(op0: u32, op1: u32, crn: u32, crm: u32, op2: u32) u32 {
    ret ((op0 & 0x3) << 16) | ((op1 & 0x7) << 12) | ((crn & 0xF) << 8) | ((crm & 0xF) << 4) | (op2 & 0x7);
}

pub fun mrs(st: *isa_encode.EncodeState, packed: u32, rt: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.MRS, arm64_inst.gp(rt, 8), isa_inst.make_imm(packed::i64, 4), isa_inst.make_none());
    inst(st, ?mi);
}

pub fun msr_reg(st: *isa_encode.EncodeState, packed: u32, rt: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.MSR, isa_inst.make_none(), isa_inst.make_imm(packed::i64, 4), arm64_inst.gp(rt, 8));
    inst(st, ?mi);
}

pub fun stxr(st: *isa_encode.EncodeState, use64: bool, rs: u32, rt: u32, rn: u32) {
    val w:  u8            = width_bytes(use64);
    var mi: isa_inst.Inst = inst_of(arm64_inst.STLXR, arm64_inst.gp(rs, 4), arm64_inst.gp(rt, w), isa_inst.make_mem(arm64_inst.gp_id(rn), 0, isa_inst.REG_NONE, 0, w));
    inst(st, ?mi);
}

fun sign_extend_field(v: u32, bits: u32) i64 {
    val mask: u32 = (1::u32 << bits) - 1;
    val x:    u32 = v & mask;
    if ((x & (1::u32 << (bits - 1))) != 0) { ret (x::i64) - ((mask::i64) + 1); }
    ret x::i64;
}

pub fun is64(width: u8) bool {
    if (width == 0) { ret true; }
    ret width >= 8;
}

# how a constant is materialized: from zeros (movz, then movk for every other
# nonzero chunk) or from ones (movn, then movk for every other chunk that is
# not 0xffff), whichever takes fewer words; a tie keeps movz. one plan feeds
# both the emitter and the word count, so the two cannot disagree
rec MoveWidePlan {
    value:  u64;
    chunks: u32;
    ones:   bool;
    words:  u32;
}

fun movewide_plan(value: u64, use64: bool) MoveWidePlan {
    var p: MoveWidePlan = MoveWidePlan{value: value, chunks: 2, ones: false, words: 1};
    if (use64) { p.chunks = 4; }
    or         { p.value = value & 0xFFFFFFFF; }
    var zero_chunks: u32 = 0;
    var one_chunks:  u32 = 0;
    var i:           u32 = 0;
    for (i < p.chunks) {
        val chunk: u64 = (p.value >> (16::u64 * i::u64)) & 0xFFFF;
        if (chunk == 0)      { zero_chunks = zero_chunks + 1; }
        if (chunk == 0xFFFF) { one_chunks = one_chunks + 1; }
        i = i + 1;
    }
    var from_zero: u32 = p.chunks - zero_chunks;
    var from_ones: u32 = p.chunks - one_chunks;
    if (from_zero == 0) { from_zero = 1; }
    if (from_ones == 0) { from_ones = 1; }
    p.ones  = from_ones < from_zero;
    p.words = from_zero;
    if (p.ones) { p.words = from_ones; }
    ret p;
}

# the instructions a constant takes: one orr from the zero register for a
# logical immediate the move-wide plan needs more words for, else that plan
pub fun const_words(value: u64, use64: bool) u32 {
    val words: u32 = movewide_plan(value, use64).words;
    if (words <= 1) { ret words; }
    val li: opt[u32] = arm64_inst.logical_imm(value, use64);
    if (sel li.some) { ret 1; }
    ret words;
}

# whether one instruction builds the integer: one movz or movn, or one orr of
# a logical immediate, the rule the middle end hoists a loop's constants by
#. a value narrower than 64 bits is built at 32
pub fun int_imm_fits(value: u64, bits: u32) bool {
    ret const_words(value, bits > 32) <= 1;
}

pub fun movewide_seq(st: *isa_encode.EncodeState, rd: u32, value: u64, use64: bool) {
    val p: MoveWidePlan = movewide_plan(value, use64);
    if (p.words > 1) {
        val li: opt[u32] = arm64_inst.logical_imm(value, use64);
        if (sel li.some) {
            val w:  u8            = width_bytes(use64);
            var mi: isa_inst.Inst = inst_of(arm64_inst.ORR, arm64_inst.gp(rd, w), arm64_inst.gp(ZR, w), isa_inst.make_imm(p.value:~i64, w));
            inst(st, ?mi);
            ret;
        }
    }
    var fill: u64 = 0;
    if (p.ones) { fill = 0xFFFF; }
    var first: bool = true;
    var i:     u32  = 0;
    for (i < p.chunks) {
        val chunk: u64 = (p.value >> (16::u64 * i::u64)) & 0xFFFF;
        if (chunk != fill) {
            if (first && p.ones) { movewide(st, arm64_inst.MOVN, use64, rd, i, (~chunk & 0xFFFF)::u32); }
            or (first)           { movewide(st, arm64_inst.MOVZ, use64, rd, i, chunk::u32); }
            or                   { movewide(st, arm64_inst.MOVK, use64, rd, i, chunk::u32); }
            first = false;
        }
        i = i + 1;
    }
    if (first && p.ones) { movewide(st, arm64_inst.MOVN, use64, rd, 0, 0); }
    or (first)           { movewide(st, arm64_inst.MOVZ, use64, rd, 0, 0); }
}

pub fun mem_access_needs_no_scratch(off: i64, width: u8) res[bool, fail.Fail] {
    val ar: res[Access, fail.Fail] = int_access(width, true);
    if (sel ar.err) { ret res[bool, fail.Fail].err{ar.err}; }
    val sh: u32 = ar.ok.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) { ret res[bool, fail.Fail].ok{true}; }
    }
    ret res[bool, fail.Fail].ok{off >= -256 && off <= 255};
}

pub fun mem_access(st: *isa_encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) err[fail.Fail] {
    val ar: res[Access, fail.Fail] = int_access(width, is_load);
    if (sel ar.err) { ret err[fail.Fail].err{ar.err}; }
    val a:  Access = ar.ok;
    val sh: u32    = a.shift;
    if (off >= 0) {
        val mask: i64 = (1::i64 << sh::i64) - 1;
        if ((off & mask) == 0 && (off >> sh::i64) <= 4095) {
            ldst(st, a.op, a.fp, a.width, rt, base, (off >> sh::i64)::u32);
            ret err[fail.Fail].ok{};
        }
    }
    if (off >= -256 && off <= 255) {
        ldur(st, a.unscaled, a.fp, a.width, rt, base, off::u32 & 0x1FF);
        ret err[fail.Fail].ok{};
    }
    movewide_seq(st, SCRATCH0, off::u64, true);
    ldst_reg(st, a.op, a.fp, a.width, rt, base, SCRATCH0);
    ret err[fail.Fail].ok{};
}

pub fun adrp_reloc(st: *isa_encode.EncodeState, rd: u32, sym: intern.StrId, addend: i64) err[fail.Fail] {
    val pos: u32 = st.buf.bytes.len::u32;
    adrp(st, rd, sym, isa_inst.SYM_MOD_PCREL_HI, addend);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, reloc_offset(pos), target_of.RK_PAGE21, sym, addend);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

pub fun adrp_got_reloc(st: *isa_encode.EncodeState, rd: u32, sym: intern.StrId) err[fail.Fail] {
    val pos: u32 = st.buf.bytes.len::u32;
    adrp(st, rd, sym, isa_inst.SYM_MOD_GOT_HI, 0);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, reloc_offset(pos), target_of.RK_GOT_PAGE21, sym, 0);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

pub fun neon_ext(st: *isa_encode.EncodeState, rd: u32, rn: u32, rm: u32, first: u32) {
    var mi: isa_inst.Inst = inst_of(arm64_inst.V_EXT, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), arm64_inst.vec(rm, 16));
    mi.src3  = isa_inst.make_imm(first::i64, 1);
    mi.flags = arm64_inst.with_elem_bytes(0, 1);
    inst(st, ?mi);
}

pub fun patch_branch(st: *isa_encode.EncodeState, fx: *isa_encode.BranchFixup, target_off: u32) err[fail.Fail] {
    val pos: usize = fx.patch_pos::usize;
    if (pos + 4 > st.buf.bytes.len) {
        ret err[fail.Fail].err{fail.message("encode: branch fixup site is outside the text buffer")};
    }
    val word:  u32 = isa_encode.word_read(?st.buf, pos);
    val sdisp: i64 = (target_off::i64) - (fx.patch_pos::i64);
    if ((sdisp & 3) != 0) {
        ret err[fail.Fail].err{fail.message("encode: aarch64 branch displacement is not 4-byte aligned")};
    }
    val disp: u32 = target_off - fx.patch_pos;

    var patched: u32 = 0;
    if ((word & 0xFC000000) == arm64_inst.form(arm64_inst.B).base) {
        if (sdisp < -134217728 || sdisp >= 134217728) {
            ret err[fail.Fail].err{fail.message("encode: aarch64 B displacement exceeds the +-128MB branch range")};
        }
        patched = (word & 0xFC000000) | ((disp & 0x0FFFFFFC) >> 2);
    }
    or {
        if (sdisp < -1048576 || sdisp >= 1048576) {
            ret err[fail.Fail].err{fail.message("encode: aarch64 conditional-branch displacement exceeds the +-1MB range")};
        }
        patched = (word & 0xFF00001F) | (((disp >> 2) & 0x7FFFF) << 5);
    }
    isa_encode.word_write(?st.buf, pos, patched);
    ret err[fail.Fail].ok{};
}

pub fun reloc_offset(inst_start: u32) u32 {
    ret inst_start;
}

# ld1/st1 of one eb-laned register at [rn]; a post-index advances rn by 16, or by
# register id `rm` when it names one
pub fun neon_elem(st: *isa_encode.EncodeState, op: arm64_inst.MachOp, eb: u8, rt: u32, rn: u32, post: bool, rm: i32) {
    var index: i32 = isa_inst.REG_NONE;
    var disp:  i32 = 0;
    if (post && rm != isa_inst.REG_NONE) { index = rm; }
    or (post)                            { disp = 16; }
    val mem: isa_inst.Operand = isa_inst.make_mem(arm64_inst.gp_id(rn), disp, index, 1, 16);
    var mi:  isa_inst.Inst    = inst_of(op, arm64_inst.vec(rt, 16), mem, isa_inst.make_none());
    if (op == arm64_inst.ST1) { mi = inst_of(op, mem, arm64_inst.vec(rt, 16), isa_inst.make_none()); }
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    if (post) { mi.flags = mi.flags | arm64_inst.FLAG_WB_POST; }
    inst(st, ?mi);
}

#[testing]
pub var t_model: target_model.Machine;

#[testing]
pub fun machine() *target_model.Machine {
    t_model.extension_table = ?extension_arm64.NAMES[0];
    t_model.extension_count = extension_arm64.NAME_COUNT;
    t_model.pointer_width   = 8;
    t_model.gpr_width       = 8;
    target_model.declare_alu_widths(?t_model, target_model.ALU_WIDTHS_4_8);
    t_model.spill_width = 8;
    t_model.flen_bits   = 64;
    ret ?t_model;
}

#[testing]
pub fun tbuf(st: *isa_encode.EncodeState, alloc: *A.Allocator) {
    page.make(alloc);
    isa_encode.state_blank(st, alloc, machine());
}

# the words the assembler produces for a spelled instruction: the packer
# tests state each expectation against `llvm-mc` output through these
#[testing]
fun t_asm(op: arm64_inst.MachOp, dst: isa_inst.Operand, src1: isa_inst.Operand, src2: isa_inst.Operand) u32 {
    var mi: isa_inst.Inst = inst_of(op, dst, src1, src2);
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_alu(op: arm64_inst.MachOp, w: u8, rd: u32, rn: u32, rm: u32) u32 {
    ret t_asm(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), arm64_inst.gp(rm, w));
}

#[testing]
fun t_imm(op: arm64_inst.MachOp, w: u8, rd: u32, rn: u32, imm12: u32, sh: u32) u32 {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), arm64_inst.gp(rn, w), isa_inst.make_imm(imm12::i64, w));
    if (sh != 0) { mi.src3 = isa_inst.make_imm(12, 1); }
    mi.flags = arm64_inst.FLAG_SP;
    ret arm64_inst.assemble(?mi);
}

#[testing]
pub fun t_mw(op: arm64_inst.MachOp, w: u8, rd: u32, hw: u32, imm16: u32) u32 {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.gp(rd, w), isa_inst.make_none(), isa_inst.make_imm(imm16::i64, w));
    if (hw != 0) { mi.src3 = isa_inst.make_imm((hw * 16)::i64, 1); }
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_cset(w: u8, rd: u32, cc: u32) u32 {
    var mi: isa_inst.Inst = inst_of(arm64_inst.CSET, arm64_inst.gp(rd, w), isa_inst.make_none(), isa_inst.make_none());
    mi.flags = arm64_inst.with_cond(0, cc);
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_ldst(op: arm64_inst.MachOp, fp: bool, w: u8, rt: u32, rn: u32, imm12: u32) u32 {
    val bytes: u8            = access_bytes(op, w);
    var mi:    isa_inst.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa_inst.make_mem(arm64_inst.gp_id(rn), (imm12 * bytes::u32)::i32, isa_inst.REG_NONE, 0, bytes));
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_ldur(op: arm64_inst.MachOp, fp: bool, w: u8, rt: u32, rn: u32, imm9: u32) u32 {
    val bytes: u8            = access_bytes(op, w);
    var mi:    isa_inst.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa_inst.make_mem(arm64_inst.gp_id(rn), sign_extend_field(imm9, 9)::i32, isa_inst.REG_NONE, 0, bytes));
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_ldst_reg(op: arm64_inst.MachOp, fp: bool, w: u8, rt: u32, rn: u32, rm: u32) u32 {
    val bytes: u8            = access_bytes(op, w);
    var mi:    isa_inst.Inst = ldst_inst(op, shaped_reg(fp, rt, w), isa_inst.make_mem(arm64_inst.gp_id(rn), 0, arm64_inst.gp_id(rm), 1, bytes));
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_neon3(op: arm64_inst.MachOp, eb: u8, rd: u32, rn: u32, rm: u32) u32 {
    var mi: isa_inst.Inst = inst_of(op, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), arm64_inst.vec(rm, 16));
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_lane_rd(op: arm64_inst.MachOp, dst: isa_inst.Operand, eb: u8, index: u32, rn: u32) u32 {
    var mi: isa_inst.Inst = inst_of(op, dst, arm64_inst.vec(rn, 16), isa_inst.make_imm(index::i64, 1));
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_ins_gp(eb: u8, index: u32, rd: u32, rn: u32) u32 {
    var src_w: u8 = 4;
    if (eb == 8) { src_w = 8; }
    var mi: isa_inst.Inst = inst_of(arm64_inst.INS, arm64_inst.vec(rd, 16), arm64_inst.gp(rn, src_w), isa_inst.make_imm(index::i64, 1));
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    ret arm64_inst.assemble(?mi);
}

#[testing]
fun t_ins_el(eb: u8, index: u32, src_index: u32, rd: u32, rn: u32) u32 {
    var mi: isa_inst.Inst = inst_of(arm64_inst.INS_EL, arm64_inst.vec(rd, 16), arm64_inst.vec(rn, 16), isa_inst.make_imm(index::i64, 1));
    mi.src3  = isa_inst.make_imm(src_index::i64, 1);
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    ret arm64_inst.assemble(?mi);
}

test assemble__register_forms {
    var bad: i32 = 0;
