test assemble__movewide_forms {
    var bad: i32 = 0;
    if (t_mw(arm64_inst.MOVZ, 8, 0, 0, 0x1234) != 0xD2824680) { bad = 1; }
    if (t_mw(arm64_inst.MOVZ, 8, 0, 3, 0x1234) != 0xD2E24680) { bad = 1; }
    if (t_mw(arm64_inst.MOVK, 8, 0, 1, 0x5678) != 0xF2AACF00) { bad = 1; }
    if (t_mw(arm64_inst.MOVZ, 4, 0, 0, 0x1234) != 0x52824680) { bad = 1; }
    if (t_mw(arm64_inst.MOVK, 4, 0, 1, 0x5678) != 0x72AACF00) { bad = 1; }
    ret bad;
}

# one movz, one movn or one orr of a logical immediate builds the value;
# anything the move-wide plan needs two words for and no element spells is
# hoisted
test int_imm_fits__one_move_wide_or_one_logical_immediate {
    if (!int_imm_fits(0xABCD0000, 64) || !int_imm_fits(0xFFFFFFFFFFFF1234, 64))         { ret 1; }
    if (!int_imm_fits(0x0000FFFFFFFF0000, 64) || !int_imm_fits(0x5555555555555555, 64)) { ret 2; }
    if (int_imm_fits(0x12345, 64) || int_imm_fits(0x123456789ABCDEF0, 64))              { ret 3; }
    if (!int_imm_fits(0x00FF00FF, 32) || int_imm_fits(0x00012345, 32))                  { ret 4; }
    ret 0;
}

#[testing]
fun t_seq(value: u64, use64: bool, words: *u32, count: u32) bool {
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    fin { isa_encode.buf_dnit(?st.buf); }
    movewide_seq(?st, 16, value, use64);
    if (st.buf.bytes.len != (count * 4)::usize || const_words(value, use64) != count) { ret false; }
    var i: u32 = 0;
    for (i < count) {
        if (isa_encode.word_read(?st.buf, (i * 4)::usize) != words[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a constant is built from ones when that takes fewer words, and the word
# count the size estimate reads matches what is emitted; a run of
# ones is one orr
test emit_movewide_seq__fewest_words {
    if (t_mw(arm64_inst.MOVN, 8, 16, 0, 0x1A7) != 0x928034F0) { ret 1; }
    if (t_mw(arm64_inst.MOVN, 4, 16, 0, 0x1A7) != 0x128034F0) { ret 2; }
    if (t_mw(arm64_inst.MOVN, 8, 16, 1, 0x1) != 0x92A00030)   { ret 3; }
    var w: [4]u32;
    # x29 - 0x1a8, a far frame slot: one movn
    w[0] = t_mw(arm64_inst.MOVN, 8, 16, 0, 0x1A7);
    if (!t_seq(0xFFFFFFFFFFFFFE58, true, ?w[0], 1)) { ret 4; }
    # all ones, at both widths
    w[0] = t_mw(arm64_inst.MOVN, 8, 16, 0, 0);
    if (!t_seq(0xFFFFFFFFFFFFFFFF, true, ?w[0], 1)) { ret 5; }
    w[0] = t_mw(arm64_inst.MOVN, 4, 16, 0, 0);
    if (!t_seq(0xFFFFFFFF, false, ?w[0], 1)) { ret 6; }
    # a 32-bit negative constant
    w[0] = t_mw(arm64_inst.MOVN, 4, 16, 0, 0x7);
    if (!t_seq(0xFFFFFFF8, false, ?w[0], 1)) { ret 7; }
    # mixed: two chunks differ from ones, so movn and one movk
    w[0] = t_mw(arm64_inst.MOVN, 8, 16, 0, 0xEDCB);
    w[1] = t_mw(arm64_inst.MOVK, 8, 16, 2, 0x1234);
    if (!t_seq(0xFFFF1234FFFF1234, true, ?w[0], 2)) { ret 8; }
    # ones only in a middle chunk: movn at the first chunk that is not ones
    w[0] = t_mw(arm64_inst.MOVN, 8, 16, 1, 0x0FFF);
    if (!t_seq(0xFFFFFFFFF000FFFF, true, ?w[0], 1)) { ret 9; }
    # a run of ones two words would build is one orr of a logical immediate
    w[0] = 0xB2707FF0;
    if (!t_seq(0x0000FFFFFFFF0000, true, ?w[0], 1)) { ret 10; }
    # zero and positive values are unchanged
    w[0] = t_mw(arm64_inst.MOVZ, 8, 16, 0, 0);
    if (!t_seq(0, true, ?w[0], 1)) { ret 11; }
    w[0] = t_mw(arm64_inst.MOVZ, 4, 16, 0, 0x5678);
    w[1] = t_mw(arm64_inst.MOVK, 4, 16, 1, 0x1234);
    if (!t_seq(0x12345678, false, ?w[0], 2)) { ret 12; }
    # a 64-bit value with no zero and no ones chunk takes four words from zero
    w[0] = t_mw(arm64_inst.MOVZ, 8, 16, 0, 0xDEF0);
    w[1] = t_mw(arm64_inst.MOVK, 8, 16, 1, 0x9ABC);
    w[2] = t_mw(arm64_inst.MOVK, 8, 16, 2, 0x5678);
    w[3] = t_mw(arm64_inst.MOVK, 8, 16, 3, 0x1234);
    if (!t_seq(0x123456789ABCDEF0, true, ?w[0], 4)) { ret 13; }
    # the upper half is ignored at 32 bits
    w[0] = t_mw(arm64_inst.MOVN, 4, 16, 0, 0);
    if (!t_seq(0x12345678FFFFFFFF, false, ?w[0], 1)) { ret 14; }
    ret 0;
}

test assemble__add_sub_immediate {
    var bad: i32 = 0;
    if (t_imm(arm64_inst.ADD, 8, 0, 1, 5, 0) != 0x91001420)    { bad = 1; }
    if (t_imm(arm64_inst.SUB, 8, 0, 1, 5, 0) != 0xD1001420)    { bad = 1; }
    if (t_imm(arm64_inst.ADD, 4, 0, 1, 5, 0) != 0x11001420)    { bad = 1; }
    if (t_imm(arm64_inst.ADD, 8, 0, 1, 5, 1) != 0x91401420)    { bad = 1; }
    if (t_imm(arm64_inst.ADD, 8, ZR, ZR, 16, 0) != 0x910043FF) { bad = 1; }
    if (t_imm(arm64_inst.ADD, 8, 29, ZR, 0, 0) != 0x910003FD)  { bad = 1; }
    ret bad;
}

test assemble__cmp_and_cset {
    var bad: i32 = 0;
    if (t_alu(arm64_inst.SUBS, 8, ZR, 0, 1) != 0xEB01001F)    { bad = 1; }
    if (t_imm(arm64_inst.SUBS, 4, ZR, 0, 5, 0) != 0x7100141F) { bad = 1; }
    if (t_cset(4, 0, CC_EQ) != 0x1A9F17E0)                    { bad = 1; }
    if (t_cset(4, 0, CC_LT) != 0x1A9FA7E0)                    { bad = 1; }
    if (t_cset(4, 0, CC_LS) != 0x1A9F87E0)                    { bad = 1; }
    if (t_cset(8, 0, CC_EQ) != 0x9A9F17E0)                    { bad = 1; }
    ret bad;
}

# goldens from llvm-mc (aarch64), which spells the lengthen as its sshll and ushll alias
test emit_neon_conv__lengthens_either_half {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);
    neon_conv(?st, arm64_inst.V_SXTL, 0, 1, 2);
    neon_conv(?st, arm64_inst.V_SXTL2, 0, 1, 2);
    neon_conv(?st, arm64_inst.V_UXTL2, 2, 3, 4);
    neon_conv(?st, arm64_inst.V_UXTL2, 4, 5, 1);
    if (st.buf.bytes.len != 16) { bad = 1; }
    or {
        if (isa_encode.word_read(?st.buf, 0) != 0x0F10A420)  { bad = 2; }
        if (isa_encode.word_read(?st.buf, 4) != 0x4F10A420)  { bad = 3; }
        if (isa_encode.word_read(?st.buf, 8) != 0x6F20A462)  { bad = 4; }
        if (isa_encode.word_read(?st.buf, 12) != 0x6F08A4A4) { bad = 5; }
    }
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test emit_mem_access__legalization {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    mem_access(?st, 0, 1, 8, 8, true);
    if (isa_encode.word_read(?st.buf, 0) != 0xF9400420) { bad = 1; }
    mem_access(?st, 0, 1, 8, 8, false);
    if (isa_encode.word_read(?st.buf, 4) != 0xF9000420) { bad = 1; }
    mem_access(?st, 0, 1, 32760, 8, true);
    if (isa_encode.word_read(?st.buf, 8) != 0xF97FFC20) { bad = 1; }
    mem_access(?st, 0, 1, -8, 8, true);
    if (isa_encode.word_read(?st.buf, 12) != 0xF85F8020) { bad = 1; }
    mem_access(?st, 0, 1, -8, 8, false);
    if (isa_encode.word_read(?st.buf, 16) != 0xF81F8020) { bad = 1; }
    mem_access(?st, 0, 1, 32768, 8, true);
    if (isa_encode.word_read(?st.buf, 20) != 0xD2900010) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 24) != 0xF8706820) { bad = 1; }
    mem_access(?st, 0, 1, 1, 1, true);
    if (isa_encode.word_read(?st.buf, 28) != 0x39400420) { bad = 1; }
    mem_access(?st, 0, 1, 2, 2, true);
    if (isa_encode.word_read(?st.buf, 32) != 0x79400420) { bad = 1; }
    mem_access(?st, 0, 1, 4, 4, true);
    if (isa_encode.word_read(?st.buf, 36) != 0xB9400420) { bad = 1; }
    mem_access(?st, 0, 1, 1, 1, false);
    if (isa_encode.word_read(?st.buf, 40) != 0x39000420) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test patch_branch__imm26_and_imm19 {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    raw_word(?st, arm64_inst.form(arm64_inst.B).base);
    raw_word(?st, arm64_inst.form(arm64_inst.BCOND).base | CC_EQ);
    raw_word(?st, 0xB4000000);
    raw_word(?st, 0xB5000001);

    var fx: isa_encode.BranchFixup;
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    patch_branch(?st, ?fx, 8);
    if (isa_encode.word_read(?st.buf, 0) != 0x14000002) { bad = 1; }
    fx.patch_pos = 4;
    fx.next_ip   = 8;
    patch_branch(?st, ?fx, 12);
    if (isa_encode.word_read(?st.buf, 4) != 0x54000040) { bad = 1; }
    fx.patch_pos = 8;
    fx.next_ip   = 12;
    patch_branch(?st, ?fx, 16);
    if (isa_encode.word_read(?st.buf, 8) != 0xB4000040) { bad = 1; }
    fx.patch_pos = 12;
    fx.next_ip   = 16;
    patch_branch(?st, ?fx, 12);
    if (isa_encode.word_read(?st.buf, 12) != 0xB5000001) { bad = 1; }

    st.buf.bytes.len = 0;
    var k: u32 = 0;
    for (k < 8) {
        raw_word(?st, arm64_inst.form(arm64_inst.B).base);
        k = k + 1;
    }
    fx.patch_pos = 28;
    fx.next_ip   = 32;
    patch_branch(?st, ?fx, 0);
    if (isa_encode.word_read(?st.buf, 28) != 0x17FFFFF9) { bad = 1; }
    raw_word(?st, arm64_inst.form(arm64_inst.BCOND).base | CC_EQ);
    fx.patch_pos = 32;
    fx.next_ip   = 36;
    patch_branch(?st, ?fx, 0);
    if (isa_encode.word_read(?st.buf, 32) != 0x54FFFF00) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test patch_branch__out_of_range_refused {
    var bad:   i32 = 0;
    var st:    isa_encode.EncodeState;
    var alloc: A.Allocator;
    tbuf(?st, ?alloc);

    raw_word(?st, arm64_inst.form(arm64_inst.BCOND).base | CC_EQ);
    var fx: isa_encode.BranchFixup;
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    val r1: err[fail.Fail] = patch_branch(?st, ?fx, 2000000);
    if (!sel r1.err) { bad = 1; }

    st.buf.bytes.len = 0;
    raw_word(?st, arm64_inst.form(arm64_inst.B).base);
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    val r2: err[fail.Fail] = patch_branch(?st, ?fx, 200000000);
    if (!sel r2.err) { bad = 1; }

    st.buf.bytes.len = 0;
    raw_word(?st, arm64_inst.form(arm64_inst.BCOND).base | CC_EQ);
    fx.patch_pos = 0;
    fx.next_ip   = 4;
    val r3: err[fail.Fail] = patch_branch(?st, ?fx, 1048572);
    if (sel r3.err) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test int_access__rows_and_lo12_kinds {
    var bad: i32 = 0;
    if (t_int_row(1, 0x39400200, 0x39000200, target_of.RK_LDST8_LO12) != 0)  { bad = 1; }
    if (t_int_row(2, 0x79400200, 0x79000200, target_of.RK_LDST16_LO12) != 0) { bad = 1; }
    if (t_int_row(4, 0xB9400200, 0xB9000200, target_of.RK_LDST32_LO12) != 0) { bad = 1; }
    if (t_int_row(8, 0xF9400200, 0xF9000200, target_of.RK_LDST64_LO12) != 0) { bad = 1; }
    ret bad;
}

#[testing]
fun t_int_row(w: u8, ldw: u32, stw: u32, kind: target_of.RelocKind) i32 {
    val lr: res[Access, fail.Fail] = int_access(w, true);
    val sr: res[Access, fail.Fail] = int_access(w, false);
    if (sel lr.err) { ret 1; }
    if (sel sr.err) { ret 1; }
    val l: Access = lr.ok;
    val s: Access = sr.ok;
    if (t_ldst(l.op, l.fp, l.width, 0, 16, 0) != ldw) { ret 1; }
    if (t_ldst(s.op, s.fp, s.width, 0, 16, 0) != stw) { ret 1; }
    if (l.lo12 != kind || s.lo12 != kind)             { ret 1; }
    ret 0;
}

#[testing]
pub fun tasm(st: *isa_encode.EncodeState, alloc: *A.Allocator, interner: *intern.Interner) {
    page.make(alloc);
    st.model       = machine();
    @interner      = intern.init(alloc);
    st.alloc       = alloc;
    st.buf         = isa_encode.buf_init(alloc);
    st.interner    = interner;
    st.syms        = nil;
    st.sym_count   = 0;
    st.sym_cap     = 0;
    st.relocs      = nil;
    st.reloc_count = 0;
    st.reloc_cap   = 0;
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;
    st.blocks      = nil;
    st.block_count = 0;
    st.block_cap   = 0;
}

# the f16 lane forms the packed rows emit: the .8h arithmetic and
# comparisons under FEAT_FP16, and fcvtl and fcvtn between four half and four
# single lanes in the base FP beside their single-double forms. goldens from
# llvm-mc 22 (aarch64, +fullfp16)
test half_lanes__byte_exact {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    tasm(?st, ?alloc, ?interner);
    fin { isa_encode.buf_dnit(?st.buf); }
    val h8: u32 = lang_mir.vec_lane_make(lang_mir.VEC_LANE_FLOAT, 2, 8);
    neon_3same(?st, arm64_inst.V_FADD, 1, 2, 3, h8);
    neon_3same(?st, arm64_inst.V_FSUB, 1, 2, 3, h8);
    neon_3same(?st, arm64_inst.V_FMUL, 1, 2, 3, h8);
    neon_3same(?st, arm64_inst.V_FDIV, 1, 2, 3, h8);
    neon_3same(?st, arm64_inst.V_FCMEQ, 1, 2, 3, h8);
    neon_3same(?st, arm64_inst.V_FCMGT, 1, 2, 3, h8);
    neon_3same(?st, arm64_inst.V_FCMGE, 1, 2, 3, h8);
    neon_conv(?st, arm64_inst.V_FCVTL, 1, 2, 2);
    neon_conv(?st, arm64_inst.V_FCVTN, 1, 2, 4);
    neon_conv(?st, arm64_inst.V_FCVTL, 1, 2, 4);
    neon_conv(?st, arm64_inst.V_FCVTN, 1, 2, 8);
    val want: [11]u32 = [11]u32{
        0x4E431441, 0x4EC31441, 0x6E431C41, 0x6E433C41,
        0x4E432441, 0x6EC32441, 0x6E432441,
        0x0E217841, 0x0E216841, 0x0E617841, 0x0E616841
    };
    if (st.buf.bytes.len != 11 * 4) { ret 1; }
    var i: u32 = 0;
    for (i < 11) {
        if (isa_encode.word_read(?st.buf, (i * 4)::usize) != want[i]) { ret 2 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

test assemble__neon_forms {
    var bad: i32 = 0;

    if (t_neon3(arm64_inst.V_FADD, 8, 0, 0, 1) != 0x4E61D400) { bad = 1; }
    if (t_neon3(arm64_inst.V_FMUL, 4, 0, 0, 1) != 0x6E21DC00) { bad = 1; }

    if (t_neon3(arm64_inst.V_ADD, 2, 0, 0, 1) != 0x4E618400) { bad = 1; }
    if (t_neon3(arm64_inst.V_ADD, 8, 0, 0, 1) != 0x4EE18400) { bad = 1; }
    if (t_neon3(arm64_inst.V_SUB, 1, 0, 0, 1) != 0x6E218400) { bad = 1; }

    if (t_neon3(arm64_inst.V_ORR, 1, 0, 1, 1) != 0x4EA11C20) { bad = 1; }

    if (t_neon3(arm64_inst.V_CMGE, 1, 0, 0, 1) != 0x4E213C00)  { bad = 1; }
    if (t_neon3(arm64_inst.V_FCMGE, 4, 0, 0, 1) != 0x6E21E400) { bad = 1; }

    if (t_lane_rd(arm64_inst.UMOV, arm64_inst.gp(0, 4), 1, 0, 1) != 0x0E013C20) { bad = 1; }
    if (t_lane_rd(arm64_inst.UMOV, arm64_inst.gp(0, 4), 2, 3, 1) != 0x0E0E3C20) { bad = 1; }
    if (t_lane_rd(arm64_inst.UMOV, arm64_inst.gp(0, 4), 4, 2, 1) != 0x0E143C20) { bad = 1; }
    if (t_lane_rd(arm64_inst.UMOV, arm64_inst.gp(0, 8), 8, 1, 1) != 0x4E183C20) { bad = 1; }
    if (t_ins_gp(1, 0, 0, 1) != 0x4E011C20)                                     { bad = 1; }
    if (t_ins_gp(4, 2, 0, 1) != 0x4E141C20)                                     { bad = 1; }
    if (t_ins_gp(8, 1, 0, 1) != 0x4E181C20)                                     { bad = 1; }

    if (t_lane_rd(arm64_inst.DUP, arm64_inst.vec(0, 4), 4, 1, 2) != 0x5E0C0440) { bad = 1; }
    if (t_lane_rd(arm64_inst.DUP, arm64_inst.vec(0, 8), 8, 1, 2) != 0x5E180440) { bad = 1; }
    if (t_ins_el(4, 3, 2, 0, 1) != 0x6E1C4420)                                  { bad = 1; }
    if (t_ins_el(8, 1, 1, 0, 1) != 0x6E184420)                                  { bad = 1; }
    if (t_ins_el(1, 5, 3, 0, 1) != 0x6E0B1C20)                                  { bad = 1; }
    if (t_ins_el(2, 2, 7, 0, 1) != 0x6E0A7420)                                  { bad = 1; }

    if (t_ldst(arm64_inst.LDR, true, 16, 0, 1, 1) != 0x3DC00420)           { bad = 1; }
    if (t_ldst(arm64_inst.STR, true, 16, 2, 3, 2) != 0x3D800862)           { bad = 1; }
    if (t_ldur(arm64_inst.LDUR, true, 16, 0, 0, 0x1F8::u32) != 0x3CDF8000) { bad = 1; }
    if (t_ldst_reg(arm64_inst.LDR, true, 16, 0, 0, 1) != 0x3CE16800)       { bad = 1; }

    ret bad;
}

test render_bytes_directive__reaches_the_sink {
    var bad:   i32 = 0;
    var alloc: A.Allocator;
    page.make(?alloc);
    var interner: intern.Interner;
    var st:       isa_encode.EncodeState;
    tasm(?st, ?alloc, ?interner);

    var w: io_writer.Writer;
    arm64_printer.test_sink_writer(?w);
    arm64_printer.test_sink_reset();
    var sink: isa_encode.AsmSink = isa_encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    var payload: [3]u8;
    payload[0] = 0xEC;
    payload[1] = 0x90;
    payload[2] = 0x0F;
    val start: usize = st.buf.bytes.len;
    var i:     usize = 0;
    for (i < 3) {
        isa_encode.emit_byte(?st.buf, payload[i]);
        i = i + 1;
    }

    if (isa_encode.sink_unaccounted(?st.buf) == 0) { bad = 1; }

    val render_bytes_directive_r: err[fail.Fail] = isa_encode.render_bytes_directive(?st, ?payload[0], 3, start);
    if (sel render_bytes_directive_r.err) { ret 1; }

    if (isa_encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    ret bad;
}
