use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use std.allocator.page;

use codegen_mir:   mach.lang.be.codegen.mir;
use codegen_rules: mach.lang.be.codegen.rules;
use lang_source:   mach.lang.source;
use mach.lang.target.isa;
use mach.lang.target.isa.arm64;

pub val RULE_COUNT: usize = 100;

pub val COPY_OPCODE_COUNT: usize = 3;

pub val FUSED_CC_COUNT: usize = 6;

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction) err[fail.Fail] {
    ret codegen_rules.select_function(?PACK, a, tgt, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret codegen_rules.is_reg_move(?PACK, opcode);
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == arm64.BRK::u32;
}

fun emit_swapped_cmp(builder: *codegen_rules.ExpansionBuilder, opcode: u32) err[fail.Fail] {
    var ops: [3]codegen_mir.MirOperand;
    ops[0] = builder.source.operands[0];
    ops[1] = builder.source.operands[2];
    ops[2] = builder.source.operands[1];
    val res_: res[*codegen_mir.MirInstr, fail.Fail] = codegen_rules.emit_instr(builder, opcode, ?ops[0], 3);
    if (sel res_.err) {
        ret err[fail.Fail].err{res_.err};
    }
    ret err[fail.Fail].ok{};
}

fun expand_vec_cmp_lt_s(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    ret emit_swapped_cmp(builder, arm64.VEC_CMGT::u32);
}

fun expand_vec_cmp_le_s(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    ret emit_swapped_cmp(builder, arm64.VEC_CMGE::u32);
}

fun expand_vec_cmp_lt_u(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    var opcode: u32 = arm64.VEC_CMHI::u32;
    if (codegen_mir.vec_lane_kind(builder.source.vec_lane) == codegen_mir.VEC_LANE_FLOAT) {
        opcode = arm64.VEC_CMGT::u32;
    }
    ret emit_swapped_cmp(builder, opcode);
}

fun expand_vec_cmp_le_u(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    var opcode: u32 = arm64.VEC_CMHS::u32;
    if (codegen_mir.vec_lane_kind(builder.source.vec_lane) == codegen_mir.VEC_LANE_FLOAT) {
        opcode = arm64.VEC_CMGE::u32;
    }
    ret emit_swapped_cmp(builder, opcode);
}

fun expand_vec_unsupported(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("codegen: unsupported vector operation on aarch64")};
}

fun guard_int_vec_lane(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    ret codegen_mir.vec_lane_kind(mi.vec_lane) == codegen_mir.VEC_LANE_INT;
}

pub val RULES: [RULE_COUNT]codegen_rules.Rule = [RULE_COUNT]codegen_rules.Rule{
    codegen_rules.Rule{op: codegen_mir.MIR_ADD, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_ADD::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SUB, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_SUB::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_MUL::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DIV_U, gate: codegen_rules.GATE_VECTOR, guard: guard_int_vec_lane, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1},
    codegen_rules.Rule{op: codegen_mir.MIR_DIV_S, gate: codegen_rules.GATE_VECTOR, guard: guard_int_vec_lane, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1},
    codegen_rules.Rule{op: codegen_mir.MIR_DIV_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_DIV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DIV_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_DIV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_AND, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_AND::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_OR, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_ORR::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_XOR, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_EOR::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_NOT, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_NOT::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CMP_EQ, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_CMEQ::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_NE, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_CMNE::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LT_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_lt_s, expansion_length: 1},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LT_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_lt_u, expansion_length: 1},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LE_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_le_s, expansion_length: 1},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LE_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_le_u, expansion_length: 1},

    codegen_rules.Rule{op: codegen_mir.MIR_SHL, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_SHL::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SHR_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_RETAG, to: arm64.VEC_SHR_S::u32, expand: nil, expansion_length: 0},
