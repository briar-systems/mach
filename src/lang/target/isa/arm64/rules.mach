use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use std.allocator.page;

use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.rules;
use mach.lang.source;
use mach.lang.target.isa;
use mach.lang.target.isa.arm64;

pub val RULE_COUNT: usize = 87;

pub val COPY_OPCODE_COUNT: usize = 3;

pub val FUSED_CC_COUNT: usize = 6;

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *mir.MirFunction) R.Result[R.Void, str] {
    ret rules.select(?PACK, a, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret rules.is_reg_move(?PACK, opcode);
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == arm64.BRK::u32;
}

fun emit_swapped_cmp(builder: *rules.ExpansionBuilder, opcode: u32) R.Result[R.Void, str] {
    var ops: [3]mir.MirOperand;
    ops[0] = builder.source.operands[0];
    ops[1] = builder.source.operands[2];
    ops[2] = builder.source.operands[1];
    val res: R.Result[*mir.MirInstr, str] = rules.emit(builder, opcode, ?ops[0], 3);
    if (R.is_err[*mir.MirInstr, str](res)) {
        ret R.err[R.Void, str](R.unwrap_err[*mir.MirInstr, str](res));
    }
    ret R.ok_void[str]();
}

fun expand_vec_cmp_lt_s(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    ret emit_swapped_cmp(builder, arm64.VEC_CMGT::u32);
}

fun expand_vec_cmp_le_s(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    ret emit_swapped_cmp(builder, arm64.VEC_CMGE::u32);
}

fun expand_vec_cmp_lt_u(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    var opcode: u32 = arm64.VEC_CMHI::u32;
    if (mir.vec_lane_kind(builder.source.vec_lane) == mir.VEC_LANE_FLOAT) {
        opcode = arm64.VEC_CMGT::u32;
    }
    ret emit_swapped_cmp(builder, opcode);
}

fun expand_vec_cmp_le_u(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    var opcode: u32 = arm64.VEC_CMHS::u32;
    if (mir.vec_lane_kind(builder.source.vec_lane) == mir.VEC_LANE_FLOAT) {
        opcode = arm64.VEC_CMGE::u32;
    }
    ret emit_swapped_cmp(builder, opcode);
}

fun expand_vec_unsupported(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    ret R.err[R.Void, str]("codegen: unsupported vector operation on aarch64");
}

fun guard_int_vec_lane(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    ret mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_INT;
}

pub val RULES: [RULE_COUNT]rules.Rule = [RULE_COUNT]rules.Rule{
    rules.Rule{ op: mir.MIR_ADD,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_ADD::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SUB,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_SUB::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_MUL,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_MUL::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DIV_U, gate: rules.GATE_VECTOR, guard: guard_int_vec_lane, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_DIV_S, gate: rules.GATE_VECTOR, guard: guard_int_vec_lane, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_DIV_U, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_DIV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DIV_S, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_DIV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_AND,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_AND::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_OR,    gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_ORR::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_XOR,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_EOR::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_NOT,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_NOT::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CMP_EQ, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_CMEQ::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_NE, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_RETAG, to: arm64.VEC_CMNE::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CMP_LT_S, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_lt_s, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_CMP_LT_U, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_lt_u, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_CMP_LE_S, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_le_s, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_CMP_LE_U, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_cmp_le_u, expansion_length: 1 },

    rules.Rule{ op: mir.MIR_SHL,   gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_SHR_S, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_SHR_U, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_REM_S, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },
    rules.Rule{ op: mir.MIR_REM_U, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1 },

    rules.Rule{ op: mir.MIR_ADD, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.ADD::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SUB, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.SUB::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_MUL, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.MUL::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_AND, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.AND::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_OR,  gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.ORR::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_XOR, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.EOR::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_SHL,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.LSL::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SHR_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.LSR::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SHR_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.ASR::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_DIV_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_DIV_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DIV_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_DIV_U, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_REM_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_REM_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_REM_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_REM_U, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_NEG, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.NEG::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_NOT, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.MVN::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_MOV, gate: rules.GATE_ANY, guard: rules.guard_fp_bank_move, kind: rules.RULE_RETAG, to: arm64.FMOV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_MOV, gate: rules.GATE_ANY, guard: nil,                        kind: rules.RULE_RETAG, to: arm64.MOV::u32,  expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DECLASSIFY, gate: rules.GATE_ANY, guard: rules.guard_fp_bank_move, kind: rules.RULE_RETAG, to: arm64.FMOV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DECLASSIFY, gate: rules.GATE_ANY, guard: nil,                        kind: rules.RULE_RETAG, to: arm64.MOV::u32,  expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_BR,          gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.B::u32,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_RET,         gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.RET::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_UNREACHABLE, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: arm64.BRK::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CMP_EQ,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_EQ,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_NE,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_NE,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LT_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LT_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LT_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LT_U, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LE_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LE_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LE_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LE_U, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CBR, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CBR, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_SEL_CBR_EQ,   gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_NE,   gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LT_S, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LT_U, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LE_S, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LE_U, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_VEC_EXTRACT, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_VEC_INSERT,  gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_ALLOCA, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_LOAD,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_STORE,  gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_GEP,    gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CALL,     gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_ARG,      gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CALL_RES, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_PHI,      gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_FADD, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FSUB, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FMUL, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FDIV, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FCMP, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FNEG, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_BITCAST, gate: rules.GATE_ANY, guard: rules.guard_fp_bank_move, kind: rules.RULE_RETAG, to: arm64.FMOV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_BITCAST, gate: rules.GATE_ANY, guard: guard_identity_copy,        kind: rules.RULE_RETAG, to: arm64.MOV::u32,  expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_BITCAST, gate: rules.GATE_ANY, guard: nil,                        kind: rules.RULE_PASS,  to: 0,             expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_TRUNC,    gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEXT,     gate: rules.GATE_ANY, guard: guard_identity_copy, kind: rules.RULE_RETAG, to: arm64.MOV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEXT,     gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_ZEXT,     gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_TRUNC, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_EXT,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_TO_SI, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_TO_UI, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SI_TO_FP, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_UI_TO_FP, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_ASM, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
};

pub val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    arm64.MOV::u32,
    arm64.FMOV::u32,
    mir.MIR_MOV,
};

pub val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    mir.MIR_CMP_EQ,
    mir.MIR_CMP_NE,
    mir.MIR_CMP_LT_S,
    mir.MIR_CMP_LT_U,
    mir.MIR_CMP_LE_S,
    mir.MIR_CMP_LE_U,
};

pub val PACK: rules.RulePack = rules.RulePack{
    name:               "aarch64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

fun width_is_64(width: u8) bool {
    if (width == 0) { ret true; }
    ret width >= 8;
}

fun guard_identity_copy(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mi.operand_count != 2)   { ret false; }
    if (!width_is_64(mi.width))  { ret false; }
    if (mi.opcode == mir.MIR_BITCAST) { ret true; }
    ret mi.src_width >= 8;
}

fun fp_preg(idx: i32) mir.MirOperand {
    ret mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx)::u32);
}

test "mach.lang.target.isa.arm64.rules:opcode_rewrites" {
    var bad: i32 = 0;
    var alloc: A.Allocator;
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;

    var instrs: [17]mir.MirInstr;
    var ops:    [17][3]mir.MirOperand;
    var i:      u32 = 0;
    for (i < 17) {
        ops[i][0] = mir.op_preg(10);
        ops[i][1] = mir.op_preg(11);
        ops[i][2] = mir.op_preg(12);
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 3;
        instrs[i].width         = 8;
        i = i + 1;
    }

    instrs[0].opcode  = mir.MIR_ADD;
    instrs[1].opcode  = mir.MIR_SHL;
    instrs[2].opcode  = mir.MIR_DIV_S;
    instrs[3].opcode  = mir.MIR_NEG;
    instrs[4].opcode  = mir.MIR_CMP_EQ;
    instrs[5].opcode  = mir.MIR_CBR;
    instrs[6].opcode  = mir.MIR_FADD;
    instrs[7].opcode  = mir.MIR_MOV;
    instrs[8].opcode  = mir.MIR_MOV;
    ops[8][0] = fp_preg(10); ops[8][1] = fp_preg(11);
    instrs[9].opcode  = mir.MIR_BITCAST;
    ops[9][0] = fp_preg(10); ops[9][1] = mir.op_preg(11);
    instrs[10].opcode = mir.MIR_BITCAST;
    instrs[11].opcode = mir.MIR_BR;
    instrs[12].opcode = mir.MIR_RET;
    instrs[13].opcode = mir.MIR_ADD;    instrs[13].vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    instrs[14].opcode = mir.MIR_AND;    instrs[14].vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    instrs[15].opcode = mir.MIR_CMP_EQ; instrs[15].vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    instrs[16].opcode = mir.MIR_DIV_U;  instrs[16].vec_lane = mir.vec_lane_make(mir.VEC_LANE_FLOAT, 8, 2);

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 17;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: R.Result[R.Void, str] = select(?alloc, ?tgt, ?f);
    if (R.is_err[R.Void, str](r)) { ret 1; }

    if (instrs[0].opcode  != arm64.ADD::u32)      { bad = 1; }
    if (instrs[1].opcode  != arm64.LSL::u32)      { bad = 1; }
    if (instrs[2].opcode  != mir.MIR_SEL_DIV_S)   { bad = 1; }
    if (instrs[3].opcode  != arm64.NEG::u32)      { bad = 1; }
    if (instrs[4].opcode  != mir.MIR_SEL_CMP_EQ)  { bad = 1; }
    if (instrs[5].opcode  != mir.MIR_SEL_CBR)     { bad = 1; }
    if (instrs[6].opcode  != mir.MIR_FADD)        { bad = 1; }
    if (instrs[7].opcode  != arm64.MOV::u32)      { bad = 1; }
    if (instrs[8].opcode  != arm64.FMOV::u32)     { bad = 1; }
    if (instrs[9].opcode  != arm64.FMOV::u32)     { bad = 1; }
    if (instrs[10].opcode != mir.MIR_BITCAST)     { bad = 1; }
    if (instrs[11].opcode != arm64.B::u32)        { bad = 1; }
    if (instrs[12].opcode != arm64.RET::u32)      { bad = 1; }
    if (instrs[13].opcode != arm64.VEC_ADD::u32)  { bad = 1; }
    if (instrs[14].opcode != arm64.VEC_AND::u32)  { bad = 1; }
    if (instrs[15].opcode != arm64.VEC_CMEQ::u32) { bad = 1; }
    if (instrs[16].opcode != arm64.VEC_DIV::u32)  { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.arm64.rules:is_reg_move" {
    if (!is_reg_move(arm64.MOV::u32))  { ret 1; }
    if (!is_reg_move(arm64.FMOV::u32)) { ret 1; }
    if (!is_reg_move(mir.MIR_MOV))     { ret 1; }
    if (is_reg_move(arm64.ADD::u32))   { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.rules:bitcast_bank_selects_fmov" {
    var alloc: A.Allocator;
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    var vregs: [2]mir.MirVReg;

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_vreg(0); ops[1] = mir.op_vreg(1);

    var instrs: [1]mir.MirInstr;
    instrs[0].operands      = ?ops[0];
    instrs[0].operand_count = 2;
    instrs[0].vec_lane      = mir.VEC_LANE_NONE;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 1;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vregs       = ?vregs[0];
    f.vreg_count  = 2;

    vregs[0].class = 1; vregs[1].class = 1;
    instrs[0].opcode = mir.MIR_BITCAST;
    if (R.is_err[R.Void, str](select(?alloc, ?tgt, ?f))) { ret 1; }
    if (instrs[0].opcode != arm64.FMOV::u32) { ret 1; }

    vregs[0].class = mir.REG_CLASS_GP; vregs[1].class = mir.REG_CLASS_GP;
    instrs[0].opcode = mir.MIR_BITCAST;
    if (R.is_err[R.Void, str](select(?alloc, ?tgt, ?f))) { ret 2; }
    if (instrs[0].opcode == arm64.FMOV::u32) { ret 2; }
    if (instrs[0].opcode != arm64.MOV::u32)  { ret 2; }

    vregs[0].class = 1; vregs[1].class = mir.REG_CLASS_GP;
    instrs[0].opcode = mir.MIR_BITCAST;
    if (R.is_err[R.Void, str](select(?alloc, ?tgt, ?f))) { ret 3; }
    if (instrs[0].opcode != arm64.FMOV::u32) { ret 3; }

    ret 0;
}

test "mach.lang.target.isa.arm64.rules:generic_opcode_coverage" {
    val pack: *rules.RulePack = ?PACK;
    if (pack.rule_count != 87) { ret 1; }

    var reachable: [mir.SELECTION_REACHABLE_COUNT]u32;
    mir.selection_reachable(?reachable[0]);

    var eliminated: [mir.SELECTION_ELIMINATED_COUNT]u32;
    mir.selection_eliminated(?eliminated[0]);

    var reachable_vec: [20]u32;
    reachable_vec[0]  = mir.MIR_ADD;
    reachable_vec[1]  = mir.MIR_SUB;
    reachable_vec[2]  = mir.MIR_MUL;
    reachable_vec[3]  = mir.MIR_DIV_U;
    reachable_vec[4]  = mir.MIR_DIV_S;
    reachable_vec[5]  = mir.MIR_AND;
    reachable_vec[6]  = mir.MIR_OR;
    reachable_vec[7]  = mir.MIR_XOR;
    reachable_vec[8]  = mir.MIR_NOT;
    reachable_vec[9]  = mir.MIR_CMP_EQ;
    reachable_vec[10] = mir.MIR_CMP_NE;
    reachable_vec[11] = mir.MIR_CMP_LT_S;
    reachable_vec[12] = mir.MIR_CMP_LT_U;
    reachable_vec[13] = mir.MIR_CMP_LE_S;
    reachable_vec[14] = mir.MIR_CMP_LE_U;
    reachable_vec[15] = mir.MIR_SHL;
    reachable_vec[16] = mir.MIR_SHR_S;
    reachable_vec[17] = mir.MIR_SHR_U;
    reachable_vec[18] = mir.MIR_REM_S;
    reachable_vec[19] = mir.MIR_REM_U;

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(11);
    ops[2] = mir.op_preg(12);
    var probe: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 8, 0);

    var f: mir.MirFunction;

    var i: u32 = 0;
    for (i < mir.SELECTION_REACHABLE_COUNT) {
        probe.opcode   = reachable[i];
        probe.vec_lane = mir.VEC_LANE_NONE;
        if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < mir.SELECTION_ELIMINATED_COUNT) {
        probe.opcode   = eliminated[i];
        probe.vec_lane = mir.VEC_LANE_NONE;
        if (rules.find_rule(pack, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 20) {
        probe.opcode   = reachable_vec[i];
        probe.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
        if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }

    var fused: [mir.SELECTION_FUSED_COUNT]u32;
    mir.selection_fused(?fused[0]);
    i = 0;
    for (i < mir.SELECTION_FUSED_COUNT) {
        probe.opcode   = fused[i];
        probe.vec_lane = mir.VEC_LANE_NONE;
        if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    if (pack.fused_cbr_cc_count != 6) { ret 1; }

    var lane: [mir.SELECTION_LANE_COUNT]u32;
    mir.selection_lane(?lane[0]);
    i = 0;
    for (i < mir.SELECTION_LANE_COUNT) {
        probe.opcode   = lane[i];
        probe.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
        if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }

    var wmul: [mir.SELECTION_WIDENING_MUL_COUNT]u32;
    mir.selection_widening_mul(?wmul[0]);
    i = 0;
    for (i < mir.SELECTION_WIDENING_MUL_COUNT) {
        probe.opcode   = wmul[i];
        probe.vec_lane = mir.VEC_LANE_NONE;
        if (rules.find_rule(pack, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }

    if (arm64.HAS_FLOAT) {
        var rfloat: [mir.SELECTION_REACHABLE_FLOAT_COUNT]u32;
        mir.selection_reachable_float(?rfloat[0]);
        i = 0;
        for (i < mir.SELECTION_REACHABLE_FLOAT_COUNT) {
            probe.opcode   = rfloat[i];
            probe.vec_lane = mir.VEC_LANE_NONE;
            if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
            i = i + 1;
        }
    }
    ret 0;
}

test "mach.lang.target.isa.arm64.rules:vector_compare_swaps_operands" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;

    val res_instrs: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](?backing, 1::usize);
    if (R.is_err[*mir.MirInstr, str](res_instrs)) { ret 1; }
    val instrs: *mir.MirInstr = R.unwrap_ok[*mir.MirInstr, str](res_instrs);

    val res_ops: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](?backing, 3::usize);
    if (R.is_err[*mir.MirOperand, str](res_ops)) { ret 1; }
    val ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](res_ops);
    ops[0] = mir.op_preg(20);
    ops[1] = mir.op_preg(21);
    ops[2] = mir.op_preg(22);

    var bindings: [1]mir.MirDbgBinding;
    bindings[0].iid  = 7;
    bindings[0].vreg = 3;
    bindings[0].cmp_op = 0;

    instrs[0].opcode            = mir.MIR_CMP_LT_S;
    instrs[0].operands          = ops;
    instrs[0].operand_count     = 3;
    instrs[0].width             = 16;
    instrs[0].src_width         = 4;
    instrs[0].vec_lane          = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    instrs[0].loc               = source.loc(3, 77);
    instrs[0].inline_site       = 5;
    instrs[0].dbg_bindings      = ?bindings[0];
    instrs[0].dbg_binding_count = 1;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 1;
    blk.instr_cap   = 1;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: R.Result[R.Void, str] = select(?backing, ?tgt, ?f);
    if (R.is_err[R.Void, str](r)) { ret 1; }

    if (blk.instr_count != 1) { ret 1; }
    if (blk.instr_cap != 1)   { ret 1; }

    if (blk.instrs[0].opcode != arm64.VEC_CMGT::u32) { ret 1; }
    if (blk.instrs[0].operand_count != 3)            { ret 1; }
    if (blk.instrs[0].operands[0].preg != 20)        { ret 1; }
    if (blk.instrs[0].operands[1].preg != 22)        { ret 1; }
    if (blk.instrs[0].operands[2].preg != 21)        { ret 1; }

    if (blk.instrs[0].width != 16)                                              { ret 1; }
    if (blk.instrs[0].src_width != 4)                                           { ret 1; }
    if (blk.instrs[0].vec_lane != mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4))       { ret 1; }
    if (blk.instrs[0].loc.file != 3)                                           { ret 1; }
    if (blk.instrs[0].loc.offset != 77)                                        { ret 1; }
    if (blk.instrs[0].inline_site != 5)                                        { ret 1; }
    if (blk.instrs[0].asm_block != nil)                                        { ret 1; }
    if (blk.instrs[0].dbg_bindings != ?bindings[0])                            { ret 1; }
    if (blk.instrs[0].dbg_binding_count != 1)                                  { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.rules:float_ordering_compare_selects_float" {
    if (sel_vec_cmp(mir.MIR_CMP_LT_U, mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4)) != arm64.VEC_CMGT::u32) { ret 1; }
    if (sel_vec_cmp(mir.MIR_CMP_LT_U, mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4))   != arm64.VEC_CMHI::u32) { ret 2; }
    if (sel_vec_cmp(mir.MIR_CMP_LE_U, mir.vec_lane_make(mir.VEC_LANE_FLOAT, 8, 2)) != arm64.VEC_CMGE::u32) { ret 3; }
    if (sel_vec_cmp(mir.MIR_CMP_LE_U, mir.vec_lane_make(mir.VEC_LANE_INT, 2, 8))   != arm64.VEC_CMHS::u32) { ret 4; }
    ret 0;
}

fun sel_vec_cmp(opcode: u32, lane: u32) u32 {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 0; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;

    val res_instrs: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](?backing, 1::usize);
    if (R.is_err[*mir.MirInstr, str](res_instrs)) { ret 0; }
    val instrs: *mir.MirInstr = R.unwrap_ok[*mir.MirInstr, str](res_instrs);

    val res_ops: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](?backing, 3::usize);
    if (R.is_err[*mir.MirOperand, str](res_ops)) { ret 0; }
    val ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](res_ops);
    ops[0] = mir.op_preg(20);
    ops[1] = mir.op_preg(21);
    ops[2] = mir.op_preg(22);

    instrs[0].opcode        = opcode;
    instrs[0].operands      = ops;
    instrs[0].operand_count = 3;
    instrs[0].width         = 16;
    instrs[0].vec_lane      = lane;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 1;
    blk.instr_cap   = 1;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: R.Result[R.Void, str] = select(?backing, ?tgt, ?f);
    if (R.is_err[R.Void, str](r)) { ret 0; }
    ret blk.instrs[0].opcode;
}

test "mach.lang.target.isa.arm64.rules:vector_shift_rem_unsupported" {
    if (!vec_op_errors(mir.MIR_SHL))   { ret 1; }
    if (!vec_op_errors(mir.MIR_SHR_S)) { ret 2; }
    if (!vec_op_errors(mir.MIR_SHR_U)) { ret 3; }
    if (!vec_op_errors(mir.MIR_REM_S)) { ret 4; }
    if (!vec_op_errors(mir.MIR_REM_U)) { ret 5; }
    if (vec_op_errors_scalar(mir.MIR_SHL))   { ret 6; }
    if (vec_op_errors_scalar(mir.MIR_REM_U)) { ret 7; }
    ret 0;
}

fun vec_op_errors(opcode: u32) bool {
    ret vec_op_select_fails(opcode, mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4));
}

fun vec_op_errors_scalar(opcode: u32) bool {
    ret vec_op_select_fails(opcode, mir.VEC_LANE_NONE);
}

fun vec_op_select_fails(opcode: u32, lane: u32) bool {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret false; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;

    val res_instrs: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](?backing, 1::usize);
    if (R.is_err[*mir.MirInstr, str](res_instrs)) { ret false; }
    val instrs: *mir.MirInstr = R.unwrap_ok[*mir.MirInstr, str](res_instrs);

    val res_ops: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](?backing, 3::usize);
    if (R.is_err[*mir.MirOperand, str](res_ops)) { ret false; }
    val ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](res_ops);
    ops[0] = mir.op_preg(20);
    ops[1] = mir.op_preg(21);
    ops[2] = mir.op_preg(22);

    instrs[0].opcode        = opcode;
    instrs[0].operands      = ops;
    instrs[0].operand_count = 3;
    instrs[0].width         = 16;
    instrs[0].vec_lane      = lane;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 1;
    blk.instr_cap   = 1;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    ret R.is_err[R.Void, str](select(?backing, ?tgt, ?f));
}

fun vec_op_ok(opcode: u32, lane: u32) bool {
    ret !vec_op_select_fails(opcode, lane);
}

test "mach.lang.target.isa.arm64.rules:integer_vector_divide_unsupported" {
    if (!vec_op_errors(mir.MIR_DIV_S)) { ret 1; }
    if (!vec_op_errors(mir.MIR_DIV_U)) { ret 2; }
    if (!vec_op_ok(mir.MIR_DIV_S, mir.vec_lane_make(mir.VEC_LANE_FLOAT, 4, 4))) { ret 3; }
    if (!vec_op_ok(mir.MIR_DIV_U, mir.vec_lane_make(mir.VEC_LANE_FLOAT, 8, 2))) { ret 4; }
    if (vec_op_errors_scalar(mir.MIR_DIV_S)) { ret 5; }
    if (vec_op_errors_scalar(mir.MIR_DIV_U)) { ret 6; }
    ret 0;
}

test "mach.lang.target.isa.arm64.rules:identity_conversions_select_to_a_move" {
    var bad: i32 = 0;
    var alloc: A.Allocator;
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;

    var instrs: [8]mir.MirInstr;
    var ops:    [8][2]mir.MirOperand;
    var i:      u32 = 0;
    for (i < 8) {
        ops[i][0] = mir.op_preg(10);
        ops[i][1] = mir.op_preg(11);
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 2;
        instrs[i].width         = 8;
        instrs[i].src_width     = 8;
        instrs[i].vec_lane      = mir.VEC_LANE_NONE;
        i = i + 1;
    }

    instrs[0].opcode = mir.MIR_BITCAST;
    instrs[1].opcode = mir.MIR_BITCAST;
    instrs[1].width  = 4;
    instrs[2].opcode = mir.MIR_SEXT;
    instrs[3].opcode    = mir.MIR_SEXT;
    instrs[3].src_width = 1;
    instrs[4].opcode = mir.MIR_SEXT;
    instrs[4].width  = 4;
    instrs[5].opcode = mir.MIR_BITCAST;
    instrs[5].width  = 0;
    instrs[6].opcode = mir.MIR_BITCAST;
    ops[6][0] = fp_preg(10);
    instrs[7].opcode    = mir.MIR_SEXT;
    instrs[7].src_width = 4;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 8;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: R.Result[R.Void, str] = select(?alloc, ?tgt, ?f);
    if (R.is_err[R.Void, str](r)) { ret 1; }

    if (instrs[0].opcode != arm64.MOV::u32)  { bad = 1; }
    if (instrs[1].opcode != mir.MIR_BITCAST) { bad = 1; }
    if (instrs[2].opcode != arm64.MOV::u32)  { bad = 1; }
    if (instrs[3].opcode != mir.MIR_SEXT)    { bad = 1; }
    if (instrs[4].opcode != mir.MIR_SEXT)    { bad = 1; }
    if (instrs[5].opcode != arm64.MOV::u32)  { bad = 1; }
    if (instrs[6].opcode != arm64.FMOV::u32) { bad = 1; }
    if (instrs[7].opcode != mir.MIR_SEXT)    { bad = 1; }

    if (!is_reg_move(arm64.MOV::u32)) { bad = 1; }
    if (is_reg_move(mir.MIR_BITCAST)) { bad = 1; }
    if (is_reg_move(mir.MIR_SEXT))    { bad = 1; }

    ret bad;
}
