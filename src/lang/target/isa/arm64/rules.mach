    codegen_rules.Rule{op: codegen_mir.MIR_REM_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1},

