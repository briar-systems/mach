    codegen_rules.Rule{op: codegen_mir.MIR_FP_TRUNC, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_EXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TO_SI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TO_UI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SI_TO_FP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_UI_TO_FP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_ASM, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
};

pub val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    arm64.MOV::u32,
    arm64.FMOV::u32,
    codegen_mir.MIR_MOV,
};

pub val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    codegen_mir.MIR_CMP_EQ,
    codegen_mir.MIR_CMP_NE,
    codegen_mir.MIR_CMP_LT_S,
    codegen_mir.MIR_CMP_LT_U,
    codegen_mir.MIR_CMP_LE_S,
    codegen_mir.MIR_CMP_LE_U,
};

pub val PACK: codegen_rules.RulePack = codegen_rules.RulePack{
    name:               "aarch64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

fun guard_identity_copy(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    if (mi.operand_count != 2)                           { ret false; }
    if (mi.width != 0 && mi.width < tgt.model.gpr_width) { ret false; }
    if (mi.opcode == codegen_mir.MIR_BITCAST)            { ret true; }
    ret mi.src_width >= tgt.model.gpr_width;
}

#[testing]
fun fp_preg(idx: i32) codegen_mir.MirOperand {
    ret codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, idx)));
}

test select__opcode_rewrites {
    var bad:   i32 = 0;
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    var instrs: [17]codegen_mir.MirInstr;
    var ops:    [17][3]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < 17) {
        ops[i][0]               = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]               = codegen_mir.op_preg(codegen_mir.preg_id(11));
        ops[i][2]               = codegen_mir.op_preg(codegen_mir.preg_id(12));
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 3;
        instrs[i].width         = 8;
        i                       = i + 1;
    }

    instrs[0].opcode    = codegen_mir.MIR_ADD;
    instrs[1].opcode    = codegen_mir.MIR_SHL;
    instrs[2].opcode    = codegen_mir.MIR_DIV_S;
    instrs[3].opcode    = codegen_mir.MIR_NEG;
    instrs[4].opcode    = codegen_mir.MIR_CMP_EQ;
    instrs[5].opcode    = codegen_mir.MIR_CBR;
    instrs[6].opcode    = codegen_mir.MIR_FADD;
    instrs[7].opcode    = codegen_mir.MIR_MOV;
    instrs[8].opcode    = codegen_mir.MIR_MOV;
    ops[8][0]           = fp_preg(10);
    ops[8][1]           = fp_preg(11);
    instrs[9].opcode    = codegen_mir.MIR_BITCAST;
    ops[9][0]           = fp_preg(10);
    ops[9][1]           = codegen_mir.op_preg(codegen_mir.preg_id(11));
    instrs[10].opcode   = codegen_mir.MIR_BITCAST;
    instrs[11].opcode   = codegen_mir.MIR_BR;
    instrs[12].opcode   = codegen_mir.MIR_RET;
    instrs[13].opcode   = codegen_mir.MIR_ADD;
    instrs[13].vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    instrs[14].opcode   = codegen_mir.MIR_AND;
    instrs[14].vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    instrs[15].opcode   = codegen_mir.MIR_CMP_EQ;
    instrs[15].vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    instrs[16].opcode   = codegen_mir.MIR_DIV_U;
    instrs[16].vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_FLOAT, 8, 2);

    ops[5][1]                = codegen_mir.op_block(0);
    ops[5][2]                = codegen_mir.op_block(1);
    ops[6][0]                = fp_preg(10);
    ops[6][1]                = fp_preg(11);
    ops[6][2]                = fp_preg(12);
    instrs[11].operand_count = 1;
    ops[11][0]               = codegen_mir.op_block(0);
    instrs[12].operand_count = 0;
    i                        = 13;
    for (i < 17) {
        ops[i][0] = fp_preg(10);
        ops[i][1] = fp_preg(11);
        ops[i][2] = fp_preg(12);
        i         = i + 1;
    }

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 17;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (instrs[0].opcode != arm64.ADD::u32)             { bad = 1; }
    if (instrs[1].opcode != arm64.LSL::u32)             { bad = 1; }
    if (instrs[2].opcode != codegen_mir.MIR_SEL_DIV_S)  { bad = 1; }
    if (instrs[3].opcode != arm64.NEG::u32)             { bad = 1; }
    if (instrs[4].opcode != codegen_mir.MIR_SEL_CMP_EQ) { bad = 1; }
    if (instrs[5].opcode != codegen_mir.MIR_SEL_CBR)    { bad = 1; }
    if (instrs[6].opcode != codegen_mir.MIR_FADD)       { bad = 1; }
    if (instrs[7].opcode != arm64.MOV::u32)             { bad = 1; }
    if (instrs[8].opcode != arm64.FMOV::u32)            { bad = 1; }
    if (instrs[9].opcode != arm64.FMOV::u32)            { bad = 1; }
    if (instrs[10].opcode != codegen_mir.MIR_BITCAST)   { bad = 1; }
    if (instrs[11].opcode != arm64.B::u32)              { bad = 1; }
    if (instrs[12].opcode != arm64.RET::u32)            { bad = 1; }
    if (instrs[13].opcode != arm64.VEC_ADD::u32)        { bad = 1; }
    if (instrs[14].opcode != arm64.VEC_AND::u32)        { bad = 1; }
    if (instrs[15].opcode != arm64.VEC_CMEQ::u32)       { bad = 1; }
    if (instrs[16].opcode != arm64.VEC_DIV::u32)        { bad = 1; }

    ret bad;
}

test is_reg_move__moves_across_banks_and_nothing_else {
    if (!is_reg_move(arm64.MOV::u32))         { ret 1; }
    if (!is_reg_move(arm64.FMOV::u32))        { ret 1; }
    if (!is_reg_move(codegen_mir.MIR_MOV))    { ret 1; }
    if (is_reg_move(arm64.ADD::u32))          { ret 1; }
    if (is_reg_move(codegen_mir.MIR_BITCAST)) { ret 1; }
    if (is_reg_move(codegen_mir.MIR_SEXT))    { ret 1; }
    ret 0;
}

test select__bitcast_bank_selects_fmov {
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;
    var vregs: [2]codegen_mir.MirVReg;

    var ops: [2]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_vreg(codegen_mir.vreg_id(0));
    ops[1] = codegen_mir.op_vreg(codegen_mir.vreg_id(1));

    var instrs: [1]codegen_mir.MirInstr;
    instrs[0].operands      = ?ops[0];
    instrs[0].operand_count = 2;
    instrs[0].vec_lane      = codegen_mir.VEC_LANE_NONE;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 1;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vregs       = ?vregs[0];
    f.vreg_count  = 2;

    vregs[0].class   = 1;
    vregs[1].class   = 1;
    instrs[0].opcode = codegen_mir.MIR_BITCAST;
    val r_348: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r_348.err)                       { ret 1; }
    if (instrs[0].opcode != arm64.FMOV::u32) { ret 1; }

    vregs[0].class   = codegen_mir.REG_CLASS_GP;
    vregs[1].class   = codegen_mir.REG_CLASS_GP;
    instrs[0].opcode = codegen_mir.MIR_BITCAST;
    val r_353: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r_353.err)                       { ret 2; }
    if (instrs[0].opcode == arm64.FMOV::u32) { ret 2; }
    if (instrs[0].opcode != arm64.MOV::u32)  { ret 2; }

    vregs[0].class   = 1;
    vregs[1].class   = codegen_mir.REG_CLASS_GP;
    instrs[0].opcode = codegen_mir.MIR_BITCAST;
    val r_359: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r_359.err)                       { ret 3; }
    if (instrs[0].opcode != arm64.FMOV::u32) { ret 3; }

    ret 0;
}

test rule_pack__generic_opcode_coverage {
    var tgt: isa.BackendTarget;
    tgt.model.gpr_width = 8;
    val pack: *codegen_rules.RulePack = ?PACK;
    if (pack.rule_count != 100) { ret 1; }

    var reachable: [codegen_mir.SELECTION_REACHABLE_COUNT]u32;
    codegen_mir.selection_reachable(?reachable[0]);

    var eliminated: [codegen_mir.SELECTION_ELIMINATED_COUNT]u32;
    codegen_mir.selection_eliminated(?eliminated[0]);

    var reachable_vec: [20]u32;
    reachable_vec[0]  = codegen_mir.MIR_ADD;
    reachable_vec[1]  = codegen_mir.MIR_SUB;
    reachable_vec[2]  = codegen_mir.MIR_MUL;
    reachable_vec[3]  = codegen_mir.MIR_DIV_U;
    reachable_vec[4]  = codegen_mir.MIR_DIV_S;
    reachable_vec[5]  = codegen_mir.MIR_AND;
    reachable_vec[6]  = codegen_mir.MIR_OR;
    reachable_vec[7]  = codegen_mir.MIR_XOR;
    reachable_vec[8]  = codegen_mir.MIR_NOT;
    reachable_vec[9]  = codegen_mir.MIR_CMP_EQ;
    reachable_vec[10] = codegen_mir.MIR_CMP_NE;
    reachable_vec[11] = codegen_mir.MIR_CMP_LT_S;
    reachable_vec[12] = codegen_mir.MIR_CMP_LT_U;
    reachable_vec[13] = codegen_mir.MIR_CMP_LE_S;
    reachable_vec[14] = codegen_mir.MIR_CMP_LE_U;
    reachable_vec[15] = codegen_mir.MIR_SHL;
    reachable_vec[16] = codegen_mir.MIR_SHR_S;
    reachable_vec[17] = codegen_mir.MIR_SHR_U;
    reachable_vec[18] = codegen_mir.MIR_REM_S;
    reachable_vec[19] = codegen_mir.MIR_REM_U;

    var ops: [3]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(10));
    ops[1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
    ops[2] = codegen_mir.op_preg(codegen_mir.preg_id(12));
    var probe: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ADD, ?ops[0], 3, 8, 0);

    var f: codegen_mir.MirFunction;

    var i: u32 = 0;
    for (i < codegen_mir.SELECTION_REACHABLE_COUNT) {
        probe.opcode   = reachable[i];
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < codegen_mir.SELECTION_ELIMINATED_COUNT) {
        probe.opcode   = eliminated[i];
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 20) {
        probe.opcode   = reachable_vec[i];
        probe.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }

    var fused: [codegen_mir.SELECTION_FUSED_COUNT]u32;
    codegen_mir.selection_fused(?fused[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_FUSED_COUNT) {
        probe.opcode   = fused[i];
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    if (pack.fused_cbr_cc_count != 6) { ret 1; }

    # a lane-wise conversion passes to the vector encoder, never to a scalar move
    val convs: [9]u32 = [9]u32{codegen_mir.MIR_TRUNC, codegen_mir.MIR_SEXT, codegen_mir.MIR_ZEXT, codegen_mir.MIR_FP_TRUNC, codegen_mir.MIR_FP_EXT,
        codegen_mir.MIR_FP_TO_SI, codegen_mir.MIR_FP_TO_UI, codegen_mir.MIR_SI_TO_FP, codegen_mir.MIR_UI_TO_FP};
    var ci: u32 = 0;
    for (ci < 9) {
        probe.opcode   = convs[ci];
        probe.vec_lane = codegen_mir.vec_lane_make_convert(codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8), codegen_mir.VEC_LANE_INT, 1);
        val conv_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (conv_rule == nil || conv_rule.kind != codegen_rules.RULE_PASS) { ret 2; }
        ci = ci + 1;
    }
    probe.vec_lane = codegen_mir.VEC_LANE_NONE;

    # a packed widening multiply passes to the vector encoder on a vector lane
    # and has no scalar selection
    var pwide: [codegen_mir.SELECTION_PACKED_WIDENING_COUNT]u32;
    codegen_mir.selection_packed_widening(?pwide[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_WIDENING_COUNT) {
        probe.opcode   = pwide[i];
        probe.vec_lane = codegen_mir.vec_lane_make_convert(codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4), codegen_mir.VEC_LANE_INT, 2);
        val wide_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (wide_rule == nil || wide_rule.kind != codegen_rules.RULE_PASS) { ret 3; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 3; }
        i = i + 1;
    }

    # a lane range and a lane join pass to the vector encoder on a vector lane
    # and have no scalar selection
    var perm: [codegen_mir.SELECTION_PACKED_PERMUTE_COUNT]u32;
    codegen_mir.selection_packed_permute(?perm[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_PERMUTE_COUNT) {
        probe.opcode   = perm[i];
        probe.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8);
        val perm_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (perm_rule == nil || perm_rule.kind != codegen_rules.RULE_PASS) { ret 6; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 6; }
        i = i + 1;
    }

    var lane: [codegen_mir.SELECTION_LANE_COUNT]u32;
    codegen_mir.selection_lane(?lane[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_LANE_COUNT) {
        probe.opcode   = lane[i];
        probe.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }

    var wmul: [codegen_mir.SELECTION_WIDENING_MUL_COUNT]u32;
    codegen_mir.selection_widening_mul(?wmul[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_WIDENING_MUL_COUNT) {
        probe.opcode   = wmul[i];
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }

    if (arm64.HAS_FLOAT) {
        var rfloat: [codegen_mir.SELECTION_REACHABLE_FLOAT_COUNT]u32;
        codegen_mir.selection_reachable_float(?rfloat[0]);
        i = 0;
        for (i < codegen_mir.SELECTION_REACHABLE_FLOAT_COUNT) {
            probe.opcode   = rfloat[i];
            probe.vec_lane = codegen_mir.VEC_LANE_NONE;
            if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
            i = i + 1;
        }
    }
    ret 0;
}

test select__vector_compare_swaps_operands {
    var backing: A.Allocator;
    val r_476:   err[A.Error] = page.make(?backing);
    if (sel r_476.err) { ret 1; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](?backing, 1::usize);
    if (sel res_instrs.err) { ret 1; }
    val instrs: *codegen_mir.MirInstr = res_instrs.ok;

    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](?backing, 3::usize);
    if (sel res_ops.err) { ret 1; }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0] = fp_preg(20);
    ops[1] = fp_preg(21);
    ops[2] = fp_preg(22);

    var bindings: [1]codegen_mir.MirDbgBinding;
    bindings[0].iid    = 7;
    bindings[0].vreg   = 3;
    bindings[0].cmp_op = 0;

    instrs[0].opcode            = codegen_mir.MIR_CMP_LT_S;
    instrs[0].operands          = ops;
    instrs[0].operand_count     = 3;
    instrs[0].width             = 16;
    instrs[0].src_width         = 4;
    instrs[0].vec_lane          = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    instrs[0].loc               = lang_source.loc(3, 77);
    instrs[0].inline_site       = 5;
    instrs[0].dbg_bindings      = ?bindings[0];
    instrs[0].dbg_binding_count = 1;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 1;
    blk.instr_cap   = 1;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?backing, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (blk.instr_count != 1) { ret 1; }
    if (blk.instr_cap != 1)   { ret 1; }

    if (blk.instrs[0].opcode != arm64.VEC_CMGT::u32)                                                        { ret 1; }
    if (blk.instrs[0].operand_count != 3)                                                                   { ret 1; }
    if (codegen_mir.preg_regid(blk.instrs[0].operands[0].preg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 20)) { ret 1; }
    if (codegen_mir.preg_regid(blk.instrs[0].operands[1].preg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 22)) { ret 1; }
    if (codegen_mir.preg_regid(blk.instrs[0].operands[2].preg) != isa.regid_make(isa.REG_CLASS_ID_XMM, 21)) { ret 1; }

    if (blk.instrs[0].width != 16)                                                           { ret 1; }
    if (blk.instrs[0].src_width != 4)                                                        { ret 1; }
    if (blk.instrs[0].vec_lane != codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4)) { ret 1; }
    if (blk.instrs[0].loc.file != 3)                                                         { ret 1; }
    if (blk.instrs[0].loc.offset != 77)                                                      { ret 1; }
    if (blk.instrs[0].inline_site != 5)                                                      { ret 1; }
    if (blk.instrs[0].asm_block != nil)                                                      { ret 1; }
    if (blk.instrs[0].dbg_bindings != ?bindings[0])                                          { ret 1; }
    if (blk.instrs[0].dbg_binding_count != 1)                                                { ret 1; }
    ret 0;
}

test select__float_ordering_compare_selects_float {
    if (sel_vec_cmp(codegen_mir.MIR_CMP_LT_U, codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_FLOAT, 4, 4)) != arm64.VEC_CMGT::u32) { ret 1; }
    if (sel_vec_cmp(codegen_mir.MIR_CMP_LT_U, codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4)) != arm64.VEC_CMHI::u32)   { ret 2; }
    if (sel_vec_cmp(codegen_mir.MIR_CMP_LE_U, codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_FLOAT, 8, 2)) != arm64.VEC_CMGE::u32) { ret 3; }
    if (sel_vec_cmp(codegen_mir.MIR_CMP_LE_U, codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8)) != arm64.VEC_CMHS::u32)   { ret 4; }
    ret 0;
}

#[testing]
fun sel_vec_cmp(opcode: u32, lane: u32) u32 {
    var backing: A.Allocator;
    val r_554:   err[A.Error] = page.make(?backing);
    if (sel r_554.err) { ret 0; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](?backing, 1::usize);
    if (sel res_instrs.err) { ret 0; }
    val instrs: *codegen_mir.MirInstr = res_instrs.ok;

    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](?backing, 3::usize);
    if (sel res_ops.err) { ret 0; }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0] = fp_preg(20);
    ops[1] = fp_preg(21);
    ops[2] = fp_preg(22);

    instrs[0].opcode        = opcode;
    instrs[0].operands      = ops;
    instrs[0].operand_count = 3;
    instrs[0].width         = 16;
    instrs[0].vec_lane      = lane;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 1;
    blk.instr_cap   = 1;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?backing, ?tgt, ?f);
    if (sel r.err) { ret 0; }
    ret blk.instrs[0].opcode;
}

#[testing]
fun vec_op_errors(opcode: u32) bool {
    ret vec_op_select_fails(opcode, codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4));
}

#[testing]
fun vec_op_errors_scalar(opcode: u32) bool {
    ret vec_op_select_fails(opcode, codegen_mir.VEC_LANE_NONE);
}

#[testing]
fun vec_op_select_fails(opcode: u32, lane: u32) bool {
    var backing: A.Allocator;
    val r_614:   err[A.Error] = page.make(?backing);
    if (sel r_614.err) { ret false; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    val res_instrs: res[*codegen_mir.MirInstr, A.Error] = A.zallocate[codegen_mir.MirInstr](?backing, 1::usize);
    if (sel res_instrs.err) { ret false; }
    val instrs: *codegen_mir.MirInstr = res_instrs.ok;

    val res_ops: res[*codegen_mir.MirOperand, A.Error] = A.allocate[codegen_mir.MirOperand](?backing, 3::usize);
    if (sel res_ops.err) { ret false; }
    val ops: *codegen_mir.MirOperand = res_ops.ok;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(20));
    ops[1] = codegen_mir.op_preg(codegen_mir.preg_id(21));
    ops[2] = codegen_mir.op_preg(codegen_mir.preg_id(22));
    if (lane != codegen_mir.VEC_LANE_NONE) {
        ops[0] = fp_preg(20);
        ops[1] = fp_preg(21);
        ops[2] = fp_preg(22);
    }

    instrs[0].opcode        = opcode;
    instrs[0].operands      = ops;
    instrs[0].operand_count = 3;
    instrs[0].width         = 8;
    if (lane != codegen_mir.VEC_LANE_NONE) { instrs[0].width = 16; }
    instrs[0].vec_lane = lane;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 1;
    blk.instr_cap   = 1;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r_654: err[fail.Fail] = select(?backing, ?tgt, ?f);
    ret sel r_654.err;
}

#[testing]
fun vec_op_ok(opcode: u32, lane: u32) bool {
    ret !vec_op_select_fails(opcode, lane);
}

# neon has no integer vector remainder or divide: each is refused on an
# integer lane and selects as a scalar or a float lane. the shifts select on
# an integer lane (#3852)
test select__integer_vector_ops_without_an_instruction_are_refused {
    val lane: u32 = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    if (!vec_op_ok(codegen_mir.MIR_SHL, lane))                                                          { ret 1; }
    if (!vec_op_ok(codegen_mir.MIR_SHR_S, lane))                                                        { ret 2; }
    if (!vec_op_ok(codegen_mir.MIR_SHR_U, lane))                                                        { ret 3; }
    if (!vec_op_errors(codegen_mir.MIR_REM_S))                                                          { ret 4; }
    if (!vec_op_errors(codegen_mir.MIR_REM_U))                                                          { ret 5; }
    if (!vec_op_errors(codegen_mir.MIR_DIV_S))                                                          { ret 6; }
    if (!vec_op_errors(codegen_mir.MIR_DIV_U))                                                          { ret 7; }
    if (!vec_op_ok(codegen_mir.MIR_DIV_U, codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_FLOAT, 8, 2))) { ret 8; }
    if (vec_op_errors_scalar(codegen_mir.MIR_SHL))                                                      { ret 9; }
    if (vec_op_errors_scalar(codegen_mir.MIR_REM_U))                                                    { ret 10; }
    if (vec_op_errors_scalar(codegen_mir.MIR_DIV_S))                                                    { ret 11; }
    ret 0;
}

test select__identity_conversions_are_a_move {
    var bad:   i32 = 0;
    var alloc: A.Allocator;
    var tgt:   isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_AARCH64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    var instrs: [8]codegen_mir.MirInstr;
    var ops:    [8][2]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < 8) {
        ops[i][0]               = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]               = codegen_mir.op_preg(codegen_mir.preg_id(11));
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 2;
        instrs[i].width         = 8;
        instrs[i].src_width     = 8;
        instrs[i].vec_lane      = codegen_mir.VEC_LANE_NONE;
        i                       = i + 1;
    }

    instrs[0].opcode    = codegen_mir.MIR_BITCAST;
    instrs[1].opcode    = codegen_mir.MIR_BITCAST;
    instrs[1].width     = 4;
    instrs[2].opcode    = codegen_mir.MIR_SEXT;
    instrs[3].opcode    = codegen_mir.MIR_SEXT;
    instrs[3].src_width = 1;
    instrs[4].opcode    = codegen_mir.MIR_SEXT;
    instrs[4].width     = 4;
    instrs[5].opcode    = codegen_mir.MIR_BITCAST;
    instrs[5].width     = 0;
    instrs[6].opcode    = codegen_mir.MIR_BITCAST;
    ops[6][0]           = fp_preg(10);
    instrs[7].opcode    = codegen_mir.MIR_SEXT;
    instrs[7].src_width = 4;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 8;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (instrs[0].opcode != arm64.MOV::u32)          { bad = 1; }
    if (instrs[1].opcode != codegen_mir.MIR_BITCAST) { bad = 1; }
    if (instrs[2].opcode != arm64.MOV::u32)          { bad = 1; }
    if (instrs[3].opcode != codegen_mir.MIR_SEXT)    { bad = 1; }
    if (instrs[4].opcode != codegen_mir.MIR_SEXT)    { bad = 1; }
    if (instrs[5].opcode != arm64.MOV::u32)          { bad = 1; }
    if (instrs[6].opcode != arm64.FMOV::u32)         { bad = 1; }
    if (instrs[7].opcode != codegen_mir.MIR_SEXT)    { bad = 1; }

    ret bad;
}
