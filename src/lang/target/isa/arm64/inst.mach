    if (!t_spelled(SMC, "smc")) { ret 9; }
    if (!t_spelled(MOV, "mov")) { ret 10; }
    if (!t_spelled(MOVZ, "movz")) { ret 11; }
    if (!t_spelled(MOVK, "movk")) { ret 12; }
    if (!t_spelled(MVN, "mvn")) { ret 13; }
    if (!t_spelled(NEG, "neg")) { ret 14; }
