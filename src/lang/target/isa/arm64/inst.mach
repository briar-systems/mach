use std.types.bool.bool;
use std.types.bool.false;
use std.types.string.str;
use std.types.option.opt;
use std.types.string.str_equals;

# the aarch64 machine-opcode space: one member per instruction the encoder
# emits or the inline-asm grammar accepts, named by the assembler spelling the
# printer renders. `arm64.Opcode` is the selection space (a MIR row alias);
# this is what an instruction notification carries, the same split riscv makes
# between `riscv.Opcode` and `riscv.inst.MachOp`.
pub def MachOp: u16;

pub val MOP_NONE: MachOp = 0;

pub val NOP:   MachOp = 1;
pub val YIELD: MachOp = 2;
pub val WFE:   MachOp = 3;
pub val WFI:   MachOp = 4;
pub val RET:   MachOp = 5;
pub val SVC:   MachOp = 6;
pub val BRK:   MachOp = 7;
pub val HVC:   MachOp = 8;
pub val SMC:   MachOp = 9;

pub val MOV:  MachOp = 10;
pub val MOVZ: MachOp = 11;
pub val MOVK: MachOp = 12;
pub val MVN:  MachOp = 13;
pub val NEG:  MachOp = 14;

pub val ADD:  MachOp = 15;
pub val ADDS: MachOp = 16;
pub val SUB:  MachOp = 17;
pub val SUBS: MachOp = 18;
pub val CMP:  MachOp = 19;
pub val CMN:  MachOp = 20;
pub val AND:  MachOp = 21;
pub val ORR:  MachOp = 22;
pub val ORN:  MachOp = 23;
pub val EOR:  MachOp = 24;

pub val MUL:  MachOp = 25;
pub val MNEG: MachOp = 26;
pub val MADD: MachOp = 27;
pub val MSUB: MachOp = 28;
pub val SDIV: MachOp = 29;
pub val UDIV: MachOp = 30;

# immediate shifts are bitfield aliases; the register-count forms are the
# variable-latency members and keep their own members even though the
# printer renders both with the preferred `lsl`/`lsr`/`asr` spelling
pub val LSL:  MachOp = 31;
pub val LSR:  MachOp = 32;
pub val ASR:  MachOp = 33;
pub val LSLV: MachOp = 34;
pub val LSRV: MachOp = 35;
pub val ASRV: MachOp = 36;

pub val UBFX:  MachOp = 37;
pub val UBFIZ: MachOp = 38;
pub val SBFX:  MachOp = 39;
pub val SBFIZ: MachOp = 40;
pub val UXTB:  MachOp = 41;
pub val UXTH:  MachOp = 42;
pub val SXTB:  MachOp = 43;
pub val SXTH:  MachOp = 44;
pub val SXTW:  MachOp = 45;

pub val CSET: MachOp = 46;
pub val ADRP: MachOp = 47;

pub val B:     MachOp = 48;
pub val BCOND: MachOp = 49;
pub val BL:    MachOp = 50;
pub val BLR:   MachOp = 51;
pub val BR:    MachOp = 52;
pub val CBZ:   MachOp = 53;
pub val CBNZ:  MachOp = 54;

pub val LDR:   MachOp = 55;
pub val STR:   MachOp = 56;
pub val LDRB:  MachOp = 57;
pub val STRB:  MachOp = 58;
pub val LDRH:  MachOp = 59;
pub val STRH:  MachOp = 60;
pub val LDUR:  MachOp = 61;
pub val STUR:  MachOp = 62;
pub val LDURB: MachOp = 63;
pub val STURB: MachOp = 64;
pub val LDURH: MachOp = 65;
pub val STURH: MachOp = 66;
pub val LDP:   MachOp = 67;
pub val STP:   MachOp = 68;
pub val LDAR:  MachOp = 69;
pub val STLR:  MachOp = 70;
pub val LDAXR: MachOp = 71;
pub val STLXR: MachOp = 72;
pub val DMB:   MachOp = 73;
pub val MSR:   MachOp = 74;
pub val MRS:   MachOp = 75;

pub val FADD:   MachOp = 76;
pub val FSUB:   MachOp = 77;
pub val FMUL:   MachOp = 78;
pub val FDIV:   MachOp = 79;
pub val FNEG:   MachOp = 80;
pub val FMOV:   MachOp = 81;
pub val FCVT:   MachOp = 82;
pub val FCMP:   MachOp = 83;
pub val SCVTF:  MachOp = 84;
pub val UCVTF:  MachOp = 85;
pub val FCVTZS: MachOp = 86;
pub val FCVTZU: MachOp = 87;

pub val V_FADD:  MachOp = 88;
pub val V_FSUB:  MachOp = 89;
pub val V_FMUL:  MachOp = 90;
pub val V_FDIV:  MachOp = 91;
pub val V_ADD:   MachOp = 92;
pub val V_SUB:   MachOp = 93;
pub val V_MUL:   MachOp = 94;
pub val V_AND:   MachOp = 95;
pub val V_ORR:   MachOp = 96;
pub val V_EOR:   MachOp = 97;
pub val V_MVN:   MachOp = 98;
pub val V_MOV:   MachOp = 99;
pub val V_CMEQ:  MachOp = 100;
pub val V_CMGT:  MachOp = 101;
pub val V_CMGE:  MachOp = 102;
pub val V_CMHI:  MachOp = 103;
pub val V_CMHS:  MachOp = 104;
pub val V_FCMEQ: MachOp = 105;
pub val V_FCMGT: MachOp = 106;
pub val V_FCMGE: MachOp = 107;

# lane moves: `umov` for a sub-word lane read, the `mov` alias for a word or
# doubleword lane read, `mov` for every lane insert and the scalar dup
pub val UMOV:     MachOp = 108;
pub val MOV_LANE: MachOp = 109;
pub val INS:      MachOp = 110;
pub val DUP:      MachOp = 111;

pub val MOP_LAST: MachOp = DUP;

pub fun known(op: MachOp) bool {
    ret op != MOP_NONE && op <= MOP_LAST;
}

# the assembler spelling the printer renders; absent outside the catalog
pub fun mnemonic(op: MachOp) opt[str] {
    if (op == NOP)   { ret opt[str].some{"nop"}; }
    if (op == YIELD) { ret opt[str].some{"yield"}; }
    if (op == WFE)   { ret opt[str].some{"wfe"}; }
    if (op == WFI)   { ret opt[str].some{"wfi"}; }
    if (op == RET)   { ret opt[str].some{"ret"}; }
    if (op == SVC)   { ret opt[str].some{"svc"}; }
    if (op == BRK)   { ret opt[str].some{"brk"}; }
    if (op == HVC)   { ret opt[str].some{"hvc"}; }
    if (op == SMC)   { ret opt[str].some{"smc"}; }

    if (op == MOV)  { ret opt[str].some{"mov"}; }
    if (op == MOVZ) { ret opt[str].some{"movz"}; }
    if (op == MOVK) { ret opt[str].some{"movk"}; }
    if (op == MVN)  { ret opt[str].some{"mvn"}; }
    if (op == NEG)  { ret opt[str].some{"neg"}; }

    if (op == ADD)  { ret opt[str].some{"add"}; }
    if (op == ADDS) { ret opt[str].some{"adds"}; }
    if (op == SUB)  { ret opt[str].some{"sub"}; }
    if (op == SUBS) { ret opt[str].some{"subs"}; }
    if (op == CMP)  { ret opt[str].some{"cmp"}; }
    if (op == CMN)  { ret opt[str].some{"cmn"}; }
    if (op == AND)  { ret opt[str].some{"and"}; }
    if (op == ORR)  { ret opt[str].some{"orr"}; }
    if (op == ORN)  { ret opt[str].some{"orn"}; }
    if (op == EOR)  { ret opt[str].some{"eor"}; }

    if (op == MUL)  { ret opt[str].some{"mul"}; }
    if (op == MNEG) { ret opt[str].some{"mneg"}; }
    if (op == MADD) { ret opt[str].some{"madd"}; }
    if (op == MSUB) { ret opt[str].some{"msub"}; }
    if (op == SDIV) { ret opt[str].some{"sdiv"}; }
    if (op == UDIV) { ret opt[str].some{"udiv"}; }

    if (op == LSL || op == LSLV) { ret opt[str].some{"lsl"}; }
    if (op == LSR || op == LSRV) { ret opt[str].some{"lsr"}; }
    if (op == ASR || op == ASRV) { ret opt[str].some{"asr"}; }

    if (op == UBFX)  { ret opt[str].some{"ubfx"}; }
    if (op == UBFIZ) { ret opt[str].some{"ubfiz"}; }
    if (op == SBFX)  { ret opt[str].some{"sbfx"}; }
    if (op == SBFIZ) { ret opt[str].some{"sbfiz"}; }
    if (op == UXTB)  { ret opt[str].some{"uxtb"}; }
    if (op == UXTH)  { ret opt[str].some{"uxth"}; }
    if (op == SXTB)  { ret opt[str].some{"sxtb"}; }
    if (op == SXTH)  { ret opt[str].some{"sxth"}; }
    if (op == SXTW)  { ret opt[str].some{"sxtw"}; }

    if (op == CSET) { ret opt[str].some{"cset"}; }
    if (op == ADRP) { ret opt[str].some{"adrp"}; }

    if (op == B)     { ret opt[str].some{"b"}; }
    if (op == BCOND) { ret opt[str].some{"b."}; }
    if (op == BL)    { ret opt[str].some{"bl"}; }
    if (op == BLR)   { ret opt[str].some{"blr"}; }
    if (op == BR)    { ret opt[str].some{"br"}; }
    if (op == CBZ)   { ret opt[str].some{"cbz"}; }
    if (op == CBNZ)  { ret opt[str].some{"cbnz"}; }

    if (op == LDR)   { ret opt[str].some{"ldr"}; }
    if (op == STR)   { ret opt[str].some{"str"}; }
    if (op == LDRB)  { ret opt[str].some{"ldrb"}; }
    if (op == STRB)  { ret opt[str].some{"strb"}; }
    if (op == LDRH)  { ret opt[str].some{"ldrh"}; }
    if (op == STRH)  { ret opt[str].some{"strh"}; }
    if (op == LDUR)  { ret opt[str].some{"ldur"}; }
    if (op == STUR)  { ret opt[str].some{"stur"}; }
    if (op == LDURB) { ret opt[str].some{"ldurb"}; }
    if (op == STURB) { ret opt[str].some{"sturb"}; }
    if (op == LDURH) { ret opt[str].some{"ldurh"}; }
    if (op == STURH) { ret opt[str].some{"sturh"}; }
    if (op == LDP)   { ret opt[str].some{"ldp"}; }
    if (op == STP)   { ret opt[str].some{"stp"}; }
    if (op == LDAR)  { ret opt[str].some{"ldar"}; }
    if (op == STLR)  { ret opt[str].some{"stlr"}; }
    if (op == LDAXR) { ret opt[str].some{"ldaxr"}; }
    if (op == STLXR) { ret opt[str].some{"stlxr"}; }
    if (op == DMB)   { ret opt[str].some{"dmb"}; }
    if (op == MSR)   { ret opt[str].some{"msr"}; }
    if (op == MRS)   { ret opt[str].some{"mrs"}; }

    if (op == FADD)   { ret opt[str].some{"fadd"}; }
    if (op == FSUB)   { ret opt[str].some{"fsub"}; }
    if (op == FMUL)   { ret opt[str].some{"fmul"}; }
    if (op == FDIV)   { ret opt[str].some{"fdiv"}; }
    if (op == FNEG)   { ret opt[str].some{"fneg"}; }
    if (op == FMOV)   { ret opt[str].some{"fmov"}; }
    if (op == FCVT)   { ret opt[str].some{"fcvt"}; }
    if (op == FCMP)   { ret opt[str].some{"fcmp"}; }
    if (op == SCVTF)  { ret opt[str].some{"scvtf"}; }
    if (op == UCVTF)  { ret opt[str].some{"ucvtf"}; }
    if (op == FCVTZS) { ret opt[str].some{"fcvtzs"}; }
    if (op == FCVTZU) { ret opt[str].some{"fcvtzu"}; }

    if (op == V_FADD)  { ret opt[str].some{"fadd"}; }
    if (op == V_FSUB)  { ret opt[str].some{"fsub"}; }
    if (op == V_FMUL)  { ret opt[str].some{"fmul"}; }
    if (op == V_FDIV)  { ret opt[str].some{"fdiv"}; }
    if (op == V_ADD)   { ret opt[str].some{"add"}; }
    if (op == V_SUB)   { ret opt[str].some{"sub"}; }
    if (op == V_MUL)   { ret opt[str].some{"mul"}; }
    if (op == V_AND)   { ret opt[str].some{"and"}; }
    if (op == V_ORR)   { ret opt[str].some{"orr"}; }
    if (op == V_EOR)   { ret opt[str].some{"eor"}; }
    if (op == V_MVN)   { ret opt[str].some{"mvn"}; }
    if (op == V_MOV)   { ret opt[str].some{"mov"}; }
    if (op == V_CMEQ)  { ret opt[str].some{"cmeq"}; }
    if (op == V_CMGT)  { ret opt[str].some{"cmgt"}; }
    if (op == V_CMGE)  { ret opt[str].some{"cmge"}; }
    if (op == V_CMHI)  { ret opt[str].some{"cmhi"}; }
    if (op == V_CMHS)  { ret opt[str].some{"cmhs"}; }
    if (op == V_FCMEQ) { ret opt[str].some{"fcmeq"}; }
    if (op == V_FCMGT) { ret opt[str].some{"fcmgt"}; }
    if (op == V_FCMGE) { ret opt[str].some{"fcmge"}; }

    if (op == UMOV)     { ret opt[str].some{"umov"}; }
    if (op == MOV_LANE) { ret opt[str].some{"mov"}; }
    if (op == INS)      { ret opt[str].some{"mov"}; }
    if (op == DUP)      { ret opt[str].some{"mov"}; }
    ret opt[str].none{};
}

# `isa.Inst.flags` layout for an aarch64 notification
pub val FLAG_COND:    u16 = 0x000F;
pub val FLAG_WB_PRE:  u16 = 0x0010;
pub val FLAG_WB_POST: u16 = 0x0020;
pub val FLAG_ELEM:    u16 = 0x0F00;
val FLAG_ELEM_SHIFT:  u16 = 8;
# the branch target in src2 is a block of the function (a block label);
# without it a src2 label is an offset inside the same expansion
pub val FLAG_TARGET_BLOCK: u16 = 0x0040;

pub fun cond_of(flags: u16) u32 {
    ret (flags & FLAG_COND)::u32;
}

# the vector element width in bytes, 0 for a scalar instruction
pub fun elem_bytes(flags: u16) u8 {
    ret ((flags & FLAG_ELEM) >> FLAG_ELEM_SHIFT)::u8;
}

pub fun with_elem_bytes(flags: u16, eb: u8) u16 {
    ret (flags & ~FLAG_ELEM) | ((eb::u16 << FLAG_ELEM_SHIFT) & FLAG_ELEM);
}

test "mach.lang.target.isa.arm64.inst.mnemonic:every_member_is_named_and_the_catalog_is_closed" {
    # the status carries the op: 1..127 unnamed, 128..254 unknown
    if (MOP_LAST::i32 > 127) { ret 255; }
    var op: MachOp = 1;
    for (op <= MOP_LAST) {
        val named: opt[str] = mnemonic(op);
        if (sel named.none) { ret op::i32; }
        if (!known(op))     { ret 128 + op::i32; }
        op = op + 1;
    }
    val none_named: opt[str] = mnemonic(MOP_NONE);
    if (sel none_named.some) { ret 251; }
    val past_named: opt[str] = mnemonic(MOP_LAST + 1);
    if (sel past_named.some) { ret 252; }
    if (known(MOP_NONE) || known(MOP_LAST + 1)) { ret 253; }
    ret 0;
}

test "mach.lang.target.isa.arm64.inst.flags:element_width_shares_the_word_with_condition_and_writeback" {
    val f: u16 = with_elem_bytes(FLAG_WB_PRE | 0x3, 8);
    if (elem_bytes(f) != 8)            { ret 1; }
    if (cond_of(f) != 3)               { ret 2; }
    if ((f & FLAG_WB_PRE) == 0)        { ret 3; }
    if (elem_bytes(with_elem_bytes(f, 0)) != 0) { ret 4; }
    if (elem_bytes(0) != 0)            { ret 5; }
    ret 0;
}

fun t_spelled(op: MachOp, want: str) bool {
    val named: opt[str] = mnemonic(op);
    if (sel named.none) { ret false; }
    ret str_equals(named.some, want);
}

# the spelling of every member, pinned against the assembler's own: the
# printer and the notification share one table, so this is the only reader
# that can catch a member renamed to another instruction's mnemonic
test "mach.lang.target.isa.arm64.inst.mnemonic:spellings_are_the_assembler_mnemonics" {
    if (!t_spelled(NOP, "nop")) { ret 1; }
    if (!t_spelled(YIELD, "yield")) { ret 2; }
    if (!t_spelled(WFE, "wfe")) { ret 3; }
    if (!t_spelled(WFI, "wfi")) { ret 4; }
    if (!t_spelled(RET, "ret")) { ret 5; }
    if (!t_spelled(SVC, "svc")) { ret 6; }
    if (!t_spelled(BRK, "brk")) { ret 7; }
    if (!t_spelled(HVC, "hvc")) { ret 8; }
    if (!t_spelled(SMC, "smc")) { ret 9; }
    if (!t_spelled(MOV, "mov")) { ret 10; }
    if (!t_spelled(MOVZ, "movz")) { ret 11; }
    if (!t_spelled(MOVK, "movk")) { ret 12; }
    if (!t_spelled(MVN, "mvn")) { ret 13; }
    if (!t_spelled(NEG, "neg")) { ret 14; }
    if (!t_spelled(ADD, "add")) { ret 15; }
    if (!t_spelled(ADDS, "adds")) { ret 16; }
    if (!t_spelled(SUB, "sub")) { ret 17; }
    if (!t_spelled(SUBS, "subs")) { ret 18; }
    if (!t_spelled(CMP, "cmp")) { ret 19; }
    if (!t_spelled(CMN, "cmn")) { ret 20; }
    if (!t_spelled(AND, "and")) { ret 21; }
    if (!t_spelled(ORR, "orr")) { ret 22; }
    if (!t_spelled(ORN, "orn")) { ret 23; }
    if (!t_spelled(EOR, "eor")) { ret 24; }
    if (!t_spelled(MUL, "mul")) { ret 25; }
    if (!t_spelled(MNEG, "mneg")) { ret 26; }
    if (!t_spelled(MADD, "madd")) { ret 27; }
    if (!t_spelled(MSUB, "msub")) { ret 28; }
    if (!t_spelled(SDIV, "sdiv")) { ret 29; }
    if (!t_spelled(UDIV, "udiv")) { ret 30; }
    if (!t_spelled(LSL, "lsl")) { ret 31; }
    if (!t_spelled(LSLV, "lsl")) { ret 32; }
    if (!t_spelled(LSR, "lsr")) { ret 33; }
    if (!t_spelled(LSRV, "lsr")) { ret 34; }
    if (!t_spelled(ASR, "asr")) { ret 35; }
    if (!t_spelled(ASRV, "asr")) { ret 36; }
    if (!t_spelled(UBFX, "ubfx")) { ret 37; }
    if (!t_spelled(UBFIZ, "ubfiz")) { ret 38; }
    if (!t_spelled(SBFX, "sbfx")) { ret 39; }
    if (!t_spelled(SBFIZ, "sbfiz")) { ret 40; }
    if (!t_spelled(UXTB, "uxtb")) { ret 41; }
    if (!t_spelled(UXTH, "uxth")) { ret 42; }
    if (!t_spelled(SXTB, "sxtb")) { ret 43; }
    if (!t_spelled(SXTH, "sxth")) { ret 44; }
    if (!t_spelled(SXTW, "sxtw")) { ret 45; }
    if (!t_spelled(CSET, "cset")) { ret 46; }
    if (!t_spelled(ADRP, "adrp")) { ret 47; }
    if (!t_spelled(B, "b")) { ret 48; }
    if (!t_spelled(BCOND, "b.")) { ret 49; }
    if (!t_spelled(BL, "bl")) { ret 50; }
    if (!t_spelled(BLR, "blr")) { ret 51; }
    if (!t_spelled(BR, "br")) { ret 52; }
    if (!t_spelled(CBZ, "cbz")) { ret 53; }
    if (!t_spelled(CBNZ, "cbnz")) { ret 54; }
    if (!t_spelled(LDR, "ldr")) { ret 55; }
    if (!t_spelled(STR, "str")) { ret 56; }
    if (!t_spelled(LDRB, "ldrb")) { ret 57; }
