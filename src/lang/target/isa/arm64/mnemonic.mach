# the inline assembly mnemonic rows: each spelling, its operand pattern and the registers it clobbers
use std.types.size.usize;

use extension_arm64: mach.lang.target.extension.arm64;
use arm64_inst:      mach.lang.target.isa.arm64.inst;
use isa_asm:         mach.lang.target.isa.asm;

pub val PATTERN_NULLARY: u16 = 1;

pub val PATTERN_RET_REG: u16 = 2;

pub val PATTERN_IMM16: u16 = 3;

pub val PATTERN_MOV: u16 = 4;

pub val PATTERN_MOVEWIDE: u16 = 5;

pub val PATTERN_ADDSUB: u16 = 6;

pub val PATTERN_LOGICAL: u16 = 7;

pub val PATTERN_CMP: u16 = 8;

pub val PATTERN_CSET: u16 = 9;

pub val PATTERN_ADRP: u16 = 10;

pub val PATTERN_BL: u16 = 11;

pub val PATTERN_BR_REG: u16 = 12;

pub val PATTERN_B: u16 = 13;

pub val PATTERN_BCOND: u16 = 14;

pub val PATTERN_CBR: u16 = 15;

pub val PATTERN_LDST: u16 = 16;

pub val PATTERN_LDSTP: u16 = 17;

pub val PATTERN_DMB: u16 = 18;

pub val PATTERN_LDORD: u16 = 19;

pub val PATTERN_STLXR: u16 = 20;

pub val PATTERN_SHIFT: u16 = 21;

pub val PATTERN_MSR: u16 = 22;

pub val PATTERN_MRS: u16 = 23;

pub val PATTERN_V3: u16 = 24;

pub val PATTERN_V2: u16 = 25;

pub val PATTERN_VELEM: u16 = 26;

# the fixed-arrangement crypto rows (sha2, aes, pmull): the operands the
# member's mop.CRYPTO_ROWS entry names
pub val PATTERN_VCRYPTO: u16 = 27;

# isb: bare, or the one option `sy` the architecture defines
pub val PATTERN_ISB: u16 = 28;

# the high multiplies: three x registers, no w form
pub val PATTERN_MULH: u16 = 29;

# rev: two general registers of one width
pub val PATTERN_REV: u16 = 30;

# ext: three .16b registers and the first byte, 0 to 15
pub val PATTERN_VEXT: u16 = 31;

# dup: a vector at an arrangement from one lane of that width or a general register
pub val PATTERN_VDUP: u16 = 32;

# ins, and the mov spelling of it: one lane from a lane of that width or a general register
pub val PATTERN_VINS: u16 = 33;

pub val COND_SHIFT: u16 = 8;

pub val COND_MASK: u16 = 0x0F00;

pub val CALLER_SAVED: u32 = 0x4007FFFF;

pub val SMCCC_CLOBBER: u32 = 0x0003FFFF;

val LR_READ: u32 = 0x40000000;

pub val ROW_COUNT: usize = 86;

pub val ROWS: [ROW_COUNT]isa_asm.Mnemonic = [ROW_COUNT]isa_asm.Mnemonic{
    isa_asm.Mnemonic{name: "nop", code: arm64_inst.NOP::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NULLARY, words: 1},
    isa_asm.Mnemonic{name: "yield", code: arm64_inst.YIELD::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NULLARY, words: 1},
    isa_asm.Mnemonic{name: "ret", code: arm64_inst.RET::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: LR_READ, flags: PATTERN_NULLARY, words: 1},
    isa_asm.Mnemonic{name: "ret", code: arm64_inst.RET::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_RET_REG, words: 1},

    isa_asm.Mnemonic{name: "wfi", code: arm64_inst.WFI::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NULLARY, words: 1},
    isa_asm.Mnemonic{name: "wfe", code: arm64_inst.WFE::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NULLARY, words: 1},

    isa_asm.Mnemonic{name: "svc", code: arm64_inst.SVC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 1, flags: PATTERN_IMM16, words: 1},
    isa_asm.Mnemonic{name: "brk", code: arm64_inst.BRK::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_IMM16, words: 1},
    isa_asm.Mnemonic{name: "hvc", code: arm64_inst.HVC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: SMCCC_CLOBBER, flags: PATTERN_IMM16, words: 1},
    isa_asm.Mnemonic{name: "smc", code: arm64_inst.SMC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: SMCCC_CLOBBER, flags: PATTERN_IMM16, words: 1},

    isa_asm.Mnemonic{name: "movz", code: arm64_inst.MOVZ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MOVEWIDE, words: 1},
    isa_asm.Mnemonic{name: "movk", code: arm64_inst.MOVK::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MOVEWIDE, words: 1},
    isa_asm.Mnemonic{name: "movn", code: arm64_inst.MOVN::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MOVEWIDE, words: 1},
    isa_asm.Mnemonic{name: "mov", code: arm64_inst.MOV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MOV, words: isa_asm.WORDS_VARIABLE},
    isa_asm.Mnemonic{name: "add", code: arm64_inst.ADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ADDSUB, words: 1},
    isa_asm.Mnemonic{name: "sub", code: arm64_inst.SUB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ADDSUB, words: 1},
    isa_asm.Mnemonic{name: "and", code: arm64_inst.AND::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOGICAL, words: 1},
    isa_asm.Mnemonic{name: "orr", code: arm64_inst.ORR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOGICAL, words: 1},
    isa_asm.Mnemonic{name: "eor", code: arm64_inst.EOR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LOGICAL, words: 1},
    isa_asm.Mnemonic{name: "cset", code: arm64_inst.CSET::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_CSET, words: 1},
    isa_asm.Mnemonic{name: "adrp", code: arm64_inst.ADRP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ADRP, words: 1},

    isa_asm.Mnemonic{name: "cmp", code: arm64_inst.CMP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_CMP, words: 1},

    isa_asm.Mnemonic{name: "blr", code: arm64_inst.BLR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: CALLER_SAVED, flags: PATTERN_BR_REG, words: 1},
    isa_asm.Mnemonic{name: "bl", code: arm64_inst.BL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: CALLER_SAVED, flags: PATTERN_BL, words: 1},
    isa_asm.Mnemonic{name: "br", code: arm64_inst.BR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: CALLER_SAVED, flags: PATTERN_BR_REG, words: 1},
    isa_asm.Mnemonic{name: "b", code: arm64_inst.B::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_B, words: 1},
    isa_asm.Mnemonic{name: "cbz", code: arm64_inst.CBZ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_CBR, words: 1},
    isa_asm.Mnemonic{name: "cbnz", code: arm64_inst.CBNZ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_CBR, words: 1},

    isa_asm.Mnemonic{name: "ldrb", code: arm64_inst.LDRB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LDST, words: 1},
    isa_asm.Mnemonic{name: "strb", code: arm64_inst.STRB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_LDST, words: 1},
    isa_asm.Mnemonic{name: "ldrh", code: arm64_inst.LDRH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LDST, words: 1},
    isa_asm.Mnemonic{name: "strh", code: arm64_inst.STRH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_LDST, words: 1},
    isa_asm.Mnemonic{name: "ldr", code: arm64_inst.LDR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LDST, words: 1},
    isa_asm.Mnemonic{name: "str", code: arm64_inst.STR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_LDST, words: 1},

    isa_asm.Mnemonic{name: "ldp", code: arm64_inst.LDP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0 | isa_asm.AW_OP1 | isa_asm.AW_WB_BASE, implicit: 0, flags: PATTERN_LDSTP, words: 1},
    isa_asm.Mnemonic{name: "stp", code: arm64_inst.STP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_WB_BASE, implicit: 0, flags: PATTERN_LDSTP, words: 1},

    isa_asm.Mnemonic{name: "ldaxr", code: arm64_inst.LDAXR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LDORD, words: 1},
    isa_asm.Mnemonic{name: "ldar", code: arm64_inst.LDAR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_LDORD, words: 1},
    isa_asm.Mnemonic{name: "stlxr", code: arm64_inst.STLXR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_STLXR, words: 1},
    isa_asm.Mnemonic{name: "stlr", code: arm64_inst.STLR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_LDORD, words: 1},
    isa_asm.Mnemonic{name: "dmb", code: arm64_inst.DMB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_DMB, words: 1},
    isa_asm.Mnemonic{name: "dsb", code: arm64_inst.DSB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_DMB, words: 1},
    isa_asm.Mnemonic{name: "isb", code: arm64_inst.ISB::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_ISB, words: 1},
    isa_asm.Mnemonic{name: "isb", code: arm64_inst.ISB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_ISB, words: 1},
    isa_asm.Mnemonic{name: "sb", code: arm64_inst.SB::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NULLARY, words: 1, requires: extension_arm64.SB},

    isa_asm.Mnemonic{name: "lslv", code: arm64_inst.LSLV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "lsrv", code: arm64_inst.LSRV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "asrv", code: arm64_inst.ASRV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "umulh", code: arm64_inst.UMULH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MULH, words: 1},
    isa_asm.Mnemonic{name: "smulh", code: arm64_inst.SMULH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MULH, words: 1},

    isa_asm.Mnemonic{name: "msr", code: arm64_inst.MSR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_MSR, words: 1},
    isa_asm.Mnemonic{name: "mrs", code: arm64_inst.MRS::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_MRS, words: 1},
    isa_asm.Mnemonic{name: "lsl", code: arm64_inst.LSL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "lsr", code: arm64_inst.LSR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},
    isa_asm.Mnemonic{name: "asr", code: arm64_inst.ASR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_SHIFT, words: 1},

    isa_asm.Mnemonic{name: "mvn", code: arm64_inst.V_MVN::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V2, words: 1},
    isa_asm.Mnemonic{name: "cmeq", code: arm64_inst.V_CMEQ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "cmgt", code: arm64_inst.V_CMGT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "cmge", code: arm64_inst.V_CMGE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "cmhi", code: arm64_inst.V_CMHI::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "cmhs", code: arm64_inst.V_CMHS::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "mul", code: arm64_inst.V_MUL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fadd", code: arm64_inst.V_FADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fsub", code: arm64_inst.V_FSUB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fmul", code: arm64_inst.V_FMUL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fdiv", code: arm64_inst.V_FDIV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fcmeq", code: arm64_inst.V_FCMEQ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fcmgt", code: arm64_inst.V_FCMGT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "fcmge", code: arm64_inst.V_FCMGE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "ld1", code: arm64_inst.LD1::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0 | isa_asm.AW_WB_BASE, implicit: 0, flags: PATTERN_VELEM, words: 1},
    isa_asm.Mnemonic{name: "st1", code: arm64_inst.ST1::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_WB_BASE, implicit: 0, flags: PATTERN_VELEM, words: 1},
    isa_asm.Mnemonic{name: "sha256h", code: arm64_inst.SHA256H::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.SHA2},
    isa_asm.Mnemonic{name: "sha256h2", code: arm64_inst.SHA256H2::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.SHA2},
    isa_asm.Mnemonic{name: "sha256su0", code: arm64_inst.SHA256SU0::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.SHA2},
    isa_asm.Mnemonic{name: "sha256su1", code: arm64_inst.SHA256SU1::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.SHA2},
    isa_asm.Mnemonic{name: "aese", code: arm64_inst.AESE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.AES},
    isa_asm.Mnemonic{name: "aesd", code: arm64_inst.AESD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.AES},
    isa_asm.Mnemonic{name: "aesmc", code: arm64_inst.AESMC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.AES},
    isa_asm.Mnemonic{name: "aesimc", code: arm64_inst.AESIMC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.AES},
    isa_asm.Mnemonic{name: "pmull", code: arm64_inst.PMULL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.PMULL},
    isa_asm.Mnemonic{name: "pmull2", code: arm64_inst.PMULL2::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VCRYPTO, words: 1, requires: extension_arm64.PMULL},
    isa_asm.Mnemonic{name: "rev", code: arm64_inst.REV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_REV, words: 1},
    isa_asm.Mnemonic{name: "rev64", code: arm64_inst.V_REV64::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V2, words: 1},
    isa_asm.Mnemonic{name: "ext", code: arm64_inst.V_EXT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEXT, words: 1},
    isa_asm.Mnemonic{name: "dup", code: arm64_inst.V_DUP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VDUP, words: 1},
    isa_asm.Mnemonic{name: "ins", code: arm64_inst.INS::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VINS, words: 1},
};

# the vector members that share a spelling with a general-purpose row; vector operands select them
pub val VEC_TWIN_COUNT: usize = 6;

pub val VEC_TWINS: [VEC_TWIN_COUNT]isa_asm.Mnemonic = [VEC_TWIN_COUNT]isa_asm.Mnemonic{
    isa_asm.Mnemonic{name: "add", code: arm64_inst.V_ADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "sub", code: arm64_inst.V_SUB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "and", code: arm64_inst.V_AND::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "orr", code: arm64_inst.V_ORR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "eor", code: arm64_inst.V_EOR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V3, words: 1},
    isa_asm.Mnemonic{name: "mov", code: arm64_inst.V_MOV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_V2, words: 1},
};

pub fun pattern(flags: u16) u16 {
    ret flags & 0x00FF;
}

pub fun cond(flags: u16) u32 {
    ret ((flags & COND_MASK) >> COND_SHIFT)::u32;
}
