# what each arm64 instruction reads, writes and leaks, for the constant-time checks
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use mach.lang.ct;
use arm64_emit:     mach.lang.target.isa.arm64.emit;
use arm64_inst:     mach.lang.target.isa.arm64.inst;
use arm64_mnemonic: mach.lang.target.isa.arm64.mnemonic;
use isa_asm:        mach.lang.target.isa.asm;
#[testing]
use mach.lang.target.isa.ctwalk;
use isa_effect: mach.lang.target.isa.effect;
use isa_inst:   mach.lang.target.isa.inst;

pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code == arm64_inst.MOV::u32 || code == arm64_inst.MOVZ::u32 || code == arm64_inst.MOVK::u32 || code == arm64_inst.MOVN::u32 ||
        code == arm64_inst.ADRP::u32 || code == arm64_inst.LDR::u32 || code == arm64_inst.STR::u32 ||
        code == arm64_inst.LDRB::u32 || code == arm64_inst.STRB::u32 || code == arm64_inst.LDRH::u32 ||
        code == arm64_inst.STRH::u32 || code == arm64_inst.LDP::u32 || code == arm64_inst.STP::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.ADD::u32 || code == arm64_inst.SUB::u32 || code == arm64_inst.AND::u32 ||
        code == arm64_inst.ORR::u32 || code == arm64_inst.EOR::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.CMP::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.CSET::u32) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.LSL::u32 || code == arm64_inst.LSR::u32 || code == arm64_inst.ASR::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.LSLV::u32 || code == arm64_inst.LSRV::u32 || code == arm64_inst.ASRV::u32 ||
        code == arm64_inst.V_USHL::u32 || code == arm64_inst.V_SSHL::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_VAR_SHIFT));
    }
    if (code == arm64_inst.LDAXR::u32 || code == arm64_inst.LDAR::u32 || code == arm64_inst.STLXR::u32 ||
        code == arm64_inst.STLR::u32 || code == arm64_inst.DMB::u32 || code == arm64_inst.YIELD::u32 ||
        code == arm64_inst.DSB::u32 || code == arm64_inst.ISB::u32 || code == arm64_inst.SB::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (arm64_mnemonic.pattern(flags) == arm64_mnemonic.PATTERN_BCOND) { ret ct.asm_branch_flags(); }

    if (code == arm64_inst.B::u32 || code == arm64_inst.BL::u32 || code == arm64_inst.SVC::u32 || code == arm64_inst.BRK::u32 ||
        code == arm64_inst.NOP::u32 || code == arm64_inst.MSR::u32 ||
        code == arm64_inst.HVC::u32 || code == arm64_inst.SMC::u32 || code == arm64_inst.WFI::u32 || code == arm64_inst.WFE::u32) {
        ret ct.asm_op(ct.CT_OP_NONE);
    }
    if (code == arm64_inst.MRS::u32) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.CBZ::u32 || code == arm64_inst.CBNZ::u32 || code == arm64_inst.BLR::u32 ||
        code == arm64_inst.BR::u32 || code == arm64_inst.RET::u32) {
        ret ct.asm_branch_reg();
    }

    # rows for the opcodes the encoder emits that the inline-asm grammar has
    # no spelling for: the same closed table, extended, not paralleled
    if (code == arm64_inst.BCOND::u32) { ret ct.asm_branch_flags(); }
    if (code == arm64_inst.CSETM::u32) { ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE)); }
    if (code == arm64_inst.CSEL::u32)  { ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE)); }
    if (code == arm64_inst.ADDS::u32 || code == arm64_inst.SUBS::u32 || code == arm64_inst.CMN::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.MUL::u32 || code == arm64_inst.MNEG::u32 || code == arm64_inst.MADD::u32 || code == arm64_inst.MSUB::u32) {
        ret ct.flags_untouched(ct.asm_mul(ct.CT_MUL_LOW));
    }
    if (code == arm64_inst.UMULH::u32) { ret ct.flags_untouched(ct.asm_mul(ct.CT_MUL_HIGH_U)); }
    if (code == arm64_inst.SMULH::u32) { ret ct.flags_untouched(ct.asm_mul(ct.CT_MUL_HIGH_S)); }
    if (code == arm64_inst.V_MUL::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_LOW, arm64_inst.elem_bytes(flags) * 8));
    }
    if (code == arm64_inst.V_SMULL::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_WIDE_S, arm64_inst.elem_bytes(flags) * 8));
    }
    if (code == arm64_inst.V_UMULL::u32 || code == arm64_inst.V_UMULL2::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_WIDE_U, arm64_inst.elem_bytes(flags) * 8));
    }
    if (code == arm64_inst.V_SMULL2::u32) {
        ret ct.flags_untouched(ct.asm_mul_lanes(ct.CT_MUL_WIDE_S, arm64_inst.elem_bytes(flags) * 8));
    }
    if (code == arm64_inst.SDIV::u32 || code == arm64_inst.UDIV::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_INT_DIVMOD));
    }
    if (code == arm64_inst.MVN::u32 || code == arm64_inst.NEG::u32 || code == arm64_inst.ORN::u32 ||
        code == arm64_inst.UBFX::u32 || code == arm64_inst.UBFIZ::u32 || code == arm64_inst.SBFX::u32 || code == arm64_inst.SBFIZ::u32 ||
        code == arm64_inst.UXTB::u32 || code == arm64_inst.UXTH::u32 || code == arm64_inst.SXTB::u32 || code == arm64_inst.SXTH::u32 ||
        code == arm64_inst.SXTW::u32 ||
        code == arm64_inst.LDUR::u32 || code == arm64_inst.STUR::u32 || code == arm64_inst.LDURB::u32 || code == arm64_inst.STURB::u32 ||
        code == arm64_inst.LDURH::u32 || code == arm64_inst.STURH::u32 ||
        code == arm64_inst.FMOV::u32 || code == arm64_inst.FMOV_GEN::u32 || code == arm64_inst.FMOV_IMM::u32 ||
        code == arm64_inst.V_ADD::u32 || code == arm64_inst.V_SUB::u32 || code == arm64_inst.V_AND::u32 || code == arm64_inst.V_ORR::u32 ||
        code == arm64_inst.V_EOR::u32 || code == arm64_inst.V_MVN::u32 || code == arm64_inst.V_MOV::u32 ||
        code == arm64_inst.V_CMEQ::u32 || code == arm64_inst.V_CMGT::u32 || code == arm64_inst.V_CMGE::u32 ||
        code == arm64_inst.V_CMHI::u32 || code == arm64_inst.V_CMHS::u32 ||
        code == arm64_inst.UMOV::u32 || code == arm64_inst.MOV_LANE::u32 || code == arm64_inst.INS::u32 || code == arm64_inst.DUP::u32 ||
        code == arm64_inst.INS_EL::u32 ||
        code == arm64_inst.V_SXTL::u32 || code == arm64_inst.V_UXTL::u32 || code == arm64_inst.V_SXTL2::u32 || code == arm64_inst.V_UXTL2::u32 ||
        code == arm64_inst.V_XTN::u32 ||
        code == arm64_inst.V_SQXTN::u32 || code == arm64_inst.V_UQXTN::u32 || code == arm64_inst.LD1::u32 || code == arm64_inst.ST1::u32 ||
        code == arm64_inst.SHA256H::u32 || code == arm64_inst.SHA256H2::u32 || code == arm64_inst.SHA256SU0::u32 || code == arm64_inst.SHA256SU1::u32 ||
        code == arm64_inst.AESE::u32 || code == arm64_inst.AESD::u32 || code == arm64_inst.AESMC::u32 || code == arm64_inst.AESIMC::u32 ||
        code == arm64_inst.PMULL::u32 || code == arm64_inst.PMULL2::u32 || code == arm64_inst.V_EXT::u32 ||
        code == arm64_inst.V_NEG::u32 || code == arm64_inst.V_SHL::u32 || code == arm64_inst.V_USHR::u32 || code == arm64_inst.V_SSHR::u32 ||
        code == arm64_inst.V_UQSHL::u32 || code == arm64_inst.DUP_GEN::u32 ||
        code == arm64_inst.REV::u32 || code == arm64_inst.V_REV64::u32 || code == arm64_inst.V_DUP::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == arm64_inst.FADD::u32 || code == arm64_inst.FSUB::u32 || code == arm64_inst.FMUL::u32 || code == arm64_inst.FDIV::u32 ||
        code == arm64_inst.FNEG::u32 || code == arm64_inst.FCVT::u32 || code == arm64_inst.SCVTF::u32 || code == arm64_inst.UCVTF::u32 ||
        code == arm64_inst.FCVTZS::u32 || code == arm64_inst.FCVTZU::u32 ||
        code == arm64_inst.V_FADD::u32 || code == arm64_inst.V_FSUB::u32 || code == arm64_inst.V_FMUL::u32 || code == arm64_inst.V_FDIV::u32 ||
        code == arm64_inst.V_FCMEQ::u32 || code == arm64_inst.V_FCMGT::u32 || code == arm64_inst.V_FCMGE::u32 ||
        code == arm64_inst.V_FCVTL::u32 || code == arm64_inst.V_FCVTN::u32 || code == arm64_inst.V_SCVTF::u32 ||
        code == arm64_inst.V_UCVTF::u32 || code == arm64_inst.V_FCVTZS::u32 || code == arm64_inst.V_FCVTZU::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_FLOAT));
    }
    if (code == arm64_inst.FCMP::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_FLOAT));
    }
    ret ct.asm_unknown();
}

val X30: u64 = 0x40000000;

fun grammar_implicit(code: u32) u32 {
    var i: usize = 0;
    for (i < arm64_mnemonic.ROW_COUNT) {
        if (arm64_mnemonic.ROWS[i].code == code) { ret arm64_mnemonic.ROWS[i].implicit; }
        i = i + 1;
    }
    ret 0;
}

fun value_operand(op: *isa_inst.Operand) bool {
    ret op.kind == isa_inst.OPK_REG || op.kind == isa_inst.OPK_MEM;
}

fun reads_rest(e: *isa_effect.InstEffects, mi: *isa_inst.Inst, from: u32) {
    if (from <= 1 && value_operand(?mi.src1)) { e.roles[1] = isa_effect.ROLE_READ; }
    if (from <= 2 && value_operand(?mi.src2)) { e.roles[2] = isa_effect.ROLE_READ; }
    if (from <= 3 && value_operand(?mi.src3)) { e.roles[3] = isa_effect.ROLE_READ; }
}

fun target(mi: *isa_inst.Inst, e: *isa_effect.InstEffects) {
    val t: *isa_inst.Operand = ?mi.src2;
    if (t.kind == isa_inst.OPK_SYM) {
        e.target = isa_effect.TARGET_EXTERNAL;
        ret;
    }
    if (t.kind == isa_inst.OPK_LABEL) {
        if ((mi.flags & arm64_inst.FLAG_TARGET_BLOCK) != 0 && isa_inst.label_is_block(t)) {
            e.target       = isa_effect.TARGET_BLOCK;
            e.target_block = t.imm::u32;
            ret;
        }
        e.target = isa_effect.TARGET_LOCAL;
        if (isa_inst.label_is_forward_local(t)) {
            e.target     = isa_effect.TARGET_LOCAL_FWD;
            e.local_disp = t.disp;
        }
        ret;
    }
    e.target = isa_effect.TARGET_LOCAL;
}

# the effect description of one emitted aarch64 instruction: the closed class
# row plus the operand roles of the translated form record (dst, src1, src2,
# src3 as to_inst lays them out) and the implicit effects
pub fun describe(mi: *isa_inst.Inst, e: *isa_effect.InstEffects) {
    @e = isa_effect.inst_effects_unknown();
    val op: arm64_inst.MachOp = mi.opcode::arm64_inst.MachOp;
    if (!arm64_inst.known(op)) { ret; }
    e.cls = asm_ct_class(op::u32, 0);
    if (op == arm64_inst.V_MUL || op == arm64_inst.V_SMULL || op == arm64_inst.V_UMULL || op == arm64_inst.V_SMULL2 || op == arm64_inst.V_UMULL2) {
        e.cls = asm_ct_class(op::u32, mi.flags);
    }

    if (op == arm64_inst.NOP || op == arm64_inst.YIELD || op == arm64_inst.WFE || op == arm64_inst.WFI || op == arm64_inst.DMB) { ret; }
    if (op == arm64_inst.DSB || op == arm64_inst.ISB || op == arm64_inst.SB)                                                    { ret; }
    if (op == arm64_inst.BRK) {
        e.xfer = isa_effect.XFER_TRAP;
        ret;
    }
    if (op == arm64_inst.SVC || op == arm64_inst.HVC || op == arm64_inst.SMC) {
        val implicit: u64 = grammar_implicit(op::u32)::u64;
        e.implicit_reads  = implicit;
        e.implicit_writes = implicit;
        ret;
    }
    if (op == arm64_inst.MSR) {
        reads_rest(e, mi, 1);
        ret;
    }
    if (op == arm64_inst.MRS) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        ret;
    }

    if (op == arm64_inst.RET) {
        e.xfer   = isa_effect.XFER_RET;
        e.target = isa_effect.TARGET_REGISTER;
        if (mi.src1.kind == isa_inst.OPK_REG) { e.roles[1] = isa_effect.ROLE_READ; }
        or                                    { e.implicit_reads = X30; }
        ret;
    }
    if (op == arm64_inst.BR || op == arm64_inst.BLR) {
        e.xfer = isa_effect.XFER_JUMP;
        if (op == arm64_inst.BLR) {
            e.xfer            = isa_effect.XFER_CALL;
            e.implicit_writes = X30;
        }
        e.target   = isa_effect.TARGET_REGISTER;
        e.roles[1] = isa_effect.ROLE_READ;
        ret;
    }
    if (op == arm64_inst.B || op == arm64_inst.BL) {
        e.xfer = isa_effect.XFER_JUMP;
        if (op == arm64_inst.BL) {
            e.xfer            = isa_effect.XFER_CALL;
            e.implicit_writes = X30;
        }
        target(mi, e);
        ret;
    }
    if (op == arm64_inst.BCOND) {
        e.xfer = isa_effect.XFER_BRANCH;
        target(mi, e);
        ret;
    }
    if (op == arm64_inst.CBZ || op == arm64_inst.CBNZ) {
        e.xfer     = isa_effect.XFER_BRANCH;
        e.roles[1] = isa_effect.ROLE_READ;
        target(mi, e);
        ret;
    }

    if (op == arm64_inst.CMP || op == arm64_inst.CMN || op == arm64_inst.FCMP) {
        reads_rest(e, mi, 1);
        ret;
    }

    if (op == arm64_inst.LDR || op == arm64_inst.LDRB || op == arm64_inst.LDRH || op == arm64_inst.LDUR || op == arm64_inst.LDURB ||
        op == arm64_inst.LDURH || op == arm64_inst.LDAR || op == arm64_inst.LDAXR) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_READ;
        ret;
    }
    if (op == arm64_inst.LD1) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_READ;
        ret;
    }
    if (op == arm64_inst.STR || op == arm64_inst.STRB || op == arm64_inst.STRH || op == arm64_inst.STUR || op == arm64_inst.STURB ||
        op == arm64_inst.STURH || op == arm64_inst.STLR || op == arm64_inst.ST1) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_READ;
        ret;
    }
    if (op == arm64_inst.LDP) {
        e.roles[0]  = isa_effect.ROLE_WRITE;
        e.roles[1]  = isa_effect.ROLE_WRITE;
        e.roles[2]  = isa_effect.ROLE_READ;
        e.mem_bytes = (mi.dst.size * 2)::u8;
        ret;
    }
    if (op == arm64_inst.STP) {
        e.roles[0]  = isa_effect.ROLE_WRITE;
        e.roles[1]  = isa_effect.ROLE_READ;
        e.roles[2]  = isa_effect.ROLE_READ;
        e.mem_bytes = (mi.src1.size * 2)::u8;
        ret;
    }
    if (op == arm64_inst.STLXR) {
        e.roles[0] = isa_effect.ROLE_WRITE;
        e.roles[1] = isa_effect.ROLE_READ;
        e.roles[2] = isa_effect.ROLE_WRITE;
        ret;
    }

    val crypto: *arm64_inst.CryptoRow = arm64_inst.crypto_row(op);
    if (op == arm64_inst.MOVK || op == arm64_inst.INS || op == arm64_inst.INS_EL || op == arm64_inst.MOV_LANE || (crypto != nil && crypto.accumulates)) {
        e.roles[0] = isa_effect.ROLE_RW;
        reads_rest(e, mi, 1);
        ret;
    }
    if (op == arm64_inst.LSLV || op == arm64_inst.LSRV || op == arm64_inst.ASRV) { e.count_pos = 2; }

    # every remaining member defines its destination from its sources
    if (mi.dst.kind != isa_inst.OPK_NONE) { e.roles[0] = isa_effect.ROLE_WRITE; }
    reads_rest(e, mi, 1);
}

test asm_ct_class__every_grammar_row_is_classified {
    var bad: i32   = 0;
    var i:   usize = 0;
    for (i < arm64_mnemonic.ROW_COUNT) {
        if (!asm_ct_class(arm64_mnemonic.ROWS[i].code, arm64_mnemonic.ROWS[i].flags).known) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

#[testing]
fun t_mul_cell_is(mi: *isa_inst.Inst, op: ct.CtMulOp, width: u8, vector: bool) bool {
    var e: isa_effect.InstEffects;
    describe(mi, ?e);
    val cell: ct.CtMulCell = ctwalk.emitted_mul_cell(mi, ?e);
    ret e.cls.op == ct.CT_OP_INT_MUL && cell.op == op && cell.width == width && cell.vector == vector;
}

# the inline-asm grammar spells no multiply, so the emitted form is the one
# the walk classifies: the low half at the register width, a lane multiply at
# its element width
test inst_effects__a_multiply_names_its_cell {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = arm64_inst.MUL::u16;
    mi.dst    = arm64_inst.gp(0, 8);
    mi.src1   = arm64_inst.gp(1, 8);
    mi.src2   = arm64_inst.gp(2, 8);
    if (!t_mul_cell_is(?mi, ct.CT_MUL_LOW, 64, false)) { ret 1; }
    mi.dst  = arm64_inst.gp(0, 4);
    mi.src1 = arm64_inst.gp(1, 4);
    mi.src2 = arm64_inst.gp(2, 4);
    if (!t_mul_cell_is(?mi, ct.CT_MUL_LOW, 32, false)) { ret 2; }
    mi.opcode = arm64_inst.MSUB::u16;
    if (!t_mul_cell_is(?mi, ct.CT_MUL_LOW, 32, false)) { ret 3; }
    var v: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.V_MUL, arm64_inst.vec(0, 16), arm64_inst.vec(1, 16), arm64_inst.vec(2, 16));
    v.flags = arm64_inst.with_elem_bytes(0, 4);
    if (!t_mul_cell_is(?v, ct.CT_MUL_LOW, 32, true)) { ret 4; }
    var h: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.UMULH, arm64_inst.gp(0, 8), arm64_inst.gp(1, 8), arm64_inst.gp(2, 8));
    if (!t_mul_cell_is(?h, ct.CT_MUL_HIGH_U, 64, false)) { ret 5; }
    h.opcode = arm64_inst.SMULH::u16;
    if (!t_mul_cell_is(?h, ct.CT_MUL_HIGH_S, 64, false)) { ret 6; }
    ret 0;
}

test asm_ct_class__branches_are_register_conditioned {
    var bad: i32 = 0;

    if (!asm_ct_class(arm64_inst.CBZ::u32, 0).cond_reg)  { bad = 1; }
    if (!asm_ct_class(arm64_inst.CBNZ::u32, 0).cond_reg) { bad = 1; }
    var i: usize = 0;
    for (i < arm64_mnemonic.ROW_COUNT) {
        if (asm_ct_class(arm64_mnemonic.ROWS[i].code, arm64_mnemonic.ROWS[i].flags).cond_flags) { bad = 1; }
        i = i + 1;
    }
    if (asm_ct_class(arm64_inst.B::u32, 0).cond_reg)  { bad = 1; }
    if (asm_ct_class(arm64_inst.BL::u32, 0).cond_reg) { bad = 1; }

    var fi: usize = 0;
    for (fi < arm64_mnemonic.ROW_COUNT) {
        val fc: ct.AsmClass = asm_ct_class(arm64_mnemonic.ROWS[fi].code, arm64_mnemonic.ROWS[fi].flags);
        if (fc.reads_flags && arm64_mnemonic.ROWS[fi].code != arm64_inst.CSET::u32 && arm64_mnemonic.ROWS[fi].code != arm64_inst.MRS::u32) { bad = 1; }
        if (fc.defines_flags && arm64_mnemonic.ROWS[fi].code != arm64_inst.CMP::u32)                                                       { bad = 1; }
        if (fc.opaque_flags)                                                                                                               { bad = 1; }
        fi = fi + 1;
    }
    if (!asm_ct_class(arm64_inst.CSET::u32, 0).reads_flags)  { bad = 1; }
    if (!asm_ct_class(arm64_inst.MRS::u32, 0).reads_flags)   { bad = 1; }
    if (!asm_ct_class(arm64_inst.CMP::u32, 0).defines_flags) { bad = 1; }

    if (asm_ct_class(arm64_inst.LSLV::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(arm64_inst.LSRV::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(arm64_inst.ASRV::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(arm64_inst.LSL::u32, 0).op != ct.CT_OP_NONE)       { bad = 1; }
    # past the shifts, the rows that vary in latency are the lane multiply,
    # the two scalar high multiplies and the float ops
    var mul:   u32 = 0;
    var mulh:  u32 = 0;
    var float: u32 = 0;
    i = 0;
    for (i < arm64_mnemonic.ROW_COUNT) {
        val row: *isa_asm.Mnemonic = ?arm64_mnemonic.ROWS[i];
        val op:  ct.CtOp           = asm_ct_class(row.code, row.flags).op;
        val vec: bool              = t_vector_row(row);
        if (op == ct.CT_OP_INT_DIVMOD)                                                                  { bad = 1; }
        if (op == ct.CT_OP_INT_MUL && vec)                                                              { mul = mul + 1; }
        or (op == ct.CT_OP_INT_MUL && arm64_mnemonic.pattern(row.flags) == arm64_mnemonic.PATTERN_MULH) { mulh = mulh + 1; }
        or (op == ct.CT_OP_INT_MUL)                                                                     { bad = 1; }
        if (op == ct.CT_OP_FLOAT && vec)                                                                { float = float + 1; }
        or (op == ct.CT_OP_FLOAT)                                                                       { bad = 1; }
        i = i + 1;
    }
    if (mul != 1 || mulh != 2 || float != 7) { bad = 1; }
    i = 0;
    for (i < arm64_mnemonic.VEC_TWIN_COUNT) {
        if (asm_ct_class(arm64_mnemonic.VEC_TWINS[i].code, arm64_mnemonic.VEC_TWINS[i].flags).op != ct.CT_OP_NONE) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

# the grammar row the assembler would pick for a rendered mnemonic; the
# register-count shifts render with the preferred `lsl` spelling that the
# grammar retags to the v-form once it sees the register operand
#[testing]
pub fun t_vector_row(m: *isa_asm.Mnemonic) bool {
    val pat: u16 = arm64_mnemonic.pattern(m.flags);
    ret pat == arm64_mnemonic.PATTERN_V3 || pat == arm64_mnemonic.PATTERN_V2 || pat == arm64_mnemonic.PATTERN_VELEM;
}

# the census the walk depends on: every machine opcode a notification can
# carry (the whole mop space, which names exactly what the encoder emits and
# what the grammar accepts) has a row in the closed table. flags are stated
# on every row the walk can reach with a secret in hand; the control and
# system rows keep the grammar's conservative unstated default
test asm_ct_class__every_notifiable_opcode_has_a_row {
    var missing: u32               = 0;
    var first:   arm64_inst.MachOp = 0;
    var op:      arm64_inst.MachOp = 1;
    for (op <= arm64_inst.MOP_LAST) {
        val cls: ct.AsmClass = asm_ct_class(op::u32, 0);
        if (!cls.known) {
            missing = missing + 1;
            first   = op;
        }
        op = op + 1;
    }
    if (asm_ct_class(arm64_inst.MOP_NONE::u32, 0).known)       { ret 2; }
    if (asm_ct_class((arm64_inst.MOP_LAST + 1)::u32, 0).known) { ret 3; }
    # a failure names the first unclassified member, offset past the fixed codes
    if (missing != 0) { ret 100 + first::i32; }
    ret 0;
}

test inst_effects__roles_follow_the_translated_form {
    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = isa_inst.inst_blank();

    mi.opcode = arm64_inst.SUBS::u16;
    mi.dst    = arm64_inst.gp(31, 8);
    mi.src1   = arm64_inst.gp(1, 8);
    mi.src2   = arm64_inst.gp(2, 8);
    mi.opcode = arm64_inst.CMP::u16;
    describe(?mi, ?e);
    if (!e.cls.known || !e.cls.defines_flags || e.roles[0] != isa_effect.ROLE_NONE || e.roles[1] != isa_effect.ROLE_READ || e.roles[2] != isa_effect.ROLE_READ) { ret 1; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.BCOND::u16;
    mi.src2   = isa_inst.make_block_label(4);
    mi.flags  = arm64_inst.FLAG_TARGET_BLOCK;
    describe(?mi, ?e);
    if (!e.cls.cond_flags || e.xfer != isa_effect.XFER_BRANCH || e.target != isa_effect.TARGET_BLOCK || e.target_block != 4) { ret 2; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.CBNZ::u16;
    mi.src1   = arm64_inst.gp(3, 8);
    mi.src2   = isa_inst.make_local_label(true);
    describe(?mi, ?e);
    if (!e.cls.cond_reg || e.roles[1] != isa_effect.ROLE_READ || e.target != isa_effect.TARGET_LOCAL_FWD) { ret 3; }
    mi.src2 = isa_inst.make_local_label(false);
    describe(?mi, ?e);
    if (e.target != isa_effect.TARGET_LOCAL) { ret 14; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.SDIV::u16;
    mi.dst    = arm64_inst.gp(0, 8);
    mi.src1   = arm64_inst.gp(1, 8);
    mi.src2   = arm64_inst.gp(2, 8);
    describe(?mi, ?e);
    if (e.cls.op != ct.CT_OP_INT_DIVMOD || e.roles[0] != isa_effect.ROLE_WRITE || e.roles[2] != isa_effect.ROLE_READ) { ret 4; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.MSUB::u16;
    mi.dst    = arm64_inst.gp(0, 8);
    mi.src1   = arm64_inst.gp(1, 8);
    mi.src2   = arm64_inst.gp(2, 8);
    mi.src3   = arm64_inst.gp(3, 8);
    describe(?mi, ?e);
    if (e.cls.op != ct.CT_OP_INT_MUL || e.roles[3] != isa_effect.ROLE_READ) { ret 5; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.STR::u16;
    mi.dst    = isa_inst.make_mem(arm64_inst.gp_id(29), -16, isa_inst.REG_NONE, 0, 8);
    mi.src1   = arm64_inst.gp(5, 8);
    describe(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ) { ret 6; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.LDP::u16;
    mi.dst    = arm64_inst.gp(29, 8);
    mi.src1   = arm64_inst.gp(30, 8);
    mi.src2   = isa_inst.make_mem(arm64_inst.gp_id(31), 0, isa_inst.REG_NONE, 0, 8);
    describe(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_WRITE || e.roles[2] != isa_effect.ROLE_READ || e.mem_bytes != 16) { ret 7; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.MOVK::u16;
    mi.dst    = arm64_inst.gp(16, 8);
    mi.src1   = isa_inst.make_imm(1, 2);
    describe(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_RW) { ret 8; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.LSLV::u16;
    mi.dst    = arm64_inst.gp(0, 8);
    mi.src1   = arm64_inst.gp(1, 8);
    mi.src2   = arm64_inst.gp(2, 8);
    describe(?mi, ?e);
    if (e.cls.op != ct.CT_OP_VAR_SHIFT || e.count_pos != 2) { ret 9; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.RET::u16;
    describe(?mi, ?e);
    if (e.xfer != isa_effect.XFER_RET || e.implicit_reads != X30 || !e.cls.cond_reg) { ret 10; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.BL::u16;
    mi.src2   = isa_inst.make_sym(1, 0);
    describe(?mi, ?e);
    if (e.xfer != isa_effect.XFER_CALL || e.target != isa_effect.TARGET_EXTERNAL || e.implicit_writes != X30) { ret 11; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.BLR::u16;
    mi.src1   = arm64_inst.gp(9, 8);
    describe(?mi, ?e);
    if (e.xfer != isa_effect.XFER_CALL || e.target != isa_effect.TARGET_REGISTER || e.roles[1] != isa_effect.ROLE_READ) { ret 12; }

    mi        = isa_inst.inst_blank();
    mi.opcode = arm64_inst.MOP_NONE::u16;
    describe(?mi, ?e);
    if (e.cls.known) { ret 13; }
    ret 0;
}
