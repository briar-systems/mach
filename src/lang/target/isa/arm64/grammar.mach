# the inline assembly grammar: arm64 statements parsed, checked and encoded
use mach.lang.fail;
use std_format: std.format;
use text_parse: std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_is_digit;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use lang_mir:       mach.lang.mir;
use arm64_effects:  mach.lang.target.isa.arm64.effects;
use arm64_emit:     mach.lang.target.isa.arm64.emit;
use arm64_inst:     mach.lang.target.isa.arm64.inst;
use arm64_mnemonic: mach.lang.target.isa.arm64.mnemonic;
use arm64_printer:  mach.lang.target.isa.arm64.printer;
use isa_asm:        mach.lang.target.isa.asm;
use isa_encode:     mach.lang.target.isa.encode;
use isa_inst:       mach.lang.target.isa.inst;
use target_model:   mach.lang.target.model;
use target_of:      mach.lang.target.of;

pub fun mnemonic(op: u16) opt[str] {
    ret arm64_inst.mnemonic(op::arm64_inst.MachOp);
}

fun asm_parse_cond(s: str, out: *u32) bool {
    if (str_equals(s, "eq")) {
        @out = arm64_emit.CC_EQ;
        ret true;
    }
    if (str_equals(s, "ne")) {
        @out = arm64_emit.CC_NE;
        ret true;
    }
    if (str_equals(s, "cs") || str_equals(s, "hs")) {
        @out = arm64_emit.CC_HS;
        ret true;
    }
    if (str_equals(s, "cc") || str_equals(s, "lo")) {
        @out = arm64_emit.CC_CC;
        ret true;
    }
    if (str_equals(s, "mi")) {
        @out = arm64_emit.CC_MI;
        ret true;
    }
    if (str_equals(s, "pl")) {
        @out = arm64_emit.CC_PL;
        ret true;
    }
    if (str_equals(s, "vs")) {
        @out = arm64_emit.CC_VS;
        ret true;
    }
    if (str_equals(s, "vc")) {
        @out = arm64_emit.CC_VC;
        ret true;
    }
    if (str_equals(s, "hi")) {
        @out = arm64_emit.CC_HI;
        ret true;
    }
    if (str_equals(s, "ls")) {
        @out = arm64_emit.CC_LS;
        ret true;
    }
    if (str_equals(s, "ge")) {
        @out = arm64_emit.CC_GE;
        ret true;
    }
    if (str_equals(s, "lt")) {
        @out = arm64_emit.CC_LT;
        ret true;
    }
    if (str_equals(s, "gt")) {
        @out = arm64_emit.CC_GT;
        ret true;
    }
    if (str_equals(s, "le")) {
        @out = arm64_emit.CC_LE;
        ret true;
    }
    if (str_equals(s, "al")) {
        @out = arm64_emit.CC_AL;
        ret true;
    }
    ret false;
}

# the amount of an `lsl N` shift, none for text that does not spell one
fun asm_parse_lsl_amount(s: str) opt[u32] {
    if (!str_starts_with(s, "lsl")) { ret opt[u32].none{}; }
    var i: usize = 3;
    for (s[i] != 0 && isa_asm.is_space(s[i])) { i = i + 1; }
    val rest: str                             = (s::usize + i)::str;
    val r:    res[i64, text_parse.ParseError] = text_parse.parse_i64_exact(rest, 0);
    if (sel r.err)                     { ret opt[u32].none{}; }
    if (r.ok < 0 || r.ok > 0xFFFFFFFF) { ret opt[u32].none{}; }
    ret opt[u32].some{r.ok::u32};
}

fun asm_barrier_option(name: str, out: *u32) bool {
    if (str_equals(name, "sy")) {
        @out = 15;
        ret true;
    }
    if (str_equals(name, "st")) {
        @out = 14;
        ret true;
    }
    if (str_equals(name, "ld")) {
        @out = 13;
        ret true;
    }
    if (str_equals(name, "ish")) {
        @out = 11;
        ret true;
    }
    if (str_equals(name, "ishst")) {
        @out = 10;
        ret true;
    }
    if (str_equals(name, "ishld")) {
        @out = 9;
        ret true;
    }
    if (str_equals(name, "nsh")) {
        @out = 7;
        ret true;
    }
    if (str_equals(name, "nshst")) {
        @out = 6;
        ret true;
    }
    if (str_equals(name, "nshld")) {
        @out = 5;
        ret true;
    }
    if (str_equals(name, "osh")) {
        @out = 3;
        ret true;
    }
    if (str_equals(name, "oshst")) {
        @out = 2;
        ret true;
    }
    if (str_equals(name, "oshld")) {
        @out = 1;
        ret true;
    }
    ret false;
}

fun emit_asm_mov_imm(st: *isa_encode.EncodeState, rd: u32, value: u64, use64: bool) {
    var v: u64 = value;
    if (!use64) { v = value & 0xFFFFFFFF; }
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var i: u32 = 0;
    for (i < chunks) {
        val sh:    u64 = 16::u64 * i::u64;
        val chunk: u64 = (v >> sh) & 0xFFFF;
        if ((chunk << sh) == v) {
            arm64_emit.movewide(st, arm64_inst.MOVZ, use64, rd, i, chunk::u32);
            ret;
        }
        i = i + 1;
    }
    arm64_emit.movewide_seq(st, rd, value, use64);
}

fun decode_bcond(body: str, lo: usize, hi: usize, m: *isa_asm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !isa_asm.is_space(body[end])) { end = end + 1; }
    val len: usize = end - lo;
    if (len < 4)                               { ret false; }
    if (!str_region_equals(body, lo, 2, "b.")) { ret false; }

    var buf: [8]u8;
    if (!isa_asm.copy_region(body, lo + 2, end, ?buf[0], 8)) { ret false; }
    var cc: u32 = 0;
    if (!asm_parse_cond((?buf[0])::str, ?cc)) { ret false; }

    m.name     = nil;
    m.code     = arm64_inst.B::u32;
    m.form     = isa_asm.AF_OPS;
    m.writes   = isa_asm.AW_NONE;
    m.implicit = 0;
    m.flags    = arm64_mnemonic.PATTERN_BCOND | ((cc::u16 << arm64_mnemonic.COND_SHIFT) & arm64_mnemonic.COND_MASK);
    m.words    = 1;
    @n_out     = len;
    ret true;
}

fun name_operand(pat: u16) u32 {
    if (pat == arm64_mnemonic.PATTERN_B || pat == arm64_mnemonic.PATTERN_BCOND || pat == arm64_mnemonic.PATTERN_DMB)  { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_ISB)                                                                            { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_VELEM)                                                                          { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_MSR)                                                                            { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_CBR || pat == arm64_mnemonic.PATTERN_CSET || pat == arm64_mnemonic.PATTERN_MRS) { ret 1; }
    if (pat == arm64_mnemonic.PATTERN_MOVEWIDE)                                                                       { ret 2; }
    ret 0xFFFFFFFF;
}

fun operand(c: *isa_asm.Cursor, lo: usize, hi: usize, op: *isa_asm.Operand) err[fail.Fail] {
    @op = isa_asm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm operand")}; }

    if (c.body[lo] == '{'::char) {
        var off:     i64                  = 0;
        val bound_r: res[bool, fail.Fail] = isa_asm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op      = isa_asm.op_mem(arm64_inst.gp_id(arm64_emit.SP_REG), off, isa_inst.REG_NONE, 0, 8);
            op.flags = isa_asm.AOF_HAS_DISP | isa_asm.AOF_STACK_PTR;
            ret err[fail.Fail].ok{};
        }
        op.kind     = isa_asm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    if (c.body[lo] == '['::char) { ret mem_operand(c, lo, hi, op); }
    if (c.body[lo] == ':'::char) { ret modifier(c, lo, hi, op); }

    if (reg_region(c.body, lo, hi, op))  { ret err[fail.Fail].ok{}; }
    if (vreg_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }

    val iv: opt[i64] = isa_asm.region_i64(c.body, lo, hi);
    if (sel iv.some) {
        @op = isa_asm.op_imm(iv.some, 8);
        ret err[fail.Fail].ok{};
    }

    if (isa_asm.is_sym_region(c.body, lo, hi)) {
        @op = isa_asm.op_sym(lo, hi - lo, isa_inst.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm operand")};
}

# the hardware number of an inline-asm operand's register id
fun reg_number(r: i32) u32 {
    ret isa_inst.regid_index(r)::u32;
}

fun reg_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "xzr")) {
        @op = isa_asm.op_reg(arm64_inst.gp_id(31), 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "wzr")) {
        @op = isa_asm.op_reg(arm64_inst.gp_id(31), 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "sp")) {
        @op      = isa_asm.op_reg(arm64_inst.gp_id(31), 8);
        op.flags = isa_asm.AOF_STACK_PTR;
        ret true;
    }
    if (str_region_equals(body, lo, len, "wsp")) {
        @op      = isa_asm.op_reg(arm64_inst.gp_id(31), 4);
        op.flags = isa_asm.AOF_STACK_PTR;
        ret true;
    }

    if (len < 2 || len > 3) { ret false; }
    val c0: char = body[lo];
    if (c0 != 'x'::char && c0 != 'w'::char) { ret false; }
    var n: u32   = 0;
    var i: usize = lo + 1;
    for (i < hi) {
        if (!char_is_digit(body[i])) { ret false; }
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 30) { ret false; }
    var w: u8 = 4;
    if (c0 == 'x'::char) { w = 8; }
    @op = isa_asm.op_reg(arm64_inst.gp_id(n), w);
    ret true;
}

# `vN.16b`, `vN.8h`, `vN.4s` or `vN.2d` (elem names the lane bytes), `qN` (no
# arrangement), or the carry-less multiply's `vN.1q` (one 16-byte lane) and
# `vN.1d` (one lane of the low half, size 8)
fun vreg_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    if (hi < lo + 2) { ret false; }
    val c0:  char  = body[lo];
    var end: usize = lo + 1;
    for (end < hi && char_is_digit(body[end])) { end = end + 1; }
    if (end == lo + 1 || end > lo + 3) { ret false; }
    var n: u32   = 0;
    var i: usize = lo + 1;
    for (i < end) {
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    var elem: u8 = 0;
    var size: u8 = 16;
    if (c0 == 'q'::char) {
        if (end != hi) { ret false; }
    }
    or (c0 == 'v'::char && lane_region(body, end, hi, op)) {
        op.reg  = arm64_inst.vec_id(n);
        op.bank = isa_asm.ABANK_FP;
        ret true;
    }
    or (c0 == 'v'::char) {
        val len: usize = hi - end;
        if (str_region_equals(body, end, len, ".16b")) { elem = 1; }
        or (str_region_equals(body, end, len, ".8h"))  { elem = 2; }
        or (str_region_equals(body, end, len, ".4s"))  { elem = 4; }
        or (str_region_equals(body, end, len, ".2d"))  { elem = 8; }
        or (str_region_equals(body, end, len, ".1q"))  { elem = 16; }
        or (str_region_equals(body, end, len, ".1d")) {
            elem = 8;
            size = 8;
        }
        or { ret false; }
    }
    or { ret false; }
    @op     = isa_asm.op_reg(arm64_inst.vec_id(n), size);
    op.elem = elem;
    ret true;
}

# `.b[i]`, `.h[i]`, `.s[i]` or `.d[i]` after a v register number: one element
# of that width, its index in imm. the index is bounded where a row reads it
fun lane_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    if (hi < lo + 5 || body[lo] != '.'::char || body[lo + 2] != '['::char || body[hi - 1] != ']'::char) { ret false; }
    val w:    char = body[lo + 1];
    var elem: u8   = 0;
    if (w == 'b'::char) { elem = 1; }
    or (w == 'h'::char) { elem = 2; }
    or (w == 's'::char) { elem = 4; }
    or (w == 'd'::char) { elem = 8; }
    or                  { ret false; }
    val idx: opt[i64] = isa_asm.region_i64(body, lo + 3, hi - 1);
    if (sel idx.none) { ret false; }
    var at: i64 = 0;
    if (sel idx.some)       { at = idx.some; }
    if (at < 0 || at > 255) { ret false; }
    @op      = isa_asm.op_reg(arm64_inst.vec_id(0), 16);
    op.elem  = elem;
    op.imm   = at;
    op.flags = isa_asm.AOF_LANE;
    ret true;
}

fun is_lane(op: *isa_asm.Operand) bool {
    ret isa_asm.is_vreg(op) && (op.flags & isa_asm.AOF_LANE) != 0;
}

fun reg(name: str, op: *isa_asm.Operand) bool {
    ret reg_region(name, 0, str_len(name), op);
}

fun modifier(c: *isa_asm.Cursor, lo: usize, hi: usize, op: *isa_asm.Operand) err[fail.Fail] {
    var close: usize = lo + 1;
    var found: bool  = false;
    for (close < hi && !found) {
        if (c.body[close] == ':'::char) { found = true; }
        or                              { close = close + 1; }
    }
    if (!found) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm relocation modifier")}; }
    val nlen: usize = close - lo - 1;

    var mod: isa_inst.SymModifier = isa_inst.SYM_MOD_NONE;
    if (str_region_equals(c.body, lo + 1, nlen, "lo12"))     { mod = isa_inst.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got"))      { mod = isa_inst.SYM_MOD_GOT_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_lo12")) { mod = isa_inst.SYM_MOD_GOT_LO; }
    or {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_UNSUPPORTED, isa_asm.span_message(c,
            "unsupported aarch64 inline-asm relocation modifier '", lo, hi, "'"))};
    }
    if (!isa_asm.is_sym_region(c.body, close + 1, hi)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm relocation modifier")};
    }
    @op = isa_asm.op_sym(close + 1, hi - close - 1, mod, 8);
    ret err[fail.Fail].ok{};
}

fun mem_operand(c: *isa_asm.Cursor, lo: usize, hi: usize, op: *isa_asm.Operand) err[fail.Fail] {
    @op     = isa_asm.op_none();
    op.kind = isa_asm.AOP_MEM;
    op.size = 8;

    var end: usize = hi;
    if (c.body[end - 1] == '!'::char) {
        op.flags = op.flags | isa_asm.AOF_WRITEBACK;
        end      = end - 1;
    }
    if (end < lo + 2 || c.body[end - 1] != ']'::char) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }

    val ilo:   usize = lo + 1;
    val ihi:   usize = end - 1;
    var comma: usize = ilo;
    var found: bool  = false;
    for (comma < ihi && !found) {
        if (c.body[comma] == ','::char) { found = true; }
        or                              { comma = comma + 1; }
    }

    var bbuf: [24]u8;
    var bend: usize = ihi;
    if (found)                                                 { bend = comma; }
    if (!isa_asm.copy_region(c.body, ilo, bend, ?bbuf[0], 24)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
    var base: isa_asm.Operand = isa_asm.op_none();
    if (!reg((?bbuf[0])::str, ?base)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
    op.reg   = base.reg;
    op.flags = op.flags | (base.flags & isa_asm.AOF_STACK_PTR);
    if (!found) { ret err[fail.Fail].ok{}; }

    var s: usize = comma + 1;
    var e: usize = ihi;
    for (s < e && isa_asm.is_space(c.body[s])) { s = s + 1; }
    for (e > s && isa_asm.is_space(c.body[e - 1])) { e = e - 1; }
    if (e <= s) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }

    if (c.body[s] == ':'::char) {
        var sym: isa_asm.Operand = isa_asm.op_none();
        val mr:  err[fail.Fail]  = modifier(c, s, e, ?sym);
        if (sel mr.err) { ret mr; }
        op.flags    = op.flags | isa_asm.AOF_MEM_SYM;
        op.mod      = sym.mod;
        op.name_off = sym.name_off;
        op.name_len = sym.name_len;
        ret err[fail.Fail].ok{};
    }

    var ibuf: [24]u8;
    if (isa_asm.copy_region(c.body, s, e, ?ibuf[0], 24)) {
        var idx: isa_asm.Operand = isa_asm.op_none();
        if (reg((?ibuf[0])::str, ?idx)) {
            if (is_sp(?idx)) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm memory index register has no sp form; register 31 there is always xzr")};
            }
            op.flags = op.flags | isa_asm.AOF_HAS_INDEX;
            op.index = idx.reg;
            if (idx.size == 8) { op.flags = op.flags | isa_asm.AOF_WIDE; }
            ret err[fail.Fail].ok{};
        }
    }
    val dv: opt[i64] = isa_asm.region_i64(c.body, s, e);
    if (!sel dv.some) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
    op.imm   = dv.some;
    op.flags = op.flags | isa_asm.AOF_HAS_DISP;
    ret err[fail.Fail].ok{};
}

fun is_addr(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_MEM || op.kind == isa_asm.AOP_BIND;
}

fun is64(op: *isa_asm.Operand) bool {
    ret op.size == 8;
}

fun is_sp(op: *isa_asm.Operand) bool {
    ret (op.flags & isa_asm.AOF_STACK_PTR) != 0;
}

fun parse(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val pat:     u16 = arm64_mnemonic.pattern(s.m.flags);
    val n:       u32 = s.nargs;
    val name_at: u32 = name_operand(pat);

    var i: u32 = 0;
    for (i < n) {
        if (i != name_at) {
            val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }

    if (pat == arm64_mnemonic.PATTERN_V3 || pat == arm64_mnemonic.PATTERN_V2 || pat == arm64_mnemonic.PATTERN_VELEM) { ret parse_vec(c, s, item, pat); }
    if (pat == arm64_mnemonic.PATTERN_VCRYPTO)                                                                       { ret parse_crypto(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_REV)                                                                           { ret parse_rev(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_VEXT)                                                                          { ret parse_ext(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_VDUP)                                                                          { ret parse_dup(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_VINS)                                                                          { ret parse_ins(c, s, item); }
    if (s.m.code == arm64_inst.MOV::u32 && n == 2 && is_lane(?item.ops[0])) {
        item.code  = arm64_inst.INS::u32;
        item.flags = arm64_mnemonic.PATTERN_VINS;
        ret parse_ins(c, s, item);
    }
    if (names_vreg(item, n)) {
        val twin: *isa_asm.Mnemonic = vec_twin(s.m.code);
        if (twin == nil) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "' takes general-purpose registers, not a vector register"))};
        }
        item.code   = twin.code;
        item.flags  = twin.flags;
        item.writes = twin.writes;
        ret parse_vec(c, s, item, arm64_mnemonic.pattern(twin.flags));
    }

    if (pat == arm64_mnemonic.PATTERN_NULLARY) {
        if (n != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction takes no operands")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_RET_REG || pat == arm64_mnemonic.PATTERN_BR_REG) {
        if (n != 1)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction expects one register")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ret/blr/br operand must be a register")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_IMM16) {
        if (n != 1)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].kind != isa_asm.AOP_IMM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].imm < 0 || item.ops[0].imm > 0xFFFF) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm svc/brk immediate is out of 16-bit range")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MOV) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' expects two operands")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' destination must be a register")}; }
        if (item.ops[1].kind == isa_asm.AOP_REG) {
            if (item.ops[0].size != item.ops[1].size) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' operands are different widths; aarch64 has one size flag for the whole instruction")};
            }
            item.words = 1;
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind == isa_asm.AOP_IMM) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' source must be a register or immediate")};
    }
    if (pat == arm64_mnemonic.PATTERN_MOVEWIDE) {
        if (n < 2 || n > 3)                      { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk expects Rd, imm [, lsl N]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk destination must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_IMM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk needs an immediate")}; }
        if (item.ops[1].imm < 0 || item.ops[1].imm > 0xFFFF) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk immediate is out of 16-bit range")};
        }
        if (n == 3) { ret shift_amount(c, s, item, 2); }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ADDSUB || pat == arm64_mnemonic.PATTERN_LOGICAL || pat == arm64_mnemonic.PATTERN_SHIFT || pat == arm64_mnemonic.PATTERN_MULH) {
        if (n != 3)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction expects three operands")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm destination must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm first source must be a register")}; }
        if (item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        if (pat == arm64_mnemonic.PATTERN_LOGICAL && item.ops[2].kind != isa_asm.AOP_REG) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm and/orr/eor immediate (bitmask) form unsupported; use a register operand")};
        }
        if (pat == arm64_mnemonic.PATTERN_MULH && item.ops[2].kind != isa_asm.AOP_REG) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm umulh/smulh takes three registers")};
        }
        if (pat == arm64_mnemonic.PATTERN_MULH && item.ops[0].size != 8) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm umulh/smulh has no 32-bit form; use x registers")};
        }
        if (pat == arm64_mnemonic.PATTERN_SHIFT && item.ops[2].kind != isa_asm.AOP_REG && item.ops[2].kind != isa_asm.AOP_IMM) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm shift count must be a register or immediate")};
        }
        # `lsl` with a register count is the lslv alias: the variable-latency
        # member, and the constant-time class must see it as one
        if (pat == arm64_mnemonic.PATTERN_SHIFT && item.ops[2].kind == isa_asm.AOP_REG) {
            if (item.code == arm64_inst.LSL::u32) { item.code = arm64_inst.LSLV::u32; }
            if (item.code == arm64_inst.LSR::u32) { item.code = arm64_inst.LSRV::u32; }
            if (item.code == arm64_inst.ASR::u32) { item.code = arm64_inst.ASRV::u32; }
        }
        if (item.ops[2].kind == isa_asm.AOP_REG && item.ops[0].size != item.ops[2].size) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_CMP) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' expects two operands")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' first operand must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG && item.ops[1].kind != isa_asm.AOP_IMM) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' second operand must be a register or imm12")};
        }
        if (item.ops[1].kind == isa_asm.AOP_REG && item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_CSET) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cset' expects Rd, cond")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cset' destination must be a register")}; }
        var buf: [8]u8;
        var cc:  u32 = 0;
        if (!isa_asm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?buf[0], 8) || !asm_parse_cond((?buf[0])::str, ?cc)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cset' condition is unrecognized")};
        }
        item.flags = item.flags | ((cc::u16 << arm64_mnemonic.COND_SHIFT) & arm64_mnemonic.COND_MASK);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ADRP) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' expects Xd, symbol")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' destination must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_SYM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_BL) {
        if (n != 1)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'bl' expects a symbol")}; }
        if (item.ops[0].kind != isa_asm.AOP_SYM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'bl' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_B) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'b' expects a target")}; }
        ret branch_target(c, s, item, 0, true);
    }
    if (pat == arm64_mnemonic.PATTERN_BCOND) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm conditional branch expects a target")}; }
        ret branch_target(c, s, item, 0, false);
    }
    if (pat == arm64_mnemonic.PATTERN_CBR) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm cbz/cbnz expects Rt, target")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm cbz/cbnz first operand must be a register")}; }
        ret branch_target(c, s, item, 1, false);
    }
    if (pat == arm64_mnemonic.PATTERN_LDST) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str expects Rt, [mem]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str value must be a register")}; }
        if (!is_addr(?item.ops[1]))              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str address must be a memory operand")}; }
        if ((item.ops[1].flags & isa_asm.AOF_WRITEBACK) != 0) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm ldr/str writeback addressing unsupported")};
        }
        if ((item.ops[1].flags & isa_asm.AOF_HAS_DISP) != 0) { item.words = isa_asm.WORDS_VARIABLE; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_LDSTP) {
        if (n < 3 || n > 4)                                             { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp expects Xa, Xb, [mem] [, imm]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG || !is64(?item.ops[0])) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG || !is64(?item.ops[1])) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[2].kind != isa_asm.AOP_MEM)                        { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp address must be a memory operand")}; }
        if ((item.ops[2].flags & (isa_asm.AOF_HAS_INDEX | isa_asm.AOF_MEM_SYM)) != 0) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp address must be [Xn] or [Xn, imm]")};
        }
        if (n == 4) {
            if ((item.ops[2].flags & (isa_asm.AOF_HAS_DISP | isa_asm.AOF_WRITEBACK)) != 0) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp post-index base must be a bare [Xn]")};
            }
            if (item.ops[3].kind != isa_asm.AOP_IMM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp post-index needs an immediate")}; }
            item.ops[2].flags = item.ops[2].flags | isa_asm.AOF_WRITEBACK;
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_DMB) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm dmb/dsb expects one barrier option")}; }
        var buf:  [8]u8;
        var opt_: u32 = 0;
        if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?buf[0], 8) || !asm_barrier_option((?buf[0])::str, ?opt_)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm dmb/dsb barrier option")};
        }
        item.ops[0] = isa_asm.op_imm(opt_::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ISB) {
        # the architecture defines one option, `sy` (CRm 0b1111), and the bare
        # spelling means it; every other CRm is reserved and never emitted
        if (n > 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm isb takes no operand or the option `sy`")}; }
        if (n == 1) {
            var ibuf: [8]u8;
            var iopt: u32 = 0;
            if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?ibuf[0], 8) || !asm_barrier_option((?ibuf[0])::str, ?iopt) || iopt != 15) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm isb takes no operand or the option `sy`")};
            }
        }
        item.ops[0] = isa_asm.op_imm(15, 1);
        item.nops   = 1;
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MSR) {
        if (n != 2) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm msr expects a system register or PSTATE field and a source")}; }
        var nbuf: [arm64_emit.SYSREG_NAME_MAX]u8;
        if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?nbuf[0], arm64_emit.SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm msr destination name is too long")};
        }
        var op1: u32 = 0;
        var op2: u32 = 0;
        if (item.ops[1].kind == isa_asm.AOP_IMM) {
            if (!arm64_emit.pstate_field((?nbuf[0])::str, ?op1, ?op2)) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm msr PSTATE field")};
            }
            if (item.ops[1].imm < 0 || item.ops[1].imm > 15) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm msr immediate must be 0-15")};
            }
            item.ops[0] = isa_asm.op_imm(((op1 << 8) | op2)::i64, 1);
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind != isa_asm.AOP_REG) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm msr source must be an immediate or a register")};
        }
        var op0: u32 = 0;
        var crn: u32 = 0;
        var crm: u32 = 0;
        if (!arm64_emit.sysreg((?nbuf[0])::str, ?op0, ?op1, ?crn, ?crm, ?op2)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm msr system register")};
        }
        item.ops[0] = isa_asm.op_imm(arm64_emit.sysreg_pack(op0, op1, crn, crm, op2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MRS) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm mrs expects Xt, <sysreg>")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm mrs destination must be a register")}; }
        var mbuf: [arm64_emit.SYSREG_NAME_MAX]u8;
        if (!isa_asm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?mbuf[0], arm64_emit.SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm mrs system register name is too long")};
        }
        var m0: u32 = 0;
        var m1: u32 = 0;
        var mn: u32 = 0;
        var mm: u32 = 0;
        var m2: u32 = 0;
        if (!arm64_emit.sysreg((?mbuf[0])::str, ?m0, ?m1, ?mn, ?mm, ?m2)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm mrs system register")};
        }
        item.ops[1] = isa_asm.op_imm(arm64_emit.sysreg_pack(m0, m1, mn, mm, m2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_LDORD) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldar/stlr/ldaxr expects Rt, [Xn]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldar/stlr/ldaxr value must be a register")}; }
        ret bare_addr(c, ?item.ops[1]);
    }
    if (pat == arm64_mnemonic.PATTERN_STLXR) {
        if (n != 3)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stlxr expects Ws, Rt, [Xn]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stlxr status must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stlxr value must be a register")}; }
        ret bare_addr(c, ?item.ops[2]);
    }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no parser")};
}

fun names_vreg(item: *isa_asm.Item, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (isa_asm.is_vreg(?item.ops[i::usize])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun vec_twin(code: u32) *isa_asm.Mnemonic {
    var gp: u32 = arm64_inst.MOP_NONE::u32;
    if (code == arm64_inst.ADD::u32) { gp = arm64_inst.V_ADD::u32; }
    or (code == arm64_inst.SUB::u32) { gp = arm64_inst.V_SUB::u32; }
    or (code == arm64_inst.AND::u32) { gp = arm64_inst.V_AND::u32; }
    or (code == arm64_inst.ORR::u32) { gp = arm64_inst.V_ORR::u32; }
    or (code == arm64_inst.EOR::u32) { gp = arm64_inst.V_EOR::u32; }
    or (code == arm64_inst.MOV::u32) { gp = arm64_inst.V_MOV::u32; }
    var i: usize = 0;
    for (i < arm64_mnemonic.VEC_TWIN_COUNT) {
        if (arm64_mnemonic.VEC_TWINS[i].code == gp) { ret ?arm64_mnemonic.VEC_TWINS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun named_message(c: *isa_asm.Cursor, s: *isa_asm.Stmt, suffix: str) res[str, fail.Fail] {
    ret isa_asm.named_message(c.alloc, c.interner, "inline-asm instruction '", s.m.name, suffix);
}

fun vec_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt, suffix: str) err[fail.Fail] {
    ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, suffix))};
}

# a whole 128-bit v register at one of the lane arrangements the lane-wise rows
# take: .16b, .8h, .4s or .2d, never q, .1q or the half-register .1d
fun full_lanes(op: *isa_asm.Operand) bool {
    ret isa_asm.is_vreg(op) && !is_lane(op) && op.size == 16 && op.elem != 0 && op.elem <= 8;
}

# whether a member's lanes may be `elem` bytes wide
fun lane_admits(code: u32, elem: u8) bool {
    if (elem == 0 || elem > 8) { ret false; }
    val lane: arm64_inst.LaneClass = arm64_inst.form(code::arm64_inst.MachOp).lane;
    if (lane == arm64_inst.LANE_BITS)                                     { ret elem == 1; }
    if (lane == arm64_inst.LANE_FLOAT)                                    { ret elem == 4 || elem == 8; }
    if (code == arm64_inst.V_MUL::u32 || code == arm64_inst.V_REV64::u32) { ret elem != 8; }
    ret true;
}

fun parse_vec(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item, pat: u16) err[fail.Fail] {
    val n: u32 = s.nargs;
    if (pat == arm64_mnemonic.PATTERN_VELEM) { ret parse_velem(c, s, item); }

    var want: u32 = 3;
    if (pat == arm64_mnemonic.PATTERN_V2) { want = 2; }
    if (n != want) {
        if (want == 2) { ret vec_refused(c, s, "' expects two vector registers"); }
        ret vec_refused(c, s, "' expects three vector registers");
    }
    var i: u32 = 0;
    for (i < n) {
        if (!full_lanes(?item.ops[i::usize])) {
            ret vec_refused(c, s, "' takes vector registers with a lane arrangement, such as v0.4s");
        }
        if (item.ops[i::usize].elem != item.ops[0].elem) {
            ret vec_refused(c, s, "' names different lane arrangements; its operands share one");
        }
        i = i + 1;
    }

    var member: u32 = item.code;
    if (member == arm64_inst.V_MOV::u32) { member = arm64_inst.V_ORR::u32; }
    if (!lane_admits(member, item.ops[0].elem)) {
        ret vec_refused(c, s, "' has no form at this lane arrangement");
    }
    if (item.code == arm64_inst.V_MOV::u32) {
        item.code   = arm64_inst.V_ORR::u32;
        item.ops[2] = item.ops[1];
        item.nops   = 3;
    }
    item.flags = arm64_inst.with_elem_bytes(item.flags, item.ops[0].elem);
    ret err[fail.Fail].ok{};
}

# a general register other than sp, the source or destination of a lane row
fun gp_data(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(op) && !is_sp(op);
}

# a lane of `elem` bytes whose index the register holds
fun lane_fits(op: *isa_asm.Operand, elem: u8) bool {
    ret is_lane(op) && op.elem == elem && op.imm >= 0 && op.imm < (16 / elem::i64);
}

# the general register a lane of `elem` bytes moves through: x for a doubleword, w otherwise
fun lane_gp(op: *isa_asm.Operand, elem: u8) bool {
    if (!gp_data(op)) { ret false; }
    if (elem == 8)    { ret op.size == 8; }
    ret op.size == 4;
}

fun parse_rev(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val ok: bool = s.nargs == 2 && gp_data(?item.ops[0]) && gp_data(?item.ops[1]) && item.ops[0].size == item.ops[1].size;
    if (ok) { ret err[fail.Fail].ok{}; }
    ret vec_refused(c, s, "' takes two general registers of one width, such as rev x0, x1");
}

fun parse_ext(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    var ok: bool = s.nargs == 4;
    var i:  u32  = 0;
    for (ok && i < 3) {
        if (!full_lanes(?item.ops[i::usize]) || item.ops[i::usize].elem != 1) { ok = false; }
        i = i + 1;
    }
    if (ok) {
        val first: *isa_asm.Operand = ?item.ops[3];
        ok = first.kind == isa_asm.AOP_IMM && first.imm >= 0 && first.imm <= 15;
    }
    if (ok) {
        item.flags = arm64_inst.with_elem_bytes(item.flags, 1);
        ret err[fail.Fail].ok{};
    }
    ret vec_refused(c, s, "' takes three v.16b registers and the first byte, 0 to 15, such as ext v0.16b, v1.16b, v2.16b, 8");
}

fun parse_dup(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs == 2 && full_lanes(?item.ops[0])) {
        val elem: u8 = item.ops[0].elem;
        if (lane_fits(?item.ops[1], elem) || lane_gp(?item.ops[1], elem)) {
            if (!is_lane(?item.ops[1])) { item.code = arm64_inst.DUP_GEN::u32; }
            item.flags = arm64_inst.with_elem_bytes(item.flags, elem);
            ret err[fail.Fail].ok{};
        }
    }
    ret vec_refused(c, s, "' broadcasts a lane of the destination's element width, or a general register (x for .2d, w otherwise), such as dup v0.2d, v1.d[1]");
}

fun parse_ins(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs == 2 && is_lane(?item.ops[0])) {
        val elem: u8 = item.ops[0].elem;
        if (lane_fits(?item.ops[0], elem) && (lane_fits(?item.ops[1], elem) || lane_gp(?item.ops[1], elem))) {
            if (is_lane(?item.ops[1])) { item.code = arm64_inst.INS_EL::u32; }
            item.flags = arm64_inst.with_elem_bytes(item.flags, elem);
            ret err[fail.Fail].ok{};
        }
    }
    ret vec_refused(c, s, "' writes one lane from a lane of the same width, or from a general register (x for a .d lane, w otherwise), such as ins v0.d[1], x1");
}

fun emit_rev(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val w:  u8            = item.ops[0].size;
    var mi: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.REV, arm64_inst.gp(reg_number(item.ops[0].reg), w), arm64_inst.gp(reg_number(item.ops[1].reg), w), isa_inst.make_none());
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun emit_ext(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    arm64_emit.neon_ext(st, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(item.ops[2].reg), item.ops[3].imm::u32);
    ret err[fail.Fail].ok{};
}

# a lane operand becomes its whole register and the index beside it; a general
# register keeps its width
fun lane_source(op: *isa_asm.Operand) isa_inst.Operand {
    if (is_lane(op)) { ret arm64_inst.vec(reg_number(op.reg), 16); }
    ret arm64_inst.gp(reg_number(op.reg), op.size);
}

fun emit_dup(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val src:   *isa_asm.Operand = ?item.ops[1];
    var index: isa_inst.Operand = isa_inst.make_none();
    if (is_lane(src)) { index = isa_inst.make_imm(src.imm, 1); }
    var mi: isa_inst.Inst = arm64_emit.inst_of(item.code::arm64_inst.MachOp, arm64_inst.vec(reg_number(item.ops[0].reg), 16), lane_source(src), index);
    mi.flags = arm64_inst.with_elem_bytes(0, arm64_inst.elem_bytes(item.flags));
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun emit_ins(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val dst: *isa_asm.Operand = ?item.ops[0];
    val src: *isa_asm.Operand = ?item.ops[1];
    var mi:  isa_inst.Inst    = arm64_emit.inst_of(item.code::arm64_inst.MachOp, arm64_inst.vec(reg_number(dst.reg), 16), lane_source(src), isa_inst.make_imm(dst.imm, 1));
    if (is_lane(src)) { mi.src3 = isa_inst.make_imm(src.imm, 1); }
    mi.flags = arm64_inst.with_elem_bytes(0, arm64_inst.elem_bytes(item.flags));
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

# ld1/st1 {vT.<lanes>}, [Xn] [, #16 | , Xm]: one element structure, optionally post-indexed
fun parse_velem(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val n: u32 = s.nargs;
    if (n < 2 || n > 3) {
        ret vec_refused(c, s, "' expects {vT.<lanes>}, [Xn] and an optional post-index");
    }
    var lo: usize = s.arg_lo[0];
    var hi: usize = s.arg_hi[0];
    if (hi < lo + 2 || c.body[lo] != '{'::char || c.body[hi - 1] != '}'::char) {
        ret vec_refused(c, s, "' names its register list in braces, such as {v0.16b}");
    }
    lo = lo + 1;
    hi = hi - 1;
    for (lo < hi && isa_asm.is_space(c.body[lo])) { lo = lo + 1; }
    for (hi > lo && isa_asm.is_space(c.body[hi - 1])) { hi = hi - 1; }
    if (!vreg_region(c.body, lo, hi, ?item.ops[0]) || !full_lanes(?item.ops[0])) {
        ret vec_refused(c, s, "' takes one vector register with a lane arrangement, such as {v0.16b}");
    }

    val mem: *isa_asm.Operand = ?item.ops[1];
    if (mem.kind != isa_asm.AOP_MEM
        || (mem.flags & (isa_asm.AOF_HAS_INDEX | isa_asm.AOF_HAS_DISP | isa_asm.AOF_WRITEBACK | isa_asm.AOF_MEM_SYM)) != 0) {
        ret vec_refused(c, s, "' addresses a bare [Xn]");
    }
    if (n == 3) {
        val post: *isa_asm.Operand = ?item.ops[2];
        if (post.kind == isa_asm.AOP_IMM) {
            if (post.imm != 16) {
                ret vec_refused(c, s, "' post-indexes by the structure size, 16");
            }
            mem.imm = 16;
        }
        or (post.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(post) && post.size == 8 && reg_number(post.reg) != 31) {
            mem.index = post.reg;
        }
        or {
            ret vec_refused(c, s, "' post-indexes by 16 or by an X register other than xzr and sp");
        }
        mem.flags = mem.flags | isa_asm.AOF_WRITEBACK;
        item.nops = 2;
    }
    item.flags = arm64_inst.with_elem_bytes(item.flags, item.ops[0].elem);
    ret err[fail.Fail].ok{};
}

# the arrangement an inline-asm vector operand names; ARR_NONE for anything a
# crypto row never takes (.8h, a general register)
fun arrangement(op: *isa_asm.Operand) arm64_inst.Arrangement {
    if (!isa_asm.is_vreg(op) || is_lane(op)) { ret arm64_inst.ARR_NONE; }
    if (op.elem == 0)                        { ret arm64_inst.ARR_Q; }
    if (op.elem == 1)                        { ret arm64_inst.ARR_16B; }
    if (op.elem == 4)                        { ret arm64_inst.ARR_4S; }
    if (op.elem == 8 && op.size == 16)       { ret arm64_inst.ARR_2D; }
    if (op.elem == 8 && op.size == 8)        { ret arm64_inst.ARR_1D; }
    if (op.elem == 16)                       { ret arm64_inst.ARR_1Q; }
    ret arm64_inst.ARR_NONE;
}

# a crypto row takes exactly the operands its mop.CRYPTO_ROWS entry names, each
# at its one arrangement: sha256h q, q, v.4s; aese v.16b, v.16b; pmull v.1q, v.1d, v.1d
fun parse_crypto(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val row: *arm64_inst.CryptoRow = arm64_inst.crypto_row(item.code::arm64_inst.MachOp);
    if (row == nil) { ret err[fail.Fail].err{fail.message("internal compiler error: an inline-asm crypto row has no arrangement row")}; }
    var want: [3]arm64_inst.Arrangement = [3]arm64_inst.Arrangement{row.dst, row.src1, row.src2};
    var n:    u32                       = 3;
    if (row.src2 == arm64_inst.ARR_NONE) { n = 2; }
    var ok: bool = s.nargs == n;
    var i:  u32  = 0;
    for (ok && i < n) {
        if (arrangement(?item.ops[i::usize]) != want[i::usize]) { ok = false; }
        i = i + 1;
    }
    if (ok) { ret err[fail.Fail].ok{}; }
    val takes: res[str, fail.Fail] = crypto_takes(c, row.takes);
    if (sel takes.err) { ret err[fail.Fail].err{takes.err}; }
    ret vec_refused(c, s, takes.ok);
}

# "' takes <what the row takes>", the suffix of a crypto row's operand refusal
fun crypto_takes(c: *isa_asm.Cursor, takes: str) res[str, fail.Fail] {
    ret isa_asm.named_message(c.alloc, c.interner, "' takes ", takes, "");
}

fun emit_crypto(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    var src2: isa_inst.Operand = isa_inst.make_none();
    if (item.nops > 2) { src2 = arm64_inst.vec(reg_number(item.ops[2].reg), 16); }
    var mi: isa_inst.Inst = arm64_emit.inst_of(item.code::arm64_inst.MachOp, arm64_inst.vec(reg_number(item.ops[0].reg), 16), arm64_inst.vec(reg_number(item.ops[1].reg), 16), src2);
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun emit_vec(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val op: arm64_inst.MachOp = item.code::arm64_inst.MachOp;
    val eb: u8                = arm64_inst.elem_bytes(item.flags);
    val rt: u32               = reg_number(item.ops[0].reg);
    if (arm64_mnemonic.pattern(item.flags) == arm64_mnemonic.PATTERN_VELEM) {
        val base: *isa_asm.Operand = ?item.ops[1];
        arm64_emit.neon_elem(st, op, eb, rt, reg_number(base.reg), (base.flags & isa_asm.AOF_WRITEBACK) != 0, base.index);
        ret err[fail.Fail].ok{};
    }
    var src2: isa_inst.Operand = isa_inst.make_none();
    if (item.nops > 2) { src2 = arm64_inst.vec(reg_number(item.ops[2].reg), 16); }
    var mi: isa_inst.Inst = arm64_emit.inst_of(op, arm64_inst.vec(rt, 16), arm64_inst.vec(reg_number(item.ops[1].reg), 16), src2);
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun bare_addr(c: *isa_asm.Cursor, op: *isa_asm.Operand) err[fail.Fail] {
    if (op.kind != isa_asm.AOP_MEM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ordered access address must be a memory operand")}; }
    if ((op.flags & (isa_asm.AOF_HAS_INDEX | isa_asm.AOF_HAS_DISP | isa_asm.AOF_WRITEBACK | isa_asm.AOF_MEM_SYM)) != 0) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ordered access addressing must be a bare [Xn]")};
    }
    ret err[fail.Fail].ok{};
}

fun shift_amount(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item, idx: u32) err[fail.Fail] {
    var buf:    [24]u8;
    var amount: opt[u32] = opt[u32].none{};
    if (isa_asm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 24)) { amount = asm_parse_lsl_amount((?buf[0])::str); }
    if (sel amount.none) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk shift must be 'lsl N'")};
    }
    var hw: u32 = amount.some;
    if ((hw & 0xF) != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk shift must be a multiple of 16")}; }
    hw = hw / 16;
    if (is64(?item.ops[0])) {
        if (hw > 3) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk 64-bit shift exceeds lsl 48")}; }
    }
    or {
        if (hw > 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk 32-bit shift exceeds lsl 16")}; }
    }
    item.ops[idx::usize] = isa_asm.op_imm(hw::i64, 1);
    ret err[fail.Fail].ok{};
}

fun branch_target(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item, idx: u32, allow_sym: bool) err[fail.Fail] {
    val lo: usize                = s.arg_lo[idx::usize];
    val hi: usize                = s.arg_hi[idx::usize];
    val lr: res[bool, fail.Fail] = isa_asm.local_ref(c, lo, hi, item);
    if (sel lr.err) { ret err[fail.Fail].err{lr.err}; }
    if (lr.ok)      { ret err[fail.Fail].ok{}; }
    if (char_is_digit(c.body[lo])) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm numeric local-label reference must be 'Nf' or 'Nb'")};
    }
    if (!allow_sym) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm conditional branch to a symbol is unsupported (no imm19 relocation kind); branch to a numeric local label instead")};
    }
    if (!isa_asm.is_sym_region(c.body, lo, hi)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'b' target must be a symbol or a numeric local label")};
    }
    item.ref     = isa_asm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret err[fail.Fail].ok{};
}

fun emit(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, l: *isa_asm.Labels, item: *isa_asm.Item) err[fail.Fail] {
    val pat: u16 = arm64_mnemonic.pattern(item.flags);

    if (pat == arm64_mnemonic.PATTERN_NULLARY) {
        if (item.code == arm64_inst.RET::u32) {
            arm64_emit.return_lr(st);
            ret err[fail.Fail].ok{};
        }
        arm64_emit.nullary(st, item.code::arm64_inst.MachOp);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_RET_REG || pat == arm64_mnemonic.PATTERN_BR_REG) {
        arm64_emit.branch_reg(st, item.code::arm64_inst.MachOp, reg_number(item.ops[0].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_IMM16) {
        arm64_emit.imm16_inst(st, item.code::arm64_inst.MachOp, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MOV)      { ret emit_mov(st, item); }
    if (pat == arm64_mnemonic.PATTERN_MOVEWIDE) { ret emit_movewide(st, item); }
    if (pat == arm64_mnemonic.PATTERN_ADDSUB)   { ret emit_addsub(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_LOGICAL)  { ret emit_logical(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_MULH)     { ret emit_logical(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_CMP)      { ret emit_cmp(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_CSET) {
        val use64: bool = is64(?item.ops[0]);
        arm64_emit.cset(st, use64, reg_number(item.ops[0].reg), arm64_mnemonic.cond(item.flags));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ADRP)                                                                          { ret emit_adrp(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_BL)                                                                            { ret emit_call(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_B || pat == arm64_mnemonic.PATTERN_BCOND || pat == arm64_mnemonic.PATTERN_CBR) { ret emit_branch(st, c, l, item); }
    if (pat == arm64_mnemonic.PATTERN_LDST)                                                                          { ret emit_ldst(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_LDSTP)                                                                         { ret emit_ldstp(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_DMB || pat == arm64_mnemonic.PATTERN_ISB) {
        arm64_emit.barrier_op(st, item.code::arm64_inst.MachOp, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MSR) {
        if (item.ops[1].kind == isa_asm.AOP_IMM) {
            val f: u32 = item.ops[0].imm::u32;
            arm64_emit.msr_imm(st, (f >> 8) & 0x7, f & 0x7, item.ops[1].imm::u32);
            ret err[fail.Fail].ok{};
        }
        arm64_emit.msr_reg(st, item.ops[0].imm::u32, reg_number(item.ops[1].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MRS) {
        arm64_emit.mrs(st, item.ops[1].imm::u32, reg_number(item.ops[0].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_LDORD) { ret emit_ldord(st, item); }
    if (pat == arm64_mnemonic.PATTERN_STLXR) {
        arm64_emit.stxr(st, is64(?item.ops[1]), reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(item.ops[2].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_SHIFT)                                                                         { ret emit_shift(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_V3 || pat == arm64_mnemonic.PATTERN_V2 || pat == arm64_mnemonic.PATTERN_VELEM) { ret emit_vec(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VCRYPTO)                                                                       { ret emit_crypto(st, item); }
    if (pat == arm64_mnemonic.PATTERN_REV)                                                                           { ret emit_rev(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VEXT)                                                                          { ret emit_ext(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VDUP)                                                                          { ret emit_dup(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VINS)                                                                          { ret emit_ins(st, item); }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no emitter")};
}

fun emit_mov(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val dst:   *isa_asm.Operand = ?item.ops[0];
    val src:   *isa_asm.Operand = ?item.ops[1];
    val use64: bool             = is64(dst);
    if (src.kind == isa_asm.AOP_REG) {
        if (is_sp(dst) || is_sp(src)) {
            arm64_emit.addsub_imm(st, arm64_inst.ADD, use64, reg_number(dst.reg), reg_number(src.reg), 0, 0);
        }
        or {
            arm64_emit.alu3(st, arm64_inst.ORR, use64, reg_number(dst.reg), arm64_emit.ZR, reg_number(src.reg));
        }
        ret err[fail.Fail].ok{};
    }
    emit_asm_mov_imm(st, reg_number(dst.reg), src.imm::u64, use64);
    ret err[fail.Fail].ok{};
}

fun emit_movewide(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val use64: bool = is64(?item.ops[0]);
    var hw:    u32  = 0;
    if (item.nops == 3) { hw = item.ops[2].imm::u32; }
    arm64_emit.movewide(st, item.code::arm64_inst.MachOp, use64, reg_number(item.ops[0].reg), hw, item.ops[1].imm::u32);
    ret err[fail.Fail].ok{};
}

fun emit_addsub(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rd:     *isa_asm.Operand = ?item.ops[0];
    val rn:     *isa_asm.Operand = ?item.ops[1];
    val op3:    *isa_asm.Operand = ?item.ops[2];
    val use64:  bool             = is64(rd);
    val is_sub: bool             = item.code == arm64_inst.SUB::u32;

    val aop: arm64_inst.MachOp = item.code::arm64_inst.MachOp;
    if (op3.kind == isa_asm.AOP_IMM) {
        val v: i64 = op3.imm;
        if (v >= 0 && v <= 4095) {
            arm64_emit.addsub_imm(st, aop, use64, reg_number(rd.reg), reg_number(rn.reg), v::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            arm64_emit.addsub_imm(st, aop, use64, reg_number(rd.reg), reg_number(rn.reg), (v >> 12)::u32, 1);
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm add/sub immediate is out of imm12 range")};
    }
    if (op3.kind == isa_asm.AOP_SYM) {
        if (is_sub)                               { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'sub' has no :lo12: form")}; }
        if (op3.mod != isa_inst.SYM_MOD_PCREL_LO) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'add' symbol operand must be a ':lo12:sym'")}; }
        val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, op3);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.bytes.len::u32;
        arm64_emit.addsub_imm_sym(st, arm64_inst.ADD, use64, reg_number(rd.reg), reg_number(rn.reg), sid, isa_inst.SYM_MOD_PCREL_LO, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_ADD_LO12, sid, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }
    if (is_sp(rd) || is_sp(rn) || is_sp(op3)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm add/sub with SP and a register operand requires the extended-register form (unsupported)")};
    }
    arm64_emit.alu3(st, aop, use64, reg_number(rd.reg), reg_number(rn.reg), reg_number(op3.reg));
    ret err[fail.Fail].ok{};
}

# the logical rows and the high multiplies: three registers, index 31 is xzr
fun emit_logical(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    if (is_sp(?item.ops[0]) || is_sp(?item.ops[1]) || is_sp(?item.ops[2])) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm three-register form has no sp operand; register 31 there is always xzr")};
    }
    val use64: bool = is64(?item.ops[0]);
    arm64_emit.alu3(st, item.code::arm64_inst.MachOp, use64, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(item.ops[2].reg));
    ret err[fail.Fail].ok{};
}

fun emit_cmp(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rn:    *isa_asm.Operand = ?item.ops[0];
    val op2:   *isa_asm.Operand = ?item.ops[1];
    val use64: bool             = is64(rn);
    if (op2.kind == isa_asm.AOP_IMM) {
        if (op2.imm < 0 || op2.imm > 4095) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' second operand must be a register or imm12")}; }
        arm64_emit.addsub_imm(st, arm64_inst.SUBS, use64, arm64_emit.ZR, reg_number(rn.reg), op2.imm::u32, 0);
        ret err[fail.Fail].ok{};
    }
    if (is_sp(rn) || is_sp(op2)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm 'cmp' with sp and a register operand requires the extended-register form (unsupported)")};
    }
    arm64_emit.alu3(st, arm64_inst.SUBS, use64, arm64_emit.ZR, reg_number(rn.reg), reg_number(op2.reg));
    ret err[fail.Fail].ok{};
}

fun emit_adrp(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val sym: *isa_asm.Operand = ?item.ops[1];
    if (sym.mod == isa_inst.SYM_MOD_PCREL_LO || sym.mod == isa_inst.SYM_MOD_GOT_LO) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' names a page, so its symbol takes no low-half modifier")};
    }
    val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, sym);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    if (sym.mod == isa_inst.SYM_MOD_GOT_HI) { ret arm64_emit.adrp_got_reloc(st, reg_number(item.ops[0].reg), sid); }
    ret arm64_emit.adrp_reloc(st, reg_number(item.ops[0].reg), sid, 0);
}

fun emit_call(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, ?item.ops[0]);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    val pos: u32          = st.buf.bytes.len::u32;
    arm64_emit.branch_sym(st, arm64_inst.BL, sid, 0);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_PLT32, sid, 0);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_branch(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, l: *isa_asm.Labels, item: *isa_asm.Item) err[fail.Fail] {
    val pat: u16 = arm64_mnemonic.pattern(item.flags);

    if (item.ref == isa_asm.AR_SYM) {
        val name: str                        = (c.body::usize + item.ref_off)::str;
        val sr:   res[intern.StrId, A.Error] = intern.bytes_add(st.interner, name, item.ref_len);
        if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.bytes.len::u32;
        arm64_emit.branch_sym(st, arm64_inst.B, sid, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_JUMP26, sid, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }

    var bop:   arm64_inst.MachOp = arm64_inst.B;
    var cc:    u32               = 0;
    var rt:    u32               = 0;
    var use64: bool              = false;
    if (pat == arm64_mnemonic.PATTERN_BCOND) {
        bop = arm64_inst.BCOND;
        cc  = arm64_mnemonic.cond(item.flags) & 0xF;
    }
    or (pat == arm64_mnemonic.PATTERN_CBR) {
        bop   = item.code::arm64_inst.MachOp;
        use64 = is64(?item.ops[0]);
        rt    = reg_number(item.ops[0].reg);
    }

    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.branch_local(st, bop, cc, use64, rt, item.ref_num, item.ref_fwd);
    ret isa_asm.resolve_local(st, c, l, pos, item.ref_num, item.ref_fwd);
}

fun emit_ldst(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rt:      *isa_asm.Operand = ?item.ops[0];
    val mem:     *isa_asm.Operand = ?item.ops[1];
    val is_load: bool             = item.code == arm64_inst.LDR::u32 || item.code == arm64_inst.LDRB::u32 || item.code == arm64_inst.LDRH::u32;
    var w:       u8               = 4;
    if (is64(rt))                                                               { w = 8; }
    if (item.code == arm64_inst.LDRB::u32 || item.code == arm64_inst.STRB::u32) { w = 1; }
    or (item.code == arm64_inst.LDRH::u32 || item.code == arm64_inst.STRH::u32) { w = 2; }

    val fr: res[arm64_emit.Access, fail.Fail] = arm64_emit.int_access(w, is_load);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val acf: arm64_emit.Access = fr.ok;

    if ((mem.flags & isa_asm.AOF_MEM_SYM) != 0) {
        if (mem.mod != isa_inst.SYM_MOD_PCREL_LO && mem.mod != isa_inst.SYM_MOD_GOT_LO) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str symbol offset must be a ':lo12:sym' or ':got_lo12:sym'")};
        }
        val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, mem);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.bytes.len::u32;
        if (mem.mod == isa_inst.SYM_MOD_GOT_LO) {
            if (!is_load || w != 8) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ':got_lo12:' offset takes a 64-bit load")}; }
            arm64_emit.ldst_sym(st, arm64_inst.LDR, false, 8, reg_number(rt.reg), reg_number(mem.reg), sid, isa_inst.SYM_MOD_GOT_LO, 0);
            val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_GOT_LO12, sid, 0);
            if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
            ret err[fail.Fail].ok{};
        }
        arm64_emit.ldst_sym(st, acf.op, acf.fp, acf.width, reg_number(rt.reg), reg_number(mem.reg), sid, isa_inst.SYM_MOD_PCREL_LO, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), acf.lo12, sid, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }
    if ((mem.flags & isa_asm.AOF_HAS_INDEX) != 0) {
        arm64_emit.ldst_reg(st, acf.op, acf.fp, acf.width, reg_number(rt.reg), reg_number(mem.reg), reg_number(mem.index));
        ret err[fail.Fail].ok{};
    }
    val no_scratch_r: res[bool, fail.Fail] = arm64_emit.mem_access_needs_no_scratch(mem.imm, w);
    if (sel no_scratch_r.err) { ret err[fail.Fail].err{no_scratch_r.err}; }
    if (!no_scratch_r.ok) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, offset_message(c, mem.imm))};
    }
    ret arm64_emit.mem_access(st, reg_number(rt.reg), reg_number(mem.reg), mem.imm, w, is_load);
}

fun offset_message(c: *isa_asm.Cursor, off: i64) res[str, fail.Fail] {
    var buf: [24]u8;
    var v:   i64 = off;
    if (v < 0) { v = 0 - v; }
    val n: usize = std_format.put_u64(?buf[0], v::u64);
    buf[n] = 0;
    ret isa_asm.named_message(c.alloc, c.interner,
        "inline-asm ldr/str offset ", (?buf[0])::str,
        " is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first");
}

fun emit_ldstp(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val mem:     *isa_asm.Operand = ?item.ops[2];
    val is_load: bool             = item.code == arm64_inst.LDP::u32;
    var disp:    i64              = 0;
    var wb:      u16              = 0;
    if (item.nops == 4) {
        disp = item.ops[3].imm;
        wb   = arm64_inst.FLAG_WB_POST;
    }
    or {
        disp = mem.imm;
        if ((mem.flags & isa_asm.AOF_WRITEBACK) != 0) { wb = arm64_inst.FLAG_WB_PRE; }
    }
    if ((disp & 7) != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm stp/ldp offset must be a multiple of 8")}; }
    val q: i64 = disp / 8;
    if (q < -64 || q > 63) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm stp/ldp offset is out of the imm7 range")}; }
    var pop: arm64_inst.MachOp = arm64_inst.STP;
    if (is_load) { pop = arm64_inst.LDP; }
    arm64_emit.ldstp(st, pop, false, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(mem.reg), q::u32 & 0x7F, wb);
    ret err[fail.Fail].ok{};
}

fun emit_ldord(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val use64: bool = is64(?item.ops[0]);
    arm64_emit.ldord(st, item.code::arm64_inst.MachOp, use64, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg));
    ret err[fail.Fail].ok{};
}

fun emit_shift(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rd:  *isa_asm.Operand = ?item.ops[0];
    val rn:  *isa_asm.Operand = ?item.ops[1];
    val cnt: *isa_asm.Operand = ?item.ops[2];
    if (is_sp(rd) || is_sp(rn) || (cnt.kind == isa_asm.AOP_REG && is_sp(cnt))) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm shift has no sp operand form; register 31 there is always xzr")};
    }
    val use64: bool = is64(rd);
    var width: u32  = 32;
    if (use64) { width = 64; }

    val vform:  bool = item.code == arm64_inst.LSLV::u32 || item.code == arm64_inst.LSRV::u32 || item.code == arm64_inst.ASRV::u32;
    val is_lsr: bool = item.code == arm64_inst.LSR::u32 || item.code == arm64_inst.LSRV::u32;
    val is_asr: bool = item.code == arm64_inst.ASR::u32 || item.code == arm64_inst.ASRV::u32;

    if (cnt.kind == isa_asm.AOP_IMM && !vform) {
        val sh:  u32               = cnt.imm::u32 & (width - 1);
        var sop: arm64_inst.MachOp = arm64_inst.LSL;
        if (is_asr) { sop = arm64_inst.ASR; }
        or (is_lsr) { sop = arm64_inst.LSR; }
        arm64_emit.bitfield(st, sop, use64, reg_number(rd.reg), reg_number(rn.reg), sh, 0);
        ret err[fail.Fail].ok{};
    }
    if (cnt.kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm shift count must be a register or immediate")}; }
    var vop: arm64_inst.MachOp = arm64_inst.LSLV;
    if (is_lsr) { vop = arm64_inst.LSRV; }
    or (is_asr) { vop = arm64_inst.ASRV; }
    arm64_emit.alu3(st, vop, use64, reg_number(rd.reg), reg_number(rn.reg), reg_number(cnt.reg));
    ret err[fail.Fail].ok{};
}

fun intern_symbol(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, op: *isa_asm.Operand) res[intern.StrId, fail.Fail] {
    val interned: res[intern.StrId, A.Error] = intern.bytes_add(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
    if (sel interned.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(interned.err)}; }
    ret res[intern.StrId, fail.Fail].ok{interned.ok};
}

fun patch(st: *isa_encode.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    var fx: isa_encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret arm64_emit.patch_branch(st, ?fx, target_off);
}

fun writes_sp(item: *isa_asm.Item) bool {
    if (item.kind == isa_asm.AI_LABEL) { ret false; }
    if (item.kind == isa_asm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << arm64_emit.SP_REG)) != 0; }
        ret true;
    }
    if ((item.writes & isa_asm.AW_OP0) != 0 && item.nops > 0 && is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & isa_asm.AW_OP1) != 0 && item.nops > 1 && is_sp(?item.ops[1])) { ret true; }
    if ((item.writes & isa_asm.AW_WB_BASE) != 0) {
        var i: u32 = 0;
        for (i < item.nops) {
            val op: *isa_asm.Operand = ?item.ops[i::usize];
            if (op.kind == isa_asm.AOP_MEM && (op.flags & isa_asm.AOF_WRITEBACK) != 0 && is_sp(op)) {
                ret true;
            }
            i = i + 1;
        }
    }
    ret false;
}

# whether an asm body returns, for the middle end, which reads no grammar
pub fun returns(body: str) bool {
    ret isa_asm.returns(grammar, body);
}

pub fun grammar() isa_asm.Grammar {
    var g: isa_asm.Grammar;
    g.isa        = "aarch64";
    g.unknown    = "unknown aarch64 inline-asm instruction '";
    g.rows       = ?arm64_mnemonic.ROWS[0];
    g.row_count  = arm64_mnemonic.ROW_COUNT;
    g.data       = ?isa_asm.DIRECTIVES_WORD32[0];
    g.data_count = isa_asm.DIRECTIVE_COUNT;
    g.decode     = decode_bcond;
    g.parse      = parse;
    g.emit       = emit;
    g.patch      = patch;
    g.slot_sp    = true;
    g.writes_sp  = writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = target_model.ENDIAN_LITTLE;
    g.ct_class   = arm64_effects.asm_ct_class;
    g.note_bytes = isa_encode.render_bytes_directive;
    g.note_label = note_label;
    g.decl_reg   = decl_reg;
    g.no_fall    = no_fall;
    ret g;
}

fun no_fall(item: *isa_asm.Item) bool {
    if (item.kind != isa_asm.AI_INST) { ret false; }
    ret item.code == arm64_inst.BRK::u32;
}

fun decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: isa_asm.Operand = isa_asm.op_none();
    if (reg(name, ?op) && op.size == 8) {
        @bank = isa_asm.ABANK_GP;
        @idx  = reg_number(op.reg);
        ret true;
    }
    var n: u32 = 0;
    if (vec_index(name, ?n)) {
        @bank = isa_asm.ABANK_FP;
        @idx  = n;
        ret true;
    }
    ret false;
}

fun vec_index(name: str, out: *u32) bool {
    val len: usize = str_len(name);
    if (len < 2 || len > 3)   { ret false; }
    if (name[0] != 'v'::char) { ret false; }
    var n: u32   = 0;
    var i: usize = 1;
    for (i < len) {
        if (!char_is_digit(name[i])) { ret false; }
        n = n * 10 + (name[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    @out = n;
    ret true;
}

pub fun encode_asm_block(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    var g: isa_asm.Grammar = grammar();
    ret isa_asm.encode_block(st, ?g, f, mi);
}

fun note_label(st: *isa_encode.EncodeState, number: u32) err[fail.Fail] {
    ret arm64_printer.note_local_label(?st.buf, number);
}
