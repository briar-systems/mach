pub fun mnemonic(op: u16) opt[str] {
    ret arm64_inst.mnemonic(op::arm64_inst.MachOp);
}

fun asm_parse_cond(s: str, out: *u32) bool {
    if (str_equals(s, "eq")) {
        @out = arm64_emit.CC_EQ;
        ret true;
    }
    if (str_equals(s, "ne")) {
        @out = arm64_emit.CC_NE;
        ret true;
    }
    if (str_equals(s, "cs") || str_equals(s, "hs")) {
        @out = arm64_emit.CC_HS;
        ret true;
    }
    if (str_equals(s, "cc") || str_equals(s, "lo")) {
        @out = arm64_emit.CC_CC;
        ret true;
    }
    if (str_equals(s, "mi")) {
        @out = arm64_emit.CC_MI;
        ret true;
    }
    if (str_equals(s, "pl")) {
        @out = arm64_emit.CC_PL;
        ret true;
    }
    if (str_equals(s, "vs")) {
        @out = arm64_emit.CC_VS;
        ret true;
    }
    if (str_equals(s, "vc")) {
        @out = arm64_emit.CC_VC;
        ret true;
    }
    if (str_equals(s, "hi")) {
        @out = arm64_emit.CC_HI;
        ret true;
    }
    if (str_equals(s, "ls")) {
        @out = arm64_emit.CC_LS;
        ret true;
    }
    if (str_equals(s, "ge")) {
        @out = arm64_emit.CC_GE;
        ret true;
    }
    if (str_equals(s, "lt")) {
        @out = arm64_emit.CC_LT;
        ret true;
    }
    if (str_equals(s, "gt")) {
        @out = arm64_emit.CC_GT;
        ret true;
    }
    if (str_equals(s, "le")) {
        @out = arm64_emit.CC_LE;
        ret true;
    }
    if (str_equals(s, "al")) {
        @out = arm64_emit.CC_AL;
        ret true;
    }
    ret false;
}

# the amount of an `lsl N` shift, none for text that does not spell one
fun asm_parse_lsl_amount(s: str) opt[u32] {
    if (!str_starts_with(s, "lsl")) { ret opt[u32].none{}; }
    var i: usize = 3;
    for (s[i] != 0 && isa_asm.is_space(s[i])) { i = i + 1; }
    val rest: str                             = (s::usize + i)::str;
    val r:    res[i64, text_parse.ParseError] = text_parse.parse_i64_exact(rest, 0);
    if (sel r.err)                     { ret opt[u32].none{}; }
    if (r.ok < 0 || r.ok > 0xFFFFFFFF) { ret opt[u32].none{}; }
    ret opt[u32].some{r.ok::u32};
}

fun asm_barrier_option(name: str, out: *u32) bool {
    if (str_equals(name, "sy")) {
        @out = 15;
        ret true;
    }
    if (str_equals(name, "st")) {
        @out = 14;
        ret true;
    }
    if (str_equals(name, "ld")) {
        @out = 13;
        ret true;
    }
    if (str_equals(name, "ish")) {
        @out = 11;
        ret true;
    }
    if (str_equals(name, "ishst")) {
        @out = 10;
        ret true;
    }
    if (str_equals(name, "ishld")) {
        @out = 9;
        ret true;
    }
    if (str_equals(name, "nsh")) {
        @out = 7;
        ret true;
    }
    if (str_equals(name, "nshst")) {
        @out = 6;
        ret true;
    }
    if (str_equals(name, "nshld")) {
        @out = 5;
        ret true;
    }
    if (str_equals(name, "osh")) {
        @out = 3;
        ret true;
    }
    if (str_equals(name, "oshst")) {
        @out = 2;
        ret true;
    }
    if (str_equals(name, "oshld")) {
        @out = 1;
        ret true;
    }
    ret false;
}

fun emit_asm_mov_imm(st: *isa_encode.EncodeState, rd: u32, value: u64, use64: bool) {
    var v: u64 = value;
    if (!use64) { v = value & 0xFFFFFFFF; }
    var chunks: u32 = 2;
    if (use64) { chunks = 4; }
    var i: u32 = 0;
    for (i < chunks) {
        val sh:    u64 = 16::u64 * i::u64;
        val chunk: u64 = (v >> sh) & 0xFFFF;
        if ((chunk << sh) == v) {
            arm64_emit.movewide(st, arm64_inst.MOVZ, use64, rd, i, chunk::u32);
            ret;
        }
        i = i + 1;
    }
    arm64_emit.movewide_seq(st, rd, value, use64);
}

fun decode_bcond(body: str, lo: usize, hi: usize, m: *isa_asm.Mnemonic, n_out: *usize) bool {
    var end: usize = lo;
    for (end < hi && !isa_asm.is_space(body[end])) { end = end + 1; }
    val len: usize = end - lo;
    if (len < 4)                               { ret false; }
    if (!str_region_equals(body, lo, 2, "b.")) { ret false; }

    var buf: [8]u8;
    if (!isa_asm.copy_region(body, lo + 2, end, ?buf[0], 8)) { ret false; }
    var cc: u32 = 0;
    if (!asm_parse_cond((?buf[0])::str, ?cc)) { ret false; }

    m.name     = nil;
    m.code     = arm64_inst.B::u32;
    m.form     = isa_asm.AF_OPS;
    m.writes   = isa_asm.AW_NONE;
    m.implicit = 0;
    m.flags    = arm64_mnemonic.PATTERN_BCOND | ((cc::u16 << arm64_mnemonic.COND_SHIFT) & arm64_mnemonic.COND_MASK);
    m.words    = 1;
    @n_out     = len;
    ret true;
}

fun name_operand(pat: u16) u32 {
    if (pat == arm64_mnemonic.PATTERN_B || pat == arm64_mnemonic.PATTERN_BCOND || pat == arm64_mnemonic.PATTERN_DMB)  { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_ISB)                                                                            { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_VELEM)                                                                          { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_MSR)                                                                            { ret 0; }
    if (pat == arm64_mnemonic.PATTERN_CBR || pat == arm64_mnemonic.PATTERN_CSET || pat == arm64_mnemonic.PATTERN_MRS) { ret 1; }
    if (pat == arm64_mnemonic.PATTERN_MOVEWIDE)                                                                       { ret 2; }
    ret 0xFFFFFFFF;
}

fun operand(c: *isa_asm.Cursor, lo: usize, hi: usize, op: *isa_asm.Operand) err[fail.Fail] {
    @op = isa_asm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm operand")}; }

    if (c.body[lo] == '{'::char) {
        var off:     i64                  = 0;
        val bound_r: res[bool, fail.Fail] = isa_asm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op      = isa_asm.op_mem(arm64_inst.gp_id(arm64_emit.SP_REG), off, isa_inst.REG_NONE, 0, 8);
            op.flags = isa_asm.AOF_HAS_DISP | isa_asm.AOF_STACK_PTR;
            ret err[fail.Fail].ok{};
        }
        op.kind     = isa_asm.AOP_BIND;
        op.size     = 8;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    if (c.body[lo] == '['::char) { ret mem_operand(c, lo, hi, op); }
    if (c.body[lo] == ':'::char) { ret modifier(c, lo, hi, op); }

    if (reg_region(c.body, lo, hi, op))  { ret err[fail.Fail].ok{}; }
    if (vreg_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }

    val iv: opt[i64] = isa_asm.region_i64(c.body, lo, hi);
    if (sel iv.some) {
        @op = isa_asm.op_imm(iv.some, 8);
        ret err[fail.Fail].ok{};
    }

    if (isa_asm.is_sym_region(c.body, lo, hi)) {
        @op = isa_asm.op_sym(lo, hi - lo, isa_inst.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm operand")};
}

# the hardware number of an inline-asm operand's register id
fun reg_number(r: i32) u32 {
    ret isa_inst.regid_index(r)::u32;
}

fun reg_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "xzr")) {
        @op = isa_asm.op_reg(arm64_inst.gp_id(31), 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "wzr")) {
        @op = isa_asm.op_reg(arm64_inst.gp_id(31), 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "sp")) {
        @op      = isa_asm.op_reg(arm64_inst.gp_id(31), 8);
        op.flags = isa_asm.AOF_STACK_PTR;
        ret true;
    }
    if (str_region_equals(body, lo, len, "wsp")) {
        @op      = isa_asm.op_reg(arm64_inst.gp_id(31), 4);
        op.flags = isa_asm.AOF_STACK_PTR;
        ret true;
    }

    if (len < 2 || len > 3) { ret false; }
    val c0: char = body[lo];
    if (c0 != 'x'::char && c0 != 'w'::char) { ret false; }
    var n: u32   = 0;
    var i: usize = lo + 1;
    for (i < hi) {
        if (!char_is_digit(body[i])) { ret false; }
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 30) { ret false; }
    var w: u8 = 4;
    if (c0 == 'x'::char) { w = 8; }
    @op = isa_asm.op_reg(arm64_inst.gp_id(n), w);
    ret true;
}

# `vN.16b`, `vN.8h`, `vN.4s` or `vN.2d` (elem names the lane bytes), `qN` (no
# arrangement), or the carry-less multiply's `vN.1q` (one 16-byte lane) and
# `vN.1d` (one lane of the low half, size 8)
fun vreg_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    if (hi < lo + 2) { ret false; }
    val c0:  char  = body[lo];
    var end: usize = lo + 1;
    for (end < hi && char_is_digit(body[end])) { end = end + 1; }
    if (end == lo + 1 || end > lo + 3) { ret false; }
    var n: u32   = 0;
    var i: usize = lo + 1;
    for (i < end) {
        n = n * 10 + (body[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    var elem: u8 = 0;
    var size: u8 = 16;
    if (c0 == 'q'::char) {
        if (end != hi) { ret false; }
    }
    or (c0 == 'v'::char && lane_region(body, end, hi, op)) {
        op.reg  = arm64_inst.vec_id(n);
        op.bank = isa_asm.ABANK_FP;
        ret true;
    }
    or (c0 == 'v'::char) {
        val len: usize = hi - end;
        if (str_region_equals(body, end, len, ".16b")) { elem = 1; }
        or (str_region_equals(body, end, len, ".8h"))  { elem = 2; }
        or (str_region_equals(body, end, len, ".4s"))  { elem = 4; }
        or (str_region_equals(body, end, len, ".2d"))  { elem = 8; }
        or (str_region_equals(body, end, len, ".1q"))  { elem = 16; }
        or (str_region_equals(body, end, len, ".1d")) {
            elem = 8;
            size = 8;
        }
        or { ret false; }
    }
    or { ret false; }
    @op     = isa_asm.op_reg(arm64_inst.vec_id(n), size);
    op.elem = elem;
    ret true;
}

# `.b[i]`, `.h[i]`, `.s[i]` or `.d[i]` after a v register number: one element
# of that width, its index in imm. the index is bounded where a row reads it
fun lane_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    if (hi < lo + 5 || body[lo] != '.'::char || body[lo + 2] != '['::char || body[hi - 1] != ']'::char) { ret false; }
    val w:    char = body[lo + 1];
    var elem: u8   = 0;
    if (w == 'b'::char) { elem = 1; }
    or (w == 'h'::char) { elem = 2; }
    or (w == 's'::char) { elem = 4; }
    or (w == 'd'::char) { elem = 8; }
    or                  { ret false; }
    val idx: opt[i64] = isa_asm.region_i64(body, lo + 3, hi - 1);
    if (sel idx.none) { ret false; }
    var at: i64 = 0;
    if (sel idx.some)       { at = idx.some; }
    if (at < 0 || at > 255) { ret false; }
    @op      = isa_asm.op_reg(arm64_inst.vec_id(0), 16);
    op.elem  = elem;
    op.imm   = at;
    op.flags = isa_asm.AOF_LANE;
    ret true;
}

fun is_lane(op: *isa_asm.Operand) bool {
    ret isa_asm.is_vreg(op) && (op.flags & isa_asm.AOF_LANE) != 0;
}

fun reg(name: str, op: *isa_asm.Operand) bool {
    ret reg_region(name, 0, str_len(name), op);
}

fun modifier(c: *isa_asm.Cursor, lo: usize, hi: usize, op: *isa_asm.Operand) err[fail.Fail] {
    var close: usize = lo + 1;
    var found: bool  = false;
    for (close < hi && !found) {
        if (c.body[close] == ':'::char) { found = true; }
        or                              { close = close + 1; }
    }
    if (!found) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm relocation modifier")}; }
    val nlen: usize = close - lo - 1;

    var mod: isa_inst.SymModifier = isa_inst.SYM_MOD_NONE;
    if (str_region_equals(c.body, lo + 1, nlen, "lo12"))     { mod = isa_inst.SYM_MOD_PCREL_LO; }
    or (str_region_equals(c.body, lo + 1, nlen, "got"))      { mod = isa_inst.SYM_MOD_GOT_HI; }
    or (str_region_equals(c.body, lo + 1, nlen, "got_lo12")) { mod = isa_inst.SYM_MOD_GOT_LO; }
    or {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_UNSUPPORTED, isa_asm.span_message(c,
            "unsupported aarch64 inline-asm relocation modifier '", lo, hi, "'"))};
    }
    if (!isa_asm.is_sym_region(c.body, close + 1, hi)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm relocation modifier")};
    }
    @op = isa_asm.op_sym(close + 1, hi - close - 1, mod, 8);
    ret err[fail.Fail].ok{};
}

fun mem_operand(c: *isa_asm.Cursor, lo: usize, hi: usize, op: *isa_asm.Operand) err[fail.Fail] {
    @op     = isa_asm.op_none();
    op.kind = isa_asm.AOP_MEM;
    op.size = 8;

    var end: usize = hi;
    if (c.body[end - 1] == '!'::char) {
        op.flags = op.flags | isa_asm.AOF_WRITEBACK;
        end      = end - 1;
    }
    if (end < lo + 2 || c.body[end - 1] != ']'::char) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }

    val ilo:   usize = lo + 1;
    val ihi:   usize = end - 1;
    var comma: usize = ilo;
    var found: bool  = false;
    for (comma < ihi && !found) {
        if (c.body[comma] == ','::char) { found = true; }
        or                              { comma = comma + 1; }
    }

    var bbuf: [24]u8;
    var bend: usize = ihi;
    if (found)                                                 { bend = comma; }
    if (!isa_asm.copy_region(c.body, ilo, bend, ?bbuf[0], 24)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
    var base: isa_asm.Operand = isa_asm.op_none();
    if (!reg((?bbuf[0])::str, ?base)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
    op.reg   = base.reg;
    op.flags = op.flags | (base.flags & isa_asm.AOF_STACK_PTR);
    if (!found) { ret err[fail.Fail].ok{}; }

    var s: usize = comma + 1;
    var e: usize = ihi;
    for (s < e && isa_asm.is_space(c.body[s])) { s = s + 1; }
    for (e > s && isa_asm.is_space(c.body[e - 1])) { e = e - 1; }
    if (e <= s) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }

    if (c.body[s] == ':'::char) {
        var sym: isa_asm.Operand = isa_asm.op_none();
        val mr:  err[fail.Fail]  = modifier(c, s, e, ?sym);
        if (sel mr.err) { ret mr; }
        op.flags    = op.flags | isa_asm.AOF_MEM_SYM;
        op.mod      = sym.mod;
        op.name_off = sym.name_off;
        op.name_len = sym.name_len;
        ret err[fail.Fail].ok{};
    }

    var ibuf: [24]u8;
    if (isa_asm.copy_region(c.body, s, e, ?ibuf[0], 24)) {
        var idx: isa_asm.Operand = isa_asm.op_none();
        if (reg((?ibuf[0])::str, ?idx)) {
            if (is_sp(?idx)) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm memory index register has no sp form; register 31 there is always xzr")};
            }
            op.flags = op.flags | isa_asm.AOF_HAS_INDEX;
            op.index = idx.reg;
            if (idx.size == 8) { op.flags = op.flags | isa_asm.AOF_WIDE; }
            ret err[fail.Fail].ok{};
        }
    }
    val dv: opt[i64] = isa_asm.region_i64(c.body, s, e);
    if (!sel dv.some) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
    op.imm   = dv.some;
    op.flags = op.flags | isa_asm.AOF_HAS_DISP;
    ret err[fail.Fail].ok{};
}

fun is_addr(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_MEM || op.kind == isa_asm.AOP_BIND;
}

fun is64(op: *isa_asm.Operand) bool {
    ret op.size == 8;
}

fun is_sp(op: *isa_asm.Operand) bool {
    ret (op.flags & isa_asm.AOF_STACK_PTR) != 0;
}

fun parse(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val pat:     u16 = arm64_mnemonic.pattern(s.m.flags);
    val n:       u32 = s.nargs;
    val name_at: u32 = name_operand(pat);

    var i: u32 = 0;
    for (i < n) {
        if (i != name_at) {
            val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], ?item.ops[i::usize]);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }

    if (pat == arm64_mnemonic.PATTERN_V3 || pat == arm64_mnemonic.PATTERN_V2 || pat == arm64_mnemonic.PATTERN_VELEM) { ret parse_vec(c, s, item, pat); }
    if (pat == arm64_mnemonic.PATTERN_VCRYPTO)                                                                       { ret parse_crypto(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_REV)                                                                           { ret parse_rev(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_VEXT)                                                                          { ret parse_ext(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_VDUP)                                                                          { ret parse_dup(c, s, item); }
    if (pat == arm64_mnemonic.PATTERN_VINS)                                                                          { ret parse_ins(c, s, item); }
    if (s.m.code == arm64_inst.MOV::u32 && n == 2 && is_lane(?item.ops[0])) {
        item.code  = arm64_inst.INS::u32;
        item.flags = arm64_mnemonic.PATTERN_VINS;
        ret parse_ins(c, s, item);
    }
    if (names_vreg(item, n)) {
        val twin: *isa_asm.Mnemonic = vec_twin(s.m.code);
        if (twin == nil) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "' takes general-purpose registers, not a vector register"))};
        }
        item.code   = twin.code;
        item.flags  = twin.flags;
        item.writes = twin.writes;
        ret parse_vec(c, s, item, arm64_mnemonic.pattern(twin.flags));
    }

    if (pat == arm64_mnemonic.PATTERN_NULLARY) {
        if (n != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction takes no operands")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_RET_REG || pat == arm64_mnemonic.PATTERN_BR_REG) {
        if (n != 1)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction expects one register")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ret/blr/br operand must be a register")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_IMM16) {
        if (n != 1)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].kind != isa_asm.AOP_IMM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm svc/brk needs an immediate")}; }
        if (item.ops[0].imm < 0 || item.ops[0].imm > 0xFFFF) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm svc/brk immediate is out of 16-bit range")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MOV) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' expects two operands")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' destination must be a register")}; }
        if (item.ops[1].kind == isa_asm.AOP_REG) {
            if (item.ops[0].size != item.ops[1].size) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' operands are different widths; aarch64 has one size flag for the whole instruction")};
            }
            item.words = 1;
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind == isa_asm.AOP_IMM) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'mov' source must be a register or immediate")};
    }
    if (pat == arm64_mnemonic.PATTERN_MOVEWIDE) {
        if (n < 2 || n > 3)                      { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk expects Rd, imm [, lsl N]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk destination must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_IMM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk needs an immediate")}; }
        if (item.ops[1].imm < 0 || item.ops[1].imm > 0xFFFF) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk immediate is out of 16-bit range")};
        }
        if (n == 3) { ret shift_amount(c, s, item, 2); }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ADDSUB || pat == arm64_mnemonic.PATTERN_LOGICAL || pat == arm64_mnemonic.PATTERN_SHIFT || pat == arm64_mnemonic.PATTERN_MULH) {
        if (n != 3)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction expects three operands")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm destination must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm first source must be a register")}; }
        if (item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        if (pat == arm64_mnemonic.PATTERN_LOGICAL && item.ops[2].kind != isa_asm.AOP_REG) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm and/orr/eor immediate (bitmask) form unsupported; use a register operand")};
        }
        if (pat == arm64_mnemonic.PATTERN_MULH && item.ops[2].kind != isa_asm.AOP_REG) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm umulh/smulh takes three registers")};
        }
        if (pat == arm64_mnemonic.PATTERN_MULH && item.ops[0].size != 8) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm umulh/smulh has no 32-bit form; use x registers")};
        }
        if (pat == arm64_mnemonic.PATTERN_SHIFT && item.ops[2].kind != isa_asm.AOP_REG && item.ops[2].kind != isa_asm.AOP_IMM) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm shift count must be a register or immediate")};
        }
        # `lsl` with a register count is the lslv alias: the variable-latency
        # member, and the constant-time class must see it as one
        if (pat == arm64_mnemonic.PATTERN_SHIFT && item.ops[2].kind == isa_asm.AOP_REG) {
            if (item.code == arm64_inst.LSL::u32) { item.code = arm64_inst.LSLV::u32; }
            if (item.code == arm64_inst.LSR::u32) { item.code = arm64_inst.LSRV::u32; }
            if (item.code == arm64_inst.ASR::u32) { item.code = arm64_inst.ASRV::u32; }
        }
        if (item.ops[2].kind == isa_asm.AOP_REG && item.ops[0].size != item.ops[2].size) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_CMP) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' expects two operands")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' first operand must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG && item.ops[1].kind != isa_asm.AOP_IMM) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' second operand must be a register or imm12")};
        }
        if (item.ops[1].kind == isa_asm.AOP_REG && item.ops[0].size != item.ops[1].size) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' operands are different widths; aarch64 has one size flag for the whole instruction")};
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_CSET) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cset' expects Rd, cond")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cset' destination must be a register")}; }
        var buf: [8]u8;
        var cc:  u32 = 0;
        if (!isa_asm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?buf[0], 8) || !asm_parse_cond((?buf[0])::str, ?cc)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cset' condition is unrecognized")};
        }
        item.flags = item.flags | ((cc::u16 << arm64_mnemonic.COND_SHIFT) & arm64_mnemonic.COND_MASK);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ADRP) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' expects Xd, symbol")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' destination must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_SYM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_BL) {
        if (n != 1)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'bl' expects a symbol")}; }
        if (item.ops[0].kind != isa_asm.AOP_SYM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'bl' target must be a symbol")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_B) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'b' expects a target")}; }
        ret branch_target(c, s, item, 0, true);
    }
    if (pat == arm64_mnemonic.PATTERN_BCOND) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm conditional branch expects a target")}; }
        ret branch_target(c, s, item, 0, false);
    }
    if (pat == arm64_mnemonic.PATTERN_CBR) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm cbz/cbnz expects Rt, target")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm cbz/cbnz first operand must be a register")}; }
        ret branch_target(c, s, item, 1, false);
    }
    if (pat == arm64_mnemonic.PATTERN_LDST) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str expects Rt, [mem]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str value must be a register")}; }
        if (!is_addr(?item.ops[1]))              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str address must be a memory operand")}; }
        if ((item.ops[1].flags & isa_asm.AOF_WRITEBACK) != 0) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm ldr/str writeback addressing unsupported")};
        }
        if ((item.ops[1].flags & isa_asm.AOF_HAS_DISP) != 0) { item.words = isa_asm.WORDS_VARIABLE; }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_LDSTP) {
        if (n < 3 || n > 4)                                             { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp expects Xa, Xb, [mem] [, imm]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG || !is64(?item.ops[0])) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG || !is64(?item.ops[1])) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp registers must be X registers")}; }
        if (item.ops[2].kind != isa_asm.AOP_MEM)                        { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp address must be a memory operand")}; }
        if ((item.ops[2].flags & (isa_asm.AOF_HAS_INDEX | isa_asm.AOF_MEM_SYM)) != 0) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp address must be [Xn] or [Xn, imm]")};
        }
        if (n == 4) {
            if ((item.ops[2].flags & (isa_asm.AOF_HAS_DISP | isa_asm.AOF_WRITEBACK)) != 0) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp post-index base must be a bare [Xn]")};
            }
            if (item.ops[3].kind != isa_asm.AOP_IMM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stp/ldp post-index needs an immediate")}; }
            item.ops[2].flags = item.ops[2].flags | isa_asm.AOF_WRITEBACK;
        }
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_DMB) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm dmb/dsb expects one barrier option")}; }
        var buf:  [8]u8;
        var opt_: u32 = 0;
        if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?buf[0], 8) || !asm_barrier_option((?buf[0])::str, ?opt_)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm dmb/dsb barrier option")};
        }
        item.ops[0] = isa_asm.op_imm(opt_::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ISB) {
        # the architecture defines one option, `sy` (CRm 0b1111), and the bare
        # spelling means it; every other CRm is reserved and never emitted
        if (n > 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm isb takes no operand or the option `sy`")}; }
        if (n == 1) {
            var ibuf: [8]u8;
            var iopt: u32 = 0;
            if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?ibuf[0], 8) || !asm_barrier_option((?ibuf[0])::str, ?iopt) || iopt != 15) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm isb takes no operand or the option `sy`")};
            }
        }
        item.ops[0] = isa_asm.op_imm(15, 1);
        item.nops   = 1;
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MSR) {
        if (n != 2) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm msr expects a system register or PSTATE field and a source")}; }
        var nbuf: [arm64_emit.SYSREG_NAME_MAX]u8;
        if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?nbuf[0], arm64_emit.SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm msr destination name is too long")};
        }
        var op1: u32 = 0;
        var op2: u32 = 0;
        if (item.ops[1].kind == isa_asm.AOP_IMM) {
            if (!arm64_emit.pstate_field((?nbuf[0])::str, ?op1, ?op2)) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm msr PSTATE field")};
            }
            if (item.ops[1].imm < 0 || item.ops[1].imm > 15) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm msr immediate must be 0-15")};
            }
            item.ops[0] = isa_asm.op_imm(((op1 << 8) | op2)::i64, 1);
            ret err[fail.Fail].ok{};
        }
        if (item.ops[1].kind != isa_asm.AOP_REG) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm msr source must be an immediate or a register")};
        }
        var op0: u32 = 0;
        var crn: u32 = 0;
        var crm: u32 = 0;
        if (!arm64_emit.sysreg((?nbuf[0])::str, ?op0, ?op1, ?crn, ?crm, ?op2)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm msr system register")};
        }
        item.ops[0] = isa_asm.op_imm(arm64_emit.sysreg_pack(op0, op1, crn, crm, op2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MRS) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm mrs expects Xt, <sysreg>")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm mrs destination must be a register")}; }
        var mbuf: [arm64_emit.SYSREG_NAME_MAX]u8;
        if (!isa_asm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?mbuf[0], arm64_emit.SYSREG_NAME_MAX)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm mrs system register name is too long")};
        }
        var m0: u32 = 0;
        var m1: u32 = 0;
        var mn: u32 = 0;
        var mm: u32 = 0;
        var m2: u32 = 0;
        if (!arm64_emit.sysreg((?mbuf[0])::str, ?m0, ?m1, ?mn, ?mm, ?m2)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "unsupported inline-asm mrs system register")};
        }
        item.ops[1] = isa_asm.op_imm(arm64_emit.sysreg_pack(m0, m1, mn, mm, m2)::i64, 1);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_LDORD) {
        if (n != 2)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldar/stlr/ldaxr expects Rt, [Xn]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldar/stlr/ldaxr value must be a register")}; }
        ret bare_addr(c, ?item.ops[1]);
    }
    if (pat == arm64_mnemonic.PATTERN_STLXR) {
        if (n != 3)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stlxr expects Ws, Rt, [Xn]")}; }
        if (item.ops[0].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stlxr status must be a register")}; }
        if (item.ops[1].kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm stlxr value must be a register")}; }
        ret bare_addr(c, ?item.ops[2]);
    }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no parser")};
}

fun names_vreg(item: *isa_asm.Item, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (isa_asm.is_vreg(?item.ops[i::usize])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun vec_twin(code: u32) *isa_asm.Mnemonic {
    var gp: u32 = arm64_inst.MOP_NONE::u32;
    if (code == arm64_inst.ADD::u32) { gp = arm64_inst.V_ADD::u32; }
    or (code == arm64_inst.SUB::u32) { gp = arm64_inst.V_SUB::u32; }
    or (code == arm64_inst.AND::u32) { gp = arm64_inst.V_AND::u32; }
    or (code == arm64_inst.ORR::u32) { gp = arm64_inst.V_ORR::u32; }
    or (code == arm64_inst.EOR::u32) { gp = arm64_inst.V_EOR::u32; }
    or (code == arm64_inst.MOV::u32) { gp = arm64_inst.V_MOV::u32; }
    var i: usize = 0;
    for (i < arm64_mnemonic.VEC_TWIN_COUNT) {
        if (arm64_mnemonic.VEC_TWINS[i].code == gp) { ret ?arm64_mnemonic.VEC_TWINS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun named_message(c: *isa_asm.Cursor, s: *isa_asm.Stmt, suffix: str) res[str, fail.Fail] {
    ret isa_asm.named_message(c.alloc, c.interner, "inline-asm instruction '", s.m.name, suffix);
}

fun vec_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt, suffix: str) err[fail.Fail] {
    ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, suffix))};
}

# a whole 128-bit v register at one of the lane arrangements the lane-wise rows
# take: .16b, .8h, .4s or .2d, never q, .1q or the half-register .1d
fun full_lanes(op: *isa_asm.Operand) bool {
    ret isa_asm.is_vreg(op) && !is_lane(op) && op.size == 16 && op.elem != 0 && op.elem <= 8;
}

# whether a member's lanes may be `elem` bytes wide
fun lane_admits(code: u32, elem: u8) bool {
    if (elem == 0 || elem > 8) { ret false; }
    val lane: arm64_inst.LaneClass = arm64_inst.form(code::arm64_inst.MachOp).lane;
    if (lane == arm64_inst.LANE_BITS)                                     { ret elem == 1; }
    if (lane == arm64_inst.LANE_FLOAT)                                    { ret elem == 4 || elem == 8; }
    if (code == arm64_inst.V_MUL::u32 || code == arm64_inst.V_REV64::u32) { ret elem != 8; }
    ret true;
}

fun parse_vec(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item, pat: u16) err[fail.Fail] {
    val n: u32 = s.nargs;
    if (pat == arm64_mnemonic.PATTERN_VELEM) { ret parse_velem(c, s, item); }

    var want: u32 = 3;
    if (pat == arm64_mnemonic.PATTERN_V2) { want = 2; }
    if (n != want) {
        if (want == 2) { ret vec_refused(c, s, "' expects two vector registers"); }
        ret vec_refused(c, s, "' expects three vector registers");
    }
    var i: u32 = 0;
    for (i < n) {
        if (!full_lanes(?item.ops[i::usize])) {
            ret vec_refused(c, s, "' takes vector registers with a lane arrangement, such as v0.4s");
        }
        if (item.ops[i::usize].elem != item.ops[0].elem) {
            ret vec_refused(c, s, "' names different lane arrangements; its operands share one");
        }
        i = i + 1;
    }

    var member: u32 = item.code;
    if (member == arm64_inst.V_MOV::u32) { member = arm64_inst.V_ORR::u32; }
    if (!lane_admits(member, item.ops[0].elem)) {
        ret vec_refused(c, s, "' has no form at this lane arrangement");
    }
    if (item.code == arm64_inst.V_MOV::u32) {
        item.code   = arm64_inst.V_ORR::u32;
        item.ops[2] = item.ops[1];
        item.nops   = 3;
    }
    item.flags = arm64_inst.with_elem_bytes(item.flags, item.ops[0].elem);
    ret err[fail.Fail].ok{};
}

# a general register other than sp, the source or destination of a lane row
fun gp_data(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(op) && !is_sp(op);
}

# a lane of `elem` bytes whose index the register holds
fun lane_fits(op: *isa_asm.Operand, elem: u8) bool {
    ret is_lane(op) && op.elem == elem && op.imm >= 0 && op.imm < (16 / elem::i64);
}

# the general register a lane of `elem` bytes moves through: x for a doubleword, w otherwise
fun lane_gp(op: *isa_asm.Operand, elem: u8) bool {
    if (!gp_data(op)) { ret false; }
    if (elem == 8)    { ret op.size == 8; }
    ret op.size == 4;
}

fun parse_rev(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val ok: bool = s.nargs == 2 && gp_data(?item.ops[0]) && gp_data(?item.ops[1]) && item.ops[0].size == item.ops[1].size;
    if (ok) { ret err[fail.Fail].ok{}; }
    ret vec_refused(c, s, "' takes two general registers of one width, such as rev x0, x1");
}

fun parse_ext(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    var ok: bool = s.nargs == 4;
    var i:  u32  = 0;
    for (ok && i < 3) {
        if (!full_lanes(?item.ops[i::usize]) || item.ops[i::usize].elem != 1) { ok = false; }
        i = i + 1;
    }
    if (ok) {
        val first: *isa_asm.Operand = ?item.ops[3];
        ok = first.kind == isa_asm.AOP_IMM && first.imm >= 0 && first.imm <= 15;
    }
    if (ok) {
        item.flags = arm64_inst.with_elem_bytes(item.flags, 1);
        ret err[fail.Fail].ok{};
    }
    ret vec_refused(c, s, "' takes three v.16b registers and the first byte, 0 to 15, such as ext v0.16b, v1.16b, v2.16b, 8");
}

fun parse_dup(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs == 2 && full_lanes(?item.ops[0])) {
        val elem: u8 = item.ops[0].elem;
        if (lane_fits(?item.ops[1], elem) || lane_gp(?item.ops[1], elem)) {
            if (!is_lane(?item.ops[1])) { item.code = arm64_inst.DUP_GEN::u32; }
            item.flags = arm64_inst.with_elem_bytes(item.flags, elem);
            ret err[fail.Fail].ok{};
        }
    }
    ret vec_refused(c, s, "' broadcasts a lane of the destination's element width, or a general register (x for .2d, w otherwise), such as dup v0.2d, v1.d[1]");
}

fun parse_ins(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs == 2 && is_lane(?item.ops[0])) {
        val elem: u8 = item.ops[0].elem;
        if (lane_fits(?item.ops[0], elem) && (lane_fits(?item.ops[1], elem) || lane_gp(?item.ops[1], elem))) {
            if (is_lane(?item.ops[1])) { item.code = arm64_inst.INS_EL::u32; }
            item.flags = arm64_inst.with_elem_bytes(item.flags, elem);
            ret err[fail.Fail].ok{};
        }
    }
    ret vec_refused(c, s, "' writes one lane from a lane of the same width, or from a general register (x for a .d lane, w otherwise), such as ins v0.d[1], x1");
}

fun emit_rev(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val w:  u8            = item.ops[0].size;
    var mi: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.REV, arm64_inst.gp(reg_number(item.ops[0].reg), w), arm64_inst.gp(reg_number(item.ops[1].reg), w), isa_inst.make_none());
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun emit_ext(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    arm64_emit.neon_ext(st, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(item.ops[2].reg), item.ops[3].imm::u32);
    ret err[fail.Fail].ok{};
}

# a lane operand becomes its whole register and the index beside it; a general
# register keeps its width
fun lane_source(op: *isa_asm.Operand) isa_inst.Operand {
    if (is_lane(op)) { ret arm64_inst.vec(reg_number(op.reg), 16); }
    ret arm64_inst.gp(reg_number(op.reg), op.size);
}

fun emit_dup(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val src:   *isa_asm.Operand = ?item.ops[1];
    var index: isa_inst.Operand = isa_inst.make_none();
    if (is_lane(src)) { index = isa_inst.make_imm(src.imm, 1); }
    var mi: isa_inst.Inst = arm64_emit.inst_of(item.code::arm64_inst.MachOp, arm64_inst.vec(reg_number(item.ops[0].reg), 16), lane_source(src), index);
    mi.flags = arm64_inst.with_elem_bytes(0, arm64_inst.elem_bytes(item.flags));
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun emit_ins(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val dst: *isa_asm.Operand = ?item.ops[0];
    val src: *isa_asm.Operand = ?item.ops[1];
    var mi:  isa_inst.Inst    = arm64_emit.inst_of(item.code::arm64_inst.MachOp, arm64_inst.vec(reg_number(dst.reg), 16), lane_source(src), isa_inst.make_imm(dst.imm, 1));
    if (is_lane(src)) { mi.src3 = isa_inst.make_imm(src.imm, 1); }
    mi.flags = arm64_inst.with_elem_bytes(0, arm64_inst.elem_bytes(item.flags));
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

# ld1/st1 {vT.<lanes>}, [Xn] [, #16 | , Xm]: one element structure, optionally post-indexed
fun parse_velem(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val n: u32 = s.nargs;
    if (n < 2 || n > 3) {
        ret vec_refused(c, s, "' expects {vT.<lanes>}, [Xn] and an optional post-index");
    }
    var lo: usize = s.arg_lo[0];
    var hi: usize = s.arg_hi[0];
    if (hi < lo + 2 || c.body[lo] != '{'::char || c.body[hi - 1] != '}'::char) {
        ret vec_refused(c, s, "' names its register list in braces, such as {v0.16b}");
    }
    lo = lo + 1;
    hi = hi - 1;
    for (lo < hi && isa_asm.is_space(c.body[lo])) { lo = lo + 1; }
    for (hi > lo && isa_asm.is_space(c.body[hi - 1])) { hi = hi - 1; }
    if (!vreg_region(c.body, lo, hi, ?item.ops[0]) || !full_lanes(?item.ops[0])) {
        ret vec_refused(c, s, "' takes one vector register with a lane arrangement, such as {v0.16b}");
    }

    val mem: *isa_asm.Operand = ?item.ops[1];
    if (mem.kind != isa_asm.AOP_MEM
        || (mem.flags & (isa_asm.AOF_HAS_INDEX | isa_asm.AOF_HAS_DISP | isa_asm.AOF_WRITEBACK | isa_asm.AOF_MEM_SYM)) != 0) {
        ret vec_refused(c, s, "' addresses a bare [Xn]");
    }
    if (n == 3) {
        val post: *isa_asm.Operand = ?item.ops[2];
        if (post.kind == isa_asm.AOP_IMM) {
            if (post.imm != 16) {
                ret vec_refused(c, s, "' post-indexes by the structure size, 16");
            }
            mem.imm = 16;
        }
        or (post.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(post) && post.size == 8 && reg_number(post.reg) != 31) {
            mem.index = post.reg;
        }
        or {
            ret vec_refused(c, s, "' post-indexes by 16 or by an X register other than xzr and sp");
        }
        mem.flags = mem.flags | isa_asm.AOF_WRITEBACK;
        item.nops = 2;
    }
    item.flags = arm64_inst.with_elem_bytes(item.flags, item.ops[0].elem);
    ret err[fail.Fail].ok{};
}

# the arrangement an inline-asm vector operand names; ARR_NONE for anything a
# crypto row never takes (.8h, a general register)
fun arrangement(op: *isa_asm.Operand) arm64_inst.Arrangement {
    if (!isa_asm.is_vreg(op) || is_lane(op)) { ret arm64_inst.ARR_NONE; }
    if (op.elem == 0)                        { ret arm64_inst.ARR_Q; }
    if (op.elem == 1)                        { ret arm64_inst.ARR_16B; }
    if (op.elem == 4)                        { ret arm64_inst.ARR_4S; }
    if (op.elem == 8 && op.size == 16)       { ret arm64_inst.ARR_2D; }
    if (op.elem == 8 && op.size == 8)        { ret arm64_inst.ARR_1D; }
    if (op.elem == 16)                       { ret arm64_inst.ARR_1Q; }
    ret arm64_inst.ARR_NONE;
}

# a crypto row takes exactly the operands its mop.CRYPTO_ROWS entry names, each
# at its one arrangement: sha256h q, q, v.4s; aese v.16b, v.16b; pmull v.1q, v.1d, v.1d
fun parse_crypto(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val row: *arm64_inst.CryptoRow = arm64_inst.crypto_row(item.code::arm64_inst.MachOp);
    if (row == nil) { ret err[fail.Fail].err{fail.message("internal compiler error: an inline-asm crypto row has no arrangement row")}; }
    var want: [3]arm64_inst.Arrangement = [3]arm64_inst.Arrangement{row.dst, row.src1, row.src2};
    var n:    u32                       = 3;
    if (row.src2 == arm64_inst.ARR_NONE) { n = 2; }
    var ok: bool = s.nargs == n;
    var i:  u32  = 0;
    for (ok && i < n) {
        if (arrangement(?item.ops[i::usize]) != want[i::usize]) { ok = false; }
        i = i + 1;
    }
    if (ok) { ret err[fail.Fail].ok{}; }
    val takes: res[str, fail.Fail] = crypto_takes(c, row.takes);
    if (sel takes.err) { ret err[fail.Fail].err{takes.err}; }
    ret vec_refused(c, s, takes.ok);
}

# "' takes <what the row takes>", the suffix of a crypto row's operand refusal
fun crypto_takes(c: *isa_asm.Cursor, takes: str) res[str, fail.Fail] {
    ret isa_asm.named_message(c.alloc, c.interner, "' takes ", takes, "");
}

fun emit_crypto(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    var src2: isa_inst.Operand = isa_inst.make_none();
    if (item.nops > 2) { src2 = arm64_inst.vec(reg_number(item.ops[2].reg), 16); }
    var mi: isa_inst.Inst = arm64_emit.inst_of(item.code::arm64_inst.MachOp, arm64_inst.vec(reg_number(item.ops[0].reg), 16), arm64_inst.vec(reg_number(item.ops[1].reg), 16), src2);
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun emit_vec(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val op: arm64_inst.MachOp = item.code::arm64_inst.MachOp;
    val eb: u8                = arm64_inst.elem_bytes(item.flags);
    val rt: u32               = reg_number(item.ops[0].reg);
    if (arm64_mnemonic.pattern(item.flags) == arm64_mnemonic.PATTERN_VELEM) {
        val base: *isa_asm.Operand = ?item.ops[1];
        arm64_emit.neon_elem(st, op, eb, rt, reg_number(base.reg), (base.flags & isa_asm.AOF_WRITEBACK) != 0, base.index);
        ret err[fail.Fail].ok{};
    }
    var src2: isa_inst.Operand = isa_inst.make_none();
    if (item.nops > 2) { src2 = arm64_inst.vec(reg_number(item.ops[2].reg), 16); }
    var mi: isa_inst.Inst = arm64_emit.inst_of(op, arm64_inst.vec(rt, 16), arm64_inst.vec(reg_number(item.ops[1].reg), 16), src2);
    mi.flags = arm64_inst.with_elem_bytes(0, eb);
    arm64_emit.inst(st, ?mi);
    ret err[fail.Fail].ok{};
}

fun bare_addr(c: *isa_asm.Cursor, op: *isa_asm.Operand) err[fail.Fail] {
    if (op.kind != isa_asm.AOP_MEM) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ordered access address must be a memory operand")}; }
    if ((op.flags & (isa_asm.AOF_HAS_INDEX | isa_asm.AOF_HAS_DISP | isa_asm.AOF_WRITEBACK | isa_asm.AOF_MEM_SYM)) != 0) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ordered access addressing must be a bare [Xn]")};
    }
    ret err[fail.Fail].ok{};
}

fun shift_amount(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item, idx: u32) err[fail.Fail] {
    var buf:    [24]u8;
    var amount: opt[u32] = opt[u32].none{};
    if (isa_asm.copy_region(c.body, s.arg_lo[idx::usize], s.arg_hi[idx::usize], ?buf[0], 24)) { amount = asm_parse_lsl_amount((?buf[0])::str); }
    if (sel amount.none) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm movz/movk shift must be 'lsl N'")};
    }
    var hw: u32 = amount.some;
    if ((hw & 0xF) != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk shift must be a multiple of 16")}; }
    hw = hw / 16;
    if (is64(?item.ops[0])) {
        if (hw > 3) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk 64-bit shift exceeds lsl 48")}; }
    }
    or {
        if (hw > 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm movz/movk 32-bit shift exceeds lsl 16")}; }
    }
    item.ops[idx::usize] = isa_asm.op_imm(hw::i64, 1);
    ret err[fail.Fail].ok{};
}

fun branch_target(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item, idx: u32, allow_sym: bool) err[fail.Fail] {
    val lo: usize                = s.arg_lo[idx::usize];
    val hi: usize                = s.arg_hi[idx::usize];
    val lr: res[bool, fail.Fail] = isa_asm.local_ref(c, lo, hi, item);
    if (sel lr.err) { ret err[fail.Fail].err{lr.err}; }
    if (lr.ok)      { ret err[fail.Fail].ok{}; }
    if (char_is_digit(c.body[lo])) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm numeric local-label reference must be 'Nf' or 'Nb'")};
    }
    if (!allow_sym) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm conditional branch to a symbol is unsupported (no imm19 relocation kind); branch to a numeric local label instead")};
    }
    if (!isa_asm.is_sym_region(c.body, lo, hi)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'b' target must be a symbol or a numeric local label")};
    }
    item.ref     = isa_asm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret err[fail.Fail].ok{};
}

fun emit(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, l: *isa_asm.Labels, item: *isa_asm.Item) err[fail.Fail] {
    val pat: u16 = arm64_mnemonic.pattern(item.flags);

    if (pat == arm64_mnemonic.PATTERN_NULLARY) {
        if (item.code == arm64_inst.RET::u32) {
            arm64_emit.return_lr(st);
            ret err[fail.Fail].ok{};
        }
        arm64_emit.nullary(st, item.code::arm64_inst.MachOp);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_RET_REG || pat == arm64_mnemonic.PATTERN_BR_REG) {
        arm64_emit.branch_reg(st, item.code::arm64_inst.MachOp, reg_number(item.ops[0].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_IMM16) {
        arm64_emit.imm16_inst(st, item.code::arm64_inst.MachOp, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MOV)      { ret emit_mov(st, item); }
    if (pat == arm64_mnemonic.PATTERN_MOVEWIDE) { ret emit_movewide(st, item); }
    if (pat == arm64_mnemonic.PATTERN_ADDSUB)   { ret emit_addsub(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_LOGICAL)  { ret emit_logical(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_MULH)     { ret emit_logical(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_CMP)      { ret emit_cmp(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_CSET) {
        val use64: bool = is64(?item.ops[0]);
        arm64_emit.cset(st, use64, reg_number(item.ops[0].reg), arm64_mnemonic.cond(item.flags));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_ADRP)                                                                          { ret emit_adrp(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_BL)                                                                            { ret emit_call(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_B || pat == arm64_mnemonic.PATTERN_BCOND || pat == arm64_mnemonic.PATTERN_CBR) { ret emit_branch(st, c, l, item); }
    if (pat == arm64_mnemonic.PATTERN_LDST)                                                                          { ret emit_ldst(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_LDSTP)                                                                         { ret emit_ldstp(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_DMB || pat == arm64_mnemonic.PATTERN_ISB) {
        arm64_emit.barrier_op(st, item.code::arm64_inst.MachOp, item.ops[0].imm::u32);
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MSR) {
        if (item.ops[1].kind == isa_asm.AOP_IMM) {
            val f: u32 = item.ops[0].imm::u32;
            arm64_emit.msr_imm(st, (f >> 8) & 0x7, f & 0x7, item.ops[1].imm::u32);
            ret err[fail.Fail].ok{};
        }
        arm64_emit.msr_reg(st, item.ops[0].imm::u32, reg_number(item.ops[1].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_MRS) {
        arm64_emit.mrs(st, item.ops[1].imm::u32, reg_number(item.ops[0].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_LDORD) { ret emit_ldord(st, item); }
    if (pat == arm64_mnemonic.PATTERN_STLXR) {
        arm64_emit.stxr(st, is64(?item.ops[1]), reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(item.ops[2].reg));
        ret err[fail.Fail].ok{};
    }
    if (pat == arm64_mnemonic.PATTERN_SHIFT)                                                                         { ret emit_shift(st, c, item); }
    if (pat == arm64_mnemonic.PATTERN_V3 || pat == arm64_mnemonic.PATTERN_V2 || pat == arm64_mnemonic.PATTERN_VELEM) { ret emit_vec(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VCRYPTO)                                                                       { ret emit_crypto(st, item); }
    if (pat == arm64_mnemonic.PATTERN_REV)                                                                           { ret emit_rev(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VEXT)                                                                          { ret emit_ext(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VDUP)                                                                          { ret emit_dup(st, item); }
    if (pat == arm64_mnemonic.PATTERN_VINS)                                                                          { ret emit_ins(st, item); }
    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm aarch64 form has no emitter")};
}

fun emit_mov(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val dst:   *isa_asm.Operand = ?item.ops[0];
    val src:   *isa_asm.Operand = ?item.ops[1];
    val use64: bool             = is64(dst);
    if (src.kind == isa_asm.AOP_REG) {
        if (is_sp(dst) || is_sp(src)) {
            arm64_emit.addsub_imm(st, arm64_inst.ADD, use64, reg_number(dst.reg), reg_number(src.reg), 0, 0);
        }
        or {
            arm64_emit.alu3(st, arm64_inst.ORR, use64, reg_number(dst.reg), arm64_emit.ZR, reg_number(src.reg));
        }
        ret err[fail.Fail].ok{};
    }
    emit_asm_mov_imm(st, reg_number(dst.reg), src.imm::u64, use64);
    ret err[fail.Fail].ok{};
}

fun emit_movewide(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val use64: bool = is64(?item.ops[0]);
    var hw:    u32  = 0;
    if (item.nops == 3) { hw = item.ops[2].imm::u32; }
    arm64_emit.movewide(st, item.code::arm64_inst.MachOp, use64, reg_number(item.ops[0].reg), hw, item.ops[1].imm::u32);
    ret err[fail.Fail].ok{};
}

fun emit_addsub(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rd:     *isa_asm.Operand = ?item.ops[0];
    val rn:     *isa_asm.Operand = ?item.ops[1];
    val op3:    *isa_asm.Operand = ?item.ops[2];
    val use64:  bool             = is64(rd);
    val is_sub: bool             = item.code == arm64_inst.SUB::u32;

    val aop: arm64_inst.MachOp = item.code::arm64_inst.MachOp;
    if (op3.kind == isa_asm.AOP_IMM) {
        val v: i64 = op3.imm;
        if (v >= 0 && v <= 4095) {
            arm64_emit.addsub_imm(st, aop, use64, reg_number(rd.reg), reg_number(rn.reg), v::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (v > 0 && (v & 0xFFF) == 0 && (v >> 12) <= 4095) {
            arm64_emit.addsub_imm(st, aop, use64, reg_number(rd.reg), reg_number(rn.reg), (v >> 12)::u32, 1);
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm add/sub immediate is out of imm12 range")};
    }
    if (op3.kind == isa_asm.AOP_SYM) {
        if (is_sub)                               { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'sub' has no :lo12: form")}; }
        if (op3.mod != isa_inst.SYM_MOD_PCREL_LO) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'add' symbol operand must be a ':lo12:sym'")}; }
        val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, op3);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.bytes.len::u32;
        arm64_emit.addsub_imm_sym(st, arm64_inst.ADD, use64, reg_number(rd.reg), reg_number(rn.reg), sid, isa_inst.SYM_MOD_PCREL_LO, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_ADD_LO12, sid, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }
    if (is_sp(rd) || is_sp(rn) || is_sp(op3)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm add/sub with SP and a register operand requires the extended-register form (unsupported)")};
    }
    arm64_emit.alu3(st, aop, use64, reg_number(rd.reg), reg_number(rn.reg), reg_number(op3.reg));
    ret err[fail.Fail].ok{};
}

# the logical rows and the high multiplies: three registers, index 31 is xzr
fun emit_logical(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    if (is_sp(?item.ops[0]) || is_sp(?item.ops[1]) || is_sp(?item.ops[2])) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm three-register form has no sp operand; register 31 there is always xzr")};
    }
    val use64: bool = is64(?item.ops[0]);
    arm64_emit.alu3(st, item.code::arm64_inst.MachOp, use64, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(item.ops[2].reg));
    ret err[fail.Fail].ok{};
}

fun emit_cmp(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rn:    *isa_asm.Operand = ?item.ops[0];
    val op2:   *isa_asm.Operand = ?item.ops[1];
    val use64: bool             = is64(rn);
    if (op2.kind == isa_asm.AOP_IMM) {
        if (op2.imm < 0 || op2.imm > 4095) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'cmp' second operand must be a register or imm12")}; }
        arm64_emit.addsub_imm(st, arm64_inst.SUBS, use64, arm64_emit.ZR, reg_number(rn.reg), op2.imm::u32, 0);
        ret err[fail.Fail].ok{};
    }
    if (is_sp(rn) || is_sp(op2)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm 'cmp' with sp and a register operand requires the extended-register form (unsupported)")};
    }
    arm64_emit.alu3(st, arm64_inst.SUBS, use64, arm64_emit.ZR, reg_number(rn.reg), reg_number(op2.reg));
    ret err[fail.Fail].ok{};
}

fun emit_adrp(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val sym: *isa_asm.Operand = ?item.ops[1];
    if (sym.mod == isa_inst.SYM_MOD_PCREL_LO || sym.mod == isa_inst.SYM_MOD_GOT_LO) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm 'adrp' names a page, so its symbol takes no low-half modifier")};
    }
    val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, sym);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    if (sym.mod == isa_inst.SYM_MOD_GOT_HI) { ret arm64_emit.adrp_got_reloc(st, reg_number(item.ops[0].reg), sid); }
    ret arm64_emit.adrp_reloc(st, reg_number(item.ops[0].reg), sid, 0);
}

fun emit_call(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, ?item.ops[0]);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sid: intern.StrId = sr.ok;
    val pos: u32          = st.buf.bytes.len::u32;
    arm64_emit.branch_sym(st, arm64_inst.BL, sid, 0);
    val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_PLT32, sid, 0);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_branch(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, l: *isa_asm.Labels, item: *isa_asm.Item) err[fail.Fail] {
    val pat: u16 = arm64_mnemonic.pattern(item.flags);

    if (item.ref == isa_asm.AR_SYM) {
        val name: str                        = (c.body::usize + item.ref_off)::str;
        val sr:   res[intern.StrId, A.Error] = intern.bytes_add(st.interner, name, item.ref_len);
        if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.bytes.len::u32;
        arm64_emit.branch_sym(st, arm64_inst.B, sid, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_JUMP26, sid, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }

    var bop:   arm64_inst.MachOp = arm64_inst.B;
    var cc:    u32               = 0;
    var rt:    u32               = 0;
    var use64: bool              = false;
    if (pat == arm64_mnemonic.PATTERN_BCOND) {
        bop = arm64_inst.BCOND;
        cc  = arm64_mnemonic.cond(item.flags) & 0xF;
    }
    or (pat == arm64_mnemonic.PATTERN_CBR) {
        bop   = item.code::arm64_inst.MachOp;
        use64 = is64(?item.ops[0]);
        rt    = reg_number(item.ops[0].reg);
    }

    val pos: u32 = st.buf.bytes.len::u32;
    arm64_emit.branch_local(st, bop, cc, use64, rt, item.ref_num, item.ref_fwd);
    ret isa_asm.resolve_local(st, c, l, pos, item.ref_num, item.ref_fwd);
}

fun emit_ldst(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rt:      *isa_asm.Operand = ?item.ops[0];
    val mem:     *isa_asm.Operand = ?item.ops[1];
    val is_load: bool             = item.code == arm64_inst.LDR::u32 || item.code == arm64_inst.LDRB::u32 || item.code == arm64_inst.LDRH::u32;
    var w:       u8               = 4;
    if (is64(rt))                                                               { w = 8; }
    if (item.code == arm64_inst.LDRB::u32 || item.code == arm64_inst.STRB::u32) { w = 1; }
    or (item.code == arm64_inst.LDRH::u32 || item.code == arm64_inst.STRH::u32) { w = 2; }

    val fr: res[arm64_emit.Access, fail.Fail] = arm64_emit.int_access(w, is_load);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val acf: arm64_emit.Access = fr.ok;

    if ((mem.flags & isa_asm.AOF_MEM_SYM) != 0) {
        if (mem.mod != isa_inst.SYM_MOD_PCREL_LO && mem.mod != isa_inst.SYM_MOD_GOT_LO) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ldr/str symbol offset must be a ':lo12:sym' or ':got_lo12:sym'")};
        }
        val sr: res[intern.StrId, fail.Fail] = intern_symbol(st, c, mem);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val sid: intern.StrId = sr.ok;
        val pos: u32          = st.buf.bytes.len::u32;
        if (mem.mod == isa_inst.SYM_MOD_GOT_LO) {
            if (!is_load || w != 8) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm ':got_lo12:' offset takes a 64-bit load")}; }
            arm64_emit.ldst_sym(st, arm64_inst.LDR, false, 8, reg_number(rt.reg), reg_number(mem.reg), sid, isa_inst.SYM_MOD_GOT_LO, 0);
            val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), target_of.RK_GOT_LO12, sid, 0);
            if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
            ret err[fail.Fail].ok{};
        }
        arm64_emit.ldst_sym(st, acf.op, acf.fp, acf.width, reg_number(rt.reg), reg_number(mem.reg), sid, isa_inst.SYM_MOD_PCREL_LO, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, arm64_emit.reloc_offset(pos), acf.lo12, sid, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }
    if ((mem.flags & isa_asm.AOF_HAS_INDEX) != 0) {
        arm64_emit.ldst_reg(st, acf.op, acf.fp, acf.width, reg_number(rt.reg), reg_number(mem.reg), reg_number(mem.index));
        ret err[fail.Fail].ok{};
    }
    val no_scratch_r: res[bool, fail.Fail] = arm64_emit.mem_access_needs_no_scratch(mem.imm, w);
    if (sel no_scratch_r.err) { ret err[fail.Fail].err{no_scratch_r.err}; }
    if (!no_scratch_r.ok) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, offset_message(c, mem.imm))};
    }
    ret arm64_emit.mem_access(st, reg_number(rt.reg), reg_number(mem.reg), mem.imm, w, is_load);
}

fun offset_message(c: *isa_asm.Cursor, off: i64) res[str, fail.Fail] {
    var buf: [24]u8;
    var v:   i64 = off;
    if (v < 0) { v = 0 - v; }
    val n: usize = std_format.put_u64(?buf[0], v::u64);
    buf[n] = 0;
    ret isa_asm.named_message(c.alloc, c.interner,
        "inline-asm ldr/str offset ", (?buf[0])::str,
        " is out of range for both immediate forms; addressing it would need a scratch register this body may be using, so reduce the function's frame or stage the address into a register first");
}

fun emit_ldstp(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val mem:     *isa_asm.Operand = ?item.ops[2];
    val is_load: bool             = item.code == arm64_inst.LDP::u32;
    var disp:    i64              = 0;
    var wb:      u16              = 0;
    if (item.nops == 4) {
        disp = item.ops[3].imm;
        wb   = arm64_inst.FLAG_WB_POST;
    }
    or {
        disp = mem.imm;
        if ((mem.flags & isa_asm.AOF_WRITEBACK) != 0) { wb = arm64_inst.FLAG_WB_PRE; }
    }
    if ((disp & 7) != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm stp/ldp offset must be a multiple of 8")}; }
    val q: i64 = disp / 8;
    if (q < -64 || q > 63) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm stp/ldp offset is out of the imm7 range")}; }
    var pop: arm64_inst.MachOp = arm64_inst.STP;
    if (is_load) { pop = arm64_inst.LDP; }
    arm64_emit.ldstp(st, pop, false, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg), reg_number(mem.reg), q::u32 & 0x7F, wb);
    ret err[fail.Fail].ok{};
}

fun emit_ldord(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    val use64: bool = is64(?item.ops[0]);
    arm64_emit.ldord(st, item.code::arm64_inst.MachOp, use64, reg_number(item.ops[0].reg), reg_number(item.ops[1].reg));
    ret err[fail.Fail].ok{};
}

fun emit_shift(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, item: *isa_asm.Item) err[fail.Fail] {
    val rd:  *isa_asm.Operand = ?item.ops[0];
    val rn:  *isa_asm.Operand = ?item.ops[1];
    val cnt: *isa_asm.Operand = ?item.ops[2];
    if (is_sp(rd) || is_sp(rn) || (cnt.kind == isa_asm.AOP_REG && is_sp(cnt))) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm shift has no sp operand form; register 31 there is always xzr")};
    }
    val use64: bool = is64(rd);
    var width: u32  = 32;
    if (use64) { width = 64; }

    val vform:  bool = item.code == arm64_inst.LSLV::u32 || item.code == arm64_inst.LSRV::u32 || item.code == arm64_inst.ASRV::u32;
    val is_lsr: bool = item.code == arm64_inst.LSR::u32 || item.code == arm64_inst.LSRV::u32;
    val is_asr: bool = item.code == arm64_inst.ASR::u32 || item.code == arm64_inst.ASRV::u32;

    if (cnt.kind == isa_asm.AOP_IMM && !vform) {
        val sh:  u32               = cnt.imm::u32 & (width - 1);
        var sop: arm64_inst.MachOp = arm64_inst.LSL;
        if (is_asr) { sop = arm64_inst.ASR; }
        or (is_lsr) { sop = arm64_inst.LSR; }
        arm64_emit.bitfield(st, sop, use64, reg_number(rd.reg), reg_number(rn.reg), sh, 0);
        ret err[fail.Fail].ok{};
    }
    if (cnt.kind != isa_asm.AOP_REG) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm shift count must be a register or immediate")}; }
    var vop: arm64_inst.MachOp = arm64_inst.LSLV;
    if (is_lsr) { vop = arm64_inst.LSRV; }
    or (is_asr) { vop = arm64_inst.ASRV; }
    arm64_emit.alu3(st, vop, use64, reg_number(rd.reg), reg_number(rn.reg), reg_number(cnt.reg));
    ret err[fail.Fail].ok{};
}

fun intern_symbol(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, op: *isa_asm.Operand) res[intern.StrId, fail.Fail] {
    val interned: res[intern.StrId, A.Error] = intern.bytes_add(st.interner, (c.body::usize + op.name_off)::str, op.name_len);
    if (sel interned.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(interned.err)}; }
    ret res[intern.StrId, fail.Fail].ok{interned.ok};
}

fun patch(st: *isa_encode.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    var fx: isa_encode.BranchFixup;
    fx.patch_pos    = patch_pos;
    fx.next_ip      = 0;
    fx.target_block = 0;
    fx.fn_text_base = 0;
    ret arm64_emit.patch_branch(st, ?fx, target_off);
}

fun writes_sp(item: *isa_asm.Item) bool {
    if (item.kind == isa_asm.AI_LABEL) { ret false; }
    if (item.kind == isa_asm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << arm64_emit.SP_REG)) != 0; }
        ret true;
    }
    if ((item.writes & isa_asm.AW_OP0) != 0 && item.nops > 0 && is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & isa_asm.AW_OP1) != 0 && item.nops > 1 && is_sp(?item.ops[1])) { ret true; }
    if ((item.writes & isa_asm.AW_WB_BASE) != 0) {
        var i: u32 = 0;
        for (i < item.nops) {
            val op: *isa_asm.Operand = ?item.ops[i::usize];
            if (op.kind == isa_asm.AOP_MEM && (op.flags & isa_asm.AOF_WRITEBACK) != 0 && is_sp(op)) {
                ret true;
            }
            i = i + 1;
        }
    }
    ret false;
}

# whether an asm body returns, for the middle end, which reads no grammar
pub fun returns(body: str) bool {
    ret isa_asm.returns(grammar, body);
}

pub fun grammar() isa_asm.Grammar {
    var g: isa_asm.Grammar;
    g.isa        = "aarch64";
    g.unknown    = "unknown aarch64 inline-asm instruction '";
    g.rows       = ?arm64_mnemonic.ROWS[0];
    g.row_count  = arm64_mnemonic.ROW_COUNT;
    g.data       = ?isa_asm.DIRECTIVES_WORD32[0];
    g.data_count = isa_asm.DIRECTIVE_COUNT;
    g.decode     = decode_bcond;
    g.parse      = parse;
    g.emit       = emit;
    g.patch      = patch;
    g.slot_sp    = true;
    g.writes_sp  = writes_sp;
    g.all_gp     = 0xFFFFFFFF;
    g.all_fp     = 0xFFFFFFFF;
    g.word       = 4;
    g.endian     = target_model.ENDIAN_LITTLE;
    g.ct_class   = arm64_effects.asm_ct_class;
    g.note_bytes = isa_encode.render_bytes_directive;
    g.note_label = note_label;
    g.decl_reg   = decl_reg;
    g.no_fall    = no_fall;
    ret g;
}

fun no_fall(item: *isa_asm.Item) bool {
    if (item.kind != isa_asm.AI_INST) { ret false; }
    ret item.code == arm64_inst.BRK::u32;
}

fun decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: isa_asm.Operand = isa_asm.op_none();
    if (reg(name, ?op) && op.size == 8) {
        @bank = isa_asm.ABANK_GP;
        @idx  = reg_number(op.reg);
        ret true;
    }
    var n: u32 = 0;
    if (vec_index(name, ?n)) {
        @bank = isa_asm.ABANK_FP;
        @idx  = n;
        ret true;
    }
    ret false;
}

fun vec_index(name: str, out: *u32) bool {
    val len: usize = str_len(name);
    if (len < 2 || len > 3)   { ret false; }
    if (name[0] != 'v'::char) { ret false; }
    var n: u32   = 0;
    var i: usize = 1;
    for (i < len) {
        if (!char_is_digit(name[i])) { ret false; }
        n = n * 10 + (name[i]::u32 - '0'::u32);
        i = i + 1;
    }
    if (n > 31) { ret false; }
    @out = n;
    ret true;
}

pub fun encode_asm_block(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    var g: isa_asm.Grammar = grammar();
    ret isa_asm.encode_block(st, ?g, f, mi);
}

fun note_label(st: *isa_encode.EncodeState, number: u32) err[fail.Fail] {
    ret arm64_printer.note_local_label(?st.buf, number);
}

#[testing]
fun asm_text(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, l: *isa_asm.Labels, text: str) err[fail.Fail] {
    var g: isa_asm.Grammar = grammar();
    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret isa_asm.run(st, ?g, ?c, l);
}

test inline_asm__data_processing_forms {
    if (!t_word("nop", 0xD503201F))                     { ret 1; }
    if (!t_word("ret", 0xD65F03C0))                     { ret 2; }
    if (!t_word("svc 0", 0xD4000001))                   { ret 3; }
    if (!t_word("brk 0", 0xD4200000))                   { ret 4; }
    if (!t_word("mov x0, x1", 0xAA0103E0))              { ret 5; }
    if (!t_word("mov sp, x0", 0x9100001F))              { ret 6; }
    if (!t_word("mov x0, sp", 0x910003E0))              { ret 7; }
    if (!t_word("mov w0, w1", 0x2A0103E0))              { ret 8; }
    if (!t_word("mov x8, 93", 0xD2800BA8))              { ret 9; }
    if (!t_word("movz x0, 0x1234", 0xD2824680))         { ret 10; }
    if (!t_word("movz x0, 0x1234, lsl 16", 0xD2A24680)) { ret 11; }
    if (!t_word("movk x0, 0x5678, lsl 16", 0xF2AACF00)) { ret 12; }
    if (!t_word("add x0, x1, 5", 0x91001420))           { ret 13; }
    if (!t_word("add x0, x1, x2", 0x8B020020))          { ret 14; }
    if (!t_word("sub x0, x1, 5", 0xD1001420))           { ret 15; }
    if (!t_word("sub sp, sp, 16", 0xD10043FF))          { ret 16; }
    if (!t_word("and x0, x1, x2", 0x8A020020))          { ret 17; }
    if (!t_word("cmp x0, 5", 0xF100141F))               { ret 18; }
    if (!t_word("cmp x0, x1", 0xEB01001F))              { ret 19; }
    if (!t_word("blr x0", 0xD63F0000))                  { ret 20; }
    if (!t_word("br x0", 0xD61F0000))                   { ret 21; }
    ret 0;
}

test inline_asm__sp_refused_where_zr_only {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    var assembled: err[fail.Fail] = asm_text(?st, ?f, ?labels, "add x0, x1, x2");
    if (sel assembled.err) { bad = 1; }
    assembled = asm_text(?st, ?f, ?labels, "add x0, sp, x2");
    if (!sel assembled.err) { bad = 2; }
    assembled = asm_text(?st, ?f, ?labels, "add sp, x1, x2");
    if (!sel assembled.err) { bad = 3; }

    assembled = asm_text(?st, ?f, ?labels, "and x0, x1, x2");
    if (sel assembled.err) { bad = 4; }
    assembled = asm_text(?st, ?f, ?labels, "and x0, sp, x2");
    if (!sel assembled.err) { bad = 5; }
    assembled = asm_text(?st, ?f, ?labels, "orr sp, x1, x2");
    if (!sel assembled.err) { bad = 6; }
    assembled = asm_text(?st, ?f, ?labels, "eor x0, x1, sp");
    if (!sel assembled.err) { bad = 7; }

    assembled = asm_text(?st, ?f, ?labels, "cmp x0, x1");
    if (sel assembled.err) { bad = 8; }
    assembled = asm_text(?st, ?f, ?labels, "cmp sp, x1");
    if (!sel assembled.err) { bad = 9; }
    assembled = asm_text(?st, ?f, ?labels, "cmp sp, 5");
    if (sel assembled.err) { bad = 10; }

    assembled = asm_text(?st, ?f, ?labels, "lsl x0, x1, 3");
    if (sel assembled.err) { bad = 11; }
    assembled = asm_text(?st, ?f, ?labels, "lsl sp, x1, 3");
    if (!sel assembled.err) { bad = 12; }
    assembled = asm_text(?st, ?f, ?labels, "lslv x0, x1, x2");
    if (sel assembled.err) { bad = 13; }
    assembled = asm_text(?st, ?f, ?labels, "lslv x0, x1, sp");
    if (!sel assembled.err) { bad = 14; }

    assembled = asm_text(?st, ?f, ?labels, "ldr x0, [x1, x2]");
    if (sel assembled.err) { bad = 15; }
    assembled = asm_text(?st, ?f, ?labels, "ldr x0, [sp, 16]");
    if (sel assembled.err) { bad = 16; }
    assembled = asm_text(?st, ?f, ?labels, "ldr x0, [x1, sp]");
    if (!sel assembled.err) { bad = 17; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__mixed_width_refused {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    var assembled: err[fail.Fail] = asm_text(?st, ?f, ?labels, "mov x0, x1");
    if (sel assembled.err) { bad = 1; }
    assembled = asm_text(?st, ?f, ?labels, "mov w0, w1");
    if (sel assembled.err) { bad = 2; }
    assembled = asm_text(?st, ?f, ?labels, "mov x0, w1");
    if (!sel assembled.err) { bad = 3; }
    assembled = asm_text(?st, ?f, ?labels, "mov w0, x1");
    if (!sel assembled.err) { bad = 4; }

    assembled = asm_text(?st, ?f, ?labels, "add x0, x1, x2");
    if (sel assembled.err) { bad = 5; }
    assembled = asm_text(?st, ?f, ?labels, "add x0, w1, x2");
    if (!sel assembled.err) { bad = 6; }
    assembled = asm_text(?st, ?f, ?labels, "add x0, x1, w2");
    if (!sel assembled.err) { bad = 7; }
    assembled = asm_text(?st, ?f, ?labels, "add x0, x1, 5");
    if (sel assembled.err) { bad = 8; }

    assembled = asm_text(?st, ?f, ?labels, "and x0, x1, x2");
    if (sel assembled.err) { bad = 9; }
    assembled = asm_text(?st, ?f, ?labels, "and x0, w1, x2");
    if (!sel assembled.err) { bad = 10; }

    assembled = asm_text(?st, ?f, ?labels, "cmp x0, x1");
    if (sel assembled.err) { bad = 11; }
    assembled = asm_text(?st, ?f, ?labels, "cmp x0, w1");
    if (!sel assembled.err) { bad = 12; }
    assembled = asm_text(?st, ?f, ?labels, "cmp x0, 5");
    if (sel assembled.err) { bad = 13; }

    assembled = asm_text(?st, ?f, ?labels, "lslv x0, x1, x2");
    if (sel assembled.err) { bad = 14; }
    assembled = asm_text(?st, ?f, ?labels, "lslv x0, x1, w2");
    if (!sel assembled.err) { bad = 15; }
    assembled = asm_text(?st, ?f, ?labels, "lsl x0, x1, 3");
    if (sel assembled.err) { bad = 16; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__call_and_jump_relocations_differ {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val fr: res[intern.StrId, A.Error] = intern.add(?interner, "fsym");
    if (sel fr.err) { ret 1; }
    val fsym: intern.StrId = fr.ok;

    asm_text(?st, ?f, ?labels, "bl fsym");
    asm_text(?st, ?f, ?labels, "b fsym");

    if (st.reloc_count != 2) { bad = 1; }
    or {
        if (st.relocs[0].kind != target_of.RK_PLT32)  { bad = 2; }
        if (!intern.str_same(st.relocs[0].sym, fsym)) { bad = 3; }
        if (st.relocs[1].kind != target_of.RK_JUMP26) { bad = 4; }
        if (!intern.str_same(st.relocs[1].sym, fsym)) { bad = 5; }
    }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__data_directives {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    asm_text(?st, ?f, ?labels, "nop");
    asm_text(?st, ?f, ?labels, ".word 0xd503201f");
    asm_text(?st, ?f, ?labels, ".long 0xd503201f");
    asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03, 0xd5");
    asm_text(?st, ?f, ?labels, ".quad 0xd503201fd503201f");

    if (isa_encode.word_read(?st.buf, 0) != 0xD503201F)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xD503201F)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0xD503201F)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 12) != 0xD503201F) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0xD503201F) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 20) != 0xD503201F) { bad = 1; }
    if (st.buf.bytes.len != 24)                          { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__data_directive_refusals {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val r1: err[fail.Fail] = asm_text(?st, ?f, ?labels, ".byte 0x1f");
    if (!sel r1.err) { bad = 1; }
    or (sel r1.err) {
        if (!str_contains(fail.describe(r1.err), "whole number of instruction words")) { bad = 1; }
    }

    val r2: err[fail.Fail] = asm_text(?st, ?f, ?labels, ".byte 0x1f, 0x20, 0x03");
    if (!sel r2.err) { bad = 1; }
    or (sel r2.err) {
        if (!str_contains(fail.describe(r2.err), "whole number of instruction words")) { bad = 1; }
    }

    val r3: err[fail.Fail] = asm_text(?st, ?f, ?labels, ".word 0x1d503201f");
    if (!sel r3.err) { bad = 1; }
    or (sel r3.err) {
        if (!str_contains(fail.describe(r3.err), "cannot hold")) { bad = 1; }
    }

    val r4: err[fail.Fail] = asm_text(?st, ?f, ?labels, ".hword 0x1234");
    if (!sel r4.err) { bad = 1; }
    or (sel r4.err) {
        if (!str_contains(fail.describe(r4.err), "unknown aarch64 inline-asm instruction")) { bad = 1; }
    }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

#[testing]
fun t_word(text: str, want: u32) bool {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val r:  err[fail.Fail] = asm_text(?st, ?f, ?labels, text);
    var ok: bool           = false;
    if (!sel r.err && st.buf.bytes.len == 4) { ok = isa_encode.word_read(?st.buf, 0) == want; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret ok;
}

#[testing]
fun t_word_refused(text: str, want: str) bool {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val r:  err[fail.Fail] = asm_text(?st, ?f, ?labels, text);
    var ok: bool           = false;
    if (sel r.err) { ok = str_contains(fail.describe(r.err), want); }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret ok;
}

# goldens from clang 22 (aarch64-linux-gnu) and llvm-objdump
test inline_asm__vector_forms_are_byte_exact {
    if (!t_word("ld1 {v0.16b}, [x1]", 0x4C407020))         { ret 1; }
    if (!t_word("ld1 { v3.4s }, [x1], 16", 0x4CDF7823))    { ret 2; }
    if (!t_word("ld1 {v17.2d}, [x2], x9", 0x4CC97C51))     { ret 3; }
    if (!t_word("st1 {v31.8h}, [x2], x9", 0x4C89745F))     { ret 6; }
    if (!t_word("add v0.4s, v1.4s, v2.4s", 0x4EA28420))    { ret 7; }
    if (!t_word("sub v8.2d, v9.2d, v10.2d", 0x6EEA8528))   { ret 8; }
    if (!t_word("and v0.16b, v1.16b, v2.16b", 0x4E221C20)) { ret 9; }
    if (!t_word("eor v6.16b, v7.16b, v8.16b", 0x6E281CE6)) { ret 11; }
    if (!t_word("mov v1.16b, v2.16b", 0x4EA21C41))         { ret 12; }
    if (!t_word("mvn v1.16b, v2.16b", 0x6E205841))         { ret 13; }
    if (!t_word("cmeq v1.8h, v2.8h, v3.8h", 0x6E638C41))   { ret 14; }
    if (!t_word("mul v1.4s, v2.4s, v3.4s", 0x4EA39C41))    { ret 15; }
    if (!t_word("fadd v0.4s, v1.4s, v2.4s", 0x4E22D420))   { ret 16; }
    ret 0;
}

test inline_asm__vector_forms_refuse_what_they_cannot_encode {
    if (!t_word_refused("add x0, v1.4s, v2.4s", "lane arrangement"))                     { ret 1; }
    if (!t_word_refused("add v0.4s, v1.4s, v2.8h", "different lane arrangements"))       { ret 2; }
    if (!t_word_refused("and v0.4s, v1.4s, v2.4s", "no form at this lane arrangement"))  { ret 3; }
    if (!t_word_refused("mul v0.2d, v1.2d, v2.2d", "no form at this lane arrangement"))  { ret 4; }
    if (!t_word_refused("fadd v0.8h, v1.8h, v2.8h", "no form at this lane arrangement")) { ret 5; }
    if (!t_word_refused("ldr x0, [x1, v2.4s]", "malformed inline-asm memory operand"))   { ret 6; }
    if (!t_word_refused("ldr q0, [x1]", "takes general-purpose registers"))              { ret 7; }
    if (!t_word_refused("cmp v0.4s, x1", "takes general-purpose registers"))             { ret 8; }
    if (!t_word_refused("ld1 v0.16b, [x1]", "in braces"))                                { ret 9; }
    if (!t_word_refused("ld1 {q0}, [x1]", "lane arrangement"))                           { ret 10; }
    if (!t_word_refused("ld1 {v0.16b}, [x1], 8", "structure size, 16"))                  { ret 11; }
    if (!t_word_refused("ld1 {v0.16b}, [x1, 16]", "bare [Xn]"))                          { ret 12; }
    if (!t_word_refused("st1 {v0.16b}, [x1]!", "bare [Xn]"))                             { ret 13; }
    if (!t_word_refused("ld1 {v0.16b}, [x1], xzr", "other than xzr and sp"))             { ret 14; }
    if (!t_word_refused("ld1 {v0.16b}, [x1], w9", "other than xzr and sp"))              { ret 15; }
    if (!t_word_refused("mvn v0.4s, v1.4s", "no form at this lane arrangement"))         { ret 16; }
    if (!t_word_refused("add v32.4s, v1.4s, v2.4s", "lane arrangement"))                 { ret 17; }
    ret 0;
}

# one sha2 row under a target selecting `exts` in a function admitting `f_exts`:
# its word, or its refusal text, and the listing when rendering
#[testing]
fun t_sha_run(text: str, exts: u64, f_exts: u64, word: *u32, why: *str, listing: bool) bool {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;
    f.extensions = f_exts;
    arm64_emit.select_extensions(exts);
    var w: io_writer.Writer;
    arm64_printer.test_sink_writer(?w);
    arm64_printer.test_sink_reset();
    var sink: isa_encode.AsmSink = isa_encode.sink_init(?w, ?interner);
    if (listing) { st.buf.asm = ?sink; }
    val r: err[fail.Fail] = asm_text(?st, ?f, ?labels, text);
    arm64_emit.select_extensions(0);
    var ok: bool = false;
    if (sel r.err) { @why = fail.describe(r.err); }
    or (st.buf.bytes.len == 4 && !sink.failed) {
        @word = isa_encode.word_read(?st.buf, 0);
        ok    = true;
    }
    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret ok;
}

# the word clang 22 gives the row, and its listing assembles back to it
#[testing]
val T_EXT_ALL: u64 = extension_arm64.SHA2 | extension_arm64.AES | extension_arm64.PMULL;

#[testing]
fun t_sha_word(text: str, want: u32) bool {
    var word: u32 = 0;
    var why:  str = nil;
    if (!t_sha_run(text, T_EXT_ALL, 0, ?word, ?why, true) || word != want) { ret false; }
    val listed: str   = arm64_printer.test_sink_text();
    var line:   [96]u8;
    var n:      usize = 0;
    var i:      usize = 0;
    for (listed[i] == ' '::char) { i = i + 1; }
    for (listed[i] != 0 && listed[i] != '\n'::char && n < 95) {
        line[n] = listed[i]::u8;
        n       = n + 1;
        i       = i + 1;
    }
    line[n] = 0;
    if (!str_equals((?line[0])::str, text)) { ret false; }
    var again: u32 = 0;
    ret t_sha_run((?line[0])::str, T_EXT_ALL, 0, ?again, ?why, false) && again == want;
}

#[testing]
fun t_sha_refused(text: str, exts: u64, f_exts: u64, want: str) bool {
    var word: u32 = 0;
    var why:  str = nil;
    if (t_sha_run(text, exts, f_exts, ?word, ?why, false)) { ret false; }
    ret why != nil && str_contains(why, want);
}

#[testing]
fun t_sha_admitted(text: str, exts: u64, f_exts: u64) bool {
    var word: u32 = 0;
    var why:  str = nil;
    ret t_sha_run(text, exts, f_exts, ?word, ?why, false);
}

# goldens from clang 22 (aarch64-linux-gnu, +crypto) and llvm-objdump; the
# listing spells each row as llvm-objdump does and assembles back
test inline_asm__sha2_rows_are_byte_exact_and_round_trip {
    if (!t_sha_word("sha256h q0, q1, v2.4s", 0x5E024020))         { ret 1; }
    if (!t_sha_word("sha256h q31, q16, v5.4s", 0x5E05421F))       { ret 2; }
    if (!t_sha_word("sha256h2 q3, q4, v5.4s", 0x5E055083))        { ret 3; }
    if (!t_sha_word("sha256su0 v0.4s, v1.4s", 0x5E282820))        { ret 5; }
    if (!t_sha_word("sha256su0 v17.4s, v30.4s", 0x5E282BD1))      { ret 6; }
    if (!t_sha_word("sha256su1 v0.4s, v1.4s, v2.4s", 0x5E026020)) { ret 7; }
    ret 0;
}

test inline_asm__sha2_needs_the_extension_or_an_outlier {
    if (!t_sha_refused("sha256h q0, q1, v2.4s", 0, 0,
        "inline-asm instruction 'sha256h' needs the `sha2` extension, which this target does not select; add `extensions = [\"sha2\"]` to the target, or mark the function `#[extensions(sha2)]` and call it only after detecting the extension at run time")) { ret 1; }
    if (!t_sha_refused("sha256su0 v0.4s, v1.4s", 0, 0, "#[extensions(sha2)]"))     { ret 2; }
    if (!t_sha_admitted("sha256h2 q0, q1, v2.4s", 0, extension_arm64.SHA2))        { ret 3; }
    if (!t_sha_admitted("sha256su1 v0.4s, v1.4s, v2.4s", extension_arm64.SHA2, 0)) { ret 4; }
    if (!t_sha_admitted("add v0.4s, v1.4s, v2.4s", 0, 0))                          { ret 5; }
    ret 0;
}

test inline_asm__sha2_refuses_other_operands {
    arm64_emit.select_extensions(extension_arm64.SHA2);
    var bad: i32 = 0;
    if (!t_word_refused("sha256h v0.4s, v1.4s, v2.4s", "two q registers and a v.4s register")) { bad = 1; }
    if (!t_word_refused("sha256h q0, q1, q2", "two q registers and a v.4s register"))          { bad = 2; }
    if (!t_word_refused("sha256h2 q0, q1", "two q registers and a v.4s register"))             { bad = 3; }
    if (!t_word_refused("sha256su0 v0.4s, v1.16b", "two v.4s registers"))                      { bad = 4; }
    if (!t_word_refused("sha256su0 v0.4s, v1.4s, v2.4s", "two v.4s registers"))                { bad = 5; }
    if (!t_word_refused("sha256su1 v0.4s, v1.4s, x2", "three v.4s registers"))                 { bad = 6; }
    if (!t_word_refused("sha256su1 q0, q1, q2", "three v.4s registers"))                       { bad = 7; }
    arm64_emit.select_extensions(0);
    ret bad;
}

# each row writes its first operand and nothing else; the state and schedule
# registers are read and written, the rest read
test inline_asm__sha2_clobbers_and_effects {
    var gp: u32 = 0;
    var fp: u32 = 0;
    isa_asm.clobbers(grammar, "sha256h q3, q4, v5.4s\nsha256h2 q6, q7, v8.4s\nsha256su0 v9.4s, v10.4s\nsha256su1 v11.4s, v12.4s, v13.4s", ?gp, ?fp);
    if (gp != 0 || fp != ((1::u32 << 3) | (1::u32 << 6) | (1::u32 << 9) | (1::u32 << 11))) { ret 1; }
    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = arm64_emit.inst_of(arm64_inst.SHA256H, arm64_inst.vec(0, 16), arm64_inst.vec(1, 16), arm64_inst.vec(2, 16));
    arm64_effects.describe(?mi, ?e);
    if (!e.cls.known || e.cls.writes_flags || e.cls.op != ct.CT_OP_NONE)                                              { ret 2; }
    if (e.roles[0] != isa_effect.ROLE_RW || e.roles[1] != isa_effect.ROLE_READ || e.roles[2] != isa_effect.ROLE_READ) { ret 3; }
    mi = arm64_emit.inst_of(arm64_inst.SHA256SU0, arm64_inst.vec(0, 16), arm64_inst.vec(1, 16), isa_inst.make_none());
    arm64_effects.describe(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_RW || e.roles[1] != isa_effect.ROLE_READ || e.roles[2] != isa_effect.ROLE_NONE) { ret 4; }
    ret 0;
}

# goldens from llvm-mc 22 (aarch64-linux-gnu, +aes): every aes and pmull row
# with low and high registers; the listing spells each row as llvm-mc does and
# assembles back
test inline_asm__aes_and_pmull_rows_are_byte_exact_and_round_trip {
    if (!t_sha_word("aese v0.16b, v1.16b", 0x4E284820))          { ret 1; }
    if (!t_sha_word("aese v31.16b, v16.16b", 0x4E284A1F))        { ret 2; }
    if (!t_sha_word("aesd v2.16b, v3.16b", 0x4E285862))          { ret 3; }
    if (!t_sha_word("aesmc v4.16b, v5.16b", 0x4E2868A4))         { ret 5; }
    if (!t_sha_word("aesimc v6.16b, v7.16b", 0x4E2878E6))        { ret 7; }
    if (!t_sha_word("pmull v0.1q, v1.1d, v2.1d", 0x0EE2E020))    { ret 9; }
    if (!t_sha_word("pmull v31.1q, v30.1d, v29.1d", 0x0EFDE3DF)) { ret 10; }
    if (!t_sha_word("pmull2 v3.1q, v4.2d, v5.2d", 0x4EE5E083))   { ret 11; }
    ret 0;
}

# the word llvm-mc gives the row, and the listing, spelled as llvm-objdump
# spells it, assembles back to the same word
#[testing]
fun t_listed_word(text: str, listing: str, want: u32) bool {
    var word: u32 = 0;
    var why:  str = nil;
    if (!t_sha_run(text, 0, 0, ?word, ?why, true) || word != want) { ret false; }
    val listed: str   = arm64_printer.test_sink_text();
    var line:   [96]u8;
    var n:      usize = 0;
    var i:      usize = 0;
    for (listed[i] == ' '::char) { i = i + 1; }
    for (listed[i] != 0 && listed[i] != '\n'::char && n < 95) {
        line[n] = listed[i]::u8;
        n       = n + 1;
        i       = i + 1;
    }
    line[n] = 0;
    if (!str_equals((?line[0])::str, listing)) { ret false; }
    var again: u32 = 0;
    ret t_sha_run((?line[0])::str, 0, 0, ?again, ?why, false) && again == want;
}

# the byte reversals, the byte extract, the broadcasts and the lane inserts
# against llvm-mc 22 (aarch64), low and high registers and every element width
# each. ins lists as mov, the alias llvm-objdump and GNU objdump both print,
# which the grammar reads back as ins
test inline_asm__rev_ext_dup_ins_are_byte_exact_and_round_trip {
    if (!t_listed_word("rev w0, w1", "rev w0, w1", 0x5AC00820))                                               { ret 1; }
    if (!t_listed_word("rev x2, x3", "rev x2, x3", 0xDAC00C62))                                               { ret 2; }
    if (!t_listed_word("rev w30, wzr", "rev w30, wzr", 0x5AC00BFE))                                           { ret 3; }
    if (!t_listed_word("rev x29, x28", "rev x29, x28", 0xDAC00F9D))                                           { ret 4; }
    if (!t_listed_word("rev64 v0.16b, v1.16b", "rev64 v0.16b, v1.16b", 0x4E200820))                           { ret 5; }
    if (!t_listed_word("rev64 v31.8h, v30.8h", "rev64 v31.8h, v30.8h", 0x4E600BDF))                           { ret 6; }
    if (!t_listed_word("rev64 v2.4s, v3.4s", "rev64 v2.4s, v3.4s", 0x4EA00862))                               { ret 7; }
    if (!t_listed_word("ext v0.16b, v1.16b, v2.16b, 8", "ext v0.16b, v1.16b, v2.16b, 8", 0x6E024020))         { ret 8; }
    if (!t_listed_word("ext v31.16b, v30.16b, v29.16b, 15", "ext v31.16b, v30.16b, v29.16b, 15", 0x6E1D7BDF)) { ret 9; }
    if (!t_listed_word("ext v3.16b, v3.16b, v3.16b, 0", "ext v3.16b, v3.16b, v3.16b, 0", 0x6E030063))         { ret 10; }
    if (!t_listed_word("dup v0.2d, v1.d[1]", "dup v0.2d, v1.d[1]", 0x4E180420))                               { ret 11; }
    if (!t_listed_word("dup v2.4s, v3.s[3]", "dup v2.4s, v3.s[3]", 0x4E1C0462))                               { ret 12; }
    if (!t_listed_word("dup v4.8h, v5.h[7]", "dup v4.8h, v5.h[7]", 0x4E1E04A4))                               { ret 13; }
    if (!t_listed_word("dup v6.16b, v7.b[15]", "dup v6.16b, v7.b[15]", 0x4E1F04E6))                           { ret 14; }
    if (!t_listed_word("dup v8.2d, x9", "dup v8.2d, x9", 0x4E080D28))                                         { ret 15; }
    if (!t_listed_word("dup v10.4s, w11", "dup v10.4s, w11", 0x4E040D6A))                                     { ret 16; }
    if (!t_listed_word("dup v12.8h, w13", "dup v12.8h, w13", 0x4E020DAC))                                     { ret 17; }
    if (!t_listed_word("dup v14.16b, w15", "dup v14.16b, w15", 0x4E010DEE))                                   { ret 18; }
    if (!t_listed_word("dup v31.2d, xzr", "dup v31.2d, xzr", 0x4E080FFF))                                     { ret 19; }
    if (!t_listed_word("ins v0.d[1], x1", "mov v0.d[1], x1", 0x4E181C20))                                     { ret 20; }
    if (!t_listed_word("ins v2.s[3], w3", "mov v2.s[3], w3", 0x4E1C1C62))                                     { ret 21; }
    if (!t_listed_word("ins v4.h[0], w5", "mov v4.h[0], w5", 0x4E021CA4))                                     { ret 22; }
    if (!t_listed_word("ins v6.b[15], w7", "mov v6.b[15], w7", 0x4E1F1CE6))                                   { ret 23; }
    if (!t_listed_word("ins v8.d[0], v9.d[1]", "mov v8.d[0], v9.d[1]", 0x6E084528))                           { ret 24; }
    if (!t_listed_word("ins v10.s[1], v11.s[2]", "mov v10.s[1], v11.s[2]", 0x6E0C456A))                       { ret 25; }
    if (!t_listed_word("ins v12.b[3], v13.b[14]", "mov v12.b[3], v13.b[14]", 0x6E0775AC))                     { ret 26; }
    if (!t_listed_word("ins v14.h[7], v15.h[0]", "mov v14.h[7], v15.h[0]", 0x6E1E05EE))                       { ret 27; }
    ret 0;
}

# each row takes its operands at the widths and lanes it has a form for
test inline_asm__rev_ext_dup_ins_refuse_operands_outside_the_form {
    var bad: i32 = 0;
    if (!t_word_refused("rev w0, x1", "takes two general registers"))              { bad = bad + 1; }
    if (!t_word_refused("rev sp, x1", "takes two general registers"))              { bad = bad + 2; }
    if (!t_word_refused("rev64 v0.2d, v1.2d", "no form at this lane arrangement")) { bad = bad + 4; }
    if (!t_word_refused("ext v0.4s, v1.4s, v2.4s, 8", "takes three v.16b"))        { bad = bad + 8; }
    if (!t_word_refused("ext v0.16b, v1.16b, v2.16b, 16", "takes three v.16b"))    { bad = bad + 16; }
    if (!t_word_refused("dup v0.2d, v1.s[1]", "broadcasts a lane"))                { bad = bad + 32; }
    if (!t_word_refused("dup v0.4s, x1", "broadcasts a lane"))                     { bad = bad + 64; }
    if (!t_word_refused("ins v0.d[2], x1", "writes one lane"))                     { bad = bad + 128; }
    if (!t_word_refused("mov v0.s[1], x1", "writes one lane"))                     { bad = bad + 256; }
    if (!t_word_refused("add v0.4s, v1.s[1], v2.4s", "lane arrangement"))          { bad = bad + 512; }
    ret bad;
}

test inline_asm__aes_and_pmull_need_their_extension_or_an_outlier {
    if (!t_sha_refused("aese v0.16b, v1.16b", 0, 0,
        "inline-asm instruction 'aese' needs the `aes` extension, which this target does not select; add `extensions = [\"aes\"]` to the target, or mark the function `#[extensions(aes)]` and call it only after detecting the extension at run time")) { ret 1; }
    if (!t_sha_refused("pmull v0.1q, v1.1d, v2.1d", extension_arm64.AES | extension_arm64.SHA2, 0,
        "inline-asm instruction 'pmull' needs the `pmull` extension, which this target does not select; add `extensions = [\"pmull\"]` to the target, or mark the function `#[extensions(pmull)]` and call it only after detecting the extension at run time")) { ret 2; }
    var i: usize = 0;
    for (i < T_CRYPTO_BODY_COUNT) {
        val body: str = T_CRYPTO_BODIES[i];
        val need: u64 = T_CRYPTO_NEEDS[i];
        if (!t_sha_refused(body, 0, 0, "needs the `"))                                                                                         { ret 20 + i::i32; }
        if (!t_sha_refused(body, extension.without(?extension_arm64.NAMES[0], extension_arm64.NAME_COUNT, T_EXT_ALL, need), 0, "needs the `")) { ret 40 + i::i32; }
        if (!t_sha_admitted(body, need, 0))                                                                                                    { ret 60 + i::i32; }
        if (!t_sha_admitted(body, 0, need))                                                                                                    { ret 80 + i::i32; }
        i = i + 1;
    }
    # pmull brings aes, as the one ID_AA64ISAR0_EL1.AES field does
    if (!t_sha_admitted("aese v0.16b, v1.16b", extension_arm64.PMULL | extension_arm64.AES, 0)) { ret 5; }
    ret 0;
}

#[testing]
val T_CRYPTO_BODY_COUNT: usize = 6;

#[testing]
val T_CRYPTO_BODIES: [T_CRYPTO_BODY_COUNT]str = [T_CRYPTO_BODY_COUNT]str{
    "aese v0.16b, v1.16b", "aesd v0.16b, v1.16b", "aesmc v0.16b, v1.16b", "aesimc v0.16b, v1.16b",
    "pmull v0.1q, v1.1d, v2.1d", "pmull2 v0.1q, v1.2d, v2.2d",
};

#[testing]
val T_CRYPTO_NEEDS: [T_CRYPTO_BODY_COUNT]u64 = [T_CRYPTO_BODY_COUNT]u64{
    extension_arm64.AES, extension_arm64.AES, extension_arm64.AES, extension_arm64.AES, extension_arm64.PMULL, extension_arm64.PMULL,
};

test inline_asm__aes_and_pmull_refuse_other_operands {
    arm64_emit.select_extensions(T_EXT_ALL);
    var bad: i32 = 0;
    if (!t_word_refused("aese v0.4s, v1.4s", "takes two v.16b registers"))              { bad = 1; }
    if (!t_word_refused("aesd q0, q1", "takes two v.16b registers"))                    { bad = 2; }
    if (!t_word_refused("aesmc v0.16b, v1.16b, v2.16b", "takes two v.16b registers"))   { bad = 3; }
    if (!t_word_refused("aesimc v0.16b, x1", "takes two v.16b registers"))              { bad = 4; }
    if (!t_word_refused("pmull v0.1q, v1.2d, v2.2d", "a v.1q and two v.1d registers"))  { bad = 5; }
    if (!t_word_refused("pmull v0.2d, v1.1d, v2.1d", "a v.1q and two v.1d registers"))  { bad = 6; }
    if (!t_word_refused("pmull2 v0.1q, v1.1d, v2.1d", "a v.1q and two v.2d registers")) { bad = 7; }
    if (!t_word_refused("pmull2 v0.1q, v1.2d", "a v.1q and two v.2d registers"))        { bad = 8; }
    # the new arrangements stay out of the lane-wise rows
    if (!t_word_refused("add v0.1d, v1.1d, v2.1d", "lane arrangement"))                      { bad = 9; }
    if (!t_word_refused("eor v0.1q, v1.1q, v2.1q", "lane arrangement"))                      { bad = 10; }
    if (!t_word_refused("ld1 {v0.1d}, [x0]", "one vector register with a lane arrangement")) { bad = 11; }
    if (!t_word_refused("sha256su0 v0.1q, v1.4s", "two v.4s registers"))                     { bad = 12; }
    arm64_emit.select_extensions(0);
    ret bad;
}

# aese and aesd fold the state into the key xor; aesmc, aesimc and the
# carry-less multiplies define their destination from their sources alone. each
# is a fixed-latency row that leaves the flags alone
test inline_asm__aes_and_pmull_clobbers_and_effects {
    var gp: u32 = 0;
    var fp: u32 = 0;
    isa_asm.clobbers(grammar, "aese v3.16b, v4.16b\naesd v5.16b, v6.16b\naesmc v7.16b, v3.16b\naesimc v8.16b, v5.16b\npmull v9.1q, v1.1d, v2.1d\npmull2 v10.1q, v1.2d, v2.2d", ?gp, ?fp);
    if (gp != 0 || fp != ((1::u32 << 3) | (1::u32 << 5) | (1::u32 << 7) | (1::u32 << 8) | (1::u32 << 9) | (1::u32 << 10))) { ret 1; }
    var i: usize = 0;
    for (i < T_CRYPTO_BODY_COUNT) {
        val op:   arm64_inst.MachOp = T_CRYPTO_OPS[i];
        var src2: isa_inst.Operand  = isa_inst.make_none();
        if (op == arm64_inst.PMULL || op == arm64_inst.PMULL2) { src2 = arm64_inst.vec(2, 16); }
        var e:  isa_effect.InstEffects;
        var mi: isa_inst.Inst = arm64_emit.inst_of(op, arm64_inst.vec(0, 16), arm64_inst.vec(1, 16), src2);
        arm64_effects.describe(?mi, ?e);
        var dst: isa_effect.OperandRole = isa_effect.ROLE_WRITE;
        if (op == arm64_inst.AESE || op == arm64_inst.AESD)                                         { dst = isa_effect.ROLE_RW; }
        if (!e.cls.known || !e.cls.flags_stated || e.cls.writes_flags || e.cls.op != ct.CT_OP_NONE) { ret 10 + i::i32; }
        if (e.roles[0] != dst || e.roles[1] != isa_effect.ROLE_READ)                                { ret 20 + i::i32; }
        if (src2.kind != isa_inst.OPK_NONE && e.roles[2] != isa_effect.ROLE_READ)                   { ret 30 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

#[testing]
val T_CRYPTO_OPS: [T_CRYPTO_BODY_COUNT]arm64_inst.MachOp = [T_CRYPTO_BODY_COUNT]arm64_inst.MachOp{
    arm64_inst.AESE, arm64_inst.AESD, arm64_inst.AESMC, arm64_inst.AESIMC, arm64_inst.PMULL, arm64_inst.PMULL2,
};

# a secret state and key run through every aes row and both carry-less
# multiplies and are admitted: the rows are data-independent. the result stays
# secret, so a variable-latency multiply of it is still refused
test asm_ct_scan__aes_and_pmull_rows_admit_secrets_and_keep_them {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    if (isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\naese v0.16b, v1.16b\naesmc v0.16b, v0.16b\naesd v0.16b, v1.16b\naesimc v0.16b, v0.16b\npmull v2.1q, v0.1d, v1.1d\npmull2 v3.1q, v0.2d, v1.2d\nst1 {v3.16b}, [x2]", ?names[0], 1, ct.mul_mask_none(), false)) { ret 1; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\naese v0.16b, v1.16b\nmul v0.4s, v0.4s, v0.4s", ?names[0], 1, ct.mul_mask_none(), false))                                                                                                                    { ret 2; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\npmull v2.1q, v1.1d, v1.1d\nmul v2.4s, v2.4s, v2.4s", ?names[0], 1, ct.mul_mask_none(), false))                                                                                                              { ret 3; }
    ret 0;
}

test asm_clobbers__vector_writes_land_in_the_fp_mask {
    var gp: u32 = 0;
    var fp: u32 = 0;
    isa_asm.clobbers(grammar, "ld1 {v3.16b}, [x0], 16\nadd v3.4s, v3.4s, v9.4s\nst1 {v3.16b}, [x1]", ?gp, ?fp);
    if (gp != 1)        { ret 1; }
    if (fp != (1 << 3)) { ret 2; }
    isa_asm.clobbers(grammar, "st1 {v4.16b}, [x2], x9", ?gp, ?fp);
    if (gp != (1 << 2) || fp != 0) { ret 3; }
    isa_asm.clobbers(grammar, "mov v31.16b, v0.16b\nmvn v30.16b, v31.16b", ?gp, ?fp);
    if (gp != 0 || fp != ((1::u32 << 31) | (1::u32 << 30))) { ret 4; }
    ret 0;
}

test asm_ct_scan__vector_taint_is_its_own_bank {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    if (isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\nldr x3, [x1]", ?names[0], 1, ct.mul_mask_none(), false))             { ret 1; }
    if (isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nld1 {v1.16b}, [x2]\nmul v1.4s, v1.4s, v1.4s", ?names[0], 1, ct.mul_mask_none(), false))                { ret 2; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nstr x0, [x2]\nld1 {v1.16b}, [x2]\nmul v1.4s, v1.4s, v1.4s", ?names[0], 1, ct.mul_mask_none(), false)) { ret 3; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x1, {k}\nld1 {v0.16b}, [x2], x1", ?names[0], 1, ct.mul_mask_none(), false))                                    { ret 4; }
    ret 0;
}

test inline_asm__sysreg_reads_are_byte_exact {
    if (!t_word("mrs x0, cntvct_el0", 0xD53BE040))       { ret 1; }
    if (!t_word("mrs x0, cntkctl_el1", 0xD538E100))      { ret 2; }
    if (!t_word("mrs x0, sp_el1", 0xD53C4100))           { ret 3; }
    if (!t_word("mrs x0, currentel", 0xD5384240))        { ret 4; }
    if (!t_word("mrs x0, nzcv", 0xD53B4200))             { ret 5; }
    if (!t_word("mrs x0, vbar_el2", 0xD53CC000))         { ret 6; }
    if (!t_word("mrs x0, tpidr_el0", 0xD53BD040))        { ret 7; }
    if (!t_word("mrs x0, midr_el1", 0xD5380000))         { ret 8; }
    if (!t_word("mrs x0, id_aa64mmfr0_el1", 0xD5380700)) { ret 9; }
    ret 0;
}

test inline_asm__sysreg_writes_are_byte_exact {
    if (!t_word("msr cntv_ctl_el0, x1", 0xD51BE321)) { ret 1; }
    if (!t_word("msr sp_el1, x1", 0xD51C4101))       { ret 2; }
    if (!t_word("msr sctlr_el1, x1", 0xD5181001))    { ret 3; }
    if (!t_word("msr hcr_el2, x1", 0xD51C1101))      { ret 4; }
    ret 0;
}

test inline_asm__pstate_fields_are_byte_exact {
    if (!t_word("msr daifset, 0xf", 0xD5034FDF)) { ret 1; }
    if (!t_word("msr daifclr, 0", 0xD50340FF))   { ret 2; }
    if (!t_word("msr spsel, 1", 0xD50041BF))     { ret 3; }
    if (!t_word("msr dit, 1", 0xD503415F))       { ret 4; }
    ret 0;
}

# the words of the Arm ARM (DDI 0487, C6.2 DSB, ISB, SB): dsb takes the full
# barrier option set, isb is bare or `sy`, and `sb` is one word under FEAT_SB
test inline_asm__barriers_are_byte_exact {
    var bad: i32 = 0;
    if (!t_word("dsb sy", 0xD5033F9F))                                               { bad = 1; }
    if (!t_word("dsb ish", 0xD5033B9F))                                              { bad = 4; }
    if (!t_word("dsb oshld", 0xD503319F))                                            { bad = 12; }
    if (!t_word("isb sy", 0xD5033FDF))                                               { bad = 13; }
    if (!t_word("isb", 0xD5033FDF))                                                  { bad = 14; }
    if (!t_word("dmb nsh", 0xD50337BF))                                              { bad = 15; }
    if (!t_word_refused("dsb", "unknown aarch64 inline-asm instruction"))            { bad = 16; }
    if (!t_word_refused("dsb foo", "unsupported inline-asm dmb/dsb barrier option")) { bad = 17; }
    if (!t_word_refused("isb nsh", "takes no operand or the option `sy`"))           { bad = 18; }
    if (!t_word_refused("isb sy, sy", "takes no operand or the option `sy`"))        { bad = 19; }
    ret bad;
}

# `sb` is admitted by the target's `sb` extension or a function's
# #[extensions(sb)] outlier, and refused with the extension named otherwise
test inline_asm__sb_needs_the_extension_or_an_outlier {
    var word: u32 = 0;
    var why:  str = nil;
    if (!t_sha_run("sb", extension_arm64.SB, 0, ?word, ?why, false) || word != 0xD50330FF) { ret 1; }
    if (!t_sha_run("sb", 0, extension_arm64.SB, ?word, ?why, false) || word != 0xD50330FF) { ret 2; }
    if (!t_sha_refused("sb", 0, 0,
        "inline-asm instruction 'sb' needs the `sb` extension, which this target does not select; add `extensions = [\"sb\"]` to the target, or mark the function `#[extensions(sb)]` and call it only after detecting the extension at run time")) { ret 3; }
    if (!t_sha_refused("sb", extension_arm64.SHA2, 0, "#[extensions(sb)]")) { ret 4; }
    ret 0;
}

# the barriers and the DIT write move no data, so an oblivious body may
# spell the runtime's DIT sequence beside a loaded secret
test asm_ct_scan__admits_barriers_and_msr_dit {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    if (isa_asm.t_scan_refused(grammar, "ldr x0, {k}\nmsr dit, 1\ndsb nsh\nisb sy\nisb\ndmb ish\nadd x0, x0, x0", ?names[0], 1, ct.mul_mask_none(), false)) { ret 1; }
    var gp: u32 = 0;
    var fp: u32 = 0;
    isa_asm.clobbers(grammar, "msr dit, 1\ndsb nsh\nisb", ?gp, ?fp);
    if (gp != 0 || fp != 0) { ret 2; }
    ret 0;
}

test asm_listing__renders_sysreg_instructions {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    var w: io_writer.Writer;
    arm64_printer.test_sink_writer(?w);
    arm64_printer.test_sink_reset();
    var sink: isa_encode.AsmSink = isa_encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    val r1: err[fail.Fail] = asm_text(?st, ?f, ?labels, "mrs x0, cntvct_el0");
    if (sel r1.err) { bad = 1; }
    val r2: err[fail.Fail] = asm_text(?st, ?f, ?labels, "msr cntv_ctl_el0, x1");
    if (sel r2.err) { bad = 1; }
    val r3: err[fail.Fail] = asm_text(?st, ?f, ?labels, "msr daifset, 1");
    if (sel r3.err) { bad = 1; }

    if (isa_encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    val text: str = arm64_printer.test_sink_text();
    if (!str_contains(text, "mrs x0, s3_3_c14_c0_2")) { bad = 1; }
    if (!str_contains(text, "msr s3_3_c14_c3_1, x1")) { bad = 1; }
    if (!str_contains(text, "msr daifset, #1"))       { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

# an asm block's label definitions are listed where the block makes them,
# so the `1b` and `2f` beside them name a label the listing defines
test asm_listing__renders_local_labels {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    var w: io_writer.Writer;
    arm64_printer.test_sink_writer(?w);
    arm64_printer.test_sink_reset();
    var sink: isa_encode.AsmSink = isa_encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    val r1: err[fail.Fail] = asm_text(?st, ?f, ?labels, "1:\n cbnz x0, 1b\n b 2f\n2:\n nop");
    if (sel r1.err) { bad = 1; }

    val text: str = arm64_printer.test_sink_text();
    if (!str_contains(text, "1:\n  cbnz x0, 1b\n  b 2f\n2:\n  nop\n")) { bad = 2; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

# the high multiplies spell three x registers; a w register or an
# immediate has no encoding and is refused at the grammar
test inline_asm__high_multiplies {
    var bad: i32 = 0;
    if (!t_word("umulh x0, x1, x2", 0x9BC27C20))                     { bad = 1; }
    if (!t_word("smulh x3, x4, x5", 0x9B457C83))                     { bad = 2; }
    if (!t_word_refused("umulh w0, w1, w2", "no 32-bit form"))       { bad = 3; }
    if (!t_word_refused("smulh x0, x1, 3", "takes three registers")) { bad = 4; }
    ret bad;
}

test inline_asm__sysreg_numeric_escape {
    var bad: i32 = 0;

    if (!t_word("mrs x0, s3_3_c14_c0_2", 0xD53BE040)) { bad = 1; }
    if (!t_word("msr s3_0_c12_c0_0, x1", 0xD518C001)) { bad = 1; }

    if (!t_word("mrs x0, s2_0_c0_c0_0", 0xD5300000))   { bad = 1; }
    if (!t_word("mrs x5, s3_7_c15_c15_7", 0xD53FFFE5)) { bad = 1; }

    if (!t_word("mrs x0, S3_3_C14_C0_2", 0xD53BE040)) { bad = 1; }
    if (!t_word("mrs x0, CNTVCT_EL0", 0xD53BE040))    { bad = 1; }

    if (!t_word_refused("mrs x0, s3_9_c0_c0_0", "unsupported inline-asm mrs system register"))  { bad = 1; }
    if (!t_word_refused("mrs x0, s3_0_c16_c0_0", "unsupported inline-asm mrs system register")) { bad = 1; }
    if (!t_word_refused("mrs x0, s3_0_c0_c16_0", "unsupported inline-asm mrs system register")) { bad = 1; }
    if (!t_word_refused("mrs x0, s3_0_c0_c0_8", "unsupported inline-asm mrs system register"))  { bad = 1; }
    if (!t_word_refused("mrs x0, s1_0_c0_c0_0", "unsupported inline-asm mrs system register"))  { bad = 1; }

    if (!t_word_refused("mrs x0, s3_3_c14_c0", "unsupported inline-asm mrs system register"))    { bad = 1; }
    if (!t_word_refused("mrs x0, s3_3_14_c0_2", "unsupported inline-asm mrs system register"))   { bad = 1; }
    if (!t_word_refused("mrs x0, s3_3_c14_c0_2x", "unsupported inline-asm mrs system register")) { bad = 1; }
    if (!t_word_refused("mrs x0, s_3_c14_c0_2", "unsupported inline-asm mrs system register"))   { bad = 1; }

    if (!t_word_refused("mrs x0, cntvct_el9", "unsupported inline-asm mrs system register"))     { bad = 1; }
    if (!t_word_refused("msr frobnicate, x1", "unsupported inline-asm msr system register"))     { bad = 1; }
    if (!t_word_refused("msr frobnicate, 1", "unsupported inline-asm msr PSTATE field"))         { bad = 1; }
    if (!t_word_refused("mrs x0, this_name_is_far_longer_than_any_system_register", "too long")) { bad = 1; }

    ret bad;
}

test inline_asm__cset_forms {
    if (!t_word("cset x9, cs", 0x9A9F37E9))  { ret 1; }
    if (!t_word("cset w9, cs", 0x1A9F37E9))  { ret 2; }
    if (!t_word("cset x0, eq", 0x9A9F17E0))  { ret 3; }
    if (!t_word("cset x5, ne", 0x9A9F07E5))  { ret 4; }
    if (!t_word("cset x9, lt", 0x9A9FA7E9))  { ret 5; }
    if (!t_word("cset w19, le", 0x1A9FC7F3)) { ret 6; }
    if (!t_word("cset x3, hi", 0x9A9F97E3))  { ret 7; }
    if (!t_word("cset w7, ge", 0x1A9FB7E7))  { ret 8; }
    ret 0;
}

test inline_asm__load_store_forms {
    if (!t_word("ldr x0, [x1]", 0xF9400020))             { ret 1; }
    if (!t_word("ldr x0, [x1, 8]", 0xF9400420))          { ret 2; }
    if (!t_word("ldr x0, [x1, x2]", 0xF8626820))         { ret 3; }
    if (!t_word("str w0, [x1, 4]", 0xB9000420))          { ret 4; }
    if (!t_word("ldrb w0, [x1]", 0x39400020))            { ret 5; }
    if (!t_word("ldrh w0, [x1, 2]", 0x79400420))         { ret 6; }
    if (!t_word("strb w0, [x1, 1]", 0x39000420))         { ret 7; }
    if (!t_word("ldr x0, [x1, -8]", 0xF85F8020))         { ret 8; }
    if (!t_word("str x0, [sp, 8]", 0xF90007E0))          { ret 9; }
    if (!t_word("stp x29, x30, [sp, -16]!", 0xA9BF7BFD)) { ret 10; }
    if (!t_word("ldp x29, x30, [sp], 16", 0xA8C17BFD))   { ret 11; }
    if (!t_word("stp x19, x20, [sp, 16]", 0xA90153F3))   { ret 12; }
    ret 0;
}

test inline_asm__atomic_and_barrier_forms {
    if (!t_word("dmb ish", 0xD5033BBF))            { ret 1; }
    if (!t_word("yield", 0xD503203F))              { ret 2; }
    if (!t_word("ldar x0, [x1]", 0xC8DFFC20))      { ret 3; }
    if (!t_word("ldar w0, [x1]", 0x88DFFC20))      { ret 4; }
    if (!t_word("stlr x0, [x1]", 0xC89FFC20))      { ret 5; }
    if (!t_word("ldaxr x0, [x1]", 0xC85FFC20))     { ret 6; }
    if (!t_word("stlxr w2, x0, [x1]", 0xC802FC20)) { ret 7; }
    if (!t_word("stlxr w2, w0, [x1]", 0x8802FC20)) { ret 8; }
    ret 0;
}

test inline_asm__shift_forms {
    if (!t_word("lsl x10, x10, 3", 0xD37DF14A)) { ret 1; }
    if (!t_word("lsl w0, w1, 3", 0x531D7020))   { ret 2; }
    if (!t_word("lsr x0, x1, 3", 0xD343FC20))   { ret 3; }
    if (!t_word("asr x0, x1, 3", 0x9343FC20))   { ret 4; }
    if (!t_word("lsl x0, x1, x2", 0x9AC22020))  { ret 5; }
    if (!t_word("lsr x0, x1, x2", 0x9AC22420))  { ret 6; }
    if (!t_word("lslv x0, x1, x2", 0x9AC22020)) { ret 7; }
    ret 0;
}

test inline_asm__symbol_relocations {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val gr: res[intern.StrId, A.Error] = intern.add(?interner, "gsym");
    val fr: res[intern.StrId, A.Error] = intern.add(?interner, "fsym");
    if (sel gr.err) { ret 1; }
    if (sel fr.err) { ret 1; }
    val g:    intern.StrId = gr.ok;
    val fsym: intern.StrId = fr.ok;

    asm_text(?st, ?f, ?labels, "adrp x0, gsym");
    asm_text(?st, ?f, ?labels, "add x0, x0, :lo12:gsym");
    asm_text(?st, ?f, ?labels, "bl fsym");
    asm_text(?st, ?f, ?labels, "ldr x0, [x16, :lo12:gsym]");
    asm_text(?st, ?f, ?labels, "str w1, [x16, :lo12:gsym]");
    asm_text(?st, ?f, ?labels, "ldrb w0, [x16, :lo12:gsym]");

    if (isa_encode.word_read(?st.buf, 0) != 0x90000000)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0x91000000)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0x94000000)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 12) != 0xF9400200) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0xB9000201) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 20) != 0x39400200) { bad = 1; }

    if (st.reloc_count != 6) { bad = 1; }
    or {
        if (st.relocs[0].kind != target_of.RK_PAGE21 || st.relocs[0].offset != 0 || !intern.str_same(st.relocs[0].sym, g)) { bad = 1; }
        # a relocation the asm text asked for is the user's
        if (st.relocs[0].origin != target_of.RELOC_ASM || st.relocs[5].origin != target_of.RELOC_ASM)                            { bad = 1; }
        if (st.relocs[1].kind != target_of.RK_ADD_LO12 || st.relocs[1].offset != 4 || !intern.str_same(st.relocs[1].sym, g))     { bad = 1; }
        if (st.relocs[2].kind != target_of.RK_PLT32 || st.relocs[2].offset != 8 || !intern.str_same(st.relocs[2].sym, fsym))     { bad = 1; }
        if (st.relocs[3].kind != target_of.RK_LDST64_LO12 || st.relocs[3].offset != 12 || !intern.str_same(st.relocs[3].sym, g)) { bad = 1; }
        if (st.relocs[4].kind != target_of.RK_LDST32_LO12 || st.relocs[4].offset != 16 || !intern.str_same(st.relocs[4].sym, g)) { bad = 1; }
        if (st.relocs[5].kind != target_of.RK_LDST8_LO12 || st.relocs[5].offset != 20 || !intern.str_same(st.relocs[5].sym, g))  { bad = 1; }
    }

    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__long_symbol_operand {
    var bad: i32 = 0;

    var st1:       isa_encode.EncodeState;
    var alloc1:    A.Allocator;
    var interner1: intern.Interner;
    arm64_emit.tasm(?st1, ?alloc1, ?interner1);
    var labels1: isa_asm.Labels;
    isa_asm.labels_init(?labels1, ?alloc1);
    var f1: lang_mir.MirFunction;
    val r1: err[fail.Fail] = asm_text(?st1, ?f1, ?labels1, "bl short_sym");
    if (sel r1.err) { bad = 1; }

    val long_name: str =
        "sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    val long_call: str =
        "bl sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    var st2:       isa_encode.EncodeState;
    var alloc2:    A.Allocator;
    var interner2: intern.Interner;
    arm64_emit.tasm(?st2, ?alloc2, ?interner2);
    var labels2: isa_asm.Labels;
    isa_asm.labels_init(?labels2, ?alloc2);
    var f2: lang_mir.MirFunction;
    val r2: err[fail.Fail] = asm_text(?st2, ?f2, ?labels2, long_call);
    if (sel r2.err) { bad = 1; }

    if (st1.buf.bytes.len != st2.buf.bytes.len) { bad = 1; }
    or {
        var i: usize = 0;
        for (i < st1.buf.bytes.len) {
            if (st1.buf.bytes.data[i] != st2.buf.bytes.data[i]) { bad = 1; }
            i = i + 1;
        }
    }

    if (st2.reloc_count == 0) { bad = 1; }
    or {
        val nm: opt[str] = intern.get(st2.interner, st2.relocs[st2.reloc_count - 1].sym);
        if (sel nm.some && !str_equals(nm.some, long_name)) { bad = 1; }
    }

    var st3:       isa_encode.EncodeState;
    var alloc3:    A.Allocator;
    var interner3: intern.Interner;
    arm64_emit.tasm(?st3, ?alloc3, ?interner3);
    var labels3: isa_asm.Labels;
    isa_asm.labels_init(?labels3, ?alloc3);
    var f3: lang_mir.MirFunction;
    val r3: err[fail.Fail] = asm_text(?st3, ?f3, ?labels3, "ldr x0, [x0");
    if (sel r3.ok) { bad = 1; }

    if (st1.relocs != nil && st1.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc1, st1.relocs, st1.reloc_cap::usize);
    }
    if (st2.relocs != nil && st2.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc2, st2.relocs, st2.reloc_cap::usize);
    }
    if (st3.relocs != nil && st3.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc3, st3.relocs, st3.reloc_cap::usize);
    }
    isa_asm.labels_dnit(?labels1);
    isa_encode.buf_dnit(?st1.buf);
    isa_asm.labels_dnit(?labels2);
    isa_encode.buf_dnit(?st2.buf);
    isa_asm.labels_dnit(?labels3);
    isa_encode.buf_dnit(?st3.buf);
    ret bad;
}

test inline_asm__branches_to_numeric_local_labels {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    asm_text(?st, ?f, ?labels, "nop");
    asm_text(?st, ?f, ?labels, "cbz x0, 1f");
    asm_text(?st, ?f, ?labels, "b.eq 1f");
    asm_text(?st, ?f, ?labels, "1: nop");
    asm_text(?st, ?f, ?labels, "b 1b");
    asm_text(?st, ?f, ?labels, "cbnz w1, 1b");

    if (isa_encode.word_read(?st.buf, 4) != 0xB4000040)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0x54000020)  { bad = 1; }
    if (isa_encode.word_read(?st.buf, 16) != 0x17FFFFFF) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 20) != 0x35FFFFC1) { bad = 1; }
    if (labels.fixup_count != 0)                         { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__name_local_resolves_to_a_frame_slot {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);

    var slots: [1]lang_mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = lang_mir.SLOT_SPILL;
    slots[0].offset = -8192;
    slots[0].size   = 4;
    slots[0].align  = 4;
    var f: lang_mir.MirFunction;
    f.frame.slots         = ?slots[0];
    f.frame.slot_count    = 1;
    f.frame.size          = 8192;
    f.frame.outgoing_size = 64;
    f.frame.realign       = 0;
    f.callee_mask         = 0;
    f.callee_mask_fp      = 0;
    f.frame.base_dist     = 8256;

    val xr: res[intern.StrId, A.Error] = intern.add(?interner, "x");
    if (sel xr.err) { ret 1; }
    var binds: [1]lang_mir.MirAsmBind;
    binds[0].name      = xr.ok;
    binds[0].slot_vreg = 100;

    var pl: lang_mir.MirAsm;
    pl.isa        = "aarch64";
    pl.body       = "ldr w0, {x}\nstr w0, {x}";
    pl.binds      = ?binds[0];
    pl.bind_count = 1;

    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block = ?pl;

    val r: err[fail.Fail] = encode_asm_block(?st, ?f, 0, ?mi);
    if (sel r.err) { bad = 1; }
    if (sel r.ok) {
        if (isa_encode.word_read(?st.buf, 0) != 0xB94043E0) { bad = 1; }
        if (isa_encode.word_read(?st.buf, 4) != 0xB90043E0) { bad = 1; }
    }

    val nsr: res[bool, fail.Fail] = arm64_emit.mem_access_needs_no_scratch(-8192, 4);
    if (sel nsr.ok && nsr.ok) { bad = 1; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__name_local_refuses_a_body_that_moves_sp {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);

    var slots: [1]lang_mir.MirSlot;
    slots[0].value  = 100;
    slots[0].kind   = lang_mir.SLOT_SPILL;
    slots[0].offset = -16;
    slots[0].size   = 8;
    slots[0].align  = 8;
    var f: lang_mir.MirFunction;
    f.frame.slots      = ?slots[0];
    f.frame.slot_count = 1;
    f.frame.size       = 16;

    val xr: res[intern.StrId, A.Error] = intern.add(?interner, "x");
    if (sel xr.err) { ret 1; }
    var binds: [1]lang_mir.MirAsmBind;
    binds[0].name      = xr.ok;
    binds[0].slot_vreg = 100;

    var pl: lang_mir.MirAsm;
    pl.isa        = "aarch64";
    pl.binds      = ?binds[0];
    pl.bind_count = 1;

    var mi: lang_mir.MirInstr = lang_mir.instr(lang_mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block = ?pl;

    pl.body = "ldr x0, {x}\nsub sp, sp, 16";
    var encoded: err[fail.Fail] = encode_asm_block(?st, ?f, 0, ?mi);
    if (!sel encoded.err) { bad = 1; }

    pl.body = "ldr x0, {x}\nstp x1, x2, [sp, -16]!";
    encoded = encode_asm_block(?st, ?f, 0, ?mi);
    if (!sel encoded.err) { bad = 2; }

    pl.body = "ldr x0, {x}\n.word 0xd10043ff";
    encoded = encode_asm_block(?st, ?f, 0, ?mi);
    if (!sel encoded.err) { bad = 3; }

    pl.body = "ldr x0, {x}\nmov xzr, x1\nldr x2, [sp, 8]";
    encoded = encode_asm_block(?st, ?f, 0, ?mi);
    if (sel encoded.err) { bad = 4; }

    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

#[testing]
fun t_asm_instr(mi: *lang_mir.MirInstr, pl: *lang_mir.MirAsm, body: str) {
    pl.isa        = "aarch64";
    pl.body       = body;
    pl.binds      = nil;
    pl.bind_count = 0;
    @mi           = lang_mir.instr(lang_mir.MIR_ASM, nil, 0, 0, 0);
    mi.asm_block  = pl;
}

#[testing]
fun t_writes_sp(m: *isa.RegMachine, instrs: *lang_mir.MirInstr, n: u32) bool {
    var blk: lang_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = n;
    var f: lang_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    ret isa.body_writes_sp(m, ?f, lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.SP)));
}

test asm_writes_sp__clears_the_fixed_sp {
    var bad: i32 = 0;
    if (!isa_asm.writes_sp(grammar, "sub sp, sp, 16"))              { bad = bad | 1; }
    if (!isa_asm.writes_sp(grammar, "stp x1, x2, [sp, -16]!"))      { bad = bad | 2; }
    if (!isa_asm.writes_sp(grammar, ".word 0xd10043ff"))            { bad = bad | 4; }
    if (!isa_asm.writes_sp(grammar, "frobnicate"))                  { bad = bad | 8; }
    if (isa_asm.writes_sp(grammar, "mov xzr, x1\nldr x2, [sp, 8]")) { bad = bad | 16; }
    if (isa_asm.writes_sp(grammar, "nop"))                          { bad = bad | 32; }

    var m:      isa.RegMachine = isa.RegMachine{scratch_reg: isa_inst.REG_NONE, scratch_reg2: isa_inst.REG_NONE, frame_ptr_reg: isa_inst.REG_NONE, stack_ptr_reg: isa_inst.REG_NONE, has_assembly: true, assembly: isa.AssemblyCapabilities{grammar: grammar, returns: returns}};
    var pl:     [2]lang_mir.MirAsm;
    var instrs: [2]lang_mir.MirInstr;
    t_asm_instr(?instrs[0], ?pl[0], "nop");
    t_asm_instr(?instrs[1], ?pl[1], "sub sp, sp, 64");
    if (t_writes_sp(?m, ?instrs[0], 1))  { bad = bad | 64; }
    if (!t_writes_sp(?m, ?instrs[0], 2)) { bad = bad | 128; }

    # a machine without the assembly group cannot read the body, so it assumes a write
    var bare: isa.RegMachine = isa.RegMachine{scratch_reg: isa_inst.REG_NONE, scratch_reg2: isa_inst.REG_NONE, frame_ptr_reg: isa_inst.REG_NONE, stack_ptr_reg: isa_inst.REG_NONE};
    if (!t_writes_sp(?bare, ?instrs[0], 1)) { bad = bad | 256; }

    # an instruction naming sp as a register operand
    var ops: [2]lang_mir.MirOperand;
    ops[0]    = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.SP)));
    ops[1]    = lang_mir.op_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.X1)));
    instrs[1] = lang_mir.instr(lang_mir.MIR_MOV, ?ops[0], 2, 8, 8);
    if (!t_writes_sp(?m, ?instrs[1], 1)) { bad = bad | 512; }
    # sp as a memory base is a read
    ops[0] = lang_mir.op_mem_preg(lang_mir.preg_id(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, arm64.SP)), 8);
    if (t_writes_sp(?m, ?instrs[1], 1)) { bad = bad | 1024; }
    ret bad;
}

test inline_asm__rejects_unknown_mnemonic_and_condbr_to_symbol {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val r1: err[fail.Fail] = asm_text(?st, ?f, ?labels, "frobnicate x0, x1");
    if (!sel r1.err) { bad = 1; }
    or (sel r1.err) {
        if (!str_contains(fail.describe(r1.err), "unknown aarch64 inline-asm instruction")) { bad = 1; }
    }

    val r2: err[fail.Fail] = asm_text(?st, ?f, ?labels, "cbz x0, some_symbol");
    if (!sel r2.err) { bad = 1; }
    or (sel r2.err) {
        if (!str_contains(fail.describe(r2.err), "no imm19 relocation kind")) { bad = 1; }
    }

    val r3: err[fail.Fail] = asm_text(?st, ?f, ?labels, "b.eq some_symbol");
    if (!sel r3.err) { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test asm_clobbers__classification {
    var bad: i32 = 0;
    var gp:  u32 = 0;
    var fp:  u32 = 0;

    isa_asm.clobbers(grammar, "ldr x0, [x1]\nstr x0, [x1, 8]\nbl main", ?gp, ?fp);
    if ((gp & 1) == 0)                                                     { bad = 1; }
    if ((gp & arm64_mnemonic.CALLER_SAVED) != arm64_mnemonic.CALLER_SAVED) { bad = 1; }
    if (fp != 0)                                                           { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "mov x8, 93\nsvc 0", ?gp, ?fp);
    if (gp != ((1::u32 << 8) | 1)) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "ldr x0, {v}\nstr x1, {out}", ?gp, ?fp);
    if (gp != 1) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "dmb ish\ncmp x0, x1\nstlr x9, [x12]\nstlxr w11, x10, [x12]", ?gp, ?fp);
    if (gp != (1::u32 << 11)) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "ldp x1, x2, [sp], 16", ?gp, ?fp);
    if (gp != ((1::u32 << 1) | (1::u32 << 2) | (1::u32 << 31))) { bad = 1; }
    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "stp x1, x2, [sp, -16]!", ?gp, ?fp);
    if (gp != (1::u32 << 31)) { bad = 1; }
    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "stp x1, x2, [sp, 16]", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "frobnicate x0, x1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }
    ret bad;
}

test inline_asm__systems_mnemonics {
    if (!t_word("hvc 0x1234", 0xD4024682)) { ret 1; }
    if (!t_word("smc 0", 0xD4000003))      { ret 2; }
    if (!t_word("wfi", 0xD503207F))        { ret 3; }
    if (!t_word("wfe", 0xD503205F))        { ret 4; }
    ret 0;
}

test asm_clobbers__systems_mnemonics {
    var bad: i32 = 0;
    var gp:  u32 = 0;
    var fp:  u32 = 0;

    isa_asm.clobbers(grammar, "mov x0, 0x84000008\nhvc 0", ?gp, ?fp);
    if (gp != (arm64_mnemonic.SMCCC_CLOBBER | 1)) { bad = 1; }
    if (fp != 0)                                  { bad = 1; }
    if ((gp & (1::u32 << 18)) != 0)               { bad = 1; }
    if ((gp & (1::u32 << 30)) != 0)               { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "smc 0", ?gp, ?fp);
    if (gp != arm64_mnemonic.SMCCC_CLOBBER) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "wfi", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "wfi 0", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "hvc", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test asm_clobbers__declared_raw_encodings {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    isa_asm.clobbers(grammar, ".word 0xd4000002 :: writes(x0, x1, x2, x3)", ?gp, ?fp);
    if (gp != 0xF) { bad = 1; }
    if (fp != 0)   { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd4000002", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    if (fp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd503207f :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd503201f :: writes(v7, v31)", ?gp, ?fp);
    if (gp != 0)                                { bad = 1; }
    if (fp != ((1::u32 << 7) | (1::u32 << 31))) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd503201f :: writes(x30)", ?gp, ?fp);
    if (gp != (1::u32 << 30)) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd503201f :: writes(w0)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd503201f :: writes(v2.4s)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }
    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".word 0xd503201f :: writes(x31)", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "mov x0, x1 :: writes()", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    ret bad;
}

test inline_asm__declared_raw_encodings_emit_unchanged {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    asm_text(?st, ?f, ?labels, ".word 0xd4000002 :: writes(x0)");
    asm_text(?st, ?f, ?labels, ".word 0xd4000002");
    asm_text(?st, ?f, ?labels, ".word 0xd503207f :: writes()");

    if (isa_encode.word_read(?st.buf, 0) != 0xD4000002) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xD4000002) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 8) != 0xD503207F) { bad = 1; }
    if (st.buf.bytes.len != 12)                         { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test inline_asm__ldst_offset_needing_a_scratch_is_refused {
    var bad: i32 = 0;

    if (!t_accepts("ldr x9, [x12, 32760]")) { bad = 1; }
    if (!t_refuses("ldr x9, [x12, 32768]")) { bad = 1; }

    if (!t_accepts("ldr x9, [x12, 255]"))  { bad = 1; }
    if (!t_accepts("ldr x9, [x12, -256]")) { bad = 1; }
    if (!t_refuses("ldr x9, [x12, 257]"))  { bad = 1; }
    if (!t_refuses("ldr x9, [x12, -257]")) { bad = 1; }

    if (!t_accepts("ldrb w9, [x12, 4095]")) { bad = 1; }
    if (!t_refuses("ldrb w9, [x12, 4096]")) { bad = 1; }
    if (!t_accepts("ldrh w9, [x12, 8190]")) { bad = 1; }
    if (!t_refuses("ldrh w9, [x12, 8192]")) { bad = 1; }

    ret bad;
}

#[testing]
fun t_accepts(text: str) bool {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f:  lang_mir.MirFunction;
    val r:  err[fail.Fail] = asm_text(?st, ?f, ?labels, text);
    val ok: bool           = !sel r.err && st.buf.bytes.len == 4;
    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret ok;
}

#[testing]
fun t_refuses(text: str) bool {
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f:  lang_mir.MirFunction;
    val r:  err[fail.Fail] = asm_text(?st, ?f, ?labels, text);
    var ok: bool           = false;
    if (sel r.err) {
        ok = str_contains(fail.describe(r.err), "scratch register this body may be using");
    }
    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret ok;
}

test asm_clobbers__unparsed_text_is_opaque {
    var bad: i32 = 0;
    var gp:  u32 = 0;
    var fp:  u32 = 0;

    isa_asm.clobbers(grammar, "add x0, x1, x2 junk", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "nop 1", ?gp, ?fp);
    if (gp != 0xFFFFFFFF) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "  add x0 , x1 , x2  ;  mov x3, x4  ", ?gp, ?fp);
    if (gp != (1 | (1::u32 << 3))) { bad = 1; }
    ret bad;
}

test inline_asm__relocation_modifiers {
    var bad:      i32 = 0;
    var st:       isa_encode.EncodeState;
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    arm64_emit.tasm(?st, ?alloc, ?interner);
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var f: lang_mir.MirFunction;

    val ar: err[fail.Fail] = asm_text(?st, ?f, ?labels, "adrp x0, :got:foo");
    if (sel ar.err) { bad = 1; }
    val lr: err[fail.Fail] = asm_text(?st, ?f, ?labels, "ldr x0, [x0, :got_lo12:foo]");
    if (sel lr.err)                                     { bad = 1; }
    if (isa_encode.word_read(?st.buf, 0) != 0x90000000) { bad = 1; }
    if (isa_encode.word_read(?st.buf, 4) != 0xF9400000) { bad = 1; }
    if (st.reloc_count != 2)                            { bad = 1; }
    or {
        if (st.relocs[0].kind != target_of.RK_GOT_PAGE21) { bad = 1; }
        if (st.relocs[1].kind != target_of.RK_GOT_LO12)   { bad = 1; }
    }

    val br: err[fail.Fail] = asm_text(?st, ?f, ?labels, "adrp x0, :bogus:foo");
    if (!sel br.err) { bad = 1; }
    or (sel br.err) {
        if (!str_contains(fail.describe(br.err), "unsupported aarch64 inline-asm relocation modifier")) { bad = 1; }
    }

    val lo: err[fail.Fail] = asm_text(?st, ?f, ?labels, "adrp x0, :lo12:foo");
    if (!sel lo.err) { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    if (st.relocs != nil && st.reloc_cap > 0) {
        A.deallocate[isa_encode.PendingReloc](?alloc, st.relocs, st.reloc_cap::usize);
    }
    ret bad;
}

test asm_listing__emitters_notify_once_per_word {
    var alloc:    A.Allocator;
    var interner: intern.Interner;
    var st:       isa_encode.EncodeState;
    arm64_emit.tasm(?st, ?alloc, ?interner);

    var w: io_writer.Writer;
    arm64_printer.test_sink_writer(?w);
    arm64_printer.test_sink_reset();

    var sink: isa_encode.AsmSink = isa_encode.sink_init(?w, ?interner);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    arm64_emit.movewide_seq(?st, 0, 0x123456789ABCDEF0, true);
    if (st.buf.bytes.len != 16)                    { bad = 1; }
    if (isa_encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    arm64_emit.mem_access(?st, 0, 1, 100000, 8, true);
    if (isa_encode.sink_unaccounted(?st.buf) != 0) { bad = 1; }

    if (sink.failed) { bad = 1; }
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test asm_ct_scan__a_spill_does_not_launder_a_secret {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val addr:    str                = "ldr x0, {r}\nstr x0, [sp]\nldr x1, [sp]\nldr x2, [x1]";
    var scanned: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, addr, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, addr, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 2; }

    val br: str = "ldr x0, {r}\nstr x0, [sp]\nldr x1, [sp]\ncbnz x1, 1f\n1:\nnop";
    scanned = isa_asm.ct_scan(grammar, br, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 4; }
    scanned = isa_asm.ct_scan(grammar, br, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }

    ret bad;
}

# a `*^T` binding is a public address whose loads produce a secret; a `^T` binding is a
# secret value, so it is a secret address
test asm_ct_scan__a_pointer_to_a_secret_is_a_public_address_and_a_secret_load {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var binds: [2]ct.AsmSecret;
    binds[0] = ct.asm_secret_pointee("p");
    binds[1] = ct.asm_secret_value("k");

    if (isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nldr w1, [x0]\nadd w1, w1, 1\nstr w1, [x0]", ?binds[0], 2, ct.mul_mask_none(), false))                          { bad = bad + 1; }
    if (isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nld1 {v0.16b}, [x0]\neor v0.16b, v0.16b, v1.16b\nst1 {v0.16b}, [x0]", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 2; }

    val secret_addr: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "ldr x0, {k}\nldr w1, [x0]", ?binds[0], 2, ct.mul_mask_none(), false);
    if (sel secret_addr.err) {
        if (!str_contains(secret_addr.err.message, "addresses memory with a secret value")) { bad = bad + 4; }
    }
    or { bad = bad + 4; }

    val branch: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "ldr x0, {p}\nldr w1, [x0]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false);
    if (sel branch.err) {
        if (!str_contains(branch.err.message, "branches on a secret value")) { bad = bad + 8; }
    }
    or                                                                                                                                            { bad = bad + 8; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nldr w1, [x0]\ncmp w1, w2\nb.eq 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false))     { bad = bad + 16; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nldr x1, [x0]\nldr x2, [x1]", ?binds[0], 2, ct.mul_mask_none(), false))                     { bad = bad + 32; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nmov x3, x0\nldr w1, [x3]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 64; }

    if (isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nldr w1, [x0]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 0, ct.mul_mask_none(), false))                              { bad = bad + 128; }
    if (!isa_asm.t_scan_refused(grammar, "ldr x0, {p}\nstr x0, [sp]\nldr x3, [sp]\nldr w1, [x3]\ncbnz w1, 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 256; }

    ret bad;
}

# the preferred `lsl` spelling with a register count is lslv: the variable
# shift class, refused on a secret count when the target does not trust it
test asm_ct_scan__register_count_shift_alias_is_a_variable_shift {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad:   i32 = 0;
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("c");

    val alias:     str                = "ldr x2, {c}\nlsl x0, x1, x2";
    val spelled:   str                = "ldr x2, {c}\nlslv x0, x1, x2";
    val immediate: str                = "ldr x2, {c}\nlsl x0, x2, 3";
    var scanned:   err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, alias, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, spelled, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 2; }
    scanned = isa_asm.ct_scan(grammar, alias, ?names[0], 1, ct.mul_mask_none(), true);
    if (sel scanned.err) { bad = bad + 4; }
    scanned = isa_asm.ct_scan(grammar, immediate, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }
    scanned = isa_asm.ct_scan(grammar, alias, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 16; }
    ret bad;
}

test asm_ct_scan__register_indirect_transfer_on_secret_refused {
    var alloc: A.Allocator;
    page.make(?alloc);

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val brt: str = "ldr x9, {r}\nbr x9";
    if (!isa_asm.t_scan_refused(grammar, brt, ?names[0], 1, ct.mul_mask_none(), false)) { ret 1; }
    if (isa_asm.t_scan_refused(grammar, brt, ?names[0], 0, ct.mul_mask_none(), false))  { ret 2; }

    val blrt: str = "ldr x9, {r}\nblr x9";
    if (!isa_asm.t_scan_refused(grammar, blrt, ?names[0], 1, ct.mul_mask_none(), false)) { ret 3; }
    if (isa_asm.t_scan_refused(grammar, blrt, ?names[0], 0, ct.mul_mask_none(), false))  { ret 4; }

    val rett: str = "ldr x30, {r}\nret";
    if (!isa_asm.t_scan_refused(grammar, rett, ?names[0], 1, ct.mul_mask_none(), false)) { ret 5; }
    if (isa_asm.t_scan_refused(grammar, rett, ?names[0], 0, ct.mul_mask_none(), false))  { ret 6; }

    val retreg: str = "ldr x9, {r}\nret x9";
    if (!isa_asm.t_scan_refused(grammar, retreg, ?names[0], 1, ct.mul_mask_none(), false)) { ret 7; }

    val pubbr: str = "mov x9, 5\nbr x9";
    if (isa_asm.t_scan_refused(grammar, pubbr, ?names[0], 1, ct.mul_mask_none(), false)) { ret 8; }

    val pubret: str = "mov x30, 5\nret";
    if (isa_asm.t_scan_refused(grammar, pubret, ?names[0], 1, ct.mul_mask_none(), false)) { ret 9; }

    val ordinaryret: str = "ldr x0, {r}\nret";
    if (isa_asm.t_scan_refused(grammar, ordinaryret, ?names[0], 1, ct.mul_mask_none(), false)) { ret 10; }

    val direct: str = "b some_symbol";
    if (isa_asm.t_scan_refused(grammar, direct, ?names[0], 1, ct.mul_mask_none(), false)) { ret 11; }

    ret 0;
}

# cset and mrs nzcv both read the flags a secret compare defined
test asm_ct_scan__flag_readers_carry_the_flags_taint {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val leak:    str                = "ldr x0, {r}\ncmp x0, x1\ncset x2, eq\nldr x3, [x2]";
    var scanned: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, leak, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, leak, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 2; }

    val pubcmp: str = "mov x0, 5\ncmp x0, x1\ncset x2, eq\nldr x3, [x2]";
    scanned = isa_asm.ct_scan(grammar, pubcmp, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 4; }

    val nocmp: str = "ldr x0, {r}\ncset x2, eq\nldr x3, [x2]";
    scanned = isa_asm.ct_scan(grammar, nocmp, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }

    val mrs_leak: str = "ldr x0, {r}\ncmp x0, x1\nmrs x2, nzcv\nldr x3, [x2]";
    scanned = isa_asm.ct_scan(grammar, mrs_leak, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 16; }

    val mrs_pubcmp: str = "mov x0, 5\ncmp x0, x1\nmrs x2, nzcv\nldr x3, [x2]";
    scanned = isa_asm.ct_scan(grammar, mrs_pubcmp, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 32; }

    val mrs_nocmp: str = "ldr x0, {r}\nmrs x2, nzcv\nldr x3, [x2]";
    scanned = isa_asm.ct_scan(grammar, mrs_nocmp, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 64; }

    ret bad;
}

test asm_ct_scan__cmp_defines_rather_than_merely_writes_flags {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val leak:    str                = "ldr x0, {r}\ncmp x0, x1\nb.eq 1f\n1:\nnop";
    var scanned: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, leak, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, leak, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 2; }

    val pubcmp: str = "mov x0, 5\ncmp x0, x1\nb.eq 1f\n1:\nnop";
    scanned = isa_asm.ct_scan(grammar, pubcmp, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 4; }

    val redefined: str = "ldr x0, {r}\ncmp x0, x1\nmov x2, 5\ncmp x2, x1\nb.eq 1f\n1:\nnop";
    scanned = isa_asm.ct_scan(grammar, redefined, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }

    ret bad;
}

test asm_ct_class__decode_channel_is_classified {
    var bad:      i32 = 0;
    var accepted: u32 = 0;

    var a: u32 = 0;
    for (a < 26) {
        var b: u32 = 0;
        for (b < 26) {
            var buf: [8]u8;
            buf[0] = 98;
            buf[1] = 46;
            buf[2] = (97 + a)::u8;
            buf[3] = (97 + b)::u8;
            buf[4] = 0;
            val body: str = (?buf[0])::str;

            var m: isa_asm.Mnemonic;
            var n: usize = 0;
            if (decode_bcond(body, 0, 4, ?m, ?n)) {
                accepted = accepted + 1;
                val cls: ct.AsmClass = arm64_effects.asm_ct_class(m.code, m.flags);
                if (!cls.cond_flags)             { bad = 1; }
                if (m.code != arm64_inst.B::u32) { bad = 1; }
            }
            b = b + 1;
        }
        a = a + 1;
    }

    if (accepted == 0) { bad = 1; }
    ret bad;
}

test asm_returns__trap_ends_control {
    var bad: i32 = 0;

    if (isa_asm.returns(grammar, "mov x8, 94\nsvc 0\nbrk 0")) { bad = 1; }
    if (isa_asm.returns(grammar, "brk 0"))                    { bad = 1; }

    if (!isa_asm.returns(grammar, "mov x8, 64\nsvc 0")) { bad = 1; }
    if (!isa_asm.returns(grammar, "nop"))               { bad = 1; }
    if (!isa_asm.returns(grammar, "brk 0\nnop"))        { bad = 1; }
    if (!isa_asm.returns(grammar, "1:\nbrk 0"))         { bad = 1; }
    if (!isa_asm.returns(grammar, ".word 0xd4200000"))  { bad = 1; }
    if (!isa_asm.returns(grammar, "this is not asm"))   { bad = 1; }
    if (!isa_asm.returns(grammar, ""))                  { bad = 1; }

    ret bad;
}
