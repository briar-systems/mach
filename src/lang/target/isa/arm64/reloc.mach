use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.of.bin;
use rel: mach.lang.target.of.reloc;

pub fun is_local_got_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_GOT_PAGE21 || kind == of.RK_GOT_LO12;
}

fun reloc_traits_admitted(kind: of.RelocKind) bool {
    ret kind == of.RK_ABS64  || kind == of.RK_ABS32   || kind == of.RK_PC32
     || kind == of.RK_PLT32  || kind == of.RK_JUMP26
     || kind == of.RK_PAGE21 || kind == of.RK_GOT_PAGE21
     || kind == of.RK_ADD_LO12
     || ldst_lo12_scale(kind) >= 0;
}

pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) R.Result[rel.RelocTraits, rel.RelocError] {
    if (!reloc_traits_admitted(kind)) {
        ret R.err[rel.RelocTraits, rel.RelocError](rel.RELOC_UNSUPPORTED);
    }

    var width: u32 = 4;
    if (kind == of.RK_ABS64) { width = 8; }

    ret R.ok[rel.RelocTraits, rel.RelocError](rel.traits(width, rel.RELOC_ADDEND_SYMBOL, 0, 0));
}

pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    target: rel.RelocTarget, addend: i64, patch_va: u64,
                    image_base: u64) R.Result[bool, rel.RelocError] {
    if (kind == of.RK_ABS64) {
        ret rel.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_ABS32) {
        ret rel.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_PC32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (patch_off::u64 + 4 > sec_len::u64) {
        ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
    }
    val word: u32 = bin.read_u32_le(dst, patch_off::usize);

    if (kind == of.RK_PLT32 || kind == of.RK_JUMP26) {
        if ((kind == of.RK_PLT32 && (word & 0xFC000000) != 0x94000000)
            || (kind == of.RK_JUMP26 && (word & 0xFC000000) != 0x14000000)) {
            ret R.err[bool, rel.RelocError](rel.RELOC_INVALID_INSTRUCTION);
        }
        val displaced: R.Result[i64, rel.RelocError] =
            rel.displacement(target.vaddr, addend, patch_va);
        if (R.is_err[i64, rel.RelocError](displaced)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[i64, rel.RelocError](displaced));
        }
        val disp: i64 = R.unwrap_ok[i64, rel.RelocError](displaced);
        val lim: i64 = 134217728;
        if (disp < -lim || disp >= lim || (disp & 3) != 0) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFC000000) | imm26);
        ret R.ok[bool, rel.RelocError](true);
    }

    if (kind == of.RK_PAGE21 || kind == of.RK_GOT_PAGE21) {
        if ((word & 0x9F000000) != 0x90000000) {
            ret R.err[bool, rel.RelocError](rel.RELOC_INVALID_INSTRUCTION);
        }
        val adjusted: R.Result[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (R.is_err[u64, rel.RelocError](adjusted)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[u64, rel.RelocError](adjusted));
        }
        val tgt_page: u64 = R.unwrap_ok[u64, rel.RelocError](adjusted) & ~0xFFF::u64;
        val pc_page: u64 = patch_va & ~0xFFF::u64;
        val displaced: R.Result[i64, rel.RelocError] =
            rel.displacement(tgt_page, 0, pc_page);
        if (R.is_err[i64, rel.RelocError](displaced)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[i64, rel.RelocError](displaced));
        }
        val delta: i64 = R.unwrap_ok[i64, rel.RelocError](displaced);
        val lim: i64 = 4294967296;
        if (delta < -lim || delta >= lim) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val imm21: u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
        val immlo: u32 = imm21 & 0x3;
        val immhi: u32 = (imm21 >> 2) & 0x7FFFF;
        bin.write_u32_le(dst, patch_off::usize, (word & 0x9F00001F) | (immlo << 29) | (immhi << 5));
        ret R.ok[bool, rel.RelocError](true);
    }

    if (kind == of.RK_ADD_LO12) {
        if ((word & 0x7FC00000) != 0x11000000) {
            ret R.err[bool, rel.RelocError](rel.RELOC_INVALID_INSTRUCTION);
        }
        val adjusted: R.Result[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (R.is_err[u64, rel.RelocError](adjusted)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[u64, rel.RelocError](adjusted));
        }
        val abs_addr: u64 = R.unwrap_ok[u64, rel.RelocError](adjusted);
        val imm12: u32 = ((abs_addr & 0xFFF)::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret R.ok[bool, rel.RelocError](true);
    }

    val scale: i32 = ldst_lo12_scale(kind);
    if (scale >= 0) {
        if ((kind == of.RK_GOT_LO12 && (word & 0xFFC00000) != 0xF9400000)
            || (kind != of.RK_GOT_LO12 && ldst_instruction_scale(word) != scale)) {
            ret R.err[bool, rel.RelocError](rel.RELOC_INVALID_INSTRUCTION);
        }
        val adjusted: R.Result[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (R.is_err[u64, rel.RelocError](adjusted)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[u64, rel.RelocError](adjusted));
        }
        val abs_addr: u64 = R.unwrap_ok[u64, rel.RelocError](adjusted);
        val alignment_mask: u64 = (1::u64 << scale::u64) - 1;
        if ((abs_addr & alignment_mask) != 0) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val imm12: u32 = (((abs_addr & 0xFFF) >> (scale::u64))::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret R.ok[bool, rel.RelocError](true);
    }

    ret R.err[bool, rel.RelocError](rel.RELOC_UNSUPPORTED);
}

test "mach.lang.target.isa.arm64.reloc.catalog:admitted_kinds_are_exactly_the_applied_kinds" {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k: u32 = 0;
    for (k < of.RK_CATALOG_COUNT) {
        val kind: of.RelocKind = k::of.RelocKind;
        var i: usize = 0;
        for (i < 16) { dst[i] = 0; i = i + 1; }

        val tr: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(kind, of.SK_TEXT, true);
        val admitted: bool = R.is_ok[rel.RelocTraits, rel.RelocError](tr);
        if (!admitted) {
            if (R.unwrap_err[rel.RelocTraits, rel.RelocError](tr) != rel.RELOC_UNSUPPORTED) { bad = 1; brk; }
        }

        val ap: R.Result[bool, rel.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (R.is_err[bool, rel.RelocError](ap)) {
            applied = R.unwrap_err[bool, rel.RelocError](ap) != rel.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) { bad = 2; brk; }
        k = k + 1;
    }

    val past: of.RelocKind = 0xFF::of.RelocKind;
    val tr_past: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(past, of.SK_TEXT, true);
    if (!R.is_err[rel.RelocTraits, rel.RelocError](tr_past)) { bad = 3; }
    or { if (R.unwrap_err[rel.RelocTraits, rel.RelocError](tr_past) != rel.RELOC_UNSUPPORTED) { bad = 3; } }
    val ap_past: R.Result[bool, rel.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!R.is_err[bool, rel.RelocError](ap_past)) { bad = 4; }
    or { if (R.unwrap_err[bool, rel.RelocError](ap_past) != rel.RELOC_UNSUPPORTED) { bad = 4; } }
    ret bad;
}

test "mach.lang.target.isa.arm64.reloc.reloc_traits:plt32" {
    val tr: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_PLT32, of.SK_TEXT, false);
    if (R.is_err[rel.RelocTraits, rel.RelocError](tr)) { ret 1; }
    val t: rel.RelocTraits = R.unwrap_ok[rel.RelocTraits, rel.RelocError](tr);
    if (t.field_width != 4 || t.addend_mode != rel.RELOC_ADDEND_SYMBOL
        || t.text_bias_min != 0 || t.text_bias_max != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.reloc.reloc_traits:unsupported_kind_refused" {
    val bad: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_SECTION, of.SK_TEXT, false);
    if (!R.is_err[rel.RelocTraits, rel.RelocError](bad)) { ret 1; }
    if (R.unwrap_err[rel.RelocTraits, rel.RelocError](bad) != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}

fun ldst_lo12_scale(kind: of.RelocKind) i32 {
    if (kind == of.RK_LDST8_LO12)   { ret 0; }
    if (kind == of.RK_LDST16_LO12)  { ret 1; }
    if (kind == of.RK_LDST32_LO12)  { ret 2; }
    if (kind == of.RK_LDST64_LO12)  { ret 3; }
    if (kind == of.RK_LDST128_LO12) { ret 4; }
    if (kind == of.RK_GOT_LO12)     { ret 3; }
    ret -1;
}

fun ldst_instruction_scale(word: u32) i32 {
    if ((word & 0x3B000000) != 0x39000000) { ret -1; }
    val vector: u32 = (word >> 26) & 0x1;
    val size: u32 = (word >> 30) & 0x3;
    val opcode: u32 = (word >> 22) & 0x3;
    if (vector == 1 && size == 0 && opcode == 3) { ret 4; }
    ret size::i32;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:bitpackers" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val c1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x2000, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](c1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x94000800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x14000000);
    val j1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_JUMP26, ?dst[0], 0, 8, rel.target(0x2000, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](j1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x14000800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val p1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(0x3000, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](p1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x91000000);
    val a1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ADD_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](a1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x912AF000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST8_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l8))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x396AF000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST16_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l16))       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x79557800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST32_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l32))       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xB94ABC00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST64_LO12, ?dst[0], 0, 8, rel.target(0xAB8, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l64))       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST128_LO12, ?dst[0], 0, 8, rel.target(0xAB0, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l128))      { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x3DC2AC00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val gp: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_GOT_PAGE21, ?dst[0], 0, 8, rel.target(0x3000, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](gp))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val gl: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_GOT_LO12, ?dst[0], 0, 8, rel.target(0xAB8, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](gl))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    ret 0;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:overflow_rejection" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(134217728, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o1)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](o1) != rel.RELOC_OVERFLOW) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o2: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 134217728, 0);
    if (R.is_err[bool, rel.RelocError](o2)) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o3: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x2002, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o3)) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val o4: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(4294967296, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o4)) { ret 1; }

    val o5: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o5)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](o5) != rel.RELOC_UNSUPPORTED) { ret 1; }

    val o6: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_ADD_LO12, ?dst[0], 0, 8, rel.target(0, 0, 0), -1, 0, 0);
    val o7: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_PAGE21, ?dst[0], 0, 8,
        rel.target(0xFFFFFFFFFFFFFFFF, 0, 0), 1, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o6)
        || !R.is_err[bool, rel.RelocError](o7)) { ret 1; }

    ret 0;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:scaled_alignment" {
    var dst: [4]u8;
    var bad: i32 = 0;

    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST16_LO12, ?dst[0], 0, 4, rel.target(1, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](l16)
        || bin.read_u32_le(?dst[0], 0) != 0x79400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST32_LO12, ?dst[0], 0, 4, rel.target(2, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](l32)
        || bin.read_u32_le(?dst[0], 0) != 0xB9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST64_LO12, ?dst[0], 0, 4, rel.target(4, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](l64)
        || bin.read_u32_le(?dst[0], 0) != 0xF9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST128_LO12, ?dst[0], 0, 4, rel.target(8, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](l128)
        || bin.read_u32_le(?dst[0], 0) != 0x3DC00000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val got: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOT_LO12, ?dst[0], 0, 4, rel.target(4, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](got)
        || bin.read_u32_le(?dst[0], 0) != 0xF9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST8_LO12, ?dst[0], 0, 4, rel.target(1, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l8)) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:instruction_class" {
    var dst: [4]u8;
    bin.write_u32_le(?dst[0], 0, 0xA5A5A5A5);

    val call: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_PLT32, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val jump: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_JUMP26, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val page: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_PAGE21, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val add: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_ADD_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val load: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST32_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val got: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOT_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);

    if (!R.is_err[bool, rel.RelocError](call)
        || R.unwrap_err[bool, rel.RelocError](call) != rel.RELOC_INVALID_INSTRUCTION
        || !R.is_err[bool, rel.RelocError](jump)
        || R.unwrap_err[bool, rel.RelocError](jump) != rel.RELOC_INVALID_INSTRUCTION
        || !R.is_err[bool, rel.RelocError](page)
        || R.unwrap_err[bool, rel.RelocError](page) != rel.RELOC_INVALID_INSTRUCTION
        || !R.is_err[bool, rel.RelocError](add)
        || R.unwrap_err[bool, rel.RelocError](add) != rel.RELOC_INVALID_INSTRUCTION
        || !R.is_err[bool, rel.RelocError](load)
        || R.unwrap_err[bool, rel.RelocError](load) != rel.RELOC_INVALID_INSTRUCTION
        || !R.is_err[bool, rel.RelocError](got)
        || R.unwrap_err[bool, rel.RelocError](got) != rel.RELOC_INVALID_INSTRUCTION
        || bin.read_u32_le(?dst[0], 0) != 0xA5A5A5A5) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val wrong_scale: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST64_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    bin.write_u32_le(?dst[0], 0, 0xF9000000);
    val got_store: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOT_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](wrong_scale)
        || R.unwrap_err[bool, rel.RelocError](wrong_scale) != rel.RELOC_INVALID_INSTRUCTION
        || !R.is_err[bool, rel.RelocError](got_store)
        || R.unwrap_err[bool, rel.RelocError](got_store) != rel.RELOC_INVALID_INSTRUCTION
        || bin.read_u32_le(?dst[0], 0) != 0xF9000000) { ret 1; }
    ret 0;
}
