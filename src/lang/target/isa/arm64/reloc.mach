use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_reloc: mach.lang.target.of.reloc;

pub fun is_local_got_kind(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_GOT_PAGE21 || kind == target_of.RK_GOT_LO12;
}

# b and bl encode a signed 26-bit word displacement, +-128 MiB
pub fun branch_reach(kind: target_of.RelocKind) opt[target_of.BranchReach] {
    if (kind != target_of.RK_PLT32 && kind != target_of.RK_JUMP26) { ret opt[target_of.BranchReach].none{}; }
    ret opt[target_of.BranchReach].some{target_of.BranchReach{min: -134217728, max: 134217724, align: 4}};
}

# adrp x16 / add x16, x16, lo12 / br x16: ip0 is the register aapcs64 gives a
# veneer to clobber, and adrp reaches +-4 GiB, the whole of the code
pub fun branch_thunk() target_of.BranchThunk {
    var t: target_of.BranchThunk;
    bin.write_u32_le(?t.bytes[0], 0, 0x90000010);
    bin.write_u32_le(?t.bytes[0], 4, 0x91000210);
    bin.write_u32_le(?t.bytes[0], 8, 0xD61F0200);
    t.size             = 12;
    t.align            = 4;
    t.fields[0].offset = 0;
    t.fields[0].kind   = target_of.RK_PAGE21;
    t.fields[1].offset = 4;
    t.fields[1].kind   = target_of.RK_ADD_LO12;
    t.field_count      = 2;
    ret t;
}

fun reloc_traits_admitted(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_ABS64 || kind == target_of.RK_ABS32 || kind == target_of.RK_PC32
        || kind == target_of.RK_PC64 || kind == target_of.RK_PLT32 || kind == target_of.RK_JUMP26
        || kind == target_of.RK_PAGE21 || kind == target_of.RK_GOT_PAGE21
        || kind == target_of.RK_ADD_LO12
        || ldst_lo12_scale(kind) >= 0;
}

pub fun reloc_traits(kind: target_of.RelocKind,
    section_kind: target_of.SectionKind,
    codegen_image: bool) res[of_reloc.RelocTraits, of_reloc.RelocError] {
    if (!reloc_traits_admitted(kind)) {
        ret res[of_reloc.RelocTraits, of_reloc.RelocError].err{of_reloc.RELOC_UNSUPPORTED};
    }

    var width: u32 = 4;
    if (kind == target_of.RK_ABS64 || kind == target_of.RK_PC64) { width = 8; }

    ret res[of_reloc.RelocTraits, of_reloc.RelocError].ok{of_reloc.traits(width, of_reloc.RELOC_ADDEND_SYMBOL, 0, 0)};
}

pub fun apply_reloc(kind: target_of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
    target: of_reloc.RelocTarget, addend: i64, patch_va: u64,
    image_base: u64) res[bool, of_reloc.RelocError] {
    if (kind == target_of.RK_ABS64) {
        ret of_reloc.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == target_of.RK_ABS32) {
        ret of_reloc.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == target_of.RK_PC32) {
        ret of_reloc.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }
    if (kind == target_of.RK_PC64) {
        ret of_reloc.apply_pcrel64(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (patch_off::u64 + 4 > sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(dst, patch_off::usize);

    if (kind == target_of.RK_PLT32 || kind == target_of.RK_JUMP26) {
        if ((kind == target_of.RK_PLT32 && (word & 0xFC000000) != 0x94000000)
            || (kind == target_of.RK_JUMP26 && (word & 0xFC000000) != 0x14000000)) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_INVALID_INSTRUCTION};
        }
        val displaced: res[i64, of_reloc.RelocError] =
            of_reloc.displacement(target.vaddr, addend, patch_va);
        if (sel displaced.err) {
            ret res[bool, of_reloc.RelocError].err{displaced.err};
        }
        val disp: i64 = displaced.ok;
        val lim:  i64 = 134217728;
        if (disp < -lim || disp >= lim || (disp & 3) != 0) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFC000000) | imm26);
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    if (kind == target_of.RK_PAGE21 || kind == target_of.RK_GOT_PAGE21) {
        if ((word & 0x9F000000) != 0x90000000) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_INVALID_INSTRUCTION};
        }
        val adjusted: res[u64, of_reloc.RelocError] =
            of_reloc.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, of_reloc.RelocError].err{adjusted.err};
        }
        val tgt_page:  u64                           = adjusted.ok & ~0xFFF::u64;
        val pc_page:   u64                           = patch_va & ~0xFFF::u64;
        val displaced: res[i64, of_reloc.RelocError] =
            of_reloc.displacement(tgt_page, 0, pc_page);
        if (sel displaced.err) {
            ret res[bool, of_reloc.RelocError].err{displaced.err};
        }
        val delta: i64 = displaced.ok;
        val lim:   i64 = 4294967296;
        if (delta < -lim || delta >= lim) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        val imm21: u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
        val immlo: u32 = imm21 & 0x3;
        val immhi: u32 = (imm21 >> 2) & 0x7FFFF;
        bin.write_u32_le(dst, patch_off::usize, (word & 0x9F00001F) | (immlo << 29) | (immhi << 5));
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    if (kind == target_of.RK_ADD_LO12) {
        if ((word & 0x7FC00000) != 0x11000000) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_INVALID_INSTRUCTION};
        }
        val adjusted: res[u64, of_reloc.RelocError] =
            of_reloc.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, of_reloc.RelocError].err{adjusted.err};
        }
        val abs_addr: u64 = adjusted.ok;
        val imm12:    u32 = ((abs_addr & 0xFFF)::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    val scale: i32 = ldst_lo12_scale(kind);
    if (scale >= 0) {
        if ((kind == target_of.RK_GOT_LO12 && (word & 0xFFC00000) != 0xF9400000)
            || (kind != target_of.RK_GOT_LO12 && ldst_instruction_scale(word) != scale)) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_INVALID_INSTRUCTION};
        }
        val adjusted: res[u64, of_reloc.RelocError] =
            of_reloc.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, of_reloc.RelocError].err{adjusted.err};
        }
        val abs_addr:       u64 = adjusted.ok;
        val alignment_mask: u64 = (1::u64 << scale::u64) - 1;
        if ((abs_addr & alignment_mask) != 0) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        val imm12: u32 = (((abs_addr & 0xFFF) >> (scale::u64))::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_UNSUPPORTED};
}

test catalog__admitted_kinds_are_exactly_the_applied_kinds {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k:   u32 = 0;
    for (k < target_of.RK_CATALOG_COUNT) {
        val kind: target_of.RelocKind = k::target_of.RelocKind;
        var i:    usize               = 0;
        for (i < 16) {
            dst[i] = 0;
            i      = i + 1;
        }

        val tr:       res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(kind, target_of.SK_TEXT, true);
        val admitted: bool                                           = sel tr.ok;
        if (sel tr.err) {
            if (tr.err != of_reloc.RELOC_UNSUPPORTED) {
                bad = 1;
                brk;
            }
        }

        val ap: res[bool, of_reloc.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, of_reloc.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (sel ap.err) {
            applied = ap.err != of_reloc.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) {
            bad = 2;
            brk;
        }
        k = k + 1;
    }

    val past:    target_of.RelocKind                            = 0xFF::target_of.RelocKind;
    val tr_past: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(past, target_of.SK_TEXT, true);
    if (!sel tr_past.err) { bad = 3; }
    or (sel tr_past.err) {
        if (tr_past.err != of_reloc.RELOC_UNSUPPORTED) { bad = 3; }
    }
    val ap_past: res[bool, of_reloc.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, of_reloc.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!sel ap_past.err) { bad = 4; }
    or (sel ap_past.err) {
        if (ap_past.err != of_reloc.RELOC_UNSUPPORTED) { bad = 4; }
    }
    ret bad;
}

test reloc_traits__plt32 {
    val tr: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_PLT32, target_of.SK_TEXT, false);
    if (sel tr.err) { ret 1; }
    val t: of_reloc.RelocTraits = tr.ok;
    if (t.field_width != 4 || t.addend_mode != of_reloc.RELOC_ADDEND_SYMBOL
        || t.text_bias_min != 0 || t.text_bias_max != 0) { ret 1; }
    ret 0;
}

fun ldst_lo12_scale(kind: target_of.RelocKind) i32 {
    if (kind == target_of.RK_LDST8_LO12)   { ret 0; }
    if (kind == target_of.RK_LDST16_LO12)  { ret 1; }
    if (kind == target_of.RK_LDST32_LO12)  { ret 2; }
    if (kind == target_of.RK_LDST64_LO12)  { ret 3; }
    if (kind == target_of.RK_LDST128_LO12) { ret 4; }
    if (kind == target_of.RK_GOT_LO12)     { ret 3; }
    ret -1;
}

fun ldst_instruction_scale(word: u32) i32 {
    if ((word & 0x3B000000) != 0x39000000) { ret -1; }
    val vector: u32 = (word >> 26) & 0x1;
    val size:   u32 = (word >> 30) & 0x3;
    val opcode: u32 = (word >> 22) & 0x3;
    if (vector == 1 && size == 0 && opcode == 3) { ret 4; }
    ret size::i32;
}

test apply_reloc__bitpackers {
    var dst: [8]u8;
    dst[4] = 0;
    dst[5] = 0;
    dst[6] = 0;
    dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val c1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PLT32, ?dst[0], 0, 8, of_reloc.target(0x2000, 0, 0), 0, 0, 0);
    if (sel c1.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x94000800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x14000000);
    val j1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_JUMP26, ?dst[0], 0, 8, of_reloc.target(0x2000, 0, 0), 0, 0, 0);
    if (sel j1.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x14000800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val p1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PAGE21, ?dst[0], 0, 8, of_reloc.target(0x3000, 0, 0), 0, 0, 0);
    if (sel p1.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x91000000);
    val a1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ADD_LO12, ?dst[0], 0, 8, of_reloc.target(0xABC, 0, 0), 0, 0, 0);
    if (sel a1.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x912AF000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_LDST8_LO12, ?dst[0], 0, 8, of_reloc.target(0xABC, 0, 0), 0, 0, 0);
    if (sel l8.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x396AF000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_LDST16_LO12, ?dst[0], 0, 8, of_reloc.target(0xABC, 0, 0), 0, 0, 0);
    if (sel l16.err)                               { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x79557800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_LDST32_LO12, ?dst[0], 0, 8, of_reloc.target(0xABC, 0, 0), 0, 0, 0);
    if (sel l32.err)                               { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xB94ABC00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_LDST64_LO12, ?dst[0], 0, 8, of_reloc.target(0xAB8, 0, 0), 0, 0, 0);
    if (sel l64.err)                               { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_LDST128_LO12, ?dst[0], 0, 8, of_reloc.target(0xAB0, 0, 0), 0, 0, 0);
    if (sel l128.err)                              { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x3DC2AC00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val gp: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_GOT_PAGE21, ?dst[0], 0, 8, of_reloc.target(0x3000, 0, 0), 0, 0, 0);
    if (sel gp.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val gl: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_GOT_LO12, ?dst[0], 0, 8, of_reloc.target(0xAB8, 0, 0), 0, 0, 0);
    if (sel gl.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    ret 0;
}

test apply_reloc__overflow_rejection {
    var dst: [8]u8;
    dst[4] = 0;
    dst[5] = 0;
    dst[6] = 0;
    dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PLT32, ?dst[0], 0, 8, of_reloc.target(134217728, 0, 0), 0, 0, 0);
    if (!sel o1.err)                       { ret 1; }
    if (o1.err != of_reloc.RELOC_OVERFLOW) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o2: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PLT32, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), 0, 134217728, 0);
    if (sel o2.err) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o3: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PLT32, ?dst[0], 0, 8, of_reloc.target(0x2002, 0, 0), 0, 0, 0);
    if (!sel o3.err) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val o4: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PAGE21, ?dst[0], 0, 8, of_reloc.target(4294967296, 0, 0), 0, 0, 0);
    if (!sel o4.err) { ret 1; }

    val o5: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ABS32S, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), 0, 0, 0);
    if (!sel o5.err)                          { ret 1; }
    if (o5.err != of_reloc.RELOC_UNSUPPORTED) { ret 1; }

    val o6: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_ADD_LO12, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), -1, 0, 0);
    val o7: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_PAGE21, ?dst[0], 0, 8,
        of_reloc.target(0xFFFFFFFFFFFFFFFF, 0, 0), 1, 0, 0);
    if (!sel o6.err) { ret 1; }
    if (!sel o7.err) { ret 1; }

    ret 0;
}

test apply_reloc__scaled_alignment {
    var dst: [4]u8;
    var bad: i32 = 0;

    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST16_LO12, ?dst[0], 0, 4, of_reloc.target(1, 0, 0), 0, 0, 0);
    if (!sel l16.err || bin.read_u32_le(?dst[0], 0) != 0x79400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST32_LO12, ?dst[0], 0, 4, of_reloc.target(2, 0, 0), 0, 0, 0);
    if (!sel l32.err || bin.read_u32_le(?dst[0], 0) != 0xB9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST64_LO12, ?dst[0], 0, 4, of_reloc.target(4, 0, 0), 0, 0, 0);
    if (!sel l64.err || bin.read_u32_le(?dst[0], 0) != 0xF9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST128_LO12, ?dst[0], 0, 4, of_reloc.target(8, 0, 0), 0, 0, 0);
    if (!sel l128.err || bin.read_u32_le(?dst[0], 0) != 0x3DC00000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val got: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOT_LO12, ?dst[0], 0, 4, of_reloc.target(4, 0, 0), 0, 0, 0);
    if (!sel got.err || bin.read_u32_le(?dst[0], 0) != 0xF9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST8_LO12, ?dst[0], 0, 4, of_reloc.target(1, 0, 0), 0, 0, 0);
    if (sel l8.err) { bad = 1; }
    ret bad;
}

test apply_reloc__instruction_class {
    var dst: [4]u8;
    bin.write_u32_le(?dst[0], 0, 0xA5A5A5A5);

    val call: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_PLT32, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    val jump: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_JUMP26, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    val page: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_PAGE21, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    val add: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_ADD_LO12, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    val load: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST32_LO12, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    val got: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOT_LO12, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);

    if (!sel call.err)                                  { ret 1; }
    if (call.err != of_reloc.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel jump.err)                                  { ret 1; }
    if (jump.err != of_reloc.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel page.err)                                  { ret 1; }
    if (page.err != of_reloc.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel add.err)                                   { ret 1; }
    if (add.err != of_reloc.RELOC_INVALID_INSTRUCTION)  { ret 1; }
    if (!sel load.err)                                  { ret 1; }
    if (load.err != of_reloc.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel got.err)                                   { ret 1; }
    if (got.err != of_reloc.RELOC_INVALID_INSTRUCTION)  { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xA5A5A5A5)      { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val wrong_scale: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_LDST64_LO12, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    bin.write_u32_le(?dst[0], 0, 0xF9000000);
    val got_store: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOT_LO12, ?dst[0], 0, 4, of_reloc.target(0, 0, 0), 0, 0, 0);
    if (!sel wrong_scale.err)                                  { ret 1; }
    if (wrong_scale.err != of_reloc.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel got_store.err)                                    { ret 1; }
    if (got_store.err != of_reloc.RELOC_INVALID_INSTRUCTION)   { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9000000)             { ret 1; }
    ret 0;
}
