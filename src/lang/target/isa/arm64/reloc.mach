# the aarch64 relocation applier
#
# The packing half of the aarch64 relocatable-object seam, the counterpart of the
# `elf_reloc_type` forward map: the map names a relocation in an ELF object, this
# writes the resolved value into the merged bytes at link time. Both are declared
# by `register_arm64` on the arch's `isa.RelocSeam`, so the linker reaches aarch64
# relocation knowledge only through the vtable and holds none of its own.
#
# The shared RK_ABS64 / RK_ABS32 / RK_PC32 kinds are flat writes; every other kind
# is an A64 instruction-field relocation, a read-modify-write of the 4-byte
# little-endian instruction word at the patch site: the immediate is computed,
# range/alignment checked where the field is bounded, and inserted into the
# instruction's bitfield without disturbing the opcode bits. The LO12 access-size
# scale is carried by the reloc KIND (Option B), so the access width is never
# recovered by decoding the instruction word.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.of.bin;
use rel: mach.lang.target.of.reloc;

# describe an aarch64 relocation's patch width and raw-addend semantics
# ---
# kind:          the abstract relocation kind to describe
# section_kind:  kind of section containing the patch site
# codegen_image: true only for an in-memory image from this compiler
# ret:           its physical field width and addend mode
pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) rel.RelocTraits {
    var width: u32 = 4;
    if (kind == of.RK_ABS64)   { width = 8; }
    if (kind == of.RK_SECTION) { width = 2; }

    var mode: rel.RelocAddendMode = rel.RELOC_ADDEND_SYMBOL;
    if (kind == of.RK_SECTION) { mode = rel.RELOC_ADDEND_IGNORED; }
    ret rel.traits(width, mode, 0, 0);
}

# apply one aarch64 relocation
# ---
# kind:      the relocation kind to apply
# dst:       the merged section bytes to patch
# patch_off: byte offset of the instruction word within `dst`
# sec_len:   length of the section `dst` backs, for the bounds check
# target:    target symbol address plus its final output-section base and ordinal
# addend:    the relocation addend
# patch_va:  the patch site's own virtual address
# image_base: base virtual address of the linked image (unused on aarch64)
# ret:       ok(true) once written, or the reason it could not be
pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    target: rel.RelocTarget, addend: i64, patch_va: u64,
                    image_base: u64) R.Result[bool, rel.RelocError] {
    # the shared kinds are flat writes, not A64 instruction-field packers.
    if (kind == of.RK_ABS64) {
        ret rel.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_ABS32) {
        ret rel.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_PC32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    # every A64 relocation patches a single 32-bit instruction word.
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
    }
    val word: u32 = bin.read_u32_le(dst, patch_off::usize);

    # RK_PLT32 -> R_AARCH64_CALL26: imm26 = (S + A - P) >> 2 into bits[25:0], the
    # branch displacement in instruction units. range +-128MB, 4-aligned, and NO
    # x86 -4 addend correction (the addend is the symbol's own addend only).
    if (kind == of.RK_PLT32) {
        val disp: i64 = (target.vaddr::i64) + addend - (patch_va::i64);
        val lim: i64 = 134217728;   # 1 << 27
        if (disp < -lim || disp >= lim || (disp & 3) != 0) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFC000000) | imm26);
        ret R.ok[bool, rel.RelocError](true);
    }

    # RK_PAGE21 -> R_AARCH64_ADR_PREL_PG_HI21: ADRP page delta
    # (Page(S+A) - Page(P)) >> 12 into immlo (bits[30:29]) + immhi (bits[23:5]);
    # range +-4GB. Page(x) = x with its low 12 bits cleared.
    if (kind == of.RK_PAGE21) {
        val abs_addr: u64 = target.vaddr + (addend::u64);
        val tgt_page: i64 = (abs_addr::i64)  - ((abs_addr::i64)  & 0xFFF);
        val pc_page:  i64 = (patch_va::i64) - ((patch_va::i64) & 0xFFF);
        val delta: i64 = tgt_page - pc_page;
        val lim: i64 = 4294967296;   # 1 << 32
        if (delta < -lim || delta >= lim) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val imm21: u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
        val immlo: u32 = imm21 & 0x3;
        val immhi: u32 = (imm21 >> 2) & 0x7FFFF;
        # keep bit[31] (op), bits[28:24] (opcode), bits[4:0] (Rd); replace immlo/immhi.
        bin.write_u32_le(dst, patch_off::usize, (word & 0x9F00001F) | (immlo << 29) | (immhi << 5));
        ret R.ok[bool, rel.RelocError](true);
    }

    # RK_ADD_LO12 -> R_AARCH64_ADD_ABS_LO12_NC: (S+A) & 0xFFF into the ADD imm12
    # field (bits[21:10]). _NC: no overflow check (12 bits always fit).
    if (kind == of.RK_ADD_LO12) {
        val abs_addr: u64 = target.vaddr + (addend::u64);
        val imm12: u32 = ((abs_addr & 0xFFF)::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret R.ok[bool, rel.RelocError](true);
    }

    # RK_LDST{8,16,32,64,128}_LO12 -> R_AARCH64_LDST*_ABS_LO12_NC: ((S+A) & 0xFFF)
    # >> scale into the LDR/STR imm12 field (bits[21:10]); the scale comes from the
    # kind (Option B), never an instruction decode. _NC: assumes the global address
    # is access-width aligned (verified by the data-section layout, not here).
    val scale: i32 = ldst_lo12_scale(kind);
    if (scale >= 0) {
        val abs_addr: u64 = target.vaddr + (addend::u64);
        val imm12: u32 = (((abs_addr & 0xFFF) >> (scale::u64))::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret R.ok[bool, rel.RelocError](true);
    }

    ret R.err[bool, rel.RelocError](rel.RELOC_UNSUPPORTED);
}

# aarch64's call relocation patches one instruction and preserves an S-relative
# addend
test "mach.lang.target.isa.arm64.reloc.reloc_traits:plt32" {
    val t: rel.RelocTraits =
        reloc_traits(of.RK_PLT32, of.SK_TEXT, false);
    if (t.field_width != 4 || t.addend_mode != rel.RELOC_ADDEND_SYMBOL
        || t.text_bias_min != 0 || t.text_bias_max != 0) { ret 1; }
    ret 0;
}

# the access-width shift {0,1,2,3,4} carried by a per-width
# RK_LDST*_LO12 kind, or -1 if `kind` is not one of them
# ---
# kind: the relocation kind to classify
# ret:  the access-width shift, or -1 when `kind` is not an LDST*_LO12
fun ldst_lo12_scale(kind: of.RelocKind) i32 {
    if (kind == of.RK_LDST8_LO12)   { ret 0; }
    if (kind == of.RK_LDST16_LO12)  { ret 1; }
    if (kind == of.RK_LDST32_LO12)  { ret 2; }
    if (kind == of.RK_LDST64_LO12)  { ret 3; }
    if (kind == of.RK_LDST128_LO12) { ret 4; }
    ret -1;
}

# the aarch64 bit-packers reproduce the exact instruction words the LLVM assembler
# emits for the resolved immediates: each base instruction (zero immediate) is
# patched and compared to the llvm-mc golden for the equivalent concrete form (#1432)
test "mach.lang.target.isa.arm64.reloc.apply_reloc:bitpackers" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    # CALL26 (RK_PLT32): `bl #0` patched with disp 0x2000 -> `bl #0x2000` = 0x94000800
    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val c1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x2000, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](c1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x94000800) { ret 1; }

    # PAGE21 (RK_PAGE21): `adrp x0` patched with page delta 0x3000 -> 0xF0000000
    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val p1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(0x3000, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](p1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    # ADD_LO12 (RK_ADD_LO12): `add x0,x0` patched with lo12 0xABC -> 0x912AF000
    bin.write_u32_le(?dst[0], 0, 0x91000000);
    val a1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ADD_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](a1))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x912AF000) { ret 1; }

    # LDST8_LO12 (scale 0): `ldrb w0,[x0]` + lo12 0xABC -> 0x396AF000
    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST8_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l8))        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x396AF000) { ret 1; }

    # LDST16_LO12 (scale 1): `ldrh w0,[x0]` + lo12 0xABC -> 0x79557800
    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST16_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l16))       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x79557800) { ret 1; }

    # LDST32_LO12 (scale 2): `ldr w0,[x0]` + lo12 0xABC -> 0xB94ABC00
    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST32_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l32))       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xB94ABC00) { ret 1; }

    # LDST64_LO12 (scale 3): `ldr x0,[x0]` + lo12 0xAB8 -> 0xF9455C00
    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST64_LO12, ?dst[0], 0, 8, rel.target(0xAB8, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l64))       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    # LDST128_LO12 (scale 4): `ldr q0,[x0]` + lo12 0xAB0 -> 0x3DC2AC00
    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_LDST128_LO12, ?dst[0], 0, 8, rel.target(0xAB0, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](l128))      { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x3DC2AC00) { ret 1; }

    ret 0;
}

# the bounded A64 fields (CALL26 +-128MB 4-aligned, PAGE21 +-4GB) reject
# out-of-range / misaligned displacements; the _NC LO12 kinds never overflow (#1432)
test "mach.lang.target.isa.arm64.reloc.apply_reloc:overflow_rejection" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    # CALL26: disp = +2^27 is one past the +-128MB branch range -> reject
    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(134217728, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o1)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](o1) != rel.RELOC_OVERFLOW) { ret 1; }

    # CALL26: disp = -2^27 is the valid negative boundary -> succeed
    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o2: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 134217728, 0);
    if (R.is_err[bool, rel.RelocError](o2)) { ret 1; }

    # CALL26: a non-4-aligned displacement is not a valid branch target -> reject
    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o3: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x2002, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o3)) { ret 1; }

    # PAGE21: page delta = +2^32 is one past the +-4GB ADRP range -> reject
    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val o4: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(4294967296, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o4)) { ret 1; }

    # a kind aarch64 has no packing for is reported as unsupported
    val o5: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](o5)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](o5) != rel.RELOC_UNSUPPORTED) { ret 1; }

    ret 0;
}
