use std.types.canonical.res;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.of.bin;
use rel: mach.lang.target.of.reloc;

pub fun is_local_got_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_GOT_PAGE21 || kind == of.RK_GOT_LO12;
}

fun reloc_traits_admitted(kind: of.RelocKind) bool {
    ret kind == of.RK_ABS64  || kind == of.RK_ABS32   || kind == of.RK_PC32
     || kind == of.RK_PLT32  || kind == of.RK_JUMP26
     || kind == of.RK_PAGE21 || kind == of.RK_GOT_PAGE21
     || kind == of.RK_ADD_LO12
     || ldst_lo12_scale(kind) >= 0;
}

pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) res[rel.RelocTraits, rel.RelocError] {
    if (!reloc_traits_admitted(kind)) {
        ret res[rel.RelocTraits, rel.RelocError].err{rel.RELOC_UNSUPPORTED};
    }

    var width: u32 = 4;
    if (kind == of.RK_ABS64) { width = 8; }

    ret res[rel.RelocTraits, rel.RelocError].ok{rel.traits(width, rel.RELOC_ADDEND_SYMBOL, 0, 0)};
}

# translation shim (#3226): the vtable slot reads the legacy carrier until C5 retypes the contract
pub fun reloc_traits_legacy(kind: of.RelocKind, section_kind: of.SectionKind, codegen_image: bool) R.Result[rel.RelocTraits, rel.RelocError] {
    ret fail.lower_of[rel.RelocTraits, rel.RelocError](reloc_traits(kind, section_kind, codegen_image));
}

pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    target: rel.RelocTarget, addend: i64, patch_va: u64,
                    image_base: u64) res[bool, rel.RelocError] {
    if (kind == of.RK_ABS64) {
        ret rel.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_ABS32) {
        ret rel.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }
    if (kind == of.RK_PC32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (patch_off::u64 + 4 > sec_len::u64) {
        ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(dst, patch_off::usize);

    if (kind == of.RK_PLT32 || kind == of.RK_JUMP26) {
        if ((kind == of.RK_PLT32 && (word & 0xFC000000) != 0x94000000)
            || (kind == of.RK_JUMP26 && (word & 0xFC000000) != 0x14000000)) {
            ret res[bool, rel.RelocError].err{rel.RELOC_INVALID_INSTRUCTION};
        }
        val displaced: res[i64, rel.RelocError] =
            rel.displacement(target.vaddr, addend, patch_va);
        if (sel displaced.err) {
            ret res[bool, rel.RelocError].err{displaced.err};
        }
        val disp: i64 = displaced.ok;
        val lim: i64 = 134217728;
        if (disp < -lim || disp >= lim || (disp & 3) != 0) {
            ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
        }
        val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFC000000) | imm26);
        ret res[bool, rel.RelocError].ok{true};
    }

    if (kind == of.RK_PAGE21 || kind == of.RK_GOT_PAGE21) {
        if ((word & 0x9F000000) != 0x90000000) {
            ret res[bool, rel.RelocError].err{rel.RELOC_INVALID_INSTRUCTION};
        }
        val adjusted: res[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, rel.RelocError].err{adjusted.err};
        }
        val tgt_page: u64 = adjusted.ok & ~0xFFF::u64;
        val pc_page: u64 = patch_va & ~0xFFF::u64;
        val displaced: res[i64, rel.RelocError] =
            rel.displacement(tgt_page, 0, pc_page);
        if (sel displaced.err) {
            ret res[bool, rel.RelocError].err{displaced.err};
        }
        val delta: i64 = displaced.ok;
        val lim: i64 = 4294967296;
        if (delta < -lim || delta >= lim) {
            ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
        }
        val imm21: u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
        val immlo: u32 = imm21 & 0x3;
        val immhi: u32 = (imm21 >> 2) & 0x7FFFF;
        bin.write_u32_le(dst, patch_off::usize, (word & 0x9F00001F) | (immlo << 29) | (immhi << 5));
        ret res[bool, rel.RelocError].ok{true};
    }

    if (kind == of.RK_ADD_LO12) {
        if ((word & 0x7FC00000) != 0x11000000) {
            ret res[bool, rel.RelocError].err{rel.RELOC_INVALID_INSTRUCTION};
        }
        val adjusted: res[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, rel.RelocError].err{adjusted.err};
        }
        val abs_addr: u64 = adjusted.ok;
        val imm12: u32 = ((abs_addr & 0xFFF)::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret res[bool, rel.RelocError].ok{true};
    }

    val scale: i32 = ldst_lo12_scale(kind);
    if (scale >= 0) {
        if ((kind == of.RK_GOT_LO12 && (word & 0xFFC00000) != 0xF9400000)
            || (kind != of.RK_GOT_LO12 && ldst_instruction_scale(word) != scale)) {
            ret res[bool, rel.RelocError].err{rel.RELOC_INVALID_INSTRUCTION};
        }
        val adjusted: res[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, rel.RelocError].err{adjusted.err};
        }
        val abs_addr: u64 = adjusted.ok;
        val alignment_mask: u64 = (1::u64 << scale::u64) - 1;
        if ((abs_addr & alignment_mask) != 0) {
            ret res[bool, rel.RelocError].err{rel.RELOC_OVERFLOW};
        }
        val imm12: u32 = (((abs_addr & 0xFFF) >> (scale::u64))::u32);
        bin.write_u32_le(dst, patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
        ret res[bool, rel.RelocError].ok{true};
    }

    ret res[bool, rel.RelocError].err{rel.RELOC_UNSUPPORTED};
}

test "mach.lang.target.isa.arm64.reloc.catalog:admitted_kinds_are_exactly_the_applied_kinds" {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k: u32 = 0;
    for (k < of.RK_CATALOG_COUNT) {
        val kind: of.RelocKind = k::of.RelocKind;
        var i: usize = 0;
        for (i < 16) { dst[i] = 0; i = i + 1; }

        val tr: res[rel.RelocTraits, rel.RelocError] = reloc_traits(kind, of.SK_TEXT, true);
        val admitted: bool = sel tr.ok;
        if (sel tr.err) {
            if (tr.err != rel.RELOC_UNSUPPORTED) { bad = 1; brk; }
        }

        val ap: res[bool, rel.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (sel ap.err) {
            applied = ap.err != rel.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) { bad = 2; brk; }
        k = k + 1;
    }

    val past: of.RelocKind = 0xFF::of.RelocKind;
    val tr_past: res[rel.RelocTraits, rel.RelocError] = reloc_traits(past, of.SK_TEXT, true);
    if (!sel tr_past.err) { bad = 3; }
    or (sel tr_past.err) { if (tr_past.err != rel.RELOC_UNSUPPORTED) { bad = 3; } }
    val ap_past: res[bool, rel.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!sel ap_past.err) { bad = 4; }
    or (sel ap_past.err) { if (ap_past.err != rel.RELOC_UNSUPPORTED) { bad = 4; } }
    ret bad;
}

test "mach.lang.target.isa.arm64.reloc.reloc_traits:plt32" {
    val tr: res[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_PLT32, of.SK_TEXT, false);
    if (sel tr.err) { ret 1; }
    val t: rel.RelocTraits = tr.ok;
    if (t.field_width != 4 || t.addend_mode != rel.RELOC_ADDEND_SYMBOL
        || t.text_bias_min != 0 || t.text_bias_max != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arm64.reloc.reloc_traits:unsupported_kind_refused" {
    val bad: res[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_SECTION, of.SK_TEXT, false);
    if (!sel bad.err) { ret 1; }
    if (bad.err != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}

fun ldst_lo12_scale(kind: of.RelocKind) i32 {
    if (kind == of.RK_LDST8_LO12)   { ret 0; }
    if (kind == of.RK_LDST16_LO12)  { ret 1; }
    if (kind == of.RK_LDST32_LO12)  { ret 2; }
    if (kind == of.RK_LDST64_LO12)  { ret 3; }
    if (kind == of.RK_LDST128_LO12) { ret 4; }
    if (kind == of.RK_GOT_LO12)     { ret 3; }
    ret -1;
}

fun ldst_instruction_scale(word: u32) i32 {
    if ((word & 0x3B000000) != 0x39000000) { ret -1; }
    val vector: u32 = (word >> 26) & 0x1;
    val size: u32 = (word >> 30) & 0x3;
    val opcode: u32 = (word >> 22) & 0x3;
    if (vector == 1 && size == 0 && opcode == 3) { ret 4; }
    ret size::i32;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:bitpackers" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val c1: res[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x2000, 0, 0), 0, 0, 0);
    if (sel c1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x94000800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x14000000);
    val j1: res[bool, rel.RelocError] = apply_reloc(of.RK_JUMP26, ?dst[0], 0, 8, rel.target(0x2000, 0, 0), 0, 0, 0);
    if (sel j1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x14000800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val p1: res[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(0x3000, 0, 0), 0, 0, 0);
    if (sel p1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x91000000);
    val a1: res[bool, rel.RelocError] = apply_reloc(of.RK_ADD_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (sel a1.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x912AF000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: res[bool, rel.RelocError] = apply_reloc(of.RK_LDST8_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (sel l8.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x396AF000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: res[bool, rel.RelocError] = apply_reloc(of.RK_LDST16_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (sel l16.err)       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x79557800) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: res[bool, rel.RelocError] = apply_reloc(of.RK_LDST32_LO12, ?dst[0], 0, 8, rel.target(0xABC, 0, 0), 0, 0, 0);
    if (sel l32.err)       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xB94ABC00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: res[bool, rel.RelocError] = apply_reloc(of.RK_LDST64_LO12, ?dst[0], 0, 8, rel.target(0xAB8, 0, 0), 0, 0, 0);
    if (sel l64.err)       { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: res[bool, rel.RelocError] = apply_reloc(of.RK_LDST128_LO12, ?dst[0], 0, 8, rel.target(0xAB0, 0, 0), 0, 0, 0);
    if (sel l128.err)      { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x3DC2AC00) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val gp: res[bool, rel.RelocError] = apply_reloc(of.RK_GOT_PAGE21, ?dst[0], 0, 8, rel.target(0x3000, 0, 0), 0, 0, 0);
    if (sel gp.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF0000000) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val gl: res[bool, rel.RelocError] = apply_reloc(of.RK_GOT_LO12, ?dst[0], 0, 8, rel.target(0xAB8, 0, 0), 0, 0, 0);
    if (sel gl.err)        { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9455C00) { ret 1; }

    ret 0;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:overflow_rejection" {
    var dst: [8]u8;
    dst[4] = 0; dst[5] = 0; dst[6] = 0; dst[7] = 0;

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o1: res[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(134217728, 0, 0), 0, 0, 0);
    if (!sel o1.err) { ret 1; }
    if (o1.err != rel.RELOC_OVERFLOW) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o2: res[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 134217728, 0);
    if (sel o2.err) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x94000000);
    val o3: res[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0x2002, 0, 0), 0, 0, 0);
    if (!sel o3.err) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0x90000000);
    val o4: res[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(4294967296, 0, 0), 0, 0, 0);
    if (!sel o4.err) { ret 1; }

    val o5: res[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 0, 0);
    if (!sel o5.err) { ret 1; }
    if (o5.err != rel.RELOC_UNSUPPORTED) { ret 1; }

    val o6: res[bool, rel.RelocError] = apply_reloc(
        of.RK_ADD_LO12, ?dst[0], 0, 8, rel.target(0, 0, 0), -1, 0, 0);
    val o7: res[bool, rel.RelocError] = apply_reloc(
        of.RK_PAGE21, ?dst[0], 0, 8,
        rel.target(0xFFFFFFFFFFFFFFFF, 0, 0), 1, 0, 0);
    if (!sel o6.err) { ret 1; }
    if (!sel o7.err) { ret 1; }

    ret 0;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:scaled_alignment" {
    var dst: [4]u8;
    var bad: i32 = 0;

    bin.write_u32_le(?dst[0], 0, 0x79400000);
    val l16: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST16_LO12, ?dst[0], 0, 4, rel.target(1, 0, 0), 0, 0, 0);
    if (!sel l16.err || bin.read_u32_le(?dst[0], 0) != 0x79400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val l32: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST32_LO12, ?dst[0], 0, 4, rel.target(2, 0, 0), 0, 0, 0);
    if (!sel l32.err || bin.read_u32_le(?dst[0], 0) != 0xB9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val l64: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST64_LO12, ?dst[0], 0, 4, rel.target(4, 0, 0), 0, 0, 0);
    if (!sel l64.err || bin.read_u32_le(?dst[0], 0) != 0xF9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0x3DC00000);
    val l128: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST128_LO12, ?dst[0], 0, 4, rel.target(8, 0, 0), 0, 0, 0);
    if (!sel l128.err || bin.read_u32_le(?dst[0], 0) != 0x3DC00000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0xF9400000);
    val got: res[bool, rel.RelocError] = apply_reloc(
        of.RK_GOT_LO12, ?dst[0], 0, 4, rel.target(4, 0, 0), 0, 0, 0);
    if (!sel got.err || bin.read_u32_le(?dst[0], 0) != 0xF9400000) { bad = 1; }

    bin.write_u32_le(?dst[0], 0, 0x39400000);
    val l8: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST8_LO12, ?dst[0], 0, 4, rel.target(1, 0, 0), 0, 0, 0);
    if (sel l8.err) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.arm64.reloc.apply_reloc:instruction_class" {
    var dst: [4]u8;
    bin.write_u32_le(?dst[0], 0, 0xA5A5A5A5);

    val call: res[bool, rel.RelocError] = apply_reloc(
        of.RK_PLT32, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val jump: res[bool, rel.RelocError] = apply_reloc(
        of.RK_JUMP26, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val page: res[bool, rel.RelocError] = apply_reloc(
        of.RK_PAGE21, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val add: res[bool, rel.RelocError] = apply_reloc(
        of.RK_ADD_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val load: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST32_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    val got: res[bool, rel.RelocError] = apply_reloc(
        of.RK_GOT_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);

    if (!sel call.err) { ret 1; }
    if (call.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel jump.err) { ret 1; }
    if (jump.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel page.err) { ret 1; }
    if (page.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel add.err) { ret 1; }
    if (add.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel load.err) { ret 1; }
    if (load.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel got.err) { ret 1; }
    if (got.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xA5A5A5A5) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0xB9400000);
    val wrong_scale: res[bool, rel.RelocError] = apply_reloc(
        of.RK_LDST64_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    bin.write_u32_le(?dst[0], 0, 0xF9000000);
    val got_store: res[bool, rel.RelocError] = apply_reloc(
        of.RK_GOT_LO12, ?dst[0], 0, 4, rel.target(0, 0, 0), 0, 0, 0);
    if (!sel wrong_scale.err) { ret 1; }
    if (wrong_scale.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (!sel got_store.err) { ret 1; }
    if (got_store.err != rel.RELOC_INVALID_INSTRUCTION) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xF9000000) { ret 1; }
    ret 0;
}
