# a PSTATE field msr writes by immediate, by its op1 and op2: the one table the
# listing prints from and the inline assembly grammar reads
pub rec PstateField {
    name: str;
    op1:  u32;
    op2:  u32;
}

pub val PSTATE_FIELD_COUNT: u32 = 8;

pub val PSTATE_FIELDS: [PSTATE_FIELD_COUNT]PstateField = [PSTATE_FIELD_COUNT]PstateField{
    PstateField{name: "daifset", op1: 3, op2: 6},
    PstateField{name: "daifclr", op1: 3, op2: 7},
    PstateField{name: "spsel", op1: 0, op2: 5},
    PstateField{name: "pan", op1: 0, op2: 4},
    PstateField{name: "uao", op1: 0, op2: 3},
    PstateField{name: "ssbs", op1: 3, op2: 1},
    PstateField{name: "dit", op1: 3, op2: 2},
    PstateField{name: "tco", op1: 3, op2: 4},
};
