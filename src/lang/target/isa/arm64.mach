use std.types.bool.bool;
use std.types.bool.true;
use std.types.string.str;

use mach.lang.target.extension;

pub val HAS_FLOAT: bool = true;

# the aarch64 extension vocabulary over the AdvSIMD baseline
pub val EXT_SHA2: u64 = 0x1;
# FEAT_SB, the speculation barrier `sb` (Armv8.0 optional, Armv8.5 mandatory)
pub val EXT_SB: u64 = 0x2;
# FEAT_AES, the aese, aesd, aesmc and aesimc rounds
pub val EXT_AES: u64 = 0x4;
# FEAT_PMULL, the 64x64 carry-less pmull and pmull2. the architecture reports
# it as a higher value of the one ID_AA64ISAR0_EL1.AES field, so it brings aes
pub val EXT_PMULL: u64 = 0x8;
# FEAT_FP16, half-precision arithmetic, comparison and integer conversion on
# the h registers (Armv8.2 optional). converting between half and single or
# double precision is the base FP and needs no extension
pub val EXT_FP16: u64 = 0x10;

pub val EXTENSION_COUNT: u32 = 5;

pub val EXTENSIONS: [EXTENSION_COUNT]extension.Extension = [EXTENSION_COUNT]extension.Extension{
    extension.Extension{name: "sha2", bit: EXT_SHA2, implies: 0, target_only: nil},
    extension.Extension{name: "sb", bit: EXT_SB, implies: 0, target_only: nil},
    extension.Extension{name: "aes", bit: EXT_AES, implies: 0, target_only: nil},
    extension.Extension{name: "pmull", bit: EXT_PMULL, implies: EXT_AES, target_only: nil},
    extension.Extension{name: "fp16", bit: EXT_FP16, implies: 0, target_only: nil},
};

pub val X0:  i32 = 0;
#[testing]
pub val X1:  i32 = 1;
pub val X9:  i32 = 9;
pub val X10: i32 = 10;
pub val X11: i32 = 11;
#[testing]
pub val X29: i32 = 29;
#[testing]
pub val X30: i32 = 30;

pub val IP0: i32 = 16;
pub val IP1: i32 = 17;

pub val FP: i32 = 29;
pub val LR: i32 = 30;
pub val SP: i32 = 31;

pub val V0:  i32 = 0;
#[testing]
pub val V1:  i32 = 1;
pub val V30: i32 = 30;
pub val V31: i32 = 31;

pub val GPR_COUNT: i32 = 31;

pub val VECTOR_COUNT: i32 = 30;

pub def Opcode: u16;

pub val NOP:  Opcode = 0;
pub val RET:  Opcode = 1;
pub val ADD:  Opcode = 2;
pub val SUB:  Opcode = 3;
pub val MUL:  Opcode = 4;
pub val AND:  Opcode = 5;
pub val ORR:  Opcode = 6;
pub val EOR:  Opcode = 7;
pub val LSL:  Opcode = 8;
pub val LSR:  Opcode = 9;
pub val ASR:  Opcode = 10;
pub val NEG:  Opcode = 11;
pub val MVN:  Opcode = 12;
pub val MOV:  Opcode = 13;
pub val B:    Opcode = 14;
pub val BRK:  Opcode = 15;
pub val FMOV: Opcode = 16;
# the high half of a 64x64 product; 64-bit only
pub val UMULH: Opcode = 17;
pub val SMULH: Opcode = 18;

pub val VEC_ADD:  Opcode = 0x100;
pub val VEC_SUB:  Opcode = 0x101;
pub val VEC_MUL:  Opcode = 0x102;
pub val VEC_DIV:  Opcode = 0x103;
pub val VEC_AND:  Opcode = 0x104;
pub val VEC_ORR:  Opcode = 0x105;
pub val VEC_EOR:  Opcode = 0x106;
pub val VEC_NOT:  Opcode = 0x107;
pub val VEC_CMEQ: Opcode = 0x108;
pub val VEC_CMNE: Opcode = 0x109;
pub val VEC_CMGT: Opcode = 0x10a;
pub val VEC_CMGE: Opcode = 0x10b;
pub val VEC_CMHI: Opcode = 0x10c;
pub val VEC_CMHS: Opcode = 0x10d;
# the lane-wise shifts, by an immediate or by a uniform or per-lane count
pub val VEC_SHL:   Opcode = 0x10e;
pub val VEC_SHR_U: Opcode = 0x10f;
pub val VEC_SHR_S: Opcode = 0x110;

# a system register the inline assembly names, by its encoding fields
pub rec SysReg {
    name: str;
    op0:  u32;
    op1:  u32;
    crn:  u32;
    crm:  u32;
    op2:  u32;
}

pub val SYSREG_COUNT: u32 = 44;

pub val SYSREGS: [SYSREG_COUNT]SysReg = [SYSREG_COUNT]SysReg{
    SysReg{name: "cntvct_el0", op0: 3, op1: 3, crn: 14, crm: 0, op2: 2},
    SysReg{name: "cntpct_el0", op0: 3, op1: 3, crn: 14, crm: 0, op2: 1},
