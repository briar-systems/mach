# the inline assembly mnemonic rows: each spelling, its operand pattern, widths and the registers it clobbers
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use extension_x64: mach.lang.target.extension.x64;
use isa_asm:       mach.lang.target.isa.asm;
use mach.lang.target.isa.x64;
use x64_inst: mach.lang.target.isa.x64.inst;

pub val PATTERN_NONE: u16 = 1;

pub val PATTERN_ONE: u16 = 2;

pub val PATTERN_TWO: u16 = 3;

pub val PATTERN_PORTIO: u16 = 8;

# one 32- or 64-bit general-purpose register and nothing else
pub val PATTERN_WIDEREG: u16 = 9;

# a vector register and a 32-bit register or memory, with an 8-bit immediate
pub val PATTERN_VECG: u16 = 10;

# two general-purpose operands and a third: an immediate, or `cl` where the
# row takes a count register; imul alone also stands with two
pub val PATTERN_TRIPLE: u16 = 11;

pub val PATTERN_BRANCH: u16 = 4;

pub val PATTERN_XFER: u16 = 5;

pub val PATTERN_VEC: u16 = 6;

pub val PATTERN_VECI: u16 = 7;

# a vector register written from a vector register and a vector register or memory
pub val PATTERN_VEC3: u16 = 12;

# a string instruction: no operand, rsi, rdi and rcx implicit, and an optional
# repeat prefix (X64_PREFIXES)
pub val PATTERN_STRING: u16 = 13;

# movq between a vector register's low quadword and a 64-bit general register
pub val PATTERN_MOVQ: u16 = 14;

# a packed shift of a vector register by an 8-bit immediate, or for a row with
# a count form by a vector register or memory's low quadword
pub val PATTERN_VSHIFT: u16 = 15;

val WIDTH_MASK: u16 = 0x3000;

pub val WIDTH_NARROW: u16 = 0x1000;

pub val WIDTH_FIXED64: u16 = 0x2000;

pub val WIDTH_UNSIZED: u16 = 0x3000;

pub val FLAG_LOCK: u16 = 0x0100;

pub val FLAG_INDIRECT: u16 = 0x0200;

# a packed move, which may also store its vector register into memory
pub val FLAG_VSTORE: u16 = 0x0400;

# a string instruction's repeat prefix: f3 or f2, and whether it was spelled
# with a condition (repe, repz, repne, repnz), which only a compare takes
pub val FLAG_REP: u16 = 0x0800;

pub val FLAG_REPNE: u16 = 0x4000;

pub val FLAG_REPCND: u16 = 0x8000;

pub val SYSCALL_WRITES: u32 = 0x803;

val EDX_EAX_WRITES: u32 = 0x5;

val RAX_WRITE: u32 = 0x1;

# cpuid reads eax and ecx and writes all four of eax, ebx, ecx and edx
val CPUID_WRITES: u32 = 0xF;

val XMM0_READ: u32 = 0x1;

# the registers a string instruction reaches without naming them
val STRING_RAX: u32 = 0x01;

pub val STRING_RCX: u32 = 0x02;

val STRING_RSI: u32 = 0x40;

val STRING_RDI: u32 = 0x80;

pub val ALL_GP: u32 = 0xFFFF;

pub val ALL_FP: u32 = 0xFFFF;

pub fun pattern(flags: u16) u16 {
    ret flags & 0x00FF;
}

pub fun width_class(flags: u16) u16 {
    ret flags & WIDTH_MASK;
}

pub val MNEMONIC_COUNT: usize = 187;

pub val MNEMONICS: [MNEMONIC_COUNT]isa_asm.Mnemonic = [MNEMONIC_COUNT]isa_asm.Mnemonic{
    isa_asm.Mnemonic{name: "syscall", code: x64.SYSCALL::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: SYSCALL_WRITES, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "ret", code: x64.RET::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "hlt", code: x64.HLT::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "cli", code: x64.CLI::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "sti", code: x64.STI::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "rdtsc", code: x64.RDTSC::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: EDX_EAX_WRITES, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "rdmsr", code: x64.RDMSR::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: EDX_EAX_WRITES, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "wrmsr", code: x64.WRMSR::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "lidt", code: x64.LIDT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_ONE | WIDTH_UNSIZED, words: 0},
    isa_asm.Mnemonic{name: "in", code: x64.IN::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_PORTIO | WIDTH_UNSIZED, words: 0},
    isa_asm.Mnemonic{name: "out", code: x64.OUT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_PORTIO | WIDTH_UNSIZED, words: 0},
    isa_asm.Mnemonic{name: "mfence", code: x64.MFENCE::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "pause", code: x64.PAUSE::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "nop", code: x64.NOP::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},

    isa_asm.Mnemonic{name: "cld", code: x64.CLD::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "pushfq", code: x64.PUSHFQ::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0, implicit_mem: true},
    isa_asm.Mnemonic{name: "popfq", code: x64.POPFQ::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0, implicit_mem: true},
    isa_asm.Mnemonic{name: "swapgs", code: x64.SWAPGS::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},
    isa_asm.Mnemonic{name: "rdfsbase", code: x64.RDFSBASE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_WIDEREG, words: 0, requires: extension_x64.FSGSBASE},
    isa_asm.Mnemonic{name: "rdgsbase", code: x64.RDGSBASE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_WIDEREG, words: 0, requires: extension_x64.FSGSBASE},
    isa_asm.Mnemonic{name: "wrfsbase", code: x64.WRFSBASE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_WIDEREG, words: 0, addr_ops: isa_asm.AW_OP0, requires: extension_x64.FSGSBASE},
    isa_asm.Mnemonic{name: "wrgsbase", code: x64.WRGSBASE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_WIDEREG, words: 0, addr_ops: isa_asm.AW_OP0, requires: extension_x64.FSGSBASE},
    isa_asm.Mnemonic{name: "iretq", code: x64.IRETQ::u32, form: isa_asm.AF_NONE, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_NONE, words: 0},

    isa_asm.Mnemonic{name: "call", code: x64.CALL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_XFER | WIDTH_FIXED64, words: 0},
    isa_asm.Mnemonic{name: "jmp", code: x64.JMP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_XFER | WIDTH_FIXED64, words: 0},
    isa_asm.Mnemonic{name: "je", code: x64.JE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jz", code: x64.JE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jne", code: x64.JNE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jnz", code: x64.JNE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jc", code: x64.JB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jb", code: x64.JB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jnc", code: x64.JAE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jae", code: x64.JAE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},
    isa_asm.Mnemonic{name: "jnb", code: x64.JAE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_BRANCH, words: 0},

    isa_asm.Mnemonic{name: "setc", code: x64.SETB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "setb", code: x64.SETB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "setnc", code: x64.SETAE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "setae", code: x64.SETAE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "setnb", code: x64.SETAE::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},

    isa_asm.Mnemonic{name: "lock cmpxchg", code: x64.CMPXCHG::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: RAX_WRITE, flags: PATTERN_TWO | FLAG_LOCK, words: 0},
    isa_asm.Mnemonic{name: "lock xadd", code: x64.XADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0 | isa_asm.AW_OP1, implicit: 0, flags: PATTERN_TWO | FLAG_LOCK, words: 0},
    isa_asm.Mnemonic{name: "cmpxchg", code: x64.CMPXCHG::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: RAX_WRITE, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "xadd", code: x64.XADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0 | isa_asm.AW_OP1, implicit: 0, flags: PATTERN_TWO, words: 0},

    isa_asm.Mnemonic{name: "movzx", code: x64.MOVZX::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO | WIDTH_NARROW, words: 0},
    isa_asm.Mnemonic{name: "movsx", code: x64.MOVSX::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO | WIDTH_NARROW, words: 0},
    isa_asm.Mnemonic{name: "mov", code: x64.MOV::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "lea", code: x64.LEA::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "add", code: x64.ADD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "sub", code: x64.SUB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "and", code: x64.AND::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "or", code: x64.OR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "xor", code: x64.XOR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "shl", code: x64.SHL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "shr", code: x64.SHR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "sar", code: x64.SAR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},

    isa_asm.Mnemonic{name: "cmp", code: x64.CMP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "test", code: x64.TEST::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "xchg", code: x64.XCHG::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0 | isa_asm.AW_OP1, implicit: 0, flags: PATTERN_TWO, words: 0},

    isa_asm.Mnemonic{name: "neg", code: x64.NEG::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "not", code: x64.NOT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "inc", code: x64.INC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "dec", code: x64.DEC::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE, words: 0},
    isa_asm.Mnemonic{name: "push", code: x64.PUSH::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_NONE, implicit: 0, flags: PATTERN_ONE | WIDTH_FIXED64, words: 0, implicit_mem: true},
    isa_asm.Mnemonic{name: "pop", code: x64.POP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_ONE | WIDTH_FIXED64, words: 0, implicit_mem: true},
    isa_asm.Mnemonic{name: "bsf", code: x64.BSF::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "bsr", code: x64.BSR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0},
    isa_asm.Mnemonic{name: "popcnt", code: x64.POPCNT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0, requires: extension_x64.POPCNT},
    isa_asm.Mnemonic{name: "lzcnt", code: x64.LZCNT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0, requires: extension_x64.LZCNT},
    isa_asm.Mnemonic{name: "tzcnt", code: x64.TZCNT::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TWO, words: 0, requires: extension_x64.BMI1},
    isa_asm.Mnemonic{name: "bswap", code: x64.BSWAP::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_WIDEREG, words: 0},
    isa_asm.Mnemonic{name: "imul", code: x64.IMUL::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TRIPLE, words: 0},
    isa_asm.Mnemonic{name: "shld", code: x64.SHLD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TRIPLE, words: 0},
    isa_asm.Mnemonic{name: "shrd", code: x64.SHRD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_TRIPLE, words: 0},

    isa_asm.Mnemonic{name: "movdqa", code: x64.MOVDQA::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC | FLAG_VSTORE, words: 0},
    isa_asm.Mnemonic{name: "movdqu", code: x64.MOVDQU::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC | FLAG_VSTORE, words: 0},
    isa_asm.Mnemonic{name: "movaps", code: x64.MOVAPS::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC | FLAG_VSTORE, words: 0},
    isa_asm.Mnemonic{name: "movups", code: x64.MOVUPS::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC | FLAG_VSTORE, words: 0},
    isa_asm.Mnemonic{name: "paddb", code: x64.PADDB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "paddw", code: x64.PADDW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "paddd", code: x64.PADDD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "paddq", code: x64.PADDQ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psubb", code: x64.PSUBB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psubw", code: x64.PSUBW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psubd", code: x64.PSUBD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psubq", code: x64.PSUBQ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psubusb", code: x64.PSUBUSB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psubusw", code: x64.PSUBUSW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pmullw", code: x64.PMULLW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pmulhw", code: x64.PMULHW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pmulhuw", code: x64.PMULHUW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pmuludq", code: x64.PMULUDQ::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "psadbw", code: x64.PSADBW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pand", code: x64.PAND::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "por", code: x64.POR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pxor", code: x64.PXOR::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pcmpeqb", code: x64.PCMPEQB::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pcmpeqw", code: x64.PCMPEQW::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
    isa_asm.Mnemonic{name: "pcmpeqd", code: x64.PCMPEQD::u32, form: isa_asm.AF_OPS, writes: isa_asm.AW_OP0, implicit: 0, flags: PATTERN_VEC, words: 0},
