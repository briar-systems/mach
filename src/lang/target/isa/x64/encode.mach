test xchg_xadd_cmpxchg__mem_mem_refused {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var buf1: enc.ByteBuf = enc.buf_init(?alloc);
    var m1:   isa.Inst    = isa.inst_blank();
    m1.opcode = x64.XCHG;
    m1.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m1.src1   = isa.make_mem(x64.RCX, 0, -1, 0, 8);
    m1.size   = 8;
    if (encode_inst(?m1, ?buf1) != 0) { bad = 1; }
    enc.buf_dnit(?buf1);

    var buf2: enc.ByteBuf = enc.buf_init(?alloc);
    var m2:   isa.Inst    = isa.inst_blank();
    m2.opcode = x64.XADD;
    m2.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m2.src1   = isa.make_mem(x64.RCX, 0, -1, 0, 8);
    m2.size   = 8;
    if (encode_inst(?m2, ?buf2) != 0) { bad = 1; }
    enc.buf_dnit(?buf2);

    var buf3: enc.ByteBuf = enc.buf_init(?alloc);
    var m3:   isa.Inst    = isa.inst_blank();
    m3.opcode = x64.CMPXCHG;
    m3.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m3.src1   = isa.make_mem(x64.RCX, 0, -1, 0, 8);
    m3.size   = 8;
    if (encode_inst(?m3, ?buf3) != 0) { bad = 1; }
    enc.buf_dnit(?buf3);

    var buf4: enc.ByteBuf = enc.buf_init(?alloc);
    var m4:   isa.Inst    = isa.inst_blank();
    m4.opcode = x64.XCHG;
    m4.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m4.src1   = isa.make_reg(x64.RCX, 8);
    m4.size   = 8;
    val n4: i32 = encode_inst(?m4, ?buf4);
    if (n4 != 3)              { bad = 1; }
    or (buf4.data[1] != 0x87) { bad = 1; }
    enc.buf_dnit(?buf4);

    ret bad;
}

test emit_packed_op__source_is_a_register_or_frame_slot {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf:   enc.ByteBuf    = enc.buf_init(?alloc);
    val rr:    err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), ?buf);
    val mem:   isa.Operand    = isa.make_mem(x64.RBP, -16, -1, 0, 16);
    val rm:    err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), mem, ?buf);
    val ri:    err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), isa.make_imm(0, 16), ?buf);
    var fail_: i32            = 0;
    if (sel rr.err)                                                                                                                  { fail_ = 1; }
    or (sel rm.err)                                                                                                                  { fail_ = 2; }
    or (!sel ri.err)                                                                                                                 { fail_ = 3; }
    or (sel ri.err && !str_equals(fail.describe(ri.err), "encode: packed vector op source is not a register or aligned frame slot")) { fail_ = 4; }
    enc.buf_dnit(?buf);
    ret fail_;
}

# the sse41 packed multiply is the gas bytes for `pmulld xmm14, xmm15`:
# 66 45 0F 38 40 F7, the 0F 38 map under the 66 prefix (#3737)
test emit_packed_op__pmulld_is_the_0f38_row {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf    = enc.buf_init(?alloc);
    val r:   err[fail.Fail] = emit_packed_op(x64.PMULLD, float_scratch0(), vec_reg(float_scratch1()), ?buf);
    var bad: i32            = 0;
    if (sel r.err)           { bad = 1; }
    or (buf.len != 6)        { bad = 2; }
    or (buf.data[0] != 0x66) { bad = 3; }
    or (buf.data[1] != 0x45) { bad = 3; }
    or (buf.data[2] != 0x0F) { bad = 3; }
    or (buf.data[3] != 0x38) { bad = 3; }
    or (buf.data[4] != 0x40) { bad = 3; }
    or (buf.data[5] != 0xF7) { bad = 3; }
    enc.buf_dnit(?buf);
    ret bad;
}

# the gas bytes of one instruction of a lane-halving sequence, on the scratch
# registers xmm14 and xmm15 with the source in xmm1 (#3738)
#[testing]
fun t_widen_bytes(buf: *enc.ByteBuf, which: str) {
    if (str_equals(which, "movaps")) {
        t_put(buf, 0x44);
        t_put(buf, 0x0F);
        t_put(buf, 0x28);
        t_put(buf, 0xF1);
        ret;
    }
    if (str_equals(which, "pxor")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0xEF);
        t_put(buf, 0xFF);
        ret;
    }
    if (str_equals(which, "pcmpgtb")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x64);
        t_put(buf, 0xFE);
        ret;
    }
    if (str_equals(which, "pcmpgtw")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x65);
        t_put(buf, 0xFE);
        ret;
    }
    if (str_equals(which, "pcmpgtd")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x66);
        t_put(buf, 0xFE);
        ret;
    }
    if (str_equals(which, "punpcklbw")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x60);
        t_put(buf, 0xF7);
        ret;
    }
    if (str_equals(which, "punpcklwd")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x61);
        t_put(buf, 0xF7);
        ret;
    }
    if (str_equals(which, "punpckldq")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x62);
        t_put(buf, 0xF7);
        ret;
    }
    if (str_equals(which, "punpckhbw")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x68);
        t_put(buf, 0xF7);
        ret;
    }
    if (str_equals(which, "punpckhwd")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x69);
        t_put(buf, 0xF7);
        ret;
    }
    if (str_equals(which, "punpckhdq")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x6A);
        t_put(buf, 0xF7);
        ret;
    }
    if (str_equals(which, "psrldq")) {
        t_put(buf, 0x66);
        t_put(buf, 0x41);
        t_put(buf, 0x0F);
        t_put(buf, 0x73);
        t_put(buf, 0xDE);
        t_put(buf, 0x08);
        ret;
    }
    if (str_equals(which, "pmovsxbw")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x38);
        t_put(buf, 0x20);
        t_put(buf, 0xF6);
        ret;
    }
    if (str_equals(which, "pmovsxwd")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x38);
        t_put(buf, 0x23);
        t_put(buf, 0xF6);
        ret;
    }
    if (str_equals(which, "pmovsxdq")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x38);
        t_put(buf, 0x25);
        t_put(buf, 0xF6);
        ret;
    }
    if (str_equals(which, "pmovzxbw")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x38);
        t_put(buf, 0x30);
        t_put(buf, 0xF6);
        ret;
    }
    if (str_equals(which, "pmovzxwd")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x38);
        t_put(buf, 0x33);
        t_put(buf, 0xF6);
        ret;
    }
    if (str_equals(which, "pmovzxdq")) {
        t_put(buf, 0x66);
        t_put(buf, 0x45);
        t_put(buf, 0x0F);
        t_put(buf, 0x38);
        t_put(buf, 0x35);
        t_put(buf, 0xF6);
        ret;
    }
    panic("t_widen_bytes: unknown instruction\n");
}

#[testing]
fun t_put(buf: *enc.ByteBuf, b: u8) {
    enc.emit_byte(buf, b);
}

# the widening sequences are the gas bytes, all twelve cells on the SSE2
# baseline and under sse41: the baseline unpacks the half against zero or the
# lane's own sign mask, sse41 reaches the high half with psrldq and extends
# either half with one pmovsx/pmovzx (#3738)
test vector_widen_half__every_cell_is_the_gas_sequence {
    var alloc: A.Allocator;
    page.make(?alloc);
    var got:  enc.ByteBuf = enc.buf_init(?alloc);
    var want: enc.ByteBuf = enc.buf_init(?alloc);
    fin {
        enc.buf_dnit(?got);
        enc.buf_dnit(?want);
    }
    val src:     isa.Operand = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM1));
    var pcmpgt:  [3]str      = [3]str{"pcmpgtb", "pcmpgtw", "pcmpgtd"};
    var punpckl: [3]str      = [3]str{"punpcklbw", "punpcklwd", "punpckldq"};
    var punpckh: [3]str      = [3]str{"punpckhbw", "punpckhwd", "punpckhdq"};
    var pmovsx:  [3]str      = [3]str{"pmovsxbw", "pmovsxwd", "pmovsxdq"};
    var pmovzx:  [3]str      = [3]str{"pmovzxbw", "pmovzxwd", "pmovzxdq"};
    var cells:   u32         = 0;
    var wi:      u32         = 0;
    for (wi < 3) {
        val from:    u8  = (1::u32 << wi)::u8;
        var variant: u32 = 0;
        for (variant < 8) {
            val signed: bool = (variant & 1) != 0;
            val high:   bool = (variant & 2) != 0;
            val sse41:  bool = (variant & 4) != 0;
            got.len  = 0;
            want.len = 0;
            val r: err[fail.Fail] = emit_vec_widen_half_body(signed, high, from, sse41, src, ?got);
            if (sel r.err) { ret 1; }
            t_widen_bytes(?want, "movaps");
            if (sse41) {
                if (high)   { t_widen_bytes(?want, "psrldq"); }
                if (signed) { t_widen_bytes(?want, pmovsx[wi]); }
                or          { t_widen_bytes(?want, pmovzx[wi]); }
            }
            or {
                t_widen_bytes(?want, "pxor");
                if (signed) { t_widen_bytes(?want, pcmpgt[wi]); }
                if (high)   { t_widen_bytes(?want, punpckh[wi]); }
                or          { t_widen_bytes(?want, punpckl[wi]); }
            }
            if (!t_bytes_equal(?got, ?want)) { ret 2; }
            cells   = cells + 1;
            variant = variant + 1;
        }
        wi = wi + 1;
    }
    if (cells != 24) { ret 3; }
    ret 0;
}

# the encoder reads the selected extensions from the machine model and the
# half from the immediate; a base naming neither half is refused
test vector_widen_half__the_model_extensions_choose_the_form {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    var want: enc.ByteBuf = enc.buf_init(?alloc);
    fin {
        enc.buf_dnit(?want);
        t_model_x64.extensions = 0;
    }
    var f:   mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM2)));
    ops[1] = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM1)));
    ops[2] = mir.op_imm(2);
    var mi: mir.MirInstr = mir.instr(mir.MIR_VEC_WIDEN_U, ?ops[0], 3, 8, 4);
    mi.vec_lane = mir.vec_lane_make_convert(mir.vec_lane_make(mir.VEC_LANE_INT, 8, 2), mir.VEC_LANE_INT, 4);

    # baseline: the high dwords unpacked against zero
    t_model_x64.extensions = 0;
    st.buf.len             = 0;
    val base: err[fail.Fail] = encode_vector_widen_half(?st, ?f, ?mi);
    if (sel base.err) { ret 1; }
    t_widen_bytes(?want, "movaps");
    t_widen_bytes(?want, "pxor");
    t_widen_bytes(?want, "punpckhdq");
    emit_movaps_rr(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM2), float_scratch0(), ?want);
    if (!t_bytes_equal(?st.buf, ?want)) { ret 2; }

    # sse41 selected: the high dwords shifted down and zero-extended
    t_model_x64.extensions = x64.EXT_SSE41;
    st.buf.len             = 0;
    want.len               = 0;
    val ext: err[fail.Fail] = encode_vector_widen_half(?st, ?f, ?mi);
    if (sel ext.err) { ret 3; }
    t_widen_bytes(?want, "movaps");
    t_widen_bytes(?want, "psrldq");
    t_widen_bytes(?want, "pmovzxdq");
    emit_movaps_rr(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM2), float_scratch0(), ?want);
    if (!t_bytes_equal(?st.buf, ?want)) { ret 4; }

    # a base that is neither 0 nor the lane count is refused
    ops[2] = mir.op_imm(1);
    val bad: err[fail.Fail] = encode_vector_widen_half(?st, ?f, ?mi);
    if (!sel bad.err) { ret 5; }
    ret 0;
}

#[testing]
fun t_bytes(buf: *enc.ByteBuf, bytes: *u8, n: usize) {
    var i: usize = 0;
    for (i < n) {
        enc.emit_byte(buf, bytes[i]);
        i = i + 1;
    }
}

#[testing]
fun t_xmm(n: i32) i32 {
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, n);
}

# the baseline 32-bit lane multiply is the gas bytes of the pmuludq pair:
# `pshufd xmm15, xmm2, 0xF5; pshufd xmm14, xmm3, 0xF5; pmuludq xmm15, xmm14;
# movaps xmm14, xmm2; pmuludq xmm14, xmm3; pshufd xmm14, xmm14, 8; pshufd
# xmm15, xmm15, 8; punpckldq xmm14, xmm15; movaps xmm1, xmm14`, and under
# sse41 one pmulld; the destination is written last so it may alias either
# source (#3739)
test vector_arith__i32x4_multiply_is_the_pmuludq_pair_or_pmulld {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    var want: enc.ByteBuf = enc.buf_init(?alloc);
    fin {
        enc.buf_dnit(?want);
        t_model_x64.extensions = 0;
    }
    var f:   mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(t_xmm(x64.XMM1)));
    ops[1] = mir.op_preg(mir.preg_id(t_xmm(x64.XMM2)));
    ops[2] = mir.op_preg(mir.preg_id(t_xmm(x64.XMM3)));
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_MUL, ?ops[0], 3, 16, 16);
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);

    t_model_x64.extensions = 0;
    val base: err[fail.Fail] = encode_vector_arith(?st, ?f, ?mi);
    if (sel base.err) { ret 1; }
    val b0: [6]u8 = [6]u8{0x66, 0x44, 0x0F, 0x70, 0xFA, 0xF5};
    val b1: [6]u8 = [6]u8{0x66, 0x44, 0x0F, 0x70, 0xF3, 0xF5};
    val b2: [5]u8 = [5]u8{0x66, 0x45, 0x0F, 0xF4, 0xFE};
    val b3: [5]u8 = [5]u8{0x66, 0x44, 0x0F, 0xF4, 0xF3};
    val b4: [6]u8 = [6]u8{0x66, 0x45, 0x0F, 0x70, 0xF6, 0x08};
    val b5: [6]u8 = [6]u8{0x66, 0x45, 0x0F, 0x70, 0xFF, 0x08};
    val b6: [5]u8 = [5]u8{0x66, 0x45, 0x0F, 0x62, 0xF7};
    t_bytes(?want, ?b0[0], 6);
    t_bytes(?want, ?b1[0], 6);
    t_bytes(?want, ?b2[0], 5);
    emit_movaps_rr(t_xmm(x64.XMM14), t_xmm(x64.XMM2), ?want);
    t_bytes(?want, ?b3[0], 5);
    t_bytes(?want, ?b4[0], 6);
    t_bytes(?want, ?b5[0], 6);
    t_bytes(?want, ?b6[0], 5);
    emit_movaps_rr(t_xmm(x64.XMM1), t_xmm(x64.XMM14), ?want);
    if (!t_bytes_equal(?st.buf, ?want)) { ret 2; }

    # sse41 selected: `pmulld xmm14, xmm3` after the left load
    t_model_x64.extensions = x64.EXT_SSE41;
    st.buf.len             = 0;
    want.len               = 0;
    val ext: err[fail.Fail] = encode_vector_arith(?st, ?f, ?mi);
    if (sel ext.err) { ret 3; }
    val p0: [6]u8 = [6]u8{0x66, 0x44, 0x0F, 0x38, 0x40, 0xF3};
    emit_movaps_rr(t_xmm(x64.XMM14), t_xmm(x64.XMM2), ?want);
    t_bytes(?want, ?p0[0], 6);
    emit_movaps_rr(t_xmm(x64.XMM1), t_xmm(x64.XMM14), ?want);
    if (!t_bytes_equal(?st.buf, ?want)) { ret 4; }

    # memory operands: the shuffles and multiplies read the frame slot in
    # place (`pshufd xmm15, [rbp-0x20], 0xF5`, `pmuludq xmm14, [rbp-0x30]`)
    # and the destination slot takes the result
    t_model_x64.extensions = 0;
    st.buf.len             = 0;
    want.len               = 0;
    val rbp: mir.PRegId = mir.preg_id(x64.RBP);
    ops[0] = mir.op_mem_preg(rbp, -16);
    ops[1] = mir.op_mem_preg(rbp, -32);
    ops[2] = mir.op_mem_preg(rbp, -48);
    val mem: err[fail.Fail] = encode_vector_arith(?st, ?f, ?mi);
    if (sel mem.err) { ret 5; }
    val m0: [7]u8 = [7]u8{0x66, 0x44, 0x0F, 0x70, 0x7D, 0xE0, 0xF5};
    val m1: [7]u8 = [7]u8{0x66, 0x44, 0x0F, 0x70, 0x75, 0xD0, 0xF5};
    val m3: [6]u8 = [6]u8{0x66, 0x44, 0x0F, 0xF4, 0x75, 0xD0};
    t_bytes(?want, ?m0[0], 7);
    t_bytes(?want, ?m1[0], 7);
    t_bytes(?want, ?b2[0], 5);
    val l0: err[fail.Fail] = emit_vec_load(isa.make_mem(x64.RBP, -32, -1, 0, 16), t_xmm(x64.XMM14), ?want);
    if (sel l0.err) { ret 6; }
    t_bytes(?want, ?m3[0], 6);
    t_bytes(?want, ?b4[0], 6);
    t_bytes(?want, ?b5[0], 6);
    t_bytes(?want, ?b6[0], 5);
    val s0: err[fail.Fail] = emit_vec_store(isa.make_mem(x64.RBP, -16, -1, 0, 16), t_xmm(x64.XMM14), ?want);
    if (sel s0.err)                     { ret 6; }
    if (!t_bytes_equal(?st.buf, ?want)) { ret 7; }
    ret 0;
}

# the 64-bit lane multiply is the gas bytes of the three-pmuludq sequence:
# `movaps xmm14, xmm2; psrlq xmm14, 32; pmuludq xmm14, xmm3; movaps xmm15,
# xmm3; psrlq xmm15, 32; pmuludq xmm15, xmm2; paddq xmm14, xmm15; psllq
# xmm14, 32; movaps xmm15, xmm2; pmuludq xmm15, xmm3; paddq xmm14, xmm15;
# movaps xmm1, xmm14`, the same with or without sse41 (#3739)
test vector_arith__i64x2_multiply_is_the_three_pmuludq_sequence {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    var want: enc.ByteBuf = enc.buf_init(?alloc);
    fin {
        enc.buf_dnit(?want);
        t_model_x64.extensions = 0;
    }
    var f:   mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(t_xmm(x64.XMM1)));
    ops[1] = mir.op_preg(mir.preg_id(t_xmm(x64.XMM2)));
    ops[2] = mir.op_preg(mir.preg_id(t_xmm(x64.XMM3)));
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_MUL, ?ops[0], 3, 16, 16);
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 8, 2);

    val srl14: [6]u8 = [6]u8{0x66, 0x41, 0x0F, 0x73, 0xD6, 0x20};
    val mul14: [5]u8 = [5]u8{0x66, 0x44, 0x0F, 0xF4, 0xF3};
    val srl15: [6]u8 = [6]u8{0x66, 0x41, 0x0F, 0x73, 0xD7, 0x20};
    val mul15: [5]u8 = [5]u8{0x66, 0x44, 0x0F, 0xF4, 0xFA};
    val add:   [5]u8 = [5]u8{0x66, 0x45, 0x0F, 0xD4, 0xF7};
    val sll14: [6]u8 = [6]u8{0x66, 0x41, 0x0F, 0x73, 0xF6, 0x20};
    val low15: [5]u8 = [5]u8{0x66, 0x44, 0x0F, 0xF4, 0xFB};
    emit_movaps_rr(t_xmm(x64.XMM14), t_xmm(x64.XMM2), ?want);
    t_bytes(?want, ?srl14[0], 6);
    t_bytes(?want, ?mul14[0], 5);
    emit_movaps_rr(t_xmm(x64.XMM15), t_xmm(x64.XMM3), ?want);
    t_bytes(?want, ?srl15[0], 6);
    t_bytes(?want, ?mul15[0], 5);
    t_bytes(?want, ?add[0], 5);
    t_bytes(?want, ?sll14[0], 6);
    emit_movaps_rr(t_xmm(x64.XMM15), t_xmm(x64.XMM2), ?want);
    t_bytes(?want, ?low15[0], 5);
    t_bytes(?want, ?add[0], 5);
    emit_movaps_rr(t_xmm(x64.XMM1), t_xmm(x64.XMM14), ?want);

    t_model_x64.extensions = 0;
    val base: err[fail.Fail] = encode_vector_arith(?st, ?f, ?mi);
    if (sel base.err)                   { ret 1; }
    if (!t_bytes_equal(?st.buf, ?want)) { ret 2; }

    t_model_x64.extensions = x64.EXT_SSE41;
    st.buf.len             = 0;
    val ext: err[fail.Fail] = encode_vector_arith(?st, ?f, ?mi);
    if (sel ext.err)                    { ret 3; }
    if (!t_bytes_equal(?st.buf, ?want)) { ret 4; }
    ret 0;
}

# one uniform-count vector shift, encoded into a fresh buffer: `count` is a
# general register, or with `imm` set an immediate count
#[testing]
fun t_vshift(opcode: mir.MirOpcode, eb: u8, dst: mir.MirOperand, lhs: mir.MirOperand, count: mir.MirOperand, got: *enc.ByteBuf) bool {
    var f:   mir.MirFunction;
    var ops: [3]mir.MirOperand;
    ops[0] = dst;
    ops[1] = lhs;
    ops[2] = count;
    var mi: mir.MirInstr = mir.instr(opcode, ?ops[0], 3, 16, 16);
    mi.vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, eb, 16 / eb::u32);
    got.len     = 0;
    val r: err[fail.Fail] = encode_vector_shift(?f, ?mi, got);
    ret !sel r.err;
}

#[testing]
fun t_xreg(n: i32) mir.MirOperand {
    ret mir.op_preg(mir.preg_id(t_xmm(n)));
}

# the uniform-count shifts are the gas bytes of the SSE2 immediate and
# count-register forms (#3740): an immediate shifts in place, a register count
# is zero-extended from its lane width into xmm15 by movd or movq (through r11
# when narrower than 32 bits), a frame-slot destination forms in xmm14, and a
# constant outside the lane width is spelled 255, which saturates as the
# scalar shift does. the 8-bit lanes and the 64-bit arithmetic shift have no
# SSE2 form and are refused, as is a per-lane count
test vector_shift__uniform_count_is_the_sse2_shift {
    var alloc: A.Allocator;
    page.make(?alloc);
    var got:  enc.ByteBuf = enc.buf_init(?alloc);
    var want: enc.ByteBuf = enc.buf_init(?alloc);
    fin {
        enc.buf_dnit(?got);
        enc.buf_dnit(?want);
    }
    val xmm1: mir.MirOperand = t_xreg(x64.XMM1);
    val xmm2: mir.MirOperand = t_xreg(x64.XMM2);
    val rcx:  mir.MirOperand = mir.op_preg(mir.preg_id(x64.RCX));

    val mova:  [3]u8 = [3]u8{0x0F, 0x28, 0xCA};
    val psllw: [5]u8 = [5]u8{0x66, 0x0F, 0x71, 0xF1, 0x05};
    if (!t_vshift(mir.MIR_SEL_SHL, 2, xmm1, xmm2, mir.op_imm(5), ?got)) { ret 1; }
    want.len = 0;
    t_bytes(?want, ?mova[0], 3);
    t_bytes(?want, ?psllw[0], 5);
    if (!t_bytes_equal(?got, ?want)) { ret 2; }

    val movd:  [5]u8 = [5]u8{0x66, 0x44, 0x0F, 0x6E, 0xF9};
    val pslld: [5]u8 = [5]u8{0x66, 0x41, 0x0F, 0xF2, 0xCF};
    if (!t_vshift(mir.MIR_SEL_SHL, 4, xmm1, xmm1, rcx, ?got)) { ret 3; }
    want.len = 0;
    t_bytes(?want, ?movd[0], 5);
    t_bytes(?want, ?pslld[0], 5);
    if (!t_bytes_equal(?got, ?want)) { ret 4; }

    val zx:    [4]u8 = [4]u8{0x4C, 0x0F, 0xB7, 0xD9};
    val movdr: [5]u8 = [5]u8{0x66, 0x45, 0x0F, 0x6E, 0xFB};
    val psraw: [5]u8 = [5]u8{0x66, 0x41, 0x0F, 0xE1, 0xCF};
    if (!t_vshift(mir.MIR_SEL_SHR_S, 2, xmm1, xmm1, rcx, ?got)) { ret 5; }
    want.len = 0;
    t_bytes(?want, ?zx[0], 4);
    t_bytes(?want, ?movdr[0], 5);
    t_bytes(?want, ?psraw[0], 5);
    if (!t_bytes_equal(?got, ?want)) { ret 6; }

    val movq:  [5]u8 = [5]u8{0x66, 0x4C, 0x0F, 0x6E, 0xF9};
    val psrlq: [5]u8 = [5]u8{0x66, 0x41, 0x0F, 0xD3, 0xCF};
    if (!t_vshift(mir.MIR_SEL_SHR_U, 8, xmm1, xmm1, rcx, ?got)) { ret 7; }
    want.len = 0;
    t_bytes(?want, ?movq[0], 5);
    t_bytes(?want, ?psrlq[0], 5);
    if (!t_bytes_equal(?got, ?want)) { ret 8; }

    val load:  [4]u8 = [4]u8{0x44, 0x0F, 0x28, 0xF2};
    val psrld: [6]u8 = [6]u8{0x66, 0x41, 0x0F, 0x72, 0xD6, 0x03};
    val store: [5]u8 = [5]u8{0x44, 0x0F, 0x29, 0x75, 0xF0};
    if (!t_vshift(mir.MIR_SEL_SHR_U, 4, mir.op_mem_preg(mir.preg_id(x64.RBP), -16), xmm2, mir.op_imm(3), ?got)) { ret 9; }
    want.len = 0;
    t_bytes(?want, ?load[0], 4);
    t_bytes(?want, ?psrld[0], 6);
    t_bytes(?want, ?store[0], 5);
    if (!t_bytes_equal(?got, ?want)) { ret 10; }

    val sat: [5]u8 = [5]u8{0x66, 0x0F, 0x71, 0xF1, 0xFF};
    if (!t_vshift(mir.MIR_SEL_SHL, 2, xmm1, xmm1, mir.op_imm(40), ?got)) { ret 11; }
    want.len = 0;
    t_bytes(?want, ?sat[0], 5);
    if (!t_bytes_equal(?got, ?want)) { ret 12; }

    if (t_vshift(mir.MIR_SEL_SHR_S, 8, xmm1, xmm1, mir.op_imm(3), ?got)) { ret 13; }
    if (t_vshift(mir.MIR_SEL_SHL, 1, xmm1, xmm1, mir.op_imm(3), ?got))   { ret 14; }
    if (t_vshift(mir.MIR_SEL_SHL, 4, xmm1, xmm1, xmm2, ?got))            { ret 15; }
    ret 0;
}

test check_accounted__rejects_unrendered_bytes {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;

    var sink: enc.AsmSink = enc.sink_init(nil, nil);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    val r_6472: err[fail.Fail] = check_accounted(?st, x64.NOP);
    if (sel r_6472.err) { bad = 1; }

    enc.emit_byte(?st.buf, 0x90);
    val r_6475: err[fail.Fail] = check_accounted(?st, x64.NOP);
    if (!sel r_6475.err) { bad = 1; }

    enc.sink_claim(?st.buf, 0);
    val r_6478: err[fail.Fail] = check_accounted(?st, x64.NOP);
    if (sel r_6478.err) { bad = 1; }

    enc.emit_byte(?st.buf, 0x90);
    enc.emit_byte(?st.buf, 0x90);
    enc.sink_claim(?st.buf, 2);
    val r_6483: err[fail.Fail] = check_accounted(?st, x64.NOP);
    if (!sel r_6483.err) { bad = 1; }

    st.buf.asm = nil;
    enc.emit_byte(?st.buf, 0x90);
    val r_6487: err[fail.Fail] = check_accounted(?st, x64.NOP);
    if (sel r_6487.err) { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}

#[testing]
fun xmm_op(idx: i32) mir.MirOperand {
    ret mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, idx)));
}

test encode_float_arith__two_address_shapes {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    val buf: *enc.ByteBuf = ?st.buf;
    var f:   mir.MirFunction;
    var bad: i32          = 0;

    var mops: [3]mir.MirOperand;
    mops[0] = xmm_op(x64.XMM2);
    mops[1] = xmm_op(x64.XMM0);
    mops[2] = xmm_op(x64.XMM1);
    var mul: mir.MirInstr = mir.instr(mir.MIR_FMUL, ?mops[0], 3, 4, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?mul);
    if (buf.len != 8)        { bad = 1; }
    or (buf.data[0] != 0xF3) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0xD0) { bad = 1; }
    or (buf.data[4] != 0xF3) { bad = 1; }
    or (buf.data[5] != 0x0F) { bad = 1; }
    or (buf.data[6] != 0x59) { bad = 1; }
    or (buf.data[7] != 0xD1) { bad = 1; }

    var aops: [3]mir.MirOperand;
    aops[0] = xmm_op(x64.XMM3);
    aops[1] = xmm_op(x64.XMM3);
    aops[2] = xmm_op(x64.XMM1);
    var add: mir.MirInstr = mir.instr(mir.MIR_FADD, ?aops[0], 3, 4, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?add);
    if (buf.len != 4)        { bad = 1; }
    or (buf.data[0] != 0xF3) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x58) { bad = 1; }
    or (buf.data[3] != 0xD9) { bad = 1; }

    var sops: [3]mir.MirOperand;
    sops[0] = xmm_op(x64.XMM1);
    sops[1] = xmm_op(x64.XMM0);
    sops[2] = xmm_op(x64.XMM1);
    var sub: mir.MirInstr = mir.instr(mir.MIR_FSUB, ?sops[0], 3, 4, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?sub);
    if (buf.len != 14)        { bad = 1; }
    or (buf.data[0] != 0xF3)  { bad = 1; }
    or (buf.data[1] != 0x44)  { bad = 1; }
    or (buf.data[2] != 0x0F)  { bad = 1; }
    or (buf.data[3] != 0x10)  { bad = 1; }
    or (buf.data[4] != 0xF9)  { bad = 1; }
    or (buf.data[5] != 0xF3)  { bad = 1; }
    or (buf.data[6] != 0x0F)  { bad = 1; }
    or (buf.data[7] != 0x10)  { bad = 1; }
    or (buf.data[8] != 0xC8)  { bad = 1; }
    or (buf.data[9] != 0xF3)  { bad = 1; }
    or (buf.data[10] != 0x41) { bad = 1; }
    or (buf.data[11] != 0x0F) { bad = 1; }
    or (buf.data[12] != 0x5C) { bad = 1; }
    or (buf.data[13] != 0xCF) { bad = 1; }

    var dops: [3]mir.MirOperand;
    dops[0] = xmm_op(x64.XMM2);
    dops[1] = xmm_op(x64.XMM0);
    dops[2] = mir.op_mem_preg(mir.preg_id(x64.RBP), -8);
    var dv: mir.MirInstr = mir.instr(mir.MIR_FDIV, ?dops[0], 3, 8, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?dv);
    if (buf.len != 9)        { bad = 1; }
    or (buf.data[0] != 0xF2) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0xD0) { bad = 1; }
    or (buf.data[4] != 0xF2) { bad = 1; }
    or (buf.data[5] != 0x0F) { bad = 1; }
    or (buf.data[6] != 0x5E) { bad = 1; }
    or (buf.data[7] != 0x55) { bad = 1; }
    or (buf.data[8] != 0xF8) { bad = 1; }

    enc.buf_dnit(buf);
    ret bad;
}

test encode_float_cmp__operands_in_place {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    val buf: *enc.ByteBuf = ?st.buf;
    var f:   mir.MirFunction;
    var bad: i32          = 0;

    var gops: [3]mir.MirOperand;
    gops[0] = mir.op_preg(mir.preg_id(x64.RAX));
    gops[1] = xmm_op(x64.XMM0);
    gops[2] = xmm_op(x64.XMM1);
    var gt: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?gops[0], 3, 4, mir.FCC_GT);
    buf.len = 0;
    encode_float_cmp(?st, ?f, ?gt);
    if (buf.len != 10)       { bad = 1; }
    or (buf.data[0] != 0x0F) { bad = 1; }
    or (buf.data[1] != 0x2E) { bad = 1; }
    or (buf.data[2] != 0xC1) { bad = 1; }

    var lops: [3]mir.MirOperand;
    lops[0] = mir.op_preg(mir.preg_id(x64.RAX));
    lops[1] = xmm_op(x64.XMM0);
    lops[2] = xmm_op(x64.XMM1);
    var lt: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?lops[0], 3, 4, mir.FCC_LT);
    buf.len = 0;
    encode_float_cmp(?st, ?f, ?lt);
    if (buf.len != 10)       { bad = 1; }
    or (buf.data[0] != 0x0F) { bad = 1; }
    or (buf.data[1] != 0x2E) { bad = 1; }
    or (buf.data[2] != 0xC8) { bad = 1; }

    enc.buf_dnit(buf);
    ret bad;
}

test encode_fp_mov__single_instruction_shapes {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var bad: i32         = 0;

    var rr: isa.Inst = isa.inst_blank();
    rr.opcode = x64.MOV;
    rr.size   = 8;
    rr.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    rr.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM5), 16);
    buf.len   = 0;
    encode_mov(?rr, ?buf);
    if (buf.len != 4)        { bad = 1; }
    or (buf.data[0] != 0xF2) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0xDD) { bad = 1; }

    var ld: isa.Inst = isa.inst_blank();
    ld.opcode = x64.MOV;
    ld.size   = 4;
    ld.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    ld.src1   = isa.make_mem(x64.RBP, -16, -1, 0, 4);
    buf.len   = 0;
    encode_mov(?ld, ?buf);
    if (buf.len != 5)        { bad = 1; }
    or (buf.data[0] != 0xF3) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0x5D) { bad = 1; }
    or (buf.data[4] != 0xF0) { bad = 1; }

    var st: isa.Inst = isa.inst_blank();
    st.opcode = x64.MOV;
    st.size   = 4;
    st.dst    = isa.make_mem(x64.RBP, -16, -1, 0, 4);
    st.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    buf.len   = 0;
    encode_mov(?st, ?buf);
    if (buf.len != 5)        { bad = 1; }
    or (buf.data[0] != 0xF3) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x11) { bad = 1; }
    or (buf.data[3] != 0x5D) { bad = 1; }
    or (buf.data[4] != 0xF0) { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

#[testing]
fun t_refused(r: err[fail.Fail], buf: *enc.ByteBuf) bool {
    if (!sel r.err) { ret false; }
    ret buf.len == 0;
}

#[testing]
fun t_accepted(r: err[fail.Fail], buf: *enc.ByteBuf) bool {
    if (sel r.err) { ret false; }
    ret buf.len > 0;
}

#[testing]
fun t_refused_n(r: res[i32, fail.Fail], buf: *enc.ByteBuf) bool {
    if (!sel r.err) { ret false; }
    ret buf.len == 0;
}

#[testing]
fun t_accepted_n(r: res[i32, fail.Fail], buf: *enc.ByteBuf) bool {
    if (sel r.err)    { ret false; }
    if (buf.len == 0) { ret false; }
    ret r.ok::usize == buf.len;
}

test encode_float_neg__sign_mask_is_pooled {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var st:  enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?itn;
    val buf: *enc.ByteBuf = ?st.buf;
    var f:   mir.MirFunction;
    var bad: i32          = 0;

    var ops: [2]mir.MirOperand;
    ops[0] = xmm_op(x64.XMM0);
    ops[1] = xmm_op(x64.XMM1);
    var ng: mir.MirInstr = mir.instr(mir.MIR_FNEG, ?ops[0], 2, 8, 0);
    buf.len = 0;
    val r_6694: err[fail.Fail] = encode_float_neg(?st, ?f, ?ng);
    if (sel r_6694.err) { bad = 1; }
    if (buf.len != 11)  { bad = 1; }
    or {
        if (buf.data[4] != 0x0F || buf.data[5] != 0x57 || buf.data[6] != 0x05) { bad = 1; }
    }
    if (st.reloc_count != 1) { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PC32)      { bad = 1; }
        if (st.relocs[0].offset != 7)             { bad = 1; }
        if (st.relocs[0].sym != st.consts[0].sym) { bad = 1; }
    }

    if (st.const_count != 1) { bad = 1; }
    or {
        if (st.consts[0].len != 16 || st.consts[0].align != 16) { bad = 1; }
        if (st.consts[0].kind != enc.CONST_VEC)                 { bad = 1; }
        or {
            var i: u32 = 0;
            for (i < 7) {
                if (st.consts[0].bytes[i] != 0) { bad = 1; }
                i = i + 1;
            }
            if (st.consts[0].bytes[7] != 0x80) { bad = 1; }
            i = 8;
            for (i < 16) {
                if (st.consts[0].bytes[i] != 0) { bad = 1; }
                i = i + 1;
            }
        }
    }

    buf.len = 0;
    val r_6720: err[fail.Fail] = encode_float_neg(?st, ?f, ?ng);
    if (sel r_6720.err)      { bad = 1; }
    if (st.const_count != 1) { bad = 1; }

    ng.width = 4;
    buf.len  = 0;
    val r_6725: err[fail.Fail] = encode_float_neg(?st, ?f, ?ng);
    if (sel r_6725.err)      { bad = 1; }
    if (st.const_count != 2) { bad = 1; }
    or {
        if (st.consts[1].len != 16 || st.consts[1].align != 16) { bad = 1; }
        if (st.consts[1].bytes[3] != 0x80)                      { bad = 1; }
        if (st.consts[1].bytes[7] != 0)                         { bad = 1; }
    }

    ret bad;
}

test float_access__width_refusals_emit_nothing {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    val buf: *enc.ByteBuf = ?st.buf;
    var bad: i32          = 0;

    val slot: isa.Operand = isa.make_mem(x64.RBX, 16, -1, 0, 8);
    val xmm0: i32         = isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM0);

    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 16, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 32, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 1, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 0, buf), buf)) { bad = 1; }

    buf.len = 0;
    if (!t_accepted(emit_float_reg_or_slot_load(slot, xmm0, 4, buf), buf)) { bad = 1; }
    if (buf.len != 5)                                                      { bad = 1; }
    or {
        if (buf.data[0] != 0xF3 || buf.data[1] != 0x0F || buf.data[2] != 0x10) { bad = 1; }
        if (buf.data[3] != 0x43 || buf.data[4] != 0x10)                        { bad = 1; }
    }
    buf.len = 0;
    if (!t_accepted(emit_float_reg_or_slot_load(slot, xmm0, 8, buf), buf)) { bad = 1; }
    if (buf.len != 5)                                                      { bad = 1; }
    or {
        if (buf.data[0] != 0xF2 || buf.data[1] != 0x0F || buf.data[2] != 0x10) { bad = 1; }
        if (buf.data[3] != 0x43 || buf.data[4] != 0x10)                        { bad = 1; }
    }

    buf.len = 0;
    if (!t_refused(emit_float_store(slot, xmm0, 16, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_store(slot, xmm0, 3, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_accepted(emit_float_store(slot, xmm0, 4, buf), buf)) { bad = 1; }
    if (buf.len != 5)                                           { bad = 1; }
    or {
        if (buf.data[0] != 0xF3 || buf.data[1] != 0x0F || buf.data[2] != 0x11) { bad = 1; }
        if (buf.data[3] != 0x43 || buf.data[4] != 0x10)                        { bad = 1; }
    }
    buf.len = 0;
    if (!t_accepted(emit_float_store(slot, xmm0, 8, buf), buf)) { bad = 1; }

    buf.len = 0;
    if (!t_refused(emit_float_load(?st, slot, xmm0, 16), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_accepted(emit_float_load(?st, slot, xmm0, 8), buf)) { bad = 1; }

    buf.len = 0;
    val c16: res[isa.Operand, fail.Fail] = float_const_operand(?st, 0, xmm0, 16);
    if (!sel c16.err || buf.len != 0) { bad = 1; }
    buf.len = 0;
    val c0: res[isa.Operand, fail.Fail] = float_const_operand(?st, 0, xmm0, 3);
    if (!sel c0.err || buf.len != 0) { bad = 1; }
    buf.len = 0;
    val c4: res[isa.Operand, fail.Fail] = float_const_operand(?st, 0, xmm0, 4);
    if (sel c4.err || buf.len == 0) { bad = 1; }

    ret bad;
}

test float_encode__width_refusals_emit_nothing {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var st:  enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?itn;
    val buf: *enc.ByteBuf = ?st.buf;
    var f:   mir.MirFunction;
    var bad: i32          = 0;

    var mv: isa.Inst = isa.inst_blank();
    mv.opcode = x64.MOV;
    mv.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    mv.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM5), 16);
    mv.size   = 12;
    buf.len   = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 32;
    buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 0;
    buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 1;
    buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }

    mv.size = 4;
    buf.len = 0;
    if (!t_accepted_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 8;
    buf.len = 0;
    if (!t_accepted_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 16;
    buf.len = 0;
    if (!t_accepted_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }

    var cops: [2]mir.MirOperand;
    cops[0] = mir.op_preg(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3)));
    cops[1] = mir.op_imm(0);
    var cn: mir.MirInstr = mir.instr(x64.MOV::u32, ?cops[0], 2, 16, 0);
    buf.len = 0;
    if (!t_refused(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 32;
    buf.len  = 0;
    if (!t_refused(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 0;
    buf.len  = 0;
    if (!t_refused(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 4;
    buf.len  = 0;
    if (!t_accepted(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 8;
    buf.len  = 0;
    if (!t_accepted(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }

    var aops: [3]mir.MirOperand;
    aops[0] = xmm_op(x64.XMM2);
    aops[1] = xmm_op(x64.XMM0);
    aops[2] = xmm_op(x64.XMM1);
    var ar: mir.MirInstr = mir.instr(mir.MIR_FMUL, ?aops[0], 3, 16, 0);
    buf.len = 0;
    if (!t_refused(encode_float_arith(?st, ?f, ?ar), buf)) { bad = 1; }
    ar.width = 4;
    buf.len  = 0;
    if (!t_accepted(encode_float_arith(?st, ?f, ?ar), buf)) { bad = 1; }

    var nops: [2]mir.MirOperand;
    nops[0] = xmm_op(x64.XMM2);
    nops[1] = xmm_op(x64.XMM0);
    var ng: mir.MirInstr = mir.instr(mir.MIR_FNEG, ?nops[0], 2, 16, 0);
    buf.len = 0;
    if (!t_refused(encode_float_neg(?st, ?f, ?ng), buf)) { bad = 1; }
    ng.width = 8;
    buf.len  = 0;
    if (!t_accepted(encode_float_neg(?st, ?f, ?ng), buf)) { bad = 1; }

    var mops: [3]mir.MirOperand;
    mops[0] = mir.op_preg(mir.preg_id(x64.RAX));
    mops[1] = xmm_op(x64.XMM0);
    mops[2] = xmm_op(x64.XMM1);
    var cm: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?mops[0], 3, 16, mir.FCC_GT);
    buf.len = 0;
    if (!t_refused(encode_float_cmp(?st, ?f, ?cm), buf)) { bad = 1; }
    cm.width = 4;
    buf.len  = 0;
    if (!t_accepted(encode_float_cmp(?st, ?f, ?cm), buf)) { bad = 1; }

    var vops: [2]mir.MirOperand;
    vops[0] = xmm_op(x64.XMM2);
    vops[1] = xmm_op(x64.XMM0);
    var cv: mir.MirInstr = mir.instr(mir.MIR_FP_TRUNC, ?vops[0], 2, 16, 0);
    cv.src_width = 8;
    buf.len      = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?cv), buf)) { bad = 1; }
    cv.width     = 4;
    cv.src_width = 16;
    buf.len      = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?cv), buf)) { bad = 1; }
    cv.width     = 4;
    cv.src_width = 8;
    buf.len      = 0;
    if (!t_accepted(encode_float_conv(?st, ?f, ?cv), buf)) { bad = 1; }

    var iops: [2]mir.MirOperand;
    iops[0] = xmm_op(x64.XMM2);
    iops[1] = mir.op_preg(mir.preg_id(x64.RCX));
    var i2f: mir.MirInstr = mir.instr(mir.MIR_SI_TO_FP, ?iops[0], 2, 16, 0);
    i2f.src_width = 8;
    buf.len       = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?i2f), buf)) { bad = 1; }
    i2f.width     = 8;
    i2f.src_width = 1;
    buf.len       = 0;
    if (!t_accepted(encode_float_conv(?st, ?f, ?i2f), buf)) { bad = 1; }

    var fops: [2]mir.MirOperand;
    fops[0] = mir.op_preg(mir.preg_id(x64.RCX));
    fops[1] = xmm_op(x64.XMM0);
    var f2i: mir.MirInstr = mir.instr(mir.MIR_FP_TO_SI, ?fops[0], 2, 8, 0);
    f2i.src_width = 16;
    buf.len       = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?f2i), buf)) { bad = 1; }
    f2i.width     = 1;
    f2i.src_width = 8;
    buf.len       = 0;
    if (!t_accepted(encode_float_conv(?st, ?f, ?f2i), buf)) { bad = 1; }

    enc.buf_dnit(buf);
    ret bad;
}

# the flags and latency row of an opcode, as the inline-asm scan and the
# effect walk read it: the class column of the one description table
pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code > 0xFFFF) { ret ct.asm_unknown(); }
    ret x64.describe(code::u16).cls;
}

# the machine opcodes a notification can carry: every x64.Opcode except the
# two pseudo entries, the inline-asm block marker and the data byte, which
# reach the stream as a MIR pseudo and an ASM_NOTE_BYTES note respectively
pub fun notifiable_opcode(op: u16) bool {
    if (op::u32 >= x64.OPCODE_COUNT) { ret false; }
    ret op != x64.ASM_BLOCK && op != x64.RAW_BYTE;
}

val OP0: u32 = 0;
val OP1: u32 = 1;
val OP2: u32 = 2;

# operands in Intel order, skipping the empty positions the encoder leaves
# (a divide keeps its divisor in src1 with no dst)
fun x64_present(mi: *isa.Inst, out: *u32) u32 {
    var n: u32 = 0;
    if (mi.dst.kind != isa.OPK_NONE) {
        out[n] = 0;
        n      = n + 1;
    }
    if (mi.src1.kind != isa.OPK_NONE) {
        out[n] = 1;
        n      = n + 1;
    }
    if (mi.src2.kind != isa.OPK_NONE) {
        out[n] = 2;
        n      = n + 1;
    }
    if (mi.src3.kind != isa.OPK_NONE) {
        out[n] = 3;
        n      = n + 1;
    }
    ret n;
}

fun x64_slot(mi: *isa.Inst, pos: u32) *isa.Operand {
    if (pos == 0) { ret ?mi.dst; }
    if (pos == 1) { ret ?mi.src1; }
    if (pos == 2) { ret ?mi.src2; }
    ret ?mi.src3;
}

fun x64_grammar_reads_fp(code: u32) u32 {
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        if (X64_MNEMONICS[i].code == code) { ret X64_MNEMONICS[i].reads_fp; }
        i = i + 1;
    }
    ret 0;
}

fun x64_grammar_implicit(code: u32) u32 {
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        if (X64_MNEMONICS[i].code == code) { ret X64_MNEMONICS[i].implicit; }
        i = i + 1;
    }
    ret 0;
}

# the roles a shape gives the first two present operands the form takes; a
# third position is an immediate on every form that has one
fun x64_shape_roles(e: *ct.InstEffects, d: *x64.OpDesc, shape: x64.Shape, n: u32, pos: *u32) {
    if (n == 0 || d.arity == 0 || shape == x64.SHAPE_NONE || shape == x64.SHAPE_XFER) { ret; }
    var first:  ct.OperandRole = ct.ROLE_READ;
    var second: ct.OperandRole = ct.ROLE_READ;
    if (shape == x64.SHAPE_DEF) { first = ct.ROLE_WRITE; }
    if (shape == x64.SHAPE_RW)  { first = ct.ROLE_RW; }
    if (shape == x64.SHAPE_SWAP) {
        first  = ct.ROLE_RW;
        second = ct.ROLE_RW;
    }
    e.roles[pos[0]] = first;
    if (n >= 2 && d.arity >= 2) { e.roles[pos[1]] = second; }
}

val X64_RAX: u64 = 0x1;
val X64_RCX: u64 = 0x2;
val X64_RDX: u64 = 0x4;
val X64_RSP: u64 = 0x10;
val X64_RSI: u64 = 0x40;
val X64_RDI: u64 = 0x80;

# the effect description of one emitted x86-64 instruction: the opcode's
# row (form, shape, memory, class) projected onto the operands present, in
# intel order, plus the implicit effects the form carries. every opcode
# notifiable_opcode admits has a row; the two pseudo entries and anything
# outside the catalog describe as unknown
pub fun inst_effects(mi: *isa.Inst, e: *ct.InstEffects) {
    @e = ct.inst_effects_unknown();
    val op: u16 = mi.opcode;
    if (!notifiable_opcode(op)) { ret; }
    val d: x64.OpDesc = x64.describe(op);
    e.cls = d.cls;

    var pos: [4]u32;
    val n:   u32 = x64_present(mi, ?pos[0]);
    e.implicit_reads    = x64_grammar_implicit(op::u32)::u64;
    e.implicit_writes   = e.implicit_reads;
    e.implicit_fp_reads = x64_grammar_reads_fp(op::u32)::u64;
    e.implicit_mem      = (d.mem & x64.MEM_STACK) != 0;
    if ((d.mem & x64.MEM_STRING) != 0) { e.implicit_addr = X64_RSI | X64_RDI; }
    if ((d.mem & x64.MEM_BASE) != 0 && n >= 1) {
        val base: *isa.Operand = x64_slot(mi, pos[0]);
        if (base.kind == isa.OPK_REG) { e.implicit_addr = e.implicit_addr | (1::u64 << isa.regid_index(base.reg)::u64); }
    }

    var shape: x64.Shape = d.shape;
    # the three-operand imul writes a register the sources do not name
    if (d.form == x64.FORM_IMUL && n == 3) { shape = x64.SHAPE_DEF; }
    x64_shape_roles(e, ?d, shape, n, ?pos[0]);
    if ((d.mem & x64.MEM_ADDR) != 0 && n >= 2) { e.roles[pos[1]] = ct.ROLE_ADDR; }

    if (d.form == x64.FORM_SSE_MOV && n >= 2) {
        # a register source merges into the upper lanes; a memory source zeroes them
        if (x64_slot(mi, pos[1]).kind == isa.OPK_REG && x64_slot(mi, pos[0]).kind == isa.OPK_REG) {
            e.roles[pos[0]] = ct.ROLE_RW;
        }
    }
    if (d.form == x64.FORM_SHIFT) {
        if (n >= 2) { e.count_pos = pos[1]::i8; }
        or {
            e.implicit_reads = e.implicit_reads | X64_RCX;
            e.count_pos      = -1;
        }
    }
    # a double shift's third position is its count: cl is read, an immediate is not
    if (d.form == x64.FORM_DSHIFT && n == 3) {
        if (x64_slot(mi, pos[2]).kind == isa.OPK_REG) { e.roles[pos[2]] = ct.ROLE_READ; }
        e.count_pos = pos[2]::i8;
    }
    if ((op == x64.XOR || op == x64.SUB || op == x64.PXOR || op == x64.XORPS) && n == 2) {
        val a: *isa.Operand = x64_slot(mi, pos[0]);
        val b: *isa.Operand = x64_slot(mi, pos[1]);
        if (a.kind == isa.OPK_REG && b.kind == isa.OPK_REG && a.reg == b.reg) { e.zero_idiom = true; }
    }
    if ((d.form == x64.FORM_IMUL && n == 1) || d.form == x64.FORM_MUL1) {
        e.implicit_reads  = X64_RAX;
        e.implicit_writes = X64_RAX | X64_RDX;
    }
    if (op == x64.CMPXCHG) {
        e.implicit_reads  = X64_RAX;
        e.implicit_writes = X64_RAX;
    }
    if (d.form == x64.FORM_DIV) {
        e.implicit_reads  = X64_RAX | X64_RDX;
        e.implicit_writes = X64_RAX | X64_RDX;
    }
    if (op == x64.CDQ || op == x64.CQO || op == x64.CWD) {
        e.implicit_reads  = X64_RAX;
        e.implicit_writes = X64_RDX;
    }
    if (op == x64.CBW) {
        e.implicit_reads  = X64_RAX;
        e.implicit_writes = X64_RAX;
    }
    if (op == x64.CPUID) { e.implicit_reads = X64_RAX | X64_RCX; }
    if (d.form == x64.FORM_STRING) {
        e.implicit_reads  = X64_RSI | X64_RDI | X64_RCX;
        e.implicit_writes = X64_RSI | X64_RDI | X64_RCX;
    }
    if (d.form == x64.FORM_PUSH || d.form == x64.FORM_POP || op == x64.PUSHFQ || op == x64.POPFQ) {
        e.implicit_reads  = X64_RSP;
        e.implicit_writes = X64_RSP;
    }

    if (d.form == x64.FORM_JMP) {
        e.xfer = ct.XFER_JUMP;
        x64_transfer_target(mi, n, ?pos[0], e);
    }
    if (d.form == x64.FORM_CALL) {
        e.xfer = ct.XFER_CALL;
        x64_transfer_target(mi, n, ?pos[0], e);
    }
    if (d.form == x64.FORM_JCC) {
        e.xfer = ct.XFER_BRANCH;
        x64_transfer_target(mi, n, ?pos[0], e);
    }
    if (d.form == x64.FORM_RET)  { e.xfer = ct.XFER_RET; }
    if (d.form == x64.FORM_TRAP) { e.xfer = ct.XFER_TRAP; }
}

fun x64_transfer_target(mi: *isa.Inst, n: u32, pos: *u32, e: *ct.InstEffects) {
    if (n == 0) {
        # an inline-asm transfer to a numbered label carries no operand; the
        # emit recorded whether the label lies ahead
        e.target = ct.TARGET_LOCAL;
        if ((mi.flags & x64.FLAG_LOCAL_FWD::u16) != 0) { e.target = ct.TARGET_LOCAL_FWD; }
        ret;
    }
    val t: *isa.Operand = x64_slot(mi, pos[0]);
    if (t.kind == isa.OPK_LABEL) {
        if (isa.label_is_block(t)) {
            e.target       = ct.TARGET_BLOCK;
            e.target_block = t.imm::u32;
            ret;
        }
        e.target = ct.TARGET_LOCAL;
        if (isa.label_is_forward_local(t)) {
            e.target     = ct.TARGET_LOCAL_FWD;
            e.local_disp = t.disp;
        }
        ret;
    }
    if (t.kind == isa.OPK_SYM) {
        e.target = ct.TARGET_EXTERNAL;
        ret;
    }
    e.roles[pos[0]] = ct.ROLE_READ;
    if (t.kind == isa.OPK_MEM) { e.roles[pos[0]] = ct.ROLE_ADDR; }
    e.target = ct.TARGET_REGISTER;
}

test asm_ct_class__every_grammar_row_is_classified_and_states_flags {
    var bad: i32   = 0;
    var i:   usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val cls: ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        if (!cls.known)                             { bad = 1; }
        if (!cls.flags_stated)                      { bad = 1; }
        if (cls.defines_flags && !cls.writes_flags) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test asm_ct_class__flag_reader_set_is_exactly_fifteen {
    var readers: [15]str;
    readers[0]  = "je";
    readers[1]  = "jz";
    readers[2]  = "jne";
    readers[3]  = "jnz";
    readers[4]  = "jc";
    readers[5]  = "jb";
    readers[6]  = "jnc";
    readers[7]  = "jae";
    readers[8]  = "jnb";
    readers[9]  = "setc";
    readers[10] = "setb";
    readers[11] = "setnc";
    readers[12] = "setae";
    readers[13] = "setnb";
    readers[14] = "pushfq";

    var bad:   i32   = 0;
    var found: u32   = 0;
    var i:     usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val nm:        str         = X64_MNEMONICS[i].name;
        val cls:       ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        val is_reader: bool        = cls.cond_flags || cls.reads_flags;

        var listed: bool  = false;
        var j:      usize = 0;
        for (j < 15) {
            if (str_equals(nm, readers[j])) { listed = true; }
            j = j + 1;
        }
        if (is_reader && !listed) { bad = 1; }
        if (!is_reader && listed) { bad = 1; }
        if (listed)               { found = found + 1; }
        i = i + 1;
    }
    if (found != 15) { bad = 1; }
    ret bad;
}

#[testing]
pub val PROBED_ROW_COUNT: usize = 26;

#[testing]
pub rec ProbedRow {
    code:   u32;
    zf_def: bool;
    cf_def: bool;
    reads:  bool;
}

#[testing]
fun probed(code: u32, zf: bool, cf: bool, reads: bool) ProbedRow {
    var r: ProbedRow;
    r.code   = code;
    r.zf_def = zf;
    r.cf_def = cf;
    r.reads  = reads;
    ret r;
}

#[testing]
pub fun probed_rows(out: *ProbedRow) u32 {
    out[0]  = probed(x64.ADD::u32, true, true, false);
    out[1]  = probed(x64.SUB::u32, true, true, false);
    out[2]  = probed(x64.CMP::u32, true, true, false);
    out[3]  = probed(x64.TEST::u32, true, true, false);
    out[4]  = probed(x64.AND::u32, true, true, false);
    out[5]  = probed(x64.OR::u32, true, true, false);
    out[6]  = probed(x64.XOR::u32, true, true, false);
    out[7]  = probed(x64.NEG::u32, true, true, false);
    out[8]  = probed(x64.NEG::u32, true, true, false);
    out[9]  = probed(x64.XADD::u32, true, true, false);
    out[10] = probed(x64.CMPXCHG::u32, true, true, false);
    out[11] = probed(x64.CMPXCHG::u32, true, true, false);
    out[12] = probed(x64.INC::u32, true, false, false);
    out[13] = probed(x64.DEC::u32, true, false, false);
    out[14] = probed(x64.SHL::u32, true, true, false);
    out[15] = probed(x64.SHL::u32, false, false, false);
    out[16] = probed(x64.SHR::u32, false, false, false);
    out[17] = probed(x64.SAR::u32, false, false, false);
    out[18] = probed(x64.NOT::u32, false, false, false);
    out[19] = probed(x64.MOV::u32, false, false, false);
    out[20] = probed(x64.LEA::u32, false, false, false);
    out[21] = probed(x64.XCHG::u32, false, false, false);
    out[22] = probed(x64.SETB::u32, false, false, true);
    out[23] = probed(x64.SETAE::u32, false, false, true);
    out[24] = probed(x64.JB::u32, false, false, false);
    out[25] = probed(x64.PUSHFQ::u32, false, false, true);
    ret PROBED_ROW_COUNT::u32;
}

# every probed row agrees with its class, and every grammar row that defines
# or reads the flags is a probed row, or one of the three opaque rows
test asm_ct_class__matches_the_measured_rows {
    var rows: [PROBED_ROW_COUNT]ProbedRow;
    val n:    u32 = probed_rows(?rows[0]);

    var bad: i32 = 0;
    var k:   u32 = 0;
    for (k < n) {
        val r:   *ProbedRow  = ?rows[k];
        val cls: ct.AsmClass = asm_ct_class(r.code, 0);
        if (!(r.zf_def && r.cf_def) && cls.defines_flags) { bad = 1; }
        if ((r.zf_def || r.cf_def) && !cls.writes_flags)  { bad = 1; }
        if (r.reads && !cls.reads_flags)                  { bad = 1; }
        k = k + 1;
    }

    var covered: u32   = 0;
    var exempt:  u32   = 0;
    var i:       usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val code: u32         = X64_MNEMONICS[i].code;
        val cls:  ct.AsmClass = asm_ct_class(code, X64_MNEMONICS[i].flags);

        if (cls.defines_flags || cls.opaque_flags || cls.reads_flags) {
            if (cls.opaque_flags) {
                if (code != x64.POPFQ::u32 && code != x64.IRETQ::u32
                    && code != x64.SYSCALL::u32) { bad = 1; }
                exempt = exempt + 1;
            }
            or {
                var found: bool = false;
                var j:     u32  = 0;
                for (j < n) {
                    if (rows[j].code == code) { found = true; }
                    j = j + 1;
                }
                if (!found) { bad = 1; }
                covered = covered + 1;
            }
        }
        i = i + 1;
    }

    if (covered != 18) { bad = 1; }
    if (exempt != 3)   { bad = 1; }
    ret bad;
}

test asm_ct_class__variable_latency_surface {
    var bad: i32 = 0;

    if (asm_ct_class(x64.SHL::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SHR::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SAR::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (!ct.ct_op_gates_count_only(ct.CT_OP_VAR_SHIFT))         { bad = 1; }

    if (asm_ct_class(x64.SHLD::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SHRD::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }

    # past the shifts, the rows that vary in latency are the five packed
    # multiplies (pmulld gated on sse41), the float ops, and the one scalar
    # multiply, imul, whose forms the mul mask gates
    var mul:   u32   = 0;
    var float: u32   = 0;
    var i:     usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val row: *iasm.Mnemonic = ?X64_MNEMONICS[i];
        val cls: ct.AsmClass    = asm_ct_class(row.code, row.flags);
        val vec: bool           = x64_pattern(row.flags) == X64P_VEC || x64_pattern(row.flags) == X64P_VECI;
        if (cls.op == ct.CT_OP_INT_DIVMOD)                           { bad = 1; }
        if (cls.op == ct.CT_OP_INT_MUL && vec)                       { mul = mul + 1; }
        or (cls.op == ct.CT_OP_INT_MUL && row.code != x64.IMUL::u32) { bad = 1; }
        if (cls.op == ct.CT_OP_FLOAT && vec)                         { float = float + 1; }
        or (cls.op == ct.CT_OP_FLOAT)                                { bad = 1; }
        i = i + 1;
    }
    if (mul != 5)    { bad = 1; }
    if (float != 16) { bad = 1; }

    if (!asm_ct_class(x64.JE::u32, 0).cond_flags)  { bad = 1; }
    if (!asm_ct_class(x64.JNE::u32, 0).cond_flags) { bad = 1; }
    if (!asm_ct_class(x64.JB::u32, 0).cond_flags)  { bad = 1; }
    if (!asm_ct_class(x64.JAE::u32, 0).cond_flags) { bad = 1; }
    if (asm_ct_class(x64.JMP::u32, 0).cond_flags)  { bad = 1; }
    if (asm_ct_class(x64.JE::u32, 0).cond_reg)     { bad = 1; }

    ret bad;
}

pub fun asm_ct_scan(body: str, secrets: *ct.AsmSecret, n_secret: u32,
    mul: ct.CtMulMask, trust_shift: bool, alloc: *A.Allocator) err[fail.Fail] {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.ct_scan(?g, body, secrets, n_secret, mul, trust_shift);
}

fun asm_note_bytes(st: *enc.EncodeState, bytes: *u8, n: usize, start: usize) err[fail.Fail] {
    val r_7502: err[fail.Fail] = enc.render_bytes_directive(?st.buf, bytes, n, start);
    if (sel r_7502.err) { ret err[fail.Fail].err{r_7502.err}; }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_portio_inst(is_in: bool, acc_size: u8, port: isa.Operand) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.OUT;
    if (is_in) { mi.opcode = x64.IN; }
    mi.size = acc_size;
    mi.dst  = port;
    mi.src1 = isa.make_reg(x64.RAX, acc_size);
    if (is_in) {
        mi.dst  = isa.make_reg(x64.RAX, acc_size);
        mi.src1 = port;
    }
    ret mi;
}

#[testing]
fun t_inst_writes_nothing(mi: *isa.Inst) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    enc.emit_byte(?buf, 0x90);
    val got: i32  = encode_inst(mi, ?buf);
    val ok:  bool = got == 0 && buf.len == 1 && buf.data[0] == 0x90;
    enc.buf_dnit(?buf);
    ret ok;
}

test portio__rejected_operand_writes_nothing {
    var bad: i32 = 0;

    var hi: isa.Inst = t_portio_inst(true, 2, isa.make_imm(0x1234, 2));
    if (!t_inst_writes_nothing(?hi)) { bad = 1; }

    var lo: isa.Inst = t_portio_inst(false, 2, isa.make_imm(-1, 2));
    if (!t_inst_writes_nothing(?lo)) { bad = 1; }

    var mem: isa.Inst = t_portio_inst(true, 2, isa.make_mem(x64.RDX, 0, -1, 0, 2));
    if (!t_inst_writes_nothing(?mem)) { bad = 1; }

    var wide: isa.Inst = t_portio_inst(true, 8, isa.make_reg(x64.RDX, 2));
    if (!t_inst_writes_nothing(?wide)) { bad = 1; }

    var good: isa.Inst = t_portio_inst(true, 2, isa.make_reg(x64.RDX, 2));
    var want: [2]u8;
    want[0] = 0x66;
    want[1] = 0xED;
    if (!t_inst_bytes(?good, ?want[0], 2)) { bad = 1; }

    ret bad;
}

test portio__byte_exact {
    var bad: i32 = 0;

    var b1: [1]u8;
    b1[0] = 0xFA;
    if (!t_asm_bytes("cli", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xFB;
    if (!t_asm_bytes("sti", ?b1[0], 1)) { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x0F;
    b2[1] = 0x31;
    if (!t_asm_bytes("rdtsc", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0x32;
    if (!t_asm_bytes("rdmsr", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0x30;
    if (!t_asm_bytes("wrmsr", ?b2[0], 2)) { bad = 1; }

    b1[0] = 0xEC;
    if (!t_asm_bytes("in al, dx", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xED;
    if (!t_asm_bytes("in eax, dx", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xEE;
    if (!t_asm_bytes("out dx, al", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xEF;
    if (!t_asm_bytes("out dx, eax", ?b1[0], 1)) { bad = 1; }

    b2[0] = 0x66;
    b2[1] = 0xED;
    if (!t_asm_bytes("in ax, dx", ?b2[0], 2)) { bad = 1; }

    b2[0] = 0xE4;
    b2[1] = 0x60;
    if (!t_asm_bytes("in al, 0x60", ?b2[0], 2)) { bad = 1; }
    b2[0] = 0xE6;
    b2[1] = 0x60;
    if (!t_asm_bytes("out 0x60, al", ?b2[0], 2)) { bad = 1; }
    b2[0] = 0xE5;
    b2[1] = 0x60;
    if (!t_asm_bytes("in eax, 0x60", ?b2[0], 2)) { bad = 1; }

    var b3: [3]u8;
    b3[0] = 0x0F;
    b3[1] = 0x01;
    b3[2] = 0x18;
    if (!t_asm_bytes("lidt [rax]", ?b3[0], 3)) { bad = 1; }

    ret bad;
}

