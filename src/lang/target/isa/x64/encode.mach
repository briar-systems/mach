}

test "mach.lang.target.isa.x64.encode.encode_shift:memory_destination_byte_exact" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var buf1: enc.ByteBuf = enc.buf_init(?alloc);
    var m1: isa.Inst = isa.inst_blank();
    m1.opcode = x64.SHL;
    m1.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m1.src1   = isa.make_imm(3, 8);
    m1.size   = 8;
    val n1: i32 = encode_inst(?m1, ?buf1);
    if (n1 != 4)               { bad = 1; }
    or (buf1.data[0] != 0x48)  { bad = 1; }
    or (buf1.data[1] != 0xC1)  { bad = 1; }
    or (buf1.data[2] != 0x20)  { bad = 1; }
    or (buf1.data[3] != 0x03)  { bad = 1; }
    enc.buf_dnit(?buf1);

    var buf2: enc.ByteBuf = enc.buf_init(?alloc);
    var m2: isa.Inst = isa.inst_blank();
    m2.opcode = x64.SHL;
    m2.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m2.src1   = isa.make_imm(1, 8);
    m2.size   = 8;
    val n2: i32 = encode_inst(?m2, ?buf2);
    if (n2 != 3)               { bad = 1; }
    or (buf2.data[0] != 0x48)  { bad = 1; }
    or (buf2.data[1] != 0xD1)  { bad = 1; }
    or (buf2.data[2] != 0x20)  { bad = 1; }
    enc.buf_dnit(?buf2);

    var buf3: enc.ByteBuf = enc.buf_init(?alloc);
    var m3: isa.Inst = isa.inst_blank();
    m3.opcode = x64.SHL;
    m3.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 1);
    m3.src1   = isa.make_reg(x64.RCX, 1);
    m3.size   = 1;
    val n3: i32 = encode_inst(?m3, ?buf3);
    if (n3 != 2)               { bad = 1; }
    or (buf3.data[0] != 0xD2)  { bad = 1; }
    or (buf3.data[1] != 0x20)  { bad = 1; }
    enc.buf_dnit(?buf3);

    var buf4: enc.ByteBuf = enc.buf_init(?alloc);
    var m4: isa.Inst = isa.inst_blank();
    m4.opcode = x64.SHL;
    m4.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m4.src1   = isa.make_mem(x64.RBX, 0, -1, 0, 8);
    m4.size   = 8;
    if (encode_inst(?m4, ?buf4) != 0) { bad = 1; }
    enc.buf_dnit(?buf4);

    ret bad;
}

test "mach.lang.target.isa.x64.encode.pick_stage_scratch:avoids_operand_aliasing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var bufA: enc.ByteBuf = enc.buf_init(?alloc);
    var addA: isa.Inst = isa.inst_blank();
    addA.opcode = x64.ADD;
    addA.dst    = isa.make_reg(x64.R11, 8);
    addA.src1   = isa.make_imm(0x123456789A, 8);
    addA.size   = 8;
    encode_inst(?addA, ?bufA);

    var bufB: enc.ByteBuf = enc.buf_init(?alloc);
    var movB: isa.Inst = isa.inst_blank();
    movB.opcode = x64.MOV;
    movB.dst    = isa.make_reg(x64.R10, 8);
    movB.src1   = isa.make_imm(0x123456789A, 8);
    movB.size   = 8;
    encode_inst(?movB, ?bufB);
    var addB: isa.Inst = isa.inst_blank();
    addB.opcode = x64.ADD;
    addB.dst    = isa.make_reg(x64.R11, 8);
    addB.src1   = isa.make_reg(x64.R10, 8);
    addB.size   = 8;
    encode_inst(?addB, ?bufB);

    if (bufA.len != bufB.len) { bad = 1; }
    or {
        var k: usize = 0;
        for (k < bufA.len) {
            if (bufA.data[k] != bufB.data[k]) { bad = 1; }
            k = k + 1;
        }
    }
    enc.buf_dnit(?bufA);
    enc.buf_dnit(?bufB);

    var bufC: enc.ByteBuf = enc.buf_init(?alloc);
    var movC: isa.Inst = isa.inst_blank();
    movC.opcode = x64.MOV;
    movC.dst    = isa.make_mem(x64.R11, 0, -1, 0, 8);
    movC.src1   = isa.make_mem(x64.R10, 8, -1, 0, 8);
    movC.size   = 8;
    if (encode_inst(?movC, ?bufC) != 0) { bad = 1; }
    enc.buf_dnit(?bufC);

    ret bad;
}

test "mach.lang.target.isa.x64.encode.x64_mem:rsp_sib_index_refused" {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov rax, [rbx + rsp*2]", nil, nil, nil, nil);
    var item: iasm.Item;
    val r: R.Result[bool, str] = iasm.next(?c, ?item);
    if (!R.is_err[bool, str](r)) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.x64_mem:displacement_overflow_refused" {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov rax, [rbx + 99999999999]", nil, nil, nil, nil);
    var item: iasm.Item;
    val r: R.Result[bool, str] = iasm.next(?c, ?item);
    if (!R.is_err[bool, str](r)) { ret 1; }

    var g2: iasm.Grammar = x64_grammar();
    var c2: iasm.Cursor;
    iasm.cursor_init(?c2, ?g2, "mov rax, [rbx + 100]", nil, nil, nil, nil);
    var item2: iasm.Item;
    val r2: R.Result[bool, str] = iasm.next(?c2, ?item2);
    if (R.is_err[bool, str](r2)) { ret 2; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.imm_fits_width:signed_and_unsigned_boundaries" {
    var bad: i32 = 0;
    if (!imm_fits_width(255, 1))    { bad = 1; }
    or (imm_fits_width(256, 1))     { bad = 1; }
    or (!imm_fits_width(-128, 1))   { bad = 1; }
    or (imm_fits_width(-129, 1))    { bad = 1; }
    or (!imm_fits_width(65535, 2))  { bad = 1; }
    or (imm_fits_width(65536, 2))   { bad = 1; }
    or (!imm_fits_width(4294967295, 4)) { bad = 1; }
    or (imm_fits_width(4294967296, 4))  { bad = 1; }
    or (!imm_fits_width(-2147483648, 4)) { bad = 1; }
    or (imm_fits_width(-2147483649, 4))  { bad = 1; }
    or (!imm_fits_width(0x7FFFFFFFFFFFFFFF, 8)) { bad = 1; }
    ret bad;
}

