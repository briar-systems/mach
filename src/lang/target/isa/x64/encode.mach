test "mach.lang.target.isa.x64.encode.asm_ct_scan:a_declaration_is_not_a_verification" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "secret";

    val undeclared: R.Result[R.Void, str] = asm_ct_scan(".byte 0x90", ?names[0], 1, false, false, ?alloc);
    if (!R.is_err[R.Void, str](undeclared)) { bad = 1; }

    val declared: R.Result[R.Void, str] = asm_ct_scan(".byte 0x90 :: writes()", ?names[0], 1, false, false, ?alloc);
    if (!R.is_err[R.Void, str](declared))   { bad = 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](declared), "writes(...)")) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_clobbers:derived_from_parse" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("mov rax, rbx", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32)) { bad = 1; }
    if (fp != 0)                        { bad = 1; }

    asm_clobbers("syscall", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RAX::u32) | (1::u32 << x64.RCX::u32) | (1::u32 << x64.R11::u32))) { bad = 1; }

    asm_clobbers("mov [rcx], rax\ncmp rax, rbx\npush rbx", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    asm_clobbers("xchg rdx, rsi", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RDX::u32) | (1::u32 << x64.RSI::u32))) { bad = 1; }
    asm_clobbers("cmpxchg rbx, rdx", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RBX::u32) | (1::u32 << x64.RAX::u32))) { bad = 1; }

    asm_clobbers("mov rax, {v}", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32)) { bad = 1; }
    if (fp != 0)                        { bad = 1; }
    asm_clobbers("mov {result}, rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    asm_clobbers("lock xadd {slot}, rax", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32)) { bad = 1; }

    asm_clobbers("mov rcx, {ptr}\nmov rax, [rcx]\nmov {result}, rax", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RAX::u32) | (1::u32 << x64.RCX::u32))) { bad = 1; }

    asm_clobbers(".byte 0x90", ?gp, ?fp);
    if (gp != X64_ALL_GP || fp != X64_ALL_FP) { bad = 1; }
    asm_clobbers("frobnicate rax, rbx", ?gp, ?fp);
    if (gp != X64_ALL_GP || fp != X64_ALL_FP) { bad = 1; }
    asm_clobbers("frobnicate", ?gp, ?fp);
    if (gp != X64_ALL_GP || fp != X64_ALL_FP) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_claim:refuses_unclaimed_byte" {
    var bad: i32 = 0;
    var g: iasm.Grammar = x64_grammar();

    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov rax, rbx", nil, nil, nil, nil);
    if (R.is_err[R.Void, str](iasm.claim(?c, 0, 3)))   { bad = 1; }
    if (!R.is_err[R.Void, str](iasm.claim(?c, 9, 3)))  { bad = 1; }

    var q: iasm.Cursor;
    iasm.cursor_init(?q, ?g, "mov rax", nil, nil, nil, nil);
    if (R.is_err[R.Void, str](iasm.claim(?q, 0, 3)))  { bad = 1; }
    if (R.is_err[R.Void, str](iasm.claim(?q, 4, 3)))  { bad = 1; }
    if (!R.is_err[R.Void, str](iasm.claim(?q, 5, 2))) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode:asm_unresolved_binding_refused_at_emit" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;
    st.fixups   = nil; st.fixup_count = 0; st.fixup_cap = 0;

    var bad: i32 = 0;
    var f: mir.MirFunction;
    var l: iasm.Labels;
    iasm.labels_init(?l, ?alloc);

    val src: R.Result[R.Void, str] = x64_asm_text(?st, ?f, ?l, "mov rax, {v}");
    if (!R.is_err[R.Void, str](src)) { bad = 1; }
    or { if (!str_contains(R.unwrap_err[R.Void, str](src), "unresolved '{name}'")) { bad = 1; } }
    if (!R.is_err[R.Void, str](x64_asm_text(?st, ?f, ?l, "mov {v}, rax"))) { bad = 1; }
    if (!R.is_err[R.Void, str](x64_asm_text(?st, ?f, ?l, "neg {v}")))      { bad = 1; }

    if (st.buf.len != 0) { bad = 1; }

    iasm.labels_dnit(?l);
    enc.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode:branch_to_fallthrough_elided" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;
    st.fixups   = nil; st.fixup_count = 0; st.fixup_cap = 0;

    var bad: i32 = 0;

    var f: mir.MirFunction;

    var jops: [1]mir.MirOperand;
    jops[0] = mir.op_block(4);
    var jm: mir.MirInstr = mir.instr(x64.JMP::u32, ?jops[0], 1, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_mir_instr(?st, ?f, 0, ?jm);
    if (st.buf.len != 5)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_mir_instr(?st, ?f, 0, ?jm);
    if (st.buf.len != 0)     { bad = 1; }
    if (st.fixup_count != 0) { bad = 1; }

    st.has_next_block = true; st.next_block_id = 9; st.buf.len = 0; st.fixup_count = 0;
    encode_mir_instr(?st, ?f, 0, ?jm);
    if (st.buf.len != 5)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(x64.RAX::u32); cops[1] = mir.op_block(3); cops[2] = mir.op_block(4);
    var cbr: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR, ?cops[0], 3, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_cbr(?st, ?f, 0, ?cbr);
    val cbr_len: usize = st.buf.len;
    val cbr_fx:  u32   = st.fixup_count;
    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_cbr(?st, ?f, 0, ?cbr);
    if (st.buf.len != cbr_len - 5)          { bad = 1; }
    if (st.fixup_count != cbr_fx - 1)       { bad = 1; }
    if (st.fixups[0].target_block != 3)     { bad = 1; }

    var ops: [4]mir.MirOperand;
    ops[0] = mir.op_preg(x64.RCX::u32); ops[1] = mir.op_preg(x64.RDX::u32);
    ops[2] = mir.op_block(3); ops[3] = mir.op_block(4);
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR_EQ, ?ops[0], 4, 8, 0);

    st.has_next_block = false; st.buf.len = 0; st.fixup_count = 0;
    encode_fused_cbr(?st, ?f, 0, ?mi);
    val fus_len: usize = st.buf.len;
    val fus_fx:  u32   = st.fixup_count;
    st.has_next_block = true; st.next_block_id = 4; st.buf.len = 0; st.fixup_count = 0;
    encode_fused_cbr(?st, ?f, 0, ?mi);
    if (st.buf.len != fus_len - 5)          { bad = 1; }
    if (st.fixup_count != fus_fx - 1)       { bad = 1; }
    if (st.fixups[0].target_block != 3)     { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_imul:imm16_not_imm32" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);

    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.IMUL;
    mi.dst    = isa.make_reg(x64.RAX, 2);
    mi.src1   = isa.make_imm(0x1234, 2);
    mi.size   = 2;
    mi.flags  = x64.FLAG_16BIT;
    val n: i32 = encode_imul(?mi, ?buf);

    var bad: i32 = 0;
    if (n != 5)              { bad = 1; }
    or (buf.data[0] != 0x66) { bad = 1; }
    or (buf.data[1] != 0x69) { bad = 1; }
    or (buf.data[2] != 0xC0) { bad = 1; }
    or (buf.data[3] != 0x34) { bad = 1; }
    or (buf.data[4] != 0x12) { bad = 1; }

    var mi8: isa.Inst = isa.inst_blank();
    mi8.opcode = x64.IMUL;
    mi8.dst    = isa.make_reg(x64.RAX, 1);
    mi8.src1   = isa.make_imm(5, 1);
    mi8.size   = 1;
    if (encode_imul(?mi8, ?buf) != 0) { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_alu_rr:byte_reg_forces_rex" {
    var alloc: A.Allocator;
