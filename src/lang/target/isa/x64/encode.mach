    var bad: i32 = 0;
    if (buf.len != 3)        { bad = 1; }
    or (buf.data[0] != 0x40) { bad = 1; }
    or (buf.data[1] != 0x20) { bad = 1; }
    or (buf.data[2] != 0xFE) { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_movzx:wide_src_uses_mov" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode    = x64.MOVZX;
    mi.dst       = isa.make_reg(x64.RAX, 8);
    mi.src1      = isa.make_reg(x64.RBX, 4);
    mi.src1.size = 4;
    mi.size      = 8;
    mi.flags     = x64.FLAG_REX_W;
    val n: i32 = encode_inst(?mi, ?buf);
    var bad: i32 = 0;
    if (n != 2)              { bad = 1; }
    or (buf.data[0] != 0x8B) { bad = 1; }
    or (buf.data[1] != 0xC3) { bad = 1; }
    enc.buf_dnit(?buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_mem_operand:rbp_base_disp0" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
