use std.allocator.page;
use std.io.writer;
use std.system.os;
use std.system.panic.panic;
use std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use enc: mach.lang.be.codegen.encode;
use codegen_frame: mach.lang.be.codegen.frame;
use mach.lang.be.codegen.mir;
use mach.lang.ct;
use mach.lang.intern;
use mach.lang.target.abi;
use mach.lang.target.isa;
use iasm: mach.lang.target.isa.asm;
use mach.lang.target.isa.x64;
use mach.lang.target.isa.x64.printer;
use mach.lang.target.of;
use tos: mach.lang.target.os;

fun reg_bits(id: i32) u8 {
    ret (isa.regid_index(id) & 7)::u8;
}

fun operand_touches_reg(op: *isa.Operand, reg: i32) bool {
    if (op == nil) { ret false; }
    if (op.kind == isa.OPK_REG) { ret op.reg == reg; }
    if (op.kind == isa.OPK_MEM) { ret op.base == reg || op.index == reg; }
    ret false;
}

fun pick_stage_scratch(a: *isa.Operand, b: *isa.Operand) i32 {
    val r11_taken: bool = operand_touches_reg(a, x64.R11) || operand_touches_reg(b, x64.R11);
    if (!r11_taken) { ret x64.R11; }
    val r10_taken: bool = operand_touches_reg(a, x64.R10) || operand_touches_reg(b, x64.R10);
    if (!r10_taken) { ret x64.R10; }
    ret -1;
}

fun needs_rex(id: i32) bool {
    val index: i32 = isa.regid_index(id);
    ret index >= 8 && index <= 15;
}

fun needs_rex_byte(id: i32) bool {
    val index: i32 = isa.regid_index(id);
    ret index >= 4 && index <= 15;
}

fun encode_rex(w: u8, reg: i32, rm: i32) u8 {
    var rex: u8 = 0x40;
    if (w != 0) { rex = rex | 0x08; }
    val reg_i: i32 = isa.regid_index(reg);
    val rm_i: i32 = isa.regid_index(rm);
    if (reg_i >= 8 && reg_i <= 15) { rex = rex | 0x04; }
    if (rm_i >= 8 && rm_i <= 15)   { rex = rex | 0x01; }
    ret rex;
}

fun encode_rex_sib(w: u8, reg: i32, index: i32, base: i32) u8 {
    var rex: u8 = 0x40;
    if (w != 0) { rex = rex | 0x08; }
    val reg_i: i32 = isa.regid_index(reg);
    val index_i: i32 = isa.regid_index(index);
    val base_i: i32 = isa.regid_index(base);
    if (reg_i >= 8 && reg_i <= 15)     { rex = rex | 0x04; }
    if (index_i >= 8 && index_i <= 15) { rex = rex | 0x02; }
    if (base_i >= 8 && base_i <= 15)   { rex = rex | 0x01; }
    ret rex;
}

fun encode_modrm(mod_val: u8, reg: u8, rm: u8) u8 {
    ret ((mod_val & 3) << 6) | ((reg & 7) << 3) | (rm & 7);
}

fun encode_sib(scale: u8, index: u8, base: u8) u8 {
    ret ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7);
}

fun size_to_w(size: u8, flags: u16) u8 {
    if ((flags & x64.FLAG_REX_W::u16) != 0) { ret 1; }
    if (size >= 8)                          { ret 1; }
    ret 0;
}

fun needs_any_rex(w: u8, reg: i32, rm: i32) bool {
    if (w != 0) { ret true; }
    val reg_i: i32 = isa.regid_index(reg);
    val rm_i: i32 = isa.regid_index(rm);
    if (reg_i >= 8 && reg_i <= 15) { ret true; }
    if (rm_i >= 8 && rm_i <= 15)   { ret true; }
    ret false;
}

fun needs_rex_for_byte_reg(reg: i32) bool {
    val index: i32 = isa.regid_index(reg);
    ret index >= 4 && index <= 7;
}

fun encode_mem_operand(buf: *enc.ByteBuf, reg: i32, op: *isa.Operand) {
    val base: i32 = op.base;
    val index: i32 = op.index;
    val disp: i32 = op.disp;
    val has_index: bool = index >= 0;

    if (base != -1 && base != x64.MEM_BASE_ABS && isa.regid_class(base) != isa.REG_CLASS_ID_GP) {
        panic("encode: memory base register is not general-purpose\n");
    }
    if (has_index && isa.regid_class(index) != isa.REG_CLASS_ID_GP) {
        panic("encode: memory index register is not general-purpose\n");
    }
    if (has_index && isa.regid_index(index) == x64.RSP) {
        panic("encode: RSP cannot be used as a SIB index register\n");
    }

    if (base == x64.MEM_BASE_ABS) {
        if (has_index) { panic("encode: absolute memory operand carries an index register\n"); }
        enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 4));
        enc.emit_byte(buf, encode_sib(0, 4, 5));
        enc.emit_u32(buf, disp::u32);
        ret;
    }

    if (base == -1 && !has_index) {
        enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 5));
        enc.emit_u32(buf, disp::u32);
        ret;
    }

    var scale_bits: u8 = 0;
    if (has_index) {
        if (op.scale <= 1) { scale_bits = 0; }
        or (op.scale == 2) { scale_bits = 1; }
        or (op.scale == 4) { scale_bits = 2; }
        or (op.scale == 8) { scale_bits = 3; }
        or {
            panic("encode: invalid SIB scale (must be 1, 2, 4, or 8)\n");
        }
    }

    if (base == -1 && has_index) {
        enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 4));
        enc.emit_byte(buf, encode_sib(scale_bits, reg_bits(index), 5));
        enc.emit_u32(buf, disp::u32);
        ret;
    }

    val base_needs_sib: bool = (base & 7) == 4;
    val use_sib: bool = has_index || base_needs_sib;

    if (base == 5 || base == 13) {
        if (disp == 0) {
            if (use_sib) {
                enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), 4));
                var idx_reg: u8 = 4;
                if (has_index) { idx_reg = reg_bits(index); }
                enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
            } or {
                enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), reg_bits(base)));
            }
            enc.emit_byte(buf, 0);
            ret;
        }
    }

    if (disp == 0) {
        if (use_sib) {
            enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 4));
            var idx_reg: u8 = 4;
            if (has_index) { idx_reg = reg_bits(index); }
            enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
        } or {
            enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), reg_bits(base)));
        }
        ret;
    }

    if (disp >= -128 && disp <= 127) {
        if (use_sib) {
            enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), 4));
            var idx_reg: u8 = 4;
            if (has_index) { idx_reg = reg_bits(index); }
            enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
        } or {
            enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), reg_bits(base)));
        }
        enc.emit_byte(buf, disp::u8);
        ret;
    }

    if (use_sib) {
        enc.emit_byte(buf, encode_modrm(2, reg_bits(reg), 4));
        var idx_reg: u8 = 4;
        if (has_index) { idx_reg = reg_bits(index); }
        enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
    } or {
        enc.emit_byte(buf, encode_modrm(2, reg_bits(reg), reg_bits(base)));
    }
    enc.emit_u32(buf, disp::u32);
}

fun emit_rex_byte_mem(buf: *enc.ByteBuf, reg: i32, mem: *isa.Operand) {
    if (mem.index >= 0) {
        enc.emit_byte(buf, encode_rex_sib(0, reg, mem.index, mem.base));
    } or {
        enc.emit_byte(buf, encode_rex(0, reg, mem.base));
    }
}

fun emit_rex_if_needed(buf: *enc.ByteBuf, w: u8, reg: i32, rm: i32) {
    if (needs_any_rex(w, reg, rm)) {
        enc.emit_byte(buf, encode_rex(w, reg, rm));
    }
}

fun emit_rex_mem(buf: *enc.ByteBuf, w: u8, reg: i32, mem: *isa.Operand) {
    val base: i32 = mem.base;
    val index: i32 = mem.index;
    if (index >= 0) {
        val rex: u8 = encode_rex_sib(w, reg, index, base);
        if (rex != 0x40 || w != 0) {
            enc.emit_byte(buf, rex);
        }
    } or {
        emit_rex_if_needed(buf, w, reg, base);
    }
}

fun emit_prefix_reg(buf: *enc.ByteBuf, size: u8, flags: u16, reg: i32, rm: i32) {
    if (size == 2 || (flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
    if (size == 1 && (needs_rex_for_byte_reg(reg) || needs_rex_for_byte_reg(rm))) {
        enc.emit_byte(buf, encode_rex(0, reg, rm));
    } or {
        emit_rex_if_needed(buf, size_to_w(size, flags), reg, rm);
    }
}

fun emit_prefix_mem(buf: *enc.ByteBuf, size: u8, flags: u16, reg: i32, mem: *isa.Operand) {
    if (size == 2 || (flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
    if (size == 1 && needs_rex_for_byte_reg(reg)) {
        emit_rex_byte_mem(buf, reg, mem);
    } or {
        emit_rex_mem(buf, size_to_w(size, flags), reg, mem);
    }
}

fun imm_fits_width(imm: i64, size: u8) bool {
    if (size == 1) { ret imm >= -128 && imm <= 255; }
    if (size == 2) { ret imm >= -32768 && imm <= 65535; }
    if (size == 4) { ret imm >= -2147483648 && imm <= 4294967295; }
    ret true;
}

fun emit_imm_sized(buf: *enc.ByteBuf, imm: i64, size: u8) {
    if (size == 1) { enc.emit_byte(buf, imm::u8); }
    or (size == 2) { enc.emit_u16(buf, imm::u16); }
    or { enc.emit_u32(buf, imm::u32); }
}

fun encode_alu_rr(buf: *enc.ByteBuf, opcode: u8, dst: i32, src: i32, size: u8, flags: u16) {
    emit_prefix_reg(buf, size, flags, src, dst);
    enc.emit_byte(buf, opcode);
    enc.emit_byte(buf, encode_modrm(3, reg_bits(src), reg_bits(dst)));
}

fun encode_alu_rm(buf: *enc.ByteBuf, opcode: u8, reg: i32, mem: *isa.Operand, size: u8, flags: u16) {
    emit_prefix_mem(buf, size, flags, reg, mem);
    enc.emit_byte(buf, opcode);
    encode_mem_operand(buf, reg, mem);
}

fun encode_alu_imm(buf: *enc.ByteBuf, opcode: u16, reg: i32, imm: i64, size: u8, flags: u16) {
    if (size == 8 && (imm < -2147483648 || imm > 2147483647)) {
        val reg_op: isa.Operand = isa.make_reg(reg, size);
        val scratch: i32 = pick_stage_scratch(?reg_op, nil);
        if (scratch < 0) { ret; }
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa.make_reg(scratch, 8);
        ld.src1   = isa.make_imm(imm, 8);
        ld.size   = 8;
        encode_inst(?ld, buf);
        var rr: isa.Inst = isa.inst_blank();
        rr.opcode = opcode;
        rr.dst    = isa.make_reg(reg, 8);
        rr.src1   = isa.make_reg(scratch, 8);
        rr.size   = 8;
        rr.flags  = flags;
        encode_inst(?rr, buf);
        ret;
    }
    if (!imm_fits_width(imm, size)) { ret; }

    val group: u8 = alu_group(opcode);
    emit_prefix_reg(buf, size, flags, 0, reg);

    if (imm >= -128 && imm <= 127 && size > 1) {
        enc.emit_byte(buf, 0x83);
        enc.emit_byte(buf, encode_modrm(3, group, reg_bits(reg)));
        enc.emit_byte(buf, imm::u8);
    } or {
        var opc: u8 = 0x81;
        if (size == 1) { opc = 0x80; }
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, group, reg_bits(reg)));
        emit_imm_sized(buf, imm, size);
    }
}

fun alu_group(opcode: u16) u8 {
    if (opcode == x64.ADD) { ret 0; }
    if (opcode == x64.OR)  { ret 1; }
    if (opcode == x64.AND) { ret 4; }
    if (opcode == x64.SUB) { ret 5; }
    if (opcode == x64.XOR) { ret 6; }
    if (opcode == x64.CMP) { ret 7; }
    ret 0;
}

fun alu_opcode_rr(opcode: u16, size: u8) u8 {
    var base: u8 = 0;
    if (opcode == x64.ADD) { base = 0x01; }
    or (opcode == x64.OR)  { base = 0x09; }
    or (opcode == x64.AND) { base = 0x21; }
    or (opcode == x64.SUB) { base = 0x29; }
    or (opcode == x64.XOR) { base = 0x31; }
    or (opcode == x64.CMP) { base = 0x39; }
    or { base = 0x01; }
    if (size == 1) { ret base - 1; }
    ret base;
}

fun cc_to_x86(opcode: u16) u8 {
    if (opcode == x64.JE  || opcode == x64.SETE)  { ret 0x04; }
    if (opcode == x64.JNE || opcode == x64.SETNE) { ret 0x05; }
    if (opcode == x64.JL  || opcode == x64.SETL)  { ret 0x0C; }
    if (opcode == x64.JLE || opcode == x64.SETLE) { ret 0x0E; }
    if (opcode == x64.JG  || opcode == x64.SETG)  { ret 0x0F; }
    if (opcode == x64.JGE || opcode == x64.SETGE) { ret 0x0D; }
    if (opcode == x64.JB  || opcode == x64.SETB)  { ret 0x02; }
    if (opcode == x64.JBE || opcode == x64.SETBE) { ret 0x06; }
    if (opcode == x64.JA  || opcode == x64.SETA)  { ret 0x07; }
    if (opcode == x64.JAE || opcode == x64.SETAE) { ret 0x03; }
    if (opcode == x64.SETP)                       { ret 0x0A; }
    if (opcode == x64.SETNP)                      { ret 0x0B; }
    ret 0x04;
}

fun is_jcc(opcode: u16) bool {
    ret opcode >= x64.JE && opcode <= x64.JAE;
}

fun is_setcc(opcode: u16) bool {
    if (opcode == x64.SETP || opcode == x64.SETNP) { ret true; }
    ret opcode >= x64.SETE && opcode <= x64.SETAE;
}

fun is_alu(opcode: u16) bool {
    if (opcode == x64.ADD) { ret true; }
    if (opcode == x64.SUB) { ret true; }
    if (opcode == x64.AND) { ret true; }
    if (opcode == x64.OR)  { ret true; }
    if (opcode == x64.XOR) { ret true; }
    if (opcode == x64.CMP) { ret true; }
    ret false;
}

fun is_sse_mov(opcode: u16) bool {
    ret opcode == x64.MOVSS || opcode == x64.MOVSD;
}

fun is_sse_alu(opcode: u16) bool {
    ret opcode >= x64.ADDSS && opcode <= x64.DIVSD;
}

fun is_float_width(w: u8) bool {
    ret w == 4 || w == 8;
}

fun reg_is_xmm(op: *isa.Operand) bool {
    ret op.kind == isa.OPK_REG && isa.regid_class(op.reg) == isa.REG_CLASS_ID_XMM;
}

fun encode_fp_mov(mi: *isa.Inst, buf: *enc.ByteBuf) R.Result[i32, str] {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;

    if (mi.size == 16) {
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            emit_movaps_rr(dst.reg, src1.reg, buf);
            ret R.ok[i32, str]((buf.len - start)::i32);
        }
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
            emit_movups_load(dst.reg, @src1, buf);
            ret R.ok[i32, str]((buf.len - start)::i32);
        }
        if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
            emit_movups_store(@dst, src1.reg, buf);
            ret R.ok[i32, str]((buf.len - start)::i32);
        }
        emit_movups_load(FLOAT_SCRATCH0, @src1, buf);
        emit_movups_store(@dst, FLOAT_SCRATCH0, buf);
        ret R.ok[i32, str]((buf.len - start)::i32);
    }

    val w: u8 = mi.size;
    if (!is_float_width(w)) {
        ret R.err[i32, str]("internal compiler error: float move has a non-float operand width (expected 4, 8 or 16)");
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG &&
        reg_is_xmm(dst) != reg_is_xmm(src1)) {
        if (reg_is_xmm(dst)) {
            emit_movd_movq_reg(src1.reg, dst.reg, w, true, buf);
        } or {
            emit_movd_movq_reg(dst.reg, src1.reg, w, false, buf);
        }
        ret R.ok[i32, str]((buf.len - start)::i32);
    }

    if (reg_is_xmm(dst)) {
        val ld: R.Result[R.Void, str] = emit_float_reg_or_slot_load(@src1, dst.reg, w, buf);
        if (R.is_err[R.Void, str](ld)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](ld)); }
        ret R.ok[i32, str]((buf.len - start)::i32);
    }
    if (!reg_is_xmm(src1)) {
        ret R.err[i32, str]("encode: a same-bank float move names no SSE register");
    }
    val st: R.Result[R.Void, str] = emit_float_store(@dst, src1.reg, w, buf);
    if (R.is_err[R.Void, str](st)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](st)); }
    ret R.ok[i32, str]((buf.len - start)::i32);
}

fun encode_mov(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;

    if (reg_is_xmm(dst) || reg_is_xmm(src1) || size == 16) {
        val fp: R.Result[i32, str] = encode_fp_mov(mi, buf);
        if (R.is_err[i32, str](fp)) { panic(R.unwrap_err[i32, str](fp)::*u8); }
        ret R.unwrap_ok[i32, str](fp);
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        if (size == 1) {
            enc.emit_byte(buf, 0x88);
        } or {
            enc.emit_byte(buf, 0x89);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        val w: u8 = size_to_w(size, flags);
        val imm: i64 = src1.imm;
        if (size < 8 && !imm_fits_width(imm, size)) { ret 0; }
        if (size == 2 || (flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
        if (size == 1) {
            if (needs_rex_byte(dst.reg)) {
                enc.emit_byte(buf, encode_rex(0, 0, dst.reg));
            }
            enc.emit_byte(buf, 0xB0 + reg_bits(dst.reg));
            enc.emit_byte(buf, imm::u8);
        } or (size == 2) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
            enc.emit_u16(buf, imm::u16);
        } or (size == 4) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
            enc.emit_u32(buf, imm::u32);
        } or {
            if (imm >= -2147483648 && imm <= 2147483647) {
                emit_rex_if_needed(buf, w, 0, dst.reg);
                enc.emit_byte(buf, 0xC7);
                enc.emit_byte(buf, encode_modrm(3, 0, reg_bits(dst.reg)));
                enc.emit_u32(buf, imm::u32);
            } or {
                mi.opcode = x64.MOVABS;
                enc.emit_byte(buf, encode_rex(1, 0, dst.reg));
                enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
                enc.emit_u64(buf, imm::u64);
            }
        }
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, dst.reg, src1);
        if (size == 1) {
            enc.emit_byte(buf, 0x8A);
        } or {
            enc.emit_byte(buf, 0x8B);
        }
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        if (size == 1) {
            enc.emit_byte(buf, 0x88);
        } or {
            enc.emit_byte(buf, 0x89);
        }
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_MEM) {
        val scratch: i32 = pick_stage_scratch(dst, src1);
        if (scratch < 0) { ret 0; }
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = mi.opcode;
        ld.dst    = isa.make_reg(scratch, size);
        ld.src1   = mi.src1;
        ld.size   = size;
        ld.flags  = flags;
        val ld_sz: i32 = encode_inst(?ld, buf);
        var st: isa.Inst = isa.inst_blank();
        st.opcode = mi.opcode;
        st.dst    = mi.dst;
        st.src1   = isa.make_reg(scratch, size);
        st.size   = size;
        st.flags  = flags;
        val st_sz: i32 = encode_inst(?st, buf);
        ret ld_sz + st_sz;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_IMM) {
        if (size == 8 && (src1.imm < -2147483648 || src1.imm > 2147483647)) {
            val scratch: i32 = pick_stage_scratch(dst, nil);
            if (scratch < 0) { ret 0; }
            var ld: isa.Inst = isa.inst_blank();
            ld.opcode = x64.MOVABS;
            ld.dst    = isa.make_reg(scratch, 8);
            ld.src1   = isa.make_imm(src1.imm, 8);
            ld.size   = 8;
            val ld_sz: i32 = encode_inst(?ld, buf);
            var st: isa.Inst = isa.inst_blank();
            st.opcode = mi.opcode;
            st.dst    = mi.dst;
            st.src1   = isa.make_reg(scratch, 8);
            st.size   = 8;
            st.flags  = flags;
            val st_sz: i32 = encode_inst(?st, buf);
            ret ld_sz + st_sz;
        }
        if (!imm_fits_width(src1.imm, size)) { ret 0; }
        emit_prefix_mem(buf, size, flags, 0, dst);
        if (size == 1) {
            enc.emit_byte(buf, 0xC6);
        } or {
            enc.emit_byte(buf, 0xC7);
        }
        encode_mem_operand(buf, 0, dst);
        emit_imm_sized(buf, src1.imm, size);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_lea(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG) { ret 0; }

    if (src1.kind == isa.OPK_LABEL) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        enc.emit_byte(buf, encode_rex(w, dst.reg, 0));
        enc.emit_byte(buf, 0x8D);
        enc.emit_byte(buf, encode_modrm(0, reg_bits(dst.reg), 5));
        enc.emit_u32(buf, 0);
        ret (buf.len - start)::i32;
    }

    if (src1.kind != isa.OPK_MEM) { ret 0; }
    val w: u8 = size_to_w(mi.size, mi.flags);
    emit_rex_mem(buf, w, dst.reg, src1);
    enc.emit_byte(buf, 0x8D);
    encode_mem_operand(buf, dst.reg, src1);
    ret (buf.len - start)::i32;
}

fun encode_push(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val src: *isa.Operand = ?mi.dst;
    if (src.kind == isa.OPK_REG) {
        if (needs_rex(src.reg)) {
            enc.emit_byte(buf, encode_rex(0, 0, src.reg));
        }
        enc.emit_byte(buf, 0x50 + reg_bits(src.reg));
    } or (src.kind == isa.OPK_IMM) {
        val imm: i64 = src.imm;
        if (imm >= -128 && imm <= 127) {
            enc.emit_byte(buf, 0x6A);
            enc.emit_byte(buf, imm::u8);
        } or (imm >= -2147483648 && imm <= 2147483647) {
            enc.emit_byte(buf, 0x68);
            enc.emit_u32(buf, imm::u32);
        } or {
            ret 0;
        }
    }
    ret (buf.len - start)::i32;
}

fun encode_pop(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    if (dst.kind != isa.OPK_REG) { ret 0; }
    if (needs_rex(dst.reg)) {
        enc.emit_byte(buf, encode_rex(0, 0, dst.reg));
    }
    enc.emit_byte(buf, 0x58 + reg_bits(dst.reg));
    ret (buf.len - start)::i32;
}

fun encode_alu(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    val opcode: u16 = mi.opcode;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        val opc: u8 = alu_opcode_rr(opcode, size);
        encode_alu_rr(buf, opc, dst.reg, src1.reg, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        encode_alu_imm(buf, opcode, dst.reg, src1.imm, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        val opc: u8 = alu_opcode_rr(opcode, size) + 2;
        encode_alu_rm(buf, opc, dst.reg, src1, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        val opc: u8 = alu_opcode_rr(opcode, size);
        encode_alu_rm(buf, opc, src1.reg, dst, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_IMM) {
        val imm: i64 = src1.imm;
        if (size == 8 && (imm < -2147483648 || imm > 2147483647)) {
            val scratch: i32 = pick_stage_scratch(dst, nil);
            if (scratch < 0) { ret 0; }
            var ld: isa.Inst = isa.inst_blank();
            ld.opcode = x64.MOV;
            ld.dst    = isa.make_reg(scratch, 8);
            ld.src1   = isa.make_imm(imm, 8);
            ld.size   = 8;
            encode_inst(?ld, buf);
            var rm: isa.Inst = isa.inst_blank();
            rm.opcode = opcode;
            rm.dst    = mi.dst;
            rm.src1   = isa.make_reg(scratch, 8);
            rm.size   = 8;
            rm.flags  = flags;
            encode_inst(?rm, buf);
            ret (buf.len - start)::i32;
        }
        if (!imm_fits_width(imm, size)) { ret 0; }
        val grp: u8 = alu_group(opcode);
        val w: u8 = size_to_w(size, flags);
        if ((flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
        emit_rex_mem(buf, w, grp::i32, dst);
        if (imm >= -128 && imm <= 127 && size > 1) {
            enc.emit_byte(buf, 0x83);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_byte(buf, imm::u8);
        } or (size == 1) {
            enc.emit_byte(buf, 0x80);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_byte(buf, imm::u8);
        } or (size == 2) {
            enc.emit_byte(buf, 0x81);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_u16(buf, imm::u16);
        } or {
            enc.emit_byte(buf, 0x81);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_u32(buf, imm::u32);
        }
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun maybe_emit_lock(buf: *enc.ByteBuf, flags: u16) {
    if ((flags & x64.FLAG_LOCK::u16) != 0) { enc.emit_byte(buf, 0xF0); }
}

fun encode_unary_grp3(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    var modrm_ext: u8 = 3;
    if (mi.opcode == x64.NOT) { modrm_ext = 2; }

    var opc: u8 = 0xF7;
    if (size == 1) { opc = 0xF6; }

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, 0, dst.reg);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, 0, dst);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, modrm_ext::i32, dst);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_unary_grp5(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    var modrm_ext: u8 = 0;
    if (mi.opcode == x64.DEC) { modrm_ext = 1; }

    var opc: u8 = 0xFF;
    if (size == 1) { opc = 0xFE; }

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, 0, dst.reg);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, 0, dst);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, modrm_ext::i32, dst);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_xchg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    var opc: u8 = 0x87;
    if (size == 1) { opc = 0x86; }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, dst.reg, src1);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_xadd_cmpxchg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    if (src1.kind != isa.OPK_REG) { ret 0; }

    var opc2: u8 = 0xC1;
    if (mi.opcode == x64.CMPXCHG) { opc2 = 0xB1; }
    if (size == 1)                { opc2 = opc2 - 1; }

    maybe_emit_lock(buf, flags);

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc2);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc2);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_test(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        if (size == 1) {
            enc.emit_byte(buf, 0x84);
        } or {
            enc.emit_byte(buf, 0x85);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        if (size == 8) {
            if (src1.imm < -2147483648 || src1.imm > 2147483647) { ret 0; }
        } or (!imm_fits_width(src1.imm, size)) { ret 0; }
        emit_prefix_reg(buf, size, flags, 0, dst.reg);
        var opc: u8 = 0xF7;
        if (size == 1) { opc = 0xF6; }
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, 0, reg_bits(dst.reg)));
        emit_imm_sized(buf, src1.imm, size);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_IMM) {
        if (size == 8) {
            if (src1.imm < -2147483648 || src1.imm > 2147483647) { ret 0; }
        } or (!imm_fits_width(src1.imm, size)) { ret 0; }
        emit_prefix_mem(buf, size, flags, 0, dst);
        var opc: u8 = 0xF7;
        if (size == 1) { opc = 0xF6; }
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, 0, dst);
        emit_imm_sized(buf, src1.imm, size);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        if (size == 1) {
            enc.emit_byte(buf, 0x84);
        } or {
            enc.emit_byte(buf, 0x85);
        }
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_imul(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xAF);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xAF);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        val imm: i64 = src1.imm;
        if (size < 2) { ret 0; }
        if (size == 8 && (imm < -2147483648 || imm > 2147483647)) {
            val scratch: i32 = pick_stage_scratch(dst, nil);
            if (scratch < 0) { ret 0; }
            var ld: isa.Inst = isa.inst_blank();
            ld.opcode = x64.MOV;
            ld.dst    = isa.make_reg(scratch, 8);
            ld.src1   = isa.make_imm(imm, 8);
            ld.size   = 8;
            encode_inst(?ld, buf);
            var rr: isa.Inst = isa.inst_blank();
            rr.opcode = x64.IMUL;
            rr.dst    = isa.make_reg(dst.reg, size);
            rr.src1   = isa.make_reg(scratch, size);
            rr.size   = size;
            rr.flags  = flags;
            encode_inst(?rr, buf);
            ret (buf.len - start)::i32;
        }
        if (!imm_fits_width(imm, size)) { ret 0; }
        emit_prefix_reg(buf, size, flags, dst.reg, dst.reg);
        if (imm >= -128 && imm <= 127) {
            enc.emit_byte(buf, 0x6B);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(dst.reg)));
            enc.emit_byte(buf, imm::u8);
        } or {
            enc.emit_byte(buf, 0x69);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(dst.reg)));
            emit_imm_sized(buf, imm, size);
        }
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_div(mi: *isa.Inst, buf: *enc.ByteBuf, is_signed: bool) i32 {
    val start: usize = buf.len;
    val src: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    var modrm_ext: u8 = 6;
    if (is_signed) { modrm_ext = 7; }

    if (src.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, 0, src.reg);
        if (size == 1) {
            enc.emit_byte(buf, 0xF6);
        } or {
            enc.emit_byte(buf, 0xF7);
        }
        enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(src.reg)));
        ret (buf.len - start)::i32;
    }

    if (src.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, 0, src);
        if (size == 1) {
            enc.emit_byte(buf, 0xF6);
        } or {
            enc.emit_byte(buf, 0xF7);
        }
        encode_mem_operand(buf, modrm_ext::i32, src);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_shift(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val size: u8 = mi.size;
    val flags: u16 = mi.flags;
    val opcode: u16 = mi.opcode;
    var modrm_ext: u8 = 4;
    if (opcode == x64.SHR) { modrm_ext = 5; }
    if (opcode == x64.SAR) { modrm_ext = 7; }

    if (dst.kind != isa.OPK_REG && dst.kind != isa.OPK_MEM) { ret 0; }
    val dst_is_mem: bool = dst.kind == isa.OPK_MEM;

    if (src1.kind == isa.OPK_REG) {
        if (dst_is_mem) { emit_prefix_mem(buf, size, flags, 0, dst); } or { emit_prefix_reg(buf, size, flags, 0, dst.reg); }
        if (size == 1) {
            enc.emit_byte(buf, 0xD2);
        } or {
            enc.emit_byte(buf, 0xD3);
        }
        if (dst_is_mem) { encode_mem_operand(buf, modrm_ext::i32, dst); } or { enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg))); }
    } or (src1.kind == isa.OPK_IMM) {
        val imm: i64 = src1.imm;
        if (!imm_fits_width(imm, 1)) { ret 0; }
        if (dst_is_mem) { emit_prefix_mem(buf, size, flags, 0, dst); } or { emit_prefix_reg(buf, size, flags, 0, dst.reg); }
        if (imm == 1) {
            if (size == 1) {
                enc.emit_byte(buf, 0xD0);
            } or {
                enc.emit_byte(buf, 0xD1);
            }
            if (dst_is_mem) { encode_mem_operand(buf, modrm_ext::i32, dst); } or { enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg))); }
        } or {
            if (size == 1) {
                enc.emit_byte(buf, 0xC0);
            } or {
                enc.emit_byte(buf, 0xC1);
            }
            if (dst_is_mem) { encode_mem_operand(buf, modrm_ext::i32, dst); } or { enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg))); }
            enc.emit_byte(buf, imm::u8);
        }
    } or {
        ret 0;
    }

    ret (buf.len - start)::i32;
}

fun encode_cdq_cqo(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    if (mi.opcode == x64.CQO) {
        enc.emit_byte(buf, 0x48);
        enc.emit_byte(buf, 0x99);
    } or {
        enc.emit_byte(buf, 0x99);
    }
    ret (buf.len - start)::i32;
}

fun encode_jcc(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val cc: u8 = cc_to_x86(mi.opcode);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x80 + cc);
    enc.emit_u32(buf, 0);
    ret (buf.len - start)::i32;
}

fun encode_jmp(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;

    if ((mi.flags & x64.FLAG_INDIRECT::u16) != 0) {
        if (dst.kind == isa.OPK_REG) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xFF);
            enc.emit_byte(buf, encode_modrm(3, 4, reg_bits(dst.reg)));
        } or (dst.kind == isa.OPK_MEM) {
            emit_rex_mem(buf, 0, 4, dst);
            enc.emit_byte(buf, 0xFF);
            encode_mem_operand(buf, 4, dst);
        }
        ret (buf.len - start)::i32;
    }

    enc.emit_byte(buf, 0xE9);
    enc.emit_u32(buf, 0);
    ret (buf.len - start)::i32;
}

fun encode_call(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;

    if ((mi.flags & x64.FLAG_INDIRECT::u16) != 0) {
        if (dst.kind == isa.OPK_REG) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xFF);
            enc.emit_byte(buf, encode_modrm(3, 2, reg_bits(dst.reg)));
        } or (dst.kind == isa.OPK_MEM) {
            emit_rex_mem(buf, 0, 2, dst);
            enc.emit_byte(buf, 0xFF);
            encode_mem_operand(buf, 2, dst);
        }
        ret (buf.len - start)::i32;
    }

    enc.emit_byte(buf, 0xE8);
    enc.emit_u32(buf, 0);
    ret (buf.len - start)::i32;
}

fun encode_portio(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val is_in: bool = mi.opcode == x64.IN;
    var port: *isa.Operand = ?mi.dst;
    var acc:  *isa.Operand = ?mi.src1;
    if (is_in) { port = ?mi.src1; acc = ?mi.dst; }

    val w: u8 = acc.size;
    if (w != 1 && w != 2 && w != 4) { ret 0; }

    val imm_port: bool = port.kind == isa.OPK_IMM;
    if (!imm_port && port.kind != isa.OPK_REG)        { ret 0; }
    if (imm_port && (port.imm < 0 || port.imm > 255)) { ret 0; }

    var op: u8 = 0xEC;
    if (imm_port)         { op = 0xE4; }
    if (!is_in)           { op = op + 2; }
    if (w != 1)           { op = op + 1; }

    val start: usize = buf.len;
    if (w == 2) { enc.emit_byte(buf, 0x66); }
    enc.emit_byte(buf, op);
    if (imm_port) { enc.emit_byte(buf, (port.imm & 0xFF)::u8); }
    ret (buf.len - start)::i32;
}

fun encode_ret(buf: *enc.ByteBuf) i32 {
    enc.emit_byte(buf, 0xC3);
    ret 1;
}

fun encode_setcc(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val cc: u8 = cc_to_x86(mi.opcode);

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, 1, 0, 0, dst.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x90 + cc);
        enc.emit_byte(buf, encode_modrm(3, 0, reg_bits(dst.reg)));
    }
    ret (buf.len - start)::i32;
}

fun encode_xorps(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        if (needs_rex(dst.reg) || needs_rex(src1.reg)) {
            enc.emit_byte(buf, encode_rex(0, dst.reg, src1.reg));
        }
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x57);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x57);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_movq(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG || src1.kind != isa.OPK_REG) { ret 0; }

    var w: u8 = 0;
    if (mi.size == 8) { w = 1; }
    if (dst.size == 16) {
        enc.emit_byte(buf, 0x66);
        enc.emit_byte(buf, encode_rex(w, dst.reg, src1.reg));
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x6E);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }
    enc.emit_byte(buf, 0x66);
    enc.emit_byte(buf, encode_rex(w, src1.reg, dst.reg));
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x7E);
    enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
    ret (buf.len - start)::i32;
}

fun encode_movzx(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val src_size: u8 = src1.size;
    val w: u8 = size_to_w(mi.size, mi.flags);

    if (src_size >= 4) {
        mi.opcode = x64.MOV;
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x8B);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
            ret (buf.len - start)::i32;
        }
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
            emit_rex_mem(buf, 0, dst.reg, src1);
            enc.emit_byte(buf, 0x8B);
            encode_mem_operand(buf, dst.reg, src1);
            ret (buf.len - start)::i32;
        }
        ret 0;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        if (src_size == 1 && needs_rex_for_byte_reg(src1.reg)) {
            enc.emit_byte(buf, encode_rex(w, dst.reg, src1.reg));
        } or {
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
        }
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xB6);
        } or {
            enc.emit_byte(buf, 0xB7);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, w, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xB6);
        } or {
            enc.emit_byte(buf, 0xB7);
        }
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_movsx(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val src_size: u8 = src1.size;
    if (src_size == 4) {
        mi.opcode = x64.MOVSXD;
        ret encode_movsxd(mi, buf);
    }
    val w: u8 = size_to_w(mi.size, mi.flags);

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        if (src_size == 1 && needs_rex_for_byte_reg(src1.reg)) {
            enc.emit_byte(buf, encode_rex(w, dst.reg, src1.reg));
        } or {
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
        }
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xBE);
        } or {
            enc.emit_byte(buf, 0xBF);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, w, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xBE);
        } or {
            enc.emit_byte(buf, 0xBF);
        }
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_mov_ctlreg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;

    var gp: *isa.Operand = dst;
    var cr: *isa.Operand = src1;
    var op: u8 = 0x20;
    if (dst.kind == isa.OPK_IMM) {
        gp = src1;
        cr = dst;
        op = 0x22;
    }
    if (gp.kind != isa.OPK_REG || cr.kind != isa.OPK_IMM) { ret 0; }

    var rex: u8 = 0x40;
    if (cr.imm >= 8)      { rex = rex | 0x04; }
    if (needs_rex(gp.reg)) { rex = rex | 0x01; }
    if (rex != 0x40) { enc.emit_byte(buf, rex); }

    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, op);
    enc.emit_byte(buf, encode_modrm(3, (cr.imm & 7)::u8, reg_bits(gp.reg)));
    ret (buf.len - start)::i32;
}

fun encode_mov_segreg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG || src1.kind != isa.OPK_IMM) { ret 0; }

    if (mi.size == 2) { enc.emit_byte(buf, 0x66); }
    emit_rex_if_needed(buf, 0, src1.imm::i32, dst.reg);

    enc.emit_byte(buf, 0x8C);
    enc.emit_byte(buf, encode_modrm(3, (src1.imm & 7)::u8, reg_bits(dst.reg)));
    ret (buf.len - start)::i32;
}

fun encode_movsxd(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, encode_rex(1, dst.reg, src1.reg));
        enc.emit_byte(buf, 0x63);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 1, dst.reg, src1);
        enc.emit_byte(buf, 0x63);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_movabs(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG) { ret 0; }
    enc.emit_byte(buf, encode_rex(1, 0, dst.reg));
    enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
    if (src1.kind == isa.OPK_IMM) {
        enc.emit_u64(buf, src1.imm::u64);
    } or (src1.kind == isa.OPK_SYM || src1.kind == isa.OPK_LABEL) {
        enc.emit_u64(buf, 0);
    } or {
        enc.emit_u64(buf, 0);
    }
    ret (buf.len - start)::i32;
}

fun encode_sse_mov(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val opcode: u16 = mi.opcode;

    var prefix: u8 = 0xF3;
    if (opcode == x64.MOVSD) { prefix = 0xF2; }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, prefix);
        emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x10);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        enc.emit_byte(buf, prefix);
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x10);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, prefix);
        emit_rex_mem(buf, 0, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x11);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_movaps(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x28);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_rex_mem(buf, 0, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x29);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun sse_alu_opcode(opcode: u16) u8 {
    if (opcode == x64.ADDSS || opcode == x64.ADDSD) { ret 0x58; }
    if (opcode == x64.SUBSS || opcode == x64.SUBSD) { ret 0x5C; }
    if (opcode == x64.MULSS || opcode == x64.MULSD) { ret 0x59; }
    if (opcode == x64.DIVSS || opcode == x64.DIVSD) { ret 0x5E; }
    ret 0x58;
}

fun sse_alu_prefix(opcode: u16) u8 {
    if (opcode == x64.ADDSD || opcode == x64.SUBSD || opcode == x64.MULSD || opcode == x64.DIVSD) {
        ret 0xF2;
    }
    ret 0xF3;
}

fun encode_sse_alu(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val prefix: u8 = sse_alu_prefix(mi.opcode);
    val opc: u8 = sse_alu_opcode(mi.opcode);

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, prefix);
        emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        enc.emit_byte(buf, prefix);
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_ucomiss(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;

    if (mi.opcode == x64.UCOMISD) {
        enc.emit_byte(buf, 0x66);
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x2E);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x2E);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_cvt(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val dst: *isa.Operand = ?mi.dst;
    val src1: *isa.Operand = ?mi.src1;
    val opcode: u16 = mi.opcode;

    if (opcode == x64.CVTSI2SS) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF3);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTSI2SD) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF2);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTTSS2SI) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF3);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2C);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTTSD2SI) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF2);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2C);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTSS2SD) {
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF3);
            emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x5A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTSD2SS) {
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF2);
            emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x5A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_inst(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    if (mi == nil || buf == nil) { ret 0; }
    val opcode: u16 = mi.opcode;

    if (opcode == isa.ISA_PCOPY || opcode == isa.ISA_PCOPY_FENCE) { ret 0; }

    if (mi.src1.kind == isa.OPK_MEM && mi.dst.kind == isa.OPK_MEM &&
        opcode != x64.NOP && opcode != x64.RET && opcode != x64.SYSCALL &&
        opcode != x64.UD2 && opcode != x64.PAUSE && opcode != x64.CDQ &&
        opcode != x64.CQO && opcode != x64.MFENCE &&
        opcode != x64.SHL && opcode != x64.SHR && opcode != x64.SAR &&
        opcode != x64.XCHG && opcode != x64.XADD && opcode != x64.CMPXCHG) {
        var scratch: i32 = FLOAT_SCRATCH0;
        if (mi.size != 16) {
            scratch = pick_stage_scratch(?mi.dst, ?mi.src1);
            if (scratch < 0) { ret 0; }
        }
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa.make_reg(scratch, mi.size);
        ld.src1   = mi.src1;
        ld.size   = mi.size;
        ld.flags  = mi.flags;
        val ld_sz: i32 = encode_inst(?ld, buf);
        mi.src1 = isa.make_reg(scratch, mi.size);
        val rest: i32 = encode_inst(mi, buf);
        ret ld_sz + rest;
    }

    val start: usize = buf.len;
    val n: i32 = encode_inst_one(mi, buf);
    if (enc.sink_unaccounted(buf) > 0) { printer.note_inst(buf, mi, start); }
    ret n;
}

fun encode_inst_one(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val opcode: u16 = mi.opcode;

    if (opcode == x64.NOP) {
        enc.emit_byte(buf, 0x90);
        ret 1;
    }

    if (opcode == x64.MOV) {
        ret encode_mov(mi, buf);
    }

    if (opcode == x64.LEA) {
        ret encode_lea(mi, buf);
    }

    if (opcode == x64.PUSH) {
        ret encode_push(mi, buf);
    }

    if (opcode == x64.POP) {
        ret encode_pop(mi, buf);
    }

    if (is_alu(opcode)) {
        ret encode_alu(mi, buf);
    }

    if (opcode == x64.TEST) {
        ret encode_test(mi, buf);
    }

    if (opcode == x64.IMUL) {
        ret encode_imul(mi, buf);
    }

    if (opcode == x64.IDIV) {
        ret encode_div(mi, buf, true);
    }

    if (opcode == x64.DIV) {
        ret encode_div(mi, buf, false);
    }

    if (opcode == x64.SHL || opcode == x64.SHR || opcode == x64.SAR) {
        ret encode_shift(mi, buf);
    }

    if (opcode == x64.CDQ || opcode == x64.CQO) {
        ret encode_cdq_cqo(mi, buf);
    }

    if (is_jcc(opcode)) {
        ret encode_jcc(mi, buf);
    }

    if (opcode == x64.JMP) {
        ret encode_jmp(mi, buf);
    }

    if (opcode == x64.CALL) {
        ret encode_call(mi, buf);
    }

    if (opcode == x64.RET) {
        ret encode_ret(buf);
    }

    if (is_setcc(opcode)) {
        ret encode_setcc(mi, buf);
    }

    if (opcode == x64.MOVZX) {
        ret encode_movzx(mi, buf);
    }

    if (opcode == x64.MOVSX) {
        ret encode_movsx(mi, buf);
    }

    if (opcode == x64.MOVQ) {
        ret encode_movq(mi, buf);
    }

    if (opcode == x64.XORPS) {
        ret encode_xorps(mi, buf);
    }

    if (opcode == x64.MOVSXD) {
        ret encode_movsxd(mi, buf);
    }

    if (opcode == x64.MOVABS) {
        ret encode_movabs(mi, buf);
    }

    if (is_sse_mov(opcode)) {
        ret encode_sse_mov(mi, buf);
    }

    if (opcode == x64.MOVAPS) {
        ret encode_movaps(mi, buf);
    }

    if (is_sse_alu(opcode)) {
        ret encode_sse_alu(mi, buf);
    }

    if (opcode == x64.UCOMISS || opcode == x64.UCOMISD) {
        ret encode_ucomiss(mi, buf);
    }

    if (opcode >= x64.CVTSI2SS && opcode <= x64.CVTTSD2SI) {
        ret encode_cvt(mi, buf);
    }

    if (opcode == x64.SYSCALL) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x05);
        ret 2;
    }

    if (opcode == x64.UD2) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x0B);
        ret 2;
    }

    if (opcode == x64.PAUSE) {
        enc.emit_byte(buf, 0xF3);
        enc.emit_byte(buf, 0x90);
        ret 2;
    }

    if (opcode == x64.MFENCE) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xAE);
        enc.emit_byte(buf, 0xF0);
        ret 3;
    }

    if (opcode == x64.HLT) {
        enc.emit_byte(buf, 0xF4);
        ret 1;
    }

    if (opcode == x64.CLI)   { enc.emit_byte(buf, 0xFA); ret 1; }
    if (opcode == x64.STI)   { enc.emit_byte(buf, 0xFB); ret 1; }
    if (opcode == x64.RDTSC) { enc.emit_byte(buf, 0x0F); enc.emit_byte(buf, 0x31); ret 2; }
    if (opcode == x64.RDMSR) { enc.emit_byte(buf, 0x0F); enc.emit_byte(buf, 0x32); ret 2; }
    if (opcode == x64.WRMSR) { enc.emit_byte(buf, 0x0F); enc.emit_byte(buf, 0x30); ret 2; }

    if (opcode == x64.CLD)    { enc.emit_byte(buf, 0xFC); ret 1; }
    if (opcode == x64.PUSHFQ) { enc.emit_byte(buf, 0x9C); ret 1; }
    if (opcode == x64.POPFQ)  { enc.emit_byte(buf, 0x9D); ret 1; }
    if (opcode == x64.IRETQ)  { enc.emit_byte(buf, 0x48); enc.emit_byte(buf, 0xCF); ret 2; }
    if (opcode == x64.SWAPGS) {
        enc.emit_byte(buf, 0x0F); enc.emit_byte(buf, 0x01); enc.emit_byte(buf, 0xF8);
        ret 3;
    }

    if (opcode == x64.MOV_CR)  { ret encode_mov_ctlreg(mi, buf); }
    if (opcode == x64.MOV_SEG) { ret encode_mov_segreg(mi, buf); }

    if (opcode == x64.LIDT) {
        val dst: *isa.Operand = ?mi.dst;
        if (dst.kind != isa.OPK_MEM) { ret 0; }
        val lidt_start: usize = buf.len;
        emit_rex_mem(buf, 0, 3, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x01);
        encode_mem_operand(buf, 3, dst);
        ret (buf.len - lidt_start)::i32;
    }

    if (opcode == x64.IN || opcode == x64.OUT) {
        ret encode_portio(mi, buf);
    }

    if (opcode == x64.NEG || opcode == x64.NOT) {
        ret encode_unary_grp3(mi, buf);
    }

    if (opcode == x64.INC || opcode == x64.DEC) {
        ret encode_unary_grp5(mi, buf);
    }

    if (opcode == x64.XCHG) {
        ret encode_xchg(mi, buf);
    }

    if (opcode == x64.XADD || opcode == x64.CMPXCHG) {
        ret encode_xadd_cmpxchg(mi, buf);
    }

    if (opcode == x64.RAW_BYTE) {
        enc.emit_byte(buf, mi.dst.imm::u8);
        ret 1;
    }

    if (opcode == x64.CBW) {
        enc.emit_byte(buf, 0x66);
        enc.emit_byte(buf, 0x98);
        ret 2;
    }

    if (opcode == x64.CWD) {
        enc.emit_byte(buf, 0x66);
        enc.emit_byte(buf, 0x99);
        ret 2;
    }

    if (opcode == x64.MOVSB) {
        var count: i32 = 0;
        if ((mi.flags & x64.FLAG_REP::u16) != 0) {
            enc.emit_byte(buf, 0xF3);
            count = count + 1;
        }
        enc.emit_byte(buf, 0xA4);
        count = count + 1;
        ret count;
    }

    os.write(os.STDERR_FD, "encode: unhandled opcode ", 25);
    var opc_buf: [20]u8;
    val opc_len: usize = u64_to_dec(opcode::u64, ?opc_buf[0]);
    os.write(os.STDERR_FD, ?opc_buf[0], opc_len);
    panic("\n");
    ret 0;
}

fun count_callee_saved(fill: isa.RegFileFn, mask: u32) i32 {
    var list: [16]i32;
    val ln: i32 = x64.callee_saved_gp_list_from(fill, ?list[0]);
    var n: i32 = 0;
    var i: i32 = 0;
    for (i < ln) {
        if ((mask & (1::u32 << list[i]::u32)) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun slot_base_reg(f: *mir.MirFunction) i32 {
    if (codegen_frame.slots_from_sp(?f.frame)) { ret x64.RSP; }
    ret x64.RBP;
}

fun slot_base_bias(f: *mir.MirFunction) i64 {
    if (!codegen_frame.slots_from_sp(?f.frame)) { ret 0; }
    ret f.frame.base_dist::i64;
}

fun fp_save_base(fill: isa.RegFileFn, frame_size: u32, callee_mask: u32) usize {
    val gp_space: usize = count_callee_saved(fill, callee_mask)::usize * 8;
    var base: usize = frame_size::usize + gp_space;
    if ((base & 15) != 0) { base = (base + 15) & ~15::usize; }
    ret base;
}

fun popcount32(m: u32) i32 {
    var n: i32 = 0;
    var x: u32 = m;
    for (x != 0) {
        n = n + (x & 1)::i32;
        x = x >> 1;
    }
    ret n;
}

fun emit_inst(st: *enc.EncodeState, mi: *isa.Inst) {
    encode_inst(mi, ?st.buf);
}

fun emit_frame_store(st: *enc.EncodeState, reg: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa.make_mem(base, disp, -1, 0, 8);
    mi.src1   = isa.make_reg(reg, 8);
    mi.size   = 8;
    mi.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mi);
}

fun emit_frame_load(st: *enc.EncodeState, reg: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa.make_reg(reg, 8);
    mi.src1   = isa.make_mem(base, disp, -1, 0, 8);
    mi.size   = 8;
    mi.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mi);
}

fun emit_xmm_store(st: *enc.EncodeState, idx: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOVAPS;
    mi.dst    = isa.make_mem(base, disp, -1, 0, 16);
    mi.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx), 16);
    mi.size   = 16;
    emit_inst(st, ?mi);
}

fun emit_xmm_load(st: *enc.EncodeState, idx: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOVAPS;
    mi.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx), 16);
    mi.src1   = isa.make_mem(base, disp, -1, 0, 16);
    mi.size   = 16;
    emit_inst(st, ?mi);
}

fun needs_stack_probe(stack_probe: bool, page_size: u64, total: usize) bool {
    ret stack_probe && total > page_size::usize;
}

fun emit_stack_probe(st: *enc.EncodeState, total: usize, page_bytes: usize) {
    var mov_cnt: isa.Inst = isa.inst_blank();
    mov_cnt.opcode = x64.MOV;
    mov_cnt.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    mov_cnt.src1   = isa.make_imm(total::i64, 8);
    mov_cnt.size   = 8;
    mov_cnt.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mov_cnt);

    val loop_top: usize = st.buf.len;

    var sub_sp: isa.Inst = isa.inst_blank();
    sub_sp.opcode = x64.SUB;
    sub_sp.dst    = isa.make_reg(x64.RSP, 8);
    sub_sp.src1   = isa.make_imm(page_bytes::i64, 8);
    sub_sp.size   = 8;
    sub_sp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?sub_sp);

    var touch: isa.Inst = isa.inst_blank();
    touch.opcode = x64.MOV;
    touch.dst    = isa.make_mem(x64.RSP, 0, -1, 0, 8);
    touch.src1   = isa.make_reg(x64.SCRATCH_REG, 8);
    touch.size   = 8;
    touch.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?touch);

    var sub_cnt: isa.Inst = isa.inst_blank();
    sub_cnt.opcode = x64.SUB;
    sub_cnt.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    sub_cnt.src1   = isa.make_imm(page_bytes::i64, 8);
    sub_cnt.size   = 8;
    sub_cnt.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?sub_cnt);

    var cmp_cnt: isa.Inst = isa.inst_blank();
    cmp_cnt.opcode = x64.CMP;
    cmp_cnt.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    cmp_cnt.src1   = isa.make_imm(page_bytes::i64, 8);
    cmp_cnt.size   = 8;
    cmp_cnt.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?cmp_cnt);

    var ja: isa.Inst = isa.inst_blank();
    ja.opcode = x64.JA;
    ja.dst    = isa.make_label(nil);
    ja.size   = DEFAULT_OPERAND_SIZE;
    emit_inst(st, ?ja);
    val ja_patch: usize = st.buf.len - 4;
    patch_rel32(?st.buf, ja_patch, (loop_top::i64 - st.buf.len::i64)::i32);

    var sub_rem: isa.Inst = isa.inst_blank();
    sub_rem.opcode = x64.SUB;
    sub_rem.dst    = isa.make_reg(x64.RSP, 8);
    sub_rem.src1   = isa.make_reg(x64.SCRATCH_REG, 8);
    sub_rem.size   = 8;
    sub_rem.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?sub_rem);
}

fun emit_prologue(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32) R.Result[R.Void, str] {
    val frame_size: u32     = f.frame.size;
    val callee_mask: u32    = f.callee_mask;
    val callee_mask_fp: u32 = f.callee_mask_fp;
    val outgoing_size: u32  = f.frame.outgoing_size;

    val rf: R.Result[R.Void, str] = enc.push_frame(st, fn_base);
    if (R.is_err[R.Void, str](rf)) { ret rf; }

    var push_rbp: isa.Inst = isa.inst_blank();
    push_rbp.opcode = x64.PUSH;
    push_rbp.dst    = isa.make_reg(x64.RBP, 8);
    push_rbp.size   = 8;
    push_rbp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?push_rbp);
    val rs_push: R.Result[R.Void, str] = enc.push_frame_step(st, of.FRAME_STEP_PUSH, x64.RBP::u8,
                                                           st.buf.len::u32 - fn_base, 0);
    if (R.is_err[R.Void, str](rs_push)) { ret rs_push; }

    var mov_rbp: isa.Inst = isa.inst_blank();
    mov_rbp.opcode = x64.MOV;
    mov_rbp.dst    = isa.make_reg(x64.RBP, 8);
    mov_rbp.src1   = isa.make_reg(x64.RSP, 8);
    mov_rbp.size   = 8;
    mov_rbp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mov_rbp);

    val realigned: bool = f.frame.realign != 0;
    if (realigned) {
        val rs_fp: R.Result[R.Void, str] = enc.push_frame_step(st, of.FRAME_STEP_SET_FP, x64.RBP::u8,
                                                             st.buf.len::u32 - fn_base, 0);
        if (R.is_err[R.Void, str](rs_fp)) { ret rs_fp; }

        var and_rsp: isa.Inst = isa.inst_blank();
        and_rsp.opcode = x64.AND;
        and_rsp.dst    = isa.make_reg(x64.RSP, 8);
        and_rsp.src1   = isa.make_imm(0 - f.frame.realign::i64, 8);
        and_rsp.size   = 8;
        and_rsp.flags  = x64.FLAG_REX_W;
        emit_inst(st, ?and_rsp);
    }

    val total: usize = f.frame.base_dist::usize;
    if (total > 0) {
        if (needs_stack_probe(st.stack_probe, st.page_size, total)) {
            emit_stack_probe(st, total, st.page_size::usize);
        } or {
            var sub_rsp: isa.Inst = isa.inst_blank();
            sub_rsp.opcode = x64.SUB;
            sub_rsp.dst    = isa.make_reg(x64.RSP, 8);
            sub_rsp.src1   = isa.make_imm(total::i64, 8);
            sub_rsp.size   = 8;
            sub_rsp.flags  = x64.FLAG_REX_W;
            emit_inst(st, ?sub_rsp);
        }
        if (!realigned) {
            val rs_alloc: R.Result[R.Void, str] = enc.push_frame_step(st, of.FRAME_STEP_ALLOC, 0,
                                                                    st.buf.len::u32 - fn_base, total::u64);
            if (R.is_err[R.Void, str](rs_alloc)) { ret rs_alloc; }
        }
    }

    val sbase: i32 = slot_base_reg(f);
    val sbias: i64 = slot_base_bias(f);

    var list: [16]i32;
    val ln: i32 = x64.callee_saved_gp_list_from(st.callee_saved, ?list[0]);
    var coff: i32 = frame_size::i32 + 8;
    var i: i32 = 0;
    for (i < ln) {
        if ((callee_mask & (1::u32 << list[i]::u32)) != 0) {
            emit_frame_store(st, list[i], sbase, (sbias - coff::i64)::i32);
            val rs_save: R.Result[R.Void, str] = enc.push_frame_step(st, of.FRAME_STEP_SAVE, list[i]::u8,
                                                                   st.buf.len::u32 - fn_base,
                                                                   (total::i64 - coff::i64)::u64);
            if (R.is_err[R.Void, str](rs_save)) { ret rs_save; }
            coff = coff + 8;
        }
        i = i + 1;
    }

    val xbase: i32 = fp_save_base(st.callee_saved, frame_size, callee_mask)::i32;
    var xoff: i32 = xbase + 16;
    var x: i32 = 0;
    for (x < 16) {
        if ((callee_mask_fp & (1::u32 << x::u32)) != 0) {
            emit_xmm_store(st, x, sbase, (sbias - xoff::i64)::i32);
            val rs_xsave: R.Result[R.Void, str] = enc.push_frame_step(st, of.FRAME_STEP_SAVE_VEC, x::u8,
                                                                    st.buf.len::u32 - fn_base,
                                                                    (total::i64 - xoff::i64)::u64);
            if (R.is_err[R.Void, str](rs_xsave)) { ret rs_xsave; }
            xoff = xoff + 16;
        }
        x = x + 1;
    }
    ret R.ok_void[str]();
}

fun emit_epilogue(st: *enc.EncodeState, f: *mir.MirFunction) {
    val frame_size: u32     = f.frame.size;
    val callee_mask: u32    = f.callee_mask;
    val callee_mask_fp: u32 = f.callee_mask_fp;
    val sbase: i32 = slot_base_reg(f);
    val sbias: i64 = slot_base_bias(f);

    val xbase: i32 = fp_save_base(st.callee_saved, frame_size, callee_mask)::i32;
    var xoff: i32 = xbase + 16;
    var x: i32 = 0;
    for (x < 16) {
        if ((callee_mask_fp & (1::u32 << x::u32)) != 0) {
            emit_xmm_load(st, x, sbase, (sbias - xoff::i64)::i32);
            xoff = xoff + 16;
        }
        x = x + 1;
    }

    var list: [16]i32;
    val ln: i32 = x64.callee_saved_gp_list_from(st.callee_saved, ?list[0]);
    var coff: i32 = frame_size::i32 + 8;
    var i: i32 = 0;
    for (i < ln) {
        if ((callee_mask & (1::u32 << list[i]::u32)) != 0) {
            emit_frame_load(st, list[i], sbase, (sbias - coff::i64)::i32);
            coff = coff + 8;
        }
        i = i + 1;
    }

    var mov_rsp: isa.Inst = isa.inst_blank();
    mov_rsp.opcode = x64.MOV;
    mov_rsp.dst    = isa.make_reg(x64.RSP, 8);
    mov_rsp.src1   = isa.make_reg(x64.RBP, 8);
    mov_rsp.size   = 8;
    mov_rsp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mov_rsp);

    var pop_rbp: isa.Inst = isa.inst_blank();
    pop_rbp.opcode = x64.POP;
    pop_rbp.dst    = isa.make_reg(x64.RBP, 8);
    pop_rbp.size   = 8;
    pop_rbp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?pop_rbp);
}

fun is_rip_mem(op: *isa.Operand) bool {
    ret op.kind == isa.OPK_MEM && op.base == -1 && op.index == -1;
}

fun trailing_imm_width(mi: *isa.Inst) i32 {
    if (mi.src1.kind != isa.OPK_IMM) { ret 0; }
    if (mi.size == 8 && (mi.src1.imm < -2147483648 || mi.src1.imm > 2147483647)) { ret 0; }
    if (mi.size == 1)                                                            { ret 1; }
    if (mi.size == 2)                                                            { ret 2; }
    ret 4;
}

fun x86_reloc_offset(ctx: ptr, mi: *isa.Inst, inst_size: i32) i32 {
    if (mi.opcode == x64.MOVABS) {
        ret inst_size - 8;
    }
    if (mi.opcode == x64.CALL || mi.opcode == x64.JMP || is_jcc(mi.opcode)) {
        ret inst_size - 4;
    }
    if (mi.dst.kind == isa.OPK_LABEL || mi.src1.kind == isa.OPK_LABEL) {
        ret inst_size - 4;
    }
    if (is_rip_mem(?mi.dst)) {
        ret inst_size - trailing_imm_width(mi) - 4;
    }
    if (is_rip_mem(?mi.src1)) {
        ret inst_size - 4;
    }
    ret -1;
}

val DEFAULT_OPERAND_SIZE: u8 = 8;

pub fun encode_x64(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule) R.Result[enc.EncoderOutput, str] {
    var hooks: enc.EncodeHooks;
    hooks.encode_function = encode_function;
    hooks.patch_branch    = patch_branch_x86;
    ret enc.encode_driver(alloc, tgt, m, ?hooks);
}

pub fun encode_x64_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule,
                       out: *writer.Writer) R.Result[enc.EncoderOutput, str] {
    var hooks: enc.EncodeHooks;
    hooks.encode_function = encode_function;
    hooks.patch_branch    = patch_branch_x86;

    val res_header: R.Result[R.Void, str] = printer.emit_header(out);
    if (R.is_err[R.Void, str](res_header)) {
        ret R.err[enc.EncoderOutput, str](R.unwrap_err[R.Void, str](res_header));
    }
    ret enc.encode_driver_asm(alloc, tgt, m, ?hooks, out);
}

fun patch_branch_x86(st: *enc.EncodeState, fx: *enc.BranchFixup, target_off: u32) R.Result[R.Void, str] {
    val disp: i32 = target_off::i32 - fx.next_ip::i32;
    if (fx.patch_pos::usize + 4 > st.buf.len) {
        ret R.err[R.Void, str]("encode: branch fixup site is outside the text buffer");
    }
    patch_rel32(?st.buf, fx.patch_pos::usize, disp);
    ret R.ok_void[str]();
}

fun encode_function(st: *enc.EncodeState, f: *mir.MirFunction) R.Result[R.Void, str] {
    val fn_base: u32 = st.buf.len::u32;

    if (f.block_count == 0) { ret R.ok_void[str](); }

    val ms: R.Result[R.Void, str] = enc.push_symbol(st, f.name, fn_base, of.SYM_OBJ_FLAG_FUNCTION);
    if (R.is_err[R.Void, str](ms)) { ret ms; }

    val naked: bool = f.frame.omit;
    val frame_size: u32 = f.frame.size;
    val callee_mask: u32 = f.callee_mask;
    val callee_mask_fp: u32 = f.callee_mask_fp;
    val outgoing_size: u32 = f.frame.outgoing_size;

    if (enc.sink_active(?st.buf)) {
        val rh: R.Result[R.Void, str] = printer.note_function(?st.buf, st.interner, f);
        if (R.is_err[R.Void, str](rh)) { ret rh; }
    }

    if (!naked) {
        val rpl: R.Result[R.Void, str] = emit_prologue(st, f, fn_base);
        if (R.is_err[R.Void, str](rpl)) { ret rpl; }
    }
    val rp: R.Result[R.Void, str] = check_accounted(st, PROLOGUE_REGION);
    if (R.is_err[R.Void, str](rp)) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock = ?f.blocks[bi];
        val rb: R.Result[R.Void, str] = enc.push_block(st, fn_base, blk.id, st.buf.len::u32);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        enc.set_fallthrough(st, f, bi);

        if (enc.sink_active(?st.buf)) {
            val rl: R.Result[R.Void, str] = printer.note_block(?st.buf, blk.id);
            if (R.is_err[R.Void, str](rl)) { ret rl; }
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (!mir.emits_instr(f, mi)) { ii = ii + 1; cnt; }
            val rr: R.Result[R.Void, str] = enc.push_row(st, st.buf.len::u32, mi.loc);
            if (R.is_err[R.Void, str](rr)) { ret rr; }
            val rip: R.Result[R.Void, str] = enc.push_inline_pc(st, st.buf.len::u32, mi.inline_site);
            if (R.is_err[R.Void, str](rip)) { ret rip; }
            if (mi.opcode::u16 == x64.RET::u16 && !naked) {
                emit_epilogue(st, f);
            }
            enc.sink_set_mir(?st.buf, mi);
            val ei: R.Result[R.Void, str] = encode_mir_instr(st, f, fn_base, mi);
            enc.sink_set_mir(?st.buf, nil);
            if (R.is_err[R.Void, str](ei)) { ret ei; }
            val ra: R.Result[R.Void, str] = check_accounted(st, mi.opcode::u16);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    ret R.ok_void[str]();
}

val PROLOGUE_REGION: u16 = 0xFFFF;

fun check_accounted(st: *enc.EncodeState, opcode: u16) R.Result[R.Void, str] {
    val gap: usize = enc.sink_unaccounted(?st.buf);
    if (gap == 0) { ret R.ok_void[str](); }

    var num: [20]u8;
    var label: str = "prologue";
    if (opcode != PROLOGUE_REGION) {
        val n: usize = u64_to_dec(opcode::u64, ?num[0]);
        num[n] = 0;
        label = (?num[0])::str;
    }
    ret R.err[R.Void, str](enc_named_message(st,
        "--emit-asm: opcode ", label,
        " emitted bytes the x86-64 assembly printer did not render",
        "--emit-asm: an opcode emitted bytes the assembly printer did not render"));
}

fun enc_named_message(st: *enc.EncodeState, prefix: str, name: str, suffix: str, fallback: str) str {
    ret named_message(st.alloc, st.interner, prefix, name, suffix, fallback);
}

fun named_message(alloc: *A.Allocator, interner: *intern.Interner, prefix: str, name: str, suffix: str, fallback: str) str {
    if (interner == nil || name == nil) { ret fallback; }
    val lp: usize = str_len(prefix);
    val ln: usize = str_len(name);
    val ls: usize = str_len(suffix);
    val total: usize = lp + ln + ls;

    val r: R.Result[*u8, str] = A.allocate[u8](alloc, total + 1);
    if (R.is_err[*u8, str](r)) { ret fallback; }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    var k: usize = 0;
    var j: usize = 0;
    for (j < lp) { buf[k] = prefix[j]; k = k + 1; j = j + 1; }
    j = 0;
    for (j < ln) { buf[k] = name[j]; k = k + 1; j = j + 1; }
    j = 0;
    for (j < ls) { buf[k] = suffix[j]; k = k + 1; j = j + 1; }
    buf[total] = 0;

    val ir: R.Result[intern.StrId, str] = intern.intern(interner, buf::str);
    A.deallocate[u8](alloc, buf, total + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }
    val nm: O.Option[str] = intern.lookup(interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret fallback;
}

fun enc_fn_name(st: *enc.EncodeState, f: *mir.MirFunction) str {
    val fno: O.Option[str] = intern.lookup(st.interner, f.name);
    if (O.is_some[str](fno)) { ret O.unwrap[str](fno); }
    ret "<unknown>";
}

fun encode_mir_instr(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    val opcode: u16 = mi.opcode::u16;

    val rv_vb: R.Result[R.Void, str] = enc.emit_var_bindings(st, f, mi);
    if (R.is_err[R.Void, str](rv_vb)) { ret rv_vb; }

    if (opcode == isa.ISA_PCOPY || opcode == isa.ISA_PCOPY_FENCE ||
        opcode == isa.ISA_USE || opcode == isa.ISA_LABEL) {
        ret R.ok_void[str]();
    }

    if (mi.opcode == mir.MIR_CALL_RES || mi.opcode == mir.MIR_ARG) {
        ret R.ok_void[str]();
    }
    if (mi.opcode == mir.MIR_PHI) {
        ret R.err[R.Void, str](enc_named_message(st, "internal compiler error: phi survived register allocation in '", enc_fn_name(st, f), "'", "internal compiler error: phi survived register allocation"));
    }

    if (mir.vec_lane_is_vector(mi.vec_lane) && is_selected_vector_alu(mi.opcode)) {
        ret encode_vector_op(f, mi, ?st.buf);
    }

    if (is_mir_compare(mi.opcode)) {
        ret encode_compare(f, mi, ?st.buf);
    }

    if (is_mir_float_arith(mi.opcode)) {
        ret encode_float_arith(st, f, mi);
    }
    if (mi.opcode == mir.MIR_FCMP) {
        ret encode_float_cmp(st, f, mi);
    }
    if (mi.opcode == mir.MIR_FNEG) {
        ret encode_float_neg(st, f, mi);
    }

    if (is_mir_float_conv(mi.opcode)) {
        ret encode_float_conv(st, f, mi);
    }

    if (is_float_const_move(f, mi)) {
        ret encode_float_const_mov(st, f, mi);
    }

    if (is_mir_divide(mi.opcode)) {
        ret encode_divide(f, mi, ?st.buf);
    }

    if (is_mir_binary(mi.opcode)) {
        ret encode_binary(f, mi, ?st.buf);
    }

    if (is_mir_shift(mi.opcode)) {
        ret encode_shift_mir(f, mi, ?st.buf);
    }

    if (mi.opcode == mir.MIR_SEL_CBR) {
        ret encode_cbr(st, f, fn_base, mi);
    }

    if (mir.is_fused_cbr(mi.opcode)) {
        ret encode_fused_cbr(st, f, fn_base, mi);
    }

    if (opcode == x64.JMP::u16) {
        var jt: u32 = 0;
        var jhas: bool = false;
        var jsym: intern.StrId = intern.STR_NIL;
        var jhsym: bool = false;
        var jaddend: i32 = 0;
        enc.classify_refs(mi, ?jt, ?jhas, ?jsym, ?jhsym, ?jaddend);
        if (jhas && enc.branch_falls_through(st, jt)) { ret R.ok_void[str](); }
    }

    if (opcode == x64.ASM_BLOCK::u16) {
        ret encode_asm_block(st, f, fn_base, mi);
    }

    var inst: isa.Inst = isa.inst_blank();
    val ti: R.Result[R.Void, str] = mir_to_inst(f, mi, ?inst);
    if (R.is_err[R.Void, str](ti)) { ret ti; }

    var target_block: u32 = 0;
    var has_block: bool = false;
    var sym: intern.StrId = intern.STR_NIL;
    var has_sym: bool = false;
    var sym_addend: i32 = 0;
    enc.classify_refs(mi, ?target_block, ?has_block, ?sym, ?has_sym, ?sym_addend);

    val inst_start: usize = st.buf.len;
    val inst_size: i32 = encode_inst(?inst, ?st.buf);
    if (inst_size <= 0) {
        ret R.err[R.Void, str](enc_named_message(st, "internal compiler error: concrete opcode produced no bytes in '", enc_fn_name(st, f), "'", "internal compiler error: concrete opcode produced no bytes"));
    }

    if (has_block) {
        val reloc_off: i32 = x86_reloc_offset(nil, ?inst, inst_size);
        if (reloc_off < 0) {
            ret R.err[R.Void, str]("encode: block-referencing instruction has no relocation patch site");
        }
        val patch_pos: u32 = (inst_start + reloc_off::usize)::u32;
        val next_ip: u32 = (inst_start + inst_size::usize)::u32;
        ret enc.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
    }

    if (has_sym) {
        if (sym == intern.STR_NIL) {
            ret R.err[R.Void, str]("encode: symbol-referencing instruction has no resolved symbol name");
        }
        val reloc_off: i32 = x86_reloc_offset(nil, ?inst, inst_size);
        if (reloc_off < 0) {
            ret R.err[R.Void, str]("encode: symbol-referencing instruction has no relocation patch site");
        }
        val patch_pos: u32 = (inst_start + reloc_off::usize)::u32;
        var kind: of.RelocKind = of.RK_PC32;
        var addend: i32 = sym_addend - (inst_size - reloc_off);
        if (inst.opcode == x64.MOVABS::u16) {
            kind   = of.RK_ABS64;
            addend = sym_addend;
        }
        ret enc.push_reloc(st, patch_pos, kind, sym, addend);
    }

    ret R.ok_void[str]();
}

fun is_mir_compare(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_CMP_EQ || op == mir.MIR_SEL_CMP_NE ||
        op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U ||
        op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U;
}

fun mir_setcc_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_CMP_EQ)   { ret x64.SETE; }
    if (op == mir.MIR_SEL_CMP_NE)   { ret x64.SETNE; }
    if (op == mir.MIR_SEL_CMP_LT_S) { ret x64.SETL; }
    if (op == mir.MIR_SEL_CMP_LT_U) { ret x64.SETB; }
    if (op == mir.MIR_SEL_CMP_LE_S) { ret x64.SETLE; }
    ret x64.SETBE;
}

fun emit_flag_cmp(f: *mir.MirFunction, lhs_op: *mir.MirOperand, rhs_op: *mir.MirOperand,
                  width: u8, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    val cwidth: u8 = effective_width(width);
    val rl: R.Result[isa.Operand, str] = mir_to_operand(f, lhs_op, cwidth);
    if (R.is_err[isa.Operand, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rl)); }
    val lhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rl);
    val rr: R.Result[isa.Operand, str] = mir_to_operand(f, rhs_op, cwidth);
    if (R.is_err[isa.Operand, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rr)); }
    val rhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rr);

    var cmp_lhs: isa.Operand = lhs;
    if (cmp_lhs.kind == isa.OPK_IMM) {
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa.make_reg(x64.R11, cwidth);
        ld.src1   = lhs;
        ld.size   = cwidth;
        ld.flags  = width_flags(width);
        encode_inst(?ld, buf);
        cmp_lhs = isa.make_reg(x64.R11, cwidth);
    }

    var cmp: isa.Inst = isa.inst_blank();
    cmp.opcode = x64.CMP;
    cmp.dst    = cmp_lhs;
    cmp.src1   = rhs;
    cmp.size   = cwidth;
    cmp.flags  = width_flags(width);
    encode_inst(?cmp, buf);
    ret R.ok_void[str]();
}

fun encode_compare(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 3) {
        ret R.err[R.Void, str]("encode: comparison missing operands");
    }
    val cwidth: u8 = effective_width(mi.width);
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], cwidth);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);

    val rc: R.Result[R.Void, str] = emit_flag_cmp(f, ?mi.operands[1], ?mi.operands[2], mi.width, buf);
    if (R.is_err[R.Void, str](rc)) { ret rc; }

    var setcc: isa.Inst = isa.inst_blank();
    setcc.opcode  = mir_setcc_opcode(mi.opcode);
    setcc.dst     = dst;
    setcc.dst.size = 1;
    setcc.size    = 1;
    encode_inst(?setcc, buf);

    var movzx: isa.Inst = isa.inst_blank();
    movzx.opcode  = x64.MOVZX;
    movzx.dst     = dst;
    movzx.dst.size = DEFAULT_OPERAND_SIZE;
    movzx.src1    = dst;
    movzx.src1.size = 1;
    movzx.size    = DEFAULT_OPERAND_SIZE;
    movzx.flags   = x64.FLAG_REX_W;
    encode_inst(?movzx, buf);

    ret R.ok_void[str]();
}

val FLOAT_SCRATCH0: i32 = (1 << 8) | 14;
val FLOAT_SCRATCH1: i32 = (1 << 8) | 15;

fun is_mir_float_arith(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FADD || op == mir.MIR_FSUB ||
        op == mir.MIR_FMUL || op == mir.MIR_FDIV;
}

fun float_alu_opcode(op: mir.MirOpcode, w: u8) u16 {
    if (op == mir.MIR_FADD) { if (w == 4) { ret x64.ADDSS; } ret x64.ADDSD; }
    if (op == mir.MIR_FSUB) { if (w == 4) { ret x64.SUBSS; } ret x64.SUBSD; }
    if (op == mir.MIR_FMUL) { if (w == 4) { ret x64.MULSS; } ret x64.MULSD; }
    if (w == 4)                           { ret x64.DIVSS; }
    ret x64.DIVSD;
}

fun emit_float_load(st: *enc.EncodeState, op: isa.Operand, xmm: i32, w: u8) R.Result[R.Void, str] {
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float load has a non-float access width (expected 4 or 8)");
    }
    if (op.kind != isa.OPK_IMM) { ret emit_float_reg_or_slot_load(op, xmm, w, ?st.buf); }

    val cr: R.Result[isa.Operand, str] = float_const_operand(st, op.imm::u64, xmm, w);
    if (R.is_err[isa.Operand, str](cr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](cr)); }
    val src: isa.Operand = R.unwrap_ok[isa.Operand, str](cr);
    if (src.kind == isa.OPK_NONE) { ret R.ok_void[str](); }

    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }
    var ld: isa.Inst = isa.inst_blank();
    ld.opcode = mov_op;
    ld.dst    = isa.make_reg(xmm, 16);
    ld.src1   = src;
    ld.size   = w;
    ret encode_inst_sym(st, ?ld);
}

fun emit_float_reg_or_slot_load(op: isa.Operand, xmm: i32, w: u8, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float load has a non-float access width (expected 4 or 8)");
    }
    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }

    if (op.kind == isa.OPK_MEM) {
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = mov_op;
        ld.dst    = isa.make_reg(xmm, 16);
        ld.src1   = op;
        ld.size   = w;
        encode_inst(?ld, buf);
        ret R.ok_void[str]();
    }
    if (op.kind == isa.OPK_REG) {
        var mv: isa.Inst = isa.inst_blank();
        mv.opcode = mov_op;
        mv.dst    = isa.make_reg(xmm, 16);
        mv.src1   = isa.make_reg(op.reg, 16);
        mv.size   = w;
        encode_inst(?mv, buf);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: float operand is not a register or a frame slot");
}

fun float_const_operand(st: *enc.EncodeState, bits: u64, zero_reg: i32, w: u8) R.Result[isa.Operand, str] {
    if (!is_float_width(w)) {
        ret R.err[isa.Operand, str]("internal compiler error: float constant has a non-float width (expected 4 or 8)");
    }
    var pattern: u64 = bits;
    if (w == 4) { pattern = bits & 0xFFFFFFFF; }

    if (pattern == 0) {
        var zero: isa.Inst = isa.inst_blank();
        zero.opcode = x64.XORPS;
        zero.dst    = isa.make_reg(zero_reg, 16);
        zero.src1   = isa.make_reg(zero_reg, 16);
        zero.size   = 16;
        encode_inst(?zero, ?st.buf);
        ret R.ok[isa.Operand, str](isa.make_none());
    }

    val sr: R.Result[intern.StrId, str] = enc.intern_float_const(st, pattern, w);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[isa.Operand, str](R.unwrap_err[intern.StrId, str](sr)); }

    var mem: isa.Operand = isa.make_mem(-1, 0, -1, 0, w);
    mem.sym_id = R.unwrap_ok[intern.StrId, str](sr);
    ret R.ok[isa.Operand, str](mem);
}

fun const_ref_sym(op: *isa.Operand) intern.StrId {
    if (is_rip_mem(op)) { ret op.sym_id; }
    ret intern.STR_NIL;
}

fun encode_inst_sym(st: *enc.EncodeState, mi: *isa.Inst) R.Result[R.Void, str] {
    val start: usize = st.buf.len;
    val n: i32 = encode_inst(mi, ?st.buf);
    if (n <= 0) {
        ret R.err[R.Void, str]("encode: a constant-pool reference produced no bytes");
    }

    var sym: intern.StrId = const_ref_sym(?mi.dst);
    if (sym == intern.STR_NIL) { sym = const_ref_sym(?mi.src1); }
    if (sym == intern.STR_NIL) { ret R.ok_void[str](); }

    val reloc_off: i32 = x86_reloc_offset(nil, mi, n);
    if (reloc_off < 0) {
        ret R.err[R.Void, str]("encode: a symbol-naming instruction has no relocation patch site");
    }
    ret enc.push_reloc(st, (start + reloc_off::usize)::u32, of.RK_PC32, sym, -(n - reloc_off));
}

fun is_float_const_move(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mi.opcode::u16 != x64.MOV::u16) { ret false; }
    if (mi.operand_count < 2)           { ret false; }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];
    if (src.kind != mir.MIR_OP_IMM)  { ret false; }
    if (dst.kind != mir.MIR_OP_PREG) { ret false; }
    ret isa.regid_class(dst.preg::i32) == isa.REG_CLASS_ID_XMM;
}

fun encode_float_const_mov(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float constant move has a non-float operand width (expected 4 or 8)");
    }
    ret emit_float_load(st, isa.make_imm(mi.operands[1].imm, w),
                        mi.operands[0].preg::i32, w);
}

fun float_work_reg(dst: isa.Operand) i32 {
    if (dst.kind == isa.OPK_REG) { ret dst.reg; }
    ret FLOAT_SCRATCH0;
}

fun emit_float_seed(st: *enc.EncodeState, op: isa.Operand, xmm: i32, w: u8) R.Result[R.Void, str] {
    if (op.kind == isa.OPK_REG && op.reg == xmm) { ret R.ok_void[str](); }
    ret emit_float_load(st, op, xmm, w);
}

fun float_src_operand(st: *enc.EncodeState, op: isa.Operand, scratch: i32, w: u8) R.Result[isa.Operand, str] {
    if (op.kind == isa.OPK_REG || op.kind == isa.OPK_MEM) { ret R.ok[isa.Operand, str](op); }
    if (op.kind == isa.OPK_IMM) {
        val cr: R.Result[isa.Operand, str] = float_const_operand(st, op.imm::u64, scratch, w);
        if (R.is_err[isa.Operand, str](cr)) { ret cr; }
        val c: isa.Operand = R.unwrap_ok[isa.Operand, str](cr);
        if (c.kind == isa.OPK_NONE) { ret R.ok[isa.Operand, str](isa.make_reg(scratch, 16)); }
        ret R.ok[isa.Operand, str](c);
    }

    val ld: R.Result[R.Void, str] = emit_float_load(st, op, scratch, w);
    if (R.is_err[R.Void, str](ld)) { ret R.err[isa.Operand, str](R.unwrap_err[R.Void, str](ld)); }
    ret R.ok[isa.Operand, str](isa.make_reg(scratch, 16));
}

fun float_rhs_operand(st: *enc.EncodeState, rhs: isa.Operand, work: i32, w: u8) R.Result[isa.Operand, str] {
    if (rhs.kind == isa.OPK_REG && rhs.reg == work) {
        val ld: R.Result[R.Void, str] = emit_float_load(st, rhs, FLOAT_SCRATCH1, w);
        if (R.is_err[R.Void, str](ld)) { ret R.err[isa.Operand, str](R.unwrap_err[R.Void, str](ld)); }
        ret R.ok[isa.Operand, str](isa.make_reg(FLOAT_SCRATCH1, 16));
    }
    ret float_src_operand(st, rhs, FLOAT_SCRATCH1, w);
}

fun float_reg_operand(st: *enc.EncodeState, op: isa.Operand, scratch: i32, w: u8) R.Result[i32, str] {
    if (op.kind == isa.OPK_REG) { ret R.ok[i32, str](op.reg); }

    val ld: R.Result[R.Void, str] = emit_float_load(st, op, scratch, w);
    if (R.is_err[R.Void, str](ld)) { ret R.err[i32, str](R.unwrap_err[R.Void, str](ld)); }
    ret R.ok[i32, str](scratch);
}

fun emit_float_store(dst: isa.Operand, xmm: i32, w: u8, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float store has a non-float access width (expected 4 or 8)");
    }
    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }

    if (dst.kind == isa.OPK_MEM) {
        var st: isa.Inst = isa.inst_blank();
        st.opcode = mov_op;
        st.dst    = dst;
        st.src1   = isa.make_reg(xmm, 16);
        st.size   = w;
        encode_inst(?st, buf);
        ret R.ok_void[str]();
    }
    if (dst.kind == isa.OPK_REG) {
        var mv: isa.Inst = isa.inst_blank();
        mv.opcode = mov_op;
        mv.dst    = isa.make_reg(dst.reg, 16);
        mv.src1   = isa.make_reg(xmm, 16);
        mv.size   = w;
        encode_inst(?mv, buf);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: float destination is not a register or frame slot");
}

fun encode_float_arith(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) {
        ret R.err[R.Void, str]("encode: float arithmetic missing operands");
    }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float arithmetic has a non-float operand width (expected 4 or 8)");
    }

    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val rl: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], w);
    if (R.is_err[isa.Operand, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rl)); }
    val lhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rl);
    val rr: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], w);
    if (R.is_err[isa.Operand, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rr)); }
    val rhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rr);

    val work: i32 = float_work_reg(dst);
    val buf: *enc.ByteBuf = ?st.buf;

    val rs: R.Result[isa.Operand, str] = float_rhs_operand(st, rhs, work, w);
    if (R.is_err[isa.Operand, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rs)); }
    val src: isa.Operand = R.unwrap_ok[isa.Operand, str](rs);

    val sd: R.Result[R.Void, str] = emit_float_seed(st, lhs, work, w);
    if (R.is_err[R.Void, str](sd)) { ret sd; }

    var alu: isa.Inst = isa.inst_blank();
    alu.opcode = float_alu_opcode(mi.opcode, w);
    alu.dst    = isa.make_reg(work, 16);
    alu.src1   = src;
    alu.size   = w;
    val ae: R.Result[R.Void, str] = encode_inst_sym(st, ?alu);
    if (R.is_err[R.Void, str](ae)) { ret ae; }

    if (dst.kind == isa.OPK_REG) { ret R.ok_void[str](); }
    ret emit_float_store(dst, work, w, buf);
}

fun float_sign_mask(w: u8) i64 {
    if (w == 4) { ret 0x80000000::i64; }
    ret 0x8000000000000000::i64;
}

fun float_sign_mask_image(w: u8, out: *u8) {
    val m: u64 = float_sign_mask(w)::u64;
    var i: u32 = 0;
    for (i < 16) {
        out[i] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < 8) {
        out[i] = (m >> (i::u64 * 8::u64))::u8;
        i = i + 1;
    }
}

fun encode_float_neg(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) {
        ret R.err[R.Void, str]("encode: float negate missing operands");
    }
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float negate has a non-float operand width (expected 4 or 8)");
    }

    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val rs: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], w);
    if (R.is_err[isa.Operand, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rs)); }
    val src: isa.Operand = R.unwrap_ok[isa.Operand, str](rs);

    val work: i32 = float_work_reg(dst);
    val buf: *enc.ByteBuf = ?st.buf;
    val ld: R.Result[R.Void, str] = emit_float_seed(st, src, work, w);
    if (R.is_err[R.Void, str](ld)) { ret ld; }

    var img: [16]u8;
    float_sign_mask_image(w, ?img[0]);
    val sr: R.Result[intern.StrId, str] = enc.intern_const(st, ?img[0], 16, enc.CONST_VEC);
    if (R.is_err[intern.StrId, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sr)); }

    var mem: isa.Operand = isa.make_mem(-1, 0, -1, 0, 16);
    mem.sym_id = R.unwrap_ok[intern.StrId, str](sr);

    var xorp: isa.Inst = isa.inst_blank();
    xorp.opcode = x64.XORPS;
    xorp.dst    = isa.make_reg(work, 16);
    xorp.src1   = mem;
    xorp.size   = 16;
    val xr: R.Result[R.Void, str] = encode_inst_sym(st, ?xorp);
    if (R.is_err[R.Void, str](xr)) { ret xr; }

    if (dst.kind == isa.OPK_REG) { ret R.ok_void[str](); }
    ret emit_float_store(dst, work, w, buf);
}

fun is_mir_float_conv(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT ||
        op == mir.MIR_FP_TO_SI || op == mir.MIR_FP_TO_UI ||
        op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP;
}

fun emit_gp_store(dst: isa.Operand, gp: i32, w: u8, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (dst.kind == isa.OPK_REG || dst.kind == isa.OPK_MEM) {
        var st: isa.Inst = isa.inst_blank();
        st.opcode = x64.MOV;
        st.dst    = dst;
        st.src1   = isa.make_reg(gp, w);
        st.size   = w;
        st.flags  = width_flags(w);
        encode_inst(?st, buf);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: conversion integer destination is not a register or frame slot");
}

fun emit_cvt_reg(cvt_op: u16, dst_reg: i32, src_reg: i32, int_w: u8, buf: *enc.ByteBuf) {
    var dst_sz: u8 = 16;
    var src_sz: u8 = 16;
    if (cvt_op == x64.CVTSI2SS || cvt_op == x64.CVTSI2SD) { src_sz = int_w; }
    if (cvt_op == x64.CVTTSS2SI || cvt_op == x64.CVTTSD2SI) { dst_sz = int_w; }

    var cvt: isa.Inst = isa.inst_blank();
    cvt.opcode = cvt_op;
    cvt.dst    = isa.make_reg(dst_reg, dst_sz);
    cvt.src1   = isa.make_reg(src_reg, src_sz);
    cvt.size   = int_w;
    cvt.flags  = width_flags(int_w);
    encode_inst(?cvt, buf);
}

fun patch_rel32(buf: *enc.ByteBuf, pos: usize, disp: i32) {
    buf.data[pos]     = (disp & 0xFF)::u8;
    buf.data[pos + 1] = ((disp >> 8) & 0xFF)::u8;
    buf.data[pos + 2] = ((disp >> 16) & 0xFF)::u8;
    buf.data[pos + 3] = ((disp >> 24) & 0xFF)::u8;
}

fun emit_gp_rr8(opcode: u16, dst_reg: i32, src_reg: i32, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa.make_reg(dst_reg, 8);
    mi.src1   = isa.make_reg(src_reg, 8);
    mi.size   = 8;
    mi.flags  = width_flags(8);
    encode_inst(?mi, buf);
}

fun emit_gp_ri8(opcode: u16, dst_reg: i32, imm: i64, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa.make_reg(dst_reg, 8);
    mi.src1   = isa.make_imm(imm, 8);
    mi.size   = 8;
    mi.flags  = width_flags(8);
    encode_inst(?mi, buf);
}

fun emit_fp_rr(opcode: u16, dst_reg: i32, src_reg: i32, w: u8, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa.make_reg(dst_reg, 16);
    mi.src1   = isa.make_reg(src_reg, 16);
    mi.size   = w;
    encode_inst(?mi, buf);
}

fun normalize_int_imm(imm: i64, width: u8, signed: bool) i64 {
    if (width >= 8) { ret imm; }
    val bits: u64 = width::u64 * 8;
    val mask: u64 = (1::u64 << bits) - 1;
    var v: u64 = imm::u64 & mask;
    if (signed) {
        val sign: u64 = 1::u64 << (bits - 1);
        if ((v & sign) != 0) { v = v | ~mask; }
    }
    ret v::i64;
}

fun emit_gp_load_ext(op: isa.Operand, gp: i32, src_w: u8, signed: bool, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (op.kind == isa.OPK_IMM) {
        emit_gp_ri8(x64.MOV, gp, normalize_int_imm(op.imm, src_w, signed), buf);
        ret R.ok_void[str]();
    }
    if (op.kind != isa.OPK_REG && op.kind != isa.OPK_MEM) {
        ret R.err[R.Void, str]("encode: conversion integer operand is not a register, frame slot, or immediate");
    }

    var ld: isa.Inst = isa.inst_blank();
    ld.dst       = isa.make_reg(gp, 8);
    ld.src1      = op;
    ld.src1.size = src_w;
    ld.size      = 8;
    ld.flags     = width_flags(8);
    if (src_w >= 8) {
        ld.opcode = x64.MOV;
    } or (signed && src_w >= 4) {
        ld.opcode = x64.MOVSXD;
    } or (signed) {
        ld.opcode = x64.MOVSX;
    } or {
        ld.opcode = x64.MOVZX;
    }
    encode_inst(?ld, buf);
    ret R.ok_void[str]();
}

fun emit_u64_to_fp(dst: isa.Operand, work: i32, dst_w: u8, cvt_op: u16, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    var test_inst: isa.Inst = isa.inst_blank();
    test_inst.opcode = x64.TEST;
    test_inst.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    test_inst.src1   = isa.make_reg(x64.SCRATCH_REG, 8);
    test_inst.size   = 8;
    test_inst.flags  = width_flags(8);
    encode_inst(?test_inst, buf);

    var jl: isa.Inst = isa.inst_blank();
    jl.opcode = x64.JL;
    jl.dst    = isa.make_label(nil);
    jl.size   = DEFAULT_OPERAND_SIZE;
    encode_inst(?jl, buf);
    val jl_patch: usize = buf.len - 4;
    val after_jl: usize = buf.len;

    emit_cvt_reg(cvt_op, work, x64.SCRATCH_REG, 8, buf);

    var jmp: isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_label(nil);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    encode_inst(?jmp, buf);
    val jmp_patch: usize = buf.len - 4;
    val after_jmp: usize = buf.len;

    patch_rel32(buf, jl_patch, (buf.len - after_jl)::i32);
    emit_gp_rr8(x64.MOV, x64.SCRATCH_REG2, x64.SCRATCH_REG, buf);
    emit_gp_ri8(x64.SHR, x64.SCRATCH_REG2, 1, buf);
    emit_gp_ri8(x64.AND, x64.SCRATCH_REG, 1, buf);
    emit_gp_rr8(x64.OR, x64.SCRATCH_REG, x64.SCRATCH_REG2, buf);
    emit_cvt_reg(cvt_op, work, x64.SCRATCH_REG, 8, buf);
    var add_op: u16 = x64.ADDSD;
    if (dst_w == 4) { add_op = x64.ADDSS; }
    emit_fp_rr(add_op, work, work, dst_w, buf);

    patch_rel32(buf, jmp_patch, (buf.len - after_jmp)::i32);
    if (dst.kind == isa.OPK_REG) { ret R.ok_void[str](); }
    ret emit_float_store(dst, work, dst_w, buf);
}

fun emit_fp_to_u64(st: *enc.EncodeState, src_reg: i32, src_w: u8, cvt_op: u16) R.Result[R.Void, str] {
    val buf: *enc.ByteBuf = ?st.buf;
    var bound_bits: u64 = 0x43E0000000000000;
    if (src_w == 4) { bound_bits = 0x5F000000; }
    val br: R.Result[isa.Operand, str] = float_const_operand(st, bound_bits, FLOAT_SCRATCH1, src_w);
    if (R.is_err[isa.Operand, str](br)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](br)); }
    val bound: isa.Operand = R.unwrap_ok[isa.Operand, str](br);

    var ucom: isa.Inst = isa.inst_blank();
    ucom.opcode = x64.UCOMISD;
    if (src_w == 4) { ucom.opcode = x64.UCOMISS; }
    ucom.dst  = isa.make_reg(src_reg, 16);
    ucom.src1 = bound;
    ucom.size = src_w;
    val ue: R.Result[R.Void, str] = encode_inst_sym(st, ?ucom);
    if (R.is_err[R.Void, str](ue)) { ret ue; }

    var jb: isa.Inst = isa.inst_blank();
    jb.opcode = x64.JB;
    jb.dst    = isa.make_label(nil);
    jb.size   = DEFAULT_OPERAND_SIZE;
    encode_inst(?jb, buf);
    val jb_patch: usize = buf.len - 4;
    val after_jb: usize = buf.len;

    emit_movaps_rr(FLOAT_SCRATCH0, src_reg, buf);
    var sub: isa.Inst = isa.inst_blank();
    sub.opcode = x64.SUBSD;
    if (src_w == 4) { sub.opcode = x64.SUBSS; }
    sub.dst  = isa.make_reg(FLOAT_SCRATCH0, 16);
    sub.src1 = bound;
    sub.size = src_w;
    val se: R.Result[R.Void, str] = encode_inst_sym(st, ?sub);
    if (R.is_err[R.Void, str](se)) { ret se; }
    emit_cvt_reg(cvt_op, x64.SCRATCH_REG, FLOAT_SCRATCH0, 8, buf);
    emit_gp_ri8(x64.MOV, x64.SCRATCH_REG2, (1::u64 << 63)::i64, buf);
    emit_gp_rr8(x64.ADD, x64.SCRATCH_REG, x64.SCRATCH_REG2, buf);

    var jmp: isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_label(nil);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    encode_inst(?jmp, buf);
    val jmp_patch: usize = buf.len - 4;
    val after_jmp: usize = buf.len;

    patch_rel32(buf, jb_patch, (buf.len - after_jb)::i32);
    emit_cvt_reg(cvt_op, x64.SCRATCH_REG, src_reg, 8, buf);

    patch_rel32(buf, jmp_patch, (buf.len - after_jmp)::i32);
    ret R.ok_void[str]();
}

fun encode_float_conv(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 2) {
        ret R.err[R.Void, str]("encode: float conversion missing operands");
    }
    val buf: *enc.ByteBuf = ?st.buf;
    val op: mir.MirOpcode = mi.opcode;
    val dst_w: u8 = mi.width;
    val src_w: u8 = mi.src_width;

    if (op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT) {
        if (!is_float_width(dst_w) || !is_float_width(src_w)) {
            ret R.err[R.Void, str]("internal compiler error: float conversion has a non-float width on a float side (expected 4 or 8)");
        }
        val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
        if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
        val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
        val rs: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], src_w);
        if (R.is_err[isa.Operand, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rs)); }
        val src: isa.Operand = R.unwrap_ok[isa.Operand, str](rs);

        val sr: R.Result[i32, str] = float_reg_operand(st, src, FLOAT_SCRATCH1, src_w);
        if (R.is_err[i32, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](sr)); }
        val src_reg: i32 = R.unwrap_ok[i32, str](sr);
        val work: i32 = float_work_reg(dst);
        var cvt_op: u16 = x64.CVTSD2SS;
        if (op == mir.MIR_FP_EXT) { cvt_op = x64.CVTSS2SD; }
        emit_cvt_reg(cvt_op, work, src_reg, 0, buf);
        if (dst.kind == isa.OPK_REG) { ret R.ok_void[str](); }
        ret emit_float_store(dst, work, dst_w, buf);
    }

    if (op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP) {
        if (!is_float_width(dst_w)) {
            ret R.err[R.Void, str]("internal compiler error: integer-to-float conversion has a non-float result width (expected 4 or 8)");
        }
        val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
        if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
        val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
        val rs: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], src_w);
        if (R.is_err[isa.Operand, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rs)); }
        val src: isa.Operand = R.unwrap_ok[isa.Operand, str](rs);

        val signed: bool = op == mir.MIR_SI_TO_FP;
        val ld: R.Result[R.Void, str] = emit_gp_load_ext(src, x64.SCRATCH_REG, src_w, signed, buf);
        if (R.is_err[R.Void, str](ld)) { ret ld; }
        val work: i32 = float_work_reg(dst);
        var cvt_op: u16 = x64.CVTSI2SD;
        if (dst_w == 4) { cvt_op = x64.CVTSI2SS; }
        if (!signed && src_w >= 8) {
            ret emit_u64_to_fp(dst, work, dst_w, cvt_op, buf);
        }
        emit_cvt_reg(cvt_op, work, x64.SCRATCH_REG, 8, buf);
        if (dst.kind == isa.OPK_REG) { ret R.ok_void[str](); }
        ret emit_float_store(dst, work, dst_w, buf);
    }

    if (!is_float_width(src_w)) {
        ret R.err[R.Void, str]("internal compiler error: float-to-integer conversion has a non-float source width (expected 4 or 8)");
    }
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], dst_w);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val rs: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], 16);
    if (R.is_err[isa.Operand, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rs)); }
    val src: isa.Operand = R.unwrap_ok[isa.Operand, str](rs);

    val sr: R.Result[i32, str] = float_reg_operand(st, src, FLOAT_SCRATCH0, src_w);
    if (R.is_err[i32, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](sr)); }
    val src_reg: i32 = R.unwrap_ok[i32, str](sr);
    var cvt_op: u16 = x64.CVTTSD2SI;
    if (src_w == 4) { cvt_op = x64.CVTTSS2SI; }

    if (op == mir.MIR_FP_TO_UI) {
        if (dst_w >= 8) {
            val fx: R.Result[R.Void, str] = emit_fp_to_u64(st, src_reg, src_w, cvt_op);
            if (R.is_err[R.Void, str](fx)) { ret fx; }
        } or {
            emit_cvt_reg(cvt_op, x64.SCRATCH_REG, src_reg, 8, buf);
        }
        ret emit_gp_store(dst, x64.SCRATCH_REG, dst_w, buf);
    }

    emit_cvt_reg(cvt_op, x64.SCRATCH_REG, src_reg, dst_w, buf);
    ret emit_gp_store(dst, x64.SCRATCH_REG, dst_w, buf);
}

fun emit_movd_movq_reg(gp: i32, xmm: i32, w: u8, gp_to_xmm: bool, buf: *enc.ByteBuf) {
    var mq: isa.Inst = isa.inst_blank();
    mq.opcode = x64.MOVQ;
    mq.size   = w;
    if (gp_to_xmm) {
        mq.dst  = isa.make_reg(xmm, 16);
        mq.src1 = isa.make_reg(gp, w);
    } or {
        mq.dst  = isa.make_reg(gp, w);
        mq.src1 = isa.make_reg(xmm, 16);
    }
    encode_inst(?mq, buf);
}

fun float_cmp_swap(cc: u8) bool {
    ret cc == mir.FCC_LT || cc == mir.FCC_LE;
}

fun float_setcc_opcode(cc: u8) u16 {
    if (cc == mir.FCC_EQ) { ret x64.SETE; }
    if (cc == mir.FCC_NE) { ret x64.SETNE; }
    if (cc == mir.FCC_LT) { ret x64.SETA; }
    if (cc == mir.FCC_LE) { ret x64.SETAE; }
    if (cc == mir.FCC_GT) { ret x64.SETA; }
    ret x64.SETAE;
}

fun encode_float_cmp(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) {
        ret R.err[R.Void, str]("encode: float comparison missing operands");
    }
    val buf: *enc.ByteBuf = ?st.buf;
    val w: u8 = mi.width;
    if (!is_float_width(w)) {
        ret R.err[R.Void, str]("internal compiler error: float comparison has a non-float operand width (expected 4 or 8)");
    }
    val cc: u8 = mi.src_width;

    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], DEFAULT_OPERAND_SIZE);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    if (dst.kind != isa.OPK_REG) {
        ret R.err[R.Void, str]("encode: float comparison destination is not a register");
    }
    val rl: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], w);
    if (R.is_err[isa.Operand, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rl)); }
    val lhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rl);
    val rr: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], w);
    if (R.is_err[isa.Operand, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rr)); }
    val rhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rr);

    var first: isa.Operand  = lhs;
    var second: isa.Operand = rhs;
    if (float_cmp_swap(cc)) {
        first  = rhs;
        second = lhs;
    }

    val fr: R.Result[i32, str] = float_reg_operand(st, first, FLOAT_SCRATCH0, w);
    if (R.is_err[i32, str](fr)) { ret R.err[R.Void, str](R.unwrap_err[i32, str](fr)); }
    val first_reg: i32 = R.unwrap_ok[i32, str](fr);
    val sr: R.Result[isa.Operand, str] = float_src_operand(st, second, FLOAT_SCRATCH1, w);
    if (R.is_err[isa.Operand, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](sr)); }
    val second_op: isa.Operand = R.unwrap_ok[isa.Operand, str](sr);

    var ucom: isa.Inst = isa.inst_blank();
    ucom.opcode = x64.UCOMISD;
    if (w == 4) { ucom.opcode = x64.UCOMISS; }
    ucom.dst  = isa.make_reg(first_reg, 16);
    ucom.src1 = second_op;
    ucom.size = w;
    val ue: R.Result[R.Void, str] = encode_inst_sym(st, ?ucom);
    if (R.is_err[R.Void, str](ue)) { ret ue; }

    var setcc: isa.Inst = isa.inst_blank();
    setcc.opcode   = float_setcc_opcode(cc);
    setcc.dst      = dst;
    setcc.dst.size = 1;
    setcc.size     = 1;
    encode_inst(?setcc, buf);

    if (cc == mir.FCC_EQ || cc == mir.FCC_NE) {
        var par: isa.Inst = isa.inst_blank();
        par.opcode   = x64.SETNP;
        if (cc == mir.FCC_NE) { par.opcode = x64.SETP; }
        par.dst      = isa.make_reg(x64.R11, 1);
        par.dst.size = 1;
        par.size     = 1;
        encode_inst(?par, buf);

        var comb: isa.Inst = isa.inst_blank();
        comb.opcode   = x64.AND;
        if (cc == mir.FCC_NE) { comb.opcode = x64.OR; }
        comb.dst      = dst;
        comb.dst.size = 1;
        comb.src1     = isa.make_reg(x64.R11, 1);
        comb.size     = 1;
        encode_inst(?comb, buf);
    }

    var movzx: isa.Inst = isa.inst_blank();
    movzx.opcode    = x64.MOVZX;
    movzx.dst       = dst;
    movzx.dst.size  = DEFAULT_OPERAND_SIZE;
    movzx.src1      = dst;
    movzx.src1.size = 1;
    movzx.size      = DEFAULT_OPERAND_SIZE;
    movzx.flags     = x64.FLAG_REX_W;
    encode_inst(?movzx, buf);

    ret R.ok_void[str]();
}

fun packed_prefix66(op: u16) bool {
    if (op == x64.ADDPS || op == x64.SUBPS || op == x64.MULPS || op == x64.DIVPS) { ret false; }
    if (op == x64.CMPPS || op == x64.MOVUPS) { ret false; }
    ret true;
}

fun packed_opbyte(op: u16) u8 {
    if (op == x64.ADDPS || op == x64.ADDPD) { ret 0x58; }
    if (op == x64.SUBPS || op == x64.SUBPD) { ret 0x5C; }
    if (op == x64.MULPS || op == x64.MULPD) { ret 0x59; }
    if (op == x64.DIVPS || op == x64.DIVPD) { ret 0x5E; }
    if (op == x64.PADDB)  { ret 0xFC; }
    if (op == x64.PADDW)  { ret 0xFD; }
    if (op == x64.PADDD)  { ret 0xFE; }
    if (op == x64.PADDQ)  { ret 0xD4; }
    if (op == x64.PSUBB)  { ret 0xF8; }
    if (op == x64.PSUBW)  { ret 0xF9; }
    if (op == x64.PSUBD)  { ret 0xFA; }
    if (op == x64.PSUBQ)  { ret 0xFB; }
    if (op == x64.PSUBUSB) { ret 0xD8; }
    if (op == x64.PSUBUSW) { ret 0xD9; }
    if (op == x64.PMULLW) { ret 0xD5; }
    if (op == x64.PAND)   { ret 0xDB; }
    if (op == x64.POR)    { ret 0xEB; }
    if (op == x64.PXOR)   { ret 0xEF; }
    if (op == x64.CMPPS || op == x64.CMPPD) { ret 0xC2; }
    if (op == x64.PCMPEQB) { ret 0x74; }
    if (op == x64.PCMPEQW) { ret 0x75; }
    if (op == x64.PCMPEQD) { ret 0x76; }
    if (op == x64.PCMPGTB) { ret 0x64; }
    if (op == x64.PCMPGTW) { ret 0x65; }
    if (op == x64.PCMPGTD) { ret 0x66; }
    if (op == x64.PSHUFD) { ret 0x70; }
    if (op == x64.PSLLD)  { ret 0x72; }
    panic("encode: unknown packed SSE2 opcode\n");
    ret 0;
}

fun vec_reg(xmm: i32) isa.Operand {
    ret isa.make_reg(xmm, 16);
}

fun note_packed(buf: *enc.ByteBuf, start: usize, opcode: u16, dst: isa.Operand, src: isa.Operand) {
    if (!enc.sink_active(buf)) { ret; }
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = dst;
    mi.src1   = src;
    mi.size   = 16;
    printer.note_inst(buf, ?mi, start);
}

fun note_packed_imm(buf: *enc.ByteBuf, start: usize, opcode: u16, dst: isa.Operand, src: isa.Operand, imm: u8) {
    if (!enc.sink_active(buf)) { ret; }
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = dst;
    mi.src1   = src;
    mi.src2   = isa.make_imm(imm::i64, 1);
    mi.size   = 16;
    printer.note_inst(buf, ?mi, start);
}

fun emit_packed_op(op: u16, dst_xmm: i32, src: isa.Operand, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    val start: usize = buf.len;
    if (packed_prefix66(op)) { enc.emit_byte(buf, 0x66); }
    if (src.kind == isa.OPK_REG) {
        emit_rex_if_needed(buf, 0, dst_xmm, src.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, packed_opbyte(op));
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst_xmm), reg_bits(src.reg)));
        note_packed(buf, start, op, vec_reg(dst_xmm), src);
        ret R.ok_void[str]();
    }
    if (src.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst_xmm, ?src);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, packed_opbyte(op));
        encode_mem_operand(buf, dst_xmm, ?src);
        note_packed(buf, start, op, vec_reg(dst_xmm), src);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: packed vector op source is not a register or aligned frame slot");
}

fun emit_packed_rri(op: u16, dst_xmm: i32, src_xmm: i32, imm: u8, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    if (packed_prefix66(op)) { enc.emit_byte(buf, 0x66); }
    emit_rex_if_needed(buf, 0, dst_xmm, src_xmm);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, packed_opbyte(op));
    enc.emit_byte(buf, encode_modrm(3, reg_bits(dst_xmm), reg_bits(src_xmm)));
    enc.emit_byte(buf, imm);
    note_packed_imm(buf, start, op, vec_reg(dst_xmm), vec_reg(src_xmm), imm);
}

fun emit_packed_shift_imm(op: u16, xmm: i32, imm: u8, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    enc.emit_byte(buf, 0x66);
    if (needs_rex(xmm)) { enc.emit_byte(buf, encode_rex(0, 0, xmm)); }
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, packed_opbyte(op));
    enc.emit_byte(buf, encode_modrm(3, 6, reg_bits(xmm)));
    enc.emit_byte(buf, imm);
    note_packed(buf, start, op, vec_reg(xmm), isa.make_imm(imm::i64, 1));
}

fun emit_movaps_rr(dst_xmm: i32, src_xmm: i32, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    emit_rex_if_needed(buf, 0, dst_xmm, src_xmm);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x28);
    enc.emit_byte(buf, encode_modrm(3, reg_bits(dst_xmm), reg_bits(src_xmm)));
    note_packed(buf, start, x64.MOVAPS, vec_reg(dst_xmm), vec_reg(src_xmm));
}

fun emit_movups_load(xmm: i32, mem: isa.Operand, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    emit_rex_mem(buf, 0, xmm, ?mem);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x10);
    encode_mem_operand(buf, xmm, ?mem);
    note_packed(buf, start, x64.MOVUPS, vec_reg(xmm), mem);
}

fun emit_movups_store(mem: isa.Operand, xmm: i32, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    emit_rex_mem(buf, 0, xmm, ?mem);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x11);
    encode_mem_operand(buf, xmm, ?mem);
    note_packed(buf, start, x64.MOVUPS, mem, vec_reg(xmm));
}

fun emit_vec_load(op: isa.Operand, xmm: i32, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (op.kind == isa.OPK_REG) { emit_movaps_rr(xmm, op.reg, buf); ret R.ok_void[str](); }
    if (op.kind == isa.OPK_MEM) {
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOVAPS;
        ld.dst    = isa.make_reg(xmm, 16);
        ld.src1   = op;
        ld.size   = 16;
        encode_inst(?ld, buf);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: vector operand is not a register or aligned frame slot");
}

fun emit_vec_store(dst: isa.Operand, xmm: i32, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (dst.kind == isa.OPK_REG) { emit_movaps_rr(dst.reg, xmm, buf); ret R.ok_void[str](); }
    if (dst.kind == isa.OPK_MEM) {
        var st: isa.Inst = isa.inst_blank();
        st.opcode = x64.MOVAPS;
        st.dst    = dst;
        st.src1   = isa.make_reg(xmm, 16);
        st.size   = 16;
        encode_inst(?st, buf);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: vector destination is not a register or aligned frame slot");
}

fun emit_vec_all_ones(xmm: i32, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    ret emit_packed_op(x64.PCMPEQD, xmm, vec_reg(xmm), buf);
}

fun emit_vec_zero(xmm: i32, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    ret emit_packed_op(x64.PXOR, xmm, vec_reg(xmm), buf);
}

fun is_selected_vector_alu(o: mir.MirOpcode) bool {
    if (o == mir.MIR_NOT) { ret true; }
    if (o == mir.MIR_SEL_ADD || o == mir.MIR_SEL_SUB || o == mir.MIR_SEL_MUL) { ret true; }
    if (o == mir.MIR_SEL_DIV_S || o == mir.MIR_SEL_DIV_U ||
        o == mir.MIR_SEL_REM_S || o == mir.MIR_SEL_REM_U) { ret true; }
    if (o == mir.MIR_SEL_AND || o == mir.MIR_SEL_OR || o == mir.MIR_SEL_XOR) { ret true; }
    if (o == mir.MIR_SEL_SHL || o == mir.MIR_SEL_SHR_S || o == mir.MIR_SEL_SHR_U) { ret true; }
    if (o == mir.MIR_SEL_CMP_EQ || o == mir.MIR_SEL_CMP_NE ||
        o == mir.MIR_SEL_CMP_LT_S || o == mir.MIR_SEL_CMP_LT_U ||
        o == mir.MIR_SEL_CMP_LE_S || o == mir.MIR_SEL_CMP_LE_U) { ret true; }
    ret false;
}

fun encode_vector_op(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    val o: mir.MirOpcode = mi.opcode;
    if (o == mir.MIR_NOT) { ret encode_vector_not(f, mi, buf); }
    if (o == mir.MIR_SEL_CMP_EQ || o == mir.MIR_SEL_CMP_NE ||
        o == mir.MIR_SEL_CMP_LT_S || o == mir.MIR_SEL_CMP_LT_U ||
        o == mir.MIR_SEL_CMP_LE_S || o == mir.MIR_SEL_CMP_LE_U) { ret encode_vector_compare(f, mi, buf); }
    if (o == mir.MIR_SEL_ADD || o == mir.MIR_SEL_SUB || o == mir.MIR_SEL_MUL ||
        o == mir.MIR_SEL_DIV_S || o == mir.MIR_SEL_DIV_U ||
        o == mir.MIR_SEL_AND || o == mir.MIR_SEL_OR || o == mir.MIR_SEL_XOR) { ret encode_vector_arith(f, mi, buf); }
    ret R.err[R.Void, str]("encode: unsupported vector operation on x86_64 (no packed SSE2 selection)");
}

fun packed_arith_opcode(op: mir.MirOpcode, vec_lane: u32) u16 {
    val is_float: bool = mir.vec_lane_kind(vec_lane) == mir.VEC_LANE_FLOAT;
    val eb:       u8   = mir.vec_lane_elem_bytes(vec_lane);
    if (op == mir.MIR_SEL_AND) { ret x64.PAND; }
    if (op == mir.MIR_SEL_OR)  { ret x64.POR; }
    if (op == mir.MIR_SEL_XOR) { ret x64.PXOR; }
    if (op == mir.MIR_SEL_ADD) {
        if (is_float) { if (eb == 4) { ret x64.ADDPS; } ret x64.ADDPD; }
        if (eb == 1) { ret x64.PADDB; }
        if (eb == 2) { ret x64.PADDW; }
        if (eb == 4) { ret x64.PADDD; }
        ret x64.PADDQ;
    }
    if (op == mir.MIR_SEL_SUB) {
        if (is_float) { if (eb == 4) { ret x64.SUBPS; } ret x64.SUBPD; }
        if (eb == 1) { ret x64.PSUBB; }
        if (eb == 2) { ret x64.PSUBW; }
        if (eb == 4) { ret x64.PSUBD; }
        ret x64.PSUBQ;
    }
    if (op == mir.MIR_SEL_MUL) {
        if (is_float) { if (eb == 4) { ret x64.MULPS; } ret x64.MULPD; }
        if (eb == 2) { ret x64.PMULLW; }
    }
    if (op == mir.MIR_SEL_DIV_U || op == mir.MIR_SEL_DIV_S) {
        if (is_float) { if (eb == 4) { ret x64.DIVPS; } ret x64.DIVPD; }
    }
    ret 0xFFFF;
}

fun encode_vector_arith(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: packed vector op missing operands"); }
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val rl: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], 16);
    if (R.is_err[isa.Operand, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rl)); }
    val rr: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], 16);
    if (R.is_err[isa.Operand, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rr)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val lhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rl);
    val rhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rr);

    val opc: u16 = packed_arith_opcode(mi.opcode, mi.vec_lane);
    if (opc == 0xFFFF) { ret R.err[R.Void, str]("encode: unsupported packed vector op / lane combination"); }

    val ll: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
    if (R.is_err[R.Void, str](ll)) { ret ll; }
    val ro: R.Result[R.Void, str] = emit_packed_op(opc, FLOAT_SCRATCH0, rhs, buf);
    if (R.is_err[R.Void, str](ro)) { ret ro; }
    ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
}

fun encode_vector_not(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 2) { ret R.err[R.Void, str]("encode: packed vector not missing operands"); }
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val rs: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], 16);
    if (R.is_err[isa.Operand, str](rs)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rs)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val src: isa.Operand = R.unwrap_ok[isa.Operand, str](rs);

    val ll: R.Result[R.Void, str] = emit_vec_load(src, FLOAT_SCRATCH0, buf);
    if (R.is_err[R.Void, str](ll)) { ret ll; }
    val ra: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
    if (R.is_err[R.Void, str](ra)) { ret ra; }
    val ro: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
    if (R.is_err[R.Void, str](ro)) { ret ro; }
    ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
}

fun pcmpeq_op(w: u8) u16 {
    if (w == 1) { ret x64.PCMPEQB; }
    if (w == 2) { ret x64.PCMPEQW; }
    ret x64.PCMPEQD;
}

fun pcmpgt_op(w: u8) u16 {
    if (w == 1) { ret x64.PCMPGTB; }
    if (w == 2) { ret x64.PCMPGTW; }
    ret x64.PCMPGTD;
}

fun emit_vcmp_eq_s0(lhs: isa.Operand, rhs: isa.Operand, w: u8, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    val ll: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
    if (R.is_err[R.Void, str](ll)) { ret ll; }
    if (w == 8) {
        val re: R.Result[R.Void, str] = emit_packed_op(x64.PCMPEQD, FLOAT_SCRATCH0, rhs, buf);
        if (R.is_err[R.Void, str](re)) { ret re; }
        emit_packed_rri(x64.PSHUFD, FLOAT_SCRATCH1, FLOAT_SCRATCH0, 0xB1, buf);
        ret emit_packed_op(x64.PAND, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
    }
    ret emit_packed_op(pcmpeq_op(w), FLOAT_SCRATCH0, rhs, buf);
}

fun i64_ordering_setcc(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_CMP_LT_S) { ret x64.SETL; }
    if (op == mir.MIR_SEL_CMP_LE_S) { ret x64.SETLE; }
    if (op == mir.MIR_SEL_CMP_LT_U) { ret x64.SETB; }
    ret x64.SETBE;
}

fun emit_vcmp_i64_lane_mask(setcc: u16, dst_gp: i32, cmp_gp: i32, buf: *enc.ByteBuf) {
    emit_gp_inst(x64.CMP, isa.make_reg(dst_gp, 8), isa.make_reg(cmp_gp, 8), 8, x64.FLAG_REX_W, buf);
    var setb: isa.Inst = isa.inst_blank();
    setb.opcode   = setcc;
    setb.dst      = isa.make_reg(dst_gp, 1);
    setb.dst.size = 1;
    setb.size     = 1;
    encode_inst(?setb, buf);
    var mz: isa.Inst = isa.inst_blank();
    mz.opcode    = x64.MOVZX;
    mz.dst       = isa.make_reg(dst_gp, 8);
    mz.dst.size  = DEFAULT_OPERAND_SIZE;
    mz.src1      = isa.make_reg(dst_gp, 1);
    mz.src1.size = 1;
    mz.size      = DEFAULT_OPERAND_SIZE;
    mz.flags     = x64.FLAG_REX_W;
    encode_inst(?mz, buf);
    emit_gp_inst(x64.NEG, isa.make_reg(dst_gp, 8), isa.make_reg(dst_gp, 8), 8, x64.FLAG_REX_W, buf);
}

fun encode_vcmp_i64_ordering(dst: isa.Operand, lhs: isa.Operand, rhs: isa.Operand, op: mir.MirOpcode, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    val setcc: u16 = i64_ordering_setcc(op);

    val l0: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
    if (R.is_err[R.Void, str](l0)) { ret l0; }
    val l1: R.Result[R.Void, str] = emit_vec_load(rhs, FLOAT_SCRATCH1, buf);
    if (R.is_err[R.Void, str](l1)) { ret l1; }

    emit_gp_inst(x64.MOVQ, isa.make_reg(x64.R10, 8), vec_reg(FLOAT_SCRATCH0), 8, 0, buf);
    emit_gp_inst(x64.MOVQ, isa.make_reg(x64.R11, 8), vec_reg(FLOAT_SCRATCH1), 8, 0, buf);
    emit_vcmp_i64_lane_mask(setcc, x64.R10, x64.R11, buf);

    emit_packed_rri(x64.PSHUFD, FLOAT_SCRATCH0, FLOAT_SCRATCH0, 0x4E, buf);
    emit_packed_rri(x64.PSHUFD, FLOAT_SCRATCH1, FLOAT_SCRATCH1, 0x4E, buf);
    emit_gp_inst(x64.MOVQ, isa.make_reg(x64.R8, 8), vec_reg(FLOAT_SCRATCH0), 8, 0, buf);
    emit_gp_inst(x64.MOVQ, isa.make_reg(x64.R11, 8), vec_reg(FLOAT_SCRATCH1), 8, 0, buf);
    emit_vcmp_i64_lane_mask(setcc, x64.R8, x64.R11, buf);

    emit_gp_inst(x64.MOVQ, vec_reg(FLOAT_SCRATCH0), isa.make_reg(x64.R10, 8), 8, 0, buf);
    emit_gp_inst(x64.MOVQ, vec_reg(FLOAT_SCRATCH1), isa.make_reg(x64.R8, 8), 8, 0, buf);
    emit_packed_rri(x64.PSHUFD, FLOAT_SCRATCH1, FLOAT_SCRATCH1, 0x4E, buf);
    val por: R.Result[R.Void, str] = emit_packed_op(x64.POR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
    if (R.is_err[R.Void, str](por)) { ret por; }

    ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
}

fun emit_gp_inst(opcode: u16, dst: isa.Operand, src: isa.Operand, size: u8, flags: u16, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = dst;
    mi.src1   = src;
    mi.size   = size;
    mi.flags  = flags;
    encode_inst(?mi, buf);
}

fun encode_vector_compare(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 3) { ret R.err[R.Void, str]("encode: packed compare missing operands"); }
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], 16);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val rl: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], 16);
    if (R.is_err[isa.Operand, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rl)); }
    val rr: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], 16);
    if (R.is_err[isa.Operand, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rr)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val lhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rl);
    val rhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rr);
    val op:   mir.MirOpcode = mi.opcode;
    val w:    u8 = mir.vec_lane_elem_bytes(mi.vec_lane);

    if (mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT) {
        var cmpop: u16 = x64.CMPPD;
        if (w == 4) { cmpop = x64.CMPPS; }
        var imm: u8 = 0;
        if (op == mir.MIR_SEL_CMP_NE) { imm = 4; }
        or (op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U) { imm = 1; }
        or (op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U) { imm = 2; }
        val fl: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
        if (R.is_err[R.Void, str](fl)) { ret fl; }
        val fr: R.Result[R.Void, str] = emit_vec_load(rhs, FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](fr)) { ret fr; }
        emit_packed_rri(cmpop, FLOAT_SCRATCH0, FLOAT_SCRATCH1, imm, buf);
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }

    if (op == mir.MIR_SEL_CMP_EQ) {
        val re: R.Result[R.Void, str] = emit_vcmp_eq_s0(lhs, rhs, w, buf);
        if (R.is_err[R.Void, str](re)) { ret re; }
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }
    if (op == mir.MIR_SEL_CMP_NE) {
        val re: R.Result[R.Void, str] = emit_vcmp_eq_s0(lhs, rhs, w, buf);
        if (R.is_err[R.Void, str](re)) { ret re; }
        val ra: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](ra)) { ret ra; }
        val ro: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }

    if (w == 8) { ret encode_vcmp_i64_ordering(dst, lhs, rhs, op, buf); }

    if (op == mir.MIR_SEL_CMP_LT_S) {
        val ld: R.Result[R.Void, str] = emit_vec_load(rhs, FLOAT_SCRATCH0, buf);
        if (R.is_err[R.Void, str](ld)) { ret ld; }
        val ro: R.Result[R.Void, str] = emit_packed_op(pcmpgt_op(w), FLOAT_SCRATCH0, lhs, buf);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }
    if (op == mir.MIR_SEL_CMP_LE_S) {
        val ld: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
        if (R.is_err[R.Void, str](ld)) { ret ld; }
        val ro: R.Result[R.Void, str] = emit_packed_op(pcmpgt_op(w), FLOAT_SCRATCH0, rhs, buf);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        val ra: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](ra)) { ret ra; }
        val rx: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](rx)) { ret rx; }
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }
    if (op == mir.MIR_SEL_CMP_LT_U) {
        if (w == 4) {
            val ra: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            emit_packed_shift_imm(x64.PSLLD, FLOAT_SCRATCH1, 31, buf);
            val ld: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
            if (R.is_err[R.Void, str](ld)) { ret ld; }
            val rx0: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
            if (R.is_err[R.Void, str](rx0)) { ret rx0; }
            val rx1: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH1, rhs, buf);
            if (R.is_err[R.Void, str](rx1)) { ret rx1; }
            val rg: R.Result[R.Void, str] = emit_packed_op(x64.PCMPGTD, FLOAT_SCRATCH1, vec_reg(FLOAT_SCRATCH0), buf);
            if (R.is_err[R.Void, str](rg)) { ret rg; }
            ret emit_vec_store(dst, FLOAT_SCRATCH1, buf);
        }
        val ld: R.Result[R.Void, str] = emit_vec_load(rhs, FLOAT_SCRATCH0, buf);
        if (R.is_err[R.Void, str](ld)) { ret ld; }
        var subus: u16 = x64.PSUBUSW;
        if (w == 1) { subus = x64.PSUBUSB; }
        val rs: R.Result[R.Void, str] = emit_packed_op(subus, FLOAT_SCRATCH0, lhs, buf);
        if (R.is_err[R.Void, str](rs)) { ret rs; }
        val rz: R.Result[R.Void, str] = emit_vec_zero(FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](rz)) { ret rz; }
        val re: R.Result[R.Void, str] = emit_packed_op(pcmpeq_op(w), FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](re)) { ret re; }
        val ra: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](ra)) { ret ra; }
        val rx: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](rx)) { ret rx; }
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }
    if (w == 4) {
        val ra: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](ra)) { ret ra; }
        emit_packed_shift_imm(x64.PSLLD, FLOAT_SCRATCH1, 31, buf);
        val ld: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
        if (R.is_err[R.Void, str](ld)) { ret ld; }
        val rx0: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](rx0)) { ret rx0; }
        val rx1: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH1, rhs, buf);
        if (R.is_err[R.Void, str](rx1)) { ret rx1; }
        val rg: R.Result[R.Void, str] = emit_packed_op(x64.PCMPGTD, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](rg)) { ret rg; }
        val ra2: R.Result[R.Void, str] = emit_vec_all_ones(FLOAT_SCRATCH1, buf);
        if (R.is_err[R.Void, str](ra2)) { ret ra2; }
        val rx2: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
        if (R.is_err[R.Void, str](rx2)) { ret rx2; }
        ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
    }
    val ld: R.Result[R.Void, str] = emit_vec_load(lhs, FLOAT_SCRATCH0, buf);
    if (R.is_err[R.Void, str](ld)) { ret ld; }
    var subus2: u16 = x64.PSUBUSW;
    if (w == 1) { subus2 = x64.PSUBUSB; }
    val rs2: R.Result[R.Void, str] = emit_packed_op(subus2, FLOAT_SCRATCH0, rhs, buf);
    if (R.is_err[R.Void, str](rs2)) { ret rs2; }
    val rz2: R.Result[R.Void, str] = emit_vec_zero(FLOAT_SCRATCH1, buf);
    if (R.is_err[R.Void, str](rz2)) { ret rz2; }
    val re2: R.Result[R.Void, str] = emit_packed_op(pcmpeq_op(w), FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), buf);
    if (R.is_err[R.Void, str](re2)) { ret re2; }
    ret emit_vec_store(dst, FLOAT_SCRATCH0, buf);
}

fun is_mir_divide(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_DIV_S || op == mir.MIR_SEL_DIV_U ||
        op == mir.MIR_SEL_REM_S || op == mir.MIR_SEL_REM_U;
}

fun encode_divide(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 2) {
        ret R.err[R.Void, str]("encode: division missing divisor operand");
    }
    val w: u8 = effective_width(mi.width);
    val signed: bool = mi.opcode == mir.MIR_SEL_DIV_S || mi.opcode == mir.MIR_SEL_REM_S;

    val rdv: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], w);
    if (R.is_err[isa.Operand, str](rdv)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rdv)); }
    val divisor: isa.Operand = R.unwrap_ok[isa.Operand, str](rdv);

    if (signed) {
        var sext_inst: isa.Inst = isa.inst_blank();
        sext_inst.opcode = x64.CDQ;
        if (w == 2) { sext_inst.opcode = x64.CWD; }
        or (w >= 8) { sext_inst.opcode = x64.CQO; }
        sext_inst.size   = w;
        encode_inst(?sext_inst, buf);
    } or {
        var xr: isa.Inst = isa.inst_blank();
        xr.opcode = x64.XOR;
        xr.dst    = isa.make_reg(x64.RDX, 4);
        xr.src1   = isa.make_reg(x64.RDX, 4);
        xr.size   = 4;
        encode_inst(?xr, buf);
    }

    var dv: isa.Inst = isa.inst_blank();
    dv.opcode = x64.DIV;
    if (signed) { dv.opcode = x64.IDIV; }
    dv.src1   = divisor;
    dv.size   = w;
    dv.flags  = width_flags(mi.width);
    encode_inst(?dv, buf);

    ret R.ok_void[str]();
}

fun is_mir_binary(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_ADD || op == mir.MIR_SEL_SUB || op == mir.MIR_SEL_MUL ||
        op == mir.MIR_SEL_AND || op == mir.MIR_SEL_OR  || op == mir.MIR_SEL_XOR;
}

fun mir_binary_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_ADD) { ret x64.ADD; }
    if (op == mir.MIR_SEL_SUB) { ret x64.SUB; }
    if (op == mir.MIR_SEL_MUL) { ret x64.IMUL; }
    if (op == mir.MIR_SEL_AND) { ret x64.AND; }
    if (op == mir.MIR_SEL_OR)  { ret x64.OR; }
    ret x64.XOR;
}

fun encode_binary(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 3) {
        ret R.err[R.Void, str]("encode: binary ALU op missing operands");
    }
    val w: u8 = effective_width(mi.width);
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], w);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val rl: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], w);
    if (R.is_err[isa.Operand, str](rl)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rl)); }
    val lhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rl);
    val rr: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], w);
    if (R.is_err[isa.Operand, str](rr)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rr)); }
    val rhs: isa.Operand = R.unwrap_ok[isa.Operand, str](rr);

    if (dst.kind != isa.OPK_REG) {
        ret R.err[R.Void, str]("encode: binary ALU destination is not a register");
    }

    val skip_mov: bool = lhs.kind == isa.OPK_REG && lhs.reg == dst.reg;
    if (!skip_mov) {
        var mov: isa.Inst = isa.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = lhs;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        encode_inst(?mov, buf);
    }

    var op: isa.Inst = isa.inst_blank();
    op.opcode = mir_binary_opcode(mi.opcode);
    op.dst    = dst;
    op.src1   = rhs;
    op.size   = w;
    op.flags  = width_flags(mi.width);
    encode_inst(?op, buf);
    ret R.ok_void[str]();
}

fun is_mir_shift(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_SHL || op == mir.MIR_SEL_SHR_U || op == mir.MIR_SEL_SHR_S;
}

fun mir_shift_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_SHL)   { ret x64.SHL; }
    if (op == mir.MIR_SEL_SHR_U) { ret x64.SHR; }
    ret x64.SAR;
}

fun encode_shift_mir(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) R.Result[R.Void, str] {
    if (mi.operand_count < 3) {
        ret R.err[R.Void, str]("encode: shift missing value or count operand");
    }
    val w: u8 = effective_width(mi.width);
    val rd: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], w);
    if (R.is_err[isa.Operand, str](rd)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rd)); }
    val dst: isa.Operand = R.unwrap_ok[isa.Operand, str](rd);
    val rv: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], w);
    if (R.is_err[isa.Operand, str](rv)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rv)); }
    val value: isa.Operand = R.unwrap_ok[isa.Operand, str](rv);
    val rc: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], w);
    if (R.is_err[isa.Operand, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rc)); }
    val count: isa.Operand = R.unwrap_ok[isa.Operand, str](rc);

    if (dst.kind != isa.OPK_REG) {
        ret R.err[R.Void, str]("encode: shift destination is not a register");
    }
    if (count.kind == isa.OPK_REG && count.reg != x64.RCX::i32) {
        ret R.err[R.Void, str]("encode: shift count register is not CL");
    }

    val skip_mov: bool = value.kind == isa.OPK_REG && value.reg == dst.reg;
    if (!skip_mov) {
        var mov: isa.Inst = isa.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = value;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        encode_inst(?mov, buf);
    }

    var sh: isa.Inst = isa.inst_blank();
    sh.opcode = mir_shift_opcode(mi.opcode);
    sh.dst    = dst;
    sh.src1   = count;
    sh.size   = w;
    sh.flags  = width_flags(mi.width);
    encode_inst(?sh, buf);
    ret R.ok_void[str]();
}

fun encode_cbr(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 3) {
        ret R.err[R.Void, str]("encode: conditional branch missing operands");
    }
    if (mi.operands[1].kind != mir.MIR_OP_BLOCK || mi.operands[2].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: conditional branch target is not a block");
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;

    val cwidth: u8 = effective_width(mi.width);
    val rc: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], cwidth);
    if (R.is_err[isa.Operand, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](rc)); }
    val cond: isa.Operand = R.unwrap_ok[isa.Operand, str](rc);

    if (cond.kind != isa.OPK_REG) {
        ret R.err[R.Void, str]("encode: conditional branch condition is not a register");
    }

    var test_inst: isa.Inst = isa.inst_blank();
    test_inst.opcode = x64.TEST;
    test_inst.dst    = cond;
    test_inst.src1   = cond;
    test_inst.size   = cwidth;
    test_inst.flags  = width_flags(mi.width);
    encode_inst(?test_inst, ?st.buf);

    val jne_start: usize = st.buf.len;
    var jne: isa.Inst = isa.inst_blank();
    jne.opcode = x64.JNE;
    jne.dst    = isa.make_block_label(then_block);
    jne.size   = DEFAULT_OPERAND_SIZE;
    val jne_size: i32 = encode_inst(?jne, ?st.buf);
    if (jne_size <= 0) { ret R.err[R.Void, str]("encode: conditional branch failed to encode"); }
    val jne_patch: u32 = (jne_start + (jne_size - 4)::usize)::u32;
    val jne_next:  u32 = (jne_start + jne_size::usize)::u32;
    val fj: R.Result[R.Void, str] = enc.push_fixup(st, jne_patch, jne_next, then_block, fn_base);
    if (R.is_err[R.Void, str](fj)) { ret fj; }

    if (enc.branch_falls_through(st, else_block)) { ret R.ok_void[str](); }
    val jmp_start: usize = st.buf.len;
    var jmp: isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_block_label(else_block);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    val jmp_size: i32 = encode_inst(?jmp, ?st.buf);
    if (jmp_size <= 0) { ret R.err[R.Void, str]("encode: conditional branch failed to encode"); }
    val jmp_patch: u32 = (jmp_start + (jmp_size - 4)::usize)::u32;
    val jmp_next:  u32 = (jmp_start + jmp_size::usize)::u32;
    ret enc.push_fixup(st, jmp_patch, jmp_next, else_block, fn_base);
}

fun fused_jcc_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_CBR_EQ)   { ret x64.JE; }
    if (op == mir.MIR_SEL_CBR_NE)   { ret x64.JNE; }
    if (op == mir.MIR_SEL_CBR_LT_S) { ret x64.JL; }
    if (op == mir.MIR_SEL_CBR_LT_U) { ret x64.JB; }
    if (op == mir.MIR_SEL_CBR_LE_S) { ret x64.JLE; }
    ret x64.JBE;
}

fun encode_fused_cbr(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    if (mi.operand_count < 4) {
        ret R.err[R.Void, str]("encode: fused compare-branch missing operands");
    }
    if (mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret R.err[R.Void, str]("encode: fused compare-branch target is not a block");
    }
    val then_block: u32 = mi.operands[2].imm::u32;
    val else_block: u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.len::u32;

    val rc: R.Result[R.Void, str] = emit_flag_cmp(f, ?mi.operands[0], ?mi.operands[1], mi.width, ?st.buf);
    if (R.is_err[R.Void, str](rc)) { ret rc; }

    val jcc_start: usize = st.buf.len;
    var jcc: isa.Inst = isa.inst_blank();
    jcc.opcode = fused_jcc_opcode(mi.opcode);
    jcc.dst    = isa.make_block_label(then_block);
    jcc.size   = DEFAULT_OPERAND_SIZE;
    val jcc_size: i32 = encode_inst(?jcc, ?st.buf);
    if (jcc_size <= 0) { ret R.err[R.Void, str]("encode: fused compare-branch failed to encode"); }
    val jcc_patch: u32 = (jcc_start + (jcc_size - 4)::usize)::u32;
    val jcc_next:  u32 = (jcc_start + jcc_size::usize)::u32;
    val fj: R.Result[R.Void, str] = enc.push_fixup(st, jcc_patch, jcc_next, then_block, fn_base);
    if (R.is_err[R.Void, str](fj)) { ret fj; }

    if (enc.branch_falls_through(st, else_block)) {
        enc.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
        ret R.ok_void[str]();
    }
    val jmp_start: usize = st.buf.len;
    var jmp: isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_block_label(else_block);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    val jmp_size: i32 = encode_inst(?jmp, ?st.buf);
    if (jmp_size <= 0) { ret R.err[R.Void, str]("encode: fused compare-branch failed to encode"); }
    val jmp_patch: u32 = (jmp_start + (jmp_size - 4)::usize)::u32;
    val jmp_next:  u32 = (jmp_start + jmp_size::usize)::u32;
    enc.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
    ret enc.push_fixup(st, jmp_patch, jmp_next, else_block, fn_base);
}

fun concrete_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_MOV)  { ret x64.MOV; }
    if (op == mir.MIR_CALL) { ret x64.CALL; }
    ret op::u16;
}

fun effective_width(width: u8) u8 {
    if (width == 0) { ret DEFAULT_OPERAND_SIZE; }
    ret width;
}

fun width_flags(width: u8) u16 {
    val w: u8 = effective_width(width);
    if (w >= 8) { ret x64.FLAG_REX_W; }
    if (w == 2) { ret x64.FLAG_16BIT; }
    ret 0;
}

fun mir_to_inst(f: *mir.MirFunction, mi: *mir.MirInstr, inst: *isa.Inst) R.Result[R.Void, str] {
    val dwidth: u8 = effective_width(mi.width);
    val swidth: u8 = effective_width(mi.src_width);
    @inst         = isa.inst_blank();
    inst.opcode   = concrete_opcode(mi.opcode);
    inst.size     = dwidth;
    inst.flags    = width_flags(mi.width);

    if (mi.operand_count >= 1) {
        val r: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[0], dwidth);
        if (R.is_err[isa.Operand, str](r)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](r)); }
        inst.dst = R.unwrap_ok[isa.Operand, str](r);
    }
    if (mi.operand_count >= 2) {
        val r: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[1], swidth);
        if (R.is_err[isa.Operand, str](r)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](r)); }
        inst.src1 = R.unwrap_ok[isa.Operand, str](r);
    }
    if (mi.operand_count >= 3) {
        val r: R.Result[isa.Operand, str] = mir_to_operand(f, ?mi.operands[2], swidth);
        if (R.is_err[isa.Operand, str](r)) { ret R.err[R.Void, str](R.unwrap_err[isa.Operand, str](r)); }
        inst.src2 = R.unwrap_ok[isa.Operand, str](r);
    }

    if (mi.operand_count >= 1 &&
        (inst.opcode == x64.CALL::u16 || inst.opcode == x64.JMP::u16) &&
        mi.operands[0].kind != mir.MIR_OP_SYM &&
        mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        inst.flags = inst.flags | x64.FLAG_INDIRECT::u16;
    }
    ret R.ok_void[str]();
}

fun mir_to_operand(f: *mir.MirFunction, op: *mir.MirOperand, width: u8) R.Result[isa.Operand, str] {
    if (op.kind == mir.MIR_OP_PREG) {
        ret R.ok[isa.Operand, str](isa.make_reg(op.preg::i32, width));
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret R.err[isa.Operand, str]("encode: virtual register survived register allocation");
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret R.ok[isa.Operand, str](isa.make_imm(op.imm, width));
    }
    if (op.kind == mir.MIR_OP_MEM) {
        var index: i32 = -1;
        var scale: u8 = 0;
        if (op.index != mir.MIR_VREG_NIL) {
            if (!op.index_is_preg) {
                ret R.err[isa.Operand, str]("encode: value vreg survived in a memory-operand index");
            }
            index = op.index::i32;
            scale = op.scale;
        }
        if (op.vreg != mir.MIR_VREG_NIL) {
            val slot: O.Option[i64] = frame_slot_offset(f, op.vreg);
            if (!O.is_some[i64](slot)) {
                ret R.err[isa.Operand, str]("encode: value vreg survived in a memory-operand base");
            }
            val off: i64 = O.unwrap[i64](slot);
            ret R.ok[isa.Operand, str](
                isa.make_mem(slot_base_reg(f), (off + op.imm)::i32, index, scale, width));
        }
        ret R.ok[isa.Operand, str](
            isa.make_mem(op.preg::i32, op.imm::i32, index, scale, width));
    }
    if (op.kind == mir.MIR_OP_SYM) {
        var sym: isa.Operand = isa.make_mem(-1, 0, -1, 0, width);
        sym.sym_id     = op.sym;
        sym.sym_addend = op.sym_off;
        ret R.ok[isa.Operand, str](sym);
    }
    if (op.kind == mir.MIR_OP_BLOCK) {
        ret R.ok[isa.Operand, str](isa.make_block_label(op.imm::u32));
    }
    ret R.ok[isa.Operand, str](isa.make_none());
}

fun frame_slot_offset(f: *mir.MirFunction, v: u32) O.Option[i64] {
    if (codegen_frame.slots_from_sp(?f.frame)) {
        ret codegen_frame.slot_sp_offset(?f.frame, v);
    }
    ret codegen_frame.slot_offset(?f.frame, v);
}

val X64P_NONE:   u16 = 1;
val X64P_ONE:    u16 = 2;
val X64P_TWO:    u16 = 3;
val X64P_PORTIO: u16 = 8;
val X64P_BRANCH: u16 = 4;
val X64P_XFER:   u16 = 5;

val X64W_MASK:    u16 = 0x3000;
val X64W_UNIFORM: u16 = 0x0000;
val X64W_NARROW:  u16 = 0x1000;
val X64W_FIXED64: u16 = 0x2000;
val X64W_UNSIZED: u16 = 0x3000;

val X64F_LOCK: u16 = 0x0100;

val X64F_INDIRECT: u16 = 0x0200;

val X64_SYSCALL_WRITES: u32 = 0x803;

val X64_EDX_EAX_WRITES: u32 = 0x5;
val X64_RAX_WRITE: u32 = 0x1;

val X64_ALL_GP: u32 = 0xFFFF;
val X64_ALL_FP: u32 = 0xFFFF;

fun x64_pattern(flags: u16) u16 { ret flags & 0x00FF; }

fun x64_width_class(flags: u16) u16 { ret flags & X64W_MASK; }

val X64_MNEMONIC_COUNT: usize = 60;

val X64_MNEMONICS: [X64_MNEMONIC_COUNT]iasm.Mnemonic = [X64_MNEMONIC_COUNT]iasm.Mnemonic{
    iasm.Mnemonic{ name: "syscall", code: x64.SYSCALL::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: X64_SYSCALL_WRITES, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "ret",     code: x64.RET::u32,     form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "hlt",     code: x64.HLT::u32,     form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "cli",     code: x64.CLI::u32,     form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "sti",     code: x64.STI::u32,     form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "rdtsc",   code: x64.RDTSC::u32,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: X64_EDX_EAX_WRITES, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "rdmsr",   code: x64.RDMSR::u32,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: X64_EDX_EAX_WRITES, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "wrmsr",   code: x64.WRMSR::u32,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "lidt",    code: x64.LIDT::u32,    form: iasm.AF_OPS,  writes: iasm.AW_NONE, implicit: 0, flags: X64P_ONE | X64W_UNSIZED,  words: 0 },
    iasm.Mnemonic{ name: "in",      code: x64.IN::u32,      form: iasm.AF_OPS,  writes: iasm.AW_OP0,  implicit: 0, flags: X64P_PORTIO | X64W_UNSIZED, words: 0 },
    iasm.Mnemonic{ name: "out",     code: x64.OUT::u32,     form: iasm.AF_OPS,  writes: iasm.AW_NONE, implicit: 0, flags: X64P_PORTIO | X64W_UNSIZED, words: 0 },
    iasm.Mnemonic{ name: "mfence",  code: x64.MFENCE::u32,  form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "pause",   code: x64.PAUSE::u32,   form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "nop",     code: x64.NOP::u32,     form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },

    iasm.Mnemonic{ name: "cld",    code: x64.CLD::u32,    form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "pushfq", code: x64.PUSHFQ::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0, implicit_mem: true },
    iasm.Mnemonic{ name: "popfq",  code: x64.POPFQ::u32,  form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0, implicit_mem: true },
    iasm.Mnemonic{ name: "swapgs", code: x64.SWAPGS::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },
    iasm.Mnemonic{ name: "iretq",  code: x64.IRETQ::u32,  form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0 },

    iasm.Mnemonic{ name: "call", code: x64.CALL::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_XFER | X64W_FIXED64, words: 0 },
    iasm.Mnemonic{ name: "jmp",  code: x64.JMP::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_XFER | X64W_FIXED64, words: 0 },
    iasm.Mnemonic{ name: "je",   code: x64.JE::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jz",   code: x64.JE::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jne",  code: x64.JNE::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jnz",  code: x64.JNE::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jc",   code: x64.JB::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jb",   code: x64.JB::u32,   form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jnc",  code: x64.JAE::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jae",  code: x64.JAE::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },
    iasm.Mnemonic{ name: "jnb",  code: x64.JAE::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0 },

    iasm.Mnemonic{ name: "setc",  code: x64.SETB::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "setb",  code: x64.SETB::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "setnc", code: x64.SETAE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "setae", code: x64.SETAE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "setnb", code: x64.SETAE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0 },

    iasm.Mnemonic{ name: "lock cmpxchg", code: x64.CMPXCHG::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,                 implicit: X64_RAX_WRITE, flags: X64P_TWO | X64F_LOCK, words: 0 },
    iasm.Mnemonic{ name: "lock xadd",    code: x64.XADD::u32,    form: iasm.AF_OPS, writes: iasm.AW_OP0 | iasm.AW_OP1,   implicit: 0,             flags: X64P_TWO | X64F_LOCK, words: 0 },
    iasm.Mnemonic{ name: "cmpxchg",      code: x64.CMPXCHG::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0,                 implicit: X64_RAX_WRITE, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "xadd",         code: x64.XADD::u32,    form: iasm.AF_OPS, writes: iasm.AW_OP0 | iasm.AW_OP1,   implicit: 0,             flags: X64P_TWO, words: 0 },

    iasm.Mnemonic{ name: "movzx", code: x64.MOVZX::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO | X64W_NARROW, words: 0 },
    iasm.Mnemonic{ name: "movsx", code: x64.MOVSX::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO | X64W_NARROW, words: 0 },
    iasm.Mnemonic{ name: "mov",   code: x64.MOV::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "lea",   code: x64.LEA::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "add",   code: x64.ADD::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "sub",   code: x64.SUB::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "and",   code: x64.AND::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "or",    code: x64.OR::u32,    form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "xor",   code: x64.XOR::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "shl",   code: x64.SHL::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "shr",   code: x64.SHR::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "sar",   code: x64.SAR::u32,   form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_TWO, words: 0 },

    iasm.Mnemonic{ name: "cmp",  code: x64.CMP::u32,  form: iasm.AF_OPS, writes: iasm.AW_NONE,               implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "test", code: x64.TEST::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE,               implicit: 0, flags: X64P_TWO, words: 0 },
    iasm.Mnemonic{ name: "xchg", code: x64.XCHG::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0 | iasm.AW_OP1,  implicit: 0, flags: X64P_TWO, words: 0 },

    iasm.Mnemonic{ name: "neg",  code: x64.NEG::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "not",  code: x64.NOT::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "inc",  code: x64.INC::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "dec",  code: x64.DEC::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: X64P_ONE, words: 0 },
    iasm.Mnemonic{ name: "push", code: x64.PUSH::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_ONE | X64W_FIXED64, words: 0, implicit_mem: true },
    iasm.Mnemonic{ name: "pop",  code: x64.POP::u32,  form: iasm.AF_OPS, writes: iasm.AW_OP0,  implicit: 0, flags: X64P_ONE | X64W_FIXED64, words: 0, implicit_mem: true },
};

fun x64_reg_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "rax")) { @op = iasm.op_reg(x64.RAX, 8); ret true; }
    if (str_region_equals(body, lo, len, "rbx")) { @op = iasm.op_reg(x64.RBX, 8); ret true; }
    if (str_region_equals(body, lo, len, "rcx")) { @op = iasm.op_reg(x64.RCX, 8); ret true; }
    if (str_region_equals(body, lo, len, "rdx")) { @op = iasm.op_reg(x64.RDX, 8); ret true; }
    if (str_region_equals(body, lo, len, "rsi")) { @op = iasm.op_reg(x64.RSI, 8); ret true; }
    if (str_region_equals(body, lo, len, "rdi")) { @op = iasm.op_reg(x64.RDI, 8); ret true; }
    if (str_region_equals(body, lo, len, "rbp")) { @op = iasm.op_reg(x64.RBP, 8); ret true; }
    if (str_region_equals(body, lo, len, "rsp")) { @op = iasm.op_reg(x64.RSP, 8); ret true; }
    if (str_region_equals(body, lo, len, "r8"))  { @op = iasm.op_reg(x64.R8,  8); ret true; }
    if (str_region_equals(body, lo, len, "r9"))  { @op = iasm.op_reg(x64.R9,  8); ret true; }
    if (str_region_equals(body, lo, len, "r10")) { @op = iasm.op_reg(x64.R10, 8); ret true; }
    if (str_region_equals(body, lo, len, "r11")) { @op = iasm.op_reg(x64.R11, 8); ret true; }
    if (str_region_equals(body, lo, len, "r12")) { @op = iasm.op_reg(x64.R12, 8); ret true; }
    if (str_region_equals(body, lo, len, "r13")) { @op = iasm.op_reg(x64.R13, 8); ret true; }
    if (str_region_equals(body, lo, len, "r14")) { @op = iasm.op_reg(x64.R14, 8); ret true; }
    if (str_region_equals(body, lo, len, "r15")) { @op = iasm.op_reg(x64.R15, 8); ret true; }
    if (str_region_equals(body, lo, len, "eax"))  { @op = iasm.op_reg(x64.RAX, 4); ret true; }
    if (str_region_equals(body, lo, len, "ebx"))  { @op = iasm.op_reg(x64.RBX, 4); ret true; }
    if (str_region_equals(body, lo, len, "ecx"))  { @op = iasm.op_reg(x64.RCX, 4); ret true; }
    if (str_region_equals(body, lo, len, "edx"))  { @op = iasm.op_reg(x64.RDX, 4); ret true; }
    if (str_region_equals(body, lo, len, "esi"))  { @op = iasm.op_reg(x64.RSI, 4); ret true; }
    if (str_region_equals(body, lo, len, "edi"))  { @op = iasm.op_reg(x64.RDI, 4); ret true; }
    if (str_region_equals(body, lo, len, "ebp"))  { @op = iasm.op_reg(x64.RBP, 4); ret true; }
    if (str_region_equals(body, lo, len, "esp"))  { @op = iasm.op_reg(x64.RSP, 4); ret true; }
    if (str_region_equals(body, lo, len, "r8d"))  { @op = iasm.op_reg(x64.R8,  4); ret true; }
    if (str_region_equals(body, lo, len, "r9d"))  { @op = iasm.op_reg(x64.R9,  4); ret true; }
    if (str_region_equals(body, lo, len, "r10d")) { @op = iasm.op_reg(x64.R10, 4); ret true; }
    if (str_region_equals(body, lo, len, "r11d")) { @op = iasm.op_reg(x64.R11, 4); ret true; }
    if (str_region_equals(body, lo, len, "r12d")) { @op = iasm.op_reg(x64.R12, 4); ret true; }
    if (str_region_equals(body, lo, len, "r13d")) { @op = iasm.op_reg(x64.R13, 4); ret true; }
    if (str_region_equals(body, lo, len, "r14d")) { @op = iasm.op_reg(x64.R14, 4); ret true; }
    if (str_region_equals(body, lo, len, "r15d")) { @op = iasm.op_reg(x64.R15, 4); ret true; }
    if (str_region_equals(body, lo, len, "ax")) { @op = iasm.op_reg(x64.RAX, 2); ret true; }
    if (str_region_equals(body, lo, len, "bx")) { @op = iasm.op_reg(x64.RBX, 2); ret true; }
    if (str_region_equals(body, lo, len, "cx")) { @op = iasm.op_reg(x64.RCX, 2); ret true; }
    if (str_region_equals(body, lo, len, "dx")) { @op = iasm.op_reg(x64.RDX, 2); ret true; }
    if (str_region_equals(body, lo, len, "si")) { @op = iasm.op_reg(x64.RSI, 2); ret true; }
    if (str_region_equals(body, lo, len, "di")) { @op = iasm.op_reg(x64.RDI, 2); ret true; }
    if (str_region_equals(body, lo, len, "bp")) { @op = iasm.op_reg(x64.RBP, 2); ret true; }
    if (str_region_equals(body, lo, len, "sp")) { @op = iasm.op_reg(x64.RSP, 2); ret true; }
    if (str_region_equals(body, lo, len, "al"))   { @op = iasm.op_reg(x64.RAX, 1); ret true; }
    if (str_region_equals(body, lo, len, "bl"))   { @op = iasm.op_reg(x64.RBX, 1); ret true; }
    if (str_region_equals(body, lo, len, "cl"))   { @op = iasm.op_reg(x64.RCX, 1); ret true; }
    if (str_region_equals(body, lo, len, "dl"))   { @op = iasm.op_reg(x64.RDX, 1); ret true; }
    if (str_region_equals(body, lo, len, "sil"))  { @op = iasm.op_reg(x64.RSI, 1); ret true; }
    if (str_region_equals(body, lo, len, "dil"))  { @op = iasm.op_reg(x64.RDI, 1); ret true; }
    if (str_region_equals(body, lo, len, "bpl"))  { @op = iasm.op_reg(x64.RBP, 1); ret true; }
    if (str_region_equals(body, lo, len, "spl"))  { @op = iasm.op_reg(x64.RSP, 1); ret true; }
    if (str_region_equals(body, lo, len, "r8b"))  { @op = iasm.op_reg(x64.R8,  1); ret true; }
    if (str_region_equals(body, lo, len, "r9b"))  { @op = iasm.op_reg(x64.R9,  1); ret true; }
    if (str_region_equals(body, lo, len, "r10b")) { @op = iasm.op_reg(x64.R10, 1); ret true; }
    if (str_region_equals(body, lo, len, "r11b")) { @op = iasm.op_reg(x64.R11, 1); ret true; }
    if (str_region_equals(body, lo, len, "r12b")) { @op = iasm.op_reg(x64.R12, 1); ret true; }
    if (str_region_equals(body, lo, len, "r13b")) { @op = iasm.op_reg(x64.R13, 1); ret true; }
    if (str_region_equals(body, lo, len, "r14b")) { @op = iasm.op_reg(x64.R14, 1); ret true; }
    if (str_region_equals(body, lo, len, "r15b")) { @op = iasm.op_reg(x64.R15, 1); ret true; }
    ret false;
}

fun x64_reg(name: str, op: *iasm.Operand) bool {
    ret x64_reg_region(name, 0, str_len(name), op);
}

fun x64_ctlreg(name: str, num: *i64) bool {
    if (str_equals(name, "cr0")) { @num = 0; ret true; }
    if (str_equals(name, "cr2")) { @num = 2; ret true; }
    if (str_equals(name, "cr3")) { @num = 3; ret true; }
    if (str_equals(name, "cr4")) { @num = 4; ret true; }
    if (str_equals(name, "cr8")) { @num = 8; ret true; }
    ret false;
}

fun x64_segreg(name: str, num: *i64) bool {
    if (str_equals(name, "es")) { @num = 0; ret true; }
    if (str_equals(name, "cs")) { @num = 1; ret true; }
    if (str_equals(name, "ss")) { @num = 2; ret true; }
    if (str_equals(name, "ds")) { @num = 3; ret true; }
    if (str_equals(name, "fs")) { @num = 4; ret true; }
    if (str_equals(name, "gs")) { @num = 5; ret true; }
    ret false;
}

fun x64_size_keyword(body: str, lo: usize, hi: usize, rest: *usize) u8 {
    var width: u8 = 0;
    var len: usize = 0;
    if (lo + 4 < hi && str_region_equals(body, lo, 4, "byte"))  { width = 1; len = 4; }
    or (lo + 4 < hi && str_region_equals(body, lo, 4, "word"))  { width = 2; len = 4; }
    or (lo + 5 < hi && str_region_equals(body, lo, 5, "dword")) { width = 4; len = 5; }
    or (lo + 5 < hi && str_region_equals(body, lo, 5, "qword")) { width = 8; len = 5; }
    or { ret 0; }
    if (!iasm.is_space(body[lo + len])) { ret 0; }
    var i: usize = lo + len;
    for (i < hi && iasm.is_space(body[i])) { i = i + 1; }
    @rest = i;
    ret width;
}

fun x64_operand(c: *iasm.Cursor, lo: usize, hi: usize, role: str, op: *iasm.Operand) R.Result[R.Void, str] {
    @op = iasm.op_none();
    if (hi <= lo) { ret R.err[R.Void, str]("encode: malformed inline-asm operand"); }

    var rest: usize = lo;
    val width: u8 = x64_size_keyword(c.body, lo, hi, ?rest);
    if (width != 0) {
        if (!(hi - rest >= 3 && c.body[rest] == '['::char && c.body[hi - 1] == ']'::char)) {
            ret R.err[R.Void, str](iasm.span_message(c,
                "encode: inline-asm operand-size prefix on '", lo, hi,
                "' may only precede a memory operand",
                "encode: an inline-asm operand-size prefix may only precede a memory operand"));
        }
        val mr: R.Result[R.Void, str] = x64_mem(c, rest, hi, role, op);
        if (R.is_err[R.Void, str](mr)) { ret mr; }
        op.size = width;
        ret R.ok_void[str]();
    }

    if (c.body[lo] == '{'::char) {
        var off: i64 = 0;
        val bound_r: R.Result[bool, str] = iasm.bind_offset(c, lo, hi, ?off);
        if (R.is_err[bool, str](bound_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](bound_r)); }
        if (R.unwrap_ok[bool, str](bound_r)) {
            @op = iasm.op_mem(slot_base_reg(c.f), off, -1, 0, 0);
            ret R.ok_void[str]();
        }
        op.kind     = iasm.AOP_BIND;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret R.ok_void[str]();
    }

    if (x64_reg_region(c.body, lo, hi, op)) { ret R.ok_void[str](); }

    if (hi - lo >= 3 && c.body[lo] == '['::char && c.body[hi - 1] == ']'::char) {
        ret x64_mem(c, lo, hi, role, op);
    }

    val iv: O.Option[i64] = iasm.region_i64(c.body, lo, hi);
    if (O.is_some[i64](iv)) { @op = iasm.op_imm(O.unwrap[i64](iv), 8); ret R.ok_void[str](); }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret R.ok_void[str]();
    }
    ret R.err[R.Void, str]("encode: malformed inline-asm operand");
}

fun x64_mem(c: *iasm.Cursor, lo: usize, hi: usize, role: str, op: *iasm.Operand) R.Result[R.Void, str] {
    @op = iasm.op_none();
    op.kind = iasm.AOP_MEM;

    val inner_lo: usize = lo + 1;
    val inner_hi: usize = hi - 1;

    var q: usize = inner_lo;
    for (q < inner_hi) {
        if (c.body[q] == '{'::char) { ret R.err[R.Void, str](x64_bind_base_message(c, role)); }
        q = q + 1;
    }

    var star: usize = 0;
    var has_star: bool = false;
    var s: usize = inner_lo;
    for (s < inner_hi) {
        if (c.body[s] == '*'::char) { star = s; has_star = true; }
        s = s + 1;
    }

    var sep: usize = inner_hi;
    var has_sep: bool = false;
    var neg: bool = false;
    var search_from: usize = inner_lo + 1;
    if (has_star) { search_from = star + 1; }
    var r: usize = inner_hi;
    for (r > search_from && !has_sep) {
        r = r - 1;
        if (c.body[r] == '+'::char) { sep = r; has_sep = true; neg = false; }
        or (c.body[r] == '-'::char) { sep = r; has_sep = true; neg = true; }
    }

    var bi_hi: usize = inner_hi;
    if (has_sep) { bi_hi = sep; }

    var buf: [32]u8;
    if (has_star) {
        var bplus: usize = star;
        var found_bplus: bool = false;
        var k: usize = star;
        for (k > inner_lo && !found_bplus) {
            k = k - 1;
            if (c.body[k] == '+'::char) { bplus = k; found_bplus = true; }
        }
        if (!found_bplus) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }

        if (!iasm.copy_region(c.body, inner_lo, bplus, ?buf[0], 32)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        var base_op: iasm.Operand = iasm.op_none();
        if (!x64_reg((?buf[0])::str, ?base_op)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        op.reg = base_op.reg;

        if (!iasm.copy_region(c.body, bplus + 1, star, ?buf[0], 32)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        var idx_op: iasm.Operand = iasm.op_none();
        if (!x64_reg((?buf[0])::str, ?idx_op)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        if (idx_op.reg == x64.RSP) {
            ret R.err[R.Void, str]("encode: rsp cannot be used as an inline-asm memory index register");
        }
        op.index = idx_op.reg;

        val sv: O.Option[i64] = iasm.region_i64(c.body, star + 1, bi_hi);
        if (!O.is_some[i64](sv)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        val scale_val: i64 = O.unwrap[i64](sv);
        if (scale_val != 1 && scale_val != 2 && scale_val != 4 && scale_val != 8) {
            ret R.err[R.Void, str]("encode: inline-asm memory index scale must be 1, 2, 4 or 8");
        }
        op.scale = scale_val::u8;
    } or {
        var a: usize = inner_lo;
        var b: usize = bi_hi;
        for (a < b && iasm.is_space(c.body[a])) { a = a + 1; }
        for (b > a && iasm.is_space(c.body[b - 1])) { b = b - 1; }

        var base_op: iasm.Operand = iasm.op_none();
        if (x64_reg_region(c.body, a, b, ?base_op)) {
            op.reg = base_op.reg;
        } or {
            val av: O.Option[i64] = iasm.region_i64(c.body, a, b);
            if (O.is_some[i64](av)) {
                if (has_sep) { ret R.err[R.Void, str]("encode: inline-asm absolute memory address takes no displacement term"); }
                val addr: i64 = O.unwrap[i64](av);
                if (addr < -2147483648 || addr > 2147483647) {
                    ret R.err[R.Void, str]("encode: inline-asm absolute memory address does not fit a signed 32-bit displacement");
                }
                op.flags = iasm.AOF_MEM_ABS;
                op.reg   = -1;
                op.imm   = addr;
                ret R.ok_void[str]();
            }

            if (has_sep) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
            if (!iasm.is_sym_region(c.body, a, b)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
            op.flags    = iasm.AOF_MEM_SYM;
            op.reg      = -1;
            op.name_off = a;
            op.name_len = b - a;
        }
    }

    if (has_sep) {
        val dv: O.Option[i64] = iasm.region_i64(c.body, sep + 1, inner_hi);
        if (!O.is_some[i64](dv)) { ret R.err[R.Void, str]("encode: malformed inline-asm memory operand"); }
        var disp: i64 = O.unwrap[i64](dv);
        if (neg) { disp = -disp; }
        if (disp < -2147483648 || disp > 2147483647) {
            ret R.err[R.Void, str]("encode: inline-asm memory displacement does not fit a signed 32-bit displacement");
        }
        op.imm   = disp;
        op.flags = op.flags | iasm.AOF_HAS_DISP;
    }
    ret R.ok_void[str]();
}

fun x64_bind_base_message(c: *iasm.Cursor, role: str) str {
    if (c.interner == nil) {
        ret "encode: inline-asm stack-slot binding cannot be used inside a memory operand; load it into a register first";
    }
    ret iasm.named_message(c.alloc, c.interner,
        "encode: inline-asm ", role,
        "operand uses a stack-slot binding inside a memory operand ([{name}]); load it into a register first",
        "encode: inline-asm stack-slot binding cannot be used inside a memory operand; load it into a register first");
}

fun x64_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val pat: u16 = x64_pattern(s.m.flags);
    val n: u32 = s.nargs;

    if (pat == X64P_NONE) {
        if (n != 0) { ret R.err[R.Void, str]("encode: inline-asm instruction takes no operands"); }
        ret R.ok_void[str]();
    }
    if (pat == X64P_BRANCH) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm branch expects one target"); }
        ret x64_branch_target(c, s, item);
    }
    if (pat == X64P_XFER) {
        if (n != 1) {
            ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm '", "' expects one target",
                "encode: an inline-asm control transfer expects one target"));
        }
        ret x64_xfer_target(c, s, item);
    }

    if (s.m.code == x64.MOV::u32 && n == 2) {
        val matched_r: R.Result[bool, str] = x64_mov_sysreg(c, s, item);
        if (R.is_err[bool, str](matched_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](matched_r)); }
        if (R.unwrap_ok[bool, str](matched_r)) { ret R.ok_void[str](); }
    }

    var i: u32 = 0;
    for (i < n) {
        var role: str = "";
        if (pat == X64P_TWO && i == 0) { role = "destination "; }
        or (pat == X64P_TWO)           { role = "source "; }
        val r: R.Result[R.Void, str] = x64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }

    if (pat == X64P_ONE) {
        if (n != 1) { ret R.err[R.Void, str]("encode: inline-asm instruction expects one operand"); }
        val op: *iasm.Operand = ?item.ops[0];
        if (op.kind == iasm.AOP_SYM || (op.kind == iasm.AOP_MEM && (op.flags & iasm.AOF_MEM_SYM) != 0)) {
            ret R.err[R.Void, str]("encode: inline-asm one-operand symbol form unsupported");
        }
        ret x64_check_widths(c, s, item);
    }

    if (n != 2) {
        ret R.err[R.Void, str](iasm.span_message(c,
            "encode: malformed inline-asm two-operand instruction '", s.lo, s.hi, "'",
            "encode: malformed inline-asm two-operand instruction"));
    }
    if (item.ops[0].kind == iasm.AOP_SYM || item.ops[1].kind == iasm.AOP_SYM) {
        ret R.err[R.Void, str]("encode: inline-asm bare-symbol operand unsupported (use [symbol])");
    }
    if ((item.ops[0].flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = item.ops[0].name_off;
        item.ref_len = item.ops[0].name_len;
    }
    or ((item.ops[1].flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = item.ops[1].name_off;
        item.ref_len = item.ops[1].name_len;
    }
    ret x64_check_widths(c, s, item);
}

fun x64_check_widths(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val cls: u16 = x64_width_class(s.m.flags);

    if (cls == X64W_UNSIZED) {
        if (x64_sized_operand(item) != 0) {
            ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
                "' takes no operand-size prefix: its memory operand names no scalar width",
                "encode: an inline-asm instruction takes no operand-size prefix: its memory operand names no scalar width"));
        }
        ret R.ok_void[str]();
    }

    if (cls == X64W_FIXED64) {
        val w: u8 = x64_sized_operand(item);
        if (w != 0 && w != 8) {
            ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
                "' has a fixed 64-bit operand size in long mode, so a narrower operand-size prefix names no instruction",
                "encode: an inline-asm instruction has a fixed 64-bit operand size in long mode, so a narrower operand-size prefix names no instruction"));
        }
        ret R.ok_void[str]();
    }

    if (cls == X64W_NARROW) { ret x64_check_narrow(c, s, item); }

    val rw: u8 = x64_register_width(item);
    if (rw == 0) { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < item.nops) {
        val w: u8 = item.ops[i::usize].size;
        if (item.ops[i::usize].kind == iasm.AOP_MEM && w != 0 && w != rw) {
            ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
                "' names an operand-size prefix that contradicts the width its register operand states",
                "encode: an inline-asm instruction names an operand-size prefix that contradicts the width its register operand states"));
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun x64_check_narrow(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val dst: *iasm.Operand = ?item.ops[0];
    val src: *iasm.Operand = ?item.ops[1];
    if (dst.kind != iasm.AOP_REG) {
        ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
            "' must extend into a register destination",
            "encode: an inline-asm extending move must extend into a register destination"));
    }
    if (src.kind == iasm.AOP_MEM && src.size == 0) {
        ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
            "' does not state the width of its memory source; write it as `byte [...]`, `word [...]` or `dword [...]`",
            "encode: an inline-asm extending move does not state the width of its memory source; write it as `byte [...]`, `word [...]` or `dword [...]`"));
    }
    val sw: u8 = src.size;
    if (sw == 0) { ret R.ok_void[str](); }
    if (sw >= dst.size) {
        ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
            "' names a source at least as wide as its destination, which extends nothing",
            "encode: an inline-asm extending move names a source at least as wide as its destination, which extends nothing"));
    }
    if (s.m.code == x64.MOVZX::u32 && sw != 1 && sw != 2) {
        ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm instruction '",
            "' has no 32-bit source form; a 32-bit move already zero-extends, so write `mov` instead",
            "encode: inline-asm `movzx` has no 32-bit source form; a 32-bit move already zero-extends, so write `mov` instead"));
    }
    ret R.ok_void[str]();
}

fun x64_sized_operand(item: *iasm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        val op: *iasm.Operand = ?item.ops[i::usize];
        if (op.kind == iasm.AOP_MEM && op.size != 0) { ret op.size; }
        i = i + 1;
    }
    ret 0;
}

fun x64_register_width(item: *iasm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        if (item.ops[i::usize].kind == iasm.AOP_REG) { ret item.ops[i::usize].size; }
        i = i + 1;
    }
    ret 0;
}

fun x64_named_message(c: *iasm.Cursor, s: *iasm.Stmt, prefix: str, suffix: str, fallback: str) str {
    ret iasm.named_message(c.alloc, c.interner, prefix, s.m.name, suffix, fallback);
}

fun x64_mov_sysreg(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[bool, str] {
    var dbuf: [32]u8;
    var sbuf: [32]u8;
    if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?dbuf[0], 32)) { ret R.ok[bool, str](false); }
    if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?sbuf[0], 32)) { ret R.ok[bool, str](false); }
    val dtok: str = (?dbuf[0])::str;
    val stok: str = (?sbuf[0])::str;

    var dnum: i64 = 0;
    var snum: i64 = 0;
    val dst_cr:  bool = x64_ctlreg(dtok, ?dnum);
    val src_cr:  bool = x64_ctlreg(stok, ?snum);
    val dst_seg: bool = x64_segreg(dtok, ?dnum);
    val src_seg: bool = x64_segreg(stok, ?snum);
    if (!dst_cr && !src_cr && !dst_seg && !src_seg) { ret R.ok[bool, str](false); }
    if ((dst_cr || dst_seg) && (src_cr || src_seg)) {
        ret R.err[bool, str]("encode: inline-asm `mov` cannot move between two system registers; go through a general-purpose register");
    }

    if (dst_seg) {
        ret R.err[bool, str]("encode: inline-asm `mov` into a segment register is unsupported; only reading one (`mov eax, cs`) is");
    }

    var gp: iasm.Operand = iasm.op_none();
    var gp_lo: usize = s.arg_lo[0];
    var gp_hi: usize = s.arg_hi[0];
    var gp_tok: str = dtok;
    if (dst_cr) { gp_lo = s.arg_lo[1]; gp_hi = s.arg_hi[1]; gp_tok = stok; }
    if (!x64_reg(gp_tok, ?gp)) {
        ret R.err[bool, str](iasm.span_message(c,
            "encode: inline-asm system-register move names '", gp_lo, gp_hi,
            "' where a general-purpose register is required",
            "encode: an inline-asm system-register move requires a general-purpose register on its other side"));
    }

    if (src_cr || dst_cr) {
        if (gp.size != 8) {
            ret R.err[bool, str]("encode: inline-asm control-register move requires a 64-bit general-purpose register");
        }
        item.code = x64.MOV_CR::u32;
    }
    or { item.code = x64.MOV_SEG::u32; }

    if (dst_cr) {
        item.ops[0] = iasm.op_imm(dnum, 8);
        item.ops[1] = gp;
    } or {
        item.ops[0] = gp;
        item.ops[1] = iasm.op_imm(snum, 8);
    }
    ret R.ok[bool, str](true);
}

fun x64_xfer_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val lo: usize = s.arg_lo[0];
    val hi: usize = s.arg_hi[0];

    if (hi - lo >= 3 && c.body[lo] == '['::char && c.body[hi - 1] == ']'::char) {
        val r: R.Result[R.Void, str] = x64_mem(c, lo, hi, "", ?item.ops[0]);
        if (R.is_err[R.Void, str](r)) { ret r; }
        if ((item.ops[0].flags & iasm.AOF_MEM_SYM) != 0) {
            ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm indirect '",
                "' through a symbol's address is unsupported; name the symbol directly for a direct transfer, or load the address into a register",
                "encode: an inline-asm indirect control transfer through a symbol's address is unsupported; name the symbol directly for a direct transfer, or load the address into a register"));
        }
        item.flags = item.flags | X64F_INDIRECT;
        ret R.ok_void[str]();
    }

    var buf: [32]u8;
    var reg_op: iasm.Operand = iasm.op_none();
    if (iasm.copy_region(c.body, lo, hi, ?buf[0], 32) && x64_reg((?buf[0])::str, ?reg_op)) {
        if (reg_op.size != 8) {
            ret R.err[R.Void, str](x64_named_message(c, s, "encode: inline-asm indirect '",
                "' requires a 64-bit register",
                "encode: an inline-asm indirect control transfer requires a 64-bit register"));
        }
        item.ops[0] = reg_op;
        item.flags  = item.flags | X64F_INDIRECT;
        ret R.ok_void[str]();
    }

    ret x64_branch_target(c, s, item);
}

fun x64_branch_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) R.Result[R.Void, str] {
    val lo: usize = s.arg_lo[0];
    val hi: usize = s.arg_hi[0];
    var num: u64 = 0;
    var fwd: bool = false;
    if (iasm.label_ref_span(c.body, lo, hi, ?num, ?fwd)) {
        item.ref     = iasm.AR_LOCAL;
        item.ref_num = num;
        item.ref_fwd = fwd;
        ret R.ok_void[str]();
    }
    if (iasm.is_digit(c.body[lo])) {
        ret R.err[R.Void, str]("encode: inline-asm numeric local-label reference must be '<digits>f' or '<digits>b'");
    }
    if (!iasm.is_sym_region(c.body, lo, hi)) {
        ret R.err[R.Void, str]("encode: inline-asm branch target is not a symbol");
    }
    item.ref     = iasm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret R.ok_void[str]();
}

fun x64_to_isa(op: *iasm.Operand, size: u8, sym: intern.StrId) isa.Operand {
    if (op.kind == iasm.AOP_REG) { ret isa.make_reg(op.reg, size); }
    if (op.kind == iasm.AOP_IMM) { ret isa.make_imm(op.imm, size); }
    if (op.kind == iasm.AOP_MEM) {
        if ((op.flags & iasm.AOF_MEM_SYM) != 0) {
            var m: isa.Operand = isa.make_mem(-1, 0, -1, 0, size);
            m.sym_id = sym::u32;
            ret m;
        }
        if ((op.flags & iasm.AOF_MEM_ABS) != 0) { ret isa.make_mem(x64.MEM_BASE_ABS, op.imm::i32, -1, 0, size); }
        ret isa.make_mem(op.reg, op.imm::i32, op.index, op.scale, size);
    }
    ret isa.make_none();
}

fun x64_build(item: *iasm.Item, sym: intern.StrId) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = item.code::u16;
    var enc_flags: u16 = 0;
    if ((item.flags & X64F_LOCK) != 0) { enc_flags = x64.FLAG_LOCK::u16; }

    val pat: u16 = x64_pattern(item.flags);
    if (pat == X64P_NONE || pat == X64P_BRANCH) {
        mi.flags = enc_flags;
        ret mi;
    }
    if (pat == X64P_XFER) {
        if ((item.flags & X64F_INDIRECT) == 0) {
            mi.flags = enc_flags;
            if (item.ref == iasm.AR_SYM) { mi.dst = isa.make_sym(sym::u32, 8); }
            ret mi;
        }
        mi.size  = 8;
        mi.flags = enc_flags | x64.FLAG_INDIRECT::u16;
        mi.dst   = x64_to_isa(?item.ops[0], 8, sym);
        ret mi;
    }

    if (pat == X64P_PORTIO) {
        mi.flags = enc_flags;
        mi.dst   = x64_to_isa(?item.ops[0], item.ops[0].size, sym);
        mi.src1  = x64_to_isa(?item.ops[1], item.ops[1].size, sym);
        ret mi;
    }

    if (item.code == x64.MOV_CR::u32) {
        mi.size  = 8;
        mi.flags = enc_flags;
        mi.dst   = x64_to_isa(?item.ops[0], 8, sym);
        mi.src1  = x64_to_isa(?item.ops[1], 8, sym);
        ret mi;
    }

    val size: u8 = x64_inst_size(item);
    mi.size  = size;
    mi.flags = width_flags_for(size) | enc_flags;
    mi.dst   = x64_to_isa(?item.ops[0], x64_operand_size(?item.ops[0], size), sym);
    if (pat == X64P_TWO) { mi.src1 = x64_to_isa(?item.ops[1], x64_operand_size(?item.ops[1], size), sym); }
    ret mi;
}

fun x64_inst_size(item: *iasm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        if (item.ops[i::usize].kind == iasm.AOP_REG) { ret item.ops[i::usize].size; }
        i = i + 1;
    }
    i = 0;
    for (i < item.nops) {
        val op: *iasm.Operand = ?item.ops[i::usize];
        if (op.kind == iasm.AOP_MEM && op.size != 0) { ret op.size; }
        i = i + 1;
    }
    ret 8;
}

fun x64_operand_size(op: *iasm.Operand, inst_size: u8) u8 {
    if (op.kind == iasm.AOP_MEM && op.size != 0) { ret op.size; }
    ret inst_size;
}

fun x64_emit(st: *enc.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) R.Result[R.Void, str] {
    var sym: intern.StrId = intern.STR_NIL;
    if (item.ref == iasm.AR_SYM) {
        val name: str = (c.body::usize + item.ref_off)::str;
        val symr: R.Result[intern.StrId, str] = intern.intern_bytes(st.interner, name, item.ref_len);
        if (R.is_err[intern.StrId, str](symr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](symr)); }
        sym = R.unwrap_ok[intern.StrId, str](symr);
    }

    var mi: isa.Inst = x64_build(item, sym);

    val inst_start: usize = st.buf.len;
    val n: i32 = encode_inst(?mi, ?st.buf);
    if (n <= 0) { ret R.err[R.Void, str]("encode: inline-asm instruction encoded to no bytes"); }

    if (item.ref == iasm.AR_LOCAL) {
        ret iasm.resolve_local(st, c.g, l, (inst_start + (n - 4)::usize)::u32, item.ref_num, item.ref_fwd);
    }
    if (item.ref == iasm.AR_SYM) { ret x64_emit_sym_ref(st, ?mi, sym, inst_start, n); }
    ret R.ok_void[str]();
}

fun x64_emit_sym_ref(st: *enc.EncodeState, mi: *isa.Inst, sym: intern.StrId,
                     inst_start: usize, n: i32) R.Result[R.Void, str] {
    val patch: i32 = x86_reloc_offset(nil, mi, n);
    if (patch < 0) {
        ret R.err[R.Void, str]("internal compiler error: inline-asm symbol reference has no relocation field");
    }

    ret enc.push_reloc(st, (inst_start + patch::usize)::u32, of.RK_PC32, sym, -(n - patch));
}

fun x64_patch(st: *enc.EncodeState, patch_pos: u32, target_off: u32) R.Result[R.Void, str] {
    patch_rel32(?st.buf, patch_pos::usize, target_off::i32 - (patch_pos + 4)::i32);
    ret R.ok_void[str]();
}

fun x64_grammar() iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = "x86_64";
    g.unknown    = "unknown x86_64 inline-asm instruction '";
    g.rows       = ?X64_MNEMONICS[0];
    g.row_count  = X64_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD16[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = nil;
    g.parse      = x64_parse;
    g.emit       = x64_emit;
    g.patch      = x64_patch;
    g.slot       = frame_slot_offset;
    g.slot_sp    = x64_slot_from_sp;
    g.writes_sp  = x64_writes_sp;
    g.all_gp     = X64_ALL_GP;
    g.all_fp     = X64_ALL_FP;
    g.word       = 0;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = x64_decl_reg;
    g.no_fall    = x64_no_fall;
    ret g;
}

fun x64_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == x64.HLT::u32;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.returns(?g, body);
}

fun x64_slot_from_sp(f: *mir.MirFunction) bool {
    ret codegen_frame.slots_from_sp(?f.frame);
}

fun x64_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << x64.RSP::u32)) != 0; }
        ret true;
    }
    if ((item.implicit & (1::u32 << x64.RSP::u32)) != 0) { ret true; }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && x64_op_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && x64_op_is_sp(?item.ops[1])) { ret true; }
    ret false;
}

fun x64_op_is_sp(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_REG && op.reg == x64.RSP;
}

fun x64_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: iasm.Operand = iasm.op_none();
    if (x64_reg(name, ?op) && op.size == 8 && op.reg >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = op.reg::u32;
        ret true;
    }
    var n: i32 = 0;
    if (x64_xmm_index(name, ?n)) {
        @bank = iasm.ABANK_FP;
        @idx  = n::u32;
        ret true;
    }
    ret false;
}

fun x64_xmm_index(name: str, out: *i32) bool {
    var i: i32 = 0;
    for (i < x64.FP_COUNT) {
        if (str_equals(name, x64.fp_reg_name(i))) { @out = i; ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = x64_grammar();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) R.Result[R.Void, str] {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.encode_block(st, ?g, f, mi);
}

fun x64_asm_text(st: *enc.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) R.Result[R.Void, str] {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

fun width_flags_for(size: u8) u16 {
    if (size == 8) { ret x64.FLAG_REX_W::u16; }
    if (size == 2) { ret x64.FLAG_16BIT::u16; }
    ret 0;
}

fun u64_to_dec(n: u64, dst: *u8) usize {
    if (n == 0) { dst[0] = '0'::u8; ret 1; }
    var tmp: [20]u8;
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) {
        tmp[len] = (v % 10)::u8 + '0'::u8;
        v        = v / 10;
        len      = len + 1;
    }
    var k: usize = 0;
    for (k < len) { dst[k] = tmp[len - 1 - k]; k = k + 1; }
    ret len;
}

var t_model_x64: isa.MachineModel;
fun x64_machine() *isa.MachineModel {
    t_model_x64.pointer_width = 8;
    t_model_x64.gpr_width     = 8;
    t_model_x64.max_alu_width = 8;
    t_model_x64.alu_min_width = 4;
    t_model_x64.spill_width   = 8;
    t_model_x64.flen_bits     = 64;
    ret ?t_model_x64;
}

fun t_asm_bytes(body: str, want: *u8, n: usize) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;

    var g: iasm.Grammar = x64_grammar();
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, ?alloc, nil, nil, nil);

    val rr: R.Result[R.Void, str] = iasm.run(?st, ?g, ?c, ?labels);
    if (R.is_err[R.Void, str](rr)) { ret false; }

    if (st.buf.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (st.buf.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun t_asm_refused(body: str, want: str) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, ?alloc, nil, nil, nil);

    var item: iasm.Item;
    val pr: R.Result[bool, str] = iasm.next(?c, ?item);
    if (!R.is_err[bool, str](pr)) { ret false; }
    ret str_contains(R.unwrap_err[bool, str](pr), want);
}

test "mach.lang.target.isa.x64.encode.x64_call_target:indirect_forms_byte_exact" {
    var bad: i32 = 0;

    var abs_want: [7]u8;
    abs_want[0] = 0xFF; abs_want[1] = 0x14; abs_want[2] = 0x25;
    abs_want[3] = 0x18; abs_want[4] = 0x00; abs_want[5] = 0x10; abs_want[6] = 0x00;
    if (!t_asm_bytes("call [0x100018]", ?abs_want[0], 7)) { bad = 1; }

    var rax_want: [2]u8;
    rax_want[0] = 0xFF; rax_want[1] = 0xD0;
    if (!t_asm_bytes("call rax", ?rax_want[0], 2)) { bad = 1; }

    var r11_want: [3]u8;
    r11_want[0] = 0x41; r11_want[1] = 0xFF; r11_want[2] = 0xD3;
    if (!t_asm_bytes("call r11", ?r11_want[0], 3)) { bad = 1; }

    var m0_want: [2]u8;
    m0_want[0] = 0xFF; m0_want[1] = 0x10;
    if (!t_asm_bytes("call [rax]", ?m0_want[0], 2)) { bad = 1; }

    var m8_want: [3]u8;
    m8_want[0] = 0xFF; m8_want[1] = 0x50; m8_want[2] = 0x08;
    if (!t_asm_bytes("call [rax + 8]", ?m8_want[0], 3)) { bad = 1; }

    var mi_want: [4]u8;
    mi_want[0] = 0xFF; mi_want[1] = 0x54; mi_want[2] = 0xD8; mi_want[3] = 0x10;
    if (!t_asm_bytes("call [rax + rbx*8 + 16]", ?mi_want[0], 4)) { bad = 1; }

    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "call main", nil, nil, nil, nil);
    var item: iasm.Item;
    if (R.is_err[bool, str](iasm.next(?c, ?item)))                  { ret 1; }
    if (item.ref != iasm.AR_SYM)                                    { bad = 1; }
    val dm: isa.Inst = x64_build(?item, 7::intern.StrId);
    if (dm.opcode != x64.CALL)                                      { bad = 1; }
    if ((dm.flags & x64.FLAG_INDIRECT::u16) != 0)                   { bad = 1; }
    if (dm.dst.kind != isa.OPK_SYM)                                 { bad = 1; }
    if (dm.dst.sym_id != 7)                                         { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_clobbers:indirect_call_is_not_opaque" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("call rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    asm_clobbers("call [0x100018]", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    asm_clobbers(".byte 0xff, 0x14, 0x25, 0x18, 0x00, 0x10, 0x00", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.parse_data:sequence_is_not_an_operand_list" {
    var bad: i32 = 0;

    var want: [7]u8;
    want[0] = 0xFF; want[1] = 0x14; want[2] = 0x25;
    want[3] = 0x18; want[4] = 0x00; want[5] = 0x10; want[6] = 0x00;
    if (!t_asm_bytes(".byte 0xff, 0x14, 0x25, 0x18, 0x00, 0x10, 0x00", ?want[0], 7)) { bad = 1; }

    var one: [1]u8;
    one[0] = 0x90;
    if (!t_asm_bytes(".byte 0x90", ?one[0], 1)) { bad = 1; }
    var neg: [1]u8;
    neg[0] = 0xFF;
    if (!t_asm_bytes(".byte -1", ?neg[0], 1)) { bad = 1; }

    if (!t_asm_refused(".byte 0x1ff", "cannot hold")) { bad = 1; }
    if (!t_asm_refused(".byte -129", "cannot hold"))  { bad = 1; }
    if (!t_asm_refused(".byte", "unknown"))      { bad = 1; }
    if (!t_asm_refused(".byte ,", "value"))      { bad = 1; }

    if (!t_asm_refused("mov rax, rbx, rcx, rdx, rsi", "too many operands")) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.parse_data:gnu_as_widths" {
    var bad: i32 = 0;

    var w: [2]u8;
    w[0] = 0x34; w[1] = 0x12;
    if (!t_asm_bytes(".word 0x1234", ?w[0], 2)) { bad = 1; }
    if (!t_asm_refused(".word 0x10000", "cannot hold")) { bad = 1; }

    var l: [4]u8;
    l[0] = 0x78; l[1] = 0x56; l[2] = 0x34; l[3] = 0x12;
    if (!t_asm_bytes(".long 0x12345678", ?l[0], 4)) { bad = 1; }

    var q: [8]u8;
    var i: usize = 0;
    for (i < 8) { q[i] = 0xFF; i = i + 1; }
    if (!t_asm_bytes(".quad 0xFFFFFFFFFFFFFFFF", ?q[0], 8)) { bad = 1; }

    var n: [2]u8;
    n[0] = 0xFF; n[1] = 0xFF;
    if (!t_asm_bytes(".word -1", ?n[0], 2)) { bad = 1; }
    if (!t_asm_refused(".word -32769", "cannot hold")) { bad = 1; }

    var mix: [7]u8;
    mix[0] = 0x90;
    mix[1] = 0x34; mix[2] = 0x12;
    mix[3] = 0x78; mix[4] = 0x56; mix[5] = 0x34; mix[6] = 0x12;
    if (!t_asm_bytes(".byte 0x90\n.word 0x1234\n.long 0x12345678", ?mix[0], 7)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.x64_call_target:refused_forms" {
    var bad: i32 = 0;

    if (!t_asm_refused("call [main]", "symbol"))                { bad = 1; }
    if (!t_asm_refused("call eax", "64-bit"))                   { bad = 1; }
    if (!t_asm_refused("call [0x100000000]", "32-bit"))         { bad = 1; }
    if (!t_asm_refused("call [0x100018 + 8]", "displacement"))  { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.x64_call_target:long_symbol_operand" {
    var bad: i32 = 0;

    var alloc1: A.Allocator;
    page.make(?alloc1);
    var itn1: intern.Interner = intern.init(?alloc1);
    var st1: enc.EncodeState;
    st1.alloc    = ?alloc1;
    st1.buf      = enc.buf_init(?alloc1);
    st1.interner = ?itn1;
    var g1: iasm.Grammar = x64_grammar();
    var labels1: iasm.Labels;
    iasm.labels_init(?labels1, ?alloc1);
    var c1: iasm.Cursor;
    iasm.cursor_init(?c1, ?g1, "lea rax, [short_sym]", ?alloc1, ?itn1, nil, nil);
    val r1: R.Result[R.Void, str] = iasm.run(?st1, ?g1, ?c1, ?labels1);
    if (R.is_err[R.Void, str](r1)) { bad = 1; }

    val long_name: str =
        "sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    val long_lea: str =
        "lea rax, [sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]";
    var alloc2: A.Allocator;
    page.make(?alloc2);
    var itn2: intern.Interner = intern.init(?alloc2);
    var st2: enc.EncodeState;
    st2.alloc    = ?alloc2;
    st2.buf      = enc.buf_init(?alloc2);
    st2.interner = ?itn2;
    var g2: iasm.Grammar = x64_grammar();
    var labels2: iasm.Labels;
    iasm.labels_init(?labels2, ?alloc2);
    var c2: iasm.Cursor;
    iasm.cursor_init(?c2, ?g2, long_lea, ?alloc2, ?itn2, nil, nil);
    val r2: R.Result[R.Void, str] = iasm.run(?st2, ?g2, ?c2, ?labels2);
    if (R.is_err[R.Void, str](r2)) { bad = 1; }

    if (st1.buf.len != st2.buf.len) { bad = 1; }
    or {
        var i: usize = 0;
        for (i < st1.buf.len) {
            if (st1.buf.data[i] != st2.buf.data[i]) { bad = 1; }
            i = i + 1;
        }
    }

    if (st2.reloc_count == 0) { bad = 1; }
    or {
        val nm: O.Option[str] = intern.lookup(?itn2, st2.relocs[st2.reloc_count - 1].sym);
        if (!O.is_some[str](nm)) { bad = 1; }
        or (!str_equals(O.unwrap[str](nm), long_name)) { bad = 1; }
    }

    if (!t_asm_refused("lea rax, [rax", "malformed")) { bad = 1; }

    ret bad;
}

fun t_inst_bytes(mi: *isa.Inst, want: *u8, n: usize) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val got: i32 = encode_inst(mi, ?buf);
    var ok: bool = got::usize == n && buf.len == n;
    var i: usize = 0;
    for (ok && i < n) {
        if (buf.data[i] != want[i]) { ok = false; }
        i = i + 1;
    }
    enc.buf_dnit(?buf);
    ret ok;
}

fun t_inst_refused(mi: *isa.Inst) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val got: i32 = encode_inst(mi, ?buf);
    val ok: bool = got == 0 && buf.len == 0;
    enc.buf_dnit(?buf);
    ret ok;
}

fun t_indirect_jmp(dst: isa.Operand) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.JMP;
    mi.size   = 8;
    mi.flags  = x64.FLAG_INDIRECT::u16;
    mi.dst    = dst;
    ret mi;
}

test "mach.lang.target.isa.x64.encode.encode_jmp:indirect_forms_byte_exact" {
    var bad: i32 = 0;

    var rax: isa.Inst = t_indirect_jmp(isa.make_reg(x64.RAX, 8));
    var rax_want: [2]u8;
    rax_want[0] = 0xFF; rax_want[1] = 0xE0;
    if (!t_inst_bytes(?rax, ?rax_want[0], 2)) { bad = 1; }

    var r11: isa.Inst = t_indirect_jmp(isa.make_reg(x64.R11, 8));
    var r11_want: [3]u8;
    r11_want[0] = 0x41; r11_want[1] = 0xFF; r11_want[2] = 0xE3;
    if (!t_inst_bytes(?r11, ?r11_want[0], 3)) { bad = 1; }

    var m0: isa.Inst = t_indirect_jmp(isa.make_mem(x64.RAX, 0, -1, 0, 8));
    var m0_want: [2]u8;
    m0_want[0] = 0xFF; m0_want[1] = 0x20;
    if (!t_inst_bytes(?m0, ?m0_want[0], 2)) { bad = 1; }

    var m8: isa.Inst = t_indirect_jmp(isa.make_mem(x64.RAX, 8, -1, 0, 8));
    var m8_want: [3]u8;
    m8_want[0] = 0xFF; m8_want[1] = 0x60; m8_want[2] = 0x08;
    if (!t_inst_bytes(?m8, ?m8_want[0], 3)) { bad = 1; }

    var midx: isa.Inst = t_indirect_jmp(isa.make_mem(x64.RAX, 16, x64.RBX, 8, 8));
    var mi_want: [4]u8;
    mi_want[0] = 0xFF; mi_want[1] = 0x64; mi_want[2] = 0xD8; mi_want[3] = 0x10;
    if (!t_inst_bytes(?midx, ?mi_want[0], 4)) { bad = 1; }

    var m13: isa.Inst = t_indirect_jmp(isa.make_mem(x64.R13, 0, -1, 0, 8));
    var m13_want: [4]u8;
    m13_want[0] = 0x41; m13_want[1] = 0xFF; m13_want[2] = 0x65; m13_want[3] = 0x00;
    if (!t_inst_bytes(?m13, ?m13_want[0], 4)) { bad = 1; }

    var mabs: isa.Inst = t_indirect_jmp(isa.make_mem(x64.MEM_BASE_ABS, 0x100018, -1, 0, 8));
    var abs_want: [7]u8;
    abs_want[0] = 0xFF; abs_want[1] = 0x24; abs_want[2] = 0x25;
    abs_want[3] = 0x18; abs_want[4] = 0x00; abs_want[5] = 0x10; abs_want[6] = 0x00;
    if (!t_inst_bytes(?mabs, ?abs_want[0], 7)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_jmp:refuses_unmodelled_indirect_target" {
    var bad: i32 = 0;

    var lbl: isa.Inst = t_indirect_jmp(isa.make_block_label(7));
    if (!t_inst_refused(?lbl)) { bad = 1; }

    var mimm: isa.Inst = t_indirect_jmp(isa.make_imm(0x100018, 8));
    if (!t_inst_refused(?mimm)) { bad = 1; }

    var mnone: isa.Inst = t_indirect_jmp(isa.make_none());
    if (!t_inst_refused(?mnone)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.mir_to_inst:block_jmp_target_stays_direct" {
    var bad: i32 = 0;

    var ops: [1]mir.MirOperand;
    ops[0] = mir.op_block(7);
    var mi: mir.MirInstr = mir.instr(x64.JMP::u32, ?ops[0], 1, 8, 8);

    var inst: isa.Inst = isa.inst_blank();
    val r: R.Result[R.Void, str] = mir_to_inst(nil, ?mi, ?inst);
    if (R.is_err[R.Void, str](r))                        { ret 1; }
    if ((inst.flags & x64.FLAG_INDIRECT::u16) != 0)    { bad = 1; }
    if (inst.dst.kind != isa.OPK_LABEL)                { bad = 1; }

    var want: [5]u8;
    want[0] = 0xE9; want[1] = 0x00; want[2] = 0x00; want[3] = 0x00; want[4] = 0x00;
    if (!t_inst_bytes(?inst, ?want[0], 5)) { bad = 1; }

    ret bad;
}

