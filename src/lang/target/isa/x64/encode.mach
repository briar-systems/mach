fun x64_reg_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    val len: usize = hi - lo;
    if (str_region_equals(body, lo, len, "rax")) {
        @op = iasm.op_reg(x64.RAX, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rbx")) {
        @op = iasm.op_reg(x64.RBX, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rcx")) {
        @op = iasm.op_reg(x64.RCX, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rdx")) {
        @op = iasm.op_reg(x64.RDX, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rsi")) {
        @op = iasm.op_reg(x64.RSI, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rdi")) {
        @op = iasm.op_reg(x64.RDI, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rbp")) {
        @op = iasm.op_reg(x64.RBP, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "rsp")) {
        @op = iasm.op_reg(x64.RSP, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r8")) {
        @op = iasm.op_reg(x64.R8, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r9")) {
        @op = iasm.op_reg(x64.R9, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r10")) {
        @op = iasm.op_reg(x64.R10, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r11")) {
        @op = iasm.op_reg(x64.R11, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r12")) {
        @op = iasm.op_reg(x64.R12, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r13")) {
        @op = iasm.op_reg(x64.R13, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r14")) {
        @op = iasm.op_reg(x64.R14, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r15")) {
        @op = iasm.op_reg(x64.R15, 8);
        ret true;
    }
    if (str_region_equals(body, lo, len, "eax")) {
        @op = iasm.op_reg(x64.RAX, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "ebx")) {
        @op = iasm.op_reg(x64.RBX, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "ecx")) {
        @op = iasm.op_reg(x64.RCX, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "edx")) {
        @op = iasm.op_reg(x64.RDX, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "esi")) {
        @op = iasm.op_reg(x64.RSI, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "edi")) {
        @op = iasm.op_reg(x64.RDI, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "ebp")) {
        @op = iasm.op_reg(x64.RBP, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "esp")) {
        @op = iasm.op_reg(x64.RSP, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r8d")) {
        @op = iasm.op_reg(x64.R8, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r9d")) {
        @op = iasm.op_reg(x64.R9, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r10d")) {
        @op = iasm.op_reg(x64.R10, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r11d")) {
        @op = iasm.op_reg(x64.R11, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r12d")) {
        @op = iasm.op_reg(x64.R12, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r13d")) {
        @op = iasm.op_reg(x64.R13, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r14d")) {
        @op = iasm.op_reg(x64.R14, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r15d")) {
        @op = iasm.op_reg(x64.R15, 4);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r8w")) {
        @op = iasm.op_reg(x64.R8, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r9w")) {
        @op = iasm.op_reg(x64.R9, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r10w")) {
        @op = iasm.op_reg(x64.R10, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r11w")) {
        @op = iasm.op_reg(x64.R11, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r12w")) {
        @op = iasm.op_reg(x64.R12, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r13w")) {
        @op = iasm.op_reg(x64.R13, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r14w")) {
        @op = iasm.op_reg(x64.R14, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r15w")) {
        @op = iasm.op_reg(x64.R15, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "ax")) {
        @op = iasm.op_reg(x64.RAX, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "bx")) {
        @op = iasm.op_reg(x64.RBX, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "cx")) {
        @op = iasm.op_reg(x64.RCX, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "dx")) {
        @op = iasm.op_reg(x64.RDX, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "si")) {
        @op = iasm.op_reg(x64.RSI, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "di")) {
        @op = iasm.op_reg(x64.RDI, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "bp")) {
        @op = iasm.op_reg(x64.RBP, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "sp")) {
        @op = iasm.op_reg(x64.RSP, 2);
        ret true;
    }
    if (str_region_equals(body, lo, len, "al")) {
        @op = iasm.op_reg(x64.RAX, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "bl")) {
        @op = iasm.op_reg(x64.RBX, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "cl")) {
        @op = iasm.op_reg(x64.RCX, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "dl")) {
        @op = iasm.op_reg(x64.RDX, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "sil")) {
        @op = iasm.op_reg(x64.RSI, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "dil")) {
        @op = iasm.op_reg(x64.RDI, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "bpl")) {
        @op = iasm.op_reg(x64.RBP, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "spl")) {
        @op = iasm.op_reg(x64.RSP, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r8b")) {
        @op = iasm.op_reg(x64.R8, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r9b")) {
        @op = iasm.op_reg(x64.R9, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r10b")) {
        @op = iasm.op_reg(x64.R10, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r11b")) {
        @op = iasm.op_reg(x64.R11, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r12b")) {
        @op = iasm.op_reg(x64.R12, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r13b")) {
        @op = iasm.op_reg(x64.R13, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r14b")) {
        @op = iasm.op_reg(x64.R14, 1);
        ret true;
    }
    if (str_region_equals(body, lo, len, "r15b")) {
        @op = iasm.op_reg(x64.R15, 1);
        ret true;
    }
    ret false;
}

fun x64_reg(name: str, op: *iasm.Operand) bool {
    ret x64_reg_region(name, 0, str_len(name), op);
}

fun x64_xmm_region(body: str, lo: usize, hi: usize, op: *iasm.Operand) bool {
    var i: i32 = 0;
    for (i < x64.FP_COUNT) {
        if (str_region_equals(body, lo, hi - lo, x64.fp_reg_name(i))) {
            @op = iasm.op_vreg(i, 16);
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun x64_ctlreg(name: str, num: *i64) bool {
    if (str_equals(name, "cr0")) {
        @num = 0;
        ret true;
    }
    if (str_equals(name, "cr2")) {
        @num = 2;
        ret true;
    }
    if (str_equals(name, "cr3")) {
        @num = 3;
        ret true;
    }
    if (str_equals(name, "cr4")) {
        @num = 4;
        ret true;
    }
    if (str_equals(name, "cr8")) {
        @num = 8;
        ret true;
    }
    ret false;
}

fun x64_segreg(name: str, num: *i64) bool {
    if (str_equals(name, "es")) {
        @num = 0;
        ret true;
    }
    if (str_equals(name, "cs")) {
        @num = 1;
        ret true;
    }
    if (str_equals(name, "ss")) {
        @num = 2;
        ret true;
    }
    if (str_equals(name, "ds")) {
        @num = 3;
        ret true;
    }
    if (str_equals(name, "fs")) {
        @num = 4;
        ret true;
    }
    if (str_equals(name, "gs")) {
        @num = 5;
        ret true;
    }
    ret false;
}

fun x64_size_keyword(body: str, lo: usize, hi: usize, rest: *usize) u8 {
    var width: u8    = 0;
    var len:   usize = 0;
    if (lo + 4 < hi && str_region_equals(body, lo, 4, "byte")) {
        width = 1;
        len   = 4;
    }
    or (lo + 4 < hi && str_region_equals(body, lo, 4, "word")) {
        width = 2;
        len   = 4;
    }
    or (lo + 5 < hi && str_region_equals(body, lo, 5, "dword")) {
        width = 4;
        len   = 5;
    }
    or (lo + 5 < hi && str_region_equals(body, lo, 5, "qword")) {
        width = 8;
        len   = 5;
    }
    or (lo + 7 < hi && str_region_equals(body, lo, 7, "xmmword")) {
        width = 16;
        len   = 7;
    }
    or                                  { ret 0; }
    if (!iasm.is_space(body[lo + len])) { ret 0; }
    var i: usize = lo + len;
    for (i < hi && iasm.is_space(body[i])) { i = i + 1; }
    @rest = i;
    ret width;
}

fun x64_bracketed(c: *iasm.Cursor, lo: usize, hi: usize) bool {
    ret hi > lo && hi - lo >= 3 && c.body[lo] == '['::char && c.body[hi - 1] == ']'::char;
}

# a leading `fs:` or `gs:` segment override, stepping rest past it; seg stays
# SEG_NONE when the operand names none
fun x64_segment(c: *iasm.Cursor, lo: usize, hi: usize, seg: *u8, rest: *usize) err[fail.Fail] {
    @seg  = x64.SEG_NONE;
    @rest = lo;
    if (lo + 3 > hi || c.body[lo + 2] != ':'::char) { ret err[fail.Fail].ok{}; }
    var name: [3]u8;
    name[0] = c.body[lo]::u8;
    name[1] = c.body[lo + 1]::u8;
    name[2] = 0;
    var num: i64 = 0;
    if (!x64_segreg((?name[0])::str, ?num)) { ret err[fail.Fail].ok{}; }

    var row: *x64.SegmentRow = nil;
    var i:   usize           = 0;
    for (i < x64.SEGMENT_COUNT) {
        if (str_region_equals(c.body, lo, 2, x64.SEGMENTS[i].name)) { row = ?x64.SEGMENTS[i]; }
        i = i + 1;
    }
    if (row == nil) {
        ret err[fail.Fail].err{iasm.reject(c, iasm.span_message(c,
            "inline-asm segment override '", lo, lo + 3,
            "' relocates nothing in long mode; only `fs:` and `gs:` do",
            "an inline-asm segment override other than `fs:` or `gs:` relocates nothing in long mode"))};
    }
    var j: usize = lo + 3;
    for (j < hi && iasm.is_space(c.body[j])) { j = j + 1; }
    if (!x64_bracketed(c, j, hi)) {
        ret err[fail.Fail].err{iasm.reject(c, iasm.span_message(c,
            "inline-asm segment override on '", lo, hi,
            "' may only precede a bracketed memory operand",
            "an inline-asm segment override may only precede a bracketed memory operand"))};
    }
    @seg  = row.seg;
    @rest = j;
    ret err[fail.Fail].ok{};
}

# a bracketed memory operand after its segment override, which cannot name a
# symbol: the symbol form is rip-relative, and fs or gs would move it off the symbol
fun x64_seg_mem(c: *iasm.Cursor, lo: usize, hi: usize, seg: u8, role: str, op: *iasm.Operand) err[fail.Fail] {
    val mr: err[fail.Fail] = x64_mem(c, lo, hi, role, op);
    if (sel mr.err) { ret mr; }
    op.seg = seg;
    if (seg != x64.SEG_NONE && (op.flags & iasm.AOF_MEM_SYM) != 0) {
        ret err[fail.Fail].err{iasm.reject(c, iasm.span_message(c,
            "inline-asm segment-relative operand '", lo, hi,
            "' names a symbol; a symbol operand is rip-relative, so address the segment by register or absolute offset",
            "an inline-asm segment-relative operand names a symbol; a symbol operand is rip-relative, so address the segment by register or absolute offset"))};
    }
    ret err[fail.Fail].ok{};
}

fun x64_operand(c: *iasm.Cursor, lo: usize, hi: usize, role: str, op: *iasm.Operand) err[fail.Fail] {
    @op = iasm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm operand")}; }

    var rest:  usize          = lo;
    val width: u8             = x64_size_keyword(c.body, lo, hi, ?rest);
    var seg:   u8             = x64.SEG_NONE;
    val sr:    err[fail.Fail] = x64_segment(c, rest, hi, ?seg, ?rest);
    if (sel sr.err) { ret sr; }
    if (width != 0 || seg != x64.SEG_NONE) {
        if (!x64_bracketed(c, rest, hi)) {
            ret err[fail.Fail].err{iasm.reject(c, iasm.span_message(c,
                "inline-asm operand-size prefix on '", lo, hi,
                "' may only precede a memory operand",
                "an inline-asm operand-size prefix may only precede a memory operand"))};
        }
        val mr: err[fail.Fail] = x64_seg_mem(c, rest, hi, seg, role, op);
        if (sel mr.err) { ret mr; }
        op.size = width;
        ret err[fail.Fail].ok{};
    }

    if (c.body[lo] == '{'::char) {
        var off:     i64                  = 0;
        val bound_r: res[bool, fail.Fail] = iasm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op = iasm.op_mem(slot_base_reg(c.f), off, -1, 0, 0);
            ret err[fail.Fail].ok{};
        }
        op.kind     = iasm.AOP_BIND;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    if (x64_reg_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }
    if (x64_xmm_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }

    if (hi - lo >= 3 && c.body[lo] == '['::char && c.body[hi - 1] == ']'::char) {
        ret x64_mem(c, lo, hi, role, op);
    }

    val iv: opt[i64] = iasm.region_i64(c.body, lo, hi);
    if (sel iv.some) {
        @op = iasm.op_imm(iv.some, 8);
        ret err[fail.Fail].ok{};
    }

    if (iasm.is_sym_region(c.body, lo, hi)) {
        @op = iasm.op_sym(lo, hi - lo, isa.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm operand")};
}

fun x64_mem(c: *iasm.Cursor, lo: usize, hi: usize, role: str, op: *iasm.Operand) err[fail.Fail] {
    @op     = iasm.op_none();
    op.kind = iasm.AOP_MEM;

    val inner_lo: usize = lo + 1;
    val inner_hi: usize = hi - 1;

    var q: usize = inner_lo;
    for (q < inner_hi) {
        if (c.body[q] == '{'::char) { ret err[fail.Fail].err{iasm.reject(c, x64_bind_base_message(c, role))}; }
        q = q + 1;
    }

    var star:     usize = 0;
    var has_star: bool  = false;
    var s:        usize = inner_lo;
    for (s < inner_hi) {
        if (c.body[s] == '*'::char) {
            star     = s;
            has_star = true;
        }
        s = s + 1;
    }

    var sep:         usize = inner_hi;
    var has_sep:     bool  = false;
    var neg:         bool  = false;
    var search_from: usize = inner_lo + 1;
    if (has_star) { search_from = star + 1; }
    var r: usize = inner_hi;
    for (r > search_from && !has_sep) {
        r = r - 1;
        if (c.body[r] == '+'::char) {
            sep     = r;
            has_sep = true;
            neg     = false;
        }
        or (c.body[r] == '-'::char) {
            sep     = r;
            has_sep = true;
            neg     = true;
        }
    }

    var bi_hi: usize = inner_hi;
    if (has_sep) { bi_hi = sep; }

    var buf: [32]u8;
    if (has_star) {
        var bplus:       usize = star;
        var found_bplus: bool  = false;
        var k:           usize = star;
        for (k > inner_lo && !found_bplus) {
            k = k - 1;
            if (c.body[k] == '+'::char) {
                bplus       = k;
                found_bplus = true;
            }
        }
        if (!found_bplus) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }

        if (!iasm.copy_region(c.body, inner_lo, bplus, ?buf[0], 32)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
        var base_op: iasm.Operand = iasm.op_none();
        if (!x64_reg((?buf[0])::str, ?base_op)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
        op.reg = base_op.reg;

        if (!iasm.copy_region(c.body, bplus + 1, star, ?buf[0], 32)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
        var idx_op: iasm.Operand = iasm.op_none();
        if (!x64_reg((?buf[0])::str, ?idx_op)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
        if (idx_op.reg == x64.RSP) {
            ret err[fail.Fail].err{iasm.reject(c, "rsp cannot be used as an inline-asm memory index register")};
        }
        op.index = idx_op.reg;

        val sv: opt[i64] = iasm.region_i64(c.body, star + 1, bi_hi);
        if (!sel sv.some) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
        val scale_val: i64 = sv.some;
        if (scale_val != 1 && scale_val != 2 && scale_val != 4 && scale_val != 8) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm memory index scale must be 1, 2, 4 or 8")};
        }
        op.scale = scale_val::u8;
    }
    or {
        var a: usize = inner_lo;
        var b: usize = bi_hi;
        for (a < b && iasm.is_space(c.body[a])) { a = a + 1; }
        for (b > a && iasm.is_space(c.body[b - 1])) { b = b - 1; }

        var base_op: iasm.Operand = iasm.op_none();
        if (x64_reg_region(c.body, a, b, ?base_op)) {
            op.reg = base_op.reg;
        }
        or {
            val av: opt[i64] = iasm.region_i64(c.body, a, b);
            if (sel av.some) {
                if (has_sep) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm absolute memory address takes no displacement term")}; }
                val addr: i64 = av.some;
                if (addr < -2147483648 || addr > 2147483647) {
                    ret err[fail.Fail].err{iasm.reject(c, "inline-asm absolute memory address does not fit a signed 32-bit displacement")};
                }
                op.flags = iasm.AOF_MEM_ABS;
                op.reg   = -1;
                op.imm   = addr;
                ret err[fail.Fail].ok{};
            }

            var vreg: iasm.Operand = iasm.op_none();
            if (x64_xmm_region(c.body, a, b, ?vreg)) {
                ret err[fail.Fail].err{iasm.reject(c, "inline-asm memory operand names a vector register, which cannot address memory")};
            }
            if (has_sep)                           { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
            if (!iasm.is_sym_region(c.body, a, b)) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
            op.flags    = iasm.AOF_MEM_SYM;
            op.reg      = -1;
            op.name_off = a;
            op.name_len = b - a;
        }
    }

    if (has_sep) {
        val dv: opt[i64] = iasm.region_i64(c.body, sep + 1, inner_hi);
        if (!sel dv.some) { ret err[fail.Fail].err{iasm.reject(c, "malformed inline-asm memory operand")}; }
        var disp: i64 = dv.some;
        if (neg) { disp = -disp; }
        if (disp < -2147483648 || disp > 2147483647) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm memory displacement does not fit a signed 32-bit displacement")};
        }
        op.imm   = disp;
        op.flags = op.flags | iasm.AOF_HAS_DISP;
    }
    ret err[fail.Fail].ok{};
}

fun x64_bind_base_message(c: *iasm.Cursor, role: str) str {
    if (c.interner == nil) {
        ret "inline-asm stack-slot binding cannot be used inside a memory operand; load it into a register first";
    }
    ret iasm.named_message(c.alloc, c.interner,
        "inline-asm ", role,
        "operand uses a stack-slot binding inside a memory operand ([{name}]); load it into a register first",
        "inline-asm stack-slot binding cannot be used inside a memory operand; load it into a register first");
}

fun x64_parse(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val pat: u16 = x64_pattern(s.m.flags);
    val n:   u32 = s.nargs;

    if (pat == X64P_NONE) {
        if (n != 0) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm instruction takes no operands")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == X64P_BRANCH) {
        if (n != 1) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm branch expects one target")}; }
        ret x64_branch_target(c, s, item);
    }
    if (pat == X64P_XFER) {
        if (n != 1) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm '", "' expects one target",
                "an inline-asm control transfer expects one target"))};
        }
        ret x64_xfer_target(c, s, item);
    }
    if (pat == X64P_VEC || pat == X64P_VECI) { ret x64_parse_vec(c, s, item); }
    if (pat == X64P_VECG)                    { ret x64_parse_vec_gp(c, s, item); }
    if (pat == X64P_WIDEREG)                 { ret x64_parse_widereg(c, s, item); }

    if (s.m.code == x64.MOV::u32 && n == 2) {
        val matched_r: res[bool, fail.Fail] = x64_mov_sysreg(c, s, item);
        if (sel matched_r.err) { ret err[fail.Fail].err{matched_r.err}; }
        if (matched_r.ok)      { ret err[fail.Fail].ok{}; }
    }

    var i: u32 = 0;
    for (i < n) {
        var role: str = "";
        if (pat == X64P_TWO && i == 0) { role = "destination "; }
        or (pat == X64P_TWO)           { role = "source "; }
        val r: err[fail.Fail] = x64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        if (iasm.is_vreg(?item.ops[i::usize])) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' takes general-purpose registers, not a vector register",
                "an inline-asm instruction takes general-purpose registers, not a vector register"))};
        }
        if (item.ops[i::usize].seg != x64.SEG_NONE && (x64.describe(s.m.code::u16).mem & x64.MEM_ADDR) != 0) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' takes an address it never accesses, so a segment override relocates nothing",
                "an inline-asm address operand is never accessed, so a segment override relocates nothing"))};
        }
        if (item.ops[i::usize].kind == iasm.AOP_MEM && item.ops[i::usize].size == 16) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' names an xmmword operand, which only a vector instruction takes",
                "an inline-asm instruction names an xmmword operand, which only a vector instruction takes"))};
        }
        i = i + 1;
    }

    if (pat == X64P_ONE) {
        if (n != 1) { ret err[fail.Fail].err{iasm.reject(c, "inline-asm instruction expects one operand")}; }
        val op: *iasm.Operand = ?item.ops[0];
        if (op.kind == iasm.AOP_SYM || (op.kind == iasm.AOP_MEM && (op.flags & iasm.AOF_MEM_SYM) != 0)) {
            ret err[fail.Fail].err{iasm.reject(c, "inline-asm one-operand symbol form unsupported")};
        }
        ret x64_check_widths(c, s, item);
    }

    if (pat == X64P_TRIPLE) { ret x64_check_triple(c, s, item); }

    if (n != 2) {
        ret err[fail.Fail].err{iasm.reject(c, iasm.span_message(c,
            "malformed inline-asm two-operand instruction '", s.lo, s.hi, "'",
            "malformed inline-asm two-operand instruction"))};
    }
    if (item.ops[0].kind == iasm.AOP_SYM || item.ops[1].kind == iasm.AOP_SYM) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm bare-symbol operand unsupported (use [symbol])")};
    }
    if (x64.describe(s.m.code::u16).form == x64.FORM_BITSCAN) {
        val dst: *iasm.Operand = ?item.ops[0];
        val src: *iasm.Operand = ?item.ops[1];
        if (dst.kind != iasm.AOP_REG || dst.size == 1 || src.kind == iasm.AOP_IMM || (src.kind == iasm.AOP_REG && src.size == 1)) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' takes a 16-, 32- or 64-bit register destination and a register or memory source of the same width",
                "an inline-asm bit scan takes a 16-, 32- or 64-bit register destination and a register or memory source of the same width"))};
        }
    }
    if ((item.ops[0].flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = item.ops[0].name_off;
        item.ref_len = item.ops[0].name_len;
    }
    or ((item.ops[1].flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = item.ops[1].name_off;
        item.ref_len = item.ops[1].name_len;
    }
    ret x64_check_widths(c, s, item);
}

# a memory operand naming a symbol becomes the item's reference, as on the two-operand forms
fun x64_note_sym_ref(item: *iasm.Item, n: u32) {
    var i: u32 = 0;
    for (i < n) {
        if ((item.ops[i::usize].flags & iasm.AOF_MEM_SYM) != 0 && item.ref != iasm.AR_SYM) {
            item.ref     = iasm.AR_SYM;
            item.ref_off = item.ops[i::usize].name_off;
            item.ref_len = item.ops[i::usize].name_len;
        }
        i = i + 1;
    }
}

fun x64_is_cl(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_REG && !iasm.is_vreg(op) && op.reg == x64.RCX && op.size == 1;
}

# imul: a register from an r/m, with an optional immediate multiplier; shld
# and shrd: an r/m, the register feeding bits, and a count of imm8 or cl
fun x64_check_triple(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val n:       u32  = s.nargs;
    val is_imul: bool = s.m.code == x64.IMUL::u32;
    var ok:      bool = n == 3 || (is_imul && n == 2);
    if (ok) {
        val dst: *iasm.Operand = ?item.ops[0];
        val src: *iasm.Operand = ?item.ops[1];
        if (dst.kind != iasm.AOP_REG && (is_imul || dst.kind != iasm.AOP_MEM))            { ok = false; }
        if (src.kind != iasm.AOP_REG && (!is_imul || src.kind != iasm.AOP_MEM))           { ok = false; }
        if (dst.kind == iasm.AOP_REG && dst.size == 1)                                    { ok = false; }
        if (src.kind == iasm.AOP_REG && src.size == 1)                                    { ok = false; }
        if (dst.kind == iasm.AOP_REG && src.kind == iasm.AOP_REG && dst.size != src.size) { ok = false; }
        if (n == 3) {
            val cnt: *iasm.Operand = ?item.ops[2];
            if (cnt.kind == iasm.AOP_IMM) {
                if (!is_imul && (cnt.imm < 0 || cnt.imm > 255)) { ok = false; }
            }
            or (is_imul || !x64_is_cl(cnt)) { ok = false; }
        }
    }
    if (!ok) {
        if (is_imul) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' takes a 16-, 32- or 64-bit register and a source of the same width, with an optional immediate multiplier",
                "an inline-asm multiply takes a 16-, 32- or 64-bit register and a source of the same width, with an optional immediate multiplier"))};
        }
        ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
            "' takes a 16-, 32- or 64-bit register or memory, a register of the same width feeding bits, and a count of 0 to 255 or `cl`",
            "an inline-asm double shift takes a 16-, 32- or 64-bit register or memory, a register of the same width feeding bits, and a count of 0 to 255 or `cl`"))};
    }
    x64_note_sym_ref(item, n);
    ret x64_check_widths(c, s, item);
}

fun x64_parse_widereg(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    if (s.nargs == 1) {
        val r: err[fail.Fail] = x64_operand(c, s.arg_lo[0], s.arg_hi[0], "", ?item.ops[0]);
        if (sel r.err) { ret r; }
        val op: *iasm.Operand = ?item.ops[0];
        if (op.kind == iasm.AOP_REG && !iasm.is_vreg(op) && (op.size == 4 || op.size == 8)) { ret err[fail.Fail].ok{}; }
    }
    ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
        "' takes one 32- or 64-bit general-purpose register",
        "an inline-asm base-register instruction takes one 32- or 64-bit general-purpose register"))};
}

# the operand positions of pinsrd (vector first) and pextrd (vector second)
fun x64_lane_positions(code: u32, v: *usize, g: *usize) {
    @v = 0;
    @g = 1;
    if (code == x64.PEXTRD::u32) {
        @v = 1;
        @g = 0;
    }
}

fun x64_lane_refused(c: *iasm.Cursor, s: *iasm.Stmt) err[fail.Fail] {
    ret x64_vec_refused(c, s, "' takes a vector register, a 32-bit register or memory, and an immediate from 0 to 255",
        "an inline-asm lane instruction takes a vector register, a 32-bit register or memory, and an immediate from 0 to 255");
}

# pinsrd xmm, r/m32, imm8 and pextrd r/m32, xmm, imm8
fun x64_parse_vec_gp(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    if (s.nargs != 3) { ret x64_lane_refused(c, s); }
    var i: u32 = 0;
    for (i < 3) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = x64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    var vi: usize = 0;
    var gi: usize = 0;
    x64_lane_positions(s.m.code, ?vi, ?gi);
    val v:      *iasm.Operand = ?item.ops[vi];
    val g:      *iasm.Operand = ?item.ops[gi];
    val imm:    *iasm.Operand = ?item.ops[2];
    val gp_reg: bool          = g.kind == iasm.AOP_REG && !iasm.is_vreg(g) && g.size == 4;
    val gp_mem: bool          = x64_vec_mem(g) && (g.kind != iasm.AOP_MEM || g.size == 0 || g.size == 4);
    if (!iasm.is_vreg(v) || !(gp_reg || gp_mem))                  { ret x64_lane_refused(c, s); }
    if (imm.kind != iasm.AOP_IMM || imm.imm < 0 || imm.imm > 255) { ret x64_lane_refused(c, s); }
    if (g.kind == iasm.AOP_MEM && (g.flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = g.name_off;
        item.ref_len = g.name_len;
    }
    ret err[fail.Fail].ok{};
}

fun x64_emit_vec_gp(st: *enc.EncodeState, item: *iasm.Item, sym: intern.StrId) err[fail.Fail] {
    var vi: usize = 0;
    var gi: usize = 0;
    x64_lane_positions(item.code, ?vi, ?gi);
    val op:     u16         = item.code::u16;
    val v:      isa.Operand = x64_vec_operand(?item.ops[vi], sym);
    val g:      isa.Operand = x64_to_isa(?item.ops[gi], 4, sym);
    val imm:    u8          = item.ops[2].imm::u8;
    var prefix: u8          = 0;
    var map:    u8          = 0;
    var byte:   u8          = 0;
    if (!mapped_opbytes(op, ?prefix, ?map, ?byte)) { ret err[fail.Fail].err{fail.message(PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = st.buf.len;
    emit_sse_map_rm(prefix, map, byte, v.reg, g, ?st.buf);
    enc.emit_byte(?st.buf, imm);
    if (vi == 0)                 { note_packed_imm(?st.buf, start, op, v, g, imm); }
    or                           { note_packed_imm(?st.buf, start, op, g, v, imm); }
    if (item.ref != iasm.AR_SYM) { ret err[fail.Fail].ok{}; }
    val n: i32 = (st.buf.len - start)::i32;
    ret x64_push_pc32(st, sym, start, n - 5, n);
}

fun x64_vec_mem(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_MEM || op.kind == iasm.AOP_BIND;
}

fun x64_vec_refused(c: *iasm.Cursor, s: *iasm.Stmt, suffix: str, fallback: str) err[fail.Fail] {
    ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '", suffix, fallback))};
}

# a vector register (or, for a storing move, memory) written from a vector register or memory
fun x64_parse_vec(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val with_imm: bool = x64_pattern(s.m.flags) == X64P_VECI;
    val store:    bool = (s.m.flags & X64F_VSTORE) != 0;
    var want:     u32  = 2;
    if (with_imm) { want = 3; }
    if (s.nargs != want) {
        if (with_imm) {
            ret x64_vec_refused(c, s, "' expects a vector register, a vector register or memory source, and an 8-bit immediate",
                "an inline-asm vector instruction expects a vector register, a vector register or memory source, and an 8-bit immediate");
        }
        ret x64_vec_refused(c, s, "' expects two operands",
            "an inline-asm vector instruction expects two operands");
    }

    var i: u32 = 0;
    for (i < want) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = x64_operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }

    val dst: *iasm.Operand = ?item.ops[0];
    val src: *iasm.Operand = ?item.ops[1];
    if (!iasm.is_vreg(dst) && !(store && x64_vec_mem(dst))) {
        if (store) {
            ret x64_vec_refused(c, s, "' writes a vector register or memory destination",
                "an inline-asm vector instruction writes a vector register or memory destination");
        }
        ret x64_vec_refused(c, s, "' writes a vector register destination",
            "an inline-asm vector instruction writes a vector register destination");
    }
    if (!iasm.is_vreg(src) && !x64_vec_mem(src)) {
        ret x64_vec_refused(c, s, "' takes a vector register or memory source",
            "an inline-asm vector instruction takes a vector register or memory source");
    }
    if (x64_vec_mem(dst) && !iasm.is_vreg(src)) {
        ret x64_vec_refused(c, s, "' stores into memory only from a vector register",
            "an inline-asm vector instruction stores into memory only from a vector register");
    }
    if ((dst.kind == iasm.AOP_MEM && dst.size != 0 && dst.size != 16) || (src.kind == iasm.AOP_MEM && src.size != 0 && src.size != 16)) {
        ret x64_vec_refused(c, s, "' takes a whole 128-bit memory operand, written bare or as `xmmword [...]`",
            "an inline-asm vector instruction takes a whole 128-bit memory operand, written bare or as `xmmword [...]`");
    }
    if (with_imm) {
        val imm: *iasm.Operand = ?item.ops[2];
        if (imm.kind != iasm.AOP_IMM || imm.imm < 0 || imm.imm > 255) {
            ret x64_vec_refused(c, s, "' takes an immediate from 0 to 255 as its third operand",
                "an inline-asm vector instruction takes an immediate from 0 to 255 as its third operand");
        }
    }

    if ((dst.flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = dst.name_off;
        item.ref_len = dst.name_len;
    }
    or ((src.flags & iasm.AOF_MEM_SYM) != 0) {
        item.ref     = iasm.AR_SYM;
        item.ref_off = src.name_off;
        item.ref_len = src.name_len;
    }
    ret err[fail.Fail].ok{};
}

fun x64_check_widths(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val cls: u16 = x64_width_class(s.m.flags);

    if (cls == X64W_UNSIZED) {
        if (x64_sized_operand(item) != 0) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' takes no operand-size prefix: its memory operand names no scalar width",
                "an inline-asm instruction takes no operand-size prefix: its memory operand names no scalar width"))};
        }
        ret err[fail.Fail].ok{};
    }

    if (cls == X64W_FIXED64) {
        val w: u8 = x64_sized_operand(item);
        if (w != 0 && w != 8) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' has a fixed 64-bit operand size in long mode, so a narrower operand-size prefix names no instruction",
                "an inline-asm instruction has a fixed 64-bit operand size in long mode, so a narrower operand-size prefix names no instruction"))};
        }
        ret err[fail.Fail].ok{};
    }

    if (cls == X64W_NARROW) { ret x64_check_narrow(c, s, item); }

    val rw: u8 = x64_register_width(item);
    if (rw == 0) { ret err[fail.Fail].ok{}; }
    val form:  x64.Form = x64.describe(s.m.code::u16).form;
    var count: u32      = item.nops;
    if (form == x64.FORM_SHIFT)  { count = 1; }
    if (form == x64.FORM_DSHIFT) { count = 2; }
    var i: u32 = 0;
    for (i < item.nops) {
        val op: *iasm.Operand = ?item.ops[i::usize];
        val w:  u8            = op.size;
        if (op.kind == iasm.AOP_MEM && w != 0 && w != rw) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' names an operand-size prefix that contradicts the width its register operand states",
                "an inline-asm instruction names an operand-size prefix that contradicts the width its register operand states"))};
        }
        # a uniform row takes one width across its general-purpose registers; the count of a shift is the exception
        if (op.kind == iasm.AOP_REG && !iasm.is_vreg(op) && w != rw && i != count) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
                "' names register operands of two widths, which no form of it takes",
                "an inline-asm instruction names register operands of two widths, which no form of it takes"))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun x64_check_narrow(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val dst: *iasm.Operand = ?item.ops[0];
    val src: *iasm.Operand = ?item.ops[1];
    if (dst.kind != iasm.AOP_REG) {
        ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
            "' must extend into a register destination",
            "an inline-asm extending move must extend into a register destination"))};
    }
    if (src.kind == iasm.AOP_MEM && src.size == 0) {
        ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
            "' does not state the width of its memory source; write it as `byte [...]`, `word [...]` or `dword [...]`",
            "an inline-asm extending move does not state the width of its memory source; write it as `byte [...]`, `word [...]` or `dword [...]`"))};
    }
    val sw: u8 = src.size;
    if (sw == 0) { ret err[fail.Fail].ok{}; }
    if (sw >= dst.size) {
        ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
            "' names a source at least as wide as its destination, which extends nothing",
            "an inline-asm extending move names a source at least as wide as its destination, which extends nothing"))};
    }
    if (s.m.code == x64.MOVZX::u32 && sw != 1 && sw != 2) {
        ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm instruction '",
            "' has no 32-bit source form; a 32-bit move already zero-extends, so write `mov` instead",
            "inline-asm `movzx` has no 32-bit source form; a 32-bit move already zero-extends, so write `mov` instead"))};
    }
    ret err[fail.Fail].ok{};
}

fun x64_sized_operand(item: *iasm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        val op: *iasm.Operand = ?item.ops[i::usize];
        if (op.kind == iasm.AOP_MEM && op.size != 0) { ret op.size; }
        i = i + 1;
    }
    ret 0;
}

fun x64_register_width(item: *iasm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        if (item.ops[i::usize].kind == iasm.AOP_REG) { ret item.ops[i::usize].size; }
        i = i + 1;
    }
    ret 0;
}

fun x64_named_message(c: *iasm.Cursor, s: *iasm.Stmt, prefix: str, suffix: str, fallback: str) str {
    ret iasm.named_message(c.alloc, c.interner, prefix, s.m.name, suffix, fallback);
}

fun x64_mov_sysreg(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) res[bool, fail.Fail] {
    var dbuf: [32]u8;
    var sbuf: [32]u8;
    if (!iasm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?dbuf[0], 32)) { ret res[bool, fail.Fail].ok{false}; }
    if (!iasm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?sbuf[0], 32)) { ret res[bool, fail.Fail].ok{false}; }
    val dtok: str = (?dbuf[0])::str;
    val stok: str = (?sbuf[0])::str;

    var dnum:    i64  = 0;
    var snum:    i64  = 0;
    val dst_cr:  bool = x64_ctlreg(dtok, ?dnum);
    val src_cr:  bool = x64_ctlreg(stok, ?snum);
    val dst_seg: bool = x64_segreg(dtok, ?dnum);
    val src_seg: bool = x64_segreg(stok, ?snum);
    if (!dst_cr && !src_cr && !dst_seg && !src_seg) { ret res[bool, fail.Fail].ok{false}; }
    if ((dst_cr || dst_seg) && (src_cr || src_seg)) {
        ret res[bool, fail.Fail].err{iasm.reject(c, "inline-asm `mov` cannot move between two system registers; go through a general-purpose register")};
    }

    if (dst_seg) {
        ret res[bool, fail.Fail].err{iasm.reject(c, "inline-asm `mov` into a segment register is unsupported; only reading one (`mov eax, cs`) is")};
    }

    var gp:     iasm.Operand = iasm.op_none();
    var gp_lo:  usize        = s.arg_lo[0];
    var gp_hi:  usize        = s.arg_hi[0];
    var gp_tok: str          = dtok;
    if (dst_cr) {
        gp_lo  = s.arg_lo[1];
        gp_hi  = s.arg_hi[1];
        gp_tok = stok;
    }
    if (!x64_reg(gp_tok, ?gp)) {
        ret res[bool, fail.Fail].err{iasm.reject(c, iasm.span_message(c,
            "inline-asm system-register move names '", gp_lo, gp_hi,
            "' where a general-purpose register is required",
            "an inline-asm system-register move requires a general-purpose register on its other side"))};
    }

    if (src_cr || dst_cr) {
        if (gp.size != 8) {
            ret res[bool, fail.Fail].err{iasm.reject(c, "inline-asm control-register move requires a 64-bit general-purpose register")};
        }
        item.code = x64.MOV_CR::u32;
    }
    or { item.code = x64.MOV_SEG::u32; }

    if (dst_cr) {
        item.ops[0] = iasm.op_imm(dnum, 8);
        item.ops[1] = gp;
    }
    or {
        item.ops[0] = gp;
        item.ops[1] = iasm.op_imm(snum, 8);
    }
    ret res[bool, fail.Fail].ok{true};
}

fun x64_xfer_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val lo: usize = s.arg_lo[0];
    val hi: usize = s.arg_hi[0];

    var seg: u8             = x64.SEG_NONE;
    var at:  usize          = lo;
    val sr:  err[fail.Fail] = x64_segment(c, lo, hi, ?seg, ?at);
    if (sel sr.err) { ret sr; }
    if (x64_bracketed(c, at, hi)) {
        val r: err[fail.Fail] = x64_seg_mem(c, at, hi, seg, "", ?item.ops[0]);
        if (sel r.err) { ret r; }
        if ((item.ops[0].flags & iasm.AOF_MEM_SYM) != 0) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm indirect '",
                "' through a symbol's address is unsupported; name the symbol directly for a direct transfer, or load the address into a register",
                "an inline-asm indirect control transfer through a symbol's address is unsupported; name the symbol directly for a direct transfer, or load the address into a register"))};
        }
        item.flags = item.flags | X64F_INDIRECT;
        ret err[fail.Fail].ok{};
    }

    var buf:    [32]u8;
    var reg_op: iasm.Operand = iasm.op_none();
    if (iasm.copy_region(c.body, lo, hi, ?buf[0], 32) && x64_reg((?buf[0])::str, ?reg_op)) {
        if (reg_op.size != 8) {
            ret err[fail.Fail].err{iasm.reject(c, x64_named_message(c, s, "inline-asm indirect '",
                "' requires a 64-bit register",
                "an inline-asm indirect control transfer requires a 64-bit register"))};
        }
        item.ops[0] = reg_op;
        item.flags  = item.flags | X64F_INDIRECT;
        ret err[fail.Fail].ok{};
    }

    ret x64_branch_target(c, s, item);
}

fun x64_branch_target(c: *iasm.Cursor, s: *iasm.Stmt, item: *iasm.Item) err[fail.Fail] {
    val lo:  usize = s.arg_lo[0];
    val hi:  usize = s.arg_hi[0];
    var num: u64   = 0;
    var fwd: bool  = false;
    if (iasm.label_ref_span(c.body, lo, hi, ?num, ?fwd)) {
        item.ref     = iasm.AR_LOCAL;
        item.ref_num = num;
        item.ref_fwd = fwd;
        ret err[fail.Fail].ok{};
    }
    if (iasm.is_digit(c.body[lo])) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm numeric local-label reference must be '<digits>f' or '<digits>b'")};
    }
    if (!iasm.is_sym_region(c.body, lo, hi)) {
        ret err[fail.Fail].err{iasm.reject(c, "inline-asm branch target is not a symbol")};
    }
    item.ref     = iasm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret err[fail.Fail].ok{};
}

fun x64_to_isa(op: *iasm.Operand, size: u8, sym: intern.StrId) isa.Operand {
    if (op.kind == iasm.AOP_REG) { ret isa.make_reg(op.reg, size); }
    if (op.kind == iasm.AOP_IMM) { ret isa.make_imm(op.imm, size); }
    if (op.kind == iasm.AOP_MEM) {
        if ((op.flags & iasm.AOF_MEM_SYM) != 0) {
            var m: isa.Operand = isa.make_mem(-1, 0, -1, 0, size);
            m.sym_id = sym::u32;
            ret m;
        }
        var m: isa.Operand = isa.make_mem(op.reg, op.imm::i32, op.index, op.scale, size);
        if ((op.flags & iasm.AOF_MEM_ABS) != 0) { m = isa.make_mem(x64.MEM_BASE_ABS, op.imm::i32, -1, 0, size); }
        m.seg = op.seg;
        ret m;
    }
    ret isa.make_none();
}

fun x64_build(item: *iasm.Item, sym: intern.StrId) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = item.code::u16;
    var enc_flags: u16 = 0;
    if ((item.flags & X64F_LOCK) != 0) { enc_flags = x64.FLAG_LOCK::u16; }

    val pat: u16 = x64_pattern(item.flags);
    if (item.ref == iasm.AR_LOCAL && item.ref_fwd) { enc_flags = enc_flags | x64.FLAG_LOCAL_FWD::u16; }
    if (pat == X64P_NONE || pat == X64P_BRANCH) {
        mi.flags = enc_flags;
        ret mi;
    }
    if (pat == X64P_XFER) {
        if ((item.flags & X64F_INDIRECT) == 0) {
            mi.flags = enc_flags;
            if (item.ref == iasm.AR_SYM) { mi.dst = isa.make_sym(sym::u32, 8); }
            ret mi;
        }
        mi.size  = 8;
        mi.flags = enc_flags | x64.FLAG_INDIRECT::u16;
        mi.dst   = x64_to_isa(?item.ops[0], 8, sym);
        ret mi;
    }

    if (pat == X64P_PORTIO) {
        mi.flags = enc_flags;
        mi.dst   = x64_to_isa(?item.ops[0], item.ops[0].size, sym);
        mi.src1  = x64_to_isa(?item.ops[1], item.ops[1].size, sym);
        ret mi;
    }

    if (item.code == x64.MOV_CR::u32) {
        mi.size  = 8;
        mi.flags = enc_flags;
        mi.dst   = x64_to_isa(?item.ops[0], 8, sym);
        mi.src1  = x64_to_isa(?item.ops[1], 8, sym);
        ret mi;
    }

    val size: u8 = x64_inst_size(item);
    mi.size  = size;
    mi.flags = width_flags_for(size) | enc_flags;
    mi.dst   = x64_to_isa(?item.ops[0], x64_operand_size(?item.ops[0], size), sym);
    if (pat == X64P_TWO) { mi.src1 = x64_to_isa(?item.ops[1], x64_operand_size(?item.ops[1], size), sym); }
    if (pat == X64P_TRIPLE) {
        mi.src1 = x64_to_isa(?item.ops[1], x64_operand_size(?item.ops[1], size), sym);
        if (item.nops == 3) {
            val cnt: *iasm.Operand = ?item.ops[2];
            if (cnt.kind == iasm.AOP_REG) { mi.src2 = isa.make_reg(cnt.reg, cnt.size); }
            or                            { mi.src2 = isa.make_imm(cnt.imm, size); }
        }
    }
    ret mi;
}

fun x64_inst_size(item: *iasm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        if (item.ops[i::usize].kind == iasm.AOP_REG) { ret item.ops[i::usize].size; }
        i = i + 1;
    }
    i = 0;
    for (i < item.nops) {
        val op: *iasm.Operand = ?item.ops[i::usize];
        if (op.kind == iasm.AOP_MEM && op.size != 0) { ret op.size; }
        i = i + 1;
    }
    ret 8;
}

fun x64_operand_size(op: *iasm.Operand, inst_size: u8) u8 {
    if (op.kind == iasm.AOP_MEM && op.size != 0) { ret op.size; }
    ret inst_size;
}

fun x64_emit(st: *enc.EncodeState, c: *iasm.Cursor, l: *iasm.Labels, item: *iasm.Item) err[fail.Fail] {
    var sym: intern.StrId = intern.STR_NIL;
    if (item.ref == iasm.AR_SYM) {
        val name: str                        = (c.body::usize + item.ref_off)::str;
        val symr: res[intern.StrId, A.Error] = intern.intern_bytes(st.interner, name, item.ref_len);
        if (sel symr.err) { ret err[fail.Fail].err{fail.refused(symr.err)}; }
        sym = symr.ok;
    }

    val pat: u16 = x64_pattern(item.flags);
    if (pat == X64P_VEC || pat == X64P_VECI) { ret x64_emit_vec(st, item, sym); }
    if (pat == X64P_VECG)                    { ret x64_emit_vec_gp(st, item, sym); }

    var mi: isa.Inst = x64_build(item, sym);

    val inst_start: usize = st.buf.len;
    val n:          i32   = encode_inst(?mi, ?st.buf);
    if (n <= 0) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction encoded to no bytes")}; }

    if (item.ref == iasm.AR_LOCAL) {
        ret iasm.resolve_local(st, c, l, (inst_start + (n - 4)::usize)::u32, item.ref_num, item.ref_fwd);
    }
    if (item.ref == iasm.AR_SYM) { ret x64_emit_sym_ref(st, ?mi, sym, inst_start, n); }
    ret err[fail.Fail].ok{};
}

fun x64_emit_sym_ref(st: *enc.EncodeState, mi: *isa.Inst, sym: intern.StrId,
    inst_start: usize, n: i32) err[fail.Fail] {
    val patch: i32 = x86_reloc_offset(nil, mi, n);
    if (patch < 0) {
        ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm symbol reference has no relocation field")};
    }

    ret x64_push_pc32(st, sym, inst_start, patch, n);
}

# a pc-relative field at patch within an n-byte instruction, relative to the instruction's end
fun x64_push_pc32(st: *enc.EncodeState, sym: intern.StrId, inst_start: usize, patch: i32, n: i32) err[fail.Fail] {
    val pushed: err[fail.Fail] = enc.push_reloc(st, (inst_start + patch::usize)::u32, of.RK_PC32, sym, -(n - patch)::i64);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun x64_vec_operand(op: *iasm.Operand, sym: intern.StrId) isa.Operand {
    if (iasm.is_vreg(op)) { ret vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, op.reg)); }
    ret x64_to_isa(op, 16, sym);
}

fun x64_emit_vec(st: *enc.EncodeState, item: *iasm.Item, sym: intern.StrId) err[fail.Fail] {
    val op:    u16            = item.code::u16;
    val dst:   isa.Operand    = x64_vec_operand(?item.ops[0], sym);
    val src:   isa.Operand    = x64_vec_operand(?item.ops[1], sym);
    val start: usize          = st.buf.len;
    val with:  bool           = x64_pattern(item.flags) == X64P_VECI;
    val r:     err[fail.Fail] = x64_emit_vec_body(item, op, dst, src, ?st.buf);
    if (sel r.err)               { ret r; }
    if (item.ref != iasm.AR_SYM) { ret err[fail.Fail].ok{}; }
    var tail: i32 = 0;
    if (with) { tail = 1; }
    val n: i32 = (st.buf.len - start)::i32;
    ret x64_push_pc32(st, sym, start, n - tail - 4, n);
}

fun x64_emit_vec_body(item: *iasm.Item, op: u16, dst: isa.Operand, src: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    if (x64_pattern(item.flags) == X64P_VECI) { ret emit_packed_imm(op, dst.reg, src, item.ops[2].imm::u8, buf); }
    if ((item.flags & X64F_VSTORE) != 0)      { ret emit_vec_move(op, dst, src, buf); }
    ret emit_packed_op(op, dst.reg, src, buf);
}

fun x64_patch(st: *enc.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    patch_rel32(?st.buf, patch_pos::usize, target_off::i32 - (patch_pos + 4)::i32);
    ret err[fail.Fail].ok{};
}

fun x64_grammar() iasm.Grammar {
    var g: iasm.Grammar;
    g.isa        = "x86_64";
    g.unknown    = "unknown x86_64 inline-asm instruction '";
    g.rows       = ?X64_MNEMONICS[0];
    g.row_count  = X64_MNEMONIC_COUNT;
    g.data       = ?iasm.DIRECTIVES_WORD16[0];
    g.data_count = iasm.DIRECTIVE_COUNT;
    g.decode     = nil;
    g.parse      = x64_parse;
    g.emit       = x64_emit;
    g.patch      = x64_patch;
    g.slot       = frame_slot_offset;
    g.slot_sp    = x64_slot_from_sp;
    g.writes_sp  = x64_writes_sp;
    g.all_gp     = X64_ALL_GP;
    g.all_fp     = X64_ALL_FP;
    g.word       = 0;
    g.endian     = isa.ENDIAN_LITTLE;
    g.ct_class   = asm_ct_class;
    g.note_bytes = asm_note_bytes;
    g.decl_reg   = x64_decl_reg;
    g.no_fall    = x64_no_fall;
    ret g;
}

fun x64_no_fall(item: *iasm.Item) bool {
    if (item.kind != iasm.AI_INST) { ret false; }
    ret item.code == x64.HLT::u32;
}

pub fun asm_returns(body: str) bool {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.returns(?g, body);
}

fun x64_slot_from_sp(f: *mir.MirFunction) bool {
    ret codegen_frame.slots_from_sp(?f.frame);
}

fun x64_writes_sp(item: *iasm.Item) bool {
    if (item.kind == iasm.AI_LABEL) { ret false; }
    if (item.kind == iasm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << x64.RSP::u32)) != 0; }
        ret true;
    }
    if ((item.implicit & (1::u32 << x64.RSP::u32)) != 0)                                 { ret true; }
    if ((item.writes & iasm.AW_OP0) != 0 && item.nops > 0 && x64_op_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & iasm.AW_OP1) != 0 && item.nops > 1 && x64_op_is_sp(?item.ops[1])) { ret true; }
    ret false;
}

fun x64_op_is_sp(op: *iasm.Operand) bool {
    ret op.kind == iasm.AOP_REG && op.bank == iasm.ABANK_GP && op.reg == x64.RSP;
}

fun x64_decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: iasm.Operand = iasm.op_none();
    if (x64_reg(name, ?op) && op.size == 8 && op.reg >= 0) {
        @bank = iasm.ABANK_GP;
        @idx  = op.reg::u32;
        ret true;
    }
    var n: i32 = 0;
    if (x64_xmm_index(name, ?n)) {
        @bank = iasm.ABANK_FP;
        @idx  = n::u32;
        ret true;
    }
    ret false;
}

fun x64_xmm_index(name: str, out: *i32) bool {
    var i: i32 = 0;
    for (i < x64.FP_COUNT) {
        if (str_equals(name, x64.fp_reg_name(i))) {
            @out = i;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

pub fun asm_writes_sp(body: str) bool {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.writes_sp(?g, body);
}

pub fun asm_clobbers(body: str, gp_out: *u32, fp_out: *u32) {
    var g: iasm.Grammar = x64_grammar();
    iasm.clobbers(?g, body, gp_out, fp_out);
}

fun encode_asm_block(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.encode_block(st, ?g, f, mi);
}

#[testing]
fun x64_asm_text(st: *enc.EncodeState, f: *mir.MirFunction, l: *iasm.Labels, text: str) err[fail.Fail] {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, text, st.alloc, st.interner, f, nil);
    ret iasm.run(st, ?g, ?c, l);
}

fun width_flags_for(size: u8) u16 {
    if (size == 8) { ret x64.FLAG_REX_W::u16; }
    if (size == 2) { ret x64.FLAG_16BIT::u16; }
    ret 0;
}

#[testing]
var t_model_x64: isa.MachineModel;

#[testing]
fun x64_machine() *isa.MachineModel {
    t_model_x64.extension_table = ?x64.EXTENSIONS[0];
    t_model_x64.extension_count = x64.EXTENSION_COUNT;
    t_model_x64.pointer_width   = 8;
    t_model_x64.gpr_width       = 8;
    t_model_x64.max_alu_width   = 8;
    t_model_x64.alu_min_width   = 4;
    t_model_x64.spill_width     = 8;
    t_model_x64.flen_bits       = 64;
    ret ?t_model_x64;
}

#[testing]
fun t_asm_bytes(body: str, want: *u8, n: usize) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = nil;

    var g:      iasm.Grammar = x64_grammar();
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, ?alloc, nil, nil, nil);

    val rr: err[fail.Fail] = iasm.run(?st, ?g, ?c, ?labels);
    if (sel rr.err) { ret false; }

    if (st.buf.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (st.buf.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_asm_refused(body: str, want: str) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, ?alloc, nil, nil, nil);

    var item: iasm.Item;
    val pr:   res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (!sel pr.err) { ret false; }
    ret str_contains(fail.describe(pr.err), want);
}

#[testing]
fun t_nibble(c: u8) u8 {
    if (c >= '0'::u8 && c <= '9'::u8) { ret c - '0'::u8; }
    ret c - 'a'::u8 + 10;
}

# decode lowercase hex into want, returning the byte count
#[testing]
fun t_unhex(hex: str, want: *u8) usize {
    val len: usize = str_len(hex);
    var i:   usize = 0;
    for (i + 1 < len) {
        want[i / 2] = (t_nibble(hex[i]::u8) << 4) | t_nibble(hex[i + 1]::u8);
        i           = i + 2;
    }
    ret len / 2;
}

#[testing]
fun t_asm_hex(body: str, hex: str) bool {
    var want: [32]u8;
    val n:    usize = t_unhex(hex, ?want[0]);
    ret t_asm_bytes(body, ?want[0], n);
}

# the bytes of a one-instruction body, and its single pc32 relocation against sym
#[testing]
fun t_asm_reloc(body: str, hex: str, offset: u32, addend: i64) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var st:  enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?itn;

    var g:      iasm.Grammar = x64_grammar();
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, ?alloc, ?itn, nil, nil);
    val rr: err[fail.Fail] = iasm.run(?st, ?g, ?c, ?labels);
    if (sel rr.err) { ret false; }

    var want: [32]u8;
    val n:    usize = t_unhex(hex, ?want[0]);
    if (st.buf.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (st.buf.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    if (st.reloc_count != 1)             { ret false; }
    if (st.relocs[0].kind != of.RK_PC32) { ret false; }
    if (st.relocs[0].offset != offset)   { ret false; }
    if (st.relocs[0].addend != addend)   { ret false; }
    val name: opt[str] = intern.lookup(?itn, st.relocs[0].sym);
    if (sel name.none) { ret false; }
    ret str_equals(name.some, "tbl");
}

# goldens from GNU as 2.42 (intel syntax), each form in both rex and non-rex registers
test asm_vector__byte_exact {
    var bad: i32 = 0;
    if (!t_asm_hex("movdqu xmm0, [rsi]", "f30f6f06"))                          { bad = 1; }
    if (!t_asm_hex("movdqu [rdi+8], xmm9", "f3440f7f4f08"))                    { bad = 2; }
    if (!t_asm_hex("movdqa xmm1, xmm12", "66410f6fcc"))                        { bad = 3; }
    if (!t_asm_hex("movaps xmm2, xmm3", "0f28d3"))                             { bad = 4; }
    if (!t_asm_hex("movups [rsp], xmm15", "440f113c24"))                       { bad = 5; }
    if (!t_asm_hex("paddd xmm0, xmm1", "660ffec1"))                            { bad = 6; }
    if (!t_asm_hex("pxor xmm8, [r12+rax*4+16]", "66450fef448410"))             { bad = 7; }
    if (!t_asm_hex("pand xmm1, xmm2", "660fdbca"))                             { bad = 8; }
    if (!t_asm_hex("por xmm3, xmm4", "660febdc"))                              { bad = 9; }
    if (!t_asm_hex("pshufd xmm0, xmm1, 0x1b", "660f70c11b"))                   { bad = 10; }
    if (!t_asm_hex("pshufd xmm10, [rbx], 255", "66440f7013ff"))                { bad = 11; }
    if (!t_asm_hex("cmpps xmm1, xmm2, 2", "0fc2ca02"))                         { bad = 12; }
    if (!t_asm_hex("addpd xmm5, xmm14", "66410f58ee"))                         { bad = 13; }
    if (!t_asm_hex("movdqa xmm0, xmm1\npaddq xmm0, xmm0", "660f6fc1660fd4c0")) { bad = 14; }
    # the listing --emit-asm writes reads back
    if (!t_asm_hex("movdqa xmmword [rdi + 8], xmm9", "66440f7f4f08"))   { bad = 15; }
    if (!t_asm_hex("pshufd xmm10, xmmword [rbx], 255", "66440f7013ff")) { bad = 16; }
    ret bad;
}

test asm_vector__symbol_operands_relocate_past_the_immediate {
    var bad: i32 = 0;
    if (!t_asm_reloc("movdqu xmm2, [tbl]", "f30f6f1500000000", 4, -4))         { bad = 1; }
    if (!t_asm_reloc("pshufd xmm3, [tbl], 0x93", "660f701d0000000093", 4, -5)) { bad = 2; }
    if (!t_asm_reloc("movdqa [tbl], xmm11", "66440f7f1d00000000", 5, -4))      { bad = 3; }
    ret bad;
}

test asm_vector__refuses_operands_outside_the_form {
    var bad: i32 = 0;
    if (!t_asm_refused("mov rax, xmm0", "takes general-purpose registers"))                     { ret 1; }
    if (!t_asm_refused("inc xmmword [rax]", "names an xmmword operand"))                        { ret 14; }
    if (!t_asm_refused("mov rax, xmmword [rax]", "names an xmmword operand"))                   { ret 15; }
    if (!t_asm_refused("push xmm3", "takes general-purpose registers"))                         { ret 2; }
    if (!t_asm_refused("paddd rax, xmm1", "writes a vector register destination"))              { ret 3; }
    if (!t_asm_refused("paddd [rax], xmm1", "writes a vector register destination"))            { ret 4; }
    if (!t_asm_refused("pxor xmm0, rax", "takes a vector register or memory source"))           { ret 5; }
    if (!t_asm_refused("movdqu [rax], [rbx]", "stores into memory only from a vector"))         { ret 6; }
    if (!t_asm_refused("movdqu xmm0, qword [rax]", "whole 128-bit memory operand"))             { ret 7; }
    if (!t_asm_refused("pshufd xmm0, xmm1", "8-bit immediate"))                                 { ret 8; }
    if (!t_asm_refused("pshufd xmm0, xmm1, 256", "immediate from 0 to 255"))                    { ret 9; }
    if (!t_asm_refused("paddd xmm0, xmm1, 3", "expects two operands"))                          { ret 10; }
    if (!t_asm_refused("paddd xmm0, 5", "takes a vector register or memory source"))            { ret 11; }
    if (!t_asm_refused("movdqu xmm0, [xmm1]", "names a vector register, which cannot address")) { ret 12; }
    if (!t_asm_refused("movdqu xmm16, xmm0", "writes a vector register or memory"))             { ret 13; }
    ret bad;
}

test asm_clobbers__vector_writes_land_in_the_fp_mask {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("movdqu xmm3, [rdi]\npaddd xmm3, xmm9\nmovdqu [rdi], xmm3", ?gp, ?fp);
    if (gp != 0)             { bad = 1; }
    if (fp != (1::u32 << 3)) { bad = 2; }

    asm_clobbers("pshufd xmm12, xmm4, 0", ?gp, ?fp);
    if (gp != 0 || fp != (1::u32 << 12)) { bad = 3; }

    asm_clobbers("movdqu [rsp], xmm4\nmovaps xmm4, {v}", ?gp, ?fp);
    if (gp != 0 || fp != (1::u32 << 4)) { bad = 4; }

    asm_clobbers("mov rax, rbx\npxor xmm0, xmm0", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32) || fp != 1) { bad = 5; }
    ret bad;
}

# xmm4 shares rsp's index, so a vector write must not read as a stack-pointer write
test asm_vector__xmm4_is_not_the_stack_pointer {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "movdqa xmm4, xmm0", nil, nil, nil, nil);
    var item: iasm.Item;
    val pr:   res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel pr.err)           { ret 1; }
    if (x64_writes_sp(?item)) { ret 2; }
    ret 0;
}

#[testing]
fun t_asm_item(body: str, item: *iasm.Item) bool {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, nil, nil, nil, nil);
    val pr: res[bool, fail.Fail] = iasm.next(?c, item);
    if (sel pr.err) { ret false; }
    ret pr.ok;
}

# goldens from GNU as 2.47 (intel syntax): the override leads every other prefix
test asm_segment__byte_exact {
    var bad: i32 = 0;
    if (!t_asm_hex("mov rax, fs:[0x28]", "64488b042528000000"))              { bad = 1; }
    if (!t_asm_hex("mov rax, qword fs:[rbx + 8]", "64488b4308"))             { bad = 2; }
    if (!t_asm_hex("mov qword gs:[r12+rax*4+16], r9", "654d894c8410"))       { bad = 3; }
    if (!t_asm_hex("mov eax, gs:[0]", "658b042500000000"))                   { bad = 4; }
    if (!t_asm_hex("mov byte fs:[rcx], 5", "64c60105"))                      { bad = 5; }
    if (!t_asm_hex("add rdx, gs:[16]", "654803142510000000"))                { bad = 6; }
    if (!t_asm_hex("cmp dword fs:[r13], 7", "6441837d0007"))                 { bad = 7; }
    if (!t_asm_hex("movzx eax, word fs:[rdi]", "640fb707"))                  { bad = 8; }
    if (!t_asm_hex("inc qword gs:[rax]", "6548ff00"))                        { bad = 9; }
    if (!t_asm_hex("lock xadd qword fs:[rsi], rcx", "64f0480fc10e"))         { bad = 10; }
    if (!t_asm_hex("movdqu xmm0, gs:[0]", "65f30f6f042500000000"))           { bad = 11; }
    if (!t_asm_hex("movdqu gs:[16], xmm9", "65f3440f7f0c2510000000"))        { bad = 12; }
    if (!t_asm_hex("pshufd xmm10, xmmword fs:[rbx], 255", "6466440f7013ff")) { bad = 13; }
    if (!t_asm_hex("mov word fs:[rax], 3", "6466c7000300"))                  { bad = 14; }
    if (!t_asm_hex("jmp fs:[0x10]", "64ff242510000000"))                     { bad = 15; }
    if (!t_asm_hex("call gs:[rax + 8]", "65ff5008"))                         { bad = 16; }
    if (!t_asm_hex("lidt fs:[rax]", "640f0118"))                             { bad = 17; }
    if (!t_asm_hex("test qword gs:[rax], rcx", "65488508"))                  { bad = 18; }
    if (!t_asm_hex("xchg rax, qword fs:[rbx]", "64488703"))                  { bad = 19; }
    if (!t_asm_hex("mov rax, fs:  [0x28]", "64488b042528000000"))            { bad = 20; }
    # the listing --emit-asm writes reads back
    if (!t_asm_hex("mov rax, qword fs:[40]", "64488b042528000000"))           { bad = 21; }
    if (!t_asm_hex("movdqu xmmword gs:[16], xmm9", "65f3440f7f0c2510000000")) { bad = 22; }
    ret bad;
}

# the override rides the operand, so a form the grammar does not reach still carries it,
# and an address operand refuses it before any byte
test segment_override__rides_the_operand {
    var bad: i32      = 0;
    var ss:  isa.Inst = isa.inst_blank();
    ss.opcode   = x64.MOVSS;
    ss.size     = 4;
    ss.dst      = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 1), 4);
    ss.src1     = isa.make_mem(x64.RAX, 0, -1, 0, 4);
    ss.src1.seg = x64.SEG_GS;
    var want: [5]u8;
    want[0] = 0x65;
    want[1] = 0xF3;
    want[2] = 0x0F;
    want[3] = 0x10;
    want[4] = 0x08;
    if (!t_inst_bytes(?ss, ?want[0], 5)) { bad = 1; }

    var lea: isa.Inst = isa.inst_blank();
    lea.opcode   = x64.LEA;
    lea.size     = 8;
    lea.flags    = x64.FLAG_REX_W::u16;
    lea.dst      = isa.make_reg(x64.RAX, 8);
    lea.src1     = isa.make_mem(x64.RBX, 8, -1, 0, 8);
    lea.src1.seg = x64.SEG_FS;
    if (!t_inst_refused(?lea)) { bad = 2; }
    lea.src1.seg = x64.SEG_NONE;
    if (t_inst_refused(?lea)) { bad = 3; }

    # a row that takes no memory operand refuses after the prefix, which is withdrawn
    var set: isa.Inst = isa.inst_blank();
    set.opcode  = x64.SETE;
    set.size    = 1;
    set.dst     = isa.make_mem(x64.RAX, 0, -1, 0, 1);
    set.dst.seg = x64.SEG_FS;
    if (!t_inst_refused(?set)) { bad = 4; }
    ret bad;
}

test asm_base_register__byte_exact_under_fsgsbase {
    var bad: i32 = 0;
    if (!t_ext_hex("rdfsbase eax", "f30faec0"))   { bad = 1; }
    if (!t_ext_hex("rdfsbase rax", "f3480faec0")) { bad = 2; }
    if (!t_ext_hex("rdgsbase r9d", "f3410faec9")) { bad = 3; }
    if (!t_ext_hex("rdgsbase r15", "f3490faecf")) { bad = 4; }
    if (!t_ext_hex("wrfsbase ecx", "f30faed1"))   { bad = 5; }
    if (!t_ext_hex("wrfsbase r8", "f3490faed0"))  { bad = 6; }
    if (!t_ext_hex("wrgsbase esp", "f30faedc"))   { bad = 7; }
    if (!t_ext_hex("wrgsbase rsp", "f3480faedc")) { bad = 8; }
    ret bad;
}

# the bit-scan family and bswap, byte-exact against gas (#3724)
test asm_bitscan__byte_exact {
    var bad: i32 = 0;
    if (!t_ext_hex("popcnt rax, rax", "f3480fb8c0"))               { bad = 1; }
    if (!t_ext_hex("popcnt eax, ecx", "f30fb8c1"))                 { bad = 2; }
    if (!t_ext_hex("popcnt r9w, ax", "66f3440fb8c8"))              { bad = 3; }
    if (!t_ext_hex("popcnt rdx, qword [rdi + 8]", "f3480fb85708")) { bad = 4; }
    if (!t_asm_hex("bsf rax, rcx", "480fbcc1"))                    { bad = 5; }
    if (!t_asm_hex("bsr rdx, qword [rdi]", "480fbd17"))            { bad = 6; }
    if (!t_asm_hex("bsf ax, bx", "660fbcc3"))                      { bad = 7; }
    if (!t_ext_hex("tzcnt r8, r9", "f34d0fbcc1"))                  { bad = 8; }
    if (!t_ext_hex("lzcnt eax, dword [rsi + 8]", "f30fbd4608"))    { bad = 9; }
    if (!t_ext_hex("lzcnt r15w, r14w", "66f3450fbdfe"))            { bad = 10; }
    if (!t_asm_hex("bswap rax", "480fc8"))                         { bad = 11; }
    if (!t_asm_hex("bswap eax", "0fc8"))                           { bad = 12; }
    if (!t_asm_hex("bswap r12", "490fcc"))                         { bad = 13; }
    if (!t_asm_hex("bswap r10d", "410fca"))                        { bad = 14; }
    ret bad;
}

test asm_bitscan__refuses_operands_outside_the_form {
    var bad: i32 = 0;
    if (!t_asm_refused("bsf al, bl", "bit scan"))       { bad = 1; }
    if (!t_asm_refused("bsf rax, 5", "bit scan"))       { bad = 2; }
    if (!t_asm_refused("bsf [rax], rcx", "bit scan"))   { bad = 3; }
    if (!t_asm_refused("bswap ax", "32- or 64-bit"))    { bad = 4; }
    if (!t_asm_refused("bswap [rax]", "32- or 64-bit")) { bad = 5; }
    if (!t_asm_refused("bsf rax, ecx", "two widths"))   { bad = 6; }
    if (!t_asm_refused("add rax, ecx", "two widths"))   { bad = 7; }
    if (!t_asm_refused("mov ax, r8d", "two widths"))    { bad = 8; }
    if (!t_asm_hex("shl rax, cl", "48d3e0"))            { bad = 9; }
    ret bad;
}

# imul in its two- and three-operand forms, shld and shrd, byte-exact against gas (#3724)
test asm_triple__byte_exact {
    var bad: i32 = 0;
    if (!t_asm_hex("imul rax, rcx", "480fafc1"))                       { bad = 1; }
    if (!t_asm_hex("imul rax, rcx, 5", "486bc105"))                    { bad = 2; }
    if (!t_asm_hex("imul eax, dword [rdi], 300", "69072c010000"))      { bad = 3; }
    if (!t_asm_hex("imul rax, rax, -1", "486bc0ff"))                   { bad = 4; }
    if (!t_asm_hex("imul r9, r10, 1000", "4d69cae8030000"))            { bad = 5; }
    if (!t_asm_hex("imul ax, bx, 7", "666bc307"))                      { bad = 6; }
    if (!t_asm_hex("imul rax, qword [rbx + 16]", "480faf4310"))        { bad = 7; }
    if (!t_asm_hex("shld rax, rcx, 5", "480fa4c805"))                  { bad = 8; }
    if (!t_asm_hex("shld rax, rcx, cl", "480fa5c8"))                   { bad = 9; }
    if (!t_asm_hex("shrd qword [rdi], rax, 3", "480fac0703"))          { bad = 10; }
    if (!t_asm_hex("shrd eax, edx, cl", "0fadd0"))                     { bad = 11; }
    if (!t_asm_hex("shld ax, bx, 1", "660fa4d801"))                    { bad = 12; }
    if (!t_asm_hex("shld r8, r9, cl", "4d0fa5c8"))                     { bad = 13; }
    if (!t_asm_hex("shrd dword [r12 + 4], r13d, 9", "450fac6c240409")) { bad = 14; }
    ret bad;
}

test asm_triple__refuses_operands_outside_the_form {
    var bad: i32 = 0;
    if (!t_asm_refused("imul al, bl", "multiply"))            { bad = 1; }
    if (!t_asm_refused("imul [rax], rcx", "multiply"))        { bad = 2; }
    if (!t_asm_refused("imul rax, rcx, rdx", "multiply"))     { bad = 3; }
    if (!t_asm_refused("imul rax, ecx", "multiply"))          { bad = 4; }
    if (!t_asm_refused("shld rax, rcx", "double shift"))      { bad = 5; }
    if (!t_asm_refused("shld rax, rcx, dl", "double shift"))  { bad = 6; }
    if (!t_asm_refused("shld rax, rcx, 256", "double shift")) { bad = 7; }
    if (!t_asm_refused("shld rax, [rcx], 1", "double shift")) { bad = 8; }
    if (!t_asm_refused("shld al, bl, 1", "double shift"))     { bad = 9; }
    if (!t_asm_refused("shrd rax, ecx, 1", "double shift"))   { bad = 10; }
    ret bad;
}

# a secret count register is a variable-latency operand of a double shift; an immediate count is not
test asm_triple__double_shift_count_reaches_the_walk {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad:   i32 = 0;
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val lat:   str            = "mov rax, {r}\nmov [rsp], rax\nmov rcx, [rsp]\nshld rdx, rbx, cl";
    val r_lat: err[fail.Fail] = asm_ct_scan(lat, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_lat.err) { bad = bad + 1; }
    val r_pub: err[fail.Fail] = asm_ct_scan(lat, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_pub.err) { bad = bad + 2; }

    val imm:   str            = "mov rax, {r}\nshld rax, rbx, 5";
    val r_imm: err[fail.Fail] = asm_ct_scan(imm, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_imm.err) { bad = bad + 4; }

    var mi: isa.Inst = isa.inst_blank();
    var e:  ct.InstEffects;
    mi.opcode = x64.SHRD;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_reg(x64.RBX, 8);
    mi.src2   = isa.make_reg(x64.RCX, 1);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_RW || e.roles[1] != ct.ROLE_READ || e.roles[2] != ct.ROLE_READ) { bad = bad + 8; }
    if (e.count_pos != 2 || e.cls.op != ct.CT_OP_VAR_SHIFT)                                   { bad = bad + 16; }
    ret bad;
}

test asm_segment__refuses_overrides_outside_the_form {
    var bad: i32 = 0;
    if (!t_asm_refused("mov rax, fs:rbx", "may only precede a bracketed memory operand"))  { bad = 1; }
    if (!t_asm_refused("mov rax, gs:0x28", "may only precede a bracketed memory operand")) { bad = 2; }
    if (!t_asm_refused("mov rax, fs:{v}", "may only precede a bracketed memory operand"))  { bad = 3; }
    if (!t_asm_refused("mov rax, es:[0]", "relocates nothing in long mode"))               { bad = 4; }
    if (!t_asm_refused("mov rax, ds:[rbx]", "relocates nothing in long mode"))             { bad = 5; }
    if (!t_asm_refused("mov rax, qword cs:[rbx]", "relocates nothing in long mode"))       { bad = 6; }
    if (!t_asm_refused("mov rax, ss:[rsp]", "relocates nothing in long mode"))             { bad = 7; }
    if (!t_asm_refused("lea rax, fs:[rbx]", "segment override relocates nothing"))         { bad = 8; }
    if (!t_asm_refused("mov rax, fs:[tbl]", "names a symbol"))                             { bad = 9; }
    if (!t_asm_refused("movdqu xmm0, gs:[tbl]", "names a symbol"))                         { bad = 10; }
    if (!t_asm_refused("jmp fs:[tbl]", "names a symbol"))                                  { bad = 11; }
    if (!t_asm_refused("mov rax, fs:[{v}]", "stack-slot binding"))                         { bad = 12; }
    if (!t_asm_refused("mov fs:rax, rbx", "may only precede a bracketed memory operand"))  { bad = 13; }
    if (!t_asm_refused("jmp gs:rax", "may only precede a bracketed memory operand"))       { bad = 14; }
    ret bad;
}

test asm_base_register__refuses_operands_outside_the_form {
    var bad:  i32 = 0;
    val want: str = "takes one 32- or 64-bit general-purpose register";
    t_model_x64.extensions = x64.EXT_FSGSBASE;
    if (!t_asm_refused("rdfsbase ax", want))                          { bad = 1; }
    if (!t_asm_refused("rdgsbase al", want))                          { bad = 2; }
    if (!t_asm_refused("wrfsbase xmm0", want))                        { bad = 3; }
    if (!t_asm_refused("wrgsbase [rax]", want))                       { bad = 4; }
    if (!t_asm_refused("wrgsbase fs:[rax]", want))                    { bad = 5; }
    if (!t_asm_refused("rdfsbase 5", want))                           { bad = 6; }
    if (!t_asm_refused("rdfsbase", "unknown inline-asm instruction")) { bad = 7; }
    if (!t_asm_refused("rdfsbase rax, rbx", want))                    { bad = 8; }
    if (!t_asm_refused("wrfsbase {v}", want))                         { bad = 9; }
    if (!t_asm_refused("rdgsbase qword [rax]", want))                 { bad = 10; }
    t_model_x64.extensions = 0;
    ret bad;
}

# a base read writes its register and a base write writes none; rdgsbase rsp moves the stack pointer
test asm_base_register__clobbers_follow_the_rows {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;
    asm_clobbers("rdfsbase r9\nwrgsbase rcx\nwrfsbase edx", ?gp, ?fp);
    if (gp != (1::u32 << x64.R9::u32) || fp != 0) { bad = 1; }
    asm_clobbers("mov rax, fs:[0]\nmovdqu xmm2, gs:[rbx]", ?gp, ?fp);
    if (gp != 1 || fp != (1::u32 << 2)) { bad = 2; }

    var item: iasm.Item;
    if (!t_asm_item("rdgsbase rsp", ?item) || !x64_writes_sp(?item))              { bad = 3; }
    if (!t_asm_item("wrgsbase rsp", ?item) || x64_writes_sp(?item))               { bad = 4; }
    if (!t_asm_item("wrfsbase rdi", ?item) || item.addr_ops != iasm.AW_OP0)       { bad = 5; }
    if (!t_asm_item("rdfsbase rdi", ?item) || item.addr_ops != 0)                 { bad = 6; }
    if (!t_asm_item("mov rax, gs:[rbx]", ?item) || item.ops[1].seg != x64.SEG_GS) { bad = 7; }
    if (!t_asm_item("mov rax, [rbx]", ?item) || item.ops[1].seg != x64.SEG_NONE)  { bad = 8; }
    ret bad;
}

# the base registers change no flags and have no variable latency; a written
# base is an address, and the override changes no operand's role
test asm_base_register__classified_for_the_ct_walk {
    var bad: i32 = 0;
    var op:  u16 = x64.RDFSBASE;
    for (op <= x64.WRGSBASE) {
        val cls: ct.AsmClass = asm_ct_class(op::u32, 0);
        if (!cls.known || cls.op != ct.CT_OP_NONE || cls.writes_flags || cls.reads_flags) { bad = 1; }
        op = op + 1;
    }

    var e:  ct.InstEffects;
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.RDGSBASE;
    mi.size   = 8;
    mi.dst    = isa.make_reg(x64.R9, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.implicit_addr != 0) { bad = 2; }

    mi.opcode = x64.WRFSBASE;
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_READ || e.implicit_addr != (1::u64 << 9)) { bad = 3; }

    mi          = isa.inst_blank();
    mi.opcode   = x64.MOV;
    mi.size     = 8;
    mi.dst      = isa.make_reg(x64.RAX, 8);
    mi.src1     = isa.make_mem(x64.RBX, 8, -1, 0, 8);
    mi.src1.seg = x64.SEG_FS;
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ || e.implicit_addr != 0) { bad = 4; }
    ret bad;
}

# a secret installed as a segment base addresses every later fs- or gs-relative access
test asm_ct_scan__a_secret_segment_base_is_an_address {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");

    val wr: err[fail.Fail] = asm_ct_scan("mov rax, {k}\nwrgsbase rax", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel wr.err) {
        if (!str_contains(fail.describe(wr.err), "address base")) { bad = bad + 1; }
    }
    or { bad = bad + 1; }
    val pub_wr: err[fail.Fail] = asm_ct_scan("mov rax, {k}\nwrgsbase rcx", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel pub_wr.err) { bad = bad + 2; }
    val addr: err[fail.Fail] = asm_ct_scan("mov rbx, {k}\nmov rax, fs:[rbx]", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel addr.err) { bad = bad + 4; }
    val pub_rd: err[fail.Fail] = asm_ct_scan("mov rbx, {k}\nmov rax, fs:[rcx + 8]\nrdfsbase rdx", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel pub_rd.err) { bad = bad + 8; }
    val flow: err[fail.Fail] = asm_ct_scan("mov rbx, {k}\nmov rsi, rbx\nwrfsbase esi", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel flow.err) { bad = bad + 16; }
    ret bad;
}

#[testing]
val T_EXT_ALL: u64 = x64.EXT_SSSE3 | x64.EXT_SSE41 | x64.EXT_SHA | x64.EXT_FSGSBASE | x64.EXT_POPCNT | x64.EXT_LZCNT | x64.EXT_BMI1 |
    x64.EXT_AES | x64.EXT_PCLMUL;

# a body run under a target selecting `exts`, inside a function admitting `f_exts`
#[testing]
fun t_ext_run(body: str, exts: u64, f_exts: u64, st: *enc.EncodeState, alloc: *A.Allocator, w: *writer.Writer) err[fail.Fail] {
    enc.state_blank(st, alloc, x64_machine());
    st.interner = nil;
    var sink: enc.AsmSink = enc.sink_init(w, nil);
    if (w != nil) { st.buf.asm = ?sink; }
    t_model_x64.extensions = exts;
    var f: mir.MirFunction;
    f.extensions = f_exts;
    var g:      iasm.Grammar = x64_grammar();
    var labels: iasm.Labels;
    iasm.labels_init(?labels, alloc);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, body, alloc, nil, ?f, nil);
    val r: err[fail.Fail] = iasm.run(st, ?g, ?c, ?labels);
    t_model_x64.extensions = 0;
    st.buf.asm             = nil;
    if (sel r.ok && sink.failed) { ret err[fail.Fail].err{fail.message("the listing sink failed")}; }
    ret r;
}

#[testing]
fun t_buf_is(buf: *enc.ByteBuf, want: *u8, n: usize) bool {
    if (buf.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (buf.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bytes GNU as gives the body, and the body's listing assembles back to them
#[testing]
fun t_ext_hex(body: str, hex: str) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var want: [32]u8;
    val n:    usize = t_unhex(hex, ?want[0]);
    var w:    writer.Writer;
    printer.test_sink_writer(?w);
    var st: enc.EncodeState;
    val r:  err[fail.Fail] = t_ext_run(body, T_EXT_ALL, 0, ?st, ?alloc, ?w);
    if (sel r.err)                       { ret false; }
    if (!t_buf_is(?st.buf, ?want[0], n)) { ret false; }
    val listed: str = printer.test_sink_text();
    if (!str_contains(listed, x64_row_name(body))) { ret false; }
    var again: enc.EncodeState;
    val rr:    err[fail.Fail] = t_ext_run(listed, T_EXT_ALL, 0, ?again, ?alloc, nil);
    if (sel rr.err) { ret false; }
    ret t_buf_is(?again.buf, ?want[0], n);
}

# the mnemonic a one-instruction body starts with
#[testing]
fun x64_row_name(body: str) str {
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val name: str = X64_MNEMONICS[i].name;
        if (str_region_equals(body, 0, str_len(name), name) && body[str_len(name)] == ' '::char) { ret name; }
        i = i + 1;
    }
    ret "?";
}

# every extension row against GNU as 2.46 (`as --64`, intel syntax), low and
# high registers and a memory operand each, and the listing round trips
test asm_extensions__rows_match_gnu_as_and_round_trip {
    var bad: i32 = 0;
    if (!t_ext_hex("sha256rnds2 xmm1, xmm2", "0f38cbca"))                          { bad = 1; }
    if (!t_ext_hex("sha256rnds2 xmm9, xmmword [r12+rax*4+16]", "450f38cb4c8410"))  { bad = 2; }
    if (!t_ext_hex("sha256msg1 xmm0, xmm15", "410f38ccc7"))                        { bad = 3; }
    if (!t_ext_hex("sha256msg1 xmm3, [rbx]", "0f38cc1b"))                          { bad = 4; }
    if (!t_ext_hex("sha256msg2 xmm10, xmm11", "450f38cdd3"))                       { bad = 5; }
    if (!t_ext_hex("sha256msg2 xmm4, [rsp+8]", "0f38cd642408"))                    { bad = 6; }
    if (!t_ext_hex("pshufb xmm0, xmm1", "660f3800c1"))                             { bad = 7; }
    if (!t_ext_hex("pshufb xmm8, [r13]", "66450f38004500"))                        { bad = 8; }
    if (!t_ext_hex("palignr xmm2, xmm3, 7", "660f3a0fd307"))                       { bad = 9; }
    if (!t_ext_hex("palignr xmm12, xmmword [rcx+rdx*2], 255", "66440f3a0f2451ff")) { bad = 10; }
    if (!t_ext_hex("pblendw xmm1, xmm14, 0xaa", "66410f3a0eceaa"))                 { bad = 11; }
    if (!t_ext_hex("pblendw xmm5, [rbp-8], 1", "660f3a0e6df801"))                  { bad = 12; }
    if (!t_ext_hex("pinsrd xmm1, eax, 2", "660f3a22c802"))                         { bad = 13; }
    if (!t_ext_hex("pinsrd xmm9, r10d, 3", "66450f3a22ca03"))                      { bad = 14; }
    if (!t_ext_hex("pinsrd xmm2, dword [rdi+4], 0", "660f3a22570400"))             { bad = 15; }
    if (!t_ext_hex("pextrd eax, xmm1, 1", "660f3a16c801"))                         { bad = 16; }
    if (!t_ext_hex("pextrd r11d, xmm13, 3", "66450f3a16eb03"))                     { bad = 17; }
    if (!t_ext_hex("pextrd dword [rsi], xmm6, 2", "660f3a163602"))                 { bad = 18; }
    if (!t_ext_hex("ptest xmm0, xmm1", "660f3817c1"))                              { bad = 19; }
    if (!t_ext_hex("ptest xmm11, [r8]", "66450f381718"))                           { bad = 20; }
    if (!t_asm_hex("cpuid", "0fa2"))                                               { bad = 21; }
    ret bad;
}

# the aes and pclmul rows against GNU as 2.47 (`as --64`, intel syntax): every
# row with low and high registers and a memory operand, and the listing round
# trips (#3835)
test asm_extensions__aes_and_pclmul_rows_match_gnu_as_and_round_trip {
    var bad: i32 = 0;
    if (!t_ext_hex("aesenc xmm1, xmm2", "660f38dcca"))                              { bad = 1; }
    if (!t_ext_hex("aesenc xmm9, xmmword [r12+rax*4+16]", "66450f38dc4c8410"))      { bad = 2; }
    if (!t_ext_hex("aesenclast xmm0, xmm15", "66410f38ddc7"))                       { bad = 3; }
    if (!t_ext_hex("aesenclast xmm3, [rbx]", "660f38dd1b"))                         { bad = 4; }
    if (!t_ext_hex("aesdec xmm10, xmm11", "66450f38ded3"))                          { bad = 5; }
    if (!t_ext_hex("aesdec xmm4, [rsp+8]", "660f38de642408"))                       { bad = 6; }
    if (!t_ext_hex("aesdeclast xmm7, xmm8", "66410f38dff8"))                        { bad = 7; }
    if (!t_ext_hex("aesdeclast xmm12, [rbp-16]", "66440f38df65f0"))                 { bad = 8; }
    if (!t_ext_hex("aesimc xmm2, xmm3", "660f38dbd3"))                              { bad = 9; }
    if (!t_ext_hex("aesimc xmm13, [r13]", "66450f38db6d00"))                        { bad = 10; }
    if (!t_ext_hex("aeskeygenassist xmm1, xmm2, 1", "660f3adfca01"))                { bad = 11; }
    if (!t_ext_hex("aeskeygenassist xmm14, [rcx+rdx*2], 0x36", "66440f3adf345136")) { bad = 12; }
    if (!t_ext_hex("pclmulqdq xmm0, xmm1, 0", "660f3a44c100"))                      { bad = 13; }
    if (!t_ext_hex("pclmulqdq xmm15, xmm8, 0x11", "66450f3a44f811"))                { bad = 14; }
    if (!t_ext_hex("pclmulqdq xmm5, xmmword [rdi+32], 0x10", "660f3a446f2010"))     { bad = 15; }
    ret bad;
}

# a symbol-relative source keeps its rip-relative field ahead of the immediate
test asm_extensions__symbol_sources_relocate_before_the_immediate {
    t_model_x64.extensions = T_EXT_ALL;
    var bad: i32 = 0;
    if (!t_asm_reloc("pshufb xmm1, [tbl]", "660f38000d00000000", 5, -4))         { bad = 1; }
    if (!t_asm_reloc("pinsrd xmm1, [tbl], 3", "660f3a220d0000000003", 5, -5))    { bad = 2; }
    if (!t_asm_reloc("pextrd [tbl], xmm1, 3", "660f3a160d0000000003", 5, -5))    { bad = 3; }
    if (!t_asm_reloc("aesenc xmm1, [tbl]", "660f38dc0d00000000", 5, -4))         { bad = 4; }
    if (!t_asm_reloc("pclmulqdq xmm1, [tbl], 1", "660f3a440d0000000001", 5, -5)) { bad = 5; }
    t_model_x64.extensions = 0;
    ret bad;
}

#[testing]
fun t_ext_refusal(body: str, exts: u64, f_exts: u64, want: str) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    val r:  err[fail.Fail] = t_ext_run(body, exts, f_exts, ?st, ?alloc, nil);
    if (!sel r.err) { ret false; }
    ret str_contains(fail.describe(r.err), want) && st.buf.len == 0;
}

#[testing]
fun t_ext_admitted(body: str, exts: u64, f_exts: u64) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    val r:  err[fail.Fail] = t_ext_run(body, exts, f_exts, ?st, ?alloc, nil);
    ret sel r.ok && st.buf.len > 0;
}

#[testing]
val T_EXT_BODY_COUNT: usize = 23;

#[testing]
val T_EXT_BODIES: [T_EXT_BODY_COUNT]str = [T_EXT_BODY_COUNT]str{
    "sha256rnds2 xmm1, xmm2", "sha256msg1 xmm1, xmm2", "sha256msg2 xmm1, xmm2",
    "pshufb xmm1, xmm2", "palignr xmm1, xmm2, 1", "pblendw xmm1, xmm2, 1",
    "pinsrd xmm1, eax, 1", "pextrd eax, xmm1, 1", "ptest xmm1, xmm2",
    "rdfsbase rax", "rdgsbase r9d", "wrfsbase ecx", "wrgsbase r15",
    "popcnt rax, rcx", "lzcnt eax, [rdi]", "tzcnt r9, r10",
    "aesenc xmm1, xmm2", "aesenclast xmm1, [rax]", "aesdec xmm1, xmm2", "aesdeclast xmm1, xmm2",
    "aesimc xmm1, xmm2", "aeskeygenassist xmm1, xmm2, 1", "pclmulqdq xmm1, xmm2, 0x11",
};

#[testing]
val T_EXT_NEEDS: [T_EXT_BODY_COUNT]u64 = [T_EXT_BODY_COUNT]u64{
    x64.EXT_SHA, x64.EXT_SHA, x64.EXT_SHA,
    x64.EXT_SSSE3, x64.EXT_SSSE3, x64.EXT_SSE41,
    x64.EXT_SSE41, x64.EXT_SSE41, x64.EXT_SSE41,
    x64.EXT_FSGSBASE, x64.EXT_FSGSBASE, x64.EXT_FSGSBASE, x64.EXT_FSGSBASE,
    x64.EXT_POPCNT, x64.EXT_LZCNT, x64.EXT_BMI1,
    x64.EXT_AES, x64.EXT_AES, x64.EXT_AES, x64.EXT_AES,
    x64.EXT_AES, x64.EXT_AES, x64.EXT_PCLMUL,
};

# a row whose extension neither the target nor the enclosing function admits is
# refused before a byte is written, naming the manifest line and the decorator
test asm_extensions__an_unselected_extension_is_refused_unless_the_function_admits_it {
    if (!t_ext_refusal("sha256rnds2 xmm1, xmm2", 0, 0,
        "inline-asm instruction 'sha256rnds2' needs the `sha` extension, which this target does not select; add `extensions = [\"sha\"]` to the target, or mark the function `#[extensions(sha)]` and call it only after detecting the extension at run time")) { ret 1; }
    if (!t_ext_refusal("pshufb xmm0, xmm1", x64.EXT_SHA, x64.EXT_SSE41, "needs the `ssse3` extension")) { ret 2; }
    if (!t_ext_refusal("ptest xmm0, xmm1", x64.EXT_SSSE3, 0, "#[extensions(sse41)]"))                   { ret 3; }
    if (!t_ext_admitted("cpuid\npxor xmm0, xmm0", 0, 0))                                                { ret 4; }
    if (!t_ext_refusal("wrgsbase rax", 0, x64.EXT_SHA,
        "inline-asm instruction 'wrgsbase' needs the `fsgsbase` extension, which this target does not select; add `extensions = [\"fsgsbase\"]` to the target, or mark the function `#[extensions(fsgsbase)]` and call it only after detecting the extension at run time")) { ret 5; }
    if (!t_ext_refusal("aesenc xmm0, xmm1", 0, 0,
        "inline-asm instruction 'aesenc' needs the `aes` extension, which this target does not select; add `extensions = [\"aes\"]` to the target, or mark the function `#[extensions(aes)]` and call it only after detecting the extension at run time")) { ret 6; }
    if (!t_ext_refusal("pclmulqdq xmm0, xmm1, 0", x64.EXT_AES, 0,
        "inline-asm instruction 'pclmulqdq' needs the `pclmul` extension, which this target does not select; add `extensions = [\"pclmul\"]` to the target, or mark the function `#[extensions(pclmul)]` and call it only after detecting the extension at run time")) { ret 7; }
    if (!t_ext_refusal("aeskeygenassist xmm0, xmm1, 1", x64.EXT_PCLMUL, x64.EXT_SHA, "#[extensions(aes)]")) { ret 8; }
    var i: usize = 0;
    for (i < T_EXT_BODY_COUNT) {
        val body: str = T_EXT_BODIES[i];
        val need: u64 = T_EXT_NEEDS[i];
        if (!t_ext_refusal(body, 0, 0, "needs the `"))                 { ret 20 + i::i32; }
        if (!t_ext_refusal(body, T_EXT_ALL & ~need, 0, "needs the `")) { ret 40 + i::i32; }
        if (!t_ext_admitted(body, need, 0))                            { ret 60 + i::i32; }
        if (!t_ext_admitted(body, 0, need))                            { ret 80 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

test asm_extensions__malformed_operands_are_refused {
    if (!t_asm_refused("pinsrd xmm0, rax, 1", "a 32-bit register or memory"))               { ret 1; }
    if (!t_asm_refused("pinsrd xmm0, eax", "a 32-bit register or memory"))                  { ret 2; }
    if (!t_asm_refused("pinsrd eax, xmm0, 1", "a 32-bit register or memory"))               { ret 3; }
    if (!t_asm_refused("pextrd xmm0, eax, 1", "a 32-bit register or memory"))               { ret 4; }
    if (!t_asm_refused("pinsrd xmm0, eax, 256", "an immediate from 0 to 255"))              { ret 5; }
    if (!t_asm_refused("pextrd qword [rax], xmm0, 1", "a 32-bit register or memory"))       { ret 6; }
    if (!t_asm_refused("pinsrd xmm0, xmm1, 1", "a 32-bit register or memory"))              { ret 7; }
    if (!t_asm_refused("sha256msg1 xmm0, rax", "takes a vector register or memory source")) { ret 8; }
    if (!t_asm_refused("palignr xmm0, xmm1", "8-bit immediate"))                            { ret 9; }
    t_model_x64.extensions = x64.EXT_AES | x64.EXT_PCLMUL;
    var bad: i32 = 0;
    if (!t_asm_refused("aesenc xmm0, rax", "takes a vector register or memory source")) { bad = 10; }
    if (!t_asm_refused("aesimc rax, xmm0", "vector register"))                          { bad = 11; }
    if (!t_asm_refused("aeskeygenassist xmm0, xmm1", "8-bit immediate"))                { bad = 12; }
    if (!t_asm_refused("pclmulqdq xmm0, xmm1", "8-bit immediate"))                      { bad = 13; }
    if (!t_asm_refused("pclmulqdq xmm0, xmm1, 256", "an immediate from 0 to 255"))      { bad = 14; }
    if (!t_asm_refused("aesenc xmm0, xmm1, 1", "expects two operands"))                 { bad = 15; }
    t_model_x64.extensions = 0;
    if (bad != 0) { ret bad; }
    ret 0;
}

#[testing]
fun t_clobbers_are(body: str, gp: u32, fp: u32) bool {
    var got_gp: u32 = 0;
    var got_fp: u32 = 0;
    asm_clobbers(body, ?got_gp, ?got_fp);
    ret got_gp == gp && got_fp == fp;
}

# cpuid writes eax, ebx, ecx and edx; each row clobbers exactly its destination
test asm_extensions__clobbers_are_the_destinations {
    val a: u32 = 1::u32 << x64.RAX::u32;
    val b: u32 = 1::u32 << x64.RBX::u32;
    val c: u32 = 1::u32 << x64.RCX::u32;
    val d: u32 = 1::u32 << x64.RDX::u32;
    if (!t_clobbers_are("cpuid", a | b | c | d, 0))                                                       { ret 1; }
    if (!t_clobbers_are("pextrd r11d, xmm1, 0", 1::u32 << x64.R11::u32, 0))                               { ret 2; }
    if (!t_clobbers_are("pextrd [rax], xmm1, 0", 0, 0))                                                   { ret 3; }
    if (!t_clobbers_are("pinsrd xmm3, eax, 0", 0, 0x8))                                                   { ret 4; }
    if (!t_clobbers_are("ptest xmm0, xmm1", 0, 0))                                                        { ret 5; }
    if (!t_clobbers_are("sha256rnds2 xmm4, xmm0\nsha256msg1 xmm5, xmm0\nsha256msg2 xmm6, xmm0", 0, 0x70)) { ret 6; }
    if (!t_clobbers_are("pshufb xmm7, xmm0\npalignr xmm8, xmm0, 1\npblendw xmm9, xmm0, 2", 0, 0x380))     { ret 7; }
    val aes: str = "aesenc xmm1, xmm0\naesenclast xmm2, xmm0\naesdec xmm3, xmm0\naesdeclast xmm4, xmm0\naesimc xmm5, xmm0\naeskeygenassist xmm6, xmm0, 1";
    if (!t_clobbers_are(aes, 0, 0x7E))                         { ret 8; }
    if (!t_clobbers_are("pclmulqdq xmm10, xmm0, 0", 0, 0x400)) { ret 9; }
    ret 0;
}

# the effect rows: sha256rnds2 reads xmm0 unnamed, cpuid reads eax and ecx and
# writes all four, pextrd defines its general register, ptest writes flags
test inst_effects__extension_rows {
    var e:  ct.InstEffects;
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.SHA256RNDS2;
    mi.dst    = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 1));
    mi.src1   = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 2));
    inst_effects(?mi, ?e);
    if (!e.cls.known || e.implicit_fp_reads != 1 || e.roles[0] != ct.ROLE_RW || e.roles[1] != ct.ROLE_READ) { ret 1; }
    if (e.cls.writes_flags || e.cls.op != ct.CT_OP_NONE)                                                    { ret 2; }

    mi        = isa.inst_blank();
    mi.opcode = x64.CPUID;
    inst_effects(?mi, ?e);
    if (e.implicit_reads != (X64_RAX | X64_RCX) || e.implicit_writes != 0xF || e.implicit_fp_reads != 0) { ret 3; }

    mi        = isa.inst_blank();
    mi.opcode = x64.PEXTRD;
    mi.dst    = isa.make_reg(x64.RAX, 4);
    mi.src1   = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 1));
    mi.src2   = isa.make_imm(1, 1);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ) { ret 4; }

    mi        = isa.inst_blank();
    mi.opcode = x64.PTEST;
    mi.dst    = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 0));
    mi.src1   = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 1));
    inst_effects(?mi, ?e);
    if (!e.cls.writes_flags || e.cls.defines_flags || e.roles[0] != ct.ROLE_READ || e.roles[1] != ct.ROLE_READ) { ret 5; }

    # the aes rounds and pclmulqdq fold their source into the destination;
    # aesimc and aeskeygenassist define it from the source alone. every one is
    # a fixed-latency row that leaves the flags alone
    var k: usize = 0;
    for (k < T_AES_ROW_COUNT) {
        mi        = isa.inst_blank();
        mi.opcode = T_AES_ROWS[k];
        mi.dst    = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 1));
        mi.src1   = vec_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 2));
        if (mi.opcode == x64.AESKEYGENASSIST || mi.opcode == x64.PCLMULQDQ) { mi.src2 = isa.make_imm(1, 1); }
        inst_effects(?mi, ?e);
        var dst: ct.OperandRole = ct.ROLE_RW;
        if (mi.opcode == x64.AESIMC || mi.opcode == x64.AESKEYGENASSIST)                    { dst = ct.ROLE_WRITE; }
        if (!e.cls.known || !e.cls.flags_stated || e.cls.writes_flags || e.cls.reads_flags) { ret 10 + k::i32; }
        if (e.cls.op != ct.CT_OP_NONE || e.implicit_fp_reads != 0)                          { ret 20 + k::i32; }
        if (e.roles[0] != dst || e.roles[1] != ct.ROLE_READ)                                { ret 30 + k::i32; }
        k = k + 1;
    }
    ret 0;
}

#[testing]
val T_AES_ROW_COUNT: usize = 7;

#[testing]
val T_AES_ROWS: [T_AES_ROW_COUNT]u16 = [T_AES_ROW_COUNT]u16{
    x64.AESENC, x64.AESENCLAST, x64.AESDEC, x64.AESDECLAST, x64.AESIMC, x64.AESKEYGENASSIST, x64.PCLMULQDQ,
};

# a secret flows through the rows as the ct scan models them: into sha256rnds2
# through its unnamed xmm0, out of pextrd into an address, and through cpuid
test asm_ct_scan__extension_rows_carry_secrets {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    val none: ct.CtMulMask = ct.mul_mask_none();

    val rnds: err[fail.Fail] = asm_ct_scan("movdqu xmm0, {k}\nsha256rnds2 xmm1, xmm2\nptest xmm1, xmm1\nje 1f\n1:\nnop", ?names[0], 1, none, false, ?alloc);
    if (!sel rnds.err) { ret 1; }
    val other: err[fail.Fail] = asm_ct_scan("movdqu xmm3, {k}\nsha256rnds2 xmm1, xmm2\nptest xmm1, xmm1\nje 1f\n1:\nnop", ?names[0], 1, none, false, ?alloc);
    if (sel other.err) { ret 2; }
    val lane: err[fail.Fail] = asm_ct_scan("movdqu xmm2, {k}\npextrd eax, xmm2, 1\nmov rcx, [rax]", ?names[0], 1, none, false, ?alloc);
    if (!sel lane.err) { ret 3; }
    val leaf: err[fail.Fail] = asm_ct_scan("mov rax, {k}\ncpuid\nmov rsi, [rbx]", ?names[0], 1, none, false, ?alloc);
    if (!sel leaf.err) { ret 4; }
    val flags: err[fail.Fail] = asm_ct_scan("movdqu xmm2, {k}\nptest xmm2, xmm2\nje 1f\n1:\nnop", ?names[0], 1, none, false, ?alloc);
    if (!sel flags.err) { ret 5; }
    ret 0;
}

# a secret key and state run through every aes row and the carry-less multiply
# and are admitted: the rows are data-independent. the result stays secret, so
# an address or a branch built from it is still refused (#3835)
test asm_ct_scan__aes_and_pclmul_rows_admit_secrets_and_keep_them {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    val none: ct.CtMulMask = ct.mul_mask_none();

    val rounds: str            = "movdqu xmm0, {k}\nmovdqu xmm1, {k}\naesenc xmm1, xmm0\naesenclast xmm1, xmm0\naesdec xmm1, xmm0\naesdeclast xmm1, xmm0\naesimc xmm2, xmm1\naeskeygenassist xmm3, xmm2, 0x36\npclmulqdq xmm3, xmm0, 0x11\nmovdqu [rdi], xmm3";
    val ok:     err[fail.Fail] = asm_ct_scan(rounds, ?names[0], 1, none, false, ?alloc);
    if (sel ok.err) { ret 1; }
    val addr: err[fail.Fail] = asm_ct_scan("movdqu xmm0, {k}\naesenc xmm1, xmm0\npextrd eax, xmm1, 0\nmov rcx, [rax]", ?names[0], 1, none, false, ?alloc);
    if (!sel addr.err) { ret 2; }
    val mul: err[fail.Fail] = asm_ct_scan("movdqu xmm0, {k}\npclmulqdq xmm1, xmm0, 0\nptest xmm1, xmm1\nje 1f\n1:\nnop", ?names[0], 1, none, false, ?alloc);
    if (!sel mul.err) { ret 3; }
    val key: err[fail.Fail] = asm_ct_scan("movdqu xmm0, {k}\naeskeygenassist xmm1, xmm0, 1\npextrd eax, xmm1, 0\nmov rcx, [rax]", ?names[0], 1, none, false, ?alloc);
    if (!sel key.err) { ret 4; }
    ret 0;
}

#[testing]
val T_FORM_COUNT: usize = 46;

#[testing]
val T_FORMS: [T_FORM_COUNT]x64.Form = [T_FORM_COUNT]x64.Form{
    x64.FORM_NONE, x64.FORM_BARE, x64.FORM_MOV, x64.FORM_LEA, x64.FORM_PUSH, x64.FORM_POP, x64.FORM_ALU,
    x64.FORM_TEST, x64.FORM_IMUL, x64.FORM_DIV, x64.FORM_SHIFT, x64.FORM_JCC, x64.FORM_JMP, x64.FORM_CALL,
    x64.FORM_RET, x64.FORM_SETCC, x64.FORM_MOVX, x64.FORM_MOVABS, x64.FORM_MOVQ, x64.FORM_SSE_MOV,
    x64.FORM_SSE_MOVA, x64.FORM_SSE_ALU, x64.FORM_UCOMIS, x64.FORM_CVT, x64.FORM_XORPS, x64.FORM_PACKED,
    x64.FORM_PSHUF, x64.FORM_PSLL, x64.FORM_GRP3, x64.FORM_GRP5, x64.FORM_XCHG, x64.FORM_XADD,
    x64.FORM_PORTIO, x64.FORM_LIDT, x64.FORM_MOV_CR, x64.FORM_MOV_SEG, x64.FORM_STRING, x64.FORM_TRAP,
    x64.FORM_DATA, x64.FORM_FSGSBASE, x64.FORM_PINSR, x64.FORM_MUL1, x64.FORM_BITSCAN, x64.FORM_BSWAP,
    x64.FORM_DSHIFT, x64.FORM_CARRY,
};

#[testing]
val T_MEM_COUNT: usize = 5;

#[testing]
val T_MEMS: [T_MEM_COUNT]x64.MemEffect = [T_MEM_COUNT]x64.MemEffect{
    x64.MEM_OPERAND, x64.MEM_ADDR, x64.MEM_STACK, x64.MEM_STRING, x64.MEM_BASE,
};

#[testing]
val T_PATTERN_COUNT: usize = 11;

#[testing]
val T_PATTERNS: [T_PATTERN_COUNT]u16 = [T_PATTERN_COUNT]u16{
    X64P_NONE, X64P_ONE, X64P_TWO, X64P_BRANCH, X64P_XFER, X64P_VEC, X64P_VECI, X64P_PORTIO,
    X64P_WIDEREG, X64P_VECG, X64P_TRIPLE,
};

# the enumerations are dense and collision free: two branches that each add a
# differently named value at the same number merge without a conflict, and
# only a census over the names finds it
test describe__every_enumeration_value_is_unique {
    if (T_FORM_COUNT != x64.FORM_COUNT::usize) { ret 3; }
    var forms: [T_FORM_COUNT]bool;
    var i:     usize = 0;
    for (i < T_FORM_COUNT) {
        val f: usize = T_FORMS[i]::usize;
        if (f >= T_FORM_COUNT || forms[f]) { ret 4; }
        forms[f] = true;
        i        = i + 1;
    }
    var mem: x64.MemEffect = x64.MEM_NONE;
    i = 0;
    for (i < T_MEM_COUNT) {
        val bit: x64.MemEffect = T_MEMS[i];
        if (bit == 0 || (bit & (bit - 1)) != 0 || (mem & bit) != 0) { ret 5; }
        mem = mem | bit;
        i   = i + 1;
    }
    if (mem != x64.MEM_ALL) { ret 6; }
    var patterns: [16]bool;
    i = 0;
    for (i < T_PATTERN_COUNT) {
        val p: u16 = T_PATTERNS[i];
        if (p == 0 || p >= 16 || p != x64_pattern(p) || patterns[p::usize]) { ret 7; }
        patterns[p::usize] = true;
        i                  = i + 1;
    }
    i = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val p: u16 = x64_pattern(X64_MNEMONICS[i].flags);
        if (p >= 16 || !patterns[p::usize]) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

# the indirect call and jump forms, register and memory, direct symbol targets, and the refused spellings
test x64_xfer_target__indirect_forms_byte_exact {
    var bad: i32 = 0;
    if (!t_asm_hex("call [0x100018]", "ff142518001000"))   { bad = 1; }
    if (!t_asm_hex("call rax", "ffd0"))                    { bad = 2; }
    if (!t_asm_hex("call r11", "41ffd3"))                  { bad = 3; }
    if (!t_asm_hex("call [rax]", "ff10"))                  { bad = 4; }
    if (!t_asm_hex("call [rax + 8]", "ff5008"))            { bad = 5; }
    if (!t_asm_hex("call [rax + rbx*8 + 16]", "ff54d810")) { bad = 6; }
    if (!t_asm_hex("jmp rax", "ffe0"))                     { bad = 7; }
    if (!t_asm_hex("jmp r11", "41ffe3"))                   { bad = 8; }
    if (!t_asm_hex("jmp [rax + rbx*8 + 16]", "ff64d810"))  { bad = 9; }
    if (!t_asm_hex("jmp [0x100018]", "ff242518001000"))    { bad = 10; }

    if (!t_asm_refused("call [main]", "symbol"))               { bad = 11; }
    if (!t_asm_refused("call eax", "64-bit"))                  { bad = 12; }
    if (!t_asm_refused("call [0x100000000]", "32-bit"))        { bad = 13; }
    if (!t_asm_refused("call [0x100018 + 8]", "displacement")) { bad = 14; }
    if (!t_asm_refused("jmp eax", "64-bit register"))          { bad = 15; }
    if (!t_asm_refused("jmp [main]", "symbol's address"))      { bad = 16; }

    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "call main\njmp main", nil, nil, nil, nil);
    var item: iasm.Item;
    val rc:   res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel rc.err)              { ret 20; }
    if (item.ref != iasm.AR_SYM) { ret 21; }
    val dc: isa.Inst = x64_build(?item, 7::intern.StrId);
    if (dc.opcode != x64.CALL || (dc.flags & x64.FLAG_INDIRECT::u16) != 0) { ret 22; }
    if (dc.dst.kind != isa.OPK_SYM || dc.dst.sym_id != 7)                  { ret 23; }
    val rj: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel rj.err)              { ret 24; }
    if (item.ref != iasm.AR_SYM) { ret 25; }
    val dj: isa.Inst = x64_build(?item, 9::intern.StrId);
    if (dj.opcode != x64.JMP || (dj.flags & x64.FLAG_INDIRECT::u16) != 0) { ret 26; }
    if (dj.dst.kind != isa.OPK_SYM || dj.dst.sym_id != 9)                 { ret 27; }
    ret bad;
}

test asm_clobbers__indirect_call_is_not_opaque {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("call rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    asm_clobbers("call [0x100018]", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    asm_clobbers(".byte 0xff, 0x14, 0x25, 0x18, 0x00, 0x10, 0x00", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    ret bad;
}

test parse_data__sequence_is_not_an_operand_list {
    var bad: i32 = 0;

    var want: [7]u8;
    want[0] = 0xFF;
    want[1] = 0x14;
    want[2] = 0x25;
    want[3] = 0x18;
    want[4] = 0x00;
    want[5] = 0x10;
    want[6] = 0x00;
    if (!t_asm_bytes(".byte 0xff, 0x14, 0x25, 0x18, 0x00, 0x10, 0x00", ?want[0], 7)) { bad = 1; }

    var one: [1]u8;
    one[0] = 0x90;
    if (!t_asm_bytes(".byte 0x90", ?one[0], 1)) { bad = 1; }
    var neg: [1]u8;
    neg[0] = 0xFF;
    if (!t_asm_bytes(".byte -1", ?neg[0], 1)) { bad = 1; }

    if (!t_asm_refused(".byte 0x1ff", "cannot hold")) { bad = 1; }
    if (!t_asm_refused(".byte -129", "cannot hold"))  { bad = 1; }
    if (!t_asm_refused(".byte", "unknown"))           { bad = 1; }
    if (!t_asm_refused(".byte ,", "value"))           { bad = 1; }

    if (!t_asm_refused("mov rax, rbx, rcx, rdx, rsi", "too many operands")) { bad = 1; }

    ret bad;
}

test parse_data__gnu_as_widths {
    var bad: i32 = 0;

    var w: [2]u8;
    w[0] = 0x34;
    w[1] = 0x12;
    if (!t_asm_bytes(".word 0x1234", ?w[0], 2))         { bad = 1; }
    if (!t_asm_refused(".word 0x10000", "cannot hold")) { bad = 1; }

    var l: [4]u8;
    l[0] = 0x78;
    l[1] = 0x56;
    l[2] = 0x34;
    l[3] = 0x12;
    if (!t_asm_bytes(".long 0x12345678", ?l[0], 4)) { bad = 1; }

    var q: [8]u8;
    var i: usize = 0;
    for (i < 8) {
        q[i] = 0xFF;
        i    = i + 1;
    }
    if (!t_asm_bytes(".quad 0xFFFFFFFFFFFFFFFF", ?q[0], 8)) { bad = 1; }

    var n: [2]u8;
    n[0] = 0xFF;
    n[1] = 0xFF;
    if (!t_asm_bytes(".word -1", ?n[0], 2))            { bad = 1; }
    if (!t_asm_refused(".word -32769", "cannot hold")) { bad = 1; }

    var mix: [7]u8;
    mix[0] = 0x90;
    mix[1] = 0x34;
    mix[2] = 0x12;
    mix[3] = 0x78;
    mix[4] = 0x56;
    mix[5] = 0x34;
    mix[6] = 0x12;
    if (!t_asm_bytes(".byte 0x90\n.word 0x1234\n.long 0x12345678", ?mix[0], 7)) { bad = 1; }

    ret bad;
}

test x64_call_target__long_symbol_operand {
    var bad: i32 = 0;

    var alloc1: A.Allocator;
    page.make(?alloc1);
    var itn1: intern.Interner = intern.init(?alloc1);
    var st1:  enc.EncodeState;
    st1.alloc    = ?alloc1;
    st1.buf      = enc.buf_init(?alloc1);
    st1.interner = ?itn1;
    var g1:      iasm.Grammar = x64_grammar();
    var labels1: iasm.Labels;
    iasm.labels_init(?labels1, ?alloc1);
    var c1: iasm.Cursor;
    iasm.cursor_init(?c1, ?g1, "lea rax, [short_sym]", ?alloc1, ?itn1, nil, nil);
    val r1: err[fail.Fail] = iasm.run(?st1, ?g1, ?c1, ?labels1);
    if (sel r1.err) { bad = 1; }

    val long_name: str =
        "sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    val long_lea: str =
        "lea rax, [sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]";
    var alloc2: A.Allocator;
    page.make(?alloc2);
    var itn2: intern.Interner = intern.init(?alloc2);
    var st2:  enc.EncodeState;
    st2.alloc    = ?alloc2;
    st2.buf      = enc.buf_init(?alloc2);
    st2.interner = ?itn2;
    var g2:      iasm.Grammar = x64_grammar();
    var labels2: iasm.Labels;
    iasm.labels_init(?labels2, ?alloc2);
    var c2: iasm.Cursor;
    iasm.cursor_init(?c2, ?g2, long_lea, ?alloc2, ?itn2, nil, nil);
    val r2: err[fail.Fail] = iasm.run(?st2, ?g2, ?c2, ?labels2);
    if (sel r2.err) { bad = 1; }

    if (st1.buf.len != st2.buf.len) { bad = 1; }
    or {
        var i: usize = 0;
        for (i < st1.buf.len) {
            if (st1.buf.data[i] != st2.buf.data[i]) { bad = 1; }
            i = i + 1;
        }
    }

    if (st2.reloc_count == 0) { bad = 1; }
    or {
        val nm: opt[str] = intern.lookup(?itn2, st2.relocs[st2.reloc_count - 1].sym);
        if (sel nm.some && !str_equals(nm.some, long_name)) { bad = 1; }
    }

    if (!t_asm_refused("lea rax, [rax", "malformed")) { bad = 1; }

    ret bad;
}

#[testing]
fun t_inst_bytes(mi: *isa.Inst, want: *u8, n: usize) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val got: i32         = encode_inst(mi, ?buf);
    var ok:  bool        = got::usize == n && buf.len == n;
    var i:   usize       = 0;
    for (ok && i < n) {
        if (buf.data[i] != want[i]) { ok = false; }
        i = i + 1;
    }
    enc.buf_dnit(?buf);
    ret ok;
}

#[testing]
fun t_inst_refused(mi: *isa.Inst) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val got: i32         = encode_inst(mi, ?buf);
    val ok:  bool        = got == 0 && buf.len == 0;
    enc.buf_dnit(?buf);
    ret ok;
}

#[testing]
fun t_indirect_jmp(dst: isa.Operand) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.JMP;
    mi.size   = 8;
    mi.flags  = x64.FLAG_INDIRECT::u16;
    mi.dst    = dst;
    ret mi;
}

test encode_jmp__indirect_forms_byte_exact {
    var bad: i32 = 0;

    var rax:      isa.Inst = t_indirect_jmp(isa.make_reg(x64.RAX, 8));
    var rax_want: [2]u8;
    rax_want[0] = 0xFF;
    rax_want[1] = 0xE0;
    if (!t_inst_bytes(?rax, ?rax_want[0], 2)) { bad = 1; }

    var r11:      isa.Inst = t_indirect_jmp(isa.make_reg(x64.R11, 8));
    var r11_want: [3]u8;
    r11_want[0] = 0x41;
    r11_want[1] = 0xFF;
    r11_want[2] = 0xE3;
    if (!t_inst_bytes(?r11, ?r11_want[0], 3)) { bad = 1; }

    var m0:      isa.Inst = t_indirect_jmp(isa.make_mem(x64.RAX, 0, -1, 0, 8));
    var m0_want: [2]u8;
    m0_want[0] = 0xFF;
    m0_want[1] = 0x20;
    if (!t_inst_bytes(?m0, ?m0_want[0], 2)) { bad = 1; }

    var m8:      isa.Inst = t_indirect_jmp(isa.make_mem(x64.RAX, 8, -1, 0, 8));
    var m8_want: [3]u8;
    m8_want[0] = 0xFF;
    m8_want[1] = 0x60;
    m8_want[2] = 0x08;
    if (!t_inst_bytes(?m8, ?m8_want[0], 3)) { bad = 1; }

    var midx:    isa.Inst = t_indirect_jmp(isa.make_mem(x64.RAX, 16, x64.RBX, 8, 8));
    var mi_want: [4]u8;
    mi_want[0] = 0xFF;
    mi_want[1] = 0x64;
    mi_want[2] = 0xD8;
    mi_want[3] = 0x10;
    if (!t_inst_bytes(?midx, ?mi_want[0], 4)) { bad = 1; }

    var m13:      isa.Inst = t_indirect_jmp(isa.make_mem(x64.R13, 0, -1, 0, 8));
    var m13_want: [4]u8;
    m13_want[0] = 0x41;
    m13_want[1] = 0xFF;
    m13_want[2] = 0x65;
    m13_want[3] = 0x00;
    if (!t_inst_bytes(?m13, ?m13_want[0], 4)) { bad = 1; }

    var mabs:     isa.Inst = t_indirect_jmp(isa.make_mem(x64.MEM_BASE_ABS, 0x100018, -1, 0, 8));
    var abs_want: [7]u8;
    abs_want[0] = 0xFF;
    abs_want[1] = 0x24;
    abs_want[2] = 0x25;
    abs_want[3] = 0x18;
    abs_want[4] = 0x00;
    abs_want[5] = 0x10;
    abs_want[6] = 0x00;
    if (!t_inst_bytes(?mabs, ?abs_want[0], 7)) { bad = 1; }

    ret bad;
}

test encode_jmp__refuses_unmodelled_indirect_target {
    var bad: i32 = 0;

    var lbl: isa.Inst = t_indirect_jmp(isa.make_block_label(7));
    if (!t_inst_refused(?lbl)) { bad = 1; }

    var mimm: isa.Inst = t_indirect_jmp(isa.make_imm(0x100018, 8));
    if (!t_inst_refused(?mimm)) { bad = 1; }

    var mnone: isa.Inst = t_indirect_jmp(isa.make_none());
    if (!t_inst_refused(?mnone)) { bad = 1; }

    ret bad;
}

# a block or symbol jump target stays the direct rel32 form
test mir_to_inst__jmp_targets_stay_direct {
    var want: [5]u8;
    want[0] = 0xE9;
    want[1] = 0x00;
    want[2] = 0x00;
    want[3] = 0x00;
    want[4] = 0x00;

    var ops: [1]mir.MirOperand;
    ops[0] = mir.op_block(7);
    var mi: mir.MirInstr = mir.instr(x64.JMP::u32, ?ops[0], 1, 8, 8);

    var inst: isa.Inst       = isa.inst_blank();
    val r:    err[fail.Fail] = mir_to_inst(nil, ?mi, ?inst);
    if (sel r.err)                                  { ret 1; }
    if ((inst.flags & x64.FLAG_INDIRECT::u16) != 0) { ret 2; }
    if (inst.dst.kind != isa.OPK_LABEL)             { ret 3; }
    if (!t_inst_bytes(?inst, ?want[0], 5))          { ret 4; }

    ops[0] = mir.op_sym(intern.STR_NIL, 0);
    inst   = isa.inst_blank();
    val rs: err[fail.Fail] = mir_to_inst(nil, ?mi, ?inst);
    if (sel rs.err)                                 { ret 5; }
    if ((inst.flags & x64.FLAG_INDIRECT::u16) != 0) { ret 6; }
    if (!t_inst_bytes(?inst, ?want[0], 5))          { ret 7; }
    ret 0;
}

test x64_mem__malformed_addresses_refused {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov [{ptr}], rax", nil, nil, nil, nil);
    var item: iasm.Item;
    val r:    res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (!sel r.err) { ret 1; }
    val msg: str = fail.describe(r.err);
    if (!str_contains(msg, "stack-slot binding"))                          { ret 1; }
    if (!str_contains(msg, "load it into a register first"))               { ret 1; }
    if (str_contains(msg, "malformed inline-asm two-operand instruction")) { ret 1; }

    if (!t_asm_refused("mov rax, [rbx + rsp*2]", "rsp cannot be used as an inline-asm memory index register"))           { ret 2; }
    if (!t_asm_refused("mov rax, [rbx + 99999999999]", "memory displacement does not fit a signed 32-bit displacement")) { ret 3; }
    ret 0;
}

test x64_emit__local_label_rel32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;

    var g:      iasm.Grammar = x64_grammar();
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "", ?alloc, nil, nil, nil);

    var jm: iasm.Item;
    jm.kind  = iasm.AI_INST;
    jm.code  = x64.JMP::u32;
    jm.flags = X64P_BRANCH;
    jm.nops  = 0;
    jm.ref   = iasm.AR_LOCAL;

    var bad: i32 = 0;

    val dr: err[fail.Fail] = iasm.label_record_def(?st, ?g, ?labels, 1, 0);
    if (sel dr.err) { bad = 1; }
    jm.ref_num = 1;
    jm.ref_fwd = false;
    val br: err[fail.Fail] = x64_emit(?st, ?c, ?labels, ?jm);
    if (sel br.err)             { bad = 1; }
    if (st.buf.len != 5)        { bad = 1; }
    or (st.buf.data[0] != 0xE9) { bad = 1; }
    or (st.buf.data[1] != 0xFB) { bad = 1; }
    or (st.buf.data[2] != 0xFF) { bad = 1; }
    or (st.buf.data[3] != 0xFF) { bad = 1; }
    or (st.buf.data[4] != 0xFF) { bad = 1; }

    jm.ref_num = 2;
    jm.ref_fwd = true;
    val fr: err[fail.Fail] = x64_emit(?st, ?c, ?labels, ?jm);
    if (sel fr.err)              { bad = 1; }
    if (labels.fixup_count != 1) { bad = 1; }
    val dr2: err[fail.Fail] = iasm.label_record_def(?st, ?g, ?labels, 2, st.buf.len::u32);
    if (sel dr2.err)             { bad = 1; }
    if (labels.fixup_count != 0) { bad = 1; }
    or (st.buf.data[5] != 0xE9)  { bad = 1; }
    or (st.buf.data[6] != 0x00)  { bad = 1; }
    or (st.buf.data[7] != 0x00)  { bad = 1; }
    or (st.buf.data[8] != 0x00)  { bad = 1; }
    or (st.buf.data[9] != 0x00)  { bad = 1; }

    jm.ref_num = 9;
    jm.ref_fwd = false;
    val ur: err[fail.Fail] = x64_emit(?st, ?c, ?labels, ?jm);
    if (!sel ur.err) { bad = 1; }

    iasm.labels_dnit(?labels);
    enc.buf_dnit(?st.buf);
    ret bad;
}

test x64_parse__body_to_inst {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov rax, rbx\nlock xadd [rcx], rax\nsyscall\n1:\njmp 1b", nil, nil, nil, nil);
    var item: iasm.Item;
    var bad:  i32 = 0;

    val r_5380: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel r_5380.err)            { ret 1; }
    if (item.kind != iasm.AI_INST) { bad = 1; }
    var mi: isa.Inst = x64_build(?item, intern.STR_NIL);
    if (mi.opcode != x64.MOV)                    { bad = 1; }
    if (mi.size != 8)                            { bad = 1; }
    if ((mi.flags & x64.FLAG_REX_W::u16) == 0)   { bad = 1; }
    if (mi.dst.kind != isa.OPK_REG)              { bad = 1; }
    if (mi.dst.reg != x64.RAX)                   { bad = 1; }
    if (mi.src1.reg != x64.RBX)                  { bad = 1; }
    if (item.src_off != 0 || item.src_len != 12) { bad = 1; }

    val r_5391: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel r_5391.err) { ret 1; }
    mi = x64_build(?item, intern.STR_NIL);
    if (mi.opcode != x64.XADD)                { bad = 1; }
    if ((mi.flags & x64.FLAG_LOCK::u16) == 0) { bad = 1; }
    if (mi.dst.kind != isa.OPK_MEM)           { bad = 1; }
    if (mi.dst.base != x64.RCX)               { bad = 1; }
    if (mi.src1.reg != x64.RAX)               { bad = 1; }

    val r_5399: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel r_5399.err)                                         { ret 1; }
    if (x64_build(?item, intern.STR_NIL).opcode != x64.SYSCALL) { bad = 1; }

    val r_5402: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel r_5402.err)                                  { ret 1; }
    if (item.kind != iasm.AI_LABEL || item.ref_num != 1) { bad = 1; }

    val r_5405: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel r_5405.err)                                     { ret 1; }
    if (x64_build(?item, intern.STR_NIL).opcode != x64.JMP) { bad = 1; }
    if (item.ref != iasm.AR_LOCAL)                          { bad = 1; }
    if (item.ref_num != 1 || item.ref_fwd)                  { bad = 1; }

    val last: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel last.err) { ret 1; }
    if (last.ok)      { bad = 1; }
    ret bad;
}

test asm_clobbers__declared_raw_encodings {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".byte 0xee :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0xee", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0x0f, 0x31 :: writes(rax, rdx)", ?gp, ?fp);
    if (gp != 0x5) { bad = 1; }
    if (fp != 0)   { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0x90 :: writes(xmm3)", ?gp, ?fp);
    if (gp != 0)             { bad = 1; }
    if (fp != (1::u32 << 3)) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0x90 :: writes(rbx, xmm15)", ?gp, ?fp);
    if (gp != (1::u32 << 3))  { bad = 1; }
    if (fp != (1::u32 << 15)) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0xee :: writes()\n.byte 0x90", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers("mov rdx, rcx\n.byte 0xee :: writes()", ?gp, ?fp);
    if (gp != (1::u32 << 2)) { bad = 1; }
    if (fp != 0)             { bad = 1; }

    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0xee   ::   writes( rax , rdx )", ?gp, ?fp);
    if (gp != 0x5) { bad = 1; }
    gp = 0;
    fp = 0;
    asm_clobbers(".byte 0xee :: writes() ; .byte 0x90 :: writes(rcx)", ?gp, ?fp);
    if (gp != (1::u32 << 1)) { bad = 1; }

    ret bad;
}

test declared_raw_encodings__emit_and_accounting {
    var bad: i32 = 0;

    var one: [1]u8;
    one[0] = 0xEE;
    if (!t_asm_bytes(".byte 0xee :: writes()", ?one[0], 1)) { bad = 1; }

    var two: [2]u8;
    two[0] = 0x0F;
    two[1] = 0x31;
    if (!t_asm_bytes(".byte 0x0f, 0x31 :: writes(rax, rdx)", ?two[0], 2)) { bad = 1; }

    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, ".byte 0xee :: writes(rax)", nil, nil, nil, nil);
    var item:   iasm.Item;
    val r_5480: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel r_5480.err)             { ret 1; }
    if (item.kind != iasm.AI_BYTES) { bad = 1; }
    if (!item.declared)             { bad = 1; }
    if (item.decl_gp != 1)          { bad = 1; }
    if (item.decl_fp != 0)          { bad = 1; }
    if (item.byte_count != 1)       { bad = 1; }

    val last: res[bool, fail.Fail] = iasm.next(?c, ?item);
    if (sel last.err) { ret 1; }
    if (last.ok)      { bad = 1; }

    var c2: iasm.Cursor;
    iasm.cursor_init(?c2, ?g, ".byte 0xee", nil, nil, nil, nil);
    val r_5493: res[bool, fail.Fail] = iasm.next(?c2, ?item);
    if (sel r_5493.err) { ret 1; }
    if (item.declared)  { bad = 1; }

    ret bad;
}

test declared_raw_encodings__malformed_clauses_refused {
    var bad: i32 = 0;

    if (!t_asm_refused(".byte 0x90 :: writes(nosuchreg)", "not a register on this target")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(r16)", "not a register on this target"))       { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(eax)", "not a register on this target"))       { bad = 1; }

    if (!t_asm_refused(".byte 0x90 :: writes(rax", "closing"))   { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes", "parenthesized")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 ::", "names no attribute"))   { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(rax,)", "empty"))   { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(,rax)", "empty"))   { bad = 1; }

    if (!t_asm_refused(".byte 0x90 :: reads(rax)", "unknown")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: noreturn", "unknown"))   { bad = 1; }

    if (!t_asm_refused("mov rax, rbx :: writes()", "only a data directive")) { bad = 1; }
    if (!t_asm_refused("nop :: writes()", "only a data directive"))          { bad = 1; }
    if (!t_asm_refused("1: :: writes()", "only a data directive"))           { bad = 1; }

    ret bad;
}

# a spill, a push/pop and a pushfq/pop round trip each keep the taint they carry
test asm_ct_scan__round_trips_keep_the_taint {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val addr:   str            = "mov rax, {r}\nmov [rsp], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    val r_5531: err[fail.Fail] = asm_ct_scan(addr, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5531.err) { bad = bad + 1; }
    val r_5532: err[fail.Fail] = asm_ct_scan(addr, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5532.err) { bad = bad + 2; }

    val lat:    str            = "mov rax, {r}\nmov [rsp], rax\nmov rcx, [rsp]\nshl rdx, cl";
    val r_5535: err[fail.Fail] = asm_ct_scan(lat, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5535.err) { bad = bad + 4; }
    val r_5536: err[fail.Fail] = asm_ct_scan(lat, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5536.err) { bad = bad + 8; }

    val br:     str            = "mov rax, {r}\nmov [rsp], rax\nmov rbx, [rsp]\ncmp rbx, 1\njz 1f\n1:\nnop";
    val r_5539: err[fail.Fail] = asm_ct_scan(br, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5539.err) { bad = bad + 16; }
    val r_5540: err[fail.Fail] = asm_ct_scan(br, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5540.err) { bad = bad + 32; }

    val pub:    str            = "mov [rsp], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    val r_5543: err[fail.Fail] = asm_ct_scan(pub, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5543.err) { bad = bad + 64; }

    val opaque: str            = "mov rax, {r}\nmov [rdx + rsi * 8], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    val r_5546: err[fail.Fail] = asm_ct_scan(opaque, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5546.err) { bad = bad + 128; }

    # a push/pop round trip carries a register's taint, and pushfq/pop the flags'
    val leak:   str            = "mov rax, {r}\npush rax\npop rbx\ncmp rbx, 1\nje 1f\n1:\nnop";
    val r_leak: err[fail.Fail] = asm_ct_scan(leak, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_leak.err) { bad = bad + 256; }
    val r_lpub: err[fail.Fail] = asm_ct_scan(leak, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_lpub.err) { bad = bad + 512; }
    val noflow: str            = "mov rax, {r}\npush rax\npop rbx";
    val r_nf:   err[fail.Fail] = asm_ct_scan(noflow, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_nf.err) { bad = bad + 1024; }

    val fl:   str            = "mov rax, {r}\ncmp rax, rbx\npushfq\npop rcx\ncmp rcx, 1\nje 1f\n1:\nnop";
    val r_fl: err[fail.Fail] = asm_ct_scan(fl, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_fl.err) { bad = bad + 2048; }
    val flpub: str            = "mov rax, 5\ncmp rax, rbx\npushfq\npop rcx\ncmp rcx, 1\nje 1f\n1:\nnop";
    val r_flp: err[fail.Fail] = asm_ct_scan(flpub, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_flp.err) { bad = bad + 4096; }

    ret bad;
}

# a secret in xmm3 is not a secret in rbx, and a secret vector reaches its variable-latency uses
test asm_ct_scan__vector_taint_is_its_own_bank {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");

    val apart: err[fail.Fail] = asm_ct_scan("movdqu xmm3, {k}\nmov rax, [rbx]", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel apart.err) { bad = bad + 1; }

    val addr: err[fail.Fail] = asm_ct_scan("mov rbx, {k}\nmovdqu xmm0, [rbx]", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel addr.err) { bad = bad + 2; }

    val flow: err[fail.Fail] = asm_ct_scan("movups xmm1, {k}\nmovaps xmm5, xmm1\npxor xmm5, xmm2\nmulps xmm6, xmm5", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel flow.err) { bad = bad + 4; }

    val public: err[fail.Fail] = asm_ct_scan("movups xmm1, {k}\nmulps xmm6, xmm2", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel public.err) { bad = bad + 8; }

    val lanes: err[fail.Fail] = asm_ct_scan("movdqu xmm1, {k}\npmullw xmm1, xmm2", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel lanes.err) { bad = bad + 16; }
    ret bad;
}

test asm_ct_scan__implicit_read_taints_defined_flags {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val cx:     str            = "mov rax, {r}\ncmpxchg [rbx], rcx\nje 1f\n1:\nnop";
    val r_5560: err[fail.Fail] = asm_ct_scan(cx, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5560.err) { bad = bad + 1; }
    val r_5561: err[fail.Fail] = asm_ct_scan(cx, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5561.err) { bad = bad + 2; }

    val pub:    str            = "mov rax, 5\ncmpxchg [rbx], rcx\nje 1f\n1:\nnop";
    val r_5564: err[fail.Fail] = asm_ct_scan(pub, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5564.err) { bad = bad + 4; }

    val unrelated: str            = "mov rax, {r}\nmov rdx, [rbx]\nje 1f\n1:\nnop";
    val r_5567:    err[fail.Fail] = asm_ct_scan(unrelated, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5567.err) { bad = bad + 8; }

    ret bad;
}

test asm_ct_scan__register_indirect_transfer_on_secret_refused {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val jt:     str            = "mov rax, {r}\njmp rax";
    val r_5581: err[fail.Fail] = asm_ct_scan(jt, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5581.err) { bad = bad + 1; }
    val r_5582: err[fail.Fail] = asm_ct_scan(jt, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5582.err) { bad = bad + 2; }

    val calls:  str            = "mov rax, {r}\ncall rax";
    val r_5585: err[fail.Fail] = asm_ct_scan(calls, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel r_5585.err) { bad = bad + 4; }
    val r_5586: err[fail.Fail] = asm_ct_scan(calls, ?names[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5586.err) { bad = bad + 8; }

    val pubj:   str            = "mov rax, 5\njmp rax";
    val r_5589: err[fail.Fail] = asm_ct_scan(pubj, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5589.err) { bad = bad + 16; }

    val pubc:   str            = "mov rax, 5\ncall rax";
    val r_5592: err[fail.Fail] = asm_ct_scan(pubc, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5592.err) { bad = bad + 32; }

    val direct: str            = "jmp some_symbol";
    val r_5595: err[fail.Fail] = asm_ct_scan(direct, ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (sel r_5595.err) { bad = bad + 64; }

    ret bad;
}

test asm_ct_scan__a_declaration_is_not_a_verification {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("secret");

    val undeclared: err[fail.Fail] = asm_ct_scan(".byte 0x90", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel undeclared.err) { bad = 1; }

    val declared: err[fail.Fail] = asm_ct_scan(".byte 0x90 :: writes()", ?names[0], 1, ct.mul_mask_none(), false, ?alloc);
    if (!sel declared.err) { bad = 1; }
    if (sel declared.err) {
        if (!str_contains(fail.describe(declared.err), "writes(...)")) { bad = 1; }
    }

    ret bad;
}

# a `*^T` binding is a public address whose loads produce a secret; a `^T` or `^*T`
# binding is a secret value, so it is a secret address (#3640)
test asm_ct_scan__a_pointer_to_a_secret_is_a_public_address_and_a_secret_load {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var binds: [2]ct.AsmSecret;
    binds[0] = ct.asm_secret_pointee("p");
    binds[1] = ct.asm_secret_value("k");

    val rmw: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov ecx, [rax]\nadd ecx, 1\nmov [rax], ecx", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel rmw.err) { bad = bad + 1; }
    val vec: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmovdqu xmm1, [rax]\nmovdqu xmm2, [rax + 16]\npaddd xmm1, xmm2\nmovdqu [rax], xmm1", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel vec.err) { bad = bad + 2; }
    val pubstore: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov dword [rax], 7", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel pubstore.err) { bad = bad + 4; }

    val secret_addr: err[fail.Fail] = asm_ct_scan("mov rax, {k}\nmov ecx, [rax]", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel secret_addr.err) {
        if (!str_contains(fail.describe(secret_addr.err), "addresses memory with a secret value")) { bad = bad + 8; }
    }
    or { bad = bad + 8; }
    val secret_base: err[fail.Fail] = asm_ct_scan("mov rax, {k}\nwrgsbase rax", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel secret_base.err) {
        if (!str_contains(fail.describe(secret_base.err), "address base")) { bad = bad + 16; }
    }
    or { bad = bad + 16; }

    val branch: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov ecx, [rax]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel branch.err) {
        if (!str_contains(fail.describe(branch.err), "branches on a secret value")) { bad = bad + 32; }
    }
    or { bad = bad + 32; }
    val loaded_addr: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov rcx, [rax]\nmov rdx, [rcx]", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel loaded_addr.err) {
        if (!str_contains(fail.describe(loaded_addr.err), "addresses memory with a secret value")) { bad = bad + 64; }
    }
    or { bad = bad + 64; }

    val copied: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov rbx, rax\nmov ecx, [rbx + 4]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel copied.err) { bad = bad + 128; }
    val indexed: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov ecx, [rdx + rax * 4]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel indexed.err) { bad = bad + 256; }

    val pub_base: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nwrgsbase rax", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (sel pub_base.err) { bad = bad + 512; }
    val seg_load: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nwrgsbase rax\nmov ecx, gs:[8]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel seg_load.err) { bad = bad + 1024; }

    val untracked: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov ecx, [rax]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 0, ct.mul_mask_none(), false, ?alloc);
    if (sel untracked.err) { bad = bad + 2048; }

    val pushed: err[fail.Fail] = asm_ct_scan("mov rax, {p}\npush rax\npop rbx\nmov ecx, [rbx]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel pushed.err) { bad = bad + 4096; }
    val spilled: err[fail.Fail] = asm_ct_scan("mov rax, {p}\nmov [rsp], rax\nmov rbx, [rsp]\nmov ecx, [rbx]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false, ?alloc);
    if (!sel spilled.err) { bad = bad + 8192; }

    ret bad;
}

test asm_clobbers__derived_from_parse {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("mov rax, rbx", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32)) { bad = 1; }
    if (fp != 0)                        { bad = 1; }

    asm_clobbers("syscall", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RAX::u32) | (1::u32 << x64.RCX::u32) | (1::u32 << x64.R11::u32))) { bad = 1; }

    asm_clobbers("mov [rcx], rax\ncmp rax, rbx\npush rbx", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    asm_clobbers("xchg rdx, rsi", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RDX::u32) | (1::u32 << x64.RSI::u32))) { bad = 1; }
    asm_clobbers("cmpxchg rbx, rdx", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RBX::u32) | (1::u32 << x64.RAX::u32))) { bad = 1; }

    asm_clobbers("mov rax, {v}", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32)) { bad = 1; }
    if (fp != 0)                        { bad = 1; }
    asm_clobbers("mov {result}, rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    asm_clobbers("lock xadd {slot}, rax", ?gp, ?fp);
    if (gp != (1::u32 << x64.RAX::u32)) { bad = 1; }

    asm_clobbers("mov rcx, {ptr}\nmov rax, [rcx]\nmov {result}, rax", ?gp, ?fp);
    if (gp != ((1::u32 << x64.RAX::u32) | (1::u32 << x64.RCX::u32))) { bad = 1; }

    asm_clobbers(".byte 0x90", ?gp, ?fp);
    if (gp != X64_ALL_GP || fp != X64_ALL_FP) { bad = 1; }
    asm_clobbers("frobnicate rax, rbx", ?gp, ?fp);
    if (gp != X64_ALL_GP || fp != X64_ALL_FP) { bad = 1; }
    asm_clobbers("frobnicate", ?gp, ?fp);
    if (gp != X64_ALL_GP || fp != X64_ALL_FP) { bad = 1; }
    ret bad;
}

test asm_claim__refuses_unclaimed_byte {
    var bad: i32          = 0;
    var g:   iasm.Grammar = x64_grammar();

    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov rax, rbx", nil, nil, nil, nil);
    val r_5706: err[fail.Fail] = iasm.claim(?c, 0, 3);
    if (sel r_5706.err) { bad = 1; }
    val r_5707: err[fail.Fail] = iasm.claim(?c, 9, 3);
    if (!sel r_5707.err) { bad = 1; }

    var q: iasm.Cursor;
    iasm.cursor_init(?q, ?g, "mov rax", nil, nil, nil, nil);
    val r_5711: err[fail.Fail] = iasm.claim(?q, 0, 3);
    if (sel r_5711.err) { bad = 1; }
    val r_5712: err[fail.Fail] = iasm.claim(?q, 4, 3);
    if (sel r_5712.err) { bad = 1; }
    val r_5713: err[fail.Fail] = iasm.claim(?q, 5, 2);
    if (!sel r_5713.err) { bad = 1; }
    ret bad;
}

test x64_asm_text__unresolved_binding_refused {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc       = ?alloc;
    st.buf         = enc.buf_init(?alloc);
    st.interner    = nil;
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;

    var bad: i32 = 0;
    var f:   mir.MirFunction;
    var l:   iasm.Labels;
    iasm.labels_init(?l, ?alloc);

    val src: err[fail.Fail] = x64_asm_text(?st, ?f, ?l, "mov rax, {v}");
    if (!sel src.err) { bad = 1; }
    or (sel src.err) {
        if (!str_contains(fail.describe(src.err), "unresolved '{name}'")) { bad = 1; }
    }
    val r_5734: err[fail.Fail] = x64_asm_text(?st, ?f, ?l, "mov {v}, rax");
    if (!sel r_5734.err) { bad = 1; }
    val r_5735: err[fail.Fail] = x64_asm_text(?st, ?f, ?l, "neg {v}");
    if (!sel r_5735.err) { bad = 1; }

    if (st.buf.len != 0) { bad = 1; }

    iasm.labels_dnit(?l);
    enc.buf_dnit(?st.buf);
    ret bad;
}

test encode_mir_instr__branch_to_fallthrough_elided {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc       = ?alloc;
    st.buf         = enc.buf_init(?alloc);
    st.interner    = nil;
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;

    var bad: i32 = 0;

    var f: mir.MirFunction;

    var jops: [1]mir.MirOperand;
    jops[0] = mir.op_block(4);
    var jm: mir.MirInstr = mir.instr(x64.JMP::u32, ?jops[0], 1, 8, 0);

    st.has_next_block = false;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_mir_instr(?st, ?f, 0, ?jm);
    if (st.buf.len != 5)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    st.has_next_block = true;
    st.next_block_id  = 4;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_mir_instr(?st, ?f, 0, ?jm);
    if (st.buf.len != 0)     { bad = 1; }
    if (st.fixup_count != 0) { bad = 1; }

    st.has_next_block = true;
    st.next_block_id  = 9;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_mir_instr(?st, ?f, 0, ?jm);
    if (st.buf.len != 5)     { bad = 1; }
    if (st.fixup_count != 1) { bad = 1; }

    var cops: [3]mir.MirOperand;
    cops[0] = mir.op_preg(mir.preg_id(x64.RAX));
    cops[1] = mir.op_block(3);
    cops[2] = mir.op_block(4);
    var cbr: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR, ?cops[0], 3, 8, 0);

    st.has_next_block = false;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_cbr(?st, ?f, 0, ?cbr);
    val cbr_len: usize = st.buf.len;
    val cbr_fx:  u32   = st.fixup_count;
    st.has_next_block = true;
    st.next_block_id  = 4;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_cbr(?st, ?f, 0, ?cbr);
    if (st.buf.len != cbr_len - 5)      { bad = 1; }
    if (st.fixup_count != cbr_fx - 1)   { bad = 1; }
    if (st.fixups[0].target_block != 3) { bad = 1; }

    var ops: [4]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(x64.RCX));
    ops[1] = mir.op_preg(mir.preg_id(x64.RDX));
    ops[2] = mir.op_block(3);
    ops[3] = mir.op_block(4);
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_CBR_EQ, ?ops[0], 4, 8, 0);

    st.has_next_block = false;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_fused_cbr(?st, ?f, 0, ?mi);
    val fus_len: usize = st.buf.len;
    val fus_fx:  u32   = st.fixup_count;
    st.has_next_block = true;
    st.next_block_id  = 4;
    st.buf.len        = 0;
    st.fixup_count    = 0;
    encode_fused_cbr(?st, ?f, 0, ?mi);
    if (st.buf.len != fus_len - 5)      { bad = 1; }
    if (st.fixup_count != fus_fx - 1)   { bad = 1; }
    if (st.fixups[0].target_block != 3) { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}

# `d = l op r` runs as `mov d, l; op d, r`: a right operand in d's register
# is a pairing the allocator never produces, and the encoder refuses it
# rather than reading the copied-over value (#3647)
test encode_binary__refuses_a_right_operand_in_the_destination_register {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var f:   mir.MirFunction;

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(x64.RAX));
    ops[1] = mir.op_preg(mir.preg_id(x64.RDI));
    ops[2] = mir.op_preg(mir.preg_id(x64.RAX));
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_SUB, ?ops[0], 3, 8, 8);
    if (!t_refused(encode_binary(?f, ?mi, ?buf), ?buf)) { ret 1; }

    ops[2] = mir.op_mem_preg(mir.preg_id(x64.RAX), 8);
    if (!t_refused(encode_binary(?f, ?mi, ?buf), ?buf)) { ret 2; }

    # the left operand in the destination is the in-place form
    ops[1] = mir.op_preg(mir.preg_id(x64.RAX));
    ops[2] = mir.op_preg(mir.preg_id(x64.RDI));
    if (!t_accepted(encode_binary(?f, ?mi, ?buf), ?buf)) { ret 3; }
    if (buf.len != 3)                                    { ret 4; }
    if (buf.data[0] != 0x48 || buf.data[1] != 0x29)      { ret 4; }

    buf.len = 0;
    ops[1]  = mir.op_preg(mir.preg_id(x64.RDI));
    ops[2]  = mir.op_preg(mir.preg_id(x64.RCX));
    if (!t_accepted(encode_binary(?f, ?mi, ?buf), ?buf)) { ret 5; }
    enc.buf_dnit(?buf);
    ret 0;
}

# a 16-bit multiply takes an imm16, not an imm32, and refuses one past 16 bits; a byte multiply has no immediate form
test encode_imul__immediate_widths {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);

    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.IMUL;
    mi.dst    = isa.make_reg(x64.RAX, 2);
    mi.src1   = isa.make_imm(0x1234, 2);
    mi.size   = 2;
    mi.flags  = x64.FLAG_16BIT;
    val n: i32 = encode_imul(?mi, ?buf);

    var bad: i32 = 0;
    if (n != 5)              { bad = 1; }
    or (buf.data[0] != 0x66) { bad = 1; }
    or (buf.data[1] != 0x69) { bad = 1; }
    or (buf.data[2] != 0xC0) { bad = 1; }
    or (buf.data[3] != 0x34) { bad = 1; }
    or (buf.data[4] != 0x12) { bad = 1; }

    var mi8: isa.Inst = isa.inst_blank();
    mi8.opcode = x64.IMUL;
    mi8.dst    = isa.make_reg(x64.RAX, 1);
    mi8.src1   = isa.make_imm(5, 1);
    mi8.size   = 1;
    if (encode_imul(?mi8, ?buf) != 0) { bad = 1; }

    var big: isa.Inst = isa.inst_blank();
    big.opcode = x64.IMUL;
    big.dst    = isa.make_reg(x64.RAX, 2);
    big.src1   = isa.make_imm(70000, 2);
    big.size   = 2;
    if (encode_inst(?big, ?buf) != 0) { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

