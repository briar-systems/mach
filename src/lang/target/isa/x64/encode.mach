use mach.lang.fail;
use std.allocator.page;
use std.io.writer;
use std.system.os;
use std.system.panic.panic;
use std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.be.codegen.ctwalk;
use enc:           mach.lang.be.codegen.encode;
use codegen_frame: mach.lang.be.codegen.frame;
use mach.lang.be.codegen.mir;
use mach.lang.ct;
use mach.lang.intern;
use mach.lang.target.abi;
use mach.lang.target.isa;
use iasm: mach.lang.target.isa.asm;
use mach.lang.target.isa.common;
use mach.lang.target.isa.convplan;
use mach.lang.target.isa.x64;
use mach.lang.target.isa.x64.printer;
use mach.lang.target.of;
use tos: mach.lang.target.os;

fun reg_bits(id: i32) u8 {
    ret (isa.regid_index(id) & 7)::u8;
}

fun operand_touches_reg(op: *isa.Operand, reg: i32) bool {
    if (op == nil)              { ret false; }
    if (op.kind == isa.OPK_REG) { ret op.reg == reg; }
    if (op.kind == isa.OPK_MEM) { ret op.base == reg || op.index == reg; }
    ret false;
}

fun pick_stage_scratch(a: *isa.Operand, b: *isa.Operand) i32 {
    val r11_taken: bool = operand_touches_reg(a, x64.R11) || operand_touches_reg(b, x64.R11);
    if (!r11_taken) { ret x64.R11; }
    val r10_taken: bool = operand_touches_reg(a, x64.R10) || operand_touches_reg(b, x64.R10);
    if (!r10_taken) { ret x64.R10; }
    ret -1;
}

fun needs_rex(id: i32) bool {
    val index: i32 = isa.regid_index(id);
    ret index >= 8 && index <= 15;
}

fun needs_rex_byte(id: i32) bool {
    val index: i32 = isa.regid_index(id);
    ret index >= 4 && index <= 15;
}

fun encode_rex(w: u8, reg: i32, rm: i32) u8 {
    var rex: u8 = 0x40;
    if (w != 0) { rex = rex | 0x08; }
    val reg_i: i32 = isa.regid_index(reg);
    val rm_i:  i32 = isa.regid_index(rm);
    if (reg_i >= 8 && reg_i <= 15) { rex = rex | 0x04; }
    if (rm_i >= 8 && rm_i <= 15)   { rex = rex | 0x01; }
    ret rex;
}

fun encode_rex_sib(w: u8, reg: i32, index: i32, base: i32) u8 {
    var rex: u8 = 0x40;
    if (w != 0) { rex = rex | 0x08; }
    val reg_i:   i32 = isa.regid_index(reg);
    val index_i: i32 = isa.regid_index(index);
    val base_i:  i32 = isa.regid_index(base);
    if (reg_i >= 8 && reg_i <= 15)     { rex = rex | 0x04; }
    if (index_i >= 8 && index_i <= 15) { rex = rex | 0x02; }
    if (base_i >= 8 && base_i <= 15)   { rex = rex | 0x01; }
    ret rex;
}

fun encode_modrm(mod_val: u8, reg: u8, rm: u8) u8 {
    ret ((mod_val & 3) << 6) | ((reg & 7) << 3) | (rm & 7);
}

fun encode_sib(scale: u8, index: u8, base: u8) u8 {
    ret ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7);
}

fun size_to_w(size: u8, flags: u16) u8 {
    if ((flags & x64.FLAG_REX_W::u16) != 0) { ret 1; }
    if (size >= 8)                          { ret 1; }
    ret 0;
}

fun needs_any_rex(w: u8, reg: i32, rm: i32) bool {
    if (w != 0) { ret true; }
    val reg_i: i32 = isa.regid_index(reg);
    val rm_i:  i32 = isa.regid_index(rm);
    if (reg_i >= 8 && reg_i <= 15) { ret true; }
    if (rm_i >= 8 && rm_i <= 15)   { ret true; }
    ret false;
}

fun needs_rex_for_byte_reg(reg: i32) bool {
    val index: i32 = isa.regid_index(reg);
    ret index >= 4 && index <= 7;
}

fun encode_mem_operand(buf: *enc.ByteBuf, reg: i32, op: *isa.Operand) {
    val base:      i32  = op.base;
    val index:     i32  = op.index;
    val disp:      i32  = op.disp;
    val has_index: bool = index >= 0;

    if (base != -1 && base != x64.MEM_BASE_ABS && isa.regid_class(base) != isa.REG_CLASS_ID_GP) {
        panic("encode: memory base register is not general-purpose\n");
    }
    if (has_index && isa.regid_class(index) != isa.REG_CLASS_ID_GP) {
        panic("encode: memory index register is not general-purpose\n");
    }
    if (has_index && isa.regid_index(index) == x64.RSP) {
        panic("encode: RSP cannot be used as a SIB index register\n");
    }

    if (base == x64.MEM_BASE_ABS) {
        if (has_index) { panic("encode: absolute memory operand carries an index register\n"); }
        enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 4));
        enc.emit_byte(buf, encode_sib(0, 4, 5));
        enc.emit_u32(buf, disp::u32);
        ret;
    }

    if (base == -1 && !has_index) {
        enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 5));
        enc.emit_u32(buf, disp::u32);
        ret;
    }

    var scale_bits: u8 = 0;
    if (has_index) {
        if (op.scale <= 1) { scale_bits = 0; }
        or (op.scale == 2) { scale_bits = 1; }
        or (op.scale == 4) { scale_bits = 2; }
        or (op.scale == 8) { scale_bits = 3; }
        or {
            panic("encode: invalid SIB scale (must be 1, 2, 4, or 8)\n");
        }
    }

    if (base == -1 && has_index) {
        enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 4));
        enc.emit_byte(buf, encode_sib(scale_bits, reg_bits(index), 5));
        enc.emit_u32(buf, disp::u32);
        ret;
    }

    val base_needs_sib: bool = (base & 7) == 4;
    val use_sib:        bool = has_index || base_needs_sib;

    if (base == 5 || base == 13) {
        if (disp == 0) {
            if (use_sib) {
                enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), 4));
                var idx_reg: u8 = 4;
                if (has_index) { idx_reg = reg_bits(index); }
                enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
            }
            or {
                enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), reg_bits(base)));
            }
            enc.emit_byte(buf, 0);
            ret;
        }
    }

    if (disp == 0) {
        if (use_sib) {
            enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), 4));
            var idx_reg: u8 = 4;
            if (has_index) { idx_reg = reg_bits(index); }
            enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
        }
        or {
            enc.emit_byte(buf, encode_modrm(0, reg_bits(reg), reg_bits(base)));
        }
        ret;
    }

    if (disp >= -128 && disp <= 127) {
        if (use_sib) {
            enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), 4));
            var idx_reg: u8 = 4;
            if (has_index) { idx_reg = reg_bits(index); }
            enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
        }
        or {
            enc.emit_byte(buf, encode_modrm(1, reg_bits(reg), reg_bits(base)));
        }
        enc.emit_byte(buf, disp::u8);
        ret;
    }

    if (use_sib) {
        enc.emit_byte(buf, encode_modrm(2, reg_bits(reg), 4));
        var idx_reg: u8 = 4;
        if (has_index) { idx_reg = reg_bits(index); }
        enc.emit_byte(buf, encode_sib(scale_bits, idx_reg, reg_bits(base)));
    }
    or {
        enc.emit_byte(buf, encode_modrm(2, reg_bits(reg), reg_bits(base)));
    }
    enc.emit_u32(buf, disp::u32);
}

fun emit_rex_byte_mem(buf: *enc.ByteBuf, reg: i32, mem: *isa.Operand) {
    if (mem.index >= 0) {
        enc.emit_byte(buf, encode_rex_sib(0, reg, mem.index, mem.base));
    }
    or {
        enc.emit_byte(buf, encode_rex(0, reg, mem.base));
    }
}

fun emit_rex_if_needed(buf: *enc.ByteBuf, w: u8, reg: i32, rm: i32) {
    if (needs_any_rex(w, reg, rm)) {
        enc.emit_byte(buf, encode_rex(w, reg, rm));
    }
}

fun emit_rex_mem(buf: *enc.ByteBuf, w: u8, reg: i32, mem: *isa.Operand) {
    val base:  i32 = mem.base;
    val index: i32 = mem.index;
    if (index >= 0) {
        val rex: u8 = encode_rex_sib(w, reg, index, base);
        if (rex != 0x40 || w != 0) {
            enc.emit_byte(buf, rex);
        }
    }
    or {
        emit_rex_if_needed(buf, w, reg, base);
    }
}

fun emit_prefix_reg(buf: *enc.ByteBuf, size: u8, flags: u16, reg: i32, rm: i32) {
    if (size == 2 || (flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
    if (size == 1 && (needs_rex_for_byte_reg(reg) || needs_rex_for_byte_reg(rm))) {
        enc.emit_byte(buf, encode_rex(0, reg, rm));
    }
    or {
        emit_rex_if_needed(buf, size_to_w(size, flags), reg, rm);
    }
}

fun emit_prefix_mem(buf: *enc.ByteBuf, size: u8, flags: u16, reg: i32, mem: *isa.Operand) {
    if (size == 2 || (flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
    if (size == 1 && needs_rex_for_byte_reg(reg)) {
        emit_rex_byte_mem(buf, reg, mem);
    }
    or {
        emit_rex_mem(buf, size_to_w(size, flags), reg, mem);
    }
}

# the override prefix of a memory operand's segment; 0 when it names none.
# legacy prefixes lead the instruction, ahead of 66, f2/f3 and rex
fun segment_prefix(op: *isa.Operand) u8 {
    if (op.kind != isa.OPK_MEM || op.seg == x64.SEG_NONE) { ret 0; }
    val row: *x64.SegmentRow = x64.segment_row(op.seg);
    if (row == nil) { panic("encode: memory operand names an unassigned segment override\n"); }
    ret row.prefix;
}

fun inst_segment_prefix(mi: *isa.Inst) u8 {
    var p: u8 = segment_prefix(?mi.dst);
    if (p == 0) { p = segment_prefix(?mi.src1); }
    if (p == 0) { p = segment_prefix(?mi.src2); }
    if (p == 0) { p = segment_prefix(?mi.src3); }
    ret p;
}

fun imm_fits_width(imm: i64, size: u8) bool {
    if (size == 1) { ret imm >= -128 && imm <= 255; }
    if (size == 2) { ret imm >= -32768 && imm <= 65535; }
    if (size == 4) { ret imm >= -2147483648 && imm <= 4294967295; }
    ret true;
}

fun emit_imm_sized(buf: *enc.ByteBuf, imm: i64, size: u8) {
    if (size == 1) { enc.emit_byte(buf, imm::u8); }
    or (size == 2) { enc.emit_u16(buf, imm::u16); }
    or             { enc.emit_u32(buf, imm::u32); }
}

fun encode_alu_rr(buf: *enc.ByteBuf, opcode: u8, dst: i32, src: i32, size: u8, flags: u16) {
    emit_prefix_reg(buf, size, flags, src, dst);
    enc.emit_byte(buf, opcode);
    enc.emit_byte(buf, encode_modrm(3, reg_bits(src), reg_bits(dst)));
}

fun encode_alu_rm(buf: *enc.ByteBuf, opcode: u8, reg: i32, mem: *isa.Operand, size: u8, flags: u16) {
    emit_prefix_mem(buf, size, flags, reg, mem);
    enc.emit_byte(buf, opcode);
    encode_mem_operand(buf, reg, mem);
}

fun encode_alu_imm(buf: *enc.ByteBuf, opcode: u16, reg: i32, imm: i64, size: u8, flags: u16) {
    if (size == 8 && (imm < -2147483648 || imm > 2147483647)) {
        val reg_op:  isa.Operand = isa.make_reg(reg, size);
        val scratch: i32         = pick_stage_scratch(?reg_op, nil);
        if (scratch < 0) { ret; }
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa.make_reg(scratch, 8);
        ld.src1   = isa.make_imm(imm, 8);
        ld.size   = 8;
        encode_inst(?ld, buf);
        var rr: isa.Inst = isa.inst_blank();
        rr.opcode = opcode;
        rr.dst    = isa.make_reg(reg, 8);
        rr.src1   = isa.make_reg(scratch, 8);
        rr.size   = 8;
        rr.flags  = flags;
        encode_inst(?rr, buf);
        ret;
    }
    if (!imm_fits_width(imm, size)) { ret; }

    val group: u8 = alu_group(opcode);
    emit_prefix_reg(buf, size, flags, 0, reg);

    if (imm >= -128 && imm <= 127 && size > 1) {
        enc.emit_byte(buf, 0x83);
        enc.emit_byte(buf, encode_modrm(3, group, reg_bits(reg)));
        enc.emit_byte(buf, imm::u8);
    }
    or {
        var opc: u8 = 0x81;
        if (size == 1) { opc = 0x80; }
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, group, reg_bits(reg)));
        emit_imm_sized(buf, imm, size);
    }
}

fun alu_group(opcode: u16) u8 {
    if (opcode == x64.ADD) { ret 0; }
    if (opcode == x64.OR)  { ret 1; }
    if (opcode == x64.AND) { ret 4; }
    if (opcode == x64.SUB) { ret 5; }
    if (opcode == x64.SBB) { ret 3; }
    if (opcode == x64.XOR) { ret 6; }
    if (opcode == x64.CMP) { ret 7; }
    ret 0;
}

fun alu_opcode_rr(opcode: u16, size: u8) u8 {
    var base: u8 = 0;
    if (opcode == x64.ADD) { base = 0x01; }
    or (opcode == x64.OR)  { base = 0x09; }
    or (opcode == x64.AND) { base = 0x21; }
    or (opcode == x64.SUB) { base = 0x29; }
    or (opcode == x64.SBB) { base = 0x19; }
    or (opcode == x64.XOR) { base = 0x31; }
    or (opcode == x64.CMP) { base = 0x39; }
    or                     { base = 0x01; }
    if (size == 1)         { ret base - 1; }
    ret base;
}

fun cc_to_x86(opcode: u16) u8 {
    if (opcode == x64.JE || opcode == x64.SETE)   { ret 0x04; }
    if (opcode == x64.JNE || opcode == x64.SETNE) { ret 0x05; }
    if (opcode == x64.JL || opcode == x64.SETL)   { ret 0x0C; }
    if (opcode == x64.JLE || opcode == x64.SETLE) { ret 0x0E; }
    if (opcode == x64.JG || opcode == x64.SETG)   { ret 0x0F; }
    if (opcode == x64.JGE || opcode == x64.SETGE) { ret 0x0D; }
    if (opcode == x64.JB || opcode == x64.SETB)   { ret 0x02; }
    if (opcode == x64.JBE || opcode == x64.SETBE) { ret 0x06; }
    if (opcode == x64.JA || opcode == x64.SETA)   { ret 0x07; }
    if (opcode == x64.JAE || opcode == x64.SETAE) { ret 0x03; }
    if (opcode == x64.SETP)                       { ret 0x0A; }
    if (opcode == x64.SETNP)                      { ret 0x0B; }
    ret 0x04;
}

# the family predicates read the opcode's row; no reader depends on how the
# opcode numbers were assigned
fun is_jcc(opcode: u16) bool {
    ret x64.describe(opcode).form == x64.FORM_JCC;
}

fun is_setcc(opcode: u16) bool {
    ret x64.describe(opcode).form == x64.FORM_SETCC;
}

fun is_alu(opcode: u16) bool {
    ret x64.describe(opcode).form == x64.FORM_ALU;
}

fun is_sse_mov(opcode: u16) bool {
    ret x64.describe(opcode).form == x64.FORM_SSE_MOV;
}

fun is_sse_alu(opcode: u16) bool {
    ret x64.describe(opcode).form == x64.FORM_SSE_ALU;
}

fun is_cvt(opcode: u16) bool {
    ret x64.describe(opcode).form == x64.FORM_CVT;
}

fun reg_is_xmm(op: *isa.Operand) bool {
    ret op.kind == isa.OPK_REG && isa.regid_class(op.reg) == isa.REG_CLASS_ID_XMM;
}

fun encode_fp_mov(mi: *isa.Inst, buf: *enc.ByteBuf) res[i32, fail.Fail] {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;

    if (mi.size == 16) {
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            emit_movaps_rr(dst.reg, src1.reg, buf);
            ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
        }
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
            emit_movups_load(dst.reg, @src1, buf);
            ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
        }
        if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
            emit_movups_store(@dst, src1.reg, buf);
            ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
        }
        emit_movups_load(float_scratch0(), @src1, buf);
        emit_movups_store(@dst, float_scratch0(), buf);
        ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
    }

    val w: u8 = mi.size;
    if (!common.is_float_width(w)) {
        ret res[i32, fail.Fail].err{fail.message("internal compiler error: float move has a non-float operand width (expected 4, 8 or 16)")};
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG &&
        reg_is_xmm(dst) != reg_is_xmm(src1)) {
        if (reg_is_xmm(dst)) {
            emit_movd_movq_reg(src1.reg, dst.reg, w, true, buf);
        }
        or {
            emit_movd_movq_reg(dst.reg, src1.reg, w, false, buf);
        }
        ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
    }

    if (reg_is_xmm(dst)) {
        val ld: err[fail.Fail] = emit_float_reg_or_slot_load(@src1, dst.reg, w, buf);
        if (sel ld.err) { ret res[i32, fail.Fail].err{ld.err}; }
        ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
    }
    if (!reg_is_xmm(src1)) {
        ret res[i32, fail.Fail].err{fail.message("encode: a same-bank float move names no SSE register")};
    }
    val st: err[fail.Fail] = emit_float_store(@dst, src1.reg, w, buf);
    if (sel st.err) { ret res[i32, fail.Fail].err{st.err}; }
    ret res[i32, fail.Fail].ok{(buf.len - start)::i32};
}

fun encode_mov(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    val flags: u16          = mi.flags;

    if (reg_is_xmm(dst) || reg_is_xmm(src1) || size == 16) {
        val fp: res[i32, fail.Fail] = encode_fp_mov(mi, buf);
        if (sel fp.err) {
            panic(fail.describe(fp.err));
            ret 0;
        }
        ret fp.ok;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        if (size == 1) {
            enc.emit_byte(buf, 0x88);
        }
        or {
            enc.emit_byte(buf, 0x89);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        val w:   u8  = size_to_w(size, flags);
        val imm: i64 = src1.imm;
        if (size < 8 && !imm_fits_width(imm, size))          { ret 0; }
        if (size == 2 || (flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
        if (size == 1) {
            if (needs_rex_byte(dst.reg)) {
                enc.emit_byte(buf, encode_rex(0, 0, dst.reg));
            }
            enc.emit_byte(buf, 0xB0 + reg_bits(dst.reg));
            enc.emit_byte(buf, imm::u8);
        }
        or (size == 2) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
            enc.emit_u16(buf, imm::u16);
        }
        or (size == 4) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
            enc.emit_u32(buf, imm::u32);
        }
        or {
            if (imm >= -2147483648 && imm <= 2147483647) {
                emit_rex_if_needed(buf, w, 0, dst.reg);
                enc.emit_byte(buf, 0xC7);
                enc.emit_byte(buf, encode_modrm(3, 0, reg_bits(dst.reg)));
                enc.emit_u32(buf, imm::u32);
            }
            or {
                mi.opcode = x64.MOVABS;
                enc.emit_byte(buf, encode_rex(1, 0, dst.reg));
                enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
                enc.emit_u64(buf, imm::u64);
            }
        }
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, dst.reg, src1);
        if (size == 1) {
            enc.emit_byte(buf, 0x8A);
        }
        or {
            enc.emit_byte(buf, 0x8B);
        }
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        if (size == 1) {
            enc.emit_byte(buf, 0x88);
        }
        or {
            enc.emit_byte(buf, 0x89);
        }
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_MEM) {
        val scratch: i32 = pick_stage_scratch(dst, src1);
        if (scratch < 0) { ret 0; }
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = mi.opcode;
        ld.dst    = isa.make_reg(scratch, size);
        ld.src1   = mi.src1;
        ld.size   = size;
        ld.flags  = flags;
        val ld_sz: i32      = encode_inst(?ld, buf);
        var st:    isa.Inst = isa.inst_blank();
        st.opcode = mi.opcode;
        st.dst    = mi.dst;
        st.src1   = isa.make_reg(scratch, size);
        st.size   = size;
        st.flags  = flags;
        val st_sz: i32 = encode_inst(?st, buf);
        ret ld_sz + st_sz;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_IMM) {
        if (size == 8 && (src1.imm < -2147483648 || src1.imm > 2147483647)) {
            val scratch: i32 = pick_stage_scratch(dst, nil);
            if (scratch < 0) { ret 0; }
            var ld: isa.Inst = isa.inst_blank();
            ld.opcode = x64.MOVABS;
            ld.dst    = isa.make_reg(scratch, 8);
            ld.src1   = isa.make_imm(src1.imm, 8);
            ld.size   = 8;
            val ld_sz: i32      = encode_inst(?ld, buf);
            var st:    isa.Inst = isa.inst_blank();
            st.opcode = mi.opcode;
            st.dst    = mi.dst;
            st.src1   = isa.make_reg(scratch, 8);
            st.size   = 8;
            st.flags  = flags;
            val st_sz: i32 = encode_inst(?st, buf);
            ret ld_sz + st_sz;
        }
        if (!imm_fits_width(src1.imm, size)) { ret 0; }
        emit_prefix_mem(buf, size, flags, 0, dst);
        if (size == 1) {
            enc.emit_byte(buf, 0xC6);
        }
        or {
            enc.emit_byte(buf, 0xC7);
        }
        encode_mem_operand(buf, 0, dst);
        emit_imm_sized(buf, src1.imm, size);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_lea(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG) { ret 0; }

    if (src1.kind == isa.OPK_LABEL) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        enc.emit_byte(buf, encode_rex(w, dst.reg, 0));
        enc.emit_byte(buf, 0x8D);
        enc.emit_byte(buf, encode_modrm(0, reg_bits(dst.reg), 5));
        enc.emit_u32(buf, 0);
        ret (buf.len - start)::i32;
    }

    if (src1.kind != isa.OPK_MEM) { ret 0; }
    val w: u8 = size_to_w(mi.size, mi.flags);
    emit_rex_mem(buf, w, dst.reg, src1);
    enc.emit_byte(buf, 0x8D);
    encode_mem_operand(buf, dst.reg, src1);
    ret (buf.len - start)::i32;
}

fun encode_push(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val src:   *isa.Operand = ?mi.dst;
    if (src.kind == isa.OPK_REG) {
        if (needs_rex(src.reg)) {
            enc.emit_byte(buf, encode_rex(0, 0, src.reg));
        }
        enc.emit_byte(buf, 0x50 + reg_bits(src.reg));
    }
    or (src.kind == isa.OPK_IMM) {
        val imm: i64 = src.imm;
        if (imm >= -128 && imm <= 127) {
            enc.emit_byte(buf, 0x6A);
            enc.emit_byte(buf, imm::u8);
        }
        or (imm >= -2147483648 && imm <= 2147483647) {
            enc.emit_byte(buf, 0x68);
            enc.emit_u32(buf, imm::u32);
        }
        or {
            ret 0;
        }
    }
    ret (buf.len - start)::i32;
}

fun encode_pop(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    if (dst.kind != isa.OPK_REG) { ret 0; }
    if (needs_rex(dst.reg)) {
        enc.emit_byte(buf, encode_rex(0, 0, dst.reg));
    }
    enc.emit_byte(buf, 0x58 + reg_bits(dst.reg));
    ret (buf.len - start)::i32;
}

fun encode_alu(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:  usize        = buf.len;
    val dst:    *isa.Operand = ?mi.dst;
    val src1:   *isa.Operand = ?mi.src1;
    val size:   u8           = mi.size;
    val flags:  u16          = mi.flags;
    val opcode: u16          = mi.opcode;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        val opc: u8 = alu_opcode_rr(opcode, size);
        encode_alu_rr(buf, opc, dst.reg, src1.reg, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        encode_alu_imm(buf, opcode, dst.reg, src1.imm, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        val opc: u8 = alu_opcode_rr(opcode, size) + 2;
        encode_alu_rm(buf, opc, dst.reg, src1, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        val opc: u8 = alu_opcode_rr(opcode, size);
        encode_alu_rm(buf, opc, src1.reg, dst, size, flags);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_IMM) {
        val imm: i64 = src1.imm;
        if (size == 8 && (imm < -2147483648 || imm > 2147483647)) {
            val scratch: i32 = pick_stage_scratch(dst, nil);
            if (scratch < 0) { ret 0; }
            var ld: isa.Inst = isa.inst_blank();
            ld.opcode = x64.MOV;
            ld.dst    = isa.make_reg(scratch, 8);
            ld.src1   = isa.make_imm(imm, 8);
            ld.size   = 8;
            encode_inst(?ld, buf);
            var rm: isa.Inst = isa.inst_blank();
            rm.opcode = opcode;
            rm.dst    = mi.dst;
            rm.src1   = isa.make_reg(scratch, 8);
            rm.size   = 8;
            rm.flags  = flags;
            encode_inst(?rm, buf);
            ret (buf.len - start)::i32;
        }
        if (!imm_fits_width(imm, size)) { ret 0; }
        val grp: u8 = alu_group(opcode);
        val w:   u8 = size_to_w(size, flags);
        if ((flags & x64.FLAG_16BIT::u16) != 0) { enc.emit_byte(buf, 0x66); }
        emit_rex_mem(buf, w, grp::i32, dst);
        if (imm >= -128 && imm <= 127 && size > 1) {
            enc.emit_byte(buf, 0x83);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_byte(buf, imm::u8);
        }
        or (size == 1) {
            enc.emit_byte(buf, 0x80);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_byte(buf, imm::u8);
        }
        or (size == 2) {
            enc.emit_byte(buf, 0x81);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_u16(buf, imm::u16);
        }
        or {
            enc.emit_byte(buf, 0x81);
            encode_mem_operand(buf, grp::i32, dst);
            enc.emit_u32(buf, imm::u32);
        }
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun maybe_emit_lock(buf: *enc.ByteBuf, flags: u16) {
    if ((flags & x64.FLAG_LOCK::u16) != 0) { enc.emit_byte(buf, 0xF0); }
}

fun encode_unary_grp3(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:     usize        = buf.len;
    val dst:       *isa.Operand = ?mi.dst;
    val size:      u8           = mi.size;
    val flags:     u16          = mi.flags;
    var modrm_ext: u8           = 3;
    if (mi.opcode == x64.NOT) { modrm_ext = 2; }

    var opc: u8 = 0xF7;
    if (size == 1) { opc = 0xF6; }

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, 0, dst.reg);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, 0, dst);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, modrm_ext::i32, dst);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_unary_grp5(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:     usize        = buf.len;
    val dst:       *isa.Operand = ?mi.dst;
    val size:      u8           = mi.size;
    val flags:     u16          = mi.flags;
    var modrm_ext: u8           = 0;
    if (mi.opcode == x64.DEC) { modrm_ext = 1; }

    var opc: u8 = 0xFF;
    if (size == 1) { opc = 0xFE; }

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, 0, dst.reg);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, 0, dst);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, modrm_ext::i32, dst);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_xchg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    val flags: u16          = mi.flags;
    var opc:   u8           = 0x87;
    if (size == 1) { opc = 0x86; }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, dst.reg, src1);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_xadd_cmpxchg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    val flags: u16          = mi.flags;
    if (src1.kind != isa.OPK_REG) { ret 0; }

    var opc2: u8 = 0xC1;
    if (mi.opcode == x64.CMPXCHG) { opc2 = 0xB1; }
    if (size == 1)                { opc2 = opc2 - 1; }

    maybe_emit_lock(buf, flags);

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc2);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc2);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_test(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    val flags: u16          = mi.flags;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, src1.reg, dst.reg);
        if (size == 1) {
            enc.emit_byte(buf, 0x84);
        }
        or {
            enc.emit_byte(buf, 0x85);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        if (size == 8) {
            if (src1.imm < -2147483648 || src1.imm > 2147483647) { ret 0; }
        }
        or (!imm_fits_width(src1.imm, size)) { ret 0; }
        emit_prefix_reg(buf, size, flags, 0, dst.reg);
        var opc: u8 = 0xF7;
        if (size == 1) { opc = 0xF6; }
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, 0, reg_bits(dst.reg)));
        emit_imm_sized(buf, src1.imm, size);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_IMM) {
        if (size == 8) {
            if (src1.imm < -2147483648 || src1.imm > 2147483647) { ret 0; }
        }
        or (!imm_fits_width(src1.imm, size)) { ret 0; }
        emit_prefix_mem(buf, size, flags, 0, dst);
        var opc: u8 = 0xF7;
        if (size == 1) { opc = 0xF6; }
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, 0, dst);
        emit_imm_sized(buf, src1.imm, size);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_prefix_mem(buf, size, flags, src1.reg, dst);
        if (size == 1) {
            enc.emit_byte(buf, 0x84);
        }
        or {
            enc.emit_byte(buf, 0x85);
        }
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_imul(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    val flags: u16          = mi.flags;

    # the one-operand form: src r/m by rax into rdx:rax
    if (dst.kind == isa.OPK_NONE && src1.kind != isa.OPK_NONE) {
        ret encode_rm_one(mi, buf, 5);
    }

    # the three-operand form: dst = src1 * imm, with src1 an r/m
    if (dst.kind == isa.OPK_REG && src1.kind != isa.OPK_NONE && mi.src2.kind == isa.OPK_IMM) {
        val imm: i64 = mi.src2.imm;
        if (size < 2 || !imm_fits_width(imm, size))               { ret 0; }
        if (size == 8 && (imm < -2147483648 || imm > 2147483647)) { ret 0; }
        var opbyte: u8 = 0x69;
        if (imm >= -128 && imm <= 127) { opbyte = 0x6B; }
        if (src1.kind == isa.OPK_REG) {
            emit_prefix_reg(buf, size, flags, dst.reg, src1.reg);
            enc.emit_byte(buf, opbyte);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        or (src1.kind == isa.OPK_MEM) {
            val seg: u8 = segment_prefix(src1);
            if (seg != 0) { enc.emit_byte(buf, seg); }
            emit_prefix_mem(buf, size, flags, dst.reg, src1);
            enc.emit_byte(buf, opbyte);
            encode_mem_operand(buf, dst.reg, src1);
        }
        or                  { ret 0; }
        if (opbyte == 0x6B) { enc.emit_byte(buf, imm::u8); }
        or                  { emit_imm_sized(buf, imm, size); }
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xAF);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xAF);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_IMM) {
        val imm: i64 = src1.imm;
        if (size < 2) { ret 0; }
        if (size == 8 && (imm < -2147483648 || imm > 2147483647)) {
            val scratch: i32 = pick_stage_scratch(dst, nil);
            if (scratch < 0) { ret 0; }
            var ld: isa.Inst = isa.inst_blank();
            ld.opcode = x64.MOV;
            ld.dst    = isa.make_reg(scratch, 8);
            ld.src1   = isa.make_imm(imm, 8);
            ld.size   = 8;
            encode_inst(?ld, buf);
            var rr: isa.Inst = isa.inst_blank();
            rr.opcode = x64.IMUL;
            rr.dst    = isa.make_reg(dst.reg, size);
            rr.src1   = isa.make_reg(scratch, size);
            rr.size   = size;
            rr.flags  = flags;
            encode_inst(?rr, buf);
            ret (buf.len - start)::i32;
        }
        if (!imm_fits_width(imm, size)) { ret 0; }
        emit_prefix_reg(buf, size, flags, dst.reg, dst.reg);
        if (imm >= -128 && imm <= 127) {
            enc.emit_byte(buf, 0x6B);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(dst.reg)));
            enc.emit_byte(buf, imm::u8);
        }
        or {
            enc.emit_byte(buf, 0x69);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(dst.reg)));
            emit_imm_sized(buf, imm, size);
        }
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_div(mi: *isa.Inst, buf: *enc.ByteBuf, is_signed: bool) i32 {
    var modrm_ext: u8 = 6;
    if (is_signed) { modrm_ext = 7; }
    ret encode_rm_one(mi, buf, modrm_ext);
}

fun encode_mul1(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    ret encode_rm_one(mi, buf, 4);
}

# the group-3 one-operand family (mul imul div idiv): F6 or F7 with the
# member in the modrm reg field and the r/m operand in src1
fun encode_rm_one(mi: *isa.Inst, buf: *enc.ByteBuf, modrm_ext: u8) i32 {
    val start: usize        = buf.len;
    val src:   *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    val flags: u16          = mi.flags;

    if (src.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, size, flags, 0, src.reg);
        if (size == 1) {
            enc.emit_byte(buf, 0xF6);
        }
        or {
            enc.emit_byte(buf, 0xF7);
        }
        enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(src.reg)));
        ret (buf.len - start)::i32;
    }

    if (src.kind == isa.OPK_MEM) {
        emit_prefix_mem(buf, size, flags, 0, src);
        if (size == 1) {
            enc.emit_byte(buf, 0xF6);
        }
        or {
            enc.emit_byte(buf, 0xF7);
        }
        encode_mem_operand(buf, modrm_ext::i32, src);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_shift(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:     usize        = buf.len;
    val dst:       *isa.Operand = ?mi.dst;
    val src1:      *isa.Operand = ?mi.src1;
    val size:      u8           = mi.size;
    val flags:     u16          = mi.flags;
    val opcode:    u16          = mi.opcode;
    var modrm_ext: u8           = 4;
    if (opcode == x64.SHR) { modrm_ext = 5; }
    if (opcode == x64.SAR) { modrm_ext = 7; }

    if (dst.kind != isa.OPK_REG && dst.kind != isa.OPK_MEM) { ret 0; }
    val dst_is_mem: bool = dst.kind == isa.OPK_MEM;

    if (src1.kind == isa.OPK_REG) {
        if (dst_is_mem) { emit_prefix_mem(buf, size, flags, 0, dst); }
        or              { emit_prefix_reg(buf, size, flags, 0, dst.reg); }
        if (size == 1) {
            enc.emit_byte(buf, 0xD2);
        }
        or {
            enc.emit_byte(buf, 0xD3);
        }
        if (dst_is_mem) { encode_mem_operand(buf, modrm_ext::i32, dst); }
        or              { enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg))); }
    }
    or (src1.kind == isa.OPK_IMM) {
        val imm: i64 = src1.imm;
        if (!imm_fits_width(imm, 1)) { ret 0; }
        if (dst_is_mem)              { emit_prefix_mem(buf, size, flags, 0, dst); }
        or                           { emit_prefix_reg(buf, size, flags, 0, dst.reg); }
        if (imm == 1) {
            if (size == 1) {
                enc.emit_byte(buf, 0xD0);
            }
            or {
                enc.emit_byte(buf, 0xD1);
            }
            if (dst_is_mem) { encode_mem_operand(buf, modrm_ext::i32, dst); }
            or              { enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg))); }
        }
        or {
            if (size == 1) {
                enc.emit_byte(buf, 0xC0);
            }
            or {
                enc.emit_byte(buf, 0xC1);
            }
            if (dst_is_mem) { encode_mem_operand(buf, modrm_ext::i32, dst); }
            or              { enc.emit_byte(buf, encode_modrm(3, modrm_ext, reg_bits(dst.reg))); }
            enc.emit_byte(buf, imm::u8);
        }
    }
    or {
        ret 0;
    }

    ret (buf.len - start)::i32;
}

fun encode_cdq_cqo(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    if (mi.opcode == x64.CQO) {
        enc.emit_byte(buf, 0x48);
        enc.emit_byte(buf, 0x99);
    }
    or {
        enc.emit_byte(buf, 0x99);
    }
    ret (buf.len - start)::i32;
}

fun encode_jcc(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize = buf.len;
    val cc:    u8    = cc_to_x86(mi.opcode);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x80 + cc);
    enc.emit_u32(buf, 0);
    ret (buf.len - start)::i32;
}

fun encode_jmp(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;

    if ((mi.flags & x64.FLAG_INDIRECT::u16) != 0) {
        if (dst.kind == isa.OPK_REG) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xFF);
            enc.emit_byte(buf, encode_modrm(3, 4, reg_bits(dst.reg)));
        }
        or (dst.kind == isa.OPK_MEM) {
            emit_rex_mem(buf, 0, 4, dst);
            enc.emit_byte(buf, 0xFF);
            encode_mem_operand(buf, 4, dst);
        }
        ret (buf.len - start)::i32;
    }

    enc.emit_byte(buf, 0xE9);
    enc.emit_u32(buf, 0);
    ret (buf.len - start)::i32;
}

fun encode_call(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;

    if ((mi.flags & x64.FLAG_INDIRECT::u16) != 0) {
        if (dst.kind == isa.OPK_REG) {
            emit_rex_if_needed(buf, 0, 0, dst.reg);
            enc.emit_byte(buf, 0xFF);
            enc.emit_byte(buf, encode_modrm(3, 2, reg_bits(dst.reg)));
        }
        or (dst.kind == isa.OPK_MEM) {
            emit_rex_mem(buf, 0, 2, dst);
            enc.emit_byte(buf, 0xFF);
            encode_mem_operand(buf, 2, dst);
        }
        ret (buf.len - start)::i32;
    }

    enc.emit_byte(buf, 0xE8);
    enc.emit_u32(buf, 0);
    ret (buf.len - start)::i32;
}

fun encode_portio(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val is_in: bool         = mi.opcode == x64.IN;
    var port:  *isa.Operand = ?mi.dst;
    var acc:   *isa.Operand = ?mi.src1;
    if (is_in) {
        port = ?mi.src1;
        acc  = ?mi.dst;
    }

    val w: u8 = acc.size;
    if (w != 1 && w != 2 && w != 4) { ret 0; }

    val imm_port: bool = port.kind == isa.OPK_IMM;
    if (!imm_port && port.kind != isa.OPK_REG)        { ret 0; }
    if (imm_port && (port.imm < 0 || port.imm > 255)) { ret 0; }

    var op: u8 = 0xEC;
    if (imm_port) { op = 0xE4; }
    if (!is_in)   { op = op + 2; }
    if (w != 1)   { op = op + 1; }

    val start: usize = buf.len;
    if (w == 2) { enc.emit_byte(buf, 0x66); }
    enc.emit_byte(buf, op);
    if (imm_port) { enc.emit_byte(buf, (port.imm & 0xFF)::u8); }
    ret (buf.len - start)::i32;
}

fun encode_ret(buf: *enc.ByteBuf) i32 {
    enc.emit_byte(buf, 0xC3);
    ret 1;
}

fun encode_setcc(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val cc:    u8           = cc_to_x86(mi.opcode);

    if (dst.kind == isa.OPK_REG) {
        emit_prefix_reg(buf, 1, 0, 0, dst.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x90 + cc);
        enc.emit_byte(buf, encode_modrm(3, 0, reg_bits(dst.reg)));
    }
    ret (buf.len - start)::i32;
}

fun encode_xorps(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        if (needs_rex(dst.reg) || needs_rex(src1.reg)) {
            enc.emit_byte(buf, encode_rex(0, dst.reg, src1.reg));
        }
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x57);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }
    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x57);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

fun encode_movq(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG || src1.kind != isa.OPK_REG) { ret 0; }

    var w: u8 = 0;
    if (mi.size == 8) { w = 1; }
    if (dst.size == 16) {
        enc.emit_byte(buf, 0x66);
        enc.emit_byte(buf, encode_rex(w, dst.reg, src1.reg));
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x6E);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }
    enc.emit_byte(buf, 0x66);
    enc.emit_byte(buf, encode_rex(w, src1.reg, dst.reg));
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0x7E);
    enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
    ret (buf.len - start)::i32;
}

fun encode_movzx(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:    usize        = buf.len;
    val dst:      *isa.Operand = ?mi.dst;
    val src1:     *isa.Operand = ?mi.src1;
    val src_size: u8           = src1.size;
    val w:        u8           = size_to_w(mi.size, mi.flags);

    if (src_size >= 4) {
        mi.opcode = x64.MOV;
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x8B);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
            ret (buf.len - start)::i32;
        }
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
            emit_rex_mem(buf, 0, dst.reg, src1);
            enc.emit_byte(buf, 0x8B);
            encode_mem_operand(buf, dst.reg, src1);
            ret (buf.len - start)::i32;
        }
        ret 0;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        if (src_size == 1 && needs_rex_for_byte_reg(src1.reg)) {
            enc.emit_byte(buf, encode_rex(w, dst.reg, src1.reg));
        }
        or {
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
        }
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xB6);
        }
        or {
            enc.emit_byte(buf, 0xB7);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, w, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xB6);
        }
        or {
            enc.emit_byte(buf, 0xB7);
        }
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_movsx(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:    usize        = buf.len;
    val dst:      *isa.Operand = ?mi.dst;
    val src1:     *isa.Operand = ?mi.src1;
    val src_size: u8           = src1.size;
    if (src_size == 4) {
        mi.opcode = x64.MOVSXD;
        ret encode_movsxd(mi, buf);
    }
    val w: u8 = size_to_w(mi.size, mi.flags);

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        if (src_size == 1 && needs_rex_for_byte_reg(src1.reg)) {
            enc.emit_byte(buf, encode_rex(w, dst.reg, src1.reg));
        }
        or {
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
        }
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xBE);
        }
        or {
            enc.emit_byte(buf, 0xBF);
        }
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, w, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        if (src_size == 1) {
            enc.emit_byte(buf, 0xBE);
        }
        or {
            enc.emit_byte(buf, 0xBF);
        }
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_mov_ctlreg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;

    var gp: *isa.Operand = dst;
    var cr: *isa.Operand = src1;
    var op: u8           = 0x20;
    if (dst.kind == isa.OPK_IMM) {
        gp = src1;
        cr = dst;
        op = 0x22;
    }
    if (gp.kind != isa.OPK_REG || cr.kind != isa.OPK_IMM) { ret 0; }

    var rex: u8 = 0x40;
    if (cr.imm >= 8)       { rex = rex | 0x04; }
    if (needs_rex(gp.reg)) { rex = rex | 0x01; }
    if (rex != 0x40)       { enc.emit_byte(buf, rex); }

    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, op);
    enc.emit_byte(buf, encode_modrm(3, (cr.imm & 7)::u8, reg_bits(gp.reg)));
    ret (buf.len - start)::i32;
}

fun encode_mov_segreg(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG || src1.kind != isa.OPK_IMM) { ret 0; }

    if (mi.size == 2) { enc.emit_byte(buf, 0x66); }
    emit_rex_if_needed(buf, 0, src1.imm::i32, dst.reg);

    enc.emit_byte(buf, 0x8C);
    enc.emit_byte(buf, encode_modrm(3, (src1.imm & 7)::u8, reg_bits(dst.reg)));
    ret (buf.len - start)::i32;
}

# f3 0f ae /digit with rex.w for a 64-bit register
fun fsgsbase_digit(opcode: u16) u8 {
    if (opcode == x64.RDFSBASE) { ret 0; }
    if (opcode == x64.RDGSBASE) { ret 1; }
    if (opcode == x64.WRFSBASE) { ret 2; }
    ret 3;
}

fun encode_fsgsbase(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    if (dst.kind != isa.OPK_REG || isa.regid_class(dst.reg) != isa.REG_CLASS_ID_GP) { ret 0; }
    if (mi.size != 4 && mi.size != 8)                                               { ret 0; }

    enc.emit_byte(buf, 0xF3);
    emit_rex_if_needed(buf, size_to_w(mi.size, mi.flags), 0, dst.reg);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0xAE);
    enc.emit_byte(buf, encode_modrm(3, fsgsbase_digit(mi.opcode), reg_bits(dst.reg)));
    ret (buf.len - start)::i32;
}

# the 0f opcode byte of a bit scan or count; the counts carry an f3 prefix
fun bitscan_opbyte(opcode: u16) u8 {
    if (opcode == x64.POPCNT)                     { ret 0xB8; }
    if (opcode == x64.BSF || opcode == x64.TZCNT) { ret 0xBC; }
    ret 0xBD;
}

fun bitscan_prefixed(opcode: u16) bool {
    ret opcode == x64.POPCNT || opcode == x64.LZCNT || opcode == x64.TZCNT;
}

# [66] [f3] rex 0f xx /r: a 16-, 32- or 64-bit register from an r/m of the same width
fun encode_bitscan(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val size:  u8           = mi.size;
    if (dst.kind != isa.OPK_REG || isa.regid_class(dst.reg) != isa.REG_CLASS_ID_GP) { ret 0; }
    if (size != 2 && size != 4 && size != 8)                                        { ret 0; }
    val w: u8 = size_to_w(size, mi.flags);

    if (src1.kind == isa.OPK_REG) {
        if (isa.regid_class(src1.reg) != isa.REG_CLASS_ID_GP) { ret 0; }
        if (size == 2)                                        { enc.emit_byte(buf, 0x66); }
        if (bitscan_prefixed(mi.opcode))                      { enc.emit_byte(buf, 0xF3); }
        emit_rex_if_needed(buf, w, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, bitscan_opbyte(mi.opcode));
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }
    if (src1.kind == isa.OPK_MEM) {
        val seg: u8 = segment_prefix(src1);
        if (seg != 0)                    { enc.emit_byte(buf, seg); }
        if (size == 2)                   { enc.emit_byte(buf, 0x66); }
        if (bitscan_prefixed(mi.opcode)) { enc.emit_byte(buf, 0xF3); }
        emit_rex_mem(buf, w, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, bitscan_opbyte(mi.opcode));
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }
    ret 0;
}

# rex 0f c8+rd: one 32- or 64-bit register reversed in place
fun encode_bswap(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    if (dst.kind != isa.OPK_REG || isa.regid_class(dst.reg) != isa.REG_CLASS_ID_GP) { ret 0; }
    if (mi.size != 4 && mi.size != 8)                                               { ret 0; }
    emit_rex_if_needed(buf, size_to_w(mi.size, mi.flags), 0, dst.reg);
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, 0xC8 + reg_bits(dst.reg));
    ret (buf.len - start)::i32;
}

# [66] rex 0f a4|a5|ac|ad /r [ib]: the r/m in dst, the register feeding bits
# in src1, and the count in src2 as an imm8 or cl
fun encode_dshift(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    val cnt:   *isa.Operand = ?mi.src2;
    val size:  u8           = mi.size;
    if (src1.kind != isa.OPK_REG || isa.regid_class(src1.reg) != isa.REG_CLASS_ID_GP) { ret 0; }
    if (size != 2 && size != 4 && size != 8)                                          { ret 0; }
    var by_cl: bool = false;
    if (cnt.kind == isa.OPK_REG) {
        if (cnt.reg != x64.RCX::i32) { ret 0; }
        by_cl = true;
    }
    or (cnt.kind == isa.OPK_IMM) {
        if (cnt.imm < 0 || cnt.imm > 255) { ret 0; }
    }
    or { ret 0; }
    var opbyte: u8 = 0xA4;
    if (mi.opcode == x64.SHRD) { opbyte = 0xAC; }
    if (by_cl)                 { opbyte = opbyte + 1; }

    if (dst.kind == isa.OPK_REG) {
        if (isa.regid_class(dst.reg) != isa.REG_CLASS_ID_GP) { ret 0; }
        emit_prefix_reg(buf, size, mi.flags, src1.reg, dst.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opbyte);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(src1.reg), reg_bits(dst.reg)));
    }
    or (dst.kind == isa.OPK_MEM) {
        val seg: u8 = segment_prefix(dst);
        if (seg != 0) { enc.emit_byte(buf, seg); }
        emit_prefix_mem(buf, size, mi.flags, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opbyte);
        encode_mem_operand(buf, src1.reg, dst);
    }
    or          { ret 0; }
    if (!by_cl) { enc.emit_byte(buf, cnt.imm::u8); }
    ret (buf.len - start)::i32;
}

fun encode_movsxd(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, encode_rex(1, dst.reg, src1.reg));
        enc.emit_byte(buf, 0x63);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 1, dst.reg, src1);
        enc.emit_byte(buf, 0x63);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_movabs(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;
    if (dst.kind != isa.OPK_REG) { ret 0; }
    enc.emit_byte(buf, encode_rex(1, 0, dst.reg));
    enc.emit_byte(buf, 0xB8 + reg_bits(dst.reg));
    if (src1.kind == isa.OPK_IMM) {
        enc.emit_u64(buf, src1.imm::u64);
    }
    or (src1.kind == isa.OPK_SYM || src1.kind == isa.OPK_LABEL) {
        enc.emit_u64(buf, 0);
    }
    or {
        enc.emit_u64(buf, 0);
    }
    ret (buf.len - start)::i32;
}

fun encode_sse_mov(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:  usize        = buf.len;
    val dst:    *isa.Operand = ?mi.dst;
    val src1:   *isa.Operand = ?mi.src1;
    val opcode: u16          = mi.opcode;

    var prefix: u8 = 0xF3;
    if (opcode == x64.MOVSD) { prefix = 0xF2; }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, prefix);
        emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x10);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        enc.emit_byte(buf, prefix);
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x10);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, prefix);
        emit_rex_mem(buf, 0, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x11);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_movaps(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x28);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_MEM && src1.kind == isa.OPK_REG) {
        emit_rex_mem(buf, 0, src1.reg, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x29);
        encode_mem_operand(buf, src1.reg, dst);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun sse_alu_opcode(opcode: u16) u8 {
    if (opcode == x64.ADDSS || opcode == x64.ADDSD) { ret 0x58; }
    if (opcode == x64.SUBSS || opcode == x64.SUBSD) { ret 0x5C; }
    if (opcode == x64.MULSS || opcode == x64.MULSD) { ret 0x59; }
    if (opcode == x64.DIVSS || opcode == x64.DIVSD) { ret 0x5E; }
    ret 0x58;
}

fun sse_alu_prefix(opcode: u16) u8 {
    if (opcode == x64.ADDSD || opcode == x64.SUBSD || opcode == x64.MULSD || opcode == x64.DIVSD) {
        ret 0xF2;
    }
    ret 0xF3;
}

fun encode_sse_alu(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:  usize        = buf.len;
    val dst:    *isa.Operand = ?mi.dst;
    val src1:   *isa.Operand = ?mi.src1;
    val prefix: u8           = sse_alu_prefix(mi.opcode);
    val opc:    u8           = sse_alu_opcode(mi.opcode);

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        enc.emit_byte(buf, prefix);
        emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        enc.emit_byte(buf, prefix);
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, opc);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_ucomiss(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start: usize        = buf.len;
    val dst:   *isa.Operand = ?mi.dst;
    val src1:  *isa.Operand = ?mi.src1;

    if (mi.opcode == x64.UCOMISD) {
        enc.emit_byte(buf, 0x66);
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
        emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x2E);
        enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        ret (buf.len - start)::i32;
    }

    if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_MEM) {
        emit_rex_mem(buf, 0, dst.reg, src1);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x2E);
        encode_mem_operand(buf, dst.reg, src1);
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_cvt(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val start:  usize        = buf.len;
    val dst:    *isa.Operand = ?mi.dst;
    val src1:   *isa.Operand = ?mi.src1;
    val opcode: u16          = mi.opcode;

    if (opcode == x64.CVTSI2SS) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF3);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTSI2SD) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF2);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTTSS2SI) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF3);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2C);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTTSD2SI) {
        val w: u8 = size_to_w(mi.size, mi.flags);
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF2);
            emit_rex_if_needed(buf, w, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x2C);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTSS2SD) {
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF3);
            emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x5A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    if (opcode == x64.CVTSD2SS) {
        if (dst.kind == isa.OPK_REG && src1.kind == isa.OPK_REG) {
            enc.emit_byte(buf, 0xF2);
            emit_rex_if_needed(buf, 0, dst.reg, src1.reg);
            enc.emit_byte(buf, 0x0F);
            enc.emit_byte(buf, 0x5A);
            enc.emit_byte(buf, encode_modrm(3, reg_bits(dst.reg), reg_bits(src1.reg)));
        }
        ret (buf.len - start)::i32;
    }

    ret 0;
}

fun encode_inst(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    if (mi == nil || buf == nil) { ret 0; }
    val opcode: u16 = mi.opcode;

    if (opcode == isa.ISA_PCOPY || opcode == isa.ISA_PCOPY_FENCE) { ret 0; }

    # a memory source beside a memory destination is staged through a
    # scratch register where the row admits one r/m operand: a shift's
    # count and a swap's second operand are never staged
    val desc: x64.OpDesc = x64.describe(opcode);
    if (mi.src1.kind == isa.OPK_MEM && mi.dst.kind == isa.OPK_MEM &&
        (desc.mem & x64.MEM_OPERAND) != 0 &&
        desc.form != x64.FORM_SHIFT && desc.shape != x64.SHAPE_SWAP) {
        var scratch: i32 = float_scratch0();
        if (mi.size != 16) {
            scratch = pick_stage_scratch(?mi.dst, ?mi.src1);
            if (scratch < 0) { ret 0; }
        }
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa.make_reg(scratch, mi.size);
        ld.src1   = mi.src1;
        ld.size   = mi.size;
        ld.flags  = mi.flags;
        val ld_sz: i32 = encode_inst(?ld, buf);
        if (ld_sz <= 0) { ret 0; }
        mi.src1 = isa.make_reg(scratch, mi.size);
        val rest: i32 = encode_inst(mi, buf);
        if (rest <= 0) { ret 0; }
        ret ld_sz + rest;
    }

    val start: usize = buf.len;
    val seg:   u8    = inst_segment_prefix(mi);
    var lead:  i32   = 0;
    if (seg != 0) {
        # an address operand is never accessed, so an override on it relocates nothing
        if ((desc.mem & x64.MEM_ADDR) != 0) { ret 0; }
        enc.emit_byte(buf, seg);
        lead = 1;
    }
    val n: i32 = encode_inst_one(mi, buf);
    if (n <= 0) {
        # an encoder refuses before its first byte, so only the prefix is withdrawn
        buf.len = start;
        ret n;
    }
    if (enc.sink_unaccounted(buf) > 0) { printer.note_inst(buf, mi, start); }
    ret lead + n;
}

fun has_mem_operand(mi: *isa.Inst) bool {
    ret mi.dst.kind == isa.OPK_MEM || mi.src1.kind == isa.OPK_MEM ||
        mi.src2.kind == isa.OPK_MEM || mi.src3.kind == isa.OPK_MEM;
}

fun encode_inst_one(mi: *isa.Inst, buf: *enc.ByteBuf) i32 {
    val opcode: u16 = mi.opcode;

    # an opcode without a row, or a memory operand on a row that reaches
    # memory only implicitly or not at all, is refused before any byte
    val desc: x64.OpDesc = x64.describe(opcode);
    if (desc.form == x64.FORM_NONE)                                                { ret 0; }
    if (has_mem_operand(mi) && (desc.mem & (x64.MEM_OPERAND | x64.MEM_ADDR)) == 0) { ret 0; }

    if (opcode == x64.NOP) {
        enc.emit_byte(buf, 0x90);
        ret 1;
    }

    if (opcode == x64.MOV) {
        ret encode_mov(mi, buf);
    }

    if (opcode == x64.LEA) {
        ret encode_lea(mi, buf);
    }

    if (opcode == x64.PUSH) {
        ret encode_push(mi, buf);
    }

    if (opcode == x64.POP) {
        ret encode_pop(mi, buf);
    }

    if (is_alu(opcode)) {
        ret encode_alu(mi, buf);
    }

    if (opcode == x64.TEST) {
        ret encode_test(mi, buf);
    }

    if (opcode == x64.IMUL) {
        ret encode_imul(mi, buf);
    }

    if (opcode == x64.IDIV) {
        ret encode_div(mi, buf, true);
    }

    if (opcode == x64.DIV) {
        ret encode_div(mi, buf, false);
    }

    if (opcode == x64.MUL) {
        ret encode_mul1(mi, buf);
    }

    if (opcode == x64.SHL || opcode == x64.SHR || opcode == x64.SAR) {
        ret encode_shift(mi, buf);
    }

    if (opcode == x64.CDQ || opcode == x64.CQO) {
        ret encode_cdq_cqo(mi, buf);
    }

    if (is_jcc(opcode)) {
        ret encode_jcc(mi, buf);
    }

    if (opcode == x64.JMP) {
        ret encode_jmp(mi, buf);
    }

    if (opcode == x64.CALL) {
        ret encode_call(mi, buf);
    }

    if (opcode == x64.RET) {
        ret encode_ret(buf);
    }

    if (is_setcc(opcode)) {
        ret encode_setcc(mi, buf);
    }

    if (opcode == x64.MOVZX) {
        ret encode_movzx(mi, buf);
    }

    if (opcode == x64.MOVSX) {
        ret encode_movsx(mi, buf);
    }

    if (opcode == x64.MOVQ) {
        ret encode_movq(mi, buf);
    }

    if (opcode == x64.XORPS) {
        ret encode_xorps(mi, buf);
    }

    if (opcode == x64.MOVSXD) {
        ret encode_movsxd(mi, buf);
    }

    if (opcode == x64.MOVABS) {
        ret encode_movabs(mi, buf);
    }

    if (is_sse_mov(opcode)) {
        ret encode_sse_mov(mi, buf);
    }

    if (opcode == x64.MOVAPS) {
        ret encode_movaps(mi, buf);
    }

    if (is_sse_alu(opcode)) {
        ret encode_sse_alu(mi, buf);
    }

    if (opcode == x64.UCOMISS || opcode == x64.UCOMISD) {
        ret encode_ucomiss(mi, buf);
    }

    if (is_cvt(opcode)) {
        ret encode_cvt(mi, buf);
    }

    if (opcode == x64.SYSCALL) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x05);
        ret 2;
    }

    if (opcode == x64.UD2) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x0B);
        ret 2;
    }

    if (opcode == x64.PAUSE) {
        enc.emit_byte(buf, 0xF3);
        enc.emit_byte(buf, 0x90);
        ret 2;
    }

    if (opcode == x64.MFENCE) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xAE);
        enc.emit_byte(buf, 0xF0);
        ret 3;
    }

    if (opcode == x64.HLT) {
        enc.emit_byte(buf, 0xF4);
        ret 1;
    }

    if (opcode == x64.CLI) {
        enc.emit_byte(buf, 0xFA);
        ret 1;
    }
    if (opcode == x64.STI) {
        enc.emit_byte(buf, 0xFB);
        ret 1;
    }
    if (opcode == x64.RDTSC) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x31);
        ret 2;
    }
    if (opcode == x64.CPUID) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0xA2);
        ret 2;
    }
    if (opcode == x64.RDMSR) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x32);
        ret 2;
    }
    if (opcode == x64.WRMSR) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x30);
        ret 2;
    }

    if (opcode == x64.CLD) {
        enc.emit_byte(buf, 0xFC);
        ret 1;
    }
    if (opcode == x64.PUSHFQ) {
        enc.emit_byte(buf, 0x9C);
        ret 1;
    }
    if (opcode == x64.POPFQ) {
        enc.emit_byte(buf, 0x9D);
        ret 1;
    }
    if (opcode == x64.IRETQ) {
        enc.emit_byte(buf, 0x48);
        enc.emit_byte(buf, 0xCF);
        ret 2;
    }
    if (opcode == x64.SWAPGS) {
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x01);
        enc.emit_byte(buf, 0xF8);
        ret 3;
    }

    if (opcode == x64.MOV_CR)           { ret encode_mov_ctlreg(mi, buf); }
    if (opcode == x64.MOV_SEG)          { ret encode_mov_segreg(mi, buf); }
    if (desc.form == x64.FORM_FSGSBASE) { ret encode_fsgsbase(mi, buf); }
    if (desc.form == x64.FORM_BITSCAN)  { ret encode_bitscan(mi, buf); }
    if (desc.form == x64.FORM_BSWAP)    { ret encode_bswap(mi, buf); }
    if (desc.form == x64.FORM_DSHIFT)   { ret encode_dshift(mi, buf); }
    if (desc.form == x64.FORM_CARRY)    { ret encode_alu(mi, buf); }

    if (opcode == x64.LIDT) {
        val dst: *isa.Operand = ?mi.dst;
        if (dst.kind != isa.OPK_MEM) { ret 0; }
        val lidt_start: usize = buf.len;
        emit_rex_mem(buf, 0, 3, dst);
        enc.emit_byte(buf, 0x0F);
        enc.emit_byte(buf, 0x01);
        encode_mem_operand(buf, 3, dst);
        ret (buf.len - lidt_start)::i32;
    }

    if (opcode == x64.IN || opcode == x64.OUT) {
        ret encode_portio(mi, buf);
    }

    if (opcode == x64.NEG || opcode == x64.NOT) {
        ret encode_unary_grp3(mi, buf);
    }

    if (opcode == x64.INC || opcode == x64.DEC) {
        ret encode_unary_grp5(mi, buf);
    }

    if (opcode == x64.XCHG) {
        ret encode_xchg(mi, buf);
    }

    if (opcode == x64.XADD || opcode == x64.CMPXCHG) {
        ret encode_xadd_cmpxchg(mi, buf);
    }

    if (opcode == x64.RAW_BYTE) {
        enc.emit_byte(buf, mi.dst.imm::u8);
        ret 1;
    }

    if (opcode == x64.CBW) {
        enc.emit_byte(buf, 0x66);
        enc.emit_byte(buf, 0x98);
        ret 2;
    }

    if (opcode == x64.CWD) {
        enc.emit_byte(buf, 0x66);
        enc.emit_byte(buf, 0x99);
        ret 2;
    }

    if (opcode == x64.MOVSB) {
        var count: i32 = 0;
        if ((mi.flags & x64.FLAG_REP::u16) != 0) {
            enc.emit_byte(buf, 0xF3);
            count = count + 1;
        }
        enc.emit_byte(buf, 0xA4);
        count = count + 1;
        ret count;
    }

    ret 0;
}

fun count_callee_saved(fill: isa.RegFileFn, mask: u32) i32 {
    var list: [16]i32;
    val ln:   i32 = x64.callee_saved_gp_list_from(fill, ?list[0]);
    var n:    i32 = 0;
    var i:    i32 = 0;
    for (i < ln) {
        if ((mask & (1::u32 << list[i]::u32)) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun slot_base_reg(f: *mir.MirFunction) i32 {
    if (codegen_frame.slots_from_sp(?f.frame)) { ret x64.RSP; }
    ret x64.RBP;
}

fun slot_base_bias(f: *mir.MirFunction) i64 {
    if (!codegen_frame.slots_from_sp(?f.frame)) { ret 0; }
    ret f.frame.base_dist::i64;
}

fun fp_save_base(fill: isa.RegFileFn, frame_size: u32, callee_mask: u32) usize {
    val gp_space: usize = count_callee_saved(fill, callee_mask)::usize * 8;
    var base:     usize = frame_size::usize + gp_space;
    if ((base & 15) != 0) { base = (base + 15) & ~15::usize; }
    ret base;
}

fun emit_inst(st: *enc.EncodeState, mi: *isa.Inst) {
    encode_inst(mi, ?st.buf);
}

fun emit_frame_store(st: *enc.EncodeState, reg: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa.make_mem(base, disp, -1, 0, 8);
    mi.src1   = isa.make_reg(reg, 8);
    mi.size   = 8;
    mi.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mi);
}

fun emit_frame_load(st: *enc.EncodeState, reg: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa.make_reg(reg, 8);
    mi.src1   = isa.make_mem(base, disp, -1, 0, 8);
    mi.size   = 8;
    mi.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mi);
}

fun emit_xmm_store(st: *enc.EncodeState, idx: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOVAPS;
    mi.dst    = isa.make_mem(base, disp, -1, 0, 16);
    mi.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx), 16);
    mi.size   = 16;
    emit_inst(st, ?mi);
}

fun emit_xmm_load(st: *enc.EncodeState, idx: i32, base: i32, disp: i32) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MOVAPS;
    mi.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx), 16);
    mi.src1   = isa.make_mem(base, disp, -1, 0, 16);
    mi.size   = 16;
    emit_inst(st, ?mi);
}

fun needs_stack_probe(stack_probe: bool, page_size: u64, total: usize) bool {
    ret stack_probe && total > page_size::usize;
}

fun emit_stack_probe(st: *enc.EncodeState, total: usize, page_bytes: usize) err[fail.Fail] {
    var mov_cnt: isa.Inst = isa.inst_blank();
    mov_cnt.opcode = x64.MOV;
    mov_cnt.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    mov_cnt.src1   = isa.make_imm(total::i64, 8);
    mov_cnt.size   = 8;
    mov_cnt.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mov_cnt);

    val loop_top: usize = st.buf.len;
    printer.note_local_label(?st.buf, 1);

    var sub_sp: isa.Inst = isa.inst_blank();
    sub_sp.opcode = x64.SUB;
    sub_sp.dst    = isa.make_reg(x64.RSP, 8);
    sub_sp.src1   = isa.make_imm(page_bytes::i64, 8);
    sub_sp.size   = 8;
    sub_sp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?sub_sp);

    var touch: isa.Inst = isa.inst_blank();
    touch.opcode = x64.MOV;
    touch.dst    = isa.make_mem(x64.RSP, 0, -1, 0, 8);
    touch.src1   = isa.make_reg(x64.SCRATCH_REG, 8);
    touch.size   = 8;
    touch.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?touch);

    var sub_cnt: isa.Inst = isa.inst_blank();
    sub_cnt.opcode = x64.SUB;
    sub_cnt.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    sub_cnt.src1   = isa.make_imm(page_bytes::i64, 8);
    sub_cnt.size   = 8;
    sub_cnt.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?sub_cnt);

    var cmp_cnt: isa.Inst = isa.inst_blank();
    cmp_cnt.opcode = x64.CMP;
    cmp_cnt.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    cmp_cnt.src1   = isa.make_imm(page_bytes::i64, 8);
    cmp_cnt.size   = 8;
    cmp_cnt.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?cmp_cnt);

    var ja: isa.Inst = isa.inst_blank();
    ja.opcode = x64.JA;
    ja.dst    = isa.make_numbered_local_label(false, 1);
    ja.size   = DEFAULT_OPERAND_SIZE;
    val fp: err[fail.Fail] = flags_pair(cmp_cnt.opcode, ja.opcode);
    if (sel fp.err) { ret fp; }
    emit_inst(st, ?ja);
    val ja_patch: usize = st.buf.len - 4;
    patch_rel32(?st.buf, ja_patch, (loop_top::i64 - st.buf.len::i64)::i32);

    var sub_rem: isa.Inst = isa.inst_blank();
    sub_rem.opcode = x64.SUB;
    sub_rem.dst    = isa.make_reg(x64.RSP, 8);
    sub_rem.src1   = isa.make_reg(x64.SCRATCH_REG, 8);
    sub_rem.size   = 8;
    sub_rem.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?sub_rem);
    ret err[fail.Fail].ok{};
}

fun emit_prologue(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32) err[fail.Fail] {
    val frame_size:     u32 = f.frame.size;
    val callee_mask:    u32 = f.callee_mask;
    val callee_mask_fp: u32 = f.callee_mask_fp;
    val outgoing_size:  u32 = f.frame.outgoing_size;

    val rf: err[fail.Fail] = enc.push_frame(st, fn_base);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }

    var push_rbp: isa.Inst = isa.inst_blank();
    push_rbp.opcode = x64.PUSH;
    push_rbp.dst    = isa.make_reg(x64.RBP, 8);
    push_rbp.size   = 8;
    push_rbp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?push_rbp);
    val rs_push: err[fail.Fail] = enc.push_frame_step(st, of.FRAME_STEP_PUSH, x64.RBP::u8,
        st.buf.len::u32 - fn_base, 0);
    if (sel rs_push.err) { ret err[fail.Fail].err{rs_push.err}; }

    var mov_rbp: isa.Inst = isa.inst_blank();
    mov_rbp.opcode = x64.MOV;
    mov_rbp.dst    = isa.make_reg(x64.RBP, 8);
    mov_rbp.src1   = isa.make_reg(x64.RSP, 8);
    mov_rbp.size   = 8;
    mov_rbp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mov_rbp);

    val realigned: bool = f.frame.realign != 0;
    if (realigned) {
        val rs_fp: err[fail.Fail] = enc.push_frame_step(st, of.FRAME_STEP_SET_FP, x64.RBP::u8,
            st.buf.len::u32 - fn_base, 0);
        if (sel rs_fp.err) { ret err[fail.Fail].err{rs_fp.err}; }

        var and_rsp: isa.Inst = isa.inst_blank();
        and_rsp.opcode = x64.AND;
        and_rsp.dst    = isa.make_reg(x64.RSP, 8);
        and_rsp.src1   = isa.make_imm(0 - f.frame.realign::i64, 8);
        and_rsp.size   = 8;
        and_rsp.flags  = x64.FLAG_REX_W;
        emit_inst(st, ?and_rsp);
    }

    val total: usize = f.frame.base_dist::usize;
    if (total > 0) {
        if (needs_stack_probe(st.stack_probe, st.page_size, total)) {
            val pr: err[fail.Fail] = emit_stack_probe(st, total, st.page_size::usize);
            if (sel pr.err) { ret pr; }
        }
        or {
            var sub_rsp: isa.Inst = isa.inst_blank();
            sub_rsp.opcode = x64.SUB;
            sub_rsp.dst    = isa.make_reg(x64.RSP, 8);
            sub_rsp.src1   = isa.make_imm(total::i64, 8);
            sub_rsp.size   = 8;
            sub_rsp.flags  = x64.FLAG_REX_W;
            emit_inst(st, ?sub_rsp);
        }
        if (!realigned) {
            val rs_alloc: err[fail.Fail] = enc.push_frame_step(st, of.FRAME_STEP_ALLOC, 0,
                st.buf.len::u32 - fn_base, total::u64);
            if (sel rs_alloc.err) { ret err[fail.Fail].err{rs_alloc.err}; }
        }
    }

    val sbase: i32 = slot_base_reg(f);
    val sbias: i64 = slot_base_bias(f);

    var list: [16]i32;
    val ln:   i32 = x64.callee_saved_gp_list_from(st.callee_saved, ?list[0]);
    var coff: i32 = frame_size::i32 + 8;
    var i:    i32 = 0;
    for (i < ln) {
        if ((callee_mask & (1::u32 << list[i]::u32)) != 0) {
            emit_frame_store(st, list[i], sbase, (sbias - coff::i64)::i32);
            val rs_save: err[fail.Fail] = enc.push_frame_step(st, of.FRAME_STEP_SAVE, list[i]::u8,
                st.buf.len::u32 - fn_base,
                (total::i64 - coff::i64)::u64);
            if (sel rs_save.err) { ret err[fail.Fail].err{rs_save.err}; }
            coff = coff + 8;
        }
        i = i + 1;
    }

    val xbase: i32 = fp_save_base(st.callee_saved, frame_size, callee_mask)::i32;
    var xoff:  i32 = xbase + 16;
    var x:     i32 = 0;
    for (x < 16) {
        if ((callee_mask_fp & (1::u32 << x::u32)) != 0) {
            emit_xmm_store(st, x, sbase, (sbias - xoff::i64)::i32);
            val rs_xsave: err[fail.Fail] = enc.push_frame_step(st, of.FRAME_STEP_SAVE_VEC, x::u8,
                st.buf.len::u32 - fn_base,
                (total::i64 - xoff::i64)::u64);
            if (sel rs_xsave.err) { ret err[fail.Fail].err{rs_xsave.err}; }
            xoff = xoff + 16;
        }
        x = x + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_epilogue(st: *enc.EncodeState, f: *mir.MirFunction) {
    val frame_size:     u32 = f.frame.size;
    val callee_mask:    u32 = f.callee_mask;
    val callee_mask_fp: u32 = f.callee_mask_fp;
    val sbase:          i32 = slot_base_reg(f);
    val sbias:          i64 = slot_base_bias(f);

    val xbase: i32 = fp_save_base(st.callee_saved, frame_size, callee_mask)::i32;
    var xoff:  i32 = xbase + 16;
    var x:     i32 = 0;
    for (x < 16) {
        if ((callee_mask_fp & (1::u32 << x::u32)) != 0) {
            emit_xmm_load(st, x, sbase, (sbias - xoff::i64)::i32);
            xoff = xoff + 16;
        }
        x = x + 1;
    }

    var list: [16]i32;
    val ln:   i32 = x64.callee_saved_gp_list_from(st.callee_saved, ?list[0]);
    var coff: i32 = frame_size::i32 + 8;
    var i:    i32 = 0;
    for (i < ln) {
        if ((callee_mask & (1::u32 << list[i]::u32)) != 0) {
            emit_frame_load(st, list[i], sbase, (sbias - coff::i64)::i32);
            coff = coff + 8;
        }
        i = i + 1;
    }

    var mov_rsp: isa.Inst = isa.inst_blank();
    mov_rsp.opcode = x64.MOV;
    mov_rsp.dst    = isa.make_reg(x64.RSP, 8);
    mov_rsp.src1   = isa.make_reg(x64.RBP, 8);
    mov_rsp.size   = 8;
    mov_rsp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?mov_rsp);

    var pop_rbp: isa.Inst = isa.inst_blank();
    pop_rbp.opcode = x64.POP;
    pop_rbp.dst    = isa.make_reg(x64.RBP, 8);
    pop_rbp.size   = 8;
    pop_rbp.flags  = x64.FLAG_REX_W;
    emit_inst(st, ?pop_rbp);
}

fun is_rip_mem(op: *isa.Operand) bool {
    ret op.kind == isa.OPK_MEM && op.base == -1 && op.index == -1;
}

fun trailing_imm_width(mi: *isa.Inst) i32 {
    if (mi.src1.kind != isa.OPK_IMM)                                             { ret 0; }
    if (mi.size == 8 && (mi.src1.imm < -2147483648 || mi.src1.imm > 2147483647)) { ret 0; }
    if (mi.size == 1)                                                            { ret 1; }
    if (mi.size == 2)                                                            { ret 2; }
    ret 4;
}

fun x86_reloc_offset(ctx: ptr, mi: *isa.Inst, inst_size: i32) i32 {
    if (mi.opcode == x64.MOVABS) {
        ret inst_size - 8;
    }
    if (mi.opcode == x64.CALL || mi.opcode == x64.JMP || is_jcc(mi.opcode)) {
        ret inst_size - 4;
    }
    if (mi.dst.kind == isa.OPK_LABEL || mi.src1.kind == isa.OPK_LABEL) {
        ret inst_size - 4;
    }
    if (is_rip_mem(?mi.dst)) {
        ret inst_size - trailing_imm_width(mi) - 4;
    }
    if (is_rip_mem(?mi.src1)) {
        ret inst_size - 4;
    }
    ret -1;
}

val DEFAULT_OPERAND_SIZE: u8 = 8;

fun x64_hooks() enc.EncodeHooks {
    var hooks: enc.EncodeHooks = enc.hooks_blank();
    hooks.encode_function    = encode_function;
    hooks.patch_branch       = patch_branch_x86;
    hooks.stream             = true;
    hooks.effects.describe   = inst_effects;
    hooks.effects.mnemonic   = printer.mnemonic;
    hooks.effects.reg_name   = printer.reg_name;
    hooks.effects.const_regs = 0;
    ret hooks;
}

pub fun encode_x64(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule) res[enc.EncoderOutput, fail.Fail] {
    val hooks: enc.EncodeHooks = x64_hooks();
    ret enc.encode_module(alloc, tgt, m, ?hooks);
}

pub fun encode_x64_asm(alloc: *A.Allocator, tgt: *isa.BackendTarget, m: *mir.MirModule,
    out: *writer.Writer) res[enc.EncoderOutput, fail.Fail] {
    val hooks: enc.EncodeHooks = x64_hooks();

    val res_header: err[fail.Fail] = printer.emit_header(out);
    if (sel res_header.err) {
        ret res[enc.EncoderOutput, fail.Fail].err{res_header.err};
    }
    ret enc.encode_module_asm(alloc, tgt, m, ?hooks, out);
}

fun patch_branch_x86(st: *enc.EncodeState, fx: *enc.BranchFixup, target_off: u32) err[fail.Fail] {
    val disp: i32 = target_off::i32 - fx.next_ip::i32;
    if (fx.patch_pos::usize + 4 > st.buf.len) {
        ret err[fail.Fail].err{fail.message("encode: branch fixup site is outside the text buffer")};
    }
    patch_rel32(?st.buf, fx.patch_pos::usize, disp);
    ret err[fail.Fail].ok{};
}

fun encode_function(st: *enc.EncodeState, f: *mir.MirFunction) err[fail.Fail] {
    val fn_base: u32 = st.buf.len::u32;

    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }

    val ms: err[fail.Fail] = enc.push_symbol(st, f.name, fn_base, of.SYM_OBJ_FLAG_FUNCTION);
    if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }

    val naked:          bool = f.frame.omit;
    val frame_size:     u32  = f.frame.size;
    val callee_mask:    u32  = f.callee_mask;
    val callee_mask_fp: u32  = f.callee_mask_fp;
    val outgoing_size:  u32  = f.frame.outgoing_size;

    if (enc.sink_active(?st.buf)) {
        val rh: err[fail.Fail] = printer.note_function(?st.buf, st.interner, f);
        if (sel rh.err) { ret rh; }
    }

    if (!naked) {
        val rpl: err[fail.Fail] = emit_prologue(st, f, fn_base);
        if (sel rpl.err) { ret rpl; }
    }
    val rp: err[fail.Fail] = check_accounted(st, PROLOGUE_REGION);
    if (sel rp.err) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *mir.MirBlock  = ?f.blocks[bi];
        val rb:  err[fail.Fail] = enc.push_block(st, fn_base, blk.id, st.buf.len::u32);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        enc.set_fallthrough(st, f, bi);

        if (enc.sink_active(?st.buf)) {
            val rl: err[fail.Fail] = printer.note_block(?st.buf, blk.id);
            if (sel rl.err) { ret rl; }
        }

        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val mi: *mir.MirInstr = ?blk.instrs[ii];
            if (!mir.emits_instr(f, mi)) {
                ii = ii + 1;
                cnt;
            }
            val rr: err[fail.Fail] = enc.push_row(st, st.buf.len::u32, mi.loc);
            if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
            val rip: err[fail.Fail] = enc.push_inline_pc(st, st.buf.len::u32, mi.inline_site);
            if (sel rip.err) { ret err[fail.Fail].err{rip.err}; }
            if (mi.opcode == x64.RET::u32 && !naked) {
                emit_epilogue(st, f);
            }
            enc.sink_set_mir(?st.buf, mi);
            val ei: err[fail.Fail] = encode_mir_instr(st, f, fn_base, mi);
            val eb: err[fail.Fail] = enc.note_barrier(?st.buf, mi);
            enc.sink_set_mir(?st.buf, nil);
            if (sel ei.err) { ret ei; }
            if (sel eb.err) { ret err[fail.Fail].err{eb.err}; }
            val ra: err[fail.Fail] = check_accounted(st, mi.opcode::u16);
            if (sel ra.err) { ret ra; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    ret err[fail.Fail].ok{};
}

val PROLOGUE_REGION: u16 = 0xFFFF;

fun check_accounted(st: *enc.EncodeState, opcode: u16) err[fail.Fail] {
    val gap: usize = enc.sink_unaccounted(?st.buf);
    if (gap == 0) { ret err[fail.Fail].ok{}; }

    var num:   [20]u8;
    var label: str = "prologue";
    if (opcode != PROLOGUE_REGION) {
        val n: usize = common.u64_to_dec(opcode::u64, ?num[0]);
        num[n] = 0;
        label  = (?num[0])::str;
    }
    ret err[fail.Fail].err{fail.message(enc_named_message(st,
        "--emit-asm: opcode ", label,
        " emitted bytes the x86-64 assembly printer did not render",
        "--emit-asm: an opcode emitted bytes the assembly printer did not render"))};
}

fun enc_named_message(st: *enc.EncodeState, prefix: str, name: str, suffix: str, fallback: str) str {
    ret named_message(st.alloc, st.interner, prefix, name, suffix, fallback);
}

fun named_message(alloc: *A.Allocator, interner: *intern.Interner, prefix: str, name: str, suffix: str, fallback: str) str {
    if (interner == nil || name == nil) { ret fallback; }
    val lp:    usize = str_len(prefix);
    val ln:    usize = str_len(name);
    val ls:    usize = str_len(suffix);
    val total: usize = lp + ln + ls;

    val r: res[*u8, A.Error] = A.allocate[u8](alloc, total + 1);
    if (sel r.err) { ret fallback; }
    val buf: *u8   = r.ok;
    var k:   usize = 0;
    var j:   usize = 0;
    for (j < lp) {
        buf[k] = prefix[j];
        k      = k + 1;
        j      = j + 1;
    }
    j = 0;
    for (j < ln) {
        buf[k] = name[j];
        k      = k + 1;
        j      = j + 1;
    }
    j = 0;
    for (j < ls) {
        buf[k] = suffix[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[total] = 0;

    val ir: res[intern.StrId, A.Error] = intern.intern(interner, buf::str);
    A.deallocate[u8](alloc, buf, total + 1);
    if (sel ir.err) { ret fallback; }
    val nm: opt[str] = intern.lookup(interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

fun enc_fn_name(st: *enc.EncodeState, f: *mir.MirFunction) str {
    val fno: opt[str] = intern.lookup(st.interner, f.name);
    if (sel fno.some) { ret fno.some; }
    ret "<unknown>";
}

fun encode_mir_instr(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.opcode > 0xFFFF) {
        val r_2324: err[fail.Fail] = enc.opcode_failure(st, f, "x64", mi.opcode);
        if (sel r_2324.err) { ret err[fail.Fail].err{r_2324.err}; }
        ret err[fail.Fail].ok{};
    }
    val opcode: u16 = mi.opcode::u16;

    val rv_vb: err[fail.Fail] = enc.emit_var_bindings(st, f, mi);
    if (sel rv_vb.err) { ret err[fail.Fail].err{rv_vb.err}; }

    if (opcode == isa.ISA_PCOPY || opcode == isa.ISA_PCOPY_FENCE ||
        opcode == isa.ISA_USE || opcode == isa.ISA_LABEL) {
        ret err[fail.Fail].ok{};
    }

    if (mi.opcode == mir.MIR_CALL_RES || mi.opcode == mir.MIR_ARG) {
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == mir.MIR_PHI) {
        ret err[fail.Fail].err{fail.message(enc_named_message(st, "internal compiler error: phi survived register allocation in '", enc_fn_name(st, f), "'", "internal compiler error: phi survived register allocation"))};
    }

    if (mi.opcode == mir.MIR_MUL_WIDE_S || mi.opcode == mir.MIR_MUL_WIDE_U) {
        ret encode_vector_widen_mul(f, mi, ?st.buf);
    }
    if (mi.opcode == mir.MIR_VEC_WIDEN_S || mi.opcode == mir.MIR_VEC_WIDEN_U) {
        ret encode_vector_widen_half(st, f, mi);
    }
    if (mir.vec_lane_is_vector(mi.vec_lane) && is_selected_vector_alu(mi.opcode)) {
        ret encode_vector_op(st, f, mi);
    }
    if (mir.vec_lane_is_convert(mi.vec_lane)) {
        ret encode_vector_convert(f, mi, ?st.buf);
    }

    if (common.is_mir_compare(mi.opcode)) {
        ret encode_compare(f, mi, ?st.buf);
    }
    if (mi.opcode == mir.MIR_SEL_MASK_LT_U) {
        ret encode_compare_mask(f, mi, ?st.buf);
    }

    if (is_mir_float_arith(mi.opcode)) {
        ret encode_float_arith(st, f, mi);
    }
    if (mi.opcode == mir.MIR_FCMP) {
        ret encode_float_cmp(st, f, mi);
    }
    if (mi.opcode == mir.MIR_FNEG) {
        ret encode_float_neg(st, f, mi);
    }

    if (common.is_mir_float_conv(mi.opcode)) {
        ret encode_float_conv(st, f, mi);
    }

    if (is_float_const_move(f, mi)) {
        ret encode_float_const_mov(st, f, mi);
    }

    if (common.is_mir_divide(mi.opcode)) {
        ret encode_divide(f, mi, ?st.buf);
    }

    if (is_mir_mul_pair(mi.opcode)) {
        ret encode_mul_pair(f, mi, ?st.buf);
    }

    if (is_mir_binary(mi.opcode)) {
        ret encode_binary(f, mi, ?st.buf);
    }

    if (is_mir_shift(mi.opcode)) {
        ret encode_shift_mir(f, mi, ?st.buf);
    }

    if (is_mir_unary(mi.opcode)) {
        ret encode_unary_mir(f, mi, ?st.buf);
    }

    if (mi.opcode == mir.MIR_SEL_CBR) {
        ret encode_cbr(st, f, fn_base, mi);
    }

    if (mir.is_fused_cbr(mi.opcode)) {
        ret encode_fused_cbr(st, f, fn_base, mi);
    }

    if (opcode == x64.JMP::u16) {
        var jt:      u32          = 0;
        var jhas:    bool         = false;
        var jsym:    intern.StrId = intern.STR_NIL;
        var jhsym:   bool         = false;
        var jaddend: i64          = 0;
        enc.classify_refs(mi, ?jt, ?jhas, ?jsym, ?jhsym, ?jaddend);
        if (jhas && enc.branch_falls_through(st, jt)) { ret err[fail.Fail].ok{}; }
    }

    if (opcode == x64.ASM_BLOCK::u16) {
        ret encode_asm_block(st, f, fn_base, mi);
    }

    var inst: isa.Inst       = isa.inst_blank();
    val ti:   err[fail.Fail] = mir_to_inst(f, mi, ?inst);
    if (sel ti.err) { ret ti; }

    var target_block: u32          = 0;
    var has_block:    bool         = false;
    var sym:          intern.StrId = intern.STR_NIL;
    var has_sym:      bool         = false;
    var sym_addend:   i64          = 0;
    enc.classify_refs(mi, ?target_block, ?has_block, ?sym, ?has_sym, ?sym_addend);

    val inst_start: usize = st.buf.len;
    val inst_size:  i32   = encode_inst(?inst, ?st.buf);
    if (inst_size <= 0) {
        val r_2417: err[fail.Fail] = enc.opcode_failure(st, f, "x64", mi.opcode);
        if (sel r_2417.err) { ret err[fail.Fail].err{r_2417.err}; }
        ret err[fail.Fail].ok{};
    }

    if (has_block) {
        val reloc_off: i32 = x86_reloc_offset(nil, ?inst, inst_size);
        if (reloc_off < 0) {
            ret err[fail.Fail].err{fail.message("encode: block-referencing instruction has no relocation patch site")};
        }
        val patch_pos: u32            = (inst_start + reloc_off::usize)::u32;
        val next_ip:   u32            = (inst_start + inst_size::usize)::u32;
        val r_2427:    err[fail.Fail] = enc.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
        if (sel r_2427.err) { ret err[fail.Fail].err{r_2427.err}; }
        ret err[fail.Fail].ok{};
    }

    if (has_sym) {
        if (sym == intern.STR_NIL) {
            ret err[fail.Fail].err{fail.message("encode: symbol-referencing instruction has no resolved symbol name")};
        }
        val reloc_off: i32 = x86_reloc_offset(nil, ?inst, inst_size);
        if (reloc_off < 0) {
            ret err[fail.Fail].err{fail.message("encode: symbol-referencing instruction has no relocation patch site")};
        }
        val patch_pos: u32          = (inst_start + reloc_off::usize)::u32;
        var kind:      of.RelocKind = of.RK_PC32;
        var addend:    i64          = sym_addend - (inst_size - reloc_off)::i64;
        if (inst.opcode == x64.MOVABS::u16) {
            kind   = of.RK_ABS64;
            addend = sym_addend;
        }
        val r_2445: err[fail.Fail] = enc.push_reloc(st, patch_pos, kind, sym, addend);
        if (sel r_2445.err) { ret err[fail.Fail].err{r_2445.err}; }
        ret err[fail.Fail].ok{};
    }

    ret err[fail.Fail].ok{};
}

fun mir_setcc_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_CMP_EQ)   { ret x64.SETE; }
    if (op == mir.MIR_SEL_CMP_NE)   { ret x64.SETNE; }
    if (op == mir.MIR_SEL_CMP_LT_S) { ret x64.SETL; }
    if (op == mir.MIR_SEL_CMP_LT_U) { ret x64.SETB; }
    if (op == mir.MIR_SEL_CMP_LE_S) { ret x64.SETLE; }
    ret x64.SETBE;
}

# a flags consumer emitted directly after its producer: both rows are read
# from the table, so the pairing is a stated fact and not an assumption
# about adjacency
fun flags_pair(producer: u16, consumer: u16) err[fail.Fail] {
    val p: ct.AsmClass = x64.describe(producer).cls;
    val c: ct.AsmClass = x64.describe(consumer).cls;
    if (!p.known || !p.defines_flags) {
        ret err[fail.Fail].err{fail.message("internal compiler error: x86-64 flags producer does not define the flags its consumer reads")};
    }
    if (!c.known || !(c.reads_flags || c.cond_flags)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: x86-64 flags consumer does not read the flags its producer defines")};
    }
    ret err[fail.Fail].ok{};
}

# an instruction emitted between a flags producer and its consumer must
# leave the flags alone, by its row
fun flags_kept(op: u16) err[fail.Fail] {
    val c: ct.AsmClass = x64.describe(op).cls;
    if (!c.known || !c.flags_stated || c.writes_flags) {
        ret err[fail.Fail].err{fail.message("internal compiler error: x86-64 instruction between a flags producer and its consumer writes the flags")};
    }
    ret err[fail.Fail].ok{};
}

# emits the compare and answers the opcode that defined the flags
fun emit_flag_cmp(f: *mir.MirFunction, lhs_op: *mir.MirOperand, rhs_op: *mir.MirOperand,
    width: u8, buf: *enc.ByteBuf) res[u16, fail.Fail] {
    val cwidth: u8                          = effective_width(width);
    val rl:     res[isa.Operand, fail.Fail] = mir_to_operand(f, lhs_op, cwidth);
    if (sel rl.err) { ret res[u16, fail.Fail].err{rl.err}; }
    val lhs: isa.Operand                 = rl.ok;
    val rr:  res[isa.Operand, fail.Fail] = mir_to_operand(f, rhs_op, cwidth);
    if (sel rr.err) { ret res[u16, fail.Fail].err{rr.err}; }
    val rhs: isa.Operand = rr.ok;

    var cmp_lhs: isa.Operand = lhs;
    if (cmp_lhs.kind == isa.OPK_IMM) {
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa.make_reg(x64.R11, cwidth);
        ld.src1   = lhs;
        ld.size   = cwidth;
        ld.flags  = width_flags(width);
        encode_inst(?ld, buf);
        cmp_lhs = isa.make_reg(x64.R11, cwidth);
    }

    var cmp: isa.Inst = isa.inst_blank();
    cmp.opcode = x64.CMP;
    cmp.dst    = cmp_lhs;
    cmp.src1   = rhs;
    cmp.size   = cwidth;
    cmp.flags  = width_flags(width);
    encode_inst(?cmp, buf);
    ret res[u16, fail.Fail].ok{cmp.opcode};
}

fun encode_compare(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: comparison missing operands")};
    }
    val cwidth: u8                          = effective_width(mi.width);
    val rd:     res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], cwidth);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand = rd.ok;

    val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[1], ?mi.operands[2], mi.width, buf);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    var setcc: isa.Inst = isa.inst_blank();
    setcc.opcode = mir_setcc_opcode(mi.opcode);
    val fp: err[fail.Fail] = flags_pair(rc.ok, setcc.opcode);
    if (sel fp.err) { ret fp; }
    setcc.dst      = dst;
    setcc.dst.size = 1;
    setcc.size     = 1;
    encode_inst(?setcc, buf);

    var movzx: isa.Inst = isa.inst_blank();
    movzx.opcode    = x64.MOVZX;
    movzx.dst       = dst;
    movzx.dst.size  = DEFAULT_OPERAND_SIZE;
    movzx.src1      = dst;
    movzx.src1.size = 1;
    movzx.size      = DEFAULT_OPERAND_SIZE;
    movzx.flags     = x64.FLAG_REX_W;
    encode_inst(?movzx, buf);

    ret err[fail.Fail].ok{};
}

# `cmp a, b` leaves the carry set exactly when a is below b unsigned, and
# `sbb d, d` spreads it into all ones or zero (#3885)
fun encode_compare_mask(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: compare-to-mask missing operands")};
    }
    var size: u8 = 4;
    if (effective_width(mi.width) >= 8) { size = 8; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], size);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand = rd.ok;
    if (dst.kind != isa.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: compare-to-mask destination is not a register")};
    }

    val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[1], ?mi.operands[2], mi.src_width, buf);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val fp: err[fail.Fail] = flags_pair(rc.ok, x64.SBB);
    if (sel fp.err) { ret fp; }

    var sbb: isa.Inst = isa.inst_blank();
    sbb.opcode = x64.SBB;
    sbb.dst    = dst;
    sbb.src1   = dst;
    sbb.size   = size;
    sbb.flags  = width_flags(size);
    encode_inst(?sbb, buf);
    ret err[fail.Fail].ok{};
}

fun float_scratch0() i32 {
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM14);
}

fun float_scratch1() i32 {
    ret isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM15);
}

fun is_mir_float_arith(op: mir.MirOpcode) bool {
    ret op == mir.MIR_FADD || op == mir.MIR_FSUB ||
        op == mir.MIR_FMUL || op == mir.MIR_FDIV;
}

fun float_alu_opcode(op: mir.MirOpcode, w: u8) u16 {
    if (op == mir.MIR_FADD) {
        if (w == 4) { ret x64.ADDSS; }
        ret x64.ADDSD;
    }
    if (op == mir.MIR_FSUB) {
        if (w == 4) { ret x64.SUBSS; }
        ret x64.SUBSD;
    }
    if (op == mir.MIR_FMUL) {
        if (w == 4) { ret x64.MULSS; }
        ret x64.MULSD;
    }
    if (w == 4) { ret x64.DIVSS; }
    ret x64.DIVSD;
}

fun emit_float_load(st: *enc.EncodeState, op: isa.Operand, xmm: i32, w: u8) err[fail.Fail] {
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float load has a non-float access width (expected 4 or 8)")};
    }
    if (op.kind != isa.OPK_IMM) { ret emit_float_reg_or_slot_load(op, xmm, w, ?st.buf); }

    val cr: res[isa.Operand, fail.Fail] = float_const_operand(st, op.imm::u64, xmm, w);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    val src: isa.Operand = cr.ok;
    if (src.kind == isa.OPK_NONE) { ret err[fail.Fail].ok{}; }

    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }
    var ld: isa.Inst = isa.inst_blank();
    ld.opcode = mov_op;
    ld.dst    = isa.make_reg(xmm, 16);
    ld.src1   = src;
    ld.size   = w;
    ret encode_inst_sym(st, ?ld);
}

fun emit_float_reg_or_slot_load(op: isa.Operand, xmm: i32, w: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float load has a non-float access width (expected 4 or 8)")};
    }
    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }

    if (op.kind == isa.OPK_MEM) {
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = mov_op;
        ld.dst    = isa.make_reg(xmm, 16);
        ld.src1   = op;
        ld.size   = w;
        encode_inst(?ld, buf);
        ret err[fail.Fail].ok{};
    }
    if (op.kind == isa.OPK_REG) {
        var mv: isa.Inst = isa.inst_blank();
        mv.opcode = mov_op;
        mv.dst    = isa.make_reg(xmm, 16);
        mv.src1   = isa.make_reg(op.reg, 16);
        mv.size   = w;
        encode_inst(?mv, buf);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: float operand is not a register or a frame slot")};
}

fun float_const_operand(st: *enc.EncodeState, bits: u64, zero_reg: i32, w: u8) res[isa.Operand, fail.Fail] {
    if (!common.is_float_width(w)) {
        ret res[isa.Operand, fail.Fail].err{fail.message("internal compiler error: float constant has a non-float width (expected 4 or 8)")};
    }
    var pattern: u64 = bits;
    if (w == 4) { pattern = bits & 0xFFFFFFFF; }

    if (pattern == 0) {
        var zero: isa.Inst = isa.inst_blank();
        zero.opcode = x64.XORPS;
        zero.dst    = isa.make_reg(zero_reg, 16);
        zero.src1   = isa.make_reg(zero_reg, 16);
        zero.size   = 16;
        encode_inst(?zero, ?st.buf);
        ret res[isa.Operand, fail.Fail].ok{isa.make_none()};
    }

    val sr: res[intern.StrId, fail.Fail] = enc.intern_float_const(st, pattern, w);
    if (sel sr.err) { ret res[isa.Operand, fail.Fail].err{sr.err}; }

    var mem: isa.Operand = isa.make_mem(-1, 0, -1, 0, w);
    mem.sym_id = sr.ok;
    ret res[isa.Operand, fail.Fail].ok{mem};
}

fun const_ref_sym(op: *isa.Operand) intern.StrId {
    if (is_rip_mem(op)) { ret op.sym_id; }
    ret intern.STR_NIL;
}

fun encode_inst_sym(st: *enc.EncodeState, mi: *isa.Inst) err[fail.Fail] {
    val start: usize = st.buf.len;
    val n:     i32   = encode_inst(mi, ?st.buf);
    if (n <= 0) {
        ret err[fail.Fail].err{fail.message("encode: a constant-pool reference produced no bytes")};
    }

    var sym: intern.StrId = const_ref_sym(?mi.dst);
    if (sym == intern.STR_NIL) { sym = const_ref_sym(?mi.src1); }
    if (sym == intern.STR_NIL) { ret err[fail.Fail].ok{}; }

    val reloc_off: i32 = x86_reloc_offset(nil, mi, n);
    if (reloc_off < 0) {
        ret err[fail.Fail].err{fail.message("encode: a symbol-naming instruction has no relocation patch site")};
    }
    val r_2640: err[fail.Fail] = enc.push_reloc(st, (start + reloc_off::usize)::u32, of.RK_PC32, sym, -(n - reloc_off)::i64);
    if (sel r_2640.err) { ret err[fail.Fail].err{r_2640.err}; }
    ret err[fail.Fail].ok{};
}

fun is_float_const_move(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    if (mi.opcode::u16 != x64.MOV::u16) { ret false; }
    if (mi.operand_count < 2)           { ret false; }
    val dst: *mir.MirOperand = ?mi.operands[0];
    val src: *mir.MirOperand = ?mi.operands[1];
    if (src.kind != mir.MIR_OP_IMM)  { ret false; }
    if (dst.kind != mir.MIR_OP_PREG) { ret false; }
    ret isa.regid_class(mir.preg_regid(dst.preg)) == isa.REG_CLASS_ID_XMM;
}

fun encode_float_const_mov(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    val w: u8 = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float constant move has a non-float operand width (expected 4 or 8)")};
    }
    ret emit_float_load(st, isa.make_imm(mi.operands[1].imm, w),
        mir.preg_regid(mi.operands[0].preg), w);
}

fun float_work_reg(dst: isa.Operand) i32 {
    if (dst.kind == isa.OPK_REG) { ret dst.reg; }
    ret float_scratch0();
}

fun emit_float_seed(st: *enc.EncodeState, op: isa.Operand, xmm: i32, w: u8) err[fail.Fail] {
    if (op.kind == isa.OPK_REG && op.reg == xmm) { ret err[fail.Fail].ok{}; }
    ret emit_float_load(st, op, xmm, w);
}

fun float_src_operand(st: *enc.EncodeState, op: isa.Operand, scratch: i32, w: u8) res[isa.Operand, fail.Fail] {
    if (op.kind == isa.OPK_REG || op.kind == isa.OPK_MEM) { ret res[isa.Operand, fail.Fail].ok{op}; }
    if (op.kind == isa.OPK_IMM) {
        val cr: res[isa.Operand, fail.Fail] = float_const_operand(st, op.imm::u64, scratch, w);
        if (sel cr.err) { ret cr; }
        val c: isa.Operand = cr.ok;
        if (c.kind == isa.OPK_NONE) { ret res[isa.Operand, fail.Fail].ok{isa.make_reg(scratch, 16)}; }
        ret res[isa.Operand, fail.Fail].ok{c};
    }

    val ld: err[fail.Fail] = emit_float_load(st, op, scratch, w);
    if (sel ld.err) { ret res[isa.Operand, fail.Fail].err{ld.err}; }
    ret res[isa.Operand, fail.Fail].ok{isa.make_reg(scratch, 16)};
}

fun float_rhs_operand(st: *enc.EncodeState, rhs: isa.Operand, work: i32, w: u8) res[isa.Operand, fail.Fail] {
    if (rhs.kind == isa.OPK_REG && rhs.reg == work) {
        val ld: err[fail.Fail] = emit_float_load(st, rhs, float_scratch1(), w);
        if (sel ld.err) { ret res[isa.Operand, fail.Fail].err{ld.err}; }
        ret res[isa.Operand, fail.Fail].ok{isa.make_reg(float_scratch1(), 16)};
    }
    ret float_src_operand(st, rhs, float_scratch1(), w);
}

fun float_reg_operand(st: *enc.EncodeState, op: isa.Operand, scratch: i32, w: u8) res[i32, fail.Fail] {
    if (op.kind == isa.OPK_REG) { ret res[i32, fail.Fail].ok{op.reg}; }

    val ld: err[fail.Fail] = emit_float_load(st, op, scratch, w);
    if (sel ld.err) { ret res[i32, fail.Fail].err{ld.err}; }
    ret res[i32, fail.Fail].ok{scratch};
}

fun emit_float_store(dst: isa.Operand, xmm: i32, w: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float store has a non-float access width (expected 4 or 8)")};
    }
    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }

    if (dst.kind == isa.OPK_MEM) {
        var st: isa.Inst = isa.inst_blank();
        st.opcode = mov_op;
        st.dst    = dst;
        st.src1   = isa.make_reg(xmm, 16);
        st.size   = w;
        encode_inst(?st, buf);
        ret err[fail.Fail].ok{};
    }
    if (dst.kind == isa.OPK_REG) {
        var mv: isa.Inst = isa.inst_blank();
        mv.opcode = mov_op;
        mv.dst    = isa.make_reg(dst.reg, 16);
        mv.src1   = isa.make_reg(xmm, 16);
        mv.size   = w;
        encode_inst(?mv, buf);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: float destination is not a register or frame slot")};
}

fun encode_float_arith(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: float arithmetic missing operands")};
    }
    val w: u8 = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float arithmetic has a non-float operand width (expected 4 or 8)")};
    }

    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand                 = rd.ok;
    val rl:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val lhs: isa.Operand                 = rl.ok;
    val rr:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val rhs: isa.Operand = rr.ok;

    val work: i32          = float_work_reg(dst);
    val buf:  *enc.ByteBuf = ?st.buf;

    val rs: res[isa.Operand, fail.Fail] = float_rhs_operand(st, rhs, work, w);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa.Operand = rs.ok;

    val sd: err[fail.Fail] = emit_float_seed(st, lhs, work, w);
    if (sel sd.err) { ret sd; }

    var alu: isa.Inst = isa.inst_blank();
    alu.opcode = float_alu_opcode(mi.opcode, w);
    alu.dst    = isa.make_reg(work, 16);
    alu.src1   = src;
    alu.size   = w;
    val ae: err[fail.Fail] = encode_inst_sym(st, ?alu);
    if (sel ae.err) { ret ae; }

    if (dst.kind == isa.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret emit_float_store(dst, work, w, buf);
}

fun float_sign_mask(w: u8) i64 {
    if (w == 4) { ret 0x80000000::i64; }
    ret 0x8000000000000000::i64;
}

fun float_sign_mask_image(w: u8, out: *u8) {
    val m: u64 = float_sign_mask(w)::u64;
    var i: u32 = 0;
    for (i < 16) {
        out[i] = 0;
        i      = i + 1;
    }
    i = 0;
    for (i < 8) {
        out[i] = (m >> (i::u64 * 8::u64))::u8;
        i      = i + 1;
    }
}

fun encode_float_neg(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: float negate missing operands")};
    }
    val w: u8 = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float negate has a non-float operand width (expected 4 or 8)")};
    }

    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand                 = rd.ok;
    val rs:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa.Operand = rs.ok;

    val work: i32            = float_work_reg(dst);
    val buf:  *enc.ByteBuf   = ?st.buf;
    val ld:   err[fail.Fail] = emit_float_seed(st, src, work, w);
    if (sel ld.err) { ret ld; }

    var img: [16]u8;
    float_sign_mask_image(w, ?img[0]);
    val sr: res[intern.StrId, fail.Fail] = enc.intern_const(st, ?img[0], 16, enc.CONST_VEC);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }

    var mem: isa.Operand = isa.make_mem(-1, 0, -1, 0, 16);
    mem.sym_id = sr.ok;

    var xorp: isa.Inst = isa.inst_blank();
    xorp.opcode = x64.XORPS;
    xorp.dst    = isa.make_reg(work, 16);
    xorp.src1   = mem;
    xorp.size   = 16;
    val xr: err[fail.Fail] = encode_inst_sym(st, ?xorp);
    if (sel xr.err) { ret xr; }

    if (dst.kind == isa.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret emit_float_store(dst, work, w, buf);
}

fun emit_gp_store(dst: isa.Operand, gp: i32, w: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    if (dst.kind == isa.OPK_REG || dst.kind == isa.OPK_MEM) {
        var st: isa.Inst = isa.inst_blank();
        st.opcode = x64.MOV;
        st.dst    = dst;
        st.src1   = isa.make_reg(gp, w);
        st.size   = w;
        st.flags  = width_flags(w);
        encode_inst(?st, buf);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: conversion integer destination is not a register or frame slot")};
}

fun emit_cvt_reg(cvt_op: u16, dst_reg: i32, src_reg: i32, int_w: u8, buf: *enc.ByteBuf) {
    var dst_sz: u8 = 16;
    var src_sz: u8 = 16;
    if (cvt_op == x64.CVTSI2SS || cvt_op == x64.CVTSI2SD)   { src_sz = int_w; }
    if (cvt_op == x64.CVTTSS2SI || cvt_op == x64.CVTTSD2SI) { dst_sz = int_w; }

    var cvt: isa.Inst = isa.inst_blank();
    cvt.opcode = cvt_op;
    cvt.dst    = isa.make_reg(dst_reg, dst_sz);
    cvt.src1   = isa.make_reg(src_reg, src_sz);
    cvt.size   = int_w;
    cvt.flags  = width_flags(int_w);
    encode_inst(?cvt, buf);
}

fun patch_rel32(buf: *enc.ByteBuf, pos: usize, disp: i32) {
    buf.data[pos]     = (disp & 0xFF)::u8;
    buf.data[pos + 1] = ((disp >> 8) & 0xFF)::u8;
    buf.data[pos + 2] = ((disp >> 16) & 0xFF)::u8;
    buf.data[pos + 3] = ((disp >> 24) & 0xFF)::u8;
}

fun emit_gp_rr8(opcode: u16, dst_reg: i32, src_reg: i32, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa.make_reg(dst_reg, 8);
    mi.src1   = isa.make_reg(src_reg, 8);
    mi.size   = 8;
    mi.flags  = width_flags(8);
    encode_inst(?mi, buf);
}

fun emit_gp_ri8(opcode: u16, dst_reg: i32, imm: i64, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa.make_reg(dst_reg, 8);
    mi.src1   = isa.make_imm(imm, 8);
    mi.size   = 8;
    mi.flags  = width_flags(8);
    encode_inst(?mi, buf);
}

fun emit_fp_rr(opcode: u16, dst_reg: i32, src_reg: i32, w: u8, buf: *enc.ByteBuf) {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa.make_reg(dst_reg, 16);
    mi.src1   = isa.make_reg(src_reg, 16);
    mi.size   = w;
    encode_inst(?mi, buf);
}

fun normalize_int_imm(imm: i64, width: u8, signed: bool) i64 {
    if (width >= 8) { ret imm; }
    val bits: u64 = width::u64 * 8;
    val mask: u64 = (1::u64 << bits) - 1;
    var v:    u64 = imm::u64 & mask;
    if (signed) {
        val sign: u64 = 1::u64 << (bits - 1);
        if ((v & sign) != 0) { v = v | ~mask; }
    }
    ret v::i64;
}

fun emit_gp_load_ext(op: isa.Operand, gp: i32, src_w: u8, signed: bool, buf: *enc.ByteBuf) err[fail.Fail] {
    if (op.kind == isa.OPK_IMM) {
        emit_gp_ri8(x64.MOV, gp, normalize_int_imm(op.imm, src_w, signed), buf);
        ret err[fail.Fail].ok{};
    }
    if (op.kind != isa.OPK_REG && op.kind != isa.OPK_MEM) {
        ret err[fail.Fail].err{fail.message("encode: conversion integer operand is not a register, frame slot, or immediate")};
    }

    var ld: isa.Inst = isa.inst_blank();
    ld.dst       = isa.make_reg(gp, 8);
    ld.src1      = op;
    ld.src1.size = src_w;
    ld.size      = 8;
    ld.flags     = width_flags(8);
    if (src_w >= 8) {
        ld.opcode = x64.MOV;
    }
    or (signed && src_w >= 4) {
        ld.opcode = x64.MOVSXD;
    }
    or (signed) {
        ld.opcode = x64.MOVSX;
    }
    or {
        ld.opcode = x64.MOVZX;
    }
    encode_inst(?ld, buf);
    ret err[fail.Fail].ok{};
}

fun emit_u64_to_fp(dst: isa.Operand, work: i32, dst_w: u8, cvt_op: u16, buf: *enc.ByteBuf) err[fail.Fail] {
    var test_inst: isa.Inst = isa.inst_blank();
    test_inst.opcode = x64.TEST;
    test_inst.dst    = isa.make_reg(x64.SCRATCH_REG, 8);
    test_inst.src1   = isa.make_reg(x64.SCRATCH_REG, 8);
    test_inst.size   = 8;
    test_inst.flags  = width_flags(8);
    encode_inst(?test_inst, buf);

    var jl: isa.Inst = isa.inst_blank();
    jl.opcode = x64.JL;
    jl.dst    = isa.make_numbered_local_label(true, 1);
    jl.size   = DEFAULT_OPERAND_SIZE;
    val fp: err[fail.Fail] = flags_pair(test_inst.opcode, jl.opcode);
    if (sel fp.err) { ret fp; }
    encode_inst(?jl, buf);
    val jl_patch: usize = buf.len - 4;
    val after_jl: usize = buf.len;

    emit_cvt_reg(cvt_op, work, x64.SCRATCH_REG, 8, buf);

    var jmp: isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_numbered_local_label(true, 2);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    encode_inst(?jmp, buf);
    val jmp_patch: usize = buf.len - 4;
    val after_jmp: usize = buf.len;

    patch_rel32(buf, jl_patch, (buf.len - after_jl)::i32);
    printer.note_local_label(buf, 1);
    emit_gp_rr8(x64.MOV, x64.SCRATCH_REG2, x64.SCRATCH_REG, buf);
    emit_gp_ri8(x64.SHR, x64.SCRATCH_REG2, 1, buf);
    emit_gp_ri8(x64.AND, x64.SCRATCH_REG, 1, buf);
    emit_gp_rr8(x64.OR, x64.SCRATCH_REG, x64.SCRATCH_REG2, buf);
    emit_cvt_reg(cvt_op, work, x64.SCRATCH_REG, 8, buf);
    var add_op: u16 = x64.ADDSD;
    if (dst_w == 4) { add_op = x64.ADDSS; }
    emit_fp_rr(add_op, work, work, dst_w, buf);

    patch_rel32(buf, jmp_patch, (buf.len - after_jmp)::i32);
    printer.note_local_label(buf, 2);
    if (dst.kind == isa.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret emit_float_store(dst, work, dst_w, buf);
}

fun emit_fp_to_u64(st: *enc.EncodeState, src_reg: i32, src_w: u8, cvt_op: u16) err[fail.Fail] {
    val buf:        *enc.ByteBuf = ?st.buf;
    var bound_bits: u64          = 0x43E0000000000000;
    if (src_w == 4) { bound_bits = 0x5F000000; }
    val br: res[isa.Operand, fail.Fail] = float_const_operand(st, bound_bits, float_scratch1(), src_w);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }
    val bound: isa.Operand = br.ok;

    var ucom: isa.Inst = isa.inst_blank();
    ucom.opcode = x64.UCOMISD;
    if (src_w == 4) { ucom.opcode = x64.UCOMISS; }
    ucom.dst  = isa.make_reg(src_reg, 16);
    ucom.src1 = bound;
    ucom.size = src_w;
    val ue: err[fail.Fail] = encode_inst_sym(st, ?ucom);
    if (sel ue.err) { ret ue; }

    var jb: isa.Inst = isa.inst_blank();
    jb.opcode = x64.JB;
    jb.dst    = isa.make_numbered_local_label(true, 1);
    jb.size   = DEFAULT_OPERAND_SIZE;
    val fp: err[fail.Fail] = flags_pair(ucom.opcode, jb.opcode);
    if (sel fp.err) { ret fp; }
    encode_inst(?jb, buf);
    val jb_patch: usize = buf.len - 4;
    val after_jb: usize = buf.len;

    emit_movaps_rr(float_scratch0(), src_reg, buf);
    var sub: isa.Inst = isa.inst_blank();
    sub.opcode = x64.SUBSD;
    if (src_w == 4) { sub.opcode = x64.SUBSS; }
    sub.dst  = isa.make_reg(float_scratch0(), 16);
    sub.src1 = bound;
    sub.size = src_w;
    val se: err[fail.Fail] = encode_inst_sym(st, ?sub);
    if (sel se.err) { ret se; }
    emit_cvt_reg(cvt_op, x64.SCRATCH_REG, float_scratch0(), 8, buf);
    emit_gp_ri8(x64.MOV, x64.SCRATCH_REG2, (1::u64 << 63)::i64, buf);
    emit_gp_rr8(x64.ADD, x64.SCRATCH_REG, x64.SCRATCH_REG2, buf);

    var jmp: isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_numbered_local_label(true, 2);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    encode_inst(?jmp, buf);
    val jmp_patch: usize = buf.len - 4;
    val after_jmp: usize = buf.len;

    patch_rel32(buf, jb_patch, (buf.len - after_jb)::i32);
    printer.note_local_label(buf, 1);
    emit_cvt_reg(cvt_op, x64.SCRATCH_REG, src_reg, 8, buf);

    patch_rel32(buf, jmp_patch, (buf.len - after_jmp)::i32);
    printer.note_local_label(buf, 2);
    ret err[fail.Fail].ok{};
}

fun encode_float_conv(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: float conversion missing operands")};
    }
    val buf:   *enc.ByteBuf  = ?st.buf;
    val op:    mir.MirOpcode = mi.opcode;
    val dst_w: u8            = mi.width;
    val src_w: u8            = mi.src_width;

    if (op == mir.MIR_FP_TRUNC || op == mir.MIR_FP_EXT) {
        if (!common.is_float_width(dst_w) || !common.is_float_width(src_w)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: float conversion has a non-float width on a float side (expected 4 or 8)")};
        }
        val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
        if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
        val dst: isa.Operand                 = rd.ok;
        val rs:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], src_w);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        val src: isa.Operand = rs.ok;

        val sr: res[i32, fail.Fail] = float_reg_operand(st, src, float_scratch1(), src_w);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val src_reg: i32 = sr.ok;
        val work:    i32 = float_work_reg(dst);
        var cvt_op:  u16 = x64.CVTSD2SS;
        if (op == mir.MIR_FP_EXT) { cvt_op = x64.CVTSS2SD; }
        emit_cvt_reg(cvt_op, work, src_reg, 0, buf);
        if (dst.kind == isa.OPK_REG) { ret err[fail.Fail].ok{}; }
        ret emit_float_store(dst, work, dst_w, buf);
    }

    if (op == mir.MIR_SI_TO_FP || op == mir.MIR_UI_TO_FP) {
        if (!common.is_float_width(dst_w)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: integer-to-float conversion has a non-float result width (expected 4 or 8)")};
        }
        val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
        if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
        val dst: isa.Operand                 = rd.ok;
        val rs:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], src_w);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        val src: isa.Operand = rs.ok;

        val signed: bool           = op == mir.MIR_SI_TO_FP;
        val ld:     err[fail.Fail] = emit_gp_load_ext(src, x64.SCRATCH_REG, src_w, signed, buf);
        if (sel ld.err) { ret ld; }
        val work:   i32 = float_work_reg(dst);
        var cvt_op: u16 = x64.CVTSI2SD;
        if (dst_w == 4) { cvt_op = x64.CVTSI2SS; }
        if (!signed && src_w >= 8) {
            ret emit_u64_to_fp(dst, work, dst_w, cvt_op, buf);
        }
        emit_cvt_reg(cvt_op, work, x64.SCRATCH_REG, 8, buf);
        if (dst.kind == isa.OPK_REG) { ret err[fail.Fail].ok{}; }
        ret emit_float_store(dst, work, dst_w, buf);
    }

    if (!common.is_float_width(src_w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float-to-integer conversion has a non-float source width (expected 4 or 8)")};
    }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], dst_w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand                 = rd.ok;
    val rs:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa.Operand = rs.ok;

    val sr: res[i32, fail.Fail] = float_reg_operand(st, src, float_scratch0(), src_w);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val src_reg: i32 = sr.ok;
    var cvt_op:  u16 = x64.CVTTSD2SI;
    if (src_w == 4) { cvt_op = x64.CVTTSS2SI; }

    if (op == mir.MIR_FP_TO_UI) {
        if (dst_w >= 8) {
            val fx: err[fail.Fail] = emit_fp_to_u64(st, src_reg, src_w, cvt_op);
            if (sel fx.err) { ret fx; }
        }
        or {
            emit_cvt_reg(cvt_op, x64.SCRATCH_REG, src_reg, 8, buf);
        }
        ret emit_gp_store(dst, x64.SCRATCH_REG, dst_w, buf);
    }

    emit_cvt_reg(cvt_op, x64.SCRATCH_REG, src_reg, dst_w, buf);
    ret emit_gp_store(dst, x64.SCRATCH_REG, dst_w, buf);
}

fun emit_movd_movq_reg(gp: i32, xmm: i32, w: u8, gp_to_xmm: bool, buf: *enc.ByteBuf) {
    var mq: isa.Inst = isa.inst_blank();
    mq.opcode = x64.MOVQ;
    mq.size   = w;
    if (gp_to_xmm) {
        mq.dst  = isa.make_reg(xmm, 16);
        mq.src1 = isa.make_reg(gp, w);
    }
    or {
        mq.dst  = isa.make_reg(gp, w);
        mq.src1 = isa.make_reg(xmm, 16);
    }
    encode_inst(?mq, buf);
}

fun float_cmp_swap(cc: u8) bool {
    ret cc == mir.FCC_LT || cc == mir.FCC_LE;
}

fun float_setcc_opcode(cc: u8) u16 {
    if (cc == mir.FCC_EQ) { ret x64.SETE; }
    if (cc == mir.FCC_NE) { ret x64.SETNE; }
    if (cc == mir.FCC_LT) { ret x64.SETA; }
    if (cc == mir.FCC_LE) { ret x64.SETAE; }
    if (cc == mir.FCC_GT) { ret x64.SETA; }
    ret x64.SETAE;
}

fun encode_float_cmp(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: float comparison missing operands")};
    }
    val buf: *enc.ByteBuf = ?st.buf;
    val w:   u8           = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float comparison has a non-float operand width (expected 4 or 8)")};
    }
    val cc: u8 = mi.src_width;

    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], DEFAULT_OPERAND_SIZE);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand = rd.ok;
    if (dst.kind != isa.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: float comparison destination is not a register")};
    }
    val rl: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val lhs: isa.Operand                 = rl.ok;
    val rr:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val rhs: isa.Operand = rr.ok;

    var first:  isa.Operand = lhs;
    var second: isa.Operand = rhs;
    if (float_cmp_swap(cc)) {
        first  = rhs;
        second = lhs;
    }

    val fr: res[i32, fail.Fail] = float_reg_operand(st, first, float_scratch0(), w);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val first_reg: i32                         = fr.ok;
    val sr:        res[isa.Operand, fail.Fail] = float_src_operand(st, second, float_scratch1(), w);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val second_op: isa.Operand = sr.ok;

    var ucom: isa.Inst = isa.inst_blank();
    ucom.opcode = x64.UCOMISD;
    if (w == 4) { ucom.opcode = x64.UCOMISS; }
    ucom.dst  = isa.make_reg(first_reg, 16);
    ucom.src1 = second_op;
    ucom.size = w;
    val ue: err[fail.Fail] = encode_inst_sym(st, ?ucom);
    if (sel ue.err) { ret ue; }

    var setcc: isa.Inst = isa.inst_blank();
    setcc.opcode   = float_setcc_opcode(cc);
    setcc.dst      = dst;
    setcc.dst.size = 1;
    setcc.size     = 1;
    val fp: err[fail.Fail] = flags_pair(ucom.opcode, setcc.opcode);
    if (sel fp.err) { ret fp; }
    encode_inst(?setcc, buf);

    if (cc == mir.FCC_EQ || cc == mir.FCC_NE) {
        var par: isa.Inst = isa.inst_blank();
        par.opcode = x64.SETNP;
        if (cc == mir.FCC_NE) { par.opcode = x64.SETP; }
        par.dst      = isa.make_reg(x64.R11, 1);
        par.dst.size = 1;
        par.size     = 1;
        # the parity read follows the first setcc, which keeps the flags
        val fk: err[fail.Fail] = flags_kept(setcc.opcode);
        if (sel fk.err) { ret fk; }
        val fp2: err[fail.Fail] = flags_pair(ucom.opcode, par.opcode);
        if (sel fp2.err) { ret fp2; }
        encode_inst(?par, buf);

        var comb: isa.Inst = isa.inst_blank();
        comb.opcode = x64.AND;
        if (cc == mir.FCC_NE) { comb.opcode = x64.OR; }
        comb.dst      = dst;
        comb.dst.size = 1;
        comb.src1     = isa.make_reg(x64.R11, 1);
        comb.size     = 1;
        encode_inst(?comb, buf);
    }

    var movzx: isa.Inst = isa.inst_blank();
    movzx.opcode    = x64.MOVZX;
    movzx.dst       = dst;
    movzx.dst.size  = DEFAULT_OPERAND_SIZE;
    movzx.src1      = dst;
    movzx.src1.size = 1;
    movzx.size      = DEFAULT_OPERAND_SIZE;
    movzx.flags     = x64.FLAG_REX_W;
    encode_inst(?movzx, buf);

    ret err[fail.Fail].ok{};
}

# the mandatory prefix of a packed opcode, 0 for none
fun packed_prefix(op: u16) u8 {
    if (op == x64.ADDPS || op == x64.SUBPS || op == x64.MULPS || op == x64.DIVPS) { ret 0; }
    if (op == x64.CMPPS || op == x64.MOVUPS)                                      { ret 0; }
    if (op == x64.CVTDQ2PS || op == x64.CVTPS2PD)                                 { ret 0; }
    if (op == x64.CVTTPS2DQ || op == x64.CVTDQ2PD)                                { ret 0xF3; }
    ret 0x66;
}

# the modrm reg digit of an immediate packed shift
fun packed_shift_digit(op: u16) u8 {
    if (op == x64.PSRAW || op == x64.PSRAD)                    { ret 4; }
    if (op == x64.PSRLDQ)                                      { ret 3; }
    if (op == x64.PSRLW || op == x64.PSRLD || op == x64.PSRLQ) { ret 2; }
    ret 6;
}

# the opcode byte of a packed shift whose count is an xmm register's low
# quadword; absent for an opcode with no such form
fun packed_shift_count_opbyte(op: u16) opt[u8] {
    if (op == x64.PSRLW) { ret opt[u8].some{0xD1}; }
    if (op == x64.PSRLD) { ret opt[u8].some{0xD2}; }
    if (op == x64.PSRLQ) { ret opt[u8].some{0xD3}; }
    if (op == x64.PSRAW) { ret opt[u8].some{0xE1}; }
    if (op == x64.PSRAD) { ret opt[u8].some{0xE2}; }
    if (op == x64.PSLLW) { ret opt[u8].some{0xF1}; }
    if (op == x64.PSLLD) { ret opt[u8].some{0xF2}; }
    if (op == x64.PSLLQ) { ret opt[u8].some{0xF3}; }
    ret opt[u8].none{};
}

# the packed SSE2 opcode byte, absent for an x64.Opcode outside the packed set
fun packed_opbyte(op: u16) opt[u8] {
    if (op == x64.ADDPS || op == x64.ADDPD)                     { ret opt[u8].some{0x58}; }
    if (op == x64.SUBPS || op == x64.SUBPD)                     { ret opt[u8].some{0x5C}; }
    if (op == x64.MULPS || op == x64.MULPD)                     { ret opt[u8].some{0x59}; }
    if (op == x64.DIVPS || op == x64.DIVPD)                     { ret opt[u8].some{0x5E}; }
    if (op == x64.PADDB)                                        { ret opt[u8].some{0xFC}; }
    if (op == x64.PADDW)                                        { ret opt[u8].some{0xFD}; }
    if (op == x64.PADDD)                                        { ret opt[u8].some{0xFE}; }
    if (op == x64.PADDQ)                                        { ret opt[u8].some{0xD4}; }
    if (op == x64.PSUBB)                                        { ret opt[u8].some{0xF8}; }
    if (op == x64.PSUBW)                                        { ret opt[u8].some{0xF9}; }
    if (op == x64.PSUBD)                                        { ret opt[u8].some{0xFA}; }
    if (op == x64.PSUBQ)                                        { ret opt[u8].some{0xFB}; }
    if (op == x64.PSUBUSB)                                      { ret opt[u8].some{0xD8}; }
    if (op == x64.PSUBUSW)                                      { ret opt[u8].some{0xD9}; }
    if (op == x64.PMULLW)                                       { ret opt[u8].some{0xD5}; }
    if (op == x64.PMULHW)                                       { ret opt[u8].some{0xE5}; }
    if (op == x64.PMULHUW)                                      { ret opt[u8].some{0xE4}; }
    if (op == x64.PMULUDQ)                                      { ret opt[u8].some{0xF4}; }
    if (op == x64.PAND)                                         { ret opt[u8].some{0xDB}; }
    if (op == x64.POR)                                          { ret opt[u8].some{0xEB}; }
    if (op == x64.PXOR)                                         { ret opt[u8].some{0xEF}; }
    if (op == x64.CMPPS || op == x64.CMPPD)                     { ret opt[u8].some{0xC2}; }
    if (op == x64.PCMPEQB)                                      { ret opt[u8].some{0x74}; }
    if (op == x64.PCMPEQW)                                      { ret opt[u8].some{0x75}; }
    if (op == x64.PCMPEQD)                                      { ret opt[u8].some{0x76}; }
    if (op == x64.PCMPGTB)                                      { ret opt[u8].some{0x64}; }
    if (op == x64.PCMPGTW)                                      { ret opt[u8].some{0x65}; }
    if (op == x64.PCMPGTD)                                      { ret opt[u8].some{0x66}; }
    if (op == x64.PSHUFD)                                       { ret opt[u8].some{0x70}; }
    if (op == x64.PSLLD || op == x64.PSRLD)                     { ret opt[u8].some{0x72}; }
    if (op == x64.PSLLW || op == x64.PSRAW || op == x64.PSRLW)  { ret opt[u8].some{0x71}; }
    if (op == x64.PSRAD)                                        { ret opt[u8].some{0x72}; }
    if (op == x64.PUNPCKLBW)                                    { ret opt[u8].some{0x60}; }
    if (op == x64.PUNPCKLWD)                                    { ret opt[u8].some{0x61}; }
    if (op == x64.PUNPCKLDQ)                                    { ret opt[u8].some{0x62}; }
    if (op == x64.PUNPCKHBW)                                    { ret opt[u8].some{0x68}; }
    if (op == x64.PUNPCKHWD)                                    { ret opt[u8].some{0x69}; }
    if (op == x64.PUNPCKHDQ)                                    { ret opt[u8].some{0x6A}; }
    if (op == x64.PSRLDQ || op == x64.PSRLQ || op == x64.PSLLQ) { ret opt[u8].some{0x73}; }
    if (op == x64.PACKSSWB)                                     { ret opt[u8].some{0x63}; }
    if (op == x64.PACKSSDW)                                     { ret opt[u8].some{0x6B}; }
    if (op == x64.CVTDQ2PS)                                     { ret opt[u8].some{0x5B}; }
    if (op == x64.CVTTPS2DQ)                                    { ret opt[u8].some{0x5B}; }
    if (op == x64.CVTDQ2PD)                                     { ret opt[u8].some{0xE6}; }
    if (op == x64.CVTTPD2DQ)                                    { ret opt[u8].some{0xE6}; }
    if (op == x64.CVTPS2PD)                                     { ret opt[u8].some{0x5A}; }
    if (op == x64.CVTPD2PS)                                     { ret opt[u8].some{0x5A}; }
    ret opt[u8].none{};
}

fun vec_reg(xmm: i32) isa.Operand {
    ret isa.make_reg(xmm, 16);
}

fun note_packed(buf: *enc.ByteBuf, start: usize, opcode: u16, dst: isa.Operand, src: isa.Operand) {
    if (!enc.sink_active(buf)) { ret; }
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = dst;
    mi.src1   = src;
    mi.size   = 16;
    printer.note_inst(buf, ?mi, start);
}

fun note_packed_imm(buf: *enc.ByteBuf, start: usize, opcode: u16, dst: isa.Operand, src: isa.Operand, imm: u8) {
    if (!enc.sink_active(buf)) { ret; }
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = opcode;
    mi.dst    = dst;
    mi.src1   = src;
    mi.src2   = isa.make_imm(imm::i64, 1);
    mi.size   = 16;
    printer.note_inst(buf, ?mi, start);
}

# an x64.Opcode no packed row names is a member the selector produced outside
# the packed SSE2 catalog: internal. no diagnostic owner reaches this depth, so
# the text names the catalog and the surrounding function names the site
val PACKED_OPCODE_UNKNOWN: str = "encode: x64.Opcode outside the packed SSE2 catalog";

fun emit_packed_op(op: u16, dst_xmm: i32, src: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    val start: usize          = buf.len;
    val body:  err[fail.Fail] = emit_packed_body(op, dst_xmm, src, buf);
    if (sel body.err) { ret body; }
    note_packed(buf, start, op, vec_reg(dst_xmm), src);
    ret err[fail.Fail].ok{};
}

fun emit_packed_imm(op: u16, dst_xmm: i32, src: isa.Operand, imm: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    val start: usize          = buf.len;
    val body:  err[fail.Fail] = emit_packed_body(op, dst_xmm, src, buf);
    if (sel body.err) { ret body; }
    enc.emit_byte(buf, imm);
    note_packed_imm(buf, start, op, vec_reg(dst_xmm), src, imm);
    ret err[fail.Fail].ok{};
}

fun emit_packed_rri(op: u16, dst_xmm: i32, src_xmm: i32, imm: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    ret emit_packed_imm(op, dst_xmm, vec_reg(src_xmm), imm, buf);
}

# prefix, 0F, opcode byte and modrm of a packed op whose source is a register or memory
fun emit_packed_body(op: u16, dst_xmm: i32, src: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    var prefix: u8      = packed_prefix(op);
    var map:    u8      = 0;
    var byte:   u8      = 0;
    val opbyte: opt[u8] = packed_opbyte(op);
    if (sel opbyte.some)                           { byte = opbyte.some; }
    or (!mapped_opbytes(op, ?prefix, ?map, ?byte)) { ret err[fail.Fail].err{fail.message(PACKED_OPCODE_UNKNOWN)}; }
    if (src.kind != isa.OPK_REG && src.kind != isa.OPK_MEM) {
        ret err[fail.Fail].err{fail.message("encode: packed vector op source is not a register or aligned frame slot")};
    }
    emit_sse_map_rm(prefix, map, byte, dst_xmm, src, buf);
    ret err[fail.Fail].ok{};
}

# the mandatory prefix, the 0F 38 or 0F 3A map byte and the opcode byte of an
# ssse3, sse41, sha, aes or pclmul row; false for an opcode outside those maps
fun mapped_opbytes(op: u16, prefix: *u8, map: *u8, opbyte: *u8) bool {
    @prefix = 0x66;
    @map    = 0x38;
    if (op == x64.SHA256RNDS2 || op == x64.SHA256MSG1 || op == x64.SHA256MSG2) { @prefix = 0; }
    if (op == x64.SHA256RNDS2)                                                 { @opbyte = 0xCB; }
    or (op == x64.SHA256MSG1)                                                  { @opbyte = 0xCC; }
    or (op == x64.SHA256MSG2)                                                  { @opbyte = 0xCD; }
    or (op == x64.PSHUFB)                                                      { @opbyte = 0x00; }
    or (op == x64.PMULLD)                                                      { @opbyte = 0x40; }
    or (op == x64.PMOVSXBW)                                                    { @opbyte = 0x20; }
    or (op == x64.PMOVSXWD)                                                    { @opbyte = 0x23; }
    or (op == x64.PMOVSXDQ)                                                    { @opbyte = 0x25; }
    or (op == x64.PMOVZXBW)                                                    { @opbyte = 0x30; }
    or (op == x64.PMOVZXWD)                                                    { @opbyte = 0x33; }
    or (op == x64.PMOVZXDQ)                                                    { @opbyte = 0x35; }
    or (op == x64.PTEST)                                                       { @opbyte = 0x17; }
    or (op == x64.AESIMC)                                                      { @opbyte = 0xDB; }
    or (op == x64.AESENC)                                                      { @opbyte = 0xDC; }
    or (op == x64.AESENCLAST)                                                  { @opbyte = 0xDD; }
    or (op == x64.AESDEC)                                                      { @opbyte = 0xDE; }
    or (op == x64.AESDECLAST)                                                  { @opbyte = 0xDF; }
    or {
        @map = 0x3A;
        if (op == x64.PALIGNR)         { @opbyte = 0x0F; }
        or (op == x64.PBLENDW)         { @opbyte = 0x0E; }
        or (op == x64.PINSRD)          { @opbyte = 0x22; }
        or (op == x64.PEXTRD)          { @opbyte = 0x16; }
        or (op == x64.PCLMULQDQ)       { @opbyte = 0x44; }
        or (op == x64.AESKEYGENASSIST) { @opbyte = 0xDF; }
        or                             { ret false; }
    }
    ret true;
}

# one legacy-prefixed 0F-map instruction with a register reg field and a register or memory rm
fun emit_sse_rm(prefix: u8, opbyte: u8, reg: i32, rm: isa.Operand, buf: *enc.ByteBuf) {
    emit_sse_map_rm(prefix, 0, opbyte, reg, rm, buf);
}

# as emit_sse_rm, with a 0F 38 or 0F 3A escape when `map` is nonzero
fun emit_sse_map_rm(prefix: u8, map: u8, opbyte: u8, reg: i32, rm: isa.Operand, buf: *enc.ByteBuf) {
    val seg: u8 = segment_prefix(?rm);
    if (seg != 0)               { enc.emit_byte(buf, seg); }
    if (prefix != 0)            { enc.emit_byte(buf, prefix); }
    if (rm.kind == isa.OPK_REG) { emit_rex_if_needed(buf, 0, reg, rm.reg); }
    or                          { emit_rex_mem(buf, 0, reg, ?rm); }
    enc.emit_byte(buf, 0x0F);
    if (map != 0) { enc.emit_byte(buf, map); }
    enc.emit_byte(buf, opbyte);
    if (rm.kind == isa.OPK_REG) { enc.emit_byte(buf, encode_modrm(3, reg_bits(reg), reg_bits(rm.reg))); }
    or                          { encode_mem_operand(buf, reg, ?rm); }
}

# the mandatory prefix and the load and store opcode bytes of a packed move
fun vec_move_bytes(op: u16, prefix: *u8, load: *u8, store: *u8) bool {
    @prefix = 0;
    if (op == x64.MOVAPS) {
        @load  = 0x28;
        @store = 0x29;
        ret true;
    }
    if (op == x64.MOVUPS) {
        @load  = 0x10;
        @store = 0x11;
        ret true;
    }
    if (op == x64.MOVDQA) { @prefix = 0x66; }
    or (op == x64.MOVDQU) { @prefix = 0xF3; }
    or                    { ret false; }
    @load  = 0x6F;
    @store = 0x7F;
    ret true;
}

# a packed move between a vector register and a vector register or memory, in either direction
fun emit_vec_move(op: u16, dst: isa.Operand, src: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    var prefix: u8 = 0;
    var load:   u8 = 0;
    var store:  u8 = 0;
    if (!vec_move_bytes(op, ?prefix, ?load, ?store)) { ret err[fail.Fail].err{fail.message(PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = buf.len;
    if (dst.kind == isa.OPK_REG && (src.kind == isa.OPK_REG || src.kind == isa.OPK_MEM)) {
        emit_sse_rm(prefix, load, dst.reg, src, buf);
    }
    or (dst.kind == isa.OPK_MEM && src.kind == isa.OPK_REG) {
        emit_sse_rm(prefix, store, src.reg, dst, buf);
    }
    or { ret err[fail.Fail].err{fail.message("encode: packed vector move needs a vector register on one side")}; }
    note_packed(buf, start, op, dst, src);
    ret err[fail.Fail].ok{};
}

fun emit_packed_shift_imm(op: u16, xmm: i32, imm: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    val opbyte: opt[u8] = packed_opbyte(op);
    if (sel opbyte.none) { ret err[fail.Fail].err{fail.message(PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = buf.len;
    enc.emit_byte(buf, 0x66);
    if (needs_rex(xmm)) { enc.emit_byte(buf, encode_rex(0, 0, xmm)); }
    enc.emit_byte(buf, 0x0F);
    enc.emit_byte(buf, opbyte.some);
    enc.emit_byte(buf, encode_modrm(3, packed_shift_digit(op), reg_bits(xmm)));
    enc.emit_byte(buf, imm);
    note_packed(buf, start, op, vec_reg(xmm), isa.make_imm(imm::i64, 1));
    ret err[fail.Fail].ok{};
}

fun emit_movaps_rr(dst_xmm: i32, src_xmm: i32, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    emit_sse_rm(0, 0x28, dst_xmm, vec_reg(src_xmm), buf);
    note_packed(buf, start, x64.MOVAPS, vec_reg(dst_xmm), vec_reg(src_xmm));
}

fun emit_movups_load(xmm: i32, mem: isa.Operand, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    emit_sse_rm(0, 0x10, xmm, mem, buf);
    note_packed(buf, start, x64.MOVUPS, vec_reg(xmm), mem);
}

fun emit_movups_store(mem: isa.Operand, xmm: i32, buf: *enc.ByteBuf) {
    val start: usize = buf.len;
    emit_sse_rm(0, 0x11, xmm, mem, buf);
    note_packed(buf, start, x64.MOVUPS, mem, vec_reg(xmm));
}

fun emit_vec_load(op: isa.Operand, xmm: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    if (op.kind == isa.OPK_REG) {
        emit_movaps_rr(xmm, op.reg, buf);
        ret err[fail.Fail].ok{};
    }
    if (op.kind == isa.OPK_MEM) {
        var ld: isa.Inst = isa.inst_blank();
        ld.opcode = x64.MOVAPS;
        ld.dst    = isa.make_reg(xmm, 16);
        ld.src1   = op;
        ld.size   = 16;
        encode_inst(?ld, buf);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: vector operand is not a register or aligned frame slot")};
}

fun emit_vec_store(dst: isa.Operand, xmm: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    if (dst.kind == isa.OPK_REG) {
        emit_movaps_rr(dst.reg, xmm, buf);
        ret err[fail.Fail].ok{};
    }
    if (dst.kind == isa.OPK_MEM) {
        var st: isa.Inst = isa.inst_blank();
        st.opcode = x64.MOVAPS;
        st.dst    = dst;
        st.src1   = isa.make_reg(xmm, 16);
        st.size   = 16;
        encode_inst(?st, buf);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: vector destination is not a register or aligned frame slot")};
}

fun emit_vec_all_ones(xmm: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    ret emit_packed_op(x64.PCMPEQD, xmm, vec_reg(xmm), buf);
}

fun emit_vec_zero(xmm: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    ret emit_packed_op(x64.PXOR, xmm, vec_reg(xmm), buf);
}

# the selection opcodes the vector encoder packs; false for every other
# opcode (a partition, enumerated by its test)
fun is_selected_vector_alu(o: mir.MirOpcode) bool {
    if (o == mir.MIR_NOT)                                                     { ret true; }
    if (o == mir.MIR_SEL_ADD || o == mir.MIR_SEL_SUB || o == mir.MIR_SEL_MUL) { ret true; }
    if (o == mir.MIR_SEL_DIV_S || o == mir.MIR_SEL_DIV_U ||
        o == mir.MIR_SEL_REM_S || o == mir.MIR_SEL_REM_U) { ret true; }
    if (o == mir.MIR_SEL_AND || o == mir.MIR_SEL_OR || o == mir.MIR_SEL_XOR)      { ret true; }
    if (o == mir.MIR_SEL_SHL || o == mir.MIR_SEL_SHR_S || o == mir.MIR_SEL_SHR_U) { ret true; }
    if (o == mir.MIR_SEL_CMP_EQ || o == mir.MIR_SEL_CMP_NE ||
        o == mir.MIR_SEL_CMP_LT_S || o == mir.MIR_SEL_CMP_LT_U ||
        o == mir.MIR_SEL_CMP_LE_S || o == mir.MIR_SEL_CMP_LE_U) { ret true; }
    ret false;
}

fun punpckl_op(w: u8) u16 {
    if (w == 1) { ret x64.PUNPCKLBW; }
    if (w == 2) { ret x64.PUNPCKLWD; }
    ret x64.PUNPCKLDQ;
}

# the work register holds the operand's lanes from here on; a sequence that has not read it yet copies it in
fun xconv_load(p: *convplan.Plan, loaded: *bool) {
    if (@loaded) { ret; }
    convplan.push(p, x64.MOVAPS::u32, convplan.PLACE_WORK, convplan.PLACE_OPERAND, 0);
    @loaded = true;
}

# one packed conversion instruction over the lanes, reading the operand itself when nothing has copied it yet
fun xconv_cvt(p: *convplan.Plan, loaded: *bool, op: u16) {
    var src: convplan.Place = convplan.PLACE_WORK;
    if (!@loaded) { src = convplan.PLACE_OPERAND; }
    convplan.push(p, op::u32, convplan.PLACE_WORK, src, 0);
    @loaded = true;
}

# widen the lanes from `from` to `to` bytes, doubling each step:
# the high half is the sign mask of a signed lane and zero otherwise
fun xconv_widen(p: *convplan.Plan, loaded: *bool, from: u8, to: u8, signed: bool) {
    xconv_load(p, loaded);
    var w: u8 = from;
    for (w < to) {
        convplan.push(p, x64.PXOR::u32, convplan.PLACE_TEMP, convplan.PLACE_TEMP, 0);
        if (signed) { convplan.push(p, pcmpgt_op(w)::u32, convplan.PLACE_TEMP, convplan.PLACE_WORK, 0); }
        convplan.push(p, punpckl_op(w)::u32, convplan.PLACE_WORK, convplan.PLACE_TEMP, 0);
        w = w * 2;
    }
}

# truncate the lanes from `from` to `to` bytes, halving each step:
# a quadword keeps its low doubleword by shuffle, and a narrower lane is
# sign-folded from its low half so the saturating pack keeps those bits exactly
fun xconv_narrow(p: *convplan.Plan, loaded: *bool, from: u8, to: u8) {
    xconv_load(p, loaded);
    var w: u8 = from;
    for (w > to) {
        if (w == 8) { convplan.push(p, x64.PSHUFD::u32, convplan.PLACE_WORK, convplan.PLACE_WORK, 0x08); }
        or {
            var left:  u16 = x64.PSLLD;
            var right: u16 = x64.PSRAD;
            var pack:  u16 = x64.PACKSSDW;
            var bits:  u32 = 16;
            if (w == 2) {
                left  = x64.PSLLW;
                right = x64.PSRAW;
                pack  = x64.PACKSSWB;
                bits  = 8;
            }
            convplan.push(p, left::u32, convplan.PLACE_WORK, convplan.PLACE_WORK, bits);
            convplan.push(p, right::u32, convplan.PLACE_WORK, convplan.PLACE_WORK, bits);
            convplan.push(p, pack::u32, convplan.PLACE_WORK, convplan.PLACE_WORK, 0);
        }
        w = w / 2;
    }
}

# the packed conversion sequence, for the cells the x86_64 packed table
# declares; each one agrees bit for bit with the scalar conversion of a lane
fun xconv_plan(op: mir.MirOpcode, to_float: bool, to: u8, from_float: bool, from: u8) opt[convplan.Plan] {
    var p:      convplan.Plan = convplan.plan();
    var loaded: bool          = false;
    if (op == mir.MIR_SEXT || op == mir.MIR_ZEXT)       { xconv_widen(?p, ?loaded, from, to, op == mir.MIR_SEXT); }
    or (op == mir.MIR_TRUNC)                            { xconv_narrow(?p, ?loaded, from, to); }
    or (op == mir.MIR_FP_EXT && from == 4 && to == 8)   { xconv_cvt(?p, ?loaded, x64.CVTPS2PD); }
    or (op == mir.MIR_FP_TRUNC && from == 8 && to == 4) { xconv_cvt(?p, ?loaded, x64.CVTPD2PS); }
    or ((op == mir.MIR_SI_TO_FP || (op == mir.MIR_UI_TO_FP && from < 4)) && from <= 4 && !from_float && to_float) {
        if (from < 4) { xconv_widen(?p, ?loaded, from, 4, op == mir.MIR_SI_TO_FP); }
        var cvt: u16 = x64.CVTDQ2PS;
        if (to == 8) { cvt = x64.CVTDQ2PD; }
        xconv_cvt(?p, ?loaded, cvt);
    }
    or (op == mir.MIR_FP_TO_SI && from_float && !to_float && to <= 4) {
        var cvt: u16 = x64.CVTTPS2DQ;
        if (from == 8) { cvt = x64.CVTTPD2DQ; }
        xconv_cvt(?p, ?loaded, cvt);
        xconv_narrow(?p, ?loaded, 4, to);
    }
    or              { ret opt[convplan.Plan].none{}; }
    if (p.overflow) { ret opt[convplan.Plan].none{}; }
    ret opt[convplan.Plan].some{p};
}

fun xconv_place(place: convplan.Place, operand: isa.Operand, work: i32) isa.Operand {
    if (place == convplan.PLACE_OPERAND) { ret operand; }
    if (place == convplan.PLACE_WORK)    { ret vec_reg(work); }
    ret vec_reg(float_scratch1());
}

# emit a plan with the result forming in `work`, which the caller chose from the plan's alias property
fun emit_xconv(p: *convplan.Plan, operand: isa.Operand, work: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.len) {
        val step: convplan.Step  = p.steps[i];
        val op:   u16            = step.op::u16;
        val dst:  isa.Operand    = xconv_place(step.dst, operand, work);
        val src:  isa.Operand    = xconv_place(step.src, operand, work);
        var done: err[fail.Fail] = err[fail.Fail].ok{};
        if (dst.kind != isa.OPK_REG) { ret err[fail.Fail].err{fail.message("encode: packed conversion step writes its operand")}; }
        if (op == x64.MOVAPS) {
            if (src.kind != isa.OPK_REG || src.reg != dst.reg) { done = emit_vec_load(src, dst.reg, buf); }
        }
        or (op == x64.PSHUFD) {
            if (src.kind != isa.OPK_REG) { ret err[fail.Fail].err{fail.message("encode: packed conversion shuffle reads memory")}; }
            done = emit_packed_rri(op, dst.reg, src.reg, step.arg::u8, buf);
        }
        or (op == x64.PSLLW || op == x64.PSLLD || op == x64.PSRAW || op == x64.PSRAD) {
            done = emit_packed_shift_imm(op, dst.reg, step.arg::u8, buf);
        }
        or                { done = emit_packed_op(op, dst.reg, src, buf); }
        if (sel done.err) { ret done; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun encode_vector_convert(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: packed vector conversion missing operands")}; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val planned: opt[convplan.Plan] = xconv_plan(mi.opcode,
        mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT, mir.vec_lane_elem_bytes(mi.vec_lane),
        mir.vec_lane_from_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT, mir.vec_lane_from_bytes(mi.vec_lane));
    if (sel planned.none) { ret err[fail.Fail].err{fail.message("encode: vector conversion outside the x86_64 packed table")}; }
    var p: convplan.Plan = planned.some;
    ret emit_xconv_to(?p, rd.ok, rs.ok, buf);
}

# the result forms in the destination unless the destination is a frame slot or the scratch temporary,
# or aliases an operand the plan reads after writing; then it forms in scratch0 and is copied out
fun emit_xconv_to(p: *convplan.Plan, dst: isa.Operand, operand: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    val dst_is_reg: bool = dst.kind == isa.OPK_REG;
    val aliases:    bool = dst_is_reg && operand.kind == isa.OPK_REG && operand.reg == dst.reg;
    val is_temp:    bool = dst_is_reg && dst.reg == float_scratch1();
    var work:       i32  = float_scratch0();
    if (convplan.in_destination(p, dst_is_reg, aliases, is_temp)) { work = dst.reg; }
    val body: err[fail.Fail] = emit_xconv(p, operand, work, buf);
    if (sel body.err)                  { ret body; }
    if (dst_is_reg && dst.reg == work) { ret err[fail.Fail].ok{}; }
    ret emit_vec_store(dst, work, buf);
}

# the widening multiplies the x86_64 packed table declares, from the operand
# lane width: pmullw beside pmulhw or pmulhuw interleaved into doubled lanes,
# and pmuludq over 32-bit lanes spread onto the dwords it reads
fun emit_vec_widen_mul_body(signed: bool, from: u8, lhs: isa.Operand, rhs: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    val s0: i32 = float_scratch0();
    val s1: i32 = float_scratch1();
    if (from == 2) {
        var high: u16 = x64.PMULHUW;
        if (signed) { high = x64.PMULHW; }
        val l0: err[fail.Fail] = emit_vec_load(lhs, s0, buf);
        if (sel l0.err) { ret l0; }
        val l1: err[fail.Fail] = emit_vec_load(lhs, s1, buf);
        if (sel l1.err) { ret l1; }
        val lo: err[fail.Fail] = emit_packed_op(x64.PMULLW, s0, rhs, buf);
        if (sel lo.err) { ret lo; }
        val hi: err[fail.Fail] = emit_packed_op(high, s1, rhs, buf);
        if (sel hi.err) { ret hi; }
        ret emit_packed_op(x64.PUNPCKLWD, s0, vec_reg(s1), buf);
    }
    if (from == 4 && !signed) {
        val l0: err[fail.Fail] = emit_vec_load(lhs, s0, buf);
        if (sel l0.err) { ret l0; }
        val p0: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s0, s0, 0x50, buf);
        if (sel p0.err) { ret p0; }
        val l1: err[fail.Fail] = emit_vec_load(rhs, s1, buf);
        if (sel l1.err) { ret l1; }
        val p1: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s1, s1, 0x50, buf);
        if (sel p1.err) { ret p1; }
        ret emit_packed_op(x64.PMULUDQ, s0, vec_reg(s1), buf);
    }
    ret err[fail.Fail].err{fail.message("encode: widening multiply outside the x86_64 packed table")};
}

fun encode_vector_widen_mul(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed widening multiply missing operands")}; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rr: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], 16);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    if (mir.vec_lane_kind(mi.vec_lane) != mir.VEC_LANE_INT || mir.vec_lane_from_kind(mi.vec_lane) != mir.VEC_LANE_INT
        || mir.vec_lane_elem_bytes(mi.vec_lane) != mir.vec_lane_from_bytes(mi.vec_lane) * 2) {
        ret err[fail.Fail].err{fail.message("encode: widening multiply lanes are not integer lanes doubling in width")};
    }
    val body: err[fail.Fail] = emit_vec_widen_mul_body(mi.opcode == mir.MIR_MUL_WIDE_S,
        mir.vec_lane_from_bytes(mi.vec_lane), rl.ok, rr.ok, buf);
    if (sel body.err) { ret body; }
    ret emit_vec_store(rd.ok, float_scratch0(), buf);
}

fun punpckh_op(w: u8) u16 {
    if (w == 1) { ret x64.PUNPCKHBW; }
    if (w == 2) { ret x64.PUNPCKHWD; }
    ret x64.PUNPCKHDQ;
}

fun pmovsx_op(w: u8) u16 {
    if (w == 1) { ret x64.PMOVSXBW; }
    if (w == 2) { ret x64.PMOVSXWD; }
    ret x64.PMOVSXDQ;
}

fun pmovzx_op(w: u8) u16 {
    if (w == 1) { ret x64.PMOVZXBW; }
    if (w == 2) { ret x64.PMOVZXWD; }
    ret x64.PMOVZXDQ;
}

# the lane-halving extension the x86_64 packed table declares at every integer
# width (#3738): on the SSE2 baseline the half is unpacked against zero or
# against its own sign mask, low half through punpckl*, high half through
# punpckh*; under sse41 the high half is shifted down and either half is one
# pmovsx*/pmovzx*. the source is loaded into scratch0 and the result leaves it
fun emit_vec_widen_half_body(signed: bool, high: bool, from: u8, sse41: bool, src: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    val s0: i32            = float_scratch0();
    val s1: i32            = float_scratch1();
    val l0: err[fail.Fail] = emit_vec_load(src, s0, buf);
    if (sel l0.err) { ret l0; }
    if (sse41) {
        if (high) {
            val sh: err[fail.Fail] = emit_packed_shift_imm(x64.PSRLDQ, s0, 8, buf);
            if (sel sh.err) { ret sh; }
        }
        var ext: u16 = pmovzx_op(from);
        if (signed) { ext = pmovsx_op(from); }
        ret emit_packed_op(ext, s0, vec_reg(s0), buf);
    }
    val z: err[fail.Fail] = emit_packed_op(x64.PXOR, s1, vec_reg(s1), buf);
    if (sel z.err) { ret z; }
    if (signed) {
        val m: err[fail.Fail] = emit_packed_op(pcmpgt_op(from), s1, vec_reg(s0), buf);
        if (sel m.err) { ret m; }
    }
    var unpack: u16 = punpckl_op(from);
    if (high) { unpack = punpckh_op(from); }
    ret emit_packed_op(unpack, s0, vec_reg(s1), buf);
}

fun encode_vector_widen_half(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: lane-halving extension missing operands")}; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    if (mi.operands[2].kind != mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension base is not an immediate")};
    }
    val from:  u8  = mir.vec_lane_from_bytes(mi.vec_lane);
    val lanes: u32 = mir.vec_lane_count(mi.vec_lane);
    if (mir.vec_lane_kind(mi.vec_lane) != mir.VEC_LANE_INT || mir.vec_lane_from_kind(mi.vec_lane) != mir.VEC_LANE_INT
        || mir.vec_lane_elem_bytes(mi.vec_lane) != from * 2 || from > 4) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension lanes are not integer lanes doubling in width")};
    }
    val base: i64 = mi.operands[2].imm;
    if (base != 0 && base != lanes::i64) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension base names neither half")};
    }
    val sse41: bool           = (st.model.extensions & x64.EXT_SSE41) != 0;
    val body:  err[fail.Fail] = emit_vec_widen_half_body(mi.opcode == mir.MIR_VEC_WIDEN_S, base != 0, from, sse41, rs.ok, ?st.buf);
    if (sel body.err) { ret body; }
    ret emit_vec_store(rd.ok, float_scratch0(), ?st.buf);
}

fun encode_vector_op(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    val o:   mir.MirOpcode = mi.opcode;
    val buf: *enc.ByteBuf  = ?st.buf;
    if (o == mir.MIR_NOT) { ret encode_vector_not(f, mi, buf); }
    if (o == mir.MIR_SEL_CMP_EQ || o == mir.MIR_SEL_CMP_NE ||
        o == mir.MIR_SEL_CMP_LT_S || o == mir.MIR_SEL_CMP_LT_U ||
        o == mir.MIR_SEL_CMP_LE_S || o == mir.MIR_SEL_CMP_LE_U) { ret encode_vector_compare(f, mi, buf); }
    if (o == mir.MIR_SEL_ADD || o == mir.MIR_SEL_SUB || o == mir.MIR_SEL_MUL ||
        o == mir.MIR_SEL_DIV_S || o == mir.MIR_SEL_DIV_U ||
        o == mir.MIR_SEL_AND || o == mir.MIR_SEL_OR || o == mir.MIR_SEL_XOR) { ret encode_vector_arith(st, f, mi); }
    if (o == mir.MIR_SEL_SHL || o == mir.MIR_SEL_SHR_U || o == mir.MIR_SEL_SHR_S) { ret encode_vector_shift(f, mi, buf); }
    ret err[fail.Fail].err{fail.message("encode: unsupported vector operation on x86_64 (no packed SSE2 selection)")};
}

# the SSE2 shift of a lane width by one count for every lane; 0xFFFF where the
# baseline has none (8-bit lanes, and the 64-bit arithmetic shift)
fun packed_shift_opcode(op: mir.MirOpcode, eb: u8) u16 {
    if (op == mir.MIR_SEL_SHL) {
        if (eb == 2) { ret x64.PSLLW; }
        if (eb == 4) { ret x64.PSLLD; }
        if (eb == 8) { ret x64.PSLLQ; }
    }
    if (op == mir.MIR_SEL_SHR_U) {
        if (eb == 2) { ret x64.PSRLW; }
        if (eb == 4) { ret x64.PSRLD; }
        if (eb == 8) { ret x64.PSRLQ; }
    }
    if (op == mir.MIR_SEL_SHR_S) {
        if (eb == 2) { ret x64.PSRAW; }
        if (eb == 4) { ret x64.PSRAD; }
    }
    ret 0xFFFF;
}

# a count by register is the low quadword of an xmm register, so the count is
# zero-extended from its lane width into scratch1 first; a count at or above
# the lane width then empties the lane, or fills it with the sign, as the
# scalar shift does (#3756). an immediate count saturates the same way from
# 16 up, so any constant outside the lane width is spelled 255
fun encode_vector_shift(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed vector shift missing operands")}; }
    val eb:  u8  = mir.vec_lane_elem_bytes(mi.vec_lane);
    val opc: u16 = packed_shift_opcode(mi.opcode, eb);
    if (mir.vec_lane_kind(mi.vec_lane) != mir.VEC_LANE_INT || opc == 0xFFFF) {
        ret err[fail.Fail].err{fail.message("encode: vector shift lane outside the x86_64 packed table")};
    }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rc: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], eb);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val dst:   isa.Operand = rd.ok;
    val lhs:   isa.Operand = rl.ok;
    val count: isa.Operand = rc.ok;
    if (count.kind == isa.OPK_REG && isa.regid_class(count.reg) != isa.REG_CLASS_ID_GP) {
        ret err[fail.Fail].err{fail.message("encode: a per-lane vector shift count has no packed SSE2 form")};
    }
    if (count.kind != isa.OPK_IMM) {
        val lc: err[fail.Fail] = emit_shift_count(count, eb, float_scratch1(), buf);
        if (sel lc.err) { ret lc; }
    }
    var work: i32 = float_scratch0();
    if (dst.kind == isa.OPK_REG) { work = dst.reg; }
    if (!(lhs.kind == isa.OPK_REG && lhs.reg == work)) {
        val ll: err[fail.Fail] = emit_vec_load(lhs, work, buf);
        if (sel ll.err) { ret ll; }
    }
    var sh: err[fail.Fail] = err[fail.Fail].ok{};
    if (count.kind == isa.OPK_IMM) {
        var imm: i64 = count.imm;
        if (imm < 0 || imm >= eb::i64 * 8) { imm = 255; }
        sh = emit_packed_shift_imm(opc, work, imm::u8, buf);
    }
    or                                              { sh = emit_packed_shift_by(opc, work, float_scratch1(), buf); }
    if (sel sh.err)                                 { ret sh; }
    if (dst.kind == isa.OPK_REG && dst.reg == work) { ret err[fail.Fail].ok{}; }
    ret emit_vec_store(dst, work, buf);
}

# the count of `eb` bytes in a general register or frame slot, zero-extended
# into the whole of `xmm`: movd or movq straight from a 32- or 64-bit
# register, and through the scratch register from anything narrower or in memory
fun emit_shift_count(count: isa.Operand, eb: u8, xmm: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    var mw: u8 = 4;
    if (eb == 8) { mw = 8; }
    if (count.kind == isa.OPK_REG && eb >= 4) {
        emit_movd_movq_reg(count.reg, xmm, mw, true, buf);
        ret err[fail.Fail].ok{};
    }
    val ld: err[fail.Fail] = emit_gp_load_ext(count, x64.SCRATCH_REG, eb, false, buf);
    if (sel ld.err) { ret ld; }
    emit_movd_movq_reg(x64.SCRATCH_REG, xmm, mw, true, buf);
    ret err[fail.Fail].ok{};
}

# a packed shift of `xmm` by the count in the low quadword of `count_xmm`
fun emit_packed_shift_by(op: u16, xmm: i32, count_xmm: i32, buf: *enc.ByteBuf) err[fail.Fail] {
    val opbyte: opt[u8] = packed_shift_count_opbyte(op);
    if (sel opbyte.none) { ret err[fail.Fail].err{fail.message(PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = buf.len;
    emit_sse_rm(0x66, opbyte.some, xmm, vec_reg(count_xmm), buf);
    note_packed(buf, start, op, vec_reg(xmm), vec_reg(count_xmm));
    ret err[fail.Fail].ok{};
}

fun packed_arith_opcode(op: mir.MirOpcode, vec_lane: u32) u16 {
    val is_float: bool = mir.vec_lane_kind(vec_lane) == mir.VEC_LANE_FLOAT;
    val eb:       u8   = mir.vec_lane_elem_bytes(vec_lane);
    if (op == mir.MIR_SEL_AND) { ret x64.PAND; }
    if (op == mir.MIR_SEL_OR)  { ret x64.POR; }
    if (op == mir.MIR_SEL_XOR) { ret x64.PXOR; }
    if (op == mir.MIR_SEL_ADD) {
        if (is_float) {
            if (eb == 4) { ret x64.ADDPS; }
            ret x64.ADDPD;
        }
        if (eb == 1) { ret x64.PADDB; }
        if (eb == 2) { ret x64.PADDW; }
        if (eb == 4) { ret x64.PADDD; }
        ret x64.PADDQ;
    }
    if (op == mir.MIR_SEL_SUB) {
        if (is_float) {
            if (eb == 4) { ret x64.SUBPS; }
            ret x64.SUBPD;
        }
        if (eb == 1) { ret x64.PSUBB; }
        if (eb == 2) { ret x64.PSUBW; }
        if (eb == 4) { ret x64.PSUBD; }
        ret x64.PSUBQ;
    }
    if (op == mir.MIR_SEL_MUL) {
        if (is_float) {
            if (eb == 4) { ret x64.MULPS; }
            ret x64.MULPD;
        }
        if (eb == 2) { ret x64.PMULLW; }
    }
    if (op == mir.MIR_SEL_DIV_U || op == mir.MIR_SEL_DIV_S) {
        if (is_float) {
            if (eb == 4) { ret x64.DIVPS; }
            ret x64.DIVPD;
        }
    }
    ret 0xFFFF;
}

# the low multiply of 32-bit lanes on the SSE2 baseline: pmuludq multiplies
# the low dword of each qword, so the even lanes multiply in place and the odd
# lanes after a shuffle into the low dwords, and the two qword products are
# narrowed back and interleaved. both scratch registers, the operands re-read
# as sources, the destination written last
fun emit_vec_mul_i32_body(lhs: isa.Operand, rhs: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    val s0: i32            = float_scratch0();
    val s1: i32            = float_scratch1();
    val o0: err[fail.Fail] = emit_packed_imm(x64.PSHUFD, s1, lhs, 0xF5, buf);
    if (sel o0.err) { ret o0; }
    val o1: err[fail.Fail] = emit_packed_imm(x64.PSHUFD, s0, rhs, 0xF5, buf);
    if (sel o1.err) { ret o1; }
    val o2: err[fail.Fail] = emit_packed_op(x64.PMULUDQ, s1, vec_reg(s0), buf);
    if (sel o2.err) { ret o2; }
    val e0: err[fail.Fail] = emit_vec_load(lhs, s0, buf);
    if (sel e0.err) { ret e0; }
    val e1: err[fail.Fail] = emit_packed_op(x64.PMULUDQ, s0, rhs, buf);
    if (sel e1.err) { ret e1; }
    val n0: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s0, s0, 0x08, buf);
    if (sel n0.err) { ret n0; }
    val n1: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s1, s1, 0x08, buf);
    if (sel n1.err) { ret n1; }
    ret emit_packed_op(x64.PUNPCKLDQ, s0, vec_reg(s1), buf);
}

# the low multiply of 64-bit lanes on the SSE2 baseline: the two cross terms
# hi(a)*lo(b) and lo(a)*hi(b) summed and shifted up by 32, plus lo(a)*lo(b),
# three pmuludq in all
fun emit_vec_mul_i64_body(lhs: isa.Operand, rhs: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    val s0: i32            = float_scratch0();
    val s1: i32            = float_scratch1();
    val h0: err[fail.Fail] = emit_vec_load(lhs, s0, buf);
    if (sel h0.err) { ret h0; }
    val h1: err[fail.Fail] = emit_packed_shift_imm(x64.PSRLQ, s0, 32, buf);
    if (sel h1.err) { ret h1; }
    val h2: err[fail.Fail] = emit_packed_op(x64.PMULUDQ, s0, rhs, buf);
    if (sel h2.err) { ret h2; }
    val g0: err[fail.Fail] = emit_vec_load(rhs, s1, buf);
    if (sel g0.err) { ret g0; }
    val g1: err[fail.Fail] = emit_packed_shift_imm(x64.PSRLQ, s1, 32, buf);
    if (sel g1.err) { ret g1; }
    val g2: err[fail.Fail] = emit_packed_op(x64.PMULUDQ, s1, lhs, buf);
    if (sel g2.err) { ret g2; }
    val a0: err[fail.Fail] = emit_packed_op(x64.PADDQ, s0, vec_reg(s1), buf);
    if (sel a0.err) { ret a0; }
    val a1: err[fail.Fail] = emit_packed_shift_imm(x64.PSLLQ, s0, 32, buf);
    if (sel a1.err) { ret a1; }
    val l0: err[fail.Fail] = emit_vec_load(lhs, s1, buf);
    if (sel l0.err) { ret l0; }
    val l1: err[fail.Fail] = emit_packed_op(x64.PMULUDQ, s1, rhs, buf);
    if (sel l1.err) { ret l1; }
    ret emit_packed_op(x64.PADDQ, s0, vec_reg(s1), buf);
}

# the integer multiplies the packed table declares without a single baseline
# instruction: 32-bit lanes are pmulld when the declared set holds sse41 and
# the pmuludq pair otherwise, 64-bit lanes the three-pmuludq sequence (#3739)
fun emit_vec_mul_sequence(sse41: bool, eb: u8, dst: isa.Operand, lhs: isa.Operand, rhs: isa.Operand, buf: *enc.ByteBuf) err[fail.Fail] {
    if (eb == 4 && sse41) {
        val ll: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
        if (sel ll.err) { ret ll; }
        val ro: err[fail.Fail] = emit_packed_op(x64.PMULLD, float_scratch0(), rhs, buf);
        if (sel ro.err) { ret ro; }
    }
    or (eb == 4) {
        val body: err[fail.Fail] = emit_vec_mul_i32_body(lhs, rhs, buf);
        if (sel body.err) { ret body; }
    }
    or (eb == 8) {
        val body: err[fail.Fail] = emit_vec_mul_i64_body(lhs, rhs, buf);
        if (sel body.err) { ret body; }
    }
    or { ret err[fail.Fail].err{fail.message("encode: unsupported packed vector op / lane combination")}; }
    ret emit_vec_store(dst, float_scratch0(), buf);
}

fun encode_vector_arith(st: *enc.EncodeState, f: *mir.MirFunction, mi: *mir.MirInstr) err[fail.Fail] {
    val buf: *enc.ByteBuf = ?st.buf;
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed vector op missing operands")}; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rr: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], 16);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val dst: isa.Operand = rd.ok;
    val lhs: isa.Operand = rl.ok;
    val rhs: isa.Operand = rr.ok;

    if (mi.opcode == mir.MIR_SEL_MUL && mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_INT && mir.vec_lane_elem_bytes(mi.vec_lane) >= 4) {
        val sse41: bool = (st.model.extensions & x64.EXT_SSE41) != 0;
        ret emit_vec_mul_sequence(sse41, mir.vec_lane_elem_bytes(mi.vec_lane), dst, lhs, rhs, buf);
    }
    val opc: u16 = packed_arith_opcode(mi.opcode, mi.vec_lane);
    if (opc == 0xFFFF) { ret err[fail.Fail].err{fail.message("encode: unsupported packed vector op / lane combination")}; }

    # a register destination is the work register: the op runs in place when
    # the allocator tied it to the left operand, and otherwise after one copy
    # of the left operand, unless the right operand is the destination itself
    if (dst.kind == isa.OPK_REG && !(rhs.kind == isa.OPK_REG && rhs.reg == dst.reg && !(lhs.kind == isa.OPK_REG && lhs.reg == dst.reg))) {
        if (!(lhs.kind == isa.OPK_REG && lhs.reg == dst.reg)) {
            val lc: err[fail.Fail] = emit_vec_load(lhs, dst.reg, buf);
            if (sel lc.err) { ret lc; }
        }
        ret emit_packed_op(opc, dst.reg, rhs, buf);
    }

    val ll: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
    if (sel ll.err) { ret ll; }
    val ro: err[fail.Fail] = emit_packed_op(opc, float_scratch0(), rhs, buf);
    if (sel ro.err) { ret ro; }
    ret emit_vec_store(dst, float_scratch0(), buf);
}

fun encode_vector_not(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: packed vector not missing operands")}; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val dst: isa.Operand = rd.ok;
    val src: isa.Operand = rs.ok;

    val ll: err[fail.Fail] = emit_vec_load(src, float_scratch0(), buf);
    if (sel ll.err) { ret ll; }
    val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
    if (sel ra.err) { ret ra; }
    val ro: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
    if (sel ro.err) { ret ro; }
    ret emit_vec_store(dst, float_scratch0(), buf);
}

fun pcmpeq_op(w: u8) u16 {
    if (w == 1) { ret x64.PCMPEQB; }
    if (w == 2) { ret x64.PCMPEQW; }
    ret x64.PCMPEQD;
}

fun pcmpgt_op(w: u8) u16 {
    if (w == 1) { ret x64.PCMPGTB; }
    if (w == 2) { ret x64.PCMPGTW; }
    ret x64.PCMPGTD;
}

fun emit_vcmp_eq_s0(lhs: isa.Operand, rhs: isa.Operand, w: u8, buf: *enc.ByteBuf) err[fail.Fail] {
    val ll: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
    if (sel ll.err) { ret ll; }
    if (w == 8) {
        val re: err[fail.Fail] = emit_packed_op(x64.PCMPEQD, float_scratch0(), rhs, buf);
        if (sel re.err) { ret re; }
        val packed_0: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, float_scratch1(), float_scratch0(), 0xB1, buf);
        if (sel packed_0.err) { ret packed_0; }
        ret emit_packed_op(x64.PAND, float_scratch0(), vec_reg(float_scratch1()), buf);
    }
    ret emit_packed_op(pcmpeq_op(w), float_scratch0(), rhs, buf);
}

fun emit_vcmp_gt64_s0(x: isa.Operand, y: isa.Operand, signed: bool, buf: *enc.ByteBuf) err[fail.Fail] {
    # x > y per 64-bit lane as an all-ones mask in scratch0, from dword compares only:
    # the high dwords decide unless they tie, and a tie is broken by the low dwords read
    # as unsigned. an unsigned dword gt is the signed one xored with "the signs differ",
    # which keeps the sequence inside the two scratch registers with no constant to hold;
    # pshufd 0xF5 spreads a lane's high dword over both dwords and 0xA0 its low dword.
    # this is the one seam an x86-64 level replaces with pcmpgtq (#3269).
    val s0: i32 = float_scratch0();
    val s1: i32 = float_scratch1();

    val ld0: err[fail.Fail] = emit_vec_load(x, s1, buf);
    if (sel ld0.err) { ret ld0; }
    val rx: err[fail.Fail] = emit_packed_op(x64.PXOR, s1, y, buf);
    if (sel rx.err) { ret rx; }
    val rz: err[fail.Fail] = emit_vec_zero(s0, buf);
    if (sel rz.err) { ret rz; }
    val rs: err[fail.Fail] = emit_packed_op(x64.PCMPGTD, s0, vec_reg(s1), buf);
    if (sel rs.err) { ret rs; }

    val ld1: err[fail.Fail] = emit_vec_load(x, s1, buf);
    if (sel ld1.err) { ret ld1; }
    val rg: err[fail.Fail] = emit_packed_op(x64.PCMPGTD, s1, y, buf);
    if (sel rg.err) { ret rg; }
    val ru: err[fail.Fail] = emit_packed_op(x64.PXOR, s0, vec_reg(s1), buf);
    if (sel ru.err) { ret ru; }

    val ld2: err[fail.Fail] = emit_vec_load(x, s1, buf);
    if (sel ld2.err) { ret ld2; }
    val re: err[fail.Fail] = emit_packed_op(x64.PCMPEQD, s1, y, buf);
    if (sel re.err) { ret re; }
    val packed_1: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s1, s1, 0xF5, buf);
    if (sel packed_1.err) { ret packed_1; }
    val ra: err[fail.Fail] = emit_packed_op(x64.PAND, s1, vec_reg(s0), buf);
    if (sel ra.err) { ret ra; }
    val packed_2: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s1, s1, 0xA0, buf);
    if (sel packed_2.err) { ret packed_2; }

    if (signed) {
        val ld3: err[fail.Fail] = emit_vec_load(x, s0, buf);
        if (sel ld3.err) { ret ld3; }
        val rh: err[fail.Fail] = emit_packed_op(x64.PCMPGTD, s0, y, buf);
        if (sel rh.err) { ret rh; }
    }
    val packed_3: err[fail.Fail] = emit_packed_rri(x64.PSHUFD, s0, s0, 0xF5, buf);
    if (sel packed_3.err) { ret packed_3; }
    ret emit_packed_op(x64.POR, s0, vec_reg(s1), buf);
}

fun encode_vcmp_i64_ordering(dst: isa.Operand, lhs: isa.Operand, rhs: isa.Operand, op: mir.MirOpcode, buf: *enc.ByteBuf) err[fail.Fail] {
    val signed: bool = op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LE_S;
    if (op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U) {
        val rg: err[fail.Fail] = emit_vcmp_gt64_s0(rhs, lhs, signed, buf);
        if (sel rg.err) { ret rg; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }
    val rg: err[fail.Fail] = emit_vcmp_gt64_s0(lhs, rhs, signed, buf);
    if (sel rg.err) { ret rg; }
    val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
    if (sel ra.err) { ret ra; }
    val rx: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
    if (sel rx.err) { ret rx; }
    ret emit_vec_store(dst, float_scratch0(), buf);
}

fun encode_vector_compare(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed compare missing operands")}; }
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rr: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], 16);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val dst: isa.Operand   = rd.ok;
    val lhs: isa.Operand   = rl.ok;
    val rhs: isa.Operand   = rr.ok;
    val op:  mir.MirOpcode = mi.opcode;
    val w:   u8            = mir.vec_lane_elem_bytes(mi.vec_lane);

    if (mir.vec_lane_kind(mi.vec_lane) == mir.VEC_LANE_FLOAT) {
        var cmpop: u16 = x64.CMPPD;
        if (w == 4) { cmpop = x64.CMPPS; }
        var imm: u8 = 0;
        if (op == mir.MIR_SEL_CMP_NE)                                 { imm = 4; }
        or (op == mir.MIR_SEL_CMP_LT_S || op == mir.MIR_SEL_CMP_LT_U) { imm = 1; }
        or (op == mir.MIR_SEL_CMP_LE_S || op == mir.MIR_SEL_CMP_LE_U) { imm = 2; }
        val fl: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
        if (sel fl.err) { ret fl; }
        val fr: err[fail.Fail] = emit_vec_load(rhs, float_scratch1(), buf);
        if (sel fr.err) { ret fr; }
        val packed_4: err[fail.Fail] = emit_packed_rri(cmpop, float_scratch0(), float_scratch1(), imm, buf);
        if (sel packed_4.err) { ret packed_4; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }

    if (op == mir.MIR_SEL_CMP_EQ) {
        val re: err[fail.Fail] = emit_vcmp_eq_s0(lhs, rhs, w, buf);
        if (sel re.err) { ret re; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }
    if (op == mir.MIR_SEL_CMP_NE) {
        val re: err[fail.Fail] = emit_vcmp_eq_s0(lhs, rhs, w, buf);
        if (sel re.err) { ret re; }
        val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
        if (sel ra.err) { ret ra; }
        val ro: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel ro.err) { ret ro; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }

    if (w == 8) { ret encode_vcmp_i64_ordering(dst, lhs, rhs, op, buf); }

    if (op == mir.MIR_SEL_CMP_LT_S) {
        val ld: err[fail.Fail] = emit_vec_load(rhs, float_scratch0(), buf);
        if (sel ld.err) { ret ld; }
        val ro: err[fail.Fail] = emit_packed_op(pcmpgt_op(w), float_scratch0(), lhs, buf);
        if (sel ro.err) { ret ro; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }
    if (op == mir.MIR_SEL_CMP_LE_S) {
        val ld: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
        if (sel ld.err) { ret ld; }
        val ro: err[fail.Fail] = emit_packed_op(pcmpgt_op(w), float_scratch0(), rhs, buf);
        if (sel ro.err) { ret ro; }
        val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
        if (sel ra.err) { ret ra; }
        val rx: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel rx.err) { ret rx; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }
    if (op == mir.MIR_SEL_CMP_LT_U) {
        if (w == 4) {
            val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
            if (sel ra.err) { ret ra; }
            val packed_5: err[fail.Fail] = emit_packed_shift_imm(x64.PSLLD, float_scratch1(), 31, buf);
            if (sel packed_5.err) { ret packed_5; }
            val ld: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
            if (sel ld.err) { ret ld; }
            val rx0: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
            if (sel rx0.err) { ret rx0; }
            val rx1: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch1(), rhs, buf);
            if (sel rx1.err) { ret rx1; }
            val rg: err[fail.Fail] = emit_packed_op(x64.PCMPGTD, float_scratch1(), vec_reg(float_scratch0()), buf);
            if (sel rg.err) { ret rg; }
            ret emit_vec_store(dst, float_scratch1(), buf);
        }
        val ld: err[fail.Fail] = emit_vec_load(rhs, float_scratch0(), buf);
        if (sel ld.err) { ret ld; }
        var subus: u16 = x64.PSUBUSW;
        if (w == 1) { subus = x64.PSUBUSB; }
        val rs: err[fail.Fail] = emit_packed_op(subus, float_scratch0(), lhs, buf);
        if (sel rs.err) { ret rs; }
        val rz: err[fail.Fail] = emit_vec_zero(float_scratch1(), buf);
        if (sel rz.err) { ret rz; }
        val re: err[fail.Fail] = emit_packed_op(pcmpeq_op(w), float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel re.err) { ret re; }
        val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
        if (sel ra.err) { ret ra; }
        val rx: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel rx.err) { ret rx; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }
    if (w == 4) {
        val ra: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
        if (sel ra.err) { ret ra; }
        val packed_6: err[fail.Fail] = emit_packed_shift_imm(x64.PSLLD, float_scratch1(), 31, buf);
        if (sel packed_6.err) { ret packed_6; }
        val ld: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
        if (sel ld.err) { ret ld; }
        val rx0: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel rx0.err) { ret rx0; }
        val rx1: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch1(), rhs, buf);
        if (sel rx1.err) { ret rx1; }
        val rg: err[fail.Fail] = emit_packed_op(x64.PCMPGTD, float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel rg.err) { ret rg; }
        val ra2: err[fail.Fail] = emit_vec_all_ones(float_scratch1(), buf);
        if (sel ra2.err) { ret ra2; }
        val rx2: err[fail.Fail] = emit_packed_op(x64.PXOR, float_scratch0(), vec_reg(float_scratch1()), buf);
        if (sel rx2.err) { ret rx2; }
        ret emit_vec_store(dst, float_scratch0(), buf);
    }
    val ld: err[fail.Fail] = emit_vec_load(lhs, float_scratch0(), buf);
    if (sel ld.err) { ret ld; }
    var subus2: u16 = x64.PSUBUSW;
    if (w == 1) { subus2 = x64.PSUBUSB; }
    val rs2: err[fail.Fail] = emit_packed_op(subus2, float_scratch0(), rhs, buf);
    if (sel rs2.err) { ret rs2; }
    val rz2: err[fail.Fail] = emit_vec_zero(float_scratch1(), buf);
    if (sel rz2.err) { ret rz2; }
    val re2: err[fail.Fail] = emit_packed_op(pcmpeq_op(w), float_scratch0(), vec_reg(float_scratch1()), buf);
    if (sel re2.err) { ret re2; }
    ret emit_vec_store(dst, float_scratch0(), buf);
}

fun encode_divide(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: division missing divisor operand")};
    }
    val w:      u8   = effective_width(mi.width);
    val signed: bool = mi.opcode == mir.MIR_SEL_DIV_S || mi.opcode == mir.MIR_SEL_REM_S;

    val rdv: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rdv.err) { ret err[fail.Fail].err{rdv.err}; }
    val divisor: isa.Operand = rdv.ok;

    if (signed) {
        var sext_inst: isa.Inst = isa.inst_blank();
        sext_inst.opcode = x64.CDQ;
        if (w == 2) { sext_inst.opcode = x64.CWD; }
        or (w >= 8) { sext_inst.opcode = x64.CQO; }
        sext_inst.size = w;
        encode_inst(?sext_inst, buf);
    }
    or {
        var xr: isa.Inst = isa.inst_blank();
        xr.opcode = x64.XOR;
        xr.dst    = isa.make_reg(x64.RDX, 4);
        xr.src1   = isa.make_reg(x64.RDX, 4);
        xr.size   = 4;
        encode_inst(?xr, buf);
    }

    var dv: isa.Inst = isa.inst_blank();
    dv.opcode = x64.DIV;
    if (signed) { dv.opcode = x64.IDIV; }
    dv.src1  = divisor;
    dv.size  = w;
    dv.flags = width_flags(mi.width);
    encode_inst(?dv, buf);

    ret err[fail.Fail].ok{};
}

fun is_mir_mul_pair(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_MUL_PAIR_U || op == mir.MIR_SEL_MUL_PAIR_S;
}

# the widening multiply of rax by operand 1 into rdx:rax; the accumulator
# load and the result moves are separate instructions
fun encode_mul_pair(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: pair multiply missing multiplier operand")};
    }
    val w: u8 = effective_width(mi.width);

    val rm: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }

    var ml: isa.Inst = isa.inst_blank();
    ml.opcode = x64.MUL;
    if (mi.opcode == mir.MIR_SEL_MUL_PAIR_S) { ml.opcode = x64.IMUL; }
    ml.src1  = rm.ok;
    ml.size  = w;
    ml.flags = width_flags(mi.width);
    if (encode_inst(?ml, buf) == 0) {
        ret err[fail.Fail].err{fail.message("encode: pair multiply operand is not a register or memory")};
    }

    ret err[fail.Fail].ok{};
}

fun is_mir_binary(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_ADD || op == mir.MIR_SEL_SUB || op == mir.MIR_SEL_MUL ||
        op == mir.MIR_SEL_AND || op == mir.MIR_SEL_OR || op == mir.MIR_SEL_XOR;
}

fun mir_binary_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_ADD) { ret x64.ADD; }
    if (op == mir.MIR_SEL_SUB) { ret x64.SUB; }
    if (op == mir.MIR_SEL_MUL) { ret x64.IMUL; }
    if (op == mir.MIR_SEL_AND) { ret x64.AND; }
    if (op == mir.MIR_SEL_OR)  { ret x64.OR; }
    ret x64.XOR;
}

fun encode_binary(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: binary ALU op missing operands")};
    }
    val w:  u8                          = effective_width(mi.width);
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand                 = rd.ok;
    val rl:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val lhs: isa.Operand                 = rl.ok;
    val rr:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val rhs: isa.Operand = rr.ok;

    if (dst.kind != isa.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: binary ALU destination is not a register")};
    }

    # the op runs as `d = l; d op= r`, so a right operand that lives in d's
    # register would be read after the copy overwrote it; the allocator keeps
    # such a pairing from ever being chosen (#3647)
    val skip_mov: bool = lhs.kind == isa.OPK_REG && lhs.reg == dst.reg;
    if (!skip_mov && operand_reads_register(?rhs, dst.reg)) {
        ret err[fail.Fail].err{fail.message("encode: binary ALU right operand lives in the destination register the left operand is copied into (internal compiler error)")};
    }
    if (!skip_mov) {
        var mov: isa.Inst = isa.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = lhs;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        encode_inst(?mov, buf);
    }

    var op: isa.Inst = isa.inst_blank();
    op.opcode = mir_binary_opcode(mi.opcode);
    op.dst    = dst;
    op.src1   = rhs;
    op.size   = w;
    op.flags  = width_flags(mi.width);
    encode_inst(?op, buf);
    ret err[fail.Fail].ok{};
}

fun operand_reads_register(op: *isa.Operand, reg: i32) bool {
    if (op.kind == isa.OPK_REG) { ret op.reg == reg; }
    if (op.kind == isa.OPK_MEM) { ret op.base == reg || op.index == reg; }
    ret false;
}

fun is_mir_unary(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_NEG || op == mir.MIR_SEL_NOT;
}

fun encode_unary_mir(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: unary op missing operands")};
    }
    val w:  u8                          = effective_width(mi.width);
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand                 = rd.ok;
    val rs:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa.Operand = rs.ok;

    if (dst.kind != isa.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: unary destination is not a register")};
    }

    if (!(src.kind == isa.OPK_REG && src.reg == dst.reg)) {
        var mov: isa.Inst = isa.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = src;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        encode_inst(?mov, buf);
    }

    var op: isa.Inst = isa.inst_blank();
    op.dst   = dst;
    op.size  = w;
    op.flags = width_flags(mi.width);
    if (mi.opcode == mir.MIR_SEL_NEG) {
        op.opcode = x64.NEG;
    }
    or {
        op.opcode = x64.XOR;
        op.src1   = isa.make_imm(-1, w);
    }
    encode_inst(?op, buf);
    ret err[fail.Fail].ok{};
}

fun is_mir_shift(op: mir.MirOpcode) bool {
    ret op == mir.MIR_SEL_SHL || op == mir.MIR_SEL_SHR_U || op == mir.MIR_SEL_SHR_S;
}

fun mir_shift_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_SHL)   { ret x64.SHL; }
    if (op == mir.MIR_SEL_SHR_U) { ret x64.SHR; }
    ret x64.SAR;
}

fun encode_shift_mir(f: *mir.MirFunction, mi: *mir.MirInstr, buf: *enc.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: shift missing value or count operand")};
    }
    val w:  u8                          = effective_width(mi.width);
    val rd: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa.Operand                 = rd.ok;
    val rv:  res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    val value: isa.Operand                 = rv.ok;
    val rc:    res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val count: isa.Operand = rc.ok;

    if (dst.kind != isa.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: shift destination is not a register")};
    }
    if (count.kind == isa.OPK_REG && count.reg != x64.RCX::i32) {
        ret err[fail.Fail].err{fail.message("encode: shift count register is not CL")};
    }

    val skip_mov: bool = value.kind == isa.OPK_REG && value.reg == dst.reg;
    if (!skip_mov) {
        var mov: isa.Inst = isa.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = value;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        encode_inst(?mov, buf);
    }

    var sh: isa.Inst = isa.inst_blank();
    sh.opcode = mir_shift_opcode(mi.opcode);
    sh.dst    = dst;
    sh.src1   = count;
    sh.size   = w;
    sh.flags  = width_flags(mi.width);
    encode_inst(?sh, buf);
    ret err[fail.Fail].ok{};
}

fun encode_cbr(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch missing operands")};
    }
    if (mi.operands[1].kind != mir.MIR_OP_BLOCK || mi.operands[2].kind != mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch target is not a block")};
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;

    val cwidth: u8                          = effective_width(mi.width);
    val rc:     res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], cwidth);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val cond: isa.Operand = rc.ok;

    if (cond.kind != isa.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch condition is not a register")};
    }

    var test_inst: isa.Inst = isa.inst_blank();
    test_inst.opcode = x64.TEST;
    test_inst.dst    = cond;
    test_inst.src1   = cond;
    test_inst.size   = cwidth;
    test_inst.flags  = width_flags(mi.width);
    encode_inst(?test_inst, ?st.buf);

    val jne_start: usize    = st.buf.len;
    var jne:       isa.Inst = isa.inst_blank();
    jne.opcode = x64.JNE;
    val fp: err[fail.Fail] = flags_pair(test_inst.opcode, jne.opcode);
    if (sel fp.err) { ret fp; }
    jne.dst  = isa.make_block_label(then_block);
    jne.size = DEFAULT_OPERAND_SIZE;
    val jne_size: i32 = encode_inst(?jne, ?st.buf);
    if (jne_size <= 0) { ret err[fail.Fail].err{fail.message("encode: conditional branch failed to encode")}; }
    val jne_patch: u32            = (jne_start + (jne_size - 4)::usize)::u32;
    val jne_next:  u32            = (jne_start + jne_size::usize)::u32;
    val fj:        err[fail.Fail] = enc.push_fixup(st, jne_patch, jne_next, then_block, fn_base);
    if (sel fj.err) { ret err[fail.Fail].err{fj.err}; }

    if (enc.branch_falls_through(st, else_block)) { ret err[fail.Fail].ok{}; }
    val jmp_start: usize    = st.buf.len;
    var jmp:       isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_block_label(else_block);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    val jmp_size: i32 = encode_inst(?jmp, ?st.buf);
    if (jmp_size <= 0) { ret err[fail.Fail].err{fail.message("encode: conditional branch failed to encode")}; }
    val jmp_patch: u32            = (jmp_start + (jmp_size - 4)::usize)::u32;
    val jmp_next:  u32            = (jmp_start + jmp_size::usize)::u32;
    val r_3932:    err[fail.Fail] = enc.push_fixup(st, jmp_patch, jmp_next, else_block, fn_base);
    if (sel r_3932.err) { ret err[fail.Fail].err{r_3932.err}; }
    ret err[fail.Fail].ok{};
}

fun fused_jcc_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_SEL_CBR_EQ)   { ret x64.JE; }
    if (op == mir.MIR_SEL_CBR_NE)   { ret x64.JNE; }
    if (op == mir.MIR_SEL_CBR_LT_S) { ret x64.JL; }
    if (op == mir.MIR_SEL_CBR_LT_U) { ret x64.JB; }
    if (op == mir.MIR_SEL_CBR_LE_S) { ret x64.JLE; }
    ret x64.JBE;
}

fun encode_fused_cbr(st: *enc.EncodeState, f: *mir.MirFunction, fn_base: u32, mi: *mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch missing operands")};
    }
    if (mi.operands[2].kind != mir.MIR_OP_BLOCK || mi.operands[3].kind != mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch target is not a block")};
    }
    val then_block:  u32 = mi.operands[2].imm::u32;
    val else_block:  u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.len::u32;

    val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[0], ?mi.operands[1], mi.width, ?st.buf);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val jcc_start: usize    = st.buf.len;
    var jcc:       isa.Inst = isa.inst_blank();
    jcc.opcode = fused_jcc_opcode(mi.opcode);
    val fp: err[fail.Fail] = flags_pair(rc.ok, jcc.opcode);
    if (sel fp.err) { ret fp; }
    jcc.dst  = isa.make_block_label(then_block);
    jcc.size = DEFAULT_OPERAND_SIZE;
    val jcc_size: i32 = encode_inst(?jcc, ?st.buf);
    if (jcc_size <= 0) { ret err[fail.Fail].err{fail.message("encode: fused compare-branch failed to encode")}; }
    val jcc_patch: u32            = (jcc_start + (jcc_size - 4)::usize)::u32;
    val jcc_next:  u32            = (jcc_start + jcc_size::usize)::u32;
    val fj:        err[fail.Fail] = enc.push_fixup(st, jcc_patch, jcc_next, then_block, fn_base);
    if (sel fj.err) { ret err[fail.Fail].err{fj.err}; }

    if (enc.branch_falls_through(st, else_block)) {
        enc.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
        ret err[fail.Fail].ok{};
    }
    val jmp_start: usize    = st.buf.len;
    var jmp:       isa.Inst = isa.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa.make_block_label(else_block);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    val jmp_size: i32 = encode_inst(?jmp, ?st.buf);
    if (jmp_size <= 0) { ret err[fail.Fail].err{fail.message("encode: fused compare-branch failed to encode")}; }
    val jmp_patch: u32 = (jmp_start + (jmp_size - 4)::usize)::u32;
    val jmp_next:  u32 = (jmp_start + jmp_size::usize)::u32;
    enc.close_cmp_varlocs(st, instr_start, st.buf.len::u32);
    val r_3984: err[fail.Fail] = enc.push_fixup(st, jmp_patch, jmp_next, else_block, fn_base);
    if (sel r_3984.err) { ret err[fail.Fail].err{r_3984.err}; }
    ret err[fail.Fail].ok{};
}

fun concrete_opcode(op: mir.MirOpcode) u16 {
    if (op == mir.MIR_MOV)  { ret x64.MOV; }
    if (op == mir.MIR_CALL) { ret x64.CALL; }
    ret op::u16;
}

fun effective_width(width: u8) u8 {
    if (width == 0) { ret DEFAULT_OPERAND_SIZE; }
    ret width;
}

fun width_flags(width: u8) u16 {
    val w: u8 = effective_width(width);
    if (w >= 8) { ret x64.FLAG_REX_W; }
    if (w == 2) { ret x64.FLAG_16BIT; }
    ret 0;
}

fun mir_to_inst(f: *mir.MirFunction, mi: *mir.MirInstr, inst: *isa.Inst) err[fail.Fail] {
    val dwidth: u8 = effective_width(mi.width);
    val swidth: u8 = effective_width(mi.src_width);
    @inst       = isa.inst_blank();
    inst.opcode = concrete_opcode(mi.opcode);
    inst.size   = dwidth;
    inst.flags  = width_flags(mi.width);

    if (mi.operand_count >= 1) {
        val r: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], dwidth);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        inst.dst = r.ok;
    }
    if (mi.operand_count >= 2) {
        val r: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], swidth);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        inst.src1 = r.ok;
    }
    if (mi.operand_count >= 3) {
        val r: res[isa.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], swidth);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        inst.src2 = r.ok;
    }

    if (mi.operand_count >= 1 &&
        (inst.opcode == x64.CALL::u16 || inst.opcode == x64.JMP::u16) &&
        mi.operands[0].kind != mir.MIR_OP_SYM &&
        mi.operands[0].kind != mir.MIR_OP_BLOCK) {
        inst.flags = inst.flags | x64.FLAG_INDIRECT::u16;
    }
    ret err[fail.Fail].ok{};
}

fun mir_to_operand(f: *mir.MirFunction, op: *mir.MirOperand, width: u8) res[isa.Operand, fail.Fail] {
    if (op.kind == mir.MIR_OP_PREG) {
        ret res[isa.Operand, fail.Fail].ok{isa.make_reg(mir.preg_regid(op.preg), width)};
    }
    if (op.kind == mir.MIR_OP_VREG) {
        ret res[isa.Operand, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    if (op.kind == mir.MIR_OP_IMM) {
        ret res[isa.Operand, fail.Fail].ok{isa.make_imm(op.imm, width)};
    }
    if (op.kind == mir.MIR_OP_MEM) {
        var index: i32 = -1;
        var scale: u8  = 0;
        if (sel op.index.vreg) {
            ret res[isa.Operand, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand index")};
        }
        if (sel op.index.preg) {
            index = mir.preg_regid(op.index.preg);
            scale = op.scale;
        }
        var base: i32 = mir.preg_regid(op.preg);
        var disp: i64 = op.imm;
        if (!mir.vreg_is_nil(op.vreg)) {
            val slot: opt[i64] = frame_slot_offset(f, op.vreg.n);
            if (!sel slot.some) {
                ret res[isa.Operand, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand base")};
            }
            base = slot_base_reg(f);
            disp = slot.some + op.imm;
        }
        if (!isa.offset_fits(32, disp)) {
            ret res[isa.Operand, fail.Fail].err{fail.message("encode: x86-64 memory displacement does not fit the signed 32-bit disp32 field")};
        }
        ret res[isa.Operand, fail.Fail].ok{isa.make_mem(base, disp::i32, index, scale, width)};
    }
    if (op.kind == mir.MIR_OP_SYM) {
        var sym: isa.Operand = isa.make_mem(-1, 0, -1, 0, width);
        sym.sym_id     = op.sym;
        sym.sym_addend = op.sym_off;
        ret res[isa.Operand, fail.Fail].ok{sym};
    }
    if (op.kind == mir.MIR_OP_BLOCK) {
        ret res[isa.Operand, fail.Fail].ok{isa.make_block_label(op.imm::u32)};
    }
    ret res[isa.Operand, fail.Fail].ok{isa.make_none()};
}

fun frame_slot_offset(f: *mir.MirFunction, v: u32) opt[i64] {
    if (codegen_frame.slots_from_sp(?f.frame)) {
        val r_4082: opt[i64] = codegen_frame.slot_sp_offset(?f.frame, v);
        if (sel r_4082.some) { ret opt[i64].some{r_4082.some}; }
        ret opt[i64].none{};
    }
    val r_4084: opt[i64] = codegen_frame.slot_offset(?f.frame, v);
    if (sel r_4084.some) { ret opt[i64].some{r_4084.some}; }
    ret opt[i64].none{};
}

val X64P_NONE:   u16 = 1;
val X64P_ONE:    u16 = 2;
val X64P_TWO:    u16 = 3;
val X64P_PORTIO: u16 = 8;
# one 32- or 64-bit general-purpose register and nothing else
val X64P_WIDEREG: u16 = 9;
# a vector register and a 32-bit register or memory, with an 8-bit immediate
val X64P_VECG: u16 = 10;
# two general-purpose operands and a third: an immediate, or `cl` where the
# row takes a count register; imul alone also stands with two
val X64P_TRIPLE: u16 = 11;
val X64P_BRANCH: u16 = 4;
val X64P_XFER:   u16 = 5;
val X64P_VEC:    u16 = 6;
val X64P_VECI:   u16 = 7;

val X64W_MASK:    u16 = 0x3000;
val X64W_UNIFORM: u16 = 0x0000;
val X64W_NARROW:  u16 = 0x1000;
val X64W_FIXED64: u16 = 0x2000;
val X64W_UNSIZED: u16 = 0x3000;

val X64F_LOCK: u16 = 0x0100;

val X64F_INDIRECT: u16 = 0x0200;

# a packed move, which may also store its vector register into memory
val X64F_VSTORE: u16 = 0x0400;

val X64_SYSCALL_WRITES: u32 = 0x803;

val X64_EDX_EAX_WRITES: u32 = 0x5;
val X64_RAX_WRITE:      u32 = 0x1;

# cpuid reads eax and ecx and writes all four of eax, ebx, ecx and edx
val X64_CPUID_WRITES: u32 = 0xF;

val X64_XMM0_READ: u32 = 0x1;

val X64_ALL_GP: u32 = 0xFFFF;
val X64_ALL_FP: u32 = 0xFFFF;

fun x64_pattern(flags: u16) u16 {
    ret flags & 0x00FF;
}

fun x64_width_class(flags: u16) u16 {
    ret flags & X64W_MASK;
}

val X64_MNEMONIC_COUNT: usize = 149;

val X64_MNEMONICS: [X64_MNEMONIC_COUNT]iasm.Mnemonic = [X64_MNEMONIC_COUNT]iasm.Mnemonic{
    iasm.Mnemonic{name: "syscall", code: x64.SYSCALL::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: X64_SYSCALL_WRITES, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "ret", code: x64.RET::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "hlt", code: x64.HLT::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "cli", code: x64.CLI::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "sti", code: x64.STI::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "rdtsc", code: x64.RDTSC::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: X64_EDX_EAX_WRITES, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "rdmsr", code: x64.RDMSR::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: X64_EDX_EAX_WRITES, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "wrmsr", code: x64.WRMSR::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "lidt", code: x64.LIDT::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_ONE | X64W_UNSIZED, words: 0},
    iasm.Mnemonic{name: "in", code: x64.IN::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_PORTIO | X64W_UNSIZED, words: 0},
    iasm.Mnemonic{name: "out", code: x64.OUT::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_PORTIO | X64W_UNSIZED, words: 0},
    iasm.Mnemonic{name: "mfence", code: x64.MFENCE::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "pause", code: x64.PAUSE::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "nop", code: x64.NOP::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},

    iasm.Mnemonic{name: "cld", code: x64.CLD::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "pushfq", code: x64.PUSHFQ::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0, implicit_mem: true},
    iasm.Mnemonic{name: "popfq", code: x64.POPFQ::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0, implicit_mem: true},
    iasm.Mnemonic{name: "swapgs", code: x64.SWAPGS::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},
    iasm.Mnemonic{name: "rdfsbase", code: x64.RDFSBASE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_WIDEREG, words: 0, requires: x64.EXT_FSGSBASE},
    iasm.Mnemonic{name: "rdgsbase", code: x64.RDGSBASE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_WIDEREG, words: 0, requires: x64.EXT_FSGSBASE},
    iasm.Mnemonic{name: "wrfsbase", code: x64.WRFSBASE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_WIDEREG, words: 0, addr_ops: iasm.AW_OP0, requires: x64.EXT_FSGSBASE},
    iasm.Mnemonic{name: "wrgsbase", code: x64.WRGSBASE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_WIDEREG, words: 0, addr_ops: iasm.AW_OP0, requires: x64.EXT_FSGSBASE},
    iasm.Mnemonic{name: "iretq", code: x64.IRETQ::u32, form: iasm.AF_NONE, writes: iasm.AW_NONE, implicit: 0, flags: X64P_NONE, words: 0},

    iasm.Mnemonic{name: "call", code: x64.CALL::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_XFER | X64W_FIXED64, words: 0},
    iasm.Mnemonic{name: "jmp", code: x64.JMP::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_XFER | X64W_FIXED64, words: 0},
    iasm.Mnemonic{name: "je", code: x64.JE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jz", code: x64.JE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jne", code: x64.JNE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jnz", code: x64.JNE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jc", code: x64.JB::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jb", code: x64.JB::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jnc", code: x64.JAE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jae", code: x64.JAE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},
    iasm.Mnemonic{name: "jnb", code: x64.JAE::u32, form: iasm.AF_OPS, writes: iasm.AW_NONE, implicit: 0, flags: X64P_BRANCH, words: 0},

    iasm.Mnemonic{name: "setc", code: x64.SETB::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0},
    iasm.Mnemonic{name: "setb", code: x64.SETB::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0},
    iasm.Mnemonic{name: "setnc", code: x64.SETAE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0},
    iasm.Mnemonic{name: "setae", code: x64.SETAE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0},
    iasm.Mnemonic{name: "setnb", code: x64.SETAE::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: 0, flags: X64P_ONE, words: 0},

    iasm.Mnemonic{name: "lock cmpxchg", code: x64.CMPXCHG::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0, implicit: X64_RAX_WRITE, flags: X64P_TWO | X64F_LOCK, words: 0},
    iasm.Mnemonic{name: "lock xadd", code: x64.XADD::u32, form: iasm.AF_OPS, writes: iasm.AW_OP0 | iasm.AW_OP1, implicit: 0, flags: X64P_TWO | X64F_LOCK, words: 0},
