    or (buf.data[3] != 0x00) { bad = 1; }
    enc.buf_dnit(?buf);
    ret bad;
}

test encode_push__imm_boundaries {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var bad: i32         = 0;

    var m1: isa.Inst = isa.inst_blank();
    m1.opcode = x64.PUSH;
    m1.dst    = isa.make_imm(127, 1);
    m1.size   = 1;
    val n1: i32 = encode_inst(?m1, ?buf);
    if (n1 != 2)             { bad = 1; }
    if (buf.data[0] != 0x6A) { bad = 1; }
    if (buf.data[1] != 0x7F) { bad = 1; }

    buf.len = 0;
    var m2: isa.Inst = isa.inst_blank();
    m2.opcode = x64.PUSH;
    m2.dst    = isa.make_imm(0x1000, 4);
    m2.size   = 4;
    val n2: i32 = encode_inst(?m2, ?buf);
    if (n2 != 5)             { bad = 1; }
    if (buf.data[0] != 0x68) { bad = 1; }

    buf.len = 0;
    var m3: isa.Inst = isa.inst_blank();
    m3.opcode = x64.PUSH;
    m3.dst    = isa.make_imm(0x80000000, 8);
    m3.size   = 8;
    val n3: i32 = encode_inst(?m3, ?buf);
    if (n3 != 0) { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

test emit_stack_probe__chkstk_body {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    val pr: err[fail.Fail] = emit_stack_probe(?st, 12288, 4096);
    if (sel pr.err) { ret 9; }

    var want: [41]u8;
    want[0]  = 0x49;
    want[1]  = 0xc7;
    want[2]  = 0xc3;
    want[3]  = 0x00;
    want[4]  = 0x30;
    want[5]  = 0x00;
    want[6]  = 0x00;
    want[7]  = 0x48;
    want[8]  = 0x81;
    want[9]  = 0xec;
    want[10] = 0x00;
    want[11] = 0x10;
    want[12] = 0x00;
    want[13] = 0x00;
    want[14] = 0x4c;
    want[15] = 0x89;
    want[16] = 0x1c;
    want[17] = 0x24;
    want[18] = 0x49;
    want[19] = 0x81;
    want[20] = 0xeb;
    want[21] = 0x00;
    want[22] = 0x10;
    want[23] = 0x00;
    want[24] = 0x00;
    want[25] = 0x49;
    want[26] = 0x81;
    want[27] = 0xfb;
    want[28] = 0x00;
    want[29] = 0x10;
    want[30] = 0x00;
    want[31] = 0x00;
    want[32] = 0x0f;
    want[33] = 0x87;
    want[34] = 0xe1;
    want[35] = 0xff;
    want[36] = 0xff;
    want[37] = 0xff;
    want[38] = 0x4c;
    want[39] = 0x29;
    want[40] = 0xdc;

    val b:   *u8 = st.buf.data;
    var bad: i32 = 0;
    if (st.buf.len != 41) { bad = 1; }
    or {
        var k: usize = 0;
        for (k < 41) {
            if (b[k] != want[k]) {
                bad = 1;
                brk;
            }
            k = k + 1;
        }
    }

    enc.buf_dnit(?st.buf);
    ret bad;
}

test needs_stack_probe__commit_model_boundary {
    var win: tos.OsVTable;
    win.stack_probe = true;
    win.page_size   = 4096;
    var auto: tos.OsVTable;
    auto.stack_probe = false;
    auto.page_size   = 4096;

    var bad: i32 = 0;
    if (needs_stack_probe(auto.stack_probe, auto.page_size, 1))       { bad = 1; }
    or (needs_stack_probe(auto.stack_probe, auto.page_size, 1048576)) { bad = 1; }
    or (needs_stack_probe(win.stack_probe, win.page_size, 1))         { bad = 1; }
    or (needs_stack_probe(win.stack_probe, win.page_size, 4096))      { bad = 1; }
    or (!needs_stack_probe(win.stack_probe, win.page_size, 4097))     { bad = 1; }
    or (!needs_stack_probe(win.stack_probe, win.page_size, 1048576))  { bad = 1; }
    ret bad;
}

test x86_reloc_offset__legalized_disp32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    var big: isa.Inst = isa.inst_blank();
    big.opcode   = x64.MOV;
    big.size     = 8;
    big.dst.kind = isa.OPK_MEM;
    big.dst.size = 8;
    big.src1     = isa.make_imm(0x100000000, 8);
    val big_sz: i32 = encode_mov(?big, ?st.buf);

    var small: isa.Inst = isa.inst_blank();
    small.opcode   = x64.MOV;
    small.size     = 8;
    small.dst.kind = isa.OPK_MEM;
    small.dst.size = 8;
    small.src1     = isa.make_imm(5, 8);
    val small_sz: i32 = encode_mov(?small, ?st.buf);

    var bad: i32 = 0;
    if (big_sz != 17)                                 { bad = 1; }
    or (trailing_imm_width(?big) != 0)                { bad = 1; }
    or (x86_reloc_offset(nil, ?big, big_sz) != 13)    { bad = 1; }
    or (small_sz != 11)                               { bad = 1; }
    or (trailing_imm_width(?small) != 4)              { bad = 1; }
    or (x86_reloc_offset(nil, ?small, small_sz) != 3) { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}

test vec__mem_mem_16_stages_xmm14 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf:  enc.ByteBuf = enc.buf_init(?alloc);
    var inst: isa.Inst    = isa.inst_blank();
    inst.opcode = x64.MOV;
    inst.size   = 16;
    inst.dst    = isa.make_mem(x64.RBP, -384, -1, 0, 16);
    inst.src1   = isa.make_mem(x64.RAX, 0, -1, 0, 16);
    encode_inst(?inst, ?buf);
    var bad: i32 = 0;
    if (buf.len < 4)         { bad = 1; }
    or (buf.data[0] != 0x44) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0x30) { bad = 1; }
    enc.buf_dnit(?buf);
    ret bad;
}

test encode_shift__forms_and_count_width {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var buf1: enc.ByteBuf = enc.buf_init(?alloc);
    var m1:   isa.Inst    = isa.inst_blank();
    m1.opcode = x64.SHL;
    m1.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m1.src1   = isa.make_imm(3, 8);
    m1.size   = 8;
    val n1: i32 = encode_inst(?m1, ?buf1);
    if (n1 != 4)              { bad = 1; }
    or (buf1.data[0] != 0x48) { bad = 1; }
    or (buf1.data[1] != 0xC1) { bad = 1; }
    or (buf1.data[2] != 0x20) { bad = 1; }
    or (buf1.data[3] != 0x03) { bad = 1; }
    enc.buf_dnit(?buf1);

    var buf2: enc.ByteBuf = enc.buf_init(?alloc);
    var m2:   isa.Inst    = isa.inst_blank();
    m2.opcode = x64.SHL;
    m2.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m2.src1   = isa.make_imm(1, 8);
    m2.size   = 8;
    val n2: i32 = encode_inst(?m2, ?buf2);
    if (n2 != 3)              { bad = 1; }
    or (buf2.data[0] != 0x48) { bad = 1; }
    or (buf2.data[1] != 0xD1) { bad = 1; }
    or (buf2.data[2] != 0x20) { bad = 1; }
    enc.buf_dnit(?buf2);

    var buf3: enc.ByteBuf = enc.buf_init(?alloc);
    var m3:   isa.Inst    = isa.inst_blank();
    m3.opcode = x64.SHL;
    m3.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 1);
    m3.src1   = isa.make_reg(x64.RCX, 1);
    m3.size   = 1;
    val n3: i32 = encode_inst(?m3, ?buf3);
    if (n3 != 2)              { bad = 1; }
    or (buf3.data[0] != 0xD2) { bad = 1; }
    or (buf3.data[1] != 0x20) { bad = 1; }
    enc.buf_dnit(?buf3);

    var buf4: enc.ByteBuf = enc.buf_init(?alloc);
    var m4:   isa.Inst    = isa.inst_blank();
    m4.opcode = x64.SHL;
    m4.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 8);
    m4.src1   = isa.make_mem(x64.RBX, 0, -1, 0, 8);
    m4.size   = 8;
    if (encode_inst(?m4, ?buf4) != 0) { bad = 1; }
    enc.buf_dnit(?buf4);

    # a count immediate that does not fit a byte is refused
    var buf5: enc.ByteBuf = enc.buf_init(?alloc);
    var m5:   isa.Inst    = isa.inst_blank();
    m5.opcode = x64.SHL;
    m5.dst    = isa.make_reg(x64.RAX, 8);
    m5.src1   = isa.make_imm(300, 8);
    m5.size   = 8;
    if (encode_inst(?m5, ?buf5) != 0) { bad = 1; }
    enc.buf_dnit(?buf5);

    ret bad;
}

# the one-operand multiplies: F6/F7 with /4 for mul and /5 for imul, rex.b
# following the r/m register, a memory multiplier through the modrm
#[testing]
fun t_one_operand(op: u16, src: isa.Operand, size: u8, buf: *enc.ByteBuf) i32 {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = op;
    mi.src1   = src;
    mi.size   = size;
    ret encode_inst(?mi, buf);
}

test encode_mul1__byte_exact {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);

    if (t_one_operand(x64.MUL, isa.make_reg(x64.RCX, 8), 8, ?buf) != 3)    { ret 1; }
    if (buf.data[0] != 0x48 || buf.data[1] != 0xF7 || buf.data[2] != 0xE1) { ret 1; }

    buf.len = 0;
    if (t_one_operand(x64.MUL, isa.make_reg(x64.R9, 8), 8, ?buf) != 3)     { ret 2; }
    if (buf.data[0] != 0x49 || buf.data[1] != 0xF7 || buf.data[2] != 0xE1) { ret 2; }

    buf.len = 0;
    if (t_one_operand(x64.IMUL, isa.make_reg(x64.RCX, 8), 8, ?buf) != 3)   { ret 3; }
    if (buf.data[0] != 0x48 || buf.data[1] != 0xF7 || buf.data[2] != 0xE9) { ret 3; }

    buf.len = 0;
    if (t_one_operand(x64.MUL, isa.make_reg(x64.RCX, 4), 4, ?buf) != 2) { ret 4; }
    if (buf.data[0] != 0xF7 || buf.data[1] != 0xE1)                     { ret 4; }

    buf.len = 0;
    if (t_one_operand(x64.MUL, isa.make_mem(x64.RBP, -8, -1, 0, 8), 8, ?buf) != 4)                { ret 5; }
    if (buf.data[0] != 0x48 || buf.data[1] != 0xF7 || buf.data[2] != 0x65 || buf.data[3] != 0xF8) { ret 5; }

    buf.len = 0;
    if (t_one_operand(x64.MUL, isa.make_reg(x64.RCX, 1), 1, ?buf) != 2) { ret 6; }
    if (buf.data[0] != 0xF6 || buf.data[1] != 0xE1)                     { ret 6; }

    buf.len = 0;
    if (t_one_operand(x64.MUL, isa.make_imm(3, 8), 8, ?buf) != 0) { ret 7; }
    enc.buf_dnit(?buf);
    ret 0;
}

# a selected pair multiply is the bare one-operand multiply of operand 1;
# no prelude, no result move
test encode_mul_pair__byte_exact {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var f:   mir.MirFunction;

    var ops: [2]mir.MirOperand;
    ops[0] = mir.op_preg(mir.preg_id(x64.RAX));
    ops[1] = mir.op_preg(mir.preg_id(x64.RCX));
    var mi: mir.MirInstr = mir.instr(mir.MIR_SEL_MUL_PAIR_U, ?ops[0], 2, 8, 0);
    if (!t_accepted(encode_mul_pair(?f, ?mi, ?buf), ?buf))                 { ret 1; }
    if (buf.len != 3)                                                      { ret 1; }
    if (buf.data[0] != 0x48 || buf.data[1] != 0xF7 || buf.data[2] != 0xE1) { ret 1; }

    buf.len   = 0;
    mi.opcode = mir.MIR_SEL_MUL_PAIR_S;
    if (!t_accepted(encode_mul_pair(?f, ?mi, ?buf), ?buf))                 { ret 2; }
    if (buf.len != 3)                                                      { ret 2; }
    if (buf.data[0] != 0x48 || buf.data[1] != 0xF7 || buf.data[2] != 0xE9) { ret 2; }

    buf.len = 0;
    ops[1]  = mir.op_mem_preg(mir.preg_id(x64.RBP), 8);
    if (!t_accepted(encode_mul_pair(?f, ?mi, ?buf), ?buf)) { ret 3; }
    if (buf.data[1] != 0xF7 || buf.data[2] != 0x6D)        { ret 3; }

    buf.len = 0;
    ops[1]  = mir.op_imm(3);
    if (!t_refused(encode_mul_pair(?f, ?mi, ?buf), ?buf)) { ret 4; }
    enc.buf_dnit(?buf);
    ret 0;
}

# mul is its own form, never a divide, and its class is the full unsigned
# product whatever its operand count; the walk sees rax read and rdx:rax written
test describe__mul_is_the_unsigned_widening_product {
    val d: x64.OpDesc = x64.describe(x64.MUL);
    if (d.form != x64.FORM_MUL1 || d.shape != x64.SHAPE_USE || d.arity != 1) { ret 1; }
    if (d.cls.op != ct.CT_OP_INT_MUL)                                        { ret 2; }
    if (d.cls.mul != ct.CT_MUL_WIDE_U || d.cls.mul_one != ct.CT_MUL_WIDE_U)  { ret 3; }
    if (!d.cls.writes_flags || d.cls.defines_flags)                          { ret 4; }
    if (x64.describe(x64.IMUL).cls.mul_one != ct.CT_MUL_WIDE_S)              { ret 5; }

    var e:  ct.InstEffects;
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.MUL;
    mi.src1   = isa.make_reg(x64.RCX, 8);
    mi.size   = 8;
    inst_effects(?mi, ?e);
    if (e.roles[1] != ct.ROLE_READ)               { ret 6; }
    if (e.implicit_reads != X64_RAX)              { ret 7; }
    if (e.implicit_writes != (X64_RAX | X64_RDX)) { ret 8; }
    val spelled: opt[str] = printer.mnemonic(x64.MUL);
    if (!sel spelled.some) { ret 9; }
    ret 0;
}

test pick_stage_scratch__avoids_operand_aliasing {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var bufA: enc.ByteBuf = enc.buf_init(?alloc);
    var addA: isa.Inst    = isa.inst_blank();
    addA.opcode = x64.ADD;
    addA.dst    = isa.make_reg(x64.R11, 8);
    addA.src1   = isa.make_imm(0x123456789A, 8);
    addA.size   = 8;
    encode_inst(?addA, ?bufA);

    var bufB: enc.ByteBuf = enc.buf_init(?alloc);
    var movB: isa.Inst    = isa.inst_blank();
    movB.opcode = x64.MOV;
    movB.dst    = isa.make_reg(x64.R10, 8);
    movB.src1   = isa.make_imm(0x123456789A, 8);
    movB.size   = 8;
    encode_inst(?movB, ?bufB);
    var addB: isa.Inst = isa.inst_blank();
    addB.opcode = x64.ADD;
    addB.dst    = isa.make_reg(x64.R11, 8);
    addB.src1   = isa.make_reg(x64.R10, 8);
    addB.size   = 8;
    encode_inst(?addB, ?bufB);

    if (bufA.len != bufB.len) { bad = 1; }
    or {
        var k: usize = 0;
        for (k < bufA.len) {
            if (bufA.data[k] != bufB.data[k]) { bad = 1; }
            k = k + 1;
        }
    }
    enc.buf_dnit(?bufA);
    enc.buf_dnit(?bufB);

    var bufC: enc.ByteBuf = enc.buf_init(?alloc);
    var movC: isa.Inst    = isa.inst_blank();
    movC.opcode = x64.MOV;
    movC.dst    = isa.make_mem(x64.R11, 0, -1, 0, 8);
    movC.src1   = isa.make_mem(x64.R10, 8, -1, 0, 8);
    movC.size   = 8;
    if (encode_inst(?movC, ?bufC) != 0) { bad = 1; }
    enc.buf_dnit(?bufC);

    ret bad;
}

test imm_fits_width__signed_and_unsigned_boundaries {
    var bad: i32 = 0;
    if (!imm_fits_width(255, 1))                { bad = 1; }
    or (imm_fits_width(256, 1))                 { bad = 1; }
    or (!imm_fits_width(-128, 1))               { bad = 1; }
    or (imm_fits_width(-129, 1))                { bad = 1; }
    or (!imm_fits_width(65535, 2))              { bad = 1; }
    or (imm_fits_width(65536, 2))               { bad = 1; }
    or (!imm_fits_width(4294967295, 4))         { bad = 1; }
    or (imm_fits_width(4294967296, 4))          { bad = 1; }
    or (!imm_fits_width(-2147483648, 4))        { bad = 1; }
    or (imm_fits_width(-2147483649, 4))         { bad = 1; }
    or (!imm_fits_width(0x7FFFFFFFFFFFFFFF, 8)) { bad = 1; }
    ret bad;
}

# a register or memory destination refuses an immediate past its width and takes one at the edge
test encode_alu__refuses_immediate_that_does_not_fit {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var buf1: enc.ByteBuf = enc.buf_init(?alloc);
    var m1:   isa.Inst    = isa.inst_blank();
    m1.opcode = x64.ADD;
    m1.dst    = isa.make_reg(x64.RAX, 4);
    m1.src1   = isa.make_imm(8589934592, 4);
    m1.size   = 4;
    if (encode_inst(?m1, ?buf1) != 0) { bad = 1; }
    if (buf1.len != 0)                { bad = 1; }
    m1.src1 = isa.make_imm(4294967295, 4);
    if (encode_inst(?m1, ?buf1) == 0) { bad = 2; }
    enc.buf_dnit(?buf1);

    var buf2: enc.ByteBuf = enc.buf_init(?alloc);
    var m2:   isa.Inst    = isa.inst_blank();
    m2.opcode = x64.ADD;
    m2.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 4);
    m2.src1   = isa.make_imm(4294967296, 4);
    m2.size   = 4;
    if (encode_inst(?m2, ?buf2) != 0) { bad = 3; }
    if (buf2.len != 0)                { bad = 3; }
    m2.src1 = isa.make_imm(4294967295, 4);
    if (encode_inst(?m2, ?buf2) == 0) { bad = 4; }
    enc.buf_dnit(?buf2);
    ret bad;
}

# a byte register refuses an immediate past a byte and takes -1; a dword
# memory destination refuses one past 32 bits and takes all ones
test encode_mov__refuses_immediate_that_does_not_fit {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var buf0: enc.ByteBuf = enc.buf_init(?alloc);
    var m0:   isa.Inst    = isa.inst_blank();
    m0.opcode = x64.MOV;
    m0.dst    = isa.make_reg(x64.RAX, 1);
    m0.src1   = isa.make_imm(300, 1);
    m0.size   = 1;
    if (encode_inst(?m0, ?buf0) != 0) { bad = 1; }
    if (buf0.len != 0)                { bad = 1; }
    m0.src1 = isa.make_imm(-1, 1);
    val n0: i32 = encode_inst(?m0, ?buf0);
    if (n0 != 2)              { bad = 1; }
    or (buf0.data[1] != 0xFF) { bad = 1; }
    enc.buf_dnit(?buf0);

    var buf1: enc.ByteBuf = enc.buf_init(?alloc);
    var m1:   isa.Inst    = isa.inst_blank();
    m1.opcode = x64.MOV;
    m1.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 4);
    m1.src1   = isa.make_imm(4294967296, 4);
    m1.size   = 4;
    if (encode_inst(?m1, ?buf1) != 0) { bad = 1; }
    if (buf1.len != 0)                { bad = 1; }
    enc.buf_dnit(?buf1);

    var buf2: enc.ByteBuf = enc.buf_init(?alloc);
    var m2:   isa.Inst    = isa.inst_blank();
    m2.opcode = x64.MOV;
    m2.dst    = isa.make_mem(x64.RAX, 0, -1, 0, 4);
    m2.src1   = isa.make_imm(4294967295, 4);
    m2.size   = 4;
    val n2: i32 = encode_inst(?m2, ?buf2);
    if (n2 != 6)              { bad = 1; }
    or (buf2.data[0] != 0xC7) { bad = 1; }
    or (buf2.data[2] != 0xFF) { bad = 1; }
    or (buf2.data[5] != 0xFF) { bad = 1; }
    enc.buf_dnit(?buf2);
    ret bad;
}

test encode_test__refuses_immediate_that_does_not_fit {
    var alloc: A.Allocator;
