    var m1: isa.Inst = isa.inst_blank();
    m1.opcode = x64.ADD;
    m1.dst    = isa.make_reg(x64.RAX, 4);
    m1.src1   = isa.make_imm(8589934592, 4);
    m1.size   = 4;
    if (encode_inst(?m1, ?buf1) != 0) { bad = 1; }
    if (buf1.len != 0) { bad = 1; }
    enc.buf_dnit(?buf1);

    var buf2: enc.ByteBuf = enc.buf_init(?alloc);
    var m2: isa.Inst = isa.inst_blank();
    m2.opcode = x64.ADD;
    m2.dst    = isa.make_reg(x64.RAX, 4);
    m2.src1   = isa.make_imm(4294967295, 4);
    m2.size   = 4;
