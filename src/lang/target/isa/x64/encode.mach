test "mach.lang.target.isa.x64.encode.emit_packed_op:rejects_non_reg_mem_source" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val bad: isa.Operand = isa.make_imm(0, 16);
    val r: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, bad, ?buf);
    var fail: i32 = 0;
    if (!R.is_err[R.Void, str](r)) { fail = 1; }
    or (!str_equals(R.unwrap_err[R.Void, str](r), "encode: packed vector op source is not a register or aligned frame slot")) { fail = 1; }
    enc.buf_dnit(?buf);
    ret fail;
}

test "mach.lang.target.isa.x64.encode.emit_packed_op:accepts_reg_and_mem_source" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val rr: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, vec_reg(FLOAT_SCRATCH1), ?buf);
    val mem: isa.Operand = isa.make_mem(x64.RBP, -16, -1, 0, 16);
    val rm: R.Result[R.Void, str] = emit_packed_op(x64.PXOR, FLOAT_SCRATCH0, mem, ?buf);
    var fail: i32 = 0;
    if (R.is_err[R.Void, str](rr)) { fail = 1; }
    or (R.is_err[R.Void, str](rm)) { fail = 1; }
    enc.buf_dnit(?buf);
    ret fail;
}

test "mach.lang.target.isa.x64.encode.check_accounted:rejects_unrendered_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;

    var sink: enc.AsmSink = enc.sink_init(nil, nil);
    st.buf.asm = ?sink;

    var bad: i32 = 0;

    if (R.is_err[R.Void, str](check_accounted(?st, x64.NOP))) { bad = 1; }

    enc.emit_byte(?st.buf, 0x90);
    if (!R.is_err[R.Void, str](check_accounted(?st, x64.NOP))) { bad = 1; }

    enc.sink_claim(?st.buf, 0);
    if (R.is_err[R.Void, str](check_accounted(?st, x64.NOP))) { bad = 1; }

    enc.emit_byte(?st.buf, 0x90);
    enc.emit_byte(?st.buf, 0x90);
    enc.sink_claim(?st.buf, 2);
    if (!R.is_err[R.Void, str](check_accounted(?st, x64.NOP))) { bad = 1; }

    st.buf.asm = nil;
    enc.emit_byte(?st.buf, 0x90);
    if (R.is_err[R.Void, str](check_accounted(?st, x64.NOP))) { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}

fun xmm_op(idx: i32) mir.MirOperand {
    ret mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_XMM, idx)::u32);
}

test "mach.lang.target.isa.x64.encode.encode_float_arith:two_address_shapes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    val buf: *enc.ByteBuf = ?st.buf;
    var f: mir.MirFunction;
    var bad: i32 = 0;

    var mops: [3]mir.MirOperand;
    mops[0] = xmm_op(x64.XMM2); mops[1] = xmm_op(x64.XMM0); mops[2] = xmm_op(x64.XMM1);
    var mul: mir.MirInstr = mir.instr(mir.MIR_FMUL, ?mops[0], 3, 4, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?mul);
    if (buf.len != 8)         { bad = 1; }
    or (buf.data[0] != 0xF3)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x10)  { bad = 1; }
    or (buf.data[3] != 0xD0)  { bad = 1; }
    or (buf.data[4] != 0xF3)  { bad = 1; }
    or (buf.data[5] != 0x0F)  { bad = 1; }
    or (buf.data[6] != 0x59)  { bad = 1; }
    or (buf.data[7] != 0xD1)  { bad = 1; }

    var aops: [3]mir.MirOperand;
    aops[0] = xmm_op(x64.XMM3); aops[1] = xmm_op(x64.XMM3); aops[2] = xmm_op(x64.XMM1);
    var add: mir.MirInstr = mir.instr(mir.MIR_FADD, ?aops[0], 3, 4, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?add);
    if (buf.len != 4)         { bad = 1; }
    or (buf.data[0] != 0xF3)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x58)  { bad = 1; }
    or (buf.data[3] != 0xD9)  { bad = 1; }

    var sops: [3]mir.MirOperand;
    sops[0] = xmm_op(x64.XMM1); sops[1] = xmm_op(x64.XMM0); sops[2] = xmm_op(x64.XMM1);
    var sub: mir.MirInstr = mir.instr(mir.MIR_FSUB, ?sops[0], 3, 4, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?sub);
    if (buf.len != 14)         { bad = 1; }
    or (buf.data[0]  != 0xF3)  { bad = 1; }
    or (buf.data[1]  != 0x44)  { bad = 1; }
    or (buf.data[2]  != 0x0F)  { bad = 1; }
    or (buf.data[3]  != 0x10)  { bad = 1; }
    or (buf.data[4]  != 0xF9)  { bad = 1; }
    or (buf.data[5]  != 0xF3)  { bad = 1; }
    or (buf.data[6]  != 0x0F)  { bad = 1; }
    or (buf.data[7]  != 0x10)  { bad = 1; }
    or (buf.data[8]  != 0xC8)  { bad = 1; }
    or (buf.data[9]  != 0xF3)  { bad = 1; }
    or (buf.data[10] != 0x41)  { bad = 1; }
    or (buf.data[11] != 0x0F)  { bad = 1; }
    or (buf.data[12] != 0x5C)  { bad = 1; }
    or (buf.data[13] != 0xCF)  { bad = 1; }

    var dops: [3]mir.MirOperand;
    dops[0] = xmm_op(x64.XMM2); dops[1] = xmm_op(x64.XMM0);
    dops[2] = mir.op_mem_preg(x64.RBP::u32, -8);
    var dv: mir.MirInstr = mir.instr(mir.MIR_FDIV, ?dops[0], 3, 8, 0);
    buf.len = 0;
    encode_float_arith(?st, ?f, ?dv);
    if (buf.len != 9)         { bad = 1; }
    or (buf.data[0] != 0xF2)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x10)  { bad = 1; }
    or (buf.data[3] != 0xD0)  { bad = 1; }
    or (buf.data[4] != 0xF2)  { bad = 1; }
    or (buf.data[5] != 0x0F)  { bad = 1; }
    or (buf.data[6] != 0x5E)  { bad = 1; }
    or (buf.data[7] != 0x55)  { bad = 1; }
    or (buf.data[8] != 0xF8)  { bad = 1; }

    enc.buf_dnit(buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_float_cmp:operands_in_place" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    val buf: *enc.ByteBuf = ?st.buf;
    var f: mir.MirFunction;
    var bad: i32 = 0;

    var gops: [3]mir.MirOperand;
    gops[0] = mir.op_preg(x64.RAX::u32); gops[1] = xmm_op(x64.XMM0); gops[2] = xmm_op(x64.XMM1);
    var gt: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?gops[0], 3, 4, mir.FCC_GT);
    buf.len = 0;
    encode_float_cmp(?st, ?f, ?gt);
    if (buf.len != 10)        { bad = 1; }
    or (buf.data[0] != 0x0F)  { bad = 1; }
    or (buf.data[1] != 0x2E)  { bad = 1; }
    or (buf.data[2] != 0xC1)  { bad = 1; }

    var lops: [3]mir.MirOperand;
    lops[0] = mir.op_preg(x64.RAX::u32); lops[1] = xmm_op(x64.XMM0); lops[2] = xmm_op(x64.XMM1);
    var lt: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?lops[0], 3, 4, mir.FCC_LT);
    buf.len = 0;
    encode_float_cmp(?st, ?f, ?lt);
    if (buf.len != 10)        { bad = 1; }
    or (buf.data[0] != 0x0F)  { bad = 1; }
    or (buf.data[1] != 0x2E)  { bad = 1; }
    or (buf.data[2] != 0xC8)  { bad = 1; }

    enc.buf_dnit(buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_fp_mov:single_instruction_shapes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var bad: i32 = 0;

    var rr: isa.Inst = isa.inst_blank();
    rr.opcode = x64.MOV;
    rr.size   = 8;
    rr.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    rr.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM5), 16);
    buf.len = 0;
    encode_mov(?rr, ?buf);
    if (buf.len != 4)         { bad = 1; }
    or (buf.data[0] != 0xF2)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x10)  { bad = 1; }
    or (buf.data[3] != 0xDD)  { bad = 1; }

    var ld: isa.Inst = isa.inst_blank();
    ld.opcode = x64.MOV;
    ld.size   = 4;
    ld.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    ld.src1   = isa.make_mem(x64.RBP, -16, -1, 0, 4);
    buf.len = 0;
    encode_mov(?ld, ?buf);
    if (buf.len != 5)         { bad = 1; }
    or (buf.data[0] != 0xF3)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x10)  { bad = 1; }
    or (buf.data[3] != 0x5D)  { bad = 1; }
    or (buf.data[4] != 0xF0)  { bad = 1; }

    var st: isa.Inst = isa.inst_blank();
    st.opcode = x64.MOV;
    st.size   = 4;
    st.dst    = isa.make_mem(x64.RBP, -16, -1, 0, 4);
    st.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    buf.len = 0;
    encode_mov(?st, ?buf);
    if (buf.len != 5)         { bad = 1; }
    or (buf.data[0] != 0xF3)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x11)  { bad = 1; }
    or (buf.data[3] != 0x5D)  { bad = 1; }
    or (buf.data[4] != 0xF0)  { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

fun t_refused(r: R.Result[R.Void, str], buf: *enc.ByteBuf) bool {
    if (!R.is_err[R.Void, str](r)) { ret false; }
    ret buf.len == 0;
}

fun t_accepted(r: R.Result[R.Void, str], buf: *enc.ByteBuf) bool {
    if (R.is_err[R.Void, str](r)) { ret false; }
    ret buf.len > 0;
}

fun t_refused_n(r: R.Result[i32, str], buf: *enc.ByteBuf) bool {
    if (!R.is_err[i32, str](r)) { ret false; }
    ret buf.len == 0;
}

fun t_accepted_n(r: R.Result[i32, str], buf: *enc.ByteBuf) bool {
    if (R.is_err[i32, str](r)) { ret false; }
    if (buf.len == 0)          { ret false; }
    ret R.unwrap_ok[i32, str](r)::usize == buf.len;
}

test "mach.lang.target.isa.x64.encode:fneg_sign_mask_is_pooled" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?itn;
    val buf: *enc.ByteBuf = ?st.buf;
    var f: mir.MirFunction;
    var bad: i32 = 0;

    var ops: [2]mir.MirOperand;
    ops[0] = xmm_op(x64.XMM0); ops[1] = xmm_op(x64.XMM1);
    var ng: mir.MirInstr = mir.instr(mir.MIR_FNEG, ?ops[0], 2, 8, 0);
    buf.len = 0;
    if (R.is_err[R.Void, str](encode_float_neg(?st, ?f, ?ng))) { bad = 1; }
    if (buf.len != 11) { bad = 1; }
    or {
        if (buf.data[4] != 0x0F || buf.data[5] != 0x57 || buf.data[6] != 0x05) { bad = 1; }
    }
    if (st.reloc_count != 1)            { bad = 1; }
    or {
        if (st.relocs[0].kind != of.RK_PC32)      { bad = 1; }
        if (st.relocs[0].offset != 7)             { bad = 1; }
        if (st.relocs[0].sym != st.consts[0].sym) { bad = 1; }
    }

    if (st.const_count != 1)                                     { bad = 1; }
    or {
        if (st.consts[0].len != 16 || st.consts[0].align != 16)  { bad = 1; }
        if (st.consts[0].kind != enc.CONST_VEC)                  { bad = 1; }
        or {
            var i: u32 = 0;
            for (i < 7) { if (st.consts[0].bytes[i] != 0) { bad = 1; } i = i + 1; }
            if (st.consts[0].bytes[7] != 0x80)                   { bad = 1; }
            i = 8;
            for (i < 16) { if (st.consts[0].bytes[i] != 0) { bad = 1; } i = i + 1; }
        }
    }

    buf.len = 0;
    if (R.is_err[R.Void, str](encode_float_neg(?st, ?f, ?ng))) { bad = 1; }
    if (st.const_count != 1) { bad = 1; }

    ng.width = 4;
    buf.len = 0;
    if (R.is_err[R.Void, str](encode_float_neg(?st, ?f, ?ng))) { bad = 1; }
    if (st.const_count != 2)                                     { bad = 1; }
    or {
        if (st.consts[1].len != 16 || st.consts[1].align != 16)  { bad = 1; }
        if (st.consts[1].bytes[3] != 0x80)                       { bad = 1; }
        if (st.consts[1].bytes[7] != 0)                          { bad = 1; }
    }

    ret bad;
}

test "mach.lang.target.isa.x64.encode:float_access_width_refusals_emit_nothing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    val buf: *enc.ByteBuf = ?st.buf;
    var bad: i32 = 0;

    val slot: isa.Operand = isa.make_mem(x64.RBX, 16, -1, 0, 8);
    val xmm0: i32 = isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM0);

    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 16, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 32, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 1, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_reg_or_slot_load(slot, xmm0, 0, buf), buf)) { bad = 1; }

    buf.len = 0;
    if (!t_accepted(emit_float_reg_or_slot_load(slot, xmm0, 4, buf), buf)) { bad = 1; }
    if (buf.len != 5) { bad = 1; }
    or {
        if (buf.data[0] != 0xF3 || buf.data[1] != 0x0F || buf.data[2] != 0x10) { bad = 1; }
        if (buf.data[3] != 0x43 || buf.data[4] != 0x10) { bad = 1; }
    }
    buf.len = 0;
    if (!t_accepted(emit_float_reg_or_slot_load(slot, xmm0, 8, buf), buf)) { bad = 1; }
    if (buf.len != 5) { bad = 1; }
    or {
        if (buf.data[0] != 0xF2 || buf.data[1] != 0x0F || buf.data[2] != 0x10) { bad = 1; }
        if (buf.data[3] != 0x43 || buf.data[4] != 0x10) { bad = 1; }
    }

    buf.len = 0;
    if (!t_refused(emit_float_store(slot, xmm0, 16, buf), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_refused(emit_float_store(slot, xmm0, 3, buf), buf))  { bad = 1; }
    buf.len = 0;
    if (!t_accepted(emit_float_store(slot, xmm0, 4, buf), buf))  { bad = 1; }
    if (buf.len != 5) { bad = 1; }
    or {
        if (buf.data[0] != 0xF3 || buf.data[1] != 0x0F || buf.data[2] != 0x11) { bad = 1; }
        if (buf.data[3] != 0x43 || buf.data[4] != 0x10) { bad = 1; }
    }
    buf.len = 0;
    if (!t_accepted(emit_float_store(slot, xmm0, 8, buf), buf))  { bad = 1; }

    buf.len = 0;
    if (!t_refused(emit_float_load(?st, slot, xmm0, 16), buf)) { bad = 1; }
    buf.len = 0;
    if (!t_accepted(emit_float_load(?st, slot, xmm0, 8), buf))  { bad = 1; }

    buf.len = 0;
    val c16: R.Result[isa.Operand, str] = float_const_operand(?st, 0, xmm0, 16);
    if (!R.is_err[isa.Operand, str](c16) || buf.len != 0) { bad = 1; }
    buf.len = 0;
    val c0: R.Result[isa.Operand, str] = float_const_operand(?st, 0, xmm0, 3);
    if (!R.is_err[isa.Operand, str](c0) || buf.len != 0) { bad = 1; }
    buf.len = 0;
    val c4: R.Result[isa.Operand, str] = float_const_operand(?st, 0, xmm0, 4);
    if (R.is_err[isa.Operand, str](c4) || buf.len == 0) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode:float_width_refusals_emit_nothing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?itn;
    val buf: *enc.ByteBuf = ?st.buf;
    var f: mir.MirFunction;
    var bad: i32 = 0;

    var mv: isa.Inst = isa.inst_blank();
    mv.opcode = x64.MOV;
    mv.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3), 16);
    mv.src1   = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM5), 16);
    mv.size   = 12; buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 32; buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 0;  buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 1;  buf.len = 0;
    if (!t_refused_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }

    mv.size = 4;  buf.len = 0;
    if (!t_accepted_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 8;  buf.len = 0;
    if (!t_accepted_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }
    mv.size = 16; buf.len = 0;
    if (!t_accepted_n(encode_fp_mov(?mv, buf), buf)) { bad = 1; }

    var cops: [2]mir.MirOperand;
    cops[0] = mir.op_preg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM3)::u32);
    cops[1] = mir.op_imm(0);
    var cn: mir.MirInstr = mir.instr(x64.MOV::u32, ?cops[0], 2, 16, 0);
    buf.len = 0;
    if (!t_refused(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 32; buf.len = 0;
    if (!t_refused(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 0;  buf.len = 0;
    if (!t_refused(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 4;  buf.len = 0;
    if (!t_accepted(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }
    cn.width = 8;  buf.len = 0;
    if (!t_accepted(encode_float_const_mov(?st, ?f, ?cn), buf)) { bad = 1; }

    var aops: [3]mir.MirOperand;
    aops[0] = xmm_op(x64.XMM2); aops[1] = xmm_op(x64.XMM0); aops[2] = xmm_op(x64.XMM1);
    var ar: mir.MirInstr = mir.instr(mir.MIR_FMUL, ?aops[0], 3, 16, 0);
    buf.len = 0;
    if (!t_refused(encode_float_arith(?st, ?f, ?ar), buf)) { bad = 1; }
    ar.width = 4; buf.len = 0;
    if (!t_accepted(encode_float_arith(?st, ?f, ?ar), buf)) { bad = 1; }

    var nops: [2]mir.MirOperand;
    nops[0] = xmm_op(x64.XMM2); nops[1] = xmm_op(x64.XMM0);
    var ng: mir.MirInstr = mir.instr(mir.MIR_FNEG, ?nops[0], 2, 16, 0);
    buf.len = 0;
    if (!t_refused(encode_float_neg(?st, ?f, ?ng), buf)) { bad = 1; }
    ng.width = 8; buf.len = 0;
    if (!t_accepted(encode_float_neg(?st, ?f, ?ng), buf)) { bad = 1; }

    var mops: [3]mir.MirOperand;
    mops[0] = mir.op_preg(x64.RAX::u32); mops[1] = xmm_op(x64.XMM0); mops[2] = xmm_op(x64.XMM1);
    var cm: mir.MirInstr = mir.instr(mir.MIR_FCMP, ?mops[0], 3, 16, mir.FCC_GT);
    buf.len = 0;
    if (!t_refused(encode_float_cmp(?st, ?f, ?cm), buf)) { bad = 1; }
    cm.width = 4; buf.len = 0;
    if (!t_accepted(encode_float_cmp(?st, ?f, ?cm), buf)) { bad = 1; }

    var vops: [2]mir.MirOperand;
    vops[0] = xmm_op(x64.XMM2); vops[1] = xmm_op(x64.XMM0);
    var cv: mir.MirInstr = mir.instr(mir.MIR_FP_TRUNC, ?vops[0], 2, 16, 0);
    cv.src_width = 8; buf.len = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?cv), buf)) { bad = 1; }
    cv.width = 4; cv.src_width = 16; buf.len = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?cv), buf)) { bad = 1; }
    cv.width = 4; cv.src_width = 8; buf.len = 0;
    if (!t_accepted(encode_float_conv(?st, ?f, ?cv), buf)) { bad = 1; }

    var iops: [2]mir.MirOperand;
    iops[0] = xmm_op(x64.XMM2); iops[1] = mir.op_preg(x64.RCX::u32);
    var i2f: mir.MirInstr = mir.instr(mir.MIR_SI_TO_FP, ?iops[0], 2, 16, 0);
    i2f.src_width = 8; buf.len = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?i2f), buf)) { bad = 1; }
    i2f.width = 8; i2f.src_width = 1; buf.len = 0;
    if (!t_accepted(encode_float_conv(?st, ?f, ?i2f), buf)) { bad = 1; }

    var fops: [2]mir.MirOperand;
    fops[0] = mir.op_preg(x64.RCX::u32); fops[1] = xmm_op(x64.XMM0);
    var f2i: mir.MirInstr = mir.instr(mir.MIR_FP_TO_SI, ?fops[0], 2, 8, 0);
    f2i.src_width = 16; buf.len = 0;
    if (!t_refused(encode_float_conv(?st, ?f, ?f2i), buf)) { bad = 1; }
    f2i.width = 1; f2i.src_width = 8; buf.len = 0;
    if (!t_accepted(encode_float_conv(?st, ?f, ?f2i), buf)) { bad = 1; }

    enc.buf_dnit(buf);
    ret bad;
}

pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code == x64.MOV::u32 || code == x64.MOVZX::u32 || code == x64.MOVSX::u32 ||
        code == x64.LEA::u32 || code == x64.PUSH::u32  || code == x64.POP::u32 ||
        code == x64.XCHG::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.ADD::u32 || code == x64.SUB::u32 || code == x64.AND::u32 ||
        code == x64.OR::u32  || code == x64.XOR::u32 || code == x64.CMP::u32 ||
        code == x64.TEST::u32 || code == x64.NEG::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.INC::u32 || code == x64.DEC::u32) {
        ret ct.flags_written(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.NOT::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.SETB::u32 || code == x64.SETAE::u32) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.SHL::u32 || code == x64.SHR::u32 || code == x64.SAR::u32) {
        ret ct.flags_written(ct.asm_op(ct.CT_OP_VAR_SHIFT));
    }
    if (code == x64.CMPXCHG::u32 || code == x64.XADD::u32) {
        ret ct.flags_defined(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.MFENCE::u32 || code == x64.PAUSE::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.IN::u32    || code == x64.OUT::u32   || code == x64.CLI::u32 ||
        code == x64.STI::u32   || code == x64.LIDT::u32  || code == x64.RDTSC::u32 ||
        code == x64.RDMSR::u32 || code == x64.WRMSR::u32 || code == x64.CLD::u32 ||
        code == x64.SWAPGS::u32 || code == x64.MOV_CR::u32 || code == x64.MOV_SEG::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.POPFQ::u32 || code == x64.IRETQ::u32 || code == x64.SYSCALL::u32) {
        ret ct.flags_opaque(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.PUSHFQ::u32) {
        ret ct.flags_read(ct.asm_op(ct.CT_OP_NONE));
    }

    if (code == x64.JMP::u32 || code == x64.CALL::u32) {
        ret ct.untouched_branch_reg();
    }
    if (code == x64.RET::u32 ||
        code == x64.NOP::u32 || code == x64.HLT::u32 || code == x64.UD2::u32) {
        ret ct.flags_untouched(ct.asm_op(ct.CT_OP_NONE));
    }
    if (code == x64.JE::u32  || code == x64.JNE::u32 || code == x64.JB::u32 ||
        code == x64.JAE::u32) {
        ret ct.asm_branch_flags();
    }
    ret ct.asm_unknown();
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:every_grammar_row_is_classified" {
    var bad: i32 = 0;
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val cls: ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        if (!cls.known) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:every_grammar_row_states_flags" {
    var bad: i32 = 0;
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val cls: ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        if (!cls.flags_stated) { bad = 1; }
        if (cls.defines_flags && !cls.writes_flags) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:flag_reader_set_is_exactly_fifteen" {
    var readers: [15]str;
    readers[0]  = "je";   readers[1]  = "jz";   readers[2]  = "jne";
    readers[3]  = "jnz";  readers[4]  = "jc";   readers[5]  = "jb";
    readers[6]  = "jnc";  readers[7]  = "jae";  readers[8]  = "jnb";
    readers[9]  = "setc"; readers[10] = "setb"; readers[11] = "setnc";
    readers[12] = "setae"; readers[13] = "setnb"; readers[14] = "pushfq";

    var bad: i32 = 0;
    var found: u32 = 0;
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val nm: str = X64_MNEMONICS[i].name;
        val cls: ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        val is_reader: bool = cls.cond_flags || cls.reads_flags;

        var listed: bool = false;
        var j: usize = 0;
        for (j < 15) {
            if (str_equals(nm, readers[j])) { listed = true; }
            j = j + 1;
        }
        if (is_reader && !listed)  { bad = 1; }
        if (!is_reader && listed)  { bad = 1; }
        if (listed) { found = found + 1; }
        i = i + 1;
    }
    if (found != 15) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:permitting_surface_is_bounded" {
    var bad: i32 = 0;
    var defines: u32 = 0;
    var opaque: u32 = 0;
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val cls: ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        if (cls.defines_flags) { defines = defines + 1; }
        if (cls.opaque_flags)  { opaque  = opaque + 1; }
        i = i + 1;
    }
    if (defines != 12) { bad = 1; }
    if (opaque != 3) { bad = 1; }

    if (!asm_ct_class(x64.ADD::u32, 0).defines_flags)     { bad = 1; }
    if (!asm_ct_class(x64.SUB::u32, 0).defines_flags)     { bad = 1; }
    if (!asm_ct_class(x64.CMP::u32, 0).defines_flags)     { bad = 1; }
    if (!asm_ct_class(x64.TEST::u32, 0).defines_flags)    { bad = 1; }
    if (!asm_ct_class(x64.AND::u32, 0).defines_flags)     { bad = 1; }
    if (!asm_ct_class(x64.OR::u32, 0).defines_flags)      { bad = 1; }
    if (!asm_ct_class(x64.XOR::u32, 0).defines_flags)     { bad = 1; }
    if (!asm_ct_class(x64.NEG::u32, 0).defines_flags)     { bad = 1; }
    if (!asm_ct_class(x64.CMPXCHG::u32, 0).defines_flags) { bad = 1; }
    if (!asm_ct_class(x64.XADD::u32, 0).defines_flags)    { bad = 1; }
    if (!asm_ct_class(x64.POPFQ::u32, 0).opaque_flags)    { bad = 1; }
    if (!asm_ct_class(x64.IRETQ::u32, 0).opaque_flags)    { bad = 1; }
    if (!asm_ct_class(x64.SYSCALL::u32, 0).opaque_flags)  { bad = 1; }

    if (asm_ct_class(x64.INC::u32, 0).defines_flags) { bad = 1; }
    if (asm_ct_class(x64.DEC::u32, 0).defines_flags) { bad = 1; }
    if (asm_ct_class(x64.SHL::u32, 0).defines_flags) { bad = 1; }
    if (asm_ct_class(x64.SHR::u32, 0).defines_flags) { bad = 1; }
    if (asm_ct_class(x64.SAR::u32, 0).defines_flags) { bad = 1; }
    if (!asm_ct_class(x64.INC::u32, 0).writes_flags) { bad = 1; }
    if (!asm_ct_class(x64.SHL::u32, 0).writes_flags) { bad = 1; }
    ret bad;
}

pub val PROBED_ROW_COUNT: usize = 26;

pub rec ProbedRow {
    code:   u32;
    zf_def: bool;
    cf_def: bool;
    reads:  bool;
}

fun probed(code: u32, zf: bool, cf: bool, reads: bool) ProbedRow {
    var r: ProbedRow;
    r.code = code; r.zf_def = zf; r.cf_def = cf; r.reads = reads;
    ret r;
}

pub fun probed_rows(out: *ProbedRow) u32 {
    out[0]  = probed(x64.ADD::u32,     true,  true,  false);
    out[1]  = probed(x64.SUB::u32,     true,  true,  false);
    out[2]  = probed(x64.CMP::u32,     true,  true,  false);
    out[3]  = probed(x64.TEST::u32,    true,  true,  false);
    out[4]  = probed(x64.AND::u32,     true,  true,  false);
    out[5]  = probed(x64.OR::u32,      true,  true,  false);
    out[6]  = probed(x64.XOR::u32,     true,  true,  false);
    out[7]  = probed(x64.NEG::u32,     true,  true,  false);
    out[8]  = probed(x64.NEG::u32,     true,  true,  false);
    out[9]  = probed(x64.XADD::u32,    true,  true,  false);
    out[10] = probed(x64.CMPXCHG::u32, true,  true,  false);
    out[11] = probed(x64.CMPXCHG::u32, true,  true,  false);
    out[12] = probed(x64.INC::u32,     true,  false, false);
    out[13] = probed(x64.DEC::u32,     true,  false, false);
    out[14] = probed(x64.SHL::u32,     true,  true,  false);
    out[15] = probed(x64.SHL::u32,     false, false, false);
    out[16] = probed(x64.SHR::u32,     false, false, false);
    out[17] = probed(x64.SAR::u32,     false, false, false);
    out[18] = probed(x64.NOT::u32,     false, false, false);
    out[19] = probed(x64.MOV::u32,     false, false, false);
    out[20] = probed(x64.LEA::u32,     false, false, false);
    out[21] = probed(x64.XCHG::u32,    false, false, false);
    out[22] = probed(x64.SETB::u32,    false, false, true);
    out[23] = probed(x64.SETAE::u32,   false, false, true);
    out[24] = probed(x64.JB::u32,      false, false, false);
    out[25] = probed(x64.PUSHFQ::u32,  false, false, true);
    ret PROBED_ROW_COUNT::u32;
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:agrees_with_measured_hardware" {
    var rows: [PROBED_ROW_COUNT]ProbedRow;
    val n: u32 = probed_rows(?rows[0]);

    var bad: i32 = 0;
    var i: u32 = 0;
    for (i < n) {
        val r: *ProbedRow = ?rows[i];
        val cls: ct.AsmClass = asm_ct_class(r.code, 0);

        if (!(r.zf_def && r.cf_def) && cls.defines_flags) { bad = 1; }

        if ((r.zf_def || r.cf_def) && !cls.writes_flags) { bad = 1; }

        if (r.reads && !cls.reads_flags) { bad = 1; }

        i = i + 1;
    }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:every_permitting_row_is_measured" {
    var rows: [PROBED_ROW_COUNT]ProbedRow;
    val n: u32 = probed_rows(?rows[0]);

    var bad: i32 = 0;
    var covered: u32 = 0;
    var exempt: u32 = 0;
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val code: u32 = X64_MNEMONICS[i].code;
        val cls: ct.AsmClass = asm_ct_class(code, X64_MNEMONICS[i].flags);

        if (cls.defines_flags || cls.opaque_flags || cls.reads_flags) {
            if (cls.opaque_flags) {
                if (code != x64.POPFQ::u32 && code != x64.IRETQ::u32
                    && code != x64.SYSCALL::u32) { bad = 1; }
                exempt = exempt + 1;
            }
            or {
                var found: bool = false;
                var j: u32 = 0;
                for (j < n) {
                    if (rows[j].code == code) { found = true; }
                    j = j + 1;
                }
                if (!found) { bad = 1; }
                covered = covered + 1;
            }
        }
        i = i + 1;
    }

    if (covered != 18) { bad = 1; }
    if (exempt  != 3)  { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_class:variable_latency_surface" {
    var bad: i32 = 0;

    if (asm_ct_class(x64.SHL::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SHR::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SAR::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (!ct.ct_op_gates_count_only(ct.CT_OP_VAR_SHIFT))      { bad = 1; }

    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val cls: ct.AsmClass = asm_ct_class(X64_MNEMONICS[i].code, X64_MNEMONICS[i].flags);
        if (cls.op == ct.CT_OP_INT_DIVMOD) { bad = 1; }
        if (cls.op == ct.CT_OP_INT_MUL)    { bad = 1; }
        if (cls.op == ct.CT_OP_FLOAT)      { bad = 1; }
        i = i + 1;
    }

    if (!asm_ct_class(x64.JE::u32, 0).cond_flags)  { bad = 1; }
    if (!asm_ct_class(x64.JNE::u32, 0).cond_flags) { bad = 1; }
    if (!asm_ct_class(x64.JB::u32, 0).cond_flags)  { bad = 1; }
    if (!asm_ct_class(x64.JAE::u32, 0).cond_flags) { bad = 1; }
    if (asm_ct_class(x64.JMP::u32, 0).cond_flags)  { bad = 1; }
    if (asm_ct_class(x64.JE::u32, 0).cond_reg)     { bad = 1; }

    ret bad;
}

pub fun asm_ct_scan(body: str, secret_names: *str, n_secret: u32,
                    trust_mul: bool, trust_shift: bool, alloc: *A.Allocator) R.Result[R.Void, str] {
    var g: iasm.Grammar = x64_grammar();
    ret iasm.ct_scan(?g, body, secret_names, n_secret, trust_mul, trust_shift);
}

fun asm_note_bytes(st: *enc.EncodeState, bytes: *u8, n: usize, start: usize) R.Result[R.Void, str] {
    ret enc.render_bytes_directive(?st.buf, bytes, n, start);
}

test "mach.lang.target.isa.x64.encode.render_bytes_directive:round_trips" {
    var want: [3]u8;
    want[0] = 0xEC; want[1] = 0x90; want[2] = 0x0F;
    if (!t_asm_bytes(".byte 0xec, 0x90, 0x0f", ?want[0], 3)) { ret 1; }

    var one: [1]u8;
    one[0] = 0xEC;
    if (!t_asm_bytes(".byte 0xec", ?one[0], 1)) { ret 1; }
    ret 0;
}

fun t_portio_inst(is_in: bool, acc_size: u8, port: isa.Operand) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = x64.OUT;
    if (is_in) { mi.opcode = x64.IN; }
    mi.size = acc_size;
    mi.dst  = port;
    mi.src1 = isa.make_reg(x64.RAX, acc_size);
    if (is_in) {
        mi.dst  = isa.make_reg(x64.RAX, acc_size);
        mi.src1 = port;
    }
    ret mi;
}

fun t_inst_writes_nothing(mi: *isa.Inst) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    enc.emit_byte(?buf, 0x90);
    val got: i32 = encode_inst(mi, ?buf);
    val ok: bool = got == 0 && buf.len == 1 && buf.data[0] == 0x90;
    enc.buf_dnit(?buf);
    ret ok;
}

test "mach.lang.target.isa.x64.encode.portio:rejected_operand_writes_nothing" {
    var bad: i32 = 0;

    var hi: isa.Inst = t_portio_inst(true, 2, isa.make_imm(0x1234, 2));
    if (!t_inst_writes_nothing(?hi)) { bad = 1; }

    var lo: isa.Inst = t_portio_inst(false, 2, isa.make_imm(-1, 2));
    if (!t_inst_writes_nothing(?lo)) { bad = 1; }

    var mem: isa.Inst = t_portio_inst(true, 2, isa.make_mem(x64.RDX, 0, -1, 0, 2));
    if (!t_inst_writes_nothing(?mem)) { bad = 1; }

    var wide: isa.Inst = t_portio_inst(true, 8, isa.make_reg(x64.RDX, 2));
    if (!t_inst_writes_nothing(?wide)) { bad = 1; }

    var good: isa.Inst = t_portio_inst(true, 2, isa.make_reg(x64.RDX, 2));
    var want: [2]u8; want[0] = 0x66; want[1] = 0xED;
    if (!t_inst_bytes(?good, ?want[0], 2)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.portio:byte_exact" {
    var bad: i32 = 0;

    var b1: [1]u8; b1[0] = 0xFA;
    if (!t_asm_bytes("cli", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xFB;
    if (!t_asm_bytes("sti", ?b1[0], 1)) { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x0F; b2[1] = 0x31;
    if (!t_asm_bytes("rdtsc", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0x32;
    if (!t_asm_bytes("rdmsr", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0x30;
    if (!t_asm_bytes("wrmsr", ?b2[0], 2)) { bad = 1; }

    b1[0] = 0xEC;
    if (!t_asm_bytes("in al, dx", ?b1[0], 1))   { bad = 1; }
    b1[0] = 0xED;
    if (!t_asm_bytes("in eax, dx", ?b1[0], 1))  { bad = 1; }
    b1[0] = 0xEE;
    if (!t_asm_bytes("out dx, al", ?b1[0], 1))  { bad = 1; }
    b1[0] = 0xEF;
    if (!t_asm_bytes("out dx, eax", ?b1[0], 1)) { bad = 1; }

    b2[0] = 0x66; b2[1] = 0xED;
    if (!t_asm_bytes("in ax, dx", ?b2[0], 2))   { bad = 1; }

    b2[0] = 0xE4; b2[1] = 0x60;
    if (!t_asm_bytes("in al, 0x60", ?b2[0], 2))   { bad = 1; }
    b2[0] = 0xE6; b2[1] = 0x60;
    if (!t_asm_bytes("out 0x60, al", ?b2[0], 2))  { bad = 1; }
    b2[0] = 0xE5; b2[1] = 0x60;
    if (!t_asm_bytes("in eax, 0x60", ?b2[0], 2))  { bad = 1; }

    var b3: [3]u8; b3[0] = 0x0F; b3[1] = 0x01; b3[2] = 0x18;
    if (!t_asm_bytes("lidt [rax]", ?b3[0], 3)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.freestanding:byte_exact" {
    var bad: i32 = 0;

    var b1: [1]u8;
    b1[0] = 0xFC;
    if (!t_asm_bytes("cld", ?b1[0], 1))    { bad = 1; }
    b1[0] = 0x9C;
    if (!t_asm_bytes("pushfq", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0x9D;
    if (!t_asm_bytes("popfq", ?b1[0], 1))  { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x48; b2[1] = 0xCF;
    if (!t_asm_bytes("iretq", ?b2[0], 2)) { bad = 1; }

    var b3: [3]u8;
    b3[0] = 0x0F; b3[1] = 0x01; b3[2] = 0xF8;
    if (!t_asm_bytes("swapgs", ?b3[0], 3)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.x64_xfer_target:jmp_indirect_forms_byte_exact" {
    var bad: i32 = 0;

    var reg_want: [2]u8;
    reg_want[0] = 0xFF; reg_want[1] = 0xE0;
    if (!t_asm_bytes("jmp rax", ?reg_want[0], 2)) { bad = 1; }
    reg_want[1] = 0xE1;
    if (!t_asm_bytes("jmp rcx", ?reg_want[0], 2)) { bad = 1; }

    var r11_want: [3]u8;
    r11_want[0] = 0x41; r11_want[1] = 0xFF; r11_want[2] = 0xE3;
    if (!t_asm_bytes("jmp r11", ?r11_want[0], 3)) { bad = 1; }

    var m0_want: [2]u8;
    m0_want[0] = 0xFF; m0_want[1] = 0x20;
    if (!t_asm_bytes("jmp [rax]", ?m0_want[0], 2)) { bad = 1; }

    var m8_want: [3]u8;
    m8_want[0] = 0xFF; m8_want[1] = 0x60; m8_want[2] = 0x08;
    if (!t_asm_bytes("jmp [rax + 8]", ?m8_want[0], 3)) { bad = 1; }

    var mi_want: [4]u8;
    mi_want[0] = 0xFF; mi_want[1] = 0x64; mi_want[2] = 0xD8; mi_want[3] = 0x10;
    if (!t_asm_bytes("jmp [rax + rbx*8 + 16]", ?mi_want[0], 4)) { bad = 1; }

    var abs_want: [7]u8;
    abs_want[0] = 0xFF; abs_want[1] = 0x24; abs_want[2] = 0x25;
    abs_want[3] = 0x18; abs_want[4] = 0x00; abs_want[5] = 0x10; abs_want[6] = 0x00;
    if (!t_asm_bytes("jmp [0x100018]", ?abs_want[0], 7)) { bad = 1; }

    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "jmp main", nil, nil, nil, nil);
    var item: iasm.Item;
    if (R.is_err[bool, str](iasm.next(?c, ?item)))  { ret 1; }
    if (item.ref != iasm.AR_SYM)                    { bad = 1; }
    val dm: isa.Inst = x64_build(?item, 9::intern.StrId);
    if (dm.opcode != x64.JMP)                       { bad = 1; }
    if ((dm.flags & x64.FLAG_INDIRECT::u16) != 0)   { bad = 1; }
    if (dm.dst.kind != isa.OPK_SYM)                 { bad = 1; }
    if (dm.dst.sym_id != 9)                         { bad = 1; }

    if (!t_asm_refused("jmp eax", "64-bit register"))     { bad = 1; }
    if (!t_asm_refused("jmp [main]", "symbol's address")) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.sysreg_moves:byte_exact" {
    var bad: i32 = 0;

    var b3: [3]u8;
    b3[0] = 0x0F; b3[1] = 0x20; b3[2] = 0xD0;
    if (!t_asm_bytes("mov rax, cr2", ?b3[0], 3)) { bad = 1; }
    b3[2] = 0xC0;
    if (!t_asm_bytes("mov rax, cr0", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0x22; b3[2] = 0xD8;
    if (!t_asm_bytes("mov cr3, rax", ?b3[0], 3)) { bad = 1; }

    var b4: [4]u8;
    b4[0] = 0x41; b4[1] = 0x0F; b4[2] = 0x20; b4[3] = 0xD9;
    if (!t_asm_bytes("mov r9, cr3", ?b4[0], 4)) { bad = 1; }
    b4[0] = 0x41; b4[1] = 0x0F; b4[2] = 0x22; b4[3] = 0xDA;
    if (!t_asm_bytes("mov cr3, r10", ?b4[0], 4)) { bad = 1; }
    b4[0] = 0x44; b4[1] = 0x0F; b4[2] = 0x20; b4[3] = 0xC0;
    if (!t_asm_bytes("mov rax, cr8", ?b4[0], 4)) { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x8C; b2[1] = 0xC8;
    if (!t_asm_bytes("mov eax, cs", ?b2[0], 2)) { bad = 1; }
    if (!t_asm_bytes("mov rax, cs", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0xE8;
    if (!t_asm_bytes("mov eax, gs", ?b2[0], 2)) { bad = 1; }
    b3[0] = 0x66; b3[1] = 0x8C; b3[2] = 0xC8;
    if (!t_asm_bytes("mov ax, cs", ?b3[0], 3)) { bad = 1; }

    if (!t_asm_refused("mov cs, rax", "segment register"))     { bad = 1; }
    if (!t_asm_refused("mov eax, cr2", "64-bit"))              { bad = 1; }
    if (!t_asm_refused("mov cr3, cr2", "two system"))          { bad = 1; }
    if (!t_asm_refused("mov rax, cr1", "bare-symbol"))         { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_clobbers:sysreg_moves" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("mov rax, cr2", ?gp, ?fp);
    if (gp != 1) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("mov cr3, rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("mov ecx, cs", ?gp, ?fp);
    if (gp != 2) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_clobbers:freestanding_writes_nothing" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers("cld\npushfq\npopfq\nswapgs\niretq", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("jmp rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0x0f, 0x01, 0xf8\n.byte 0x48, 0xcf", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.sized_memory_operands:byte_exact" {
    var bad: i32 = 0;

    var b3: [3]u8;
    b3[0] = 0x0F; b3[1] = 0xB7; b3[2] = 0x01;
    if (!t_asm_bytes("movzx eax, word [rcx]", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0xB6;
    if (!t_asm_bytes("movzx eax, byte [rcx]", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0xBF;
    if (!t_asm_bytes("movsx eax, word [rcx]", ?b3[0], 3)) { bad = 1; }

    var b4: [4]u8;
    b4[0] = 0x48; b4[1] = 0x0F; b4[2] = 0xB6; b4[3] = 0x01;
    if (!t_asm_bytes("movzx rax, byte [rcx]", ?b4[0], 4)) { bad = 1; }
    var sxd: [3]u8;
    sxd[0] = 0x48; sxd[1] = 0x63; sxd[2] = 0x01;
    if (!t_asm_bytes("movsx rax, dword [rcx]", ?sxd[0], 3)) { bad = 1; }

    var st4: [6]u8;
    st4[0] = 0xC7; st4[1] = 0x01;
    st4[2] = 0x01; st4[3] = 0x00; st4[4] = 0x00; st4[5] = 0x00;
    if (!t_asm_bytes("mov dword [rcx], 1", ?st4[0], 6)) { bad = 1; }
    var st2: [5]u8;
    st2[0] = 0x66; st2[1] = 0xC7; st2[2] = 0x01; st2[3] = 0x01; st2[4] = 0x00;
    if (!t_asm_bytes("mov word [rcx], 1", ?st2[0], 5)) { bad = 1; }
    var st1: [3]u8;
    st1[0] = 0xC6; st1[1] = 0x01; st1[2] = 0x01;
    if (!t_asm_bytes("mov byte [rcx], 1", ?st1[0], 3)) { bad = 1; }
    var st8: [7]u8;
    st8[0] = 0x48; st8[1] = 0xC7; st8[2] = 0x01;
    st8[3] = 0x01; st8[4] = 0x00; st8[5] = 0x00; st8[6] = 0x00;
    if (!t_asm_bytes("mov [rcx], 1", ?st8[0], 7)) { bad = 1; }

    var neg8: [3]u8;
    neg8[0] = 0x48; neg8[1] = 0xF7; neg8[2] = 0x19;
    if (!t_asm_bytes("neg qword [rcx]", ?neg8[0], 3)) { bad = 1; }
    var neg4: [2]u8;
    neg4[0] = 0xF7; neg4[1] = 0x19;
    if (!t_asm_bytes("neg dword [rcx]", ?neg4[0], 2)) { bad = 1; }
    var inc2: [3]u8;
    inc2[0] = 0x66; inc2[1] = 0xFF; inc2[2] = 0x00;
    if (!t_asm_bytes("inc word [rax]", ?inc2[0], 3)) { bad = 1; }

    var mv4: [2]u8;
    mv4[0] = 0x8B; mv4[1] = 0x01;
    if (!t_asm_bytes("mov eax, dword [rcx]", ?mv4[0], 2)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.sized_memory_operands:contradictions_refused" {
    var bad: i32 = 0;

    if (!t_asm_refused("mov eax, word [rcx]", "contradicts"))   { bad = 1; }
    if (!t_asm_refused("mov word [rcx], eax", "contradicts"))   { bad = 1; }
    if (!t_asm_refused("add rax, dword [rcx]", "contradicts"))  { bad = 1; }

    if (!t_asm_refused("movzx eax, dword [rcx]", "as wide"))    { bad = 1; }
    if (!t_asm_refused("movsx rax, qword [rcx]", "as wide"))    { bad = 1; }
    if (!t_asm_refused("movzx rax, dword [rcx]", "32-bit source form")) { bad = 1; }
    if (!t_asm_refused("movzx eax, [rcx]", "does not state the width")) { bad = 1; }

    if (!t_asm_refused("push dword [rax]", "fixed 64-bit"))     { bad = 1; }
    if (!t_asm_refused("pop word [rax]", "fixed 64-bit"))       { bad = 1; }
    if (!t_asm_refused("lidt qword [rax]", "no scalar width"))  { bad = 1; }

    if (!t_asm_refused("mov qword rax, rcx", "may only precede a memory operand")) { bad = 1; }
    if (!t_asm_refused("mov rax, dword 1", "may only precede a memory operand"))   { bad = 1; }

    var gp: u32 = 0;
    var fp: u32 = 0;
    asm_clobbers("lea rax, [word]", ?gp, ?fp);
    if (gp != 1) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.portio:classified_for_the_ct_walk" {
    var bad: i32 = 0;
    if (asm_ct_class(x64.IN::u32, 0).op    != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.OUT::u32, 0).op   != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.CLI::u32, 0).op   != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.STI::u32, 0).op   != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.LIDT::u32, 0).op  != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.RDTSC::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.RDMSR::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.WRMSR::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }

    if (asm_ct_class(x64.IN::u32, 0).cond_flags)  { bad = 1; }
    if (asm_ct_class(x64.RDTSC::u32, 0).cond_reg) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_returns:trap_ends_control" {
    var bad: i32 = 0;

    if (asm_returns("mov eax, 231\nsyscall\nhlt")) { bad = 1; }
    if (asm_returns("hlt"))                         { bad = 1; }

    if (!asm_returns("mov eax, 1\nsyscall"))  { bad = 1; }
    if (!asm_returns("nop"))                   { bad = 1; }
    if (!asm_returns("lock xadd [rcx], rax"))  { bad = 1; }

    if (!asm_returns("hlt\nnop")) { bad = 1; }

    if (!asm_returns("1:\nhlt")) { bad = 1; }

    if (!asm_returns(".byte 0xf4"))            { bad = 1; }
    if (!asm_returns(".byte 0xf4 :: writes()")){ bad = 1; }
    if (!asm_returns("this is not asm"))       { bad = 1; }
    if (!asm_returns(""))                      { bad = 1; }

    ret bad;
}
