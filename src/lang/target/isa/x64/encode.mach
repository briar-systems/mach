    or (buf.data[1] != 0x8B) { bad = 1; }
    or (buf.data[2] != 0x45) { bad = 1; }
    or (buf.data[3] != 0x00) { bad = 1; }
    enc.buf_dnit(?buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.encode_push:imm_boundaries" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var bad: i32 = 0;

    var m1: isa.Inst = isa.inst_blank();
    m1.opcode = x64.PUSH;
    m1.dst    = isa.make_imm(127, 1);
    m1.size   = 1;
    val n1: i32 = encode_inst(?m1, ?buf);
    if (n1 != 2)             { bad = 1; }
    if (buf.data[0] != 0x6A) { bad = 1; }
    if (buf.data[1] != 0x7F) { bad = 1; }

    buf.len = 0;
    var m2: isa.Inst = isa.inst_blank();
    m2.opcode = x64.PUSH;
    m2.dst    = isa.make_imm(0x1000, 4);
    m2.size   = 4;
    val n2: i32 = encode_inst(?m2, ?buf);
    if (n2 != 5)             { bad = 1; }
    if (buf.data[0] != 0x68) { bad = 1; }

    buf.len = 0;
    var m3: isa.Inst = isa.inst_blank();
    m3.opcode = x64.PUSH;
    m3.dst    = isa.make_imm(0x80000000, 8);
    m3.size   = 8;
    val n3: i32 = encode_inst(?m3, ?buf);
    if (n3 != 0) { bad = 1; }

    enc.buf_dnit(?buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.emit_stack_probe:chkstk_body" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    emit_stack_probe(?st, 12288, 4096);

    var want: [41]u8;
    want[0]  = 0x49; want[1]  = 0xc7; want[2]  = 0xc3; want[3]  = 0x00; want[4]  = 0x30; want[5]  = 0x00; want[6]  = 0x00;
    want[7]  = 0x48; want[8]  = 0x81; want[9]  = 0xec; want[10] = 0x00; want[11] = 0x10; want[12] = 0x00; want[13] = 0x00;
    want[14] = 0x4c; want[15] = 0x89; want[16] = 0x1c; want[17] = 0x24;
    want[18] = 0x49; want[19] = 0x81; want[20] = 0xeb; want[21] = 0x00; want[22] = 0x10; want[23] = 0x00; want[24] = 0x00;
    want[25] = 0x49; want[26] = 0x81; want[27] = 0xfb; want[28] = 0x00; want[29] = 0x10; want[30] = 0x00; want[31] = 0x00;
    want[32] = 0x0f; want[33] = 0x87; want[34] = 0xe1; want[35] = 0xff; want[36] = 0xff; want[37] = 0xff;
    want[38] = 0x4c; want[39] = 0x29; want[40] = 0xdc;

    val b: *u8   = st.buf.data;
    var bad: i32 = 0;
    if (st.buf.len != 41) { bad = 1; }
    or {
        var k: usize = 0;
        for (k < 41) {
            if (b[k] != want[k]) { bad = 1; brk; }
            k = k + 1;
        }
    }

    enc.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.needs_stack_probe:commit_model_boundary" {
    var win: tos.OsVTable;
    win.stack_probe = true;
    win.page_size   = 4096;
    var auto: tos.OsVTable;
    auto.stack_probe = false;
    auto.page_size   = 4096;

    var bad: i32 = 0;
    if (needs_stack_probe(auto.stack_probe, auto.page_size, 1))         { bad = 1; }
    or (needs_stack_probe(auto.stack_probe, auto.page_size, 1048576))   { bad = 1; }
    or (needs_stack_probe(win.stack_probe, win.page_size, 1))           { bad = 1; }
    or (needs_stack_probe(win.stack_probe, win.page_size, 4096))        { bad = 1; }
    or (!needs_stack_probe(win.stack_probe, win.page_size, 4097))       { bad = 1; }
    or (!needs_stack_probe(win.stack_probe, win.page_size, 1048576))    { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.x86_reloc_offset:legalized_disp32" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.buf = enc.buf_init(?alloc);

    var big: isa.Inst = isa.inst_blank();
    big.opcode   = x64.MOV;
    big.size     = 8;
    big.dst.kind = isa.OPK_MEM;
    big.dst.size = 8;
    big.src1     = isa.make_imm(0x100000000, 8);
    val big_sz: i32 = encode_mov(?big, ?st.buf);

    var small: isa.Inst = isa.inst_blank();
    small.opcode   = x64.MOV;
    small.size     = 8;
    small.dst.kind = isa.OPK_MEM;
    small.dst.size = 8;
    small.src1     = isa.make_imm(5, 8);
    val small_sz: i32 = encode_mov(?small, ?st.buf);

    var bad: i32 = 0;
    if (big_sz != 17)                                 { bad = 1; }
    or (trailing_imm_width(?big) != 0)                { bad = 1; }
    or (x86_reloc_offset(nil, ?big, big_sz) != 13)    { bad = 1; }
    or (small_sz != 11)                               { bad = 1; }
    or (trailing_imm_width(?small) != 4)              { bad = 1; }
    or (x86_reloc_offset(nil, ?small, small_sz) != 3) { bad = 1; }

    enc.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.vec:scratch_reg_encoding" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    val mem: isa.Operand = isa.make_mem(x64.RAX, 0, -1, 0, 16);
    emit_movups_load(FLOAT_SCRATCH0, mem, ?buf);
    var bad: i32 = 0;
    if (buf.len < 4)          { bad = 1; }
    or (buf.data[0] != 0x44)  { bad = 1; }
    or (buf.data[1] != 0x0F)  { bad = 1; }
    or (buf.data[2] != 0x10)  { bad = 1; }
    or (buf.data[3] != 0x30)  { bad = 1; }
    enc.buf_dnit(?buf);
    ret bad;
}

