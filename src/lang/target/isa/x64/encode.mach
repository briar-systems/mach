    b3[0] = 0x0F;
    b3[1] = 0xB7;
    b3[2] = 0x01;
    if (!t_asm_bytes("movzx eax, word [rcx]", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0xB6;
    if (!t_asm_bytes("movzx eax, byte [rcx]", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0xBF;
    if (!t_asm_bytes("movsx eax, word [rcx]", ?b3[0], 3)) { bad = 1; }

    var b4: [4]u8;
    b4[0] = 0x48;
    b4[1] = 0x0F;
    b4[2] = 0xB6;
    b4[3] = 0x01;
    if (!t_asm_bytes("movzx rax, byte [rcx]", ?b4[0], 4)) { bad = 1; }
    var sxd: [3]u8;
    sxd[0] = 0x48;
    sxd[1] = 0x63;
    sxd[2] = 0x01;
    if (!t_asm_bytes("movsx rax, dword [rcx]", ?sxd[0], 3)) { bad = 1; }

    var st4: [6]u8;
    st4[0] = 0xC7;
    st4[1] = 0x01;
    st4[2] = 0x01;
    st4[3] = 0x00;
    st4[4] = 0x00;
    st4[5] = 0x00;
    if (!t_asm_bytes("mov dword [rcx], 1", ?st4[0], 6)) { bad = 1; }
    var st2: [5]u8;
    st2[0] = 0x66;
    st2[1] = 0xC7;
    st2[2] = 0x01;
    st2[3] = 0x01;
    st2[4] = 0x00;
    if (!t_asm_bytes("mov word [rcx], 1", ?st2[0], 5)) { bad = 1; }
    var st1: [3]u8;
    st1[0] = 0xC6;
    st1[1] = 0x01;
    st1[2] = 0x01;
    if (!t_asm_bytes("mov byte [rcx], 1", ?st1[0], 3)) { bad = 1; }
    var st8: [7]u8;
    st8[0] = 0x48;
    st8[1] = 0xC7;
    st8[2] = 0x01;
    st8[3] = 0x01;
    st8[4] = 0x00;
    st8[5] = 0x00;
    st8[6] = 0x00;
    if (!t_asm_bytes("mov [rcx], 1", ?st8[0], 7)) { bad = 1; }

    var neg8: [3]u8;
    neg8[0] = 0x48;
    neg8[1] = 0xF7;
    neg8[2] = 0x19;
    if (!t_asm_bytes("neg qword [rcx]", ?neg8[0], 3)) { bad = 1; }
    var neg4: [2]u8;
    neg4[0] = 0xF7;
    neg4[1] = 0x19;
    if (!t_asm_bytes("neg dword [rcx]", ?neg4[0], 2)) { bad = 1; }
    var inc2: [3]u8;
    inc2[0] = 0x66;
    inc2[1] = 0xFF;
    inc2[2] = 0x00;
    if (!t_asm_bytes("inc word [rax]", ?inc2[0], 3)) { bad = 1; }

    var mv4: [2]u8;
    mv4[0] = 0x8B;
    mv4[1] = 0x01;
    if (!t_asm_bytes("mov eax, dword [rcx]", ?mv4[0], 2)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.sized_memory_operands:contradictions_refused" {
    var bad: i32 = 0;

    if (!t_asm_refused("mov eax, word [rcx]", "contradicts"))  { bad = 1; }
    if (!t_asm_refused("mov word [rcx], eax", "contradicts"))  { bad = 1; }
    if (!t_asm_refused("add rax, dword [rcx]", "contradicts")) { bad = 1; }

    if (!t_asm_refused("movzx eax, dword [rcx]", "as wide"))            { bad = 1; }
    if (!t_asm_refused("movsx rax, qword [rcx]", "as wide"))            { bad = 1; }
    if (!t_asm_refused("movzx rax, dword [rcx]", "32-bit source form")) { bad = 1; }
    if (!t_asm_refused("movzx eax, [rcx]", "does not state the width")) { bad = 1; }

    if (!t_asm_refused("push dword [rax]", "fixed 64-bit"))    { bad = 1; }
    if (!t_asm_refused("pop word [rax]", "fixed 64-bit"))      { bad = 1; }
    if (!t_asm_refused("lidt qword [rax]", "no scalar width")) { bad = 1; }

    if (!t_asm_refused("mov qword rax, rcx", "may only precede a memory operand")) { bad = 1; }
    if (!t_asm_refused("mov rax, dword 1", "may only precede a memory operand"))   { bad = 1; }

    var gp: u32 = 0;
    var fp: u32 = 0;
    asm_clobbers("lea rax, [word]", ?gp, ?fp);
    if (gp != 1) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.portio:classified_for_the_ct_walk" {
    var bad: i32 = 0;
    if (asm_ct_class(x64.IN::u32, 0).op != ct.CT_OP_NONE)    { bad = 1; }
    if (asm_ct_class(x64.OUT::u32, 0).op != ct.CT_OP_NONE)   { bad = 1; }
    if (asm_ct_class(x64.CLI::u32, 0).op != ct.CT_OP_NONE)   { bad = 1; }
    if (asm_ct_class(x64.STI::u32, 0).op != ct.CT_OP_NONE)   { bad = 1; }
    if (asm_ct_class(x64.LIDT::u32, 0).op != ct.CT_OP_NONE)  { bad = 1; }
    if (asm_ct_class(x64.RDTSC::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.RDMSR::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }
    if (asm_ct_class(x64.WRMSR::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }

    if (asm_ct_class(x64.IN::u32, 0).cond_flags)  { bad = 1; }
    if (asm_ct_class(x64.RDTSC::u32, 0).cond_reg) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_returns:trap_ends_control" {
    var bad: i32 = 0;

    if (asm_returns("mov eax, 231\nsyscall\nhlt")) { bad = 1; }
    if (asm_returns("hlt"))                        { bad = 1; }

    if (!asm_returns("mov eax, 1\nsyscall"))  { bad = 1; }
    if (!asm_returns("nop"))                  { bad = 1; }
    if (!asm_returns("lock xadd [rcx], rax")) { bad = 1; }

    if (!asm_returns("hlt\nnop")) { bad = 1; }

    if (!asm_returns("1:\nhlt")) { bad = 1; }

    if (!asm_returns(".byte 0xf4"))             { bad = 1; }
    if (!asm_returns(".byte 0xf4 :: writes()")) { bad = 1; }
    if (!asm_returns("this is not asm"))        { bad = 1; }
    if (!asm_returns(""))                       { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode:native_opcode_domain_refuses_unknown_and_truncated_aliases" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var interner: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?interner); }
    var st: enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?interner;
    fin { enc.buf_dnit(?st.buf); }
    var f:    mir.MirFunction;
    val name: res[intern.StrId, A.Error] = intern.intern(?interner, "opcode_probe");
    if (sel name.err) { ret 8; }
    f.name = name.ok;
    var instruction: mir.MirInstr   = mir.instr(x64.NOP::u32, nil, 0, 8, 0);
    val r_7881:      err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
    if (sel r_7881.err)  { ret 1; }
    if (st.buf.len != 1) { ret 2; }
    st.buf.len         = 0;
    instruction.opcode = isa.ISA_USE::u32;
    val r_7885: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
    if (sel r_7885.err)  { ret 3; }
    if (st.buf.len != 0) { ret 3; }
    var codes: [3]u32;
    codes[0] = 0xFFFA;
    codes[1] = 0x10000 | x64.NOP::u32;
    codes[2] = 0x10000 | isa.ISA_USE::u32;
    var messages: [3]str;
    messages[0] = "unknown x64.Opcode tag 65530 in 'opcode_probe'";
    messages[1] = "unknown x64.Opcode tag 65536 in 'opcode_probe'";
    messages[2] = "unknown x64.Opcode tag 131067 in 'opcode_probe'";
    var i: u32 = 0;
    for (i < 3) {
        instruction.opcode = codes[i];
        val refused: err[fail.Fail] = encode_mir_instr(?st, ?f, 0, ?instruction);
        if (sel refused.ok)                                         { ret 4; }
        if (!str_contains(fail.describe(refused.err), messages[i])) { ret 5; }
        if (st.buf.len != 0)                                        { ret 6; }
        i = i + 1;
    }
    var staged: isa.Inst = isa.inst_blank();
    staged.opcode = 0xFFFA;
    staged.size   = 8;
    staged.dst    = isa.make_mem(x64.RBX, 0, -1, 0, 8);
    staged.src1   = isa.make_mem(x64.RDX, 0, -1, 0, 8);
    if (encode_inst(?staged, ?st.buf) > 0) { ret 7; }
    ret 0;
}

# every notification names the MirInstr whose encoding emitted it, in
# emission order, and a declassify marker reaches the stream as a barrier
# with no bytes between the instructions around it
test "mach.lang.target.isa.x64.encode.stream:notes_name_their_instruction_and_carry_the_barrier" {
    var alloc:  A.Allocator;
    val r_7918: err[A.Error] = page.make(?alloc);
    if (sel r_7918.err) { ret 1; }
    var interner: intern.Interner = intern.init(?alloc);
    var st:       enc.EncodeState;
    enc.state_blank(?st, ?alloc, x64_machine());
    st.interner = ?interner;
    var sink: enc.AsmSink = enc.sink_init(nil, ?interner);
    st.buf.asm = ?sink;

    var vregs: [1]mir.MirVReg;
    vregs[0]          = mir.vreg(0, mir.REG_CLASS_GP, false, true);
    vregs[0].assigned = mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 0));
    var mov_ops: [2]mir.MirOperand;
    mov_ops[0]               = mir.op_preg_of(mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_GP, 0)), mir.vreg_id(0));
    mov_ops[0].required_bank = mir.BANK_GP;
    mov_ops[1]               = mir.op_imm(5);
    var instrs: [3]mir.MirInstr;
    instrs[0] = mir.instr(x64.MOV::u32, ?mov_ops[0], 2, 8, 8);
    instrs[1] = mir.declassify_marker(?instrs[0], mir.vreg_id(0));
    instrs[2] = mir.instr(x64.RET::u32, nil, 0, 0, 0);
    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 3;
    var f: mir.MirFunction;
    f.name        = intern.STR_NIL;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vregs       = ?vregs[0];
    f.vreg_count  = 1;
    f.frame.omit  = true;
    f.oblivious   = true;

    val r: err[fail.Fail] = encode_function(?st, ?f);
    if (sel r.err)                          { ret 2; }
    if (sink.failed || sink.refused != 0)   { ret 3; }
    if (enc.sink_unaccounted(?st.buf) != 0) { ret 4; }
    if (enc.note_inst_count(?st.buf) != 2)  { ret 5; }

    # FUNC, BLOCK, then one INST for the move, the BARRIER, one INST for the return
    val n: u32 = enc.note_count(?st.buf);
    if (n != 5) { ret 6; }
    val head:     *enc.AsmNote = enc.note_at(?st.buf, 0);
    val label:    *enc.AsmNote = enc.note_at(?st.buf, 1);
    val mov:      *enc.AsmNote = enc.note_at(?st.buf, 2);
    val bar:      *enc.AsmNote = enc.note_at(?st.buf, 3);
    val fin_note: *enc.AsmNote = enc.note_at(?st.buf, 4);
    if (head.kind != enc.ASM_NOTE_FUNC || label.kind != enc.ASM_NOTE_BLOCK)                         { ret 7; }
    if (mov.kind != enc.ASM_NOTE_INST || mov.mi != ?instrs[0] || mov.byte_len == 0)                 { ret 8; }
    if (bar.kind != enc.ASM_NOTE_BARRIER || bar.mi != ?instrs[1])                                   { ret 9; }
    if (bar.off != mov.off + mov.byte_len)                                                          { ret 10; }
    if (fin_note.kind != enc.ASM_NOTE_INST || fin_note.mi != ?instrs[2] || fin_note.off != bar.off) { ret 11; }

    var seeds: enc.NoteSeeds;
    enc.note_seeds(?f, mov, ?seeds);
    if (seeds.barrier || seeds.count != 2 || seeds.origin[0].n != 0 || !seeds.secret[0] || seeds.secret[1]) { ret 12; }
    enc.note_seeds(?f, bar, ?seeds);
    if (!seeds.barrier || seeds.count != 1 || seeds.origin[0].n != 0 || !seeds.secret[0]) { ret 13; }
    enc.note_seeds(?f, head, ?seeds);
    if (seeds.count != 0 || seeds.barrier) { ret 14; }

    enc.notes_free(?st.buf);
    enc.buf_dnit(?st.buf);
    ret 0;
}

# the census the walk depends on: every machine opcode a notification can
# carry has a row in the closed table, with its flags stated. the pseudo
# entries are outside the notifiable space by definition, not exceptions
# the census over the opcode space: every notifiable opcode has a complete
# row (a form, a shape, a memory effect and a stated flags class) and a
# mnemonic, and the row's columns agree with each other. an opcode added
# without a row fails here before it can reach a stream
test "mach.lang.target.isa.x64.encode.asm_ct_class:every_notifiable_opcode_has_a_row" {
    var missing: u32 = 0;
    var op:      u32 = 0;
    for (op < X64_OPCODE_COUNT) {
        if (notifiable_opcode(op::u16)) {
            val d:   x64.OpDesc  = x64.describe(op::u16);
            val cls: ct.AsmClass = asm_ct_class(op, 0);
            if (!cls.known || !cls.flags_stated)                          { missing = missing + 1; }
            if (d.form == x64.FORM_NONE || d.form::u32 >= x64.FORM_COUNT) { missing = missing + 1; }
            if (d.shape::u32 >= x64.SHAPE_COUNT)                          { missing = missing + 1; }
            if (d.mem > x64.MEM_ALL)                                      { missing = missing + 1; }
            val spelled: opt[str] = printer.mnemonic(op::u16);
            if (sel spelled.none)       { missing = missing + 1; }
            if (!ut_row_consistent(?d)) { missing = missing + 1; }
        }
        op = op + 1;
    }
    if (notifiable_opcode(x64.ASM_BLOCK) || notifiable_opcode(x64.RAW_BYTE)) { ret 2; }
    if (notifiable_opcode(X64_OPCODE_COUNT::u16))                            { ret 3; }
    val past: opt[str] = printer.mnemonic(X64_OPCODE_COUNT::u16);
    if (sel past.some)                                                                            { ret 4; }
    if (x64.describe(x64.ASM_BLOCK).form != x64.FORM_NONE)                                        { ret 5; }
    if (x64.describe(x64.RAW_BYTE).form != x64.FORM_DATA || x64.describe(x64.RAW_BYTE).cls.known) { ret 6; }
    if (x64.describe(X64_OPCODE_COUNT::u16).form != x64.FORM_NONE)                                { ret 7; }
    if (missing != 0)                                                                             { ret 1; }
    ret 0;
}

# the columns of one row agree: a transfer form has a transfer shape and
# nothing else does, a flags branch is a jcc, a flags reader with a
# destination is a setcc, the stack forms reach the stack, a memory address
# is only taken by lea, and a compare defines flags
fun ut_row_consistent(d: *x64.OpDesc) bool {
    val xfer_form: bool = d.form == x64.FORM_JMP || d.form == x64.FORM_CALL || d.form == x64.FORM_JCC;
    if (xfer_form != (d.shape == x64.SHAPE_XFER))                                      { ret false; }
    if (d.cls.cond_flags != (d.form == x64.FORM_JCC))                                  { ret false; }
    if (d.cls.cond_reg != (d.form == x64.FORM_JMP || d.form == x64.FORM_CALL))         { ret false; }
    if ((d.form == x64.FORM_SETCC) != (d.cls.reads_flags && d.shape == x64.SHAPE_DEF)) { ret false; }
    if (d.form == x64.FORM_SETCC && d.mem != x64.MEM_NONE)                             { ret false; }
    val stack_form: bool = d.form == x64.FORM_PUSH || d.form == x64.FORM_POP ||
        d.form == x64.FORM_CALL || d.form == x64.FORM_RET;
    if (stack_form && (d.mem & x64.MEM_STACK) == 0)                                     { ret false; }
    if (((d.mem & x64.MEM_ADDR) != 0) != (d.form == x64.FORM_LEA))                      { ret false; }
    if (((d.mem & x64.MEM_STRING) != 0) != (d.form == x64.FORM_STRING))                 { ret false; }
    if ((d.form == x64.FORM_UCOMIS || d.form == x64.FORM_TEST) && !d.cls.defines_flags) { ret false; }
    if (d.form == x64.FORM_ALU && !d.cls.defines_flags)                                 { ret false; }
    if ((d.arity == 0) != (d.shape == x64.SHAPE_NONE && d.form != x64.FORM_DATA))       { ret false; }
    if (d.arity > 3)                                                                    { ret false; }
    if (d.shape == x64.SHAPE_XFER && d.arity != 1)                                      { ret false; }
    if (d.shape == x64.SHAPE_NONE && d.form != x64.FORM_BARE && d.form != x64.FORM_RET &&
        d.form != x64.FORM_TRAP && d.form != x64.FORM_STRING && d.form != x64.FORM_DATA) { ret false; }
    if (d.shape != x64.SHAPE_NONE && (d.form == x64.FORM_BARE || d.form == x64.FORM_RET ||
        d.form == x64.FORM_TRAP || d.form == x64.FORM_STRING || d.form == x64.FORM_DATA)) { ret false; }
    if (x64.form_is_float(d.form) && d.cls.op == ct.CT_OP_INT_DIVMOD) { ret false; }
    if (d.cls.op == ct.CT_OP_FLOAT && !x64.form_is_float(d.form))     { ret false; }
    if (d.cls.op == ct.CT_OP_VAR_SHIFT && d.form != x64.FORM_SHIFT)   { ret false; }
    if (d.cls.op == ct.CT_OP_INT_DIVMOD && d.form != x64.FORM_DIV)    { ret false; }
    ret true;
}

# the family predicates are exact over the whole opcode space, including
# the two setcc rows assigned outside the setcc run
test "mach.lang.target.isa.x64.encode.describe:family_predicates_read_the_table" {
    var jcc:     u32 = 0;
    var setcc:   u32 = 0;
    var sse_mov: u32 = 0;
    var sse_alu: u32 = 0;
    var alu:     u32 = 0;
    var cvt:     u32 = 0;
    var fp:      u32 = 0;
    var op:      u32 = 0;
    for (op < X64_OPCODE_COUNT) {
        val o: u16 = op::u16;
        if (is_jcc(o))           { jcc = jcc + 1; }
        if (is_setcc(o))         { setcc = setcc + 1; }
        if (is_sse_mov(o))       { sse_mov = sse_mov + 1; }
        if (is_sse_alu(o))       { sse_alu = sse_alu + 1; }
        if (is_alu(o))           { alu = alu + 1; }
        if (is_cvt(o))           { cvt = cvt + 1; }
        if (x64.is_fp_opcode(o)) { fp = fp + 1; }
        op = op + 1;
    }
    if (jcc != 10 || setcc != 12 || sse_mov != 2 || sse_alu != 8 || alu != 6 || cvt != 6)             { ret 1; }
    if (!is_setcc(x64.SETP) || !is_setcc(x64.SETNP))                                                  { ret 2; }
    if (is_jcc(x64.JMP) || is_jcc(x64.SETE) || is_setcc(x64.JE) || is_setcc(x64.PUSHFQ))              { ret 3; }
    if (is_sse_alu(x64.ADDPS) || is_sse_mov(x64.MOVAPS) || is_alu(x64.TEST) || is_cvt(x64.MOVQ))      { ret 4; }
    if (!x64.is_fp_opcode(x64.MOVQ) || !x64.is_fp_opcode(x64.PADDB) || !x64.is_fp_opcode(x64.MOVUPS)) { ret 5; }
    if (x64.is_fp_opcode(x64.MOV) || x64.is_fp_opcode(x64.MOVABS) || x64.is_fp_opcode(x64.MOVSB))     { ret 6; }
    # movq, movss/movsd, movaps/movups, 8 scalar alu, 2 ucomis, 6 cvt, xorps, 30 packed, pshufd, pslld
    if (fp != 1 + 2 + 2 + 8 + 2 + 6 + 1 + 30 + 1 + 1)             { ret 7; }
    if (is_jcc(X64_OPCODE_COUNT::u16) || is_setcc(x64.ASM_BLOCK)) { ret 8; }
    ret 0;
}

# the inline-asm grammar's implicit-memory rows are the table's stack rows
test "mach.lang.target.isa.x64.encode.describe:grammar_implicit_mem_matches_stack_rows" {
    var i: usize = 0;
    for (i < X64_MNEMONIC_COUNT) {
        val d: x64.OpDesc = x64.describe(X64_MNEMONICS[i].code::u16);
        if (X64_MNEMONICS[i].implicit_mem && (d.mem & x64.MEM_STACK) == 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the codegen flags pairing is a table read: a consumer that does not read
# the flags, or a producer that does not define them, is refused; a mov
# between the two is refused as a flags writer would be
fun ut_pair_ok(producer: u16, consumer: u16) bool {
    val r: err[fail.Fail] = flags_pair(producer, consumer);
    ret !sel r.err;
}

fun ut_kept_ok(op: u16) bool {
    val r: err[fail.Fail] = flags_kept(op);
    ret !sel r.err;
}

test "mach.lang.target.isa.x64.encode.flags_pair:reads_the_table" {
    if (!ut_pair_ok(x64.CMP, x64.SETE))                 { ret 1; }
    if (!ut_pair_ok(x64.TEST, x64.JNE))                 { ret 2; }
    if (!ut_pair_ok(x64.UCOMISD, x64.JB))               { ret 3; }
    if (!ut_pair_ok(x64.UCOMISS, x64.SETNP))            { ret 4; }
    if (ut_pair_ok(x64.MOV, x64.SETE))                  { ret 5; }
    if (ut_pair_ok(x64.CMP, x64.JMP))                   { ret 6; }
    if (ut_pair_ok(x64.INC, x64.JE))                    { ret 7; }
    if (ut_pair_ok(x64.CMP, x64.MOVZX))                 { ret 8; }
    if (ut_pair_ok(x64.ASM_BLOCK, x64.JE))              { ret 9; }
    if (!ut_kept_ok(x64.SETE) || !ut_kept_ok(x64.MOV))  { ret 10; }
    if (ut_kept_ok(x64.ADD) || ut_kept_ok(x64.SYSCALL)) { ret 11; }
    ret 0;
}

# an opcode with no row, and a memory operand on a row that never reaches
# memory through an operand, are refused with the buffer untouched
test "mach.lang.target.isa.x64.encode.encode_inst:rowless_and_memoryless_forms_emit_nothing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: enc.ByteBuf = enc.buf_init(?alloc);
    var bad: i32         = 0;

    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = X64_OPCODE_COUNT::u16;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 1; }
    mi.opcode = x64.ASM_BLOCK;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 2; }

    mi        = isa.inst_blank();
    mi.opcode = x64.SETE;
    mi.dst    = isa.make_mem(x64.RBP, -8, -1, 0, 1);
    mi.size   = 1;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 3; }
    mi.dst = isa.make_reg(x64.RAX, 1);
    if (encode_inst(?mi, ?buf) <= 0 || buf.len == 0) { bad = 4; }

    buf.len   = 0;
    mi        = isa.inst_blank();
    mi.opcode = x64.MOVQ;
    mi.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM0), 16);
    mi.src1   = isa.make_mem(x64.RBP, -8, -1, 0, 8);
    mi.size   = 8;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 5; }

    enc.buf_dnit(?buf);
    ret bad;
}

# an opcode outside the notifiable space describes as unknown, so a stream
# that carried one is refused rather than walked as public
test "mach.lang.target.isa.x64.encode.inst_effects:pseudo_and_out_of_range_opcodes_are_unknown" {
    var mi: isa.Inst = isa.inst_blank();
    var e:  ct.InstEffects;
    mi.opcode = x64.RAW_BYTE;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 1; }
    mi.opcode = x64.ASM_BLOCK;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 2; }
    mi.opcode = X64_OPCODE_COUNT::u16;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 3; }
    ret 0;
}

# the roles the walk reads: a two-address op reads and writes its first
# operand, a divide reads rax:rdx implicitly and writes both, a compare
# writes nothing, a zeroing xor defines a constant, a push touches memory
# with no address, a shift by cl gates on the count position
test "mach.lang.target.isa.x64.encode.inst_effects:roles_follow_intel_operand_order" {
    var e:  ct.InstEffects;
    var mi: isa.Inst = isa.inst_blank();

    mi.opcode = x64.ADD;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_reg(x64.RBX, 8);
    inst_effects(?mi, ?e);
    if (!e.cls.known || e.roles[0] != ct.ROLE_RW || e.roles[1] != ct.ROLE_READ || e.zero_idiom) { ret 1; }

    mi        = isa.inst_blank();
    mi.opcode = x64.XOR;
    mi.dst    = isa.make_reg(x64.RDX, 4);
    mi.src1   = isa.make_reg(x64.RDX, 4);
    inst_effects(?mi, ?e);
    if (!e.zero_idiom || e.roles[0] != ct.ROLE_RW) { ret 2; }

    mi        = isa.inst_blank();
    mi.opcode = x64.DIV;
    mi.src1   = isa.make_reg(x64.RCX, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_NONE || e.roles[1] != ct.ROLE_READ)                            { ret 3; }
    if (e.implicit_reads != (X64_RAX | X64_RDX) || e.implicit_writes != (X64_RAX | X64_RDX)) { ret 4; }
    if (e.cls.op != ct.CT_OP_INT_DIVMOD)                                                     { ret 5; }

    mi        = isa.inst_blank();
    mi.opcode = x64.CMP;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_imm(0, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_READ || e.roles[1] != ct.ROLE_READ || !e.cls.defines_flags) { ret 6; }

    mi        = isa.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_mem(x64.RBP, -8, -1, 0, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ) { ret 7; }

    mi        = isa.inst_blank();
    mi.opcode = x64.LEA;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_mem(x64.RBX, 8, -1, 0, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_ADDR) { ret 8; }

    mi        = isa.inst_blank();
    mi.opcode = x64.PUSH;
    mi.dst    = isa.make_reg(x64.RBP, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_READ || !e.implicit_mem || (e.implicit_writes & X64_RSP) == 0) { ret 9; }

    mi        = isa.inst_blank();
    mi.opcode = x64.SHL;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_reg(x64.RCX, 1);
    inst_effects(?mi, ?e);
    if (e.count_pos != 1 || e.cls.op != ct.CT_OP_VAR_SHIFT) { ret 10; }

    mi        = isa.inst_blank();
    mi.opcode = x64.IMUL;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.src1   = isa.make_reg(x64.RCX, 8);
    mi.src2   = isa.make_imm(3, 4);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || e.roles[1] != ct.ROLE_READ || e.cls.op != ct.CT_OP_INT_MUL) { ret 11; }

    mi        = isa.inst_blank();
    mi.opcode = x64.SETE;
    mi.dst    = isa.make_reg(x64.RAX, 1);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_WRITE || !e.cls.reads_flags) { ret 12; }

    mi        = isa.inst_blank();
    mi.opcode = x64.JL;
    mi.dst    = isa.make_block_label(3);
    inst_effects(?mi, ?e);
    if (!e.cls.cond_flags || e.xfer != ct.XFER_BRANCH || e.target != ct.TARGET_BLOCK || e.target_block != 3) { ret 13; }

    mi        = isa.inst_blank();
    mi.opcode = x64.JMP;
    mi.dst    = isa.make_local_label(true);
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_JUMP || e.target != ct.TARGET_LOCAL_FWD) { ret 14; }
    mi.dst = isa.make_local_label(false);
    inst_effects(?mi, ?e);
    if (e.target != ct.TARGET_LOCAL) { ret 20; }

    mi        = isa.inst_blank();
    mi.opcode = x64.CALL;
    mi.dst    = isa.make_reg(x64.RAX, 8);
    mi.flags  = x64.FLAG_INDIRECT::u16;
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_CALL || e.target != ct.TARGET_REGISTER || e.roles[0] != ct.ROLE_READ || !e.cls.cond_reg) { ret 15; }

    mi        = isa.inst_blank();
    mi.opcode = x64.RET;
    inst_effects(?mi, ?e);
    if (e.xfer != ct.XFER_RET) { ret 16; }

    mi        = isa.inst_blank();
    mi.opcode = x64.JNE;
    inst_effects(?mi, ?e);
    if (e.target != ct.TARGET_LOCAL) { ret 21; }
    mi.flags = x64.FLAG_LOCAL_FWD::u16;
    inst_effects(?mi, ?e);
    if (e.target != ct.TARGET_LOCAL_FWD) { ret 22; }

    mi        = isa.inst_blank();
    mi.opcode = x64.CQO;
    inst_effects(?mi, ?e);
    if (e.implicit_reads != X64_RAX || e.implicit_writes != X64_RDX) { ret 17; }

    mi        = isa.inst_blank();
    mi.opcode = x64.CVTSI2SD;
    mi.dst    = isa.make_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 0), 8);
    mi.src1   = isa.make_reg(x64.RAX, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != ct.ROLE_RW || e.roles[1] != ct.ROLE_READ || e.cls.op != ct.CT_OP_FLOAT) { ret 18; }

    mi        = isa.inst_blank();
    mi.opcode = x64.SYSCALL;
    inst_effects(?mi, ?e);
    if (e.implicit_writes != X64_SYSCALL_WRITES::u64 || !e.cls.opaque_flags) { ret 19; }
    ret 0;
}

# the walk's rules on hand-built x86-64 streams: the function declares rdi
# secret at entry through its ABI inputs; every stream starts with the
# function and block-0 notes and the notification carries no MirInstr, so
# the taint is purely the physical derivation
var t_walk_classes: [3]isa.RegClass;
var t_walk_callee:  [1]isa.Register;
var t_walk_inputs:  [1]mir.MirAbiInput;

fun t_walk_callee_saved(out: *isa.Register) i32 {
    out[0].id   = x64.RBX;
    out[0].size = 8;
    ret 1;
}

fun t_walk_target() isa.BackendTarget {
    var bt: isa.BackendTarget;
    bt.model                    = @x64_machine();
    bt.model.frame_ptr_reg      = x64.RBP;
    bt.model.stack_ptr_reg      = x64.RSP;
    bt.model.ct_trust_mul       = false;
    bt.model.ct_trust_var_shift = true;
    bt.model.incoming_arg_base  = 16;
    t_walk_classes[0].name      = "gpr";
    t_walk_classes[0].kind      = isa.RC_GENERAL;
    t_walk_classes[0].len       = 16;
    t_walk_classes[1].name      = "xmm";
    t_walk_classes[1].kind      = isa.RC_FLOAT;
    t_walk_classes[1].len       = 16;
    t_walk_classes[2].name      = "flags";
    t_walk_classes[2].kind      = isa.RC_FLAGS;
    t_walk_classes[2].len       = 1;
    bt.model.reg_classes        = ?t_walk_classes[0];
    bt.model.reg_class_len      = 3;
    bt.abi.callee_saved         = t_walk_callee_saved;
    bt.identity.arch_name       = "x86_64";
    ret bt;
}

fun t_walk_function(f: *mir.MirFunction) {
    f.name                         = intern.STR_NIL;
    f.oblivious                    = true;
    f.vregs                        = nil;
    f.vreg_count                   = 0;
    f.blocks                       = nil;
    f.block_count                  = 0;
    f.frame.omit                   = false;
    t_walk_inputs[0].argument      = 0;
    t_walk_inputs[0].location      = mir.ABI_INPUT_REGISTER;
    t_walk_inputs[0].reg           = mir.preg_id(x64.RDI);
    t_walk_inputs[0].offset        = 0;
    t_walk_inputs[0].width         = 8;
    t_walk_inputs[0].logical_width = 8;
    t_walk_inputs[0].secret        = true;
    t_walk_inputs[0].content       = mir.ABI_CONTENT_NONE;
    t_walk_inputs[0].content_size  = 0;
    f.abi_inputs                   = ?t_walk_inputs[0];
    f.abi_input_count              = 1;
    f.abi_input_cap                = 1;
}

fun t_inst2(op: u16, dst: isa.Operand, src1: isa.Operand, size: u8) isa.Inst {
    var mi: isa.Inst = isa.inst_blank();
    mi.opcode = op;
    mi.dst    = dst;
    mi.src1   = src1;
    mi.size   = size;
    ret mi;
}

fun t_reg(id: i32, size: u8) isa.Operand {
    ret isa.make_reg(id, size);
}

fun t_imm(v: i64) isa.Operand {
    ret isa.make_imm(v, 4);
}

fun t_none() isa.Operand {
    ret isa.make_none();
}

fun t_note_head(n: *enc.AsmNote) u32 {
    n[0]      = enc.note_blank();
    n[0].kind = enc.ASM_NOTE_FUNC;
    n[1]      = enc.note_blank();
    n[1].kind = enc.ASM_NOTE_BLOCK;
    n[1].id   = 0;
    ret 2;
}

fun t_note_inst(n: *enc.AsmNote, at: *u32, mi: isa.Inst) {
    n[@at]      = enc.note_blank();
    n[@at].kind = enc.ASM_NOTE_INST;
    n[@at].inst = mi;
    @at         = @at + 1;
}

fun t_note_block(n: *enc.AsmNote, at: *u32, id: u32) {
    n[@at]      = enc.note_blank();
    n[@at].kind = enc.ASM_NOTE_BLOCK;
    n[@at].id   = id;
    @at         = @at + 1;
}

# 0 accepted, 1 refused with the needle, 2 refused with another message
fun t_walk(n: *enc.AsmNote, count: u32, f: *mir.MirFunction, needle: str) i32 {
    var alloc:  A.Allocator;
    val r_8197: err[A.Error] = page.make(?alloc);
    if (sel r_8197.err) { ret 3; }
    var bt:    isa.BackendTarget   = t_walk_target();
    val hooks: enc.EncodeHooks     = x64_hooks();
    val r:     err[ctwalk.Refusal] = ctwalk.walk(f, n, count, ?hooks.effects, ?bt, ?alloc);
    if (sel r.ok) { ret 0; }
    var refusal: ctwalk.Refusal = r.err;
    var code:    i32            = 2;
    if (refusal.detail != nil && needle != nil && str_contains(refusal.detail, needle)) { code = 1; }
    ctwalk.refusal_free(?alloc, ?refusal);
    ret code;
}

val T_BRANCH:  str = "branches on";
val T_ADDRESS: str = "addresses memory";
val T_VARLAT:  str = "variable-latency";

test "mach.lang.target.isa.x64.encode.walk:flags_filled_from_a_secret_refuse_the_branch_that_reads_them" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:  [8]enc.AsmNote;
    var at: u32 = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RDI, 8), t_imm(0), 8));
    var je: isa.Inst = t_inst2(x64.JE, isa.make_block_label(1), t_none(), 8);
    t_note_inst(?n[0], ?at, je);
    t_note_block(?n[0], ?at, 1);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 1; }

    # the public sibling: the same compare on a public register
    n[2].inst.dst = t_reg(x64.RSI, 8);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 2; }

    # a public compare between them redefines the flags
    var m: [8]enc.AsmNote;
    at = t_note_head(?m[0]);
    t_note_inst(?m[0], ?at, t_inst2(x64.CMP, t_reg(x64.RDI, 8), t_imm(0), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.CMP, t_reg(x64.RSI, 8), t_imm(0), 8));
    t_note_inst(?m[0], ?at, je);
    t_note_block(?m[0], ?at, 1);
    t_note_inst(?m[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?m[0], at, ?f, nil) != 0) { ret 3; }

    # setcc carries the flags taint into its destination
    var s: [8]enc.AsmNote;
    at = t_note_head(?s[0]);
    t_note_inst(?s[0], ?at, t_inst2(x64.CMP, t_reg(x64.RDI, 8), t_imm(0), 8));
    t_note_inst(?s[0], ?at, t_inst2(x64.SETE, t_reg(x64.RAX, 1), t_none(), 1));
    t_note_inst(?s[0], ?at, t_inst2(x64.TEST, t_reg(x64.RAX, 8), t_reg(x64.RAX, 8), 8));
    t_note_inst(?s[0], ?at, je);
    t_note_block(?s[0], ?at, 1);
    t_note_inst(?s[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?s[0], at, ?f, T_BRANCH) != 1) { ret 4; }
    ret 0;
}

# the fixpoint: a register defined from a secret at the end of a loop body
# is secret at the loop head, where a compare on it decides the back edge.
# a single pass in emission order sees the compare before the definition
test "mach.lang.target.isa.x64.encode.walk:loop_carried_taint_reaches_the_loop_head" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:  [12]enc.AsmNote;
    var at: u32 = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_block(?n[0], ?at, 1);
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JE, isa.make_block_label(2), t_none(), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JMP, isa.make_block_label(1), t_none(), 8));
    t_note_block(?n[0], ?at, 2);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 1; }

    # the public sibling: the body defines rax from a public register
    n[6].inst.src1 = t_reg(x64.RSI, 8);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 2; }

    # and a body that redefines rax publicly before the back edge is accepted
    n[6].inst.src1 = t_reg(x64.RDI, 8);
    var m: [12]enc.AsmNote;
    at = t_note_head(?m[0]);
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_block(?m[0], ?at, 1);
    t_note_inst(?m[0], ?at, t_inst2(x64.CMP, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.JE, isa.make_block_label(2), t_none(), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_imm(3), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.JMP, isa.make_block_label(1), t_none(), 8));
    t_note_block(?m[0], ?at, 2);
    t_note_inst(?m[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?m[0], at, ?f, nil) != 0) { ret 3; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.walk:a_call_clears_caller_saved_taint_and_keeps_callee_saved" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:  [10]enc.AsmNote;
    var at: u32 = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RBX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RCX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CALL, isa.make_sym(1, 8), t_none(), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RCX, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JE, isa.make_block_label(1), t_none(), 8));
    t_note_block(?n[0], ?at, 1);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 1; }
    n[5].inst.dst = t_reg(x64.RBX, 8);
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 2; }
    # flags after a call are the callee's: a branch without a compare is refused
    n[5].inst = t_inst2(x64.NOP, t_none(), t_none(), 0);
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 3; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.walk:frame_extents_carry_taint_slot_by_slot" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:  [12]enc.AsmNote;
    var at: u32 = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, isa.make_mem(x64.RBP, -16, -1, 0, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), isa.make_mem(x64.RBP, -16, -1, 0, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JE, isa.make_block_label(1), t_none(), 8));
    t_note_block(?n[0], ?at, 1);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 1; }

    # a neighbouring slot is disjoint
    n[3].inst.src1 = isa.make_mem(x64.RBP, -8, -1, 0, 8);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 2; }
    n[3].inst.src1 = isa.make_mem(x64.RBP, -16, -1, 0, 8);

    # a public store covering the extent kills it; a partial one does not
    var m: [12]enc.AsmNote;
    at = t_note_head(?m[0]);
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, isa.make_mem(x64.RBP, -16, -1, 0, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, isa.make_mem(x64.RBP, -16, -1, 0, 8), t_reg(x64.RSI, 8), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), isa.make_mem(x64.RBP, -16, -1, 0, 8), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.CMP, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.JE, isa.make_block_label(1), t_none(), 8));
    t_note_block(?m[0], ?at, 1);
    t_note_inst(?m[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?m[0], at, ?f, nil) != 0) { ret 3; }
    m[3].inst.dst  = isa.make_mem(x64.RBP, -16, -1, 0, 4);
    m[3].inst.src1 = t_reg(x64.RSI, 4);
    m[3].inst.size = 4;
    if (t_walk(?m[0], at, ?f, T_BRANCH) != 1) { ret 4; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.walk:secret_addresses_and_targets_are_refused" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:  [6]enc.AsmNote;
    var at: u32 = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), isa.make_mem(x64.RSI, 0, x64.RDI, 8, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, T_ADDRESS) != 1) { ret 1; }
    n[2].inst.src1 = isa.make_mem(x64.RDI, 8, -1, 0, 8);
    if (t_walk(?n[0], at, ?f, T_ADDRESS) != 1) { ret 2; }
    n[2].inst.src1 = isa.make_mem(x64.RSI, 8, -1, 0, 8);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 3; }

    # lea only computes the address: the secret flows into rax, no access happens
    n[2].inst = t_inst2(x64.LEA, t_reg(x64.RAX, 8), isa.make_mem(x64.RSI, 0, x64.RDI, 8, 8), 8);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 4; }

    var c: isa.Inst = t_inst2(x64.CALL, t_reg(x64.RDI, 8), t_none(), 8);
    c.flags   = x64.FLAG_INDIRECT::u16;
    n[2].inst = c;
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 5; }
    n[2].inst.dst = t_reg(x64.RSI, 8);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 6; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.walk:variable_latency_on_a_secret_is_refused_unless_zeroed_first" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:  [8]enc.AsmNote;
    var at: u32 = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RDX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_imm(9), 8));
    var dv: isa.Inst = isa.inst_blank();
    dv.opcode = x64.DIV;
    dv.src1   = t_reg(x64.RCX, 8);
    dv.size   = 8;
    t_note_inst(?n[0], ?at, dv);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    # rdx is an implicit dividend half
    if (t_walk(?n[0], at, ?f, T_VARLAT) != 1) { ret 1; }

    var m: [8]enc.AsmNote;
    at = t_note_head(?m[0]);
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RDX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_imm(9), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.XOR, t_reg(x64.RDX, 4), t_reg(x64.RDX, 4), 4));
    t_note_inst(?m[0], ?at, dv);
    t_note_inst(?m[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?m[0], at, ?f, nil) != 0) { ret 2; }

    # imul on the secret; a shift gates on its count only
    var k: [8]enc.AsmNote;
    at = t_note_head(?k[0]);
    t_note_inst(?k[0], ?at, t_inst2(x64.IMUL, t_reg(x64.RAX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?k[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?k[0], at, ?f, T_VARLAT) != 1) { ret 3; }
    k[2].inst = t_inst2(x64.SHL, t_reg(x64.RDI, 8), t_reg(x64.RCX, 1), 8);
    if (t_walk(?k[0], at, ?f, nil) != 0) { ret 4; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.walk:unknown_rows_and_data_directives_are_refused" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var n:   [6]enc.AsmNote;
    var at:  u32      = t_note_head(?n[0]);
    var raw: isa.Inst = isa.inst_blank();
    raw.opcode = x64.RAW_BYTE;
    raw.dst    = t_imm(0x90);
    t_note_inst(?n[0], ?at, raw);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, "does not model") != 1) { ret 1; }
    n[2]      = enc.note_blank();
    n[2].kind = enc.ASM_NOTE_BYTES;
    if (t_walk(?n[0], at, ?f, "data directive") != 1) { ret 2; }
    # a function without the contract is not walked at all
    f.oblivious = false;
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 3; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.walk:the_barrier_downgrades_the_carrier_it_names" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var vregs: [1]mir.MirVReg;
    vregs[0]          = mir.vreg(0, mir.REG_CLASS_GP, false, true);
    vregs[0].assigned = mir.preg_id(x64.RDI);
    f.vregs           = ?vregs[0];
    f.vreg_count      = 1;
    var seed:   mir.MirInstr = mir.instr(isa.ISA_USE::u32, nil, 0, 0, 0);
    var marker: mir.MirInstr = mir.declassify_marker(?seed, mir.vreg_id(0));
    var n:      [8]enc.AsmNote;
    var at:     u32          = t_note_head(?n[0]);
    n[at]      = enc.note_blank();
    n[at].kind = enc.ASM_NOTE_BARRIER;
    n[at].mi   = ?marker;
    at         = at + 1;
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RDI, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JE, isa.make_block_label(1), t_none(), 8));
    t_note_block(?n[0], ?at, 1);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 1; }
    # the same stream with the barrier naming another register
    vregs[0].assigned = mir.preg_id(x64.RSI);
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 2; }
    ret 0;
}

# an expansion-internal branch keeps its state alive to the end of the
# expansion and makes the expansion monotone, so a secret written after a
# forward skip is still seen by every later instruction of the expansion
test "mach.lang.target.isa.x64.encode.walk:a_local_branch_joins_its_state_forward_within_the_expansion" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var seed: mir.MirInstr = mir.instr(isa.ISA_USE::u32, nil, 0, 0, 0);
    var n:    [10]enc.AsmNote;
    var at:   u32          = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RSI, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JE, isa.make_local_label(true), t_none(), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RAX, 8), t_imm(0), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.JE, isa.make_block_label(1), t_none(), 8));
    t_note_block(?n[0], ?at, 1);
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    var k: u32 = 2;
    for (k < 8) {
        n[k].mi = ?seed;
        k       = k + 1;
    }
    # the skip may bypass the public definition of rax
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 1; }
    # without the skip the definition is unconditional
    n[4].inst = t_inst2(x64.NOP, t_none(), t_none(), 0);
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 2; }
    ret 0;
}

# an inline-asm branch to a numbered label ahead carries no operand; the
# recorded direction lets a public compare between a secret compare and the
# branch redefine the flags. a jump to a local label keeps the code after it
# reachable, so a secret address behind such a jump is still refused
test "mach.lang.target.isa.x64.encode.walk:inline_asm_local_labels_keep_their_direction_and_reachability" {
    var f: mir.MirFunction;
    t_walk_function(?f);
    var seed: mir.MirInstr = mir.instr(isa.ISA_USE::u32, nil, 0, 0, 0);
    var n:    [10]enc.AsmNote;
    var at:   u32          = t_note_head(?n[0]);
    t_note_inst(?n[0], ?at, t_inst2(x64.MOV, t_reg(x64.RAX, 8), t_reg(x64.RDI, 8), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RAX, 8), t_imm(1), 8));
    t_note_inst(?n[0], ?at, t_inst2(x64.CMP, t_reg(x64.RBX, 8), t_reg(x64.RCX, 8), 8));
    var je: isa.Inst = t_inst2(x64.JE, t_none(), t_none(), 8);
    je.flags = x64.FLAG_LOCAL_FWD::u16;
    t_note_inst(?n[0], ?at, je);
    t_note_inst(?n[0], ?at, t_inst2(x64.NOP, t_none(), t_none(), 0));
    t_note_inst(?n[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    var k: u32 = 2;
    for (k < 7) {
        n[k].mi = ?seed;
        k       = k + 1;
    }
    if (t_walk(?n[0], at, ?f, nil) != 0) { ret 1; }
    # the same branch on the secret compare is refused
    n[4].inst = t_inst2(x64.NOP, t_none(), t_none(), 0);
    if (t_walk(?n[0], at, ?f, T_BRANCH) != 1) { ret 2; }

    var m: [8]enc.AsmNote;
    at = t_note_head(?m[0]);
    var jmp: isa.Inst = t_inst2(x64.JMP, t_none(), t_none(), 8);
    jmp.flags = x64.FLAG_LOCAL_FWD::u16;
    t_note_inst(?m[0], ?at, jmp);
    t_note_inst(?m[0], ?at, t_inst2(x64.MOV, t_reg(x64.RCX, 8), isa.make_mem(x64.RDI, 0, -1, 0, 8), 8));
    t_note_inst(?m[0], ?at, t_inst2(x64.RET, t_none(), t_none(), 0));
    k = 2;
    for (k < 5) {
        m[k].mi = ?seed;
        k       = k + 1;
    }
    if (t_walk(?m[0], at, ?f, T_ADDRESS) != 1) { ret 3; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.is_selected_vector_alu:partition_MirOpcode" {
    # the vector ALU subset of the selection catalog; every other opcode is
    # not packed by the vector encoder
    val alu: [20]mir.MirOpcode = [20]mir.MirOpcode{mir.MIR_NOT, mir.MIR_SEL_ADD, mir.MIR_SEL_SUB, mir.MIR_SEL_MUL,
        mir.MIR_SEL_AND, mir.MIR_SEL_OR, mir.MIR_SEL_XOR, mir.MIR_SEL_SHL, mir.MIR_SEL_SHR_U, mir.MIR_SEL_SHR_S,
        mir.MIR_SEL_DIV_S, mir.MIR_SEL_DIV_U, mir.MIR_SEL_REM_S, mir.MIR_SEL_REM_U, mir.MIR_SEL_CMP_EQ,
        mir.MIR_SEL_CMP_NE, mir.MIR_SEL_CMP_LT_S, mir.MIR_SEL_CMP_LT_U, mir.MIR_SEL_CMP_LE_S, mir.MIR_SEL_CMP_LE_U};
    val others: [71]mir.MirOpcode = [71]mir.MirOpcode{mir.MIR_ADD, mir.MIR_SUB, mir.MIR_MUL, mir.MIR_DIV_S,
        mir.MIR_DIV_U, mir.MIR_REM_S, mir.MIR_REM_U, mir.MIR_NEG, mir.MIR_AND, mir.MIR_OR, mir.MIR_XOR,
        mir.MIR_SHL, mir.MIR_SHR_S, mir.MIR_SHR_U, mir.MIR_CMP_EQ, mir.MIR_CMP_NE, mir.MIR_CMP_LT_S,
        mir.MIR_CMP_LT_U, mir.MIR_CMP_LE_S, mir.MIR_CMP_LE_U, mir.MIR_TRUNC, mir.MIR_SEXT, mir.MIR_ZEXT,
        mir.MIR_FP_TRUNC, mir.MIR_FP_EXT, mir.MIR_FP_TO_SI, mir.MIR_FP_TO_UI, mir.MIR_SI_TO_FP, mir.MIR_UI_TO_FP,
        mir.MIR_BITCAST, mir.MIR_ALLOCA, mir.MIR_LOAD, mir.MIR_STORE, mir.MIR_GEP, mir.MIR_EXTRACT, mir.MIR_INSERT,
        mir.MIR_PHI, mir.MIR_CALL_IR, mir.MIR_BR, mir.MIR_CBR, mir.MIR_RET, mir.MIR_UNREACHABLE, mir.MIR_ASM,
        mir.MIR_MOV, mir.MIR_ARG, mir.MIR_CALL, mir.MIR_CALL_RES, mir.MIR_DECLASSIFY, mir.MIR_VEC_EXTRACT,
        mir.MIR_VEC_INSERT, mir.MIR_VEC_BUILD, mir.MIR_MUL_HI_U, mir.MIR_SEL_CBR, mir.MIR_SEL_CBR_EQ,
        mir.MIR_SEL_CBR_NE, mir.MIR_SEL_CBR_LT_S, mir.MIR_SEL_CBR_LT_U, mir.MIR_SEL_CBR_LE_S, mir.MIR_SEL_CBR_LE_U,
        mir.MIR_FADD, mir.MIR_FSUB, mir.MIR_FMUL, mir.MIR_FDIV, mir.MIR_FCMP, mir.MIR_FNEG, mir.MIR_MEMZERO,
        mir.MIR_MEMCPY, mir.MIR_VALUE_CALL, mir.MIR_VALUE_PARAM, mir.MIR_OP_NONE, mir.ISA_USE_OPCODE};
    var i: usize = 0;
    for (i < 20) {
        if (!is_selected_vector_alu(alu[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 71) {
        if (is_selected_vector_alu(others[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}
