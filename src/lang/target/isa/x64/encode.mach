test "mach.lang.target.isa.x64.encode.x64_mem:stack_slot_base_diagnostic" {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov [{ptr}], rax", nil, nil, nil, nil);
    var item: iasm.Item;
    val r: R.Result[bool, str] = iasm.next(?c, ?item);
    if (!R.is_err[bool, str](r)) { ret 1; }
    val msg: str = R.unwrap_err[bool, str](r);
    if (!str_contains(msg, "stack-slot binding"))                          { ret 1; }
    if (!str_contains(msg, "load it into a register first"))               { ret 1; }
    if (str_contains(msg, "malformed inline-asm two-operand instruction")) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.encode.x64_emit:local_label_rel32" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: enc.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = enc.buf_init(?alloc);
    st.interner = nil;

    var g: iasm.Grammar = x64_grammar();
    var labels: iasm.Labels;
    iasm.labels_init(?labels, ?alloc);
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "", ?alloc, nil, nil, nil);

    var jm: iasm.Item;
    jm.kind  = iasm.AI_INST;
    jm.code  = x64.JMP::u32;
    jm.flags = X64P_BRANCH;
    jm.nops  = 0;
    jm.ref   = iasm.AR_LOCAL;

    var bad: i32 = 0;

    val dr: R.Result[R.Void, str] = iasm.label_record_def(?st, ?g, ?labels, 1, 0);
    if (R.is_err[R.Void, str](dr)) { bad = 1; }
    jm.ref_num = 1;
    jm.ref_fwd = false;
    val br: R.Result[R.Void, str] = x64_emit(?st, ?c, ?labels, ?jm);
    if (R.is_err[R.Void, str](br)) { bad = 1; }
    if (st.buf.len != 5)         { bad = 1; }
    or (st.buf.data[0] != 0xE9)  { bad = 1; }
    or (st.buf.data[1] != 0xFB)  { bad = 1; }
    or (st.buf.data[2] != 0xFF)  { bad = 1; }
    or (st.buf.data[3] != 0xFF)  { bad = 1; }
    or (st.buf.data[4] != 0xFF)  { bad = 1; }

    jm.ref_num = 2;
    jm.ref_fwd = true;
    val fr: R.Result[R.Void, str] = x64_emit(?st, ?c, ?labels, ?jm);
    if (R.is_err[R.Void, str](fr)) { bad = 1; }
    if (labels.fixup_count != 1) { bad = 1; }
    val dr2: R.Result[R.Void, str] = iasm.label_record_def(?st, ?g, ?labels, 2, st.buf.len::u32);
    if (R.is_err[R.Void, str](dr2)) { bad = 1; }
    if (labels.fixup_count != 0)  { bad = 1; }
    or (st.buf.data[5] != 0xE9)   { bad = 1; }
    or (st.buf.data[6] != 0x00)   { bad = 1; }
    or (st.buf.data[7] != 0x00)   { bad = 1; }
    or (st.buf.data[8] != 0x00)   { bad = 1; }
    or (st.buf.data[9] != 0x00)   { bad = 1; }

    jm.ref_num = 9;
    jm.ref_fwd = false;
    val ur: R.Result[R.Void, str] = x64_emit(?st, ?c, ?labels, ?jm);
    if (!R.is_err[R.Void, str](ur)) { bad = 1; }

    iasm.labels_dnit(?labels);
    enc.buf_dnit(?st.buf);
    ret bad;
}

test "mach.lang.target.isa.x64.encode.x64_parse:body_to_inst" {
    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, "mov rax, rbx\nlock xadd [rcx], rax\nsyscall\n1:\njmp 1b", nil, nil, nil, nil);
    var item: iasm.Item;
    var bad: i32 = 0;

    if (R.is_err[bool, str](iasm.next(?c, ?item)))          { ret 1; }
    if (item.kind != iasm.AI_INST)                          { bad = 1; }
    var mi: isa.Inst = x64_build(?item, intern.STR_NIL);
    if (mi.opcode != x64.MOV)                               { bad = 1; }
    if (mi.size != 8)                                       { bad = 1; }
    if ((mi.flags & x64.FLAG_REX_W::u16) == 0)              { bad = 1; }
    if (mi.dst.kind != isa.OPK_REG)                         { bad = 1; }
    if (mi.dst.reg != x64.RAX)                              { bad = 1; }
    if (mi.src1.reg != x64.RBX)                             { bad = 1; }
    if (item.src_off != 0 || item.src_len != 12)            { bad = 1; }

    if (R.is_err[bool, str](iasm.next(?c, ?item)))          { ret 1; }
    mi = x64_build(?item, intern.STR_NIL);
    if (mi.opcode != x64.XADD)                              { bad = 1; }
    if ((mi.flags & x64.FLAG_LOCK::u16) == 0)               { bad = 1; }
    if (mi.dst.kind != isa.OPK_MEM)                         { bad = 1; }
    if (mi.dst.base != x64.RCX)                             { bad = 1; }
    if (mi.src1.reg != x64.RAX)                             { bad = 1; }

    if (R.is_err[bool, str](iasm.next(?c, ?item)))          { ret 1; }
    if (x64_build(?item, intern.STR_NIL).opcode != x64.SYSCALL)             { bad = 1; }

    if (R.is_err[bool, str](iasm.next(?c, ?item)))          { ret 1; }
    if (item.kind != iasm.AI_LABEL || item.ref_num != 1)    { bad = 1; }

    if (R.is_err[bool, str](iasm.next(?c, ?item)))          { ret 1; }
    if (x64_build(?item, intern.STR_NIL).opcode != x64.JMP)                 { bad = 1; }
    if (item.ref != iasm.AR_LOCAL)                          { bad = 1; }
    if (item.ref_num != 1 || item.ref_fwd)                  { bad = 1; }

    val last: R.Result[bool, str] = iasm.next(?c, ?item);
    if (R.is_err[bool, str](last))    { ret 1; }
    if (R.unwrap_ok[bool, str](last)) { bad = 1; }
    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_clobbers:declared_raw_encodings" {
    var gp: u32 = 0;
    var fp: u32 = 0;
    var bad: i32 = 0;

    asm_clobbers(".byte 0xee :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0xee", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0x0f, 0x31 :: writes(rax, rdx)", ?gp, ?fp);
    if (gp != 0x5) { bad = 1; }
    if (fp != 0)   { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0x90 :: writes(xmm3)", ?gp, ?fp);
    if (gp != 0)            { bad = 1; }
    if (fp != (1::u32 << 3)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0x90 :: writes(rbx, xmm15)", ?gp, ?fp);
    if (gp != (1::u32 << 3))  { bad = 1; }
    if (fp != (1::u32 << 15)) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0xee :: writes()\n.byte 0x90", ?gp, ?fp);
    if (gp != X64_ALL_GP) { bad = 1; }
    if (fp != X64_ALL_FP) { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers("mov rdx, rcx\n.byte 0xee :: writes()", ?gp, ?fp);
    if (gp != (1::u32 << 2)) { bad = 1; }
    if (fp != 0)             { bad = 1; }

    gp = 0; fp = 0;
    asm_clobbers(".byte 0xee   ::   writes( rax , rdx )", ?gp, ?fp);
    if (gp != 0x5) { bad = 1; }
    gp = 0; fp = 0;
    asm_clobbers(".byte 0xee :: writes() ; .byte 0x90 :: writes(rcx)", ?gp, ?fp);
    if (gp != (1::u32 << 1)) { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.declared_raw_encodings:emit_and_accounting" {
    var bad: i32 = 0;

    var one: [1]u8;
    one[0] = 0xEE;
    if (!t_asm_bytes(".byte 0xee :: writes()", ?one[0], 1)) { bad = 1; }

    var two: [2]u8;
    two[0] = 0x0F; two[1] = 0x31;
    if (!t_asm_bytes(".byte 0x0f, 0x31 :: writes(rax, rdx)", ?two[0], 2)) { bad = 1; }

    var g: iasm.Grammar = x64_grammar();
    var c: iasm.Cursor;
    iasm.cursor_init(?c, ?g, ".byte 0xee :: writes(rax)", nil, nil, nil, nil);
    var item: iasm.Item;
    if (R.is_err[bool, str](iasm.next(?c, ?item))) { ret 1; }
    if (item.kind != iasm.AI_BYTES)                { bad = 1; }
    if (!item.declared)                            { bad = 1; }
    if (item.decl_gp != 1)                         { bad = 1; }
    if (item.decl_fp != 0)                         { bad = 1; }
    if (item.byte_count != 1)                      { bad = 1; }

    val last: R.Result[bool, str] = iasm.next(?c, ?item);
    if (R.is_err[bool, str](last))    { ret 1; }
    if (R.unwrap_ok[bool, str](last)) { bad = 1; }

    var c2: iasm.Cursor;
    iasm.cursor_init(?c2, ?g, ".byte 0xee", nil, nil, nil, nil);
    if (R.is_err[bool, str](iasm.next(?c2, ?item))) { ret 1; }
    if (item.declared)                              { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.declared_raw_encodings:malformed_clauses_refused" {
    var bad: i32 = 0;

    if (!t_asm_refused(".byte 0x90 :: writes(nosuchreg)", "not a register on this target")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(r16)", "not a register on this target"))       { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(eax)", "not a register on this target"))       { bad = 1; }

    if (!t_asm_refused(".byte 0x90 :: writes(rax", "closing"))        { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes", "parenthesized"))      { bad = 1; }
    if (!t_asm_refused(".byte 0x90 ::", "names no attribute"))        { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(rax,)", "empty"))        { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(,rax)", "empty"))        { bad = 1; }

    if (!t_asm_refused(".byte 0x90 :: reads(rax)", "unknown"))        { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: noreturn", "unknown"))          { bad = 1; }

    if (!t_asm_refused("mov rax, rbx :: writes()", "only a data directive")) { bad = 1; }
    if (!t_asm_refused("nop :: writes()", "only a data directive"))          { bad = 1; }
    if (!t_asm_refused("1: :: writes()", "only a data directive"))           { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_scan:a_spill_does_not_launder_a_secret" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val addr: str = "mov rax, {r}\nmov [rsp], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    if (!R.is_err[R.Void, str](asm_ct_scan(addr, ?names[0], 1, false, false, ?alloc)))  { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(addr, ?names[0], 0, false, false, ?alloc)))   { bad = bad + 2; }

    val lat: str = "mov rax, {r}\nmov [rsp], rax\nmov rcx, [rsp]\nshl rdx, cl";
    if (!R.is_err[R.Void, str](asm_ct_scan(lat, ?names[0], 1, false, false, ?alloc)))   { bad = bad + 4; }
    if (R.is_err[R.Void, str](asm_ct_scan(lat, ?names[0], 0, false, false, ?alloc)))    { bad = bad + 8; }

    val br: str = "mov rax, {r}\nmov [rsp], rax\nmov rbx, [rsp]\ncmp rbx, 1\njz 1f\n1:\nnop";
    if (!R.is_err[R.Void, str](asm_ct_scan(br, ?names[0], 1, false, false, ?alloc)))    { bad = bad + 16; }
    if (R.is_err[R.Void, str](asm_ct_scan(br, ?names[0], 0, false, false, ?alloc)))     { bad = bad + 32; }

    val pub: str = "mov [rsp], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    if (R.is_err[R.Void, str](asm_ct_scan(pub, ?names[0], 1, false, false, ?alloc)))    { bad = bad + 64; }

    val opaque: str = "mov rax, {r}\nmov [rdx + rsi * 8], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    if (!R.is_err[R.Void, str](asm_ct_scan(opaque, ?names[0], 1, false, false, ?alloc))) { bad = bad + 128; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_scan:implicit_read_taints_defined_flags" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val cx: str = "mov rax, {r}\ncmpxchg [rbx], rcx\nje 1f\n1:\nnop";
    if (!R.is_err[R.Void, str](asm_ct_scan(cx, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(cx, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val pub: str = "mov rax, 5\ncmpxchg [rbx], rcx\nje 1f\n1:\nnop";
    if (R.is_err[R.Void, str](asm_ct_scan(pub, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }

    val unrelated: str = "mov rax, {r}\nmov rdx, [rbx]\nje 1f\n1:\nnop";
    if (R.is_err[R.Void, str](asm_ct_scan(unrelated, ?names[0], 1, false, false, ?alloc))) { bad = bad + 8; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_scan:register_indirect_transfer_on_secret_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val jt: str = "mov rax, {r}\njmp rax";
    if (!R.is_err[R.Void, str](asm_ct_scan(jt, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(jt, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val ct: str = "mov rax, {r}\ncall rax";
    if (!R.is_err[R.Void, str](asm_ct_scan(ct, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }
    if (R.is_err[R.Void, str](asm_ct_scan(ct, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 8; }

    val pubj: str = "mov rax, 5\njmp rax";
    if (R.is_err[R.Void, str](asm_ct_scan(pubj, ?names[0], 1, false, false, ?alloc))) { bad = bad + 16; }

    val pubc: str = "mov rax, 5\ncall rax";
    if (R.is_err[R.Void, str](asm_ct_scan(pubc, ?names[0], 1, false, false, ?alloc))) { bad = bad + 32; }

    val direct: str = "jmp some_symbol";
    if (R.is_err[R.Void, str](asm_ct_scan(direct, ?names[0], 1, false, false, ?alloc))) { bad = bad + 64; }

    ret bad;
}

test "mach.lang.target.isa.x64.encode.asm_ct_scan:push_pop_launders_a_secret_register" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]str;
    names[0] = "r";

    val leak: str = "mov rax, {r}\npush rax\npop rbx\ncmp rbx, 1\nje 1f\n1:\nnop";
    if (!R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 1, false, false, ?alloc))) { bad = bad + 1; }
    if (R.is_err[R.Void, str](asm_ct_scan(leak, ?names[0], 0, false, false, ?alloc)))  { bad = bad + 2; }

    val pub: str = "mov rax, 5\npush rax\npop rbx\ncmp rbx, 1\nje 1f\n1:\nnop";
    if (R.is_err[R.Void, str](asm_ct_scan(pub, ?names[0], 1, false, false, ?alloc))) { bad = bad + 4; }

    val noflow: str = "mov rax, {r}\npush rax\npop rbx";
    if (R.is_err[R.Void, str](asm_ct_scan(noflow, ?names[0], 1, false, false, ?alloc))) { bad = bad + 8; }

    ret bad;
}

