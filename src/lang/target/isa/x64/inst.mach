    OpRow{op: x64.VCVTPH2PS, name: "vcvtph2ps", form: FORM_SSE_MOVA, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.VCVTPS2PH, name: "vcvtps2ph", form: FORM_PINSR, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.PINSRW, name: "pinsrw", form: FORM_PINSR, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PEXTRW, name: "pextrw", form: FORM_PINSR, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.VPMULLQ, name: "vpmullq", form: FORM_VEX3, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP, mul: ct.CT_MUL_LOW, lanes: 64},
    # a string compare defines the flags as cmp does; written until the probe can
    # measure it, since the seed cannot assemble it yet
    OpRow{op: x64.MOVSW, name: "movsw", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.MOVSD_STRING, name: "movsd", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.MOVSQ, name: "movsq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.STOSB, name: "stosb", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.STOSW, name: "stosw", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.STOSD, name: "stosd", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.STOSQ, name: "stosq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.LODSB, name: "lodsb", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.LODSW, name: "lodsw", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.LODSD, name: "lodsd", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.LODSQ, name: "lodsq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.CMPSB, name: "cmpsb", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.CMPSW, name: "cmpsw", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.CMPSD, name: "cmpsd", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.CMPSQ, name: "cmpsq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.SCASB, name: "scasb", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.SCASW, name: "scasw", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.SCASD, name: "scasd", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.SCASQ, name: "scasq", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_WRITTEN},
    OpRow{op: x64.PMOVSXBD, name: "pmovsxbd", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PMOVSXBQ, name: "pmovsxbq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PMOVSXWQ, name: "pmovsxwq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PMOVZXBD, name: "pmovzxbd", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PMOVZXBQ, name: "pmovzxbq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PMOVZXWQ, name: "pmovzxwq", form: FORM_PACKED, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PSADBW, name: "psadbw", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.VEXTRACTF128, name: "vextractf128", form: FORM_PSHUF, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.VINSERTF128, name: "vinsertf128", form: FORM_VEX3, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.VPERMQ, name: "vpermq", form: FORM_PSHUF, shape: SHAPE_DEF, arity: 3, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PCMPGTQ, name: "pcmpgtq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.PCMPEQQ, name: "pcmpeqq", form: FORM_PACKED, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
};

fun class_of(r: *OpRow) ct.AsmClass {
    if (r.flags == FL_UNKNOWN)      { ret ct.asm_unknown(); }
    if (r.flags == FL_BRANCH_FLAGS) { ret ct.asm_branch_flags(); }
    if (r.flags == FL_BRANCH_REG)   { ret ct.untouched_branch_reg(); }
    var a: ct.AsmClass = ct.asm_op(r.ctop);
    if (r.mul != ct.CT_MUL_NONE && r.lanes != 0) { a = ct.asm_mul_lanes(r.mul, r.lanes); }
    if (r.mul != ct.CT_MUL_NONE && r.lanes == 0) { a = ct.asm_mul_forms(r.mul, r.one); }
    if (r.flags == FL_DEFINED)                   { ret ct.flags_defined(a); }
    if (r.flags == FL_WRITTEN)                   { ret ct.flags_written(a); }
    if (r.flags == FL_READ)                      { ret ct.flags_read(a); }
    if (r.flags == FL_OPAQUE)                    { ret ct.flags_opaque(a); }
    if (r.flags == FL_CARRY)                     { ret ct.flags_written(ct.flags_read(a)); }
    ret ct.flags_untouched(a);
}

# the row of an opcode; the inline-asm block marker and anything outside the
# catalog describe as the marker's row, FORM_NONE with an unknown class
pub fun describe(op: u16) OpDesc {
    var r: *OpRow = ?OPS[x64.ASM_BLOCK];
    if (op::u32 < OPCODE_COUNT) { r = ?OPS[op]; }
    var d: OpDesc;
    d.name  = r.name;
    d.form  = r.form;
    d.shape = r.shape;
    d.arity = r.arity;
    d.mem   = r.mem;
    d.cls   = class_of(r);
    ret d;
}

# every row sits at its opcode's value, so an opcode added without a row, or
# two opcodes merged in at one value, fails here
test describe__every_row_sits_at_its_opcode {
    var i: u32 = 0;
    for (i < OPCODE_COUNT) {
        if (OPS[i].op::u32 != i) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

# the forms whose operands live in the xmm file, wholly or on one side
#[testing]
pub fun form_is_float(form: Form) bool {
    ret form == FORM_MOVQ || form == FORM_SSE_MOV || form == FORM_SSE_MOVA ||
        form == FORM_SSE_ALU || form == FORM_UCOMIS || form == FORM_CVT ||
        form == FORM_XORPS || form == FORM_PACKED || form == FORM_PSHUF || form == FORM_PSLL ||
        form == FORM_PINSR || form == FORM_VEX3;
}

#[testing]
pub fun is_fp_opcode(op: u16) bool {
    ret form_is_float(describe(op).form);
}
