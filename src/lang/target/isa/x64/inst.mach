# the x64 instruction catalog: what each opcode is, the form it encodes through, the
# operands it reads and writes and the flags it touches
use std.types.bool.bool;
use mach.lang.ct;
use mach.lang.target.isa.x64;
use std.types.size.usize;
use std.types.string.str;

def EncFlag: u16;

pub val FLAG_REX_W: EncFlag = 1;

pub val FLAG_16BIT: EncFlag = 2;

pub val FLAG_LOCK: EncFlag = 4;

pub val FLAG_REP: EncFlag = 8;

pub val FLAG_INDIRECT: EncFlag = 16;

# the f2 prefix of a string instruction: repne, repeated while zf is clear.
# FLAG_REP is f3, which a compare reads as repe
pub val FLAG_REPNE: EncFlag = 64;

# the vex encoding of a legacy packed opcode: the destination, the sources in
# intel order after it, and the mnemonic spelled with its v
pub val FLAG_VEX: EncFlag = 128;

pub val MEM_BASE_ABS: i32 = -2;

# the segment override a memory operand carries (isa_inst.Operand.seg). only fs
# and gs relocate an address in long mode; es, cs, ss and ds are ignored
def Segment: u8;

pub val SEG_NONE: Segment = 0;

pub val SEG_FS: Segment = 1;

pub val SEG_GS: Segment = 2;

pub rec SegmentRow {
    name:   str;
    seg:    Segment;
    prefix: u8;
}

pub val SEGMENT_COUNT: usize = 2;

pub val SEGMENTS: [SEGMENT_COUNT]SegmentRow = [SEGMENT_COUNT]SegmentRow{
    SegmentRow{name: "fs", seg: SEG_FS, prefix: 0x64},
    SegmentRow{name: "gs", seg: SEG_GS, prefix: 0x65},
};

# the row of a segment override; nil for SEG_NONE and anything unassigned
pub fun segment_row(seg: u8) *SegmentRow {
    var i: usize = 0;
    for (i < SEGMENT_COUNT) {
        if (SEGMENTS[i].seg == seg) { ret ?SEGMENTS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the instruction form of an opcode: the operand shape the encoder admits and
# the encoder family that emits it. every opcode the stream can carry has
# exactly one; FORM_NONE is the absence of a row and every reader refuses it
pub def Form: u8;

pub val FORM_NONE: Form = 0;

# fixed bytes, no explicit operand
pub val FORM_BARE: Form = 1;

# mov: dst r/m, src r/m, imm or sym
pub val FORM_MOV: Form = 2;

# lea: dst r, src m taken as an address
pub val FORM_LEA: Form = 3;

# push: src r or imm, through the stack
pub val FORM_PUSH: Form = 4;

# pop: dst r, through the stack
pub val FORM_POP: Form = 5;

# add sub and or xor cmp: dst r/m, src r/m or imm
pub val FORM_ALU: Form = 6;

# test: dst r/m, src r or imm
pub val FORM_TEST: Form = 7;

# imul: src r/m into rdx:rax, dst r with src r/m, or dst r with src r/m and imm
pub val FORM_IMUL: Form = 8;

# idiv div: src r/m over rdx:rax
pub val FORM_DIV: Form = 9;

# shl shr sar: dst r/m, count imm or cl
pub val FORM_SHIFT: Form = 10;

# jcc: a label
pub val FORM_JCC: Form = 11;

# jmp: a label, a sym, or r/m
pub val FORM_JMP: Form = 12;

# call: a sym or r/m, through the stack
pub val FORM_CALL: Form = 13;

# ret iretq: through the stack
pub val FORM_RET: Form = 14;

# setcc: dst r8
pub val FORM_SETCC: Form = 15;

# movzx movsx movsxd: dst r, src r/m
pub val FORM_MOVX: Form = 16;

# movabs: dst r, imm64 or sym
pub val FORM_MOVABS: Form = 17;

# movq: r to xmm or xmm to r
pub val FORM_MOVQ: Form = 18;

# movss movsd: xmm to xmm or m, m to xmm
pub val FORM_SSE_MOV: Form = 19;

# movaps movups: xmm to xmm or m128, m128 to xmm
pub val FORM_SSE_MOVA: Form = 20;

# scalar sse arithmetic: dst xmm, src xmm or m
pub val FORM_SSE_ALU: Form = 21;

# ucomiss ucomisd: xmm, xmm or m
pub val FORM_UCOMIS: Form = 22;

# scalar conversions between r and xmm
pub val FORM_CVT: Form = 23;

# xorps: dst xmm, src xmm or m128
pub val FORM_XORPS: Form = 24;

# packed sse2 arithmetic, logic and compare: dst xmm, src xmm or m128
pub val FORM_PACKED: Form = 25;

# pshufd: dst xmm, src xmm, imm8
pub val FORM_PSHUF: Form = 26;

# pslld psllw psraw psrad: dst xmm, imm8
pub val FORM_PSLL: Form = 27;

# neg not: r/m
pub val FORM_GRP3: Form = 28;

# inc dec: r/m
pub val FORM_GRP5: Form = 29;

# xchg: r, r/m
pub val FORM_XCHG: Form = 30;

# xadd cmpxchg: r/m, r
pub val FORM_XADD: Form = 31;

# in out: al ax eax with dx or imm8
pub val FORM_PORTIO: Form = 32;

# lidt: m
pub val FORM_LIDT: Form = 33;

# mov to or from a control register
pub val FORM_MOV_CR: Form = 34;

# mov to or from a segment register
pub val FORM_MOV_SEG: Form = 35;

# movs stos lods cmps scas: through rsi, rdi or both, rcx times under a rep prefix
pub val FORM_STRING: Form = 36;

# ud2 hlt: never continues
pub val FORM_TRAP: Form = 37;

# a data byte in the stream (raw_byte), not an instruction
pub val FORM_DATA: Form = 38;

# rdfsbase rdgsbase wrfsbase wrgsbase: r32 or r64
pub val FORM_FSGSBASE: Form = 39;

# pinsrd pextrd: an xmm and an r32 or m32, with imm8
pub val FORM_PINSR: Form = 40;

# mul: src r/m by rax into rdx:rax
pub val FORM_MUL1: Form = 41;

# bsf bsr popcnt lzcnt tzcnt: a 16-, 32- or 64-bit register from an r/m of the same width
pub val FORM_BITSCAN: Form = 42;

# bswap: one 32- or 64-bit register, reversed in place
pub val FORM_BSWAP: Form = 43;

# shld shrd: an r/m, the register feeding bits, and a count of imm8 or cl
pub val FORM_DSHIFT: Form = 44;

# sbb: r/m less a register or imm and the carry, which it reads
pub val FORM_CARRY: Form = 45;

# cmovcc: an r/m moved into a register on a flags condition, which it reads
pub val FORM_CMOV: Form = 46;

# a vex or evex three-operand packed instruction: dst xmm, src1 xmm in vvvv, src2 xmm or m128
pub val FORM_VEX3: Form = 47;

#[testing]
pub val FORM_COUNT: u32 = 48;

# the role pattern of the explicit operands, in intel order
pub def Shape: u8;

pub val SHAPE_NONE: Shape = 0;

# the first operand is written, the second read
pub val SHAPE_DEF: Shape = 1;

# the first operand is read and written, the second read
pub val SHAPE_RW: Shape = 2;

# every operand is read
pub val SHAPE_USE: Shape = 3;

# every operand is read and written
pub val SHAPE_SWAP: Shape = 4;

# the operand is a transfer target
pub val SHAPE_XFER: Shape = 5;

#[testing]
pub val SHAPE_COUNT: u32 = 6;

# how the instruction reaches memory, as bits
pub def MemEffect: u8;

pub val MEM_NONE: MemEffect = 0;

# through an r/m operand, read or written as that position's role says
pub val MEM_OPERAND: MemEffect = 1;

# a memory operand read as an address only, never accessed
pub val MEM_ADDR: MemEffect = 2;

# through rsp with no explicit address
pub val MEM_STACK: MemEffect = 4;

# through rsi and rdi with no explicit address
pub val MEM_STRING: MemEffect = 8;

# the register operand becomes a segment base that later fs- or gs-relative
# operands address through, so its value is an address
pub val MEM_BASE: MemEffect = 16;

#[testing]
pub val MEM_ALL: MemEffect = 31;

# the description of one opcode: its spelling, its form and operand shape,
# the flags it reads and writes with its latency class, and how it reaches
# memory. the encoder, the printer, the effect walk, the inline-asm scan and
# the range predicates all read this row and nothing else describes an opcode
pub rec OpDesc {
    # the printed mnemonic, nil for an opcode with no spelling
    name:  str;
    form:  Form;
    shape: Shape;
    # explicit operand positions the form takes, in intel order
    arity: u8;
    mem:   MemEffect;
    cls:   ct.AsmClass;
}

# how a catalog row touches rflags, applied over its ct op
def FlagUse: u8;

val FL_KEEP: FlagUse = 0;

val FL_DEFINED: FlagUse = 1;

val FL_WRITTEN: FlagUse = 2;

val FL_READ: FlagUse = 3;

val FL_OPAQUE: FlagUse = 4;

# reads the carry and writes the flags
val FL_CARRY: FlagUse = 5;

# a transfer on a flags condition, and one through a register
val FL_BRANCH_FLAGS: FlagUse = 6;

val FL_BRANCH_REG: FlagUse = 7;

# no stated class: the stream is refused rather than walked as public
val FL_UNKNOWN: FlagUse = 8;

# one catalog row. `ctop` is the ct op of a row that is not a multiply; a
# multiply row names the product it realizes in `mul`, the product of its
# one-operand form in `one`, or its lane width in bits in `lanes` when packed
rec OpRow {
    op:    x64.Opcode;
    name:  str;
    form:  Form;
    shape: Shape;
    arity: u8;
    mem:   MemEffect;
    flags: FlagUse;
    ctop:  ct.CtOp;
    mul:   ct.CtMulOp;
    one:   ct.CtMulOp;
    lanes: u8;
}

# the opcodes the catalog holds, one past the highest x64.Opcode
pub val OPCODE_COUNT: u32 = 255;

# the opcode catalog, one row per x64.Opcode at its value
val OPS: [OPCODE_COUNT]OpRow = [OPCODE_COUNT]OpRow{
    OpRow{op: x64.NOP, name: "nop", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.MOV, name: "mov", form: FORM_MOV, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.LEA, name: "lea", form: FORM_LEA, shape: SHAPE_DEF, arity: 2, mem: MEM_ADDR, flags: FL_KEEP},
    OpRow{op: x64.PUSH, name: "push", form: FORM_PUSH, shape: SHAPE_USE, arity: 1, mem: MEM_STACK, flags: FL_KEEP},
    OpRow{op: x64.POP, name: "pop", form: FORM_POP, shape: SHAPE_DEF, arity: 1, mem: MEM_STACK, flags: FL_KEEP},
    OpRow{op: x64.ADD, name: "add", form: FORM_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.SUB, name: "sub", form: FORM_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.IMUL, name: "imul", form: FORM_IMUL, shape: SHAPE_RW, arity: 3, mem: MEM_OPERAND, flags: FL_WRITTEN, mul: ct.CT_MUL_LOW, one: ct.CT_MUL_WIDE_S},
    OpRow{op: x64.IDIV, name: "idiv", form: FORM_DIV, shape: SHAPE_USE, arity: 1, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_INT_DIVMOD},
    OpRow{op: x64.DIV, name: "div", form: FORM_DIV, shape: SHAPE_USE, arity: 1, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_INT_DIVMOD},
    OpRow{op: x64.AND, name: "and", form: FORM_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.OR, name: "or", form: FORM_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.XOR, name: "xor", form: FORM_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.SHL, name: "shl", form: FORM_SHIFT, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_VAR_SHIFT},
    OpRow{op: x64.SHR, name: "shr", form: FORM_SHIFT, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_VAR_SHIFT},
    OpRow{op: x64.SAR, name: "sar", form: FORM_SHIFT, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_WRITTEN, ctop: ct.CT_OP_VAR_SHIFT},
    OpRow{op: x64.CMP, name: "cmp", form: FORM_ALU, shape: SHAPE_USE, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.TEST, name: "test", form: FORM_TEST, shape: SHAPE_USE, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.JMP, name: "jmp", form: FORM_JMP, shape: SHAPE_XFER, arity: 1, mem: MEM_OPERAND, flags: FL_BRANCH_REG},
    OpRow{op: x64.CALL, name: "call", form: FORM_CALL, shape: SHAPE_XFER, arity: 1, mem: MEM_OPERAND | MEM_STACK, flags: FL_BRANCH_REG},
    OpRow{op: x64.RET, name: "ret", form: FORM_RET, shape: SHAPE_NONE, arity: 0, mem: MEM_STACK, flags: FL_KEEP},
    OpRow{op: x64.JE, name: "je", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JNE, name: "jne", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JL, name: "jl", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JLE, name: "jle", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JG, name: "jg", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JGE, name: "jge", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JB, name: "jb", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JBE, name: "jbe", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JA, name: "ja", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.JAE, name: "jae", form: FORM_JCC, shape: SHAPE_XFER, arity: 1, mem: MEM_NONE, flags: FL_BRANCH_FLAGS},
    OpRow{op: x64.SETE, name: "sete", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETNE, name: "setne", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETL, name: "setl", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETLE, name: "setle", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETG, name: "setg", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETGE, name: "setge", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETB, name: "setb", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETBE, name: "setbe", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETA, name: "seta", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.SETAE, name: "setae", form: FORM_SETCC, shape: SHAPE_DEF, arity: 1, mem: MEM_NONE, flags: FL_READ},
    OpRow{op: x64.MOVSS, name: "movss", form: FORM_SSE_MOV, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.MOVSD, name: "movsd", form: FORM_SSE_MOV, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.ADDSS, name: "addss", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.ADDSD, name: "addsd", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.SUBSS, name: "subss", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.SUBSD, name: "subsd", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.MULSS, name: "mulss", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.MULSD, name: "mulsd", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.DIVSS, name: "divss", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.DIVSD, name: "divsd", form: FORM_SSE_ALU, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.SYSCALL, name: "syscall", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_OPAQUE},
    OpRow{op: x64.MOVABS, name: "movabs", form: FORM_MOVABS, shape: SHAPE_DEF, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.UD2, name: "ud2", form: FORM_TRAP, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.PAUSE, name: "pause", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.CDQ, name: "cdq", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.CQO, name: "cqo", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.MOVSX, name: "movsx", form: FORM_MOVX, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.MOVZX, name: "movzx", form: FORM_MOVX, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.MOVSXD, name: "movsxd", form: FORM_MOVX, shape: SHAPE_DEF, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.CVTSI2SS, name: "cvtsi2ss", form: FORM_CVT, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.CVTSI2SD, name: "cvtsi2sd", form: FORM_CVT, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.CVTSS2SD, name: "cvtss2sd", form: FORM_CVT, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.CVTSD2SS, name: "cvtsd2ss", form: FORM_CVT, shape: SHAPE_RW, arity: 2, mem: MEM_NONE, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.CVTTSS2SI, name: "cvttss2si", form: FORM_CVT, shape: SHAPE_DEF, arity: 2, mem: MEM_NONE, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.CVTTSD2SI, name: "cvttsd2si", form: FORM_CVT, shape: SHAPE_DEF, arity: 2, mem: MEM_NONE, flags: FL_KEEP, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.UCOMISS, name: "ucomiss", form: FORM_UCOMIS, shape: SHAPE_USE, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.UCOMISD, name: "ucomisd", form: FORM_UCOMIS, shape: SHAPE_USE, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED, ctop: ct.CT_OP_FLOAT},
    OpRow{op: x64.MOVSB, name: "movsb", form: FORM_STRING, shape: SHAPE_NONE, arity: 0, mem: MEM_STRING, flags: FL_KEEP},
    OpRow{op: x64.MFENCE, name: "mfence", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.ASM_BLOCK, name: nil, form: FORM_NONE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_UNKNOWN},
    OpRow{op: x64.CBW, name: "cbw", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.CWD, name: "cwd", form: FORM_BARE, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.MOVQ, name: "movq", form: FORM_MOVQ, shape: SHAPE_DEF, arity: 2, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.XORPS, name: "xorps", form: FORM_XORPS, shape: SHAPE_RW, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.NEG, name: "neg", form: FORM_GRP3, shape: SHAPE_RW, arity: 1, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.NOT, name: "not", form: FORM_GRP3, shape: SHAPE_RW, arity: 1, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.INC, name: "inc", form: FORM_GRP5, shape: SHAPE_RW, arity: 1, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: x64.DEC, name: "dec", form: FORM_GRP5, shape: SHAPE_RW, arity: 1, mem: MEM_OPERAND, flags: FL_WRITTEN},
    OpRow{op: x64.HLT, name: "hlt", form: FORM_TRAP, shape: SHAPE_NONE, arity: 0, mem: MEM_NONE, flags: FL_KEEP},
    OpRow{op: x64.XCHG, name: "xchg", form: FORM_XCHG, shape: SHAPE_SWAP, arity: 2, mem: MEM_OPERAND, flags: FL_KEEP},
    OpRow{op: x64.XADD, name: "xadd", form: FORM_XADD, shape: SHAPE_SWAP, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
    OpRow{op: x64.CMPXCHG, name: "cmpxchg", form: FORM_XADD, shape: SHAPE_SWAP, arity: 2, mem: MEM_OPERAND, flags: FL_DEFINED},
