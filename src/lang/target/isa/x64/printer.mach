# x86-64 assembly text printer - renders the encoder's own instruction stream
#
# This is the text half of the x64 ISA's `emit_asm` operation. It does NOT walk
# the MIR: `encode.encode_x64_asm` runs the ordinary encoder with an `enc.AsmSink`
# attached, and the encoder calls `note_inst` once for every machine instruction
# it emits, immediately after emitting it. Each line of the `.s` is therefore one
# instruction the encoder really produced, in the order it produced it.
#
# That is the whole point of the design. The previous printer was a second,
# independent renderer that walked the post-regalloc MIR, so a MIR macro-op the
# encoder expands into several machine instructions (a three-address ALU op, a
# fused compare-and-branch, a compare) printed as a single pseudo-mnemonic line
# that no assembler would accept and no disassembly would match - the `.s`
# under-reported the emitted code by 16% on x86-64 and hid the prologue's
# counterpart entirely (#2187). Rendering from the encoder makes that class of
# divergence unrepresentable: there is one implementation of "what does this MIR
# become", and the artifact is a view of it.
#
# What this module may read is correspondingly narrow. The mnemonic and every
# operand come from the concrete `isa.Inst` the encoder built. The MIR instruction
# on the sink is consulted only for names the machine operand cannot carry - a
# branch's target block and a symbol reference's name, both erased by
# `mir_to_operand` - and never to choose a mnemonic or an operand.
#
# An opcode with no mnemonic, or an operand shape that does not render, is a hard
# error naming the opcode. Silent degradation is what let the old divergence go
# unnoticed, so there is no fallback text anywhere in this module.

use std.format;
use std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;

use enc: mach.lang.be.codegen.encode;
use mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;

# write the assembly file header
# ---
# out: destination writer
# ret: true on success, or the write error
pub fun emit_header(out: *writer.Writer) R.Result[bool, str] {
    ret emit_str(out, ".intel_syntax noprefix\n");
}

# render one function's introducing header
#
# Emits no bytes, so it leaves the sink's byte accounting untouched.
# ---
# buf:      the encoder byte sink carrying the assembly sink
# interner: resolves the function's interned name
# f:        the function whose encoding is starting
# ret:      true on success, or the write error
pub fun note_function(buf: *enc.ByteBuf, interner: *intern.Interner, f: *mir.MirFunction) R.Result[bool, str] {
    val out: *writer.Writer = buf.asm.out;
    val res_nl: R.Result[bool, str] = emit_str(out, "\n# ");
    if (R.is_err[bool, str](res_nl)) { ret res_nl; }
    val res_name: R.Result[bool, str] = emit_name(out, interner, f.name);
    if (R.is_err[bool, str](res_name)) { ret res_name; }
    ret emit_str(out, ":\n");
}

# render one block's local label
#
# Emits no bytes, so it leaves the sink's byte accounting untouched.
# ---
# buf: the encoder byte sink carrying the assembly sink
# id:  the block id being entered
# ret: true on success, or the write error
pub fun note_block(buf: *enc.ByteBuf, id: u32) R.Result[bool, str] {
    val out: *writer.Writer = buf.asm.out;
    val res_dot: R.Result[bool, str] = emit_str(out, ".");
    if (R.is_err[bool, str](res_dot)) { ret res_dot; }
    val res_id: R.Result[bool, str] = emit_u64(out, id::u64);
    if (R.is_err[bool, str](res_id)) { ret res_id; }
    ret emit_str(out, ":\n");
}

# render one machine instruction the encoder just emitted
#
# The sink's single notification point. Renders `mi`, then marks every byte
# emitted so far as accounted; the encoder's totality guard compares that mark
# against the buffer length after each MIR opcode, so an emission path that never
# reaches here is reported rather than silently dropped from the artifact.
#
# Returns nothing: it runs on the encoder's hot path where no error can be
# threaded, so a write failure is latched on the sink and raised by the driver.
# ---
# buf: the encoder byte sink carrying the assembly sink
# mi:  the machine instruction just encoded
pub fun note_inst(buf: *enc.ByteBuf, mi: *isa.Inst) {
    val res: R.Result[bool, str] = render_inst(buf, mi);
    if (R.is_err[bool, str](res)) {
        enc.sink_fail(buf, R.unwrap_err[bool, str](res));
        ret;
    }
    enc.sink_account(buf);
}

# render `<mnemonic> <dst>, <src1>, <src2>` for one machine instruction
# ---
# buf: the encoder byte sink carrying the assembly sink
# mi:  the machine instruction to render
# ret: true on success, or the first error
fun render_inst(buf: *enc.ByteBuf, mi: *isa.Inst) R.Result[bool, str] {
    val out: *writer.Writer = buf.asm.out;

    val res_indent: R.Result[bool, str] = emit_str(out, "  ");
    if (R.is_err[bool, str](res_indent)) { ret res_indent; }

    val mnem: str = mnemonic_of(mi.opcode);
    if (mnem == nil) {
        ret R.err[bool, str]("--emit-asm: no x86-64 mnemonic for the emitted opcode");
    }
    val res_write: R.Result[bool, str] = emit_str(out, mnem);
    if (R.is_err[bool, str](res_write)) { ret res_write; }

    var printed: u32 = 0;
    val res_dst: R.Result[u32, str] = render_operand(buf, mi, ?mi.dst, printed);
    if (R.is_err[u32, str](res_dst)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_dst)); }
    printed = R.unwrap_ok[u32, str](res_dst);

    val res_src1: R.Result[u32, str] = render_operand(buf, mi, ?mi.src1, printed);
    if (R.is_err[u32, str](res_src1)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_src1)); }
    printed = R.unwrap_ok[u32, str](res_src1);

    val res_src2: R.Result[u32, str] = render_operand(buf, mi, ?mi.src2, printed);
    if (R.is_err[u32, str](res_src2)) { ret R.err[bool, str](R.unwrap_err[u32, str](res_src2)); }

    ret emit_str(out, "\n");
}

# render one operand, prefixed by the right separator for its position
# ---
# buf:     the encoder byte sink carrying the assembly sink
# mi:      the owning instruction (supplies the fallback width)
# op:      the operand to render
# printed: how many operands have been rendered already
# ret:     the new rendered-operand count, or an error
fun render_operand(buf: *enc.ByteBuf, mi: *isa.Inst, op: *isa.Operand, printed: u32) R.Result[u32, str] {
    if (op.kind == isa.OPK_NONE) { ret R.ok[u32, str](printed); }

    val out: *writer.Writer = buf.asm.out;
    var sep: str = ", ";
    if (printed == 0) { sep = " "; }
    val res_sep: R.Result[bool, str] = emit_str(out, sep);
    if (R.is_err[bool, str](res_sep)) { ret R.err[u32, str](R.unwrap_err[bool, str](res_sep)); }

    val res: R.Result[bool, str] = render_operand_body(buf, mi, op);
    if (R.is_err[bool, str](res)) { ret R.err[u32, str](R.unwrap_err[bool, str](res)); }
    ret R.ok[u32, str](printed + 1);
}

# render an operand's text
#
# A register names its physical register at the operand's width, in its own bank -
# the composite register id carries its class, so an SSE id prints an XMM name
# without the opcode being consulted. A memory operand renders
# `<size> [base + index*scale + disp]`, or `[rip + <symbol>]` for the base-less
# rip-relative form a symbol reference lowers to. A label renders the target block
# the branch was emitted for.
# ---
# buf: the encoder byte sink carrying the assembly sink
# mi:  the owning instruction (supplies the fallback width)
# op:  the operand to render
# ret: true on success, or an error naming the unrenderable shape
fun render_operand_body(buf: *enc.ByteBuf, mi: *isa.Inst, op: *isa.Operand) R.Result[bool, str] {
    val out: *writer.Writer = buf.asm.out;

    if (op.kind == isa.OPK_REG)   { ret emit_reg(out, op.reg, operand_width(mi, op)); }
    if (op.kind == isa.OPK_IMM)   { ret emit_i64(out, op.imm); }
    if (op.kind == isa.OPK_MEM)   { ret render_mem(buf, mi, op); }
    if (op.kind == isa.OPK_SYM)   { ret emit_sym(out, buf.asm.interner, op.sym_id); }
    if (op.kind == isa.OPK_LABEL) { ret render_label(buf, op); }

    ret R.err[bool, str]("--emit-asm: instruction operand has no renderable kind");
}

# render a memory operand as `<size> [base + index*scale + disp]`
#
# A base of -1 is the rip-relative form a symbol reference lowers to; its symbol
# id rides on the operand so the target is named rather than shown as a zero
# displacement the linker later fills in.
# ---
# buf: the encoder byte sink carrying the assembly sink
# mi:  the owning instruction (supplies the fallback width)
# op:  the memory operand to render
# ret: true on success, or the first write error
fun render_mem(buf: *enc.ByteBuf, mi: *isa.Inst, op: *isa.Operand) R.Result[bool, str] {
    val out: *writer.Writer = buf.asm.out;

    val res_size: R.Result[bool, str] = emit_str(out, size_prefix(operand_width(mi, op)));
    if (R.is_err[bool, str](res_size)) { ret res_size; }
    val res_open: R.Result[bool, str] = emit_str(out, "[");
    if (R.is_err[bool, str](res_open)) { ret res_open; }

    if (op.base < 0) {
        val res_rip: R.Result[bool, str] = emit_str(out, "rip + ");
        if (R.is_err[bool, str](res_rip)) { ret res_rip; }
        val res_sym: R.Result[bool, str] = emit_sym(out, buf.asm.interner, op.sym_id);
        if (R.is_err[bool, str](res_sym)) { ret res_sym; }
        ret emit_str(out, "]");
    }

    val res_base: R.Result[bool, str] = emit_reg(out, op.base, 8);
    if (R.is_err[bool, str](res_base)) { ret res_base; }

    if (op.index >= 0) {
        val res_plus: R.Result[bool, str] = emit_str(out, " + ");
        if (R.is_err[bool, str](res_plus)) { ret res_plus; }
        val res_index: R.Result[bool, str] = emit_reg(out, op.index, 8);
        if (R.is_err[bool, str](res_index)) { ret res_index; }
        if (op.scale > 1) {
            val res_star: R.Result[bool, str] = emit_str(out, "*");
            if (R.is_err[bool, str](res_star)) { ret res_star; }
            val res_scale: R.Result[bool, str] = emit_u64(out, op.scale::u64);
            if (R.is_err[bool, str](res_scale)) { ret res_scale; }
        }
    }

    if (op.disp != 0) {
        var sign: str = " + ";
        var mag:  i64 = op.disp::i64;
        if (op.disp < 0) { sign = " - "; mag = 0 - op.disp::i64; }
        val res_sign: R.Result[bool, str] = emit_str(out, sign);
        if (R.is_err[bool, str](res_sign)) { ret res_sign; }
        val res_disp: R.Result[bool, str] = emit_i64(out, mag);
        if (R.is_err[bool, str](res_disp)) { ret res_disp; }
    }
    ret emit_str(out, "]");
}

# render a branch target
#
# A block-target branch carries its destination block id (`isa.make_block_label`).
# An expansion-internal branch - the stack probe's loop edge and the unsigned
# 64-bit float conversion's two arms - has no block: the encoder patches its
# displacement directly, a few bytes later, and there is no name to give it. It
# renders as `<internal>` rather than inventing a target.
# ---
# buf: the encoder byte sink carrying the assembly sink
# op:  the label operand to render
# ret: true on success, or the write error
fun render_label(buf: *enc.ByteBuf, op: *isa.Operand) R.Result[bool, str] {
    val out: *writer.Writer = buf.asm.out;
    if (op.label != nil) { ret emit_str(out, op.label); }
    if (!label_is_block(buf, op)) { ret emit_str(out, "<internal>"); }

    val res_dot: R.Result[bool, str] = emit_str(out, ".");
    if (R.is_err[bool, str](res_dot)) { ret res_dot; }
    ret emit_u64(out, op.imm::u64);
}

# whether a nameless label operand carries a block id
#
# `isa.make_label(nil)` leaves `imm` zero and `isa.make_block_label` sets it, so
# the two are distinguishable except when the target really is block 0. The MIR
# instruction being encoded settles that case: only a branch carries block
# operands, so a non-branch reaching here is expansion-internal.
# ---
# buf: the encoder byte sink carrying the assembly sink
# op:  the label operand to classify
# ret: true when `imm` names a block
fun label_is_block(buf: *enc.ByteBuf, op: *isa.Operand) bool {
    if (op.imm != 0) { ret true; }
    val mi: *mir.MirInstr = buf.asm.mi;
    if (mi == nil) { ret false; }

    var i: u32 = 0;
    for (i < mi.operand_count) {
        if (mi.operands[i].kind == mir.MIR_OP_BLOCK && mi.operands[i].imm == 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the byte width an operand renders at
#
# The operand's own size when it carries one (every post-regalloc operand does),
# falling back to the instruction's operation width.
# ---
# mi: the owning instruction
# op: the operand
# ret: the render width in bytes
fun operand_width(mi: *isa.Inst, op: *isa.Operand) u8 {
    if (op.size != 0) { ret op.size; }
    if (mi.size != 0) { ret mi.size; }
    ret 8;
}

# write a register name in its own bank
#
# The composite register id encodes its class, so an SSE id names an XMM register
# regardless of the opcode and a general-purpose id names its width-appropriate
# form. A 16-byte width is a vector operand, always XMM.
# ---
# out:   destination writer
# id:    the composite register id to name
# width: the byte width a general-purpose register names at
# ret:   true on success, or the write error
fun emit_reg(out: *writer.Writer, id: i32, width: u8) R.Result[bool, str] {
    if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM || width == 16) {
        ret emit_str(out, x64.fp_reg_name(id));
    }
    ret emit_str(out, x64.reg_name(nil, id, width));
}

# the Intel operand-size keyword for a memory access width
# ---
# width: the access byte width
# ret:   the size keyword with a trailing space
fun size_prefix(width: u8) str {
    if (width == 1)  { ret "byte "; }
    if (width == 2)  { ret "word "; }
    if (width == 4)  { ret "dword "; }
    if (width == 8)  { ret "qword "; }
    if (width == 16) { ret "xmmword "; }
    ret "";
}

# the Intel mnemonic for a concrete x86-64 opcode, or nil when unmapped
#
# Total over the opcode space by construction: an unmapped opcode returns nil and
# the caller fails the build, never placeholder text. A new opcode that reaches
# the encoder without being added here breaks the render rather than printing
# something an assembler would reject.
# ---
# op:  the concrete x64 opcode to name
# ret: the mnemonic text, or nil for an opcode with no mapping
fun mnemonic_of(op: u16) str {
    if (op == x64.NOP)       { ret "nop"; }
    if (op == x64.MOV)       { ret "mov"; }
    if (op == x64.LEA)       { ret "lea"; }
    if (op == x64.PUSH)      { ret "push"; }
    if (op == x64.POP)       { ret "pop"; }
    if (op == x64.ADD)       { ret "add"; }
    if (op == x64.SUB)       { ret "sub"; }
    if (op == x64.IMUL)      { ret "imul"; }
    if (op == x64.IDIV)      { ret "idiv"; }
    if (op == x64.DIV)       { ret "div"; }
    if (op == x64.AND)       { ret "and"; }
    if (op == x64.OR)        { ret "or"; }
    if (op == x64.XOR)       { ret "xor"; }
    if (op == x64.SHL)       { ret "shl"; }
    if (op == x64.SHR)       { ret "shr"; }
    if (op == x64.SAR)       { ret "sar"; }
    if (op == x64.CMP)       { ret "cmp"; }
    if (op == x64.TEST)      { ret "test"; }
    if (op == x64.JMP)       { ret "jmp"; }
    if (op == x64.CALL)      { ret "call"; }
    if (op == x64.RET)       { ret "ret"; }
    if (op == x64.JE)        { ret "je"; }
    if (op == x64.JNE)       { ret "jne"; }
    if (op == x64.JL)        { ret "jl"; }
    if (op == x64.JLE)       { ret "jle"; }
    if (op == x64.JG)        { ret "jg"; }
    if (op == x64.JGE)       { ret "jge"; }
    if (op == x64.JB)        { ret "jb"; }
    if (op == x64.JBE)       { ret "jbe"; }
    if (op == x64.JA)        { ret "ja"; }
    if (op == x64.JAE)       { ret "jae"; }
    if (op == x64.SETE)      { ret "sete"; }
    if (op == x64.SETNE)     { ret "setne"; }
    if (op == x64.SETL)      { ret "setl"; }
    if (op == x64.SETLE)     { ret "setle"; }
    if (op == x64.SETG)      { ret "setg"; }
    if (op == x64.SETGE)     { ret "setge"; }
    if (op == x64.SETB)      { ret "setb"; }
    if (op == x64.SETBE)     { ret "setbe"; }
    if (op == x64.SETA)      { ret "seta"; }
    if (op == x64.SETAE)     { ret "setae"; }
    if (op == x64.SETP)      { ret "setp"; }
    if (op == x64.SETNP)     { ret "setnp"; }
    if (op == x64.MOVSS)     { ret "movss"; }
    if (op == x64.MOVSD)     { ret "movsd"; }
    if (op == x64.ADDSS)     { ret "addss"; }
    if (op == x64.ADDSD)     { ret "addsd"; }
    if (op == x64.SUBSS)     { ret "subss"; }
    if (op == x64.SUBSD)     { ret "subsd"; }
    if (op == x64.MULSS)     { ret "mulss"; }
    if (op == x64.MULSD)     { ret "mulsd"; }
    if (op == x64.DIVSS)     { ret "divss"; }
    if (op == x64.DIVSD)     { ret "divsd"; }
    if (op == x64.SYSCALL)   { ret "syscall"; }
    if (op == x64.MOVABS)    { ret "movabs"; }
    if (op == x64.UD2)       { ret "ud2"; }
    if (op == x64.PAUSE)     { ret "pause"; }
    if (op == x64.CDQ)       { ret "cdq"; }
    if (op == x64.CQO)       { ret "cqo"; }
    if (op == x64.MOVSX)     { ret "movsx"; }
    if (op == x64.MOVZX)     { ret "movzx"; }
    if (op == x64.MOVSXD)    { ret "movsxd"; }
    if (op == x64.CVTSI2SS)  { ret "cvtsi2ss"; }
    if (op == x64.CVTSI2SD)  { ret "cvtsi2sd"; }
    if (op == x64.CVTSS2SD)  { ret "cvtss2sd"; }
    if (op == x64.CVTSD2SS)  { ret "cvtsd2ss"; }
    if (op == x64.CVTTSS2SI) { ret "cvttss2si"; }
    if (op == x64.CVTTSD2SI) { ret "cvttsd2si"; }
    if (op == x64.UCOMISS)   { ret "ucomiss"; }
    if (op == x64.UCOMISD)   { ret "ucomisd"; }
    if (op == x64.MOVSB)     { ret "movsb"; }
    if (op == x64.MFENCE)    { ret "mfence"; }
    if (op == x64.CBW)       { ret "cbw"; }
    if (op == x64.CWD)       { ret "cwd"; }
    if (op == x64.MOVQ)      { ret "movq"; }
    if (op == x64.XORPS)     { ret "xorps"; }
    if (op == x64.NEG)       { ret "neg"; }
    if (op == x64.NOT)       { ret "not"; }
    if (op == x64.INC)       { ret "inc"; }
    if (op == x64.DEC)       { ret "dec"; }
    if (op == x64.HLT)       { ret "hlt"; }
    if (op == x64.XCHG)      { ret "xchg"; }
    if (op == x64.XADD)      { ret "xadd"; }
    if (op == x64.CMPXCHG)   { ret "cmpxchg"; }
    if (op == x64.RAW_BYTE)  { ret ".byte"; }
    ret nil;
}

# write a string, mapping a format error to the bool/str result shape
# ---
# out: destination writer
# s:   the string to write
# ret: true on success, or the write error
fun emit_str(out: *writer.Writer, s: str) R.Result[bool, str] {
    val res_write: R.Result[usize, str] = format.write_str(out, s);
    if (R.is_err[usize, str](res_write)) { ret R.err[bool, str](R.unwrap_err[usize, str](res_write)); }
    ret R.ok[bool, str](true);
}

# write an unsigned integer
# ---
# out: destination writer
# n:   the value to write
# ret: true on success, or the write error
fun emit_u64(out: *writer.Writer, n: u64) R.Result[bool, str] {
    val res_write: R.Result[usize, str] = format.write_u64(out, n);
    if (R.is_err[usize, str](res_write)) { ret R.err[bool, str](R.unwrap_err[usize, str](res_write)); }
    ret R.ok[bool, str](true);
}

# write a signed integer
# ---
# out: destination writer
# n:   the value to write
# ret: true on success, or the write error
fun emit_i64(out: *writer.Writer, n: i64) R.Result[bool, str] {
    val res_write: R.Result[usize, str] = format.write_i64(out, n);
    if (R.is_err[usize, str](res_write)) { ret R.err[bool, str](R.unwrap_err[usize, str](res_write)); }
    ret R.ok[bool, str](true);
}

# write an interned name, failing when the id does not resolve
# ---
# out:      destination writer
# interner: the interner that resolves the id to text
# id:       the interned string id to write
# ret:      true on success, or an error
fun emit_name(out: *writer.Writer, interner: *intern.Interner, id: intern.StrId) R.Result[bool, str] {
    val opt_name: O.Option[str] = intern.lookup(interner, id);
    if (O.is_none[str](opt_name)) {
        ret R.err[bool, str]("--emit-asm: a function name did not resolve in the interner");
    }
    ret emit_str(out, O.unwrap[str](opt_name));
}

# write a symbol reference's name, failing when the id does not resolve
# ---
# out:      destination writer
# interner: the interner that resolves the id to text
# id:       the symbol's interned string id
# ret:      true on success, or an error
fun emit_sym(out: *writer.Writer, interner: *intern.Interner, id: u32) R.Result[bool, str] {
    val opt_name: O.Option[str] = intern.lookup(interner, id::intern.StrId);
    if (O.is_none[str](opt_name)) {
        ret R.err[bool, str]("--emit-asm: a symbol reference did not resolve in the interner");
    }
    ret emit_str(out, O.unwrap[str](opt_name));
}
