use mach.lang.fail;
use std.allocator.page;
use std_format: std.format;
use io_error:   std.io.error;
use io_writer:  std.io.writer;
use system_os:  std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.string.str_starts_with;

use A: std.allocator;

use codegen_encode: mach.lang.be.codegen.encode;
use codegen_mir:    mach.lang.be.codegen.mir;
use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;

pub fun emit_header(out: *io_writer.Writer) err[fail.Fail] {
    ret emit_str(out, ".intel_syntax noprefix\n");
}

pub fun note_function(buf: *codegen_encode.ByteBuf, interner: *intern.Interner, f: *codegen_mir.MirFunction) err[fail.Fail] {
    var note: codegen_encode.AsmNote = codegen_encode.note_blank();
    note.kind = codegen_encode.ASM_NOTE_FUNC;
    note.off  = buf.len::u32;
    note.name = f.name;
    val kept: err[fail.Fail] = codegen_encode.note_push(buf, ?note);
    if (sel kept.err)                      { ret err[fail.Fail].err{kept.err}; }
    if (!codegen_encode.sink_renders(buf)) { ret err[fail.Fail].ok{}; }
    buf.asm.functions = buf.asm.functions + 1;
    val out:    *io_writer.Writer = buf.asm.out;
    val res_nl: err[fail.Fail]    = emit_str(out, "\n# ");
    if (sel res_nl.err) { ret res_nl; }
    val res_name: err[fail.Fail] = emit_name(out, interner, f.name);
    if (sel res_name.err) { ret res_name; }
    ret emit_str(out, ":\n");
}

pub fun note_block(buf: *codegen_encode.ByteBuf, id: u32) err[fail.Fail] {
    var note: codegen_encode.AsmNote = codegen_encode.note_blank();
    note.kind = codegen_encode.ASM_NOTE_BLOCK;
    note.off  = buf.len::u32;
    note.id   = id;
    val kept: err[fail.Fail] = codegen_encode.note_push(buf, ?note);
    if (sel kept.err)                      { ret err[fail.Fail].err{kept.err}; }
    if (!codegen_encode.sink_renders(buf)) { ret err[fail.Fail].ok{}; }
    val res_label: err[fail.Fail] = emit_block_label(buf, id::u64);
    if (sel res_label.err) { ret res_label; }
    ret emit_str(buf.asm.out, ":\n");
}

# a block's label, local to the assembler and apart from every other
# function's block of the same number, since one listing holds the module
fun emit_block_label(buf: *codegen_encode.ByteBuf, id: u64) err[fail.Fail] {
    val out:     *io_writer.Writer = buf.asm.out;
    val res_pre: err[fail.Fail]    = emit_str(out, ".L");
    if (sel res_pre.err) { ret res_pre; }
    val res_fn: err[fail.Fail] = emit_u64(out, buf.asm.functions::u64);
    if (sel res_fn.err) { ret res_fn; }
    val res_sep: err[fail.Fail] = emit_str(out, "_");
    if (sel res_sep.err) { ret res_sep; }
    ret emit_u64(out, id);
}

# notify first, render only for a writer: the stream is the same on every build
pub fun note_inst(buf: *codegen_encode.ByteBuf, mi: *isa.Inst, start: usize) {
    var note: codegen_encode.AsmNote = codegen_encode.note_blank();
    note.off  = start::u32;
    note.inst = @mi;
    val kept: err[fail.Fail] = codegen_encode.note_push(buf, ?note);
    if (sel kept.err) {
        codegen_encode.sink_fail(buf, fail.describe(kept.err));
        ret;
    }
    if (!codegen_encode.sink_renders(buf)) { ret; }
    val res_: err[fail.Fail] = render_inst(buf, mi);
    if (sel res_.err) { codegen_encode.sink_fail(buf, fail.describe(res_.err)); }
}

# the spelling of a string instruction's repeat prefix, nil for none: f3 is
# repe on a compare, which stops on the flags it writes, and rep otherwise
fun rep_prefix(mi: *isa.Inst) str {
    if ((mi.flags & x64.FLAG_REPNE::u16) != 0)    { ret "repne "; }
    if ((mi.flags & x64.FLAG_REP::u16) == 0)      { ret nil; }
    if (x64.describe(mi.opcode).cls.writes_flags) { ret "repe "; }
    ret "rep ";
}

fun render_inst(buf: *codegen_encode.ByteBuf, mi: *isa.Inst) err[fail.Fail] {
    val out: *io_writer.Writer = buf.asm.out;

    val res_indent: err[fail.Fail] = emit_str(out, "  ");
    if (sel res_indent.err) { ret res_indent; }

    if ((mi.flags & x64.FLAG_LOCK::u16) != 0) {
        val res_lock: err[fail.Fail] = emit_str(out, "lock ");
        if (sel res_lock.err) { ret res_lock; }
    }

    val rep: str = rep_prefix(mi);
    if (rep != nil) {
        val res_rep: err[fail.Fail] = emit_str(out, rep);
        if (sel res_rep.err) { ret res_rep; }
    }

    val packed_cmp: bool = is_packed_compare(mi);
    var mnem:       str  = x64.describe(mi.opcode).name;
    if (packed_cmp)                            { mnem = packed_compare_mnemonic(mi.opcode, packed_compare_predicate(mi).imm); }
    if (mi.opcode == x64.MOVQ && mi.size != 8) { mnem = "movd"; }
    if (mnem == nil) {
        ret err[fail.Fail].err{fail.message("--emit-asm: no x86-64 mnemonic for the emitted opcode")};
    }
    # a direct branch is always encoded with a 32-bit displacement, which the
    # assembler would otherwise relax to 8 bits where the target is near
    if (is_direct_branch(mi)) {
        val res_disp: err[fail.Fail] = emit_str(out, "{disp32} ");
        if (sel res_disp.err) { ret res_disp; }
    }
    # the vex form of a legacy opcode is spelled with its v
    if ((mi.flags & x64.FLAG_VEX::u16) != 0) {
        val res_v: err[fail.Fail] = emit_str(out, "v");
        if (sel res_v.err) { ret res_v; }
    }
    val res_write: err[fail.Fail] = emit_str(out, mnem);
    if (sel res_write.err) { ret res_write; }

    var printed: u32                 = 0;
    val res_dst: res[u32, fail.Fail] = render_operand(buf, mi, ?mi.dst, printed);
    if (sel res_dst.err) { ret err[fail.Fail].err{res_dst.err}; }
    printed = res_dst.ok;

    val res_src1: res[u32, fail.Fail] = render_operand(buf, mi, ?mi.src1, printed);
    if (sel res_src1.err) { ret err[fail.Fail].err{res_src1.err}; }
    printed = res_src1.ok;

    # a packed compare's predicate is its mnemonic, not an operand
    if (!(packed_cmp && packed_compare_predicate(mi) == ?mi.src2)) {
        val res_src2: res[u32, fail.Fail] = render_operand(buf, mi, ?mi.src2, printed);
        if (sel res_src2.err) { ret err[fail.Fail].err{res_src2.err}; }
        printed = res_src2.ok;
    }
    if (!(packed_cmp && packed_compare_predicate(mi) == ?mi.src3)) {
        val res_src3: res[u32, fail.Fail] = render_operand(buf, mi, ?mi.src3, printed);
        if (sel res_src3.err) { ret err[fail.Fail].err{res_src3.err}; }
    }

    ret emit_str(out, "\n");
}

fun is_direct_branch(mi: *isa.Inst) bool {
    val form: x64.Form = x64.describe(mi.opcode).form;
    if (form != x64.FORM_JCC && form != x64.FORM_JMP) { ret false; }
    ret (mi.flags & x64.FLAG_INDIRECT::u16) == 0;
}

fun is_packed_compare(mi: *isa.Inst) bool {
    if (mi.opcode != x64.CMPPS && mi.opcode != x64.CMPPD) { ret false; }
    ret packed_compare_predicate(mi).kind == isa.OPK_IMM;
}

# the operand a packed compare carries its predicate in: after the one source
# of the legacy form, and after the two of the vex form
fun packed_compare_predicate(mi: *isa.Inst) *isa.Operand {
    if ((mi.flags & x64.FLAG_VEX::u16) != 0) { ret ?mi.src3; }
    ret ?mi.src2;
}

fun packed_compare_mnemonic(op: u16, pred: i64) str {
    val single: bool = op == x64.CMPPS;
    if (pred == 0) {
        if (single) { ret "cmpeqps"; }
        ret "cmpeqpd";
    }
    if (pred == 1) {
        if (single) { ret "cmpltps"; }
        ret "cmpltpd";
    }
    if (pred == 2) {
        if (single) { ret "cmpleps"; }
        ret "cmplepd";
    }
    if (pred == 3) {
        if (single) { ret "cmpunordps"; }
        ret "cmpunordpd";
    }
    if (pred == 4) {
        if (single) { ret "cmpneqps"; }
        ret "cmpneqpd";
    }
    if (pred == 5) {
        if (single) { ret "cmpnltps"; }
        ret "cmpnltpd";
    }
    if (pred == 6) {
        if (single) { ret "cmpnleps"; }
        ret "cmpnlepd";
    }
    if (pred == 7) {
        if (single) { ret "cmpordps"; }
        ret "cmpordpd";
    }
    ret nil;
}

fun render_operand(buf: *codegen_encode.ByteBuf, mi: *isa.Inst, op: *isa.Operand, printed: u32) res[u32, fail.Fail] {
    if (op.kind == isa.OPK_NONE) { ret res[u32, fail.Fail].ok{printed}; }

    val out: *io_writer.Writer = buf.asm.out;
    var sep: str               = ", ";
    if (printed == 0) { sep = " "; }
    val res_sep: err[fail.Fail] = emit_str(out, sep);
    if (sel res_sep.err) { ret res[u32, fail.Fail].err{res_sep.err}; }

    val res_: err[fail.Fail] = render_operand_body(buf, mi, op);
    if (sel res_.err) { ret res[u32, fail.Fail].err{res_.err}; }
    ret res[u32, fail.Fail].ok{printed + 1};
}

fun render_operand_body(buf: *codegen_encode.ByteBuf, mi: *isa.Inst, op: *isa.Operand) err[fail.Fail] {
    val out: *io_writer.Writer = buf.asm.out;

    if (op.kind == isa.OPK_REG)                                   { ret emit_reg(out, op.reg, operand_width(mi, op)); }
    if (op.kind == isa.OPK_IMM && mi.opcode == x64.MOV_CR)        { ret emit_ctlreg(out, op.imm); }
    if (op.kind == isa.OPK_IMM && mi.opcode == x64.MOV_SEG)       { ret emit_segreg(out, op.imm); }
    if (op.kind == isa.OPK_IMM)                                   { ret emit_i64(out, op.imm); }
    if (op.kind == isa.OPK_MEM && direct_transfer_target(mi, op)) { ret emit_sym(out, buf.asm.interner, op); }
    if (op.kind == isa.OPK_MEM)                                   { ret render_mem(buf, mi, op); }
    if (op.kind == isa.OPK_SYM)                                   { ret emit_sym(out, buf.asm.interner, op); }
    if (op.kind == isa.OPK_LABEL)                                 { ret render_label(buf, op); }

    ret err[fail.Fail].err{fail.message("--emit-asm: instruction operand has no renderable kind")};
}

# a direct call or jump carries its symbol as a rip-relative memory operand
# that the encoder emits as rel32; the listing names the symbol, since the
# instruction transfers to it rather than loading through it
fun direct_transfer_target(mi: *isa.Inst, op: *isa.Operand) bool {
    if (mi.opcode != x64.CALL && mi.opcode != x64.JMP) { ret false; }
    if ((mi.flags & x64.FLAG_INDIRECT::u16) != 0)      { ret false; }
    ret op.base < 0 && op.base != x64.MEM_BASE_ABS;
}

fun render_mem(buf: *codegen_encode.ByteBuf, mi: *isa.Inst, op: *isa.Operand) err[fail.Fail] {
    val out: *io_writer.Writer = buf.asm.out;

    val res_size: err[fail.Fail] = emit_str(out, size_prefix(operand_width(mi, op)));
    if (sel res_size.err) { ret res_size; }
    if (op.seg != x64.SEG_NONE) {
        val row: *x64.SegmentRow = x64.segment_row(op.seg);
        if (row == nil) {
            ret err[fail.Fail].err{fail.message("--emit-asm: no x86-64 segment name for the memory operand's override")};
        }
        val res_seg: err[fail.Fail] = emit_str(out, row.name);
        if (sel res_seg.err) { ret res_seg; }
        val res_colon: err[fail.Fail] = emit_str(out, ":");
        if (sel res_colon.err) { ret res_colon; }
    }
    val res_open: err[fail.Fail] = emit_str(out, "[");
    if (sel res_open.err) { ret res_open; }

    if (op.base == x64.MEM_BASE_ABS) {
        val res_abs: err[fail.Fail] = emit_i64(out, op.disp::i64);
        if (sel res_abs.err) { ret res_abs; }
        ret emit_str(out, "]");
    }

    if (op.base < 0) {
        val res_rip: err[fail.Fail] = emit_str(out, "rip + ");
        if (sel res_rip.err) { ret res_rip; }
        val res_sym: err[fail.Fail] = emit_sym(out, buf.asm.interner, op);
        if (sel res_sym.err) { ret res_sym; }
        ret emit_str(out, "]");
    }

    val res_base: err[fail.Fail] = emit_reg(out, op.base, 8);
    if (sel res_base.err) { ret res_base; }

    if (op.index >= 0) {
        val res_plus: err[fail.Fail] = emit_str(out, " + ");
        if (sel res_plus.err) { ret res_plus; }
        val res_index: err[fail.Fail] = emit_reg(out, op.index, 8);
        if (sel res_index.err) { ret res_index; }
        if (op.scale > 1) {
            val res_star: err[fail.Fail] = emit_str(out, "*");
            if (sel res_star.err) { ret res_star; }
            val res_scale: err[fail.Fail] = emit_u64(out, op.scale::u64);
            if (sel res_scale.err) { ret res_scale; }
        }
    }

    if (op.disp != 0) {
        var sign: str = " + ";
        var mag:  i64 = op.disp::i64;
        if (op.disp < 0) {
            sign = " - ";
            mag  = 0 - op.disp::i64;
        }
        val res_sign: err[fail.Fail] = emit_str(out, sign);
        if (sel res_sign.err) { ret res_sign; }
        val res_disp: err[fail.Fail] = emit_i64(out, mag);
        if (sel res_disp.err) { ret res_disp; }
    }
    ret emit_str(out, "]");
}

# the definition of a numbered local label, at the current offset
pub fun note_local_label(buf: *codegen_encode.ByteBuf, number: u32) {
    if (!codegen_encode.sink_renders(buf)) { ret; }
    val out:   *io_writer.Writer = buf.asm.out;
    val res_n: err[fail.Fail]    = emit_u64(out, number::u64);
    if (sel res_n.err) {
        codegen_encode.sink_fail(buf, fail.describe(res_n.err));
        ret;
    }
    val res_c: err[fail.Fail] = emit_str(out, ":\n");
    if (sel res_c.err) { codegen_encode.sink_fail(buf, fail.describe(res_c.err)); }
}

fun render_label(buf: *codegen_encode.ByteBuf, op: *isa.Operand) err[fail.Fail] {
    val out: *io_writer.Writer = buf.asm.out;
    if (op.label != nil) { ret emit_str(out, op.label); }
    if (!isa.label_is_block(op)) {
        val n: u32 = isa.local_label_number(op);
        if (n == 0) { ret emit_str(out, "<internal>"); }
        val res_n: err[fail.Fail] = emit_u64(out, n::u64);
        if (sel res_n.err)                  { ret res_n; }
        if (isa.label_is_forward_local(op)) { ret emit_str(out, "f"); }
        ret emit_str(out, "b");
    }

    ret emit_block_label(buf, op.imm::u64);
}

# the width the encoder encodes an operand at, which is what the assembler has
# to read back: a general-purpose form encodes every operand at the
# instruction's size whatever width its operand was selected at, a variable
# shift count is cl, and an extension reads its source at the source's width
fun operand_width(mi: *isa.Inst, op: *isa.Operand) u8 {
    val form: x64.Form = x64.describe(mi.opcode).form;
    if (op.kind == isa.OPK_REG && is_shift_count(mi, form, op)) { ret 1; }
    if (op.kind == isa.OPK_REG && form == x64.FORM_CVT && isa.regid_class(op.reg) != isa.REG_CLASS_ID_XMM) {
        # rex.w selects a 64-bit integer side, and every other width is 32
        if (mi.size == 8) { ret 8; }
        ret 4;
    }
    if (op.kind == isa.OPK_MEM) {
        val scalar: u8 = scalar_float_width(mi.opcode);
        if (scalar != 0) { ret scalar; }
    }
    if (form == x64.FORM_MOVX && op == ?mi.src1 && op.size != 0) { ret op.size; }
    if (form == x64.FORM_MOVX && op == ?mi.dst) {
        # an extension never carries the 16-bit prefix, so a narrower
        # destination is written at 32 bits
        if (encoded_size(mi) == 8) { ret 8; }
        ret 4;
    }
    if (mi.size != 0 && gp_sized(form, op)) { ret encoded_size(mi); }
    if (op.size != 0)                       { ret op.size; }
    if (mi.size != 0)                       { ret mi.size; }
    ret 8;
}

# the element a scalar float instruction reads or writes in memory, 0 for
# any other opcode
fun scalar_float_width(opcode: u16) u8 {
    if (opcode == x64.MOVSS || opcode == x64.ADDSS || opcode == x64.SUBSS || opcode == x64.MULSS
        || opcode == x64.DIVSS || opcode == x64.UCOMISS || opcode == x64.CVTSS2SD || opcode == x64.CVTTSS2SI) {
        ret 4;
    }
    if (opcode == x64.MOVSD || opcode == x64.ADDSD || opcode == x64.SUBSD || opcode == x64.MULSD
        || opcode == x64.DIVSD || opcode == x64.UCOMISD || opcode == x64.CVTSD2SS || opcode == x64.CVTTSD2SI) {
        ret 8;
    }
    ret 0;
}

# the operand size the encoding carries: rex.w and the 16-bit prefix are
# flags over the instruction's size
fun encoded_size(mi: *isa.Inst) u8 {
    if ((mi.flags & x64.FLAG_REX_W::u16) != 0) { ret 8; }
    if ((mi.flags & x64.FLAG_16BIT::u16) != 0) { ret 2; }
    ret mi.size;
}

fun is_shift_count(mi: *isa.Inst, form: x64.Form, op: *isa.Operand) bool {
    if (form == x64.FORM_SHIFT)  { ret op == ?mi.src1; }
    if (form == x64.FORM_DSHIFT) { ret op == ?mi.src2; }
    ret false;
}

# the forms whose general-purpose operands all take the instruction's size
fun gp_sized(form: x64.Form, op: *isa.Operand) bool {
    if (op.kind == isa.OPK_REG && isa.regid_class(op.reg) == isa.REG_CLASS_ID_XMM) { ret false; }
    ret form == x64.FORM_MOV || form == x64.FORM_ALU || form == x64.FORM_TEST || form == x64.FORM_IMUL
        || form == x64.FORM_DIV || form == x64.FORM_MUL1 || form == x64.FORM_SHIFT || form == x64.FORM_DSHIFT
        || form == x64.FORM_GRP3 || form == x64.FORM_GRP5 || form == x64.FORM_XCHG || form == x64.FORM_XADD
        || form == x64.FORM_CMOV || form == x64.FORM_BITSCAN || form == x64.FORM_CARRY || form == x64.FORM_BSWAP;
}

fun emit_reg(out: *io_writer.Writer, id: i32, width: u8) err[fail.Fail] {
    if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM && width == 32) { ret emit_str(out, x64.ymm_reg_name(id)); }
    if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM || width == 16) {
        ret emit_str(out, x64.fp_reg_name(id));
    }
    ret emit_str(out, x64.reg_name(nil, id, width));
}

fun emit_ctlreg(out: *io_writer.Writer, num: i64) err[fail.Fail] {
    if (num == 0) { ret emit_str(out, "cr0"); }
    if (num == 2) { ret emit_str(out, "cr2"); }
    if (num == 3) { ret emit_str(out, "cr3"); }
    if (num == 4) { ret emit_str(out, "cr4"); }
    if (num == 8) { ret emit_str(out, "cr8"); }
    ret err[fail.Fail].err{fail.message("--emit-asm: no x86-64 control-register name for the emitted number")};
}

fun emit_segreg(out: *io_writer.Writer, num: i64) err[fail.Fail] {
    if (num == 0) { ret emit_str(out, "es"); }
    if (num == 1) { ret emit_str(out, "cs"); }
    if (num == 2) { ret emit_str(out, "ss"); }
    if (num == 3) { ret emit_str(out, "ds"); }
    if (num == 4) { ret emit_str(out, "fs"); }
    if (num == 5) { ret emit_str(out, "gs"); }
    ret err[fail.Fail].err{fail.message("--emit-asm: no x86-64 segment-register name for the emitted number")};
}

# GNU as reads a size keyword without `ptr` as that keyword's value, so
# `qword [rbx]` would assemble as `[rbx + 8]`
fun size_prefix(width: u8) str {
    if (width == 1)  { ret "byte ptr "; }
    if (width == 2)  { ret "word ptr "; }
    if (width == 4)  { ret "dword ptr "; }
    if (width == 8)  { ret "qword ptr "; }
    if (width == 16) { ret "xmmword ptr "; }
    if (width == 32) { ret "ymmword ptr "; }
    ret "";
}

# the spelling a diagnostic names an emitted instruction by
pub fun mnemonic(op: u16) opt[str] {
    val spelled: str = x64.describe(op).name;
    if (spelled == nil) { ret opt[str].none{}; }
    ret opt[str].some{spelled};
}

pub fun reg_name(id: i32, width: u8) str {
    if (isa.regid_class(id) == isa.REG_CLASS_ID_XMM || width == 16) { ret x64.fp_reg_name(id); }
    ret x64.reg_name(nil, id, width);
}

fun emit_str(out: *io_writer.Writer, s: str) err[fail.Fail] {
    val res_write: res[usize, io_writer.WriteError] = std_format.write_str(out, s);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_u64(out: *io_writer.Writer, n: u64) err[fail.Fail] {
    val res_write: res[usize, io_writer.WriteError] = std_format.write_u64(out, n);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_i64(out: *io_writer.Writer, n: i64) err[fail.Fail] {
    val res_write: res[usize, io_writer.WriteError] = std_format.write_i64(out, n);
    if (sel res_write.err) { ret err[fail.Fail].err{fail.write_refused(res_write.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_name(out: *io_writer.Writer, interner: *intern.Interner, id: intern.StrId) err[fail.Fail] {
    val opt_name: opt[str] = intern.lookup(interner, id);
    if (sel opt_name.none) {
        ret err[fail.Fail].err{fail.message("--emit-asm: a function name did not resolve in the interner")};
    }
    ret emit_str(out, opt_name.some);
}

fun emit_sym(out: *io_writer.Writer, interner: *intern.Interner, op: *isa.Operand) err[fail.Fail] {
    val opt_name: opt[str] = intern.lookup(interner, op.sym_id::intern.StrId);
    if (sel opt_name.none) {
        ret err[fail.Fail].err{fail.message("--emit-asm: a symbol reference did not resolve in the interner")};
    }
    val res_name: err[fail.Fail] = emit_str(out, opt_name.some);
    if (sel res_name.err) { ret res_name; }
    if (op.sym_mod == isa.SYM_MOD_GOT) {
        val res_got: err[fail.Fail] = emit_str(out, "@GOTPCREL");
        if (sel res_got.err) { ret res_got; }
    }
    if (op.sym_addend == 0) { ret err[fail.Fail].ok{}; }
    if (op.sym_addend < 0) {
        val res_neg: err[fail.Fail] = emit_str(out, "-");
        if (sel res_neg.err) { ret res_neg; }
        ret emit_i64(out, 0 - op.sym_addend);
    }
    val res_pos: err[fail.Fail] = emit_str(out, "+");
    if (sel res_pos.err) { ret res_pos; }
    ret emit_i64(out, op.sym_addend);
}

#[testing]
var test_sink_buf: [8192]u8;
#[testing]
var test_sink_len: usize = 0;

#[testing]
fun test_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    var i: usize = 0;
    for (i < len) {
        if (test_sink_len < 8191) {
            test_sink_buf[test_sink_len] = buf[i];
            test_sink_len                = test_sink_len + 1;
        }
        i = i + 1;
    }
    ret res[usize, io_writer.WriteError].ok{len};
}

#[testing]
fun rendered_is(buf: *codegen_encode.ByteBuf, mi: *isa.Inst, want: str) i32 {
    test_sink_len = 0;
    val res_: err[fail.Fail] = render_inst(buf, mi);
    if (sel res_.err) { ret 1; }
    test_sink_buf[test_sink_len] = 0;
    val got: str = (?test_sink_buf[0])::str;
    if (!str_starts_with(got, "  "))                     { ret 1; }
    if (!str_region_equals(got, 2, str_len(want), want)) { ret 1; }
    if (str_len(got) != str_len(want) + 3)               { ret 1; }
    ret 0;
}

# a writer into the test buffer, emptied, for an encoder-side round trip
#[testing]
pub fun test_sink_writer(w: *io_writer.Writer) {
    test_sink_len = 0;
    w.ctx         = nil;
    w.f_write     = test_sink_write;
}

#[testing]
pub fun test_sink_text() str {
    test_sink_buf[test_sink_len] = 0;
    ret (?test_sink_buf[0])::str;
}

#[testing]
fun test_sink_buf_init(buf: *codegen_encode.ByteBuf, alloc: *A.Allocator, w: *io_writer.Writer, sink: *codegen_encode.AsmSink) {
    page.make(alloc);
    @buf      = codegen_encode.buf_init(alloc);
    w.ctx     = nil;
    w.f_write = test_sink_write;
    @sink     = codegen_encode.sink_init(w, nil);
    buf.asm   = sink;
}

test render_inst__freestanding_surface_and_unmapped_sysregs {
    var alloc: A.Allocator;
    var buf:   codegen_encode.ByteBuf;
    var w:     io_writer.Writer;
    var sink:  codegen_encode.AsmSink;
    test_sink_buf_init(?buf, ?alloc, ?w, ?sink);

    var bad: i32 = 0;

    var i1: isa.Inst = isa.inst_blank();
    i1.opcode = x64.CLD;
    bad       = bad | rendered_is(?buf, ?i1, "cld");
    i1.opcode = x64.PUSHFQ;
    bad       = bad | rendered_is(?buf, ?i1, "pushfq");
    i1.opcode = x64.POPFQ;
    bad       = bad | rendered_is(?buf, ?i1, "popfq");
    i1.opcode = x64.SWAPGS;
    bad       = bad | rendered_is(?buf, ?i1, "swapgs");
    i1.opcode = x64.IRETQ;
    bad       = bad | rendered_is(?buf, ?i1, "iretq");

    var i2: isa.Inst = isa.inst_blank();
    i2.opcode = x64.JMP;
    i2.size   = 8;
    i2.flags  = x64.FLAG_INDIRECT::u16;
    i2.dst    = isa.make_reg(x64.RAX, 8);
    bad       = bad | rendered_is(?buf, ?i2, "jmp rax");

    var i3: isa.Inst = isa.inst_blank();
    i3.opcode = x64.MOV_CR;
    i3.size   = 8;
    i3.dst    = isa.make_reg(x64.RAX, 8);
    i3.src1   = isa.make_imm(2, 8);
    bad       = bad | rendered_is(?buf, ?i3, "mov rax, cr2");

    var i4: isa.Inst = isa.inst_blank();
    i4.opcode = x64.MOV_CR;
    i4.size   = 8;
    i4.dst    = isa.make_imm(3, 8);
    i4.src1   = isa.make_reg(x64.RAX, 8);
    bad       = bad | rendered_is(?buf, ?i4, "mov cr3, rax");

    var i5: isa.Inst = isa.inst_blank();
    i5.opcode     = x64.MOV_SEG;
    i5.size       = 4;
    i5.dst        = isa.make_reg(x64.RAX, 4);
    i5.src1       = isa.make_imm(1, 8);
    bad           = bad | rendered_is(?buf, ?i5, "mov eax, cs");
    i5.src1       = isa.make_imm(6, 8);
    test_sink_len = 0;
    val bad_seg: err[fail.Fail] = render_inst(?buf, ?i5);
    if (!sel bad_seg.err) { bad = 1; }
    i3.src1       = isa.make_imm(1, 8);
    test_sink_len = 0;
    val bad_cr: err[fail.Fail] = render_inst(?buf, ?i3);
    if (!sel bad_cr.err) { bad = 1; }

    var i6: isa.Inst = isa.inst_blank();
    i6.opcode = x64.MOVZX;
    i6.size   = 4;
    i6.dst    = isa.make_reg(x64.RAX, 4);
    i6.src1   = isa.make_mem(x64.RCX, 0, -1, 0, 2);
    bad       = bad | rendered_is(?buf, ?i6, "movzx eax, word ptr [rcx]");

    codegen_encode.buf_dnit(?buf);
    ret bad;
}

test render_inst__prefixes_are_part_of_the_instruction {
    var alloc: A.Allocator;
    var buf:   codegen_encode.ByteBuf;
    var w:     io_writer.Writer;
    var sink:  codegen_encode.AsmSink;
    test_sink_buf_init(?buf, ?alloc, ?w, ?sink);

    var bad: i32 = 0;

    var mov: isa.Inst = isa.inst_blank();
    mov.opcode = x64.MOVSB;
    mov.size   = 1;
    bad        = bad | rendered_is(?buf, ?mov, "movsb");
    mov.flags  = x64.FLAG_REP::u16;
    bad        = bad | rendered_is(?buf, ?mov, "rep movsb");

    var cmp: isa.Inst = isa.inst_blank();
    cmp.opcode = x64.SCASQ;
    cmp.flags  = x64.FLAG_REP::u16;
    bad        = bad | rendered_is(?buf, ?cmp, "repe scasq");
    cmp.flags  = x64.FLAG_REPNE::u16;
    bad        = bad | rendered_is(?buf, ?cmp, "repne scasq");

    var add: isa.Inst = isa.inst_blank();
    add.opcode = x64.ADD;
    add.size   = 8;
    add.dst    = isa.make_mem(x64.RCX, 0, -1, 0, 8);
    add.src1   = isa.make_reg(x64.RAX, 8);
    bad        = bad | rendered_is(?buf, ?add, "add qword ptr [rcx], rax");
    add.flags  = x64.FLAG_LOCK::u16;
    bad        = bad | rendered_is(?buf, ?add, "lock add qword ptr [rcx], rax");

    codegen_encode.buf_dnit(?buf);
    ret bad;
}

test render_inst__segment_override_leads_the_address {
    var alloc: A.Allocator;
    var buf:   codegen_encode.ByteBuf;
    var w:     io_writer.Writer;
    var sink:  codegen_encode.AsmSink;
    test_sink_buf_init(?buf, ?alloc, ?w, ?sink);

    var bad: i32 = 0;

    var rd: isa.Inst = isa.inst_blank();
    rd.opcode     = x64.MOV;
    rd.size       = 8;
    rd.dst        = isa.make_reg(x64.RAX, 8);
    rd.src1       = isa.make_mem(x64.MEM_BASE_ABS, 40, -1, 0, 8);
    rd.src1.seg   = x64.SEG_FS;
    bad           = bad | rendered_is(?buf, ?rd, "mov rax, qword ptr fs:[40]");
    rd.src1       = isa.make_mem(x64.RBX, -8, -1, 0, 4);
    rd.src1.seg   = x64.SEG_GS;
    bad           = bad | rendered_is(?buf, ?rd, "mov rax, qword ptr gs:[rbx - 8]");
    rd.src1.seg   = 7;
    test_sink_len = 0;
    val unmapped: err[fail.Fail] = render_inst(?buf, ?rd);
    if (!sel unmapped.err) { bad = 1; }

    var base: isa.Inst = isa.inst_blank();
    base.opcode = x64.WRGSBASE;
    base.size   = 4;
    base.dst    = isa.make_reg(x64.R9, 4);
    bad         = bad | rendered_is(?buf, ?base, "wrgsbase r9d");
    base.opcode = x64.RDFSBASE;
    base.size   = 8;
    base.dst    = isa.make_reg(x64.RAX, 8);
    bad         = bad | rendered_is(?buf, ?base, "rdfsbase rax");

    codegen_encode.buf_dnit(?buf);
    ret bad;
}

test render_inst__a_symbol_addend_is_part_of_the_address {
    var alloc: A.Allocator;
    var buf:   codegen_encode.ByteBuf;
    var w:     io_writer.Writer;
    var sink:  codegen_encode.AsmSink;
    test_sink_buf_init(?buf, ?alloc, ?w, ?sink);

    var itn: intern.Interner            = intern.init(?alloc);
    val gr:  res[intern.StrId, A.Error] = intern.intern(?itn, "g");
    if (sel gr.err) {
        codegen_encode.buf_dnit(?buf);
        ret 1;
    }
    val g: intern.StrId = gr.ok;
    sink.interner = ?itn;
    buf.asm       = ?sink;

    var bad: i32 = 0;

    var lo: isa.Inst = isa.inst_blank();
    lo.opcode      = x64.LEA;
    lo.size        = 8;
    lo.dst         = isa.make_reg(x64.RAX, 8);
    lo.src1        = isa.make_mem(-1, 0, -1, 0, 8);
    lo.src1.sym_id = g::u32;
    bad            = bad | rendered_is(?buf, ?lo, "lea rax, qword ptr [rip + g]");

    var hi: isa.Inst = lo;
    hi.src1.sym_addend = 8;
    bad                = bad | rendered_is(?buf, ?hi, "lea rax, qword ptr [rip + g+8]");

    var neg: isa.Inst = lo;
    neg.src1.sym_addend = 0 - 8;
    bad                 = bad | rendered_is(?buf, ?neg, "lea rax, qword ptr [rip + g-8]");

    var call_lo: isa.Inst = isa.inst_blank();
    call_lo.opcode = x64.CALL;
    call_lo.size   = 8;
    call_lo.src1   = isa.make_sym(g::u32, 8);
    bad            = bad | rendered_is(?buf, ?call_lo, "call g");

    var call_hi: isa.Inst = call_lo;
    call_hi.src1.sym_addend = 8;
    bad                     = bad | rendered_is(?buf, ?call_hi, "call g+8");

    intern.dnit(?itn);
    codegen_encode.buf_dnit(?buf);
    ret bad;
}
