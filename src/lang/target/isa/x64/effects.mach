# what each x64 instruction reads, writes and leaks, for the constant-time checks
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mach.lang.ct;
use isa_asm:    mach.lang.target.isa.asm;
use isa_effect: mach.lang.target.isa.effect;
use isa_inst:   mach.lang.target.isa.inst;
use mach.lang.target.isa.x64;
use x64_emit:     mach.lang.target.isa.x64.emit;
use x64_inst:     mach.lang.target.isa.x64.inst;
use x64_mnemonic: mach.lang.target.isa.x64.mnemonic;
use x64_printer:  mach.lang.target.isa.x64.printer;

# the emitted instruction's effects: the registers each row reads, writes and
# addresses through, and a repeat prefix reading rcx and taking the class
# whose timing is its data; a compare writes the flags
test inst_effects__string_rows {
    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.STOSQ;
    inst_effects(?mi, ?e);
    if (!e.cls.known || e.cls.op != ct.CT_OP_NONE || e.cls.writes_flags)         { ret 1; }
    if (e.implicit_reads != (BIT_RAX | BIT_RDI) || e.implicit_writes != BIT_RDI) { ret 2; }
    if (e.implicit_addr != BIT_RDI || e.implicit_mem)                            { ret 3; }

    mi.flags = x64_inst.FLAG_REP::u16;
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_REP_STRING)                                                               { ret 4; }
    if (e.implicit_reads != (BIT_RAX | BIT_RDI | BIT_RCX) || e.implicit_writes != (BIT_RDI | BIT_RCX)) { ret 5; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.CMPSB;
    mi.flags  = x64_inst.FLAG_REPNE::u16;
    inst_effects(?mi, ?e);
    if (e.cls.op != ct.CT_OP_REP_STRING || !e.cls.writes_flags)    { ret 6; }
    if (e.implicit_addr != (BIT_RSI | BIT_RDI) || !e.implicit_mem) { ret 7; }
    ret 0;
}

# the effect rows: sha256rnds2 reads xmm0 unnamed, cpuid reads eax and ecx and
# writes all four, pextrd defines its general register, ptest defines the flags
test inst_effects__extension_rows {
    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.SHA256RNDS2;
    mi.dst    = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 1), 16);
    mi.src1   = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 2), 16);
    inst_effects(?mi, ?e);
    if (!e.cls.known || e.implicit_fp_reads != 1 || e.roles[0] != isa_effect.ROLE_RW || e.roles[1] != isa_effect.ROLE_READ) { ret 1; }
    if (e.cls.writes_flags || e.cls.op != ct.CT_OP_NONE)                                                                    { ret 2; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.CPUID;
    inst_effects(?mi, ?e);
    if (e.implicit_reads != (BIT_RAX | BIT_RCX) || e.implicit_writes != 0xF || e.implicit_fp_reads != 0) { ret 3; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.PEXTRD;
    mi.dst    = isa_inst.make_reg(x64.RAX, 4);
    mi.src1   = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 1), 16);
    mi.src2   = isa_inst.make_imm(1, 1);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ) { ret 4; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.PTEST;
    mi.dst    = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0), 16);
    mi.src1   = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 1), 16);
    inst_effects(?mi, ?e);
    if (!e.cls.defines_flags || e.roles[0] != isa_effect.ROLE_READ || e.roles[1] != isa_effect.ROLE_READ) { ret 5; }

    # the aes rounds and pclmulqdq fold their source into the destination;
    # aesimc and aeskeygenassist define it from the source alone. every one is
    # a fixed-latency row that leaves the flags alone
    var k: usize = 0;
    for (k < T_AES_ROW_COUNT) {
        mi        = isa_inst.inst_blank();
        mi.opcode = T_AES_ROWS[k];
        mi.dst    = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 1), 16);
        mi.src1   = x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 2), 16);
        if (mi.opcode == x64.AESKEYGENASSIST || mi.opcode == x64.PCLMULQDQ) { mi.src2 = isa_inst.make_imm(1, 1); }
        inst_effects(?mi, ?e);
        var dst: isa_effect.OperandRole = isa_effect.ROLE_RW;
        if (mi.opcode == x64.AESIMC || mi.opcode == x64.AESKEYGENASSIST)                    { dst = isa_effect.ROLE_WRITE; }
        if (!e.cls.known || !e.cls.flags_stated || e.cls.writes_flags || e.cls.reads_flags) { ret 10 + k::i32; }
        if (e.cls.op != ct.CT_OP_NONE || e.implicit_fp_reads != 0)                          { ret 20 + k::i32; }
        if (e.roles[0] != dst || e.roles[1] != isa_effect.ROLE_READ)                        { ret 30 + k::i32; }
        k = k + 1;
    }
    ret 0;
}

#[testing]
val T_AES_ROW_COUNT: usize = 7;

#[testing]
val T_AES_ROWS: [T_AES_ROW_COUNT]u16 = [T_AES_ROW_COUNT]u16{
    x64.AESENC, x64.AESENCLAST, x64.AESDEC, x64.AESDECLAST, x64.AESIMC, x64.AESKEYGENASSIST, x64.PCLMULQDQ,
};

# mul is its own form, never a divide, and its class is the full unsigned
# product whatever its operand count; the walk sees rax read and rdx:rax written
test describe__mul_is_the_unsigned_widening_product {
    val d: x64_inst.OpDesc = x64_inst.describe(x64.MUL);
    if (d.form != x64_inst.FORM_MUL1 || d.shape != x64_inst.SHAPE_USE || d.arity != 1) { ret 1; }
    if (d.cls.op != ct.CT_OP_INT_MUL)                                                  { ret 2; }
    if (d.cls.mul != ct.CT_MUL_WIDE_U || d.cls.mul_one != ct.CT_MUL_WIDE_U)            { ret 3; }
    if (!d.cls.writes_flags || d.cls.defines_flags)                                    { ret 4; }
    if (x64_inst.describe(x64.IMUL).cls.mul_one != ct.CT_MUL_WIDE_S)                   { ret 5; }

    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.MUL;
    mi.src1   = isa_inst.make_reg(x64.RCX, 8);
    mi.size   = 8;
    inst_effects(?mi, ?e);
    if (e.roles[1] != isa_effect.ROLE_READ)       { ret 6; }
    if (e.implicit_reads != BIT_RAX)              { ret 7; }
    if (e.implicit_writes != (BIT_RAX | BIT_RDX)) { ret 8; }
    val spelled: opt[str] = x64_printer.mnemonic(x64.MUL);
    if (!sel spelled.some) { ret 9; }
    ret 0;
}

# the flags and latency row of an opcode, as the inline-asm scan and the
# effect walk read it: the class column of the one description table
pub fun asm_ct_class(code: u32, flags: u16) ct.AsmClass {
    if (code > 0xFFFF) { ret ct.asm_unknown(); }
    ret rep_class(x64_inst.describe(code::u16), (flags & (x64_mnemonic.FLAG_REP | x64_mnemonic.FLAG_REPNE)) != 0);
}

# a repeated string instruction's timing is its count, and a compare's also
# the elements it stops at
fun rep_class(d: x64_inst.OpDesc, repeated: bool) ct.AsmClass {
    var cls: ct.AsmClass = d.cls;
    if (repeated && d.form == x64_inst.FORM_STRING) { cls.op = ct.CT_OP_REP_STRING; }
    ret cls;
}

# the grammar row of a string opcode, spelled without a prefix
fun string_mnemonic(code: u32) *isa_asm.Mnemonic {
    var i: usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        if (x64_mnemonic.MNEMONICS[i].code == code && x64_mnemonic.pattern(x64_mnemonic.MNEMONICS[i].flags) == x64_mnemonic.PATTERN_STRING) { ret ?x64_mnemonic.MNEMONICS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the machine opcodes a notification can carry: every x64.Opcode except the
# two pseudo entries, the inline-asm block marker and the data byte, which
# reach the stream as a MIR pseudo and an ASM_NOTE_BYTES note respectively
fun notifiable_opcode(op: u16) bool {
    if (op::u32 >= x64_inst.OPCODE_COUNT) { ret false; }
    ret op != x64.ASM_BLOCK && op != x64.RAW_BYTE;
}

# operands in Intel order, skipping the empty positions the encoder leaves
# (a divide keeps its divisor in src1 with no dst)
fun present(mi: *isa_inst.Inst, out: *u32) u32 {
    var n: u32 = 0;
    if (mi.dst.kind != isa_inst.OPK_NONE) {
        out[n] = 0;
        n      = n + 1;
    }
    if (mi.src1.kind != isa_inst.OPK_NONE) {
        out[n] = 1;
        n      = n + 1;
    }
    if (mi.src2.kind != isa_inst.OPK_NONE) {
        out[n] = 2;
        n      = n + 1;
    }
    if (mi.src3.kind != isa_inst.OPK_NONE) {
        out[n] = 3;
        n      = n + 1;
    }
    ret n;
}

fun slot(mi: *isa_inst.Inst, pos: u32) *isa_inst.Operand {
    if (pos == 0) { ret ?mi.dst; }
    if (pos == 1) { ret ?mi.src1; }
    if (pos == 2) { ret ?mi.src2; }
    ret ?mi.src3;
}

fun grammar_reads_fp(code: u32) u32 {
    var i: usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        if (x64_mnemonic.MNEMONICS[i].code == code) { ret x64_mnemonic.MNEMONICS[i].reads_fp; }
        i = i + 1;
    }
    ret 0;
}

fun grammar_implicit(code: u32) u32 {
    var i: usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        if (x64_mnemonic.MNEMONICS[i].code == code) { ret x64_mnemonic.MNEMONICS[i].implicit; }
        i = i + 1;
    }
    ret 0;
}

# the roles a shape gives the first two present operands the form takes; a
# third position is an immediate on every form that has one
fun shape_roles(e: *isa_effect.InstEffects, d: *x64_inst.OpDesc, shape: x64_inst.Shape, n: u32, pos: *u32) {
    if (n == 0 || d.arity == 0 || shape == x64_inst.SHAPE_NONE || shape == x64_inst.SHAPE_XFER) { ret; }
    var first:  isa_effect.OperandRole = isa_effect.ROLE_READ;
    var second: isa_effect.OperandRole = isa_effect.ROLE_READ;
    if (shape == x64_inst.SHAPE_DEF) { first = isa_effect.ROLE_WRITE; }
    if (shape == x64_inst.SHAPE_RW)  { first = isa_effect.ROLE_RW; }
    if (shape == x64_inst.SHAPE_SWAP) {
        first  = isa_effect.ROLE_RW;
        second = isa_effect.ROLE_RW;
    }
    e.roles[pos[0]] = first;
    if (n >= 2 && d.arity >= 2) { e.roles[pos[1]] = second; }
}

val BIT_RAX: u64 = 0x1;

val BIT_RCX: u64 = 0x2;

val BIT_RDX: u64 = 0x4;

val BIT_RSP: u64 = 0x10;

val BIT_RSI: u64 = 0x40;

val BIT_RDI: u64 = 0x80;

# the effect description of one emitted x86-64 instruction: the opcode's
# row (form, shape, memory, class) projected onto the operands present, in
# intel order, plus the implicit effects the form carries. every opcode
# notifiable_opcode admits has a row; the two pseudo entries and anything
# outside the catalog describe as unknown
pub fun inst_effects(mi: *isa_inst.Inst, e: *isa_effect.InstEffects) {
    @e = isa_effect.inst_effects_unknown();
    val op: u16 = mi.opcode;
    if (!notifiable_opcode(op)) { ret; }
    val d:        x64_inst.OpDesc = x64_inst.describe(op);
    val repeated: bool            = (mi.flags & (x64_inst.FLAG_REP::u16 | x64_inst.FLAG_REPNE::u16)) != 0;
    e.cls = rep_class(d, repeated);

    var pos: [4]u32;
    val n:   u32 = present(mi, ?pos[0]);
    e.implicit_reads    = grammar_implicit(op::u32)::u64;
    e.implicit_writes   = e.implicit_reads;
    e.implicit_fp_reads = grammar_reads_fp(op::u32)::u64;
    e.implicit_mem      = (d.mem & x64_inst.MEM_STACK) != 0;
    if ((d.mem & x64_inst.MEM_BASE) != 0 && n >= 1) {
        val base: *isa_inst.Operand = slot(mi, pos[0]);
        if (base.kind == isa_inst.OPK_REG) { e.implicit_addr = e.implicit_addr | (1::u64 << isa_inst.regid_index(base.reg)::u64); }
    }

    var shape: x64_inst.Shape = d.shape;
    # the three-operand imul writes a register the sources do not name
    if (d.form == x64_inst.FORM_IMUL && n == 3) { shape = x64_inst.SHAPE_DEF; }
    # the vex form of a legacy opcode writes its destination whole and reads
    # every source after it, the one the legacy form read in place among them
    val vex: bool = (mi.flags & x64_inst.FLAG_VEX::u16) != 0;
    if (vex && shape == x64_inst.SHAPE_RW) { shape = x64_inst.SHAPE_DEF; }
    shape_roles(e, ?d, shape, n, ?pos[0]);
    if (vex) {
        var k: u32 = 1;
        for (k < n) {
            if (slot(mi, pos[k]).kind != isa_inst.OPK_IMM) { e.roles[pos[k]] = isa_effect.ROLE_READ; }
            k = k + 1;
        }
    }
    if ((d.mem & x64_inst.MEM_ADDR) != 0 && n >= 2) { e.roles[pos[1]] = isa_effect.ROLE_ADDR; }

    if (d.form == x64_inst.FORM_SSE_MOV && n >= 2) {
        # a register source merges into the upper lanes; a memory source zeroes them
        if (slot(mi, pos[1]).kind == isa_inst.OPK_REG && slot(mi, pos[0]).kind == isa_inst.OPK_REG) {
            e.roles[pos[0]] = isa_effect.ROLE_RW;
        }
    }
    if (d.form == x64_inst.FORM_SHIFT) {
        if (n >= 2) { e.count_pos = pos[1]::i8; }
        or {
            e.implicit_reads = e.implicit_reads | BIT_RCX;
            e.count_pos      = -1;
        }
    }
    # a vex three-operand row reads its second source as well
    if (d.form == x64_inst.FORM_VEX3 && n >= 3) { e.roles[pos[2]] = isa_effect.ROLE_READ; }
    # a double shift's third position is its count: cl is read, an immediate is not
    if (d.form == x64_inst.FORM_DSHIFT && n == 3) {
        if (slot(mi, pos[2]).kind == isa_inst.OPK_REG) { e.roles[pos[2]] = isa_effect.ROLE_READ; }
        e.count_pos = pos[2]::i8;
    }
    if ((op == x64.XOR || op == x64.SUB || op == x64.PXOR || op == x64.XORPS) && n == 2) {
        val a: *isa_inst.Operand = slot(mi, pos[0]);
        val b: *isa_inst.Operand = slot(mi, pos[1]);
        if (a.kind == isa_inst.OPK_REG && b.kind == isa_inst.OPK_REG && a.reg == b.reg) { e.zero_idiom = true; }
    }
    # the vex form clears its destination when its two sources are one register
    if (vex && (op == x64.PXOR || op == x64.XORPS) && n == 3) {
        val a: *isa_inst.Operand = slot(mi, pos[1]);
        val b: *isa_inst.Operand = slot(mi, pos[2]);
        if (a.kind == isa_inst.OPK_REG && b.kind == isa_inst.OPK_REG && a.reg == b.reg) { e.zero_idiom = true; }
    }
    if ((d.form == x64_inst.FORM_IMUL && n == 1) || d.form == x64_inst.FORM_MUL1) {
        e.implicit_reads  = BIT_RAX;
        e.implicit_writes = BIT_RAX | BIT_RDX;
    }
    if (op == x64.CMPXCHG) {
        e.implicit_reads  = BIT_RAX;
        e.implicit_writes = BIT_RAX;
    }
    if (d.form == x64_inst.FORM_DIV) {
        e.implicit_reads  = BIT_RAX | BIT_RDX;
        e.implicit_writes = BIT_RAX | BIT_RDX;
    }
    if (op == x64.CDQ || op == x64.CQO || op == x64.CWD) {
        e.implicit_reads  = BIT_RAX;
        e.implicit_writes = BIT_RDX;
    }
    if (op == x64.CBW) {
        e.implicit_reads  = BIT_RAX;
        e.implicit_writes = BIT_RAX;
    }
    if (op == x64.CPUID) { e.implicit_reads = BIT_RAX | BIT_RCX; }
    if (d.form == x64_inst.FORM_STRING) {
        val row: *isa_asm.Mnemonic = string_mnemonic(op::u32);
        if (row != nil) {
            e.implicit_reads  = row.reads_gp::u64;
            e.implicit_writes = row.implicit::u64;
            e.implicit_addr   = row.addr_gp::u64;
            e.implicit_mem    = row.loads_gp != 0;
        }
        if (repeated) {
            e.implicit_reads  = e.implicit_reads | BIT_RCX;
            e.implicit_writes = e.implicit_writes | BIT_RCX;
        }
    }
    if (d.form == x64_inst.FORM_PUSH || d.form == x64_inst.FORM_POP || op == x64.PUSHFQ || op == x64.POPFQ) {
        e.implicit_reads  = BIT_RSP;
        e.implicit_writes = BIT_RSP;
    }

    if (d.form == x64_inst.FORM_JMP) {
        e.xfer = isa_effect.XFER_JUMP;
        transfer_target(mi, n, ?pos[0], e);
    }
    if (d.form == x64_inst.FORM_CALL) {
        e.xfer = isa_effect.XFER_CALL;
        transfer_target(mi, n, ?pos[0], e);
    }
    if (d.form == x64_inst.FORM_JCC) {
        e.xfer = isa_effect.XFER_BRANCH;
        transfer_target(mi, n, ?pos[0], e);
    }
    if (d.form == x64_inst.FORM_RET)  { e.xfer = isa_effect.XFER_RET; }
    if (d.form == x64_inst.FORM_TRAP) { e.xfer = isa_effect.XFER_TRAP; }
}

fun transfer_target(mi: *isa_inst.Inst, n: u32, pos: *u32, e: *isa_effect.InstEffects) {
    if (n == 0) { ret; }
    val t: *isa_inst.Operand = slot(mi, pos[0]);
    if (t.kind == isa_inst.OPK_LABEL) {
        if (isa_inst.label_is_block(t)) {
            e.target       = isa_effect.TARGET_BLOCK;
            e.target_block = t.imm::u32;
            ret;
        }
        e.target = isa_effect.TARGET_LOCAL;
        if (isa_inst.label_is_forward_local(t)) {
            e.target     = isa_effect.TARGET_LOCAL_FWD;
            e.local_disp = t.disp;
        }
        ret;
    }
    if (t.kind == isa_inst.OPK_SYM) {
        e.target = isa_effect.TARGET_EXTERNAL;
        ret;
    }
    e.roles[pos[0]] = isa_effect.ROLE_READ;
    if (t.kind == isa_inst.OPK_MEM) { e.roles[pos[0]] = isa_effect.ROLE_ADDR; }
    e.target = isa_effect.TARGET_REGISTER;
}

test asm_ct_class__every_grammar_row_is_classified_and_states_flags {
    var bad: i32   = 0;
    var i:   usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        val cls: ct.AsmClass = asm_ct_class(x64_mnemonic.MNEMONICS[i].code, x64_mnemonic.MNEMONICS[i].flags);
        if (!cls.known)                             { bad = 1; }
        if (!cls.flags_stated)                      { bad = 1; }
        if (cls.defines_flags && !cls.writes_flags) { bad = 1; }
        i = i + 1;
    }
    ret bad;
}

test asm_ct_class__flag_reader_set_is_exactly_fifteen {
    var readers: [15]str;
    readers[0]  = "je";
    readers[1]  = "jz";
    readers[2]  = "jne";
    readers[3]  = "jnz";
    readers[4]  = "jc";
    readers[5]  = "jb";
    readers[6]  = "jnc";
    readers[7]  = "jae";
    readers[8]  = "jnb";
    readers[9]  = "setc";
    readers[10] = "setb";
    readers[11] = "setnc";
    readers[12] = "setae";
    readers[13] = "setnb";
    readers[14] = "pushfq";

    var bad:   i32   = 0;
    var found: u32   = 0;
    var i:     usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        val nm:        str         = x64_mnemonic.MNEMONICS[i].name;
        val cls:       ct.AsmClass = asm_ct_class(x64_mnemonic.MNEMONICS[i].code, x64_mnemonic.MNEMONICS[i].flags);
        val is_reader: bool        = cls.cond_flags || cls.reads_flags;

        var listed: bool  = false;
        var j:      usize = 0;
        for (j < 15) {
            if (str_equals(nm, readers[j])) { listed = true; }
            j = j + 1;
        }
        if (is_reader && !listed) { bad = 1; }
        if (!is_reader && listed) { bad = 1; }
        if (listed)               { found = found + 1; }
        i = i + 1;
    }
    if (found != 15) { bad = 1; }
    ret bad;
}

#[testing]
pub val PROBED_ROW_COUNT: usize = 30;

#[testing]
pub rec ProbedRow {
    code:   u32;
    zf_def: bool;
    cf_def: bool;
    reads:  bool;
}

#[testing]
fun probed(code: u32, zf: bool, cf: bool, reads: bool) ProbedRow {
    var r: ProbedRow;
    r.code   = code;
    r.zf_def = zf;
    r.cf_def = cf;
    r.reads  = reads;
    ret r;
}

#[testing]
pub fun probed_rows(out: *ProbedRow) u32 {
    out[0]  = probed(x64.ADD::u32, true, true, false);
    out[1]  = probed(x64.SUB::u32, true, true, false);
    out[2]  = probed(x64.CMP::u32, true, true, false);
    out[3]  = probed(x64.TEST::u32, true, true, false);
    out[4]  = probed(x64.AND::u32, true, true, false);
    out[5]  = probed(x64.OR::u32, true, true, false);
    out[6]  = probed(x64.XOR::u32, true, true, false);
    out[7]  = probed(x64.NEG::u32, true, true, false);
    out[8]  = probed(x64.NEG::u32, true, true, false);
    out[9]  = probed(x64.XADD::u32, true, true, false);
    out[10] = probed(x64.CMPXCHG::u32, true, true, false);
    out[11] = probed(x64.CMPXCHG::u32, true, true, false);
    out[12] = probed(x64.INC::u32, true, false, false);
    out[13] = probed(x64.DEC::u32, true, false, false);
    out[14] = probed(x64.SHL::u32, true, true, false);
    out[15] = probed(x64.SHL::u32, false, false, false);
    out[16] = probed(x64.SHR::u32, false, false, false);
    out[17] = probed(x64.SAR::u32, false, false, false);
    out[18] = probed(x64.NOT::u32, false, false, false);
    out[19] = probed(x64.MOV::u32, false, false, false);
    out[20] = probed(x64.LEA::u32, false, false, false);
    out[21] = probed(x64.XCHG::u32, false, false, false);
    out[22] = probed(x64.SETB::u32, false, false, true);
    out[23] = probed(x64.SETAE::u32, false, false, true);
    out[24] = probed(x64.JB::u32, false, false, false);
    out[25] = probed(x64.PUSHFQ::u32, false, false, true);
    out[26] = probed(x64.PTEST::u32, true, true, false);
    out[27] = probed(x64.POPCNT::u32, true, true, false);
    out[28] = probed(x64.LZCNT::u32, true, true, false);
    out[29] = probed(x64.TZCNT::u32, true, true, false);
    ret PROBED_ROW_COUNT::u32;
}

# every probed row agrees with its class, and every grammar row that defines
# or reads the flags is a probed row, or one of the three opaque rows
test asm_ct_class__matches_the_measured_rows {
    var rows: [PROBED_ROW_COUNT]ProbedRow;
    val n:    u32 = probed_rows(?rows[0]);

    var bad: i32 = 0;
    var k:   u32 = 0;
    for (k < n) {
        val r:   *ProbedRow  = ?rows[k];
        val cls: ct.AsmClass = asm_ct_class(r.code, 0);
        if (!(r.zf_def && r.cf_def) && cls.defines_flags) { bad = 1; }
        if ((r.zf_def || r.cf_def) && !cls.writes_flags)  { bad = 1; }
        if (r.reads && !cls.reads_flags)                  { bad = 1; }
        k = k + 1;
    }

    var covered: u32   = 0;
    var exempt:  u32   = 0;
    var i:       usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        val code: u32         = x64_mnemonic.MNEMONICS[i].code;
        val cls:  ct.AsmClass = asm_ct_class(code, x64_mnemonic.MNEMONICS[i].flags);

        if (cls.defines_flags || cls.opaque_flags || cls.reads_flags) {
            if (cls.opaque_flags) {
                if (code != x64.POPFQ::u32 && code != x64.IRETQ::u32
                    && code != x64.SYSCALL::u32) { bad = 1; }
                exempt = exempt + 1;
            }
            or {
                var found: bool = false;
                var j:     u32  = 0;
                for (j < n) {
                    if (rows[j].code == code) { found = true; }
                    j = j + 1;
                }
                if (!found) { bad = 1; }
                covered = covered + 1;
            }
        }
        i = i + 1;
    }

    if (covered != 22) { bad = 1; }
    if (exempt != 3)   { bad = 1; }
    ret bad;
}

test asm_ct_class__variable_latency_surface {
    var bad: i32 = 0;

    if (asm_ct_class(x64.SHL::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SHR::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SAR::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (!ct.ct_op_gates_count_only(ct.CT_OP_VAR_SHIFT))         { bad = 1; }

    if (asm_ct_class(x64.SHLD::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }
    if (asm_ct_class(x64.SHRD::u32, 0).op != ct.CT_OP_VAR_SHIFT) { bad = 1; }

    # past the shifts, the rows that vary in latency are the six packed
    # multiplies (pmulld gated on sse41, vpmullq on avx512dq and avx512vl),
    # the float ops, and the one scalar multiply, imul, whose forms the mul
    # mask gates
    var mul:   u32   = 0;
    var float: u32   = 0;
    var i:     usize = 0;
    for (i < x64_mnemonic.MNEMONIC_COUNT) {
        val row: *isa_asm.Mnemonic = ?x64_mnemonic.MNEMONICS[i];
        val cls: ct.AsmClass       = asm_ct_class(row.code, row.flags);
        val vec: bool              = x64_mnemonic.pattern(row.flags) == x64_mnemonic.PATTERN_VEC || x64_mnemonic.pattern(row.flags) == x64_mnemonic.PATTERN_VECI || x64_mnemonic.pattern(row.flags) == x64_mnemonic.PATTERN_VEC3;
        if (cls.op == ct.CT_OP_INT_DIVMOD)                           { bad = 1; }
        if (cls.op == ct.CT_OP_INT_MUL && vec)                       { mul = mul + 1; }
        or (cls.op == ct.CT_OP_INT_MUL && row.code != x64.IMUL::u32) { bad = 1; }
        if (cls.op == ct.CT_OP_FLOAT && vec)                         { float = float + 1; }
        or (cls.op == ct.CT_OP_FLOAT)                                { bad = 1; }
        i = i + 1;
    }
    if (mul != 6)    { bad = 1; }
    if (float != 16) { bad = 1; }

    if (!asm_ct_class(x64.JE::u32, 0).cond_flags)  { bad = 1; }
    if (!asm_ct_class(x64.JNE::u32, 0).cond_flags) { bad = 1; }
    if (!asm_ct_class(x64.JB::u32, 0).cond_flags)  { bad = 1; }
    if (!asm_ct_class(x64.JAE::u32, 0).cond_flags) { bad = 1; }
    if (asm_ct_class(x64.JMP::u32, 0).cond_flags)  { bad = 1; }
    if (asm_ct_class(x64.JE::u32, 0).cond_reg)     { bad = 1; }

    ret bad;
}

# the census over the opcode space: every notifiable opcode has a complete
# row (a form, a shape, a memory effect and a stated flags class) and a
# mnemonic, and the row's columns agree with each other. an opcode added
# without a row fails here before it can reach a stream
test asm_ct_class__every_notifiable_opcode_has_a_row {
    var missing: u32 = 0;
    var op:      u32 = 0;
    for (op < x64_inst.OPCODE_COUNT) {
        if (notifiable_opcode(op::u16)) {
            val d:   x64_inst.OpDesc = x64_inst.describe(op::u16);
            val cls: ct.AsmClass     = asm_ct_class(op, 0);
            if (!cls.known || !cls.flags_stated)                                    { missing = missing + 1; }
            if (d.form == x64_inst.FORM_NONE || d.form::u32 >= x64_inst.FORM_COUNT) { missing = missing + 1; }
            if (d.shape::u32 >= x64_inst.SHAPE_COUNT)                               { missing = missing + 1; }
            if (d.mem > x64_inst.MEM_ALL)                                           { missing = missing + 1; }
            val spelled: opt[str] = x64_printer.mnemonic(op::u16);
            if (sel spelled.none)       { missing = missing + 1; }
            if (!ut_row_consistent(?d)) { missing = missing + 1; }
        }
        op = op + 1;
    }
    if (notifiable_opcode(x64.ASM_BLOCK) || notifiable_opcode(x64.RAW_BYTE)) { ret 2; }
    if (notifiable_opcode(x64_inst.OPCODE_COUNT::u16))                       { ret 3; }
    val past: opt[str] = x64_printer.mnemonic(x64_inst.OPCODE_COUNT::u16);
    if (sel past.some)                                                                                           { ret 4; }
    if (x64_inst.describe(x64.ASM_BLOCK).form != x64_inst.FORM_NONE)                                             { ret 5; }
    if (x64_inst.describe(x64.RAW_BYTE).form != x64_inst.FORM_DATA || x64_inst.describe(x64.RAW_BYTE).cls.known) { ret 6; }
    if (x64_inst.describe(x64_inst.OPCODE_COUNT::u16).form != x64_inst.FORM_NONE)                                { ret 7; }
    if (missing != 0)                                                                                            { ret 1; }

    # an opcode outside the notifiable space describes as unknown, so a stream
    # that carried one is refused rather than walked as public
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    var e:  isa_effect.InstEffects;
    mi.opcode = x64.RAW_BYTE;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 8; }
    mi.opcode = x64.ASM_BLOCK;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 9; }
    mi.opcode = x64_inst.OPCODE_COUNT::u16;
    inst_effects(?mi, ?e);
    if (e.cls.known) { ret 10; }
    ret 0;
}

# the columns of one row agree: a transfer form has a transfer shape and
# nothing else does, a flags branch is a jcc, a flags reader with a
# destination is a setcc, the stack forms reach the stack, a memory address
# is only taken by lea, and a compare defines flags
#[testing]
fun ut_row_consistent(d: *x64_inst.OpDesc) bool {
    val xfer_form: bool = d.form == x64_inst.FORM_JMP || d.form == x64_inst.FORM_CALL || d.form == x64_inst.FORM_JCC;
    if (xfer_form != (d.shape == x64_inst.SHAPE_XFER))                                           { ret false; }
    if (d.cls.cond_flags != (d.form == x64_inst.FORM_JCC))                                       { ret false; }
    if (d.cls.cond_reg != (d.form == x64_inst.FORM_JMP || d.form == x64_inst.FORM_CALL))         { ret false; }
    if ((d.form == x64_inst.FORM_SETCC) != (d.cls.reads_flags && d.shape == x64_inst.SHAPE_DEF)) { ret false; }
    if (d.form == x64_inst.FORM_SETCC && d.mem != x64_inst.MEM_NONE)                             { ret false; }
    val stack_form: bool = d.form == x64_inst.FORM_PUSH || d.form == x64_inst.FORM_POP ||
        d.form == x64_inst.FORM_CALL || d.form == x64_inst.FORM_RET;
    if (stack_form && (d.mem & x64_inst.MEM_STACK) == 0)                          { ret false; }
    if (((d.mem & x64_inst.MEM_ADDR) != 0) != (d.form == x64_inst.FORM_LEA))      { ret false; }
    if (((d.mem & x64_inst.MEM_STRING) != 0) != (d.form == x64_inst.FORM_STRING)) { ret false; }
    val base_row: bool = d.form == x64_inst.FORM_FSGSBASE && d.shape == x64_inst.SHAPE_USE;
    if (((d.mem & x64_inst.MEM_BASE) != 0) != base_row)                                           { ret false; }
    if ((d.form == x64_inst.FORM_UCOMIS || d.form == x64_inst.FORM_TEST) && !d.cls.defines_flags) { ret false; }
    if (d.form == x64_inst.FORM_ALU && !d.cls.defines_flags)                                      { ret false; }
    if ((d.arity == 0) != (d.shape == x64_inst.SHAPE_NONE && d.form != x64_inst.FORM_DATA))       { ret false; }
    if (d.arity > 3)                                                                              { ret false; }
    if (d.shape == x64_inst.SHAPE_XFER && d.arity != 1)                                           { ret false; }
    if (d.shape == x64_inst.SHAPE_NONE && d.form != x64_inst.FORM_BARE && d.form != x64_inst.FORM_RET &&
        d.form != x64_inst.FORM_TRAP && d.form != x64_inst.FORM_STRING && d.form != x64_inst.FORM_DATA) { ret false; }
    if (d.shape != x64_inst.SHAPE_NONE && (d.form == x64_inst.FORM_BARE || d.form == x64_inst.FORM_RET ||
        d.form == x64_inst.FORM_TRAP || d.form == x64_inst.FORM_STRING || d.form == x64_inst.FORM_DATA)) { ret false; }
    if (x64_inst.form_is_float(d.form) && d.cls.op == ct.CT_OP_INT_DIVMOD)                                 { ret false; }
    if (d.cls.op == ct.CT_OP_FLOAT && !x64_inst.form_is_float(d.form))                                     { ret false; }
    if (d.cls.op == ct.CT_OP_VAR_SHIFT && d.form != x64_inst.FORM_SHIFT && d.form != x64_inst.FORM_DSHIFT) { ret false; }
    if (d.cls.op == ct.CT_OP_INT_DIVMOD && d.form != x64_inst.FORM_DIV)                                    { ret false; }
    ret true;
}

# the roles the walk reads: a two-address op reads and writes its first
# operand, a divide reads rax:rdx implicitly and writes both, a compare
# writes nothing, a zeroing xor defines a constant, a push touches memory
# with no address, a shift by cl gates on the count position
test inst_effects__roles_follow_intel_operand_order {
    var e:  isa_effect.InstEffects;
    var mi: isa_inst.Inst = isa_inst.inst_blank();

    mi.opcode = x64.ADD;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.src1   = isa_inst.make_reg(x64.RBX, 8);
    inst_effects(?mi, ?e);
    if (!e.cls.known || e.roles[0] != isa_effect.ROLE_RW || e.roles[1] != isa_effect.ROLE_READ || e.zero_idiom) { ret 1; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.XOR;
    mi.dst    = isa_inst.make_reg(x64.RDX, 4);
    mi.src1   = isa_inst.make_reg(x64.RDX, 4);
    inst_effects(?mi, ?e);
    if (!e.zero_idiom || e.roles[0] != isa_effect.ROLE_RW) { ret 2; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.DIV;
    mi.src1   = isa_inst.make_reg(x64.RCX, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_NONE || e.roles[1] != isa_effect.ROLE_READ)            { ret 3; }
    if (e.implicit_reads != (BIT_RAX | BIT_RDX) || e.implicit_writes != (BIT_RAX | BIT_RDX)) { ret 4; }
    if (e.cls.op != ct.CT_OP_INT_DIVMOD)                                                     { ret 5; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.CMP;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.src1   = isa_inst.make_imm(0, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_READ || e.roles[1] != isa_effect.ROLE_READ || !e.cls.defines_flags) { ret 6; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.src1   = isa_inst.make_mem(x64.RBP, -8, isa_inst.REG_NONE, 0, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ) { ret 7; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.LEA;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.src1   = isa_inst.make_mem(x64.RBX, 8, isa_inst.REG_NONE, 0, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_ADDR) { ret 8; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.PUSH;
    mi.dst    = isa_inst.make_reg(x64.RBP, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_READ || !e.implicit_mem || (e.implicit_writes & BIT_RSP) == 0) { ret 9; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.SHL;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.src1   = isa_inst.make_reg(x64.RCX, 1);
    inst_effects(?mi, ?e);
    if (e.count_pos != 1 || e.cls.op != ct.CT_OP_VAR_SHIFT) { ret 10; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.IMUL;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.src1   = isa_inst.make_reg(x64.RCX, 8);
    mi.src2   = isa_inst.make_imm(3, 4);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || e.roles[1] != isa_effect.ROLE_READ || e.cls.op != ct.CT_OP_INT_MUL) { ret 11; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.SETE;
    mi.dst    = isa_inst.make_reg(x64.RAX, 1);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_WRITE || !e.cls.reads_flags) { ret 12; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.JL;
    mi.dst    = isa_inst.make_block_label(3);
    inst_effects(?mi, ?e);
    if (!e.cls.cond_flags || e.xfer != isa_effect.XFER_BRANCH || e.target != isa_effect.TARGET_BLOCK || e.target_block != 3) { ret 13; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.JMP;
    mi.dst    = isa_inst.make_local_label(true);
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_JUMP || e.target != isa_effect.TARGET_LOCAL_FWD) { ret 14; }
    mi.dst = isa_inst.make_local_label(false);
    inst_effects(?mi, ?e);
    if (e.target != isa_effect.TARGET_LOCAL) { ret 20; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.CALL;
    mi.dst    = isa_inst.make_reg(x64.RAX, 8);
    mi.flags  = x64_inst.FLAG_INDIRECT::u16;
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_CALL || e.target != isa_effect.TARGET_REGISTER || e.roles[0] != isa_effect.ROLE_READ || !e.cls.cond_reg) { ret 15; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.RET;
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_RET) { ret 16; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.JNE;
    mi.dst    = isa_inst.make_sym(1, 8);
    inst_effects(?mi, ?e);
    if (e.xfer != isa_effect.XFER_BRANCH || e.target != isa_effect.TARGET_EXTERNAL) { ret 21; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.CQO;
    inst_effects(?mi, ?e);
    if (e.implicit_reads != BIT_RAX || e.implicit_writes != BIT_RDX) { ret 17; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.CVTSI2SD;
    mi.dst    = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0), 8);
    mi.src1   = isa_inst.make_reg(x64.RAX, 8);
    inst_effects(?mi, ?e);
    if (e.roles[0] != isa_effect.ROLE_RW || e.roles[1] != isa_effect.ROLE_READ || e.cls.op != ct.CT_OP_FLOAT) { ret 18; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.SYSCALL;
    inst_effects(?mi, ?e);
    if (e.implicit_writes != x64_mnemonic.SYSCALL_WRITES::u64 || !e.cls.opaque_flags) { ret 19; }
    ret 0;
}
