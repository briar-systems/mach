use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std_allocator: std.allocator;

use std.allocator.page;

use codegen_mir:   mach.lang.be.codegen.mir;
use codegen_rules: mach.lang.be.codegen.rules;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;

pub val RULE_COUNT: usize = 84;

pub val COPY_OPCODE_COUNT: usize = 2;

pub val FUSED_CC_COUNT: usize = 6;

pub fun select(a: *std_allocator.Allocator, tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction) err[fail.Fail] {
    ret codegen_rules.select_function(?PACK, a, tgt, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret codegen_rules.is_reg_move(?PACK, opcode);
}

# one instruction takes an integer whose sign extension from 32 bits is
# itself as its immediate; any other is a movabs of its own first, the rule
# the middle end hoists a loop's constants by (#3807)
pub fun int_imm_fits(value: u64, bits: u32) bool {
    if (bits <= 32) { ret true; }
    val v: i64 = value:~i64;
    ret v >= -2147483648 && v <= 2147483647;
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == x64.UD2::u32;
}

fun load_widens(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    ret mi.width > mi.src_width;
}

# the high multiply is the one-operand mul or imul on the rdx:rax pair: the
# accumulator is loaded, the pair multiply reads the other operand, and the
# high half is read back from rdx. the multiply takes a register or memory, so
# an immediate rides the accumulator, and when both operands are immediates
# the multiplier is staged in rdx, which the multiply overwrites anyway. the
# 8-bit form leaves its high half in ah, so only 16 bits and wider select here
fun mul_hi_width_ok(mi: *codegen_mir.MirInstr) bool {
    ret mi.width == 2 || mi.width == 4 || mi.width == 8;
}

fun mul_hi_reads_register(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    if (!mul_hi_width_ok(mi) || mi.operand_count != 3) { ret false; }
    ret mi.operands[1].kind != codegen_mir.MIR_OP_IMM || mi.operands[2].kind != codegen_mir.MIR_OP_IMM;
}

fun mul_hi_both_immediate(tgt: *isa.BackendTarget, f: *codegen_mir.MirFunction, mi: *codegen_mir.MirInstr) bool {
    if (!mul_hi_width_ok(mi) || mi.operand_count != 3) { ret false; }
    ret mi.operands[1].kind == codegen_mir.MIR_OP_IMM && mi.operands[2].kind == codegen_mir.MIR_OP_IMM;
}

fun pair_reg(r: i32) codegen_mir.MirOperand {
    var o: codegen_mir.MirOperand = codegen_mir.op_preg(codegen_mir.preg_id(r));
    o.required_bank = codegen_mir.BANK_GP;
    ret o;
}

fun emit_move(builder: *codegen_rules.ExpansionBuilder, dst: codegen_mir.MirOperand, src: codegen_mir.MirOperand) err[fail.Fail] {
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = dst;
    ops[1] = src;
    val r: res[*codegen_mir.MirInstr, fail.Fail] = codegen_rules.emit_instr(builder, x64.MOV::u32, ?ops[0], 2);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_mul_hi(builder: *codegen_rules.ExpansionBuilder, stage: bool) err[fail.Fail] {
    val mi:  *codegen_mir.MirInstr  = builder.source;
    val acc: codegen_mir.MirOperand = pair_reg(x64.RAX);
    val hi:  codegen_mir.MirOperand = pair_reg(x64.RDX);
    var x:   codegen_mir.MirOperand = mi.operands[1];
    var y:   codegen_mir.MirOperand = mi.operands[2];
    if (y.kind == codegen_mir.MIR_OP_IMM && x.kind != codegen_mir.MIR_OP_IMM) {
        x = mi.operands[2];
        y = mi.operands[1];
    }
    val r0: err[fail.Fail] = emit_move(builder, acc, x);
    if (sel r0.err) { ret r0; }
    if (stage) {
        val rs: err[fail.Fail] = emit_move(builder, hi, y);
        if (sel rs.err) { ret rs; }
        y = hi;
    }
    var op: u32 = codegen_mir.MIR_SEL_MUL_PAIR_U;
    if (mi.opcode == codegen_mir.MIR_MUL_HI_S) { op = codegen_mir.MIR_SEL_MUL_PAIR_S; }
    var ops: [2]codegen_mir.MirOperand;
    ops[0] = acc;
    ops[1] = y;
    val r1: res[*codegen_mir.MirInstr, fail.Fail] = codegen_rules.emit_instr(builder, op, ?ops[0], 2);
    if (sel r1.err) { ret err[fail.Fail].err{r1.err}; }
    ret emit_move(builder, mi.operands[0], hi);
}

fun expand_mul_hi(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    ret emit_mul_hi(builder, false);
}

fun expand_mul_hi_staged(builder: *codegen_rules.ExpansionBuilder) err[fail.Fail] {
    ret emit_mul_hi(builder, true);
}

pub val RULES: [RULE_COUNT]codegen_rules.Rule = [RULE_COUNT]codegen_rules.Rule{
    codegen_rules.Rule{op: codegen_mir.MIR_ADD, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_ADD, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SUB, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SUB, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_MUL, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_AND, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_AND, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_OR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_OR, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_XOR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_XOR, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_SHL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SHL, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SHR_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SHR_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SHR_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SHR_S, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_DIV_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_DIV_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DIV_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_DIV_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_REM_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_REM_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_REM_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_REM_U, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_MUL_PAIR_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_MUL_PAIR_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_PAIR_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_MUL_PAIR_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_U, gate: codegen_rules.GATE_SCALAR, guard: mul_hi_reads_register, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi, expansion_length: 3},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_S, gate: codegen_rules.GATE_SCALAR, guard: mul_hi_reads_register, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi, expansion_length: 3},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_U, gate: codegen_rules.GATE_SCALAR, guard: mul_hi_both_immediate, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi_staged, expansion_length: 4},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_S, gate: codegen_rules.GATE_SCALAR, guard: mul_hi_both_immediate, kind: codegen_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi_staged, expansion_length: 4},

    codegen_rules.Rule{op: codegen_mir.MIR_NEG, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_NEG, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_NOT, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_NOT, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_NOT, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_TRUNC, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEXT, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_ZEXT, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_WIDE_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_WIDE_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_WIDEN_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_WIDEN_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_RANGE, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_WIDEN_SUM_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_CONCAT, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_INTERLEAVE, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_SIGN_MASK, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_U, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MUL_HI_S, gate: codegen_rules.GATE_VECTOR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_TRUNC, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOVSX::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_ZEXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOVZX::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_BITCAST, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_FP_TRUNC, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_EXT, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TO_SI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FP_TO_UI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SI_TO_FP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_UI_TO_FP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_FADD, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FSUB, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FMUL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FDIV, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FCMP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_FNEG, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_ALLOCA, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.LEA::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_LOAD, gate: codegen_rules.GATE_ANY, guard: load_widens, kind: codegen_rules.RULE_RETAG, to: x64.MOVZX::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_LOAD, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_STORE, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_GEP, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.LEA::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_BR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.JMP::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_RET, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.RET::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_UNREACHABLE, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.UD2::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CBR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CBR, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_EQ, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_NE, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LT_S, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LT_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LE_S, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SEL_CBR_LE_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_MOV, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_DECLASSIFY, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CMP_EQ, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_EQ, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_NE, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_NE, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LT_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LT_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LT_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LT_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LE_S, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LE_S, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CMP_LE_U, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_CMP_LE_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_MASK_LT_U, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_MASK_LT_U, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SELECT, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SELECT, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_SELECT_CMP, gate: codegen_rules.GATE_SCALAR, guard: nil, kind: codegen_rules.RULE_RETAG, to: codegen_mir.MIR_SEL_SELECT_CMP, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_ASM, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.ASM_BLOCK::u32, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_VEC_UPPER_CLEAR, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_RETAG, to: x64.VZEROUPPER::u32, expand: nil, expansion_length: 0},

    codegen_rules.Rule{op: codegen_mir.MIR_CALL, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_ARG, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_CALL_RES, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    codegen_rules.Rule{op: codegen_mir.MIR_PHI, gate: codegen_rules.GATE_ANY, guard: nil, kind: codegen_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
};

pub val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    x64.MOV::u32,
    codegen_mir.MIR_MOV,
};

pub val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    codegen_mir.MIR_CMP_EQ,
    codegen_mir.MIR_CMP_NE,
    codegen_mir.MIR_CMP_LT_S,
    codegen_mir.MIR_CMP_LT_U,
    codegen_mir.MIR_CMP_LE_S,
    codegen_mir.MIR_CMP_LE_U,
};

pub val PACK: codegen_rules.RulePack = codegen_rules.RulePack{
    name:               "x86_64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

test select__opcode_rewrites {
    var bad:   i32 = 0;
    var alloc: std_allocator.Allocator;
    var tgt:   isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_X86_64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    var instrs: [20]codegen_mir.MirInstr;
    var ops:    [20][3]codegen_mir.MirOperand;
    var i:      u32 = 0;
    for (i < 20) {
        ops[i][0]               = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ops[i][1]               = codegen_mir.op_preg(codegen_mir.preg_id(11));
        ops[i][2]               = codegen_mir.op_preg(codegen_mir.preg_id(12));
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 3;
        instrs[i].width         = 8;
        instrs[i].src_width     = 8;
        i                       = i + 1;
    }

    instrs[0].opcode         = codegen_mir.MIR_ADD;
    instrs[1].opcode         = codegen_mir.MIR_SHR_S;
    instrs[2].opcode         = codegen_mir.MIR_DIV_U;
    instrs[3].opcode         = codegen_mir.MIR_CMP_LT_S;
    instrs[4].opcode         = codegen_mir.MIR_CBR;
    instrs[5].opcode         = codegen_mir.MIR_FADD;
    instrs[6].opcode         = codegen_mir.MIR_FP_TO_SI;
    instrs[7].opcode         = codegen_mir.MIR_MOV;
    instrs[8].opcode         = codegen_mir.MIR_SEXT;
    instrs[9].opcode         = codegen_mir.MIR_ZEXT;
    instrs[10].opcode        = codegen_mir.MIR_BITCAST;
    instrs[11].opcode        = codegen_mir.MIR_ALLOCA;
    instrs[12].opcode        = codegen_mir.MIR_GEP;
    instrs[13].opcode        = codegen_mir.MIR_STORE;
    instrs[14].opcode        = codegen_mir.MIR_LOAD;
    instrs[14].width         = 8;
    instrs[14].src_width     = 2;
    instrs[15].opcode        = codegen_mir.MIR_LOAD;
    instrs[15].width         = 4;
    instrs[15].src_width     = 4;
    instrs[16].opcode        = codegen_mir.MIR_BR;
    instrs[17].opcode        = codegen_mir.MIR_ASM;
    instrs[18].opcode        = codegen_mir.MIR_NOT;
    instrs[18].vec_lane      = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4);
    instrs[19].opcode        = codegen_mir.MIR_CALL;
    ops[4][1]                = codegen_mir.op_block(0);
    ops[4][2]                = codegen_mir.op_block(1);
    ops[5][0]                = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0)));
    ops[5][1]                = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1)));
    ops[5][2]                = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 2)));
    instrs[6].operand_count  = 2;
    ops[6][1]                = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1)));
    instrs[16].operand_count = 1;
    ops[16][0]               = codegen_mir.op_block(0);
    instrs[17].operand_count = 0;
    ops[18][0]               = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 0)));
    ops[18][1]               = codegen_mir.op_preg(codegen_mir.preg_id(isa.regid_make(isa.REG_CLASS_ID_XMM, 1)));
    instrs[18].operand_count = 2;
    instrs[19].operand_count = 1;

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 20;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?alloc, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (instrs[0].opcode != codegen_mir.MIR_SEL_ADD)      { bad = 1; }
    if (instrs[1].opcode != codegen_mir.MIR_SEL_SHR_S)    { bad = 1; }
    if (instrs[2].opcode != codegen_mir.MIR_SEL_DIV_U)    { bad = 1; }
    if (instrs[3].opcode != codegen_mir.MIR_SEL_CMP_LT_S) { bad = 1; }
    if (instrs[4].opcode != codegen_mir.MIR_SEL_CBR)      { bad = 1; }
    if (instrs[5].opcode != codegen_mir.MIR_FADD)         { bad = 1; }
    if (instrs[6].opcode != codegen_mir.MIR_FP_TO_SI)     { bad = 1; }
    if (instrs[7].opcode != x64.MOV::u32)                 { bad = 1; }
    if (instrs[8].opcode != x64.MOVSX::u32)               { bad = 1; }
    if (instrs[9].opcode != x64.MOVZX::u32)               { bad = 1; }
    if (instrs[10].opcode != x64.MOV::u32)                { bad = 1; }
    if (instrs[11].opcode != x64.LEA::u32)                { bad = 1; }
    if (instrs[12].opcode != x64.LEA::u32)                { bad = 1; }
    if (instrs[13].opcode != x64.MOV::u32)                { bad = 1; }
    if (instrs[14].opcode != x64.MOVZX::u32)              { bad = 1; }
    if (instrs[15].opcode != x64.MOV::u32)                { bad = 1; }
    if (instrs[16].opcode != x64.JMP::u32)                { bad = 1; }
    if (instrs[17].opcode != x64.ASM_BLOCK::u32)          { bad = 1; }
    if (instrs[18].opcode != codegen_mir.MIR_NOT)         { bad = 1; }
    if (instrs[19].opcode != codegen_mir.MIR_CALL)        { bad = 1; }

    ret bad;
}

# a scalar neg or not selects one two-address instruction over its
# destination and operand, so the allocator sees the operand read and the
# destination written by the same instruction
test select__neg_and_not_are_two_address {
    var backing: std_allocator.Allocator;
    val make_r:  err[std_allocator.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_X86_64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    var instrs: [2]codegen_mir.MirInstr;
    var ops:    [2][2]codegen_mir.MirOperand;
    ops[0][0] = codegen_mir.op_preg(codegen_mir.preg_id(10));
    ops[0][1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
    ops[1][0] = codegen_mir.op_preg(codegen_mir.preg_id(12));
    ops[1][1] = codegen_mir.op_preg(codegen_mir.preg_id(13));
    instrs[0] = codegen_mir.instr(codegen_mir.MIR_NEG, ?ops[0][0], 2, 4, 4);
    instrs[1] = codegen_mir.instr(codegen_mir.MIR_NOT, ?ops[1][0], 2, 2, 2);

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 2;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?backing, ?tgt, ?f);
    if (sel r.err) { ret 1; }

    if (blk.instr_count != 2)                                             { ret 2; }
    if (instrs[0].opcode != codegen_mir.MIR_SEL_NEG)                      { ret 3; }
    if (instrs[1].opcode != codegen_mir.MIR_SEL_NOT)                      { ret 4; }
    if (instrs[0].operand_count != 2)                                     { ret 5; }
    if (instrs[0].operands[0].preg.n != 10)                               { ret 6; }
    if (instrs[0].operands[1].preg.n != 11)                               { ret 7; }
    if (instrs[1].operands[0].preg.n != 12)                               { ret 8; }
    if (instrs[1].operands[1].preg.n != 13)                               { ret 9; }
    if (instrs[0].width != 4)                                             { ret 10; }
    if (instrs[1].width != 2)                                             { ret 11; }
    if (!codegen_mir.has(instrs[0].opcode, codegen_mir.MIRF_TWO_ADDRESS)) { ret 12; }
    if (!codegen_mir.has(instrs[1].opcode, codegen_mir.MIRF_TWO_ADDRESS)) { ret 13; }
    ret 0;
}

# a high multiply loads rax, multiplies on the pair and reads rdx back; an
# immediate rides rax, and a second immediate is staged in rdx (#3809)
test select__mul_hi_expands_onto_the_pair {
    var backing: std_allocator.Allocator;
    val make_r:  err[std_allocator.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id    = isa.ARCH_X86_64;
    tgt.model.pointer_width = 8;
    tgt.model.gpr_width     = 8;

    # an expansion frees its source's operands, so they live on the allocator
    var src: [3]codegen_mir.MirInstr;
    var k:   u32 = 0;
    for (k < 3) {
        val ro: res[*codegen_mir.MirOperand, std_allocator.Error] = std_allocator.allocate[codegen_mir.MirOperand](?backing, 3::usize);
        if (sel ro.err) { ret 1; }
        ro.ok[0] = codegen_mir.op_preg(codegen_mir.preg_id(10));
        ro.ok[1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
        ro.ok[2] = codegen_mir.op_preg(codegen_mir.preg_id(12));
        src[k]   = codegen_mir.instr(codegen_mir.MIR_MUL_HI_U, ro.ok, 3, 8, 8);
        k        = k + 1;
    }
    src[0].operands[2] = codegen_mir.op_imm(7);
    src[1].opcode      = codegen_mir.MIR_MUL_HI_S;
    src[1].width       = 4;
    src[1].src_width   = 4;
    src[2].operands[1] = codegen_mir.op_imm(5);
    src[2].operands[2] = codegen_mir.op_imm(9);

    var blk: codegen_mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?src[0];
    blk.instr_count = 3;
    blk.instr_cap   = 0;

    var f: codegen_mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: err[fail.Fail] = select(?backing, ?tgt, ?f);
    if (sel r.err)             { ret 2; }
    if (blk.instr_count != 10) { ret 3; }
    val out: *codegen_mir.MirInstr = blk.instrs;

    val want: [10]u32 = [10]u32{x64.MOV::u32, codegen_mir.MIR_SEL_MUL_PAIR_U, x64.MOV::u32,
        x64.MOV::u32, codegen_mir.MIR_SEL_MUL_PAIR_S, x64.MOV::u32,
        x64.MOV::u32, x64.MOV::u32, codegen_mir.MIR_SEL_MUL_PAIR_U, x64.MOV::u32};
    var i: u32 = 0;
    for (i < 10) {
        if (out[i].opcode != want[i]) { ret 4; }
        i = i + 1;
    }

    # the immediate rides rax and the register is the multiplier
    if (out[0].operands[0].preg.n != x64.RAX::u32 || out[0].operands[1].kind != codegen_mir.MIR_OP_IMM) { ret 5; }
    if (out[0].operands[1].imm != 7)                                                                    { ret 5; }
    if (out[1].operands[0].preg.n != x64.RAX::u32 || out[1].operands[1].preg.n != 11)                   { ret 6; }
    if (out[2].operands[0].preg.n != 10 || out[2].operands[1].preg.n != x64.RDX::u32)                   { ret 7; }
    if (out[2].width != 8)                                                                              { ret 7; }

    # the signed 32-bit form keeps its width on every piece
    if (out[3].operands[1].preg.n != 11 || out[4].operands[1].preg.n != 12) { ret 8; }
    if (out[3].width != 4 || out[4].width != 4 || out[5].width != 4)        { ret 8; }

    # two immediates: the second is staged in rdx and multiplied from there
    if (out[6].operands[1].imm != 5 || out[7].operands[0].preg.n != x64.RDX::u32) { ret 9; }
    if (out[7].operands[1].imm != 9 || out[8].operands[1].preg.n != x64.RDX::u32) { ret 9; }
    ret 0;
}

test is_reg_move__only_plain_moves {
    if (!is_reg_move(x64.MOV::u32))        { ret 1; }
    if (!is_reg_move(codegen_mir.MIR_MOV)) { ret 1; }
    if (is_reg_move(x64.ADD::u32))         { ret 1; }
    if (is_reg_move(x64.MOVZX::u32))       { ret 1; }
    ret 0;
}

test rule_pack__generic_opcode_coverage {
    var tgt: isa.BackendTarget;
    tgt.model.gpr_width = 8;
    val pack: *codegen_rules.RulePack = ?PACK;
    if (pack.rule_count != 84) { ret 1; }

    var reachable: [codegen_mir.SELECTION_REACHABLE_COUNT]u32;
    codegen_mir.selection_reachable(?reachable[0]);

    var eliminated: [codegen_mir.SELECTION_ELIMINATED_COUNT]u32;
    codegen_mir.selection_eliminated(?eliminated[0]);

    var ops: [3]codegen_mir.MirOperand;
    ops[0] = codegen_mir.op_preg(codegen_mir.preg_id(10));
    ops[1] = codegen_mir.op_preg(codegen_mir.preg_id(11));
    ops[2] = codegen_mir.op_preg(codegen_mir.preg_id(12));
    var probe: codegen_mir.MirInstr = codegen_mir.instr(codegen_mir.MIR_ADD, ?ops[0], 3, 8, 0);

    var f: codegen_mir.MirFunction;

    var fused: [codegen_mir.SELECTION_FUSED_COUNT]u32;
    codegen_mir.selection_fused(?fused[0]);

    var i: u32 = 0;
    for (i < codegen_mir.SELECTION_REACHABLE_COUNT) {
        probe.opcode = reachable[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < codegen_mir.SELECTION_ELIMINATED_COUNT) {
        probe.opcode = eliminated[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < codegen_mir.SELECTION_FUSED_COUNT) {
        probe.opcode = fused[i];
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    if (pack.fused_cbr_cc_count != 6) { ret 1; }

    # a lane-wise conversion passes to the vector encoder, never to a scalar move
    val convs: [9]u32 = [9]u32{codegen_mir.MIR_TRUNC, codegen_mir.MIR_SEXT, codegen_mir.MIR_ZEXT, codegen_mir.MIR_FP_TRUNC, codegen_mir.MIR_FP_EXT,
        codegen_mir.MIR_FP_TO_SI, codegen_mir.MIR_FP_TO_UI, codegen_mir.MIR_SI_TO_FP, codegen_mir.MIR_UI_TO_FP};
    var ci: u32 = 0;
    for (ci < 9) {
        probe.opcode   = convs[ci];
        probe.vec_lane = codegen_mir.vec_lane_make_convert(codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8), codegen_mir.VEC_LANE_INT, 1);
        val conv_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (conv_rule == nil || conv_rule.kind != codegen_rules.RULE_PASS) { ret 2; }
        ci = ci + 1;
    }
    probe.vec_lane = codegen_mir.VEC_LANE_NONE;

    # a packed widening multiply passes to the vector encoder on a vector lane
    # and has no scalar selection
    var pwide: [codegen_mir.SELECTION_PACKED_WIDENING_COUNT]u32;
    codegen_mir.selection_packed_widening(?pwide[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_WIDENING_COUNT) {
        probe.opcode   = pwide[i];
        probe.vec_lane = codegen_mir.vec_lane_make_convert(codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4), codegen_mir.VEC_LANE_INT, 2);
        val wide_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (wide_rule == nil || wide_rule.kind != codegen_rules.RULE_PASS) { ret 3; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 3; }
        i = i + 1;
    }

    # a lane range and a lane join pass to the vector encoder on a vector lane
    # and have no scalar selection
    var perm: [codegen_mir.SELECTION_PACKED_PERMUTE_COUNT]u32;
    codegen_mir.selection_packed_permute(?perm[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_PERMUTE_COUNT) {
        probe.opcode   = perm[i];
        probe.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8);
        val perm_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (perm_rule == nil || perm_rule.kind != codegen_rules.RULE_PASS) { ret 5; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 5; }
        i = i + 1;
    }

    # a lane interleave and a lane sign mask pass to the vector encoder on a
    # vector lane and have no scalar selection (#4119, #4198)
    var pair: [codegen_mir.SELECTION_PACKED_PAIR_COUNT]u32;
    codegen_mir.selection_packed_pair(?pair[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_PACKED_PAIR_COUNT) {
        probe.opcode   = pair[i];
        probe.vec_lane = codegen_mir.vec_lane_make_convert(codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 4, 4), codegen_mir.VEC_LANE_INT, 2);
        val pair_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (pair_rule == nil || pair_rule.kind != codegen_rules.RULE_PASS) { ret 8; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) != nil) { ret 8; }
        i = i + 1;
    }

    # the high multiplies expand onto the rdx:rax pair (#3809), and pass to
    # the vector encoder on a vector lane (#4119)
    var wmul: [codegen_mir.SELECTION_WIDENING_MUL_COUNT]u32;
    codegen_mir.selection_widening_mul(?wmul[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_WIDENING_MUL_COUNT) {
        probe.opcode = wmul[i];
        val hi_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (hi_rule == nil || hi_rule.kind != codegen_rules.RULE_EXPAND) { ret 6; }
        probe.vec_lane = codegen_mir.vec_lane_make(codegen_mir.VEC_LANE_INT, 2, 8);
        val packed_hi: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (packed_hi == nil || packed_hi.kind != codegen_rules.RULE_PASS) { ret 6; }
        probe.vec_lane = codegen_mir.VEC_LANE_NONE;
        i              = i + 1;
    }

    # the fixed-pair multiplies retag to their rdx:rax selection
    var pmul: [codegen_mir.SELECTION_FIXED_PAIR_MUL_COUNT]u32;
    codegen_mir.selection_fixed_pair_mul(?pmul[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_FIXED_PAIR_MUL_COUNT) {
        probe.opcode = pmul[i];
        val pair_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (pair_rule == nil || pair_rule.kind != codegen_rules.RULE_RETAG) { ret 4; }
        i = i + 1;
    }

    # the wide-register upper clear retags to vzeroupper
    var wide: [codegen_mir.SELECTION_WIDE_REGISTER_COUNT]u32;
    codegen_mir.selection_wide_register(?wide[0]);
    i = 0;
    for (i < codegen_mir.SELECTION_WIDE_REGISTER_COUNT) {
        probe.opcode = wide[i];
        val wide_rule: *codegen_rules.Rule = codegen_rules.find_rule(pack, ?tgt, ?f, ?probe);
        if (wide_rule == nil || wide_rule.to != x64.VZEROUPPER::u32) { ret 7; }
        i = i + 1;
    }

    if (x64.HAS_FLOAT) {
        var rfloat: [codegen_mir.SELECTION_REACHABLE_FLOAT_COUNT]u32;
        codegen_mir.selection_reachable_float(?rfloat[0]);
        i = 0;
        for (i < codegen_mir.SELECTION_REACHABLE_FLOAT_COUNT) {
            probe.opcode = rfloat[i];
            if (codegen_rules.find_rule(pack, ?tgt, ?f, ?probe) == nil) { ret 1; }
            i = i + 1;
        }
    }
    ret 0;
}
