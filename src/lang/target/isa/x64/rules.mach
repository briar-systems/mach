use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use std.allocator.page;

use mach.lang.be.codegen.mir;
use mach.lang.be.codegen.rules;
use mach.lang.source;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;

pub val RULE_COUNT: usize = 60;

pub val COPY_OPCODE_COUNT: usize = 2;

pub val FUSED_CC_COUNT: usize = 6;

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *mir.MirFunction) R.Result[R.Void, str] {
    ret rules.select(?PACK, a, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret rules.is_reg_move(?PACK, opcode);
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == x64.UD2::u32;
}

fun load_widens(f: *mir.MirFunction, mi: *mir.MirInstr) bool {
    ret mi.width > mi.src_width;
}

fun expand_neg(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    if (builder.source.operand_count < 2) { ret R.err[R.Void, str]("x64.rules: NEG missing operands"); }
    val d:   mir.MirOperand = builder.source.operands[0];
    val src: mir.MirOperand = builder.source.operands[1];

    var xor_ops: [2]mir.MirOperand;
    xor_ops[0] = d;
    xor_ops[1] = d;
    val r_xor: R.Result[*mir.MirInstr, str] = rules.emit(builder, x64.XOR::u32, ?xor_ops[0], 2);
    if (R.is_err[*mir.MirInstr, str](r_xor)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirInstr, str](r_xor)); }

    var sub_ops: [2]mir.MirOperand;
    sub_ops[0] = d;
    sub_ops[1] = src;
    val r_sub: R.Result[*mir.MirInstr, str] = rules.emit(builder, x64.SUB::u32, ?sub_ops[0], 2);
    if (R.is_err[*mir.MirInstr, str](r_sub)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirInstr, str](r_sub)); }

    ret R.ok_void[str]();
}

fun expand_not(builder: *rules.ExpansionBuilder) R.Result[R.Void, str] {
    if (builder.source.operand_count < 2) { ret R.err[R.Void, str]("x64.rules: NOT missing operands"); }
    val d:   mir.MirOperand = builder.source.operands[0];
    val src: mir.MirOperand = builder.source.operands[1];

    var mov_ops: [2]mir.MirOperand;
    mov_ops[0] = d;
    mov_ops[1] = src;
    val r_mov: R.Result[*mir.MirInstr, str] = rules.emit(builder, x64.MOV::u32, ?mov_ops[0], 2);
    if (R.is_err[*mir.MirInstr, str](r_mov)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirInstr, str](r_mov)); }

    var xor_ops: [2]mir.MirOperand;
    xor_ops[0] = d;
    xor_ops[1] = mir.op_imm(-1);
    val r_xor: R.Result[*mir.MirInstr, str] = rules.emit(builder, x64.XOR::u32, ?xor_ops[0], 2);
    if (R.is_err[*mir.MirInstr, str](r_xor)) { ret R.err[R.Void, str](R.unwrap_err[*mir.MirInstr, str](r_xor)); }

    ret R.ok_void[str]();
}

pub val RULES: [RULE_COUNT]rules.Rule = [RULE_COUNT]rules.Rule{
    rules.Rule{ op: mir.MIR_ADD, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_ADD, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SUB, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_SUB, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_MUL, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_MUL, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_AND, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_AND, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_OR,  gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_OR,  expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_XOR, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_XOR, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_SHL,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_SHL,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SHR_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_SHR_U, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SHR_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_SHR_S, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_DIV_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_DIV_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DIV_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_DIV_U, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_REM_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_REM_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_REM_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_REM_U, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_NEG, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_neg, expansion_length: 2 },

    rules.Rule{ op: mir.MIR_NOT, gate: rules.GATE_VECTOR, guard: nil, kind: rules.RULE_PASS,   to: 0, expand: nil,        expansion_length: 0 },
    rules.Rule{ op: mir.MIR_NOT, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_EXPAND, to: 0, expand: expand_not, expansion_length: 2 },

    rules.Rule{ op: mir.MIR_TRUNC,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.MOV::u32,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEXT,    gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.MOVSX::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_ZEXT,    gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.MOVZX::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_BITCAST, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.MOV::u32,   expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_FP_TRUNC, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_EXT,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_TO_SI, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FP_TO_UI, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SI_TO_FP, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_UI_TO_FP, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_FADD, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FSUB, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FMUL, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FDIV, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FCMP, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_FNEG, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_ALLOCA, gate: rules.GATE_ANY, guard: nil,          kind: rules.RULE_RETAG, to: x64.LEA::u32,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_LOAD,   gate: rules.GATE_ANY, guard: load_widens,  kind: rules.RULE_RETAG, to: x64.MOVZX::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_LOAD,   gate: rules.GATE_ANY, guard: nil,          kind: rules.RULE_RETAG, to: x64.MOV::u32,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_STORE,  gate: rules.GATE_ANY, guard: nil,          kind: rules.RULE_RETAG, to: x64.MOV::u32,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_GEP,    gate: rules.GATE_ANY, guard: nil,          kind: rules.RULE_RETAG, to: x64.LEA::u32,   expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_BR,          gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.JMP::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_RET,         gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.RET::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_UNREACHABLE, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.UD2::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CBR, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CBR, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_SEL_CBR_EQ,   gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_NE,   gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LT_S, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LT_U, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LE_S, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_SEL_CBR_LE_U, gate: rules.GATE_SCALAR, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_MOV, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_DECLASSIFY, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.MOV::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CMP_EQ,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_EQ,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_NE,   gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_NE,   expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LT_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LT_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LT_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LT_U, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LE_S, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LE_S, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CMP_LE_U, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: mir.MIR_SEL_CMP_LE_U, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_ASM, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_RETAG, to: x64.ASM_BLOCK::u32, expand: nil, expansion_length: 0 },

    rules.Rule{ op: mir.MIR_CALL,     gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_ARG,      gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_CALL_RES, gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
    rules.Rule{ op: mir.MIR_PHI,      gate: rules.GATE_ANY, guard: nil, kind: rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0 },
};

pub val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    x64.MOV::u32,
    mir.MIR_MOV,
};

pub val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    mir.MIR_CMP_EQ,
    mir.MIR_CMP_NE,
    mir.MIR_CMP_LT_S,
    mir.MIR_CMP_LT_U,
    mir.MIR_CMP_LE_S,
    mir.MIR_CMP_LE_U,
};

pub val PACK: rules.RulePack = rules.RulePack{
    name:               "x86_64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

test "mach.lang.target.isa.x64.rules:opcode_rewrites" {
    var bad:   i32 = 0;
    var alloc: A.Allocator;
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_X86_64;
    tgt.model.pointer_width = 8;

    var instrs: [20]mir.MirInstr;
    var ops:    [20][3]mir.MirOperand;
    var i:      u32 = 0;
    for (i < 20) {
        ops[i][0] = mir.op_preg(10);
        ops[i][1] = mir.op_preg(11);
        ops[i][2] = mir.op_preg(12);
        instrs[i].operands      = ?ops[i][0];
        instrs[i].operand_count = 3;
        instrs[i].width         = 8;
        instrs[i].src_width     = 8;
        i = i + 1;
    }

    instrs[0].opcode = mir.MIR_ADD;
    instrs[1].opcode = mir.MIR_SHR_S;
    instrs[2].opcode = mir.MIR_DIV_U;
    instrs[3].opcode = mir.MIR_CMP_LT_S;
    instrs[4].opcode = mir.MIR_CBR;
    instrs[5].opcode = mir.MIR_FADD;
    instrs[6].opcode = mir.MIR_FP_TO_SI;
    instrs[7].opcode  = mir.MIR_MOV;
    instrs[8].opcode  = mir.MIR_SEXT;
    instrs[9].opcode  = mir.MIR_ZEXT;
    instrs[10].opcode = mir.MIR_BITCAST;
    instrs[11].opcode = mir.MIR_ALLOCA;
    instrs[12].opcode = mir.MIR_GEP;
    instrs[13].opcode = mir.MIR_STORE;
    instrs[14].opcode = mir.MIR_LOAD; instrs[14].width = 8; instrs[14].src_width = 2;
    instrs[15].opcode = mir.MIR_LOAD; instrs[15].width = 4; instrs[15].src_width = 4;
    instrs[16].opcode = mir.MIR_BR;
    instrs[17].opcode = mir.MIR_ASM;
    instrs[18].opcode = mir.MIR_NOT; instrs[18].vec_lane = mir.vec_lane_make(mir.VEC_LANE_INT, 4, 4);
    instrs[19].opcode = mir.MIR_CALL;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = ?instrs[0];
    blk.instr_count = 20;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: R.Result[R.Void, str] = select(?alloc, ?tgt, ?f);
    if (R.is_err[R.Void, str](r)) { ret 1; }

    if (instrs[0].opcode  != mir.MIR_SEL_ADD)    { bad = 1; }
    if (instrs[1].opcode  != mir.MIR_SEL_SHR_S)  { bad = 1; }
    if (instrs[2].opcode  != mir.MIR_SEL_DIV_U)  { bad = 1; }
    if (instrs[3].opcode  != mir.MIR_SEL_CMP_LT_S) { bad = 1; }
    if (instrs[4].opcode  != mir.MIR_SEL_CBR)    { bad = 1; }
    if (instrs[5].opcode  != mir.MIR_FADD)       { bad = 1; }
    if (instrs[6].opcode  != mir.MIR_FP_TO_SI)   { bad = 1; }
    if (instrs[7].opcode  != x64.MOV::u32)       { bad = 1; }
    if (instrs[8].opcode  != x64.MOVSX::u32)     { bad = 1; }
    if (instrs[9].opcode  != x64.MOVZX::u32)     { bad = 1; }
    if (instrs[10].opcode != x64.MOV::u32)       { bad = 1; }
    if (instrs[11].opcode != x64.LEA::u32)       { bad = 1; }
    if (instrs[12].opcode != x64.LEA::u32)       { bad = 1; }
    if (instrs[13].opcode != x64.MOV::u32)       { bad = 1; }
    if (instrs[14].opcode != x64.MOVZX::u32)     { bad = 1; }
    if (instrs[15].opcode != x64.MOV::u32)       { bad = 1; }
    if (instrs[16].opcode != x64.JMP::u32)       { bad = 1; }
    if (instrs[17].opcode != x64.ASM_BLOCK::u32) { bad = 1; }
    if (instrs[18].opcode != mir.MIR_NOT)        { bad = 1; }
    if (instrs[19].opcode != mir.MIR_CALL)       { bad = 1; }

    ret bad;
}

test "mach.lang.target.isa.x64.rules:neg_not_expansion" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var tgt: isa.BackendTarget;
    tgt.identity.arch_id = isa.ARCH_X86_64;
    tgt.model.pointer_width = 8;

    val res_instrs: R.Result[*mir.MirInstr, str] = A.zallocate[mir.MirInstr](?backing, 2::usize);
    if (R.is_err[*mir.MirInstr, str](res_instrs)) { ret 1; }
    val instrs: *mir.MirInstr = R.unwrap_ok[*mir.MirInstr, str](res_instrs);

    val res_neg_ops: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](?backing, 2::usize);
    if (R.is_err[*mir.MirOperand, str](res_neg_ops)) { ret 1; }
    val neg_ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](res_neg_ops);
    neg_ops[0] = mir.op_preg(10);
    neg_ops[1] = mir.op_preg(11);

    val res_not_ops: R.Result[*mir.MirOperand, str] = A.allocate[mir.MirOperand](?backing, 2::usize);
    if (R.is_err[*mir.MirOperand, str](res_not_ops)) { ret 1; }
    val not_ops: *mir.MirOperand = R.unwrap_ok[*mir.MirOperand, str](res_not_ops);
    not_ops[0] = mir.op_preg(12);
    not_ops[1] = mir.op_preg(13);

    var bindings: [1]mir.MirDbgBinding;
    bindings[0].iid  = 9;
    bindings[0].vreg = 4;
    bindings[0].cmp_op = 0;

    instrs[0].opcode            = mir.MIR_NEG;
    instrs[0].operands          = neg_ops;
    instrs[0].operand_count     = 2;
    instrs[0].width             = 4;
    instrs[0].src_width         = 4;
    instrs[0].loc               = source.loc(3, 77);
    instrs[0].inline_site       = 5;
    instrs[0].dbg_bindings      = ?bindings[0];
    instrs[0].dbg_binding_count = 1;
    instrs[1].opcode        = mir.MIR_NOT;
    instrs[1].operands      = not_ops;
    instrs[1].operand_count = 2;
    instrs[1].width         = 2;
    instrs[1].src_width     = 2;

    var blk: mir.MirBlock;
    blk.id          = 0;
    blk.instrs      = instrs;
    blk.instr_count = 2;
    blk.instr_cap   = 2;

    var f: mir.MirFunction;
    f.blocks      = ?blk;
    f.block_count = 1;
    f.vreg_count  = 0;

    val r: R.Result[R.Void, str] = select(?backing, ?tgt, ?f);
    if (R.is_err[R.Void, str](r)) { ret 1; }

    if (blk.instr_count != 4) { ret 1; }
    if (blk.instr_cap != 4)   { ret 1; }

    if (blk.instrs[0].opcode != x64.XOR::u32)      { ret 1; }
    if (blk.instrs[0].operands[0].preg != 10)      { ret 1; }
    if (blk.instrs[0].operands[1].preg != 10)      { ret 1; }
    if (blk.instrs[1].opcode != x64.SUB::u32)      { ret 1; }
    if (blk.instrs[1].operands[0].preg != 10)      { ret 1; }
    if (blk.instrs[1].operands[1].preg != 11)      { ret 1; }
    if (blk.instrs[2].opcode != x64.MOV::u32)      { ret 1; }
    if (blk.instrs[2].operands[0].preg != 12)      { ret 1; }
    if (blk.instrs[2].operands[1].preg != 13)      { ret 1; }
    if (blk.instrs[3].opcode != x64.XOR::u32)      { ret 1; }
    if (blk.instrs[3].operands[0].preg != 12)      { ret 1; }
    if (blk.instrs[3].operands[1].kind != mir.MIR_OP_IMM) { ret 1; }
    if (blk.instrs[3].operands[1].imm != -1)       { ret 1; }

    if (blk.instrs[0].width != 4)             { ret 1; }
    if (blk.instrs[0].src_width != 4)         { ret 1; }
    if (blk.instrs[0].loc.file != 3)          { ret 1; }
    if (blk.instrs[0].loc.offset != 77)       { ret 1; }
    if (blk.instrs[0].inline_site != 5)       { ret 1; }
    if (blk.instrs[0].asm_block != nil)       { ret 1; }
    if (blk.instrs[0].dbg_bindings != ?bindings[0]) { ret 1; }
    if (blk.instrs[0].dbg_binding_count != 1) { ret 1; }
    if (blk.instrs[1].width != 4)             { ret 1; }
    if (blk.instrs[1].src_width != 4)         { ret 1; }
    if (blk.instrs[1].loc.file != 3)          { ret 1; }
    if (blk.instrs[1].inline_site != 5)       { ret 1; }
    if (blk.instrs[1].asm_block != nil)       { ret 1; }
    if (blk.instrs[1].dbg_bindings != nil)    { ret 1; }
    if (blk.instrs[1].dbg_binding_count != 0) { ret 1; }
    if (blk.instrs[2].width != 2)             { ret 1; }
    if (blk.instrs[3].width != 2)             { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.rules:is_reg_move" {
    if (!is_reg_move(x64.MOV::u32))  { ret 1; }
    if (!is_reg_move(mir.MIR_MOV))   { ret 1; }
    if (is_reg_move(x64.ADD::u32))   { ret 1; }
    if (is_reg_move(x64.MOVZX::u32)) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.rules:generic_opcode_coverage" {
    val pack: *rules.RulePack = ?PACK;
    if (pack.rule_count != 60) { ret 1; }

    var reachable: [mir.SELECTION_REACHABLE_COUNT]u32;
    mir.selection_reachable(?reachable[0]);

    var eliminated: [mir.SELECTION_ELIMINATED_COUNT]u32;
    mir.selection_eliminated(?eliminated[0]);

    var ops: [3]mir.MirOperand;
    ops[0] = mir.op_preg(10);
    ops[1] = mir.op_preg(11);
    ops[2] = mir.op_preg(12);
    var probe: mir.MirInstr = mir.instr(mir.MIR_ADD, ?ops[0], 3, 8, 0);

    var f: mir.MirFunction;

    var fused: [mir.SELECTION_FUSED_COUNT]u32;
    mir.selection_fused(?fused[0]);

    var i: u32 = 0;
    for (i < mir.SELECTION_REACHABLE_COUNT) {
        probe.opcode = reachable[i];
        if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < mir.SELECTION_ELIMINATED_COUNT) {
        probe.opcode = eliminated[i];
        if (rules.find_rule(pack, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < mir.SELECTION_FUSED_COUNT) {
        probe.opcode = fused[i];
        if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
        i = i + 1;
    }
    if (pack.fused_cbr_cc_count != 6) { ret 1; }

    var wmul: [mir.SELECTION_WIDENING_MUL_COUNT]u32;
    mir.selection_widening_mul(?wmul[0]);
    i = 0;
    for (i < mir.SELECTION_WIDENING_MUL_COUNT) {
        probe.opcode = wmul[i];
        if (rules.find_rule(pack, ?f, ?probe) != nil) { ret 1; }
        i = i + 1;
    }

    if (x64.HAS_FLOAT) {
        var rfloat: [mir.SELECTION_REACHABLE_FLOAT_COUNT]u32;
        mir.selection_reachable_float(?rfloat[0]);
        i = 0;
        for (i < mir.SELECTION_REACHABLE_FLOAT_COUNT) {
            probe.opcode = rfloat[i];
            if (rules.find_rule(pack, ?f, ?probe) == nil) { ret 1; }
            i = i + 1;
        }
    }
    ret 0;
}
