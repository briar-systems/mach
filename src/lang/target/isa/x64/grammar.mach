    ret bad;
}

# the avx2 variable shifts against GNU as 2.47 (`as --64`, intel syntax): the
# three-byte c4 prefix of the 0F 38 map with W selecting the quadword rows,
# extended registers in each of R, vvvv and B, an extended index in X, memory
# sources, and the listing round trips
test asm_extensions__avx2_variable_shifts_match_gnu_as_and_round_trip {
    var bad: i32 = 0;
    if (!t_ext_hex("vpsllvd xmm1, xmm2, xmm3", "c4e26947cb"))                        { bad = 1; }
    if (!t_ext_hex("vpsllvd xmm9, xmm10, xmmword [r12+rax*4+16]", "c44229474c8410")) { bad = 2; }
    if (!t_ext_hex("vpsrlvd xmm0, xmm15, xmm8", "c4c20145c0"))                       { bad = 3; }
    if (!t_ext_hex("vpsrlvd xmm3, xmm4, [rbx]", "c4e259451b"))                       { bad = 4; }
    if (!t_ext_hex("vpsravd xmm10, xmm1, xmm11", "c4427146d3"))                      { bad = 5; }
    if (!t_ext_hex("vpsravd xmm4, xmm5, [rsp+8]", "c4e25146642408"))                 { bad = 6; }
    if (!t_ext_hex("vpsllvq xmm7, xmm8, xmm2", "c4e2b947fa"))                        { bad = 7; }
    if (!t_ext_hex("vpsllvq xmm12, xmm3, [rbp-16]", "c462e14765f0"))                 { bad = 8; }
    if (!t_ext_hex("vpsrlvq xmm2, xmm3, xmm13", "c4c2e145d5"))                       { bad = 9; }
    if (!t_ext_hex("vpsrlvq xmm14, xmm0, [r13]", "c442f9457500"))                    { bad = 10; }
    if (!t_ext_hex("vpsllvd xmm1, xmm2, xmmword [r8+r9*2]", "c48269470c48"))         { bad = 11; }
    ret bad;
}

# the bytes GNU as gives an operand-less body, its listing, and the listing
# assembled back to the same bytes
#[testing]
fun t_listed_hex(body: str, listed_want: str, hex: str) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var want: [32]u8;
    val n:    usize = x64_emit.t_unhex(hex, ?want[0]);
    var w:    io_writer.Writer;
    x64_printer.test_sink_writer(?w);
    var st: isa_encode.EncodeState;
    val r:  err[fail.Fail] = t_ext_run(body, 0, 0, ?st, ?alloc, ?w);
    if (sel r.err)                                { ret false; }
    if (!x64_emit.t_buf_is(?st.buf, ?want[0], n)) { ret false; }
    val listed: str = x64_printer.test_sink_text();
    if (!str_contains(listed, listed_want)) { ret false; }
    var again: isa_encode.EncodeState;
    val rr:    err[fail.Fail] = t_ext_run(listed, 0, 0, ?again, ?alloc, nil);
    if (sel rr.err) { ret false; }
    ret x64_emit.t_buf_is(?again.buf, ?want[0], n);
}

# every string instruction at every width, bare and under each prefix spelling,
# against GNU as 2.47 (`as --64`, intel syntax): 66 leads the repeat prefix and
# rex.w follows it. the listing round trips, spelling f3 as repe on a compare
test asm_string__rows_match_gnu_as_and_round_trip {
    var bad: i32 = 0;
    if (!t_listed_hex("movsb", "movsb", "a4"))                 { bad = 1; }
    if (!t_listed_hex("movsw", "movsw", "66a5"))               { bad = 2; }
    if (!t_listed_hex("movsd", "movsd", "a5"))                 { bad = 3; }
    if (!t_listed_hex("movsq", "movsq", "48a5"))               { bad = 4; }
    if (!t_listed_hex("stosb", "stosb", "aa"))                 { bad = 5; }
    if (!t_listed_hex("stosw", "stosw", "66ab"))               { bad = 6; }
    if (!t_listed_hex("stosd", "stosd", "ab"))                 { bad = 7; }
    if (!t_listed_hex("stosq", "stosq", "48ab"))               { bad = 8; }
    if (!t_listed_hex("lodsb", "lodsb", "ac"))                 { bad = 9; }
    if (!t_listed_hex("lodsw", "lodsw", "66ad"))               { bad = 10; }
    if (!t_listed_hex("lodsd", "lodsd", "ad"))                 { bad = 11; }
    if (!t_listed_hex("lodsq", "lodsq", "48ad"))               { bad = 12; }
    if (!t_listed_hex("cmpsb", "cmpsb", "a6"))                 { bad = 13; }
    if (!t_listed_hex("cmpsw", "cmpsw", "66a7"))               { bad = 14; }
    if (!t_listed_hex("cmpsd", "cmpsd", "a7"))                 { bad = 15; }
    if (!t_listed_hex("cmpsq", "cmpsq", "48a7"))               { bad = 16; }
    if (!t_listed_hex("scasb", "scasb", "ae"))                 { bad = 17; }
    if (!t_listed_hex("scasw", "scasw", "66af"))               { bad = 18; }
    if (!t_listed_hex("scasd", "scasd", "af"))                 { bad = 19; }
    if (!t_listed_hex("scasq", "scasq", "48af"))               { bad = 20; }
    if (!t_listed_hex("rep movsb", "rep movsb", "f3a4"))       { bad = 21; }
    if (!t_listed_hex("rep movsw", "rep movsw", "66f3a5"))     { bad = 22; }
    if (!t_listed_hex("rep movsd", "rep movsd", "f3a5"))       { bad = 23; }
    if (!t_listed_hex("rep movsq", "rep movsq", "f348a5"))     { bad = 24; }
    if (!t_listed_hex("rep stosb", "rep stosb", "f3aa"))       { bad = 25; }
    if (!t_listed_hex("rep stosw", "rep stosw", "66f3ab"))     { bad = 26; }
    if (!t_listed_hex("rep stosq", "rep stosq", "f348ab"))     { bad = 27; }
    if (!t_listed_hex("rep lodsb", "rep lodsb", "f3ac"))       { bad = 28; }
    if (!t_listed_hex("rep lodsq", "rep lodsq", "f348ad"))     { bad = 29; }
    if (!t_listed_hex("repe cmpsb", "repe cmpsb", "f3a6"))     { bad = 30; }
    if (!t_listed_hex("repz cmpsq", "repe cmpsq", "f348a7"))   { bad = 31; }
    if (!t_listed_hex("repne cmpsb", "repne cmpsb", "f2a6"))   { bad = 32; }
    if (!t_listed_hex("repnz cmpsw", "repne cmpsw", "66f2a7")) { bad = 33; }
    if (!t_listed_hex("repe scasb", "repe scasb", "f3ae"))     { bad = 34; }
    if (!t_listed_hex("repne scasd", "repne scasd", "f2af"))   { bad = 35; }
    if (!t_listed_hex("repne scasq", "repne scasq", "f248af")) { bad = 36; }
    ret bad;
}

# a compare repeats under a condition and nothing else does, and the explicit
# operand spelling is not a form this table holds
test asm_string__refuses_prefixes_outside_the_form {
    var bad: i32 = 0;
    if (!t_asm_refused("rep cmpsb", "spell the condition it stops on, repe or repne"))      { bad = bad + 1; }
    if (!t_asm_refused("rep scasq", "spell the condition it stops on, repe or repne"))      { bad = bad + 2; }
    if (!t_asm_refused("repe movsb", "repeat it with rep"))                                 { bad = bad + 4; }
    if (!t_asm_refused("repne stosq", "repeat it with rep"))                                { bad = bad + 8; }
    if (!t_asm_refused("rep mov rax, rcx", "unknown x86_64 inline-asm instruction"))        { bad = bad + 16; }
    if (!t_asm_refused("movsb byte [rdi], [rsi]", "unknown x86_64 inline-asm instruction")) { bad = bad + 32; }
    if (!t_asm_refused("stosb al", "unknown x86_64 inline-asm instruction"))                { bad = bad + 64; }
    ret bad;
}

# each row clobbers the registers it steps, and a repeat prefix adds its count
test asm_string__clobbers_are_the_implicit_registers {
    val a: u32 = 1::u32 << isa_inst.regid_index(x64.RAX)::u32;
    val c: u32 = 1::u32 << isa_inst.regid_index(x64.RCX)::u32;
    val s: u32 = 1::u32 << isa_inst.regid_index(x64.RSI)::u32;
    val d: u32 = 1::u32 << isa_inst.regid_index(x64.RDI)::u32;
    if (!t_clobbers_are("movsq", s | d, 0))          { ret 1; }
    if (!t_clobbers_are("rep movsb", s | d | c, 0))  { ret 2; }
    if (!t_clobbers_are("rep stosq", d | c, 0))      { ret 3; }
    if (!t_clobbers_are("lodsw", a | s, 0))          { ret 4; }
    if (!t_clobbers_are("repe cmpsd", s | d | c, 0)) { ret 5; }
    if (!t_clobbers_are("repne scasb", d | c, 0))    { ret 6; }
    ret 0;
}

# a repeated string instruction is refused on any secret it reads: a count, an
# address it loads secret memory through, or a value it stores. a public count
# storing public data into secret memory is admitted, a single step keeps its
# address registers public, and a secret address is refused as one
test asm_ct_scan__repeated_strings_refuse_secret_data {
    var alloc: A.Allocator;
    page.make(?alloc);
    var binds: [2]ct.AsmSecret;
    binds[0] = ct.asm_secret_pointee("p");
    binds[1] = ct.asm_secret_value("k");
    val none: ct.CtMulMask = ct.mul_mask_none();
    var bad:  i32          = 0;

    if (isa_asm.t_scan_refused(grammar, "mov rdi, {p}\nmov rcx, 32\nxor eax, eax\nrep stosb", ?binds[0], 2, none, false)) { bad = bad + 1; }
    val count: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "mov rcx, {k}\nrep movsb", ?binds[0], 2, none, false);
    if (sel count.err) {
        if (!str_contains(count.err.message, "variable-latency")) { bad = bad + 2; }
    }
    or                                                                                                        { bad = bad + 2; }
    if (!isa_asm.t_scan_refused(grammar, "mov rsi, {p}\nmov rcx, 32\nrep movsb", ?binds[0], 2, none, false))  { bad = bad + 4; }
    if (!isa_asm.t_scan_refused(grammar, "mov rdi, {p}\nmov rcx, 32\nrepe cmpsb", ?binds[0], 2, none, false)) { bad = bad + 8; }
    if (!isa_asm.t_scan_refused(grammar, "mov rax, {k}\nmov rcx, 32\nrep stosq", ?binds[0], 2, none, false))  { bad = bad + 16; }
    if (isa_asm.t_scan_refused(grammar, "mov rsi, {p}\nlodsb\nlodsb\nmovsb", ?binds[0], 2, none, false))      { bad = bad + 32; }
    if (!isa_asm.t_scan_refused(grammar, "mov rsi, {p}\nlodsq\nmov rcx, [rax]", ?binds[0], 2, none, false))   { bad = bad + 64; }
    val addr: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "mov rsi, {k}\nmovsb", ?binds[0], 2, none, false);
    if (sel addr.err) {
        if (!str_contains(addr.err.message, "addresses memory with a secret value")) { bad = bad + 128; }
    }
    or { bad = bad + 128; }
    ret bad;
}

# movq between a vector register and a 64-bit general register, and the byte
# and quadword shifts by an immediate and, for psllq and psrlq, by a vector
# register or memory, against GNU as 2.47 (`as --64`, intel syntax), low and
# high registers each, and the listing round trips
test asm_sse2_moves_and_shifts__rows_match_gnu_as_and_round_trip {
    var bad: i32 = 0;
    if (!t_ext_hex("movq xmm1, rax", "66480f6ec8"))               { bad = 1; }
    if (!t_ext_hex("movq xmm9, r10", "664d0f6eca"))               { bad = 2; }
    if (!t_ext_hex("movq xmm0, r15", "66490f6ec7"))               { bad = 3; }
    if (!t_ext_hex("movq rax, xmm1", "66480f7ec8"))               { bad = 4; }
    if (!t_ext_hex("movq r11, xmm13", "664d0f7eeb"))              { bad = 5; }
    if (!t_ext_hex("pslldq xmm1, 8", "660f73f908"))               { bad = 6; }
    if (!t_ext_hex("pslldq xmm12, 4", "66410f73fc04"))            { bad = 7; }
    if (!t_ext_hex("psrldq xmm2, 8", "660f73da08"))               { bad = 8; }
    if (!t_ext_hex("psrldq xmm15, 15", "66410f73df0f"))           { bad = 9; }
    if (!t_ext_hex("psllq xmm3, 1", "660f73f301"))                { bad = 10; }
    if (!t_ext_hex("psllq xmm10, 63", "66410f73f23f"))            { bad = 11; }
    if (!t_ext_hex("psrlq xmm4, 63", "660f73d43f"))               { bad = 12; }
    if (!t_ext_hex("psrlq xmm11, 32", "66410f73d320"))            { bad = 13; }
    if (!t_ext_hex("psllq xmm1, xmm2", "660ff3ca"))               { bad = 14; }
    if (!t_ext_hex("psllq xmm9, xmm14", "66450ff3ce"))            { bad = 15; }
    if (!t_ext_hex("psllq xmm5, xmmword [rax+16]", "660ff36810")) { bad = 16; }
    if (!t_ext_hex("psrlq xmm6, xmm7", "660fd3f7"))               { bad = 17; }
    if (!t_ext_hex("psrlq xmm8, [r12]", "66450fd30424"))          { bad = 18; }
    ret bad;
}

# movq moves only between a vector register and a 64-bit general register,
# and a byte shift counts only by an immediate
test asm_sse2_moves_and_shifts__refuse_operands_outside_the_form {
    var bad: i32 = 0;
    if (!t_asm_refused("movq xmm1, eax", "64-bit general register"))    { bad = bad + 1; }
    if (!t_asm_refused("movq xmm1, xmm2", "64-bit general register"))   { bad = bad + 2; }
    if (!t_asm_refused("movq xmm1, [rax]", "64-bit general register"))  { bad = bad + 4; }
    if (!t_asm_refused("movq rax, rcx", "64-bit general register"))     { bad = bad + 8; }
    if (!t_asm_refused("pslldq xmm1, xmm2", "immediate from 0 to 255")) { bad = bad + 16; }
    if (!t_asm_refused("psrldq xmm1, 256", "immediate from 0 to 255"))  { bad = bad + 32; }
    if (!t_asm_refused("psllq rax, 1", "immediate from 0 to 255"))      { bad = bad + 64; }
    ret bad;
}

# the destination is the one register each row writes, in its own bank
test asm_sse2_moves_and_shifts__clobbers_are_the_destination {
    if (!t_clobbers_are("movq xmm3, rax", 0, 0x8))                                        { ret 1; }
    if (!t_clobbers_are("movq r9, xmm3", 1::u32 << isa_inst.regid_index(x64.R9)::u32, 0)) { ret 2; }
    if (!t_clobbers_are("pslldq xmm4, 8\npsrlq xmm5, xmm0", 0, 0x30))                     { ret 3; }
    ret 0;
}

test asm_extensions__avx2_variable_shift_operands_are_refused {
    t_model.extensions = extension_x64.AVX2;
    var bad: i32 = 0;
    if (!t_asm_refused("vpsllvd xmm0, xmm1", "a vector register or 128-bit memory source"))              { bad = 1; }
    if (!t_asm_refused("vpsllvd xmm0, [rax], xmm1", "a vector register or 128-bit memory source"))       { bad = 2; }
    if (!t_asm_refused("vpsllvd [rax], xmm0, xmm1", "a vector register or 128-bit memory source"))       { bad = 3; }
    if (!t_asm_refused("vpsllvd xmm0, xmm1, rax", "a vector register or 128-bit memory source"))         { bad = 4; }
    if (!t_asm_refused("vpsllvd xmm0, xmm1, qword [rax]", "a vector register or 128-bit memory source")) { bad = 5; }
    if (!t_asm_refused("vpsrlvq xmm0, xmm1, xmm2, 1", "a vector register or 128-bit memory source"))     { bad = 6; }
    t_model.extensions = 0;
    ret bad;
}

# vpmullq against GNU as 2.47 (`as --64`, intel syntax): the four-byte evex
# prefix of the 0F 38 map under W1, extended registers in each of R, vvvv, X
# and B, and the memory form's disp8*16, compressed where the displacement is
# a multiple of 16 whose quotient fits the byte and 32 bits wide otherwise;
# the listing round trips
test asm_extensions__vpmullq_matches_gnu_as_and_round_trips {
    var bad: i32 = 0;
    if (!t_ext_hex("vpmullq xmm1, xmm2, xmm3", "62f2ed0840cb"))                         { bad = 1; }
    if (!t_ext_hex("vpmullq xmm9, xmm10, xmm11", "6252ad0840cb"))                       { bad = 2; }
    if (!t_ext_hex("vpmullq xmm0, xmm15, xmm8", "62d2850840c0"))                        { bad = 3; }
    if (!t_ext_hex("vpmullq xmm1, xmm2, [rax]", "62f2ed084008"))                        { bad = 4; }
    if (!t_ext_hex("vpmullq xmm1, xmm2, xmmword [rbp-32]", "62f2ed08404dfe"))           { bad = 5; }
    if (!t_ext_hex("vpmullq xmm1, xmm2, xmmword [rbp-8]", "62f2ed08408df8ffffff"))      { bad = 6; }
    if (!t_ext_hex("vpmullq xmm1, xmm2, xmmword [rsp+2032]", "62f2ed08404c247f"))       { bad = 7; }
    if (!t_ext_hex("vpmullq xmm1, xmm2, xmmword [rsp+2048]", "62f2ed08408c2400080000")) { bad = 8; }
    if (!t_ext_hex("vpmullq xmm12, xmm3, xmmword [r12+r13*8+48]", "6212e5084064ec03"))  { bad = 9; }
    if (!t_ext_hex("vpmullq xmm1, xmm2, [r13]", "62d2ed08404d00"))                      { bad = 10; }
    ret bad;
}

test asm_extensions__vpmullq_needs_avx512dq_and_avx512vl {
    if (!t_ext_refusal("vpmullq xmm0, xmm1, xmm2", extension_x64.AVX2, 0, "needs the `avx512dq` extension"))                         { ret 1; }
    if (!t_ext_refusal("vpmullq xmm0, xmm1, xmm2", extension_x64.AVX512DQ, 0, "needs the `avx512vl` extension"))                     { ret 2; }
    if (!t_ext_refusal("vpmullq xmm0, xmm1, xmm2", extension_x64.AVX512VL, extension_x64.AVX512F, "needs the `avx512dq` extension")) { ret 3; }
    if (!t_ext_admitted("vpmullq xmm0, xmm1, xmm2", extension_x64.LEVEL_V4, 0))                                                      { ret 4; }
    if (!t_asm_refused("vpmullq xmm0, [rax], xmm1", "a vector register or 128-bit memory source"))                                   { ret 5; }
    if (!t_asm_refused("vpmullq xmm0, xmm1, qword [rax]", "a vector register or 128-bit memory source"))                             { ret 6; }
    ret 0;
}

# a symbol-relative source keeps its rip-relative field ahead of the immediate
test asm_extensions__symbol_sources_relocate_before_the_immediate {
    t_model.extensions = T_EXT_ALL;
    var bad: i32 = 0;
    if (!t_asm_reloc("pshufb xmm1, [tbl]", "660f38000d00000000", 5, -4))          { bad = 1; }
    if (!t_asm_reloc("pinsrd xmm1, [tbl], 3", "660f3a220d0000000003", 5, -5))     { bad = 2; }
    if (!t_asm_reloc("pextrd [tbl], xmm1, 3", "660f3a160d0000000003", 5, -5))     { bad = 3; }
    if (!t_asm_reloc("aesenc xmm1, [tbl]", "660f38dc0d00000000", 5, -4))          { bad = 4; }
    if (!t_asm_reloc("pclmulqdq xmm1, [tbl], 1", "660f3a440d0000000001", 5, -5))  { bad = 5; }
    if (!t_asm_reloc("vpsllvd xmm1, xmm2, [tbl]", "c4e269470d00000000", 5, -4))   { bad = 6; }
    if (!t_asm_reloc("vpmullq xmm1, xmm2, [tbl]", "62f2ed08400d00000000", 6, -4)) { bad = 7; }
    t_model.extensions = 0;
    ret bad;
}

#[testing]
fun t_ext_refusal(body: str, exts: u64, f_exts: u64, want: str) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: isa_encode.EncodeState;
    val r:  err[fail.Fail] = t_ext_run(body, exts, f_exts, ?st, ?alloc, nil);
    if (!sel r.err) { ret false; }
    ret str_contains(fail.describe(r.err), want) && st.buf.bytes.len == 0;
}

#[testing]
fun t_ext_admitted(body: str, exts: u64, f_exts: u64) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: isa_encode.EncodeState;
    val r:  err[fail.Fail] = t_ext_run(body, exts, f_exts, ?st, ?alloc, nil);
    ret sel r.ok && st.buf.bytes.len > 0;
}

#[testing]
val T_EXT_BODY_COUNT: usize = 29;

#[testing]
val T_EXT_BODIES: [T_EXT_BODY_COUNT]str = [T_EXT_BODY_COUNT]str{
    "sha256rnds2 xmm1, xmm2", "sha256msg1 xmm1, xmm2", "sha256msg2 xmm1, xmm2",
    "pshufb xmm1, xmm2", "palignr xmm1, xmm2, 1", "pblendw xmm1, xmm2, 1",
    "pinsrd xmm1, eax, 1", "pextrd eax, xmm1, 1", "ptest xmm1, xmm2",
    "rdfsbase rax", "rdgsbase r9d", "wrfsbase ecx", "wrgsbase r15",
    "popcnt rax, rcx", "lzcnt eax, [rdi]", "tzcnt r9, r10",
    "aesenc xmm1, xmm2", "aesenclast xmm1, [rax]", "aesdec xmm1, xmm2", "aesdeclast xmm1, xmm2",
    "aesimc xmm1, xmm2", "aeskeygenassist xmm1, xmm2, 1", "pclmulqdq xmm1, xmm2, 0x11",
    "vpsllvd xmm1, xmm2, xmm3", "vpsrlvd xmm1, xmm2, [rax]", "vpsravd xmm1, xmm2, xmm3", "vpsllvq xmm1, xmm2, xmm3",
    "vpsrlvq xmm1, xmm2, xmm3", "vpmullq xmm1, xmm2, [rax]",
};

#[testing]
val T_EXT_NEEDS: [T_EXT_BODY_COUNT]u64 = [T_EXT_BODY_COUNT]u64{
    extension_x64.SHA, extension_x64.SHA, extension_x64.SHA,
    extension_x64.SSSE3, extension_x64.SSSE3, extension_x64.SSE41,
    extension_x64.SSE41, extension_x64.SSE41, extension_x64.SSE41,
    extension_x64.FSGSBASE, extension_x64.FSGSBASE, extension_x64.FSGSBASE, extension_x64.FSGSBASE,
    extension_x64.POPCNT, extension_x64.LZCNT, extension_x64.BMI1,
    extension_x64.AES, extension_x64.AES, extension_x64.AES, extension_x64.AES,
    extension_x64.AES, extension_x64.AES, extension_x64.PCLMUL,
    extension_x64.AVX2, extension_x64.AVX2, extension_x64.AVX2, extension_x64.AVX2,
    extension_x64.AVX2, extension_x64.AVX512DQ | extension_x64.AVX512VL,
};

# a row whose extension neither the target nor the enclosing function admits is
# refused before a byte is written, naming the manifest line and the decorator
test asm_extensions__an_unselected_extension_is_refused_unless_the_function_admits_it {
    if (!t_ext_refusal("sha256rnds2 xmm1, xmm2", 0, 0,
        "inline-asm instruction 'sha256rnds2' needs the `sha` extension, which this target does not select; add `extensions = [\"sha\"]` to the target, or mark the function `#[extensions(sha)]` and call it only after detecting the extension at run time")) { ret 1; }
    if (!t_ext_refusal("pshufb xmm0, xmm1", extension_x64.SHA, extension_x64.SSE41, "needs the `ssse3` extension")) { ret 2; }
    if (!t_ext_refusal("ptest xmm0, xmm1", extension_x64.SSSE3, 0, "#[extensions(sse41)]"))                         { ret 3; }
    if (!t_ext_admitted("cpuid\npxor xmm0, xmm0", 0, 0))                                                            { ret 4; }
    if (!t_ext_refusal("wrgsbase rax", 0, extension_x64.SHA,
        "inline-asm instruction 'wrgsbase' needs the `fsgsbase` extension, which this target does not select; add `extensions = [\"fsgsbase\"]` to the target, or mark the function `#[extensions(fsgsbase)]` and call it only after detecting the extension at run time")) { ret 5; }
    if (!t_ext_refusal("aesenc xmm0, xmm1", 0, 0,
        "inline-asm instruction 'aesenc' needs the `aes` extension, which this target does not select; add `extensions = [\"aes\"]` to the target, or mark the function `#[extensions(aes)]` and call it only after detecting the extension at run time")) { ret 6; }
    if (!t_ext_refusal("pclmulqdq xmm0, xmm1, 0", extension_x64.AES, 0,
        "inline-asm instruction 'pclmulqdq' needs the `pclmul` extension, which this target does not select; add `extensions = [\"pclmul\"]` to the target, or mark the function `#[extensions(pclmul)]` and call it only after detecting the extension at run time")) { ret 7; }
    if (!t_ext_refusal("aeskeygenassist xmm0, xmm1, 1", extension_x64.PCLMUL, extension_x64.SHA, "#[extensions(aes)]")) { ret 8; }
    var i: usize = 0;
    for (i < T_EXT_BODY_COUNT) {
        val body: str = T_EXT_BODIES[i];
        val need: u64 = T_EXT_NEEDS[i];
        if (!t_ext_refusal(body, 0, 0, "needs the `"))                 { ret 20 + i::i32; }
        if (!t_ext_refusal(body, T_EXT_ALL & ~need, 0, "needs the `")) { ret 40 + i::i32; }
        if (!t_ext_admitted(body, need, 0))                            { ret 60 + i::i32; }
        if (!t_ext_admitted(body, 0, need))                            { ret 80 + i::i32; }
        i = i + 1;
    }
    ret 0;
}

test asm_extensions__malformed_operands_are_refused {
    if (!t_asm_refused("pinsrd xmm0, rax, 1", "a 32-bit register or memory"))               { ret 1; }
    if (!t_asm_refused("pinsrd xmm0, eax", "a 32-bit register or memory"))                  { ret 2; }
    if (!t_asm_refused("pinsrd eax, xmm0, 1", "a 32-bit register or memory"))               { ret 3; }
    if (!t_asm_refused("pextrd xmm0, eax, 1", "a 32-bit register or memory"))               { ret 4; }
    if (!t_asm_refused("pinsrd xmm0, eax, 256", "an immediate from 0 to 255"))              { ret 5; }
    if (!t_asm_refused("pextrd qword [rax], xmm0, 1", "a 32-bit register or memory"))       { ret 6; }
    if (!t_asm_refused("pinsrd xmm0, xmm1, 1", "a 32-bit register or memory"))              { ret 7; }
    if (!t_asm_refused("sha256msg1 xmm0, rax", "takes a vector register or memory source")) { ret 8; }
    if (!t_asm_refused("palignr xmm0, xmm1", "8-bit immediate"))                            { ret 9; }
    t_model.extensions = extension_x64.AES | extension_x64.PCLMUL;
    var bad: i32 = 0;
    if (!t_asm_refused("aesenc xmm0, rax", "takes a vector register or memory source")) { bad = 10; }
    if (!t_asm_refused("aesimc rax, xmm0", "vector register"))                          { bad = 11; }
    if (!t_asm_refused("aeskeygenassist xmm0, xmm1", "8-bit immediate"))                { bad = 12; }
    if (!t_asm_refused("pclmulqdq xmm0, xmm1", "8-bit immediate"))                      { bad = 13; }
    if (!t_asm_refused("pclmulqdq xmm0, xmm1, 256", "an immediate from 0 to 255"))      { bad = 14; }
    if (!t_asm_refused("aesenc xmm0, xmm1, 1", "expects two operands"))                 { bad = 15; }
    t_model.extensions = 0;
    if (bad != 0) { ret bad; }
    ret 0;
}

#[testing]
fun t_clobbers_are(body: str, gp: u32, fp: u32) bool {
    var got_gp: u32 = 0;
    var got_fp: u32 = 0;
    isa_asm.clobbers(grammar, body, ?got_gp, ?got_fp);
    ret got_gp == gp && got_fp == fp;
}

# cpuid writes eax, ebx, ecx and edx; each row clobbers exactly its destination
test asm_extensions__clobbers_are_the_destinations {
    val a: u32 = 1::u32 << isa_inst.regid_index(x64.RAX)::u32;
    val b: u32 = 1::u32 << isa_inst.regid_index(x64.RBX)::u32;
    val c: u32 = 1::u32 << isa_inst.regid_index(x64.RCX)::u32;
    val d: u32 = 1::u32 << isa_inst.regid_index(x64.RDX)::u32;
    if (!t_clobbers_are("cpuid", a | b | c | d, 0))                                                       { ret 1; }
    if (!t_clobbers_are("pextrd r11d, xmm1, 0", 1::u32 << isa_inst.regid_index(x64.R11)::u32, 0))         { ret 2; }
    if (!t_clobbers_are("pextrd [rax], xmm1, 0", 0, 0))                                                   { ret 3; }
    if (!t_clobbers_are("pinsrd xmm3, eax, 0", 0, 0x8))                                                   { ret 4; }
    if (!t_clobbers_are("ptest xmm0, xmm1", 0, 0))                                                        { ret 5; }
    if (!t_clobbers_are("sha256rnds2 xmm4, xmm0\nsha256msg1 xmm5, xmm0\nsha256msg2 xmm6, xmm0", 0, 0x70)) { ret 6; }
    if (!t_clobbers_are("pshufb xmm7, xmm0\npalignr xmm8, xmm0, 1\npblendw xmm9, xmm0, 2", 0, 0x380))     { ret 7; }
    val aes: str = "aesenc xmm1, xmm0\naesenclast xmm2, xmm0\naesdec xmm3, xmm0\naesdeclast xmm4, xmm0\naesimc xmm5, xmm0\naeskeygenassist xmm6, xmm0, 1";
    if (!t_clobbers_are(aes, 0, 0x7E))                         { ret 8; }
    if (!t_clobbers_are("pclmulqdq xmm10, xmm0, 0", 0, 0x400)) { ret 9; }
    ret 0;
}

# a secret flows through the rows as the ct scan models them: into sha256rnds2
# through its unnamed xmm0, out of pextrd into an address, and through cpuid
test asm_ct_scan__extension_rows_carry_secrets {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    val none: ct.CtMulMask = ct.mul_mask_none();

    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm0, {k}\nsha256rnds2 xmm1, xmm2\nptest xmm1, xmm1\nje 1f\n1:\nnop", ?names[0], 1, none, false)) { ret 1; }
    if (isa_asm.t_scan_refused(grammar, "movdqu xmm3, {k}\nsha256rnds2 xmm1, xmm2\nptest xmm1, xmm1\nje 1f\n1:\nnop", ?names[0], 1, none, false))  { ret 2; }
    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm2, {k}\npextrd eax, xmm2, 1\nmov rcx, [rax]", ?names[0], 1, none, false))                      { ret 3; }
    if (!isa_asm.t_scan_refused(grammar, "mov rax, {k}\ncpuid\nmov rsi, [rbx]", ?names[0], 1, none, false))                                        { ret 4; }
    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm2, {k}\nptest xmm2, xmm2\nje 1f\n1:\nnop", ?names[0], 1, none, false))                         { ret 5; }
    ret 0;
}

# a secret key and state run through every aes row and the carry-less multiply
# and are admitted: the rows are data-independent. the result stays secret, so
# an address or a branch built from it is still refused
test asm_ct_scan__aes_and_pclmul_rows_admit_secrets_and_keep_them {
    var alloc: A.Allocator;
    page.make(?alloc);
    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");
    val none: ct.CtMulMask = ct.mul_mask_none();

    val rounds: str = "movdqu xmm0, {k}\nmovdqu xmm1, {k}\naesenc xmm1, xmm0\naesenclast xmm1, xmm0\naesdec xmm1, xmm0\naesdeclast xmm1, xmm0\naesimc xmm2, xmm1\naeskeygenassist xmm3, xmm2, 0x36\npclmulqdq xmm3, xmm0, 0x11\nmovdqu [rdi], xmm3";
    if (isa_asm.t_scan_refused(grammar, rounds, ?names[0], 1, none, false))                                                                                  { ret 1; }
    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm0, {k}\naesenc xmm1, xmm0\npextrd eax, xmm1, 0\nmov rcx, [rax]", ?names[0], 1, none, false))             { ret 2; }
    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm0, {k}\npclmulqdq xmm1, xmm0, 0\nptest xmm1, xmm1\nje 1f\n1:\nnop", ?names[0], 1, none, false))          { ret 3; }
    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm0, {k}\naeskeygenassist xmm1, xmm0, 1\npextrd eax, xmm1, 0\nmov rcx, [rax]", ?names[0], 1, none, false)) { ret 4; }
    ret 0;
}

# the indirect call and jump forms, register and memory, direct symbol targets, and the refused spellings
test x64_xfer_target__indirect_forms_byte_exact {
    var bad: i32 = 0;
    if (!t_asm_hex("call [0x100018]", "ff142518001000"))   { bad = 1; }
    if (!t_asm_hex("call rax", "ffd0"))                    { bad = 2; }
    if (!t_asm_hex("call r11", "41ffd3"))                  { bad = 3; }
    if (!t_asm_hex("call [rax]", "ff10"))                  { bad = 4; }
    if (!t_asm_hex("call [rax + 8]", "ff5008"))            { bad = 5; }
    if (!t_asm_hex("call [rax + rbx*8 + 16]", "ff54d810")) { bad = 6; }
    if (!t_asm_hex("jmp rax", "ffe0"))                     { bad = 7; }
    if (!t_asm_hex("jmp r11", "41ffe3"))                   { bad = 8; }
    if (!t_asm_hex("jmp [rax + rbx*8 + 16]", "ff64d810"))  { bad = 9; }
    if (!t_asm_hex("jmp [0x100018]", "ff242518001000"))    { bad = 10; }

    if (!t_asm_refused("call [main]", "symbol"))               { bad = 11; }
    if (!t_asm_refused("call eax", "64-bit"))                  { bad = 12; }
    if (!t_asm_refused("call [0x100000000]", "32-bit"))        { bad = 13; }
    if (!t_asm_refused("call [0x100018 + 8]", "displacement")) { bad = 14; }
    if (!t_asm_refused("jmp eax", "64-bit register"))          { bad = 15; }
    if (!t_asm_refused("jmp [main]", "symbol's address"))      { bad = 16; }

    var g: isa_asm.Grammar = grammar();
    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, "call main\njmp main", nil, nil, nil, nil);
    var item: isa_asm.Item;
    val rc:   res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel rc.err)                 { ret 20; }
    if (item.ref != isa_asm.AR_SYM) { ret 21; }
    val dc: isa_inst.Inst = build(?item, intern.str_id(7));
    if (dc.opcode != x64.CALL || (dc.flags & x64_inst.FLAG_INDIRECT::u16) != 0) { ret 22; }
    if (dc.dst.kind != isa_inst.OPK_SYM || dc.dst.sym_id != 7)                  { ret 23; }
    val rj: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel rj.err)                 { ret 24; }
    if (item.ref != isa_asm.AR_SYM) { ret 25; }
    val dj: isa_inst.Inst = build(?item, intern.str_id(9));
    if (dj.opcode != x64.JMP || (dj.flags & x64_inst.FLAG_INDIRECT::u16) != 0) { ret 26; }
    if (dj.dst.kind != isa_inst.OPK_SYM || dj.dst.sym_id != 9)                 { ret 27; }
    ret bad;
}

test asm_clobbers__indirect_call_is_not_opaque {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    isa_asm.clobbers(grammar, "call rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    isa_asm.clobbers(grammar, "call [0x100018]", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    isa_asm.clobbers(grammar, ".byte 0xff, 0x14, 0x25, 0x18, 0x00, 0x10, 0x00", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP) { bad = 1; }
    if (fp != x64_mnemonic.ALL_FP) { bad = 1; }

    ret bad;
}

test parse_data__sequence_is_not_an_operand_list {
    var bad: i32 = 0;

    var want: [7]u8;
    want[0] = 0xFF;
    want[1] = 0x14;
    want[2] = 0x25;
    want[3] = 0x18;
    want[4] = 0x00;
    want[5] = 0x10;
    want[6] = 0x00;
    if (!t_asm_bytes(".byte 0xff, 0x14, 0x25, 0x18, 0x00, 0x10, 0x00", ?want[0], 7)) { bad = 1; }

    var one: [1]u8;
    one[0] = 0x90;
    if (!t_asm_bytes(".byte 0x90", ?one[0], 1)) { bad = 1; }
    var neg: [1]u8;
    neg[0] = 0xFF;
    if (!t_asm_bytes(".byte -1", ?neg[0], 1)) { bad = 1; }

    if (!t_asm_refused(".byte 0x1ff", "cannot hold")) { bad = 1; }
    if (!t_asm_refused(".byte -129", "cannot hold"))  { bad = 1; }
    if (!t_asm_refused(".byte", "unknown"))           { bad = 1; }
    if (!t_asm_refused(".byte ,", "value"))           { bad = 1; }

    if (!t_asm_refused("mov rax, rbx, rcx, rdx, rsi", "too many operands")) { bad = 1; }

    ret bad;
}

test parse_data__gnu_as_widths {
    var bad: i32 = 0;

    var w: [2]u8;
    w[0] = 0x34;
    w[1] = 0x12;
    if (!t_asm_bytes(".word 0x1234", ?w[0], 2))         { bad = 1; }
    if (!t_asm_refused(".word 0x10000", "cannot hold")) { bad = 1; }

    var l: [4]u8;
    l[0] = 0x78;
    l[1] = 0x56;
    l[2] = 0x34;
    l[3] = 0x12;
    if (!t_asm_bytes(".long 0x12345678", ?l[0], 4)) { bad = 1; }

    var q: [8]u8;
    var i: usize = 0;
    for (i < 8) {
        q[i] = 0xFF;
        i    = i + 1;
    }
    if (!t_asm_bytes(".quad 0xFFFFFFFFFFFFFFFF", ?q[0], 8)) { bad = 1; }

    var n: [2]u8;
    n[0] = 0xFF;
    n[1] = 0xFF;
    if (!t_asm_bytes(".word -1", ?n[0], 2))            { bad = 1; }
    if (!t_asm_refused(".word -32769", "cannot hold")) { bad = 1; }

    var mix: [7]u8;
    mix[0] = 0x90;
    mix[1] = 0x34;
    mix[2] = 0x12;
    mix[3] = 0x78;
    mix[4] = 0x56;
    mix[5] = 0x34;
    mix[6] = 0x12;
    if (!t_asm_bytes(".byte 0x90\n.word 0x1234\n.long 0x12345678", ?mix[0], 7)) { bad = 1; }

    ret bad;
}

test x64_call_target__long_symbol_operand {
    var bad: i32 = 0;

    var alloc1: A.Allocator;
    page.make(?alloc1);
    var itn1: intern.Interner = intern.init(?alloc1);
    var st1:  isa_encode.EncodeState;
    st1.alloc    = ?alloc1;
    st1.buf      = isa_encode.buf_init(?alloc1);
    st1.interner = ?itn1;
    var g1:      isa_asm.Grammar = grammar();
    var labels1: isa_asm.Labels;
    isa_asm.labels_init(?labels1, ?alloc1);
    var c1: isa_asm.Cursor;
    isa_asm.cursor_init(?c1, ?g1, "lea rax, [short_sym]", ?alloc1, ?itn1, nil, nil);
    val r1: err[fail.Fail] = isa_asm.run(?st1, ?g1, ?c1, ?labels1);
    if (sel r1.err) { bad = 1; }

    val long_name: str =
        "sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    val long_lea: str =
        "lea rax, [sym_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]";
    var alloc2: A.Allocator;
    page.make(?alloc2);
    var itn2: intern.Interner = intern.init(?alloc2);
    var st2:  isa_encode.EncodeState;
    st2.alloc    = ?alloc2;
    st2.buf      = isa_encode.buf_init(?alloc2);
    st2.interner = ?itn2;
    var g2:      isa_asm.Grammar = grammar();
    var labels2: isa_asm.Labels;
    isa_asm.labels_init(?labels2, ?alloc2);
    var c2: isa_asm.Cursor;
    isa_asm.cursor_init(?c2, ?g2, long_lea, ?alloc2, ?itn2, nil, nil);
    val r2: err[fail.Fail] = isa_asm.run(?st2, ?g2, ?c2, ?labels2);
    if (sel r2.err) { bad = 1; }

    if (st1.buf.bytes.len != st2.buf.bytes.len) { bad = 1; }
    or {
        var i: usize = 0;
        for (i < st1.buf.bytes.len) {
            if (st1.buf.bytes.data[i] != st2.buf.bytes.data[i]) { bad = 1; }
            i = i + 1;
        }
    }

    if (st2.reloc_count == 0) { bad = 1; }
    or {
        val nm: opt[str] = intern.get(?itn2, st2.relocs[st2.reloc_count - 1].sym);
        if (sel nm.some && !str_equals(nm.some, long_name)) { bad = 1; }
    }

    if (!t_asm_refused("lea rax, [rax", "malformed")) { bad = 1; }

    ret bad;
}

test x64_mem__malformed_addresses_refused {
    var alloc: A.Allocator;
    page.make(?alloc);
    var g: isa_asm.Grammar = grammar();
    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, "mov [{ptr}], rax", ?alloc, nil, nil, nil);
    var item: isa_asm.Item;
    val r:    res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (!sel r.err) { ret 1; }
    val msg: str = fail.describe(r.err);
    if (!str_contains(msg, "stack-slot binding"))                          { ret 1; }
    if (!str_contains(msg, "load it into a register first"))               { ret 1; }
    if (str_contains(msg, "malformed inline-asm two-operand instruction")) { ret 1; }

    if (!t_asm_refused("mov rax, [rbx + rsp*2]", "rsp cannot be used as an inline-asm memory index register"))           { ret 2; }
    if (!t_asm_refused("mov rax, [rbx + 99999999999]", "memory displacement does not fit a signed 32-bit displacement")) { ret 3; }
    ret 0;
}

test x64_emit__local_label_rel32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: isa_encode.EncodeState;
    st.alloc    = ?alloc;
    st.buf      = isa_encode.buf_init(?alloc);
    st.interner = nil;

    var g:      isa_asm.Grammar = grammar();
    var labels: isa_asm.Labels;
    isa_asm.labels_init(?labels, ?alloc);
    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, "", ?alloc, nil, nil, nil);

    var jm: isa_asm.Item;
    jm.kind  = isa_asm.AI_INST;
    jm.code  = x64.JMP::u32;
    jm.flags = x64_mnemonic.PATTERN_BRANCH;
    jm.nops  = 0;
    jm.ref   = isa_asm.AR_LOCAL;

    var bad: i32 = 0;

    val dr: err[fail.Fail] = isa_asm.label_record_def(?st, ?g, ?labels, 1, 0);
    if (sel dr.err) { bad = 1; }
    jm.ref_num = 1;
    jm.ref_fwd = false;
    val br: err[fail.Fail] = emit(?st, ?c, ?labels, ?jm);
    if (sel br.err)                   { bad = 1; }
    if (st.buf.bytes.len != 5)        { bad = 1; }
    or (st.buf.bytes.data[0] != 0xE9) { bad = 1; }
    or (st.buf.bytes.data[1] != 0xFB) { bad = 1; }
    or (st.buf.bytes.data[2] != 0xFF) { bad = 1; }
    or (st.buf.bytes.data[3] != 0xFF) { bad = 1; }
    or (st.buf.bytes.data[4] != 0xFF) { bad = 1; }

    jm.ref_num = 2;
    jm.ref_fwd = true;
    val fr: err[fail.Fail] = emit(?st, ?c, ?labels, ?jm);
    if (sel fr.err)              { bad = 1; }
    if (labels.fixup_count != 1) { bad = 1; }
    val dr2: err[fail.Fail] = isa_asm.label_record_def(?st, ?g, ?labels, 2, st.buf.bytes.len::u32);
    if (sel dr2.err)                  { bad = 1; }
    if (labels.fixup_count != 0)      { bad = 1; }
    or (st.buf.bytes.data[5] != 0xE9) { bad = 1; }
    or (st.buf.bytes.data[6] != 0x00) { bad = 1; }
    or (st.buf.bytes.data[7] != 0x00) { bad = 1; }
    or (st.buf.bytes.data[8] != 0x00) { bad = 1; }
    or (st.buf.bytes.data[9] != 0x00) { bad = 1; }

    jm.ref_num = 9;
    jm.ref_fwd = false;
    val ur: err[fail.Fail] = emit(?st, ?c, ?labels, ?jm);
    if (!sel ur.err) { bad = 1; }

    isa_asm.labels_dnit(?labels);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

test x64_parse__body_to_inst {
    var g: isa_asm.Grammar = grammar();
    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, "mov rax, rbx\nlock xadd [rcx], rax\nsyscall\n1:\njmp 1b", nil, nil, nil, nil);
    var item: isa_asm.Item;
    var bad:  i32 = 0;

    val first_item: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel first_item.err)           { ret 1; }
    if (item.kind != isa_asm.AI_INST) { bad = 1; }
    var mi: isa_inst.Inst = build(?item, intern.STR_NIL);
    if (mi.opcode != x64.MOV)                       { bad = 1; }
    if (mi.size != 8)                               { bad = 1; }
    if ((mi.flags & x64_inst.FLAG_REX_W::u16) == 0) { bad = 1; }
    if (mi.dst.kind != isa_inst.OPK_REG)            { bad = 1; }
    if (mi.dst.reg != x64.RAX)                      { bad = 1; }
    if (mi.src1.reg != x64.RBX)                     { bad = 1; }
    if (item.src_off != 0 || item.src_len != 12)    { bad = 1; }

    val next_item: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel next_item.err) { ret 1; }
    mi = build(?item, intern.STR_NIL);
    if (mi.opcode != x64.XADD)                     { bad = 1; }
    if ((mi.flags & x64_inst.FLAG_LOCK::u16) == 0) { bad = 1; }
    if (mi.dst.kind != isa_inst.OPK_MEM)           { bad = 1; }
    if (mi.dst.base != x64.RCX)                    { bad = 1; }
    if (mi.src1.reg != x64.RAX)                    { bad = 1; }

    val syscall_item: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel syscall_item.err)                               { ret 1; }
    if (build(?item, intern.STR_NIL).opcode != x64.SYSCALL) { bad = 1; }

    val label_item: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel label_item.err)                                 { ret 1; }
    if (item.kind != isa_asm.AI_LABEL || item.ref_num != 1) { bad = 1; }

    val jump_item: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel jump_item.err)                              { ret 1; }
    if (build(?item, intern.STR_NIL).opcode != x64.JMP) { bad = 1; }
    if (item.ref != isa_asm.AR_LOCAL)                   { bad = 1; }
    if (item.ref_num != 1 || item.ref_fwd)              { bad = 1; }

    val last: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel last.err) { ret 1; }
    if (last.ok)      { bad = 1; }

    # a label number past u32 is refused, not cut short to another label
    if (!t_asm_refused("4294967296:", "past the largest label number"))              { bad = 1; }
    if (!t_asm_refused("jmp 4294967296f", "past the largest label number"))          { bad = 1; }
    if (!t_asm_refused("je 99999999999999999999b", "past the largest label number")) { bad = 1; }
    ret bad;
}

test asm_clobbers__declared_raw_encodings {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    isa_asm.clobbers(grammar, ".byte 0xee :: writes()", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0xee", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP) { bad = 1; }
    if (fp != x64_mnemonic.ALL_FP) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0x0f, 0x31 :: writes(rax, rdx)", ?gp, ?fp);
    if (gp != 0x5) { bad = 1; }
    if (fp != 0)   { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0x90 :: writes(xmm3)", ?gp, ?fp);
    if (gp != 0)             { bad = 1; }
    if (fp != (1::u32 << 3)) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0x90 :: writes(rbx, xmm15)", ?gp, ?fp);
    if (gp != (1::u32 << 3))  { bad = 1; }
    if (fp != (1::u32 << 15)) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0xee :: writes()\n.byte 0x90", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP) { bad = 1; }
    if (fp != x64_mnemonic.ALL_FP) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "mov rdx, rcx\n.byte 0xee :: writes()", ?gp, ?fp);
    if (gp != (1::u32 << 2)) { bad = 1; }
    if (fp != 0)             { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0xee   ::   writes( rax , rdx )", ?gp, ?fp);
    if (gp != 0x5) { bad = 1; }
    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0xee :: writes() ; .byte 0x90 :: writes(rcx)", ?gp, ?fp);
    if (gp != (1::u32 << 1)) { bad = 1; }

    ret bad;
}

test declared_raw_encodings__emit_and_accounting {
    var bad: i32 = 0;

    var one: [1]u8;
    one[0] = 0xEE;
    if (!t_asm_bytes(".byte 0xee :: writes()", ?one[0], 1)) { bad = 1; }

    var two: [2]u8;
    two[0] = 0x0F;
    two[1] = 0x31;
    if (!t_asm_bytes(".byte 0x0f, 0x31 :: writes(rax, rdx)", ?two[0], 2)) { bad = 1; }

    var g: isa_asm.Grammar = grammar();
    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, ".byte 0xee :: writes(rax)", nil, nil, nil, nil);
    var item:       isa_asm.Item;
    val first_item: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel first_item.err)            { ret 1; }
    if (item.kind != isa_asm.AI_BYTES) { bad = 1; }
    if (!item.declared)                { bad = 1; }
    if (item.decl_gp != 1)             { bad = 1; }
    if (item.decl_fp != 0)             { bad = 1; }
    if (item.byte_count != 1)          { bad = 1; }

    val last: res[bool, fail.Fail] = isa_asm.next(?c, ?item);
    if (sel last.err) { ret 1; }
    if (last.ok)      { bad = 1; }

    var c2: isa_asm.Cursor;
    isa_asm.cursor_init(?c2, ?g, ".byte 0xee", nil, nil, nil, nil);
    val next_item: res[bool, fail.Fail] = isa_asm.next(?c2, ?item);
    if (sel next_item.err) { ret 1; }
    if (item.declared)     { bad = 1; }

    ret bad;
}

test declared_raw_encodings__malformed_clauses_refused {
    var bad: i32 = 0;

    if (!t_asm_refused(".byte 0x90 :: writes(nosuchreg)", "not a register on this target")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(r16)", "not a register on this target"))       { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(eax)", "not a register on this target"))       { bad = 1; }

    if (!t_asm_refused(".byte 0x90 :: writes(rax", "closing"))   { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes", "parenthesized")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 ::", "names no attribute"))   { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(rax,)", "empty"))   { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: writes(,rax)", "empty"))   { bad = 1; }

    if (!t_asm_refused(".byte 0x90 :: reads(rax)", "unknown")) { bad = 1; }
    if (!t_asm_refused(".byte 0x90 :: noreturn", "unknown"))   { bad = 1; }

    if (!t_asm_refused("mov rax, rbx :: writes()", "only a data directive")) { bad = 1; }
    if (!t_asm_refused("nop :: writes()", "only a data directive"))          { bad = 1; }
    if (!t_asm_refused("1: :: writes()", "only a data directive"))           { bad = 1; }

    ret bad;
}

# a spill, a push/pop and a pushfq/pop round trip each keep the taint they carry
test asm_ct_scan__round_trips_keep_the_taint {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val addr:    str                = "mov rax, {r}\nmov [rsp], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    var scanned: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, addr, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, addr, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 2; }

    val lat: str = "mov rax, {r}\nmov [rsp], rax\nmov rcx, [rsp]\nshl rdx, cl";
    scanned = isa_asm.ct_scan(grammar, lat, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 4; }
    scanned = isa_asm.ct_scan(grammar, lat, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }

    val br: str = "mov rax, {r}\nmov [rsp], rax\nmov rbx, [rsp]\ncmp rbx, 1\njz 1f\n1:\nnop";
    scanned = isa_asm.ct_scan(grammar, br, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 16; }
    scanned = isa_asm.ct_scan(grammar, br, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 32; }

    val pub: str = "mov [rsp], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    scanned = isa_asm.ct_scan(grammar, pub, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 64; }

    val opaque: str = "mov rax, {r}\nmov [rdx + rsi * 8], rax\nmov rbx, [rsp]\nmov rcx, [rbx]";
    scanned = isa_asm.ct_scan(grammar, opaque, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 128; }

    # a push/pop round trip carries a register's taint, and pushfq/pop the flags'
    val leak: str = "mov rax, {r}\npush rax\npop rbx\ncmp rbx, 1\nje 1f\n1:\nnop";
    if (!isa_asm.t_scan_refused(grammar, leak, ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 256; }
    if (isa_asm.t_scan_refused(grammar, leak, ?names[0], 0, ct.mul_mask_none(), false))  { bad = bad + 512; }
    val noflow: str = "mov rax, {r}\npush rax\npop rbx";
    if (isa_asm.t_scan_refused(grammar, noflow, ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 1024; }

    val fl: str = "mov rax, {r}\ncmp rax, rbx\npushfq\npop rcx\ncmp rcx, 1\nje 1f\n1:\nnop";
    if (!isa_asm.t_scan_refused(grammar, fl, ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 2048; }
    val flpub: str = "mov rax, 5\ncmp rax, rbx\npushfq\npop rcx\ncmp rcx, 1\nje 1f\n1:\nnop";
    if (isa_asm.t_scan_refused(grammar, flpub, ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 4096; }

    ret bad;
}

# a secret in xmm3 is not a secret in rbx, and a secret vector reaches its variable-latency uses
test asm_ct_scan__vector_taint_is_its_own_bank {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("k");

    if (isa_asm.t_scan_refused(grammar, "movdqu xmm3, {k}\nmov rax, [rbx]", ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 1; }

    if (!isa_asm.t_scan_refused(grammar, "mov rbx, {k}\nmovdqu xmm0, [rbx]", ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 2; }

    if (!isa_asm.t_scan_refused(grammar, "movups xmm1, {k}\nmovaps xmm5, xmm1\npxor xmm5, xmm2\nmulps xmm6, xmm5", ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 4; }

    if (isa_asm.t_scan_refused(grammar, "movups xmm1, {k}\nmulps xmm6, xmm2", ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 8; }

    if (!isa_asm.t_scan_refused(grammar, "movdqu xmm1, {k}\npmullw xmm1, xmm2", ?names[0], 1, ct.mul_mask_none(), false)) { bad = bad + 16; }
    ret bad;
}

test asm_ct_scan__implicit_read_taints_defined_flags {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val cx:      str                = "mov rax, {r}\ncmpxchg [rbx], rcx\nje 1f\n1:\nnop";
    var scanned: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, cx, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, cx, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 2; }

    val pub: str = "mov rax, 5\ncmpxchg [rbx], rcx\nje 1f\n1:\nnop";
    scanned = isa_asm.ct_scan(grammar, pub, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 4; }

    val unrelated: str = "mov rax, {r}\nmov rdx, [rbx]\nje 1f\n1:\nnop";
    scanned = isa_asm.ct_scan(grammar, unrelated, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }

    ret bad;
}

test asm_ct_scan__register_indirect_transfer_on_secret_refused {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("r");

    val jt:      str                = "mov rax, {r}\njmp rax";
    var scanned: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, jt, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 1; }
    scanned = isa_asm.ct_scan(grammar, jt, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 2; }

    val calls: str = "mov rax, {r}\ncall rax";
    scanned = isa_asm.ct_scan(grammar, calls, ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel scanned.err) { bad = bad + 4; }
    scanned = isa_asm.ct_scan(grammar, calls, ?names[0], 0, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 8; }

    val pubj: str = "mov rax, 5\njmp rax";
    scanned = isa_asm.ct_scan(grammar, pubj, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 16; }

    val pubc: str = "mov rax, 5\ncall rax";
    scanned = isa_asm.ct_scan(grammar, pubc, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 32; }

    val direct: str = "jmp some_symbol";
    scanned = isa_asm.ct_scan(grammar, direct, ?names[0], 1, ct.mul_mask_none(), false);
    if (sel scanned.err) { bad = bad + 64; }

    ret bad;
}

test asm_ct_scan__a_declaration_is_not_a_verification {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var names: [1]ct.AsmSecret;
    names[0] = ct.asm_secret_value("secret");

    if (!isa_asm.t_scan_refused(grammar, ".byte 0x90", ?names[0], 1, ct.mul_mask_none(), false)) { bad = 1; }

    val declared: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, ".byte 0x90 :: writes()", ?names[0], 1, ct.mul_mask_none(), false);
    if (!sel declared.err) { bad = 1; }
    if (sel declared.err) {
        if (!str_contains(declared.err.message, "writes(...)")) { bad = 1; }
    }

    ret bad;
}

# a `*^T` binding is a public address whose loads produce a secret; a `^T` or `^*T`
# binding is a secret value, so it is a secret address
test asm_ct_scan__a_pointer_to_a_secret_is_a_public_address_and_a_secret_load {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    var binds: [2]ct.AsmSecret;
    binds[0] = ct.asm_secret_pointee("p");
    binds[1] = ct.asm_secret_value("k");

    if (isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmov ecx, [rax]\nadd ecx, 1\nmov [rax], ecx", ?binds[0], 2, ct.mul_mask_none(), false))                                        { bad = bad + 1; }
    if (isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmovdqu xmm1, [rax]\nmovdqu xmm2, [rax + 16]\npaddd xmm1, xmm2\nmovdqu [rax], xmm1", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 2; }
    if (isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmov dword [rax], 7", ?binds[0], 2, ct.mul_mask_none(), false))                                                                { bad = bad + 4; }

    val secret_addr: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "mov rax, {k}\nmov ecx, [rax]", ?binds[0], 2, ct.mul_mask_none(), false);
    if (sel secret_addr.err) {
        if (!str_contains(secret_addr.err.message, "addresses memory with a secret value")) { bad = bad + 8; }
    }
    or { bad = bad + 8; }
    val secret_base: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "mov rax, {k}\nwrgsbase rax", ?binds[0], 2, ct.mul_mask_none(), false);
    if (sel secret_base.err) {
        if (!str_contains(secret_base.err.message, "address base")) { bad = bad + 16; }
    }
    or { bad = bad + 16; }

    val branch: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "mov rax, {p}\nmov ecx, [rax]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false);
    if (sel branch.err) {
        if (!str_contains(branch.err.message, "branches on a secret value")) { bad = bad + 32; }
    }
    or { bad = bad + 32; }
    val loaded_addr: err[ct.AsmRefusal] = isa_asm.ct_scan(grammar, "mov rax, {p}\nmov rcx, [rax]\nmov rdx, [rcx]", ?binds[0], 2, ct.mul_mask_none(), false);
    if (sel loaded_addr.err) {
        if (!str_contains(loaded_addr.err.message, "addresses memory with a secret value")) { bad = bad + 64; }
    }
    or { bad = bad + 64; }

    if (!isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmov rbx, rax\nmov ecx, [rbx + 4]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 128; }
    if (!isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmov ecx, [rdx + rax * 4]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false))         { bad = bad + 256; }

    if (isa_asm.t_scan_refused(grammar, "mov rax, {p}\nwrgsbase rax", ?binds[0], 2, ct.mul_mask_none(), false))                                               { bad = bad + 512; }
    if (!isa_asm.t_scan_refused(grammar, "mov rax, {p}\nwrgsbase rax\nmov ecx, gs:[8]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 1024; }

    if (isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmov ecx, [rax]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 0, ct.mul_mask_none(), false)) { bad = bad + 2048; }

    if (!isa_asm.t_scan_refused(grammar, "mov rax, {p}\npush rax\npop rbx\nmov ecx, [rbx]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false))              { bad = bad + 4096; }
    if (!isa_asm.t_scan_refused(grammar, "mov rax, {p}\nmov [rsp], rax\nmov rbx, [rsp]\nmov ecx, [rbx]\ncmp ecx, 1\nje 1f\n1:\nnop", ?binds[0], 2, ct.mul_mask_none(), false)) { bad = bad + 8192; }

    ret bad;
}

test asm_clobbers__derived_from_parse {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    isa_asm.clobbers(grammar, "mov rax, rbx", ?gp, ?fp);
    if (gp != (1::u32 << isa_inst.regid_index(x64.RAX)::u32)) { bad = 1; }
    if (fp != 0)                                              { bad = 1; }

    isa_asm.clobbers(grammar, "syscall", ?gp, ?fp);
    if (gp != ((1::u32 << isa_inst.regid_index(x64.RAX)::u32) | (1::u32 << isa_inst.regid_index(x64.RCX)::u32) | (1::u32 << isa_inst.regid_index(x64.R11)::u32))) { bad = 1; }

    isa_asm.clobbers(grammar, "mov [rcx], rax\ncmp rax, rbx\npush rbx", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    isa_asm.clobbers(grammar, "xchg rdx, rsi", ?gp, ?fp);
    if (gp != ((1::u32 << isa_inst.regid_index(x64.RDX)::u32) | (1::u32 << isa_inst.regid_index(x64.RSI)::u32))) { bad = 1; }
    isa_asm.clobbers(grammar, "cmpxchg rbx, rdx", ?gp, ?fp);
    if (gp != ((1::u32 << isa_inst.regid_index(x64.RBX)::u32) | (1::u32 << isa_inst.regid_index(x64.RAX)::u32))) { bad = 1; }

    isa_asm.clobbers(grammar, "mov rax, {v}", ?gp, ?fp);
    if (gp != (1::u32 << isa_inst.regid_index(x64.RAX)::u32)) { bad = 1; }
    if (fp != 0)                                              { bad = 1; }
    isa_asm.clobbers(grammar, "mov {result}, rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    isa_asm.clobbers(grammar, "lock xadd {slot}, rax", ?gp, ?fp);
    if (gp != (1::u32 << isa_inst.regid_index(x64.RAX)::u32)) { bad = 1; }

    isa_asm.clobbers(grammar, "mov rcx, {ptr}\nmov rax, [rcx]\nmov {result}, rax", ?gp, ?fp);
    if (gp != ((1::u32 << isa_inst.regid_index(x64.RAX)::u32) | (1::u32 << isa_inst.regid_index(x64.RCX)::u32))) { bad = 1; }

    isa_asm.clobbers(grammar, ".byte 0x90", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP || fp != x64_mnemonic.ALL_FP) { bad = 1; }
    isa_asm.clobbers(grammar, "frobnicate rax, rbx", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP || fp != x64_mnemonic.ALL_FP) { bad = 1; }
    isa_asm.clobbers(grammar, "frobnicate", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP || fp != x64_mnemonic.ALL_FP) { bad = 1; }
    ret bad;
}

test asm_claim__refuses_unclaimed_byte {
    var bad: i32             = 0;
    var g:   isa_asm.Grammar = grammar();

    var c: isa_asm.Cursor;
    isa_asm.cursor_init(?c, ?g, "mov rax, rbx", nil, nil, nil, nil);
    var claimed: err[fail.Fail] = isa_asm.claim(?c, 0, 3);
    if (sel claimed.err) { bad = 1; }
    claimed = isa_asm.claim(?c, 9, 3);
    if (!sel claimed.err) { bad = 1; }

    var q: isa_asm.Cursor;
    isa_asm.cursor_init(?q, ?g, "mov rax", nil, nil, nil, nil);
    claimed = isa_asm.claim(?q, 0, 3);
    if (sel claimed.err) { bad = 1; }
    claimed = isa_asm.claim(?q, 4, 3);
    if (sel claimed.err) { bad = 1; }
    claimed = isa_asm.claim(?q, 5, 2);
    if (!sel claimed.err) { bad = 1; }
    ret bad;
}

test x64_asm_text__unresolved_binding_refused {
    var alloc: A.Allocator;
    page.make(?alloc);
    var st: isa_encode.EncodeState;
    st.alloc       = ?alloc;
    st.buf         = isa_encode.buf_init(?alloc);
    st.interner    = nil;
    st.fixups      = nil;
    st.fixup_count = 0;
    st.fixup_cap   = 0;

    var bad: i32 = 0;
    var f:   lang_mir.MirFunction;
    var l:   isa_asm.Labels;
    isa_asm.labels_init(?l, ?alloc);

    val src: err[fail.Fail] = asm_text(?st, ?f, ?l, "mov rax, {v}");
    if (!sel src.err) { bad = 1; }
    or (sel src.err) {
        if (!str_contains(fail.describe(src.err), "unresolved '{name}'")) { bad = 1; }
    }
    var assembled: err[fail.Fail] = asm_text(?st, ?f, ?l, "mov {v}, rax");
    if (!sel assembled.err) { bad = 1; }
    assembled = asm_text(?st, ?f, ?l, "neg {v}");
    if (!sel assembled.err) { bad = 1; }

    if (st.buf.bytes.len != 0) { bad = 1; }

    isa_asm.labels_dnit(?l);
    isa_encode.buf_dnit(?st.buf);
    ret bad;
}

# a numbered label, spelled as the block spells it: GNU as looks `1f` up in
# the next `1:` and `1b` in the last one, as the block does, and nothing but
# the block's own instructions lies between a reference and its definition
fun asm_note_label(st: *isa_encode.EncodeState, number: u32) err[fail.Fail] {
    x64_printer.note_local_label(?st.buf, number);
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_portio_inst(is_in: bool, acc_size: u8, port: isa_inst.Operand) isa_inst.Inst {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.OUT;
    if (is_in) { mi.opcode = x64.IN; }
    mi.size = acc_size;
    mi.dst  = port;
    mi.src1 = isa_inst.make_reg(x64.RAX, acc_size);
    if (is_in) {
        mi.dst  = isa_inst.make_reg(x64.RAX, acc_size);
        mi.src1 = port;
    }
    ret mi;
}

#[testing]
fun t_inst_writes_nothing(mi: *isa_inst.Inst) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: isa_encode.ByteBuf = isa_encode.buf_init(?alloc);
    isa_encode.emit_byte(?buf, 0x90);
    val got: i32  = x64_emit.encode_inst(mi, ?buf);
    val ok:  bool = got == 0 && buf.bytes.len == 1 && buf.bytes.data[0] == 0x90;
    isa_encode.buf_dnit(?buf);
    ret ok;
}

test portio__rejected_operand_writes_nothing {
    var bad: i32 = 0;

    var hi: isa_inst.Inst = t_portio_inst(true, 2, isa_inst.make_imm(0x1234, 2));
    if (!t_inst_writes_nothing(?hi)) { bad = 1; }

    var lo: isa_inst.Inst = t_portio_inst(false, 2, isa_inst.make_imm(-1, 2));
    if (!t_inst_writes_nothing(?lo)) { bad = 1; }

    var mem: isa_inst.Inst = t_portio_inst(true, 2, isa_inst.make_mem(x64.RDX, 0, isa_inst.REG_NONE, 0, 2));
    if (!t_inst_writes_nothing(?mem)) { bad = 1; }

    var wide: isa_inst.Inst = t_portio_inst(true, 8, isa_inst.make_reg(x64.RDX, 2));
    if (!t_inst_writes_nothing(?wide)) { bad = 1; }

    var good: isa_inst.Inst = t_portio_inst(true, 2, isa_inst.make_reg(x64.RDX, 2));
    var want: [2]u8;
    want[0] = 0x66;
    want[1] = 0xED;
    if (!x64_emit.t_inst_bytes(?good, ?want[0], 2)) { bad = 1; }

    ret bad;
}

test portio__byte_exact {
    var bad: i32 = 0;

    var b1: [1]u8;
    b1[0] = 0xFA;
    if (!t_asm_bytes("cli", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xFB;
    if (!t_asm_bytes("sti", ?b1[0], 1)) { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x0F;
    b2[1] = 0x31;
    if (!t_asm_bytes("rdtsc", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0x32;
    if (!t_asm_bytes("rdmsr", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0x30;
    if (!t_asm_bytes("wrmsr", ?b2[0], 2)) { bad = 1; }

    b1[0] = 0xEC;
    if (!t_asm_bytes("in al, dx", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xED;
    if (!t_asm_bytes("in eax, dx", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xEE;
    if (!t_asm_bytes("out dx, al", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0xEF;
    if (!t_asm_bytes("out dx, eax", ?b1[0], 1)) { bad = 1; }

    b2[0] = 0x66;
    b2[1] = 0xED;
    if (!t_asm_bytes("in ax, dx", ?b2[0], 2)) { bad = 1; }

    b2[0] = 0xE4;
    b2[1] = 0x60;
    if (!t_asm_bytes("in al, 0x60", ?b2[0], 2)) { bad = 1; }
    b2[0] = 0xE6;
    b2[1] = 0x60;
    if (!t_asm_bytes("out 0x60, al", ?b2[0], 2)) { bad = 1; }
    b2[0] = 0xE5;
    b2[1] = 0x60;
    if (!t_asm_bytes("in eax, 0x60", ?b2[0], 2)) { bad = 1; }

    var b3: [3]u8;
    b3[0] = 0x0F;
    b3[1] = 0x01;
    b3[2] = 0x18;
    if (!t_asm_bytes("lidt [rax]", ?b3[0], 3)) { bad = 1; }

    ret bad;
}

test freestanding__byte_exact {
    var bad: i32 = 0;

    var b1: [1]u8;
    b1[0] = 0xFC;
    if (!t_asm_bytes("cld", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0x9C;
    if (!t_asm_bytes("pushfq", ?b1[0], 1)) { bad = 1; }
    b1[0] = 0x9D;
    if (!t_asm_bytes("popfq", ?b1[0], 1)) { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x48;
    b2[1] = 0xCF;
    if (!t_asm_bytes("iretq", ?b2[0], 2)) { bad = 1; }

    var b3: [3]u8;
    b3[0] = 0x0F;
    b3[1] = 0x01;
    b3[2] = 0xF8;
    if (!t_asm_bytes("swapgs", ?b3[0], 3)) { bad = 1; }

    ret bad;
}

test sysreg_moves__byte_exact {
    var bad: i32 = 0;

    var b3: [3]u8;
    b3[0] = 0x0F;
    b3[1] = 0x20;
    b3[2] = 0xD0;
    if (!t_asm_bytes("mov rax, cr2", ?b3[0], 3)) { bad = 1; }
    b3[2] = 0xC0;
    if (!t_asm_bytes("mov rax, cr0", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0x22;
    b3[2] = 0xD8;
    if (!t_asm_bytes("mov cr3, rax", ?b3[0], 3)) { bad = 1; }

    var b4: [4]u8;
    b4[0] = 0x41;
    b4[1] = 0x0F;
    b4[2] = 0x20;
    b4[3] = 0xD9;
    if (!t_asm_bytes("mov r9, cr3", ?b4[0], 4)) { bad = 1; }
    b4[0] = 0x41;
    b4[1] = 0x0F;
    b4[2] = 0x22;
    b4[3] = 0xDA;
    if (!t_asm_bytes("mov cr3, r10", ?b4[0], 4)) { bad = 1; }
    b4[0] = 0x44;
    b4[1] = 0x0F;
    b4[2] = 0x20;
    b4[3] = 0xC0;
    if (!t_asm_bytes("mov rax, cr8", ?b4[0], 4)) { bad = 1; }

    var b2: [2]u8;
    b2[0] = 0x8C;
    b2[1] = 0xC8;
    if (!t_asm_bytes("mov eax, cs", ?b2[0], 2)) { bad = 1; }
    if (!t_asm_bytes("mov rax, cs", ?b2[0], 2)) { bad = 1; }
    b2[1] = 0xE8;
    if (!t_asm_bytes("mov eax, gs", ?b2[0], 2)) { bad = 1; }
    b3[0] = 0x66;
    b3[1] = 0x8C;
    b3[2] = 0xC8;
    if (!t_asm_bytes("mov ax, cs", ?b3[0], 3)) { bad = 1; }

    if (!t_asm_refused("mov cs, rax", "segment register")) { bad = 1; }
    if (!t_asm_refused("mov eax, cr2", "64-bit"))          { bad = 1; }
    if (!t_asm_refused("mov cr3, cr2", "two system"))      { bad = 1; }
    if (!t_asm_refused("mov rax, cr1", "bare-symbol"))     { bad = 1; }

    ret bad;
}

test asm_clobbers__sysreg_moves {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    isa_asm.clobbers(grammar, "mov rax, cr2", ?gp, ?fp);
    if (gp != 1) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "mov cr3, rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "mov ecx, cs", ?gp, ?fp);
    if (gp != 2) { bad = 1; }

    ret bad;
}

test asm_clobbers__freestanding_writes_nothing {
    var gp:  u32 = 0;
    var fp:  u32 = 0;
    var bad: i32 = 0;

    isa_asm.clobbers(grammar, "cld\npushfq\npopfq\nswapgs\niretq", ?gp, ?fp);
    if (gp != 0) { bad = 1; }
    if (fp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, "jmp rax", ?gp, ?fp);
    if (gp != 0) { bad = 1; }

    gp = 0;
    fp = 0;
    isa_asm.clobbers(grammar, ".byte 0x0f, 0x01, 0xf8\n.byte 0x48, 0xcf", ?gp, ?fp);
    if (gp != x64_mnemonic.ALL_GP) { bad = 1; }
    if (fp != x64_mnemonic.ALL_FP) { bad = 1; }

    ret bad;
}

test sized_memory_operands__byte_exact {
    var bad: i32 = 0;

    var b3: [3]u8;
    b3[0] = 0x0F;
    b3[1] = 0xB7;
    b3[2] = 0x01;
    if (!t_asm_bytes("movzx eax, word [rcx]", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0xB6;
    if (!t_asm_bytes("movzx eax, byte [rcx]", ?b3[0], 3)) { bad = 1; }
    b3[1] = 0xBF;
    if (!t_asm_bytes("movsx eax, word [rcx]", ?b3[0], 3)) { bad = 1; }

    var b4: [4]u8;
    b4[0] = 0x48;
    b4[1] = 0x0F;
    b4[2] = 0xB6;
    b4[3] = 0x01;
    if (!t_asm_bytes("movzx rax, byte [rcx]", ?b4[0], 4)) { bad = 1; }
    var sxd: [3]u8;
    sxd[0] = 0x48;
    sxd[1] = 0x63;
    sxd[2] = 0x01;
    if (!t_asm_bytes("movsx rax, dword [rcx]", ?sxd[0], 3)) { bad = 1; }

    var st4: [6]u8;
    st4[0] = 0xC7;
    st4[1] = 0x01;
    st4[2] = 0x01;
    st4[3] = 0x00;
    st4[4] = 0x00;
    st4[5] = 0x00;
    if (!t_asm_bytes("mov dword [rcx], 1", ?st4[0], 6)) { bad = 1; }
    var st2: [5]u8;
    st2[0] = 0x66;
    st2[1] = 0xC7;
    st2[2] = 0x01;
    st2[3] = 0x01;
    st2[4] = 0x00;
    if (!t_asm_bytes("mov word [rcx], 1", ?st2[0], 5)) { bad = 1; }
    var st1: [3]u8;
    st1[0] = 0xC6;
    st1[1] = 0x01;
    st1[2] = 0x01;
    if (!t_asm_bytes("mov byte [rcx], 1", ?st1[0], 3)) { bad = 1; }
    var st8: [7]u8;
    st8[0] = 0x48;
    st8[1] = 0xC7;
    st8[2] = 0x01;
    st8[3] = 0x01;
    st8[4] = 0x00;
    st8[5] = 0x00;
    st8[6] = 0x00;
    if (!t_asm_bytes("mov [rcx], 1", ?st8[0], 7)) { bad = 1; }

    var neg8: [3]u8;
    neg8[0] = 0x48;
    neg8[1] = 0xF7;
    neg8[2] = 0x19;
    if (!t_asm_bytes("neg qword [rcx]", ?neg8[0], 3)) { bad = 1; }
    var neg4: [2]u8;
    neg4[0] = 0xF7;
    neg4[1] = 0x19;
    if (!t_asm_bytes("neg dword [rcx]", ?neg4[0], 2)) { bad = 1; }
    var inc2: [3]u8;
    inc2[0] = 0x66;
    inc2[1] = 0xFF;
    inc2[2] = 0x00;
    if (!t_asm_bytes("inc word [rax]", ?inc2[0], 3)) { bad = 1; }

    var mv4: [2]u8;
    mv4[0] = 0x8B;
    mv4[1] = 0x01;
    if (!t_asm_bytes("mov eax, dword [rcx]", ?mv4[0], 2)) { bad = 1; }

    ret bad;
}

test sized_memory_operands__contradictions_refused {
    var bad: i32 = 0;

    if (!t_asm_refused("mov eax, word [rcx]", "contradicts"))  { bad = 1; }
    if (!t_asm_refused("mov word [rcx], eax", "contradicts"))  { bad = 1; }
    if (!t_asm_refused("add rax, dword [rcx]", "contradicts")) { bad = 1; }

    if (!t_asm_refused("movzx eax, dword [rcx]", "as wide"))            { bad = 1; }
    if (!t_asm_refused("movsx rax, qword [rcx]", "as wide"))            { bad = 1; }
    if (!t_asm_refused("movzx rax, dword [rcx]", "32-bit source form")) { bad = 1; }
    if (!t_asm_refused("movzx eax, [rcx]", "does not state the width")) { bad = 1; }

    if (!t_asm_refused("push dword [rax]", "fixed 64-bit"))    { bad = 1; }
    if (!t_asm_refused("pop word [rax]", "fixed 64-bit"))      { bad = 1; }
    if (!t_asm_refused("lidt qword [rax]", "no scalar width")) { bad = 1; }

    if (!t_asm_refused("mov qword rax, rcx", "may only precede a memory operand")) { bad = 1; }
    if (!t_asm_refused("mov rax, dword 1", "may only precede a memory operand"))   { bad = 1; }

    var gp: u32 = 0;
    var fp: u32 = 0;
    isa_asm.clobbers(grammar, "lea rax, [word]", ?gp, ?fp);
    if (gp != 1) { bad = 1; }

    ret bad;
}

test portio__classified_for_the_ct_walk {
    var bad: i32 = 0;
    if (x64_effects.asm_ct_class(x64.IN::u32, 0).op != ct.CT_OP_NONE)    { bad = 1; }
    if (x64_effects.asm_ct_class(x64.OUT::u32, 0).op != ct.CT_OP_NONE)   { bad = 1; }
    if (x64_effects.asm_ct_class(x64.CLI::u32, 0).op != ct.CT_OP_NONE)   { bad = 1; }
    if (x64_effects.asm_ct_class(x64.STI::u32, 0).op != ct.CT_OP_NONE)   { bad = 1; }
    if (x64_effects.asm_ct_class(x64.LIDT::u32, 0).op != ct.CT_OP_NONE)  { bad = 1; }
    if (x64_effects.asm_ct_class(x64.RDTSC::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }
    if (x64_effects.asm_ct_class(x64.RDMSR::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }
    if (x64_effects.asm_ct_class(x64.WRMSR::u32, 0).op != ct.CT_OP_NONE) { bad = 1; }

    if (x64_effects.asm_ct_class(x64.IN::u32, 0).cond_flags)  { bad = 1; }
    if (x64_effects.asm_ct_class(x64.RDTSC::u32, 0).cond_reg) { bad = 1; }
    ret bad;
}

test asm_returns__trap_ends_control {
    var bad: i32 = 0;

    if (isa_asm.returns(grammar, "mov eax, 231\nsyscall\nhlt")) { bad = 1; }
    if (isa_asm.returns(grammar, "hlt"))                        { bad = 1; }

    if (!isa_asm.returns(grammar, "mov eax, 1\nsyscall"))  { bad = 1; }
    if (!isa_asm.returns(grammar, "nop"))                  { bad = 1; }
    if (!isa_asm.returns(grammar, "lock xadd [rcx], rax")) { bad = 1; }

    if (!isa_asm.returns(grammar, "hlt\nnop")) { bad = 1; }

    if (!isa_asm.returns(grammar, "1:\nhlt")) { bad = 1; }

    if (!isa_asm.returns(grammar, ".byte 0xf4"))             { bad = 1; }
    if (!isa_asm.returns(grammar, ".byte 0xf4 :: writes()")) { bad = 1; }
    if (!isa_asm.returns(grammar, "this is not asm"))        { bad = 1; }
    if (!isa_asm.returns(grammar, ""))                       { bad = 1; }

    ret bad;
}
