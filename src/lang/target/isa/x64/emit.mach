#[testing]
pub fun t_xmm(n: i32) i32 {
    ret isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, n);
}

# in the vex variant every sse row is its vex form, the gas bytes of
# `vaddsd xmm1, xmm1, xmm9; vcvtsi2sd xmm2, xmm2, rax; vcvttss2si r10d, xmm3;
# vmovss xmm0, xmm0, xmm8; vucomisd xmm4, [rbp-8]; vmovq xmm5, rcx; vmovd
# eax, xmm6; vxorps xmm7, xmm7, xmm7; vmovaps [rbp-32], xmm9; vpaddd xmm1,
# xmm1, xmm2`: a merging row names its destination in vvvv, and a register
# move from an extended source takes the store form
test sse_rows__vex_forms_in_the_vex_variant {
    var alloc: A.Allocator;
    page.make(?alloc);
    var got: isa_encode.ByteBuf = isa_encode.buf_init(?alloc);
    fin { isa_encode.buf_dnit(?got); }
    got.variant = VARIANT_VEX;
    val rows: [9]u16 = [9]u16{x64.ADDSD, x64.CVTSI2SD, x64.CVTTSS2SI, x64.MOVSS, x64.UCOMISD, x64.MOVQ, x64.MOVQ, x64.XORPS, x64.MOVAPS};
    var ops:  [9]isa_inst.Inst;
    var k:    u32    = 0;
    for (k < 9) {
        ops[k]        = isa_inst.inst_blank();
        ops[k].opcode = rows[k];
        ops[k].size   = 16;
        k             = k + 1;
    }
    ops[0].dst   = vec_reg(t_xmm(1), 16);
    ops[0].src1  = vec_reg(t_xmm(9), 16);
    ops[0].size  = 8;
    ops[1].dst   = vec_reg(t_xmm(2), 16);
    ops[1].src1  = isa_inst.make_reg(x64.RAX, 8);
    ops[1].size  = 8;
    ops[1].flags = x64_inst.FLAG_REX_W;
    ops[2].dst   = isa_inst.make_reg(x64.R10, 4);
    ops[2].src1  = vec_reg(t_xmm(3), 16);
    ops[2].size  = 4;
    ops[3].dst   = vec_reg(t_xmm(0), 16);
    ops[3].src1  = vec_reg(t_xmm(8), 16);
    ops[3].size  = 4;
    ops[4].dst   = vec_reg(t_xmm(4), 16);
    ops[4].src1  = isa_inst.make_mem(x64.RBP, -8, isa_inst.REG_NONE, 0, 8);
    ops[5].dst   = vec_reg(t_xmm(5), 16);
    ops[5].src1  = isa_inst.make_reg(x64.RCX, 8);
    ops[5].size  = 8;
    ops[6].dst   = isa_inst.make_reg(x64.RAX, 4);
    ops[6].src1  = vec_reg(t_xmm(6), 16);
    ops[6].size  = 4;
    ops[7].dst   = vec_reg(t_xmm(7), 16);
    ops[7].src1  = vec_reg(t_xmm(7), 16);
    ops[8].dst   = isa_inst.make_mem(x64.RBP, -32, isa_inst.REG_NONE, 0, 16);
    ops[8].src1  = vec_reg(t_xmm(9), 16);
    k            = 0;
    for (k < 9) {
        if (encode_inst(?ops[k], ?got) <= 0) { ret 1; }
        k = k + 1;
    }
    val p: err[fail.Fail] = packed_op(x64.PADDD, VB_XMM, t_xmm(1), vec_reg(t_xmm(2), VB_XMM), ?got);
    if (sel p.err) { ret 2; }
    var want: [64]u8;
    val n:    usize = t_unhex("c4c17358c9c4e1eb2ad0c57a2cd3c57a11c0c5f92e65f8c4e1f96ee9c5f97ef0c5c057ffc578294de0c5f1feca", ?want[0]);
    if (!t_buf_is(?got, ?want[0], n)) { ret 3; }
    ret 0;
}

test encode_fp_mov__single_instruction_shapes {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: isa_encode.ByteBuf = isa_encode.buf_init(?alloc);
    var bad: i32                = 0;

    var rr: isa_inst.Inst = isa_inst.inst_blank();
    rr.opcode = x64.MOV;
    rr.size   = 8;
    rr.dst    = isa_inst.make_reg(x64.XMM3, 16);
    rr.src1   = isa_inst.make_reg(x64.XMM5, 16);
    buf.len   = 0;
    encode_mov(?rr, ?buf);
    if (buf.len != 4)        { bad = 1; }
    or (buf.data[0] != 0xF2) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0xDD) { bad = 1; }

    var ld: isa_inst.Inst = isa_inst.inst_blank();
    ld.opcode = x64.MOV;
    ld.size   = 4;
    ld.dst    = isa_inst.make_reg(x64.XMM3, 16);
    ld.src1   = isa_inst.make_mem(x64.RBP, -16, isa_inst.REG_NONE, 0, 4);
    buf.len   = 0;
    encode_mov(?ld, ?buf);
    if (buf.len != 5)        { bad = 1; }
    or (buf.data[0] != 0xF3) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x10) { bad = 1; }
    or (buf.data[3] != 0x5D) { bad = 1; }
    or (buf.data[4] != 0xF0) { bad = 1; }

    var st: isa_inst.Inst = isa_inst.inst_blank();
    st.opcode = x64.MOV;
    st.size   = 4;
    st.dst    = isa_inst.make_mem(x64.RBP, -16, isa_inst.REG_NONE, 0, 4);
    st.src1   = isa_inst.make_reg(x64.XMM3, 16);
    buf.len   = 0;
    encode_mov(?st, ?buf);
    if (buf.len != 5)        { bad = 1; }
    or (buf.data[0] != 0xF3) { bad = 1; }
    or (buf.data[1] != 0x0F) { bad = 1; }
    or (buf.data[2] != 0x11) { bad = 1; }
    or (buf.data[3] != 0x5D) { bad = 1; }
    or (buf.data[4] != 0xF0) { bad = 1; }

    isa_encode.buf_dnit(?buf);
    ret bad;
}

# the family predicates are exact over the whole opcode space, including
# the two setcc rows assigned outside the setcc run
test describe__family_predicates_read_the_table {
    var jcc:     u32 = 0;
    var setcc:   u32 = 0;
    var sse_mov: u32 = 0;
    var sse_alu: u32 = 0;
    var alu:     u32 = 0;
    var cvt:     u32 = 0;
    var fp:      u32 = 0;
    var op:      u32 = 0;
    for (op < x64_inst.OPCODE_COUNT) {
        val o: u16 = op::u16;
        if (is_jcc(o))                { jcc = jcc + 1; }
        if (is_setcc(o))              { setcc = setcc + 1; }
        if (is_sse_mov(o))            { sse_mov = sse_mov + 1; }
        if (is_sse_alu(o))            { sse_alu = sse_alu + 1; }
        if (is_alu(o))                { alu = alu + 1; }
        if (is_cvt(o))                { cvt = cvt + 1; }
        if (x64_inst.is_fp_opcode(o)) { fp = fp + 1; }
        op = op + 1;
    }
    if (jcc != 10 || setcc != 12 || sse_mov != 2 || sse_alu != 8 || alu != 6 || cvt != 6)                            { ret 1; }
    if (!is_setcc(x64.SETP) || !is_setcc(x64.SETNP))                                                                 { ret 2; }
    if (is_jcc(x64.JMP) || is_jcc(x64.SETE) || is_setcc(x64.JE) || is_setcc(x64.PUSHFQ))                             { ret 3; }
    if (is_sse_alu(x64.ADDPS) || is_sse_mov(x64.MOVAPS) || is_alu(x64.TEST) || is_cvt(x64.MOVQ))                     { ret 4; }
    if (!x64_inst.is_fp_opcode(x64.MOVQ) || !x64_inst.is_fp_opcode(x64.PADDB) || !x64_inst.is_fp_opcode(x64.MOVUPS)) { ret 5; }
    if (x64_inst.is_fp_opcode(x64.MOV) || x64_inst.is_fp_opcode(x64.MOVABS) || x64_inst.is_fp_opcode(x64.MOVSB))     { ret 6; }
    # movq, movss/movsd, 4 packed moves, 8 scalar alu, 2 ucomis, 6 cvt, xorps, 30 packed, pshufd, pslld,
    # 11 packed conversions, 3 immediate shifts, 3 widening multiply halves,
    # 7 packed extension rows, pinsrd/pextrd, the gated pmulld, and the
    # lane-halving rows: 3 high unpacks, psrldq and 6 gated extends, the
    # qword shifts of the 64-bit multiply sequence, and the word and dword
    # logical right shifts of the vector shifts, and the 6 aes rows and pclmulqdq
    # and the two lane-join rows, and the 5 avx2 variable shifts and vmovdqu,
    # and the two f16c conversions and the pinsrw/pextrw word moves, and vpmullq,
    # and the 6 sse41 extensions over several doublings and psadbw, and the
    # 256-bit lane crossings vextractf128, vinsertf128 and vpermq, and pcmpgtq and pcmpeqq
    if (fp != 1 + 2 + 4 + 8 + 2 + 6 + 1 + 30 + 1 + 1 + 11 + 3 + 3 + 7 + 2 + 1 + 3 + 1 + 6 + 2 + 2 + 7 + 2 + 5 + 1 + 2 + 2 + 1 + 6 + 1 + 3 + 2) { ret 7; }
    if (is_jcc(x64_inst.OPCODE_COUNT::u16) || is_setcc(x64.ASM_BLOCK))                                                                         { ret 8; }
    ret 0;
}

# an opcode with no row, and a memory operand on a row that never reaches
# memory through an operand, are refused with the buffer untouched
test encode_inst__rowless_and_memoryless_forms_emit_nothing {
    var alloc: A.Allocator;
    page.make(?alloc);
    var buf: isa_encode.ByteBuf = isa_encode.buf_init(?alloc);
    var bad: i32                = 0;

    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64_inst.OPCODE_COUNT::u16;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 1; }
    mi.opcode = x64.ASM_BLOCK;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 2; }

    mi        = isa_inst.inst_blank();
    mi.opcode = x64.SETE;
    mi.dst    = isa_inst.make_mem(x64.RBP, -8, isa_inst.REG_NONE, 0, 1);
    mi.size   = 1;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 3; }
    mi.dst = isa_inst.make_reg(x64.RAX, 1);
    if (encode_inst(?mi, ?buf) <= 0 || buf.len == 0) { bad = 4; }

    buf.len   = 0;
    mi        = isa_inst.inst_blank();
    mi.opcode = x64.MOVQ;
    mi.dst    = isa_inst.make_reg(x64.XMM0, 16);
    mi.src1   = isa_inst.make_mem(x64.RBP, -8, isa_inst.REG_NONE, 0, 8);
    mi.size   = 8;
    if (encode_inst(?mi, ?buf) != 0 || buf.len != 0) { bad = 5; }

    isa_encode.buf_dnit(?buf);
    ret bad;
}
