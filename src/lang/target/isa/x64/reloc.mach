# the x86-64 relocation applier
#
# The packing half of the x86-64 relocatable-object seam, the counterpart of the
# `elf_reloc_type` forward map: the map names a relocation in an ELF object, this
# writes the resolved value into the merged bytes at link time. Both are declared
# by `register_x64` on the arch's `isa.RelocSeam`, so the linker reaches x86-64
# relocation knowledge only through the vtable and holds none of its own.
#
# The x86-64 kinds are all flat little-endian writes, so every one of them
# delegates to a shared `of.reloc` body except the range-checked signed 32-bit
# absolute.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.of.bin;
use rel: mach.lang.target.of.reloc;

# describe an x86_64 relocation's patch width and raw-addend semantics
# ---
# kind:          the abstract relocation kind to describe
# section_kind:  kind of section containing the patch site
# codegen_image: true only for an in-memory image from this compiler
# ret:           its physical field width and addend mode
pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) rel.RelocTraits {
    var width: u32 = 4;
    if (kind == of.RK_ABS64)   { width = 8; }
    if (kind == of.RK_SECTION) { width = 2; }

    var mode: rel.RelocAddendMode = rel.RELOC_ADDEND_SYMBOL;
    if (section_kind == of.SK_TEXT
        && (kind == of.RK_PC32 || kind == of.RK_PLT32
            || kind == of.RK_GOTPCREL)) {
        mode = rel.RELOC_ADDEND_FIELD_BIAS;
    }
    if (kind == of.RK_SECTION) { mode = rel.RELOC_ADDEND_IGNORED; }
    if (mode == rel.RELOC_ADDEND_FIELD_BIAS) {
        if (codegen_image) {
            # the x64 encoder records a text relocation only for an instruction
            # field, correcting A by the field-to-next-ip distance. the field
            # contributes at least four bytes and an instruction at most 15.
            ret rel.traits(width, mode, 4, 15);
        }
        # a parsed text relocation has no trustworthy instruction provenance:
        # foreign objects can use pc32/plt32 for address-difference data, or put
        # a trailing immediate after a displacement. retain every legal x64 bias.
        ret rel.traits(width, mode, 0, 15);
    }
    ret rel.traits(width, mode, 0, 0);
}

# apply one x86_64 relocation
#
# RK_ABS64 is a 64-bit absolute, RK_ABS32 an unsigned 32-bit absolute, RK_PC32 /
# RK_PLT32 32-bit pc-relative displacements, RK_ABS32S a range-checked 32-bit
# signed absolute, and RK_ADDR32NB an unsigned image-relative address. an unknown
# kind is reported as unsupported.
# ---
# kind:      the relocation kind to apply
# dst:       the merged section bytes to patch
# patch_off: byte offset of the patch site within `dst`
# sec_len:   length of the section `dst` backs, for the bounds check
# sym_va:    the target symbol's final virtual address
# addend:    the relocation addend
# patch_va:  the patch site's own virtual address
# image_base: base virtual address subtracted by RK_ADDR32NB
# ret:       ok(true) once written, or the reason it could not be
pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64, patch_va: u64,
                    image_base: u64) R.Result[bool, rel.RelocError] {
    # RK_ABS64: a 64-bit absolute (R_X86_64_64).
    if (kind == of.RK_ABS64) {
        ret rel.apply_abs64(dst, patch_off, sec_len, sym_va, addend);
    }

    # RK_ABS32: a 32-bit unsigned absolute (R_X86_64_32), for DWARF cross-section refs.
    if (kind == of.RK_ABS32) {
        ret rel.apply_abs32(dst, patch_off, sec_len, sym_va, addend);
    }

    # RK_PC32: a flat 32-bit field-relative displacement (R_X86_64_PC32).
    if (kind == of.RK_PC32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, sym_va, addend, patch_va);
    }

    # RK_PLT32: a flat 32-bit pc-relative displacement, identical to PC32.
    if (kind == of.RK_PLT32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, sym_va, addend, patch_va);
    }

    # RK_ADDR32NB: a 32-bit image-relative address (IMAGE_REL_AMD64_ADDR32NB).
    if (kind == of.RK_ADDR32NB) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        var target: u64 = sym_va;
        if (addend < 0) {
            # form the magnitude without negating i64 minimum.
            val magnitude: u64 = (-(addend + 1))::u64 + 1;
            if (target < magnitude) { ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW); }
            target = target - magnitude;
        }
        or {
            val positive: u64 = addend::u64;
            if (target > 0xFFFFFFFFFFFFFFFF - positive) {
                ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
            }
            target = target + positive;
        }
        if (target < image_base || target - image_base > 0xFFFFFFFF) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        bin.write_u32_le(dst, patch_off::usize, (target - image_base)::u32);
        ret R.ok[bool, rel.RelocError](true);
    }

    # RK_ABS32S: 32-bit signed absolute.
    if (kind == of.RK_ABS32S) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val v: i64 = (sym_va::i64) + addend;
        if (v > 2147483647 || v < -2147483648) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        bin.write_u32_le(dst, patch_off::usize, ((v::u64) & 0xFFFFFFFF)::u32);
        ret R.ok[bool, rel.RelocError](true);
    }

    ret R.err[bool, rel.RelocError](rel.RELOC_UNSUPPORTED);
}

# x64 COFF image-relative relocations subtract ImageBase and reject values that
# cannot fit their unsigned 32-bit field
test "mach.lang.target.isa.x64.reloc.apply_reloc:addr32nb" {
    var dst: [8]u8;

    val exact: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 0, 8, 0x140003210, -0x10, 0, 0x140000000);
    if (R.is_err[bool, rel.RelocError](exact) || bin.read_u32_le(?dst[0], 0) != 0x3200) { ret 1; }

    val under: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 0, 8, 0x13FFFFFFF, 0, 0, 0x140000000);
    if (!R.is_err[bool, rel.RelocError](under)
        || R.unwrap_err[bool, rel.RelocError](under) != rel.RELOC_OVERFLOW) { ret 1; }

    val over: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 0, 8, 0x240000000, 0, 0, 0x140000000);
    if (!R.is_err[bool, rel.RelocError](over)
        || R.unwrap_err[bool, rel.RelocError](over) != rel.RELOC_OVERFLOW) { ret 1; }

    val bounds: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 5, 8, 0x140001000, 0, 0, 0x140000000);
    if (!R.is_err[bool, rel.RelocError](bounds)
        || R.unwrap_err[bool, rel.RelocError](bounds) != rel.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

# x86_64's call relocation patches one 4-byte field and carries a field-relative
# addend bias
test "mach.lang.target.isa.x64.reloc.reloc_traits:plt32" {
    val t: rel.RelocTraits =
        reloc_traits(of.RK_PLT32, of.SK_TEXT, true);
    if (t.field_width != 4 || t.addend_mode != rel.RELOC_ADDEND_FIELD_BIAS
        || t.text_bias_min != 4 || t.text_bias_max != 15) { ret 1; }

    val text_pc32: rel.RelocTraits =
        reloc_traits(of.RK_PC32, of.SK_TEXT, false);
    if (text_pc32.text_bias_min != 0 || text_pc32.text_bias_max != 15) { ret 1; }
    val parsed_plt: rel.RelocTraits =
        reloc_traits(of.RK_PLT32, of.SK_TEXT, false);
    if (parsed_plt.text_bias_min != 0 || parsed_plt.text_bias_max != 15) { ret 1; }

    val data: rel.RelocTraits =
        reloc_traits(of.RK_PC32, of.SK_DATA, true);
    if (data.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    val data_got: rel.RelocTraits =
        reloc_traits(of.RK_GOTPCREL, of.SK_DATA, false);
    if (data_got.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    val data_plt: rel.RelocTraits =
        reloc_traits(of.RK_PLT32, of.SK_DATA, true);
    if (data_plt.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    ret 0;
}

# the pc-relative 32-bit field is bounded: a displacement at the signed 32-bit
# limit is written, one past it is rejected, and the -4 addend a call site carries
# is applied before the range check rather than after
test "mach.lang.target.isa.x64.reloc.apply_reloc:pcrel32_boundary" {
    var dst: [8]u8;
    var i: usize = 0;
    for (i < 8) { dst[i] = 0; i = i + 1; }

    # sym_va at the signed-32 limit, patch_va 0: disp == 0x7FFFFFFF, the largest
    # displacement the field holds.
    val r1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PC32, ?dst[0], 0, 8, 0x7FFFFFFF, 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](r1)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x7FFFFFFF) { ret 1; }

    # one past the limit overflows.
    val r2: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PC32, ?dst[0], 0, 8, 0x80000000, 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r2)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](r2) != rel.RELOC_OVERFLOW) { ret 1; }

    # PLT32 shares the PC32 body: sym 0, addend -1, patch_va 0x80000000 gives
    # -0x80000001, one below the negative limit.
    val r3: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, 0, -1, 0x80000000, 0);
    if (!R.is_err[bool, rel.RelocError](r3)) { ret 1; }
    ret 0;
}

# the signed 32-bit absolute is range-checked on both ends, and a patch site that
# would run past the section end is rejected rather than written
test "mach.lang.target.isa.x64.reloc.apply_reloc:abs32s_boundary" {
    var dst: [8]u8;
    var i: usize = 0;
    for (i < 8) { dst[i] = 0; i = i + 1; }

    val r1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, 0x7FFFFFFF, 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](r1)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x7FFFFFFF) { ret 1; }

    val r2: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, 0x80000000, 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r2)) { ret 1; }

    # the negative limit is representable, and encodes as 0x80000000; one below it
    # is not.
    bin.write_u32_le(?dst[0], 0, 0);
    val r3: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, 0, -2147483648, 0, 0);
    if (R.is_err[bool, rel.RelocError](r3)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x80000000) { ret 1; }

    val below_min: i64 = -2147483648 - 1;
    val r4: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, 0, below_min, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r4)) { ret 1; }

    # a 4-byte write at offset 5 of an 8-byte section runs past the end.
    val r5: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 5, 8, 0, 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r5)) { ret 1; }
    ret 0;
}

# a kind x86-64 has no packing for is reported as unsupported, not silently skipped
test "mach.lang.target.isa.x64.reloc.apply_reloc:unsupported_kind" {
    var dst: [8]u8;
    var i: usize = 0;
    for (i < 8) { dst[i] = 0; i = i + 1; }

    val r: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, 0x1000, 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](r) != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}
