use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_reloc: mach.lang.target.of.reloc;

fun reloc_traits_admitted(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_ABS64 || kind == target_of.RK_ABS32 || kind == target_of.RK_PC32
        || kind == target_of.RK_PC64 || kind == target_of.RK_PLT32 || kind == target_of.RK_GOTPCREL
        || kind == target_of.RK_GOTPCREL_NORELAX || kind == target_of.RK_GOTPCREL64_NORELAX
        || kind == target_of.RK_ADDR32NB || kind == target_of.RK_SECREL32
        || kind == target_of.RK_SECTION || kind == target_of.RK_ABS32S;
}

pub fun is_local_got_kind(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_GOTPCREL || kind == target_of.RK_GOTPCREL_NORELAX
        || kind == target_of.RK_GOTPCREL64_NORELAX;
}

pub fun reloc_traits(kind: target_of.RelocKind,
    section_kind: target_of.SectionKind,
    codegen_image: bool) res[of_reloc.RelocTraits, of_reloc.RelocError] {
    if (!reloc_traits_admitted(kind)) {
        ret res[of_reloc.RelocTraits, of_reloc.RelocError].err{of_reloc.RELOC_UNSUPPORTED};
    }

    var width: u32 = 4;
    if (kind == target_of.RK_ABS64)              { width = 8; }
    if (kind == target_of.RK_PC64)               { width = 8; }
    if (kind == target_of.RK_GOTPCREL64_NORELAX) { width = 8; }
    if (kind == target_of.RK_SECTION)            { width = 2; }

    var mode: of_reloc.RelocAddendMode = of_reloc.RELOC_ADDEND_SYMBOL;
    if (section_kind == target_of.SK_TEXT
        && (kind == target_of.RK_PC32 || kind == target_of.RK_PLT32
        || kind == target_of.RK_GOTPCREL || kind == target_of.RK_GOTPCREL_NORELAX
        || kind == target_of.RK_GOTPCREL64_NORELAX)) {
        mode = of_reloc.RELOC_ADDEND_FIELD_BIAS;
    }
    if (kind == target_of.RK_SECTION) { mode = of_reloc.RELOC_ADDEND_IGNORED; }
    if (mode == of_reloc.RELOC_ADDEND_FIELD_BIAS) {
        if (codegen_image) {
            ret res[of_reloc.RelocTraits, of_reloc.RelocError].ok{of_reloc.traits(width, mode, width::i32, 15)};
        }
        ret res[of_reloc.RelocTraits, of_reloc.RelocError].ok{of_reloc.traits(width, mode, 0, 15)};
    }
    ret res[of_reloc.RelocTraits, of_reloc.RelocError].ok{of_reloc.traits(width, mode, 0, 0)};
}

pub fun apply_reloc(kind: target_of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
    target: of_reloc.RelocTarget, addend: i64, patch_va: u64,
    image_base: u64) res[bool, of_reloc.RelocError] {
    if (kind == target_of.RK_ABS64) {
        ret of_reloc.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }

    if (kind == target_of.RK_ABS32) {
        ret of_reloc.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }

    if (kind == target_of.RK_PC32) {
        ret of_reloc.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == target_of.RK_PC64) {
        ret of_reloc.apply_pcrel64(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == target_of.RK_PLT32) {
        ret of_reloc.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == target_of.RK_GOTPCREL || kind == target_of.RK_GOTPCREL_NORELAX) {
        ret of_reloc.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }
    if (kind == target_of.RK_GOTPCREL64_NORELAX) {
        ret of_reloc.apply_pcrel64(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == target_of.RK_ADDR32NB) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        val adjusted: res[u64, of_reloc.RelocError] =
            of_reloc.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, of_reloc.RelocError].err{adjusted.err};
        }
        val value: u64 = adjusted.ok;
        if (value < image_base || value - image_base > 0xFFFFFFFF) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        bin.write_u32_le(dst, patch_off::usize, (value - image_base)::u32);
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    if (kind == target_of.RK_SECREL32) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        val adjusted: res[u64, of_reloc.RelocError] =
            of_reloc.add_signed_to_u64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, of_reloc.RelocError].err{adjusted.err};
        }
        val value: u64 = adjusted.ok;
        if (value < target.section_vaddr || value - target.section_vaddr > 0xFFFFFFFF) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        bin.write_u32_le(dst, patch_off::usize, (value - target.section_vaddr)::u32);
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    if (kind == target_of.RK_SECTION) {
        if (patch_off::u64 + 2 > sec_len::u64
            || target.section_index == 0 || target.section_index > 0xFFFF) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        bin.write_u16_le(dst, patch_off::usize, target.section_index::u16);
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    if (kind == target_of.RK_ABS32S) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        val adjusted: res[i64, of_reloc.RelocError] =
            of_reloc.add_u64_to_i64(target.vaddr, addend);
        if (sel adjusted.err) {
            ret res[bool, of_reloc.RelocError].err{adjusted.err};
        }
        val v: i64 = adjusted.ok;
        if (v > 2147483647 || v < -2147483648) {
            ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_OVERFLOW};
        }
        bin.write_u32_le(dst, patch_off::usize, ((v::u64) & 0xFFFFFFFF)::u32);
        ret res[bool, of_reloc.RelocError].ok{true};
    }

    ret res[bool, of_reloc.RelocError].err{of_reloc.RELOC_UNSUPPORTED};
}

test catalog__admitted_kinds_are_exactly_the_applied_kinds {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k:   u32 = 0;
    for (k < target_of.RK_CATALOG_COUNT) {
        val kind: target_of.RelocKind = k::target_of.RelocKind;
        var i:    usize               = 0;
        for (i < 16) {
            dst[i] = 0;
            i      = i + 1;
        }

        val tr:       res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(kind, target_of.SK_TEXT, true);
        val admitted: bool                                           = sel tr.ok;
        if (sel tr.err) {
            if (tr.err != of_reloc.RELOC_UNSUPPORTED) {
                bad = 1;
                brk;
            }
        }

        val ap: res[bool, of_reloc.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, of_reloc.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (sel ap.err) {
            applied = ap.err != of_reloc.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) {
            bad = 2;
            brk;
        }
        k = k + 1;
    }

    val past:    target_of.RelocKind                            = 0xFF::target_of.RelocKind;
    val tr_past: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(past, target_of.SK_TEXT, true);
    if (!sel tr_past.err) { bad = 3; }
    or (sel tr_past.err) {
        if (tr_past.err != of_reloc.RELOC_UNSUPPORTED) { bad = 3; }
    }
    val ap_past: res[bool, of_reloc.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, of_reloc.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!sel ap_past.err) { bad = 4; }
    or (sel ap_past.err) {
        if (ap_past.err != of_reloc.RELOC_UNSUPPORTED) { bad = 4; }
    }
    ret bad;
}

test apply_reloc__addr32nb {
    var dst: [8]u8;

    val exact: res[bool, of_reloc.RelocError] =
        apply_reloc(target_of.RK_ADDR32NB, ?dst[0], 0, 8, of_reloc.target(0x140003210, 0, 0), -0x10, 0, 0x140000000);
    if (sel exact.err)                         { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x3200) { ret 1; }

    val under: res[bool, of_reloc.RelocError] =
        apply_reloc(target_of.RK_ADDR32NB, ?dst[0], 0, 8, of_reloc.target(0x13FFFFFFF, 0, 0), 0, 0, 0x140000000);
    if (!sel under.err)                       { ret 1; }
    if (under.err != of_reloc.RELOC_OVERFLOW) { ret 1; }

    val over: res[bool, of_reloc.RelocError] =
        apply_reloc(target_of.RK_ADDR32NB, ?dst[0], 0, 8, of_reloc.target(0x240000000, 0, 0), 0, 0, 0x140000000);
    if (!sel over.err)                       { ret 1; }
    if (over.err != of_reloc.RELOC_OVERFLOW) { ret 1; }

    val bounds: res[bool, of_reloc.RelocError] =
        apply_reloc(target_of.RK_ADDR32NB, ?dst[0], 5, 8, of_reloc.target(0x140001000, 0, 0), 0, 0, 0x140000000);
    if (!sel bounds.err)                       { ret 1; }
    if (bounds.err != of_reloc.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

test apply_reloc__coff_section_pair {
    var dst:    [8]u8;
    val target: of_reloc.RelocTarget = of_reloc.target(0x140003210, 0x140001000, 7);

    val sr: res[bool, of_reloc.RelocError] =
        apply_reloc(target_of.RK_SECREL32, ?dst[0], 0, 8, target, -0x10, 0, 0x140000000);
    val si: res[bool, of_reloc.RelocError] =
        apply_reloc(target_of.RK_SECTION, ?dst[0], 4, 8, target, 123, 0, 0x140000000);
    if (sel sr.err)                                                                { ret 1; }
    if (sel si.err)                                                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x2200 || bin.read_u16_le(?dst[0], 4) != 7) { ret 1; }

    val before: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECREL32, ?dst[0], 0, 8, of_reloc.target(0x1000, 0x1001, 1), 0, 0, 0);
    val sub_under: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECREL32, ?dst[0], 0, 8, of_reloc.target(0, 0, 1), -1, 0, 0);
    val add_over: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECREL32, ?dst[0], 0, 8, of_reloc.target(0xFFFFFFFFFFFFFFFF, 0, 1), 1, 0, 0);
    val wide: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECREL32, ?dst[0], 0, 8, of_reloc.target(0x100000000, 0, 1), 0, 0, 0);
    val sec_zero: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECTION, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), 0, 0, 0);
    val sec_wide: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECTION, ?dst[0], 0, 8, of_reloc.target(0, 0, 0x10000), 0, 0, 0);
    val sr_bounds: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECREL32, ?dst[0], 5, 8, of_reloc.target(0, 0, 1), 0, 0, 0);
    val si_bounds: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_SECTION, ?dst[0], 7, 8, of_reloc.target(0, 0, 1), 0, 0, 0);

    if (!sel before.err)                          { ret 1; }
    if (!sel sub_under.err)                       { ret 1; }
    if (!sel add_over.err)                        { ret 1; }
    if (!sel wide.err)                            { ret 1; }
    if (!sel sec_zero.err)                        { ret 1; }
    if (!sel sec_wide.err)                        { ret 1; }
    if (!sel sr_bounds.err)                       { ret 1; }
    if (!sel si_bounds.err)                       { ret 1; }
    if (before.err != of_reloc.RELOC_OVERFLOW)    { ret 1; }
    if (sub_under.err != of_reloc.RELOC_OVERFLOW) { ret 1; }
    if (add_over.err != of_reloc.RELOC_OVERFLOW)  { ret 1; }
    if (wide.err != of_reloc.RELOC_OVERFLOW)      { ret 1; }
    if (sec_zero.err != of_reloc.RELOC_OVERFLOW)  { ret 1; }
    if (sec_wide.err != of_reloc.RELOC_OVERFLOW)  { ret 1; }
    if (sr_bounds.err != of_reloc.RELOC_OVERFLOW) { ret 1; }
    if (si_bounds.err != of_reloc.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

test reloc_traits__plt32 {
    val tr: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_PLT32, target_of.SK_TEXT, true);
    if (sel tr.err) { ret 1; }
    val t: of_reloc.RelocTraits = tr.ok;
    if (t.field_width != 4 || t.addend_mode != of_reloc.RELOC_ADDEND_FIELD_BIAS
        || t.text_bias_min != 4 || t.text_bias_max != 15) { ret 1; }

    val text_pc32_r: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_PC32, target_of.SK_TEXT, false);
    if (sel text_pc32_r.err) { ret 1; }
    val text_pc32: of_reloc.RelocTraits = text_pc32_r.ok;
    if (text_pc32.text_bias_min != 0 || text_pc32.text_bias_max != 15) { ret 1; }
    val parsed_plt_r: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_PLT32, target_of.SK_TEXT, false);
    if (sel parsed_plt_r.err) { ret 1; }
    val parsed_plt: of_reloc.RelocTraits = parsed_plt_r.ok;
    if (parsed_plt.text_bias_min != 0 || parsed_plt.text_bias_max != 15) { ret 1; }

    val data_r: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_PC32, target_of.SK_DATA, true);
    if (sel data_r.err) { ret 1; }
    val data: of_reloc.RelocTraits = data_r.ok;
    if (data.addend_mode != of_reloc.RELOC_ADDEND_SYMBOL) { ret 1; }
    val data_got_r: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_GOTPCREL, target_of.SK_DATA, false);
    if (sel data_got_r.err) { ret 1; }
    val data_got: of_reloc.RelocTraits = data_got_r.ok;
    if (data_got.addend_mode != of_reloc.RELOC_ADDEND_SYMBOL) { ret 1; }
    val got64_r: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_GOTPCREL64_NORELAX, target_of.SK_TEXT, true);
    if (sel got64_r.err) { ret 1; }
    val got64: of_reloc.RelocTraits = got64_r.ok;
    if (got64.field_width != 8 || got64.addend_mode != of_reloc.RELOC_ADDEND_FIELD_BIAS
        || got64.text_bias_min != 8 || got64.text_bias_max != 15) { ret 1; }
    val data_plt_r: res[of_reloc.RelocTraits, of_reloc.RelocError] = reloc_traits(target_of.RK_PLT32, target_of.SK_DATA, true);
    if (sel data_plt_r.err) { ret 1; }
    val data_plt: of_reloc.RelocTraits = data_plt_r.ok;
    if (data_plt.addend_mode != of_reloc.RELOC_ADDEND_SYMBOL) { ret 1; }
    ret 0;
}

test apply_reloc__got_slot {
    var dst: [16]u8;
    var i:   usize = 0;
    for (i < 16) {
        dst[i] = 0;
        i      = i + 1;
    }

    val load: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOTPCREL, ?dst[0], 0, 16, of_reloc.target(0x2000, 0, 0), -4, 0x1003, 0);
    val fixed32: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOTPCREL_NORELAX, ?dst[0], 4, 16, of_reloc.target(0x3000, 0, 0), -4, 0x2003, 0);
    val fixed64: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOTPCREL64_NORELAX, ?dst[0], 8, 16, of_reloc.target(0x4000, 0, 0), -8, 0x3002, 0);
    if (sel load.err)    { ret 1; }
    if (sel fixed32.err) { ret 1; }
    if (sel fixed64.err) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xFF9
        || bin.read_u32_le(?dst[0], 4) != 0xFF9
        || bin.read_u64_le(?dst[0], 8) != 0xFF6) { ret 1; }

    val over32: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOTPCREL_NORELAX, ?dst[0], 0, 16,
        of_reloc.target(0x80000004, 0, 0), -4, 0, 0);
    val bounds64: res[bool, of_reloc.RelocError] = apply_reloc(
        target_of.RK_GOTPCREL64_NORELAX, ?dst[0], 9, 16,
        of_reloc.target(0, 0, 0), 0, 0, 0);
    if (!sel over32.err)                         { ret 1; }
    if (over32.err != of_reloc.RELOC_OVERFLOW)   { ret 1; }
    if (!sel bounds64.err)                       { ret 1; }
    if (bounds64.err != of_reloc.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

test apply_reloc__pcrel32_boundary {
    var dst: [8]u8;
    var i:   usize = 0;
    for (i < 8) {
        dst[i] = 0;
        i      = i + 1;
    }

    val r1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PC32, ?dst[0], 0, 8, of_reloc.target(0x7FFFFFFF, 0, 0), 0, 0, 0);
    if (sel r1.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x7FFFFFFF) { ret 1; }

    val r2: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PC32, ?dst[0], 0, 8, of_reloc.target(0x80000000, 0, 0), 0, 0, 0);
    if (!sel r2.err)                       { ret 1; }
    if (r2.err != of_reloc.RELOC_OVERFLOW) { ret 1; }

    val r3: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_PLT32, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), -1, 0x80000000, 0);
    if (!sel r3.err) { ret 1; }
    ret 0;
}

test apply_reloc__abs32s_boundary {
    var dst: [8]u8;
    var i:   usize = 0;
    for (i < 8) {
        dst[i] = 0;
        i      = i + 1;
    }

    val r1: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ABS32S, ?dst[0], 0, 8, of_reloc.target(0x7FFFFFFF, 0, 0), 0, 0, 0);
    if (sel r1.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x7FFFFFFF) { ret 1; }

    val r2: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ABS32S, ?dst[0], 0, 8, of_reloc.target(0x80000000, 0, 0), 0, 0, 0);
    if (!sel r2.err) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0);
    val r3: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ABS32S, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), -2147483648, 0, 0);
    if (sel r3.err)                                { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x80000000) { ret 1; }

    val below_min: i64                            = -2147483648 - 1;
    val r4:        res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ABS32S, ?dst[0], 0, 8, of_reloc.target(0, 0, 0), below_min, 0, 0);
    if (!sel r4.err) { ret 1; }

    val r5: res[bool, of_reloc.RelocError] = apply_reloc(target_of.RK_ABS32S, ?dst[0], 5, 8, of_reloc.target(0, 0, 0), 0, 0, 0);
    if (!sel r5.err) { ret 1; }
    ret 0;
}
