use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.of.bin;
use rel: mach.lang.target.of.reloc;

fun reloc_traits_admitted(kind: of.RelocKind) bool {
    ret kind == of.RK_ABS64  || kind == of.RK_ABS32   || kind == of.RK_PC32
     || kind == of.RK_PLT32  || kind == of.RK_GOTPCREL
     || kind == of.RK_GOTPCREL_NORELAX || kind == of.RK_GOTPCREL64_NORELAX
     || kind == of.RK_ADDR32NB || kind == of.RK_SECREL32
     || kind == of.RK_SECTION  || kind == of.RK_ABS32S;
}

pub fun is_local_got_kind(kind: of.RelocKind) bool {
    ret kind == of.RK_GOTPCREL || kind == of.RK_GOTPCREL_NORELAX
        || kind == of.RK_GOTPCREL64_NORELAX;
}

pub fun reloc_traits(kind: of.RelocKind,
                     section_kind: of.SectionKind,
                     codegen_image: bool) R.Result[rel.RelocTraits, rel.RelocError] {
    if (!reloc_traits_admitted(kind)) {
        ret R.err[rel.RelocTraits, rel.RelocError](rel.RELOC_UNSUPPORTED);
    }

    var width: u32 = 4;
    if (kind == of.RK_ABS64)   { width = 8; }
    if (kind == of.RK_GOTPCREL64_NORELAX) { width = 8; }
    if (kind == of.RK_SECTION) { width = 2; }

    var mode: rel.RelocAddendMode = rel.RELOC_ADDEND_SYMBOL;
    if (section_kind == of.SK_TEXT
        && (kind == of.RK_PC32 || kind == of.RK_PLT32
            || kind == of.RK_GOTPCREL || kind == of.RK_GOTPCREL_NORELAX
            || kind == of.RK_GOTPCREL64_NORELAX)) {
        mode = rel.RELOC_ADDEND_FIELD_BIAS;
    }
    if (kind == of.RK_SECTION) { mode = rel.RELOC_ADDEND_IGNORED; }
    if (mode == rel.RELOC_ADDEND_FIELD_BIAS) {
        if (codegen_image) {
            ret R.ok[rel.RelocTraits, rel.RelocError](rel.traits(width, mode, width::i32, 15));
        }
        ret R.ok[rel.RelocTraits, rel.RelocError](rel.traits(width, mode, 0, 15));
    }
    ret R.ok[rel.RelocTraits, rel.RelocError](rel.traits(width, mode, 0, 0));
}

pub fun apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                    target: rel.RelocTarget, addend: i64, patch_va: u64,
                    image_base: u64) R.Result[bool, rel.RelocError] {
    if (kind == of.RK_ABS64) {
        ret rel.apply_abs64(dst, patch_off, sec_len, target.vaddr, addend);
    }

    if (kind == of.RK_ABS32) {
        ret rel.apply_abs32(dst, patch_off, sec_len, target.vaddr, addend);
    }

    if (kind == of.RK_PC32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == of.RK_PLT32) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == of.RK_GOTPCREL || kind == of.RK_GOTPCREL_NORELAX) {
        ret rel.apply_pcrel32(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        ret rel.apply_pcrel64(dst, patch_off, sec_len, target.vaddr, addend, patch_va);
    }

    if (kind == of.RK_ADDR32NB) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val adjusted: R.Result[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (R.is_err[u64, rel.RelocError](adjusted)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[u64, rel.RelocError](adjusted));
        }
        val value: u64 = R.unwrap_ok[u64, rel.RelocError](adjusted);
        if (value < image_base || value - image_base > 0xFFFFFFFF) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        bin.write_u32_le(dst, patch_off::usize, (value - image_base)::u32);
        ret R.ok[bool, rel.RelocError](true);
    }

    if (kind == of.RK_SECREL32) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val adjusted: R.Result[u64, rel.RelocError] =
            rel.add_signed_to_u64(target.vaddr, addend);
        if (R.is_err[u64, rel.RelocError](adjusted)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[u64, rel.RelocError](adjusted));
        }
        val value: u64 = R.unwrap_ok[u64, rel.RelocError](adjusted);
        if (value < target.section_vaddr || value - target.section_vaddr > 0xFFFFFFFF) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        bin.write_u32_le(dst, patch_off::usize, (value - target.section_vaddr)::u32);
        ret R.ok[bool, rel.RelocError](true);
    }

    if (kind == of.RK_SECTION) {
        if (patch_off::u64 + 2 > sec_len::u64
            || target.section_index == 0 || target.section_index > 0xFFFF) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        bin.write_u16_le(dst, patch_off::usize, target.section_index::u16);
        ret R.ok[bool, rel.RelocError](true);
    }

    if (kind == of.RK_ABS32S) {
        if (patch_off::u64 + 4 > sec_len::u64) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        val adjusted: R.Result[i64, rel.RelocError] =
            rel.add_u64_to_i64(target.vaddr, addend);
        if (R.is_err[i64, rel.RelocError](adjusted)) {
            ret R.err[bool, rel.RelocError](R.unwrap_err[i64, rel.RelocError](adjusted));
        }
        val v: i64 = R.unwrap_ok[i64, rel.RelocError](adjusted);
        if (v > 2147483647 || v < -2147483648) {
            ret R.err[bool, rel.RelocError](rel.RELOC_OVERFLOW);
        }
        bin.write_u32_le(dst, patch_off::usize, ((v::u64) & 0xFFFFFFFF)::u32);
        ret R.ok[bool, rel.RelocError](true);
    }

    ret R.err[bool, rel.RelocError](rel.RELOC_UNSUPPORTED);
}

test "mach.lang.target.isa.x64.reloc.catalog:admitted_kinds_are_exactly_the_applied_kinds" {
    var dst: [16]u8;
    var bad: i32 = 0;
    var k: u32 = 0;
    for (k < of.RK_CATALOG_COUNT) {
        val kind: of.RelocKind = k::of.RelocKind;
        var i: usize = 0;
        for (i < 16) { dst[i] = 0; i = i + 1; }

        val tr: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(kind, of.SK_TEXT, true);
        val admitted: bool = R.is_ok[rel.RelocTraits, rel.RelocError](tr);
        if (!admitted) {
            if (R.unwrap_err[rel.RelocTraits, rel.RelocError](tr) != rel.RELOC_UNSUPPORTED) { bad = 1; brk; }
        }

        val ap: R.Result[bool, rel.RelocError] =
            apply_reloc(kind, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
        var applied: bool = true;
        if (R.is_err[bool, rel.RelocError](ap)) {
            applied = R.unwrap_err[bool, rel.RelocError](ap) != rel.RELOC_UNSUPPORTED;
        }

        if (admitted != applied) { bad = 2; brk; }
        k = k + 1;
    }

    val past: of.RelocKind = 0xFF::of.RelocKind;
    val tr_past: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(past, of.SK_TEXT, true);
    if (!R.is_err[rel.RelocTraits, rel.RelocError](tr_past)) { bad = 3; }
    or { if (R.unwrap_err[rel.RelocTraits, rel.RelocError](tr_past) != rel.RELOC_UNSUPPORTED) { bad = 3; } }
    val ap_past: R.Result[bool, rel.RelocError] =
        apply_reloc(past, ?dst[0], 0, 16, rel.target(0x1000, 0, 0), 0, 0x1000, 0);
    if (!R.is_err[bool, rel.RelocError](ap_past)) { bad = 4; }
    or { if (R.unwrap_err[bool, rel.RelocError](ap_past) != rel.RELOC_UNSUPPORTED) { bad = 4; } }
    ret bad;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:addr32nb" {
    var dst: [8]u8;

    val exact: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 0, 8, rel.target(0x140003210, 0, 0), -0x10, 0, 0x140000000);
    if (R.is_err[bool, rel.RelocError](exact) || bin.read_u32_le(?dst[0], 0) != 0x3200) { ret 1; }

    val under: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 0, 8, rel.target(0x13FFFFFFF, 0, 0), 0, 0, 0x140000000);
    if (!R.is_err[bool, rel.RelocError](under)
        || R.unwrap_err[bool, rel.RelocError](under) != rel.RELOC_OVERFLOW) { ret 1; }

    val over: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 0, 8, rel.target(0x240000000, 0, 0), 0, 0, 0x140000000);
    if (!R.is_err[bool, rel.RelocError](over)
        || R.unwrap_err[bool, rel.RelocError](over) != rel.RELOC_OVERFLOW) { ret 1; }

    val bounds: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_ADDR32NB, ?dst[0], 5, 8, rel.target(0x140001000, 0, 0), 0, 0, 0x140000000);
    if (!R.is_err[bool, rel.RelocError](bounds)
        || R.unwrap_err[bool, rel.RelocError](bounds) != rel.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:coff_section_pair" {
    var dst: [8]u8;
    val target: rel.RelocTarget = rel.target(0x140003210, 0x140001000, 7);

    val sr: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_SECREL32, ?dst[0], 0, 8, target, -0x10, 0, 0x140000000);
    val si: R.Result[bool, rel.RelocError] =
        apply_reloc(of.RK_SECTION, ?dst[0], 4, 8, target, 123, 0, 0x140000000);
    if (R.is_err[bool, rel.RelocError](sr) || R.is_err[bool, rel.RelocError](si)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x2200 || bin.read_u16_le(?dst[0], 4) != 7) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:coff_section_pair_bounds" {
    var dst: [8]u8;

    val before: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECREL32, ?dst[0], 0, 8, rel.target(0x1000, 0x1001, 1), 0, 0, 0);
    val sub_under: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECREL32, ?dst[0], 0, 8, rel.target(0, 0, 1), -1, 0, 0);
    val add_over: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECREL32, ?dst[0], 0, 8, rel.target(0xFFFFFFFFFFFFFFFF, 0, 1), 1, 0, 0);
    val wide: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECREL32, ?dst[0], 0, 8, rel.target(0x100000000, 0, 1), 0, 0, 0);
    val sec_zero: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECTION, ?dst[0], 0, 8, rel.target(0, 0, 0), 0, 0, 0);
    val sec_wide: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECTION, ?dst[0], 0, 8, rel.target(0, 0, 0x10000), 0, 0, 0);
    val sr_bounds: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECREL32, ?dst[0], 5, 8, rel.target(0, 0, 1), 0, 0, 0);
    val si_bounds: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_SECTION, ?dst[0], 7, 8, rel.target(0, 0, 1), 0, 0, 0);

    if (!R.is_err[bool, rel.RelocError](before)
        || !R.is_err[bool, rel.RelocError](sub_under)
        || !R.is_err[bool, rel.RelocError](add_over)
        || !R.is_err[bool, rel.RelocError](wide)
        || !R.is_err[bool, rel.RelocError](sec_zero)
        || !R.is_err[bool, rel.RelocError](sec_wide)
        || !R.is_err[bool, rel.RelocError](sr_bounds)
        || !R.is_err[bool, rel.RelocError](si_bounds)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](before) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](sub_under) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](add_over) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](wide) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](sec_zero) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](sec_wide) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](sr_bounds) != rel.RELOC_OVERFLOW
        || R.unwrap_err[bool, rel.RelocError](si_bounds) != rel.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.reloc_traits:plt32" {
    val tr: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_PLT32, of.SK_TEXT, true);
    if (R.is_err[rel.RelocTraits, rel.RelocError](tr)) { ret 1; }
    val t: rel.RelocTraits = R.unwrap_ok[rel.RelocTraits, rel.RelocError](tr);
    if (t.field_width != 4 || t.addend_mode != rel.RELOC_ADDEND_FIELD_BIAS
        || t.text_bias_min != 4 || t.text_bias_max != 15) { ret 1; }

    val text_pc32: rel.RelocTraits =
        R.unwrap_ok[rel.RelocTraits, rel.RelocError](reloc_traits(of.RK_PC32, of.SK_TEXT, false));
    if (text_pc32.text_bias_min != 0 || text_pc32.text_bias_max != 15) { ret 1; }
    val parsed_plt: rel.RelocTraits =
        R.unwrap_ok[rel.RelocTraits, rel.RelocError](reloc_traits(of.RK_PLT32, of.SK_TEXT, false));
    if (parsed_plt.text_bias_min != 0 || parsed_plt.text_bias_max != 15) { ret 1; }

    val data: rel.RelocTraits =
        R.unwrap_ok[rel.RelocTraits, rel.RelocError](reloc_traits(of.RK_PC32, of.SK_DATA, true));
    if (data.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    val data_got: rel.RelocTraits =
        R.unwrap_ok[rel.RelocTraits, rel.RelocError](reloc_traits(of.RK_GOTPCREL, of.SK_DATA, false));
    if (data_got.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    val got64: rel.RelocTraits =
        R.unwrap_ok[rel.RelocTraits, rel.RelocError](reloc_traits(of.RK_GOTPCREL64_NORELAX, of.SK_TEXT, true));
    if (got64.field_width != 8 || got64.addend_mode != rel.RELOC_ADDEND_FIELD_BIAS
        || got64.text_bias_min != 8 || got64.text_bias_max != 15) { ret 1; }
    val data_plt: rel.RelocTraits =
        R.unwrap_ok[rel.RelocTraits, rel.RelocError](reloc_traits(of.RK_PLT32, of.SK_DATA, true));
    if (data_plt.addend_mode != rel.RELOC_ADDEND_SYMBOL) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.reloc_traits:unsupported_kind_refused" {
    val bad: R.Result[rel.RelocTraits, rel.RelocError] = reloc_traits(of.RK_PAGE21, of.SK_TEXT, false);
    if (!R.is_err[rel.RelocTraits, rel.RelocError](bad)) { ret 1; }
    if (R.unwrap_err[rel.RelocTraits, rel.RelocError](bad) != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:got_slot" {
    var dst: [16]u8;
    var i: usize = 0;
    for (i < 16) { dst[i] = 0; i = i + 1; }

    val load: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOTPCREL, ?dst[0], 0, 16, rel.target(0x2000, 0, 0), -4, 0x1003, 0);
    val fixed32: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOTPCREL_NORELAX, ?dst[0], 4, 16, rel.target(0x3000, 0, 0), -4, 0x2003, 0);
    val fixed64: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOTPCREL64_NORELAX, ?dst[0], 8, 16, rel.target(0x4000, 0, 0), -8, 0x3002, 0);
    if (R.is_err[bool, rel.RelocError](load)
        || R.is_err[bool, rel.RelocError](fixed32)
        || R.is_err[bool, rel.RelocError](fixed64)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0xFF9
        || bin.read_u32_le(?dst[0], 4) != 0xFF9
        || bin.read_u64_le(?dst[0], 8) != 0xFF6) { ret 1; }

    val over32: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOTPCREL_NORELAX, ?dst[0], 0, 16,
        rel.target(0x80000004, 0, 0), -4, 0, 0);
    val bounds64: R.Result[bool, rel.RelocError] = apply_reloc(
        of.RK_GOTPCREL64_NORELAX, ?dst[0], 9, 16,
        rel.target(0, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](over32)
        || R.unwrap_err[bool, rel.RelocError](over32) != rel.RELOC_OVERFLOW
        || !R.is_err[bool, rel.RelocError](bounds64)
        || R.unwrap_err[bool, rel.RelocError](bounds64) != rel.RELOC_OVERFLOW) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:pcrel32_boundary" {
    var dst: [8]u8;
    var i: usize = 0;
    for (i < 8) { dst[i] = 0; i = i + 1; }

    val r1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PC32, ?dst[0], 0, 8, rel.target(0x7FFFFFFF, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](r1)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x7FFFFFFF) { ret 1; }

    val r2: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PC32, ?dst[0], 0, 8, rel.target(0x80000000, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r2)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](r2) != rel.RELOC_OVERFLOW) { ret 1; }

    val r3: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PLT32, ?dst[0], 0, 8, rel.target(0, 0, 0), -1, 0x80000000, 0);
    if (!R.is_err[bool, rel.RelocError](r3)) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:abs32s_boundary" {
    var dst: [8]u8;
    var i: usize = 0;
    for (i < 8) { dst[i] = 0; i = i + 1; }

    val r1: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0x7FFFFFFF, 0, 0), 0, 0, 0);
    if (R.is_err[bool, rel.RelocError](r1)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x7FFFFFFF) { ret 1; }

    val r2: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0x80000000, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r2)) { ret 1; }

    bin.write_u32_le(?dst[0], 0, 0);
    val r3: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0, 0, 0), -2147483648, 0, 0);
    if (R.is_err[bool, rel.RelocError](r3)) { ret 1; }
    if (bin.read_u32_le(?dst[0], 0) != 0x80000000) { ret 1; }

    val below_min: i64 = -2147483648 - 1;
    val r4: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 0, 8, rel.target(0, 0, 0), below_min, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r4)) { ret 1; }

    val r5: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_ABS32S, ?dst[0], 5, 8, rel.target(0, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r5)) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.reloc.apply_reloc:unsupported_kind" {
    var dst: [8]u8;
    var i: usize = 0;
    for (i < 8) { dst[i] = 0; i = i + 1; }

    val r: R.Result[bool, rel.RelocError] = apply_reloc(of.RK_PAGE21, ?dst[0], 0, 8, rel.target(0x1000, 0, 0), 0, 0, 0);
    if (!R.is_err[bool, rel.RelocError](r)) { ret 1; }
    if (R.unwrap_err[bool, rel.RelocError](r) != rel.RELOC_UNSUPPORTED) { ret 1; }
    ret 0;
}
