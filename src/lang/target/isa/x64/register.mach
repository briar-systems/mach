    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64},
    # the SSE2 conversions agree with the scalar lane conversion bit for bit:
    # integer widening and narrowing are exact, a float lane converts under the
    # same rounding, and a truncating float lane lands on the same 32-bit
    # integer indefinite that the scalar cvtts*2si produces. an unsigned float
    # to integer lane converts through 64 bits in the scalar and has no packed
    # SSE2 twin, nor does any 64-bit integer lane that meets a float
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 32, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 64},
    # the widening multiplies SSE2 packs: pmullw beside pmulhw or pmulhuw for
    # 16-bit operand lanes, and pmuludq for unsigned 32-bit ones. SSE2 has no
    # signed 32-bit widening multiply (pmuldq is SSE4.1), and an 8-bit operand
    # lane is already the packed extension and pmullw
    target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 64, from_bits: 32},
    # the 32- and 64-bit low multiplies are baseline: SSE2 realizes them as
    # pmuludq sequences, and the 32-bit one is pmulld under its sse41
    # row, which the encoder reads to choose it
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32},
    # the lane-halving extensions are baseline: SSE2 realizes every cell as
    # an unpack against zero or against the sign mask, and each is
    # pmovsx/pmovzx under its sse41 row, which the encoder reads to choose it
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64},
    # a uniform shift count is baseline at 16, 32 and 64 bits: psll*, psrl*
    # and psra* by an immediate or by the count in an xmm register's low
    # quadword, which saturate at or above the lane width as the scalar shift
    # does. 8-bit lanes have no packed shift and shift as 16-bit lanes
    # with the neighbouring byte cleared, and a 64-bit arithmetic shift is
    # psraq, which is avx512vl, so it keeps the lane path
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32},
    # a lane range is baseline at every lane: a move at lane 0, one pshufd at a
    # doubleword-aligned first lane and psrldq at any other, and the
    # psrldq is one palignr under its ssse3 row, which the encoder reads
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32, ext: x64.EXT_SSE41},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 8, from_bits: 8, ext: x64.EXT_SSSE3},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 16, from_bits: 16, ext: x64.EXT_SSSE3},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_SSSE3},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSSE3},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 32, from_bits: 32, ext: x64.EXT_SSSE3},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSSE3},
    # a lane join is baseline at every lane: punpcklqdq when the low part fills
    # a quadword, otherwise the low part cleared above its bytes by a shift pair
    # and the high part shifted up to meet it with por
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 64, from_bits: 64},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 32, from_bits: 32},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 64, from_bits: 64},
    # a per-lane count packs under avx2 at 32 and 64 bits: vpsllv* and vpsrlv*
    # at both, vpsravd at 32 only (vpsravq is avx512vl), each saturating a lane
    # count at or above the lane width as the scalar shift does
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_AVX2},
    target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_AVX2},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_AVX2},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_AVX2},
    target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_AVX2},
    # the 64-bit lane multiply is one vpmullq under avx512dq, whose 128-bit
    # evex form is avx512vl as well
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_AVX512DQ | x64.EXT_AVX512VL},
    # an f16 lane moves as the 16-bit lane it is: the ranges and joins of its
    # bits are the integer ones
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 16, from_bits: 16, ext: x64.EXT_SSSE3},
    target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 16, from_bits: 16},
    # f16c converts four f16 lanes to and from binary32 in one instruction
    # (vcvtph2ps, vcvtps2ph imm 0), each lane as the scalar f16c row does: exact
    # widening, one rounding to nearest even, a NaN kept and quieted. f16 lane
    # arithmetic has no packed row below avx512 fp16, so it computes in
    # these binary32 lanes where the scalar rule does, and lane by lane otherwise
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: x64.EXT_F16C},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: x64.EXT_F16C},
    # pmulhw and pmulhuw are the high multiply of 16-bit lanes, and punpckl*
    # and punpckh* interleave a half of two registers into lanes twice as
    # wide: the widening multiply of 16-bit lanes is pmullw and pmulhw
    # interleaved, so both halves of one product share the pair
    target_model.PackedForm{op: target_model.VEC_OP_MUL_HIGH_S, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_MUL_HIGH_U, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_INTERLEAVE, is_float: false, lane_bits: 16, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_INTERLEAVE, is_float: false, lane_bits: 32, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_INTERLEAVE, is_float: false, lane_bits: 64, from_bits: 32},
    # psadbw against zero sums each quadword's eight bytes into it
    target_model.PackedForm{op: target_model.VEC_OP_WIDEN_SUM_U, is_float: false, lane_bits: 64, from_bits: 8},
    # pcmpgt* of a cleared register against the lanes is each lane's sign mask,
    # which a signed lane-halving extension interleaves with
    target_model.PackedForm{op: target_model.VEC_OP_SIGN_MASK, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.PackedForm{op: target_model.VEC_OP_SIGN_MASK, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.PackedForm{op: target_model.VEC_OP_SIGN_MASK, is_float: false, lane_bits: 32, from_bits: 32},
    # a 64-bit lane ordering is one pcmpgtq under sse42, which the encoder
    # reads to choose it over the dword sequence
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSE42},
    # and a 64-bit lane equality is one pcmpeqq under sse41
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSE41},
};

# f16c converts between f16 and binary32 only (vcvtph2ps, vcvtps2ph), so f16
# arithmetic widens to binary32 there, which one rounding back makes exact
# for + - * /. each conversion keeps a NaN's sign and the top of its payload
# and quiets it, as the expansion does. binary64 and the integers stay the
# expansion: the conversion through binary32 would round twice. the avx512
# fp16 rows need the evex encoding
val HALF_FORMS: [2]target_model.PackedForm = [2]target_model.PackedForm{
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: x64.EXT_F16C},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: x64.EXT_F16C},
};

# the SSE2 baseline has no packed 8-bit multiply worth a sequence and no
# packed integer divide at all
val SCALAR_FORMS: [5]target_model.ScalarForm = [5]target_model.ScalarForm{
    target_model.ScalarForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32},
    target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64},
};

# every row is ALWAYS on Intel and AMD, with the
# kind of each claim marked:
# intel, vendor guarantee: the DOIT guidance (software security guidance, intel.com)
# states processors that do not enumerate DOITM may be assumed to behave as if it
# were enabled for the listed instructions. intel, vendor list: MUL (F6, F7),
# IMUL (69, 6B, 0F AF, F6, F7) and MULX (F6) are on that list, so every operand
# size of the one- and two-operand forms. intel, measured per core: BearSSL's
# ctmul table records a constant-time multiply since the first Pentium.
# amd, evidence by table not by vendor document: AMD publishes no DOIT-equivalent
# list and no mode control (absence, verified 2026-09-18); BearSSL's ctmul table
# records a constant-time multiply at every width for every core from K7 through
# Zen; no AMD x86-64 core is documented with a data-dependent multiplier
# (absence); AMD SB-1039 advises constant-time algorithms, which presupposes
# constant-time instructions (inference).
# DOITM itself hardens the data dependent prefetcher and the fast store forwarding
# predictor, memory-side and kernel-owned, and does not touch the multiplier
val CT_MUL: [20]ct.CtMulForm = [20]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
    ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
};

# avx widens every xmm register to its ymm, 32 bytes. a ymm value leaves the
# legacy-encoded sse of the 128-bit rows and the scalar float code paying for
# its upper half until vzeroupper clears it
val REGISTER_ROWS: [1]target_model.VectorRegisterRow = [1]target_model.VectorRegisterRow{
    target_model.VectorRegisterRow{ext: x64.EXT_AVX, bytes: 32, upper_clear: true},
};

# the packed rows run at vex.256 over the whole ymm register: avx has the
# float arithmetic, compares and conversions at 256 bits, and an f16 lane moves
# in the 128-bit lane crossings avx has as well; avx2 brings every integer row
val WIDTH_ROWS: [2]target_model.VectorWidthRow = [2]target_model.VectorWidthRow{
    target_model.VectorWidthRow{ext: x64.EXT_AVX, is_float: true, lanes: 2 + 4 + 8, bits: 256},
    target_model.VectorWidthRow{ext: x64.EXT_AVX2, is_float: false, lanes: 1 + 2 + 4 + 8, bits: 256},
};

val ALU_WIDTHS: [2]target_model.AluWidth = [2]target_model.AluWidth{
    target_model.AluWidth{bytes: 4, ext: 0},
    target_model.AluWidth{bytes: 8, ext: 0},
};

pub val MODEL: target_model.Machine = target_model.Machine{
    pointer_width:          8,
    gpr_width:              8,
    gp_unaligned_widths:    2 + 4 + 8,
    alu_widths:             ?ALU_WIDTHS[0],
    alu_width_len:          2,
    spill_width:            8,
    endianness:             target_model.ENDIAN_LITTLE,
    reg_classes:            ?CLASSES[0],
    reg_class_len:          3,
    has_v128:               true,
    vector_bits:            target_model.VECTOR_BITS_128,
    max_vector_lanes:       target_model.VECTOR_LANES_UNBOUNDED,
    vector_compute_generic: true,
    vec_mem_widths:         target_model.VEC_MEM_4_8_16,
    xbank_widths:           target_model.XBANK_4_8,
    slot_read_widths:       target_model.SLOT_READ_1_2_4_8,
    lifetime_holes:         true,
    ct_mul_forms:           ?CT_MUL[0],
    ct_mul_form_len:        20,
    has_var_shift:          true,
    shift_count_mod_widths: target_model.SHIFT_MOD_4_8,
    # SSE2 shifts 16-, 32- and 64-bit lanes and no 8-bit ones
    packed_shift_min_bits:   16,
    has_mul:                 true,
    has_float:               x64.HAS_FLOAT,
    mul_hi_width:            8,
    int_widths:              target_model.INT_WIDTHS_1_2_4_8_16,
    mul_wide_form:           target_model.MULW_FIXED_PAIR,
    flat_addressing:         true,
    indexed_memory:          true,
    sym_offset_bits:         25,
    mem_disp_bits:           32,
    function_align:          16,
    code_fill:               0xCC,
    structured_control_flow: false,
    ct_trust_var_shift:      true,
    packed_forms:            ?PACKED_FORMS[0],
    packed_form_len:         144,
    scalar_forms:            ?SCALAR_FORMS[0],
    scalar_form_len:         5,
    # the signed 32-to-64 widening multiply lands here unpacked; pmuldq is
    # sse4.1, so it packs for targets that select sse41
    scalar_families: target_model.SCALAR_CONVERSIONS | target_model.SCALAR_WIDENING | target_model.SCALAR_SHIFTS | target_model.SCALAR_HALF_LANES,
    half_forms:      ?HALF_FORMS[0],
    half_form_len:   2,
    flen_bits:       64,
    nan_rule:        float.NAN_PRESERVE,
    # an sse operation on two NaNs returns the first, quieted (SDM vol 1, table 4-7)
    nan_first_operand:       true,
    vector_register_rows:    ?REGISTER_ROWS[0],
    vector_register_row_len: 1,
    vector_width_rows:       ?WIDTH_ROWS[0],
    vector_width_row_len:    2,
    # pmovsx and pmovzx take a lane to twice, four or eight times its width
    direct_extend:        true,
    direct_extend_ext:    x64.EXT_SSE41,
    extensions:           0,
    extension_table:      ?x64.EXTENSIONS[0],
    extension_count:      x64.EXTENSION_COUNT,
    level_table:          ?x64.LEVELS[0],
    level_count:          x64.LEVEL_COUNT,
    index_width:          64,
    vector_op_bytes:      16,
    vectors_in_registers: true,
    auto_vectorize:       true,
};

# the one-operand multiply and divide run on rax:rdx, and a variable shift
# reads its count from cl
val FIXED: [3]isa.FixedOperand = [3]isa.FixedOperand{
    isa.FixedOperand{place: isa.FIXED_PAIR_LO, reg: x64.RAX},
    isa.FixedOperand{place: isa.FIXED_PAIR_HI, reg: x64.RDX},
    isa.FixedOperand{place: isa.FIXED_SHIFT_COUNT, reg: x64.RCX},
};

pub val MACHINE: isa.RegMachine = isa.RegMachine{
    select:               x64_rules.select,
    encode:               ?x64_encode.HOOKS,
    is_reg_move:          x64_rules.is_reg_move,
    is_trap_terminator:   x64_rules.is_trap_terminator,
    reserved_regs:        ?RESERVED[0],
    reserved_reg_count:   2,
    reload_scratch_regs:  ?RELOAD_SCRATCH[0],
    reload_scratch_count: 1,
    scratch_reg:          x64.SCRATCH_REG,
    scratch_reg2:         x64.SCRATCH_REG2,
    frame_ptr_reg:        x64.FRAME_REG,
    stack_ptr_reg:        x64.STACK_REG,
    incoming_arg_base:    16,
    fixed:                ?FIXED[0],
    fixed_len:            3,
    has_assembly:         true,
    assembly:             isa.AssemblyCapabilities{
        header:    x64_printer.emit_header,
        clobbers:  x64_encode.asm_clobbers,
        returns:   x64_encode.asm_returns,
        ct_scan:   x64_encode.asm_ct_scan,
        writes_sp: x64_encode.asm_writes_sp,
    },
    dwarf_reg:    x64_dwarf_reg,
    cv_reg:       x64_cv_reg,
    frame_dist:   x64_frame_dist,
    int_imm_fits: x64_rules.int_imm_fits,
    reads_const:  x64_encode.reads_const_operand,
};

pub val RELOC: target_of.RelocationCapabilities = target_of.RelocationCapabilities{
    apply:          isa_x64_reloc.apply_reloc,
    traits:         isa_x64_reloc.reloc_traits,
    local_got_kind: isa_x64_reloc.is_local_got_kind,
    elf:            target_of.ElfRelocationCapabilities{reloc_type: x64_elf_reloc_type},
    has_elf:        true,
};

pub val VTABLE: isa.IsaVTable = isa.IsaVTable{
    id:            catalog_arch.X86_64,
    name:          "x86_64",
    elf_machine:   62,
    pointer_width: 8,
    page_size:     4096,
    reloc:         ?RELOC,
    machine:       ?MACHINE,
    model:         ?MODEL,
};

test x64_elf_reloc_type__forward_map {
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_ABS64)) != elf.R_X86_64_64)          { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_PC32)) != elf.R_X86_64_PC32)         { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_PLT32)) != elf.R_X86_64_PLT32)       { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_GOTPCREL)) != elf.R_X86_64_GOTPCREL) { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_ABS32S)) != elf.R_X86_64_32S)        { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_ABS32)) != elf.R_X86_64_32)          { ret 1; }

    val r_280: opt[u32] = x64_elf_reloc_type(target_of.RK_ADDR32NB);
    if (sel r_280.some) { ret 1; }
    val r_281: opt[u32] = x64_elf_reloc_type(target_of.RK_PAGE21);
    if (sel r_281.some) { ret 1; }
    ret 0;
}

test x64_dwarf_reg__psabi_numbers {
    if (x64_dwarf_reg(x64.RAX) != 0)  { ret 1; }
    if (x64_dwarf_reg(x64.RDX) != 1)  { ret 1; }
    if (x64_dwarf_reg(x64.RCX) != 2)  { ret 1; }
    if (x64_dwarf_reg(x64.RBX) != 3)  { ret 1; }
    if (x64_dwarf_reg(x64.RSI) != 4)  { ret 1; }
    if (x64_dwarf_reg(x64.RDI) != 5)  { ret 1; }
    if (x64_dwarf_reg(x64.RBP) != 6)  { ret 1; }
    if (x64_dwarf_reg(x64.RSP) != 7)  { ret 1; }
    if (x64_dwarf_reg(x64.R8) != 8)   { ret 1; }
    if (x64_dwarf_reg(x64.R15) != 15) { ret 1; }

    if (x64_dwarf_reg(x64.FRAME_REG) != 6) { ret 1; }

    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, x64.XMM0)) != 17)  { ret 1; }
    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, x64.XMM15)) != 32) { ret 1; }

    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 16)) != -1) { ret 1; }
    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 16)) != -1) { ret 1; }
    ret 0;
}

test x64_cv_reg__cvconst_numbers {
    if (x64_cv_reg(x64.RAX) != 328) { ret 1; }
    if (x64_cv_reg(x64.RBX) != 329) { ret 1; }
    if (x64_cv_reg(x64.RCX) != 330) { ret 1; }
    if (x64_cv_reg(x64.RDX) != 331) { ret 1; }
    if (x64_cv_reg(x64.RSI) != 332) { ret 1; }
    if (x64_cv_reg(x64.RDI) != 333) { ret 1; }
    if (x64_cv_reg(x64.RBP) != 334) { ret 1; }
    if (x64_cv_reg(x64.RSP) != 335) { ret 1; }
    if (x64_cv_reg(x64.R8) != 336)  { ret 1; }
    if (x64_cv_reg(x64.R15) != 343) { ret 1; }

    if (x64_cv_reg(x64.FRAME_REG) != 334) { ret 1; }

    if (x64_cv_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, x64.XMM0)) != 154)  { ret 1; }
    if (x64_cv_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, x64.XMM7)) != 161)  { ret 1; }
    if (x64_cv_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, x64.XMM8)) != 252)  { ret 1; }
    if (x64_cv_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, x64.XMM15)) != 259) { ret 1; }

    if (x64_cv_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 16)) != -1) { ret 1; }
    ret 0;
}

# the rows are Intel's DOIT multiply list at every operand size, every one held
# unconditionally on Intel and AMD
test model__declares_the_doit_multiply_list {
    val m: *target_model.Machine = ?MODEL;
    if (m.ct_mul_form_len != 20) { ret 2; }
    val ops:    [5]ct.CtMulOp = [5]ct.CtMulOp{ct.CT_MUL_LOW, ct.CT_MUL_HIGH_U, ct.CT_MUL_HIGH_S, ct.CT_MUL_WIDE_U, ct.CT_MUL_WIDE_S};
    val widths: [4]u8         = [4]u8{8, 16, 32, 64};
    var want:   ct.CtMulMask  = ct.mul_mask_none();
    var oi:     u32           = 0;
    for (oi < 5) {
        var wi: u32 = 0;
        for (wi < 4) {
            ct.mul_mask_add(?want, ct.mul_cell(ops[oi], widths[wi], false));
            wi = wi + 1;
        }
        oi = oi + 1;
    }
    # realized, not declared: the low half of a 128-bit product is the
    # schoolbook over the 64-bit low and widening cells
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 128, false));
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(m, true), want))  { ret 3; }
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(m, false), want)) { ret 4; }
    var i: u32 = 0;
    for (i < m.ct_mul_form_len) {
        if (m.ct_mul_forms[i].cond != ct.CT_MUL_ALWAYS || m.ct_mul_forms[i].ext != 0) { ret 5; }
        i = i + 1;
    }
    ret 0;
}
