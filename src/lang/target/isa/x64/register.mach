use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

use mach.lang.be.codegen.mir;
use mach.lang.ct;
use mach.lang.target.isa;
use mach.lang.target.isa.x64;
use mach.lang.target.isa.x64.encode;
use mach.lang.target.isa.x64.reloc;
use mach.lang.target.isa.x64.rules;
use mach.lang.target.of;
use mach.lang.target.of.elf;

fun frame_saved(mask: u32) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < 32) {
        if ((mask & (1::u32 << i)) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun frame_align_up(n: u32, align: u32) u32 {
    if (align == 0) { ret n; }
    val mask: u32 = align - 1;
    ret (n + mask) & ~mask;
}

fun x64_frame_dist(model: *isa.MachineModel, func: *mir.MirFunction, base_dist: *u32, fp_dist: *u32) {
    val gp_bytes: u32 = frame_saved(func.callee_mask) * 8;
    var base:     u32 = frame_align_up(func.frame.size + gp_bytes, 16);
    base = base + frame_saved(func.callee_mask_fp) * 16;
    base = frame_align_up(base, 16);
    var total: u32 = base + func.frame.outgoing_size;
    total      = frame_align_up(total, func.frame.realign);
    @base_dist = total;
    @fp_dist   = 0;
}

fun x64_elf_reloc_type(kind: of.RelocKind) opt[u32] {
    if (kind == of.RK_ABS64)    { ret opt[u32].some{elf.R_X86_64_64}; }
    if (kind == of.RK_PC32)     { ret opt[u32].some{elf.R_X86_64_PC32}; }
    if (kind == of.RK_PLT32)    { ret opt[u32].some{elf.R_X86_64_PLT32}; }
    if (kind == of.RK_GOTPCREL) { ret opt[u32].some{elf.R_X86_64_GOTPCREL}; }
    if (kind == of.RK_ABS32S)   { ret opt[u32].some{elf.R_X86_64_32S}; }
    if (kind == of.RK_ABS32)    { ret opt[u32].some{elf.R_X86_64_32}; }
    ret opt[u32].none{};
}

val DWARF_XMM0: i32 = 17;

val CV_AMD64_RAX:  i32 = 328;
val CV_AMD64_XMM0: i32 = 154;
val CV_AMD64_XMM8: i32 = 252;

fun x64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa.regid_class(regid);
    val idx: i32 = isa.regid_index(regid);

    if (cls == isa.REG_CLASS_ID_GP) {
        if (idx == x64.RAX)                  { ret 0; }
        if (idx == x64.RDX)                  { ret 1; }
        if (idx == x64.RCX)                  { ret 2; }
        if (idx == x64.RBX)                  { ret 3; }
        if (idx == x64.RSI)                  { ret 4; }
        if (idx == x64.RDI)                  { ret 5; }
        if (idx == x64.RBP)                  { ret 6; }
        if (idx == x64.RSP)                  { ret 7; }
        if (idx >= x64.R8 && idx <= x64.R15) { ret idx; }
        ret -1;
    }

    if (cls == isa.REG_CLASS_ID_XMM) {
        if (idx >= x64.XMM0 && idx <= x64.XMM15) { ret DWARF_XMM0 + idx; }
        ret -1;
    }

    ret -1;
}

fun x64_cv_reg(regid: i32) i32 {
    val cls: i32 = isa.regid_class(regid);
    val idx: i32 = isa.regid_index(regid);

    if (cls == isa.REG_CLASS_ID_GP) {
        if (idx == x64.RAX)                  { ret CV_AMD64_RAX + 0; }
        if (idx == x64.RBX)                  { ret CV_AMD64_RAX + 1; }
        if (idx == x64.RCX)                  { ret CV_AMD64_RAX + 2; }
        if (idx == x64.RDX)                  { ret CV_AMD64_RAX + 3; }
        if (idx == x64.RSI)                  { ret CV_AMD64_RAX + 4; }
        if (idx == x64.RDI)                  { ret CV_AMD64_RAX + 5; }
        if (idx == x64.RBP)                  { ret CV_AMD64_RAX + 6; }
        if (idx == x64.RSP)                  { ret CV_AMD64_RAX + 7; }
        if (idx >= x64.R8 && idx <= x64.R15) { ret CV_AMD64_RAX + idx; }
        ret -1;
    }

    if (cls == isa.REG_CLASS_ID_XMM) {
        if (idx >= x64.XMM0 && idx <= x64.XMM7)  { ret CV_AMD64_XMM0 + idx; }
        if (idx >= x64.XMM8 && idx <= x64.XMM15) { ret CV_AMD64_XMM8 + (idx - x64.XMM8); }
        ret -1;
    }

    ret -1;
}

pub fun register_x64(reg: *isa.IsaRegistry) err[fail.Fail] {
    var x64_classes:             [3]isa.RegClass;
    var x64_model:               isa.MachineModel;
    var x64_reserved_regs:       [2]isa.Register;
    var x64_reload_scratch_regs: [3]isa.Register;

    x64_classes[0].name = "gpr";
    x64_classes[0].kind = isa.RC_GENERAL;
    x64_classes[0].len  = 16;

    x64_classes[1].name = "xmm";
    x64_classes[1].kind = isa.RC_FLOAT;
    x64_classes[1].len  = 14;

    x64_classes[2].name = "flags";
    x64_classes[2].kind = isa.RC_FLAGS;
    x64_classes[2].len  = 1;

    x64_reserved_regs[0].id   = x64.STACK_REG;
    x64_reserved_regs[0].size = 8;
    x64_reserved_regs[1].id   = x64.FRAME_REG;
    x64_reserved_regs[1].size = 8;

    x64_reload_scratch_regs[0].id   = x64.R8;
    x64_reload_scratch_regs[0].size = 8;
    x64_reload_scratch_regs[1].id   = x64.R9;
    x64_reload_scratch_regs[1].size = 8;
    x64_reload_scratch_regs[2].id   = x64.R10;
    x64_reload_scratch_regs[2].size = 8;

    var x64_machine: isa.RegMachine = isa.reg_machine(
        rules.select,
        encode.encode_x64,
        rules.is_reg_move,
        rules.is_trap_terminator,
        ?x64_reserved_regs[0], 2,
        ?x64_reload_scratch_regs[0], 3,
        x64.SCRATCH_REG, x64.SCRATCH_REG2,
        x64.FRAME_REG, x64.STACK_REG, 16,
        x64.RAX, x64.RDX, x64.RCX);
    isa.with_assembly(?x64_machine, encode.encode_x64_asm, encode.asm_clobbers,
        encode.asm_returns, encode.asm_ct_scan, encode.asm_writes_sp);
    isa.with_dwarf_regs(?x64_machine, x64_dwarf_reg);
    isa.with_codeview_regs(?x64_machine, x64_cv_reg);
    isa.with_frame_dist(?x64_machine, x64_frame_dist);

    var x64_reloc: isa.RelocSeam = isa.reloc_seam(
        reloc.apply_reloc, reloc.reloc_traits, x64_elf_reloc_type);
    isa.with_local_got_kinds(?x64_reloc, reloc.is_local_got_kind);

    var x64_vtable: isa.IsaVTable = isa.machine_isa(
        isa.ARCH_X86_64, isa.arch_name_for(isa.ARCH_X86_64), 62, 8,
        ?x64_model, ?x64_machine, ?x64_reloc);
    isa.with_page_size(?x64_vtable, 4096);

    x64_model.pointer_width       = 8;
    x64_model.max_alu_width       = 8;
    x64_model.alu_min_width       = 4;
    x64_model.gpr_width           = 8;
    x64_model.gp_unaligned_widths = 2 + 4 + 8;
    x64_model.spill_width         = 8;
    x64_model.endianness          = isa.ENDIAN_LITTLE;
    x64_model.flen_bits           = 64;
    x64_model.has_v128            = true;
    x64_model.vector_bits         = isa.VECTOR_BITS_128;
    x64_model.max_vector_lanes    = isa.VECTOR_LANES_UNBOUNDED;
    x64_model.vec_mem_widths      = isa.VEC_MEM_4_8_16;
    x64_model.xbank_widths        = isa.XBANK_4_8;
    x64_model.slot_read_widths    = isa.SLOT_READ_1_2_4_8;
    x64_model.lifetime_holes      = true;
    var x64_packed_forms: [97]isa.PackedForm;
    x64_packed_forms[0]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[1]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[2]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[3]  = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[4]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[5]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[6]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[7]  = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[8]  = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[9]  = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[10] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[11] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[12] = isa.PackedForm{op: isa.VEC_OP_AND, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[13] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[14] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[15] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[16] = isa.PackedForm{op: isa.VEC_OP_OR, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[17] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[18] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[19] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[20] = isa.PackedForm{op: isa.VEC_OP_XOR, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[21] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[22] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[23] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[24] = isa.PackedForm{op: isa.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[25] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[26] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[27] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[28] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[29] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[30] = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[31] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[32] = isa.PackedForm{op: isa.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[33] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[34] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[35] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[36] = isa.PackedForm{op: isa.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[37] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[38] = isa.PackedForm{op: isa.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64};
    # the SSE2 conversions agree with the scalar lane conversion bit for bit:
    # integer widening and narrowing are exact, a float lane converts under the
    # same rounding, and a truncating float lane lands on the same 32-bit
    # integer indefinite that the scalar cvtts*2si produces. an unsigned float
    # to integer lane converts through 64 bits in the scalar and has no packed
    # SSE2 twin, nor does any 64-bit integer lane that meets a float
    x64_packed_forms[39] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[40] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    x64_packed_forms[41] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8};
    x64_packed_forms[42] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[43] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16};
    x64_packed_forms[44] = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[45] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[46] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8};
    x64_packed_forms[47] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8};
    x64_packed_forms[48] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[49] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16};
    x64_packed_forms[50] = isa.PackedForm{op: isa.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[51] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16};
    x64_packed_forms[52] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32};
    x64_packed_forms[53] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64};
    x64_packed_forms[54] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32};
    x64_packed_forms[55] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64};
    x64_packed_forms[56] = isa.PackedForm{op: isa.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64};
    x64_packed_forms[57] = isa.PackedForm{op: isa.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 32};
    x64_packed_forms[58] = isa.PackedForm{op: isa.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 32, from_bits: 64};
    x64_packed_forms[59] = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    x64_packed_forms[60] = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    x64_packed_forms[61] = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[62] = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    x64_packed_forms[63] = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    x64_packed_forms[64] = isa.PackedForm{op: isa.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32};
    x64_packed_forms[65] = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    x64_packed_forms[66] = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    x64_packed_forms[67] = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    x64_packed_forms[68] = isa.PackedForm{op: isa.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    x64_packed_forms[69] = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 32};
    x64_packed_forms[70] = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 32};
    x64_packed_forms[71] = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[72] = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 64};
    x64_packed_forms[73] = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 64};
    x64_packed_forms[74] = isa.PackedForm{op: isa.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 64};
    # the widening multiplies SSE2 packs: pmullw beside pmulhw or pmulhuw for
    # 16-bit operand lanes, and pmuludq for unsigned 32-bit ones. SSE2 has no
    # signed 32-bit widening multiply (pmuldq is SSE4.1), and an 8-bit operand
    # lane is already the packed extension and pmullw
    x64_packed_forms[75] = isa.PackedForm{op: isa.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[76] = isa.PackedForm{op: isa.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[77] = isa.PackedForm{op: isa.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 64, from_bits: 32};
    # the 32- and 64-bit low multiplies are baseline: SSE2 realizes them as
    # pmuludq sequences, and pmulld is the encoder's choice under sse41 on the
    # same declared set (#3739)
    x64_packed_forms[78] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[85] = isa.PackedForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64};
    # the lane-halving extensions are baseline: SSE2 realizes every cell as
    # an unpack against zero or against the sign mask, and pmovsx/pmovzx is
    # the encoder's choice under sse41 on the same declared set (#3738)
    x64_packed_forms[79] = isa.PackedForm{op: isa.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[80] = isa.PackedForm{op: isa.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[81] = isa.PackedForm{op: isa.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[82] = isa.PackedForm{op: isa.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[83] = isa.PackedForm{op: isa.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[84] = isa.PackedForm{op: isa.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32};
    # a uniform shift count is baseline at 16, 32 and 64 bits: psll*, psrl*
    # and psra* by an immediate or by the count in an xmm register's low
    # quadword, which saturate at or above the lane width as the scalar shift
    # does (#3740). 8-bit lanes have no packed shift and shift as 16-bit lanes
    # with the neighbouring byte cleared, and a 64-bit arithmetic shift is
    # psraq, which is avx512vl, so it keeps the lane path. a per-lane count is
    # vpsllv*/vpsrlv*/vpsrav*, which is avx2 (#3751)
    x64_packed_forms[86]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[87]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[88]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[89]      = isa.PackedForm{op: isa.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[90]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[91]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[92]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[93]      = isa.PackedForm{op: isa.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[94]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[95]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[96]      = isa.PackedForm{op: isa.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32};
    x64_model.packed_forms    = ?x64_packed_forms[0];
    x64_model.packed_form_len = 97;
    # the SSE2 baseline has no packed 8-bit multiply worth a sequence and no
    # packed integer divide at all
    var x64_scalar_forms: [63]isa.ScalarForm;
    x64_scalar_forms[0]    = isa.ScalarForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8};
    x64_scalar_forms[1]    = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8};
    x64_scalar_forms[2]    = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16};
    x64_scalar_forms[3]    = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32};
    x64_scalar_forms[4]    = isa.ScalarForm{op: isa.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64};
    x64_model.scalar_forms = ?x64_scalar_forms[0];
    val x64_conversions: u32 = 5 + isa.scalar_conversion_rows(?x64_model, ?x64_scalar_forms[0], 5);
    # the signed 32-to-64 widening multiply lands here unpacked; pmuldq is sse4.1, so it packs for targets that select sse41 once #3521's per-target extensions land
    val x64_widening: u32 = x64_conversions + isa.scalar_widening_rows(?x64_model, ?x64_scalar_forms[0], x64_conversions);
    x64_model.scalar_form_len        = x64_widening + isa.scalar_shift_rows(?x64_model, ?x64_scalar_forms[0], x64_widening);
    x64_model.vector_compute_generic = true;
    # every row is ALWAYS on Intel and AMD (#3508, owner ruling 2026-09-18), with the
    # kind of each claim marked:
    # intel, vendor guarantee: the DOIT guidance (software security guidance, intel.com)
    # states processors that do not enumerate DOITM may be assumed to behave as if it
    # were enabled for the listed instructions. intel, vendor list: MUL (F6, F7),
    # IMUL (69, 6B, 0F AF, F6, F7) and MULX (F6) are on that list, so every operand
    # size of the one- and two-operand forms. intel, measured per core: BearSSL's
    # ctmul table records a constant-time multiply since the first Pentium.
    # amd, evidence by table not by vendor document: AMD publishes no DOIT-equivalent
    # list and no mode control (absence, verified 2026-09-18); BearSSL's ctmul table
    # records a constant-time multiply at every width for every core from K7 through
    # Zen; no AMD x86-64 core is documented with a data-dependent multiplier
    # (absence); AMD SB-1039 advises constant-time algorithms, which presupposes
    # constant-time instructions (inference).
    # DOITM itself hardens the data dependent prefetcher and the fast store forwarding
    # predictor, memory-side and kernel-owned, and does not touch the multiplier (#3623)
    var x64_ct_mul: [20]ct.CtMulForm = [20]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
    };
    x64_model.extensions              = 0;
    x64_model.extension_table         = ?x64.EXTENSIONS[0];
    x64_model.extension_count         = x64.EXTENSION_COUNT;
    x64_model.level_table             = ?x64.LEVELS[0];
    x64_model.level_count             = x64.LEVEL_COUNT;
    x64_model.ct_mul_forms            = ?x64_ct_mul[0];
    x64_model.ct_mul_form_len         = 20;
    x64_model.has_var_shift           = true;
    x64_model.shift_count_mod_widths  = isa.SHIFT_MOD_4_8;
    x64_model.has_mul                 = true;
    x64_model.has_float               = x64.HAS_FLOAT;
    x64_model.mul_hi_width            = 0;
    x64_model.int_widths              = isa.INT_WIDTHS_1_2_4_8_16;
    x64_model.mul_wide_form           = isa.MULW_FIXED_PAIR;
    x64_model.flat_addressing         = true;
    x64_model.indexed_memory          = true;
    x64_model.sym_offset_bits         = 25;
    x64_model.mem_disp_bits           = 32;
    x64_model.structured_control_flow = false;
    x64_model.index_width             = 64;
    x64_model.vector_op_bytes         = 16;
    x64_model.vectors_in_registers    = true;
    x64_model.auto_vectorize          = true;
    x64_model.ct_trust_var_shift      = true;

    x64_model.reg_classes     = ?x64_classes[0];
    x64_model.reg_class_len   = 3;
    x64_model.frame_ptr_reg   = x64.FRAME_REG;
    x64_model.stack_ptr_reg   = x64.STACK_REG;
    x64_model.reserved_regs   = ?x64_reserved_regs[0];
    x64_model.reserved_len    = 2;
    x64_model.div_reg         = x64.RAX;
    x64_model.div_hi_reg      = x64.RDX;
    x64_model.shift_count_reg = x64.RCX;
    # SSE2 shifts 16-, 32- and 64-bit lanes and no 8-bit ones
    x64_model.packed_shift_min_bits = 16;

    x64_model.incoming_arg_base = 16;
    x64_model.stack_align       = 0;
    x64_model.red_zone          = 0;
    x64_model.shadow_space      = 0;

    ret isa.register(reg, ?x64_vtable);
}

# tests: the declared ELF type, or zero for an absent one
fun reloc_type_or_zero(t: opt[u32]) u32 {
    if (sel t.none) { ret 0; }
    ret t.some;
}

test "mach.lang.target.isa.x64.register.x64_elf_reloc_type:forward_map" {
    if (reloc_type_or_zero(x64_elf_reloc_type(of.RK_ABS64)) != elf.R_X86_64_64)          { ret 1; }
    if (reloc_type_or_zero(x64_elf_reloc_type(of.RK_PC32)) != elf.R_X86_64_PC32)         { ret 1; }
    if (reloc_type_or_zero(x64_elf_reloc_type(of.RK_PLT32)) != elf.R_X86_64_PLT32)       { ret 1; }
    if (reloc_type_or_zero(x64_elf_reloc_type(of.RK_GOTPCREL)) != elf.R_X86_64_GOTPCREL) { ret 1; }
    if (reloc_type_or_zero(x64_elf_reloc_type(of.RK_ABS32S)) != elf.R_X86_64_32S)        { ret 1; }
    if (reloc_type_or_zero(x64_elf_reloc_type(of.RK_ABS32)) != elf.R_X86_64_32)          { ret 1; }

    val r_280: opt[u32] = x64_elf_reloc_type(of.RK_ADDR32NB);
    if (sel r_280.some) { ret 1; }
    val r_281: opt[u32] = x64_elf_reloc_type(of.RK_PAGE21);
    if (sel r_281.some) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.register.x64_dwarf_reg:psabi_numbers" {
    if (x64_dwarf_reg(x64.RAX) != 0)  { ret 1; }
    if (x64_dwarf_reg(x64.RDX) != 1)  { ret 1; }
    if (x64_dwarf_reg(x64.RCX) != 2)  { ret 1; }
    if (x64_dwarf_reg(x64.RBX) != 3)  { ret 1; }
    if (x64_dwarf_reg(x64.RSI) != 4)  { ret 1; }
    if (x64_dwarf_reg(x64.RDI) != 5)  { ret 1; }
    if (x64_dwarf_reg(x64.RBP) != 6)  { ret 1; }
    if (x64_dwarf_reg(x64.RSP) != 7)  { ret 1; }
    if (x64_dwarf_reg(x64.R8) != 8)   { ret 1; }
    if (x64_dwarf_reg(x64.R15) != 15) { ret 1; }

    if (x64_dwarf_reg(x64.FRAME_REG) != 6) { ret 1; }

    if (x64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM0)) != 17)  { ret 1; }
    if (x64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM15)) != 32) { ret 1; }

    if (x64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_GP, 16)) != -1)  { ret 1; }
    if (x64_dwarf_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, 16)) != -1) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.x64.register.x64_cv_reg:cvconst_numbers" {
    if (x64_cv_reg(x64.RAX) != 328) { ret 1; }
    if (x64_cv_reg(x64.RBX) != 329) { ret 1; }
    if (x64_cv_reg(x64.RCX) != 330) { ret 1; }
    if (x64_cv_reg(x64.RDX) != 331) { ret 1; }
    if (x64_cv_reg(x64.RSI) != 332) { ret 1; }
    if (x64_cv_reg(x64.RDI) != 333) { ret 1; }
    if (x64_cv_reg(x64.RBP) != 334) { ret 1; }
    if (x64_cv_reg(x64.RSP) != 335) { ret 1; }
    if (x64_cv_reg(x64.R8) != 336)  { ret 1; }
    if (x64_cv_reg(x64.R15) != 343) { ret 1; }

    if (x64_cv_reg(x64.FRAME_REG) != 334) { ret 1; }

    if (x64_cv_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM0)) != 154)  { ret 1; }
    if (x64_cv_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM7)) != 161)  { ret 1; }
    if (x64_cv_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM8)) != 252)  { ret 1; }
    if (x64_cv_reg(isa.regid_make(isa.REG_CLASS_ID_XMM, x64.XMM15)) != 259) { ret 1; }

    if (x64_cv_reg(isa.regid_make(isa.REG_CLASS_ID_GP, 16)) != -1) { ret 1; }
    ret 0;
}

# the rows are Intel's DOIT multiply list at every operand size, every one held
# unconditionally on Intel and AMD (#3508)
test "mach.lang.target.isa.x64.register.register_x64:declares_the_doit_multiply_list" {
    var reg: isa.IsaRegistry = isa.registry_init();
    fin { isa.registry_dnit(?reg); }
    val r_reg: err[fail.Fail] = register_x64(?reg);
    if (sel r_reg.err) { ret 1; }
    val v: opt[*isa.IsaVTable] = isa.lookup(?reg, isa.arch_name_for(isa.ARCH_X86_64));
    if (sel v.none) { ret 1; }
    val m: *isa.MachineModel = v.some.model;
    if (m.ct_mul_form_len != 20) { ret 2; }
    val ops:    [5]ct.CtMulOp = [5]ct.CtMulOp{ct.CT_MUL_LOW, ct.CT_MUL_HIGH_U, ct.CT_MUL_HIGH_S, ct.CT_MUL_WIDE_U, ct.CT_MUL_WIDE_S};
    val widths: [4]u8         = [4]u8{8, 16, 32, 64};
    var want:   ct.CtMulMask  = ct.mul_mask_none();
    var oi:     u32           = 0;
    for (oi < 5) {
        var wi: u32 = 0;
        for (wi < 4) {
            ct.mul_mask_add(?want, ct.mul_cell(ops[oi], widths[wi], false));
            wi = wi + 1;
        }
        oi = oi + 1;
    }
    # realized, not declared: the low half of a 128-bit product is the
    # schoolbook over the 64-bit low and widening cells (#3511)
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 128, false));
    if (!ct.mul_mask_equals(isa.ct_mul_rows_admit(m, true), want))  { ret 3; }
    if (!ct.mul_mask_equals(isa.ct_mul_rows_admit(m, false), want)) { ret 4; }
    var i: u32 = 0;
    for (i < m.ct_mul_form_len) {
        if (m.ct_mul_forms[i].cond != ct.CT_MUL_ALWAYS || m.ct_mul_forms[i].ext != 0) { ret 5; }
        i = i + 1;
    }
    ret 0;
}
