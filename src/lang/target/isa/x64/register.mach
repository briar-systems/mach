use target_model:  mach.lang.target.model;
use target_of:     mach.lang.target.of;
use mach.lang.target.of.elf;

# a realigned frame keeps its callee saves above the realigned rsp, outside
# the distance from rsp to the slots
fun x64_frame_dist(model: *target_model.Machine, func: *lang_mir.MirFunction, base_dist: *u32, fp_dist: *u32) err[fail.Fail] {
    var gp_bytes: u32 = common.popcount32(func.callee_mask) * 8;
    var fp_bytes: u32 = common.popcount32(func.callee_mask_fp) * 16;
    if (func.frame.realign != 0) {
        gp_bytes = 0;
        fp_bytes = 0;
    }
    val saved: res[u32, fail.Fail] = common.frame_align_up(func.frame.size + gp_bytes, 16);
    if (sel saved.err) { ret err[fail.Fail].err{saved.err}; }
    val base: res[u32, fail.Fail] = common.frame_align_up(saved.ok + fp_bytes, 16);
    if (sel base.err) { ret err[fail.Fail].err{base.err}; }
    val total: res[u32, fail.Fail] = common.frame_align_up(base.ok + func.frame.outgoing_size, func.frame.realign);
    if (sel total.err) { ret err[fail.Fail].err{total.err}; }
    @base_dist = total.ok;
    @fp_dist   = 0;
    ret err[fail.Fail].ok{};
}

fun x64_elf_reloc_type(kind: target_of.RelocKind) opt[u32] {
    if (kind == target_of.RK_ABS64)    { ret opt[u32].some{elf.R_X86_64_64}; }
    if (kind == target_of.RK_PC32)     { ret opt[u32].some{elf.R_X86_64_PC32}; }
    if (kind == target_of.RK_PC64)     { ret opt[u32].some{elf.R_X86_64_PC64}; }
    if (kind == target_of.RK_PLT32)    { ret opt[u32].some{elf.R_X86_64_PLT32}; }
    if (kind == target_of.RK_GOTPCREL) { ret opt[u32].some{elf.R_X86_64_GOTPCREL}; }
    if (kind == target_of.RK_ABS32S)   { ret opt[u32].some{elf.R_X86_64_32S}; }
    if (kind == target_of.RK_ABS32)    { ret opt[u32].some{elf.R_X86_64_32}; }
    ret opt[u32].none{};
}

val DWARF_XMM0: i32 = 17;

val CV_AMD64_RAX:  i32 = 328;
val CV_AMD64_XMM0: i32 = 154;
val CV_AMD64_XMM8: i32 = 252;

fun x64_dwarf_reg(regid: i32) i32 {
    val cls: i32 = isa_inst.regid_class(regid);
    val idx: i32 = isa_inst.regid_index(regid);

    if (cls == isa_inst.REG_CLASS_ID_GP) {
        if (idx == x64.RAX)                  { ret 0; }
        if (idx == x64.RDX)                  { ret 1; }
        if (idx == x64.RCX)                  { ret 2; }
        if (idx == x64.RBX)                  { ret 3; }
        if (idx == x64.RSI)                  { ret 4; }
        if (idx == x64.RDI)                  { ret 5; }
        if (idx == x64.RBP)                  { ret 6; }
        if (idx == x64.RSP)                  { ret 7; }
        if (idx >= x64.R8 && idx <= x64.R15) { ret idx; }
        ret -1;
    }

    if (cls == isa_inst.REG_CLASS_ID_XMM) {
        if (idx >= x64.XMM0 && idx <= x64.XMM15) { ret DWARF_XMM0 + idx; }
        ret -1;
    }

    ret -1;
}

fun x64_cv_reg(regid: i32) i32 {
    val cls: i32 = isa_inst.regid_class(regid);
    val idx: i32 = isa_inst.regid_index(regid);

    if (cls == isa_inst.REG_CLASS_ID_GP) {
        if (idx == x64.RAX)                  { ret CV_AMD64_RAX + 0; }
        if (idx == x64.RBX)                  { ret CV_AMD64_RAX + 1; }
        if (idx == x64.RCX)                  { ret CV_AMD64_RAX + 2; }
        if (idx == x64.RDX)                  { ret CV_AMD64_RAX + 3; }
        if (idx == x64.RSI)                  { ret CV_AMD64_RAX + 4; }
        if (idx == x64.RDI)                  { ret CV_AMD64_RAX + 5; }
        if (idx == x64.RBP)                  { ret CV_AMD64_RAX + 6; }
        if (idx == x64.RSP)                  { ret CV_AMD64_RAX + 7; }
        if (idx >= x64.R8 && idx <= x64.R15) { ret CV_AMD64_RAX + idx; }
        ret -1;
    }

    if (cls == isa_inst.REG_CLASS_ID_XMM) {
        if (idx >= x64.XMM0 && idx <= x64.XMM7)  { ret CV_AMD64_XMM0 + idx; }
        if (idx >= x64.XMM8 && idx <= x64.XMM15) { ret CV_AMD64_XMM8 + (idx - x64.XMM8); }
        ret -1;
    }

    ret -1;
}

pub fun register_x64(reg: *isa.IsaRegistry) err[fail.Fail] {
    var x64_classes:             [3]target_model.RegClass;
    var x64_model:               target_model.Machine;
    var x64_reserved_regs:       [2]target_model.Register;
    var x64_reload_scratch_regs: [1]target_model.Register;

    x64_classes[0].name = "gpr";
    x64_classes[0].kind = target_model.RC_GENERAL;
    x64_classes[0].len  = 16;

    x64_classes[1].name = "xmm";
    x64_classes[1].kind = target_model.RC_FLOAT;
    x64_classes[1].len  = 14;

    x64_classes[2].name = "flags";
    x64_classes[2].kind = target_model.RC_FLAGS;
    x64_classes[2].len  = 1;

    x64_reserved_regs[0].id   = x64.STACK_REG;
    x64_reserved_regs[0].size = 8;
    x64_reserved_regs[1].id   = x64.FRAME_REG;
    x64_reserved_regs[1].size = 8;

    # r10 is the second scratch already; a reload that needs more borrows a
    # pool register the allocator keeps free at that instruction
    x64_reload_scratch_regs[0].id   = x64.R10;
    x64_reload_scratch_regs[0].size = 8;

    var x64_machine: isa.RegMachine = isa.reg_machine(
        x64_rules.select,
        x64_encode.encode_x64,
        x64_rules.is_reg_move,
        x64_rules.is_trap_terminator,
        ?x64_reserved_regs[0], 2,
        ?x64_reload_scratch_regs[0], 1,
        x64.SCRATCH_REG, x64.SCRATCH_REG2,
        x64.FRAME_REG, x64.STACK_REG, 16,
        x64.RAX, x64.RDX, x64.RCX);
    isa.with_assembly(?x64_machine, x64_encode.encode_x64_asm, x64_encode.asm_clobbers,
        x64_encode.asm_returns, x64_encode.asm_ct_scan, x64_encode.asm_writes_sp);
    isa.with_dwarf_regs(?x64_machine, x64_dwarf_reg);
    isa.with_codeview_regs(?x64_machine, x64_cv_reg);
    isa.with_frame_dist(?x64_machine, x64_frame_dist);
    isa.with_int_imm_rule(?x64_machine, x64_rules.int_imm_fits);
    isa.with_const_operand_rule(?x64_machine, x64_encode.reads_const_operand);

    var x64_reloc: isa.RelocSeam = isa.reloc_seam(
        isa_x64_reloc.apply_reloc, isa_x64_reloc.reloc_traits, x64_elf_reloc_type);
    isa.with_local_got_kinds(?x64_reloc, isa_x64_reloc.is_local_got_kind);

    var x64_vtable: isa.IsaVTable = isa.machine_isa(
        isa.ARCH_X86_64, catalog_arch.name_for(isa.ARCH_X86_64), 62, 8,
        ?x64_model, ?x64_machine, ?x64_reloc);
    isa.with_page_size(?x64_vtable, 4096);

    target_model.declare_alu_widths(?x64_model, target_model.ALU_WIDTHS_4_8);
    x64_model.pointer_width       = 8;
    x64_model.gpr_width           = 8;
    x64_model.gp_unaligned_widths = 2 + 4 + 8;
    x64_model.spill_width         = 8;
    x64_model.endianness          = target_model.ENDIAN_LITTLE;
    x64_model.flen_bits           = 64;
    x64_model.has_v128            = true;
    x64_model.vector_bits         = target_model.VECTOR_BITS_128;
    x64_model.max_vector_lanes    = target_model.VECTOR_LANES_UNBOUNDED;
    x64_model.vec_mem_widths      = target_model.VEC_MEM_4_8_16;
    x64_model.xbank_widths        = target_model.XBANK_4_8;
    x64_model.slot_read_widths    = target_model.SLOT_READ_1_2_4_8;
    x64_model.lifetime_holes      = true;

    x64_model.nan_rule = float.NAN_PRESERVE;
    # an sse operation on two NaNs returns the first, quieted (SDM vol 1, table 4-7)
    x64_model.nan_first_operand = true;
    # pmovsx and pmovzx take a lane to twice, four or eight times its width
    x64_model.direct_extend     = true;
    x64_model.direct_extend_ext = x64.EXT_SSE41;

    var x64_packed_forms: [144]target_model.PackedForm;
    x64_packed_forms[0]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[1]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[2]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[3]  = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[4]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[5]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[6]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[7]  = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[8]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[9]  = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[10] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[11] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[12] = target_model.PackedForm{op: target_model.VEC_OP_AND, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[13] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[14] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[15] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[16] = target_model.PackedForm{op: target_model.VEC_OP_OR, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[17] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[18] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[19] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[20] = target_model.PackedForm{op: target_model.VEC_OP_XOR, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[21] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[22] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[23] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[24] = target_model.PackedForm{op: target_model.VEC_OP_NOT, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[25] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[26] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[27] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[28] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[29] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[30] = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[31] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[32] = target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[33] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[34] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[35] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[36] = target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[37] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[38] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 64, from_bits: 64};
    # the SSE2 conversions agree with the scalar lane conversion bit for bit:
    # integer widening and narrowing are exact, a float lane converts under the
    # same rounding, and a truncating float lane lands on the same 32-bit
    # integer indefinite that the scalar cvtts*2si produces. an unsigned float
    # to integer lane converts through 64 bits in the scalar and has no packed
    # SSE2 twin, nor does any 64-bit integer lane that meets a float
    x64_packed_forms[39] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[40] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    x64_packed_forms[41] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 8};
    x64_packed_forms[42] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[43] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 16};
    x64_packed_forms[44] = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[45] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[46] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 8};
    x64_packed_forms[47] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 8};
    x64_packed_forms[48] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[49] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 16};
    x64_packed_forms[50] = target_model.PackedForm{op: target_model.VEC_OP_ZEXT, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[51] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 16};
    x64_packed_forms[52] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 32};
    x64_packed_forms[53] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 8, from_bits: 64};
    x64_packed_forms[54] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 32};
    x64_packed_forms[55] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 16, from_bits: 64};
    x64_packed_forms[56] = target_model.PackedForm{op: target_model.VEC_OP_TRUNC, is_float: false, lane_bits: 32, from_bits: 64};
    x64_packed_forms[57] = target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 32};
    x64_packed_forms[58] = target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 32, from_bits: 64};
    x64_packed_forms[59] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    x64_packed_forms[60] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    x64_packed_forms[61] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[62] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    x64_packed_forms[63] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    x64_packed_forms[64] = target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 64, from_bits: 32};
    x64_packed_forms[65] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 8};
    x64_packed_forms[66] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 32, from_bits: 16};
    x64_packed_forms[67] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 8};
    x64_packed_forms[68] = target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 64, from_bits: 16};
    x64_packed_forms[69] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 32};
    x64_packed_forms[70] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 32};
    x64_packed_forms[71] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[72] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 8, from_bits: 64};
    x64_packed_forms[73] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 16, from_bits: 64};
    x64_packed_forms[74] = target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 64};
    # the widening multiplies SSE2 packs: pmullw beside pmulhw or pmulhuw for
    # 16-bit operand lanes, and pmuludq for unsigned 32-bit ones. SSE2 has no
    # signed 32-bit widening multiply (pmuldq is SSE4.1), and an 8-bit operand
    # lane is already the packed extension and pmullw
    x64_packed_forms[75] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_S, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[76] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[77] = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 64, from_bits: 32};
    # the 32- and 64-bit low multiplies are baseline: SSE2 realizes them as
    # pmuludq sequences, and the 32-bit one is pmulld under its sse41
    # row, which the encoder reads to choose it
    x64_packed_forms[78]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[103] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_SSE41};
    x64_packed_forms[85]  = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64};
    # the lane-halving extensions are baseline: SSE2 realizes every cell as
    # an unpack against zero or against the sign mask, and each is
    # pmovsx/pmovzx under its sse41 row, which the encoder reads to choose it
    x64_packed_forms[79]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[80]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[81]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[82]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[83]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[84]  = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32};
    x64_packed_forms[104] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 16, from_bits: 8, ext: x64.EXT_SSE41};
    x64_packed_forms[105] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 32, from_bits: 16, ext: x64.EXT_SSE41};
    x64_packed_forms[106] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_S, is_float: false, lane_bits: 64, from_bits: 32, ext: x64.EXT_SSE41};
    x64_packed_forms[107] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 16, from_bits: 8, ext: x64.EXT_SSE41};
    x64_packed_forms[108] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 32, from_bits: 16, ext: x64.EXT_SSE41};
    x64_packed_forms[109] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_U, is_float: false, lane_bits: 64, from_bits: 32, ext: x64.EXT_SSE41};
    # a uniform shift count is baseline at 16, 32 and 64 bits: psll*, psrl*
    # and psra* by an immediate or by the count in an xmm register's low
    # quadword, which saturate at or above the lane width as the scalar shift
    # does. 8-bit lanes have no packed shift and shift as 16-bit lanes
    # with the neighbouring byte cleared, and a 64-bit arithmetic shift is
    # psraq, which is avx512vl, so it keeps the lane path
    x64_packed_forms[86] = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[87] = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[88] = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[89] = target_model.PackedForm{op: target_model.VEC_OP_SHL_U, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[90] = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[91] = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[92] = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[93] = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_U, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[94] = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[95] = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[96] = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 32, from_bits: 32};
    # a per-lane count packs under avx2 at 32 and 64 bits: vpsllv* and vpsrlv*
    # at both, vpsravd at 32 only (vpsravq is avx512vl), each saturating a lane
    # count at or above the lane width as the scalar shift does
    x64_packed_forms[122] = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_AVX2};
    x64_packed_forms[123] = target_model.PackedForm{op: target_model.VEC_OP_SHL_V, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_AVX2};
    x64_packed_forms[124] = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_AVX2};
    x64_packed_forms[125] = target_model.PackedForm{op: target_model.VEC_OP_SHR_U_V, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_AVX2};
    x64_packed_forms[126] = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_V, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_AVX2};
    # the 64-bit lane multiply is one vpmullq under avx512dq, whose 128-bit
    # evex form is avx512vl as well
    x64_packed_forms[127] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_AVX512DQ | x64.EXT_AVX512VL};
    # a lane range is baseline at every lane: a move at lane 0, one pshufd at a
    # doubleword-aligned first lane and psrldq at any other, and the
    # psrldq is one palignr under its ssse3 row, which the encoder reads
    x64_packed_forms[97]  = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[98]  = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[99]  = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[100] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[101] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[102] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 64, from_bits: 64};
    x64_packed_forms[110] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 8, from_bits: 8, ext: x64.EXT_SSSE3};
    x64_packed_forms[111] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 16, from_bits: 16, ext: x64.EXT_SSSE3};
    x64_packed_forms[112] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 32, from_bits: 32, ext: x64.EXT_SSSE3};
    x64_packed_forms[113] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSSE3};
    x64_packed_forms[114] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 32, from_bits: 32, ext: x64.EXT_SSSE3};
    x64_packed_forms[115] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSSE3};
    # a lane join is baseline at every lane: punpcklqdq when the low part fills
    # a quadword, otherwise the low part cleared above its bytes by a shift pair
    # and the high part shifted up to meet it with por
    x64_packed_forms[116] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[117] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[118] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 32, from_bits: 32};
    x64_packed_forms[119] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: false, lane_bits: 64, from_bits: 64};
    x64_packed_forms[120] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 32, from_bits: 32};
    x64_packed_forms[121] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 64, from_bits: 64};
    # an f16 lane moves as the 16-bit lane it is: the ranges and joins of its
    # bits are the integer ones
    x64_packed_forms[128] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 16, from_bits: 16};
    x64_packed_forms[129] = target_model.PackedForm{op: target_model.VEC_OP_RANGE, is_float: true, lane_bits: 16, from_bits: 16, ext: x64.EXT_SSSE3};
    x64_packed_forms[130] = target_model.PackedForm{op: target_model.VEC_OP_CONCAT, is_float: true, lane_bits: 16, from_bits: 16};
    # f16c converts four f16 lanes to and from binary32 in one instruction
    # (vcvtph2ps, vcvtps2ph imm 0), each lane as the scalar f16c row does: exact
    # widening, one rounding to nearest even, a NaN kept and quieted. f16 lane
    # arithmetic has no packed row below avx512 fp16, so it computes in
    # these binary32 lanes where the scalar rule does, and lane by lane otherwise
    x64_packed_forms[131] = target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: x64.EXT_F16C};
    x64_packed_forms[132] = target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: x64.EXT_F16C};
    # pmulhw and pmulhuw are the high multiply of 16-bit lanes, and punpckl*
    # and punpckh* interleave a half of two registers into lanes twice as
    # wide: the widening multiply of 16-bit lanes is pmullw and pmulhw
    # interleaved, so both halves of one product share the pair
    x64_packed_forms[133] = target_model.PackedForm{op: target_model.VEC_OP_MUL_HIGH_S, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[134] = target_model.PackedForm{op: target_model.VEC_OP_MUL_HIGH_U, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[135] = target_model.PackedForm{op: target_model.VEC_OP_INTERLEAVE, is_float: false, lane_bits: 16, from_bits: 8};
    x64_packed_forms[136] = target_model.PackedForm{op: target_model.VEC_OP_INTERLEAVE, is_float: false, lane_bits: 32, from_bits: 16};
    x64_packed_forms[137] = target_model.PackedForm{op: target_model.VEC_OP_INTERLEAVE, is_float: false, lane_bits: 64, from_bits: 32};
    # psadbw against zero sums each quadword's eight bytes into it
    x64_packed_forms[138] = target_model.PackedForm{op: target_model.VEC_OP_WIDEN_SUM_U, is_float: false, lane_bits: 64, from_bits: 8};
    # pcmpgt* of a cleared register against the lanes is each lane's sign mask,
    # which a signed lane-halving extension interleaves with
    x64_packed_forms[139] = target_model.PackedForm{op: target_model.VEC_OP_SIGN_MASK, is_float: false, lane_bits: 8, from_bits: 8};
    x64_packed_forms[140] = target_model.PackedForm{op: target_model.VEC_OP_SIGN_MASK, is_float: false, lane_bits: 16, from_bits: 16};
    x64_packed_forms[141] = target_model.PackedForm{op: target_model.VEC_OP_SIGN_MASK, is_float: false, lane_bits: 32, from_bits: 32};
    # a 64-bit lane ordering is one pcmpgtq under sse42, which the encoder
    # reads to choose it over the dword sequence
    x64_packed_forms[142] = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSE42};
    # and a 64-bit lane equality is one pcmpeqq under sse41
    x64_packed_forms[143]     = target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: false, lane_bits: 64, from_bits: 64, ext: x64.EXT_SSE41};
    x64_model.packed_forms    = ?x64_packed_forms[0];
    x64_model.packed_form_len = 144;
    # f16c converts between f16 and binary32 only (vcvtph2ps, vcvtps2ph), so f16
    # arithmetic widens to binary32 there, which one rounding back makes exact
    # for + - * /. each conversion keeps a NaN's sign and the top of its payload
    # and quiets it, as the expansion does. binary64 and the integers stay the
    # expansion: the conversion through binary32 would round twice. the avx512
    # fp16 rows need the evex encoding
    var x64_half_forms: [2]target_model.PackedForm = [2]target_model.PackedForm{
        target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: x64.EXT_F16C},
        target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: x64.EXT_F16C},
    };
    x64_model.half_forms    = ?x64_half_forms[0];
    x64_model.half_form_len = 2;
    # the SSE2 baseline has no packed 8-bit multiply worth a sequence and no
    # packed integer divide at all
    var x64_scalar_forms: [5]target_model.ScalarForm = [5]target_model.ScalarForm{
        target_model.ScalarForm{op: target_model.VEC_OP_MUL, is_float: false, lane_bits: 8, from_bits: 8},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 8, from_bits: 8},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 16, from_bits: 16},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 32, from_bits: 32},
        target_model.ScalarForm{op: target_model.VEC_OP_DIV, is_float: false, lane_bits: 64, from_bits: 64},
    };
    # the signed 32-to-64 widening multiply lands here unpacked; pmuldq is sse4.1, so it packs for targets that select sse41
    val x64_rows: err[fail.Fail] = isa.declare_scalar_rows(reg, ?x64_model, ?x64_scalar_forms[0], 5,
        target_model.SCALAR_CONVERSIONS | target_model.SCALAR_WIDENING | target_model.SCALAR_SHIFTS | target_model.SCALAR_HALF_LANES);
    if (sel x64_rows.err) { ret x64_rows; }
    fin { isa.release_scalar_rows(reg, ?x64_model); }
    x64_model.vector_compute_generic = true;
    # every row is ALWAYS on Intel and AMD, with the
    # kind of each claim marked:
    # intel, vendor guarantee: the DOIT guidance (software security guidance, intel.com)
    # states processors that do not enumerate DOITM may be assumed to behave as if it
    # were enabled for the listed instructions. intel, vendor list: MUL (F6, F7),
    # IMUL (69, 6B, 0F AF, F6, F7) and MULX (F6) are on that list, so every operand
    # size of the one- and two-operand forms. intel, measured per core: BearSSL's
    # ctmul table records a constant-time multiply since the first Pentium.
    # amd, evidence by table not by vendor document: AMD publishes no DOIT-equivalent
    # list and no mode control (absence, verified 2026-09-18); BearSSL's ctmul table
    # records a constant-time multiply at every width for every core from K7 through
    # Zen; no AMD x86-64 core is documented with a data-dependent multiplier
    # (absence); AMD SB-1039 advises constant-time algorithms, which presupposes
    # constant-time instructions (inference).
    # DOITM itself hardens the data dependent prefetcher and the fast store forwarding
    # predictor, memory-side and kernel-owned, and does not touch the multiplier
    var x64_ct_mul: [20]ct.CtMulForm = [20]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 8, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
    };
    # avx widens every xmm register to its ymm, 32 bytes. a ymm value leaves
    # the legacy-encoded sse of the 128-bit rows and the scalar float code
    # paying for its upper half until vzeroupper clears it
    var x64_register_rows: [1]target_model.VectorRegisterRow = [1]target_model.VectorRegisterRow{
        target_model.VectorRegisterRow{ext: x64.EXT_AVX, bytes: 32, upper_clear: true},
    };
    x64_model.vector_register_rows    = ?x64_register_rows[0];
    x64_model.vector_register_row_len = 1;
    # the packed rows run at vex.256 over the whole ymm register: avx
    # has the float arithmetic, compares and conversions at 256 bits, and an
    # f16 lane moves in the 128-bit lane crossings avx has as well; avx2 brings
    # every integer row
    var x64_width_rows: [2]target_model.VectorWidthRow = [2]target_model.VectorWidthRow{
        target_model.VectorWidthRow{ext: x64.EXT_AVX, is_float: true, lanes: 2 + 4 + 8, bits: 256},
        target_model.VectorWidthRow{ext: x64.EXT_AVX2, is_float: false, lanes: 1 + 2 + 4 + 8, bits: 256},
    };
    x64_model.vector_width_rows       = ?x64_width_rows[0];
    x64_model.vector_width_row_len    = 2;
    x64_model.extensions              = 0;
    x64_model.extension_table         = ?x64.EXTENSIONS[0];
    x64_model.extension_count         = x64.EXTENSION_COUNT;
    x64_model.level_table             = ?x64.LEVELS[0];
    x64_model.level_count             = x64.LEVEL_COUNT;
    x64_model.ct_mul_forms            = ?x64_ct_mul[0];
    x64_model.ct_mul_form_len         = 20;
    x64_model.has_var_shift           = true;
    x64_model.shift_count_mod_widths  = target_model.SHIFT_MOD_4_8;
    x64_model.has_mul                 = true;
    x64_model.has_float               = x64.HAS_FLOAT;
    x64_model.mul_hi_width            = 8;
    x64_model.int_widths              = target_model.INT_WIDTHS_1_2_4_8_16;
    x64_model.mul_wide_form           = target_model.MULW_FIXED_PAIR;
    x64_model.flat_addressing         = true;
    x64_model.indexed_memory          = true;
    x64_model.sym_offset_bits         = 25;
    x64_model.mem_disp_bits           = 32;
    x64_model.function_align          = 16;
    x64_model.code_fill               = 0xCC;
    x64_model.structured_control_flow = false;
    x64_model.index_width             = 64;
    x64_model.vector_op_bytes         = 16;
    x64_model.vectors_in_registers    = true;
    x64_model.auto_vectorize          = true;
    x64_model.ct_trust_var_shift      = true;

    x64_model.reg_classes     = ?x64_classes[0];
    x64_model.reg_class_len   = 3;
    x64_model.frame_ptr_reg   = x64.FRAME_REG;
    x64_model.stack_ptr_reg   = x64.STACK_REG;
    x64_model.reserved_regs   = ?x64_reserved_regs[0];
    x64_model.reserved_len    = 2;
    x64_model.div_reg         = x64.RAX;
    x64_model.div_hi_reg      = x64.RDX;
    x64_model.shift_count_reg = x64.RCX;
    # SSE2 shifts 16-, 32- and 64-bit lanes and no 8-bit ones
    x64_model.packed_shift_min_bits = 16;

    x64_model.incoming_arg_base = 16;
    x64_model.stack_align       = 0;
    x64_model.red_zone          = 0;
    x64_model.shadow_space      = 0;

    ret isa.register(reg, ?x64_vtable);
}

test x64_elf_reloc_type__forward_map {
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_ABS64)) != elf.R_X86_64_64)          { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_PC32)) != elf.R_X86_64_PC32)         { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_PLT32)) != elf.R_X86_64_PLT32)       { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_GOTPCREL)) != elf.R_X86_64_GOTPCREL) { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_ABS32S)) != elf.R_X86_64_32S)        { ret 1; }
    if (common.reloc_type_or_zero(x64_elf_reloc_type(target_of.RK_ABS32)) != elf.R_X86_64_32)          { ret 1; }

    val r_280: opt[u32] = x64_elf_reloc_type(target_of.RK_ADDR32NB);
    if (sel r_280.some) { ret 1; }
    val r_281: opt[u32] = x64_elf_reloc_type(target_of.RK_PAGE21);
    if (sel r_281.some) { ret 1; }
    ret 0;
}

test x64_dwarf_reg__psabi_numbers {
    if (x64_dwarf_reg(x64.RAX) != 0)  { ret 1; }
    if (x64_dwarf_reg(x64.RDX) != 1)  { ret 1; }
    if (x64_dwarf_reg(x64.RCX) != 2)  { ret 1; }
    if (x64_dwarf_reg(x64.RBX) != 3)  { ret 1; }
    if (x64_dwarf_reg(x64.RSI) != 4)  { ret 1; }
    if (x64_dwarf_reg(x64.RDI) != 5)  { ret 1; }
    if (x64_dwarf_reg(x64.RBP) != 6)  { ret 1; }
    if (x64_dwarf_reg(x64.RSP) != 7)  { ret 1; }
    if (x64_dwarf_reg(x64.R8) != 8)   { ret 1; }
    if (x64_dwarf_reg(x64.R15) != 15) { ret 1; }

    if (x64_dwarf_reg(x64.FRAME_REG) != 6) { ret 1; }

    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_XMM, x64.XMM0)) != 17)  { ret 1; }
    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_XMM, x64.XMM15)) != 32) { ret 1; }

    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_GP, 16)) != -1)  { ret 1; }
    if (x64_dwarf_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_XMM, 16)) != -1) { ret 1; }
    ret 0;
}

