# the extension surface at run time, reached only by `mach test`: an outlier's
# address dispatches through a function pointer, cpuid names its vendor, and
# the sha bodies build without being called. a call into them would first test
# the extension (cpuid leaf 7, ebx bit 29 for sha on x86_64)
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

# no instruction here needs either extension, so any host may call it
#[extensions(sse41, sha2)]
fun outlier_add(v: i32) i32 {
    ret v + 1;
}

fun dispatch(f: fun(i32) i32, v: i32) i32 {
    ret f(v);
}

test "mach.lang.target.isa.asm.extensions:an_outlier_dispatches_through_a_function_pointer" {
    val f: fun(i32) i32 = outlier_add;
    if (f(41) != 42)                   { ret 1; }
    if (dispatch(outlier_add, 1) != 2) { ret 2; }
    ret 0;
}

fun printable(word: u32) bool {
    var i: u32 = 0;
    for (i < 4) {
        val b: u32 = (word >> (i * 8)) & 0xFF;
        if (b < 0x20 || b > 0x7E) { ret false; }
        i = i + 1;
    }
    ret true;
}

$if ($mach.build.arch == $mach.arch.x86_64) {
    # every x86_64 extension row once; built, never called
    #[extensions(sha, ssse3, sse41)]
    fun sha_rows(block: *u8, state: *u8) {
        asm x86_64 {
            mov rsi, {block}
            mov rdi, {state}
            movdqu xmm1, [rdi]
            movdqu xmm2, [rdi + 16]
            movdqu xmm0, [rsi]
            pshufb xmm0, xmm0
            palignr xmm1, xmm2, 8
            pblendw xmm2, xmm1, 0xF0
            sha256msg1 xmm0, xmm1
            sha256msg2 xmm0, xmm2
            sha256rnds2 xmm2, xmm1
            pinsrd xmm1, eax, 1
            pextrd ecx, xmm2, 3
            ptest xmm1, xmm2
            movdqu [rdi], xmm1
            movdqu [rdi + 16], xmm2
        }
    }

    test "mach.lang.target.isa.asm.extensions:cpuid_leaf_zero_names_a_printable_vendor" {
        var top: u32 = 0;
        var b:   u32 = 0;
        var c:   u32 = 0;
        var d:   u32 = 0;
        asm x86_64 {
            xor eax, eax
            xor ecx, ecx
            cpuid
            mov {top}, eax
            mov {b}, ebx
            mov {c}, ecx
            mov {d}, edx
        }
        # the vendor is ebx, edx, ecx: twelve printable bytes
        if (!printable(b) || !printable(d) || !printable(c)) { ret 1; }
        if (top == 0)                                        { ret 2; }
        val kept: fun(*u8, *u8) = sha_rows;
        if (kept == nil) { ret 3; }
        ret 0;
    }
}
$or ($mach.build.arch == $mach.arch.aarch64) {
    # every aarch64 sha2 row once; built, never called
    #[extensions(sha2)]
    fun sha_rows(block: *u8, state: *u8) {
        asm aarch64 {
            ldr x0, {block}
            ldr x1, {state}
            ld1 {v0.4s}, [x0]
            ld1 {v1.4s}, [x1]
            sha256su0 v0.4s, v1.4s
            sha256su1 v0.4s, v1.4s, v2.4s
            sha256h q1, q2, v0.4s
            sha256h2 q2, q1, v0.4s
            st1 {v1.4s}, [x1]
        }
    }

    test "mach.lang.target.isa.asm.extensions:sha2_rows_build" {
        val kept: fun(*u8, *u8) = sha_rows;
        if (kept == nil) { ret 1; }
        ret 0;
    }
}
