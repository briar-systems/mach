# the aes and carry-less multiply rows run against published answers, reached
# only by `mach test --lib tests` (#3835): the FIPS-197 appendix C.1 AES-128
# cipher and its inverse, and the GCM specification's test case 2 GHASH
# multiplies. each run first asks the processor, so a host without the
# extension passes having run nothing
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

# FIPS-197 appendix C.1: the key, the plaintext and the ciphertext
val AES_KEY: [16]u8 = [16]u8{
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
};

val AES_PLAIN: [16]u8 = [16]u8{
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,
};

val AES_CIPHER: [16]u8 = [16]u8{
    0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30, 0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a,
};

# the key schedule appendix C.1 lists as round[r].k_sch, rounds 0 to 10
val AES_ROUND_KEYS: [176]u8 = [176]u8{
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    0xd6, 0xaa, 0x74, 0xfd, 0xd2, 0xaf, 0x72, 0xfa, 0xda, 0xa6, 0x78, 0xf1, 0xd6, 0xab, 0x76, 0xfe,
    0xb6, 0x92, 0xcf, 0x0b, 0x64, 0x3d, 0xbd, 0xf1, 0xbe, 0x9b, 0xc5, 0x00, 0x68, 0x30, 0xb3, 0xfe,
    0xb6, 0xff, 0x74, 0x4e, 0xd2, 0xc2, 0xc9, 0xbf, 0x6c, 0x59, 0x0c, 0xbf, 0x04, 0x69, 0xbf, 0x41,
    0x47, 0xf7, 0xf7, 0xbc, 0x95, 0x35, 0x3e, 0x03, 0xf9, 0x6c, 0x32, 0xbc, 0xfd, 0x05, 0x8d, 0xfd,
    0x3c, 0xaa, 0xa3, 0xe8, 0xa9, 0x9f, 0x9d, 0xeb, 0x50, 0xf3, 0xaf, 0x57, 0xad, 0xf6, 0x22, 0xaa,
    0x5e, 0x39, 0x0f, 0x7d, 0xf7, 0xa6, 0x92, 0x96, 0xa7, 0x55, 0x3d, 0xc1, 0x0a, 0xa3, 0x1f, 0x6b,
    0x14, 0xf9, 0x70, 0x1a, 0xe3, 0x5f, 0xe2, 0x8c, 0x44, 0x0a, 0xdf, 0x4d, 0x4e, 0xa9, 0xc0, 0x26,
    0x47, 0x43, 0x87, 0x35, 0xa4, 0x1c, 0x65, 0xb9, 0xe0, 0x16, 0xba, 0xf4, 0xae, 0xbf, 0x7a, 0xd2,
    0x54, 0x99, 0x32, 0xd1, 0xf0, 0x85, 0x57, 0x68, 0x10, 0x93, 0xed, 0x9c, 0xbe, 0x2c, 0x97, 0x4e,
    0x13, 0x11, 0x1d, 0x7f, 0xe3, 0x94, 0x4a, 0x17, 0xf3, 0x07, 0xa7, 0x8b, 0x4d, 0x2b, 0x30, 0xc5,
};

# GCM specification test case 2: H, the one ciphertext block, the length
# block, X1 = C1·H and GHASH = (X1 ⊕ L)·H
val GCM_H: [16]u8 = [16]u8{
    0x66, 0xe9, 0x4b, 0xd4, 0xef, 0x8a, 0x2c, 0x3b, 0x88, 0x4c, 0xfa, 0x59, 0xca, 0x34, 0x2b, 0x2e,
};

val GCM_C1: [16]u8 = [16]u8{
    0x03, 0x88, 0xda, 0xce, 0x60, 0xb6, 0xa3, 0x92, 0xf3, 0x28, 0xc2, 0xb9, 0x71, 0xb2, 0xfe, 0x78,
};

val GCM_LEN: [16]u8 = [16]u8{
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80,
};

val GCM_X1: [16]u8 = [16]u8{
    0x5e, 0x2e, 0xc7, 0x46, 0x91, 0x70, 0x62, 0x88, 0x2c, 0x85, 0xb0, 0x68, 0x53, 0x53, 0xde, 0xb7,
};

val GCM_GHASH: [16]u8 = [16]u8{
    0xf3, 0x8c, 0xbb, 0x1a, 0xd6, 0x92, 0x23, 0xdc, 0xc3, 0x45, 0x7a, 0xe5, 0xb6, 0xb0, 0xf8, 0x85,
};

fun same(a: *u8, b: *u8, n: usize) bool {
    var i: usize = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun bitrev64(v: u64) u64 {
    var r: u64 = 0;
    var i: u32 = 0;
    for (i < 64) {
        r = (r << 1) | ((v >> i) & 1);
        i = i + 1;
    }
    ret r;
}

fun be64(b: *u8) u64 {
    var v: u64   = 0;
    var i: usize = 0;
    for (i < 8) {
        v = (v << 8) | b[i]::u64;
        i = i + 1;
    }
    ret v;
}

fun put_be64(b: *u8, v: u64) {
    var i: usize = 0;
    for (i < 8) {
        b[i] = ((v >> ((7 - i)::u64 * 8)) & 0xff)::u8;
        i    = i + 1;
    }
}

# a GCM block as a polynomial, [lo, hi] with bit i the coefficient of x^i: the
# block's first bit is x^0, so the words are the bit-reversed big-endian halves
fun block_poly(b: *u8, out: *u64) {
    out[0] = bitrev64(be64(b));
    out[1] = bitrev64(be64(?b[8]));
}

fun poly_block(p: *u64, b: *u8) {
    put_be64(b, bitrev64(p[0]));
    put_be64(?b[8], bitrev64(p[1]));
}

# the four 64x64 carry-less products of two [lo, hi] polynomials:
# out[0..1] lo*lo, out[2..3] hi*hi, out[4..5] a.hi*b.lo, out[6..7] a.lo*b.hi
def ClmulParts: fun(*u64, *u64, *u64);

# x·y in GF(2^128) mod x^128 + x^7 + x^2 + x + 1, the GCM field, from the
# hardware's partial products and a plain reduction
fun gcm_mul(x: *u8, y: *u8, out: *u8, parts: ClmulParts) {
    var a: [2]u64;
    var b: [2]u64;
    block_poly(x, ?a[0]);
    block_poly(y, ?b[0]);
    var pp: [8]u64;
    parts(?a[0], ?b[0], ?pp[0]);
    var p: [4]u64;
    p[0] = pp[0];
    p[1] = pp[1] ^ pp[4] ^ pp[6];
    p[2] = pp[2] ^ pp[5] ^ pp[7];
    p[3] = pp[3];
    var bit: u32 = 255;
    for (bit >= 128) {
        if (((p[(bit / 64)::usize] >> (bit % 64)::u64) & 1) != 0) {
            val k: u32 = bit - 128;
            flip(?p[0], k + 128);
            flip(?p[0], k + 7);
            flip(?p[0], k + 2);
            flip(?p[0], k + 1);
            flip(?p[0], k);
        }
        bit = bit - 1;
    }
    poly_block(?p[0], out);
}

fun flip(p: *u64, bit: u32) {
    p[(bit / 64)::usize] = p[(bit / 64)::usize] ^ (1::u64 << (bit % 64)::u64);
}

# X1 and the whole two-block GHASH of test case 2 through `parts`
fun gcm_case_two(parts: ClmulParts) i32 {
    var x1: [16]u8;
    gcm_mul(?GCM_C1[0], ?GCM_H[0], ?x1[0], parts);
    if (!same(?x1[0], ?GCM_X1[0], 16)) { ret 1; }
    var folded: [16]u8;
    var i:      usize = 0;
    for (i < 16) {
        folded[i] = x1[i] ^ GCM_LEN[i];
        i         = i + 1;
    }
    var tag: [16]u8;
    gcm_mul(?folded[0], ?GCM_H[0], ?tag[0], parts);
    if (!same(?tag[0], ?GCM_GHASH[0], 16)) { ret 2; }
    ret 0;
}

$if ($mach.build.arch == $mach.arch.x86_64) {
    # cpuid leaf 1, ecx: aes is bit 25, pclmulqdq bit 1 and ssse3 bit 9
    fun leaf_one_ecx() u32 {
        var c: u32 = 0;
        asm x86_64 {
            mov eax, 1
            xor ecx, ecx
            cpuid
            mov {c}, ecx
        }
        ret c;
    }

    fun has(bit: u32) bool {
        ret ((leaf_one_ecx() >> bit) & 1) == 1;
    }

    # expands the key with aeskeygenassist, stores the schedule, then runs the
    # cipher with aesenc and aesenclast and the equivalent inverse cipher with
    # aesimc, aesdec and aesdeclast. round keys live in xmm4 and xmm6 to xmm15;
    # palignr against a zero xmm5 is the 4-byte left shift of the expansion
    #[extensions(aes, ssse3)]
    fun aes128(key: *u8, plain: *u8, cipher: *u8, back: *u8, sched: *u8) {
        asm x86_64 {
            mov rdx, {key}
            mov rsi, {plain}
            mov rdi, {cipher}
            mov rcx, {back}
            mov r8, {sched}
            pxor xmm5, xmm5
            movdqu xmm1, [rdx]
            movdqa xmm4, xmm1
            aeskeygenassist xmm2, xmm1, 0x01
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm6, xmm1
            aeskeygenassist xmm2, xmm1, 0x02
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm7, xmm1
            aeskeygenassist xmm2, xmm1, 0x04
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm8, xmm1
            aeskeygenassist xmm2, xmm1, 0x08
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm9, xmm1
            aeskeygenassist xmm2, xmm1, 0x10
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm10, xmm1
            aeskeygenassist xmm2, xmm1, 0x20
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm11, xmm1
            aeskeygenassist xmm2, xmm1, 0x40
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm12, xmm1
            aeskeygenassist xmm2, xmm1, 0x80
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm13, xmm1
            aeskeygenassist xmm2, xmm1, 0x1b
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm14, xmm1
            aeskeygenassist xmm2, xmm1, 0x36
            pshufd xmm2, xmm2, 0xff
            movdqa xmm3, xmm1
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            palignr xmm3, xmm5, 12
            pxor xmm1, xmm3
            pxor xmm1, xmm2
            movdqa xmm15, xmm1
            movdqu [r8], xmm4
            movdqu [r8 + 16], xmm6
            movdqu [r8 + 32], xmm7
            movdqu [r8 + 48], xmm8
            movdqu [r8 + 64], xmm9
            movdqu [r8 + 80], xmm10
            movdqu [r8 + 96], xmm11
            movdqu [r8 + 112], xmm12
            movdqu [r8 + 128], xmm13
            movdqu [r8 + 144], xmm14
            movdqu [r8 + 160], xmm15
            movdqu xmm0, [rsi]
            pxor xmm0, xmm4
            aesenc xmm0, xmm6
            aesenc xmm0, xmm7
            aesenc xmm0, xmm8
            aesenc xmm0, xmm9
            aesenc xmm0, xmm10
            aesenc xmm0, xmm11
            aesenc xmm0, xmm12
            aesenc xmm0, xmm13
            aesenc xmm0, xmm14
            aesenclast xmm0, xmm15
            movdqu [rdi], xmm0
            pxor xmm0, xmm15
            aesimc xmm3, xmm14
            aesdec xmm0, xmm3
            aesimc xmm3, xmm13
            aesdec xmm0, xmm3
            aesimc xmm3, xmm12
            aesdec xmm0, xmm3
            aesimc xmm3, xmm11
            aesdec xmm0, xmm3
            aesimc xmm3, xmm10
            aesdec xmm0, xmm3
            aesimc xmm3, xmm9
            aesdec xmm0, xmm3
            aesimc xmm3, xmm8
            aesdec xmm0, xmm3
            aesimc xmm3, xmm7
            aesdec xmm0, xmm3
            aesimc xmm3, xmm6
            aesdec xmm0, xmm3
            aesdeclast xmm0, xmm4
            movdqu [rcx], xmm0
        }
    }

    #[extensions(pclmul)]
    fun clmul_parts(a: *u64, b: *u64, out: *u64) {
        asm x86_64 {
            mov rsi, {a}
            mov rdx, {b}
            mov rdi, {out}
            movdqu xmm0, [rsi]
            movdqu xmm1, [rdx]
            movdqa xmm2, xmm0
            pclmulqdq xmm2, xmm1, 0x00
            movdqu [rdi], xmm2
            movdqa xmm2, xmm0
            pclmulqdq xmm2, xmm1, 0x11
            movdqu [rdi + 16], xmm2
            movdqa xmm2, xmm0
            pclmulqdq xmm2, xmm1, 0x01
            movdqu [rdi + 32], xmm2
            movdqa xmm2, xmm0
            pclmulqdq xmm2, xmm1, 0x10
            movdqu [rdi + 48], xmm2
        }
    }

    test aes128_matches_fips_197 {
        if (!has(25) || !has(9)) { ret 0; }
        var cipher: [16]u8;
        var back:   [16]u8;
        var sched:  [176]u8;
        aes128(?AES_KEY[0], ?AES_PLAIN[0], ?cipher[0], ?back[0], ?sched[0]);
        if (!same(?sched[0], ?AES_ROUND_KEYS[0], 176)) { ret 1; }
        if (!same(?cipher[0], ?AES_CIPHER[0], 16))     { ret 2; }
        if (!same(?back[0], ?AES_PLAIN[0], 16))        { ret 3; }
        ret 0;
    }

    test pclmulqdq_gives_the_gcm_test_case_two_ghash {
        if (!has(1)) { ret 0; }
        ret gcm_case_two(clmul_parts);
    }
}
$or ($mach.build.arch == $mach.arch.aarch64) {
    # ID_AA64ISAR0_EL1.AES, bits 7:4: 1 is aes, 2 is aes with pmull. linux
    # emulates the read from user mode; every apple arm64 processor has both
    fun aes_field() u64 {
        $if ($mach.build.os == $mach.os.linux) {
            var isar0: u64 = 0;
            asm aarch64 {
                mrs x9, s3_0_c0_c6_0
                str x9, {isar0}
            }
            ret (isar0 >> 4) & 0xf;
        }
        $or ($mach.build.os == $mach.os.darwin) {
            ret 2;
        }
        $or {
            ret 0;
        }
    }

    # the cipher with aese and aesmc from the published schedule, then the
    # equivalent inverse cipher with aesd and aesimc, whose middle round keys
    # are aesimc of the schedule's
    #[extensions(aes)]
    fun aes128(sched: *u8, plain: *u8, cipher: *u8, back: *u8) {
        asm aarch64 {
            ldr x0, {sched}
            ldr x1, {plain}
            ldr x2, {cipher}
            ldr x3, {back}
            ld1 {v16.16b}, [x0], 16
            ld1 {v17.16b}, [x0], 16
            ld1 {v18.16b}, [x0], 16
            ld1 {v19.16b}, [x0], 16
            ld1 {v20.16b}, [x0], 16
            ld1 {v21.16b}, [x0], 16
            ld1 {v22.16b}, [x0], 16
            ld1 {v23.16b}, [x0], 16
            ld1 {v24.16b}, [x0], 16
            ld1 {v25.16b}, [x0], 16
            ld1 {v26.16b}, [x0]
            ld1 {v0.16b}, [x1]
            aese v0.16b, v16.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v17.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v18.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v19.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v20.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v21.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v22.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v23.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v24.16b
            aesmc v0.16b, v0.16b
            aese v0.16b, v25.16b
            eor v0.16b, v0.16b, v26.16b
            st1 {v0.16b}, [x2]
            aesd v0.16b, v26.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v25.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v24.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v23.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v22.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v21.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v20.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v19.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v18.16b
            aesd v0.16b, v1.16b
            aesimc v0.16b, v0.16b
            aesimc v1.16b, v17.16b
            aesd v0.16b, v1.16b
            eor v0.16b, v0.16b, v16.16b
            st1 {v0.16b}, [x3]
        }
    }

    # pmull takes the low lanes and pmull2 the high; the cross products come
    # from the same pair with b's lanes swapped
    #[extensions(pmull)]
    fun clmul_pair(a: *u64, b: *u64, out: *u64) {
        asm aarch64 {
            ldr x0, {a}
            ldr x1, {b}
            ldr x2, {out}
            ld1 {v0.2d}, [x0]
            ld1 {v1.2d}, [x1]
            pmull v2.1q, v0.1d, v1.1d
            pmull2 v3.1q, v0.2d, v1.2d
            st1 {v2.2d}, [x2], 16
            st1 {v3.2d}, [x2]
        }
    }

    fun clmul_parts(a: *u64, b: *u64, out: *u64) {
        clmul_pair(a, b, out);
        var swapped: [2]u64 = [2]u64{b[1], b[0]};
        var cross:   [4]u64;
        clmul_pair(a, ?swapped[0], ?cross[0]);
        out[4] = cross[2];
        out[5] = cross[3];
        out[6] = cross[0];
        out[7] = cross[1];
    }

    test aes128_matches_fips_197 {
        if (aes_field() < 1) { ret 0; }
        var cipher: [16]u8;
        var back:   [16]u8;
        aes128(?AES_ROUND_KEYS[0], ?AES_PLAIN[0], ?cipher[0], ?back[0]);
        if (!same(?cipher[0], ?AES_CIPHER[0], 16)) { ret 1; }
        if (!same(?back[0], ?AES_PLAIN[0], 16))    { ret 2; }
        ret 0;
    }

    test pmull_gives_the_gcm_test_case_two_ghash {
        if (aes_field() < 2) { ret 0; }
        ret gcm_case_two(clmul_parts);
    }
}
