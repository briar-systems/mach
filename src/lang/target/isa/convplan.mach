# a packed vector conversion is a short sequence of steps over three places: the operand, the work
# register the result forms in, and a temporary. every target encoder builds its sequence here first,
# and the one property that decides where the work register is comes from the sequence itself: a step
# that reads the operand after the work register was first written would read a clobbered value if
# the work register were the operand's own register. without such a step the destination is the work
# register, whatever it aliases; with one, an aliasing destination falls back to a scratch register
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

pub def Place: u8;

pub val PLACE_OPERAND: Place = 0;
pub val PLACE_WORK:    Place = 1;
pub val PLACE_TEMP:    Place = 2;

# op:  the target's machine opcode
# dst: the place the step writes
# src: the place the step reads besides a two-address destination
# arg: the target's per-step argument, an immediate or a lane width
pub rec Step {
    op:  u32;
    dst: Place;
    src: Place;
    arg: u32;
}

# the longest sequence any target's table needs, with room to spare
pub val STEPS_MAX: u32 = 24;

# overflow: a step was dropped because the sequence was full, so the plan must be refused
pub rec Plan {
    steps:    [24]Step;
    len:      u32;
    overflow: bool;
}

pub fun plan() Plan {
    var p: Plan;
    p.len      = 0;
    p.overflow = false;
    ret p;
}

pub fun push(p: *Plan, op: u32, dst: Place, src: Place, arg: u32) {
    if (p.len >= STEPS_MAX) {
        p.overflow = true;
        ret;
    }
    p.steps[p.len] = Step{op: op, dst: dst, src: src, arg: arg};
    p.len          = p.len + 1;
}

# the first step that reads the operand after an earlier step wrote the work register, or len for none.
# a step that reads the operand and writes the work register in one instruction reads before it writes
pub fun late_operand_read(p: *Plan) u32 {
    var written: bool = false;
    var i:       u32  = 0;
    for (i < p.len) {
        if (written && p.steps[i].src == PLACE_OPERAND) { ret i; }
        if (p.steps[i].dst == PLACE_WORK)               { written = true; }
        i = i + 1;
    }
    ret p.len;
}

# whether the work register may be the operand's own register
pub fun alias_safe(p: *Plan) bool {
    ret late_operand_read(p) == p.len;
}

# whether the result forms directly in the destination register
# ---
# dst_is_reg:          the destination is a register, not a frame slot
# dst_aliases_operand: the destination register is the operand's register
# dst_is_temp:         the destination register is the target's temporary
pub fun in_destination(p: *Plan, dst_is_reg: bool, dst_aliases_operand: bool, dst_is_temp: bool) bool {
    if (!dst_is_reg || dst_is_temp) { ret false; }
    ret !dst_aliases_operand || alias_safe(p);
}

test a_late_operand_read_is_the_only_alias_hazard {
    var p: Plan = plan();
    push(?p, 1, PLACE_WORK, PLACE_OPERAND, 0);
    push(?p, 2, PLACE_TEMP, PLACE_TEMP, 0);
    push(?p, 3, PLACE_TEMP, PLACE_WORK, 0);
    push(?p, 4, PLACE_WORK, PLACE_TEMP, 0);
    if (!alias_safe(?p) || late_operand_read(?p) != 4) { ret 1; }
    if (!in_destination(?p, true, true, false))        { ret 2; }
    if (in_destination(?p, false, false, false))       { ret 3; }
    if (in_destination(?p, true, false, true))         { ret 4; }
    # the temporary may read the operand before the work register is written
    var early: Plan = plan();
    push(?early, 1, PLACE_TEMP, PLACE_OPERAND, 0);
    push(?early, 2, PLACE_WORK, PLACE_OPERAND, 0);
    push(?early, 3, PLACE_WORK, PLACE_TEMP, 0);
    if (!alias_safe(?early)) { ret 5; }
    push(?early, 4, PLACE_WORK, PLACE_OPERAND, 0);
    if (alias_safe(?early) || late_operand_read(?early) != 3) { ret 6; }
    if (in_destination(?early, true, true, false))            { ret 7; }
    if (!in_destination(?early, true, false, false))          { ret 8; }
    var full: Plan = plan();
    var i:    u32  = 0;
    for (i <= STEPS_MAX) {
        push(?full, 1, PLACE_WORK, PLACE_WORK, 0);
        i = i + 1;
    }
    if (!full.overflow || full.len != STEPS_MAX) { ret 9; }
    ret 0;
}

val T_COPY:   u32 = 1;
val T_DOUBLE: u32 = 2;
val T_ADD:    u32 = 3;

# a model of two-address lane steps over numbered registers, 0 the operand's and 1 the destination's
# when they differ, 2 the scratch and 3 the temporary
fun t_run(p: *Plan, regs: *u32, operand: u32, dst: u32) u32 {
    var work: u32 = 2;
    if (in_destination(p, true, dst == operand, false)) { work = dst; }
    var i: u32 = 0;
    for (i < p.len) {
        var d: u32 = work;
        if (p.steps[i].dst == PLACE_TEMP) { d = 3; }
        var s: u32 = work;
        if (p.steps[i].src == PLACE_OPERAND) { s = operand; }
        or (p.steps[i].src == PLACE_TEMP)    { s = 3; }
        if (p.steps[i].op == T_COPY)         { regs[d] = regs[s]; }
        if (p.steps[i].op == T_DOUBLE)       { regs[d] = regs[d] * 2; }
        if (p.steps[i].op == T_ADD)          { regs[d] = regs[d] + regs[s]; }
        i = i + 1;
    }
    regs[dst] = regs[work];
    ret regs[dst];
}

test an_aliasing_destination_still_produces_the_right_lanes {
    # the operand is read after the work register doubled it, so an aliasing destination must not be the work
    var p: Plan = plan();
    push(?p, T_COPY, PLACE_WORK, PLACE_OPERAND, 0);
    push(?p, T_DOUBLE, PLACE_WORK, PLACE_WORK, 0);
    push(?p, T_ADD, PLACE_WORK, PLACE_OPERAND, 0);
    var apart: [4]u32 = [4]u32{5, 0, 0, 0};
    if (t_run(?p, ?apart[0], 0, 1) != 15) { ret 1; }
    var shared: [4]u32 = [4]u32{5, 0, 0, 0};
    if (t_run(?p, ?shared[0], 0, 0) != 15) { ret 2; }
    # an alias-safe plan forms in the aliasing destination and still agrees
    var safe: Plan = plan();
    push(?safe, T_COPY, PLACE_WORK, PLACE_OPERAND, 0);
    push(?safe, T_DOUBLE, PLACE_WORK, PLACE_WORK, 0);
    var direct: [4]u32 = [4]u32{5, 0, 99, 0};
    if (t_run(?safe, ?direct[0], 0, 0) != 10 || direct[2] != 99) { ret 3; }
    ret 0;
}
