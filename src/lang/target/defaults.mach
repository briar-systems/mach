# what mach asks of a target's images where its manifest states nothing
#
# these are mach's own requirements of the programs it builds, not facts of a
# platform, so they live here and not in mink's host rows or a manifest. each
# row is keyed by mink's system and states a value only where mach requires
# one. a target whose manifest states the key keeps its own value, and a
# system no row names states none, so mink writes its format's default
use std.types.option.opt;
use std.types.size.usize;

use mink_os:      mink.catalog.os;
use mink_windows: mink.catalog.os.windows;

# the main stack mach's programs are given, which the frame-exceeds-reserve
# refusal and std's stack.exhausted hold to
val MAIN_STACK_RESERVE: u64 = 8388608;

# what mach states of the images of one system
# ---
# sys:           mink's system the row is for
# stack_reserve: the main stack's reserve, none where mach states none
rec Row {
    sys:           *mink_os.System;
    stack_reserve: opt[u64];
}

val ROW_COUNT: usize          = 1;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{sys: ?mink_windows.WINDOWS, stack_reserve: opt[u64].some{MAIN_STACK_RESERVE}},
};

# the main stack reserve mach states for an image of `sys`, none where it states none
pub fun stack_reserve(sys: *mink_os.System) opt[u64] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].sys == sys) { ret ROWS[i].stack_reserve; }
        i = i + 1;
    }
    ret opt[u64].none{};
}
