# the operating system catalog: the systems of mink's catalog mach has a target
# for, each with its id, its fingerprint tag and whether it can host a build, and
# the filesystem policy an os declares. a row names mink's system row and is
# spelled by it, and a system of mink's no row names (uefi, wasi, opencl) is no
# os here and no `$mach.os` tag
use os_darwin:       mink.catalog.os.darwin;
use mink_os:         mink.catalog.os;
use os_freestanding: mink.catalog.os.freestanding;
use os_linux:        mink.catalog.os.linux;
use os_spirv:        mink.catalog.os.spirv;
use os_windows:      mink.catalog.os.windows;

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub val UNKNOWN:      u32 = 0;
pub val LINUX:        u32 = 1;
pub val DARWIN:       u32 = 2;
pub val WINDOWS:      u32 = 3;
pub val FREESTANDING: u32 = 4;
pub val VULKAN:       u32 = 5;

# hosted:         the os can be a build host, so a target of it may be `native`; a
#                 freestanding image is only ever selected by name
# system_library: the system library a hosted program of the os links for the runtime it calls,
#                 as the linker names it; empty when the runtime reaches the os without one
rec Row {
    os:              u32;
    owner:           *mink_os.System;
    fingerprint_tag: u8;
    hosted:          bool;
    system_library:  str;
}

# version 2: vulkan is a row of its own, which spir-v targets name in place of freestanding
pub val VERSION: u8 = 2;

val ROW_COUNT: usize          = 5;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{os: LINUX, owner: ?os_linux.LINUX, fingerprint_tag: 1, hosted: true, system_library: ""},
    Row{os: DARWIN, owner: ?os_darwin.DARWIN, fingerprint_tag: 2, hosted: true, system_library: ""},
    Row{os: WINDOWS, owner: ?os_windows.WINDOWS, fingerprint_tag: 3, hosted: true, system_library: "kernel32.dll"},
    Row{os: FREESTANDING, owner: ?os_freestanding.FREESTANDING, fingerprint_tag: 4, hosted: false, system_library: ""},
    Row{os: VULKAN, owner: ?os_spirv.VULKAN, fingerprint_tag: 5, hosted: false, system_library: ""},
};

# the spelling of a row: mink's name for its system
fun spelling(r: *Row) str {
    ret r.owner.name;
}

fun row_of(id: u32) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].os == id) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(spelling(?ROWS[i]), name)) { ret ROWS[i].os; }
        i = i + 1;
    }
    ret UNKNOWN;
}

pub fun name_for(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret "unknown"; }
    ret spelling(spec);
}

# mink's system row the os `id` means, nil for an unknown id
pub fun owner_of(id: u32) *mink_os.System {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret nil; }
    ret spec.owner;
}

# whether the os can be a build host; false for an unknown id
pub fun is_hosted(id: u32) bool {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret false; }
    ret spec.hosted;
}

# the system library a hosted program of the os links for the runtime it calls; empty when it
# needs none or the id is unknown
pub fun system_library(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret ""; }
    ret spec.system_library;
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun name_at(index: usize) str {
    if (index >= ROW_COUNT) { ret "unknown"; }
    ret spelling(?ROWS[index]);
}

pub fun fingerprint_tag(id: u32) u8 {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

pub val LIBDIR_MAX: u32 = 8;

pub rec FsPolicy {
    sysroot:             str;
    toolchain_root:      str;
    dynamic_interpreter: str;
    platform_lib:        str;
    libdirs:             [LIBDIR_MAX]str;
    libdir_len:          u32;
}
