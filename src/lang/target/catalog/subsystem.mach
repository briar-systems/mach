use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub def Subsystem: u8;

pub val CONSOLE: Subsystem = 0;
pub val GUI:     Subsystem = 1;

rec Row {
    subsystem:       Subsystem;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val VERSION: u8 = 1;

val ROW_COUNT: usize          = 2;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{subsystem: CONSOLE, spelling: "console", fingerprint_tag: 1},
    Row{subsystem: GUI, spelling: "gui", fingerprint_tag: 2},
};

fun row_of(s: Subsystem) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].subsystem == s) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun from_name(name: str) opt[Subsystem] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret opt[Subsystem].some{ROWS[i].subsystem}; }
        i = i + 1;
    }
    ret opt[Subsystem].none{};
}

pub fun name_for(s: Subsystem) str {
    val spec: *Row = row_of(s);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun fingerprint_tag(s: Subsystem) u8 {
    val spec: *Row = row_of(s);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

test rows__complete_unique_ordered_roundtrip {
    if (VERSION != 1)                { ret 1; }
    if (ROW_COUNT != GUI::usize + 1) { ret 1; }

    var seen: [ROW_COUNT]bool;
    var i:    usize = 0;
    for (i < ROW_COUNT) {
        seen[i] = false;
        i       = i + 1;
    }

    i = 0;
    for (i < ROW_COUNT) {
        val spec: *Row = ?ROWS[i];
        if (spec.subsystem::usize >= ROW_COUNT)                      { ret 1; }
        if (seen[spec.subsystem::usize])                             { ret 1; }
        if (str_equals(spec.spelling, ""))                           { ret 1; }
        if (spec.fingerprint_tag != (i + 1)::u8)                     { ret 1; }
        if (!str_equals(name_for(spec.subsystem), spec.spelling))    { ret 1; }
        if (fingerprint_tag(spec.subsystem) != spec.fingerprint_tag) { ret 1; }
        seen[spec.subsystem::usize] = true;

        var j: usize = 0;
        for (j < i) {
            val prior: *Row = ?ROWS[j];
            if (prior.subsystem == spec.subsystem)             { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.spelling, spec.spelling))     { ret 1; }
            j = j + 1;
        }

        val parsed: opt[Subsystem] = from_name(spec.spelling);
        if (sel parsed.none)               { ret 1; }
        if (parsed.some != spec.subsystem) { ret 1; }
        i = i + 1;
    }

    val r_2240: opt[Subsystem] = from_name("");
    if (sel r_2240.some) { ret 1; }
    val r_2241: opt[Subsystem] = from_name("windows");
    if (sel r_2241.some)                                  { ret 1; }
    if (!str_equals(name_for(255::Subsystem), "unknown")) { ret 1; }
    if (fingerprint_tag(255::Subsystem) != 0)             { ret 1; }

    i = 0;
    for (i < ROW_COUNT) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}
