# the windows subsystem catalog: every subsystem, its spelling, its fingerprint
# tag and the subsystem mink states an image of it in
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use mink_subsystem: mink.catalog.subsystem;

pub def Subsystem: u8;

pub val CONSOLE: Subsystem = 0;
pub val GUI:     Subsystem = 1;

rec Row {
    subsystem:       Subsystem;
    spelling:        str;
    fingerprint_tag: u8;
    image:           *mink_subsystem.Subsystem;
}

pub val VERSION: u8 = 2;

val ROW_COUNT: usize          = 2;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{subsystem: CONSOLE, spelling: "console", fingerprint_tag: 1, image: ?mink_subsystem.CONSOLE},
    Row{subsystem: GUI, spelling: "gui", fingerprint_tag: 2, image: ?mink_subsystem.WINDOWS},
};

fun row_of(s: Subsystem) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].subsystem == s) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun from_name(name: str) opt[Subsystem] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret opt[Subsystem].some{ROWS[i].subsystem}; }
        i = i + 1;
    }
    ret opt[Subsystem].none{};
}

pub fun name_for(s: Subsystem) str {
    val spec: *Row = row_of(s);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun fingerprint_tag(s: Subsystem) u8 {
    val spec: *Row = row_of(s);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

# the subsystem mink states an image of `s` in, none for an undeclared one, which
# leaves the host's
pub fun image_of(s: opt[Subsystem]) opt[*mink_subsystem.Subsystem] {
    if (sel s.none) { ret opt[*mink_subsystem.Subsystem].none{}; }
    val spec: *Row = row_of(s.some);
    if (spec == nil) { ret opt[*mink_subsystem.Subsystem].none{}; }
    ret opt[*mink_subsystem.Subsystem].some{spec.image};
}

# the fingerprint tag of a declared subsystem, 0 for an undeclared one
pub fun declared_tag(s: opt[Subsystem]) u8 {
    if (sel s.none) { ret 0; }
    ret fingerprint_tag(s.some);
}
