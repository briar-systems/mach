# the instruction set catalog: every architecture id, its spelling, its
# fingerprint tag and the selection syntax its names may carry
use mach.lang.fail;
use mach.lang.target.extension;
use extension_riscv: mach.lang.target.extension.riscv;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
pub val UNKNOWN: u32 = 0;
pub val X86_64:  u32 = 1;
pub val AARCH64: u32 = 2;
pub val RISCV64: u32 = 3;
# 4 was the withdrawn MOS 6502 target; no catalog row carries it
pub val SPIRV:   u32 = 5;
pub val RISCV32: u32 = 6;

pub def DwarfRegFn: fun(i32) i32;

pub def CvRegFn: fun(i32) i32;

rec Row {
    arch:            u32;
    spelling:        str;
    fingerprint_tag: u8;
    # how a name that carries a selection spells this instruction set, nil
    # when only its spelling names it
    syntax: *extension.SelectionSyntax;
}

# version 2: catalog id 4 is reserved with no row and the tags after it moved up
pub val VERSION: u8 = 2;

val ROW_COUNT: usize          = 5;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{arch: X86_64, spelling: "x86_64", fingerprint_tag: 1},
    Row{arch: AARCH64, spelling: "aarch64", fingerprint_tag: 2},
    Row{arch: RISCV64, spelling: "riscv64", fingerprint_tag: 3, syntax: ?extension_riscv.SYNTAX},
    Row{arch: SPIRV, spelling: "spirv", fingerprint_tag: 4},
    Row{arch: RISCV32, spelling: "riscv32", fingerprint_tag: 5, syntax: ?extension_riscv.SYNTAX},
};

fun row_of(id: u32) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].arch == id) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret ROWS[i].arch; }
        i = i + 1;
    }
    val syntax: *extension.SelectionSyntax = syntax_for(name);
    if (syntax == nil) { ret UNKNOWN; }
    var bad:    extension.Span;
    val parsed: res[extension.Selection, fail.Fail] = syntax.parse(name, ?bad);
    if (sel parsed.err) { ret UNKNOWN; }
    i = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, parsed.ok.template)) { ret ROWS[i].arch; }
        i = i + 1;
    }
    ret UNKNOWN;
}

# the selection syntax that claims a name, nil when none does and only a
# spelling names an instruction set
pub fun syntax_for(name: str) *extension.SelectionSyntax {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        val syntax: *extension.SelectionSyntax = ROWS[i].syntax;
        if (syntax != nil && syntax.claims(name)) { ret syntax; }
        i = i + 1;
    }
    ret nil;
}

# the selection syntax an instruction set's names carry, nil when it has none
pub fun syntax_of(id: u32) *extension.SelectionSyntax {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret nil; }
    ret spec.syntax;
}

# why a selection has no floating-point unit, for a diagnostic that already names
# the selection: what the selection syntax says it lacks, or none when the name
# carries no extension vocabulary the front end could ask the user to add. the
# name is the selection the target was resolved from, so one that does not
# parse is the failure that refused it
pub fun float_absence_note(name: str) res[opt[str], fail.Fail] {
    val syntax: *extension.SelectionSyntax = syntax_for(name);
    if (syntax == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    var bad:    extension.Span;
    val parsed: res[extension.Selection, fail.Fail] = syntax.parse(name, ?bad);
    if (sel parsed.err) { ret res[opt[str], fail.Fail].err{parsed.err}; }
    val note: str = syntax.float_absence(parsed.ok.extensions);
    if (str_len(note) == 0) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{note}};
}

# the instruction set the compiler itself was built for, UNKNOWN when the
# catalog has no row for it
pub fun host_id() u32 {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret X86_64; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret AARCH64; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret RISCV64; }
    $or                                          { ret UNKNOWN; }
}

pub fun name_for(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun name_at(index: usize) str {
    if (index >= ROW_COUNT) { ret "unknown"; }
    ret ROWS[index].spelling;
}

pub fun fingerprint_tag(id: u32) u8 {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

# the note, "-" for none and "!" for a refusal
#[testing]
fun t_note(name: str) str {
    val r: res[opt[str], fail.Fail] = float_absence_note(name);
    if (sel r.err)     { ret "!"; }
    if (sel r.ok.none) { ret "-"; }
    ret r.ok.some;
}

test float_absence_note__names_the_missing_extension_for_a_riscv_selection {
    if (!str_equals(t_note("rv32imc"), "the selection lacks the F extension")) { ret 1; }
    if (!str_equals(t_note("rv64i"), "the selection lacks the F extension"))   { ret 2; }
    if (!str_equals(t_note("riscv32"), "the selection lacks the F extension")) { ret 3; }
    if (!str_equals(t_note("rv32imafdc"), "-"))                                { ret 4; }
    if (!str_equals(t_note("riscv64"), "-"))                                   { ret 5; }
    if (!str_equals(t_note("x86_64"), "-"))                                    { ret 6; }
    if (!str_equals(t_note("rv32iv"), "!"))                                    { ret 7; }
    ret 0;
}

test id_for__name_roundtrip {
    if (id_for("x86_64") != X86_64)   { ret 1; }
    if (id_for("aarch64") != AARCH64) { ret 1; }
    if (id_for("riscv64") != RISCV64) { ret 1; }
    if (id_for("riscv32") != RISCV32) { ret 1; }
    if (id_for("mos6502") != UNKNOWN) { ret 1; }
    if (id_for("spirv") != SPIRV)     { ret 1; }
    if (id_for("riscv") != UNKNOWN)   { ret 1; }
    if (RISCV32 == RISCV64)           { ret 1; }
    if (id_for("rv32imc") != RISCV32) { ret 2; }
    if (id_for("rv64gc") != RISCV64)  { ret 2; }
    if (id_for("rv32e") != UNKNOWN || id_for("rv64iv") != UNKNOWN
        || id_for("rv128i") != UNKNOWN) { ret 2; }

    if (!str_equals(name_for(X86_64), "x86_64"))   { ret 1; }
    if (!str_equals(name_for(AARCH64), "aarch64")) { ret 1; }
    if (!str_equals(name_for(RISCV64), "riscv64")) { ret 1; }
    if (!str_equals(name_for(RISCV32), "riscv32")) { ret 1; }
    if (!str_equals(name_for(SPIRV), "spirv"))     { ret 1; }
    if (!str_equals(name_for(UNKNOWN), "unknown")) { ret 1; }
    ret 0;
}

test rows__complete_unique_ordered_roundtrip {
    if (ROWS[0].arch != X86_64)  { ret 1; }
    if (ROWS[1].arch != AARCH64) { ret 1; }
    if (ROWS[2].arch != RISCV64) { ret 1; }
    if (ROWS[3].arch != SPIRV)   { ret 1; }
    if (ROWS[4].arch != RISCV32) { ret 1; }

    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].fingerprint_tag != (i + 1)::u8)                { ret 1; }
        if (id_for(ROWS[i].spelling) != ROWS[i].arch)              { ret 1; }
        if (!str_equals(name_for(ROWS[i].arch), ROWS[i].spelling)) { ret 1; }

        var j: usize = 0;
        for (j < ROW_COUNT) {
            if (i != j) {
                if (ROWS[i].arch == ROWS[j].arch)                       { ret 1; }
                if (str_equals(ROWS[i].spelling, ROWS[j].spelling))     { ret 1; }
                if (ROWS[i].fingerprint_tag == ROWS[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
