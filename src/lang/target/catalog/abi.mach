use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub val UNKNOWN: u32 = 0;
pub val SYSV:    u32 = 1;
pub val WIN64:   u32 = 2;
pub val AAPCS64: u32 = 3;
pub val LP64:    u32 = 4;
pub val LP64F:   u32 = 5;
pub val LP64D:   u32 = 6;

pub val ILP32:  u32 = 7;
pub val ILP32F: u32 = 8;
pub val ILP32D: u32 = 9;
pub val SPIRV:  u32 = 10;

rec Row {
    abi:             u32;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val VERSION: u8 = 1;

val ROW_COUNT: usize          = 10;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{abi: SYSV, spelling: "sysv64", fingerprint_tag: 1},
    Row{abi: WIN64, spelling: "win64", fingerprint_tag: 2},
    Row{abi: AAPCS64, spelling: "aapcs64", fingerprint_tag: 3},
    Row{abi: LP64, spelling: "lp64", fingerprint_tag: 4},
    Row{abi: LP64F, spelling: "lp64f", fingerprint_tag: 5},
    Row{abi: LP64D, spelling: "lp64d", fingerprint_tag: 6},
    Row{abi: ILP32, spelling: "ilp32", fingerprint_tag: 7},
    Row{abi: ILP32F, spelling: "ilp32f", fingerprint_tag: 8},
    Row{abi: ILP32D, spelling: "ilp32d", fingerprint_tag: 9},
    Row{abi: SPIRV, spelling: "spirv", fingerprint_tag: 10},
};

fun row_of(id: u32) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].abi == id) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret ROWS[i].abi; }
        i = i + 1;
    }
    ret UNKNOWN;
}

pub fun name_for(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun name_at(index: usize) str {
    if (index >= ROW_COUNT) { ret "unknown"; }
    ret ROWS[index].spelling;
}

pub fun fingerprint_tag(id: u32) u8 {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

test rows__complete_unique_ordered_roundtrip {
    if (ROWS[0].abi != SYSV)                       { ret 1; }
    if (ROWS[1].abi != WIN64)                      { ret 1; }
    if (ROWS[2].abi != AAPCS64)                    { ret 1; }
    if (ROWS[3].abi != LP64)                       { ret 1; }
    if (ROWS[4].abi != LP64F)                      { ret 1; }
    if (ROWS[5].abi != LP64D)                      { ret 1; }
    if (ROWS[6].abi != ILP32)                      { ret 1; }
    if (ROWS[7].abi != ILP32F)                     { ret 1; }
    if (ROWS[8].abi != ILP32D)                     { ret 1; }
    if (ROWS[9].abi != SPIRV)                      { ret 1; }
    if (id_for("bogus") != UNKNOWN)                { ret 2; }
    if (!str_equals(name_for(UNKNOWN), "unknown")) { ret 2; }

    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].fingerprint_tag != (i + 1)::u8)               { ret 1; }
        if (id_for(ROWS[i].spelling) != ROWS[i].abi)              { ret 1; }
        if (!str_equals(name_for(ROWS[i].abi), ROWS[i].spelling)) { ret 1; }

        var j: usize = 0;
        for (j < ROW_COUNT) {
            if (i != j) {
                if (ROWS[i].abi == ROWS[j].abi)                         { ret 1; }
                if (str_equals(ROWS[i].spelling, ROWS[j].spelling))     { ret 1; }
                if (ROWS[i].fingerprint_tag == ROWS[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
