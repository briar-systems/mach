use mach.lang.fail;
use std.allocator.page;
use std_format: std.format;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use lang_mir:     mach.lang.mir;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.isa;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;

pub def ParamClass: u8;

pub val CLASS_GP:              ParamClass = 0;
pub val CLASS_FP:              ParamClass = 1;
pub val CLASS_STACK:           ParamClass = 2;
pub val CLASS_SRET:            ParamClass = 3;
pub val CLASS_BYREF:           ParamClass = 4;
pub val CLASS_STACK_BYREF:     ParamClass = 5;
pub val CLASS_VEC_BYREF:       ParamClass = 6;
pub val CLASS_VEC_STACK_BYREF: ParamClass = 7;
pub val CLASS_VALUE:           ParamClass = 8;

pub def PieceKind: u8;
pub val PIECE_GP:    PieceKind = 0;
pub val PIECE_FP:    PieceKind = 1;
pub val PIECE_STACK: PieceKind = 2;

pub val PARAM_MAX_PIECES: u32 = 4;

pub rec ParamPiece {
    kind:    PieceKind;
    reg:     lang_mir.PRegId;
    src_off: i64;
    stk_off: i64;
    # transport width, independent of bytes remaining in the logical object
    width: u8;
}

pub rec AggField  { is_float: bool; offset: u32; width: u8; }
pub rec AggLayout { field_count: u8; fields: [2]AggField; }

pub fun agg_none() AggLayout {
    var a: AggLayout;
    a.field_count = 0;
    ret a;
}

# reg is the physical register the slot rides, MIR_PREG_NIL for a stack slot;
# the constructors take the isa regid the packs select (-1 for none).
# gp_consumed and fp_consumed are how many general and floating-point
# registers the argument takes out of each sequence, which the constructors set
# to the pieces it rides in each bank; a classifier raises them where its ABI
# skips or exhausts registers without using them (AAPCS64 C.10 rounds a
# double-word to an even register, C.11 and C.13 give the remaining general
# registers to nothing once an argument that wanted them goes to the stack, and
# C.3 does the same for the vector registers after an HFA or HVA)
pub rec ParamSlot {
    class:          ParamClass;
    reg:            lang_mir.PRegId;
    offset:         i64;
    size:           u64;
    indirect_size:  u64;
    indirect_align: u32;
    # the alignment a stack argument is placed at when the convention sets one
    # above its type's own (a System V vector wider than the vector registers,
    # at its C alignment), 0 for the type's own
    stack_align: u32;
    pieces:      [PARAM_MAX_PIECES]ParamPiece;
    piece_count: u32;
    gp_consumed: i32;
    fp_consumed: i32;
}

fun gp_piece_count(s: *ParamSlot) i32 {
    ret kind_piece_count(s, PIECE_GP);
}

fun fp_piece_count(s: *ParamSlot) i32 {
    ret kind_piece_count(s, PIECE_FP);
}

fun kind_piece_count(s: *ParamSlot, kind: PieceKind) i32 {
    var n: i32 = 0;
    var i: u32 = 0;
    for (i < s.piece_count) {
        if (s.pieces[i].kind == kind) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# eightbyte class mask handed to a classifier: bit 0 and bit 1 mark eightbyte 0 and 1 as SSE, bit 2 and
# bit 3 mark them as holding no leaf at all (padding only), and an unmarked eightbyte inside the object is INTEGER;
# bit 4 marks an aggregate holding a field at an offset that is not a multiple of the field's own alignment
# (a packed record), which System V classifies as MEMORY regardless of what its eightbytes hold
pub val EB_SSE_LO:    u8 = 1;
pub val EB_SSE_HI:    u8 = 2;
pub val EB_EMPTY_LO:  u8 = 4;
pub val EB_EMPTY_HI:  u8 = 8;
pub val EB_UNALIGNED: u8 = 16;

# the arguments are index, size, align, is_float, eightbytes, is_aggregate, is_vector, gp_used, fp_used,
# hfa_members, hfa_elem, the aggregate layout and the vector register bytes. align is the alignment the
# register assignment honors: the type's own, capped where the platform relaxes it (darwin aarch64 starts a
# 16-byte value in any x register). the vector register bytes are the widest vector one register of the
# target carries under its selected extensions (isa.vector_register_bytes), which a convention that places
# a vector by its register width reads (System V's ymm under avx)
pub def ArgPassingFn: fun(i32, u64, u64, bool, u8, bool, bool, i32, i32, u8, u8, AggLayout, u64) ParamSlot;

pub def RetPassingFn: fun(u64, u64, bool, u8, bool, bool, u8, u8, AggLayout, u64) ParamSlot;

pub def RegFileFn: isa.RegFileFn;

def VaModelFn: fun() VaModel;

# how a binary16 crosses a call, a row of each convention's table.
# HALF_INTEGER passes its bits in the integer slot a u16 takes. the float rows
# classify it as a float of two bytes, so it takes the float registers, float
# eightbytes and homogeneous-aggregate members a float does, and in a float
# register it is the low 16 bits: HALF_FLOAT leaves the rest unspecified, and
# HALF_FLOAT_NANBOX sets them, as the RISC-V psABI boxes a float narrower than
# its register
def HalfRule: u8;
val     HALF_INTEGER:      HalfRule = 0;
pub val HALF_FLOAT:        HalfRule = 1;
pub val HALF_FLOAT_NANBOX: HalfRule = 2;

# a binary16 takes the float bank under this rule
pub fun half_is_float(rule: HalfRule) bool {
    ret rule == HALF_FLOAT || rule == HALF_FLOAT_NANBOX;
}

# the bits above a binary16 in its four-byte float carrier. a register wider
# than four bytes is boxed by the four-byte load itself, as a binary32 is
pub fun half_float_padding(rule: HalfRule) u16 {
    if (rule == HALF_FLOAT_NANBOX) { ret 0xFFFF; }
    ret 0;
}

# a piece of a float register two bytes wide carries a binary16: no other
# float or vector a convention places is that narrow
pub fun piece_is_half(p: *ParamPiece) bool {
    ret p.kind == PIECE_FP && p.width == 2;
}

pub rec AbiVTable {
    passing:                    catalog_abi.Passing;
    id:                         u32;
    name:                       str;
    arch_id:                    u32;
    arg_passing:                ArgPassingFn;
    ret_passing:                RetPassingFn;
    gp_arg_regs:                RegFileFn;
    callee_saved:               RegFileFn;
    stack_align:                u32;
    red_zone:                   u32;
    shadow_space:               u32;
    indirect_result_reg:        i32;
    indirect_result_in_argfile: bool;
    consumes_agg_layout:        bool;
    # the low bytes of a vector register a callee-saved float register keeps
    # across a call: a value wider lives in one only between calls
    fp_callee_saved_bytes: u32;
    float_arg_bits:        u32;
    arg_slot_granularity:  u32;
    va_model:              VaModelFn;
    # an aggregate argument is placed by the alignment its members give it, not
    # one its own #[align] raises (AAPCS64 C.12 to C.16)
    agg_natural_align: bool;
    # the caller extends an integer argument narrower than this many bits in its
    # register, 0 when the convention leaves the upper bits to the callee
    reg_arg_extend: u32;
    # how the convention passes an f16
    half: HalfRule;
}

#[testing]
fun t_arg(index: i32, size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
    is_aggregate: bool, is_vector: bool, gp_used: i32, fp_used: i32,
    hfa_members: u8, hfa_elem: u8, agg: AggLayout, vec_bytes: u64) ParamSlot {
    ret make_slot(CLASS_GP, index, 0, size, 8);
}

#[testing]
fun t_ret(size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
    is_aggregate: bool, is_vector: bool, hfa_members: u8,
    hfa_elem: u8, agg: AggLayout, vec_bytes: u64) ParamSlot {
    ret make_slot(CLASS_GP, 0, 0, size, 8);
}

#[testing]
fun t_regs(out: *target_model.Register) i32 {
    ret 0;
}

#[testing]
fun t_va_model() VaModel {
    ret va_model_make(VA_MODEL_REG_SAVE, false, -1, 0);
}

pub rec SigLayout {
    ret_slot:    ParamSlot;
    params:      *ParamSlot;
    param_count: u32;
    gp_used:     i32;
    fp_used:     i32;
    stack_off:   i64;
}

pub val VA_MODEL_REG_SAVE: u8 = 0;
pub val VA_MODEL_HOME:     u8 = 1;

pub rec VaModel {
    kind:                u8;
    float_dup_gp:        bool;
    vector_count_reg:    i32;
    variadic_float_bits: u32;
}

pub fun va_model_make(kind: u8, float_dup_gp: bool, vector_count_reg: i32,
    variadic_float_bits: u32) VaModel {
    var m: VaModel;
    m.kind                = kind;
    m.float_dup_gp        = float_dup_gp;
    m.vector_count_reg    = vector_count_reg;
    m.variadic_float_bits = variadic_float_bits;
    ret m;
}

pub fun variadic_float_in_fp_bank(m: *VaModel, width: u64) bool {
    if (m.variadic_float_bits == 0) { ret false; }
    ret (width * 8) <= m.variadic_float_bits::u64;
}

# why a descriptor is malformed, read once when a registry adds it
# ---
# a:  formats the refusal
# vt: the descriptor
pub fun validate(a: *A.Allocator, vt: *AbiVTable) err[fail.Fail] {
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.abi: a registry was handed a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.abi: a calling convention declares an empty name")};
    }
    if (vt.arch_id == catalog_arch.UNKNOWN) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' does not declare a target instruction set", vt.name)};
    }
    if (vt.arg_passing == nil || vt.ret_passing == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' is missing `arg_passing` or `ret_passing`", vt.name)};
    }
    if (vt.half != HALF_INTEGER && vt.half != HALF_FLOAT && vt.half != HALF_FLOAT_NANBOX) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' declares no rule for an f16", vt.name)};
    }
    if (vt.passing == catalog_abi.PASSING_VALUES) {
        if (vt.gp_arg_regs != nil || vt.callee_saved != nil || vt.va_model != nil
            || vt.arg_slot_granularity != 0 || vt.stack_align != 0
            || vt.red_zone != 0 || vt.shadow_space != 0 || vt.indirect_result_reg != -1
            || vt.indirect_result_in_argfile || vt.consumes_agg_layout) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' passes values but declares a carrier transport", vt.name)};
        }
        ret err[fail.Fail].ok{};
    }
    if (vt.passing != catalog_abi.PASSING_CARRIERS) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' declares an unknown passing model", vt.name)};
    }
    if (vt.gp_arg_regs == nil || vt.callee_saved == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' is missing `gp_arg_regs` or `callee_saved`", vt.name)};
    }
    if (vt.va_model == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' is missing `va_model`", vt.name)};
    }
    if (vt.arg_slot_granularity == 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.abi: calling convention '{}' declares an `arg_slot_granularity` of 0", vt.name)};
    }
    ret err[fail.Fail].ok{};
}

pub fun name_of(vt: *AbiVTable) str {
    ret vt.name;
}

pub fun id_of(vt: *AbiVTable) u32 {
    ret vt.id;
}

pub fun covers_isa(vt: *AbiVTable, arch_id: u32) bool {
    ret vt.arch_id == arch_id;
}

fun piece_for_reg(reg: i32, src_off: i64, word: u32) ParamPiece {
    var kind: PieceKind = PIECE_GP;
    if (isa_inst.regid_class(reg) == isa_inst.REG_CLASS_ID_FP) { kind = PIECE_FP; }
    ret make_piece(kind, reg, src_off, 0, word::u8);
}

fun make_slot_base(class: ParamClass, reg: i32, offset: i64, size: u64, carrier_width: u8) ParamSlot {
    var s: ParamSlot;
    s.class          = class;
    s.reg            = lang_mir.preg_id(reg);
    s.offset         = offset;
    s.size           = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.stack_align    = 0;
    s.piece_count    = 0;
    if (reg >= 0) {
        s.pieces[0]   = piece_for_reg(reg, 0, carrier_width::u32);
        s.piece_count = 1;
    }
    s.gp_consumed = gp_piece_count(?s);
    s.fp_consumed = fp_piece_count(?s);
    ret s;
}

# a slot of a direct class. total over the classes a classifier names: an
# indirect vector class needs make_slot_indirect, and passing one is a caller defect
pub fun make_slot(class: ParamClass, reg: i32, offset: i64, size: u64, carrier_width: u8) ParamSlot {
    if (class == CLASS_VEC_BYREF || class == CLASS_VEC_STACK_BYREF) {
        panic("mach.lang.target.abi.make_slot: an indirect vector slot requires declared storage geometry\n");
    }
    ret make_slot_base(class, reg, offset, size, carrier_width);
}

# a slot of an indirect vector class with its storage geometry. total over a
# declared geometry: a size, and an alignment that is a power of two
pub fun make_slot_indirect(class: ParamClass, reg: i32, offset: i64, size: u64,
    indirect_size: u64, indirect_align: u32) ParamSlot {
    if ((class != CLASS_VEC_BYREF && class != CLASS_VEC_STACK_BYREF) ||
        indirect_size == 0 || indirect_align == 0 || (indirect_align & (indirect_align - 1)) != 0) {
        panic("mach.lang.target.abi.make_slot_indirect: invalid indirect vector storage contract\n");
    }
    var s: ParamSlot = make_slot_base(class, reg, offset, size, size::u8);
    s.indirect_size  = indirect_size;
    s.indirect_align = indirect_align;
    ret s;
}

pub fun make_slot_value(size: u64) ParamSlot {
    var s: ParamSlot;
    s.class       = CLASS_VALUE;
    s.reg         = lang_mir.MIR_PREG_NIL;
    s.size        = size;
    s.gp_consumed = 0;
    s.fp_consumed = 0;
    ret s;
}

pub fun make_slot_pair(class: ParamClass, reg: i32, reg2: i32, offset: i64, size: u64,
    word: u32) ParamSlot {
    var s: ParamSlot;
    s.class          = class;
    s.reg            = lang_mir.preg_id(reg);
    s.offset         = offset;
    s.size           = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.stack_align    = 0;
    s.piece_count    = 0;
    if (reg >= 0) {
        s.pieces[0]   = piece_for_reg(reg, 0, word);
        s.piece_count = 1;
    }
    if (reg2 >= 0) {
        s.pieces[1]   = piece_for_reg(reg2, word::i64, word);
        s.piece_count = 2;
    }
    s.gp_consumed = gp_piece_count(?s);
    s.fp_consumed = fp_piece_count(?s);
    ret s;
}

# a homogeneous float aggregate in `count` consecutive float registers. total
# over the slot's fixed piece storage: more than PARAM_MAX_PIECES is a caller defect
pub fun make_slot_hfa(base_reg: i32, count: u8, elem: u8, size: u64) ParamSlot {
    if (count::u32 > PARAM_MAX_PIECES) {
        panic("mach.lang.target.abi.make_slot_hfa: piece count exceeds ParamSlot storage\n");
    }
    var s: ParamSlot;
    s.class          = CLASS_FP;
    s.reg            = lang_mir.preg_id(base_reg);
    s.offset         = 0;
    s.size           = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.stack_align    = 0;
    val base_ix: i32 = isa_inst.regid_index(base_reg);
    var i:       u32 = 0;
    for (i < count::u32) {
        s.pieces[i] = make_piece(PIECE_FP, isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, base_ix + i::i32),
            (i * elem::u32)::i64, 0, elem);
        i = i + 1;
    }
    s.piece_count = count::u32;
    s.gp_consumed = 0;
    s.fp_consumed = count::i32;
    ret s;
}

pub fun make_piece(kind: PieceKind, reg: i32, src_off: i64, stk_off: i64, width: u8) ParamPiece {
    var p: ParamPiece;
    p.kind    = kind;
    p.reg     = lang_mir.preg_id(reg);
    p.src_off = src_off;
    p.stk_off = stk_off;
    p.width   = width;
    ret p;
}

# a slot carried in `count` pieces. total over the slot's fixed piece storage:
# more than PARAM_MAX_PIECES is a caller defect
pub fun make_slot_pieces(class: ParamClass, pieces: *ParamPiece, count: u32, size: u64) ParamSlot {
    if (count > PARAM_MAX_PIECES) {
        panic("mach.lang.target.abi.make_slot_pieces: piece count exceeds ParamSlot storage\n");
    }
    var s: ParamSlot;
    s.class          = class;
    s.reg            = lang_mir.MIR_PREG_NIL;
    s.offset         = 0;
    s.size           = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.stack_align    = 0;
    var i: u32 = 0;
    for (i < count) {
        s.pieces[i] = pieces[i];
        i           = i + 1;
    }
    s.piece_count = count;
    s.gp_consumed = gp_piece_count(?s);
    s.fp_consumed = fp_piece_count(?s);
    ret s;
}

# the constructors declare the registers their pieces ride in each bank; a
# classifier may raise the counts for registers its ABI skips
test paramslot__consumed_follows_the_pieces_of_each_bank {
    val gp: ParamSlot = make_slot(CLASS_GP, 3, 0, 8, 8);
    if (gp.gp_consumed != 1 || gp.fp_consumed != 0) { ret 1; }
    val st: ParamSlot = make_slot(CLASS_STACK, -1, 0, 8, 0);
    if (st.gp_consumed != 0 || st.fp_consumed != 0) { ret 2; }
    val fp: ParamSlot = make_slot(CLASS_FP, isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0), 0, 8, 8);
    if (fp.gp_consumed != 0 || fp.fp_consumed != 1) { ret 3; }
    val pr: ParamSlot = make_slot_pair(CLASS_GP, 0, 1, 0, 16, 8);
    if (pr.gp_consumed != 2 || pr.fp_consumed != 0) { ret 4; }
    val mixed: ParamSlot = make_slot_pair(CLASS_GP, 0, isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0), 0, 16, 8);
    if (mixed.gp_consumed != 1 || mixed.fp_consumed != 1) { ret 5; }
    val hfa: ParamSlot = make_slot_hfa(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0), 2, 8, 16);
    if (hfa.gp_consumed != 0 || hfa.fp_consumed != 2) { ret 6; }
    val v: ParamSlot = make_slot_value(8);
    if (v.gp_consumed != 0 || v.fp_consumed != 0) { ret 7; }
    ret 0;
}

test make_slot_pair__geometry_is_the_conventions_word {
    val p4: ParamSlot = make_slot_pair(CLASS_GP, 10, 11, 0, 8, 4);
    if (p4.piece_count != 2)                         { ret 1; }
    if (p4.pieces[0].src_off != 0)                   { ret 1; }
    if (p4.pieces[0].width != 4)                     { ret 1; }
    if (lang_mir.preg_regid(p4.pieces[1].reg) != 11) { ret 1; }
    if (p4.pieces[1].src_off != 4)                   { ret 1; }
    if (p4.pieces[1].width != 4)                     { ret 1; }

    val p2: ParamSlot = make_slot_pair(CLASS_GP, 10, 11, 0, 4, 2);
    if (p2.pieces[1].src_off != 2) { ret 1; }
    if (p2.pieces[1].width != 2)   { ret 1; }

    val p8: ParamSlot = make_slot_pair(CLASS_GP, 10, 11, 0, 16, 8);
    if (p8.pieces[0].src_off != 0) { ret 1; }
    if (p8.pieces[1].src_off != 8) { ret 1; }
    if (p8.pieces[1].width != 8)   { ret 1; }

    val one: ParamSlot = make_slot(CLASS_GP, 10, 0, 8, 8);
    if (one.piece_count != 1)       { ret 1; }
    if (one.pieces[0].src_off != 0) { ret 1; }
    ret 0;
}

#[testing]
fun t_vtable(id: u32, name: str, arch_id: u32) AbiVTable {
    ret AbiVTable{
        passing:               catalog_abi.PASSING_CARRIERS,
        id:                    id,
        name:                  name,
        arch_id:               arch_id,
        arg_passing:           t_arg,
        ret_passing:           t_ret,
        gp_arg_regs:           t_regs,
        callee_saved:          t_regs,
        stack_align:           16,
        indirect_result_reg:   -1,
        fp_callee_saved_bytes: 8,
        float_arg_bits:        64,
        arg_slot_granularity:  8,
        va_model:              t_va_model,
    };
}

#[testing]
fun refused(vt: *AbiVTable) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    val r: err[fail.Fail] = validate(?alloc, vt);
    if (sel r.err) { ret true; }
    ret false;
}

test validate__rejects_malformed_descriptors {
    var valid: AbiVTable = t_vtable(catalog_abi.SYSV, "valid", catalog_arch.X86_64);
    if (refused(?valid)) { ret 1; }
    if (!refused(nil))   { ret 2; }

    var no_name: AbiVTable = t_vtable(catalog_abi.SYSV, "", catalog_arch.X86_64);
    if (!refused(?no_name)) { ret 3; }

    var no_arch: AbiVTable = t_vtable(catalog_abi.SYSV, "no_arch", catalog_arch.UNKNOWN);
    if (!refused(?no_arch)) { ret 4; }

    var no_arg: AbiVTable = t_vtable(catalog_abi.SYSV, "no_arg", catalog_arch.X86_64);
    no_arg.arg_passing = nil;
    if (!refused(?no_arg)) { ret 5; }

    var no_regfiles: AbiVTable = t_vtable(catalog_abi.SYSV, "no_regfiles", catalog_arch.X86_64);
    no_regfiles.callee_saved = nil;
    if (!refused(?no_regfiles)) { ret 6; }

    var no_granularity: AbiVTable = t_vtable(catalog_abi.SYSV, "no_granularity", catalog_arch.X86_64);
    no_granularity.arg_slot_granularity = 0;
    if (!refused(?no_granularity)) { ret 7; }

    var no_va_model: AbiVTable = t_vtable(catalog_abi.SYSV, "no_va_model", catalog_arch.X86_64);
    no_va_model.va_model = nil;
    if (!refused(?no_va_model)) { ret 8; }

    var values: AbiVTable = t_vtable(catalog_abi.SPIRV, "values", catalog_arch.SPIRV);
    values.passing = catalog_abi.PASSING_VALUES;
    if (!refused(?values)) { ret 9; }
    ret 0;
}

pub fun piece_memory_width(slot: *ParamSlot, piece: *ParamPiece) res[u8, fail.Fail] {
    if (piece.src_off < 0 || piece.src_off::u64 > slot.size) {
        ret res[u8, fail.Fail].err{fail.message("abi: piece starts outside the logical object")};
    }
    if (piece.width == 0 || (piece.width & (piece.width - 1)) != 0) {
        ret res[u8, fail.Fail].err{fail.message("abi: piece has no power-of-two transport width")};
    }
    if (piece.kind != PIECE_GP && piece.kind != PIECE_FP && piece.kind != PIECE_STACK) {
        ret res[u8, fail.Fail].err{fail.message("abi: piece has an unknown PieceKind")};
    }
    val remaining: u64 = slot.size - piece.src_off::u64;
    if (remaining < piece.width::u64) { ret res[u8, fail.Fail].ok{remaining::u8}; }
    ret res[u8, fail.Fail].ok{piece.width};
}

pub fun carrier_storage_extent(slot: *ParamSlot) res[u64, fail.Fail] {
    if (slot.piece_count > PARAM_MAX_PIECES) {
        ret res[u64, fail.Fail].err{fail.message("abi: piece count exceeds slot storage")};
    }
    var extent: u64 = slot.size;
    var i:      u32 = 0;
    for (i < slot.piece_count) {
        val p:     *ParamPiece        = ?slot.pieces[i];
        val valid: res[u8, fail.Fail] = piece_memory_width(slot, p);
        if (sel valid.err) { ret res[u64, fail.Fail].err{valid.err}; }
        val end: u64 = p.src_off::u64 + p.width::u64;
        if (end > extent) { extent = end; }
        i = i + 1;
    }
    ret res[u64, fail.Fail].ok{extent};
}

pub fun carrier_storage_alignment(slot: *ParamSlot) res[u32, fail.Fail] {
    if (slot.piece_count > PARAM_MAX_PIECES) {
        ret res[u32, fail.Fail].err{fail.message("abi: piece count exceeds slot storage")};
    }
    var align: u32 = 1;
    var i:     u32 = 0;
    for (i < slot.piece_count) {
        val p:     *ParamPiece        = ?slot.pieces[i];
        val valid: res[u8, fail.Fail] = piece_memory_width(slot, p);
        if (sel valid.err)                                 { ret res[u32, fail.Fail].err{valid.err}; }
        if (p.kind != PIECE_STACK && p.width::u32 > align) { align = p.width::u32; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{align};
}

test carrier_storage_extent__preserves_logical_tail {
    var hfa:        ParamSlot           = make_slot_hfa(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, 0), 4, 4, 16);
    val hfa_extent: res[u64, fail.Fail] = carrier_storage_extent(?hfa);
    if (sel hfa_extent.err)  { ret 5; }
    if (hfa_extent.ok != 16) { ret 5; }
    var width: u8 = 1;
    for (width <= 16) {
        var size: u64 = 0;
        for (size <= width::u64 * 2) {
            var slot: ParamSlot = make_slot_pair(CLASS_GP, 0, 1, 0, size, width::u32);
            if (size < width::u64) { slot.piece_count = 1; }
            val extent: res[u64, fail.Fail] = carrier_storage_extent(?slot);
            if (sel extent.err)                                  { ret 1; }
            if (extent.ok != width::u64 * slot.piece_count::u64) { ret 2; }
            var copied: u64 = 0;
            var i:      u32 = 0;
            for (i < slot.piece_count) {
                val wr: res[u8, fail.Fail] = piece_memory_width(?slot, ?slot.pieces[i]);
                if (sel wr.err) { ret 3; }
                copied = copied + wr.ok::u64;
                i      = i + 1;
            }
            if (copied != size) { ret 4; }
            size = size + 1;
        }
        width = width * 2;
    }
    ret 0;
}

test carrier_storage_extent__rejects_malformed_pieces {
    var slot: ParamSlot = make_slot(CLASS_GP, 0, 0, 4, 8);
    slot.pieces[0].src_off = -1;
    val r_986: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (!sel r_986.err) { ret 1; }
    slot.pieces[0].src_off = 5;
    val r_988: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (!sel r_988.err) { ret 2; }
    slot.pieces[0].src_off = 0;
    slot.pieces[0].width   = 0;
    val r_991: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (!sel r_991.err) { ret 3; }
    slot.pieces[0].width = 3;
    val r_993: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (!sel r_993.err) { ret 4; }
    slot.pieces[0].width = 8;
    slot.pieces[0].kind  = 255;
    val r_996: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (!sel r_996.err) { ret 5; }
    slot.pieces[0].kind = PIECE_FP;
    val r_998: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (sel r_998.err) { ret 6; }
    slot.pieces[0].kind = PIECE_STACK;
    val r_1000: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (sel r_1000.err) { ret 7; }
    slot.piece_count = PARAM_MAX_PIECES + 1;
    val r_1002: res[u64, fail.Fail] = carrier_storage_extent(?slot);
    if (!sel r_1002.err) { ret 8; }
    ret 0;
}

test carrier_storage_alignment__register_width_and_malformed_pieces {
    var slot: ParamSlot = make_slot_pair(CLASS_GP, 0, 1, 0, 12, 8);
    slot.pieces[0].width   = 4;
    slot.pieces[1].kind    = PIECE_FP;
    slot.pieces[1].src_off = 4;
    val aligned: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (sel aligned.err) { ret 1; }
    if (aligned.ok != 8) { ret 1; }
    slot.pieces[1].kind = PIECE_STACK;
    val stack: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (sel stack.err) { ret 2; }
    if (stack.ok != 4) { ret 2; }
    slot.pieces[1].width = 3;
    val r_1019: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (!sel r_1019.err) { ret 3; }
    slot.pieces[1].width   = 8;
    slot.pieces[1].src_off = -1;
    val r_1022: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (!sel r_1022.err) { ret 4; }
    slot.pieces[1].src_off = 4;
    slot.pieces[1].kind    = 255;
    val r_1025: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (!sel r_1025.err) { ret 5; }
    slot.piece_count = PARAM_MAX_PIECES + 1;
    val r_1027: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (!sel r_1027.err) { ret 6; }
    slot.piece_count = 0;
    val empty: res[u32, fail.Fail] = carrier_storage_alignment(?slot);
    if (sel empty.err) { ret 7; }
    if (empty.ok != 1) { ret 7; }
    ret 0;
}
