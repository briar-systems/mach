use std.allocator.page;
use std.format;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_copy;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.target.isa;

pub val ABI_UNKNOWN: u32 = 0;
pub val ABI_SYSV:    u32 = 1;
pub val ABI_WIN64:   u32 = 2;
pub val ABI_AAPCS64: u32 = 3;
pub val ABI_LP64:  u32 = 4;
pub val ABI_LP64F: u32 = 5;
pub val ABI_LP64D: u32 = 6;

pub val ABI_ILP32:  u32 = 7;
pub val ABI_ILP32F: u32 = 8;
pub val ABI_ILP32D: u32 = 9;
pub val ABI_SPIRV:  u32 = 10;

rec AbiSpec {
    abi:             u32;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val ABI_CATALOG_VERSION: u8 = 1;

val ABI_N: usize = 10;
val ABIS: [ABI_N]AbiSpec = [ABI_N]AbiSpec{
    AbiSpec{ abi: ABI_SYSV,    spelling: "sysv64",  fingerprint_tag: 1 },
    AbiSpec{ abi: ABI_WIN64,   spelling: "win64",   fingerprint_tag: 2 },
    AbiSpec{ abi: ABI_AAPCS64, spelling: "aapcs64", fingerprint_tag: 3 },
    AbiSpec{ abi: ABI_LP64,    spelling: "lp64",    fingerprint_tag: 4 },
    AbiSpec{ abi: ABI_LP64F,   spelling: "lp64f",   fingerprint_tag: 5 },
    AbiSpec{ abi: ABI_LP64D,   spelling: "lp64d",   fingerprint_tag: 6 },
    AbiSpec{ abi: ABI_ILP32,   spelling: "ilp32",   fingerprint_tag: 7 },
    AbiSpec{ abi: ABI_ILP32F,  spelling: "ilp32f",  fingerprint_tag: 8 },
    AbiSpec{ abi: ABI_ILP32D,  spelling: "ilp32d",  fingerprint_tag: 9 },
    AbiSpec{ abi: ABI_SPIRV,   spelling: "spirv",   fingerprint_tag: 10 },
};

fun abi_spec(id: u32) *AbiSpec {
    var i: usize = 0;
    for (i < ABI_N) {
        if (ABIS[i].abi == id) { ret ?ABIS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun abi_id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ABI_N) {
        if (str_equals(ABIS[i].spelling, name)) { ret ABIS[i].abi; }
        i = i + 1;
    }
    ret ABI_UNKNOWN;
}

pub fun abi_name_for(id: u32) str {
    val spec: *AbiSpec = abi_spec(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun abi_catalog_len() usize {
    ret ABI_N;
}

pub fun abi_catalog_name(index: usize) str {
    if (index >= ABI_N) { ret "unknown"; }
    ret ABIS[index].spelling;
}

pub fun abi_fingerprint_tag(id: u32) u8 {
    val spec: *AbiSpec = abi_spec(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

pub def ParamClass: u8;

pub val CLASS_GP:          ParamClass = 0;
pub val CLASS_FP:          ParamClass = 1;
pub val CLASS_STACK:       ParamClass = 2;
pub val CLASS_SRET:        ParamClass = 3;
pub val CLASS_BYREF:       ParamClass = 4;
pub val CLASS_STACK_BYREF: ParamClass = 5;
pub val CLASS_VEC_BYREF: ParamClass = 6;
pub val CLASS_VEC_STACK_BYREF: ParamClass = 7;
pub val CLASS_AGG: ParamClass = 8;

pub def PieceKind: u8;
pub val PIECE_GP:    PieceKind = 0;
pub val PIECE_FP:    PieceKind = 1;
pub val PIECE_STACK: PieceKind = 2;

pub val PARAM_MAX_PIECES: u32 = 4;

pub rec ParamPiece {
    kind:    PieceKind;
    reg:     i32;
    src_off: i64;
    stk_off: i64;
    width:   u8;
}

pub rec AggField { is_float: bool; offset: u32; width: u8; }
pub rec AggLayout { field_count: u8; fields: [2]AggField; }
pub fun agg_none() AggLayout { var a: AggLayout; a.field_count = 0; ret a; }

pub rec ParamSlot {
    class:          ParamClass;
    reg:            i32;
    offset:         i64;
    size:           u64;
    indirect_size:  u64;
    indirect_align: u32;
    pieces:         [PARAM_MAX_PIECES]ParamPiece;
    piece_count:    u32;
}

pub def ClassifyFn: fun(u64, u64, bool, u8, bool, i32, i32, u8, u8) ParamSlot;

pub def ArgPassingFn: fun(i32, u64, u64, bool, u8, bool, bool, i32, i32, u8, u8, AggLayout) ParamSlot;

pub def RetPassingFn: fun(u64, u64, bool, u8, bool, bool, u8, u8, AggLayout) ParamSlot;

pub def RegFileFn: isa.RegFileFn;

pub def VaModelFn: fun() VaModel;

pub rec AbiVTable {
    id:                          u32;
    name:                        str;
    arch_id:                     u32;
    classify:                    ClassifyFn;
    arg_passing:                 ArgPassingFn;
    ret_passing:                 RetPassingFn;
    gp_arg_regs:                 RegFileFn;
    callee_saved:                RegFileFn;
    stack_align:                 u32;
    red_zone:                    u32;
    shadow_space:                u32;
    indirect_result_reg:         i32;
    indirect_result_in_argfile:  bool;
    consumes_agg_layout:         bool;
    fp_callee_saved_full_vector: bool;
    float_arg_bits:              u32;
    arg_slot_granularity:        u32;
    va_model:                    VaModelFn;
}

pub fun abi_vtable(id: u32, name: str, arch_id: u32,
                   arg_passing: ArgPassingFn, ret_passing: RetPassingFn,
                   gp_arg_regs: RegFileFn, callee_saved: RegFileFn,
                   stack_align: u32, red_zone: u32, shadow_space: u32,
                   indirect_result_reg: i32, indirect_result_in_argfile: bool,
                   consumes_agg_layout: bool, fp_callee_saved_full_vector: bool,
                   float_arg_bits: u32, arg_slot_granularity: u32,
                   va_model: VaModelFn) AbiVTable {
    var v: AbiVTable;
    v.id                          = id;
    v.name                        = name;
    v.arch_id                     = arch_id;
    v.classify                    = nil;
    v.arg_passing                 = arg_passing;
    v.ret_passing                 = ret_passing;
    v.gp_arg_regs                 = gp_arg_regs;
    v.callee_saved                = callee_saved;
    v.stack_align                 = stack_align;
    v.red_zone                    = red_zone;
    v.shadow_space                = shadow_space;
    v.indirect_result_reg         = indirect_result_reg;
    v.indirect_result_in_argfile  = indirect_result_in_argfile;
    v.consumes_agg_layout         = consumes_agg_layout;
    v.fp_callee_saved_full_vector = fp_callee_saved_full_vector;
    v.float_arg_bits              = float_arg_bits;
    v.arg_slot_granularity        = arg_slot_granularity;
    v.va_model                    = va_model;
    ret v;
}

pub fun with_legacy_classifier(v: *AbiVTable, classify: ClassifyFn) {
    v.classify = classify;
}

fun t_classify(size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
               is_aggregate: bool, gp_used: i32, fp_used: i32,
               hfa_members: u8, hfa_elem: u8) ParamSlot {
    ret make_slot(CLASS_GP, gp_used, 0, size);
}

fun t_arg(index: i32, size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
          is_aggregate: bool, is_vector: bool, gp_used: i32, fp_used: i32,
          hfa_members: u8, hfa_elem: u8, agg: AggLayout) ParamSlot {
    ret make_slot(CLASS_GP, index, 0, size);
}

fun t_ret(size: u64, align: u64, is_float: bool, fp_eightbytes: u8,
          is_aggregate: bool, is_vector: bool, hfa_members: u8,
          hfa_elem: u8, agg: AggLayout) ParamSlot {
    ret make_slot(CLASS_GP, 0, 0, size);
}

fun t_regs(out: *isa.Register) i32 {
    ret 0;
}

fun t_va_model() VaModel {
    ret va_model_make(VA_MODEL_REG_SAVE, false, -1, 0);
}

test "mach.lang.target.abi.abi_vtable:sets_every_field" {
    val v: AbiVTable = abi_vtable(
        ABI_SYSV, "probe", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 128, 32,
        3, true,
        true, true,
        64, 8,
        t_va_model
    );

    if (v.id != ABI_SYSV)                       { ret 1; }
    if (!str_equals(v.name, "probe"))           { ret 1; }
    if (v.arch_id != isa.ARCH_X86_64)           { ret 1; }
    if (v.classify != nil)                       { ret 1; }
    with_legacy_classifier(?v, t_classify);
    if (v.classify != t_classify)                { ret 1; }
    if (v.arg_passing != t_arg)                  { ret 1; }
    if (v.ret_passing != t_ret)                  { ret 1; }
    if (v.gp_arg_regs != t_regs)                 { ret 1; }
    if (v.callee_saved != t_regs)                { ret 1; }
    if (v.stack_align != 16)                    { ret 1; }
    if (v.red_zone != 128)                      { ret 1; }
    if (v.shadow_space != 32)                   { ret 1; }
    if (v.indirect_result_reg != 3)             { ret 1; }
    if (!v.indirect_result_in_argfile)          { ret 1; }
    if (!v.consumes_agg_layout)                 { ret 1; }
    if (!v.fp_callee_saved_full_vector)         { ret 1; }
    if (v.float_arg_bits != 64)                 { ret 1; }
    if (v.va_model != t_va_model)               { ret 1; }

    val v2: AbiVTable = abi_vtable(0, "", 0, nil, nil, nil, nil, 0, 0, 0, 0, false, false, false, 0, 8, nil);
    if (v2.indirect_result_in_argfile)  { ret 1; }
    if (v2.consumes_agg_layout)         { ret 1; }
    if (v2.fp_callee_saved_full_vector) { ret 1; }
    ret 0;
}

val ABI_REGISTRY_CAP: u32 = 16;

pub rec AbiRegistry {
    entries: [16]AbiVTable;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

pub rec SigLayout {
    ret_slot:    ParamSlot;
    params:      *ParamSlot;
    param_count: u32;
    gp_used:     i32;
    fp_used:     i32;
    stack_off:   i64;
}

pub val VA_MODEL_REG_SAVE: u8 = 0;
pub val VA_MODEL_HOME:     u8 = 1;

pub rec VaModel {
    kind:                u8;
    float_dup_gp:        bool;
    vector_count_reg:    i32;
    variadic_float_bits: u32;
}

pub fun va_model_make(kind: u8, float_dup_gp: bool, vector_count_reg: i32,
                      variadic_float_bits: u32) VaModel {
    var m: VaModel;
    m.kind                = kind;
    m.float_dup_gp        = float_dup_gp;
    m.vector_count_reg    = vector_count_reg;
    m.variadic_float_bits = variadic_float_bits;
    ret m;
}

pub fun variadic_float_in_fp_bank(m: *VaModel, width: u64) bool {
    if (m.variadic_float_bits == 0) { ret false; }
    ret (width * 8) <= m.variadic_float_bits::u64;
}

test "mach.lang.target.abi.variadic_float_in_fp_bank:is_the_declared_width" {
    val never: VaModel = va_model_make(VA_MODEL_REG_SAVE, false, -1, 0);
    if (variadic_float_in_fp_bank(?never, 4)) { ret 1; }
    if (variadic_float_in_fp_bank(?never, 8)) { ret 1; }
    val single: VaModel = va_model_make(VA_MODEL_REG_SAVE, false, -1, 32);
    if (!variadic_float_in_fp_bank(?single, 4)) { ret 1; }
    if (variadic_float_in_fp_bank(?single, 8))  { ret 1; }
    val both: VaModel = va_model_make(VA_MODEL_HOME, true, 0, 64);
    if (!variadic_float_in_fp_bank(?both, 4)) { ret 1; }
    if (!variadic_float_in_fp_bank(?both, 8)) { ret 1; }
    if (!both.float_dup_gp)                   { ret 1; }
    if (both.kind != VA_MODEL_HOME)           { ret 1; }
    ret 0;
}

pub fun registry_init() AbiRegistry {
    var r: AbiRegistry;
    r.alloc_ready = O.is_none[str](page.make(?r.alloc));
    var i: u32 = 0;
    for (i < ABI_REGISTRY_CAP) {
        r.entries[i].id = ABI_UNKNOWN;
        r.entries[i].name = nil;
        i = i + 1;
    }
    r.count = 0;
    ret r;
}

pub fun registry_dnit(reg: *AbiRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > ABI_REGISTRY_CAP) { limit = ABI_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        if (reg.entries[i].name != nil) {
            A.deallocate[u8](?reg.alloc, reg.entries[i].name::*u8,
                             str_len(reg.entries[i].name) + 1);
            reg.entries[i].name = nil;
        }
        i = i + 1;
    }
    reg.count = 0;
}

fun errf(fb: str, fmt: str, va: ...) str {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret fb; }
    val r: R.Result[str, str] = format.sprint(?alloc, fmt, va...);
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

fun dup_id(reg: *AbiRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun descriptor_valid(vt: *AbiVTable) bool {
    ret vt != nil && str_len(vt.name) > 0 && vt.arch_id != isa.ARCH_UNKNOWN
        && vt.arg_passing != nil && vt.ret_passing != nil
        && vt.gp_arg_regs != nil && vt.callee_saved != nil
        && vt.va_model != nil && vt.arg_slot_granularity > 0;
}

pub fun registry_validate(reg: *AbiRegistry) R.Result[R.Void, str] {
    if (reg == nil) { ret R.err[R.Void, str]("mach.lang.target.abi: nil registry"); }
    if (!reg.alloc_ready || reg.count > ABI_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.abi: invalid registry backing or count");
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (!descriptor_valid(?reg.entries[i])) {
            ret R.err[R.Void, str]("mach.lang.target.abi: registry contains an invalid descriptor");
        }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(reg.entries[i].name, reg.entries[j].name)
                || (reg.entries[i].id != ABI_UNKNOWN && reg.entries[i].id == reg.entries[j].id)) {
                ret R.err[R.Void, str]("mach.lang.target.abi: registry contains a duplicate identity");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun register(reg: *AbiRegistry, vt: *AbiVTable) R.Result[R.Void, str] {
    if (reg == nil) {
        ret R.err[R.Void, str]("mach.lang.target.abi: register called with a nil registry");
    }
    if (reg.count > ABI_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.abi: registry count exceeds its backing capacity");
    }
    if (vt == nil) {
        ret R.err[R.Void, str]("mach.lang.target.abi: register called with a nil descriptor");
    }
    if (str_len(vt.name) == 0) {
        ret R.err[R.Void, str]("mach.lang.target.abi: register called with an empty name");
    }
    if (O.is_some[*AbiVTable](lookup(reg, vt.name))) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention is already registered under this name",
            "mach.lang.target.abi: a calling convention named '{}' is already registered", vt.name));
    }
    if (vt.id != ABI_UNKNOWN && dup_id(reg, vt.id)) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention is already registered under this catalog id",
            "mach.lang.target.abi: calling convention id {} is already registered (wanted to register '{}'; use ABI_UNKNOWN for a target-private convention outside the shared catalog)",
            vt.id, vt.name));
    }
    if (reg.count >= ABI_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.abi: registry is at capacity; raise ABI_REGISTRY_CAP to register another calling convention");
    }
    if (!reg.alloc_ready) {
        ret R.err[R.Void, str]("mach.lang.target.abi: registry backing allocator is unavailable");
    }
    if (vt.arch_id == isa.ARCH_UNKNOWN) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention must declare the instruction set it targets",
            "mach.lang.target.abi: calling convention '{}' does not declare a target instruction set", vt.name));
    }
    if (vt.arg_passing == nil || vt.ret_passing == nil) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention must declare argument and return classification",
            "mach.lang.target.abi: calling convention '{}' is missing `arg_passing` or `ret_passing`", vt.name));
    }
    if (vt.gp_arg_regs == nil || vt.callee_saved == nil) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention must declare its register files",
            "mach.lang.target.abi: calling convention '{}' is missing `gp_arg_regs` or `callee_saved`", vt.name));
    }
    if (vt.va_model == nil) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention must declare its variadic model",
            "mach.lang.target.abi: calling convention '{}' is missing `va_model`", vt.name));
    }
    if (vt.arg_slot_granularity == 0) {
        ret R.err[R.Void, str](errf("mach.lang.target.abi: a calling convention must declare a nonzero argument slot granularity",
            "mach.lang.target.abi: calling convention '{}' declares an `arg_slot_granularity` of 0", vt.name));
    }

    val name_r: R.Result[str, str] = str_copy(?reg.alloc, vt.name);
    if (R.is_err[str, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](name_r)); }
    reg.entries[reg.count] = @vt;
    reg.entries[reg.count].name = R.unwrap_ok[str, str](name_r);
    reg.count = reg.count + 1;
    ret R.ok_void[str]();
}

pub fun lookup(reg: *AbiRegistry, name: str) O.Option[*AbiVTable] {
    if (reg == nil || reg.count > ABI_REGISTRY_CAP) { ret O.none[*AbiVTable](); }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret O.some[*AbiVTable](?reg.entries[i]); }
        i = i + 1;
    }
    ret O.none[*AbiVTable]();
}

pub fun registered_count(reg: *AbiRegistry) u32 {
    if (reg == nil || reg.count > ABI_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun registered(reg: *AbiRegistry, idx: u32) O.Option[*AbiVTable] {
    if (reg == nil || reg.count > ABI_REGISTRY_CAP || idx >= reg.count) { ret O.none[*AbiVTable](); }
    ret O.some[*AbiVTable](?reg.entries[idx]);
}

test "mach.lang.target.abi.registry:owns_registered_descriptors" {
    var reg: AbiRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var name: [6]u8;
    name[0] = 'o'; name[1] = 'w'; name[2] = 'n'; name[3] = 'e'; name[4] = 'd'; name[5] = 0;
    var vt: AbiVTable = abi_vtable(
        ABI_SYSV, (?name[0])::str, isa.ARCH_X86_64,
        t_arg, t_ret, t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (R.is_err[R.Void, str](register(?reg, ?vt))) { registry_dnit(?reg); ret 1; }
    name[0] = 'x';
    val found: O.Option[*AbiVTable] = lookup(?reg, "owned");
    if (O.is_none[*AbiVTable](found)) { registry_dnit(?reg); ret 1; }
    if (!str_equals(O.unwrap[*AbiVTable](found).name, "owned")) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.register:rejects_nil_registry" {
    if (!R.is_err[R.Void, str](register(nil, nil))) { ret 1; }
    ret 0;
}

pub fun covers_isa(vt: *AbiVTable, arch_id: u32) bool {
    ret vt.arch_id == arch_id;
}

fun piece_for_reg(reg: i32, src_off: i64, word: u32) ParamPiece {
    var kind: PieceKind = PIECE_GP;
    if (isa.regid_class(reg) == isa.REG_CLASS_ID_XMM) { kind = PIECE_FP; }
    ret make_piece(kind, reg, src_off, 0, word::u8);
}

fun make_slot_base(class: ParamClass, reg: i32, offset: i64, size: u64) ParamSlot {
    var s: ParamSlot;
    s.class          = class;
    s.reg            = reg;
    s.offset         = offset;
    s.size           = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.piece_count    = 0;
    if (reg >= 0) {
        s.pieces[0]   = piece_for_reg(reg, 0, PIECE_WORD_SINGLE);
        s.piece_count = 1;
    }
    ret s;
}

pub fun make_slot(class: ParamClass, reg: i32, offset: i64, size: u64) ParamSlot {
    if (class == CLASS_VEC_BYREF || class == CLASS_VEC_STACK_BYREF) {
        panic("mach.lang.target.abi.make_slot: an indirect vector slot requires declared storage geometry\n");
    }
    ret make_slot_base(class, reg, offset, size);
}

pub fun make_slot_indirect(class: ParamClass, reg: i32, offset: i64, size: u64,
                           indirect_size: u64, indirect_align: u32) ParamSlot {
    if ((class != CLASS_VEC_BYREF && class != CLASS_VEC_STACK_BYREF) ||
        indirect_size == 0 || indirect_align == 0 || (indirect_align & (indirect_align - 1)) != 0) {
        panic("mach.lang.target.abi.make_slot_indirect: invalid indirect vector storage contract\n");
    }
    var s: ParamSlot = make_slot_base(class, reg, offset, size);
    s.indirect_size  = indirect_size;
    s.indirect_align = indirect_align;
    ret s;
}

pub fun make_slot_whole(reg: i32, size: u64) ParamSlot {
    var s: ParamSlot;
    s.class          = CLASS_AGG;
    s.reg            = reg;
    s.offset         = 0;
    s.size           = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.piece_count    = 0;
    ret s;
}

val PIECE_WORD_SINGLE: u32 = 8;

pub fun make_slot_pair(class: ParamClass, reg: i32, reg2: i32, offset: i64, size: u64,
                       word: u32) ParamSlot {
    var s: ParamSlot;
    s.class       = class;
    s.reg         = reg;
    s.offset      = offset;
    s.size        = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    s.piece_count = 0;
    if (reg >= 0) {
        s.pieces[0]   = piece_for_reg(reg, 0, word);
        s.piece_count = 1;
    }
    if (reg2 >= 0) {
        s.pieces[1]   = piece_for_reg(reg2, word::i64, word);
        s.piece_count = 2;
    }
    ret s;
}

pub fun make_slot_hfa(base_reg: i32, count: u8, elem: u8, size: u64) ParamSlot {
    if (count::u32 > PARAM_MAX_PIECES) {
        panic("mach.lang.target.abi.make_slot_hfa: piece count exceeds ParamSlot storage\n");
    }
    var s: ParamSlot;
    s.class     = CLASS_FP;
    s.reg       = base_reg;
    s.offset    = 0;
    s.size      = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    val base_ix: i32 = isa.regid_index(base_reg);
    var i: u32 = 0;
    for (i < count::u32) {
        s.pieces[i] = make_piece(PIECE_FP, isa.regid_make(isa.REG_CLASS_ID_XMM, base_ix + i::i32),
                                 (i * elem::u32)::i64, 0, elem);
        i = i + 1;
    }
    s.piece_count = count::u32;
    ret s;
}

pub fun make_piece(kind: PieceKind, reg: i32, src_off: i64, stk_off: i64, width: u8) ParamPiece {
    var p: ParamPiece;
    p.kind    = kind;
    p.reg     = reg;
    p.src_off = src_off;
    p.stk_off = stk_off;
    p.width   = width;
    ret p;
}

pub fun make_slot_pieces(class: ParamClass, pieces: *ParamPiece, count: u32, size: u64) ParamSlot {
    if (count > PARAM_MAX_PIECES) {
        panic("mach.lang.target.abi.make_slot_pieces: piece count exceeds ParamSlot storage\n");
    }
    var s: ParamSlot;
    s.class     = class;
    s.reg       = -1;
    s.offset    = 0;
    s.size      = size;
    s.indirect_size  = 0;
    s.indirect_align = 0;
    var i: u32 = 0;
    for (i < count) {
        s.pieces[i] = pieces[i];
        i = i + 1;
    }
    s.piece_count = count;
    ret s;
}

test "mach.lang.target.abi.covers_isa:matches_declared_arch" {
    var vt: AbiVTable = abi_vtable(
        0, "", isa.ARCH_AARCH64,
        nil, nil,
        nil, nil,
        0, 0, 0,
        -1, false,
        false, false,
        0, 8,
        nil
    );
    if (!covers_isa(?vt, isa.ARCH_AARCH64)) { ret 1; }
    if (covers_isa(?vt, isa.ARCH_X86_64))   { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.abi_name_for:round_trips" {
    if (!str_equals(abi_name_for(ABI_SYSV),    "sysv64"))  { ret 1; }
    if (!str_equals(abi_name_for(ABI_WIN64),   "win64"))   { ret 1; }
    if (!str_equals(abi_name_for(ABI_AAPCS64), "aapcs64")) { ret 1; }
    if (!str_equals(abi_name_for(ABI_LP64),    "lp64"))    { ret 1; }
    if (!str_equals(abi_name_for(ABI_LP64F),   "lp64f"))   { ret 1; }
    if (!str_equals(abi_name_for(ABI_LP64D),   "lp64d"))   { ret 1; }
    if (!str_equals(abi_name_for(ABI_ILP32),   "ilp32"))   { ret 1; }
    if (!str_equals(abi_name_for(ABI_ILP32F),  "ilp32f"))  { ret 1; }
    if (!str_equals(abi_name_for(ABI_ILP32D),  "ilp32d"))  { ret 1; }
    if (!str_equals(abi_name_for(ABI_UNKNOWN), "unknown")) { ret 1; }
    if (abi_id_for(abi_name_for(ABI_SYSV))    != ABI_SYSV)    { ret 1; }
    if (abi_id_for(abi_name_for(ABI_AAPCS64)) != ABI_AAPCS64) { ret 1; }
    if (abi_id_for(abi_name_for(ABI_LP64))  != ABI_LP64)  { ret 1; }
    if (abi_id_for(abi_name_for(ABI_LP64F)) != ABI_LP64F) { ret 1; }
    if (abi_id_for(abi_name_for(ABI_LP64D)) != ABI_LP64D) { ret 1; }
    if (abi_id_for(abi_name_for(ABI_ILP32))  != ABI_ILP32)  { ret 1; }
    if (abi_id_for(abi_name_for(ABI_SPIRV))  != ABI_SPIRV)  { ret 1; }
    if (abi_id_for(abi_name_for(ABI_ILP32F)) != ABI_ILP32F) { ret 1; }
    if (abi_id_for(abi_name_for(ABI_ILP32D)) != ABI_ILP32D) { ret 1; }
    if (ABI_ILP32 == ABI_LP64 || ABI_ILP32F == ABI_LP64F || ABI_ILP32D == ABI_LP64D) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.abi_catalog:complete_unique_ordered_roundtrip" {
    if (ABIS[0].abi != ABI_SYSV)    { ret 1; }
    if (ABIS[1].abi != ABI_WIN64)   { ret 1; }
    if (ABIS[2].abi != ABI_AAPCS64) { ret 1; }
    if (ABIS[3].abi != ABI_LP64)    { ret 1; }
    if (ABIS[4].abi != ABI_LP64F)   { ret 1; }
    if (ABIS[5].abi != ABI_LP64D)   { ret 1; }
    if (ABIS[6].abi != ABI_ILP32)   { ret 1; }
    if (ABIS[7].abi != ABI_ILP32F)  { ret 1; }
    if (ABIS[8].abi != ABI_ILP32D)  { ret 1; }

    var i: usize = 0;
    for (i < ABI_N) {
        if (ABIS[i].fingerprint_tag != (i + 1)::u8) { ret 1; }
        if (abi_id_for(ABIS[i].spelling) != ABIS[i].abi) { ret 1; }
        if (!str_equals(abi_name_for(ABIS[i].abi), ABIS[i].spelling)) { ret 1; }

        var j: usize = 0;
        for (j < ABI_N) {
            if (i != j) {
                if (ABIS[i].abi == ABIS[j].abi) { ret 1; }
                if (str_equals(ABIS[i].spelling, ABIS[j].spelling)) { ret 1; }
                if (ABIS[i].fingerprint_tag == ABIS[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.abi.make_slot_pair:geometry_is_the_conventions_word" {
    val p4: ParamSlot = make_slot_pair(CLASS_GP, 10, 11, 0, 8, 4);
    if (p4.piece_count != 2)       { ret 1; }
    if (p4.pieces[0].src_off != 0) { ret 1; }
    if (p4.pieces[0].width != 4)   { ret 1; }
    if (p4.pieces[1].reg != 11)    { ret 1; }
    if (p4.pieces[1].src_off != 4) { ret 1; }
    if (p4.pieces[1].width != 4)   { ret 1; }

    val p2: ParamSlot = make_slot_pair(CLASS_GP, 10, 11, 0, 4, 2);
    if (p2.pieces[1].src_off != 2) { ret 1; }
    if (p2.pieces[1].width != 2)   { ret 1; }

    val p8: ParamSlot = make_slot_pair(CLASS_GP, 10, 11, 0, 16, 8);
    if (p8.pieces[0].src_off != 0) { ret 1; }
    if (p8.pieces[1].src_off != 8) { ret 1; }
    if (p8.pieces[1].width != 8)   { ret 1; }

    val one: ParamSlot = make_slot(CLASS_GP, 10, 0, 8);
    if (one.piece_count != 1)       { ret 1; }
    if (one.pieces[0].src_off != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.register:rejects_nil_and_empty_name" {
    var reg: AbiRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (!R.is_err[R.Void, str](register(?reg, nil))) { ret 1; }

    var vt: AbiVTable = abi_vtable(
        ABI_SYSV, "", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.register:rejects_duplicate_catalog_id_but_allows_repeated_unknown" {
    var reg: AbiRegistry = registry_init();
    fin { registry_dnit(?reg); }

    var vt1: AbiVTable = abi_vtable(
        ABI_SYSV, "sysv_probe", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (R.is_err[R.Void, str](register(?reg, ?vt1))) { ret 1; }

    var vt2: AbiVTable = abi_vtable(
        ABI_SYSV, "sysv_probe_alias", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (!R.is_err[R.Void, str](register(?reg, ?vt2))) { ret 1; }

    var vt3: AbiVTable = abi_vtable(
        ABI_UNKNOWN, "private_a", isa.ARCH_MOS6502,
        t_arg, t_ret,
        t_regs, t_regs,
        1, 0, 0, -1, false, false, false, 0, 8, t_va_model
    );
    if (R.is_err[R.Void, str](register(?reg, ?vt3))) { ret 1; }

    var vt4: AbiVTable = abi_vtable(
        ABI_UNKNOWN, "private_b", isa.ARCH_SPIRV,
        t_arg, t_ret,
        t_regs, t_regs,
        0, 0, 0, -1, false, false, false, 0, 8, t_va_model
    );
    if (R.is_err[R.Void, str](register(?reg, ?vt4))) { ret 1; }

    if (registered_count(?reg) != 3) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.register:rejects_reregistering_the_same_descriptor" {
    var reg: AbiRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var vt: AbiVTable = abi_vtable(
        ABI_SYSV, "sysv_probe", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    if (registered_count(?reg) != 1) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.register:rejects_missing_arch_and_required_callbacks" {
    var reg: AbiRegistry = registry_init();
    fin { registry_dnit(?reg); }

    var no_arch: AbiVTable = abi_vtable(
        ABI_SYSV, "no_arch", isa.ARCH_UNKNOWN,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (!R.is_err[R.Void, str](register(?reg, ?no_arch))) { ret 1; }

    var no_arg: AbiVTable = abi_vtable(
        ABI_SYSV, "no_arg", isa.ARCH_X86_64,
        nil, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, t_va_model
    );
    if (!R.is_err[R.Void, str](register(?reg, ?no_arg))) { ret 1; }

    var no_regfiles: AbiVTable = abi_vtable(
        ABI_SYSV, "no_regfiles", isa.ARCH_X86_64,
        t_arg, t_ret,
        nil, nil,
        16, 0, 0, -1, false, false, false, 64, 8, nil
    );
    if (!R.is_err[R.Void, str](register(?reg, ?no_regfiles))) { ret 1; }

    var no_granularity: AbiVTable = abi_vtable(
        ABI_SYSV, "no_granularity", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 0, t_va_model
    );
    if (!R.is_err[R.Void, str](register(?reg, ?no_granularity))) { ret 1; }

    var no_va_model: AbiVTable = abi_vtable(
        ABI_SYSV, "no_va_model", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, nil
    );
    if (!R.is_err[R.Void, str](register(?reg, ?no_va_model))) { ret 1; }

    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.abi.register:refuses_past_capacity" {
    var reg: AbiRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var vts:   [16]AbiVTable;
    var names: [16][2]u8;
    var i: u32 = 0;
    for (i < ABI_REGISTRY_CAP) {
        names[i][0] = 'a'::u8 + i::u8;
        names[i][1] = 0;
        vts[i] = abi_vtable(
            ABI_UNKNOWN, (?names[i][0])::str, isa.ARCH_X86_64,
            t_arg, t_ret,
            t_regs, t_regs,
            16, 0, 0, -1, false, false, false, 64, 8, t_va_model
        );
        if (R.is_err[R.Void, str](register(?reg, ?vts[i]))) { ret 1; }
        i = i + 1;
    }
    if (registered_count(?reg) != ABI_REGISTRY_CAP) { ret 1; }

    var overflow: AbiVTable = abi_vtable(
        ABI_UNKNOWN, "overflow", isa.ARCH_X86_64,
        t_arg, t_ret,
        t_regs, t_regs,
        16, 0, 0, -1, false, false, false, 64, 8, nil
    );
    if (!R.is_err[R.Void, str](register(?reg, ?overflow))) { ret 1; }
    if (registered_count(?reg) != ABI_REGISTRY_CAP) { ret 1; }
    ret 0;
}
