test "mach.lang.target.isa.register:rejects_contradictory_and_incomplete_backends" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }

    var neither_model: MachineModel = t_model(8);
    var neither: IsaVTable = isa_common(ARCH_AARCH64, "neither", 0, 8, ?neither_model);
    if (!R.is_err[R.Void, str](register(?reg, ?neither))) { ret 1; }

    var m: RegMachine = t_machine();
    var both_model: MachineModel = t_model(8);
    var both: IsaVTable = isa_common(ARCH_RISCV64, "both", 0, 8, ?both_model);
    both.machine = ?m;
    var emitter: ModuleEmitter = module_emitter(t_emit_module);
    both.emitter = ?emitter;
    if (!R.is_err[R.Void, str](register(?reg, ?both))) { ret 1; }

    var rs3: RelocSeam = t_reloc();
    var whole_model: MachineModel = t_model(8);
    var whole_with_reloc: IsaVTable = emitter_isa(ARCH_MOS6502, "whole_with_reloc", 8, ?whole_model, ?emitter);
    whole_with_reloc.reloc = ?rs3;
    if (!R.is_err[R.Void, str](register(?reg, ?whole_with_reloc))) { ret 1; }

    var incomplete_machine: RegMachine = t_machine();
    incomplete_machine.is_reg_move = nil;
    var incomplete_model: MachineModel = t_model(8);
    var incomplete: IsaVTable = machine_isa(ARCH_X86_64, "incomplete", 0, 8, ?incomplete_model, ?incomplete_machine, nil);
    if (!R.is_err[R.Void, str](register(?reg, ?incomplete))) { ret 1; }

    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

