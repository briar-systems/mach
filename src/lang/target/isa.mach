pub def Endian: u8;
pub val ENDIAN_LITTLE: Endian = 0;
pub val ENDIAN_BIG:    Endian = 1;

pub val ARCH_UNKNOWN: u32 = arch.UNKNOWN;
pub val ARCH_X86_64:  u32 = arch.X86_64;
pub val ARCH_AARCH64: u32 = arch.AARCH64;
pub val ARCH_RISCV64: u32 = arch.RISCV64;
pub val ARCH_SPIRV:   u32 = arch.SPIRV;
pub val ARCH_RISCV32: u32 = arch.RISCV32;

pub val ISA_LABEL:       u16 = 0xFFFF;
pub val ISA_PCOPY:       u16 = 0xFFFD;
pub val ISA_PCOPY_FENCE: u16 = 0xFFFC;
pub val ISA_USE:         u16 = 0xFFFB;

pub def OperandKind: u8;

pub val OPK_NONE:  OperandKind = 0;
pub val OPK_REG:   OperandKind = 1;
pub val OPK_IMM:   OperandKind = 2;
pub val OPK_MEM:   OperandKind = 3;
pub val OPK_LABEL: OperandKind = 4;
pub val OPK_SYM:   OperandKind = 5;

pub val REG_CLASS_ID_GP:  i32 = 0;
pub val REG_CLASS_ID_XMM: i32 = 1;

pub rec Register {
    id:   i32;
    size: u8;
}

pub def SymModifier: u8;
pub val SYM_MOD_NONE:     SymModifier = 0;
pub val SYM_MOD_PCREL_HI: SymModifier = 1;
pub val SYM_MOD_PCREL_LO: SymModifier = 2;
pub val SYM_MOD_GOT_HI:   SymModifier = 3;
pub val SYM_MOD_GOT_LO:   SymModifier = 4;
# a whole pc-relative reference to the symbol's GOT slot (x86-64 GOTPCREL)
pub val SYM_MOD_GOT: SymModifier = 5;

pub rec Operand {
    kind:       OperandKind;
    size:       u8;
    reg:        i32;
    imm:        i64;
    base:       i32;
    index:      i32;
    scale:      u8;
    disp:       i32;
    sym_id:     u32;
    label:      str;
    sym_mod:    SymModifier;
    sym_addend: i64;
    # a memory operand's segment override, numbered by the ISA; 0 is none
    seg: u8;
}

pub rec Inst {
    opcode: u16;
    dst:    Operand;
    src1:   Operand;
    src2:   Operand;
    # a fourth operand for the ISAs whose instructions read three sources (aarch64 madd/msub)
    src3:     Operand;
    size:     u8;
    flags:    u16;
    src_line: u32;
    src_file: str;
}

#[testing]
pub rec InstBuf {
    insts: *Inst;
    count: i32;
    cap:   i32;
    alloc: *A.Allocator;
    err:   bool;
}

#[testing]
val INSTBUF_INIT_CAP: i32 = 64;

pub def RegClassKind: u8;
pub val RC_GENERAL: RegClassKind = 0;
pub val RC_FLOAT:   RegClassKind = 1;
pub val RC_VECTOR:  RegClassKind = 2;
pub val RC_FLAGS:   RegClassKind = 3;

pub rec RegClass {
    name: str;
    kind: RegClassKind;
    len:  u32;
}

pub def VecOp: u32;
pub val VEC_OP_NONE: VecOp = 0;
pub val VEC_OP_ADD:  VecOp = 1;
pub val VEC_OP_SUB:  VecOp = 2;
pub val VEC_OP_MUL:  VecOp = 3;
pub val VEC_OP_DIV:  VecOp = 4;
pub val VEC_OP_AND:  VecOp = 5;
pub val VEC_OP_OR:   VecOp = 6;
pub val VEC_OP_XOR:  VecOp = 7;
pub val VEC_OP_NOT:  VecOp = 8;
pub val VEC_OP_NEG:  VecOp = 9;
pub val VEC_OP_CMP:  VecOp = 12;

# lane-wise conversions: the operation fixes each side's lane kind and
# signedness, and a cell also names the source lane width
pub val VEC_OP_TRUNC:    VecOp = 13;
pub val VEC_OP_SEXT:     VecOp = 14;
pub val VEC_OP_ZEXT:     VecOp = 15;
pub val VEC_OP_FP_TRUNC: VecOp = 16;
pub val VEC_OP_FP_EXT:   VecOp = 17;
pub val VEC_OP_FP_TO_SI: VecOp = 18;
pub val VEC_OP_FP_TO_UI: VecOp = 19;
pub val VEC_OP_SI_TO_FP: VecOp = 20;
pub val VEC_OP_UI_TO_FP: VecOp = 21;

# a widening multiply: both operands share a lane type, and the result lanes are
# twice as wide and hold the full product under the operation's signedness. a
# cell names the result lane width and the operand lane width; its scalar row is
# the unfused path, where each operand is extended and then multiplied
pub val VEC_OP_MUL_WIDE_S: VecOp = 22;
pub val VEC_OP_MUL_WIDE_U: VecOp = 23;

# a lane-halving extension: half the operand's integer lanes (its low or high
# half), each extended to twice the width under the operation's signedness. a
# cell names the result lane width and the operand lane width; its scalar row
# is the unfused path, one extension per lane into a rebuilt vector (#3738)
pub val VEC_OP_WIDEN_S: VecOp = 24;
pub val VEC_OP_WIDEN_U: VecOp = 25;

# the lane-wise shifts of integer lanes, keyed by direction, by signedness for
# a right shift, and by the count's form, since the packed answer differs along
# each (#3740): a uniform count (`_U`) is one scalar applied to every lane, the
# form every baseline set has an instruction for, and a per-lane count (`_V`)
# is a vector of counts, one per lane. a count at or above the lane width
# saturates in every form, as the scalar shift does (#3756)
pub val VEC_OP_SHL_U:   VecOp = 26;
pub val VEC_OP_SHR_U_U: VecOp = 27;
pub val VEC_OP_SHR_S_U: VecOp = 28;
pub val VEC_OP_SHL_V:   VecOp = 29;
pub val VEC_OP_SHR_U_V: VecOp = 30;
pub val VEC_OP_SHR_S_V: VecOp = 31;

# a lane range: the lanes of the operand from a constant first lane on, of the
# same lane type, in a vector of at most as many lanes. a cell names the lane
# kind and width, which the operation keeps; its scalar row is the lane path,
# each lane extracted and the result built or written through memory (#3864)
pub val VEC_OP_RANGE: VecOp = 32;

# a lane join: the lanes of each operand in turn, all of one lane type, in one
# vector of their summed count. it is how a vector wider than the register is
# put back together from its register-width pieces, and how a narrowing
# conversion over those pieces gathers its halves (#3589). a cell names the
# lane kind and width, which the operation keeps; its scalar row is the lane
# path through memory
pub val VEC_OP_CONCAT: VecOp = 33;

# the high half of the full product of two integer lanes, in lanes of their
# own width, under the operation's signedness: the upper word of the widening
# multiply, whose lower word is the plain multiply. a cell names the lane width
# twice; its scalar row is each lane's own high multiply (#4119)
pub val VEC_OP_MUL_HIGH_S: VecOp = 34;
pub val VEC_OP_MUL_HIGH_U: VecOp = 35;

# a lane interleave: lane i of the low operand and lane i of the high operand
# joined into one lane twice as wide, the low operand's lane in its low half.
# it is how a target whose widening multiply is the low and the high multiply
# pairs the two into full products. a cell names the result lane width and the
# operand lane width; its scalar row is each lane joined on its own (#4119)
pub val VEC_OP_INTERLEAVE: VecOp = 36;

# a widening group sum: each result lane the zero-extended sum of the operand
# integer lanes it covers, so the result holds the operand's bits in fewer,
# wider lanes. a cell names the result lane width and the operand lane width;
# its scalar row is the per-lane sum, and only a packed cell is ever formed,
# as the fold of a count accumulated in narrow lanes (#4161)
pub val VEC_OP_WIDEN_SUM_U: VecOp = 37;

# a lane sign mask: each integer lane all ones when it is negative, else zero,
# in lanes of its own width. it is the high half a signed lane-halving
# extension interleaves its lanes with, so both halves of one extension share
# it; its scalar row is each lane shifted right by its width less one, and
# only a packed cell is ever formed (#4198)
pub val VEC_OP_SIGN_MASK: VecOp = 38;
pub val VEC_OP_LAST:      VecOp = VEC_OP_SIGN_MASK;

# a cell is the operation, the result lane kind and width, and the operand
# lane width; an operation that keeps its lanes repeats lane_bits there. ext
# is the extension bits the packed instruction needs, none for the baseline:
# a gated row takes part only when the selected target holds every bit, and
# the same cell may then also carry a baseline scalar row for when it does not
pub rec PackedForm {
    op:        VecOp;
    is_float:  bool;
    lane_bits: u32;
    from_bits: u32;
    ext:       u64;
}

# a row an ISA with a vector unit declares as the documented scalar expansion:
# the same key as a packed row, and the two tables together must cover the
# retained domain exactly once, so a cell in neither is a missing decision
pub rec ScalarForm {
    op:        VecOp;
    is_float:  bool;
    lane_bits: u32;
    from_bits: u32;
}

pub def VectorForm: u8;
pub val FORM_UNDECLARED: VectorForm = 0;
pub val FORM_SCALAR:     VectorForm = 1;
pub val FORM_PACKED:     VectorForm = 2;

pub val VECTOR_BITS_128: u32 = 128;

# a width the vector register file takes under an extension: with `ext`
# selected a register carries `bytes`, more than the compute width
# `vector_bits` the packed rows run at. a convention that places a vector by
# the register it fits reads the widest selected row (#3751). `upper_clear`
# says the narrower code the target emits pays for a register's upper bytes
# while they hold a value, so the upper state is cleared once a value of this
# width has been moved out of its register (x86-64's vzeroupper after a ymm
# value, which the legacy-encoded 128-bit instructions otherwise stall on)
pub rec VectorRegisterRow {
    ext:         u64;
    bytes:       u32;
    upper_clear: bool;
}

# a compute width an extension gives the packed rows over one kind of lane:
# with `ext` selected, the rows over float lanes (`is_float`) or integer ones
# of the byte widths `lanes` names (a sum of 1, 2, 4 and 8, as vec_mem_widths)
# run at `bits` rather than the baseline `vector_bits`. a vector of those
# lanes is then realized whole in a register that wide, and type legalization
# splits it only past it (#4128). the kinds widen apart on a target whose
# extensions do: x86-64's avx computes binary32 and binary64 at 256 bits and
# leaves integers at 128 until avx2
pub rec VectorWidthRow {
    ext:      u64;
    is_float: bool;
    lanes:    u32;
    bits:     u32;
}

pub val VECTOR_LANES_UNBOUNDED: u32 = 0;

pub val VEC_MEM_NONE: u32 = 0;

pub val VEC_MEM_4_8_16: u32 = 4 + 8 + 16;

pub val VEC_MEM_ALL_128: u32 = 1 + 2 + 4 + 8 + 16;

pub val XBANK_NONE: u32 = 0;

pub val XBANK_4: u32 = 4;

pub val XBANK_4_8: u32 = 4 + 8;

pub val XBANK_2_4_8: u32 = 2 + 4 + 8;

pub val SLOT_READ_NONE: u32 = 0;

pub val SLOT_READ_1_2_4_8: u32 = 1 + 2 + 4 + 8;

pub val SHIFT_MOD_NONE: u32 = 0;

pub val SHIFT_MOD_4: u32 = 4;

pub val SHIFT_MOD_4_8: u32 = 4 + 8;

# the scalar integer widths a target realizes, encoded like vec_mem_widths:
# the bit for a width is that width; every ISA declares the 64-bit set today
# and none the 128-bit one (#3511)
pub val INT_WIDTHS_1_2_4_8: u32 = 1 + 2 + 4 + 8;

pub val INT_WIDTHS_1_2_4_8_16: u32 = 1 + 2 + 4 + 8 + 16;

# alu width sets for declare_alu_widths, encoded like int_widths
pub val ALU_WIDTHS_4:       u32 = 4;
pub val ALU_WIDTHS_4_8:     u32 = 4 + 8;
pub val ALU_WIDTHS_1_2_4_8: u32 = 1 + 2 + 4 + 8;

# how a target realizes the full product of two lane-width integers: no
# instruction (the schoolbook over extended operands), a three-address high
# multiply beside the low one, or a fixed register pair (#3511, Q11); a
# declaration, never derived from mul_hi_width
pub def MulWideForm: u8;

pub val MULW_NONE:          MulWideForm = 0;
pub val MULW_THREE_ADDRESS: MulWideForm = 1;
pub val MULW_FIXED_PAIR:    MulWideForm = 2;

# one width the alu computes an integer at, in bytes, legal while the model
# holds every extension in `ext` (0 when it always is)
pub rec AluWidth {
    bytes: u32;
    ext:   u64;
}

pub val ALU_WIDTH_CAP: u32 = 5;

pub rec MachineModel {
    pointer_width: u32;
    gpr_width:     u32;

    # ordinary-memory unaligned gp widths, encoded as the sum of byte widths
    gp_unaligned_widths: u32;

    # the integer widths the alu computes at, the one declaration of them: the
    # width an operation is lifted to and the ceiling legalize splits above are
    # both read from it (clamp_alu_width, max_alu_width)
    alu_widths:    [ALU_WIDTH_CAP]AluWidth;
    alu_width_len: u32;

    spill_width: u32;
    endianness:  Endian;

    reg_classes:     *RegClass;
    reg_class_len:   u32;
    frame_ptr_reg:   i32;
    stack_ptr_reg:   i32;
    reserved_regs:   *Register;
    reserved_len:    i32;
    div_reg:         i32;
    div_hi_reg:      i32;
    shift_count_reg: i32;

    incoming_arg_base:      i64;
    stack_align:            u32;
    red_zone:               u32;
    shadow_space:           u32;
    has_v128:               bool;
    vector_bits:            u32;
    max_vector_lanes:       u32;
    vector_compute_generic: bool;
    has_lane_ops:           bool;
    has_vec_build:          bool;

    vec_mem_widths: u32;

    xbank_widths: u32;

    # the general widths at which a selected arithmetic or compare instruction
    # reads one spilled source operand in place from its frame slot
    slot_read_widths: u32;

    # the register allocator tracks each value's lifetime as its live segments
    # rather than one span from first definition to last use: a register is
    # free across a hole, a value evicted under pressure re-enters a register
    # for a later run of uses, and the eviction picks the lightest value by
    # loop-weighted use density. declared per target so a target's code stays
    # stable until it opts in (#3495)
    lifetime_holes: bool;

    # the multiply realizations with data-independent timing, each under its
    # condition; a cell no row names is refused on a secret operand
    ct_mul_forms:    *ct.CtMulForm;
    ct_mul_form_len: u32;

    has_var_shift: bool;

    # the widths, as the sum of their byte counts, at which a variable scalar
    # shift reads only the low log2(8 * width) bits of its count: a count
    # masked by 8 * width - 1 is then the unmasked count to the machine (#3893)
    shift_count_mod_widths: u32;

    # the narrowest integer lane a packed vector shift instruction shifts; a
    # lane half as wide is shifted as lanes of this width, each half on its
    # own. 0 when every lane width has its own (#3740)
    packed_shift_min_bits: u32;

    has_mul: bool;

    has_float: bool;

    mul_hi_width: u32;

    int_widths: u32;

    mul_wide_form: MulWideForm;

    flat_addressing: bool;

    # a load or store takes a base register, a scaled index register and a
    # displacement as its address, so an element address folds into the
    # access instead of being materialized
    indexed_memory: bool;

    # the signed width of a constant offset folded into a pc-relative symbol
    # reference. the relocation carries any offset, but the address it forms
    # must stay in the instruction's reach from the pc, which the compiler
    # cannot see, so only an offset small against that reach is folded and a
    # larger one is added to the symbol's address instead: 25 bits, +-16 MB,
    # the window x86-64's small code model leaves, against the +-2 GB of
    # disp32 and auipc and the +-4 GB of adrp; 0 is no bound (#3907)
    sym_offset_bits: u32;

    # the signed width of a constant displacement a base-register memory
    # operand encodes, so that one beyond it is added into the base first; 0
    # is no bound, where the encoder materializes any displacement (#3907)
    mem_disp_bits: u32;

    # the byte alignment of a function's entry: the encoder pads the text
    # before each function to it, or to the function's own `#[align]` when
    # larger, so where a function's code falls against fetch and branch
    # boundaries does not depend on the size of the code before it (#4079)
    function_align: u32;

    # the byte the padding between functions is filled with, one whose
    # instruction traps, since nothing ever executes it
    code_fill: u8;

    # control flow is emitted as nested constructs whose edges must enter and
    # leave through their merge, break and continue blocks, so a pass may not
    # redirect an edge across a construct boundary
    structured_control_flow: bool;

    ct_trust_var_shift: bool;

    packed_forms:    *PackedForm;
    packed_form_len: u32;
    scalar_forms:    *ScalarForm;
    scalar_form_len: u32;

    # the scalar f16 operations the target realizes with its own instruction,
    # keyed as a vector cell with one side a 16-bit float; every operation no
    # selected row names is the inlined expansion every target shares (#3799)
    half_forms:    *PackedForm;
    half_form_len: u32;

    # the expansion computes in binary32 and 32-bit integers, not binary64 and
    # 64-bit ones: the same bits, with no 64-bit type a device may lack (#4332)
    half_binary32: bool;

    flen_bits: u32;

    # what the target's conversion between float formats makes of a NaN, which
    # comptime folds a conversion by so that it equals the one at run time
    nan_rule: float.NanRule;

    # the binary float units return the first NaN operand, quieted, whether or
    # not a later one signals, so quieting an operand before the operation
    # leaves its NaN result unchanged (x86 sse). false where a signaling
    # operand takes priority (aarch64) or the rule was never established
    nan_first_operand: bool;

    # the register widths extensions give the vector register file beyond the
    # compute width, none where the register is always `vector_bits` wide
    vector_register_rows:    *VectorRegisterRow;
    vector_register_row_len: u32;

    # the compute widths extensions give the packed rows beyond `vector_bits`,
    # per lane kind, none where every row runs at `vector_bits`
    vector_width_rows:    *VectorWidthRow;
    vector_width_row_len: u32;

    # every lane-wise integer extension, over any number of doublings of the
    # lane, is one instruction under the extensions `direct_extend_ext` names
    # (x86-64 pmovsx and pmovzx under sse41). elsewhere an extension over more
    # than one doubling is a chain of doublings, which type legalization builds
    # as a tree of lane-halving extensions over the pieces (#4161)
    direct_extend:     bool;
    direct_extend_ext: u64;

    # the selected extensions, as bits of this isa's vocabulary; the table is
    # the isa module's own and names every bit the isa models
    extensions:      u64;
    extension_table: *extension.Extension;
    extension_count: u32;
    # the published levels the manifest may spell over the same vocabulary,
    # none on an isa without them (#3741)
    level_table: *extension.Level;
    level_count: u32;

    index_width:          u32;
    vector_op_bytes:      u32;
    vectors_in_registers: bool;
    auto_vectorize:       bool;
}

fun int_lane(bits: u32) bool {
    ret bits == 8 || bits == 16 || bits == 32 || bits == 64;
}

fun float_lane(bits: u32) bool {
    ret bits == 32 || bits == 64;
}

# a float vector lane: binary16 beside the scalar float widths (#3802)
fun float_vec_lane(bits: u32) bool {
    ret bits == 16 || float_lane(bits);
}

pub fun is_convert_op(op: VecOp) bool {
    ret op >= VEC_OP_TRUNC && op <= VEC_OP_UI_TO_FP;
}

pub fun is_widen_op(op: VecOp) bool {
    ret op == VEC_OP_MUL_WIDE_S || op == VEC_OP_MUL_WIDE_U;
}

pub fun is_mul_high_op(op: VecOp) bool {
    ret op == VEC_OP_MUL_HIGH_S || op == VEC_OP_MUL_HIGH_U;
}

pub fun is_interleave_op(op: VecOp) bool {
    ret op == VEC_OP_INTERLEAVE;
}

pub fun is_widen_half_op(op: VecOp) bool {
    ret op == VEC_OP_WIDEN_S || op == VEC_OP_WIDEN_U;
}

pub fun is_widen_sum_op(op: VecOp) bool {
    ret op == VEC_OP_WIDEN_SUM_U;
}

pub fun is_sign_mask_op(op: VecOp) bool {
    ret op == VEC_OP_SIGN_MASK;
}

pub fun is_shift_op(op: VecOp) bool {
    ret op >= VEC_OP_SHL_U && op <= VEC_OP_SHR_S_V;
}

pub fun is_range_op(op: VecOp) bool {
    ret op == VEC_OP_RANGE;
}

# the lane rearrangements: a range of one vector's lanes and a join of several
pub fun is_permute_op(op: VecOp) bool {
    ret op == VEC_OP_RANGE || op == VEC_OP_CONCAT;
}

fun widen_cell_valid(is_float: bool, lane_bits: u32, from_bits: u32) bool {
    ret !is_float && int_lane(from_bits) && int_lane(lane_bits) && lane_bits == from_bits * 2;
}

fun convert_cell_valid(op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) bool {
    if (op == VEC_OP_TRUNC) { ret !is_float && int_lane(lane_bits) && int_lane(from_bits) && lane_bits < from_bits; }
    if (op == VEC_OP_SEXT || op == VEC_OP_ZEXT) {
        ret !is_float && int_lane(lane_bits) && int_lane(from_bits) && lane_bits > from_bits;
    }
    if (op == VEC_OP_FP_TRUNC)                          { ret is_float && float_vec_lane(lane_bits) && float_vec_lane(from_bits) && lane_bits < from_bits; }
    if (op == VEC_OP_FP_EXT)                            { ret is_float && float_vec_lane(lane_bits) && float_vec_lane(from_bits) && lane_bits > from_bits; }
    if (op == VEC_OP_FP_TO_SI || op == VEC_OP_FP_TO_UI) { ret !is_float && int_lane(lane_bits) && float_vec_lane(from_bits); }
    if (op == VEC_OP_SI_TO_FP || op == VEC_OP_UI_TO_FP) { ret is_float && float_vec_lane(lane_bits) && int_lane(from_bits); }
    ret false;
}

fun packed_form_valid(op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) bool {
    if (is_convert_op(op))      { ret convert_cell_valid(op, is_float, lane_bits, from_bits); }
    if (is_widen_op(op))        { ret widen_cell_valid(is_float, lane_bits, from_bits); }
    if (is_widen_half_op(op))   { ret widen_cell_valid(is_float, lane_bits, from_bits); }
    if (is_interleave_op(op))   { ret widen_cell_valid(is_float, lane_bits, from_bits); }
    if (is_widen_sum_op(op))    { ret !is_float && int_lane(from_bits) && int_lane(lane_bits) && lane_bits > from_bits; }
    if (from_bits != lane_bits) { ret false; }
    if (is_float == true) {
        if (!float_vec_lane(lane_bits)) { ret false; }
        ret op == VEC_OP_ADD || is_permute_op(op) || op == VEC_OP_SUB || op == VEC_OP_MUL
            || op == VEC_OP_DIV || op == VEC_OP_CMP;
    }
    if (is_float != false)                                                       { ret false; }
    if (lane_bits != 8 && lane_bits != 16 && lane_bits != 32 && lane_bits != 64) { ret false; }
    ret op == VEC_OP_ADD || op == VEC_OP_SUB || op == VEC_OP_MUL
        || op == VEC_OP_DIV || op == VEC_OP_AND || op == VEC_OP_OR
        || op == VEC_OP_XOR || op == VEC_OP_NOT || op == VEC_OP_CMP
        || is_shift_op(op) || is_permute_op(op) || is_mul_high_op(op) || is_sign_mask_op(op);
}

# a scalar f16 cell: arithmetic and comparison at 16 bits, or a conversion
# with a 16-bit float on one side
fun half_form_valid(op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) bool {
    if (op == VEC_OP_ADD || op == VEC_OP_SUB || op == VEC_OP_MUL || op == VEC_OP_DIV || op == VEC_OP_CMP) {
        ret is_float && lane_bits == 16 && from_bits == 16;
    }
    if (op == VEC_OP_FP_EXT)                            { ret is_float && from_bits == 16 && float_lane(lane_bits); }
    if (op == VEC_OP_FP_TRUNC)                          { ret is_float && lane_bits == 16 && float_lane(from_bits); }
    if (op == VEC_OP_FP_TO_SI || op == VEC_OP_FP_TO_UI) { ret !is_float && int_lane(lane_bits) && from_bits == 16; }
    if (op == VEC_OP_SI_TO_FP || op == VEC_OP_UI_TO_FP) { ret is_float && lane_bits == 16 && int_lane(from_bits); }
    ret false;
}

fun half_forms_valid(m: *MachineModel) bool {
    if (m.half_form_len == 0) { ret true; }
    if (m.half_forms == nil)  { ret false; }
    var i: u32 = 0;
    for (i < m.half_form_len) {
        val row: *PackedForm = ?m.half_forms[i];
        if (!half_form_valid(row.op, row.is_float, row.lane_bits, row.from_bits)) { ret false; }
        if ((row.ext & ~extension_domain(m)) != 0)                                { ret false; }
        var j: u32 = 0;
        for (j < i) {
            val prior: *PackedForm = ?m.half_forms[j];
            if (cell_is(prior, row.op, row.is_float, row.lane_bits, row.from_bits) && prior.ext == row.ext) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# the target realizes this scalar f16 cell with its own instruction under the
# selected extensions; false is the inlined expansion
pub fun half_native(m: *MachineModel, op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) bool {
    if (m.half_forms == nil) { ret false; }
    var i: u32 = 0;
    for (i < m.half_form_len) {
        val row: *PackedForm = ?m.half_forms[i];
        if (cell_is(row, op, is_float, lane_bits, from_bits) && packed_row_selected(m, row)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the widest selected row of the register-width table, nil when none is selected
fun widest_register_row(m: *MachineModel) *VectorRegisterRow {
    var out: *VectorRegisterRow = nil;
    if (m.vector_register_rows == nil) { ret out; }
    var i: u32 = 0;
    for (i < m.vector_register_row_len) {
        val row: *VectorRegisterRow = ?m.vector_register_rows[i];
        if ((m.extensions & row.ext) == row.ext && (out == nil || row.bytes > out.bytes)) { out = row; }
        i = i + 1;
    }
    ret out;
}

# the widest vector one register carries under the selected extensions: the
# compute width, or a selected row's wider register
pub fun vector_register_bytes(m: *MachineModel) u32 {
    val row: *VectorRegisterRow = widest_register_row(m);
    if (row != nil) { ret row.bytes; }
    ret m.vector_bits / 8;
}

# the widest vector register the selected extensions give, in bits: the
# layout aligns a vector as wide as one to it (#4128)
pub fun vector_register_bits(m: *MachineModel) u32 {
    ret vector_register_bytes(m) * 8;
}

# a value `bytes` wide moved out of its register leaves upper state the
# target clears afterwards
pub fun vector_upper_clear(m: *MachineModel, bytes: u32) bool {
    if (m.vector_register_rows == nil || bytes <= m.vector_bits / 8) { ret false; }
    var i: u32 = 0;
    for (i < m.vector_register_row_len) {
        val row: *VectorRegisterRow = ?m.vector_register_rows[i];
        if ((m.extensions & row.ext) == row.ext && row.bytes >= bytes && row.upper_clear) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every row names an extension the isa has and a power-of-two width above the
# compute width, and no width twice
fun vector_register_rows_valid(m: *MachineModel) bool {
    if (m.vector_register_row_len == 0) { ret true; }
    if (m.vector_register_rows == nil)  { ret false; }
    var i: u32 = 0;
    for (i < m.vector_register_row_len) {
        val row: *VectorRegisterRow = ?m.vector_register_rows[i];
        if (row.ext == 0 || (row.ext & ~extension_domain(m)) != 0)                { ret false; }
        if (row.bytes <= m.vector_bits / 8 || (row.bytes & (row.bytes - 1)) != 0) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (m.vector_register_rows[j].bytes == row.bytes) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# the width in bits the packed rows over lanes of this kind and width run at
# under the selected extensions: the widest selected row's, or `vector_bits`
pub fun vector_width(m: *MachineModel, is_float: bool, lane_bits: u32) u32 {
    var bits: u32 = m.vector_bits;
    if (m.vector_width_rows == nil) { ret bits; }
    val lane: u32 = width_bit(lane_bits / 8);
    var i:    u32 = 0;
    for (i < m.vector_width_row_len) {
        val row: *VectorWidthRow = ?m.vector_width_rows[i];
        if ((m.extensions & row.ext) == row.ext && row.is_float == is_float && (row.lanes & lane) != 0 && row.bits > bits) {
            bits = row.bits;
        }
        i = i + 1;
    }
    ret bits;
}

# every row names an extension the isa has, lanes of the kind's widths, and
# a power-of-two width above `vector_bits` that a register the row's
# extensions select holds
fun vector_width_rows_valid(m: *MachineModel) bool {
    if (m.vector_width_row_len == 0) { ret true; }
    if (m.vector_width_rows == nil)  { ret false; }
    var i: u32 = 0;
    for (i < m.vector_width_row_len) {
        val row: *VectorWidthRow = ?m.vector_width_rows[i];
        if (row.ext == 0 || (row.ext & ~extension_domain(m)) != 0)         { ret false; }
        if (row.lanes == 0 || (row.lanes & ~(1 + 2 + 4 + 8)::u32) != 0)    { ret false; }
        if (row.bits <= m.vector_bits || (row.bits & (row.bits - 1)) != 0) { ret false; }
        var held: MachineModel = @m;
        held.extensions = extension.close(m.extension_table, m.extension_count, row.ext);
        if (vector_register_bytes(?held) * 8 < row.bits) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun packed_forms_valid(m: *MachineModel) bool {
    if ((m.direct_extend_ext & ~extension_domain(m)) != 0)          { ret false; }
    if (m.packed_form_len == 0)                                     { ret true; }
    if (!m.has_v128 || m.packed_forms == nil || m.vector_bits == 0) { ret false; }
    var i: u32 = 0;
    for (i < m.packed_form_len) {
        val row: *PackedForm = ?m.packed_forms[i];
        if (!packed_form_valid(row.op, row.is_float, row.lane_bits, row.from_bits)) { ret false; }
        if ((row.ext & ~extension_domain(m)) != 0)                                  { ret false; }
        var j: u32 = 0;
        for (j < i) {
            val prior: *PackedForm = ?m.packed_forms[j];
            if (prior.op == row.op && prior.is_float == row.is_float
                && prior.lane_bits == row.lane_bits && prior.from_bits == row.from_bits
                && prior.ext == row.ext) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# a packed row takes part when the selected extensions hold every bit it needs
fun packed_row_selected(m: *MachineModel, row: *PackedForm) bool {
    ret (m.extensions & row.ext) == row.ext;
}

fun scalar_forms_valid(m: *MachineModel) bool {
    if (m.scalar_form_len == 0)               { ret true; }
    if (!m.has_v128 || m.scalar_forms == nil) { ret false; }
    var i: u32 = 0;
    for (i < m.scalar_form_len) {
        val row: *ScalarForm = ?m.scalar_forms[i];
        if (!packed_form_valid(row.op, row.is_float, row.lane_bits, row.from_bits))   { ret false; }
        if (packed_width(m, row.op, row.is_float, row.lane_bits, row.from_bits) != 0) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            val prior: *ScalarForm = ?m.scalar_forms[j];
            if (prior.op == row.op && prior.is_float == row.is_float
                && prior.lane_bits == row.lane_bits && prior.from_bits == row.from_bits) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

val DOMAIN_LANE_BITS: [4]u32 = [4]u32{8, 16, 32, 64};

# the retained (operation, lane kind, lane width, operand lane width) domain:
# every cell the vocabulary admits, in one fixed order, so a table can be
# checked against it
pub fun vector_domain_len() u32 {
    var n:  u32   = 0;
    var op: VecOp = VEC_OP_ADD;
    for (op <= VEC_OP_LAST) {
        var wi: u32 = 0;
        for (wi < 4) {
            var fi: u32 = 0;
            for (fi < 4) {
                if (packed_form_valid(op, false, DOMAIN_LANE_BITS[wi], DOMAIN_LANE_BITS[fi])) { n = n + 1; }
                if (packed_form_valid(op, true, DOMAIN_LANE_BITS[wi], DOMAIN_LANE_BITS[fi]))  { n = n + 1; }
                fi = fi + 1;
            }
            wi = wi + 1;
        }
        op = op + 1;
    }
    ret n;
}

pub fun vector_domain_cell(index: u32, cell: *ScalarForm) bool {
    var n: u32   = 0;
    var o: VecOp = VEC_OP_ADD;
    for (o <= VEC_OP_LAST) {
        var wi: u32 = 0;
        for (wi < 4) {
            var fi: u32 = 0;
            for (fi < 4) {
                var f: u32 = 0;
                for (f < 2) {
                    if (packed_form_valid(o, f == 1, DOMAIN_LANE_BITS[wi], DOMAIN_LANE_BITS[fi])) {
                        if (n == index) {
                            @cell = ScalarForm{op: o, is_float: f == 1, lane_bits: DOMAIN_LANE_BITS[wi], from_bits: DOMAIN_LANE_BITS[fi]};
                            ret true;
                        }
                        n = n + 1;
                    }
                    f = f + 1;
                }
                fi = fi + 1;
            }
            wi = wi + 1;
        }
        o = o + 1;
    }
    ret false;
}

# a machine with a vector unit decides every retained cell; one without decides
# them all as the scalar expansion by declaring no unit
#[testing]
pub val CONVERT_CELL_COUNT: u32 = 72;

#[testing]
pub val WIDEN_CELL_COUNT: u32 = 33;

#[testing]
pub val SHIFT_CELL_COUNT: u32 = 24;

# the families of retained cells a model leaves to the scalar path wherever
# its packed table does not claim them: the conversions; the widening
# multiplies with their high halves, the lane interleave, the lane-halving
# extensions with their sign masks and the widening group sums; the shifts, lane by lane through the
# scalar shift, which saturates the same way; the lane ranges and joins; and
# the f16 lane arithmetic and comparisons, each lane's scalar f16 operation (#3802)
pub def ScalarFamily: u32;
pub val SCALAR_CONVERSIONS: ScalarFamily = 1;
pub val SCALAR_WIDENING:    ScalarFamily = 2;
pub val SCALAR_SHIFTS:      ScalarFamily = 4;
pub val SCALAR_PERMUTES:    ScalarFamily = 8;
pub val SCALAR_HALF_LANES:  ScalarFamily = 16;

# declare the model's scalar table: `explicit`, then every cell of `families`
# its packed table leaves, family by family, in storage from the registry's
# allocator sized to exactly those rows. the caller releases it with
# release_scalar_rows once the model is registered, which copies it
# ---
# reg:          the registry whose allocator backs the rows
# m:            the model; its packed table is final, its scalar table is set
# explicit:     the rows the model names itself
# explicit_len: how many
# families:     the families whose unclaimed cells are scalar rows
pub fun declare_scalar_rows(reg: *IsaRegistry, m: *MachineModel, explicit: *ScalarForm, explicit_len: u32, families: ScalarFamily) err[fail.Fail] {
    if (reg == nil || !reg.alloc_ready) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry backing allocator is unavailable")};
    }
    val len:   u32                         = explicit_len + scalar_family_rows(m, nil, 0, families);
    val space: res[*ScalarForm, fail.Fail] = own_space[ScalarForm](?reg.alloc, len::usize);
    if (sel space.err) { ret err[fail.Fail].err{space.err}; }
    val rows: *ScalarForm = space.ok;
    var i:    u32         = 0;
    for (i < explicit_len) {
        rows[i] = explicit[i];
        i       = i + 1;
    }
    scalar_family_rows(m, rows, explicit_len, families);
    m.scalar_forms    = rows;
    m.scalar_form_len = len;
    ret err[fail.Fail].ok{};
}

# free the table declare_scalar_rows gave the model
pub fun release_scalar_rows(reg: *IsaRegistry, m: *MachineModel) {
    if (m.scalar_forms != nil) { A.deallocate[ScalarForm](?reg.alloc, m.scalar_forms, m.scalar_form_len::usize); }
    m.scalar_forms    = nil;
    m.scalar_form_len = 0;
}

# the rows of `families` the packed table leaves, written from `at` unless
# `rows` is nil; how many
fun scalar_family_rows(m: *MachineModel, rows: *ScalarForm, at: u32, families: ScalarFamily) u32 {
    var n: u32 = 0;
    if ((families & SCALAR_CONVERSIONS) != 0) { n = n + scalar_rows_where(m, rows, at + n, is_convert_cell); }
    if ((families & SCALAR_WIDENING) != 0)    { n = n + scalar_rows_where(m, rows, at + n, is_widening_cell); }
    if ((families & SCALAR_SHIFTS) != 0)      { n = n + scalar_rows_where(m, rows, at + n, is_shift_cell); }
    if ((families & SCALAR_PERMUTES) != 0)    { n = n + scalar_rows_where(m, rows, at + n, is_permute_cell); }
    if ((families & SCALAR_HALF_LANES) != 0)  { n = n + scalar_rows_where(m, rows, at + n, is_half_lane_cell); }
    ret n;
}

fun is_convert_cell(cell: *ScalarForm) bool {
    ret is_convert_op(cell.op);
}

fun is_widening_cell(cell: *ScalarForm) bool {
    ret is_widen_op(cell.op) || is_widen_half_op(cell.op) || is_mul_high_op(cell.op) || is_interleave_op(cell.op)
        || is_widen_sum_op(cell.op) || is_sign_mask_op(cell.op);
}

fun is_shift_cell(cell: *ScalarForm) bool {
    ret is_shift_op(cell.op);
}

fun is_permute_cell(cell: *ScalarForm) bool {
    ret is_permute_op(cell.op);
}

fun is_half_lane_cell(cell: *ScalarForm) bool {
    ret cell.is_float && cell.lane_bits == 16 && cell.from_bits == 16 && !is_permute_op(cell.op) && !is_convert_op(cell.op);
}

fun scalar_rows_where(m: *MachineModel, rows: *ScalarForm, at: u32, admits: fun(*ScalarForm) bool) u32 {
    var n:   u32 = 0;
    var i:   u32 = 0;
    val len: u32 = vector_domain_len();
    for (i < len) {
        var cell: ScalarForm;
        if (!vector_domain_cell(i, ?cell)) { ret n; }
        if (admits(?cell)
            && packed_width(m, cell.op, cell.is_float, cell.lane_bits, cell.from_bits) == 0) {
            if (rows != nil) { rows[at + n] = cell; }
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

# the cells a model's rows admit once each condition is decided: ALWAYS
# holds, EXTENSION holds when the model selects every named extension, and
# DIT_MODE holds when the caller says the mode is guaranteed on
pub fun ct_mul_rows_admit(m: *MachineModel, dit_mode: bool) ct.CtMulMask {
    var mask: ct.CtMulMask = ct.mul_mask_none();
    val bad:  opt[str]     = ct_mul_forms_refusal(m);
    if (sel bad.some) { ret mask; }
    var i: u32 = 0;
    for (i < m.ct_mul_form_len) {
        val row:  *ct.CtMulForm = ?m.ct_mul_forms[i];
        var held: bool          = false;
        if (row.cond == ct.CT_MUL_ALWAYS)    { held = true; }
        if (row.cond == ct.CT_MUL_DIT_MODE)  { held = dit_mode; }
        if (row.cond == ct.CT_MUL_EXTENSION) { held = (m.extensions & row.ext) == row.ext; }
        if (held)                            { ct.mul_mask_add(?mask, ct.mul_cell(row.op, row.width, row.lanes != 0)); }
        i = i + 1;
    }
    ct_mul_admit_realized(m, ?mask);
    ret mask;
}

# the cells the target realizes rather than executes, admitted exactly when
# every cell of the realization is. a machine whose widening form is the
# three-address high multiply realizes the full product of two lanes as the low
# and the high multiply, so the widening cells follow those two; a machine with
# the fixed-pair widening multiply realizes the high multiply as the pair's
# upper register, so the high cells follow the widening one. the low half of a
# two-lane product is the schoolbook over the lanes, three low products and one
# full product, so it follows the low and the widening cells. a target with
# neither form realizes a full product by double-and-add, which is no multiply
# cell and is not admitted (#3511, rulings Q10/Q11)
fun ct_mul_admit_realized(m: *MachineModel, mask: *ct.CtMulMask) {
    val maw: u32 = max_alu_width(m);
    if (maw == 0 || maw > 8) { ret; }
    val lane: u8   = (maw * 8)::u8;
    val low:  bool = ct.mul_mask_has(@mask, ct.mul_cell(ct.CT_MUL_LOW, lane, false));
    if (m.mul_wide_form == MULW_THREE_ADDRESS && low) {
        if (ct.mul_mask_has(@mask, ct.mul_cell(ct.CT_MUL_HIGH_U, lane, false))) { ct.mul_mask_add(mask, ct.mul_cell(ct.CT_MUL_WIDE_U, lane, false)); }
        if (ct.mul_mask_has(@mask, ct.mul_cell(ct.CT_MUL_HIGH_S, lane, false))) { ct.mul_mask_add(mask, ct.mul_cell(ct.CT_MUL_WIDE_S, lane, false)); }
    }
    if (m.mul_wide_form == MULW_FIXED_PAIR) {
        if (ct.mul_mask_has(@mask, ct.mul_cell(ct.CT_MUL_WIDE_U, lane, false))) { ct.mul_mask_add(mask, ct.mul_cell(ct.CT_MUL_HIGH_U, lane, false)); }
        if (ct.mul_mask_has(@mask, ct.mul_cell(ct.CT_MUL_WIDE_S, lane, false))) { ct.mul_mask_add(mask, ct.mul_cell(ct.CT_MUL_HIGH_S, lane, false)); }
    }
    if (m.mul_wide_form == MULW_NONE)                                          { ret; }
    if (!realizes_int_width(m, maw * 2) || !ct.mul_cell_width_valid(lane * 2)) { ret; }
    if (low && ct.mul_mask_has(@mask, ct.mul_cell(ct.CT_MUL_WIDE_U, lane, false))) {
        ct.mul_mask_add(mask, ct.mul_cell(ct.CT_MUL_LOW, lane * 2, false));
    }
}

# the cells whose rows carry one condition, decided or not: what a DIT_MODE
# multiply would need before it is admitted. a realized cell (#3511) needs the
# condition when some cell of its realization does, so the set is the rows of
# the condition plus every realized cell admitted with all rows held that is
# not admitted with the condition's rows withheld
pub fun ct_mul_rows_under(m: *MachineModel, cond: ct.CtMulCond) ct.CtMulMask {
    var mask: ct.CtMulMask = ct.mul_mask_none();
    val bad:  opt[str]     = ct_mul_forms_refusal(m);
    if (sel bad.some) { ret mask; }
    var all:     ct.CtMulMask = ct.mul_mask_none();
    var without: ct.CtMulMask = ct.mul_mask_none();
    var i:       u32          = 0;
    for (i < m.ct_mul_form_len) {
        val row:  *ct.CtMulForm = ?m.ct_mul_forms[i];
        val cell: ct.CtMulCell  = ct.mul_cell(row.op, row.width, row.lanes != 0);
        ct.mul_mask_add(?all, cell);
        if (row.cond == cond) { ct.mul_mask_add(?mask, cell); }
        or                    { ct.mul_mask_add(?without, cell); }
        i = i + 1;
    }
    ct_mul_admit_realized(m, ?all);
    ct_mul_admit_realized(m, ?without);
    mask.scalar = mask.scalar | (all.scalar & ~without.scalar);
    mask.vector = mask.vector | (all.vector & ~without.vector);
    ret mask;
}

# what a selected target says about extensions: the bits it selects and the
# vocabulary that names them
pub rec ExtensionView {
    selected: u64;
    table:    *extension.Extension;
    count:    u32;
}

pub fun extension_view(m: *MachineModel) ExtensionView {
    ret ExtensionView{selected: m.extensions, table: m.extension_table, count: m.extension_count};
}

# every extension bit the model's vocabulary names
pub fun extension_domain(m: *MachineModel) u64 {
    if (m.extension_table == nil) { ret 0; }
    ret extension.domain(m.extension_table, m.extension_count);
}

# the bit the model's vocabulary gives `name[0..len]`, 0 when it names no such extension
pub fun extension_bit(m: *MachineModel, name: str, len: usize) u64 {
    if (m.extension_table == nil) { ret 0; }
    ret extension.bit_of(m.extension_table, m.extension_count, name, len);
}

# what a manifest's `extensions` entry `name[0..len]` selects: a level's
# members when the model publishes one by that spelling, else the row's bit,
# 0 when the vocabulary has neither
pub fun extension_bundle(m: *MachineModel, name: str, len: usize) u64 {
    if (m.level_table != nil) {
        val members: u64 = extension.level_of(m.level_table, m.level_count, name, len);
        if (members != 0) { ret members; }
    }
    ret extension_bit(m, name, len);
}

# the model's levels, `, `-separated in buf, empty when it publishes none
pub fun spell_levels(m: *MachineModel, buf: *u8, cap: usize) {
    if (m.level_table == nil || m.level_count == 0) {
        if (cap > 0) { buf[0] = 0; }
        ret;
    }
    extension.spell_levels(m.level_table, m.level_count, buf, cap, 0);
}

# `bits` closed over the model's vocabulary: every extension a selected one implies
pub fun extension_close(m: *MachineModel, bits: u64) u64 {
    if (m.extension_table == nil) { ret bits; }
    ret extension.close(m.extension_table, m.extension_count, bits);
}

# what `#[extensions(name)]` may mean: the selected isa's row when it has one,
# else any registered row of that name, which admits nothing here. a row only
# a target selects is never a decorator's, and `target_only` says why
pub rec DecoratorExtension {
    known:       bool;
    bit:         u64;
    target_only: str;
}

pub fun decorator_extension(reg: *IsaRegistry, selected: ExtensionView, name: str, len: usize) DecoratorExtension {
    var out: DecoratorExtension   = DecoratorExtension{known: false, bit: 0, target_only: nil};
    val own: *extension.Extension = table_row(selected.table, selected.count, name, len);
    if (own != nil) {
        out.known       = true;
        out.bit         = own.bit;
        out.target_only = own.target_only;
        ret out;
    }
    if (reg == nil || reg.count > ISA_REGISTRY_CAP) { ret out; }
    var i: u32 = 0;
    for (i < reg.count) {
        val m:   *MachineModel        = ?reg.entries[i].model;
        val row: *extension.Extension = table_row(m.extension_table, m.extension_count, name, len);
        if (row != nil) {
            if (!out.known || row.target_only == nil) { out.target_only = row.target_only; }
            out.known = true;
        }
        i = i + 1;
    }
    ret out;
}

fun table_row(table: *extension.Extension, count: u32, name: str, len: usize) *extension.Extension {
    if (table == nil) { ret nil; }
    var i: u32 = 0;
    for (i < count) {
        val row: *extension.Extension = ?table[i];
        if (str_len(row.name) == len && str_region_equals(name, 0, len, row.name)) { ret row; }
        i = i + 1;
    }
    ret nil;
}

# the model's vocabulary, `, `-separated, or `none`, NUL-terminated in buf
pub fun spell_extensions(m: *MachineModel, buf: *u8, cap: usize) {
    if (m.extension_table == nil || m.extension_count == 0) {
        extension.spell_names(?NO_EXTENSIONS[0], 1, buf, cap, 0);
        ret;
    }
    extension.spell_names(m.extension_table, m.extension_count, buf, cap, 0);
}

val NO_EXTENSIONS: [1]extension.Extension = [1]extension.Extension{extension.Extension{name: "none", bit: 0}};

# every registered vocabulary's names, each table once, `, `-separated in buf
pub fun spell_all_extensions(reg: *IsaRegistry, buf: *u8, cap: usize) {
    var off: usize = 0;
    var i:   u32   = 0;
    if (cap > 0) { buf[0] = 0; }
    for (i < reg.count) {
        val m:    *MachineModel = ?reg.entries[i].model;
        var seen: bool          = m.extension_table == nil || m.extension_count == 0;
        var j:    u32           = 0;
        for (j < i && !seen) {
            if (reg.entries[j].model.extension_table == m.extension_table) { seen = true; }
            j = j + 1;
        }
        if (!seen) {
            if (off > 0) { off = extension.spell_names(?SEPARATOR[0], 1, buf, cap, off); }
            off = extension.spell_names(m.extension_table, m.extension_count, buf, cap, off);
        }
        i = i + 1;
    }
}

val SEPARATOR: [1]extension.Extension = [1]extension.Extension{extension.Extension{name: ", ", bit: 0}};

# why a model's constant-time multiply rows are malformed; the extension
# domain is every extension bit the target model knows
pub fun ct_mul_forms_refusal(m: *MachineModel) opt[str] {
    ret ct.mul_forms_refusal(m.ct_mul_forms, m.ct_mul_form_len, extension_domain(m), m.has_mul);
}

pub fun vector_domain_complete(m: *MachineModel) bool {
    if (!m.has_v128) { ret m.packed_form_len == 0 && m.scalar_form_len == 0; }
    val n: u32 = vector_domain_len();
    var i: u32 = 0;
    for (i < n) {
        var cell: ScalarForm;
        if (!vector_domain_cell(i, ?cell))                                                             { ret false; }
        if (vector_form(m, cell.op, cell.is_float, cell.lane_bits, cell.from_bits) == FORM_UNDECLARED) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the lane kind of a cell's operand: a conversion between the kinds reads
# the other kind, and every other cell its result's
pub fun from_is_float(op: VecOp, is_float: bool) bool {
    if (op == VEC_OP_FP_TO_SI || op == VEC_OP_FP_TO_UI) { ret true; }
    if (op == VEC_OP_SI_TO_FP || op == VEC_OP_UI_TO_FP) { ret false; }
    ret is_float;
}

# a conversion's register holds its wider side, so that side sets the extent,
# and each side's lanes stay within its own kind's width
pub fun packed_width(m: *MachineModel, op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) u32 {
    if (!m.has_v128 || m.packed_forms == nil)                   { ret 0; }
    if (!packed_form_valid(op, is_float, lane_bits, from_bits)) { ret 0; }
    var i: u32 = 0;
    for (i < m.packed_form_len) {
        val row: *PackedForm = ?m.packed_forms[i];
        if (row.op == op && row.is_float == is_float && row.lane_bits == lane_bits && row.from_bits == from_bits
            && packed_row_selected(m, row)) {
            val lanes: u32 = cell_lanes(m, is_float, lane_bits, from_is_float(op, is_float), from_bits);
            if (from_bits > lane_bits) { ret lanes * from_bits; }
            ret lanes * lane_bits;
        }
        i = i + 1;
    }
    ret 0;
}

# the lanes one packed instruction over a cell carries: those of the side
# whose kind and lane leave fewer
fun cell_lanes(m: *MachineModel, is_float: bool, lane_bits: u32, from_float: bool, from_bits: u32) u32 {
    val out: u32 = packed_lane_cap(m, is_float, lane_bits);
    val src: u32 = packed_lane_cap(m, from_float, from_bits);
    if (src < out) { ret src; }
    ret out;
}

fun cell_is(row: *PackedForm, op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) bool {
    ret row.op == op && row.is_float == is_float && row.lane_bits == lane_bits && row.from_bits == from_bits;
}

# the extensions a target would add to pack this cell: what the first declared
# row of the cell needs beyond the model's selection. 0 when a selected row
# packs it already or no row declares it at any extension
pub fun packing_extension(m: *MachineModel, op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) u64 {
    if (!m.has_v128 || m.packed_forms == nil) { ret 0; }
    var missing: u64 = 0;
    var i:       u32 = 0;
    for (i < m.packed_form_len) {
        val row: *PackedForm = ?m.packed_forms[i];
        if (cell_is(row, op, is_float, lane_bits, from_bits)) {
            if (packed_row_selected(m, row)) { ret 0; }
            if (missing == 0)                { missing = row.ext & ~m.extensions; }
        }
        i = i + 1;
    }
    ret missing;
}

# whether the model selects the row of this cell gated on exactly `ext`: the
# lowering's choice between the baseline form and an extension's instruction
pub fun packed_row_selected_by(m: *MachineModel, op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32, ext: u64) bool {
    if (!m.has_v128 || m.packed_forms == nil) { ret false; }
    var i: u32 = 0;
    for (i < m.packed_form_len) {
        val row: *PackedForm = ?m.packed_forms[i];
        if (cell_is(row, op, is_float, lane_bits, from_bits) && row.ext == ext) { ret packed_row_selected(m, row); }
        i = i + 1;
    }
    ret false;
}

# a lane-wise integer extension of any ratio is one instruction under the
# selected extensions, rather than a chain of doublings
pub fun extends_directly(m: *MachineModel) bool {
    ret m.direct_extend && (m.extensions & m.direct_extend_ext) == m.direct_extend_ext;
}

# the one declared outcome for a cell: packed, the scalar expansion, or nothing
pub fun vector_form(m: *MachineModel, op: VecOp, is_float: bool, lane_bits: u32, from_bits: u32) VectorForm {
    if (!packed_form_valid(op, is_float, lane_bits, from_bits))   { ret FORM_UNDECLARED; }
    if (!m.has_v128)                                              { ret FORM_SCALAR; }
    if (packed_width(m, op, is_float, lane_bits, from_bits) != 0) { ret FORM_PACKED; }
    if (m.scalar_forms == nil)                                    { ret FORM_UNDECLARED; }
    var i: u32 = 0;
    for (i < m.scalar_form_len) {
        val row: *ScalarForm = ?m.scalar_forms[i];
        if (row.op == op && row.is_float == is_float && row.lane_bits == lane_bits && row.from_bits == from_bits) {
            ret FORM_SCALAR;
        }
        i = i + 1;
    }
    ret FORM_UNDECLARED;
}

fun packed_extent(m: *MachineModel, is_float: bool, lane_bits: u32) u32 {
    if (!m.has_v128)    { ret 0; }
    if (lane_bits == 0) { ret 0; }
    val by_width: u32 = vector_width(m, is_float, lane_bits);
    if (m.max_vector_lanes == VECTOR_LANES_UNBOUNDED) { ret by_width; }
    val by_count: u64 = m.max_vector_lanes::u64 * lane_bits::u64;
    if (by_count < by_width::u64) { ret by_count::u32; }
    ret by_width;
}

pub fun packed_lane_cap(m: *MachineModel, is_float: bool, lane_bits: u32) u32 {
    val w: u32 = packed_extent(m, is_float, lane_bits);
    if (w == 0) { ret 0; }
    ret w / lane_bits;
}

# the bytes of the register that realizes a vector of `bytes` over lanes of
# this kind whole: the narrowest register width the kind computes at that
# holds it, `vector_op_bytes` at the least. a vector wider than every such
# register is not realized in one and keeps the narrowest (#4128)
pub fun vector_op_bytes(m: *MachineModel, is_float: bool, lane_bits: u32, bytes: u32) u32 {
    var w:     u32 = m.vector_op_bytes;
    val limit: u32 = vector_width(m, is_float, lane_bits) / 8;
    if (bytes > limit) { ret w; }
    for (w != 0 && w < bytes && w * 2 <= limit) { w = w * 2; }
    ret w;
}

fun width_bit(bytes: u32) u32 {
    if (bytes == 1)  { ret 1; }
    if (bytes == 2)  { ret 2; }
    if (bytes == 4)  { ret 4; }
    if (bytes == 8)  { ret 8; }
    if (bytes == 16) { ret 16; }
    ret 0;
}

pub fun moves_unaligned_gp(m: *MachineModel, bytes: u32) bool {
    if (bytes == 0 || bytes > m.gpr_width || (bytes & (bytes - 1)) != 0) { ret false; }
    if (bytes == 1)                                                      { ret true; }
    ret (m.gp_unaligned_widths & bytes) != 0;
}

# a constant offset fits a signed field of `bits` bits; 0 bits is no bound
pub fun offset_fits(bits: u32, off: i64) bool {
    if (bits == 0 || bits >= 64) { ret true; }
    val half: i64 = 1::i64 << (bits - 1)::i64;
    ret off >= 0 - half && off < half;
}

pub fun sym_offset_folds(m: *MachineModel, off: i64) bool {
    ret offset_fits(m.sym_offset_bits, off);
}

pub fun mem_disp_folds(m: *MachineModel, off: i64) bool {
    ret offset_fits(m.mem_disp_bits, off);
}

# a vector of `bytes` moves between memory and its register in one access:
# a width the target declares, or a register width its extensions give past
# the compute width (#4128)
pub fun moves_vector_memory(m: *MachineModel, bytes: u32) bool {
    if (bytes > m.vector_bits / 8 && bytes <= vector_register_bytes(m) && (bytes & (bytes - 1)) == 0) { ret true; }
    val b: u32 = width_bit(bytes);
    if (b == 0) { ret false; }
    ret (m.vec_mem_widths & b) != 0;
}

pub fun reads_slot_operand(m: *MachineModel, bytes: u32) bool {
    ret (m.slot_read_widths & width_bit(bytes)) != 0;
}

pub fun models_lifetime_holes(m: *MachineModel) bool {
    ret m.lifetime_holes;
}

pub fun shift_count_mod_width(m: *MachineModel, bytes: u32) bool {
    val b: u32 = width_bit(bytes);
    if (b == 0) { ret false; }
    ret (m.shift_count_mod_widths & b) != 0;
}

pub fun moves_cross_bank(m: *MachineModel, bytes: u32) bool {
    val b: u32 = width_bit(bytes);
    if (b == 0) { ret false; }
    ret (m.xbank_widths & b) != 0;
}

# declares the alu widths `widths` (encoded like int_widths), each one legal
# under every extension set, in place of any declared before
pub fun declare_alu_widths(m: *MachineModel, widths: u32) {
    m.alu_width_len = 0;
    var b: u32 = 1;
    for (b <= 16) {
        if ((widths & b) != 0) { gate_alu_width(m, b, 0); }
        b = b << 1;
    }
}

# declares the alu width `bytes`, legal only while the model holds `ext`
pub fun gate_alu_width(m: *MachineModel, bytes: u32, ext: u64) {
    if (m.alu_width_len >= ALU_WIDTH_CAP) { ret; }
    m.alu_widths[m.alu_width_len] = AluWidth{bytes: bytes, ext: ext};
    m.alu_width_len               = m.alu_width_len + 1;
}

# the alu widths legal under the model's extensions, encoded like int_widths
pub fun alu_width_set(m: *MachineModel) u32 {
    var set: u32 = 0;
    var i:   u32 = 0;
    for (i < m.alu_width_len && i < ALU_WIDTH_CAP) {
        val row: *AluWidth = ?m.alu_widths[i];
        if ((row.ext & ~m.extensions) == 0) { set = set | width_bit(row.bytes); }
        i = i + 1;
    }
    ret set;
}

# the narrowest legal alu width, 0 for a model that declares none
pub fun alu_min_width(m: *MachineModel) u32 {
    val set: u32 = alu_width_set(m);
    var b:   u32 = 1;
    for (b <= 16) {
        if ((set & b) != 0) { ret b; }
        b = b << 1;
    }
    ret 0;
}

# the widest legal alu width, above which legalize splits an operation into
# lanes; 0 for a model that declares none
pub fun max_alu_width(m: *MachineModel) u32 {
    val set: u32 = alu_width_set(m);
    var b:   u32 = 16;
    for (b != 0) {
        if ((set & b) != 0) { ret b; }
        b = b >> 1;
    }
    ret 0;
}

# the alu widths legal under every extension set, encoded like int_widths
pub fun alu_width_floor_set(m: *MachineModel) u32 {
    var set: u32 = 0;
    var i:   u32 = 0;
    for (i < m.alu_width_len && i < ALU_WIDTH_CAP) {
        if (m.alu_widths[i].ext == 0) { set = set | width_bit(m.alu_widths[i].bytes); }
        i = i + 1;
    }
    ret set;
}

# the width an integer operation of `w` bytes computes at: w itself when it is
# legal, otherwise the narrowest width above it that is legal whatever the
# extensions, so a lift never needs a capability the program did not spell; w
# again when none is (legalize splits it)
pub fun clamp_alu_width(m: *MachineModel, w: u8) u8 {
    if ((alu_width_set(m) & width_bit(w::u32)) != 0) { ret w; }
    val floor: u32 = alu_width_floor_set(m);
    var b:     u32 = 1;
    for (b <= 16) {
        if ((floor & b) != 0 && b > w::u32) { ret b::u8; }
        b = b << 1;
    }
    ret w;
}

# the only reader of int_widths: whether the target realizes a scalar integer
# of this many bytes
pub fun realizes_int_width(m: *MachineModel, bytes: u32) bool {
    val b: u32 = width_bit(bytes);
    if (b == 0) { ret false; }
    ret (m.int_widths & b) != 0;
}

pub fun fits_vector_register(m: *MachineModel, is_float: bool, lane_bits: u32, lanes: u32) bool {
    val w: u32 = packed_extent(m, is_float, lane_bits);
    if (w == 0 || lanes == 0) { ret false; }
    ret lanes <= w / lane_bits;
}

pub def AsmClobbersFn: fun(str, *u32, *u32);

pub def AsmReturnsFn: fun(str) bool;

# whether an asm body may write the stack pointer; true for a body it cannot parse
pub def AsmWritesSpFn: fun(str) bool;

# the constant-time scan of an asm body: the tracked bindings (`ct.AsmSecret`, by the name
# their `{name}` operand spells), the target's multiply admission and shift trust
pub def AsmCtScanFn: fun(str, *ct.AsmSecret, u32, ct.CtMulMask, bool, *A.Allocator) err[ct.AsmRefusal];

pub def IsRegMoveFn: fun(u32) bool;

pub def IsTrapTerminatorFn: fun(u32) bool;
# whether one instruction materializes the integer `value`, read at `bits`
# (at most 64): the rule the middle end hoists a loop's constants by (#3807)
pub def IntImmFitsFn: fun(u64, u32) bool;
# whether the selected instruction reads operand `index` as a constant in
# place, as a constant-pool memory operand, at no instruction of its own: the
# rule the allocator folds a rebuilt constant into its reader by (#4184)
pub def ReadsConstFn: fun(*mir.MirInstr, u32) bool;

pub def DwarfRegFn: arch.DwarfRegFn;

pub def CvRegFn: arch.CvRegFn;

pub def RegFileFn: fun(*Register) i32;

pub def FrameDistFn: fun(*MachineModel, *mir.MirFunction, *u32, *u32);

pub rec BackendIdentity {
    arch_id:     u32;
    os_id:       u32;
    abi_id:      u32;
    of_id:       u32;
    debug_id:    u32;
    arch_name:   str;
    os_name:     str;
    abi_name:    str;
    of_name:     str;
    env_id:      u32;
    env_profile: u32;
    env_name:    str;
}

pub rec BackendAbi {
    gp_arg_regs:                RegFileFn;
    callee_saved:               RegFileFn;
    indirect_result_reg:        i32;
    indirect_result_in_argfile: bool;
    consumes_agg_layout:        bool;
    fp_callee_saved_bytes:      u32;
    float_arg_bits:             u32;
    arg_slot_granularity:       u32;
    variadic_args_on_stack:     bool;
    fixed_args_natural_size:    bool;
    reg_arg_align:              u32;
    reg_arg_extend:             u32;
    agg_arg_natural_align:      bool;
    va_list_size:               u32;
    va_list_align:              u32;
}

pub rec BackendOs {
    entry_symbol:     str;
    c_symbol_prefix:  str;
    image_base:       u64;
    page_size:        u64;
    stack_probe:      bool;
    mapped_by_loader: bool;
    stack_reserve:    u64;
    stack_commit:     u64;
}

pub rec BackendTarget {
    identity: BackendIdentity;
    model:    MachineModel;
    abi:      BackendAbi;
    os:       BackendOs;
    # the admitted constant-time multiply cells, from target.resolved.ct_mul_admitted
    ct_mul: ct.CtMulMask;
    # the instruction and type table the target registered, nil on one with none
    defs: *TargetDefs;
}

pub def SelectFn: fun(*A.Allocator, *BackendTarget, *mir.MirFunction) err[fail.Fail];

pub def EncodeFn: fun(*A.Allocator, *BackendTarget, *mir.MirModule) res[encoding.EncoderOutput, fail.Fail];

pub def EmitAsmFn: fun(*A.Allocator, *BackendTarget, *mir.MirModule,
    *writer.Writer) res[encoding.EncoderOutput, fail.Fail];

# a whole-module emitter fills the object image codegen initialized: its sections,
# symbols and relocations, in the same neutral kinds a native image carries, with
# section bytes allocated from the image's allocator. names are the emitter's own
pub def EmitModuleFn: fun(*A.Allocator, *BackendTarget, *unit_input.Unit, *debug_input.ModuleDebug, *of.ObjectImage) err[fail.Fail];

pub rec AssemblyCapabilities {
    emit:      EmitAsmFn;
    clobbers:  AsmClobbersFn;
    returns:   AsmReturnsFn;
    ct_scan:   AsmCtScanFn;
    writes_sp: AsmWritesSpFn;
}

pub rec RegMachine {
    select:               SelectFn;
    encode:               EncodeFn;
    is_reg_move:          IsRegMoveFn;
    is_trap_terminator:   IsTrapTerminatorFn;
    reserved_regs:        *Register;
    reserved_reg_count:   i32;
    reload_scratch_regs:  *Register;
    reload_scratch_count: i32;
    scratch_reg:          i32;
    scratch_reg2:         i32;
    frame_ptr_reg:        i32;
    stack_ptr_reg:        i32;
    incoming_arg_base:    i64;
    div_reg:              i32;
    div_hi_reg:           i32;
    shift_count_reg:      i32;

    has_assembly: bool;
    assembly:     AssemblyCapabilities;
    dwarf_reg:    DwarfRegFn;
    cv_reg:       CvRegFn;
    frame_dist:   FrameDistFn;
    # nil on an instruction set whose constants the middle end leaves in place
    int_imm_fits: IntImmFitsFn;
    # nil on an instruction set whose every reader of a rebuilt constant takes
    # it in a register
    reads_const: ReadsConstFn;
}

pub rec ModuleEmitter {
    emit_module: EmitModuleFn;
    # whether `asm` blocks reach the emitter; without it they are refused in source
    has_assembly: bool;
}

pub def RelocSeam: of.RelocationCapabilities;

# how one operand of an `#[op]` instruction is written: an ordinary value id, an
# id that must be an integer constant by emission, a literal word inline, a
# pointer whose storage class the call site's access chain decides, which the
# instruction only reads through, only stores through, or reads and writes, a
# handle value whose memory the instruction reads or writes (a handle passed as
# an ordinary value names its descriptor and touches none of its memory), or a
# truth value the target writes as its boolean type, from an integer argument
# whose nonzero is true. a memory scope or a memory semantics operand is a
# constant id too, one the target reads by value and holds to what that value
# needs under its memory model
pub def OpOperandKind: u8;

pub val OP_OPERAND_VALUE:          OpOperandKind = 0;
pub val OP_OPERAND_CONSTANT:       OpOperandKind = 1;
pub val OP_OPERAND_LITERAL:        OpOperandKind = 2;
pub val OP_OPERAND_POINTER_READ:   OpOperandKind = 3;
pub val OP_OPERAND_POINTER_WRITE:  OpOperandKind = 4;
pub val OP_OPERAND_POINTER_UPDATE: OpOperandKind = 5;
pub val OP_OPERAND_HANDLE_READ:    OpOperandKind = 6;
pub val OP_OPERAND_HANDLE_WRITE:   OpOperandKind = 7;
pub val OP_OPERAND_BOOL:           OpOperandKind = 8;
pub val OP_OPERAND_SCOPE:          OpOperandKind = 9;
pub val OP_OPERAND_SEMANTICS:      OpOperandKind = 10;
pub val OP_OPERAND_KIND_COUNT:     OpOperandKind = 11;

# whether an `#[op]` instruction has a result id, and whether that result is a
# pointer into the space the row declares, or a truth value of the target's boolean
# type, which the declaration's integer return type receives as 1 or 0
pub def OpResult: u8;

pub val OP_RESULT_VALUE:   OpResult = 0;
pub val OP_RESULT_NONE:    OpResult = 1;
pub val OP_RESULT_POINTER: OpResult = 2;
pub val OP_RESULT_BOOL:    OpResult = 3;

pub val OP_MAX_OPERANDS: u32 = 16;

pub val NO_OP_SPACE: u32 = 0xFFFFFFFF;

pub val NO_OP_CAPABILITY: u32 = 0xFFFFFFFF;

# one value a literal operand may take and what that value brings: the target's
# own capability word it needs (NO_OP_CAPABILITY for none), the extensions of the
# isa's vocabulary that capability needs selected, and the operands it adds to the end
# of the instruction, one letter each as `op_def_shaped` spells them (`""` for none).
# what a value brings is never a pointer or a handle: a row's memory effects are known
# before a call's literal is
pub rec OpEnumerant {
    value:      u32;
    name:       str;
    capability: u32;
    requires:   u64;
    operands:   str;
}

# the closed set of values a literal operand takes. a value enumeration admits
# exactly one of its values. a mask admits any union of its single-bit values,
# each set bit bringing its own requirement and operands, which follow in
# ascending bit order, and 0 is the empty mask
pub rec OpEnum {
    name:   str;
    values: *OpEnumerant;
    count:  u32;
    mask:   bool;
}

# the class of the data type a typed row operates on: an integer, a float, or anything
# else (a vector, an aggregate, a handle), which no requirement admits
pub def OpDataClass: u8;

pub val OP_DATA_INT:   OpDataClass = 0;
pub val OP_DATA_FLOAT: OpDataClass = 1;
pub val OP_DATA_OTHER: OpDataClass = 2;

# one data type a typed row admits in one of the target's address spaces (NO_OP_SPACE
# for every space), and what a use of it there needs: the target's capability word
# (NO_OP_CAPABILITY for none) and the extensions of the isa's vocabulary. `refused`,
# when not nil, is why the target cannot emit the type yet, and the declaration is
# refused with it
pub rec OpTypeRequirement {
    class:      OpDataClass;
    bits:       u32;
    space:      u32;
    capability: u32;
    requires:   u64;
    refused:    str;
}

# the data types a row operates on, read from its operand `operand` (a pointer's
# pointee), and what each needs in each address space. a type no requirement admits in
# any space is refused at the declaration, and one admitted only in other spaces at the
# call. a typing with no requirements admits every type and needs nothing: it only names
# the operand the row's relations are stated against. static data the target owns for
# the life of the program, like an OpEnum
pub rec OpTyping {
    name:    str;
    operand: u32;
    entries: *OpTypeRequirement;
    count:   u32;
}

# how an operand's or the result's type relates to the row's data type, the type of its
# typing's operand (a pointer operand's pointee): unrelated, that same type, a texel, a
# scalar or vector whose component is the sampled type of the handle the typing's operand
# is, with as many components as the row's texel count states, or, for a pointer result
# only, a pointer to that sampled type, into the memory of the handle the typing's pointer
# operand addresses
pub def OpRelation: u8;

pub val OP_RELATION_NONE:    OpRelation = 0;
pub val OP_RELATION_DATA:    OpRelation = 1;
pub val OP_RELATION_TEXEL:   OpRelation = 2;
pub val OP_RELATION_POINTEE: OpRelation = 3;
pub val OP_RELATION_COUNT:   OpRelation = 4;

# how a row's texel count is stated: exactly a number of components, or at least as many
# as the handle's format stores, any number when its format is unknown
pub def OpCountKind: u8;

pub val OP_COUNT_EXACT:      OpCountKind = 0;
pub val OP_COUNT_FORMAT:     OpCountKind = 1;
pub val OP_COUNT_KIND_COUNT: OpCountKind = 2;

# the number of components a row's texel has, a scalar being one: `components` exactly,
# or as `kind` says. `rule` names the rule a refusal cites. static data the target owns
# for the life of the program, like an OpTyping
pub rec OpTexelCount {
    rule:       str;
    kind:       OpCountKind;
    components: u32;
}

# a scalar data type by class, width and signedness, such as a handle's sampled type
pub rec OpScalar {
    class:  OpDataClass;
    bits:   u32;
    signed: bool;
}

pub rec OpDef {
    set:     str;
    name:    str;
    set_tag: u32;
    opcode:  u32;
    # the most operands a call passes: the ones the row spells, then the most its
    # enumerated literals' values bring
    arity: u32;
    # the fewest: an enumerated literal that leads the tail is optional, absent with
    # every operand its value would bring
    min_arity: u32;
    # the operands the row spells itself. past them are the operands a call's literal
    # values bring, typed by the enumerant that brings each
    spelled: u32;
    result:  OpResult;
    # the target's own address-space word a pointer result points into, else NO_OP_SPACE
    result_space: u32;
    kinds:        [OP_MAX_OPERANDS]OpOperandKind;
    # the target's own capability word every use of the row needs, else NO_OP_CAPABILITY
    capability: u32;
    # the extensions of the isa's vocabulary every use of the row needs selected
    requires: u64;
    # the enumeration each literal operand's value must belong to, nil when any word is accepted.
    # static data the target owns for the life of the program, so the registry keeps the pointer
    enums: [OP_MAX_OPERANDS]*OpEnum;
    # what the data type the row operates on needs, nil when the row is not typed
    typing: *OpTyping;
    # how each operand's type and the result's relate to the data type, against the
    # operand the typing names
    relations:       [OP_MAX_OPERANDS]OpRelation;
    result_relation: OpRelation;
    # how many components the texel an operand or the result relates as has, nil when
    # the row relates no texel
    texel_count: *OpTexelCount;
}

pub val TYPE_OPERAND_WORD: u32 = 0xFFFFFFFF;

pub val NO_TYPE_CTOR: u32 = 0xFFFFFFFF;

pub def TypeRefuseFn: fun(*u32, u32) str;

# the descriptor role a handle binds through, from its operands
pub def TypeBindFn: fun(*u32, u32) u32;

# why a composing constructor refuses the handle named as its operand `index`, from
# that handle's own operands, nil when it composes over it
pub def TypeComposeFn: fun(u32, *u32, u32) str;

# the scalar a handle's texels are read and written as, from its operands, class
# OP_DATA_OTHER when it has none
pub def TypeSampledFn: fun(*u32, u32) OpScalar;

# the number of components a handle's format stores each texel in, from its operands, 0
# when its format is unknown
pub def TypeComponentsFn: fun(*u32, u32) u32;

# a constructor whose handles state their own texels, or have none
pub val NO_TEXEL_OPERAND: u32 = 0xFFFFFFFF;

# why no instruction may derive a pointer into a handle's memory, from its operands, nil
# when one may
pub def TypeAddressFn: fun(*u32, u32) str;

# a handle bound as a sampled descriptor, `#[sampler(set, binding)]`
pub val HANDLE_BIND_SAMPLER: u32 = 0;
# a handle bound as a storage descriptor, `#[storage(set, binding, ...)]`
pub val HANDLE_BIND_STORAGE: u32 = 1;

pub rec TypeDef {
    name:     str;
    tag:      u32;
    operands: *u32;
    arity:    u32;
    refuse:   TypeRefuseFn;
    # nil binds every handle of the constructor as a sampler
    bind: TypeBindFn;
    # nil composes over any handle of the constructor the operand names
    compose: TypeComposeFn;
    # nil when the constructor's handles have no texels
    sampled: TypeSampledFn;
    # nil when the constructor's handles have no format
    components: TypeComponentsFn;
    # the type operand naming the handle whose texels these handles have, as a sampled
    # image has its image's, else NO_TEXEL_OPERAND
    texels_of: u32;
    # nil when no instruction addresses the constructor's memory
    address: TypeAddressFn;
}

pub rec TargetDefs {
    ops:        *OpDef;
    op_count:   u32;
    types:      *TypeDef;
    type_count: u32;
}

pub val NO_OP_SET: u32 = definition.NO_OP_SET;

# a row whose every operand is a value and whose result is a value
pub fun op_def(set: str, name: str, set_tag: u32, opcode: u32, arity: u32) OpDef {
    var d: OpDef;
    d.set             = set;
    d.name            = name;
    d.set_tag         = set_tag;
    d.opcode          = opcode;
    d.arity           = arity;
    d.min_arity       = arity;
    d.spelled         = arity;
    d.result          = OP_RESULT_VALUE;
    d.result_space    = NO_OP_SPACE;
    d.capability      = NO_OP_CAPABILITY;
    d.requires        = 0;
    d.typing          = nil;
    d.result_relation = OP_RELATION_NONE;
    d.texel_count     = nil;
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        d.kinds[i]     = OP_OPERAND_VALUE;
        d.enums[i]     = nil;
        d.relations[i] = OP_RELATION_NONE;
        i              = i + 1;
    }
    ret d;
}

# a row spelled by its operand signature, one letter per operand in order: `v` a
# value, `c` a constant id, `l` a literal word, `r` a pointer only read through, `w`
# a pointer only stored through, `u` a pointer read and written (read-modify-write),
# `i` a handle whose memory is read, `o` a handle whose memory is written, `b` a
# truth value, `s` a memory scope and `m` a memory semantics, each a constant id.
# a row spells only its own operands: the ones an enumerated literal's value brings
# follow them, typed by the enumerant (`op_enumerated`). a `|` makes the literal after
# it optional (`"iv|l"`), a call passing it or leaving it out with every operand its
# value would bring, and nothing else follows it.
# a letter outside the set is an invalid kind, which registration refuses
pub fun op_def_shaped(set: str, name: str, set_tag: u32, opcode: u32,
    result: OpResult, result_space: u32, signature: str) OpDef {
    val n: usize = str_len(signature);
    var d: OpDef = op_def(set, name, set_tag, opcode, 0);
    d.result       = result;
    d.result_space = result_space;
    var tail: bool  = false;
    var k:    u32   = 0;
    var i:    usize = 0;
    for (i < n) {
        if (signature[i] == '|' && !tail) {
            tail        = true;
            d.min_arity = k;
        }
        or {
            if (k < OP_MAX_OPERANDS) { d.kinds[k] = op_kind_of_letter(signature[i]); }
            k = k + 1;
        }
        i = i + 1;
    }
    d.arity   = k;
    d.spelled = k;
    if (!tail) { d.min_arity = k; }
    ret d;
}

# `d` needing the target's capability word `capability` and the extensions `requires` on every use
pub fun op_requiring(d: OpDef, capability: u32, requires: u64) OpDef {
    var out: OpDef = d;
    out.capability = capability;
    out.requires   = requires;
    ret out;
}

# `d` with its literal operand `operand` held to the values of `e`, and room after the
# operands it spells for the most every enumerated literal's value brings
pub fun op_enumerated(d: OpDef, operand: u32, e: *OpEnum) OpDef {
    var out: OpDef = d;
    if (operand < OP_MAX_OPERANDS) { out.enums[operand] = e; }
    out.arity = out.spelled;
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        if (out.enums[i] != nil) { out.arity = out.arity + op_enum_most_brought(out.enums[i]); }
        i = i + 1;
    }
    ret out;
}

# `d` operating on the data types `t` admits, each with its own requirement
pub fun op_typed(d: OpDef, t: *OpTyping) OpDef {
    var out: OpDef = d;
    out.typing = t;
    ret out;
}

# `d` with its result's type related to its data type by `result`, and each operand's by
# one letter of `operands` in order: `-` unrelated, `=` the data type itself, `t` a texel
# of the handle the typing's operand is. a letter outside the set is an invalid relation,
# which registration refuses
pub fun op_related(d: OpDef, result: OpRelation, operands: str) OpDef {
    var out: OpDef = d;
    out.result_relation = result;
    val n: usize = str_len(operands);
    var i: usize = 0;
    for (i < n && i < OP_MAX_OPERANDS::usize) {
        out.relations[i] = op_relation_of_letter(operands[i]);
        i                = i + 1;
    }
    ret out;
}

fun op_relation_of_letter(c: char) OpRelation {
    if (c == '-') { ret OP_RELATION_NONE; }
    if (c == '=') { ret OP_RELATION_DATA; }
    if (c == 't') { ret OP_RELATION_TEXEL; }
    if (c == 'p') { ret OP_RELATION_POINTEE; }
    ret OP_RELATION_COUNT;
}

# `d` with the texel it relates holding `count` components
pub fun op_texel_counted(d: OpDef, count: *OpTexelCount) OpDef {
    var out: OpDef = d;
    out.texel_count = count;
    ret out;
}

# whether `n` components meet `count`, against a handle whose format stores `stored`, 0
# when its format is unknown
pub fun op_texel_count_admits(count: *OpTexelCount, n: u32, stored: u32) bool {
    if (count.kind == OP_COUNT_EXACT) { ret n == count.components; }
    ret n >= stored;
}

pub fun op_operand_relation(d: *OpDef, i: u32) OpRelation {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret OP_RELATION_NONE; }
    ret d.relations[i];
}

# whether `t` holds the row's data type to requirements, rather than only naming its operand
pub fun op_typing_constrains(t: *OpTyping) bool {
    ret t != nil && t.count > 0;
}

# the requirement of `t` admitting a `class` of `bits` in `space`, nil when none does.
# `space` NO_OP_SPACE asks whether any space admits the type
pub fun op_type_requirement(t: *OpTyping, class: OpDataClass, bits: u32, space: u32) *OpTypeRequirement {
    if (t == nil || class == OP_DATA_OTHER) { ret nil; }
    var i: u32 = 0;
    for (i < t.count) {
        val r: *OpTypeRequirement = ?t.entries[i];
        if (r.class == class && r.bits == bits
            && (space == NO_OP_SPACE || r.space == NO_OP_SPACE || r.space == space)) { ret r; }
        i = i + 1;
    }
    ret nil;
}

pub fun op_operand_enum(d: *OpDef, i: u32) *OpEnum {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret nil; }
    ret d.enums[i];
}

# the enumeration of the optional literal that leads `d`'s tail, nil when the tail has none
pub fun op_tail_literal(d: *OpDef) *OpEnum {
    if (d == nil || d.min_arity >= d.arity) { ret nil; }
    ret op_operand_enum(d, d.min_arity);
}

# how many operands the enumerant `v` brings
pub fun op_enumerant_brings(v: *OpEnumerant) u32 {
    if (v == nil || v.operands == nil) { ret 0; }
    ret str_len(v.operands)::u32;
}

# the kind of the `k`th operand the enumerant `v` brings
pub fun op_enumerant_kind(v: *OpEnumerant, k: u32) OpOperandKind {
    if (k >= op_enumerant_brings(v)) { ret OP_OPERAND_KIND_COUNT; }
    ret op_kind_of_letter(v.operands[k::usize]);
}

# the most operands a value of `e` brings: a value's own, or every bit of a mask at once
fun op_enum_most_brought(e: *OpEnum) u32 {
    if (e == nil || e.values == nil) { ret 0; }
    var most: u32 = 0;
    var k:    u32 = 0;
    for (k < e.count) {
        val n: u32 = op_enumerant_brings(?e.values[k]);
        if (e.mask)   { most = most + n; }
        or (n > most) { most = n; }
        k = k + 1;
    }
    ret most;
}

# the enumerant of `e` whose value is exactly `value`, nil when none is
pub fun op_enumerant_of(e: *OpEnum, value: u32) *OpEnumerant {
    var i: u32 = 0;
    for (i < e.count) {
        if (e.values[i].value == value) { ret ?e.values[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `value` is a value of `e`: one of its values, or for a mask a union of its
# bits. `out_trailing` receives the tail operands the value brings
pub fun op_enum_admits(e: *OpEnum, value: u32, out_trailing: *u32) bool {
    @out_trailing = 0;
    if (!e.mask) {
        val one: *OpEnumerant = op_enumerant_of(e, value);
        if (one == nil) { ret false; }
        @out_trailing = op_enumerant_brings(one);
        ret true;
    }
    var trailing: u32 = 0;
    var bit:      u32 = 1;
    var rest:     u32 = value;
    for (rest != 0) {
        if ((rest & bit) != 0) {
            val one: *OpEnumerant = op_enumerant_of(e, bit);
            if (one == nil) { ret false; }
            trailing = trailing + op_enumerant_brings(one);
            rest     = rest & ~bit;
        }
        bit = bit << 1;
    }
    @out_trailing = trailing;
    ret true;
}

pub val NO_OPERAND: u32 = 0xFFFFFFFF;

# how many of a call's leading operands are enumerated-literal positions it passes: the
# required operands, and the literal leading the tail when the call passes more than them
pub fun op_literal_span(d: *OpDef, argc: u32) u32 {
    if (op_tail_literal(d) != nil && argc > d.min_arity) { ret d.min_arity + 1; }
    ret d.min_arity;
}

# the operand count a call of `d` takes with the literal words `words` it passes:
# the operands before its tail, the literal leading the tail when the call passes one,
# and every operand an enumerated value brings. `out_bad` receives the first
# enumerated operand whose word is no value of its enumeration, else NO_OPERAND
pub fun op_call_arity(d: *OpDef, argc: u32, words: *u32, out_bad: *u32) u32 {
    @out_bad = NO_OPERAND;
    val span:  u32 = op_literal_span(d, argc);
    var count: u32 = span;
    var i:     u32 = 0;
    for (i < span) {
        val e: *OpEnum = op_operand_enum(d, i);
        if (e != nil) {
            var brings: u32 = 0;
            if (!op_enum_admits(e, words[i], ?brings)) {
                @out_bad = i;
                ret count;
            }
            count = count + brings;
        }
        i = i + 1;
    }
    ret count;
}

# the kind of each operand of a call of `d` passing `argc` operands with the literal
# words `words`, into `out` (OP_MAX_OPERANDS long): the operands the row spells by the
# row, then each operand a literal's value brings by the enumerant that brings it, in
# the order of the literals and of each mask's bits. a call `op_call_arity` refuses
# has the kinds of the operands it does take, and the rest are values
pub fun op_call_kinds(d: *OpDef, argc: u32, words: *u32, out: *OpOperandKind) {
    val span: u32 = op_literal_span(d, argc);
    var i:    u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        out[i] = OP_OPERAND_VALUE;
        if (i < span) { out[i] = d.kinds[i]; }
        i = i + 1;
    }
    var at: u32 = span;
    i = 0;
    for (i < span) {
        val e: *OpEnum = op_operand_enum(d, i);
        if (e != nil) {
            if (!e.mask) { at = op_place_kinds(op_enumerant_of(e, words[i]), at, out); }
            or {
                var bit: u32 = 1;
                for (bit != 0 && bit <= words[i]) {
                    if ((words[i] & bit) != 0) { at = op_place_kinds(op_enumerant_of(e, bit), at, out); }
                    bit = bit << 1;
                }
            }
        }
        i = i + 1;
    }
}

# the kinds of the operands `v` brings into `out` from `at`, and where the next begin
fun op_place_kinds(v: *OpEnumerant, at: u32, out: *OpOperandKind) u32 {
    val n:    u32 = op_enumerant_brings(v);
    var next: u32 = at;
    var k:    u32 = 0;
    for (k < n) {
        if (next < OP_MAX_OPERANDS) { out[next] = op_enumerant_kind(v, k); }
        next = next + 1;
        k    = k + 1;
    }
    ret next;
}

fun op_kind_of_letter(c: char) OpOperandKind {
    if (c == 'v') { ret OP_OPERAND_VALUE; }
    if (c == 'c') { ret OP_OPERAND_CONSTANT; }
    if (c == 'l') { ret OP_OPERAND_LITERAL; }
    if (c == 'r') { ret OP_OPERAND_POINTER_READ; }
    if (c == 'w') { ret OP_OPERAND_POINTER_WRITE; }
    if (c == 'u') { ret OP_OPERAND_POINTER_UPDATE; }
    if (c == 'i') { ret OP_OPERAND_HANDLE_READ; }
    if (c == 'o') { ret OP_OPERAND_HANDLE_WRITE; }
    if (c == 'b') { ret OP_OPERAND_BOOL; }
    if (c == 's') { ret OP_OPERAND_SCOPE; }
    if (c == 'm') { ret OP_OPERAND_SEMANTICS; }
    ret OP_OPERAND_KIND_COUNT;
}

# the kind of operand `i` as the row spells it. an operand a literal's value brings is
# typed by its enumerant (`op_call_kinds`), and is never a pointer or a handle, so it
# reads here as a value
pub fun op_operand_kind(d: *OpDef, i: u32) OpOperandKind {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret OP_OPERAND_VALUE; }
    ret d.kinds[i];
}

pub fun op_kind_is_pointer(k: OpOperandKind) bool {
    ret k == OP_OPERAND_POINTER_READ || k == OP_OPERAND_POINTER_WRITE || k == OP_OPERAND_POINTER_UPDATE;
}

# an id that must be an integer constant by emission, whatever the target reads its value as
pub fun op_kind_is_constant(k: OpOperandKind) bool {
    ret k == OP_OPERAND_CONSTANT || k == OP_OPERAND_SCOPE || k == OP_OPERAND_SEMANTICS;
}

pub fun op_kind_is_handle(k: OpOperandKind) bool {
    ret k == OP_OPERAND_HANDLE_READ || k == OP_OPERAND_HANDLE_WRITE;
}

# the reason a row's shape is malformed, nil when it is well formed
pub fun op_def_shape_refusal(d: *OpDef) str {
    if (d.arity > OP_MAX_OPERANDS) { ret "mach.lang.target.isa: operation definition declares more operands than a row carries"; }
    if (d.result != OP_RESULT_VALUE && d.result != OP_RESULT_NONE && d.result != OP_RESULT_POINTER
        && d.result != OP_RESULT_BOOL) {
        ret "mach.lang.target.isa: operation definition declares an unknown result shape";
    }
    if ((d.result == OP_RESULT_POINTER) != (d.result_space != NO_OP_SPACE)) {
        ret "mach.lang.target.isa: operation definition declares a pointer result without its space, or a space without a pointer result";
    }
    if (d.min_arity > d.arity) { ret "mach.lang.target.isa: operation definition admits fewer operands than it requires"; }
    if (d.typing != nil) {
        if (d.typing.operand >= d.min_arity)                    { ret "mach.lang.target.isa: operation definition reads its data type from an operand it does not always take"; }
        if ((d.typing.count == 0) != (d.typing.entries == nil)) { ret "mach.lang.target.isa: operation definition names a typing whose count and data types disagree"; }
    }
    val why: str = op_relation_refusal(d);
    if (why != nil)                                     { ret why; }
    if (d.spelled > d.arity || d.min_arity > d.spelled) { ret "mach.lang.target.isa: operation definition spells more operands than it admits"; }
    val leads:      bool = op_tail_literal(d) != nil;
    var enumerated: u32  = 0;
    var brought:    u32  = 0;
    var i:          u32  = 0;
    for (i < OP_MAX_OPERANDS) {
        if (i < d.spelled && d.kinds[i] >= OP_OPERAND_KIND_COUNT) { ret "mach.lang.target.isa: operation definition declares an unknown operand kind"; }
        val e: *OpEnum = d.enums[i];
        if (e != nil) {
            if (i >= d.spelled)                   { ret "mach.lang.target.isa: operation definition enumerates an operand it does not spell"; }
            if (d.kinds[i] != OP_OPERAND_LITERAL) { ret "mach.lang.target.isa: operation definition enumerates an operand that is not a literal"; }
            if (e.count == 0 || e.values == nil)  { ret "mach.lang.target.isa: operation definition names an enumeration with no values"; }
            var k: u32 = 0;
            for (k < e.count) {
                val v: *OpEnumerant = ?e.values[k];
                if (e.mask && (v.value == 0 || (v.value & (v.value - 1)) != 0)) {
                    ret "mach.lang.target.isa: a mask enumeration names a value that is not a single bit";
                }
                var o: u32 = 0;
                for (o < op_enumerant_brings(v)) {
                    val kind: OpOperandKind = op_enumerant_kind(v, o);
                    if (kind >= OP_OPERAND_KIND_COUNT) { ret "mach.lang.target.isa: an enumerant brings an operand of an unknown kind"; }
                    if (op_kind_is_pointer(kind) || op_kind_is_handle(kind)) {
                        ret "mach.lang.target.isa: an enumerant brings a pointer or a handle: a row's memory effects are read from the operands it spells, before a call's literal is known";
                    }
                    o = o + 1;
                }
                k = k + 1;
            }
            brought    = brought + op_enum_most_brought(e);
            enumerated = enumerated + 1;
        }
        i = i + 1;
    }
    # the instruction holds what the row spells and every operand its literals bring at once
    if (d.spelled + brought > OP_MAX_OPERANDS || d.arity != d.spelled + brought) {
        ret "mach.lang.target.isa: the operands a row spells and the most its enumerated literals bring are more than a row carries";
    }
    if (leads && enumerated > 1) {
        ret "mach.lang.target.isa: operation definition's tail leads with an optional literal and names another enumerated literal: one literal decides the tail";
    }
    # an optional tail is the literal that decides it, and what that literal's value brings
    if (d.min_arity < d.spelled && !leads) {
        ret "mach.lang.target.isa: operation definition has an optional tail and no enumerated literal leading it to decide it";
    }
    if (d.min_arity < d.spelled && d.spelled != d.min_arity + 1) {
        ret "mach.lang.target.isa: operation definition spells operands after the literal leading its optional tail: what follows that literal is what its value brings";
    }
    ret nil;
}

# the reason a row's relations are malformed, nil when they are well formed: each relates a
# value operand or a value result to the operand its typing names, the data relation to a
# value or a pointer's pointee and the texel relation to a handle
fun op_relation_refusal(d: *OpDef) str {
    var related: bool = d.result_relation != OP_RELATION_NONE;
    if (d.result_relation >= OP_RELATION_COUNT) { ret "mach.lang.target.isa: operation definition declares an unknown result relation"; }
    val pointee: bool = d.result_relation == OP_RELATION_POINTEE;
    if (pointee && d.result != OP_RESULT_POINTER)           { ret "mach.lang.target.isa: operation definition relates a pointee of a result that is not a pointer"; }
    if (related && !pointee && d.result != OP_RESULT_VALUE) { ret "mach.lang.target.isa: operation definition relates a result that is not a value"; }
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        val r: OpRelation = d.relations[i];
        if (r >= OP_RELATION_COUNT)   { ret "mach.lang.target.isa: operation definition declares an unknown operand relation"; }
        if (r == OP_RELATION_POINTEE) { ret "mach.lang.target.isa: operation definition relates a pointee of an operand, which only a pointer result takes"; }
        if (r != OP_RELATION_NONE) {
            if (i >= d.spelled)                           { ret "mach.lang.target.isa: operation definition relates an operand it does not spell"; }
            if (d.kinds[i] != OP_OPERAND_VALUE)           { ret "mach.lang.target.isa: operation definition relates an operand that is not a value"; }
            if (d.typing != nil && d.typing.operand == i) { ret "mach.lang.target.isa: operation definition relates its data operand to itself"; }
            related = true;
        }
        i = i + 1;
    }
    if (!related) {
        if (d.texel_count != nil) { ret "mach.lang.target.isa: operation definition counts the components of a texel it does not relate"; }
        ret nil;
    }
    if (d.typing == nil) { ret "mach.lang.target.isa: operation definition states relations without a typing naming the operand they relate to"; }
    val handle: bool = op_kind_is_handle(d.kinds[d.typing.operand]);
    var texel:  bool = false;
    i = 0;
    for (i <= OP_MAX_OPERANDS) {
        var r: OpRelation = d.result_relation;
        if (i < OP_MAX_OPERANDS)               { r = d.relations[i]; }
        if (r == OP_RELATION_DATA && handle)   { ret "mach.lang.target.isa: operation definition relates a type to a handle's own type"; }
        if (r == OP_RELATION_TEXEL && !handle) { ret "mach.lang.target.isa: operation definition relates a texel to an operand that is not a handle"; }
        if (r == OP_RELATION_TEXEL)            { texel = true; }
        if (r == OP_RELATION_POINTEE && !op_kind_is_pointer(d.kinds[d.typing.operand])) {
            ret "mach.lang.target.isa: operation definition relates a pointee to an operand that addresses no handle";
        }
        i = i + 1;
    }
    ret op_texel_count_refusal(d.texel_count, texel);
}

# the reason a row's texel count is malformed: every texel a row relates states its count,
# a count belongs to a row relating a texel, and an exact count names at least one component
fun op_texel_count_refusal(c: *OpTexelCount, texel: bool) str {
    if (c == nil) {
        if (texel) { ret "mach.lang.target.isa: operation definition relates a texel without stating its component count"; }
        ret nil;
    }
    if (!texel)                                        { ret "mach.lang.target.isa: operation definition counts the components of a texel it does not relate"; }
    if (c.kind >= OP_COUNT_KIND_COUNT)                 { ret "mach.lang.target.isa: operation definition counts a texel's components by an unknown kind"; }
    if (c.kind == OP_COUNT_EXACT && c.components == 0) { ret "mach.lang.target.isa: operation definition counts a texel of no components"; }
    if (c.rule == nil)                                 { ret "mach.lang.target.isa: operation definition counts a texel's components under no named rule"; }
    ret nil;
}

pub fun op_def_by_code(defs: *TargetDefs, set_tag: u32, opcode: u32) *OpDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        if (defs.ops[i].set_tag == set_tag && defs.ops[i].opcode == opcode) { ret ?defs.ops[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun type_def(name: str, tag: u32, operands: *u32, arity: u32, refuse: TypeRefuseFn) TypeDef {
    var d: TypeDef;
    d.name       = name;
    d.tag        = tag;
    d.operands   = operands;
    d.arity      = arity;
    d.refuse     = refuse;
    d.bind       = nil;
    d.compose    = nil;
    d.sampled    = nil;
    d.components = nil;
    d.texels_of  = NO_TEXEL_OPERAND;
    d.address    = nil;
    ret d;
}

# the role a handle of constructor `td` with operands `ops` binds through
pub fun type_def_binding(td: *TypeDef, ops: *u32, n: u32) u32 {
    if (td == nil || td.bind == nil) { ret HANDLE_BIND_SAMPLER; }
    ret td.bind(ops, n);
}

# the scalar texels of a handle of constructor `td` with operands `ops` are, class
# OP_DATA_OTHER when the constructor declares none
pub fun type_def_sampled(td: *TypeDef, ops: *u32, n: u32) OpScalar {
    if (td == nil || td.sampled == nil) { ret OpScalar{class: OP_DATA_OTHER, bits: 0, signed: false}; }
    ret td.sampled(ops, n);
}

# the number of components a handle of constructor `td` with operands `ops` stores each
# texel in, 0 when its format is unknown or the constructor declares none
pub fun type_def_components(td: *TypeDef, ops: *u32, n: u32) u32 {
    if (td == nil || td.components == nil) { ret 0; }
    ret td.components(ops, n);
}

# why no instruction may derive a pointer into a handle of constructor `td` with operands
# `ops`, nil when one may
pub fun type_def_address(td: *TypeDef, ops: *u32, n: u32) str {
    if (td == nil || td.address == nil) { ret "no instruction addresses this handle's memory: a pointer derived from it names nothing the target lays out"; }
    ret td.address(ops, n);
}

pub fun target_defs(ops: *OpDef, op_count: u32, types: *TypeDef, type_count: u32) TargetDefs {
    var t: TargetDefs;
    t.ops        = ops;
    t.op_count   = op_count;
    t.types      = types;
    t.type_count = type_count;
    ret t;
}

pub fun type_def_of_region(defs: *TargetDefs, src: str, off: usize, len: usize) *TypeDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.type_count) {
        val d: *TypeDef = ?defs.types[i];
        if (str_region_equals(src, off, len, d.name)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

pub fun type_def_by_tag(defs: *TargetDefs, tag: u32) *TypeDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.type_count) {
        if (defs.types[i].tag == tag) { ret ?defs.types[i]; }
        i = i + 1;
    }
    ret nil;
}

#[testing]
pub fun op_def_of(defs: *TargetDefs, set_name: str, op_name: str) *OpDef {
    ret op_def_of_region(defs, set_name, 0::usize, str_len(set_name),
        op_name, 0::usize, str_len(op_name));
}

pub fun op_def_of_region(defs: *TargetDefs, set_src: str, set_off: usize, set_len: usize,
    nam_src: str, nam_off: usize, nam_len: usize) *OpDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        val d: *OpDef = ?defs.ops[i];
        if (str_region_equals(set_src, set_off, set_len, d.set)
            && str_region_equals(nam_src, nam_off, nam_len, d.name)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

pub fun op_set_exists_region(defs: *TargetDefs, src: str, off: usize, len: usize) bool {
    if (defs == nil) { ret false; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        if (str_region_equals(src, off, len, defs.ops[i].set)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
pub fun op_set_exists(defs: *TargetDefs, name: str) bool {
    ret op_set_exists_region(defs, name, 0::usize, str_len(name));
}

pub fun with_defs(vt: *IsaVTable, d: *TargetDefs) {
    vt.defs = d;
}

pub fun with_page_size(vt: *IsaVTable, page_size: u64) {
    vt.page_size = page_size;
}

# `open` is what a target naming no environment is granted: with no ceiling
# over it, every extension an environment could guarantee
pub fun with_environments(vt: *IsaVTable, envs: *Environment, count: u32, open: u64) {
    vt.envs          = envs;
    vt.env_count     = count;
    vt.env_open_exts = open;
}

pub fun environment_lookup(vt: *IsaVTable, name: str) u32 {
    var i: u32 = 0;
    for (i < vt.env_count) {
        if (str_equals(vt.envs[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret ENV_NONE;
}

pub fun environment_profile(vt: *IsaVTable, env_id: u32) u32 {
    if (env_id == ENV_NONE || env_id >= vt.env_count) { ret ENV_NONE; }
    ret vt.envs[env_id].profile;
}

# the extensions the target's environment guarantees, which its selection holds
# beside the ones it names
pub fun environment_extensions(vt: *IsaVTable, env_id: u32) u64 {
    if (env_id == ENV_NONE)     { ret vt.env_open_exts; }
    if (env_id >= vt.env_count) { ret 0; }
    ret vt.envs[env_id].extensions;
}

# an execution environment an isa defines: its name, its profile, and the
# extensions of the isa's vocabulary it guarantees (spirv's `zero_init_workgroup`
# from vulkan1.3)
pub rec Environment {
    name:       str;
    profile:    u32;
    extensions: u64;
}

pub val ENV_NONE: u32 = 0xFFFFFFFF;

pub rec IsaVTable {
    id:            u32;
    name:          str;
    elf_machine:   u32;
    pointer_width: u32;
    # the hardware page: the granularity a loader maps a segment at when the
    # operating system declares no page of its own; 0 for an isa with no pages
    page_size: u64;
    reloc:     *RelocSeam;
    machine:   *RegMachine;
    emitter:   *ModuleEmitter;
    model:     *MachineModel;
    defs:      *TargetDefs;
    envs:      *Environment;
    env_count: u32;
    # what a target naming no environment is granted of the vocabulary
    env_open_exts: u64;
}

pub fun reg_machine(select: SelectFn, encode: EncodeFn,
    is_reg_move: IsRegMoveFn, is_trap_terminator: IsTrapTerminatorFn,
    reserved_regs: *Register, reserved_reg_count: i32,
    reload_scratch_regs: *Register, reload_scratch_count: i32,
    scratch_reg: i32, scratch_reg2: i32,
    frame_ptr_reg: i32, stack_ptr_reg: i32, incoming_arg_base: i64,
    div_reg: i32, div_hi_reg: i32, shift_count_reg: i32) RegMachine {
    var m: RegMachine;
    m.select               = select;
    m.encode               = encode;
    m.is_reg_move          = is_reg_move;
    m.is_trap_terminator   = is_trap_terminator;
    m.reserved_regs        = reserved_regs;
    m.reserved_reg_count   = reserved_reg_count;
    m.reload_scratch_regs  = reload_scratch_regs;
    m.reload_scratch_count = reload_scratch_count;
    m.scratch_reg          = scratch_reg;
    m.scratch_reg2         = scratch_reg2;
    m.frame_ptr_reg        = frame_ptr_reg;
    m.stack_ptr_reg        = stack_ptr_reg;
    m.incoming_arg_base    = incoming_arg_base;
    m.div_reg              = div_reg;
    m.div_hi_reg           = div_hi_reg;
    m.shift_count_reg      = shift_count_reg;
    m.frame_dist           = nil;
    m.int_imm_fits         = nil;
    m.reads_const          = nil;
    ret m;
}

pub fun with_assembly(m: *RegMachine, emit: EmitAsmFn, clobbers: AsmClobbersFn,
    returns: AsmReturnsFn, ct_scan: AsmCtScanFn, writes_sp: AsmWritesSpFn) {
    m.has_assembly       = true;
    m.assembly.writes_sp = writes_sp;
    m.assembly.emit      = emit;
    m.assembly.clobbers  = clobbers;
    m.assembly.returns   = returns;
    m.assembly.ct_scan   = ct_scan;
}

pub fun with_dwarf_regs(m: *RegMachine, f: DwarfRegFn) {
    m.dwarf_reg = f;
}

pub fun with_codeview_regs(m: *RegMachine, f: CvRegFn) {
    m.cv_reg = f;
}

pub fun with_frame_dist(m: *RegMachine, f: FrameDistFn) {
    m.frame_dist = f;
}

pub fun with_int_imm_rule(m: *RegMachine, f: IntImmFitsFn) {
    m.int_imm_fits = f;
}

pub fun with_const_operand_rule(m: *RegMachine, f: ReadsConstFn) {
    m.reads_const = f;
}

pub fun reloc_seam(apply_reloc: of.ApplyRelocFn, reloc_traits: of.RelocTraitsFn,
    elf_reloc_type: of.ElfRelocTypeFn) RelocSeam {
    var s: RelocSeam;
    s.apply                   = apply_reloc;
    s.traits                  = reloc_traits;
    s.normalize               = nil;
    s.resolve_operand         = nil;
    s.local_got_kind          = nil;
    s.branch_reach            = nil;
    s.branch_thunk            = nil;
    s.has_elf                 = elf_reloc_type != nil;
    s.elf.reloc_type          = elf_reloc_type;
    s.elf.attributes.section  = nil;
    s.elf.attributes.sht      = 0;
    s.elf.attributes.vendor   = nil;
    s.elf.has_attributes      = false;
    s.elf.machine_flags       = nil;
    s.elf.build_attributes    = nil;
    s.elf.merge_attributes    = nil;
    s.elf.validate_attributes = nil;
    ret s;
}

pub fun with_elf_attributes(s: *RelocSeam, attributes: *of.ElfAttributes) {
    s.has_elf                = true;
    s.elf.has_attributes     = attributes != nil;
    s.elf.attributes.section = nil;
    s.elf.attributes.sht     = 0;
    s.elf.attributes.vendor  = nil;
    if (attributes != nil) { s.elf.attributes = @attributes; }
}

pub fun with_local_got_kinds(s: *RelocSeam, f: of.LocalGotKindFn) {
    s.local_got_kind = f;
}

pub fun declares_local_got(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.local_got_kind != nil;
}

pub fun local_got_kind(tgt_isa: *IsaVTable, kind: of.RelocKind) bool {
    if (!declares_local_got(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.local_got_kind(kind);
}

pub fun with_branch_thunks(s: *RelocSeam, reach: of.BranchReachFn, thunk: of.BranchThunkFn) {
    s.branch_reach = reach;
    s.branch_thunk = thunk;
}

pub fun declares_branch_thunks(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.branch_reach != nil && tgt_isa.reloc.branch_thunk != nil;
}

# the reach of a direct branch a thunk can extend, none for any other kind or
# an instruction set that places no thunks
pub fun branch_reach(tgt_isa: *IsaVTable, kind: of.RelocKind) opt[of.BranchReach] {
    if (!declares_branch_thunks(tgt_isa)) { ret opt[of.BranchReach].none{}; }
    ret tgt_isa.reloc.branch_reach(kind);
}

pub fun with_machine_flags(s: *RelocSeam, f: of.MachineFlagsFn) {
    s.has_elf           = true;
    s.elf.machine_flags = f;
}

pub fun declares_machine_flags(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.has_elf && tgt_isa.reloc.elf.machine_flags != nil;
}

pub fun machine_flags(tgt_isa: *IsaVTable, float_arg_bits: u32,
    has_compressed: bool) u32 {
    if (tgt_isa == nil)                                                   { ret 0; }
    if (!emits_relocations(tgt_isa))                                      { ret 0; }
    if (!tgt_isa.reloc.has_elf || tgt_isa.reloc.elf.machine_flags == nil) { ret 0; }
    ret tgt_isa.reloc.elf.machine_flags(float_arg_bits, has_compressed);
}

pub fun with_normalize_image(s: *RelocSeam, f: of.NormalizeImageFn) {
    s.normalize = f;
}

pub fun with_resolve_reloc_operand(s: *RelocSeam, f: of.ResolveRelocOperandFn) {
    s.resolve_operand = f;
}

pub fun with_attributes(s: *RelocSeam, build: of.BuildAttributesFn, merge: of.MergeAttributesFn, validate: of.ValidateAttributesFn) {
    s.has_elf                 = true;
    s.elf.build_attributes    = build;
    s.elf.merge_attributes    = merge;
    s.elf.validate_attributes = validate;
}

pub fun declares_attributes(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.has_elf && tgt_isa.reloc.elf.build_attributes != nil
        && tgt_isa.reloc.elf.merge_attributes != nil && tgt_isa.reloc.elf.validate_attributes != nil;
}

pub fun build_attributes(tgt_isa: *IsaVTable, model: *MachineModel, alloc: *A.Allocator, float_arg_bits: u32,
    has_compressed: bool, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!declares_attributes(tgt_isa)) { ret res[*u8, fail.Fail].ok{nil}; }
    if (model == nil)                  { ret res[*u8, fail.Fail].err{fail.message("riscv attributes: selected model is missing")}; }
    val r_855: res[*u8, fail.Fail] = tgt_isa.reloc.elf.build_attributes(alloc, model.gpr_width * 8, model.extensions,
        float_arg_bits, has_compressed, out_len);
    if (sel r_855.err) { ret res[*u8, fail.Fail].err{r_855.err}; }
    ret res[*u8, fail.Fail].ok{r_855.ok};
}

pub fun validate_attributes(tgt_isa: *IsaVTable, model: *MachineModel,
    bytes: *u8, len: u32, flags: u32) err[fail.Fail] {
    if (!declares_attributes(tgt_isa)) {
        if (len == 0) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.message("link: target has no selected attribute validation capability")};
    }
    if (model == nil || (len != 0 && bytes == nil)) {
        ret err[fail.Fail].err{fail.message("link: target has no selected attribute validation capability")};
    }
    val r_867: err[fail.Fail] = tgt_isa.reloc.elf.validate_attributes(bytes, len, model.gpr_width * 8, flags);
    if (sel r_867.err) { ret err[fail.Fail].err{r_867.err}; }
    ret err[fail.Fail].ok{};
}

pub fun merge_attributes(tgt_isa: *IsaVTable, alloc: *A.Allocator, acc: *u8, acc_len: u32,
    add: *u8, add_len: u32, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!declares_attributes(tgt_isa)) { ret res[*u8, fail.Fail].ok{nil}; }
    val r_874: res[*u8, fail.Fail] = tgt_isa.reloc.elf.merge_attributes(alloc, acc, acc_len, add, add_len, out_len);
    if (sel r_874.err) { ret res[*u8, fail.Fail].err{r_874.err}; }
    ret res[*u8, fail.Fail].ok{r_874.ok};
}

pub fun object_target(vt: *IsaVTable, out: *of.ObjectTarget) {
    out.arch_id       = vt.id;
    out.elf_machine   = vt.elf_machine;
    out.pointer_width = vt.pointer_width;
    out.relocation    = vt.reloc;
}

pub fun machine_isa(id: u32, name: str, elf_machine: u32, pointer_width: u32,
    model: *MachineModel, machine: *RegMachine,
    reloc: *RelocSeam) IsaVTable {
    var vt: IsaVTable = isa_common(id, name, elf_machine, pointer_width, model);
    vt.reloc   = reloc;
    vt.machine = machine;
    vt.emitter = nil;
    ret vt;
}

pub fun emitter_isa(id: u32, name: str, pointer_width: u32,
    model: *MachineModel, emitter: *ModuleEmitter) IsaVTable {
    var vt: IsaVTable = isa_common(id, name, 0, pointer_width, model);
    vt.reloc   = nil;
    vt.machine = nil;
    vt.emitter = emitter;
    ret vt;
}

pub fun module_emitter(emit_module: EmitModuleFn, has_assembly: bool) ModuleEmitter {
    var emitter: ModuleEmitter;
    emitter.emit_module  = emit_module;
    emitter.has_assembly = has_assembly;
    ret emitter;
}

fun isa_common(id: u32, name: str, elf_machine: u32, pointer_width: u32,
    model: *MachineModel) IsaVTable {
    var vt: IsaVTable;
    vt.id            = id;
    vt.name          = name;
    vt.elf_machine   = elf_machine;
    vt.pointer_width = pointer_width;
    vt.page_size     = 0;
    vt.model         = model;
    vt.envs          = nil;
    vt.env_count     = 0;
    vt.env_open_exts = 0;
    ret vt;
}

val ISA_REGISTRY_CAP: u32 = 8;

pub rec IsaRegistryEntry {
    descriptor:         IsaVTable;
    model:              MachineModel;
    machine:            RegMachine;
    emitter:            ModuleEmitter;
    reloc:              RelocSeam;
    defs:               TargetDefs;
    reg_classes:        *RegClass;
    model_reserved:     *Register;
    machine_reserved:   *Register;
    reload_scratch:     *Register;
    packed_forms:       *PackedForm;
    scalar_forms:       *ScalarForm;
    half_forms:         *PackedForm;
    register_rows:      *VectorRegisterRow;
    width_rows:         *VectorWidthRow;
    ct_mul_forms:       *ct.CtMulForm;
    envs:               *Environment;
    op_defs:            *OpDef;
    type_defs:          *TypeDef;
    type_operands:      *u32;
    type_operand_count: u32;
}

pub rec IsaRegistry {
    entries:     [8]IsaRegistryEntry;
    count:       u32;
    alloc:       A.Allocator;
    alloc_ready: bool;
}

rec ArchSpec {
    arch:            u32;
    spelling:        str;
    fingerprint_tag: u8;
}

# version 2: catalog id 4 is reserved with no row and the tags after it moved up (#3226)
pub val ARCH_CATALOG_VERSION: u8 = 2;

val ARCH_N: usize            = 5;
val ARCHS:  [ARCH_N]ArchSpec = [ARCH_N]ArchSpec{
    ArchSpec{arch: ARCH_X86_64, spelling: "x86_64", fingerprint_tag: 1},
    ArchSpec{arch: ARCH_AARCH64, spelling: "aarch64", fingerprint_tag: 2},
    ArchSpec{arch: ARCH_RISCV64, spelling: "riscv64", fingerprint_tag: 3},
    ArchSpec{arch: ARCH_SPIRV, spelling: "spirv", fingerprint_tag: 4},
    ArchSpec{arch: ARCH_RISCV32, spelling: "riscv32", fingerprint_tag: 5},
};

fun arch_spec(id: u32) *ArchSpec {
    var i: usize = 0;
    for (i < ARCH_N) {
        if (ARCHS[i].arch == id) { ret ?ARCHS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun arch_id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ARCH_N) {
        if (str_equals(ARCHS[i].spelling, name)) { ret ARCHS[i].arch; }
        i = i + 1;
    }
    val rv: res[rvfeatures.Selection, fail.Fail] = rvfeatures.parse(name);
    if (sel rv.ok) {
        if (sel rv.err)       { ret ARCH_RISCV32; }
        if (rv.ok.width == 4) { ret ARCH_RISCV32; }
        ret ARCH_RISCV64;
    }
    ret ARCH_UNKNOWN;
}

# why a selection has no floating-point unit, for a diagnostic that already names
# the selection: the letters a RISC-V string would need, or empty when the name
# carries no extension vocabulary the front end could ask the user to add
pub fun float_absence_note(name: str) str {
    if (!rvfeatures.is_name(name)) { ret ""; }
    val rv: res[rvfeatures.Selection, fail.Fail] = rvfeatures.parse(name);
    if (sel rv.err)                                     { ret ""; }
    if (rvfeatures.has(rv.ok.extensions, rvfeatures.F)) { ret ""; }
    ret "the selection lacks the F extension";
}

pub fun arch_name_for(id: u32) str {
    val spec: *ArchSpec = arch_spec(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun arch_catalog_len() usize {
    ret ARCH_N;
}

pub fun arch_catalog_name(index: usize) str {
    if (index >= ARCH_N) { ret "unknown"; }
    ret ARCHS[index].spelling;
}

pub fun arch_fingerprint_tag(id: u32) u8 {
    val spec: *ArchSpec = arch_spec(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

pub fun regid_make(class_id: i32, index: i32) i32 {
    ret ((class_id & 0xFF) << 8) | (index & 0xFF);
}

pub fun regid_class(regid: i32) i32 {
    ret (regid >> 8) & 0xFF;
}

pub fun regid_index(regid: i32) i32 {
    ret regid & 0xFF;
}

pub fun make_none() Operand {
    ret operand_blank(OPK_NONE, 0);
}

pub fun make_reg(id: i32, size: u8) Operand {
    var op: Operand = operand_blank(OPK_REG, size);
    op.reg = id;
    ret op;
}

pub fun make_imm(value: i64, size: u8) Operand {
    var op: Operand = operand_blank(OPK_IMM, size);
    op.imm = value;
    ret op;
}

pub fun make_mem(base: i32, disp: i32, index: i32, scale: u8, size: u8) Operand {
    var op: Operand = operand_blank(OPK_MEM, size);
    op.base  = base;
    op.index = index;
    op.scale = scale;
    op.disp  = disp;
    ret op;
}

pub fun make_block_label(id: u32) Operand {
    var op: Operand = operand_blank(OPK_LABEL, 0);
    op.label = nil;
    op.imm   = id::i64;
    ret op;
}

# a target inside the same expansion, resolved by the encoder that emitted
# it: not a block of the function and not a symbol. the direction is what
# a walk needs: a forward skip only joins ahead, a backward one is a loop
pub fun make_local_label(forward: bool) Operand {
    var op: Operand = operand_blank(OPK_LABEL, 0);
    op.label = nil;
    op.imm   = LOCAL_LABEL_BACK;
    if (forward) { op.imm = LOCAL_LABEL_FWD; }
    ret op;
}

# a local label with a number, so a listing can spell the jump as `1f` or
# `1b` and its definition as `1:`; the encoder still patches the displacement
pub fun make_numbered_local_label(forward: bool, number: u32) Operand {
    var op: Operand = make_local_label(forward);
    op.sym_id = number;
    ret op;
}

pub fun local_label_number(op: *Operand) u32 {
    if (op.kind != OPK_LABEL || op.label != nil || op.imm >= 0) { ret 0; }
    ret op.sym_id;
}

pub val LOCAL_LABEL_FWD:  i64 = -1;
pub val LOCAL_LABEL_BACK: i64 = -2;

pub fun label_is_block(op: *Operand) bool {
    ret op.kind == OPK_LABEL && op.label == nil && op.imm >= 0;
}

pub fun label_is_forward_local(op: *Operand) bool {
    ret op.kind == OPK_LABEL && op.label == nil && op.imm == LOCAL_LABEL_FWD;
}

pub fun make_sym(sym_id: u32, size: u8) Operand {
    var op: Operand = operand_blank(OPK_SYM, size);
    op.sym_id = sym_id;
    ret op;
}

#[testing]
pub fun buf_init(alloc: *A.Allocator) InstBuf {
    var buf: InstBuf;
    buf.insts = nil;
    buf.count = 0;
    buf.cap   = 0;
    buf.alloc = alloc;
    buf.err   = false;
    ret buf;
}

#[testing]
pub fun buf_append(buf: *InstBuf, inst: Inst) {
    if (buf.err) { ret; }
    if (buf.count >= buf.cap) {
        var new_cap: i32 = INSTBUF_INIT_CAP;
        if (buf.cap > 0) {
            new_cap = buf.cap * 2;
        }

        val res_grow: res[*Inst, A.Error] = A.reallocate[Inst](
            buf.alloc, buf.insts, buf.cap::usize, new_cap::usize);
        if (sel res_grow.err) {
            buf.err = true;
            ret;
        }
        buf.insts = res_grow.ok;
        buf.cap   = new_cap;
    }

    buf.insts[buf.count] = inst;
    buf.count            = buf.count + 1;
}

#[testing]
pub fun buf_dnit(buf: *InstBuf) {
    if (buf == nil) { ret; }
    if (buf.insts != nil && buf.cap > 0) {
        A.deallocate[Inst](buf.alloc, buf.insts, buf.cap::usize);
        buf.insts = nil;
    }
    buf.count = 0;
    buf.cap   = 0;
    buf.err   = false;
}

pub fun registry_init_with_allocator(alloc: *A.Allocator) IsaRegistry {
    var reg: IsaRegistry;
    reg.alloc_ready = alloc != nil;
    if (alloc != nil) { reg.alloc = @alloc; }
    var i: u32 = 0;
    for (i < ISA_REGISTRY_CAP) {
        reg.entries[i].descriptor.id      = ARCH_UNKNOWN;
        reg.entries[i].descriptor.name    = nil;
        reg.entries[i].descriptor.reloc   = nil;
        reg.entries[i].reg_classes        = nil;
        reg.entries[i].model_reserved     = nil;
        reg.entries[i].machine_reserved   = nil;
        reg.entries[i].reload_scratch     = nil;
        reg.entries[i].packed_forms       = nil;
        reg.entries[i].scalar_forms       = nil;
        reg.entries[i].half_forms         = nil;
        reg.entries[i].register_rows      = nil;
        reg.entries[i].width_rows         = nil;
        reg.entries[i].ct_mul_forms       = nil;
        reg.entries[i].envs               = nil;
        reg.entries[i].op_defs            = nil;
        reg.entries[i].type_defs          = nil;
        reg.entries[i].type_operands      = nil;
        reg.entries[i].type_operand_count = 0;
        i                                 = i + 1;
    }
    reg.count = 0;
    ret reg;
}

pub fun registry_init() IsaRegistry {
    var alloc:  A.Allocator;
    val r_1174: err[A.Error] = page.make(?alloc);
    if (sel r_1174.err) { ret registry_init_with_allocator(nil); }
    ret registry_init_with_allocator(?alloc);
}

fun own_copy[T](alloc: *A.Allocator, src: *T, count: usize) res[*T, fail.Fail] {
    if (count == 0) { ret res[*T, fail.Fail].ok{nil}; }
    val res_: res[*T, A.Error] = A.allocate[T](alloc, count);
    if (sel res_.err) { ret res[*T, fail.Fail].err{fail.refused(res_.err)}; }
    val dst: *T    = res_.ok;
    var i:   usize = 0;
    for (i < count) {
        dst[i] = src[i];
        i      = i + 1;
    }
    ret res[*T, fail.Fail].ok{dst};
}

fun own_space[T](alloc: *A.Allocator, count: usize) res[*T, fail.Fail] {
    if (count == 0) { ret res[*T, fail.Fail].ok{nil}; }
    val r_1193: res[*T, A.Error] = A.allocate[T](alloc, count);
    if (sel r_1193.err) { ret res[*T, fail.Fail].err{fail.refused(r_1193.err)}; }
    ret res[*T, fail.Fail].ok{r_1193.ok};
}

fun release_entry(reg: *IsaRegistry, entry: *IsaRegistryEntry) {
    if (entry.descriptor.name != nil) {
        A.deallocate[u8](?reg.alloc, entry.descriptor.name::*u8, str_len(entry.descriptor.name) + 1);
    }
    if (entry.reg_classes != nil) {
        var ci: u32 = 0;
        for (ci < entry.model.reg_class_len) {
            if (entry.reg_classes[ci].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.reg_classes[ci].name::*u8,
                    str_len(entry.reg_classes[ci].name) + 1);
            }
            ci = ci + 1;
        }
        A.deallocate[RegClass](?reg.alloc, entry.reg_classes, entry.model.reg_class_len::usize);
    }
    if (entry.model_reserved != nil) {
        A.deallocate[Register](?reg.alloc, entry.model_reserved, entry.model.reserved_len::usize);
    }
    if (entry.machine_reserved != nil) {
        A.deallocate[Register](?reg.alloc, entry.machine_reserved, entry.machine.reserved_reg_count::usize);
    }
    if (entry.reload_scratch != nil) {
        A.deallocate[Register](?reg.alloc, entry.reload_scratch, entry.machine.reload_scratch_count::usize);
    }
    if (entry.envs != nil) {
        var ei: u32 = 0;
        for (ei < entry.descriptor.env_count) {
            if (entry.envs[ei].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.envs[ei].name::*u8, str_len(entry.envs[ei].name) + 1);
            }
            ei = ei + 1;
        }
        A.deallocate[Environment](?reg.alloc, entry.envs, entry.descriptor.env_count::usize);
        entry.envs = nil;
    }
    if (entry.packed_forms != nil) {
        A.deallocate[PackedForm](?reg.alloc, entry.packed_forms, entry.model.packed_form_len::usize);
    }
    if (entry.scalar_forms != nil) {
        A.deallocate[ScalarForm](?reg.alloc, entry.scalar_forms, entry.model.scalar_form_len::usize);
    }
    if (entry.half_forms != nil) {
        A.deallocate[PackedForm](?reg.alloc, entry.half_forms, entry.model.half_form_len::usize);
    }
    if (entry.register_rows != nil) {
        A.deallocate[VectorRegisterRow](?reg.alloc, entry.register_rows, entry.model.vector_register_row_len::usize);
    }
    if (entry.width_rows != nil) {
        A.deallocate[VectorWidthRow](?reg.alloc, entry.width_rows, entry.model.vector_width_row_len::usize);
    }
    if (entry.ct_mul_forms != nil) {
        A.deallocate[ct.CtMulForm](?reg.alloc, entry.ct_mul_forms, entry.model.ct_mul_form_len::usize);
    }
    if (entry.op_defs != nil) {
        var oi: u32 = 0;
        for (oi < entry.defs.op_count) {
            if (entry.op_defs[oi].set != nil) {
                A.deallocate[u8](?reg.alloc, entry.op_defs[oi].set::*u8,
                    str_len(entry.op_defs[oi].set) + 1);
            }
            if (entry.op_defs[oi].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.op_defs[oi].name::*u8,
                    str_len(entry.op_defs[oi].name) + 1);
            }
            oi = oi + 1;
        }
        A.deallocate[OpDef](?reg.alloc, entry.op_defs, entry.defs.op_count::usize);
    }
    if (entry.type_defs != nil) {
        var ti: u32 = 0;
        for (ti < entry.defs.type_count) {
            if (entry.type_defs[ti].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.type_defs[ti].name::*u8,
                    str_len(entry.type_defs[ti].name) + 1);
            }
            ti = ti + 1;
        }
        A.deallocate[TypeDef](?reg.alloc, entry.type_defs, entry.defs.type_count::usize);
    }
    if (entry.type_operands != nil) {
        A.deallocate[u32](?reg.alloc, entry.type_operands, entry.type_operand_count::usize);
    }
    if (entry.descriptor.reloc != nil && entry.reloc.elf.has_attributes) {
        if (entry.reloc.elf.attributes.section != nil) {
            A.deallocate[u8](?reg.alloc, entry.reloc.elf.attributes.section::*u8,
                str_len(entry.reloc.elf.attributes.section) + 1);
        }
        if (entry.reloc.elf.attributes.vendor != nil) {
            A.deallocate[u8](?reg.alloc, entry.reloc.elf.attributes.vendor::*u8,
                str_len(entry.reloc.elf.attributes.vendor) + 1);
        }
        entry.reloc.elf.attributes.section = nil;
        entry.reloc.elf.attributes.vendor  = nil;
    }
    entry.reg_classes        = nil;
    entry.model_reserved     = nil;
    entry.machine_reserved   = nil;
    entry.reload_scratch     = nil;
    entry.packed_forms       = nil;
    entry.scalar_forms       = nil;
    entry.half_forms         = nil;
    entry.register_rows      = nil;
    entry.width_rows         = nil;
    entry.ct_mul_forms       = nil;
    entry.envs               = nil;
    entry.op_defs            = nil;
    entry.type_defs          = nil;
    entry.type_operands      = nil;
    entry.type_operand_count = 0;
    entry.descriptor.name    = nil;
    entry.descriptor.reloc   = nil;
}

pub fun registry_dnit(reg: *IsaRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > ISA_REGISTRY_CAP) { limit = ISA_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        release_entry(reg, ?reg.entries[i]);
        i = i + 1;
    }
    reg.count = 0;
}

fun errf(fb: str, fmt: str, va: ...) str {
    var alloc:  A.Allocator;
    val r_1307: err[A.Error] = page.make(?alloc);
    if (sel r_1307.err) { ret fb; }
    val r: res[str, format.FormatError] = format.sprint(?alloc, fmt, va...);
    if (sel r.err) { ret fb; }
    ret r.ok;
}

fun dup_id(reg: *IsaRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].descriptor.id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun descriptor_valid(vt: *IsaVTable) bool {
    if (vt == nil || str_len(vt.name) == 0 || vt.id == ARCH_UNKNOWN
        || vt.model == nil || vt.pointer_width == 0
        || vt.model.pointer_width != vt.pointer_width) { ret false; }
    if (vt.page_size != 0 && (vt.page_size & (vt.page_size - 1)) != 0) { ret false; }
    val has_machine: bool = vt.machine != nil;
    val has_emitter: bool = vt.emitter != nil;
    if (has_machine == has_emitter) { ret false; }
    if (has_machine) {
        val banks: err[fail.Fail] = mir.check_operand_banks();
        if (sel banks.err) { ret false; }
        if (vt.machine.select == nil || vt.machine.encode == nil
            || vt.machine.is_reg_move == nil || vt.machine.is_trap_terminator == nil
            || vt.machine.reserved_reg_count < 0 || vt.machine.reload_scratch_count < 0
            || (vt.machine.reserved_reg_count > 0 && vt.machine.reserved_regs == nil)
            || (vt.machine.reload_scratch_count > 0 && vt.machine.reload_scratch_regs == nil)) { ret false; }
        if (vt.reloc != nil && (vt.reloc.apply == nil || vt.reloc.traits == nil)) { ret false; }
        if (vt.machine.has_assembly) {
            if (vt.machine.assembly.emit == nil || vt.machine.assembly.clobbers == nil
                || vt.machine.assembly.returns == nil || vt.machine.assembly.ct_scan == nil
                || vt.machine.assembly.writes_sp == nil) { ret false; }
        }
        or {
            if (vt.machine.assembly.emit != nil || vt.machine.assembly.clobbers != nil
                || vt.machine.assembly.returns != nil || vt.machine.assembly.ct_scan != nil
                || vt.machine.assembly.writes_sp != nil) { ret false; }
        }
    }
    if (has_emitter && (vt.emitter.emit_module == nil || vt.reloc != nil)) { ret false; }
    if (vt.reloc != nil && !vt.reloc.has_elf
        && (vt.reloc.elf.reloc_type != nil || vt.reloc.elf.has_attributes
        || vt.reloc.elf.attributes.section != nil || vt.reloc.elf.attributes.sht != 0
        || vt.reloc.elf.attributes.vendor != nil || vt.reloc.elf.machine_flags != nil
        || vt.reloc.elf.build_attributes != nil || vt.reloc.elf.merge_attributes != nil
        || vt.reloc.elf.validate_attributes != nil)) { ret false; }
    if (vt.reloc != nil && !vt.reloc.elf.has_attributes
        && (vt.reloc.elf.attributes.section != nil || vt.reloc.elf.attributes.sht != 0
        || vt.reloc.elf.attributes.vendor != nil)) { ret false; }
    if (vt.reloc != nil && vt.reloc.has_elf
        && ((vt.reloc.elf.build_attributes == nil) != (vt.reloc.elf.merge_attributes == nil)
        || (vt.reloc.elf.build_attributes == nil) != (vt.reloc.elf.validate_attributes == nil))) { ret false; }
    if (vt.reloc != nil && vt.reloc.elf.has_attributes
        && (str_len(vt.reloc.elf.attributes.section) == 0
        || str_len(vt.reloc.elf.attributes.vendor) == 0)) { ret false; }
    if (vt.elf_machine != 0
        && (vt.reloc == nil || vt.reloc.apply == nil || vt.reloc.traits == nil
        || !vt.reloc.has_elf || vt.reloc.elf.reloc_type == nil)) { ret false; }
    if (vt.model.reserved_len < 0
        || (vt.model.reg_class_len > 0 && vt.model.reg_classes == nil)
        || (vt.model.reserved_len > 0 && vt.model.reserved_regs == nil)
        || (vt.model.packed_form_len > 0 && vt.model.packed_forms == nil)
        || (vt.model.scalar_form_len > 0 && vt.model.scalar_forms == nil)
        || (vt.model.half_form_len > 0 && vt.model.half_forms == nil)) { ret false; }
    if (!packed_forms_valid(vt.model) || !scalar_forms_valid(vt.model) || !half_forms_valid(vt.model)) { ret false; }
    if (!float.nan_rule_valid(vt.model.nan_rule))                                                      { ret false; }
    if (!vector_register_rows_valid(vt.model) || !vector_width_rows_valid(vt.model))                   { ret false; }
    val mul_bad: opt[str] = ct_mul_forms_refusal(vt.model);
    if (sel mul_bad.some)                  { ret false; }
    if (!vector_domain_complete(vt.model)) { ret false; }
    var ci: u32 = 0;
    for (ci < vt.model.reg_class_len) {
        if (str_len(vt.model.reg_classes[ci].name) == 0) { ret false; }
        var cj: u32 = 0;
        for (cj < ci) {
            if (vt.model.reg_classes[cj].kind == vt.model.reg_classes[ci].kind
                || str_equals(vt.model.reg_classes[cj].name, vt.model.reg_classes[ci].name)) { ret false; }
            cj = cj + 1;
        }
        ci = ci + 1;
    }
    if (vt.defs != nil) {
        if ((vt.defs.op_count > 0 && vt.defs.ops == nil)
            || (vt.defs.type_count > 0 && vt.defs.types == nil)) { ret false; }
        var oi: u32 = 0;
        for (oi < vt.defs.op_count) {
            if (str_len(vt.defs.ops[oi].set) == 0 || str_len(vt.defs.ops[oi].name) == 0) { ret false; }
            var oj: u32 = 0;
            for (oj < oi) {
                if ((str_equals(vt.defs.ops[oj].set, vt.defs.ops[oi].set)
                    && str_equals(vt.defs.ops[oj].name, vt.defs.ops[oi].name))
                    || (vt.defs.ops[oj].set_tag == vt.defs.ops[oi].set_tag
                    && vt.defs.ops[oj].opcode == vt.defs.ops[oi].opcode)) { ret false; }
                oj = oj + 1;
            }
            oi = oi + 1;
        }
        var operand_count: u32 = 0;
        var ti:            u32 = 0;
        for (ti < vt.defs.type_count) {
            if (str_len(vt.defs.types[ti].name) == 0
                || (vt.defs.types[ti].arity > 0 && vt.defs.types[ti].operands == nil)
                || operand_count + vt.defs.types[ti].arity < operand_count) { ret false; }
            var tj: u32 = 0;
            for (tj < ti) {
                if (vt.defs.types[tj].tag == vt.defs.types[ti].tag
                    || str_equals(vt.defs.types[tj].name, vt.defs.types[ti].name)) { ret false; }
                tj = tj + 1;
            }
            operand_count = operand_count + vt.defs.types[ti].arity;
            ti            = ti + 1;
        }
    }
    ret true;
}

pub fun registry_validate(reg: *IsaRegistry) err[fail.Fail] {
    if (reg == nil) { ret err[fail.Fail].err{fail.message("mach.lang.target.isa: nil registry")}; }
    if (!reg.alloc_ready || reg.count > ISA_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: invalid registry backing or count")};
    }
    var i: u32 = 0;
    for (i < reg.count) {
        val entry: *IsaRegistryEntry = ?reg.entries[i];
        val vt:    *IsaVTable        = ?entry.descriptor;
        if (!descriptor_valid(vt)
            || vt.model != ?entry.model
            || (vt.machine != nil && vt.machine != ?entry.machine)
            || (vt.emitter != nil && vt.emitter != ?entry.emitter)
            || (vt.reloc != nil && vt.reloc != ?entry.reloc)
            || (vt.defs != nil && vt.defs != ?entry.defs)) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry contains an invalid owned descriptor")};
        }
        if ((entry.model.reg_class_len > 0 && entry.reg_classes == nil)
            || (entry.model.reserved_len > 0 && entry.model_reserved == nil)
            || (entry.model.packed_form_len > 0 && entry.packed_forms == nil)
            || (entry.model.scalar_form_len > 0 && entry.scalar_forms == nil)
            || (entry.model.half_form_len > 0 && entry.half_forms == nil)
            || (entry.model.vector_register_row_len > 0 && entry.register_rows == nil)
            || (entry.model.vector_width_row_len > 0 && entry.width_rows == nil)
            || (vt.machine != nil && vt.machine.reserved_reg_count > 0 && entry.machine_reserved == nil)
            || (vt.machine != nil && vt.machine.reload_scratch_count > 0 && entry.reload_scratch == nil)
            || (vt.defs != nil && vt.defs.op_count > 0 && entry.op_defs == nil)
            || (vt.defs != nil && vt.defs.type_count > 0 && entry.type_defs == nil)) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry owned storage is incomplete")};
        }
        if (vt.defs != nil) {
            var operands: u32 = 0;
            var ti:       u32 = 0;
            for (ti < vt.defs.type_count) {
                if (operands > entry.type_operand_count
                    || vt.defs.types[ti].arity > entry.type_operand_count - operands) {
                    ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry type operand bounds are inconsistent")};
                }
                if (vt.defs.types[ti].arity > 0
                    && (entry.type_operands == nil || vt.defs.types[ti].operands != ?entry.type_operands[operands])) {
                    ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry type operand storage is inconsistent")};
                }
                if (vt.defs.types[ti].arity == 0 && vt.defs.types[ti].operands != nil) {
                    ret err[fail.Fail].err{fail.message("mach.lang.target.isa: zero-arity type owns unexpected operand storage")};
                }
                operands = operands + vt.defs.types[ti].arity;
                ti       = ti + 1;
            }
            if (operands != entry.type_operand_count
                || (operands > 0 && entry.type_operands == nil)
                || (operands == 0 && entry.type_operands != nil)) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry type operand count is inconsistent")};
            }
        }
        var j: u32 = 0;
        for (j < i) {
            if (entry.descriptor.id == reg.entries[j].descriptor.id
                || str_equals(entry.descriptor.name, reg.entries[j].descriptor.name)) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry contains a duplicate identity")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun register(reg: *IsaRegistry, vt: *IsaVTable) err[fail.Fail] {
    if (reg == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: register called with a nil registry")};
    }
    if (reg.count > ISA_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry count exceeds its backing capacity")};
    }
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: register called with a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: register called with an empty name")};
    }
    if (vt.id == ARCH_UNKNOWN) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: register called with the unknown instruction-set id")};
    }
    val r_1498: opt[*IsaVTable] = lookup(reg, vt.name);
    if (sel r_1498.some) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: an instruction set is already registered under this name",
            "mach.lang.target.isa: an instruction set named '{}' is already registered", vt.name))};
    }
    if (dup_id(reg, vt.id)) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: an instruction set is already registered under this id",
            "mach.lang.target.isa: instruction set id {} is already registered (wanted to register '{}')", vt.id, vt.name))};
    }
    if (reg.count >= ISA_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry is at capacity; raise ISA_REGISTRY_CAP to register another instruction set")};
    }
    if (!reg.alloc_ready) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry backing allocator is unavailable")};
    }
    if (vt.model == nil || vt.pointer_width == 0 || vt.model.pointer_width != vt.pointer_width) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: an instruction set must declare a matching machine model",
            "mach.lang.target.isa: instruction set '{}' has no model or its model pointer width does not match the descriptor", vt.name))};
    }

    val has_machine: bool = vt.machine != nil;
    val has_emitter: bool = vt.emitter != nil;
    if (has_machine == has_emitter) {
        var reason: str = "declares both a native and a whole-module backend";
        if (!has_machine) { reason = "declares neither a native nor a whole-module backend"; }
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: an instruction set must declare exactly one backend family",
            "mach.lang.target.isa: instruction set '{}' {} (exactly one native or whole-module backend is required)",
            vt.name, reason))};
    }
    if (has_machine) {
        val banks: err[fail.Fail] = mir.check_operand_banks();
        if (sel banks.err) { ret banks; }
        if (vt.machine.select == nil || vt.machine.encode == nil
            || vt.machine.is_reg_move == nil || vt.machine.is_trap_terminator == nil) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: a native backend must declare its mandatory callbacks",
                "mach.lang.target.isa: instruction set '{}' is missing `select`, `encode`, `is_reg_move`, or `is_trap_terminator`", vt.name))};
        }
        if (vt.reloc != nil && (vt.reloc.apply == nil || vt.reloc.traits == nil)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: a declared relocation seam must carry its required hooks",
                "mach.lang.target.isa: instruction set '{}' declares a relocation seam missing `apply` or `traits`", vt.name))};
        }
        if (vt.machine.has_assembly
            && (vt.machine.assembly.emit == nil || vt.machine.assembly.clobbers == nil
            || vt.machine.assembly.returns == nil || vt.machine.assembly.ct_scan == nil
            || vt.machine.assembly.writes_sp == nil)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: an assembly capability group must be complete",
                "mach.lang.target.isa: instruction set '{}' declares only part of its assembly capability group", vt.name))};
        }
        if (!vt.machine.has_assembly
            && (vt.machine.assembly.emit != nil || vt.machine.assembly.clobbers != nil
            || vt.machine.assembly.returns != nil || vt.machine.assembly.ct_scan != nil
            || vt.machine.assembly.writes_sp != nil)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: disabled assembly capabilities cannot carry callbacks",
                "mach.lang.target.isa: instruction set '{}' carries assembly callbacks while declaring the group unsupported", vt.name))};
        }
    }
    if (has_emitter) {
        if (vt.emitter.emit_module == nil) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: a whole-module backend must declare its emitter",
                "mach.lang.target.isa: instruction set '{}' has no `emit_module` callback", vt.name))};
        }
        if (vt.reloc != nil) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: a whole-module backend cannot also carry a relocation seam",
                "mach.lang.target.isa: instruction set '{}' emits whole modules but also declares a relocation seam; the two emission shapes are exclusive", vt.name))};
        }
    }
    if (vt.reloc != nil && vt.reloc.has_elf
        && ((vt.reloc.elf.build_attributes == nil) != (vt.reloc.elf.merge_attributes == nil)
        || (vt.reloc.elf.build_attributes == nil) != (vt.reloc.elf.validate_attributes == nil))) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: ELF attribute construction, merging and validation must be declared together",
            "mach.lang.target.isa: instruction set '{}' does not declare the ELF attribute build, merge and validation hooks together", vt.name))};
    }
    if (vt.elf_machine != 0) {
        if (vt.reloc == nil || vt.reloc.apply == nil || vt.reloc.traits == nil
            || !vt.reloc.has_elf || vt.reloc.elf.reloc_type == nil) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: an ELF-covered instruction set must declare a complete relocation seam",
                "mach.lang.target.isa: instruction set '{}' declares an ELF machine but its relocation seam is missing `apply`, `traits`, or the ELF relocation mapper", vt.name))};
        }
    }

    if (vt.model != nil) {
        # the passes that decide whether an integer fits one operation read it,
        # and a zero width reads as every integer being too wide (#4163)
        if (max_alu_width(vt.model) == 0) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares no ALU width",
                "mach.lang.target.isa: instruction set '{}' declares no `alu_widths`", vt.name))};
        }
        if (vt.model.reserved_len < 0) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: machine model declares a negative reserved-register count")};
        }
        if ((vt.model.reg_class_len > 0 && vt.model.reg_classes == nil)
            || (vt.model.reserved_len > 0 && vt.model.reserved_regs == nil)
            || (vt.model.packed_form_len > 0 && vt.model.packed_forms == nil)
            || (vt.model.scalar_form_len > 0 && vt.model.scalar_forms == nil)
            || (vt.model.half_form_len > 0 && vt.model.half_forms == nil)) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: machine model declares nonempty backing without storage")};
        }
        if (!packed_forms_valid(vt.model) || !scalar_forms_valid(vt.model)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a vector form outside the retained vocabulary or twice",
                "mach.lang.target.isa: instruction set '{}' declares a packed or scalar vector form outside the retained vocabulary, twice, or in both tables", vt.name))};
        }
        if (!float.nan_rule_valid(vt.model.nan_rule)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares no NaN conversion rule",
                "mach.lang.target.isa: instruction set '{}' declares no NaN conversion rule", vt.name))};
        }
        if (!half_forms_valid(vt.model)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a scalar f16 form outside its vocabulary or twice",
                "mach.lang.target.isa: instruction set '{}' declares a scalar f16 form outside its vocabulary, twice, or gated on an extension it does not name", vt.name))};
        }
        if (!vector_register_rows_valid(vt.model)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a malformed vector register width",
                "mach.lang.target.isa: instruction set '{}' declares a vector register width that is not a power of two above its compute width, repeated, or gated on an extension it does not name", vt.name))};
        }
        if (!vector_width_rows_valid(vt.model)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a malformed vector compute width",
                "mach.lang.target.isa: instruction set '{}' declares a vector compute width that is not a power of two above its baseline, names no lane it has, is wider than the register its extensions select, or is gated on an extension it does not name", vt.name))};
        }
        if ((vt.model.extension_count > 0 && vt.model.extension_table == nil)
            || (vt.model.extension_table != nil && !extension.table_valid(vt.model.extension_table, vt.model.extension_count))
            || (vt.model.extensions & ~extension_domain(vt.model)) != 0) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a malformed extension vocabulary",
                "mach.lang.target.isa: instruction set '{}' declares an extension vocabulary with a repeated or non-identifier name, a bit that is not a single bit, or a selected bit it does not name", vt.name))};
        }
        if ((vt.model.level_count > 0 && vt.model.level_table == nil)
            || !extension.levels_valid(vt.model.level_table, vt.model.level_count, vt.model.extension_table, vt.model.extension_count)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a malformed level table",
                "mach.lang.target.isa: instruction set '{}' declares a level that is not a hyphenated spelling, is also a row's name, names a member outside its vocabulary, or does not extend the level before it", vt.name))};
        }
        val mul_why: opt[str] = ct_mul_forms_refusal(vt.model);
        if (sel mul_why.some) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model declares a malformed constant-time multiply row",
                "mach.lang.target.isa: instruction set '{}' {}", vt.name, mul_why.some))};
        }
        if (!vector_domain_complete(vt.model)) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.isa: machine model leaves a retained vector cell undeclared",
                "mach.lang.target.isa: instruction set '{}' declares neither a packed form nor the scalar expansion for some retained (operation, lane kind, lane width) cell", vt.name))};
        }
        var ci: u32 = 0;
        for (ci < vt.model.reg_class_len) {
            if (str_len(vt.model.reg_classes[ci].name) == 0) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: register class declares an empty name")};
            }
            ci = ci + 1;
        }
    }
    if (vt.machine != nil
        && (vt.machine.reserved_reg_count < 0 || vt.machine.reload_scratch_count < 0)) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: native machine declares a negative register count")};
    }
    if (vt.defs != nil) {
        if ((vt.defs.op_count > 0 && vt.defs.ops == nil)
            || (vt.defs.type_count > 0 && vt.defs.types == nil)) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: target definitions omit their declared storage")};
        }
        var operand_count: u32 = 0;
        var oi:            u32 = 0;
        for (oi < vt.defs.op_count) {
            if (str_len(vt.defs.ops[oi].set) == 0 || str_len(vt.defs.ops[oi].name) == 0) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: operation definition declares an empty set or name")};
            }
            val shape: str = op_def_shape_refusal(?vt.defs.ops[oi]);
            if (shape != nil) { ret err[fail.Fail].err{fail.message(shape)}; }
            oi = oi + 1;
        }
        var ti: u32 = 0;
        for (ti < vt.defs.type_count) {
            if (str_len(vt.defs.types[ti].name) == 0) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: type definition declares an empty name")};
            }
            if (vt.defs.types[ti].arity > 0 && vt.defs.types[ti].operands == nil) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: target type definition omits its operand storage")};
            }
            if (operand_count + vt.defs.types[ti].arity < operand_count) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: target type operand count overflows")};
            }
            operand_count = operand_count + vt.defs.types[ti].arity;
            ti            = ti + 1;
        }
    }
    if (vt.machine != nil
        && ((vt.machine.reserved_reg_count > 0 && vt.machine.reserved_regs == nil)
        || (vt.machine.reload_scratch_count > 0 && vt.machine.reload_scratch_regs == nil))) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: native machine declares nonempty register backing without storage")};
    }
    if (!descriptor_valid(vt)) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: descriptor contains an ambiguous or malformed nested capability")};
    }

    val entry: *IsaRegistryEntry = ?reg.entries[reg.count];
    entry.descriptor         = @vt;
    entry.descriptor.name    = nil;
    entry.descriptor.reloc   = nil;
    entry.reg_classes        = nil;
    entry.model_reserved     = nil;
    entry.machine_reserved   = nil;
    entry.reload_scratch     = nil;
    entry.packed_forms       = nil;
    entry.scalar_forms       = nil;
    entry.half_forms         = nil;
    entry.register_rows      = nil;
    entry.width_rows         = nil;
    entry.ct_mul_forms       = nil;
    entry.envs               = nil;
    entry.op_defs            = nil;
    entry.type_defs          = nil;
    entry.type_operands      = nil;
    entry.type_operand_count = 0;
    val r_descriptor_name: res[str, string.StrError] = str_copy(?reg.alloc, vt.name);
    if (sel r_descriptor_name.err) {
        release_entry(reg, entry);
        ret err[fail.Fail].err{fail.str_refused(r_descriptor_name.err)};
    }
    entry.descriptor.name = r_descriptor_name.ok;
    entry.descriptor.envs = nil;
    if (vt.env_count > 0) {
        if (vt.envs == nil) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: instruction set declares environments without storage")};
        }
        val r_envs: res[*Environment, fail.Fail] = own_copy[Environment](?reg.alloc, vt.envs, vt.env_count::usize);
        if (sel r_envs.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_envs.err};
        }
        entry.envs = r_envs.ok;
        var ei: u32 = 0;
        for (ei < vt.env_count) {
            entry.envs[ei].name = nil;
            ei                  = ei + 1;
        }
        ei = 0;
        for (ei < vt.env_count) {
            if (str_len(vt.envs[ei].name) == 0) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.message("mach.lang.target.isa: an environment declares an empty name")};
            }
            val r_env_name: res[str, string.StrError] = str_copy(?reg.alloc, vt.envs[ei].name);
            if (sel r_env_name.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(r_env_name.err)};
            }
            entry.envs[ei].name = r_env_name.ok;
            var ej: u32 = 0;
            for (ej < ei) {
                if (str_equals(entry.envs[ej].name, entry.envs[ei].name)) {
                    release_entry(reg, entry);
                    ret err[fail.Fail].err{fail.message("mach.lang.target.isa: an instruction set declares one environment twice")};
                }
                ej = ej + 1;
            }
            ei = ei + 1;
        }
        entry.descriptor.envs = entry.envs;
    }
    if (vt.model != nil) {
        entry.model = @(vt.model);
        val r_reg_classes: res[*RegClass, fail.Fail] = own_space[RegClass](?reg.alloc, vt.model.reg_class_len::usize);
        if (sel r_reg_classes.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_reg_classes.err};
        }
        entry.reg_classes = r_reg_classes.ok;
        var ci: u32 = 0;
        for (ci < vt.model.reg_class_len) {
            entry.reg_classes[ci].name = nil;
            ci                         = ci + 1;
        }
        ci = 0;
        for (ci < vt.model.reg_class_len) {
            entry.reg_classes[ci].kind = vt.model.reg_classes[ci].kind;
            entry.reg_classes[ci].len  = vt.model.reg_classes[ci].len;
            val r_class_name: res[str, string.StrError] = str_copy(?reg.alloc, vt.model.reg_classes[ci].name);
            if (sel r_class_name.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(r_class_name.err)};
            }
            entry.reg_classes[ci].name = r_class_name.ok;
            ci                         = ci + 1;
        }
        entry.model.reg_classes = entry.reg_classes;
        val r_model_reserved: res[*Register, fail.Fail] = own_copy[Register](?reg.alloc, vt.model.reserved_regs, vt.model.reserved_len::usize);
        if (sel r_model_reserved.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_model_reserved.err};
        }
        entry.model_reserved      = r_model_reserved.ok;
        entry.model.reserved_regs = entry.model_reserved;
        val r_packed_forms: res[*PackedForm, fail.Fail] = own_copy[PackedForm](?reg.alloc, vt.model.packed_forms, vt.model.packed_form_len::usize);
        if (sel r_packed_forms.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_packed_forms.err};
        }
        entry.packed_forms       = r_packed_forms.ok;
        entry.model.packed_forms = entry.packed_forms;
        val r_scalar_forms: res[*ScalarForm, fail.Fail] = own_copy[ScalarForm](?reg.alloc, vt.model.scalar_forms, vt.model.scalar_form_len::usize);
        if (sel r_scalar_forms.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_scalar_forms.err};
        }
        entry.scalar_forms       = r_scalar_forms.ok;
        entry.model.scalar_forms = entry.scalar_forms;
        val r_half_forms: res[*PackedForm, fail.Fail] = own_copy[PackedForm](?reg.alloc, vt.model.half_forms, vt.model.half_form_len::usize);
        if (sel r_half_forms.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_half_forms.err};
        }
        entry.half_forms       = r_half_forms.ok;
        entry.model.half_forms = entry.half_forms;
        val r_register_rows: res[*VectorRegisterRow, fail.Fail] = own_copy[VectorRegisterRow](?reg.alloc, vt.model.vector_register_rows, vt.model.vector_register_row_len::usize);
        if (sel r_register_rows.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_register_rows.err};
        }
        entry.register_rows              = r_register_rows.ok;
        entry.model.vector_register_rows = entry.register_rows;
        val r_width_rows: res[*VectorWidthRow, fail.Fail] = own_copy[VectorWidthRow](?reg.alloc, vt.model.vector_width_rows, vt.model.vector_width_row_len::usize);
        if (sel r_width_rows.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_width_rows.err};
        }
        entry.width_rows              = r_width_rows.ok;
        entry.model.vector_width_rows = entry.width_rows;
        val r_ct_mul_forms: res[*ct.CtMulForm, fail.Fail] = own_copy[ct.CtMulForm](?reg.alloc, vt.model.ct_mul_forms, vt.model.ct_mul_form_len::usize);
        if (sel r_ct_mul_forms.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_ct_mul_forms.err};
        }
        entry.ct_mul_forms       = r_ct_mul_forms.ok;
        entry.model.ct_mul_forms = entry.ct_mul_forms;
        entry.descriptor.model   = ?entry.model;
    }
    if (vt.machine != nil) {
        entry.machine = @(vt.machine);
        val r_machine_reserved: res[*Register, fail.Fail] = own_copy[Register](?reg.alloc, vt.machine.reserved_regs, vt.machine.reserved_reg_count::usize);
        if (sel r_machine_reserved.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_machine_reserved.err};
        }
        entry.machine_reserved      = r_machine_reserved.ok;
        entry.machine.reserved_regs = entry.machine_reserved;
        val r_reload_scratch: res[*Register, fail.Fail] = own_copy[Register](?reg.alloc, vt.machine.reload_scratch_regs, vt.machine.reload_scratch_count::usize);
        if (sel r_reload_scratch.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_reload_scratch.err};
        }
        entry.reload_scratch              = r_reload_scratch.ok;
        entry.machine.reload_scratch_regs = entry.reload_scratch;
        entry.descriptor.machine          = ?entry.machine;
    }
    if (vt.emitter != nil) {
        entry.emitter            = @(vt.emitter);
        entry.descriptor.emitter = ?entry.emitter;
    }
    if (vt.reloc != nil) {
        entry.reloc            = @(vt.reloc);
        entry.descriptor.reloc = ?entry.reloc;
        if (entry.reloc.elf.has_attributes) {
            entry.reloc.elf.attributes.section = nil;
            entry.reloc.elf.attributes.vendor  = nil;
            val section_r: res[str, string.StrError] = str_copy(?reg.alloc, vt.reloc.elf.attributes.section);
            if (sel section_r.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(section_r.err)};
            }
            entry.reloc.elf.attributes.section = section_r.ok;
            val vendor_r: res[str, string.StrError] = str_copy(?reg.alloc, vt.reloc.elf.attributes.vendor);
            if (sel vendor_r.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(vendor_r.err)};
            }
            entry.reloc.elf.attributes.vendor = vendor_r.ok;
        }
    }
    if (vt.defs != nil) {
        entry.defs = @(vt.defs);
        val r_op_defs: res[*OpDef, fail.Fail] = own_space[OpDef](?reg.alloc, vt.defs.op_count::usize);
        if (sel r_op_defs.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_op_defs.err};
        }
        entry.op_defs = r_op_defs.ok;
        var oi: u32 = 0;
        for (oi < vt.defs.op_count) {
            entry.op_defs[oi].set  = nil;
            entry.op_defs[oi].name = nil;
            oi                     = oi + 1;
        }
        oi = 0;
        for (oi < vt.defs.op_count) {
            entry.op_defs[oi].set_tag         = vt.defs.ops[oi].set_tag;
            entry.op_defs[oi].opcode          = vt.defs.ops[oi].opcode;
            entry.op_defs[oi].arity           = vt.defs.ops[oi].arity;
            entry.op_defs[oi].min_arity       = vt.defs.ops[oi].min_arity;
            entry.op_defs[oi].spelled         = vt.defs.ops[oi].spelled;
            entry.op_defs[oi].result          = vt.defs.ops[oi].result;
            entry.op_defs[oi].result_space    = vt.defs.ops[oi].result_space;
            entry.op_defs[oi].kinds           = vt.defs.ops[oi].kinds;
            entry.op_defs[oi].capability      = vt.defs.ops[oi].capability;
            entry.op_defs[oi].requires        = vt.defs.ops[oi].requires;
            entry.op_defs[oi].enums           = vt.defs.ops[oi].enums;
            entry.op_defs[oi].typing          = vt.defs.ops[oi].typing;
            entry.op_defs[oi].relations       = vt.defs.ops[oi].relations;
            entry.op_defs[oi].result_relation = vt.defs.ops[oi].result_relation;
            entry.op_defs[oi].texel_count     = vt.defs.ops[oi].texel_count;
            val r_op_set: res[str, string.StrError] = str_copy(?reg.alloc, vt.defs.ops[oi].set);
            if (sel r_op_set.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(r_op_set.err)};
            }
            entry.op_defs[oi].set = r_op_set.ok;
            val r_op_name: res[str, string.StrError] = str_copy(?reg.alloc, vt.defs.ops[oi].name);
            if (sel r_op_name.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(r_op_name.err)};
            }
            entry.op_defs[oi].name = r_op_name.ok;
            oi                     = oi + 1;
        }
        entry.defs.ops = entry.op_defs;
        var operand_at: u32 = 0;
        var ti:         u32 = 0;
        for (ti < vt.defs.type_count) {
            operand_at = operand_at + vt.defs.types[ti].arity;
            ti         = ti + 1;
        }
        entry.type_operand_count = operand_at;
        val r_type_defs: res[*TypeDef, fail.Fail] = own_space[TypeDef](?reg.alloc, vt.defs.type_count::usize);
        if (sel r_type_defs.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_type_defs.err};
        }
        entry.type_defs = r_type_defs.ok;
        ti              = 0;
        for (ti < vt.defs.type_count) {
            entry.type_defs[ti].name = nil;
            ti                       = ti + 1;
        }
        ti = 0;
        for (ti < vt.defs.type_count) {
            entry.type_defs[ti].tag        = vt.defs.types[ti].tag;
            entry.type_defs[ti].operands   = nil;
            entry.type_defs[ti].arity      = vt.defs.types[ti].arity;
            entry.type_defs[ti].refuse     = vt.defs.types[ti].refuse;
            entry.type_defs[ti].bind       = vt.defs.types[ti].bind;
            entry.type_defs[ti].compose    = vt.defs.types[ti].compose;
            entry.type_defs[ti].sampled    = vt.defs.types[ti].sampled;
            entry.type_defs[ti].components = vt.defs.types[ti].components;
            entry.type_defs[ti].texels_of  = vt.defs.types[ti].texels_of;
            entry.type_defs[ti].address    = vt.defs.types[ti].address;
            val r_type_name: res[str, string.StrError] = str_copy(?reg.alloc, vt.defs.types[ti].name);
            if (sel r_type_name.err) {
                release_entry(reg, entry);
                ret err[fail.Fail].err{fail.str_refused(r_type_name.err)};
            }
            entry.type_defs[ti].name = r_type_name.ok;
            ti                       = ti + 1;
        }
        val r_type_operands: res[*u32, fail.Fail] = own_space[u32](?reg.alloc, entry.type_operand_count::usize);
        if (sel r_type_operands.err) {
            release_entry(reg, entry);
            ret err[fail.Fail].err{r_type_operands.err};
        }
        entry.type_operands = r_type_operands.ok;
        operand_at          = 0;
        ti                  = 0;
        for (ti < vt.defs.type_count) {
            if (vt.defs.types[ti].arity > 0) {
                entry.type_defs[ti].operands = ?entry.type_operands[operand_at];
                var ai: u32 = 0;
                for (ai < vt.defs.types[ti].arity) {
                    entry.type_operands[operand_at + ai] = vt.defs.types[ti].operands[ai];
                    ai                                   = ai + 1;
                }
                operand_at = operand_at + vt.defs.types[ti].arity;
            }
            or {
                entry.type_defs[ti].operands = nil;
            }
            ti = ti + 1;
        }
        entry.defs.types      = entry.type_defs;
        entry.descriptor.defs = ?entry.defs;
    }
    reg.count = reg.count + 1;
    ret err[fail.Fail].ok{};
}

pub fun lookup(reg: *IsaRegistry, name: str) opt[*IsaVTable] {
    if (reg == nil || reg.count > ISA_REGISTRY_CAP) { ret opt[*IsaVTable].none{}; }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].descriptor.name, name)) { ret opt[*IsaVTable].some{?reg.entries[i].descriptor}; }
        i = i + 1;
    }
    ret opt[*IsaVTable].none{};
}

pub fun registered_count(reg: *IsaRegistry) u32 {
    if (reg == nil || reg.count > ISA_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun registered(reg: *IsaRegistry, idx: u32) opt[*IsaVTable] {
    if (reg == nil || reg.count > ISA_REGISTRY_CAP || idx >= reg.count) { ret opt[*IsaVTable].none{}; }
    ret opt[*IsaVTable].some{?reg.entries[idx].descriptor};
}

pub fun has_codegen(vt: *IsaVTable) bool {
    ret vt.machine != nil || vt.emitter != nil;
}

pub fun emits_whole_module(vt: *IsaVTable) bool {
    ret vt.emitter != nil;
}

# whether source may carry `asm` blocks for this instruction set, whichever backend family it has
pub fun has_assembly(vt: *IsaVTable) bool {
    if (vt == nil)         { ret false; }
    if (vt.machine != nil) { ret vt.machine.has_assembly; }
    if (vt.emitter != nil) { ret vt.emitter.has_assembly; }
    ret false;
}

pub fun emits_relocations(vt: *IsaVTable) bool {
    ret vt.reloc != nil;
}

#[testing]
pub def BackendKind: u8;
#[testing]
pub val BACKEND_NATIVE:       BackendKind = 0;
#[testing]
pub val BACKEND_WHOLE_MODULE: BackendKind = 1;

#[testing]
pub rec BackendFamily {
    kind:   BackendKind;
    native: *RegMachine;
}

#[testing]
pub fun backend_family(vt: *IsaVTable) BackendFamily {
    var f: BackendFamily;
    if (vt.machine != nil && vt.emitter == nil) {
        f.kind   = BACKEND_NATIVE;
        f.native = vt.machine;
        ret f;
    }
    if (vt.emitter != nil && vt.machine == nil) {
        f.kind   = BACKEND_WHOLE_MODULE;
        f.native = nil;
        ret f;
    }
    panic("mach.lang.target.isa: backend_family called on an instruction set with a contradictory backend; register() should have refused this\n");
    ret f;
}

#[testing]
pub fun is_native(f: *BackendFamily) bool {
    ret f.kind == BACKEND_NATIVE;
}

#[testing]
pub fun is_whole_module(f: *BackendFamily) bool {
    ret f.kind == BACKEND_WHOLE_MODULE;
}

#[testing]
pub fun as_native(f: *BackendFamily) *RegMachine {
    if (f.kind != BACKEND_NATIVE) {
        panic("mach.lang.target.isa: as_native called on a non-native backend family\n");
    }
    ret f.native;
}

fun operand_blank(kind: OperandKind, size: u8) Operand {
    var op: Operand;
    op.kind       = kind;
    op.size       = size;
    op.reg        = -1;
    op.imm        = 0;
    op.base       = -1;
    op.index      = -1;
    op.scale      = 0;
    op.disp       = 0;
    op.sym_id     = 0;
    op.label      = nil;
    op.sym_mod    = SYM_MOD_NONE;
    op.sym_addend = 0;
    op.seg        = 0;
    ret op;
}

pub fun make_sym_mod(sym_id: u32, size: u8, mod: SymModifier) Operand {
    var op: Operand = make_sym(sym_id, size);
    op.sym_mod = mod;
    ret op;
}

pub fun make_sym_addend(sym_id: u32, size: u8, mod: SymModifier, addend: i64) Operand {
    var op: Operand = make_sym_mod(sym_id, size, mod);
    op.sym_addend = addend;
    ret op;
}

pub fun inst_blank() Inst {
    var mi: Inst;
    mi.opcode   = 0;
    mi.dst      = make_none();
    mi.src1     = make_none();
    mi.src2     = make_none();
    mi.src3     = make_none();
    mi.size     = 0;
    mi.flags    = 0;
    mi.src_line = 0;
    mi.src_file = nil;
    ret mi;
}

test float_absence_note__names_the_missing_extension_for_a_riscv_selection {
    if (!str_equals(float_absence_note("rv32imc"), "the selection lacks the F extension")) { ret 1; }
    if (!str_equals(float_absence_note("rv64i"), "the selection lacks the F extension"))   { ret 2; }
    if (!str_equals(float_absence_note("riscv32"), "the selection lacks the F extension")) { ret 3; }
    if (!str_equals(float_absence_note("rv32imafdc"), ""))                                 { ret 4; }
    if (!str_equals(float_absence_note("riscv64"), ""))                                    { ret 5; }
    if (!str_equals(float_absence_note("x86_64"), ""))                                     { ret 6; }
    if (!str_equals(float_absence_note("rv32iv"), ""))                                     { ret 7; }
    ret 0;
}

test arch_id_for__name_roundtrip {
    if (arch_id_for("x86_64") != ARCH_X86_64)   { ret 1; }
    if (arch_id_for("aarch64") != ARCH_AARCH64) { ret 1; }
    if (arch_id_for("riscv64") != ARCH_RISCV64) { ret 1; }
    if (arch_id_for("riscv32") != ARCH_RISCV32) { ret 1; }
    if (arch_id_for("mos6502") != ARCH_UNKNOWN) { ret 1; }
    if (arch_id_for("spirv") != ARCH_SPIRV)     { ret 1; }
    if (arch_id_for("riscv") != ARCH_UNKNOWN)   { ret 1; }
    if (ARCH_RISCV32 == ARCH_RISCV64)           { ret 1; }
    if (arch_id_for("rv32imc") != ARCH_RISCV32) { ret 2; }
    if (arch_id_for("rv64gc") != ARCH_RISCV64)  { ret 2; }
    if (arch_id_for("rv32e") != ARCH_UNKNOWN || arch_id_for("rv64iv") != ARCH_UNKNOWN
        || arch_id_for("rv128i") != ARCH_UNKNOWN) { ret 2; }

    if (!str_equals(arch_name_for(ARCH_X86_64), "x86_64"))             { ret 1; }
    if (!str_equals(arch_name_for(ARCH_AARCH64), "aarch64"))           { ret 1; }
    if (!str_equals(arch_name_for(ARCH_RISCV64), "riscv64"))           { ret 1; }
    if (!str_equals(arch_name_for(ARCH_RISCV32), "riscv32"))           { ret 1; }
    if (!str_equals(arch_name_for(arch.MOS6502_WITHDRAWN), "unknown")) { ret 1; }
    if (!str_equals(arch_name_for(ARCH_SPIRV), "spirv"))               { ret 1; }
    if (!str_equals(arch_name_for(ARCH_UNKNOWN), "unknown"))           { ret 1; }
    ret 0;
}

test arch_catalog__complete_unique_ordered_roundtrip {
    if (ARCHS[0].arch != ARCH_X86_64)  { ret 1; }
    if (ARCHS[1].arch != ARCH_AARCH64) { ret 1; }
    if (ARCHS[2].arch != ARCH_RISCV64) { ret 1; }
    if (ARCHS[3].arch != ARCH_SPIRV)   { ret 1; }
    if (ARCHS[4].arch != ARCH_RISCV32) { ret 1; }

    var i: usize = 0;
    for (i < ARCH_N) {
        if (ARCHS[i].fingerprint_tag != (i + 1)::u8)                      { ret 1; }
        if (arch_id_for(ARCHS[i].spelling) != ARCHS[i].arch)              { ret 1; }
        if (!str_equals(arch_name_for(ARCHS[i].arch), ARCHS[i].spelling)) { ret 1; }

        var j: usize = 0;
        for (j < ARCH_N) {
            if (i != j) {
                if (ARCHS[i].arch == ARCHS[j].arch)                       { ret 1; }
                if (str_equals(ARCHS[i].spelling, ARCHS[j].spelling))     { ret 1; }
                if (ARCHS[i].fingerprint_tag == ARCHS[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

