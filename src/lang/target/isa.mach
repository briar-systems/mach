pub val ISA_LABEL:       u16 = 0xFFFF;
pub val ISA_PCOPY:       u16 = 0xFFFD;
pub val ISA_PCOPY_FENCE: u16 = 0xFFFC;
pub val ISA_USE:         u16 = 0xFFFB;

def AsmClobbersFn: fun(str, *u32, *u32);

# whether an asm body may write the stack pointer; true for a body it cannot parse
def AsmWritesSpFn: fun(str) bool;

# the constant-time scan of an asm body: the tracked bindings (`ct.AsmSecret`, by the name
# their `{name}` operand spells), the target's multiply admission and shift trust
pub def AsmCtScanFn: fun(str, *ct.AsmSecret, u32, ct.CtMulMask, bool, *A.Allocator) err[ct.AsmRefusal];

def IsRegMoveFn: fun(u32) bool;

def IsTrapTerminatorFn: fun(u32) bool;
# whether the selected instruction reads operand `index` as a constant in
# place, as a constant-pool memory operand, at no instruction of its own: the
# rule the allocator folds a rebuilt constant into its reader by
def ReadsConstFn: fun(*lang_mir.MirInstr, u32) bool;

pub def DwarfRegFn: catalog_arch.DwarfRegFn;

pub def CvRegFn: catalog_arch.CvRegFn;

pub def RegFileFn: fun(*target_model.Register) i32;

def FrameDistFn: fun(*target_model.Machine, *lang_mir.MirFunction, *u32, *u32) err[fail.Fail];

rec BackendIdentity {
    arch_id:     u32;
    os_id:       u32;
    abi_id:      u32;
    of_id:       u32;
    debug_id:    u32;
    arch_name:   str;
    os_name:     str;
    abi_name:    str;
    of_name:     str;
    env_id:      u32;
    env_profile: u32;
    env_name:    str;
}

rec BackendAbi {
    gp_arg_regs:                RegFileFn;
    callee_saved:               RegFileFn;
    indirect_result_reg:        i32;
    indirect_result_in_argfile: bool;
    consumes_agg_layout:        bool;
    fp_callee_saved_bytes:      u32;
    float_arg_bits:             u32;
    arg_slot_granularity:       u32;
    variadic_args_on_stack:     bool;
    fixed_args_natural_size:    bool;
    reg_arg_align:              u32;
    reg_arg_extend:             u32;
    agg_arg_natural_align:      bool;
    va_list_size:               u32;
    va_list_align:              u32;
}

rec BackendOs {
    entry_symbol:     str;
    c_symbol_prefix:  str;
    image_base:       u64;
    page_size:        u64;
    stack_probe:      bool;
    mapped_by_loader: bool;
    stack_reserve:    u64;
    stack_commit:     u64;
}

pub rec BackendTarget {
    identity: BackendIdentity;
    model:    target_model.Machine;
    abi:      BackendAbi;
    os:       BackendOs;
    # the admitted constant-time multiply cells, from target.resolved.ct_mul_admitted
    ct_mul: ct.CtMulMask;
    # the instruction and type table the target registered, nil on one with none
    defs: *target_definition.Table;
}

def SelectFn: fun(*A.Allocator, *BackendTarget, *lang_mir.MirFunction) err[fail.Fail];

# writes what an assembly listing opens with, before its first function; nil
# where a listing opens with nothing
def AsmHeaderFn: fun(*io_writer.Writer) err[fail.Fail];

# a whole-module emitter fills the object image codegen initialized: its sections,
# symbols and relocations, in the same neutral kinds a native image carries, with
# section bytes allocated from the image's allocator. names are the emitter's own
def EmitModuleFn: fun(*A.Allocator, *BackendTarget, *mir_unit.Unit, *mir_debug.ModuleDebug, *target_of.ObjectImage) err[fail.Fail];

pub rec AssemblyCapabilities {
    header:    AsmHeaderFn;
    clobbers:  AsmClobbersFn;
    returns:   resolved.AsmReturnsFn;
    ct_scan:   AsmCtScanFn;
    writes_sp: AsmWritesSpFn;
}

# no register: the place a register fact holds when the instruction set has
# none for it
pub val REG_NONE: i32 = -1;

# a place in an operation the instruction set fixes to one register rather
# than leaving to the allocator
pub def FixedPlace: u8;

# the accumulator a divide, a remainder and a fixed-pair widening multiply
# read their first operand from and leave the quotient or low half in
pub val FIXED_PAIR_LO: FixedPlace = 0;
# where those operations leave the remainder or high half; declared together
# with FIXED_PAIR_LO
pub val FIXED_PAIR_HI: FixedPlace = 1;
# the register a variable shift reads its count from
pub val FIXED_SHIFT_COUNT: FixedPlace = 2;

pub val FIXED_PLACE_COUNT: u32 = 3;

# one fixed place and the register the instruction set fixes it to
pub rec FixedOperand {
    place: FixedPlace;
    reg:   i32;
}

pub rec RegMachine {
    select: SelectFn;
    # the hooks the shared encode driver runs this instruction set's encoder
    # through, static data the encoder declares
    encode:               *isa_encode.EncodeHooks;
    is_reg_move:          IsRegMoveFn;
    is_trap_terminator:   IsTrapTerminatorFn;
    reserved_regs:        *target_model.Register;
    reserved_reg_count:   i32;
    reload_scratch_regs:  *target_model.Register;
    reload_scratch_count: i32;
    scratch_reg:          i32;
    scratch_reg2:         i32;
    frame_ptr_reg:        i32;
    stack_ptr_reg:        i32;
    # the offset from the frame pointer to the first argument the caller
    # passed on the stack
    incoming_arg_base: i64;
    # the places the instruction set's own operations fix to a register, each
    # declared at most once; a place no row names is allocated like any operand
    fixed:     *FixedOperand;
    fixed_len: u32;

    has_assembly: bool;
    assembly:     AssemblyCapabilities;
    dwarf_reg:    DwarfRegFn;
    cv_reg:       CvRegFn;
    frame_dist:   FrameDistFn;
    # nil on an instruction set whose constants the middle end leaves in place
    int_imm_fits: resolved.IntImmFitsFn;
    # nil on an instruction set whose every reader of a rebuilt constant takes
    # it in a register
    reads_const: ReadsConstFn;
}

# the register `m` fixes `place` to, REG_NONE where it fixes none. a member
# with no register machine fixes nothing
pub fun fixed_reg(m: *RegMachine, place: FixedPlace) i32 {
    if (m == nil) { ret REG_NONE; }
    var i: u32 = 0;
    for (i < m.fixed_len) {
        if (m.fixed[i].place == place) { ret m.fixed[i].reg; }
        i = i + 1;
    }
    ret REG_NONE;
}

# whether `m` fixes the accumulator pair a divide and a fixed-pair widening
# multiply run on
pub fun has_fixed_pair(m: *RegMachine) bool {
    ret fixed_reg(m, FIXED_PAIR_LO) != REG_NONE && fixed_reg(m, FIXED_PAIR_HI) != REG_NONE;
}

# whether the body may move the stack pointer. the encoders write sp only in
# the prologue and epilogue, outgoing arguments live in the fixed frame, and no
# instruction set allocates stack dynamically, so the writers are an inline-asm
# block that writes sp and an instruction naming sp as a register operand
pub fun body_writes_sp(m: *RegMachine, func: *lang_mir.MirFunction, sp: lang_mir.PRegId) bool {
    var bi: u32 = 0;
    for (bi < func.block_count) {
        val blk: *lang_mir.MirBlock = ?func.blocks[bi];
        var ii:  u32                = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            if (lang_mir.runs_asm(mi)) {
                if (m == nil || !m.has_assembly)             { ret true; }
                if (m.assembly.writes_sp(mi.asm_block.body)) { ret true; }
            }
            var oi: u32 = 0;
            for (oi < mi.operand_count) {
                val o: *lang_mir.MirOperand = ?mi.operands[oi];
                if (o.kind == lang_mir.MIR_OP_PREG && lang_mir.preg_same(o.preg, sp)) { ret true; }
                oi = oi + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

pub rec ModuleEmitter {
    emit_module: EmitModuleFn;
    # whether `asm` blocks reach the emitter; without it they are refused in source
    has_assembly: bool;
}

pub def RelocSeam: target_of.RelocationCapabilities;

pub fun environment_lookup(vt: *IsaVTable, name: str) u32 {
    var i: u32 = 0;
    for (i < vt.env_count) {
        if (str_equals(vt.envs[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret ENV_NONE;
}

pub fun environment_profile(vt: *IsaVTable, env_id: u32) u32 {
    if (env_id == ENV_NONE || env_id >= vt.env_count) { ret ENV_NONE; }
    ret vt.envs[env_id].profile;
}

# the extensions the target's environment guarantees, which its selection holds
# beside the ones it names
pub fun environment_extensions(vt: *IsaVTable, env_id: u32) u64 {
    if (env_id == ENV_NONE)     { ret vt.env_open_exts; }
    if (env_id >= vt.env_count) { ret 0; }
    ret vt.envs[env_id].extensions;
}

# an execution environment an isa defines: its name, its profile, and the
# extensions of the isa's vocabulary it guarantees (spirv's `zero_init_workgroup`
# from vulkan1.3)
pub rec Environment {
    name:       str;
    profile:    u32;
    extensions: u64;
}

pub val ENV_NONE: u32 = 0xFFFFFFFF;

pub rec IsaVTable {
    id:            u32;
    name:          str;
    elf_machine:   u32;
    pointer_width: u32;
    # the hardware page: the granularity a loader maps a segment at when the
    # operating system declares no page of its own; 0 for an isa with no pages
    page_size: u64;
    reloc:     *RelocSeam;
    machine:   *RegMachine;
    emitter:   *ModuleEmitter;
    model:     *target_model.Machine;
    defs:      *target_definition.Table;
    envs:      *Environment;
    env_count: u32;
    # what a target naming no environment is granted of the vocabulary
    env_open_exts: u64;
}

pub fun declares_local_got(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.local_got_kind != nil;
}

pub fun local_got_kind(tgt_isa: *IsaVTable, kind: target_of.RelocKind) bool {
    if (!declares_local_got(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.local_got_kind(kind);
}

pub fun declares_branch_thunks(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.branch_reach != nil && tgt_isa.reloc.branch_thunk != nil;
}

# the reach of a direct branch a thunk can extend, none for any other kind or
# an instruction set that places no thunks
pub fun branch_reach(tgt_isa: *IsaVTable, kind: target_of.RelocKind) opt[target_of.BranchReach] {
    if (!declares_branch_thunks(tgt_isa)) { ret opt[target_of.BranchReach].none{}; }
    ret tgt_isa.reloc.branch_reach(kind);
}

pub fun declares_machine_flags(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.has_elf && tgt_isa.reloc.elf.machine_flags != nil;
}

pub fun machine_flags(tgt_isa: *IsaVTable, float_arg_bits: u32,
    has_compressed: bool) u32 {
    if (tgt_isa == nil)                                                   { ret 0; }
    if (!emits_relocations(tgt_isa))                                      { ret 0; }
    if (!tgt_isa.reloc.has_elf || tgt_isa.reloc.elf.machine_flags == nil) { ret 0; }
    ret tgt_isa.reloc.elf.machine_flags(float_arg_bits, has_compressed);
}

pub fun declares_attributes(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.has_elf && tgt_isa.reloc.elf.build_attributes != nil
        && tgt_isa.reloc.elf.merge_attributes != nil && tgt_isa.reloc.elf.validate_attributes != nil;
}

pub fun build_attributes(tgt_isa: *IsaVTable, model: *target_model.Machine, alloc: *A.Allocator, float_arg_bits: u32,
    has_compressed: bool, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!declares_attributes(tgt_isa)) { ret res[*u8, fail.Fail].ok{nil}; }
    if (model == nil)                  { ret res[*u8, fail.Fail].err{fail.message("riscv attributes: selected model is missing")}; }
    val r_855: res[*u8, fail.Fail] = tgt_isa.reloc.elf.build_attributes(alloc, model.gpr_width * 8, model.extensions,
        float_arg_bits, has_compressed, out_len);
    if (sel r_855.err) { ret res[*u8, fail.Fail].err{r_855.err}; }
    ret res[*u8, fail.Fail].ok{r_855.ok};
}

pub fun validate_attributes(tgt_isa: *IsaVTable, model: *target_model.Machine,
    bytes: *u8, len: u32, flags: u32) err[fail.Fail] {
    if (!declares_attributes(tgt_isa)) {
        if (len == 0) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.message("target has no selected attribute validation capability")};
    }
    if (model == nil || (len != 0 && bytes == nil)) {
        ret err[fail.Fail].err{fail.message("target has no selected attribute validation capability")};
    }
    val r_867: err[fail.Fail] = tgt_isa.reloc.elf.validate_attributes(bytes, len, model.gpr_width * 8, flags);
    if (sel r_867.err) { ret err[fail.Fail].err{r_867.err}; }
    ret err[fail.Fail].ok{};
}

pub fun merge_attributes(tgt_isa: *IsaVTable, alloc: *A.Allocator, acc: *u8, acc_len: u32,
    add: *u8, add_len: u32, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if (!declares_attributes(tgt_isa)) { ret res[*u8, fail.Fail].ok{nil}; }
    val r_874: res[*u8, fail.Fail] = tgt_isa.reloc.elf.merge_attributes(alloc, acc, acc_len, add, add_len, out_len);
    if (sel r_874.err) { ret res[*u8, fail.Fail].err{r_874.err}; }
    ret res[*u8, fail.Fail].ok{r_874.ok};
}

pub fun object_target(vt: *IsaVTable, out: *target_of.ObjectTarget) {
    out.arch_id       = vt.id;
    out.elf_machine   = vt.elf_machine;
    out.pointer_width = vt.pointer_width;
    out.relocation    = vt.reloc;
}

# why a descriptor is malformed, read once when a registry adds it; a refusal
# names the instruction set and the rule it breaks
# ---
# a:  formats the refusal
# vt: the descriptor
pub fun validate(a: *A.Allocator, vt: *IsaVTable) err[fail.Fail] {
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: a registry was handed a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: an instruction set declares an empty name")};
    }
    if (vt.id == catalog_arch.UNKNOWN) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares the unknown instruction-set id", vt.name)};
    }
    if (vt.model == nil || vt.pointer_width == 0 || vt.model.pointer_width != vt.pointer_width) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' has no model or its model pointer width does not match the descriptor", vt.name)};
    }
    if (vt.page_size != 0 && (vt.page_size & (vt.page_size - 1)) != 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a page size that is not a power of two", vt.name)};
    }
    val has_machine: bool = vt.machine != nil;
    val has_emitter: bool = vt.emitter != nil;
    if (has_machine == has_emitter) {
        var reason: str = "declares both a native and a whole-module backend";
        if (!has_machine) { reason = "declares neither a native nor a whole-module backend"; }
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' {} (exactly one native or whole-module backend is required)",
            vt.name, reason)};
    }
    if (has_machine) {
        val machine: err[fail.Fail] = machine_validate(a, vt);
        if (sel machine.err) { ret machine; }
    }
    if (has_emitter) {
        if (vt.emitter.emit_module == nil) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' has no `emit_module` callback", vt.name)};
        }
        if (vt.reloc != nil) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' emits whole modules but also declares a relocation seam; the two emission shapes are exclusive", vt.name)};
        }
    }
    val seam: err[fail.Fail] = reloc_validate(a, vt);
    if (sel seam.err) { ret seam; }
    val model: err[fail.Fail] = model_validate(a, vt);
    if (sel model.err) { ret model; }
    val envs: err[fail.Fail] = environments_validate(a, vt);
    if (sel envs.err) { ret envs; }
    ret defs_validate(a, vt);
}

fun machine_validate(a: *A.Allocator, vt: *IsaVTable) err[fail.Fail] {
    val m: *RegMachine = vt.machine;
    # the operand bank catalog every register machine selects against
    val banks: err[fail.Fail] = lang_mir.check_operand_banks();
    if (sel banks.err) { ret banks; }
    if (m.select == nil || m.encode == nil || m.encode.encode_function == nil || m.encode.patch_branch == nil
        || m.is_reg_move == nil || m.is_trap_terminator == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' is missing `select`, `encode`, `is_reg_move`, or `is_trap_terminator`", vt.name)};
    }
    if (m.reserved_reg_count < 0 || m.reload_scratch_count < 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a negative register count", vt.name)};
    }
    if ((m.reserved_reg_count > 0 && m.reserved_regs == nil)
        || (m.reload_scratch_count > 0 && m.reload_scratch_regs == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares register rows without storage", vt.name)};
    }
    if (m.fixed_len > 0 && m.fixed == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares register rows without storage", vt.name)};
    }
    var seen: u32 = 0;
    var fi:   u32 = 0;
    for (fi < m.fixed_len) {
        val row: *FixedOperand = ?m.fixed[fi];
        if (row.place::u32 >= FIXED_PLACE_COUNT || row.reg < 0 || (seen & (1::u32 << row.place::u32)) != 0) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' fixes an unknown place, a place twice, or a place to no register", vt.name)};
        }
        seen = seen | (1::u32 << row.place::u32);
        fi   = fi + 1;
    }
    if ((fixed_reg(m, FIXED_PAIR_LO) == REG_NONE) != (fixed_reg(m, FIXED_PAIR_HI) == REG_NONE)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' fixes one half of the accumulator pair without the other", vt.name)};
    }
    if (m.has_assembly
        && (m.assembly.clobbers == nil || m.assembly.returns == nil
        || m.assembly.ct_scan == nil || m.assembly.writes_sp == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares only part of its assembly capability group", vt.name)};
    }
    if (!m.has_assembly
        && (m.assembly.header != nil || m.assembly.clobbers != nil || m.assembly.returns != nil
        || m.assembly.ct_scan != nil || m.assembly.writes_sp != nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' carries assembly callbacks while declaring the group unsupported", vt.name)};
    }
    ret err[fail.Fail].ok{};
}

fun reloc_validate(a: *A.Allocator, vt: *IsaVTable) err[fail.Fail] {
    val s: *RelocSeam = vt.reloc;
    if (s == nil) {
        if (vt.elf_machine != 0) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares an ELF machine but no relocation seam", vt.name)};
        }
        ret err[fail.Fail].ok{};
    }
    if (s.apply == nil || s.traits == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a relocation seam missing `apply` or `traits`", vt.name)};
    }
    if (!s.has_elf
        && (s.elf.reloc_type != nil || s.elf.has_attributes || s.elf.machine_flags != nil
        || s.elf.build_attributes != nil || s.elf.merge_attributes != nil || s.elf.validate_attributes != nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' carries ELF relocation hooks while declaring no ELF group", vt.name)};
    }
    if (!s.elf.has_attributes
        && (s.elf.attributes.section != nil || s.elf.attributes.sht != 0 || s.elf.attributes.vendor != nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' names an attributes section while declaring none", vt.name)};
    }
    if (s.elf.has_attributes && (str_len(s.elf.attributes.section) == 0 || str_len(s.elf.attributes.vendor) == 0)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares an attributes section with an empty name or vendor", vt.name)};
    }
    if ((s.elf.build_attributes == nil) != (s.elf.merge_attributes == nil)
        || (s.elf.build_attributes == nil) != (s.elf.validate_attributes == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' does not declare the ELF attribute build, merge and validation hooks together", vt.name)};
    }
    if (vt.elf_machine != 0 && (!s.has_elf || s.elf.reloc_type == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares an ELF machine but its relocation seam has no ELF relocation mapper", vt.name)};
    }
    ret err[fail.Fail].ok{};
}

fun model_validate(a: *A.Allocator, vt: *IsaVTable) err[fail.Fail] {
    val m: *target_model.Machine = vt.model;
    # the passes that decide whether an integer fits one operation read it,
    # and a zero width reads as every integer being too wide
    if (target_model.max_alu_width(m) == 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares no `alu_widths`", vt.name)};
    }
    if ((m.reg_class_len > 0 && m.reg_classes == nil)
        || (m.packed_form_len > 0 && m.packed_forms == nil)
        || (m.scalar_form_len > 0 && m.scalar_forms == nil)
        || (m.half_form_len > 0 && m.half_forms == nil)
        || (m.vector_register_row_len > 0 && m.vector_register_rows == nil)
        || (m.vector_width_row_len > 0 && m.vector_width_rows == nil)
        || (m.ct_mul_form_len > 0 && m.ct_mul_forms == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a model table without storage", vt.name)};
    }
    if (!target_model.packed_forms_valid(m) || !target_model.scalar_forms_valid(m)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a packed or scalar vector form outside the retained vocabulary, twice, or in both tables", vt.name)};
    }
    if (!float.nan_rule_valid(m.nan_rule)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares no NaN conversion rule", vt.name)};
    }
    if (!target_model.half_forms_valid(m)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a scalar f16 form outside its vocabulary, twice, or gated on an extension it does not name", vt.name)};
    }
    if (!target_model.vector_register_rows_valid(m)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a vector register width that is not a power of two above its compute width, repeated, or gated on an extension it does not name", vt.name)};
    }
    if (!target_model.vector_width_rows_valid(m)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a vector compute width that is not a power of two above its baseline, names no lane it has, is wider than the register its extensions select, or is gated on an extension it does not name", vt.name)};
    }
    if (!target_model.vector_lanes_valid(m)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a vector lane count whose 64-bit lanes span more bits than a u32 holds", vt.name)};
    }
    if ((m.extension_count > 0 && m.extension_table == nil)
        || (m.extension_table != nil && !extension.table_valid(m.extension_table, m.extension_count))
        || (m.extensions & ~target_model.extension_domain(m)) != 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares an extension vocabulary with a repeated or non-identifier name, a bit that is not a single bit, or a selected bit it does not name", vt.name)};
    }
    if ((m.level_count > 0 && m.level_table == nil)
        || !extension.levels_valid(m.level_table, m.level_count, m.extension_table, m.extension_count)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a level that is not a hyphenated spelling, is also a row's name, names a member outside its vocabulary, or does not extend the level before it", vt.name)};
    }
    val mul_why: opt[str] = target_model.ct_mul_forms_refusal(m);
    if (sel mul_why.some) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' {}", vt.name, mul_why.some)};
    }
    if (!target_model.vector_domain_complete(m)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares neither a packed form nor the scalar expansion for some retained (operation, lane kind, lane width) cell", vt.name)};
    }
    var ci: u32 = 0;
    for (ci < m.reg_class_len) {
        if (str_len(m.reg_classes[ci].name) == 0) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares a register class with an empty name", vt.name)};
        }
        var cj: u32 = 0;
        for (cj < ci) {
            if (m.reg_classes[cj].kind == m.reg_classes[ci].kind
                || str_equals(m.reg_classes[cj].name, m.reg_classes[ci].name)) {
                ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares one register class twice", vt.name)};
            }
            cj = cj + 1;
        }
        ci = ci + 1;
    }
    ret err[fail.Fail].ok{};
}

fun environments_validate(a: *A.Allocator, vt: *IsaVTable) err[fail.Fail] {
    if (vt.env_count > 0 && vt.envs == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares environments without storage", vt.name)};
    }
    var ei: u32 = 0;
    for (ei < vt.env_count) {
        if (str_len(vt.envs[ei].name) == 0) {
            ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares an environment with an empty name", vt.name)};
        }
        var ej: u32 = 0;
        for (ej < ei) {
            if (str_equals(vt.envs[ej].name, vt.envs[ei].name)) {
                ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: instruction set '{}' declares one environment twice", vt.name)};
            }
            ej = ej + 1;
        }
        ei = ei + 1;
    }
    ret err[fail.Fail].ok{};
}

fun defs_validate(a: *A.Allocator, vt: *IsaVTable) err[fail.Fail] {
    val d: *target_definition.Table = vt.defs;
    if (d == nil) { ret err[fail.Fail].ok{}; }
    if ((d.op_count > 0 && d.ops == nil) || (d.type_count > 0 && d.types == nil)) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: target definitions omit their declared storage")};
    }
    var oi: u32 = 0;
    for (oi < d.op_count) {
        if (str_len(d.ops[oi].set) == 0 || str_len(d.ops[oi].name) == 0) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: operation definition declares an empty set or name")};
        }
        val shape: str = target_definition.op_shape_refusal(?d.ops[oi]);
        if (shape != nil) { ret err[fail.Fail].err{fail.message(shape)}; }
        var oj: u32 = 0;
        for (oj < oi) {
            if ((str_equals(d.ops[oj].set, d.ops[oi].set) && str_equals(d.ops[oj].name, d.ops[oi].name))
                || (d.ops[oj].set_tag == d.ops[oi].set_tag && d.ops[oj].opcode == d.ops[oi].opcode)) {
                ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: operation definition '{}' is declared twice", d.ops[oi].name)};
            }
            oj = oj + 1;
        }
        oi = oi + 1;
    }
    var ti: u32 = 0;
    for (ti < d.type_count) {
        if (str_len(d.types[ti].name) == 0) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: type definition declares an empty name")};
        }
        if (d.types[ti].arity > 0 && d.types[ti].operands == nil) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.isa: target type definition omits its operand storage")};
        }
        var tj: u32 = 0;
        for (tj < ti) {
            if (d.types[tj].tag == d.types[ti].tag || str_equals(d.types[tj].name, d.types[ti].name)) {
                ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.isa: type definition '{}' is declared twice", d.types[ti].name)};
            }
            tj = tj + 1;
        }
        ti = ti + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun name_of(vt: *IsaVTable) str {
    ret vt.name;
}

pub fun id_of(vt: *IsaVTable) u32 {
    ret vt.id;
}

pub fun has_codegen(vt: *IsaVTable) bool {
    ret vt.machine != nil || vt.emitter != nil;
}

pub fun emits_whole_module(vt: *IsaVTable) bool {
    ret vt.emitter != nil;
}

# whether source may carry `asm` blocks for this instruction set, whichever backend family it has
pub fun has_assembly(vt: *IsaVTable) bool {
    if (vt == nil)         { ret false; }
    if (vt.machine != nil) { ret vt.machine.has_assembly; }
    if (vt.emitter != nil) { ret vt.emitter.has_assembly; }
    ret false;
}

pub fun emits_relocations(vt: *IsaVTable) bool {
    ret vt.reloc != nil;
}

