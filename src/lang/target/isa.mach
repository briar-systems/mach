}

test register__rejects_contradictory_and_incomplete_backends {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }

    var neither_model: target_model.Machine = target_model.t_model(8);
    var neither:       IsaVTable            = isa_common(ARCH_AARCH64, "neither", 0, 8, ?neither_model);
    val r_2618:        err[fail.Fail]       = register(?reg, ?neither);
    if (!sel r_2618.err) { ret 1; }

    var m:          RegMachine           = t_machine();
    var both_model: target_model.Machine = target_model.t_model(8);
    var both:       IsaVTable            = isa_common(ARCH_RISCV64, "both", 0, 8, ?both_model);
    both.machine = ?m;
    var emitter: ModuleEmitter = module_emitter(t_emit_module, false);
    both.emitter = ?emitter;
    val r_2626: err[fail.Fail] = register(?reg, ?both);
    if (!sel r_2626.err) { ret 1; }

    var rs3:              RelocSeam            = t_reloc();
    var whole_model:      target_model.Machine = target_model.t_model(8);
    var whole_with_reloc: IsaVTable            = emitter_isa(T_ARCH_SYNTHETIC, "whole_with_reloc", 8, ?whole_model, ?emitter);
    whole_with_reloc.reloc = ?rs3;
    val r_2632: err[fail.Fail] = register(?reg, ?whole_with_reloc);
    if (!sel r_2632.err) { ret 1; }

    var incomplete_machine: RegMachine = t_machine();
    incomplete_machine.is_reg_move = nil;
    var incomplete_model: target_model.Machine = target_model.t_model(8);
    var incomplete:       IsaVTable            = machine_isa(ARCH_X86_64, "incomplete", 0, 8, ?incomplete_model, ?incomplete_machine, nil);
    val r_2638:           err[fail.Fail]       = register(?reg, ?incomplete);
    if (!sel r_2638.err) { ret 1; }

    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test register__rejects_elf_machine_with_incomplete_seam {
    var reg: IsaRegistry = registry_init();
