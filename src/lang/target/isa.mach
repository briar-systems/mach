test has_assembly__answers_for_both_backend_families {
    var m:   RegMachine = t_machine();
    var rs:  RelocSeam  = t_reloc();
    var mvt: IsaVTable  = t_vt(catalog_arch.X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (has_assembly(?mvt)) { ret 1; }
    m.has_assembly = true;
    m.assembly     = AssemblyCapabilities{header: t_asm_header, clobbers: t_asm_clobbers, returns: t_asm_returns, ct_scan: t_asm_ct_scan, writes_sp: t_asm_returns};
    if (!has_assembly(?mvt)) { ret 2; }

    var without: ModuleEmitter = ModuleEmitter{emit_module: t_emit_module, has_assembly: false};
    var evt:     IsaVTable     = t_evt(catalog_arch.SPIRV, "spirv", 8, nil, ?without);
    if (has_assembly(?evt)) { ret 3; }
    var with: ModuleEmitter = ModuleEmitter{emit_module: t_emit_module, has_assembly: true};
    evt.emitter = ?with;
    if (!has_assembly(?evt)) { ret 4; }
    ret 0;
}

