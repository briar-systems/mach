    types[0] = target_definition.type("empty", 1, nil, 0, nil);
    var definitions: target_definition.Table = target_definition.table(nil, 0, ?types[0], 1);
    var vt:          IsaVTable               = machine_isa(ARCH_X86_64, "zero_operands", 62, 8,
        ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);
    val r_2780: err[fail.Fail] = register(?reg, ?vt);
    if (sel r_2780.err) {
        registry_dnit(?reg);
        ret 1;
    }
    if (reg.entries[0].type_operands != nil || reg.entries[0].type_operand_count != 0
        || reg.entries[0].descriptor.defs.types[0].operands != nil) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    ret 0;
}

test registry__corrupt_public_count_is_bounded {
    var reg: IsaRegistry = registry_init();
    reg.count = ISA_REGISTRY_CAP + 1;
    if (registered_count(?reg) != 0) {
        registry_dnit(?reg);
        ret 1;
    }
    val r_2794: opt[*IsaVTable] = lookup(?reg, "x86_64");
    if (sel r_2794.some) {
        registry_dnit(?reg);
        ret 1;
    }
    val r_2795: opt[*IsaVTable] = registered(?reg, 0);
    if (sel r_2795.some) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    if (reg.count != 0) { ret 1; }
    ret 0;
}

test registry__partial_allocation_rolls_back {
    var backing: A.Allocator;
    val made:    err[A.Error] = page.make(?backing);
    if (sel made.err) { ret 1; }

    var classes: [1]target_model.RegClass;
    classes[0].name = "gp";
    classes[0].kind = target_model.RC_GENERAL;
    classes[0].len  = 4;
    var model_reserved: [1]target_model.Register;
    model_reserved[0].id   = 1;
    model_reserved[0].size = 8;
    var forms: [1]target_model.PackedForm;
    forms[0].op        = target_model.VEC_OP_MUL;
    forms[0].is_float  = false;
    forms[0].lane_bits = 32;
    forms[0].from_bits = 32;
    var scalar_len: u32                      = 0;
    val scalar:     *target_model.ScalarForm = t_scalar_rest(?backing, ?scalar_len, target_model.VEC_OP_MUL, false, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?backing, scalar); }
    var model: target_model.Machine = target_model.t_model(8);
    model.reg_classes     = ?classes[0];
    model.reg_class_len   = 1;
    model.reserved_regs   = ?model_reserved[0];
    model.reserved_len    = 1;
    model.has_v128        = true;
    model.vector_bits     = target_model.VECTOR_BITS_128;
    model.packed_forms    = ?forms[0];
    model.packed_form_len = 1;
    model.scalar_forms    = scalar;
    model.scalar_form_len = scalar_len;

    var machine_reserved: [1]target_model.Register;
    machine_reserved[0].id   = 2;
    machine_reserved[0].size = 8;
    var reload: [1]target_model.Register;
    reload[0].id   = 3;
    reload[0].size = 8;
    var machine: RegMachine = reg_machine(t_select, t_encode(), t_is_reg_move, t_is_trap_terminator,
        ?machine_reserved[0], 1, ?reload[0], 1,
        -1, -1, -1, -1, 0, -1, -1, -1);
    var reloc:    RelocSeam = t_reloc();
    var operands: [1]u32;
    operands[0] = target_definition.TYPE_OPERAND_WORD;
    var ops: [1]target_definition.Op;
    ops[0] = target_definition.op("core", "op", 1, 2, 1);
    var types: [1]target_definition.Type;
    types[0] = target_definition.type("ty", 7, ?operands[0], 1, nil);
    var definitions: target_definition.Table = target_definition.table(?ops[0], 1, ?types[0], 1);
    var vt:          IsaVTable               = machine_isa(ARCH_X86_64, "rollback", 62, 8,
        ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);

    var saw_failure: bool = false;
    var saw_success: bool = false;
    var ordinal:     u32  = 1;
    for (ordinal <= 64 && !saw_success) {
        var t:      T.Testing;
        val t_made: err[A.Error] = T.make(?t);
        if (sel t_made.err) { ret 1; }
        fin { T.dnit(?t); }
        T.fail_at_ordinal(?t, ordinal::usize);
        var reg: IsaRegistry    = registry_init_with_allocator(T.allocator_of(?t));
        val rr:  err[fail.Fail] = register(?reg, ?vt);
        if (sel rr.err) {
            saw_failure = true;
            if (registered_count(?reg) != 0 || T.live_count(?t) != 0) {
                registry_dnit(?reg);
                ret 1;
            }
        }
        if (sel rr.ok) {
            saw_success = true;
            if (registered_count(?reg) != 1 || T.live_count(?t) == 0) {
                registry_dnit(?reg);
                ret 1;
            }
        }
        registry_dnit(?reg);
        if (!T.clean(?t)) { ret 1; }
        ordinal = ordinal + 1;
    }
    if (!saw_failure || !saw_success) { ret 1; }
    ret 0;
}

test register__refuses_past_capacity {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var machines: [9]RegMachine;
    var relocs:   [9]RelocSeam;
    var models:   [9]target_model.Machine;
    var vts:      [9]IsaVTable;
    var names:    [9][2]u8;
    var i:        u32 = 0;
    for (i < ISA_REGISTRY_CAP) {
        machines[i] = t_machine();
        relocs[i]   = t_reloc();
        models[i]   = target_model.t_model(8);
        names[i][0] = 'a'::u8 + i::u8;
        names[i][1] = 0;
        vts[i]      = machine_isa(i + 1, (?names[i][0])::str, 0, 8, ?models[i], ?machines[i], ?relocs[i]);
        val r_2914: err[fail.Fail] = register(?reg, ?vts[i]);
        if (sel r_2914.err) { ret 1; }
        i = i + 1;
    }
    if (registered_count(?reg) != ISA_REGISTRY_CAP) { ret 1; }

    machines[8] = t_machine();
    relocs[8]   = t_reloc();
    models[8]   = target_model.t_model(8);
    vts[8]      = machine_isa(999, "overflow", 0, 8, ?models[8], ?machines[8], ?relocs[8]);
    val r_2923: err[fail.Fail] = register(?reg, ?vts[8]);
    if (!sel r_2923.err)                            { ret 1; }
    if (registered_count(?reg) != ISA_REGISTRY_CAP) { ret 1; }
    ret 0;
}
