#[testing]
fun t_model(width: u32) MachineModel {
    var model: MachineModel;
    model.pointer_width = width;
    var aw: u32 = 1;
    for (aw <= width) {
        gate_alu_width(?model, aw, 0);
        aw = aw << 1;
    }
    model.reg_classes       = nil;
    model.reg_class_len     = 0;
    model.reserved_regs     = nil;
    model.reserved_len      = 0;
    model.packed_forms      = nil;
    model.packed_form_len   = 0;
    model.scalar_forms      = nil;
    model.scalar_form_len   = 0;
    model.ct_mul_forms      = nil;
    model.ct_mul_form_len   = 0;
    model.extension_table   = ?rvfeatures.NAMES[0];
    model.extension_count   = rvfeatures.NAME_COUNT;
    model.nan_rule          = float.NAN_PRESERVE;
    model.nan_first_operand = false;
    ret model;
}

# every retained cell but the one packed row, as the scalar table a test model
# with a vector unit needs to register, in storage from `alloc` that holds the
# whole domain; nil when it cannot be had
#[testing]
fun t_scalar_rest(alloc: *A.Allocator, count: *u32, packed_op: VecOp, packed_float: bool, packed_bits: u32) *ScalarForm {
    val space: res[*ScalarForm, fail.Fail] = own_space[ScalarForm](alloc, vector_domain_len()::usize);
    if (sel space.err) { ret nil; }
    @count = t_scalar_fill(space.ok, packed_op, packed_float, packed_bits);
    ret space.ok;
}

# write every retained cell but the packed row's into `scalar`, which holds the
# whole domain; how many
#[testing]
fun t_scalar_fill(scalar: *ScalarForm, packed_op: VecOp, packed_float: bool, packed_bits: u32) u32 {
    var n:   u32 = 0;
    var i:   u32 = 0;
    val len: u32 = vector_domain_len();
    for (i < len) {
        var cell: ScalarForm;
        if (!vector_domain_cell(i, ?cell)) { ret n; }
        if (cell.op != packed_op || cell.is_float != packed_float || cell.lane_bits != packed_bits) {
            scalar[n] = cell;
            n         = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

#[testing]
fun t_scalar_free(alloc: *A.Allocator, scalar: *ScalarForm) {
    A.deallocate[ScalarForm](alloc, scalar, vector_domain_len()::usize);
}

