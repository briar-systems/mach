pub def VecOp: u32;
pub val VEC_OP_NONE: VecOp = 0;
pub val VEC_OP_ADD:  VecOp = 1;
pub val VEC_OP_SUB:  VecOp = 2;
pub val VEC_OP_MUL:  VecOp = 3;
pub val VEC_OP_DIV:  VecOp = 4;
pub val VEC_OP_AND:  VecOp = 5;
pub val VEC_OP_OR:   VecOp = 6;
pub val VEC_OP_XOR:  VecOp = 7;
pub val VEC_OP_NOT:  VecOp = 8;
pub val VEC_OP_NEG:  VecOp = 9;
pub val VEC_OP_SHL:  VecOp = 10;
pub val VEC_OP_SHR:  VecOp = 11;
pub val VEC_OP_CMP:  VecOp = 12;

pub rec PackedGap {
    op:        VecOp;
    is_float:  bool;
    lane_bits: u32;
}

pub val VECTOR_BITS_128: u32 = 128;

pub val VECTOR_LANES_UNBOUNDED: u32 = 0;

pub val VEC_MEM_NONE: u32 = 0;

pub val VEC_MEM_4_8_16:  u32 = 4 + 8 + 16;

pub val VEC_MEM_ALL_128: u32 = 1 + 2 + 4 + 8 + 16;

pub val XBANK_NONE: u32 = 0;

pub val XBANK_4: u32 = 4;

pub val XBANK_4_8: u32 = 4 + 8;

pub rec MachineModel {
    pointer_width: u32;
    gpr_width:     u32;

    # ordinary-memory unaligned gp widths, encoded as the sum of byte widths
    gp_unaligned_widths: u32;
    max_alu_width: u32;

    alu_min_width: u32;

    spill_width:   u32;
    endianness:    Endian;

    reg_classes:    *RegClass;
    reg_class_len:  u32;
    frame_ptr_reg:  i32;
    stack_ptr_reg:  i32;
    reserved_regs:  *Register;
    reserved_len:   i32;
    div_reg:         i32;
    div_hi_reg:      i32;
    shift_count_reg: i32;

    incoming_arg_base: i64;
    stack_align:       u32;
    red_zone:          u32;
    shadow_space:      u32;
    has_v128:          bool;
    vector_bits:       u32;
    max_vector_lanes:  u32;
    vector_compute_generic: bool;
    has_lane_ops:      bool;
    has_vec_build:     bool;

    vec_mem_widths:    u32;

    xbank_widths:      u32;

    ct_trust_mul:      bool;

    has_var_shift:     bool;

    has_mul: bool;

    has_float: bool;

    mul_hi_width: u32;

    flat_addressing: bool;

    ct_trust_var_shift: bool;

    packed_gaps:    *PackedGap;
    packed_gap_len: u32;

    flen_bits: u32;

    index_width:          u32;
    vector_op_bytes:      u32;
    vectors_in_registers: bool;
    auto_vectorize:       bool;
}

pub fun packed_width(m: *MachineModel, op: VecOp, is_float: bool, lane_bits: u32) u32 {
    if (!m.has_v128) { ret 0; }
    if (op == VEC_OP_NONE) { ret 0; }

    var i: u32 = 0;
    for (i < m.packed_gap_len) {
        val g: *PackedGap = ?m.packed_gaps[i];
        if (g.op == op && g.is_float == is_float && g.lane_bits == lane_bits) { ret 0; }
        i = i + 1;
    }

    ret packed_extent(m, lane_bits);
}

fun packed_extent(m: *MachineModel, lane_bits: u32) u32 {
    if (!m.has_v128) { ret 0; }
    if (lane_bits == 0) { ret 0; }
    val by_width: u32 = m.vector_bits;
    if (m.max_vector_lanes == VECTOR_LANES_UNBOUNDED) { ret by_width; }
    val by_count: u32 = m.max_vector_lanes * lane_bits;
    if (by_count < by_width) { ret by_count; }
    ret by_width;
}

pub fun packed_lane_cap(m: *MachineModel, lane_bits: u32) u32 {
    val w: u32 = packed_extent(m, lane_bits);
    if (w == 0) { ret 0; }
    ret w / lane_bits;
}

fun vec_mem_bit(bytes: u32) u32 {
    if (bytes == 1)  { ret 1; }
    if (bytes == 2)  { ret 2; }
    if (bytes == 4)  { ret 4; }
    if (bytes == 8)  { ret 8; }
    if (bytes == 16) { ret 16; }
    ret 0;
}

pub fun moves_unaligned_gp(m: *MachineModel, bytes: u32) bool {
    if (bytes == 0 || bytes > m.gpr_width || (bytes & (bytes - 1)) != 0) { ret false; }
    if (bytes == 1) { ret true; }
    ret (m.gp_unaligned_widths & bytes) != 0;
}

pub fun moves_vector_memory(m: *MachineModel, bytes: u32) bool {
    val b: u32 = vec_mem_bit(bytes);
    if (b == 0) { ret false; }
    ret (m.vec_mem_widths & b) != 0;
}

pub fun moves_cross_bank(m: *MachineModel, bytes: u32) bool {
    val b: u32 = vec_mem_bit(bytes);
    if (b == 0) { ret false; }
    ret (m.xbank_widths & b) != 0;
}

pub fun fits_vector_register(m: *MachineModel, lane_bits: u32, lanes: u32) bool {
    val w: u32 = packed_extent(m, lane_bits);
    if (w == 0) { ret false; }
    ret lanes * lane_bits <= w;
}

