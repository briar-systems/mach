test register__write_once_and_enumerate {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (registered_count(?reg) != 0) { ret 1; }

    var m:      RegMachine     = t_machine();
    var rs:     RelocSeam      = t_reloc();
    var model:  MachineModel   = t_model(8);
    var vt:     IsaVTable      = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model, ?m, ?rs);
    val r_2155: err[fail.Fail] = register(?reg, ?vt);
    if (sel r_2155.err) {
        registry_dnit(?reg);
        ret 1;
    }
    if (registered_count(?reg) != 1) {
        registry_dnit(?reg);
        ret 1;
    }

    val opt_vt: opt[*IsaVTable] = lookup(?reg, "x86_64");
    if (!sel opt_vt.some) {
        registry_dnit(?reg);
        ret 1;
    }
    val stored: *IsaVTable = opt_vt.some;
    if (stored == ?vt) {
        registry_dnit(?reg);
        ret 1;
    }
    if (stored.machine == ?m || stored.model == ?model || stored.reloc == ?rs) {
        registry_dnit(?reg);
        ret 1;
    }

    var m2:     RegMachine     = t_machine();
    var rs2:    RelocSeam      = t_reloc();
    var model2: MachineModel   = t_model(8);
    var vt2:    IsaVTable      = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model2, ?m2, ?rs2);
    val r_2171: err[fail.Fail] = register(?reg, ?vt2);
    if (!sel r_2171.err) {
        registry_dnit(?reg);
        ret 1;
    }
    val r_2172: opt[*IsaVTable] = lookup(?reg, "x86_64");
    if (sel r_2172.none) { ret 1; }
    if (r_2172.some != stored) {
        registry_dnit(?reg);
        ret 1;
    }

    val r_2174: opt[*IsaVTable] = lookup(?reg, "aarch64");
    if (sel r_2174.some) {
        registry_dnit(?reg);
        ret 1;
    }

    val r_2176: opt[*IsaVTable] = registered(?reg, 0);
    if (sel r_2176.none) { ret 1; }
    if (r_2176.some != stored) {
        registry_dnit(?reg);
        ret 1;
    }
    val r_2177: opt[*IsaVTable] = registered(?reg, 1);
    if (sel r_2177.some) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test family__payloads_are_exclusive {
    var m:   RegMachine = t_machine();
    var rs:  RelocSeam  = t_reloc();
    var mvt: IsaVTable  = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (mvt.machine != ?m)        { ret 1; }
    if (mvt.emitter != nil)       { ret 1; }
    if (emits_whole_module(?mvt)) { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module, false);
    var evt:     IsaVTable     = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    if (evt.emitter == nil)        { ret 1; }
    if (evt.machine != nil)        { ret 1; }
    if (!emits_whole_module(?evt)) { ret 1; }

    if (evt.elf_machine != 0)    { ret 1; }
    if (evt.reloc != nil)        { ret 1; }
    if (emits_relocations(?evt)) { ret 1; }

    if (mvt.reloc != ?rs)         { ret 1; }
    if (!emits_relocations(?mvt)) { ret 1; }
    ret 0;
}

test reloc_seam__required_then_optional {
    var s: RelocSeam = t_reloc();
    if (s.apply == nil)                { ret 1; }
    if (s.traits == nil)               { ret 1; }
    if (!s.has_elf)                    { ret 1; }
    if (s.elf.reloc_type == nil)       { ret 1; }
    if (s.elf.has_attributes)          { ret 1; }
    if (s.normalize != nil)            { ret 1; }
    if (s.resolve_operand != nil)      { ret 1; }
    if (s.elf.build_attributes != nil) { ret 1; }
    if (s.elf.merge_attributes != nil) { ret 1; }

    var elf_attributes: of.ElfAttributes;
    elf_attributes.section = ".attributes";
    elf_attributes.sht     = 1;
    elf_attributes.vendor  = "test";
    with_elf_attributes(?s, ?elf_attributes);
    if (!s.elf.has_attributes) { ret 1; }
    with_normalize_image(?s, t_normalize_image);
    if (s.normalize == nil) { ret 1; }
    with_attributes(?s, t_build_attributes, t_merge_attributes, t_validate_attributes);
    if (s.elf.build_attributes == nil)    { ret 1; }
    if (s.elf.merge_attributes == nil)    { ret 1; }
    if (s.elf.validate_attributes == nil) { ret 1; }

    var s2: RelocSeam = reloc_seam(t_apply_reloc, t_reloc_traits, nil);
    if (s2.apply == nil)  { ret 1; }
    if (s2.traits == nil) { ret 1; }
    if (s2.has_elf)       { ret 1; }
    ret 0;
}

test reg_machine__optionals_cleared_then_declared {
    var m: RegMachine = t_machine();
    if (m.has_assembly)              { ret 1; }
    if (m.assembly.clobbers != nil)  { ret 1; }
    if (m.assembly.ct_scan != nil)   { ret 1; }
    if (m.assembly.writes_sp != nil) { ret 1; }
    if (m.dwarf_reg != nil)          { ret 1; }
    if (m.cv_reg != nil)             { ret 1; }

    with_assembly(?m, t_emit_asm, t_asm_clobbers, t_asm_returns, t_asm_ct_scan, t_asm_returns);
    if (!m.has_assembly || m.assembly.emit == nil || m.assembly.clobbers == nil
        || m.assembly.returns == nil || m.assembly.ct_scan == nil || m.assembly.writes_sp == nil) { ret 1; }

    with_dwarf_regs(?m, t_dwarf_reg);
    if (m.dwarf_reg == nil)  { ret 1; }
    if (m.cv_reg != nil)     { ret 1; }
    if (m.dwarf_reg(3) != 3) { ret 1; }
    ret 0;
}

test has_assembly__answers_for_both_backend_families {
    var m:   RegMachine = t_machine();
    var rs:  RelocSeam  = t_reloc();
    var mvt: IsaVTable  = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (has_assembly(?mvt)) { ret 1; }
    with_assembly(?m, t_emit_asm, t_asm_clobbers, t_asm_returns, t_asm_ct_scan, t_asm_returns);
    if (!has_assembly(?mvt)) { ret 2; }

    var without: ModuleEmitter = module_emitter(t_emit_module, false);
    var evt:     IsaVTable     = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?without);
    if (has_assembly(?evt)) { ret 3; }
    var with: ModuleEmitter = module_emitter(t_emit_module, true);
    evt.emitter = ?with;
    if (!has_assembly(?evt)) { ret 4; }
    ret 0;
}

#[testing]
fun t_dwarf_reg(regid: i32) i32 {
    ret regid;
}

test has_codegen__per_family {
    var m:   RegMachine = t_machine();
    var rs:  RelocSeam  = t_reloc();
    var mvt: IsaVTable  = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (!has_codegen(?mvt)) { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module, false);
    var evt:     IsaVTable     = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    if (!has_codegen(?evt)) { ret 1; }

    var dvt: IsaVTable = machine_isa(T_ARCH_SYNTHETIC, "desc", 0, 2, nil, nil, nil);
    if (has_codegen(?dvt)) { ret 1; }
    ret 0;
}

test buf_append__growth {
    var alloc: A.Allocator;
    page.make(?alloc);

    var buf: InstBuf = buf_init(?alloc);
    if (buf.count != 0) {
        buf_dnit(?buf);
        ret 1;
    }
    if (buf.cap != 0) {
        buf_dnit(?buf);
        ret 1;
    }

    var inst: Inst = inst_blank();
    var i:    i32  = 0;
    for (i < INSTBUF_INIT_CAP + 1) {
        inst.opcode = i::u16;
        buf_append(?buf, inst);
        i = i + 1;
    }

    if (buf.err) {
        buf_dnit(?buf);
        ret 1;
    }
    if (buf.count != INSTBUF_INIT_CAP + 1) {
        buf_dnit(?buf);
        ret 1;
    }
    if (buf.cap < buf.count) {
        buf_dnit(?buf);
        ret 1;
    }
    if (buf.insts[0].opcode != 0) {
        buf_dnit(?buf);
        ret 1;
    }
    if (buf.insts[INSTBUF_INIT_CAP].opcode != INSTBUF_INIT_CAP::u16) {
        buf_dnit(?buf);
        ret 1;
    }

    buf_dnit(?buf);
    if (buf.count != 0) { ret 1; }
    if (buf.cap != 0)   { ret 1; }
    if (buf.err)        { ret 1; }
    ret 0;
}

test packed_width__gated_row_needs_every_selected_bit {
    var forms: [2]PackedForm;
    forms[0] = PackedForm{op: VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    forms[1] = PackedForm{op: VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32, ext: 0x3};
    var scalar: [1]ScalarForm;
    scalar[0] = ScalarForm{op: VEC_OP_MUL, is_float: false, lane_bits: 32, from_bits: 32};
    var m: MachineModel;
    m.has_v128         = true;
    m.vector_bits      = VECTOR_BITS_128;
    m.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    m.packed_forms     = ?forms[0];
    m.packed_form_len  = 2;
    m.scalar_forms     = ?scalar[0];
    m.scalar_form_len  = 1;
    m.extensions       = 0;

    # the baseline row answers whatever is selected; the gated row only with every bit
    if (packed_width(?m, VEC_OP_ADD, false, 32, 32) != 128)        { ret 1; }
    if (packed_width(?m, VEC_OP_MUL, false, 32, 32) != 0)          { ret 2; }
    if (vector_form(?m, VEC_OP_MUL, false, 32, 32) != FORM_SCALAR) { ret 3; }
    # the gated row names what would pack the cell, and a baseline one nothing
    if (packing_extension(?m, VEC_OP_MUL, false, 32, 32) != 0x3)    { ret 9; }
    if (packing_extension(?m, VEC_OP_ADD, false, 32, 32) != 0)      { ret 10; }
    if (packing_extension(?m, VEC_OP_MUL, false, 16, 16) != 0)      { ret 11; }
    if (packed_row_selected_by(?m, VEC_OP_MUL, false, 32, 32, 0x3)) { ret 12; }
    m.extensions = 0x1;
    if (packed_width(?m, VEC_OP_MUL, false, 32, 32) != 0)        { ret 4; }
    if (packing_extension(?m, VEC_OP_MUL, false, 32, 32) != 0x2) { ret 13; }
    m.extensions = 0x3;
    if (packed_width(?m, VEC_OP_MUL, false, 32, 32) != 128)          { ret 5; }
    if (vector_form(?m, VEC_OP_MUL, false, 32, 32) != FORM_PACKED)   { ret 6; }
    if (packing_extension(?m, VEC_OP_MUL, false, 32, 32) != 0)       { ret 14; }
    if (!packed_row_selected_by(?m, VEC_OP_MUL, false, 32, 32, 0x3)) { ret 15; }
    # the scalar row on the same cell is the baseline decision, not a twice
    m.extensions = 0;
    if (!scalar_forms_valid(?m)) { ret 7; }
    # the gated row's bits must be in the vocabulary; an empty vocabulary names none
    if (packed_forms_valid(?m)) { ret 8; }
    ret 0;
}

# a scalar f16 row names a cell with a 16-bit float on one side, once, gated on
# extensions the model names; the cell is native only while the selection holds them
test half_forms__validity_and_selection {
    var rows: [3]PackedForm;
    rows[0] = PackedForm{op: VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: 0};
    rows[1] = PackedForm{op: VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: rvfeatures.F};
    rows[2] = PackedForm{op: VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: 0};
    var m: MachineModel = t_model(8);
    m.half_forms    = ?rows[0];
    m.half_form_len = 3;
    m.extensions    = 0;
    if (!half_forms_valid(?m))                            { ret 1; }
    if (!half_native(?m, VEC_OP_ADD, true, 16, 16))       { ret 2; }
    if (half_native(?m, VEC_OP_FP_EXT, true, 32, 16))     { ret 3; }
    if (half_native(?m, VEC_OP_MUL, true, 16, 16))        { ret 4; }
    if (!half_native(?m, VEC_OP_FP_TO_SI, false, 32, 16)) { ret 5; }
    m.extensions = rvfeatures.F;
    if (!half_native(?m, VEC_OP_FP_EXT, true, 32, 16)) { ret 6; }
    # a cell with no 16-bit float side, or the same row twice, is refused
    rows[2] = PackedForm{op: VEC_OP_ADD, is_float: true, lane_bits: 32, from_bits: 32, ext: 0};
    if (half_forms_valid(?m)) { ret 7; }
    rows[2] = rows[0];
    if (half_forms_valid(?m)) { ret 8; }
    ret 0;
}

test packed_width__lane_count_ceiling {
    var forms: [4]PackedForm;
    forms[0] = PackedForm{op: VEC_OP_ADD, is_float: false, lane_bits: 8, from_bits: 8};
    forms[1] = PackedForm{op: VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    forms[2] = PackedForm{op: VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    forms[3] = PackedForm{op: VEC_OP_ADD, is_float: true, lane_bits: 64, from_bits: 64};
    var unbounded: MachineModel;
    unbounded.has_v128         = true;
    unbounded.vector_bits      = VECTOR_BITS_128;
    unbounded.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    unbounded.packed_forms     = ?forms[0];
    unbounded.packed_form_len  = 4;

    if (packed_width(?unbounded, VEC_OP_ADD, false, 8, 8) != 128)   { ret 1; }
    if (packed_width(?unbounded, VEC_OP_ADD, false, 16, 16) != 128) { ret 1; }
    if (packed_width(?unbounded, VEC_OP_ADD, false, 32, 32) != 128) { ret 1; }
    if (packed_width(?unbounded, VEC_OP_ADD, true, 64, 64) != 128)  { ret 1; }
    if (packed_lane_cap(?unbounded, false, 8) != 16)                { ret 1; }
    if (packed_lane_cap(?unbounded, false, 32) != 4)                { ret 1; }

    var capped: MachineModel;
    capped.has_v128         = true;
    capped.vector_bits      = VECTOR_BITS_128;
    capped.max_vector_lanes = 4;
    capped.packed_forms     = ?forms[0];
    capped.packed_form_len  = 4;

    if (packed_width(?capped, VEC_OP_ADD, false, 8, 8) != 32)    { ret 1; }
    if (packed_width(?capped, VEC_OP_ADD, false, 16, 16) != 64)  { ret 1; }
    if (packed_width(?capped, VEC_OP_ADD, false, 32, 32) != 128) { ret 1; }
    if (packed_width(?capped, VEC_OP_ADD, true, 64, 64) != 128)  { ret 1; }
    if (packed_lane_cap(?capped, false, 8) != 4)                 { ret 1; }
    if (packed_lane_cap(?capped, false, 16) != 4)                { ret 1; }
    if (packed_lane_cap(?capped, false, 32) != 4)                { ret 1; }
    if (packed_lane_cap(?capped, false, 64) != 2)                { ret 1; }

    var mul: [1]PackedForm;
    mul[0]                 = PackedForm{op: VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    capped.packed_forms    = ?mul[0];
    capped.packed_form_len = 1;
    if (packed_width(?capped, VEC_OP_MUL, false, 32, 32) != 0)  { ret 1; }
    if (packed_width(?capped, VEC_OP_MUL, true, 32, 32) != 128) { ret 1; }

    if (packed_width(?capped, VEC_OP_ADD, true, 32, 32) != 0) { ret 2; }
    if (packed_width(?capped, 999, false, 32, 32) != 0)       { ret 3; }
    if (packed_width(?capped, VEC_OP_MUL, true, 17, 17) != 0) { ret 4; }
    capped.packed_forms    = nil;
    capped.packed_form_len = 0;
    if (packed_width(?capped, VEC_OP_ADD, false, 32, 32) != 0) { ret 5; }
    if (packed_lane_cap(?capped, false, 32) != 4)              { ret 6; }

    var none: MachineModel;
    none.has_v128         = false;
    none.max_vector_lanes = 4;
    if (packed_width(?none, VEC_OP_ADD, false, 32, 32) != 0) { ret 1; }
    if (packed_lane_cap(?none, false, 32) != 0)              { ret 1; }
    ret 0;
}

test packed_width__honors_the_target_own_vector_width {
    var form: PackedForm = PackedForm{op: VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    var wide: MachineModel;
    wide.has_v128         = true;
    wide.vector_bits      = 256;
    wide.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    wide.packed_forms     = ?form;
    wide.packed_form_len  = 1;

    if (packed_width(?wide, VEC_OP_ADD, false, 32, 32) != 256) { ret 1; }
    if (packed_lane_cap(?wide, false, 32) != 8)                { ret 1; }
    if (packed_lane_cap(?wide, false, 64) != 4)                { ret 1; }
    if (fits_vector_register(?wide, false, 32, 0)
        || fits_vector_register(?wide, false, 32, 0x80000000)) { ret 2; }
    wide.max_vector_lanes = 0x80000000;
    if (packed_width(?wide, VEC_OP_ADD, false, 32, 32) != 256) { ret 3; }

    var narrow: MachineModel;
    narrow.has_v128         = true;
    narrow.vector_bits      = 64;
    narrow.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    narrow.packed_forms     = ?form;
    narrow.packed_form_len  = 1;

    if (packed_width(?narrow, VEC_OP_ADD, false, 32, 32) != 64) { ret 1; }
    if (packed_lane_cap(?narrow, false, 32) != 2)               { ret 1; }

    var unset: MachineModel;
    unset.has_v128         = true;
    unset.vector_bits      = 0;
    unset.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    unset.packed_forms     = ?form;
    unset.packed_form_len  = 1;

    if (packed_width(?unset, VEC_OP_ADD, false, 32, 32) != 0) { ret 1; }
    if (packed_lane_cap(?unset, false, 32) != 0)              { ret 1; }
    ret 0;
}

test register__rejects_nil_and_empty_name {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2406: err[fail.Fail] = register(nil, nil);
    if (!sel r_2406.err) { ret 1; }
    val r_2407: err[fail.Fail] = register(?reg, nil);
    if (!sel r_2407.err) { ret 1; }

    var m:      RegMachine     = t_machine();
    var rs:     RelocSeam      = t_reloc();
    var model:  MachineModel   = t_model(8);
    var vt:     IsaVTable      = machine_isa(ARCH_X86_64, "", 62, 8, ?model, ?m, ?rs);
    val r_2413: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2413.err) { ret 1; }
    vt = machine_isa(ARCH_UNKNOWN, "unknown", 0, 8, ?model, ?m, ?rs);
    val r_2415: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2415.err)             { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

# a malformed constant-time multiply row is refused at registration, and a
# lane row names why: vector rows are not defined yet
test register__rejects_malformed_ct_mul_rows {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var m:     RegMachine   = t_machine();
    var rs:    RelocSeam    = t_reloc();
    var model: MachineModel = t_model(8);
    model.has_mul = true;
    var rows: [2]ct.CtMulForm = [2]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 4, cond: ct.CT_MUL_ALWAYS, ext: 0}
    };
    model.ct_mul_forms    = ?rows[0];
    model.ct_mul_form_len = 2;
    var vt:   IsaVTable      = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model, ?m, ?rs);
    val lane: err[fail.Fail] = register(?reg, ?vt);
    if (!sel lane.err)                                                    { ret 1; }
    if (!string.str_contains(fail.describe(lane.err), "not defined yet")) { ret 2; }
    rows[1].lanes = 0;
    rows[1].cond  = ct.CT_MUL_EXTENSION;
    val bare_ext: err[fail.Fail] = register(?reg, ?vt);
    if (!sel bare_ext.err) { ret 3; }
    model.has_mul = false;
    rows[1].cond  = ct.CT_MUL_ALWAYS;
    val no_mul: err[fail.Fail] = register(?reg, ?vt);
    if (!sel no_mul.err)             { ret 4; }
    if (registered_count(?reg) != 0) { ret 5; }
    model.has_mul = true;
    val good: err[fail.Fail] = register(?reg, ?vt);
    if (!sel good.ok) { ret 6; }
    val mask: ct.CtMulMask = ct_mul_rows_admit(?model, false);
    if (!ct.mul_mask_has(mask, ct.mul_cell(ct.CT_MUL_LOW, 32, false))) { ret 7; }
    ret 0;
}

# each condition decides its rows: ALWAYS holds, DIT_MODE only when the
# caller guarantees the mode, EXTENSION only with every named extension
test ct_mul_rows_admit__decides_each_condition {
    var model: MachineModel = t_model(8);
    model.has_mul = true;
    var rows: [3]ct.CtMulForm = [3]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_SU, width: 64, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: rvfeatures.M | rvfeatures.A}
    };
    model.ct_mul_forms    = ?rows[0];
    model.ct_mul_form_len = 3;
    model.extensions      = rvfeatures.I | rvfeatures.M;
    val low:  ct.CtMulCell = ct.mul_cell(ct.CT_MUL_LOW, 64, false);
    val wide: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_WIDE_U, 64, false);
    val hsu:  ct.CtMulCell = ct.mul_cell(ct.CT_MUL_HIGH_SU, 64, false);
    val off:  ct.CtMulMask = ct_mul_rows_admit(?model, false);
    if (!ct.mul_mask_has(off, low) || ct.mul_mask_has(off, wide) || ct.mul_mask_has(off, hsu)) { ret 1; }
    val dit: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (!ct.mul_mask_has(dit, wide)) { ret 2; }
    model.extensions = rvfeatures.I | rvfeatures.M | rvfeatures.A;
    val ext: ct.CtMulMask = ct_mul_rows_admit(?model, false);
    if (!ct.mul_mask_has(ext, hsu)) { ret 3; }
    # a malformed table admits nothing
    rows[0].width = 12;
    val bad: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (bad.scalar != 0 || bad.vector != 0) { ret 4; }
    ret 0;
}

test ct_mul_rows_admit__realized_cells_follow_their_realization {
    var model: MachineModel = t_model(8);
    model.has_mul    = true;
    model.int_widths = INT_WIDTHS_1_2_4_8_16;
    var rows: [2]ct.CtMulForm = [2]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0}
    };
    model.ct_mul_forms    = ?rows[0];
    model.ct_mul_form_len = 2;
    val wide_u: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_WIDE_U, 64, false);
    val wide_s: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_WIDE_S, 64, false);
    val high_u: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_HIGH_U, 64, false);
    val low128: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_LOW, 128, false);

    # three-address: the full product is low + high, so the widening cell and the
    # 128-bit low half follow the high row, and the signed one is absent
    model.mul_wide_form = MULW_THREE_ADDRESS;
    val ta: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (!ct.mul_mask_has(ta, wide_u) || !ct.mul_mask_has(ta, low128) || ct.mul_mask_has(ta, wide_s)) { ret 1; }
    val ta_off: ct.CtMulMask = ct_mul_rows_admit(?model, false);
    if (ct.mul_mask_has(ta_off, wide_u) || ct.mul_mask_has(ta_off, low128)) { ret 2; }

    # fixed pair: the high cell follows the widening row, and a declared high
    # alone realizes no full product, so no 128-bit low half
    model.mul_wide_form = MULW_FIXED_PAIR;
    val fp_high_only: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (ct.mul_mask_has(fp_high_only, wide_u) || ct.mul_mask_has(fp_high_only, low128)) { ret 3; }
    rows[1].op = ct.CT_MUL_WIDE_U;
    val fp: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (!ct.mul_mask_has(fp, high_u) || !ct.mul_mask_has(fp, low128)) { ret 4; }

    # no widening form realizes nothing beyond the rows
    model.mul_wide_form = MULW_NONE;
    val none: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (ct.mul_mask_has(none, high_u) || ct.mul_mask_has(none, low128)) { ret 5; }

    # the 128-bit low half needs the width realized
    model.mul_wide_form = MULW_FIXED_PAIR;
    model.int_widths    = INT_WIDTHS_1_2_4_8;
    val narrow: ct.CtMulMask = ct_mul_rows_admit(?model, true);
    if (!ct.mul_mask_has(narrow, high_u) || ct.mul_mask_has(narrow, low128)) { ret 6; }

    # a realized cell needs a condition when a cell of its realization does:
    # the widening cell and 128-bit low half sit under the high row's DIT_MODE
    # (and under the low row's ALWAYS), and under no condition no row carries
    model.int_widths    = INT_WIDTHS_1_2_4_8_16;
    model.mul_wide_form = MULW_THREE_ADDRESS;
    rows[1].op          = ct.CT_MUL_HIGH_U;
    val under: ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_DIT_MODE);
    if (!ct.mul_mask_has(under, wide_u) || !ct.mul_mask_has(under, low128) || !ct.mul_mask_has(under, high_u)) { ret 7; }
    val under_always: ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_ALWAYS);
    if (!ct.mul_mask_has(under_always, wide_u) || ct.mul_mask_has(under_always, high_u)) { ret 8; }
    val under_ext: ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_EXTENSION);
    if (under_ext.scalar != 0 || under_ext.vector != 0) { ret 9; }
    ret 0;
}

# the rows under one condition, whether or not the condition is met
test ct_mul_rows_under__names_the_rows_of_one_condition {
    var model: MachineModel = t_model(8);
    model.has_mul = true;
    var rows: [3]ct.CtMulForm = [3]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_U, width: 64, lanes: 0, cond: ct.CT_MUL_DIT_MODE, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_HIGH_SU, width: 64, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: rvfeatures.M | rvfeatures.A}
    };
    model.ct_mul_forms    = ?rows[0];
    model.ct_mul_form_len = 3;
    model.extensions      = rvfeatures.I | rvfeatures.M;
    val low:  ct.CtMulCell = ct.mul_cell(ct.CT_MUL_LOW, 64, false);
    val wide: ct.CtMulCell = ct.mul_cell(ct.CT_MUL_WIDE_U, 64, false);
    val hsu:  ct.CtMulCell = ct.mul_cell(ct.CT_MUL_HIGH_SU, 64, false);
    val dit:  ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_DIT_MODE);
    if (!ct.mul_mask_has(dit, wide) || ct.mul_mask_has(dit, low) || ct.mul_mask_has(dit, hsu)) { ret 1; }
    val always: ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_ALWAYS);
    if (!ct.mul_mask_has(always, low) || ct.mul_mask_has(always, wide)) { ret 2; }
    val ext: ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_EXTENSION);
    if (!ct.mul_mask_has(ext, hsu) || ct.mul_mask_has(ext, wide)) { ret 3; }
    rows[0].width = 12;
    val bad: ct.CtMulMask = ct_mul_rows_under(?model, ct.CT_MUL_DIT_MODE);
    if (bad.scalar != 0 || bad.vector != 0) { ret 4; }
    ret 0;
}

test register__rejects_empty_nested_names {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var classes: [1]RegClass;
    classes[0].name = "";
    classes[0].kind = RC_GENERAL;
    classes[0].len  = 4;
    var model: MachineModel = t_model(8);
    model.reg_classes   = ?classes[0];
    model.reg_class_len = 1;
    var machine: RegMachine = t_machine();
    var reloc:   RelocSeam  = t_reloc();
    var vt:      IsaVTable  = machine_isa(ARCH_X86_64, "bad_class", 62, 8,
        ?model, ?machine, ?reloc);
    val r_2431: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2431.err) { ret 1; }

    classes[0].name = "gp";
    var ops: [1]OpDef;
    ops[0] = op_def("", "op", 1, 2, 0);
    var types: [1]TypeDef;
    types[0] = type_def("ty", 7, nil, 0, nil);
    var defs: TargetDefs = target_defs(?ops[0], 1, ?types[0], 1);
    vt = machine_isa(ARCH_X86_64, "bad_set", 62, 8, ?model, ?machine, ?reloc);
    with_defs(?vt, ?defs);
    val r_2439: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2439.err) { ret 1; }
    ops[0].set  = "core";
    ops[0].name = "";
    val r_2441: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2441.err) { ret 1; }
    # an operand kind outside the set, and a pointer result with no space, are malformed rows
    ops[0] = op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vx");
    val r_kind: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_kind.err) { ret 2; }
    ops[0] = op_def_shaped("core", "op", 1, 2, OP_RESULT_POINTER, NO_OP_SPACE, "r");
    val r_space: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_space.err) { ret 3; }
    # an optional tail no enumerated literal decides, and an enumeration on a value operand
    ops[0] = op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "lv|c");
    val r_tail: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_tail.err) { ret 4; }
    var values: [1]OpEnumerant = [1]OpEnumerant{OpEnumerant{value: 3, name: "three", capability: NO_OP_CAPABILITY, requires: 0, operands: "c"}};
    var e:      OpEnum         = OpEnum{name: "e", values: ?values[0], count: 1, mask: false};
    ops[0] = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "lv|c"), 1, ?e);
    val r_enum_kind: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_enum_kind.err) { ret 5; }
    ops[0]        = op_def("core", "op", 1, 2, 0);
    ops[0].name   = "op";
    types[0].name = "";
    val r_2443: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2443.err)             { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test register__rejects_ambiguous_nested_identities {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var classes: [2]RegClass;
    classes[0].name = "gp";
    classes[0].kind = RC_GENERAL;
    classes[0].len  = 4;
    classes[1].name = "fp";
    classes[1].kind = RC_GENERAL;
    classes[1].len  = 4;
    var model: MachineModel = t_model(8);
    model.reg_classes   = ?classes[0];
    model.reg_class_len = 2;
    var machine: RegMachine = t_machine();
    var reloc:   RelocSeam  = t_reloc();
    var vt:      IsaVTable  = machine_isa(ARCH_X86_64, "duplicate_class_kind", 62, 8,
        ?model, ?machine, ?reloc);
    val r_2460: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2460.err) { ret 1; }
    classes[1].kind = RC_FLOAT;
    classes[1].name = "gp";
    vt.name         = "duplicate_class_name";
    val r_2463: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2463.err) { ret 1; }

    classes[1].name = "fp";
    var ops: [2]OpDef;
    ops[0] = op_def("core", "add", 1, 1, 0);
    ops[1] = op_def("core", "add", 2, 2, 0);
    var types: [2]TypeDef;
    types[0] = type_def("word", 1, nil, 0, nil);
    types[1] = type_def("float", 2, nil, 0, nil);
    var defs: TargetDefs = target_defs(?ops[0], 2, ?types[0], 2);
    vt.name = "duplicate_op_name";
    with_defs(?vt, ?defs);
    val r_2474: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2474.err) { ret 1; }
    ops[1]  = op_def("ext", "sub", 1, 1, 0);
    vt.name = "duplicate_opcode";
    val r_2477: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2477.err) { ret 1; }
    ops[1]        = op_def("ext", "sub", 2, 2, 0);
    types[1].name = "word";
    vt.name       = "duplicate_type_name";
    val r_2480: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2480.err) { ret 1; }
    types[1].name = "float";
    types[1].tag  = 1;
    vt.name       = "duplicate_type_tag";
    val r_2482: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2482.err) { ret 1; }
    types[1].tag      = 2;
    model.has_v128    = true;
    model.vector_bits = VECTOR_BITS_128;
    var forms: [2]PackedForm;
    forms[0]              = PackedForm{op: VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    forms[1]              = forms[0];
    model.packed_forms    = ?forms[0];
    model.packed_form_len = 2;
    vt.name               = "duplicate_packed_form";
    val r_2491: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2491.err) { ret 2; }
    model.packed_form_len = 1;
    forms[0].op           = 999;
    val r_2494: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2494.err)                               { ret 3; }
    if (packed_width(?model, 999, false, 32, 32) != 0) { ret 4; }
    forms[0].op        = VEC_OP_ADD;
    forms[0].lane_bits = 17;
    forms[0].from_bits = 17;
    val r_2497: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2497.err) { ret 5; }
    forms[0].lane_bits = 8;
    forms[0].from_bits = 8;
    forms[0].is_float  = true;
    val r_2499: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2499.err) { ret 6; }
    forms[0].lane_bits = 32;
    forms[0].from_bits = 32;
    forms[0].op        = VEC_OP_AND;
    val r_2501: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2501.err) { ret 7; }
    forms[0].op       = VEC_OP_NEG;
    forms[0].is_float = false;
    val r_2503: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2503.err) { ret 8; }
    forms[0].op        = VEC_OP_ADD;
    forms[0].from_bits = 16;
    vt.name            = "lane_changing_add";
    val r_2505: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2505.err) { ret 18; }
    forms[0].from_bits = 32;
    vt.name            = "incomplete_domain";
    val r_2506: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2506.err) { ret 9; }
    var scalar_len: u32         = 0;
    val scalar:     *ScalarForm = t_scalar_rest(?reg.alloc, ?scalar_len, VEC_OP_ADD, false, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?reg.alloc, scalar); }
    if (scalar_len + 1 != vector_domain_len()) { ret 10; }
    model.scalar_forms    = scalar;
    model.scalar_form_len = scalar_len;
    scalar[0]             = ScalarForm{op: VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    vt.name               = "scalar_row_also_packed";
    val r_2513: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2513.err) { ret 11; }
    scalar[0] = scalar[1];
    vt.name   = "duplicate_scalar_row";
    val r_2516: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2516.err) { ret 12; }
    scalar[0] = ScalarForm{op: VEC_OP_SHL_U, is_float: true, lane_bits: 32, from_bits: 32};
    vt.name   = "scalar_row_outside_vocabulary";
    val r_2519: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2519.err) { ret 13; }
    model.scalar_form_len = t_scalar_fill(scalar, VEC_OP_ADD, false, 32);
    model.has_v128        = false;
    vt.name               = "no_unit_with_rows";
    val r_2523: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2523.err) { ret 14; }
    model.has_v128 = true;
    if (registered_count(?reg) != 0) { ret 1; }
    vt.name = "complete_domain";
    val r_2527: err[fail.Fail] = register(?reg, ?vt);
    if (sel r_2527.err)              { ret 15; }
    if (registered_count(?reg) != 1) { ret 16; }
    ret 0;
}

test declare_scalar_rows__declares_every_conversion_the_packed_table_leaves {
    var m: MachineModel = t_model(8);
    m.has_v128         = true;
    m.vector_bits      = VECTOR_BITS_128;
    m.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val all: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, SCALAR_CONVERSIONS);
    if (sel all.err || m.scalar_form_len != CONVERT_CELL_COUNT) { ret 1; }
    fin { release_scalar_rows(?reg, ?m); }
    var rows: *ScalarForm = m.scalar_forms;
    var i:    u32         = 0;
    for (i < CONVERT_CELL_COUNT) {
        if (!is_convert_op(rows[i].op) || is_widen_op(rows[i].op)) { ret 2; }
        i = i + 1;
    }
    var packed: [1]PackedForm;
    packed[0]         = PackedForm{op: VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    m.packed_forms    = ?packed[0];
    m.packed_form_len = 1;
    release_scalar_rows(?reg, ?m);
    val rest: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, SCALAR_CONVERSIONS);
    if (sel rest.err) { ret 3; }
    val left: u32 = m.scalar_form_len;
    rows = m.scalar_forms;
    if (left != CONVERT_CELL_COUNT - 1) { ret 3; }
    i = 0;
    for (i < left) {
        if (rows[i].op == VEC_OP_SEXT && rows[i].lane_bits == 32 && rows[i].from_bits == 16) { ret 4; }
        i = i + 1;
    }
    # a conversion's extent is its wider side
    if (packed_width(?m, VEC_OP_SEXT, false, 32, 16) != 128)                                           { ret 5; }
    if (packed_form_valid(VEC_OP_SEXT, false, 32, 32) || packed_form_valid(VEC_OP_ADD, false, 32, 16)) { ret 6; }
    ret 0;
}

test declare_scalar_rows__declares_every_widening_multiply_the_packed_table_leaves {
    var m: MachineModel = t_model(8);
    m.has_v128         = true;
    m.vector_bits      = VECTOR_BITS_128;
    m.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val all: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, SCALAR_WIDENING);
    if (sel all.err || m.scalar_form_len != WIDEN_CELL_COUNT) { ret 1; }
    fin { release_scalar_rows(?reg, ?m); }
    var rows: *ScalarForm = m.scalar_forms;
    var i:    u32         = 0;
    for (i < WIDEN_CELL_COUNT) {
        if (!is_widening_cell(?rows[i]) || is_convert_op(rows[i].op)) { ret 2; }
        if (is_mul_high_op(rows[i].op) || is_sign_mask_op(rows[i].op)) {
            if (rows[i].lane_bits != rows[i].from_bits) { ret 2; }
        }
        or (is_widen_sum_op(rows[i].op)) {
            if (rows[i].lane_bits <= rows[i].from_bits) { ret 2; }
        }
        or (rows[i].lane_bits != rows[i].from_bits * 2) { ret 2; }
        i = i + 1;
    }
    var packed: [1]PackedForm;
    packed[0]         = PackedForm{op: VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 32, from_bits: 16};
    m.packed_forms    = ?packed[0];
    m.packed_form_len = 1;
    release_scalar_rows(?reg, ?m);
    val rest: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, SCALAR_WIDENING);
    if (sel rest.err) { ret 3; }
    val left: u32 = m.scalar_form_len;
    rows = m.scalar_forms;
    if (left != WIDEN_CELL_COUNT - 1) { ret 3; }
    i = 0;
    for (i < left) {
        if (rows[i].op == VEC_OP_MUL_WIDE_U && rows[i].lane_bits == 32) { ret 4; }
        i = i + 1;
    }
    # the result lanes are the wider side, and the signed cell is its own
    if (packed_width(?m, VEC_OP_MUL_WIDE_U, false, 32, 16) != 128) { ret 5; }
    if (packed_width(?m, VEC_OP_MUL_WIDE_S, false, 32, 16) != 0)   { ret 6; }
    if (packed_form_valid(VEC_OP_MUL_WIDE_S, false, 32, 8)
        || packed_form_valid(VEC_OP_MUL_WIDE_S, false, 16, 16)
        || packed_form_valid(VEC_OP_MUL_WIDE_U, true, 64, 32)
        || packed_form_valid(VEC_OP_MUL_WIDE_U, false, 128, 64)) { ret 7; }
    ret 0;
}

test declare_scalar_rows__declares_every_shift_the_packed_table_leaves {
    var m: MachineModel = t_model(8);
    m.has_v128         = true;
    m.vector_bits      = VECTOR_BITS_128;
    m.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val all: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, SCALAR_SHIFTS);
    if (sel all.err || m.scalar_form_len != SHIFT_CELL_COUNT) { ret 1; }
    fin { release_scalar_rows(?reg, ?m); }
    var rows: *ScalarForm = m.scalar_forms;
    var i:    u32         = 0;
    for (i < SHIFT_CELL_COUNT) {
        if (!is_shift_op(rows[i].op) || rows[i].is_float || rows[i].lane_bits != rows[i].from_bits) { ret 2; }
        i = i + 1;
    }
    var packed: [1]PackedForm;
    packed[0]         = PackedForm{op: VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    m.packed_forms    = ?packed[0];
    m.packed_form_len = 1;
    release_scalar_rows(?reg, ?m);
    val rest: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, SCALAR_SHIFTS);
    if (sel rest.err) { ret 3; }
    val left: u32 = m.scalar_form_len;
    rows = m.scalar_forms;
    if (left != SHIFT_CELL_COUNT - 1) { ret 3; }
    i = 0;
    for (i < left) {
        if (rows[i].op == VEC_OP_SHR_S_U && rows[i].lane_bits == 16) { ret 4; }
        i = i + 1;
    }
    # the count's form and the direction's signedness are each their own cell,
    # and a shift has no float lanes
    if (packed_width(?m, VEC_OP_SHR_S_U, false, 16, 16) != 128) { ret 5; }
    if (packed_width(?m, VEC_OP_SHR_S_V, false, 16, 16) != 0
        || packed_width(?m, VEC_OP_SHR_U_U, false, 16, 16) != 0) { ret 6; }
    if (packed_form_valid(VEC_OP_SHL_U, true, 32, 32)
        || packed_form_valid(VEC_OP_SHL_V, false, 32, 16)
        || packed_form_valid(VEC_OP_SHR_U_U, false, 128, 128)) { ret 7; }
    ret 0;
}

test vector_form__every_retained_cell_has_one_declared_outcome {
    # 51 lane-keeping cells, 72 conversions, 6 widening multiplies, 6
    # lane-halving extensions, 24 shifts, 7 lane ranges, 7 lane joins, 8 high
    # multiplies, 3 lane interleaves, 6 widening group sums and 4 sign masks
    if (vector_domain_len() != 194) { ret 1; }
    var cell: ScalarForm;
    if (!vector_domain_cell(0, ?cell)
        || cell.op != VEC_OP_ADD || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 2; }
    if (!vector_domain_cell(50, ?cell)
        || cell.op != VEC_OP_CMP || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 3; }
    if (!vector_domain_cell(51, ?cell)
        || cell.op != VEC_OP_TRUNC || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 16) { ret 18; }
    if (!vector_domain_cell(122, ?cell)
        || cell.op != VEC_OP_UI_TO_FP || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 19; }
    if (!vector_domain_cell(123, ?cell)
        || cell.op != VEC_OP_MUL_WIDE_S || cell.is_float || cell.lane_bits != 16 || cell.from_bits != 8) { ret 21; }
    if (!vector_domain_cell(128, ?cell)
        || cell.op != VEC_OP_MUL_WIDE_U || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 22; }
    if (!vector_domain_cell(129, ?cell)
        || cell.op != VEC_OP_WIDEN_S || cell.is_float || cell.lane_bits != 16 || cell.from_bits != 8) { ret 23; }
    if (!vector_domain_cell(134, ?cell)
        || cell.op != VEC_OP_WIDEN_U || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 24; }
    if (!vector_domain_cell(135, ?cell)
        || cell.op != VEC_OP_SHL_U || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 25; }
    if (!vector_domain_cell(158, ?cell)
        || cell.op != VEC_OP_SHR_S_V || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 26; }
    if (!vector_domain_cell(159, ?cell)
        || cell.op != VEC_OP_RANGE || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 27; }
    if (!vector_domain_cell(165, ?cell)
        || cell.op != VEC_OP_RANGE || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 28; }
    if (!vector_domain_cell(172, ?cell)
        || cell.op != VEC_OP_CONCAT || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 29; }
    if (!vector_domain_cell(46, ?cell)
        || cell.op != VEC_OP_CMP || !cell.is_float || cell.lane_bits != 16 || cell.from_bits != 16) { ret 30; }
    if (!vector_domain_cell(69, ?cell)
        || cell.op != VEC_OP_FP_TRUNC || !cell.is_float || cell.lane_bits != 16 || cell.from_bits != 32) { ret 31; }
    if (!vector_domain_cell(173, ?cell)
        || cell.op != VEC_OP_MUL_HIGH_S || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 32; }
    if (!vector_domain_cell(183, ?cell)
        || cell.op != VEC_OP_INTERLEAVE || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 33; }
    if (!vector_domain_cell(184, ?cell)
        || cell.op != VEC_OP_WIDEN_SUM_U || cell.is_float || cell.lane_bits != 16 || cell.from_bits != 8) { ret 34; }
    if (!vector_domain_cell(189, ?cell)
        || cell.op != VEC_OP_WIDEN_SUM_U || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 35; }
    if (!vector_domain_cell(190, ?cell)
        || cell.op != VEC_OP_SIGN_MASK || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 36; }
    if (!vector_domain_cell(193, ?cell)
        || cell.op != VEC_OP_SIGN_MASK || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 37; }
    if (vector_domain_cell(194, ?cell)) { ret 4; }

    var packed: [1]PackedForm;
    packed[0] = PackedForm{op: VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    var rest_alloc: A.Allocator;
    val rest_made:  err[A.Error] = page.make(?rest_alloc);
    if (sel rest_made.err) { ret 90; }
    var scalar_len: u32         = 0;
    val scalar:     *ScalarForm = t_scalar_rest(?rest_alloc, ?scalar_len, VEC_OP_MUL, true, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?rest_alloc, scalar); }
    var m: MachineModel = t_model(8);
    m.has_v128         = true;
    m.vector_bits      = VECTOR_BITS_128;
    m.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    m.packed_forms     = ?packed[0];
    m.packed_form_len  = 1;
    m.scalar_forms     = scalar;
    m.scalar_form_len  = scalar_len;
    if (!vector_domain_complete(?m))                               { ret 5; }
    if (vector_form(?m, VEC_OP_MUL, true, 32, 32) != FORM_PACKED)  { ret 6; }
    if (vector_form(?m, VEC_OP_MUL, false, 32, 32) != FORM_SCALAR) { ret 7; }
    if (vector_form(?m, VEC_OP_DIV, false, 8, 8) != FORM_SCALAR)   { ret 8; }
    if (vector_form(?m, VEC_OP_SHL_U, true, 32, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_NEG, true, 32, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_AND, true, 32, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_ADD, false, 128, 128) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_ADD, true, 8, 8) != FORM_UNDECLARED
        || vector_form(?m, 999, false, 32, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_ADD, false, 32, 16) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_SEXT, false, 16, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_TRUNC, false, 16, 16) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_FP_TO_SI, true, 32, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_FP_EXT, true, 64, 64) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_MUL_WIDE_S, false, 32, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_MUL_WIDE_U, false, 64, 16) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_MUL_WIDE_S, true, 64, 32) != FORM_UNDECLARED
        || vector_form(?m, VEC_OP_MUL_WIDE_U, false, 128, 64) != FORM_UNDECLARED) { ret 9; }
    if (vector_form(?m, VEC_OP_SEXT, false, 32, 16) != FORM_SCALAR
        || vector_form(?m, VEC_OP_UI_TO_FP, true, 32, 8) != FORM_SCALAR
        || vector_form(?m, VEC_OP_MUL_WIDE_S, false, 32, 16) != FORM_SCALAR) { ret 20; }

    m.scalar_form_len = scalar_len - 1;
    if (vector_domain_complete(?m)) { ret 10; }
    if (vector_form(?m, scalar[scalar_len - 1].op, scalar[scalar_len - 1].is_float,
        scalar[scalar_len - 1].lane_bits, scalar[scalar_len - 1].from_bits) != FORM_UNDECLARED) { ret 11; }
    m.scalar_forms    = nil;
    m.scalar_form_len = 0;
    if (vector_domain_complete(?m))                                    { ret 12; }
    if (vector_form(?m, VEC_OP_ADD, false, 32, 32) != FORM_UNDECLARED) { ret 13; }

    var none: MachineModel = t_model(8);
    none.has_v128 = false;
    if (!vector_domain_complete(?none)) { ret 14; }
    if (vector_form(?none, VEC_OP_ADD, false, 32, 32) != FORM_SCALAR
        || vector_form(?none, VEC_OP_DIV, true, 64, 64) != FORM_SCALAR) { ret 15; }
    if (vector_form(?none, VEC_OP_SHL_U, true, 32, 32) != FORM_UNDECLARED) { ret 16; }
    none.packed_forms    = ?packed[0];
    none.packed_form_len = 1;
    if (vector_domain_complete(?none)) { ret 17; }
    ret 0;
}

test register__rejects_duplicate_id_under_a_different_name {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var m1:     RegMachine     = t_machine();
    var rs1:    RelocSeam      = t_reloc();
    var model1: MachineModel   = t_model(8);
    var vt1:    IsaVTable      = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model1, ?m1, ?rs1);
    val r_2588: err[fail.Fail] = register(?reg, ?vt1);
    if (sel r_2588.err) { ret 1; }

    var m2:     RegMachine     = t_machine();
    var rs2:    RelocSeam      = t_reloc();
    var model2: MachineModel   = t_model(8);
    var vt2:    IsaVTable      = machine_isa(ARCH_X86_64, "x86_64_alias", 62, 8, ?model2, ?m2, ?rs2);
    val r_2594: err[fail.Fail] = register(?reg, ?vt2);
    if (!sel r_2594.err)             { ret 1; }
    if (registered_count(?reg) != 1) { ret 1; }
    ret 0;
}

