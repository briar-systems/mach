test has_codegen__per_family {
    var m:   RegMachine = t_machine();
    var rs:  RelocSeam  = t_reloc();
    var mvt: IsaVTable  = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (!has_codegen(?mvt)) { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module, false);
    var evt:     IsaVTable     = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    if (!has_codegen(?evt)) { ret 1; }

    var dvt: IsaVTable = machine_isa(T_ARCH_SYNTHETIC, "desc", 0, 2, nil, nil, nil);
    if (has_codegen(?dvt)) { ret 1; }
    ret 0;
}

test register__rejects_nil_and_empty_name {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2406: err[fail.Fail] = register(nil, nil);
    if (!sel r_2406.err) { ret 1; }
    val r_2407: err[fail.Fail] = register(?reg, nil);
    if (!sel r_2407.err) { ret 1; }

    var m:      RegMachine           = t_machine();
    var rs:     RelocSeam            = t_reloc();
    var model:  target_model.Machine = target_model.t_model(8);
    var vt:     IsaVTable            = machine_isa(ARCH_X86_64, "", 62, 8, ?model, ?m, ?rs);
    val r_2413: err[fail.Fail]       = register(?reg, ?vt);
    if (!sel r_2413.err) { ret 1; }
    vt = machine_isa(ARCH_UNKNOWN, "unknown", 0, 8, ?model, ?m, ?rs);
    val r_2415: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2415.err)             { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

# a malformed constant-time multiply row is refused at registration, and a
# lane row names why: vector rows are not defined yet
test register__rejects_malformed_ct_mul_rows {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var m:     RegMachine           = t_machine();
    var rs:    RelocSeam            = t_reloc();
    var model: target_model.Machine = target_model.t_model(8);
    model.has_mul = true;
    var rows: [2]ct.CtMulForm = [2]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 4, cond: ct.CT_MUL_ALWAYS, ext: 0}
    };
    model.ct_mul_forms    = ?rows[0];
    model.ct_mul_form_len = 2;
    var vt:   IsaVTable      = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model, ?m, ?rs);
    val lane: err[fail.Fail] = register(?reg, ?vt);
    if (!sel lane.err)                                                          { ret 1; }
    if (!types_string.str_contains(fail.describe(lane.err), "not defined yet")) { ret 2; }
    rows[1].lanes = 0;
    rows[1].cond  = ct.CT_MUL_EXTENSION;
    val bare_ext: err[fail.Fail] = register(?reg, ?vt);
    if (!sel bare_ext.err) { ret 3; }
    model.has_mul = false;
    rows[1].cond  = ct.CT_MUL_ALWAYS;
    val no_mul: err[fail.Fail] = register(?reg, ?vt);
    if (!sel no_mul.err)             { ret 4; }
    if (registered_count(?reg) != 0) { ret 5; }
    model.has_mul = true;
    # a row under the data-independent-timing mode needs the model to name the mode
    rows[1].cond = ct.CT_MUL_DIT_MODE;
    val unnamed: err[fail.Fail] = register(?reg, ?vt);
    if (!sel unnamed.err)                                                        { ret 8; }
    if (!types_string.str_contains(fail.describe(unnamed.err), "does not name")) { ret 9; }
    model.dit_mode = "PSTATE.DIT";
    val named: err[fail.Fail] = register(?reg, ?vt);
    if (!sel named.ok) { ret 10; }
    registry_dnit(?reg);
    reg            = registry_init();
    rows[1].cond   = ct.CT_MUL_ALWAYS;
    model.dit_mode = nil;
    val good: err[fail.Fail] = register(?reg, ?vt);
    if (!sel good.ok) { ret 6; }
    val mask: ct.CtMulMask = target_model.ct_mul_rows_admit(?model, false);
    if (!ct.mul_mask_has(mask, ct.mul_cell(ct.CT_MUL_LOW, 32, false))) { ret 7; }
    ret 0;
}

# a lane count whose 64-bit vector spans more bits than a u32 holds is refused,
# and the widest that fits registers
test register__rejects_a_lane_count_past_its_width {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var m:     RegMachine           = t_machine();
    var rs:    RelocSeam            = t_reloc();
    var model: target_model.Machine = target_model.t_model(8);
    model.max_vector_lanes = 0x4000000;
    var vt:   IsaVTable      = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model, ?m, ?rs);
    val wide: err[fail.Fail] = register(?reg, ?vt);
    if (!sel wide.err)                                                            { ret 1; }
    if (!types_string.str_contains(fail.describe(wide.err), "vector lane count")) { ret 2; }
    if (registered_count(?reg) != 0)                                              { ret 3; }
    model.max_vector_lanes = 0x3FFFFFF;
    val fits: err[fail.Fail] = register(?reg, ?vt);
    if (!sel fits.ok) { ret 4; }
    ret 0;
}

test register__rejects_empty_nested_names {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var classes: [1]target_model.RegClass;
    classes[0].name = "";
    classes[0].kind = target_model.RC_GENERAL;
    classes[0].len  = 4;
    var model: target_model.Machine = target_model.t_model(8);
    model.reg_classes   = ?classes[0];
    model.reg_class_len = 1;
    var machine: RegMachine = t_machine();
    var reloc:   RelocSeam  = t_reloc();
    var vt:      IsaVTable  = machine_isa(ARCH_X86_64, "bad_class", 62, 8,
        ?model, ?machine, ?reloc);
    val r_2431: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2431.err) { ret 1; }

    classes[0].name = "gp";
    var ops: [1]target_definition.Op;
    ops[0] = target_definition.op("", "op", 1, 2, 0);
    var types: [1]target_definition.Type;
    types[0] = target_definition.type("ty", 7, nil, 0, nil);
    var defs: target_definition.Table = target_definition.table(?ops[0], 1, ?types[0], 1);
    vt = machine_isa(ARCH_X86_64, "bad_set", 62, 8, ?model, ?machine, ?reloc);
    with_defs(?vt, ?defs);
    val r_2439: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2439.err) { ret 1; }
    ops[0].set  = "core";
    ops[0].name = "";
    val r_2441: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2441.err) { ret 1; }
    # an operand kind outside the set, and a pointer result with no space, are malformed rows
    ops[0] = target_definition.op_shaped("core", "op", 1, 2, target_definition.OP_RESULT_VALUE, target_definition.NO_OP_SPACE, "vx");
    val r_kind: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_kind.err) { ret 2; }
    ops[0] = target_definition.op_shaped("core", "op", 1, 2, target_definition.OP_RESULT_POINTER, target_definition.NO_OP_SPACE, "r");
    val r_space: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_space.err) { ret 3; }
    # an optional tail no enumerated literal decides, and an enumeration on a value operand
    ops[0] = target_definition.op_shaped("core", "op", 1, 2, target_definition.OP_RESULT_VALUE, target_definition.NO_OP_SPACE, "lv|c");
    val r_tail: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_tail.err) { ret 4; }
    var values: [1]target_definition.OpEnumerant = [1]target_definition.OpEnumerant{target_definition.OpEnumerant{value: 3, name: "three", capability: target_definition.NO_OP_CAPABILITY, requires: 0, operands: "c"}};
    var e:      target_definition.OpEnum         = target_definition.OpEnum{name: "e", values: ?values[0], count: 1, mask: false};
    ops[0] = target_definition.op_enumerated(target_definition.op_shaped("core", "op", 1, 2, target_definition.OP_RESULT_VALUE, target_definition.NO_OP_SPACE, "lv|c"), 1, ?e);
    val r_enum_kind: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_enum_kind.err) { ret 5; }
    ops[0]        = target_definition.op("core", "op", 1, 2, 0);
    ops[0].name   = "op";
    types[0].name = "";
    val r_2443: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2443.err)             { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test register__rejects_ambiguous_nested_identities {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var classes: [2]target_model.RegClass;
    classes[0].name = "gp";
    classes[0].kind = target_model.RC_GENERAL;
    classes[0].len  = 4;
    classes[1].name = "fp";
    classes[1].kind = target_model.RC_GENERAL;
    classes[1].len  = 4;
    var model: target_model.Machine = target_model.t_model(8);
    model.reg_classes   = ?classes[0];
    model.reg_class_len = 2;
    var machine: RegMachine = t_machine();
    var reloc:   RelocSeam  = t_reloc();
    var vt:      IsaVTable  = machine_isa(ARCH_X86_64, "duplicate_class_kind", 62, 8,
        ?model, ?machine, ?reloc);
    val r_2460: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2460.err) { ret 1; }
    classes[1].kind = target_model.RC_FLOAT;
    classes[1].name = "gp";
    vt.name         = "duplicate_class_name";
    val r_2463: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2463.err) { ret 1; }

    classes[1].name = "fp";
    var ops: [2]target_definition.Op;
    ops[0] = target_definition.op("core", "add", 1, 1, 0);
    ops[1] = target_definition.op("core", "add", 2, 2, 0);
    var types: [2]target_definition.Type;
    types[0] = target_definition.type("word", 1, nil, 0, nil);
    types[1] = target_definition.type("float", 2, nil, 0, nil);
    var defs: target_definition.Table = target_definition.table(?ops[0], 2, ?types[0], 2);
    vt.name = "duplicate_op_name";
    with_defs(?vt, ?defs);
    val r_2474: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2474.err) { ret 1; }
    ops[1]  = target_definition.op("ext", "sub", 1, 1, 0);
    vt.name = "duplicate_opcode";
    val r_2477: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2477.err) { ret 1; }
    ops[1]        = target_definition.op("ext", "sub", 2, 2, 0);
    types[1].name = "word";
    vt.name       = "duplicate_type_name";
    val r_2480: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2480.err) { ret 1; }
    types[1].name = "float";
    types[1].tag  = 1;
    vt.name       = "duplicate_type_tag";
    val r_2482: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2482.err) { ret 1; }
    types[1].tag      = 2;
    model.has_v128    = true;
    model.vector_bits = target_model.VECTOR_BITS_128;
    var forms: [2]target_model.PackedForm;
    forms[0]              = target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    forms[1]              = forms[0];
    model.packed_forms    = ?forms[0];
    model.packed_form_len = 2;
    vt.name               = "duplicate_packed_form";
    val r_2491: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2491.err) { ret 2; }
    model.packed_form_len = 1;
    forms[0].op           = 999;
    val r_2494: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2494.err)                                            { ret 3; }
    if (target_model.packed_width(?model, 999, false, 32, 32) != 0) { ret 4; }
    forms[0].op        = target_model.VEC_OP_ADD;
    forms[0].lane_bits = 17;
    forms[0].from_bits = 17;
    val r_2497: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2497.err) { ret 5; }
    forms[0].lane_bits = 8;
    forms[0].from_bits = 8;
    forms[0].is_float  = true;
    val r_2499: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2499.err) { ret 6; }
    forms[0].lane_bits = 32;
    forms[0].from_bits = 32;
    forms[0].op        = target_model.VEC_OP_AND;
    val r_2501: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2501.err) { ret 7; }
    forms[0].op       = target_model.VEC_OP_NEG;
    forms[0].is_float = false;
    val r_2503: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2503.err) { ret 8; }
    forms[0].op        = target_model.VEC_OP_ADD;
    forms[0].from_bits = 16;
    vt.name            = "lane_changing_add";
    val r_2505: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2505.err) { ret 18; }
    forms[0].from_bits = 32;
    vt.name            = "incomplete_domain";
    val r_2506: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2506.err) { ret 9; }
    var scalar_len: u32                      = 0;
    val scalar:     *target_model.ScalarForm = t_scalar_rest(?reg.alloc, ?scalar_len, target_model.VEC_OP_ADD, false, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?reg.alloc, scalar); }
    if (scalar_len + 1 != target_model.vector_domain_len()) { ret 10; }
    model.scalar_forms    = scalar;
    model.scalar_form_len = scalar_len;
    scalar[0]             = target_model.ScalarForm{op: target_model.VEC_OP_ADD, is_float: false, lane_bits: 32, from_bits: 32};
    vt.name               = "scalar_row_also_packed";
    val r_2513: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2513.err) { ret 11; }
    scalar[0] = scalar[1];
    vt.name   = "duplicate_scalar_row";
    val r_2516: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2516.err) { ret 12; }
    scalar[0] = target_model.ScalarForm{op: target_model.VEC_OP_SHL_U, is_float: true, lane_bits: 32, from_bits: 32};
    vt.name   = "scalar_row_outside_vocabulary";
    val r_2519: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2519.err) { ret 13; }
    model.scalar_form_len = t_scalar_fill(scalar, target_model.VEC_OP_ADD, false, 32);
    model.has_v128        = false;
    vt.name               = "no_unit_with_rows";
    val r_2523: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2523.err) { ret 14; }
    model.has_v128 = true;
    if (registered_count(?reg) != 0) { ret 1; }
    vt.name = "complete_domain";
    val r_2527: err[fail.Fail] = register(?reg, ?vt);
    if (sel r_2527.err)              { ret 15; }
    if (registered_count(?reg) != 1) { ret 16; }
    ret 0;
}

test declare_scalar_rows__declares_every_conversion_the_packed_table_leaves {
    var m: target_model.Machine = target_model.t_model(8);
    m.has_v128         = true;
    m.vector_bits      = target_model.VECTOR_BITS_128;
    m.max_vector_lanes = target_model.VECTOR_LANES_UNBOUNDED;
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val all: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, target_model.SCALAR_CONVERSIONS);
    if (sel all.err || m.scalar_form_len != CONVERT_CELL_COUNT) { ret 1; }
    fin { release_scalar_rows(?reg, ?m); }
    var rows: *target_model.ScalarForm = m.scalar_forms;
    var i:    u32                      = 0;
    for (i < CONVERT_CELL_COUNT) {
        if (!target_model.is_convert_op(rows[i].op) || target_model.is_widen_op(rows[i].op)) { ret 2; }
        i = i + 1;
    }
    var packed: [1]target_model.PackedForm;
    packed[0]         = target_model.PackedForm{op: target_model.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 16};
    m.packed_forms    = ?packed[0];
    m.packed_form_len = 1;
    release_scalar_rows(?reg, ?m);
    val rest: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, target_model.SCALAR_CONVERSIONS);
    if (sel rest.err) { ret 3; }
    val left: u32 = m.scalar_form_len;
    rows = m.scalar_forms;
    if (left != CONVERT_CELL_COUNT - 1) { ret 3; }
    i = 0;
    for (i < left) {
        if (rows[i].op == target_model.VEC_OP_SEXT && rows[i].lane_bits == 32 && rows[i].from_bits == 16) { ret 4; }
        i = i + 1;
    }
    # a conversion's extent is its wider side
    if (target_model.packed_width(?m, target_model.VEC_OP_SEXT, false, 32, 16) != 128)                                                                     { ret 5; }
    if (target_model.packed_form_valid(target_model.VEC_OP_SEXT, false, 32, 32) || target_model.packed_form_valid(target_model.VEC_OP_ADD, false, 32, 16)) { ret 6; }
    ret 0;
}

test declare_scalar_rows__declares_every_widening_multiply_the_packed_table_leaves {
    var m: target_model.Machine = target_model.t_model(8);
    m.has_v128         = true;
    m.vector_bits      = target_model.VECTOR_BITS_128;
    m.max_vector_lanes = target_model.VECTOR_LANES_UNBOUNDED;
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val all: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, target_model.SCALAR_WIDENING);
    if (sel all.err || m.scalar_form_len != WIDEN_CELL_COUNT) { ret 1; }
    fin { release_scalar_rows(?reg, ?m); }
    var rows: *target_model.ScalarForm = m.scalar_forms;
    var i:    u32                      = 0;
    for (i < WIDEN_CELL_COUNT) {
        if (!target_model.is_widening_cell(?rows[i]) || target_model.is_convert_op(rows[i].op)) { ret 2; }
        if (target_model.is_mul_high_op(rows[i].op) || target_model.is_sign_mask_op(rows[i].op)) {
            if (rows[i].lane_bits != rows[i].from_bits) { ret 2; }
        }
        or (target_model.is_widen_sum_op(rows[i].op)) {
            if (rows[i].lane_bits <= rows[i].from_bits) { ret 2; }
        }
        or (rows[i].lane_bits != rows[i].from_bits * 2) { ret 2; }
        i = i + 1;
    }
    var packed: [1]target_model.PackedForm;
    packed[0]         = target_model.PackedForm{op: target_model.VEC_OP_MUL_WIDE_U, is_float: false, lane_bits: 32, from_bits: 16};
    m.packed_forms    = ?packed[0];
    m.packed_form_len = 1;
    release_scalar_rows(?reg, ?m);
    val rest: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, target_model.SCALAR_WIDENING);
    if (sel rest.err) { ret 3; }
    val left: u32 = m.scalar_form_len;
    rows = m.scalar_forms;
    if (left != WIDEN_CELL_COUNT - 1) { ret 3; }
    i = 0;
    for (i < left) {
        if (rows[i].op == target_model.VEC_OP_MUL_WIDE_U && rows[i].lane_bits == 32) { ret 4; }
        i = i + 1;
    }
    # the result lanes are the wider side, and the signed cell is its own
    if (target_model.packed_width(?m, target_model.VEC_OP_MUL_WIDE_U, false, 32, 16) != 128) { ret 5; }
    if (target_model.packed_width(?m, target_model.VEC_OP_MUL_WIDE_S, false, 32, 16) != 0)   { ret 6; }
    if (target_model.packed_form_valid(target_model.VEC_OP_MUL_WIDE_S, false, 32, 8)
        || target_model.packed_form_valid(target_model.VEC_OP_MUL_WIDE_S, false, 16, 16)
        || target_model.packed_form_valid(target_model.VEC_OP_MUL_WIDE_U, true, 64, 32)
        || target_model.packed_form_valid(target_model.VEC_OP_MUL_WIDE_U, false, 128, 64)) { ret 7; }
    ret 0;
}

test declare_scalar_rows__declares_every_shift_the_packed_table_leaves {
    var m: target_model.Machine = target_model.t_model(8);
    m.has_v128         = true;
    m.vector_bits      = target_model.VECTOR_BITS_128;
    m.max_vector_lanes = target_model.VECTOR_LANES_UNBOUNDED;
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val all: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, target_model.SCALAR_SHIFTS);
    if (sel all.err || m.scalar_form_len != SHIFT_CELL_COUNT) { ret 1; }
    fin { release_scalar_rows(?reg, ?m); }
    var rows: *target_model.ScalarForm = m.scalar_forms;
    var i:    u32                      = 0;
    for (i < SHIFT_CELL_COUNT) {
        if (!target_model.is_shift_op(rows[i].op) || rows[i].is_float || rows[i].lane_bits != rows[i].from_bits) { ret 2; }
        i = i + 1;
    }
    var packed: [1]target_model.PackedForm;
    packed[0]         = target_model.PackedForm{op: target_model.VEC_OP_SHR_S_U, is_float: false, lane_bits: 16, from_bits: 16};
    m.packed_forms    = ?packed[0];
    m.packed_form_len = 1;
    release_scalar_rows(?reg, ?m);
    val rest: err[fail.Fail] = declare_scalar_rows(?reg, ?m, nil, 0, target_model.SCALAR_SHIFTS);
    if (sel rest.err) { ret 3; }
    val left: u32 = m.scalar_form_len;
    rows = m.scalar_forms;
    if (left != SHIFT_CELL_COUNT - 1) { ret 3; }
    i = 0;
    for (i < left) {
        if (rows[i].op == target_model.VEC_OP_SHR_S_U && rows[i].lane_bits == 16) { ret 4; }
        i = i + 1;
    }
    # the count's form and the direction's signedness are each their own cell,
    # and a shift has no float lanes
    if (target_model.packed_width(?m, target_model.VEC_OP_SHR_S_U, false, 16, 16) != 128) { ret 5; }
    if (target_model.packed_width(?m, target_model.VEC_OP_SHR_S_V, false, 16, 16) != 0
        || target_model.packed_width(?m, target_model.VEC_OP_SHR_U_U, false, 16, 16) != 0) { ret 6; }
    if (target_model.packed_form_valid(target_model.VEC_OP_SHL_U, true, 32, 32)
        || target_model.packed_form_valid(target_model.VEC_OP_SHL_V, false, 32, 16)
        || target_model.packed_form_valid(target_model.VEC_OP_SHR_U_U, false, 128, 128)) { ret 7; }
    ret 0;
}

test vector_form__every_retained_cell_has_one_declared_outcome {
    # 51 lane-keeping cells, 72 conversions, 6 widening multiplies, 6
    # lane-halving extensions, 24 shifts, 7 lane ranges, 7 lane joins, 8 high
    # multiplies, 3 lane interleaves, 6 widening group sums and 4 sign masks
    if (target_model.vector_domain_len() != 194) { ret 1; }
    var cell: target_model.ScalarForm;
    if (!target_model.vector_domain_cell(0, ?cell)
        || cell.op != target_model.VEC_OP_ADD || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 2; }
    if (!target_model.vector_domain_cell(50, ?cell)
        || cell.op != target_model.VEC_OP_CMP || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 3; }
    if (!target_model.vector_domain_cell(51, ?cell)
        || cell.op != target_model.VEC_OP_TRUNC || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 16) { ret 18; }
    if (!target_model.vector_domain_cell(122, ?cell)
        || cell.op != target_model.VEC_OP_UI_TO_FP || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 19; }
    if (!target_model.vector_domain_cell(123, ?cell)
        || cell.op != target_model.VEC_OP_MUL_WIDE_S || cell.is_float || cell.lane_bits != 16 || cell.from_bits != 8) { ret 21; }
    if (!target_model.vector_domain_cell(128, ?cell)
        || cell.op != target_model.VEC_OP_MUL_WIDE_U || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 22; }
    if (!target_model.vector_domain_cell(129, ?cell)
        || cell.op != target_model.VEC_OP_WIDEN_S || cell.is_float || cell.lane_bits != 16 || cell.from_bits != 8) { ret 23; }
    if (!target_model.vector_domain_cell(134, ?cell)
        || cell.op != target_model.VEC_OP_WIDEN_U || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 24; }
    if (!target_model.vector_domain_cell(135, ?cell)
        || cell.op != target_model.VEC_OP_SHL_U || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 25; }
    if (!target_model.vector_domain_cell(158, ?cell)
        || cell.op != target_model.VEC_OP_SHR_S_V || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 26; }
    if (!target_model.vector_domain_cell(159, ?cell)
        || cell.op != target_model.VEC_OP_RANGE || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 27; }
    if (!target_model.vector_domain_cell(165, ?cell)
        || cell.op != target_model.VEC_OP_RANGE || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 28; }
    if (!target_model.vector_domain_cell(172, ?cell)
        || cell.op != target_model.VEC_OP_CONCAT || !cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 29; }
    if (!target_model.vector_domain_cell(46, ?cell)
        || cell.op != target_model.VEC_OP_CMP || !cell.is_float || cell.lane_bits != 16 || cell.from_bits != 16) { ret 30; }
    if (!target_model.vector_domain_cell(69, ?cell)
        || cell.op != target_model.VEC_OP_FP_TRUNC || !cell.is_float || cell.lane_bits != 16 || cell.from_bits != 32) { ret 31; }
    if (!target_model.vector_domain_cell(173, ?cell)
        || cell.op != target_model.VEC_OP_MUL_HIGH_S || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 32; }
    if (!target_model.vector_domain_cell(183, ?cell)
        || cell.op != target_model.VEC_OP_INTERLEAVE || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 33; }
    if (!target_model.vector_domain_cell(184, ?cell)
        || cell.op != target_model.VEC_OP_WIDEN_SUM_U || cell.is_float || cell.lane_bits != 16 || cell.from_bits != 8) { ret 34; }
    if (!target_model.vector_domain_cell(189, ?cell)
        || cell.op != target_model.VEC_OP_WIDEN_SUM_U || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 32) { ret 35; }
    if (!target_model.vector_domain_cell(190, ?cell)
        || cell.op != target_model.VEC_OP_SIGN_MASK || cell.is_float || cell.lane_bits != 8 || cell.from_bits != 8) { ret 36; }
    if (!target_model.vector_domain_cell(193, ?cell)
        || cell.op != target_model.VEC_OP_SIGN_MASK || cell.is_float || cell.lane_bits != 64 || cell.from_bits != 64) { ret 37; }
    if (target_model.vector_domain_cell(194, ?cell)) { ret 4; }

    var packed: [1]target_model.PackedForm;
    packed[0] = target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 32, from_bits: 32};
    var rest_alloc: A.Allocator;
    val rest_made:  err[A.Error] = page.make(?rest_alloc);
    if (sel rest_made.err) { ret 90; }
    var scalar_len: u32                      = 0;
    val scalar:     *target_model.ScalarForm = t_scalar_rest(?rest_alloc, ?scalar_len, target_model.VEC_OP_MUL, true, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?rest_alloc, scalar); }
    var m: target_model.Machine = target_model.t_model(8);
    m.has_v128         = true;
    m.vector_bits      = target_model.VECTOR_BITS_128;
    m.max_vector_lanes = target_model.VECTOR_LANES_UNBOUNDED;
    m.packed_forms     = ?packed[0];
    m.packed_form_len  = 1;
    m.scalar_forms     = scalar;
    m.scalar_form_len  = scalar_len;
    if (!target_model.vector_domain_complete(?m))                                                         { ret 5; }
    if (target_model.vector_form(?m, target_model.VEC_OP_MUL, true, 32, 32) != target_model.FORM_PACKED)  { ret 6; }
    if (target_model.vector_form(?m, target_model.VEC_OP_MUL, false, 32, 32) != target_model.FORM_SCALAR) { ret 7; }
    if (target_model.vector_form(?m, target_model.VEC_OP_DIV, false, 8, 8) != target_model.FORM_SCALAR)   { ret 8; }
    if (target_model.vector_form(?m, target_model.VEC_OP_SHL_U, true, 32, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_NEG, true, 32, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_AND, true, 32, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_ADD, false, 128, 128) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_ADD, true, 8, 8) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, 999, false, 32, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_ADD, false, 32, 16) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_SEXT, false, 16, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_TRUNC, false, 16, 16) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_FP_TO_SI, true, 32, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_FP_EXT, true, 64, 64) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_MUL_WIDE_S, false, 32, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_MUL_WIDE_U, false, 64, 16) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_MUL_WIDE_S, true, 64, 32) != target_model.FORM_UNDECLARED
        || target_model.vector_form(?m, target_model.VEC_OP_MUL_WIDE_U, false, 128, 64) != target_model.FORM_UNDECLARED) { ret 9; }
    if (target_model.vector_form(?m, target_model.VEC_OP_SEXT, false, 32, 16) != target_model.FORM_SCALAR
        || target_model.vector_form(?m, target_model.VEC_OP_UI_TO_FP, true, 32, 8) != target_model.FORM_SCALAR
        || target_model.vector_form(?m, target_model.VEC_OP_MUL_WIDE_S, false, 32, 16) != target_model.FORM_SCALAR) { ret 20; }

    m.scalar_form_len = scalar_len - 1;
    if (target_model.vector_domain_complete(?m)) { ret 10; }
    if (target_model.vector_form(?m, scalar[scalar_len - 1].op, scalar[scalar_len - 1].is_float,
        scalar[scalar_len - 1].lane_bits, scalar[scalar_len - 1].from_bits) != target_model.FORM_UNDECLARED) { ret 11; }
    m.scalar_forms    = nil;
    m.scalar_form_len = 0;
    if (target_model.vector_domain_complete(?m))                                                              { ret 12; }
    if (target_model.vector_form(?m, target_model.VEC_OP_ADD, false, 32, 32) != target_model.FORM_UNDECLARED) { ret 13; }

    var none: target_model.Machine = target_model.t_model(8);
    none.has_v128 = false;
    if (!target_model.vector_domain_complete(?none)) { ret 14; }
    if (target_model.vector_form(?none, target_model.VEC_OP_ADD, false, 32, 32) != target_model.FORM_SCALAR
        || target_model.vector_form(?none, target_model.VEC_OP_DIV, true, 64, 64) != target_model.FORM_SCALAR) { ret 15; }
    if (target_model.vector_form(?none, target_model.VEC_OP_SHL_U, true, 32, 32) != target_model.FORM_UNDECLARED) { ret 16; }
    none.packed_forms    = ?packed[0];
    none.packed_form_len = 1;
    if (target_model.vector_domain_complete(?none)) { ret 17; }
    ret 0;
}

test register__rejects_duplicate_id_under_a_different_name {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var m1:     RegMachine           = t_machine();
    var rs1:    RelocSeam            = t_reloc();
    var model1: target_model.Machine = target_model.t_model(8);
    var vt1:    IsaVTable            = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model1, ?m1, ?rs1);
    val r_2588: err[fail.Fail]       = register(?reg, ?vt1);
    if (sel r_2588.err) { ret 1; }

    var m2:     RegMachine           = t_machine();
    var rs2:    RelocSeam            = t_reloc();
    var model2: target_model.Machine = target_model.t_model(8);
    var vt2:    IsaVTable            = machine_isa(ARCH_X86_64, "x86_64_alias", 62, 8, ?model2, ?m2, ?rs2);
    val r_2594: err[fail.Fail]       = register(?reg, ?vt2);
    if (!sel r_2594.err)             { ret 1; }
    if (registered_count(?reg) != 1) { ret 1; }
    ret 0;
}

test register__rejects_reregistering_the_same_descriptor {
