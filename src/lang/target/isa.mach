pub def RelocSeam: of.RelocationCapabilities;

pub rec OpDef {
    set:     str;
    name:    str;
    set_tag: u32;
    opcode:  u32;
    arity:   u32;
}

pub val TYPE_OPERAND_WORD: u32 = 0xFFFFFFFF;

pub val NO_TYPE_CTOR: u32 = 0xFFFFFFFF;

pub def TypeRefuseFn: fun(*u32, u32) str;

pub rec TypeDef {
    name:     str;
    tag:      u32;
    operands: *u32;
    arity:    u32;
    refuse:   TypeRefuseFn;
}

pub rec TargetDefs {
    ops:        *OpDef;
    op_count:   u32;
    types:      *TypeDef;
    type_count: u32;
}

pub val NO_OP_SET: u32 = definition.NO_OP_SET;
pub val NO_OPCODE: u32 = definition.NO_OPCODE;

pub fun op_def(set: str, name: str, set_tag: u32, opcode: u32, arity: u32) OpDef {
    var d: OpDef;
    d.set     = set;
    d.name    = name;
    d.set_tag = set_tag;
    d.opcode  = opcode;
    d.arity   = arity;
    ret d;
}

pub fun type_def(name: str, tag: u32, operands: *u32, arity: u32, refuse: TypeRefuseFn) TypeDef {
    var d: TypeDef;
    d.name     = name;
    d.tag      = tag;
    d.operands = operands;
    d.arity    = arity;
    d.refuse   = refuse;
    ret d;
}

pub fun target_defs(ops: *OpDef, op_count: u32, types: *TypeDef, type_count: u32) TargetDefs {
    var t: TargetDefs;
    t.ops        = ops;
    t.op_count   = op_count;
    t.types      = types;
    t.type_count = type_count;
    ret t;
}

pub fun type_def_of(defs: *TargetDefs, name: str) *TypeDef {
    ret type_def_of_region(defs, name, 0::usize, str_len(name));
}

pub fun type_def_of_region(defs: *TargetDefs, src: str, off: usize, len: usize) *TypeDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.type_count) {
        val d: *TypeDef = ?defs.types[i];
        if (str_region_equals(src, off, len, d.name)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

pub fun type_def_by_tag(defs: *TargetDefs, tag: u32) *TypeDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.type_count) {
        if (defs.types[i].tag == tag) { ret ?defs.types[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun op_def_of(defs: *TargetDefs, set_name: str, op_name: str) *OpDef {
    ret op_def_of_region(defs, set_name, 0::usize, str_len(set_name),
                         op_name, 0::usize, str_len(op_name));
}

pub fun op_def_of_region(defs: *TargetDefs, set_src: str, set_off: usize, set_len: usize,
                         nam_src: str, nam_off: usize, nam_len: usize) *OpDef {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        val d: *OpDef = ?defs.ops[i];
        if (str_region_equals(set_src, set_off, set_len, d.set)
            && str_region_equals(nam_src, nam_off, nam_len, d.name)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

pub fun op_set_exists_region(defs: *TargetDefs, src: str, off: usize, len: usize) bool {
    if (defs == nil) { ret false; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        if (str_region_equals(src, off, len, defs.ops[i].set)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun op_set_exists(defs: *TargetDefs, name: str) bool {
    ret op_set_exists_region(defs, name, 0::usize, str_len(name));
}

pub fun with_defs(vt: *IsaVTable, d: *TargetDefs) {
    vt.defs = d;
}

pub fun with_environments(vt: *IsaVTable, envs: *Environment, count: u32) {
    vt.envs      = envs;
    vt.env_count = count;
}

pub fun environment_lookup(vt: *IsaVTable, name: str) u32 {
    var i: u32 = 0;
    for (i < vt.env_count) {
        if (str_equals(vt.envs[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret ENV_NONE;
}

pub fun environment_profile(vt: *IsaVTable, env_id: u32) u32 {
    if (env_id == ENV_NONE || env_id >= vt.env_count) { ret ENV_NONE; }
    ret vt.envs[env_id].profile;
}

pub rec Environment {
    name:    str;
    profile: u32;
}

pub val ENV_NONE: u32 = 0xFFFFFFFF;

pub rec IsaVTable {
    id:              u32;
    name:            str;
    elf_machine:     u32;
    pointer_width:   u32;
    reloc:           *RelocSeam;
    machine:         *RegMachine;
    emitter:         *ModuleEmitter;
    model:           *MachineModel;
    defs:            *TargetDefs;
    envs:            *Environment;
    env_count:       u32;
}

pub fun reg_machine(select: SelectFn, encode: EncodeFn,
                    is_reg_move: IsRegMoveFn, is_trap_terminator: IsTrapTerminatorFn,
                    reserved_regs: *Register, reserved_reg_count: i32,
                    reload_scratch_regs: *Register, reload_scratch_count: i32,
                    scratch_reg: i32, scratch_reg2: i32,
                    frame_ptr_reg: i32, stack_ptr_reg: i32, incoming_arg_base: i64,
                    div_reg: i32, div_hi_reg: i32, shift_count_reg: i32) RegMachine {
    var m: RegMachine;
    m.select               = select;
    m.encode               = encode;
    m.is_reg_move          = is_reg_move;
    m.is_trap_terminator   = is_trap_terminator;
    m.reserved_regs        = reserved_regs;
    m.reserved_reg_count   = reserved_reg_count;
    m.reload_scratch_regs  = reload_scratch_regs;
    m.reload_scratch_count = reload_scratch_count;
    m.scratch_reg          = scratch_reg;
    m.scratch_reg2         = scratch_reg2;
    m.frame_ptr_reg        = frame_ptr_reg;
    m.stack_ptr_reg        = stack_ptr_reg;
    m.incoming_arg_base    = incoming_arg_base;
    m.div_reg              = div_reg;
    m.div_hi_reg           = div_hi_reg;
    m.shift_count_reg      = shift_count_reg;
    m.frame_dist           = nil;
    ret m;
}

pub fun with_assembly(m: *RegMachine, emit: EmitAsmFn, clobbers: AsmClobbersFn,
                      returns: AsmReturnsFn, ct_scan: AsmCtScanFn) {
    m.has_assembly = true;
    m.assembly.emit     = emit;
    m.assembly.clobbers = clobbers;
    m.assembly.returns  = returns;
    m.assembly.ct_scan  = ct_scan;
}

pub fun with_dwarf_regs(m: *RegMachine, f: DwarfRegFn) {
    m.dwarf_reg = f;
}

pub fun with_codeview_regs(m: *RegMachine, f: CvRegFn) {
    m.cv_reg = f;
}

pub fun with_frame_dist(m: *RegMachine, f: FrameDistFn) {
    m.frame_dist = f;
}

pub fun reloc_seam(apply_reloc: of.ApplyRelocFn, reloc_traits: of.RelocTraitsFn,
                   elf_reloc_type: of.ElfRelocTypeFn) RelocSeam {
    var s: RelocSeam;
    s.apply     = apply_reloc;
    s.traits    = reloc_traits;
    s.normalize = nil;
    s.resolve_operand = nil;
    s.local_got_kind = nil;
    s.has_elf   = elf_reloc_type != nil;
    s.elf.reloc_type       = elf_reloc_type;
    s.elf.attributes.section = nil;
    s.elf.attributes.sht     = 0;
    s.elf.attributes.vendor  = nil;
    s.elf.has_attributes   = false;
    s.elf.machine_flags    = nil;
    s.elf.build_attributes = nil;
    s.elf.merge_attributes = nil;
    ret s;
}

pub fun with_elf_attributes(s: *RelocSeam, attributes: *of.ElfAttributes) {
    s.has_elf       = true;
    s.elf.has_attributes = attributes != nil;
    s.elf.attributes.section = nil;
    s.elf.attributes.sht = 0;
    s.elf.attributes.vendor = nil;
    if (attributes != nil) { s.elf.attributes = @attributes; }
}

pub fun with_local_got_kinds(s: *RelocSeam, f: of.LocalGotKindFn) {
    s.local_got_kind = f;
}

pub fun declares_local_got(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.local_got_kind != nil;
}

pub fun local_got_kind(tgt_isa: *IsaVTable, kind: of.RelocKind) bool {
    if (!declares_local_got(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.local_got_kind(kind);
}

pub fun with_machine_flags(s: *RelocSeam, f: of.MachineFlagsFn) {
    s.has_elf          = true;
    s.elf.machine_flags = f;
}

pub def MachineFlagsFn: of.MachineFlagsFn;

pub fun declares_machine_flags(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)                  { ret false; }
    if (!emits_relocations(tgt_isa))     { ret false; }
    ret tgt_isa.reloc.has_elf && tgt_isa.reloc.elf.machine_flags != nil;
}

pub fun machine_flags(tgt_isa: *IsaVTable, float_arg_bits: u32,
                      has_compressed: bool) u32 {
    if (tgt_isa == nil)                     { ret 0; }
    if (!emits_relocations(tgt_isa))        { ret 0; }
    if (!tgt_isa.reloc.has_elf || tgt_isa.reloc.elf.machine_flags == nil) { ret 0; }
    ret tgt_isa.reloc.elf.machine_flags(float_arg_bits, has_compressed);
}

pub fun with_normalize_image(s: *RelocSeam, f: of.NormalizeImageFn) {
    s.normalize = f;
}

pub fun with_resolve_reloc_operand(s: *RelocSeam, f: of.ResolveRelocOperandFn) {
    s.resolve_operand = f;
}

pub fun with_attributes(s: *RelocSeam, build: of.BuildAttributesFn, merge: of.MergeAttributesFn) {
    s.has_elf              = true;
    s.elf.build_attributes = build;
    s.elf.merge_attributes = merge;
}

pub def BuildAttributesFn: of.BuildAttributesFn;

pub def MergeAttributesFn: of.MergeAttributesFn;

pub fun declares_attributes(tgt_isa: *IsaVTable) bool {
    if (tgt_isa == nil)              { ret false; }
    if (!emits_relocations(tgt_isa)) { ret false; }
    ret tgt_isa.reloc.has_elf && tgt_isa.reloc.elf.build_attributes != nil
        && tgt_isa.reloc.elf.merge_attributes != nil;
}

pub fun build_attributes(tgt_isa: *IsaVTable, alloc: *A.Allocator, float_arg_bits: u32,
                         has_compressed: bool, out_len: *u32) R.Result[*u8, str] {
    @out_len = 0;
    if (!declares_attributes(tgt_isa)) { ret R.ok[*u8, str](nil); }
    ret tgt_isa.reloc.elf.build_attributes(alloc, tgt_isa.model.gpr_width * 8,
                                           float_arg_bits, has_compressed, out_len);
}

pub fun merge_attributes(tgt_isa: *IsaVTable, alloc: *A.Allocator, acc: *u8, acc_len: u32,
                         add: *u8, add_len: u32, out_len: *u32) R.Result[*u8, str] {
    @out_len = 0;
    if (!declares_attributes(tgt_isa)) { ret R.ok[*u8, str](nil); }
    ret tgt_isa.reloc.elf.merge_attributes(alloc, acc, acc_len, add, add_len, out_len);
}

pub fun object_target(vt: *IsaVTable, out: *of.ObjectTarget) {
    out.arch_id       = vt.id;
    out.elf_machine   = vt.elf_machine;
    out.pointer_width = vt.pointer_width;
    out.relocation    = vt.reloc;
}

pub fun machine_isa(id: u32, name: str, elf_machine: u32, pointer_width: u32,
                    model: *MachineModel, machine: *RegMachine,
                    reloc: *RelocSeam) IsaVTable {
    var vt: IsaVTable = isa_common(id, name, elf_machine, pointer_width, model);
    vt.reloc   = reloc;
    vt.machine = machine;
    vt.emitter = nil;
    ret vt;
}

pub fun emitter_isa(id: u32, name: str, pointer_width: u32,
                    model: *MachineModel, emitter: *ModuleEmitter) IsaVTable {
    var vt: IsaVTable = isa_common(id, name, 0, pointer_width, model);
    vt.reloc   = nil;
    vt.machine = nil;
    vt.emitter = emitter;
    ret vt;
}

pub fun module_emitter(emit_module: EmitModuleFn) ModuleEmitter {
    var emitter: ModuleEmitter;
    emitter.emit_module = emit_module;
    ret emitter;
}

fun isa_common(id: u32, name: str, elf_machine: u32, pointer_width: u32,
               model: *MachineModel) IsaVTable {
    var vt: IsaVTable;
    vt.id              = id;
    vt.name            = name;
    vt.elf_machine     = elf_machine;
    vt.pointer_width   = pointer_width;
    vt.model           = model;
    vt.envs            = nil;
    vt.env_count       = 0;
    ret vt;
}

val ISA_REGISTRY_CAP: u32 = 8;

pub rec IsaRegistryEntry {
    descriptor: IsaVTable;
    model:      MachineModel;
    machine:    RegMachine;
    emitter:    ModuleEmitter;
    reloc:      RelocSeam;
    defs:       TargetDefs;
    reg_classes:      *RegClass;
    model_reserved:   *Register;
    machine_reserved: *Register;
    reload_scratch:   *Register;
    packed_gaps:      *PackedGap;
    envs:             *Environment;
    op_defs:          *OpDef;
    type_defs:        *TypeDef;
    type_operands:    *u32;
    type_operand_count: u32;
}

pub rec IsaRegistry {
    entries: [8]IsaRegistryEntry;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

rec ArchSpec {
    arch:            u32;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val ARCH_CATALOG_VERSION: u8 = 1;

val ARCH_N: usize = 6;
val ARCHS: [ARCH_N]ArchSpec = [ARCH_N]ArchSpec{
    ArchSpec{ arch: ARCH_X86_64,  spelling: "x86_64",  fingerprint_tag: 1 },
    ArchSpec{ arch: ARCH_AARCH64, spelling: "aarch64", fingerprint_tag: 2 },
    ArchSpec{ arch: ARCH_RISCV64, spelling: "riscv64", fingerprint_tag: 3 },
    ArchSpec{ arch: ARCH_MOS6502, spelling: "mos6502", fingerprint_tag: 4 },
    ArchSpec{ arch: ARCH_SPIRV,   spelling: "spirv",   fingerprint_tag: 5 },
    ArchSpec{ arch: ARCH_RISCV32, spelling: "riscv32", fingerprint_tag: 6 },
};

fun arch_spec(id: u32) *ArchSpec {
    var i: usize = 0;
    for (i < ARCH_N) {
        if (ARCHS[i].arch == id) { ret ?ARCHS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun arch_id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ARCH_N) {
        if (str_equals(ARCHS[i].spelling, name)) { ret ARCHS[i].arch; }
        i = i + 1;
    }
    ret ARCH_UNKNOWN;
}

pub fun arch_name_for(id: u32) str {
    val spec: *ArchSpec = arch_spec(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun arch_catalog_len() usize {
    ret ARCH_N;
}

pub fun arch_catalog_name(index: usize) str {
    if (index >= ARCH_N) { ret "unknown"; }
    ret ARCHS[index].spelling;
}

pub fun arch_fingerprint_tag(id: u32) u8 {
    val spec: *ArchSpec = arch_spec(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

pub fun regid_make(class_id: i32, index: i32) i32 {
    ret ((class_id & 0xFF) << 8) | (index & 0xFF);
}

pub fun regid_class(regid: i32) i32 {
    ret (regid >> 8) & 0xFF;
}

pub fun regid_index(regid: i32) i32 {
    ret regid & 0xFF;
}

pub fun make_none() Operand {
    ret operand_blank(OPK_NONE, 0);
}

pub fun make_reg(id: i32, size: u8) Operand {
    var op: Operand = operand_blank(OPK_REG, size);
    op.reg = id;
    ret op;
}

pub fun make_imm(value: i64, size: u8) Operand {
    var op: Operand = operand_blank(OPK_IMM, size);
    op.imm = value;
    ret op;
}

pub fun make_mem(base: i32, disp: i32, index: i32, scale: u8, size: u8) Operand {
    var op: Operand = operand_blank(OPK_MEM, size);
    op.base  = base;
    op.index = index;
    op.scale = scale;
    op.disp  = disp;
    ret op;
}

pub fun make_label(name: str) Operand {
    var op: Operand = operand_blank(OPK_LABEL, 0);
    op.label = name;
    ret op;
}

pub fun make_block_label(id: u32) Operand {
    var op: Operand = operand_blank(OPK_LABEL, 0);
    op.label = nil;
    op.imm   = id::i64;
    ret op;
}

pub fun make_sym(sym_id: u32, size: u8) Operand {
    var op: Operand = operand_blank(OPK_SYM, size);
    op.sym_id = sym_id;
    ret op;
}

pub fun buf_init(alloc: *A.Allocator) InstBuf {
    var buf: InstBuf;
    buf.insts = nil;
    buf.count = 0;
    buf.cap   = 0;
    buf.alloc = alloc;
    buf.err   = false;
    ret buf;
}

pub fun buf_append(buf: *InstBuf, inst: Inst) {
    if (buf.err) { ret; }
    if (buf.count >= buf.cap) {
        var new_cap: i32 = INSTBUF_INIT_CAP;
        if (buf.cap > 0) {
            new_cap = buf.cap * 2;
        }

        val res_grow: R.Result[*Inst, str] = A.reallocate[Inst](
            buf.alloc, buf.insts, buf.cap::usize, new_cap::usize
        );
        if (R.is_err[*Inst, str](res_grow)) {
            buf.err = true;
            ret;
        }
        buf.insts = R.unwrap_ok[*Inst, str](res_grow);
        buf.cap   = new_cap;
    }

    buf.insts[buf.count] = inst;
    buf.count = buf.count + 1;
}

pub fun buf_dnit(buf: *InstBuf) {
    if (buf == nil) { ret; }
    if (buf.insts != nil && buf.cap > 0) {
        A.deallocate[Inst](buf.alloc, buf.insts, buf.cap::usize);
        buf.insts = nil;
    }
    buf.count = 0;
    buf.cap   = 0;
    buf.err   = false;
}

pub fun registry_init_with_allocator(alloc: *A.Allocator) IsaRegistry {
    var reg: IsaRegistry;
    reg.alloc_ready = alloc != nil;
    if (alloc != nil) { reg.alloc = @alloc; }
    var i: u32 = 0;
    for (i < ISA_REGISTRY_CAP) {
        reg.entries[i].descriptor.id = ARCH_UNKNOWN;
        reg.entries[i].descriptor.name = nil;
        reg.entries[i].descriptor.reloc = nil;
        reg.entries[i].reg_classes = nil;
        reg.entries[i].model_reserved = nil;
        reg.entries[i].machine_reserved = nil;
        reg.entries[i].reload_scratch = nil;
        reg.entries[i].packed_gaps = nil;
        reg.entries[i].envs = nil;
        reg.entries[i].op_defs = nil;
        reg.entries[i].type_defs = nil;
        reg.entries[i].type_operands = nil;
        reg.entries[i].type_operand_count = 0;
        i = i + 1;
    }
    reg.count = 0;
    ret reg;
}

pub fun registry_init() IsaRegistry {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret registry_init_with_allocator(nil); }
    ret registry_init_with_allocator(?alloc);
}

fun own_copy[T](alloc: *A.Allocator, src: *T, count: usize) R.Result[*T, str] {
    if (count == 0) { ret R.ok[*T, str](nil); }
    val res: R.Result[*T, str] = A.allocate[T](alloc, count);
    if (R.is_err[*T, str](res)) { ret res; }
    val dst: *T = R.unwrap_ok[*T, str](res);
    var i: usize = 0;
    for (i < count) {
        dst[i] = src[i];
        i = i + 1;
    }
    ret R.ok[*T, str](dst);
}

fun own_space[T](alloc: *A.Allocator, count: usize) R.Result[*T, str] {
    if (count == 0) { ret R.ok[*T, str](nil); }
    ret A.allocate[T](alloc, count);
}

fun release_entry(reg: *IsaRegistry, entry: *IsaRegistryEntry) {
    if (entry.descriptor.name != nil) {
        A.deallocate[u8](?reg.alloc, entry.descriptor.name::*u8, str_len(entry.descriptor.name) + 1);
    }
    if (entry.reg_classes != nil) {
        var ci: u32 = 0;
        for (ci < entry.model.reg_class_len) {
            if (entry.reg_classes[ci].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.reg_classes[ci].name::*u8,
                                 str_len(entry.reg_classes[ci].name) + 1);
            }
            ci = ci + 1;
        }
        A.deallocate[RegClass](?reg.alloc, entry.reg_classes, entry.model.reg_class_len::usize);
    }
    if (entry.model_reserved != nil) {
        A.deallocate[Register](?reg.alloc, entry.model_reserved, entry.model.reserved_len::usize);
    }
    if (entry.machine_reserved != nil) {
        A.deallocate[Register](?reg.alloc, entry.machine_reserved, entry.machine.reserved_reg_count::usize);
    }
    if (entry.reload_scratch != nil) {
        A.deallocate[Register](?reg.alloc, entry.reload_scratch, entry.machine.reload_scratch_count::usize);
    }
    if (entry.envs != nil) {
        var ei: u32 = 0;
        for (ei < entry.descriptor.env_count) {
            if (entry.envs[ei].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.envs[ei].name::*u8, str_len(entry.envs[ei].name) + 1);
            }
            ei = ei + 1;
        }
        A.deallocate[Environment](?reg.alloc, entry.envs, entry.descriptor.env_count::usize);
        entry.envs = nil;
    }
    if (entry.packed_gaps != nil) {
        A.deallocate[PackedGap](?reg.alloc, entry.packed_gaps, entry.model.packed_gap_len::usize);
    }
    if (entry.op_defs != nil) {
        var oi: u32 = 0;
        for (oi < entry.defs.op_count) {
            if (entry.op_defs[oi].set != nil) {
                A.deallocate[u8](?reg.alloc, entry.op_defs[oi].set::*u8,
                                 str_len(entry.op_defs[oi].set) + 1);
            }
            if (entry.op_defs[oi].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.op_defs[oi].name::*u8,
                                 str_len(entry.op_defs[oi].name) + 1);
            }
            oi = oi + 1;
        }
        A.deallocate[OpDef](?reg.alloc, entry.op_defs, entry.defs.op_count::usize);
    }
    if (entry.type_defs != nil) {
        var ti: u32 = 0;
        for (ti < entry.defs.type_count) {
            if (entry.type_defs[ti].name != nil) {
                A.deallocate[u8](?reg.alloc, entry.type_defs[ti].name::*u8,
                                 str_len(entry.type_defs[ti].name) + 1);
            }
            ti = ti + 1;
        }
        A.deallocate[TypeDef](?reg.alloc, entry.type_defs, entry.defs.type_count::usize);
    }
    if (entry.type_operands != nil) {
        A.deallocate[u32](?reg.alloc, entry.type_operands, entry.type_operand_count::usize);
    }
    if (entry.descriptor.reloc != nil && entry.reloc.elf.has_attributes) {
        if (entry.reloc.elf.attributes.section != nil) {
            A.deallocate[u8](?reg.alloc, entry.reloc.elf.attributes.section::*u8,
                             str_len(entry.reloc.elf.attributes.section) + 1);
        }
        if (entry.reloc.elf.attributes.vendor != nil) {
            A.deallocate[u8](?reg.alloc, entry.reloc.elf.attributes.vendor::*u8,
                             str_len(entry.reloc.elf.attributes.vendor) + 1);
        }
        entry.reloc.elf.attributes.section = nil;
        entry.reloc.elf.attributes.vendor = nil;
    }
    entry.reg_classes = nil;
    entry.model_reserved = nil;
    entry.machine_reserved = nil;
    entry.reload_scratch = nil;
    entry.packed_gaps = nil;
    entry.envs = nil;
    entry.op_defs = nil;
    entry.type_defs = nil;
    entry.type_operands = nil;
    entry.type_operand_count = 0;
    entry.descriptor.name = nil;
    entry.descriptor.reloc = nil;
}

pub fun registry_dnit(reg: *IsaRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > ISA_REGISTRY_CAP) { limit = ISA_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        release_entry(reg, ?reg.entries[i]);
        i = i + 1;
    }
    reg.count = 0;
}

fun errf(fb: str, fmt: str, va: ...) str {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret fb; }
    val r: R.Result[str, str] = format.sprint(?alloc, fmt, va...);
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

fun dup_id(reg: *IsaRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].descriptor.id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun descriptor_valid(vt: *IsaVTable) bool {
    if (vt == nil || str_len(vt.name) == 0 || vt.id == ARCH_UNKNOWN
        || vt.model == nil || vt.pointer_width == 0
        || vt.model.pointer_width != vt.pointer_width) { ret false; }
    val has_machine: bool = vt.machine != nil;
    val has_emitter: bool = vt.emitter != nil;
    if (has_machine == has_emitter) { ret false; }
    if (has_machine) {
        if (vt.machine.select == nil || vt.machine.encode == nil
            || vt.machine.is_reg_move == nil || vt.machine.is_trap_terminator == nil
            || vt.machine.reserved_reg_count < 0 || vt.machine.reload_scratch_count < 0
            || (vt.machine.reserved_reg_count > 0 && vt.machine.reserved_regs == nil)
            || (vt.machine.reload_scratch_count > 0 && vt.machine.reload_scratch_regs == nil)) { ret false; }
        if (vt.reloc != nil && (vt.reloc.apply == nil || vt.reloc.traits == nil)) { ret false; }
        if (vt.machine.has_assembly) {
            if (vt.machine.assembly.emit == nil || vt.machine.assembly.clobbers == nil
                || vt.machine.assembly.returns == nil || vt.machine.assembly.ct_scan == nil) { ret false; }
        } or {
            if (vt.machine.assembly.emit != nil || vt.machine.assembly.clobbers != nil
                || vt.machine.assembly.returns != nil || vt.machine.assembly.ct_scan != nil) { ret false; }
        }
    }
    if (has_emitter && (vt.emitter.emit_module == nil || vt.reloc != nil)) { ret false; }
    if (vt.reloc != nil && !vt.reloc.has_elf
        && (vt.reloc.elf.reloc_type != nil || vt.reloc.elf.has_attributes
            || vt.reloc.elf.attributes.section != nil || vt.reloc.elf.attributes.sht != 0
            || vt.reloc.elf.attributes.vendor != nil || vt.reloc.elf.machine_flags != nil
            || vt.reloc.elf.build_attributes != nil || vt.reloc.elf.merge_attributes != nil)) { ret false; }
    if (vt.reloc != nil && !vt.reloc.elf.has_attributes
        && (vt.reloc.elf.attributes.section != nil || vt.reloc.elf.attributes.sht != 0
            || vt.reloc.elf.attributes.vendor != nil)) { ret false; }
    if (vt.reloc != nil && vt.reloc.has_elf
        && ((vt.reloc.elf.build_attributes == nil) != (vt.reloc.elf.merge_attributes == nil))) { ret false; }
    if (vt.reloc != nil && vt.reloc.elf.has_attributes
        && (str_len(vt.reloc.elf.attributes.section) == 0
            || str_len(vt.reloc.elf.attributes.vendor) == 0)) { ret false; }
    if (vt.elf_machine != 0
        && (vt.reloc == nil || vt.reloc.apply == nil || vt.reloc.traits == nil
            || !vt.reloc.has_elf || vt.reloc.elf.reloc_type == nil)) { ret false; }
    if (vt.model.reserved_len < 0
        || (vt.model.reg_class_len > 0 && vt.model.reg_classes == nil)
        || (vt.model.reserved_len > 0 && vt.model.reserved_regs == nil)
        || (vt.model.packed_gap_len > 0 && vt.model.packed_gaps == nil)) { ret false; }
    var ci: u32 = 0;
    for (ci < vt.model.reg_class_len) {
        if (str_len(vt.model.reg_classes[ci].name) == 0) { ret false; }
        var cj: u32 = 0;
        for (cj < ci) {
            if (vt.model.reg_classes[cj].kind == vt.model.reg_classes[ci].kind
                || str_equals(vt.model.reg_classes[cj].name, vt.model.reg_classes[ci].name)) { ret false; }
            cj = cj + 1;
        }
        ci = ci + 1;
    }
    if (vt.defs != nil) {
        if ((vt.defs.op_count > 0 && vt.defs.ops == nil)
            || (vt.defs.type_count > 0 && vt.defs.types == nil)) { ret false; }
        var oi: u32 = 0;
        for (oi < vt.defs.op_count) {
            if (str_len(vt.defs.ops[oi].set) == 0 || str_len(vt.defs.ops[oi].name) == 0) { ret false; }
            var oj: u32 = 0;
            for (oj < oi) {
                if ((str_equals(vt.defs.ops[oj].set, vt.defs.ops[oi].set)
                     && str_equals(vt.defs.ops[oj].name, vt.defs.ops[oi].name))
                    || (vt.defs.ops[oj].set_tag == vt.defs.ops[oi].set_tag
                        && vt.defs.ops[oj].opcode == vt.defs.ops[oi].opcode)) { ret false; }
                oj = oj + 1;
            }
            oi = oi + 1;
        }
        var operand_count: u32 = 0;
        var ti: u32 = 0;
        for (ti < vt.defs.type_count) {
            if (str_len(vt.defs.types[ti].name) == 0
                || (vt.defs.types[ti].arity > 0 && vt.defs.types[ti].operands == nil)
                || operand_count + vt.defs.types[ti].arity < operand_count) { ret false; }
            var tj: u32 = 0;
            for (tj < ti) {
                if (vt.defs.types[tj].tag == vt.defs.types[ti].tag
                    || str_equals(vt.defs.types[tj].name, vt.defs.types[ti].name)) { ret false; }
                tj = tj + 1;
            }
            operand_count = operand_count + vt.defs.types[ti].arity;
            ti = ti + 1;
        }
    }
    ret true;
}

pub fun registry_validate(reg: *IsaRegistry) R.Result[R.Void, str] {
    if (reg == nil) { ret R.err[R.Void, str]("mach.lang.target.isa: nil registry"); }
    if (!reg.alloc_ready || reg.count > ISA_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.isa: invalid registry backing or count");
    }
    var i: u32 = 0;
    for (i < reg.count) {
        val entry: *IsaRegistryEntry = ?reg.entries[i];
        val vt: *IsaVTable = ?entry.descriptor;
        if (!descriptor_valid(vt)
            || vt.model != ?entry.model
            || (vt.machine != nil && vt.machine != ?entry.machine)
            || (vt.emitter != nil && vt.emitter != ?entry.emitter)
            || (vt.reloc != nil && vt.reloc != ?entry.reloc)
            || (vt.defs != nil && vt.defs != ?entry.defs)) {
            ret R.err[R.Void, str]("mach.lang.target.isa: registry contains an invalid owned descriptor");
        }
        if ((entry.model.reg_class_len > 0 && entry.reg_classes == nil)
            || (entry.model.reserved_len > 0 && entry.model_reserved == nil)
            || (entry.model.packed_gap_len > 0 && entry.packed_gaps == nil)
            || (vt.machine != nil && vt.machine.reserved_reg_count > 0 && entry.machine_reserved == nil)
            || (vt.machine != nil && vt.machine.reload_scratch_count > 0 && entry.reload_scratch == nil)
            || (vt.defs != nil && vt.defs.op_count > 0 && entry.op_defs == nil)
            || (vt.defs != nil && vt.defs.type_count > 0 && entry.type_defs == nil)) {
            ret R.err[R.Void, str]("mach.lang.target.isa: registry owned storage is incomplete");
        }
        if (vt.defs != nil) {
            var operands: u32 = 0;
            var ti: u32 = 0;
            for (ti < vt.defs.type_count) {
                if (operands > entry.type_operand_count
                    || vt.defs.types[ti].arity > entry.type_operand_count - operands) {
                    ret R.err[R.Void, str]("mach.lang.target.isa: registry type operand bounds are inconsistent");
                }
                if (vt.defs.types[ti].arity > 0
                    && (entry.type_operands == nil || vt.defs.types[ti].operands != ?entry.type_operands[operands])) {
                    ret R.err[R.Void, str]("mach.lang.target.isa: registry type operand storage is inconsistent");
                }
                if (vt.defs.types[ti].arity == 0 && vt.defs.types[ti].operands != nil) {
                    ret R.err[R.Void, str]("mach.lang.target.isa: zero-arity type owns unexpected operand storage");
                }
                operands = operands + vt.defs.types[ti].arity;
                ti = ti + 1;
            }
            if (operands != entry.type_operand_count
                || (operands > 0 && entry.type_operands == nil)
                || (operands == 0 && entry.type_operands != nil)) {
                ret R.err[R.Void, str]("mach.lang.target.isa: registry type operand count is inconsistent");
            }
        }
        var j: u32 = 0;
        for (j < i) {
            if (entry.descriptor.id == reg.entries[j].descriptor.id
                || str_equals(entry.descriptor.name, reg.entries[j].descriptor.name)) {
                ret R.err[R.Void, str]("mach.lang.target.isa: registry contains a duplicate identity");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun register(reg: *IsaRegistry, vt: *IsaVTable) R.Result[R.Void, str] {
    if (reg == nil) {
        ret R.err[R.Void, str]("mach.lang.target.isa: register called with a nil registry");
    }
    if (reg.count > ISA_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.isa: registry count exceeds its backing capacity");
    }
    if (vt == nil) {
        ret R.err[R.Void, str]("mach.lang.target.isa: register called with a nil descriptor");
    }
    if (str_len(vt.name) == 0) {
        ret R.err[R.Void, str]("mach.lang.target.isa: register called with an empty name");
    }
    if (vt.id == ARCH_UNKNOWN) {
        ret R.err[R.Void, str]("mach.lang.target.isa: register called with the unknown instruction-set id");
    }
    if (O.is_some[*IsaVTable](lookup(reg, vt.name))) {
        ret R.err[R.Void, str](errf("mach.lang.target.isa: an instruction set is already registered under this name",
            "mach.lang.target.isa: an instruction set named '{}' is already registered", vt.name));
    }
    if (dup_id(reg, vt.id)) {
        ret R.err[R.Void, str](errf("mach.lang.target.isa: an instruction set is already registered under this id",
            "mach.lang.target.isa: instruction set id {} is already registered (wanted to register '{}')", vt.id, vt.name));
    }
    if (reg.count >= ISA_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.isa: registry is at capacity; raise ISA_REGISTRY_CAP to register another instruction set");
    }
    if (!reg.alloc_ready) {
        ret R.err[R.Void, str]("mach.lang.target.isa: registry backing allocator is unavailable");
    }
    if (vt.model == nil || vt.pointer_width == 0 || vt.model.pointer_width != vt.pointer_width) {
        ret R.err[R.Void, str](errf("mach.lang.target.isa: an instruction set must declare a matching machine model",
            "mach.lang.target.isa: instruction set '{}' has no model or its model pointer width does not match the descriptor", vt.name));
    }

    val has_machine: bool = vt.machine != nil;
    val has_emitter: bool = vt.emitter != nil;
    if (has_machine == has_emitter) {
        var reason: str = "declares both a native and a whole-module backend";
        if (!has_machine) { reason = "declares neither a native nor a whole-module backend"; }
        ret R.err[R.Void, str](errf("mach.lang.target.isa: an instruction set must declare exactly one backend family",
            "mach.lang.target.isa: instruction set '{}' {} (exactly one native or whole-module backend is required)",
            vt.name, reason));
    }
    if (has_machine) {
        if (vt.machine.select == nil || vt.machine.encode == nil
            || vt.machine.is_reg_move == nil || vt.machine.is_trap_terminator == nil) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: a native backend must declare its mandatory callbacks",
                "mach.lang.target.isa: instruction set '{}' is missing `select`, `encode`, `is_reg_move`, or `is_trap_terminator`", vt.name));
        }
        if (vt.reloc != nil && (vt.reloc.apply == nil || vt.reloc.traits == nil)) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: a declared relocation seam must carry its required hooks",
                "mach.lang.target.isa: instruction set '{}' declares a relocation seam missing `apply` or `traits`", vt.name));
        }
        if (vt.machine.has_assembly
            && (vt.machine.assembly.emit == nil || vt.machine.assembly.clobbers == nil
                || vt.machine.assembly.returns == nil || vt.machine.assembly.ct_scan == nil)) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: an assembly capability group must be complete",
                "mach.lang.target.isa: instruction set '{}' declares only part of its assembly capability group", vt.name));
        }
        if (!vt.machine.has_assembly
            && (vt.machine.assembly.emit != nil || vt.machine.assembly.clobbers != nil
                || vt.machine.assembly.returns != nil || vt.machine.assembly.ct_scan != nil)) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: disabled assembly capabilities cannot carry callbacks",
                "mach.lang.target.isa: instruction set '{}' carries assembly callbacks while declaring the group unsupported", vt.name));
        }
    }
    if (has_emitter) {
        if (vt.emitter.emit_module == nil) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: a whole-module backend must declare its emitter",
                "mach.lang.target.isa: instruction set '{}' has no `emit_module` callback", vt.name));
        }
        if (vt.reloc != nil) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: a whole-module backend cannot also carry a relocation seam",
                "mach.lang.target.isa: instruction set '{}' emits whole modules but also declares a relocation seam; the two emission shapes are exclusive", vt.name));
        }
    }
    if (vt.reloc != nil && vt.reloc.has_elf
        && ((vt.reloc.elf.build_attributes == nil) != (vt.reloc.elf.merge_attributes == nil))) {
        ret R.err[R.Void, str](errf("mach.lang.target.isa: ELF attribute construction and merging must be declared together",
            "mach.lang.target.isa: instruction set '{}' declares only one of the ELF attribute build and merge hooks", vt.name));
    }
    if (vt.elf_machine != 0) {
        if (vt.reloc == nil || vt.reloc.apply == nil || vt.reloc.traits == nil
            || !vt.reloc.has_elf || vt.reloc.elf.reloc_type == nil) {
            ret R.err[R.Void, str](errf("mach.lang.target.isa: an ELF-covered instruction set must declare a complete relocation seam",
                "mach.lang.target.isa: instruction set '{}' declares an ELF machine but its relocation seam is missing `apply`, `traits`, or the ELF relocation mapper", vt.name));
        }
    }

    if (vt.model != nil) {
        if (vt.model.reserved_len < 0) {
            ret R.err[R.Void, str]("mach.lang.target.isa: machine model declares a negative reserved-register count");
        }
        if ((vt.model.reg_class_len > 0 && vt.model.reg_classes == nil)
            || (vt.model.reserved_len > 0 && vt.model.reserved_regs == nil)
            || (vt.model.packed_gap_len > 0 && vt.model.packed_gaps == nil)) {
            ret R.err[R.Void, str]("mach.lang.target.isa: machine model declares nonempty backing without storage");
        }
        var ci: u32 = 0;
        for (ci < vt.model.reg_class_len) {
            if (str_len(vt.model.reg_classes[ci].name) == 0) {
                ret R.err[R.Void, str]("mach.lang.target.isa: register class declares an empty name");
            }
            ci = ci + 1;
        }
    }
    if (vt.machine != nil
        && (vt.machine.reserved_reg_count < 0 || vt.machine.reload_scratch_count < 0)) {
        ret R.err[R.Void, str]("mach.lang.target.isa: native machine declares a negative register count");
    }
    if (vt.defs != nil) {
        if ((vt.defs.op_count > 0 && vt.defs.ops == nil)
            || (vt.defs.type_count > 0 && vt.defs.types == nil)) {
            ret R.err[R.Void, str]("mach.lang.target.isa: target definitions omit their declared storage");
        }
        var operand_count: u32 = 0;
        var oi: u32 = 0;
        for (oi < vt.defs.op_count) {
            if (str_len(vt.defs.ops[oi].set) == 0 || str_len(vt.defs.ops[oi].name) == 0) {
                ret R.err[R.Void, str]("mach.lang.target.isa: operation definition declares an empty set or name");
            }
            oi = oi + 1;
        }
        var ti: u32 = 0;
        for (ti < vt.defs.type_count) {
            if (str_len(vt.defs.types[ti].name) == 0) {
                ret R.err[R.Void, str]("mach.lang.target.isa: type definition declares an empty name");
            }
            if (vt.defs.types[ti].arity > 0 && vt.defs.types[ti].operands == nil) {
                ret R.err[R.Void, str]("mach.lang.target.isa: target type definition omits its operand storage");
            }
            if (operand_count + vt.defs.types[ti].arity < operand_count) {
                ret R.err[R.Void, str]("mach.lang.target.isa: target type operand count overflows");
            }
            operand_count = operand_count + vt.defs.types[ti].arity;
            ti = ti + 1;
        }
    }
    if (vt.machine != nil
        && ((vt.machine.reserved_reg_count > 0 && vt.machine.reserved_regs == nil)
            || (vt.machine.reload_scratch_count > 0 && vt.machine.reload_scratch_regs == nil))) {
        ret R.err[R.Void, str]("mach.lang.target.isa: native machine declares nonempty register backing without storage");
    }
    if (!descriptor_valid(vt)) {
        ret R.err[R.Void, str]("mach.lang.target.isa: descriptor contains an ambiguous or malformed nested capability");
    }

    val entry: *IsaRegistryEntry = ?reg.entries[reg.count];
    entry.descriptor = @vt;
    entry.descriptor.name = nil;
    entry.descriptor.reloc = nil;
    entry.reg_classes = nil;
    entry.model_reserved = nil;
    entry.machine_reserved = nil;
    entry.reload_scratch = nil;
    entry.packed_gaps = nil;
    entry.envs = nil;
    entry.op_defs = nil;
    entry.type_defs = nil;
    entry.type_operands = nil;
    entry.type_operand_count = 0;
    val r_descriptor_name: R.Result[str, str] = str_copy(?reg.alloc, vt.name);
    if (R.is_err[str, str](r_descriptor_name)) {
        release_entry(reg, entry);
        ret R.err[R.Void, str](R.unwrap_err[str, str](r_descriptor_name));
    }
    entry.descriptor.name = R.unwrap_ok[str, str](r_descriptor_name);
    entry.descriptor.envs = nil;
    if (vt.env_count > 0) {
        if (vt.envs == nil) { release_entry(reg, entry); ret R.err[R.Void, str]("mach.lang.target.isa: instruction set declares environments without storage"); }
        val r_envs: R.Result[*Environment, str] = own_copy[Environment](?reg.alloc, vt.envs, vt.env_count::usize);
        if (R.is_err[*Environment, str](r_envs)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*Environment, str](r_envs)); }
        entry.envs = R.unwrap_ok[*Environment, str](r_envs);
        var ei: u32 = 0;
        for (ei < vt.env_count) { entry.envs[ei].name = nil; ei = ei + 1; }
        ei = 0;
        for (ei < vt.env_count) {
            if (str_len(vt.envs[ei].name) == 0) { release_entry(reg, entry); ret R.err[R.Void, str]("mach.lang.target.isa: an environment declares an empty name"); }
            val r_env_name: R.Result[str, str] = str_copy(?reg.alloc, vt.envs[ei].name);
            if (R.is_err[str, str](r_env_name)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](r_env_name)); }
            entry.envs[ei].name = R.unwrap_ok[str, str](r_env_name);
            var ej: u32 = 0;
            for (ej < ei) {
                if (str_equals(entry.envs[ej].name, entry.envs[ei].name)) { release_entry(reg, entry); ret R.err[R.Void, str]("mach.lang.target.isa: an instruction set declares one environment twice"); }
                ej = ej + 1;
            }
            ei = ei + 1;
        }
        entry.descriptor.envs = entry.envs;
    }
    if (vt.model != nil) {
        entry.model = @(vt.model);
        val r_reg_classes: R.Result[*RegClass, str] = own_space[RegClass](?reg.alloc, vt.model.reg_class_len::usize);
        if (R.is_err[*RegClass, str](r_reg_classes)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*RegClass, str](r_reg_classes)); }
        entry.reg_classes = R.unwrap_ok[*RegClass, str](r_reg_classes);
        var ci: u32 = 0;
        for (ci < vt.model.reg_class_len) {
            entry.reg_classes[ci].name = nil;
            ci = ci + 1;
        }
        ci = 0;
        for (ci < vt.model.reg_class_len) {
            entry.reg_classes[ci].kind = vt.model.reg_classes[ci].kind;
            entry.reg_classes[ci].len  = vt.model.reg_classes[ci].len;
            val r_class_name: R.Result[str, str] = str_copy(?reg.alloc, vt.model.reg_classes[ci].name);
            if (R.is_err[str, str](r_class_name)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](r_class_name)); }
            entry.reg_classes[ci].name = R.unwrap_ok[str, str](r_class_name);
            ci = ci + 1;
        }
        entry.model.reg_classes = entry.reg_classes;
        val r_model_reserved: R.Result[*Register, str] = own_copy[Register](?reg.alloc, vt.model.reserved_regs, vt.model.reserved_len::usize);
        if (R.is_err[*Register, str](r_model_reserved)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*Register, str](r_model_reserved)); }
        entry.model_reserved = R.unwrap_ok[*Register, str](r_model_reserved);
        entry.model.reserved_regs = entry.model_reserved;
        val r_packed_gaps: R.Result[*PackedGap, str] = own_copy[PackedGap](?reg.alloc, vt.model.packed_gaps, vt.model.packed_gap_len::usize);
        if (R.is_err[*PackedGap, str](r_packed_gaps)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*PackedGap, str](r_packed_gaps)); }
        entry.packed_gaps = R.unwrap_ok[*PackedGap, str](r_packed_gaps);
        entry.model.packed_gaps = entry.packed_gaps;
        entry.descriptor.model = ?entry.model;
    }
    if (vt.machine != nil) {
        entry.machine = @(vt.machine);
        val r_machine_reserved: R.Result[*Register, str] = own_copy[Register](?reg.alloc, vt.machine.reserved_regs, vt.machine.reserved_reg_count::usize);
        if (R.is_err[*Register, str](r_machine_reserved)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*Register, str](r_machine_reserved)); }
        entry.machine_reserved = R.unwrap_ok[*Register, str](r_machine_reserved);
        entry.machine.reserved_regs = entry.machine_reserved;
        val r_reload_scratch: R.Result[*Register, str] = own_copy[Register](?reg.alloc, vt.machine.reload_scratch_regs, vt.machine.reload_scratch_count::usize);
        if (R.is_err[*Register, str](r_reload_scratch)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*Register, str](r_reload_scratch)); }
        entry.reload_scratch = R.unwrap_ok[*Register, str](r_reload_scratch);
        entry.machine.reload_scratch_regs = entry.reload_scratch;
        entry.descriptor.machine = ?entry.machine;
    }
    if (vt.emitter != nil) {
        entry.emitter = @(vt.emitter);
        entry.descriptor.emitter = ?entry.emitter;
    }
    if (vt.reloc != nil) {
        entry.reloc = @(vt.reloc);
        entry.descriptor.reloc = ?entry.reloc;
        if (entry.reloc.elf.has_attributes) {
            entry.reloc.elf.attributes.section = nil;
            entry.reloc.elf.attributes.vendor = nil;
            val section_r: R.Result[str, str] = str_copy(?reg.alloc, vt.reloc.elf.attributes.section);
            if (R.is_err[str, str](section_r)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](section_r)); }
            entry.reloc.elf.attributes.section = R.unwrap_ok[str, str](section_r);
            val vendor_r: R.Result[str, str] = str_copy(?reg.alloc, vt.reloc.elf.attributes.vendor);
            if (R.is_err[str, str](vendor_r)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](vendor_r)); }
            entry.reloc.elf.attributes.vendor = R.unwrap_ok[str, str](vendor_r);
        }
    }
    if (vt.defs != nil) {
        entry.defs = @(vt.defs);
        val r_op_defs: R.Result[*OpDef, str] = own_space[OpDef](?reg.alloc, vt.defs.op_count::usize);
        if (R.is_err[*OpDef, str](r_op_defs)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*OpDef, str](r_op_defs)); }
        entry.op_defs = R.unwrap_ok[*OpDef, str](r_op_defs);
        var oi: u32 = 0;
        for (oi < vt.defs.op_count) {
            entry.op_defs[oi].set = nil;
            entry.op_defs[oi].name = nil;
            oi = oi + 1;
        }
        oi = 0;
        for (oi < vt.defs.op_count) {
            entry.op_defs[oi].set_tag = vt.defs.ops[oi].set_tag;
            entry.op_defs[oi].opcode  = vt.defs.ops[oi].opcode;
            entry.op_defs[oi].arity   = vt.defs.ops[oi].arity;
            val r_op_set: R.Result[str, str] = str_copy(?reg.alloc, vt.defs.ops[oi].set);
            if (R.is_err[str, str](r_op_set)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](r_op_set)); }
            entry.op_defs[oi].set = R.unwrap_ok[str, str](r_op_set);
            val r_op_name: R.Result[str, str] = str_copy(?reg.alloc, vt.defs.ops[oi].name);
            if (R.is_err[str, str](r_op_name)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](r_op_name)); }
            entry.op_defs[oi].name = R.unwrap_ok[str, str](r_op_name);
            oi = oi + 1;
        }
        entry.defs.ops = entry.op_defs;
        var operand_at: u32 = 0;
        var ti: u32 = 0;
        for (ti < vt.defs.type_count) {
            operand_at = operand_at + vt.defs.types[ti].arity;
            ti = ti + 1;
        }
        entry.type_operand_count = operand_at;
        val r_type_defs: R.Result[*TypeDef, str] = own_space[TypeDef](?reg.alloc, vt.defs.type_count::usize);
        if (R.is_err[*TypeDef, str](r_type_defs)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*TypeDef, str](r_type_defs)); }
        entry.type_defs = R.unwrap_ok[*TypeDef, str](r_type_defs);
        ti = 0;
        for (ti < vt.defs.type_count) {
            entry.type_defs[ti].name = nil;
            ti = ti + 1;
        }
        ti = 0;
        for (ti < vt.defs.type_count) {
            entry.type_defs[ti].tag = vt.defs.types[ti].tag;
            entry.type_defs[ti].operands = nil;
            entry.type_defs[ti].arity = vt.defs.types[ti].arity;
            entry.type_defs[ti].refuse = vt.defs.types[ti].refuse;
            val r_type_name: R.Result[str, str] = str_copy(?reg.alloc, vt.defs.types[ti].name);
            if (R.is_err[str, str](r_type_name)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](r_type_name)); }
            entry.type_defs[ti].name = R.unwrap_ok[str, str](r_type_name);
            ti = ti + 1;
        }
        val r_type_operands: R.Result[*u32, str] = own_space[u32](?reg.alloc, entry.type_operand_count::usize);
        if (R.is_err[*u32, str](r_type_operands)) { release_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[*u32, str](r_type_operands)); }
        entry.type_operands = R.unwrap_ok[*u32, str](r_type_operands);
        operand_at = 0;
        ti = 0;
        for (ti < vt.defs.type_count) {
            if (vt.defs.types[ti].arity > 0) {
                entry.type_defs[ti].operands = ?entry.type_operands[operand_at];
                var ai: u32 = 0;
                for (ai < vt.defs.types[ti].arity) {
                    entry.type_operands[operand_at + ai] = vt.defs.types[ti].operands[ai];
                    ai = ai + 1;
                }
                operand_at = operand_at + vt.defs.types[ti].arity;
            } or {
                entry.type_defs[ti].operands = nil;
            }
            ti = ti + 1;
        }
        entry.defs.types = entry.type_defs;
        entry.descriptor.defs = ?entry.defs;
    }
    reg.count = reg.count + 1;
    ret R.ok_void[str]();
}

pub fun lookup(reg: *IsaRegistry, name: str) O.Option[*IsaVTable] {
    if (reg == nil || reg.count > ISA_REGISTRY_CAP) { ret O.none[*IsaVTable](); }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].descriptor.name, name)) { ret O.some[*IsaVTable](?reg.entries[i].descriptor); }
        i = i + 1;
    }
    ret O.none[*IsaVTable]();
}

pub fun registered_count(reg: *IsaRegistry) u32 {
    if (reg == nil || reg.count > ISA_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun registered(reg: *IsaRegistry, idx: u32) O.Option[*IsaVTable] {
    if (reg == nil || reg.count > ISA_REGISTRY_CAP || idx >= reg.count) { ret O.none[*IsaVTable](); }
    ret O.some[*IsaVTable](?reg.entries[idx].descriptor);
}

pub fun has_codegen(vt: *IsaVTable) bool {
    ret vt.machine != nil || vt.emitter != nil;
}

pub fun emits_whole_module(vt: *IsaVTable) bool {
    ret vt.emitter != nil;
}

pub fun emits_relocations(vt: *IsaVTable) bool {
    ret vt.reloc != nil;
}

pub def BackendKind: u8;
pub val BACKEND_NATIVE:       BackendKind = 0;
pub val BACKEND_WHOLE_MODULE: BackendKind = 1;

pub rec BackendFamily {
    kind:   BackendKind;
    native: *RegMachine;
}

pub fun backend_family(vt: *IsaVTable) BackendFamily {
    var f: BackendFamily;
    if (vt.machine != nil && vt.emitter == nil) {
        f.kind         = BACKEND_NATIVE;
        f.native       = vt.machine;
        ret f;
    }
    if (vt.emitter != nil && vt.machine == nil) {
        f.kind         = BACKEND_WHOLE_MODULE;
        f.native       = nil;
        ret f;
    }
    panic("mach.lang.target.isa: backend_family called on an instruction set with a contradictory backend; register() should have refused this\n");
    ret f;
}

pub fun is_native(f: *BackendFamily) bool {
    ret f.kind == BACKEND_NATIVE;
}

pub fun is_whole_module(f: *BackendFamily) bool {
    ret f.kind == BACKEND_WHOLE_MODULE;
}

pub fun as_native(f: *BackendFamily) *RegMachine {
    if (f.kind != BACKEND_NATIVE) {
        panic("mach.lang.target.isa: as_native called on a non-native backend family\n");
    }
    ret f.native;
}

fun operand_blank(kind: OperandKind, size: u8) Operand {
    var op: Operand;
    op.kind   = kind;
    op.size   = size;
    op.reg    = -1;
    op.imm    = 0;
    op.base   = -1;
    op.index  = -1;
    op.scale  = 0;
    op.disp   = 0;
    op.sym_id = 0;
    op.label  = nil;
    op.sym_mod = SYM_MOD_NONE;
    op.sym_addend = 0;
    ret op;
}

pub fun make_sym_mod(sym_id: u32, size: u8, mod: SymModifier) Operand {
    var op: Operand = make_sym(sym_id, size);
    op.sym_mod = mod;
    ret op;
}

pub fun make_sym_addend(sym_id: u32, size: u8, mod: SymModifier, addend: i32) Operand {
    var op: Operand = make_sym_mod(sym_id, size, mod);
    op.sym_addend = addend;
    ret op;
}

pub fun inst_blank() Inst {
    var mi: Inst;
    mi.opcode   = 0;
    mi.dst      = make_none();
    mi.src1     = make_none();
    mi.src2     = make_none();
    mi.size     = 0;
    mi.flags    = 0;
    mi.clobbers = 0;
    mi.src_line = 0;
    mi.src_file = nil;
    ret mi;
}

test "mach.lang.target.isa.arch_id_for:name_roundtrip" {
    if (arch_id_for("x86_64") != ARCH_X86_64)   { ret 1; }
    if (arch_id_for("aarch64") != ARCH_AARCH64) { ret 1; }
    if (arch_id_for("riscv64") != ARCH_RISCV64) { ret 1; }
    if (arch_id_for("riscv32") != ARCH_RISCV32) { ret 1; }
    if (arch_id_for("mos6502") != ARCH_MOS6502) { ret 1; }
    if (arch_id_for("spirv")   != ARCH_SPIRV)   { ret 1; }
    if (arch_id_for("riscv") != ARCH_UNKNOWN)   { ret 1; }
    if (ARCH_RISCV32 == ARCH_RISCV64)           { ret 1; }

    if (!str_equals(arch_name_for(ARCH_X86_64), "x86_64"))   { ret 1; }
    if (!str_equals(arch_name_for(ARCH_AARCH64), "aarch64")) { ret 1; }
    if (!str_equals(arch_name_for(ARCH_RISCV64), "riscv64")) { ret 1; }
    if (!str_equals(arch_name_for(ARCH_RISCV32), "riscv32")) { ret 1; }
    if (!str_equals(arch_name_for(ARCH_MOS6502), "mos6502")) { ret 1; }
    if (!str_equals(arch_name_for(ARCH_SPIRV),   "spirv"))   { ret 1; }
    if (!str_equals(arch_name_for(ARCH_UNKNOWN), "unknown")) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.arch_catalog:complete_unique_ordered_roundtrip" {
    if (ARCHS[0].arch != ARCH_X86_64)  { ret 1; }
    if (ARCHS[1].arch != ARCH_AARCH64) { ret 1; }
    if (ARCHS[2].arch != ARCH_RISCV64) { ret 1; }
    if (ARCHS[3].arch != ARCH_MOS6502) { ret 1; }
    if (ARCHS[4].arch != ARCH_SPIRV)   { ret 1; }
    if (ARCHS[5].arch != ARCH_RISCV32) { ret 1; }

    var i: usize = 0;
    for (i < ARCH_N) {
        if (ARCHS[i].fingerprint_tag != (i + 1)::u8) { ret 1; }
        if (arch_id_for(ARCHS[i].spelling) != ARCHS[i].arch) { ret 1; }
        if (!str_equals(arch_name_for(ARCHS[i].arch), ARCHS[i].spelling)) { ret 1; }

        var j: usize = 0;
        for (j < ARCH_N) {
            if (i != j) {
                if (ARCHS[i].arch == ARCHS[j].arch) { ret 1; }
                if (str_equals(ARCHS[i].spelling, ARCHS[j].spelling)) { ret 1; }
                if (ARCHS[i].fingerprint_tag == ARCHS[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.isa.regid_make:compose_decompose" {
    val gp: i32 = regid_make(REG_CLASS_ID_GP, 7);
    if (gp != 7)                            { ret 1; }
    if (regid_class(gp) != REG_CLASS_ID_GP) { ret 1; }
    if (regid_index(gp) != 7)               { ret 1; }

    val xmm: i32 = regid_make(REG_CLASS_ID_XMM, 3);
    if (xmm != 0x0103)                        { ret 1; }
    if (regid_class(xmm) != REG_CLASS_ID_XMM) { ret 1; }
    if (regid_index(xmm) != 3)                { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.make_mem:fields" {
    val m: Operand = make_mem(1, 16, 2, 4, 8);
    if (m.kind != OPK_MEM) { ret 1; }
    if (m.base != 1)       { ret 1; }
    if (m.disp != 16)      { ret 1; }
    if (m.index != 2)      { ret 1; }
    if (m.scale != 4)      { ret 1; }
    if (m.size != 8)       { ret 1; }
    if (m.reg != -1)       { ret 1; }

    val r: Operand = make_reg(5, 8);
    if (r.kind != OPK_REG) { ret 1; }
    if (r.reg != 5)        { ret 1; }
    if (r.base != -1)      { ret 1; }
    ret 0;
}

fun t_machine() RegMachine {
    ret reg_machine(t_select, t_encode, t_is_reg_move, t_is_trap_terminator,
                    nil, 0, nil, 0,
                    -1, -1,
                    -1, -1, 0,
                    -1, -1, -1);
}

fun t_select(alloc: *A.Allocator, tgt: *BackendTarget, f: *mir.MirFunction) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_encode(alloc: *A.Allocator, tgt: *BackendTarget,
             m: *mir.MirModule) R.Result[encoding.EncoderOutput, str] {
    var out: encoding.EncoderOutput;
    ret R.ok[encoding.EncoderOutput, str](out);
}

fun t_emit_module(alloc: *A.Allocator, tgt: *BackendTarget, u: *unit_input.Unit, bytes: **u8,
                  len: *u32) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_emit_asm(alloc: *A.Allocator, tgt: *BackendTarget, m: *mir.MirModule,
               out: *writer.Writer) R.Result[encoding.EncoderOutput, str] {
    var encoded: encoding.EncoderOutput;
    ret R.ok[encoding.EncoderOutput, str](encoded);
}

fun t_asm_clobbers(text: str, out: *u32, count: *u32) {
    @count = 0;
}

fun t_asm_returns(text: str) bool {
    ret false;
}

fun t_asm_ct_scan(text: str, names: *str, name_count: u32, trust_mul: bool,
                  trust_shift: bool, alloc: *A.Allocator) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_is_reg_move(opcode: u32) bool {
    ret false;
}

fun t_is_trap_terminator(opcode: u32) bool {
    ret false;
}

fun t_model(width: u32) MachineModel {
    var model: MachineModel;
    model.pointer_width = width;
    model.reg_classes = nil;
    model.reg_class_len = 0;
    model.reserved_regs = nil;
    model.reserved_len = 0;
    model.packed_gaps = nil;
    model.packed_gap_len = 0;
    ret model;
}

fun t_reloc() RelocSeam {
    ret reloc_seam(t_apply_reloc, t_reloc_traits, t_elf_reloc_type);
}

fun t_apply_reloc(kind: of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
                  tgt: of.RelocTarget, addend: i64, patch_va: u64,
                  image_base: u64) R.Result[bool, of.RelocError] {
    ret R.ok[bool, of.RelocError](true);
}

fun t_reloc_traits(kind: of.RelocKind, section: of.SectionKind,
                   codegen_image: bool) R.Result[of.RelocTraits, of.RelocError] {
    var t: of.RelocTraits;
    t.field_width   = 4;
    t.addend_mode   = of.RELOC_ADDEND_SYMBOL;
    t.text_bias_min = 0;
    t.text_bias_max = 0;
    ret R.ok[of.RelocTraits, of.RelocError](t);
}

fun t_elf_reloc_type(kind: of.RelocKind) u32 {
    ret 1;
}

fun t_normalize_image(alloc: *A.Allocator, image: *of.ObjectImage) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_build_attributes(alloc: *A.Allocator, xlen: u32, flen: u32,
                       compressed: bool, out_len: *u32) R.Result[*u8, str] {
    @out_len = 0;
    ret R.ok[*u8, str](nil);
}

fun t_merge_attributes(alloc: *A.Allocator, acc: *u8, acc_len: u32,
                       add: *u8, add_len: u32, out_len: *u32) R.Result[*u8, str] {
    @out_len = 0;
    ret R.ok[*u8, str](nil);
}

test "mach.lang.target.isa.register:write_once_and_enumerate" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (registered_count(?reg) != 0) { ret 1; }

    var m: RegMachine = t_machine();
    var rs: RelocSeam = t_reloc();
    var model: MachineModel = t_model(8);
    var vt: IsaVTable = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model, ?m, ?rs);
    if (R.is_err[R.Void, str](register(?reg, ?vt))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 1) { registry_dnit(?reg); ret 1; }

    val opt_vt: O.Option[*IsaVTable] = lookup(?reg, "x86_64");
    if (!O.is_some[*IsaVTable](opt_vt))      { registry_dnit(?reg); ret 1; }
    val stored: *IsaVTable = O.unwrap[*IsaVTable](opt_vt);
    if (stored == ?vt)                       { registry_dnit(?reg); ret 1; }
    if (stored.machine == ?m || stored.model == ?model || stored.reloc == ?rs) {
        registry_dnit(?reg);
        ret 1;
    }

    var m2: RegMachine = t_machine();
    var rs2: RelocSeam = t_reloc();
    var model2: MachineModel = t_model(8);
    var vt2: IsaVTable = machine_isa(ARCH_X86_64, "x86_64", 62, 8, ?model2, ?m2, ?rs2);
    if (!R.is_err[R.Void, str](register(?reg, ?vt2))) { registry_dnit(?reg); ret 1; }
    if (O.unwrap[*IsaVTable](lookup(?reg, "x86_64")) != stored) { registry_dnit(?reg); ret 1; }

    if (O.is_some[*IsaVTable](lookup(?reg, "aarch64"))) { registry_dnit(?reg); ret 1; }

    if (O.unwrap[*IsaVTable](registered(?reg, 0)) != stored) { registry_dnit(?reg); ret 1; }
    if (O.is_some[*IsaVTable](registered(?reg, 1)))          { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.family:payloads_are_exclusive" {
    var m: RegMachine = t_machine();
    var rs: RelocSeam = t_reloc();
    var mvt: IsaVTable = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (mvt.machine != ?m)         { ret 1; }
    if (mvt.emitter != nil)        { ret 1; }
    if (emits_whole_module(?mvt))  { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module);
    var evt: IsaVTable = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    if (evt.emitter == nil)        { ret 1; }
    if (evt.machine != nil)        { ret 1; }
    if (!emits_whole_module(?evt)) { ret 1; }

    if (evt.elf_machine != 0)      { ret 1; }
    if (evt.reloc != nil)          { ret 1; }
    if (emits_relocations(?evt))   { ret 1; }

    if (mvt.reloc != ?rs)          { ret 1; }
    if (!emits_relocations(?mvt))  { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.reloc_seam:required_then_optional" {
    var s: RelocSeam = t_reloc();
    if (s.apply == nil)              { ret 1; }
    if (s.traits == nil)             { ret 1; }
    if (!s.has_elf)                  { ret 1; }
    if (s.elf.reloc_type == nil)     { ret 1; }
    if (s.elf.has_attributes)        { ret 1; }
    if (s.normalize != nil)          { ret 1; }
    if (s.resolve_operand != nil)    { ret 1; }
    if (s.elf.build_attributes != nil) { ret 1; }
    if (s.elf.merge_attributes != nil) { ret 1; }

    var elf_attributes: of.ElfAttributes;
    elf_attributes.section = ".attributes";
    elf_attributes.sht = 1;
    elf_attributes.vendor = "test";
    with_elf_attributes(?s, ?elf_attributes);
    if (!s.elf.has_attributes) { ret 1; }
    with_normalize_image(?s, t_normalize_image);
    if (s.normalize == nil) { ret 1; }
    with_attributes(?s, t_build_attributes, t_merge_attributes);
    if (s.elf.build_attributes == nil) { ret 1; }
    if (s.elf.merge_attributes == nil) { ret 1; }

    var s2: RelocSeam = reloc_seam(t_apply_reloc, t_reloc_traits, nil);
    if (s2.apply == nil)          { ret 1; }
    if (s2.traits == nil)         { ret 1; }
    if (s2.has_elf)               { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.reg_machine:optionals_cleared_then_declared" {
    var m: RegMachine = t_machine();
    if (m.has_assembly)            { ret 1; }
    if (m.assembly.clobbers != nil) { ret 1; }
    if (m.assembly.ct_scan != nil)  { ret 1; }
    if (m.dwarf_reg != nil)    { ret 1; }
    if (m.cv_reg != nil)       { ret 1; }

    with_assembly(?m, t_emit_asm, t_asm_clobbers, t_asm_returns, t_asm_ct_scan);
    if (!m.has_assembly || m.assembly.emit == nil || m.assembly.clobbers == nil
        || m.assembly.returns == nil || m.assembly.ct_scan == nil) { ret 1; }

    with_dwarf_regs(?m, t_dwarf_reg);
    if (m.dwarf_reg == nil) { ret 1; }
    if (m.cv_reg != nil)    { ret 1; }
    if (m.dwarf_reg(3) != 3) { ret 1; }
    ret 0;
}

fun t_dwarf_reg(regid: i32) i32 {
    ret regid;
}

test "mach.lang.target.isa.has_codegen:per_family" {
    var m: RegMachine = t_machine();
    var rs: RelocSeam = t_reloc();
    var mvt: IsaVTable = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    if (!has_codegen(?mvt)) { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module);
    var evt: IsaVTable = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    if (!has_codegen(?evt)) { ret 1; }

    var dvt: IsaVTable = machine_isa(ARCH_MOS6502, "desc", 0, 2, nil, nil, nil);
    if (has_codegen(?dvt)) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.buf_append:growth" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var buf: InstBuf = buf_init(?alloc);
    if (buf.count != 0) { buf_dnit(?buf); ret 1; }
    if (buf.cap != 0)   { buf_dnit(?buf); ret 1; }

    var inst: Inst = inst_blank();
    var i: i32 = 0;
    for (i < INSTBUF_INIT_CAP + 1) {
        inst.opcode = i::u16;
        buf_append(?buf, inst);
        i = i + 1;
    }

    if (buf.err)                                                     { buf_dnit(?buf); ret 1; }
    if (buf.count != INSTBUF_INIT_CAP + 1)                           { buf_dnit(?buf); ret 1; }
    if (buf.cap < buf.count)                                         { buf_dnit(?buf); ret 1; }
    if (buf.insts[0].opcode != 0)                                    { buf_dnit(?buf); ret 1; }
    if (buf.insts[INSTBUF_INIT_CAP].opcode != INSTBUF_INIT_CAP::u16) { buf_dnit(?buf); ret 1; }

    buf_dnit(?buf);
    if (buf.count != 0) { ret 1; }
    if (buf.cap != 0)   { ret 1; }
    if (buf.err)        { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.packed_width:lane_count_ceiling" {
    var unbounded: MachineModel;
    unbounded.has_v128         = true;
    unbounded.vector_bits      = VECTOR_BITS_128;
    unbounded.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    unbounded.packed_gaps      = nil;
    unbounded.packed_gap_len   = 0;

    if (packed_width(?unbounded, VEC_OP_ADD, false, 8)  != 128) { ret 1; }
    if (packed_width(?unbounded, VEC_OP_ADD, false, 16) != 128) { ret 1; }
    if (packed_width(?unbounded, VEC_OP_ADD, false, 32) != 128) { ret 1; }
    if (packed_width(?unbounded, VEC_OP_ADD, true,  64) != 128) { ret 1; }
    if (packed_lane_cap(?unbounded, 8)  != 16) { ret 1; }
    if (packed_lane_cap(?unbounded, 32) != 4)  { ret 1; }

    var capped: MachineModel;
    capped.has_v128         = true;
    capped.vector_bits      = VECTOR_BITS_128;
    capped.max_vector_lanes = 4;
    capped.packed_gaps      = nil;
    capped.packed_gap_len   = 0;

    if (packed_width(?capped, VEC_OP_ADD, false, 8)  != 32)  { ret 1; }
    if (packed_width(?capped, VEC_OP_ADD, false, 16) != 64)  { ret 1; }
    if (packed_width(?capped, VEC_OP_ADD, false, 32) != 128) { ret 1; }
    if (packed_width(?capped, VEC_OP_ADD, true, 64) != 128) { ret 1; }
    if (packed_lane_cap(?capped, 8)  != 4) { ret 1; }
    if (packed_lane_cap(?capped, 16) != 4) { ret 1; }
    if (packed_lane_cap(?capped, 32) != 4) { ret 1; }
    if (packed_lane_cap(?capped, 64) != 2) { ret 1; }

    var gaps: [1]PackedGap;
    gaps[0].op = VEC_OP_MUL; gaps[0].is_float = false; gaps[0].lane_bits = 32;
    capped.packed_gaps    = ?gaps[0];
    capped.packed_gap_len = 1;
    if (packed_width(?capped, VEC_OP_MUL, false, 32) != 0)   { ret 1; }
    if (packed_width(?capped, VEC_OP_MUL, true,  32) != 128) { ret 1; }

    var none: MachineModel;
    none.has_v128         = false;
    none.max_vector_lanes = 4;
    if (packed_width(?none, VEC_OP_ADD, false, 32) != 0) { ret 1; }
    if (packed_lane_cap(?none, 32) != 0)                 { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.packed_width:honors_the_target_own_vector_width" {
    var wide: MachineModel;
    wide.has_v128         = true;
    wide.vector_bits      = 256;
    wide.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    wide.packed_gaps      = nil;
    wide.packed_gap_len   = 0;

    if (packed_width(?wide, VEC_OP_ADD, false, 32) != 256) { ret 1; }
    if (packed_lane_cap(?wide, 32) != 8)                   { ret 1; }
    if (packed_lane_cap(?wide, 64) != 4)                   { ret 1; }

    var narrow: MachineModel;
    narrow.has_v128         = true;
    narrow.vector_bits      = 64;
    narrow.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    narrow.packed_gaps      = nil;
    narrow.packed_gap_len   = 0;

    if (packed_width(?narrow, VEC_OP_ADD, false, 32) != 64) { ret 1; }
    if (packed_lane_cap(?narrow, 32) != 2)                  { ret 1; }

    var unset: MachineModel;
    unset.has_v128         = true;
    unset.vector_bits      = 0;
    unset.max_vector_lanes = VECTOR_LANES_UNBOUNDED;
    unset.packed_gaps      = nil;
    unset.packed_gap_len   = 0;

    if (packed_width(?unset, VEC_OP_ADD, false, 32) != 0) { ret 1; }
    if (packed_lane_cap(?unset, 32) != 0)                 { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.register:rejects_nil_and_empty_name" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    if (!R.is_err[R.Void, str](register(nil, nil))) { ret 1; }
    if (!R.is_err[R.Void, str](register(?reg, nil))) { ret 1; }

    var m: RegMachine = t_machine();
    var rs: RelocSeam = t_reloc();
    var model: MachineModel = t_model(8);
    var vt: IsaVTable = machine_isa(ARCH_X86_64, "", 62, 8, ?model, ?m, ?rs);
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    vt = machine_isa(ARCH_UNKNOWN, "unknown", 0, 8, ?model, ?m, ?rs);
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.register:rejects_empty_nested_names" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var classes: [1]RegClass;
    classes[0].name = ""; classes[0].kind = RC_GENERAL; classes[0].len = 4;
    var model: MachineModel = t_model(8);
    model.reg_classes = ?classes[0]; model.reg_class_len = 1;
    var machine: RegMachine = t_machine();
    var reloc: RelocSeam = t_reloc();
    var vt: IsaVTable = machine_isa(ARCH_X86_64, "bad_class", 62, 8,
                                     ?model, ?machine, ?reloc);
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }

    classes[0].name = "gp";
    var ops: [1]OpDef; ops[0] = op_def("", "op", 1, 2, 0);
    var types: [1]TypeDef; types[0] = type_def("ty", 7, nil, 0, nil);
    var defs: TargetDefs = target_defs(?ops[0], 1, ?types[0], 1);
    vt = machine_isa(ARCH_X86_64, "bad_set", 62, 8, ?model, ?machine, ?reloc);
    with_defs(?vt, ?defs);
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    ops[0].set = "core"; ops[0].name = "";
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    ops[0].name = "op"; types[0].name = "";
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.register:rejects_ambiguous_nested_identities" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var classes: [2]RegClass;
    classes[0].name = "gp"; classes[0].kind = RC_GENERAL; classes[0].len = 4;
    classes[1].name = "fp"; classes[1].kind = RC_GENERAL; classes[1].len = 4;
    var model: MachineModel = t_model(8);
    model.reg_classes = ?classes[0]; model.reg_class_len = 2;
    var machine: RegMachine = t_machine();
    var reloc: RelocSeam = t_reloc();
    var vt: IsaVTable = machine_isa(ARCH_X86_64, "duplicate_class_kind", 62, 8,
                                     ?model, ?machine, ?reloc);
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    classes[1].kind = RC_FLOAT; classes[1].name = "gp";
    vt.name = "duplicate_class_name";
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }

    classes[1].name = "fp";
    var ops: [2]OpDef;
    ops[0] = op_def("core", "add", 1, 1, 0);
    ops[1] = op_def("core", "add", 2, 2, 0);
    var types: [2]TypeDef;
    types[0] = type_def("word", 1, nil, 0, nil);
    types[1] = type_def("float", 2, nil, 0, nil);
    var defs: TargetDefs = target_defs(?ops[0], 2, ?types[0], 2);
    vt.name = "duplicate_op_name"; with_defs(?vt, ?defs);
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    ops[1] = op_def("ext", "sub", 1, 1, 0);
    vt.name = "duplicate_opcode";
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    ops[1] = op_def("ext", "sub", 2, 2, 0);
    types[1].name = "word"; vt.name = "duplicate_type_name";
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    types[1].name = "float"; types[1].tag = 1; vt.name = "duplicate_type_tag";
    if (!R.is_err[R.Void, str](register(?reg, ?vt))) { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

