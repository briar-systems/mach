    ret 0;
}

test register__rejects_malformed_assembly_group {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var model: target_model.Machine = target_model.t_model(8);
    var reloc: RelocSeam            = t_reloc();

    var partial: RegMachine = t_machine();
    with_assembly(?partial, t_asm_header, t_asm_clobbers, t_asm_returns, t_asm_ct_scan, t_asm_returns);
    partial.assembly.ct_scan = nil;
    var partial_vt: IsaVTable = machine_isa(ARCH_X86_64, "partial_asm", 62, 8,
        ?model, ?partial, ?reloc);
    val r_2674: err[fail.Fail] = register(?reg, ?partial_vt);
    if (!sel r_2674.err) {
        registry_dnit(?reg);
        ret 1;
    }

    var disabled: RegMachine = t_machine();
    disabled.assembly.header = t_asm_header;
    var disabled_vt: IsaVTable = machine_isa(ARCH_X86_64, "disabled_asm", 62, 8,
        ?model, ?disabled, ?reloc);
    val r_2680: err[fail.Fail] = register(?reg, ?disabled_vt);
    if (!sel r_2680.err) {
        registry_dnit(?reg);
        ret 1;
    }
    if (registered_count(?reg) != 0) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    ret 0;
}

test registry__owns_nested_storage_and_strings {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var descriptor_name: [6]u8;
    descriptor_name[0] = 'o';
    descriptor_name[1] = 'w';
    descriptor_name[2] = 'n';
    descriptor_name[3] = 'e';
    descriptor_name[4] = 'd';
    descriptor_name[5] = 0;
    var class_name: [3]u8;
    class_name[0] = 'g';
    class_name[1] = 'p';
    class_name[2] = 0;
    var op_set: [5]u8;
    op_set[0] = 'c';
    op_set[1] = 'o';
    op_set[2] = 'r';
    op_set[3] = 'e';
    op_set[4] = 0;
    var op_name: [3]u8;
    op_name[0] = 'o';
    op_name[1] = 'p';
    op_name[2] = 0;
    var type_name: [3]u8;
    type_name[0] = 't';
    type_name[1] = 'y';
    type_name[2] = 0;
    var attr_section: [6]u8;
    attr_section[0] = '.';
    attr_section[1] = 'a';
    attr_section[2] = 't';
    attr_section[3] = 't';
    attr_section[4] = 'r';
    attr_section[5] = 0;
    var attr_vendor: [7]u8;
    attr_vendor[0] = 'v';
    attr_vendor[1] = 'e';
    attr_vendor[2] = 'n';
    attr_vendor[3] = 'd';
    attr_vendor[4] = 'o';
    attr_vendor[5] = 'r';
    attr_vendor[6] = 0;

    var classes: [1]target_model.RegClass;
    classes[0].name = (?class_name[0])::str;
    classes[0].kind = target_model.RC_GENERAL;
    classes[0].len  = 4;
    var model_reserved: [1]target_model.Register;
    model_reserved[0].id   = 1;
    model_reserved[0].size = 8;
    var packed: [1]target_model.PackedForm;
    packed[0].op        = target_model.VEC_OP_MUL;
    packed[0].is_float  = false;
    packed[0].lane_bits = 32;
    packed[0].from_bits = 32;
    var scalar_len: u32                      = 0;
    val scalar:     *target_model.ScalarForm = t_scalar_rest(?reg.alloc, ?scalar_len, target_model.VEC_OP_MUL, false, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?reg.alloc, scalar); }
    var model: target_model.Machine = target_model.t_model(8);
    model.reg_classes     = ?classes[0];
    model.reg_class_len   = 1;
    model.reserved_regs   = ?model_reserved[0];
    model.reserved_len    = 1;
    model.has_v128        = true;
    model.vector_bits     = target_model.VECTOR_BITS_128;
    model.packed_forms    = ?packed[0];
    model.packed_form_len = 1;
    model.scalar_forms    = scalar;
    model.scalar_form_len = scalar_len;

    var machine_reserved: [1]target_model.Register;
    machine_reserved[0].id   = 2;
    machine_reserved[0].size = 8;
    var reload: [1]target_model.Register;
    reload[0].id   = 3;
    reload[0].size = 8;
    var machine: RegMachine = reg_machine(t_select, t_encode(), t_is_reg_move, t_is_trap_terminator,
        ?machine_reserved[0], 1, ?reload[0], 1,
        -1, -1, -1, -1, 0, -1, -1, -1);
    var reloc:      RelocSeam = t_reloc();
    var attributes: target_of.ElfAttributes;
    attributes.section = (?attr_section[0])::str;
    attributes.sht     = 0x70000003;
    attributes.vendor  = (?attr_vendor[0])::str;
    with_elf_attributes(?reloc, ?attributes);
    var operands: [1]u32;
    operands[0] = target_definition.TYPE_OPERAND_WORD;
    var ops: [1]target_definition.Op;
    ops[0] = target_definition.op((?op_set[0])::str, (?op_name[0])::str, 1, 2, 1);
    var types: [1]target_definition.Type;
    types[0] = target_definition.type((?type_name[0])::str, 7, ?operands[0], 1, nil);
    var definitions: target_definition.Table = target_definition.table(?ops[0], 1, ?types[0], 1);
    var vt:          IsaVTable               = machine_isa(ARCH_X86_64, (?descriptor_name[0])::str, 62, 8,
        ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);
    val r_2740: err[fail.Fail] = register(?reg, ?vt);
    if (sel r_2740.err) {
        registry_dnit(?reg);
        ret 1;
    }

    descriptor_name[0]     = 'x';
    class_name[0]          = 'x';
    op_set[0]              = 'x';
    op_name[0]             = 'x';
    type_name[0]           = 'x';
    attr_section[0]        = 'x';
    attr_vendor[0]         = 'x';
    classes[0].len         = 99;
    model_reserved[0].id   = 99;
    packed[0].lane_bits    = 99;
    scalar[0].lane_bits    = 99;
    machine_reserved[0].id = 99;
    reload[0].id           = 99;
    operands[0]            = 99;
    val found_o: opt[*IsaVTable] = lookup(?reg, "owned");
    if (sel found_o.none) {
        registry_dnit(?reg);
        ret 1;
    }
    val found: *IsaVTable = found_o.some;
    if (!str_equals(found.model.reg_classes[0].name, "gp")
        || found.model.reg_classes[0].len != 4 || found.model.reserved_regs[0].id != 1
        || found.model.packed_forms[0].lane_bits != 32
        || found.model.scalar_form_len != scalar_len || found.model.scalar_forms[0].lane_bits == 99
        || target_model.vector_form(found.model, target_model.VEC_OP_MUL, false, 32, 32) != target_model.FORM_PACKED
        || target_model.vector_form(found.model, target_model.VEC_OP_DIV, false, 32, 32) != target_model.FORM_SCALAR
        || found.machine.reserved_regs[0].id != 2 || found.machine.reload_scratch_regs[0].id != 3
        || !str_equals(found.reloc.elf.attributes.section, ".attr")
        || !str_equals(found.reloc.elf.attributes.vendor, "vendor")
        || !str_equals(found.defs.ops[0].set, "core") || !str_equals(found.defs.ops[0].name, "op")
        || !str_equals(found.defs.types[0].name, "ty") || found.defs.types[0].operands[0] != target_definition.TYPE_OPERAND_WORD) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test registry__zero_type_operands_need_no_storage {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var model:   target_model.Machine = target_model.t_model(8);
    var machine: RegMachine           = t_machine();
    var reloc:   RelocSeam            = t_reloc();
