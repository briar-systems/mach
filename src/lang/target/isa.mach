# every retained cell but the one packed row, as the scalar table a test model
# with a vector unit needs to register, in storage from `alloc` that holds the
# whole domain; nil when it cannot be had
#[testing]
fun t_scalar_rest(alloc: *A.Allocator, count: *u32, packed_op: target_model.VecOp, packed_float: bool, packed_bits: u32) *target_model.ScalarForm {
    val space: res[*target_model.ScalarForm, A.Error] = A.allocate[target_model.ScalarForm](alloc, target_model.vector_domain_len()::usize);
    if (sel space.err) { ret nil; }
    @count = t_scalar_fill(space.ok, packed_op, packed_float, packed_bits);
    ret space.ok;
}

# write every retained cell but the packed row's into `scalar`, which holds the
# whole domain; how many
#[testing]
fun t_scalar_fill(scalar: *target_model.ScalarForm, packed_op: target_model.VecOp, packed_float: bool, packed_bits: u32) u32 {
    var n:   u32 = 0;
    var i:   u32 = 0;
    val len: u32 = target_model.vector_domain_len();
    for (i < len) {
        var cell: target_model.ScalarForm;
        if (!target_model.vector_domain_cell(i, ?cell)) { ret n; }
        if (cell.op != packed_op || cell.is_float != packed_float || cell.lane_bits != packed_bits) {
            scalar[n] = cell;
            n         = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

#[testing]
fun t_scalar_free(alloc: *A.Allocator, scalar: *target_model.ScalarForm) {
    A.deallocate[target_model.ScalarForm](alloc, scalar, target_model.vector_domain_len()::usize);
}

