pub val ARCH_UNKNOWN: u32 = catalog_arch.UNKNOWN;
pub val ARCH_X86_64:  u32 = catalog_arch.X86_64;
pub val ARCH_AARCH64: u32 = catalog_arch.AARCH64;
pub val ARCH_RISCV64: u32 = catalog_arch.RISCV64;
pub val ARCH_SPIRV:   u32 = catalog_arch.SPIRV;
pub val ARCH_RISCV32: u32 = catalog_arch.RISCV32;

pub val ISA_LABEL:       u16 = 0xFFFF;
pub val ISA_PCOPY:       u16 = 0xFFFD;
pub val ISA_PCOPY_FENCE: u16 = 0xFFFC;
pub val ISA_USE:         u16 = 0xFFFB;

# a machine with a vector unit decides every retained cell; one without decides
# them all as the scalar expansion by declaring no unit
#[testing]
val CONVERT_CELL_COUNT: u32 = 72;

#[testing]
val WIDEN_CELL_COUNT: u32 = 33;

#[testing]
val SHIFT_CELL_COUNT: u32 = 24;

# declare the model's scalar table: `explicit`, then every cell of `families`
# its packed table leaves, family by family, in storage from the registry's
# allocator sized to exactly those rows. the caller releases it with
# release_scalar_rows once the model is registered, which copies it
# ---
# reg:          the registry whose allocator backs the rows
# m:            the model; its packed table is final, its scalar table is set
# explicit:     the rows the model names itself
# explicit_len: how many
# families:     the families whose unclaimed cells are scalar rows
pub fun declare_scalar_rows(reg: *IsaRegistry, m: *target_model.Machine, explicit: *target_model.ScalarForm, explicit_len: u32, families: target_model.ScalarFamily) err[fail.Fail] {
    if (reg == nil || !reg.alloc_ready) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.isa: registry backing allocator is unavailable")};
    }
    val len:   u32                                      = explicit_len + target_model.scalar_family_rows(m, nil, 0, families);
    val space: res[*target_model.ScalarForm, fail.Fail] = own_space[target_model.ScalarForm](?reg.alloc, len::usize);
    if (sel space.err) { ret err[fail.Fail].err{space.err}; }
    val rows: *target_model.ScalarForm = space.ok;
    var i:    u32                      = 0;
    for (i < explicit_len) {
        rows[i] = explicit[i];
        i       = i + 1;
    }
    target_model.scalar_family_rows(m, rows, explicit_len, families);
    m.scalar_forms    = rows;
    m.scalar_form_len = len;
    ret err[fail.Fail].ok{};
}

# free the table declare_scalar_rows gave the model
pub fun release_scalar_rows(reg: *IsaRegistry, m: *target_model.Machine) {
    if (m.scalar_forms != nil) { A.deallocate[target_model.ScalarForm](?reg.alloc, m.scalar_forms, m.scalar_form_len::usize); }
    m.scalar_forms    = nil;
    m.scalar_form_len = 0;
}

# every extension vocabulary the registry's instruction sets declare, each table once
pub fun vocabulary(reg: *IsaRegistry) res[extension.Vocabulary, fail.Fail] {
    var v: extension.Vocabulary = extension.vocabulary_empty();
    if (reg == nil || reg.count > ISA_REGISTRY_CAP) {
        ret res[extension.Vocabulary, fail.Fail].err{fail.message("mach.lang.target.isa: vocabulary requires a registry within its capacity")};
    }
    var i: u32 = 0;
    for (i < reg.count) {
        val m: *target_model.Machine = ?reg.entries[i].model;
        if (!extension.vocabulary_add(?v, m.extension_table, m.extension_count)) {
            ret res[extension.Vocabulary, fail.Fail].err{fail.message(
                "mach.lang.target.isa: the registry declares more extension vocabularies than a description carries; raise extension.VOCABULARY_CAP")};
        }
        i = i + 1;
    }
    ret res[extension.Vocabulary, fail.Fail].ok{v};
}

def AsmClobbersFn: fun(str, *u32, *u32);

# whether an asm body may write the stack pointer; true for a body it cannot parse
def AsmWritesSpFn: fun(str) bool;

# the constant-time scan of an asm body: the tracked bindings (`ct.AsmSecret`, by the name
# their `{name}` operand spells), the target's multiply admission and shift trust
pub def AsmCtScanFn: fun(str, *ct.AsmSecret, u32, ct.CtMulMask, bool, *A.Allocator) err[ct.AsmRefusal];

def IsRegMoveFn: fun(u32) bool;

def IsTrapTerminatorFn: fun(u32) bool;
# whether the selected instruction reads operand `index` as a constant in
# place, as a constant-pool memory operand, at no instruction of its own: the
# rule the allocator folds a rebuilt constant into its reader by
def ReadsConstFn: fun(*lang_mir.MirInstr, u32) bool;

pub def DwarfRegFn: catalog_arch.DwarfRegFn;

pub def CvRegFn: catalog_arch.CvRegFn;

pub def RegFileFn: fun(*target_model.Register) i32;

def FrameDistFn: fun(*target_model.Machine, *lang_mir.MirFunction, *u32, *u32) err[fail.Fail];

