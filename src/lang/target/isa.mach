test registry__corrupt_public_count_is_bounded {
    var reg: IsaRegistry = registry_init();
    reg.count = ISA_REGISTRY_CAP + 1;
    if (registered_count(?reg) != 0) {
        registry_dnit(?reg);
        ret 1;
    }
    val r_2794: opt[*IsaVTable] = lookup(?reg, "x86_64");
    if (sel r_2794.some) {
        registry_dnit(?reg);
        ret 1;
    }
    val r_2795: opt[*IsaVTable] = registered(?reg, 0);
    if (sel r_2795.some) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    if (reg.count != 0) { ret 1; }
    ret 0;
}

#[testing]
rec RegistryAllocProbe {
    backing: A.Allocator;
    calls:   u32;
    live:    u32;
    fail_at: u32;
}

#[testing]
fun registry_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val item: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel item.some) { p.live = p.live + 1; }
    ret item;
}

#[testing]
fun registry_probe_reallocate(ctx: ptr, item: ptr, old_size: usize,
    new_size: usize, align: usize) opt[ptr] {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret opt[ptr].none{}; }
    ret p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
}

#[testing]
fun registry_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    if (p.live > 0) { p.live = p.live - 1; }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

#[testing]
fun registry_probe_allocator(p: *RegistryAllocProbe) A.Allocator {
    var alloc: A.Allocator;
    alloc.ctx           = p::ptr;
    alloc.fn_allocate   = registry_probe_allocate;
    alloc.fn_reallocate = registry_probe_reallocate;
    alloc.fn_deallocate = registry_probe_deallocate;
    ret alloc;
}

test registry__partial_allocation_rolls_back {
    var probe:  RegistryAllocProbe;
    val r_2842: err[A.Error] = page.make(?probe.backing);
    if (sel r_2842.err) { ret 1; }

    var classes: [1]RegClass;
    classes[0].name = "gp";
    classes[0].kind = RC_GENERAL;
    classes[0].len  = 4;
    var model_reserved: [1]Register;
    model_reserved[0].id   = 1;
    model_reserved[0].size = 8;
    var forms: [1]PackedForm;
    forms[0].op        = VEC_OP_MUL;
    forms[0].is_float  = false;
    forms[0].lane_bits = 32;
    forms[0].from_bits = 32;
    var scalar_len: u32         = 0;
    val scalar:     *ScalarForm = t_scalar_rest(?probe.backing, ?scalar_len, VEC_OP_MUL, false, 32);
    if (scalar == nil) { ret 91; }
    fin { t_scalar_free(?probe.backing, scalar); }
    var model: MachineModel = t_model(8);
    model.reg_classes     = ?classes[0];
    model.reg_class_len   = 1;
    model.reserved_regs   = ?model_reserved[0];
    model.reserved_len    = 1;
    model.has_v128        = true;
    model.vector_bits     = VECTOR_BITS_128;
    model.packed_forms    = ?forms[0];
    model.packed_form_len = 1;
    model.scalar_forms    = scalar;
    model.scalar_form_len = scalar_len;

    var machine_reserved: [1]Register;
    machine_reserved[0].id   = 2;
    machine_reserved[0].size = 8;
    var reload: [1]Register;
    reload[0].id   = 3;
    reload[0].size = 8;
    var machine: RegMachine = reg_machine(t_select, t_encode, t_is_reg_move, t_is_trap_terminator,
        ?machine_reserved[0], 1, ?reload[0], 1,
        -1, -1, -1, -1, 0, -1, -1, -1);
    var reloc:    RelocSeam = t_reloc();
    var operands: [1]u32;
    operands[0] = TYPE_OPERAND_WORD;
    var ops: [1]OpDef;
    ops[0] = op_def("core", "op", 1, 2, 1);
    var types: [1]TypeDef;
    types[0] = type_def("ty", 7, ?operands[0], 1, nil);
    var definitions: TargetDefs = target_defs(?ops[0], 1, ?types[0], 1);
    var vt:          IsaVTable  = machine_isa(ARCH_X86_64, "rollback", 62, 8,
        ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);

    var saw_failure: bool = false;
    var saw_success: bool = false;
    var ordinal:     u32  = 1;
    for (ordinal <= 64 && !saw_success) {
        probe.calls   = 0;
        probe.live    = 0;
        probe.fail_at = ordinal;
        var alloc: A.Allocator    = registry_probe_allocator(?probe);
        var reg:   IsaRegistry    = registry_init_with_allocator(?alloc);
        val rr:    err[fail.Fail] = register(?reg, ?vt);
        if (sel rr.err) {
            saw_failure = true;
            if (registered_count(?reg) != 0 || probe.live != 0) {
                registry_dnit(?reg);
                ret 1;
            }
        }
        if (sel rr.ok) {
            saw_success = true;
            if (registered_count(?reg) != 1 || probe.live == 0) {
                registry_dnit(?reg);
                ret 1;
            }
        }
        registry_dnit(?reg);
        if (probe.live != 0) { ret 1; }
        ordinal = ordinal + 1;
    }
    if (!saw_failure || !saw_success) { ret 1; }
    ret 0;
}

test register__refuses_past_capacity {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var machines: [9]RegMachine;
    var relocs:   [9]RelocSeam;
    var models:   [9]MachineModel;
    var vts:      [9]IsaVTable;
    var names:    [9][2]u8;
    var i:        u32 = 0;
    for (i < ISA_REGISTRY_CAP) {
        machines[i] = t_machine();
        relocs[i]   = t_reloc();
        models[i]   = t_model(8);
        names[i][0] = 'a'::u8 + i::u8;
        names[i][1] = 0;
        vts[i]      = machine_isa(i + 1, (?names[i][0])::str, 0, 8, ?models[i], ?machines[i], ?relocs[i]);
        val r_2914: err[fail.Fail] = register(?reg, ?vts[i]);
        if (sel r_2914.err) { ret 1; }
        i = i + 1;
    }
    if (registered_count(?reg) != ISA_REGISTRY_CAP) { ret 1; }

    machines[8] = t_machine();
    relocs[8]   = t_reloc();
    models[8]   = t_model(8);
    vts[8]      = machine_isa(999, "overflow", 0, 8, ?models[8], ?machines[8], ?relocs[8]);
    val r_2923: err[fail.Fail] = register(?reg, ?vts[8]);
    if (!sel r_2923.err)                            { ret 1; }
    if (registered_count(?reg) != ISA_REGISTRY_CAP) { ret 1; }
    ret 0;
}

test backend_family__closed_over_native_and_whole_module {
    var m:   RegMachine    = t_machine();
    var rs:  RelocSeam     = t_reloc();
    var mvt: IsaVTable     = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    val mf:  BackendFamily = backend_family(?mvt);
    if (!is_native(?mf))      { ret 1; }
    if (is_whole_module(?mf)) { ret 1; }
    if (as_native(?mf) != ?m) { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module, false);
    var evt:     IsaVTable     = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    val ef:      BackendFamily = backend_family(?evt);
    if (is_native(?ef))        { ret 1; }
    if (!is_whole_module(?ef)) { ret 1; }
    ret 0;
}

test clamp_alu_width__lifts_to_the_narrowest_unconditional_width {
    var model: MachineModel;
    declare_alu_widths(?model, ALU_WIDTHS_4_8);
    if (alu_min_width(?model) != 4 || max_alu_width(?model) != 8) { ret 1; }
    if (clamp_alu_width(?model, 1) != 4 || clamp_alu_width(?model, 2) != 4
        || clamp_alu_width(?model, 4) != 4 || clamp_alu_width(?model, 8) != 8) { ret 2; }
    # a width above the widest is left for legalize to split
    if (clamp_alu_width(?model, 16) != 16) { ret 3; }
    # a gated width is legal only while the model holds its extension, and a
    # lift never lands on one: 2 stays 2 under its extension, 1 lifts past it
    declare_alu_widths(?model, ALU_WIDTHS_4_8);
    gate_alu_width(?model, 1, 0x1);
    gate_alu_width(?model, 2, 0x2);
    model.extensions = 0x2;
    if (alu_min_width(?model) != 2 || clamp_alu_width(?model, 1) != 4 || clamp_alu_width(?model, 2) != 2) { ret 4; }
    model.extensions = 0x3;
    if (alu_min_width(?model) != 1 || clamp_alu_width(?model, 1) != 1) { ret 5; }
    model.extensions = 0;
    if (alu_min_width(?model) != 4 || clamp_alu_width(?model, 2) != 4) { ret 6; }
    # a model that declares none has no floor and no ceiling
    var none: MachineModel;
    if (alu_min_width(?none) != 0 || max_alu_width(?none) != 0 || clamp_alu_width(?none, 1) != 1) { ret 7; }
    ret 0;
}

test realizes_int_width__reads_the_declared_set_and_nothing_else {
    var model: MachineModel;
    model.int_widths = INT_WIDTHS_1_2_4_8;
    if (!realizes_int_width(?model, 1) || !realizes_int_width(?model, 2)
        || !realizes_int_width(?model, 4) || !realizes_int_width(?model, 8)) { ret 1; }
    if (realizes_int_width(?model, 16) || realizes_int_width(?model, 0)
        || realizes_int_width(?model, 3) || realizes_int_width(?model, 32)) { ret 2; }
    model.int_widths = INT_WIDTHS_1_2_4_8_16;
    if (!realizes_int_width(?model, 16) || realizes_int_width(?model, 32)) { ret 3; }
    # a target that declares nothing realizes nothing, whatever its ALU says
    model.int_widths = 0;
    model.gpr_width  = 8;
    declare_alu_widths(?model, ALU_WIDTHS_1_2_4_8);
    if (realizes_int_width(?model, 1) || realizes_int_width(?model, 8)) { ret 4; }
    ret 0;
}

test moves_unaligned_gp__widths_are_individual_ordinary_memory_capabilities {
    var model: MachineModel;
    model.gpr_width           = 8;
    model.gp_unaligned_widths = 2 + 8 + 16;
    if (!moves_unaligned_gp(?model, 1) || !moves_unaligned_gp(?model, 2) || !moves_unaligned_gp(?model, 8))                                { ret 1; }
    if (moves_unaligned_gp(?model, 0) || moves_unaligned_gp(?model, 3) || moves_unaligned_gp(?model, 4) || moves_unaligned_gp(?model, 16)) { ret 2; }
    model.gp_unaligned_widths = 0;
    if (!moves_unaligned_gp(?model, 1) || moves_unaligned_gp(?model, 2) || moves_unaligned_gp(?model, 8)) { ret 3; }
    ret 0;
}

# the register width is the widest selected row, or the compute width with
# none; a row must name a known extension and a power-of-two width above the
# compute width, once (#3751)
test vector_register_rows__widest_selected_and_valid {
    var rows: [2]VectorRegisterRow;
    rows[0] = VectorRegisterRow{ext: rvfeatures.F, bytes: 32, upper_clear: true};
    rows[1] = VectorRegisterRow{ext: rvfeatures.D, bytes: 64, upper_clear: false};
    var m: MachineModel = t_model(8);
    m.vector_bits             = VECTOR_BITS_128;
    m.vector_register_rows    = ?rows[0];
    m.vector_register_row_len = 2;
    m.extensions              = 0;
    if (!vector_register_rows_valid(?m))                               { ret 1; }
    if (vector_register_bytes(?m) != 16 || vector_upper_clear(?m, 32)) { ret 2; }
    m.extensions = rvfeatures.F;
    if (vector_register_bytes(?m) != 32 || !vector_upper_clear(?m, 32)) { ret 3; }
    m.extensions = rvfeatures.F | rvfeatures.D;
    if (vector_register_bytes(?m) != 64 || vector_upper_clear(?m, 16)) { ret 4; }
    rows[1] = VectorRegisterRow{ext: rvfeatures.D, bytes: 48, upper_clear: false};
    if (vector_register_rows_valid(?m)) { ret 5; }
    rows[1] = VectorRegisterRow{ext: rvfeatures.D, bytes: 16, upper_clear: false};
    if (vector_register_rows_valid(?m)) { ret 6; }
    rows[1] = VectorRegisterRow{ext: rvfeatures.D, bytes: 32, upper_clear: false};
    if (vector_register_rows_valid(?m)) { ret 7; }
    ret 0;
}

# the compute widths widen per lane kind: a register row selected by F and
# width rows for float lanes under F and integer ones under D, which brings
# F, as x86-64's avx and avx2 do (#4128)
test vector_width_rows__per_lane_kind_under_the_selection {
    var reg:  [1]VectorRegisterRow = [1]VectorRegisterRow{VectorRegisterRow{ext: rvfeatures.F, bytes: 32, upper_clear: true}};
    var rows: [2]VectorWidthRow;
    rows[0] = VectorWidthRow{ext: rvfeatures.F, is_float: true, lanes: 4 + 8, bits: 256};
    rows[1] = VectorWidthRow{ext: rvfeatures.D, is_float: false, lanes: 1 + 2 + 4 + 8, bits: 256};
    var m: MachineModel = t_model(8);
    m.has_v128                = true;
    m.vector_bits             = VECTOR_BITS_128;
    m.vector_op_bytes         = 16;
    m.max_vector_lanes        = VECTOR_LANES_UNBOUNDED;
    m.vector_register_rows    = ?reg[0];
    m.vector_register_row_len = 1;
    m.vector_width_rows       = ?rows[0];
    m.vector_width_row_len    = 2;
    m.extensions              = 0;
    if (!vector_width_rows_valid(?m))                                             { ret 1; }
    if (vector_width(?m, true, 32) != 128 || packed_lane_cap(?m, false, 32) != 4) { ret 2; }
    m.extensions = rvfeatures.F;
    if (vector_width(?m, true, 32) != 256 || vector_width(?m, true, 16) != 128)              { ret 3; }
    if (vector_width(?m, false, 32) != 128 || packed_lane_cap(?m, true, 64) != 4)            { ret 4; }
    if (vector_op_bytes(?m, true, 32, 32) != 32 || vector_op_bytes(?m, true, 32, 20) != 32)  { ret 5; }
    if (vector_op_bytes(?m, false, 32, 32) != 16 || vector_op_bytes(?m, true, 32, 12) != 16) { ret 6; }
    if (vector_op_bytes(?m, true, 32, 64) != 16)                                             { ret 7; }
    m.extensions = rvfeatures.F | rvfeatures.D;
    if (vector_width(?m, false, 8) != 256 || packed_lane_cap(?m, false, 16) != 16)      { ret 8; }
    if (!from_is_float(VEC_OP_FP_TO_SI, false) || from_is_float(VEC_OP_SI_TO_FP, true)) { ret 9; }
    # a width past the register the row's extensions select, no lane, a width
    # at the baseline, and no extension are each malformed
    rows[1] = VectorWidthRow{ext: rvfeatures.D, is_float: false, lanes: 4, bits: 512};
    if (vector_width_rows_valid(?m)) { ret 10; }
    rows[1] = VectorWidthRow{ext: rvfeatures.D, is_float: false, lanes: 0, bits: 256};
    if (vector_width_rows_valid(?m)) { ret 11; }
    rows[1] = VectorWidthRow{ext: rvfeatures.D, is_float: false, lanes: 4, bits: 128};
    if (vector_width_rows_valid(?m)) { ret 12; }
    rows[1] = VectorWidthRow{ext: 0, is_float: false, lanes: 4, bits: 256};
    if (vector_width_rows_valid(?m)) { ret 13; }
    ret 0;
}

# a `|` makes the literal after it optional, and a literal's value brings operands after
# the ones the row spells: one value of a value enumeration, any union of a mask's bits
test op_def_shaped__tail_and_enumerants {
    val d: OpDef = op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "cv|l");
    if (d.arity != 3 || d.min_arity != 2 || d.spelled != 3)                                   { ret 1; }
    if (d.kinds[0] != OP_OPERAND_CONSTANT || d.kinds[2] != OP_OPERAND_LITERAL)                { ret 1; }
    if (op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vv").min_arity != 2) { ret 2; }
    val t: OpDef = op_def_shaped("core", "op", 1, 2, OP_RESULT_BOOL, NO_OP_SPACE, "cb");
    if (t.kinds[1] != OP_OPERAND_BOOL || op_def_shape_refusal(?t) != nil) { ret 9; }
    # a memory scope and a memory semantics are constant ids, a literal is not
    val sm: OpDef = op_def_shaped("core", "op", 1, 2, OP_RESULT_NONE, NO_OP_SPACE, "csm");
    if (sm.kinds[1] != OP_OPERAND_SCOPE || sm.kinds[2] != OP_OPERAND_SEMANTICS || op_def_shape_refusal(?sm) != nil)  { ret 10; }
    if (!op_kind_is_constant(sm.kinds[0]) || !op_kind_is_constant(sm.kinds[1]) || !op_kind_is_constant(sm.kinds[2])) { ret 10; }
    if (op_kind_is_constant(OP_OPERAND_LITERAL))                                                                     { ret 10; }

    var values: [3]OpEnumerant = [3]OpEnumerant{
        OpEnumerant{value: 1, name: "one", capability: NO_OP_CAPABILITY, requires: 0, operands: "c"},
        OpEnumerant{value: 2, name: "two", capability: NO_OP_CAPABILITY, requires: 0, operands: ""},
        OpEnumerant{value: 4, name: "four", capability: NO_OP_CAPABILITY, requires: 0, operands: "vv"},
    };
    var e:        OpEnum = OpEnum{name: "e", values: ?values[0], count: 3, mask: false};
    var trailing: u32    = 9;
    if (!op_enum_admits(?e, 4, ?trailing) || trailing != 2) { ret 3; }
    if (op_enum_admits(?e, 5, ?trailing))                   { ret 4; }
    e.mask = true;
    if (!op_enum_admits(?e, 5, ?trailing) || trailing != 3) { ret 5; }
    if (!op_enum_admits(?e, 0, ?trailing) || trailing != 0) { ret 6; }
    if (op_enum_admits(?e, 9, ?trailing))                   { ret 7; }
    # a required literal's value brings its operands after the row's own: room for a value
    # enumeration's most, or for every bit of a mask at once
    e.mask = false;
    val r: OpDef = op_enumerated(op_requiring(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "clv"), 63, 0x4), 1, ?e);
    if (r.capability != 63 || r.requires != 0x4 || op_operand_enum(?r, 1) != ?e || op_operand_enum(?r, 0) != nil) { ret 8; }
    if (r.min_arity != 3 || r.spelled != 3 || r.arity != 5 || op_def_shape_refusal(?r) != nil)                    { ret 8; }
    e.mask = true;
    val m: OpDef = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "clv"), 1, ?e);
    if (m.arity != 6 || op_enumerated(m, 1, ?e).arity != 6) { ret 10; }
    # an enumerant bringing a pointer, a handle or an unknown kind is refused
    values[1].operands = "r";
    if (op_def_shape_refusal(?m) == nil) { ret 11; }
    values[1].operands = "i";
    if (op_def_shape_refusal(?m) == nil) { ret 12; }
    values[1].operands = "x";
    if (op_def_shape_refusal(?m) == nil) { ret 13; }
    ret 0;
}

# a relation ties a value operand or a value result to the operand the typing names: the
# data relation to a value or a pointee, the texel relation to a handle, and the pointee
# relation a pointer result to the handle a pointer operand addresses
test op_related__relations_are_stated_against_the_typing_operand {
    var entries: [1]OpTypeRequirement = [1]OpTypeRequirement{
        OpTypeRequirement{class: OP_DATA_INT, bits: 32, space: NO_OP_SPACE, capability: NO_OP_CAPABILITY, requires: 0, refused: nil},
    };
    var on_pointer: OpTyping = OpTyping{name: "p", operand: 0, entries: ?entries[0], count: 1};
    var on_value:   OpTyping = OpTyping{name: "v", operand: 0, entries: nil, count: 0};
    val atomic:     OpDef    = op_typed(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "uccv"), ?on_pointer);
    val ok:         OpDef    = op_related(atomic, OP_RELATION_DATA, "---=");
    if (op_def_shape_refusal(?ok) != nil || op_operand_relation(?ok, 3) != OP_RELATION_DATA) { ret 1; }
    if (!op_typing_constrains(?on_pointer) || op_typing_constrains(?on_value))               { ret 1; }
    if (op_def_shape_refusal(?atomic) != nil)                                                { ret 1; }
    # a constant, the data operand itself, an unknown letter and an untyped row are refused
    val on_constant: OpDef = op_related(atomic, OP_RELATION_NONE, "-=");
    if (op_def_shape_refusal(?on_constant) == nil) { ret 2; }
    val on_self: OpDef = op_related(atomic, OP_RELATION_NONE, "=");
    if (op_def_shape_refusal(?on_self) == nil) { ret 3; }
    val unknown: OpDef = op_related(atomic, OP_RELATION_NONE, "---x");
    if (op_def_shape_refusal(?unknown) == nil) { ret 4; }
    val untyped: OpDef = op_related(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vv"), OP_RELATION_DATA, "");
    if (op_def_shape_refusal(?untyped) == nil) { ret 5; }
    # a texel relates only to a handle, and a handle's own type to nothing
    var four:  OpTexelCount = OpTexelCount{rule: "four", kind: OP_COUNT_EXACT, components: 4};
    val image: OpDef        = op_typed(op_def_shaped("core", "op", 1, 2, OP_RESULT_NONE, NO_OP_SPACE, "ovv"), ?on_value);
    val write: OpDef        = op_texel_counted(op_related(image, OP_RELATION_NONE, "--t"), ?four);
    if (op_def_shape_refusal(?write) != nil) { ret 6; }
    # a texel states its count, and a count needs a texel, a kind and a component
    val uncounted: OpDef = op_related(image, OP_RELATION_NONE, "--t");
    if (op_def_shape_refusal(?uncounted) == nil) { ret 10; }
    val stray: OpDef = op_texel_counted(atomic, ?four);
    if (op_def_shape_refusal(?stray) == nil) { ret 11; }
    var none_: OpTexelCount = OpTexelCount{rule: "none", kind: OP_COUNT_EXACT, components: 0};
    val empty: OpDef        = op_texel_counted(op_related(image, OP_RELATION_NONE, "--t"), ?none_);
    if (op_def_shape_refusal(?empty) == nil) { ret 12; }
    var odd:           OpTexelCount = OpTexelCount{rule: "odd", kind: OP_COUNT_KIND_COUNT, components: 1};
    val unknown_count: OpDef        = op_texel_counted(op_related(image, OP_RELATION_NONE, "--t"), ?odd);
    if (op_def_shape_refusal(?unknown_count) == nil) { ret 13; }
    # an exact count admits only its own, and a format count at least the format's, any when unknown
    var stored: OpTexelCount = OpTexelCount{rule: "stored", kind: OP_COUNT_FORMAT, components: 0};
    if (!op_texel_count_admits(?four, 4, 1) || op_texel_count_admits(?four, 1, 0))      { ret 14; }
    if (!op_texel_count_admits(?stored, 2, 2) || op_texel_count_admits(?stored, 1, 2))  { ret 14; }
    if (!op_texel_count_admits(?stored, 1, 0) || !op_texel_count_admits(?stored, 4, 1)) { ret 14; }
    val equal: OpDef = op_related(image, OP_RELATION_NONE, "--=");
    if (op_def_shape_refusal(?equal) == nil) { ret 7; }
    val texel: OpDef = op_related(ok, OP_RELATION_TEXEL, "");
    if (op_def_shape_refusal(?texel) == nil) { ret 8; }
    # a result relation needs a value result
    val none: OpDef = op_related(image, OP_RELATION_TEXEL, "");
    if (op_def_shape_refusal(?none) == nil) { ret 9; }
    # a pointee relation is a pointer result's, into what the typing's pointer operand addresses
    val texel_ptr: OpDef = op_typed(op_def_shaped("core", "op", 1, 2, OP_RESULT_POINTER, 11, "rvv"), ?on_value);
    val addressed: OpDef = op_related(texel_ptr, OP_RELATION_POINTEE, "");
    if (op_def_shape_refusal(?addressed) != nil) { ret 10; }
    val of_value: OpDef = op_related(ok, OP_RELATION_POINTEE, "");
    if (op_def_shape_refusal(?of_value) == nil) { ret 11; }
    val on_operand: OpDef = op_related(texel_ptr, OP_RELATION_NONE, "--p");
    if (op_def_shape_refusal(?on_operand) == nil) { ret 12; }
    ret 0;
}

# a mask leading the tail is optional: a call leaves it out with every operand it would
# bring, or passes it followed by the operands of each set bit in ascending bit order,
# each typed by the bit that brings it
test op_call_arity__optional_mask_leads_the_tail {
    var values: [3]OpEnumerant = [3]OpEnumerant{
        OpEnumerant{value: 0x2, name: "low", capability: NO_OP_CAPABILITY, requires: 0, operands: "v"},
        OpEnumerant{value: 0x8, name: "mid", capability: NO_OP_CAPABILITY, requires: 0, operands: "c"},
        OpEnumerant{value: 0x40, name: "high", capability: NO_OP_CAPABILITY, requires: 0, operands: "lv"},
    };
    var e: OpEnum = OpEnum{name: "mask", values: ?values[0], count: 3, mask: true};
    val d: OpDef  = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv|l"), 2, ?e);
    if (op_def_shape_refusal(?d) != nil || op_tail_literal(?d) != ?e) { ret 1; }
    if (d.min_arity != 2 || d.spelled != 3 || d.arity != 7)           { ret 1; }
    var words: [7]u32;
    var kinds: [OP_MAX_OPERANDS]OpOperandKind;
    var bad:   u32 = 0;
    # absent: the call passes the required operands alone, and no literal word is read
    words[2] = 0xDEAD;
    if (op_literal_span(?d, 2) != 2 || op_call_arity(?d, 2, ?words[0], ?bad) != 2 || bad != NO_OPERAND) { ret 2; }
    # an empty mask brings nothing
    words[2] = 0;
    if (op_call_arity(?d, 3, ?words[0], ?bad) != 3 || bad != NO_OPERAND) { ret 3; }
    # one bit, then all three: each bit's operands in bit order, typed by the bit
    words[2] = 0x40;
    if (op_call_arity(?d, 5, ?words[0], ?bad) != 5 || bad != NO_OPERAND) { ret 4; }
    op_call_kinds(?d, 5, ?words[0], ?kinds[0]);
    if (kinds[0] != OP_OPERAND_HANDLE_READ || kinds[2] != OP_OPERAND_LITERAL || kinds[3] != OP_OPERAND_LITERAL || kinds[4] != OP_OPERAND_VALUE) { ret 5; }
    words[2] = 0x4A;
    if (op_call_arity(?d, 7, ?words[0], ?bad) != 7 || bad != NO_OPERAND) { ret 6; }
    op_call_kinds(?d, 7, ?words[0], ?kinds[0]);
    if (kinds[3] != OP_OPERAND_VALUE || kinds[4] != OP_OPERAND_CONSTANT || kinds[5] != OP_OPERAND_LITERAL || kinds[6] != OP_OPERAND_VALUE) { ret 6; }
    # a bit the mask does not define is refused at the literal
    words[2] = 0x4;
    op_call_arity(?d, 3, ?words[0], ?bad);
    if (bad != 2) { ret 7; }
    # nothing is spelled after a leading literal, and no other literal is enumerated beside it
    val spelled: OpDef = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv|lv"), 2, ?e);
    if (op_def_shape_refusal(?spelled) == nil) { ret 8; }
    val deep: OpDef = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv|vl"), 3, ?e);
    if (op_def_shape_refusal(?deep) == nil) { ret 9; }
    var one: [1]OpEnumerant = [1]OpEnumerant{OpEnumerant{value: 1, name: "one", capability: NO_OP_CAPABILITY, requires: 0, operands: ""}};
    var v:   OpEnum         = OpEnum{name: "v", values: ?one[0], count: 1, mask: false};
    val two: OpDef          = op_enumerated(op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "lv|l"), 2, ?e), 0, ?v);
    if (op_def_shape_refusal(?two) == nil) { ret 10; }
    # a required literal decides what follows the row's own operands, with no `|`
    val req: OpDef = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "lv"), 0, ?e);
    if (op_def_shape_refusal(?req) != nil || op_tail_literal(?req) != nil || req.min_arity != 2 || req.arity != 6) { ret 11; }
    # more than a row carries
    var many: [1]OpEnumerant = [1]OpEnumerant{OpEnumerant{value: 1, name: "many", capability: NO_OP_CAPABILITY, requires: 0, operands: "vvvvvvvvvvvvvvvv"}};
    var big:  OpEnum         = OpEnum{name: "big", values: ?many[0], count: 1, mask: false};
    val over: OpDef          = op_enumerated(op_def_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "l"), 0, ?big);
    if (op_def_shape_refusal(?over) == nil) { ret 12; }
    ret 0;
}
