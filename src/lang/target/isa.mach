    registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.isa.registry:owns_nested_storage_and_strings" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var descriptor_name: [6]u8;
    descriptor_name[0] = 'o'; descriptor_name[1] = 'w'; descriptor_name[2] = 'n';
    descriptor_name[3] = 'e'; descriptor_name[4] = 'd'; descriptor_name[5] = 0;
    var class_name: [3]u8; class_name[0] = 'g'; class_name[1] = 'p'; class_name[2] = 0;
    var op_set: [5]u8; op_set[0] = 'c'; op_set[1] = 'o'; op_set[2] = 'r'; op_set[3] = 'e'; op_set[4] = 0;
    var op_name: [3]u8; op_name[0] = 'o'; op_name[1] = 'p'; op_name[2] = 0;
    var type_name: [3]u8; type_name[0] = 't'; type_name[1] = 'y'; type_name[2] = 0;
    var attr_section: [6]u8;
    attr_section[0] = '.'; attr_section[1] = 'a'; attr_section[2] = 't';
    attr_section[3] = 't'; attr_section[4] = 'r'; attr_section[5] = 0;
    var attr_vendor: [7]u8;
    attr_vendor[0] = 'v'; attr_vendor[1] = 'e'; attr_vendor[2] = 'n';
    attr_vendor[3] = 'd'; attr_vendor[4] = 'o'; attr_vendor[5] = 'r'; attr_vendor[6] = 0;

    var classes: [1]RegClass;
    classes[0].name = (?class_name[0])::str; classes[0].kind = RC_GENERAL; classes[0].len = 4;
    var model_reserved: [1]Register;
    model_reserved[0].id = 1; model_reserved[0].size = 8;
    var packed: [1]PackedGap;
    packed[0].op = VEC_OP_MUL; packed[0].is_float = false; packed[0].lane_bits = 32;
    var model: MachineModel = t_model(8);
    model.reg_classes = ?classes[0]; model.reg_class_len = 1;
    model.reserved_regs = ?model_reserved[0]; model.reserved_len = 1;
    model.packed_gaps = ?packed[0]; model.packed_gap_len = 1;

    var machine_reserved: [1]Register;
    machine_reserved[0].id = 2; machine_reserved[0].size = 8;
    var reload: [1]Register;
    reload[0].id = 3; reload[0].size = 8;
    var machine: RegMachine = reg_machine(t_select, t_encode, t_is_reg_move, t_is_trap_terminator,
                                           ?machine_reserved[0], 1, ?reload[0], 1,
                                           -1, -1, -1, -1, 0, -1, -1, -1);
    var reloc: RelocSeam = t_reloc();
    var attributes: of.ElfAttributes;
    attributes.section = (?attr_section[0])::str;
    attributes.sht = 0x70000003;
    attributes.vendor = (?attr_vendor[0])::str;
    with_elf_attributes(?reloc, ?attributes);
    var operands: [1]u32; operands[0] = TYPE_OPERAND_WORD;
    var ops: [1]OpDef;
    ops[0] = op_def((?op_set[0])::str, (?op_name[0])::str, 1, 2, 1);
    var types: [1]TypeDef;
    types[0] = type_def((?type_name[0])::str, 7, ?operands[0], 1, nil);
    var definitions: TargetDefs = target_defs(?ops[0], 1, ?types[0], 1);
    var vt: IsaVTable = machine_isa(ARCH_X86_64, (?descriptor_name[0])::str, 62, 8,
                                     ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);
    if (R.is_err[R.Void, str](register(?reg, ?vt))) { registry_dnit(?reg); ret 1; }

    descriptor_name[0] = 'x'; class_name[0] = 'x'; op_set[0] = 'x';
    op_name[0] = 'x'; type_name[0] = 'x'; attr_section[0] = 'x'; attr_vendor[0] = 'x';
    classes[0].len = 99; model_reserved[0].id = 99; packed[0].lane_bits = 99;
    machine_reserved[0].id = 99; reload[0].id = 99; operands[0] = 99;
    val found_o: O.Option[*IsaVTable] = lookup(?reg, "owned");
    if (O.is_none[*IsaVTable](found_o)) { registry_dnit(?reg); ret 1; }
    val found: *IsaVTable = O.unwrap[*IsaVTable](found_o);
    if (!str_equals(found.model.reg_classes[0].name, "gp")
        || found.model.reg_classes[0].len != 4 || found.model.reserved_regs[0].id != 1
        || found.model.packed_gaps[0].lane_bits != 32
        || found.machine.reserved_regs[0].id != 2 || found.machine.reload_scratch_regs[0].id != 3
        || !str_equals(found.reloc.elf.attributes.section, ".attr")
        || !str_equals(found.reloc.elf.attributes.vendor, "vendor")
        || !str_equals(found.defs.ops[0].set, "core") || !str_equals(found.defs.ops[0].name, "op")
        || !str_equals(found.defs.types[0].name, "ty") || found.defs.types[0].operands[0] != TYPE_OPERAND_WORD) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.registry:zero_type_operands_need_no_storage" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var model: MachineModel = t_model(8);
    var machine: RegMachine = t_machine();
    var reloc: RelocSeam = t_reloc();
    var types: [1]TypeDef;
    types[0] = type_def("empty", 1, nil, 0, nil);
    var definitions: TargetDefs = target_defs(nil, 0, ?types[0], 1);
    var vt: IsaVTable = machine_isa(ARCH_X86_64, "zero_operands", 62, 8,
                                     ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);
    if (R.is_err[R.Void, str](register(?reg, ?vt))) { registry_dnit(?reg); ret 1; }
    if (reg.entries[0].type_operands != nil || reg.entries[0].type_operand_count != 0
        || reg.entries[0].descriptor.defs.types[0].operands != nil) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.isa.registry:corrupt_public_count_is_bounded" {
    var reg: IsaRegistry = registry_init();
    reg.count = ISA_REGISTRY_CAP + 1;
    if (registered_count(?reg) != 0) { registry_dnit(?reg); ret 1; }
    if (O.is_some[*IsaVTable](lookup(?reg, "x86_64"))) { registry_dnit(?reg); ret 1; }
    if (O.is_some[*IsaVTable](registered(?reg, 0))) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    if (reg.count != 0) { ret 1; }
    ret 0;
}

rec RegistryAllocProbe {
    backing: A.Allocator;
    calls:   u32;
    live:    u32;
    fail_at: u32;
}

fun registry_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret O.none[ptr](); }
    val item: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](item)) { p.live = p.live + 1; }
    ret item;
}

fun registry_probe_reallocate(ctx: ptr, item: ptr, old_size: usize,
                              new_size: usize, align: usize) O.Option[ptr] {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret O.none[ptr](); }
    ret p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
}

fun registry_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    if (p.live > 0) { p.live = p.live - 1; }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun registry_probe_allocator(p: *RegistryAllocProbe) A.Allocator {
    var alloc: A.Allocator;
    alloc.ctx = p::ptr;
    alloc.fn_allocate = registry_probe_allocate;
    alloc.fn_reallocate = registry_probe_reallocate;
    alloc.fn_deallocate = registry_probe_deallocate;
    ret alloc;
}

test "mach.lang.target.isa.registry:partial_allocation_rolls_back" {
    var probe: RegistryAllocProbe;
    if (O.is_some[str](page.make(?probe.backing))) { ret 1; }

    var classes: [1]RegClass;
    classes[0].name = "gp"; classes[0].kind = RC_GENERAL; classes[0].len = 4;
    var model_reserved: [1]Register;
    model_reserved[0].id = 1; model_reserved[0].size = 8;
    var gaps: [1]PackedGap;
    gaps[0].op = VEC_OP_MUL; gaps[0].is_float = false; gaps[0].lane_bits = 32;
    var model: MachineModel = t_model(8);
    model.reg_classes = ?classes[0]; model.reg_class_len = 1;
    model.reserved_regs = ?model_reserved[0]; model.reserved_len = 1;
    model.packed_gaps = ?gaps[0]; model.packed_gap_len = 1;

    var machine_reserved: [1]Register;
    machine_reserved[0].id = 2; machine_reserved[0].size = 8;
    var reload: [1]Register;
    reload[0].id = 3; reload[0].size = 8;
    var machine: RegMachine = reg_machine(t_select, t_encode, t_is_reg_move, t_is_trap_terminator,
                                           ?machine_reserved[0], 1, ?reload[0], 1,
                                           -1, -1, -1, -1, 0, -1, -1, -1);
    var reloc: RelocSeam = t_reloc();
    var operands: [1]u32; operands[0] = TYPE_OPERAND_WORD;
    var ops: [1]OpDef; ops[0] = op_def("core", "op", 1, 2, 1);
    var types: [1]TypeDef; types[0] = type_def("ty", 7, ?operands[0], 1, nil);
    var definitions: TargetDefs = target_defs(?ops[0], 1, ?types[0], 1);
    var vt: IsaVTable = machine_isa(ARCH_X86_64, "rollback", 62, 8,
                                     ?model, ?machine, ?reloc);
    with_defs(?vt, ?definitions);

    var saw_failure: bool = false;
    var saw_success: bool = false;
    var ordinal: u32 = 1;
    for (ordinal <= 64 && !saw_success) {
        probe.calls = 0; probe.live = 0; probe.fail_at = ordinal;
        var alloc: A.Allocator = registry_probe_allocator(?probe);
        var reg: IsaRegistry = registry_init_with_allocator(?alloc);
        val rr: R.Result[R.Void, str] = register(?reg, ?vt);
        if (R.is_err[R.Void, str](rr)) {
            saw_failure = true;
            if (registered_count(?reg) != 0 || probe.live != 0) { registry_dnit(?reg); ret 1; }
        } or {
            saw_success = true;
            if (registered_count(?reg) != 1 || probe.live == 0) { registry_dnit(?reg); ret 1; }
        }
        registry_dnit(?reg);
        if (probe.live != 0) { ret 1; }
        ordinal = ordinal + 1;
    }
    if (!saw_failure || !saw_success) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.register:refuses_past_capacity" {
    var reg: IsaRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var machines: [9]RegMachine;
    var relocs:   [9]RelocSeam;
    var models:   [9]MachineModel;
    var vts:      [9]IsaVTable;
    var names:    [9][2]u8;
    var i: u32 = 0;
    for (i < ISA_REGISTRY_CAP) {
        machines[i] = t_machine();
        relocs[i]   = t_reloc();
        models[i]   = t_model(8);
        names[i][0] = 'a'::u8 + i::u8;
        names[i][1] = 0;
        vts[i] = machine_isa(i + 1, (?names[i][0])::str, 0, 8, ?models[i], ?machines[i], ?relocs[i]);
        if (R.is_err[R.Void, str](register(?reg, ?vts[i]))) { ret 1; }
        i = i + 1;
    }
    if (registered_count(?reg) != ISA_REGISTRY_CAP) { ret 1; }

    machines[8] = t_machine();
    relocs[8]   = t_reloc();
    models[8]   = t_model(8);
    vts[8] = machine_isa(999, "overflow", 0, 8, ?models[8], ?machines[8], ?relocs[8]);
    if (!R.is_err[R.Void, str](register(?reg, ?vts[8]))) { ret 1; }
    if (registered_count(?reg) != ISA_REGISTRY_CAP) { ret 1; }
    ret 0;
}

test "mach.lang.target.isa.backend_family:closed_over_native_and_whole_module" {
    var m: RegMachine = t_machine();
    var rs: RelocSeam = t_reloc();
    var mvt: IsaVTable = machine_isa(ARCH_X86_64, "x86_64", 62, 8, nil, ?m, ?rs);
    val mf: BackendFamily = backend_family(?mvt);
    if (!is_native(?mf))                { ret 1; }
    if (is_whole_module(?mf))           { ret 1; }
    if (as_native(?mf) != ?m)           { ret 1; }

    var emitter: ModuleEmitter = module_emitter(t_emit_module);
    var evt: IsaVTable = emitter_isa(ARCH_SPIRV, "spirv", 8, nil, ?emitter);
    val ef: BackendFamily = backend_family(?evt);
    if (is_native(?ef))                 { ret 1; }
    if (!is_whole_module(?ef))          { ret 1; }
    ret 0;
}


test "mach.lang.target.isa.moves_unaligned_gp:widths_are_individual_ordinary_memory_capabilities" {
    var model: MachineModel;
    model.gpr_width = 8;
    model.gp_unaligned_widths = 2 + 8 + 16;
    if (!moves_unaligned_gp(?model, 1) || !moves_unaligned_gp(?model, 2) || !moves_unaligned_gp(?model, 8)) { ret 1; }
    if (moves_unaligned_gp(?model, 0) || moves_unaligned_gp(?model, 3) || moves_unaligned_gp(?model, 4) || moves_unaligned_gp(?model, 16)) { ret 2; }
    model.gp_unaligned_widths = 0;
    if (!moves_unaligned_gp(?model, 1) || moves_unaligned_gp(?model, 2) || moves_unaligned_gp(?model, 8)) { ret 3; }
    ret 0;
}
