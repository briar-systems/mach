# the bytes that identify a resolved target to the build cache: the owners' rows
# it names, by their spelling, the selection it stands on and the image keys
# its manifest states
use std.types.size.usize;

use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.target.resolved;
use mach.lang.wire;

# moves whenever the bytes a target fingerprints change meaning
val VERSION: u8 = 18;

pub fun put(t: *resolved.Target, s: *wire.Sink) {
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.env_name);
    if (t.arch != nil) { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.arch.name); }
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.isa);
    var i: usize = 0;
    for (i < t.added_count::usize) {
        lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.added[i]);
        i = i + 1;
    }
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ABI, VERSION, t.abi);
    if (t.sys != nil)    { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OS, VERSION, t.sys.name); }
    if (t.format != nil) { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OF, VERSION, t.format.name); }
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.code_model);
    if (sel t.output.some) { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OF, VERSION, t.output.some.name); }

    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.base);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.stack_reserve);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.stack_commit);
}
