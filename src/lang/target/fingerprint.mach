# the bytes that identify a resolved target to the build cache: the owners' rows
# it names, by their spelling, the selection it stands on and the image keys
# its manifest states
use std.types.size.usize;
use std.types.string.str;

use mink_target: mink.catalog.target;

use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.target.resolved;
use mach.lang.wire;

# moves whenever the bytes a target fingerprints change meaning
val VERSION: u8 = 20;

pub fun put(t: *resolved.Target, s: *wire.Sink) {
    val m:   *mink_target.Target = ?t.target;
    var env: str                 = "";
    if (sel m.env.some) { env = m.env.some.name; }
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, env);
    if (m.arch != nil) { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, m.arch.name); }
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, resolved.isa(t));
    var i: usize = 0;
    for (i < t.added_count::usize) {
        lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.added[i]);
        i = i + 1;
    }
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ABI, VERSION, resolved.abi_name(t));
    if (m.sys != nil)          { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OS, VERSION, m.sys.name); }
    if (m.format != nil)       { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OF, VERSION, m.format.name); }
    if (sel m.code_model.some) { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, m.code_model.some.name); }
    if (sel t.output.some)     { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OF, VERSION, t.output.some.name); }
    if (sel m.linkage.some)    { lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OF, VERSION, m.linkage.some.name); }

    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.base);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.stack_reserve);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.stack_commit);
}
