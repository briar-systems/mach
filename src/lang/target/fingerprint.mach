# moves whenever the bytes a target fingerprints change meaning
val VERSION: u8 = 15;

fun b2u8(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

pub fun put(t: *binding.Binding, s: *wire.Sink) {
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_ARCH, VERSION, t.target.env_name);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_ARCH, catalog_arch.VERSION, catalog_arch.fingerprint_tag(t.target.arch_id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_ARCH, VERSION, t.isa.name);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_ABI, catalog_abi.VERSION, catalog_abi.fingerprint_tag(t.target.abi_id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_ABI, VERSION, t.abi.name);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_ABI, VERSION, t.abi.passing);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_OS, catalog_os.VERSION, catalog_os.fingerprint_tag(t.target.os_id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_OS, VERSION, t.os.name);

    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_OF, target_of.OF_FORMAT_CATALOG_VERSION, target_of.of_fingerprint_tag(t.of.id));
    build_fingerprint.put_domain_str(s, build_fingerprint.DOMAIN_OF, VERSION, t.of.name);

    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_DEBUG, VERSION, t.target.debug_id);

    var backend_kind: u8 = 0;
    if (isa.emits_whole_module(t.isa)) { backend_kind = 1; }
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_BACKEND, VERSION, backend_kind);

    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.base);
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.page_size);
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.stack_reserve);
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.stack_commit);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, VERSION, b2u8(t.target.variadic_args_on_stack));
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, VERSION, b2u8(t.target.fixed_args_natural_size));
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.reg_arg_align);
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.reg_arg_extend);
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, VERSION, b2u8(t.target.agg_arg_natural_align));
    build_fingerprint.put_domain_u8(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.abi.half);
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.va_list_size);
    build_fingerprint.put_domain_u32(s, build_fingerprint.DOMAIN_IMAGE, VERSION, t.target.va_list_align);

    model_put(?t.target.model, s);
    fs_policy_put(?t.target.fs_policy, s);
}

fun fs_policy_put(p: *catalog_os.FsPolicy, s: *wire.Sink) {
    val d: build_fingerprint.Domain = build_fingerprint.DOMAIN_FS_POLICY;
    val v: u8                       = VERSION;

    build_fingerprint.put_domain_str(s, d, v, p.sysroot);
    build_fingerprint.put_domain_str(s, d, v, p.toolchain_root);
    build_fingerprint.put_domain_str(s, d, v, p.dynamic_interpreter);
    build_fingerprint.put_domain_str(s, d, v, p.platform_lib);
    build_fingerprint.put_domain_u32(s, d, v, p.libdir_len);

    var li: u32 = 0;
    for (li < p.libdir_len) {
        build_fingerprint.put_domain_str(s, d, v, p.libdirs[li]);
        li = li + 1;
    }
}

# a resolved model is the registered template, which the compiler build fixes,
# with the selection applied to it and the convention's stack rules over it;
# the template and the convention are named above, so the selection is what
# tells two models of one compiler apart, and no field of the model is mirrored
fun model_put(m: *target_model.Machine, s: *wire.Sink) {
    build_fingerprint.put_domain_u64(s, build_fingerprint.DOMAIN_TARGET_MODEL, VERSION, m.extensions);
}

test fs_policy_put__isolated_to_declared_policy_fields {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var bad: bool = false;

    var pa: catalog_os.FsPolicy;
    pa.sysroot             = "";
    pa.toolchain_root      = "";
    pa.dynamic_interpreter = "/lib64/ld-linux-x86-64.so.2";
    pa.platform_lib        = "";
    pa.libdirs[0]          = "/lib64";
    pa.libdir_len          = 1;

    var pb: catalog_os.FsPolicy = pa;
    pb.dynamic_interpreter = "/lib/ld-linux-aarch64.so.1";

    var ea: wire.Sink = wire.grown(?alloc);
    var eb: wire.Sink = wire.grown(?alloc);
    fs_policy_put(?pa, ?ea);
    fs_policy_put(?pb, ?eb);
    if (t_same_bytes(?ea, ?eb)) { bad = true; }
    if (ea.len == 0)            { bad = true; }

    var ea2: wire.Sink = wire.grown(?alloc);
    fs_policy_put(?pa, ?ea2);
    if (!t_same_bytes(?ea, ?ea2)) { bad = true; }

    wire.dnit(?ea);
    wire.dnit(?eb);
    wire.dnit(?ea2);
    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun t_put(t: *binding.Binding, s: *wire.Sink) bool {
    put(t, s);
    ret !s.failed;
}

#[testing]
fun t_same_bytes(a: *wire.Sink, b: *wire.Sink) bool {
    if (a.failed || b.failed || a.len != b.len) { ret false; }
    ret memory.raw_equal(wire.bytes(a)::ptr, wire.bytes(b)::ptr, a.len);
}

test put__stable_across_two_encodings_of_the_same_target {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val reg: *lang_target.TargetRegistry = lang_target.t_registry();

    val ra: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "x86_64", "linux", "sysv64", "elf");
    val rb: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "x86_64", "linux", "sysv64", "elf");
    if (sel ra.err) { ret 1; }
    if (sel rb.err) { ret 1; }
    var ta: binding.Binding = ra.ok;
    var tb: binding.Binding = rb.ok;

    var ea: wire.Sink = wire.grown(?alloc);
    var eb: wire.Sink = wire.grown(?alloc);
    if (!t_put(?ta, ?ea))        { ret 1; }
    if (!t_put(?tb, ?eb))        { ret 1; }
    if (!t_same_bytes(?ea, ?eb)) { ret 1; }
    if (ea.len == 0)             { ret 1; }

    wire.dnit(?ea);
    wire.dnit(?eb);
    ret 0;
}

test put__sensitive_to_arch_abi_os_of_debug_backend_and_image {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val reg: *lang_target.TargetRegistry = lang_target.t_registry();

    val base: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "x86_64", "linux", "sysv64", "elf");
    if (sel base.err) { ret 1; }
    var tbase: binding.Binding = base.ok;
    var ebase: wire.Sink       = wire.grown(?alloc);
    if (!t_put(?tbase, ?ebase)) { ret 1; }

    var value_abi: abi.AbiVTable = @tbase.abi;
    value_abi.passing = catalog_abi.PASSING_VALUES;
    var value_target: binding.Binding = tbase;
    value_target.abi = ?value_abi;
    var e_value: wire.Sink = wire.grown(?alloc);
    fin { wire.dnit(?e_value); }
    if (!t_put(?value_target, ?e_value) || t_same_bytes(?ebase, ?e_value))                  { ret 2; }
    if (tuple.capability(tbase.os, tbase.isa, ?value_abi, tbase.of) != tuple.ABI_TRANSPORT) { ret 3; }

    var td_page: binding.Binding = tbase;
    td_page.target.page_size = tbase.target.page_size * 2;
    var e_page: wire.Sink = wire.grown(?alloc);
    if (!t_put(?td_page, ?e_page))     { ret 1; }
    if (t_same_bytes(?ebase, ?e_page)) { ret 1; }

    val diff_arch: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "aarch64", "linux", "aapcs64", "elf");
    if (sel diff_arch.err) { ret 1; }
    var td_arch: binding.Binding = diff_arch.ok;
    var e_arch:  wire.Sink       = wire.grown(?alloc);
    if (!t_put(?td_arch, ?e_arch))     { ret 1; }
    if (t_same_bytes(?ebase, ?e_arch)) { ret 1; }

    val diff_of: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "x86_64", "freestanding", "sysv64", "raw");
    val same_of: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "x86_64", "freestanding", "sysv64", "elf");
    if (sel diff_of.err) { ret 1; }
    if (sel same_of.err) { ret 1; }
    var td_of:    binding.Binding = diff_of.ok;
    var ts_of:    binding.Binding = same_of.ok;
    var e_of_raw: wire.Sink       = wire.grown(?alloc);
    var e_of_elf: wire.Sink       = wire.grown(?alloc);
    if (!t_put(?td_of, ?e_of_raw))          { ret 1; }
    if (!t_put(?ts_of, ?e_of_elf))          { ret 1; }
    if (t_same_bytes(?e_of_raw, ?e_of_elf)) { ret 1; }

    val diff_os: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "x86_64", "darwin", "sysv64", "");
    if (sel diff_os.err) { ret 1; }
    var td_os: binding.Binding = diff_os.ok;
    var e_os:  wire.Sink       = wire.grown(?alloc);
    if (!t_put(?td_os, ?e_os))       { ret 1; }
    if (t_same_bytes(?ebase, ?e_os)) { ret 1; }

    val diff_backend: res[binding.Binding, fail.Fail] = lang_target.select_of(reg, "spirv", "freestanding", "spirv", "spv");
    if (sel diff_backend.err) { ret 1; }
    var td_backend: binding.Binding = diff_backend.ok;
    var e_backend:  wire.Sink       = wire.grown(?alloc);
    if (!t_put(?td_backend, ?e_backend))  { ret 1; }
    if (t_same_bytes(?ebase, ?e_backend)) { ret 1; }

    var req_a: lang_target.TargetRequest = lang_target.target_request("x86_64", "freestanding", "sysv64");
    lang_target.with_image(?req_a, 0x400000, 0, 0);
    var req_b: lang_target.TargetRequest = lang_target.target_request("x86_64", "freestanding", "sysv64");
    lang_target.with_image(?req_b, 0x500000, 0, 0);
    val ria: res[binding.Binding, fail.Fail] = lang_target.resolve(reg, ?req_a);
    val rib: res[binding.Binding, fail.Fail] = lang_target.resolve(reg, ?req_b);
    if (sel ria.err) { ret 1; }
    if (sel rib.err) { ret 1; }
    var tia:  binding.Binding = ria.ok;
    var tib:  binding.Binding = rib.ok;
    var e_ia: wire.Sink       = wire.grown(?alloc);
    var e_ib: wire.Sink       = wire.grown(?alloc);
    if (!t_put(?tia, ?e_ia))        { ret 1; }
    if (!t_put(?tib, ?e_ib))        { ret 1; }
    if (t_same_bytes(?e_ia, ?e_ib)) { ret 1; }

    wire.dnit(?ebase);
    wire.dnit(?e_page);
    wire.dnit(?e_arch);
    wire.dnit(?e_of_raw);
    wire.dnit(?e_of_elf);
    wire.dnit(?e_os);
    wire.dnit(?e_backend);
    wire.dnit(?e_ia);
    wire.dnit(?e_ib);
    ret 0;
}

test put__sensitive_to_the_selected_extensions {
    val reg:  *lang_target.TargetRegistry     = lang_target.t_registry();
    val base: res[binding.Binding, fail.Fail] = lang_target.select(reg, "x86_64", "linux", "sysv64");
    if (sel base.err) { ret 2; }
    var names: [1]str                    = [1]str{"sha"};
    var req:   lang_target.TargetRequest = lang_target.target_request("x86_64", "linux", "sysv64");
    lang_target.with_extensions(?req, ?names[0], 1);
    val sha: res[binding.Binding, fail.Fail] = lang_target.resolve(reg, ?req);
    if (sel sha.err) { ret 3; }

    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 4; }
    var eb: wire.Sink       = wire.grown(?alloc);
    var es: wire.Sink       = wire.grown(?alloc);
    var bt: binding.Binding = base.ok;
    var st: binding.Binding = sha.ok;
    if (!t_put(?bt, ?eb) || !t_put(?st, ?es)) { ret 5; }
    val same: bool = t_same_bytes(?eb, ?es);
    wire.dnit(?eb);
    wire.dnit(?es);
    if (same) { ret 6; }
    ret 0;
}
