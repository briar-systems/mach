# the description of a resolved target: plain facts the front end, the
# middle end and every backend read, importing nothing from the backend. the
# member vtables the description was resolved from stay with the backend's
# binding (target.binding)
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use mach.lang.ct;
use mach.lang.float;
use mach.lang.layout;
use catalog_abi:       mach.lang.target.catalog.abi;
use catalog_os:        mach.lang.target.catalog.os;
use target_definition: mach.lang.target.definition;
use mach.lang.target.extension;
use target_model:    mach.lang.target.model;
use mirl_capability: mirl.target.capability;
use std.types.size.usize;

# whether an asm body returns from the function that holds it
pub def AsmReturnsFn: fun(str) bool;

# whether one instruction materializes the integer `value`, read at `bits`
# (at most 64): the rule the middle end hoists a loop's constants by
pub def IntImmFitsFn: fun(u64, u32) bool;

pub rec Target {
    os_id:    u32;
    arch_id:  u32;
    abi_id:   u32;
    of_id:    u32;
    debug_id: u32;
    model:    target_model.Machine;
    # the instruction set's pointer width in bytes
    pointer_width: u32;
    # the instruction and type table the instruction set registered, nil on one with none
    defs: *target_definition.Table;
    # how the calling convention passes a value: in carriers, or as a logical value
    passing:                 catalog_abi.Passing;
    base:                    u64;
    stack_reserve:           u64;
    stack_commit:            u64;
    page_size:               u64;
    variadic_args_on_stack:  bool;
    fixed_args_natural_size: bool;
    reg_arg_align:           u32;
    reg_arg_extend:          u32;
    agg_arg_natural_align:   bool;
    va_list_size:            u32;
    va_list_align:           u32;
    fs_policy:               catalog_os.FsPolicy;
    # the host reports the data-independent-timing mode `model.dit_mode` names and lets a
    # process enable it
    timing_mode_provable: bool;
    # the host runs an executable position independent unless asked otherwise
    pie_default: bool;
    env_id:      u32;
    env_profile: u32;
    env_name:    str;
    # whether `asm` blocks reach the backend, and the rule an asm body returns by;
    # nil where the instruction set takes no assembly
    has_assembly:     bool;
    assembly_returns: AsmReturnsFn;
    # nil on an instruction set whose constants the middle end leaves in place
    int_imm_fits: IntImmFitsFn;
    # every extension vocabulary the registered instruction sets declare, which
    # `#[extensions(...)]` names are read against beside the selected one
    vocabulary: extension.Vocabulary;
    # the extents the target's owner row lays each primitive out at, none held for a
    # cell no owner has a row for yet
    scalars: layout.Scalars;
    # the nan each float format's operations return: the owner's, else mach's own
    # rule for a cell no owner assembles yet
    nans: Nans;
    # the selection the owners' target stands on, the baseline with the extensions the
    # target adds, none for the cell's own
    stands: opt[str];
}

# the nan a target's float operations return in each format, binary16, binary32
# and binary64 at the index of mirl's format, which mirl's folder reads
pub rec Nans {
    formats: [3]mirl_capability.Nans;
}

# no format's rule stated, as where no target is selected
pub fun nans_none() Nans {
    var n: Nans;
    var i: usize = 0;
    for (i < 3) {
        n.formats[i] = mirl_capability.Nans.unstated{};
        i            = i + 1;
    }
    ret n;
}

# the rule of a target cell no owner assembles yet, read from mach's own (#4779)
pub fun nans_of_rule(r: float.NanRule) Nans {
    var rule: mirl_capability.Nans = mirl_capability.Nans.unstated{};
    if (r == float.NAN_PRESERVE)    { rule = mirl_capability.Nans.propagate{mirl_capability.Propagation{default: mirl_capability.Default.unstated{}, priority: mirl_capability.Priority.unstated{}, fused: mirl_capability.Fused.unstated{}}}; }
    if (r == float.NAN_CANONICAL)   { rule = mirl_capability.Nans.canonical{}; }
    if (r == float.NAN_UNSPECIFIED) { rule = mirl_capability.Nans.unspecified{}; }
    var n: Nans  = nans_none();
    var i: usize = 0;
    for (i < 3) {
        n.formats[i] = rule;
        i            = i + 1;
    }
    ret n;
}

# the rule of the format of width `w`, binary64 for any other width
pub fun nans_at(n: *Nans, w: float.FloatWidth) mirl_capability.Nans {
    if (w == float.FLOAT_W_16) { ret n.formats[0]; }
    if (w == float.FLOAT_W_32) { ret n.formats[1]; }
    ret n.formats[2];
}

# whether any format's rule is stated, as it is wherever a target is selected
pub fun nans_held(n: *Nans) bool {
    var i: usize = 0;
    for (i < 3) {
        if (!(sel n.formats[i].unstated)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the layout machine of a resolved target. total over what resolve produces,
# which always selects an instruction set: a nil target is a caller defect
pub fun layout_machine(tgt: *Target) layout.Machine {
    if (tgt == nil) {
        panic("target.resolved: layout query needs a resolved target with an instruction set\n");
    }
    ret layout.with_scalars(layout.machine(tgt.pointer_width, tgt.model.vector_bits, target_model.vector_register_bits(?tgt.model)), tgt.scalars);
}

# whether the target guarantees the data-independent-timing mode a DIT_MODE
# row needs: mink's host of the target declares it
pub fun dit_mode_guaranteed(tgt: *Target) bool {
    if (tgt == nil) { ret false; }
    ret tgt.timing_mode_provable;
}

# the constant-time multiply cells this target admits: the one decision the
# lowering gate, the oblivious validators and `$mach.build.ct_mul` all read
pub fun ct_mul_admitted(tgt: *Target) ct.CtMulMask {
    ret target_model.ct_mul_rows_admit(?tgt.model, dit_mode_guaranteed(tgt));
}

# what a program may ask of its target while it compiles: the catalog ids, the machine's
# widths and float support, the va_list shape, the instruction and type table, the
# constant-time multiply cells it admits, the extensions it selects and every vocabulary
# they are read against, what a float conversion makes of a NaN, and whether `asm` reaches
# an assembler
pub rec Facts {
    os_id:         u32;
    arch_id:       u32;
    abi_id:        u32;
    pointer_width: u32;
    vector_bits:   u32;
    register_bits: u32;
    has_float:     bool;
    va_list_size:  u32;
    va_list_align: u32;
    defs:          *target_definition.Table;
    ct_mul:        ct.CtMulMask;
    extensions:    target_model.ExtensionView;
    vocabulary:    extension.Vocabulary;
    nan_rule:      float.NanRule;
    has_assembly:  bool;
    # whether a pointer is an address, or on a logical target a reference to a declared type
    flat_addressing: bool;
    # the extents the target's owner row lays each primitive out at
    scalars: layout.Scalars;
    # the nan each float format's operations return, which comptime folds by
    nans: Nans;
}

pub fun facts(tgt: *Target) Facts {
    ret Facts{
        os_id:       tgt.os_id, arch_id: tgt.arch_id, abi_id: tgt.abi_id, pointer_width: tgt.pointer_width,
        vector_bits: tgt.model.vector_bits, register_bits: target_model.vector_register_bits(?tgt.model),
        has_float:   tgt.model.has_float, va_list_size: tgt.va_list_size, va_list_align: tgt.va_list_align,
        defs:        tgt.defs, ct_mul: ct_mul_admitted(tgt), extensions: target_model.extension_view(?tgt.model),
        vocabulary:  tgt.vocabulary, nan_rule: tgt.model.nan_rule, has_assembly: tgt.has_assembly, flat_addressing: tgt.model.flat_addressing,
        scalars:     tgt.scalars, nans: tgt.nans
    };
}

# the facts where no target is selected: an 8-byte pointer, 128-bit vectors, floats, and no
# table, extension, multiply cell or NaN rule to read
pub fun facts_none() Facts {
    ret Facts{
        os_id:        0, arch_id: 0, abi_id: 0, pointer_width: 8, vector_bits: 128, register_bits: 128, has_float: true,
        va_list_size: 0, va_list_align: 0, defs: nil, ct_mul: ct.mul_mask_none(),
        extensions:   target_model.ExtensionView{selected: 0, table: nil},
        vocabulary:   extension.vocabulary_empty(), nan_rule: float.NAN_RULE_NONE, has_assembly: true, flat_addressing: true,
        scalars:      layout.scalars_none(), nans: nans_none()
    };
}

# the cells the instruction set declares only under its data-independent-timing
# mode, whether or not the os guarantees the mode: a secret multiply in one of
# them is what makes a program need the mode at start, and what the refusal
# names when the os declares nothing
pub fun ct_mul_dit_cells(tgt: *Target) ct.CtMulMask {
    ret target_model.ct_mul_rows_under(?tgt.model, ct.CT_MUL_DIT_MODE);
}
