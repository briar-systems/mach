# the description of a resolved target: the owners' rows it names and the plain
# facts the front end, the middle end and the back half read of it
#
# a target is a row of mink's architecture catalog, a row of its system catalog
# under the environment the manifest states, a member of the architecture's
# convention axis, and a baseline over masc's catalog of the architecture's
# extensions with the extensions the target adds. every fact here is read from
# those owners when the target resolves (mach.lang.target) and none is stated
# by mach
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use mach.lang.ct;
use mach.lang.float;
use mach.lang.layout;
use masc_extension: masc.core.extension;
use masc.core.requirement;
use mink_arch: mink.catalog.arch;
use mink.catalog.format.Format;
use mink_os:         mink.catalog.os;
use mink_subsystem:  mink.catalog.subsystem;
use mirl_capability: mirl.target.capability;

# the most extensions a target adds over its baseline
pub val MAX_ADDED: u32 = 64;

# what mirl says of the `va_list` of the target's own convention
# ---
# listed:   its size and alignment under the target's data layout
# unlisted: the convention has no `va_list`
# refused:  mirl answers none for the target, with why
pub tag VaList: u8 {
    listed: layout.Extent;
    unlisted;
    refused: str;
}

# the words a selection of masc's largest catalog takes, one bit per row
val SELECTED_WORDS: usize = 64;

# a closed selection of masc's catalog of the target's architecture, held by value
# ---
# catalog: the catalog, nil where masc serves the architecture with none
# words:   one bit per catalog row the selection holds
pub rec Selected {
    catalog: *masc_extension.Catalog;
    words:   [SELECTED_WORDS]u64;
}

# no selection
pub fun selected_none() Selected {
    var s: Selected;
    s.catalog = nil;
    var i: usize = 0;
    for (i < SELECTED_WORDS) {
        s.words[i] = 0;
        i          = i + 1;
    }
    ret s;
}

# `s` held by value, its rows past what a Selected holds dropped, as no masc catalog has
pub fun selected_of(s: *masc_extension.Selection) Selected {
    var out: Selected = selected_none();
    out.catalog = s.catalog;
    var i: u32 = 0;
    for (i < s.catalog.count && i::usize < SELECTED_WORDS * 64) {
        if (masc_extension.has(s, i)) { out.words[i::usize / 64] = out.words[i::usize / 64] | (1::u64 << (i % 64)::u64); }
        i = i + 1;
    }
    ret out;
}

# whether `s` holds the catalog row `id`
pub fun selected_has(s: *Selected, id: requirement.Id) bool {
    if (s.catalog == nil || id >= s.catalog.count || id::usize >= SELECTED_WORDS * 64) { ret false; }
    ret (s.words[id::usize / 64] & (1::u64 << (id % 64)::u64)) != 0;
}

# the one extension of the selection's catalog `name[0..len]` names, none where the
# catalog has no such name or it names a level of many
pub fun extension_named(s: *Selected, name: str, len: usize) opt[requirement.Id] {
    if (s.catalog == nil || len == 0) { ret opt[requirement.Id].none{}; }
    val e: opt[*masc_extension.NameEntry] = masc_extension.entry(s.catalog, View{data: name, len: len}, false);
    if (sel e.none) { ret opt[requirement.Id].none{}; }
    ret masc_extension.only(s.catalog, e.some);
}

pub rec Target {
    # mink's rows, nil where no target is selected
    arch: *mink_arch.Arch;
    sys:  *mink_os.System;
    env:  opt[*mink_os.Env];
    # the member of the architecture's convention axis, mink's psABI spelling
    abi: str;
    # the baseline the target stands on, in masc's spelling: the one it states, else
    # its host's floor
    isa: str;
    # the names of masc's catalog the target adds over its baseline, borrowed from
    # the request
    added:       [MAX_ADDED]str;
    added_count: u32;
    # the object format the system writes, the first its row lists, or the one the
    # target names of those it lists
    format: *Format;
    # the tag ids of the system, the architecture and the convention (mach.lang.target.tags)
    os_id:   u32;
    arch_id: u32;
    abi_id:  u32;
    # the manifest's `env` as written, "" for none
    env_name: str;
    # the image keys the manifest states, 0 for unstated
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
    # the width of an address of the default space, mirl's layout of a pointer
    pointer_width: u32;
    # the extents mirl lays each primitive out at and the vector registers it fits to
    scalars: layout.Scalars;
    # the nan each float format's operations return, mirl's rule
    nans: Nans;
    # the `va_list` of the target's convention, mirl's row of it
    va_list: VaList;
    # the scalar multiplies mirl runs in time independent of their operands on the target
    multiplies: ct.CtMulMask;
    # the closed selection of the baseline with what the target adds
    selected: Selected;
    # whether masc serves the architecture with an instruction set, so an `asm` block
    # has an assembler
    has_assembly: bool;
    # whether a pointer is an address, or held logically as a reference to a declared type
    flat_addressing: bool;
    # the host runs an executable position independent unless asked otherwise
    pie_default: bool;
    # the subsystem the host's images state by default, none where its images state
    # no subsystem, as an ELF host's do
    subsystem: opt[*mink_subsystem.Subsystem];
}

# no target selected
pub fun none() Target {
    var t: Target;
    t.arch            = nil;
    t.sys             = nil;
    t.env             = opt[*mink_os.Env].none{};
    t.abi             = "";
    t.isa             = "";
    t.added_count     = 0;
    t.format          = nil;
    t.os_id           = 0;
    t.arch_id         = 0;
    t.abi_id          = 0;
    t.env_name        = "";
    t.base            = 0;
    t.stack_reserve   = 0;
    t.stack_commit    = 0;
    t.pointer_width   = 0;
    t.scalars         = layout.scalars_none();
    t.nans            = nans_none();
    t.va_list         = VaList.unlisted{};
    t.multiplies      = ct.mul_mask_none();
    t.selected        = selected_none();
    t.has_assembly    = false;
    t.flat_addressing = true;
    t.pie_default     = false;
    t.subsystem       = opt[*mink_subsystem.Subsystem].none{};
    ret t;
}

# whether a target is selected
pub fun is_selected(t: *Target) bool {
    ret t.arch != nil && t.sys != nil;
}

# the nan a target's float operations return in each format, binary16, binary32
# and binary64 at the index of mirl's format, which mirl's folder reads
pub rec Nans {
    formats: [3]mirl_capability.Nans;
}

# no format's rule stated, as where no target is selected
pub fun nans_none() Nans {
    var n: Nans;
    var i: usize = 0;
    for (i < 3) {
        n.formats[i] = mirl_capability.Nans.unstated{};
        i            = i + 1;
    }
    ret n;
}

# the rule of the format of width `w`, binary64 for any other width
pub fun nans_at(n: *Nans, w: float.FloatWidth) mirl_capability.Nans {
    if (w == float.FLOAT_W_16) { ret n.formats[0]; }
    if (w == float.FLOAT_W_32) { ret n.formats[1]; }
    ret n.formats[2];
}

# whether any format's rule is stated, as it is wherever a target is selected
pub fun nans_held(n: *Nans) bool {
    var i: usize = 0;
    for (i < 3) {
        if (!(sel n.formats[i].unstated)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the vector registers of a layout, 0 where mirl fits a vector to no register and
# aligns it to its element
fun vector_bits(s: *layout.Scalars) u32 {
    if (sel s.vectors.some) { ret s.vectors.some.narrow; }
    ret 0;
}

fun register_bits(s: *layout.Scalars) u32 {
    if (sel s.vectors.some) { ret s.vectors.some.widest; }
    ret 0;
}

# the layout machine of a target: mirl's extents for every primitive and vector
pub fun layout_machine(tgt: *Target) layout.Machine {
    ret layout.with_scalars(layout.machine(tgt.pointer_width, vector_bits(?tgt.scalars), register_bits(?tgt.scalars)), tgt.scalars);
}

# what a program may ask of its target while it compiles: the tag ids, the
# extents of its primitives and vectors, the selection its extensions are read
# against, what a float operation makes of a NaN, and whether `asm` reaches an
# assembler
pub rec Facts {
    os_id:         u32;
    arch_id:       u32;
    abi_id:        u32;
    pointer_width: u32;
    vector_bits:   u32;
    register_bits: u32;
    selected:      Selected;
    has_assembly:  bool;
    # whether a pointer is an address, or on a logical target a reference to a declared type
    flat_addressing: bool;
    # the extents mirl lays each primitive out at
    scalars: layout.Scalars;
    # the nan each float format's operations return, which comptime folds by
    nans: Nans;
    # the `va_list` of the target's convention, which `abi_type("va_list")` declares
    va_list: VaList;
    # the scalar multiplies mirl runs in time independent of their operands, which
    # `$mach.build.ct_mul` reads
    multiplies: ct.CtMulMask;
}

pub fun facts(tgt: *Target) Facts {
    ret Facts{
        os_id:        tgt.os_id, arch_id: tgt.arch_id, abi_id: tgt.abi_id, pointer_width: tgt.pointer_width,
        vector_bits:  vector_bits(?tgt.scalars), register_bits: register_bits(?tgt.scalars), selected: tgt.selected,
        has_assembly: tgt.has_assembly, flat_addressing: tgt.flat_addressing, scalars: tgt.scalars, nans: tgt.nans,
        va_list:      tgt.va_list, multiplies: tgt.multiplies
    };
}
