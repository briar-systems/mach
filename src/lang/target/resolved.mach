# a resolved target: mink's resolution of a spelling and its narrowing, masc's closed
# selection of the instruction set and the extensions it adds, and what mach states of
# the images it builds
#
# mink's catalog resolves every part of a target and supplies every default, masc checks
# the instruction set and the extensions once and returns the closed selection, and mach
# keeps only its own data beside them: the image keys a manifest states, else its stack
# defaults (mach.lang.target.defaults), and the product under build
use std.text.string.str_dup_range;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;

use masc_extension: masc.core.extension;
use masc.core.requirement;
use masc_isa:  masc.isa.isa;
use mink_fail: mink.base.fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink_arch:      mink.catalog.arch;
use mink_arch_list: mink.catalog.arch.list;
use mink.catalog.code.CodeModel;
use mink_os:      mink.catalog.os;
use mink_os_list: mink.catalog.os.list;
use mink_linkage: mink.catalog.output.linkage;
use mink.catalog.output.product.Product;
use mink_target: mink.catalog.target;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use target_defaults: mach.lang.target.defaults;

# the most extensions a target adds over its baseline
pub val MAX_ADDED: u32 = 64;

# the words a selection of masc's largest catalog takes, one bit per row
val SELECTED_WORDS: usize = 64;

# a closed selection of masc's catalog of the target's architecture, held by value
# ---
# catalog: the catalog, nil where masc serves the architecture with none
# words:   one bit per catalog row the selection holds
pub rec Selected {
    catalog: *masc_extension.Catalog;
    words:   [SELECTED_WORDS]u64;
}

# no selection
pub fun selected_none() Selected {
    var s: Selected;
    s.catalog = nil;
    var i: usize = 0;
    for (i < SELECTED_WORDS) {
        s.words[i] = 0;
        i          = i + 1;
    }
    ret s;
}

# `s` held by value, its rows past what a Selected holds dropped, as no masc catalog has
fun selected_of(s: *masc_extension.Selection) Selected {
    var out: Selected = selected_none();
    out.catalog = s.catalog;
    var i: u32 = 0;
    for (i < s.catalog.count && i::usize < SELECTED_WORDS * 64) {
        if (masc_extension.has(s, i)) { out.words[i::usize / 64] = out.words[i::usize / 64] | (1::u64 << (i % 64)::u64); }
        i = i + 1;
    }
    ret out;
}

# whether `s` holds the catalog row `id`
pub fun selected_has(s: *Selected, id: requirement.Id) bool {
    if (s.catalog == nil || id >= s.catalog.count || id::usize >= SELECTED_WORDS * 64) { ret false; }
    ret (s.words[id::usize / 64] & (1::u64 << (id % 64)::u64)) != 0;
}

# the one extension of the selection's catalog `name[0..len]` names, none where the
# catalog has no such name or it names a level of many
pub fun extension_named(s: *Selected, name: str, len: usize) opt[requirement.Id] {
    if (s.catalog == nil || len == 0) { ret opt[requirement.Id].none{}; }
    val e: opt[*masc_extension.NameEntry] = masc_extension.entry(s.catalog, View{data: name, len: len}, false);
    if (sel e.none) { ret opt[requirement.Id].none{}; }
    ret masc_extension.only(s.catalog, e.some);
}

# a target mink resolved and masc checked
# ---
# target:        mink's resolution, its rows nil where no target is selected. its `ext`
#                is borrowed from the narrowing, which a resolved target outlives, so it
#                is cleared and the names are held in `added`
# added:         the names of masc's catalog the target adds over its baseline
# added_count:   how many
# selected:      masc's closed selection of the instruction set with what the target adds
# code_model:    the code model the narrowing names, none where the target takes its host's
#                default, which mirl reads as unpicked
# product:       the product of the artifact under build, which mirl's address model reads:
#                a shared object's exported definitions another image may preempt. none
#                where no artifact selected the target
# base:          the image base the manifest states, 0 for none
# stack_reserve: the main stack's reserve the manifest states, else mach's default for the
#                system (mach.lang.target.defaults), 0 for none
# stack_commit:  the main stack's commit the manifest states, 0 for none
pub rec Target {
    target:        mink_target.Target;
    added:         [MAX_ADDED]str;
    added_count:   u32;
    selected:      Selected;
    code_model:    opt[*CodeModel];
    product:       opt[*Product];
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
}

# the image keys a manifest states of a target, 0 for each it leaves out
pub rec Image {
    base:          u64;
    stack_reserve: u64;
    stack_commit:  u64;
}

# no target selected
pub fun none() Target {
    var t: Target;
    t.target        = mink_target.Target{sys: nil, arch: nil, env: opt[*mink_os.Env].none{}, host: nil, abi: mink_os.Default.none{}, isa: mink_target.Isa.unbounded{}, ext: nil, ext_count: 0, code_model: opt[*CodeModel].none{}, linkage: opt[*mink_linkage.Linkage].none{}, format: nil};
    t.added_count   = 0;
    t.selected      = selected_none();
    t.code_model    = opt[*CodeModel].none{};
    t.product       = opt[*Product].none{};
    t.base          = 0;
    t.stack_reserve = 0;
    t.stack_commit  = 0;
    ret t;
}

# whether a target is selected
pub fun is_selected(t: *Target) bool {
    ret t.target.arch != nil && t.target.sys != nil;
}

# the calling convention row of the target, nil where its family names none
pub fun abi(t: *Target) *mink_arch.Abi {
    val d: mink_os.Default = t.target.abi;
    if (sel d.row) { ret d.row; }
    ret nil;
}

# mink's psABI name of the target's calling convention, "" where its family names none
pub fun abi_name(t: *Target) str {
    val row: *mink_arch.Abi = abi(t);
    if (row == nil) { ret ""; }
    ret row.name;
}

# the instruction set the target stands on, in masc's spelling
pub fun isa(t: *Target) str {
    val i: mink_target.Isa = t.target.isa;
    if (sel i.floor)  { ret i.floor; }
    if (sel i.stated) { ret i.stated; }
    ret "";
}

# whether the target's executable is position independent: the linkage the target
# resolved to. false where the host runs no executable
pub fun pie(t: *Target) bool {
    val l: opt[*mink_linkage.Linkage] = t.target.linkage;
    ret sel l.some && l.some == ?mink_linkage.PIE;
}

# a refusal of a target and the part of it refused
# ---
# part: the part, as mink names it
# why:  the refusal, worded
pub rec Refused {
    part: mink_target.Part;
    why:  fail.Fail;
}

# mink's failure `f` as mach's
pub fun refusal(a: *A.Allocator, f: mink_fail.Fail) fail.Fail {
    if (f.subject == nil) { ret fail.formatted(a, "target: mink's catalog: {}", f.text); }
    ret fail.formatted(a, "target: mink's catalog: {}: {}", f.subject, f.text);
}

# mink's refusal of a part of a target as a user failure of `kind`, in mink's words
pub fun refused(a: *A.Allocator, kind: diagnostic_kind.Kind, r: *mink_target.Refusal) fail.Fail {
    var out:     Sink                = sink.make(a, LITTLE);
    val written: err[mink_fail.Fail] = mink_target.write(r, ?out);
    if (sel written.err) {
        val dropped: err[mink_fail.Fail] = sink.release(?out);
        ret refusal(a, written.err);
    }
    val text:  res[str, A.Error]   = str_dup_range(a, sink.data(?out)::str, 0, sink.len(?out));
    val freed: err[mink_fail.Fail] = sink.release(?out);
    if (sel text.err) { ret fail.refused(text.err); }
    ret fail.user(kind, text.ok);
}

# the diagnostic a refusal of `r`'s part is reported as
fun kind_of(r: *mink_target.Refusal) diagnostic_kind.Kind {
    val p: mink_target.Part = r.part;
    if (sel p.isa && r.given.len == 0) { ret diagnostic_kind.TARGET_BASELINE_REQUIRED; }
    if (sel p.extension)               { ret diagnostic_kind.EXTENSION_UNKNOWN; }
    if (sel p.env)                     { ret diagnostic_kind.MANIFEST_INVALID_VALUE; }
    if (sel p.abi)                     { ret diagnostic_kind.MANIFEST_INVALID_VALUE; }
    if (sel p.linkage)                 { ret diagnostic_kind.MANIFEST_INVALID_VALUE; }
    ret diagnostic_kind.TARGET_UNSUPPORTED;
}

fun mink_refused(a: *A.Allocator, r: mink_target.Refusal) Refused {
    var held: mink_target.Refusal = r;
    ret Refused{part: r.part, why: refused(a, kind_of(?held), ?held)};
}

# the system and the architecture named `sys` and `arch`, each a row's name, as a spelling
# `<sys>-<arch>` names them
pub fun spec_of(sys: str, arch: str) res[mink_target.Spec, mink_target.Refusal] {
    val s: res[*mink_os.System, mink_fail.Fail] = mink_os_list.by_name(sys);
    if (sel s.err) { ret res[mink_target.Spec, mink_target.Refusal].err{mink_target.refusal(mink_target.Part.sys{}, sys, "no system has this name", mink_target.Accepted.systems{})}; }
    val r: res[*mink_arch.Arch, mink_fail.Fail] = mink_arch_list.by_name(arch);
    if (sel r.err) { ret res[mink_target.Spec, mink_target.Refusal].err{mink_target.refusal(mink_target.Part.arch{}, arch, "no architecture has this name", mink_target.Accepted.archs{s.ok})}; }
    ret res[mink_target.Spec, mink_target.Refusal].ok{mink_target.Spec{sys: s.ok, arch: r.ok}};
}

# the target `s` narrowed by `n` resolves to, with the image keys `image` states. mink
# resolves every part, the object format included, and masc checks the instruction set and
# the extensions the narrowing adds. the target holds the names of the extensions, and
# borrows the narrowing's other text
pub fun resolve(a: *A.Allocator, s: mink_target.Spec, n: *mink_target.Narrowing, image: Image) res[Target, Refused] {
    if (n.ext_count > MAX_ADDED::usize) {
        ret res[Target, Refused].err{Refused{part: mink_target.Part.extension{}, why: fail.formatted_user(a, diagnostic_kind.EXTENSION_TOO_MANY, "target: the target adds more than {} extensions", MAX_ADDED)}};
    }
    val got: res[mink_target.Target, mink_target.Refusal] = mink_target.resolve(s, n);
    if (sel got.err) { ret res[Target, Refused].err{mink_refused(a, got.err)}; }
    var t: Target = none();
    t.target = got.ok;
    val stated: res[str, mink_target.Refusal] = mink_target.isa(?t.target);
    if (sel stated.err) { ret res[Target, Refused].err{mink_refused(a, stated.err)}; }
    val convention: res[opt[*mink_arch.Abi], mink_target.Refusal] = mink_target.abi(?t.target);
    if (sel convention.err) { ret res[Target, Refused].err{mink_refused(a, convention.err)}; }
    val checked: res[opt[masc_isa.Checked], mink_target.Refusal] = masc_isa.check(a, ?t.target);
    if (sel checked.err) { ret res[Target, Refused].err{mink_refused(a, checked.err)}; }
    val held: opt[masc_isa.Checked] = checked.ok;
    if (sel held.some) {
        var c: masc_isa.Checked = held.some;
        t.selected = selected_of(?c.selection);
        masc_isa.release(?c);
    }
    t.added_count = n.ext_count::u32;
    var i: usize = 0;
    for (i < n.ext_count) {
        t.added[i] = n.ext[i];
        i          = i + 1;
    }
    t.target.ext       = nil;
    t.target.ext_count = 0;
    if (n.code_model != nil) { t.code_model = t.target.code_model; }
    t.base             = image.base;
    t.stack_reserve    = image.stack_reserve;
    t.stack_commit     = image.stack_commit;
    if (image.stack_reserve == 0 && image.stack_commit == 0) {
        val reserve: opt[u64] = target_defaults.stack_reserve(t.target.sys);
        if (sel reserve.some) { t.stack_reserve = reserve.some; }
    }
    ret res[Target, Refused].ok{t};
}
