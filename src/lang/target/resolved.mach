use std.types.bool.bool;
use std.types.string.str;
use std.system.panic.panic;

use mach.lang.layout;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.os;

pub rec Target {
    os_id:    u32;
    arch_id:  u32;
    abi_id:   u32;
    debug_id: u32;
    os:       *os.OsVTable;
    isa:      *isa.IsaVTable;
    object:   of.ObjectTarget;
    arch:     *isa.RegMachine;
    abi:      *abi.AbiVTable;
    of:       *of.OfVTable;
    debug:    *of.DebugVTable;
    model:    isa.MachineModel;
    base:     u64;
    stack_reserve: u64;
    stack_commit:  u64;
    page_size:     u64;
    variadic_args_on_stack: bool;
    fixed_args_natural_size: bool;
    va_list_size:  u32;
    va_list_align: u32;
    fs_policy:     os.FsPolicy;
    env_id:        u32;
    env_profile:   u32;
    env_name:      str;
}

pub fun layout_machine(tgt: *Target) layout.Machine {
    if (tgt == nil || tgt.isa == nil) {
        panic("target.resolved: layout query needs a resolved target with an instruction set\n");
    }
    ret layout.machine(tgt.isa.pointer_width, tgt.model.vector_bits);
}

pub fun backend_target(tgt: *Target) isa.BackendTarget {
    var view: isa.BackendTarget;
    view.identity.arch_id   = tgt.arch_id;
    view.identity.os_id     = tgt.os_id;
    view.identity.abi_id    = tgt.abi_id;
    view.identity.of_id     = tgt.of.id;
    view.identity.debug_id  = tgt.debug_id;
    view.identity.arch_name = tgt.isa.name;
    view.identity.os_name   = tgt.os.name;
    view.identity.abi_name  = tgt.abi.name;
    view.identity.of_name   = tgt.of.name;
    view.identity.env_id      = tgt.env_id;
    view.identity.env_profile = tgt.env_profile;
    view.identity.env_name    = tgt.env_name;
    view.model = tgt.model;
    view.abi.gp_arg_regs                 = tgt.abi.gp_arg_regs;
    view.abi.callee_saved                = tgt.abi.callee_saved;
    view.abi.indirect_result_reg         = tgt.abi.indirect_result_reg;
    view.abi.indirect_result_in_argfile  = tgt.abi.indirect_result_in_argfile;
    view.abi.consumes_agg_layout         = tgt.abi.consumes_agg_layout;
    view.abi.fp_callee_saved_full_vector = tgt.abi.fp_callee_saved_full_vector;
    view.abi.float_arg_bits              = tgt.abi.float_arg_bits;
    view.abi.arg_slot_granularity        = tgt.abi.arg_slot_granularity;
    view.abi.variadic_args_on_stack      = tgt.variadic_args_on_stack;
    view.abi.fixed_args_natural_size     = tgt.fixed_args_natural_size;
    view.abi.va_list_size                = tgt.va_list_size;
    view.abi.va_list_align               = tgt.va_list_align;
    view.os.entry_symbol      = tgt.os.entry_symbol;
    view.os.c_symbol_prefix   = tgt.os.c_symbol_prefix;
    view.os.image_base = tgt.base;
    if (view.os.image_base == 0) { view.os.image_base = tgt.os.base_addr; }
    view.os.page_size = tgt.page_size;
    view.os.stack_probe       = tgt.os.stack_probe;
    view.os.mapped_by_loader  = tgt.os.mapped_by_loader;
    view.os.stack_reserve     = tgt.stack_reserve;
    view.os.stack_commit      = tgt.stack_commit;
    ret view;
}
