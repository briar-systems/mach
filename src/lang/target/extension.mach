# the extension vocabulary of an instruction set
#
# each isa module declares one table of named bits, and that table is the
# authority for every surface that spells an extension: the manifest's
# `[target.X].extensions`, `$mach.build.extensions.<name>`, `#[extensions(...)]` and the
# inline-asm refusals. a name is an identifier, so it can be a comptime member
# and a field of a runtime feature record. a bit is the isa's own: the same
# bit means different things on different instruction sets, and only a name
# crosses between them
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use std.allocator.page;
use std.text.string.str_free;

use mach.lang.lexis;
use mach.lang.textbuild;

pub rec Extension {
    name: str;
    bit:  u64;
    # the extensions this one brings with it: a selection is closed over
    # `implies` once, at target resolution, so a level is a bundle of bits and
    # never an axis of its own
    implies: u64;
    # nil when a function may admit the extension alone with `#[extensions]`;
    # otherwise why only a target selects it
    target_only: str;
}

# the most names a selection can hold: one per bit
pub val MAX_SELECTED: u32 = 64;

# a level is a published bundle of an isa's extensions under one manifest
# spelling (`x86-64-v3`). it is not a row: it has no bit, so it is never a
# comptime member, a decorator argument or a feature-record field, and only
# the manifest and a target request spell it. its members are closed over
# `implies` with the rest of the selection, so a level is exactly the union
# of its rows and whatever they bring
pub rec Level {
    name:    str;
    members: u64;
}

# the bit `table` gives the name at `name[0..len]`, 0 when the table does not name it
pub fun bit_of(table: *Extension, count: u32, name: str, len: usize) u64 {
    var i: u32 = 0;
    for (i < count) {
        if (str_len(table[i].name) == len && str_region_equals(name, 0, len, table[i].name)) { ret table[i].bit; }
        i = i + 1;
    }
    ret 0;
}

# the members of the level `table` names at `name[0..len]`, 0 when it names none
pub fun level_of(table: *Level, count: u32, name: str, len: usize) u64 {
    var i: u32 = 0;
    for (i < count) {
        if (str_len(table[i].name) == len && str_region_equals(name, 0, len, table[i].name)) { ret table[i].members; }
        i = i + 1;
    }
    ret 0;
}

# `bits` closed over `implies`: every extension a selected one brings, to a fixpoint
pub fun close(table: *Extension, count: u32, bits: u64) u64 {
    var out: u64 = bits;
    for (true) {
        var next: u64 = out;
        var i:    u32 = 0;
        for (i < count) {
            if ((out & table[i].bit) != 0) { next = next | table[i].implies; }
            i = i + 1;
        }
        if (next == out) { ret out; }
        out = next;
    }
    ret out;
}

# the extensions a body may emit: the target's selection and whatever its
# `#[extensions(...)]` admits beyond it. one predicate for the inliner and the
# encoder: an instruction needing `required` is emitted only into a body whose
# admitted set holds it
pub fun admitted(selected: u64, function: u64) u64 {
    ret selected | function;
}

pub fun admits(admitted_bits: u64, required: u64) bool {
    ret (required & ~admitted_bits) == 0;
}

# every bit the table names
pub fun domain(table: *Extension, count: u32) u64 {
    var mask: u64 = 0;
    var i:    u32 = 0;
    for (i < count) {
        mask = mask | table[i].bit;
        i    = i + 1;
    }
    ret mask;
}

# the first name the table gives any bit of `bits`, nil when it names none
pub fun first_name(table: *Extension, count: u32, bits: u64) str {
    var i: u32 = 0;
    for (i < count) {
        if ((table[i].bit & bits) != 0) { ret table[i].name; }
        i = i + 1;
    }
    ret nil;
}

# an extension name is spelled by the lexer's own rules: one identifier token,
# never a keyword, so every surface that names it parses it the same way
pub fun is_name(name: str, len: usize) bool {
    ret lexis.is_identifier(name, len) && !lexis.is_keyword(name, len);
}

# a level spelling is an identifier with `-` admitted inside it (`x86-64-v2`),
# so a manifest can carry a level where it carries a name and the resolver
# tells them apart by table, never by shape
fun is_level_spelling(name: str, len: usize) bool {
    if (len == 0 || !lexis.is_ident_start(name[0]::u8)) { ret false; }
    var i: usize = 1;
    for (i < len) {
        val c: u8 = name[i]::u8;
        if (c == '-') {
            if (i + 1 >= len || name[i + 1] == '-') { ret false; }
        }
        or (!lexis.is_ident_char(c)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# what a manifest's `extensions` entry may spell: a name or a level
pub fun is_spelling(name: str, len: usize) bool {
    ret is_name(name, len) || is_level_spelling(name, len);
}

# a level table is well formed against its extension table: every spelling a
# level spelling that no row also answers, no spelling repeated, every member
# a row of the table, nonempty, and each level a strict superset of the one
# before it, which is the order the published levels have
pub fun levels_valid(levels: *Level, count: u32, table: *Extension, ext_count: u32) bool {
    if (count == 0)    { ret true; }
    if (levels == nil) { ret false; }
    val all: u64 = domain(table, ext_count);
    var i:   u32 = 0;
    for (i < count) {
        val row: *Level = ?levels[i];
        val len: usize  = str_len(row.name);
        if (!is_level_spelling(row.name, len))                                                              { ret false; }
        if (bit_of(table, ext_count, row.name, len) != 0)                                                   { ret false; }
        if (row.members == 0 || (row.members & ~all) != 0)                                                  { ret false; }
        if (i > 0 && ((levels[i - 1].members & ~row.members) != 0 || levels[i - 1].members == row.members)) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (level_of(?levels[j], 1, row.name, len) != 0) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# a table is well formed: every name an identifier, every bit a single nonzero
# bit, no name or bit repeated, and every implied bit another row of the table
pub fun table_valid(table: *Extension, count: u32) bool {
    if (count > MAX_SELECTED) { ret false; }
    val all: u64 = domain(table, count);
    var i:   u32 = 0;
    for (i < count) {
        val row: *Extension = ?table[i];
        if (row.bit == 0 || (row.bit & (row.bit - 1)) != 0)            { ret false; }
        if (!is_name(row.name, str_len(row.name)))                     { ret false; }
        if ((row.implies & row.bit) != 0 || (row.implies & ~all) != 0) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (table[j].bit == row.bit)                                { ret false; }
            if (bit_of(?table[j], 1, row.name, str_len(row.name)) != 0) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# `name` appended to `b`, after a `, ` separator unless it is the first
fun name_append(b: *textbuild.TextBuilder, first: bool, name: str) err[textbuild.Error] {
    if (!first) {
        val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
        if (sel sep.err) { ret sep; }
    }
    ret textbuild.tb_append(b, name);
}

# the level table's spellings, `, `-separated, appended to `b`
pub fun levels_append(b: *textbuild.TextBuilder, levels: *Level, count: u32) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < count) {
        val r: err[textbuild.Error] = name_append(b, i == 0, levels[i].name);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the names of every row whose bit is in `bits`, `, `-separated, appended to `b`
#[testing]
pub fun bits_append(b: *textbuild.TextBuilder, table: *Extension, count: u32, bits: u64) err[textbuild.Error] {
    var first: bool = true;
    var i:     u32  = 0;
    for (i < count) {
        if ((table[i].bit & bits) != 0) {
            val r: err[textbuild.Error] = name_append(b, first, table[i].name);
            if (sel r.err) { ret r; }
            first = false;
        }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the table's names, `, `-separated, appended to `b`
pub fun names_append(b: *textbuild.TextBuilder, table: *Extension, count: u32) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < count) {
        val r: err[textbuild.Error] = name_append(b, i == 0, table[i].name);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the most vocabularies a description carries: one per registered instruction set
pub val VOCABULARY_CAP: u32 = 8;

# every extension vocabulary the registered instruction sets declare, each table
# once in registration order: what a name in `#[extensions(...)]` may mean beside
# the selected instruction set's own table
pub rec Vocabulary {
    tables: [VOCABULARY_CAP]*Extension;
    counts: [VOCABULARY_CAP]u32;
    len:    u32;
}

pub fun vocabulary_empty() Vocabulary {
    var v: Vocabulary;
    v.len = 0;
    ret v;
}

# `table` joins `v` unless it is empty or already there; false when `v` is full
pub fun vocabulary_add(v: *Vocabulary, table: *Extension, count: u32) bool {
    if (table == nil || count == 0) { ret true; }
    var i: u32 = 0;
    for (i < v.len) {
        if (v.tables[i] == table) { ret true; }
        i = i + 1;
    }
    if (v.len >= VOCABULARY_CAP) { ret false; }
    v.tables[v.len] = table;
    v.counts[v.len] = count;
    v.len           = v.len + 1;
    ret true;
}

# the names of every table of `v`, `, `-separated
pub fun vocabulary_append(b: *textbuild.TextBuilder, v: *Vocabulary) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < v.len) {
        if (textbuild.tb_len(b) > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val r: err[textbuild.Error] = names_append(b, v.tables[i], v.counts[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the text a test's builder holds, released; nil when it failed
#[testing]
fun t_spelled(b: *textbuild.TextBuilder, r: err[textbuild.Error]) str {
    if (sel r.err) {
        textbuild.tb_dnit(b);
        ret nil;
    }
    val done: res[str, textbuild.Error] = textbuild.tb_finish(b);
    textbuild.tb_dnit(b);
    if (sel done.err) { ret nil; }
    ret done.ok;
}

#[testing]
fun t_spelled_is(a: *A.Allocator, text: str, want: str) bool {
    if (text == nil) { ret false; }
    val same: bool = str_equals(text, want);
    str_free(a, text);
    ret same;
}

#[testing]
val T_TABLE: [3]Extension = [3]Extension{
    Extension{name: "ssse3", bit: 1, implies: 0, target_only: nil},
    Extension{name: "sse41", bit: 2, implies: 1, target_only: nil},
    Extension{name: "sha", bit: 4, implies: 2, target_only: nil},
};

test table__lookup_and_validity {
    if (bit_of(?T_TABLE[0], 3, "sse41", 5) != 2)  { ret 1; }
    if (bit_of(?T_TABLE[0], 3, "sse4", 4) != 0)   { ret 2; }
    if (bit_of(?T_TABLE[0], 3, "sha256", 3) != 4) { ret 3; }
    if (domain(?T_TABLE[0], 3) != 7)              { ret 4; }
    if (!table_valid(?T_TABLE[0], 3))             { ret 5; }
    val dup: [2]Extension = [2]Extension{Extension{name: "a", bit: 1, implies: 0, target_only: nil}, Extension{name: "a", bit: 2, implies: 0, target_only: nil}};
    if (table_valid(?dup[0], 2)) { ret 6; }
    val two: [1]Extension = [1]Extension{Extension{name: "a", bit: 3, implies: 0, target_only: nil}};
    if (table_valid(?two[0], 1)) { ret 7; }
    val dotted: [1]Extension = [1]Extension{Extension{name: "sse4.1", bit: 1, implies: 0, target_only: nil}};
    if (table_valid(?dotted[0], 1)) { ret 8; }
    val kw: [1]Extension = [1]Extension{Extension{name: "sel", bit: 1, implies: 0, target_only: nil}};
    if (table_valid(?kw[0], 1)) { ret 11; }
    val self_implied: [1]Extension = [1]Extension{Extension{name: "a", bit: 1, implies: 1, target_only: nil}};
    if (table_valid(?self_implied[0], 1)) { ret 12; }
    val stray: [1]Extension = [1]Extension{Extension{name: "a", bit: 1, implies: 8, target_only: nil}};
    if (table_valid(?stray[0], 1)) { ret 13; }
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 9; }
    var b: textbuild.TextBuilder = textbuild.tb_init(?a);
    if (!t_spelled_is(?a, t_spelled(?b, names_append(?b, ?T_TABLE[0], 3)), "ssse3, sse41, sha")) { ret 9; }
    if (!str_region_equals(first_name(?T_TABLE[0], 3, 6), 0, 5, "sse41"))                        { ret 10; }
    ret 0;
}

# a vocabulary is spelled whole however long it grows: no fixed buffer cuts it short
test names_append__spells_a_long_vocabulary_whole {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var rows: [160]Extension;
    var i:    u32 = 0;
    for (i < 160) {
        rows[i] = Extension{name: "extension", bit: 1, implies: 0, target_only: nil};
        i       = i + 1;
    }
    var b:       textbuild.TextBuilder = textbuild.tb_init(?a);
    val spelled: str                   = t_spelled(?b, names_append(?b, ?rows[0], 160));
    if (spelled == nil) { ret 2; }
    val n: usize = str_len(spelled);
    str_free(?a, spelled);
    if (n != 160 * 9 + 159 * 2) { ret 3; }
    ret 0;
}

# a vocabulary holds each table once in the order it first arrives, skips an
# empty one, refuses a table past its capacity and spells every table's names
test vocabulary__each_table_once_within_capacity {
    var v: Vocabulary = vocabulary_empty();
    if (!vocabulary_add(?v, nil, 3) || !vocabulary_add(?v, ?T_TABLE[0], 0) || v.len != 0) { ret 1; }
    if (!vocabulary_add(?v, ?T_TABLE[1], 2) || !vocabulary_add(?v, ?T_TABLE[0], 1))       { ret 2; }
    if (!vocabulary_add(?v, ?T_TABLE[1], 2) || v.len != 2)                                { ret 3; }
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 4; }
    var b: textbuild.TextBuilder = textbuild.tb_init(?a);
    if (!t_spelled_is(?a, t_spelled(?b, vocabulary_append(?b, ?v)), "sse41, sha, ssse3")) { ret 5; }
    var rows: [9]Extension;
    var full: Vocabulary = vocabulary_empty();
    var i:    u32        = 0;
    for (i < VOCABULARY_CAP) {
        rows[i] = Extension{name: "row", bit: 1, implies: 0, target_only: nil};
        if (!vocabulary_add(?full, ?rows[i], 1)) { ret 6; }
        i = i + 1;
    }
    rows[i] = Extension{name: "row", bit: 1, implies: 0, target_only: nil};
    if (vocabulary_add(?full, ?rows[i], 1) || full.len != VOCABULARY_CAP) { ret 7; }
    ret 0;
}

#[testing]
val T_LEVELS: [2]Level = [2]Level{
    Level{name: "t-v2", members: 3},
    Level{name: "t-v3", members: 7},
};

# a level is looked up by its own table, spelled with hyphens, and is valid
# only as a growing chain of the extension table's rows
test levels__spellings_over_the_rows {
    if (level_of(?T_LEVELS[0], 2, "t-v3", 4) != 7)                                                      { ret 1; }
    if (level_of(?T_LEVELS[0], 2, "t-v", 3) != 0)                                                       { ret 2; }
    if (level_of(?T_LEVELS[0], 2, "sse41", 5) != 0)                                                     { ret 3; }
    if (!levels_valid(?T_LEVELS[0], 2, ?T_TABLE[0], 3))                                                 { ret 4; }
    if (!levels_valid(nil, 0, ?T_TABLE[0], 3))                                                          { ret 5; }
    if (!is_level_spelling("x86-64-v2", 9) || !is_spelling("x86-64-v2", 9) || !is_spelling("sse41", 5)) { ret 6; }
    if (is_level_spelling("-v2", 3) || is_level_spelling("v2-", 3) || is_level_spelling("a--b", 4)
        || is_level_spelling("", 0) || is_level_spelling("sse4.1", 6) || is_name("x86-64-v2", 9)) { ret 7; }
    # a level named like a row, a member outside the domain, a shrinking or
    # repeated chain, an empty level and a repeated spelling are all refused
    val as_row: [1]Level = [1]Level{Level{name: "sse41", members: 3}};
    if (levels_valid(?as_row[0], 1, ?T_TABLE[0], 3)) { ret 8; }
    val stray: [1]Level = [1]Level{Level{name: "t-v2", members: 8}};
    if (levels_valid(?stray[0], 1, ?T_TABLE[0], 3)) { ret 9; }
    val shrink: [2]Level = [2]Level{Level{name: "t-v2", members: 7}, Level{name: "t-v3", members: 3}};
    if (levels_valid(?shrink[0], 2, ?T_TABLE[0], 3)) { ret 10; }
    val same: [2]Level = [2]Level{Level{name: "t-v2", members: 3}, Level{name: "t-v3", members: 3}};
    if (levels_valid(?same[0], 2, ?T_TABLE[0], 3)) { ret 11; }
    val empty: [1]Level = [1]Level{Level{name: "t-v2", members: 0}};
    if (levels_valid(?empty[0], 1, ?T_TABLE[0], 3)) { ret 12; }
    val twice: [2]Level = [2]Level{Level{name: "t-v2", members: 3}, Level{name: "t-v2", members: 7}};
    if (levels_valid(?twice[0], 2, ?T_TABLE[0], 3)) { ret 13; }
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 14; }
    var lb: textbuild.TextBuilder = textbuild.tb_init(?a);
    if (!t_spelled_is(?a, t_spelled(?lb, levels_append(?lb, ?T_LEVELS[0], 2)), "t-v2, t-v3")) { ret 14; }
    var bb: textbuild.TextBuilder = textbuild.tb_init(?a);
    if (!t_spelled_is(?a, t_spelled(?bb, bits_append(?bb, ?T_TABLE[0], 3, 5)), "ssse3, sha")) { ret 15; }
    ret 0;
}

# a selection closes over `implies` to a fixpoint: sha brings sse41 brings ssse3
test close__follows_implies_to_a_fixpoint {
    if (close(?T_TABLE[0], 3, 0) != 0)                                                         { ret 1; }
    if (close(?T_TABLE[0], 3, 1) != 1)                                                         { ret 2; }
    if (close(?T_TABLE[0], 3, 2) != 3)                                                         { ret 3; }
    if (close(?T_TABLE[0], 3, 4) != 7)                                                         { ret 4; }
    if (!admits(admitted(3, 0), 1) || !admits(admitted(0, 3), 1) || admits(admitted(1, 0), 2)) { ret 5; }
    ret 0;
}
