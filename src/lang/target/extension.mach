# the extension vocabulary of an instruction set
#
# an instruction set's extensions are masc's: its catalog names every extension
# and level and says what each implies, and mach states only which rows of it the
# code generator emits against and the selection bit each carries. every surface
# that spells an extension reads the catalog: the manifest's `[target.X].extensions`,
# `$mach.build.extensions.<name>`, `#[extensions(...)]` and the inline-asm refusals.
# a name is a key of the catalog's name index, an identifier, so it can be a comptime
# member and a field of a runtime feature record. a bit is the isa's own: the same bit
# means different things on different instruction sets, and only a name crosses
# between them. spir-v's vocabulary names vulkan device features, which no masc
# catalog states, so its table states its names itself until one does
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.view.View;

use masc_extension: masc.core.extension;
use masc.core.requirement;

use mach.lang.lexis;
use mach.lang.textbuild;

# one extension the code generator emits against
# ---
# handle:      its row of the table's masc catalog
# name:        in a table with no catalog, the name it is spelled by, nil otherwise
# bit:         the bit it carries in a selection
# implies:     in a table with no catalog, the bits it brings, 0 otherwise
# target_only: nil when a function may admit the extension alone with
#              `#[extensions]`; otherwise why only a target selects it
pub rec Extension {
    handle:      requirement.Id;
    name:        str;
    bit:         u64;
    implies:     u64;
    target_only: str;
}

# the extensions an instruction set's code generator emits against
# ---
# source:  where its names are read from, for a diagnostic
# catalog: masc's catalog of the instruction set's extensions, nil for a vocabulary
#          no masc catalog states
# rows:    the extensions, each a row of the catalog
# count:   how many
# float:   the bits a value of a floating-point width needs to be held in float
#          registers, nil when every selection holds them
pub rec Table {
    source:  str;
    catalog: *masc_extension.Catalog;
    rows:    *Extension;
    count:   u32;
    float:   FloatRequirementFn;
}

# the bits of a table a floating-point value of `bits` bits needs held
pub def FloatRequirementFn: fun(u32) u64;

# the bits a floating-point value of `bits` bits needs that `selected` lacks, 0
# when it lacks none
pub fun float_absent(t: *Table, bits: u32, selected: u64) u64 {
    if (t == nil || t.float == nil) { ret 0; }
    ret t.float(bits) & ~selected;
}

# the most rows a table holds: one per bit
pub val MAX_SELECTED: u32 = 64;

# the name of row `i` of `t`
pub fun row_name(t: *Table, i: u32) str {
    if (t.catalog != nil) { ret t.catalog.extensions[t.rows[i].handle].name; }
    ret t.rows[i].name;
}

# the bit `t` gives the catalog row `handle`, 0 when the code generator emits against none
fun bit_of_handle(t: *Table, handle: requirement.Id) u64 {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.rows[i].handle == handle) { ret t.rows[i].bit; }
        i = i + 1;
    }
    ret 0;
}

# the bits of the rows of `ids` the code generator emits against
fun bits_of_ids(t: *Table, ids: requirement.Ids) u64 {
    var out: u64 = 0;
    var i:   u32 = 0;
    for (i < ids.len) {
        out = out | bit_of_handle(t, ids.at[i]);
        i   = i + 1;
    }
    ret out;
}

# the catalog's name index entry for `name[0..len]`, none when the catalog has no such key
fun entry_of(t: *Table, name: str, len: usize) opt[*masc_extension.NameEntry] {
    if (t.catalog == nil || len == 0) { ret opt[*masc_extension.NameEntry].none{}; }
    ret masc_extension.entry(t.catalog, View{data: name, len: len}, false);
}

# the row of `t` the name `name[0..len]` names alone, nil when it names none of them
pub fun row_of(t: *Table, name: str, len: usize) *Extension {
    var i: u32 = 0;
    if (t.catalog == nil) {
        for (i < t.count) {
            if (str_len(t.rows[i].name) == len && str_region_equals(name, 0, len, t.rows[i].name)) { ret ?t.rows[i]; }
            i = i + 1;
        }
        ret nil;
    }
    val e: opt[*masc_extension.NameEntry] = entry_of(t, name, len);
    if (sel e.none) { ret nil; }
    val only: opt[requirement.Id] = masc_extension.only(t.catalog, e.some);
    if (sel only.none) { ret nil; }
    for (i < t.count) {
        if (t.rows[i].handle == only.some) { ret ?t.rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `name[0..len]` is a key of the table's catalog, or in a table with no catalog
# the name of a row
pub fun known(t: *Table, name: str, len: usize) bool {
    if (t.catalog != nil) {
        val e: opt[*masc_extension.NameEntry] = entry_of(t, name, len);
        ret sel e.some;
    }
    var i: u32 = 0;
    for (i < t.count) {
        if (str_len(t.rows[i].name) == len && str_region_equals(name, 0, len, t.rows[i].name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the bits `t` gives every extension `name[0..len]` names, as an edit of a selection
# by that name enables them, 0 when it names none the code generator emits against
# or names a level
pub fun bit_of(t: *Table, name: str, len: usize) u64 {
    if (t.catalog == nil) {
        var i: u32 = 0;
        for (i < t.count) {
            if (str_len(t.rows[i].name) == len && str_region_equals(name, 0, len, t.rows[i].name)) { ret t.rows[i].bit; }
            i = i + 1;
        }
        ret 0;
    }
    val e: opt[*masc_extension.NameEntry] = entry_of(t, name, len);
    if (sel e.none) { ret 0; }
    val rows: opt[requirement.Ids] = masc_extension.extensions_of(t.catalog, e.some);
    if (sel rows.none) { ret 0; }
    ret bits_of_ids(t, rows.some);
}

# the bits of the members of the level the catalog names `name[0..len]`, 0 when it
# names none
pub fun level_of(t: *Table, name: str, len: usize) u64 {
    val e: opt[*masc_extension.NameEntry] = entry_of(t, name, len);
    if (sel e.none) { ret 0; }
    val level: opt[*masc_extension.Level] = masc_extension.only_level(t.catalog, e.some);
    if (sel level.none) { ret 0; }
    ret bits_of_ids(t, level.some.members);
}

# the bits the catalog row `handle` brings, through every extension it implies, of the
# rows the code generator emits against. a catalog's implications are acyclic, so
# `depth` only bounds a malformed one
fun implied(t: *Table, handle: requirement.Id, depth: u32) u64 {
    if (depth > MAX_SELECTED || handle >= t.catalog.count) { ret 0; }
    val ids: requirement.Ids = t.catalog.extensions[handle].implies;
    var out: u64             = 0;
    var i:   u32             = 0;
    for (i < ids.len) {
        out = out | bit_of_handle(t, ids.at[i]) | implied(t, ids.at[i], depth + 1);
        i   = i + 1;
    }
    ret out;
}

# the bits row `i` brings with it
fun implies_of(t: *Table, i: u32) u64 {
    if (t.catalog == nil) { ret t.rows[i].implies; }
    ret implied(t, t.rows[i].handle, 0);
}

# `bits` closed over what each selected extension implies: every extension a selected
# one brings, to a fixpoint. a selection is closed once, at target resolution, so a
# level is a bundle of bits and never an axis of its own
pub fun close(t: *Table, bits: u64) u64 {
    var out: u64 = bits;
    for (true) {
        var next: u64 = out;
        var i:    u32 = 0;
        for (i < t.count) {
            if ((out & t.rows[i].bit) != 0) { next = next | implies_of(t, i); }
            i = i + 1;
        }
        if (next == out) { ret out; }
        out = next;
    }
    ret out;
}

# the extensions a body may emit: the target's selection and whatever its
# `#[extensions(...)]` admits beyond it. one predicate for the inliner and the
# encoder: an instruction needing `required` is emitted only into a body whose
# admitted set holds it
pub fun admitted(selected: u64, function: u64) u64 {
    ret selected | function;
}

pub fun admits(admitted_bits: u64, required: u64) bool {
    ret (required & ~admitted_bits) == 0;
}

# every bit the table names
pub fun domain(t: *Table) u64 {
    var mask: u64 = 0;
    var i:    u32 = 0;
    for (i < t.count) {
        mask = mask | t.rows[i].bit;
        i    = i + 1;
    }
    ret mask;
}

# the first name the table gives any bit of `bits`, nil when it names none
pub fun first_name(t: *Table, bits: u64) str {
    var i: u32 = 0;
    for (i < t.count) {
        if ((t.rows[i].bit & bits) != 0) { ret row_name(t, i); }
        i = i + 1;
    }
    ret nil;
}

# an extension name is spelled by the lexer's own rules: one identifier token,
# never a keyword, so every surface that names it parses it the same way
pub fun is_name(name: str, len: usize) bool {
    ret lexis.is_identifier(name, len) && !lexis.is_keyword(name, len);
}

# a level spelling is an identifier with `-` admitted inside it (`x86-64-v2`),
# so a manifest can carry a level where it carries a name and the resolver
# tells them apart by table, never by shape
fun is_level_spelling(name: str, len: usize) bool {
    if (len == 0 || !lexis.is_ident_start(name[0]::u8)) { ret false; }
    var i: usize = 1;
    for (i < len) {
        val c: u8 = name[i]::u8;
        if (c == '-') {
            if (i + 1 >= len || name[i + 1] == '-') { ret false; }
        }
        or (!lexis.is_ident_char(c)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# what a manifest's `extensions` entry may spell: a name or a level
pub fun is_spelling(name: str, len: usize) bool {
    ret is_name(name, len) || is_level_spelling(name, len);
}

# a table is well formed: every bit a single nonzero bit, no bit or row repeated, every
# row of its catalog and named by an identifier, and in a table with no catalog every
# implied bit another row of the table
pub fun table_valid(t: *Table) bool {
    if (t.count > MAX_SELECTED)       { ret false; }
    if (t.count > 0 && t.rows == nil) { ret false; }
    val all: u64 = domain(t);
    var i:   u32 = 0;
    for (i < t.count) {
        val row: *Extension = ?t.rows[i];
        if (row.bit == 0 || (row.bit & (row.bit - 1)) != 0)    { ret false; }
        if (t.catalog != nil && row.handle >= t.catalog.count) { ret false; }
        val name: str = row_name(t, i);
        if (!is_name(name, str_len(name)))                                                   { ret false; }
        if (t.catalog == nil && ((row.implies & row.bit) != 0 || (row.implies & ~all) != 0)) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (t.rows[j].bit == row.bit)                           { ret false; }
            if (t.catalog != nil && t.rows[j].handle == row.handle) { ret false; }
            if (str_equals(row_name(t, j), name))                   { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# `name` appended to `b`, after a `, ` separator unless it is the first
fun name_append(b: *textbuild.TextBuilder, first: bool, name: str) err[textbuild.Error] {
    if (!first) {
        val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
        if (sel sep.err) { ret sep; }
    }
    ret textbuild.tb_append(b, name);
}

# the catalog's levels whose members the code generator emits against any of,
# `, `-separated, appended to `b`
pub fun levels_append(b: *textbuild.TextBuilder, t: *Table) err[textbuild.Error] {
    if (t.catalog == nil) { ret err[textbuild.Error].ok{}; }
    var first: bool = true;
    var i:     u32  = 0;
    for (i < t.catalog.level_count) {
        val level: *masc_extension.Level = ?t.catalog.levels[i];
        if (bits_of_ids(t, level.members) != 0) {
            val r: err[textbuild.Error] = name_append(b, first, level.name);
            if (sel r.err) { ret r; }
            first = false;
        }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the names of every row whose bit is in `bits`, `, `-separated, appended to `b`
pub fun bits_append(b: *textbuild.TextBuilder, t: *Table, bits: u64) err[textbuild.Error] {
    var first: bool = true;
    var i:     u32  = 0;
    for (i < t.count) {
        if ((t.rows[i].bit & bits) != 0) {
            val r: err[textbuild.Error] = name_append(b, first, row_name(t, i));
            if (sel r.err) { ret r; }
            first = false;
        }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the table's names, `, `-separated, appended to `b`
pub fun names_append(b: *textbuild.TextBuilder, t: *Table) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < t.count) {
        val r: err[textbuild.Error] = name_append(b, i == 0, row_name(t, i));
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the most vocabularies a description carries: one per registered instruction set
pub val VOCABULARY_CAP: u32 = 8;

# every extension vocabulary the registered instruction sets declare, each table
# once in registration order: what a name in `#[extensions(...)]` may mean beside
# the selected instruction set's own table
pub rec Vocabulary {
    tables: [VOCABULARY_CAP]*Table;
    len:    u32;
}

pub fun vocabulary_empty() Vocabulary {
    var v: Vocabulary;
    v.len = 0;
    ret v;
}

# `t` joins `v` unless it is empty or already there; false when `v` is full
pub fun vocabulary_add(v: *Vocabulary, t: *Table) bool {
    if (t == nil || t.count == 0) { ret true; }
    var i: u32 = 0;
    for (i < v.len) {
        if (v.tables[i] == t) { ret true; }
        i = i + 1;
    }
    if (v.len >= VOCABULARY_CAP) { ret false; }
    v.tables[v.len] = t;
    v.len           = v.len + 1;
    ret true;
}

# where the names of every table of `v` are read from, `, `-separated
pub fun sources_append(b: *textbuild.TextBuilder, v: *Vocabulary) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < v.len) {
        val r: err[textbuild.Error] = name_append(b, i == 0, v.tables[i].source);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

# the names of every table of `v`, `, `-separated
pub fun vocabulary_append(b: *textbuild.TextBuilder, v: *Vocabulary) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < v.len) {
        if (textbuild.tb_len(b) > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val r: err[textbuild.Error] = names_append(b, v.tables[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}
