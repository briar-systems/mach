# the operation and type tables an instruction set declares for `#[op]`
# intrinsics and target handle types, as plain data
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
pub val NO_OP_SET: u32 = 0;
pub val NO_OPCODE: u32 = 0xFFFFFFFF;

# how one operand of an `#[op]` instruction is written: an ordinary value id, an
# id that must be an integer constant by emission, a literal word inline, a
# pointer whose storage class the call site's access chain decides, which the
# instruction only reads through, only stores through, or reads and writes, a
# handle value whose memory the instruction reads or writes (a handle passed as
# an ordinary value names its descriptor and touches none of its memory), or a
# truth value the target writes as its boolean type, from an integer argument
# whose nonzero is true. a memory scope or a memory semantics operand is a
# constant id too, one the target reads by value and holds to what that value
# needs under its memory model
pub def OpOperandKind: u8;

pub val OP_OPERAND_VALUE:          OpOperandKind = 0;
pub val OP_OPERAND_CONSTANT:       OpOperandKind = 1;
pub val OP_OPERAND_LITERAL:        OpOperandKind = 2;
val     OP_OPERAND_POINTER_READ:   OpOperandKind = 3;
pub val OP_OPERAND_POINTER_WRITE:  OpOperandKind = 4;
pub val OP_OPERAND_POINTER_UPDATE: OpOperandKind = 5;
pub val OP_OPERAND_HANDLE_READ:    OpOperandKind = 6;
pub val OP_OPERAND_HANDLE_WRITE:   OpOperandKind = 7;
pub val OP_OPERAND_BOOL:           OpOperandKind = 8;
pub val OP_OPERAND_SCOPE:          OpOperandKind = 9;
pub val OP_OPERAND_SEMANTICS:      OpOperandKind = 10;
val     OP_OPERAND_KIND_COUNT:     OpOperandKind = 11;

# whether an `#[op]` instruction has a result id, and whether that result is a
# pointer into the space the row declares, or a truth value of the target's boolean
# type, which the declaration's integer return type receives as 1 or 0
pub def OpResult: u8;

pub val OP_RESULT_VALUE:   OpResult = 0;
pub val OP_RESULT_NONE:    OpResult = 1;
pub val OP_RESULT_POINTER: OpResult = 2;
pub val OP_RESULT_BOOL:    OpResult = 3;

pub val OP_MAX_OPERANDS: u32 = 16;

pub val NO_OP_SPACE: u32 = 0xFFFFFFFF;

pub val NO_OP_CAPABILITY: u32 = 0xFFFFFFFF;

pub val NO_OP_SOURCE: u32 = 0xFFFFFFFF;

# one value a literal operand may take and what that value brings: the target's
# own capability word it needs (NO_OP_CAPABILITY for none), the extensions of the
# isa's vocabulary that capability needs selected, and the operands it adds to the end
# of the instruction, one letter each as `op_def_shaped` spells them (`""` for none).
# what a value brings is never a pointer or a handle: a row's memory effects are known
# before a call's literal is
pub rec OpEnumerant {
    value:      u32;
    name:       str;
    capability: u32;
    requires:   u64;
    operands:   str;
}

# the closed set of values a literal operand takes. a value enumeration admits
# exactly one of its values. a mask admits any union of its single-bit values,
# each set bit bringing its own requirement and operands, which follow in
# ascending bit order, and 0 is the empty mask
pub rec OpEnum {
    name:   str;
    values: *OpEnumerant;
    count:  u32;
    mask:   bool;
}

# the class of the data type a typed row operates on, a vector's element when the typing
# admits vectors: an integer, a float, or anything else (an aggregate, a handle), which no
# requirement admits
pub def OpDataClass: u8;

pub val OP_DATA_INT:   OpDataClass = 0;
pub val OP_DATA_FLOAT: OpDataClass = 1;
pub val OP_DATA_OTHER: OpDataClass = 2;

# one data type a typed row admits in one of the target's address spaces (NO_OP_SPACE
# for every space), and what a use of it there needs: the target's capability word
# (NO_OP_CAPABILITY for none) and the extensions of the isa's vocabulary
pub rec OpTypeRequirement {
    class:      OpDataClass;
    bits:       u32;
    space:      u32;
    capability: u32;
    requires:   u64;
}

# the data types a row operates on, read from its operand `operand` (a pointer's
# pointee), and what each needs in each address space. a type no requirement admits in
# any space is refused at the declaration, and one admitted only in other spaces at the
# call. a typing with no requirements admits every type and needs nothing: it only names
# the operand the row's relations are stated against. static data the target owns for
# the life of the program, like an OpEnum
pub rec OpTyping {
    name:    str;
    operand: u32;
    entries: *OpTypeRequirement;
    count:   u32;
    # the class of number the data type must be a scalar of, or a vector of when `vectors`,
    # whatever its requirements admit, OP_NUMERIC_NONE for any type
    numeric: OpNumeric;
    # whether a typing that holds the data type to a class of number or to requirements
    # admits a vector, held to them by its element type. one that does not refuses every
    # vector, as an atomic's scalar pointee
    vectors: bool;
}

# the numbers a typed row's data type is a scalar or vector of: any type at all, integers or
# floats, floats only, integers of either signedness, or integers of one signedness. a truth
# value is an unsigned integer
def OpNumeric: u8;

pub val OP_NUMERIC_NONE:     OpNumeric = 0;
pub val OP_NUMERIC_ANY:      OpNumeric = 1;
pub val OP_NUMERIC_FLOAT:    OpNumeric = 2;
pub val OP_NUMERIC_SIGNED:   OpNumeric = 3;
pub val OP_NUMERIC_UNSIGNED: OpNumeric = 4;
pub val OP_NUMERIC_INTEGER:  OpNumeric = 5;
val     OP_NUMERIC_COUNT:    OpNumeric = 6;

# whether a scalar of `class`, signed when `signed`, is a number `n` admits
pub fun op_numeric_admits(n: OpNumeric, class: OpDataClass, signed: bool) bool {
    if (n == OP_NUMERIC_NONE)     { ret true; }
    if (n == OP_NUMERIC_ANY)      { ret class == OP_DATA_INT || class == OP_DATA_FLOAT; }
    if (n == OP_NUMERIC_FLOAT)    { ret class == OP_DATA_FLOAT; }
    if (n == OP_NUMERIC_SIGNED)   { ret class == OP_DATA_INT && signed; }
    if (n == OP_NUMERIC_UNSIGNED) { ret class == OP_DATA_INT && !signed; }
    if (n == OP_NUMERIC_INTEGER)  { ret class == OP_DATA_INT; }
    ret false;
}

# the numbers `n` admits, as a refusal names them
pub fun op_numeric_name(n: OpNumeric) str {
    if (n == OP_NUMERIC_FLOAT)    { ret "floats"; }
    if (n == OP_NUMERIC_SIGNED)   { ret "signed integers"; }
    if (n == OP_NUMERIC_UNSIGNED) { ret "unsigned integers"; }
    if (n == OP_NUMERIC_INTEGER)  { ret "integers"; }
    ret "integers or floats";
}

# how an operand's or the result's type relates to the row's data type, the type of its
# typing's operand (a pointer operand's pointee): unrelated, that same type, a texel, a
# scalar or vector whose component is the sampled type of the handle the typing's operand
# is, with as many components as the row's texel count states, for a pointer result
# only, a pointer to that sampled type, into the memory of the handle the typing's pointer
# operand addresses, or, for a value result only, a handle whose constructor composes over
# the handle the typing's operand is, taking its texels from it as a sampled image does
# from its image. an operand may also be a sampler, a handle whose constructor states how
# texels are sampled, whatever the data type, or shaped like the data type: a scalar or
# vector of the scalar the row fixes for it, with as many components as the data type has.
# a pointer operand's relation holds its pointee, the type the instruction stores or reads
# through it
pub def OpRelation: u8;

pub val OP_RELATION_NONE:     OpRelation = 0;
pub val OP_RELATION_DATA:     OpRelation = 1;
pub val OP_RELATION_TEXEL:    OpRelation = 2;
pub val OP_RELATION_POINTEE:  OpRelation = 3;
pub val OP_RELATION_COMPOSED: OpRelation = 4;
pub val OP_RELATION_SAMPLER:  OpRelation = 5;
pub val OP_RELATION_SHAPED:   OpRelation = 6;
val     OP_RELATION_COUNT:    OpRelation = 7;

# how a row's texel count is stated: exactly a number of components, or at least as many
# as the handle's format stores, any number when its format is unknown
def OpCountKind: u8;

pub val OP_COUNT_EXACT:      OpCountKind = 0;
pub val OP_COUNT_FORMAT:     OpCountKind = 1;
val     OP_COUNT_KIND_COUNT: OpCountKind = 2;

# the number of components a row's texel has, a scalar being one: `components` exactly,
# or as `kind` says. `rule` names the rule a refusal cites. static data the target owns
# for the life of the program, like an OpTyping
pub rec OpTexelCount {
    rule:       str;
    kind:       OpCountKind;
    components: u32;
}

# a scalar data type by class, width and signedness, such as a handle's sampled type
pub rec OpScalar {
    class:  OpDataClass;
    bits:   u32;
    signed: bool;
}

# the one scalar type an operand must be whatever the row's data type, such as the 32-bit
# float reference a depth comparison takes. `rule` names the rule a refusal cites. static
# data the target owns for the life of the program, like an OpTexelCount
pub rec OpOperandScalar {
    rule:   str;
    scalar: OpScalar;
}

pub rec Op {
    set:     str;
    name:    str;
    set_tag: u32;
    opcode:  u32;
    # the most operands a call passes: the ones the row spells, then the most its
    # enumerated literals' values bring
    arity: u32;
    # the fewest: an enumerated literal that leads the tail is optional, absent with
    # every operand its value would bring
    min_arity: u32;
    # the operands the row spells itself. past them are the operands a call's literal
    # values bring, typed by the enumerant that brings each
    spelled: u32;
    result:  OpResult;
    # the target's own address-space word a pointer result points into, else NO_OP_SPACE
    result_space: u32;
    kinds:        [OP_MAX_OPERANDS]OpOperandKind;
    # the target's own capability word every use of the row needs, else NO_OP_CAPABILITY
    capability: u32;
    # the extensions of the isa's vocabulary every use of the row needs selected
    requires: u64;
    # the enumeration each literal operand's value must belong to, nil when any word is accepted.
    # static data the target owns for the life of the program, so the registry keeps the pointer
    enums: [OP_MAX_OPERANDS]*OpEnum;
    # what the data type the row operates on needs, nil when the row is not typed
    typing: *OpTyping;
    # how each operand's type and the result's relate to the data type, against the
    # operand the typing names
    relations:       [OP_MAX_OPERANDS]OpRelation;
    result_relation: OpRelation;
    # how many components the texel an operand or the result relates as has, nil when
    # the row relates no texel
    texel_count: *OpTexelCount;
    # the scalar type each operand must be, nil for an operand whose type the row fixes
    # only by its kind and relations
    scalars: [OP_MAX_OPERANDS]*OpOperandScalar;
    # whether the result may be consumed only as an operand of another `#[op]` instruction
    # in the block that produces it: never returned, passed to a function, or merged where
    # control flow joins
    confined: bool;
    # the operand a pointer or handle result derives from, what the result points into or
    # holds, else NO_OP_SOURCE, a result of no origin
    source: u32;
}

pub val TYPE_OPERAND_WORD: u32 = 0xFFFFFFFF;

pub val NO_TYPE_CTOR: u32 = 0xFFFFFFFF;

def TypeRefuseFn: fun(*u32, u32) str;

# the descriptor role a handle binds through, from its operands
def TypeBindFn: fun(*u32, u32) u32;

# why a composing constructor refuses the handle named as its operand `index`, from
# that handle's own operands, nil when it composes over it
def TypeComposeFn: fun(u32, *u32, u32) str;

# the scalar a handle's texels are read and written as, from its operands, class
# OP_DATA_OTHER when it has none
def TypeSampledFn: fun(*u32, u32) OpScalar;

# the number of components a handle's format stores each texel in, from its operands, 0
# when its format is unknown
def TypeComponentsFn: fun(*u32, u32) u32;

# a constructor whose handles state their own texels, or have none
pub val NO_TEXEL_OPERAND: u32 = 0xFFFFFFFF;

# why no instruction may derive a pointer into a handle's memory, from its operands, nil
# when one may
def TypeAddressFn: fun(*u32, u32) str;

# a handle bound as a sampled descriptor, `#[sampler(set, binding)]`
pub val HANDLE_BIND_SAMPLER: u32 = 0;
# a handle bound as a storage descriptor, `#[storage(set, binding, ...)]`
pub val HANDLE_BIND_STORAGE: u32 = 1;

pub rec Type {
    name:     str;
    tag:      u32;
    operands: *u32;
    arity:    u32;
    refuse:   TypeRefuseFn;
    # nil binds every handle of the constructor as a sampler
    bind: TypeBindFn;
    # nil composes over any handle of the constructor the operand names
    compose: TypeComposeFn;
    # nil when the constructor's handles have no texels
    sampled: TypeSampledFn;
    # nil when the constructor's handles have no format
    components: TypeComponentsFn;
    # the type operand naming the handle whose texels these handles have, as a sampled
    # image has its image's, else NO_TEXEL_OPERAND
    texels_of: u32;
    # nil when no instruction addresses the constructor's memory
    address: TypeAddressFn;
    # whether the constructor's handles state how an image's texels are sampled, as a
    # sampler does, with no texels or memory of their own
    samples: bool;
}

pub rec Table {
    ops:        *Op;
    op_count:   u32;
    types:      *Type;
    type_count: u32;
}

# a row whose every operand is a value and whose result is a value
pub fun op(set: str, name: str, set_tag: u32, opcode: u32, arity: u32) Op {
    var d: Op;
    d.set             = set;
    d.name            = name;
    d.set_tag         = set_tag;
    d.opcode          = opcode;
    d.arity           = arity;
    d.min_arity       = arity;
    d.spelled         = arity;
    d.result          = OP_RESULT_VALUE;
    d.result_space    = NO_OP_SPACE;
    d.capability      = NO_OP_CAPABILITY;
    d.requires        = 0;
    d.typing          = nil;
    d.result_relation = OP_RELATION_NONE;
    d.texel_count     = nil;
    d.confined        = false;
    d.source          = NO_OP_SOURCE;
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        d.kinds[i]     = OP_OPERAND_VALUE;
        d.enums[i]     = nil;
        d.relations[i] = OP_RELATION_NONE;
        d.scalars[i]   = nil;
        i              = i + 1;
    }
    ret d;
}

# a row spelled by its operand signature, one letter per operand in order: `v` a
# value, `c` a constant id, `l` a literal word, `r` a pointer only read through, `w`
# a pointer only stored through, `u` a pointer read and written (read-modify-write),
# `i` a handle whose memory is read, `o` a handle whose memory is written, `b` a
# truth value, `s` a memory scope and `m` a memory semantics, each a constant id.
# a row spells only its own operands: the ones an enumerated literal's value brings
# follow them, typed by the enumerant (`op_enumerated`). a `|` makes the literal after
# it optional (`"iv|l"`), a call passing it or leaving it out with every operand its
# value would bring, and nothing else follows it.
# a letter outside the set is an invalid kind, which registration refuses
pub fun op_shaped(set: str, name: str, set_tag: u32, opcode: u32,
    result: OpResult, result_space: u32, signature: str) Op {
    val n: usize = str_len(signature);
    var d: Op    = op(set, name, set_tag, opcode, 0);
    d.result       = result;
    d.result_space = result_space;
    var tail: bool  = false;
    var k:    u32   = 0;
    var i:    usize = 0;
    for (i < n) {
        if (signature[i] == '|' && !tail) {
            tail        = true;
            d.min_arity = k;
        }
        or {
            if (k < OP_MAX_OPERANDS) { d.kinds[k] = op_kind_of_letter(signature[i]); }
            k = k + 1;
        }
        i = i + 1;
    }
    d.arity   = k;
    d.spelled = k;
    if (!tail) { d.min_arity = k; }
    ret d;
}

# `d` needing the target's capability word `capability` and the extensions `requires` on every use
pub fun op_requiring(d: Op, capability: u32, requires: u64) Op {
    var out: Op = d;
    out.capability = capability;
    out.requires   = requires;
    ret out;
}

# `d` with its literal operand `operand` held to the values of `e`, and room after the
# operands it spells for the most every enumerated literal's value brings
pub fun op_enumerated(d: Op, operand: u32, e: *OpEnum) Op {
    var out: Op = d;
    if (operand < OP_MAX_OPERANDS) { out.enums[operand] = e; }
    out.arity = out.spelled;
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        if (out.enums[i] != nil) { out.arity = out.arity + op_enum_most_brought(out.enums[i]); }
        i = i + 1;
    }
    ret out;
}

# `d` operating on the data types `t` admits, each with its own requirement
pub fun op_typed(d: Op, t: *OpTyping) Op {
    var out: Op = d;
    out.typing = t;
    ret out;
}

# `d` with its result's type related to its data type by `result`, and each operand's by
# one letter of `operands` in order: `-` unrelated, `=` the data type itself, `t` a texel
# of the handle the typing's operand is, `s` a sampler, `n` shaped like the data type in the
# scalar `op_scalar_operand` fixes. a letter outside the set is an invalid relation,
# which registration refuses
pub fun op_related(d: Op, result: OpRelation, operands: str) Op {
    var out: Op = d;
    out.result_relation = result;
    val n: usize = str_len(operands);
    var i: usize = 0;
    for (i < n && i < OP_MAX_OPERANDS::usize) {
        out.relations[i] = op_relation_of_letter(operands[i]);
        i                = i + 1;
    }
    ret out;
}

fun op_relation_of_letter(c: char) OpRelation {
    if (c == '-') { ret OP_RELATION_NONE; }
    if (c == '=') { ret OP_RELATION_DATA; }
    if (c == 't') { ret OP_RELATION_TEXEL; }
    if (c == 'p') { ret OP_RELATION_POINTEE; }
    if (c == 's') { ret OP_RELATION_SAMPLER; }
    if (c == 'n') { ret OP_RELATION_SHAPED; }
    ret OP_RELATION_COUNT;
}

# `d` with its result consumed only by another row's operand in the block that produces it
pub fun op_confined(d: Op) Op {
    var out: Op = d;
    out.confined = true;
    ret out;
}

# `d` with its pointer or handle result derived from its operand `operand`: a pointer
# result points into what that pointer operand addresses, a handle result holds the
# descriptor that operand holds
pub fun op_derived(d: Op, operand: u32) Op {
    var out: Op = d;
    out.source = operand;
    ret out;
}

# the reason a row's source is malformed, nil when it is well formed: the source is an
# operand every call passes, a pointer result's a pointer and a value result's one that can
# hold a handle, a handle operand or a value passing one as its descriptor
fun op_source_refusal(d: *Op) str {
    if (d.source == NO_OP_SOURCE) { ret nil; }
    if (d.source >= d.min_arity)  { ret "mach.lang.target.isa: operation definition derives its result from an operand it does not always take"; }
    val kind: OpOperandKind = d.kinds[d.source];
    if (d.result == OP_RESULT_POINTER) {
        if (!op_kind_is_pointer(kind)) { ret "mach.lang.target.isa: operation definition derives its pointer result from an operand that is not a pointer"; }
        ret nil;
    }
    if (d.result != OP_RESULT_VALUE) { ret "mach.lang.target.isa: operation definition derives a result that is neither a pointer nor a handle"; }
    if (kind != OP_OPERAND_VALUE && !op_kind_is_handle(kind)) {
        ret "mach.lang.target.isa: operation definition derives its handle result from an operand that is not a handle";
    }
    ret nil;
}

# `d` with its operand `operand` held to the one scalar type `s` states
pub fun op_scalar_operand(d: Op, operand: u32, s: *OpOperandScalar) Op {
    var out: Op = d;
    if (operand < OP_MAX_OPERANDS) { out.scalars[operand] = s; }
    ret out;
}

# the scalar type operand `i` of `d` must be, nil when the row fixes none
pub fun op_operand_scalar(d: *Op, i: u32) *OpOperandScalar {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret nil; }
    ret d.scalars[i];
}

# the reason a row's fixed scalar operands are malformed, nil when they are well formed:
# each is an operand the row spells, of a number type, under a named rule, and either a
# value related to nothing or the component of an operand shaped like the data type, which
# needs its scalar
fun op_scalar_refusal(d: *Op) str {
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        val s:      *OpOperandScalar = d.scalars[i];
        val shaped: bool             = d.relations[i] == OP_RELATION_SHAPED;
        if (s == nil && shaped) { ret "mach.lang.target.isa: operation definition shapes an operand like its data type without fixing its component scalar"; }
        if (s != nil) {
            if (i >= d.spelled)                                { ret "mach.lang.target.isa: operation definition fixes the type of an operand it does not spell"; }
            if (!shaped && d.kinds[i] != OP_OPERAND_VALUE)     { ret "mach.lang.target.isa: operation definition fixes the type of an operand that is not a value"; }
            if (!shaped && d.relations[i] != OP_RELATION_NONE) { ret "mach.lang.target.isa: operation definition both relates and fixes the type of an operand"; }
            if (s.scalar.class == OP_DATA_OTHER)               { ret "mach.lang.target.isa: operation definition fixes an operand to a type that is not a number"; }
            if (s.rule == nil)                                 { ret "mach.lang.target.isa: operation definition fixes the type of an operand under no named rule"; }
        }
        i = i + 1;
    }
    ret nil;
}

# `d` with the texel it relates holding `count` components
pub fun op_texel_counted(d: Op, count: *OpTexelCount) Op {
    var out: Op = d;
    out.texel_count = count;
    ret out;
}

# whether `n` components meet `count`, against a handle whose format stores `stored`, 0
# when its format is unknown
pub fun op_texel_count_admits(count: *OpTexelCount, n: u32, stored: u32) bool {
    if (count.kind == OP_COUNT_EXACT) { ret n == count.components; }
    ret n >= stored;
}

pub fun op_operand_relation(d: *Op, i: u32) OpRelation {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret OP_RELATION_NONE; }
    ret d.relations[i];
}

# whether `t` holds the row's data type to requirements, rather than only naming its operand
pub fun op_typing_constrains(t: *OpTyping) bool {
    ret t != nil && t.count > 0;
}

# the requirement of `t` admitting a `class` of `bits` in `space`, nil when none does.
# `space` NO_OP_SPACE asks whether any space admits the type
pub fun op_type_requirement(t: *OpTyping, class: OpDataClass, bits: u32, space: u32) *OpTypeRequirement {
    if (t == nil || class == OP_DATA_OTHER) { ret nil; }
    var i: u32 = 0;
    for (i < t.count) {
        val r: *OpTypeRequirement = ?t.entries[i];
        if (r.class == class && r.bits == bits
            && (space == NO_OP_SPACE || r.space == NO_OP_SPACE || r.space == space)) { ret r; }
        i = i + 1;
    }
    ret nil;
}

pub fun op_operand_enum(d: *Op, i: u32) *OpEnum {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret nil; }
    ret d.enums[i];
}

# the enumeration of the optional literal that leads `d`'s tail, nil when the tail has none
pub fun op_tail_literal(d: *Op) *OpEnum {
    if (d == nil || d.min_arity >= d.arity) { ret nil; }
    ret op_operand_enum(d, d.min_arity);
}

# how many operands the enumerant `v` brings
pub fun op_enumerant_brings(v: *OpEnumerant) u32 {
    if (v == nil || v.operands == nil) { ret 0; }
    ret str_len(v.operands)::u32;
}

# the kind of the `k`th operand the enumerant `v` brings
fun op_enumerant_kind(v: *OpEnumerant, k: u32) OpOperandKind {
    if (k >= op_enumerant_brings(v)) { ret OP_OPERAND_KIND_COUNT; }
    ret op_kind_of_letter(v.operands[k::usize]);
}

# the most operands a value of `e` brings: a value's own, or every bit of a mask at once
fun op_enum_most_brought(e: *OpEnum) u32 {
    if (e == nil || e.values == nil) { ret 0; }
    var most: u32 = 0;
    var k:    u32 = 0;
    for (k < e.count) {
        val n: u32 = op_enumerant_brings(?e.values[k]);
        if (e.mask)   { most = most + n; }
        or (n > most) { most = n; }
        k = k + 1;
    }
    ret most;
}

# the enumerant of `e` whose value is exactly `value`, nil when none is
pub fun op_enumerant_of(e: *OpEnum, value: u32) *OpEnumerant {
    var i: u32 = 0;
    for (i < e.count) {
        if (e.values[i].value == value) { ret ?e.values[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether `value` is a value of `e`: one of its values, or for a mask a union of its
# bits. `out_trailing` receives the tail operands the value brings
fun op_enum_admits(e: *OpEnum, value: u32, out_trailing: *u32) bool {
    @out_trailing = 0;
    if (!e.mask) {
        val one: *OpEnumerant = op_enumerant_of(e, value);
        if (one == nil) { ret false; }
        @out_trailing = op_enumerant_brings(one);
        ret true;
    }
    var trailing: u32 = 0;
    var bit:      u32 = 1;
    var rest:     u32 = value;
    for (rest != 0) {
        if ((rest & bit) != 0) {
            val one: *OpEnumerant = op_enumerant_of(e, bit);
            if (one == nil) { ret false; }
            trailing = trailing + op_enumerant_brings(one);
            rest     = rest & ~bit;
        }
        bit = bit << 1;
    }
    @out_trailing = trailing;
    ret true;
}

pub val NO_OPERAND: u32 = 0xFFFFFFFF;

# how many of a call's leading operands are enumerated-literal positions it passes: the
# required operands, and the literal leading the tail when the call passes more than them
pub fun op_literal_span(d: *Op, argc: u32) u32 {
    if (op_tail_literal(d) != nil && argc > d.min_arity) { ret d.min_arity + 1; }
    ret d.min_arity;
}

# the operand count a call of `d` takes with the literal words `words` it passes:
# the operands before its tail, the literal leading the tail when the call passes one,
# and every operand an enumerated value brings. `out_bad` receives the first
# enumerated operand whose word is no value of its enumeration, else NO_OPERAND
pub fun op_call_arity(d: *Op, argc: u32, words: *u32, out_bad: *u32) u32 {
    @out_bad = NO_OPERAND;
    val span:  u32 = op_literal_span(d, argc);
    var count: u32 = span;
    var i:     u32 = 0;
    for (i < span) {
        val e: *OpEnum = op_operand_enum(d, i);
        if (e != nil) {
            var brings: u32 = 0;
            if (!op_enum_admits(e, words[i], ?brings)) {
                @out_bad = i;
                ret count;
            }
            count = count + brings;
        }
        i = i + 1;
    }
    ret count;
}

# the kind of each operand of a call of `d` passing `argc` operands with the literal
# words `words`, into `out` (OP_MAX_OPERANDS long): the operands the row spells by the
# row, then each operand a literal's value brings by the enumerant that brings it, in
# the order of the literals and of each mask's bits. a call `op_call_arity` refuses
# has the kinds of the operands it does take, and the rest are values
pub fun op_call_kinds(d: *Op, argc: u32, words: *u32, out: *OpOperandKind) {
    val span: u32 = op_literal_span(d, argc);
    var i:    u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        out[i] = OP_OPERAND_VALUE;
        if (i < span) { out[i] = d.kinds[i]; }
        i = i + 1;
    }
    var at: u32 = span;
    i = 0;
    for (i < span) {
        val e: *OpEnum = op_operand_enum(d, i);
        if (e != nil) {
            if (!e.mask) { at = op_place_kinds(op_enumerant_of(e, words[i]), at, out); }
            or {
                var bit: u32 = 1;
                for (bit != 0 && bit <= words[i]) {
                    if ((words[i] & bit) != 0) { at = op_place_kinds(op_enumerant_of(e, bit), at, out); }
                    bit = bit << 1;
                }
            }
        }
        i = i + 1;
    }
}

# the kinds of the operands `v` brings into `out` from `at`, and where the next begin
fun op_place_kinds(v: *OpEnumerant, at: u32, out: *OpOperandKind) u32 {
    val n:    u32 = op_enumerant_brings(v);
    var next: u32 = at;
    var k:    u32 = 0;
    for (k < n) {
        if (next < OP_MAX_OPERANDS) { out[next] = op_enumerant_kind(v, k); }
        next = next + 1;
        k    = k + 1;
    }
    ret next;
}

fun op_kind_of_letter(c: char) OpOperandKind {
    if (c == 'v') { ret OP_OPERAND_VALUE; }
    if (c == 'c') { ret OP_OPERAND_CONSTANT; }
    if (c == 'l') { ret OP_OPERAND_LITERAL; }
    if (c == 'r') { ret OP_OPERAND_POINTER_READ; }
    if (c == 'w') { ret OP_OPERAND_POINTER_WRITE; }
    if (c == 'u') { ret OP_OPERAND_POINTER_UPDATE; }
    if (c == 'i') { ret OP_OPERAND_HANDLE_READ; }
    if (c == 'o') { ret OP_OPERAND_HANDLE_WRITE; }
    if (c == 'b') { ret OP_OPERAND_BOOL; }
    if (c == 's') { ret OP_OPERAND_SCOPE; }
    if (c == 'm') { ret OP_OPERAND_SEMANTICS; }
    ret OP_OPERAND_KIND_COUNT;
}

# the kind of operand `i` as the row spells it. an operand a literal's value brings is
# typed by its enumerant (`op_call_kinds`), and is never a pointer or a handle, so it
# reads here as a value
pub fun op_operand_kind(d: *Op, i: u32) OpOperandKind {
    if (d == nil || i >= d.arity || i >= OP_MAX_OPERANDS) { ret OP_OPERAND_VALUE; }
    ret d.kinds[i];
}

pub fun op_kind_is_pointer(k: OpOperandKind) bool {
    ret k == OP_OPERAND_POINTER_READ || k == OP_OPERAND_POINTER_WRITE || k == OP_OPERAND_POINTER_UPDATE;
}

# an id that must be an integer constant by emission, whatever the target reads its value as
pub fun op_kind_is_constant(k: OpOperandKind) bool {
    ret k == OP_OPERAND_CONSTANT || k == OP_OPERAND_SCOPE || k == OP_OPERAND_SEMANTICS;
}

pub fun op_kind_is_handle(k: OpOperandKind) bool {
    ret k == OP_OPERAND_HANDLE_READ || k == OP_OPERAND_HANDLE_WRITE;
}

# the reason a row's shape is malformed, nil when it is well formed
pub fun op_shape_refusal(d: *Op) str {
    if (d.arity > OP_MAX_OPERANDS) { ret "mach.lang.target.isa: operation definition declares more operands than a row carries"; }
    if (d.result != OP_RESULT_VALUE && d.result != OP_RESULT_NONE && d.result != OP_RESULT_POINTER
        && d.result != OP_RESULT_BOOL) {
        ret "mach.lang.target.isa: operation definition declares an unknown result shape";
    }
    if ((d.result == OP_RESULT_POINTER) != (d.result_space != NO_OP_SPACE)) {
        ret "mach.lang.target.isa: operation definition declares a pointer result without its space, or a space without a pointer result";
    }
    if (d.min_arity > d.arity) { ret "mach.lang.target.isa: operation definition admits fewer operands than it requires"; }
    if (d.typing != nil) {
        if (d.typing.operand >= d.min_arity)                    { ret "mach.lang.target.isa: operation definition reads its data type from an operand it does not always take"; }
        if ((d.typing.count == 0) != (d.typing.entries == nil)) { ret "mach.lang.target.isa: operation definition names a typing whose count and data types disagree"; }
        if (d.typing.numeric >= OP_NUMERIC_COUNT)               { ret "mach.lang.target.isa: operation definition names a typing of an unknown class of number"; }
    }
    if (d.confined && d.result != OP_RESULT_VALUE) { ret "mach.lang.target.isa: operation definition confines a result that is not a value"; }
    val why: str = op_relation_refusal(d);
    if (why != nil) { ret why; }
    val why_scalar: str = op_scalar_refusal(d);
    if (why_scalar != nil) { ret why_scalar; }
    val why_source: str = op_source_refusal(d);
    if (why_source != nil)                              { ret why_source; }
    if (d.spelled > d.arity || d.min_arity > d.spelled) { ret "mach.lang.target.isa: operation definition spells more operands than it admits"; }
    val leads:      bool = op_tail_literal(d) != nil;
    var enumerated: u32  = 0;
    var brought:    u32  = 0;
    var i:          u32  = 0;
    for (i < OP_MAX_OPERANDS) {
        if (i < d.spelled && d.kinds[i] >= OP_OPERAND_KIND_COUNT) { ret "mach.lang.target.isa: operation definition declares an unknown operand kind"; }
        val e: *OpEnum = d.enums[i];
        if (e != nil) {
            if (i >= d.spelled)                   { ret "mach.lang.target.isa: operation definition enumerates an operand it does not spell"; }
            if (d.kinds[i] != OP_OPERAND_LITERAL) { ret "mach.lang.target.isa: operation definition enumerates an operand that is not a literal"; }
            if (e.count == 0 || e.values == nil)  { ret "mach.lang.target.isa: operation definition names an enumeration with no values"; }
            var k: u32 = 0;
            for (k < e.count) {
                val v: *OpEnumerant = ?e.values[k];
                if (e.mask && (v.value == 0 || (v.value & (v.value - 1)) != 0)) {
                    ret "mach.lang.target.isa: a mask enumeration names a value that is not a single bit";
                }
                var o: u32 = 0;
                for (o < op_enumerant_brings(v)) {
                    val kind: OpOperandKind = op_enumerant_kind(v, o);
                    if (kind >= OP_OPERAND_KIND_COUNT) { ret "mach.lang.target.isa: an enumerant brings an operand of an unknown kind"; }
                    if (op_kind_is_pointer(kind) || op_kind_is_handle(kind)) {
                        ret "mach.lang.target.isa: an enumerant brings a pointer or a handle: a row's memory effects are read from the operands it spells, before a call's literal is known";
                    }
                    o = o + 1;
                }
                k = k + 1;
            }
            brought    = brought + op_enum_most_brought(e);
            enumerated = enumerated + 1;
        }
        i = i + 1;
    }
    # the instruction holds what the row spells and every operand its literals bring at once
    if (d.spelled + brought > OP_MAX_OPERANDS || d.arity != d.spelled + brought) {
        ret "mach.lang.target.isa: the operands a row spells and the most its enumerated literals bring are more than a row carries";
    }
    if (leads && enumerated > 1) {
        ret "mach.lang.target.isa: operation definition's tail leads with an optional literal and names another enumerated literal: one literal decides the tail";
    }
    # an optional tail is the literal that decides it, and what that literal's value brings
    if (d.min_arity < d.spelled && !leads) {
        ret "mach.lang.target.isa: operation definition has an optional tail and no enumerated literal leading it to decide it";
    }
    if (d.min_arity < d.spelled && d.spelled != d.min_arity + 1) {
        ret "mach.lang.target.isa: operation definition spells operands after the literal leading its optional tail: what follows that literal is what its value brings";
    }
    ret nil;
}

# the reason a row's relations are malformed, nil when they are well formed: each relates a
# value operand, a pointer operand's pointee or a value result to the operand its typing
# names, the data relation to a value or a pointer's pointee and the texel relation to a handle
fun op_relation_refusal(d: *Op) str {
    var related: bool = d.result_relation != OP_RELATION_NONE;
    if (d.result_relation >= OP_RELATION_COUNT) { ret "mach.lang.target.isa: operation definition declares an unknown result relation"; }
    val pointee: bool = d.result_relation == OP_RELATION_POINTEE;
    if (pointee && d.result != OP_RESULT_POINTER)           { ret "mach.lang.target.isa: operation definition relates a pointee of a result that is not a pointer"; }
    if (d.result_relation == OP_RELATION_SAMPLER)           { ret "mach.lang.target.isa: operation definition relates its result as a sampler, which only an operand is"; }
    if (d.result_relation == OP_RELATION_SHAPED)            { ret "mach.lang.target.isa: operation definition shapes its result like its data type, which only an operand whose scalar the row fixes is"; }
    if (related && !pointee && d.result != OP_RESULT_VALUE) { ret "mach.lang.target.isa: operation definition relates a result that is not a value"; }
    var i: u32 = 0;
    for (i < OP_MAX_OPERANDS) {
        val r: OpRelation = d.relations[i];
        if (r >= OP_RELATION_COUNT)    { ret "mach.lang.target.isa: operation definition declares an unknown operand relation"; }
        if (r == OP_RELATION_POINTEE)  { ret "mach.lang.target.isa: operation definition relates a pointee of an operand, which only a pointer result takes"; }
        if (r == OP_RELATION_COMPOSED) { ret "mach.lang.target.isa: operation definition relates a composed handle to an operand, which only a result takes"; }
        if (r != OP_RELATION_NONE) {
            # a pointer operand relates the type stored or read through it, as data or shaped like it
            val through: bool = op_kind_is_pointer(d.kinds[i]) && (r == OP_RELATION_DATA || r == OP_RELATION_SHAPED);
            if (i >= d.spelled)                             { ret "mach.lang.target.isa: operation definition relates an operand it does not spell"; }
            if (d.kinds[i] != OP_OPERAND_VALUE && !through) { ret "mach.lang.target.isa: operation definition relates an operand that is neither a value nor the pointee of a pointer"; }
            if (d.typing != nil && d.typing.operand == i)   { ret "mach.lang.target.isa: operation definition relates its data operand to itself"; }
            related = true;
        }
        i = i + 1;
    }
    if (!related) {
        if (d.texel_count != nil) { ret "mach.lang.target.isa: operation definition counts the components of a texel it does not relate"; }
        ret nil;
    }
    if (d.typing == nil) { ret "mach.lang.target.isa: operation definition states relations without a typing naming the operand they relate to"; }
    val handle: bool = op_kind_is_handle(d.kinds[d.typing.operand]);
    var texel:  bool = false;
    i = 0;
    for (i <= OP_MAX_OPERANDS) {
        var r: OpRelation = d.result_relation;
        if (i < OP_MAX_OPERANDS)                                          { r = d.relations[i]; }
        if ((r == OP_RELATION_DATA || r == OP_RELATION_SHAPED) && handle) { ret "mach.lang.target.isa: operation definition relates a type to a handle's own type"; }
        if (r == OP_RELATION_TEXEL && !handle)                            { ret "mach.lang.target.isa: operation definition relates a texel to an operand that is not a handle"; }
        if (r == OP_RELATION_TEXEL)                                       { texel = true; }
        if (r == OP_RELATION_POINTEE && !op_kind_is_pointer(d.kinds[d.typing.operand])) {
            ret "mach.lang.target.isa: operation definition relates a pointee to an operand that addresses no handle";
        }
        if (r == OP_RELATION_COMPOSED && d.kinds[d.typing.operand] != OP_OPERAND_VALUE) {
            ret "mach.lang.target.isa: operation definition composes its result over an operand that is not a handle passed as a value";
        }
        i = i + 1;
    }
    ret op_texel_count_refusal(d.texel_count, texel);
}

# the reason a row's texel count is malformed: every texel a row relates states its count,
# a count belongs to a row relating a texel, and an exact count names at least one component
fun op_texel_count_refusal(c: *OpTexelCount, texel: bool) str {
    if (c == nil) {
        if (texel) { ret "mach.lang.target.isa: operation definition relates a texel without stating its component count"; }
        ret nil;
    }
    if (!texel)                                        { ret "mach.lang.target.isa: operation definition counts the components of a texel it does not relate"; }
    if (c.kind >= OP_COUNT_KIND_COUNT)                 { ret "mach.lang.target.isa: operation definition counts a texel's components by an unknown kind"; }
    if (c.kind == OP_COUNT_EXACT && c.components == 0) { ret "mach.lang.target.isa: operation definition counts a texel of no components"; }
    if (c.rule == nil)                                 { ret "mach.lang.target.isa: operation definition counts a texel's components under no named rule"; }
    ret nil;
}

pub fun op_by_code(defs: *Table, set_tag: u32, opcode: u32) *Op {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        if (defs.ops[i].set_tag == set_tag && defs.ops[i].opcode == opcode) { ret ?defs.ops[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun type(name: str, tag: u32, operands: *u32, arity: u32, refuse: TypeRefuseFn) Type {
    var d: Type;
    d.name       = name;
    d.tag        = tag;
    d.operands   = operands;
    d.arity      = arity;
    d.refuse     = refuse;
    d.bind       = nil;
    d.compose    = nil;
    d.sampled    = nil;
    d.components = nil;
    d.texels_of  = NO_TEXEL_OPERAND;
    d.address    = nil;
    d.samples    = false;
    ret d;
}

# the role a handle of constructor `td` with operands `ops` binds through
pub fun type_binding(td: *Type, ops: *u32, n: u32) u32 {
    if (td == nil || td.bind == nil) { ret HANDLE_BIND_SAMPLER; }
    ret td.bind(ops, n);
}

# the scalar texels of a handle of constructor `td` with operands `ops` are, class
# OP_DATA_OTHER when the constructor declares none
pub fun type_sampled(td: *Type, ops: *u32, n: u32) OpScalar {
    if (td == nil || td.sampled == nil) { ret OpScalar{class: OP_DATA_OTHER, bits: 0, signed: false}; }
    ret td.sampled(ops, n);
}

# the number of components a handle of constructor `td` with operands `ops` stores each
# texel in, 0 when its format is unknown or the constructor declares none
pub fun type_components(td: *Type, ops: *u32, n: u32) u32 {
    if (td == nil || td.components == nil) { ret 0; }
    ret td.components(ops, n);
}

# why no instruction may derive a pointer into a handle of constructor `td` with operands
# `ops`, nil when one may
pub fun type_address(td: *Type, ops: *u32, n: u32) str {
    if (td == nil || td.address == nil) { ret "no instruction addresses this handle's memory: a pointer derived from it names nothing the target lays out"; }
    ret td.address(ops, n);
}

pub fun table(ops: *Op, op_count: u32, types: *Type, type_count: u32) Table {
    var t: Table;
    t.ops        = ops;
    t.op_count   = op_count;
    t.types      = types;
    t.type_count = type_count;
    ret t;
}

pub fun type_of_region(defs: *Table, src: str, off: usize, len: usize) *Type {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.type_count) {
        val d: *Type = ?defs.types[i];
        if (str_region_equals(src, off, len, d.name)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

pub fun type_by_tag(defs: *Table, tag: u32) *Type {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.type_count) {
        if (defs.types[i].tag == tag) { ret ?defs.types[i]; }
        i = i + 1;
    }
    ret nil;
}

#[testing]
pub fun op_of(defs: *Table, set_name: str, op_name: str) *Op {
    ret op_of_region(defs, set_name, 0::usize, str_len(set_name),
        op_name, 0::usize, str_len(op_name));
}

pub fun op_of_region(defs: *Table, set_src: str, set_off: usize, set_len: usize,
    nam_src: str, nam_off: usize, nam_len: usize) *Op {
    if (defs == nil) { ret nil; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        val d: *Op = ?defs.ops[i];
        if (str_region_equals(set_src, set_off, set_len, d.set)
            && str_region_equals(nam_src, nam_off, nam_len, d.name)) { ret d; }
        i = i + 1;
    }
    ret nil;
}

pub fun op_set_exists_region(defs: *Table, src: str, off: usize, len: usize) bool {
    if (defs == nil) { ret false; }
    var i: u32 = 0;
    for (i < defs.op_count) {
        if (str_region_equals(src, off, len, defs.ops[i].set)) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
pub fun op_set_exists(defs: *Table, name: str) bool {
    ret op_set_exists_region(defs, name, 0::usize, str_len(name));
}

# a `|` makes the literal after it optional, and a literal's value brings operands after
# the ones the row spells: one value of a value enumeration, any union of a mask's bits
test op_shaped__tail_and_enumerants {
    val d: Op = op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "cv|l");
    if (d.arity != 3 || d.min_arity != 2 || d.spelled != 3)                               { ret 1; }
    if (d.kinds[0] != OP_OPERAND_CONSTANT || d.kinds[2] != OP_OPERAND_LITERAL)            { ret 1; }
    if (op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vv").min_arity != 2) { ret 2; }
    val t: Op = op_shaped("core", "op", 1, 2, OP_RESULT_BOOL, NO_OP_SPACE, "cb");
    if (t.kinds[1] != OP_OPERAND_BOOL || op_shape_refusal(?t) != nil) { ret 9; }
    # a memory scope and a memory semantics are constant ids, a literal is not
    val sm: Op = op_shaped("core", "op", 1, 2, OP_RESULT_NONE, NO_OP_SPACE, "csm");
    if (sm.kinds[1] != OP_OPERAND_SCOPE || sm.kinds[2] != OP_OPERAND_SEMANTICS || op_shape_refusal(?sm) != nil)      { ret 10; }
    if (!op_kind_is_constant(sm.kinds[0]) || !op_kind_is_constant(sm.kinds[1]) || !op_kind_is_constant(sm.kinds[2])) { ret 10; }
    if (op_kind_is_constant(OP_OPERAND_LITERAL))                                                                     { ret 10; }

    var values: [3]OpEnumerant = [3]OpEnumerant{
        OpEnumerant{value: 1, name: "one", capability: NO_OP_CAPABILITY, requires: 0, operands: "c"},
        OpEnumerant{value: 2, name: "two", capability: NO_OP_CAPABILITY, requires: 0, operands: ""},
        OpEnumerant{value: 4, name: "four", capability: NO_OP_CAPABILITY, requires: 0, operands: "vv"},
    };
    var e:        OpEnum = OpEnum{name: "e", values: ?values[0], count: 3, mask: false};
    var trailing: u32    = 9;
    if (!op_enum_admits(?e, 4, ?trailing) || trailing != 2) { ret 3; }
    if (op_enum_admits(?e, 5, ?trailing))                   { ret 4; }
    e.mask = true;
    if (!op_enum_admits(?e, 5, ?trailing) || trailing != 3) { ret 5; }
    if (!op_enum_admits(?e, 0, ?trailing) || trailing != 0) { ret 6; }
    if (op_enum_admits(?e, 9, ?trailing))                   { ret 7; }
    # a required literal's value brings its operands after the row's own: room for a value
    # enumeration's most, or for every bit of a mask at once
    e.mask = false;
    val r: Op = op_enumerated(op_requiring(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "clv"), 63, 0x4), 1, ?e);
    if (r.capability != 63 || r.requires != 0x4 || op_operand_enum(?r, 1) != ?e || op_operand_enum(?r, 0) != nil) { ret 8; }
    if (r.min_arity != 3 || r.spelled != 3 || r.arity != 5 || op_shape_refusal(?r) != nil)                        { ret 8; }
    e.mask = true;
    val m: Op = op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "clv"), 1, ?e);
    if (m.arity != 6 || op_enumerated(m, 1, ?e).arity != 6) { ret 10; }
    # an enumerant bringing a pointer, a handle or an unknown kind is refused
    values[1].operands = "r";
    if (op_shape_refusal(?m) == nil) { ret 11; }
    values[1].operands = "i";
    if (op_shape_refusal(?m) == nil) { ret 12; }
    values[1].operands = "x";
    if (op_shape_refusal(?m) == nil) { ret 13; }
    ret 0;
}

# a relation ties a value operand or a value result to the operand the typing names: the
# data relation to a value or a pointee, the texel relation to a handle, and the pointee
# relation a pointer result to the handle a pointer operand addresses
test op_related__relations_are_stated_against_the_typing_operand {
    var entries: [1]OpTypeRequirement = [1]OpTypeRequirement{
        OpTypeRequirement{class: OP_DATA_INT, bits: 32, space: NO_OP_SPACE, capability: NO_OP_CAPABILITY, requires: 0},
    };
    var on_pointer: OpTyping = OpTyping{name: "p", operand: 0, entries: ?entries[0], count: 1, numeric: OP_NUMERIC_NONE};
    var on_value:   OpTyping = OpTyping{name: "v", operand: 0, entries: nil, count: 0, numeric: OP_NUMERIC_NONE};
    val atomic:     Op       = op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "uccv"), ?on_pointer);
    val ok:         Op       = op_related(atomic, OP_RELATION_DATA, "---=");
    if (op_shape_refusal(?ok) != nil || op_operand_relation(?ok, 3) != OP_RELATION_DATA) { ret 1; }
    if (!op_typing_constrains(?on_pointer) || op_typing_constrains(?on_value))           { ret 1; }
    if (op_shape_refusal(?atomic) != nil)                                                { ret 1; }
    # a constant, the data operand itself, an unknown letter and an untyped row are refused
    val on_constant: Op = op_related(atomic, OP_RELATION_NONE, "-=");
    if (op_shape_refusal(?on_constant) == nil) { ret 2; }
    val on_self: Op = op_related(atomic, OP_RELATION_NONE, "=");
    if (op_shape_refusal(?on_self) == nil) { ret 3; }
    val unknown: Op = op_related(atomic, OP_RELATION_NONE, "---x");
    if (op_shape_refusal(?unknown) == nil) { ret 4; }
    val untyped: Op = op_related(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vv"), OP_RELATION_DATA, "");
    if (op_shape_refusal(?untyped) == nil) { ret 5; }
    # a texel relates only to a handle, and a handle's own type to nothing
    var four:  OpTexelCount = OpTexelCount{rule: "four", kind: OP_COUNT_EXACT, components: 4};
    val image: Op           = op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_NONE, NO_OP_SPACE, "ovv"), ?on_value);
    val write: Op           = op_texel_counted(op_related(image, OP_RELATION_NONE, "--t"), ?four);
    if (op_shape_refusal(?write) != nil) { ret 6; }
    # a texel states its count, and a count needs a texel, a kind and a component
    val uncounted: Op = op_related(image, OP_RELATION_NONE, "--t");
    if (op_shape_refusal(?uncounted) == nil) { ret 10; }
    val stray: Op = op_texel_counted(atomic, ?four);
    if (op_shape_refusal(?stray) == nil) { ret 11; }
    var none_: OpTexelCount = OpTexelCount{rule: "none", kind: OP_COUNT_EXACT, components: 0};
    val empty: Op           = op_texel_counted(op_related(image, OP_RELATION_NONE, "--t"), ?none_);
    if (op_shape_refusal(?empty) == nil) { ret 12; }
    var odd:           OpTexelCount = OpTexelCount{rule: "odd", kind: OP_COUNT_KIND_COUNT, components: 1};
    val unknown_count: Op           = op_texel_counted(op_related(image, OP_RELATION_NONE, "--t"), ?odd);
    if (op_shape_refusal(?unknown_count) == nil) { ret 13; }
    # an exact count admits only its own, and a format count at least the format's, any when unknown
    var stored: OpTexelCount = OpTexelCount{rule: "stored", kind: OP_COUNT_FORMAT, components: 0};
    if (!op_texel_count_admits(?four, 4, 1) || op_texel_count_admits(?four, 1, 0))      { ret 14; }
    if (!op_texel_count_admits(?stored, 2, 2) || op_texel_count_admits(?stored, 1, 2))  { ret 14; }
    if (!op_texel_count_admits(?stored, 1, 0) || !op_texel_count_admits(?stored, 4, 1)) { ret 14; }
    val equal: Op = op_related(image, OP_RELATION_NONE, "--=");
    if (op_shape_refusal(?equal) == nil) { ret 7; }
    val texel: Op = op_related(ok, OP_RELATION_TEXEL, "");
    if (op_shape_refusal(?texel) == nil) { ret 8; }
    # a result relation needs a value result
    val none: Op = op_related(image, OP_RELATION_TEXEL, "");
    if (op_shape_refusal(?none) == nil) { ret 9; }
    # a pointee relation is a pointer result's, into what the typing's pointer operand addresses
    val texel_ptr: Op = op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_POINTER, 11, "rvv"), ?on_value);
    val addressed: Op = op_related(texel_ptr, OP_RELATION_POINTEE, "");
    if (op_shape_refusal(?addressed) != nil) { ret 10; }
    val of_value: Op = op_related(ok, OP_RELATION_POINTEE, "");
    if (op_shape_refusal(?of_value) == nil) { ret 11; }
    val on_operand: Op = op_related(texel_ptr, OP_RELATION_NONE, "--p");
    if (op_shape_refusal(?on_operand) == nil) { ret 12; }
    # a composed handle is a value result's, over a handle the typing's operand passes as a
    # value, and only a value result is confined
    val combine:  Op = op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vv"), ?on_value);
    val composed: Op = op_confined(op_related(combine, OP_RELATION_COMPOSED, ""));
    if (op_shape_refusal(?composed) != nil || !composed.confined) { ret 13; }
    val through_memory: Op = op_related(op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv"), ?on_value), OP_RELATION_COMPOSED, "");
    if (op_shape_refusal(?through_memory) == nil) { ret 14; }
    val composed_ptr: Op = op_related(texel_ptr, OP_RELATION_COMPOSED, "");
    if (op_shape_refusal(?composed_ptr) == nil) { ret 15; }
    var on_operand_composed: Op = combine;
    on_operand_composed.relations[1] = OP_RELATION_COMPOSED;
    if (op_shape_refusal(?on_operand_composed) == nil) { ret 16; }
    val confined_none: Op = op_confined(image);
    if (op_shape_refusal(?confined_none) == nil) { ret 17; }
    # a sampler is an operand's relation, of a handle passed as a value
    val sampled: Op = op_related(combine, OP_RELATION_COMPOSED, "-s");
    if (op_shape_refusal(?sampled) != nil || op_operand_relation(?sampled, 1) != OP_RELATION_SAMPLER) { ret 18; }
    val sampler_result: Op = op_related(combine, OP_RELATION_SAMPLER, "");
    if (op_shape_refusal(?sampler_result) == nil) { ret 19; }
    val sampler_read: Op = op_related(op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vi"), ?on_value), OP_RELATION_NONE, "-s");
    if (op_shape_refusal(?sampler_read) == nil) { ret 20; }
    # an out-pointer relates the type stored through it: the data type, or one shaped like
    # it in the scalar the row fixes, which a shaped operand needs and a result never is
    var i32_:  OpOperandScalar = OpOperandScalar{rule: "an integer", scalar: OpScalar{class: OP_DATA_INT, bits: 32, signed: true}};
    val split: Op              = op_typed(op_shaped("ext", "op", 2, 3, OP_RESULT_VALUE, NO_OP_SPACE, "vw"), ?on_value);
    val whole: Op              = op_related(split, OP_RELATION_DATA, "-=");
    if (op_shape_refusal(?whole) != nil || op_operand_relation(?whole, 1) != OP_RELATION_DATA) { ret 21; }
    val exponent: Op = op_scalar_operand(op_related(split, OP_RELATION_DATA, "-n"), 1, ?i32_);
    if (op_shape_refusal(?exponent) != nil || op_operand_relation(?exponent, 1) != OP_RELATION_SHAPED) { ret 22; }
    val unscaled: Op = op_related(split, OP_RELATION_DATA, "-n");
    if (op_shape_refusal(?unscaled) == nil) { ret 23; }
    val shaped_result: Op = op_related(split, OP_RELATION_SHAPED, "");
    if (op_shape_refusal(?shaped_result) == nil) { ret 24; }
    val texel_out: Op = op_texel_counted(op_related(split, OP_RELATION_DATA, "-t"), ?four);
    if (op_shape_refusal(?texel_out) == nil) { ret 25; }
    ret 0;
}

# a typing states the class of number its data type is: floats admit only floats, integers
# any integer, and the signed classes only integers of their signedness
test op_numeric__a_typing_states_its_class_of_number {
    if (!op_numeric_admits(OP_NUMERIC_FLOAT, OP_DATA_FLOAT, true) || op_numeric_admits(OP_NUMERIC_FLOAT, OP_DATA_INT, true))        { ret 1; }
    if (!op_numeric_admits(OP_NUMERIC_SIGNED, OP_DATA_INT, true) || op_numeric_admits(OP_NUMERIC_SIGNED, OP_DATA_INT, false))       { ret 2; }
    if (!op_numeric_admits(OP_NUMERIC_UNSIGNED, OP_DATA_INT, false) || op_numeric_admits(OP_NUMERIC_UNSIGNED, OP_DATA_INT, true))   { ret 3; }
    if (op_numeric_admits(OP_NUMERIC_SIGNED, OP_DATA_FLOAT, true) || op_numeric_admits(OP_NUMERIC_ANY, OP_DATA_OTHER, false))       { ret 4; }
    if (!op_numeric_admits(OP_NUMERIC_ANY, OP_DATA_INT, false) || !op_numeric_admits(OP_NUMERIC_NONE, OP_DATA_OTHER, false))        { ret 5; }
    if (!op_numeric_admits(OP_NUMERIC_INTEGER, OP_DATA_INT, true) || !op_numeric_admits(OP_NUMERIC_INTEGER, OP_DATA_INT, false))    { ret 7; }
    if (op_numeric_admits(OP_NUMERIC_INTEGER, OP_DATA_FLOAT, true) || !str_equals(op_numeric_name(OP_NUMERIC_INTEGER), "integers")) { ret 8; }
    var bad:   OpTyping = OpTyping{name: "x", operand: 0, entries: nil, count: 0, numeric: OP_NUMERIC_COUNT};
    val wrong: Op       = op_typed(op("ext", "op", 2, 3, 1), ?bad);
    if (op_shape_refusal(?wrong) == nil) { ret 6; }
    ret 0;
}

# a fixed scalar operand is a value the row spells and relates to nothing, of a number type
# under a named rule
test op_scalar_operand__fixes_a_spelled_unrelated_value {
    var on_value: OpTyping        = OpTyping{name: "v", operand: 0, entries: nil, count: 0};
    var f32_:     OpOperandScalar = OpOperandScalar{rule: "a float", scalar: OpScalar{class: OP_DATA_FLOAT, bits: 32, signed: true}};
    val sample:   Op              = op_typed(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "ivvc"), ?on_value);
    val ok:       Op              = op_scalar_operand(sample, 2, ?f32_);
    if (op_shape_refusal(?ok) != nil || op_operand_scalar(?ok, 2) != ?f32_ || op_operand_scalar(?ok, 1) != nil) { ret 1; }
    val unspelled: Op = op_scalar_operand(sample, 4, ?f32_);
    if (op_shape_refusal(?unspelled) == nil) { ret 2; }
    val constant: Op = op_scalar_operand(sample, 3, ?f32_);
    if (op_shape_refusal(?constant) == nil) { ret 3; }
    val related: Op = op_scalar_operand(op_related(sample, OP_RELATION_NONE, "--="), 2, ?f32_);
    if (op_shape_refusal(?related) == nil) { ret 4; }
    var other:  OpOperandScalar = OpOperandScalar{rule: "other", scalar: OpScalar{class: OP_DATA_OTHER, bits: 0, signed: false}};
    val opaque: Op              = op_scalar_operand(sample, 2, ?other);
    if (op_shape_refusal(?opaque) == nil) { ret 5; }
    var unruled: OpOperandScalar = OpOperandScalar{rule: nil, scalar: f32_.scalar};
    val bare:    Op              = op_scalar_operand(sample, 2, ?unruled);
    if (op_shape_refusal(?bare) == nil) { ret 6; }
    ret 0;
}

# a pointer result derives from a pointer operand and a handle result from an operand that
# can hold a handle, one every call passes, and a row naming no source has no origin
test op_derived__a_source_is_a_pointer_or_a_handle {
    val texel: Op = op_shaped("core", "op", 1, 2, OP_RESULT_POINTER, 11, "rvv");
    val pair:  Op = op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "vv");
    if (texel.source != NO_OP_SOURCE || op_shape_refusal(?texel) != nil) { ret 1; }
    val into: Op = op_derived(texel, 0);
    val held: Op = op_derived(pair, 1);
    if (op_shape_refusal(?into) != nil || op_shape_refusal(?held) != nil) { ret 2; }
    val image: Op = op_derived(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv"), 0);
    if (op_shape_refusal(?image) != nil) { ret 3; }
    # a pointer result of a value operand, a handle of a constant, a source of no result
    # and one the call may leave out are refused
    val of_value: Op = op_derived(texel, 1);
    if (op_shape_refusal(?of_value) == nil) { ret 4; }
    val of_constant: Op = op_derived(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "cv"), 0);
    if (op_shape_refusal(?of_constant) == nil) { ret 5; }
    val no_result: Op = op_derived(op_shaped("core", "op", 1, 2, OP_RESULT_NONE, NO_OP_SPACE, "ov"), 0);
    if (op_shape_refusal(?no_result) == nil) { ret 6; }
    val beyond: Op = op_derived(texel, 3);
    if (op_shape_refusal(?beyond) == nil) { ret 7; }
    ret 0;
}

# a mask leading the tail is optional: a call leaves it out with every operand it would
# bring, or passes it followed by the operands of each set bit in ascending bit order,
# each typed by the bit that brings it
test op_call_arity__optional_mask_leads_the_tail {
    var values: [3]OpEnumerant = [3]OpEnumerant{
        OpEnumerant{value: 0x2, name: "low", capability: NO_OP_CAPABILITY, requires: 0, operands: "v"},
        OpEnumerant{value: 0x8, name: "mid", capability: NO_OP_CAPABILITY, requires: 0, operands: "c"},
        OpEnumerant{value: 0x40, name: "high", capability: NO_OP_CAPABILITY, requires: 0, operands: "lv"},
    };
    var e: OpEnum = OpEnum{name: "mask", values: ?values[0], count: 3, mask: true};
    val d: Op     = op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv|l"), 2, ?e);
    if (op_shape_refusal(?d) != nil || op_tail_literal(?d) != ?e) { ret 1; }
    if (d.min_arity != 2 || d.spelled != 3 || d.arity != 7)       { ret 1; }
    var words: [7]u32;
    var kinds: [OP_MAX_OPERANDS]OpOperandKind;
    var bad:   u32 = 0;
    # absent: the call passes the required operands alone, and no literal word is read
    words[2] = 0xDEAD;
    if (op_literal_span(?d, 2) != 2 || op_call_arity(?d, 2, ?words[0], ?bad) != 2 || bad != NO_OPERAND) { ret 2; }
    # an empty mask brings nothing
    words[2] = 0;
    if (op_call_arity(?d, 3, ?words[0], ?bad) != 3 || bad != NO_OPERAND) { ret 3; }
    # one bit, then all three: each bit's operands in bit order, typed by the bit
    words[2] = 0x40;
    if (op_call_arity(?d, 5, ?words[0], ?bad) != 5 || bad != NO_OPERAND) { ret 4; }
    op_call_kinds(?d, 5, ?words[0], ?kinds[0]);
    if (kinds[0] != OP_OPERAND_HANDLE_READ || kinds[2] != OP_OPERAND_LITERAL || kinds[3] != OP_OPERAND_LITERAL || kinds[4] != OP_OPERAND_VALUE) { ret 5; }
    words[2] = 0x4A;
    if (op_call_arity(?d, 7, ?words[0], ?bad) != 7 || bad != NO_OPERAND) { ret 6; }
    op_call_kinds(?d, 7, ?words[0], ?kinds[0]);
    if (kinds[3] != OP_OPERAND_VALUE || kinds[4] != OP_OPERAND_CONSTANT || kinds[5] != OP_OPERAND_LITERAL || kinds[6] != OP_OPERAND_VALUE) { ret 6; }
    # a bit the mask does not define is refused at the literal
    words[2] = 0x4;
    op_call_arity(?d, 3, ?words[0], ?bad);
    if (bad != 2) { ret 7; }
    # nothing is spelled after a leading literal, and no other literal is enumerated beside it
    val spelled: Op = op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv|lv"), 2, ?e);
    if (op_shape_refusal(?spelled) == nil) { ret 8; }
    val deep: Op = op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "iv|vl"), 3, ?e);
    if (op_shape_refusal(?deep) == nil) { ret 9; }
    var one: [1]OpEnumerant = [1]OpEnumerant{OpEnumerant{value: 1, name: "one", capability: NO_OP_CAPABILITY, requires: 0, operands: ""}};
    var v:   OpEnum         = OpEnum{name: "v", values: ?one[0], count: 1, mask: false};
    val two: Op             = op_enumerated(op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "lv|l"), 2, ?e), 0, ?v);
    if (op_shape_refusal(?two) == nil) { ret 10; }
    # a required literal decides what follows the row's own operands, with no `|`
    val req: Op = op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "lv"), 0, ?e);
    if (op_shape_refusal(?req) != nil || op_tail_literal(?req) != nil || req.min_arity != 2 || req.arity != 6) { ret 11; }
    # more than a row carries
    var many: [1]OpEnumerant = [1]OpEnumerant{OpEnumerant{value: 1, name: "many", capability: NO_OP_CAPABILITY, requires: 0, operands: "vvvvvvvvvvvvvvvv"}};
    var big:  OpEnum         = OpEnum{name: "big", values: ?many[0], count: 1, mask: false};
    val over: Op             = op_enumerated(op_shaped("core", "op", 1, 2, OP_RESULT_VALUE, NO_OP_SPACE, "l"), 0, ?big);
    if (op_shape_refusal(?over) == nil) { ret 12; }
    ret 0;
}
