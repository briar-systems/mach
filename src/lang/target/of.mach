    var b: OfVTable = t_artifact(OF_ELF, "fmt_b");
    val r_2454: err[fail.Fail] = register(?reg, ?b);
    if (!sel r_2454.err) { registry_dnit(?reg); ret 1; }

    var c: OfVTable = t_artifact(OF_MACHO, "fmt_a");
    val r_2457: err[fail.Fail] = register(?reg, ?c);
    if (!sel r_2457.err) { registry_dnit(?reg); ret 1; }

    val r_2459: err[fail.Fail] = register(?reg, ?a);
