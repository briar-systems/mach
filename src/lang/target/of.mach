val     OF_UNKNOWN: u32 = 0;
pub val OF_ELF:     u32 = 1;
pub val OF_MACHO:   u32 = 2;
pub val OF_COFF:    u32 = 3;
pub val OF_RAW:     u32 = 4;
pub val OF_SPV:     u32 = 5;

# the version of the fingerprint tags formats declare; a tag is never reused
pub val FINGERPRINT_VERSION: u8 = 1;

pub def SectionKind: u8;

pub val SK_TEXT:      SectionKind = 0;
pub val SK_DATA:      SectionKind = 1;
pub val SK_RODATA:    SectionKind = 2;
pub val SK_RELRO:     SectionKind = 3;
pub val SK_BSS:       SectionKind = 4;
pub val SK_DEBUG:     SectionKind = 5;
pub val SK_EXCEPTION: SectionKind = 6;

pub val SK_COUNT: u32 = 7;

# one row per section kind, indexed by the kind: its canonical name and the
# properties every format and the linker derive their placement from. adding
# a kind is adding a row; a kind without a row is outside the catalog and
# every lookup below refuses it
pub rec SectionKindDesc {
    kind:       SectionKind;
    name:       str;
    loadable:   bool;
    executable: bool;
    writable:   bool;
    has_bits:   bool;
    debug:      bool;
}

val SECTION_KINDS: [SK_COUNT]SectionKindDesc = [SK_COUNT]SectionKindDesc{
    SectionKindDesc{kind: SK_TEXT, name: ".text", loadable: true, executable: true, writable: false, has_bits: true, debug: false},
    SectionKindDesc{kind: SK_DATA, name: ".data", loadable: true, executable: false, writable: true, has_bits: true, debug: false},
    SectionKindDesc{kind: SK_RODATA, name: ".rodata", loadable: true, executable: false, writable: false, has_bits: true, debug: false},
    SectionKindDesc{kind: SK_RELRO, name: ".data.rel.ro", loadable: true, executable: false, writable: false, has_bits: true, debug: false},
    SectionKindDesc{kind: SK_BSS, name: ".bss", loadable: true, executable: false, writable: true, has_bits: false, debug: false},
    SectionKindDesc{kind: SK_DEBUG, name: ".debug", loadable: false, executable: false, writable: false, has_bits: true, debug: true},
    SectionKindDesc{kind: SK_EXCEPTION, name: ".exception", loadable: false, executable: false, writable: false, has_bits: true, debug: false},
};

pub fun section_kind_valid(kind: SectionKind) bool {
    ret kind::u32 < SK_COUNT;
}

# the row for a declared kind, absent for a member outside the catalog
pub fun section_desc(kind: SectionKind) opt[*SectionKindDesc] {
    if (!section_kind_valid(kind) || SECTION_KINDS[kind::u32].kind != kind) { ret opt[*SectionKindDesc].none{}; }
    ret opt[*SectionKindDesc].some{?SECTION_KINDS[kind::u32]};
}

# the canonical name of a declared kind, absent for a member outside the catalog
pub fun canonical_section_name(kind: SectionKind) opt[str] {
    val desc: opt[*SectionKindDesc] = section_desc(kind);
    if (sel desc.none) { ret opt[str].none{}; }
    ret opt[str].some{desc.some.name};
}

# a section kind outside the catalog reached a consumer that validated its
# image at entry: internal, naming the catalog and the tag
pub fun section_kind_rejection(itn: *intern.Interner, alloc: *A.Allocator, kind: SectionKind) res[str, fail.Fail] {
    ret fail.catalog_interned(itn, alloc, fail.unknown_member("SectionKind", kind::u32));
}

test section_kinds__every_member_has_its_row_and_no_other_tag_does {
    var i: u32 = 0;
    for (i < SK_COUNT) {
        val desc: opt[*SectionKindDesc] = section_desc(i::SectionKind);
        if (sel desc.none) { ret 1; }
        val row: *SectionKindDesc = desc.some;
        if (row.kind::u32 != i || str_len(row.name) == 0) { ret 2; }
        if (row.executable && row.writable)               { ret 3; }
        if (row.debug && row.loadable)                    { ret 4; }
        i = i + 1;
    }
    val r_177: opt[*SectionKindDesc] = section_desc(SK_COUNT::SectionKind);
    if (sel r_177.some) { ret 5; }
    val r_178: opt[str] = canonical_section_name(255::SectionKind);
    if (sel r_178.some) { ret 6; }
    val bss: opt[*SectionKindDesc] = section_desc(SK_BSS);
    if (sel bss.none)      { ret 7; }
    if (bss.some.has_bits) { ret 7; }
    ret 0;
}

pub def RelocKind: u8;

pub val RK_ABS64:              RelocKind = 0;
pub val RK_PC32:               RelocKind = 1;
pub val RK_PLT32:              RelocKind = 2;
pub val RK_GOTPCREL:           RelocKind = 3;
pub val RK_ABS32S:             RelocKind = 4;
pub val RK_ADDR32NB:           RelocKind = 5;
pub val RK_PAGE21:             RelocKind = 6;
pub val RK_ADD_LO12:           RelocKind = 7;
pub val RK_LDST8_LO12:         RelocKind = 8;
pub val RK_LDST16_LO12:        RelocKind = 9;
pub val RK_LDST32_LO12:        RelocKind = 10;
pub val RK_LDST64_LO12:        RelocKind = 11;
pub val RK_LDST128_LO12:       RelocKind = 12;
pub val RK_PCREL_HI20:         RelocKind = 13;
pub val RK_PCREL_LO12_I:       RelocKind = 14;
pub val RK_PCREL_LO12_S:       RelocKind = 15;
pub val RK_ABS32:              RelocKind = 16;
pub val RK_SECREL32:           RelocKind = 17;
pub val RK_SECTION:            RelocKind = 18;
pub val RK_GOT_PAGE21:         RelocKind = 19;
pub val RK_GOT_LO12:           RelocKind = 20;
val     RK_ABS16:              RelocKind = 21;
pub val RK_GOTPCREL_NORELAX:   RelocKind = 22;
pub val RK_GOTPCREL64_NORELAX: RelocKind = 23;

pub val RK_DIFF32: RelocKind = 24;
pub val RK_DIFF64: RelocKind = 25;
pub val RK_JUMP26: RelocKind = 26;

pub val RK_GOT_PCREL_HI20: RelocKind = 27;

# the riscv jal 20-bit j-type field, +-1 MiB, even displacement
pub val RK_JAL20: RelocKind = 28;

# a 64-bit field holding the target's distance from the field
pub val RK_PC64: RelocKind = 29;

pub val RK_CATALOG_COUNT: u32 = 30;

# one row per relocation kind, indexed by the kind: its display name and, for a
# difference kind, the kind the resolved difference is applied as (every other
# row applies as itself). adding a kind is adding a row; a kind without a row
# is outside the catalog and every lookup below refuses it
rec RelocKindDesc {
    kind:       RelocKind;
    name:       str;
    apply_kind: RelocKind;
}

val RELOC_KINDS: [RK_CATALOG_COUNT]RelocKindDesc = [RK_CATALOG_COUNT]RelocKindDesc{
    RelocKindDesc{kind: RK_ABS64, name: "abs64", apply_kind: RK_ABS64},
    RelocKindDesc{kind: RK_PC32, name: "pc32", apply_kind: RK_PC32},
    RelocKindDesc{kind: RK_PLT32, name: "plt32", apply_kind: RK_PLT32},
    RelocKindDesc{kind: RK_GOTPCREL, name: "gotpcrel", apply_kind: RK_GOTPCREL},
    RelocKindDesc{kind: RK_ABS32S, name: "abs32s", apply_kind: RK_ABS32S},
    RelocKindDesc{kind: RK_ADDR32NB, name: "addr32nb", apply_kind: RK_ADDR32NB},
    RelocKindDesc{kind: RK_PAGE21, name: "page21", apply_kind: RK_PAGE21},
    RelocKindDesc{kind: RK_ADD_LO12, name: "add_lo12", apply_kind: RK_ADD_LO12},
    RelocKindDesc{kind: RK_LDST8_LO12, name: "ldst8_lo12", apply_kind: RK_LDST8_LO12},
    RelocKindDesc{kind: RK_LDST16_LO12, name: "ldst16_lo12", apply_kind: RK_LDST16_LO12},
    RelocKindDesc{kind: RK_LDST32_LO12, name: "ldst32_lo12", apply_kind: RK_LDST32_LO12},
    RelocKindDesc{kind: RK_LDST64_LO12, name: "ldst64_lo12", apply_kind: RK_LDST64_LO12},
    RelocKindDesc{kind: RK_LDST128_LO12, name: "ldst128_lo12", apply_kind: RK_LDST128_LO12},
    RelocKindDesc{kind: RK_PCREL_HI20, name: "pcrel_hi20", apply_kind: RK_PCREL_HI20},
    RelocKindDesc{kind: RK_PCREL_LO12_I, name: "pcrel_lo12_i", apply_kind: RK_PCREL_LO12_I},
    RelocKindDesc{kind: RK_PCREL_LO12_S, name: "pcrel_lo12_s", apply_kind: RK_PCREL_LO12_S},
    RelocKindDesc{kind: RK_ABS32, name: "abs32", apply_kind: RK_ABS32},
    RelocKindDesc{kind: RK_SECREL32, name: "secrel32", apply_kind: RK_SECREL32},
    RelocKindDesc{kind: RK_SECTION, name: "section", apply_kind: RK_SECTION},
    RelocKindDesc{kind: RK_GOT_PAGE21, name: "got_page21", apply_kind: RK_GOT_PAGE21},
    RelocKindDesc{kind: RK_GOT_LO12, name: "got_lo12", apply_kind: RK_GOT_LO12},
    RelocKindDesc{kind: RK_ABS16, name: "abs16", apply_kind: RK_ABS16},
    RelocKindDesc{kind: RK_GOTPCREL_NORELAX, name: "gotpcrel_norelax", apply_kind: RK_GOTPCREL_NORELAX},
    RelocKindDesc{kind: RK_GOTPCREL64_NORELAX, name: "gotpcrel64_norelax", apply_kind: RK_GOTPCREL64_NORELAX},
    RelocKindDesc{kind: RK_DIFF32, name: "diff32", apply_kind: RK_ABS32S},
    RelocKindDesc{kind: RK_DIFF64, name: "diff64", apply_kind: RK_PC64},
    RelocKindDesc{kind: RK_JUMP26, name: "jump26", apply_kind: RK_JUMP26},
    RelocKindDesc{kind: RK_GOT_PCREL_HI20, name: "got_pcrel_hi20", apply_kind: RK_GOT_PCREL_HI20},
    RelocKindDesc{kind: RK_JAL20, name: "jal20", apply_kind: RK_JAL20},
    RelocKindDesc{kind: RK_PC64, name: "pc64", apply_kind: RK_PC64},
};

pub fun reloc_kind_valid(kind: RelocKind) bool {
    ret kind::u32 < RK_CATALOG_COUNT;
}

# the row for a declared kind, absent for a member outside the catalog
fun reloc_desc(kind: RelocKind) opt[*RelocKindDesc] {
    if (!reloc_kind_valid(kind) || RELOC_KINDS[kind::u32].kind != kind) { ret opt[*RelocKindDesc].none{}; }
    ret opt[*RelocKindDesc].some{?RELOC_KINDS[kind::u32]};
}

pub fun is_difference(kind: RelocKind) bool {
    ret kind == RK_DIFF32 || kind == RK_DIFF64;
}

# the kind a difference relocation is applied as once its difference is
# resolved, absent for a member outside the catalog
pub fun difference_apply_kind(kind: RelocKind) opt[RelocKind] {
    val desc: opt[*RelocKindDesc] = reloc_desc(kind);
    if (sel desc.none) { ret opt[RelocKind].none{}; }
    ret opt[RelocKind].some{desc.some.apply_kind};
}

# the display name of a declared kind, absent for a member outside the catalog
pub fun reloc_kind_name(kind: RelocKind) opt[str] {
    val desc: opt[*RelocKindDesc] = reloc_desc(kind);
    if (sel desc.none) { ret opt[str].none{}; }
    ret opt[str].some{desc.some.name};
}

# a declared kind a format or target does not honor is unsupported by `by`; a
# member outside the catalog is internal. both name the catalog and the member
pub fun reloc_kind_rejection(itn: *intern.Interner, alloc: *A.Allocator, kind: RelocKind, by: str) res[str, fail.Fail] {
    val name: opt[str] = reloc_kind_name(kind);
    if (sel name.none) { ret fail.catalog_interned(itn, alloc, fail.unknown_member("RelocKind", kind::u32)); }
    ret fail.catalog_interned(itn, alloc, fail.unsupported_member("RelocKind", name.some, by));
}

test reloc_kinds__every_member_has_its_row_and_no_other_tag_does {
    var i: u32 = 0;
    for (i < RK_CATALOG_COUNT) {
        val desc: opt[*RelocKindDesc] = reloc_desc(i::RelocKind);
        if (sel desc.none) { ret 1; }
        val row: *RelocKindDesc = desc.some;
        if (row.kind::u32 != i || str_len(row.name) == 0)            { ret 2; }
        if (is_difference(row.kind) == (row.apply_kind == row.kind)) { ret 3; }
        i = i + 1;
    }
    val r_310: opt[*RelocKindDesc] = reloc_desc(RK_CATALOG_COUNT::RelocKind);
    if (sel r_310.some) { ret 4; }
    val r_311: opt[str] = reloc_kind_name(255::RelocKind);
    if (sel r_311.some) { ret 5; }
    val r_312: opt[RelocKind] = difference_apply_kind(255::RelocKind);
    if (sel r_312.some) { ret 6; }
    val d64: opt[RelocKind] = difference_apply_kind(RK_DIFF64);
    val d32: opt[RelocKind] = difference_apply_kind(RK_DIFF32);
    if (sel d64.none)          { ret 7; }
    if (d64.some != RK_PC64)   { ret 7; }
    if (sel d32.none)          { ret 8; }
    if (d32.some != RK_ABS32S) { ret 8; }
    ret 0;
}

pub val SYM_OBJ_FLAG_GLOBAL:       u32 = 0x01;
pub val SYM_OBJ_FLAG_WEAK:         u32 = 0x02;
pub val SYM_OBJ_FLAG_EXTERN:       u32 = 0x04;
pub val SYM_OBJ_FLAG_FUNCTION:     u32 = 0x08;
pub val SYM_OBJ_FLAG_OBJECT:       u32 = 0x10;
pub val SYM_OBJ_FLAG_FALLBACK:     u32 = 0x20;
pub val SYM_OBJ_FLAG_SEARCH:       u32 = 0x40;
pub val SYM_OBJ_FLAG_ALIAS:        u32 = 0x80;
pub val SYM_OBJ_FLAG_COMMON:       u32 = 0x100;
pub val SYM_OBJ_FLAG_SIZE_UNKNOWN: u32 = 0x200;

# a definition every module in the link may reference and no linked image
# exports: ELF STV_HIDDEN, Mach-O N_PEXT, absent from a PE export table
pub val SYM_OBJ_FLAG_HIDDEN: u32 = 0x400;

# a final link keeps the definition even when nothing references it: Mach-O
# N_NO_DEAD_STRIP, which `__attribute__((used))` sets
pub val SYM_OBJ_FLAG_RETAIN: u32 = 0x800;

val SYM_OBJ_FLAG_MASK: u32 = SYM_OBJ_FLAG_GLOBAL | SYM_OBJ_FLAG_WEAK
    | SYM_OBJ_FLAG_EXTERN | SYM_OBJ_FLAG_FUNCTION | SYM_OBJ_FLAG_OBJECT
    | SYM_OBJ_FLAG_FALLBACK | SYM_OBJ_FLAG_SEARCH | SYM_OBJ_FLAG_ALIAS
    | SYM_OBJ_FLAG_COMMON | SYM_OBJ_FLAG_SIZE_UNKNOWN | SYM_OBJ_FLAG_HIDDEN
    | SYM_OBJ_FLAG_RETAIN;

pub val SECTION_EXTERNAL: u32 = 0xFFFFFFFF;

# the nominal identity of a section within one object image
#
# a record, not a `def` alias: a `def` interchanges freely with its base type,
# and the point of the identity is that a section id cannot be handed where a
# symbol, segment, module or placement index is meant. the sentinels
# SECTION_EXTERNAL and SECTION_ABSOLUTE live inside the domain and are reached
# only through the constructors below.
pub rec SectionId {
    index: u32;
}

pub fun section_id(index: u32) SectionId {
    var id: SectionId;
    id.index = index;
    ret id;
}

pub fun no_section() SectionId {
    ret section_id(SECTION_EXTERNAL);
}

pub fun external_section() SectionId {
    ret section_id(SECTION_EXTERNAL);
}

pub fun absolute_section() SectionId {
    ret section_id(SECTION_ABSOLUTE);
}

pub fun section_index(id: SectionId) u32 {
    ret id.index;
}

pub fun section_is_external(id: SectionId) bool {
    ret id.index == SECTION_EXTERNAL;
}

pub fun section_is_absolute(id: SectionId) bool {
    ret id.index == SECTION_ABSOLUTE;
}

pub fun section_same(left: SectionId, right: SectionId) bool {
    ret left.index == right.index;
}

pub val SYMBOL_NONE: u32 = 0xFFFFFFFF;

pub val SEG_FLAG_READ:    u32 = 0x4;
pub val SEG_FLAG_WRITE:   u32 = 0x2;
pub val SEG_FLAG_EXECUTE: u32 = 0x1;

pub val SEC_FLAG_MERGEABLE:  u32 = 0x1;
pub val SEC_FLAG_COALESCE:   u32 = 0x4;
pub val SEC_FLAG_INIT_FUNCS: u32 = 0x2;
# a final link keeps the section even when nothing references it
pub val SEC_FLAG_RETAIN: u32 = 0x8;

pub val SEC_FLAG_IMAGE_MASK: u32 = SEC_FLAG_INIT_FUNCS;

# the unwind tables: the index an unwinder searches first and the frame
# descriptions it leads to. on a load section, the room the linker reserved for
# the format's table. on an input section, the object's own contribution to
# that table, which a link building the tables takes into them: frame
# descriptions (`.eh_frame`, mach-o `__eh_frame`) are carried into the frames
# table, and an index (mach-o `__compact_unwind`) is read, never placed
pub val SEC_FLAG_UNWIND_INDEX:  u32 = 0x10;
pub val SEC_FLAG_UNWIND_FRAMES: u32 = 0x20;

# the section lives and dies with the one `native.link_section` names: a coff
# associative comdat member, or an elf section ordered after its owner
# (SHF_LINK_ORDER). a final link keeps it exactly while it keeps that owner
pub val SEC_FLAG_ASSOCIATED: u32 = 0x40;

# the section lists sections of its object that a link keeps or drops
# together: a flags word, then one word per member holding the member's index
# plus one, NATIVE_GROUP_RELOC set on a member that is a section's relocations
pub val SEC_FLAG_GROUP: u32 = 0x80;

val SEC_FLAG_MASK: u32 = SEC_FLAG_MERGEABLE | SEC_FLAG_INIT_FUNCS | SEC_FLAG_COALESCE | SEC_FLAG_RETAIN
    | SEC_FLAG_UNWIND_INDEX | SEC_FLAG_UNWIND_FRAMES | SEC_FLAG_ASSOCIATED | SEC_FLAG_GROUP;

pub val NATIVE_GROUP_RELOC: u32 = 0x80000000;

pub rec NativeSection {
    format:       u32;
    flags:        u64;
    kind:         u32;
    entry_size:   u64;
    name:         [16]u8;
    segment:      [16]u8;
    reserved1:    u32;
    reserved2:    u32;
    reserved3:    u32;
    link_section: u32;
    link_symbol:  u32;
    selection:    u32;
    checksum:     u32;
}

pub rec Section {
    name:   intern.StrId;
    kind:   SectionKind;
    bytes:  *u8;
    len:    u32;
    align:  u32;
    flags:  u32;
    native: NativeSection;
}

# the section an associated section lives and dies with, as an index into its
# object's sections; none for a section that is not associated
pub fun associated_owner(sec: *Section) opt[u32] {
    if ((sec.flags & SEC_FLAG_ASSOCIATED) == 0 || sec.native.link_section == 0) { ret opt[u32].none{}; }
    ret opt[u32].some{sec.native.link_section - 1};
}

# the bytes of one entry of an unwind index section, 0 when it declares none
pub fun unwind_entry_size(sec: *Section) u64 {
    ret sec.native.entry_size;
}

# a member of a section group: a section of the group's object, or that
# section's relocations
pub rec GroupMember {
    section:     u32;
    relocations: bool;
}

# the members a group section lists
pub fun group_member_count(sec: *Section) u32 {
    if ((sec.flags & SEC_FLAG_GROUP) == 0 || sec.bytes == nil || sec.len < 4) { ret 0; }
    ret (sec.len - 4) / 4;
}

# the group's member `i`, none for an entry that names no section
pub fun group_member_at(sec: *Section, i: u32) opt[GroupMember] {
    val at:  u32 = 4 + i * 4;
    val raw: u32 = sec.bytes[at]::u32 | (sec.bytes[at + 1]::u32 << 8) | (sec.bytes[at + 2]::u32 << 16) | (sec.bytes[at + 3]::u32 << 24);
    val one: u32 = raw & ~NATIVE_GROUP_RELOC;
    if (one == 0) { ret opt[GroupMember].none{}; }
    ret opt[GroupMember].some{GroupMember{section: one - 1, relocations: (raw & NATIVE_GROUP_RELOC) != 0}};
}

# moves every member of a group section `by` sections along, as its object's
# sections move when objects are combined
pub fun group_rebase(sec: *Section, by: u32) {
    var at: u32 = 4;
    for (at + 4 <= sec.len) {
        val raw:   u32 = sec.bytes[at]::u32 | (sec.bytes[at + 1]::u32 << 8) | (sec.bytes[at + 2]::u32 << 16) | (sec.bytes[at + 3]::u32 << 24);
        val moved: u32 = raw + by;
        sec.bytes[at]     = (moved & 0xFF)::u8;
        sec.bytes[at + 1] = ((moved >> 8) & 0xFF)::u8;
        sec.bytes[at + 2] = ((moved >> 16) & 0xFF)::u8;
        sec.bytes[at + 3] = ((moved >> 24) & 0xFF)::u8;
        at                = at + 4;
    }
}

pub fun validate_native_sections(image: *ObjectImage, format: u32) err[fail.Fail] {
    val valid: err[fail.Fail] = validate_object_view(image);
    if (sel valid.err) { ret valid; }
    if (image.indirect_count != 0 && format != OF_MACHO) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_FORMAT_MISMATCH, "indirect symbols belong to Mach-O")};
    }
    var i: u32 = 0;
    for (i < image.section_count) {
        val native: u32 = image.sections[i].native.format;
        if (native != 0 && native != format) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_FORMAT_MISMATCH, "native section metadata belongs to a different object format")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < image.symbol_count) {
        if (image.symbols[i].native.format != 0 && image.symbols[i].native.format != format) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_FORMAT_MISMATCH, "native symbol metadata belongs to a different object format")};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub val SECTION_ABSOLUTE: u32 = 0xFFFFFFFE;

pub rec NativeSymbol {
    format: u32;
    kind:   u32;
    flags:  u32;
}

pub rec Symbol {
    name:           intern.StrId;
    section:        SectionId;
    offset:         u32;
    size:           u32;
    flags:          u32;
    fallback:       u32;
    align:          u32;
    absolute_value: u64;
    native:         NativeSymbol;
}

# a frame step records what one prologue instruction did to the frame, in
# effect once the code reaches `end_off` bytes into the function. a step is
# isa-neutral: `reg` is the isa's own register number, which each unwind format
# translates, and "the stack pointer" is its value once the step has happened.
#   PUSH reg          the stack pointer drops by a pointer and reg is stored where it points
#   ALLOC value       the stack pointer drops by value bytes
#   SET_FP reg value  reg becomes the stack pointer plus value, and holds for the whole body
#   SAVE reg value    reg is stored at the stack pointer plus value, a signed offset
#   SAVE_VEC reg value  vector register reg is stored at the stack pointer plus value
#   REALIGN value     the stack pointer is rounded down to a multiple of value, so its
#                     distance from the caller's frame is no longer known
# a save after REALIGN is addressed from the stack pointer the body runs with.
# a frameless function's record has no steps: its call's frame holds throughout
pub val FRAME_STEP_PUSH:     u8 = 1;
pub val FRAME_STEP_ALLOC:    u8 = 2;
pub val FRAME_STEP_SET_FP:   u8 = 3;
pub val FRAME_STEP_SAVE:     u8 = 4;
pub val FRAME_STEP_SAVE_VEC: u8 = 5;
pub val FRAME_STEP_REALIGN:  u8 = 6;

pub val FRAME_STEP_LAST: u8 = FRAME_STEP_REALIGN;

# the most steps a frame record holds. a prologue records one step per
# callee-saved register it saves and at most FRAME_FIXED_STEPS more (the two
# allocations around a realignment, the frame pointer and return address
# saves, setting the frame pointer and the realignment itself), so the cap
# holds every convention whose callee-saved file fits beside them, which
# registration checks. the record stays fixed-size because the linker and
# every object writer copy frame records by value
pub val FRAME_STEP_CAP: u32 = 32;

pub val FRAME_FIXED_STEPS: u32 = 6;

pub rec FrameStep {
    kind:    u8;
    reg:     u8;
    end_off: u32;
    value:   u64;
}

pub rec FrameUnwind {
    section:    SectionId;
    offset:     u32;
    step_count: u32;
    steps:      [FRAME_STEP_CAP]FrameStep;
}

pub rec Relocation {
    section: SectionId;
    offset:  u32;
    kind:    RelocKind;
    sym:     u32;
    addend:  i64;
    sym2:    u32;
    pair:    u32;
    # bytes from the field's start to the end of its instruction, 0 when unknown
    inst_end: u8;
    # who asked for the relocation, which decides whose fault a refusal of it is
    origin: RelocOrigin;
}

# who produced a relocation: mach's codegen (the zero value), the user's
# inline asm, or an input object mach did not make
pub def RelocOrigin: u8;

pub val RELOC_CODEGEN: RelocOrigin = 0;
pub val RELOC_ASM:     RelocOrigin = 1;
pub val RELOC_INPUT:   RelocOrigin = 2;

# a relocation the link or the object writer refuses is the user's when their
# inline asm or an input object asked for it, and a compiler defect when
# codegen made it
pub fun reloc_refusal(origin: RelocOrigin, k: diagnostic_kind.Kind, text: str) fail.Fail {
    if (origin == RELOC_CODEGEN) { ret fail.message(text); }
    ret fail.user(k, text);
}

# the refusal carrying a made text, or the failure that refused to make it
pub fun reloc_refusal_made(origin: RelocOrigin, k: diagnostic_kind.Kind, made: res[str, fail.Fail]) fail.Fail {
    if (sel made.err) { ret made.err; }
    ret reloc_refusal(origin, k, made.ok);
}

# an object or archive the link reads from a path, and who produced it: an
# object mach wrote (RELOC_CODEGEN) or an input mach did not make
# (RELOC_INPUT). the origin travels with the path from where the list is built
pub rec ObjectInput {
    path:   *u8;
    origin: RelocOrigin;
}

# every relocation of an image read from an input takes that input's origin
pub fun set_relocation_origin(img: *ObjectImage, origin: RelocOrigin) {
    if (img == nil) { ret; }
    var i: u32 = 0;
    for (i < img.reloc_count) {
        img.relocations[i].origin = origin;
        i                         = i + 1;
    }
}

pub val INDIRECT_LOCAL:    u32 = 0x80000000;
pub val INDIRECT_ABSOLUTE: u32 = 0x40000000;

pub rec NativeIndirect {
    section: SectionId;
    slot:    u32;
    symbol:  u32;
    flags:   u32;
}

pub rec ObjectImage {
    alloc:    *A.Allocator;
    interner: *intern.Interner;
    name:     intern.StrId;

    sections:      *Section;
    section_count: u32;
    section_cap:   u32;

    symbols:      *Symbol;
    symbol_count: u32;
    symbol_cap:   u32;

    relocations: *Relocation;
    reloc_count: u32;
    reloc_cap:   u32;

    frames:      *FrameUnwind;
    frame_count: u32;
    frame_cap:   u32;

    imports:      *ImportDecl;
    import_count: u32;
    import_cap:   u32;

    indirects:      *NativeIndirect;
    indirect_count: u32;
    indirect_cap:   u32;

    # names this object asks the link to export whoever defines them: one per
    # `fwd` re-export a root-project module declares. a hidden definition the
    # link resolves under one of these names is exported after all
    export_requests:      *intern.StrId;
    export_request_count: u32;
    export_request_cap:   u32;

    machine_flags:  u32;
    attributes:     *u8;
    attributes_len: u32;

    # opaque bytes the object cache stores in the object, in a non-loaded
    # section the parser consumes (see target/of/record)
    cache_record:     *u8;
    cache_record_len: u32;

    # mach's codegen made this image, so its symbols bound self-contained atoms
    # the link may split and collect. codegen sets it, a snapshot keeps it and
    # a parser sets it when the object carries the link carrier (target/of/carrier)
    codegen: bool;
    # its symbols bound self-contained atoms the link may split, though mach's
    # codegen did not make it: storage the link synthesizes, or an object whose
    # format promises it
    symbol_atoms: bool;
}

pub fun object_image_init(alloc: *A.Allocator, itn: *intern.Interner,
    name: intern.StrId) ObjectImage {
    var image: ObjectImage;
    image.alloc                = alloc;
    image.interner             = itn;
    image.name                 = name;
    image.sections             = nil;
    image.section_count        = 0;
    image.section_cap          = 0;
    image.symbols              = nil;
    image.symbol_count         = 0;
    image.symbol_cap           = 0;
    image.relocations          = nil;
    image.reloc_count          = 0;
    image.reloc_cap            = 0;
    image.frames               = nil;
    image.frame_count          = 0;
    image.frame_cap            = 0;
    image.imports              = nil;
    image.import_count         = 0;
    image.import_cap           = 0;
    image.indirects            = nil;
    image.indirect_count       = 0;
    image.indirect_cap         = 0;
    image.export_requests      = nil;
    image.export_request_count = 0;
    image.export_request_cap   = 0;
    image.machine_flags        = 0;
    image.attributes           = nil;
    image.attributes_len       = 0;
    image.cache_record         = nil;
    image.cache_record_len     = 0;
    image.codegen              = false;
    image.symbol_atoms         = false;
    ret image;
}

pub fun object_image_dnit(image: *ObjectImage) {
    if (image == nil) { ret; }

    if (image.sections != nil && image.section_cap > 0) {
        var i:           u32 = 0;
        var section_len: u32 = image.section_count;
        if (section_len > image.section_cap) { section_len = image.section_cap; }
        for (i < section_len) {
            if (image.sections[i].bytes != nil && image.sections[i].len > 0) {
                A.deallocate[u8](image.alloc, image.sections[i].bytes, image.sections[i].len::usize);
            }
            i = i + 1;
        }
        A.deallocate[Section](image.alloc, image.sections, image.section_cap::usize);
    }
    image.sections      = nil;
    image.section_count = 0;
    image.section_cap   = 0;

    if (image.symbols != nil && image.symbol_cap > 0) {
        A.deallocate[Symbol](image.alloc, image.symbols, image.symbol_cap::usize);
    }
    image.symbols      = nil;
    image.symbol_count = 0;
    image.symbol_cap   = 0;

    if (image.relocations != nil && image.reloc_cap > 0) {
        A.deallocate[Relocation](image.alloc, image.relocations, image.reloc_cap::usize);
    }
    image.relocations = nil;
    image.reloc_count = 0;
    image.reloc_cap   = 0;

    if (image.frames != nil && image.frame_cap > 0) {
        A.deallocate[FrameUnwind](image.alloc, image.frames, image.frame_cap::usize);
    }
    image.frames      = nil;
    image.frame_count = 0;
    image.frame_cap   = 0;

    if (image.imports != nil && image.import_cap > 0) {
        A.deallocate[ImportDecl](image.alloc, image.imports, image.import_cap::usize);
    }
    image.imports      = nil;
    image.import_count = 0;
    image.import_cap   = 0;

    if (image.indirects != nil && image.indirect_cap > 0) {
        A.deallocate[NativeIndirect](image.alloc, image.indirects, image.indirect_cap::usize);
    }
    image.indirects      = nil;
    image.indirect_count = 0;
    image.indirect_cap   = 0;

    if (image.export_requests != nil && image.export_request_cap > 0) {
        A.deallocate[intern.StrId](image.alloc, image.export_requests, image.export_request_cap::usize);
    }
    image.export_requests      = nil;
    image.export_request_count = 0;
    image.export_request_cap   = 0;

    if (image.attributes != nil && image.attributes_len > 0) {
        A.deallocate[u8](image.alloc, image.attributes, image.attributes_len::usize);
    }
    image.attributes     = nil;
    image.attributes_len = 0;

    if (image.cache_record != nil && image.cache_record_len > 0) {
        A.deallocate[u8](image.alloc, image.cache_record, image.cache_record_len::usize);
    }
    image.cache_record     = nil;
    image.cache_record_len = 0;
}

pub fun section_install(o: *ObjectImage, s: *Section) res[u32, fail.Fail] {
    if (o == nil || o.alloc == nil || s == nil) {
        ret res[u32, fail.Fail].err{fail.message("cannot install a section without complete ownership")};
    }
    if (s.bytes != nil && s.len == 0) {
        ret res[u32, fail.Fail].err{fail.message("section byte allocation has no release extent")};
    }
    val section: Section = @s;
    s.bytes = nil;
    s.len   = 0;

    val res_grow: err[A.Error] = growth.reserve[Section](o.alloc, ?o.sections, ?o.section_cap, o.section_count::usize + 1);
    if (sel res_grow.err) {
        if (section.bytes != nil && section.len > 0) {
            A.deallocate[u8](o.alloc, section.bytes, section.len::usize);
        }
        ret res[u32, fail.Fail].err{fail.refused(res_grow.err)};
    }

    val ix: u32 = o.section_count;
    o.sections[ix]  = section;
    o.section_count = o.section_count + 1;
    ret res[u32, fail.Fail].ok{ix};
}

pub fun symbol_add(o: *ObjectImage, sym: Symbol) res[u32, fail.Fail] {
    val res_grow: err[A.Error] = growth.reserve[Symbol](o.alloc, ?o.symbols, ?o.symbol_cap, o.symbol_count::usize + 1);
    if (sel res_grow.err) {
        ret res[u32, fail.Fail].err{fail.refused(res_grow.err)};
    }

    val ix: u32 = o.symbol_count;
    o.symbols[ix]  = sym;
    o.symbol_count = o.symbol_count + 1;
    ret res[u32, fail.Fail].ok{ix};
}

pub fun export_request_add(o: *ObjectImage, name: intern.StrId) err[fail.Fail] {
    var i: u32 = 0;
    for (i < o.export_request_count) {
        if (intern.str_same(o.export_requests[i], name)) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    val res_grow: err[A.Error] = growth.reserve[intern.StrId](o.alloc, ?o.export_requests, ?o.export_request_cap, o.export_request_count::usize + 1);
    if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }

    o.export_requests[o.export_request_count] = name;
    o.export_request_count                    = o.export_request_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun add_frame(o: *ObjectImage, fr: *FrameUnwind) err[fail.Fail] {
    val res_grow: err[A.Error] = growth.reserve[FrameUnwind](o.alloc, ?o.frames, ?o.frame_cap, o.frame_count::usize + 1);
    if (sel res_grow.err) {
        ret err[fail.Fail].err{fail.refused(res_grow.err)};
    }

    o.frames[o.frame_count] = @fr;
    o.frame_count           = o.frame_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun add_relocation(o: *ObjectImage, rel: Relocation) err[fail.Fail] {
    val res_grow: err[A.Error] = growth.reserve[Relocation](o.alloc, ?o.relocations, ?o.reloc_cap, o.reloc_count::usize + 1);
    if (sel res_grow.err) {
        ret err[fail.Fail].err{fail.refused(res_grow.err)};
    }

    o.relocations[o.reloc_count] = rel;
    o.reloc_count                = o.reloc_count + 1;
    ret err[fail.Fail].ok{};
}

fun object_span_view_valid[T](items: *T, count: u32, cap: u32) bool {
    if (count > 0 && items == nil)                { ret false; }
    if (cap > 0 && (items == nil || count > cap)) { ret false; }
    ret true;
}

fun object_span_owned[T](items: *T, count: u32, cap: u32) bool {
    ret count <= cap && ((cap == 0) == (items == nil));
}

fun object_align_valid(align: u32) bool {
    ret align != 0 && (align & (align - 1)) == 0;
}

fun symbol_flags_valid(sym: *Symbol) bool {
    if ((sym.flags & ~SYM_OBJ_FLAG_MASK) != 0) { ret false; }
    if ((sym.flags & (SYM_OBJ_FLAG_FUNCTION | SYM_OBJ_FLAG_OBJECT))
        == (SYM_OBJ_FLAG_FUNCTION | SYM_OBJ_FLAG_OBJECT)) { ret false; }

    val relation: u32 = sym.flags
        & (SYM_OBJ_FLAG_FALLBACK | SYM_OBJ_FLAG_SEARCH | SYM_OBJ_FLAG_ALIAS);
    if ((relation & (SYM_OBJ_FLAG_SEARCH | SYM_OBJ_FLAG_ALIAS))
        == (SYM_OBJ_FLAG_SEARCH | SYM_OBJ_FLAG_ALIAS)) { ret false; }
    if ((relation & (SYM_OBJ_FLAG_SEARCH | SYM_OBJ_FLAG_ALIAS)) != 0
        && (relation & SYM_OBJ_FLAG_FALLBACK) == 0) { ret false; }
    if ((relation & SYM_OBJ_FLAG_FALLBACK) != 0
        && ((sym.flags & (SYM_OBJ_FLAG_WEAK | SYM_OBJ_FLAG_EXTERN))
        != (SYM_OBJ_FLAG_WEAK | SYM_OBJ_FLAG_EXTERN)
        || !section_is_external(sym.section))) { ret false; }
    if ((sym.flags & SYM_OBJ_FLAG_COMMON) != 0
        && ((sym.flags & SYM_OBJ_FLAG_EXTERN) == 0
        || !section_is_external(sym.section))) { ret false; }
    ret true;
}

fun import_name_valid(itn: *intern.Interner, name: intern.StrId) bool {
    val value: opt[str] = intern.get(itn, name);
    ret sel value.some && !str_empty(value.some);
}

# an object image carries catalog members another process wrote (a parsed
# object, a cache entry), so a member outside its catalog is malformed input.
# the message names the catalog and the tag through the one policy
fun malformed_member_message(image: *ObjectImage, catalog: str, tag: u32) res[str, fail.Fail] {
    ret fail.catalog_interned(image.interner, image.alloc, fail.malformed_member(catalog, tag));
}

pub fun validate_object_view(image: *ObjectImage) err[fail.Fail] {
    if (image == nil) {
        ret err[fail.Fail].err{fail.message("nil object image")};
    }
    if (image.interner == nil) {
        ret err[fail.Fail].err{fail.message("object image has no interner")};
    }
    if (!object_span_view_valid[Section](image.sections, image.section_count, image.section_cap)
        || !object_span_view_valid[Symbol](image.symbols, image.symbol_count, image.symbol_cap)
        || !object_span_view_valid[Relocation](image.relocations, image.reloc_count, image.reloc_cap)
        || !object_span_view_valid[FrameUnwind](image.frames, image.frame_count, image.frame_cap)
        || !object_span_view_valid[ImportDecl](image.imports, image.import_count, image.import_cap)
        || !object_span_view_valid[intern.StrId](image.export_requests, image.export_request_count, image.export_request_cap)
        || !object_span_view_valid[NativeIndirect](image.indirects, image.indirect_count, image.indirect_cap)) {
        ret err[fail.Fail].err{fail.message("object image has an invalid collection view")};
    }
    if (image.attributes_len > 0 && image.attributes == nil) {
        ret err[fail.Fail].err{fail.message("object image has an invalid attribute view")};
    }

    var i: u32 = 0;
    for (i < image.section_count) {
        val sec: *Section = ?image.sections[i];
        if (sec.native.format != 0 && sec.native.format != OF_ELF
            && sec.native.format != OF_MACHO && sec.native.format != OF_COFF) {
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.CATALOG_MALFORMED, malformed_member_message(image, "ObjectFormat", sec.native.format))};
        }
        if (sec.kind::u32 >= SK_COUNT) {
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.CATALOG_MALFORMED, malformed_member_message(image, "SectionKind", sec.kind::u32))};
        }
        if (!object_align_valid(sec.align)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object image has an invalid section alignment")};
        }
        if ((sec.native.format == OF_MACHO || sec.native.format == OF_COFF) && sec.native.flags > 0xFFFFFFFF) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "native section flags exceed their field width")};
        }
        if (sec.native.link_section > image.section_count
            || sec.native.link_symbol > image.symbol_count) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "native section relation is out of range")};
        }
        if ((sec.flags & ~SEC_FLAG_MASK) != 0) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object image has unknown section flags")};
        }
        if ((sec.flags & SEC_FLAG_ASSOCIATED) != 0
            && (sec.native.link_section == 0 || sec.native.link_section == i + 1)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "an associated section names no other section of its object")};
        }
        if ((sec.flags & (SEC_FLAG_MERGEABLE | SEC_FLAG_INIT_FUNCS)) == (SEC_FLAG_MERGEABLE | SEC_FLAG_INIT_FUNCS)
            || (sec.native.format != 0 && (sec.flags & SEC_FLAG_COALESCE) != 0)
            || ((sec.flags & SEC_FLAG_MERGEABLE) != 0 && sec.kind == SK_BSS)
            || ((sec.flags & SEC_FLAG_INIT_FUNCS) != 0
            && sec.kind != SK_DATA && sec.kind != SK_RODATA && sec.kind != SK_RELRO)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object image has incompatible section flags")};
        }
        if ((sec.kind == SK_BSS && sec.bytes != nil)
            || (sec.kind != SK_BSS && ((sec.len == 0) != (sec.bytes == nil)))) {
            ret err[fail.Fail].err{fail.message("object image has an invalid section byte view")};
        }
        if ((sec.flags & SEC_FLAG_GROUP) != 0) {
            if (sec.bytes == nil || sec.len < 4 || sec.len % 4 != 0 || sec.native.link_symbol == 0
                || image.section_count >= NATIVE_GROUP_RELOC) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "invalid native group shape")};
            }
            var gi: u32 = 0;
            for (gi < group_member_count(sec)) {
                val member: opt[GroupMember] = group_member_at(sec, gi);
                if (sel member.none) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "native group member is out of range")};
                }
                if (member.some.section >= image.section_count) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "native group member is out of range")};
                }
                gi = gi + 1;
            }
        }
        i = i + 1;
    }

    i = 0;
    for (i < image.symbol_count) {
        val sym: *Symbol = ?image.symbols[i];
        if (!symbol_flags_valid(sym)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object image has incompatible symbol flags")};
        }
        if (sym.native.format != 0 && sym.native.format != OF_ELF
            && sym.native.format != OF_COFF && sym.native.format != OF_MACHO) {
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.CATALOG_MALFORMED, malformed_member_message(image, "ObjectFormat", sym.native.format))};
        }
        if ((sym.native.format == OF_ELF && (sym.native.kind > 255 || sym.native.flags > 255))
            || (sym.native.format == OF_MACHO && (sym.native.kind > 255 || sym.native.flags > 65535))
            || (sym.native.format == OF_COFF && (sym.native.kind > 65535 || sym.native.flags > 255))) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "native symbol metadata exceeds its field width")};
        }
        if (section_is_absolute(sym.section)
            && ((sym.flags & (SYM_OBJ_FLAG_EXTERN | SYM_OBJ_FLAG_COMMON | SYM_OBJ_FLAG_FALLBACK)) != 0
            || sym.offset != 0)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "absolute definition has incompatible symbol state")};
        }
        if (!section_is_external(sym.section) && !section_is_absolute(sym.section)) {
            if (section_index(sym.section) >= image.section_count) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object symbol refers to an absent section")};
            }
            val section_len: u32 = image.sections[section_index(sym.section)].len;
            if (sym.offset > section_len) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object symbol starts outside its section")};
            }
            if ((sym.flags & SYM_OBJ_FLAG_SIZE_UNKNOWN) == 0
                && sym.size > section_len - sym.offset) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object symbol extends beyond its section")};
            }
        }
        if ((sym.flags & SYM_OBJ_FLAG_FALLBACK) != 0
            && (sym.fallback == SYMBOL_NONE || sym.fallback >= image.symbol_count)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object symbol has an invalid fallback")};
        }
        i = i + 1;
    }

    i = 0;
    for (i < image.indirect_count) {
        val entry: *NativeIndirect = ?image.indirects[i];
        if (section_index(entry.section) >= image.section_count || image.sections[section_index(entry.section)].native.format != OF_MACHO
            || (entry.flags & ~(INDIRECT_LOCAL | INDIRECT_ABSOLUTE)) != 0
            || (entry.flags == 0 && entry.symbol >= image.symbol_count)
            || (entry.flags != 0 && entry.symbol != SYMBOL_NONE)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "invalid native indirect symbol relation")};
        }
        i = i + 1;
    }

    i = 0;
    for (i < image.import_count) {
        val decl: *ImportDecl = ?image.imports[i];
        if (!import_name_valid(image.interner, decl.symbol)
            || !import_name_valid(image.interner, decl.import_name)
            || !import_name_valid(image.interner, decl.library)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object image has an invalid import name")};
        }
        i = i + 1;
    }

    i = 0;
    for (i < image.reloc_count) {
        val reloc: *Relocation = ?image.relocations[i];
        if (!reloc_kind_valid(reloc.kind)) {
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.CATALOG_MALFORMED, malformed_member_message(image, "RelocKind", reloc.kind::u32))};
        }
        if (section_index(reloc.section) >= image.section_count) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object relocation refers to an absent section")};
        }
        if (reloc.offset > image.sections[section_index(reloc.section)].len) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object relocation starts outside its section")};
        }
        if (reloc.sym >= image.symbol_count) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object relocation refers to an absent symbol")};
        }
        if (is_difference(reloc.kind) && reloc.sym2 >= image.symbol_count) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "difference relocation refers to an absent second symbol")};
        }
        if (reloc.pair > image.reloc_count) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object relocation refers to an absent paired relocation")};
        }
        i = i + 1;
    }

    i = 0;
    for (i < image.frame_count) {
        val frame: *FrameUnwind = ?image.frames[i];
        if (section_index(frame.section) >= image.section_count) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object frame refers to an absent section")};
        }
        if (frame.offset > image.sections[section_index(frame.section)].len) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object frame starts outside its section")};
        }
        if (frame.step_count > FRAME_STEP_CAP) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "object frame exceeds its step capacity")};
        }
        var step_i: u32 = 0;
        for (step_i < frame.step_count) {
            val kind: u8 = frame.steps[step_i].kind;
            if (kind < FRAME_STEP_PUSH || kind > FRAME_STEP_LAST) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.CATALOG_MALFORMED, malformed_member_message(image, "FrameStepKind", kind::u32))};
            }
            step_i = step_i + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun validate_owned_object(image: *ObjectImage) err[fail.Fail] {
    val view: err[fail.Fail] = validate_object_view(image);
    if (sel view.err) { ret view; }
    if (image.alloc == nil) {
        ret err[fail.Fail].err{fail.message("owned object image has no allocator")};
    }
    if (!object_span_owned[Section](image.sections, image.section_count, image.section_cap)
        || !object_span_owned[Symbol](image.symbols, image.symbol_count, image.symbol_cap)
        || !object_span_owned[Relocation](image.relocations, image.reloc_count, image.reloc_cap)
        || !object_span_owned[FrameUnwind](image.frames, image.frame_count, image.frame_cap)
        || !object_span_owned[ImportDecl](image.imports, image.import_count, image.import_cap)
        || !object_span_owned[intern.StrId](image.export_requests, image.export_request_count, image.export_request_cap)
        || !object_span_owned[NativeIndirect](image.indirects, image.indirect_count, image.indirect_cap)
        || ((image.attributes_len == 0) != (image.attributes == nil))) {
        ret err[fail.Fail].err{fail.message("owned object image has a noncanonical allocation shape")};
    }
    ret err[fail.Fail].ok{};
}

pub fun validate_owned_object_or_dnit(image: *ObjectImage) err[fail.Fail] {
    val valid: err[fail.Fail] = validate_owned_object(image);
    if (sel valid.err) {
        val reason: fail.Fail = valid.err;
        object_image_dnit(image);
        ret err[fail.Fail].err{reason};
    }
    ret err[fail.Fail].ok{};
}

pub rec ImportDecl {
    symbol:      intern.StrId;
    import_name: intern.StrId;
    library:     intern.StrId;
    ordinal:     u16;
    by_name:     bool;
    is_code:     bool;
}

