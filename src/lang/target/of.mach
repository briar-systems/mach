test "mach.lang.target.of.register:rejects_malformed_isa_coverage" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var vt: OfVTable = t_direct(1, "coverage_count");
    vt.covers_isa_count = OF_ISA_MAX + 1;
    val r_2429: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2429.err) { ret 1; }
    vt = t_direct(1, "coverage_mixed");
    vt.covers_isa_any = true; vt.covers_isa_count = 1; vt.covers_isas[0] = arch.X86_64;
    val r_2432: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2432.err) { ret 1; }
    vt = t_direct(1, "coverage_unknown");
    vt.covers_isa_count = 1; vt.covers_isas[0] = arch.UNKNOWN;
    val r_2435: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2435.err) { ret 1; }
    vt = t_direct(1, "coverage_duplicate");
    vt.covers_isa_count = 2; vt.covers_isas[0] = arch.X86_64; vt.covers_isas[1] = arch.X86_64;
    val r_2438: err[fail.Fail] = register(?reg, ?vt);
    if (!sel r_2438.err) { ret 1; }
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

