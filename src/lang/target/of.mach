val OF_ISA_MAX: u32 = 8;

pub rec OfVTable {
    id:                  u32;
    name:                str;
    produces_image:      bool;
    links_from_image:    bool;
    object_is_artifact:  bool;
    object_ext:          str;
    emit_object:         WriterFn;
    parse_object:        ParserFn;
    emit_exec:           ExecFn;
    emit_exec_image:     ExecImageFn;
    emit_dyn_exec:       DynExecFn;
    emit_shared:         SharedFn;
    covers_isas:         [OF_ISA_MAX]u32;
    covers_isa_count:    u32;
    covers_isa_any:      bool;
    two_level_namespace: bool;
    default_debug:       str;
    shared_input_ext:    str;
    import_address_prefix: str;
    header_in_first_segment: bool;

    carries_stack_size:  bool;

    default_stack_reserve: u64;
    header_span:         HeaderSpanFn;
    executable_section_location: ExecutableSectionLocationFn;
}

pub fun artifact_vtable(id: u32, name: str, object_ext: str,
                        emit_object: WriterFn) OfVTable {
    var vt: OfVTable;
    vt.id = id;
    vt.name = name;
    vt.object_is_artifact = true;
    vt.object_ext = object_ext;
    vt.emit_object = emit_object;
    ret vt;
}

pub fun linker_vtable(id: u32, name: str, object_ext: str,
                      emit_object: WriterFn, parse_object: ParserFn,
                      emit_exec: ExecFn) OfVTable {
    var vt: OfVTable;
    vt.id = id;
    vt.name = name;
    vt.links_from_image = true;
    vt.object_ext = object_ext;
    vt.emit_object = emit_object;
    vt.parse_object = parse_object;
    vt.emit_exec = emit_exec;
    ret vt;
}

pub fun direct_image_vtable(id: u32, name: str, object_ext: str,
                            emit_object: WriterFn, parse_object: ParserFn,
                            emit_exec: ExecFn, emit_exec_image: ExecImageFn) OfVTable {
    var vt: OfVTable = linker_vtable(id, name, object_ext, emit_object,
                                     parse_object, emit_exec);
    vt.produces_image = true;
    vt.emit_exec_image = emit_exec_image;
    ret vt;
}

pub fun with_dynamic_exec(vt: *OfVTable, emit: DynExecFn) {
    vt.emit_dyn_exec = emit;
}

pub fun with_shared_output(vt: *OfVTable, emit: SharedFn) {
    vt.emit_shared = emit;
}

pub def ArtifactOutputKind: u8;
pub val ARTIFACT_EXECUTABLE: ArtifactOutputKind = 0;
pub val ARTIFACT_STATIC_LIB: ArtifactOutputKind = 1;
pub val ARTIFACT_SHARED_LIB: ArtifactOutputKind = 2;
pub val ARTIFACT_OBJECT:     ArtifactOutputKind = 3;

pub rec ArtifactName {
    prefix: str;
    suffix: str;
    key:    str;
}

pub fun artifact_naming(vt: *OfVTable, os_name: str, kind: ArtifactOutputKind) R.Result[ArtifactName, str] {
    if (vt == nil) { ret R.err[ArtifactName, str]("artifact naming: nil object format"); }

    var an: ArtifactName;
    an.prefix = "";
    an.suffix = "";
    an.key    = vt.name;

    if (kind == ARTIFACT_OBJECT) {
        if (!str_empty(vt.object_ext)) { an.suffix = dotted_ext(vt.object_ext); }
        ret R.ok[ArtifactName, str](an);
    }

    if (kind == ARTIFACT_SHARED_LIB) {
        if (str_empty(vt.shared_input_ext)) {
            ret R.err[ArtifactName, str]("artifact naming: this object format has no shared-library form");
        }
        an.suffix = vt.shared_input_ext;
        if (!str_equals(vt.shared_input_ext, ".dll")) { an.prefix = "lib"; }
        ret R.ok[ArtifactName, str](an);
    }

    if (kind == ARTIFACT_STATIC_LIB) {
        if (vt.object_is_artifact || str_empty(vt.object_ext)) {
            ret R.err[ArtifactName, str]("artifact naming: this object format has no static-library form");
        }
        if (str_equals(os_name, "windows")) { an.suffix = ".lib"; }
        or { an.prefix = "lib"; an.suffix = ".a"; }
        ret R.ok[ArtifactName, str](an);
    }

    if (vt.object_is_artifact) {
        if (!str_empty(vt.object_ext)) { an.suffix = dotted_ext(vt.object_ext); }
        ret R.ok[ArtifactName, str](an);
    }
    if (vt.produces_image) {
        ret R.ok[ArtifactName, str](an);
    }
    if (str_equals(os_name, "windows")) { an.suffix = ".exe"; }
    ret R.ok[ArtifactName, str](an);
}

fun dotted_ext(ext: str) str {
    if (str_len(ext) == 0)          { ret ""; }
    if (str_equals(ext, "o"))       { ret ".o"; }
    if (str_equals(ext, "obj"))     { ret ".obj"; }
    if (str_equals(ext, "spv"))     { ret ".spv"; }
    if (ext[0] == '.')              { ret ext; }
    ret ext;
}

val OF_REGISTRY_CAP: u32 = 8;

pub rec OfRegistry {
    entries: [8]OfVTable;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

pub fun registry_init() OfRegistry {
    var reg: OfRegistry;
    reg.alloc_ready = O.is_none[str](page.make(?reg.alloc));
    var i:   u32 = 0;
    for (i < OF_REGISTRY_CAP) {
        reg.entries[i].id = OF_UNKNOWN;
        reg.entries[i].name = nil;
        reg.entries[i].object_ext = nil;
        reg.entries[i].default_debug = nil;
        reg.entries[i].shared_input_ext = nil;
        reg.entries[i].import_address_prefix = nil;
        i = i + 1;
    }
    reg.count = 0;
    ret reg;
}

fun own_registry_str(alloc: *A.Allocator, src: str) R.Result[str, str] {
    if (src == nil) { ret str_copy(alloc, ""); }
    ret str_copy(alloc, src);
}

fun release_of_entry(reg: *OfRegistry, vt: *OfVTable) {
    if (vt.name != nil) {
        A.deallocate[u8](?reg.alloc, vt.name::*u8, str_len(vt.name) + 1);
        vt.name = nil;
    }
    if (vt.object_ext != nil) {
        A.deallocate[u8](?reg.alloc, vt.object_ext::*u8, str_len(vt.object_ext) + 1);
        vt.object_ext = nil;
    }
    if (vt.default_debug != nil) {
        A.deallocate[u8](?reg.alloc, vt.default_debug::*u8, str_len(vt.default_debug) + 1);
        vt.default_debug = nil;
    }
    if (vt.shared_input_ext != nil) {
        A.deallocate[u8](?reg.alloc, vt.shared_input_ext::*u8, str_len(vt.shared_input_ext) + 1);
        vt.shared_input_ext = nil;
    }
    if (vt.import_address_prefix != nil) {
        A.deallocate[u8](?reg.alloc, vt.import_address_prefix::*u8,
                         str_len(vt.import_address_prefix) + 1);
        vt.import_address_prefix = nil;
    }
}

pub fun registry_dnit(reg: *OfRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > OF_REGISTRY_CAP) { limit = OF_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        release_of_entry(reg, ?reg.entries[i]);
        i = i + 1;
    }
    reg.count = 0;
}

fun errf(fb: str, fmt: str, va: ...) str {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret fb; }
    val r: R.Result[str, str] = format.sprint(?alloc, fmt, va...);
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

fun dup_of_id(reg: *OfRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun descriptor_valid(vt: *OfVTable) bool {
    if (vt == nil || str_len(vt.name) == 0 || vt.id == OF_UNKNOWN) { ret false; }
    if (vt.object_is_artifact) {
        if (vt.produces_image || vt.links_from_image || vt.emit_object == nil
            || vt.parse_object != nil || vt.emit_exec != nil || vt.emit_exec_image != nil
            || vt.emit_dyn_exec != nil || vt.emit_shared != nil || str_len(vt.object_ext) == 0) { ret false; }
    } or (vt.produces_image) {
        if (!vt.links_from_image || vt.emit_object == nil || vt.parse_object == nil
            || vt.emit_exec == nil || vt.emit_exec_image == nil) { ret false; }
    } or (vt.links_from_image) {
        if (vt.emit_object == nil || vt.parse_object == nil || vt.emit_exec == nil
            || vt.emit_exec_image != nil) { ret false; }
    } or { ret false; }
    if ((vt.emit_dyn_exec != nil && vt.emit_exec == nil)
        || (vt.emit_shared != nil && !vt.links_from_image)
        || vt.header_in_first_segment != (vt.header_span != nil)
        || vt.covers_isa_count > OF_ISA_MAX
        || (vt.covers_isa_any && vt.covers_isa_count != 0)) { ret false; }
    var i: u32 = 0;
    for (i < vt.covers_isa_count) {
        if (vt.covers_isas[i] == arch.UNKNOWN) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (vt.covers_isas[j] == vt.covers_isas[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun registry_validate(reg: *OfRegistry) R.Result[R.Void, str] {
    if (reg == nil) { ret R.err[R.Void, str]("mach.lang.target.of: nil registry"); }
    if (!reg.alloc_ready || reg.count > OF_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: invalid registry backing or count");
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (!descriptor_valid(?reg.entries[i])) {
            ret R.err[R.Void, str]("mach.lang.target.of: registry contains an invalid descriptor");
        }
        var j: u32 = 0;
        for (j < i) {
            if (reg.entries[i].id == reg.entries[j].id
                || str_equals(reg.entries[i].name, reg.entries[j].name)) {
                ret R.err[R.Void, str]("mach.lang.target.of: registry contains a duplicate identity");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun register(reg: *OfRegistry, vt: *OfVTable) R.Result[R.Void, str] {
    if (reg == nil) {
        ret R.err[R.Void, str]("mach.lang.target.of: register called with a nil registry");
    }
    if (reg.count > OF_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: registry count exceeds its backing capacity");
    }
    if (vt == nil) {
        ret R.err[R.Void, str]("mach.lang.target.of: register called with a nil descriptor");
    }
    if (str_len(vt.name) == 0) {
        ret R.err[R.Void, str]("mach.lang.target.of: register called with an empty name");
    }
    if (vt.id == OF_UNKNOWN) {
        ret R.err[R.Void, str]("mach.lang.target.of: register called with the unknown object-format id");
    }
    if (O.is_some[*OfVTable](lookup(reg, vt.name))) {
        ret R.err[R.Void, str](errf("mach.lang.target.of: an object format is already registered under this name",
            "mach.lang.target.of: an object format named '{}' is already registered", vt.name));
    }
    if (dup_of_id(reg, vt.id)) {
        ret R.err[R.Void, str](errf("mach.lang.target.of: an object format is already registered under this id",
            "mach.lang.target.of: object format id {} is already registered (wanted to register '{}')", vt.id, vt.name));
    }
    if (reg.count >= OF_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: registry is at capacity; raise OF_REGISTRY_CAP to register another object format");
    }
    if (!reg.alloc_ready) {
        ret R.err[R.Void, str]("mach.lang.target.of: registry backing allocator is unavailable");
    }
    if (vt.object_is_artifact) {
        if (vt.produces_image || vt.links_from_image || vt.emit_object == nil
            || vt.parse_object != nil || vt.emit_exec != nil || vt.emit_exec_image != nil
            || vt.emit_dyn_exec != nil || vt.emit_shared != nil || str_len(vt.object_ext) == 0) {
            ret R.err[R.Void, str](errf("mach.lang.target.of: an artifact object format has a contradictory capability group",
                "mach.lang.target.of: artifact format '{}' must declare only a writer and a nonempty extension", vt.name));
        }
    } or (vt.produces_image) {
        if (!vt.links_from_image || vt.emit_object == nil || vt.parse_object == nil
            || vt.emit_exec == nil || vt.emit_exec_image == nil) {
            ret R.err[R.Void, str](errf("mach.lang.target.of: a direct-image object format has an incomplete capability group",
                "mach.lang.target.of: direct-image format '{}' must declare object write/parse and file/in-memory executable emission", vt.name));
        }
    } or (vt.links_from_image) {
        if (vt.emit_object == nil || vt.parse_object == nil || vt.emit_exec == nil
            || vt.emit_exec_image != nil) {
            ret R.err[R.Void, str](errf("mach.lang.target.of: a linker object format has an incomplete capability group",
                "mach.lang.target.of: linker format '{}' must declare object write/parse and file executable emission without direct-image emission", vt.name));
        }
    } or {
        ret R.err[R.Void, str](errf("mach.lang.target.of: object format declares no supported capability group",
            "mach.lang.target.of: object format '{}' is neither an artifact, direct-image, nor linker format", vt.name));
    }
    if (vt.emit_dyn_exec != nil && vt.emit_exec == nil) {
        ret R.err[R.Void, str]("mach.lang.target.of: dynamic executable emission requires ordinary executable emission");
    }
    if (vt.emit_shared != nil && !vt.links_from_image) {
        ret R.err[R.Void, str]("mach.lang.target.of: shared-library emission requires linker image support");
    }
    if (vt.header_in_first_segment != (vt.header_span != nil)) {
        ret R.err[R.Void, str]("mach.lang.target.of: first-segment header placement requires exactly one header-span hook");
    }
    if (vt.covers_isa_count > OF_ISA_MAX) {
        ret R.err[R.Void, str]("mach.lang.target.of: instruction-set coverage exceeds the descriptor capacity");
    }
    if (vt.covers_isa_any && vt.covers_isa_count != 0) {
        ret R.err[R.Void, str]("mach.lang.target.of: universal and explicit instruction-set coverage are exclusive");
    }
    var ci: u32 = 0;
    for (ci < vt.covers_isa_count) {
        if (vt.covers_isas[ci] == arch.UNKNOWN) {
            ret R.err[R.Void, str]("mach.lang.target.of: instruction-set coverage contains the unknown id");
        }
        var cj: u32 = 0;
        for (cj < ci) {
            if (vt.covers_isas[cj] == vt.covers_isas[ci]) {
                ret R.err[R.Void, str]("mach.lang.target.of: instruction-set coverage contains a duplicate id");
            }
            cj = cj + 1;
        }
        ci = ci + 1;
    }

    val entry: *OfVTable = ?reg.entries[reg.count];
    @entry = @vt;
    entry.name = nil;
    entry.object_ext = nil;
    entry.default_debug = nil;
    entry.shared_input_ext = nil;
    entry.import_address_prefix = nil;
    val name_r: R.Result[str, str] = own_registry_str(?reg.alloc, vt.name);
    if (R.is_err[str, str](name_r)) { release_of_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](name_r)); }
    entry.name = R.unwrap_ok[str, str](name_r);
    val object_ext_r: R.Result[str, str] = own_registry_str(?reg.alloc, vt.object_ext);
    if (R.is_err[str, str](object_ext_r)) { release_of_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](object_ext_r)); }
    entry.object_ext = R.unwrap_ok[str, str](object_ext_r);
    val default_debug_r: R.Result[str, str] = own_registry_str(?reg.alloc, vt.default_debug);
    if (R.is_err[str, str](default_debug_r)) { release_of_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](default_debug_r)); }
    entry.default_debug = R.unwrap_ok[str, str](default_debug_r);
    val shared_ext_r: R.Result[str, str] = own_registry_str(?reg.alloc, vt.shared_input_ext);
    if (R.is_err[str, str](shared_ext_r)) { release_of_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](shared_ext_r)); }
    entry.shared_input_ext = R.unwrap_ok[str, str](shared_ext_r);
    val import_prefix_r: R.Result[str, str] = own_registry_str(?reg.alloc, vt.import_address_prefix);
    if (R.is_err[str, str](import_prefix_r)) { release_of_entry(reg, entry); ret R.err[R.Void, str](R.unwrap_err[str, str](import_prefix_r)); }
    entry.import_address_prefix = R.unwrap_ok[str, str](import_prefix_r);
    reg.count = reg.count + 1;
    ret R.ok_void[str]();
}

pub fun lookup(reg: *OfRegistry, name: str) O.Option[*OfVTable] {
    if (reg == nil || reg.count > OF_REGISTRY_CAP) { ret O.none[*OfVTable](); }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret O.some[*OfVTable](?reg.entries[i]); }
        i = i + 1;
    }
    ret O.none[*OfVTable]();
}

pub fun registered_count(reg: *OfRegistry) u32 {
    if (reg == nil || reg.count > OF_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun registered(reg: *OfRegistry, idx: u32) O.Option[*OfVTable] {
    if (reg == nil || reg.count > OF_REGISTRY_CAP || idx >= reg.count) { ret O.none[*OfVTable](); }
    ret O.some[*OfVTable](?reg.entries[idx]);
}

pub val DBG_UNKNOWN:  u32 = 0;
pub val DBG_DWARF:    u32 = 1;
pub val DBG_CODEVIEW: u32 = 2;

pub rec DebugProduceRequest {
    program:          debug_input.DebugProgram;
    image:            *ObjectImage;
    rows:             *debug_input.LineRow;
    row_count:        u32;
    varlocs:          *debug_input.VarLoc;
    varloc_count:     u32;
    inline_pcs:       *debug_input.InlinePc;
    inline_pc_count:  u32;
    producer:         intern.StrId;
    comp_dir:         intern.StrId;
    text_section:     u32;
}

pub def DebugProduceFn: fun(*DebugProduceRequest) R.Result[R.Void, str];
pub def DebugSupportsFn: fun(*debug_input.DebugTarget) bool;

pub rec DebugVTable {
    id:      u32;
    name:    str;
    produce: DebugProduceFn;
    supports: DebugSupportsFn;
}

val DEBUG_REGISTRY_CAP: u32 = 4;

pub rec DebugRegistry {
    entries: [4]DebugVTable;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

pub fun debug_registry_init() DebugRegistry {
    var reg: DebugRegistry;
    reg.alloc_ready = O.is_none[str](page.make(?reg.alloc));
    var i:   u32 = 0;
    for (i < DEBUG_REGISTRY_CAP) {
        reg.entries[i].id = DBG_UNKNOWN;
        reg.entries[i].name = nil;
        reg.entries[i].produce = nil;
        reg.entries[i].supports = nil;
        i = i + 1;
    }
    reg.count = 0;
    ret reg;
}

pub fun debug_registry_dnit(reg: *DebugRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > DEBUG_REGISTRY_CAP) { limit = DEBUG_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        if (reg.entries[i].name != nil) {
            A.deallocate[u8](?reg.alloc, reg.entries[i].name::*u8,
                             str_len(reg.entries[i].name) + 1);
            reg.entries[i].name = nil;
        }
        i = i + 1;
    }
    reg.count = 0;
}

fun dup_debug_id(reg: *DebugRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun debug_register(reg: *DebugRegistry, vt: *DebugVTable) R.Result[R.Void, str] {
    if (reg == nil) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug_register called with a nil registry");
    }
    if (reg.count > DEBUG_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug registry count exceeds its backing capacity");
    }
    if (vt == nil) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug_register called with a nil descriptor");
    }
    if (str_len(vt.name) == 0) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug_register called with an empty name");
    }
    if (vt.id == DBG_UNKNOWN) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug_register called with the unknown debug id");
    }
    if (vt.produce == nil || vt.supports == nil) {
        ret R.err[R.Void, str]("mach.lang.target.of: a complete debug descriptor must declare its producer and target compatibility predicate");
    }
    if (O.is_some[*DebugVTable](debug_lookup(reg, vt.name))) {
        ret R.err[R.Void, str](errf("mach.lang.target.of: a debug model is already registered under this name",
            "mach.lang.target.of: a debug model named '{}' is already registered", vt.name));
    }
    if (dup_debug_id(reg, vt.id)) {
        ret R.err[R.Void, str](errf("mach.lang.target.of: a debug model is already registered under this id",
            "mach.lang.target.of: debug model id {} is already registered (wanted to register '{}')", vt.id, vt.name));
    }
    if (reg.count >= DEBUG_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug registry is at capacity; raise DEBUG_REGISTRY_CAP to register another debug model");
    }
    if (!reg.alloc_ready) {
        ret R.err[R.Void, str]("mach.lang.target.of: debug registry backing allocator is unavailable");
    }
    val name_r: R.Result[str, str] = str_copy(?reg.alloc, vt.name);
    if (R.is_err[str, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](name_r)); }
    reg.entries[reg.count] = @vt;
    reg.entries[reg.count].name = R.unwrap_ok[str, str](name_r);
    reg.count = reg.count + 1;
    ret R.ok_void[str]();
}

pub fun debug_registry_validate(reg: *DebugRegistry) R.Result[R.Void, str] {
    if (reg == nil) { ret R.err[R.Void, str]("mach.lang.target.of: nil debug registry"); }
    if (!reg.alloc_ready || reg.count > DEBUG_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: invalid debug registry backing or count");
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == DBG_UNKNOWN || str_len(reg.entries[i].name) == 0
            || reg.entries[i].produce == nil || reg.entries[i].supports == nil) {
            ret R.err[R.Void, str]("mach.lang.target.of: debug registry contains an invalid descriptor");
        }
        var j: u32 = 0;
        for (j < i) {
            if (reg.entries[i].id == reg.entries[j].id
                || str_equals(reg.entries[i].name, reg.entries[j].name)) {
                ret R.err[R.Void, str]("mach.lang.target.of: debug registry contains a duplicate identity");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun debug_lookup(reg: *DebugRegistry, name: str) O.Option[*DebugVTable] {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP) { ret O.none[*DebugVTable](); }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret O.some[*DebugVTable](?reg.entries[i]); }
        i = i + 1;
    }
    ret O.none[*DebugVTable]();
}

pub fun debug_registered_count(reg: *DebugRegistry) u32 {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun debug_hooks_complete(reg: *DebugRegistry) R.Result[R.Void, str] {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.of: invalid debug registry count");
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].produce == nil || reg.entries[i].supports == nil) {
            ret R.err[R.Void, str]("mach.lang.target.of: debug registry contains an incomplete descriptor");
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun debug_registered(reg: *DebugRegistry, idx: u32) O.Option[*DebugVTable] {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP || idx >= reg.count) { ret O.none[*DebugVTable](); }
    ret O.some[*DebugVTable](?reg.entries[idx]);
}

pub fun cover_isa(vt: *OfVTable, arch_id: u32) {
    if (vt.covers_isa_count >= OF_ISA_MAX) { panic("of.cover_isa: coverage list overflow\n"); }
    vt.covers_isas[vt.covers_isa_count] = arch_id;
    vt.covers_isa_count = vt.covers_isa_count + 1;
}

pub fun covers_isa(vt: *OfVTable, arch_id: u32) bool {
    if (vt.covers_isa_any) { ret true; }
    var i: u32 = 0;
    for (i < vt.covers_isa_count) {
        if (vt.covers_isas[i] == arch_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun reloc_kind_name(kind: RelocKind) str {
    if (kind == RK_ABS64)        { ret "abs64"; }
    if (kind == RK_PC32)         { ret "pc32"; }
    if (kind == RK_PLT32)        { ret "plt32"; }
    if (kind == RK_GOTPCREL)     { ret "gotpcrel"; }
    if (kind == RK_ABS32S)       { ret "abs32s"; }
    if (kind == RK_ADDR32NB)     { ret "addr32nb"; }
    if (kind == RK_PAGE21)       { ret "page21"; }
    if (kind == RK_ADD_LO12)     { ret "add_lo12"; }
    if (kind == RK_LDST8_LO12)   { ret "ldst8_lo12"; }
    if (kind == RK_LDST16_LO12)  { ret "ldst16_lo12"; }
    if (kind == RK_LDST32_LO12)  { ret "ldst32_lo12"; }
    if (kind == RK_LDST64_LO12)  { ret "ldst64_lo12"; }
    if (kind == RK_LDST128_LO12) { ret "ldst128_lo12"; }
    if (kind == RK_PCREL_HI20)   { ret "pcrel_hi20"; }
    if (kind == RK_PCREL_LO12_I) { ret "pcrel_lo12_i"; }
    if (kind == RK_PCREL_LO12_S) { ret "pcrel_lo12_s"; }
    if (kind == RK_ABS32)        { ret "abs32"; }
    if (kind == RK_SECREL32)     { ret "secrel32"; }
    if (kind == RK_SECTION)      { ret "section"; }
    if (kind == RK_GOT_PAGE21)   { ret "got_page21"; }
    if (kind == RK_GOT_LO12)     { ret "got_lo12"; }
    if (kind == RK_ABS16)        { ret "abs16"; }
    if (kind == RK_GOTPCREL_NORELAX)   { ret "gotpcrel_norelax"; }
    if (kind == RK_GOTPCREL64_NORELAX) { ret "gotpcrel64_norelax"; }
    if (kind == RK_DIFF32)             { ret "diff32"; }
    if (kind == RK_DIFF64)             { ret "diff64"; }
    if (kind == RK_JUMP26)             { ret "jump26"; }
    ret "unknown";
}

pub fun abs_kind_for_pointer_width(w: u32) R.Result[RelocKind, str] {
    if (w == 2) { ret R.ok[RelocKind, str](RK_ABS16); }
    if (w == 4) { ret R.ok[RelocKind, str](RK_ABS32); }
    if (w == 8) { ret R.ok[RelocKind, str](RK_ABS64); }
    ret R.err[RelocKind, str]("of: no absolute relocation kind for this pointer width (must be 2, 4, or 8 bytes)");
}

pub fun is_pointer_abs_kind(kind: RelocKind, w: u32) bool {
    val r: R.Result[RelocKind, str] = abs_kind_for_pointer_width(w);
    if (R.is_err[RelocKind, str](r)) { ret false; }
    ret kind == R.unwrap_ok[RelocKind, str](r);
}

pub fun reloc_symbol_name(img: *ObjectImage, r: *Relocation) intern.StrId {
    if (r.sym >= img.symbol_count) { ret intern.STR_NIL; }
    ret img.symbols[r.sym].name;
}

test "mach.lang.target.of.covers_isa:declared_and_agnostic" {
    var vt: OfVTable;
    vt.covers_isa_any   = false;
    vt.covers_isa_count = 0;
    cover_isa(?vt, arch.X86_64);
    cover_isa(?vt, arch.AARCH64);
    if (!covers_isa(?vt, arch.X86_64))  { ret 1; }
    if (!covers_isa(?vt, arch.AARCH64)) { ret 1; }
    if (covers_isa(?vt, arch.RISCV64))  { ret 1; }

    var flat: OfVTable;
    flat.covers_isa_any   = true;
    flat.covers_isa_count = 0;
    if (!covers_isa(?flat, arch.X86_64))  { ret 1; }
    if (!covers_isa(?flat, arch.RISCV64)) { ret 1; }
    ret 0;
}

fun t_debug_produce(req: *DebugProduceRequest) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_debug_supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil;
}

test "mach.lang.target.of.debug_register:install_lookup_dispatch" {
    var reg: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?reg); }
    if (debug_registered_count(?reg) != 0) { ret 1; }

    var dw: DebugVTable;
    dw.id = DBG_DWARF; dw.name = "dwarf"; dw.produce = t_debug_produce; dw.supports = t_debug_supports;
    if (R.is_err[R.Void, str](debug_register(?reg, ?dw))) { debug_registry_dnit(?reg); ret 1; }
    if (debug_registered_count(?reg) != 1) { debug_registry_dnit(?reg); ret 1; }

    val got: O.Option[*DebugVTable] = debug_lookup(?reg, "dwarf");
    if (!O.is_some[*DebugVTable](got))               { debug_registry_dnit(?reg); ret 1; }
    if (O.unwrap[*DebugVTable](got).id != DBG_DWARF) { debug_registry_dnit(?reg); ret 1; }
    if (O.unwrap[*DebugVTable](got).produce == nil)  { debug_registry_dnit(?reg); ret 1; }

    var dw2: DebugVTable;
    dw2.id = DBG_DWARF; dw2.name = "dwarf"; dw2.produce = t_debug_produce; dw2.supports = t_debug_supports;
    if (!R.is_err[R.Void, str](debug_register(?reg, ?dw2))) { debug_registry_dnit(?reg); ret 1; }
    if (debug_registered_count(?reg) != 1) { debug_registry_dnit(?reg); ret 1; }

    if (O.is_some[*DebugVTable](debug_lookup(?reg, "codeview"))) { debug_registry_dnit(?reg); ret 1; }
    debug_registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.of.debug_register:refuses_incomplete_descriptor" {
    var empty: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?empty); }
    if (R.is_err[R.Void, str](debug_hooks_complete(?empty))) { ret 1; }

    var reg: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?reg); }
    var extra: DebugVTable;
    extra.id = DBG_CODEVIEW; extra.name = "codeview"; extra.produce = nil;
    if (!R.is_err[R.Void, str](debug_register(?reg, ?extra))) { ret 1; }
    if (debug_registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.debug_registry:registries_own_their_descriptors" {
    var first: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?first); }
    var second: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?second); }
    var name: [6]u8;
    name[0] = 'd'; name[1] = 'w'; name[2] = 'a'; name[3] = 'r'; name[4] = 'f'; name[5] = 0;
    var descriptor: DebugVTable;
    descriptor.id = DBG_DWARF; descriptor.name = (?name[0])::str; descriptor.produce = t_debug_produce; descriptor.supports = t_debug_supports;
    if (R.is_err[R.Void, str](debug_register(?first, ?descriptor))) { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    if (R.is_err[R.Void, str](debug_register(?second, ?descriptor))) { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    name[0] = 'x';
    descriptor.produce = nil;
    if (R.is_err[R.Void, str](debug_hooks_complete(?first)))       { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    if (R.is_err[R.Void, str](debug_hooks_complete(?second)))      { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    val second_dwarf: O.Option[*DebugVTable] = debug_lookup(?second, "dwarf");
    if (O.is_none[*DebugVTable](second_dwarf))                   { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    if (O.unwrap[*DebugVTable](second_dwarf).produce == nil)     { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    debug_registry_dnit(?first);
    debug_registry_dnit(?second);
    ret 0;
}

test "mach.lang.target.of.abs_kind_for_pointer_width:width_ladder" {
    val r2: R.Result[RelocKind, str] = abs_kind_for_pointer_width(2);
    if (R.is_err[RelocKind, str](r2)) { ret 1; }
    if (R.unwrap_ok[RelocKind, str](r2) != RK_ABS16) { ret 1; }

    val r4: R.Result[RelocKind, str] = abs_kind_for_pointer_width(4);
    if (R.is_err[RelocKind, str](r4)) { ret 1; }
    if (R.unwrap_ok[RelocKind, str](r4) != RK_ABS32) { ret 1; }

    val r8: R.Result[RelocKind, str] = abs_kind_for_pointer_width(8);
    if (R.is_err[RelocKind, str](r8)) { ret 1; }
    if (R.unwrap_ok[RelocKind, str](r8) != RK_ABS64) { ret 1; }

    if (!R.is_err[RelocKind, str](abs_kind_for_pointer_width(3)))  { ret 1; }
    if (!R.is_err[RelocKind, str](abs_kind_for_pointer_width(16))) { ret 1; }
    if (!R.is_err[RelocKind, str](abs_kind_for_pointer_width(0)))  { ret 1; }
    ret 0;
}

test "mach.lang.target.of.is_pointer_abs_kind:agrees_with_selector_and_rejects_others" {
    if (!is_pointer_abs_kind(RK_ABS16, 2)) { ret 1; }
    if (!is_pointer_abs_kind(RK_ABS32, 4)) { ret 1; }
    if (!is_pointer_abs_kind(RK_ABS64, 8)) { ret 1; }

    if (is_pointer_abs_kind(RK_ABS64, 2)) { ret 1; }
    if (is_pointer_abs_kind(RK_ABS16, 8)) { ret 1; }
    if (is_pointer_abs_kind(RK_ABS32, 8)) { ret 1; }
    if (is_pointer_abs_kind(RK_ABS64, 4)) { ret 1; }

    if (is_pointer_abs_kind(RK_PC32, 2)) { ret 1; }
    if (is_pointer_abs_kind(RK_PC32, 4)) { ret 1; }
    if (is_pointer_abs_kind(RK_PC32, 8)) { ret 1; }

    if (is_pointer_abs_kind(RK_ABS64, 3)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.subsystem_catalog:complete_unique_ordered_roundtrip" {
    if (SUBSYSTEM_CATALOG_VERSION != 1) { ret 1; }
    if (SUBSYSTEM_N != SUBSYSTEM_GUI::usize + 1) { ret 1; }

    var seen: [SUBSYSTEM_N]bool;
    var i: usize = 0;
    for (i < SUBSYSTEM_N) { seen[i] = false; i = i + 1; }

    i = 0;
    for (i < SUBSYSTEM_N) {
        val spec: *SubsystemSpec = ?SUBSYSTEMS[i];
        if (spec.subsystem::usize >= SUBSYSTEM_N) { ret 1; }
        if (seen[spec.subsystem::usize])          { ret 1; }
        if (str_equals(spec.spelling, ""))        { ret 1; }
        if (spec.fingerprint_tag != (i + 1)::u8)  { ret 1; }
        if (!str_equals(subsystem_name(spec.subsystem), spec.spelling)) { ret 1; }
        if (subsystem_fingerprint_tag(spec.subsystem) != spec.fingerprint_tag) { ret 1; }
        seen[spec.subsystem::usize] = true;

        var j: usize = 0;
        for (j < i) {
            val prior: *SubsystemSpec = ?SUBSYSTEMS[j];
            if (prior.subsystem == spec.subsystem)             { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.spelling, spec.spelling))     { ret 1; }
            j = j + 1;
        }

        val parsed: O.Option[Subsystem] = subsystem_from_name(spec.spelling);
        if (O.is_none[Subsystem](parsed))                   { ret 1; }
        if (O.unwrap[Subsystem](parsed) != spec.subsystem)  { ret 1; }
        i = i + 1;
    }

    if (O.is_some[Subsystem](subsystem_from_name("")))        { ret 1; }
    if (O.is_some[Subsystem](subsystem_from_name("windows"))) { ret 1; }
    if (!str_equals(subsystem_name(255::Subsystem), "unknown")) { ret 1; }
    if (subsystem_fingerprint_tag(255::Subsystem) != 0)         { ret 1; }

    i = 0;
    for (i < SUBSYSTEM_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun t_of_emit_object(vt: *ObjectTarget, img: *ObjectImage, destination: *publication.Destination) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_of_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, vt: *ObjectTarget,
                   segs: *LoadSegment, seg_count: u32, entry: u64, load_base: u64, image_base: u64,
                   funcs: *ExecFunction, func_count: u32, secs: *Section, sec_count: u32,
                   debug_secs: *Section, debug_sec_count: u32, syms: *SymtabEntry, sym_count: u32,
                   destination: *publication.Destination, out_name: *u8, opts: ImageOptions) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_of_parse(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8,
               buf_size: usize, out: *ObjectImage) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

fun t_of_emit_image(alloc: *A.Allocator, segs: *LoadSegment, seg_count: u32,
                    entry: u64, base: *u64, size: *usize) R.Result[*u8, str] {
    ret R.ok[*u8, str](nil);
}

fun t_artifact(id: u32, name: str) OfVTable {
    ret artifact_vtable(id, name, "o", t_of_emit_object);
}

fun t_linker(id: u32, name: str) OfVTable {
    ret linker_vtable(id, name, "o", t_of_emit_object, t_of_parse, t_of_emit_exec);
}

fun t_direct(id: u32, name: str) OfVTable {
    ret direct_image_vtable(id, name, "", t_of_emit_object, t_of_parse,
                            t_of_emit_exec, t_of_emit_image);
}

test "mach.lang.target.of.register:rejects_nil_empty_name_and_missing_hooks" {
