pub def Subsystem: u8;

pub val SUBSYSTEM_CONSOLE: Subsystem = 0;
pub val SUBSYSTEM_GUI:     Subsystem = 1;

rec SubsystemSpec {
    subsystem:       Subsystem;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val SUBSYSTEM_CATALOG_VERSION: u8 = 1;

val SUBSYSTEM_N: usize = 2;
val SUBSYSTEMS: [SUBSYSTEM_N]SubsystemSpec = [SUBSYSTEM_N]SubsystemSpec{
    SubsystemSpec{ subsystem: SUBSYSTEM_CONSOLE, spelling: "console", fingerprint_tag: 1 },
    SubsystemSpec{ subsystem: SUBSYSTEM_GUI,     spelling: "gui",     fingerprint_tag: 2 },
};

fun subsystem_spec(s: Subsystem) *SubsystemSpec {
    var i: usize = 0;
    for (i < SUBSYSTEM_N) {
        if (SUBSYSTEMS[i].subsystem == s) { ret ?SUBSYSTEMS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun subsystem_from_name(name: str) opt[Subsystem] {
    var i: usize = 0;
    for (i < SUBSYSTEM_N) {
        if (str_equals(SUBSYSTEMS[i].spelling, name)) { ret opt[Subsystem].some{SUBSYSTEMS[i].subsystem}; }
        i = i + 1;
    }
    ret opt[Subsystem].none{};
}

pub fun subsystem_name(s: Subsystem) str {
    val spec: *SubsystemSpec = subsystem_spec(s);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun subsystem_fingerprint_tag(s: Subsystem) u8 {
    val spec: *SubsystemSpec = subsystem_spec(s);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

