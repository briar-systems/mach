#[testing]
val T_X86_64: [1]u32 = [1]u32{catalog_arch.X86_64};

#[testing]
val T_UNKNOWN_ISA: [1]u32 = [1]u32{catalog_arch.UNKNOWN};

#[testing]
val T_X86_64_TWICE: [2]u32 = [2]u32{catalog_arch.X86_64, catalog_arch.X86_64};

test validate__rejects_nil_empty_name_and_missing_hooks {
    if (!refused(nil)) { ret 1; }
    var no_name: OfVTable = t_direct(OF_RAW, "");
    if (!refused(?no_name)) { ret 2; }
    var unknown: OfVTable = t_direct(OF_UNKNOWN, "unknown");
    if (!refused(?unknown)) { ret 3; }
    var no_hooks: OfVTable = OfVTable{id: OF_RAW, name: "nohooks", object_suffix: ".raw", default_debug: "", shared_input_ext: "", import_address_prefix: ""};
    if (!refused(?no_hooks)) { ret 4; }
    var unset: OfVTable = t_linker(1, "unset");
    unset.default_debug = nil;
    if (!refused(?unset)) { ret 5; }
    var untagged: OfVTable = t_linker(1, "untagged");
    untagged.fingerprint_tag = 0;
    if (!refused(?untagged)) { ret 6; }
    var undotted: OfVTable = t_linker(1, "undotted");
    undotted.object_suffix = "o";
    if (!refused(?undotted)) { ret 7; }
    ret 0;
}

test validate__accepts_each_complete_output_shape {
    var artifact: OfVTable = t_artifact(1, "artifact");
    var linker:   OfVTable = t_linker(2, "linker");
    var direct:   OfVTable = t_direct(3, "direct");
    if (refused(?artifact)) { ret 1; }
    if (refused(?linker))   { ret 2; }
    if (refused(?direct))   { ret 3; }
    ret 0;
}

test validate__rejects_malformed_output_shapes {
    var artifact: OfVTable = t_artifact(1, "artifact_bad");
    artifact.object_suffix = "";
    if (!refused(?artifact)) { ret 1; }
    artifact              = t_artifact(1, "artifact_crossed");
    artifact.parse_object = t_of_parse;
    if (!refused(?artifact)) { ret 2; }

    var direct: OfVTable = t_direct(2, "direct_bad");
    direct.links_from_image = false;
    if (!refused(?direct)) { ret 3; }
    direct             = t_direct(2, "direct_writer");
    direct.object_emit = nil;
    if (!refused(?direct)) { ret 4; }
    direct              = t_direct(2, "direct_parser");
    direct.parse_object = nil;
    if (!refused(?direct)) { ret 5; }
    direct            = t_direct(2, "direct_file");
    direct.image_emit = nil;
    if (!refused(?direct)) { ret 6; }
    direct                = t_direct(2, "direct_dynamic");
    direct.writes_dynamic = true;
    if (!refused(?direct)) { ret 7; }

    var linker: OfVTable = t_linker(3, "linker_writer");
    linker.object_emit = nil;
    if (!refused(?linker)) { ret 8; }
    linker              = t_linker(3, "linker_parser");
    linker.parse_object = nil;
    if (!refused(?linker)) { ret 9; }
    linker            = t_linker(3, "linker_file");
    linker.image_emit = nil;
    if (!refused(?linker)) { ret 10; }
    linker               = t_linker(3, "linker_crossed");
    linker.writes_shared = true;
    if (refused(?linker)) { ret 11; }

    var none: OfVTable = OfVTable{id: 4, name: "none", object_suffix: "", default_debug: "", shared_input_ext: "", import_address_prefix: ""};
    if (!refused(?none)) { ret 12; }
    ret 0;
}

test validate__rejects_malformed_header_group {
    var vt: OfVTable = t_linker(1, "header_flag");
    vt.header_in_first_segment = true;
    if (!refused(?vt)) { ret 1; }
    vt             = t_linker(1, "header_hook");
    vt.header_span = t_header_span;
    if (!refused(?vt)) { ret 2; }
    ret 0;
}

test validate__rejects_malformed_isa_coverage {
    var vt: OfVTable = t_direct(1, "coverage_storage");
    vt.covers_isa_count = 1;
    if (!refused(?vt)) { ret 1; }
    vt                  = t_direct(1, "coverage_mixed");
    vt.covers_isa_any   = true;
    vt.covers_isa_count = 1;
    vt.covers_isas      = ?T_X86_64[0];
    if (!refused(?vt)) { ret 2; }
    vt                  = t_direct(1, "coverage_unknown");
    vt.covers_isa_count = 1;
    vt.covers_isas      = ?T_UNKNOWN_ISA[0];
    if (!refused(?vt)) { ret 3; }
    vt                  = t_direct(1, "coverage_duplicate");
    vt.covers_isa_count = 2;
    vt.covers_isas      = ?T_X86_64_TWICE[0];
    if (!refused(?vt)) { ret 4; }
    ret 0;
}

#[testing]
fun t_header_span(shape: *HeaderShape, page_size: u64) u64 {
    ret page_size;
}

fun image_symbol_index(o: *ObjectImage, name: intern.StrId) u32 {
    if (intern.str_is_nil(name)) { ret SYMBOL_NONE; }
    var i: u32 = 0;
    for (i < o.symbol_count) {
        if (intern.str_same(o.symbols[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret SYMBOL_NONE;
}

pub rec DeferredReloc {
    section:      SectionId;
    offset:       u32;
    kind:         RelocKind;
    name:         intern.StrId;
    addend:       i64;
    extern_flags: u32;
    pair:         u32;
    inst_end:     u8;
    origin:       RelocOrigin;
}

pub rec DeferredRelocs {
    alloc: *A.Allocator;
    items: *DeferredReloc;
    count: u32;
    cap:   u32;
}

pub fun deferred_init(a: *A.Allocator) DeferredRelocs {
    var d: DeferredRelocs;
    d.alloc = a;
    d.items = nil;
    d.count = 0;
    d.cap   = 0;
    ret d;
}

pub fun deferred_dnit(d: *DeferredRelocs) {
    if (d.items != nil && d.cap > 0) {
        A.deallocate[DeferredReloc](d.alloc, d.items, d.cap::usize);
    }
    d.items = nil;
    d.count = 0;
    d.cap   = 0;
}

fun deferred_push(d: *DeferredRelocs, rec: DeferredReloc) err[fail.Fail] {
    if (d.count == d.cap) {
        val grown: err[A.Error] = growth.reserve[DeferredReloc](d.alloc, ?d.items, ?d.cap, d.count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    d.items[d.count] = rec;
    d.count          = d.count + 1;
    ret err[fail.Fail].ok{};
}

# queues a relocation the target's seam can encode in a section of
# `section_kind`, to bind once the image's symbols are known
pub fun defer_relocation(d: *DeferredRelocs, rec: DeferredReloc, caps: *RelocationCapabilities,
    section_kind: SectionKind, codegen_image: bool) err[fail.Fail] {
    if (caps == nil || caps.traits == nil) {
        ret err[fail.Fail].err{fail.message("codegen: target cannot describe relocations")};
    }
    val tr: res[RelocTraits, RelocError] = caps.traits(rec.kind, section_kind, codegen_image);
    if (sel tr.err) {
        ret err[fail.Fail].err{fail.message("codegen: relocation kind is not supported by the selected target")};
    }
    ret deferred_push(d, rec);
}

fun flush_deferred_consume(d: *DeferredRelocs, flushed: u32) {
    if (flushed == 0) { ret; }
    var i: u32 = flushed;
    for (i < d.count) {
        d.items[i - flushed] = d.items[i];
        i                    = i + 1;
    }
    d.count = d.count - flushed;
}

pub fun flush_deferred(o: *ObjectImage, d: *DeferredRelocs) err[fail.Fail] {
    val image_base: u32 = o.reloc_count;
    var i:          u32 = 0;
    for (i < d.count) {
        val pend: *DeferredReloc = ?d.items[i];
        if (intern.str_is_nil(pend.name)) {
            flush_deferred_consume(d, i);
            ret err[fail.Fail].err{fail.message("codegen: relocation has no target symbol")};
        }

        var sym_ix: u32 = image_symbol_index(o, pend.name);
        if (sym_ix == SYMBOL_NONE) {
            var ext: Symbol;
            ext.name     = pend.name;
            ext.section  = external_section();
            ext.offset   = 0;
            ext.size     = 0;
            ext.flags    = pend.extern_flags;
            ext.fallback = SYMBOL_NONE;
            ext.align    = 1;
            val sa: res[u32, fail.Fail] = symbol_add(o, ext);
            if (sel sa.err) {
                flush_deferred_consume(d, i);
                ret err[fail.Fail].err{sa.err};
            }
            sym_ix = sa.ok;
        }

        var rel: Relocation;
        rel.section  = pend.section;
        rel.offset   = pend.offset;
        rel.kind     = pend.kind;
        rel.sym      = sym_ix;
        rel.addend   = pend.addend;
        rel.sym2     = SYMBOL_NONE;
        rel.pair     = 0;
        rel.inst_end = pend.inst_end;
        rel.origin   = pend.origin;
        if (pend.pair != 0) {
            if (pend.pair > d.count) {
                flush_deferred_consume(d, i);
                ret err[fail.Fail].err{fail.message("codegen: relocation pair index is outside the deferred batch")};
            }
            rel.pair = image_base + pend.pair;
        }
        val ar: err[fail.Fail] = add_relocation(o, rel);
        if (sel ar.err) {
            flush_deferred_consume(d, i);
            ret ar;
        }

        i = i + 1;
    }
    d.count = 0;
    ret err[fail.Fail].ok{};
}

fun remap_name(id: intern.StrId, remap: intern.Remap) intern.StrId {
    if (intern.str_is_nil(id))                        { ret id; }
    if (intern.str_index(id)::usize < remap.base_len) { ret id; }
    ret remap.ids[intern.str_index(id)::usize - remap.base_len];
}

fun remap_name_valid(src: *intern.Interner, dst: *intern.Interner, id: intern.StrId,
    remap: intern.Remap) bool {
    if (intern.str_is_nil(id)) { ret true; }
    val source_name: opt[str] = intern.get(src, id);
    if (sel source_name.none) { ret false; }

    var mapped: intern.StrId = id;
    if (intern.str_index(id)::usize >= remap.base_len) {
        val local: usize = intern.str_index(id)::usize - remap.base_len;
        if (remap.ids == nil || local >= remap.len) { ret false; }
        mapped = remap.ids[local];
        if (intern.str_is_nil(mapped)) { ret false; }
    }
    val destination_name: opt[str] = intern.get(dst, mapped);
    ret sel destination_name.some
        && str_equals(source_name.some, destination_name.some);
}

fun rehome_names_valid(src: *ObjectImage, dst_interner: *intern.Interner,
    remap: intern.Remap) bool {
    if ((remap.ids == nil) != (remap.len == 0)) { ret false; }
    if (!remap_name_valid(src.interner, dst_interner, src.name, remap)) {
        ret false;
    }

    var i: u32 = 0;
    for (i < src.section_count) {
        if (!remap_name_valid(src.interner, dst_interner, src.sections[i].name,
            remap)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < src.symbol_count) {
        if (!remap_name_valid(src.interner, dst_interner, src.symbols[i].name,
            remap)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < src.export_request_count) {
        if (!remap_name_valid(src.interner, dst_interner, src.export_requests[i],
            remap)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < src.import_count) {
        val imp: *ImportDecl = ?src.imports[i];
        if (!remap_name_valid(src.interner, dst_interner, imp.symbol,
            remap)
            || !remap_name_valid(src.interner, dst_interner, imp.import_name,
            remap)
            || !remap_name_valid(src.interner, dst_interner, imp.library,
            remap)) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun rehome(dst_alloc: *A.Allocator, dst_interner: *intern.Interner,
    src: *ObjectImage, remap: intern.Remap) res[ObjectImage, fail.Fail] {
    if (dst_alloc == nil || dst_interner == nil) {
        ret res[ObjectImage, fail.Fail].err{fail.message("obj.rehome_remap: destination ownership is incomplete")};
    }
    val source_valid: err[fail.Fail] = validate_object_view(src);
    if (sel source_valid.err) {
        ret res[ObjectImage, fail.Fail].err{source_valid.err};
    }
    if (!rehome_names_valid(src, dst_interner, remap)) {
        ret res[ObjectImage, fail.Fail].err{fail.message("obj.rehome_remap: intern remap does not cover the source image")};
    }
    var img: ObjectImage = object_image_init(dst_alloc, dst_interner, remap_name(src.name, remap));
    img.codegen        = src.codegen;
    img.symbol_atoms   = src.symbol_atoms;
    img.machine_flags  = src.machine_flags;
    img.attributes     = nil;
    img.attributes_len = 0;
    if (src.attributes != nil && src.attributes_len > 0) {
        val ab: res[*u8, A.Error] = A.allocate[u8](dst_alloc, src.attributes_len::usize);
        if (sel ab.err) { ret res[ObjectImage, fail.Fail].err{fail.refused(ab.err)}; }
        val abuf: *u8 = ab.ok;
        memory.raw_copy(abuf::ptr, src.attributes::ptr, src.attributes_len::usize);
        img.attributes     = abuf;
        img.attributes_len = src.attributes_len;
    }

    if (src.section_count > 0) {
        val rs: res[*Section, A.Error] = A.allocate[Section](dst_alloc, src.section_count::usize);
        if (sel rs.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(rs.err)};
        }
        img.sections    = rs.ok;
        img.section_cap = src.section_count;
        var i: u32 = 0;
        for (i < src.section_count) {
            var sec: Section = src.sections[i];
            sec.name = remap_name(src.sections[i].name, remap);
            if (src.sections[i].bytes != nil && src.sections[i].len > 0) {
                val rb: res[*u8, A.Error] = A.allocate[u8](dst_alloc, src.sections[i].len::usize);
                if (sel rb.err) {
                    img.section_count = i;
                    object_image_dnit(?img);
                    ret res[ObjectImage, fail.Fail].err{fail.refused(rb.err)};
                }
                sec.bytes = rb.ok;
                memory.copy[u8](sec.bytes, src.sections[i].bytes, src.sections[i].len::usize);
            }
            img.sections[i]   = sec;
            img.section_count = i + 1;
            i                 = i + 1;
        }
    }

    if (src.symbol_count > 0) {
        val ry: res[*Symbol, A.Error] = A.allocate[Symbol](dst_alloc, src.symbol_count::usize);
        if (sel ry.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(ry.err)};
        }
        img.symbols    = ry.ok;
        img.symbol_cap = src.symbol_count;
        var i: u32 = 0;
        for (i < src.symbol_count) {
            var sym: Symbol = src.symbols[i];
            sym.name       = remap_name(src.symbols[i].name, remap);
            img.symbols[i] = sym;
            i              = i + 1;
        }
        img.symbol_count = src.symbol_count;
    }

    if (src.reloc_count > 0) {
        val rr: res[*Relocation, A.Error] = A.allocate[Relocation](dst_alloc, src.reloc_count::usize);
        if (sel rr.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(rr.err)};
        }
        img.relocations = rr.ok;
        img.reloc_cap   = src.reloc_count;
        memory.copy[Relocation](img.relocations, src.relocations, src.reloc_count::usize);
        img.reloc_count = src.reloc_count;
    }

    if (src.frame_count > 0) {
        val rf: res[*FrameUnwind, A.Error] = A.allocate[FrameUnwind](dst_alloc, src.frame_count::usize);
        if (sel rf.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(rf.err)};
        }
        img.frames    = rf.ok;
        img.frame_cap = src.frame_count;
        memory.copy[FrameUnwind](img.frames, src.frames, src.frame_count::usize);
        img.frame_count = src.frame_count;
    }

    if (src.indirect_count > 0) {
        val copied: res[*NativeIndirect, A.Error] = A.allocate[NativeIndirect](dst_alloc, src.indirect_count::usize);
        if (sel copied.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(copied.err)};
        }
        img.indirects      = copied.ok;
        img.indirect_cap   = src.indirect_count;
        img.indirect_count = src.indirect_count;
        memory.copy[NativeIndirect](img.indirects, src.indirects, src.indirect_count::usize);
    }

    if (src.import_count > 0) {
        val ri: res[*ImportDecl, A.Error] = A.allocate[ImportDecl](dst_alloc, src.import_count::usize);
        if (sel ri.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(ri.err)};
        }
        img.imports    = ri.ok;
        img.import_cap = src.import_count;
        var i: u32 = 0;
        for (i < src.import_count) {
            var imp: ImportDecl = src.imports[i];
            imp.symbol      = remap_name(src.imports[i].symbol, remap);
            imp.import_name = remap_name(src.imports[i].import_name, remap);
            imp.library     = remap_name(src.imports[i].library, remap);
            img.imports[i]  = imp;
            i               = i + 1;
        }
        img.import_count = src.import_count;
    }

    if (src.export_request_count > 0) {
        val rq: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](dst_alloc, src.export_request_count::usize);
        if (sel rq.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(rq.err)};
        }
        img.export_requests    = rq.ok;
        img.export_request_cap = src.export_request_count;
        var i: u32 = 0;
        for (i < src.export_request_count) {
            img.export_requests[i] = remap_name(src.export_requests[i], remap);
            i                      = i + 1;
        }
        img.export_request_count = src.export_request_count;
    }

    if (src.cache_record != nil && src.cache_record_len > 0) {
        val rr: res[*u8, A.Error] = A.allocate[u8](dst_alloc, src.cache_record_len::usize);
        if (sel rr.err) {
            object_image_dnit(?img);
            ret res[ObjectImage, fail.Fail].err{fail.refused(rr.err)};
        }
        memory.raw_copy(rr.ok::ptr, src.cache_record::ptr, src.cache_record_len::usize);
        img.cache_record     = rr.ok;
        img.cache_record_len = src.cache_record_len;
    }

    val image_valid: err[fail.Fail] = validate_owned_object(?img);
    if (sel image_valid.err) {
        val reason: fail.Fail = fail.as_internal(image_valid.err);
        object_image_dnit(?img);
        ret res[ObjectImage, fail.Fail].err{reason};
    }
    ret res[ObjectImage, fail.Fail].ok{img};
}

#[testing]
fun t_obj_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.add(itn, s);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

test install_section__consumes_payload_on_success_and_failure {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val alloc: *A.Allocator    = T.allocator_of(?t);
    var itn:   intern.Interner = intern.init(alloc);

    val ir:  ObjectImage = object_image_init(alloc, ?itn, t_obj_intern(?itn, "m"));
    var img: ObjectImage = ir;

    val br: res[*u8, A.Error] = A.allocate[u8](alloc, 16::usize);
    if (sel br.err) {
        object_image_dnit(?img);
        intern.dnit(?itn);
        ret 1;
    }
    var sec: Section;
    sec.name  = t_obj_intern(?itn, ".data");
    sec.kind  = SK_DATA;
    sec.bytes = br.ok;
    sec.len   = 16;
    sec.align = 8;
    sec.flags = 0;

    T.fail_at_ordinal(?t, T.attempt_count(?t) + 1);
    val installed: res[u32, fail.Fail] = section_install(?img, ?sec);
    T.clear_failure(?t);

    var bad: i32 = 0;
    if (sel installed.ok)                 { bad = 1; }
    if (img.section_count != 0)           { bad = 2; }
    if (sec.bytes != nil || sec.len != 0) { bad = 3; }

    val br2: res[*u8, A.Error] = A.allocate[u8](alloc, 16::usize);
    if (sel br2.err) {
        object_image_dnit(?img);
        intern.dnit(?itn);
        ret 1;
    }
    sec.bytes = br2.ok;
    sec.len   = 16;
    val installed2: res[u32, fail.Fail] = section_install(?img, ?sec);
    if (sel installed2.err)               { bad = 4; }
    if (img.section_count != 1)           { bad = 5; }
    if (sec.bytes != nil || sec.len != 0) { bad = 6; }
    object_image_dnit(?img);
    intern.dnit(?itn);
    if (T.size_mismatch_count(?t) != 0 || T.double_free_count(?t) != 0) { bad = 7; }
    if (T.leaked(?t))                                                   { bad = 8; }
    ret bad;
}

test rehome__refuses_a_bad_map_and_copies_imports {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val alloc:     *A.Allocator    = T.allocator_of(?t);
    var base:      intern.Interner = intern.init(alloc);
    val base_name: intern.StrId    = t_obj_intern(?base, "base");
    val base_len:  usize           = intern.count(?base);
    var child:     intern.Interner = intern.child_init(?base, alloc);

    val ir:  ObjectImage = object_image_init(alloc, ?child, t_obj_intern(?child, "src"));
    var src: ObjectImage = ir;

    val ri: res[*ImportDecl, A.Error] = A.allocate[ImportDecl](alloc, 1::usize);
    if (sel ri.err) { ret 1; }
    src.imports                = ri.ok;
    src.import_cap             = 1;
    src.imports[0].symbol      = t_obj_intern(?child, "sym");
    src.imports[0].import_name = t_obj_intern(?child, "sym@0");
    src.imports[0].library     = t_obj_intern(?child, "lib.so");
    src.imports[0].ordinal     = 0;
    src.imports[0].by_name     = true;
    src.imports[0].is_code     = true;
    src.import_count           = 1;

    val remap_r: res[intern.Remap, A.Error] = intern.child_reintern(?child, alloc);
    if (sel remap_r.err) {
        object_image_dnit(?src);
        ret 1;
    }
    var remap: intern.Remap = remap_r.ok;

    var short_map: intern.Remap = remap;
    short_map.len = 1;
    val short: res[ObjectImage, fail.Fail] =
        rehome(alloc, ?base, ?src, short_map);
    if (sel short.ok) {
        var escaped: ObjectImage = short.ok;
        object_image_dnit(?escaped);
        object_image_dnit(?src);
        ret 1;
    }

    val original: intern.StrId = remap.ids[0];
    remap.ids[0] = base_name;
    val wrong: res[ObjectImage, fail.Fail] =
        rehome(alloc, ?base, ?src, remap);
    remap.ids[0] = original;
    if (sel wrong.ok) {
        var escaped: ObjectImage = wrong.ok;
        object_image_dnit(?escaped);
        object_image_dnit(?src);
        ret 1;
    }

    val rr: res[ObjectImage, fail.Fail] =
        rehome(alloc, ?base, ?src, remap);
    if (sel rr.err) {
        object_image_dnit(?src);
        ret 1;
    }
    var dst: ObjectImage = rr.ok;

    if (dst.import_count != 1) {
        object_image_dnit(?src);
        object_image_dnit(?dst);
        ret 1;
    }
    if (dst.imports == src.imports) {
        object_image_dnit(?src);
        object_image_dnit(?dst);
        ret 1;
    }
    if (!dst.imports[0].by_name) {
        object_image_dnit(?src);
        object_image_dnit(?dst);
        ret 1;
    }
    if (!dst.imports[0].is_code) {
        object_image_dnit(?src);
        object_image_dnit(?dst);
        ret 1;
    }
    if (!intern.str_same(dst.imports[0].symbol, remap.ids[intern.str_index(src.imports[0].symbol)::usize - base_len])) {
        object_image_dnit(?src);
        object_image_dnit(?dst);
        ret 1;
    }

    object_image_dnit(?src);
    object_image_dnit(?dst);
    intern.remap_dnit(alloc, ?remap);
    intern.dnit(?child);
    intern.dnit(?base);

    if (!T.clean(?t)) { ret 1; }
    ret 0;
}

test flush_deferred__sym2_set_and_retry_consumes_flushed_prefix {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val alloc: *A.Allocator    = T.allocator_of(?t);
    var itn:   intern.Interner = intern.init(alloc);

    val ir:  ObjectImage = object_image_init(alloc, ?itn, t_obj_intern(?itn, "m"));
    var img: ObjectImage = ir;

    val name_a: intern.StrId = t_obj_intern(?itn, "sym_a");
    val name_b: intern.StrId = t_obj_intern(?itn, "sym_b");

    var sym_a: Symbol;
    sym_a.name    = name_a;
    sym_a.section = section_id(0);
    sym_a.offset  = 0;
    sym_a.size    = 0;
    sym_a.flags   = 0;
    val symbol_add_r: res[u32, fail.Fail] = symbol_add(?img, sym_a);
    if (sel symbol_add_r.err) {
        object_image_dnit(?img);
        ret 1;
    }
    var filler: Symbol = sym_a;
    filler.name = intern.STR_NIL;
    var fill_i: u32 = 1;
    for (fill_i < 8) {
        val symbol_add_r2: res[u32, fail.Fail] = symbol_add(?img, filler);
        if (sel symbol_add_r2.err) {
            object_image_dnit(?img);
            ret 1;
        }
        fill_i = fill_i + 1;
    }

    var deferred: DeferredRelocs = deferred_init(alloc);
    var rec_a:    DeferredReloc;
    rec_a.section      = section_id(0);
    rec_a.offset       = 0;
    rec_a.kind         = RK_ABS64;
    rec_a.name         = name_a;
    rec_a.addend       = 0;
    rec_a.extern_flags = 0;
    val defer_relocation_r: err[fail.Fail] = deferred_push(?deferred, rec_a);
    if (sel defer_relocation_r.err) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    var rec_b: DeferredReloc;
    rec_b.section      = section_id(0);
    rec_b.offset       = 4;
    rec_b.kind         = RK_ABS64;
    rec_b.name         = name_b;
    rec_b.addend       = 0;
    rec_b.extern_flags = 0;
    val defer_relocation_r2: err[fail.Fail] = deferred_push(?deferred, rec_b);
    if (sel defer_relocation_r2.err) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }

    T.fail_at_ordinal(?t, T.attempt_count(?t) + 2);
    val r1: err[fail.Fail] = flush_deferred(?img, ?deferred);
    if (sel r1.ok) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    if (deferred.count != 1) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    if (img.reloc_count != 1) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }

    T.clear_failure(?t);
    val r2: err[fail.Fail] = flush_deferred(?img, ?deferred);
    if (sel r2.err) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    if (deferred.count != 0) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    if (img.reloc_count != 2) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    if (img.relocations[0].sym2 != SYMBOL_NONE) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }
    if (img.relocations[1].sym2 != SYMBOL_NONE) {
        deferred_dnit(?deferred);
        object_image_dnit(?img);
        ret 1;
    }

    deferred_dnit(?deferred);
    object_image_dnit(?img);
    intern.dnit(?itn);

    if (!T.clean(?t)) { ret 1; }
    ret 0;
}

test install_section__refuses_count_overflow_before_reallocating {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 5; }
    fin { T.dnit(?t); }
    T.fail_from_ordinal(?t, 1);
    val alloc: *A.Allocator    = T.allocator_of(?t);
    var itn:   intern.Interner = intern.init(alloc);

    val ir:    ObjectImage = object_image_init(alloc, ?itn, t_obj_intern(?itn, "m"));
    var img:   ObjectImage = ir;
    var dummy: Section;
    img.sections      = ?dummy;
    img.section_count = 0xFFFFFFFF;
    img.section_cap   = 0xFFFFFFFF;

    var sec: Section;
    sec.name  = t_obj_intern(?itn, ".text");
    sec.kind  = SK_TEXT;
    sec.bytes = nil;
    sec.len   = 0;
    sec.align = 1;
    val before: usize               = T.attempt_count(?t);
    val r:      res[u32, fail.Fail] = section_install(?img, ?sec);

    var bad: i32 = 0;
    if (sel r.ok)                        { bad = 1; }
    if (T.attempt_count(?t) != before)   { bad = 2; }
    if (img.section_count != 0xFFFFFFFF) { bad = 4; }

    intern.dnit(?itn);
    ret bad;
}

test defer_relocation__refuses_capacity_overflow_before_reallocating {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 5; }
    fin { T.dnit(?t); }
    T.fail_from_ordinal(?t, 1);
    val alloc: *A.Allocator = T.allocator_of(?t);

    var d:     DeferredRelocs = deferred_init(alloc);
    var dummy: DeferredReloc;
    d.items = ?dummy;
    d.cap   = 0xFFFFFFFF;
    d.count = 0xFFFFFFFF;

    var drec: DeferredReloc;
    drec.section      = section_id(0);
    drec.offset       = 0;
    drec.kind         = RK_ABS64;
    drec.name         = intern.STR_NIL;
    drec.addend       = 0;
    drec.extern_flags = 0;
    val r: err[fail.Fail] = deferred_push(?d, drec);

    var bad: i32 = 0;
    if (sel r.ok)                 { bad = 1; }
    if (T.attempt_count(?t) != 0) { bad = 2; }
    if (d.cap != 0xFFFFFFFF)      { bad = 3; }
    ret bad;
}
