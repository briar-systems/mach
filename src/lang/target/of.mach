    ret 0;
}

test "mach.lang.target.of.register:rejects_malformed_output_shapes" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }

    var artifact: OfVTable = t_artifact(1, "artifact_bad");
    artifact.object_ext = "";
    val r_2369: err[fail.Fail] = register(?reg, ?artifact);
    if (!sel r_2369.err) { registry_dnit(?reg); ret 1; }
    artifact = t_artifact(1, "artifact_crossed");
    artifact.parse_object = t_of_parse;
    val r_2372: err[fail.Fail] = register(?reg, ?artifact);
    if (!sel r_2372.err) { registry_dnit(?reg); ret 1; }

    var direct: OfVTable = t_direct(2, "direct_bad");
    direct.links_from_image = false;
    val r_2376: err[fail.Fail] = register(?reg, ?direct);
    if (!sel r_2376.err) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_writer");
    direct.emit_object = nil;
    val r_2379: err[fail.Fail] = register(?reg, ?direct);
    if (!sel r_2379.err) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_parser");
    direct.parse_object = nil;
    val r_2382: err[fail.Fail] = register(?reg, ?direct);
    if (!sel r_2382.err) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_file");
    direct.emit_exec = nil;
    val r_2385: err[fail.Fail] = register(?reg, ?direct);
    if (!sel r_2385.err) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_memory");
    direct.emit_exec_image = nil;
    val r_2388: err[fail.Fail] = register(?reg, ?direct);
    if (!sel r_2388.err) { registry_dnit(?reg); ret 1; }

    var linker: OfVTable = t_linker(3, "linker_writer");
    linker.emit_object = nil;
    val r_2392: err[fail.Fail] = register(?reg, ?linker);
    if (!sel r_2392.err) { registry_dnit(?reg); ret 1; }
    linker = t_linker(3, "linker_parser");
    linker.parse_object = nil;
    val r_2395: err[fail.Fail] = register(?reg, ?linker);
    if (!sel r_2395.err) { registry_dnit(?reg); ret 1; }
    linker = t_linker(3, "linker_file");
    linker.emit_exec = nil;
    val r_2398: err[fail.Fail] = register(?reg, ?linker);
    if (!sel r_2398.err) { registry_dnit(?reg); ret 1; }
    linker = t_linker(3, "linker_crossed");
    linker.emit_exec_image = t_of_emit_image;
    val r_2401: err[fail.Fail] = register(?reg, ?linker);
    if (!sel r_2401.err) { registry_dnit(?reg); ret 1; }

    var none: OfVTable;
    none.id = 4; none.name = "none";
    val r_2405: err[fail.Fail] = register(?reg, ?none);
    if (!sel r_2405.err) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 0) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

