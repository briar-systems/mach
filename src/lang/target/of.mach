    internal_name:     str;
    original_filename: str;
    product_name:      str;
}

pub rec ImageOptions {
    subsystem: Subsystem;
    resources: *ResourceInfo;
    machine_flags: u32;
    attributes:     *u8;
    attributes_len: u32;
    mapped_by_loader: bool;

    stack_reserve: u64;
    stack_commit:  u64;
}

pub fun image_options_default(subsystem: Subsystem) ImageOptions {
    var opts: ImageOptions;
    opts.subsystem = subsystem;
    opts.resources = nil;
    opts.machine_flags = 0;
    opts.attributes = nil;
    opts.attributes_len = 0;
    opts.mapped_by_loader = true;
    opts.stack_reserve = 0;
    opts.stack_commit  = 0;
    ret opts;
}

pub fun image_options_flagged(subsystem: Subsystem, flags: u32) ImageOptions {
    var opts: ImageOptions = image_options_default(subsystem);
    opts.machine_flags = flags;
    ret opts;
}

pub fun effective_stack_reserve(tgt_of: *OfVTable, stated: u64) u64 {
    if (stated != 0) { ret stated; }
    if (tgt_of == nil) { ret 0; }
    ret tgt_of.default_stack_reserve;
}

