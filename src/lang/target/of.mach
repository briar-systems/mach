    if (R.is_err[R.Void, str](register(?reg, ?direct)))   { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 3) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.of.register:rejects_malformed_output_shapes" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }

    var artifact: OfVTable = t_artifact(1, "artifact_bad");
    artifact.object_ext = "";
    if (!R.is_err[R.Void, str](register(?reg, ?artifact))) { registry_dnit(?reg); ret 1; }
    artifact = t_artifact(1, "artifact_crossed");
    artifact.parse_object = t_of_parse;
    if (!R.is_err[R.Void, str](register(?reg, ?artifact))) { registry_dnit(?reg); ret 1; }

    var direct: OfVTable = t_direct(2, "direct_bad");
    direct.links_from_image = false;
    if (!R.is_err[R.Void, str](register(?reg, ?direct))) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_writer");
    direct.emit_object = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?direct))) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_parser");
    direct.parse_object = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?direct))) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_file");
    direct.emit_exec = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?direct))) { registry_dnit(?reg); ret 1; }
    direct = t_direct(2, "direct_memory");
    direct.emit_exec_image = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?direct))) { registry_dnit(?reg); ret 1; }

    var linker: OfVTable = t_linker(3, "linker_writer");
    linker.emit_object = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?linker))) { registry_dnit(?reg); ret 1; }
    linker = t_linker(3, "linker_parser");
    linker.parse_object = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?linker))) { registry_dnit(?reg); ret 1; }
    linker = t_linker(3, "linker_file");
    linker.emit_exec = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?linker))) { registry_dnit(?reg); ret 1; }
    linker = t_linker(3, "linker_crossed");
    linker.emit_exec_image = t_of_emit_image;
    if (!R.is_err[R.Void, str](register(?reg, ?linker))) { registry_dnit(?reg); ret 1; }

    var none: OfVTable;
    none.id = 4; none.name = "none";
    if (!R.is_err[R.Void, str](register(?reg, ?none))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 0) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

