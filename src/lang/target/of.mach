test "mach.lang.target.of.register:refuses_past_capacity" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var vts:   [8]OfVTable;
    var names: [8][2]u8;
    var i: u32 = 0;
    for (i < OF_REGISTRY_CAP) {
        names[i][0]  = 'a'::u8 + i::u8;
        names[i][1]  = 0;
        vts[i] = t_artifact(i + 1, (?names[i][0])::str);
        if (R.is_err[R.Void, str](register(?reg, ?vts[i]))) { registry_dnit(?reg); ret 1; }
        i = i + 1;
    }
    if (registered_count(?reg) != OF_REGISTRY_CAP) { ret 1; }

    var overflow: OfVTable = t_artifact(999, "overflow");
    if (!R.is_err[R.Void, str](register(?reg, ?overflow))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != OF_REGISTRY_CAP) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.of.debug_register:rejects_nil_empty_name_duplicate_and_capacity" {
    var reg: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?reg); }
    if (!R.is_err[R.Void, str](debug_register(nil, nil))) { ret 1; }
    if (!R.is_err[R.Void, str](debug_register(?reg, nil))) { ret 1; }

    var no_name: DebugVTable;
    no_name.id = 1; no_name.name = ""; no_name.produce = nil;
    if (!R.is_err[R.Void, str](debug_register(?reg, ?no_name))) { ret 1; }

    var unknown: DebugVTable;
    unknown.id = DBG_UNKNOWN; unknown.name = "unknown"; unknown.produce = t_debug_produce; unknown.supports = t_debug_supports;
    if (!R.is_err[R.Void, str](debug_register(?reg, ?unknown))) { ret 1; }

    var vts:   [4]DebugVTable;
    var names: [4][2]u8;
    var i: u32 = 0;
    for (i < DEBUG_REGISTRY_CAP) {
        names[i][0] = 'a'::u8 + i::u8;
        names[i][1] = 0;
        vts[i].id      = i + 1;
        vts[i].name    = (?names[i][0])::str;
        vts[i].produce = t_debug_produce;
        vts[i].supports = t_debug_supports;
        if (R.is_err[R.Void, str](debug_register(?reg, ?vts[i]))) { ret 1; }
        i = i + 1;
    }
    if (debug_registered_count(?reg) != DEBUG_REGISTRY_CAP) { ret 1; }

    if (!R.is_err[R.Void, str](debug_register(?reg, ?vts[0]))) { ret 1; }

    var overflow: DebugVTable;
    overflow.id = 999; overflow.name = "overflow"; overflow.produce = nil;
    if (!R.is_err[R.Void, str](debug_register(?reg, ?overflow))) { ret 1; }
    if (debug_registered_count(?reg) != DEBUG_REGISTRY_CAP) { ret 1; }
    ret 0;
}
