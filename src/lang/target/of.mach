fun t_debug_produce(req: *DebugProduceRequest) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_debug_supports(tgt: *mir_debug.DebugTarget) bool {
    ret tgt != nil;
}

#[testing]
fun t_debug(id: u32, name: str, shape: DebugShape, produce: DebugProduceFn, supports: DebugSupportsFn) DebugVTable {
    ret DebugVTable{id: id, name: name, shape: shape, produce: produce, supports: supports};
}

#[testing]
fun debug_refused(vt: *DebugVTable) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    val r: err[fail.Fail] = debug_validate(?alloc, vt);
    if (sel r.err) { ret true; }
    ret false;
}

test debug_validate__a_module_model_declares_no_producer {
    var module: DebugVTable = t_debug(DBG_SPIRV, "spirv", DEBUG_SHAPE_MODULE, nil, t_debug_supports);
    if (debug_refused(?module)) { ret 1; }
    var produced: DebugVTable = t_debug(DBG_CODEVIEW, "produced", DEBUG_SHAPE_MODULE, t_debug_produce, t_debug_supports);
    if (!debug_refused(?produced)) { ret 2; }
    var bare: DebugVTable = t_debug(DBG_DWARF, "dwarf", DEBUG_SHAPE_SECTIONS, nil, t_debug_supports);
    if (!debug_refused(?bare)) { ret 3; }
    var sections: DebugVTable = t_debug(DBG_DWARF, "dwarf", DEBUG_SHAPE_SECTIONS, t_debug_produce, t_debug_supports);
    if (debug_refused(?sections)) { ret 4; }

    var spv: OfVTable = OfVTable{id: OF_SPV, name: "spv", object_is_artifact: true};
    var elf: OfVTable = OfVTable{id: OF_ELF, name: "elf", links_from_image: true};
    if (debug_shape_for(?spv) != DEBUG_SHAPE_MODULE)   { ret 6; }
    if (debug_shape_for(?elf) != DEBUG_SHAPE_SECTIONS) { ret 6; }
    ret 0;
}

test debug_validate__rejects_nil_empty_name_and_unknown_id {
    if (!debug_refused(nil)) { ret 1; }
    var no_name: DebugVTable = t_debug(1, "", DEBUG_SHAPE_SECTIONS, t_debug_produce, t_debug_supports);
    if (!debug_refused(?no_name)) { ret 2; }
    var unknown: DebugVTable = t_debug(DBG_UNKNOWN, "unknown", DEBUG_SHAPE_SECTIONS, t_debug_produce, t_debug_supports);
    if (!debug_refused(?unknown)) { ret 3; }
    ret 0;
}

test span_locate__finds_the_segment_holding_the_table_whole {
    var alloc: A.Allocator;
    page.make(?alloc);
    var segs: [2]LoadSegment;
    segs[0].vaddr  = 0x1000;
    segs[0].filesz = 0x100;
    segs[0].flags  = SEG_FLAG_READ | SEG_FLAG_EXECUTE;
    segs[1].vaddr  = 0x2000;
    segs[1].filesz = 0x80;
    segs[1].flags  = SEG_FLAG_READ;

    val code: res[SpanLocation, fail.Fail] = span_locate(?alloc, TableSpan{vaddr: 0x10F0, size: 0x10}, ?segs[0], 2, true, "the PLT");
    if (sel code.err)                                   { ret 1; }
    if (code.ok.segment != 0 || code.ok.offset != 0xF0) { ret 2; }
    val data: res[SpanLocation, fail.Fail] = span_locate(?alloc, TableSpan{vaddr: 0x2040, size: 0x40}, ?segs[0], 2, false, "the GOT");
    if (sel data.err)                                   { ret 3; }
    if (data.ok.segment != 1 || data.ok.offset != 0x40) { ret 4; }

    val past: res[SpanLocation, fail.Fail] = span_locate(?alloc, TableSpan{vaddr: 0x2040, size: 0x41}, ?segs[0], 2, false, "the GOT");
    if (!sel past.err)                                                                     { ret 5; }
    if (!str_contains(fail.describe(past.err), "the GOT lies outside every load segment")) { ret 5; }
    val code_got: res[SpanLocation, fail.Fail] = span_locate(?alloc, TableSpan{vaddr: 0x1000, size: 8}, ?segs[0], 2, false, "the GOT");
    if (!sel code_got.err)                                                           { ret 6; }
    if (!str_contains(fail.describe(code_got.err), "inside the executable segment")) { ret 6; }
    val data_plt: res[SpanLocation, fail.Fail] = span_locate(?alloc, TableSpan{vaddr: 0x2000, size: 8}, ?segs[0], 2, true, "the PLT");
    if (!sel data_plt.err)                                                            { ret 7; }
    if (!str_contains(fail.describe(data_plt.err), "outside the executable segment")) { ret 7; }
    ret 0;
}

test abs_kind_for_pointer_width__width_ladder {
    val r2: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(2);
    if (sel r2.err)        { ret 1; }
    if (r2.ok != RK_ABS16) { ret 1; }
    val r4: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(4);
    if (sel r4.err)        { ret 2; }
    if (r4.ok != RK_ABS32) { ret 2; }
    val r8: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(8);
    if (sel r8.err)        { ret 3; }
    if (r8.ok != RK_ABS64) { ret 3; }
    val r3: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(3);
    if (!sel r3.err) { ret 4; }
    val r16: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(16);
    if (!sel r16.err) { ret 4; }
    val r0: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(0);
    if (!sel r0.err) { ret 4; }

    # the membership test agrees with the ladder and refuses every other pairing
    if (!is_pointer_abs_kind(RK_ABS16, 2) || !is_pointer_abs_kind(RK_ABS32, 4) || !is_pointer_abs_kind(RK_ABS64, 8)) { ret 5; }
    if (is_pointer_abs_kind(RK_ABS64, 2) || is_pointer_abs_kind(RK_ABS32, 8) || is_pointer_abs_kind(RK_ABS64, 4))    { ret 6; }
    if (is_pointer_abs_kind(RK_PC32, 4) || is_pointer_abs_kind(RK_PC32, 8) || is_pointer_abs_kind(RK_ABS64, 3))      { ret 7; }
    ret 0;
}

# writes `img` through `write` and publishes what it wrote at `path`
#[testing]
pub fun image_write(write: ImageEmitFn, img: LinkedImage, path: str) err[fail.Fail] {
    var dst: of_destination.Destination = of_destination.init(img.alloc);
    fin { of_destination.dnit(?dst); }
    # the linker names a shared library by the file it publishes
    var held: LinkedImage = img;
    if (held.product == catalog_artifact.SHARED && held.library_name == nil) { held.library_name = types_path.filename(path); }
    val written: err[fail.Fail] = write(?held, ?dst);
    if (sel written.err) { ret written; }
    ret of_destination.publish(?dst, img.interner, path, "cannot publish");
}

# writes `img` through `write` and publishes the object at `path`
#[testing]
pub fun object_write(write: ObjectEmitFn, tgt: *ObjectTarget, img: *ObjectImage, path: str) err[fail.Fail] {
    var dst: of_destination.Destination = of_destination.init(img.alloc);
    fin { of_destination.dnit(?dst); }
    val written: err[fail.Fail] = write(tgt, img, ?dst);
    if (sel written.err) { ret written; }
    ret of_destination.publish(?dst, img.interner, path, "cannot publish");
}

