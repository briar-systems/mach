test "mach.lang.target.of.registry:owns_descriptor_strings" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var name: [6]u8;
    name[0] = 'o'; name[1] = 'w'; name[2] = 'n'; name[3] = 'e'; name[4] = 'd'; name[5] = 0;
    var ext: [2]u8; ext[0] = 'o'; ext[1] = 0;
    var debug: [6]u8;
    debug[0] = 'd'; debug[1] = 'w'; debug[2] = 'a'; debug[3] = 'r'; debug[4] = 'f'; debug[5] = 0;
    var shared: [4]u8; shared[0] = '.'; shared[1] = 's'; shared[2] = 'o'; shared[3] = 0;
    var prefix: [3]u8; prefix[0] = 'i'; prefix[1] = '_'; prefix[2] = 0;
    var vt: OfVTable = linker_vtable(1, (?name[0])::str, (?ext[0])::str,
                                      t_of_emit_object, t_of_parse, t_of_emit_exec);
    vt.default_debug = (?debug[0])::str;
    vt.shared_input_ext = (?shared[0])::str;
    vt.import_address_prefix = (?prefix[0])::str;
    if (R.is_err[R.Void, str](register(?reg, ?vt))) { registry_dnit(?reg); ret 1; }
    name[0] = 'x'; ext[0] = 'x'; debug[0] = 'x'; shared[1] = 'x'; prefix[0] = 'x';
    val found_o: O.Option[*OfVTable] = lookup(?reg, "owned");
    if (O.is_none[*OfVTable](found_o)) { registry_dnit(?reg); ret 1; }
    val found: *OfVTable = O.unwrap[*OfVTable](found_o);
    if (!str_equals(found.object_ext, "o") || !str_equals(found.default_debug, "dwarf")
        || !str_equals(found.shared_input_ext, ".so")
        || !str_equals(found.import_address_prefix, "i_")) {
        registry_dnit(?reg);
        ret 1;
    }
    registry_dnit(?reg);
    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.register:accepts_each_complete_output_shape" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }
    var artifact: OfVTable = t_artifact(1, "artifact");
