    carries_stack_size:  bool;

    default_stack_reserve: u64;
    header_span:         HeaderSpanFn;
    executable_section_location: ExecutableSectionLocationFn;
}

pub fun artifact_vtable(id: u32, name: str, object_ext: str,
                        emit_object: WriterFn) OfVTable {
    var vt: OfVTable;
    vt.id = id;
    vt.name = name;
    vt.object_is_artifact = true;
    vt.object_ext = object_ext;
    vt.emit_object = emit_object;
    ret vt;
}

pub fun linker_vtable(id: u32, name: str, object_ext: str,
                      emit_object: WriterFn, parse_object: ParserFn,
                      emit_exec: ExecFn) OfVTable {
    var vt: OfVTable;
    vt.id = id;
    vt.name = name;
    vt.links_from_image = true;
    vt.object_ext = object_ext;
    vt.emit_object = emit_object;
    vt.parse_object = parse_object;
    vt.emit_exec = emit_exec;
    ret vt;
}

pub fun direct_image_vtable(id: u32, name: str, object_ext: str,
                            emit_object: WriterFn, parse_object: ParserFn,
                            emit_exec: ExecFn, emit_exec_image: ExecImageFn) OfVTable {
    var vt: OfVTable = linker_vtable(id, name, object_ext, emit_object,
                                     parse_object, emit_exec);
    vt.produces_image = true;
    vt.emit_exec_image = emit_exec_image;
    ret vt;
}

pub fun with_dynamic_exec(vt: *OfVTable, emit: DynExecFn) {
    vt.emit_dyn_exec = emit;
}

pub fun with_shared_output(vt: *OfVTable, emit: SharedFn) {
    vt.emit_shared = emit;
}

pub def ArtifactOutputKind: u8;
pub val ARTIFACT_EXECUTABLE: ArtifactOutputKind = 0;
pub val ARTIFACT_STATIC_LIB: ArtifactOutputKind = 1;
pub val ARTIFACT_SHARED_LIB: ArtifactOutputKind = 2;
pub val ARTIFACT_OBJECT:     ArtifactOutputKind = 3;

pub rec ArtifactName {
    prefix: str;
    suffix: str;
    key:    str;
}

pub fun artifact_naming(vt: *OfVTable, os_name: str, kind: ArtifactOutputKind) res[ArtifactName, fail.Fail] {
    if (vt == nil) { ret res[ArtifactName, fail.Fail].err{fail.message("artifact naming: nil object format")}; }

    var an: ArtifactName;
    an.prefix = "";
    an.suffix = "";
    an.key    = vt.name;

    if (kind == ARTIFACT_OBJECT) {
        if (!str_empty(vt.object_ext)) { an.suffix = dotted_ext(vt.object_ext); }
        ret res[ArtifactName, fail.Fail].ok{an};
    }

    if (kind == ARTIFACT_SHARED_LIB) {
        if (str_empty(vt.shared_input_ext)) {
            ret res[ArtifactName, fail.Fail].err{fail.message("artifact naming: this object format has no shared-library form")};
        }
        an.suffix = vt.shared_input_ext;
        if (!str_equals(vt.shared_input_ext, ".dll")) { an.prefix = "lib"; }
        ret res[ArtifactName, fail.Fail].ok{an};
    }

    if (kind == ARTIFACT_STATIC_LIB) {
        if (vt.object_is_artifact || str_empty(vt.object_ext)) {
            ret res[ArtifactName, fail.Fail].err{fail.message("artifact naming: this object format has no static-library form")};
        }
        if (str_equals(os_name, "windows")) { an.suffix = ".lib"; }
        or { an.prefix = "lib"; an.suffix = ".a"; }
        ret res[ArtifactName, fail.Fail].ok{an};
    }

    if (vt.object_is_artifact) {
        if (!str_empty(vt.object_ext)) { an.suffix = dotted_ext(vt.object_ext); }
        ret res[ArtifactName, fail.Fail].ok{an};
    }
    if (vt.produces_image) {
        ret res[ArtifactName, fail.Fail].ok{an};
    }
    if (str_equals(os_name, "windows")) { an.suffix = ".exe"; }
    ret res[ArtifactName, fail.Fail].ok{an};
}

fun dotted_ext(ext: str) str {
    if (str_len(ext) == 0)          { ret ""; }
    if (str_equals(ext, "o"))       { ret ".o"; }
    if (str_equals(ext, "obj"))     { ret ".obj"; }
    if (str_equals(ext, "spv"))     { ret ".spv"; }
    if (ext[0] == '.')              { ret ext; }
    ret ext;
}

val OF_REGISTRY_CAP: u32 = 8;

pub rec OfRegistry {
    entries: [8]OfVTable;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

pub fun registry_init() OfRegistry {
    var reg: OfRegistry;
    val r_1623: err[A.Error] = page.make(?reg.alloc);
    reg.alloc_ready = sel r_1623.ok;
    var i:   u32 = 0;
    for (i < OF_REGISTRY_CAP) {
        reg.entries[i].id = OF_UNKNOWN;
        reg.entries[i].name = nil;
        reg.entries[i].object_ext = nil;
        reg.entries[i].default_debug = nil;
        reg.entries[i].shared_input_ext = nil;
        reg.entries[i].import_address_prefix = nil;
        i = i + 1;
    }
    reg.count = 0;
    ret reg;
}

fun own_registry_str(alloc: *A.Allocator, src: str) res[str, fail.Fail] {
    if (src == nil) {
        val r_1639: res[str, string.StrError] = str_copy(alloc, "");
        if (sel r_1639.err) { ret res[str, fail.Fail].err{fail.str_refused(r_1639.err)}; }
        ret res[str, fail.Fail].ok{r_1639.ok};
    }
    val r_1640: res[str, string.StrError] = str_copy(alloc, src);
    if (sel r_1640.err) { ret res[str, fail.Fail].err{fail.str_refused(r_1640.err)}; }
    ret res[str, fail.Fail].ok{r_1640.ok};
}

fun release_of_entry(reg: *OfRegistry, vt: *OfVTable) {
    if (vt.name != nil) {
        A.deallocate[u8](?reg.alloc, vt.name::*u8, str_len(vt.name) + 1);
        vt.name = nil;
    }
    if (vt.object_ext != nil) {
        A.deallocate[u8](?reg.alloc, vt.object_ext::*u8, str_len(vt.object_ext) + 1);
        vt.object_ext = nil;
    }
    if (vt.default_debug != nil) {
        A.deallocate[u8](?reg.alloc, vt.default_debug::*u8, str_len(vt.default_debug) + 1);
        vt.default_debug = nil;
    }
    if (vt.shared_input_ext != nil) {
        A.deallocate[u8](?reg.alloc, vt.shared_input_ext::*u8, str_len(vt.shared_input_ext) + 1);
        vt.shared_input_ext = nil;
    }
    if (vt.import_address_prefix != nil) {
        A.deallocate[u8](?reg.alloc, vt.import_address_prefix::*u8,
                         str_len(vt.import_address_prefix) + 1);
        vt.import_address_prefix = nil;
    }
}

pub fun registry_dnit(reg: *OfRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > OF_REGISTRY_CAP) { limit = OF_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        release_of_entry(reg, ?reg.entries[i]);
        i = i + 1;
    }
    reg.count = 0;
}

fun errf(fb: str, fmt: str, va: ...) str {
    var alloc: A.Allocator;
    val r_1681: err[A.Error] = page.make(?alloc);
    if (sel r_1681.err) { ret fb; }
    val r: res[str, format.FormatError] = format.sprint(?alloc, fmt, va...);
    if (sel r.err) { ret fb; }
    ret r.ok;
}

fun dup_of_id(reg: *OfRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun descriptor_valid(vt: *OfVTable) bool {
    if (vt == nil || str_len(vt.name) == 0 || vt.id == OF_UNKNOWN) { ret false; }
    if (vt.object_is_artifact) {
        if (vt.produces_image || vt.links_from_image || vt.emit_object == nil
            || vt.parse_object != nil || vt.emit_exec != nil || vt.emit_exec_image != nil
            || vt.emit_dyn_exec != nil || vt.emit_shared != nil || str_len(vt.object_ext) == 0) { ret false; }
    } or (vt.produces_image) {
        if (!vt.links_from_image || vt.emit_object == nil || vt.parse_object == nil
            || vt.emit_exec == nil || vt.emit_exec_image == nil) { ret false; }
    } or (vt.links_from_image) {
        if (vt.emit_object == nil || vt.parse_object == nil || vt.emit_exec == nil
            || vt.emit_exec_image != nil) { ret false; }
    } or { ret false; }
    if ((vt.emit_dyn_exec != nil && vt.emit_exec == nil)
        || (vt.emit_shared != nil && !vt.links_from_image)
        || vt.header_in_first_segment != (vt.header_span != nil)
        || vt.covers_isa_count > OF_ISA_MAX
        || (vt.covers_isa_any && vt.covers_isa_count != 0)) { ret false; }
    var i: u32 = 0;
    for (i < vt.covers_isa_count) {
        if (vt.covers_isas[i] == arch.UNKNOWN) { ret false; }
        var j: u32 = 0;
        for (j < i) {
            if (vt.covers_isas[j] == vt.covers_isas[i]) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun registry_validate(reg: *OfRegistry) err[fail.Fail] {
    if (reg == nil) { ret err[fail.Fail].err{fail.message("mach.lang.target.of: nil registry")}; }
    if (!reg.alloc_ready || reg.count > OF_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: invalid registry backing or count")};
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (!descriptor_valid(?reg.entries[i])) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.of: registry contains an invalid descriptor")};
        }
        var j: u32 = 0;
        for (j < i) {
            if (reg.entries[i].id == reg.entries[j].id
                || str_equals(reg.entries[i].name, reg.entries[j].name)) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.of: registry contains a duplicate identity")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun register(reg: *OfRegistry, vt: *OfVTable) err[fail.Fail] {
    if (reg == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: register called with a nil registry")};
    }
    if (reg.count > OF_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: registry count exceeds its backing capacity")};
    }
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: register called with a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: register called with an empty name")};
    }
    if (vt.id == OF_UNKNOWN) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: register called with the unknown object-format id")};
    }
    val r_1766: opt[*OfVTable] = lookup(reg, vt.name);
    if (sel r_1766.some) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: an object format is already registered under this name",
            "mach.lang.target.of: an object format named '{}' is already registered", vt.name))};
    }
    if (dup_of_id(reg, vt.id)) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: an object format is already registered under this id",
            "mach.lang.target.of: object format id {} is already registered (wanted to register '{}')", vt.id, vt.name))};
    }
    if (reg.count >= OF_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: registry is at capacity; raise OF_REGISTRY_CAP to register another object format")};
    }
    if (!reg.alloc_ready) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: registry backing allocator is unavailable")};
    }
    if (vt.object_is_artifact) {
        if (vt.produces_image || vt.links_from_image || vt.emit_object == nil
            || vt.parse_object != nil || vt.emit_exec != nil || vt.emit_exec_image != nil
            || vt.emit_dyn_exec != nil || vt.emit_shared != nil || str_len(vt.object_ext) == 0) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: an artifact object format has a contradictory capability group",
                "mach.lang.target.of: artifact format '{}' must declare only a writer and a nonempty extension", vt.name))};
        }
    } or (vt.produces_image) {
        if (!vt.links_from_image || vt.emit_object == nil || vt.parse_object == nil
            || vt.emit_exec == nil || vt.emit_exec_image == nil) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: a direct-image object format has an incomplete capability group",
                "mach.lang.target.of: direct-image format '{}' must declare object write/parse and file/in-memory executable emission", vt.name))};
        }
    } or (vt.links_from_image) {
        if (vt.emit_object == nil || vt.parse_object == nil || vt.emit_exec == nil
            || vt.emit_exec_image != nil) {
            ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: a linker object format has an incomplete capability group",
                "mach.lang.target.of: linker format '{}' must declare object write/parse and file executable emission without direct-image emission", vt.name))};
        }
    } or {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: object format declares no supported capability group",
            "mach.lang.target.of: object format '{}' is neither an artifact, direct-image, nor linker format", vt.name))};
    }
    if (vt.emit_dyn_exec != nil && vt.emit_exec == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: dynamic executable emission requires ordinary executable emission")};
    }
    if (vt.emit_shared != nil && !vt.links_from_image) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: shared-library emission requires linker image support")};
    }
    if (vt.header_in_first_segment != (vt.header_span != nil)) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: first-segment header placement requires exactly one header-span hook")};
    }
    if (vt.covers_isa_count > OF_ISA_MAX) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: instruction-set coverage exceeds the descriptor capacity")};
    }
    if (vt.covers_isa_any && vt.covers_isa_count != 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: universal and explicit instruction-set coverage are exclusive")};
    }
    var ci: u32 = 0;
    for (ci < vt.covers_isa_count) {
        if (vt.covers_isas[ci] == arch.UNKNOWN) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.of: instruction-set coverage contains the unknown id")};
        }
        var cj: u32 = 0;
        for (cj < ci) {
            if (vt.covers_isas[cj] == vt.covers_isas[ci]) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.of: instruction-set coverage contains a duplicate id")};
            }
            cj = cj + 1;
        }
        ci = ci + 1;
    }

    val entry: *OfVTable = ?reg.entries[reg.count];
    @entry = @vt;
    entry.name = nil;
    entry.object_ext = nil;
    entry.default_debug = nil;
    entry.shared_input_ext = nil;
    entry.import_address_prefix = nil;
    val name_r: res[str, fail.Fail] = own_registry_str(?reg.alloc, vt.name);
    if (sel name_r.err) { release_of_entry(reg, entry); ret err[fail.Fail].err{name_r.err}; }
    entry.name = name_r.ok;
    val object_ext_r: res[str, fail.Fail] = own_registry_str(?reg.alloc, vt.object_ext);
    if (sel object_ext_r.err) { release_of_entry(reg, entry); ret err[fail.Fail].err{object_ext_r.err}; }
    entry.object_ext = object_ext_r.ok;
    val default_debug_r: res[str, fail.Fail] = own_registry_str(?reg.alloc, vt.default_debug);
    if (sel default_debug_r.err) { release_of_entry(reg, entry); ret err[fail.Fail].err{default_debug_r.err}; }
    entry.default_debug = default_debug_r.ok;
    val shared_ext_r: res[str, fail.Fail] = own_registry_str(?reg.alloc, vt.shared_input_ext);
    if (sel shared_ext_r.err) { release_of_entry(reg, entry); ret err[fail.Fail].err{shared_ext_r.err}; }
    entry.shared_input_ext = shared_ext_r.ok;
    val import_prefix_r: res[str, fail.Fail] = own_registry_str(?reg.alloc, vt.import_address_prefix);
    if (sel import_prefix_r.err) { release_of_entry(reg, entry); ret err[fail.Fail].err{import_prefix_r.err}; }
    entry.import_address_prefix = import_prefix_r.ok;
    reg.count = reg.count + 1;
    ret err[fail.Fail].ok{};
}

pub fun lookup(reg: *OfRegistry, name: str) opt[*OfVTable] {
    if (reg == nil || reg.count > OF_REGISTRY_CAP) { ret opt[*OfVTable].none{}; }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret opt[*OfVTable].some{?reg.entries[i]}; }
        i = i + 1;
    }
    ret opt[*OfVTable].none{};
}

pub fun registered_count(reg: *OfRegistry) u32 {
    if (reg == nil || reg.count > OF_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun registered(reg: *OfRegistry, idx: u32) opt[*OfVTable] {
    if (reg == nil || reg.count > OF_REGISTRY_CAP || idx >= reg.count) { ret opt[*OfVTable].none{}; }
    ret opt[*OfVTable].some{?reg.entries[idx]};
}

pub val DBG_UNKNOWN:  u32 = 0;
pub val DBG_DWARF:    u32 = 1;
pub val DBG_CODEVIEW: u32 = 2;

pub rec DebugProduceRequest {
    program:          debug_input.DebugProgram;
    image:            *ObjectImage;
    rows:             *debug_input.LineRow;
    row_count:        u32;
    varlocs:          *debug_input.VarLoc;
    varloc_count:     u32;
    inline_pcs:       *debug_input.InlinePc;
    inline_pc_count:  u32;
    producer:         intern.StrId;
    comp_dir:         intern.StrId;
    text_section:     u32;
}

pub def DebugProduceFn: fun(*DebugProduceRequest) err[fail.Fail];
pub def DebugSupportsFn: fun(*debug_input.DebugTarget) bool;

pub rec DebugVTable {
    id:      u32;
    name:    str;
    produce: DebugProduceFn;
    supports: DebugSupportsFn;
}

val DEBUG_REGISTRY_CAP: u32 = 4;

pub rec DebugRegistry {
    entries: [4]DebugVTable;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

pub fun debug_registry_init() DebugRegistry {
    var reg: DebugRegistry;
    val r_1912: err[A.Error] = page.make(?reg.alloc);
    reg.alloc_ready = sel r_1912.ok;
    var i:   u32 = 0;
    for (i < DEBUG_REGISTRY_CAP) {
        reg.entries[i].id = DBG_UNKNOWN;
        reg.entries[i].name = nil;
        reg.entries[i].produce = nil;
        reg.entries[i].supports = nil;
        i = i + 1;
    }
    reg.count = 0;
    ret reg;
}

pub fun debug_registry_dnit(reg: *DebugRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var limit: u32 = reg.count;
    if (limit > DEBUG_REGISTRY_CAP) { limit = DEBUG_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < limit) {
        if (reg.entries[i].name != nil) {
            A.deallocate[u8](?reg.alloc, reg.entries[i].name::*u8,
                             str_len(reg.entries[i].name) + 1);
            reg.entries[i].name = nil;
        }
        i = i + 1;
    }
    reg.count = 0;
}

fun dup_debug_id(reg: *DebugRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun debug_register(reg: *DebugRegistry, vt: *DebugVTable) err[fail.Fail] {
    if (reg == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug_register called with a nil registry")};
    }
    if (reg.count > DEBUG_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug registry count exceeds its backing capacity")};
    }
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug_register called with a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug_register called with an empty name")};
    }
    if (vt.id == DBG_UNKNOWN) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug_register called with the unknown debug id")};
    }
    if (vt.produce == nil || vt.supports == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: a complete debug descriptor must declare its producer and target compatibility predicate")};
    }
    val r_1969: opt[*DebugVTable] = debug_lookup(reg, vt.name);
    if (sel r_1969.some) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: a debug model is already registered under this name",
            "mach.lang.target.of: a debug model named '{}' is already registered", vt.name))};
    }
    if (dup_debug_id(reg, vt.id)) {
        ret err[fail.Fail].err{fail.message(errf("mach.lang.target.of: a debug model is already registered under this id",
            "mach.lang.target.of: debug model id {} is already registered (wanted to register '{}')", vt.id, vt.name))};
    }
    if (reg.count >= DEBUG_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug registry is at capacity; raise DEBUG_REGISTRY_CAP to register another debug model")};
    }
    if (!reg.alloc_ready) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug registry backing allocator is unavailable")};
    }
    val name_r: res[str, string.StrError] = str_copy(?reg.alloc, vt.name);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.str_refused(name_r.err)}; }
    reg.entries[reg.count] = @vt;
    reg.entries[reg.count].name = name_r.ok;
    reg.count = reg.count + 1;
    ret err[fail.Fail].ok{};
}

pub fun debug_registry_validate(reg: *DebugRegistry) err[fail.Fail] {
    if (reg == nil) { ret err[fail.Fail].err{fail.message("mach.lang.target.of: nil debug registry")}; }
    if (!reg.alloc_ready || reg.count > DEBUG_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: invalid debug registry backing or count")};
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == DBG_UNKNOWN || str_len(reg.entries[i].name) == 0
            || reg.entries[i].produce == nil || reg.entries[i].supports == nil) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug registry contains an invalid descriptor")};
        }
        var j: u32 = 0;
        for (j < i) {
            if (reg.entries[i].id == reg.entries[j].id
                || str_equals(reg.entries[i].name, reg.entries[j].name)) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug registry contains a duplicate identity")};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun debug_lookup(reg: *DebugRegistry, name: str) opt[*DebugVTable] {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP) { ret opt[*DebugVTable].none{}; }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret opt[*DebugVTable].some{?reg.entries[i]}; }
        i = i + 1;
    }
    ret opt[*DebugVTable].none{};
}

pub fun debug_registered_count(reg: *DebugRegistry) u32 {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun debug_hooks_complete(reg: *DebugRegistry) err[fail.Fail] {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.of: invalid debug registry count")};
    }
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].produce == nil || reg.entries[i].supports == nil) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.of: debug registry contains an incomplete descriptor")};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun debug_registered(reg: *DebugRegistry, idx: u32) opt[*DebugVTable] {
    if (reg == nil || reg.count > DEBUG_REGISTRY_CAP || idx >= reg.count) { ret opt[*DebugVTable].none{}; }
    ret opt[*DebugVTable].some{?reg.entries[idx]};
}

pub fun cover_isa(vt: *OfVTable, arch_id: u32) {
    if (vt.covers_isa_count >= OF_ISA_MAX) { panic("of.cover_isa: coverage list overflow\n"); }
    vt.covers_isas[vt.covers_isa_count] = arch_id;
    vt.covers_isa_count = vt.covers_isa_count + 1;
}

pub fun covers_isa(vt: *OfVTable, arch_id: u32) bool {
    if (vt.covers_isa_any) { ret true; }
    var i: u32 = 0;
    for (i < vt.covers_isa_count) {
        if (vt.covers_isas[i] == arch_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun abs_kind_for_pointer_width(w: u32) res[RelocKind, fail.Fail] {
    if (w == 2) { ret res[RelocKind, fail.Fail].ok{RK_ABS16}; }
    if (w == 4) { ret res[RelocKind, fail.Fail].ok{RK_ABS32}; }
    if (w == 8) { ret res[RelocKind, fail.Fail].ok{RK_ABS64}; }
    ret res[RelocKind, fail.Fail].err{fail.message("of: no absolute relocation kind for this pointer width (must be 2, 4, or 8 bytes)")};
}

pub fun is_pointer_abs_kind(kind: RelocKind, w: u32) bool {
    val r: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(w);
    if (sel r.err) { ret false; }
    ret kind == r.ok;
}

pub fun reloc_symbol_name(img: *ObjectImage, r: *Relocation) intern.StrId {
    if (r.sym >= img.symbol_count) { ret intern.STR_NIL; }
    ret img.symbols[r.sym].name;
}

test "mach.lang.target.of.covers_isa:declared_and_agnostic" {
    var vt: OfVTable;
    vt.covers_isa_any   = false;
    vt.covers_isa_count = 0;
    cover_isa(?vt, arch.X86_64);
    cover_isa(?vt, arch.AARCH64);
    if (!covers_isa(?vt, arch.X86_64))  { ret 1; }
    if (!covers_isa(?vt, arch.AARCH64)) { ret 1; }
    if (covers_isa(?vt, arch.RISCV64))  { ret 1; }

    var flat: OfVTable;
    flat.covers_isa_any   = true;
    flat.covers_isa_count = 0;
    if (!covers_isa(?flat, arch.X86_64))  { ret 1; }
    if (!covers_isa(?flat, arch.RISCV64)) { ret 1; }
    ret 0;
}

fun t_debug_produce(req: *DebugProduceRequest) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

fun t_debug_supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil;
}

test "mach.lang.target.of.debug_register:install_lookup_dispatch" {
    var reg: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?reg); }
    if (debug_registered_count(?reg) != 0) { ret 1; }

    var dw: DebugVTable;
    dw.id = DBG_DWARF; dw.name = "dwarf"; dw.produce = t_debug_produce; dw.supports = t_debug_supports;
    val r_2114: err[fail.Fail] = debug_register(?reg, ?dw);
    if (sel r_2114.err) { debug_registry_dnit(?reg); ret 1; }
    if (debug_registered_count(?reg) != 1) { debug_registry_dnit(?reg); ret 1; }

    val got: opt[*DebugVTable] = debug_lookup(?reg, "dwarf");
    if (!sel got.some)               { debug_registry_dnit(?reg); ret 1; }
    if (got.some.id != DBG_DWARF) { debug_registry_dnit(?reg); ret 1; }
    if (got.some.produce == nil)  { debug_registry_dnit(?reg); ret 1; }

    var dw2: DebugVTable;
    dw2.id = DBG_DWARF; dw2.name = "dwarf"; dw2.produce = t_debug_produce; dw2.supports = t_debug_supports;
    val r_2124: err[fail.Fail] = debug_register(?reg, ?dw2);
    if (!sel r_2124.err) { debug_registry_dnit(?reg); ret 1; }
    if (debug_registered_count(?reg) != 1) { debug_registry_dnit(?reg); ret 1; }

    val r_2127: opt[*DebugVTable] = debug_lookup(?reg, "codeview");
    if (sel r_2127.some) { debug_registry_dnit(?reg); ret 1; }
    debug_registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.of.debug_register:refuses_incomplete_descriptor" {
    var empty: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?empty); }
    val r_2135: err[fail.Fail] = debug_hooks_complete(?empty);
    if (sel r_2135.err) { ret 1; }

    var reg: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?reg); }
    var extra: DebugVTable;
    extra.id = DBG_CODEVIEW; extra.name = "codeview"; extra.produce = nil;
    val r_2141: err[fail.Fail] = debug_register(?reg, ?extra);
    if (!sel r_2141.err) { ret 1; }
    if (debug_registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.debug_registry:registries_own_their_descriptors" {
    var first: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?first); }
    var second: DebugRegistry = debug_registry_init();
    fin { debug_registry_dnit(?second); }
    var name: [6]u8;
    name[0] = 'd'; name[1] = 'w'; name[2] = 'a'; name[3] = 'r'; name[4] = 'f'; name[5] = 0;
    var descriptor: DebugVTable;
    descriptor.id = DBG_DWARF; descriptor.name = (?name[0])::str; descriptor.produce = t_debug_produce; descriptor.supports = t_debug_supports;
    val r_2155: err[fail.Fail] = debug_register(?first, ?descriptor);
    if (sel r_2155.err) { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    val r_2156: err[fail.Fail] = debug_register(?second, ?descriptor);
    if (sel r_2156.err) { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    name[0] = 'x';
    descriptor.produce = nil;
    val r_2159: err[fail.Fail] = debug_hooks_complete(?first);
    if (sel r_2159.err) { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    val r_2160: err[fail.Fail] = debug_hooks_complete(?second);
    if (sel r_2160.err) { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    val second_dwarf: opt[*DebugVTable] = debug_lookup(?second, "dwarf");
    if (sel second_dwarf.none)                   { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    if (second_dwarf.some.produce == nil)     { debug_registry_dnit(?first); debug_registry_dnit(?second); ret 1; }
    debug_registry_dnit(?first);
    debug_registry_dnit(?second);
    ret 0;
}

test "mach.lang.target.of.abs_kind_for_pointer_width:width_ladder" {
    val r2: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(2);
    if (sel r2.err) { ret 1; }
    if (r2.ok != RK_ABS16) { ret 1; }

    val r4: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(4);
    if (sel r4.err) { ret 1; }
    if (r4.ok != RK_ABS32) { ret 1; }

    val r8: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(8);
    if (sel r8.err) { ret 1; }
    if (r8.ok != RK_ABS64) { ret 1; }

    val r_2182: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(3);
    if (!sel r_2182.err) { ret 1; }
    val r_2183: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(16);
    if (!sel r_2183.err) { ret 1; }
    val r_2184: res[RelocKind, fail.Fail] = abs_kind_for_pointer_width(0);
    if (!sel r_2184.err) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.is_pointer_abs_kind:agrees_with_selector_and_rejects_others" {
    if (!is_pointer_abs_kind(RK_ABS16, 2)) { ret 1; }
    if (!is_pointer_abs_kind(RK_ABS32, 4)) { ret 1; }
    if (!is_pointer_abs_kind(RK_ABS64, 8)) { ret 1; }

    if (is_pointer_abs_kind(RK_ABS64, 2)) { ret 1; }
    if (is_pointer_abs_kind(RK_ABS16, 8)) { ret 1; }
    if (is_pointer_abs_kind(RK_ABS32, 8)) { ret 1; }
    if (is_pointer_abs_kind(RK_ABS64, 4)) { ret 1; }

    if (is_pointer_abs_kind(RK_PC32, 2)) { ret 1; }
    if (is_pointer_abs_kind(RK_PC32, 4)) { ret 1; }
    if (is_pointer_abs_kind(RK_PC32, 8)) { ret 1; }

    if (is_pointer_abs_kind(RK_ABS64, 3)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.subsystem_catalog:complete_unique_ordered_roundtrip" {
    if (SUBSYSTEM_CATALOG_VERSION != 1) { ret 1; }
    if (SUBSYSTEM_N != SUBSYSTEM_GUI::usize + 1) { ret 1; }

    var seen: [SUBSYSTEM_N]bool;
    var i: usize = 0;
    for (i < SUBSYSTEM_N) { seen[i] = false; i = i + 1; }

    i = 0;
    for (i < SUBSYSTEM_N) {
        val spec: *SubsystemSpec = ?SUBSYSTEMS[i];
        if (spec.subsystem::usize >= SUBSYSTEM_N) { ret 1; }
        if (seen[spec.subsystem::usize])          { ret 1; }
        if (str_equals(spec.spelling, ""))        { ret 1; }
        if (spec.fingerprint_tag != (i + 1)::u8)  { ret 1; }
        if (!str_equals(subsystem_name(spec.subsystem), spec.spelling)) { ret 1; }
        if (subsystem_fingerprint_tag(spec.subsystem) != spec.fingerprint_tag) { ret 1; }
        seen[spec.subsystem::usize] = true;

        var j: usize = 0;
        for (j < i) {
            val prior: *SubsystemSpec = ?SUBSYSTEMS[j];
            if (prior.subsystem == spec.subsystem)             { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.spelling, spec.spelling))     { ret 1; }
            j = j + 1;
        }

        val parsed: opt[Subsystem] = subsystem_from_name(spec.spelling);
        if (sel parsed.none)                   { ret 1; }
        if (parsed.some != spec.subsystem)  { ret 1; }
        i = i + 1;
    }

    val r_2240: opt[Subsystem] = subsystem_from_name("");
    if (sel r_2240.some) { ret 1; }
    val r_2241: opt[Subsystem] = subsystem_from_name("windows");
    if (sel r_2241.some) { ret 1; }
    if (!str_equals(subsystem_name(255::Subsystem), "unknown")) { ret 1; }
    if (subsystem_fingerprint_tag(255::Subsystem) != 0)         { ret 1; }

    i = 0;
    for (i < SUBSYSTEM_N) {
        if (!seen[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun t_of_emit_object(vt: *ObjectTarget, img: *ObjectImage, destination: *publication.Destination) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

fun t_of_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, vt: *ObjectTarget,
                   segs: *LoadSegment, seg_count: u32, entry: u64, load_base: u64, image_base: u64,
                   funcs: *ExecFunction, func_count: u32, secs: *Section, sec_count: u32,
                   debug_secs: *Section, debug_sec_count: u32, syms: *SymtabEntry, sym_count: u32,
                   destination: *publication.Destination, out_name: *u8, opts: ImageOptions) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

fun t_of_parse(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8,
               buf_size: usize, out: *ObjectImage) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

fun t_of_emit_image(alloc: *A.Allocator, segs: *LoadSegment, seg_count: u32,
                    entry: u64, base: *u64, size: *usize) res[*u8, fail.Fail] {
    ret res[*u8, fail.Fail].ok{nil};
}

fun t_artifact(id: u32, name: str) OfVTable {
    ret artifact_vtable(id, name, "o", t_of_emit_object);
}

fun t_linker(id: u32, name: str) OfVTable {
    ret linker_vtable(id, name, "o", t_of_emit_object, t_of_parse, t_of_emit_exec);
}

fun t_direct(id: u32, name: str) OfVTable {
    ret direct_image_vtable(id, name, "", t_of_emit_object, t_of_parse,
                            t_of_emit_exec, t_of_emit_image);
}

test "mach.lang.target.of.register:rejects_nil_empty_name_and_missing_hooks" {
    var reg: OfRegistry = registry_init();
    fin { registry_dnit(?reg); }
    val r_2290: err[fail.Fail] = register(nil, nil);
    if (!sel r_2290.err) { ret 1; }
    val r_2291: err[fail.Fail] = register(?reg, nil);
    if (!sel r_2291.err) { ret 1; }

    var no_name: OfVTable = t_direct(OF_RAW, "");
    val r_2294: err[fail.Fail] = register(?reg, ?no_name);
    if (!sel r_2294.err) { ret 1; }

    var unknown: OfVTable = t_direct(OF_UNKNOWN, "unknown");
    val r_2297: err[fail.Fail] = register(?reg, ?unknown);
    if (!sel r_2297.err) { ret 1; }

    var no_hooks: OfVTable;
    no_hooks.name       = "nohooks";
    no_hooks.object_ext  = "raw";
    val r_2302: err[fail.Fail] = register(?reg, ?no_hooks);
    if (!sel r_2302.err) { ret 1; }

    if (registered_count(?reg) != 0) { ret 1; }
    ret 0;
}

