pub fun canonical_section_name(kind: SectionKind) str {
    if (kind == SK_TEXT)   { ret ".text"; }
    if (kind == SK_DATA)   { ret ".data"; }
    if (kind == SK_RODATA) { ret ".rodata"; }
    if (kind == SK_RELRO)  { ret ".data.rel.ro"; }
    if (kind == SK_BSS)    { ret ".bss"; }
    if (kind == SK_DEBUG)  { ret ".debug"; }
    ret ".exception";
}

