use std.allocator.page;
use std.format;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_copy;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.target.isa;

pub val OS_UNKNOWN:      u32 = 0;
pub val OS_LINUX:        u32 = 1;
pub val OS_DARWIN:       u32 = 2;
pub val OS_WINDOWS:      u32 = 3;
pub val OS_FREESTANDING: u32 = 4;

rec OsSpec {
    os:              u32;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val OS_CATALOG_VERSION: u8 = 1;

val OS_N: usize = 4;
val OSES: [OS_N]OsSpec = [OS_N]OsSpec{
    OsSpec{ os: OS_LINUX,        spelling: "linux",        fingerprint_tag: 1 },
    OsSpec{ os: OS_DARWIN,       spelling: "darwin",       fingerprint_tag: 2 },
    OsSpec{ os: OS_WINDOWS,      spelling: "windows",      fingerprint_tag: 3 },
    OsSpec{ os: OS_FREESTANDING, spelling: "freestanding", fingerprint_tag: 4 },
};

fun os_spec(id: u32) *OsSpec {
    var i: usize = 0;
    for (i < OS_N) {
        if (OSES[i].os == id) { ret ?OSES[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun os_id_for(name: str) u32 {
    var i: usize = 0;
    for (i < OS_N) {
        if (str_equals(OSES[i].spelling, name)) { ret OSES[i].os; }
        i = i + 1;
    }
    ret OS_UNKNOWN;
}

pub fun os_name_for(id: u32) str {
    val spec: *OsSpec = os_spec(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun os_catalog_len() usize {
    ret OS_N;
}

pub fun os_catalog_name(index: usize) str {
    if (index >= OS_N) { ret "unknown"; }
    ret OSES[index].spelling;
}

pub fun os_fingerprint_tag(id: u32) u8 {
    val spec: *OsSpec = os_spec(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

pub val OS_LIBDIR_MAX: u32 = 8;

pub val OS_OF_MAX: u32 = 8;

pub val OS_ISA_MAX: u32 = 8;

pub def PieExecFn: fun(u32) bool;

pub def PageSizeFn: fun(u32) u64;

pub def NativeAbiFn: fun(u32) str;

pub def VariadicStackFn: fun(u32) bool;

pub def NaturalStackArgsFn: fun(u32) bool;

pub def ReservedGpFn: fun(u32) u32;

pub rec VaList { size: u32; align: u32; }

pub fun va_list(size: u32, align: u32) VaList {
    var v: VaList;
    v.size  = size;
    v.align = align;
    ret v;
}

pub def VaListFn: fun(u32) O.Option[VaList];

pub rec FsPolicy {
    sysroot:             str;
    toolchain_root:      str;
    dynamic_interpreter: str;
    platform_lib:        str;
    libdirs:             [OS_LIBDIR_MAX]str;
    libdir_len:          u32;
}

pub def FsPolicyFn: fun(u32) O.Option[FsPolicy];

pub rec OsVTable {
    id:                  u32;
    name:                str;
    default_of:          str;
    supported_ofs:       [OS_OF_MAX]str;
    supported_of_count:  u32;
    supported_isas:      [OS_ISA_MAX]u32;
    supported_isa_count: u32;
    supported_isa_any:   bool;
    entry_symbol:        str;
    c_symbol_prefix:     str;
    base_addr:           u64;
    page_size:           u64;
    stack_probe:         bool;
    mapped_by_loader:    bool;
    pie_exec:            PieExecFn;
    fs_policy:           FsPolicyFn;
    page_size_for:       PageSizeFn;
    native_abi:          NativeAbiFn;
    variadic_stack:      VariadicStackFn;
    natural_stack_args:  NaturalStackArgsFn;
    va_list_layout:      VaListFn;
    reserved_gp:         ReservedGpFn;
}

val OS_REGISTRY_CAP: u32 = 8;

pub rec OsRegistry {
    entries: [8]OsVTable;
    count:   u32;
    alloc:   A.Allocator;
    alloc_ready: bool;
}

pub fun registry_init_with_allocator(alloc: *A.Allocator) OsRegistry {
    var r: OsRegistry;
    r.alloc_ready = alloc != nil;
    if (alloc != nil) { r.alloc = @alloc; }
    var i: u32 = 0;
    for (i < OS_REGISTRY_CAP) {
        r.entries[i].id = OS_UNKNOWN;
        r.entries[i].name = nil;
        r.entries[i].default_of = nil;
        r.entries[i].entry_symbol = nil;
        r.entries[i].c_symbol_prefix = nil;
        r.entries[i].supported_of_count = 0;
        i = i + 1;
    }
    r.count = 0;
    ret r;
}

pub fun registry_init() OsRegistry {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret registry_init_with_allocator(nil); }
    ret registry_init_with_allocator(?alloc);
}

fun release_entry(reg: *OsRegistry, vt: *OsVTable) {
    if (vt.name != nil) {
        A.deallocate[u8](?reg.alloc, vt.name::*u8, str_len(vt.name) + 1);
        vt.name = nil;
    }
    if (vt.default_of != nil) {
        A.deallocate[u8](?reg.alloc, vt.default_of::*u8, str_len(vt.default_of) + 1);
        vt.default_of = nil;
    }
    var i: u32 = 0;
    var of_count: u32 = vt.supported_of_count;
    if (of_count > OS_OF_MAX) { of_count = OS_OF_MAX; }
    for (i < of_count) {
        if (vt.supported_ofs[i] != nil) {
            A.deallocate[u8](?reg.alloc, vt.supported_ofs[i]::*u8,
                             str_len(vt.supported_ofs[i]) + 1);
            vt.supported_ofs[i] = nil;
        }
        i = i + 1;
    }
    if (vt.entry_symbol != nil) {
        A.deallocate[u8](?reg.alloc, vt.entry_symbol::*u8, str_len(vt.entry_symbol) + 1);
        vt.entry_symbol = nil;
    }
    if (vt.c_symbol_prefix != nil) {
        A.deallocate[u8](?reg.alloc, vt.c_symbol_prefix::*u8,
                         str_len(vt.c_symbol_prefix) + 1);
        vt.c_symbol_prefix = nil;
    }
}

pub fun registry_dnit(reg: *OsRegistry) {
    if (reg == nil || !reg.alloc_ready) { ret; }
    var count: u32 = reg.count;
    if (count > OS_REGISTRY_CAP) { count = OS_REGISTRY_CAP; }
    var i: u32 = 0;
    for (i < count) {
        release_entry(reg, ?reg.entries[i]);
        i = i + 1;
    }
    reg.count = 0;
}

fun errf(fb: str, fmt: str, va: ...) str {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret fb; }
    val r: R.Result[str, str] = format.sprint(?alloc, fmt, va...);
    if (R.is_err[str, str](r)) { ret fb; }
    ret R.unwrap_ok[str, str](r);
}

fun dup_os_id(reg: *OsRegistry, id: u32) bool {
    var i: u32 = 0;
    for (i < reg.count) {
        if (reg.entries[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun descriptor_validate(vt: *OsVTable, check_outputs: bool) R.Result[R.Void, str] {
    if (vt == nil) {
        ret R.err[R.Void, str]("mach.lang.target.os: register called with a nil descriptor");
    }
    if (str_len(vt.name) == 0) {
        ret R.err[R.Void, str]("mach.lang.target.os: register called with an empty name");
    }
    if (vt.id == OS_UNKNOWN) {
        ret R.err[R.Void, str]("mach.lang.target.os: an operating system must declare a nonzero id");
    }
    if (vt.supported_of_count > OS_OF_MAX || vt.supported_isa_count > OS_ISA_MAX) {
        ret R.err[R.Void, str]("mach.lang.target.os: descriptor capability count exceeds its inline storage");
    }
    if (str_len(vt.default_of) == 0) {
        ret R.err[R.Void, str](errf("mach.lang.target.os: an operating system must declare a default object format",
            "mach.lang.target.os: operating system '{}' declares an empty `default_of`", vt.name));
    }
    if (vt.page_size == 0 || (vt.page_size & (vt.page_size - 1)) != 0) {
        ret R.err[R.Void, str](errf("mach.lang.target.os: an operating system must declare a power-of-two page size",
            "mach.lang.target.os: operating system '{}' declares an invalid `page_size`", vt.name));
    }
    if (vt.supported_of_count == 0) {
        ret R.err[R.Void, str]("mach.lang.target.os: an operating system must declare at least one object format");
    }
    var default_supported: bool = false;
    var of_i: u32 = 0;
    for (of_i < vt.supported_of_count) {
        if (str_len(vt.supported_ofs[of_i]) == 0) {
            ret R.err[R.Void, str]("mach.lang.target.os: an operating system declares an empty object-format name");
        }
        if (str_equals(vt.supported_ofs[of_i], vt.default_of)) { default_supported = true; }
        var of_j: u32 = of_i + 1;
        for (of_j < vt.supported_of_count) {
            if (str_equals(vt.supported_ofs[of_i], vt.supported_ofs[of_j])) {
                ret R.err[R.Void, str]("mach.lang.target.os: an operating system declares a duplicate object format");
            }
            of_j = of_j + 1;
        }
        of_i = of_i + 1;
    }
    if (!default_supported) {
        ret R.err[R.Void, str]("mach.lang.target.os: the default object format must be present in the supported-format list");
    }
    if (vt.supported_isa_any && vt.supported_isa_count != 0) {
        ret R.err[R.Void, str]("mach.lang.target.os: wildcard ISA support cannot also carry an explicit ISA list");
    }
    if (!vt.supported_isa_any && vt.supported_isa_count == 0) {
        ret R.err[R.Void, str]("mach.lang.target.os: an operating system must declare wildcard or explicit ISA support");
    }
    if (vt.va_list_layout == nil || vt.fs_policy == nil) {
        ret R.err[R.Void, str]("mach.lang.target.os: ISA support requires explicit `va_list` and file-system policy callbacks");
    }
    var isa_i: u32 = 0;
    for (isa_i < vt.supported_isa_count) {
        if (vt.supported_isas[isa_i] == isa.ARCH_UNKNOWN) {
            ret R.err[R.Void, str]("mach.lang.target.os: an operating system declares an unknown ISA id");
        }
        var isa_j: u32 = isa_i + 1;
        for (isa_j < vt.supported_isa_count) {
            if (vt.supported_isas[isa_i] == vt.supported_isas[isa_j]) {
                ret R.err[R.Void, str]("mach.lang.target.os: an operating system declares a duplicate ISA id");
            }
            isa_j = isa_j + 1;
        }
        isa_i = isa_i + 1;
    }
    if (check_outputs && !vt.supported_isa_any) {
        var i: u32 = 0;
        for (i < vt.supported_isa_count) {
            val page_r: R.Result[u64, str] = page_size_checked_for(vt, vt.supported_isas[i]);
            if (R.is_err[u64, str](page_r)) {
                ret R.err[R.Void, str](R.unwrap_err[u64, str](page_r));
            }
            val va_list_r: R.Result[O.Option[VaList], str] =
                va_list_checked_for(vt, vt.supported_isas[i]);
            if (R.is_err[O.Option[VaList], str](va_list_r)) {
                ret R.err[R.Void, str](R.unwrap_err[O.Option[VaList], str](va_list_r));
            }
            val va_list_opt: O.Option[VaList] =
                R.unwrap_ok[O.Option[VaList], str](va_list_r);
            if (O.is_none[VaList](va_list_opt)) {
                ret R.err[R.Void, str]("mach.lang.target.os: an operating system declares no `va_list` layout for an architecture it supports; read the platform psABI for it and declare the size and alignment rather than registering it undecided");
            }
            val fs_r: R.Result[O.Option[FsPolicy], str] =
                fs_policy_checked_for(vt, vt.supported_isas[i]);
            if (R.is_err[O.Option[FsPolicy], str](fs_r)) {
                ret R.err[R.Void, str](R.unwrap_err[O.Option[FsPolicy], str](fs_r));
            }
            val fs_opt: O.Option[FsPolicy] =
                R.unwrap_ok[O.Option[FsPolicy], str](fs_r);
            if (O.is_none[FsPolicy](fs_opt)) {
                ret R.err[R.Void, str]("mach.lang.target.os: an operating system declares no file-system policy for an architecture it supports; declare its sysroot, toolchain root, dynamic interpreter, and default library directories explicitly rather than leaving them undecided");
            }
            i = i + 1;
        }
    }
    ret R.ok_void[str]();
}

pub fun registry_validate(reg: *OsRegistry) R.Result[R.Void, str] {
    if (reg == nil) {
        ret R.err[R.Void, str]("mach.lang.target.os: cannot validate a nil registry");
    }
    if (!reg.alloc_ready) {
        ret R.err[R.Void, str]("mach.lang.target.os: registry backing allocator is unavailable");
    }
    if (reg.count > OS_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.os: registry count exceeds its inline storage");
    }
    var i: u32 = 0;
    for (i < reg.count) {
        val valid: R.Result[R.Void, str] = descriptor_validate(?reg.entries[i], false);
        if (R.is_err[R.Void, str](valid)) { ret valid; }
        var j: u32 = i + 1;
        for (j < reg.count) {
            if (reg.entries[i].id == reg.entries[j].id) {
                ret R.err[R.Void, str]("mach.lang.target.os: registry contains a duplicate operating-system id");
            }
            if (str_equals(reg.entries[i].name, reg.entries[j].name)) {
                ret R.err[R.Void, str]("mach.lang.target.os: registry contains a duplicate operating-system name");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun register(reg: *OsRegistry, vt: *OsVTable) R.Result[R.Void, str] {
    if (reg == nil) {
        ret R.err[R.Void, str]("mach.lang.target.os: register called with a nil registry");
    }
    if (reg.count > OS_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.os: registry count exceeds its inline storage");
    }
    if (reg.count >= OS_REGISTRY_CAP) {
        ret R.err[R.Void, str]("mach.lang.target.os: registry is at capacity; raise OS_REGISTRY_CAP to register another operating system");
    }
    if (!reg.alloc_ready) {
        ret R.err[R.Void, str]("mach.lang.target.os: registry backing allocator is unavailable");
    }
    val valid: R.Result[R.Void, str] = descriptor_validate(vt, true);
    if (R.is_err[R.Void, str](valid)) { ret valid; }
    if (O.is_some[*OsVTable](lookup(reg, vt.name))) {
        ret R.err[R.Void, str](errf("mach.lang.target.os: an operating system is already registered under this name",
            "mach.lang.target.os: an operating system named '{}' is already registered", vt.name));
    }
    if (dup_os_id(reg, vt.id)) {
        ret R.err[R.Void, str](errf("mach.lang.target.os: an operating system is already registered under this id",
            "mach.lang.target.os: operating system id {} is already registered (wanted to register '{}')", vt.id, vt.name));
    }
    val entry: *OsVTable = ?reg.entries[reg.count];
    @entry = @vt;
    entry.name = nil;
    entry.default_of = nil;
    entry.entry_symbol = nil;
    entry.c_symbol_prefix = nil;
    var si: u32 = 0;
    for (si < OS_OF_MAX) {
        entry.supported_ofs[si] = nil;
        si = si + 1;
    }

    val name_r: R.Result[str, str] = str_copy(?reg.alloc, vt.name);
    if (R.is_err[str, str](name_r)) {
        release_entry(reg, entry);
        ret R.err[R.Void, str](R.unwrap_err[str, str](name_r));
    }
    entry.name = R.unwrap_ok[str, str](name_r);

    val default_of_r: R.Result[str, str] = str_copy(?reg.alloc, vt.default_of);
    if (R.is_err[str, str](default_of_r)) {
        release_entry(reg, entry);
        ret R.err[R.Void, str](R.unwrap_err[str, str](default_of_r));
    }
    entry.default_of = R.unwrap_ok[str, str](default_of_r);

    si = 0;
    for (si < vt.supported_of_count) {
        val supported_of_r: R.Result[str, str] = str_copy(?reg.alloc, vt.supported_ofs[si]);
        if (R.is_err[str, str](supported_of_r)) {
            release_entry(reg, entry);
            ret R.err[R.Void, str](R.unwrap_err[str, str](supported_of_r));
        }
        entry.supported_ofs[si] = R.unwrap_ok[str, str](supported_of_r);
        si = si + 1;
    }

    val entry_symbol_r: R.Result[str, str] = str_copy(?reg.alloc, vt.entry_symbol);
    if (R.is_err[str, str](entry_symbol_r)) {
        release_entry(reg, entry);
        ret R.err[R.Void, str](R.unwrap_err[str, str](entry_symbol_r));
    }
    entry.entry_symbol = R.unwrap_ok[str, str](entry_symbol_r);

    val c_prefix_r: R.Result[str, str] = str_copy(?reg.alloc, vt.c_symbol_prefix);
    if (R.is_err[str, str](c_prefix_r)) {
        release_entry(reg, entry);
        ret R.err[R.Void, str](R.unwrap_err[str, str](c_prefix_r));
    }
    entry.c_symbol_prefix = R.unwrap_ok[str, str](c_prefix_r);

    reg.count = reg.count + 1;
    ret R.ok_void[str]();
}

pub fun lookup(reg: *OsRegistry, name: str) O.Option[*OsVTable] {
    if (reg == nil || reg.count > OS_REGISTRY_CAP) { ret O.none[*OsVTable](); }
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret O.some[*OsVTable](?reg.entries[i]); }
        i = i + 1;
    }
    ret O.none[*OsVTable]();
}

pub fun registered_count(reg: *OsRegistry) u32 {
    if (reg == nil || reg.count > OS_REGISTRY_CAP) { ret 0; }
    ret reg.count;
}

pub fun registered(reg: *OsRegistry, idx: u32) O.Option[*OsVTable] {
    if (reg == nil || reg.count > OS_REGISTRY_CAP || idx >= reg.count) {
        ret O.none[*OsVTable]();
    }
    ret O.some[*OsVTable](?reg.entries[idx]);
}

pub fun support_of(vt: *OsVTable, of_name: str) {
    if (vt.supported_of_count >= OS_OF_MAX) { panic("os.support_of: supported-format list overflow\n"); }
    vt.supported_ofs[vt.supported_of_count] = of_name;
    vt.supported_of_count = vt.supported_of_count + 1;
}

pub fun supports_of(vt: *OsVTable, of_name: str) bool {
    if (vt == nil || vt.supported_of_count > OS_OF_MAX) { ret false; }
    var i: u32 = 0;
    for (i < vt.supported_of_count) {
        if (str_equals(vt.supported_ofs[i], of_name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun support_isa(vt: *OsVTable, arch_id: u32) {
    if (vt.supported_isa_count >= OS_ISA_MAX) { panic("os.support_isa: supported-architecture list overflow\n"); }
    vt.supported_isas[vt.supported_isa_count] = arch_id;
    vt.supported_isa_count = vt.supported_isa_count + 1;
}

pub fun supports_isa(vt: *OsVTable, arch_id: u32) bool {
    if (vt == nil || vt.supported_isa_count > OS_ISA_MAX) { ret false; }
    if (vt.supported_isa_any) { ret true; }
    var i: u32 = 0;
    for (i < vt.supported_isa_count) {
        if (vt.supported_isas[i] == arch_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun native_abi_for(vt: *OsVTable, arch_id: u32) str {
    if (vt.native_abi == nil) { ret ""; }
    ret vt.native_abi(arch_id);
}

pub fun page_size_checked_for(vt: *OsVTable, arch_id: u32) R.Result[u64, str] {
    if (vt == nil) {
        ret R.err[u64, str]("mach.lang.target.os: cannot resolve page size from a nil descriptor");
    }
    var size: u64 = vt.page_size;
    if (vt.page_size_for != nil) { size = vt.page_size_for(arch_id); }
    if (size == 0 || (size & (size - 1)) != 0) {
        ret R.err[u64, str]("mach.lang.target.os: page-size capability returned a non-power-of-two value");
    }
    ret R.ok[u64, str](size);
}

pub fun variadic_stack_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt.variadic_stack == nil) { ret false; }
    ret vt.variadic_stack(arch_id);
}

pub fun reserved_gp_for(vt: *OsVTable, arch_id: u32) u32 {
    if (vt.reserved_gp == nil) { ret 0; }
    ret vt.reserved_gp(arch_id);
}

pub fun natural_stack_args_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt.natural_stack_args == nil) { ret false; }
    ret vt.natural_stack_args(arch_id);
}

pub fun va_list_for(vt: *OsVTable, arch_id: u32) O.Option[VaList] {
    val checked: R.Result[O.Option[VaList], str] = va_list_checked_for(vt, arch_id);
    if (R.is_err[O.Option[VaList], str](checked)) { ret O.none[VaList](); }
    ret R.unwrap_ok[O.Option[VaList], str](checked);
}

pub fun fs_policy_for(vt: *OsVTable, arch_id: u32) O.Option[FsPolicy] {
    val checked: R.Result[O.Option[FsPolicy], str] = fs_policy_checked_for(vt, arch_id);
    if (R.is_err[O.Option[FsPolicy], str](checked)) { ret O.none[FsPolicy](); }
    ret R.unwrap_ok[O.Option[FsPolicy], str](checked);
}

pub fun va_list_checked_for(vt: *OsVTable, arch_id: u32)
    R.Result[O.Option[VaList], str] {
    if (vt == nil || vt.va_list_layout == nil) {
        ret R.err[O.Option[VaList], str]("mach.lang.target.os: missing `va_list` capability");
    }
    val layout: O.Option[VaList] = vt.va_list_layout(arch_id);
    if (O.is_none[VaList](layout)) {
        ret R.ok[O.Option[VaList], str](layout);
    }
    val desc: VaList = O.unwrap[VaList](layout);
    if (desc.size == 0 || desc.align == 0 || (desc.align & (desc.align - 1)) != 0) {
        ret R.err[O.Option[VaList], str]("mach.lang.target.os: `va_list` callback returned an invalid size or alignment");
    }
    ret R.ok[O.Option[VaList], str](layout);
}

pub fun fs_policy_checked_for(vt: *OsVTable, arch_id: u32)
    R.Result[O.Option[FsPolicy], str] {
    if (vt == nil || vt.fs_policy == nil) {
        ret R.err[O.Option[FsPolicy], str]("mach.lang.target.os: missing file-system policy capability");
    }
    val policy: O.Option[FsPolicy] = vt.fs_policy(arch_id);
    if (O.is_none[FsPolicy](policy)) {
        ret R.ok[O.Option[FsPolicy], str](policy);
    }
    val fs: FsPolicy = O.unwrap[FsPolicy](policy);
    if (fs.libdir_len > OS_LIBDIR_MAX) {
        ret R.err[O.Option[FsPolicy], str]("mach.lang.target.os: file-system policy library count exceeds its inline storage");
    }
    var i: u32 = 0;
    for (i < fs.libdir_len) {
        if (str_len(fs.libdirs[i]) == 0) {
            ret R.err[O.Option[FsPolicy], str]("mach.lang.target.os: file-system policy declares an empty active library directory");
        }
        i = i + 1;
    }
    ret R.ok[O.Option[FsPolicy], str](policy);
}

fun variadic_stack_stub(arch_id: u32) bool {
    ret arch_id == 1;
}

test "mach.lang.target.os.variadic_stack_for:reads_policy_and_is_nil_safe" {
    var vt: OsVTable;
    vt.variadic_stack = nil;
    if (variadic_stack_for(?vt, 1)) { ret 1; }
    vt.variadic_stack = variadic_stack_stub;
    if (!variadic_stack_for(?vt, 1)) { ret 1; }
    if (variadic_stack_for(?vt, 2))  { ret 1; }
    ret 0;
}

fun fs_policy_stub(arch_id: u32) O.Option[FsPolicy] {
    if (arch_id != 1) { ret O.none[FsPolicy](); }
    var p: FsPolicy;
    p.dynamic_interpreter = "/stub/ld.so";
    ret O.some[FsPolicy](p);
}

fun universal_fs_policy_stub(arch_id: u32) O.Option[FsPolicy] {
    var p: FsPolicy;
    p.dynamic_interpreter = "";
    ret O.some[FsPolicy](p);
}

test "mach.lang.target.os.fs_policy_for:reads_policy_and_is_nil_safe" {
    var vt: OsVTable;
    vt.fs_policy = nil;
    if (O.is_some[FsPolicy](fs_policy_for(?vt, 1))) { ret 1; }
    vt.fs_policy = fs_policy_stub;
    val got: O.Option[FsPolicy] = fs_policy_for(?vt, 1);
    if (O.is_none[FsPolicy](got)) { ret 1; }
    if (!str_equals(O.unwrap[FsPolicy](got).dynamic_interpreter, "/stub/ld.so")) { ret 1; }
    if (O.is_some[FsPolicy](fs_policy_for(?vt, 2))) { ret 1; }
    ret 0;
}

