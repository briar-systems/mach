test "mach.lang.target.os.supports_isa:declared_and_unrestricted" {
    var vt: OsVTable;
    vt.supported_isa_any   = false;
    vt.supported_isa_count = 0;
    support_isa(?vt, isa.ARCH_X86_64);
    support_isa(?vt, isa.ARCH_AARCH64);
    if (!supports_isa(?vt, isa.ARCH_X86_64))  { ret 1; }
    if (!supports_isa(?vt, isa.ARCH_AARCH64)) { ret 1; }
    if (supports_isa(?vt, isa.ARCH_RISCV64))  { ret 1; }
    if (supports_isa(?vt, isa.ARCH_MOS6502))  { ret 1; }

    vt.supported_isa_any = true;
    if (!supports_isa(?vt, isa.ARCH_RISCV64)) { ret 1; }
    if (!supports_isa(?vt, isa.ARCH_SPIRV))   { ret 1; }
    ret 0;
}

test "mach.lang.target.os.os_id_for:round_trips_every_name" {
    if (os_id_for("linux")        != OS_LINUX)        { ret 1; }
    if (os_id_for("darwin")       != OS_DARWIN)       { ret 1; }
    if (os_id_for("windows")      != OS_WINDOWS)      { ret 1; }
    if (os_id_for("freestanding") != OS_FREESTANDING) { ret 1; }
    if (os_id_for("baremetal")    != OS_UNKNOWN)      { ret 1; }

    if (!str_equals(os_name_for(OS_LINUX),        "linux"))        { ret 1; }
    if (!str_equals(os_name_for(OS_DARWIN),       "darwin"))       { ret 1; }
    if (!str_equals(os_name_for(OS_WINDOWS),      "windows"))      { ret 1; }
    if (!str_equals(os_name_for(OS_FREESTANDING), "freestanding")) { ret 1; }
    if (!str_equals(os_name_for(OS_UNKNOWN),      "unknown"))      { ret 1; }
    ret 0;
}

test "mach.lang.target.os.os_catalog:complete_unique_ordered_roundtrip" {
    if (OSES[0].os != OS_LINUX)        { ret 1; }
    if (OSES[1].os != OS_DARWIN)       { ret 1; }
    if (OSES[2].os != OS_WINDOWS)      { ret 1; }
    if (OSES[3].os != OS_FREESTANDING) { ret 1; }

    var i: usize = 0;
    for (i < OS_N) {
        if (OSES[i].fingerprint_tag != (i + 1)::u8) { ret 1; }
        if (os_id_for(OSES[i].spelling) != OSES[i].os) { ret 1; }
        if (!str_equals(os_name_for(OSES[i].os), OSES[i].spelling)) { ret 1; }

        var j: usize = 0;
        for (j < OS_N) {
            if (i != j) {
                if (OSES[i].os == OSES[j].os) { ret 1; }
                if (str_equals(OSES[i].spelling, OSES[j].spelling)) { ret 1; }
                if (OSES[i].fingerprint_tag == OSES[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun test_os_vtable(id: u32, name: str) OsVTable {
    var vt: OsVTable;
    vt.id                = id;
    vt.name              = name;
    vt.default_of        = "raw";
    vt.page_size         = 4096;
    vt.supported_isa_any = true;
    vt.va_list_layout    = universal_va_list_stub;
    vt.fs_policy         = universal_fs_policy_stub;
    support_of(?vt, "raw");
    ret vt;
}

fun invalid_va_list_stub(arch_id: u32) O.Option[VaList] {
    if (arch_id == isa.ARCH_X86_64) { ret O.some[VaList](va_list(0, 3)); }
    ret O.none[VaList]();
}

fun invalid_fs_policy_stub(arch_id: u32) O.Option[FsPolicy] {
    if (arch_id != isa.ARCH_X86_64) { ret O.none[FsPolicy](); }
    var p: FsPolicy;
    p.libdir_len = OS_LIBDIR_MAX + 1;
    ret O.some[FsPolicy](p);
}

fun empty_fs_policy_stub(arch_id: u32) O.Option[FsPolicy] {
    if (arch_id != isa.ARCH_X86_64) { ret O.none[FsPolicy](); }
    var p: FsPolicy;
    p.libdirs[0] = "";
    p.libdir_len = 1;
    ret O.some[FsPolicy](p);
}

fun invalid_page_size_stub(arch_id: u32) u64 {
    ret 3;
}

test "mach.lang.target.os.register:rejects_malformed_capability_lists" {
    var reg: OsRegistry = registry_init();

    var unknown: OsVTable = test_os_vtable(OS_UNKNOWN, "unknown-id");
    if (!R.is_err[R.Void, str](register(?reg, ?unknown))) { registry_dnit(?reg); ret 1; }

    var no_formats: OsVTable = test_os_vtable(301, "no-formats");
    no_formats.supported_of_count = 0;
    if (!R.is_err[R.Void, str](register(?reg, ?no_formats))) { registry_dnit(?reg); ret 1; }

    var empty_format: OsVTable = test_os_vtable(302, "empty-format");
    empty_format.supported_ofs[0] = "";
    if (!R.is_err[R.Void, str](register(?reg, ?empty_format))) { registry_dnit(?reg); ret 1; }

    var missing_default: OsVTable = test_os_vtable(303, "missing-default");
    missing_default.default_of = "elf";
    if (!R.is_err[R.Void, str](register(?reg, ?missing_default))) { registry_dnit(?reg); ret 1; }

    var duplicate_format: OsVTable = test_os_vtable(304, "duplicate-format");
    support_of(?duplicate_format, "raw");
    if (!R.is_err[R.Void, str](register(?reg, ?duplicate_format))) { registry_dnit(?reg); ret 1; }

    var no_isas: OsVTable = test_os_vtable(305, "no-isas");
    no_isas.supported_isa_any = false;
    if (!R.is_err[R.Void, str](register(?reg, ?no_isas))) { registry_dnit(?reg); ret 1; }

    var wildcard_list: OsVTable = test_os_vtable(306, "wildcard-list");
    support_isa(?wildcard_list, isa.ARCH_X86_64);
    if (!R.is_err[R.Void, str](register(?reg, ?wildcard_list))) { registry_dnit(?reg); ret 1; }

    var unknown_isa: OsVTable = test_os_vtable(307, "unknown-isa");
    unknown_isa.supported_isa_any = false;
    support_isa(?unknown_isa, isa.ARCH_UNKNOWN);
    if (!R.is_err[R.Void, str](register(?reg, ?unknown_isa))) { registry_dnit(?reg); ret 1; }

    var duplicate_isa: OsVTable = test_os_vtable(308, "duplicate-isa");
    duplicate_isa.supported_isa_any = false;
    support_isa(?duplicate_isa, isa.ARCH_X86_64);
    support_isa(?duplicate_isa, isa.ARCH_X86_64);
    if (!R.is_err[R.Void, str](register(?reg, ?duplicate_isa))) { registry_dnit(?reg); ret 1; }

    var invalid_va_list: OsVTable = test_os_vtable(309, "invalid-va-list");
    invalid_va_list.supported_isa_any = false;
    support_isa(?invalid_va_list, isa.ARCH_X86_64);
    invalid_va_list.va_list_layout = invalid_va_list_stub;
    invalid_va_list.fs_policy = fs_policy_stub;
    if (!R.is_err[R.Void, str](register(?reg, ?invalid_va_list))) { registry_dnit(?reg); ret 1; }

    var invalid_fs_policy: OsVTable = test_os_vtable(310, "invalid-fs-policy");
    invalid_fs_policy.supported_isa_any = false;
    support_isa(?invalid_fs_policy, isa.ARCH_X86_64);
    invalid_fs_policy.va_list_layout = va_list_stub;
    invalid_fs_policy.fs_policy = invalid_fs_policy_stub;
    if (!R.is_err[R.Void, str](register(?reg, ?invalid_fs_policy))) { registry_dnit(?reg); ret 1; }

    var empty_fs_policy: OsVTable = test_os_vtable(313, "empty-fs-policy");
    empty_fs_policy.supported_isa_any = false;
    support_isa(?empty_fs_policy, isa.ARCH_X86_64);
    empty_fs_policy.va_list_layout = va_list_stub;
    empty_fs_policy.fs_policy = empty_fs_policy_stub;
    if (!R.is_err[R.Void, str](register(?reg, ?empty_fs_policy))) { registry_dnit(?reg); ret 1; }

    var invalid_page_size: OsVTable = test_os_vtable(314, "invalid-page-size");
    invalid_page_size.supported_isa_any = false;
    support_isa(?invalid_page_size, isa.ARCH_X86_64);
    invalid_page_size.page_size_for = invalid_page_size_stub;
    invalid_page_size.va_list_layout = va_list_stub;
    invalid_page_size.fs_policy = fs_policy_stub;
    if (!R.is_err[R.Void, str](register(?reg, ?invalid_page_size))) { registry_dnit(?reg); ret 1; }

    if (registered_count(?reg) != 0) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.os.registry_validate:rejects_corrupt_storage" {
    var reg: OsRegistry = registry_init();
    var unavailable: OsRegistry = registry_init_with_allocator(nil);
    if (!R.is_err[R.Void, str](registry_validate(nil))) { registry_dnit(?reg); ret 1; }
    if (!R.is_err[R.Void, str](registry_validate(?unavailable))) { registry_dnit(?reg); ret 1; }
    var first: OsVTable = test_os_vtable(311, "first");
    var second: OsVTable = test_os_vtable(312, "second");
    if (R.is_err[R.Void, str](register(?reg, ?first))) { registry_dnit(?reg); ret 1; }
    if (R.is_err[R.Void, str](register(?reg, ?second))) { registry_dnit(?reg); ret 1; }
    if (R.is_err[R.Void, str](registry_validate(?reg))) { registry_dnit(?reg); ret 1; }

    reg.entries[1].id = reg.entries[0].id;
    if (!R.is_err[R.Void, str](registry_validate(?reg))) { registry_dnit(?reg); ret 1; }
    reg.entries[1].id = 312;

    reg.entries[0].supported_of_count = OS_OF_MAX + 1;
    if (!R.is_err[R.Void, str](registry_validate(?reg))) { registry_dnit(?reg); ret 1; }
    reg.entries[0].supported_of_count = 1;

    reg.count = OS_REGISTRY_CAP + 1;
    if (!R.is_err[R.Void, str](registry_validate(?reg))) { reg.count = 2; registry_dnit(?reg); ret 1; }
    reg.count = 2;

    if (R.is_err[R.Void, str](registry_validate(?reg))) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

