# operating-system interface and registry
#
# Defines the `OsVTable` runtime-dispatch interface backed by an `OsRegistry` (a
# session/driver-owned table of vtables keyed by os name), plus the stable
# numeric `OS_*` ids that drive comptime conditional compilation via
# `$mach.os.<name>`. Per-OS implementations (linux, darwin, windows, freestanding)
# supply the entry-point symbol, the default object format, the
# architectures they run on, and the default library directory, and are installed
# into a registry at startup.

use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_equals;

use O: std.types.option;

use mach.lang.target.isa;

# canonical numeric ids for known operating systems. stable across compiler
# versions; user code dispatches on them through `$mach.os.<name>` and
# `$mach.build.os`. `OS_UNKNOWN` is the absence of a known os (an
# unrecognized selector); `OS_FREESTANDING` is the deliberate no-os / bare-metal
# target and is distinct from `OS_UNKNOWN` so the two never compare equal.
pub val OS_UNKNOWN:      u32 = 0;
pub val OS_LINUX:        u32 = 1;
pub val OS_DARWIN:       u32 = 2;
pub val OS_WINDOWS:      u32 = 3;
pub val OS_FREESTANDING: u32 = 4;

# map a target os name to its canonical id
# ---
# name: target os name ("linux", "darwin", "windows", "freestanding")
# ret:  the matching OS_* id, or OS_UNKNOWN when unrecognized
pub fun os_id_for(name: str) u32 {
    if (str_equals(name, "linux"))        { ret OS_LINUX; }
    if (str_equals(name, "darwin"))       { ret OS_DARWIN; }
    if (str_equals(name, "windows"))      { ret OS_WINDOWS; }
    if (str_equals(name, "freestanding")) { ret OS_FREESTANDING; }
    ret OS_UNKNOWN;
}

# map an os id to its canonical name
# ---
# id:  operating-system id (one of OS_*)
# ret: the canonical name, or "unknown" when unrecognized
pub fun os_name_for(id: u32) str {
    if (id == OS_LINUX)        { ret "linux"; }
    if (id == OS_DARWIN)       { ret "darwin"; }
    if (id == OS_WINDOWS)      { ret "windows"; }
    if (id == OS_FREESTANDING) { ret "freestanding"; }
    ret "unknown";
}

# slot capacity of an OsVTable's ordered libdir list
pub val OS_LIBDIR_MAX: u32 = 8;

# slot capacity of an OsVTable's supported-object-format list
pub val OS_OF_MAX: u32 = 8;

# slot capacity of an OsVTable's supported-instruction-set list
pub val OS_ISA_MAX: u32 = 8;

# a per-os position-independence policy, parameterized by architecture id
#
# Returns true when this OS requires main executables to be position-independent
# (PIE) on the given architecture - e.g. Darwin on arm64, where the kernel refuses
# to exec a non-PIE image. The linker reads it through the os vtable so the policy
# lives with the OS (which owns the load-time contract) rather than as an id branch
# in generic link code. A nil `pie_exec` means the OS never requires PIE.
# ---
# arg 0: the target architecture id (one of isa.ARCH_*)
# ret:   true when a PIE main executable is required for that architecture
pub def PieExecFn: fun(u32) bool;

# a per-os segment-alignment page size policy, parameterized by architecture id
#
# Returns the page size the linker aligns segment virtual addresses to for the
# given architecture, chosen so the image loads on every kernel page size that
# architecture supports. It is the OS's own fixed per-arch page where that is
# constant (Darwin: 16 KiB on arm64, 4 KiB on x86_64 - the kernel rejects a
# segment not aligned to it), or the conventional max page where the kernel page
# is configurable (Linux aarch64: 64 KiB, covering 4K/16K/64K-page kernels). The
# linker aligns vaddrs to it and threads the same value into the ELF writer's
# p_align and header-reservation math. A nil `page_size_for` means the OS uses its
# fixed `page_size` for every architecture.
# ---
# arg 0: the target architecture id (one of isa.ARCH_*)
# ret:   the segment-alignment page size in bytes for that architecture
pub def PageSizeFn: fun(u32) u64;

# a per-os native calling-convention policy, parameterized by architecture id
#
# Returns the name of the calling convention (an `AbiVTable.name`, e.g. "sysv64",
# "win64", "aapcs64", "lp64") this OS uses natively on the given architecture. The
# convention is the OS's own fact - Windows defines win64 as its platform ABI,
# while Linux and Darwin adopt the per-arch System V / AAPCS64 / lp64d psABIs - so
# it lives on the OS vtable beside `default_of` rather than as a central os/arch
# table. `mach init` reads it to scaffold a composable (os, isa, abi) tuple. Returns
# "" for an architecture the OS declares no native convention for; a nil
# `native_abi` means the OS declares none for any architecture. It is a
# default/scaffolding datum, not a validity gate - `tuple_capability` stays
# os-abi-agnostic, so a non-standard cross-convention tuple still composes.
# ---
# arg 0: the target architecture id (one of isa.ARCH_*)
# ret:   the native calling-convention name, or "" when the OS covers no convention there
pub def NativeAbiFn: fun(u32) str;

# a per-os C-variadic argument-placement policy, parameterized by architecture id
#
# Returns true when this platform passes EVERY argument in a C call's variadic tail on
# the stack, ignoring the register phase its calling convention uses for named
# arguments. Apple's arm64 ABI does exactly that, a documented divergence from the
# AAPCS64 base standard, which places a variadic argument by the same
# register-then-stack rule as a named one. It is a PLATFORM fact rather than a
# convention fact - darwin and linux compose the very same "aapcs64" vtable, and
# darwin's own x86_64 keeps SysV's ordinary variadic rule - so it is declared here, per
# architecture, and resolved onto the target rather than branched on anywhere.
#
# The rule governs PLACEMENT only: a tail argument keeps whatever by-value /
# by-reference form the convention gave it, and only its location moves. A nil
# `variadic_stack` means the OS never diverges.
# ---
# arg 0: the target architecture id (one of isa.ARCH_*)
# ret:   true when the whole variadic tail is stack-passed on that architecture
pub def VariadicStackFn: fun(u32) bool;

# the operating-system runtime-dispatch interface
#
# Exactly one of these exists per OS; the driver and linker read the entry
# symbol, library directories, and executable load parameters through it and
# never branch on the numeric `id`.
# ---
# id:             operating-system id (one of OS_*)
# name:           os name ("linux", "darwin", "windows")
# default_of:     name of the object format this os defaults to ("elf", "macho",
#                 "coff"); `target.select` resolves the `of` axis through it, so
#                 the default object format is a per-os datum rather than a
#                 central switch. always one of `supported_ofs`
# supported_ofs:  the object formats this os can coherently link and load (its
#                 entry/runtime contract is format-coupled - a Linux ELF entry is
#                 not a Windows COFF entry); only the first `supported_of_count`
#                 entries are valid. this is the os's self-declared joint (os, of)
#                 capability, read through `supports_of` by `mach info targets` and
#                 `target.select_of` so an incoherent pair (e.g. windows + elf)
#                 fails at selection instead of at link
# supported_of_count: number of valid entries in `supported_ofs`
# supported_isas: the isa.ARCH_* ids this os runs on; only the first
#                 `supported_isa_count` entries are valid. the os's self-declared
#                 joint (os, isa) capability - the one fact the object format
#                 cannot stand in for, since an isa-agnostic flat image covers
#                 every architecture and would advertise an os on machines it was
#                 never ported to. read through `supports_isa` by
#                 `target.select_of` and `mach info targets`
# supported_isa_count: number of valid entries in `supported_isas`
# supported_isa_any: true for an os that places no architecture restriction of its
#                 own (freestanding: there is no OS to be ported), which runs on
#                 every instruction set regardless of `supported_isas`
# entry_symbol:   program entry-point symbol ("_start", "_main", ...); the linker
#                 interns it where it keys the symbol table
# c_symbol_prefix: what this platform's C toolchain prepends to a C identifier to
#                 form its object symbol - "_" on Darwin, "" everywhere else. an
#                 `ext fun`/`ext val` names a C declaration, so its link name is
#                 the bare source identifier under this prefix; a `#[symbol("...")]`
#                 decorator is unaffected, since it names the object symbol
#                 literally (which is what lets the runtime's inline asm reach it)
# libdirs:        ordered system library directories the CLI link path probes for
#                 a shared dependency, after the -L dirs; only the first
#                 libdir_len entries are populated. per-OS, so a cross-OS link
#                 never probes the host's directories
# libdir_len:     number of populated entries in libdirs
# dynamic_linker: run-time dynamic-loader path the linker writes into a
#                 dynamically-linked image's interpreter record (the ELF
#                 PT_INTERP), interned by the linker at that point; empty ("")
#                 when no fixed interpreter-path record applies - PE and Mach-O
#                 still support dynamic linking, but load imports through their
#                 own mechanisms (the import directory, LC_LOAD_DYLINKER) rather
#                 than a PT_INTERP path
# base_addr:      base virtual address the first loadable segment maps at; the
#                 linker assigns section vaddrs upward from it
# page_size:      virtual-memory page size in bytes the linker page-aligns
#                 segment virtual addresses to
# stack_probe:    true when the OS commits the stack one guard page at a time, so
#                 a function frame larger than `page_size` must touch each page in
#                 descending order (the `__chkstk` contract) or it faults on
#                 reserved memory (Windows); false when the OS auto-grows the
#                 stack on any in-range fault (Linux, Darwin) and a bare
#                 `sub rsp, N` suffices
# pie_exec:       per-architecture position-independence policy, or nil when the OS
#                 never requires PIE; the linker uses a PIE layout + base-relocation
#                 collection when it returns true for the target architecture
# platform_lib:   the platform shared library a dyld-loaded executable implicitly
#                 links (darwin's /usr/lib/libSystem.B.dylib), or "" when none; the
#                 linker records it as an implicit dependency so the image is a valid
#                 dynamic image (a dyld executable with no LC_LOAD_DYLIB is rejected)
# native_abi:     per-architecture native calling convention, or nil when the OS
#                 declares none; `mach init` reads it through `native_abi_for` to
#                 scaffold a composable (os, isa, abi) tuple without a hardcoded table
# variadic_stack: per-architecture C-variadic placement policy, or nil when the OS
#                 follows its calling convention's ordinary variadic rule everywhere
#                 (every platform but Apple arm64); `target.select` resolves it once
#                 onto `Target.variadic_args_on_stack`, which the call lowering reads
pub rec OsVTable {
    id:                  u32;
    name:                str;
    default_of:          str;
    supported_ofs:       [OS_OF_MAX]str;
    supported_of_count:  u32;
    supported_isas:      [OS_ISA_MAX]u32;
    supported_isa_count: u32;
    supported_isa_any:   bool;
    entry_symbol:        str;
    c_symbol_prefix:     str;
    libdirs:             [OS_LIBDIR_MAX]str;
    libdir_len:          u32;
    dynamic_linker:      str;
    base_addr:           u64;
    page_size:           u64;
    stack_probe:         bool;
    pie_exec:            PieExecFn;
    platform_lib:        str;
    page_size_for:       PageSizeFn;
    native_abi:          NativeAbiFn;
    variadic_stack:      VariadicStackFn;
}

# maximum number of OS implementations an OsRegistry holds
val OS_REGISTRY_CAP: u32 = 8;

# a session/driver-owned table of OS vtables, keyed by os name
#
# Bundled into `target.TargetRegistry`; per-OS implementations are installed
# through `register` at startup, which appends the vtable and keys it by its
# `name`. `target.select` resolves an os by the name the manifest spells.
# ---
# entries: densely-packed registered vtable pointers, in registration order
# count:   number of registered vtables
pub rec OsRegistry {
    entries: [8]*OsVTable;
    count:   u32;
}

# construct a fresh OS registry with every slot empty
# ---
# ret: a zeroed OsRegistry
pub fun registry_init() OsRegistry {
    var r: OsRegistry;
    var i: u32 = 0;
    for (i < OS_REGISTRY_CAP) {
        r.entries[i] = nil;
        i = i + 1;
    }
    r.count = 0;
    ret r;
}

# install an OS vtable into `reg`
#
# Write-once per os name: a second registration under a name already present is
# ignored so the first implementation to initialize wins deterministically. a nil
# vtable, or one past the registry's capacity, is ignored.
# ---
# reg: the registry to install into
# vt:  the OS vtable to register; its `name` is the key
pub fun register(reg: *OsRegistry, vt: *OsVTable) {
    if (vt == nil)                                  { ret; }
    if (O.is_some[*OsVTable](lookup(reg, vt.name))) { ret; }
    if (reg.count >= OS_REGISTRY_CAP)               { ret; }
    reg.entries[reg.count] = vt;
    reg.count = reg.count + 1;
}

# find the OS vtable registered under an os name in `reg`
# ---
# reg:  the registry to read
# name: operating-system name ("linux", "darwin", "windows")
# ret:  the registered vtable, or none if no implementation is registered
pub fun lookup(reg: *OsRegistry, name: str) O.Option[*OsVTable] {
    var i: u32 = 0;
    for (i < reg.count) {
        if (str_equals(reg.entries[i].name, name)) { ret O.some[*OsVTable](reg.entries[i]); }
        i = i + 1;
    }
    ret O.none[*OsVTable]();
}

# the number of OS implementations registered in `reg`
# ---
# reg: the registry to read
# ret: count of registered vtables
pub fun registered_count(reg: *OsRegistry) u32 {
    ret reg.count;
}

# the OS vtable at enumeration index `idx` (0-based, in registration order) in
# `reg`
#
# Pairs with registered_count to walk the registry.
# ---
# reg: the registry to read
# idx: enumeration index in [0, registered_count)
# ret: the vtable at that index, or none when idx is out of range
pub fun registered(reg: *OsRegistry, idx: u32) O.Option[*OsVTable] {
    if (idx >= reg.count) { ret O.none[*OsVTable](); }
    ret O.some[*OsVTable](reg.entries[idx]);
}

# declare that operating system `vt` supports object format `of_name`, appending
# it to the vtable's supported-format list
#
# Panics when the list is already full: exceeding OS_OF_MAX is a fixed-capacity
# code bug in a registrar, not a runtime condition. A registrar resets
# `supported_of_count` to 0 before its first call so re-registration stays
# idempotent.
# ---
# vt:      the os vtable to declare coverage on
# of_name: the object-format name (an immutable str constant, e.g. "elf")
pub fun support_of(vt: *OsVTable, of_name: str) {
    if (vt.supported_of_count >= OS_OF_MAX) { panic("os.support_of: supported-format list overflow\n"); }
    vt.supported_ofs[vt.supported_of_count] = of_name;
    vt.supported_of_count = vt.supported_of_count + 1;
}

# whether operating system `vt` can coherently link and load object format
# `of_name`
#
# `target.select_of` gates the joint (os, of) cell on this so an incoherent pair
# (a Windows COFF entry contract asked to emit an ELF) fails at selection, and
# `mach info targets` requires it for a tuple to be supported.
# ---
# vt:      the os vtable to test
# of_name: the object-format name ("elf", "coff", ...)
# ret:     true when the os supports that object format
pub fun supports_of(vt: *OsVTable, of_name: str) bool {
    var i: u32 = 0;
    for (i < vt.supported_of_count) {
        if (str_equals(vt.supported_ofs[i], of_name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# declare that operating system `vt` runs on instruction set `arch_id`, appending
# it to the vtable's supported-architecture list
#
# Panics when the list is already full: exceeding OS_ISA_MAX is a fixed-capacity
# code bug in a registrar, not a runtime condition. A registrar resets
# `supported_isa_count` to 0 before its first call so re-registration stays
# idempotent. An os that places no architecture restriction of its own declares
# none and sets `supported_isa_any` instead.
# ---
# vt:      the os vtable to declare coverage on
# arch_id: the instruction-set id (one of isa.ARCH_*)
pub fun support_isa(vt: *OsVTable, arch_id: u32) {
    if (vt.supported_isa_count >= OS_ISA_MAX) { panic("os.support_isa: supported-architecture list overflow\n"); }
    vt.supported_isas[vt.supported_isa_count] = arch_id;
    vt.supported_isa_count = vt.supported_isa_count + 1;
}

# whether operating system `vt` runs on instruction set `arch_id`
#
# Reads the os's self-declared architecture support: an os with no restriction of
# its own runs everywhere, otherwise the arch must appear in `supported_isas`.
# `target.select_of` gates the joint (os, isa) cell on this, and `mach info
# targets` derives the advertised matrix from it. The object format cannot carry
# this fact: an isa-agnostic flat image covers every architecture, so an os whose
# default format is `raw` would otherwise be advertised on every machine with an
# encoder rather than the ones it was ported to.
# ---
# vt:      the os vtable to test
# arch_id: the instruction-set id (one of isa.ARCH_*)
# ret:     true when the os runs on that architecture
pub fun supports_isa(vt: *OsVTable, arch_id: u32) bool {
    if (vt.supported_isa_any) { ret true; }
    var i: u32 = 0;
    for (i < vt.supported_isa_count) {
        if (vt.supported_isas[i] == arch_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the calling-convention name operating system `vt` uses natively on architecture
# `arch_id`, or "" when it declares none for that architecture
#
# The nil-safe reader over the vtable's `native_abi` policy: a nil policy (or an
# uncovered architecture) yields "". `mach init` scaffolds the returned convention
# into the target block, or skips the block entirely on "". This is a default
# datum, not a validity gate - `tuple_capability` never consults it.
# ---
# vt:      the os vtable to read
# arch_id: the target architecture id (one of isa.ARCH_*)
# ret:     the native calling-convention name, or "" when none is declared there
pub fun native_abi_for(vt: *OsVTable, arch_id: u32) str {
    if (vt.native_abi == nil) { ret ""; }
    ret vt.native_abi(arch_id);
}

# whether operating system `vt` passes a C call's whole variadic tail on the stack on
# architecture `arch_id`
#
# The nil-safe reader over the vtable's `variadic_stack` policy: a nil policy (every
# OS but darwin) yields false, the selected convention's ordinary rule.
# `target.select` calls this once per resolved target and the backend reads the answer
# off the target, so no call-lowering path names an OS.
# ---
# vt:      the os vtable to read
# arch_id: the target architecture id (one of isa.ARCH_*)
# ret:     true when the whole variadic tail is stack-passed there
pub fun variadic_stack_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt.variadic_stack == nil) { ret false; }
    ret vt.variadic_stack(arch_id);
}

# stub variadic-placement policy for the variadic_stack_for test: covers arch id 1
fun variadic_stack_stub(arch_id: u32) bool {
    ret arch_id == 1;
}

# variadic_stack_for is nil-safe (a nil policy yields the ordinary convention rule)
# and otherwise reads the vtable's policy per architecture
test "mach.lang.target.os.variadic_stack_for:reads_policy_and_is_nil_safe" {
    var vt: OsVTable;
    vt.variadic_stack = nil;
    if (variadic_stack_for(?vt, 1)) { ret 1; }
    vt.variadic_stack = variadic_stack_stub;
    if (!variadic_stack_for(?vt, 1)) { ret 1; }
    if (variadic_stack_for(?vt, 2))  { ret 1; }
    ret 0;
}

# stub native-convention policy for the native_abi_for test: covers arch id 1 only
fun native_abi_stub(arch_id: u32) str {
    if (arch_id == 1) { ret "sysv64"; }
    ret "";
}

# native_abi_for is nil-safe (a nil policy yields "") and otherwise reads the
# vtable's policy, returning "" for an architecture it does not cover
test "mach.lang.target.os.native_abi_for:reads_policy_and_is_nil_safe" {
    var vt: OsVTable;
    vt.native_abi = nil;
    if (!str_equals(native_abi_for(?vt, 1), "")) { ret 1; }
    vt.native_abi = native_abi_stub;
    if (!str_equals(native_abi_for(?vt, 1), "sysv64")) { ret 1; }
    if (!str_equals(native_abi_for(?vt, 2), ""))       { ret 1; }
    ret 0;
}

# supports_isa reads the os's self-declared architecture support: a listed arch
# matches, an unlisted one does not, and an os with no restriction of its own runs
# on every arch
test "mach.lang.target.os.supports_isa:declared_and_unrestricted" {
    var vt: OsVTable;
    vt.supported_isa_any   = false;
    vt.supported_isa_count = 0;
    support_isa(?vt, isa.ARCH_X86_64);
    support_isa(?vt, isa.ARCH_AARCH64);
    if (!supports_isa(?vt, isa.ARCH_X86_64))  { ret 1; }
    if (!supports_isa(?vt, isa.ARCH_AARCH64)) { ret 1; }
    if (supports_isa(?vt, isa.ARCH_RISCV64))  { ret 1; }
    if (supports_isa(?vt, isa.ARCH_MOS6502))  { ret 1; }

    vt.supported_isa_any = true;
    if (!supports_isa(?vt, isa.ARCH_RISCV64)) { ret 1; }
    if (!supports_isa(?vt, isa.ARCH_SPIRV))   { ret 1; }
    ret 0;
}

# os_id_for and os_name_for round-trip every canonical os name, and an
# unrecognized name is OS_UNKNOWN rather than a silent match
test "mach.lang.target.os.os_id_for:round_trips_every_name" {
    if (os_id_for("linux")        != OS_LINUX)        { ret 1; }
    if (os_id_for("darwin")       != OS_DARWIN)       { ret 1; }
    if (os_id_for("windows")      != OS_WINDOWS)      { ret 1; }
    if (os_id_for("freestanding") != OS_FREESTANDING) { ret 1; }
    if (os_id_for("baremetal")    != OS_UNKNOWN)      { ret 1; }

    if (!str_equals(os_name_for(OS_LINUX),        "linux"))        { ret 1; }
    if (!str_equals(os_name_for(OS_DARWIN),       "darwin"))       { ret 1; }
    if (!str_equals(os_name_for(OS_WINDOWS),      "windows"))      { ret 1; }
    if (!str_equals(os_name_for(OS_FREESTANDING), "freestanding")) { ret 1; }
    if (!str_equals(os_name_for(OS_UNKNOWN),      "unknown"))      { ret 1; }
    ret 0;
}
