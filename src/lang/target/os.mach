use mach.lang.fail;
use std.allocator.page;
use std_format: std.format;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.isa;

def PieExecFn: fun(u32) bool;

def PageSizeFn: fun(u32) u64;

val OS_ABI_MAX: u32 = 4;

# the calling conventions an os accepts on one instruction set, the native one
# first: a hosted os names the conventions its platform can carry and refuses
# the rest, a freestanding os declares itself unconstrained and accepts every
# convention the instruction set covers, its first name being only the default
# `mach init` scaffolds. an empty constrained set means the os has no port to
# that instruction set
pub rec AbiSet {
    names:         [OS_ABI_MAX]str;
    len:           u32;
    unconstrained: bool;
}

def AbiSetFn: fun(u32) AbiSet;

pub fun abi_set_none() AbiSet {
    var s: AbiSet;
    s.len           = 0;
    s.unconstrained = false;
    ret s;
}

pub fun abi_set_one(native: str) AbiSet {
    var s: AbiSet = abi_set_none();
    s.names[0] = native;
    s.len      = 1;
    ret s;
}

# a further accepted convention. total over the set's declared capacity, which
# every port's list fits: a set past OS_ABI_MAX is a defect of the descriptor
pub fun abi_set_add(s: *AbiSet, name: str) {
    if (s.len >= OS_ABI_MAX) { panic("mach.lang.target.os: accepted abi set is full\n"); }
    s.names[s.len] = name;
    s.len          = s.len + 1;
}

pub fun abi_set_unconstrained(native: str) AbiSet {
    var s: AbiSet = abi_set_one(native);
    s.unconstrained = true;
    ret s;
}

def VariadicStackFn: fun(u32) bool;

def NaturalStackArgsFn: fun(u32) bool;

# the largest alignment the argument registers honor for the instruction set,
# 0 when the calling convention's own rule stands
def RegArgAlignFn: fun(u32) u32;

# the width in bits the caller widens an integer argument narrower than it to,
# by the argument's signedness, in a register, 0 when the callee does it
def RegArgExtendFn: fun(u32) u32;

# whether the os places an aggregate argument by its declared alignment on the
# instruction set, #[align] included, where the convention takes the natural one
def DeclaredAggAlignFn: fun(u32) bool;

def ReservedGpFn: fun(u32) u32;

# whether the os guarantees, on one instruction set, the processor's
# data-independent-timing mode a DIT_MODE constant-time multiply row needs: a
# process can set the mode at start, the kernel exposes whether the processor
# has it, and the mode is per-thread state the os preserves. declared per (os,
# isa) with its citations beside the declaration, never derived
def DitGuaranteedFn: fun(u32) bool;

pub rec VaList { size: u32; align: u32; }

pub fun va_list(size: u32, align: u32) VaList {
    var v: VaList;
    v.size  = size;
    v.align = align;
    ret v;
}

def VaListFn: fun(u32) opt[VaList];

def FsPolicyFn: fun(u32) opt[catalog_os.FsPolicy];

pub rec OsVTable {
    id:                  u32;
    name:                str;
    default_of:          str;
    supported_ofs:       *str;
    supported_of_count:  u32;
    supported_isas:      *u32;
    supported_isa_count: u32;
    supported_isa_any:   bool;
    entry_symbol:        str;
    c_symbol_prefix:     str;
    base_addr:           u64;
    # the granularity the system's loader maps a segment at, the largest page a
    # kernel of this system may use; 0 when the system has no loader of its own
    # and the object format and the isa decide
    page_size: u64;
    # a frame larger than one probe interval touches each interval of it in
    # order as it allocates, so it faults at the stack's guard rather than
    # stepping over it (encode.STACK_PROBE_INTERVAL)
    stack_probe:        bool;
    mapped_by_loader:   bool;
    pie_exec:           PieExecFn;
    fs_policy:          FsPolicyFn;
    page_size_for:      PageSizeFn;
    accepted_abis:      AbiSetFn;
    variadic_stack:     VariadicStackFn;
    natural_stack_args: NaturalStackArgsFn;
    reg_arg_align:      RegArgAlignFn;
    reg_arg_extend:     RegArgExtendFn;
    declared_agg_align: DeclaredAggAlignFn;
    va_list_layout:     VaListFn;
    reserved_gp:        ReservedGpFn;
    dit_guaranteed:     DitGuaranteedFn;
}

# why a descriptor is malformed, read once when a registry adds it: its
# lists, and the answers its callbacks give for every isa it names
# ---
# a:  formats the refusal
# vt: the descriptor
pub fun validate(a: *A.Allocator, vt: *OsVTable) err[fail.Fail] {
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: a registry was handed a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares an empty name")};
    }
    if (vt.id == catalog_os.UNKNOWN) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system must declare a nonzero id")};
    }
    if ((vt.supported_of_count > 0 && vt.supported_ofs == nil) || (vt.supported_isa_count > 0 && vt.supported_isas == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares a capability list without storage", vt.name)};
    }
    if (str_len(vt.default_of) == 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares an empty `default_of`", vt.name)};
    }
    if (vt.page_size != 0 && (vt.page_size & (vt.page_size - 1)) != 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares an invalid `page_size`", vt.name)};
    }
    if (vt.supported_of_count == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system must declare at least one object format")};
    }
    var default_supported: bool = false;
    var of_i:              u32  = 0;
    for (of_i < vt.supported_of_count) {
        if (str_len(vt.supported_ofs[of_i]) == 0) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares an empty object-format name")};
        }
        if (str_equals(vt.supported_ofs[of_i], vt.default_of)) { default_supported = true; }
        var of_j: u32 = of_i + 1;
        for (of_j < vt.supported_of_count) {
            if (str_equals(vt.supported_ofs[of_i], vt.supported_ofs[of_j])) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares a duplicate object format")};
            }
            of_j = of_j + 1;
        }
        of_i = of_i + 1;
    }
    if (!default_supported) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: the default object format must be present in the supported-format list")};
    }
    if (vt.supported_isa_any && vt.supported_isa_count != 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: wildcard ISA support cannot also carry an explicit ISA list")};
    }
    if (!vt.supported_isa_any && vt.supported_isa_count == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system must declare wildcard or explicit ISA support")};
    }
    if (vt.va_list_layout == nil || vt.fs_policy == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: ISA support requires explicit `va_list` and file-system policy callbacks")};
    }
    var isa_i: u32 = 0;
    for (isa_i < vt.supported_isa_count) {
        if (vt.supported_isas[isa_i] == catalog_arch.UNKNOWN) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares an unknown ISA id")};
        }
        var isa_j: u32 = isa_i + 1;
        for (isa_j < vt.supported_isa_count) {
            if (vt.supported_isas[isa_i] == vt.supported_isas[isa_j]) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares a duplicate ISA id")};
            }
            isa_j = isa_j + 1;
        }
        isa_i = isa_i + 1;
    }
    if (!vt.supported_isa_any) {
        var i: u32 = 0;
        for (i < vt.supported_isa_count) {
            val page_r: res[u64, fail.Fail] = page_size_checked_for(vt, vt.supported_isas[i]);
            if (sel page_r.err) {
                ret err[fail.Fail].err{page_r.err};
            }
            val va_list_r: res[opt[VaList], fail.Fail] =
                va_list_checked_for(vt, vt.supported_isas[i]);
            if (sel va_list_r.err) {
                ret err[fail.Fail].err{va_list_r.err};
            }
            val va_list_opt: opt[VaList] = va_list_r.ok;
            if (sel va_list_opt.none) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares no `va_list` layout for an architecture it supports; read the platform psABI for it and declare the size and alignment rather than registering it undecided")};
            }
            val fs_r: res[opt[catalog_os.FsPolicy], fail.Fail] =
                fs_policy_checked_for(vt, vt.supported_isas[i]);
            if (sel fs_r.err) {
                ret err[fail.Fail].err{fs_r.err};
            }
            val fs_opt: opt[catalog_os.FsPolicy] = fs_r.ok;
            if (sel fs_opt.none) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares no file-system policy for an architecture it supports; declare its sysroot, toolchain root, dynamic interpreter, and default library directories explicitly rather than leaving them undecided")};
            }
            i = i + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

pub fun name_of(vt: *OsVTable) str {
    ret vt.name;
}

pub fun id_of(vt: *OsVTable) u32 {
    ret vt.id;
}

pub fun supports_of(vt: *OsVTable, of_name: str) bool {
    if (vt == nil) { ret false; }
    var i: u32 = 0;
    for (i < vt.supported_of_count) {
        if (str_equals(vt.supported_ofs[i], of_name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun supports_isa(vt: *OsVTable, arch_id: u32) bool {
    if (vt == nil)            { ret false; }
    if (vt.supported_isa_any) { ret true; }
    var i: u32 = 0;
    for (i < vt.supported_isa_count) {
        if (vt.supported_isas[i] == arch_id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the accepted abi set the os declares for an instruction set; an os with no
# declaration accepts nothing
pub fun accepted_abis(vt: *OsVTable, arch_id: u32) AbiSet {
    if (vt.accepted_abis == nil) { ret abi_set_none(); }
    ret vt.accepted_abis(arch_id);
}

# whether the os accepts a calling convention on an instruction set: every
# convention when it declares itself unconstrained, else one of its names
pub fun accepts_abi(vt: *OsVTable, arch_id: u32, abi_name: str) bool {
    val s: AbiSet = accepted_abis(vt, arch_id);
    if (s.unconstrained) { ret true; }
    var i: u32 = 0;
    for (i < s.len) {
        if (str_equals(s.names[i], abi_name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the native calling convention, the first of the accepted set: what `native`
# resolution and `mach init` use; "" when the os has no port to the isa
pub fun native_abi_for(vt: *OsVTable, arch_id: u32) str {
    val s: AbiSet = accepted_abis(vt, arch_id);
    if (s.len == 0) { ret ""; }
    ret s.names[0];
}

pub fun page_size_checked_for(vt: *OsVTable, arch_id: u32) res[u64, fail.Fail] {
    if (vt == nil) {
        ret res[u64, fail.Fail].err{fail.message("mach.lang.target.os: cannot resolve page size from a nil descriptor")};
    }
    var size: u64 = vt.page_size;
    if (vt.page_size_for != nil) { size = vt.page_size_for(arch_id); }
    if (size != 0 && (size & (size - 1)) != 0) {
        ret res[u64, fail.Fail].err{fail.message("mach.lang.target.os: page-size capability returned a non-power-of-two value")};
    }
    ret res[u64, fail.Fail].ok{size};
}

pub fun variadic_stack_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt.variadic_stack == nil) { ret false; }
    ret vt.variadic_stack(arch_id);
}

pub fun reserved_gp_for(vt: *OsVTable, arch_id: u32) u32 {
    if (vt.reserved_gp == nil) { ret 0; }
    ret vt.reserved_gp(arch_id);
}

# the one door onto the DIT declaration: an os that declares nothing
# guarantees nothing
pub fun dit_guaranteed_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt == nil || vt.dit_guaranteed == nil) { ret false; }
    ret vt.dit_guaranteed(arch_id);
}

pub fun natural_stack_args_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt.natural_stack_args == nil) { ret false; }
    ret vt.natural_stack_args(arch_id);
}

pub fun reg_arg_align_for(vt: *OsVTable, arch_id: u32) u32 {
    if (vt.reg_arg_align == nil) { ret 0; }
    ret vt.reg_arg_align(arch_id);
}

pub fun reg_arg_extend_for(vt: *OsVTable, arch_id: u32) u32 {
    if (vt.reg_arg_extend == nil) { ret 0; }
    ret vt.reg_arg_extend(arch_id);
}

pub fun declared_agg_align_for(vt: *OsVTable, arch_id: u32) bool {
    if (vt.declared_agg_align == nil) { ret false; }
    ret vt.declared_agg_align(arch_id);
}

pub fun va_list_checked_for(vt: *OsVTable, arch_id: u32)
    res[opt[VaList], fail.Fail] {
    if (vt == nil || vt.va_list_layout == nil) {
        ret res[opt[VaList], fail.Fail].err{fail.message("mach.lang.target.os: missing `va_list` capability")};
    }
    val layout: opt[VaList] = vt.va_list_layout(arch_id);
    if (sel layout.none) {
        ret res[opt[VaList], fail.Fail].ok{layout};
    }
    val desc: VaList = layout.some;
    if (desc.size == 0 || desc.align == 0 || (desc.align & (desc.align - 1)) != 0) {
        ret res[opt[VaList], fail.Fail].err{fail.message("mach.lang.target.os: `va_list` callback returned an invalid size or alignment")};
    }
    ret res[opt[VaList], fail.Fail].ok{layout};
}

pub fun fs_policy_checked_for(vt: *OsVTable, arch_id: u32)
    res[opt[catalog_os.FsPolicy], fail.Fail] {
    if (vt == nil || vt.fs_policy == nil) {
        ret res[opt[catalog_os.FsPolicy], fail.Fail].err{fail.message("mach.lang.target.os: missing file-system policy capability")};
    }
    val policy: opt[catalog_os.FsPolicy] = vt.fs_policy(arch_id);
    if (sel policy.none) {
        ret res[opt[catalog_os.FsPolicy], fail.Fail].ok{policy};
    }
    val fs: catalog_os.FsPolicy = policy.some;
    if (fs.libdir_len > catalog_os.LIBDIR_MAX) {
        ret res[opt[catalog_os.FsPolicy], fail.Fail].err{fail.message("mach.lang.target.os: file-system policy library count exceeds its inline storage")};
    }
    var i: u32 = 0;
    for (i < fs.libdir_len) {
        if (str_len(fs.libdirs[i]) == 0) {
            ret res[opt[catalog_os.FsPolicy], fail.Fail].err{fail.message("mach.lang.target.os: file-system policy declares an empty active library directory")};
        }
        i = i + 1;
    }
    ret res[opt[catalog_os.FsPolicy], fail.Fail].ok{policy};
}

#[testing]
fun abi_set_stub(arch_id: u32) AbiSet {
    if (arch_id == 1) {
        var s: AbiSet = abi_set_one("sysv64");
        abi_set_add(?s, "win64");
        ret s;
    }
    if (arch_id == 3) { ret abi_set_unconstrained("lp64d"); }
    ret abi_set_none();
}

test accepts_abi__listed_unconstrained_and_undeclared {
    var vt: OsVTable;
    vt.accepted_abis = nil;
    if (!str_equals(native_abi_for(?vt, 1), "")) { ret 1; }
    if (accepts_abi(?vt, 1, "sysv64"))           { ret 1; }
    vt.accepted_abis = abi_set_stub;
    if (!str_equals(native_abi_for(?vt, 1), "sysv64")) { ret 1; }
    if (!str_equals(native_abi_for(?vt, 2), ""))       { ret 1; }
    if (!accepts_abi(?vt, 1, "sysv64"))                { ret 2; }
    if (!accepts_abi(?vt, 1, "win64"))                 { ret 2; }
    if (accepts_abi(?vt, 1, "aapcs64"))                { ret 2; }
    if (accepts_abi(?vt, 2, "sysv64"))                 { ret 2; }
    if (!str_equals(native_abi_for(?vt, 3), "lp64d"))  { ret 3; }
    if (!accepts_abi(?vt, 3, "lp64"))                  { ret 3; }
    if (!accepts_abi(?vt, 3, "anything"))              { ret 3; }
    ret 0;
}

#[testing]
fun fs_policy_stub(arch_id: u32) opt[catalog_os.FsPolicy] {
    if (arch_id != catalog_arch.X86_64) { ret opt[catalog_os.FsPolicy].none{}; }
    var p: catalog_os.FsPolicy;
    p.dynamic_interpreter = "/stub/ld.so";
    ret opt[catalog_os.FsPolicy].some{p};
}

#[testing]
fun universal_fs_policy_stub(arch_id: u32) opt[catalog_os.FsPolicy] {
    var p: catalog_os.FsPolicy;
    p.dynamic_interpreter = "";
    ret opt[catalog_os.FsPolicy].some{p};
}

#[testing]
fun va_list_stub(arch_id: u32) opt[VaList] {
    if (arch_id == catalog_arch.X86_64) { ret opt[VaList].some{va_list(32, 8)}; }
    ret opt[VaList].none{};
}

#[testing]
fun universal_va_list_stub(arch_id: u32) opt[VaList] {
    ret opt[VaList].some{va_list(8, 8)};
}

#[testing]
fun invalid_va_list_stub(arch_id: u32) opt[VaList] {
    if (arch_id == catalog_arch.X86_64) { ret opt[VaList].some{va_list(0, 3)}; }
    ret opt[VaList].none{};
}

#[testing]
fun invalid_fs_policy_stub(arch_id: u32) opt[catalog_os.FsPolicy] {
    if (arch_id != catalog_arch.X86_64) { ret opt[catalog_os.FsPolicy].none{}; }
    var p: catalog_os.FsPolicy;
    p.libdir_len = catalog_os.LIBDIR_MAX + 1;
    ret opt[catalog_os.FsPolicy].some{p};
}

#[testing]
fun empty_fs_policy_stub(arch_id: u32) opt[catalog_os.FsPolicy] {
    if (arch_id != catalog_arch.X86_64) { ret opt[catalog_os.FsPolicy].none{}; }
    var p: catalog_os.FsPolicy;
    p.libdirs[0] = "";
    p.libdir_len = 1;
    ret opt[catalog_os.FsPolicy].some{p};
}

#[testing]
fun invalid_page_size_stub(arch_id: u32) u64 {
    ret 3;
}

#[testing]
val T_RAW: [1]str = [1]str{"raw"};

#[testing]
val T_RAW_TWICE: [2]str = [2]str{"raw", "raw"};

#[testing]
val T_EMPTY_FORMAT: [1]str = [1]str{""};

#[testing]
val T_X86_64: [1]u32 = [1]u32{catalog_arch.X86_64};

#[testing]
val T_AARCH64: [1]u32 = [1]u32{catalog_arch.AARCH64};

#[testing]
val T_UNKNOWN_ISA: [1]u32 = [1]u32{catalog_arch.UNKNOWN};

#[testing]
val T_X86_64_TWICE: [2]u32 = [2]u32{catalog_arch.X86_64, catalog_arch.X86_64};

# a complete descriptor supporting every isa through the universal callbacks
#[testing]
fun test_os_vtable(id: u32, name: str) OsVTable {
    ret OsVTable{
        id:                 id,
        name:               name,
        default_of:         "raw",
        page_size:          4096,
        supported_isa_any:  true,
        va_list_layout:     universal_va_list_stub,
        fs_policy:          universal_fs_policy_stub,
        supported_ofs:      ?T_RAW[0],
        supported_of_count: 1,
    };
}

# the same descriptor narrowed to one explicit isa, answered by the given callbacks
#[testing]
fun test_os_vtable_on(id: u32, name: str, isas: *u32, vl: VaListFn, fs: FsPolicyFn) OsVTable {
    var vt: OsVTable = test_os_vtable(id, name);
    vt.supported_isa_any   = false;
    vt.supported_isas      = isas;
    vt.supported_isa_count = 1;
    vt.va_list_layout      = vl;
    vt.fs_policy           = fs;
    ret vt;
}

#[testing]
fun refused(vt: *OsVTable) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    val r: err[fail.Fail] = validate(?alloc, vt);
    if (sel r.err) { ret true; }
    ret false;
}

test validate__rejects_malformed_descriptors {
    if (!refused(nil)) { ret 2; }

    var no_name: OsVTable = test_os_vtable(301, "");
    if (!refused(?no_name)) { ret 3; }

    var unknown: OsVTable = test_os_vtable(catalog_os.UNKNOWN, "unknown-id");
    if (!refused(?unknown)) { ret 4; }

    var no_storage: OsVTable = test_os_vtable(302, "no-storage");
    no_storage.supported_ofs = nil;
    if (!refused(?no_storage)) { ret 5; }

    var no_default: OsVTable = test_os_vtable(303, "no-default");
    no_default.default_of = "";
    if (!refused(?no_default)) { ret 6; }

    var odd_page: OsVTable = test_os_vtable(304, "odd-page");
    odd_page.page_size = 3;
    if (!refused(?odd_page)) { ret 7; }

    var no_formats: OsVTable = test_os_vtable(305, "no-formats");
    no_formats.supported_of_count = 0;
    if (!refused(?no_formats)) { ret 8; }

    var empty_format: OsVTable = test_os_vtable(306, "empty-format");
    empty_format.supported_ofs = ?T_EMPTY_FORMAT[0];
    if (!refused(?empty_format)) { ret 9; }

    var missing_default: OsVTable = test_os_vtable(307, "missing-default");
    missing_default.default_of = "elf";
    if (!refused(?missing_default)) { ret 10; }

    var duplicate_format: OsVTable = test_os_vtable(308, "duplicate-format");
    duplicate_format.supported_ofs      = ?T_RAW_TWICE[0];
    duplicate_format.supported_of_count = 2;
    if (!refused(?duplicate_format)) { ret 11; }

    var no_isas: OsVTable = test_os_vtable(309, "no-isas");
    no_isas.supported_isa_any = false;
    if (!refused(?no_isas)) { ret 12; }

    var wildcard_list: OsVTable = test_os_vtable(310, "wildcard-list");
    wildcard_list.supported_isas      = ?T_X86_64[0];
    wildcard_list.supported_isa_count = 1;
    if (!refused(?wildcard_list)) { ret 13; }

    var no_va_list: OsVTable = test_os_vtable(311, "no-va-list");
    no_va_list.va_list_layout = nil;
    if (!refused(?no_va_list)) { ret 14; }

