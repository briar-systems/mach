    var reg: OsRegistry = registry_init();
    var a: OsVTable;
    a.id                  = 201;
    a.name                = "os_a";
    a.default_of          = "raw";
    a.page_size           = 4096;
    a.supported_isa_any   = true;
    a.va_list_layout      = universal_va_list_stub;
    a.fs_policy           = universal_fs_policy_stub;
    support_of(?a, "raw");
    if (R.is_err[R.Void, str](register(?reg, ?a))) { registry_dnit(?reg); ret 1; }

    var b: OsVTable;
    b.id                  = 201;
    b.name                = "os_b";
    b.default_of          = "raw";
    b.page_size           = 4096;
    b.supported_isa_any   = true;
    b.va_list_layout      = universal_va_list_stub;
    b.fs_policy           = universal_fs_policy_stub;
    support_of(?b, "raw");
    if (!R.is_err[R.Void, str](register(?reg, ?b))) { registry_dnit(?reg); ret 1; }

    var c: OsVTable;
    c.id                  = 202;
    c.name                = "os_a";
    c.default_of          = "raw";
    c.page_size           = 4096;
    c.supported_isa_any   = true;
    c.va_list_layout      = universal_va_list_stub;
    c.fs_policy           = universal_fs_policy_stub;
    support_of(?c, "raw");
    if (!R.is_err[R.Void, str](register(?reg, ?c))) { registry_dnit(?reg); ret 1; }

    if (!R.is_err[R.Void, str](register(?reg, ?a))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 1) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

test "mach.lang.target.os.registry:owns_registered_descriptors" {
    var first: OsRegistry = registry_init();
    var second: OsRegistry = registry_init();
    var name: [6]u8;
    name[0] = 'o'; name[1] = 'w'; name[2] = 'n'; name[3] = 'e'; name[4] = 'd'; name[5] = 0;
    var default_of: [4]u8;
    default_of[0] = 'r'; default_of[1] = 'a'; default_of[2] = 'w'; default_of[3] = 0;
    var supported_of: [4]u8;
    supported_of[0] = 'e'; supported_of[1] = 'l'; supported_of[2] = 'f'; supported_of[3] = 0;
    var entry_symbol: [7]u8;
    entry_symbol[0] = '_'; entry_symbol[1] = 's'; entry_symbol[2] = 't'; entry_symbol[3] = 'a';
    entry_symbol[4] = 'r'; entry_symbol[5] = 't'; entry_symbol[6] = 0;
    var c_prefix: [2]u8;
    c_prefix[0] = '_'; c_prefix[1] = 0;
    var descriptor: OsVTable;
    descriptor.id                = 211;
    descriptor.name              = (?name[0])::str;
    descriptor.default_of        = (?default_of[0])::str;
    descriptor.page_size         = 4096;
    descriptor.supported_isa_any = true;
    descriptor.va_list_layout    = universal_va_list_stub;
    descriptor.fs_policy         = universal_fs_policy_stub;
    descriptor.entry_symbol      = (?entry_symbol[0])::str;
    descriptor.c_symbol_prefix   = (?c_prefix[0])::str;
    support_of(?descriptor, (?default_of[0])::str);
    support_of(?descriptor, (?supported_of[0])::str);

    if (R.is_err[R.Void, str](register(?first, ?descriptor)))  {
        registry_dnit(?first); registry_dnit(?second); ret 1;
    }
    if (R.is_err[R.Void, str](register(?second, ?descriptor))) {
        registry_dnit(?first); registry_dnit(?second); ret 1;
    }
    name[0]         = 'x';
    default_of[0]   = 'x';
    supported_of[0] = 'x';
    entry_symbol[0] = 'x';
    c_prefix[0]     = 'x';
    descriptor.page_size = 0;

    val first_owned: O.Option[*OsVTable] = lookup(?first, "owned");
    val second_owned: O.Option[*OsVTable] = lookup(?second, "owned");
    if (O.is_none[*OsVTable](first_owned) || O.is_none[*OsVTable](second_owned)) {
        registry_dnit(?first); registry_dnit(?second); ret 1;
    }
    val fv: *OsVTable = O.unwrap[*OsVTable](first_owned);
    val sv: *OsVTable = O.unwrap[*OsVTable](second_owned);
    if (fv.page_size != 4096 || sv.page_size != 4096
        || !str_equals(fv.default_of, "raw") || !str_equals(sv.default_of, "raw")
        || !supports_of(fv, "elf") || !supports_of(sv, "elf")
        || !str_equals(fv.entry_symbol, "_start") || !str_equals(sv.entry_symbol, "_start")
        || !str_equals(fv.c_symbol_prefix, "_") || !str_equals(sv.c_symbol_prefix, "_")) {
        registry_dnit(?first); registry_dnit(?second); ret 1;
    }
    registry_dnit(?first);
    registry_dnit(?second);
    if (registered_count(?first) != 0 || registered_count(?second) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.os.register:refuses_past_capacity" {
    var reg: OsRegistry = registry_init();
    var vts:   [8]OsVTable;
    var names: [8][2]u8;
    var i: u32 = 0;
    for (i < OS_REGISTRY_CAP) {
        names[i][0] = 'a'::u8 + i::u8;
        names[i][1] = 0;
        vts[i].id                = i + 1;
        vts[i].name              = (?names[i][0])::str;
        vts[i].default_of        = "raw";
        vts[i].page_size         = 4096;
        vts[i].supported_isa_any = true;
        vts[i].va_list_layout    = universal_va_list_stub;
        vts[i].fs_policy         = universal_fs_policy_stub;
        support_of(?vts[i], "raw");
        if (R.is_err[R.Void, str](register(?reg, ?vts[i]))) { registry_dnit(?reg); ret 1; }
        i = i + 1;
    }
    if (registered_count(?reg) != OS_REGISTRY_CAP) { registry_dnit(?reg); ret 1; }

    var overflow: OsVTable;
    overflow.id                = 999;
    overflow.name              = "overflow";
    overflow.default_of        = "raw";
    overflow.page_size         = 4096;
    overflow.supported_isa_any = true;
    overflow.va_list_layout    = universal_va_list_stub;
    overflow.fs_policy         = universal_fs_policy_stub;
    support_of(?overflow, "raw");
    if (!R.is_err[R.Void, str](register(?reg, ?overflow))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != OS_REGISTRY_CAP) { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

rec RegistryAllocProbe {
    backing: A.Allocator;
    calls:   u32;
    live:    u32;
    fail_at: u32;
}

fun registry_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret O.none[ptr](); }
    val item: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](item)) { p.live = p.live + 1; }
    ret item;
}

fun registry_probe_reallocate(ctx: ptr, item: ptr, old_size: usize,
                              new_size: usize, align: usize) O.Option[ptr] {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    p.calls = p.calls + 1;
    if (p.calls == p.fail_at) { ret O.none[ptr](); }
    ret p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
}

fun registry_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *RegistryAllocProbe = ctx::*RegistryAllocProbe;
    if (p.live > 0) { p.live = p.live - 1; }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun registry_probe_allocator(p: *RegistryAllocProbe) A.Allocator {
    var alloc: A.Allocator;
    alloc.ctx = p::ptr;
    alloc.fn_allocate = registry_probe_allocate;
    alloc.fn_reallocate = registry_probe_reallocate;
    alloc.fn_deallocate = registry_probe_deallocate;
    ret alloc;
}

test "mach.lang.target.os.registry:partial_allocation_rolls_back" {
    var probe: RegistryAllocProbe;
    if (O.is_some[str](page.make(?probe.backing))) { ret 1; }

    var vt: OsVTable = test_os_vtable(321, "rollback");
    support_of(?vt, "elf");
    vt.entry_symbol = "_start";
    vt.c_symbol_prefix = "_";

    var saw_failure: bool = false;
    var saw_success: bool = false;
    var ordinal: u32 = 1;
    for (ordinal <= 16 && !saw_success) {
        probe.calls = 0; probe.live = 0; probe.fail_at = ordinal;
        var alloc: A.Allocator = registry_probe_allocator(?probe);
        var reg: OsRegistry = registry_init_with_allocator(?alloc);
        val rr: R.Result[R.Void, str] = register(?reg, ?vt);
        if (R.is_err[R.Void, str](rr)) {
            saw_failure = true;
            if (registered_count(?reg) != 0 || probe.live != 0) { registry_dnit(?reg); ret 1; }
        } or {
            saw_success = true;
            if (registered_count(?reg) != 1 || probe.live == 0) { registry_dnit(?reg); ret 1; }
        }
        registry_dnit(?reg);
        if (probe.live != 0) { ret 1; }
        ordinal = ordinal + 1;
    }
    if (!saw_failure || !saw_success) { ret 1; }
    ret 0;
}
