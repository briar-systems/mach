use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use target_of:    mach.lang.target.of;

pub val ABI_MAX: u32 = 4;

# the calling conventions an os accepts on one instruction set, the native one
# first: a hosted os names the conventions its platform can carry and refuses
# the rest, a freestanding os declares itself unconstrained and accepts every
# convention the instruction set covers, its first name being only the default
# `mach init` scaffolds. an empty constrained set means the os has no port to
# that instruction set
pub rec AbiSet {
    names:         [ABI_MAX]str;
    len:           u32;
    unconstrained: bool;
}

pub fun abi_set_none() AbiSet {
    var s: AbiSet;
    s.len           = 0;
    s.unconstrained = false;
    ret s;
}

pub rec VaList { size: u32; align: u32; }

# what an os declares about one instruction set it runs on. a field left zero
# declares nothing: the os default page, no va_list layout, no file-system
# policy, and none of the per-isa calling-convention adjustments
pub rec IsaRow {
    arch: u32;
    abis: AbiSet;
    # the page the loader maps a segment at on this isa, 0 for the os default
    page_size: u64;
    # size 0 when the os declares no layout
    va_list:   VaList;
    fs_policy: *catalog_os.FsPolicy;
    # whether an executable is position independent by default
    pie_exec: bool;
    # whether a variadic call passes every unnamed argument on the stack
    variadic_stack: bool;
    # whether a fixed argument on the stack takes its natural size rather than a slot
    natural_stack_args: bool;
    # the largest alignment the argument registers honor, 0 when the calling
    # convention's own rule stands
    reg_arg_align: u32;
    # the width in bits the caller widens an integer argument narrower than it
    # to, by the argument's signedness, in a register, 0 when the callee does it
    reg_arg_extend: u32;
    # whether an aggregate argument is placed by its declared alignment,
    # #[align] included, where the convention takes the natural one
    declared_agg_align: bool;
    # the general registers the platform keeps for itself, one bit per register
    reserved_gp: u32;
    # whether the os guarantees the processor's data-independent-timing mode a
    # DIT_MODE constant-time multiply row needs: a process can set the mode at
    # start, the kernel exposes whether the processor has it, and the mode is
    # per-thread state the os preserves. declared with its citations beside the
    # row, never derived
    dit_guaranteed: bool;
}

pub rec OsVTable {
    id:                 u32;
    name:               str;
    default_of:         str;
    supported_ofs:      *str;
    supported_of_count: u32;
    # one row per instruction set the os runs on
    isa_rows:      *IsaRow;
    isa_row_count: u32;
    # the row every instruction set without its own row takes, nil when the os
    # runs only on the ones it lists
    isa_any:         *IsaRow;
    entry_symbol:    str;
    c_symbol_prefix: str;
    base_addr:       u64;
    # the granularity the system's loader maps a segment at, the largest page a
    # kernel of this system may use; 0 when the system has no loader of its own
    # and the object format and the isa decide
    page_size: u64;
    # a frame larger than one probe interval touches each interval of it in
    # order as it allocates, so it faults at the stack's guard rather than
    # stepping over it (encode.STACK_PROBE_INTERVAL)
    stack_probe:      bool;
    mapped_by_loader: bool;
    # the directory the system's frameworks are installed in, each as
    # `<name>.framework/<name>`; empty when the system has none
    framework_root: str;
    # how the system names static libraries and executables
    naming: target_of.SystemNaming;
}

# the row the os declares for an instruction set, nil when it does not run on it
pub fun row_for(vt: *OsVTable, arch_id: u32) *IsaRow {
    if (vt == nil) { ret nil; }
    var i: u32 = 0;
    for (i < vt.isa_row_count) {
        if (vt.isa_rows[i].arch == arch_id) { ret ?vt.isa_rows[i]; }
        i = i + 1;
    }
    ret vt.isa_any;
}

# why a descriptor is malformed, read once when a registry adds it: its lists,
# and the rows of every isa it names
# ---
# a:  formats the refusal
# vt: the descriptor
pub fun validate(a: *A.Allocator, vt: *OsVTable) err[fail.Fail] {
    if (vt == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: a registry was handed a nil descriptor")};
    }
    if (str_len(vt.name) == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares an empty name")};
    }
    if (vt.id == catalog_os.UNKNOWN) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system must declare a nonzero id")};
    }
    if ((vt.supported_of_count > 0 && vt.supported_ofs == nil) || (vt.isa_row_count > 0 && vt.isa_rows == nil)) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares a capability list without storage", vt.name)};
    }
    if (str_len(vt.default_of) == 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares an empty `default_of`", vt.name)};
    }
    if (vt.naming.static_prefix == nil || vt.naming.static_suffix == nil || vt.naming.executable_suffix == nil) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares no artifact naming", vt.name)};
    }
    if (vt.page_size != 0 && (vt.page_size & (vt.page_size - 1)) != 0) {
        ret err[fail.Fail].err{fail.formatted(a, "mach.lang.target.os: operating system '{}' declares an invalid `page_size`", vt.name)};
    }
    if (vt.supported_of_count == 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system must declare at least one object format")};
    }
    var default_supported: bool = false;
    var of_i:              u32  = 0;
    for (of_i < vt.supported_of_count) {
        if (str_len(vt.supported_ofs[of_i]) == 0) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares an empty object-format name")};
        }
        if (str_equals(vt.supported_ofs[of_i], vt.default_of)) { default_supported = true; }
        var of_j: u32 = of_i + 1;
        for (of_j < vt.supported_of_count) {
            if (str_equals(vt.supported_ofs[of_i], vt.supported_ofs[of_j])) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares a duplicate object format")};
            }
            of_j = of_j + 1;
        }
        of_i = of_i + 1;
    }
    if (!default_supported) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: the default object format must be present in the supported-format list")};
    }
    if (vt.isa_row_count == 0 && vt.isa_any == nil) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system must declare a row for some ISA or for every ISA")};
    }
    if (vt.isa_any != nil) {
        val any_ok: err[fail.Fail] = row_validate(vt.isa_any);
        if (sel any_ok.err) { ret any_ok; }
    }
    var isa_i: u32 = 0;
    for (isa_i < vt.isa_row_count) {
        val row: *IsaRow = ?vt.isa_rows[isa_i];
        if (row.arch == catalog_arch.UNKNOWN) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares an unknown ISA id")};
        }
        var isa_j: u32 = isa_i + 1;
        for (isa_j < vt.isa_row_count) {
            if (row.arch == vt.isa_rows[isa_j].arch) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares a duplicate ISA id")};
            }
            isa_j = isa_j + 1;
        }
        val row_ok: err[fail.Fail] = row_validate(row);
        if (sel row_ok.err) { ret row_ok; }
        if (row.va_list.size == 0) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares no `va_list` layout for an architecture it supports; read the platform psABI for it and declare the size and alignment rather than registering it undecided")};
        }
        if (row.fs_policy == nil) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: an operating system declares no file-system policy for an architecture it supports; declare its sysroot, toolchain root, dynamic interpreter, and default library directories explicitly rather than leaving them undecided")};
        }
        isa_i = isa_i + 1;
    }
    ret err[fail.Fail].ok{};
}

# why one row is malformed: a page or va_list layout that is not a power of
# two, a policy that overflows its storage or names an empty directory
fun row_validate(row: *IsaRow) err[fail.Fail] {
    if (row.page_size != 0 && (row.page_size & (row.page_size - 1)) != 0) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an ISA row declares a non-power-of-two page size")};
    }
    if (row.abis.len > ABI_MAX) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an ISA row's accepted abi set exceeds its inline storage")};
    }
    if (row.va_list.size != 0 && (row.va_list.align == 0 || (row.va_list.align & (row.va_list.align - 1)) != 0)) {
        ret err[fail.Fail].err{fail.message("mach.lang.target.os: an ISA row declares an invalid `va_list` size or alignment")};
    }
    if (row.fs_policy != nil) {
        val fs: *catalog_os.FsPolicy = row.fs_policy;
        if (fs.libdir_len > catalog_os.LIBDIR_MAX) {
            ret err[fail.Fail].err{fail.message("mach.lang.target.os: file-system policy library count exceeds its inline storage")};
        }
        var i: u32 = 0;
        for (i < fs.libdir_len) {
            if (str_len(fs.libdirs[i]) == 0) {
                ret err[fail.Fail].err{fail.message("mach.lang.target.os: file-system policy declares an empty active library directory")};
            }
            i = i + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

pub fun name_of(vt: *OsVTable) str {
    ret vt.name;
}

pub fun id_of(vt: *OsVTable) u32 {
    ret vt.id;
}

pub fun supports_of(vt: *OsVTable, of_name: str) bool {
    if (vt == nil) { ret false; }
    var i: u32 = 0;
    for (i < vt.supported_of_count) {
        if (str_equals(vt.supported_ofs[i], of_name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun supports_isa(vt: *OsVTable, arch_id: u32) bool {
    ret row_for(vt, arch_id) != nil;
}

# the accepted abi set the os declares for an instruction set; an os with no
# row for it accepts nothing
pub fun accepted_abis(vt: *OsVTable, arch_id: u32) AbiSet {
    val row: *IsaRow = row_for(vt, arch_id);
    if (row == nil) { ret abi_set_none(); }
    ret row.abis;
}

# whether the os accepts a calling convention on an instruction set: every
# convention when it declares itself unconstrained, else one of its names
pub fun accepts_abi(vt: *OsVTable, arch_id: u32, abi_name: str) bool {
    val s: AbiSet = accepted_abis(vt, arch_id);
    if (s.unconstrained) { ret true; }
    var i: u32 = 0;
    for (i < s.len) {
        if (str_equals(s.names[i], abi_name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the native calling convention, the first of the accepted set: what `native`
# resolution and `mach init` use; "" when the os has no port to the isa
pub fun native_abi_for(vt: *OsVTable, arch_id: u32) str {
    val s: AbiSet = accepted_abis(vt, arch_id);
    if (s.len == 0) { ret ""; }
    ret s.names[0];
}

pub fun page_size_checked_for(vt: *OsVTable, arch_id: u32) res[u64, fail.Fail] {
    if (vt == nil) {
        ret res[u64, fail.Fail].err{fail.message("mach.lang.target.os: cannot resolve page size from a nil descriptor")};
    }
    var size: u64     = vt.page_size;
    val row:  *IsaRow = row_for(vt, arch_id);
    if (row != nil && row.page_size != 0) { size = row.page_size; }
    if (size != 0 && (size & (size - 1)) != 0) {
        ret res[u64, fail.Fail].err{fail.message("mach.lang.target.os: page-size capability returned a non-power-of-two value")};
    }
    ret res[u64, fail.Fail].ok{size};
}

pub fun pie_exec_for(vt: *OsVTable, arch_id: u32) bool {
    val row: *IsaRow = row_for(vt, arch_id);
    ret row != nil && row.pie_exec;
}

pub fun variadic_stack_for(vt: *OsVTable, arch_id: u32) bool {
    val row: *IsaRow = row_for(vt, arch_id);
    ret row != nil && row.variadic_stack;
}

pub fun reserved_gp_for(vt: *OsVTable, arch_id: u32) u32 {
    val row: *IsaRow = row_for(vt, arch_id);
    if (row == nil) { ret 0; }
    ret row.reserved_gp;
}

# the one door onto the DIT declaration: an os that declares nothing
# guarantees nothing
pub fun dit_guaranteed_for(vt: *OsVTable, arch_id: u32) bool {
    val row: *IsaRow = row_for(vt, arch_id);
    ret row != nil && row.dit_guaranteed;
}

pub fun natural_stack_args_for(vt: *OsVTable, arch_id: u32) bool {
    val row: *IsaRow = row_for(vt, arch_id);
    ret row != nil && row.natural_stack_args;
}

pub fun reg_arg_align_for(vt: *OsVTable, arch_id: u32) u32 {
    val row: *IsaRow = row_for(vt, arch_id);
    if (row == nil) { ret 0; }
    ret row.reg_arg_align;
}

pub fun reg_arg_extend_for(vt: *OsVTable, arch_id: u32) u32 {
    val row: *IsaRow = row_for(vt, arch_id);
    if (row == nil) { ret 0; }
    ret row.reg_arg_extend;
}

pub fun declared_agg_align_for(vt: *OsVTable, arch_id: u32) bool {
    val row: *IsaRow = row_for(vt, arch_id);
    ret row != nil && row.declared_agg_align;
}

pub fun va_list_checked_for(vt: *OsVTable, arch_id: u32)
    res[opt[VaList], fail.Fail] {
    if (vt == nil) {
        ret res[opt[VaList], fail.Fail].err{fail.message("mach.lang.target.os: missing `va_list` capability")};
    }
    val row: *IsaRow = row_for(vt, arch_id);
    if (row == nil || row.va_list.size == 0) {
        ret res[opt[VaList], fail.Fail].ok{opt[VaList].none{}};
    }
    val desc: VaList = row.va_list;
    if (desc.align == 0 || (desc.align & (desc.align - 1)) != 0) {
        ret res[opt[VaList], fail.Fail].err{fail.message("mach.lang.target.os: `va_list` row declares an invalid size or alignment")};
    }
    ret res[opt[VaList], fail.Fail].ok{opt[VaList].some{desc}};
}

pub fun fs_policy_checked_for(vt: *OsVTable, arch_id: u32)
    res[opt[catalog_os.FsPolicy], fail.Fail] {
    if (vt == nil) {
        ret res[opt[catalog_os.FsPolicy], fail.Fail].err{fail.message("mach.lang.target.os: missing file-system policy capability")};
    }
    val row: *IsaRow = row_for(vt, arch_id);
    if (row == nil || row.fs_policy == nil) {
        ret res[opt[catalog_os.FsPolicy], fail.Fail].ok{opt[catalog_os.FsPolicy].none{}};
    }
    val fs: catalog_os.FsPolicy = @row.fs_policy;
    if (fs.libdir_len > catalog_os.LIBDIR_MAX) {
        ret res[opt[catalog_os.FsPolicy], fail.Fail].err{fail.message("mach.lang.target.os: file-system policy library count exceeds its inline storage")};
    }
    var i: u32 = 0;
    for (i < fs.libdir_len) {
        if (str_len(fs.libdirs[i]) == 0) {
            ret res[opt[catalog_os.FsPolicy], fail.Fail].err{fail.message("mach.lang.target.os: file-system policy declares an empty active library directory")};
        }
        i = i + 1;
    }
    ret res[opt[catalog_os.FsPolicy], fail.Fail].ok{opt[catalog_os.FsPolicy].some{fs}};
}

#[testing]
val T_X86_64_ABIS: [1]IsaRow = [1]IsaRow{
    IsaRow{arch: catalog_arch.X86_64, abis: AbiSet{names: [ABI_MAX]str{"sysv64", "win64", "", ""}, len: 2}},
};

#[testing]
val T_ANY_ABIS: IsaRow = IsaRow{arch: catalog_arch.UNKNOWN, abis: AbiSet{names: [ABI_MAX]str{"lp64d", "", "", ""}, len: 1, unconstrained: true}};

test accepts_abi__listed_unconstrained_and_undeclared {
    var vt: OsVTable;
    if (!str_equals(native_abi_for(?vt, 1), "")) { ret 1; }
    if (accepts_abi(?vt, 1, "sysv64"))           { ret 1; }
    vt.isa_rows      = ?T_X86_64_ABIS[0];
    vt.isa_row_count = 1;
    if (!str_equals(native_abi_for(?vt, catalog_arch.X86_64), "sysv64")) { ret 1; }
    if (!str_equals(native_abi_for(?vt, catalog_arch.AARCH64), ""))      { ret 1; }
    if (!accepts_abi(?vt, catalog_arch.X86_64, "sysv64"))                { ret 2; }
    if (!accepts_abi(?vt, catalog_arch.X86_64, "win64"))                 { ret 2; }
    if (accepts_abi(?vt, catalog_arch.X86_64, "aapcs64"))                { ret 2; }
    if (accepts_abi(?vt, catalog_arch.AARCH64, "sysv64"))                { ret 2; }
    vt.isa_any = ?T_ANY_ABIS;
    if (!str_equals(native_abi_for(?vt, catalog_arch.AARCH64), "lp64d")) { ret 3; }
    if (!accepts_abi(?vt, catalog_arch.AARCH64, "anything"))             { ret 3; }
    if (accepts_abi(?vt, catalog_arch.X86_64, "aapcs64"))                { ret 3; }
    ret 0;
}

#[testing]
val T_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{dynamic_interpreter: "/stub/ld.so"};

#[testing]
val T_POLICY_OVERFLOW: catalog_os.FsPolicy = catalog_os.FsPolicy{libdir_len: catalog_os.LIBDIR_MAX + 1};

#[testing]
val T_POLICY_EMPTY_DIR: catalog_os.FsPolicy = catalog_os.FsPolicy{libdirs: [catalog_os.LIBDIR_MAX]str{"", "", "", "", "", "", "", ""}, libdir_len: 1};

#[testing]
val T_RAW: [1]str = [1]str{"raw"};

#[testing]
val T_RAW_TWICE: [2]str = [2]str{"raw", "raw"};

#[testing]
val T_EMPTY_FORMAT: [1]str = [1]str{""};

#[testing]
val T_ANY: IsaRow = IsaRow{arch: catalog_arch.UNKNOWN, va_list: VaList{size: 8, align: 8}, fs_policy: ?T_POLICY};

# a complete descriptor supporting every isa through one row
#[testing]
fun test_os_vtable(id: u32, name: str) OsVTable {
    ret OsVTable{
        id:                 id,
        name:               name,
        default_of:         "raw",
        page_size:          4096,
        isa_any:            ?T_ANY,
        supported_ofs:      ?T_RAW[0],
        supported_of_count: 1,
        naming:             target_of.SystemNaming{static_prefix: "lib", static_suffix: ".a", executable_suffix: ""},
    };
}

# the same descriptor narrowed to the listed rows
#[testing]
fun test_os_vtable_on(id: u32, name: str, rows: *IsaRow, count: u32) OsVTable {
    var vt: OsVTable = test_os_vtable(id, name);
    vt.isa_any       = nil;
    vt.isa_rows      = rows;
    vt.isa_row_count = count;
    ret vt;
}

#[testing]
fun refused(vt: *OsVTable) bool {
    var alloc: A.Allocator;
    page.make(?alloc);
    val r: err[fail.Fail] = validate(?alloc, vt);
    if (sel r.err) { ret true; }
    ret false;
}

#[testing]
fun t_row(arch: u32) IsaRow {
    ret IsaRow{arch: arch, va_list: VaList{size: 32, align: 8}, fs_policy: ?T_POLICY};
}

test validate__rejects_malformed_descriptors {
    if (!refused(nil)) { ret 2; }

    var no_name: OsVTable = test_os_vtable(301, "");
    if (!refused(?no_name)) { ret 3; }

    var unknown: OsVTable = test_os_vtable(catalog_os.UNKNOWN, "unknown-id");
    if (!refused(?unknown)) { ret 4; }

    var no_storage: OsVTable = test_os_vtable(302, "no-storage");
    no_storage.supported_ofs = nil;
    if (!refused(?no_storage)) { ret 5; }

    var no_default: OsVTable = test_os_vtable(303, "no-default");
    no_default.default_of = "";
    if (!refused(?no_default)) { ret 6; }

    var odd_page: OsVTable = test_os_vtable(304, "odd-page");
    odd_page.page_size = 3;
    if (!refused(?odd_page)) { ret 7; }

    var no_formats: OsVTable = test_os_vtable(305, "no-formats");
    no_formats.supported_of_count = 0;
    if (!refused(?no_formats)) { ret 8; }

    var empty_format: OsVTable = test_os_vtable(306, "empty-format");
    empty_format.supported_ofs = ?T_EMPTY_FORMAT[0];
    if (!refused(?empty_format)) { ret 9; }

    var missing_default: OsVTable = test_os_vtable(307, "missing-default");
    missing_default.default_of = "elf";
    if (!refused(?missing_default)) { ret 10; }

    var duplicate_format: OsVTable = test_os_vtable(308, "duplicate-format");
    duplicate_format.supported_ofs      = ?T_RAW_TWICE[0];
    duplicate_format.supported_of_count = 2;
    if (!refused(?duplicate_format)) { ret 11; }

    var rows: [2]IsaRow = [2]IsaRow{t_row(catalog_arch.X86_64), t_row(catalog_arch.AARCH64)};

    var no_isas: OsVTable = test_os_vtable_on(309, "no-isas", ?rows[0], 0);
    if (!refused(?no_isas)) { ret 12; }

    var no_row_storage: OsVTable = test_os_vtable_on(310, "no-row-storage", nil, 1);
    if (!refused(?no_row_storage)) { ret 13; }

    var declared: OsVTable = test_os_vtable_on(321, "declared", ?rows[0], 2);
    if (refused(?declared)) { ret 14; }

    rows[1].arch = catalog_arch.UNKNOWN;
    if (!refused(?declared)) { ret 16; }

    rows[1].arch = catalog_arch.X86_64;
    if (!refused(?declared)) { ret 17; }

    rows[1]              = t_row(catalog_arch.AARCH64);
    rows[1].va_list.size = 0;
    if (!refused(?declared)) { ret 18; }

    rows[1]           = t_row(catalog_arch.AARCH64);
    rows[1].fs_policy = nil;
    if (!refused(?declared)) { ret 19; }

    rows[1]               = t_row(catalog_arch.AARCH64);
    rows[1].va_list.align = 3;
    if (!refused(?declared)) { ret 20; }

    rows[1]           = t_row(catalog_arch.AARCH64);
    rows[1].fs_policy = ?T_POLICY_OVERFLOW;
    if (!refused(?declared)) { ret 21; }

    rows[1].fs_policy = ?T_POLICY_EMPTY_DIR;
    if (!refused(?declared)) { ret 22; }

    rows[1]           = t_row(catalog_arch.AARCH64);
    rows[1].page_size = 3;
    if (!refused(?declared)) { ret 23; }

    rows[1]          = t_row(catalog_arch.AARCH64);
    rows[1].abis.len = ABI_MAX + 1;
    if (!refused(?declared)) { ret 24; }

    rows[1] = t_row(catalog_arch.AARCH64);
    if (refused(?declared)) { ret 25; }
    ret 0;
}
