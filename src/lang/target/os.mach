    ret 0;
}

test "mach.lang.target.os.register:refuses_an_undeclared_va_list" {
    var reg: OsRegistry = registry_init();

    var bad: OsVTable;
    bad.id                   = 101;
    bad.name                 = "badvl";
    bad.default_of           = "raw";
    bad.page_size            = 4096;
    bad.supported_isa_any    = false;
    bad.supported_isa_count  = 0;
    support_of(?bad, "raw");
    support_isa(?bad, 1);
    bad.va_list_layout       = nil;
    bad.fs_policy            = fs_policy_stub;
    if (R.is_ok[R.Void, str](register(?reg, ?bad))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 0)              { registry_dnit(?reg); ret 1; }

    var good: OsVTable;
    good.id                  = 102;
    good.name                = "goodvl";
    good.default_of          = "raw";
    good.page_size           = 4096;
    good.supported_isa_any   = false;
    good.supported_isa_count = 0;
    support_of(?good, "raw");
    support_isa(?good, 1);
    good.va_list_layout      = va_list_stub;
    good.fs_policy           = fs_policy_stub;
    if (R.is_err[R.Void, str](register(?reg, ?good))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 1)                { registry_dnit(?reg); ret 1; }

    var partial: OsVTable;
    partial.id                  = 103;
    partial.name                = "partialvl";
    partial.default_of          = "raw";
    partial.page_size           = 4096;
    partial.supported_isa_any   = false;
    partial.supported_isa_count = 0;
    support_of(?partial, "raw");
    support_isa(?partial, 2);
    partial.va_list_layout      = va_list_stub;
    partial.fs_policy           = universal_fs_policy_stub;
    if (R.is_ok[R.Void, str](register(?reg, ?partial))) { registry_dnit(?reg); ret 1; }

    var bare: OsVTable;
    bare.id                  = 104;
    bare.name                = "barevl";
    bare.default_of          = "raw";
    bare.page_size           = 4096;
    bare.supported_isa_any   = true;
    bare.supported_isa_count = 0;
    support_of(?bare, "raw");
    bare.va_list_layout      = nil;
    if (!R.is_err[R.Void, str](register(?reg, ?bare))) { registry_dnit(?reg); ret 1; }

    var universal: OsVTable;
    universal.id                  = 105;
    universal.name                = "universalvl";
    universal.default_of          = "raw";
    universal.page_size           = 4096;
    universal.supported_isa_any   = true;
    universal.supported_isa_count = 0;
    support_of(?universal, "raw");
    universal.va_list_layout      = universal_va_list_stub;
    universal.fs_policy           = universal_fs_policy_stub;
    if (R.is_err[R.Void, str](register(?reg, ?universal))) { registry_dnit(?reg); ret 1; }
    if (registered_count(?reg) != 2)                { registry_dnit(?reg); ret 1; }
    registry_dnit(?reg);
    ret 0;
}

