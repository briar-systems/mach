use std.types.bool.bool;
use std.types.string.str;

use riscv_extension: masc.isa.riscv.extension;

use mach.lang.target.extension;

pub val I:        u64 = 1;
pub val M:        u64 = 2;
pub val A:        u64 = 4;
pub val F:        u64 = 8;
pub val D:        u64 = 16;
pub val C:        u64 = 32;
pub val ZICSR:    u64 = 64;
pub val ZIFENCEI: u64 = 128;
# data-independent execution latency: the listed M, Zb and base operations run in
# time independent of their operand values (riscv-crypto scalar spec, Zkt)
pub val ZKT: u64 = 256;
# the integer conditional operations czero.eqz and czero.nez, the branch-free
# select
pub val ZICOND: u64 = 512;
# the half-precision float extensions: Zfhmin moves, loads, stores and
# converts binary16 in the f registers, and Zfh, which brings it, adds the
# arithmetic, comparison and integer conversions. both need F
pub val ZFHMIN: u64 = 1024;
pub val ZFH:    u64 = 2048;
pub val ALL:    u64 = I | M | A | F | D | C | ZICSR | ZIFENCEI | ZKT | ZICOND | ZFHMIN | ZFH;

# the riscv extensions the code generator emits against, each a row of masc's riscv
# catalog, which names it and says what it implies (d brings f and f brings zicsr),
# so a target's `baseline` and its `extensions` list feed one set. i is the base, c is a code-size
# selection mach never emits, and f and d select the float register file and the
# calling convention's float registers, so none of the four is a function's to admit
# alone. zkt is a timing promise about the whole machine the constant-time rows
# read, so it is the target's too
val ROW_COUNT: u32 = 12;

val ONLY_BASELINE: str = "it is the baseline every selection holds";
val ONLY_CODESIZE: str = "it is a code-size selection of the whole target; mach emits no compressed forms";
val ONLY_FLOAT:    str = "it selects the float register file and the calling convention's float registers for the whole target";
val ONLY_TIMING:   str = "it is a promise about the machine's execution timing that the constant-time rows read, not a set of instructions";

val ROWS: [ROW_COUNT]extension.Extension = [ROW_COUNT]extension.Extension{
    extension.Extension{handle: riscv_extension.id.I, bit: I, target_only: ONLY_BASELINE},
    extension.Extension{handle: riscv_extension.id.M, bit: M},
    extension.Extension{handle: riscv_extension.id.A, bit: A},
    extension.Extension{handle: riscv_extension.id.F, bit: F, target_only: ONLY_FLOAT},
    extension.Extension{handle: riscv_extension.id.D, bit: D, target_only: ONLY_FLOAT},
    extension.Extension{handle: riscv_extension.id.C, bit: C, target_only: ONLY_CODESIZE},
    extension.Extension{handle: riscv_extension.id.ZICOND, bit: ZICOND},
    extension.Extension{handle: riscv_extension.id.ZICSR, bit: ZICSR},
    extension.Extension{handle: riscv_extension.id.ZIFENCEI, bit: ZIFENCEI},
    extension.Extension{handle: riscv_extension.id.ZFHMIN, bit: ZFHMIN},
    extension.Extension{handle: riscv_extension.id.ZFH, bit: ZFH},
    extension.Extension{handle: riscv_extension.id.ZKT, bit: ZKT, target_only: ONLY_TIMING},
};

pub val TABLE: extension.Table = extension.Table{source: "masc's riscv catalog", catalog: ?riscv_extension.CATALOG, rows: ?ROWS[0], count: ROW_COUNT, float: float_requirement};

# a selection widened by names from a manifest list and closed over what they
# imply: d brings f, f brings zicsr
pub fun widen(bits: u64, added: u64) u64 {
    ret extension.close(?TABLE, bits | added);
}

# the bits a floating-point width needs passed in float registers: zfhmin for 16-bit
# values, f for 32-bit ones, f and d for 64
pub fun float_requirement(bits: u32) u64 {
    if (bits == 16) { ret F | ZFHMIN; }
    if (bits == 32) { ret F; }
    if (bits == 64) { ret F | D; }
    ret 0;
}

pub fun has(bits: u64, required: u64) bool {
    ret (bits & required) == required;
}
