use x86_extension: masc.isa.x86.extension;

use mach.lang.target.extension;

# the x86_64 extensions the code generator emits against, over the SSE2 baseline,
# each a row of masc's x86 catalog, which names it, says what it implies and
# publishes the x86-64-v2, v3 and v4 levels over it. a row nothing encodes against
# yet is still a declared, probed requirement
pub val SSSE3: u64 = 0x1;

pub val SSE41: u64 = 0x2;

pub val SHA: u64 = 0x4;

pub val FSGSBASE: u64 = 0x8;

pub val POPCNT: u64 = 0x10;

pub val LZCNT: u64 = 0x20;

pub val BMI1: u64 = 0x40;

pub val SSE42: u64 = 0x80;

pub val CX16: u64 = 0x100;

pub val AVX: u64 = 0x200;

pub val AVX2: u64 = 0x400;

pub val BMI2: u64 = 0x800;

pub val FMA: u64 = 0x1000;

pub val MOVBE: u64 = 0x2000;

pub val F16C: u64 = 0x4000;

pub val AVX512F: u64 = 0x8000;

pub val AVX512BW: u64 = 0x10000;

pub val AVX512CD: u64 = 0x20000;

pub val AVX512DQ: u64 = 0x40000;

pub val AVX512VL: u64 = 0x80000;

pub val AES: u64 = 0x100000;

pub val PCLMUL: u64 = 0x200000;

val ROW_COUNT: u32 = 22;

val ROWS: [ROW_COUNT]extension.Extension = [ROW_COUNT]extension.Extension{
    extension.Extension{handle: x86_extension.id.SSSE3, bit: SSSE3},
    extension.Extension{handle: x86_extension.id.SSE41, bit: SSE41},
    extension.Extension{handle: x86_extension.id.SHA, bit: SHA},
    extension.Extension{handle: x86_extension.id.FSGSBASE, bit: FSGSBASE},
    extension.Extension{handle: x86_extension.id.POPCNT, bit: POPCNT},
    extension.Extension{handle: x86_extension.id.LZCNT, bit: LZCNT},
    extension.Extension{handle: x86_extension.id.BMI1, bit: BMI1},
    extension.Extension{handle: x86_extension.id.SSE42, bit: SSE42},
    extension.Extension{handle: x86_extension.id.CX16, bit: CX16},
    extension.Extension{handle: x86_extension.id.AVX, bit: AVX},
    extension.Extension{handle: x86_extension.id.AVX2, bit: AVX2},
    extension.Extension{handle: x86_extension.id.BMI2, bit: BMI2},
    extension.Extension{handle: x86_extension.id.FMA, bit: FMA},
    extension.Extension{handle: x86_extension.id.MOVBE, bit: MOVBE},
    extension.Extension{handle: x86_extension.id.F16C, bit: F16C},
    extension.Extension{handle: x86_extension.id.AVX512F, bit: AVX512F},
    extension.Extension{handle: x86_extension.id.AVX512BW, bit: AVX512BW},
    extension.Extension{handle: x86_extension.id.AVX512CD, bit: AVX512CD},
    extension.Extension{handle: x86_extension.id.AVX512DQ, bit: AVX512DQ},
    extension.Extension{handle: x86_extension.id.AVX512VL, bit: AVX512VL},
    extension.Extension{handle: x86_extension.id.AES, bit: AES},
    extension.Extension{handle: x86_extension.id.PCLMUL, bit: PCLMUL},
};

pub val TABLE: extension.Table = extension.Table{source: "masc's x86 catalog", catalog: ?x86_extension.CATALOG, rows: ?ROWS[0], count: ROW_COUNT};
