use mach.lang.target.extension;

# the x86_64 extension vocabulary over the SSE2 baseline. a row is a name the
# manifest, `$mach.build.extensions.<name>`, `#[extensions(...)]` and the
# inline-asm `requires:` rows all spell; a row nothing encodes against yet is
# still a declared, probed requirement
pub val SSSE3:    u64 = 0x1;

pub val SSE41:    u64 = 0x2;

pub val SHA:      u64 = 0x4;

pub val FSGSBASE: u64 = 0x8;

pub val POPCNT:   u64 = 0x10;

pub val LZCNT:    u64 = 0x20;

pub val BMI1:     u64 = 0x40;

pub val SSE42:    u64 = 0x80;

pub val CX16:     u64 = 0x100;

pub val AVX:      u64 = 0x200;

pub val AVX2:     u64 = 0x400;

val     BMI2:     u64 = 0x800;

val     FMA:      u64 = 0x1000;

val     MOVBE:    u64 = 0x2000;

pub val F16C:     u64 = 0x4000;

pub val AVX512F:  u64 = 0x8000;

val     AVX512BW: u64 = 0x10000;

val     AVX512CD: u64 = 0x20000;

pub val AVX512DQ: u64 = 0x40000;

pub val AVX512VL: u64 = 0x80000;

pub val AES:      u64 = 0x100000;

pub val PCLMUL:   u64 = 0x200000;

pub val NAME_COUNT: u32 = 22;

# sse41 brings ssse3 (sse3 is not modelled, so the chain stops there), sse42
# brings sse41, avx brings sse42, avx2, fma and f16c bring avx, and every
# avx512 set brings avx512f, which brings avx2
pub val NAMES: [NAME_COUNT]extension.Extension = [NAME_COUNT]extension.Extension{
    extension.Extension{name: "ssse3", bit: SSSE3, implies: 0, target_only: nil},
    extension.Extension{name: "sse41", bit: SSE41, implies: SSSE3, target_only: nil},
    extension.Extension{name: "sha", bit: SHA, implies: 0, target_only: nil},
    extension.Extension{name: "fsgsbase", bit: FSGSBASE, implies: 0, target_only: nil},
    extension.Extension{name: "popcnt", bit: POPCNT, implies: 0, target_only: nil},
    extension.Extension{name: "lzcnt", bit: LZCNT, implies: 0, target_only: nil},
    extension.Extension{name: "bmi1", bit: BMI1, implies: 0, target_only: nil},
    extension.Extension{name: "sse42", bit: SSE42, implies: SSE41, target_only: nil},
    extension.Extension{name: "cx16", bit: CX16, implies: 0, target_only: nil},
    extension.Extension{name: "avx", bit: AVX, implies: SSE42, target_only: nil},
    extension.Extension{name: "avx2", bit: AVX2, implies: AVX, target_only: nil},
    extension.Extension{name: "bmi2", bit: BMI2, implies: 0, target_only: nil},
    extension.Extension{name: "fma", bit: FMA, implies: AVX, target_only: nil},
    extension.Extension{name: "movbe", bit: MOVBE, implies: 0, target_only: nil},
    extension.Extension{name: "f16c", bit: F16C, implies: AVX, target_only: nil},
    extension.Extension{name: "avx512f", bit: AVX512F, implies: AVX2, target_only: nil},
    extension.Extension{name: "avx512bw", bit: AVX512BW, implies: AVX512F, target_only: nil},
    extension.Extension{name: "avx512cd", bit: AVX512CD, implies: AVX512F, target_only: nil},
    extension.Extension{name: "avx512dq", bit: AVX512DQ, implies: AVX512F, target_only: nil},
    extension.Extension{name: "avx512vl", bit: AVX512VL, implies: AVX512F, target_only: nil},
    extension.Extension{name: "aes", bit: AES, implies: 0, target_only: nil},
    extension.Extension{name: "pclmul", bit: PCLMUL, implies: 0, target_only: nil},
};

# the published x86-64 microarchitecture levels as manifest spellings. each
# level lists its own members over the v1 baseline (sse2, cmpxchg8b and
# lahf-sahf are the baseline and are not rows) and includes every lower level;
# closing the selection over `implies` adds nothing a level does not already
# name. doc/language/manifest.md carries the same table and a test holds the
# two together
pub val LEVEL_V2: u64 = SSSE3 | SSE41 | SSE42 | POPCNT | CX16;

pub val LEVEL_V3: u64 = LEVEL_V2 | AVX | AVX2 | BMI1 | BMI2 | FMA | LZCNT | MOVBE | F16C;

pub val LEVEL_V4: u64 = LEVEL_V3 | AVX512F | AVX512BW | AVX512CD | AVX512DQ | AVX512VL;

pub val LEVEL_COUNT: u32 = 3;

pub val LEVELS: [LEVEL_COUNT]extension.Level = [LEVEL_COUNT]extension.Level{
    extension.Level{name: "x86-64-v2", members: LEVEL_V2},
    extension.Level{name: "x86-64-v3", members: LEVEL_V3},
    extension.Level{name: "x86-64-v4", members: LEVEL_V4},
};
