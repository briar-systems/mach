# the target tags a program compares against, `$mach.sys.*`, `$mach.arch.*` and
# `$mach.abi.*`, and the ids a resolved target carries for them
#
# every tag is a row of mink's catalogs: a system of its system list, an
# architecture of its architecture list, and a calling convention one of its
# architecture families names. a tag's id is its row's position plus one, 0
# standing for none, so mach states no tag of its own and a row mink adds is a
# tag with no change here
use std.types.size.usize;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;
use std.types.view.view_eq_str;

use mink_arch:      mink.catalog.arch;
use mink_arch_list: mink.catalog.arch.list;
use mink_os:        mink.catalog.os;
use mink_os_list:   mink.catalog.os.list;

# the id of no tag
pub val NONE: u32 = 0;

# the id of mink's system `s`, NONE for one its list does not hold
pub fun sys_id(s: *mink_os.System) u32 {
    var i: usize = 0;
    for (i < mink_os_list.count()) {
        if (mink_os_list.at(i) == s) { ret (i + 1)::u32; }
        i = i + 1;
    }
    ret NONE;
}

# the id of mink's architecture `a`, NONE for one its list does not hold
pub fun arch_id(a: *mink_arch.Arch) u32 {
    var i: usize = 0;
    for (i < mink_arch_list.count()) {
        if (mink_arch_list.at(i) == a) { ret (i + 1)::u32; }
        i = i + 1;
    }
    ret NONE;
}

# the id of the system spelled `name`, NONE for a spelling mink's list does not hold
pub fun sys_named(name: str) u32 {
    var i: usize = 0;
    for (i < mink_os_list.count()) {
        if (str_equals(mink_os_list.at(i).name, name)) { ret (i + 1)::u32; }
        i = i + 1;
    }
    ret NONE;
}

# the id of the architecture spelled `name`, NONE for a spelling mink's list does not hold
pub fun arch_named(name: str) u32 {
    var i: usize = 0;
    for (i < mink_arch_list.count()) {
        if (str_equals(mink_arch_list.at(i).name, name)) { ret (i + 1)::u32; }
        i = i + 1;
    }
    ret NONE;
}

# the name of the system tag `id`, "unknown" for NONE or an id past the list
pub fun sys_name(id: u32) str {
    if (id == NONE || id::usize > mink_os_list.count()) { ret "unknown"; }
    ret mink_os_list.at(id::usize - 1).name;
}

# the name of the architecture tag `id`, "unknown" for NONE or an id past the list
pub fun arch_name(id: u32) str {
    if (id == NONE || id::usize > mink_arch_list.count()) { ret "unknown"; }
    ret mink_arch_list.at(id::usize - 1).name;
}

# the convention row a walk over the families of mink's architectures meets at
# position `k`, counting every row of every family once, in the order the
# architecture list first reaches each family
fun abi_row(k: usize) *mink_arch.Abi {
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < mink_arch_list.count()) {
        val f: *mink_arch.Family = mink_arch_list.at(i).family;
        if (first_reach(f, i)) {
            if (k < seen + f.abi_count) { ret f.abis[k - seen]; }
            seen = seen + f.abi_count;
        }
        i = i + 1;
    }
    ret nil;
}

# whether architecture `i` of the list is the first that reaches family `f`
fun first_reach(f: *mink_arch.Family, i: usize) bool {
    var j: usize = 0;
    for (j < i) {
        if (mink_arch_list.at(j).family == f) { ret false; }
        j = j + 1;
    }
    ret true;
}

# whether the convention row at position `k` is the first to spell its name
fun first_spelling(k: usize) bool {
    val row: *mink_arch.Abi = abi_row(k);
    var j:   usize          = 0;
    for (j < k) {
        if (str_equals(abi_row(j).name, row.name)) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the id of mink's convention row `row`: the id of its spelling, which every row of that
# spelling shares, NONE for a row no family of mink's architectures names
pub fun abi_id(row: *mink_arch.Abi) u32 {
    var id: u32   = 0;
    var k:  usize = 0;
    for (abi_row(k) != nil) {
        if (first_spelling(k)) { id = id + 1; }
        if (abi_row(k) == row) { ret spelling_id(k, id); }
        k = k + 1;
    }
    ret NONE;
}

# the id of the spelling of the row at position `k`, given `id`, the count of first
# spellings up to and including `k`
fun spelling_id(k: usize, id: u32) u32 {
    if (first_spelling(k)) { ret id; }
    ret abi_named(abi_row(k).name);
}

# the id of the calling convention spelled `name`: one per distinct spelling the
# families name, NONE for a spelling none names
pub fun abi_named(name: str) u32 {
    var id: u32   = 0;
    var k:  usize = 0;
    for (abi_row(k) != nil) {
        if (first_spelling(k)) {
            id = id + 1;
            if (str_equals(abi_row(k).name, name)) { ret id; }
        }
        k = k + 1;
    }
    ret NONE;
}

# the spelling of the convention tag `id`, "unknown" for NONE or an id past the rows
pub fun abi_name(id: u32) str {
    var at: u32   = 0;
    var k:  usize = 0;
    for (abi_row(k) != nil) {
        if (first_spelling(k)) {
            at = at + 1;
            if (at == id) { ret abi_row(k).name; }
        }
        k = k + 1;
    }
    ret "unknown";
}

# the id of the system spelled by `name`, as `sys_named`
pub fun sys_named_view(name: View) u32 {
    var i: usize = 0;
    for (i < mink_os_list.count()) {
        if (view_eq_str(name, mink_os_list.at(i).name)) { ret (i + 1)::u32; }
        i = i + 1;
    }
    ret NONE;
}

# the id of the architecture spelled by `name`, as `arch_named`
pub fun arch_named_view(name: View) u32 {
    var i: usize = 0;
    for (i < mink_arch_list.count()) {
        if (view_eq_str(name, mink_arch_list.at(i).name)) { ret (i + 1)::u32; }
        i = i + 1;
    }
    ret NONE;
}

# the id of the convention spelled by `name`, as `abi_named`
pub fun abi_named_view(name: View) u32 {
    var id: u32   = 0;
    var k:  usize = 0;
    for (abi_row(k) != nil) {
        if (first_spelling(k)) {
            id = id + 1;
            if (view_eq_str(name, abi_row(k).name)) { ret id; }
        }
        k = k + 1;
    }
    ret NONE;
}
