# whether one cell of the target matrix, an os, isa, abi and object format, composes, and the refusal that names why not
use mach.lang.fail;
use mach.lang.float;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.text.string.str_free;

use mach.lang.target.abi;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.extension;
use mach.lang.target.isa;
use target_model:   mach.lang.target.model;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;
use mach.lang.textbuild;

pub val OK:              u32 = 0;
#[testing]
pub val COMPLETE_CENSUS: u32 = 27;
pub val NO_CODEGEN:      u32 = 1;
pub val ABI_MISMATCH:    u32 = 2;
pub val OS_NO_OF:        u32 = 3;
pub val OF_UNCOVERED:    u32 = 4;
pub val OF_SHAPE:        u32 = 5;
pub val OS_NO_ISA:       u32 = 6;
pub val ABI_NEEDS_FLOAT: u32 = 7;
pub val ABI_TRANSPORT:   u32 = 8;
pub val OS_ABI:          u32 = 9;

#[testing]
rec CapabilitySpec {
    code:  u32;
    label: str;
}

#[testing]
val CAPABILITY_N: usize                        = 10;
#[testing]
val CAPABILITIES: [CAPABILITY_N]CapabilitySpec = [CAPABILITY_N]CapabilitySpec{
    CapabilitySpec{code: OK, label: "ok"},
    CapabilitySpec{code: NO_CODEGEN, label: "no_codegen"},
    CapabilitySpec{code: ABI_MISMATCH, label: "abi_mismatch"},
    CapabilitySpec{code: OS_NO_OF, label: "os_no_of"},
    CapabilitySpec{code: OF_UNCOVERED, label: "of_uncovered"},
    CapabilitySpec{code: OF_SHAPE, label: "of_shape"},
    CapabilitySpec{code: OS_NO_ISA, label: "os_no_isa"},
    CapabilitySpec{code: ABI_NEEDS_FLOAT, label: "abi_needs_float"},
    CapabilitySpec{code: ABI_TRANSPORT, label: "abi_transport"},
    CapabilitySpec{code: OS_ABI, label: "os_abi"},
};

pub fun capability(os_vt: *lang_target_os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *target_of.OfVTable) u32 {
    if (!isa.has_codegen(isa_vt))           { ret NO_CODEGEN; }
    if (!abi.covers_isa(abi_vt, isa_vt.id)) { ret ABI_MISMATCH; }
    if (abi_vt.passing == catalog_abi.PASSING_VALUES) {
        if (!isa.emits_whole_module(isa_vt)) { ret ABI_TRANSPORT; }
    }
    or (abi_vt.passing == catalog_abi.PASSING_CARRIERS) {
        if (isa_vt.machine == nil) { ret ABI_TRANSPORT; }
    }
    or                                                              { ret ABI_TRANSPORT; }
    if (abi_vt.float_arg_bits > isa_vt.model.flen_bits)             { ret ABI_NEEDS_FLOAT; }
    if (!lang_target_os.supports_isa(os_vt, isa_vt.id))             { ret OS_NO_ISA; }
    if (!lang_target_os.supports_of(os_vt, of_vt.name))             { ret OS_NO_OF; }
    if (!target_of.covers_isa(of_vt, isa_vt.id))                    { ret OF_UNCOVERED; }
    if (isa.emits_whole_module(isa_vt) != of_vt.object_is_artifact) { ret OF_SHAPE; }
    if (!lang_target_os.accepts_abi(os_vt, isa_vt.id, abi_vt.name)) { ret OS_ABI; }
    ret OK;
}

pub fun refusal(a: *A.Allocator, code: u32, os_vt: *lang_target_os.OsVTable, isa_vt: *isa.IsaVTable, abi_vt: *abi.AbiVTable, of_vt: *target_of.OfVTable) fail.Fail {
    if (code == ABI_TRANSPORT) {
        if (abi_vt.passing == catalog_abi.PASSING_VALUES) { ret fail.message("calling convention passes logical values, which only a whole-module emitter can carry"); }
        ret fail.message("calling convention passes physical carriers, which only a register machine can carry");
    }
    if (code == NO_CODEGEN) {
        ret fail.formatted(a, "instruction set '{}' has no code generator in this build", isa_vt.name);
    }
    if (code == ABI_MISMATCH) {
        ret fail.formatted(a, "calling convention '{}' does not target instruction set '{}'", abi_vt.name, isa_vt.name);
    }
    if (code == ABI_NEEDS_FLOAT) {
        val syntax: *extension.SelectionSyntax = catalog_arch.syntax_of(isa_vt.id);
        if (syntax != nil && syntax.claims(isa_vt.name)) {
            val absent: u64 = syntax.float_requirement(abi_vt.float_arg_bits) & ~isa_vt.model.extensions;
            if (absent != 0) {
                var noun: str = "extension";
                if ((absent & (absent - 1)) != 0) { noun = "extensions"; }
                ret fail.formatted(a,
                    "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers: the selection lacks the {} {}",
                    abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits, syntax.letters(absent), noun);
            }
        }
        ret fail.formatted(a,
            "calling convention '{}' passes floating-point arguments in {}-bit float registers, but instruction set '{}' has {}-bit float registers",
            abi_vt.name, abi_vt.float_arg_bits, isa_vt.name, isa_vt.model.flen_bits);
    }
    if (code == OS_NO_ISA) {
        ret fail.formatted(a, "operating system '{}' does not run on instruction set '{}'", os_vt.name, isa_vt.name);
    }
    if (code == OS_ABI) {
        var accepted: lang_target_os.AbiSet = lang_target_os.accepted_abis(os_vt, isa_vt.id);
        if (accepted.len == 0) {
            ret fail.formatted(a, "operating system '{}' declares no calling convention on instruction set '{}', so '{}' cannot host it",
                os_vt.name, catalog_arch.name_for(isa_vt.id), abi_vt.name);
        }
        if (accepted.len == 1) {
            ret fail.formatted(a, "operating system '{}' accepts calling convention '{}' on instruction set '{}', not '{}'",
                os_vt.name, accepted.names[0], catalog_arch.name_for(isa_vt.id), abi_vt.name);
        }
        var b:       textbuild.TextBuilder = textbuild.tb_init(a);
        val names_r: res[str, fail.Fail]   = target_model.spelling_finish(?b, quoted_names_append(?b, ?accepted.names[0], accepted.len));
        if (sel names_r.err) { ret names_r.err; }
        val names: str = names_r.ok;
        fin { str_free(a, names); }
        ret fail.formatted(a, "operating system '{}' accepts calling conventions {} on instruction set '{}', not '{}'",
            os_vt.name, names, catalog_arch.name_for(isa_vt.id), abi_vt.name);
    }
    if (code == OS_NO_OF) {
        ret fail.formatted(a, "operating system '{}' does not support object format '{}'", os_vt.name, of_vt.name);
    }
    if (code == OF_UNCOVERED) {
        ret fail.formatted(a, "object format '{}' does not cover {} relocations", of_vt.name, isa_vt.name);
    }
    if (code == OF_SHAPE) {
        var emits: str = "linkable objects";
        var takes: str = "finished modules";
        if (isa.emits_whole_module(isa_vt)) {
            emits = "finished modules";
            takes = "linkable objects";
        }
        ret fail.formatted(a, "instruction set '{}' emits {}, but object format '{}' carries {}", isa_vt.name, emits, of_vt.name, takes);
    }
    ret fail.formatted(a, "target: capability code {} names no refusal", code);
}

# `names`, each quoted, `, `-separated, appended to `b`
fun quoted_names_append(b: *textbuild.TextBuilder, names: *str, count: u32) err[textbuild.Error] {
    var i: u32 = 0;
    for (i < count) {
        if (i > 0) {
            val sep: err[textbuild.Error] = textbuild.tb_append(b, ", ");
            if (sel sep.err) { ret sep; }
        }
        val open: err[textbuild.Error] = textbuild.tb_append(b, "'");
        if (sel open.err) { ret open; }
        val named: err[textbuild.Error] = textbuild.tb_append(b, names[i]);
        if (sel named.err) { ret named; }
        val close: err[textbuild.Error] = textbuild.tb_append(b, "'");
        if (sel close.err) { ret close; }
        i = i + 1;
    }
    ret err[textbuild.Error].ok{};
}

test capability_catalog__complete_unique_ordered {
    if (CAPABILITIES[0].code != OK)              { ret 1; }
    if (CAPABILITIES[1].code != NO_CODEGEN)      { ret 1; }
    if (CAPABILITIES[2].code != ABI_MISMATCH)    { ret 1; }
    if (CAPABILITIES[3].code != OS_NO_OF)        { ret 1; }
    if (CAPABILITIES[4].code != OF_UNCOVERED)    { ret 1; }
    if (CAPABILITIES[5].code != OF_SHAPE)        { ret 1; }
    if (CAPABILITIES[6].code != OS_NO_ISA)       { ret 1; }
    if (CAPABILITIES[7].code != ABI_NEEDS_FLOAT) { ret 1; }
    if (CAPABILITIES[8].code != ABI_TRANSPORT)   { ret 1; }
    if (CAPABILITIES[9].code != OS_ABI)          { ret 1; }

    var i: usize = 0;
    for (i < CAPABILITY_N) {
        var j: usize = 0;
        for (j < CAPABILITY_N) {
            if (i != j) {
                if (CAPABILITIES[i].code == CAPABILITIES[j].code)             { ret 1; }
                if (str_equals(CAPABILITIES[i].label, CAPABILITIES[j].label)) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
