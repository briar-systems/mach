# destination: the files a writer produces, held in memory until its caller
# publishes them through output. a writer asks here for the buffer of each file
# it writes and fills it, so no writer opens a file, and a link that keeps its
# image in memory takes the bytes instead of publishing them
use mach.lang.fail;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.output;
use output_testing: mach.lang.output.testing;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.memory;
use std.text.string.str_free;
use std.types.error.err;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

# one file a writer produces: the artifact itself, or a companion published
# beside it, as an import library beside the library it binds
# ---
# ext:  empty for the artifact; a companion's extension, with its dot, which
#       takes the place of the artifact's own
# mode: the permissions the file is published with
pub rec File {
    ext:   str;
    bytes: *u8;
    len:   usize;
    mode:  i32;
}

pub rec Destination {
    alloc: *A.Allocator;
    files: *File;
    count: u32;
    cap:   u32;
    # the address the artifact's first byte loads at, which a flat image's
    # writer sets and a link that keeps the image in memory reads
    base: u64;
}

pub fun init(alloc: *A.Allocator) Destination {
    ret Destination{alloc: alloc, files: nil, count: 0, cap: 0, base: 0};
}

pub fun dnit(dst: *Destination) {
    var i: u32 = 0;
    for (i < dst.count) {
        val f: *File = ?dst.files[i];
        if (f.bytes != nil && f.len > 0) { A.deallocate[u8](dst.alloc, f.bytes, f.len); }
        i = i + 1;
    }
    if (dst.files != nil && dst.cap > 0) { A.deallocate[File](dst.alloc, dst.files, dst.cap::usize); }
    dst.files = nil;
    dst.count = 0;
    dst.cap   = 0;
}

# the zeroed buffer of `len` bytes the file under `ext` is written into, owned
# by the destination; a writer adds each file once
pub fun file_add(dst: *Destination, ext: str, len: usize, mode: i32) res[*u8, fail.Fail] {
    var i: u32 = 0;
    for (i < dst.count) {
        if (str_equals(dst.files[i].ext, ext)) {
            ret res[*u8, fail.Fail].err{fail.message("a writer added one file of its destination twice")};
        }
        i = i + 1;
    }
    val grown: err[A.Error] = growth.reserve[File](dst.alloc, ?dst.files, ?dst.cap, dst.count::usize + 1);
    if (sel grown.err) { ret res[*u8, fail.Fail].err{fail.refused(grown.err)}; }
    var bytes: *u8 = nil;
    if (len > 0) {
        val made: res[*u8, A.Error] = A.zallocate[u8](dst.alloc, len);
        if (sel made.err) { ret res[*u8, fail.Fail].err{fail.refused(made.err)}; }
        bytes = made.ok;
    }
    dst.files[dst.count] = File{ext: ext, bytes: bytes, len: len, mode: mode};
    dst.count            = dst.count + 1;
    ret res[*u8, fail.Fail].ok{bytes};
}

# the artifact's file, nil before a writer adds it
pub fun artifact(dst: *Destination) *File {
    var i: u32 = 0;
    for (i < dst.count) {
        if (str_len(dst.files[i].ext) == 0) { ret ?dst.files[i]; }
        i = i + 1;
    }
    ret nil;
}

# the artifact's bytes, which the caller then owns and releases with the
# destination's allocator
pub fun artifact_take(dst: *Destination, len: *usize) res[*u8, fail.Fail] {
    val f: *File = artifact(dst);
    if (f == nil) { ret res[*u8, fail.Fail].err{fail.message("the writer produced no artifact")}; }
    val bytes: *u8 = f.bytes;
    @len    = f.len;
    f.bytes = nil;
    f.len   = 0;
    ret res[*u8, fail.Fail].ok{bytes};
}

# publishes every file: the artifact at `path` and each companion beside it,
# under the artifact's name with the companion's extension
# ---
# op: the operation a failure names, as "cannot publish executable"
pub fun publish(dst: *Destination, itn: *intern.Interner, path: str, op: str) err[fail.Fail] {
    if (artifact(dst) == nil) { ret err[fail.Fail].err{fail.message("the writer produced no artifact")}; }
    var i: u32 = 0;
    for (i < dst.count) {
        val f: *File = ?dst.files[i];
        if (str_len(f.ext) == 0) {
            val wrote: err[fail.Fail] = output.bytes(itn, dst.alloc, path, f.bytes, f.len, f.mode, op);
            if (sel wrote.err) { ret wrote; }
        }
        or {
            val named: res[str, fail.Fail] = companion_path(dst.alloc, path, f.ext);
            if (sel named.err) { ret err[fail.Fail].err{named.err}; }
            fin { str_free(dst.alloc, named.ok); }
            val wrote: err[fail.Fail] = output.bytes(itn, dst.alloc, named.ok, f.bytes, f.len, f.mode, op);
            if (sel wrote.err) { ret wrote; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# `path` with its extension, or its end when it has none, replaced by `ext`
fun companion_path(a: *A.Allocator, path: str, ext: str) res[str, fail.Fail] {
    var keep: usize = str_len(path);
    val own:  str   = types_path.extension(path);
    if (own != nil) { keep = keep - str_len(own) - 1; }
    val el:   usize             = str_len(ext);
    val made: res[*u8, A.Error] = A.allocate[u8](a, keep + el + 1);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.refused(made.err)}; }
    val buf: *u8 = made.ok;
    memory.raw_copy(buf::ptr, path::ptr, keep);
    memory.raw_copy((?buf[keep])::ptr, ext::ptr, el);
    buf[keep + el] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

test publish__writes_the_artifact_and_each_companion_beside_it {
    var alloc: A.Allocator;
    page.make(?alloc);
    var dst: Destination = init(?alloc);
    fin { dnit(?dst); }
    val lib: res[*u8, fail.Fail] = file_add(?dst, "", 2, 0o755);
    if (sel lib.err) { ret 1; }
    lib.ok[0] = 'L';
    lib.ok[1] = 'B';
    val imp: res[*u8, fail.Fail] = file_add(?dst, ".lib", 1, 0o644);
    if (sel imp.err) { ret 1; }
    imp.ok[0] = 'I';
    val again: res[*u8, fail.Fail] = file_add(?dst, ".lib", 1, 0o644);
    if (!sel again.err) { ret 1; }

    val out_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "destination");
    if (sel out_r.err) { ret 1; }
    var out: output_testing.Output = out_r.ok;
    fin { output_testing.dnit(?out); }
    val path:      str            = output_testing.path(?out);
    val published: err[fail.Fail] = publish(?dst, nil, path, "cannot publish");
    if (sel published.err) { ret 1; }

    val main_r: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, path);
    if (sel main_r.err) { ret 1; }
    var main: Vector[u8] = main_r.ok;
    fin { collections_vector.dnit[u8](?main); }
    if (main.len != 2 || main.data[0] != 'L') { ret 1; }
    val side_path: res[str, fail.Fail] = companion_path(?alloc, path, ".lib");
    if (sel side_path.err) { ret 1; }
    fin { str_free(?alloc, side_path.ok); }
    val side: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, side_path.ok);
    if (sel side.err) { ret 1; }
    var sv: Vector[u8] = side.ok;
    fin { collections_vector.dnit[u8](?sv); }
    if (sv.len != 1 || sv.data[0] != 'I') { ret 1; }
    ret 0;
}

test companion_path__takes_the_place_of_the_extension {
    var alloc: A.Allocator;
    page.make(?alloc);
    val swapped: res[str, fail.Fail] = companion_path(?alloc, "out/app.dll", ".lib");
    if (sel swapped.err) { ret 1; }
    fin { str_free(?alloc, swapped.ok); }
    if (!str_equals(swapped.ok, "out/app.lib")) { ret 1; }
    val added: res[str, fail.Fail] = companion_path(?alloc, "out/app", ".lib");
    if (sel added.err) { ret 1; }
    fin { str_free(?alloc, added.ok); }
    if (!str_equals(added.ok, "out/app.lib")) { ret 1; }
    ret 0;
}

test artifact_take__hands_the_bytes_over_once {
    var alloc: A.Allocator;
    page.make(?alloc);
    var dst: Destination = init(?alloc);
    fin { dnit(?dst); }
    var len:  usize               = 0;
    val none: res[*u8, fail.Fail] = artifact_take(?dst, ?len);
    if (!sel none.err) { ret 1; }
    val made: res[*u8, fail.Fail] = file_add(?dst, "", 3, 0o755);
    if (sel made.err) { ret 1; }
    made.ok[2] = 7;
    val taken: res[*u8, fail.Fail] = artifact_take(?dst, ?len);
    if (sel taken.err) { ret 1; }
    fin { A.deallocate[u8](?alloc, taken.ok, len); }
    if (len != 3 || taken.ok[2] != 7) { ret 1; }
    if (artifact(?dst).bytes != nil)  { ret 1; }
    ret 0;
}
