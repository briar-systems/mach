# a lossless encoding of an object image: every section with its bytes, every
# symbol, relocation, frame, import, indirect symbol and export request, the
# machine flags, the attributes, whether codegen made it and whether its
# symbols bound atoms, each with its native metadata. decoding
# gives back the image that was encoded, whatever an object format can spell,
# so a module read back from it links exactly as the image did. the image's
# cache record is not part of it. names are their length then their bytes, a
# nil name the length 0xFFFFFFFF, and every number is little-endian

use mach.lang.fail;
use mach.lang.intern;
use target_of: mach.lang.target.of;
use mach.lang.wire;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

val NIL_NAME: u32 = 0xFFFFFFFF;

# how the image was made, one byte: codegen made it, and its symbols bound atoms
val IMAGE_CODEGEN:      u8 = 0x1;
val IMAGE_SYMBOL_ATOMS: u8 = 0x2;

# the fewest bytes one entry of each collection takes, which bounds a count
# before anything is allocated for it
val SECTION_MIN:  usize = 102;
val SYMBOL_MIN:   usize = 48;
val RELOC_MIN:    usize = 31;
val FRAME_MIN:    usize = 12;
val IMPORT_MIN:   usize = 18;
val INDIRECT_MIN: usize = 16;
val NAME_MIN:     usize = 4;

fun put_name(w: *wire.Sink, itn: *intern.Interner, id: intern.StrId) {
    if (intern.str_is_nil(id)) {
        wire.put_u32(w, NIL_NAME);
        ret;
    }
    val text: opt[str] = intern.get(itn, id);
    if (sel text.none) {
        wire.refuse(w, fail.message("a name is not interned"));
        ret;
    }
    wire.put_sized(w, text.some::*u8, str_len(text.some));
}

fun put_section(w: *wire.Sink, itn: *intern.Interner, sec: *target_of.Section) {
    put_name(w, itn, sec.name);
    wire.put_u8(w, sec.kind);
    wire.put_u32(w, sec.len);
    wire.put_u32(w, sec.align);
    wire.put_u32(w, sec.flags);
    if (sec.bytes == nil) { wire.put_u8(w, 0); }
    or {
        wire.put_u8(w, 1);
        wire.put_bytes(w, sec.bytes, sec.len::usize);
    }
    val native: *target_of.NativeSection = ?sec.native;
    wire.put_u32(w, native.format);
    wire.put_u64(w, native.flags);
    wire.put_u32(w, native.kind);
    wire.put_u64(w, native.entry_size);
    wire.put_bytes(w, ?native.name[0], 16);
    wire.put_bytes(w, ?native.segment[0], 16);
    wire.put_u32(w, native.reserved1);
    wire.put_u32(w, native.reserved2);
    wire.put_u32(w, native.reserved3);
    wire.put_u32(w, native.link_section);
    wire.put_u32(w, native.link_symbol);
    wire.put_u32(w, native.selection);
    wire.put_u32(w, native.checksum);
}

fun put_symbol(w: *wire.Sink, itn: *intern.Interner, sym: *target_of.Symbol) {
    put_name(w, itn, sym.name);
    wire.put_u32(w, target_of.section_index(sym.section));
    wire.put_u32(w, sym.offset);
    wire.put_u32(w, sym.size);
    wire.put_u32(w, sym.flags);
    wire.put_u32(w, sym.fallback);
    wire.put_u32(w, sym.align);
    wire.put_u64(w, sym.absolute_value);
    wire.put_u32(w, sym.native.format);
    wire.put_u32(w, sym.native.kind);
    wire.put_u32(w, sym.native.flags);
}

fun put_relocation(w: *wire.Sink, r: *target_of.Relocation) {
    wire.put_u32(w, target_of.section_index(r.section));
    wire.put_u32(w, r.offset);
    wire.put_u8(w, r.kind);
    wire.put_u32(w, r.sym);
    wire.put_u64(w, r.addend::u64);
    wire.put_u32(w, r.sym2);
    wire.put_u32(w, r.pair);
    wire.put_u8(w, r.inst_end);
    wire.put_u8(w, r.origin);
}

# a frame: its section, offset and step count, then per step its kind,
# register, end offset and value. the link carrier writes frames this way too
pub fun put_frame(w: *wire.Sink, fr: *target_of.FrameUnwind) {
    if (fr.step_count > target_of.FRAME_STEP_CAP) {
        wire.refuse(w, fail.message("a frame holds more steps than a frame can"));
        ret;
    }
    wire.put_u32(w, target_of.section_index(fr.section));
    wire.put_u32(w, fr.offset);
    wire.put_u32(w, fr.step_count);
    var k: u32 = 0;
    for (k < fr.step_count) {
        wire.put_u8(w, fr.steps[k].kind);
        wire.put_u8(w, fr.steps[k].reg);
        wire.put_u32(w, fr.steps[k].end_off);
        wire.put_u64(w, fr.steps[k].value);
        k = k + 1;
    }
}

fun put_import(w: *wire.Sink, itn: *intern.Interner, imp: *target_of.ImportDecl) {
    put_name(w, itn, imp.symbol);
    put_name(w, itn, imp.import_name);
    put_name(w, itn, imp.library);
    wire.put_u32(w, imp.ordinal::u32);
    if (imp.by_name) { wire.put_u8(w, 1); }
    or               { wire.put_u8(w, 0); }
    if (imp.is_code) { wire.put_u8(w, 1); }
    or               { wire.put_u8(w, 0); }
}

fun put_image(w: *wire.Sink, img: *target_of.ObjectImage) {
    val itn: *intern.Interner = img.interner;
    put_name(w, itn, img.name);
    var made: u8 = 0;
    if (img.codegen)      { made = made | IMAGE_CODEGEN; }
    if (img.symbol_atoms) { made = made | IMAGE_SYMBOL_ATOMS; }
    wire.put_u8(w, made);
    wire.put_u32(w, img.machine_flags);
    wire.put_u32(w, img.attributes_len);
    wire.put_bytes(w, img.attributes, img.attributes_len::usize);
    var i: u32 = 0;
    wire.put_u32(w, img.section_count);
    for (i < img.section_count) {
        put_section(w, itn, ?img.sections[i]);
        i = i + 1;
    }
    i = 0;
    wire.put_u32(w, img.symbol_count);
    for (i < img.symbol_count) {
        put_symbol(w, itn, ?img.symbols[i]);
        i = i + 1;
    }
    i = 0;
    wire.put_u32(w, img.reloc_count);
    for (i < img.reloc_count) {
        put_relocation(w, ?img.relocations[i]);
        i = i + 1;
    }
    i = 0;
    wire.put_u32(w, img.frame_count);
    for (i < img.frame_count) {
        put_frame(w, ?img.frames[i]);
        i = i + 1;
    }
    i = 0;
    wire.put_u32(w, img.import_count);
    for (i < img.import_count) {
        put_import(w, itn, ?img.imports[i]);
        i = i + 1;
    }
    i = 0;
    wire.put_u32(w, img.indirect_count);
    for (i < img.indirect_count) {
        val ind: *target_of.NativeIndirect = ?img.indirects[i];
        wire.put_u32(w, target_of.section_index(ind.section));
        wire.put_u32(w, ind.slot);
        wire.put_u32(w, ind.symbol);
        wire.put_u32(w, ind.flags);
        i = i + 1;
    }
    i = 0;
    wire.put_u32(w, img.export_request_count);
    for (i < img.export_request_count) {
        put_name(w, itn, img.export_requests[i]);
        i = i + 1;
    }
}

# the snapshot of img; the caller owns the bytes, allocated in alloc
pub fun encode(alloc: *A.Allocator, img: *target_of.ObjectImage, out_bytes: **u8, out_len: *usize) err[fail.Fail] {
    @out_bytes = nil;
    @out_len   = 0;
    var measure: wire.Sink = wire.measure();
    put_image(?measure, img);
    if (measure.failed) { ret err[fail.Fail].err{fail.message("an object image cannot be snapshotted: a name is not interned or a frame overflows")}; }
    val allocated: res[*u8, A.Error] = A.allocate[u8](alloc, measure.len);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    var w: wire.Sink = wire.fixed(allocated.ok, measure.len);
    put_image(?w, img);
    @out_bytes = allocated.ok;
    @out_len   = measure.len;
    ret err[fail.Fail].ok{};
}

fun take_name(r: *wire.Source, itn: *intern.Interner, oom: *bool) intern.StrId {
    val len: u32 = wire.take_u32(r);
    if (r.bad || len == NIL_NAME) { ret intern.STR_NIL; }
    val at: *u8 = wire.take_bytes(r, len::usize);
    if (at == nil) { ret intern.STR_NIL; }
    val id: res[intern.StrId, A.Error] = intern.bytes_add(itn, at::str, len::usize);
    if (sel id.err) {
        @oom = true;
        wire.reject(r);
        ret intern.STR_NIL;
    }
    ret id.ok;
}

fun zallocate_or_flag[T](alloc: *A.Allocator, r: *wire.Source, oom: *bool, n: u32) *T {
    if (n == 0 || r.bad) { ret nil; }
    val got: res[*T, A.Error] = A.zallocate[T](alloc, n::usize);
    if (sel got.err) {
        @oom = true;
        wire.reject(r);
        ret nil;
    }
    ret got.ok;
}

fun take_section(alloc: *A.Allocator, r: *wire.Source, itn: *intern.Interner, oom: *bool, sec: *target_of.Section) {
    sec.name  = take_name(r, itn, oom);
    sec.kind  = wire.take_u8(r);
    sec.len   = wire.take_u32(r);
    sec.align = wire.take_u32(r);
    sec.flags = wire.take_u32(r);
    val has_bytes: u8 = wire.take_u8(r);
    if (has_bytes > 1 || (has_bytes == 1 && (sec.len == 0 || sec.len::usize > wire.remaining(r)))) { wire.reject(r); }
    if (!r.bad && has_bytes == 1) {
        val got: res[*u8, A.Error] = A.allocate[u8](alloc, sec.len::usize);
        if (sel got.err) {
            @oom = true;
            wire.reject(r);
            ret;
        }
        sec.bytes = got.ok;
        wire.take_into(r, sec.bytes, sec.len::usize);
    }
    val native: *target_of.NativeSection = ?sec.native;
    native.format     = wire.take_u32(r);
    native.flags      = wire.take_u64(r);
    native.kind       = wire.take_u32(r);
    native.entry_size = wire.take_u64(r);
    wire.take_into(r, ?native.name[0], 16);
    wire.take_into(r, ?native.segment[0], 16);
    native.reserved1    = wire.take_u32(r);
    native.reserved2    = wire.take_u32(r);
    native.reserved3    = wire.take_u32(r);
    native.link_section = wire.take_u32(r);
    native.link_symbol  = wire.take_u32(r);
    native.selection    = wire.take_u32(r);
    native.checksum     = wire.take_u32(r);
}

fun take_symbol(r: *wire.Source, itn: *intern.Interner, oom: *bool, sym: *target_of.Symbol) {
    sym.name           = take_name(r, itn, oom);
    sym.section        = target_of.section_id(wire.take_u32(r));
    sym.offset         = wire.take_u32(r);
    sym.size           = wire.take_u32(r);
    sym.flags          = wire.take_u32(r);
    sym.fallback       = wire.take_u32(r);
    sym.align          = wire.take_u32(r);
    sym.absolute_value = wire.take_u64(r);
    sym.native.format  = wire.take_u32(r);
    sym.native.kind    = wire.take_u32(r);
    sym.native.flags   = wire.take_u32(r);
}

fun take_relocation(r: *wire.Source, rel: *target_of.Relocation) {
    rel.section  = target_of.section_id(wire.take_u32(r));
    rel.offset   = wire.take_u32(r);
    rel.kind     = wire.take_u8(r);
    rel.sym      = wire.take_u32(r);
    rel.addend   = wire.take_u64(r)::i64;
    rel.sym2     = wire.take_u32(r);
    rel.pair     = wire.take_u32(r);
    rel.inst_end = wire.take_u8(r);
    rel.origin   = wire.take_u8(r);
}

# a frame put_frame wrote
pub fun take_frame(r: *wire.Source, fr: *target_of.FrameUnwind) {
    fr.section    = target_of.section_id(wire.take_u32(r));
    fr.offset     = wire.take_u32(r);
    fr.step_count = wire.take_u32(r);
    if (fr.step_count > target_of.FRAME_STEP_CAP) {
        wire.reject(r);
        fr.step_count = 0;
    }
    var k: u32 = 0;
    for (k < fr.step_count) {
        fr.steps[k].kind    = wire.take_u8(r);
        fr.steps[k].reg     = wire.take_u8(r);
        fr.steps[k].end_off = wire.take_u32(r);
        fr.steps[k].value   = wire.take_u64(r);
        k                   = k + 1;
    }
}

fun take_import(r: *wire.Source, itn: *intern.Interner, oom: *bool, imp: *target_of.ImportDecl) {
    imp.symbol      = take_name(r, itn, oom);
    imp.import_name = take_name(r, itn, oom);
    imp.library     = take_name(r, itn, oom);
    val ordinal: u32 = wire.take_u32(r);
    val by_name: u8  = wire.take_u8(r);
    val is_code: u8  = wire.take_u8(r);
    if (ordinal > 0xFFFF || by_name > 1 || is_code > 1) { wire.reject(r); }
    imp.ordinal = ordinal::u16;
    imp.by_name = by_name == 1;
    imp.is_code = is_code == 1;
}

fun take_image(alloc: *A.Allocator, r: *wire.Source, itn: *intern.Interner, oom: *bool, out: *target_of.ObjectImage) {
    out.name = take_name(r, itn, oom);
    val made: u8 = wire.take_u8(r);
    if ((made & ~(IMAGE_CODEGEN | IMAGE_SYMBOL_ATOMS)) != 0) { wire.reject(r); }
    out.codegen       = (made & IMAGE_CODEGEN) != 0;
    out.symbol_atoms  = (made & IMAGE_SYMBOL_ATOMS) != 0;
    out.machine_flags = wire.take_u32(r);
    val attributes_len: u32 = wire.take_u32(r);
    if (attributes_len::usize > wire.remaining(r)) { wire.reject(r); }
    out.attributes = zallocate_or_flag[u8](alloc, r, oom, attributes_len);
    if (out.attributes != nil) {
        out.attributes_len = attributes_len;
        wire.take_into(r, out.attributes, attributes_len::usize);
    }

    val sections: u32 = wire.take_count(r, SECTION_MIN);
    out.sections = zallocate_or_flag[target_of.Section](alloc, r, oom, sections);
    if (out.sections != nil) {
        out.section_cap   = sections;
        out.section_count = sections;
    }
    var i: u32 = 0;
    for (i < out.section_count && !r.bad) {
        take_section(alloc, r, itn, oom, ?out.sections[i]);
        i = i + 1;
    }

    val symbols: u32 = wire.take_count(r, SYMBOL_MIN);
    out.symbols = zallocate_or_flag[target_of.Symbol](alloc, r, oom, symbols);
    if (out.symbols != nil) {
        out.symbol_cap   = symbols;
        out.symbol_count = symbols;
    }
    i = 0;
    for (i < out.symbol_count && !r.bad) {
        take_symbol(r, itn, oom, ?out.symbols[i]);
        i = i + 1;
    }

    val relocs: u32 = wire.take_count(r, RELOC_MIN);
    out.relocations = zallocate_or_flag[target_of.Relocation](alloc, r, oom, relocs);
    if (out.relocations != nil) {
        out.reloc_cap   = relocs;
        out.reloc_count = relocs;
    }
    i = 0;
    for (i < out.reloc_count && !r.bad) {
        take_relocation(r, ?out.relocations[i]);
        i = i + 1;
    }

    val frames: u32 = wire.take_count(r, FRAME_MIN);
    out.frames = zallocate_or_flag[target_of.FrameUnwind](alloc, r, oom, frames);
    if (out.frames != nil) {
        out.frame_cap   = frames;
        out.frame_count = frames;
    }
    i = 0;
    for (i < out.frame_count && !r.bad) {
        take_frame(r, ?out.frames[i]);
        i = i + 1;
    }

    val imports: u32 = wire.take_count(r, IMPORT_MIN);
    out.imports = zallocate_or_flag[target_of.ImportDecl](alloc, r, oom, imports);
    if (out.imports != nil) {
        out.import_cap   = imports;
        out.import_count = imports;
    }
    i = 0;
    for (i < out.import_count && !r.bad) {
        take_import(r, itn, oom, ?out.imports[i]);
        i = i + 1;
    }

    val indirects: u32 = wire.take_count(r, INDIRECT_MIN);
    out.indirects = zallocate_or_flag[target_of.NativeIndirect](alloc, r, oom, indirects);
    if (out.indirects != nil) {
        out.indirect_cap   = indirects;
        out.indirect_count = indirects;
    }
    i = 0;
    for (i < out.indirect_count && !r.bad) {
        val ind: *target_of.NativeIndirect = ?out.indirects[i];
        ind.section = target_of.section_id(wire.take_u32(r));
        ind.slot    = wire.take_u32(r);
        ind.symbol  = wire.take_u32(r);
        ind.flags   = wire.take_u32(r);
        i           = i + 1;
    }

    val requests: u32 = wire.take_count(r, NAME_MIN);
    out.export_requests = zallocate_or_flag[intern.StrId](alloc, r, oom, requests);
    if (out.export_requests != nil) {
        out.export_request_cap   = requests;
        out.export_request_count = requests;
    }
    i = 0;
    for (i < out.export_request_count && !r.bad) {
        out.export_requests[i] = take_name(r, itn, oom);
        i                      = i + 1;
    }
}

# the image a snapshot holds, owned in alloc with its names in itn: false when
# the bytes are truncated, trail, or do not describe a valid image. err only
# when allocation fails
pub fun decode(alloc: *A.Allocator, itn: *intern.Interner, bytes: *u8, len: usize,
    out: *target_of.ObjectImage) res[bool, fail.Fail] {
    @out = target_of.object_image_init(alloc, itn, intern.STR_NIL);
    if (bytes == nil) { ret res[bool, fail.Fail].ok{false}; }
    var r:   wire.Source = wire.source(bytes, len);
    var oom: bool        = false;
    take_image(alloc, ?r, itn, ?oom, out);
    if (!wire.done(?r)) {
        target_of.object_image_dnit(out);
        if (oom) { ret res[bool, fail.Fail].err{fail.message("out of memory decoding an object snapshot")}; }
        ret res[bool, fail.Fail].ok{false};
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object_or_dnit(out);
    if (sel valid.err) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{true};
}
