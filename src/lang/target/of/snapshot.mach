# a lossless encoding of an object image: every section with its bytes, every
# symbol, relocation, frame, import, indirect symbol and export request, the
# machine flags and the attributes, each with its native metadata. decoding
# gives back the image that was encoded, whatever an object format can spell,
# so a module read back from it links exactly as the image did. the image's
# cache record is not part of it. names are their length then their bytes, a
# nil name the length 0xFFFFFFFF, and every number is little-endian

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

val NIL_NAME: u32 = 0xFFFFFFFF;

# the fewest bytes one entry of each collection takes, which bounds a count
# before anything is allocated for it
val SECTION_MIN:  usize = 102;
val SYMBOL_MIN:   usize = 48;
val RELOC_MIN:    usize = 29;
val FRAME_MIN:    usize = 12;
val IMPORT_MIN:   usize = 18;
val INDIRECT_MIN: usize = 16;
val NAME_MIN:     usize = 4;

# measures while buf is nil, writes once it is not
rec Sink {
    buf: *u8;
    pos: usize;
    itn: *intern.Interner;
    bad: bool;
}

fun put_u8(w: *Sink, v: u8) {
    if (w.buf != nil) { w.buf[w.pos] = v; }
    w.pos = w.pos + 1;
}

fun put_u32(w: *Sink, v: u32) {
    if (w.buf != nil) { bin.write_u32_le(w.buf, w.pos, v); }
    w.pos = w.pos + 4;
}

fun put_u64(w: *Sink, v: u64) {
    if (w.buf != nil) { bin.write_u64_le(w.buf, w.pos, v); }
    w.pos = w.pos + 8;
}

fun put_bytes(w: *Sink, data: *u8, len: usize) {
    if (w.buf != nil && len > 0) { memory.raw_copy((w.buf::usize + w.pos)::ptr, data::ptr, len); }
    w.pos = w.pos + len;
}

fun put_name(w: *Sink, id: intern.StrId) {
    if (id == intern.STR_NIL) {
        put_u32(w, NIL_NAME);
        ret;
    }
    val text: opt[str] = intern.lookup(w.itn, id);
    if (sel text.none) {
        w.bad = true;
        put_u32(w, 0);
        ret;
    }
    val len: usize = str_len(text.some);
    put_u32(w, len::u32);
    put_bytes(w, text.some::*u8, len);
}

fun put_section(w: *Sink, sec: *of.Section) {
    put_name(w, sec.name);
    put_u8(w, sec.kind);
    put_u32(w, sec.len);
    put_u32(w, sec.align);
    put_u32(w, sec.flags);
    if (sec.bytes == nil) { put_u8(w, 0); }
    or {
        put_u8(w, 1);
        put_bytes(w, sec.bytes, sec.len::usize);
    }
    val native: *of.NativeSection = ?sec.native;
    put_u32(w, native.format);
    put_u64(w, native.flags);
    put_u32(w, native.kind);
    put_u64(w, native.entry_size);
    put_bytes(w, ?native.name[0], 16);
    put_bytes(w, ?native.segment[0], 16);
    put_u32(w, native.reserved1);
    put_u32(w, native.reserved2);
    put_u32(w, native.reserved3);
    put_u32(w, native.link_section);
    put_u32(w, native.link_symbol);
    put_u32(w, native.selection);
    put_u32(w, native.checksum);
}

fun put_symbol(w: *Sink, sym: *of.Symbol) {
    put_name(w, sym.name);
    put_u32(w, of.section_index(sym.section));
    put_u32(w, sym.offset);
    put_u32(w, sym.size);
    put_u32(w, sym.flags);
    put_u32(w, sym.fallback);
    put_u32(w, sym.align);
    put_u64(w, sym.absolute_value);
    put_u32(w, sym.native.format);
    put_u32(w, sym.native.kind);
    put_u32(w, sym.native.flags);
}

fun put_relocation(w: *Sink, r: *of.Relocation) {
    put_u32(w, of.section_index(r.section));
    put_u32(w, r.offset);
    put_u8(w, r.kind);
    put_u32(w, r.sym);
    put_u64(w, r.addend::u64);
    put_u32(w, r.sym2);
    put_u32(w, r.pair);
}

fun put_frame(w: *Sink, fr: *of.FrameUnwind) {
    put_u32(w, of.section_index(fr.section));
    put_u32(w, fr.offset);
    var n: u32 = fr.step_count;
    if (n > of.FRAME_STEP_CAP) {
        w.bad = true;
        n     = 0;
    }
    put_u32(w, n);
    var k: u32 = 0;
    for (k < n) {
        put_u8(w, fr.steps[k].kind);
        put_u8(w, fr.steps[k].reg);
        put_u32(w, fr.steps[k].end_off);
        put_u64(w, fr.steps[k].value);
        k = k + 1;
    }
}

fun put_import(w: *Sink, imp: *of.ImportDecl) {
    put_name(w, imp.symbol);
    put_name(w, imp.import_name);
    put_name(w, imp.library);
    put_u32(w, imp.ordinal::u32);
    if (imp.by_name) { put_u8(w, 1); }
    or               { put_u8(w, 0); }
    if (imp.is_code) { put_u8(w, 1); }
    or               { put_u8(w, 0); }
}

fun put_image(w: *Sink, img: *of.ObjectImage) {
    put_name(w, img.name);
    put_u32(w, img.machine_flags);
    put_u32(w, img.attributes_len);
    put_bytes(w, img.attributes, img.attributes_len::usize);
    var i: u32 = 0;
    put_u32(w, img.section_count);
    for (i < img.section_count) {
        put_section(w, ?img.sections[i]);
        i = i + 1;
    }
    i = 0;
    put_u32(w, img.symbol_count);
    for (i < img.symbol_count) {
        put_symbol(w, ?img.symbols[i]);
        i = i + 1;
    }
    i = 0;
    put_u32(w, img.reloc_count);
    for (i < img.reloc_count) {
        put_relocation(w, ?img.relocations[i]);
        i = i + 1;
    }
    i = 0;
    put_u32(w, img.frame_count);
    for (i < img.frame_count) {
        put_frame(w, ?img.frames[i]);
        i = i + 1;
    }
    i = 0;
    put_u32(w, img.import_count);
    for (i < img.import_count) {
        put_import(w, ?img.imports[i]);
        i = i + 1;
    }
    i = 0;
    put_u32(w, img.indirect_count);
    for (i < img.indirect_count) {
        val ind: *of.NativeIndirect = ?img.indirects[i];
        put_u32(w, of.section_index(ind.section));
        put_u32(w, ind.slot);
        put_u32(w, ind.symbol);
        put_u32(w, ind.flags);
        i = i + 1;
    }
    i = 0;
    put_u32(w, img.export_request_count);
    for (i < img.export_request_count) {
        put_name(w, img.export_requests[i]);
        i = i + 1;
    }
}

# the snapshot of img; the caller owns the bytes, allocated in alloc
pub fun encode(alloc: *A.Allocator, img: *of.ObjectImage, out_bytes: **u8, out_len: *usize) err[fail.Fail] {
    @out_bytes = nil;
    @out_len   = 0;
    var measure: Sink = Sink{buf: nil, pos: 0, itn: img.interner, bad: false};
    put_image(?measure, img);
    if (measure.bad) { ret err[fail.Fail].err{fail.message("of: an object image cannot be snapshotted: a name is not interned or a frame overflows")}; }
    val allocated: res[*u8, A.Error] = A.allocate[u8](alloc, measure.pos);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    var w: Sink = Sink{buf: allocated.ok, pos: 0, itn: img.interner, bad: false};
    put_image(?w, img);
    @out_bytes = allocated.ok;
    @out_len   = measure.pos;
    ret err[fail.Fail].ok{};
}

rec Source {
    data: *u8;
    len:  usize;
    pos:  usize;
    itn:  *intern.Interner;
    bad:  bool;
    oom:  bool;
}

fun take_u8(r: *Source) u8 {
    if (r.bad || r.len - r.pos < 1) {
        r.bad = true;
        ret 0;
    }
    val v: u8 = r.data[r.pos];
    r.pos = r.pos + 1;
    ret v;
}

fun take_u32(r: *Source) u32 {
    if (r.bad || r.len - r.pos < 4) {
        r.bad = true;
        ret 0;
    }
    val v: u32 = bin.read_u32_le(r.data, r.pos);
    r.pos = r.pos + 4;
    ret v;
}

fun take_u64(r: *Source) u64 {
    if (r.bad || r.len - r.pos < 8) {
        r.bad = true;
        ret 0;
    }
    val v: u64 = bin.read_u64_le(r.data, r.pos);
    r.pos = r.pos + 8;
    ret v;
}

fun take_into(r: *Source, dst: *u8, len: usize) {
    if (r.bad || r.len - r.pos < len) {
        r.bad = true;
        ret;
    }
    if (len > 0) { memory.raw_copy(dst::ptr, (r.data::usize + r.pos)::ptr, len); }
    r.pos = r.pos + len;
}

fun take_name(r: *Source) intern.StrId {
    val len: u32 = take_u32(r);
    if (r.bad || len == NIL_NAME) { ret intern.STR_NIL; }
    if (len::usize > r.len - r.pos) {
        r.bad = true;
        ret intern.STR_NIL;
    }
    val id: res[intern.StrId, A.Error] = intern.intern_bytes(r.itn, (r.data::usize + r.pos)::str, len::usize);
    if (sel id.err) {
        r.oom = true;
        r.bad = true;
        ret intern.STR_NIL;
    }
    r.pos = r.pos + len::usize;
    ret id.ok;
}

# a count whose entries, at `min` bytes each, fit in what is left
fun take_count(r: *Source, min: usize) u32 {
    val n: u32 = take_u32(r);
    if (!r.bad && n::usize > (r.len - r.pos) / min) { r.bad = true; }
    if (r.bad)                                      { ret 0; }
    ret n;
}

fun zallocate_or_flag[T](alloc: *A.Allocator, r: *Source, n: u32) *T {
    if (n == 0 || r.bad) { ret nil; }
    val got: res[*T, A.Error] = A.zallocate[T](alloc, n::usize);
    if (sel got.err) {
        r.oom = true;
        r.bad = true;
        ret nil;
    }
    ret got.ok;
}

fun take_section(alloc: *A.Allocator, r: *Source, sec: *of.Section) {
    sec.name  = take_name(r);
    sec.kind  = take_u8(r);
    sec.len   = take_u32(r);
    sec.align = take_u32(r);
    sec.flags = take_u32(r);
    val has_bytes: u8 = take_u8(r);
    if (has_bytes > 1 || (has_bytes == 1 && (sec.len == 0 || sec.len::usize > r.len - r.pos))) { r.bad = true; }
    if (!r.bad && has_bytes == 1) {
        val got: res[*u8, A.Error] = A.allocate[u8](alloc, sec.len::usize);
        if (sel got.err) {
            r.oom = true;
            r.bad = true;
            ret;
        }
        sec.bytes = got.ok;
        take_into(r, sec.bytes, sec.len::usize);
    }
    val native: *of.NativeSection = ?sec.native;
    native.format     = take_u32(r);
    native.flags      = take_u64(r);
    native.kind       = take_u32(r);
    native.entry_size = take_u64(r);
    take_into(r, ?native.name[0], 16);
    take_into(r, ?native.segment[0], 16);
    native.reserved1    = take_u32(r);
    native.reserved2    = take_u32(r);
    native.reserved3    = take_u32(r);
    native.link_section = take_u32(r);
    native.link_symbol  = take_u32(r);
    native.selection    = take_u32(r);
    native.checksum     = take_u32(r);
}

fun take_symbol(r: *Source, sym: *of.Symbol) {
    sym.name           = take_name(r);
    sym.section        = of.section_id(take_u32(r));
    sym.offset         = take_u32(r);
    sym.size           = take_u32(r);
    sym.flags          = take_u32(r);
    sym.fallback       = take_u32(r);
    sym.align          = take_u32(r);
    sym.absolute_value = take_u64(r);
    sym.native.format  = take_u32(r);
    sym.native.kind    = take_u32(r);
    sym.native.flags   = take_u32(r);
}

fun take_relocation(r: *Source, rel: *of.Relocation) {
    rel.section = of.section_id(take_u32(r));
    rel.offset  = take_u32(r);
    rel.kind    = take_u8(r);
    rel.sym     = take_u32(r);
    rel.addend  = take_u64(r)::i64;
    rel.sym2    = take_u32(r);
    rel.pair    = take_u32(r);
}

fun take_frame(r: *Source, fr: *of.FrameUnwind) {
    fr.section    = of.section_id(take_u32(r));
    fr.offset     = take_u32(r);
    fr.step_count = take_u32(r);
    if (fr.step_count > of.FRAME_STEP_CAP) {
        r.bad         = true;
        fr.step_count = 0;
    }
    var k: u32 = 0;
    for (k < fr.step_count) {
        fr.steps[k].kind    = take_u8(r);
        fr.steps[k].reg     = take_u8(r);
        fr.steps[k].end_off = take_u32(r);
        fr.steps[k].value   = take_u64(r);
        k                   = k + 1;
    }
}

fun take_import(r: *Source, imp: *of.ImportDecl) {
    imp.symbol      = take_name(r);
    imp.import_name = take_name(r);
    imp.library     = take_name(r);
    val ordinal: u32 = take_u32(r);
    val by_name: u8  = take_u8(r);
    val is_code: u8  = take_u8(r);
    if (ordinal > 0xFFFF || by_name > 1 || is_code > 1) { r.bad = true; }
    imp.ordinal = ordinal::u16;
    imp.by_name = by_name == 1;
    imp.is_code = is_code == 1;
}

fun take_image(alloc: *A.Allocator, r: *Source, out: *of.ObjectImage) {
    out.name          = take_name(r);
    out.machine_flags = take_u32(r);
    val attributes_len: u32 = take_u32(r);
    if (!r.bad && attributes_len::usize > r.len - r.pos) { r.bad = true; }
    out.attributes = zallocate_or_flag[u8](alloc, r, attributes_len);
    if (out.attributes != nil) {
        out.attributes_len = attributes_len;
        take_into(r, out.attributes, attributes_len::usize);
    }

    val sections: u32 = take_count(r, SECTION_MIN);
    out.sections = zallocate_or_flag[of.Section](alloc, r, sections);
    if (out.sections != nil) {
        out.section_cap   = sections;
        out.section_count = sections;
    }
    var i: u32 = 0;
    for (i < out.section_count && !r.bad) {
        take_section(alloc, r, ?out.sections[i]);
        i = i + 1;
    }

    val symbols: u32 = take_count(r, SYMBOL_MIN);
    out.symbols = zallocate_or_flag[of.Symbol](alloc, r, symbols);
    if (out.symbols != nil) {
        out.symbol_cap   = symbols;
        out.symbol_count = symbols;
    }
    i = 0;
    for (i < out.symbol_count && !r.bad) {
        take_symbol(r, ?out.symbols[i]);
        i = i + 1;
    }

    val relocs: u32 = take_count(r, RELOC_MIN);
    out.relocations = zallocate_or_flag[of.Relocation](alloc, r, relocs);
    if (out.relocations != nil) {
        out.reloc_cap   = relocs;
        out.reloc_count = relocs;
    }
    i = 0;
    for (i < out.reloc_count && !r.bad) {
        take_relocation(r, ?out.relocations[i]);
        i = i + 1;
    }

    val frames: u32 = take_count(r, FRAME_MIN);
    out.frames = zallocate_or_flag[of.FrameUnwind](alloc, r, frames);
    if (out.frames != nil) {
        out.frame_cap   = frames;
        out.frame_count = frames;
    }
    i = 0;
    for (i < out.frame_count && !r.bad) {
        take_frame(r, ?out.frames[i]);
        i = i + 1;
    }

    val imports: u32 = take_count(r, IMPORT_MIN);
    out.imports = zallocate_or_flag[of.ImportDecl](alloc, r, imports);
    if (out.imports != nil) {
        out.import_cap   = imports;
        out.import_count = imports;
    }
    i = 0;
    for (i < out.import_count && !r.bad) {
        take_import(r, ?out.imports[i]);
        i = i + 1;
    }

    val indirects: u32 = take_count(r, INDIRECT_MIN);
    out.indirects = zallocate_or_flag[of.NativeIndirect](alloc, r, indirects);
    if (out.indirects != nil) {
        out.indirect_cap   = indirects;
        out.indirect_count = indirects;
    }
    i = 0;
    for (i < out.indirect_count && !r.bad) {
        val ind: *of.NativeIndirect = ?out.indirects[i];
        ind.section = of.section_id(take_u32(r));
        ind.slot    = take_u32(r);
        ind.symbol  = take_u32(r);
        ind.flags   = take_u32(r);
        i           = i + 1;
    }

    val requests: u32 = take_count(r, NAME_MIN);
    out.export_requests = zallocate_or_flag[intern.StrId](alloc, r, requests);
    if (out.export_requests != nil) {
        out.export_request_cap   = requests;
        out.export_request_count = requests;
    }
    i = 0;
    for (i < out.export_request_count && !r.bad) {
        out.export_requests[i] = take_name(r);
        i                      = i + 1;
    }
}

# the image a snapshot holds, owned in alloc with its names in itn: false when
# the bytes are truncated, trail, or do not describe a valid image. err only
# when allocation fails
pub fun decode(alloc: *A.Allocator, itn: *intern.Interner, bytes: *u8, len: usize,
    out: *of.ObjectImage) res[bool, fail.Fail] {
    @out = of.object_image_init(alloc, itn, intern.STR_NIL);
    if (bytes == nil) { ret res[bool, fail.Fail].ok{false}; }
    var r: Source = Source{data: bytes, len: len, pos: 0, itn: itn, bad: false, oom: false};
    take_image(alloc, ?r, out);
    if (!r.bad && r.pos != r.len) { r.bad = true; }
    if (r.bad) {
        of.object_image_dnit(out);
        if (r.oom) { ret res[bool, fail.Fail].err{fail.message("out of memory decoding an object snapshot")}; }
        ret res[bool, fail.Fail].ok{false};
    }
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(out);
    if (sel valid.err) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{true};
}

#[testing]
fun t_same_bytes(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_same_section(a: *of.Section, b: *of.Section) bool {
    if (a.name != b.name || a.kind != b.kind || a.len != b.len || a.align != b.align || a.flags != b.flags) { ret false; }
    if ((a.bytes == nil) != (b.bytes == nil))                                                               { ret false; }
    if (a.bytes != nil && !t_same_bytes(a.bytes, b.bytes, a.len::usize))                                    { ret false; }
    val x: *of.NativeSection = ?a.native;
    val y: *of.NativeSection = ?b.native;
    ret x.format == y.format && x.flags == y.flags && x.kind == y.kind && x.entry_size == y.entry_size
        && t_same_bytes(?x.name[0], ?y.name[0], 16) && t_same_bytes(?x.segment[0], ?y.segment[0], 16)
        && x.reserved1 == y.reserved1 && x.reserved2 == y.reserved2 && x.reserved3 == y.reserved3
        && x.link_section == y.link_section && x.link_symbol == y.link_symbol
        && x.selection == y.selection && x.checksum == y.checksum;
}

#[testing]
fun t_same_image(a: *of.ObjectImage, b: *of.ObjectImage) bool {
    if (a.name != b.name || a.machine_flags != b.machine_flags || a.attributes_len != b.attributes_len) { ret false; }
    if (!t_same_bytes(a.attributes, b.attributes, a.attributes_len::usize))                             { ret false; }
    if (a.section_count != b.section_count || a.symbol_count != b.symbol_count || a.reloc_count != b.reloc_count
        || a.frame_count != b.frame_count || a.import_count != b.import_count
        || a.indirect_count != b.indirect_count || a.export_request_count != b.export_request_count) { ret false; }
    var i: u32 = 0;
    for (i < a.section_count) {
        if (!t_same_section(?a.sections[i], ?b.sections[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.symbol_count) {
        val x: *of.Symbol = ?a.symbols[i];
        val y: *of.Symbol = ?b.symbols[i];
        if (x.name != y.name || x.section.index != y.section.index || x.offset != y.offset || x.size != y.size
            || x.flags != y.flags || x.fallback != y.fallback || x.align != y.align
            || x.absolute_value != y.absolute_value || x.native.format != y.native.format
            || x.native.kind != y.native.kind || x.native.flags != y.native.flags) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.reloc_count) {
        val x: *of.Relocation = ?a.relocations[i];
        val y: *of.Relocation = ?b.relocations[i];
        if (x.section.index != y.section.index || x.offset != y.offset || x.kind != y.kind || x.sym != y.sym
            || x.addend != y.addend || x.sym2 != y.sym2 || x.pair != y.pair) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.frame_count) {
        val x: *of.FrameUnwind = ?a.frames[i];
        val y: *of.FrameUnwind = ?b.frames[i];
        if (x.section.index != y.section.index || x.offset != y.offset || x.step_count != y.step_count) { ret false; }
        var k: u32 = 0;
        for (k < x.step_count) {
            if (x.steps[k].kind != y.steps[k].kind || x.steps[k].reg != y.steps[k].reg
                || x.steps[k].end_off != y.steps[k].end_off || x.steps[k].value != y.steps[k].value) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < a.import_count) {
        val x: *of.ImportDecl = ?a.imports[i];
        val y: *of.ImportDecl = ?b.imports[i];
        if (x.symbol != y.symbol || x.import_name != y.import_name || x.library != y.library
            || x.ordinal != y.ordinal || x.by_name != y.by_name || x.is_code != y.is_code) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.indirect_count) {
        val x: *of.NativeIndirect = ?a.indirects[i];
        val y: *of.NativeIndirect = ?b.indirects[i];
        if (x.section.index != y.section.index || x.slot != y.slot || x.symbol != y.symbol || x.flags != y.flags) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.export_request_count) {
        if (a.export_requests[i] != b.export_requests[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun t_decodes(alloc: *A.Allocator, itn: *intern.Interner, bytes: *u8, len: usize) bool {
    var got: of.ObjectImage;
    val r:   res[bool, fail.Fail] = decode(alloc, itn, bytes, len, ?got);
    if (sel r.err) { ret true; }
    if (r.ok)      { of.object_image_dnit(?got); }
    ret r.ok;
}

# every field of an image survives, including what no object format spells
# (symbol sizes, the retain flag, frames), and every truncation or trailing
# byte reads as no image
test snapshot__round_trips_every_field_and_refuses_damage {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val text_r: res[intern.StrId, A.Error] = intern.intern(?itn, ".text");
    val keep_r: res[intern.StrId, A.Error] = intern.intern(?itn, ".kept");
    val fn_r:   res[intern.StrId, A.Error] = intern.intern(?itn, "m.f");
    val ext_r:  res[intern.StrId, A.Error] = intern.intern(?itn, "ext");
    val lib_r:  res[intern.StrId, A.Error] = intern.intern(?itn, "kernel32.dll");
    if (sel text_r.err) { ret 1; }
    if (sel keep_r.err) { ret 1; }
    if (sel fn_r.err)   { ret 1; }
    if (sel ext_r.err)  { ret 1; }
    if (sel lib_r.err)  { ret 1; }

    var code:     [8]u8 = [8]u8{0x55, 0xE8, 0, 0, 0, 0, 0x5D, 0xC3};
    var attrs:    [3]u8 = [3]u8{1, 2, 3};
    var sections: [3]of.Section;
    sections[0]                     = of.Section{name: text_r.ok, kind: of.SK_TEXT, bytes: ?code[0], len: 8, align: 16, flags: of.SEC_FLAG_COALESCE};
    sections[1]                     = of.Section{name: keep_r.ok, kind: of.SK_BSS, bytes: nil, len: 32, align: 8, flags: of.SEC_FLAG_RETAIN};
    sections[2]                     = of.Section{name: keep_r.ok, kind: of.SK_DATA, bytes: ?attrs[0], len: 3, align: 1, flags: of.SEC_FLAG_MERGEABLE};
    sections[2].native.format       = of.OF_MACHO;
    sections[2].native.flags        = 0x60000040;
    sections[2].native.entry_size   = 9;
    sections[2].native.name[0]      = 'k';
    sections[2].native.segment[15]  = 'z';
    sections[2].native.selection    = 2;
    sections[2].native.checksum     = 77;
    sections[2].native.link_section = 1;
    var symbols: [2]of.Symbol;
    symbols[0] = of.Symbol{name: fn_r.ok, section: of.section_id(0), offset: 0, size: 8,
        flags:    of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_HIDDEN,
        fallback: of.SYMBOL_NONE, align: 16, absolute_value: 0};
    symbols[1] = of.Symbol{name: ext_r.ok, section: of.external_section(), offset: 0, size: 0,
        flags:          of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN, fallback: of.SYMBOL_NONE, align: 1,
        absolute_value: 0xFFFFFFFF00000001};
    symbols[1].native = of.NativeSymbol{format: of.OF_MACHO, kind: 0x20, flags: 2};
    var relocs: [1]of.Relocation;
    relocs[0] = of.Relocation{section: of.section_id(0), offset: 2, kind: of.RK_PC32, sym: 1, addend: -4,
        sym2: of.SYMBOL_NONE, pair: 0};
    var frames: [1]of.FrameUnwind;
    frames[0].section          = of.section_id(0);
    frames[0].offset           = 0;
    frames[0].step_count       = 1;
    frames[0].steps[0].kind    = of.FRAME_STEP_PUSH;
    frames[0].steps[0].reg     = 5;
    frames[0].steps[0].end_off = 1;
    frames[0].steps[0].value   = 0x8000000000000001;
    var imports: [1]of.ImportDecl;
    imports[0] = of.ImportDecl{symbol: ext_r.ok, import_name: ext_r.ok, library: lib_r.ok,
        ordinal: 0xBEEF, by_name: false, is_code: true};
    var indirects: [1]of.NativeIndirect;
    indirects[0] = of.NativeIndirect{section: of.section_id(2), slot: 1, symbol: 1, flags: 0};
    var requests: [1]intern.StrId = [1]intern.StrId{fn_r.ok};

    var img: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    img.sections             = ?sections[0];
    img.section_count        = 3;
    img.symbols              = ?symbols[0];
    img.symbol_count         = 2;
    img.relocations          = ?relocs[0];
    img.reloc_count          = 1;
    img.frames               = ?frames[0];
    img.frame_count          = 1;
    img.imports              = ?imports[0];
    img.import_count         = 1;
    img.indirects            = ?indirects[0];
    img.indirect_count       = 1;
    img.export_requests      = ?requests[0];
    img.export_request_count = 1;
    img.machine_flags        = 0x5;
    img.attributes           = ?attrs[0];
    img.attributes_len       = 3;

    var bytes:   *u8            = nil;
    var len:     usize          = 0;
    val encoded: err[fail.Fail] = encode(?alloc, ?img, ?bytes, ?len);
    if (sel encoded.err) { ret 2; }
    fin { A.deallocate[u8](?alloc, bytes, len); }

    var got: of.ObjectImage;
    val r:   res[bool, fail.Fail] = decode(?alloc, ?itn, bytes, len, ?got);
    if (sel r.err) { ret 3; }
    if (!r.ok)     { ret 4; }
    fin { of.object_image_dnit(?got); }
    if (!t_same_image(?img, ?got)) { ret 5; }

    var cut: usize = 0;
    for (cut < len) {
        if (t_decodes(?alloc, ?itn, bytes, cut)) { ret 6; }
        cut = cut + 1;
    }
    val longer_r: res[*u8, A.Error] = A.zallocate[u8](?alloc, len + 1);
    if (sel longer_r.err) { ret 7; }
    fin { A.deallocate[u8](?alloc, longer_r.ok, len + 1); }
    memory.raw_copy(longer_r.ok::ptr, bytes::ptr, len);
    if (t_decodes(?alloc, ?itn, longer_r.ok, len + 1)) { ret 8; }
    ret 0;
}
