test "mach.lang.target.of.macho:write_sleb" {
    var buf: [4]u8;
    var cases: [9]i64;
    cases[0] = 0;    cases[1] = 1;    cases[2] = -1;
    cases[3] = 63;   cases[4] = 64;   cases[5] = -64;
    cases[6] = -65;  cases[7] = 128;  cases[8] = -128;
    var first: [9]u8;
    first[0] = 0x00; first[1] = 0x01; first[2] = 0x7F;
    first[3] = 0x3F; first[4] = 0xC0; first[5] = 0x40;
    first[6] = 0xBF; first[7] = 0x80; first[8] = 0x80;
    var second: [9]u8;
    second[0] = 0xFF; second[1] = 0xFF; second[2] = 0xFF;
    second[3] = 0xFF; second[4] = 0x00; second[5] = 0xFF;
    second[6] = 0x7F; second[7] = 0x01; second[8] = 0x7F;
    var sizes: [9]usize;
    sizes[0] = 1; sizes[1] = 1; sizes[2] = 1;
    sizes[3] = 1; sizes[4] = 2; sizes[5] = 1;
    sizes[6] = 2; sizes[7] = 2; sizes[8] = 2;

    var i: u32 = 0;
    for (i < 9) {
        var k: usize = 0;
        for (k < 4) { buf[k] = 0xEE; k = k + 1; }
        val end: usize = write_sleb(?buf[0], 0, cases[i]);
        if (end != sizes[i] || sleb_size(cases[i]) != sizes[i]) { ret 1; }
        if (buf[0] != first[i]) { ret 1; }
        if (sizes[i] == 2 && buf[1] != second[i]) { ret 1; }
        if (buf[end] != 0xEE) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.of.macho.write_bind_info:abs64_in_place_bind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val ln: R.Result[intern.StrId, str] = intern.intern(?itn, "/usr/lib/libobjc.A.dylib");
    val sn: R.Result[intern.StrId, str] = intern.intern(?itn, "__objc_empty_cache");
    val cn: R.Result[intern.StrId, str] = intern.intern(?itn, "_objc_msgSend");
    if (R.is_err[intern.StrId, str](ln) || R.is_err[intern.StrId, str](sn)
        || R.is_err[intern.StrId, str](cn)) { ret 1; }

    var libs: [1]of.DynLib;
    libs[0].name   = R.unwrap_ok[intern.StrId, str](ln);
    libs[0].soname = libs[0].name;
    libs[0].rpath  = intern.STR_NIL;

    var imports: [2]of.DynImport;
    imports[0].symbol = R.unwrap_ok[intern.StrId, str](sn);
    imports[0].lib_index = 0; imports[0].is_func = false;
    imports[0].ordinal = 0; imports[0].by_ordinal = false;
    imports[1].symbol = R.unwrap_ok[intern.StrId, str](cn);
    imports[1].lib_index = 0; imports[1].is_func = true;
    imports[1].ordinal = 0; imports[1].by_ordinal = false;

    var fixups: [2]of.ImportAddrFixup;
    fixups[0].seg_index = 2; fixups[0].seg_offset = 0x28;
    fixups[0].import_index = 0; fixups[0].patch_vaddr = 0;
    fixups[0].kind = of.RK_ABS64; fixups[0].addend = 0;
    fixups[1].seg_index = 2; fixups[1].seg_offset = 0x38;
    fixups[1].import_index = 0; fixups[1].patch_vaddr = 0;
    fixups[1].kind = of.RK_ABS64; fixups[1].addend = -8;

    var segs: [3]of.LoadSegment;
    segs[0].vaddr = 0x1000; segs[0].filesz = 0; segs[0].memsz = 0;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = nil;
    segs[1].vaddr = 0x2000; segs[1].filesz = 0; segs[1].memsz = 0;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = nil;
    segs[2].vaddr = 0x3000; segs[2].filesz = 0; segs[2].memsz = 0;
    segs[2].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE; segs[2].bytes = nil;

    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0];       dyn.lib_count = 1;
    dyn.imports = ?imports[0]; dyn.import_count = 2;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil::*of.BaseReloc; dyn.base_reloc_count = 0;
    dyn.pie = true;
    dyn.import_addr_fixups = ?fixups[0]; dyn.import_addr_fixup_count = 2;

    val want: usize = measure_bind_info(?itn, ?dyn, ?segs[0], 0x1000, 1);
    var buf: [128]u8;
    var k: usize = 0;
    for (k < 128) { buf[k] = 0xEE; k = k + 1; }
    val end: usize = write_bind_info(?buf[0], 0, ?itn, ?dyn, ?segs[0], 0x1000, 1, 4);
    if (end != want) { ret 1; }

    var p: usize = 0;
    if (buf[p] != (BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 3)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x28) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != (BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_ADDEND_SLIB_ULEB) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x78) { ret 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 3)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x38) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != (BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 4)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x00) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != BIND_OPCODE_DONE) { ret 1; }
    p = p + 1;
    if (p != end) { ret 1; }
    ret 0;
}

fun t_emit_x64_object(alloc: *A.Allocator, i: *intern.Interner, out: *Vector[u8]) bool {
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[0] = 0xE8;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;
    secs[1].name = t_intern(i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name = t_intern(i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(i, "g"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name = t_intern(i, "ext_func"); syms[2].section = of.SECTION_EXTERNAL;
    syms[2].offset = 0; syms[2].size = 0; syms[2].flags = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [3]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1;  relocs[0].kind = of.RK_PLT32;
    relocs[0].sym = 2; relocs[0].addend = -4;
    relocs[1].section = 0; relocs[1].offset = 8;  relocs[1].kind = of.RK_PC32;
    relocs[1].sym = 1; relocs[1].addend = -4;
    relocs[2].section = 0; relocs[2].offset = 16; relocs[2].kind = of.RK_ABS64;
    relocs[2].sym = 1; relocs[2].addend = 0;

    var img: of.ObjectImage;
    img.alloc = alloc;
    img.interner = i;
    img.name = t_intern(i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 3;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "macho_sub");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret false; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret false; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret false; }
    @out = R.unwrap_ok[Vector[u8], str](rb);
    ret true;
}

fun t_put_reloc(buf: *u8, reloff: usize, idx: u32, address: u32, symnum: u32,
                pcrel: u32, length: u32, extn: u32, r_type: u32) {
    val e: usize = reloff + idx::usize * RELOC_INFO_SIZE;
    bin.write_u32_le(buf, e, address);
    bin.write_u32_le(buf, e + 4, (symnum & 0xFFFFFF) | (pcrel << 24) | (length << 25)
                                  | (extn << 27) | (r_type << 28));
}

fun t_first_reloff(buf: *u8, out_n: *u32) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd: u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            if (nsects > 0) {
                val sh: usize = off + SEGMENT_CMD_64_SIZE;
                @out_n = bin.read_u32_le(buf, sh + 60);
                ret bin.read_u32_le(buf, sh + 56)::usize;
            }
        }
        off = off + cmdsize;
        c = c + 1;
    }
    @out_n = 0;
    ret 0;
}

test "mach.lang.target.of.macho:x64_subtractor_pair_folds_to_a_difference" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    var nreloc: u32 = 0;
    val reloff: usize = t_first_reloff(buf.data, ?nreloc);
    if (reloff == 0 || nreloc < 2) { ret 2; }

    t_put_reloc(buf.data, reloff, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(buf.data, reloff, 1, 16, 0, 0, 3, 1, X86_64_RELOC_UNSIGNED);
    var z: u32 = 2;
    for (z < nreloc) {
        t_put_reloc(buf.data, reloff, z, 0, 0, 0, 3, 1, X86_64_RELOC_UNSIGNED);
        z = z + 1;
    }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 3; }

    var bad: i32 = 0;
    if (out.reloc_count != nreloc - 1 && bad == 0) { bad = 4; }

    var saw: bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.kind == of.RK_DIFF64) {
            saw = true;
            if (rr.offset != 16 && bad == 0) { bad = 5; }
            if (!of.is_difference(rr.kind) && bad == 0) { bad = 6; }
        }
        rj = rj + 1;
    }
    if (!saw && bad == 0) { bad = 7; }

    ret bad;
}

test "mach.lang.target.of.macho:a_malformed_subtractor_pair_is_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var bad: i32 = 0;

    var b1: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b1)) { ret 1; }
    var n1: u32 = 0;
    val o1: usize = t_first_reloff(b1.data, ?n1);
    if (o1 == 0 || n1 < 2) { ret 2; }
    t_put_reloc(b1.data, o1, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b1.data, o1, 1, 16, 0, 1, 2, 1, X86_64_RELOC_BRANCH);
    var out1: of.ObjectImage;
    if (R.is_ok[R.Void, str](parse_object(?alloc, ?i, b1.data, b1.len, ?out1)) && bad == 0) { bad = 3; }

    var b2: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b2)) { ret 4; }
    var n2: u32 = 0;
    val o2: usize = t_first_reloff(b2.data, ?n2);
    if (o2 == 0 || n2 < 2) { ret 5; }
    t_put_reloc(b2.data, o2, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b2.data, o2, 1, 8,  0, 0, 3, 1, X86_64_RELOC_UNSIGNED);
    var out2: of.ObjectImage;
    if (R.is_ok[R.Void, str](parse_object(?alloc, ?i, b2.data, b2.len, ?out2)) && bad == 0) { bad = 6; }

    var b3: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b3)) { ret 7; }
    var n3: u32 = 0;
    val o3: usize = t_first_reloff(b3.data, ?n3);
    if (o3 == 0 || n3 < 2) { ret 8; }
    t_put_reloc(b3.data, o3, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b3.data, o3, 1, 16, 0, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    var out3: of.ObjectImage;
    if (R.is_ok[R.Void, str](parse_object(?alloc, ?i, b3.data, b3.len, ?out3)) && bad == 0) { bad = 9; }

    ret bad;
}

fun t_symtab(buf: *u8, out_n: *u32) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd: u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SYMTAB) {
            @out_n = bin.read_u32_le(buf, off + 12);
            ret bin.read_u32_le(buf, off + 8)::usize;
        }
        off = off + cmdsize;
        c = c + 1;
    }
    @out_n = 0;
    ret 0;
}

test "mach.lang.target.of.macho:a_tentative_definition_reads_as_common" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    var nsyms: u32 = 0;
    val symoff: usize = t_symtab(buf.data, ?nsyms);
    if (symoff == 0 || nsyms == 0) { ret 2; }

    val so: usize = symoff + (nsyms - 1)::usize * NLIST_64_SIZE;
    buf.data[so + 4] = N_UNDF | N_EXT;
    buf.data[so + 5] = 0;
    bin.write_u16_le(buf.data, so + 6, (4 << 8)::u16);
    bin.write_u64_le(buf.data, so + 8, 40);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 3; }

    var bad: i32 = 0;
    var saw: bool = false;
    var k: u32 = 0;
    for (k < out.symbol_count) {
        val sym: *of.Symbol = ?out.symbols[k];
        if ((sym.flags & of.SYM_OBJ_FLAG_COMMON) != 0) {
            saw = true;
            if (sym.size != 40                                    && bad == 0) { bad = 4; }
            if (sym.align != 16                                   && bad == 0) { bad = 5; }
            if ((sym.flags & of.SYM_OBJ_FLAG_EXTERN) == 0         && bad == 0) { bad = 6; }
            if (sym.section != of.SECTION_EXTERNAL                && bad == 0) { bad = 7; }
        }
        k = k + 1;
    }
    if (!saw && bad == 0) { bad = 8; }

    var b2: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b2)) { ret 9; }
    var n2: u32 = 0;
    val s2: usize = t_symtab(b2.data, ?n2);
    if (s2 == 0 || n2 == 0) { ret 10; }
    var out2: of.ObjectImage;
    if (R.is_err[R.Void, str](parse_object(?alloc, ?i, b2.data, b2.len, ?out2))) { ret 11; }
    var k2: u32 = 0;
    for (k2 < out2.symbol_count) {
        if ((out2.symbols[k2].flags & of.SYM_OBJ_FLAG_COMMON) != 0 && bad == 0) { bad = 12; }
        k2 = k2 + 1;
    }

    ret bad;
}
