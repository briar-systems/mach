use mach.lang.build.outcome;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.output;
use fixture: mach.lang.output.testing;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target.of.buildid;
use mach.lang.target.of.macho.codesign;
use mach.lang.target.of.macho.dwarf;
use mach.lang.target.of.macho.dyld;
use mach.lang.target.of.macho.format;
use mach.lang.target.of.macho.loadcmd;
use mach.lang.target.of.macho.object;
use mach.lang.target.of.macho.parse;
use mach.lang.target.of.macho.segment;
use mach.lang.target.of.plan;
use A: std.allocator;
use std.allocator.page;
use std.collections.sort;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use fs: std.filesystem;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

pub fun machine_for_arch(arch_id: u32) u32 {
    val r: res[u32, fail.Fail] = format.cpu_type_for(arch_id);
    if (sel r.err) { ret 0; }
    ret r.ok;
}

pub fun register_macho(reg: *of.OfRegistry) err[fail.Fail] {
    var macho_vtable: of.OfVTable = of.linker_vtable(
        of.OF_MACHO, of.of_name_for(of.OF_MACHO), "o", object.emit_object, parse.parse_object, emit_exec);
    of.with_dynamic_exec(?macho_vtable, emit_dyn_exec);

    macho_vtable.two_level_namespace = true;

    macho_vtable.default_debug               = "dwarf";
    macho_vtable.shared_input_ext            = ".dylib";
    macho_vtable.import_address_prefix       = "";
    macho_vtable.header_in_first_segment     = true;
    macho_vtable.maps_by_page                = true;
    macho_vtable.carries_stack_size          = true;
    macho_vtable.default_stack_reserve       = 0;
    macho_vtable.header_span                 = loadcmd.header_span;
    macho_vtable.executable_section_location = nil;
    macho_vtable.stub_shape                  = dyld.macho_stub_shape;
    macho_vtable.got_shape                   = dyld.macho_got_shape;

    macho_vtable.covers_isa_any   = false;
    macho_vtable.covers_isa_count = 0;
    of.cover_isa(?macho_vtable, isa.ARCH_X86_64);
    of.cover_isa(?macho_vtable, isa.ARCH_AARCH64);

    ret of.register(reg, ?macho_vtable);
}

fun reserved_header_span(segs: *of.LoadSegment, seg_count: u32,
    image_base: u64) res[usize, fail.Fail] {
    if (seg_count == 0 || segs == nil) {
        ret res[usize, fail.Fail].err{fail.message("macho: image has no load segments to map the header into")};
    }
    if (segs[0].vaddr <= image_base) {
        ret res[usize, fail.Fail].err{fail.message("macho: base address too low to map the header")};
    }
    ret res[usize, fail.Fail].ok{(segs[0].vaddr - image_base)::usize};
}

fun refuse_unixthread_stack(opts: *of.ImageOptions) err[fail.Fail] {
    if (opts.stack_reserve == 0 && opts.stack_commit == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message("macho: a stack size needs an LC_MAIN entry, and this image enters through LC_UNIXTHREAD; `stack_reserve` / `stack_commit` reach only a position-independent Mach-O image")};
}

fun emit_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
    seg_count: u32, page_size: u64, image_base: u64, entry: u64,
    funcs: *of.ExecFunction, func_count: u32,
    exceptions: *of.Section, exception_count: u32,
    debug: *of.Section, debug_count: u32,
    symtab: *of.SymtabEntry, symtab_count: u32, destination: str, name: *u8,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (isa_vt == nil)      { ret err[fail.Fail].err{fail.message("macho: nil exec isa")}; }
    if (destination == nil) { ret err[fail.Fail].err{fail.message("macho: nil exec path")}; }
    val su: err[fail.Fail] = refuse_unixthread_stack(?image_options);
    if (sel su.err) { ret su; }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = format.cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }
    val exec_page: u64 = format.macho_page_size(arch_id);

    val have_dwarf: bool = debug_count > 0;

    val has_pagezero: bool = image_base > 0;
    var ncmds:        u32  = loadcmd.frame_cmd_count(nil::*of.DynamicInfo, segs, seg_count, has_pagezero) + 4;
    if (have_dwarf) { ncmds = ncmds + 1; }

    var thread_state: usize = format.X86_THREAD_STATE64_COUNT::usize * 4;
    if (format.arch_is_arm64(arch_id)) { thread_state = format.ARM_THREAD_STATE64_COUNT::usize * 4; }
    val thread_cmd_size: usize = 16 + thread_state;

    var sizeofcmds: usize = loadcmd.frame_cmd_bytes(nil::*of.DynamicInfo, segs, seg_count, has_pagezero)
        + thread_cmd_size
        + format.SEGMENT_CMD_64_SIZE + format.UUID_CMD_SIZE + format.LINKEDIT_DATA_CMD_SIZE;
    sizeofcmds = sizeofcmds + dwarf.macho_dwarf_cmd_bytes(debug_count);
    val header_end: usize = format.MACH_HEADER_64_SIZE + sizeofcmds;

    val hs: res[usize, fail.Fail] = reserved_header_span(segs, seg_count, image_base);
    if (sel hs.err) { ret err[fail.Fail].err{hs.err}; }
    val hdr_span: usize = hs.ok;
    if (header_end > hdr_span) {
        ret err[fail.Fail].err{fail.message("macho: exec header exceeds the linker's reservation")};
    }
    val text_va:       u64 = segs[0].vaddr - hdr_span::u64;
    val pagezero_size: u64 = text_va;

    val fp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "macho", plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: plan.FilePlan = fp_r.ok;
    fin { plan.dnit(?fp); }
    val header_r: res[u32, fail.Fail] = plan.place_at(?fp, "mach header and load commands", of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val header_row: u32 = header_r.ok;

    val sr: res[segment.SegmentRows, fail.Fail] = segment.place_segments(alloc, ?fp, segs, seg_count, hdr_span, exec_page::usize, false);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    var seg_rows: segment.SegmentRows = sr.ok;
    fin { segment.segment_rows_free(alloc, ?seg_rows, seg_count); }
    val seg_offsets: *usize = seg_rows.offsets;

    var hi_va: u64 = 0;
    var li:    u32 = 0;
    for (li < seg_count) {
        val rounded: res[u64, fail.Fail] = plan.align_address(?fp, "load segment", segs[li].memsz::u64, exec_page);
        if (sel rounded.err)                         { ret err[fail.Fail].err{rounded.err}; }
        if (rounded.ok > ~(0::u64) - segs[li].vaddr) { ret err[fail.Fail].err{fail.message("macho: load segment overflows the address space")}; }
        val end: u64 = segs[li].vaddr + rounded.ok;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }

    val dwp: res[dwarf.MachoDwarf, fail.Fail] = dwarf.macho_dwarf_plan(alloc, ?fp, debug, debug_count, format.macho_page_size(arch_id)::usize);
    if (sel dwp.err) { ret err[fail.Fail].err{dwp.err}; }
    var dw: dwarf.MachoDwarf = dwp.ok;
    fin { dwarf.macho_dwarf_free(alloc, ?dw, debug_count); }

    val exec_base:  u64 = 0;
    val exec_limit: u64 = hdr_span::u64 + segs[0].filesz::u64;

    val ident_len:       usize          = codesign.codesign_ident_len(name);
    val linkedit_padded: err[fail.Fail] = plan.pad(?fp, "__LINKEDIT", exec_page::usize);
    if (sel linkedit_padded.err) { ret linkedit_padded; }
    val linkedit_off: usize               = plan.cursor(?fp);
    val code_limit:   usize               = linkedit_off;
    val sig_size:     usize               = codesign.code_signature_size(ident_len, code_limit);
    val sig_r:        res[u32, fail.Fail] = plan.place(?fp, "code signature", of.no_section(), 1, sig_size);
    if (sel sig_r.err) { ret err[fail.Fail].err{sig_r.err}; }
    val linkedit_size: usize               = sig_size;
    val linkedit_va_r: res[u64, fail.Fail] = plan.align_address(?fp, "__LINKEDIT", hi_va, exec_page);
    if (sel linkedit_va_r.err) { ret err[fail.Fail].err{linkedit_va_r.err}; }
    val linkedit_va: u64                 = linkedit_va_r.ok;
    val linkedit_vm: res[u64, fail.Fail] = plan.align_address(?fp, "__LINKEDIT", linkedit_size::u64, exec_page);
    if (sel linkedit_vm.err) { ret err[fail.Fail].err{linkedit_vm.err}; }

    val sealed: res[usize, fail.Fail] = plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;

    val sizeofcmds_field: res[u32, fail.Fail] = plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    val code_limit_field: res[u32, fail.Fail] = plan.field_u32(?fp, code_limit, "code signature offset");
    if (sel code_limit_field.err) { ret err[fail.Fail].err{code_limit_field.err}; }
    val sig_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, sig_size, "code signature size");
    if (sel sig_size_field.err) { ret err[fail.Fail].err{sig_size_field.err}; }

    val res_buf: res[*u8, A.Error] = A.zallocate[u8](alloc, total_size);
    if (sel res_buf.err) { ret err[fail.Fail].err{fail.message("macho: exec buffer alloc failed")}; }
    var buf: *u8 = res_buf.ok;
    fin { A.deallocate[u8](alloc, buf, total_size); }

    bin.write_u32_le(buf, 0, format.MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, format.cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, format.MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    bin.write_u32_le(buf, 24, format.MH_NOUNDEFS);
    bin.write_u32_le(buf, 28, 0);

    val frame_r: res[usize, fail.Fail] = loadcmd.write_frame_cmds(buf, ?fp, format.MACH_HEADER_64_SIZE, itn, nil::*of.DynamicInfo, segs,
        seg_count, seg_offsets, pagezero_size, text_va,
        hdr_span, exec_page);
    if (sel frame_r.err) { ret err[fail.Fail].err{frame_r.err}; }
    var lc: usize = frame_r.ok;
    segment.write_segment_bytes(buf, segs, seg_count, seg_offsets);

    val dwarf_r: res[usize, fail.Fail] = dwarf.macho_dwarf_write(buf, itn, ?fp, debug, debug_count, lc, ?dw, 0);
    if (sel dwarf_r.err) { ret err[fail.Fail].err{dwarf_r.err}; }
    lc = dwarf_r.ok;
    dwarf.macho_dwarf_write_bytes(buf, ?fp, debug, debug_count, ?dw);

    lc = loadcmd.write_segment_cmd(buf, lc, "__LINKEDIT", linkedit_va,
        linkedit_vm.ok,
        linkedit_off::u64, linkedit_size::u64,
        format.VM_PROT_READ, format.VM_PROT_READ, 0);

    val uuid_off: usize = loadcmd.write_uuid_cmd(buf, lc);
    lc = lc + format.UUID_CMD_SIZE;

    lc = loadcmd.write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);

    bin.write_u32_le(buf, lc, format.LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, format.LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, code_limit_field.ok);
    bin.write_u32_le(buf, lc + 12, sig_size_field.ok);
    lc = lc + format.LINKEDIT_DATA_CMD_SIZE;
    val commands_closed: err[fail.Fail] = plan.close(?fp, header_row, lc);
    if (sel commands_closed.err) { ret commands_closed; }

    val identified: err[fail.Fail] = codesign.seal_build_id(buf, code_limit, uuid_off);
    if (sel identified.err) { ret identified; }

    val signed:     usize          = codesign.write_code_signature(buf, code_limit, name, code_limit, exec_base, exec_limit);
    val sig_closed: err[fail.Fail] = plan.close_size(?fp, sig_r.ok, signed);
    if (sel sig_closed.err) { ret sig_closed; }

    val r_1764: err[outcome.Fail] = output.bytes(itn, alloc, destination, buf, total_size, 0o755, "macho: exec", "macho: could not publish output file");
    if (sel r_1764.err) { ret err[fail.Fail].err{fail.message(outcome.describe(r_1764.err))}; }
    ret err[fail.Fail].ok{};
}

# the stubs live in the table the linker reserved inside the code, so no data
# lies between a call site and its stub
fun locate_stubs(dyn: *of.DynamicInfo, nstub: u32, stub_sz: usize,
    segs: *of.LoadSegment, seg_count: u32, seg_offsets: *usize,
    lay: *dyld.MachoDynLayout) err[fail.Fail] {
    if (dyn.stubs.size != nstub::usize * stub_sz) {
        ret err[fail.Fail].err{fail.message("macho: the linker reserved no call-stub table for the imported functions")};
    }
    var li: u32 = 0;
    for (li < seg_count) {
        val seg: *of.LoadSegment = ?segs[li];
        if (dyn.stubs.vaddr >= seg.vaddr && dyn.stubs.vaddr - seg.vaddr <= seg.filesz::u64
            && dyn.stubs.size::u64 <= seg.filesz::u64 - (dyn.stubs.vaddr - seg.vaddr)) {
            if ((seg.flags & of.SEG_FLAG_EXECUTE) == 0) {
                ret err[fail.Fail].err{fail.message("macho: the call-stub table lies outside the executable segment")};
            }
            lay.stubs_va   = dyn.stubs.vaddr;
            lay.stubs_size = dyn.stubs.size;
            lay.stubs_off  = seg_offsets[li] + (dyn.stubs.vaddr - seg.vaddr)::usize;
            ret err[fail.Fail].ok{};
        }
        li = li + 1;
    }
    ret err[fail.Fail].err{fail.message("macho: the call-stub table lies outside every load segment")};
}

# finds the import GOT the linker reserved inside the read-only data, one slot
# per import that needs one, and the segment a bind opcode addresses it through
fun locate_got(dyn: *of.DynamicInfo, ngot: u32, segs: *of.LoadSegment, seg_count: u32, pz: u32,
    lay: *dyld.MachoDynLayout) err[fail.Fail] {
    if (dyn.got.size != ngot::usize * 8) {
        ret err[fail.Fail].err{fail.message("macho: the linker reserved no GOT for the imports that need a slot")};
    }
    var li: u32 = 0;
    for (li < seg_count) {
        val seg: *of.LoadSegment = ?segs[li];
        if (dyn.got.vaddr >= seg.vaddr && dyn.got.vaddr - seg.vaddr <= seg.filesz::u64
            && dyn.got.size::u64 <= seg.filesz::u64 - (dyn.got.vaddr - seg.vaddr)) {
            if ((seg.flags & of.SEG_FLAG_EXECUTE) != 0) {
                ret err[fail.Fail].err{fail.message("macho: the GOT lies inside the executable segment")};
            }
            lay.got_va   = dyn.got.vaddr;
            lay.got_size = dyn.got.size;
            dyld.seg_offset_loc(dyn, li, (dyn.got.vaddr - seg.vaddr)::u32, segs, lay.text_va, pz,
                ?lay.got_seg_index, ?lay.got_seg_offset);
            ret err[fail.Fail].ok{};
        }
        li = li + 1;
    }
    ret err[fail.Fail].err{fail.message("macho: the GOT lies outside every load segment")};
}

fun emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
    seg_count: u32, page_size: u64, image_base: u64, entry: u64,
    funcs: *of.ExecFunction, func_count: u32,
    dyn: *of.DynamicInfo, fixups: *of.PltFixup, fixup_count: u32,
    exceptions: *of.Section, exception_count: u32,
    debug: *of.Section, debug_count: u32,
    symtab: *of.SymtabEntry, symtab_count: u32,
    destination: str, name: *u8,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (isa_vt == nil)      { ret err[fail.Fail].err{fail.message("macho: nil dyn-exec isa")}; }
    if (destination == nil) { ret err[fail.Fail].err{fail.message("macho: nil dyn-exec path")}; }
    if (dyn == nil)         { ret err[fail.Fail].err{fail.message("macho: nil dynamic plan")}; }
    if (itn == nil)         { ret err[fail.Fail].err{fail.message("macho: no interner for dyn-exec")}; }
    if (seg_count == 0)     { ret err[fail.Fail].err{fail.message("macho: dyn-exec has no load segments")}; }
    if (segs == nil)        { ret err[fail.Fail].err{fail.message("macho: nil dyn-exec load segments")}; }
    if (dyn.import_count > 0 && dyn.imports == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil dynamic import array")};
    }
    if (dyn.import_addr_fixup_count > 0 && dyn.import_addr_fixups == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil import-address fixup array")};
    }
    if (dyn.base_reloc_count > 0 && dyn.base_relocs == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil base-relocation array")};
    }
    if (fixup_count > 0 && fixups == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil call-site fixup array")};
    }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = format.cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }

    val exec_page: u64   = format.macho_page_size(arch_id);
    val page:      usize = exec_page::usize;
    val nstub:     u32   = dyld.func_import_count(dyn);
    val ngot:      u32   = dyld.got_import_count(dyn);
    val stub_sz:   usize = dyld.macho_stub_size(arch_id);

    val pie: bool = dyn.pie;
    if (!pie) {
        val su: err[fail.Fail] = refuse_unixthread_stack(?image_options);
        if (sel su.err) { ret su; }
    }
    var bri: u32 = 0;
    for (bri < dyn.base_reloc_count) {
        if (dyn.base_relocs[bri].seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("macho: base relocation references an out-of-range segment")};
        }
        bri = bri + 1;
    }
    var fxi: u32 = 0;
    for (fxi < dyn.import_addr_fixup_count) {
        if (dyn.import_addr_fixups[fxi].seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("macho: import-address fixup references an out-of-range segment")};
        }
        if (dyn.import_addr_fixups[fxi].import_index >= dyn.import_count) {
            ret err[fail.Fail].err{fail.message("macho: import-address fixup references an out-of-range import")};
        }
        fxi = fxi + 1;
    }
    if (pie && dyn.base_reloc_count > 1) {
        sort.sort_by[of.BaseReloc](dyn.base_relocs, dyn.base_reloc_count::usize, dyld.base_reloc_cmp);
    }

    if (segment.data_const_seg_count(dyn, segs, seg_count) > 1) {
        ret err[fail.Fail].err{fail.message(segment.data_const_conflict_message(itn, alloc, dyn, segs, seg_count))};
    }

    val seg_cmds: u32 = loadcmd.frame_cmd_count(dyn, segs, seg_count, image_base > 0) + 1;

    var thread_state: usize = format.X86_THREAD_STATE64_COUNT::usize * 4;
    if (format.arch_is_arm64(arch_id)) { thread_state = format.ARM_THREAD_STATE64_COUNT::usize * 4; }
    val thread_cmd_size: usize = 16 + thread_state;
    var entry_cmd_size:  usize = thread_cmd_size;
    if (pie) { entry_cmd_size = format.ENTRY_POINT_CMD_SIZE; }

    val sect_total: u32 = loadcmd.frame_sect_total(segs, seg_count);

    var sizeofcmds: usize = seg_cmds::usize * format.SEGMENT_CMD_64_SIZE
        + sect_total::usize * format.SECTION_64_SIZE
        + format.DYLD_INFO_CMD_SIZE + format.SYMTAB_CMD_SIZE + format.DYSYMTAB_CMD_SIZE
        + loadcmd.dylinker_cmd_size() + entry_cmd_size + format.UUID_CMD_SIZE + format.LINKEDIT_DATA_CMD_SIZE;
    if (pie) { sizeofcmds = sizeofcmds + format.BUILD_VERSION_CMD_SIZE; }
    var di:          u32 = 0;
    var rpath_count: u32 = 0;
    for (di < dyn.lib_count) {
        sizeofcmds = sizeofcmds + loadcmd.dylib_cmd_size(bin.resolve_name(itn, dyn.libs[di].soname));
        if (dyn.libs[di].rpath != intern.STR_NIL
            && !loadcmd.rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            sizeofcmds = sizeofcmds
                + loadcmd.rpath_cmd_size(bin.resolve_name(itn, dyn.libs[di].rpath));
            rpath_count = rpath_count + 1;
        }
        di = di + 1;
    }

    var ncmds: u32 = seg_cmds + 7 + dyn.lib_count + rpath_count;
    if (pie) { ncmds = ncmds + 1; }

    val have_dwarf: bool = debug_count > 0;
    if (have_dwarf) {
        sizeofcmds = sizeofcmds + dwarf.macho_dwarf_cmd_bytes(debug_count);
        ncmds      = ncmds + 1;
    }
    val header_end: usize = format.MACH_HEADER_64_SIZE + sizeofcmds;

    var lay: dyld.MachoDynLayout;
    val hs:  res[usize, fail.Fail] = reserved_header_span(segs, seg_count, image_base);
    if (sel hs.err) { ret err[fail.Fail].err{hs.err}; }
    lay.hdr_span = hs.ok;
    if (header_end > lay.hdr_span) {
        ret err[fail.Fail].err{fail.message("macho: dyn-exec header exceeds the linker's reservation")};
    }
    lay.text_va       = segs[0].vaddr - lay.hdr_span::u64;
    lay.pagezero_size = lay.text_va;

    val fp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "macho", plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: plan.FilePlan = fp_r.ok;
    fin { plan.dnit(?fp); }
    val header_r: res[u32, fail.Fail] = plan.place_at(?fp, "mach header and load commands", of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val header_row: u32 = header_r.ok;

    val sr: res[segment.SegmentRows, fail.Fail] = segment.place_segments(alloc, ?fp, segs, seg_count, lay.hdr_span, page, true);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    var seg_rows: segment.SegmentRows = sr.ok;
    fin { segment.segment_rows_free(alloc, ?seg_rows, seg_count); }
    val seg_offsets: *usize = seg_rows.offsets;

    # the mapped address space is its own plan: the segments end at hi_va,
    # then __LINKEDIT takes a page-aligned run
    var hi_va: u64 = 0;
    var li:    u32 = 0;
    for (li < seg_count) {
        if (segs[li].memsz::u64 > ~(0::u64) - segs[li].vaddr) { ret err[fail.Fail].err{fail.message("macho: load segment overflows the address space")}; }
        val end: u64 = segs[li].vaddr + segs[li].memsz::u64;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }
    val vp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "macho", plan.limit_64());
    if (sel vp_r.err) { ret err[fail.Fail].err{vp_r.err}; }
    var vp: plan.FilePlan = vp_r.ok;
    fin { plan.dnit(?vp); }
    val mapped: err[fail.Fail] = plan.pad_to(?vp, "mapped segments", hi_va::usize);
    if (sel mapped.err) { ret mapped; }

    var pz: u32 = 0;
    if (lay.pagezero_size > 0) { pz = 1; }

    lay.stubs_size     = 0;
    lay.got_size       = 0;
    lay.got_seg_index  = 0;
    lay.got_seg_offset = 0;
    if (nstub > 0) {
        val located: err[fail.Fail] = locate_stubs(dyn, nstub, stub_sz, segs, seg_count, seg_offsets, ?lay);
        if (sel located.err) { ret located; }
    }
    if (ngot > 0) {
        val located: err[fail.Fail] = locate_got(dyn, ngot, segs, seg_count, pz, ?lay);
        if (sel located.err) { ret located; }
    }

    val dwp: res[dwarf.MachoDwarf, fail.Fail] = dwarf.macho_dwarf_plan(alloc, ?fp, debug, debug_count, page);
    if (sel dwp.err) { ret err[fail.Fail].err{dwp.err}; }
    var dw: dwarf.MachoDwarf = dwp.ok;
    fin { dwarf.macho_dwarf_free(alloc, ?dw, debug_count); }

    val linkedit_padded: err[fail.Fail] = plan.pad(?fp, "__LINKEDIT", page);
    if (sel linkedit_padded.err) { ret linkedit_padded; }
    lay.linkedit_off = plan.cursor(?fp);
    val linkedit_vrow: res[u32, fail.Fail] = plan.place(?vp, "__LINKEDIT", of.no_section(), page, 0);
    if (sel linkedit_vrow.err) { ret err[fail.Fail].err{linkedit_vrow.err}; }
    lay.linkedit_va = plan.offset(?vp, linkedit_vrow.ok)::u64;

    lay.rebase_size = dyld.measure_rebase_info(dyn, segs, lay.text_va, pz);
    val rebase_r: res[u32, fail.Fail] = plan.place(?fp, "rebase opcodes", of.no_section(), 1, lay.rebase_size);
    if (sel rebase_r.err) { ret err[fail.Fail].err{rebase_r.err}; }
    lay.rebase_off = plan.offset(?fp, rebase_r.ok);
    lay.bind_size  = dyld.measure_bind_info(itn, dyn, segs, lay.text_va, pz, lay.got_seg_offset);
    val bind_r: res[u32, fail.Fail] = plan.place(?fp, "bind opcodes", of.no_section(), 1, lay.bind_size);
    if (sel bind_r.err) { ret err[fail.Fail].err{bind_r.err}; }
    lay.bind_off = plan.offset(?fp, bind_r.ok);
    val symtab_bytes: res[usize, fail.Fail] = plan.table(?fp, "symbol table", ngot::usize, format.NLIST_64_SIZE);
    if (sel symtab_bytes.err) { ret err[fail.Fail].err{symtab_bytes.err}; }
    val symtab_r: res[u32, fail.Fail] = plan.place(?fp, "symbol table", of.no_section(), 8, symtab_bytes.ok);
    if (sel symtab_r.err) { ret err[fail.Fail].err{symtab_r.err}; }
    lay.symtab_off = plan.offset(?fp, symtab_r.ok);

    lay.strtab_size = 1;
    var si: u32 = 0;
    for (si < dyn.import_count) {
        if (dyld.import_needs_got(dyn, si)) {
            val sname: str = bin.resolve_name(itn, dyn.imports[si].symbol);
            if (sname != nil) { lay.strtab_size = lay.strtab_size + str_len(sname) + 1; }
            or                { lay.strtab_size = lay.strtab_size + 1; }
        }
        si = si + 1;
    }
    val strtab_r: res[u32, fail.Fail] = plan.place(?fp, "string table", of.no_section(), 1, lay.strtab_size);
    if (sel strtab_r.err) { ret err[fail.Fail].err{strtab_r.err}; }
    lay.strtab_off = plan.offset(?fp, strtab_r.ok);

    val ident_len:  usize          = codesign.codesign_ident_len(name);
    val sig_padded: err[fail.Fail] = plan.pad(?fp, "code signature", format.CODE_SIG_ALIGN);
    if (sel sig_padded.err) { ret sig_padded; }
    val sig_off:  usize               = plan.cursor(?fp);
    val sig_size: usize               = codesign.code_signature_size(ident_len, sig_off);
    val sig_r:    res[u32, fail.Fail] = plan.place(?fp, "code signature", of.no_section(), 1, sig_size);
    if (sel sig_r.err) { ret err[fail.Fail].err{sig_r.err}; }
    val exec_limit: u64                   = lay.hdr_span::u64 + segs[0].filesz::u64;
    val sealed:     res[usize, fail.Fail] = plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;
    lay.linkedit_size = total_size - lay.linkedit_off;
    val linkedit_vm: res[u64, fail.Fail] = plan.align_address(?fp, "__LINKEDIT", lay.linkedit_size::u64, exec_page);
    if (sel linkedit_vm.err) { ret err[fail.Fail].err{linkedit_vm.err}; }

    val sizeofcmds_field: res[u32, fail.Fail] = plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    val rebase_off_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.rebase_off, "rebase offset");
    if (sel rebase_off_field.err) { ret err[fail.Fail].err{rebase_off_field.err}; }
    val rebase_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.rebase_size, "rebase size");
    if (sel rebase_size_field.err) { ret err[fail.Fail].err{rebase_size_field.err}; }
    val bind_off_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.bind_off, "bind offset");
    if (sel bind_off_field.err) { ret err[fail.Fail].err{bind_off_field.err}; }
    val bind_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.bind_size, "bind size");
    if (sel bind_size_field.err) { ret err[fail.Fail].err{bind_size_field.err}; }
    val symtab_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.symtab_off, "symbol table offset");
    if (sel symtab_field.err) { ret err[fail.Fail].err{symtab_field.err}; }
    val strtab_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.strtab_off, "string table offset");
    if (sel strtab_field.err) { ret err[fail.Fail].err{strtab_field.err}; }
    val strsize_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.strtab_size, "string table size");
    if (sel strsize_field.err) { ret err[fail.Fail].err{strsize_field.err}; }
    val sig_off_field: res[u32, fail.Fail] = plan.field_u32(?fp, sig_off, "code signature offset");
    if (sel sig_off_field.err) { ret err[fail.Fail].err{sig_off_field.err}; }
    val sig_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, sig_size, "code signature size");
    if (sel sig_size_field.err) { ret err[fail.Fail].err{sig_size_field.err}; }
    var ordinal_i: u32 = 0;
    for (ordinal_i < dyn.import_count) {
        if (dyld.import_needs_got(dyn, ordinal_i) && dyld.dylib_ordinal_for(dyn, ordinal_i) > 0xFF) {
            ret err[fail.Fail].err{fail.message("macho: dynamic library ordinal exceeds the eight-bit n_desc field")};
        }
        ordinal_i = ordinal_i + 1;
    }
    if (lay.got_seg_index > 0xF) {
        ret err[fail.Fail].err{fail.message("macho: the GOT's segment ordinal exceeds the four-bit bind opcode field")};
    }

    val res_buf: res[*u8, A.Error] = A.zallocate[u8](alloc, total_size);
    if (sel res_buf.err) { ret err[fail.Fail].err{fail.message("macho: dyn-exec buffer alloc failed")}; }
    var buf: *u8 = res_buf.ok;
    fin { A.deallocate[u8](alloc, buf, total_size); }

    bin.write_u32_le(buf, 0, format.MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, format.cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, format.MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    var hdr_flags: u32 = format.MH_DYLDLINK | format.MH_TWOLEVEL;
    if (pie) { hdr_flags = hdr_flags | format.MH_PIE; }
    bin.write_u32_le(buf, 24, hdr_flags);
    bin.write_u32_le(buf, 28, 0);

    val frame_r: res[usize, fail.Fail] = loadcmd.write_frame_cmds(buf, ?fp, format.MACH_HEADER_64_SIZE, itn, dyn, segs, seg_count,
        seg_offsets, lay.pagezero_size, lay.text_va,
        lay.hdr_span, exec_page);
    if (sel frame_r.err) { ret err[fail.Fail].err{frame_r.err}; }
    var lc: usize = frame_r.ok;

    val dwarf_r: res[usize, fail.Fail] = dwarf.macho_dwarf_write(buf, itn, ?fp, debug, debug_count, lc, ?dw, 0);
    if (sel dwarf_r.err) { ret err[fail.Fail].err{dwarf_r.err}; }
    lc = dwarf_r.ok;
    dwarf.macho_dwarf_write_bytes(buf, ?fp, debug, debug_count, ?dw);

    lc = loadcmd.write_segment_cmd(buf, lc, "__LINKEDIT", lay.linkedit_va,
        linkedit_vm.ok,
        lay.linkedit_off::u64, lay.linkedit_size::u64,
        format.VM_PROT_READ, format.VM_PROT_READ, 0);

    var rebase_cmd_off:  u32 = 0;
    var rebase_cmd_size: u32 = 0;
    if (lay.rebase_size > 0) {
        rebase_cmd_off  = rebase_off_field.ok;
        rebase_cmd_size = rebase_size_field.ok;
    }
    bin.write_u32_le(buf, lc, format.LC_DYLD_INFO_ONLY);
    bin.write_u32_le(buf, lc + 4, format.DYLD_INFO_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, rebase_cmd_off);
    bin.write_u32_le(buf, lc + 12, rebase_cmd_size);
    bin.write_u32_le(buf, lc + 16, bind_off_field.ok);
    bin.write_u32_le(buf, lc + 20, bind_size_field.ok);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, 0);
    bin.write_u32_le(buf, lc + 32, 0);
    bin.write_u32_le(buf, lc + 36, 0);
    bin.write_u32_le(buf, lc + 40, 0);
    bin.write_u32_le(buf, lc + 44, 0);
    lc = lc + format.DYLD_INFO_CMD_SIZE;

    bin.write_u32_le(buf, lc, format.LC_SYMTAB);
    bin.write_u32_le(buf, lc + 4, format.SYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, symtab_field.ok);
    bin.write_u32_le(buf, lc + 12, ngot);
    bin.write_u32_le(buf, lc + 16, strtab_field.ok);
    bin.write_u32_le(buf, lc + 20, strsize_field.ok);
    lc = lc + format.SYMTAB_CMD_SIZE;

    bin.write_u32_le(buf, lc, format.LC_DYSYMTAB);
    bin.write_u32_le(buf, lc + 4, format.DYSYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, 0);
    bin.write_u32_le(buf, lc + 12, 0);
    bin.write_u32_le(buf, lc + 16, 0);
    bin.write_u32_le(buf, lc + 20, 0);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, ngot);
    lc = lc + format.DYSYMTAB_CMD_SIZE;

    lc = loadcmd.write_load_dylinker(buf, lc);
    di = 0;
    for (di < dyn.lib_count) {
        if (dyn.libs[di].rpath != intern.STR_NIL
            && !loadcmd.rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            lc = loadcmd.write_rpath(buf, lc, bin.resolve_name(itn, dyn.libs[di].rpath));
        }
        di = di + 1;
    }
    di = 0;
    for (di < dyn.lib_count) {
        lc = loadcmd.write_load_dylib(buf, lc, bin.resolve_name(itn, dyn.libs[di].soname));
        di = di + 1;
    }

    if (pie) {
        bin.write_u32_le(buf, lc, format.LC_BUILD_VERSION);
        bin.write_u32_le(buf, lc + 4, format.BUILD_VERSION_CMD_SIZE::u32);
        bin.write_u32_le(buf, lc + 8, format.PLATFORM_MACOS);
        bin.write_u32_le(buf, lc + 12, format.MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 16, format.MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 20, 0);
        lc = lc + format.BUILD_VERSION_CMD_SIZE;
    }

    val uuid_off: usize = loadcmd.write_uuid_cmd(buf, lc);
    lc = lc + format.UUID_CMD_SIZE;

    if (pie) {
        bin.write_u32_le(buf, lc, format.LC_MAIN);
        bin.write_u32_le(buf, lc + 4, format.ENTRY_POINT_CMD_SIZE::u32);
        bin.write_u64_le(buf, lc + 8, entry - lay.text_va);
        bin.write_u64_le(buf, lc + 16, image_options.stack_reserve);
        lc = lc + format.ENTRY_POINT_CMD_SIZE;
    }
    or {
        lc = loadcmd.write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);
    }

    bin.write_u32_le(buf, lc, format.LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, format.LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, sig_off_field.ok);
    bin.write_u32_le(buf, lc + 12, sig_size_field.ok);
    lc = lc + format.LINKEDIT_DATA_CMD_SIZE;
    val commands_closed: err[fail.Fail] = plan.close(?fp, header_row, lc);
    if (sel commands_closed.err) { ret commands_closed; }

    segment.write_segment_bytes(buf, segs, seg_count, seg_offsets);

    if (nstub > 0) {
        var raw: u32 = 0;
        var n:   u32 = 0;
        for (raw < dyn.import_count) {
            if (dyn.imports[raw].is_func) {
                val slot_n:  u32            = dyld.macho_got_ordinal(dyn, raw);
                val stub_va: u64            = lay.stubs_va + n::u64 * stub_sz::u64;
                val slot_va: u64            = lay.got_va + slot_n::u64 * 8;
                val stub_r:  err[fail.Fail] = dyld.write_macho_stub(buf, arch_id, lay.stubs_off + n::usize * stub_sz,
                    stub_va, slot_va);
                if (sel stub_r.err) { ret stub_r; }
                n = n + 1;
            }
            raw = raw + 1;
        }
        if (n != nstub) { ret err[fail.Fail].err{fail.message("macho: stub count drifted from its plan")}; }
    }

    val rebase_end:    usize          = dyld.write_rebase_info(buf, lay.rebase_off, dyn, segs, lay.text_va, pz);
    val rebase_closed: err[fail.Fail] = plan.close(?fp, rebase_r.ok, rebase_end);
    if (sel rebase_closed.err) { ret rebase_closed; }
    val bind_end: usize = dyld.write_bind_info(buf, lay.bind_off, itn, dyn, segs, lay.text_va, pz,
        lay.got_seg_index, lay.got_seg_offset);
    val bind_closed: err[fail.Fail] = plan.close(?fp, bind_r.ok, bind_end);
    if (sel bind_closed.err) { ret bind_closed; }

    buf[lay.strtab_off] = 0;
    var str_pos: usize = 1;
    var sym_off: usize = lay.symtab_off;
    var di2:     u32   = 0;
    for (di2 < dyn.import_count) {
        if (dyld.import_needs_got(dyn, di2)) {
            val sname:  str = bin.resolve_name(itn, dyn.imports[di2].symbol);
            var n_strx: u32 = 0;
            if (sname != nil) {
                val strx_field: res[u32, fail.Fail] = plan.field_u32(?fp, str_pos, "symbol name offset");
                if (sel strx_field.err) { ret err[fail.Fail].err{strx_field.err}; }
                n_strx  = strx_field.ok;
                str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, sname);
            }
            or {
                buf[lay.strtab_off + str_pos] = 0;
                str_pos                       = str_pos + 1;
            }
            bin.write_u32_le(buf, sym_off, n_strx);
            buf[sym_off + 4] = format.N_UNDF | format.N_EXT;
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, dyld.dylib_ordinal_for(dyn, di2)::u16 << 8);
            bin.write_u64_le(buf, sym_off + 8, 0);
            sym_off = sym_off + format.NLIST_64_SIZE;
        }
        di2 = di2 + 1;
    }
    val symtab_closed: err[fail.Fail] = plan.close(?fp, symtab_r.ok, sym_off);
    if (sel symtab_closed.err) { ret symtab_closed; }
    val strtab_closed: err[fail.Fail] = plan.close_size(?fp, strtab_r.ok, str_pos);
    if (sel strtab_closed.err) { ret strtab_closed; }

    val fx_r: err[fail.Fail] =
        dyld.patch_macho_fixups(buf, arch_id, ?lay, dyn, fixups, fixup_count,
        seg_offsets, segs, seg_count, nstub);
    if (sel fx_r.err) { ret fx_r; }
    val gx_r: err[fail.Fail] = dyld.patch_macho_import_addr_fixups(buf, ?lay, dyn, seg_offsets, segs, seg_count);
    if (sel gx_r.err) { ret gx_r; }

    val identified: err[fail.Fail] = codesign.seal_build_id(buf, sig_off, uuid_off);
    if (sel identified.err) { ret identified; }

    val signed:     usize          = codesign.write_code_signature(buf, sig_off, name, sig_off, 0, exec_limit);
    val sig_closed: err[fail.Fail] = plan.close_size(?fp, sig_r.ok, signed);
    if (sel sig_closed.err) { ret sig_closed; }

    val r_3066: err[outcome.Fail] = output.bytes(itn, alloc, destination, buf, total_size, 0o755, "macho: dyn-exec", "macho: could not publish output file");
    if (sel r_3066.err) { ret err[fail.Fail].err{fail.message(outcome.describe(r_3066.err))}; }
    ret err[fail.Fail].ok{};
}

# the LC_UUID payload is the content hash: sha-256 over the signed range with
# the uuid bytes as zero, shaped as a version 4 uuid. 0 when it is, else the
# failing step
#[testing]
fun t_uuid_matches_content(alloc: *A.Allocator, image: *Vector[u8]) u8 {
    val uc: usize = format.t_find_lc(image.data, format.LC_UUID);
    if (uc == 0)                                                          { ret 1; }
    if (bin.read_u32_le(image.data, uc + 4) != format.UUID_CMD_SIZE::u32) { ret 2; }
    val cs: usize = format.t_find_lc(image.data, format.LC_CODE_SIGNATURE);
    if (cs == 0) { ret 3; }
    val sig_off: usize = bin.read_u32_le(image.data, cs + 8)::usize;
    if (sig_off > image.len || uc + format.UUID_CMD_SIZE > sig_off) { ret 4; }
    val copy_r: res[*u8, A.Error] = A.allocate[u8](alloc, sig_off);
    if (sel copy_r.err) { ret 5; }
    val copy: *u8 = copy_r.ok;
    fin { A.deallocate[u8](alloc, copy, sig_off); }
    memory.raw_copy(copy::ptr, image.data::ptr, sig_off);
    var k: usize = 0;
    for (k < 16) {
        copy[uc + 8 + k] = 0;
        k                = k + 1;
    }
    var digest: [32]u8;
    sha256.hash(copy, sig_off, ?digest[0]);
    var want: [16]u8;
    buildid.uuid_from_digest(?digest[0], ?want[0]);
    if (!memory.raw_equal((image.data::usize + uc + 8)::ptr, (?want[0])::ptr, 16)) { ret 6; }
    var zero: bool = true;
    k = 0;
    for (k < 16) {
        if (want[k] != 0 && k != 6 && k != 8) { zero = false; }
        k = k + 1;
    }
    if (zero) { ret 7; }
    ret 0;
}

#[testing]
fun t_find_seg(buf: *u8, name: str) usize {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == format.LC_SEGMENT_64 && format.fixed16_equals(buf, off + 8, name)) { ret off; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret 0;
}

#[testing]
fun ts_exec_x64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var k:    usize = 0;
    for (k < 8) {
        code[k] = 0x90;
        k       = k + 1;
    }
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 4096;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = base + 4096;
    segs[0].filesz = 8;
    segs[0].memsz  = 8;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_exe");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        4096, base, entry,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        tpath, "machoexe"::*u8,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 0) != format.MH_MAGIC_64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != format.MH_EXECUTE) { ret 1; }
    if (bin.read_u32_le(buf.data, 16) != 6)                 { ret 1; }
    if (t_uuid_matches_content(?alloc, ?buf) != 0)          { ret 1; }

    val pz: usize = format.MACH_HEADER_64_SIZE;
    if (bin.read_u32_le(buf.data, pz) != format.LC_SEGMENT_64)  { ret 1; }
    if (!format.fixed16_equals(buf.data, pz + 8, "__PAGEZERO")) { ret 1; }
    if (bin.read_u64_le(buf.data, pz + 24) != 0)                { ret 1; }

    val tx: usize = pz + format.SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, tx) != format.LC_SEGMENT_64) { ret 1; }
    if (!format.fixed16_equals(buf.data, tx + 8, "__TEXT"))    { ret 1; }
    val text_va:   u64 = bin.read_u64_le(buf.data, tx + 24);
    val text_vmsz: u64 = bin.read_u64_le(buf.data, tx + 32);
    if (bin.read_u64_le(buf.data, tx + 40) != 0)       { ret 1; }
    if (bin.read_u64_le(buf.data, pz + 32) != text_va) { ret 1; }
    if (text_va > base)                                { ret 1; }
    if (base >= text_va + text_vmsz)                   { ret 1; }

    val th: usize = format.t_find_lc(buf.data, format.LC_UNIXTHREAD);
    if (th == 0)                                                                   { ret 1; }
    if (bin.read_u32_le(buf.data, th + 8) != format.X86_THREAD_STATE64)            { ret 1; }
    if (bin.read_u64_le(buf.data, th + 16 + format.X86_RIP_STATE_OFFSET) != entry) { ret 1; }

    val cs: usize = format.t_find_lc(buf.data, format.LC_CODE_SIGNATURE);
    if (cs == 0) { ret 1; }
    val sig_off: usize = bin.read_u32_le(buf.data, cs + 8)::usize;
    if (bin.read_u32_be(buf.data, sig_off) != format.CSMAGIC_EMBEDDED_SIGNATURE) { ret 1; }
    val cd: usize = sig_off + format.SUPERBLOB_HEADER_SIZE;
    if (bin.read_u32_be(buf.data, cd) != format.CSMAGIC_CODEDIRECTORY) { ret 1; }
    if (bin.read_u32_be(buf.data, cd + 32) != sig_off::u32)            { ret 1; }
    val id_off: usize = cd + bin.read_u32_be(buf.data, cd + 20)::usize;
    if (!format.t_bytes_contain(buf.data, id_off, str_len("machoexe"), "machoexe")) { ret 1; }
    if (buf.data[id_off + str_len("machoexe")] != 0)                                { ret 1; }
    ret 0;
}

#[testing]
fun ts_exec_arm64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_AARCH64);

    var code: [8]u8;
    bin.write_u32_le(?code[0], 0, 0xD503201F);
    bin.write_u32_le(?code[0], 4, 0xD65F03C0);
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 16384;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = base + 16384;
    segs[0].filesz = 8;
    segs[0].memsz  = 8;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_a64exe");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        16384, base, entry,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        tpath, "machoa64"::*u8,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 4) != format.CPU_TYPE_ARM64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != format.MH_EXECUTE)    { ret 1; }
    val th: usize = format.t_find_lc(buf.data, format.LC_UNIXTHREAD);
    if (th == 0)                                                                  { ret 1; }
    if (bin.read_u32_le(buf.data, th + 8) != format.ARM_THREAD_STATE64)           { ret 1; }
    if (bin.read_u64_le(buf.data, th + 16 + format.ARM_PC_STATE_OFFSET) != entry) { ret 1; }
    ret 0;
}

#[testing]
fun ts_dyn_exec(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(arch_id);

    # the code, then the one stub the linker reserves after it
    var code: [32]u8;
    var k:    usize = 0;
    for (k < 32) {
        code[k] = 0;
        k       = k + 1;
    }
    val stub_sz:   usize = dyld.macho_stub_size(arch_id);
    var fixup_off: u32   = 0;
    var fixup_add: i64   = 0;
    if (arch_id == isa.ARCH_AARCH64) {
        bin.write_u32_le(?code[0], 0, 0x94000000);
        fixup_off = 0;
        fixup_add = 0;
    }
    or {
        code[0]   = 0xE8;
        fixup_off = 1;
        fixup_add = -4;
        code[7]   = 0x48;
        code[8]   = 0x8B;
        code[9]   = 0x05;
    }
    val base:   u64 = 0x100000000;
    val seg_va: u64 = base + format.macho_page_size(arch_id);
    val entry:  u64 = seg_va;

    # the import GOT the linker reserves in the read-only data after the code:
    # the function's slot, and on x86-64 the data import's the GOTPCREL reads
    var ngot: u32 = 1;
    if (arch_id == isa.ARCH_X86_64) { ngot = 2; }
    var got_bytes: [16]u8;
    k = 0;
    for (k < 16) {
        got_bytes[k] = 0;
        k            = k + 1;
    }
    val got_va: u64 = seg_va + format.macho_page_size(arch_id);

    var segs: [2]of.LoadSegment;
    segs[0].vaddr  = seg_va;
    segs[0].filesz = 16 + stub_sz;
    segs[0].memsz  = 16 + stub_sz;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];
    segs[1].vaddr  = got_va;
    segs[1].filesz = ngot::usize * 8;
    segs[1].memsz  = ngot::usize * 8;
    segs[1].flags  = of.SEG_FLAG_READ;
    segs[1].bytes  = ?got_bytes[0];

    var libs: [1]of.DynLib;
    libs[0].name   = format.t_intern(?itn, "probe");
    libs[0].soname = format.t_intern(?itn, "@rpath/libprobe.dylib");
    libs[0].rpath  = format.t_intern(?itn, "/opt/probe/lib");
    var imps: [2]of.DynImport;
    imps[0].symbol    = format.t_intern(?itn, "probe_value");
    imps[0].lib_index = 0;
    imps[0].is_func   = false;
    imps[0].got_ref   = arch_id == isa.ARCH_X86_64;
    imps[1].symbol    = format.t_intern(?itn, "probe_add");
    imps[1].lib_index = 0;
    imps[1].is_func   = true;
    imps[1].got_ref   = false;

    var dyn: of.DynamicInfo;
    dyn.libs                    = ?libs[0];
    dyn.lib_count               = 1;
    dyn.imports                 = ?imps[0];
    dyn.import_count            = 2;
    dyn.interp                  = intern.STR_NIL;
    dyn.import_addr_fixups      = nil;
    dyn.import_addr_fixup_count = 0;
    dyn.stubs.vaddr             = seg_va + 16;
    dyn.stubs.size              = stub_sz;
    dyn.got.vaddr               = got_va;
    dyn.got.size                = ngot::usize * 8;

    var fx: [1]of.PltFixup;
    fx[0].seg_index    = 0;
    fx[0].seg_offset   = fixup_off;
    fx[0].import_index = 1;
    fx[0].patch_vaddr  = seg_va + fixup_off::u64;
    fx[0].addend       = fixup_add;

    var gx: [1]of.ImportAddrFixup;
    if (arch_id == isa.ARCH_X86_64) {
        gx[0].seg_index             = 0;
        gx[0].seg_offset            = 10;
        gx[0].import_index          = 0;
        gx[0].patch_vaddr           = seg_va + 10;
        gx[0].kind                  = of.RK_GOTPCREL;
        gx[0].addend                = -4;
        dyn.import_addr_fixups      = ?gx[0];
        dyn.import_addr_fixup_count = 1;
    }

    var debug_bytes: [3]u8;
    debug_bytes[0] = 0x11;
    debug_bytes[1] = 0x22;
    debug_bytes[2] = 0x33;
    var dbg: [1]of.Section;
    dbg[0].name  = format.t_intern(?itn, ".debug_info");
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?debug_bytes[0];
    dbg[0].len   = 3;
    dbg[0].align = 1;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_dyn");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    # the code and the stub table after it, as the linker hands them over
    var text_secs: [2]of.LoadSection;
    text_secs[0].name     = format.t_intern(?itn, "__text");
    text_secs[0].kind     = of.SK_TEXT;
    text_secs[0].offset   = 0;
    text_secs[0].len      = 16;
    text_secs[0].align    = 4;
    text_secs[1].name     = format.t_intern(?itn, "__stubs");
    text_secs[1].kind     = of.SK_TEXT;
    text_secs[1].offset   = 16;
    text_secs[1].len      = stub_sz::u32;
    text_secs[1].align    = 4;
    segs[0].sections      = ?text_secs[0];
    segs[0].section_count = 2;
    var got_secs: [1]of.LoadSection;
    got_secs[0].name      = format.t_intern(?itn, "__got");
    got_secs[0].kind      = of.SK_RELRO;
    got_secs[0].offset    = 0;
    got_secs[0].len       = ngot * 8;
    got_secs[0].align     = 8;
    got_secs[0].flags     = 0;
    segs[1].sections      = ?got_secs[0];
    segs[1].section_count = 1;
    val em: err[fail.Fail] = emit_dyn_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 2,
        4096, base, entry,
        nil::*of.ExecFunction, 0, ?dyn, ?fx[0], 1,
        nil::*of.Section, 0, ?dbg[0], 1,
        nil::*of.SymtabEntry, 0,
        tpath, "machodyn"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 0) != format.MH_MAGIC_64)                         { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != format.MH_EXECUTE)                         { ret 1; }
    if (bin.read_u32_le(buf.data, 24) != (format.MH_DYLDLINK | format.MH_TWOLEVEL)) { ret 1; }
    if (t_uuid_matches_content(?alloc, ?buf) != 0)                                  { ret 1; }

    val dw: usize = t_find_seg(buf.data, "__DWARF");
    if (dw == 0)                                                                            { ret 1; }
    if (bin.read_u64_le(buf.data, dw + 32) != 0 || bin.read_u64_le(buf.data, dw + 48) == 0) { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 56) != 0 || bin.read_u32_le(buf.data, dw + 60) != 0) { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 68) != format.SG_NORELOC)                            { ret 1; }
    if ((bin.read_u64_le(buf.data, dw + 40) % format.macho_page_size(arch_id)) != 0)        { ret 1; }

    val dl: usize = format.t_find_lc(buf.data, format.LC_LOAD_DYLINKER);
    if (dl == 0)                                                                                          { ret 1; }
    if (!format.t_bytes_contain(buf.data, dl, bin.read_u32_le(buf.data, dl + 4)::usize, "/usr/lib/dyld")) { ret 1; }
    val ld: usize = format.t_find_lc(buf.data, format.LC_LOAD_DYLIB);
    if (ld == 0)                                                                                           { ret 1; }
    if (!format.t_bytes_contain(buf.data, ld, bin.read_u32_le(buf.data, ld + 4)::usize, "libprobe.dylib")) { ret 1; }
    val rp: usize = format.t_find_lc(buf.data, format.LC_RPATH);
    if (rp == 0)                                                                                           { ret 1; }
    if (!format.t_bytes_contain(buf.data, rp, bin.read_u32_le(buf.data, rp + 4)::usize, "/opt/probe/lib")) { ret 1; }

    val info: usize = format.t_find_lc(buf.data, format.LC_DYLD_INFO_ONLY);
    if (info == 0) { ret 1; }
    val bind_off:  usize = bin.read_u32_le(buf.data, info + 16)::usize;
    val bind_size: usize = bin.read_u32_le(buf.data, info + 20)::usize;
    if (bind_size == 0)                                                      { ret 1; }
    if (!format.t_bytes_contain(buf.data, bind_off, bind_size, "probe_add")) { ret 1; }
    if (arch_id == isa.ARCH_X86_64
        && !format.t_bytes_contain(buf.data, bind_off, bind_size, "probe_value")) { ret 1; }

    val sy: usize = format.t_find_lc(buf.data, format.LC_SYMTAB);
    if (sy == 0) { ret 1; }
    var expected_imports: u32 = 1;
    if (arch_id == isa.ARCH_X86_64)                             { expected_imports = 2; }
    if (bin.read_u32_le(buf.data, sy + 12) != expected_imports) { ret 1; }
    val dsy: usize = format.t_find_lc(buf.data, format.LC_DYSYMTAB);
    if (dsy == 0)                                                { ret 1; }
    if (bin.read_u32_le(buf.data, dsy + 28) != expected_imports) { ret 1; }

    if (arch_id == isa.ARCH_X86_64) {
        val text_file: usize = bin.read_u32_le(buf.data, t_find_seg(buf.data, "__TEXT") + format.SEGMENT_CMD_64_SIZE + 48)::usize;
        if (bin.read_u32_le(buf.data, text_file + 1) == 0
            || bin.read_u32_le(buf.data, text_file + 10) == 0) { ret 1; }
    }

    # the stub is a section of __TEXT right after the code, and the call reaches it
    if (t_find_seg(buf.data, "__STUBS") != 0) { ret 1; }
    val tx: usize = t_find_seg(buf.data, "__TEXT");
    if (tx == 0 || bin.read_u32_le(buf.data, tx + 64) != 2) { ret 1; }
    val stubs_sec: usize = tx + format.SEGMENT_CMD_64_SIZE + format.SECTION_64_SIZE;
    if (!format.fixed16_equals(buf.data, stubs_sec, "__stubs"))    { ret 1; }
    if (bin.read_u64_le(buf.data, stubs_sec + 32) != seg_va + 16)  { ret 1; }
    if (bin.read_u64_le(buf.data, stubs_sec + 40) != stub_sz::u64) { ret 1; }
    val call_file: usize = bin.read_u32_le(buf.data, tx + format.SEGMENT_CMD_64_SIZE + 48)::usize;
    if (arch_id == isa.ARCH_AARCH64) {
        if (bin.read_u32_le(buf.data, call_file) != 0x94000004) { ret 1; }
    }
    or {
        if (bin.read_u32_le(buf.data, call_file + 1) != 11) { ret 1; }
    }

    # the GOT is the linker's __DATA_CONST,__got, which dyld binds before it
    # maps the segment read-only, and the stub loads the function's slot
    if (t_find_seg(buf.data, "__GOT") != 0) { ret 1; }
    val dc: usize = t_find_seg(buf.data, "__DATA_CONST");
    if (dc == 0 || bin.read_u32_le(buf.data, dc + 64) != 1)              { ret 1; }
    if ((bin.read_u32_le(buf.data, dc + 68) & format.SG_READ_ONLY) == 0) { ret 1; }
    val got_sec: usize = dc + format.SEGMENT_CMD_64_SIZE;
    if (!format.fixed16_equals(buf.data, got_sec, "__got")) { ret 1; }
    if (bin.read_u64_le(buf.data, got_sec + 32) != got_va)  { ret 1; }
    val stub_file: usize = call_file + 16;
    val func_slot: u64   = got_va + (ngot - 1)::u64 * 8;
    if (arch_id == isa.ARCH_AARCH64) {
        val adrp:  u32 = bin.read_u32_le(buf.data, stub_file);
        val ldr:   u32 = bin.read_u32_le(buf.data, stub_file + 4);
        val pages: u64 = (((adrp >> 5) & 0x7FFFF) << 2 | ((adrp >> 29) & 3))::u64;
        val page:  u64 = ((seg_va + 16) & ~(0xFFF::u64)) + (pages << 12);
        if (page + (((ldr >> 10) & 0xFFF) << 3)::u64 != func_slot) { ret 1; }
    }
    or {
        val disp: u32 = bin.read_u32_le(buf.data, stub_file + 2);
        if (seg_va + 16 + 6 + disp::u64 != func_slot) { ret 1; }
    }

    val th: usize = format.t_find_lc(buf.data, format.LC_UNIXTHREAD);
    if (th == 0) { ret 1; }
    if (arch_id == isa.ARCH_AARCH64) {
        if (bin.read_u64_le(buf.data, th + 16 + format.ARM_PC_STATE_OFFSET) != entry) { ret 1; }
    }
    or {
        if (bin.read_u64_le(buf.data, th + 16 + format.X86_RIP_STATE_OFFSET) != entry) { ret 1; }
    }

    val cs: usize = format.t_find_lc(buf.data, format.LC_CODE_SIGNATURE);
    if (cs == 0) { ret 1; }
    val sig_off: usize = bin.read_u32_le(buf.data, cs + 8)::usize;
    if (bin.read_u32_be(buf.data, sig_off) != format.CSMAGIC_EMBEDDED_SIGNATURE)                           { ret 1; }
    if (bin.read_u32_be(buf.data, sig_off + format.SUPERBLOB_HEADER_SIZE) != format.CSMAGIC_CODEDIRECTORY) { ret 1; }
    ret 0;
}

#[testing]
fun t_count_sg_read_only(buf: *u8) u32 {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var n:     u32   = 0;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == format.LC_SEGMENT_64
            && (bin.read_u32_le(buf, off + 68) & format.SG_READ_ONLY) != 0) { n = n + 1; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret n;
}

#[testing]
fun t_count_segs_named(buf: *u8, name: str) u32 {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var n:     u32   = 0;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == format.LC_SEGMENT_64 && format.fixed16_equals(buf, off + 8, name)) { n = n + 1; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret n;
}

#[testing]
fun t_sections_match_segname(buf: *u8) bool {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == format.LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + format.SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                var i: usize = 0;
                for (i < 16) {
                    if (buf[sh + 16 + i] != buf[off + 8 + i]) { ret false; }
                    i = i + 1;
                }
                sh = sh + format.SECTION_64_SIZE;
                k  = k + 1;
            }
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret true;
}

#[testing]
fun t_rebase_vaddr(buf: *u8, nth: u32) u64 {
    val info: usize = format.t_find_lc(buf, format.LC_DYLD_INFO_ONLY);
    if (info == 0) { ret 0; }
    val off:  usize = bin.read_u32_le(buf, info + 8)::usize;
    val size: usize = bin.read_u32_le(buf, info + 12)::usize;
    var p:    usize = off;
    var n:    u32   = 0;
    for (p < off + size) {
        val op:  u8 = buf[p] & 0xF0;
        val imm: u8 = buf[p] & 0x0F;
        p = p + 1;
        if (op == format.REBASE_OPCODE_DONE) { ret 0; }
        if (op == format.REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB) {
            var slot:  u64 = 0;
            var shift: u32 = 0;
            for (p < off + size) {
                val b: u8 = buf[p];
                p    = p + 1;
                slot = slot | ((b & 0x7F)::u64 << shift::u64);
                if ((b & 0x80) == 0) { brk; }
                shift = shift + 7;
            }
            if (n == nth) {
                val ncmds: u32   = bin.read_u32_le(buf, 16);
                var so:    usize = format.MACH_HEADER_64_SIZE;
                var si:    u32   = 0;
                var c:     u32   = 0;
                for (c < ncmds) {
                    if (bin.read_u32_le(buf, so) == format.LC_SEGMENT_64) {
                        if (si == imm::u32) { ret bin.read_u64_le(buf, so + 24) + slot; }
                        si = si + 1;
                    }
                    so = so + bin.read_u32_le(buf, so + 4)::usize;
                    c  = c + 1;
                }
                ret 0;
            }
            n = n + 1;
        }
    }
    ret 0;
}

#[testing]
fun t_name_segs(alloc: *A.Allocator, itn: *intern.Interner, segs: *of.LoadSegment, seg_count: u32) u8 {
    var i: u32 = 0;
    for (i < seg_count) {
        val ar: res[*of.LoadSection, A.Error] = A.zallocate[of.LoadSection](alloc, 1);
        if (sel ar.err) { ret 1; }
        val sec:  *of.LoadSection = ar.ok;
        val zf:   bool            = segs[i].filesz == 0 && segs[i].memsz > 0;
        var nm:   str             = "__const";
        var kind: of.SectionKind  = of.SK_RODATA;
        if ((segs[i].flags & of.SEG_FLAG_EXECUTE) != 0) {
            nm   = "__text";
            kind = of.SK_TEXT;
        }
        or (zf) {
            nm   = "__bss";
            kind = of.SK_BSS;
        }
        or ((segs[i].flags & of.SEG_FLAG_WRITE) != 0) {
            nm   = "__data";
            kind = of.SK_DATA;
        }
        sec.name              = format.t_intern(itn, nm);
        sec.kind              = kind;
        sec.offset            = 0;
        sec.len               = segs[i].memsz::u32;
        sec.align             = 8;
        segs[i].sections      = sec;
        segs[i].section_count = 1;
        i                     = i + 1;
    }
    ret 0;
}

#[testing]
fun t_emit_dyn(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget,
    segs: *of.LoadSegment, seg_count: u32, dyn: *of.DynamicInfo,
    entry: u64, base: u64) res[Vector[u8], fail.Fail] {
    if (t_name_segs(alloc, itn, segs, seg_count) != 0) { ret res[Vector[u8], fail.Fail].err{fail.message("names")}; }
    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "macho_seg");
    if (sel tf_r.err) { ret res[Vector[u8], fail.Fail].err{fail.message("temp")}; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val em: err[fail.Fail] = emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count,
        0x4000, base, entry,
        nil::*of.ExecFunction, 0, dyn, nil::*of.PltFixup, 0,
        nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0,
        fixture.path(?tf), "machoseg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) {
        ret res[Vector[u8], fail.Fail].err{em.err};
    }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, fixture.path(?tf));

    if (sel rb.err) { ret res[Vector[u8], fail.Fail].err{fail.fs_refused(rb.err)}; }
    ret res[Vector[u8], fail.Fail].ok{rb.ok};
}

#[testing]
fun t_frame_segs(buf: *u8, names: *usize, nsects: *u32, sect0: *usize, cap: u32) u32 {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var n:     u32   = 0;
    var c:     u32   = 0;
    for (c < ncmds && n < cap) {
        if (bin.read_u32_le(buf, off) == format.LC_SEGMENT_64) {
            names[n]  = off + 8;
            nsects[n] = bin.read_u32_le(buf, off + 64);
            sect0[n]  = 0;
            if (nsects[n] > 0) { sect0[n] = off + format.SEGMENT_CMD_64_SIZE; }
            n = n + 1;
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret n;
}

#[testing]
fun t_fixed16_same(buf_a: *u8, off_a: usize, buf_b: *u8, off_b: usize) bool {
    var i: usize = 0;
    for (i < 16) {
        if (buf_a[off_a + i] != buf_b[off_b + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun ts_exec_frames_like_dyn() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:    intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var bytes: [48]u8;
    var k:     usize = 0;
    for (k < 48) {
        bytes[k] = 0x90;
        k        = k + 1;
    }

    val base:  u64 = 0x100000000;
    val pg:    u64 = format.macho_page_size(isa.ARCH_X86_64);
    val first: u64 = base + pg;
    var segs:  [3]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ;
    segs[2].bytes  = ?bytes[32];

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_frame");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    if (t_name_segs(?alloc, ?itn, ?segs[0], 3) != 0) { ret 1; }
    val em: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 3,
        pg, base, first,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        fixture.path(?tf), "machoframe"::*u8,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?tf));

    if (sel rb.err) { ret 1; }
    val stat: Vector[u8] = rb.ok;

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie    = true;
    val dr: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 3, ?dyn, first, base);
    if (sel dr.err) { ret 1; }
    val dynb: Vector[u8] = dr.ok;

    val spz: usize = t_find_seg(stat.data, "__PAGEZERO");
    val dpz: usize = t_find_seg(dynb.data, "__PAGEZERO");
    if (spz == 0 || dpz == 0)                         { ret 1; }
    if (bin.read_u64_le(stat.data, spz + 32) != base) { ret 1; }
    if (bin.read_u64_le(dynb.data, dpz + 32) != base) { ret 1; }
    val stx: usize = t_find_seg(stat.data, "__TEXT");
    val dtx: usize = t_find_seg(dynb.data, "__TEXT");
    if (stx == 0 || dtx == 0)                                                       { ret 1; }
    if (bin.read_u64_le(stat.data, stx + 24) != base)                               { ret 1; }
    if (bin.read_u64_le(dynb.data, dtx + 24) != base)                               { ret 1; }
    if (bin.read_u64_le(stat.data, stx + 40) != 0)                                  { ret 1; }
    if (bin.read_u64_le(stat.data, stx + format.SEGMENT_CMD_64_SIZE + 32) != first) { ret 1; }

    var snames:  [8]usize;
    var snsects: [8]u32;
    var ssect0:  [8]usize;
    var dnames:  [8]usize;
    var dnsects: [8]u32;
    var dsect0:  [8]usize;
    val sn:      u32 = t_frame_segs(stat.data, ?snames[0], ?snsects[0], ?ssect0[0], 8);
    val dn:      u32 = t_frame_segs(dynb.data, ?dnames[0], ?dnsects[0], ?dsect0[0], 8);
    if (sn != dn || sn < 4) { ret 1; }
    var i: u32 = 0;
    for (i < sn) {
        if (!t_fixed16_same(stat.data, snames[i], dynb.data, dnames[i])) { ret 1; }
        if (snsects[i] != dnsects[i])                                    { ret 1; }
        if (snsects[i] > 0
            && !t_fixed16_same(stat.data, ssect0[i], dynb.data, dsect0[i])) { ret 1; }
        i = i + 1;
    }
    if (snsects[1] == 0 || snsects[2] == 0 || snsects[3] == 0) { ret 1; }

    if (format.t_find_lc(stat.data, format.LC_UNIXTHREAD) == 0) { ret 1; }
    if (format.t_find_lc(dynb.data, format.LC_MAIN) == 0)       { ret 1; }
    if (format.t_find_lc(stat.data, format.LC_MAIN) != 0)       { ret 1; }
    if (format.t_find_lc(dynb.data, format.LC_UNIXTHREAD) != 0) { ret 1; }
    # both images identify themselves by content, and different content differs
    if (t_uuid_matches_content(?alloc, ?stat) != 0) { ret 1; }
    if (t_uuid_matches_content(?alloc, ?dynb) != 0) { ret 1; }
    val su: usize = format.t_find_lc(stat.data, format.LC_UUID);
    val du: usize = format.t_find_lc(dynb.data, format.LC_UUID);
    if (memory.raw_equal((stat.data::usize + su + 8)::ptr, (dynb.data::usize + du + 8)::ptr, 16)) { ret 1; }
    ret 0;
}

#[testing]
fun t_emit_both(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget,
    segs: *of.LoadSegment, seg_count: u32, base: u64,
    stat: *Vector[u8], dynb: *Vector[u8]) u8 {
    val opts:  of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val entry: u64             = segs[0].vaddr;

    val sf: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "macho_both_s");
    if (sel sf.err) { ret 1; }
    var stf: fixture.Output = sf.ok;
    fin { fixture.dnit(?stf); }
    val se: err[fail.Fail] = emit_exec(alloc, itn, isa_vt, segs, seg_count,
        format.macho_page_size(isa_vt.arch_id), base, entry,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        fixture.path(?stf), "machoboth"::*u8, opts);
    if (sel se.err) { ret 1; }
    val sb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, fixture.path(?stf));

    if (sel sb.err) { ret 1; }

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie    = true;
    val df: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "macho_both_d");
    if (sel df.err) { ret 1; }
    var dtf: fixture.Output = df.ok;
    fin { fixture.dnit(?dtf); }
    val de: err[fail.Fail] = emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count,
        format.macho_page_size(isa_vt.arch_id), base, entry,
        nil::*of.ExecFunction, 0, ?dyn, nil::*of.PltFixup, 0,
        nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0,
        fixture.path(?dtf), "machoboth"::*u8, opts);
    if (sel de.err) { ret 1; }
    val db: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, fixture.path(?dtf));

    if (sel db.err) { ret 1; }

    @stat = sb.ok;
    @dynb = db.ok;
    ret 0;
}

#[testing]
fun ts_header_span_multi_page(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:    intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(arch_id);

    val pg:    u64 = format.macho_page_size(arch_id);
    val nsect: u32 = 256;

    var bytes: [2048]u8;
    var k:     usize = 0;
    for (k < 2048) {
        bytes[k] = 0;
        k        = k + 1;
    }

    val sr: res[*of.LoadSection, A.Error] = A.zallocate[of.LoadSection](?alloc, nsect::usize);
    if (sel sr.err) { ret 1; }
    val secs: *of.LoadSection = sr.ok;

    var nm: [8]u8;
    nm[0] = 0x5F;
    nm[1] = 0x5F;
    nm[2] = 0x73;
    nm[6] = 0;
    nm[7] = 0;
    var i: u32 = 0;
    for (i < nsect) {
        nm[3]        = (48 + (i / 100) % 10)::u8;
        nm[4]        = (48 + (i / 10) % 10)::u8;
        nm[5]        = (48 + i % 10)::u8;
        secs[i].name = format.t_intern(?itn, ?nm[0]);
        if (secs[i].name == intern.STR_NIL) { ret 1; }
        secs[i].kind   = of.SK_TEXT;
        secs[i].offset = i * 8;
        secs[i].len    = 8;
        secs[i].align  = 8;
        i              = i + 1;
    }

    var segs: [1]of.LoadSegment;
    segs[0].filesz        = 2048;
    segs[0].memsz         = 2048;
    segs[0].flags         = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes         = ?bytes[0];
    segs[0].sections      = secs;
    segs[0].section_count = nsect;

    var shape: of.HeaderShape;
    shape.itn         = ?itn;
    shape.libs        = nil::*of.DynLib;
    shape.lib_count   = 0;
    shape.seg_count   = 1;
    shape.sect_count  = nsect;
    shape.debug_count = 0;
    shape.pie         = true;
    val span: u64 = loadcmd.header_span(?shape, pg);
    if (span <= pg)       { ret 1; }
    if ((span % pg) != 0) { ret 1; }

    val base: u64 = 0x100000000;
    segs[0].vaddr = base + span;

    var stat: Vector[u8];
    var dynb: Vector[u8];
    if (t_emit_both(?alloc, ?itn, ?isa_vt, ?segs[0], 1, base, ?stat, ?dynb) != 0) { ret 1; }

    var w: u32 = 0;
    for (w < 2) {
        var buf: *u8 = stat.data;
        if (w == 1) { buf = dynb.data; }

        val sizeofcmds: usize = bin.read_u32_le(buf, 20)::usize;
        if (sizeofcmds::u64 <= pg)                                 { ret 1; }
        if (format.MACH_HEADER_64_SIZE + sizeofcmds > span::usize) { ret 1; }

        val pz: usize = t_find_seg(buf, "__PAGEZERO");
        val tx: usize = t_find_seg(buf, "__TEXT");
        if (pz == 0 || tx == 0)                     { ret 1; }
        if (bin.read_u64_le(buf, pz + 24) != 0)     { ret 1; }
        if (bin.read_u64_le(buf, pz + 32) != base)  { ret 1; }
        if (bin.read_u64_le(buf, tx + 24) != base)  { ret 1; }
        if (bin.read_u64_le(buf, tx + 40) != 0)     { ret 1; }
        if (bin.read_u32_le(buf, tx + 64) != nsect) { ret 1; }

        val s0: usize = tx + format.SEGMENT_CMD_64_SIZE;
        if (bin.read_u64_le(buf, s0 + 32) != base + span) { ret 1; }
        if (bin.read_u32_le(buf, s0 + 48)::u64 != span)   { ret 1; }
        w = w + 1;
    }

    segs[0].vaddr = base + pg;
    val opts: of.ImageOptions                   = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_span_bad");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val bad_s: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        pg, base, base + pg,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        fixture.path(?tf), "machospanbad"::*u8, opts);
    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie    = true;
    val bad_d: err[fail.Fail] = emit_dyn_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        pg, base, base + pg,
        nil::*of.ExecFunction, 0, ?dyn, nil::*of.PltFixup, 0,
        nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0,
        fixture.path(?tf), "machospanbad"::*u8, opts);

    if (!sel bad_s.err) { ret 1; }
    if (!sel bad_d.err) { ret 1; }
    ret 0;
}

#[testing]
fun ts_dyn_exec_relro_segments(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(arch_id);

    var bytes: [80]u8;
    var k:     usize = 0;
    for (k < 80) {
        bytes[k] = 0;
        k        = k + 1;
    }

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs:  [5]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ;
    segs[2].bytes  = ?bytes[32];
    segs[3].vaddr  = first + pg * 3;
    segs[3].filesz = 16;
    segs[3].memsz  = 16;
    segs[3].flags  = of.SEG_FLAG_READ;
    segs[3].bytes  = ?bytes[48];
    segs[4].vaddr  = first + pg * 4;
    segs[4].filesz = 0;
    segs[4].memsz  = 16;
    segs[4].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[4].bytes  = nil;

    var brs: [3]of.BaseReloc;
    brs[0].seg_index  = 1;
    brs[0].seg_offset = 0;
    brs[0].target     = base;
    brs[1].seg_index  = 3;
    brs[1].seg_offset = 0;
    brs[1].target     = base;
    brs[2].seg_index  = 2;
    brs[2].seg_offset = 0;
    brs[2].target     = base;

    var dyn: of.DynamicInfo;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = ?brs[0];
    dyn.base_reloc_count = 2;
    dyn.pie              = true;

    val r1: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 5, ?dyn, first, base);
    if (sel r1.err) { ret 1; }
    val buf: Vector[u8] = r1.ok;

    if (t_count_sg_read_only(buf.data) != 1)               { ret 1; }
    if (t_count_segs_named(buf.data, "__DATA_CONST") != 1) { ret 1; }
    val dc: usize = t_find_seg(buf.data, "__DATA_CONST");
    if (dc == 0)                                                                            { ret 1; }
    if (bin.read_u64_le(buf.data, dc + 24) != first + pg * 3)                               { ret 1; }
    if ((bin.read_u32_le(buf.data, dc + 68) & format.SG_READ_ONLY) == 0)                    { ret 1; }
    if (bin.read_u32_le(buf.data, dc + 60) != (format.VM_PROT_READ | format.VM_PROT_WRITE)) { ret 1; }
    if (bin.read_u32_le(buf.data, dc + 64) != 1)                                            { ret 1; }

    if (t_count_segs_named(buf.data, "__RODATA") != 1) { ret 1; }
    val rd: usize = t_find_seg(buf.data, "__RODATA");
    if (rd == 0)                                                         { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 24) != first + pg * 2)            { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 60) != format.VM_PROT_READ)       { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 56) != format.VM_PROT_READ)       { ret 1; }
    if ((bin.read_u32_le(buf.data, rd + 68) & format.SG_READ_ONLY) != 0) { ret 1; }

    val dt: usize = t_find_seg(buf.data, "__DATA");
    if (dt == 0)                                                                            { ret 1; }
    if (bin.read_u64_le(buf.data, dt + 24) != first + pg)                                   { ret 1; }
    if (bin.read_u32_le(buf.data, dt + 60) != (format.VM_PROT_READ | format.VM_PROT_WRITE)) { ret 1; }
    if (bin.read_u32_le(buf.data, dt + 56) != (format.VM_PROT_READ | format.VM_PROT_WRITE)) { ret 1; }
    if ((bin.read_u32_le(buf.data, dt + 68) & format.SG_READ_ONLY) != 0)                    { ret 1; }

    if (!t_sections_match_segname(buf.data))           { ret 1; }
    if (t_rebase_vaddr(buf.data, 0) != first + pg)     { ret 1; }
    if (t_rebase_vaddr(buf.data, 1) != first + pg * 3) { ret 1; }
    if (t_rebase_vaddr(buf.data, 2) != 0)              { ret 1; }

    dyn.base_reloc_count = 3;
    val r2: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 5, ?dyn, first, base);
    if (sel r2.err) { ret 1; }
    val buf2: Vector[u8] = r2.ok;
    if (t_count_sg_read_only(buf2.data) != 1)               { ret 1; }
    if (t_count_segs_named(buf2.data, "__DATA_CONST") != 1) { ret 1; }
    if (t_count_segs_named(buf2.data, "__RODATA") != 0)     { ret 1; }
    val dc2: usize = t_find_seg(buf2.data, "__DATA_CONST");
    if (bin.read_u64_le(buf2.data, dc2 + 24) != first + pg * 2) { ret 1; }
    if (bin.read_u32_le(buf2.data, dc2 + 64) != 2)              { ret 1; }
    val r_5393: res[u64, layout.CheckCause] = layout.align_u64_up(pg + 16, format.macho_page_size(arch_id));
    if (sel r_5393.err)                                    { ret 1; }
    if (bin.read_u64_le(buf2.data, dc2 + 32) != r_5393.ok) { ret 1; }
    if (!t_sections_match_segname(buf2.data))              { ret 1; }
    if (t_rebase_vaddr(buf2.data, 0) != first + pg)        { ret 1; }
    if (t_rebase_vaddr(buf2.data, 1) != first + pg * 2)    { ret 1; }
    if (t_rebase_vaddr(buf2.data, 2) != first + pg * 3)    { ret 1; }
    ret 0;
}

#[testing]
fun ts_dyn_exec_split_data_const() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_AARCH64);

    var bytes: [64]u8;
    var k:     usize = 0;
    for (k < 64) {
        bytes[k] = 0;
        k        = k + 1;
    }

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs:  [4]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[2].bytes  = ?bytes[32];
    segs[3].vaddr  = first + pg * 3;
    segs[3].filesz = 16;
    segs[3].memsz  = 16;
    segs[3].flags  = of.SEG_FLAG_READ;
    segs[3].bytes  = ?bytes[48];

    var brs: [2]of.BaseReloc;
    brs[0].seg_index  = 1;
    brs[0].seg_offset = 8;
    brs[0].target     = base;
    brs[1].seg_index  = 3;
    brs[1].seg_offset = 0;
    brs[1].target     = base;

    var dyn: of.DynamicInfo;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = ?brs[0];
    dyn.base_reloc_count = 2;
    dyn.pie              = true;

    val r: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 4, ?dyn, first, base);
    if (!sel r.err) { ret 1; }
    val msg: str = fail.describe(r.err);
    if (!str_contains(msg, "__DATA_CONST"))              { ret 1; }
    if (!str_contains(msg, "read-only load segments 1")) { ret 1; }
    if (!str_contains(msg, "and 3"))                     { ret 1; }
    ret 0;
}

#[testing]
fun ts_exec_merges_read_only() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var bytes: [48]u8;
    var k:     usize = 0;
    for (k < 48) {
        bytes[k] = 0;
        k        = k + 1;
    }

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs:  [3]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ;
    segs[2].bytes  = ?bytes[32];

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_exec_ro");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    if (t_name_segs(?alloc, ?itn, ?segs[0], 3) != 0) { ret 1; }
    val em: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 3,
        pg, base, first,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        fixture.path(?tf), "machoexecro"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?tf));

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (t_count_segs_named(buf.data, "__RODATA") != 1) { ret 1; }
    val rd: usize = t_find_seg(buf.data, "__RODATA");
    if (rd == 0)                                          { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 24) != first + pg) { ret 1; }
    val r_5486: res[u64, layout.CheckCause] = layout.align_u64_up(pg + 16, format.EXEC_PAGE_SIZE);
    if (sel r_5486.err)                                            { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 32) != r_5486.ok)           { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 60) != format.VM_PROT_READ) { ret 1; }

    if (parse.macho_kind_from(0, false, false, true) != of.SK_RODATA) { ret 1; }
    ret 0;
}

