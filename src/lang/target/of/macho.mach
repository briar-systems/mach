fun ts_exec_debug_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var k: usize = 0;
    for (k < 8) { code[k] = 0x90; k = k + 1; }
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 4096;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base + 4096; segs[0].filesz = 8; segs[0].memsz = 8;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    var line_bytes: [3]u8;
    line_bytes[0] = 0x11; line_bytes[1] = 0x22; line_bytes[2] = 0x33;

    val nm_info: R.Result[intern.StrId, str] = intern.intern(?itn, ".debug_info");
    val nm_line: R.Result[intern.StrId, str] = intern.intern(?itn, ".debug_line");
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }
    if (R.is_err[intern.StrId, str](nm_line)) { ret 1; }
    val id_info: intern.StrId = R.unwrap_ok[intern.StrId, str](nm_info);
    val id_line: intern.StrId = R.unwrap_ok[intern.StrId, str](nm_line);

    var dbg: [2]of.Section;
    dbg[0].name = id_info; dbg[0].kind = of.SK_DEBUG; dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;
    dbg[1].name = id_line; dbg[1].kind = of.SK_DEBUG; dbg[1].bytes = ?line_bytes[0]; dbg[1].len = 3; dbg[1].align = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_dbg");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                            4096, base, entry,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            ?dbg[0], 2, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "machodbg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_info")) { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_line")) { ret 1; }

    val dw: usize = t_find_seg(buf.data, "__DWARF");
    if (dw == 0) { ret 1; }
    if ((bin.read_u64_le(buf.data, dw + 40) % macho_page_size(isa.ARCH_X86_64)) != 0) { ret 1; }

    var img: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?itn, buf.data, buf.len, ?img);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var found_info: bool = false;
    var found_line: bool = false;
    var bad: bool = false;
    var si: u32 = 0;
    for (si < img.section_count) {
        val sec: *of.Section = ?img.sections[si];
        if (sec.kind == of.SK_DEBUG && sec.name == id_info) {
            found_info = true;
            if (sec.len != 4 || sec.bytes == nil) { bad = true; }
            or {
                if (sec.bytes[0] != 0xDE || sec.bytes[1] != 0xAD
                    || sec.bytes[2] != 0xBE || sec.bytes[3] != 0xEF) { bad = true; }
            }
        }
        if (sec.kind == of.SK_DEBUG && sec.name == id_line) {
            found_line = true;
            if (sec.len != 3 || sec.bytes == nil) { bad = true; }
            or {
                if (sec.bytes[0] != 0x11 || sec.bytes[1] != 0x22 || sec.bytes[2] != 0x33) { bad = true; }
            }
        }
        si = si + 1;
    }

    if (bad)         { ret 1; }
    if (!found_info) { ret 1; }
    if (!found_line) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.emit_exec:debug_dwarf_roundtrip" {
    if (ts_exec_debug_roundtrip() != 0) { ret 1; }
    ret 0;
}

fun ts_object_debug_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0x90; k = k + 1; }
    var info_bytes: [8]u8;
    k = 0;
    for (k < 8) { info_bytes[k] = 0; k = k + 1; }
    var str_bytes: [6]u8;
    str_bytes[0] = 'h'; str_bytes[1] = 'i'; str_bytes[2] = 0;
    str_bytes[3] = 'y'; str_bytes[4] = 'o'; str_bytes[5] = 0;

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".debug_info"); secs[1].kind = of.SK_DEBUG;
    secs[1].bytes = ?info_bytes[0]; secs[1].len = 8; secs[1].align = 1;
    secs[2].name = t_intern(?i, ".debug_str"); secs[2].kind = of.SK_DEBUG;
    secs[2].bytes = ?str_bytes[0]; secs[2].len = 6; secs[2].align = 1;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "l.debug_str"); syms[1].section = 2; syms[1].offset = 0;
    syms[1].size = 0; syms[1].flags = 0;

    var relocs: [1]of.Relocation;
    relocs[0].section = 1; relocs[0].offset = 0; relocs[0].kind = of.RK_ABS32;
    relocs[0].sym = 1; relocs[0].addend = 3;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_odbg");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u32_le(buf.data, MACH_HEADER_64_SIZE + 64) != 3) { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_info")) { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_str"))  { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__DWARF"))      { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 3) { ret 1; }

    val cid_info: intern.StrId = t_intern(?i, ".debug_info");
    val cid_str:  intern.StrId = t_intern(?i, ".debug_str");
    var found_info: bool = false;
    var found_str:  bool = false;
    var si: u32 = 0;
    for (si < out.section_count) {
        val sec: *of.Section = ?out.sections[si];
        if (sec.kind == of.SK_DEBUG && sec.name == cid_info) { found_info = true; }
        if (sec.kind == of.SK_DEBUG && sec.name == cid_str)  { found_str = true; }
        si = si + 1;
    }
    if (!found_info || !found_str) { ret 1; }

    if (out.reloc_count != 1) { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS32) { ret 1; }
    if (out.relocations[0].addend != 3)         { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.emit_object:debug_dwarf_roundtrip" {
    if (ts_object_debug_roundtrip() != 0) { ret 1; }
    ret 0;
}

fun t_make_section_based(buf: *u8, sh: usize, address: u32, sect: u32) bool {
    val e: usize = t_find_reloc(buf, sh, address);
    if (e == 0) { ret false; }
    bin.write_u32_le(buf, e + 4, (bin.read_u32_le(buf, e + 4) & 0xF7000000) | sect);
    ret true;
}

fun t_find_reloc(buf: *u8, sh: usize, address: u32) usize {
    val reloff: usize = bin.read_u32_le(buf, sh + 56)::usize;
    val nreloc: u32 = bin.read_u32_le(buf, sh + 60);
    var r: u32 = 0;
    for (r < nreloc) {
        val e: usize = reloff + r::usize * RELOC_INFO_SIZE;
        if (bin.read_u32_le(buf, e) == address) { ret e; }
        r = r + 1;
    }
    ret 0;
}

fun t_set_reloc_type(buf: *u8, sh: usize, address: u32, r_type: u32) bool {
    val e: usize = t_find_reloc(buf, sh, address);
    if (e == 0) { ret false; }
    bin.write_u32_le(buf, e + 4, (bin.read_u32_le(buf, e + 4) & 0x0FFFFFFF) | (r_type << 28));
    ret true;
}

fun t_reloc_at(img: *of.ObjectImage, sec: u32, off: u32) *of.Relocation {
    var r: u32 = 0;
    for (r < img.reloc_count) {
        if (img.relocations[r].section == sec && img.relocations[r].offset == off) { ret ?img.relocations[r]; }
        r = r + 1;
    }
    ret nil;
}

fun t_sym_named(img: *of.ObjectImage, name: intern.StrId) *of.Symbol {
    var s: u32 = 0;
    for (s < img.symbol_count) {
        if (img.symbols[s].name == name) { ret ?img.symbols[s]; }
        s = s + 1;
    }
    ret nil;
}

fun ts_section_reloc_x64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 8;  relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;
    relocs[1].section = 0; relocs[1].offset = 16; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 1; relocs[1].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 2;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_secrel");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val sh1: usize = sh0 + SECTION_64_SIZE;
    val text_addr: u64 = bin.read_u64_le(buf.data, sh0 + 32);
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val data_addr: u64 = bin.read_u64_le(buf.data, sh1 + 32);
    val target:    u64 = data_addr + 6;

    if (!t_make_section_based(buf.data, sh0, 8, 2))  { ret 1; }
    if (!t_make_section_based(buf.data, sh0, 16, 2)) { ret 1; }
    bin.write_u64_le(buf.data, text_off + 16, target);
    bin.write_u32_le(buf.data, text_off + 8, (target::i64 - (text_addr + 8 + 4)::i64)::u32);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.symbol_count != 3) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, t_intern(?i, "__DATA,__data"));
    if (anchor == nil)                             { ret 1; }
    if (anchor.section != 1 || anchor.offset != 0) { ret 1; }
    if (anchor.size != 0 || anchor.flags != 0)     { ret 1; }

    val abs64: *of.Relocation = t_reloc_at(?out, 0, 16);
    if (abs64 == nil)                    { ret 1; }
    if (abs64.kind != of.RK_ABS64)       { ret 1; }
    if (abs64.sym >= out.symbol_count)   { ret 1; }
    if (out.symbols[abs64.sym].name != anchor.name) { ret 1; }
    if (abs64.addend != 6)               { ret 1; }

    val pc32: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (pc32 == nil)                     { ret 1; }
    if (pc32.kind != of.RK_PC32)         { ret 1; }
    if (pc32.sym >= out.symbol_count)    { ret 1; }
    if (out.symbols[pc32.sym].name != anchor.name) { ret 1; }
    if (pc32.addend != 2)                { ret 1; }
    ret 0;
}

fun ts_section_signed_variants() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    var text_bytes: [16]u8;
    var data_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0; data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 16; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = 1; syms[1].offset = 6;
    syms[1].size = 4; syms[1].flags = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = 0;
    relocs[1].section = 0; relocs[1].offset = 4; relocs[1].kind = of.RK_PC32;
    relocs[1].sym = 1; relocs[1].addend = 0;
    relocs[2].section = 0; relocs[2].offset = 8; relocs[2].kind = of.RK_PC32;
    relocs[2].sym = 1; relocs[2].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "section_signed");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_secsigned");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);
    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val sh1: usize = sh0 + SECTION_64_SIZE;
    val text_addr: u64 = bin.read_u64_le(buf.data, sh0 + 32);
    val text_off: usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val target: u64 = bin.read_u64_le(buf.data, sh1 + 32) + 6;
    if (!t_make_section_based(buf.data, sh0, 0, 2)
        || !t_make_section_based(buf.data, sh0, 4, 2)
        || !t_make_section_based(buf.data, sh0, 8, 2)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 0, X86_64_RELOC_SIGNED_1)
        || !t_set_reloc_type(buf.data, sh0, 4, X86_64_RELOC_SIGNED_2)
        || !t_set_reloc_type(buf.data, sh0, 8, X86_64_RELOC_SIGNED_4)) { ret 1; }
    bin.write_u32_le(buf.data, text_off,     (target::i64 - (text_addr + 0 + 4 + 1)::i64)::u32);
    bin.write_u32_le(buf.data, text_off + 4, (target::i64 - (text_addr + 4 + 4 + 2)::i64)::u32);
    bin.write_u32_le(buf.data, text_off + 8, (target::i64 - (text_addr + 8 + 4 + 4)::i64)::u32);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, t_intern(?i, "__DATA,__data"));
    if (anchor == nil) { ret 1; }
    val r1: *of.Relocation = t_reloc_at(?out, 0, 0);
    val r2: *of.Relocation = t_reloc_at(?out, 0, 4);
    val r4: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (r1 == nil || r2 == nil || r4 == nil) { ret 1; }
    if (r1.sym >= out.symbol_count || out.symbols[r1.sym].name != anchor.name || r1.addend != 1) { ret 1; }
    if (r2.sym >= out.symbol_count || out.symbols[r2.sym].name != anchor.name || r2.addend != 0) { ret 1; }
    if (r4.sym >= out.symbol_count || out.symbols[r4.sym].name != anchor.name || r4.addend != -2) { ret 1; }

    bin.write_u64_le(buf.data, sh0 + 32, 0xFFFFFFFFFFFFFFF8);
    var overflow: of.ObjectImage;
    val po: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?overflow);
    if (R.is_ok[R.Void, str](po) || !str_contains(R.unwrap_err[R.Void, str](po), "overflows address space")) { ret 1; }
    ret 0;
}

fun ts_section_reloc_arm64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[3] = 0x90;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PAGE21;
    relocs[0].sym = 1; relocs[0].addend = 0;
    relocs[1].section = 0; relocs[1].offset = 8; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 1; relocs[1].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 2;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_secrela");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val sh1: usize = sh0 + SECTION_64_SIZE;
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val data_addr: u64 = bin.read_u64_le(buf.data, sh1 + 32);

    if (!t_make_section_based(buf.data, sh0, 8, 2)) { ret 1; }
    bin.write_u64_le(buf.data, text_off + 8, data_addr + 3);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, t_intern(?i, "__DATA,__data"));
    if (anchor == nil)                   { ret 1; }
    val abs64: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (abs64 == nil)                    { ret 1; }
    if (abs64.sym >= out.symbol_count)   { ret 1; }
    if (out.symbols[abs64.sym].name != anchor.name) { ret 1; }
    if (abs64.addend != 3)               { ret 1; }

    if (!t_make_section_based(buf.data, sh0, 0, 2)) { ret 1; }
    var out2: of.ObjectImage;
    val pr2: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out2);
    if (R.is_ok[R.Void, str](pr2)) { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr2), "page21")) { ret 1; }
    ret 0;
}

fun ts_section_reloc_out_of_range() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 16; relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_secrelo");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    if (!t_make_section_based(buf.data, seg + SEGMENT_CMD_64_SIZE, 16, 7)) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_ok[R.Void, str](pr)) { ret 1; }
    if (out.sections != nil || out.section_count != 0 || out.section_cap != 0
        || out.symbols != nil || out.symbol_count != 0 || out.symbol_cap != 0
        || out.relocations != nil || out.reloc_count != 0 || out.reloc_cap != 0
        || out.attributes != nil || out.attributes_len != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.parse_object:refuses_segment_section_headers_out_of_bounds" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_nsects_oob");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    bin.write_u32_le(buf.data, seg + 64, 0xFFFFFF);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!R.is_err[R.Void, str](pr))                                    { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "out of bounds")) { ret 1; }
    ret 0;
}

