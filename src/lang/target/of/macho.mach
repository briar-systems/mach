fun ts_exec_debug_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var k: usize = 0;
    for (k < 8) { code[k] = 0x90; k = k + 1; }
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 4096;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base + 4096; segs[0].filesz = 8; segs[0].memsz = 8;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    var line_bytes: [3]u8;
    line_bytes[0] = 0x11; line_bytes[1] = 0x22; line_bytes[2] = 0x33;

    val nm_info: res[intern.StrId, A.Error] = intern.intern_typed(?itn, ".debug_info");
    val nm_line: res[intern.StrId, A.Error] = intern.intern_typed(?itn, ".debug_line");
    if (sel nm_info.err) { ret 1; }
    if (sel nm_line.err) { ret 1; }
    val id_info: intern.StrId = nm_info.ok;
    val id_line: intern.StrId = nm_line.ok;

    var dbg: [2]of.Section;
    dbg[0].name = id_info; dbg[0].kind = of.SK_DEBUG; dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;
    dbg[1].name = id_line; dbg[1].kind = of.SK_DEBUG; dbg[1].bytes = ?line_bytes[0]; dbg[1].len = 3; dbg[1].align = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_dbg");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: err[fail.Fail] = t_planned_emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                            4096, base, entry,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            ?dbg[0], 2, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "machodbg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_info")) { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_line")) { ret 1; }

    val dw: usize = t_find_seg(buf.data, "__DWARF");
    if (dw == 0) { ret 1; }
    if (bin.read_u64_le(buf.data, dw + 32) != 0 || bin.read_u64_le(buf.data, dw + 48) == 0) { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 56) != 0 || bin.read_u32_le(buf.data, dw + 60) != 0) { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 68) != SG_NORELOC) { ret 1; }
    if ((bin.read_u64_le(buf.data, dw + 40) % macho_page_size(isa.ARCH_X86_64)) != 0) { ret 1; }

    var img: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?itn, buf.data, buf.len, ?img);
    if (sel pr.err) { ret 1; }

    var found_info: bool = false;
    var found_line: bool = false;
    var bad: bool = false;
    var si: u32 = 0;
    for (si < img.section_count) {
        val sec: *of.Section = ?img.sections[si];
        if (sec.kind == of.SK_DEBUG && sec.name == id_info) {
            found_info = true;
            if (sec.len != 4 || sec.bytes == nil) { bad = true; }
            or {
                if (sec.bytes[0] != 0xDE || sec.bytes[1] != 0xAD
                    || sec.bytes[2] != 0xBE || sec.bytes[3] != 0xEF) { bad = true; }
            }
        }
        if (sec.kind == of.SK_DEBUG && sec.name == id_line) {
            found_line = true;
            if (sec.len != 3 || sec.bytes == nil) { bad = true; }
            or {
                if (sec.bytes[0] != 0x11 || sec.bytes[1] != 0x22 || sec.bytes[2] != 0x33) { bad = true; }
            }
        }
        si = si + 1;
    }

    if (bad)         { ret 1; }
    if (!found_info) { ret 1; }
    if (!found_line) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.emit_exec:debug_dwarf_roundtrip" {
    if (ts_exec_debug_roundtrip() != 0) { ret 1; }
    ret 0;
}

fun ts_object_debug_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0x90; k = k + 1; }
    var info_bytes: [8]u8;
    k = 0;
    for (k < 8) { info_bytes[k] = 0; k = k + 1; }
    var str_bytes: [6]u8;
    str_bytes[0] = 'h'; str_bytes[1] = 'i'; str_bytes[2] = 0;
    str_bytes[3] = 'y'; str_bytes[4] = 'o'; str_bytes[5] = 0;

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".debug_info"); secs[1].kind = of.SK_DEBUG;
    secs[1].bytes = ?info_bytes[0]; secs[1].len = 8; secs[1].align = 1;
    secs[2].name = t_intern(?i, ".debug_str"); secs[2].kind = of.SK_DEBUG;
    secs[2].bytes = ?str_bytes[0]; secs[2].len = 6; secs[2].align = 1;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "l.debug_str"); syms[1].section = of.section_id(2); syms[1].offset = 0;
    syms[1].size = 0; syms[1].flags = 0;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(1); relocs[0].offset = 0; relocs[0].kind = of.RK_ABS32;
    relocs[0].sym = 1; relocs[0].addend = 3;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_odbg");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, MACH_HEADER_64_SIZE + 64) != 3) { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_info")) { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__debug_str"))  { ret 1; }
    if (!t_bytes_contain(buf.data, 0, buf.len, "__DWARF"))      { ret 1; }

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 3) { ret 1; }

    val cid_info: intern.StrId = t_intern(?i, ".debug_info");
    val cid_str:  intern.StrId = t_intern(?i, ".debug_str");
    var found_info: bool = false;
    var found_str:  bool = false;
    var si: u32 = 0;
    for (si < out.section_count) {
        val sec: *of.Section = ?out.sections[si];
        if (sec.kind == of.SK_DEBUG && sec.name == cid_info) { found_info = true; }
        if (sec.kind == of.SK_DEBUG && sec.name == cid_str)  { found_str = true; }
        si = si + 1;
    }
    if (!found_info || !found_str) { ret 1; }

    if (out.reloc_count != 1) { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS32) { ret 1; }
    if (out.relocations[0].addend != 3)         { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.emit_object:debug_dwarf_roundtrip" {
    if (ts_object_debug_roundtrip() != 0) { ret 1; }
    ret 0;
}

fun t_make_section_based(buf: *u8, sh: usize, address: u32, sect: u32) bool {
    val e: usize = t_find_reloc(buf, sh, address);
    if (e == 0) { ret false; }
    bin.write_u32_le(buf, e + 4, (bin.read_u32_le(buf, e + 4) & 0xF7000000) | sect);
    ret true;
}

fun t_find_reloc(buf: *u8, sh: usize, address: u32) usize {
    val reloff: usize = bin.read_u32_le(buf, sh + 56)::usize;
    val nreloc: u32 = bin.read_u32_le(buf, sh + 60);
    var r: u32 = 0;
    for (r < nreloc) {
        val e: usize = reloff + r::usize * RELOC_INFO_SIZE;
        if (bin.read_u32_le(buf, e) == address) { ret e; }
        r = r + 1;
    }
    ret 0;
}

fun t_set_reloc_type(buf: *u8, sh: usize, address: u32, r_type: u32) bool {
    val e: usize = t_find_reloc(buf, sh, address);
    if (e == 0) { ret false; }
    bin.write_u32_le(buf, e + 4, (bin.read_u32_le(buf, e + 4) & 0x0FFFFFFF) | (r_type << 28));
    ret true;
}

fun t_reloc_at(img: *of.ObjectImage, sec: u32, off: u32) *of.Relocation {
    var r: u32 = 0;
    for (r < img.reloc_count) {
        if (of.section_index(img.relocations[r].section) == sec && img.relocations[r].offset == off) { ret ?img.relocations[r]; }
        r = r + 1;
    }
    ret nil;
}

fun t_sym_named(img: *of.ObjectImage, name: intern.StrId) *of.Symbol {
    var s: u32 = 0;
    for (s < img.symbol_count) {
        if (img.symbols[s].name == name) { ret ?img.symbols[s]; }
        s = s + 1;
    }
    ret nil;
}

fun ts_section_reloc_x64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 8;  relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;
    relocs[1].section = of.section_id(0); relocs[1].offset = 16; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 1; relocs[1].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 2;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_secrel");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val sh1: usize = sh0 + SECTION_64_SIZE;
    val text_addr: u64 = bin.read_u64_le(buf.data, sh0 + 32);
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val data_addr: u64 = bin.read_u64_le(buf.data, sh1 + 32);
    val target:    u64 = data_addr + 6;

    if (!t_make_section_based(buf.data, sh0, 8, 2))  { ret 1; }
    if (!t_make_section_based(buf.data, sh0, 16, 2)) { ret 1; }
    bin.write_u64_le(buf.data, text_off + 16, target);
    bin.write_u32_le(buf.data, text_off + 8, (target::i64 - (text_addr + 8 + 4)::i64)::u32);

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.symbol_count != 3) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, t_intern(?i, "__DATA,__data"));
    if (anchor == nil)                             { ret 1; }
    if (of.section_index(anchor.section) != 1 || anchor.offset != 0) { ret 1; }
    if (anchor.size != 0 || anchor.flags != 0)     { ret 1; }

    val abs64: *of.Relocation = t_reloc_at(?out, 0, 16);
    if (abs64 == nil)                    { ret 1; }
    if (abs64.kind != of.RK_ABS64)       { ret 1; }
    if (abs64.sym >= out.symbol_count)   { ret 1; }
    if (out.symbols[abs64.sym].name != anchor.name) { ret 1; }
    if (abs64.addend != 6)               { ret 1; }

    val pc32: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (pc32 == nil)                     { ret 1; }
    if (pc32.kind != of.RK_PC32)         { ret 1; }
    if (pc32.sym >= out.symbol_count)    { ret 1; }
    if (out.symbols[pc32.sym].name != anchor.name) { ret 1; }
    if (pc32.addend != 2)                { ret 1; }
    ret 0;
}

fun ts_section_signed_variants() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    var text_bytes: [16]u8;
    var data_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0; data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 16; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = of.section_id(1); syms[1].offset = 6;
    syms[1].size = 4; syms[1].flags = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = 0;
    relocs[1].section = of.section_id(0); relocs[1].offset = 4; relocs[1].kind = of.RK_PC32;
    relocs[1].sym = 1; relocs[1].addend = 0;
    relocs[2].section = of.section_id(0); relocs[2].offset = 8; relocs[2].kind = of.RK_PC32;
    relocs[2].sym = 1; relocs[2].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "section_signed");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_secsigned");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);
    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val sh1: usize = sh0 + SECTION_64_SIZE;
    val text_addr: u64 = bin.read_u64_le(buf.data, sh0 + 32);
    val text_off: usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val target: u64 = bin.read_u64_le(buf.data, sh1 + 32) + 6;
    if (!t_make_section_based(buf.data, sh0, 0, 2)
        || !t_make_section_based(buf.data, sh0, 4, 2)
        || !t_make_section_based(buf.data, sh0, 8, 2)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 0, X86_64_RELOC_SIGNED_1)
        || !t_set_reloc_type(buf.data, sh0, 4, X86_64_RELOC_SIGNED_2)
        || !t_set_reloc_type(buf.data, sh0, 8, X86_64_RELOC_SIGNED_4)) { ret 1; }
    bin.write_u32_le(buf.data, text_off,     (target::i64 - (text_addr + 0 + 4 + 1)::i64)::u32);
    bin.write_u32_le(buf.data, text_off + 4, (target::i64 - (text_addr + 4 + 4 + 2)::i64)::u32);
    bin.write_u32_le(buf.data, text_off + 8, (target::i64 - (text_addr + 8 + 4 + 4)::i64)::u32);

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, t_intern(?i, "__DATA,__data"));
    if (anchor == nil) { ret 1; }
    val r1: *of.Relocation = t_reloc_at(?out, 0, 0);
    val r2: *of.Relocation = t_reloc_at(?out, 0, 4);
    val r4: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (r1 == nil || r2 == nil || r4 == nil) { ret 1; }
    if (r1.sym >= out.symbol_count || out.symbols[r1.sym].name != anchor.name || r1.addend != 1) { ret 1; }
    if (r2.sym >= out.symbol_count || out.symbols[r2.sym].name != anchor.name || r2.addend != 0) { ret 1; }
    if (r4.sym >= out.symbol_count || out.symbols[r4.sym].name != anchor.name || r4.addend != -2) { ret 1; }

    bin.write_u64_le(buf.data, sh0 + 32, 0xFFFFFFFFFFFFFFF8);
    var overflow: of.ObjectImage;
    val po: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?overflow);
    if (sel po.ok) { ret 1; }
    if (!str_contains(fail.describe(po.err), "overflows address space")) { ret 1; }
    ret 0;
}

fun ts_section_reloc_arm64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[3] = 0x90;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].kind = of.RK_PAGE21;
    relocs[0].sym = 1; relocs[0].addend = 0;
    relocs[1].section = of.section_id(0); relocs[1].offset = 8; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 1; relocs[1].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 2;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_secrela");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val sh1: usize = sh0 + SECTION_64_SIZE;
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val data_addr: u64 = bin.read_u64_le(buf.data, sh1 + 32);

    if (!t_make_section_based(buf.data, sh0, 8, 2)) { ret 1; }
    bin.write_u64_le(buf.data, text_off + 8, data_addr + 3);

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, t_intern(?i, "__DATA,__data"));
    if (anchor == nil)                   { ret 1; }
    val abs64: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (abs64 == nil)                    { ret 1; }
    if (abs64.sym >= out.symbol_count)   { ret 1; }
    if (out.symbols[abs64.sym].name != anchor.name) { ret 1; }
    if (abs64.addend != 3)               { ret 1; }

    if (!t_make_section_based(buf.data, sh0, 0, 2)) { ret 1; }
    var out2: of.ObjectImage;
    val pr2: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out2);
    if (sel pr2.ok) { ret 1; }
    if (!str_contains(fail.describe(pr2.err), "page21")) { ret 1; }
    ret 0;
}

fun ts_section_reloc_out_of_range() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 16; relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_secrelo");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    if (!t_make_section_based(buf.data, seg + SEGMENT_CMD_64_SIZE, 16, 7)) { ret 1; }

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.ok) { ret 1; }
    if (out.sections != nil || out.section_count != 0 || out.section_cap != 0
        || out.symbols != nil || out.symbol_count != 0 || out.symbol_cap != 0
        || out.relocations != nil || out.reloc_count != 0 || out.reloc_cap != 0
        || out.attributes != nil || out.attributes_len != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.parse_object:refuses_segment_section_headers_out_of_bounds" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_nsects_oob");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    bin.write_u32_le(buf.data, seg + 64, 0xFFFFFF);

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!sel pr.err)                                    { ret 1; }
    if (!str_contains(fail.describe(pr.err), "out of bounds")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.parse_object:section_reloc_x64" {
    if (ts_section_reloc_x64() != 0) { ret 1; }
    if (ts_section_signed_variants() != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.parse_object:section_reloc_arm64" {
    if (ts_section_reloc_arm64() != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.parse_object:section_reloc_out_of_range" {
    if (ts_section_reloc_out_of_range() != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho:write_sleb" {
    var buf: [4]u8;
    var cases: [9]i64;
    cases[0] = 0;    cases[1] = 1;    cases[2] = -1;
    cases[3] = 63;   cases[4] = 64;   cases[5] = -64;
    cases[6] = -65;  cases[7] = 128;  cases[8] = -128;
    var first: [9]u8;
    first[0] = 0x00; first[1] = 0x01; first[2] = 0x7F;
    first[3] = 0x3F; first[4] = 0xC0; first[5] = 0x40;
    first[6] = 0xBF; first[7] = 0x80; first[8] = 0x80;
    var second: [9]u8;
    second[0] = 0xFF; second[1] = 0xFF; second[2] = 0xFF;
    second[3] = 0xFF; second[4] = 0x00; second[5] = 0xFF;
    second[6] = 0x7F; second[7] = 0x01; second[8] = 0x7F;
    var sizes: [9]usize;
    sizes[0] = 1; sizes[1] = 1; sizes[2] = 1;
    sizes[3] = 1; sizes[4] = 2; sizes[5] = 1;
    sizes[6] = 2; sizes[7] = 2; sizes[8] = 2;

    var i: u32 = 0;
    for (i < 9) {
        var k: usize = 0;
        for (k < 4) { buf[k] = 0xEE; k = k + 1; }
        val end: usize = write_sleb(?buf[0], 0, cases[i]);
        if (end != sizes[i] || sleb_size(cases[i]) != sizes[i]) { ret 1; }
        if (buf[0] != first[i]) { ret 1; }
        if (sizes[i] == 2 && buf[1] != second[i]) { ret 1; }
        if (buf[end] != 0xEE) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.of.macho.write_bind_info:abs64_in_place_bind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val ln: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "/usr/lib/libobjc.A.dylib");
    val sn: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "__objc_empty_cache");
    val cn: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "_objc_msgSend");
    if (sel ln.err) { ret 1; }
    if (sel sn.err) { ret 1; }
    if (sel cn.err) { ret 1; }

    var libs: [1]of.DynLib;
    libs[0].name   = ln.ok;
    libs[0].soname = libs[0].name;
    libs[0].rpath  = intern.STR_NIL;

    var imports: [2]of.DynImport;
    imports[0].symbol = sn.ok;
    imports[0].lib_index = 0; imports[0].is_func = false;
    imports[0].ordinal = 0; imports[0].by_ordinal = false;
    imports[1].symbol = cn.ok;
    imports[1].lib_index = 0; imports[1].is_func = true;
    imports[1].ordinal = 0; imports[1].by_ordinal = false;

    var fixups: [2]of.ImportAddrFixup;
    fixups[0].seg_index = 2; fixups[0].seg_offset = 0x28;
    fixups[0].import_index = 0; fixups[0].patch_vaddr = 0;
    fixups[0].kind = of.RK_ABS64; fixups[0].addend = 0;
    fixups[1].seg_index = 2; fixups[1].seg_offset = 0x38;
    fixups[1].import_index = 0; fixups[1].patch_vaddr = 0;
    fixups[1].kind = of.RK_ABS64; fixups[1].addend = -8;

    var segs: [3]of.LoadSegment;
    segs[0].vaddr = 0x1000; segs[0].filesz = 0; segs[0].memsz = 0;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = nil;
    segs[1].vaddr = 0x2000; segs[1].filesz = 0; segs[1].memsz = 0;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = nil;
    segs[2].vaddr = 0x3000; segs[2].filesz = 0; segs[2].memsz = 0;
    segs[2].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE; segs[2].bytes = nil;

    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0];       dyn.lib_count = 1;
    dyn.imports = ?imports[0]; dyn.import_count = 2;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil::*of.BaseReloc; dyn.base_reloc_count = 0;
    dyn.pie = true;
    dyn.import_addr_fixups = ?fixups[0]; dyn.import_addr_fixup_count = 2;

    val want: usize = measure_bind_info(?itn, ?dyn, ?segs[0], 0x1000, 1);
    var buf: [128]u8;
    var k: usize = 0;
    for (k < 128) { buf[k] = 0xEE; k = k + 1; }
    val end: usize = write_bind_info(?buf[0], 0, ?itn, ?dyn, ?segs[0], 0x1000, 1, 4);
    if (end != want) { ret 1; }

    var p: usize = 0;
    if (buf[p] != (BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 3)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x28) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != (BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_ADDEND_SLIB_ULEB) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x78) { ret 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 3)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x38) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != (BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 4)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x00) { ret 1; }
    p = p + 1;
    if (buf[p] != BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != BIND_OPCODE_DONE) { ret 1; }
    p = p + 1;
    if (p != end) { ret 1; }
    ret 0;
}

fun t_emit_x64_object(alloc: *A.Allocator, i: *intern.Interner, out: *Vector[u8]) bool {
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[0] = 0xE8;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;
    secs[1].name = t_intern(i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name = t_intern(i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(i, "g"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name = t_intern(i, "ext_func"); syms[2].section = of.external_section();
    syms[2].offset = 0; syms[2].size = 0; syms[2].flags = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 1;  relocs[0].kind = of.RK_PLT32;
    relocs[0].sym = 2; relocs[0].addend = -4;
    relocs[1].section = of.section_id(0); relocs[1].offset = 8;  relocs[1].kind = of.RK_PC32;
    relocs[1].sym = 1; relocs[1].addend = -4;
    relocs[2].section = of.section_id(0); relocs[2].offset = 16; relocs[2].kind = of.RK_ABS64;
    relocs[2].sym = 1; relocs[2].addend = 0;

    var img: of.ObjectImage;
    img.alloc = alloc;
    img.interner = i;
    img.name = t_intern(i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 3;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[output.Output, str] = output.create(alloc, "macho_sub");
    if (R.is_err[output.Output, str](tf_r)) { ret false; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, tpath);

    if (sel rb.err) { ret false; }
    @out = rb.ok;
    ret true;
}

fun t_put_reloc(buf: *u8, reloff: usize, idx: u32, address: u32, symnum: u32,
                pcrel: u32, length: u32, extn: u32, r_type: u32) {
    val e: usize = reloff + idx::usize * RELOC_INFO_SIZE;
    bin.write_u32_le(buf, e, address);
    bin.write_u32_le(buf, e + 4, (symnum & 0xFFFFFF) | (pcrel << 24) | (length << 25)
                                  | (extn << 27) | (r_type << 28));
}

fun t_first_reloff(buf: *u8, out_n: *u32) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd: u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            if (nsects > 0) {
                val sh: usize = off + SEGMENT_CMD_64_SIZE;
                @out_n = bin.read_u32_le(buf, sh + 60);
                ret bin.read_u32_le(buf, sh + 56)::usize;
            }
        }
        off = off + cmdsize;
        c = c + 1;
    }
    @out_n = 0;
    ret 0;
}

test "mach.lang.target.of.macho:x64_subtractor_pair_folds_to_a_difference" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    var nreloc: u32 = 0;
    val reloff: usize = t_first_reloff(buf.data, ?nreloc);
    if (reloff == 0 || nreloc < 2) { ret 2; }

    t_put_reloc(buf.data, reloff, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(buf.data, reloff, 1, 16, 0, 0, 3, 1, X86_64_RELOC_UNSIGNED);
    var z: u32 = 2;
    for (z < nreloc) {
        t_put_reloc(buf.data, reloff, z, 0, 0, 0, 3, 1, X86_64_RELOC_UNSIGNED);
        z = z + 1;
    }

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 3; }

    var bad: i32 = 0;
    if (out.reloc_count != nreloc - 1 && bad == 0) { bad = 4; }

    var saw: bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.kind == of.RK_DIFF64) {
            saw = true;
            if (rr.offset != 16 && bad == 0) { bad = 5; }
            if (!of.is_difference(rr.kind) && bad == 0) { bad = 6; }
        }
        rj = rj + 1;
    }
    if (!saw && bad == 0) { bad = 7; }

    ret bad;
}

test "mach.lang.target.of.macho:a_malformed_subtractor_pair_is_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var bad: i32 = 0;

    var b1: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b1)) { ret 1; }
    var n1: u32 = 0;
    val o1: usize = t_first_reloff(b1.data, ?n1);
    if (o1 == 0 || n1 < 2) { ret 2; }
    t_put_reloc(b1.data, o1, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b1.data, o1, 1, 16, 0, 1, 2, 1, X86_64_RELOC_BRANCH);
    var out1: of.ObjectImage;
    val r_6627: err[fail.Fail] = parse_object(?alloc, ?i, b1.data, b1.len, ?out1);
    if (sel r_6627.ok && bad == 0) { bad = 3; }

    var b2: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b2)) { ret 4; }
    var n2: u32 = 0;
    val o2: usize = t_first_reloff(b2.data, ?n2);
    if (o2 == 0 || n2 < 2) { ret 5; }
    t_put_reloc(b2.data, o2, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b2.data, o2, 1, 8,  0, 0, 3, 1, X86_64_RELOC_UNSIGNED);
    var out2: of.ObjectImage;
    val r_6637: err[fail.Fail] = parse_object(?alloc, ?i, b2.data, b2.len, ?out2);
    if (sel r_6637.ok && bad == 0) { bad = 6; }

    var b3: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b3)) { ret 7; }
    var n3: u32 = 0;
    val o3: usize = t_first_reloff(b3.data, ?n3);
    if (o3 == 0 || n3 < 2) { ret 8; }
    t_put_reloc(b3.data, o3, 0, 16, 1, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b3.data, o3, 1, 16, 0, 0, 3, 1, X86_64_RELOC_SUBTRACTOR);
    var out3: of.ObjectImage;
    val r_6647: err[fail.Fail] = parse_object(?alloc, ?i, b3.data, b3.len, ?out3);
    if (sel r_6647.ok && bad == 0) { bad = 9; }

    ret bad;
}

fun t_symtab(buf: *u8, out_n: *u32) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd: u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SYMTAB) {
            @out_n = bin.read_u32_le(buf, off + 12);
            ret bin.read_u32_le(buf, off + 8)::usize;
        }
        off = off + cmdsize;
        c = c + 1;
    }
    @out_n = 0;
    ret 0;
}

test "mach.lang.target.of.macho:a_tentative_definition_reads_as_common" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    var nsyms: u32 = 0;
    val symoff: usize = t_symtab(buf.data, ?nsyms);
    if (symoff == 0 || nsyms == 0) { ret 2; }

    val so: usize = symoff + (nsyms - 1)::usize * NLIST_64_SIZE;
    buf.data[so + 4] = N_UNDF | N_EXT;
    buf.data[so + 5] = 0;
    bin.write_u16_le(buf.data, so + 6, (4 << 8)::u16);
    bin.write_u64_le(buf.data, so + 8, 40);

    var out: of.ObjectImage;
    val pr: err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 3; }

    var bad: i32 = 0;
    var saw: bool = false;
    var k: u32 = 0;
    for (k < out.symbol_count) {
        val sym: *of.Symbol = ?out.symbols[k];
        if ((sym.flags & of.SYM_OBJ_FLAG_COMMON) != 0) {
            saw = true;
            if (sym.size != 40                                    && bad == 0) { bad = 4; }
            if (sym.align != 16                                   && bad == 0) { bad = 5; }
            if ((sym.flags & of.SYM_OBJ_FLAG_EXTERN) == 0         && bad == 0) { bad = 6; }
            if (!of.section_is_external(sym.section)                && bad == 0) { bad = 7; }
        }
        k = k + 1;
    }
    if (!saw && bad == 0) { bad = 8; }

    var b2: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b2)) { ret 9; }
    var n2: u32 = 0;
    val s2: usize = t_symtab(b2.data, ?n2);
    if (s2 == 0 || n2 == 0) { ret 10; }
    var out2: of.ObjectImage;
    val r_6714: err[fail.Fail] = parse_object(?alloc, ?i, b2.data, b2.len, ?out2);
    if (sel r_6714.err) { ret 11; }
    var k2: u32 = 0;
    for (k2 < out2.symbol_count) {
        if ((out2.symbols[k2].flags & of.SYM_OBJ_FLAG_COMMON) != 0 && bad == 0) { bad = 12; }
        k2 = k2 + 1;
    }

    ret bad;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) res[*publication.Destination, fail.Fail] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(O.unwrap[txn.Error](initialized)))}; }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret res[*publication.Destination, fail.Fail].err{fail.message(R.unwrap_err[*publication.Destination, str](destination))}; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(O.unwrap[txn.Error](sealed)))}; }
    if (R.is_err[*publication.Destination, str](destination)) { ret res[*publication.Destination, fail.Fail].err{fail.message(R.unwrap_err[*publication.Destination, str](destination))}; }
    ret res[*publication.Destination, fail.Fail].ok{R.unwrap_ok[*publication.Destination, str](destination)};
}

fun t_publication_close(operation: *publication.Plan, result: err[fail.Fail]) err[fail.Fail] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (sel result.ok && O.is_some[txn.Error](closed)) {
        ret err[fail.Fail].err{fail.message(txn.error_message(O.unwrap[txn.Error](closed)))};
    }
    ret result;
}

fun t_planned_emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                  seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                  funcs: *of.ExecFunction, func_count: u32,
                  dyn: *of.DynamicInfo, fixups: *of.PltFixup, fixup_count: u32,
                  exceptions: *of.Section, exception_count: u32,
                  debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32,
                  path: *u8, name: *u8,
                  image_options: of.ImageOptions) err[fail.Fail] {
    if (path == nil) { ret emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: res[*publication.Destination, fail.Fail] = t_publication_open(?operation, alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, opened.ok, name, image_options));
}

fun t_planned_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
              seg_count: u32, page_size: u64, image_base: u64, entry: u64,
              funcs: *of.ExecFunction, func_count: u32,
              exceptions: *of.Section, exception_count: u32,
              debug: *of.Section, debug_count: u32,
              symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
              image_options: of.ImageOptions) err[fail.Fail] {
    if (path == nil) { ret emit_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: res[*publication.Destination, fail.Fail] = t_publication_open(?operation, alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, opened.ok, name, image_options));
}

fun t_planned_emit_object(isa_vt: *of.ObjectTarget, img: *of.ObjectImage, path: *u8) err[fail.Fail] {
    if (path == nil) { ret emit_object(isa_vt, img, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened: res[*publication.Destination, fail.Fail] = t_publication_open(?operation, img.alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_object(isa_vt, img, opened.ok));
}

test "mach.lang.target.of.macho:relocatable_preserves_native_sections_and_difference_pairs" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var data: [8]u8;
    var sections: [2]of.Section;
    sections[0] = of.Section{name: t_intern(?itn, "custom_a"), kind: of.SK_DATA, bytes: ?data[0], len: 8, align: 8};
    sections[1] = of.Section{name: t_intern(?itn, "custom_b"), kind: of.SK_DATA, align: 8};
    var i: u32 = 0;
    for (i < 2) {
        sections[i].native.format = of.OF_MACHO;
        sections[i].native.flags = S_ATTR_NO_DEAD_STRIP::u64;
        write_fixed16(?sections[i].native.name[0], 0, bin.resolve_name(?itn, sections[i].name));
        write_fixed16(?sections[i].native.segment[0], 0, "__CUSTOM");
        i = i + 1;
    }
    var symbols: [2]of.Symbol;
    symbols[0] = of.Symbol{name: t_intern(?itn, "_left"), section: of.section_id(0), size: 8, align: 8, flags: of.SYM_OBJ_FLAG_GLOBAL};
    symbols[1] = of.Symbol{name: t_intern(?itn, "_right"), section: of.section_id(1), align: 8, flags: of.SYM_OBJ_FLAG_GLOBAL};
    var relocation: of.Relocation = of.Relocation{section: of.section_id(0), kind: of.RK_DIFF64, sym: 0, sym2: 1, addend: -7};
    var image: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    image.sections = ?sections[0]; image.section_count = 2;
    image.symbols = ?symbols[0]; image.symbol_count = 2;
    image.relocations = ?relocation; image.reloc_count = 1;
    val created: R.Result[output.Output, str] = output.create(?alloc, "macho_relocatable");
    if (R.is_err[output.Output, str](created)) { ret 1; }
    var file: output.Output = R.unwrap_ok[output.Output, str](created);
    fin { output.dnit(?file); }
    var arch: u32 = 0;
    for (arch < 2) {
        var target: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
        if (arch == 1) { target = t_isa(isa.ARCH_AARCH64); }
        val emitted: err[fail.Fail] = t_planned_emit_object(?target, ?image, output.path(?file));
        if (sel emitted.err) { ret 2; }
        val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output.path(?file));
        if (sel read.err) { ret 3; }
        var bytes: Vector[u8] = read.ok;
        fin { if (bytes.data != nil) { A.deallocate[u8](?alloc, bytes.data, bytes.cap); } }
        val header: usize = MACH_HEADER_64_SIZE + SEGMENT_CMD_64_SIZE;
        if (!fixed16_equals(bytes.data, header, "custom_a") || !fixed16_equals(bytes.data, header + 16, "__CUSTOM")
            || !fixed16_equals(bytes.data, header + SECTION_64_SIZE, "custom_b")
            || bin.read_u32_le(bytes.data, header + 64)::u64 != sections[0].native.flags) { ret 4; }
        val relocoff: usize = bin.read_u32_le(bytes.data, header + 56)::usize;
        var subtractor: u32 = X86_64_RELOC_SUBTRACTOR;
        if (arch == 1) { subtractor = ARM64_RELOC_SUBTRACTOR; }
        if (bin.read_u32_le(bytes.data, header + 60) != 2
            || (bin.read_u32_le(bytes.data, relocoff + 4) >> 28) != subtractor
            || (bin.read_u32_le(bytes.data, relocoff + RELOC_INFO_SIZE + 4) >> 28) != 0) { ret 5; }
        var parsed: of.ObjectImage;
        val decoded: err[fail.Fail] = parse_object(?alloc, ?itn, bytes.data, bytes.len, ?parsed);
        if (sel decoded.err) { ret 6; }
        fin { of.object_image_dnit(?parsed); }
        if (parsed.section_count != 2 || parsed.sections[1].len != 0 || parsed.reloc_count != 1
            || parsed.relocations[0].kind != of.RK_DIFF64 || parsed.relocations[0].addend != -7
            || parsed.symbols[parsed.relocations[0].sym].name != symbols[0].name
            || parsed.symbols[parsed.relocations[0].sym2].name != symbols[1].name) { ret 7; }
        var evidence: str = "macho-difference-x64.o";
        if (arch == 1) { evidence = "macho-difference-arm64.o"; }
        if (R.is_err[R.Void, str](output.retain_bytes(?alloc, evidence, bytes.data, bytes.len))) { ret 10; }
        arch = arch + 1;
    }
    ret 0;
}

test "mach.lang.target.of.macho:relocatable_remaps_indirect_symbols_and_absolute_definitions" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var data: [16]u8;
    var stub: [6]u8;
    stub[0] = 0xFF; stub[1] = 0x25;
    var sections: [2]of.Section;
    sections[0] = of.Section{name: t_intern(?itn, "__pointers"), kind: of.SK_DATA, bytes: ?data[0], len: 16, align: 8};
    sections[1] = of.Section{name: t_intern(?itn, "__stubs"), kind: of.SK_TEXT, bytes: ?stub[0], len: 6, align: 1};
    var si: u32 = 0;
    for (si < 2) {
        sections[si].native.format = of.OF_MACHO;
        write_fixed16(?sections[si].native.name[0], 0, bin.resolve_name(?itn, sections[si].name));
        write_fixed16(?sections[si].native.segment[0], 0, "__CUSTOM");
        si = si + 1;
    }
    sections[0].native.flags = 6;
    sections[1].native.flags = 8; sections[1].native.reserved2 = 6;
    var symbols: [3]of.Symbol;
    symbols[0] = of.Symbol{name: t_intern(?itn, "_external"), section: of.external_section(), flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN};
    symbols[1] = of.Symbol{name: t_intern(?itn, "_absolute"), section: of.absolute_section(),
        absolute_value: 0xFEDCBA9876543210, flags: of.SYM_OBJ_FLAG_GLOBAL,
        native: of.NativeSymbol{format: of.OF_MACHO, kind: N_ABS::u32 | 0x10, flags: 0x20}};
    symbols[2] = of.Symbol{name: t_intern(?itn, "local_absolute"), section: of.absolute_section(), absolute_value: 17};
    var indirects: [3]of.NativeIndirect;
    indirects[0] = of.NativeIndirect{section: of.section_id(0), slot: 0, symbol: 0};
    indirects[1] = of.NativeIndirect{section: of.section_id(0), slot: 1, symbol: of.SYMBOL_NONE, flags: of.INDIRECT_LOCAL | of.INDIRECT_ABSOLUTE};
    indirects[2] = of.NativeIndirect{section: of.section_id(1), slot: 0, symbol: 0};
    var image: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    image.sections = ?sections[0]; image.section_count = 2;
    image.symbols = ?symbols[0]; image.symbol_count = 3;
    image.indirects = ?indirects[0]; image.indirect_count = 3;
    var target: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    val created: R.Result[output.Output, str] = output.create(?alloc, "macho_indirects");
    if (R.is_err[output.Output, str](created)) { ret 1; }
    var file: output.Output = R.unwrap_ok[output.Output, str](created);
    fin { output.dnit(?file); }
    val emitted: err[fail.Fail] = t_planned_emit_object(?target, ?image, output.path(?file));
    if (sel emitted.err) { ret 2; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, output.path(?file));
    if (sel read.err) { ret 3; }
    var bytes: Vector[u8] = read.ok;
    fin { if (bytes.data != nil) { A.deallocate[u8](?alloc, bytes.data, bytes.cap); } }
    val command: usize = t_find_lc(bytes.data, LC_DYSYMTAB);
    val table: usize = bin.read_u32_le(bytes.data, command + 56)::usize;
    if (bin.read_u32_le(bytes.data, command + 60) != 3 || bin.read_u32_le(bytes.data, table) != 2
        || bin.read_u32_le(bytes.data, table + 4) != (of.INDIRECT_LOCAL | of.INDIRECT_ABSOLUTE)
        || bin.read_u32_le(bytes.data, table + 8) != 2) { ret 4; }
    var parsed: of.ObjectImage;
    val decoded: err[fail.Fail] = parse_object(?alloc, ?itn, bytes.data, bytes.len, ?parsed);
    if (sel decoded.err) { ret 5; }
    fin { of.object_image_dnit(?parsed); }
    if (parsed.indirect_count != 3 || of.section_index(parsed.indirects[2].section) != 1 || parsed.indirects[2].slot != 0
        || parsed.symbols[parsed.indirects[0].symbol].name != symbols[0].name
        || !of.section_is_absolute(parsed.symbols[1].section) || parsed.symbols[1].absolute_value != symbols[1].absolute_value
        || parsed.symbols[1].native.kind != (N_ABS::u32 | N_EXT::u32 | 0x10)
        || parsed.symbols[1].native.flags != 0x20) { ret 6; }
    if (R.is_err[R.Void, str](output.retain_bytes(?alloc, "macho-indirect.o", bytes.data, bytes.len))) { ret 10; }
    indirects[1].slot = 0;
    val r_6907: err[fail.Fail] = validate_indirects(?image);
    if (sel r_6907.ok) { ret 7; }
    indirects[1].slot = 1;
    image.indirect_count = 2;
    val r_6910: err[fail.Fail] = validate_indirects(?image);
    if (sel r_6910.ok) { ret 8; }
    bin.write_u32_le(bytes.data, table, 3);
    var invalid: of.ObjectImage;
    val r_6913: err[fail.Fail] = parse_object(?alloc, ?itn, bytes.data, bytes.len, ?invalid);
    if (sel r_6913.ok) {
        of.object_image_dnit(?invalid); ret 9;
    }
    ret 0;
}

# refusal classes: the offending input is constructed and the typed error
# must leave the destination untouched

fun t_untouched(alloc: *A.Allocator, path: str) bool {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret false; }
    ret rb.ok.len == 0;
}

test "mach.lang.target.of.macho.emit_object:refuses_section_past_the_field_width" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var bytes: [16]u8;
    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?bytes[0]; secs[0].len = 0xFFFFFFF0; secs[0].align = 16; secs[0].flags = 0;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?bytes[0]; secs[1].len = 0x100; secs[1].align = 16; secs[1].flags = 0;
    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var img: of.ObjectImage;
    img.alloc = ?alloc; img.interner = ?i; img.name = t_intern(?i, "oversize");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_oversize");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.ok) { ret 2; }
    if (!str_contains(fail.describe(em.err), "field width")) { ret 3; }
    if (!t_untouched(?alloc, tpath)) { ret 4; }
    ret 0;
}

test "mach.lang.target.of.macho.emit_exec:refuses_a_misaligned_debug_placement" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var segs: [1]of.LoadSegment;
    val base: u64 = 0x100000000;
    segs[0].vaddr = base + 4096; segs[0].filesz = 8; segs[0].memsz = 8;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code[0];
    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name = t_intern(?itn, ".debug_info"); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?code[0]; dbg[0].len = 8; dbg[0].align = 6; dbg[0].flags = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "macho_misaligned");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                            4096, base, base + 4096,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            ?dbg[0], 1, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "misaligned"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.ok) { ret 2; }
    if (!str_contains(fail.describe(em.err), "not a power of two")) { ret 3; }
    if (!t_untouched(?alloc, tpath)) { ret 4; }
    ret 0;
}

test "mach.lang.target.of.macho.emit_object:allocation_refusal_at_every_ordinal_is_typed" {
    var backing: A.Allocator;
    page.make(?backing);
    var i: intern.Interner = intern.init(?backing);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text: [16]u8;
    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text[0]; secs[0].len = 16; secs[0].align = 16; secs[0].flags = 0;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?text[0]; secs[1].len = 8; secs[1].align = 8; secs[1].flags = 0;
    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "_gvar"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    val tf_r: R.Result[output.Output, str] = output.create(?backing, "macho_failat");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    var refused: u32 = 0;
    var ordinal: usize = 1;
    for (ordinal <= 24) {
        var failing: T.Testing;
        val r_7026: err[A.Error] = T.make(?failing);
        if (sel r_7026.err) { ret 2; }
        T.fail_at_ordinal(?failing, ordinal);
        var img: of.ObjectImage;
        img.alloc = T.allocator_of(?failing); img.interner = ?i; img.name = t_intern(?i, "failat");
        img.sections = ?secs[0]; img.section_count = 2;
        img.symbols = ?syms[0]; img.symbol_count = 2;
        img.relocations = ?relocs[0]; img.reloc_count = 1;
        val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
        if (T.leaked(?failing)) { ret 3; }
        if (sel em.err) {
            refused = refused + 1;
            if (!t_untouched(?backing, tpath)) { ret 5; }
        }
        ordinal = ordinal + 1;
    }
    if (refused < 6) { ret 6; }
    ret 0;
}
