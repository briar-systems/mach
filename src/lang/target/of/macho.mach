#[testing]
fun ts_exec_debug_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var k:    usize = 0;
    for (k < 8) {
        code[k] = 0x90;
        k       = k + 1;
    }
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 4096;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = base + 4096;
    segs[0].filesz = 8;
    segs[0].memsz  = 8;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE;
    info_bytes[1] = 0xAD;
    info_bytes[2] = 0xBE;
    info_bytes[3] = 0xEF;
    var line_bytes: [3]u8;
    line_bytes[0] = 0x11;
    line_bytes[1] = 0x22;
    line_bytes[2] = 0x33;

    val nm_info: res[intern.StrId, A.Error] = intern.intern(?itn, ".debug_info");
    val nm_line: res[intern.StrId, A.Error] = intern.intern(?itn, ".debug_line");
    if (sel nm_info.err) { ret 1; }
    if (sel nm_line.err) { ret 1; }
    val id_info: intern.StrId = nm_info.ok;
    val id_line: intern.StrId = nm_line.ok;

    var dbg: [2]of.Section;
    dbg[0].name  = id_info;
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0];
    dbg[0].len   = 4;
    dbg[0].align = 1;
    dbg[1].name  = id_line;
    dbg[1].kind  = of.SK_DEBUG;
    dbg[1].bytes = ?line_bytes[0];
    dbg[1].len   = 3;
    dbg[1].align = 1;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_dbg");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        4096, base, entry,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        ?dbg[0], 2, nil::*of.SymtabEntry, 0,
        tpath, "machodbg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (!format.t_bytes_contain(buf.data, 0, buf.len, "__debug_info")) { ret 1; }
    if (!format.t_bytes_contain(buf.data, 0, buf.len, "__debug_line")) { ret 1; }

    val dw: usize = t_find_seg(buf.data, "__DWARF");
    if (dw == 0)                                                                             { ret 1; }
    if (bin.read_u64_le(buf.data, dw + 32) != 0 || bin.read_u64_le(buf.data, dw + 48) == 0)  { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 56) != 0 || bin.read_u32_le(buf.data, dw + 60) != 0)  { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 68) != format.SG_NORELOC)                             { ret 1; }
    if ((bin.read_u64_le(buf.data, dw + 40) % format.macho_page_size(isa.ARCH_X86_64)) != 0) { ret 1; }

    var img: of.ObjectImage;
    val pr:  err[fail.Fail] = parse.parse_object(?alloc, ?itn, buf.data, buf.len, ?img);
    if (sel pr.err) { ret 1; }

    var found_info: bool = false;
    var found_line: bool = false;
    var bad:        bool = false;
    var si:         u32  = 0;
    for (si < img.section_count) {
        val sec: *of.Section = ?img.sections[si];
        if (sec.kind == of.SK_DEBUG && sec.name == id_info) {
            found_info = true;
            if (sec.len != 4 || sec.bytes == nil) { bad = true; }
            or {
                if (sec.bytes[0] != 0xDE || sec.bytes[1] != 0xAD
                    || sec.bytes[2] != 0xBE || sec.bytes[3] != 0xEF) { bad = true; }
            }
        }
        if (sec.kind == of.SK_DEBUG && sec.name == id_line) {
            found_line = true;
            if (sec.len != 3 || sec.bytes == nil) { bad = true; }
            or {
                if (sec.bytes[0] != 0x11 || sec.bytes[1] != 0x22 || sec.bytes[2] != 0x33) { bad = true; }
            }
        }
        si = si + 1;
    }

    if (bad)         { ret 1; }
    if (!found_info) { ret 1; }
    if (!found_line) { ret 1; }
    ret 0;
}

test emit_exec__debug_dwarf_roundtrip {
    if (ts_exec_debug_roundtrip() != 0) { ret 1; }
    ret 0;
}

test emit_exec__refuses_a_misaligned_debug_placement {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:    intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var segs: [1]of.LoadSegment;
    val base: u64 = 0x100000000;
    segs[0].vaddr  = base + 4096;
    segs[0].filesz = 8;
    segs[0].memsz  = 8;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];
    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name  = format.t_intern(?itn, ".debug_info");
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?code[0];
    dbg[0].len   = 8;
    dbg[0].align = 6;
    dbg[0].flags = 0;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_misaligned");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        4096, base, base + 4096,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        ?dbg[0], 1, nil::*of.SymtabEntry, 0,
        tpath, "misaligned"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.ok)                                                  { ret 2; }
    if (!str_contains(fail.describe(em.err), "not a power of two")) { ret 3; }
    if (!format.t_untouched(?alloc, tpath))                         { ret 4; }
    ret 0;
}
