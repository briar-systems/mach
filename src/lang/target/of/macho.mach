pub fun validate_indirects(img: *of.ObjectImage) err[fail.Fail] {
    var entry:   u32 = 0;
    var section: u32 = 0;
    for (section < img.section_count) {
        val planned: res[u32, fail.Fail] = indirect_slots(?img.sections[section]);
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        val count: u32 = planned.ok;
        if (count > img.indirect_count - entry) { ret err[fail.Fail].err{fail.message("macho: indirect section is missing symbol slots")}; }
        var slot: u32 = 0;
        for (slot < count) {
            if (of.section_index(img.indirects[entry].section) != section || img.indirects[entry].slot != slot) {
                ret err[fail.Fail].err{fail.message("macho: indirect slots must be complete and ordered by section")};
            }
            entry = entry + 1;
            slot  = slot + 1;
        }
        section = section + 1;
    }
    if (entry != img.indirect_count) { ret err[fail.Fail].err{fail.message("macho: indirect symbol has no native slot")}; }
    ret err[fail.Fail].ok{};
}

rec ObjectScratch {
    sec_addr:   *u64;
    data_off:   *usize;
    sec_to_out: *u32;
    out:        *MachoOutSec;
    reloc_rows: *u32;
    remap:      *u32;
    num_secs:   u32;
    num_out:    u32;
    num_syms:   u32;
}

fun object_scratch_free(alloc: *A.Allocator, s: *ObjectScratch) {
    if (s.sec_addr != nil)   { A.deallocate[u64](alloc, s.sec_addr, (s.num_secs + 1)::usize); }
    if (s.data_off != nil)   { A.deallocate[usize](alloc, s.data_off, (s.num_secs + 1)::usize); }
    if (s.sec_to_out != nil) { A.deallocate[u32](alloc, s.sec_to_out, (s.num_secs + 1)::usize); }
    if (s.out != nil)        { A.deallocate[MachoOutSec](alloc, s.out, s.num_out::usize); }
    if (s.reloc_rows != nil) { A.deallocate[u32](alloc, s.reloc_rows, (s.num_out + 1)::usize); }
    if (s.remap != nil)      { A.deallocate[u32](alloc, s.remap, s.num_syms::usize); }
    s.sec_addr   = nil;
    s.data_off   = nil;
    s.sec_to_out = nil;
    s.out        = nil;
    s.reloc_rows = nil;
    s.remap      = nil;
}

pub fun emit_object(isa_vt: *of.ObjectTarget, img: *of.ObjectImage, destination: str) err[fail.Fail] {
    if (isa_vt == nil || img == nil || destination == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil writer argument")};
    }
    if (img.import_count != 0) { ret err[fail.Fail].err{fail.message("macho: attributed imports are not representable in a Mach-O relocatable object")}; }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }

    val vrs: err[fail.Fail] = validate_reloc_symbols(img);
    if (sel vrs.err) { ret vrs; }
    val vrk: err[fail.Fail] = validate_reloc_kinds(img, arch_id);
    if (sel vrk.err) { ret vrk; }

    val alloc:        *A.Allocator   = img.alloc;
    val num_secs:     u32            = img.section_count;
    val num_syms:     u32            = img.symbol_count;
    val native_valid: err[fail.Fail] = of.validate_native_sections(img, of.OF_MACHO);
    if (sel native_valid.err) { ret native_valid; }
    val indirect_valid: err[fail.Fail] = validate_indirects(img);
    if (sel indirect_valid.err) { ret indirect_valid; }
    var common_i: u32 = 0;
    for (common_i < num_syms) {
        val symbol: *of.Symbol = ?img.symbols[common_i];
        if ((symbol.flags & of.SYM_OBJ_FLAG_COMMON) != 0
            && (symbol.size == 0 || symbol.align > 32768
            || (symbol.align != 0 && (symbol.align & (symbol.align - 1)) != 0))) {
            ret err[fail.Fail].err{fail.message("macho: common size or alignment is not natively representable")};
        }
        common_i = common_i + 1;
    }
    val planned_out: res[u32, fail.Fail] = generated_section_count(img);
    if (sel planned_out.err) { ret err[fail.Fail].err{planned_out.err}; }
    val num_out: u32 = planned_out.ok;
    var name_i:  u32 = 0;
    for (name_i < num_secs) {
        val section: *of.Section = ?img.sections[name_i];
        val named:   str         = bin.resolve_name(img.interner, section.name);
        if (section.native.format == 0 && section.kind != of.SK_DEBUG
            && named != nil && str_len(named) > 16) {
            ret err[fail.Fail].err{fail.message("macho: section name exceeds the native sixteen-byte field")};
        }
        name_i = name_i + 1;
    }
    if (num_out > 255 || num_syms > 0x1000000) {
        ret err[fail.Fail].err{fail.message("macho: section or relocation symbol ordinal exceeds its native width")};
    }

    val seg_cmd_size: usize = SEGMENT_CMD_64_SIZE + num_out::usize * SECTION_64_SIZE;
    val sizeofcmds:   usize = seg_cmd_size + SYMTAB_CMD_SIZE + DYSYMTAB_CMD_SIZE;
    val header_end:   usize = MACH_HEADER_64_SIZE + sizeofcmds;

    var scratch: ObjectScratch;
    scratch.sec_addr   = nil;
    scratch.data_off   = nil;
    scratch.sec_to_out = nil;
    scratch.out        = nil;
    scratch.reloc_rows = nil;
    scratch.remap      = nil;
    scratch.num_secs   = num_secs;
    scratch.num_out    = num_out;
    scratch.num_syms   = num_syms;
    fin { object_scratch_free(alloc, ?scratch); }

    val res_addr: res[*u64, A.Error] = A.zallocate[u64](alloc, (num_secs + 1)::usize);
    if (sel res_addr.err) { ret err[fail.Fail].err{fail.message("macho: section address table alloc failed")}; }
    scratch.sec_addr = res_addr.ok;
    val sec_addr: *u64 = scratch.sec_addr;

    val res_doff: res[*usize, A.Error] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (sel res_doff.err) { ret err[fail.Fail].err{fail.message("macho: section offset table alloc failed")}; }
    scratch.data_off = res_doff.ok;
    val data_off: *usize = scratch.data_off;

    val res_s2o: res[*u32, A.Error] = A.zallocate[u32](alloc, (num_secs + 1)::usize);
    if (sel res_s2o.err) { ret err[fail.Fail].err{fail.message("macho: section map alloc failed")}; }
    scratch.sec_to_out = res_s2o.ok;
    val sec_to_out: *u32 = scratch.sec_to_out;

    val res_out: res[*MachoOutSec, A.Error] = A.zallocate[MachoOutSec](alloc, num_out::usize);
    if (sel res_out.err) { ret err[fail.Fail].err{fail.message("macho: output section table alloc failed")}; }
    scratch.out = res_out.ok;
    val out: *MachoOutSec = scratch.out;

    val res_rrows: res[*u32, A.Error] = A.zallocate[u32](alloc, (num_out + 1)::usize);
    if (sel res_rrows.err) { ret err[fail.Fail].err{fail.message("macho: relocation row table alloc failed")}; }
    scratch.reloc_rows = res_rrows.ok;
    val reloc_rows: *u32 = scratch.reloc_rows;

    plan_generated_sections(img, out, sec_to_out);
    var indirect_base:    u32 = 0;
    var indirect_section: u32 = 0;
    for (indirect_section < num_out) {
        out[indirect_section].indirect_base = indirect_base;
        val indirect_base_r: res[u32, fail.Fail] = indirect_slots(?img.sections[out[indirect_section].srcsec]);
        if (sel indirect_base_r.err) { ret err[fail.Fail].err{indirect_base_r.err}; }
        indirect_base    = indirect_base + indirect_base_r.ok;
        indirect_section = indirect_section + 1;
    }

    # the segment's address space is planned like a file: one page-less plan
    # whose offsets are the section addresses
    val vp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, img.interner, "macho", plan.limit_64());
    if (sel vp_r.err) { ret err[fail.Fail].err{vp_r.err}; }
    var vp: plan.FilePlan = vp_r.ok;
    fin { plan.dnit(?vp); }

    var s:  u32 = 0;
    var ko: u32 = 0;
    for (ko < num_out) {
        var a_sec: u32 = 1;
        var sp:    u32 = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] == ko && img.sections[sp].align > a_sec) { a_sec = img.sections[sp].align; }
            sp = sp + 1;
        }
        out[ko].align = a_sec;
        val padded: err[fail.Fail] = plan.pad(?vp, "section address", a_sec::usize);
        if (sel padded.err) { ret padded; }
        out[ko].addr = plan.cursor(?vp)::u64;
        sp           = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] != ko) {
                sp = sp + 1;
                cnt;
            }
            var a: u32 = img.sections[sp].align;
            if (a < 1) { a = 1; }
            val row: res[u32, fail.Fail] = plan.place(?vp, "section address", of.section_id(sp), a::usize, img.sections[sp].len::usize);
            if (sel row.err) { ret err[fail.Fail].err{row.err}; }
            sec_addr[sp] = plan.offset(?vp, row.ok)::u64;
            sp           = sp + 1;
        }
        out[ko].size = plan.cursor(?vp)::u64 - out[ko].addr;
        ko           = ko + 1;
    }
    val seg_vm: res[usize, fail.Fail] = plan.seal(?vp);
    if (sel seg_vm.err) { ret err[fail.Fail].err{seg_vm.err}; }
    val seg_vmsize: u64 = seg_vm.ok::u64;

    val fp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, img.interner, "macho", plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: plan.FilePlan = fp_r.ok;
    fin { plan.dnit(?fp); }

    val header_r: res[u32, fail.Fail] = plan.place_at(?fp, "mach header and load commands", of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val seg_padded: err[fail.Fail] = plan.pad(?fp, "segment alignment", 8);
    if (sel seg_padded.err) { ret seg_padded; }
    val seg_fileoff: usize = plan.cursor(?fp);
    ko = 0;
    for (ko < num_out) {
        var sp: u32 = 0;
        if (out[ko].kind == of.SK_BSS) {
            out[ko].fileo = 0;
            for (sp < num_secs) {
                if (img.sections[sp].kind == of.SK_BSS) { data_off[sp] = 0; }
                sp = sp + 1;
            }
            ko = ko + 1;
            cnt;
        }
        val row: res[u32, fail.Fail] = plan.place(?fp, "section data", of.section_id(out[ko].srcsec), out[ko].align::usize, out[ko].size::usize);
        if (sel row.err) { ret err[fail.Fail].err{row.err}; }
        out[ko].fileo = plan.offset(?fp, row.ok);
        for (sp < num_secs) {
            if (sec_to_out[sp] != ko) {
                sp = sp + 1;
                cnt;
            }
            data_off[sp] = out[ko].fileo + (sec_addr[sp] - out[ko].addr)::usize;
            sp           = sp + 1;
        }
        ko = ko + 1;
    }
    val seg_filesize: usize = plan.cursor(?fp) - seg_fileoff;

    val reloc_padded: err[fail.Fail] = plan.pad(?fp, "relocation alignment", 4);
    if (sel reloc_padded.err) { ret reloc_padded; }
    ko = 0;
    for (ko < num_out) {
        var n:  u32 = 0;
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] == ko) {
                val entries: res[u32, fail.Fail] = reloc_entries_for_section(img, sp, arch_id);
                if (sel entries.err) { ret err[fail.Fail].err{entries.err}; }
                val grown: res[u32, fail.Fail] = plan.count_u32(?fp, "relocation entries", n, entries.ok);
                if (sel grown.err) { ret err[fail.Fail].err{grown.err}; }
                n = grown.ok;
            }
            sp = sp + 1;
        }
        out[ko].nrel   = n;
        reloc_rows[ko] = plan.NO_ROW;
        out[ko].reloff = 0;
        if (n > 0) {
            val bytes: res[usize, fail.Fail] = plan.table(?fp, "relocations", n::usize, RELOC_INFO_SIZE);
            if (sel bytes.err) { ret err[fail.Fail].err{bytes.err}; }
            val row: res[u32, fail.Fail] = plan.place(?fp, "relocations", of.section_id(out[ko].srcsec), 4, bytes.ok);
            if (sel row.err) { ret err[fail.Fail].err{row.err}; }
            reloc_rows[ko] = row.ok;
            out[ko].reloff = plan.offset(?fp, reloc_rows[ko]);
        }
        ko = ko + 1;
    }

    val indirect_bytes: res[usize, fail.Fail] = plan.table(?fp, "indirect symbols", img.indirect_count::usize, 4);
    if (sel indirect_bytes.err) { ret err[fail.Fail].err{indirect_bytes.err}; }
    val indirect_r: res[u32, fail.Fail] = plan.place(?fp, "indirect symbols", of.no_section(), 4, indirect_bytes.ok);
    if (sel indirect_r.err) { ret err[fail.Fail].err{indirect_r.err}; }
    val indirect_off: usize                 = plan.offset(?fp, indirect_r.ok);
    val symtab_bytes: res[usize, fail.Fail] = plan.table(?fp, "symbol table", num_syms::usize, NLIST_64_SIZE);
    if (sel symtab_bytes.err) { ret err[fail.Fail].err{symtab_bytes.err}; }
    val symtab_r: res[u32, fail.Fail] = plan.place(?fp, "symbol table", of.no_section(), 8, symtab_bytes.ok);
    if (sel symtab_r.err) { ret err[fail.Fail].err{symtab_r.err}; }
    val symtab_row: u32                 = symtab_r.ok;
    val symtab_off: usize               = plan.offset(?fp, symtab_row);
    val strtab_r:   res[u32, fail.Fail] = plan.place(?fp, "string table", of.no_section(), 1, strtab_size(img));
    if (sel strtab_r.err) { ret err[fail.Fail].err{strtab_r.err}; }
    val strtab_row: u32   = strtab_r.ok;
    val strtab_off: usize = plan.offset(?fp, strtab_row);
    val strtab_sz:  usize = plan.size(?fp, strtab_row);

    val sealed: res[usize, fail.Fail] = plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;

    if (num_syms > 0) {
        val res_remap: res[*u32, A.Error] = A.zallocate[u32](alloc, num_syms::usize);
        if (sel res_remap.err) { ret err[fail.Fail].err{fail.message("macho: symbol remap alloc failed")}; }
        scratch.remap = res_remap.ok;
    }
    val remap: *u32 = scratch.remap;

    val res_buf: res[*u8, A.Error] = A.zallocate[u8](alloc, total_size);
    if (sel res_buf.err) { ret err[fail.Fail].err{fail.message("macho: output buffer alloc failed")}; }
    var buf: *u8 = res_buf.ok;
    fin { A.deallocate[u8](alloc, buf, total_size); }

    val sizeofcmds_field: res[u32, fail.Fail] = plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    bin.write_u32_le(buf, 0, MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, MH_OBJECT);
    bin.write_u32_le(buf, 16, 3);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    bin.write_u32_le(buf, 24, 0);
    bin.write_u32_le(buf, 28, 0);

    var lc: usize = MACH_HEADER_64_SIZE;
    bin.write_u32_le(buf, lc, LC_SEGMENT_64);
    bin.write_u32_le(buf, lc + 4, seg_cmd_size::u32);
    write_fixed16(buf, lc + 8, nil);
    bin.write_u64_le(buf, lc + 24, 0);
    bin.write_u64_le(buf, lc + 32, seg_vmsize);
    bin.write_u64_le(buf, lc + 40, seg_fileoff::u64);
    bin.write_u64_le(buf, lc + 48, seg_filesize::u64);
    bin.write_u32_le(buf, lc + 56, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE);
    bin.write_u32_le(buf, lc + 60, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE);
    bin.write_u32_le(buf, lc + 64, num_out);
    bin.write_u32_le(buf, lc + 68, 0);

    var sh: usize = lc + SEGMENT_CMD_64_SIZE;
    ko = 0;
    for (ko < num_out) {
        val section:   *of.Section            = ?img.sections[out[ko].srcsec];
        val placement: opt[*MachoSectionDesc] = macho_section(section.kind);
        val canon:     opt[str]               = of.canonical_section_name(section.kind);
        if (sel placement.none) { ret err[fail.Fail].err{fail.message(of.section_kind_rejection(img.interner, img.alloc, section.kind))}; }
        if (sel canon.none)     { ret err[fail.Fail].err{fail.message(of.section_kind_rejection(img.interner, img.alloc, section.kind))}; }
        val native: *MachoSectionDesc = placement.some;
        if (section.native.format == of.OF_MACHO) {
            memory.raw_copy((buf::usize + sh)::ptr, (?section.native.name[0])::ptr, 16);
            memory.raw_copy((buf::usize + sh + 16)::ptr, (?section.native.segment[0])::ptr, 16);
        }
        or {
            val named: str = bin.resolve_name(img.interner, section.name);
            if (section.kind == of.SK_DEBUG)   { write_dwarf_sectname(buf, sh, named); }
            or (str_equals(named, canon.some)) { write_fixed16(buf, sh, native.sectname); }
            or                                 { write_fixed16(buf, sh, named); }
            write_fixed16(buf, sh + 16, native.segname);
        }
        bin.write_u64_le(buf, sh + 32, out[ko].addr);
        bin.write_u64_le(buf, sh + 40, out[ko].size);
        var foff: u32 = 0;
        if (out[ko].kind != of.SK_BSS) {
            val foff_field: res[u32, fail.Fail] = plan.field_u32(?fp, out[ko].fileo, "section offset");
            if (sel foff_field.err) { ret err[fail.Fail].err{foff_field.err}; }
            foff = foff_field.ok;
        }
        bin.write_u32_le(buf, sh + 48, foff);
        bin.write_u32_le(buf, sh + 52, align_log2(out[ko].align));
        val reloff_field: res[u32, fail.Fail] = plan.field_u32(?fp, out[ko].reloff, "relocation offset");
        if (sel reloff_field.err) { ret err[fail.Fail].err{reloff_field.err}; }
        bin.write_u32_le(buf, sh + 56, reloff_field.ok);
        bin.write_u32_le(buf, sh + 60, out[ko].nrel);
        var flags: u32 = native.flags;
        if ((section.flags & of.SEC_FLAG_INIT_FUNCS) != 0) {
            flags = (flags & ~SECTION_TYPE) | S_MOD_INIT_FUNC_POINTERS;
        }
        if (section.native.format == of.OF_MACHO) { flags = section.native.flags::u32; }
        bin.write_u32_le(buf, sh + 64, flags);
        var reserved1: u32                 = section.native.reserved1;
        val r_1061:    res[u32, fail.Fail] = indirect_slots(section);
        if (sel r_1061.err) { ret err[fail.Fail].err{r_1061.err}; }
        if (r_1061.ok != 0) { reserved1 = out[ko].indirect_base; }
        bin.write_u32_le(buf, sh + 68, reserved1);
        bin.write_u32_le(buf, sh + 72, section.native.reserved2);
        bin.write_u32_le(buf, sh + 76, section.native.reserved3);
        sh = sh + SECTION_64_SIZE;
        ko = ko + 1;
    }
    if (sh != lc + seg_cmd_size) { ret err[fail.Fail].err{fail.message("macho: section commands drifted from their plan")}; }

    var n_local:  u32 = 0;
    var n_extdef: u32 = 0;
    var n_undef:  u32 = 0;
    var symi:     u32 = 0;
    for (symi < num_syms) {
        if (is_local_sym(?img.symbols[symi]))  { n_local = n_local + 1; }
        or (is_extdef_sym(?img.symbols[symi])) { n_extdef = n_extdef + 1; }
        or                                     { n_undef = n_undef + 1; }
        symi = symi + 1;
    }

    val symtab_field: res[u32, fail.Fail] = plan.field_u32(?fp, symtab_off, "symbol table offset");
    if (sel symtab_field.err) { ret err[fail.Fail].err{symtab_field.err}; }
    val strtab_field: res[u32, fail.Fail] = plan.field_u32(?fp, strtab_off, "string table offset");
    if (sel strtab_field.err) { ret err[fail.Fail].err{strtab_field.err}; }
    val strsize_field: res[u32, fail.Fail] = plan.field_u32(?fp, strtab_sz, "string table size");
    if (sel strsize_field.err) { ret err[fail.Fail].err{strsize_field.err}; }
    val indirect_field: res[u32, fail.Fail] = plan.field_u32(?fp, indirect_off, "indirect table offset");
    if (sel indirect_field.err) { ret err[fail.Fail].err{indirect_field.err}; }

    val symtab_lc: usize = sh;
    bin.write_u32_le(buf, symtab_lc, LC_SYMTAB);
    bin.write_u32_le(buf, symtab_lc + 4, SYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, symtab_lc + 8, symtab_field.ok);
    bin.write_u32_le(buf, symtab_lc + 12, num_syms);
    bin.write_u32_le(buf, symtab_lc + 16, strtab_field.ok);
    bin.write_u32_le(buf, symtab_lc + 20, strsize_field.ok);

    val dysym_lc: usize = symtab_lc + SYMTAB_CMD_SIZE;
    bin.write_u32_le(buf, dysym_lc, LC_DYSYMTAB);
    bin.write_u32_le(buf, dysym_lc + 4, DYSYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, dysym_lc + 8, 0);
    bin.write_u32_le(buf, dysym_lc + 12, n_local);
    bin.write_u32_le(buf, dysym_lc + 16, n_local);
    bin.write_u32_le(buf, dysym_lc + 20, n_extdef);
    bin.write_u32_le(buf, dysym_lc + 24, n_local + n_extdef);
    bin.write_u32_le(buf, dysym_lc + 28, n_undef);
    if (img.indirect_count != 0) { bin.write_u32_le(buf, dysym_lc + 56, indirect_field.ok); }
    bin.write_u32_le(buf, dysym_lc + 60, img.indirect_count);
    if (dysym_lc + DYSYMTAB_CMD_SIZE != header_end) { ret err[fail.Fail].err{fail.message("macho: load commands drifted from their plan")}; }

    s = 0;
    for (s < num_secs) {
        if (img.sections[s].kind != of.SK_BSS && img.sections[s].bytes != nil && img.sections[s].len > 0) {
            memory.raw_copy((buf::usize + data_off[s])::ptr, img.sections[s].bytes::ptr, img.sections[s].len::usize);
        }
        s = s + 1;
    }

    var fi: u32 = 0;
    for (fi < img.reloc_count) {
        val rsec: u32 = of.section_index(img.relocations[fi].section);
        if (rsec < num_secs && img.sections[rsec].kind != of.SK_BSS) {
            val field: usize = data_off[rsec] + img.relocations[fi].offset::usize;
            fold_inplace_addend(buf, field, arch_id, img.relocations[fi].kind, img.relocations[fi].addend);
        }
        fi = fi + 1;
    }

    var sym_off: usize = symtab_off;
    var str_pos: usize = 1;
    buf[strtab_off] = 0;
    var nlist_idx: u32 = 0;
    symi = 0;
    for (symi < num_syms) {
        if (!is_local_sym(?img.symbols[symi])) {
            symi = symi + 1;
            cnt;
        }
        if (remap != nil) { remap[symi] = nlist_idx; }
        write_nlist(buf, sym_off, strtab_off, ?str_pos, img, symi, sec_addr, sec_to_out);
        sym_off   = sym_off + NLIST_64_SIZE;
        nlist_idx = nlist_idx + 1;
        symi      = symi + 1;
    }
    symi = 0;
    for (symi < num_syms) {
        if (!is_extdef_sym(?img.symbols[symi])) {
            symi = symi + 1;
            cnt;
        }
        if (remap != nil) { remap[symi] = nlist_idx; }
        write_nlist(buf, sym_off, strtab_off, ?str_pos, img, symi, sec_addr, sec_to_out);
        sym_off   = sym_off + NLIST_64_SIZE;
        nlist_idx = nlist_idx + 1;
        symi      = symi + 1;
    }
    symi = 0;
    for (symi < num_syms) {
        if (!of.section_is_external(img.symbols[symi].section)) {
            symi = symi + 1;
            cnt;
        }
        if (remap != nil) { remap[symi] = nlist_idx; }
        write_nlist(buf, sym_off, strtab_off, ?str_pos, img, symi, sec_addr, sec_to_out);
        sym_off   = sym_off + NLIST_64_SIZE;
        nlist_idx = nlist_idx + 1;
        symi      = symi + 1;
    }
    val symtab_closed: err[fail.Fail] = plan.close(?fp, symtab_row, sym_off);
    if (sel symtab_closed.err) { ret symtab_closed; }
    val strtab_closed: err[fail.Fail] = plan.close_size(?fp, strtab_row, str_pos);
    if (sel strtab_closed.err) { ret strtab_closed; }

    var indirect_i: u32 = 0;
    for (indirect_i < img.indirect_count) {
        val entry: *of.NativeIndirect = ?img.indirects[indirect_i];
        var value: u32                = entry.flags;
        if (value == 0) { value = remap[entry.symbol]; }
        val index: u32 = out[sec_to_out[of.section_index(entry.section)]].indirect_base + entry.slot;
        if (index >= img.indirect_count) { ret err[fail.Fail].err{fail.message("macho: indirect slot lies outside the indirect table")}; }
        bin.write_u32_le(buf, indirect_off + index::usize * 4, value);
        indirect_i = indirect_i + 1;
    }

    ko = 0;
    for (ko < num_out) {
        if (reloc_rows[ko] == plan.NO_ROW) {
            ko = ko + 1;
            cnt;
        }
        var ro: usize = out[ko].reloff;
        var sp: u32   = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] != ko) {
                sp = sp + 1;
                cnt;
            }
            val base_field: res[u32, fail.Fail] = plan.field_u64_u32(?fp, sec_addr[sp] - out[ko].addr, "relocation address base");
            if (sel base_field.err) { ret err[fail.Fail].err{base_field.err}; }
            val base: u32 = base_field.ok;
            var ri:   u32 = 0;
            for (ri < img.reloc_count) {
                if (of.section_index(img.relocations[ri].section) == sp) {
                    val radr_r: res[u32, fail.Fail] = plan.count_u32(?fp, "relocation address", base, img.relocations[ri].offset);
                    if (sel radr_r.err) { ret err[fail.Fail].err{radr_r.err}; }
                    val radr:  u32                 = radr_r.ok;
                    val rsi_r: res[u32, fail.Fail] = reloc_sym_index(img, ?img.relocations[ri]);
                    if (sel rsi_r.err) { ret err[fail.Fail].err{rsi_r.err}; }
                    val rsi:         u32          = rsi_r.ok;
                    val symnum:      u32          = remap[rsi];
                    var output_kind: of.RelocKind = img.relocations[ri].kind;
                    if (of.is_difference(output_kind)) {
                        var subtractor: u32 = X86_64_RELOC_SUBTRACTOR;
                        if (arch_is_arm64(arch_id)) { subtractor = ARM64_RELOC_SUBTRACTOR; }
                        var width: u32 = 2;
                        if (output_kind == of.RK_DIFF64) {
                            width       = 3;
                            output_kind = of.RK_ABS64;
                        }
                        or { output_kind = of.RK_ABS32; }
                        write_reloc_info(buf, ro, radr, remap[img.relocations[ri].sym2], 0, width, 1, subtractor);
                        ro = ro + RELOC_INFO_SIZE;
                    }
                    val mr_r: res[MachoReloc, fail.Fail] = macho_reloc_for(img.interner, alloc, arch_id, output_kind);
                    if (sel mr_r.err) { ret err[fail.Fail].err{mr_r.err}; }
                    val mr: MachoReloc = mr_r.ok;
                    if (needs_addend_entry(arch_id, ?mr, img.relocations[ri].addend)) {
                        val addend: i64 = img.relocations[ri].addend;
                        if (addend > 0x7FFFFF || addend < -0x800000) {
                            ret err[fail.Fail].err{fail.message("macho: ARM64 relocation addend exceeds the 24-bit addend entry")};
                        }
                        write_reloc_info(buf, ro, radr, (addend::u64)::u32 & 0xFFFFFF,
                            0, 2, 0, ARM64_RELOC_ADDEND);
                        ro = ro + RELOC_INFO_SIZE;
                    }
                    write_reloc_info(buf, ro, radr, symnum, mr.pcrel, mr.length, 1, mr.r_type);
                    ro = ro + RELOC_INFO_SIZE;
                }
                ri = ri + 1;
            }
            sp = sp + 1;
        }
        val relocs_closed: err[fail.Fail] = plan.close(?fp, reloc_rows[ko], ro);
        if (sel relocs_closed.err) { ret relocs_closed; }
        ko = ko + 1;
    }

    ret write_file(img.interner, alloc, destination, buf, total_size, "macho: object");
}

pub fun write_file(itn: *intern.Interner, alloc: *A.Allocator, destination: str, buf: *u8, len: usize, label: str) err[fail.Fail] {
    val r_1230: err[outcome.Fail] = output.bytes(itn, alloc, destination, buf, len, 0o755, false, label, "macho: could not publish output file");
    if (sel r_1230.err) { ret err[fail.Fail].err{fail.message(outcome.describe(r_1230.err))}; }
    ret err[fail.Fail].ok{};
}

pub fun register_macho(reg: *of.OfRegistry) err[fail.Fail] {
    var macho_vtable: of.OfVTable = of.linker_vtable(
        of.OF_MACHO, of.of_name_for(of.OF_MACHO), "o", emit_object, parse_object, emit_exec);
    of.with_dynamic_exec(?macho_vtable, emit_dyn_exec);

    macho_vtable.two_level_namespace = true;

    macho_vtable.default_debug               = "dwarf";
    macho_vtable.shared_input_ext            = ".dylib";
    macho_vtable.import_address_prefix       = "";
    macho_vtable.header_in_first_segment     = true;
    macho_vtable.carries_stack_size          = true;
    macho_vtable.default_stack_reserve       = 0;
    macho_vtable.header_span                 = header_span;
    macho_vtable.executable_section_location = nil;

    macho_vtable.covers_isa_any   = false;
    macho_vtable.covers_isa_count = 0;
    of.cover_isa(?macho_vtable, isa.ARCH_X86_64);
    of.cover_isa(?macho_vtable, isa.ARCH_AARCH64);

    ret of.register(reg, ?macho_vtable);
}

pub fun emit_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
    seg_count: u32, page_size: u64, image_base: u64, entry: u64,
    funcs: *of.ExecFunction, func_count: u32,
    exceptions: *of.Section, exception_count: u32,
    debug: *of.Section, debug_count: u32,
    symtab: *of.SymtabEntry, symtab_count: u32, destination: str, name: *u8,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (isa_vt == nil)      { ret err[fail.Fail].err{fail.message("macho: nil exec isa")}; }
    if (destination == nil) { ret err[fail.Fail].err{fail.message("macho: nil exec path")}; }
    val su: err[fail.Fail] = refuse_unixthread_stack(?image_options);
    if (sel su.err) { ret su; }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }
    val exec_page: u64 = macho_page_size(arch_id);

    val have_dwarf: bool = debug_count > 0;

    val has_pagezero: bool = image_base > 0;
    var ncmds:        u32  = frame_cmd_count(nil::*of.DynamicInfo, segs, seg_count, has_pagezero) + 4;
    if (have_dwarf) { ncmds = ncmds + 1; }

    var thread_state: usize = X86_THREAD_STATE64_COUNT::usize * 4;
    if (arch_is_arm64(arch_id)) { thread_state = ARM_THREAD_STATE64_COUNT::usize * 4; }
    val thread_cmd_size: usize = 16 + thread_state;

    var sizeofcmds: usize = frame_cmd_bytes(nil::*of.DynamicInfo, segs, seg_count, has_pagezero)
        + thread_cmd_size
        + SEGMENT_CMD_64_SIZE + UUID_CMD_SIZE + LINKEDIT_DATA_CMD_SIZE;
    sizeofcmds = sizeofcmds + macho_dwarf_cmd_bytes(debug_count);
    val header_end: usize = MACH_HEADER_64_SIZE + sizeofcmds;

    val hs: res[usize, fail.Fail] = reserved_header_span(segs, seg_count, image_base);
    if (sel hs.err) { ret err[fail.Fail].err{hs.err}; }
    val hdr_span: usize = hs.ok;
    if (header_end > hdr_span) {
        ret err[fail.Fail].err{fail.message("macho: exec header exceeds the linker's reservation")};
    }
    val text_va:       u64 = segs[0].vaddr - hdr_span::u64;
    val pagezero_size: u64 = text_va;

    val fp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "macho", plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: plan.FilePlan = fp_r.ok;
    fin { plan.dnit(?fp); }
    val header_r: res[u32, fail.Fail] = plan.place_at(?fp, "mach header and load commands", of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val header_row: u32 = header_r.ok;

    val sr: res[SegmentRows, fail.Fail] = place_segments(alloc, ?fp, segs, seg_count, hdr_span, exec_page::usize, false);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    var seg_rows: SegmentRows = sr.ok;
    fin { segment_rows_free(alloc, ?seg_rows, seg_count); }
    val seg_offsets: *usize = seg_rows.offsets;

    var hi_va: u64 = 0;
    var li:    u32 = 0;
    for (li < seg_count) {
        val rounded: res[u64, fail.Fail] = plan.align_address(?fp, "load segment", segs[li].memsz::u64, exec_page);
        if (sel rounded.err)                         { ret err[fail.Fail].err{rounded.err}; }
        if (rounded.ok > ~(0::u64) - segs[li].vaddr) { ret err[fail.Fail].err{fail.message("macho: load segment overflows the address space")}; }
        val end: u64 = segs[li].vaddr + rounded.ok;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }

    val dwp: res[MachoDwarf, fail.Fail] = macho_dwarf_plan(alloc, ?fp, debug, debug_count, macho_page_size(arch_id)::usize);
    if (sel dwp.err) { ret err[fail.Fail].err{dwp.err}; }
    var dw: MachoDwarf = dwp.ok;
    fin { macho_dwarf_free(alloc, ?dw, debug_count); }

    val exec_base:  u64 = 0;
    val exec_limit: u64 = hdr_span::u64 + segs[0].filesz::u64;

    val ident_len:       usize          = codesign_ident_len(name);
    val linkedit_padded: err[fail.Fail] = plan.pad(?fp, "__LINKEDIT", exec_page::usize);
    if (sel linkedit_padded.err) { ret linkedit_padded; }
    val linkedit_off: usize               = plan.cursor(?fp);
    val code_limit:   usize               = linkedit_off;
    val sig_size:     usize               = code_signature_size(ident_len, code_limit);
    val sig_r:        res[u32, fail.Fail] = plan.place(?fp, "code signature", of.no_section(), 1, sig_size);
    if (sel sig_r.err) { ret err[fail.Fail].err{sig_r.err}; }
    val linkedit_size: usize               = sig_size;
    val linkedit_va_r: res[u64, fail.Fail] = plan.align_address(?fp, "__LINKEDIT", hi_va, exec_page);
    if (sel linkedit_va_r.err) { ret err[fail.Fail].err{linkedit_va_r.err}; }
    val linkedit_va: u64                 = linkedit_va_r.ok;
    val linkedit_vm: res[u64, fail.Fail] = plan.align_address(?fp, "__LINKEDIT", linkedit_size::u64, exec_page);
    if (sel linkedit_vm.err) { ret err[fail.Fail].err{linkedit_vm.err}; }

    val sealed: res[usize, fail.Fail] = plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;

    val sizeofcmds_field: res[u32, fail.Fail] = plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    val code_limit_field: res[u32, fail.Fail] = plan.field_u32(?fp, code_limit, "code signature offset");
    if (sel code_limit_field.err) { ret err[fail.Fail].err{code_limit_field.err}; }
    val sig_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, sig_size, "code signature size");
    if (sel sig_size_field.err) { ret err[fail.Fail].err{sig_size_field.err}; }

    val res_buf: res[*u8, A.Error] = A.zallocate[u8](alloc, total_size);
    if (sel res_buf.err) { ret err[fail.Fail].err{fail.message("macho: exec buffer alloc failed")}; }
    var buf: *u8 = res_buf.ok;
    fin { A.deallocate[u8](alloc, buf, total_size); }

    bin.write_u32_le(buf, 0, MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    bin.write_u32_le(buf, 24, MH_NOUNDEFS);
    bin.write_u32_le(buf, 28, 0);

    val frame_r: res[usize, fail.Fail] = write_frame_cmds(buf, ?fp, MACH_HEADER_64_SIZE, itn, nil::*of.DynamicInfo, segs,
        seg_count, seg_offsets, pagezero_size, text_va,
        hdr_span, exec_page);
    if (sel frame_r.err) { ret err[fail.Fail].err{frame_r.err}; }
    var lc: usize = frame_r.ok;
    write_segment_bytes(buf, segs, seg_count, seg_offsets);

    val dwarf_r: res[usize, fail.Fail] = macho_dwarf_write(buf, itn, ?fp, debug, debug_count, lc, ?dw, 0);
    if (sel dwarf_r.err) { ret err[fail.Fail].err{dwarf_r.err}; }
    lc = dwarf_r.ok;
    macho_dwarf_write_bytes(buf, ?fp, debug, debug_count, ?dw);

    lc = write_segment_cmd(buf, lc, "__LINKEDIT", linkedit_va,
        linkedit_vm.ok,
        linkedit_off::u64, linkedit_size::u64,
        VM_PROT_READ, VM_PROT_READ, 0);

    val uuid_off: usize = write_uuid_cmd(buf, lc);
    lc = lc + UUID_CMD_SIZE;

    lc = write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);

    bin.write_u32_le(buf, lc, LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, code_limit_field.ok);
    bin.write_u32_le(buf, lc + 12, sig_size_field.ok);
    lc = lc + LINKEDIT_DATA_CMD_SIZE;
    val commands_closed: err[fail.Fail] = plan.close(?fp, header_row, lc);
    if (sel commands_closed.err) { ret commands_closed; }

    val identified: err[fail.Fail] = seal_build_id(buf, code_limit, uuid_off);
    if (sel identified.err) { ret identified; }

    val signed:     usize          = write_code_signature(buf, code_limit, name, code_limit, exec_base, exec_limit);
    val sig_closed: err[fail.Fail] = plan.close_size(?fp, sig_r.ok, signed);
    if (sel sig_closed.err) { ret sig_closed; }

    val r_1764: err[outcome.Fail] = output.bytes(itn, alloc, destination, buf, total_size, 0o755, false, "macho: exec", "macho: could not publish output file");
    if (sel r_1764.err) { ret err[fail.Fail].err{fail.message(outcome.describe(r_1764.err))}; }
    ret err[fail.Fail].ok{};
}

pub fun emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
    seg_count: u32, page_size: u64, image_base: u64, entry: u64,
    funcs: *of.ExecFunction, func_count: u32,
    dyn: *of.DynamicInfo, fixups: *of.PltFixup, fixup_count: u32,
    exceptions: *of.Section, exception_count: u32,
    debug: *of.Section, debug_count: u32,
    symtab: *of.SymtabEntry, symtab_count: u32,
    destination: str, name: *u8,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (isa_vt == nil)      { ret err[fail.Fail].err{fail.message("macho: nil dyn-exec isa")}; }
    if (destination == nil) { ret err[fail.Fail].err{fail.message("macho: nil dyn-exec path")}; }
    if (dyn == nil)         { ret err[fail.Fail].err{fail.message("macho: nil dynamic plan")}; }
    if (itn == nil)         { ret err[fail.Fail].err{fail.message("macho: no interner for dyn-exec")}; }
    if (seg_count == 0)     { ret err[fail.Fail].err{fail.message("macho: dyn-exec has no load segments")}; }
    if (segs == nil)        { ret err[fail.Fail].err{fail.message("macho: nil dyn-exec load segments")}; }
    if (dyn.import_count > 0 && dyn.imports == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil dynamic import array")};
    }
    if (dyn.import_addr_fixup_count > 0 && dyn.import_addr_fixups == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil import-address fixup array")};
    }
    if (dyn.base_reloc_count > 0 && dyn.base_relocs == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil base-relocation array")};
    }
    if (fixup_count > 0 && fixups == nil) {
        ret err[fail.Fail].err{fail.message("macho: nil call-site fixup array")};
    }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }

    val exec_page: u64   = macho_page_size(arch_id);
    val page:      usize = exec_page::usize;
    val nstub:     u32   = func_import_count(dyn);
    val ngot:      u32   = got_import_count(dyn);
    val stub_sz:   usize = macho_stub_size(arch_id);

    val pie: bool = dyn.pie;
    if (!pie) {
        val su: err[fail.Fail] = refuse_unixthread_stack(?image_options);
        if (sel su.err) { ret su; }
    }
    var bri: u32 = 0;
    for (bri < dyn.base_reloc_count) {
        if (dyn.base_relocs[bri].seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("macho: base relocation references an out-of-range segment")};
        }
        bri = bri + 1;
    }
    var fxi: u32 = 0;
    for (fxi < dyn.import_addr_fixup_count) {
        if (dyn.import_addr_fixups[fxi].seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("macho: import-address fixup references an out-of-range segment")};
        }
        if (dyn.import_addr_fixups[fxi].import_index >= dyn.import_count) {
            ret err[fail.Fail].err{fail.message("macho: import-address fixup references an out-of-range import")};
        }
        fxi = fxi + 1;
    }
    if (pie && dyn.base_reloc_count > 1) {
        sort.sort[of.BaseReloc](dyn.base_relocs, dyn.base_reloc_count::usize, base_reloc_cmp);
    }

    if (data_const_seg_count(dyn, segs, seg_count) > 1) {
        ret err[fail.Fail].err{fail.message(data_const_conflict_message(itn, alloc, dyn, segs, seg_count))};
    }

    val grp_count: u32 = seg_group_count(dyn, segs, seg_count);
    var seg_cmds:  u32 = frame_cmd_count(dyn, segs, seg_count, image_base > 0) + 1;
    if (nstub > 0) { seg_cmds = seg_cmds + 1; }
    if (ngot > 0)  { seg_cmds = seg_cmds + 1; }

    var thread_state: usize = X86_THREAD_STATE64_COUNT::usize * 4;
    if (arch_is_arm64(arch_id)) { thread_state = ARM_THREAD_STATE64_COUNT::usize * 4; }
    val thread_cmd_size: usize = 16 + thread_state;
    var entry_cmd_size:  usize = thread_cmd_size;
    if (pie) { entry_cmd_size = ENTRY_POINT_CMD_SIZE; }

    var sect_total: u32 = frame_sect_total(segs, seg_count);
    if (nstub > 0) { sect_total = sect_total + 1; }
    if (ngot > 0)  { sect_total = sect_total + 1; }

    var sizeofcmds: usize = seg_cmds::usize * SEGMENT_CMD_64_SIZE
        + sect_total::usize * SECTION_64_SIZE
        + DYLD_INFO_CMD_SIZE + SYMTAB_CMD_SIZE + DYSYMTAB_CMD_SIZE
        + dylinker_cmd_size() + entry_cmd_size + UUID_CMD_SIZE + LINKEDIT_DATA_CMD_SIZE;
    if (pie) { sizeofcmds = sizeofcmds + BUILD_VERSION_CMD_SIZE; }
    var di:          u32 = 0;
    var rpath_count: u32 = 0;
    for (di < dyn.lib_count) {
        sizeofcmds = sizeofcmds + dylib_cmd_size(bin.resolve_name(itn, dyn.libs[di].soname));
        if (dyn.libs[di].rpath != intern.STR_NIL
            && !rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            sizeofcmds = sizeofcmds
                + rpath_cmd_size(bin.resolve_name(itn, dyn.libs[di].rpath));
            rpath_count = rpath_count + 1;
        }
        di = di + 1;
    }

    var ncmds: u32 = seg_cmds + 7 + dyn.lib_count + rpath_count;
    if (pie) { ncmds = ncmds + 1; }

    val have_dwarf: bool = debug_count > 0;
    if (have_dwarf) {
        sizeofcmds = sizeofcmds + macho_dwarf_cmd_bytes(debug_count);
        ncmds      = ncmds + 1;
    }
    val header_end: usize = MACH_HEADER_64_SIZE + sizeofcmds;

    var lay: MachoDynLayout;
    val hs:  res[usize, fail.Fail] = reserved_header_span(segs, seg_count, image_base);
    if (sel hs.err) { ret err[fail.Fail].err{hs.err}; }
    lay.hdr_span = hs.ok;
    if (header_end > lay.hdr_span) {
        ret err[fail.Fail].err{fail.message("macho: dyn-exec header exceeds the linker's reservation")};
    }
    lay.text_va       = segs[0].vaddr - lay.hdr_span::u64;
    lay.pagezero_size = lay.text_va;

    val fp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "macho", plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: plan.FilePlan = fp_r.ok;
    fin { plan.dnit(?fp); }
    val header_r: res[u32, fail.Fail] = plan.place_at(?fp, "mach header and load commands", of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val header_row: u32 = header_r.ok;

    val sr: res[SegmentRows, fail.Fail] = place_segments(alloc, ?fp, segs, seg_count, lay.hdr_span, page, true);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    var seg_rows: SegmentRows = sr.ok;
    fin { segment_rows_free(alloc, ?seg_rows, seg_count); }
    val seg_offsets: *usize = seg_rows.offsets;

    # the mapped address space is its own plan: the segments end at hi_va,
    # then stubs, GOT and __LINKEDIT each take a page-aligned run
    var hi_va: u64 = 0;
    var li:    u32 = 0;
    for (li < seg_count) {
        if (segs[li].memsz::u64 > ~(0::u64) - segs[li].vaddr) { ret err[fail.Fail].err{fail.message("macho: load segment overflows the address space")}; }
        val end: u64 = segs[li].vaddr + segs[li].memsz::u64;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }
    val vp_r: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "macho", plan.limit_64());
    if (sel vp_r.err) { ret err[fail.Fail].err{vp_r.err}; }
    var vp: plan.FilePlan = vp_r.ok;
    fin { plan.dnit(?vp); }
    val mapped: err[fail.Fail] = plan.pad_to(?vp, "mapped segments", hi_va::usize);
    if (sel mapped.err) { ret mapped; }

    var pz: u32 = 0;
    if (lay.pagezero_size > 0) { pz = 1; }

    lay.stubs_size    = 0;
    lay.got_size      = 0;
    lay.got_seg_index = 0;
    if (nstub > 0) {
        val bytes: res[usize, fail.Fail] = plan.table(?fp, "__stubs", nstub::usize, stub_sz);
        if (sel bytes.err) { ret err[fail.Fail].err{bytes.err}; }
        lay.stubs_size = bytes.ok;
        val row: res[u32, fail.Fail] = plan.place(?fp, "__stubs", of.no_section(), page, lay.stubs_size);
        if (sel row.err) { ret err[fail.Fail].err{row.err}; }
        lay.stubs_off = plan.offset(?fp, row.ok);
        val vrow: res[u32, fail.Fail] = plan.place(?vp, "__STUBS", of.no_section(), page, lay.stubs_size);
        if (sel vrow.err) { ret err[fail.Fail].err{vrow.err}; }
        lay.stubs_va = plan.offset(?vp, vrow.ok)::u64;
    }
    if (ngot > 0) {
        val bytes: res[usize, fail.Fail] = plan.table(?fp, "__got", ngot::usize, 8);
        if (sel bytes.err) { ret err[fail.Fail].err{bytes.err}; }
        lay.got_size = bytes.ok;
        val row: res[u32, fail.Fail] = plan.place(?fp, "__got", of.no_section(), page, lay.got_size);
        if (sel row.err) { ret err[fail.Fail].err{row.err}; }
        lay.got_off = plan.offset(?fp, row.ok);
        val vrow: res[u32, fail.Fail] = plan.place(?vp, "__GOT", of.no_section(), page, lay.got_size);
        if (sel vrow.err) { ret err[fail.Fail].err{vrow.err}; }
        lay.got_va        = plan.offset(?vp, vrow.ok)::u64;
        lay.got_seg_index = pz + grp_count;
        if (nstub > 0) { lay.got_seg_index = lay.got_seg_index + 1; }
    }

    val dwp: res[MachoDwarf, fail.Fail] = macho_dwarf_plan(alloc, ?fp, debug, debug_count, page);
    if (sel dwp.err) { ret err[fail.Fail].err{dwp.err}; }
    var dw: MachoDwarf = dwp.ok;
    fin { macho_dwarf_free(alloc, ?dw, debug_count); }

    val linkedit_padded: err[fail.Fail] = plan.pad(?fp, "__LINKEDIT", page);
    if (sel linkedit_padded.err) { ret linkedit_padded; }
    lay.linkedit_off = plan.cursor(?fp);
    val linkedit_vrow: res[u32, fail.Fail] = plan.place(?vp, "__LINKEDIT", of.no_section(), page, 0);
    if (sel linkedit_vrow.err) { ret err[fail.Fail].err{linkedit_vrow.err}; }
    lay.linkedit_va = plan.offset(?vp, linkedit_vrow.ok)::u64;

    lay.rebase_size = measure_rebase_info(dyn, segs, lay.text_va, pz);
    val rebase_r: res[u32, fail.Fail] = plan.place(?fp, "rebase opcodes", of.no_section(), 1, lay.rebase_size);
    if (sel rebase_r.err) { ret err[fail.Fail].err{rebase_r.err}; }
    lay.rebase_off = plan.offset(?fp, rebase_r.ok);
    lay.bind_size  = measure_bind_info(itn, dyn, segs, lay.text_va, pz);
    val bind_r: res[u32, fail.Fail] = plan.place(?fp, "bind opcodes", of.no_section(), 1, lay.bind_size);
    if (sel bind_r.err) { ret err[fail.Fail].err{bind_r.err}; }
    lay.bind_off = plan.offset(?fp, bind_r.ok);
    val symtab_bytes: res[usize, fail.Fail] = plan.table(?fp, "symbol table", ngot::usize, NLIST_64_SIZE);
    if (sel symtab_bytes.err) { ret err[fail.Fail].err{symtab_bytes.err}; }
    val symtab_r: res[u32, fail.Fail] = plan.place(?fp, "symbol table", of.no_section(), 8, symtab_bytes.ok);
    if (sel symtab_r.err) { ret err[fail.Fail].err{symtab_r.err}; }
    lay.symtab_off = plan.offset(?fp, symtab_r.ok);

    lay.strtab_size = 1;
    var si: u32 = 0;
    for (si < dyn.import_count) {
        if (import_needs_got(dyn, si)) {
            val sname: str = bin.resolve_name(itn, dyn.imports[si].symbol);
            if (sname != nil) { lay.strtab_size = lay.strtab_size + str_len(sname) + 1; }
            or                { lay.strtab_size = lay.strtab_size + 1; }
        }
        si = si + 1;
    }
    val strtab_r: res[u32, fail.Fail] = plan.place(?fp, "string table", of.no_section(), 1, lay.strtab_size);
    if (sel strtab_r.err) { ret err[fail.Fail].err{strtab_r.err}; }
    lay.strtab_off = plan.offset(?fp, strtab_r.ok);

    val ident_len:  usize          = codesign_ident_len(name);
    val sig_padded: err[fail.Fail] = plan.pad(?fp, "code signature", CODE_SIG_ALIGN);
    if (sel sig_padded.err) { ret sig_padded; }
    val sig_off:  usize               = plan.cursor(?fp);
    val sig_size: usize               = code_signature_size(ident_len, sig_off);
    val sig_r:    res[u32, fail.Fail] = plan.place(?fp, "code signature", of.no_section(), 1, sig_size);
    if (sel sig_r.err) { ret err[fail.Fail].err{sig_r.err}; }
    val exec_limit: u64                   = lay.hdr_span::u64 + segs[0].filesz::u64;
    val sealed:     res[usize, fail.Fail] = plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;
    lay.linkedit_size = total_size - lay.linkedit_off;
    val linkedit_vm: res[u64, fail.Fail] = plan.align_address(?fp, "__LINKEDIT", lay.linkedit_size::u64, exec_page);
    if (sel linkedit_vm.err) { ret err[fail.Fail].err{linkedit_vm.err}; }

    val sizeofcmds_field: res[u32, fail.Fail] = plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    val stubs_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.stubs_off, "__stubs offset");
    if (sel stubs_field.err) { ret err[fail.Fail].err{stubs_field.err}; }
    val got_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.got_off, "__got offset");
    if (sel got_field.err) { ret err[fail.Fail].err{got_field.err}; }
    val rebase_off_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.rebase_off, "rebase offset");
    if (sel rebase_off_field.err) { ret err[fail.Fail].err{rebase_off_field.err}; }
    val rebase_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.rebase_size, "rebase size");
    if (sel rebase_size_field.err) { ret err[fail.Fail].err{rebase_size_field.err}; }
    val bind_off_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.bind_off, "bind offset");
    if (sel bind_off_field.err) { ret err[fail.Fail].err{bind_off_field.err}; }
    val bind_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.bind_size, "bind size");
    if (sel bind_size_field.err) { ret err[fail.Fail].err{bind_size_field.err}; }
    val symtab_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.symtab_off, "symbol table offset");
    if (sel symtab_field.err) { ret err[fail.Fail].err{symtab_field.err}; }
    val strtab_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.strtab_off, "string table offset");
    if (sel strtab_field.err) { ret err[fail.Fail].err{strtab_field.err}; }
    val strsize_field: res[u32, fail.Fail] = plan.field_u32(?fp, lay.strtab_size, "string table size");
    if (sel strsize_field.err) { ret err[fail.Fail].err{strsize_field.err}; }
    val sig_off_field: res[u32, fail.Fail] = plan.field_u32(?fp, sig_off, "code signature offset");
    if (sel sig_off_field.err) { ret err[fail.Fail].err{sig_off_field.err}; }
    val sig_size_field: res[u32, fail.Fail] = plan.field_u32(?fp, sig_size, "code signature size");
    if (sel sig_size_field.err) { ret err[fail.Fail].err{sig_size_field.err}; }
    var ordinal_i: u32 = 0;
    for (ordinal_i < dyn.import_count) {
        if (import_needs_got(dyn, ordinal_i) && dylib_ordinal_for(dyn, ordinal_i) > 0xFF) {
            ret err[fail.Fail].err{fail.message("macho: dynamic library ordinal exceeds the eight-bit n_desc field")};
        }
        ordinal_i = ordinal_i + 1;
    }
    if (lay.got_seg_index > 0xF) {
        ret err[fail.Fail].err{fail.message("macho: __GOT segment ordinal exceeds the four-bit bind opcode field")};
    }

    val res_buf: res[*u8, A.Error] = A.zallocate[u8](alloc, total_size);
    if (sel res_buf.err) { ret err[fail.Fail].err{fail.message("macho: dyn-exec buffer alloc failed")}; }
    var buf: *u8 = res_buf.ok;
    fin { A.deallocate[u8](alloc, buf, total_size); }

    bin.write_u32_le(buf, 0, MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    var hdr_flags: u32 = MH_DYLDLINK | MH_TWOLEVEL;
    if (pie) { hdr_flags = hdr_flags | MH_PIE; }
    bin.write_u32_le(buf, 24, hdr_flags);
    bin.write_u32_le(buf, 28, 0);

    val frame_r: res[usize, fail.Fail] = write_frame_cmds(buf, ?fp, MACH_HEADER_64_SIZE, itn, dyn, segs, seg_count,
        seg_offsets, lay.pagezero_size, lay.text_va,
        lay.hdr_span, exec_page);
    if (sel frame_r.err) { ret err[fail.Fail].err{frame_r.err}; }
    var lc: usize = frame_r.ok;

    if (nstub > 0) {
        val stubs_vm: res[u64, fail.Fail] = plan.align_address(?fp, "__STUBS", lay.stubs_size::u64, exec_page);
        if (sel stubs_vm.err) { ret err[fail.Fail].err{stubs_vm.err}; }
        var sec: usize = write_segment_cmd(buf, lc, "__STUBS", lay.stubs_va,
            stubs_vm.ok,
            lay.stubs_off::u64, lay.stubs_size::u64,
            VM_PROT_READ | VM_PROT_EXECUTE, VM_PROT_READ | VM_PROT_EXECUTE, 1);
        write_section_64(buf, sec, "__stubs", "__STUBS", lay.stubs_va, lay.stubs_size::u64,
            stubs_field.ok, 4,
            S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS);
        lc = sec + SECTION_64_SIZE;
    }
    if (ngot > 0) {
        val got_vm: res[u64, fail.Fail] = plan.align_address(?fp, "__GOT", lay.got_size::u64, exec_page);
        if (sel got_vm.err) { ret err[fail.Fail].err{got_vm.err}; }
        var gsec: usize = write_segment_cmd(buf, lc, "__GOT", lay.got_va,
            got_vm.ok,
            lay.got_off::u64, lay.got_size::u64,
            VM_PROT_READ | VM_PROT_WRITE, VM_PROT_READ | VM_PROT_WRITE, 1);
        write_section_64(buf, gsec, "__got", "__GOT", lay.got_va, lay.got_size::u64,
            got_field.ok, 8, 0);
        lc = gsec + SECTION_64_SIZE;
    }

    val dwarf_r: res[usize, fail.Fail] = macho_dwarf_write(buf, itn, ?fp, debug, debug_count, lc, ?dw, 0);
    if (sel dwarf_r.err) { ret err[fail.Fail].err{dwarf_r.err}; }
    lc = dwarf_r.ok;
    macho_dwarf_write_bytes(buf, ?fp, debug, debug_count, ?dw);

    lc = write_segment_cmd(buf, lc, "__LINKEDIT", lay.linkedit_va,
        linkedit_vm.ok,
        lay.linkedit_off::u64, lay.linkedit_size::u64,
        VM_PROT_READ, VM_PROT_READ, 0);

    var rebase_cmd_off:  u32 = 0;
    var rebase_cmd_size: u32 = 0;
    if (lay.rebase_size > 0) {
        rebase_cmd_off  = rebase_off_field.ok;
        rebase_cmd_size = rebase_size_field.ok;
    }
    bin.write_u32_le(buf, lc, LC_DYLD_INFO_ONLY);
    bin.write_u32_le(buf, lc + 4, DYLD_INFO_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, rebase_cmd_off);
    bin.write_u32_le(buf, lc + 12, rebase_cmd_size);
    bin.write_u32_le(buf, lc + 16, bind_off_field.ok);
    bin.write_u32_le(buf, lc + 20, bind_size_field.ok);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, 0);
    bin.write_u32_le(buf, lc + 32, 0);
    bin.write_u32_le(buf, lc + 36, 0);
    bin.write_u32_le(buf, lc + 40, 0);
    bin.write_u32_le(buf, lc + 44, 0);
    lc = lc + DYLD_INFO_CMD_SIZE;

    bin.write_u32_le(buf, lc, LC_SYMTAB);
    bin.write_u32_le(buf, lc + 4, SYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, symtab_field.ok);
    bin.write_u32_le(buf, lc + 12, ngot);
    bin.write_u32_le(buf, lc + 16, strtab_field.ok);
    bin.write_u32_le(buf, lc + 20, strsize_field.ok);
    lc = lc + SYMTAB_CMD_SIZE;

    bin.write_u32_le(buf, lc, LC_DYSYMTAB);
    bin.write_u32_le(buf, lc + 4, DYSYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, 0);
    bin.write_u32_le(buf, lc + 12, 0);
    bin.write_u32_le(buf, lc + 16, 0);
    bin.write_u32_le(buf, lc + 20, 0);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, ngot);
    lc = lc + DYSYMTAB_CMD_SIZE;

    lc = write_load_dylinker(buf, lc);
    di = 0;
    for (di < dyn.lib_count) {
        if (dyn.libs[di].rpath != intern.STR_NIL
            && !rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            lc = write_rpath(buf, lc, bin.resolve_name(itn, dyn.libs[di].rpath));
        }
        di = di + 1;
    }
    di = 0;
    for (di < dyn.lib_count) {
        lc = write_load_dylib(buf, lc, bin.resolve_name(itn, dyn.libs[di].soname));
        di = di + 1;
    }

    if (pie) {
        bin.write_u32_le(buf, lc, LC_BUILD_VERSION);
        bin.write_u32_le(buf, lc + 4, BUILD_VERSION_CMD_SIZE::u32);
        bin.write_u32_le(buf, lc + 8, PLATFORM_MACOS);
        bin.write_u32_le(buf, lc + 12, MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 16, MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 20, 0);
        lc = lc + BUILD_VERSION_CMD_SIZE;
    }

    val uuid_off: usize = write_uuid_cmd(buf, lc);
    lc = lc + UUID_CMD_SIZE;

    if (pie) {
        bin.write_u32_le(buf, lc, LC_MAIN);
        bin.write_u32_le(buf, lc + 4, ENTRY_POINT_CMD_SIZE::u32);
        bin.write_u64_le(buf, lc + 8, entry - lay.text_va);
        bin.write_u64_le(buf, lc + 16, image_options.stack_reserve);
        lc = lc + ENTRY_POINT_CMD_SIZE;
    }
    or {
        lc = write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);
    }

    bin.write_u32_le(buf, lc, LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, sig_off_field.ok);
    bin.write_u32_le(buf, lc + 12, sig_size_field.ok);
    lc = lc + LINKEDIT_DATA_CMD_SIZE;
    val commands_closed: err[fail.Fail] = plan.close(?fp, header_row, lc);
    if (sel commands_closed.err) { ret commands_closed; }

    write_segment_bytes(buf, segs, seg_count, seg_offsets);

    if (nstub > 0) {
        var raw: u32 = 0;
        var n:   u32 = 0;
        for (raw < dyn.import_count) {
            if (dyn.imports[raw].is_func) {
                val slot_n:  u32 = macho_got_ordinal(dyn, raw);
                val stub_va: u64 = lay.stubs_va + n::u64 * stub_sz::u64;
                val slot_va: u64 = lay.got_va + slot_n::u64 * 8;
                write_macho_stub(buf, arch_id, lay.stubs_off + n::usize * stub_sz,
                    stub_va, slot_va);
                n = n + 1;
            }
            raw = raw + 1;
        }
        if (n != nstub) { ret err[fail.Fail].err{fail.message("macho: stub count drifted from its plan")}; }
    }

    val rebase_end:    usize          = write_rebase_info(buf, lay.rebase_off, dyn, segs, lay.text_va, pz);
    val rebase_closed: err[fail.Fail] = plan.close(?fp, rebase_r.ok, rebase_end);
    if (sel rebase_closed.err) { ret rebase_closed; }
    val bind_end:    usize          = write_bind_info(buf, lay.bind_off, itn, dyn, segs, lay.text_va, pz, lay.got_seg_index);
    val bind_closed: err[fail.Fail] = plan.close(?fp, bind_r.ok, bind_end);
    if (sel bind_closed.err) { ret bind_closed; }

    buf[lay.strtab_off] = 0;
    var str_pos: usize = 1;
    var sym_off: usize = lay.symtab_off;
    var di2:     u32   = 0;
    for (di2 < dyn.import_count) {
        if (import_needs_got(dyn, di2)) {
            val sname:  str = bin.resolve_name(itn, dyn.imports[di2].symbol);
            var n_strx: u32 = 0;
            if (sname != nil) {
                val strx_field: res[u32, fail.Fail] = plan.field_u32(?fp, str_pos, "symbol name offset");
                if (sel strx_field.err) { ret err[fail.Fail].err{strx_field.err}; }
                n_strx  = strx_field.ok;
                str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, sname);
            }
            or {
                buf[lay.strtab_off + str_pos] = 0;
                str_pos                       = str_pos + 1;
            }
            bin.write_u32_le(buf, sym_off, n_strx);
            buf[sym_off + 4] = N_UNDF | N_EXT;
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, dylib_ordinal_for(dyn, di2)::u16 << 8);
            bin.write_u64_le(buf, sym_off + 8, 0);
            sym_off = sym_off + NLIST_64_SIZE;
        }
        di2 = di2 + 1;
    }
    val symtab_closed: err[fail.Fail] = plan.close(?fp, symtab_r.ok, sym_off);
    if (sel symtab_closed.err) { ret symtab_closed; }
    val strtab_closed: err[fail.Fail] = plan.close_size(?fp, strtab_r.ok, str_pos);
    if (sel strtab_closed.err) { ret strtab_closed; }

    val fx_r: err[fail.Fail] =
        patch_macho_fixups(buf, arch_id, ?lay, dyn, fixups, fixup_count,
        seg_offsets, segs, seg_count, nstub);
    if (sel fx_r.err) { ret fx_r; }
    val gx_r: err[fail.Fail] = patch_macho_import_addr_fixups(buf, ?lay, dyn, seg_offsets, segs, seg_count);
    if (sel gx_r.err) { ret gx_r; }

    val identified: err[fail.Fail] = seal_build_id(buf, sig_off, uuid_off);
    if (sel identified.err) { ret identified; }

    val signed:     usize          = write_code_signature(buf, sig_off, name, sig_off, 0, exec_limit);
    val sig_closed: err[fail.Fail] = plan.close_size(?fp, sig_r.ok, signed);
    if (sel sig_closed.err) { ret sig_closed; }

    val r_3066: err[outcome.Fail] = output.bytes(itn, alloc, destination, buf, total_size, 0o755, false, "macho: dyn-exec", "macho: could not publish output file");
    if (sel r_3066.err) { ret err[fail.Fail].err{fail.message(outcome.describe(r_3066.err))}; }
    ret err[fail.Fail].ok{};
}
