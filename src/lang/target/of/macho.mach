pub fun machine_for_arch(arch_id: u32) u32 {
    val r: res[u32, fail.Fail] = macho_format.cpu_type_for(arch_id);
    if (sel r.err) { ret 0; }
    ret r.ok;
}

val COVERS_ISAS: [2]u32 = [2]u32{catalog_arch.X86_64, catalog_arch.AARCH64};

fun selector_stubs(arch_id: u32) *target_of.SelectorStubShape {
    val row: *macho_format.IsaRow = macho_format.row_for(arch_id);
    if (row == nil) { ret nil; }
    ret ?row.selector_stub;
}

fun object_matches(bytes: *u8, len: usize, arch_id: u32) bool {
    if (bytes == nil || len < 8 || bin.read_u32_le(bytes, 0) != macho_format.MH_MAGIC_64) { ret false; }
    val want: u32 = machine_for_arch(arch_id);
    ret want != 0 && bin.read_u32_le(bytes, 4) == want;
}

fun shared_names(path: *u8) bool {
    ret target_of.path_has_suffix(path, ".dylib", true);
}

# lib<name>.dylib, then lib<name>.6.dylib down to lib<name>.0.dylib
fun shared_candidate(dir: *u8, name: *u8, index: u32, buf: *u8, cap: usize) bool {
    if (index == 0) {
        var bare: [3]str = [3]str{"lib", name::str, ".dylib"};
        ret target_of.path_write(buf, cap, dir, ?bare[0], 3);
    }
    if (index > 7) { ret false; }
    var versioned: [5]str = [5]str{"lib", name::str, ".", target_of.digit_text(7 - index), ".dylib"};
    ret target_of.path_write(buf, cap, dir, ?versioned[0], 5);
}

# a dylib for the instruction set, thin or a slice of a universal file, named
# by its install name
fun shared_identity(bytes: *u8, len: usize, arch_id: u32, path: *u8, out: *u8, cap: usize) bool {
    val cpu_type: u32 = machine_for_arch(arch_id);
    if (cpu_type == 0) { ret false; }
    if (len >= 4 && bin.read_u32_le(bytes, 0) == macho_format.MH_MAGIC_64) {
        ret dylib_id_read(bytes, len, 0, len, cpu_type, out, cap);
    }
    if (len >= 8 && bin.read_u32_be(bytes, 0) == FAT_MAGIC) {
        ret fat_dylib_id_read(bytes, len, false, cpu_type, out, cap);
    }
    if (len >= 8 && bin.read_u32_be(bytes, 0) == FAT_MAGIC_64) {
        ret fat_dylib_id_read(bytes, len, true, cpu_type, out, cap);
    }
    ret false;
}

val FAT_MAGIC:    u32 = 0xCAFEBABE;
val FAT_MAGIC_64: u32 = 0xCAFEBABF;

fun dylib_id_read(buf: *u8, len: usize, base: usize, slice_len: usize,
    cpu_type: u32, out: *u8, cap: usize) bool {
    if (base > len || slice_len > len - base || slice_len < 32) { ret false; }
    val end: usize = base + slice_len;
    if (bin.read_u32_le(buf, base) != macho_format.MH_MAGIC_64)   { ret false; }
    if (bin.read_u32_le(buf, base + 4) != cpu_type)               { ret false; }
    if (bin.read_u32_le(buf, base + 12) != macho_format.MH_DYLIB) { ret false; }
    val ncmds:      u32   = bin.read_u32_le(buf, base + 16);
    val sizeofcmds: usize = bin.read_u32_le(buf, base + 20)::usize;
    if (sizeofcmds > end - (base + 32)) { ret false; }
    val cmds_end: usize = base + 32 + sizeofcmds;

    var off: usize = base + 32;
    var i:   u32   = 0;
    for (i < ncmds) {
        if (off + 8 > cmds_end) { ret false; }
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmdsize < 8 || cmdsize > cmds_end - off) { ret false; }
        if (cmd == macho_format.LC_ID_DYLIB) {
            if (cmdsize < 24) { ret false; }
            val name_off: usize = bin.read_u32_le(buf, off + 8)::usize;
            if (name_off < 24 || name_off >= cmdsize) { ret false; }
            val at: usize = off + name_off;
            var k:  usize = 0;
            for (at + k < off + cmdsize && buf[at + k] != 0 && k + 1 < cap) {
                out[k] = buf[at + k];
                k      = k + 1;
            }
            if (at + k >= off + cmdsize || buf[at + k] != 0 || k == 0) { ret false; }
            out[k] = 0;
            ret true;
        }
        off = off + cmdsize;
        i   = i + 1;
    }
    ret false;
}

fun fat_dylib_id_read(buf: *u8, len: usize, wide: bool,
    cpu_type: u32, out: *u8, cap: usize) bool {
    val nfat:     usize = bin.read_u32_be(buf, 4)::usize;
    var ent_size: usize = 20;
    if (wide)                        { ent_size = 32; }
    if (nfat > (len - 8) / ent_size) { ret false; }

    var i: usize = 0;
    for (i < nfat) {
        val ent:  usize = 8 + i * ent_size;
        var off:  usize = bin.read_u32_be(buf, ent + 8)::usize;
        var size: usize = bin.read_u32_be(buf, ent + 12)::usize;
        if (wide) {
            off  = u64_be_read(buf, ent + 8)::usize;
            size = u64_be_read(buf, ent + 16)::usize;
        }
        if (dylib_id_read(buf, len, off, size, cpu_type, out, cap)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun u64_be_read(buf: *u8, off: usize) u64 {
    ret (bin.read_u32_be(buf, off)::u64 << 32)
        | bin.read_u32_be(buf, off + 4)::u64;
}

val STATIC_SUFFIXES: [2]str = [2]str{"o", "a"};

val SHARED_NAMING: target_of.SharedNaming = target_of.SharedNaming{
    noun:           "a Mach-O dylib",
    loadable:       "Mach-O dylib",
    requires:       "a Mach-O target",
    prefix:         "lib",
    names:          shared_names,
    candidate:      shared_candidate,
    identity:       shared_identity,
    runtime_prefix: "@rpath/",
    absent:         target_of.ABSENT_BY_PATH,
};

val INPUT_NAMING: target_of.InputNaming = target_of.InputNaming{
    library_prefix:      "lib",
    static_suffixes:     ?STATIC_SUFFIXES[0],
    static_suffix_count: 2,
    object_matches:      object_matches,
    shared:              ?SHARED_NAMING,
};

# an executable the loader binds nothing in, or one it binds imports in
fun image_emit(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    if (img.dynamic == nil) { ret emit_exec(img, dst); }
    ret emit_dyn_exec(img, dst);
}

pub val VTABLE: target_of.OfVTable = target_of.OfVTable{
    id:                      target_of.MACHO,
    fingerprint_tag:         2,
    name:                    mink_format.MACHO.name,
    links_from_image:        true,
    debug_offset_kind:       target_of.RK_ABS32,
    object_suffix:           ".o",
    object_emit:             object.object_emit,
    parse_object:            macho_parse.parse_object,
    image_emit:              image_emit,
    writes_dynamic:          true,
    two_level_namespace:     true,
    default_debug:           "dwarf",
    shared_input_ext:        ".dylib",
    import_address_prefix:   "",
    imports_through_got:     true,
    header_in_first_segment: true,
    maps_by_page:            true,
    carries_stack_size:      true,
    carries_record:          true,
    default_stack_reserve:   0,
    header_span:             loadcmd.header_span,
    stub_shape:              dyld.stub_shape,
    got_shape:               dyld.got_shape,
    unwind_shape:            unwind.unwind_shape,
    covers_isas:             ?COVERS_ISAS[0],
    covers_isa_count:        2,
    inputs:                  ?INPUT_NAMING,
    selector_stubs:          selector_stubs,

    binds_absolute_import_pointers: true,
};

fun reserved_header_span(segs: *target_of.LoadSegment, seg_count: u32,
    image_base: u64) res[usize, fail.Fail] {
    if (seg_count == 0 || segs == nil) {
        ret res[usize, fail.Fail].err{fail.message("image has no load segments to map the header into")};
    }
    if (segs[0].vaddr <= image_base) {
        ret res[usize, fail.Fail].err{fail.message("base address too low to map the header")};
    }
    ret res[usize, fail.Fail].ok{(segs[0].vaddr - image_base)::usize};
}

fun refuse_unixthread_stack(opts: *target_of.ImageOptions) err[fail.Fail] {
    if (opts.stack_reserve == 0 && opts.stack_commit == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_STACK_SIZE, "a stack size needs an LC_MAIN entry, and this image enters through LC_UNIXTHREAD; `stack_reserve` / `stack_commit` reach only a position-independent Mach-O image")};
}

fun emit_exec(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    val alloc:         *A.Allocator            = img.alloc;
    val itn:           *intern.Interner        = img.interner;
    val isa_vt:        *target_of.ObjectTarget = img.target;
    val segs:          *target_of.LoadSegment  = img.segments;
    val seg_count:     u32                     = img.segment_count;
    val image_base:    u64                     = img.image_base;
    val entry:         u64                     = img.entry;
    val funcs:         *target_of.ExecFunction = img.functions;
    val func_count:    u32                     = img.function_count;
    val debug:         *target_of.Section      = img.debug;
    val debug_count:   u32                     = img.debug_count;
    val name:          *u8                     = img.name;
    val image_options: target_of.ImageOptions  = img.options;

    val su: err[fail.Fail] = refuse_unixthread_stack(?image_options);
    if (sel su.err) { ret su; }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = macho_format.cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }
    val exec_page: u64 = macho_format.page_size(arch_id);

    val have_dwarf: bool = debug_count > 0;

    val has_pagezero: bool = image_base > 0;
    var ncmds:        u32  = loadcmd.frame_cmd_count(nil::*target_of.DynamicInfo, segs, seg_count, has_pagezero) + 4;
    if (have_dwarf) { ncmds = ncmds + 1; }

    val thread_state:    usize = macho_format.row_for(arch_id).thread_count::usize * 4;
    val thread_cmd_size: usize = 16 + thread_state;

    var sizeofcmds: usize = loadcmd.frame_cmd_bytes(nil::*target_of.DynamicInfo, segs, seg_count, has_pagezero)
        + thread_cmd_size
        + macho_format.SEGMENT_CMD_64_SIZE + macho_format.UUID_CMD_SIZE + macho_format.LINKEDIT_DATA_CMD_SIZE;
    sizeofcmds = sizeofcmds + macho_dwarf.cmd_bytes(debug_count);
    val header_end: usize = macho_format.MACH_HEADER_64_SIZE + sizeofcmds;

    val hs: res[usize, fail.Fail] = reserved_header_span(segs, seg_count, image_base);
    if (sel hs.err) { ret err[fail.Fail].err{hs.err}; }
    val hdr_span: usize = hs.ok;
    if (header_end > hdr_span) {
        ret err[fail.Fail].err{fail.message("exec header exceeds the linker's reservation")};
    }
    val text_va:       u64            = segs[0].vaddr - hdr_span::u64;
    val pagezero_size: u64            = text_va;
    val unwound:       err[fail.Fail] = unwind.fill_unwind(alloc, arch_id, segs, seg_count, funcs, func_count, text_va, nil::*target_of.DynamicInfo);
    if (sel unwound.err) { ret unwound; }

    val fp_r: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "macho", of_plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: of_plan.FilePlan = fp_r.ok;
    fin { of_plan.dnit(?fp); }
    val header_r: res[u32, fail.Fail] = of_plan.place_at(?fp, "mach header and load commands", target_of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val header_row: u32 = header_r.ok;

    val sr: res[segment.SegmentRows, fail.Fail] = segment.place_segments(alloc, ?fp, segs, seg_count, hdr_span, exec_page::usize, false);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    var seg_rows: segment.SegmentRows = sr.ok;
    fin { segment.segment_rows_free(alloc, ?seg_rows, seg_count); }
    val seg_offsets: *usize = seg_rows.offsets;

    var hi_va: u64 = 0;
    var li:    u32 = 0;
    for (li < seg_count) {
        val rounded: res[u64, fail.Fail] = of_plan.align_address(?fp, "load segment", segs[li].memsz::u64, exec_page);
        if (sel rounded.err)                         { ret err[fail.Fail].err{rounded.err}; }
        if (rounded.ok > ~(0::u64) - segs[li].vaddr) { ret err[fail.Fail].err{fail.message("load segment overflows the address space")}; }
        val end: u64 = segs[li].vaddr + rounded.ok;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }

    val dwp: res[macho_dwarf.MachoDwarf, fail.Fail] = macho_dwarf.plan(alloc, ?fp, debug, debug_count, macho_format.page_size(arch_id)::usize);
    if (sel dwp.err) { ret err[fail.Fail].err{dwp.err}; }
    var dw: macho_dwarf.MachoDwarf = dwp.ok;
    fin { macho_dwarf.free(alloc, ?dw, debug_count); }

    val exec_base:  u64 = 0;
    val exec_limit: u64 = hdr_span::u64 + segs[0].filesz::u64;

    val ident_len:       usize          = codesign.ident_len(name);
    val linkedit_padded: err[fail.Fail] = of_plan.pad(?fp, "__LINKEDIT", exec_page::usize);
    if (sel linkedit_padded.err) { ret linkedit_padded; }
    val linkedit_off: usize               = of_plan.cursor(?fp);
    val code_limit:   usize               = linkedit_off;
    val sig_size:     usize               = codesign.code_signature_size(ident_len, code_limit);
    val sig_r:        res[u32, fail.Fail] = of_plan.place(?fp, "code signature", target_of.no_section(), 1, sig_size);
    if (sel sig_r.err) { ret err[fail.Fail].err{sig_r.err}; }
    val linkedit_size: usize               = sig_size;
    val linkedit_va_r: res[u64, fail.Fail] = of_plan.align_address(?fp, "__LINKEDIT", hi_va, exec_page);
    if (sel linkedit_va_r.err) { ret err[fail.Fail].err{linkedit_va_r.err}; }
    val linkedit_va: u64                 = linkedit_va_r.ok;
    val linkedit_vm: res[u64, fail.Fail] = of_plan.align_address(?fp, "__LINKEDIT", linkedit_size::u64, exec_page);
    if (sel linkedit_vm.err) { ret err[fail.Fail].err{linkedit_vm.err}; }

    val sealed: res[usize, fail.Fail] = of_plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;

    val sizeofcmds_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    val code_limit_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, code_limit, "code signature offset");
    if (sel code_limit_field.err) { ret err[fail.Fail].err{code_limit_field.err}; }
    val sig_size_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, sig_size, "code signature size");
    if (sel sig_size_field.err) { ret err[fail.Fail].err{sig_size_field.err}; }

    val res_buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", total_size, 0o755);
    if (sel res_buf.err) { ret err[fail.Fail].err{res_buf.err}; }
    var buf: *u8 = res_buf.ok;

    bin.write_u32_le(buf, 0, macho_format.MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, macho_format.cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, macho_format.MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    bin.write_u32_le(buf, 24, macho_format.MH_NOUNDEFS);
    bin.write_u32_le(buf, 28, 0);

    val frame_r: res[usize, fail.Fail] = loadcmd.write_frame_cmds(buf, ?fp, macho_format.MACH_HEADER_64_SIZE, itn, nil::*target_of.DynamicInfo, segs,
        seg_count, seg_offsets, pagezero_size, text_va,
        hdr_span, exec_page);
    if (sel frame_r.err) { ret err[fail.Fail].err{frame_r.err}; }
    var lc: usize = frame_r.ok;
    segment.write_segment_bytes(buf, segs, seg_count, seg_offsets);

    val dwarf_r: res[usize, fail.Fail] = macho_dwarf.write(buf, itn, ?fp, debug, debug_count, lc, ?dw, 0);
    if (sel dwarf_r.err) { ret err[fail.Fail].err{dwarf_r.err}; }
    lc = dwarf_r.ok;
    macho_dwarf.write_bytes(buf, ?fp, debug, debug_count, ?dw);

    lc = loadcmd.write_segment_cmd(buf, lc, "__LINKEDIT", linkedit_va,
        linkedit_vm.ok,
        linkedit_off::u64, linkedit_size::u64,
        macho_format.VM_PROT_READ, macho_format.VM_PROT_READ, 0);

    val uuid_off: usize = loadcmd.write_uuid_cmd(buf, lc);
    lc = lc + macho_format.UUID_CMD_SIZE;

    lc = loadcmd.write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);

    bin.write_u32_le(buf, lc, macho_format.LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, macho_format.LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, code_limit_field.ok);
    bin.write_u32_le(buf, lc + 12, sig_size_field.ok);
    lc = lc + macho_format.LINKEDIT_DATA_CMD_SIZE;
    val commands_closed: err[fail.Fail] = of_plan.close(?fp, header_row, lc);
    if (sel commands_closed.err) { ret commands_closed; }

    val identified: err[fail.Fail] = codesign.seal_build_id(buf, code_limit, uuid_off);
    if (sel identified.err) { ret identified; }

    val signed:     usize          = codesign.write_code_signature(buf, code_limit, name, code_limit, exec_base, exec_limit);
    val sig_closed: err[fail.Fail] = of_plan.close_size(?fp, sig_r.ok, signed);
    if (sel sig_closed.err) { ret sig_closed; }

    ret err[fail.Fail].ok{};
}

# the stubs live in the table the linker reserved inside the code, so no data
# lies between a call site and its stub
fun locate_stubs(alloc: *A.Allocator, dyn: *target_of.DynamicInfo, nstub: u32, stub_sz: usize,
    segs: *target_of.LoadSegment, seg_count: u32, seg_offsets: *usize, lay: *dyld.MachoDynLayout) err[fail.Fail] {
    if (dyn.stubs.size != nstub::usize * stub_sz) {
        ret err[fail.Fail].err{fail.message("the linker reserved no call-stub table for the imported functions")};
    }
    val at: res[target_of.SpanLocation, fail.Fail] = target_of.span_locate(alloc, dyn.stubs, segs, seg_count, true, "the call-stub table");
    if (sel at.err) { ret err[fail.Fail].err{at.err}; }
    lay.stubs_va   = dyn.stubs.vaddr;
    lay.stubs_size = dyn.stubs.size;
    lay.stubs_off  = seg_offsets[at.ok.segment] + at.ok.offset::usize;
    ret err[fail.Fail].ok{};
}

# finds the import GOT the linker reserved inside the read-only data, one slot
# per import that needs one, and the segment a bind opcode addresses it through
fun locate_got(alloc: *A.Allocator, dyn: *target_of.DynamicInfo, ngot: u32, segs: *target_of.LoadSegment, seg_count: u32,
    pz: u32, lay: *dyld.MachoDynLayout) err[fail.Fail] {
    if (dyn.got.size != ngot::usize * 8) {
        ret err[fail.Fail].err{fail.message("the linker reserved no GOT for the imports that need a slot")};
    }
    val at: res[target_of.SpanLocation, fail.Fail] = target_of.span_locate(alloc, dyn.got, segs, seg_count, false, "the GOT");
    if (sel at.err) { ret err[fail.Fail].err{at.err}; }
    lay.got_va   = dyn.got.vaddr;
    lay.got_size = dyn.got.size;
    dyld.seg_offset_loc(dyn, at.ok.segment, at.ok.offset::u32, segs, lay.text_va, pz, ?lay.got_seg_index, ?lay.got_seg_offset);
    ret err[fail.Fail].ok{};
}

fun emit_dyn_exec(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    val alloc:         *A.Allocator            = img.alloc;
    val itn:           *intern.Interner        = img.interner;
    val isa_vt:        *target_of.ObjectTarget = img.target;
    val segs:          *target_of.LoadSegment  = img.segments;
    val seg_count:     u32                     = img.segment_count;
    val image_base:    u64                     = img.image_base;
    val entry:         u64                     = img.entry;
    val funcs:         *target_of.ExecFunction = img.functions;
    val func_count:    u32                     = img.function_count;
    val dyn:           *target_of.DynamicInfo  = img.dynamic;
    val fixups:        *target_of.ImportFixup  = img.dynamic.call_fixups;
    val fixup_count:   u32                     = img.dynamic.call_fixup_count;
    val debug:         *target_of.Section      = img.debug;
    val debug_count:   u32                     = img.debug_count;
    val name:          *u8                     = img.name;
    val image_options: target_of.ImageOptions  = img.options;

    if (seg_count == 0) { ret err[fail.Fail].err{fail.message("dyn-exec has no load segments")}; }
    if (segs == nil)    { ret err[fail.Fail].err{fail.message("nil dyn-exec load segments")}; }
    if (dyn.import_count > 0 && dyn.imports == nil) {
        ret err[fail.Fail].err{fail.message("nil dynamic import array")};
    }
    if (dyn.import_addr_fixup_count > 0 && dyn.import_addr_fixups == nil) {
        ret err[fail.Fail].err{fail.message("nil import-address fixup array")};
    }
    if (dyn.base_reloc_count > 0 && dyn.base_relocs == nil) {
        ret err[fail.Fail].err{fail.message("nil base-relocation array")};
    }
    if (fixup_count > 0 && fixups == nil) {
        ret err[fail.Fail].err{fail.message("nil call-site fixup array")};
    }
    val arch_id: u32                 = isa_vt.arch_id;
    val ct:      res[u32, fail.Fail] = macho_format.cpu_type_for(arch_id);
    if (sel ct.err) { ret err[fail.Fail].err{ct.err}; }

    val exec_page: u64   = macho_format.page_size(arch_id);
    val page:      usize = exec_page::usize;
    val nstub:     u32   = target_of.func_import_count(dyn);
    val ngot:      u32   = dyld.got_import_count(dyn);
    val stub_sz:   usize = dyld.stub_size(arch_id);

    val pie: bool = dyn.pie;
    if (!pie) {
        val su: err[fail.Fail] = refuse_unixthread_stack(?image_options);
        if (sel su.err) { ret su; }
    }
    var bri: u32 = 0;
    for (bri < dyn.base_reloc_count) {
        if (dyn.base_relocs[bri].seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("base relocation references an out-of-range segment")};
        }
        bri = bri + 1;
    }
    var fxi: u32 = 0;
    for (fxi < dyn.import_addr_fixup_count) {
        if (dyn.import_addr_fixups[fxi].seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("import-address fixup references an out-of-range segment")};
        }
        if (dyn.import_addr_fixups[fxi].import_index >= dyn.import_count) {
            ret err[fail.Fail].err{fail.message("import-address fixup references an out-of-range import")};
        }
        fxi = fxi + 1;
    }
    if (pie && dyn.base_reloc_count > 1) {
        sort.sort_by[target_of.BaseReloc](dyn.base_relocs, dyn.base_reloc_count::usize, dyld.base_reloc_cmp);
    }

    if (segment.data_const_seg_count(dyn, segs, seg_count) > 1) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, segment.data_const_conflict_message(itn, alloc, dyn, segs, seg_count))};
    }

    val seg_cmds: u32 = loadcmd.frame_cmd_count(dyn, segs, seg_count, image_base > 0) + 1;

    val thread_state:    usize = macho_format.row_for(arch_id).thread_count::usize * 4;
    val thread_cmd_size: usize = 16 + thread_state;
    var entry_cmd_size:  usize = thread_cmd_size;
    if (pie) { entry_cmd_size = macho_format.ENTRY_POINT_CMD_SIZE; }

    val sect_total: u32 = loadcmd.frame_sect_total(segs, seg_count);

    var sizeofcmds: usize = seg_cmds::usize * macho_format.SEGMENT_CMD_64_SIZE
        + sect_total::usize * macho_format.SECTION_64_SIZE
        + macho_format.DYLD_INFO_CMD_SIZE + macho_format.SYMTAB_CMD_SIZE + macho_format.DYSYMTAB_CMD_SIZE
        + loadcmd.dylinker_cmd_size() + entry_cmd_size + macho_format.UUID_CMD_SIZE + macho_format.LINKEDIT_DATA_CMD_SIZE;
    if (pie) { sizeofcmds = sizeofcmds + macho_format.BUILD_VERSION_CMD_SIZE; }
    var di:          u32 = 0;
    var rpath_count: u32 = 0;
    for (di < dyn.lib_count) {
        sizeofcmds = sizeofcmds + loadcmd.dylib_cmd_size(bin.resolve_name(itn, dyn.libs[di].soname));
        if (!intern.str_is_nil(dyn.libs[di].rpath)
            && !loadcmd.rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            sizeofcmds = sizeofcmds
                + loadcmd.rpath_cmd_size(bin.resolve_name(itn, dyn.libs[di].rpath));
            rpath_count = rpath_count + 1;
        }
        di = di + 1;
    }

    var ncmds: u32 = seg_cmds + 7 + dyn.lib_count + rpath_count;
    if (pie) { ncmds = ncmds + 1; }

    val have_dwarf: bool = debug_count > 0;
    if (have_dwarf) {
        sizeofcmds = sizeofcmds + macho_dwarf.cmd_bytes(debug_count);
        ncmds      = ncmds + 1;
    }
    val header_end: usize = macho_format.MACH_HEADER_64_SIZE + sizeofcmds;

    var lay: dyld.MachoDynLayout;
    val hs:  res[usize, fail.Fail] = reserved_header_span(segs, seg_count, image_base);
    if (sel hs.err) { ret err[fail.Fail].err{hs.err}; }
    lay.hdr_span = hs.ok;
    if (header_end > lay.hdr_span) {
        ret err[fail.Fail].err{fail.message("dyn-exec header exceeds the linker's reservation")};
    }
    lay.text_va       = segs[0].vaddr - lay.hdr_span::u64;
    lay.pagezero_size = lay.text_va;
    val unwound: err[fail.Fail] = unwind.fill_unwind(alloc, arch_id, segs, seg_count, funcs, func_count, lay.text_va, dyn);
    if (sel unwound.err) { ret unwound; }

    val fp_r: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "macho", of_plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    var fp: of_plan.FilePlan = fp_r.ok;
    fin { of_plan.dnit(?fp); }
    val header_r: res[u32, fail.Fail] = of_plan.place_at(?fp, "mach header and load commands", target_of.no_section(), 0, header_end);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val header_row: u32 = header_r.ok;

    val sr: res[segment.SegmentRows, fail.Fail] = segment.place_segments(alloc, ?fp, segs, seg_count, lay.hdr_span, page, true);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    var seg_rows: segment.SegmentRows = sr.ok;
    fin { segment.segment_rows_free(alloc, ?seg_rows, seg_count); }
    val seg_offsets: *usize = seg_rows.offsets;

    # the mapped address space is its own plan: the segments end at hi_va,
    # then __LINKEDIT takes a page-aligned run
    var hi_va: u64 = 0;
    var li:    u32 = 0;
    for (li < seg_count) {
        if (segs[li].memsz::u64 > ~(0::u64) - segs[li].vaddr) { ret err[fail.Fail].err{fail.message("load segment overflows the address space")}; }
        val end: u64 = segs[li].vaddr + segs[li].memsz::u64;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }
    val vp_r: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "macho", of_plan.limit_64());
    if (sel vp_r.err) { ret err[fail.Fail].err{vp_r.err}; }
    var vp: of_plan.FilePlan = vp_r.ok;
    fin { of_plan.dnit(?vp); }
    val mapped: err[fail.Fail] = of_plan.pad_to(?vp, "mapped segments", hi_va::usize);
    if (sel mapped.err) { ret mapped; }

    var pz: u32 = 0;
    if (lay.pagezero_size > 0) { pz = 1; }

    lay.stubs_size     = 0;
    lay.got_size       = 0;
    lay.got_seg_index  = 0;
    lay.got_seg_offset = 0;
    if (nstub > 0) {
        val located: err[fail.Fail] = locate_stubs(alloc, dyn, nstub, stub_sz, segs, seg_count, seg_offsets, ?lay);
        if (sel located.err) { ret located; }
    }
    if (ngot > 0) {
        val located: err[fail.Fail] = locate_got(alloc, dyn, ngot, segs, seg_count, pz, ?lay);
        if (sel located.err) { ret located; }
    }

    val dwp: res[macho_dwarf.MachoDwarf, fail.Fail] = macho_dwarf.plan(alloc, ?fp, debug, debug_count, page);
    if (sel dwp.err) { ret err[fail.Fail].err{dwp.err}; }
    var dw: macho_dwarf.MachoDwarf = dwp.ok;
    fin { macho_dwarf.free(alloc, ?dw, debug_count); }

    val linkedit_padded: err[fail.Fail] = of_plan.pad(?fp, "__LINKEDIT", page);
    if (sel linkedit_padded.err) { ret linkedit_padded; }
    lay.linkedit_off = of_plan.cursor(?fp);
    val linkedit_vrow: res[u32, fail.Fail] = of_plan.place(?vp, "__LINKEDIT", target_of.no_section(), page, 0);
    if (sel linkedit_vrow.err) { ret err[fail.Fail].err{linkedit_vrow.err}; }
    lay.linkedit_va = of_plan.offset(?vp, linkedit_vrow.ok)::u64;

    lay.rebase_size = dyld.measure_rebase_info(dyn, segs, lay.text_va, pz);
    val rebase_r: res[u32, fail.Fail] = of_plan.place(?fp, "rebase opcodes", target_of.no_section(), 1, lay.rebase_size);
    if (sel rebase_r.err) { ret err[fail.Fail].err{rebase_r.err}; }
    lay.rebase_off = of_plan.offset(?fp, rebase_r.ok);
    lay.bind_size  = dyld.measure_bind_info(itn, dyn, segs, lay.text_va, pz, lay.got_seg_offset);
    val bind_r: res[u32, fail.Fail] = of_plan.place(?fp, "bind opcodes", target_of.no_section(), 1, lay.bind_size);
    if (sel bind_r.err) { ret err[fail.Fail].err{bind_r.err}; }
    lay.bind_off = of_plan.offset(?fp, bind_r.ok);
    val symtab_bytes: res[usize, fail.Fail] = of_plan.table(?fp, "symbol table", ngot::usize, macho_format.NLIST_64_SIZE);
    if (sel symtab_bytes.err) { ret err[fail.Fail].err{symtab_bytes.err}; }
    val symtab_r: res[u32, fail.Fail] = of_plan.place(?fp, "symbol table", target_of.no_section(), 8, symtab_bytes.ok);
    if (sel symtab_r.err) { ret err[fail.Fail].err{symtab_r.err}; }
    lay.symtab_off = of_plan.offset(?fp, symtab_r.ok);

    lay.strtab_size = 1;
    var si: u32 = 0;
    for (si < dyn.import_count) {
        if (dyld.import_needs_got(dyn, si)) {
            val sname: str = bin.resolve_name(itn, dyn.imports[si].symbol);
            if (sname != nil) { lay.strtab_size = lay.strtab_size + str_len(sname) + 1; }
            or                { lay.strtab_size = lay.strtab_size + 1; }
        }
        si = si + 1;
    }
    val strtab_r: res[u32, fail.Fail] = of_plan.place(?fp, "string table", target_of.no_section(), 1, lay.strtab_size);
    if (sel strtab_r.err) { ret err[fail.Fail].err{strtab_r.err}; }
    lay.strtab_off = of_plan.offset(?fp, strtab_r.ok);

    val ident_len:  usize          = codesign.ident_len(name);
    val sig_padded: err[fail.Fail] = of_plan.pad(?fp, "code signature", macho_format.CODE_SIG_ALIGN);
    if (sel sig_padded.err) { ret sig_padded; }
    val sig_off:  usize               = of_plan.cursor(?fp);
    val sig_size: usize               = codesign.code_signature_size(ident_len, sig_off);
    val sig_r:    res[u32, fail.Fail] = of_plan.place(?fp, "code signature", target_of.no_section(), 1, sig_size);
    if (sel sig_r.err) { ret err[fail.Fail].err{sig_r.err}; }
    val exec_limit: u64                   = lay.hdr_span::u64 + segs[0].filesz::u64;
    val sealed:     res[usize, fail.Fail] = of_plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_size: usize = sealed.ok;
    lay.linkedit_size = total_size - lay.linkedit_off;
    val linkedit_vm: res[u64, fail.Fail] = of_plan.align_address(?fp, "__LINKEDIT", lay.linkedit_size::u64, exec_page);
    if (sel linkedit_vm.err) { ret err[fail.Fail].err{linkedit_vm.err}; }

    val sizeofcmds_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, sizeofcmds, "sizeofcmds");
    if (sel sizeofcmds_field.err) { ret err[fail.Fail].err{sizeofcmds_field.err}; }
    val rebase_off_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.rebase_off, "rebase offset");
    if (sel rebase_off_field.err) { ret err[fail.Fail].err{rebase_off_field.err}; }
    val rebase_size_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.rebase_size, "rebase size");
    if (sel rebase_size_field.err) { ret err[fail.Fail].err{rebase_size_field.err}; }
    val bind_off_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.bind_off, "bind offset");
    if (sel bind_off_field.err) { ret err[fail.Fail].err{bind_off_field.err}; }
    val bind_size_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.bind_size, "bind size");
    if (sel bind_size_field.err) { ret err[fail.Fail].err{bind_size_field.err}; }
    val symtab_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.symtab_off, "symbol table offset");
    if (sel symtab_field.err) { ret err[fail.Fail].err{symtab_field.err}; }
    val strtab_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.strtab_off, "string table offset");
    if (sel strtab_field.err) { ret err[fail.Fail].err{strtab_field.err}; }
    val strsize_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, lay.strtab_size, "string table size");
    if (sel strsize_field.err) { ret err[fail.Fail].err{strsize_field.err}; }
    val sig_off_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, sig_off, "code signature offset");
    if (sel sig_off_field.err) { ret err[fail.Fail].err{sig_off_field.err}; }
    val sig_size_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, sig_size, "code signature size");
    if (sel sig_size_field.err) { ret err[fail.Fail].err{sig_size_field.err}; }
    var ordinal_i: u32 = 0;
    for (ordinal_i < dyn.import_count) {
        if (dyld.import_needs_got(dyn, ordinal_i) && dyld.dylib_ordinal_for(dyn, ordinal_i) > 0xFF) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "dynamic library ordinal exceeds the eight-bit n_desc field")};
        }
        ordinal_i = ordinal_i + 1;
    }
    if (lay.got_seg_index > 0xF) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "the GOT's segment ordinal exceeds the four-bit bind opcode field")};
    }

    val res_buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", total_size, 0o755);
    if (sel res_buf.err) { ret err[fail.Fail].err{res_buf.err}; }
    var buf: *u8 = res_buf.ok;

    bin.write_u32_le(buf, 0, macho_format.MH_MAGIC_64);
    bin.write_u32_le(buf, 4, ct.ok);
    bin.write_u32_le(buf, 8, macho_format.cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, macho_format.MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds_field.ok);
    var hdr_flags: u32 = macho_format.MH_DYLDLINK | macho_format.MH_TWOLEVEL;
    if (pie) { hdr_flags = hdr_flags | macho_format.MH_PIE; }
    bin.write_u32_le(buf, 24, hdr_flags);
    bin.write_u32_le(buf, 28, 0);

    val frame_r: res[usize, fail.Fail] = loadcmd.write_frame_cmds(buf, ?fp, macho_format.MACH_HEADER_64_SIZE, itn, dyn, segs, seg_count,
        seg_offsets, lay.pagezero_size, lay.text_va,
        lay.hdr_span, exec_page);
    if (sel frame_r.err) { ret err[fail.Fail].err{frame_r.err}; }
    var lc: usize = frame_r.ok;

    val dwarf_r: res[usize, fail.Fail] = macho_dwarf.write(buf, itn, ?fp, debug, debug_count, lc, ?dw, 0);
    if (sel dwarf_r.err) { ret err[fail.Fail].err{dwarf_r.err}; }
    lc = dwarf_r.ok;
    macho_dwarf.write_bytes(buf, ?fp, debug, debug_count, ?dw);

    lc = loadcmd.write_segment_cmd(buf, lc, "__LINKEDIT", lay.linkedit_va,
        linkedit_vm.ok,
        lay.linkedit_off::u64, lay.linkedit_size::u64,
        macho_format.VM_PROT_READ, macho_format.VM_PROT_READ, 0);

    var rebase_cmd_off:  u32 = 0;
    var rebase_cmd_size: u32 = 0;
    if (lay.rebase_size > 0) {
        rebase_cmd_off  = rebase_off_field.ok;
        rebase_cmd_size = rebase_size_field.ok;
    }
    bin.write_u32_le(buf, lc, macho_format.LC_DYLD_INFO_ONLY);
    bin.write_u32_le(buf, lc + 4, macho_format.DYLD_INFO_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, rebase_cmd_off);
    bin.write_u32_le(buf, lc + 12, rebase_cmd_size);
    bin.write_u32_le(buf, lc + 16, bind_off_field.ok);
    bin.write_u32_le(buf, lc + 20, bind_size_field.ok);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, 0);
    bin.write_u32_le(buf, lc + 32, 0);
    bin.write_u32_le(buf, lc + 36, 0);
    bin.write_u32_le(buf, lc + 40, 0);
    bin.write_u32_le(buf, lc + 44, 0);
    lc = lc + macho_format.DYLD_INFO_CMD_SIZE;

    bin.write_u32_le(buf, lc, macho_format.LC_SYMTAB);
    bin.write_u32_le(buf, lc + 4, macho_format.SYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, symtab_field.ok);
    bin.write_u32_le(buf, lc + 12, ngot);
    bin.write_u32_le(buf, lc + 16, strtab_field.ok);
    bin.write_u32_le(buf, lc + 20, strsize_field.ok);
    lc = lc + macho_format.SYMTAB_CMD_SIZE;

    bin.write_u32_le(buf, lc, macho_format.LC_DYSYMTAB);
    bin.write_u32_le(buf, lc + 4, macho_format.DYSYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, 0);
    bin.write_u32_le(buf, lc + 12, 0);
    bin.write_u32_le(buf, lc + 16, 0);
    bin.write_u32_le(buf, lc + 20, 0);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, ngot);
    lc = lc + macho_format.DYSYMTAB_CMD_SIZE;

    lc = loadcmd.write_load_dylinker(buf, lc);
    di = 0;
    for (di < dyn.lib_count) {
        if (!intern.str_is_nil(dyn.libs[di].rpath)
            && !loadcmd.rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            lc = loadcmd.write_rpath(buf, lc, bin.resolve_name(itn, dyn.libs[di].rpath));
        }
        di = di + 1;
    }
    di = 0;
    for (di < dyn.lib_count) {
        lc = loadcmd.write_load_dylib(buf, lc, bin.resolve_name(itn, dyn.libs[di].soname));
        di = di + 1;
    }

    if (pie) {
        bin.write_u32_le(buf, lc, macho_format.LC_BUILD_VERSION);
        bin.write_u32_le(buf, lc + 4, macho_format.BUILD_VERSION_CMD_SIZE::u32);
        bin.write_u32_le(buf, lc + 8, macho_format.PLATFORM_MACOS);
        bin.write_u32_le(buf, lc + 12, macho_format.MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 16, macho_format.MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 20, 0);
        lc = lc + macho_format.BUILD_VERSION_CMD_SIZE;
    }

    val uuid_off: usize = loadcmd.write_uuid_cmd(buf, lc);
    lc = lc + macho_format.UUID_CMD_SIZE;

    if (pie) {
        bin.write_u32_le(buf, lc, macho_format.LC_MAIN);
        bin.write_u32_le(buf, lc + 4, macho_format.ENTRY_POINT_CMD_SIZE::u32);
        bin.write_u64_le(buf, lc + 8, entry - lay.text_va);
        bin.write_u64_le(buf, lc + 16, image_options.stack_reserve);
        lc = lc + macho_format.ENTRY_POINT_CMD_SIZE;
    }
    or {
        lc = loadcmd.write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);
    }

    bin.write_u32_le(buf, lc, macho_format.LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, macho_format.LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, sig_off_field.ok);
    bin.write_u32_le(buf, lc + 12, sig_size_field.ok);
    lc = lc + macho_format.LINKEDIT_DATA_CMD_SIZE;
    val commands_closed: err[fail.Fail] = of_plan.close(?fp, header_row, lc);
    if (sel commands_closed.err) { ret commands_closed; }

    segment.write_segment_bytes(buf, segs, seg_count, seg_offsets);

    if (nstub > 0) {
        var raw: u32 = 0;
        var n:   u32 = 0;
        for (raw < dyn.import_count) {
            if (dyn.imports[raw].is_func) {
                val slot_n:  u32            = dyld.got_ordinal(dyn, raw);
                val stub_va: u64            = lay.stubs_va + n::u64 * stub_sz::u64;
                val slot_va: u64            = lay.got_va + slot_n::u64 * 8;
                val stub_r:  err[fail.Fail] = dyld.write_macho_stub(buf, arch_id, lay.stubs_off + n::usize * stub_sz,
                    stub_va, slot_va);
                if (sel stub_r.err) { ret stub_r; }
                n = n + 1;
            }
            raw = raw + 1;
        }
        if (n != nstub) { ret err[fail.Fail].err{fail.message("stub count drifted from its plan")}; }
    }

    val rebase_end:    usize          = dyld.write_rebase_info(buf, lay.rebase_off, dyn, segs, lay.text_va, pz);
    val rebase_closed: err[fail.Fail] = of_plan.close(?fp, rebase_r.ok, rebase_end);
    if (sel rebase_closed.err) { ret rebase_closed; }
    val bind_end: usize = dyld.write_bind_info(buf, lay.bind_off, itn, dyn, segs, lay.text_va, pz,
        lay.got_seg_index, lay.got_seg_offset);
    val bind_closed: err[fail.Fail] = of_plan.close(?fp, bind_r.ok, bind_end);
    if (sel bind_closed.err) { ret bind_closed; }

    buf[lay.strtab_off] = 0;
    var str_pos: usize = 1;
    var sym_off: usize = lay.symtab_off;
    var di2:     u32   = 0;
    for (di2 < dyn.import_count) {
        if (dyld.import_needs_got(dyn, di2)) {
            val sname:  str = bin.resolve_name(itn, dyn.imports[di2].symbol);
            var n_strx: u32 = 0;
            if (sname != nil) {
                val strx_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, str_pos, "symbol name offset");
                if (sel strx_field.err) { ret err[fail.Fail].err{strx_field.err}; }
                n_strx  = strx_field.ok;
                str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, sname);
            }
            or {
                buf[lay.strtab_off + str_pos] = 0;
                str_pos                       = str_pos + 1;
            }
            bin.write_u32_le(buf, sym_off, n_strx);
            buf[sym_off + 4] = macho_format.N_UNDF | macho_format.N_EXT;
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, dyld.dylib_ordinal_for(dyn, di2)::u16 << 8);
            bin.write_u64_le(buf, sym_off + 8, 0);
            sym_off = sym_off + macho_format.NLIST_64_SIZE;
        }
        di2 = di2 + 1;
    }
    val symtab_closed: err[fail.Fail] = of_plan.close(?fp, symtab_r.ok, sym_off);
    if (sel symtab_closed.err) { ret symtab_closed; }
    val strtab_closed: err[fail.Fail] = of_plan.close_size(?fp, strtab_r.ok, str_pos);
    if (sel strtab_closed.err) { ret strtab_closed; }

    val fx_r: err[fail.Fail] =
        dyld.patch_macho_fixups(buf, arch_id, ?lay, dyn, fixups, fixup_count,
        seg_offsets, segs, seg_count, nstub);
    if (sel fx_r.err) { ret fx_r; }
    val gx_r: err[fail.Fail] = dyld.patch_macho_import_addr_fixups(buf, ?lay, dyn, seg_offsets, segs, seg_count);
    if (sel gx_r.err) { ret gx_r; }

    val identified: err[fail.Fail] = codesign.seal_build_id(buf, sig_off, uuid_off);
    if (sel identified.err) { ret identified; }

    val signed:     usize          = codesign.write_code_signature(buf, sig_off, name, sig_off, 0, exec_limit);
    val sig_closed: err[fail.Fail] = of_plan.close_size(?fp, sig_r.ok, signed);
    if (sel sig_closed.err) { ret sig_closed; }

    ret err[fail.Fail].ok{};
}
