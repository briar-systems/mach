rec MachoReloc {
    r_type: u32;
    pcrel:  u32;
    length: u32;
}

fun arch_is_arm64(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

fun macho_page_size(arch_id: u32) u64 {
    if (arch_is_arm64(arch_id)) { ret 16384; }
    ret 4096;
}

fun cpu_type_for(arch_id: u32) R.Result[u32, str] {
    if (arch_id == isa.ARCH_X86_64)  { ret R.ok[u32, str](CPU_TYPE_X86_64); }
    if (arch_id == isa.ARCH_AARCH64) { ret R.ok[u32, str](CPU_TYPE_ARM64); }
    ret R.err[u32, str]("macho: unsupported architecture (only x86_64 and arm64)");
}

pub fun machine_for_arch(arch_id: u32) u32 {
    val r: R.Result[u32, str] = cpu_type_for(arch_id);
    if (R.is_err[u32, str](r)) { ret 0; }
    ret R.unwrap_ok[u32, str](r);
}

fun cpu_subtype_for(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret CPU_SUBTYPE_ARM64_ALL; }
    ret CPU_SUBTYPE_X86_64_ALL;
}

fun macho_reloc_for(itn: *intern.Interner, alloc: *A.Allocator, arch_id: u32, kind: of.RelocKind) R.Result[MachoReloc, str] {
    var r: MachoReloc;
    if (arch_is_arm64(arch_id)) {
        if (kind == of.RK_ABS64)        { r.r_type = ARM64_RELOC_UNSIGNED;  r.pcrel = 0; r.length = 3; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_PLT32)        { r.r_type = ARM64_RELOC_BRANCH26;  r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_JUMP26)       { r.r_type = ARM64_RELOC_BRANCH26;  r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_PAGE21)       { r.r_type = ARM64_RELOC_PAGE21;    r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_ADD_LO12)     { r.r_type = ARM64_RELOC_PAGEOFF12; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_LDST8_LO12)   { r.r_type = ARM64_RELOC_PAGEOFF12; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_LDST16_LO12)  { r.r_type = ARM64_RELOC_PAGEOFF12; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_LDST32_LO12)  { r.r_type = ARM64_RELOC_PAGEOFF12; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_LDST64_LO12)  { r.r_type = ARM64_RELOC_PAGEOFF12; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_LDST128_LO12) { r.r_type = ARM64_RELOC_PAGEOFF12; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        if (kind == of.RK_ABS32)        { r.r_type = ARM64_RELOC_UNSIGNED;  r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
        ret R.err[MachoReloc, str](unsupported_kind_message(itn, alloc, kind));
    }
    if (kind == of.RK_ABS64)    { r.r_type = X86_64_RELOC_UNSIGNED; r.pcrel = 0; r.length = 3; ret R.ok[MachoReloc, str](r); }
    if (kind == of.RK_PC32)     { r.r_type = X86_64_RELOC_SIGNED;   r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
    if (kind == of.RK_PLT32)    { r.r_type = X86_64_RELOC_BRANCH;   r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
    if (kind == of.RK_GOTPCREL) { r.r_type = X86_64_RELOC_GOT_LOAD; r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
    if (kind == of.RK_GOTPCREL_NORELAX)   { r.r_type = X86_64_RELOC_GOT; r.pcrel = 1; r.length = 2; ret R.ok[MachoReloc, str](r); }
    if (kind == of.RK_GOTPCREL64_NORELAX) { r.r_type = X86_64_RELOC_GOT; r.pcrel = 1; r.length = 3; ret R.ok[MachoReloc, str](r); }
    if (kind == of.RK_ABS32)    { r.r_type = X86_64_RELOC_UNSIGNED; r.pcrel = 0; r.length = 2; ret R.ok[MachoReloc, str](r); }
    ret R.err[MachoReloc, str](unsupported_kind_message(itn, alloc, kind));
}

fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, cputype: u32, r_type: u32, r_length: u32, insn: u32) R.Result[of.RelocKind, str] {
    if (cputype == CPU_TYPE_ARM64) {
        if (r_type == ARM64_RELOC_UNSIGNED)  { ret unsigned_kind(r_length); }
        if (r_type == ARM64_RELOC_BRANCH26)  { ret R.ok[of.RelocKind, str](of.RK_PLT32); }
        if (r_type == ARM64_RELOC_PAGE21)    { ret R.ok[of.RelocKind, str](of.RK_PAGE21); }
        if (r_type == ARM64_RELOC_PAGEOFF12) { ret pageoff12_kind(itn, alloc, insn); }
        ret R.err[of.RelocKind, str](unsupported_type_message(itn, alloc, r_type::u64));
    }
    if (r_type == X86_64_RELOC_UNSIGNED) { ret unsigned_kind(r_length); }
    if (x64_is_signed(r_type)) {
        if (r_length != 2) { ret R.err[of.RelocKind, str]("macho: x86_64 signed relocation field is not 4 bytes"); }
        ret R.ok[of.RelocKind, str](of.RK_PC32);
    }
    if (r_type == X86_64_RELOC_BRANCH)   { ret R.ok[of.RelocKind, str](of.RK_PLT32); }
    if (r_type == X86_64_RELOC_GOT_LOAD) {
        if (r_length != 2) { ret R.err[of.RelocKind, str]("macho: x86_64 GOT_LOAD relocation field is not 4 bytes"); }
        ret R.ok[of.RelocKind, str](of.RK_GOTPCREL);
    }
    if (r_type == X86_64_RELOC_GOT) {
        if (r_length == 2) { ret R.ok[of.RelocKind, str](of.RK_GOTPCREL_NORELAX); }
        if (r_length == 3) { ret R.ok[of.RelocKind, str](of.RK_GOTPCREL64_NORELAX); }
        ret R.err[of.RelocKind, str]("macho: x86_64 GOT relocation field is neither 4 nor 8 bytes");
    }
    ret R.err[of.RelocKind, str](unsupported_type_message(itn, alloc, r_type::u64));
}

fun x64_is_signed(r_type: u32) bool {
    ret r_type == X86_64_RELOC_SIGNED || r_type == X86_64_RELOC_SIGNED_1
        || r_type == X86_64_RELOC_SIGNED_2 || r_type == X86_64_RELOC_SIGNED_4;
}

fun x64_got_load_insn(bytes: *u8, len: usize, address: usize) bool {
    if (bytes == nil || address < 3 || address + 4 > len) { ret false; }
    val rex: u8 = bytes[address - 3];
    val opcode: u8 = bytes[address - 2];
    val modrm: u8 = bytes[address - 1];
    ret (rex & 0xF8) == 0x48 && opcode == 0x8B && (modrm & 0xC7) == 0x05;
}

fun x64_pcrel_bias(r_type: u32) i64 {
    if (r_type == X86_64_RELOC_SIGNED_1) { ret 1; }
    if (r_type == X86_64_RELOC_SIGNED_2) { ret 2; }
    if (r_type == X86_64_RELOC_SIGNED_4) { ret 4; }
    ret 0;
}

fun unsigned_kind(r_length: u32) R.Result[of.RelocKind, str] {
    if (r_length == 3) { ret R.ok[of.RelocKind, str](of.RK_ABS64); }
    ret R.ok[of.RelocKind, str](of.RK_ABS32);
}

fun pageoff12_kind(itn: *intern.Interner, alloc: *A.Allocator, insn: u32) R.Result[of.RelocKind, str] {
    if ((insn & 0x7F800000) == 0x11000000) { ret R.ok[of.RelocKind, str](of.RK_ADD_LO12); }
    if ((insn & 0x3B000000) == 0x39000000) {
        val v:    u32 = (insn >> 26) & 0x1;
        val size: u32 = (insn >> 30) & 0x3;
        val opc:  u32 = (insn >> 22) & 0x3;
        if (v == 1 && size == 0 && opc == 3) { ret R.ok[of.RelocKind, str](of.RK_LDST128_LO12); }
        if (size == 0) { ret R.ok[of.RelocKind, str](of.RK_LDST8_LO12); }
        if (size == 1) { ret R.ok[of.RelocKind, str](of.RK_LDST16_LO12); }
        if (size == 2) { ret R.ok[of.RelocKind, str](of.RK_LDST32_LO12); }
        ret R.ok[of.RelocKind, str](of.RK_LDST64_LO12);
    }
    ret R.err[of.RelocKind, str](bin.name_message(itn, alloc, "macho: undecodable arm64 pageoff12 instruction",
                                                  nil, "macho: undecodable arm64 pageoff12 instruction"));
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret bin.name_message(itn, alloc, "macho: unsupported relocation kind: ",
                         of.reloc_kind_name(kind), "macho: unsupported relocation kind");
}

fun unsupported_section_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret bin.name_message(itn, alloc, "macho: unsupported section-relative relocation kind: ",
                         of.reloc_kind_name(kind), "macho: unsupported section-relative relocation kind");
}

fun unsupported_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u64) str {
    ret bin.number_message(itn, alloc, "macho: unsupported relocation type ",
                           r_type, "macho: unsupported relocation type");
}

fun macho_segname(kind: of.SectionKind) str {
    if (kind == of.SK_TEXT)   { ret "__TEXT"; }
    if (kind == of.SK_RODATA) { ret "__TEXT"; }
    if (kind == of.SK_RELRO)  { ret "__DATA_CONST"; }
    if (kind == of.SK_DEBUG)  { ret "__DWARF"; }
    ret "__DATA";
}

fun macho_sectname(kind: of.SectionKind) str {
    if (kind == of.SK_TEXT)   { ret "__text"; }
    if (kind == of.SK_DATA)   { ret "__data"; }
    if (kind == of.SK_RODATA) { ret "__const"; }
    if (kind == of.SK_RELRO)  { ret "__const"; }
    if (kind == of.SK_BSS)    { ret "__bss"; }
    ret "__debug";
}

fun macho_section_flags(kind: of.SectionKind) u32 {
    if (kind == of.SK_TEXT)  { ret S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS; }
    if (kind == of.SK_BSS)   { ret S_ZEROFILL; }
    if (kind == of.SK_DEBUG) { ret S_ATTR_DEBUG; }
    ret 0;
}

fun exec_section_flags(sec: *of.LoadSection) u32 {
    var f: u32 = macho_section_flags(sec.kind);
    if ((sec.flags & of.SEC_FLAG_INIT_FUNCS) != 0) {
        f = (f & ~SECTION_TYPE) | S_MOD_INIT_FUNC_POINTERS;
    }
    ret f;
}

fun macho_kind_from(flags: u32, is_text: bool, is_data_const: bool, is_rodata: bool) of.SectionKind {
    if ((flags & 0xFF) == S_ZEROFILL)            { ret of.SK_BSS; }
    if ((flags & S_ATTR_PURE_INSTRUCTIONS) != 0) { ret of.SK_TEXT; }
    if ((flags & S_ATTR_DEBUG) != 0)             { ret of.SK_DEBUG; }
    if (is_data_const)                           { ret of.SK_RELRO; }
    if (is_text || is_rodata)                    { ret of.SK_RODATA; }
    ret of.SK_DATA;
}

fun needs_addend_entry(arch_id: u32, kind: of.RelocKind, addend: i64) bool {
    if (!arch_is_arm64(arch_id))                     { ret false; }
    if (addend == 0)                                 { ret false; }
    if (kind == of.RK_ABS64 || kind == of.RK_ABS32) { ret false; }
    ret true;
}

fun reloc_entries_for_section(img: *of.ObjectImage, sec_idx: u32, arch_id: u32) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.reloc_count) {
        if (img.relocations[i].section == sec_idx) {
            n = n + 1;
            if (needs_addend_entry(arch_id, img.relocations[i].kind, img.relocations[i].addend)) { n = n + 1; }
        }
        i = i + 1;
    }
    ret n;
}

fun reloc_sym_index(img: *of.ObjectImage, r: *of.Relocation) R.Result[u32, str] {
    if (r.sym < img.symbol_count) { ret R.ok[u32, str](r.sym); }
    ret R.err[u32, str](bin.name_message(img.interner, img.alloc, "macho: unresolved relocation symbol: ",
                                         bin.resolve_name(img.interner, of.reloc_symbol_name(img, r)), "macho: relocation references an unresolved symbol"));
}

fun validate_reloc_symbols(img: *of.ObjectImage) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: R.Result[u32, str] = reloc_sym_index(img, ?img.relocations[i]);
        if (R.is_err[u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun validate_reloc_kinds(img: *of.ObjectImage, arch_id: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: R.Result[MachoReloc, str] = macho_reloc_for(img.interner, img.alloc, arch_id, img.relocations[i].kind);
        if (R.is_err[MachoReloc, str](r)) { ret R.err[R.Void, str](R.unwrap_err[MachoReloc, str](r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun align_log2(align: u32) u32 {
    var a: u32 = align;
    if (a < 2) { ret 0; }
    var log: u32 = 0;
    for (a > 1) {
        a = a >> 1;
        log = log + 1;
    }
    ret log;
}

fun write_fixed16(buf: *u8, off: usize, s: str) {
    memory.raw_zero((buf::usize + off)::ptr, 16);
    if (s == nil) { ret; }
    var n: usize = str_len(s);
    if (n > 16) { n = 16; }
    var i: usize = 0;
    for (i < n) {
        buf[off + i] = s[i];
        i = i + 1;
    }
}

fun fixed16_equals(buf: *u8, off: usize, s: str) bool {
    val n: usize = str_len(s);
    if (n > 16) { ret false; }
    var i: usize = 0;
    for (i < 16) {
        var expect: u8 = 0;
        if (i < n) { expect = s[i]; }
        if (buf[off + i] != expect) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun write_dwarf_sectname(buf: *u8, off: usize, name: str) {
    memory.raw_zero((buf::usize + off)::ptr, 16);
    if (name == nil) { ret; }
    if (name[0] == '.') {
        buf[off]     = '_';
        buf[off + 1] = '_';
        var i: usize = 1;
        var w: usize = 2;
        for (w < 16 && name[i] != 0) {
            buf[off + w] = name[i];
            i = i + 1;
            w = w + 1;
        }
        ret;
    }
    var n: usize = str_len(name);
    if (n > 16) { n = 16; }
    var j: usize = 0;
    for (j < n) { buf[off + j] = name[j]; j = j + 1; }
}

fun canonical_sectname(raw: str, out: *u8) str {
    if (raw[0] == '_' && raw[1] == '_' && raw[2] == 'd' && raw[3] == 'e' && raw[4] == 'b'
        && raw[5] == 'u' && raw[6] == 'g') {
        out[0] = '.';
        var i: usize = 2;
        var w: usize = 1;
        for (raw[i] != 0) { out[w] = raw[i]; i = i + 1; w = w + 1; }
        out[w] = 0;
        ret out::str;
    }
    var j: usize = 0;
    for (raw[j] != 0) { out[j] = raw[j]; j = j + 1; }
    out[j] = 0;
    ret out::str;
}

fun section_identity(buf: *u8, sh: usize, out: *u8) str {
    var w: usize = 0;
    var i: usize = 0;
    for (i < 16 && buf[sh + 16 + i] != 0) { out[w] = buf[sh + 16 + i]; w = w + 1; i = i + 1; }
    out[w] = ','; w = w + 1;
    i = 0;
    for (i < 16 && buf[sh + i] != 0) { out[w] = buf[sh + i]; w = w + 1; i = i + 1; }
    out[w] = 0;
    ret out::str;
}

fun strtab_size(img: *of.ObjectImage) usize {
    var len: usize = 1;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val name: str = bin.resolve_name(img.interner, img.symbols[i].name);
        if (name != nil) { len = len + str_len(name) + 1; } or { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun is_local_sym(sym: *of.Symbol) bool {
    if (sym.section == of.SECTION_EXTERNAL)        { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret false; }
    ret true;
}

fun is_extdef_sym(sym: *of.Symbol) bool {
    if (sym.section == of.SECTION_EXTERNAL)        { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    ret true;
}

fun write_nlist(buf: *u8, sym_off: usize, str_base: usize, str_pos: *usize,
                img: *of.ObjectImage, idx: u32, sec_addr: *u64, sec_out: *u32) {
    val sym: *of.Symbol = ?img.symbols[idx];
    val name: str = bin.resolve_name(img.interner, sym.name);
    var n_strx: u32 = 0;
    val name_pos: usize = @str_pos;
    if (name != nil) {
        n_strx = name_pos::u32;
        @str_pos = name_pos + bin.write_str(buf, str_base + name_pos, name);
    } or {
        buf[str_base + name_pos] = 0;
        @str_pos = name_pos + 1;
    }
    bin.write_u32_le(buf, sym_off, n_strx);

    var n_type:  u8  = N_UNDF;
    var n_sect:  u8  = 0;
    var n_desc:  u16 = 0;
    var n_value: u64 = 0;
    if (sym.section != of.SECTION_EXTERNAL && sym.section < img.section_count) {
        n_type = N_SECT;
        n_sect = (sec_out[sym.section] + 1)::u8;
        n_value = sec_addr[sym.section] + sym.offset::u64;
        if ((sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0) { n_desc = N_WEAK_DEF; }
    }
    or ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0) {
        n_desc = REFERENCE_FLAG_UNDEFINED_LAZY;
    }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 || sym.section == of.SECTION_EXTERNAL) {
        n_type = n_type | N_EXT;
    }
    buf[sym_off + 4] = n_type;
    buf[sym_off + 5] = n_sect;
    bin.write_u16_le(buf, sym_off + 6, n_desc);
    bin.write_u64_le(buf, sym_off + 8, n_value);
}

fun add_u64_mod(a: u64, b: u64) u64 {
    val max: u64 = 0xFFFFFFFFFFFFFFFF;
    if (a > max - b) { ret a - (max - b) - 1; }
    ret a + b;
}

fun fold_inplace_addend(buf: *u8, field: usize, arch_id: u32, kind: of.RelocKind, addend: i64) {
    if (kind == of.RK_ABS64) {
        if (addend != 0) {
            bin.write_u64_le(buf, field,
                add_u64_mod(bin.read_u64_le(buf, field), addend::u64));
        }
        ret;
    }
    if (kind == of.RK_ABS32) {
        if (addend != 0) { bin.write_u32_le(buf, field, bin.read_u32_le(buf, field) + (addend::u64)::u32); }
        ret;
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        val eff64: u64 = add_u64_mod(addend::u64, 8);
        if (eff64 != 0) {
            bin.write_u64_le(buf, field,
                add_u64_mod(bin.read_u64_le(buf, field), eff64));
        }
        ret;
    }
    if (arch_is_arm64(arch_id)) { ret; }
    val eff: i64 = addend + 4;
    if (eff != 0) { bin.write_u32_le(buf, field, bin.read_u32_le(buf, field) + (eff::u64)::u32); }
}

fun write_reloc_info(buf: *u8, off: usize, address: u32, symnum: u32, pcrel: u32, length: u32, extn: u32, r_type: u32) {
    bin.write_u32_le(buf, off, address);
    val word: u32 = (symnum & 0xFFFFFF) | (pcrel << 24) | (length << 25) | (extn << 27) | (r_type << 28);
    bin.write_u32_le(buf, off + 4, word);
}

rec MachoOutSec {
    kind:   of.SectionKind;
    srcsec: u32;
    addr:   u64;
    size:   u64;
    fileo:  usize;
    align:  u32;
    reloff: usize;
    nrel:   u32;
}

fun emit_object(isa_vt: *of.ObjectTarget, img: *of.ObjectImage, path: *u8) R.Result[R.Void, str] {
    if (isa_vt == nil || img == nil || path == nil) {
        ret R.err[R.Void, str]("macho: nil writer argument");
    }
    val arch_id: u32 = isa_vt.arch_id;
    val ct: R.Result[u32, str] = cpu_type_for(arch_id);
    if (R.is_err[u32, str](ct)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ct)); }

    val vrs: R.Result[R.Void, str] = validate_reloc_symbols(img);
    if (R.is_err[R.Void, str](vrs)) { ret vrs; }
    val vrk: R.Result[R.Void, str] = validate_reloc_kinds(img, arch_id);
    if (R.is_err[R.Void, str](vrk)) { ret vrk; }

    val alloc:    *A.Allocator = img.alloc;
    val num_secs: u32 = img.section_count;
    val num_syms: u32 = img.symbol_count;

    var nd_order: [4]of.SectionKind;
    nd_order[0] = of.SK_TEXT;
    nd_order[1] = of.SK_RODATA;
    nd_order[2] = of.SK_RELRO;
    nd_order[3] = of.SK_DATA;

    var num_out: u32 = 0;
    var ci: u32 = 0;
    for (ci < 4) {
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (img.sections[sp].kind == nd_order[ci]) { num_out = num_out + 1; brk; }
            sp = sp + 1;
        }
        ci = ci + 1;
    }
    var sp_dbg: u32 = 0;
    for (sp_dbg < num_secs) {
        if (img.sections[sp_dbg].kind == of.SK_DEBUG) { num_out = num_out + 1; }
        sp_dbg = sp_dbg + 1;
    }
    var has_bss: bool = false;
    var sp_bss: u32 = 0;
    for (sp_bss < num_secs) {
        if (img.sections[sp_bss].kind == of.SK_BSS) { has_bss = true; brk; }
        sp_bss = sp_bss + 1;
    }
    if (has_bss) { num_out = num_out + 1; }

    val seg_cmd_size: usize = SEGMENT_CMD_64_SIZE + num_out::usize * SECTION_64_SIZE;
    val sizeofcmds:   usize = seg_cmd_size + SYMTAB_CMD_SIZE + DYSYMTAB_CMD_SIZE;
    val header_end:   usize = MACH_HEADER_64_SIZE + sizeofcmds;

    val res_addr: R.Result[*u64, str] = A.zallocate[u64](alloc, (num_secs + 1)::usize);
    if (R.is_err[*u64, str](res_addr)) { ret R.err[R.Void, str]("macho: section address table alloc failed"); }
    var sec_addr: *u64 = R.unwrap_ok[*u64, str](res_addr);

    val res_doff: R.Result[*usize, str] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (R.is_err[*usize, str](res_doff)) {
        A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("macho: section offset table alloc failed");
    }
    var data_off: *usize = R.unwrap_ok[*usize, str](res_doff);

    val res_s2o: R.Result[*u32, str] = A.zallocate[u32](alloc, (num_secs + 1)::usize);
    if (R.is_err[*u32, str](res_s2o)) {
        A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, data_off, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("macho: section map alloc failed");
    }
    var sec_to_out: *u32 = R.unwrap_ok[*u32, str](res_s2o);

    val res_out: R.Result[*MachoOutSec, str] = A.zallocate[MachoOutSec](alloc, num_out::usize);
    if (R.is_err[*MachoOutSec, str](res_out)) {
        A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, data_off, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, sec_to_out, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("macho: output section table alloc failed");
    }
    var out: *MachoOutSec = R.unwrap_ok[*MachoOutSec, str](res_out);

    var no: u32 = 0;
    ci = 0;
    for (ci < 4) {
        var present: bool = false;
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (img.sections[sp].kind == nd_order[ci]) { present = true; brk; }
            sp = sp + 1;
        }
        if (present) {
            out[no].kind   = nd_order[ci];
            out[no].srcsec = 0xFFFFFFFF;
            sp = 0;
            for (sp < num_secs) {
                if (img.sections[sp].kind == nd_order[ci]) { sec_to_out[sp] = no; }
                sp = sp + 1;
            }
            no = no + 1;
        }
        ci = ci + 1;
    }
    var sp_d: u32 = 0;
    for (sp_d < num_secs) {
        if (img.sections[sp_d].kind == of.SK_DEBUG) {
            out[no].kind   = of.SK_DEBUG;
            out[no].srcsec = sp_d;
            sec_to_out[sp_d] = no;
            no = no + 1;
        }
        sp_d = sp_d + 1;
    }
    if (has_bss) {
        out[no].kind   = of.SK_BSS;
        out[no].srcsec = 0xFFFFFFFF;
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (img.sections[sp].kind == of.SK_BSS) { sec_to_out[sp] = no; }
            sp = sp + 1;
        }
        no = no + 1;
    }

    var vm: u64 = 0;
    var s:  u32 = 0;
    var ko: u32 = 0;
    for (ko < num_out) {
        var a_sec: u32 = 1;
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] == ko && img.sections[sp].align > a_sec) { a_sec = img.sections[sp].align; }
            sp = sp + 1;
        }
        out[ko].align = a_sec;
        vm = bin.align_up_u64(vm, a_sec::u64);
        out[ko].addr = vm;
        sp = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] != ko) { sp = sp + 1; cnt; }
            var a: u32 = img.sections[sp].align;
            if (a < 1) { a = 1; }
            vm = bin.align_up_u64(vm, a::u64);
            sec_addr[sp] = vm;
            vm = vm + img.sections[sp].len::u64;
            sp = sp + 1;
        }
        out[ko].size = vm - out[ko].addr;
        ko = ko + 1;
    }
    val seg_vmsize: u64 = vm;

    val seg_fileoff: usize = bin.align_up(header_end, 8);
    var file: usize = seg_fileoff;
    ko = 0;
    for (ko < num_out) {
        var sp: u32 = 0;
        if (out[ko].kind == of.SK_BSS) {
            out[ko].fileo = 0;
            for (sp < num_secs) {
                if (img.sections[sp].kind == of.SK_BSS) { data_off[sp] = 0; }
                sp = sp + 1;
            }
            ko = ko + 1;
            cnt;
        }
        file = bin.align_up(file, out[ko].align::usize);
        out[ko].fileo = file;
        for (sp < num_secs) {
            if (sec_to_out[sp] != ko) { sp = sp + 1; cnt; }
            data_off[sp] = out[ko].fileo + (sec_addr[sp] - out[ko].addr)::usize;
            sp = sp + 1;
        }
        file = out[ko].fileo + out[ko].size::usize;
        ko = ko + 1;
    }
    val seg_filesize: usize = file - seg_fileoff;

    var roff: usize = bin.align_up(file, 4);
    ko = 0;
    for (ko < num_out) {
        var n: u32 = 0;
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] == ko) { n = n + reloc_entries_for_section(img, sp, arch_id); }
            sp = sp + 1;
        }
        out[ko].nrel = n;
        if (n > 0) { out[ko].reloff = roff; roff = roff + n::usize * RELOC_INFO_SIZE; }
        or         { out[ko].reloff = 0; }
        ko = ko + 1;
    }

    val symtab_off: usize = bin.align_up(roff, 8);
    val symtab_sz:  usize = num_syms::usize * NLIST_64_SIZE;
    val strtab_off: usize = symtab_off + symtab_sz;
    val strtab_sz:  usize = strtab_size(img);
    val total_size: usize = strtab_off + strtab_sz;

    var lay: bin.Layout;
    bin.layout_init(?lay);
    bin.layout_region(?lay, "mach header and load commands", 0, header_end);
    bin.layout_pad(?lay, "segment alignment", seg_fileoff);
    ko = 0;
    for (ko < num_out) {
        if (out[ko].kind != of.SK_BSS) {
            bin.layout_pad(?lay, "section alignment", out[ko].fileo);
            bin.layout_region(?lay, "section data", out[ko].fileo, out[ko].size::usize);
        }
        ko = ko + 1;
    }
    bin.layout_pad(?lay, "relocation alignment", bin.align_up(file, 4));
    ko = 0;
    for (ko < num_out) {
        if (out[ko].nrel > 0) {
            bin.layout_region(?lay, "relocations", out[ko].reloff,
                              out[ko].nrel::usize * RELOC_INFO_SIZE);
        }
        ko = ko + 1;
    }
    bin.layout_pad(?lay, "symbol table alignment", symtab_off);
    bin.layout_region(?lay, "symbol table", symtab_off, symtab_sz);
    bin.layout_region(?lay, "string table", strtab_off, strtab_sz);
    val sealed: R.Result[R.Void, str] = bin.layout_seal(?lay, alloc, "macho", total_size);
    if (R.is_err[R.Void, str](sealed)) {
        A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, data_off, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, sec_to_out, (num_secs + 1)::usize);
        A.deallocate[MachoOutSec](alloc, out, num_out::usize);
        ret sealed;
    }

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, data_off, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, sec_to_out, (num_secs + 1)::usize);
        A.deallocate[MachoOutSec](alloc, out, num_out::usize);
        ret R.err[R.Void, str]("macho: output buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    bin.write_u32_le(buf, 0, MH_MAGIC_64);
    bin.write_u32_le(buf, 4, R.unwrap_ok[u32, str](ct));
    bin.write_u32_le(buf, 8, cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, MH_OBJECT);
    bin.write_u32_le(buf, 16, 3);
    bin.write_u32_le(buf, 20, sizeofcmds::u32);
    bin.write_u32_le(buf, 24, 0);
    bin.write_u32_le(buf, 28, 0);

    var lc: usize = MACH_HEADER_64_SIZE;
    bin.write_u32_le(buf, lc, LC_SEGMENT_64);
    bin.write_u32_le(buf, lc + 4, seg_cmd_size::u32);
    write_fixed16(buf, lc + 8, nil);
    bin.write_u64_le(buf, lc + 24, 0);
    bin.write_u64_le(buf, lc + 32, seg_vmsize);
    bin.write_u64_le(buf, lc + 40, seg_fileoff::u64);
    bin.write_u64_le(buf, lc + 48, seg_filesize::u64);
    bin.write_u32_le(buf, lc + 56, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE);
    bin.write_u32_le(buf, lc + 60, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE);
    bin.write_u32_le(buf, lc + 64, num_out);
    bin.write_u32_le(buf, lc + 68, 0);

    var sh: usize = lc + SEGMENT_CMD_64_SIZE;
    ko = 0;
    for (ko < num_out) {
        if (out[ko].kind == of.SK_DEBUG) {
            write_dwarf_sectname(buf, sh, bin.resolve_name(img.interner, img.sections[out[ko].srcsec].name));
        }
        or {
            write_fixed16(buf, sh, macho_sectname(out[ko].kind));
        }
        write_fixed16(buf, sh + 16, macho_segname(out[ko].kind));
        bin.write_u64_le(buf, sh + 32, out[ko].addr);
        bin.write_u64_le(buf, sh + 40, out[ko].size);
        var foff: u32 = 0;
        if (out[ko].kind != of.SK_BSS) { foff = out[ko].fileo::u32; }
        bin.write_u32_le(buf, sh + 48, foff);
        bin.write_u32_le(buf, sh + 52, align_log2(out[ko].align));
        bin.write_u32_le(buf, sh + 56, out[ko].reloff::u32);
        bin.write_u32_le(buf, sh + 60, out[ko].nrel);
        bin.write_u32_le(buf, sh + 64, macho_section_flags(out[ko].kind));
        bin.write_u32_le(buf, sh + 68, 0);
        bin.write_u32_le(buf, sh + 72, 0);
        bin.write_u32_le(buf, sh + 76, 0);
        sh = sh + SECTION_64_SIZE;
        ko = ko + 1;
    }

    var n_local:  u32 = 0;
    var n_extdef: u32 = 0;
    var n_undef:  u32 = 0;
    var symi: u32 = 0;
    for (symi < num_syms) {
        if (is_local_sym(?img.symbols[symi]))  { n_local = n_local + 1; }
        or (is_extdef_sym(?img.symbols[symi])) { n_extdef = n_extdef + 1; }
        or                                     { n_undef = n_undef + 1; }
        symi = symi + 1;
    }

    val symtab_lc: usize = lc + seg_cmd_size;
    bin.write_u32_le(buf, symtab_lc, LC_SYMTAB);
    bin.write_u32_le(buf, symtab_lc + 4, SYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, symtab_lc + 8, symtab_off::u32);
    bin.write_u32_le(buf, symtab_lc + 12, num_syms);
    bin.write_u32_le(buf, symtab_lc + 16, strtab_off::u32);
    bin.write_u32_le(buf, symtab_lc + 20, strtab_sz::u32);

    val dysym_lc: usize = symtab_lc + SYMTAB_CMD_SIZE;
    bin.write_u32_le(buf, dysym_lc, LC_DYSYMTAB);
    bin.write_u32_le(buf, dysym_lc + 4, DYSYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, dysym_lc + 8, 0);
    bin.write_u32_le(buf, dysym_lc + 12, n_local);
    bin.write_u32_le(buf, dysym_lc + 16, n_local);
    bin.write_u32_le(buf, dysym_lc + 20, n_extdef);
    bin.write_u32_le(buf, dysym_lc + 24, n_local + n_extdef);
    bin.write_u32_le(buf, dysym_lc + 28, n_undef);

    s = 0;
    for (s < num_secs) {
        if (img.sections[s].kind != of.SK_BSS && img.sections[s].bytes != nil && img.sections[s].len > 0) {
            memory.raw_copy((buf::usize + data_off[s])::ptr, img.sections[s].bytes::ptr, img.sections[s].len::usize);
        }
        s = s + 1;
    }

    var fi: u32 = 0;
    for (fi < img.reloc_count) {
        val rsec: u32 = img.relocations[fi].section;
        if (rsec < num_secs && img.sections[rsec].kind != of.SK_BSS) {
            val field: usize = data_off[rsec] + img.relocations[fi].offset::usize;
            fold_inplace_addend(buf, field, arch_id, img.relocations[fi].kind, img.relocations[fi].addend);
        }
        fi = fi + 1;
    }

    var remap: *u32 = nil;
    if (num_syms > 0) {
        val res_remap: R.Result[*u32, str] = A.zallocate[u32](alloc, num_syms::usize);
        if (R.is_err[*u32, str](res_remap)) {
            A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
            A.deallocate[usize](alloc, data_off, (num_secs + 1)::usize);
            A.deallocate[u32](alloc, sec_to_out, (num_secs + 1)::usize);
            A.deallocate[MachoOutSec](alloc, out, num_out::usize);
            A.deallocate[u8](alloc, buf, total_size);
            ret R.err[R.Void, str]("macho: symbol remap alloc failed");
        }
        remap = R.unwrap_ok[*u32, str](res_remap);
    }

    var sym_off: usize = symtab_off;
    var str_pos: usize = 1;
    buf[strtab_off] = 0;
    var nlist_idx: u32 = 0;
    symi = 0;
    for (symi < num_syms) {
        if (!is_local_sym(?img.symbols[symi])) { symi = symi + 1; cnt; }
        if (remap != nil) { remap[symi] = nlist_idx; }
        write_nlist(buf, sym_off, strtab_off, ?str_pos, img, symi, sec_addr, sec_to_out);
        sym_off = sym_off + NLIST_64_SIZE;
        nlist_idx = nlist_idx + 1;
        symi = symi + 1;
    }
    symi = 0;
    for (symi < num_syms) {
        if (!is_extdef_sym(?img.symbols[symi])) { symi = symi + 1; cnt; }
        if (remap != nil) { remap[symi] = nlist_idx; }
        write_nlist(buf, sym_off, strtab_off, ?str_pos, img, symi, sec_addr, sec_to_out);
        sym_off = sym_off + NLIST_64_SIZE;
        nlist_idx = nlist_idx + 1;
        symi = symi + 1;
    }
    symi = 0;
    for (symi < num_syms) {
        if (img.symbols[symi].section != of.SECTION_EXTERNAL) { symi = symi + 1; cnt; }
        if (remap != nil) { remap[symi] = nlist_idx; }
        write_nlist(buf, sym_off, strtab_off, ?str_pos, img, symi, sec_addr, sec_to_out);
        sym_off = sym_off + NLIST_64_SIZE;
        nlist_idx = nlist_idx + 1;
        symi = symi + 1;
    }

    ko = 0;
    for (ko < num_out) {
        if (out[ko].reloff == 0) { ko = ko + 1; cnt; }
        var ro: usize = out[ko].reloff;
        var sp: u32 = 0;
        for (sp < num_secs) {
            if (sec_to_out[sp] != ko) { sp = sp + 1; cnt; }
            val base: u32 = (sec_addr[sp] - out[ko].addr)::u32;
            var ri: u32 = 0;
            for (ri < img.reloc_count) {
                if (img.relocations[ri].section == sp) {
                    val radr: u32 = base + img.relocations[ri].offset;
                    val rsi: u32 = R.unwrap_ok[u32, str](reloc_sym_index(img, ?img.relocations[ri]));
                    val symnum: u32 = remap[rsi];
                    val mr: MachoReloc = R.unwrap_ok[MachoReloc, str](macho_reloc_for(img.interner, alloc, arch_id, img.relocations[ri].kind));
                    if (needs_addend_entry(arch_id, img.relocations[ri].kind, img.relocations[ri].addend)) {
                        write_reloc_info(buf, ro, radr, (img.relocations[ri].addend::u64)::u32 & 0xFFFFFF,
                                         0, 2, 0, ARM64_RELOC_ADDEND);
                        ro = ro + RELOC_INFO_SIZE;
                    }
                    write_reloc_info(buf, ro, radr, symnum, mr.pcrel, mr.length, 1, mr.r_type);
                    ro = ro + RELOC_INFO_SIZE;
                }
                ri = ri + 1;
            }
            sp = sp + 1;
        }
        ko = ko + 1;
    }

    if (remap != nil) { A.deallocate[u32](alloc, remap, num_syms::usize); }
    A.deallocate[u64](alloc, sec_addr, (num_secs + 1)::usize);
    A.deallocate[usize](alloc, data_off, (num_secs + 1)::usize);
    A.deallocate[u32](alloc, sec_to_out, (num_secs + 1)::usize);
    A.deallocate[MachoOutSec](alloc, out, num_out::usize);

    val wr: R.Result[R.Void, str] = write_file(img.interner, alloc, path, buf, total_size, "macho: object");
    A.deallocate[u8](alloc, buf, total_size);
    ret wr;
}

fun write_file(itn: *intern.Interner, alloc: *A.Allocator, path: *u8, buf: *u8, len: usize, label: str) R.Result[R.Void, str] {
    ret publication.bytes(itn, alloc, path::str, buf, len, 0o755, publication.REPLACE, publication.PARENTS_EXIST, label, "macho: could not publish output file", nil);
}

test "mach.lang.target.of.macho.emit_object:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [17]u8;
    var k: usize = 0;
    for (k < 17) { text_bytes[k] = 0x90; k = k + 1; }
    var data_bytes: [3]u8;
    data_bytes[0] = 1; data_bytes[1] = 2; data_bytes[2] = 3;

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, "__text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 17; secs[0].align = 16;
    secs[1].name = t_intern(?i, "__data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 3; secs[1].align = 8;
    secs[2].name = t_intern(?i, "__bss"); secs[2].kind = of.SK_BSS;
    secs[2].bytes = nil; secs[2].len = 64; secs[2].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 17; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "_gvar"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 3; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_size");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 2; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 3; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val ncmds: u32 = bin.read_u32_le(buf.data, 16);
    var lc: usize = MACH_HEADER_64_SIZE;
    var found: bool = false;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd:  u32   = bin.read_u32_le(buf.data, lc);
        val size: usize = bin.read_u32_le(buf.data, lc + 4)::usize;
        if (size == 0) { ret 4; }
        if (cmd == LC_SYMTAB) {
            val stroff:  usize = bin.read_u32_le(buf.data, lc + 16)::usize;
            val strsize: usize = bin.read_u32_le(buf.data, lc + 20)::usize;
            if (stroff + strsize != buf.len) { ret 5; }
            found = true;
        }
        lc = lc + size;
        c = c + 1;
    }
    if (!found) { ret 6; }
    ret 0;
}

pub fun register_macho(reg: *of.OfRegistry) R.Result[R.Void, str] {
    var macho_vtable: of.OfVTable = of.linker_vtable(
        of.OF_MACHO, of.of_name_for(of.OF_MACHO), "o", emit_object, parse_object, emit_exec
    );
    of.with_dynamic_exec(?macho_vtable, emit_dyn_exec);

    macho_vtable.two_level_namespace = true;

    macho_vtable.default_debug    = "dwarf";
    macho_vtable.shared_input_ext = ".dylib";
    macho_vtable.import_address_prefix = "";
    macho_vtable.header_in_first_segment = true;
    macho_vtable.carries_stack_size = true;
    macho_vtable.default_stack_reserve = 0;
    macho_vtable.header_span = header_span;
    macho_vtable.executable_section_location = nil;

    macho_vtable.covers_isa_any   = false;
    macho_vtable.covers_isa_count = 0;
    of.cover_isa(?macho_vtable, isa.ARCH_X86_64);
    of.cover_isa(?macho_vtable, isa.ARCH_AARCH64);

    ret of.register(reg, ?macho_vtable);
}

fun vm_prot_for(flags: u32) u32 {
    var p: u32 = 0;
    if ((flags & of.SEG_FLAG_READ) != 0)    { p = p | VM_PROT_READ; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { p = p | VM_PROT_WRITE; }
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { p = p | VM_PROT_EXECUTE; }
    if (p == 0)                             { p = VM_PROT_READ; }
    ret p;
}

fun exec_segname(flags: u32, rebased: bool) str {
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { ret "__TEXT"; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { ret "__DATA"; }
    if (rebased)                            { ret "__DATA_CONST"; }
    ret "__RODATA";
}

fun codesign_ident_len(name: *u8) usize {
    if (name == nil) { ret 0; }
    ret str_len(name::str);
}

fun codesign_code_slots(code_limit: usize) usize {
    ret (code_limit + CODE_SIG_PAGE_SIZE - 1) / CODE_SIG_PAGE_SIZE;
}

fun codedir_blob_size(ident_len: usize, code_limit: usize) usize {
    ret CODEDIR_HEADER_SIZE + ident_len + 1 + codesign_code_slots(code_limit) * CS_HASH_SIZE_SHA256::usize;
}

fun code_signature_size(ident_len: usize, code_limit: usize) usize {
    ret SUPERBLOB_HEADER_SIZE + codedir_blob_size(ident_len, code_limit);
}

fun write_code_signature(buf: *u8, sig_off: usize, name: *u8, code_limit: usize,
                         exec_base: u64, exec_limit: u64) {
    val ident_len:   usize = codesign_ident_len(name);
    val n_slots:     usize = codesign_code_slots(code_limit);
    val cd_size:     usize = codedir_blob_size(ident_len, code_limit);
    val sig_size:    usize = SUPERBLOB_HEADER_SIZE + cd_size;

    bin.write_u32_be(buf, sig_off,      CSMAGIC_EMBEDDED_SIGNATURE);
    bin.write_u32_be(buf, sig_off + 4,  sig_size::u32);
    bin.write_u32_be(buf, sig_off + 8,  1);
    bin.write_u32_be(buf, sig_off + 12, CSSLOT_CODEDIRECTORY);
    bin.write_u32_be(buf, sig_off + 16, SUPERBLOB_HEADER_SIZE::u32);

    val cd:        usize = sig_off + SUPERBLOB_HEADER_SIZE;
    val ident_off: usize = CODEDIR_HEADER_SIZE;
    val hash_off:  usize = CODEDIR_HEADER_SIZE + ident_len + 1;

    bin.write_u32_be(buf, cd,      CSMAGIC_CODEDIRECTORY);
    bin.write_u32_be(buf, cd + 4,  cd_size::u32);
    bin.write_u32_be(buf, cd + 8,  CS_CODEDIRECTORY_VERSION);
    bin.write_u32_be(buf, cd + 12, CS_ADHOC_FLAG | CS_LINKER_SIGNED_FLAG);
    bin.write_u32_be(buf, cd + 16, hash_off::u32);
    bin.write_u32_be(buf, cd + 20, ident_off::u32);
    bin.write_u32_be(buf, cd + 24, 0);
    bin.write_u32_be(buf, cd + 28, n_slots::u32);
    bin.write_u32_be(buf, cd + 32, code_limit::u32);
    buf[cd + 36] = CS_HASH_SIZE_SHA256;
    buf[cd + 37] = CS_HASHTYPE_SHA256;
    buf[cd + 38] = 0;
    buf[cd + 39] = CS_PAGE_SHIFT;
    bin.write_u32_be(buf, cd + 40, 0);
    bin.write_u32_be(buf, cd + 44, 0);
    bin.write_u32_be(buf, cd + 48, 0);
    bin.write_u32_be(buf, cd + 52, 0);
    bin.write_u64_be(buf, cd + 56, 0);
    bin.write_u64_be(buf, cd + 64, exec_base);
    bin.write_u64_be(buf, cd + 72, exec_limit);
    bin.write_u64_be(buf, cd + 80, CS_EXECSEG_MAIN_BINARY);

    var k: usize = 0;
    for (k < ident_len) {
        buf[cd + ident_off + k] = name[k];
        k = k + 1;
    }
    buf[cd + ident_off + ident_len] = 0;

    var slot: usize = 0;
    for (slot < n_slots) {
        val page_off: usize = slot * CODE_SIG_PAGE_SIZE;
        var page_len: usize = CODE_SIG_PAGE_SIZE;
        if (page_off + page_len > code_limit) { page_len = code_limit - page_off; }
        sha256.hash(?buf[page_off], page_len, ?buf[cd + hash_off + slot * CS_HASH_SIZE_SHA256::usize]);
        slot = slot + 1;
    }
}

rec MachoDwarf {
    present:  bool;
    seg_foff: usize;
    seg_size: usize;
    end:      usize;
    sec_offs: *usize;
}

fun macho_dwarf_cmd_bytes(debug_count: u32) usize {
    if (debug_count == 0) { ret 0; }
    ret SEGMENT_CMD_64_SIZE + debug_count::usize * SECTION_64_SIZE;
}

fun macho_dwarf_plan(alloc: *A.Allocator, debug: *of.Section, debug_count: u32,
                     base: usize, segment_align: usize) R.Result[MachoDwarf, str] {
    var d: MachoDwarf;
    d.present = false; d.seg_foff = 0; d.seg_size = 0; d.end = base; d.sec_offs = nil;
    if (debug_count == 0) { ret R.ok[MachoDwarf, str](d); }

    val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, debug_count::usize);
    if (R.is_err[*usize, str](ro)) { ret R.err[MachoDwarf, str](R.unwrap_err[*usize, str](ro)); }
    d.sec_offs = R.unwrap_ok[*usize, str](ro);

    val seg_foff: usize = bin.align_up(base, segment_align);
    var cur: usize = seg_foff;
    var di: u32 = 0;
    for (di < debug_count) {
        var a: u32 = debug[di].align;
        if (a == 0) { a = 1; }
        cur = bin.align_up(cur, a::usize);
        d.sec_offs[di] = cur;
        cur = cur + debug[di].len::usize;
        di = di + 1;
    }
    d.present  = true;
    d.seg_foff = seg_foff;
    d.seg_size = cur - seg_foff;
    d.end      = cur;
    ret R.ok[MachoDwarf, str](d);
}

fun macho_dwarf_write(buf: *u8, itn: *intern.Interner, debug: *of.Section, debug_count: u32,
                      lc: usize, d: *MachoDwarf, vmaddr: u64) usize {
    if (!d.present) { ret lc; }
    val cmdsize: usize = SEGMENT_CMD_64_SIZE + debug_count::usize * SECTION_64_SIZE;
    bin.write_u32_le(buf, lc, LC_SEGMENT_64);
    bin.write_u32_le(buf, lc + 4, cmdsize::u32);
    write_fixed16(buf, lc + 8, "__DWARF");
    bin.write_u64_le(buf, lc + 24, vmaddr);
    bin.write_u64_le(buf, lc + 32, 0);
    bin.write_u64_le(buf, lc + 40, d.seg_foff::u64);
    bin.write_u64_le(buf, lc + 48, d.seg_size::u64);
    bin.write_u32_le(buf, lc + 56, VM_PROT_READ);
    bin.write_u32_le(buf, lc + 60, VM_PROT_READ);
    bin.write_u32_le(buf, lc + 64, debug_count);
    bin.write_u32_le(buf, lc + 68, 0);

    var sh: usize = lc + SEGMENT_CMD_64_SIZE;
    var di: u32 = 0;
    for (di < debug_count) {
        write_dwarf_sectname(buf, sh, bin.resolve_name(itn, debug[di].name));
        write_fixed16(buf, sh + 16, "__DWARF");
        bin.write_u64_le(buf, sh + 32, 0);
        bin.write_u64_le(buf, sh + 40, debug[di].len::u64);
        bin.write_u32_le(buf, sh + 48, d.sec_offs[di]::u32);
        bin.write_u32_le(buf, sh + 52, align_log2(debug[di].align));
        bin.write_u32_le(buf, sh + 56, 0);
        bin.write_u32_le(buf, sh + 60, 0);
        bin.write_u32_le(buf, sh + 64, S_ATTR_DEBUG);
        bin.write_u32_le(buf, sh + 68, 0);
        bin.write_u32_le(buf, sh + 72, 0);
        bin.write_u32_le(buf, sh + 76, 0);
        sh = sh + SECTION_64_SIZE;
        di = di + 1;
    }
    ret lc + cmdsize;
}

fun macho_dwarf_write_bytes(buf: *u8, debug: *of.Section, debug_count: u32, d: *MachoDwarf) {
    if (!d.present) { ret; }
    var di: u32 = 0;
    for (di < debug_count) {
        if (debug[di].bytes != nil && debug[di].len > 0) {
            memory.raw_copy((buf::usize + d.sec_offs[di])::ptr, debug[di].bytes::ptr, debug[di].len::usize);
        }
        di = di + 1;
    }
}

fun macho_dwarf_free(alloc: *A.Allocator, d: *MachoDwarf, debug_count: u32) {
    if (d.sec_offs != nil) { A.deallocate[usize](alloc, d.sec_offs, debug_count::usize); }
    d.sec_offs = nil;
}

fun header_span(shape: *of.HeaderShape, page: u64) u64 {
    if (shape == nil) { ret page; }

    var seg_cmds:   u32 = shape.seg_count + 2;
    var sect_total: u32 = shape.sect_count;
    if (shape.imports) {
        seg_cmds   = seg_cmds + 2;
        sect_total = sect_total + 2;
    }

    var entry_cmd: usize = 16 + ARM_THREAD_STATE64_COUNT::usize * 4;
    if (16 + X86_THREAD_STATE64_COUNT::usize * 4 > entry_cmd) {
        entry_cmd = 16 + X86_THREAD_STATE64_COUNT::usize * 4;
    }
    if (ENTRY_POINT_CMD_SIZE > entry_cmd) { entry_cmd = ENTRY_POINT_CMD_SIZE; }

    var size: usize = MACH_HEADER_64_SIZE
                    + seg_cmds::usize * SEGMENT_CMD_64_SIZE
                    + sect_total::usize * SECTION_64_SIZE
                    + DYLD_INFO_CMD_SIZE + SYMTAB_CMD_SIZE + DYSYMTAB_CMD_SIZE
                    + dylinker_cmd_size() + entry_cmd + LINKEDIT_DATA_CMD_SIZE
                    + BUILD_VERSION_CMD_SIZE + UUID_CMD_SIZE
                    + macho_dwarf_cmd_bytes(shape.debug_count);

    var i: u32 = 0;
    for (i < shape.lib_count) {
        size = size + dylib_cmd_size(bin.resolve_name(shape.itn, shape.libs[i].soname));
        if (shape.libs[i].rpath != intern.STR_NIL
            && !rpath_seen_before(shape.libs, i, shape.libs[i].rpath)) {
            size = size + rpath_cmd_size(bin.resolve_name(shape.itn, shape.libs[i].rpath));
        }
        i = i + 1;
    }

    ret bin.align_up_u64(size::u64, page);
}

fun reserved_header_span(segs: *of.LoadSegment, seg_count: u32,
                         image_base: u64) R.Result[usize, str] {
    if (seg_count == 0 || segs == nil) {
        ret R.err[usize, str]("macho: image has no load segments to map the header into");
    }
    if (segs[0].vaddr <= image_base) {
        ret R.err[usize, str]("macho: base address too low to map the header");
    }
    ret R.ok[usize, str]((segs[0].vaddr - image_base)::usize);
}

fun refuse_unixthread_stack(opts: *of.ImageOptions) R.Result[R.Void, str] {
    if (opts.stack_reserve == 0 && opts.stack_commit == 0) { ret R.ok_void[str](); }
    ret R.err[R.Void, str]("macho: a stack size needs an LC_MAIN entry, and this image enters through LC_UNIXTHREAD; `stack_reserve` / `stack_commit` reach only a position-independent Mach-O image");
}

fun emit_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
              seg_count: u32, page_size: u64, image_base: u64, entry: u64,
              funcs: *of.ExecFunction, func_count: u32,
              exceptions: *of.Section, exception_count: u32,
              debug: *of.Section, debug_count: u32,
              symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
              image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (isa_vt == nil) { ret R.err[R.Void, str]("macho: nil exec isa"); }
    if (path == nil)   { ret R.err[R.Void, str]("macho: nil exec path"); }
    val su: R.Result[R.Void, str] = refuse_unixthread_stack(?image_options);
    if (R.is_err[R.Void, str](su)) { ret su; }
    val arch_id: u32 = isa_vt.arch_id;
    val ct: R.Result[u32, str] = cpu_type_for(arch_id);
    if (R.is_err[u32, str](ct)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ct)); }
    val exec_page: u64 = macho_page_size(arch_id);

    val have_dwarf: bool = debug_count > 0;

    val has_pagezero: bool = image_base > 0;
    var ncmds: u32 = frame_cmd_count(nil::*of.DynamicInfo, segs, seg_count, has_pagezero) + 3;
    if (have_dwarf) { ncmds = ncmds + 1; }

    var thread_state: usize = X86_THREAD_STATE64_COUNT::usize * 4;
    if (arch_is_arm64(arch_id)) { thread_state = ARM_THREAD_STATE64_COUNT::usize * 4; }
    val thread_cmd_size: usize = 16 + thread_state;

    var sizeofcmds: usize = frame_cmd_bytes(nil::*of.DynamicInfo, segs, seg_count, has_pagezero)
                          + thread_cmd_size
                          + SEGMENT_CMD_64_SIZE + LINKEDIT_DATA_CMD_SIZE;
    sizeofcmds = sizeofcmds + macho_dwarf_cmd_bytes(debug_count);
    val header_end: usize = MACH_HEADER_64_SIZE + sizeofcmds;

    val hs: R.Result[usize, str] = reserved_header_span(segs, seg_count, image_base);
    if (R.is_err[usize, str](hs)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](hs)); }
    val hdr_span: usize = R.unwrap_ok[usize, str](hs);
    if (header_end > hdr_span) {
        ret R.err[R.Void, str]("macho: exec header exceeds the linker's reservation");
    }
    val text_va:       u64 = segs[0].vaddr - hdr_span::u64;
    val pagezero_size: u64 = text_va;

    val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, seg_count::usize);
    if (R.is_err[*usize, str](ro)) { ret R.err[R.Void, str]("macho: exec offset table alloc failed"); }
    val seg_offsets: *usize = R.unwrap_ok[*usize, str](ro);

    var total_size: usize = hdr_span;
    var li: u32 = 0;
    for (li < seg_count) {
        total_size = bin.align_up(total_size, exec_page::usize);
        seg_offsets[li] = total_size;
        total_size = total_size + segs[li].filesz;
        li = li + 1;
    }

    var hi_va: u64 = 0;
    li = 0;
    for (li < seg_count) {
        val end: u64 = segs[li].vaddr + bin.align_up_u64(segs[li].memsz::u64, exec_page);
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }

    var dw: MachoDwarf;
    val dwp: R.Result[MachoDwarf, str] =
        macho_dwarf_plan(alloc, debug, debug_count, total_size, macho_page_size(arch_id)::usize);
    if (R.is_err[MachoDwarf, str](dwp)) {
        A.deallocate[usize](alloc, seg_offsets, seg_count::usize);
        ret R.err[R.Void, str](R.unwrap_err[MachoDwarf, str](dwp));
    }
    dw = R.unwrap_ok[MachoDwarf, str](dwp);
    total_size = dw.end;

    val exec_base:  u64 = 0;
    val exec_limit: u64 = hdr_span::u64 + segs[0].filesz::u64;

    val ident_len:     usize = codesign_ident_len(name);
    val linkedit_off:  usize = bin.align_up(total_size, exec_page::usize);
    val code_limit:    usize = linkedit_off;
    val sig_size:      usize = code_signature_size(ident_len, code_limit);
    val linkedit_size: usize = sig_size;
    val linkedit_va:   u64 = bin.align_up_u64(hi_va, exec_page);
    total_size = linkedit_off + sig_size;

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        macho_dwarf_free(alloc, ?dw, debug_count);
        A.deallocate[usize](alloc, seg_offsets, seg_count::usize);
        ret R.err[R.Void, str]("macho: exec buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    bin.write_u32_le(buf, 0, MH_MAGIC_64);
    bin.write_u32_le(buf, 4, R.unwrap_ok[u32, str](ct));
    bin.write_u32_le(buf, 8, cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds::u32);
    bin.write_u32_le(buf, 24, MH_NOUNDEFS);
    bin.write_u32_le(buf, 28, 0);

    var lc: usize = write_frame_cmds(buf, MACH_HEADER_64_SIZE, itn, nil::*of.DynamicInfo, segs,
                                     seg_count, seg_offsets, pagezero_size, text_va,
                                     hdr_span, exec_page);
    write_segment_bytes(buf, segs, seg_count, seg_offsets);

    lc = macho_dwarf_write(buf, itn, debug, debug_count, lc, ?dw, 0);
    macho_dwarf_write_bytes(buf, debug, debug_count, ?dw);

    lc = write_segment_cmd(buf, lc, "__LINKEDIT", linkedit_va,
                           bin.align_up_u64(linkedit_size::u64, exec_page),
                           linkedit_off::u64, linkedit_size::u64,
                           VM_PROT_READ, VM_PROT_READ, 0);

    lc = write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);

    bin.write_u32_le(buf, lc, LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, code_limit::u32);
    bin.write_u32_le(buf, lc + 12, sig_size::u32);

    write_code_signature(buf, code_limit, name, code_limit, exec_base, exec_limit);

    macho_dwarf_free(alloc, ?dw, debug_count);
    A.deallocate[usize](alloc, seg_offsets, seg_count::usize);

    val wr: R.Result[R.Void, str] = publication.bytes(itn, alloc, path::str, buf, total_size, 0o755, publication.REPLACE, publication.PARENTS_EXIST, "macho: exec", "macho: could not publish output file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret wr;
}

rec MachoDynLayout {
    hdr_span:      usize;
    pagezero_size: u64;
    text_va:       u64;

    stubs_off:     usize;
    stubs_va:      u64;
    stubs_size:    usize;

    got_off:       usize;
    got_va:        u64;
    got_size:      usize;
    got_seg_index: u32;

    linkedit_off:  usize;
    linkedit_va:   u64;
    linkedit_size: usize;

    rebase_off:    usize;
    rebase_size:   usize;
    bind_off:      usize;
    bind_size:     usize;
    symtab_off:    usize;
    strtab_off:    usize;
    strtab_size:   usize;
}

fun write_uleb(buf: *u8, off: usize, v: u64) usize {
    var value: u64 = v;
    var p:     usize = off;
    var more:  bool = true;
    for (more) {
        var byte: u8 = (value & 0x7F)::u8;
        value = value >> 7;
        if (value != 0) { byte = byte | 0x80; } or { more = false; }
        buf[p] = byte;
        p = p + 1;
    }
    ret p;
}

fun uleb_size(v: u64) usize {
    var value: u64 = v;
    var n:     usize = 1;
    for (value >= 0x80) { value = value >> 7; n = n + 1; }
    ret n;
}

fun write_sleb(buf: *u8, off: usize, v: i64) usize {
    var value: i64 = v;
    var p:     usize = off;
    var more:  bool = true;
    for (more) {
        var byte: u8 = (value::u64 & 0x7F)::u8;
        value = value >> 7;
        val sign: bool = (byte & 0x40) != 0;
        if ((value == 0 && !sign) || (value == -1 && sign)) { more = false; }
        or { byte = byte | 0x80; }
        buf[p] = byte;
        p = p + 1;
    }
    ret p;
}

fun sleb_size(v: i64) usize {
    var value: i64 = v;
    var n:     usize = 0;
    var more:  bool = true;
    for (more) {
        val sign: bool = (value & 0x40) != 0;
        value = value >> 7;
        n = n + 1;
        if ((value == 0 && !sign) || (value == -1 && sign)) { more = false; }
    }
    ret n;
}

fun func_import_count(dyn: *of.DynamicInfo) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun import_has_addr_fixup(dyn: *of.DynamicInfo, import_index: u32) bool {
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        if (dyn.import_addr_fixups[i].kind != of.RK_ABS64
            && dyn.import_addr_fixups[i].import_index == import_index) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun import_needs_got(dyn: *of.DynamicInfo, import_index: u32) bool {
    if (import_index >= dyn.import_count) { ret false; }
    ret dyn.imports[import_index].is_func || import_has_addr_fixup(dyn, import_index);
}

fun got_import_count(dyn: *of.DynamicInfo) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (import_needs_got(dyn, i)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun macho_stub_size(arch_id: u32) usize {
    if (arch_is_arm64(arch_id)) { ret MACHO_ARM64_STUB_SIZE; }
    ret MACHO_X86_STUB_SIZE;
}

fun write_macho_stub(buf: *u8, arch_id: u32, stub_off: usize, stub_va: u64, slot_va: u64) {
    if (arch_is_arm64(arch_id)) {
        val slot_page: u64 = (slot_va >> 12) << 12;
        val stub_page: u64 = (stub_va >> 12) << 12;
        val delta:     i64 = (slot_page::i64) - (stub_page::i64);
        val imm21:     u64 = ((delta >> 12)::u64) & 0x1FFFFF;
        val immlo:     u32 = (imm21 & 0x3)::u32;
        val immhi:     u32 = ((imm21 >> 2) & 0x7FFFF)::u32;
        bin.write_u32_le(buf, stub_off, 0x90000000 | (immlo << 29) | (immhi << 5) | 16);
        val imm12: u32 = (((slot_va & 0xFFF) >> 3) & 0xFFF)::u32;
        bin.write_u32_le(buf, stub_off + 4, 0xF9400000 | (imm12 << 10) | (16 << 5) | 16);
        bin.write_u32_le(buf, stub_off + 8, 0xD61F0200);
        ret;
    }
    buf[stub_off] = 0xFF; buf[stub_off + 1] = 0x25;
    val next: u64 = stub_va + 6;
    bin.write_u32_le(buf, stub_off + 2, (slot_va - next)::u32);
}

fun dylinker_cmd_size() usize {
    ret bin.align_up(DYLINKER_CMD_BASE + str_len(DARWIN_DYLD_PATH) + 1, 8);
}

fun dylib_cmd_size(name: str) usize {
    var n: usize = 0;
    if (name != nil) { n = str_len(name); }
    ret bin.align_up(DYLIB_CMD_BASE + n + 1, 8);
}

fun rpath_cmd_size(name: str) usize {
    var n: usize = 0;
    if (name != nil) { n = str_len(name); }
    ret bin.align_up(RPATH_CMD_BASE + n + 1, 8);
}

fun write_load_dylinker(buf: *u8, off: usize) usize {
    val sz: usize = dylinker_cmd_size();
    bin.write_u32_le(buf, off, LC_LOAD_DYLINKER);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, DYLINKER_CMD_BASE::u32);
    bin.write_str(buf, off + DYLINKER_CMD_BASE, DARWIN_DYLD_PATH);
    ret off + sz;
}

fun write_load_dylib(buf: *u8, off: usize, name: str) usize {
    val sz: usize = dylib_cmd_size(name);
    bin.write_u32_le(buf, off, LC_LOAD_DYLIB);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, DYLIB_CMD_BASE::u32);
    bin.write_u32_le(buf, off + 12, 0);
    bin.write_u32_le(buf, off + 16, 0x10000);
    bin.write_u32_le(buf, off + 20, 0x10000);
    bin.write_str(buf, off + DYLIB_CMD_BASE, name);
    ret off + sz;
}

fun write_rpath(buf: *u8, off: usize, name: str) usize {
    val sz: usize = rpath_cmd_size(name);
    bin.write_u32_le(buf, off, LC_RPATH);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, RPATH_CMD_BASE::u32);
    bin.write_str(buf, off + RPATH_CMD_BASE, name);
    ret off + sz;
}

fun rpath_seen_before(libs: *of.DynLib, end: u32, rpath: intern.StrId) bool {
    var i: u32 = 0;
    for (i < end) {
        if (libs[i].rpath == rpath) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun write_unixthread(buf: *u8, off: usize, arch_id: u32, entry: u64, cmd_size: usize) usize {
    bin.write_u32_le(buf, off, LC_UNIXTHREAD);
    bin.write_u32_le(buf, off + 4, cmd_size::u32);
    if (arch_is_arm64(arch_id)) {
        bin.write_u32_le(buf, off + 8, ARM_THREAD_STATE64);
        bin.write_u32_le(buf, off + 12, ARM_THREAD_STATE64_COUNT);
        bin.write_u64_le(buf, off + 16 + ARM_PC_STATE_OFFSET, entry);
    }
    or {
        bin.write_u32_le(buf, off + 8, X86_THREAD_STATE64);
        bin.write_u32_le(buf, off + 12, X86_THREAD_STATE64_COUNT);
        bin.write_u64_le(buf, off + 16 + X86_RIP_STATE_OFFSET, entry);
    }
    ret off + cmd_size;
}

fun write_segment_cmd(buf: *u8, off: usize, name: str, vmaddr: u64, vmsize: u64,
                      fileoff: u64, filesize: u64, maxprot: u32, initprot: u32, nsects: u32) usize {
    bin.write_u32_le(buf, off, LC_SEGMENT_64);
    bin.write_u32_le(buf, off + 4, (SEGMENT_CMD_64_SIZE + nsects::usize * SECTION_64_SIZE)::u32);
    write_fixed16(buf, off + 8, name);
    bin.write_u64_le(buf, off + 24, vmaddr);
    bin.write_u64_le(buf, off + 32, vmsize);
    bin.write_u64_le(buf, off + 40, fileoff);
    bin.write_u64_le(buf, off + 48, filesize);
    bin.write_u32_le(buf, off + 56, maxprot);
    bin.write_u32_le(buf, off + 60, initprot);
    bin.write_u32_le(buf, off + 64, nsects);
    bin.write_u32_le(buf, off + 68, 0);
    ret off + SEGMENT_CMD_64_SIZE;
}

fun write_section_64(buf: *u8, off: usize, sectname: str, segname: str, addr: u64, size: u64,
                     fileoff: u32, align: u32, flags: u32) usize {
    write_fixed16(buf, off, sectname);
    write_fixed16(buf, off + 16, segname);
    bin.write_u64_le(buf, off + 32, addr);
    bin.write_u64_le(buf, off + 40, size);
    bin.write_u32_le(buf, off + 48, fileoff);
    bin.write_u32_le(buf, off + 52, align_log2(align));
    bin.write_u32_le(buf, off + 56, 0);
    bin.write_u32_le(buf, off + 60, 0);
    bin.write_u32_le(buf, off + 64, flags);
    bin.write_u32_le(buf, off + 68, 0);
    bin.write_u32_le(buf, off + 72, 0);
    bin.write_u32_le(buf, off + 76, 0);
    ret off + SECTION_64_SIZE;
}

fun frame_cmd_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, pagezero: bool) u32 {
    var n: u32 = seg_group_count(dyn, segs, seg_count);
    if (pagezero) { n = n + 1; }
    ret n;
}

fun frame_cmd_bytes(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, pagezero: bool) usize {
    ret frame_cmd_count(dyn, segs, seg_count, pagezero)::usize * SEGMENT_CMD_64_SIZE
        + frame_sect_total(segs, seg_count)::usize * SECTION_64_SIZE;
}

fun frame_sect_total(segs: *of.LoadSegment, seg_count: u32) u32 {
    var n:  u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        n = n + segs[li].section_count;
        li = li + 1;
    }
    ret n;
}

fun group_sect_count(segs: *of.LoadSegment, first: u32, last: u32) u32 {
    var n: u32 = 0;
    var m: u32 = first;
    for (m <= last) {
        n = n + segs[m].section_count;
        m = m + 1;
    }
    ret n;
}

fun exec_sectname(itn: *intern.Interner, sec: *of.LoadSection) str {
    val nm: str = bin.resolve_name(itn, sec.name);
    if (nm == nil || str_equals(nm, of.canonical_section_name(sec.kind))) {
        ret macho_sectname(sec.kind);
    }
    ret nm;
}

fun write_load_sections(buf: *u8, off: usize, itn: *intern.Interner, seg: *of.LoadSegment,
                        segname: str, fileoff: usize) usize {
    var w: usize = off;
    var i: u32 = 0;
    for (i < seg.section_count) {
        val sec: *of.LoadSection = ?seg.sections[i];
        var soff: u32 = 0;
        if (sec.kind != of.SK_BSS) { soff = (fileoff + sec.offset::usize)::u32; }
        w = write_section_64(buf, w, exec_sectname(itn, sec), segname,
                             seg.vaddr + sec.offset::u64, sec.len::u64, soff,
                             sec.align, exec_section_flags(sec));
        i = i + 1;
    }
    ret w;
}

fun write_frame_cmds(buf: *u8, lc: usize, itn: *intern.Interner, dyn: *of.DynamicInfo,
                     segs: *of.LoadSegment, seg_count: u32, seg_offsets: *usize,
                     pagezero_size: u64, text_va: u64, hdr_span: usize, exec_page: u64) usize {
    var off: usize = lc;
    if (pagezero_size > 0) {
        off = write_segment_cmd(buf, off, "__PAGEZERO", 0, pagezero_size, 0, 0, 0, 0, 0);
    }
    if (seg_count == 0) { ret off; }

    val text_prot: u32 = seg_vm_prot(dyn, segs, 0);
    var tsec: usize = write_segment_cmd(buf, off, "__TEXT", text_va,
                          bin.align_up_u64(hdr_span::u64 + segs[0].memsz::u64, exec_page),
                          0, hdr_span::u64 + segs[0].filesz::u64, text_prot, text_prot,
                          segs[0].section_count);
    if (seg_is_data_const(dyn, segs, 0)) { bin.write_u32_le(buf, off + 68, SG_READ_ONLY); }
    off = write_load_sections(buf, tsec, itn, ?segs[0], "__TEXT", seg_offsets[0]);

    var li: u32 = 1;
    for (li < seg_count) {
        val last: u32 = seg_group_last(dyn, segs, seg_count, li);
        val prot:  u32 = seg_vm_prot(dyn, segs, li);
        val gname: str = exec_segname(segs[li].flags, seg_is_data_const(dyn, segs, li));
        var grp_fsz: u64 = 0;
        var m: u32 = li;
        for (m <= last) {
            if (segs[m].filesz > 0) { grp_fsz = (seg_offsets[m] + segs[m].filesz - seg_offsets[li])::u64; }
            m = m + 1;
        }
        val grp_vmsz: u64 = bin.align_up_u64(segs[last].vaddr + segs[last].memsz::u64 - segs[li].vaddr,
                                             exec_page);

        var lsec: usize = write_segment_cmd(buf, off, gname, segs[li].vaddr, grp_vmsz,
                              seg_offsets[li]::u64, grp_fsz, prot, prot,
                              group_sect_count(segs, li, last));
        if (seg_is_data_const(dyn, segs, li)) { bin.write_u32_le(buf, off + 68, SG_READ_ONLY); }
        m = li;
        for (m <= last) {
            lsec = write_load_sections(buf, lsec, itn, ?segs[m], gname, seg_offsets[m]);
            m = m + 1;
        }
        off = lsec;
        li = last + 1;
    }
    ret off;
}

fun write_segment_bytes(buf: *u8, segs: *of.LoadSegment, seg_count: u32, seg_offsets: *usize) {
    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_offsets[li])::ptr, segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }
}

fun dylib_ordinal_for(dyn: *of.DynamicInfo, import_index: u32) u32 {
    val li: u32 = dyn.imports[import_index].lib_index;
    if (li == of.DYNLIB_ANY) { ret DYNAMIC_LOOKUP_ORDINAL::u32; }
    ret li + 1;
}

fun measure_bind_prefix(itn: *intern.Interner, dyn: *of.DynamicInfo, import_index: u32) usize {
    var size: usize = 0;
    val ord: u32 = dylib_ordinal_for(dyn, import_index);
    if (dyn.imports[import_index].lib_index == of.DYNLIB_ANY) { size = 1; }
    or (ord <= 15)                                            { size = 1; }
    or                                                        { size = 1 + uleb_size(ord::u64); }
    val name: str = bin.resolve_name(itn, dyn.imports[import_index].symbol);
    var nl: usize = 0;
    if (name != nil) { nl = str_len(name); }
    ret size + 1 + nl + 1 + 1;
}

fun write_bind_prefix(buf: *u8, off: usize, itn: *intern.Interner,
                      dyn: *of.DynamicInfo, import_index: u32) usize {
    var p: usize = off;
    if (dyn.imports[import_index].lib_index == of.DYNLIB_ANY) {
        buf[p] = BIND_OPCODE_SET_DYLIB_SPECIAL_IMM | BIND_SPECIAL_DYLIB_FLAT_LOOKUP;
        p = p + 1;
    }
    or {
        val ord: u32 = dylib_ordinal_for(dyn, import_index);
        if (ord <= 15) {
            buf[p] = BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | (ord::u8 & 0xF);
            p = p + 1;
        }
        or {
            buf[p] = BIND_OPCODE_SET_DYLIB_ORDINAL_ULEB;
            p = write_uleb(buf, p + 1, ord::u64);
        }
    }

    buf[p] = BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM;
    p = p + 1 + bin.write_str(buf, p + 1, bin.resolve_name(itn, dyn.imports[import_index].symbol));

    buf[p] = BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER;
    ret p + 1;
}

fun measure_bind_info(itn: *intern.Interner, dyn: *of.DynamicInfo,
                      segs: *of.LoadSegment, text_va: u64, pz: u32) usize {
    var size: usize = 0;
    var n:    u32 = 0;
    var f:    u32 = 0;
    for (f < dyn.import_addr_fixup_count) {
        val fx: *of.ImportAddrFixup = ?dyn.import_addr_fixups[f];
        if (fx.kind == of.RK_ABS64) {
            size = size + measure_bind_prefix(itn, dyn, fx.import_index);
            if (fx.addend != 0) { size = size + 1 + sleb_size(fx.addend); }
            var bseg: u32 = 0;
            var boff: u64 = 0;
            seg_offset_loc(dyn, fx.seg_index, fx.seg_offset, segs, text_va, pz, ?bseg, ?boff);
            size = size + 1 + uleb_size(boff);
            size = size + 1;
            n = n + 1;
        }
        f = f + 1;
    }
    var i:    u32 = 0;
    var g:    u32 = 0;
    for (i < dyn.import_count) {
        if (import_needs_got(dyn, i)) {
            size = size + measure_bind_prefix(itn, dyn, i);
            size = size + 1 + uleb_size(g::u64 * 8);
            size = size + 1;
            g = g + 1;
            n = n + 1;
        }
        i = i + 1;
    }
    if (n > 0) { size = size + 1; }
    ret size;
}

fun write_bind_info(buf: *u8, off: usize, itn: *intern.Interner, dyn: *of.DynamicInfo,
                    segs: *of.LoadSegment, text_va: u64, pz: u32, got_seg_index: u32) usize {
    var p: usize = off;
    var n: u32 = 0;
    var f: u32 = 0;
    for (f < dyn.import_addr_fixup_count) {
        val fx: *of.ImportAddrFixup = ?dyn.import_addr_fixups[f];
        if (fx.kind == of.RK_ABS64) {
            p = write_bind_prefix(buf, p, itn, dyn, fx.import_index);
            if (fx.addend != 0) {
                buf[p] = BIND_OPCODE_SET_ADDEND_SLIB_ULEB;
                p = write_sleb(buf, p + 1, fx.addend);
            }
            var bseg: u32 = 0;
            var boff: u64 = 0;
            seg_offset_loc(dyn, fx.seg_index, fx.seg_offset, segs, text_va, pz, ?bseg, ?boff);
            buf[p] = BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | (bseg::u8 & 0xF);
            p = write_uleb(buf, p + 1, boff);
            buf[p] = BIND_OPCODE_DO_BIND;
            p = p + 1;
            n = n + 1;
        }
        f = f + 1;
    }
    var i: u32 = 0;
    var g: u32 = 0;
    for (i < dyn.import_count) {
        if (import_needs_got(dyn, i)) {
            p = write_bind_prefix(buf, p, itn, dyn, i);

            buf[p] = BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | (got_seg_index::u8 & 0xF);
            p = write_uleb(buf, p + 1, g::u64 * 8);

            buf[p] = BIND_OPCODE_DO_BIND;
            p = p + 1;

            g = g + 1;
            n = n + 1;
        }
        i = i + 1;
    }
    if (n > 0) { buf[p] = BIND_OPCODE_DONE; p = p + 1; }
    ret p;
}

fun write_macho_uuid(buf: *u8, off: usize, name: *u8) {
    var digest: [32]u8;
    var n: usize = 0;
    if (name != nil) { n = str_len(name::str); }
    sha256.hash(name, n, ?digest[0]);
    var i: usize = 0;
    for (i < 16) { buf[off + i] = digest[i]; i = i + 1; }
    buf[off + 6] = (buf[off + 6] & 0x0F) | 0x50;
    buf[off + 8] = (buf[off + 8] & 0x3F) | 0x80;
}

fun base_reloc_cmp(a: *of.BaseReloc, b: *of.BaseReloc) i64 {
    if (a.seg_index != b.seg_index) {
        if (a.seg_index < b.seg_index) { ret -1; }
        ret 1;
    }
    if (a.seg_offset < b.seg_offset) { ret -1; }
    if (a.seg_offset > b.seg_offset) { ret 1; }
    ret 0;
}

fun base_reloc_loc(dyn: *of.DynamicInfo, br: *of.BaseReloc, segs: *of.LoadSegment, text_va: u64, pz: u32,
                   out_seg: *u32, out_off: *u64) {
    seg_offset_loc(dyn, br.seg_index, br.seg_offset, segs, text_va, pz, out_seg, out_off);
}

fun seg_offset_loc(dyn: *of.DynamicInfo, ls: u32, seg_offset: u32,
                   segs: *of.LoadSegment, text_va: u64, pz: u32,
                   out_seg: *u32, out_off: *u64) {
    val first: u32 = seg_group_first(dyn, segs, ls);
    @out_seg = pz + seg_group_of(dyn, segs, ls);
    var seg_vmaddr: u64 = segs[first].vaddr;
    if (first == 0) { seg_vmaddr = text_va; }
    @out_off = (segs[ls].vaddr + seg_offset::u64) - seg_vmaddr;
}

fun seg_is_rebased(dyn: *of.DynamicInfo, ls: u32) bool {
    if (dyn == nil) { ret false; }
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == ls) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun seg_is_data_const(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) bool {
    if (vm_prot_for(segs[ls].flags) != VM_PROT_READ) { ret false; }
    ret seg_is_rebased(dyn, ls);
}

fun seg_vm_prot(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) u32 {
    if (seg_is_data_const(dyn, segs, ls)) { ret VM_PROT_READ | VM_PROT_WRITE; }
    ret vm_prot_for(segs[ls].flags);
}

fun seg_same_macho_segment(dyn: *of.DynamicInfo, segs: *of.LoadSegment, a: u32, b: u32) bool {
    if (vm_prot_for(segs[a].flags) != vm_prot_for(segs[b].flags)) { ret false; }
    ret seg_is_data_const(dyn, segs, a) == seg_is_data_const(dyn, segs, b);
}

fun seg_group_of(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) u32 {
    var g: u32 = 0;
    var i: u32 = 1;
    for (i <= ls) {
        if (i == 1 || !seg_same_macho_segment(dyn, segs, i, i - 1)) { g = g + 1; }
        i = i + 1;
    }
    ret g;
}

fun seg_group_first(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) u32 {
    if (ls == 0) { ret 0; }
    var f: u32 = ls;
    for (f > 1 && seg_same_macho_segment(dyn, segs, f, f - 1)) { f = f - 1; }
    ret f;
}

fun seg_group_last(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, first: u32) u32 {
    if (first == 0) { ret 0; }
    var l: u32 = first;
    for (l + 1 < seg_count && seg_same_macho_segment(dyn, segs, l + 1, l)) { l = l + 1; }
    ret l;
}

fun seg_group_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32) u32 {
    if (seg_count == 0) { ret 0; }
    ret seg_group_of(dyn, segs, seg_count - 1) + 1;
}

fun data_const_seg_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32) u32 {
    var n: u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        if (seg_is_data_const(dyn, segs, li) && seg_group_first(dyn, segs, li) == li) { n = n + 1; }
        li = li + 1;
    }
    ret n;
}

fun data_const_conflict_message(itn: *intern.Interner, alloc: *A.Allocator, dyn: *of.DynamicInfo,
                                segs: *of.LoadSegment, seg_count: u32) str {
    val generic: str = "macho: two separated read-only segments carry base relocations; Mach-O maps a single __DATA_CONST";
    if (itn == nil) { ret generic; }

    var first:  u32 = 0xFFFFFFFF;
    var second: u32 = 0xFFFFFFFF;
    var li: u32 = 0;
    for (li < seg_count) {
        if (seg_is_data_const(dyn, segs, li) && seg_group_first(dyn, segs, li) == li) {
            if (first == 0xFFFFFFFF) { first = li; }
            or { if (second == 0xFFFFFFFF) { second = li; } }
        }
        li = li + 1;
    }
    if (second == 0xFFFFFFFF) { ret generic; }

    var slot: u64 = 0;
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == second) { slot = dyn.base_relocs[i].seg_offset::u64; brk; }
        i = i + 1;
    }

    val res: R.Result[str, str] = format.sprint(alloc,
        "macho: read-only load segments {} (vaddr {}) and {} (vaddr {}, e.g. the pointer at +{}) both need base relocations, but Mach-O maps a single read-only __DATA_CONST and they are not adjacent",
        first::u64, segs[first].vaddr, second::u64, segs[second].vaddr, slot);
    if (R.is_err[str, str](res)) { ret generic; }
    val buf: str = R.unwrap_ok[str, str](res);
    val msg: str = bin.name_message(itn, alloc, "", buf, generic);
    A.deallocate[u8](alloc, buf::*u8, str_len(buf) + 1);
    ret msg;
}

fun measure_rebase_info(dyn: *of.DynamicInfo, segs: *of.LoadSegment, text_va: u64, pz: u32) usize {
    if (dyn.base_reloc_count == 0) { ret 0; }
    var size: usize = 1;
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        var seg: u32 = 0;
        var off: u64 = 0;
        base_reloc_loc(dyn, ?dyn.base_relocs[i], segs, text_va, pz, ?seg, ?off);
        size = size + 1 + uleb_size(off) + 1;
        i = i + 1;
    }
    size = size + 1;
    ret size;
}

fun write_rebase_info(buf: *u8, off: usize, dyn: *of.DynamicInfo, segs: *of.LoadSegment,
                      text_va: u64, pz: u32) usize {
    if (dyn.base_reloc_count == 0) { ret off; }
    var p: usize = off;
    buf[p] = REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER;
    p = p + 1;
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        var seg: u32 = 0;
        var slot: u64 = 0;
        base_reloc_loc(dyn, ?dyn.base_relocs[i], segs, text_va, pz, ?seg, ?slot);
        buf[p] = REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | (seg::u8 & 0xF);
        p = write_uleb(buf, p + 1, slot);
        buf[p] = REBASE_OPCODE_DO_REBASE_IMM_TIMES | 1;
        p = p + 1;
        i = i + 1;
    }
    buf[p] = REBASE_OPCODE_DONE;
    p = p + 1;
    ret p;
}

fun patch_macho_fixups(buf: *u8, arch_id: u32, lay: *MachoDynLayout, dyn: *of.DynamicInfo,
                       fixups: *of.PltFixup, fixup_count: u32, seg_offsets: *usize,
                       segs: *of.LoadSegment, seg_count: u32, nimp: u32) R.Result[R.Void, str] {
    if (nimp == 0) { ret R.ok_void[str](); }
    val stub_sz: usize = macho_stub_size(arch_id);
    var i: u32 = 0;
    for (i < fixup_count) {
        val fx: *of.PltFixup = ?fixups[i];
        if (fx.seg_index >= seg_count) {
            ret R.err[R.Void, str]("macho: dynamic call-site fixup references an out-of-range segment");
        }
        val n: u32 = macho_func_ordinal(dyn, fx.import_index);
        if (n == 0xFFFFFFFF) {
            ret R.err[R.Void, str]("macho: dynamic call-site fixup targets a non-function import");
        }
        if (fx.seg_offset::usize + 4 > segs[fx.seg_index].filesz) {
            ret R.err[R.Void, str]("macho: dynamic call-site fixup offset out of range");
        }

        val stub_va: u64 = lay.stubs_va + n::u64 * stub_sz::u64;
        val disp:    i64 = (stub_va::i64) + fx.addend - (fx.patch_vaddr::i64);
        val file_off: usize = seg_offsets[fx.seg_index] + fx.seg_offset::usize;

        if (arch_is_arm64(arch_id)) {
            val lim: i64 = 134217728;
            if (disp < -lim || disp >= lim || (disp & 3) != 0) {
                ret R.err[R.Void, str]("macho: dynamic call-site displacement overflows a 26-bit branch");
            }
            val word:  u32 = bin.read_u32_le(buf, file_off);
            val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
            bin.write_u32_le(buf, file_off, (word & 0xFC000000) | imm26);
        }
        or {
            if (disp > 2147483647 || disp < -2147483648) {
                ret R.err[R.Void, str]("macho: dynamic call-site displacement overflows 32 bits");
            }
            bin.write_u32_le(buf, file_off, (disp::u64)::u32);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun macho_pcrel_disp(target_va: u64, addend: i64,
                     patch_va: u64) R.Result[i64, str] {
    val i64_max: i64 = 9223372036854775807;
    val i64_min: i64 = -9223372036854775807 - 1;
    if (target_va > i64_max::u64 || patch_va > i64_max::u64) {
        ret R.err[i64, str]("macho: pc-relative address exceeds the signed range");
    }
    val delta: i64 = target_va::i64 - patch_va::i64;
    if ((addend > 0 && delta > i64_max - addend)
        || (addend < 0 && delta < i64_min - addend)) {
        ret R.err[i64, str]("macho: pc-relative signed arithmetic overflow");
    }
    ret R.ok[i64, str](delta + addend);
}

fun patch_macho_import_addr_fixups(buf: *u8, lay: *MachoDynLayout,
                                   dyn: *of.DynamicInfo, seg_offsets: *usize,
                                   segs: *of.LoadSegment,
                                   seg_count: u32) R.Result[R.Void, str] {
    if (dyn.import_addr_fixup_count == 0) { ret R.ok_void[str](); }
    if (buf == nil || seg_offsets == nil || segs == nil) {
        ret R.err[R.Void, str]("macho: import-address fixup is missing output layout data");
    }
    if (dyn.import_addr_fixups == nil) {
        ret R.err[R.Void, str]("macho: nil import-address fixup array");
    }
    if (dyn.import_count > 0 && dyn.imports == nil) {
        ret R.err[R.Void, str]("macho: nil dynamic import array");
    }
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        val fx: *of.ImportAddrFixup = ?dyn.import_addr_fixups[i];
        if (fx.kind == of.RK_ABS64) { i = i + 1; cnt; }
        if (fx.import_index >= dyn.import_count) {
            ret R.err[R.Void, str]("macho: import-address fixup targets an out-of-range import");
        }
        if (fx.seg_index >= seg_count) {
            ret R.err[R.Void, str]("macho: import-address fixup references an out-of-range segment");
        }
        var width: usize = 4;
        if (fx.kind == of.RK_GOTPCREL64_NORELAX) { width = 8; }
        or (fx.kind != of.RK_GOTPCREL && fx.kind != of.RK_GOTPCREL_NORELAX) {
            ret R.err[R.Void, str]("macho: unsupported import-address relocation kind");
        }
        if (fx.seg_offset::usize + width > segs[fx.seg_index].filesz) {
            ret R.err[R.Void, str]("macho: import-address fixup offset out of range");
        }
        val slot_n: u32 = macho_got_ordinal(dyn, fx.import_index);
        if (slot_n == 0xFFFFFFFF || slot_n::usize * 8 + 8 > lay.got_size) {
            ret R.err[R.Void, str]("macho: import-address fixup has no GOT slot");
        }
        val slot_va: u64 = lay.got_va + slot_n::u64 * 8;
        val dr: R.Result[i64, str] =
            macho_pcrel_disp(slot_va, fx.addend, fx.patch_vaddr);
        if (R.is_err[i64, str](dr)) {
            ret R.err[R.Void, str](R.unwrap_err[i64, str](dr));
        }
        val disp: i64 = R.unwrap_ok[i64, str](dr);
        val file_off: usize = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
        if (width == 4) {
            if (disp > 2147483647 || disp < -2147483648) {
                ret R.err[R.Void, str]("macho: import-address displacement overflows 32 bits");
            }
            bin.write_u32_le(buf, file_off, (disp::u64)::u32);
        }
        or {
            bin.write_u64_le(buf, file_off, disp::u64);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun macho_func_ordinal(dyn: *of.DynamicInfo, import_index: u32) u32 {
    if (import_index >= dyn.import_count)   { ret 0xFFFFFFFF; }
    if (!dyn.imports[import_index].is_func) { ret 0xFFFFFFFF; }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < import_index) {
        if (dyn.imports[i].is_func) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun macho_got_ordinal(dyn: *of.DynamicInfo, import_index: u32) u32 {
    if (import_index >= dyn.import_count || !import_needs_got(dyn, import_index)) {
        ret 0xFFFFFFFF;
    }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < import_index) {
        if (import_needs_got(dyn, i)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                  seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                  funcs: *of.ExecFunction, func_count: u32,
                  dyn: *of.DynamicInfo, fixups: *of.PltFixup, fixup_count: u32,
                  exceptions: *of.Section, exception_count: u32,
                  debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32,
                  path: *u8, name: *u8,
                  image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (isa_vt == nil) { ret R.err[R.Void, str]("macho: nil dyn-exec isa"); }
    if (path == nil)   { ret R.err[R.Void, str]("macho: nil dyn-exec path"); }
    if (dyn == nil)    { ret R.err[R.Void, str]("macho: nil dynamic plan"); }
    if (itn == nil)    { ret R.err[R.Void, str]("macho: no interner for dyn-exec"); }
    if (seg_count == 0) { ret R.err[R.Void, str]("macho: dyn-exec has no load segments"); }
    if (segs == nil) { ret R.err[R.Void, str]("macho: nil dyn-exec load segments"); }
    if (dyn.import_count > 0 && dyn.imports == nil) {
        ret R.err[R.Void, str]("macho: nil dynamic import array");
    }
    if (dyn.import_addr_fixup_count > 0 && dyn.import_addr_fixups == nil) {
        ret R.err[R.Void, str]("macho: nil import-address fixup array");
    }
    if (dyn.base_reloc_count > 0 && dyn.base_relocs == nil) {
        ret R.err[R.Void, str]("macho: nil base-relocation array");
    }
    if (fixup_count > 0 && fixups == nil) {
        ret R.err[R.Void, str]("macho: nil call-site fixup array");
    }
    val arch_id: u32 = isa_vt.arch_id;
    val ct: R.Result[u32, str] = cpu_type_for(arch_id);
    if (R.is_err[u32, str](ct)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ct)); }

    val exec_page: u64 = macho_page_size(arch_id);
    val page:     usize = exec_page::usize;
    val nstub:    u32 = func_import_count(dyn);
    val ngot:     u32 = got_import_count(dyn);
    val stub_sz:  usize = macho_stub_size(arch_id);

    val pie: bool = dyn.pie;
    if (!pie) {
        val su: R.Result[R.Void, str] = refuse_unixthread_stack(?image_options);
        if (R.is_err[R.Void, str](su)) { ret su; }
    }
    if (pie && dyn.base_reloc_count > 1) {
        sort.sort[of.BaseReloc](dyn.base_relocs, dyn.base_reloc_count::usize, base_reloc_cmp);
    }

    if (data_const_seg_count(dyn, segs, seg_count) > 1) {
        ret R.err[R.Void, str](data_const_conflict_message(itn, alloc, dyn, segs, seg_count));
    }

    val grp_count: u32 = seg_group_count(dyn, segs, seg_count);
    var seg_cmds: u32 = frame_cmd_count(dyn, segs, seg_count, image_base > 0) + 1;
    if (nstub > 0) { seg_cmds = seg_cmds + 1; }
    if (ngot > 0)  { seg_cmds = seg_cmds + 1; }

    var thread_state: usize = X86_THREAD_STATE64_COUNT::usize * 4;
    if (arch_is_arm64(arch_id)) { thread_state = ARM_THREAD_STATE64_COUNT::usize * 4; }
    val thread_cmd_size: usize = 16 + thread_state;
    var entry_cmd_size: usize = thread_cmd_size;
    if (pie) { entry_cmd_size = ENTRY_POINT_CMD_SIZE; }

    var sect_total: u32 = frame_sect_total(segs, seg_count);
    if (nstub > 0) { sect_total = sect_total + 1; }
    if (ngot > 0)  { sect_total = sect_total + 1; }

    var sizeofcmds: usize = seg_cmds::usize * SEGMENT_CMD_64_SIZE
                          + sect_total::usize * SECTION_64_SIZE
                          + DYLD_INFO_CMD_SIZE + SYMTAB_CMD_SIZE + DYSYMTAB_CMD_SIZE
                          + dylinker_cmd_size() + entry_cmd_size + LINKEDIT_DATA_CMD_SIZE;
    if (pie) { sizeofcmds = sizeofcmds + BUILD_VERSION_CMD_SIZE + UUID_CMD_SIZE; }
    var di: u32 = 0;
    var rpath_count: u32 = 0;
    for (di < dyn.lib_count) {
        sizeofcmds = sizeofcmds + dylib_cmd_size(bin.resolve_name(itn, dyn.libs[di].soname));
        if (dyn.libs[di].rpath != intern.STR_NIL
            && !rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            sizeofcmds = sizeofcmds
                + rpath_cmd_size(bin.resolve_name(itn, dyn.libs[di].rpath));
            rpath_count = rpath_count + 1;
        }
        di = di + 1;
    }

    var ncmds: u32 = seg_cmds + 6 + dyn.lib_count + rpath_count;
    if (pie) { ncmds = ncmds + 2; }

    val have_dwarf: bool = debug_count > 0;
    if (have_dwarf) {
        sizeofcmds = sizeofcmds + macho_dwarf_cmd_bytes(debug_count);
        ncmds = ncmds + 1;
    }

    var lay: MachoDynLayout;
    val hs: R.Result[usize, str] = reserved_header_span(segs, seg_count, image_base);
    if (R.is_err[usize, str](hs)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](hs)); }
    lay.hdr_span = R.unwrap_ok[usize, str](hs);
    if (MACH_HEADER_64_SIZE + sizeofcmds > lay.hdr_span) {
        ret R.err[R.Void, str]("macho: dyn-exec header exceeds the linker's reservation");
    }
    lay.text_va       = segs[0].vaddr - lay.hdr_span::u64;
    lay.pagezero_size = lay.text_va;

    val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, seg_count::usize);
    if (R.is_err[*usize, str](ro)) { ret R.err[R.Void, str]("macho: dyn-exec seg-offset alloc failed"); }
    var seg_offsets: *usize = R.unwrap_ok[*usize, str](ro);

    seg_offsets[0] = lay.hdr_span;
    var file: usize = lay.hdr_span + segs[0].filesz;
    var li: u32 = 1;
    for (li < seg_count) {
        file = bin.align_up(file, page);
        seg_offsets[li] = file;
        file = file + segs[li].filesz;
        li = li + 1;
    }

    var hi_va: u64 = 0;
    li = 0;
    for (li < seg_count) {
        val end: u64 = segs[li].vaddr + segs[li].memsz::u64;
        if (end > hi_va) { hi_va = end; }
        li = li + 1;
    }
    var va: u64 = bin.align_up_u64(hi_va, exec_page);

    var pz: u32 = 0;
    if (lay.pagezero_size > 0) { pz = 1; }

    lay.stubs_size = 0;
    lay.got_size = 0;
    lay.got_seg_index = 0;
    if (nstub > 0) {
        file = bin.align_up(file, page);
        lay.stubs_off  = file;
        lay.stubs_va   = va;
        lay.stubs_size = nstub::usize * stub_sz;
        file = file + lay.stubs_size;
        va   = bin.align_up_u64(va + lay.stubs_size::u64, exec_page);
    }
    if (ngot > 0) {
        file = bin.align_up(file, page);
        lay.got_off  = file;
        lay.got_va   = va;
        lay.got_size = ngot::usize * 8;
        file = file + lay.got_size;
        va   = bin.align_up_u64(va + lay.got_size::u64, exec_page);
        lay.got_seg_index = pz + grp_count;
        if (nstub > 0) { lay.got_seg_index = lay.got_seg_index + 1; }
    }

    var dw: MachoDwarf;
    val dwp: R.Result[MachoDwarf, str] =
        macho_dwarf_plan(alloc, debug, debug_count, file, page);
    if (R.is_err[MachoDwarf, str](dwp)) {
        A.deallocate[usize](alloc, seg_offsets, seg_count::usize);
        ret R.err[R.Void, str](R.unwrap_err[MachoDwarf, str](dwp));
    }
    dw = R.unwrap_ok[MachoDwarf, str](dwp);
    file = dw.end;

    file = bin.align_up(file, page);
    lay.linkedit_off = file;
    lay.linkedit_va  = va;

    lay.rebase_off  = lay.linkedit_off;
    lay.rebase_size = measure_rebase_info(dyn, segs, lay.text_va, pz);
    lay.bind_off  = lay.rebase_off + lay.rebase_size;
    lay.bind_size = measure_bind_info(itn, dyn, segs, lay.text_va, pz);
    lay.symtab_off = bin.align_up(lay.bind_off + lay.bind_size, 8);

    lay.strtab_size = 1;
    var si: u32 = 0;
    for (si < dyn.import_count) {
        if (import_needs_got(dyn, si)) {
            val name: str = bin.resolve_name(itn, dyn.imports[si].symbol);
            if (name != nil) { lay.strtab_size = lay.strtab_size + str_len(name) + 1; } or { lay.strtab_size = lay.strtab_size + 1; }
        }
        si = si + 1;
    }
    lay.strtab_off  = lay.symtab_off + ngot::usize * NLIST_64_SIZE;

    val ident_len:  usize = codesign_ident_len(name);
    val sig_off:    usize = bin.align_up(lay.strtab_off + lay.strtab_size, CODE_SIG_ALIGN);
    val sig_size:   usize = code_signature_size(ident_len, sig_off);
    val exec_limit: u64 = lay.hdr_span::u64 + segs[0].filesz::u64;
    val total_size: usize = sig_off + sig_size;
    lay.linkedit_size = total_size - lay.linkedit_off;

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        macho_dwarf_free(alloc, ?dw, debug_count);
        A.deallocate[usize](alloc, seg_offsets, seg_count::usize);
        ret R.err[R.Void, str]("macho: dyn-exec buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    bin.write_u32_le(buf, 0, MH_MAGIC_64);
    bin.write_u32_le(buf, 4, R.unwrap_ok[u32, str](ct));
    bin.write_u32_le(buf, 8, cpu_subtype_for(arch_id));
    bin.write_u32_le(buf, 12, MH_EXECUTE);
    bin.write_u32_le(buf, 16, ncmds);
    bin.write_u32_le(buf, 20, sizeofcmds::u32);
    var hdr_flags: u32 = MH_DYLDLINK | MH_TWOLEVEL;
    if (pie) { hdr_flags = hdr_flags | MH_PIE; }
    bin.write_u32_le(buf, 24, hdr_flags);
    bin.write_u32_le(buf, 28, 0);

    var lc: usize = write_frame_cmds(buf, MACH_HEADER_64_SIZE, itn, dyn, segs, seg_count,
                                     seg_offsets, lay.pagezero_size, lay.text_va,
                                     lay.hdr_span, exec_page);

    if (nstub > 0) {
        var sec: usize = write_segment_cmd(buf, lc, "__STUBS", lay.stubs_va,
                               bin.align_up_u64(lay.stubs_size::u64, exec_page),
                               lay.stubs_off::u64, lay.stubs_size::u64,
                               VM_PROT_READ | VM_PROT_EXECUTE, VM_PROT_READ | VM_PROT_EXECUTE, 1);
        write_section_64(buf, sec, "__stubs", "__STUBS", lay.stubs_va, lay.stubs_size::u64,
                         lay.stubs_off::u32, 4,
                         S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS);
        lc = sec + SECTION_64_SIZE;
    }
    if (ngot > 0) {
        var gsec: usize = write_segment_cmd(buf, lc, "__GOT", lay.got_va,
                               bin.align_up_u64(lay.got_size::u64, exec_page),
                               lay.got_off::u64, lay.got_size::u64,
                               VM_PROT_READ | VM_PROT_WRITE, VM_PROT_READ | VM_PROT_WRITE, 1);
        write_section_64(buf, gsec, "__got", "__GOT", lay.got_va, lay.got_size::u64,
                         lay.got_off::u32, 8, 0);
        lc = gsec + SECTION_64_SIZE;
    }

    lc = macho_dwarf_write(buf, itn, debug, debug_count, lc, ?dw, 0);
    macho_dwarf_write_bytes(buf, debug, debug_count, ?dw);

    lc = write_segment_cmd(buf, lc, "__LINKEDIT", lay.linkedit_va,
                           bin.align_up_u64(lay.linkedit_size::u64, exec_page),
                           lay.linkedit_off::u64, lay.linkedit_size::u64,
                           VM_PROT_READ, VM_PROT_READ, 0);

    var rebase_cmd_off: u32 = 0;
    var rebase_cmd_size: u32 = 0;
    if (lay.rebase_size > 0) { rebase_cmd_off = lay.rebase_off::u32; rebase_cmd_size = lay.rebase_size::u32; }
    bin.write_u32_le(buf, lc, LC_DYLD_INFO_ONLY);
    bin.write_u32_le(buf, lc + 4, DYLD_INFO_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, rebase_cmd_off);
    bin.write_u32_le(buf, lc + 12, rebase_cmd_size);
    bin.write_u32_le(buf, lc + 16, lay.bind_off::u32);
    bin.write_u32_le(buf, lc + 20, lay.bind_size::u32);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, 0);
    bin.write_u32_le(buf, lc + 32, 0);
    bin.write_u32_le(buf, lc + 36, 0);
    bin.write_u32_le(buf, lc + 40, 0);
    bin.write_u32_le(buf, lc + 44, 0);
    lc = lc + DYLD_INFO_CMD_SIZE;

    bin.write_u32_le(buf, lc, LC_SYMTAB);
    bin.write_u32_le(buf, lc + 4, SYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, lay.symtab_off::u32);
    bin.write_u32_le(buf, lc + 12, ngot);
    bin.write_u32_le(buf, lc + 16, lay.strtab_off::u32);
    bin.write_u32_le(buf, lc + 20, lay.strtab_size::u32);
    lc = lc + SYMTAB_CMD_SIZE;

    bin.write_u32_le(buf, lc, LC_DYSYMTAB);
    bin.write_u32_le(buf, lc + 4, DYSYMTAB_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, 0);
    bin.write_u32_le(buf, lc + 12, 0);
    bin.write_u32_le(buf, lc + 16, 0);
    bin.write_u32_le(buf, lc + 20, 0);
    bin.write_u32_le(buf, lc + 24, 0);
    bin.write_u32_le(buf, lc + 28, ngot);
    lc = lc + DYSYMTAB_CMD_SIZE;

    lc = write_load_dylinker(buf, lc);
    di = 0;
    for (di < dyn.lib_count) {
        if (dyn.libs[di].rpath != intern.STR_NIL
            && !rpath_seen_before(dyn.libs, di, dyn.libs[di].rpath)) {
            lc = write_rpath(buf, lc, bin.resolve_name(itn, dyn.libs[di].rpath));
        }
        di = di + 1;
    }
    di = 0;
    for (di < dyn.lib_count) {
        lc = write_load_dylib(buf, lc, bin.resolve_name(itn, dyn.libs[di].soname));
        di = di + 1;
    }

    if (pie) {
        bin.write_u32_le(buf, lc, LC_BUILD_VERSION);
        bin.write_u32_le(buf, lc + 4, BUILD_VERSION_CMD_SIZE::u32);
        bin.write_u32_le(buf, lc + 8, PLATFORM_MACOS);
        bin.write_u32_le(buf, lc + 12, MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 16, MACOS_MIN_VERSION);
        bin.write_u32_le(buf, lc + 20, 0);
        lc = lc + BUILD_VERSION_CMD_SIZE;

        bin.write_u32_le(buf, lc, LC_UUID);
        bin.write_u32_le(buf, lc + 4, UUID_CMD_SIZE::u32);
        write_macho_uuid(buf, lc + 8, name);
        lc = lc + UUID_CMD_SIZE;

        bin.write_u32_le(buf, lc, LC_MAIN);
        bin.write_u32_le(buf, lc + 4, ENTRY_POINT_CMD_SIZE::u32);
        bin.write_u64_le(buf, lc + 8, entry - lay.text_va);
        bin.write_u64_le(buf, lc + 16, image_options.stack_reserve);
        lc = lc + ENTRY_POINT_CMD_SIZE;
    }
    or {
        lc = write_unixthread(buf, lc, arch_id, entry, thread_cmd_size);
    }

    bin.write_u32_le(buf, lc, LC_CODE_SIGNATURE);
    bin.write_u32_le(buf, lc + 4, LINKEDIT_DATA_CMD_SIZE::u32);
    bin.write_u32_le(buf, lc + 8, sig_off::u32);
    bin.write_u32_le(buf, lc + 12, sig_size::u32);

    li = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_offsets[li])::ptr, segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }

    if (nstub > 0) {
        var raw: u32 = 0;
        var n: u32 = 0;
        for (raw < dyn.import_count) {
            if (dyn.imports[raw].is_func) {
                val slot_n: u32 = macho_got_ordinal(dyn, raw);
                val stub_va: u64 = lay.stubs_va + n::u64 * stub_sz::u64;
                val slot_va: u64 = lay.got_va + slot_n::u64 * 8;
                write_macho_stub(buf, arch_id, lay.stubs_off + n::usize * stub_sz,
                                 stub_va, slot_va);
                n = n + 1;
            }
            raw = raw + 1;
        }
    }

    write_rebase_info(buf, lay.rebase_off, dyn, segs, lay.text_va, pz);
    write_bind_info(buf, lay.bind_off, itn, dyn, segs, lay.text_va, pz, lay.got_seg_index);

    buf[lay.strtab_off] = 0;
    var str_pos: usize = 1;
    var sym_off: usize = lay.symtab_off;
    var di2: u32 = 0;
    for (di2 < dyn.import_count) {
        if (import_needs_got(dyn, di2)) {
            val name: str = bin.resolve_name(itn, dyn.imports[di2].symbol);
            var n_strx: u32 = 0;
            if (name != nil) {
                n_strx = str_pos::u32;
                str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, name);
            }
            or {
                buf[lay.strtab_off + str_pos] = 0;
                str_pos = str_pos + 1;
            }
            bin.write_u32_le(buf, sym_off, n_strx);
            buf[sym_off + 4] = N_UNDF | N_EXT;
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, dylib_ordinal_for(dyn, di2)::u16 << 8);
            bin.write_u64_le(buf, sym_off + 8, 0);
            sym_off = sym_off + NLIST_64_SIZE;
        }
        di2 = di2 + 1;
    }

    val fx_r: R.Result[R.Void, str] =
        patch_macho_fixups(buf, arch_id, ?lay, dyn, fixups, fixup_count,
                           seg_offsets, segs, seg_count, nstub);
    var gx_r: R.Result[R.Void, str] = R.ok_void[str]();
    if (R.is_ok[R.Void, str](fx_r)) {
        gx_r = patch_macho_import_addr_fixups(
            buf, ?lay, dyn, seg_offsets, segs, seg_count);
    }
    A.deallocate[usize](alloc, seg_offsets, seg_count::usize);
    macho_dwarf_free(alloc, ?dw, debug_count);
    if (R.is_err[R.Void, str](fx_r) || R.is_err[R.Void, str](gx_r)) {
        A.deallocate[u8](alloc, buf, total_size);
        if (R.is_err[R.Void, str](fx_r)) {
            ret fx_r;
        }
        ret gx_r;
    }

    write_code_signature(buf, sig_off, name, sig_off, 0, exec_limit);

    val wr: R.Result[R.Void, str] = publication.bytes(itn, alloc, path::str, buf, total_size, 0o755, publication.REPLACE, publication.PARENTS_EXIST, "macho: dyn-exec", "macho: could not publish output file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret wr;
}

pub fun parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < MACH_HEADER_64_SIZE) {
        ret R.err[R.Void, str]("macho: object too small");
    }
    if (alloc == nil) { ret R.err[R.Void, str]("macho: no allocator for parse"); }
    if (itn == nil)   { ret R.err[R.Void, str]("macho: no interner for parse"); }

    var parsed: of.ObjectImage = of.object_image_init(alloc, itn, intern.STR_NIL);
    val built: R.Result[R.Void, str] = parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (R.is_err[R.Void, str](built)) {
        val reason: str = R.unwrap_err[R.Void, str](built);
        of.object_image_dnit(?parsed);
        ret R.err[R.Void, str](reason);
    }
    val valid: R.Result[R.Void, str] = of.validate_owned_object_or_dnit(?parsed);
    if (R.is_err[R.Void, str](valid)) { ret valid; }
    @out = parsed;
    ret R.ok_void[str]();
}

fun parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < MACH_HEADER_64_SIZE) {
        ret R.err[R.Void, str]("macho: object too small");
    }
    if (bin.read_u32_le(buf, 0) != MH_MAGIC_64) {
        ret R.err[R.Void, str]("macho: not a 64-bit Mach-O object (bad magic; expected 0xFEEDFACF)");
    }
    if (itn == nil) { ret R.err[R.Void, str]("macho: no interner for parse"); }

    val cputype: u32 = bin.read_u32_le(buf, 4);
    val ncmds:   u32 = bin.read_u32_le(buf, 16);

    var sec_total:   layout.CheckedCount[of.Section] = layout.count[of.Section](0::usize);
    var symoff:      usize = 0;
    var nsyms:       u32 = 0;
    var stroff:      usize = 0;
    var strsize:     usize = 0;
    var have_symtab: bool = false;

    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val vc: R.Result[R.Void, str] = bin.require_region(buf_size, off, 8, "macho: load command out of bounds");
        if (R.is_err[R.Void, str](vc)) { ret vc; }
        val cmd:     u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmdsize < 8) { ret R.err[R.Void, str]("macho: zero-size load command"); }
        val vfull: R.Result[R.Void, str] = bin.require_region(buf_size, off, cmdsize, "macho: load command out of bounds");
        if (R.is_err[R.Void, str](vfull)) { ret vfull; }

        if (cmd == LC_SEGMENT_64) {
            val vseg: R.Result[R.Void, str] = bin.require_region(buf_size, off, SEGMENT_CMD_64_SIZE,
                "macho: segment command out of bounds");
            if (R.is_err[R.Void, str](vseg)) { ret vseg; }
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            val vsects: R.Result[R.Void, str] = bin.require_region(buf_size, off + SEGMENT_CMD_64_SIZE,
                nsects::usize * SECTION_64_SIZE, "macho: segment section headers out of bounds");
            if (R.is_err[R.Void, str](vsects)) { ret vsects; }
            val added: R.Result[layout.CheckedCount[of.Section], layout.CheckCause] =
                layout.count_add[of.Section](sec_total, layout.count[of.Section](nsects::usize));
            if (R.is_err[layout.CheckedCount[of.Section], layout.CheckCause](added)) {
                ret R.err[R.Void, str]("macho: section count exceeds the u32 limit");
            }
            sec_total = R.unwrap_ok[layout.CheckedCount[of.Section], layout.CheckCause](added);
        } or (cmd == LC_SYMTAB) {
            symoff  = bin.read_u32_le(buf, off + 8)::usize;
            nsyms   = bin.read_u32_le(buf, off + 12);
            stroff  = bin.read_u32_le(buf, off + 16)::usize;
            strsize = bin.read_u32_le(buf, off + 20)::usize;
            have_symtab = true;
        }
        off = off + cmdsize;
        c = c + 1;
    }

    val sec_n_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(sec_total.value);
    if (R.is_err[u32, layout.CheckCause](sec_n_fits)) {
        ret R.err[R.Void, str]("macho: section count exceeds the u32 limit");
    }
    val sec_n: u32 = R.unwrap_ok[u32, layout.CheckCause](sec_n_fits);

    if (have_symtab) {
        val vsy: R.Result[R.Void, str] = bin.require_region(buf_size, symoff, nsyms::usize * NLIST_64_SIZE, "macho: symbol table out of bounds");
        if (R.is_err[R.Void, str](vsy)) { ret vsy; }
        val vst: R.Result[R.Void, str] = bin.require_region(buf_size, stroff, strsize, "macho: string table out of bounds");
        if (R.is_err[R.Void, str](vst)) { ret vst; }
    }

    if (sec_n > 0) {
        val rsec: R.Result[*of.Section, str] = A.zallocate[of.Section](alloc, sec_n::usize);
        if (R.is_err[*of.Section, str](rsec)) { ret R.err[R.Void, str]("macho: section array alloc failed"); }
        out.sections = R.unwrap_ok[*of.Section, str](rsec);
        out.section_cap = sec_n;
    }

    var sec_base:   *u64 = nil;
    var sec_anchor: *u32 = nil;
    if (sec_n > 0) {
        val rb: R.Result[*u64, str] = A.zallocate[u64](alloc, sec_n::usize);
        if (R.is_err[*u64, str](rb)) { ret R.err[R.Void, str]("macho: section base table alloc failed"); }
        sec_base = R.unwrap_ok[*u64, str](rb);
        val ra: R.Result[*u32, str] = A.zallocate[u32](alloc, sec_n::usize);
        if (R.is_err[*u32, str](ra)) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret R.err[R.Void, str]("macho: section anchor table alloc failed");
        }
        sec_anchor = R.unwrap_ok[*u32, str](ra);
    }

    val plan: R.Result[u32, str] = plan_section_anchors(buf, buf_size, cputype, ncmds, sec_n, sec_anchor);
    if (R.is_err[u32, str](plan)) {
        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
        ret R.err[R.Void, str](R.unwrap_err[u32, str](plan));
    }
    val anchor_n: u32 = R.unwrap_ok[u32, str](plan);

    if (nsyms + anchor_n > 0) {
        val rsym: R.Result[*of.Symbol, str] = A.zallocate[of.Symbol](alloc, (nsyms + anchor_n)::usize);
        if (R.is_err[*of.Symbol, str](rsym)) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret R.err[R.Void, str]("macho: symbol array alloc failed");
        }
        out.symbols = R.unwrap_ok[*of.Symbol, str](rsym);
        out.symbol_cap = nsyms + anchor_n;
    }
    out.section_count = sec_n;
    out.symbol_count  = nsyms + anchor_n;

    var sec_i: u32 = 0;
    off = MACH_HEADER_64_SIZE;
    c = 0;
    for (c < ncmds) {
        val cmd:     u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var sh: usize = off + SEGMENT_CMD_64_SIZE;
            var k: u32 = 0;
            for (k < nsects) {
                val addr:    u64 = bin.read_u64_le(buf, sh + 32);
                val size:    u64 = bin.read_u64_le(buf, sh + 40);
                val sec_off: usize = bin.read_u32_le(buf, sh + 48)::usize;
                val align_l: u32 = bin.read_u32_le(buf, sh + 52);
                val flags:   u32 = bin.read_u32_le(buf, sh + 64);
                val is_text:       bool = fixed16_equals(buf, sh + 16, "__TEXT");
                val is_data_const: bool = fixed16_equals(buf, sh + 16, "__DATA_CONST");
                val is_rodata:     bool = fixed16_equals(buf, sh + 16, "__RODATA");
                val kind:    of.SectionKind = macho_kind_from(flags, is_text, is_data_const, is_rodata);

                var name_buf: [17]u8;
                var ni: usize = 0;
                for (ni < 16) { name_buf[ni] = buf[sh + ni]; ni = ni + 1; }
                name_buf[16] = 0;
                var canon_buf: [17]u8;
                var canon: str = canonical_sectname((?name_buf[0])::str, ?canon_buf[0]);
                if (kind != of.SK_DEBUG && str_equals(canon, macho_sectname(kind))) {
                    canon = of.canonical_section_name(kind);
                }
                val rin: R.Result[intern.StrId, str] = intern.intern(itn, canon);
                if (R.is_err[intern.StrId, str](rin)) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rin));
                }

                out.sections[sec_i].name  = R.unwrap_ok[intern.StrId, str](rin);
                out.sections[sec_i].kind  = kind;
                out.sections[sec_i].flags = 0;
                if ((flags & SECTION_TYPE) == S_MOD_INIT_FUNC_POINTERS) {
                    out.sections[sec_i].flags = of.SEC_FLAG_INIT_FUNCS;
                }
                out.sections[sec_i].len   = size::u32;
                out.sections[sec_i].align = (1::u32) << align_l;
                out.sections[sec_i].bytes = nil;
                sec_base[sec_i] = addr;

                if (sec_anchor[sec_i] != ANCHOR_NONE) {
                    var ident_buf: [SECTION_IDENTITY_SIZE]u8;
                    val ident: str = section_identity(buf, sh, ?ident_buf[0]);
                    val rid: R.Result[intern.StrId, str] = intern.intern(itn, ident);
                    if (R.is_err[intern.StrId, str](rid)) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rid));
                    }
                    val ax: u32 = nsyms + sec_anchor[sec_i];
                    out.symbols[ax].name    = R.unwrap_ok[intern.StrId, str](rid);
                    out.symbols[ax].section = sec_i;
                    out.symbols[ax].offset  = 0;
                    out.symbols[ax].size    = 0;
                    out.symbols[ax].flags   = 0;
                }

                if (kind != of.SK_BSS && size > 0) {
                    if (!bin.region_ok(buf_size, sec_off, size::usize)) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret R.err[R.Void, str]("macho: section data out of bounds");
                    }
                    val rbytes: R.Result[*u8, str] = A.allocate[u8](alloc, size::usize);
                    if (R.is_err[*u8, str](rbytes)) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret R.err[R.Void, str]("macho: section bytes alloc failed");
                    }
                    out.sections[sec_i].bytes = R.unwrap_ok[*u8, str](rbytes);
                    memory.raw_copy(out.sections[sec_i].bytes::ptr, (buf::usize + sec_off)::ptr, size::usize);
                }
                sec_i = sec_i + 1;
                sh = sh + SECTION_64_SIZE;
                k = k + 1;
            }
        }
        off = off + cmdsize;
        c = c + 1;
    }

    var si: u32 = 0;
    for (si < nsyms) {
        val so: usize = symoff + si::usize * NLIST_64_SIZE;
        val n_strx:  u32 = bin.read_u32_le(buf, so);
        val n_type:  u8  = buf[so + 4];
        val n_sect:  u8  = buf[so + 5];
        val n_desc:  u16 = bin.read_u16_le(buf, so + 6);
        val n_value: u64 = bin.read_u64_le(buf, so + 8);

        val rnm: R.Result[str, str] = bin.cstr_at(buf, buf_size, stroff + n_strx::usize);
        if (R.is_err[str, str](rnm)) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret R.err[R.Void, str](R.unwrap_err[str, str](rnm));
        }
        val rin: R.Result[intern.StrId, str] = intern.intern(itn, R.unwrap_ok[str, str](rnm));
        if (R.is_err[intern.StrId, str](rin)) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rin));
        }
        out.symbols[si].name = R.unwrap_ok[intern.StrId, str](rin);
        out.symbols[si].size = 0;

        var flags: u32 = 0;
        if ((n_type & N_EXT) != 0)      { flags = flags | of.SYM_OBJ_FLAG_GLOBAL; }
        if ((n_desc & N_WEAK_DEF) != 0) { flags = flags | of.SYM_OBJ_FLAG_WEAK; }
        if ((n_type & N_TYPE) == N_UNDF) {
            flags = flags | of.SYM_OBJ_FLAG_EXTERN;
            if ((n_type & N_EXT) != 0 && n_value != 0) {
                flags = flags | of.SYM_OBJ_FLAG_COMMON;
                out.symbols[si].size = n_value::u32;
                out.symbols[si].align = 1;
                val log2a: u32 = (n_desc::u32 >> 8) & 0xF;
                if (log2a > 0 && log2a < 32) { out.symbols[si].align = 1 << log2a; }
            }
            if ((n_desc & REFERENCE_TYPE_MASK) == REFERENCE_FLAG_UNDEFINED_LAZY) { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            out.symbols[si].section = of.SECTION_EXTERNAL;
            out.symbols[si].offset = 0;
        } or (n_sect >= 1 && (n_sect - 1)::u32 < sec_n) {
            val sidx: u32 = (n_sect - 1)::u32;
            out.symbols[si].section = sidx;
            out.symbols[si].offset = (n_value - sec_base[sidx])::u32;
            flags = flags | of.SYM_OBJ_FLAG_SIZE_UNKNOWN;
            if (out.sections[sidx].kind == of.SK_TEXT) { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            or                                         { flags = flags | of.SYM_OBJ_FLAG_OBJECT; }
        } or {
            out.symbols[si].section = of.SECTION_EXTERNAL;
            out.symbols[si].offset = 0;
        }
        out.symbols[si].flags = flags;
        si = si + 1;
    }

    val rel_total: R.Result[u32, str] = count_relocs(buf, buf_size, cputype, ncmds);
    if (R.is_err[u32, str](rel_total)) {
        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
        ret R.err[R.Void, str](R.unwrap_err[u32, str](rel_total));
    }
    val rel_n: u32 = R.unwrap_ok[u32, str](rel_total);
    if (rel_n > 0) {
        val rrel: R.Result[*of.Relocation, str] = A.zallocate[of.Relocation](alloc, rel_n::usize);
        if (R.is_err[*of.Relocation, str](rrel)) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret R.err[R.Void, str]("macho: reloc array alloc failed");
        }
        out.relocations = R.unwrap_ok[*of.Relocation, str](rrel);
        out.reloc_cap = rel_n;
    }
    out.reloc_count = rel_n;

    val rp: R.Result[R.Void, str] = populate_relocs(alloc, itn, buf, buf_size, cputype, ncmds,
                                                  sec_base, sec_anchor, nsyms, out);
    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
    if (R.is_err[R.Void, str](rp)) { ret rp; }
    ret R.ok_void[str]();
}

fun free_parse_scratch(alloc: *A.Allocator, sec_base: *u64, sec_anchor: *u32, sec_n: u32) {
    if (sec_base != nil)   { A.deallocate[u64](alloc, sec_base, sec_n::usize); }
    if (sec_anchor != nil) { A.deallocate[u32](alloc, sec_anchor, sec_n::usize); }
}

fun plan_section_anchors(buf: *u8, buf_size: usize, cputype: u32, ncmds: u32, sec_n: u32,
                         out: *u32) R.Result[u32, str] {
    var i: u32 = 0;
    for (i < sec_n) { out[i] = ANCHOR_NONE; i = i + 1; }

    var anchors: u32 = 0;
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd:     u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var sh: usize = off + SEGMENT_CMD_64_SIZE;
            var k: u32 = 0;
            for (k < nsects) {
                val reloff: usize = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32 = bin.read_u32_le(buf, sh + 60);
                val vr: R.Result[R.Void, str] = bin.require_region(buf_size, reloff, nreloc::usize * RELOC_INFO_SIZE, "macho: relocation array out of bounds");
                if (R.is_err[R.Void, str](vr)) { ret R.err[u32, str](R.unwrap_err[R.Void, str](vr)); }
                var r: u32 = 0;
                for (r < nreloc) {
                    val word: u32 = bin.read_u32_le(buf, reloff + r::usize * RELOC_INFO_SIZE + 4);
                    val r_type: u32 = (word >> 28) & 0xF;
                    if (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_ADDEND) { r = r + 1; cnt; }
                    if (((word >> 27) & 0x1) == 0) {
                        val symnum: u32 = word & 0xFFFFFF;
                        if (symnum < 1 || symnum > sec_n) {
                            ret R.err[u32, str]("macho: section-relative relocation names an out-of-range section");
                        }
                        if (out[symnum - 1] == ANCHOR_NONE) {
                            out[symnum - 1] = anchors;
                            anchors = anchors + 1;
                        }
                    }
                    r = r + 1;
                }
                sh = sh + SECTION_64_SIZE;
                k = k + 1;
            }
        }
        off = off + cmdsize;
        c = c + 1;
    }
    ret R.ok[u32, str](anchors);
}

fun count_relocs(buf: *u8, buf_size: usize, cputype: u32, ncmds: u32) R.Result[u32, str] {
    var total: usize = 0;
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd:     u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var sh: usize = off + SEGMENT_CMD_64_SIZE;
            var k: u32 = 0;
            for (k < nsects) {
                val reloff: usize = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32 = bin.read_u32_le(buf, sh + 60);
                val vr: R.Result[R.Void, str] = bin.require_region(buf_size, reloff, nreloc::usize * RELOC_INFO_SIZE, "macho: relocation array out of bounds");
                if (R.is_err[R.Void, str](vr)) { ret R.err[u32, str](R.unwrap_err[R.Void, str](vr)); }
                var r: u32 = 0;
                for (r < nreloc) {
                    val word: u32 = bin.read_u32_le(buf, reloff + r::usize * RELOC_INFO_SIZE + 4);
                    val r_type: u32 = (word >> 28) & 0xF;
                    if (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_ADDEND) { r = r + 1; cnt; }
                    if (cputype == CPU_TYPE_X86_64 && r_type == X86_64_RELOC_SUBTRACTOR) { r = r + 1; cnt; }
                    total = total + 1;
                    r = r + 1;
                }
                sh = sh + SECTION_64_SIZE;
                k = k + 1;
            }
        }
        off = off + cmdsize;
        c = c + 1;
    }
    val fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(total);
    if (R.is_err[u32, layout.CheckCause](fits)) {
        ret R.err[u32, str]("macho: relocation count exceeds the u32 limit");
    }
    ret R.ok[u32, str](R.unwrap_ok[u32, layout.CheckCause](fits));
}

fun populate_relocs(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, cputype: u32, ncmds: u32,
                    sec_base: *u64, sec_anchor: *u32, nsyms: u32, out: *of.ObjectImage) R.Result[R.Void, str] {
    var rel_i: u32 = 0;
    var sec_i: u32 = 0;
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        val cmd:     u32 = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var sh: usize = off + SEGMENT_CMD_64_SIZE;
            var k: u32 = 0;
            for (k < nsects) {
                val reloff: usize = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32 = bin.read_u32_le(buf, sh + 60);
                var pending: i64 = 0;
                var have_pending: bool = false;
                var sub_sym: u32 = 0;
                var have_sub: bool = false;
                var sub_addr: u32 = 0;
                var r: u32 = 0;
                for (r < nreloc) {
                    val e: usize = reloff + r::usize * RELOC_INFO_SIZE;
                    val address: u32 = bin.read_u32_le(buf, e);
                    val word:    u32 = bin.read_u32_le(buf, e + 4);
                    val symnum:  u32 = word & 0xFFFFFF;
                    val pcrel:   u32 = (word >> 24) & 0x1;
                    val r_length: u32 = (word >> 25) & 0x3;
                    val extn:    u32 = (word >> 27) & 0x1;
                    val r_type:  u32 = (word >> 28) & 0xF;

                    if (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_ADDEND) {
                        pending = sign_extend24(symnum);
                        have_pending = true;
                        r = r + 1;
                        cnt;
                    }
                    if (cputype == CPU_TYPE_X86_64 && r_type == X86_64_RELOC_SUBTRACTOR) {
                        if (have_sub) {
                            ret R.err[R.Void, str]("macho: two X86_64_RELOC_SUBTRACTOR entries in a row; each one pairs with the UNSIGNED that follows it");
                        }
                        if (extn == 0) {
                            ret R.err[R.Void, str]("macho: X86_64_RELOC_SUBTRACTOR is not symbol-based");
                        }
                        if (symnum >= nsyms) { ret R.err[R.Void, str]("macho: relocation symbol index out of range"); }
                        if (r_length != 2 && r_length != 3) {
                            ret R.err[R.Void, str]("macho: X86_64_RELOC_SUBTRACTOR field is neither 4 nor 8 bytes");
                        }
                        sub_sym  = symnum;
                        sub_addr = address;
                        have_sub = true;
                        r = r + 1;
                        cnt;
                    }
                    if (have_sub) {
                        if (r_type != X86_64_RELOC_UNSIGNED) {
                            ret R.err[R.Void, str]("macho: X86_64_RELOC_SUBTRACTOR is not followed by X86_64_RELOC_UNSIGNED");
                        }
                        if (address != sub_addr) {
                            ret R.err[R.Void, str]("macho: the halves of an X86_64_RELOC_SUBTRACTOR pair patch different addresses");
                        }
                    }
                    if (cputype == CPU_TYPE_X86_64 && x64_is_signed(r_type) && pcrel == 0) {
                        ret R.err[R.Void, str]("macho: x86_64 signed relocation is not pc-relative");
                    }
                    if (cputype == CPU_TYPE_X86_64
                        && (r_type == X86_64_RELOC_GOT_LOAD || r_type == X86_64_RELOC_GOT)) {
                        if (pcrel == 0) {
                            ret R.err[R.Void, str]("macho: x86_64 GOT relocation is not pc-relative");
                        }
                        if (extn == 0) {
                            ret R.err[R.Void, str]("macho: x86_64 GOT relocation is not symbol-based");
                        }
                        if (r_type == X86_64_RELOC_GOT_LOAD
                            && !x64_got_load_insn(out.sections[sec_i].bytes,
                                                  out.sections[sec_i].len::usize,
                                                  address::usize)) {
                            ret R.err[R.Void, str]("macho: x86_64 GOT_LOAD relocation does not patch a RIP-relative MOVQ");
                        }
                    }
                    if (extn != 0 && symnum >= nsyms) { ret R.err[R.Void, str]("macho: relocation symbol index out of range"); }

                    var insn: u32 = 0;
                    if (out.sections[sec_i].bytes != nil && (address::usize + 4) <= out.sections[sec_i].len::usize) {
                        insn = bin.read_u32_le(out.sections[sec_i].bytes, address::usize);
                    }
                    val rk: R.Result[of.RelocKind, str] = reloc_kind_for(itn, alloc, cputype, r_type, r_length, insn);
                    if (R.is_err[of.RelocKind, str](rk)) { ret R.err[R.Void, str](R.unwrap_err[of.RelocKind, str](rk)); }
                    val kind: of.RelocKind = R.unwrap_ok[of.RelocKind, str](rk);

                    var target: u32 = symnum;
                    var addend: i64 = 0;
                    if (extn != 0) {
                        val ra: R.Result[i64, str] = recover_addend(out, sec_i, address, cputype, kind,
                                                                    r_type, pcrel, pending, have_pending);
                        if (R.is_err[i64, str](ra)) { ret R.err[R.Void, str](R.unwrap_err[i64, str](ra)); }
                        addend = R.unwrap_ok[i64, str](ra);
                    } or {
                        val tsec: u32 = symnum - 1;
                        target = nsyms + sec_anchor[tsec];
                        val sa: R.Result[i64, str] = section_addend(itn, alloc, out, sec_base, sec_i, tsec,
                                                                    address, cputype, kind, r_type, pcrel);
                        if (R.is_err[i64, str](sa)) { ret R.err[R.Void, str](R.unwrap_err[i64, str](sa)); }
                        addend = R.unwrap_ok[i64, str](sa);
                    }

                    var out_kind: of.RelocKind = kind;
                    var out_sym2: u32 = 0;
                    if (have_sub) {
                        if (r_length == 3)      { out_kind = of.RK_DIFF64; }
                        or (r_length == 2)      { out_kind = of.RK_DIFF32; }
                        or {
                            ret R.err[R.Void, str]("macho: an X86_64_RELOC_SUBTRACTOR pair writes neither 4 nor 8 bytes");
                        }
                        out_sym2 = sub_sym;
                    }

                    out.relocations[rel_i].section = sec_i;
                    out.relocations[rel_i].offset  = address;
                    out.relocations[rel_i].kind    = out_kind;
                    out.relocations[rel_i].sym     = target;
                    out.relocations[rel_i].addend  = addend;
                    out.relocations[rel_i].sym2    = out_sym2;
                    rel_i = rel_i + 1;
                    pending = 0;
                    have_pending = false;
                    sub_sym = 0;
                    have_sub = false;
                    sub_addr = 0;
                    r = r + 1;
                }
                if (have_sub) {
                    ret R.err[R.Void, str]("macho: an X86_64_RELOC_SUBTRACTOR ends the section's relocations with no UNSIGNED to pair with");
                }
                sec_i = sec_i + 1;
                sh = sh + SECTION_64_SIZE;
                k = k + 1;
            }
        }
        off = off + cmdsize;
        c = c + 1;
    }
    ret R.ok_void[str]();
}

fun sign_extend24(v: u32) i64 {
    var a: i64 = (v & 0xFFFFFF)::i64;
    if ((v & 0x800000) != 0) { a = a - 0x1000000; }
    ret a;
}

fun recover_addend(out: *of.ObjectImage, sec_i: u32, address: u32, cputype: u32, kind: of.RelocKind,
                   r_type: u32, pcrel: u32, pending: i64, have_pending: bool) R.Result[i64, str] {
    val bytes: *u8 = out.sections[sec_i].bytes;
    val len:   usize = out.sections[sec_i].len::usize;
    if (kind == of.RK_ABS64) {
        if (bytes == nil || (address::usize + 8) > len) { ret R.err[i64, str]("macho: relocation field out of bounds"); }
        val addend: i64 = bin.read_u64_le(bytes, address::usize)::i64;
        bin.write_u64_le(bytes, address::usize, 0);
        ret R.ok[i64, str](addend);
    }
    if (kind == of.RK_ABS32) {
        if (bytes == nil || (address::usize + 4) > len) { ret R.err[i64, str]("macho: relocation field out of bounds"); }
        val addend: i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        bin.write_u32_le(bytes, address::usize, 0);
        ret R.ok[i64, str](addend);
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        if (bytes == nil || (address::usize + 8) > len) { ret R.err[i64, str]("macho: relocation field out of bounds"); }
        val raw: u64 = bin.read_u64_le(bytes, address::usize);
        bin.write_u64_le(bytes, address::usize, 0);
        ret R.ok[i64, str](add_u64_mod(raw, 0xFFFFFFFFFFFFFFF8)::i64);
    }
    if (cputype == CPU_TYPE_ARM64) {
        if (have_pending) { ret R.ok[i64, str](pending); }
        ret R.ok[i64, str](0);
    }
    if (pcrel != 0) {
        if (bytes == nil || (address::usize + 4) > len) { ret R.err[i64, str]("macho: relocation field out of bounds"); }
        val raw:  i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        val bias: i64 = x64_pcrel_bias(r_type);
        bin.write_u32_le(bytes, address::usize, 0);
        ret R.ok[i64, str]((raw + bias) - (4 + bias));
    }
    ret R.ok[i64, str](0);
}

fun section_addend(itn: *intern.Interner, alloc: *A.Allocator, out: *of.ObjectImage, sec_base: *u64,
                   sec_i: u32, tsec: u32, address: u32, cputype: u32, kind: of.RelocKind,
                   r_type: u32, pcrel: u32) R.Result[i64, str] {
    val bytes: *u8 = out.sections[sec_i].bytes;
    val len:   usize = out.sections[sec_i].len::usize;
    var target: u64 = 0;
    if (pcrel == 0 && kind == of.RK_ABS64) {
        if (bytes == nil || (address::usize + 8) > len) { ret R.err[i64, str]("macho: section-relative relocation field out of bounds"); }
        target = bin.read_u64_le(bytes, address::usize);
        bin.write_u64_le(bytes, address::usize, 0);
    } or (pcrel == 0 && kind == of.RK_ABS32) {
        if (bytes == nil || (address::usize + 4) > len) { ret R.err[i64, str]("macho: section-relative relocation field out of bounds"); }
        target = bin.read_u32_le(bytes, address::usize)::u64;
        bin.write_u32_le(bytes, address::usize, 0);
    } or (pcrel != 0 && cputype != CPU_TYPE_ARM64 && (kind == of.RK_PC32 || kind == of.RK_PLT32)) {
        if (bytes == nil || (address::usize + 4) > len) { ret R.err[i64, str]("macho: section-relative relocation field out of bounds"); }
        val disp: i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        val bias: i64 = x64_pcrel_bias(r_type);
        val tail: u64 = address::u64 + (4 + bias)::u64;
        if (sec_base[sec_i] > 0xFFFFFFFFFFFFFFFF - tail) {
            ret R.err[i64, str]("macho: section-relative relocation target overflows address space");
        }
        val pc: u64 = sec_base[sec_i] + tail;
        if (disp >= 0) {
            if (pc > 0xFFFFFFFFFFFFFFFF - disp::u64) {
                ret R.err[i64, str]("macho: section-relative relocation target overflows address space");
            }
            target = pc + disp::u64;
        } or {
            val magnitude: u64 = (-disp)::u64;
            if (pc < magnitude) { ret R.err[i64, str]("macho: section-relative relocation targets before its section"); }
            target = pc - magnitude;
        }
        bin.write_u32_le(bytes, address::usize, 0);
    } or {
        ret R.err[i64, str](unsupported_section_kind_message(itn, alloc, kind));
    }

    val base: u64 = sec_base[tsec];
    if (target < base) { ret R.err[i64, str]("macho: section-relative relocation targets before its section"); }
    val offset: u64 = target - base;
    if (offset > 0x7FFFFFFFFFFFFFFF) { ret R.err[i64, str]("macho: section-relative relocation addend overflows i64"); }
    if (pcrel != 0) { ret R.ok[i64, str](offset::i64 - (4 + x64_pcrel_bias(r_type))); }
    ret R.ok[i64, str](offset::i64);
}

fun t_isa(id: u32) of.ObjectTarget {
    var vt: isa.IsaVTable = isa.machine_isa(id, "test", 0, 8, nil, nil, nil);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

fun t_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: R.Result[intern.StrId, str] = intern.intern(itn, s);
    if (R.is_err[intern.StrId, str](r)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun t_find_lc(buf: *u8, cmd: u32) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == cmd) { ret off; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret 0;
}

fun t_find_seg(buf: *u8, name: str) usize {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c: u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == LC_SEGMENT_64 && fixed16_equals(buf, off + 8, name)) { ret off; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret 0;
}

fun ts_x64_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k: usize = 0;
    for (k < 24) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[0] = 0xE8;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 24; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 24; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name = t_intern(?i, "ext_func"); syms[2].section = of.SECTION_EXTERNAL;
    syms[2].offset = 0; syms[2].size = 0; syms[2].flags = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [3]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1;  relocs[0].kind = of.RK_PLT32;
    relocs[0].sym = 2; relocs[0].addend = -4;
    relocs[1].section = 0; relocs[1].offset = 8;  relocs[1].kind = of.RK_PC32;
    relocs[1].sym = 1; relocs[1].addend = -4;
    relocs[2].section = 0; relocs[2].offset = 16; relocs[2].kind = of.RK_ABS64;
    relocs[2].sym = 1; relocs[2].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 3;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_x64");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64)     { ret 1; }
    if (bin.read_u32_le(buf.data, 4) != CPU_TYPE_X86_64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_OBJECT)      { ret 1; }
    if (bin.read_u32_le(buf.data, 16) != 3)              { ret 1; }
    if (bin.read_u32_le(buf.data, MACH_HEADER_64_SIZE + 64) != 2) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 2) { ret 1; }
    if (out.symbol_count != 3)  { ret 1; }
    if (out.reloc_count != 3)   { ret 1; }
    if (out.sections[0].kind != of.SK_TEXT || out.sections[0].len != 24) { ret 1; }
    if (out.sections[1].kind != of.SK_DATA || out.sections[1].len != 8)  { ret 1; }
    if (out.sections[0].align != 16 || out.sections[1].align != 8)       { ret 1; }
    if (out.sections[0].bytes == nil)                                    { ret 1; }
    if (out.sections[0].bytes[0] != 0xE8)                                { ret 1; }

    var saw_main: bool = false;
    var saw_ext:  bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[0].name) {
            saw_main = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
            if (out.symbols[si].section != 0)                            { ret 1; }
        }
        if (out.symbols[si].name == syms[2].name) {
            saw_ext = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) == 0) { ret 1; }
            if (out.symbols[si].section != of.SECTION_EXTERNAL)        { ret 1; }
        }
        si = si + 1;
    }
    if (!saw_main || !saw_ext) { ret 1; }

    var ok_plt: bool = false;
    var ok_pc:  bool = false;
    var ok_abs: bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.offset == 1 && rr.kind == of.RK_PLT32 && of.reloc_symbol_name(?out, rr) == syms[2].name && rr.addend == -4) { ok_plt = true; }
        if (rr.offset == 8 && rr.kind == of.RK_PC32 && of.reloc_symbol_name(?out, rr) == syms[1].name && rr.addend == -4)  { ok_pc = true; }
        if (rr.offset == 16 && rr.kind == of.RK_ABS64 && of.reloc_symbol_name(?out, rr) == syms[1].name && rr.addend == 0) { ok_abs = true; }
        rj = rj + 1;
    }
    if (!ok_plt || !ok_pc || !ok_abs) { ret 1; }
    ret 0;
}

fun ts_x64_got_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var data_bytes: [32]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0; k = k + 1; }
    k = 0;
    for (k < 32) { data_bytes[k] = 0; k = k + 1; }
    text_bytes[0] = 0x48; text_bytes[1] = 0x8B; text_bytes[2] = 0x05;

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 32; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "_external"); syms[1].section = of.SECTION_EXTERNAL;
    syms[1].offset = 0; syms[1].size = 0; syms[1].flags = of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [5]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 3; relocs[0].kind = of.RK_GOTPCREL;
    relocs[0].sym = 1; relocs[0].addend = -4;
    relocs[1].section = 1; relocs[1].offset = 0; relocs[1].kind = of.RK_GOTPCREL_NORELAX;
    relocs[1].sym = 1; relocs[1].addend = -4;
    relocs[2].section = 1; relocs[2].offset = 8; relocs[2].kind = of.RK_GOTPCREL64_NORELAX;
    relocs[2].sym = 1; relocs[2].addend = -8;
    relocs[3].section = 1; relocs[3].offset = 16; relocs[3].kind = of.RK_GOTPCREL64_NORELAX;
    relocs[3].sym = 1; relocs[3].addend = 9223372036854775807;
    relocs[4].section = 1; relocs[4].offset = 24; relocs[4].kind = of.RK_GOTPCREL64_NORELAX;
    relocs[4].sym = 1; relocs[4].addend = -9223372036854775807 - 1;

    var img: of.ObjectImage;
    img.alloc = ?alloc; img.interner = ?i; img.name = t_intern(?i, "got");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 5;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_got");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);
    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val text_sh: usize = seg + SEGMENT_CMD_64_SIZE;
    val data_sh: usize = text_sh + SECTION_64_SIZE;
    val load_e: usize = t_find_reloc(buf.data, text_sh, 3);
    val got32_e: usize = t_find_reloc(buf.data, data_sh, 0);
    val got64_e: usize = t_find_reloc(buf.data, data_sh, 8);
    val got64_max_e: usize = t_find_reloc(buf.data, data_sh, 16);
    val got64_min_e: usize = t_find_reloc(buf.data, data_sh, 24);
    if (load_e == 0 || got32_e == 0 || got64_e == 0
        || got64_max_e == 0 || got64_min_e == 0) { ret 1; }
    val load_w: u32 = bin.read_u32_le(buf.data, load_e + 4);
    val got32_w: u32 = bin.read_u32_le(buf.data, got32_e + 4);
    val got64_w: u32 = bin.read_u32_le(buf.data, got64_e + 4);
    if (((load_w >> 28) & 0xF) != X86_64_RELOC_GOT_LOAD || ((load_w >> 25) & 3) != 2) { ret 1; }
    if (((got32_w >> 28) & 0xF) != X86_64_RELOC_GOT || ((got32_w >> 25) & 3) != 2) { ret 1; }
    if (((got64_w >> 28) & 0xF) != X86_64_RELOC_GOT || ((got64_w >> 25) & 3) != 3) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr) || out.reloc_count != 5) { ret 1; }
    if (t_reloc_at(?out, 0, 3).kind != of.RK_GOTPCREL
        || t_reloc_at(?out, 0, 3).addend != -4) { ret 1; }
    if (t_reloc_at(?out, 1, 0).kind != of.RK_GOTPCREL_NORELAX
        || t_reloc_at(?out, 1, 0).addend != -4) { ret 1; }
    if (t_reloc_at(?out, 1, 8).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 8).addend != -8) { ret 1; }
    if (t_reloc_at(?out, 1, 16).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 16).addend != 9223372036854775807) { ret 1; }
    if (t_reloc_at(?out, 1, 24).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 24).addend != -9223372036854775807 - 1) { ret 1; }

    bin.write_u32_le(buf.data, load_e + 4, load_w & 0xFEFFFFFF);
    var bad_pc: of.ObjectImage;
    val pp: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_pc);
    if (R.is_ok[R.Void, str](pp) || !str_contains(R.unwrap_err[R.Void, str](pp), "not pc-relative")) { ret 1; }
    bin.write_u32_le(buf.data, load_e + 4, load_w);

    val text_off: usize = bin.read_u32_le(buf.data, text_sh + 48)::usize;
    buf.data[text_off + 1] = 0x8D;
    var bad_insn: of.ObjectImage;
    val pi: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_insn);
    if (R.is_ok[R.Void, str](pi) || !str_contains(R.unwrap_err[R.Void, str](pi), "RIP-relative MOVQ")) { ret 1; }
    buf.data[text_off + 1] = 0x8B;

    bin.write_u32_le(buf.data, got32_e + 4, (got32_w & 0xF9FFFFFF) | (1 << 25));
    var bad_width: of.ObjectImage;
    val pw: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_width);
    if (R.is_ok[R.Void, str](pw) || !str_contains(R.unwrap_err[R.Void, str](pw), "neither 4 nor 8 bytes")) { ret 1; }
    ret 0;
}

fun ts_x64_signed_variants() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0; k = k + 1; }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -5;
    relocs[1].section = 0; relocs[1].offset = 4; relocs[1].kind = of.RK_PC32;
    relocs[1].sym = 1; relocs[1].addend = -6;
    relocs[2].section = 0; relocs[2].offset = 8; relocs[2].kind = of.RK_PC32;
    relocs[2].sym = 1; relocs[2].addend = -8;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "signed");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_signed");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);
    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0: usize = seg + SEGMENT_CMD_64_SIZE;
    val text_off: usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    if (!t_set_reloc_type(buf.data, sh0, 0, X86_64_RELOC_SIGNED_1)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 4, X86_64_RELOC_SIGNED_2)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 8, X86_64_RELOC_SIGNED_4)) { ret 1; }
    if (bin.read_u32_le(buf.data, text_off)     != 0xFFFFFFFF) { ret 1; }
    if (bin.read_u32_le(buf.data, text_off + 4) != 0xFFFFFFFE) { ret 1; }
    if (bin.read_u32_le(buf.data, text_off + 8) != 0xFFFFFFFC) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    val r1: *of.Relocation = t_reloc_at(?out, 0, 0);
    val r2: *of.Relocation = t_reloc_at(?out, 0, 4);
    val r4: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (r1 == nil || r2 == nil || r4 == nil) { ret 1; }
    if (r1.kind != of.RK_PC32 || r1.addend != -5) { ret 1; }
    if (r2.kind != of.RK_PC32 || r2.addend != -6) { ret 1; }
    if (r4.kind != of.RK_PC32 || r4.addend != -8) { ret 1; }

    val tf2_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_signed_rt");
    if (R.is_err[fs.TempFile, str](tf2_r)) { ret 1; }
    var tf2: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf2_r);
    val tpath2: str = fs.temp_path(?tf2);
    val em2: R.Result[R.Void, str] = emit_object(?isa_vt, ?out, tpath2::*u8);
    if (R.is_err[R.Void, str](em2)) { fs.temp_close_and_remove(?tf2); ret 1; }
    val rb2: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath2);
    fs.temp_close_and_remove(?tf2);
    if (R.is_err[Vector[u8], str](rb2)) { ret 1; }
    val buf2: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb2);
    val seg2: usize = t_find_lc(buf2.data, LC_SEGMENT_64);
    if (seg2 == 0) { ret 1; }
    val sh2: usize = seg2 + SEGMENT_CMD_64_SIZE;
    val e1: usize = t_find_reloc(buf2.data, sh2, 0);
    val e2: usize = t_find_reloc(buf2.data, sh2, 4);
    val e4: usize = t_find_reloc(buf2.data, sh2, 8);
    if (e1 == 0 || e2 == 0 || e4 == 0) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e1 + 4) >> 28) & 0xF) != X86_64_RELOC_SIGNED) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e2 + 4) >> 28) & 0xF) != X86_64_RELOC_SIGNED) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e4 + 4) >> 28) & 0xF) != X86_64_RELOC_SIGNED) { ret 1; }
    var out2: of.ObjectImage;
    val pr2: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf2.data, buf2.len, ?out2);
    if (R.is_err[R.Void, str](pr2)) { ret 1; }
    if (t_reloc_at(?out2, 0, 0).addend != -5 || t_reloc_at(?out2, 0, 4).addend != -6
        || t_reloc_at(?out2, 0, 8).addend != -8) { ret 1; }

    val original_word: u32 = bin.read_u32_le(buf.data, t_find_reloc(buf.data, sh0, 8) + 4);
    bin.write_u32_le(buf.data, t_find_reloc(buf.data, sh0, 8), 14);
    var bad_bounds: of.ObjectImage;
    val pb: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_bounds);
    if (R.is_ok[R.Void, str](pb) || !str_contains(R.unwrap_err[R.Void, str](pb), "out of bounds")) { ret 1; }
    bin.write_u32_le(buf.data, t_find_reloc(buf.data, sh0, 14), 8);
    val e_bad: usize = t_find_reloc(buf.data, sh0, 8);
    bin.write_u32_le(buf.data, e_bad + 4, (original_word & 0xF9FFFFFF) | (1 << 25));
    var bad_width: of.ObjectImage;
    val pw: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_width);
    if (R.is_ok[R.Void, str](pw) || !str_contains(R.unwrap_err[R.Void, str](pw), "not 4 bytes")) { ret 1; }
    bin.write_u32_le(buf.data, e_bad + 4, original_word & 0xFEFFFFFF);
    var bad_pcrel: of.ObjectImage;
    val pp: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_pcrel);
    if (R.is_ok[R.Void, str](pp) || !str_contains(R.unwrap_err[R.Void, str](pp), "not pc-relative")) { ret 1; }
    ret 0;
}

fun ts_relro_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes:  [8]u8;
    var ro_bytes:    [8]u8;
    var relro_bytes: [8]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0; ro_bytes[k] = 0; relro_bytes[k] = 0; k = k + 1; }

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".rodata"); secs[1].kind = of.SK_RODATA;
    secs[1].bytes = ?ro_bytes[0]; secs[1].len = 8; secs[1].align = 8;
    secs[2].name = t_intern(?i, ".data.rel.ro"); secs[2].kind = of.SK_RELRO;
    secs[2].bytes = ?relro_bytes[0]; secs[2].len = 8; secs[2].align = 8;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 2; relocs[0].offset = 0; relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 0; relocs[0].addend = 0x10;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_relro");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 3) { ret 1; }
    var saw_text:  bool = false;
    var saw_ro:    bool = false;
    var saw_relro: bool = false;
    var s: u32 = 0;
    for (s < out.section_count) {
        if (out.sections[s].kind == of.SK_TEXT)   { saw_text = true; }
        if (out.sections[s].kind == of.SK_RODATA) { saw_ro = true; }
        if (out.sections[s].kind == of.SK_RELRO)  { saw_relro = true; }
        s = s + 1;
    }
    if (!saw_text || !saw_ro || !saw_relro) { ret 1; }

    if (out.reloc_count != 1) { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS64 || out.relocations[0].addend != 0x10) { ret 1; }
    ret 0;
}

fun ts_arm64_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var text_bytes: [16]u8;
    bin.write_u32_le(?text_bytes[0], 0, 0x90000000);
    bin.write_u32_le(?text_bytes[0], 4, 0x91000000);
    bin.write_u32_le(?text_bytes[0], 8, 0xF9400001);
    bin.write_u32_le(?text_bytes[0], 12, 0x94000000);
    var data_bytes: [8]u8;
    var k: usize = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 4;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 8; secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "g"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name = t_intern(?i, "ext_func"); syms[2].section = of.SECTION_EXTERNAL;
    syms[2].offset = 0; syms[2].size = 0; syms[2].flags = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [5]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0;  relocs[0].kind = of.RK_PAGE21;
    relocs[0].sym = 1; relocs[0].addend = 0;
    relocs[1].section = 0; relocs[1].offset = 4;  relocs[1].kind = of.RK_ADD_LO12;
    relocs[1].sym = 1; relocs[1].addend = 0;
    relocs[2].section = 0; relocs[2].offset = 8;  relocs[2].kind = of.RK_LDST64_LO12;
    relocs[2].sym = 1; relocs[2].addend = 0x10;
    relocs[3].section = 0; relocs[3].offset = 12; relocs[3].kind = of.RK_PLT32;
    relocs[3].sym = 2; relocs[3].addend = 0;
    relocs[4].section = 1; relocs[4].offset = 0;  relocs[4].kind = of.RK_ABS64;
    relocs[4].sym = 0; relocs[4].addend = 0x20;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 3;
    img.relocations = ?relocs[0]; img.reloc_count = 5;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_a64");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64)    { ret 1; }
    if (bin.read_u32_le(buf.data, 4) != CPU_TYPE_ARM64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_OBJECT)     { ret 1; }
    val text_sh: usize = MACH_HEADER_64_SIZE + SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, text_sh + 60) != 5) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    if (out.section_count != 2) { ret 1; }
    if (out.reloc_count != 5)   { ret 1; }

    var ok_page: bool = false;
    var ok_add:  bool = false;
    var ok_ldst: bool = false;
    var ok_br:   bool = false;
    var ok_abs:  bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.section == 0 && rr.offset == 0 && rr.kind == of.RK_PAGE21 && of.reloc_symbol_name(?out, rr) == syms[1].name)                     { ok_page = true; }
        if (rr.section == 0 && rr.offset == 4 && rr.kind == of.RK_ADD_LO12 && of.reloc_symbol_name(?out, rr) == syms[1].name)                   { ok_add = true; }
        if (rr.section == 0 && rr.offset == 8 && rr.kind == of.RK_LDST64_LO12 && of.reloc_symbol_name(?out, rr) == syms[1].name && rr.addend == 0x10) { ok_ldst = true; }
        if (rr.section == 0 && rr.offset == 12 && rr.kind == of.RK_PLT32 && of.reloc_symbol_name(?out, rr) == syms[2].name)                     { ok_br = true; }
        if (rr.section == 1 && rr.offset == 0 && rr.kind == of.RK_ABS64 && of.reloc_symbol_name(?out, rr) == syms[0].name && rr.addend == 0x20) { ok_abs = true; }
        rj = rj + 1;
    }
    if (!ok_page || !ok_add || !ok_ldst || !ok_br || !ok_abs) { ret 1; }
    ret 0;
}

fun ts_many_sections_coalesce() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    val ndata:   u32 = 260;
    val total:   u32 = 1 + ndata;
    val tgt_sec: u32 = 255;

    val rsec: R.Result[*of.Section, str] = A.zallocate[of.Section](?alloc, total::usize);
    if (R.is_err[*of.Section, str](rsec)) { ret 1; }
    var secs: *of.Section = R.unwrap_ok[*of.Section, str](rsec);

    var text_bytes: [8]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[0] = 0xE8;

    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;

    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    var s: u32 = 1;
    for (s < total) {
        secs[s].name = t_intern(?i, ".rodata"); secs[s].kind = of.SK_RODATA; secs[s].align = 8;
        if (s == tgt_sec) { secs[s].bytes = ?data_bytes[0]; secs[s].len = 8; }
        or                { secs[s].bytes = nil;            secs[s].len = 0; }
        s = s + 1;
    }

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, ".Lc.target"); syms[1].section = tgt_sec; syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = secs; img.section_count = total;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_many");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 2) { ret 1; }

    if (out.reloc_count != 1)                      { ret 1; }
    if (of.reloc_symbol_name(?out, ?out.relocations[0]) != syms[1].name) { ret 1; }

    var found: bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[1].name) {
            found = true;
            if (out.symbols[si].section == of.SECTION_EXTERNAL)            { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) != 0)     { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0)     { ret 1; }
            if (out.symbols[si].section >= out.section_count)              { ret 1; }
            if (out.sections[out.symbols[si].section].kind != of.SK_RODATA) { ret 1; }
        }
        si = si + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

fun ts_reloc_map() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x_abs: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_ABS64);
    if (R.is_err[MachoReloc, str](x_abs))                                  { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](x_abs).r_type != X86_64_RELOC_UNSIGNED) { ret 1; }
    val x_plt: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_PLT32);
    if (R.unwrap_ok[MachoReloc, str](x_plt).r_type != X86_64_RELOC_BRANCH) { ret 1; }
    val x_got_load: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL);
    val x_got: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL_NORELAX);
    val x_got64: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL64_NORELAX);
    if (R.unwrap_ok[MachoReloc, str](x_got_load).r_type != X86_64_RELOC_GOT_LOAD) { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](x_got).r_type != X86_64_RELOC_GOT
        || R.unwrap_ok[MachoReloc, str](x_got).length != 2) { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](x_got64).r_type != X86_64_RELOC_GOT
        || R.unwrap_ok[MachoReloc, str](x_got64).length != 3) { ret 1; }

    val a_page: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_PAGE21);
    if (R.is_err[MachoReloc, str](a_page))                               { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](a_page).r_type != ARM64_RELOC_PAGE21) { ret 1; }
    val a_ldst: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_LDST32_LO12);
    if (R.unwrap_ok[MachoReloc, str](a_ldst).r_type != ARM64_RELOC_PAGEOFF12) { ret 1; }

    val a_bad: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_ADDR32NB);
    if (!R.is_err[MachoReloc, str](a_bad))                                  { ret 1; }
    if (!str_contains(R.unwrap_err[MachoReloc, str](a_bad), "addr32nb"))    { ret 1; }
    ret 0;
}

fun ts_pageoff12() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val add: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x91000000);
    if (R.is_err[of.RelocKind, str](add) || R.unwrap_ok[of.RelocKind, str](add) != of.RK_ADD_LO12)        { ret 1; }
    val b8: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x39400000);
    if (R.unwrap_ok[of.RelocKind, str](b8) != of.RK_LDST8_LO12)                                           { ret 1; }
    val h16: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x79400000);
    if (R.unwrap_ok[of.RelocKind, str](h16) != of.RK_LDST16_LO12)                                         { ret 1; }
    val w32: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0xB9400000);
    if (R.unwrap_ok[of.RelocKind, str](w32) != of.RK_LDST32_LO12)                                         { ret 1; }
    val x64: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0xF9400000);
    if (R.unwrap_ok[of.RelocKind, str](x64) != of.RK_LDST64_LO12)                                         { ret 1; }
    val q128: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x3DC00000);
    if (R.unwrap_ok[of.RelocKind, str](q128) != of.RK_LDST128_LO12)                                       { ret 1; }
    ret 0;
}

fun ts_abs32() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x32: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_ABS32);
    if (R.is_err[MachoReloc, str](x32))                                       { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](x32).r_type != X86_64_RELOC_UNSIGNED)    { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](x32).length != 2)                        { ret 1; }
    val a32: R.Result[MachoReloc, str] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_ABS32);
    if (R.is_err[MachoReloc, str](a32))                                       { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](a32).r_type != ARM64_RELOC_UNSIGNED)     { ret 1; }
    if (R.unwrap_ok[MachoReloc, str](a32).length != 2)                        { ret 1; }

    val xr2: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_X86_64, X86_64_RELOC_UNSIGNED, 2, 0);
    if (R.is_err[of.RelocKind, str](xr2) || R.unwrap_ok[of.RelocKind, str](xr2) != of.RK_ABS32) { ret 1; }
    val xr3: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_X86_64, X86_64_RELOC_UNSIGNED, 3, 0);
    if (R.is_err[of.RelocKind, str](xr3) || R.unwrap_ok[of.RelocKind, str](xr3) != of.RK_ABS64) { ret 1; }
    val ar2: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_UNSIGNED, 2, 0);
    if (R.is_err[of.RelocKind, str](ar2) || R.unwrap_ok[of.RelocKind, str](ar2) != of.RK_ABS32) { ret 1; }
    val ar3: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_UNSIGNED, 3, 0);
    if (R.is_err[of.RelocKind, str](ar3) || R.unwrap_ok[of.RelocKind, str](ar3) != of.RK_ABS64) { ret 1; }
    ret 0;
}

fun ts_exec_x64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var k: usize = 0;
    for (k < 8) { code[k] = 0x90; k = k + 1; }
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 4096;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base + 4096; segs[0].filesz = 8; segs[0].memsz = 8;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code[0];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_exe");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                            4096, base, entry,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "machoexe"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_EXECUTE) { ret 1; }
    if (bin.read_u32_le(buf.data, 16) != 5) { ret 1; }

    val pz: usize = MACH_HEADER_64_SIZE;
    if (bin.read_u32_le(buf.data, pz) != LC_SEGMENT_64)     { ret 1; }
    if (!fixed16_equals(buf.data, pz + 8, "__PAGEZERO"))    { ret 1; }
    if (bin.read_u64_le(buf.data, pz + 24) != 0)            { ret 1; }

    val tx: usize = pz + SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, tx) != LC_SEGMENT_64)     { ret 1; }
    if (!fixed16_equals(buf.data, tx + 8, "__TEXT"))        { ret 1; }
    val text_va:   u64 = bin.read_u64_le(buf.data, tx + 24);
    val text_vmsz: u64 = bin.read_u64_le(buf.data, tx + 32);
    if (bin.read_u64_le(buf.data, tx + 40) != 0)            { ret 1; }
    if (bin.read_u64_le(buf.data, pz + 32) != text_va)      { ret 1; }
    if (text_va > base)                                     { ret 1; }
    if (base >= text_va + text_vmsz)                        { ret 1; }

    val th: usize = t_find_lc(buf.data, LC_UNIXTHREAD);
    if (th == 0)                                                        { ret 1; }
    if (bin.read_u32_le(buf.data, th + 8) != X86_THREAD_STATE64)        { ret 1; }
    if (bin.read_u64_le(buf.data, th + 16 + X86_RIP_STATE_OFFSET) != entry) { ret 1; }

    val cs: usize = t_find_lc(buf.data, LC_CODE_SIGNATURE);
    if (cs == 0)                                          { ret 1; }
    val sig_off: usize = bin.read_u32_le(buf.data, cs + 8)::usize;
    if (bin.read_u32_be(buf.data, sig_off) != CSMAGIC_EMBEDDED_SIGNATURE) { ret 1; }
    val cd: usize = sig_off + SUPERBLOB_HEADER_SIZE;
    if (bin.read_u32_be(buf.data, cd) != CSMAGIC_CODEDIRECTORY)           { ret 1; }
    if (bin.read_u32_be(buf.data, cd + 32) != sig_off::u32)               { ret 1; }
    val id_off: usize = cd + bin.read_u32_be(buf.data, cd + 20)::usize;
    if (!t_bytes_contain(buf.data, id_off, str_len("machoexe"), "machoexe")) { ret 1; }
    if (buf.data[id_off + str_len("machoexe")] != 0)                         { ret 1; }
    ret 0;
}

fun ts_exec_arm64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var code: [8]u8;
    bin.write_u32_le(?code[0], 0, 0xD503201F);
    bin.write_u32_le(?code[0], 4, 0xD65F03C0);
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 16384;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base + 16384; segs[0].filesz = 8; segs[0].memsz = 8;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code[0];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_a64exe");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                            16384, base, entry,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "machoa64"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u32_le(buf.data, 4) != CPU_TYPE_ARM64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_EXECUTE)    { ret 1; }
    val th: usize = t_find_lc(buf.data, LC_UNIXTHREAD);
    if (th == 0)                                                       { ret 1; }
    if (bin.read_u32_le(buf.data, th + 8) != ARM_THREAD_STATE64)       { ret 1; }
    if (bin.read_u64_le(buf.data, th + 16 + ARM_PC_STATE_OFFSET) != entry) { ret 1; }
    ret 0;
}

fun ts_register() u8 {
    var reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?reg); }
    val rr: R.Result[R.Void, str] = register_macho(?reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val opt_vt: O.Option[*of.OfVTable] = of.lookup(?reg, "macho");
    if (!O.is_some[*of.OfVTable](opt_vt)) { ret 1; }
    val vt: *of.OfVTable = O.unwrap[*of.OfVTable](opt_vt);
    if (vt.id != of.OF_MACHO)      { ret 1; }
    if (vt.emit_object == nil)     { ret 1; }
    if (vt.parse_object == nil)    { ret 1; }
    if (vt.emit_exec == nil)       { ret 1; }
    if (vt.emit_dyn_exec == nil)   { ret 1; }
    ret 0;
}

fun t_bytes_contain(buf: *u8, start: usize, len: usize, needle: str) bool {
    val nl: usize = str_len(needle);
    if (nl == 0 || nl > len) { ret false; }
    var i: usize = 0;
    for (i + nl <= len) {
        var j: usize = 0;
        var hit: bool = true;
        for (j < nl) {
            if (buf[start + i + j] != needle[j]) { hit = false; brk; }
            j = j + 1;
        }
        if (hit) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun ts_dyn_exec(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(arch_id);

    var code: [16]u8;
    var k: usize = 0;
    for (k < 16) { code[k] = 0; k = k + 1; }
    var fixup_off: u32 = 0;
    var fixup_add: i64 = 0;
    if (arch_id == isa.ARCH_AARCH64) {
        bin.write_u32_le(?code[0], 0, 0x94000000);
        fixup_off = 0;
        fixup_add = 0;
    }
    or {
        code[0] = 0xE8;
        fixup_off = 1;
        fixup_add = -4;
        code[7] = 0x48; code[8] = 0x8B; code[9] = 0x05;
    }
    val base:   u64 = 0x100000000;
    val seg_va: u64 = base + macho_page_size(arch_id);
    val entry:  u64 = seg_va;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = seg_va; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code[0];

    var libs: [1]of.DynLib;
    libs[0].name = t_intern(?itn, "probe");
    libs[0].soname = t_intern(?itn, "@rpath/libprobe.dylib");
    libs[0].rpath = t_intern(?itn, "/opt/probe/lib");
    var imps: [2]of.DynImport;
    imps[0].symbol = t_intern(?itn, "probe_value");
    imps[0].lib_index = 0;
    imps[0].is_func = false;
    imps[1].symbol = t_intern(?itn, "probe_add");
    imps[1].lib_index = 0;
    imps[1].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0]; dyn.lib_count = 1;
    dyn.imports = ?imps[0]; dyn.import_count = 2;
    dyn.interp = intern.STR_NIL;
    dyn.import_addr_fixups = nil;
    dyn.import_addr_fixup_count = 0;

    var fx: [1]of.PltFixup;
    fx[0].seg_index = 0; fx[0].seg_offset = fixup_off; fx[0].import_index = 1;
    fx[0].patch_vaddr = seg_va + fixup_off::u64; fx[0].addend = fixup_add;

    var gx: [1]of.ImportAddrFixup;
    if (arch_id == isa.ARCH_X86_64) {
        gx[0].seg_index = 0; gx[0].seg_offset = 10; gx[0].import_index = 0;
        gx[0].patch_vaddr = seg_va + 10; gx[0].kind = of.RK_GOTPCREL; gx[0].addend = -4;
        dyn.import_addr_fixups = ?gx[0];
        dyn.import_addr_fixup_count = 1;
    }

    var debug_bytes: [3]u8;
    debug_bytes[0] = 0x11; debug_bytes[1] = 0x22; debug_bytes[2] = 0x33;
    var dbg: [1]of.Section;
    dbg[0].name = t_intern(?itn, ".debug_info"); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?debug_bytes[0]; dbg[0].len = 3; dbg[0].align = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_dyn");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val em: R.Result[R.Void, str] = emit_dyn_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                                4096, base, entry,
                                                nil::*of.ExecFunction, 0, ?dyn, ?fx[0], 1,
                                                nil::*of.Section, 0, ?dbg[0], 1,
                                                nil::*of.SymtabEntry, 0,
                                                tpath::*u8, "machodyn"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64)                       { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_EXECUTE)                       { ret 1; }
    if (bin.read_u32_le(buf.data, 24) != (MH_DYLDLINK | MH_TWOLEVEL))      { ret 1; }

    val dw: usize = t_find_seg(buf.data, "__DWARF");
    if (dw == 0) { ret 1; }
    if ((bin.read_u64_le(buf.data, dw + 40) % macho_page_size(arch_id)) != 0) { ret 1; }

    val dl: usize = t_find_lc(buf.data, LC_LOAD_DYLINKER);
    if (dl == 0)                                                           { ret 1; }
    if (!t_bytes_contain(buf.data, dl, bin.read_u32_le(buf.data, dl + 4)::usize, "/usr/lib/dyld")) { ret 1; }
    val ld: usize = t_find_lc(buf.data, LC_LOAD_DYLIB);
    if (ld == 0)                                                           { ret 1; }
    if (!t_bytes_contain(buf.data, ld, bin.read_u32_le(buf.data, ld + 4)::usize, "libprobe.dylib")) { ret 1; }
    val rp: usize = t_find_lc(buf.data, LC_RPATH);
    if (rp == 0)                                                           { ret 1; }
    if (!t_bytes_contain(buf.data, rp, bin.read_u32_le(buf.data, rp + 4)::usize, "/opt/probe/lib")) { ret 1; }

    val info: usize = t_find_lc(buf.data, LC_DYLD_INFO_ONLY);
    if (info == 0)                                                         { ret 1; }
    val bind_off:  usize = bin.read_u32_le(buf.data, info + 16)::usize;
    val bind_size: usize = bin.read_u32_le(buf.data, info + 20)::usize;
    if (bind_size == 0)                                                    { ret 1; }
    if (!t_bytes_contain(buf.data, bind_off, bind_size, "probe_add"))      { ret 1; }
    if (arch_id == isa.ARCH_X86_64
        && !t_bytes_contain(buf.data, bind_off, bind_size, "probe_value")) { ret 1; }

    val sy: usize = t_find_lc(buf.data, LC_SYMTAB);
    if (sy == 0)                                                           { ret 1; }
    var expected_imports: u32 = 1;
    if (arch_id == isa.ARCH_X86_64) { expected_imports = 2; }
    if (bin.read_u32_le(buf.data, sy + 12) != expected_imports)           { ret 1; }
    val dsy: usize = t_find_lc(buf.data, LC_DYSYMTAB);
    if (dsy == 0)                                                          { ret 1; }
    if (bin.read_u32_le(buf.data, dsy + 28) != expected_imports)          { ret 1; }

    if (arch_id == isa.ARCH_X86_64) {
        val text_file: usize = bin.read_u32_le(buf.data, t_find_seg(buf.data, "__TEXT") + SEGMENT_CMD_64_SIZE + 48)::usize;
        if (bin.read_u32_le(buf.data, text_file + 1) == 0
            || bin.read_u32_le(buf.data, text_file + 10) == 0) { ret 1; }
    }

    val th: usize = t_find_lc(buf.data, LC_UNIXTHREAD);
    if (th == 0)                                                           { ret 1; }
    if (arch_id == isa.ARCH_AARCH64) {
        if (bin.read_u64_le(buf.data, th + 16 + ARM_PC_STATE_OFFSET) != entry) { ret 1; }
    }
    or {
        if (bin.read_u64_le(buf.data, th + 16 + X86_RIP_STATE_OFFSET) != entry) { ret 1; }
    }

    val cs: usize = t_find_lc(buf.data, LC_CODE_SIGNATURE);
    if (cs == 0)                                                          { ret 1; }
    val sig_off: usize = bin.read_u32_le(buf.data, cs + 8)::usize;
    if (bin.read_u32_be(buf.data, sig_off) != CSMAGIC_EMBEDDED_SIGNATURE) { ret 1; }
    if (bin.read_u32_be(buf.data, sig_off + SUPERBLOB_HEADER_SIZE) != CSMAGIC_CODEDIRECTORY) { ret 1; }
    ret 0;
}

fun t_count_sg_read_only(buf: *u8) u32 {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var n:   u32 = 0;
    var c:   u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == LC_SEGMENT_64
            && (bin.read_u32_le(buf, off + 68) & SG_READ_ONLY) != 0) { n = n + 1; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret n;
}

fun t_count_segs_named(buf: *u8, name: str) u32 {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var n:   u32 = 0;
    var c:   u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == LC_SEGMENT_64 && fixed16_equals(buf, off + 8, name)) { n = n + 1; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret n;
}

fun t_seg_ordinal(buf: *u8, name: str) u32 {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var n:   u32 = 0;
    var c:   u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == LC_SEGMENT_64) {
            if (fixed16_equals(buf, off + 8, name)) { ret n; }
            n = n + 1;
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret 0xFFFFFFFF;
}

fun t_sections_match_segname(buf: *u8) bool {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var c:   u32 = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            var sh: usize = off + SEGMENT_CMD_64_SIZE;
            var k: u32 = 0;
            for (k < nsects) {
                var i: usize = 0;
                for (i < 16) {
                    if (buf[sh + 16 + i] != buf[off + 8 + i]) { ret false; }
                    i = i + 1;
                }
                sh = sh + SECTION_64_SIZE;
                k = k + 1;
            }
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret true;
}

fun t_rebase_vaddr(buf: *u8, nth: u32) u64 {
    val info: usize = t_find_lc(buf, LC_DYLD_INFO_ONLY);
    if (info == 0) { ret 0; }
    val off:  usize = bin.read_u32_le(buf, info + 8)::usize;
    val size: usize = bin.read_u32_le(buf, info + 12)::usize;
    var p: usize = off;
    var n: u32 = 0;
    for (p < off + size) {
        val op:  u8 = buf[p] & 0xF0;
        val imm: u8 = buf[p] & 0x0F;
        p = p + 1;
        if (op == REBASE_OPCODE_DONE) { ret 0; }
        if (op == REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB) {
            var slot:  u64 = 0;
            var shift: u32 = 0;
            for (p < off + size) {
                val b: u8 = buf[p];
                p = p + 1;
                slot = slot | ((b & 0x7F)::u64 << shift::u64);
                if ((b & 0x80) == 0) { brk; }
                shift = shift + 7;
            }
            if (n == nth) {
                val ncmds: u32 = bin.read_u32_le(buf, 16);
                var so: usize = MACH_HEADER_64_SIZE;
                var si: u32 = 0;
                var c:  u32 = 0;
                for (c < ncmds) {
                    if (bin.read_u32_le(buf, so) == LC_SEGMENT_64) {
                        if (si == imm::u32) { ret bin.read_u64_le(buf, so + 24) + slot; }
                        si = si + 1;
                    }
                    so = so + bin.read_u32_le(buf, so + 4)::usize;
                    c = c + 1;
                }
                ret 0;
            }
            n = n + 1;
        }
    }
    ret 0;
}

fun t_name_segs(alloc: *A.Allocator, itn: *intern.Interner, segs: *of.LoadSegment, seg_count: u32) u8 {
    var i: u32 = 0;
    for (i < seg_count) {
        val ar: R.Result[*of.LoadSection, str] = A.zallocate[of.LoadSection](alloc, 1);
        if (R.is_err[*of.LoadSection, str](ar)) { ret 1; }
        val sec: *of.LoadSection = R.unwrap_ok[*of.LoadSection, str](ar);
        val zf: bool = segs[i].filesz == 0 && segs[i].memsz > 0;
        var nm:   str = "__const";
        var kind: of.SectionKind = of.SK_RODATA;
        if ((segs[i].flags & of.SEG_FLAG_EXECUTE) != 0) { nm = "__text"; kind = of.SK_TEXT; }
        or (zf)                                         { nm = "__bss";  kind = of.SK_BSS; }
        or ((segs[i].flags & of.SEG_FLAG_WRITE) != 0)   { nm = "__data"; kind = of.SK_DATA; }
        sec.name   = t_intern(itn, nm);
        sec.kind   = kind;
        sec.offset = 0;
        sec.len    = segs[i].memsz::u32;
        sec.align  = 8;
        segs[i].sections      = sec;
        segs[i].section_count = 1;
        i = i + 1;
    }
    ret 0;
}

fun t_emit_dyn(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget,
               segs: *of.LoadSegment, seg_count: u32, dyn: *of.DynamicInfo,
               entry: u64, base: u64) R.Result[Vector[u8], str] {
    if (t_name_segs(alloc, itn, segs, seg_count) != 0) { ret R.err[Vector[u8], str]("names"); }
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "macho_seg");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[Vector[u8], str]("temp"); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count,
                                                0x4000, base, entry,
                                                nil::*of.ExecFunction, 0, dyn, nil::*of.PltFixup, 0,
                                                nil::*of.Section, 0, nil::*of.Section, 0,
                                                nil::*of.SymtabEntry, 0,
                                                fs.temp_path(?tf)::*u8, "machoseg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) {
        fs.temp_close_and_remove(?tf);
        ret R.err[Vector[u8], str](R.unwrap_err[R.Void, str](em));
    }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    ret rb;
}

fun t_frame_segs(buf: *u8, names: *usize, nsects: *u32, sect0: *usize, cap: u32) u32 {
    val ncmds: u32 = bin.read_u32_le(buf, 16);
    var off: usize = MACH_HEADER_64_SIZE;
    var n:   u32 = 0;
    var c:   u32 = 0;
    for (c < ncmds && n < cap) {
        if (bin.read_u32_le(buf, off) == LC_SEGMENT_64) {
            names[n]  = off + 8;
            nsects[n] = bin.read_u32_le(buf, off + 64);
            sect0[n]  = 0;
            if (nsects[n] > 0) { sect0[n] = off + SEGMENT_CMD_64_SIZE; }
            n = n + 1;
        }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c = c + 1;
    }
    ret n;
}

fun t_fixed16_same(buf_a: *u8, off_a: usize, buf_b: *u8, off_b: usize) bool {
    var i: usize = 0;
    for (i < 16) {
        if (buf_a[off_a + i] != buf_b[off_b + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.target.of.macho.exec_section_flags:init_func_type" {
    var sec: of.LoadSection;
    sec.name  = intern.STR_NIL;
    sec.kind  = of.SK_DATA;
    sec.align = 8;
    sec.len   = 8;

    sec.flags = 0;
    if (exec_section_flags(?sec) != 0) { ret 1; }

    sec.flags = of.SEC_FLAG_INIT_FUNCS;
    if ((exec_section_flags(?sec) & SECTION_TYPE) != S_MOD_INIT_FUNC_POINTERS) { ret 1; }

    sec.kind  = of.SK_TEXT;
    sec.flags = 0;
    val tf: u32 = exec_section_flags(?sec);
    if ((tf & S_ATTR_PURE_INSTRUCTIONS) == 0)    { ret 1; }
    if ((tf & S_ATTR_SOME_INSTRUCTIONS) == 0)    { ret 1; }
    if ((tf & SECTION_TYPE) != 0)                { ret 1; }

    sec.kind  = of.SK_BSS;
    sec.flags = 0;
    if ((exec_section_flags(?sec) & SECTION_TYPE) != S_ZEROFILL) { ret 1; }
    ret 0;
}

fun ts_exec_frames_like_dyn() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var bytes: [48]u8;
    var k: usize = 0;
    for (k < 48) { bytes[k] = 0x90; k = k + 1; }

    val base: u64 = 0x100000000;
    val pg:   u64 = macho_page_size(isa.ARCH_X86_64);
    val first: u64 = base + pg;
    var segs: [3]of.LoadSegment;
    segs[0].vaddr = first;          segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?bytes[0];
    segs[1].vaddr = first + pg;     segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;   segs[1].bytes = ?bytes[16];
    segs[2].vaddr = first + pg * 2; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ;                       segs[2].bytes = ?bytes[32];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_frame");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    if (t_name_segs(?alloc, ?itn, ?segs[0], 3) != 0) { ret 1; }
    val em: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 3,
                                            pg, base, first,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            fs.temp_path(?tf)::*u8, "machoframe"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val stat: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie = true;
    val dr: R.Result[Vector[u8], str] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 3, ?dyn, first, base);
    if (R.is_err[Vector[u8], str](dr)) { ret 1; }
    val dynb: Vector[u8] = R.unwrap_ok[Vector[u8], str](dr);

    val spz: usize = t_find_seg(stat.data, "__PAGEZERO");
    val dpz: usize = t_find_seg(dynb.data, "__PAGEZERO");
    if (spz == 0 || dpz == 0)                                { ret 1; }
    if (bin.read_u64_le(stat.data, spz + 32) != base)        { ret 1; }
    if (bin.read_u64_le(dynb.data, dpz + 32) != base)        { ret 1; }
    val stx: usize = t_find_seg(stat.data, "__TEXT");
    val dtx: usize = t_find_seg(dynb.data, "__TEXT");
    if (stx == 0 || dtx == 0)                                { ret 1; }
    if (bin.read_u64_le(stat.data, stx + 24) != base)        { ret 1; }
    if (bin.read_u64_le(dynb.data, dtx + 24) != base)        { ret 1; }
    if (bin.read_u64_le(stat.data, stx + 40) != 0)           { ret 1; }
    if (bin.read_u64_le(stat.data, stx + SEGMENT_CMD_64_SIZE + 32) != first) { ret 1; }

    var snames: [8]usize; var snsects: [8]u32; var ssect0: [8]usize;
    var dnames: [8]usize; var dnsects: [8]u32; var dsect0: [8]usize;
    val sn: u32 = t_frame_segs(stat.data, ?snames[0], ?snsects[0], ?ssect0[0], 8);
    val dn: u32 = t_frame_segs(dynb.data, ?dnames[0], ?dnsects[0], ?dsect0[0], 8);
    if (sn != dn || sn < 4)                                  { ret 1; }
    var i: u32 = 0;
    for (i < sn) {
        if (!t_fixed16_same(stat.data, snames[i], dynb.data, dnames[i]))       { ret 1; }
        if (snsects[i] != dnsects[i])                                          { ret 1; }
        if (snsects[i] > 0
            && !t_fixed16_same(stat.data, ssect0[i], dynb.data, dsect0[i]))    { ret 1; }
        i = i + 1;
    }
    if (snsects[1] == 0 || snsects[2] == 0 || snsects[3] == 0) { ret 1; }

    if (t_find_lc(stat.data, LC_UNIXTHREAD) == 0)           { ret 1; }
    if (t_find_lc(dynb.data, LC_MAIN) == 0)                 { ret 1; }
    if (t_find_lc(stat.data, LC_MAIN) != 0)                 { ret 1; }
    if (t_find_lc(dynb.data, LC_UNIXTHREAD) != 0)           { ret 1; }
    ret 0;
}

fun t_emit_both(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget,
                segs: *of.LoadSegment, seg_count: u32, base: u64,
                stat: *Vector[u8], dynb: *Vector[u8]) u8 {
    val opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val entry: u64 = segs[0].vaddr;

    val sf: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "macho_both_s");
    if (R.is_err[fs.TempFile, str](sf)) { ret 1; }
    var stf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](sf);
    val se: R.Result[R.Void, str] = emit_exec(alloc, itn, isa_vt, segs, seg_count,
                                            macho_page_size(isa_vt.arch_id), base, entry,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            fs.temp_path(?stf)::*u8, "machoboth"::*u8, opts);
    if (R.is_err[R.Void, str](se)) { fs.temp_close_and_remove(?stf); ret 1; }
    val sb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, fs.temp_path(?stf));
    fs.temp_close_and_remove(?stf);
    if (R.is_err[Vector[u8], str](sb)) { ret 1; }

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie = true;
    val df: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "macho_both_d");
    if (R.is_err[fs.TempFile, str](df)) { ret 1; }
    var dtf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](df);
    val de: R.Result[R.Void, str] = emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count,
                                                macho_page_size(isa_vt.arch_id), base, entry,
                                                nil::*of.ExecFunction, 0, ?dyn, nil::*of.PltFixup, 0,
                                                nil::*of.Section, 0, nil::*of.Section, 0,
                                                nil::*of.SymtabEntry, 0,
                                                fs.temp_path(?dtf)::*u8, "machoboth"::*u8, opts);
    if (R.is_err[R.Void, str](de)) { fs.temp_close_and_remove(?dtf); ret 1; }
    val db: R.Result[Vector[u8], str] = fs.read_bytes(alloc, fs.temp_path(?dtf));
    fs.temp_close_and_remove(?dtf);
    if (R.is_err[Vector[u8], str](db)) { ret 1; }

    @stat = R.unwrap_ok[Vector[u8], str](sb);
    @dynb = R.unwrap_ok[Vector[u8], str](db);
    ret 0;
}

fun ts_header_span_multi_page(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(arch_id);

    val pg:    u64 = macho_page_size(arch_id);
    val nsect: u32 = 256;

    var bytes: [2048]u8;
    var k: usize = 0;
    for (k < 2048) { bytes[k] = 0; k = k + 1; }

    val sr: R.Result[*of.LoadSection, str] = A.zallocate[of.LoadSection](?alloc, nsect::usize);
    if (R.is_err[*of.LoadSection, str](sr)) { ret 1; }
    val secs: *of.LoadSection = R.unwrap_ok[*of.LoadSection, str](sr);

    var nm: [8]u8;
    nm[0] = 0x5F; nm[1] = 0x5F; nm[2] = 0x73; nm[6] = 0; nm[7] = 0;
    var i: u32 = 0;
    for (i < nsect) {
        nm[3] = (48 + (i / 100) % 10)::u8;
        nm[4] = (48 + (i / 10) % 10)::u8;
        nm[5] = (48 + i % 10)::u8;
        secs[i].name   = t_intern(?itn, ?nm[0]);
        if (secs[i].name == intern.STR_NIL) { ret 1; }
        secs[i].kind   = of.SK_TEXT;
        secs[i].offset = i * 8;
        secs[i].len    = 8;
        secs[i].align  = 8;
        i = i + 1;
    }

    var segs: [1]of.LoadSegment;
    segs[0].filesz = 2048; segs[0].memsz = 2048;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[0].sections      = secs;
    segs[0].section_count = nsect;

    var shape: of.HeaderShape;
    shape.itn         = ?itn;
    shape.libs        = nil::*of.DynLib;
    shape.lib_count   = 0;
    shape.seg_count   = 1;
    shape.sect_count  = nsect;
    shape.debug_count = 0;
    shape.pie         = true;
    shape.imports     = false;
    val span: u64 = header_span(?shape, pg);
    if (span <= pg)          { ret 1; }
    if ((span % pg) != 0)    { ret 1; }

    val base: u64 = 0x100000000;
    segs[0].vaddr = base + span;

    var stat: Vector[u8];
    var dynb: Vector[u8];
    if (t_emit_both(?alloc, ?itn, ?isa_vt, ?segs[0], 1, base, ?stat, ?dynb) != 0) { ret 1; }

    var w: u32 = 0;
    for (w < 2) {
        var buf: *u8 = stat.data;
        if (w == 1) { buf = dynb.data; }

        val sizeofcmds: usize = bin.read_u32_le(buf, 20)::usize;
        if (sizeofcmds::u64 <= pg)                              { ret 1; }
        if (MACH_HEADER_64_SIZE + sizeofcmds > span::usize)     { ret 1; }

        val pz: usize = t_find_seg(buf, "__PAGEZERO");
        val tx: usize = t_find_seg(buf, "__TEXT");
        if (pz == 0 || tx == 0)                                 { ret 1; }
        if (bin.read_u64_le(buf, pz + 24) != 0)                 { ret 1; }
        if (bin.read_u64_le(buf, pz + 32) != base)              { ret 1; }
        if (bin.read_u64_le(buf, tx + 24) != base)              { ret 1; }
        if (bin.read_u64_le(buf, tx + 40) != 0)                 { ret 1; }
        if (bin.read_u32_le(buf, tx + 64) != nsect)             { ret 1; }

        val s0: usize = tx + SEGMENT_CMD_64_SIZE;
        if (bin.read_u64_le(buf, s0 + 32) != base + span)       { ret 1; }
        if (bin.read_u32_le(buf, s0 + 48)::u64 != span)         { ret 1; }
        w = w + 1;
    }

    segs[0].vaddr = base + pg;
    val opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_span_bad");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val bad_s: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                               pg, base, base + pg,
                                               nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                               nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                               fs.temp_path(?tf)::*u8, "machospanbad"::*u8, opts);
    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie = true;
    val bad_d: R.Result[R.Void, str] = emit_dyn_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
                                                   pg, base, base + pg,
                                                   nil::*of.ExecFunction, 0, ?dyn, nil::*of.PltFixup, 0,
                                                   nil::*of.Section, 0, nil::*of.Section, 0,
                                                   nil::*of.SymtabEntry, 0,
                                                   fs.temp_path(?tf)::*u8, "machospanbad"::*u8, opts);
    fs.temp_close_and_remove(?tf);
    if (!R.is_err[R.Void, str](bad_s)) { ret 1; }
    if (!R.is_err[R.Void, str](bad_d)) { ret 1; }
    ret 0;
}

fun ts_dyn_exec_relro_segments(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(arch_id);

    var bytes: [80]u8;
    var k: usize = 0;
    for (k < 80) { bytes[k] = 0; k = k + 1; }

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs: [5]of.LoadSegment;
    segs[0].vaddr = first;          segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;  segs[0].bytes = ?bytes[0];
    segs[1].vaddr = first + pg;     segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;    segs[1].bytes = ?bytes[16];
    segs[2].vaddr = first + pg * 2; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ;                        segs[2].bytes = ?bytes[32];
    segs[3].vaddr = first + pg * 3; segs[3].filesz = 16; segs[3].memsz = 16;
    segs[3].flags = of.SEG_FLAG_READ;                        segs[3].bytes = ?bytes[48];
    segs[4].vaddr = first + pg * 4; segs[4].filesz = 0;  segs[4].memsz = 16;
    segs[4].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;    segs[4].bytes = nil;

    var brs: [3]of.BaseReloc;
    brs[0].seg_index = 1; brs[0].seg_offset = 0; brs[0].target = base;
    brs[1].seg_index = 3; brs[1].seg_offset = 0; brs[1].target = base;
    brs[2].seg_index = 2; brs[2].seg_offset = 0; brs[2].target = base;

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = ?brs[0];
    dyn.base_reloc_count = 2;
    dyn.pie = true;

    val r1: R.Result[Vector[u8], str] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 5, ?dyn, first, base);
    if (R.is_err[Vector[u8], str](r1)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](r1);

    if (t_count_sg_read_only(buf.data) != 1)                                 { ret 1; }
    if (t_count_segs_named(buf.data, "__DATA_CONST") != 1)                   { ret 1; }
    val dc: usize = t_find_seg(buf.data, "__DATA_CONST");
    if (dc == 0)                                                             { ret 1; }
    if (bin.read_u64_le(buf.data, dc + 24) != first + pg * 3)                 { ret 1; }
    if ((bin.read_u32_le(buf.data, dc + 68) & SG_READ_ONLY) == 0)            { ret 1; }
    if (bin.read_u32_le(buf.data, dc + 60) != (VM_PROT_READ | VM_PROT_WRITE)) { ret 1; }
    if (bin.read_u32_le(buf.data, dc + 64) != 1)                             { ret 1; }

    if (t_count_segs_named(buf.data, "__RODATA") != 1)                       { ret 1; }
    val rd: usize = t_find_seg(buf.data, "__RODATA");
    if (rd == 0)                                                             { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 24) != first + pg * 2)                 { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 60) != VM_PROT_READ)                  { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 56) != VM_PROT_READ)                  { ret 1; }
    if ((bin.read_u32_le(buf.data, rd + 68) & SG_READ_ONLY) != 0)            { ret 1; }

    val dt: usize = t_find_seg(buf.data, "__DATA");
    if (dt == 0)                                                             { ret 1; }
    if (bin.read_u64_le(buf.data, dt + 24) != first + pg)                     { ret 1; }
    if (bin.read_u32_le(buf.data, dt + 60) != (VM_PROT_READ | VM_PROT_WRITE)) { ret 1; }
    if (bin.read_u32_le(buf.data, dt + 56) != (VM_PROT_READ | VM_PROT_WRITE)) { ret 1; }
    if ((bin.read_u32_le(buf.data, dt + 68) & SG_READ_ONLY) != 0)            { ret 1; }

    if (!t_sections_match_segname(buf.data))                                 { ret 1; }
    if (t_rebase_vaddr(buf.data, 0) != first + pg)                            { ret 1; }
    if (t_rebase_vaddr(buf.data, 1) != first + pg * 3)                        { ret 1; }
    if (t_rebase_vaddr(buf.data, 2) != 0)                                    { ret 1; }

    dyn.base_reloc_count = 3;
    val r2: R.Result[Vector[u8], str] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 5, ?dyn, first, base);
    if (R.is_err[Vector[u8], str](r2)) { ret 1; }
    val buf2: Vector[u8] = R.unwrap_ok[Vector[u8], str](r2);
    if (t_count_sg_read_only(buf2.data) != 1)                                { ret 1; }
    if (t_count_segs_named(buf2.data, "__DATA_CONST") != 1)                  { ret 1; }
    if (t_count_segs_named(buf2.data, "__RODATA") != 0)                      { ret 1; }
    val dc2: usize = t_find_seg(buf2.data, "__DATA_CONST");
    if (bin.read_u64_le(buf2.data, dc2 + 24) != first + pg * 2)               { ret 1; }
    if (bin.read_u32_le(buf2.data, dc2 + 64) != 2)                           { ret 1; }
    if (bin.read_u64_le(buf2.data, dc2 + 32)
        != bin.align_up_u64(pg + 16, macho_page_size(arch_id)))              { ret 1; }
    if (!t_sections_match_segname(buf2.data))                                { ret 1; }
    if (t_rebase_vaddr(buf2.data, 0) != first + pg)                           { ret 1; }
    if (t_rebase_vaddr(buf2.data, 1) != first + pg * 2)                       { ret 1; }
    if (t_rebase_vaddr(buf2.data, 2) != first + pg * 3)                       { ret 1; }
    ret 0;
}

fun ts_dyn_exec_split_data_const() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var bytes: [64]u8;
    var k: usize = 0;
    for (k < 64) { bytes[k] = 0; k = k + 1; }

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs: [4]of.LoadSegment;
    segs[0].vaddr = first;          segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?bytes[0];
    segs[1].vaddr = first + pg;     segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ;                       segs[1].bytes = ?bytes[16];
    segs[2].vaddr = first + pg * 2; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;   segs[2].bytes = ?bytes[32];
    segs[3].vaddr = first + pg * 3; segs[3].filesz = 16; segs[3].memsz = 16;
    segs[3].flags = of.SEG_FLAG_READ;                       segs[3].bytes = ?bytes[48];

    var brs: [2]of.BaseReloc;
    brs[0].seg_index = 1; brs[0].seg_offset = 8; brs[0].target = base;
    brs[1].seg_index = 3; brs[1].seg_offset = 0; brs[1].target = base;

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = ?brs[0];
    dyn.base_reloc_count = 2;
    dyn.pie = true;

    val r: R.Result[Vector[u8], str] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 4, ?dyn, first, base);
    if (!R.is_err[Vector[u8], str](r))                                       { ret 1; }
    val msg: str = R.unwrap_err[Vector[u8], str](r);
    if (!str_contains(msg, "__DATA_CONST"))                                  { ret 1; }
    if (!str_contains(msg, "read-only load segments 1"))                     { ret 1; }
    if (!str_contains(msg, "and 3"))                                         { ret 1; }
    ret 0;
}

fun ts_exec_merges_read_only() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var bytes: [48]u8;
    var k: usize = 0;
    for (k < 48) { bytes[k] = 0; k = k + 1; }

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs: [3]of.LoadSegment;
    segs[0].vaddr = first;          segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?bytes[0];
    segs[1].vaddr = first + pg;     segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ;                       segs[1].bytes = ?bytes[16];
    segs[2].vaddr = first + pg * 2; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ;                       segs[2].bytes = ?bytes[32];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_exec_ro");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    if (t_name_segs(?alloc, ?itn, ?segs[0], 3) != 0) { ret 1; }
    val em: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt, ?segs[0], 3,
                                            pg, base, first,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            fs.temp_path(?tf)::*u8, "machoexecro"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (t_count_segs_named(buf.data, "__RODATA") != 1)                       { ret 1; }
    val rd: usize = t_find_seg(buf.data, "__RODATA");
    if (rd == 0)                                                             { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 24) != first + pg)                     { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 32)
        != bin.align_up_u64(pg + 16, EXEC_PAGE_SIZE))                        { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 60) != VM_PROT_READ)                  { ret 1; }

    if (macho_kind_from(0, false, false, true) != of.SK_RODATA)              { ret 1; }
    ret 0;
}

fun ts_unsupported_kind() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "_main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_ADDR32NB;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "macho_kind");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = emit_object(?isa_vt, ?img, tpath::*u8);
    fs.temp_close_and_remove(?tf);
    if (!R.is_err[R.Void, str](em))                               { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "addr32nb")) { ret 1; }
    ret 0;
}

fun ts_bad_input() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var junk: [32]u8;
    var k: usize = 0;
    for (k < 32) { junk[k] = 0; k = k + 1; }
    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, ?junk[0], 32, ?out);
    if (!R.is_err[R.Void, str](pr))                                { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "bad magic")) { ret 1; }

    var tiny: [8]u8;
    k = 0;
    for (k < 8) { tiny[k] = 0; k = k + 1; }
    var out2: of.ObjectImage;
    val pr2: R.Result[R.Void, str] = parse_object(?alloc, ?i, ?tiny[0], 8, ?out2);
    if (!R.is_err[R.Void, str](pr2)) { ret 1; }
    ret 0;
}

fun ts_import_address_fixup_validation() u8 {
    var buf: [16]u8;
    var seg_offsets: [1]usize;
    seg_offsets[0] = 0;
    var segs: [1]of.LoadSegment;
    segs[0].filesz = 16;
    segs[0].memsz = 16;

    var imports: [1]of.DynImport;
    imports[0].is_func = false;
    var fixups: [1]of.ImportAddrFixup;
    fixups[0].seg_index = 0;
    fixups[0].seg_offset = 0;
    fixups[0].import_index = 0;
    fixups[0].patch_vaddr = 0x1000;
    fixups[0].kind = of.RK_GOTPCREL;
    fixups[0].addend = -4;

    var dyn: of.DynamicInfo;
    dyn.imports = ?imports[0];
    dyn.import_count = 1;
    dyn.import_addr_fixups = ?fixups[0];
    dyn.import_addr_fixup_count = 1;
    var lay: MachoDynLayout;
    lay.got_va = 0x2000;
    lay.got_size = 8;

    val good: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_err[R.Void, str](good) || bin.read_u32_le(?buf[0], 0) == 0) { ret 1; }

    dyn.import_addr_fixups = nil;
    val nil_fixups: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](nil_fixups)
        || !str_contains(R.unwrap_err[R.Void, str](nil_fixups), "nil import-address")) { ret 1; }
    dyn.import_addr_fixups = ?fixups[0];

    dyn.imports = nil;
    val nil_imports: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](nil_imports)
        || !str_contains(R.unwrap_err[R.Void, str](nil_imports), "nil dynamic import")) { ret 1; }
    dyn.imports = ?imports[0];

    val nil_layout: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        nil::*u8, ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](nil_layout)
        || !str_contains(R.unwrap_err[R.Void, str](nil_layout), "missing output layout")) { ret 1; }

    fixups[0].import_index = 1;
    val bad_import: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](bad_import)
        || !str_contains(R.unwrap_err[R.Void, str](bad_import), "out-of-range import")) { ret 1; }
    fixups[0].import_index = 0;

    fixups[0].seg_index = 1;
    val bad_segment: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](bad_segment)
        || !str_contains(R.unwrap_err[R.Void, str](bad_segment), "out-of-range segment")) { ret 1; }
    fixups[0].seg_index = 0;

    fixups[0].kind = of.RK_PC32;
    val bad_kind: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](bad_kind)
        || !str_contains(R.unwrap_err[R.Void, str](bad_kind), "unsupported import-address")) { ret 1; }
    fixups[0].kind = of.RK_GOTPCREL;

    fixups[0].seg_offset = 14;
    val bad_offset: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](bad_offset)
        || !str_contains(R.unwrap_err[R.Void, str](bad_offset), "offset out of range")) { ret 1; }
    fixups[0].seg_offset = 0;

    lay.got_size = 0;
    val no_slot: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](no_slot)
        || !str_contains(R.unwrap_err[R.Void, str](no_slot), "has no GOT slot")) { ret 1; }
    lay.got_size = 8;

    lay.got_va = 0x100000000;
    fixups[0].patch_vaddr = 0;
    fixups[0].addend = 0;
    val rel32_overflow: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](rel32_overflow)
        || !str_contains(R.unwrap_err[R.Void, str](rel32_overflow), "overflows 32 bits")) { ret 1; }

    lay.got_va = 0x8000000000000000;
    val signed_overflow: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_ok[R.Void, str](signed_overflow)
        || !str_contains(R.unwrap_err[R.Void, str](signed_overflow), "signed range")) { ret 1; }

    lay.got_va = 0x2000;
    fixups[0].patch_vaddr = 0x1000;
    fixups[0].kind = of.RK_GOTPCREL64_NORELAX;
    fixups[0].addend = -8;
    val good64: R.Result[R.Void, str] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (R.is_err[R.Void, str](good64) || bin.read_u64_le(?buf[0], 0) == 0) { ret 1; }
    ret 0;
}

