# the relocation-applier contract and its format-neutral packing bodies
#
# An ISA that emits relocatable objects owes exactly one relocation entry point,
# `ApplyRelocFn`, which patches one resolved relocation into the merged bytes. The
# arch owns its complete kind-set behind that one hook, so the linker's patch loop
# carries no per-kind and no per-arch handling.
#
# The contract deliberately names NO session and NO interner. A relocation applier
# is arch knowledge, so it lives beside the arch it belongs to, under
# `target/isa/<arch>/reloc.mach` - and the target layer cannot reach
# `mach.lang.session` (session imports `mach.lang.target`, which imports every
# arch's registration module). An applier therefore reports WHAT went wrong as a
# `RelocError` code and the linker, which holds the session, turns the code into
# the diagnostic. That split is the reason the applier can be owned by the target
# rather than handed to it.
#
# The three flat writes below are the kinds every arch shares - a 64-bit absolute,
# a 32-bit absolute, and a 32-bit pc-relative displacement - so each arch's packer
# delegates them instead of restating the bounds and range checks.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;

use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.of.bin;

# why a relocation could not be applied
#
# The applier reports a code rather than a message: it has no session to build a
# string with, and the linker that calls it names the kind and the symbol far
# better than the packer could.
pub def RelocError: u8;

# the value does not fit the relocation's field, or the patch site runs past the
# end of the section it lands in
pub val RELOC_OVERFLOW: RelocError = 0;

# the arch has no packing for this relocation kind
pub val RELOC_UNSUPPORTED: RelocError = 1;

# apply one relocation for an architecture
#
# The one hook an ISA that emits relocatable objects owes, held erased (`*u8`) on
# `isa.RelocSeam.apply_reloc` and cast back here by the linker: `isa` cannot name
# this signature, because it mentions `of.RelocKind` and `of` imports `isa`.
# ---
# kind:      the abstract relocation kind to apply
# dst:       the merged section bytes to patch
# patch_off: byte offset of the patch site within `dst`
# sec_len:   length of the section `dst` backs, for the bounds check
# sym_va:    the target symbol's final virtual address
# addend:    the relocation addend
# patch_va:  the patch site's own virtual address
# ret:       ok(true) once written, or the reason it could not be
pub def ApplyRelocFn: fun(of.RelocKind, *u8, u32, u32, u64, i64, u64) R.Result[bool, RelocError];

# write a 64-bit absolute (`sym + addend`) into the merged bytes, the shared body
# of the arch-independent RK_ABS64 (R_X86_64_64 == R_AARCH64_ABS64). the patch
# site is bounded in u64 (a near-4GiB offset cannot wrap the u32 cursor)
# ---
# dst:       the merged section bytes to patch
# patch_off: byte offset of the patch site within `dst`
# sec_len:   length of the section `dst` backs, for the bounds check
# sym_va:    the target symbol's final virtual address
# addend:    the relocation addend
# ret:       ok(true) once written, or RELOC_OVERFLOW
pub fun apply_abs64(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) R.Result[bool, RelocError] {
    # bound the patch site in u64: patch_off + width can wrap a u32 for an offset
    # near 0xFFFFFFFF, which would pass a u32 check and then scribble outside the
    # merged buffer.
    if (patch_off::u64 + 8 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val value: u64 = sym_va + (addend::u64);
    bin.write_u64_le(dst, patch_off::usize, value);
    ret R.ok[bool, RelocError](true);
}

# write a 32-bit unsigned absolute (`sym + addend`) into the merged bytes, the shared
# body of the arch-independent RK_ABS32 (R_X86_64_32 / R_AARCH64_ABS32 / R_RISCV_32).
# emitted by the DWARF producer for a `DW_AT_stmt_list` cross-section reference; the
# patch site is bounded and the value range-checked against the unsigned 32-bit field
# ---
# dst:       the merged section bytes to patch
# patch_off: byte offset of the patch site within `dst`
# sec_len:   length of the section `dst` backs, for the bounds check
# sym_va:    the target symbol's final virtual address (a debug-section offset for a
#            non-allocated section)
# addend:    the relocation addend
# ret:       ok(true) once written, or RELOC_OVERFLOW
pub fun apply_abs32(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val value: u64 = sym_va + (addend::u64);
    if (value > 0xFFFFFFFF) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    bin.write_u32_le(dst, patch_off::usize, (value & 0xFFFFFFFF)::u32);
    ret R.ok[bool, RelocError](true);
}

# write a flat 32-bit pc-relative displacement (`sym + addend - patch_va`) into the
# merged bytes, the shared body of the arch-independent RK_PC32 and the x86_64
# RK_PLT32. the patch site is bounded in u64 (a near-4GiB offset cannot wrap the u32
# cursor) and the displacement is range-checked against the signed 32-bit field
# ---
# dst:       the merged section bytes to patch
# patch_off: byte offset of the patch site within `dst`
# sec_len:   length of the section `dst` backs, for the bounds check
# sym_va:    the target symbol's final virtual address
# addend:    the relocation addend
# patch_va:  the patch site's own virtual address
# ret:       ok(true) once written, or RELOC_OVERFLOW
pub fun apply_pcrel32(dst: *u8, patch_off: u32, sec_len: u32,
                      sym_va: u64, addend: i64, patch_va: u64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val disp: i64 = (sym_va::i64) + addend - (patch_va::i64);
    if (disp > 2147483647 || disp < -2147483648) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    bin.write_u32_le(dst, patch_off::usize, ((disp::u64) & 0xFFFFFFFF)::u32);
    ret R.ok[bool, RelocError](true);
}
