use std.types.bool.bool;
use std.types.bool.true;
use std.types.string.str;
use std.types.size.usize;

use A: std.allocator;
use R: std.types.result;

use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;

pub def RelocError: of.RelocError;

pub val RELOC_OVERFLOW: RelocError = of.RELOC_OVERFLOW;

pub val RELOC_UNSUPPORTED: RelocError = of.RELOC_UNSUPPORTED;

pub val RELOC_INVALID_INSTRUCTION: RelocError = of.RELOC_INVALID_INSTRUCTION;

pub def RelocAddendMode: of.RelocAddendMode;

pub val RELOC_ADDEND_SYMBOL: RelocAddendMode = of.RELOC_ADDEND_SYMBOL;

pub val RELOC_ADDEND_FIELD_BIAS: RelocAddendMode = of.RELOC_ADDEND_FIELD_BIAS;

pub val RELOC_ADDEND_IGNORED: RelocAddendMode = of.RELOC_ADDEND_IGNORED;

pub def RelocTraits: of.RelocTraits;

pub fun traits(field_width: u32, addend_mode: RelocAddendMode,
               text_bias_min: i32, text_bias_max: i32) RelocTraits {
    var t: RelocTraits;
    t.field_width   = field_width;
    t.addend_mode   = addend_mode;
    t.text_bias_min = text_bias_min;
    t.text_bias_max = text_bias_max;
    ret t;
}

pub def RelocTarget: of.RelocTarget;

pub fun target(vaddr: u64, section_vaddr: u64, section_index: u32) RelocTarget {
    var t: RelocTarget;
    t.vaddr = vaddr;
    t.section_vaddr = section_vaddr;
    t.section_index = section_index;
    ret t;
}

pub def RelocTraitsFn: of.RelocTraitsFn;

pub def ApplyRelocFn: of.ApplyRelocFn;

val I64_MAX_U64: u64 = 0x7FFFFFFFFFFFFFFF;
val I64_SIGN_U64: u64 = 0x8000000000000000;
val I64_MIN_VALUE: i64 = -9223372036854775807 - 1;

pub fun add_signed_to_u64(base: u64, addend: i64) R.Result[u64, RelocError] {
    if (addend >= 0) {
        val positive: u64 = addend::u64;
        if (base > 0xFFFFFFFFFFFFFFFF - positive) {
            ret R.err[u64, RelocError](RELOC_OVERFLOW);
        }
        ret R.ok[u64, RelocError](base + positive);
    }
    val magnitude: u64 = (-(addend + 1))::u64 + 1;
    if (base < magnitude) { ret R.err[u64, RelocError](RELOC_OVERFLOW); }
    ret R.ok[u64, RelocError](base - magnitude);
}

pub fun add_u64_to_i64(base: u64, addend: i64) R.Result[i64, RelocError] {
    if (addend >= 0) {
        val positive: u64 = addend::u64;
        if (base > I64_MAX_U64 - positive) {
            ret R.err[i64, RelocError](RELOC_OVERFLOW);
        }
        ret R.ok[i64, RelocError]((base + positive)::i64);
    }
    val magnitude: u64 = (-(addend + 1))::u64 + 1;
    if (base >= magnitude) {
        val positive: u64 = base - magnitude;
        if (positive > I64_MAX_U64) { ret R.err[i64, RelocError](RELOC_OVERFLOW); }
        ret R.ok[i64, RelocError](positive::i64);
    }
    val negative: u64 = magnitude - base;
    if (negative == I64_SIGN_U64) { ret R.ok[i64, RelocError](I64_MIN_VALUE); }
    ret R.ok[i64, RelocError](0 - negative::i64);
}

pub fun subtract_u64_from_i64(base: i64, subtrahend: u64) R.Result[i64, RelocError] {
    if (subtrahend <= I64_MAX_U64) {
        val signed: i64 = subtrahend::i64;
        if (base < I64_MIN_VALUE + signed) {
            ret R.err[i64, RelocError](RELOC_OVERFLOW);
        }
        ret R.ok[i64, RelocError](base - signed);
    }
    val beyond_minimum: u64 = subtrahend - I64_SIGN_U64;
    if (base < 0 || base::u64 < beyond_minimum) {
        ret R.err[i64, RelocError](RELOC_OVERFLOW);
    }
    ret R.ok[i64, RelocError](I64_MIN_VALUE + (base::u64 - beyond_minimum)::i64);
}

pub fun displacement(target_vaddr: u64, addend: i64,
                     patch_vaddr: u64) R.Result[i64, RelocError] {
    if (target_vaddr >= patch_vaddr) {
        ret add_u64_to_i64(target_vaddr - patch_vaddr, addend);
    }
    ret subtract_u64_from_i64(addend, patch_vaddr - target_vaddr);
}

pub fun apply_abs64(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 8 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val adjusted: R.Result[u64, RelocError] = add_signed_to_u64(sym_va, addend);
    if (R.is_err[u64, RelocError](adjusted)) {
        ret R.err[bool, RelocError](R.unwrap_err[u64, RelocError](adjusted));
    }
    val value: u64 = R.unwrap_ok[u64, RelocError](adjusted);
    bin.write_u64_le(dst, patch_off::usize, value);
    ret R.ok[bool, RelocError](true);
}

pub fun apply_abs32(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val adjusted: R.Result[u64, RelocError] = add_signed_to_u64(sym_va, addend);
    if (R.is_err[u64, RelocError](adjusted)) {
        ret R.err[bool, RelocError](R.unwrap_err[u64, RelocError](adjusted));
    }
    val value: u64 = R.unwrap_ok[u64, RelocError](adjusted);
    if (value > 0xFFFFFFFF) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    bin.write_u32_le(dst, patch_off::usize, (value & 0xFFFFFFFF)::u32);
    ret R.ok[bool, RelocError](true);
}

pub fun apply_abs16(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 2 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val adjusted: R.Result[u64, RelocError] = add_signed_to_u64(sym_va, addend);
    if (R.is_err[u64, RelocError](adjusted)) {
        ret R.err[bool, RelocError](R.unwrap_err[u64, RelocError](adjusted));
    }
    val value: u64 = R.unwrap_ok[u64, RelocError](adjusted);
    if (value > 0xFFFF) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    bin.write_u16_le(dst, patch_off::usize, (value & 0xFFFF)::u16);
    ret R.ok[bool, RelocError](true);
}

pub fun apply_pcrel32(dst: *u8, patch_off: u32, sec_len: u32,
                      sym_va: u64, addend: i64, patch_va: u64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val displaced: R.Result[i64, RelocError] = displacement(sym_va, addend, patch_va);
    if (R.is_err[i64, RelocError](displaced)) {
        ret R.err[bool, RelocError](R.unwrap_err[i64, RelocError](displaced));
    }
    val disp: i64 = R.unwrap_ok[i64, RelocError](displaced);
    if (disp > 2147483647 || disp < -2147483648) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    bin.write_u32_le(dst, patch_off::usize, ((disp::u64) & 0xFFFFFFFF)::u32);
    ret R.ok[bool, RelocError](true);
}

pub fun apply_pcrel64(dst: *u8, patch_off: u32, sec_len: u32,
                      sym_va: u64, addend: i64, patch_va: u64) R.Result[bool, RelocError] {
    if (patch_off::u64 + 8 > sec_len::u64) {
        ret R.err[bool, RelocError](RELOC_OVERFLOW);
    }
    val displaced: R.Result[i64, RelocError] = displacement(sym_va, addend, patch_va);
    if (R.is_err[i64, RelocError](displaced)) {
        ret R.err[bool, RelocError](R.unwrap_err[i64, RelocError](displaced));
    }
    bin.write_u64_le(dst, patch_off::usize,
                     R.unwrap_ok[i64, RelocError](displaced)::u64);
    ret R.ok[bool, RelocError](true);
}

test "mach.lang.target.of.reloc.checked_address_arithmetic:boundaries" {
    val add_zero: R.Result[u64, RelocError] = add_signed_to_u64(4, -4);
    val add_max: R.Result[u64, RelocError] =
        add_signed_to_u64(0xFFFFFFFFFFFFFFFA, 5);
    val add_under: R.Result[u64, RelocError] = add_signed_to_u64(4, -5);
    val add_over: R.Result[u64, RelocError] =
        add_signed_to_u64(0xFFFFFFFFFFFFFFFF, 1);
    val add_min: R.Result[u64, RelocError] =
        add_signed_to_u64(0x8000000000000000, I64_MIN_VALUE);
    if (R.is_err[u64, RelocError](add_zero)
        || R.unwrap_ok[u64, RelocError](add_zero) != 0
        || R.is_err[u64, RelocError](add_max)
        || R.unwrap_ok[u64, RelocError](add_max) != 0xFFFFFFFFFFFFFFFF
        || !R.is_err[u64, RelocError](add_under)
        || !R.is_err[u64, RelocError](add_over)
        || R.is_err[u64, RelocError](add_min)
        || R.unwrap_ok[u64, RelocError](add_min) != 0) { ret 1; }

    val signed_min: R.Result[i64, RelocError] = add_u64_to_i64(0, I64_MIN_VALUE);
    val signed_max: R.Result[i64, RelocError] =
        add_u64_to_i64(0xFFFFFFFFFFFFFFFF, I64_MIN_VALUE);
    val signed_over: R.Result[i64, RelocError] =
        add_u64_to_i64(0xFFFFFFFFFFFFFFFF, 0);
    if (R.is_err[i64, RelocError](signed_min)
        || R.unwrap_ok[i64, RelocError](signed_min) != I64_MIN_VALUE
        || R.is_err[i64, RelocError](signed_max)
        || R.unwrap_ok[i64, RelocError](signed_max) != 9223372036854775807
        || !R.is_err[i64, RelocError](signed_over)) { ret 2; }

    val sub_min: R.Result[i64, RelocError] =
        subtract_u64_from_i64(0, 0x8000000000000000);
    val sub_cancel: R.Result[i64, RelocError] =
        subtract_u64_from_i64(9223372036854775807, 0xFFFFFFFFFFFFFFFF);
    val sub_under: R.Result[i64, RelocError] =
        subtract_u64_from_i64(I64_MIN_VALUE, 1);
    if (R.is_err[i64, RelocError](sub_min)
        || R.unwrap_ok[i64, RelocError](sub_min) != I64_MIN_VALUE
        || R.is_err[i64, RelocError](sub_cancel)
        || R.unwrap_ok[i64, RelocError](sub_cancel) != I64_MIN_VALUE
        || !R.is_err[i64, RelocError](sub_under)) { ret 3; }

    val disp_max: R.Result[i64, RelocError] =
        displacement(0xFFFFFFFFFFFFFFFF, I64_MIN_VALUE, 0);
    val disp_min: R.Result[i64, RelocError] =
        displacement(0, 0, 0x8000000000000000);
    val disp_under: R.Result[i64, RelocError] =
        displacement(0, -1, 0x8000000000000000);
    if (R.is_err[i64, RelocError](disp_max)
        || R.unwrap_ok[i64, RelocError](disp_max) != 9223372036854775807
        || R.is_err[i64, RelocError](disp_min)
        || R.unwrap_ok[i64, RelocError](disp_min) != I64_MIN_VALUE
        || !R.is_err[i64, RelocError](disp_under)) { ret 4; }

    var dst: [8]u8;
    val abs_under: R.Result[bool, RelocError] = apply_abs64(?dst[0], 0, 8, 0, -1);
    val pc_cancel: R.Result[bool, RelocError] =
        apply_pcrel64(?dst[0], 0, 8, 0xFFFFFFFFFFFFFFFF, I64_MIN_VALUE, 0);
    if (!R.is_err[bool, RelocError](abs_under)
        || R.is_err[bool, RelocError](pc_cancel)
        || bin.read_u64_le(?dst[0], 0) != 0x7FFFFFFFFFFFFFFF) { ret 5; }
    ret 0;
}

pub def NormalizeImageFn: of.NormalizeImageFn;

pub fun normalize_image(tgt_isa: *isa.IsaVTable, alloc: *A.Allocator,
                        img: *of.ObjectImage) R.Result[R.Void, str] {
    if (tgt_isa == nil)                       { ret R.ok_void[str](); }
    if (!isa.emits_relocations(tgt_isa))      { ret R.ok_void[str](); }
    if (tgt_isa.reloc.normalize == nil)       { ret R.ok_void[str](); }
    ret tgt_isa.reloc.normalize(alloc, img);
}

pub fun resolve_operand(tgt_isa: *isa.IsaVTable, img: *of.ObjectImage,
                        reloc_index: u32) R.Result[of.RelocOperand, str] {
    if (img == nil || reloc_index >= img.reloc_count) {
        ret R.err[of.RelocOperand, str]("relocation operand resolution received an absent relocation");
    }
    if (tgt_isa != nil && isa.emits_relocations(tgt_isa)
        && tgt_isa.reloc.resolve_operand != nil) {
        ret tgt_isa.reloc.resolve_operand(img, reloc_index);
    }
    var operand: of.RelocOperand;
    operand.sym = img.relocations[reloc_index].sym;
    operand.addend = img.relocations[reloc_index].addend;
    ret R.ok[of.RelocOperand, str](operand);
}
