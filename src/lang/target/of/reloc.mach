use std.types.canonical.res;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.string.str;
use std.types.size.usize;

use A: std.allocator;
use R: std.types.result;

use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;

pub def RelocError: of.RelocError;

pub val RELOC_OVERFLOW: RelocError = of.RELOC_OVERFLOW;

pub val RELOC_UNSUPPORTED: RelocError = of.RELOC_UNSUPPORTED;

pub val RELOC_INVALID_INSTRUCTION: RelocError = of.RELOC_INVALID_INSTRUCTION;

pub def RelocAddendMode: of.RelocAddendMode;

pub val RELOC_ADDEND_SYMBOL: RelocAddendMode = of.RELOC_ADDEND_SYMBOL;

pub val RELOC_ADDEND_FIELD_BIAS: RelocAddendMode = of.RELOC_ADDEND_FIELD_BIAS;

pub val RELOC_ADDEND_IGNORED: RelocAddendMode = of.RELOC_ADDEND_IGNORED;

pub def RelocTraits: of.RelocTraits;

pub fun traits(field_width: u32, addend_mode: RelocAddendMode,
               text_bias_min: i32, text_bias_max: i32) RelocTraits {
    var t: RelocTraits;
    t.field_width   = field_width;
    t.addend_mode   = addend_mode;
    t.text_bias_min = text_bias_min;
    t.text_bias_max = text_bias_max;
    ret t;
}

pub def RelocTarget: of.RelocTarget;

pub fun target(vaddr: u64, section_vaddr: u64, section_index: u32) RelocTarget {
    var t: RelocTarget;
    t.vaddr = vaddr;
    t.section_vaddr = section_vaddr;
    t.section_index = section_index;
    ret t;
}

pub def RelocTraitsFn: of.RelocTraitsFn;

pub def ApplyRelocFn: of.ApplyRelocFn;

val I64_MAX_U64: u64 = 0x7FFFFFFFFFFFFFFF;
val I64_SIGN_U64: u64 = 0x8000000000000000;
val I64_MIN_VALUE: i64 = -9223372036854775807 - 1;

pub fun add_signed_to_u64(base: u64, addend: i64) res[u64, RelocError] {
    if (addend >= 0) {
        val positive: u64 = addend::u64;
        if (base > 0xFFFFFFFFFFFFFFFF - positive) {
            ret res[u64, RelocError].err{RELOC_OVERFLOW};
        }
        ret res[u64, RelocError].ok{base + positive};
    }
    val magnitude: u64 = (-(addend + 1))::u64 + 1;
    if (base < magnitude) { ret res[u64, RelocError].err{RELOC_OVERFLOW}; }
    ret res[u64, RelocError].ok{base - magnitude};
}

pub fun add_u64_to_i64(base: u64, addend: i64) res[i64, RelocError] {
    if (addend >= 0) {
        val positive: u64 = addend::u64;
        if (base > I64_MAX_U64 - positive) {
            ret res[i64, RelocError].err{RELOC_OVERFLOW};
        }
        ret res[i64, RelocError].ok{(base + positive)::i64};
    }
    val magnitude: u64 = (-(addend + 1))::u64 + 1;
    if (base >= magnitude) {
        val positive: u64 = base - magnitude;
        if (positive > I64_MAX_U64) { ret res[i64, RelocError].err{RELOC_OVERFLOW}; }
        ret res[i64, RelocError].ok{positive::i64};
    }
    val negative: u64 = magnitude - base;
    if (negative == I64_SIGN_U64) { ret res[i64, RelocError].ok{I64_MIN_VALUE}; }
    ret res[i64, RelocError].ok{0 - negative::i64};
}

pub fun subtract_u64_from_i64(base: i64, subtrahend: u64) res[i64, RelocError] {
    if (subtrahend <= I64_MAX_U64) {
        val signed: i64 = subtrahend::i64;
        if (base < I64_MIN_VALUE + signed) {
            ret res[i64, RelocError].err{RELOC_OVERFLOW};
        }
        ret res[i64, RelocError].ok{base - signed};
    }
    val beyond_minimum: u64 = subtrahend - I64_SIGN_U64;
    if (base < 0 || base::u64 < beyond_minimum) {
        ret res[i64, RelocError].err{RELOC_OVERFLOW};
    }
    ret res[i64, RelocError].ok{I64_MIN_VALUE + (base::u64 - beyond_minimum)::i64};
}

pub fun displacement(target_vaddr: u64, addend: i64,
                     patch_vaddr: u64) res[i64, RelocError] {
    if (target_vaddr >= patch_vaddr) {
        ret add_u64_to_i64(target_vaddr - patch_vaddr, addend);
    }
    ret subtract_u64_from_i64(addend, patch_vaddr - target_vaddr);
}

pub fun apply_abs64(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) res[bool, RelocError] {
    if (patch_off::u64 + 8 > sec_len::u64) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    val adjusted: res[u64, RelocError] = add_signed_to_u64(sym_va, addend);
    if (sel adjusted.err) {
        ret res[bool, RelocError].err{adjusted.err};
    }
    val value: u64 = adjusted.ok;
    bin.write_u64_le(dst, patch_off::usize, value);
    ret res[bool, RelocError].ok{true};
}

pub fun apply_abs32(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) res[bool, RelocError] {
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    val adjusted: res[u64, RelocError] = add_signed_to_u64(sym_va, addend);
    if (sel adjusted.err) {
        ret res[bool, RelocError].err{adjusted.err};
    }
    val value: u64 = adjusted.ok;
    if (value > 0xFFFFFFFF) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    bin.write_u32_le(dst, patch_off::usize, (value & 0xFFFFFFFF)::u32);
    ret res[bool, RelocError].ok{true};
}

pub fun apply_abs16(dst: *u8, patch_off: u32, sec_len: u32,
                    sym_va: u64, addend: i64) res[bool, RelocError] {
    if (patch_off::u64 + 2 > sec_len::u64) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    val adjusted: res[u64, RelocError] = add_signed_to_u64(sym_va, addend);
    if (sel adjusted.err) {
        ret res[bool, RelocError].err{adjusted.err};
    }
    val value: u64 = adjusted.ok;
    if (value > 0xFFFF) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    bin.write_u16_le(dst, patch_off::usize, (value & 0xFFFF)::u16);
    ret res[bool, RelocError].ok{true};
}

pub fun apply_pcrel32(dst: *u8, patch_off: u32, sec_len: u32,
                      sym_va: u64, addend: i64, patch_va: u64) res[bool, RelocError] {
    if (patch_off::u64 + 4 > sec_len::u64) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    val displaced: res[i64, RelocError] = displacement(sym_va, addend, patch_va);
    if (sel displaced.err) {
        ret res[bool, RelocError].err{displaced.err};
    }
    val disp: i64 = displaced.ok;
    if (disp > 2147483647 || disp < -2147483648) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    bin.write_u32_le(dst, patch_off::usize, ((disp::u64) & 0xFFFFFFFF)::u32);
    ret res[bool, RelocError].ok{true};
}

pub fun apply_pcrel64(dst: *u8, patch_off: u32, sec_len: u32,
                      sym_va: u64, addend: i64, patch_va: u64) res[bool, RelocError] {
    if (patch_off::u64 + 8 > sec_len::u64) {
        ret res[bool, RelocError].err{RELOC_OVERFLOW};
    }
    val displaced: res[i64, RelocError] = displacement(sym_va, addend, patch_va);
    if (sel displaced.err) {
        ret res[bool, RelocError].err{displaced.err};
    }
    bin.write_u64_le(dst, patch_off::usize,
                     displaced.ok::u64);
    ret res[bool, RelocError].ok{true};
}

test "mach.lang.target.of.reloc.checked_address_arithmetic:boundaries" {
    val add_zero: res[u64, RelocError] = add_signed_to_u64(4, -4);
    val add_max: res[u64, RelocError] =
        add_signed_to_u64(0xFFFFFFFFFFFFFFFA, 5);
    val add_under: res[u64, RelocError] = add_signed_to_u64(4, -5);
    val add_over: res[u64, RelocError] =
        add_signed_to_u64(0xFFFFFFFFFFFFFFFF, 1);
    val add_min: res[u64, RelocError] =
        add_signed_to_u64(0x8000000000000000, I64_MIN_VALUE);
    if (sel add_zero.err) { ret 1; }
    if (add_zero.ok != 0) { ret 1; }
    if (sel add_max.err) { ret 1; }
    if (add_max.ok != 0xFFFFFFFFFFFFFFFF) { ret 1; }
    if (!sel add_under.err) { ret 1; }
    if (!sel add_over.err) { ret 1; }
    if (sel add_min.err) { ret 1; }
    if (add_min.ok != 0) { ret 1; }

    val signed_min: res[i64, RelocError] = add_u64_to_i64(0, I64_MIN_VALUE);
    val signed_max: res[i64, RelocError] =
        add_u64_to_i64(0xFFFFFFFFFFFFFFFF, I64_MIN_VALUE);
    val signed_over: res[i64, RelocError] =
        add_u64_to_i64(0xFFFFFFFFFFFFFFFF, 0);
    if (sel signed_min.err) { ret 2; }
    if (signed_min.ok != I64_MIN_VALUE) { ret 2; }
    if (sel signed_max.err) { ret 2; }
    if (signed_max.ok != 9223372036854775807) { ret 2; }
    if (!sel signed_over.err) { ret 2; }

    val sub_min: res[i64, RelocError] =
        subtract_u64_from_i64(0, 0x8000000000000000);
    val sub_cancel: res[i64, RelocError] =
        subtract_u64_from_i64(9223372036854775807, 0xFFFFFFFFFFFFFFFF);
    val sub_under: res[i64, RelocError] =
        subtract_u64_from_i64(I64_MIN_VALUE, 1);
    if (sel sub_min.err) { ret 3; }
    if (sub_min.ok != I64_MIN_VALUE) { ret 3; }
    if (sel sub_cancel.err) { ret 3; }
    if (sub_cancel.ok != I64_MIN_VALUE) { ret 3; }
    if (!sel sub_under.err) { ret 3; }

    val disp_max: res[i64, RelocError] =
        displacement(0xFFFFFFFFFFFFFFFF, I64_MIN_VALUE, 0);
    val disp_min: res[i64, RelocError] =
        displacement(0, 0, 0x8000000000000000);
    val disp_under: res[i64, RelocError] =
        displacement(0, -1, 0x8000000000000000);
    if (sel disp_max.err) { ret 4; }
    if (disp_max.ok != 9223372036854775807) { ret 4; }
    if (sel disp_min.err) { ret 4; }
    if (disp_min.ok != I64_MIN_VALUE) { ret 4; }
    if (!sel disp_under.err) { ret 4; }

    var dst: [8]u8;
    val abs_under: res[bool, RelocError] = apply_abs64(?dst[0], 0, 8, 0, -1);
    val pc_cancel: res[bool, RelocError] =
        apply_pcrel64(?dst[0], 0, 8, 0xFFFFFFFFFFFFFFFF, I64_MIN_VALUE, 0);
    if (!sel abs_under.err) { ret 5; }
    if (sel pc_cancel.err) { ret 5; }
    if (bin.read_u64_le(?dst[0], 0) != 0x7FFFFFFFFFFFFFFF) { ret 5; }
    ret 0;
}

pub def NormalizeImageFn: of.NormalizeImageFn;

pub fun normalize_image(tgt_isa: *isa.IsaVTable, alloc: *A.Allocator,
                        img: *of.ObjectImage) err[fail.Fail] {
    if (tgt_isa == nil)                       { ret err[fail.Fail].ok{}; }
    if (!isa.emits_relocations(tgt_isa))      { ret err[fail.Fail].ok{}; }
    if (tgt_isa.reloc.normalize == nil)       { ret err[fail.Fail].ok{}; }
    val r_704: R.Result[R.Void, str] = tgt_isa.reloc.normalize(alloc, img);
    if (R.is_err[R.Void, str](r_704)) { ret err[fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](r_704))}; }
    ret err[fail.Fail].ok{};
}

pub fun resolve_operand(tgt_isa: *isa.IsaVTable, img: *of.ObjectImage,
                        reloc_index: u32) res[of.RelocOperand, fail.Fail] {
    if (img == nil || reloc_index >= img.reloc_count) {
        ret res[of.RelocOperand, fail.Fail].err{fail.message("relocation operand resolution received an absent relocation")};
    }
    if (tgt_isa != nil && isa.emits_relocations(tgt_isa)
        && tgt_isa.reloc.resolve_operand != nil) {
        ret tgt_isa.reloc.resolve_operand(img, reloc_index);
    }
    var operand: of.RelocOperand;
    operand.target_kind = img.relocations[reloc_index].kind;
    operand.sym = img.relocations[reloc_index].sym;
    operand.addend = img.relocations[reloc_index].addend;
    ret res[of.RelocOperand, fail.Fail].ok{operand};
}
