use mach.lang.build.outcome;
use mach.lang.fail;
use fixture: mach.lang.output.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;

use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;

use A:  std.allocator;
use fs: std.filesystem;

use mach.lang.be.codegen.debug_input;
use mach.lang.intern;
use mach.lang.output;
use mach.lang.target.isa;
use mach.lang.target.isa.spirv;
use mach.lang.target.of;
use mach.lang.target.of.bin;

pub rec SpvSummary {
    version:           u32;
    bound:             u32;
    instruction_count: u32;
}

pub fun validate(buf: *u8, len: usize) res[SpvSummary, fail.Fail] {
    if (len < 20) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module is smaller than the 5-word header")};
    }
    if (len % 4 != 0) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module length is not a multiple of 4 bytes")};
    }

    val magic: u32 = bin.read_u32_le(buf, 0);
    if (magic != spirv.SPV_MAGIC) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module magic does not match little-endian SPIR-V")};
    }
    val version: u32 = bin.read_u32_le(buf, 4);
    val bound:   u32 = bin.read_u32_le(buf, 12);
    val schema:  u32 = bin.read_u32_le(buf, 16);
    if (schema != 0) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module schema field is not reserved-zero")};
    }

    var pos:         usize = 20;
    var instr_count: u32   = 0;
    for (pos < len) {
        if (!bin.region_ok(len, pos, 4)) {
            ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: truncated instruction word")};
        }
        val w:  u32 = bin.read_u32_le(buf, pos);
        val wc: u32 = w >> 16;
        if (wc == 0) {
            ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: instruction declares a zero word count")};
        }
        val instr_bytes: usize = (wc::usize) * 4;
        if (!bin.region_ok(len, pos, instr_bytes)) {
            ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: instruction word count overruns the module")};
        }
        pos         = pos + instr_bytes;
        instr_count = instr_count + 1;
    }
    if (pos != len) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: instruction stream does not end exactly at the module boundary")};
    }

    var s: SpvSummary;
    s.version           = version;
    s.bound             = bound;
    s.instruction_count = instr_count;
    ret res[SpvSummary, fail.Fail].ok{s};
}

fun emit_object(isa_vt: *of.ObjectTarget, image: *of.ObjectImage, destination: str) err[fail.Fail] {
    val sec: *of.Section = find_module_section(image);
    if (sec == nil) {
        ret err[fail.Fail].err{fail.message("of.spv: object image carries no SPIR-V module section")};
    }
    if (sec.bytes == nil || sec.len == 0) {
        ret err[fail.Fail].err{fail.message("of.spv: SPIR-V module section is empty")};
    }
    val vr: res[SpvSummary, fail.Fail] = validate(sec.bytes, sec.len::usize);
    if (sel vr.err) {
        ret err[fail.Fail].err{vr.err};
    }
    if (destination == nil) { ret err[fail.Fail].err{fail.message("of.spv: nil object destination")}; }
    val r_96: err[outcome.Fail] = output.bytes(image.interner, image.alloc, destination, sec.bytes, sec.len::usize, 0o644, false, "of.spv: cannot publish", "of.spv: could not publish output file");
    if (sel r_96.err) { ret err[fail.Fail].err{fail.message(outcome.describe(r_96.err))}; }
    ret err[fail.Fail].ok{};
}

fun find_module_section(image: *of.ObjectImage) *of.Section {
    var i: u32 = 0;
    for (i < image.section_count) {
        val s:  *of.Section = ?image.sections[i];
        val nm: opt[str]    = intern.lookup(image.interner, s.name);
        if (sel nm.some && str_equals(nm.some, spirv.SPV_MODULE_SECTION)) { ret s; }
        i = i + 1;
    }
    if (image.section_count == 1) { ret ?image.sections[0]; }
    ret nil;
}

fun debug_supports(tgt: *debug_input.DebugTarget) bool {
    ret tgt != nil && tgt.of_id == of.OF_SPV;
}

# the spirv model is written into the module by the emitter: names, sources and line markers
pub fun debug_model() of.DebugVTable {
    ret of.module_debug_model(of.DBG_SPIRV, "spirv", debug_supports);
}

pub fun register(reg: *of.OfRegistry) err[fail.Fail] {
    var spv_vtable: of.OfVTable = of.artifact_vtable(
        of.OF_SPV, of.of_name_for(of.OF_SPV), "spv", emit_object);

    spv_vtable.two_level_namespace         = false;
    spv_vtable.default_debug               = "spirv";
    spv_vtable.shared_input_ext            = "";
    spv_vtable.import_address_prefix       = "";
    spv_vtable.header_in_first_segment     = false;
    spv_vtable.maps_by_page                = false;
    spv_vtable.carries_stack_size          = false;
    spv_vtable.default_stack_reserve       = 0;
    spv_vtable.executable_section_location = nil;

    spv_vtable.covers_isa_any   = false;
    spv_vtable.covers_isa_count = 0;
    of.cover_isa(?spv_vtable, isa.ARCH_SPIRV);

    ret of.register(reg, ?spv_vtable);
}

#[testing]
fun t_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(itn, s);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

#[testing]
fun t_poison(buf: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        buf[i] = 0xAA;
        i      = i + 1;
    }
}

#[testing]
fun t_header(buf: *u8, version: u32, bound: u32, schema: u32) {
    bin.write_u32_le(buf, 0, spirv.SPV_MAGIC);
    bin.write_u32_le(buf, 4, version);
    bin.write_u32_le(buf, 8, spirv.SPV_GENERATOR);
    bin.write_u32_le(buf, 12, bound);
    bin.write_u32_le(buf, 16, schema);
}

# the one-word refusals and the exact fit bracket each bound of the walk
test validate__module_shape {
    var buf: [32]u8;
    t_poison(?buf[0], 32);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 7, 0);
    val header_only: res[SpvSummary, fail.Fail] = validate(?buf[0], 20);
    if (sel header_only.err) { ret 1; }
    if (header_only.ok.version != spirv.SPV_VERSION_1_6 || header_only.ok.bound != 7
        || header_only.ok.instruction_count != 0) { ret 1; }

    bin.write_u32_le(?buf[0], 20, spirv.inst_word(0, 1));
    bin.write_u32_le(?buf[0], 24, spirv.inst_word(0, 2));
    bin.write_u32_le(?buf[0], 28, 0xDEADBEEF::u32);
    val two: res[SpvSummary, fail.Fail] = validate(?buf[0], 32);
    if (sel two.err)                   { ret 2; }
    if (two.ok.instruction_count != 2) { ret 2; }
    val exact: res[SpvSummary, fail.Fail] = validate(?buf[0], 24);
    if (sel exact.err)                   { ret 3; }
    if (exact.ok.instruction_count != 1) { ret 3; }

    if (!t_refused(?buf[0], 19, "smaller than the 5-word header")) { ret 4; }
    if (!t_refused(?buf[0], 21, "not a multiple of 4"))            { ret 5; }
    if (!t_refused(?buf[0], 28, "overruns the module"))            { ret 6; }
    bin.write_u32_le(?buf[0], 20, spirv.inst_word(0, 0));
    if (!t_refused(?buf[0], 24, "zero word count")) { ret 7; }
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 1);
    if (!t_refused(?buf[0], 20, "reserved-zero")) { ret 8; }
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 0);
    bin.write_u32_le(?buf[0], 0, 0x03022307::u32);
    if (!t_refused(?buf[0], 20, "magic")) { ret 9; }
    ret 0;
}

#[testing]
fun t_refused(buf: *u8, len: usize, reason: str) bool {
    val vr: res[SpvSummary, fail.Fail] = validate(buf, len);
    if (sel vr.ok) { ret false; }
    ret str_contains(fail.describe(vr.err), reason);
}

# a valid module is written byte for byte; a malformed one is refused and
# leaves the destination untouched
test emit_object__writes_the_module_or_nothing {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var mod: [32]u8;
    t_poison(?mod[0], 32);
    t_header(?mod[0], spirv.SPV_VERSION_1_6, 11, 0);
    bin.write_u32_le(?mod[0], 20, spirv.inst_word(0, 1));
    bin.write_u32_le(?mod[0], 24, spirv.inst_word(0, 2));
    bin.write_u32_le(?mod[0], 28, 0xDEADBEEF::u32);

    var secs: [1]of.Section;
    secs[0].name  = t_intern(?itn, spirv.SPV_MODULE_SECTION);
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?mod[0];
    secs[0].len   = 28;
    secs[0].align = 4;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?itn;
    img.name          = t_intern(?itn, "test");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = nil;
    img.symbol_count  = 0;
    img.relocations   = nil;
    img.reloc_count   = 0;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "spv_emit");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val refused: err[fail.Fail] = emit_object(nil, ?img, tpath);
    if (sel refused.ok)                                                   { ret 2; }
    if (!str_contains(fail.describe(refused.err), "overruns the module")) { ret 3; }
    val empty: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    if (sel empty.err) { ret 4; }
    var e: Vector[u8] = empty.ok;
    fin { vector.dnit[u8](?e); }
    if (e.len != 0) { ret 5; }

    secs[0].len = 32;
    val written: err[fail.Fail] = emit_object(nil, ?img, tpath);
    if (sel written.err) { ret 6; }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    if (sel rr.err) { ret 7; }
    var b: Vector[u8] = rr.ok;
    fin { vector.dnit[u8](?b); }
    if (b.len != 32) { ret 8; }
    var i: usize = 0;
    for (i < 32) {
        if (b.data[i] != mod[i]) { ret 9; }
        i = i + 1;
    }
    ret 0;
}
