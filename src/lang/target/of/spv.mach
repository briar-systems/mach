use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use output: mach.lang.publication.testing;
use txn: std.filesystem.transaction;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.size.usize;

use std.allocator.page;
use std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use fs: std.filesystem;

use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.isa.spirv;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.publication;

val SPV_SECTION: str = ".spirv";

pub rec SpvSummary {
    version:           u32;
    bound:             u32;
    instruction_count: u32;
}

pub fun validate(buf: *u8, len: usize) res[SpvSummary, fail.Fail] {
    if (len < 20) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module is smaller than the 5-word header")};
    }
    if (len % 4 != 0) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module length is not a multiple of 4 bytes")};
    }

    val magic: u32 = bin.read_u32_le(buf, 0);
    if (magic != spirv.SPV_MAGIC) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module magic does not match little-endian SPIR-V")};
    }
    val version: u32 = bin.read_u32_le(buf, 4);
    val bound:   u32 = bin.read_u32_le(buf, 12);
    val schema:  u32 = bin.read_u32_le(buf, 16);
    if (schema != 0) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: module schema field is not reserved-zero")};
    }

    var pos: usize = 20;
    var instr_count: u32 = 0;
    for (pos < len) {
        if (!bin.region_ok(len, pos, 4)) {
            ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: truncated instruction word")};
        }
        val w:  u32 = bin.read_u32_le(buf, pos);
        val wc: u32 = w >> 16;
        if (wc == 0) {
            ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: instruction declares a zero word count")};
        }
        val instr_bytes: usize = (wc::usize) * 4;
        if (!bin.region_ok(len, pos, instr_bytes)) {
            ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: instruction word count overruns the module")};
        }
        pos = pos + instr_bytes;
        instr_count = instr_count + 1;
    }
    if (pos != len) {
        ret res[SpvSummary, fail.Fail].err{fail.message("of.spv: instruction stream does not end exactly at the module boundary")};
    }

    var s: SpvSummary;
    s.version           = version;
    s.bound              = bound;
    s.instruction_count = instr_count;
    ret res[SpvSummary, fail.Fail].ok{s};
}

fun emit_object(isa_vt: *of.ObjectTarget, image: *of.ObjectImage, destination: *publication.Destination) err[fail.Fail] {
    val sec: *of.Section = find_module_section(image);
    if (sec == nil) {
        ret err[fail.Fail].err{fail.message("of.spv: object image carries no SPIR-V module section")};
    }
    if (sec.bytes == nil || sec.len == 0) {
        ret err[fail.Fail].err{fail.message("of.spv: SPIR-V module section is empty")};
    }
    val vr: res[SpvSummary, fail.Fail] = validate(sec.bytes, sec.len::usize);
    if (sel vr.err) {
        ret err[fail.Fail].err{vr.err};
    }
    if (destination == nil) { ret err[fail.Fail].err{fail.message("of.spv: nil object destination")}; }
    val r_96: R.Result[R.Void, str] = publication.bytes_at(image.interner, image.alloc, ?destination.claim, destination.path, sec.bytes, sec.len::usize, 0o644, publication.REPLACE, "of.spv: cannot publish", "of.spv: could not publish output file", nil);
    if (R.is_err[R.Void, str](r_96)) { ret err[fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](r_96))}; }
    ret err[fail.Fail].ok{};
}

# translation shim (#3226): the vtable slot reads the legacy carrier until C5 retypes the contract
fun emit_object_legacy(isa_vt: *of.ObjectTarget, image: *of.ObjectImage, destination: *publication.Destination) R.Result[R.Void, str] {
    ret fail.lower_unit(emit_object(isa_vt, image, destination));
}

fun find_module_section(image: *of.ObjectImage) *of.Section {
    var i: u32 = 0;
    for (i < image.section_count) {
        val s: *of.Section = ?image.sections[i];
        val nm: opt[str] = intern.lookup_typed(image.interner, s.name);
        if (sel nm.some && str_equals(nm.some, SPV_SECTION)) { ret s; }
        i = i + 1;
    }
    if (image.section_count == 1) { ret ?image.sections[0]; }
    ret nil;
}

pub fun register(reg: *of.OfRegistry) err[fail.Fail] {
    var spv_vtable: of.OfVTable = of.artifact_vtable(
        of.OF_SPV, of.of_name_for(of.OF_SPV), "spv", emit_object_legacy
    );

    spv_vtable.two_level_namespace = false;
    spv_vtable.default_debug       = "";
    spv_vtable.shared_input_ext    = "";
    spv_vtable.import_address_prefix = "";
    spv_vtable.header_in_first_segment = false;
    spv_vtable.carries_stack_size = false;
    spv_vtable.default_stack_reserve = 0;
    spv_vtable.executable_section_location = nil;

    spv_vtable.covers_isa_any   = false;
    spv_vtable.covers_isa_count = 0;
    of.cover_isa(?spv_vtable, isa.ARCH_SPIRV);

    ret of.register(reg, ?spv_vtable);
}

fun t_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern_typed(itn, s);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

fun t_poison(buf: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) { buf[i] = 0xAA; i = i + 1; }
}

fun t_header(buf: *u8, version: u32, bound: u32, schema: u32) {
    bin.write_u32_le(buf, 0,  spirv.SPV_MAGIC);
    bin.write_u32_le(buf, 4,  version);
    bin.write_u32_le(buf, 8,  spirv.SPV_GENERATOR);
    bin.write_u32_le(buf, 12, bound);
    bin.write_u32_le(buf, 16, schema);
}

test "mach.lang.target.of.spv.validate:header_only_module_is_valid_with_zero_instructions" {
    var buf: [20]u8;
    t_poison(?buf[0], 20);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 7, 0);

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 20);
    if (sel vr.err) { ret 1; }
    val s: SpvSummary = vr.ok;
    if (s.version != spirv.SPV_VERSION_1_6) { ret 1; }
    if (s.bound != 7) { ret 1; }
    if (s.instruction_count != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:two_instruction_module_round_trips" {
    var buf: [32]u8;
    t_poison(?buf[0], 32);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 11, 0);
    bin.write_u32_le(?buf[0], 20, spirv.inst_word(0, 1));
    bin.write_u32_le(?buf[0], 24, spirv.inst_word(0, 2));
    bin.write_u32_le(?buf[0], 28, 0xDEADBEEF::u32);

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 32);
    if (sel vr.err) { ret 1; }
    val s: SpvSummary = vr.ok;
    if (s.bound != 11) { ret 1; }
    if (s.instruction_count != 2) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.emit_object:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var mod: [32]u8;
    t_poison(?mod[0], 32);
    t_header(?mod[0], spirv.SPV_VERSION_1_6, 11, 0);
    bin.write_u32_le(?mod[0], 20, spirv.inst_word(0, 1));
    bin.write_u32_le(?mod[0], 24, spirv.inst_word(0, 2));
    bin.write_u32_le(?mod[0], 28, 0xDEADBEEF::u32);

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, SPV_SECTION); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?mod[0]; secs[0].len = 32; secs[0].align = 4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "spvsize");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = nil; img.symbol_count = 0;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "spv_size");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }

    val tpath: str = output.path(?tf);

    var isa_vt: of.ObjectTarget;
    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 2; }
    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    if (sel rr.err) { ret 3; }
    var b: Vector[u8] = rr.ok;
    val written: usize = b.len;
    vector.dnit[u8](?b);
    if (written != 32) { ret 4; }

    secs[0].len = 28;
    val short_em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (!sel short_em.err) { ret 5; }
    if (!str_contains(fail.describe(short_em.err), "word count overruns")) { ret 6; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:buffer_one_byte_short_of_header_is_refused" {
    var buf: [19]u8;
    t_poison(?buf[0], 19);

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 19);
    if (!sel vr.err) { ret 1; }
    if (!str_contains(fail.describe(vr.err), "smaller than the 5-word header")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:length_one_byte_past_a_whole_word_is_refused" {
    var buf: [21]u8;
    t_poison(?buf[0], 21);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 0);

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 21);
    if (!sel vr.err) { ret 1; }
    if (!str_contains(fail.describe(vr.err), "not a multiple of 4")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:byte_swapped_magic_is_refused" {
    var buf: [20]u8;
    t_poison(?buf[0], 20);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 0);
    bin.write_u32_le(?buf[0], 0, 0x03022307::u32);

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 20);
    if (!sel vr.err) { ret 1; }
    if (!str_contains(fail.describe(vr.err), "magic")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:nonzero_schema_is_refused" {
    var buf: [20]u8;
    t_poison(?buf[0], 20);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 1);

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 20);
    if (!sel vr.err) { ret 1; }
    if (!str_contains(fail.describe(vr.err), "reserved-zero")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:zero_word_count_instruction_is_refused" {
    var buf: [24]u8;
    t_poison(?buf[0], 24);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 0);
    bin.write_u32_le(?buf[0], 20, spirv.inst_word(0, 0));

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 24);
    if (!sel vr.err) { ret 1; }
    if (!str_contains(fail.describe(vr.err), "zero word count")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:instruction_claiming_exactly_the_available_words_is_valid" {
    var buf: [24]u8;
    t_poison(?buf[0], 24);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 0);
    bin.write_u32_le(?buf[0], 20, spirv.inst_word(0, 1));

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 24);
    if (sel vr.err) { ret 1; }
    val s: SpvSummary = vr.ok;
    if (s.instruction_count != 1) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.validate:instruction_claiming_one_word_past_available_is_refused" {
    var buf: [24]u8;
    t_poison(?buf[0], 24);
    t_header(?buf[0], spirv.SPV_VERSION_1_6, 1, 0);
    bin.write_u32_le(?buf[0], 20, spirv.inst_word(0, 2));

    val vr: res[SpvSummary, fail.Fail] = validate(?buf[0], 24);
    if (!sel vr.err) { ret 1; }
    if (!str_contains(fail.describe(vr.err), "overruns the module")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.emit_object:malformed_section_is_refused_and_nothing_is_written" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var garbage: [24]u8;
    t_poison(?garbage[0], 24);
    t_header(?garbage[0], spirv.SPV_VERSION_1_6, 1, 0);
    bin.write_u32_le(?garbage[0], 20, spirv.inst_word(0, 2));

    var secs: [1]of.Section;
    secs[0].name = t_intern(?itn, SPV_SECTION); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?garbage[0]; secs[0].len = 24; secs[0].align = 4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?itn;
    img.name = t_intern(?itn, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = nil; img.symbol_count = 0;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "spv_malformed");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(nil, ?img, tpath::*u8);

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);


    if (!sel em.err) { ret 1; }
    if (!str_contains(fail.describe(em.err), "overruns the module")) { ret 1; }

    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;
    val leftover: usize = b.len;
    vector.dnit[u8](?b);
    if (leftover != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.spv.emit_object:well_formed_section_is_written_byte_for_byte" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var mod: [24]u8;
    t_poison(?mod[0], 24);
    t_header(?mod[0], spirv.SPV_VERSION_1_6, 3, 0);
    bin.write_u32_le(?mod[0], 20, spirv.inst_word(0, 1));

    var secs: [1]of.Section;
    secs[0].name = t_intern(?itn, SPV_SECTION); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?mod[0]; secs[0].len = 24; secs[0].align = 4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?itn;
    img.name = t_intern(?itn, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = nil; img.symbol_count = 0;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "spv_wellformed");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(nil, ?img, tpath::*u8);

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);


    if (sel em.err) { ret 1; }
    if (sel rr.err) { ret 1; }
    var b: Vector[u8] = rr.ok;
    if (b.len != 24) { vector.dnit[u8](?b); ret 1; }

    var i: usize = 0;
    var bad: bool = false;
    for (i < 24) {
        if (b.data[i] != mod[i]) { bad = true; }
        i = i + 1;
    }
    vector.dnit[u8](?b);
    if (bad) { ret 1; }
    ret 0;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) res[*publication.Destination, fail.Fail] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(O.unwrap[txn.Error](initialized)))}; }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret res[*publication.Destination, fail.Fail].err{fail.message(R.unwrap_err[*publication.Destination, str](destination))}; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(O.unwrap[txn.Error](sealed)))}; }
    if (R.is_err[*publication.Destination, str](destination)) { ret res[*publication.Destination, fail.Fail].err{fail.message(R.unwrap_err[*publication.Destination, str](destination))}; }
    ret res[*publication.Destination, fail.Fail].ok{R.unwrap_ok[*publication.Destination, str](destination)};
}

fun t_publication_close(operation: *publication.Plan, result: err[fail.Fail]) err[fail.Fail] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (sel result.ok && O.is_some[txn.Error](closed)) {
        ret err[fail.Fail].err{fail.message(txn.error_message(O.unwrap[txn.Error](closed)))};
    }
    ret result;
}

fun t_planned_emit_object(isa_vt: *of.ObjectTarget, image: *of.ObjectImage, path: *u8) err[fail.Fail] {
    if (path == nil) { ret emit_object(isa_vt, image, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened: res[*publication.Destination, fail.Fail] = t_publication_open(?operation, image.alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_object(isa_vt, image, opened.ok));
}

test "mach.lang.target.of.spv.emit_object:rejects_nil_destination" {
    var alloc: A.Allocator;
    val r_432: err[A.Error] = page.make(?alloc);
    if (sel r_432.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var module: [20]u8;
    t_header(?module[0], spirv.SPV_VERSION_1_6, 1, 0);
    var section: of.Section;
    section.name = t_intern(?itn, SPV_SECTION);
    section.kind = of.SK_TEXT;
    section.bytes = ?module[0];
    section.len = 20;
    section.align = 4;
    var image: of.ObjectImage;
    image.alloc = ?alloc;
    image.interner = ?itn;
    image.sections = ?section;
    image.section_count = 1;
    val written: err[fail.Fail] = emit_object(nil, ?image, nil::*publication.Destination);
    if (sel written.ok) { ret 2; }
    if (!str_equals(fail.describe(written.err), "of.spv: nil object destination")) { ret 3; }
    ret 0;
}
