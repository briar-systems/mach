use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mink_format: mink.catalog.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator.page;
use collections_vector: std.collections.vector;

use A:  std.allocator;
use fs: std.filesystem;

use mach.lang.intern;
use mir_debug:    mach.lang.mir.debug;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.isa;
use isa_spirv: mach.lang.target.isa.spirv;
use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_destination: mach.lang.target.of.destination;

pub rec SpvSummary {
    version:           u32;
    bound:             u32;
    instruction_count: u32;
}

pub fun validate(buf: *u8, len: usize) res[SpvSummary, fail.Fail] {
    if (len < 20) {
        ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V module is smaller than the 5-word header")};
    }
    if (len % 4 != 0) {
        ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V module length is not a multiple of 4 bytes")};
    }

    val magic: u32 = bin.read_u32_le(buf, 0);
    if (magic != isa_spirv.MAGIC) {
        ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V module magic does not match little-endian SPIR-V")};
    }
    val version: u32 = bin.read_u32_le(buf, 4);
    val bound:   u32 = bin.read_u32_le(buf, 12);
    val schema:  u32 = bin.read_u32_le(buf, 16);
    if (schema != 0) {
        ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V module schema field is not reserved-zero")};
    }

    var pos:         usize = 20;
    var instr_count: u32   = 0;
    for (pos < len) {
        if (!bin.region_ok(len, pos, 4)) {
            ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "truncated SPIR-V instruction word")};
        }
        val w:  u32 = bin.read_u32_le(buf, pos);
        val wc: u32 = w >> 16;
        if (wc == 0) {
            ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V instruction declares a zero word count")};
        }
        val instr_bytes: usize = (wc::usize) * 4;
        if (!bin.region_ok(len, pos, instr_bytes)) {
            ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V instruction word count overruns the module")};
        }
        pos         = pos + instr_bytes;
        instr_count = instr_count + 1;
    }
    if (pos != len) {
        ret res[SpvSummary, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "SPIR-V instruction stream does not end exactly at the module boundary")};
    }

    var s: SpvSummary;
    s.version           = version;
    s.bound             = bound;
    s.instruction_count = instr_count;
    ret res[SpvSummary, fail.Fail].ok{s};
}

fun object_emit(isa_vt: *target_of.ObjectTarget, image: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    val sec: *target_of.Section = find_module_section(image);
    if (sec == nil) {
        ret err[fail.Fail].err{fail.message("object image carries no SPIR-V module section")};
    }
    if (sec.bytes == nil || sec.len == 0) {
        ret err[fail.Fail].err{fail.message("SPIR-V module section is empty")};
    }
    # the module is the compiler's own output, so a module that does not
    # validate is a compiler defect, whatever the validator says of the bytes
    val vr: res[SpvSummary, fail.Fail] = validate(sec.bytes, sec.len::usize);
    if (sel vr.err) {
        ret err[fail.Fail].err{fail.as_internal(vr.err)};
    }
    val buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", sec.len::usize, 0o644);
    if (sel buf.err) { ret err[fail.Fail].err{buf.err}; }
    memory.raw_copy(buf.ok::ptr, sec.bytes::ptr, sec.len::usize);
    ret err[fail.Fail].ok{};
}

fun find_module_section(image: *target_of.ObjectImage) *target_of.Section {
    var i: u32 = 0;
    for (i < image.section_count) {
        val s:  *target_of.Section = ?image.sections[i];
        val nm: opt[str]           = intern.get(image.interner, s.name);
        if (sel nm.some && str_equals(nm.some, isa_spirv.MODULE_SECTION)) { ret s; }
        i = i + 1;
    }
    if (image.section_count == 1) { ret ?image.sections[0]; }
    ret nil;
}

fun debug_supports(tgt: *mir_debug.DebugTarget) bool {
    ret tgt != nil && tgt.of_id == target_of.SPV;
}

# the spirv model is written into the module by the emitter: names, sources and line markers
pub val DEBUG: target_of.DebugVTable = target_of.DebugVTable{
    id:       target_of.DBG_SPIRV,
    name:     "spirv",
    shape:    target_of.DEBUG_SHAPE_MODULE,
    supports: debug_supports,
};

val COVERS_ISAS: [1]u32 = [1]u32{catalog_arch.SPIRV};

pub val VTABLE: target_of.OfVTable = target_of.OfVTable{
    id:                      target_of.SPV,
    fingerprint_tag:         5,
    name:                    mink_format.SPIRV.name,
    object_is_artifact:      true,
    debug_offset_kind:       target_of.RK_ABS32,
    object_suffix:           ".spv",
    object_emit:             object_emit,
    default_debug:           "spirv",
    shared_input_ext:        "",
    import_address_prefix:   "",
    header_in_first_segment: false,
    maps_by_page:            false,
    carries_stack_size:      false,
    carries_record:          false,
    default_stack_reserve:   0,
    covers_isas:             ?COVERS_ISAS[0],
    covers_isa_count:        1,
};
