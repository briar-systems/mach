use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use catalog_arch:    mach.lang.target.catalog.arch;
use isa_arm64_reloc: mach.lang.target.isa.arm64.reloc;
use target_of:       mach.lang.target.of;
use mach.lang.target.of.bin;
use macho_format: mach.lang.target.of.macho.format;
use mach.lang.target.of.macho.segment;
use of_reloc: mach.lang.target.of.reloc;
use A:        std.allocator;
use std.allocator.page;
use std.encoding.leb128;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

pub rec MachoDynLayout {
    hdr_span:      usize;
    pagezero_size: u64;
    text_va:       u64;

    stubs_off:  usize;
    stubs_va:   u64;
    stubs_size: usize;

    got_va:   u64;
    got_size: usize;
    # the Mach-O segment holding the GOT and the GOT's offset inside it, as a
    # bind opcode addresses a slot
    got_seg_index:  u32;
    got_seg_offset: u64;

    linkedit_off:  usize;
    linkedit_va:   u64;
    linkedit_size: usize;

    rebase_off:  usize;
    rebase_size: usize;
    bind_off:    usize;
    bind_size:   usize;
    symtab_off:  usize;
    strtab_off:  usize;
    strtab_size: usize;
}

# a function's stub loads it from a slot, and a GOT-kind relocation reads one
pub fun import_needs_got(dyn: *target_of.DynamicInfo, import_index: u32) bool {
    if (import_index >= dyn.import_count) { ret false; }
    ret dyn.imports[import_index].is_func || dyn.imports[import_index].got_ref;
}

pub fun got_import_count(dyn: *target_of.DynamicInfo) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (import_needs_got(dyn, i)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

pub fun stub_size(arch_id: u32) usize {
    ret macho_format.row_for(arch_id).stub_size;
}

# the __TEXT,__stubs table the linker reserves at the end of the code, so a
# call site's branch reaches its stub whatever data the image carries
pub fun stub_shape(arch_id: u32, count: u32) res[target_of.TableShape, fail.Fail] {
    ret res[target_of.TableShape, fail.Fail].ok{target_of.TableShape{
        name: "__stubs", size: count::usize * stub_size(arch_id), align: 4
    }};
}

# the __DATA_CONST,__got table the linker reserves ahead of the zero-fill, so a
# stub or a GOT load reaches its slot whatever zero-fill the image carries
pub fun got_shape(arch_id: u32, dyn: *target_of.DynamicInfo) res[target_of.TableShape, fail.Fail] {
    ret res[target_of.TableShape, fail.Fail].ok{target_of.TableShape{
        name: "__got", size: got_import_count(dyn)::usize * 8, align: 8
    }};
}

pub fun write_macho_stub(buf: *u8, arch_id: u32, stub_off: usize, stub_va: u64, slot_va: u64) err[fail.Fail] {
    if (stub_va > 0x7FFFFFFFFFFFFFFF || slot_va > 0x7FFFFFFFFFFFFFFF) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "a stub or its GOT slot lies outside the signed address range")};
    }
    ret stubs_for(arch_id).write(buf, stub_off, stub_va, slot_va);
}

# adrp x16, slot@PAGE; ldr x16, [x16, slot@PAGEOFF]; br x16
fun arm64_stub(buf: *u8, stub_off: usize, stub_va: u64, slot_va: u64) err[fail.Fail] {
    val slot_page: u64 = (slot_va >> 12) << 12;
    val stub_page: u64 = (stub_va >> 12) << 12;
    val delta:     i64 = (slot_page::i64) - (stub_page::i64);
    if (delta < -4294967296 || delta >= 4294967296) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "a stub's GOT slot lies outside the adrp +-4GB range")};
    }
    val imm21: u64 = ((delta >> 12)::u64) & 0x1FFFFF;
    val immlo: u32 = (imm21 & 0x3)::u32;
    val immhi: u32 = ((imm21 >> 2) & 0x7FFFF)::u32;
    bin.write_u32_le(buf, stub_off, 0x90000000 | (immlo << 29) | (immhi << 5) | 16);
    val imm12: u32 = (((slot_va & 0xFFF) >> 3) & 0xFFF)::u32;
    bin.write_u32_le(buf, stub_off + 4, 0xF9400000 | (imm12 << 10) | (16 << 5) | 16);
    bin.write_u32_le(buf, stub_off + 8, 0xD61F0200);
    ret err[fail.Fail].ok{};
}

# jmp [rip + slot]
fun x64_stub(buf: *u8, stub_off: usize, stub_va: u64, slot_va: u64) err[fail.Fail] {
    val disp: i64 = slot_va::i64 - (stub_va + 6)::i64;
    if (disp > 2147483647 || disp < -2147483648) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "a stub's GOT slot lies outside the rip-relative +-2GB range")};
    }
    buf[stub_off]     = 0xFF;
    buf[stub_off + 1] = 0x25;
    bin.write_u32_le(buf, stub_off + 2, (disp::u64)::u32);
    ret err[fail.Fail].ok{};
}

# a call site bound to its stub: a b or bl's 26-bit word displacement
fun arm64_call(buf: *u8, file_off: usize, disp: i64) err[fail.Fail] {
    val lim: i64 = 134217728;
    if (disp < -lim || disp >= lim || (disp & 3) != 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic call-site displacement overflows a 26-bit branch")};
    }
    val word:  u32 = bin.read_u32_le(buf, file_off);
    val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
    bin.write_u32_le(buf, file_off, (word & 0xFC000000) | imm26);
    ret err[fail.Fail].ok{};
}

# a call site bound to its stub: a call's 32-bit displacement
fun x64_call(buf: *u8, file_off: usize, disp: i64) err[fail.Fail] {
    if (disp > 2147483647 || disp < -2147483648) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic call-site displacement overflows 32 bits")};
    }
    bin.write_u32_le(buf, file_off, (disp::u64)::u32);
    ret err[fail.Fail].ok{};
}

# how the linker writes an instruction set's import stubs and binds the code
# that reaches them: a call by its displacement, and the parts of an import's
# address through the instruction set's relocations, nil where none bind
rec StubRow {
    arch:         u32;
    write:        fun(*u8, usize, u64, u64) err[fail.Fail];
    bind_call:    fun(*u8, usize, i64) err[fail.Fail];
    bind_address: target_of.ApplyRelocFn;
}

val STUB_ROW_COUNT: usize                   = 2;
val STUB_ROWS:      [STUB_ROW_COUNT]StubRow = [STUB_ROW_COUNT]StubRow{
    StubRow{arch: catalog_arch.X86_64, write: x64_stub, bind_call: x64_call, bind_address: nil},
    StubRow{arch: catalog_arch.AARCH64, write: arm64_stub, bind_call: arm64_call, bind_address: isa_arm64_reloc.apply_reloc},
};

fun stubs_for(arch_id: u32) *StubRow {
    var i: usize = 0;
    for (i < STUB_ROW_COUNT) {
        if (STUB_ROWS[i].arch == arch_id) { ret ?STUB_ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun dylib_ordinal_for(dyn: *target_of.DynamicInfo, import_index: u32) u32 {
    val li: u32 = dyn.imports[import_index].lib_index;
    if (li == target_of.DYNLIB_ANY) { ret macho_format.DYNAMIC_LOOKUP_ORDINAL::u32; }
    ret li + 1;
}

fun measure_bind_prefix(itn: *intern.Interner, dyn: *target_of.DynamicInfo, import_index: u32) usize {
    var size: usize = 0;
    val ord:  u32   = dylib_ordinal_for(dyn, import_index);
    if (dyn.imports[import_index].lib_index == target_of.DYNLIB_ANY) { size = 1; }
    or (ord <= 15)                                                   { size = 1; }
    or                                                               { size = 1 + leb128.unsigned_size(ord::u64); }
    val name: str   = bin.resolve_name(itn, dyn.imports[import_index].symbol);
    var nl:   usize = 0;
    if (name != nil) { nl = str_len(name); }
    ret size + 1 + nl + 1 + 1;
}

fun write_bind_prefix(buf: *u8, off: usize, itn: *intern.Interner,
    dyn: *target_of.DynamicInfo, import_index: u32) usize {
    var p: usize = off;
    if (dyn.imports[import_index].lib_index == target_of.DYNLIB_ANY) {
        buf[p] = macho_format.BIND_OPCODE_SET_DYLIB_SPECIAL_IMM | macho_format.BIND_SPECIAL_DYLIB_FLAT_LOOKUP;
        p      = p + 1;
    }
    or {
        val ord: u32 = dylib_ordinal_for(dyn, import_index);
        if (ord <= 15) {
            buf[p] = macho_format.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | (ord::u8 & 0xF);
            p      = p + 1;
        }
        or {
            buf[p] = macho_format.BIND_OPCODE_SET_DYLIB_ORDINAL_ULEB;
            p      = p + 1 + leb128.put_unsigned(?buf[p + 1], ord::u64);
        }
    }

    buf[p] = macho_format.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM;
    p      = p + 1 + bin.write_str(buf, p + 1, bin.resolve_name(itn, dyn.imports[import_index].symbol));

    buf[p] = macho_format.BIND_OPCODE_SET_TYPE_IMM | macho_format.BIND_TYPE_POINTER;
    ret p + 1;
}

pub fun measure_bind_info(itn: *intern.Interner, dyn: *target_of.DynamicInfo,
    segs: *target_of.LoadSegment, text_va: u64, pz: u32, got_seg_offset: u64) usize {
    var size: usize = 0;
    var n:    u32   = 0;
    var f:    u32   = 0;
    for (f < dyn.import_addr_fixup_count) {
        val fx: *target_of.ImportFixup = ?dyn.import_addr_fixups[f];
        if (fx.kind == target_of.RK_ABS64) {
            size = size + measure_bind_prefix(itn, dyn, fx.import_index);
            if (fx.addend != 0) { size = size + 1 + leb128.signed_size(fx.addend); }
            var bseg: u32 = 0;
            var boff: u64 = 0;
            seg_offset_loc(dyn, fx.seg_index, fx.seg_offset, segs, text_va, pz, ?bseg, ?boff);
            size = size + 1 + leb128.unsigned_size(boff);
            size = size + 1;
            n    = n + 1;
        }
        f = f + 1;
    }
    var i: u32 = 0;
    var g: u32 = 0;
    for (i < dyn.import_count) {
        if (import_needs_got(dyn, i)) {
            size = size + measure_bind_prefix(itn, dyn, i);
            size = size + 1 + leb128.unsigned_size(got_seg_offset + g::u64 * 8);
            size = size + 1;
            g    = g + 1;
            n    = n + 1;
        }
        i = i + 1;
    }
    if (n > 0) { size = size + 1; }
    ret size;
}

pub fun write_bind_info(buf: *u8, off: usize, itn: *intern.Interner, dyn: *target_of.DynamicInfo,
    segs: *target_of.LoadSegment, text_va: u64, pz: u32, got_seg_index: u32, got_seg_offset: u64) usize {
    var p: usize = off;
    var n: u32   = 0;
    var f: u32   = 0;
    for (f < dyn.import_addr_fixup_count) {
        val fx: *target_of.ImportFixup = ?dyn.import_addr_fixups[f];
        if (fx.kind == target_of.RK_ABS64) {
            p = write_bind_prefix(buf, p, itn, dyn, fx.import_index);
            if (fx.addend != 0) {
                buf[p] = macho_format.BIND_OPCODE_SET_ADDEND_SLIB_ULEB;
                p      = p + 1 + leb128.put_signed(?buf[p + 1], fx.addend);
            }
            var bseg: u32 = 0;
            var boff: u64 = 0;
            seg_offset_loc(dyn, fx.seg_index, fx.seg_offset, segs, text_va, pz, ?bseg, ?boff);
            buf[p] = macho_format.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | (bseg::u8 & 0xF);
            p      = p + 1 + leb128.put_unsigned(?buf[p + 1], boff);
            buf[p] = macho_format.BIND_OPCODE_DO_BIND;
            p      = p + 1;
            n      = n + 1;
        }
        f = f + 1;
    }
    var i: u32 = 0;
    var g: u32 = 0;
    for (i < dyn.import_count) {
        if (import_needs_got(dyn, i)) {
            p = write_bind_prefix(buf, p, itn, dyn, i);

            buf[p] = macho_format.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | (got_seg_index::u8 & 0xF);
            p      = p + 1 + leb128.put_unsigned(?buf[p + 1], got_seg_offset + g::u64 * 8);

            buf[p] = macho_format.BIND_OPCODE_DO_BIND;
            p      = p + 1;

            g = g + 1;
            n = n + 1;
        }
        i = i + 1;
    }
    if (n > 0) {
        buf[p] = macho_format.BIND_OPCODE_DONE;
        p      = p + 1;
    }
    ret p;
}

pub fun base_reloc_cmp(a: *target_of.BaseReloc, b: *target_of.BaseReloc) i64 {
    if (a.seg_index != b.seg_index) {
        if (a.seg_index < b.seg_index) { ret -1; }
        ret 1;
    }
    if (a.seg_offset < b.seg_offset) { ret -1; }
    if (a.seg_offset > b.seg_offset) { ret 1; }
    ret 0;
}

fun base_reloc_loc(dyn: *target_of.DynamicInfo, br: *target_of.BaseReloc, segs: *target_of.LoadSegment, text_va: u64, pz: u32,
    out_seg: *u32, out_off: *u64) {
    seg_offset_loc(dyn, br.seg_index, br.seg_offset, segs, text_va, pz, out_seg, out_off);
}

pub fun seg_offset_loc(dyn: *target_of.DynamicInfo, ls: u32, seg_offset: u32,
    segs: *target_of.LoadSegment, text_va: u64, pz: u32,
    out_seg: *u32, out_off: *u64) {
    val first: u32 = segment.seg_group_first(dyn, segs, ls);
    @out_seg = pz + segment.seg_group_of(dyn, segs, ls);
    var seg_vmaddr: u64 = segs[first].vaddr;
    if (first == 0) { seg_vmaddr = text_va; }
    @out_off = (segs[ls].vaddr + seg_offset::u64) - seg_vmaddr;
}

pub fun measure_rebase_info(dyn: *target_of.DynamicInfo, segs: *target_of.LoadSegment, text_va: u64, pz: u32) usize {
    if (dyn.base_reloc_count == 0) { ret 0; }
    var size: usize = 1;
    var i:    u32   = 0;
    for (i < dyn.base_reloc_count) {
        var seg: u32 = 0;
        var off: u64 = 0;
        base_reloc_loc(dyn, ?dyn.base_relocs[i], segs, text_va, pz, ?seg, ?off);
        size = size + 1 + leb128.unsigned_size(off) + 1;
        i    = i + 1;
    }
    size = size + 1;
    ret size;
}

pub fun write_rebase_info(buf: *u8, off: usize, dyn: *target_of.DynamicInfo, segs: *target_of.LoadSegment,
    text_va: u64, pz: u32) usize {
    if (dyn.base_reloc_count == 0) { ret off; }
    var p: usize = off;
    buf[p] = macho_format.REBASE_OPCODE_SET_TYPE_IMM | macho_format.REBASE_TYPE_POINTER;
    p      = p + 1;
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        var seg:  u32 = 0;
        var slot: u64 = 0;
        base_reloc_loc(dyn, ?dyn.base_relocs[i], segs, text_va, pz, ?seg, ?slot);
        buf[p] = macho_format.REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | (seg::u8 & 0xF);
        p      = p + 1 + leb128.put_unsigned(?buf[p + 1], slot);
        buf[p] = macho_format.REBASE_OPCODE_DO_REBASE_IMM_TIMES | 1;
        p      = p + 1;
        i      = i + 1;
    }
    buf[p] = macho_format.REBASE_OPCODE_DONE;
    p      = p + 1;
    ret p;
}

pub fun patch_macho_fixups(buf: *u8, arch_id: u32, lay: *MachoDynLayout, dyn: *target_of.DynamicInfo,
    fixups: *target_of.ImportFixup, fixup_count: u32, seg_offsets: *usize,
    segs: *target_of.LoadSegment, seg_count: u32, nimp: u32) err[fail.Fail] {
    if (nimp == 0) { ret err[fail.Fail].ok{}; }
    val stub_sz: usize = stub_size(arch_id);
    var i:       u32   = 0;
    for (i < fixup_count) {
        val fx: *target_of.ImportFixup = ?fixups[i];
        if (fx.seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup references an out-of-range segment")};
        }
        val n: u32 = target_of.func_ordinal(dyn, fx.import_index);
        if (n == 0xFFFFFFFF) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup targets a non-function import")};
        }
        if (fx.seg_offset::usize + 4 > segs[fx.seg_index].filesz) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup offset out of range")};
        }

        val stub_va:  u64   = lay.stubs_va + n::u64 * stub_sz::u64;
        val disp:     i64   = (stub_va::i64) + fx.addend - (fx.patch_vaddr::i64);
        val file_off: usize = seg_offsets[fx.seg_index] + fx.seg_offset::usize;

        val stubs: *StubRow = stubs_for(arch_id);
        if (target_of.is_pcrel_address_kind(fx.kind)) {
            # one part of a function import's address, bound to its stub
            var patched: res[bool, of_reloc.RelocError] = res[bool, of_reloc.RelocError].err{of_reloc.UNSUPPORTED};
            if (stubs.bind_address != nil) {
                patched = stubs.bind_address(fx.kind, (buf::usize + file_off)::*u8, 0, 4,
                    of_reloc.target(stub_va, 0, 0), fx.addend, fx.patch_vaddr, 0);
            }
            if (sel patched.err) {
                ret err[fail.Fail].err{fail.message("a function import's address cannot be bound to its stub")};
            }
        }
        or {
            val bound: err[fail.Fail] = stubs.bind_call(buf, file_off, disp);
            if (sel bound.err) { ret bound; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pcrel_disp(target_va: u64, addend: i64,
    patch_va: u64) res[i64, fail.Fail] {
    val i64_max: i64 = 9223372036854775807;
    val i64_min: i64 = -9223372036854775807 - 1;
    if (target_va > i64_max::u64 || patch_va > i64_max::u64) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "pc-relative address exceeds the signed range")};
    }
    val delta: i64 = target_va::i64 - patch_va::i64;
    if ((addend > 0 && delta > i64_max - addend)
        || (addend < 0 && delta < i64_min - addend)) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "pc-relative signed arithmetic overflow")};
    }
    ret res[i64, fail.Fail].ok{delta + addend};
}

pub fun patch_macho_import_addr_fixups(buf: *u8, lay: *MachoDynLayout,
    dyn: *target_of.DynamicInfo, seg_offsets: *usize,
    segs: *target_of.LoadSegment,
    seg_count: u32) err[fail.Fail] {
    if (dyn.import_addr_fixup_count == 0) { ret err[fail.Fail].ok{}; }
    if (buf == nil || seg_offsets == nil || segs == nil) {
        ret err[fail.Fail].err{fail.message("import-address fixup is missing output layout data")};
    }
    if (dyn.import_addr_fixups == nil) {
        ret err[fail.Fail].err{fail.message("nil import-address fixup array")};
    }
    if (dyn.import_count > 0 && dyn.imports == nil) {
        ret err[fail.Fail].err{fail.message("nil dynamic import array")};
    }
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        val fx: *target_of.ImportFixup = ?dyn.import_addr_fixups[i];
        if (fx.kind == target_of.RK_ABS64) {
            i = i + 1;
            cnt;
        }
        if (fx.import_index >= dyn.import_count) {
            ret err[fail.Fail].err{fail.message("import-address fixup targets an out-of-range import")};
        }
        if (fx.seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("import-address fixup references an out-of-range segment")};
        }
        var width:     usize = 4;
        val arm64_got: bool  = fx.kind == target_of.RK_GOT_PAGE21 || fx.kind == target_of.RK_GOT_LO12;
        if (fx.kind == target_of.RK_GOTPCREL64_NORELAX) { width = 8; }
        or (!arm64_got && fx.kind != target_of.RK_GOTPCREL && fx.kind != target_of.RK_GOTPCREL_NORELAX) {
            ret err[fail.Fail].err{target_of.reloc_refusal(fx.origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, "unsupported import-address relocation kind")};
        }
        if (fx.seg_offset::usize + width > segs[fx.seg_index].filesz) {
            ret err[fail.Fail].err{fail.message("import-address fixup offset out of range")};
        }
        val slot_n: u32 = got_ordinal(dyn, fx.import_index);
        if (slot_n == 0xFFFFFFFF || slot_n::usize * 8 + 8 > lay.got_size) {
            ret err[fail.Fail].err{fail.message("import-address fixup has no GOT slot")};
        }
        val slot_va: u64 = lay.got_va + slot_n::u64 * 8;
        if (arm64_got) {
            # the ADRP/LDR pair addresses the slot itself, so the addend the
            # object refused to carry is not applied here either
            val file_off: usize                          = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
            val patched:  res[bool, of_reloc.RelocError] = isa_arm64_reloc.apply_reloc(fx.kind, (buf::usize + file_off)::*u8, 0, 4,
                of_reloc.target(slot_va, 0, 0), 0, fx.patch_vaddr, 0);
            if (sel patched.err) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "arm64 import-address GOT relocation failed")};
            }
            i = i + 1;
            cnt;
        }
        val dr: res[i64, fail.Fail] =
            pcrel_disp(slot_va, fx.addend, fx.patch_vaddr);
        if (sel dr.err) {
            ret err[fail.Fail].err{dr.err};
        }
        val disp:     i64   = dr.ok;
        val file_off: usize = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
        if (width == 4) {
            if (disp > 2147483647 || disp < -2147483648) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "import-address displacement overflows 32 bits")};
            }
            bin.write_u32_le(buf, file_off, (disp::u64)::u32);
        }
        or {
            bin.write_u64_le(buf, file_off, disp::u64);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun got_ordinal(dyn: *target_of.DynamicInfo, import_index: u32) u32 {
    if (import_index >= dyn.import_count || !import_needs_got(dyn, import_index)) {
        ret 0xFFFFFFFF;
    }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < import_index) {
        if (import_needs_got(dyn, i)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

test patch_macho_import_addr_fixups__validates_the_instruction {
    var buf:         [16]u8;
    var seg_offsets: [1]usize;
    seg_offsets[0] = 0;
    var segs: [1]target_of.LoadSegment;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;

    var imports: [1]target_of.DynImport;
    imports[0].is_func = false;
    imports[0].got_ref = true;
    var fixups: [1]target_of.ImportFixup;
    fixups[0].seg_index    = 0;
    fixups[0].seg_offset   = 0;
    fixups[0].import_index = 0;
    fixups[0].patch_vaddr  = 0x1000;
    fixups[0].kind         = target_of.RK_GOTPCREL;
    fixups[0].addend       = -4;

    var dyn: target_of.DynamicInfo;
    dyn.imports                 = ?imports[0];
    dyn.import_count            = 1;
    dyn.import_addr_fixups      = ?fixups[0];
    dyn.import_addr_fixup_count = 1;
    var lay: MachoDynLayout;
    lay.got_va   = 0x2000;
    lay.got_size = 8;

    val good: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel good.err)                     { ret 1; }
    if (bin.read_u32_le(?buf[0], 0) == 0) { ret 1; }

    dyn.import_addr_fixups = nil;
    val nil_fixups: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel nil_fixups.ok)                                                  { ret 1; }
    if (!str_contains(fail.describe(nil_fixups.err), "nil import-address")) { ret 1; }
    dyn.import_addr_fixups = ?fixups[0];

    dyn.imports = nil;
    val nil_imports: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel nil_imports.ok)                                                  { ret 1; }
    if (!str_contains(fail.describe(nil_imports.err), "nil dynamic import")) { ret 1; }
    dyn.imports = ?imports[0];

    val nil_layout: err[fail.Fail] = patch_macho_import_addr_fixups(
        nil::*u8, ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel nil_layout.ok)                                                     { ret 1; }
    if (!str_contains(fail.describe(nil_layout.err), "missing output layout")) { ret 1; }

    fixups[0].import_index = 1;
    val bad_import: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_import.ok)                                                   { ret 1; }
    if (!str_contains(fail.describe(bad_import.err), "out-of-range import")) { ret 1; }
    fixups[0].import_index = 0;

    fixups[0].seg_index = 1;
    val bad_segment: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_segment.ok)                                                    { ret 1; }
    if (!str_contains(fail.describe(bad_segment.err), "out-of-range segment")) { ret 1; }
    fixups[0].seg_index = 0;

    fixups[0].kind = target_of.RK_PC32;
    val bad_kind: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_kind.ok)                                                          { ret 1; }
    if (!str_contains(fail.describe(bad_kind.err), "unsupported import-address")) { ret 1; }
    fixups[0].kind = target_of.RK_GOTPCREL;

    fixups[0].seg_offset = 14;
    val bad_offset: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_offset.ok)                                                   { ret 1; }
    if (!str_contains(fail.describe(bad_offset.err), "offset out of range")) { ret 1; }
    fixups[0].seg_offset = 0;

    lay.got_size = 0;
    val no_slot: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel no_slot.ok)                                               { ret 1; }
    if (!str_contains(fail.describe(no_slot.err), "has no GOT slot")) { ret 1; }
    lay.got_size = 8;

    lay.got_va            = 0x100000000;
    fixups[0].patch_vaddr = 0;
    fixups[0].addend      = 0;
    val rel32_overflow: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel rel32_overflow.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(rel32_overflow.err), "overflows 32 bits")) { ret 1; }

    lay.got_va = 0x8000000000000000;
    val signed_overflow: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel signed_overflow.ok)                                            { ret 1; }
    if (!str_contains(fail.describe(signed_overflow.err), "signed range")) { ret 1; }

    lay.got_va            = 0x2000;
    fixups[0].patch_vaddr = 0x1000;
    fixups[0].kind        = target_of.RK_GOTPCREL64_NORELAX;
    fixups[0].addend      = -8;
    val good64: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel good64.err)                   { ret 1; }
    if (bin.read_u64_le(?buf[0], 0) == 0) { ret 1; }

    # the arm64 pair lands on the slot: ADRP to its page, LDR with its low bits
    lay.got_va            = 0x3AB8;
    fixups[0].patch_vaddr = 0x1000;
    fixups[0].kind        = target_of.RK_GOT_PAGE21;
    fixups[0].addend      = 0;
    bin.write_u32_le(?buf[0], 0, 0x90000008);
    val page: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel page.err)                              { ret 1; }
    if (bin.read_u32_le(?buf[0], 0) != 0xD0000008) { ret 1; }
    fixups[0].kind = target_of.RK_GOT_LO12;
    bin.write_u32_le(?buf[0], 0, 0xF9400108);
    val lo: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel lo.err)                                { ret 1; }
    if (bin.read_u32_le(?buf[0], 0) != 0xF9455D08) { ret 1; }
    bin.write_u32_le(?buf[0], 0, 0x39400108);
    val not_ldr: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel not_ldr.ok)                                                        { ret 1; }
    if (!str_contains(fail.describe(not_ldr.err), "arm64 import-address GOT")) { ret 1; }
    ret 0;
}

test write_bind_info__abs64_in_place_bind {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val ln: res[intern.StrId, A.Error] = intern.add(?itn, "/usr/lib/libobjc.A.dylib");
    val sn: res[intern.StrId, A.Error] = intern.add(?itn, "__objc_empty_cache");
    val cn: res[intern.StrId, A.Error] = intern.add(?itn, "_objc_msgSend");
    if (sel ln.err) { ret 1; }
    if (sel sn.err) { ret 1; }
    if (sel cn.err) { ret 1; }

    var libs: [1]target_of.DynLib;
    libs[0].name   = ln.ok;
    libs[0].soname = libs[0].name;
    libs[0].rpath  = intern.STR_NIL;

    var imports: [2]target_of.DynImport;
    imports[0].symbol     = sn.ok;
    imports[0].lib_index  = 0;
    imports[0].is_func    = false;
    imports[0].ordinal    = 0;
    imports[0].by_ordinal = false;
    imports[0].got_ref    = false;
    imports[1].symbol     = cn.ok;
    imports[1].lib_index  = 0;
    imports[1].is_func    = true;
    imports[1].ordinal    = 0;
    imports[1].by_ordinal = false;
    imports[1].got_ref    = false;

    var fixups: [2]target_of.ImportFixup;
    fixups[0].seg_index    = 2;
    fixups[0].seg_offset   = 0x28;
    fixups[0].import_index = 0;
    fixups[0].patch_vaddr  = 0;
    fixups[0].kind         = target_of.RK_ABS64;
    fixups[0].addend       = 0;
    fixups[1].seg_index    = 2;
    fixups[1].seg_offset   = 0x38;
    fixups[1].import_index = 0;
    fixups[1].patch_vaddr  = 0;
    fixups[1].kind         = target_of.RK_ABS64;
    fixups[1].addend       = -8;

    var segs: [3]target_of.LoadSegment;
    segs[0].vaddr  = 0x1000;
    segs[0].filesz = 0;
    segs[0].memsz  = 0;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = nil;
    segs[1].vaddr  = 0x2000;
    segs[1].filesz = 0;
    segs[1].memsz  = 0;
    segs[1].flags  = target_of.SEG_FLAG_READ;
    segs[1].bytes  = nil;
    segs[2].vaddr  = 0x3000;
    segs[2].filesz = 0;
    segs[2].memsz  = 0;
    segs[2].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_WRITE;
    segs[2].bytes  = nil;

    var dyn: target_of.DynamicInfo;
    dyn.libs                    = ?libs[0];
    dyn.lib_count               = 1;
    dyn.imports                 = ?imports[0];
    dyn.import_count            = 2;
    dyn.interp                  = intern.STR_NIL;
    dyn.base_relocs             = nil::*target_of.BaseReloc;
    dyn.base_reloc_count        = 0;
    dyn.pie                     = true;
    dyn.import_addr_fixups      = ?fixups[0];
    dyn.import_addr_fixup_count = 2;

    val want: usize = measure_bind_info(?itn, ?dyn, ?segs[0], 0x1000, 1, 0x10);
    var buf:  [128]u8;
    var k:    usize = 0;
    for (k < 128) {
        buf[k] = 0xEE;
        k      = k + 1;
    }
    val end: usize = write_bind_info(?buf[0], 0, ?itn, ?dyn, ?segs[0], 0x1000, 1, 4, 0x10);
    if (end != want) { ret 1; }

    var p: usize = 0;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_TYPE_IMM | macho_format.BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 3)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x28) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != (macho_format.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_TYPE_IMM | macho_format.BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_SET_ADDEND_SLIB_ULEB) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x78) { ret 1; }
    p = p + 1;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 3)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x38) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != (macho_format.BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1)) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM) { ret 1; }
    p = p + 1;
    for (buf[p] != 0) { p = p + 1; }
    p = p + 1;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_TYPE_IMM | macho_format.BIND_TYPE_POINTER)) { ret 1; }
    p = p + 1;
    if (buf[p] != (macho_format.BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 4)) { ret 1; }
    p = p + 1;
    if (buf[p] != 0x10) { ret 1; }
    p = p + 1;
    if (buf[p] != macho_format.BIND_OPCODE_DO_BIND) { ret 1; }
    p = p + 1;

    if (buf[p] != macho_format.BIND_OPCODE_DONE) { ret 1; }
    p = p + 1;
    if (p != end) { ret 1; }
    ret 0;
}
