use mach.lang.fail;
use mach.lang.target.of.bin;
use mach.lang.target.of.buildid;
use mach.lang.target.of.macho.format;
use std.crypto.hash.sha256;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

pub fun codesign_ident_len(name: *u8) usize {
    if (name == nil) { ret 0; }
    ret str_len(name::str);
}

fun codesign_code_slots(code_limit: usize) usize {
    ret (code_limit + format.CODE_SIG_PAGE_SIZE - 1) / format.CODE_SIG_PAGE_SIZE;
}

fun codedir_blob_size(ident_len: usize, code_limit: usize) usize {
    ret format.CODEDIR_HEADER_SIZE + ident_len + 1 + codesign_code_slots(code_limit) * format.CS_HASH_SIZE_SHA256::usize;
}

pub fun code_signature_size(ident_len: usize, code_limit: usize) usize {
    ret format.SUPERBLOB_HEADER_SIZE + codedir_blob_size(ident_len, code_limit);
}

pub fun write_code_signature(buf: *u8, sig_off: usize, name: *u8, code_limit: usize,
    exec_base: u64, exec_limit: u64) usize {
    val ident_len: usize = codesign_ident_len(name);
    val n_slots:   usize = codesign_code_slots(code_limit);
    val cd_size:   usize = codedir_blob_size(ident_len, code_limit);
    val sig_size:  usize = format.SUPERBLOB_HEADER_SIZE + cd_size;

    bin.write_u32_be(buf, sig_off, format.CSMAGIC_EMBEDDED_SIGNATURE);
    bin.write_u32_be(buf, sig_off + 4, sig_size::u32);
    bin.write_u32_be(buf, sig_off + 8, 1);
    bin.write_u32_be(buf, sig_off + 12, format.CSSLOT_CODEDIRECTORY);
    bin.write_u32_be(buf, sig_off + 16, format.SUPERBLOB_HEADER_SIZE::u32);

    val cd:        usize = sig_off + format.SUPERBLOB_HEADER_SIZE;
    val ident_off: usize = format.CODEDIR_HEADER_SIZE;
    val hash_off:  usize = format.CODEDIR_HEADER_SIZE + ident_len + 1;

    bin.write_u32_be(buf, cd, format.CSMAGIC_CODEDIRECTORY);
    bin.write_u32_be(buf, cd + 4, cd_size::u32);
    bin.write_u32_be(buf, cd + 8, format.CS_CODEDIRECTORY_VERSION);
    bin.write_u32_be(buf, cd + 12, format.CS_ADHOC_FLAG | format.CS_LINKER_SIGNED_FLAG);
    bin.write_u32_be(buf, cd + 16, hash_off::u32);
    bin.write_u32_be(buf, cd + 20, ident_off::u32);
    bin.write_u32_be(buf, cd + 24, 0);
    bin.write_u32_be(buf, cd + 28, n_slots::u32);
    bin.write_u32_be(buf, cd + 32, code_limit::u32);
    buf[cd + 36] = format.CS_HASH_SIZE_SHA256;
    buf[cd + 37] = format.CS_HASHTYPE_SHA256;
    buf[cd + 38] = 0;
    buf[cd + 39] = format.CS_PAGE_SHIFT;
    bin.write_u32_be(buf, cd + 40, 0);
    bin.write_u32_be(buf, cd + 44, 0);
    bin.write_u32_be(buf, cd + 48, 0);
    bin.write_u32_be(buf, cd + 52, 0);
    bin.write_u64_be(buf, cd + 56, 0);
    bin.write_u64_be(buf, cd + 64, exec_base);
    bin.write_u64_be(buf, cd + 72, exec_limit);
    bin.write_u64_be(buf, cd + 80, format.CS_EXECSEG_MAIN_BINARY);

    var k: usize = 0;
    for (k < ident_len) {
        buf[cd + ident_off + k] = name[k];
        k                       = k + 1;
    }
    buf[cd + ident_off + ident_len] = 0;

    var slot: usize = 0;
    for (slot < n_slots) {
        val page_off: usize = slot * format.CODE_SIG_PAGE_SIZE;
        var page_len: usize = format.CODE_SIG_PAGE_SIZE;
        if (page_off + page_len > code_limit) { page_len = code_limit - page_off; }
        sha256.hash(?buf[page_off], page_len, ?buf[cd + hash_off + slot * format.CS_HASH_SIZE_SHA256::usize]);
        slot = slot + 1;
    }
    ret sig_size;
}

# the build id is the sha-256 of everything the code signature covers (header,
# load commands, segments, __DWARF and the __LINKEDIT structures before the
# signature) with the uuid bytes as zero; the signature written afterwards
# then covers the final uuid, in ld64's order
pub fun seal_build_id(buf: *u8, code_limit: usize, uuid_off: usize) err[fail.Fail] {
    if (uuid_off + buildid.UUID_LEN > code_limit) { ret err[fail.Fail].err{fail.message("macho: LC_UUID lies outside the signed range")}; }
    var k: usize = 0;
    for (k < buildid.UUID_LEN) {
        if (buf[uuid_off + k] != 0) { ret err[fail.Fail].err{fail.message("macho: LC_UUID was written before the image was sealed")}; }
        k = k + 1;
    }
    var digest: [32]u8;
    sha256.hash(buf, code_limit, ?digest[0]);
    buildid.uuid_from_digest(?digest[0], (buf::usize + uuid_off)::*u8);
    ret err[fail.Fail].ok{};
}
