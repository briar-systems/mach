test "mach.lang.target.of.macho.emit_object:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [17]u8;
    var k:          usize = 0;
    for (k < 17) {
        text_bytes[k] = 0x90;
        k             = k + 1;
    }
    var data_bytes: [3]u8;
    data_bytes[0] = 1;
    data_bytes[1] = 2;
    data_bytes[2] = 3;

    var secs: [3]of.Section;
    secs[0].name  = t_intern(?i, "__text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 17;
    secs[0].align = 16;
    secs[1].name  = t_intern(?i, "__data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 3;
    secs[1].align = 8;
    secs[2].name  = t_intern(?i, "__bss");
    secs[2].kind  = of.SK_BSS;
    secs[2].bytes = nil;
    secs[2].len   = 64;
    secs[2].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 17;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = t_intern(?i, "_gvar");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 3;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 1;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = -4;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 3;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val rb: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_size");
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val ncmds: u32   = bin.read_u32_le(buf.data, 16);
    var lc:    usize = MACH_HEADER_64_SIZE;
    var found: bool  = false;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:  u32   = bin.read_u32_le(buf.data, lc);
        val size: usize = bin.read_u32_le(buf.data, lc + 4)::usize;
        if (size == 0) { ret 4; }
        if (cmd == LC_SYMTAB) {
            val stroff:  usize = bin.read_u32_le(buf.data, lc + 16)::usize;
            val strsize: usize = bin.read_u32_le(buf.data, lc + 20)::usize;
            if (stroff + strsize != buf.len) { ret 5; }
            found = true;
        }
        lc = lc + size;
        c  = c + 1;
    }
    if (!found) { ret 6; }
    ret 0;
}

fun ts_x64_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64)              { ret 1; }
    if (bin.read_u32_le(buf.data, 4) != CPU_TYPE_X86_64)          { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_OBJECT)               { ret 1; }
    if (bin.read_u32_le(buf.data, 16) != 3)                       { ret 1; }
    if (bin.read_u32_le(buf.data, MACH_HEADER_64_SIZE + 64) != 2) { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 2)                                          { ret 1; }
    if (out.symbol_count != 3)                                           { ret 1; }
    if (out.reloc_count != 3)                                            { ret 1; }
    if (out.sections[0].kind != of.SK_TEXT || out.sections[0].len != 24) { ret 1; }
    if (out.sections[1].kind != of.SK_DATA || out.sections[1].len != 8)  { ret 1; }
    if (out.sections[0].align != 16 || out.sections[1].align != 8)       { ret 1; }
    if (out.sections[0].bytes == nil)                                    { ret 1; }
    if (out.sections[0].bytes[0] != 0xE8)                                { ret 1; }

    val sym_main: intern.StrId = t_intern(?i, "_main");
    val sym_g:    intern.StrId = t_intern(?i, "g");
    val sym_ext:  intern.StrId = t_intern(?i, "ext_func");

    var saw_main: bool = false;
    var saw_ext:  bool = false;
    var si:       u32  = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == sym_main) {
            saw_main = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
            if (of.section_index(out.symbols[si].section) != 0)          { ret 1; }
        }
        if (out.symbols[si].name == sym_ext) {
            saw_ext = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) == 0) { ret 1; }
            if (!of.section_is_external(out.symbols[si].section))      { ret 1; }
        }
        si = si + 1;
    }
    if (!saw_main || !saw_ext) { ret 1; }

    var ok_plt: bool = false;
    var ok_pc:  bool = false;
    var ok_abs: bool = false;
    var rj:     u32  = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.offset == 1 && rr.kind == of.RK_PLT32 && of.reloc_symbol_name(?out, rr) == sym_ext && rr.addend == -4) { ok_plt = true; }
        if (rr.offset == 8 && rr.kind == of.RK_PC32 && of.reloc_symbol_name(?out, rr) == sym_g && rr.addend == -4)    { ok_pc = true; }
        if (rr.offset == 16 && rr.kind == of.RK_ABS64 && of.reloc_symbol_name(?out, rr) == sym_g && rr.addend == 0)   { ok_abs = true; }
        rj = rj + 1;
    }
    if (!ok_plt || !ok_pc || !ok_abs) { ret 1; }
    ret 0;
}

fun ts_x64_got_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var data_bytes: [32]u8;
    text_bytes[0] = 0x48;
    text_bytes[1] = 0x8B;
    text_bytes[2] = 0x05;

    var secs: [2]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;
    secs[1].name  = t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 32;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = t_intern(?i, "_external");
    syms[1].section = of.external_section();
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [5]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 3;
    relocs[0].kind    = of.RK_GOTPCREL;
    relocs[0].sym     = 1;
    relocs[0].addend  = -4;
    relocs[1].section = of.section_id(1);
    relocs[1].offset  = 0;
    relocs[1].kind    = of.RK_GOTPCREL_NORELAX;
    relocs[1].sym     = 1;
    relocs[1].addend  = -4;
    relocs[2].section = of.section_id(1);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_GOTPCREL64_NORELAX;
    relocs[2].sym     = 1;
    relocs[2].addend  = -8;
    relocs[3].section = of.section_id(1);
    relocs[3].offset  = 16;
    relocs[3].kind    = of.RK_GOTPCREL64_NORELAX;
    relocs[3].sym     = 1;
    relocs[3].addend  = 9223372036854775807;
    relocs[4].section = of.section_id(1);
    relocs[4].offset  = 24;
    relocs[4].kind    = of.RK_GOTPCREL64_NORELAX;
    relocs[4].sym     = 1;
    relocs[4].addend  = -9223372036854775807 - 1;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "got");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 5;

    val rb: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_got");
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val text_sh:     usize = seg + SEGMENT_CMD_64_SIZE;
    val data_sh:     usize = text_sh + SECTION_64_SIZE;
    val load_e:      usize = t_find_reloc(buf.data, text_sh, 3);
    val got32_e:     usize = t_find_reloc(buf.data, data_sh, 0);
    val got64_e:     usize = t_find_reloc(buf.data, data_sh, 8);
    val got64_max_e: usize = t_find_reloc(buf.data, data_sh, 16);
    val got64_min_e: usize = t_find_reloc(buf.data, data_sh, 24);
    if (load_e == 0 || got32_e == 0 || got64_e == 0
        || got64_max_e == 0 || got64_min_e == 0) { ret 1; }
    val load_w:  u32 = bin.read_u32_le(buf.data, load_e + 4);
    val got32_w: u32 = bin.read_u32_le(buf.data, got32_e + 4);
    val got64_w: u32 = bin.read_u32_le(buf.data, got64_e + 4);
    if (((load_w >> 28) & 0xF) != X86_64_RELOC_GOT_LOAD || ((load_w >> 25) & 3) != 2) { ret 1; }
    if (((got32_w >> 28) & 0xF) != X86_64_RELOC_GOT || ((got32_w >> 25) & 3) != 2)    { ret 1; }
    if (((got64_w >> 28) & 0xF) != X86_64_RELOC_GOT || ((got64_w >> 25) & 3) != 3)    { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)           { ret 1; }
    if (out.reloc_count != 5) { ret 1; }
    if (t_reloc_at(?out, 0, 3).kind != of.RK_GOTPCREL
        || t_reloc_at(?out, 0, 3).addend != -4) { ret 1; }
    if (t_reloc_at(?out, 1, 0).kind != of.RK_GOTPCREL_NORELAX
        || t_reloc_at(?out, 1, 0).addend != -4) { ret 1; }
    if (t_reloc_at(?out, 1, 8).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 8).addend != -8) { ret 1; }
    if (t_reloc_at(?out, 1, 16).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 16).addend != 9223372036854775807) { ret 1; }
    if (t_reloc_at(?out, 1, 24).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 24).addend != -9223372036854775807 - 1) { ret 1; }

    bin.write_u32_le(buf.data, load_e + 4, load_w & 0xFEFFFFFF);
    var bad_pc: of.ObjectImage;
    val pp:     err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_pc);
    if (sel pp.ok)                                               { ret 1; }
    if (!str_contains(fail.describe(pp.err), "not pc-relative")) { ret 1; }
    bin.write_u32_le(buf.data, load_e + 4, load_w);

    val text_off: usize = bin.read_u32_le(buf.data, text_sh + 48)::usize;
    buf.data[text_off + 1] = 0x8D;
    var bad_insn: of.ObjectImage;
    val pi:       err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_insn);
    if (sel pi.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(pi.err), "RIP-relative MOVQ")) { ret 1; }
    buf.data[text_off + 1] = 0x8B;

    bin.write_u32_le(buf.data, got32_e + 4, (got32_w & 0xF9FFFFFF) | (1 << 25));
    var bad_width: of.ObjectImage;
    val pw:        err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_width);
    if (sel pw.ok)                                                     { ret 1; }
    if (!str_contains(fail.describe(pw.err), "neither 4 nor 8 bytes")) { ret 1; }
    ret 0;
}

fun ts_x64_signed_variants() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var data_bytes: [8]u8;

    var secs: [2]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = -5;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_PC32;
    relocs[1].sym     = 1;
    relocs[1].addend  = -6;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_PC32;
    relocs[2].sym     = 1;
    relocs[2].addend  = -8;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "signed");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 3;

    val rb: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_signed");
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = t_find_lc(buf.data, LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0:      usize = seg + SEGMENT_CMD_64_SIZE;
    val text_off: usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    if (!t_set_reloc_type(buf.data, sh0, 0, X86_64_RELOC_SIGNED_1)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 4, X86_64_RELOC_SIGNED_2)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 8, X86_64_RELOC_SIGNED_4)) { ret 1; }
    if (bin.read_u32_le(buf.data, text_off) != 0xFFFFFFFF)          { ret 1; }
    if (bin.read_u32_le(buf.data, text_off + 4) != 0xFFFFFFFE)      { ret 1; }
    if (bin.read_u32_le(buf.data, text_off + 8) != 0xFFFFFFFC)      { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }
    val r1: *of.Relocation = t_reloc_at(?out, 0, 0);
    val r2: *of.Relocation = t_reloc_at(?out, 0, 4);
    val r4: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (r1 == nil || r2 == nil || r4 == nil)      { ret 1; }
    if (r1.kind != of.RK_PC32 || r1.addend != -5) { ret 1; }
    if (r2.kind != of.RK_PC32 || r2.addend != -6) { ret 1; }
    if (r4.kind != of.RK_PC32 || r4.addend != -8) { ret 1; }

    val rb2: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?out, "macho_signed_rt");
    if (sel rb2.err) { ret 1; }
    val buf2: Vector[u8] = rb2.ok;
    val seg2: usize      = t_find_lc(buf2.data, LC_SEGMENT_64);
    if (seg2 == 0) { ret 1; }
    val sh2: usize = seg2 + SEGMENT_CMD_64_SIZE;
    val e1:  usize = t_find_reloc(buf2.data, sh2, 0);
    val e2:  usize = t_find_reloc(buf2.data, sh2, 4);
    val e4:  usize = t_find_reloc(buf2.data, sh2, 8);
    if (e1 == 0 || e2 == 0 || e4 == 0)                                             { ret 1; }
    if (((bin.read_u32_le(buf2.data, e1 + 4) >> 28) & 0xF) != X86_64_RELOC_SIGNED) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e2 + 4) >> 28) & 0xF) != X86_64_RELOC_SIGNED) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e4 + 4) >> 28) & 0xF) != X86_64_RELOC_SIGNED) { ret 1; }
    var out2: of.ObjectImage;
    val pr2:  err[fail.Fail] = parse_object(?alloc, ?i, buf2.data, buf2.len, ?out2);
    if (sel pr2.err) { ret 1; }
    if (t_reloc_at(?out2, 0, 0).addend != -5 || t_reloc_at(?out2, 0, 4).addend != -6
        || t_reloc_at(?out2, 0, 8).addend != -8) { ret 1; }

    val original_word: u32 = bin.read_u32_le(buf.data, t_find_reloc(buf.data, sh0, 8) + 4);
    bin.write_u32_le(buf.data, t_find_reloc(buf.data, sh0, 8), 14);
    var bad_bounds: of.ObjectImage;
    val pb:         err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_bounds);
    if (sel pb.ok)                                             { ret 1; }
    if (!str_contains(fail.describe(pb.err), "out of bounds")) { ret 1; }
    bin.write_u32_le(buf.data, t_find_reloc(buf.data, sh0, 14), 8);
    val e_bad: usize = t_find_reloc(buf.data, sh0, 8);
    bin.write_u32_le(buf.data, e_bad + 4, (original_word & 0xF9FFFFFF) | (1 << 25));
    var bad_width: of.ObjectImage;
    val pw:        err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_width);
    if (sel pw.ok)                                           { ret 1; }
    if (!str_contains(fail.describe(pw.err), "not 4 bytes")) { ret 1; }
    bin.write_u32_le(buf.data, e_bad + 4, original_word & 0xFEFFFFFF);
    var bad_pcrel: of.ObjectImage;
    val pp:        err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_pcrel);
    if (sel pp.ok)                                               { ret 1; }
    if (!str_contains(fail.describe(pp.err), "not pc-relative")) { ret 1; }
    ret 0;
}

fun ts_relro_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes:  [8]u8;
    var ro_bytes:    [8]u8;
    var relro_bytes: [8]u8;
    var k:           usize = 0;
    for (k < 8) {
        text_bytes[k]  = 0;
        ro_bytes[k]    = 0;
        relro_bytes[k] = 0;
        k              = k + 1;
    }

    var secs: [3]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;
    secs[1].name  = t_intern(?i, ".rodata");
    secs[1].kind  = of.SK_RODATA;
    secs[1].bytes = ?ro_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;
    secs[2].name  = t_intern(?i, ".data.rel.ro");
    secs[2].kind  = of.SK_RELRO;
    secs[2].bytes = ?relro_bytes[0];
    secs[2].len   = 8;
    secs[2].align = 8;

    var syms: [1]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(2);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = 0;
    relocs[0].addend  = 0x10;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 3;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val rb: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_relro");
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 3) { ret 1; }
    var saw_text:  bool = false;
    var saw_ro:    bool = false;
    var saw_relro: bool = false;
    var s:         u32  = 0;
    for (s < out.section_count) {
        if (out.sections[s].kind == of.SK_TEXT)   { saw_text = true; }
        if (out.sections[s].kind == of.SK_RODATA) { saw_ro = true; }
        if (out.sections[s].kind == of.SK_RELRO)  { saw_relro = true; }
        s = s + 1;
    }
    if (!saw_text || !saw_ro || !saw_relro) { ret 1; }

    if (out.reloc_count != 1)                                                        { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS64 || out.relocations[0].addend != 0x10) { ret 1; }
    ret 0;
}

fun ts_arm64_roundtrip() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var text_bytes: [16]u8;
    bin.write_u32_le(?text_bytes[0], 0, 0x90000000);
    bin.write_u32_le(?text_bytes[0], 4, 0x91000000);
    bin.write_u32_le(?text_bytes[0], 8, 0xF9400001);
    bin.write_u32_le(?text_bytes[0], 12, 0x94000000);
    var data_bytes: [8]u8;

    var secs: [2]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 4;
    secs[1].name  = t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name    = t_intern(?i, "ext_func");
    syms[2].section = of.external_section();
    syms[2].offset  = 0;
    syms[2].size    = 0;
    syms[2].flags   = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [5]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PAGE21;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_ADD_LO12;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_LDST64_LO12;
    relocs[2].sym     = 1;
    relocs[2].addend  = 0x10;
    relocs[3].section = of.section_id(0);
    relocs[3].offset  = 12;
    relocs[3].kind    = of.RK_PLT32;
    relocs[3].sym     = 2;
    relocs[3].addend  = 0;
    relocs[4].section = of.section_id(1);
    relocs[4].offset  = 0;
    relocs[4].kind    = of.RK_ABS64;
    relocs[4].sym     = 0;
    relocs[4].addend  = 0x20;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 3;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 5;

    val rb: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_a64");
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64)    { ret 1; }
    if (bin.read_u32_le(buf.data, 4) != CPU_TYPE_ARM64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_OBJECT)     { ret 1; }
    val text_sh: usize = MACH_HEADER_64_SIZE + SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, text_sh + 60) != 5) { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)             { ret 1; }
    if (out.section_count != 2) { ret 1; }
    if (out.reloc_count != 5)   { ret 1; }

    var ok_page: bool = false;
    var ok_add:  bool = false;
    var ok_ldst: bool = false;
    var ok_br:   bool = false;
    var ok_abs:  bool = false;
    var rj:      u32  = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (of.section_index(rr.section) == 0 && rr.offset == 0 && rr.kind == of.RK_PAGE21 && of.reloc_symbol_name(?out, rr) == syms[1].name)                           { ok_page = true; }
        if (of.section_index(rr.section) == 0 && rr.offset == 4 && rr.kind == of.RK_ADD_LO12 && of.reloc_symbol_name(?out, rr) == syms[1].name)                         { ok_add = true; }
        if (of.section_index(rr.section) == 0 && rr.offset == 8 && rr.kind == of.RK_LDST64_LO12 && of.reloc_symbol_name(?out, rr) == syms[1].name && rr.addend == 0x10) { ok_ldst = true; }
        if (of.section_index(rr.section) == 0 && rr.offset == 12 && rr.kind == of.RK_PLT32 && of.reloc_symbol_name(?out, rr) == syms[2].name)                           { ok_br = true; }
        if (of.section_index(rr.section) == 1 && rr.offset == 0 && rr.kind == of.RK_ABS64 && of.reloc_symbol_name(?out, rr) == syms[0].name && rr.addend == 0x20)       { ok_abs = true; }
        rj = rj + 1;
    }
    if (!ok_page || !ok_add || !ok_ldst || !ok_br || !ok_abs) { ret 1; }
    ret 0;
}

fun ts_generated_sections_coalesce_without_erasing_placement() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    val ndata:   u32 = 260;
    val total:   u32 = 1 + ndata;
    val tgt_sec: u32 = 255;

    val rsec: res[*of.Section, A.Error] = A.zallocate[of.Section](?alloc, total::usize);
    if (sel rsec.err) { ret 1; }
    var secs: *of.Section = rsec.ok;

    var text_bytes: [8]u8;
    text_bytes[0] = 0xE8;

    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;

    var data_bytes: [8]u8;

    var s: u32 = 1;
    for (s < total) {
        secs[s].name  = t_intern(?i, ".rodata");
        secs[s].kind  = of.SK_RODATA;
        secs[s].align = 8;
        secs[s].flags = of.SEC_FLAG_COALESCE;
        if (s == 1) {
            secs[s].flags = 0;
            secs[s].name  = t_intern(?i, ".explicit");
        }
        if (s == tgt_sec) {
            secs[s].bytes = ?data_bytes[0];
            secs[s].len   = 8;
        }
        or {
            secs[s].bytes = nil;
            secs[s].len   = 0;
        }
        s = s + 1;
    }

    var syms: [2]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = t_intern(?i, ".Lc.target");
    syms[1].section = of.section_id(tgt_sec);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 1;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = -4;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = secs;
    img.section_count = total;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val rb: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_many");
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 3 || out.sections[1].name != secs[1].name) { ret 1; }

    if (out.reloc_count != 1)                                            { ret 1; }
    if (of.reloc_symbol_name(?out, ?out.relocations[0]) != syms[1].name) { ret 1; }

    var found: bool = false;
    var si:    u32  = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[1].name) {
            found = true;
            if (of.section_is_external(out.symbols[si].section))                              { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) != 0)                        { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0)                        { ret 1; }
            if (of.section_index(out.symbols[si].section) >= out.section_count)               { ret 1; }
            if (out.sections[of.section_index(out.symbols[si].section)].kind != of.SK_RODATA) { ret 1; }
        }
        si = si + 1;
    }
    if (!found) { ret 1; }
    s = 0;
    for (s < total) {
        secs[s].flags = 0;
        s             = s + 1;
    }
    val explicit_refused: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "refuse1");
    if (sel explicit_refused.ok) { ret 2; }
    s = 0;
    for (s < total) {
        secs[s].native.format = of.OF_MACHO;
        write_fixed16(?secs[s].native.name[0], 0, "__native");
        s = s + 1;
    }
    val native_refused: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "refuse2");
    if (sel native_refused.ok) { ret 3; }
    ret 0;
}

fun ts_reloc_map() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x_abs: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_ABS64);
    if (sel x_abs.err)                            { ret 1; }
    if (x_abs.ok.r_type != X86_64_RELOC_UNSIGNED) { ret 1; }
    val x_plt: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_PLT32);
    if (sel x_plt.err)                          { ret 1; }
    if (x_plt.ok.r_type != X86_64_RELOC_BRANCH) { ret 1; }
    val x_got_load: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL);
    val x_got:      res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL_NORELAX);
    val x_got64:    res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL64_NORELAX);
    if (sel x_got_load.err)                            { ret 1; }
    if (x_got_load.ok.r_type != X86_64_RELOC_GOT_LOAD) { ret 1; }
    if (sel x_got.err)                                 { ret 1; }
    if (x_got.ok.r_type != X86_64_RELOC_GOT)           { ret 1; }
    if (x_got.ok.length != 2)                          { ret 1; }
    if (sel x_got64.err)                               { ret 1; }
    if (x_got64.ok.r_type != X86_64_RELOC_GOT)         { ret 1; }
    if (x_got64.ok.length != 3)                        { ret 1; }

    val a_page: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_PAGE21);
    if (sel a_page.err)                         { ret 1; }
    if (a_page.ok.r_type != ARM64_RELOC_PAGE21) { ret 1; }
    val a_ldst: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_LDST32_LO12);
    if (sel a_ldst.err)                            { ret 1; }
    if (a_ldst.ok.r_type != ARM64_RELOC_PAGEOFF12) { ret 1; }

    val a_bad: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_ADDR32NB);
    if (!sel a_bad.err)                                      { ret 1; }
    if (!str_contains(fail.describe(a_bad.err), "addr32nb")) { ret 1; }
    ret 0;
}

fun ts_pageoff12() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val add: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x91000000);
    if (sel add.err)              { ret 1; }
    if (add.ok != of.RK_ADD_LO12) { ret 1; }
    val b8: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x39400000);
    if (sel b8.err)                { ret 1; }
    if (b8.ok != of.RK_LDST8_LO12) { ret 1; }
    val h16: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x79400000);
    if (sel h16.err)                 { ret 1; }
    if (h16.ok != of.RK_LDST16_LO12) { ret 1; }
    val w32: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0xB9400000);
    if (sel w32.err)                 { ret 1; }
    if (w32.ok != of.RK_LDST32_LO12) { ret 1; }
    val x64: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0xF9400000);
    if (sel x64.err)                 { ret 1; }
    if (x64.ok != of.RK_LDST64_LO12) { ret 1; }
    val q128: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_PAGEOFF12, 2, 0x3DC00000);
    if (sel q128.err)                  { ret 1; }
    if (q128.ok != of.RK_LDST128_LO12) { ret 1; }
    ret 0;
}

fun ts_abs32() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x32: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_ABS32);
    if (sel x32.err)                            { ret 1; }
    if (x32.ok.r_type != X86_64_RELOC_UNSIGNED) { ret 1; }
    if (x32.ok.length != 2)                     { ret 1; }
    val a32: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_ABS32);
    if (sel a32.err)                           { ret 1; }
    if (a32.ok.r_type != ARM64_RELOC_UNSIGNED) { ret 1; }
    if (a32.ok.length != 2)                    { ret 1; }

    val xr2: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_X86_64, X86_64_RELOC_UNSIGNED, 2, 0);
    if (sel xr2.err)           { ret 1; }
    if (xr2.ok != of.RK_ABS32) { ret 1; }
    val xr3: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_X86_64, X86_64_RELOC_UNSIGNED, 3, 0);
    if (sel xr3.err)           { ret 1; }
    if (xr3.ok != of.RK_ABS64) { ret 1; }
    val ar2: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_UNSIGNED, 2, 0);
    if (sel ar2.err)           { ret 1; }
    if (ar2.ok != of.RK_ABS32) { ret 1; }
    val ar3: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, CPU_TYPE_ARM64, ARM64_RELOC_UNSIGNED, 3, 0);
    if (sel ar3.err)           { ret 1; }
    if (ar3.ok != of.RK_ABS64) { ret 1; }
    ret 0;
}

fun ts_exec_x64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code: [8]u8;
    var k:    usize = 0;
    for (k < 8) {
        code[k] = 0x90;
        k       = k + 1;
    }
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 4096;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = base + 4096;
    segs[0].filesz = 8;
    segs[0].memsz  = 8;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val rb: res[Vector[u8], fail.Fail] = t_emit_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        4096, base, entry,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        "machoexe", of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_EXECUTE) { ret 1; }
    if (bin.read_u32_le(buf.data, 16) != 6)          { ret 1; }
    if (t_uuid_matches_content(?alloc, ?buf) != 0)   { ret 1; }

    val pz: usize = MACH_HEADER_64_SIZE;
    if (bin.read_u32_le(buf.data, pz) != LC_SEGMENT_64)  { ret 1; }
    if (!fixed16_equals(buf.data, pz + 8, "__PAGEZERO")) { ret 1; }
    if (bin.read_u64_le(buf.data, pz + 24) != 0)         { ret 1; }

    val tx: usize = pz + SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, tx) != LC_SEGMENT_64) { ret 1; }
    if (!fixed16_equals(buf.data, tx + 8, "__TEXT"))    { ret 1; }
    val text_va:   u64 = bin.read_u64_le(buf.data, tx + 24);
    val text_vmsz: u64 = bin.read_u64_le(buf.data, tx + 32);
    if (bin.read_u64_le(buf.data, tx + 40) != 0)       { ret 1; }
    if (bin.read_u64_le(buf.data, pz + 32) != text_va) { ret 1; }
    if (text_va > base)                                { ret 1; }
    if (base >= text_va + text_vmsz)                   { ret 1; }

    val th: usize = t_find_lc(buf.data, LC_UNIXTHREAD);
    if (th == 0)                                                            { ret 1; }
    if (bin.read_u32_le(buf.data, th + 8) != X86_THREAD_STATE64)            { ret 1; }
    if (bin.read_u64_le(buf.data, th + 16 + X86_RIP_STATE_OFFSET) != entry) { ret 1; }

    val cs: usize = t_find_lc(buf.data, LC_CODE_SIGNATURE);
    if (cs == 0) { ret 1; }
    val sig_off: usize = bin.read_u32_le(buf.data, cs + 8)::usize;
    if (bin.read_u32_be(buf.data, sig_off) != CSMAGIC_EMBEDDED_SIGNATURE) { ret 1; }
    val cd: usize = sig_off + SUPERBLOB_HEADER_SIZE;
    if (bin.read_u32_be(buf.data, cd) != CSMAGIC_CODEDIRECTORY) { ret 1; }
    if (bin.read_u32_be(buf.data, cd + 32) != sig_off::u32)     { ret 1; }
    val id_off: usize = cd + bin.read_u32_be(buf.data, cd + 20)::usize;
    if (!t_bytes_contain(buf.data, id_off, str_len("machoexe"), "machoexe")) { ret 1; }
    if (buf.data[id_off + str_len("machoexe")] != 0)                         { ret 1; }
    ret 0;
}

fun ts_exec_arm64() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var code: [8]u8;
    bin.write_u32_le(?code[0], 0, 0xD503201F);
    bin.write_u32_le(?code[0], 4, 0xD65F03C0);
    val base:  u64 = 0x100000000;
    val entry: u64 = base + 16384;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = base + 16384;
    segs[0].filesz = 8;
    segs[0].memsz  = 8;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val rb: res[Vector[u8], fail.Fail] = t_emit_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        16384, base, entry,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        "machoa64", of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 4) != CPU_TYPE_ARM64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_EXECUTE)    { ret 1; }
    val th: usize = t_find_lc(buf.data, LC_UNIXTHREAD);
    if (th == 0)                                                           { ret 1; }
    if (bin.read_u32_le(buf.data, th + 8) != ARM_THREAD_STATE64)           { ret 1; }
    if (bin.read_u64_le(buf.data, th + 16 + ARM_PC_STATE_OFFSET) != entry) { ret 1; }
    ret 0;
}

fun ts_register() u8 {
    var reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?reg); }
    val rr: err[fail.Fail] = register_macho(?reg);
    if (sel rr.err) { ret 1; }

    val opt_vt: opt[*of.OfVTable] = of.lookup(?reg, "macho");
    if (!sel opt_vt.some) { ret 1; }
    val vt: *of.OfVTable = opt_vt.some;
    if (vt.id != of.OF_MACHO)    { ret 1; }
    if (vt.emit_object == nil)   { ret 1; }
    if (vt.parse_object == nil)  { ret 1; }
    if (vt.emit_exec == nil)     { ret 1; }
    if (vt.emit_dyn_exec == nil) { ret 1; }
    ret 0;
}

fun ts_dyn_exec(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(arch_id);

    var code:      [16]u8;
    var fixup_off: u32 = 0;
    var fixup_add: i64 = 0;
    if (arch_id == isa.ARCH_AARCH64) {
        bin.write_u32_le(?code[0], 0, 0x94000000);
        fixup_off = 0;
        fixup_add = 0;
    }
    or {
        code[0]   = 0xE8;
        fixup_off = 1;
        fixup_add = -4;
        code[7]   = 0x48;
        code[8]   = 0x8B;
        code[9]   = 0x05;
    }
    val base:   u64 = 0x100000000;
    val seg_va: u64 = base + macho_page_size(arch_id);
    val entry:  u64 = seg_va;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = seg_va;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code[0];

    var libs: [1]of.DynLib;
    libs[0].name   = t_intern(?itn, "probe");
    libs[0].soname = t_intern(?itn, "@rpath/libprobe.dylib");
    libs[0].rpath  = t_intern(?itn, "/opt/probe/lib");
    var imps: [2]of.DynImport;
    imps[0].symbol    = t_intern(?itn, "probe_value");
    imps[0].lib_index = 0;
    imps[0].is_func   = false;
    imps[1].symbol    = t_intern(?itn, "probe_add");
    imps[1].lib_index = 0;
    imps[1].is_func   = true;

    var dyn: of.DynamicInfo;
    dyn.libs                    = ?libs[0];
    dyn.lib_count               = 1;
    dyn.imports                 = ?imps[0];
    dyn.import_count            = 2;
    dyn.interp                  = intern.STR_NIL;
    dyn.import_addr_fixups      = nil;
    dyn.import_addr_fixup_count = 0;

    var fx: [1]of.PltFixup;
    fx[0].seg_index    = 0;
    fx[0].seg_offset   = fixup_off;
    fx[0].import_index = 1;
    fx[0].patch_vaddr  = seg_va + fixup_off::u64;
    fx[0].addend       = fixup_add;

    var gx: [1]of.ImportAddrFixup;
    if (arch_id == isa.ARCH_X86_64) {
        gx[0].seg_index             = 0;
        gx[0].seg_offset            = 10;
        gx[0].import_index          = 0;
        gx[0].patch_vaddr           = seg_va + 10;
        gx[0].kind                  = of.RK_GOTPCREL;
        gx[0].addend                = -4;
        dyn.import_addr_fixups      = ?gx[0];
        dyn.import_addr_fixup_count = 1;
    }

    var debug_bytes: [3]u8;
    debug_bytes[0] = 0x11;
    debug_bytes[1] = 0x22;
    debug_bytes[2] = 0x33;
    var dbg: [1]of.Section;
    dbg[0].name  = t_intern(?itn, ".debug_info");
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?debug_bytes[0];
    dbg[0].len   = 3;
    dbg[0].align = 1;

    if (t_name_segs(?alloc, ?itn, ?segs[0], 1) != 0) { ret 1; }
    val rb: res[Vector[u8], fail.Fail] = t_emit_dyn_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        4096, base, entry,
        nil::*of.ExecFunction, 0, ?dyn, ?fx[0], 1,
        nil::*of.Section, 0, ?dbg[0], 1,
        nil::*of.SymtabEntry, 0,
        "machodyn", of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 0) != MH_MAGIC_64)                  { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != MH_EXECUTE)                  { ret 1; }
    if (bin.read_u32_le(buf.data, 24) != (MH_DYLDLINK | MH_TWOLEVEL)) { ret 1; }
    if (t_uuid_matches_content(?alloc, ?buf) != 0)                    { ret 1; }

    val dw: usize = t_find_seg(buf.data, "__DWARF");
    if (dw == 0)                                                                            { ret 1; }
    if (bin.read_u64_le(buf.data, dw + 32) != 0 || bin.read_u64_le(buf.data, dw + 48) == 0) { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 56) != 0 || bin.read_u32_le(buf.data, dw + 60) != 0) { ret 1; }
    if (bin.read_u32_le(buf.data, dw + 68) != SG_NORELOC)                                   { ret 1; }
    if ((bin.read_u64_le(buf.data, dw + 40) % macho_page_size(arch_id)) != 0)               { ret 1; }

    val dl: usize = t_find_lc(buf.data, LC_LOAD_DYLINKER);
    if (dl == 0)                                                                                   { ret 1; }
    if (!t_bytes_contain(buf.data, dl, bin.read_u32_le(buf.data, dl + 4)::usize, "/usr/lib/dyld")) { ret 1; }
    val ld: usize = t_find_lc(buf.data, LC_LOAD_DYLIB);
    if (ld == 0)                                                                                    { ret 1; }
    if (!t_bytes_contain(buf.data, ld, bin.read_u32_le(buf.data, ld + 4)::usize, "libprobe.dylib")) { ret 1; }
    val rp: usize = t_find_lc(buf.data, LC_RPATH);
    if (rp == 0)                                                                                    { ret 1; }
    if (!t_bytes_contain(buf.data, rp, bin.read_u32_le(buf.data, rp + 4)::usize, "/opt/probe/lib")) { ret 1; }

    val info: usize = t_find_lc(buf.data, LC_DYLD_INFO_ONLY);
    if (info == 0) { ret 1; }
    val bind_off:  usize = bin.read_u32_le(buf.data, info + 16)::usize;
    val bind_size: usize = bin.read_u32_le(buf.data, info + 20)::usize;
    if (bind_size == 0)                                               { ret 1; }
    if (!t_bytes_contain(buf.data, bind_off, bind_size, "probe_add")) { ret 1; }
    if (arch_id == isa.ARCH_X86_64
        && !t_bytes_contain(buf.data, bind_off, bind_size, "probe_value")) { ret 1; }

    val sy: usize = t_find_lc(buf.data, LC_SYMTAB);
    if (sy == 0) { ret 1; }
    var expected_imports: u32 = 1;
    if (arch_id == isa.ARCH_X86_64)                             { expected_imports = 2; }
    if (bin.read_u32_le(buf.data, sy + 12) != expected_imports) { ret 1; }
    val dsy: usize = t_find_lc(buf.data, LC_DYSYMTAB);
    if (dsy == 0)                                                { ret 1; }
    if (bin.read_u32_le(buf.data, dsy + 28) != expected_imports) { ret 1; }

    if (arch_id == isa.ARCH_X86_64) {
        val text_file: usize = bin.read_u32_le(buf.data, t_find_seg(buf.data, "__TEXT") + SEGMENT_CMD_64_SIZE + 48)::usize;
        if (bin.read_u32_le(buf.data, text_file + 1) == 0
            || bin.read_u32_le(buf.data, text_file + 10) == 0) { ret 1; }
    }

    val th: usize = t_find_lc(buf.data, LC_UNIXTHREAD);
    if (th == 0) { ret 1; }
    if (arch_id == isa.ARCH_AARCH64) {
        if (bin.read_u64_le(buf.data, th + 16 + ARM_PC_STATE_OFFSET) != entry) { ret 1; }
    }
    or {
        if (bin.read_u64_le(buf.data, th + 16 + X86_RIP_STATE_OFFSET) != entry) { ret 1; }
    }

    val cs: usize = t_find_lc(buf.data, LC_CODE_SIGNATURE);
    if (cs == 0) { ret 1; }
    val sig_off: usize = bin.read_u32_le(buf.data, cs + 8)::usize;
    if (bin.read_u32_be(buf.data, sig_off) != CSMAGIC_EMBEDDED_SIGNATURE)                    { ret 1; }
    if (bin.read_u32_be(buf.data, sig_off + SUPERBLOB_HEADER_SIZE) != CSMAGIC_CODEDIRECTORY) { ret 1; }
    ret 0;
}

fun ts_exec_frames_like_dyn() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:    intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var bytes: [48]u8;
    var k:     usize = 0;
    for (k < 48) {
        bytes[k] = 0x90;
        k        = k + 1;
    }

    val base:  u64 = 0x100000000;
    val pg:    u64 = macho_page_size(isa.ARCH_X86_64);
    val first: u64 = base + pg;
    var segs:  [3]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ;
    segs[2].bytes  = ?bytes[32];

    if (t_name_segs(?alloc, ?itn, ?segs[0], 3) != 0) { ret 1; }
    val rb: res[Vector[u8], fail.Fail] = t_emit_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 3,
        pg, base, first,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        "machoframe", of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel rb.err) { ret 1; }
    val stat: Vector[u8] = rb.ok;

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie    = true;
    val dr: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 3, ?dyn, first, base);
    if (sel dr.err) { ret 1; }
    val dynb: Vector[u8] = dr.ok;

    val spz: usize = t_find_seg(stat.data, "__PAGEZERO");
    val dpz: usize = t_find_seg(dynb.data, "__PAGEZERO");
    if (spz == 0 || dpz == 0)                         { ret 1; }
    if (bin.read_u64_le(stat.data, spz + 32) != base) { ret 1; }
    if (bin.read_u64_le(dynb.data, dpz + 32) != base) { ret 1; }
    val stx: usize = t_find_seg(stat.data, "__TEXT");
    val dtx: usize = t_find_seg(dynb.data, "__TEXT");
    if (stx == 0 || dtx == 0)                                                { ret 1; }
    if (bin.read_u64_le(stat.data, stx + 24) != base)                        { ret 1; }
    if (bin.read_u64_le(dynb.data, dtx + 24) != base)                        { ret 1; }
    if (bin.read_u64_le(stat.data, stx + 40) != 0)                           { ret 1; }
    if (bin.read_u64_le(stat.data, stx + SEGMENT_CMD_64_SIZE + 32) != first) { ret 1; }

    var snames:  [8]usize;
    var snsects: [8]u32;
    var ssect0:  [8]usize;
    var dnames:  [8]usize;
    var dnsects: [8]u32;
    var dsect0:  [8]usize;
    val sn:      u32 = t_frame_segs(stat.data, ?snames[0], ?snsects[0], ?ssect0[0], 8);
    val dn:      u32 = t_frame_segs(dynb.data, ?dnames[0], ?dnsects[0], ?dsect0[0], 8);
    if (sn != dn || sn < 4) { ret 1; }
    var i: u32 = 0;
    for (i < sn) {
        if (!t_fixed16_same(stat.data, snames[i], dynb.data, dnames[i])) { ret 1; }
        if (snsects[i] != dnsects[i])                                    { ret 1; }
        if (snsects[i] > 0
            && !t_fixed16_same(stat.data, ssect0[i], dynb.data, dsect0[i])) { ret 1; }
        i = i + 1;
    }
    if (snsects[1] == 0 || snsects[2] == 0 || snsects[3] == 0) { ret 1; }

    if (t_find_lc(stat.data, LC_UNIXTHREAD) == 0) { ret 1; }
    if (t_find_lc(dynb.data, LC_MAIN) == 0)       { ret 1; }
    if (t_find_lc(stat.data, LC_MAIN) != 0)       { ret 1; }
    if (t_find_lc(dynb.data, LC_UNIXTHREAD) != 0) { ret 1; }
    # both images identify themselves by content, and different content differs
    if (t_uuid_matches_content(?alloc, ?stat) != 0) { ret 1; }
    if (t_uuid_matches_content(?alloc, ?dynb) != 0) { ret 1; }
    val su: usize = t_find_lc(stat.data, LC_UUID);
    val du: usize = t_find_lc(dynb.data, LC_UUID);
    if (memory.raw_equal((stat.data::usize + su + 8)::ptr, (dynb.data::usize + du + 8)::ptr, 16)) { ret 1; }
    ret 0;
}

fun ts_header_span_multi_page(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:    intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(arch_id);

    val pg:    u64 = macho_page_size(arch_id);
    val nsect: u32 = 256;

    var bytes: [2048]u8;

    val sr: res[*of.LoadSection, A.Error] = A.zallocate[of.LoadSection](?alloc, nsect::usize);
    if (sel sr.err) { ret 1; }
    val secs: *of.LoadSection = sr.ok;

    var nm: [8]u8;
    nm[0] = 0x5F;
    nm[1] = 0x5F;
    nm[2] = 0x73;
    nm[6] = 0;
    nm[7] = 0;
    var i: u32 = 0;
    for (i < nsect) {
        nm[3]        = (48 + (i / 100) % 10)::u8;
        nm[4]        = (48 + (i / 10) % 10)::u8;
        nm[5]        = (48 + i % 10)::u8;
        secs[i].name = t_intern(?itn, ?nm[0]);
        if (secs[i].name == intern.STR_NIL) { ret 1; }
        secs[i].kind   = of.SK_TEXT;
        secs[i].offset = i * 8;
        secs[i].len    = 8;
        secs[i].align  = 8;
        i              = i + 1;
    }

    var segs: [1]of.LoadSegment;
    segs[0].filesz        = 2048;
    segs[0].memsz         = 2048;
    segs[0].flags         = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes         = ?bytes[0];
    segs[0].sections      = secs;
    segs[0].section_count = nsect;

    var shape: of.HeaderShape;
    shape.itn         = ?itn;
    shape.libs        = nil::*of.DynLib;
    shape.lib_count   = 0;
    shape.seg_count   = 1;
    shape.sect_count  = nsect;
    shape.debug_count = 0;
    shape.pie         = true;
    shape.imports     = false;
    val span: u64 = header_span(?shape, pg);
    if (span <= pg)       { ret 1; }
    if ((span % pg) != 0) { ret 1; }

    val base: u64 = 0x100000000;
    segs[0].vaddr = base + span;

    var stat: Vector[u8];
    var dynb: Vector[u8];
    if (t_emit_both(?alloc, ?itn, ?isa_vt, ?segs[0], 1, base, ?stat, ?dynb) != 0) { ret 1; }

    var w: u32 = 0;
    for (w < 2) {
        var buf: *u8 = stat.data;
        if (w == 1) { buf = dynb.data; }

        val sizeofcmds: usize = bin.read_u32_le(buf, 20)::usize;
        if (sizeofcmds::u64 <= pg)                          { ret 1; }
        if (MACH_HEADER_64_SIZE + sizeofcmds > span::usize) { ret 1; }

        val pz: usize = t_find_seg(buf, "__PAGEZERO");
        val tx: usize = t_find_seg(buf, "__TEXT");
        if (pz == 0 || tx == 0)                     { ret 1; }
        if (bin.read_u64_le(buf, pz + 24) != 0)     { ret 1; }
        if (bin.read_u64_le(buf, pz + 32) != base)  { ret 1; }
        if (bin.read_u64_le(buf, tx + 24) != base)  { ret 1; }
        if (bin.read_u64_le(buf, tx + 40) != 0)     { ret 1; }
        if (bin.read_u32_le(buf, tx + 64) != nsect) { ret 1; }

        val s0: usize = tx + SEGMENT_CMD_64_SIZE;
        if (bin.read_u64_le(buf, s0 + 32) != base + span) { ret 1; }
        if (bin.read_u32_le(buf, s0 + 48)::u64 != span)   { ret 1; }
        w = w + 1;
    }

    segs[0].vaddr = base + pg;
    val opts:  of.ImageOptions            = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val bad_s: res[Vector[u8], fail.Fail] = t_emit_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        pg, base, base + pg,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        "machospanbad", opts);
    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.pie    = true;
    val bad_d: res[Vector[u8], fail.Fail] = t_emit_dyn_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 1,
        pg, base, base + pg,
        nil::*of.ExecFunction, 0, ?dyn, nil::*of.PltFixup, 0,
        nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0,
        "machospanbad", opts);

    if (!sel bad_s.err) { ret 1; }
    if (!sel bad_d.err) { ret 1; }
    ret 0;
}

fun ts_dyn_exec_relro_segments(arch_id: u32) u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(arch_id);

    var bytes: [80]u8;

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs:  [5]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ;
    segs[2].bytes  = ?bytes[32];
    segs[3].vaddr  = first + pg * 3;
    segs[3].filesz = 16;
    segs[3].memsz  = 16;
    segs[3].flags  = of.SEG_FLAG_READ;
    segs[3].bytes  = ?bytes[48];
    segs[4].vaddr  = first + pg * 4;
    segs[4].filesz = 0;
    segs[4].memsz  = 16;
    segs[4].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[4].bytes  = nil;

    var brs: [3]of.BaseReloc;
    brs[0].seg_index  = 1;
    brs[0].seg_offset = 0;
    brs[0].target     = base;
    brs[1].seg_index  = 3;
    brs[1].seg_offset = 0;
    brs[1].target     = base;
    brs[2].seg_index  = 2;
    brs[2].seg_offset = 0;
    brs[2].target     = base;

    var dyn: of.DynamicInfo;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = ?brs[0];
    dyn.base_reloc_count = 2;
    dyn.pie              = true;

    val r1: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 5, ?dyn, first, base);
    if (sel r1.err) { ret 1; }
    val buf: Vector[u8] = r1.ok;

    if (t_count_sg_read_only(buf.data) != 1)               { ret 1; }
    if (t_count_segs_named(buf.data, "__DATA_CONST") != 1) { ret 1; }
    val dc: usize = t_find_seg(buf.data, "__DATA_CONST");
    if (dc == 0)                                                              { ret 1; }
    if (bin.read_u64_le(buf.data, dc + 24) != first + pg * 3)                 { ret 1; }
    if ((bin.read_u32_le(buf.data, dc + 68) & SG_READ_ONLY) == 0)             { ret 1; }
    if (bin.read_u32_le(buf.data, dc + 60) != (VM_PROT_READ | VM_PROT_WRITE)) { ret 1; }
    if (bin.read_u32_le(buf.data, dc + 64) != 1)                              { ret 1; }

    if (t_count_segs_named(buf.data, "__RODATA") != 1) { ret 1; }
    val rd: usize = t_find_seg(buf.data, "__RODATA");
    if (rd == 0)                                                  { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 24) != first + pg * 2)     { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 60) != VM_PROT_READ)       { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 56) != VM_PROT_READ)       { ret 1; }
    if ((bin.read_u32_le(buf.data, rd + 68) & SG_READ_ONLY) != 0) { ret 1; }

    val dt: usize = t_find_seg(buf.data, "__DATA");
    if (dt == 0)                                                              { ret 1; }
    if (bin.read_u64_le(buf.data, dt + 24) != first + pg)                     { ret 1; }
    if (bin.read_u32_le(buf.data, dt + 60) != (VM_PROT_READ | VM_PROT_WRITE)) { ret 1; }
    if (bin.read_u32_le(buf.data, dt + 56) != (VM_PROT_READ | VM_PROT_WRITE)) { ret 1; }
    if ((bin.read_u32_le(buf.data, dt + 68) & SG_READ_ONLY) != 0)             { ret 1; }

    if (!t_sections_match_segname(buf.data))           { ret 1; }
    if (t_rebase_vaddr(buf.data, 0) != first + pg)     { ret 1; }
    if (t_rebase_vaddr(buf.data, 1) != first + pg * 3) { ret 1; }
    if (t_rebase_vaddr(buf.data, 2) != 0)              { ret 1; }

    dyn.base_reloc_count = 3;
    val r2: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 5, ?dyn, first, base);
    if (sel r2.err) { ret 1; }
    val buf2: Vector[u8] = r2.ok;
    if (t_count_sg_read_only(buf2.data) != 1)               { ret 1; }
    if (t_count_segs_named(buf2.data, "__DATA_CONST") != 1) { ret 1; }
    if (t_count_segs_named(buf2.data, "__RODATA") != 0)     { ret 1; }
    val dc2: usize = t_find_seg(buf2.data, "__DATA_CONST");
    if (bin.read_u64_le(buf2.data, dc2 + 24) != first + pg * 2) { ret 1; }
    if (bin.read_u32_le(buf2.data, dc2 + 64) != 2)              { ret 1; }
    val r_5393: res[u64, layout.CheckCause] = layout.align_u64_up(pg + 16, macho_page_size(arch_id));
    if (sel r_5393.err)                                    { ret 1; }
    if (bin.read_u64_le(buf2.data, dc2 + 32) != r_5393.ok) { ret 1; }
    if (!t_sections_match_segname(buf2.data))              { ret 1; }
    if (t_rebase_vaddr(buf2.data, 0) != first + pg)        { ret 1; }
    if (t_rebase_vaddr(buf2.data, 1) != first + pg * 2)    { ret 1; }
    if (t_rebase_vaddr(buf2.data, 2) != first + pg * 3)    { ret 1; }
    ret 0;
}

fun ts_dyn_exec_split_data_const() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64);

    var bytes: [64]u8;

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs:  [4]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[2].bytes  = ?bytes[32];
    segs[3].vaddr  = first + pg * 3;
    segs[3].filesz = 16;
    segs[3].memsz  = 16;
    segs[3].flags  = of.SEG_FLAG_READ;
    segs[3].bytes  = ?bytes[48];

    var brs: [2]of.BaseReloc;
    brs[0].seg_index  = 1;
    brs[0].seg_offset = 8;
    brs[0].target     = base;
    brs[1].seg_index  = 3;
    brs[1].seg_offset = 0;
    brs[1].target     = base;

    var dyn: of.DynamicInfo;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = ?brs[0];
    dyn.base_reloc_count = 2;
    dyn.pie              = true;

    val r: res[Vector[u8], fail.Fail] = t_emit_dyn(?alloc, ?itn, ?isa_vt, ?segs[0], 4, ?dyn, first, base);
    if (!sel r.err) { ret 1; }
    val msg: str = fail.describe(r.err);
    if (!str_contains(msg, "__DATA_CONST"))              { ret 1; }
    if (!str_contains(msg, "read-only load segments 1")) { ret 1; }
    if (!str_contains(msg, "and 3"))                     { ret 1; }
    ret 0;
}

fun ts_exec_merges_read_only() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var bytes: [48]u8;

    val base:  u64 = 0x100000000;
    val pg:    u64 = 0x4000;
    val first: u64 = base + pg;
    var segs:  [3]of.LoadSegment;
    segs[0].vaddr  = first;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?bytes[0];
    segs[1].vaddr  = first + pg;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ;
    segs[1].bytes  = ?bytes[16];
    segs[2].vaddr  = first + pg * 2;
    segs[2].filesz = 16;
    segs[2].memsz  = 16;
    segs[2].flags  = of.SEG_FLAG_READ;
    segs[2].bytes  = ?bytes[32];

    if (t_name_segs(?alloc, ?itn, ?segs[0], 3) != 0) { ret 1; }
    val rb: res[Vector[u8], fail.Fail] = t_emit_exec_to_bytes(?alloc, ?itn, ?isa_vt, ?segs[0], 3,
        pg, base, first,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        "machoexecro", of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (t_count_segs_named(buf.data, "__RODATA") != 1) { ret 1; }
    val rd: usize = t_find_seg(buf.data, "__RODATA");
    if (rd == 0)                                          { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 24) != first + pg) { ret 1; }
    val r_5486: res[u64, layout.CheckCause] = layout.align_u64_up(pg + 16, EXEC_PAGE_SIZE);
    if (sel r_5486.err)                                     { ret 1; }
    if (bin.read_u64_le(buf.data, rd + 32) != r_5486.ok)    { ret 1; }
    if (bin.read_u32_le(buf.data, rd + 60) != VM_PROT_READ) { ret 1; }

    if (macho_kind_from(0, false, false, true) != of.SK_RODATA) { ret 1; }
    ret 0;
}

fun ts_unsupported_kind() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0x90;
        k             = k + 1;
    }

    var secs: [1]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name    = t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ADDR32NB;
    relocs[0].sym     = 0;
    relocs[0].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val em: res[Vector[u8], fail.Fail] = t_emit_object_to_bytes(?alloc, ?isa_vt, ?img, "macho_kind");
    if (!sel em.err)                                      { ret 1; }
    if (!str_contains(fail.describe(em.err), "addr32nb")) { ret 1; }
    ret 0;
}

fun ts_bad_input() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var junk: [32]u8;
    var out:  of.ObjectImage;
    val pr:   err[fail.Fail] = parse_object(?alloc, ?i, ?junk[0], 32, ?out);
    if (!sel pr.err)                                       { ret 1; }
    if (!str_contains(fail.describe(pr.err), "bad magic")) { ret 1; }

    var tiny: [8]u8;
    var out2: of.ObjectImage;
    val pr2:  err[fail.Fail] = parse_object(?alloc, ?i, ?tiny[0], 8, ?out2);
    if (!sel pr2.err) { ret 1; }
    ret 0;
}

fun ts_import_address_fixup_validation() u8 {
    var buf:         [16]u8;
    var seg_offsets: [1]usize;
    seg_offsets[0] = 0;
    var segs: [1]of.LoadSegment;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;

    var imports: [1]of.DynImport;
    imports[0].is_func = false;
    var fixups: [1]of.ImportAddrFixup;
    fixups[0].seg_index    = 0;
    fixups[0].seg_offset   = 0;
    fixups[0].import_index = 0;
    fixups[0].patch_vaddr  = 0x1000;
    fixups[0].kind         = of.RK_GOTPCREL;
    fixups[0].addend       = -4;

    var dyn: of.DynamicInfo;
    dyn.imports                 = ?imports[0];
    dyn.import_count            = 1;
    dyn.import_addr_fixups      = ?fixups[0];
    dyn.import_addr_fixup_count = 1;
    var lay: MachoDynLayout;
    lay.got_va   = 0x2000;
    lay.got_size = 8;

    val good: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel good.err)                     { ret 1; }
    if (bin.read_u32_le(?buf[0], 0) == 0) { ret 1; }

    dyn.import_addr_fixups = nil;
    val nil_fixups: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel nil_fixups.ok)                                                  { ret 1; }
    if (!str_contains(fail.describe(nil_fixups.err), "nil import-address")) { ret 1; }
    dyn.import_addr_fixups = ?fixups[0];

    dyn.imports = nil;
    val nil_imports: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel nil_imports.ok)                                                  { ret 1; }
    if (!str_contains(fail.describe(nil_imports.err), "nil dynamic import")) { ret 1; }
    dyn.imports = ?imports[0];

    val nil_layout: err[fail.Fail] = patch_macho_import_addr_fixups(
        nil::*u8, ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel nil_layout.ok)                                                     { ret 1; }
    if (!str_contains(fail.describe(nil_layout.err), "missing output layout")) { ret 1; }

    fixups[0].import_index = 1;
    val bad_import: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_import.ok)                                                   { ret 1; }
    if (!str_contains(fail.describe(bad_import.err), "out-of-range import")) { ret 1; }
    fixups[0].import_index = 0;

    fixups[0].seg_index = 1;
    val bad_segment: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_segment.ok)                                                    { ret 1; }
    if (!str_contains(fail.describe(bad_segment.err), "out-of-range segment")) { ret 1; }
    fixups[0].seg_index = 0;

    fixups[0].kind = of.RK_PC32;
    val bad_kind: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_kind.ok)                                                          { ret 1; }
    if (!str_contains(fail.describe(bad_kind.err), "unsupported import-address")) { ret 1; }
    fixups[0].kind = of.RK_GOTPCREL;

    fixups[0].seg_offset = 14;
    val bad_offset: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel bad_offset.ok)                                                   { ret 1; }
    if (!str_contains(fail.describe(bad_offset.err), "offset out of range")) { ret 1; }
    fixups[0].seg_offset = 0;

    lay.got_size = 0;
    val no_slot: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel no_slot.ok)                                               { ret 1; }
    if (!str_contains(fail.describe(no_slot.err), "has no GOT slot")) { ret 1; }
    lay.got_size = 8;

    lay.got_va            = 0x100000000;
    fixups[0].patch_vaddr = 0;
    fixups[0].addend      = 0;
    val rel32_overflow: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel rel32_overflow.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(rel32_overflow.err), "overflows 32 bits")) { ret 1; }

    lay.got_va = 0x8000000000000000;
    val signed_overflow: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel signed_overflow.ok)                                            { ret 1; }
    if (!str_contains(fail.describe(signed_overflow.err), "signed range")) { ret 1; }

    lay.got_va            = 0x2000;
    fixups[0].patch_vaddr = 0x1000;
    fixups[0].kind        = of.RK_GOTPCREL64_NORELAX;
    fixups[0].addend      = -8;
    val good64: err[fail.Fail] = patch_macho_import_addr_fixups(
        ?buf[0], ?lay, ?dyn, ?seg_offsets[0], ?segs[0], 1);
    if (sel good64.err)                   { ret 1; }
    if (bin.read_u64_le(?buf[0], 0) == 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho:object_round_trip_and_reloc_maps" {
