pub fun arch_is_arm64(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

pub fun macho_page_size(arch_id: u32) u64 {
    if (arch_is_arm64(arch_id)) { ret 16384; }
    ret 4096;
}

pub fun cpu_type_for(arch_id: u32) res[u32, fail.Fail] {
    if (arch_id == isa.ARCH_X86_64)  { ret res[u32, fail.Fail].ok{CPU_TYPE_X86_64}; }
    if (arch_id == isa.ARCH_AARCH64) { ret res[u32, fail.Fail].ok{CPU_TYPE_ARM64}; }
    ret res[u32, fail.Fail].err{fail.message("macho: unsupported architecture (only x86_64 and arm64)")};
}

pub fun cpu_subtype_for(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret CPU_SUBTYPE_ARM64_ALL; }
    ret CPU_SUBTYPE_X86_64_ALL;
}

# the Mach-O segment, section name and section flags of every section kind,
# indexed by the kind. a kind without a row is outside the catalog and the
# lookups below refuse it
pub rec MachoSectionDesc {
    kind:     of.SectionKind;
    segname:  str;
    sectname: str;
    flags:    u32;
}

val MACHO_SECTIONS: [of.SK_COUNT]MachoSectionDesc = [of.SK_COUNT]MachoSectionDesc{
    MachoSectionDesc{kind: of.SK_TEXT, segname: "__TEXT", sectname: "__text", flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS},
    MachoSectionDesc{kind: of.SK_DATA, segname: "__DATA", sectname: "__data", flags: 0},
    MachoSectionDesc{kind: of.SK_RODATA, segname: "__TEXT", sectname: "__const", flags: 0},
    MachoSectionDesc{kind: of.SK_RELRO, segname: "__DATA_CONST", sectname: "__const", flags: 0},
    MachoSectionDesc{kind: of.SK_BSS, segname: "__DATA", sectname: "__bss", flags: S_ZEROFILL},
    MachoSectionDesc{kind: of.SK_DEBUG, segname: "__DWARF", sectname: "__debug", flags: S_ATTR_DEBUG},
    MachoSectionDesc{kind: of.SK_EXCEPTION, segname: "__DATA", sectname: "__debug", flags: 0},
};

pub fun macho_section(kind: of.SectionKind) opt[*MachoSectionDesc] {
    if (!of.section_kind_valid(kind) || MACHO_SECTIONS[kind::u32].kind != kind) { ret opt[*MachoSectionDesc].none{}; }
    ret opt[*MachoSectionDesc].some{?MACHO_SECTIONS[kind::u32]};
}

fun macho_segname(kind: of.SectionKind) opt[str] {
    val desc: opt[*MachoSectionDesc] = macho_section(kind);
    if (sel desc.none) { ret opt[str].none{}; }
    ret opt[str].some{desc.some.segname};
}

pub fun macho_sectname(kind: of.SectionKind) opt[str] {
    val desc: opt[*MachoSectionDesc] = macho_section(kind);
    if (sel desc.none) { ret opt[str].none{}; }
    ret opt[str].some{desc.some.sectname};
}

pub fun macho_section_flags(kind: of.SectionKind) opt[u32] {
    val desc: opt[*MachoSectionDesc] = macho_section(kind);
    if (sel desc.none) { ret opt[u32].none{}; }
    ret opt[u32].some{desc.some.flags};
}

test section_table__every_member_has_its_row_and_no_other_tag_does {
    var i: u32 = 0;
    for (i < of.SK_COUNT) {
        val desc: opt[*MachoSectionDesc] = macho_section(i::of.SectionKind);
        if (sel desc.none)            { ret 1; }
        if (desc.some.kind::u32 != i) { ret 1; }
        i = i + 1;
    }
    val r_373: opt[*MachoSectionDesc] = macho_section(of.SK_COUNT::of.SectionKind);
    if (sel r_373.some) { ret 2; }
    val r_374: opt[str] = macho_segname(255::of.SectionKind);
    if (sel r_374.some) { ret 3; }
    val r_375: opt[str] = macho_sectname(255::of.SectionKind);
    if (sel r_375.some) { ret 3; }
    val r_376: opt[u32] = macho_section_flags(255::of.SectionKind);
    if (sel r_376.some) { ret 3; }
    ret 0;
}

pub fun align_log2(align: u32) u32 {
    var a: u32 = align;
    if (a < 2) { ret 0; }
    var log: u32 = 0;
    for (a > 1) {
        a   = a >> 1;
        log = log + 1;
    }
    ret log;
}

pub fun write_fixed16(buf: *u8, off: usize, s: str) {
    memory.raw_zero((buf::usize + off)::ptr, 16);
    if (s == nil) { ret; }
    var n: usize = str_len(s);
    if (n > 16) { n = 16; }
    var i: usize = 0;
    for (i < n) {
        buf[off + i] = s[i];
        i            = i + 1;
    }
}

pub fun fixed16_equals(buf: *u8, off: usize, s: str) bool {
    val n: usize = str_len(s);
    if (n > 16) { ret false; }
    var i: usize = 0;
    for (i < 16) {
        var expect: u8 = 0;
        if (i < n)                  { expect = s[i]; }
        if (buf[off + i] != expect) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun write_dwarf_sectname(buf: *u8, off: usize, name: str) {
    memory.raw_zero((buf::usize + off)::ptr, 16);
    if (name == nil) { ret; }
    if (name[0] == '.') {
        buf[off]     = '_';
        buf[off + 1] = '_';
        var i: usize = 1;
        var w: usize = 2;
        for (w < 16 && name[i] != 0) {
            buf[off + w] = name[i];
            i            = i + 1;
            w            = w + 1;
        }
        ret;
    }
    var n: usize = str_len(name);
    if (n > 16) { n = 16; }
    var j: usize = 0;
    for (j < n) {
        buf[off + j] = name[j];
        j            = j + 1;
    }
}

pub fun canonical_sectname(raw: str, out: *u8) str {
    if (raw[0] == '_' && raw[1] == '_' && raw[2] == 'd' && raw[3] == 'e' && raw[4] == 'b'
        && raw[5] == 'u' && raw[6] == 'g') {
        out[0] = '.';
        var i: usize = 2;
        var w: usize = 1;
        for (raw[i] != 0) {
            out[w] = raw[i];
            i      = i + 1;
            w      = w + 1;
        }
        out[w] = 0;
        ret out::str;
    }
    var j: usize = 0;
    for (raw[j] != 0) {
        out[j] = raw[j];
        j      = j + 1;
    }
    out[j] = 0;
    ret out::str;
}

pub fun indirect_slots(section: *of.Section) res[u32, fail.Fail] {
    if (section.native.format != of.OF_MACHO) { ret res[u32, fail.Fail].ok{0}; }
    val kind:   u32 = section.native.flags::u32 & SECTION_TYPE;
    var stride: u32 = 0;
    if (kind == 6 || kind == 7 || kind == 0x10 || kind == 0x14) { stride = 8; }
    or (kind == 8) {
        stride = section.native.reserved2;
        if (stride == 0) { ret res[u32, fail.Fail].err{fail.message("macho: symbol stub has zero stride")}; }
    }
    if (stride == 0)               { ret res[u32, fail.Fail].ok{0}; }
    if (section.len % stride != 0) { ret res[u32, fail.Fail].err{fail.message("macho: indirect section has an incomplete slot")}; }
    ret res[u32, fail.Fail].ok{section.len / stride};
}

#[testing]
pub fun t_isa(id: u32) of.ObjectTarget {
    var vt:  isa.IsaVTable = isa.machine_isa(id, "test", 0, 8, nil, nil, nil);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

#[testing]
pub fun t_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern(itn, s);
    if (sel r.err) { ret intern.STR_NIL; }
    ret r.ok;
}

#[testing]
pub fun t_find_lc(buf: *u8, cmd: u32) usize {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        if (bin.read_u32_le(buf, off) == cmd) { ret off; }
        off = off + bin.read_u32_le(buf, off + 4)::usize;
        c   = c + 1;
    }
    ret 0;
}

#[testing]
pub fun t_bytes_contain(buf: *u8, start: usize, len: usize, needle: str) bool {
    val nl: usize = str_len(needle);
    if (nl == 0 || nl > len) { ret false; }
    var i: usize = 0;
    for (i + nl <= len) {
        var j:   usize = 0;
        var hit: bool  = true;
        for (j < nl) {
            if (buf[start + i + j] != needle[j]) {
                hit = false;
                brk;
            }
            j = j + 1;
        }
        if (hit) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
pub fun t_untouched(alloc: *A.Allocator, path: str) bool {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) { ret false; }
    ret rb.ok.len == 0;
}
