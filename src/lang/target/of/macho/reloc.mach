use mach.lang.fail;
use mach.lang.intern;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target.of.macho.format;
use A: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_contains;

pub rec MachoReloc {
    r_type: u32;
    pcrel:  u32;
    length: u32;
}

pub fun macho_reloc_for(itn: *intern.Interner, alloc: *A.Allocator, arch_id: u32, kind: of.RelocKind) res[MachoReloc, fail.Fail] {
    var r: MachoReloc;
    if (format.arch_is_arm64(arch_id)) {
        if (kind == of.RK_ABS64) {
            r.r_type = format.ARM64_RELOC_UNSIGNED;
            r.pcrel  = 0;
            r.length = 3;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_PLT32) {
            r.r_type = format.ARM64_RELOC_BRANCH26;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_JUMP26) {
            r.r_type = format.ARM64_RELOC_BRANCH26;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_PAGE21) {
            r.r_type = format.ARM64_RELOC_PAGE21;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_ADD_LO12) {
            r.r_type = format.ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST8_LO12) {
            r.r_type = format.ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST16_LO12) {
            r.r_type = format.ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST32_LO12) {
            r.r_type = format.ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST64_LO12) {
            r.r_type = format.ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST128_LO12) {
            r.r_type = format.ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_ABS32) {
            r.r_type = format.ARM64_RELOC_UNSIGNED;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_GOT_PAGE21) {
            r.r_type = format.ARM64_RELOC_GOT_LOAD_PAGE21;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_GOT_LO12) {
            r.r_type = format.ARM64_RELOC_GOT_LOAD_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        ret res[MachoReloc, fail.Fail].err{fail.message(unsupported_kind_message(itn, alloc, kind))};
    }
    if (kind == of.RK_ABS64) {
        r.r_type = format.X86_64_RELOC_UNSIGNED;
        r.pcrel  = 0;
        r.length = 3;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_PC32) {
        r.r_type = format.X86_64_RELOC_SIGNED;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_PLT32) {
        r.r_type = format.X86_64_RELOC_BRANCH;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_GOTPCREL) {
        r.r_type = format.X86_64_RELOC_GOT_LOAD;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_GOTPCREL_NORELAX) {
        r.r_type = format.X86_64_RELOC_GOT;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        r.r_type = format.X86_64_RELOC_GOT;
        r.pcrel  = 1;
        r.length = 3;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_ABS32) {
        r.r_type = format.X86_64_RELOC_UNSIGNED;
        r.pcrel  = 0;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    ret res[MachoReloc, fail.Fail].err{fail.message(unsupported_kind_message(itn, alloc, kind))};
}

pub fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, cputype: u32, r_type: u32, r_length: u32, insn: u32) res[of.RelocKind, fail.Fail] {
    if (cputype == format.CPU_TYPE_ARM64) {
        if (r_type == format.ARM64_RELOC_UNSIGNED)  { ret unsigned_kind(r_length); }
        if (r_type == format.ARM64_RELOC_BRANCH26)  { ret res[of.RelocKind, fail.Fail].ok{of.RK_PLT32}; }
        if (r_type == format.ARM64_RELOC_PAGE21)    { ret res[of.RelocKind, fail.Fail].ok{of.RK_PAGE21}; }
        if (r_type == format.ARM64_RELOC_PAGEOFF12) { ret pageoff12_kind(itn, alloc, insn); }
        if (r_type == format.ARM64_RELOC_GOT_LOAD_PAGE21) {
            if ((insn & 0x9F000000) != 0x90000000) {
                ret res[of.RelocKind, fail.Fail].err{fail.message("macho: arm64 GOT_LOAD_PAGE21 relocation does not patch an ADRP")};
            }
            ret res[of.RelocKind, fail.Fail].ok{of.RK_GOT_PAGE21};
        }
        if (r_type == format.ARM64_RELOC_GOT_LOAD_PAGEOFF12) {
            if ((insn & 0xFFC00000) != 0xF9400000) {
                ret res[of.RelocKind, fail.Fail].err{fail.message("macho: arm64 GOT_LOAD_PAGEOFF12 relocation does not patch a 64-bit LDR")};
            }
            ret res[of.RelocKind, fail.Fail].ok{of.RK_GOT_LO12};
        }
        ret res[of.RelocKind, fail.Fail].err{fail.message(unsupported_type_message(itn, alloc, r_type::u64))};
    }
    if (r_type == format.X86_64_RELOC_UNSIGNED) { ret unsigned_kind(r_length); }
    if (x64_is_signed(r_type)) {
        if (r_length != 2) { ret res[of.RelocKind, fail.Fail].err{fail.message("macho: x86_64 signed relocation field is not 4 bytes")}; }
        ret res[of.RelocKind, fail.Fail].ok{of.RK_PC32};
    }
    if (r_type == format.X86_64_RELOC_BRANCH) { ret res[of.RelocKind, fail.Fail].ok{of.RK_PLT32}; }
    if (r_type == format.X86_64_RELOC_GOT_LOAD) {
        if (r_length != 2) { ret res[of.RelocKind, fail.Fail].err{fail.message("macho: x86_64 GOT_LOAD relocation field is not 4 bytes")}; }
        ret res[of.RelocKind, fail.Fail].ok{of.RK_GOTPCREL};
    }
    if (r_type == format.X86_64_RELOC_GOT) {
        if (r_length == 2) { ret res[of.RelocKind, fail.Fail].ok{of.RK_GOTPCREL_NORELAX}; }
        if (r_length == 3) { ret res[of.RelocKind, fail.Fail].ok{of.RK_GOTPCREL64_NORELAX}; }
        ret res[of.RelocKind, fail.Fail].err{fail.message("macho: x86_64 GOT relocation field is neither 4 nor 8 bytes")};
    }
    ret res[of.RelocKind, fail.Fail].err{fail.message(unsupported_type_message(itn, alloc, r_type::u64))};
}

pub fun x64_is_signed(r_type: u32) bool {
    ret r_type == format.X86_64_RELOC_SIGNED || r_type == format.X86_64_RELOC_SIGNED_1
        || r_type == format.X86_64_RELOC_SIGNED_2 || r_type == format.X86_64_RELOC_SIGNED_4;
}

fun unsigned_kind(r_length: u32) res[of.RelocKind, fail.Fail] {
    if (r_length == 3) { ret res[of.RelocKind, fail.Fail].ok{of.RK_ABS64}; }
    ret res[of.RelocKind, fail.Fail].ok{of.RK_ABS32};
}

fun pageoff12_kind(itn: *intern.Interner, alloc: *A.Allocator, insn: u32) res[of.RelocKind, fail.Fail] {
    if ((insn & 0x7F800000) == 0x11000000) { ret res[of.RelocKind, fail.Fail].ok{of.RK_ADD_LO12}; }
    if ((insn & 0x3B000000) == 0x39000000) {
        val v:    u32 = (insn >> 26) & 0x1;
        val size: u32 = (insn >> 30) & 0x3;
        val opc:  u32 = (insn >> 22) & 0x3;
        if (v == 1 && size == 0 && opc == 3) { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST128_LO12}; }
        if (size == 0)                       { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST8_LO12}; }
        if (size == 1)                       { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST16_LO12}; }
        if (size == 2)                       { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST32_LO12}; }
        ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST64_LO12};
    }
    ret res[of.RelocKind, fail.Fail].err{fail.message(bin.name_message(itn, alloc, "macho: undecodable arm64 pageoff12 instruction",
        nil, "macho: undecodable arm64 pageoff12 instruction"))};
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret of.reloc_kind_rejection(itn, alloc, kind, "macho");
}

fun unsupported_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u64) str {
    ret bin.number_message(itn, alloc, "macho: unsupported relocation type ",
        r_type, "macho: unsupported relocation type");
}

pub fun add_u64_mod(a: u64, b: u64) u64 {
    val max: u64 = 0xFFFFFFFFFFFFFFFF;
    if (a > max - b) { ret a - (max - b) - 1; }
    ret a + b;
}

fun ts_reloc_map() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x_abs: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_ABS64);
    if (sel x_abs.err)                                   { ret 1; }
    if (x_abs.ok.r_type != format.X86_64_RELOC_UNSIGNED) { ret 1; }
    val x_plt: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_PLT32);
    if (sel x_plt.err)                                 { ret 1; }
    if (x_plt.ok.r_type != format.X86_64_RELOC_BRANCH) { ret 1; }
    val x_got_load: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL);
    val x_got:      res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL_NORELAX);
    val x_got64:    res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_GOTPCREL64_NORELAX);
    if (sel x_got_load.err)                                   { ret 1; }
    if (x_got_load.ok.r_type != format.X86_64_RELOC_GOT_LOAD) { ret 1; }
    if (sel x_got.err)                                        { ret 1; }
    if (x_got.ok.r_type != format.X86_64_RELOC_GOT)           { ret 1; }
    if (x_got.ok.length != 2)                                 { ret 1; }
    if (sel x_got64.err)                                      { ret 1; }
    if (x_got64.ok.r_type != format.X86_64_RELOC_GOT)         { ret 1; }
    if (x_got64.ok.length != 3)                               { ret 1; }

    val a_page: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_PAGE21);
    if (sel a_page.err)                                { ret 1; }
    if (a_page.ok.r_type != format.ARM64_RELOC_PAGE21) { ret 1; }
    val a_ldst: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_LDST32_LO12);
    if (sel a_ldst.err)                                   { ret 1; }
    if (a_ldst.ok.r_type != format.ARM64_RELOC_PAGEOFF12) { ret 1; }

    val a_got_page: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_GOT_PAGE21);
    if (sel a_got_page.err)                                         { ret 1; }
    if (a_got_page.ok.r_type != format.ARM64_RELOC_GOT_LOAD_PAGE21) { ret 1; }
    if (a_got_page.ok.pcrel != 1 || a_got_page.ok.length != 2)      { ret 1; }
    val a_got_lo: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_GOT_LO12);
    if (sel a_got_lo.err)                                            { ret 1; }
    if (a_got_lo.ok.r_type != format.ARM64_RELOC_GOT_LOAD_PAGEOFF12) { ret 1; }
    if (a_got_lo.ok.pcrel != 0 || a_got_lo.ok.length != 2)           { ret 1; }

    val a_bad: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_ADDR32NB);
    if (!sel a_bad.err)                                      { ret 1; }
    if (!str_contains(fail.describe(a_bad.err), "addr32nb")) { ret 1; }
    ret 0;
}

fun ts_pageoff12() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val add: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_PAGEOFF12, 2, 0x91000000);
    if (sel add.err)              { ret 1; }
    if (add.ok != of.RK_ADD_LO12) { ret 1; }
    val b8: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_PAGEOFF12, 2, 0x39400000);
    if (sel b8.err)                { ret 1; }
    if (b8.ok != of.RK_LDST8_LO12) { ret 1; }
    val h16: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_PAGEOFF12, 2, 0x79400000);
    if (sel h16.err)                 { ret 1; }
    if (h16.ok != of.RK_LDST16_LO12) { ret 1; }
    val w32: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_PAGEOFF12, 2, 0xB9400000);
    if (sel w32.err)                 { ret 1; }
    if (w32.ok != of.RK_LDST32_LO12) { ret 1; }
    val x64: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_PAGEOFF12, 2, 0xF9400000);
    if (sel x64.err)                 { ret 1; }
    if (x64.ok != of.RK_LDST64_LO12) { ret 1; }
    val q128: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_PAGEOFF12, 2, 0x3DC00000);
    if (sel q128.err)                  { ret 1; }
    if (q128.ok != of.RK_LDST128_LO12) { ret 1; }
    ret 0;
}

fun ts_abs32() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x32: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_X86_64, of.RK_ABS32);
    if (sel x32.err)                                   { ret 1; }
    if (x32.ok.r_type != format.X86_64_RELOC_UNSIGNED) { ret 1; }
    if (x32.ok.length != 2)                            { ret 1; }
    val a32: res[MachoReloc, fail.Fail] = macho_reloc_for(?i, ?alloc, isa.ARCH_AARCH64, of.RK_ABS32);
    if (sel a32.err)                                  { ret 1; }
    if (a32.ok.r_type != format.ARM64_RELOC_UNSIGNED) { ret 1; }
    if (a32.ok.length != 2)                           { ret 1; }

    val xr2: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_X86_64, format.X86_64_RELOC_UNSIGNED, 2, 0);
    if (sel xr2.err)           { ret 1; }
    if (xr2.ok != of.RK_ABS32) { ret 1; }
    val xr3: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_X86_64, format.X86_64_RELOC_UNSIGNED, 3, 0);
    if (sel xr3.err)           { ret 1; }
    if (xr3.ok != of.RK_ABS64) { ret 1; }
    val ar2: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_UNSIGNED, 2, 0);
    if (sel ar2.err)           { ret 1; }
    if (ar2.ok != of.RK_ABS32) { ret 1; }
    val ar3: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_UNSIGNED, 3, 0);
    if (sel ar3.err)           { ret 1; }
    if (ar3.ok != of.RK_ABS64) { ret 1; }
    ret 0;
}

# the arm64 GOT_LOAD pair reads back as the GOT kinds, and only over the
# instructions a GOT load is made of: an ADRP for the page, a 64-bit LDR for
# the offset (#3675)
fun ts_got_load() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val page21: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_GOT_LOAD_PAGE21, 2, 0x90000008);
    if (sel page21.err)                { ret 1; }
    if (page21.ok != of.RK_GOT_PAGE21) { ret 1; }
    val lo12: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_GOT_LOAD_PAGEOFF12, 2, 0xF9400108);
    if (sel lo12.err)              { ret 1; }
    if (lo12.ok != of.RK_GOT_LO12) { ret 1; }

    val not_adrp: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_GOT_LOAD_PAGE21, 2, 0xF9400108);
    if (!sel not_adrp.err)                                                    { ret 1; }
    if (!str_contains(fail.describe(not_adrp.err), "does not patch an ADRP")) { ret 1; }
    val not_ldr: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, format.CPU_TYPE_ARM64, format.ARM64_RELOC_GOT_LOAD_PAGEOFF12, 2, 0x39400108);
    if (!sel not_ldr.err)                                                         { ret 1; }
    if (!str_contains(fail.describe(not_ldr.err), "does not patch a 64-bit LDR")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.macho.reloc:reloc_maps" {
    if (ts_reloc_map() != 0) { ret 1; }
    if (ts_pageoff12() != 0) { ret 1; }
    if (ts_abs32() != 0)     { ret 1; }
    if (ts_got_load() != 0)  { ret 1; }
    ret 0;
}
