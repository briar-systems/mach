use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use catalog_arch: mach.lang.target.catalog.arch;
use target_of:    mach.lang.target.of;
use mach.lang.target.of.bin;
use macho_format: mach.lang.target.of.macho.format;
use A:            std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

pub rec MachoReloc {
    r_type: u32;
    pcrel:  u32;
    length: u32;
    # the relocation loads a GOT slot, which names no address into a symbol
    # and so takes no addend
    slot: bool;
}

# one relocation kind an instruction set writes, as the entry that records it
rec Row {
    kind:  target_of.RelocKind;
    entry: MachoReloc;
}

val X64_ROW_COUNT: usize              = 7;
val X64_ROWS:      [X64_ROW_COUNT]Row = [X64_ROW_COUNT]Row{
    Row{kind: target_of.RK_ABS64, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_UNSIGNED, pcrel: 0, length: 3}},
    Row{kind: target_of.RK_PC32, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_SIGNED, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_PLT32, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_BRANCH, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_GOTPCREL, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_GOT_LOAD, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_GOTPCREL_NORELAX, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_GOT, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_GOTPCREL64_NORELAX, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_GOT, pcrel: 1, length: 3}},
    Row{kind: target_of.RK_ABS32, entry: MachoReloc{r_type: macho_format.X86_64_RELOC_UNSIGNED, pcrel: 0, length: 2}},
};

val ARM64_ROW_COUNT: usize                = 13;
val ARM64_ROWS:      [ARM64_ROW_COUNT]Row = [ARM64_ROW_COUNT]Row{
    Row{kind: target_of.RK_ABS64, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_UNSIGNED, pcrel: 0, length: 3}},
    Row{kind: target_of.RK_PLT32, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_BRANCH26, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_JUMP26, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_BRANCH26, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_PAGE21, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGE21, pcrel: 1, length: 2}},
    Row{kind: target_of.RK_ADD_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGEOFF12, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_LDST8_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGEOFF12, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_LDST16_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGEOFF12, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_LDST32_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGEOFF12, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_LDST64_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGEOFF12, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_LDST128_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_PAGEOFF12, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_ABS32, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_UNSIGNED, pcrel: 0, length: 2}},
    Row{kind: target_of.RK_GOT_PAGE21, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_GOT_LOAD_PAGE21, pcrel: 1, length: 2, slot: true}},
    Row{kind: target_of.RK_GOT_LO12, entry: MachoReloc{r_type: macho_format.ARM64_RELOC_GOT_LOAD_PAGEOFF12, pcrel: 0, length: 2, slot: true}},
};

# the relocations an instruction set writes, and how it reads a relocation
# entry back into a kind
rec IsaRelocs {
    arch:     u32;
    rows:     *Row;
    count:    usize;
    kind_for: fun(*intern.Interner, *A.Allocator, u32, u32, u32) res[target_of.RelocKind, fail.Fail];
}

val ISA_COUNT: usize                = 2;
val ISAS:      [ISA_COUNT]IsaRelocs = [ISA_COUNT]IsaRelocs{
    IsaRelocs{arch: catalog_arch.X86_64, rows: ?X64_ROWS[0], count: X64_ROW_COUNT, kind_for: x64_kind_for},
    IsaRelocs{arch: catalog_arch.AARCH64, rows: ?ARM64_ROWS[0], count: ARM64_ROW_COUNT, kind_for: arm64_kind_for},
};

fun relocs_for(arch_id: u32) *IsaRelocs {
    var i: usize = 0;
    for (i < ISA_COUNT) {
        if (ISAS[i].arch == arch_id) { ret ?ISAS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun reloc_for(itn: *intern.Interner, alloc: *A.Allocator, arch_id: u32, kind: target_of.RelocKind, origin: target_of.RelocOrigin) res[MachoReloc, fail.Fail] {
    val isa_relocs: *IsaRelocs = relocs_for(arch_id);
    if (isa_relocs != nil) {
        var i: usize = 0;
        for (i < isa_relocs.count) {
            if (isa_relocs.rows[i].kind == kind) { ret res[MachoReloc, fail.Fail].ok{isa_relocs.rows[i].entry}; }
            i = i + 1;
        }
    }
    ret res[MachoReloc, fail.Fail].err{target_of.reloc_refusal_made(origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, unsupported_kind_message(itn, alloc, kind))};
}

pub fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, cputype: u32, r_type: u32, r_length: u32, insn: u32) res[target_of.RelocKind, fail.Fail] {
    val isa_row:    *macho_format.IsaRow = macho_format.row_for_cpu(cputype);
    var isa_relocs: *IsaRelocs           = nil;
    if (isa_row != nil) { isa_relocs = relocs_for(isa_row.arch); }
    if (isa_relocs == nil) {
        ret res[target_of.RelocKind, fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_UNSUPPORTED, bin.reloc_type_rejection(itn, alloc, r_type::u64))};
    }
    ret isa_relocs.kind_for(itn, alloc, r_type, r_length, insn);
}

fun arm64_kind_for(itn: *intern.Interner, alloc: *A.Allocator, r_type: u32, r_length: u32, insn: u32) res[target_of.RelocKind, fail.Fail] {
    if (r_type == macho_format.ARM64_RELOC_UNSIGNED) { ret unsigned_kind(r_length); }
    # one branch26 type serves b and bl, which mach tells apart as jump and call
    if (r_type == macho_format.ARM64_RELOC_BRANCH26 && (insn & 0xFC000000) == 0x14000000) {
        ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_JUMP26};
    }
    if (r_type == macho_format.ARM64_RELOC_BRANCH26)  { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_PLT32}; }
    if (r_type == macho_format.ARM64_RELOC_PAGE21)    { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_PAGE21}; }
    if (r_type == macho_format.ARM64_RELOC_PAGEOFF12) { ret pageoff12_kind(itn, alloc, insn); }
    if (r_type == macho_format.ARM64_RELOC_GOT_LOAD_PAGE21) {
        if ((insn & 0x9F000000) != 0x90000000) {
            ret res[target_of.RelocKind, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "arm64 GOT_LOAD_PAGE21 relocation does not patch an ADRP")};
        }
        ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_GOT_PAGE21};
    }
    if (r_type == macho_format.ARM64_RELOC_GOT_LOAD_PAGEOFF12) {
        if ((insn & 0xFFC00000) != 0xF9400000) {
            ret res[target_of.RelocKind, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "arm64 GOT_LOAD_PAGEOFF12 relocation does not patch a 64-bit LDR")};
        }
        ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_GOT_LO12};
    }
    ret res[target_of.RelocKind, fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_UNSUPPORTED, bin.reloc_type_rejection(itn, alloc, r_type::u64))};
}

fun x64_kind_for(itn: *intern.Interner, alloc: *A.Allocator, r_type: u32, r_length: u32, insn: u32) res[target_of.RelocKind, fail.Fail] {
    if (r_type == macho_format.X86_64_RELOC_UNSIGNED) { ret unsigned_kind(r_length); }
    if (x64_is_signed(r_type)) {
        if (r_length != 2) { ret res[target_of.RelocKind, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "x86_64 signed relocation field is not 4 bytes")}; }
        ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_PC32};
    }
    if (r_type == macho_format.X86_64_RELOC_BRANCH) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_PLT32}; }
    if (r_type == macho_format.X86_64_RELOC_GOT_LOAD) {
        if (r_length != 2) { ret res[target_of.RelocKind, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "x86_64 GOT_LOAD relocation field is not 4 bytes")}; }
        ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_GOTPCREL};
    }
    if (r_type == macho_format.X86_64_RELOC_GOT) {
        if (r_length == 2) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_GOTPCREL_NORELAX}; }
        if (r_length == 3) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_GOTPCREL64_NORELAX}; }
        ret res[target_of.RelocKind, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "x86_64 GOT relocation field is neither 4 nor 8 bytes")};
    }
    ret res[target_of.RelocKind, fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_UNSUPPORTED, bin.reloc_type_rejection(itn, alloc, r_type::u64))};
}

pub fun x64_is_signed(r_type: u32) bool {
    ret r_type == macho_format.X86_64_RELOC_SIGNED || r_type == macho_format.X86_64_RELOC_SIGNED_1
        || r_type == macho_format.X86_64_RELOC_SIGNED_2 || r_type == macho_format.X86_64_RELOC_SIGNED_4;
}

fun unsigned_kind(r_length: u32) res[target_of.RelocKind, fail.Fail] {
    if (r_length == 3) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_ABS64}; }
    ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_ABS32};
}

fun pageoff12_kind(itn: *intern.Interner, alloc: *A.Allocator, insn: u32) res[target_of.RelocKind, fail.Fail] {
    if ((insn & 0x7F800000) == 0x11000000) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_ADD_LO12}; }
    if ((insn & 0x3B000000) == 0x39000000) {
        val v:    u32 = (insn >> 26) & 0x1;
        val size: u32 = (insn >> 30) & 0x3;
        val opc:  u32 = (insn >> 22) & 0x3;
        if (v == 1 && size == 0 && opc == 3) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_LDST128_LO12}; }
        if (size == 0)                       { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_LDST8_LO12}; }
        if (size == 1)                       { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_LDST16_LO12}; }
        if (size == 2)                       { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_LDST32_LO12}; }
        ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_LDST64_LO12};
    }
    ret res[target_of.RelocKind, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "undecodable arm64 pageoff12 instruction")};
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: target_of.RelocKind) res[str, fail.Fail] {
    ret target_of.reloc_kind_rejection(itn, alloc, kind, "macho");
}

pub fun add_u64_mod(a: u64, b: u64) u64 {
    val max: u64 = 0xFFFFFFFFFFFFFFFF;
    if (a > max - b) { ret a - (max - b) - 1; }
    ret a + b;
}

test macho_reloc_for__per_arch_kinds {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x_abs: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.X86_64, target_of.RK_ABS64, target_of.RELOC_INPUT);
    if (sel x_abs.err)                                         { ret 1; }
    if (x_abs.ok.r_type != macho_format.X86_64_RELOC_UNSIGNED) { ret 1; }
    val x_plt: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.X86_64, target_of.RK_PLT32, target_of.RELOC_INPUT);
    if (sel x_plt.err)                                       { ret 1; }
    if (x_plt.ok.r_type != macho_format.X86_64_RELOC_BRANCH) { ret 1; }
    val x_got_load: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.X86_64, target_of.RK_GOTPCREL, target_of.RELOC_INPUT);
    val x_got:      res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.X86_64, target_of.RK_GOTPCREL_NORELAX, target_of.RELOC_INPUT);
    val x_got64:    res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.X86_64, target_of.RK_GOTPCREL64_NORELAX, target_of.RELOC_INPUT);
    if (sel x_got_load.err)                                         { ret 1; }
    if (x_got_load.ok.r_type != macho_format.X86_64_RELOC_GOT_LOAD) { ret 1; }
    if (sel x_got.err)                                              { ret 1; }
    if (x_got.ok.r_type != macho_format.X86_64_RELOC_GOT)           { ret 1; }
    if (x_got.ok.length != 2)                                       { ret 1; }
    if (sel x_got64.err)                                            { ret 1; }
    if (x_got64.ok.r_type != macho_format.X86_64_RELOC_GOT)         { ret 1; }
    if (x_got64.ok.length != 3)                                     { ret 1; }

    val a_page: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_PAGE21, target_of.RELOC_INPUT);
    if (sel a_page.err)                                      { ret 1; }
    if (a_page.ok.r_type != macho_format.ARM64_RELOC_PAGE21) { ret 1; }
    val a_ldst: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_LDST32_LO12, target_of.RELOC_INPUT);
    if (sel a_ldst.err)                                         { ret 1; }
    if (a_ldst.ok.r_type != macho_format.ARM64_RELOC_PAGEOFF12) { ret 1; }

    val a_got_page: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_GOT_PAGE21, target_of.RELOC_INPUT);
    if (sel a_got_page.err)                                               { ret 1; }
    if (a_got_page.ok.r_type != macho_format.ARM64_RELOC_GOT_LOAD_PAGE21) { ret 1; }
    if (a_got_page.ok.pcrel != 1 || a_got_page.ok.length != 2)            { ret 1; }
    val a_got_lo: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_GOT_LO12, target_of.RELOC_INPUT);
    if (sel a_got_lo.err)                                                  { ret 1; }
    if (a_got_lo.ok.r_type != macho_format.ARM64_RELOC_GOT_LOAD_PAGEOFF12) { ret 1; }
    if (a_got_lo.ok.pcrel != 0 || a_got_lo.ok.length != 2)                 { ret 1; }

    val a_bad: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_ADDR32NB, target_of.RELOC_INPUT);
    if (!sel a_bad.err)                                      { ret 1; }
    if (!str_contains(fail.describe(a_bad.err), "addr32nb")) { ret 1; }
    # the kind has no Mach-O form: the input's fault when an input asked for it,
    # a compiler defect when codegen made it
    if (fail.kind_of(a_bad.err) != diagnostic_kind.LINK_RELOCATION_UNSUPPORTED) { ret 1; }
    val made: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_ADDR32NB, target_of.RELOC_CODEGEN);
    if (sel made.ok)                                                 { ret 1; }
    if (fail.kind_of(made.err) != diagnostic_kind.COMPILER_INTERNAL) { ret 1; }
    ret 0;
}

test reloc_kind_for__pageoff12_reads_the_instruction {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val add: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_PAGEOFF12, 2, 0x91000000);
    if (sel add.err)                     { ret 1; }
    if (add.ok != target_of.RK_ADD_LO12) { ret 1; }
    val b8: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_PAGEOFF12, 2, 0x39400000);
    if (sel b8.err)                       { ret 1; }
    if (b8.ok != target_of.RK_LDST8_LO12) { ret 1; }
    val h16: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_PAGEOFF12, 2, 0x79400000);
    if (sel h16.err)                        { ret 1; }
    if (h16.ok != target_of.RK_LDST16_LO12) { ret 1; }
    val w32: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_PAGEOFF12, 2, 0xB9400000);
    if (sel w32.err)                        { ret 1; }
    if (w32.ok != target_of.RK_LDST32_LO12) { ret 1; }
    val x64: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_PAGEOFF12, 2, 0xF9400000);
    if (sel x64.err)                        { ret 1; }
    if (x64.ok != target_of.RK_LDST64_LO12) { ret 1; }
    val q128: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_PAGEOFF12, 2, 0x3DC00000);
    if (sel q128.err)                         { ret 1; }
    if (q128.ok != target_of.RK_LDST128_LO12) { ret 1; }
    ret 0;
}

test reloc_kind__unsigned_by_length_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val x32: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.X86_64, target_of.RK_ABS32, target_of.RELOC_INPUT);
    if (sel x32.err)                                         { ret 1; }
    if (x32.ok.r_type != macho_format.X86_64_RELOC_UNSIGNED) { ret 1; }
    if (x32.ok.length != 2)                                  { ret 1; }
    val a32: res[MachoReloc, fail.Fail] = reloc_for(?i, ?alloc, catalog_arch.AARCH64, target_of.RK_ABS32, target_of.RELOC_INPUT);
    if (sel a32.err)                                        { ret 1; }
    if (a32.ok.r_type != macho_format.ARM64_RELOC_UNSIGNED) { ret 1; }
    if (a32.ok.length != 2)                                 { ret 1; }

    val xr2: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_X86_64, macho_format.X86_64_RELOC_UNSIGNED, 2, 0);
    if (sel xr2.err)                  { ret 1; }
    if (xr2.ok != target_of.RK_ABS32) { ret 1; }
    val xr3: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_X86_64, macho_format.X86_64_RELOC_UNSIGNED, 3, 0);
    if (sel xr3.err)                  { ret 1; }
    if (xr3.ok != target_of.RK_ABS64) { ret 1; }
    val ar2: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_UNSIGNED, 2, 0);
    if (sel ar2.err)                  { ret 1; }
    if (ar2.ok != target_of.RK_ABS32) { ret 1; }
    val ar3: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_UNSIGNED, 3, 0);
    if (sel ar3.err)                  { ret 1; }
    if (ar3.ok != target_of.RK_ABS64) { ret 1; }
    ret 0;
}

# the arm64 GOT_LOAD pair reads back as the GOT kinds, and only over the
# instructions a GOT load is made of: an ADRP for the page, a 64-bit LDR for
# the offset
test reloc_kind_for__got_load_pair {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val page21: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_GOT_LOAD_PAGE21, 2, 0x90000008);
    if (sel page21.err)                       { ret 1; }
    if (page21.ok != target_of.RK_GOT_PAGE21) { ret 1; }
    val lo12: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_GOT_LOAD_PAGEOFF12, 2, 0xF9400108);
    if (sel lo12.err)                     { ret 1; }
    if (lo12.ok != target_of.RK_GOT_LO12) { ret 1; }

    val not_adrp: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_GOT_LOAD_PAGE21, 2, 0xF9400108);
    if (!sel not_adrp.err)                                                    { ret 1; }
    if (!str_contains(fail.describe(not_adrp.err), "does not patch an ADRP")) { ret 1; }
    val not_ldr: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, macho_format.CPU_TYPE_ARM64, macho_format.ARM64_RELOC_GOT_LOAD_PAGEOFF12, 2, 0x39400108);
    if (!sel not_ldr.err)                                                         { ret 1; }
    if (!str_contains(fail.describe(not_ldr.err), "does not patch a 64-bit LDR")) { ret 1; }
    ret 0;
}
