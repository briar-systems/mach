use mach.lang.fail;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target.of.macho.dwarf;
use mach.lang.target.of.macho.format;
use mach.lang.target.of.macho.segment;
use mach.lang.target.of.plan;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

fun exec_section_flags(sec: *of.LoadSection) res[u32, fail.Fail] {
    val declared: opt[u32] = format.macho_section_flags(sec.kind);
    if (sel declared.none) { ret res[u32, fail.Fail].err{fail.message("macho: load section kind is outside the SectionKind catalog")}; }
    var f: u32 = declared.some;
    if ((sec.flags & of.SEC_FLAG_INIT_FUNCS) != 0) {
        f = (f & ~format.SECTION_TYPE) | format.S_MOD_INIT_FUNC_POINTERS;
    }
    ret res[u32, fail.Fail].ok{f};
}

pub fun header_span(shape: *of.HeaderShape, page: u64) u64 {
    if (shape == nil) { ret page; }

    var seg_cmds:   u32 = shape.seg_count + 2;
    var sect_total: u32 = shape.sect_count;
    if (shape.imports) {
        seg_cmds   = seg_cmds + 2;
        sect_total = sect_total + 2;
    }

    var entry_cmd: usize = 16 + format.ARM_THREAD_STATE64_COUNT::usize * 4;
    if (16 + format.X86_THREAD_STATE64_COUNT::usize * 4 > entry_cmd) {
        entry_cmd = 16 + format.X86_THREAD_STATE64_COUNT::usize * 4;
    }
    if (format.ENTRY_POINT_CMD_SIZE > entry_cmd) { entry_cmd = format.ENTRY_POINT_CMD_SIZE; }

    var size: usize = format.MACH_HEADER_64_SIZE
        + seg_cmds::usize * format.SEGMENT_CMD_64_SIZE
        + sect_total::usize * format.SECTION_64_SIZE
        + format.DYLD_INFO_CMD_SIZE + format.SYMTAB_CMD_SIZE + format.DYSYMTAB_CMD_SIZE
        + dylinker_cmd_size() + entry_cmd + format.LINKEDIT_DATA_CMD_SIZE
        + format.BUILD_VERSION_CMD_SIZE + format.UUID_CMD_SIZE
        + dwarf.macho_dwarf_cmd_bytes(shape.debug_count);

    var i: u32 = 0;
    for (i < shape.lib_count) {
        size = size + dylib_cmd_size(bin.resolve_name(shape.itn, shape.libs[i].soname));
        if (shape.libs[i].rpath != intern.STR_NIL
            && !rpath_seen_before(shape.libs, i, shape.libs[i].rpath)) {
            size = size + rpath_cmd_size(bin.resolve_name(shape.itn, shape.libs[i].rpath));
        }
        i = i + 1;
    }

    val rounded: res[u64, layout.CheckCause] = layout.align_u64_up(size::u64, page);
    if (sel rounded.err) { ret page; }
    ret rounded.ok;
}

# a load-command name is a path or an soname; the checked round-up over a
# constant eight-byte alignment cannot fail on a value of that size
fun align8(value: usize) usize {
    val aligned: res[usize, fail.Fail] = plan.align_bytes(value, 8);
    if (sel aligned.err) {
        panic("macho: a bounded value overflowed its 8-byte round-up\n");
        ret 0;
    }
    ret aligned.ok;
}

pub fun dylinker_cmd_size() usize {
    ret align8(format.DYLINKER_CMD_BASE + str_len(format.DARWIN_DYLD_PATH) + 1);
}

pub fun dylib_cmd_size(name: str) usize {
    var n: usize = 0;
    if (name != nil) { n = str_len(name); }
    ret align8(format.DYLIB_CMD_BASE + n + 1);
}

pub fun rpath_cmd_size(name: str) usize {
    var n: usize = 0;
    if (name != nil) { n = str_len(name); }
    ret align8(format.RPATH_CMD_BASE + n + 1);
}

pub fun write_load_dylinker(buf: *u8, off: usize) usize {
    val sz: usize = dylinker_cmd_size();
    bin.write_u32_le(buf, off, format.LC_LOAD_DYLINKER);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, format.DYLINKER_CMD_BASE::u32);
    bin.write_str(buf, off + format.DYLINKER_CMD_BASE, format.DARWIN_DYLD_PATH);
    ret off + sz;
}

pub fun write_load_dylib(buf: *u8, off: usize, name: str) usize {
    val sz: usize = dylib_cmd_size(name);
    bin.write_u32_le(buf, off, format.LC_LOAD_DYLIB);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, format.DYLIB_CMD_BASE::u32);
    bin.write_u32_le(buf, off + 12, 0);
    bin.write_u32_le(buf, off + 16, 0x10000);
    bin.write_u32_le(buf, off + 20, 0x10000);
    bin.write_str(buf, off + format.DYLIB_CMD_BASE, name);
    ret off + sz;
}

pub fun write_rpath(buf: *u8, off: usize, name: str) usize {
    val sz: usize = rpath_cmd_size(name);
    bin.write_u32_le(buf, off, format.LC_RPATH);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, format.RPATH_CMD_BASE::u32);
    bin.write_str(buf, off + format.RPATH_CMD_BASE, name);
    ret off + sz;
}

pub fun rpath_seen_before(libs: *of.DynLib, end: u32, rpath: intern.StrId) bool {
    var i: u32 = 0;
    for (i < end) {
        if (libs[i].rpath == rpath) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun write_unixthread(buf: *u8, off: usize, arch_id: u32, entry: u64, cmd_size: usize) usize {
    bin.write_u32_le(buf, off, format.LC_UNIXTHREAD);
    bin.write_u32_le(buf, off + 4, cmd_size::u32);
    if (format.arch_is_arm64(arch_id)) {
        bin.write_u32_le(buf, off + 8, format.ARM_THREAD_STATE64);
        bin.write_u32_le(buf, off + 12, format.ARM_THREAD_STATE64_COUNT);
        bin.write_u64_le(buf, off + 16 + format.ARM_PC_STATE_OFFSET, entry);
    }
    or {
        bin.write_u32_le(buf, off + 8, format.X86_THREAD_STATE64);
        bin.write_u32_le(buf, off + 12, format.X86_THREAD_STATE64_COUNT);
        bin.write_u64_le(buf, off + 16 + format.X86_RIP_STATE_OFFSET, entry);
    }
    ret off + cmd_size;
}

pub fun write_segment_cmd(buf: *u8, off: usize, name: str, vmaddr: u64, vmsize: u64,
    fileoff: u64, filesize: u64, maxprot: u32, initprot: u32, nsects: u32) usize {
    bin.write_u32_le(buf, off, format.LC_SEGMENT_64);
    bin.write_u32_le(buf, off + 4, (format.SEGMENT_CMD_64_SIZE + nsects::usize * format.SECTION_64_SIZE)::u32);
    format.write_fixed16(buf, off + 8, name);
    bin.write_u64_le(buf, off + 24, vmaddr);
    bin.write_u64_le(buf, off + 32, vmsize);
    bin.write_u64_le(buf, off + 40, fileoff);
    bin.write_u64_le(buf, off + 48, filesize);
    bin.write_u32_le(buf, off + 56, maxprot);
    bin.write_u32_le(buf, off + 60, initprot);
    bin.write_u32_le(buf, off + 64, nsects);
    bin.write_u32_le(buf, off + 68, 0);
    ret off + format.SEGMENT_CMD_64_SIZE;
}

pub fun write_section_64(buf: *u8, off: usize, sectname: str, segname: str, addr: u64, size: u64,
    fileoff: u32, align: u32, flags: u32) usize {
    format.write_fixed16(buf, off, sectname);
    format.write_fixed16(buf, off + 16, segname);
    bin.write_u64_le(buf, off + 32, addr);
    bin.write_u64_le(buf, off + 40, size);
    bin.write_u32_le(buf, off + 48, fileoff);
    bin.write_u32_le(buf, off + 52, format.align_log2(align));
    bin.write_u32_le(buf, off + 56, 0);
    bin.write_u32_le(buf, off + 60, 0);
    bin.write_u32_le(buf, off + 64, flags);
    bin.write_u32_le(buf, off + 68, 0);
    bin.write_u32_le(buf, off + 72, 0);
    bin.write_u32_le(buf, off + 76, 0);
    ret off + format.SECTION_64_SIZE;
}

pub fun frame_cmd_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, pagezero: bool) u32 {
    var n: u32 = segment.seg_group_count(dyn, segs, seg_count);
    if (pagezero) { n = n + 1; }
    ret n;
}

pub fun frame_cmd_bytes(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, pagezero: bool) usize {
    ret frame_cmd_count(dyn, segs, seg_count, pagezero)::usize * format.SEGMENT_CMD_64_SIZE
        + frame_sect_total(segs, seg_count)::usize * format.SECTION_64_SIZE;
}

pub fun frame_sect_total(segs: *of.LoadSegment, seg_count: u32) u32 {
    var n:  u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        n  = n + segs[li].section_count;
        li = li + 1;
    }
    ret n;
}

fun group_sect_count(segs: *of.LoadSegment, first: u32, last: u32) u32 {
    var n: u32 = 0;
    var m: u32 = first;
    for (m <= last) {
        n = n + segs[m].section_count;
        m = m + 1;
    }
    ret n;
}

fun exec_sectname(itn: *intern.Interner, sec: *of.LoadSection) res[str, fail.Fail] {
    val nm:     str      = bin.resolve_name(itn, sec.name);
    val canon:  opt[str] = of.canonical_section_name(sec.kind);
    val native: opt[str] = format.macho_sectname(sec.kind);
    if (sel canon.none)             { ret res[str, fail.Fail].err{fail.message("macho: load section kind is outside the SectionKind catalog")}; }
    if (sel native.none)            { ret res[str, fail.Fail].err{fail.message("macho: load section kind is outside the SectionKind catalog")}; }
    if (nm == nil)                  { ret res[str, fail.Fail].ok{native.some}; }
    if (str_equals(nm, canon.some)) { ret res[str, fail.Fail].ok{native.some}; }
    ret res[str, fail.Fail].ok{nm};
}

fun write_load_sections(buf: *u8, off: usize, itn: *intern.Interner, seg: *of.LoadSegment,
    segname: str, fileoff: usize) res[usize, fail.Fail] {
    var w: usize = off;
    var i: u32   = 0;
    for (i < seg.section_count) {
        val sec:  *of.LoadSection = ?seg.sections[i];
        var soff: u32             = 0;
        if (sec.kind != of.SK_BSS) { soff = (fileoff + sec.offset::usize)::u32; }
        val sectname: res[str, fail.Fail] = exec_sectname(itn, sec);
        if (sel sectname.err) { ret res[usize, fail.Fail].err{sectname.err}; }
        val flags: res[u32, fail.Fail] = exec_section_flags(sec);
        if (sel flags.err) { ret res[usize, fail.Fail].err{flags.err}; }
        w = write_section_64(buf, w, sectname.ok, segname,
            seg.vaddr + sec.offset::u64, sec.len::u64, soff,
            sec.align, flags.ok);
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

pub fun write_frame_cmds(buf: *u8, fp: *plan.FilePlan, lc: usize, itn: *intern.Interner, dyn: *of.DynamicInfo,
    segs: *of.LoadSegment, seg_count: u32, seg_offsets: *usize,
    pagezero_size: u64, text_va: u64, hdr_span: usize, exec_page: u64) res[usize, fail.Fail] {
    var off: usize = lc;
    if (pagezero_size > 0) {
        off = write_segment_cmd(buf, off, "__PAGEZERO", 0, pagezero_size, 0, 0, 0, 0, 0);
    }
    if (seg_count == 0) { ret res[usize, fail.Fail].ok{off}; }

    val text_prot: u32                 = segment.seg_vm_prot(dyn, segs, 0);
    val text_vm:   res[u64, fail.Fail] = plan.align_address(fp, "__TEXT", hdr_span::u64 + segs[0].memsz::u64, exec_page);
    if (sel text_vm.err) { ret res[usize, fail.Fail].err{text_vm.err}; }
    var tsec: usize = write_segment_cmd(buf, off, "__TEXT", text_va,
        text_vm.ok,
        0, hdr_span::u64 + segs[0].filesz::u64, text_prot, text_prot,
        segs[0].section_count);
    if (segment.seg_is_data_const(dyn, segs, 0)) { bin.write_u32_le(buf, off + 68, format.SG_READ_ONLY); }
    val text_written: res[usize, fail.Fail] = write_load_sections(buf, tsec, itn, ?segs[0], "__TEXT", seg_offsets[0]);
    if (sel text_written.err) { ret text_written; }
    off = text_written.ok;

    var li: u32 = 1;
    for (li < seg_count) {
        val last:    u32 = segment.seg_group_last(dyn, segs, seg_count, li);
        val prot:    u32 = segment.seg_vm_prot(dyn, segs, li);
        val gname:   str = segment.exec_segname(segs[li].flags, segment.seg_is_data_const(dyn, segs, li));
        var grp_fsz: u64 = 0;
        var m:       u32 = li;
        for (m <= last) {
            if (segs[m].filesz > 0) { grp_fsz = (seg_offsets[m] + segs[m].filesz - seg_offsets[li])::u64; }
            m = m + 1;
        }
        val grp_vm: res[u64, fail.Fail] = plan.align_address(fp, gname, segs[last].vaddr + segs[last].memsz::u64 - segs[li].vaddr, exec_page);
        if (sel grp_vm.err) { ret res[usize, fail.Fail].err{grp_vm.err}; }
        val grp_vmsz: u64 = grp_vm.ok;

        var lsec: usize = write_segment_cmd(buf, off, gname, segs[li].vaddr, grp_vmsz,
            seg_offsets[li]::u64, grp_fsz, prot, prot,
            group_sect_count(segs, li, last));
        if (segment.seg_is_data_const(dyn, segs, li)) { bin.write_u32_le(buf, off + 68, format.SG_READ_ONLY); }
        m = li;
        for (m <= last) {
            val written: res[usize, fail.Fail] = write_load_sections(buf, lsec, itn, ?segs[m], gname, seg_offsets[m]);
            if (sel written.err) { ret written; }
            lsec = written.ok;
            m    = m + 1;
        }
        off = lsec;
        li  = last + 1;
    }
    ret res[usize, fail.Fail].ok{off};
}

# an LC_UUID whose payload is filled by seal_build_id once the image is complete
pub fun write_uuid_cmd(buf: *u8, lc: usize) usize {
    bin.write_u32_le(buf, lc, format.LC_UUID);
    bin.write_u32_le(buf, lc + 4, format.UUID_CMD_SIZE::u32);
    ret lc + 8;
}

# tests: the declared load-section flags, or the all-ones word for a refused kind
fun t_exec_section_flags(sec: *of.LoadSection) u32 {
    val flags: res[u32, fail.Fail] = exec_section_flags(sec);
    if (sel flags.err) { ret 0xFFFFFFFF; }
    ret flags.ok;
}

test "mach.lang.target.of.macho.loadcmd.exec_section_flags:init_func_type" {
    var sec: of.LoadSection;
    sec.name  = intern.STR_NIL;
    sec.kind  = of.SK_DATA;
    sec.align = 8;
    sec.len   = 8;

    sec.flags = 0;
    if (t_exec_section_flags(?sec) != 0) { ret 1; }

    sec.flags = of.SEC_FLAG_INIT_FUNCS;
    if ((t_exec_section_flags(?sec) & format.SECTION_TYPE) != format.S_MOD_INIT_FUNC_POINTERS) { ret 1; }

    sec.kind  = of.SK_TEXT;
    sec.flags = 0;
    val tf: u32 = t_exec_section_flags(?sec);
    if ((tf & format.S_ATTR_PURE_INSTRUCTIONS) == 0) { ret 1; }
    if ((tf & format.S_ATTR_SOME_INSTRUCTIONS) == 0) { ret 1; }
    if ((tf & format.SECTION_TYPE) != 0)             { ret 1; }

    sec.kind  = of.SK_BSS;
    sec.flags = 0;
    if ((t_exec_section_flags(?sec) & format.SECTION_TYPE) != format.S_ZEROFILL) { ret 1; }

    sec.kind = 255::of.SectionKind;
    val r_5070: res[u32, fail.Fail] = exec_section_flags(?sec);
    if (sel r_5070.ok) { ret 2; }
    ret 0;
}
