pub fun arch_is_arm64(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

pub fun macho_page_size(arch_id: u32) u64 {
    if (arch_is_arm64(arch_id)) { ret 16384; }
    ret 4096;
}

pub fun cpu_type_for(arch_id: u32) res[u32, fail.Fail] {
    if (arch_id == isa.ARCH_X86_64)  { ret res[u32, fail.Fail].ok{CPU_TYPE_X86_64}; }
    if (arch_id == isa.ARCH_AARCH64) { ret res[u32, fail.Fail].ok{CPU_TYPE_ARM64}; }
    ret res[u32, fail.Fail].err{fail.message("macho: unsupported architecture (only x86_64 and arm64)")};
}

pub fun machine_for_arch(arch_id: u32) u32 {
    val r: res[u32, fail.Fail] = cpu_type_for(arch_id);
    if (sel r.err) { ret 0; }
    ret r.ok;
}

pub fun cpu_subtype_for(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret CPU_SUBTYPE_ARM64_ALL; }
    ret CPU_SUBTYPE_X86_64_ALL;
}

pub rec MachoReloc {
    r_type: u32;
    pcrel:  u32;
    length: u32;
}

pub fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret of.reloc_kind_rejection(itn, alloc, kind, "macho");
}

pub fun macho_reloc_for(itn: *intern.Interner, alloc: *A.Allocator, arch_id: u32, kind: of.RelocKind) res[MachoReloc, fail.Fail] {
    var r: MachoReloc;
    if (arch_is_arm64(arch_id)) {
        if (kind == of.RK_ABS64) {
            r.r_type = ARM64_RELOC_UNSIGNED;
            r.pcrel  = 0;
            r.length = 3;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_PLT32) {
            r.r_type = ARM64_RELOC_BRANCH26;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_JUMP26) {
            r.r_type = ARM64_RELOC_BRANCH26;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_PAGE21) {
            r.r_type = ARM64_RELOC_PAGE21;
            r.pcrel  = 1;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_ADD_LO12) {
            r.r_type = ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST8_LO12) {
            r.r_type = ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST16_LO12) {
            r.r_type = ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST32_LO12) {
            r.r_type = ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST64_LO12) {
            r.r_type = ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_LDST128_LO12) {
            r.r_type = ARM64_RELOC_PAGEOFF12;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        if (kind == of.RK_ABS32) {
            r.r_type = ARM64_RELOC_UNSIGNED;
            r.pcrel  = 0;
            r.length = 2;
            ret res[MachoReloc, fail.Fail].ok{r};
        }
        ret res[MachoReloc, fail.Fail].err{fail.message(unsupported_kind_message(itn, alloc, kind))};
    }
    if (kind == of.RK_ABS64) {
        r.r_type = X86_64_RELOC_UNSIGNED;
        r.pcrel  = 0;
        r.length = 3;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_PC32) {
        r.r_type = X86_64_RELOC_SIGNED;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_PLT32) {
        r.r_type = X86_64_RELOC_BRANCH;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_GOTPCREL) {
        r.r_type = X86_64_RELOC_GOT_LOAD;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_GOTPCREL_NORELAX) {
        r.r_type = X86_64_RELOC_GOT;
        r.pcrel  = 1;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        r.r_type = X86_64_RELOC_GOT;
        r.pcrel  = 1;
        r.length = 3;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    if (kind == of.RK_ABS32) {
        r.r_type = X86_64_RELOC_UNSIGNED;
        r.pcrel  = 0;
        r.length = 2;
        ret res[MachoReloc, fail.Fail].ok{r};
    }
    ret res[MachoReloc, fail.Fail].err{fail.message(unsupported_kind_message(itn, alloc, kind))};
}

pub fun write_reloc_info(buf: *u8, off: usize, address: u32, symnum: u32, pcrel: u32, length: u32, extn: u32, r_type: u32) {
    bin.write_u32_le(buf, off, address);
    bin.write_u32_le(buf, off + 4, (symnum & 0xFFFFFF) | (pcrel << 24) | (length << 25)
        | (extn << 27) | (r_type << 28));
}

pub fun write_nlist(buf: *u8, sym_off: usize, str_base: usize, str_pos: *usize,
    img: *of.ObjectImage, idx: u32, sec_addr: *u64, sec_out: *u32) {
    val sym:      *of.Symbol = ?img.symbols[idx];
    val name:     str        = bin.resolve_name(img.interner, sym.name);
    var n_strx:   u32        = 0;
    val name_pos: usize      = @str_pos;
    if (name != nil) {
        val sp: usize = name_pos;
        n_strx   = sp::u32;
        @str_pos = name_pos + bin.write_str(buf, str_base + name_pos, name);
    }
    or {
        buf[str_base + name_pos] = 0;
        @str_pos                 = name_pos + 1;
    }
    bin.write_u32_le(buf, sym_off, n_strx);

    var n_type:  u8  = N_UNDF;
    var n_sect:  u8  = 0;
    var n_desc:  u16 = 0;
    var n_value: u64 = 0;
    if (!of.section_is_external(sym.section) && of.section_index(sym.section) < img.section_count) {
        n_type  = N_SECT;
        n_sect  = (sec_out[of.section_index(sym.section)] + 1)::u8;
        n_value = sec_addr[of.section_index(sym.section)] + sym.offset::u64;
        if ((sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0) { n_desc = N_WEAK_DEF; }
    }
    or ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0) {
        n_desc = REFERENCE_FLAG_UNDEFINED_LAZY;
    }
    if (of.section_is_external(sym.section) && (sym.flags & of.SYM_OBJ_FLAG_WEAK) != 0) { n_desc = n_desc | N_WEAK_REF; }
    if ((sym.flags & of.SYM_OBJ_FLAG_COMMON) != 0) {
        n_value = sym.size::u64;
        n_desc  = n_desc | (align_log2(sym.align)::u16 << 8);
    }
    if (of.section_is_absolute(sym.section)) {
        n_type  = N_ABS;
        n_value = sym.absolute_value;
    }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 || of.section_is_external(sym.section)) {
        n_type = n_type | N_EXT;
    }
    if (sym.native.format == of.OF_MACHO) {
        n_type = n_type | (sym.native.kind::u8 & ~(N_TYPE | N_EXT));
        n_desc = sym.native.flags::u16;
    }
    buf[sym_off + 4] = n_type;
    buf[sym_off + 5] = n_sect;
    bin.write_u16_le(buf, sym_off + 6, n_desc);
    bin.write_u64_le(buf, sym_off + 8, n_value);
}

pub fun align_log2(align: u32) u32 {
    if (align <= 1) { ret 0; }
    var a:     u32 = align;
    var shift: u32 = 0;
    for (a > 1) {
        a     = a >> 1;
        shift = shift + 1;
    }
    ret shift;
}

pub fun write_fixed16(buf: *u8, off: usize, s: str) {
    var k: usize = 0;
    for (k < 16) {
        buf[off + k] = 0;
        k            = k + 1;
    }
    if (s == nil) { ret; }
    val n: usize = str_len(s);
    k = 0;
    for (k < n && k < 16) {
        buf[off + k] = s[k];
        k            = k + 1;
    }
}

pub fun fixed16_equals(buf: *u8, off: usize, s: str) bool {
    var k: usize = 0;
    val n: usize = str_len(s);
    for (k < 16) {
        var expected: u8 = 0;
        if (k < n)                    { expected = s[k]; }
        if (buf[off + k] != expected) { ret false; }
        k = k + 1;
    }
    ret true;
}

pub fun write_dwarf_sectname(buf: *u8, off: usize, name: str) {
    if (name != nil && str_len(name) >= 1 && name[0] == '.') {
        write_fixed16(buf, off, "__");
        val n: usize = str_len(name);
        var k: usize = 1;
        for (k < n && k < 15) {
            buf[off + 1 + k] = name[k];
            k                = k + 1;
        }
        ret;
    }
    write_fixed16(buf, off, name);
}

pub fun align8(value: usize) usize {
    val aligned: res[usize, fail.Fail] = plan.align_bytes(value, 8);
    if (sel aligned.err) {
        panic("macho: a bounded value overflowed its 8-byte round-up\n");
        ret 0;
    }
    ret aligned.ok;
}

pub fun dylinker_cmd_size() usize {
    ret align8(DYLINKER_CMD_BASE + str_len(DARWIN_DYLD_PATH) + 1);
}

pub fun dylib_cmd_size(name: str) usize {
    var n: usize = 0;
    if (name != nil) { n = str_len(name); }
    ret align8(DYLIB_CMD_BASE + n + 1);
}

pub fun rpath_cmd_size(name: str) usize {
    var n: usize = 0;
    if (name != nil) { n = str_len(name); }
    ret align8(RPATH_CMD_BASE + n + 1);
}

pub fun write_load_dylinker(buf: *u8, off: usize) usize {
    val sz: usize = dylinker_cmd_size();
    bin.write_u32_le(buf, off, LC_LOAD_DYLINKER);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, DYLINKER_CMD_BASE::u32);
    bin.write_str(buf, off + DYLINKER_CMD_BASE, DARWIN_DYLD_PATH);
    ret off + sz;
}

pub fun write_load_dylib(buf: *u8, off: usize, name: str) usize {
    val sz: usize = dylib_cmd_size(name);
    bin.write_u32_le(buf, off, LC_LOAD_DYLIB);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, DYLIB_CMD_BASE::u32);
    bin.write_u32_le(buf, off + 12, 0);
    bin.write_u32_le(buf, off + 16, 0x10000);
    bin.write_u32_le(buf, off + 20, 0x10000);
    bin.write_str(buf, off + DYLIB_CMD_BASE, name);
    ret off + sz;
}

pub fun write_rpath(buf: *u8, off: usize, name: str) usize {
    val sz: usize = rpath_cmd_size(name);
    bin.write_u32_le(buf, off, LC_RPATH);
    bin.write_u32_le(buf, off + 4, sz::u32);
    bin.write_u32_le(buf, off + 8, RPATH_CMD_BASE::u32);
    bin.write_str(buf, off + RPATH_CMD_BASE, name);
    ret off + sz;
}

pub fun rpath_seen_before(libs: *of.DynLib, end: u32, rpath: intern.StrId) bool {
    var i: u32 = 0;
    for (i < end) {
        if (libs[i].rpath == rpath) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun write_unixthread(buf: *u8, off: usize, arch_id: u32, entry: u64, cmd_size: usize) usize {
    bin.write_u32_le(buf, off, LC_UNIXTHREAD);
    bin.write_u32_le(buf, off + 4, cmd_size::u32);
    if (arch_is_arm64(arch_id)) {
        bin.write_u32_le(buf, off + 8, ARM_THREAD_STATE64);
        bin.write_u32_le(buf, off + 12, ARM_THREAD_STATE64_COUNT);
        bin.write_u64_le(buf, off + 16 + ARM_PC_STATE_OFFSET, entry);
    }
    or {
        bin.write_u32_le(buf, off + 8, X86_THREAD_STATE64);
        bin.write_u32_le(buf, off + 12, X86_THREAD_STATE64_COUNT);
        bin.write_u64_le(buf, off + 16 + X86_RIP_STATE_OFFSET, entry);
    }
    ret off + cmd_size;
}

pub fun write_segment_cmd(buf: *u8, off: usize, name: str, vmaddr: u64, vmsize: u64,
    fileoff: u64, filesize: u64, maxprot: u32, initprot: u32, nsects: u32) usize {
    bin.write_u32_le(buf, off, LC_SEGMENT_64);
    bin.write_u32_le(buf, off + 4, (SEGMENT_CMD_64_SIZE + nsects::usize * SECTION_64_SIZE)::u32);
    write_fixed16(buf, off + 8, name);
    bin.write_u64_le(buf, off + 24, vmaddr);
    bin.write_u64_le(buf, off + 32, vmsize);
    bin.write_u64_le(buf, off + 40, fileoff);
    bin.write_u64_le(buf, off + 48, filesize);
    bin.write_u32_le(buf, off + 56, maxprot);
    bin.write_u32_le(buf, off + 60, initprot);
    bin.write_u32_le(buf, off + 64, nsects);
    bin.write_u32_le(buf, off + 68, 0);
    ret off + SEGMENT_CMD_64_SIZE;
}

pub fun write_section_64(buf: *u8, off: usize, sectname: str, segname: str, addr: u64, size: u64,
    fileoff: u32, align: u32, flags: u32) usize {
    write_fixed16(buf, off, sectname);
    write_fixed16(buf, off + 16, segname);
    bin.write_u64_le(buf, off + 32, addr);
    bin.write_u64_le(buf, off + 40, size);
    bin.write_u32_le(buf, off + 48, fileoff);
    bin.write_u32_le(buf, off + 52, align_log2(align));
    bin.write_u32_le(buf, off + 56, 0);
    bin.write_u32_le(buf, off + 60, 0);
    bin.write_u32_le(buf, off + 64, flags);
    bin.write_u32_le(buf, off + 68, 0);
    bin.write_u32_le(buf, off + 72, 0);
    bin.write_u32_le(buf, off + 76, 0);
    ret off + SECTION_64_SIZE;
}

pub fun write_uuid_cmd(buf: *u8, lc: usize) usize {
    bin.write_u32_le(buf, lc, LC_UUID);
    bin.write_u32_le(buf, lc + 4, UUID_CMD_SIZE::u32);
    ret lc + 8;
}

pub fun seal_build_id(buf: *u8, code_limit: usize, uuid_off: usize) err[fail.Fail] {
    if (uuid_off + buildid.UUID_LEN > code_limit) { ret err[fail.Fail].err{fail.message("macho: LC_UUID lies outside the signed range")}; }
    var k: usize = 0;
    for (k < buildid.UUID_LEN) {
        if (buf[uuid_off + k] != 0) { ret err[fail.Fail].err{fail.message("macho: LC_UUID was written before the image was sealed")}; }
        k = k + 1;
    }
    var digest: [32]u8;
    sha256.hash(buf, code_limit, ?digest[0]);
    buildid.uuid_from_digest(?digest[0], (buf::usize + uuid_off)::*u8);
    ret err[fail.Fail].ok{};
}

pub fun codesign_ident_len(name: *u8) usize {
    if (name == nil) { ret 0; }
    ret str_len(name::str);
}

pub fun codesign_code_slots(code_limit: usize) usize {
    ret (code_limit + CODE_SIG_PAGE_SIZE - 1) / CODE_SIG_PAGE_SIZE;
}

pub fun codedir_blob_size(ident_len: usize, code_limit: usize) usize {
    ret CODEDIR_HEADER_SIZE + ident_len + 1 + codesign_code_slots(code_limit) * CS_HASH_SIZE_SHA256::usize;
}

pub fun code_signature_size(ident_len: usize, code_limit: usize) usize {
    ret SUPERBLOB_HEADER_SIZE + codedir_blob_size(ident_len, code_limit);
}

pub fun write_code_signature(buf: *u8, sig_off: usize, name: *u8, code_limit: usize,
    exec_base: u64, exec_limit: u64) usize {
    val ident_len: usize = codesign_ident_len(name);
    val n_slots:   usize = codesign_code_slots(code_limit);
    val cdir_size: usize = codedir_blob_size(ident_len, code_limit);
    val total_sz:  usize = code_signature_size(ident_len, code_limit);

    bin.write_u32_be(buf, sig_off, CSMAGIC_EMBEDDED_SIGNATURE);
    bin.write_u32_be(buf, sig_off + 4, total_sz::u32);
    bin.write_u32_be(buf, sig_off + 8, 1);
    bin.write_u32_be(buf, sig_off + 12, CSSLOT_CODEDIRECTORY);
    bin.write_u32_be(buf, sig_off + 16, SUPERBLOB_HEADER_SIZE::u32);

    val cd_off: usize = sig_off + SUPERBLOB_HEADER_SIZE;
    bin.write_u32_be(buf, cd_off, CSMAGIC_CODEDIRECTORY);
    bin.write_u32_be(buf, cd_off + 4, cdir_size::u32);
    bin.write_u32_be(buf, cd_off + 8, CS_CODEDIRECTORY_VERSION);
    bin.write_u32_be(buf, cd_off + 12, CS_ADHOC_FLAG | CS_LINKER_SIGNED_FLAG);
    val hashes_rel: usize = CODEDIR_HEADER_SIZE + ident_len + 1;
    bin.write_u32_be(buf, cd_off + 16, hashes_rel::u32);
    bin.write_u32_be(buf, cd_off + 20, CODEDIR_HEADER_SIZE::u32);
    bin.write_u32_be(buf, cd_off + 24, 0);
    bin.write_u32_be(buf, cd_off + 28, n_slots::u32);
    bin.write_u32_be(buf, cd_off + 32, code_limit::u32);
    buf[cd_off + 36] = CS_HASH_SIZE_SHA256;
    buf[cd_off + 37] = CS_HASHTYPE_SHA256;
    buf[cd_off + 38] = 0;
    buf[cd_off + 39] = CS_PAGE_SHIFT;
    bin.write_u32_be(buf, cd_off + 40, 0);
    bin.write_u32_be(buf, cd_off + 44, 0);
    bin.write_u32_be(buf, cd_off + 48, 0);
    bin.write_u32_be(buf, cd_off + 52, 0);
    bin.write_u64_be(buf, cd_off + 56, exec_base);
    bin.write_u64_be(buf, cd_off + 64, exec_limit);
    bin.write_u64_be(buf, cd_off + 72, CS_EXECSEG_MAIN_BINARY);
    bin.write_u64_be(buf, cd_off + 80, 0);

    var k: usize = 0;
    if (name != nil) {
        for (k < ident_len) {
            buf[cd_off + CODEDIR_HEADER_SIZE + k] = name[k];
            k                                     = k + 1;
        }
    }
    buf[cd_off + CODEDIR_HEADER_SIZE + k] = 0;

    val hash_base: usize = cd_off + hashes_rel;
    var slot:      usize = 0;
    for (slot < n_slots) {
        val page_start: usize = slot * CODE_SIG_PAGE_SIZE;
        var page_len:   usize = CODE_SIG_PAGE_SIZE;
        if (page_start + page_len > code_limit) { page_len = code_limit - page_start; }
        sha256.hash((buf::usize + page_start)::*u8, page_len, (buf::usize + hash_base + slot * CS_HASH_SIZE_SHA256::usize)::*u8);
        slot = slot + 1;
    }
    ret total_sz;
}

pub rec MachoDwarf {
    present:  bool;
    seg_foff: usize;
    seg_size: usize;
    sec_rows: *u32;
}

pub fun macho_dwarf_cmd_bytes(debug_count: u32) usize {
    if (debug_count == 0) { ret 0; }
    ret SEGMENT_CMD_64_SIZE + debug_count::usize * SECTION_64_SIZE;
}

pub fun debug_align(sec: *of.Section) usize {
    if (sec.align == 0) { ret 1; }
    ret sec.align::usize;
}

pub fun macho_dwarf_plan(alloc: *A.Allocator, fp: *plan.FilePlan, debug: *of.Section, debug_count: u32,
    segment_align: usize) res[MachoDwarf, fail.Fail] {
    var d: MachoDwarf;
    d.present  = false;
    d.seg_foff = 0;
    d.seg_size = 0;
    d.sec_rows = nil;
    if (debug_count == 0) { ret res[MachoDwarf, fail.Fail].ok{d}; }

    val ro: res[*u32, A.Error] = A.zallocate[u32](alloc, debug_count::usize);
    if (sel ro.err) { ret res[MachoDwarf, fail.Fail].err{fail.refused(ro.err)}; }
    d.sec_rows = ro.ok;

    val padded: err[fail.Fail] = plan.pad(fp, "__DWARF segment", segment_align);
    if (sel padded.err) {
        macho_dwarf_free(alloc, ?d, debug_count);
        ret res[MachoDwarf, fail.Fail].err{padded.err};
    }
    d.seg_foff = plan.cursor(fp);
    var di: u32 = 0;
    for (di < debug_count) {
        val row: res[u32, fail.Fail] = plan.place(fp, "debug section", of.section_id(di), debug_align(?debug[di]), debug[di].len::usize);
        if (sel row.err) {
            macho_dwarf_free(alloc, ?d, debug_count);
            ret res[MachoDwarf, fail.Fail].err{row.err};
        }
        d.sec_rows[di] = row.ok;
        di             = di + 1;
    }
    d.present  = true;
    d.seg_size = plan.cursor(fp) - d.seg_foff;
    ret res[MachoDwarf, fail.Fail].ok{d};
}

pub fun macho_dwarf_write(buf: *u8, itn: *intern.Interner, fp: *plan.FilePlan, debug: *of.Section, debug_count: u32,
    lc: usize, d: *MachoDwarf, vmaddr: u64) res[usize, fail.Fail] {
    if (!d.present) { ret res[usize, fail.Fail].ok{lc}; }
    val cmdsize: usize = macho_dwarf_cmd_bytes(debug_count);
    bin.write_u32_le(buf, lc, LC_SEGMENT_64);
    bin.write_u32_le(buf, lc + 4, cmdsize::u32);
    write_fixed16(buf, lc + 8, "__DWARF");
    bin.write_u64_le(buf, lc + 24, vmaddr);
    bin.write_u64_le(buf, lc + 32, 0);
    bin.write_u64_le(buf, lc + 40, d.seg_foff::u64);
    bin.write_u64_le(buf, lc + 48, d.seg_size::u64);
    bin.write_u32_le(buf, lc + 56, 0);
    bin.write_u32_le(buf, lc + 60, 0);
    bin.write_u32_le(buf, lc + 64, debug_count);
    bin.write_u32_le(buf, lc + 68, SG_NORELOC);

    var sh: usize = lc + SEGMENT_CMD_64_SIZE;
    var di: u32   = 0;
    for (di < debug_count) {
        write_dwarf_sectname(buf, sh, bin.resolve_name(itn, debug[di].name));
        write_fixed16(buf, sh + 16, "__DWARF");
        bin.write_u64_le(buf, sh + 32, 0);
        bin.write_u64_le(buf, sh + 40, debug[di].len::u64);
        val offset_field: res[u32, fail.Fail] = plan.field_u32(fp, plan.offset(fp, d.sec_rows[di]), "debug section offset");
        if (sel offset_field.err) { ret res[usize, fail.Fail].err{offset_field.err}; }
        bin.write_u32_le(buf, sh + 48, offset_field.ok);
        bin.write_u32_le(buf, sh + 52, align_log2(debug[di].align));
        bin.write_u32_le(buf, sh + 56, 0);
        bin.write_u32_le(buf, sh + 60, 0);
        bin.write_u32_le(buf, sh + 64, S_ATTR_DEBUG);
        bin.write_u32_le(buf, sh + 68, 0);
        bin.write_u32_le(buf, sh + 72, 0);
        bin.write_u32_le(buf, sh + 76, 0);
        sh = sh + SECTION_64_SIZE;
        di = di + 1;
    }
    if (sh != lc + cmdsize) { ret res[usize, fail.Fail].err{fail.message("macho: __DWARF section commands drifted from their plan")}; }
    ret res[usize, fail.Fail].ok{sh};
}

pub fun macho_dwarf_write_bytes(buf: *u8, fp: *plan.FilePlan, debug: *of.Section, debug_count: u32, d: *MachoDwarf) {
    if (!d.present) { ret; }
    var di: u32 = 0;
    for (di < debug_count) {
        if (debug[di].bytes != nil && debug[di].len > 0) {
            memory.raw_copy((buf::usize + plan.offset(fp, d.sec_rows[di]))::ptr, debug[di].bytes::ptr, debug[di].len::usize);
        }
        di = di + 1;
    }
}

pub fun macho_dwarf_free(alloc: *A.Allocator, d: *MachoDwarf, debug_count: u32) {
    if (d.sec_rows != nil) { A.deallocate[u32](alloc, d.sec_rows, debug_count::usize); }
    d.sec_rows = nil;
}

pub fun header_span(shape: *of.HeaderShape, page: u64) u64 {
    if (shape == nil) { ret page; }

    var seg_cmds:   u32 = shape.seg_count + 2;
    var sect_total: u32 = shape.sect_count;
    if (shape.imports) {
        seg_cmds   = seg_cmds + 2;
        sect_total = sect_total + 2;
    }

    var entry_cmd: usize = 16 + ARM_THREAD_STATE64_COUNT::usize * 4;
    if (16 + X86_THREAD_STATE64_COUNT::usize * 4 > entry_cmd) {
        entry_cmd = 16 + X86_THREAD_STATE64_COUNT::usize * 4;
    }
    if (ENTRY_POINT_CMD_SIZE > entry_cmd) { entry_cmd = ENTRY_POINT_CMD_SIZE; }

    var size: usize = MACH_HEADER_64_SIZE
        + seg_cmds::usize * SEGMENT_CMD_64_SIZE
        + sect_total::usize * SECTION_64_SIZE
        + DYLD_INFO_CMD_SIZE + SYMTAB_CMD_SIZE + DYSYMTAB_CMD_SIZE
        + dylinker_cmd_size() + entry_cmd + LINKEDIT_DATA_CMD_SIZE
        + BUILD_VERSION_CMD_SIZE + UUID_CMD_SIZE
        + macho_dwarf_cmd_bytes(shape.debug_count);

    var i: u32 = 0;
    for (i < shape.lib_count) {
        size = size + dylib_cmd_size(bin.resolve_name(shape.itn, shape.libs[i].soname));
        if (shape.libs[i].rpath != intern.STR_NIL
            && !rpath_seen_before(shape.libs, i, shape.libs[i].rpath)) {
            size = size + rpath_cmd_size(bin.resolve_name(shape.itn, shape.libs[i].rpath));
        }
        i = i + 1;
    }

    val rounded: res[u64, layout.CheckCause] = layout.align_u64_up(size::u64, page);
    if (sel rounded.err) { ret page; }
    ret rounded.ok;
}

pub fun reserved_header_span(segs: *of.LoadSegment, seg_count: u32,
    image_base: u64) res[usize, fail.Fail] {
    if (seg_count == 0 || segs == nil) {
        ret res[usize, fail.Fail].err{fail.message("macho: image has no load segments to map the header into")};
    }
    if (segs[0].vaddr <= image_base) {
        ret res[usize, fail.Fail].err{fail.message("macho: base address too low to map the header")};
    }
    ret res[usize, fail.Fail].ok{(segs[0].vaddr - image_base)::usize};
}

pub fun refuse_unixthread_stack(opts: *of.ImageOptions) err[fail.Fail] {
    if (opts.stack_reserve == 0 && opts.stack_commit == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.message("macho: a stack size needs an LC_MAIN entry, and this image enters through LC_UNIXTHREAD; `stack_reserve` / `stack_commit` reach only a position-independent Mach-O image")};
}

pub rec SegmentRows {
    rows:    *u32;
    offsets: *usize;
}

pub fun segment_rows_free(alloc: *A.Allocator, s: *SegmentRows, seg_count: u32) {
    if (s.rows != nil)    { A.deallocate[u32](alloc, s.rows, seg_count::usize); }
    if (s.offsets != nil) { A.deallocate[usize](alloc, s.offsets, seg_count::usize); }
    s.rows    = nil;
    s.offsets = nil;
}

pub fun place_segments(alloc: *A.Allocator, fp: *plan.FilePlan, segs: *of.LoadSegment, seg_count: u32,
    hdr_span: usize, page: usize, first_at_span: bool) res[SegmentRows, fail.Fail] {
    var out: SegmentRows;
    out.rows    = nil;
    out.offsets = nil;
    val rr: res[*u32, A.Error] = A.zallocate[u32](alloc, seg_count::usize);
    if (sel rr.err) { ret res[SegmentRows, fail.Fail].err{fail.message("macho: exec offset table alloc failed")}; }
    out.rows = rr.ok;
    val ro: res[*usize, A.Error] = A.zallocate[usize](alloc, seg_count::usize);
    if (sel ro.err) {
        segment_rows_free(alloc, ?out, seg_count);
        ret res[SegmentRows, fail.Fail].err{fail.message("macho: exec offset table alloc failed")};
    }
    out.offsets = ro.ok;

    val reserved: err[fail.Fail] = plan.pad_to(fp, "header reservation", hdr_span);
    if (sel reserved.err) {
        segment_rows_free(alloc, ?out, seg_count);
        ret res[SegmentRows, fail.Fail].err{reserved.err};
    }
    var li: u32 = 0;
    for (li < seg_count) {
        var align: usize = page;
        if (li == 0 && first_at_span) { align = 1; }
        val row: res[u32, fail.Fail] = plan.place(fp, "load segment", of.no_section(), align, segs[li].filesz);
        if (sel row.err) {
            segment_rows_free(alloc, ?out, seg_count);
            ret res[SegmentRows, fail.Fail].err{row.err};
        }
        out.rows[li]    = row.ok;
        out.offsets[li] = plan.offset(fp, out.rows[li]);
        li              = li + 1;
    }
    ret res[SegmentRows, fail.Fail].ok{out};
}

pub fun add_u64_mod(a: u64, b: u64) u64 {
    val max: u64 = 0xFFFFFFFFFFFFFFFF;
    if (a > max - b) { ret a - (max - b) - 1; }
    ret a + b;
}

pub fun indirect_slots(section: *of.Section) res[u32, fail.Fail] {
    if (section.native.format != of.OF_MACHO) { ret res[u32, fail.Fail].ok{0}; }
    val kind:   u32 = section.native.flags::u32 & SECTION_TYPE;
    var stride: u32 = 0;
    if (kind == 6 || kind == 7 || kind == 0x10 || kind == 0x14) { stride = 8; }
    or (kind == 8) {
        stride = section.native.reserved2;
        if (stride == 0) { ret res[u32, fail.Fail].err{fail.message("macho: symbol stub has zero stride")}; }
    }
    if (stride == 0)               { ret res[u32, fail.Fail].ok{0}; }
    if (section.len % stride != 0) { ret res[u32, fail.Fail].err{fail.message("macho: indirect section has an incomplete slot")}; }
    ret res[u32, fail.Fail].ok{section.len / stride};
}

pub rec MachoSectionDesc {
    kind:     of.SectionKind;
    segname:  str;
    sectname: str;
    flags:    u32;
}

pub val MACHO_SECTIONS: [of.SK_COUNT]MachoSectionDesc = [of.SK_COUNT]MachoSectionDesc{
    MachoSectionDesc{kind: of.SK_TEXT, segname: "__TEXT", sectname: "__text", flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS},
    MachoSectionDesc{kind: of.SK_DATA, segname: "__DATA", sectname: "__data", flags: 0},
    MachoSectionDesc{kind: of.SK_RODATA, segname: "__TEXT", sectname: "__const", flags: 0},
    MachoSectionDesc{kind: of.SK_RELRO, segname: "__DATA_CONST", sectname: "__const", flags: 0},
    MachoSectionDesc{kind: of.SK_BSS, segname: "__DATA", sectname: "__bss", flags: S_ZEROFILL},
    MachoSectionDesc{kind: of.SK_DEBUG, segname: "__DWARF", sectname: "__debug", flags: S_ATTR_DEBUG},
    MachoSectionDesc{kind: of.SK_EXCEPTION, segname: "__DATA", sectname: "__debug", flags: 0},
};

pub fun macho_section(kind: of.SectionKind) opt[*MachoSectionDesc] {
    if (!of.section_kind_valid(kind) || MACHO_SECTIONS[kind::u32].kind != kind) { ret opt[*MachoSectionDesc].none{}; }
    ret opt[*MachoSectionDesc].some{?MACHO_SECTIONS[kind::u32]};
}

pub fun macho_segname(kind: of.SectionKind) opt[str] {
    val desc: opt[*MachoSectionDesc] = macho_section(kind);
    if (sel desc.none) { ret opt[str].none{}; }
    ret opt[str].some{desc.some.segname};
}

pub fun macho_sectname(kind: of.SectionKind) opt[str] {
    val desc: opt[*MachoSectionDesc] = macho_section(kind);
    if (sel desc.none) { ret opt[str].none{}; }
    ret opt[str].some{desc.some.sectname};
}

pub fun macho_section_flags(kind: of.SectionKind) opt[u32] {
    val desc: opt[*MachoSectionDesc] = macho_section(kind);
    if (sel desc.none) { ret opt[u32].none{}; }
    ret opt[u32].some{desc.some.flags};
}

pub fun needs_addend_entry(arch_id: u32, mr: *MachoReloc, addend: i64) bool {
    ret arch_is_arm64(arch_id) && addend != 0 && mr.r_type != ARM64_RELOC_UNSIGNED;
}

pub fun reloc_entries_for_section(img: *of.ObjectImage, sec_idx: u32, arch_id: u32) res[u32, fail.Fail] {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.reloc_count) {
        if (of.section_index(img.relocations[i].section) == sec_idx) {
            n = n + 1;
            if (of.is_difference(img.relocations[i].kind)) {
                n = n + 1;
            }
            or {
                val mr: res[MachoReloc, fail.Fail] = macho_reloc_for(img.interner, img.alloc, arch_id, img.relocations[i].kind);
                if (sel mr.err) { ret res[u32, fail.Fail].err{mr.err}; }
                val resolved: MachoReloc = mr.ok;
                if (needs_addend_entry(arch_id, ?resolved, img.relocations[i].addend)) {
                    n = n + 1;
                }
            }
        }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{n};
}

pub fun reloc_sym_index(img: *of.ObjectImage, r: *of.Relocation) res[u32, fail.Fail] {
    if (r.sym >= img.symbol_count) {
        ret res[u32, fail.Fail].err{fail.message("macho: reloc symbol index out of bounds")};
    }
    ret res[u32, fail.Fail].ok{r.sym};
}

pub fun validate_reloc_symbols(img: *of.ObjectImage) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: res[u32, fail.Fail] = reloc_sym_index(img, ?img.relocations[i]);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        if (of.is_difference(img.relocations[i].kind)) {
            var r2_rel: of.Relocation;
            r2_rel.sym = img.relocations[i].sym2;
            val r2: res[u32, fail.Fail] = reloc_sym_index(img, ?r2_rel);
            if (sel r2.err) { ret err[fail.Fail].err{r2.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun validate_reloc_kinds(img: *of.ObjectImage, arch_id: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val kind: of.RelocKind = img.relocations[i].kind;
        if (of.is_difference(kind)) {
            if (kind != of.RK_DIFF32 && kind != of.RK_DIFF64) {
                ret err[fail.Fail].err{fail.message("macho: difference relocation must be RK_DIFF32 or RK_DIFF64")};
            }
            if (img.relocations[i].sym >= img.symbol_count || img.relocations[i].sym2 >= img.symbol_count) {
                ret err[fail.Fail].err{fail.message("macho: reloc symbol index out of bounds")};
            }
            i = i + 1;
            cnt;
        }
        val r: res[MachoReloc, fail.Fail] = macho_reloc_for(img.interner, img.alloc, arch_id, kind);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun strtab_size(img: *of.ObjectImage) usize {
    var len: usize = 1;
    var i:   u32   = 0;
    for (i < img.symbol_count) {
        val name: str = bin.resolve_name(img.interner, img.symbols[i].name);
        if (name != nil) { len = len + str_len(name) + 1; }
        or               { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

pub fun is_local_sym(sym: *of.Symbol) bool {
    if (of.section_is_external(sym.section))       { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret false; }
    ret true;
}

pub fun is_extdef_sym(sym: *of.Symbol) bool {
    if (of.section_is_external(sym.section))       { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    ret true;
}

pub fun fold_inplace_addend(buf: *u8, field: usize, arch_id: u32, kind: of.RelocKind, addend: i64) {
    if (kind == of.RK_ABS64 || kind == of.RK_DIFF64) {
        if (addend != 0) {
            bin.write_u64_le(buf, field,
                add_u64_mod(bin.read_u64_le(buf, field), addend::u64));
        }
        ret;
    }
    if (kind == of.RK_ABS32 || kind == of.RK_DIFF32) {
        if (addend != 0) { bin.write_u32_le(buf, field, bin.read_u32_le(buf, field) + (addend::u64)::u32); }
        ret;
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        val eff64: u64 = add_u64_mod(addend::u64, 8);
        if (eff64 != 0) {
            bin.write_u64_le(buf, field,
                add_u64_mod(bin.read_u64_le(buf, field), eff64));
        }
        ret;
    }
    if (arch_is_arm64(arch_id)) { ret; }
    val eff: i64 = addend + 4;
    if (eff != 0) { bin.write_u32_le(buf, field, bin.read_u32_le(buf, field) + (eff::u64)::u32); }
}

pub rec MachoOutSec {
    kind:          of.SectionKind;
    srcsec:        u32;
    addr:          u64;
    size:          u64;
    fileo:         usize;
    align:         u32;
    reloff:        usize;
    nrel:          u32;
    indirect_base: u32;
}

pub fun generated_section_group(img: *of.ObjectImage, index: u32) u32 {
    val sec: *of.Section = ?img.sections[index];
    if (sec.native.format != 0 || (sec.flags & of.SEC_FLAG_COALESCE) == 0) { ret index; }
    var i: u32 = 0;
    for (i < index) {
        val prior: *of.Section = ?img.sections[i];
        if (prior.native.format == 0 && prior.flags == sec.flags && prior.kind == sec.kind
            && prior.name == sec.name && prior.align == sec.align) { ret i; }
        i = i + 1;
    }
    ret index;
}

pub fun generated_section_count(img: *of.ObjectImage) res[u32, fail.Fail] {
    var count: u32 = 0;
    var size:  u64 = 0;
    var i:     u32 = 0;
    for (i < img.section_count) {
        val padded: u64 = img.sections[i].len::u64 + img.sections[i].align::u64 - 1;
        if (size > 0xFFFFFFFFFFFFFFFF - padded) { ret res[u32, fail.Fail].err{fail.message("macho: generated section layout overflows")}; }
        size = size + padded;
        if (generated_section_group(img, i) == i) { count = count + 1; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{count};
}

pub fun plan_generated_sections(img: *of.ObjectImage, out: *MachoOutSec, sec_to_out: *u32) {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < img.section_count) {
        val representative: u32 = generated_section_group(img, i);
        if (representative != i) { sec_to_out[i] = sec_to_out[representative]; }
        or {
            out[count].kind   = img.sections[i].kind;
            out[count].srcsec = i;
            sec_to_out[i]     = count;
            count             = count + 1;
        }
        i = i + 1;
    }
}

test "mach.lang.target.of.macho.section_table:every_member_has_its_row_and_no_other_tag_does" {
    var i: u32 = 0;
    for (i < of.SK_COUNT) {
        val desc: opt[*MachoSectionDesc] = macho_section(i::of.SectionKind);
        if (sel desc.none)            { ret 1; }
        if (desc.some.kind::u32 != i) { ret 1; }
        i = i + 1;
    }
    val r_373: opt[*MachoSectionDesc] = macho_section(of.SK_COUNT::of.SectionKind);
    if (sel r_373.some) { ret 2; }
    val r_374: opt[str] = macho_segname(255::of.SectionKind);
    if (sel r_374.some) { ret 3; }
    val r_375: opt[str] = macho_sectname(255::of.SectionKind);
    if (sel r_375.some) { ret 3; }
    val r_376: opt[u32] = macho_section_flags(255::of.SectionKind);
    if (sel r_376.some) { ret 3; }
    ret 0;
}
