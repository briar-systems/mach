use mach.lang.fail;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target.of.macho.loadcmd;
use A: std.allocator;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

val MACH_HEADER_64_SIZE:           usize = loadcmd.MACH_HEADER_64_SIZE;
val MH_MAGIC_64:                   u32   = loadcmd.MH_MAGIC_64;
val LC_SEGMENT_64:                 u32   = loadcmd.LC_SEGMENT_64;
val SEGMENT_CMD_64_SIZE:           usize = loadcmd.SEGMENT_CMD_64_SIZE;
val SECTION_64_SIZE:               usize = loadcmd.SECTION_64_SIZE;
val LC_DYSYMTAB:                   u32   = loadcmd.LC_DYSYMTAB;
val DYSYMTAB_CMD_SIZE:             usize = loadcmd.DYSYMTAB_CMD_SIZE;
val LC_SYMTAB:                     u32   = loadcmd.LC_SYMTAB;
val SYMTAB_CMD_SIZE:               usize = loadcmd.SYMTAB_CMD_SIZE;
val NLIST_64_SIZE:                 usize = loadcmd.NLIST_64_SIZE;
val RELOC_INFO_SIZE:               usize = loadcmd.RELOC_INFO_SIZE;
val SECTION_TYPE:                  u32   = loadcmd.SECTION_TYPE;
val S_MOD_INIT_FUNC_POINTERS:      u32   = loadcmd.S_MOD_INIT_FUNC_POINTERS;
val SECTION_IDENTITY_SIZE:         usize = loadcmd.SECTION_IDENTITY_SIZE;
val ANCHOR_NONE:                   u32   = loadcmd.ANCHOR_NONE;
val S_ZEROFILL:                    u32   = loadcmd.S_ZEROFILL;
val S_ATTR_PURE_INSTRUCTIONS:      u32   = loadcmd.S_ATTR_PURE_INSTRUCTIONS;
val S_ATTR_DEBUG:                  u32   = loadcmd.S_ATTR_DEBUG;
val N_EXT:                         u8    = loadcmd.N_EXT;
val N_WEAK_DEF:                    u16   = loadcmd.N_WEAK_DEF;
val N_WEAK_REF:                    u16   = loadcmd.N_WEAK_REF;
val N_TYPE:                        u8    = loadcmd.N_TYPE;
val N_ABS:                         u8    = loadcmd.N_ABS;
val N_UNDF:                        u8    = loadcmd.N_UNDF;
val REFERENCE_TYPE_MASK:           u16   = loadcmd.REFERENCE_TYPE_MASK;
val REFERENCE_FLAG_UNDEFINED_LAZY: u16   = loadcmd.REFERENCE_FLAG_UNDEFINED_LAZY;
val CPU_TYPE_ARM64:                u32   = loadcmd.CPU_TYPE_ARM64;
val CPU_TYPE_X86_64:               u32   = loadcmd.CPU_TYPE_X86_64;
val ARM64_RELOC_ADDEND:            u32   = loadcmd.ARM64_RELOC_ADDEND;
val ARM64_RELOC_SUBTRACTOR:        u32   = loadcmd.ARM64_RELOC_SUBTRACTOR;
val X86_64_RELOC_SUBTRACTOR:       u32   = loadcmd.X86_64_RELOC_SUBTRACTOR;
val X86_64_RELOC_UNSIGNED:         u32   = loadcmd.X86_64_RELOC_UNSIGNED;
val ARM64_RELOC_UNSIGNED:          u32   = loadcmd.ARM64_RELOC_UNSIGNED;
val ARM64_RELOC_BRANCH26:          u32   = loadcmd.ARM64_RELOC_BRANCH26;
val ARM64_RELOC_PAGE21:            u32   = loadcmd.ARM64_RELOC_PAGE21;
val ARM64_RELOC_PAGEOFF12:         u32   = loadcmd.ARM64_RELOC_PAGEOFF12;
val X86_64_RELOC_SIGNED:           u32   = loadcmd.X86_64_RELOC_SIGNED;
val X86_64_RELOC_SIGNED_1:         u32   = loadcmd.X86_64_RELOC_SIGNED_1;
val X86_64_RELOC_SIGNED_2:         u32   = loadcmd.X86_64_RELOC_SIGNED_2;
val X86_64_RELOC_SIGNED_4:         u32   = loadcmd.X86_64_RELOC_SIGNED_4;
val X86_64_RELOC_BRANCH:           u32   = loadcmd.X86_64_RELOC_BRANCH;
val X86_64_RELOC_GOT_LOAD:         u32   = loadcmd.X86_64_RELOC_GOT_LOAD;
val X86_64_RELOC_GOT:              u32   = loadcmd.X86_64_RELOC_GOT;

use mach.lang.target.of.macho.loadcmd.add_u64_mod;
use mach.lang.target.of.macho.loadcmd.fixed16_equals;
use mach.lang.target.of.macho.loadcmd.indirect_slots;
use mach.lang.target.of.macho.loadcmd.macho_sectname;

pub fun parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < MACH_HEADER_64_SIZE) {
        ret err[fail.Fail].err{fail.message("macho: object too small")};
    }
    if (alloc == nil) { ret err[fail.Fail].err{fail.message("macho: no allocator for parse")}; }
    if (itn == nil)   { ret err[fail.Fail].err{fail.message("macho: no interner for parse")}; }

    var parsed: of.ObjectImage = of.object_image_init(alloc, itn, intern.STR_NIL);
    val built:  err[fail.Fail] = parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (sel built.err) {
        val reason: str = fail.describe(built.err);
        of.object_image_dnit(?parsed);
        ret err[fail.Fail].err{fail.message(reason)};
    }
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(?parsed);
    if (sel valid.err) { ret valid; }
    @out = parsed;
    ret err[fail.Fail].ok{};
}

pub fun parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < MACH_HEADER_64_SIZE) {
        ret err[fail.Fail].err{fail.message("macho: object too small")};
    }
    if (bin.read_u32_le(buf, 0) != MH_MAGIC_64) {
        ret err[fail.Fail].err{fail.message("macho: not a 64-bit Mach-O object (bad magic; expected 0xFEEDFACF)")};
    }
    if (itn == nil) { ret err[fail.Fail].err{fail.message("macho: no interner for parse")}; }

    val cputype: u32 = bin.read_u32_le(buf, 4);
    val ncmds:   u32 = bin.read_u32_le(buf, 16);

    var sec_total:      layout.CheckedCount[of.Section] = layout.count[of.Section](0::usize);
    var symoff:         usize                           = 0;
    var nsyms:          u32                             = 0;
    var stroff:         usize                           = 0;
    var strsize:        usize                           = 0;
    var have_symtab:    bool                            = false;
    var indirect_off:   usize                           = 0;
    var indirect_count: u32                             = 0;
    var have_dysymtab:  bool                            = false;

    var off: usize = MACH_HEADER_64_SIZE;
    var c:   u32   = 0;
    for (c < ncmds) {
        val vc: err[fail.Fail] = bin.require_region(buf_size, off, 8, "macho: load command out of bounds");
        if (sel vc.err) { ret vc; }
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmdsize < 8) { ret err[fail.Fail].err{fail.message("macho: zero-size load command")}; }
        val vfull: err[fail.Fail] = bin.require_region(buf_size, off, cmdsize, "macho: load command out of bounds");
        if (sel vfull.err) { ret vfull; }

        if (cmd == LC_SEGMENT_64) {
            val vseg: err[fail.Fail] = bin.require_region(buf_size, off, SEGMENT_CMD_64_SIZE,
                "macho: segment command out of bounds");
            if (sel vseg.err) { ret vseg; }
            val nsects: u32            = bin.read_u32_le(buf, off + 64);
            val vsects: err[fail.Fail] = bin.require_region(buf_size, off + SEGMENT_CMD_64_SIZE,
                nsects::usize * SECTION_64_SIZE, "macho: segment section headers out of bounds");
            if (sel vsects.err) { ret vsects; }
            val added: res[layout.CheckedCount[of.Section], layout.CheckCause] =
                layout.count_add[of.Section](sec_total, layout.count[of.Section](nsects::usize));
            if (sel added.err) {
                ret err[fail.Fail].err{fail.message("macho: section count exceeds the u32 limit")};
            }
            sec_total = added.ok;
        }
        or (cmd == LC_DYSYMTAB) {
            if (cmdsize < DYSYMTAB_CMD_SIZE || have_dysymtab) {
                ret err[fail.Fail].err{fail.message("macho: malformed or duplicate dynamic symbol command")};
            }
            have_dysymtab  = true;
            indirect_off   = bin.read_u32_le(buf, off + 56)::usize;
            indirect_count = bin.read_u32_le(buf, off + 60);
        }
        or (cmd == LC_SYMTAB) {
            if (cmdsize < SYMTAB_CMD_SIZE || have_symtab) {
                ret err[fail.Fail].err{fail.message("macho: malformed or duplicate symbol command")};
            }
            symoff      = bin.read_u32_le(buf, off + 8)::usize;
            nsyms       = bin.read_u32_le(buf, off + 12);
            stroff      = bin.read_u32_le(buf, off + 16)::usize;
            strsize     = bin.read_u32_le(buf, off + 20)::usize;
            have_symtab = true;
        }
        off = off + cmdsize;
        c   = c + 1;
    }

    val sec_n_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(sec_total.value);
    if (sel sec_n_fits.err) {
        ret err[fail.Fail].err{fail.message("macho: section count exceeds the u32 limit")};
    }
    val sec_n: u32 = sec_n_fits.ok;

    val vi: err[fail.Fail] = bin.require_region(buf_size, indirect_off, indirect_count::usize * 4, "macho: indirect symbol table out of bounds");
    if (sel vi.err) { ret vi; }
    if (have_symtab) {
        val vsy: err[fail.Fail] = bin.require_region(buf_size, symoff, nsyms::usize * NLIST_64_SIZE, "macho: symbol table out of bounds");
        if (sel vsy.err) { ret vsy; }
        val vst: err[fail.Fail] = bin.require_region(buf_size, stroff, strsize, "macho: string table out of bounds");
        if (sel vst.err) { ret vst; }
    }

    if (sec_n > 0) {
        val rsec: res[*of.Section, A.Error] = A.zallocate[of.Section](alloc, sec_n::usize);
        if (sel rsec.err) { ret err[fail.Fail].err{fail.message("macho: section array alloc failed")}; }
        out.sections    = rsec.ok;
        out.section_cap = sec_n;
    }

    var sec_base:   *u64 = nil;
    var sec_anchor: *u32 = nil;
    if (sec_n > 0) {
        val rb: res[*u64, A.Error] = A.zallocate[u64](alloc, sec_n::usize);
        if (sel rb.err) { ret err[fail.Fail].err{fail.message("macho: section base table alloc failed")}; }
        sec_base = rb.ok;
        val ra: res[*u32, A.Error] = A.zallocate[u32](alloc, sec_n::usize);
        if (sel ra.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.message("macho: section anchor table alloc failed")};
        }
        sec_anchor = ra.ok;
    }

    val plan: res[u32, fail.Fail] = plan_section_anchors(buf, buf_size, cputype, ncmds, sec_n, sec_anchor);
    if (sel plan.err) {
        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
        ret err[fail.Fail].err{plan.err};
    }
    val anchor_n: u32 = plan.ok;

    if (nsyms + anchor_n > 0) {
        val rsym: res[*of.Symbol, A.Error] = A.zallocate[of.Symbol](alloc, (nsyms + anchor_n)::usize);
        if (sel rsym.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.message("macho: symbol array alloc failed")};
        }
        out.symbols    = rsym.ok;
        out.symbol_cap = nsyms + anchor_n;
    }
    out.section_count = sec_n;
    out.symbol_count  = nsyms + anchor_n;

    var sec_i: u32 = 0;
    off = MACH_HEADER_64_SIZE;
    c   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val addr:          u64            = bin.read_u64_le(buf, sh + 32);
                val size:          u64            = bin.read_u64_le(buf, sh + 40);
                val sec_off:       usize          = bin.read_u32_le(buf, sh + 48)::usize;
                val align_l:       u32            = bin.read_u32_le(buf, sh + 52);
                val flags:         u32            = bin.read_u32_le(buf, sh + 64);
                val is_text:       bool           = fixed16_equals(buf, sh + 16, "__TEXT");
                val is_data_const: bool           = fixed16_equals(buf, sh + 16, "__DATA_CONST");
                val is_rodata:     bool           = fixed16_equals(buf, sh + 16, "__RODATA");
                val kind:          of.SectionKind = macho_kind_from(flags, is_text, is_data_const, is_rodata);

                var name_buf: [17]u8;
                var ni:       usize = 0;
                for (ni < 16) {
                    name_buf[ni] = buf[sh + ni];
                    ni           = ni + 1;
                }
                name_buf[16] = 0;
                var canon_buf:   [17]u8;
                var canon:       str      = canonical_sectname((?name_buf[0])::str, ?canon_buf[0]);
                val native_name: opt[str] = macho_sectname(kind);
                val canonical:   opt[str] = of.canonical_section_name(kind);
                if (sel native_name.none) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.message(of.section_kind_rejection(itn, alloc, kind))};
                }
                if (sel canonical.none) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.message(of.section_kind_rejection(itn, alloc, kind))};
                }
                if (kind != of.SK_DEBUG && str_equals(canon, native_name.some)) {
                    canon = canonical.some;
                }
                val rin: res[intern.StrId, A.Error] = intern.intern(itn, canon);
                if (sel rin.err) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.refused(rin.err)};
                }

                out.sections[sec_i].name          = rin.ok;
                out.sections[sec_i].kind          = kind;
                out.sections[sec_i].flags         = 0;
                out.sections[sec_i].native.format = of.OF_MACHO;
                out.sections[sec_i].native.flags  = flags::u64;
                memory.raw_copy((?out.sections[sec_i].native.name[0])::ptr, (buf::usize + sh)::ptr, 16);
                memory.raw_copy((?out.sections[sec_i].native.segment[0])::ptr, (buf::usize + sh + 16)::ptr, 16);
                out.sections[sec_i].native.reserved1 = bin.read_u32_le(buf, sh + 68);
                out.sections[sec_i].native.reserved2 = bin.read_u32_le(buf, sh + 72);
                out.sections[sec_i].native.reserved3 = bin.read_u32_le(buf, sh + 76);
                if ((flags & SECTION_TYPE) == S_MOD_INIT_FUNC_POINTERS) {
                    out.sections[sec_i].flags = of.SEC_FLAG_INIT_FUNCS;
                }
                out.sections[sec_i].len   = size::u32;
                out.sections[sec_i].align = (1::u32) << align_l;
                out.sections[sec_i].bytes = nil;
                sec_base[sec_i]           = addr;

                if (sec_anchor[sec_i] != ANCHOR_NONE) {
                    var ident_buf: [SECTION_IDENTITY_SIZE]u8;
                    val ident:     str                        = section_identity(buf, sh, ?ident_buf[0]);
                    val rid:       res[intern.StrId, A.Error] = intern.intern(itn, ident);
                    if (sel rid.err) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret err[fail.Fail].err{fail.refused(rid.err)};
                    }
                    val ax: u32 = nsyms + sec_anchor[sec_i];
                    out.symbols[ax].name    = rid.ok;
                    out.symbols[ax].section = of.section_id(sec_i);
                    out.symbols[ax].offset  = 0;
                    out.symbols[ax].size    = 0;
                    out.symbols[ax].flags   = 0;
                }

                if (kind != of.SK_BSS && size > 0) {
                    if (!bin.region_ok(buf_size, sec_off, size::usize)) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret err[fail.Fail].err{fail.message("macho: section data out of bounds")};
                    }
                    val rbytes: res[*u8, A.Error] = A.allocate[u8](alloc, size::usize);
                    if (sel rbytes.err) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret err[fail.Fail].err{fail.message("macho: section bytes alloc failed")};
                    }
                    out.sections[sec_i].bytes = rbytes.ok;
                    memory.raw_copy(out.sections[sec_i].bytes::ptr, (buf::usize + sec_off)::ptr, size::usize);
                }
                sec_i = sec_i + 1;
                sh    = sh + SECTION_64_SIZE;
                k     = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }

    var si: u32 = 0;
    for (si < nsyms) {
        val so:      usize = symoff + si::usize * NLIST_64_SIZE;
        val n_strx:  u32   = bin.read_u32_le(buf, so);
        val n_type:  u8    = buf[so + 4];
        val n_sect:  u8    = buf[so + 5];
        val n_desc:  u16   = bin.read_u16_le(buf, so + 6);
        val n_value: u64   = bin.read_u64_le(buf, so + 8);

        val rnm: res[str, fail.Fail] = bin.cstr_at(buf, buf_size, stroff + n_strx::usize);
        if (sel rnm.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{rnm.err};
        }
        val rin: res[intern.StrId, A.Error] = intern.intern(itn, rnm.ok);
        if (sel rin.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.refused(rin.err)};
        }
        out.symbols[si].name = rin.ok;
        out.symbols[si].size = 0;

        var flags: u32 = 0;
        if ((n_type & N_EXT) != 0)                     { flags = flags | of.SYM_OBJ_FLAG_GLOBAL; }
        if ((n_desc & (N_WEAK_DEF | N_WEAK_REF)) != 0) { flags = flags | of.SYM_OBJ_FLAG_WEAK; }
        out.symbols[si].native = of.NativeSymbol{format: of.OF_MACHO, kind: n_type::u32, flags: n_desc::u32};
        if ((n_type & N_TYPE) == N_ABS) {
            out.symbols[si].section        = of.absolute_section();
            out.symbols[si].absolute_value = n_value;
            out.symbols[si].offset         = 0;
        }
        or ((n_type & N_TYPE) == N_UNDF) {
            flags = flags | of.SYM_OBJ_FLAG_EXTERN;
            if ((n_type & N_EXT) != 0 && n_value != 0) {
                if (n_value > 0xFFFFFFFF) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.message("macho: common symbol exceeds represented size")};
                }
                flags                 = flags | of.SYM_OBJ_FLAG_COMMON;
                out.symbols[si].size  = n_value::u32;
                out.symbols[si].align = 1;
                val log2a: u32 = (n_desc::u32 >> 8) & 0xF;
                if (log2a > 0 && log2a < 32) { out.symbols[si].align = 1 << log2a; }
            }
            if ((n_desc & REFERENCE_TYPE_MASK) == REFERENCE_FLAG_UNDEFINED_LAZY) { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            out.symbols[si].section = of.external_section();
            out.symbols[si].offset  = 0;
        }
        or (n_sect >= 1 && (n_sect - 1)::u32 < sec_n) {
            val sidx: u32 = (n_sect - 1)::u32;
            out.symbols[si].section = of.section_id(sidx);
            out.symbols[si].offset  = (n_value - sec_base[sidx])::u32;
            flags                   = flags | of.SYM_OBJ_FLAG_SIZE_UNKNOWN;
            if (out.sections[sidx].kind == of.SK_TEXT) { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            or                                         { flags = flags | of.SYM_OBJ_FLAG_OBJECT; }
        }
        or {
            out.symbols[si].section = of.external_section();
            out.symbols[si].offset  = 0;
        }
        out.symbols[si].flags = flags;
        si                    = si + 1;
    }

    val rel_total: res[u32, fail.Fail] = count_relocs(buf, buf_size, cputype, ncmds);
    if (sel rel_total.err) {
        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
        ret err[fail.Fail].err{rel_total.err};
    }
    val rel_n: u32 = rel_total.ok;
    if (rel_n > 0) {
        val rrel: res[*of.Relocation, A.Error] = A.zallocate[of.Relocation](alloc, rel_n::usize);
        if (sel rrel.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.message("macho: reloc array alloc failed")};
        }
        out.relocations = rrel.ok;
        out.reloc_cap   = rel_n;
    }
    out.reloc_count = rel_n;

    val rp: err[fail.Fail] = populate_relocs(alloc, itn, buf, buf_size, cputype, ncmds,
        sec_base, sec_anchor, nsyms, out);
    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
    if (sel rp.err) { ret rp; }
    ret populate_indirects(alloc, buf, indirect_off, indirect_count, nsyms, out);
}

fun populate_indirects(alloc: *A.Allocator, buf: *u8, table: usize, table_count: u32,
    nsyms: u32, out: *of.ObjectImage) err[fail.Fail] {
    var count:   u32 = 0;
    var section: u32 = 0;
    for (section < out.section_count) {
        val planned: res[u32, fail.Fail] = indirect_slots(?out.sections[section]);
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        val slots: u32 = planned.ok;
        val base:  u32 = out.sections[section].native.reserved1;
        if (slots != 0 && (base > table_count || slots > table_count - base)) {
            ret err[fail.Fail].err{fail.message("macho: section indirect symbols are outside the table")};
        }
        if (slots > 0xFFFFFFFF - count) { ret err[fail.Fail].err{fail.message("macho: indirect symbol count overflows")}; }
        count   = count + slots;
        section = section + 1;
    }
    if (count == 0) {
        if (table_count != 0) { ret err[fail.Fail].err{fail.message("macho: indirect symbols have no represented section")}; }
        ret err[fail.Fail].ok{};
    }
    val storage: res[*of.NativeIndirect, A.Error] = A.zallocate[of.NativeIndirect](alloc, count::usize);
    if (sel storage.err) { ret err[fail.Fail].err{fail.refused(storage.err)}; }
    out.indirects    = storage.ok;
    out.indirect_cap = count;
    section          = 0;
    for (section < out.section_count) {
        val slots_r: res[u32, fail.Fail] = indirect_slots(?out.sections[section]);
        if (sel slots_r.err) { ret err[fail.Fail].err{slots_r.err}; }
        val slots: u32 = slots_r.ok;
        var slot:  u32 = 0;
        for (slot < slots) {
            val index: u32               = out.sections[section].native.reserved1 + slot;
            val value: u32               = bin.read_u32_le(buf, table + index::usize * 4);
            var entry: of.NativeIndirect = of.NativeIndirect{section: of.section_id(section), slot: slot, symbol: of.SYMBOL_NONE};
            entry.flags = value & (of.INDIRECT_LOCAL | of.INDIRECT_ABSOLUTE);
            if (entry.flags == 0) {
                if (value >= nsyms) { ret err[fail.Fail].err{fail.message("macho: indirect symbol index out of bounds")}; }
                entry.symbol = value;
            }
            or (value != entry.flags) { ret err[fail.Fail].err{fail.message("macho: malformed indirect symbol marker")}; }
            out.indirects[out.indirect_count] = entry;
            out.indirect_count                = out.indirect_count + 1;
            slot                              = slot + 1;
        }
        if (slots != 0) { out.sections[section].native.reserved1 = 0; }
        section = section + 1;
    }
    ret err[fail.Fail].ok{};
}

fun free_parse_scratch(alloc: *A.Allocator, sec_base: *u64, sec_anchor: *u32, sec_n: u32) {
    if (sec_base != nil)   { A.deallocate[u64](alloc, sec_base, sec_n::usize); }
    if (sec_anchor != nil) { A.deallocate[u32](alloc, sec_anchor, sec_n::usize); }
}

fun plan_section_anchors(buf: *u8, buf_size: usize, cputype: u32, ncmds: u32, sec_n: u32,
    out: *u32) res[u32, fail.Fail] {
    var i: u32 = 0;
    for (i < sec_n) {
        out[i] = ANCHOR_NONE;
        i      = i + 1;
    }

    var anchors: u32   = 0;
    var off:     usize = MACH_HEADER_64_SIZE;
    var c:       u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val reloff: usize          = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32            = bin.read_u32_le(buf, sh + 60);
                val vr:     err[fail.Fail] = bin.require_region(buf_size, reloff, nreloc::usize * RELOC_INFO_SIZE, "macho: relocation array out of bounds");
                if (sel vr.err) { ret res[u32, fail.Fail].err{vr.err}; }
                var r: u32 = 0;
                for (r < nreloc) {
                    val word:   u32 = bin.read_u32_le(buf, reloff + r::usize * RELOC_INFO_SIZE + 4);
                    val r_type: u32 = (word >> 28) & 0xF;
                    if (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_ADDEND) {
                        r = r + 1;
                        cnt;
                    }
                    if (((word >> 27) & 0x1) == 0) {
                        val symnum: u32 = word & 0xFFFFFF;
                        if (symnum < 1 || symnum > sec_n) {
                            ret res[u32, fail.Fail].err{fail.message("macho: section-relative relocation names an out-of-range section")};
                        }
                        if (out[symnum - 1] == ANCHOR_NONE) {
                            out[symnum - 1] = anchors;
                            anchors         = anchors + 1;
                        }
                    }
                    r = r + 1;
                }
                sh = sh + SECTION_64_SIZE;
                k  = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    ret res[u32, fail.Fail].ok{anchors};
}

fun count_relocs(buf: *u8, buf_size: usize, cputype: u32, ncmds: u32) res[u32, fail.Fail] {
    var total: usize = 0;
    var off:   usize = MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val reloff: usize          = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32            = bin.read_u32_le(buf, sh + 60);
                val vr:     err[fail.Fail] = bin.require_region(buf_size, reloff, nreloc::usize * RELOC_INFO_SIZE, "macho: relocation array out of bounds");
                if (sel vr.err) { ret res[u32, fail.Fail].err{vr.err}; }
                var r: u32 = 0;
                for (r < nreloc) {
                    val word:   u32 = bin.read_u32_le(buf, reloff + r::usize * RELOC_INFO_SIZE + 4);
                    val r_type: u32 = (word >> 28) & 0xF;
                    if (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_ADDEND) {
                        r = r + 1;
                        cnt;
                    }
                    if (((cputype == CPU_TYPE_X86_64 && r_type == X86_64_RELOC_SUBTRACTOR)
                        || (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_SUBTRACTOR))) {
                        r = r + 1;
                        cnt;
                    }
                    total = total + 1;
                    r     = r + 1;
                }
                sh = sh + SECTION_64_SIZE;
                k  = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(total);
    if (sel fits.err) {
        ret res[u32, fail.Fail].err{fail.message("macho: relocation count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{fits.ok};
}

fun populate_relocs(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, cputype: u32, ncmds: u32,
    sec_base: *u64, sec_anchor: *u32, nsyms: u32, out: *of.ObjectImage) err[fail.Fail] {
    var rel_i: u32   = 0;
    var sec_i: u32   = 0;
    var off:   usize = MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val reloff:       usize = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc:       u32   = bin.read_u32_le(buf, sh + 60);
                var pending:      i64   = 0;
                var have_pending: bool  = false;
                var sub_sym:      u32   = 0;
                var have_sub:     bool  = false;
                var sub_addr:     u32   = 0;
                var sub_length:   u32   = 0;
                var r:            u32   = 0;
                for (r < nreloc) {
                    val e:        usize = reloff + r::usize * RELOC_INFO_SIZE;
                    val address:  u32   = bin.read_u32_le(buf, e);
                    val word:     u32   = bin.read_u32_le(buf, e + 4);
                    val symnum:   u32   = word & 0xFFFFFF;
                    val pcrel:    u32   = (word >> 24) & 0x1;
                    val r_length: u32   = (word >> 25) & 0x3;
                    val extn:     u32   = (word >> 27) & 0x1;
                    val r_type:   u32   = (word >> 28) & 0xF;

                    if (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_ADDEND) {
                        pending      = sign_extend24(symnum);
                        have_pending = true;
                        r            = r + 1;
                        cnt;
                    }
                    if (((cputype == CPU_TYPE_X86_64 && r_type == X86_64_RELOC_SUBTRACTOR)
                        || (cputype == CPU_TYPE_ARM64 && r_type == ARM64_RELOC_SUBTRACTOR))) {
                        if (have_sub) {
                            ret err[fail.Fail].err{fail.message("macho: two subtractor entries in a row; each one pairs with the UNSIGNED that follows it")};
                        }
                        if (extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor is not symbol-based")};
                        }
                        if (symnum >= nsyms) { ret err[fail.Fail].err{fail.message("macho: relocation symbol index out of range")}; }
                        if (r_length != 2 && r_length != 3) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor field is neither 4 nor 8 bytes")};
                        }
                        sub_sym    = symnum;
                        sub_addr   = address;
                        sub_length = r_length;
                        have_sub   = true;
                        r          = r + 1;
                        cnt;
                    }
                    if (have_sub) {
                        if (r_type != X86_64_RELOC_UNSIGNED) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor is not followed by an unsigned relocation")};
                        }
                        if (r_length != sub_length || pcrel != 0 || extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor pair has incompatible field encodings")};
                        }
                        if (address != sub_addr) {
                            ret err[fail.Fail].err{fail.message("macho: the halves of a subtractor pair patch different addresses")};
                        }
                    }
                    if (cputype == CPU_TYPE_X86_64 && x64_is_signed(r_type) && pcrel == 0) {
                        ret err[fail.Fail].err{fail.message("macho: x86_64 signed relocation is not pc-relative")};
                    }
                    if (cputype == CPU_TYPE_X86_64
                        && (r_type == X86_64_RELOC_GOT_LOAD || r_type == X86_64_RELOC_GOT)) {
                        if (pcrel == 0) {
                            ret err[fail.Fail].err{fail.message("macho: x86_64 GOT relocation is not pc-relative")};
                        }
                        if (extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: x86_64 GOT relocation is not symbol-based")};
                        }
                        if (r_type == X86_64_RELOC_GOT_LOAD
                            && !x64_got_load_insn(out.sections[sec_i].bytes,
                            out.sections[sec_i].len::usize,
                            address::usize)) {
                            ret err[fail.Fail].err{fail.message("macho: x86_64 GOT_LOAD relocation does not patch a RIP-relative MOVQ")};
                        }
                    }
                    if (extn != 0 && symnum >= nsyms) { ret err[fail.Fail].err{fail.message("macho: relocation symbol index out of range")}; }

                    var insn: u32 = 0;
                    if (out.sections[sec_i].bytes != nil && (address::usize + 4) <= out.sections[sec_i].len::usize) {
                        insn = bin.read_u32_le(out.sections[sec_i].bytes, address::usize);
                    }
                    val rk: res[of.RelocKind, fail.Fail] = reloc_kind_for(itn, alloc, cputype, r_type, r_length, insn);
                    if (sel rk.err) { ret err[fail.Fail].err{rk.err}; }
                    val kind: of.RelocKind = rk.ok;

                    var target: u32 = symnum;
                    var addend: i64 = 0;
                    if (extn != 0) {
                        val ra: res[i64, fail.Fail] = recover_addend(itn, alloc, out, sec_i, address, cputype, kind,
                            r_type, pcrel, pending, have_pending);
                        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
                        addend = ra.ok;
                    }
                    or {
                        val tsec: u32 = symnum - 1;
                        target = nsyms + sec_anchor[tsec];
                        val sa: res[i64, fail.Fail] = section_addend(itn, alloc, out, sec_base, sec_i, tsec,
                            address, cputype, kind, r_type, pcrel);
                        if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
                        addend = sa.ok;
                    }

                    var out_kind: of.RelocKind = kind;
                    var out_sym2: u32          = 0;
                    if (have_sub) {
                        if (r_length == 3) { out_kind = of.RK_DIFF64; }
                        or (r_length == 2) { out_kind = of.RK_DIFF32; }
                        or {
                            ret err[fail.Fail].err{fail.message("macho: a subtractor pair writes neither 4 nor 8 bytes")};
                        }
                        out_sym2 = sub_sym;
                    }

                    out.relocations[rel_i].section = of.section_id(sec_i);
                    out.relocations[rel_i].offset  = address;
                    out.relocations[rel_i].kind    = out_kind;
                    out.relocations[rel_i].sym     = target;
                    out.relocations[rel_i].addend  = addend;
                    out.relocations[rel_i].sym2    = out_sym2;
                    rel_i                          = rel_i + 1;
                    pending                        = 0;
                    have_pending                   = false;
                    sub_sym                        = 0;
                    have_sub                       = false;
                    sub_addr                       = 0;
                    r                              = r + 1;
                }
                if (have_sub) {
                    ret err[fail.Fail].err{fail.message("macho: an X86_64_RELOC_SUBTRACTOR ends the section's relocations with no UNSIGNED to pair with")};
                }
                sec_i = sec_i + 1;
                sh    = sh + SECTION_64_SIZE;
                k     = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    ret err[fail.Fail].ok{};
}

fun sign_extend24(v: u32) i64 {
    var a: i64 = (v & 0xFFFFFF)::i64;
    if ((v & 0x800000) != 0) { a = a - 0x1000000; }
    ret a;
}

fun recover_addend(itn: *intern.Interner, alloc: *A.Allocator, out: *of.ObjectImage, sec_i: u32, address: u32, cputype: u32, kind: of.RelocKind,
    r_type: u32, pcrel: u32, pending: i64, have_pending: bool) res[i64, fail.Fail] {
    val bytes: *u8   = out.sections[sec_i].bytes;
    val len:   usize = out.sections[sec_i].len::usize;
    if (kind == of.RK_ABS64) {
        if (bytes == nil || (address::usize + 8) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val addend: i64 = bin.read_u64_le(bytes, address::usize)::i64;
        bin.write_u64_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{addend};
    }
    if (kind == of.RK_ABS32) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val addend: i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        bin.write_u32_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{addend};
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        if (bytes == nil || (address::usize + 8) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val raw: u64 = bin.read_u64_le(bytes, address::usize);
        bin.write_u64_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{add_u64_mod(raw, 0xFFFFFFFFFFFFFFF8)::i64};
    }
    if (cputype == CPU_TYPE_ARM64) {
        if (have_pending) { ret res[i64, fail.Fail].ok{pending}; }
        ret res[i64, fail.Fail].ok{0};
    }
    if (pcrel != 0) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val raw:  i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        val bias: i64 = x64_pcrel_bias(r_type);
        bin.write_u32_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{(raw + bias) - (4 + bias)};
    }
    ret res[i64, fail.Fail].err{fail.message(of.reloc_kind_rejection(itn, alloc, kind, "macho x86_64 addend recovery"))};
}

fun section_addend(itn: *intern.Interner, alloc: *A.Allocator, out: *of.ObjectImage, sec_base: *u64,
    sec_i: u32, tsec: u32, address: u32, cputype: u32, kind: of.RelocKind,
    r_type: u32, pcrel: u32) res[i64, fail.Fail] {
    val bytes:  *u8   = out.sections[sec_i].bytes;
    val len:    usize = out.sections[sec_i].len::usize;
    var target: u64   = 0;
    if (pcrel == 0 && kind == of.RK_ABS64) {
        if (bytes == nil || (address::usize + 8) > len) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation field out of bounds")}; }
        target = bin.read_u64_le(bytes, address::usize);
        bin.write_u64_le(bytes, address::usize, 0);
    }
    or (pcrel == 0 && kind == of.RK_ABS32) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation field out of bounds")}; }
        target = bin.read_u32_le(bytes, address::usize)::u64;
        bin.write_u32_le(bytes, address::usize, 0);
    }
    or (pcrel != 0 && cputype != CPU_TYPE_ARM64 && (kind == of.RK_PC32 || kind == of.RK_PLT32)) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation field out of bounds")}; }
        val disp: i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        val bias: i64 = x64_pcrel_bias(r_type);
        val tail: u64 = address::u64 + (4 + bias)::u64;
        if (sec_base[sec_i] > 0xFFFFFFFFFFFFFFFF - tail) {
            ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation target overflows address space")};
        }
        val pc: u64 = sec_base[sec_i] + tail;
        if (disp >= 0) {
            if (pc > 0xFFFFFFFFFFFFFFFF - disp::u64) {
                ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation target overflows address space")};
            }
            target = pc + disp::u64;
        }
        or {
            val magnitude: u64 = (-disp)::u64;
            if (pc < magnitude) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation targets before its section")}; }
            target = pc - magnitude;
        }
        bin.write_u32_le(bytes, address::usize, 0);
    }
    or {
        ret res[i64, fail.Fail].err{fail.message(unsupported_section_kind_message(itn, alloc, kind))};
    }

    val base: u64 = sec_base[tsec];
    if (target < base) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation targets before its section")}; }
    val offset: u64 = target - base;
    if (offset > 0x7FFFFFFFFFFFFFFF) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation addend overflows i64")}; }
    if (pcrel != 0)                  { ret res[i64, fail.Fail].ok{offset::i64 - (4 + x64_pcrel_bias(r_type))}; }
    ret res[i64, fail.Fail].ok{offset::i64};
}

pub fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, cputype: u32, r_type: u32, r_length: u32, insn: u32) res[of.RelocKind, fail.Fail] {
    if (cputype == CPU_TYPE_ARM64) {
        if (r_type == ARM64_RELOC_UNSIGNED)  { ret unsigned_kind(r_length); }
        if (r_type == ARM64_RELOC_BRANCH26)  { ret res[of.RelocKind, fail.Fail].ok{of.RK_PLT32}; }
        if (r_type == ARM64_RELOC_PAGE21)    { ret res[of.RelocKind, fail.Fail].ok{of.RK_PAGE21}; }
        if (r_type == ARM64_RELOC_PAGEOFF12) { ret pageoff12_kind(itn, alloc, insn); }
        ret res[of.RelocKind, fail.Fail].err{fail.message(unsupported_type_message(itn, alloc, r_type::u64))};
    }
    if (r_type == X86_64_RELOC_UNSIGNED) { ret unsigned_kind(r_length); }
    if (x64_is_signed(r_type)) {
        if (r_length != 2) { ret res[of.RelocKind, fail.Fail].err{fail.message("macho: x86_64 signed relocation field is not 4 bytes")}; }
        ret res[of.RelocKind, fail.Fail].ok{of.RK_PC32};
    }
    if (r_type == X86_64_RELOC_BRANCH) { ret res[of.RelocKind, fail.Fail].ok{of.RK_PLT32}; }
    if (r_type == X86_64_RELOC_GOT_LOAD) {
        if (r_length != 2) { ret res[of.RelocKind, fail.Fail].err{fail.message("macho: x86_64 GOT_LOAD relocation field is not 4 bytes")}; }
        ret res[of.RelocKind, fail.Fail].ok{of.RK_GOTPCREL};
    }
    if (r_type == X86_64_RELOC_GOT) {
        if (r_length == 2) { ret res[of.RelocKind, fail.Fail].ok{of.RK_GOTPCREL_NORELAX}; }
        if (r_length == 3) { ret res[of.RelocKind, fail.Fail].ok{of.RK_GOTPCREL64_NORELAX}; }
        ret res[of.RelocKind, fail.Fail].err{fail.message("macho: x86_64 GOT relocation field is neither 4 nor 8 bytes")};
    }
    ret res[of.RelocKind, fail.Fail].err{fail.message(unsupported_type_message(itn, alloc, r_type::u64))};
}

fun x64_is_signed(r_type: u32) bool {
    ret r_type == X86_64_RELOC_SIGNED || r_type == X86_64_RELOC_SIGNED_1
        || r_type == X86_64_RELOC_SIGNED_2 || r_type == X86_64_RELOC_SIGNED_4;
}

fun x64_got_load_insn(bytes: *u8, len: usize, address: usize) bool {
    if (bytes == nil || address < 3 || address + 4 > len) { ret false; }
    val rex:    u8 = bytes[address - 3];
    val opcode: u8 = bytes[address - 2];
    val modrm:  u8 = bytes[address - 1];
    ret (rex & 0xF8) == 0x48 && opcode == 0x8B && (modrm & 0xC7) == 0x05;
}

fun x64_pcrel_bias(r_type: u32) i64 {
    if (r_type == X86_64_RELOC_SIGNED_1) { ret 1; }
    if (r_type == X86_64_RELOC_SIGNED_2) { ret 2; }
    if (r_type == X86_64_RELOC_SIGNED_4) { ret 4; }
    ret 0;
}

fun unsigned_kind(r_length: u32) res[of.RelocKind, fail.Fail] {
    if (r_length == 3) { ret res[of.RelocKind, fail.Fail].ok{of.RK_ABS64}; }
    ret res[of.RelocKind, fail.Fail].ok{of.RK_ABS32};
}

fun pageoff12_kind(itn: *intern.Interner, alloc: *A.Allocator, insn: u32) res[of.RelocKind, fail.Fail] {
    if ((insn & 0x7F800000) == 0x11000000) { ret res[of.RelocKind, fail.Fail].ok{of.RK_ADD_LO12}; }
    if ((insn & 0x3B000000) == 0x39000000) {
        val v:    u32 = (insn >> 26) & 0x1;
        val size: u32 = (insn >> 30) & 0x3;
        val opc:  u32 = (insn >> 22) & 0x3;
        if (v == 1 && size == 0 && opc == 3) { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST128_LO12}; }
        if (size == 0)                       { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST8_LO12}; }
        if (size == 1)                       { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST16_LO12}; }
        if (size == 2)                       { ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST32_LO12}; }
        ret res[of.RelocKind, fail.Fail].ok{of.RK_LDST64_LO12};
    }
    ret res[of.RelocKind, fail.Fail].err{fail.message(bin.name_message(itn, alloc, "macho: undecodable arm64 pageoff12 instruction",
        nil, "macho: undecodable arm64 pageoff12 instruction"))};
}

fun unsupported_section_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret of.reloc_kind_rejection(itn, alloc, kind, "macho section-relative relocations");
}

fun unsupported_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u64) str {
    ret bin.number_message(itn, alloc, "macho: unsupported relocation type ",
        r_type, "macho: unsupported relocation type");
}

pub fun macho_kind_from(flags: u32, is_text: bool, is_data_const: bool, is_rodata: bool) of.SectionKind {
    if ((flags & 0xFF) == S_ZEROFILL)            { ret of.SK_BSS; }
    if ((flags & S_ATTR_PURE_INSTRUCTIONS) != 0) { ret of.SK_TEXT; }
    if ((flags & S_ATTR_DEBUG) != 0)             { ret of.SK_DEBUG; }
    if (is_data_const)                           { ret of.SK_RELRO; }
    if (is_text || is_rodata)                    { ret of.SK_RODATA; }
    ret of.SK_DATA;
}

fun canonical_sectname(raw: str, out: *u8) str {
    if (raw[0] == '_' && raw[1] == '_' && raw[2] == 'd' && raw[3] == 'e' && raw[4] == 'b'
        && raw[5] == 'u' && raw[6] == 'g') {
        out[0] = '.';
        var i: usize = 2;
        var w: usize = 1;
        for (raw[i] != 0) {
            out[w] = raw[i];
            i      = i + 1;
            w      = w + 1;
        }
        out[w] = 0;
        ret out::str;
    }
    var j: usize = 0;
    for (raw[j] != 0) {
        out[j] = raw[j];
        j      = j + 1;
    }
    out[j] = 0;
    ret out::str;
}

fun section_identity(buf: *u8, sh: usize, out: *u8) str {
    var w: usize = 0;
    var i: usize = 0;
    for (i < 16 && buf[sh + 16 + i] != 0) {
        out[w] = buf[sh + 16 + i];
        w      = w + 1;
        i      = i + 1;
    }
    out[w] = ',';
    w      = w + 1;
    i      = 0;
    for (i < 16 && buf[sh + i] != 0) {
        out[w] = buf[sh + i];
        w      = w + 1;
        i      = i + 1;
    }
    out[w] = 0;
    ret out::str;
}
