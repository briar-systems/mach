#[testing]
fun t_emit_x64_object(alloc: *A.Allocator, i: *intern.Interner, out: *Vector[u8]) bool {
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k:          usize = 0;
    for (k < 24) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    text_bytes[0] = 0xE8;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) {
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 24;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name    = format.t_intern(i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 24;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name    = format.t_intern(i, "ext_func");
    syms[2].section = of.external_section();
    syms[2].offset  = 0;
    syms[2].size    = 0;
    syms[2].flags   = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 1;
    relocs[0].kind    = of.RK_PLT32;
    relocs[0].sym     = 2;
    relocs[0].addend  = -4;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 8;
    relocs[1].kind    = of.RK_PC32;
    relocs[1].sym     = 1;
    relocs[1].addend  = -4;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 16;
    relocs[2].kind    = of.RK_ABS64;
    relocs[2].sym     = 1;
    relocs[2].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = alloc;
    img.interner      = i;
    img.name          = format.t_intern(i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 3;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 3;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(alloc, "macho_sub");
    if (sel tf_r.err) { ret false; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret false; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, tpath);

    if (sel rb.err) { ret false; }
    @out = rb.ok;
    ret true;
}

#[testing]
fun t_put_reloc(buf: *u8, reloff: usize, idx: u32, address: u32, symnum: u32,
    pcrel: u32, length: u32, extn: u32, r_type: u32) {
    val e: usize = reloff + idx::usize * format.RELOC_INFO_SIZE;
    bin.write_u32_le(buf, e, address);
    bin.write_u32_le(buf, e + 4, (symnum & 0xFFFFFF) | (pcrel << 24) | (length << 25)
        | (extn << 27) | (r_type << 28));
}

#[testing]
fun t_first_reloff(buf: *u8, out_n: *u32) usize {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == format.LC_SEGMENT_64) {
            val nsects: u32 = bin.read_u32_le(buf, off + 64);
            if (nsects > 0) {
                val sh: usize = off + format.SEGMENT_CMD_64_SIZE;
                @out_n = bin.read_u32_le(buf, sh + 60);
                ret bin.read_u32_le(buf, sh + 56)::usize;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    @out_n = 0;
    ret 0;
}

test parse_object__x86_64_subtractor_pair_folds_to_a_difference {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    var nreloc: u32   = 0;
    val reloff: usize = t_first_reloff(buf.data, ?nreloc);
    if (reloff == 0 || nreloc < 2) { ret 2; }

    t_put_reloc(buf.data, reloff, 0, 16, 1, 0, 3, 1, format.X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(buf.data, reloff, 1, 16, 0, 0, 3, 1, format.X86_64_RELOC_UNSIGNED);
    var z: u32 = 2;
    for (z < nreloc) {
        t_put_reloc(buf.data, reloff, z, 0, 0, 0, 3, 1, format.X86_64_RELOC_UNSIGNED);
        z = z + 1;
    }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 3; }

    var bad: i32 = 0;
    if (out.reloc_count != nreloc - 1 && bad == 0) { bad = 4; }

    var saw: bool = false;
    var rj:  u32  = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.kind == of.RK_DIFF64) {
            saw = true;
            if (rr.offset != 16 && bad == 0)            { bad = 5; }
            if (!of.is_difference(rr.kind) && bad == 0) { bad = 6; }
        }
        rj = rj + 1;
    }
    if (!saw && bad == 0) { bad = 7; }

    ret bad;
}

test parse_object__refuses_a_malformed_subtractor_pair {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var bad: i32 = 0;

    var b1: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b1)) { ret 1; }
    var n1: u32   = 0;
    val o1: usize = t_first_reloff(b1.data, ?n1);
    if (o1 == 0 || n1 < 2) { ret 2; }
    t_put_reloc(b1.data, o1, 0, 16, 1, 0, 3, 1, format.X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b1.data, o1, 1, 16, 0, 1, 2, 1, format.X86_64_RELOC_BRANCH);
    var out1:   of.ObjectImage;
    val r_6627: err[fail.Fail] = parse_object(?alloc, ?i, b1.data, b1.len, ?out1);
    if (sel r_6627.ok && bad == 0) { bad = 3; }

    var b2: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b2)) { ret 4; }
    var n2: u32   = 0;
    val o2: usize = t_first_reloff(b2.data, ?n2);
    if (o2 == 0 || n2 < 2) { ret 5; }
    t_put_reloc(b2.data, o2, 0, 16, 1, 0, 3, 1, format.X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b2.data, o2, 1, 8, 0, 0, 3, 1, format.X86_64_RELOC_UNSIGNED);
    var out2:   of.ObjectImage;
    val r_6637: err[fail.Fail] = parse_object(?alloc, ?i, b2.data, b2.len, ?out2);
    if (sel r_6637.ok && bad == 0) { bad = 6; }

    var b3: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b3)) { ret 7; }
    var n3: u32   = 0;
    val o3: usize = t_first_reloff(b3.data, ?n3);
    if (o3 == 0 || n3 < 2) { ret 8; }
    t_put_reloc(b3.data, o3, 0, 16, 1, 0, 3, 1, format.X86_64_RELOC_SUBTRACTOR);
    t_put_reloc(b3.data, o3, 1, 16, 0, 0, 3, 1, format.X86_64_RELOC_SUBTRACTOR);
    var out3:   of.ObjectImage;
    val r_6647: err[fail.Fail] = parse_object(?alloc, ?i, b3.data, b3.len, ?out3);
    if (sel r_6647.ok && bad == 0) { bad = 9; }

    ret bad;
}

#[testing]
fun t_symtab(buf: *u8, out_n: *u32) usize {
    val ncmds: u32   = bin.read_u32_le(buf, 16);
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == format.LC_SYMTAB) {
            @out_n = bin.read_u32_le(buf, off + 12);
            ret bin.read_u32_le(buf, off + 8)::usize;
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    @out_n = 0;
    ret 0;
}

test parse_object__tentative_definition_reads_as_common {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }

    var nsyms:  u32   = 0;
    val symoff: usize = t_symtab(buf.data, ?nsyms);
    if (symoff == 0 || nsyms == 0) { ret 2; }

    val so: usize = symoff + (nsyms - 1)::usize * format.NLIST_64_SIZE;
    buf.data[so + 4] = format.N_UNDF | format.N_EXT;
    buf.data[so + 5] = 0;
    bin.write_u16_le(buf.data, so + 6, (4 << 8)::u16);
    bin.write_u64_le(buf.data, so + 8, 40);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 3; }

    var bad: i32  = 0;
    var saw: bool = false;
    var k:   u32  = 0;
    for (k < out.symbol_count) {
        val sym: *of.Symbol = ?out.symbols[k];
        if ((sym.flags & of.SYM_OBJ_FLAG_COMMON) != 0) {
            saw = true;
            if (sym.size != 40 && bad == 0)                            { bad = 4; }
            if (sym.align != 16 && bad == 0)                           { bad = 5; }
            if ((sym.flags & of.SYM_OBJ_FLAG_EXTERN) == 0 && bad == 0) { bad = 6; }
            if (!of.section_is_external(sym.section) && bad == 0)      { bad = 7; }
        }
        k = k + 1;
    }
    if (!saw && bad == 0) { bad = 8; }

    var b2: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?b2)) { ret 9; }
    var n2: u32   = 0;
    val s2: usize = t_symtab(b2.data, ?n2);
    if (s2 == 0 || n2 == 0) { ret 10; }
    var out2:   of.ObjectImage;
    val r_6714: err[fail.Fail] = parse_object(?alloc, ?i, b2.data, b2.len, ?out2);
    if (sel r_6714.err) { ret 11; }
    var k2: u32 = 0;
    for (k2 < out2.symbol_count) {
        if ((out2.symbols[k2].flags & of.SYM_OBJ_FLAG_COMMON) != 0 && bad == 0) { bad = 12; }
        k2 = k2 + 1;
    }

    ret bad;
}

test relocatable__preserves_native_sections_and_difference_pairs {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var data:     [8]u8;
    var sections: [2]of.Section;
    sections[0] = of.Section{name: format.t_intern(?itn, "custom_a"), kind: of.SK_DATA, bytes: ?data[0], len: 8, align: 8};
    sections[1] = of.Section{name: format.t_intern(?itn, "custom_b"), kind: of.SK_DATA, align: 8};
    var i: u32 = 0;
    for (i < 2) {
        sections[i].native.format = of.OF_MACHO;
        sections[i].native.flags  = format.S_ATTR_NO_DEAD_STRIP::u64;
        format.write_fixed16(?sections[i].native.name[0], 0, bin.resolve_name(?itn, sections[i].name));
        format.write_fixed16(?sections[i].native.segment[0], 0, "__CUSTOM");
        i = i + 1;
    }
    var symbols: [2]of.Symbol;
    symbols[0] = of.Symbol{name: format.t_intern(?itn, "_left"), section: of.section_id(0), size: 8, align: 8, flags: of.SYM_OBJ_FLAG_GLOBAL};
    symbols[1] = of.Symbol{name: format.t_intern(?itn, "_right"), section: of.section_id(1), align: 8, flags: of.SYM_OBJ_FLAG_GLOBAL};
    var relocation: of.Relocation  = of.Relocation{section: of.section_id(0), kind: of.RK_DIFF64, sym: 0, sym2: 1, addend: -7};
    var image:      of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    image.sections      = ?sections[0];
    image.section_count = 2;
    image.symbols       = ?symbols[0];
    image.symbol_count  = 2;
    image.relocations   = ?relocation;
    image.reloc_count   = 1;
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_relocatable");
    if (sel created.err) { ret 1; }
    var file: fixture.Output = created.ok;
    fin { fixture.dnit(?file); }
    var arch: u32 = 0;
    for (arch < 2) {
        var target: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);
        if (arch == 1) { target = format.t_isa(isa.ARCH_AARCH64); }
        val emitted: err[fail.Fail] = object.emit_object(?target, ?image, fixture.path(?file));
        if (sel emitted.err) { ret 2; }
        val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?file));
        if (sel read.err) { ret 3; }
        var bytes: Vector[u8] = read.ok;
        fin {
            if (bytes.data != nil) { A.deallocate[u8](?alloc, bytes.data, bytes.cap); }
        }
        val header: usize = format.MACH_HEADER_64_SIZE + format.SEGMENT_CMD_64_SIZE;
        if (!format.fixed16_equals(bytes.data, header, "custom_a") || !format.fixed16_equals(bytes.data, header + 16, "__CUSTOM")
            || !format.fixed16_equals(bytes.data, header + format.SECTION_64_SIZE, "custom_b")
            || bin.read_u32_le(bytes.data, header + 64)::u64 != sections[0].native.flags) { ret 4; }
        val relocoff:   usize = bin.read_u32_le(bytes.data, header + 56)::usize;
        var subtractor: u32   = format.X86_64_RELOC_SUBTRACTOR;
        if (arch == 1) { subtractor = format.ARM64_RELOC_SUBTRACTOR; }
        if (bin.read_u32_le(bytes.data, header + 60) != 2
            || (bin.read_u32_le(bytes.data, relocoff + 4) >> 28) != subtractor
            || (bin.read_u32_le(bytes.data, relocoff + format.RELOC_INFO_SIZE + 4) >> 28) != 0) { ret 5; }
        var parsed:  of.ObjectImage;
        val decoded: err[fail.Fail] = parse_object(?alloc, ?itn, bytes.data, bytes.len, ?parsed);
        if (sel decoded.err) { ret 6; }
        fin { of.object_image_dnit(?parsed); }
        if (parsed.section_count != 2 || parsed.sections[1].len != 0 || parsed.reloc_count != 1
            || parsed.relocations[0].kind != of.RK_DIFF64 || parsed.relocations[0].addend != -7
            || parsed.symbols[parsed.relocations[0].sym].name != symbols[0].name
            || parsed.symbols[parsed.relocations[0].sym2].name != symbols[1].name) { ret 7; }
        var evidence: str = "macho-difference-x64.o";
        if (arch == 1) { evidence = "macho-difference-arm64.o"; }
        val retain_bytes_r: err[outcome.Fail] = fixture.retain_bytes(?alloc, evidence, bytes.data, bytes.len);
        if (sel retain_bytes_r.err) { ret 10; }
        arch = arch + 1;
    }
    ret 0;
}

test relocatable__remaps_indirect_symbols_and_absolute_definitions {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var data: [16]u8;
    var stub: [6]u8;
    stub[0] = 0xFF;
    stub[1] = 0x25;
    var sections: [2]of.Section;
    sections[0] = of.Section{name: format.t_intern(?itn, "__pointers"), kind: of.SK_DATA, bytes: ?data[0], len: 16, align: 8};
    sections[1] = of.Section{name: format.t_intern(?itn, "__stubs"), kind: of.SK_TEXT, bytes: ?stub[0], len: 6, align: 1};
    var si: u32 = 0;
    for (si < 2) {
        sections[si].native.format = of.OF_MACHO;
        format.write_fixed16(?sections[si].native.name[0], 0, bin.resolve_name(?itn, sections[si].name));
        format.write_fixed16(?sections[si].native.segment[0], 0, "__CUSTOM");
        si = si + 1;
    }
    sections[0].native.flags     = 6;
    sections[1].native.flags     = 8;
    sections[1].native.reserved2 = 6;
    var symbols: [3]of.Symbol;
    symbols[0] = of.Symbol{name: format.t_intern(?itn, "_external"), section: of.external_section(), flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN};
    symbols[1] = of.Symbol{name: format.t_intern(?itn, "_absolute"), section: of.absolute_section(),
        absolute_value: 0xFEDCBA9876543210, flags: of.SYM_OBJ_FLAG_GLOBAL,
        native:         of.NativeSymbol{format: of.OF_MACHO, kind: format.N_ABS::u32 | 0x10, flags: 0x20}};
    symbols[2] = of.Symbol{name: format.t_intern(?itn, "local_absolute"), section: of.absolute_section(), absolute_value: 17};
    var indirects: [3]of.NativeIndirect;
    indirects[0] = of.NativeIndirect{section: of.section_id(0), slot: 0, symbol: 0};
    indirects[1] = of.NativeIndirect{section: of.section_id(0), slot: 1, symbol: of.SYMBOL_NONE, flags: of.INDIRECT_LOCAL | of.INDIRECT_ABSOLUTE};
    indirects[2] = of.NativeIndirect{section: of.section_id(1), slot: 0, symbol: 0};
    var image: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    image.sections       = ?sections[0];
    image.section_count  = 2;
    image.symbols        = ?symbols[0];
    image.symbol_count   = 3;
    image.indirects      = ?indirects[0];
    image.indirect_count = 3;
    var target:  of.ObjectTarget                   = format.t_isa(isa.ARCH_X86_64);
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_indirects");
    if (sel created.err) { ret 1; }
    var file: fixture.Output = created.ok;
    fin { fixture.dnit(?file); }
    val emitted: err[fail.Fail] = object.emit_object(?target, ?image, fixture.path(?file));
    if (sel emitted.err) { ret 2; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?file));
    if (sel read.err) { ret 3; }
    var bytes: Vector[u8] = read.ok;
    fin {
        if (bytes.data != nil) { A.deallocate[u8](?alloc, bytes.data, bytes.cap); }
    }
    val command: usize = format.t_find_lc(bytes.data, format.LC_DYSYMTAB);
    val table:   usize = bin.read_u32_le(bytes.data, command + 56)::usize;
    if (bin.read_u32_le(bytes.data, command + 60) != 3 || bin.read_u32_le(bytes.data, table) != 2
        || bin.read_u32_le(bytes.data, table + 4) != (of.INDIRECT_LOCAL | of.INDIRECT_ABSOLUTE)
        || bin.read_u32_le(bytes.data, table + 8) != 2) { ret 4; }
    var parsed:  of.ObjectImage;
    val decoded: err[fail.Fail] = parse_object(?alloc, ?itn, bytes.data, bytes.len, ?parsed);
    if (sel decoded.err) { ret 5; }
    fin { of.object_image_dnit(?parsed); }
    if (parsed.indirect_count != 3 || of.section_index(parsed.indirects[2].section) != 1 || parsed.indirects[2].slot != 0
        || parsed.symbols[parsed.indirects[0].symbol].name != symbols[0].name
        || !of.section_is_absolute(parsed.symbols[1].section) || parsed.symbols[1].absolute_value != symbols[1].absolute_value
        || parsed.symbols[1].native.kind != (format.N_ABS::u32 | format.N_EXT::u32 | 0x10)
        || parsed.symbols[1].native.flags != 0x20) { ret 6; }
    val retain_bytes_r: err[outcome.Fail] = fixture.retain_bytes(?alloc, "macho-indirect.o", bytes.data, bytes.len);
    if (sel retain_bytes_r.err) { ret 10; }
    indirects[1].slot = 0;
    val r_6907: err[fail.Fail] = object.validate_indirects(?image);
    if (sel r_6907.ok) { ret 7; }
    indirects[1].slot    = 1;
    image.indirect_count = 2;
    val r_6910: err[fail.Fail] = object.validate_indirects(?image);
    if (sel r_6910.ok) { ret 8; }
    bin.write_u32_le(bytes.data, table, 3);
    var invalid: of.ObjectImage;
    val r_6913:  err[fail.Fail] = parse_object(?alloc, ?itn, bytes.data, bytes.len, ?invalid);
    if (sel r_6913.ok) {
        of.object_image_dnit(?invalid);
        ret 9;
    }
    ret 0;
}

# refusal classes: the offending input is constructed and the typed error
# must leave the destination untouched
