    val rb: res[Vector[u8], std_filesystem.FsError] = std_filesystem.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = macho_format.t_find_lc(buf.data, macho_format.LC_SEGMENT_64);
    if (seg == 0)                                                                       { ret 1; }
    if (!t_make_section_based(buf.data, seg + macho_format.SEGMENT_CMD_64_SIZE, 16, 7)) { ret 1; }

    var out: target_of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.ok) { ret 1; }
    if (out.sections != nil || out.section_count != 0 || out.section_cap != 0
        || out.symbols != nil || out.symbol_count != 0 || out.symbol_cap != 0
        || out.relocations != nil || out.reloc_count != 0 || out.reloc_cap != 0
        || out.attributes != nil || out.attributes_len != 0) { ret 1; }
    ret 0;
}

