use mach.lang.build.outcome;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.layout;
use fixture: mach.lang.output.testing;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target.of.carrier;
use mach.lang.target.of.exports;
use mach.lang.target.of.macho.format;
use mach.lang.target.of.macho.object;
use relocation: mach.lang.target.of.macho.reloc;
use mach.lang.target.of.record;
use A: std.allocator;
use std.allocator.page;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;

fun x64_got_load_insn(bytes: *u8, len: usize, address: usize) bool {
    if (bytes == nil || address < 3 || address + 4 > len) { ret false; }
    val rex:    u8 = bytes[address - 3];
    val opcode: u8 = bytes[address - 2];
    val modrm:  u8 = bytes[address - 1];
    ret (rex & 0xF8) == 0x48 && opcode == 0x8B && (modrm & 0xC7) == 0x05;
}

fun x64_pcrel_bias(r_type: u32) i64 {
    if (r_type == format.X86_64_RELOC_SIGNED_1) { ret 1; }
    if (r_type == format.X86_64_RELOC_SIGNED_2) { ret 2; }
    if (r_type == format.X86_64_RELOC_SIGNED_4) { ret 4; }
    ret 0;
}

fun unsupported_section_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret of.reloc_kind_rejection(itn, alloc, kind, "macho section-relative relocations");
}

pub fun macho_kind_from(flags: u32, is_text: bool, is_data_const: bool, is_rodata: bool) of.SectionKind {
    if ((flags & 0xFF) == format.S_ZEROFILL)            { ret of.SK_BSS; }
    if ((flags & format.S_ATTR_PURE_INSTRUCTIONS) != 0) { ret of.SK_TEXT; }
    if ((flags & format.S_ATTR_DEBUG) != 0)             { ret of.SK_DEBUG; }
    if (is_data_const)                                  { ret of.SK_RELRO; }
    if (is_text || is_rodata)                           { ret of.SK_RODATA; }
    ret of.SK_DATA;
}

fun section_identity(buf: *u8, sh: usize, out: *u8) str {
    var w: usize = 0;
    var i: usize = 0;
    for (i < 16 && buf[sh + 16 + i] != 0) {
        out[w] = buf[sh + 16 + i];
        w      = w + 1;
        i      = i + 1;
    }
    out[w] = ',';
    w      = w + 1;
    i      = 0;
    for (i < 16 && buf[sh + i] != 0) {
        out[w] = buf[sh + i];
        w      = w + 1;
        i      = i + 1;
    }
    out[w] = 0;
    ret out::str;
}

pub fun parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < format.MACH_HEADER_64_SIZE) {
        ret err[fail.Fail].err{fail.message("macho: object too small")};
    }
    if (alloc == nil) { ret err[fail.Fail].err{fail.message("macho: no allocator for parse")}; }
    if (itn == nil)   { ret err[fail.Fail].err{fail.message("macho: no interner for parse")}; }

    var parsed: of.ObjectImage = of.object_image_init(alloc, itn, intern.STR_NIL);
    val built:  err[fail.Fail] = parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (sel built.err) {
        val reason: str = fail.describe(built.err);
        of.object_image_dnit(?parsed);
        ret err[fail.Fail].err{fail.message(reason)};
    }
    val valid: err[fail.Fail] = of.validate_owned_object_or_dnit(?parsed);
    if (sel valid.err) { ret valid; }
    @out = parsed;
    ret err[fail.Fail].ok{};
}

fun parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < format.MACH_HEADER_64_SIZE) {
        ret err[fail.Fail].err{fail.message("macho: object too small")};
    }
    if (bin.read_u32_le(buf, 0) != format.MH_MAGIC_64) {
        ret err[fail.Fail].err{fail.message("macho: not a 64-bit Mach-O object (bad magic; expected 0xFEEDFACF)")};
    }
    if (itn == nil) { ret err[fail.Fail].err{fail.message("macho: no interner for parse")}; }

    val cputype: u32 = bin.read_u32_le(buf, 4);
    val ncmds:   u32 = bin.read_u32_le(buf, 16);

    var sec_total:      layout.CheckedCount[of.Section] = layout.count[of.Section](0::usize);
    var symoff:         usize                           = 0;
    var nsyms:          u32                             = 0;
    var stroff:         usize                           = 0;
    var strsize:        usize                           = 0;
    var have_symtab:    bool                            = false;
    var indirect_off:   usize                           = 0;
    var indirect_count: u32                             = 0;
    var have_dysymtab:  bool                            = false;

    var off: usize = format.MACH_HEADER_64_SIZE;
    var c:   u32   = 0;
    for (c < ncmds) {
        val vc: err[fail.Fail] = bin.require_region(buf_size, off, 8, "macho: load command out of bounds");
        if (sel vc.err) { ret vc; }
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmdsize < 8) { ret err[fail.Fail].err{fail.message("macho: zero-size load command")}; }
        val vfull: err[fail.Fail] = bin.require_region(buf_size, off, cmdsize, "macho: load command out of bounds");
        if (sel vfull.err) { ret vfull; }

        if (cmd == format.LC_SEGMENT_64) {
            val vseg: err[fail.Fail] = bin.require_region(buf_size, off, format.SEGMENT_CMD_64_SIZE,
                "macho: segment command out of bounds");
            if (sel vseg.err) { ret vseg; }
            val nsects: u32            = bin.read_u32_le(buf, off + 64);
            val vsects: err[fail.Fail] = bin.require_region(buf_size, off + format.SEGMENT_CMD_64_SIZE,
                nsects::usize * format.SECTION_64_SIZE, "macho: segment section headers out of bounds");
            if (sel vsects.err) { ret vsects; }
            val added: res[layout.CheckedCount[of.Section], layout.CheckCause] =
                layout.count_add[of.Section](sec_total, layout.count[of.Section](nsects::usize));
            if (sel added.err) {
                ret err[fail.Fail].err{fail.message("macho: section count exceeds the u32 limit")};
            }
            sec_total = added.ok;
        }
        or (cmd == format.LC_DYSYMTAB) {
            if (cmdsize < format.DYSYMTAB_CMD_SIZE || have_dysymtab) {
                ret err[fail.Fail].err{fail.message("macho: malformed or duplicate dynamic symbol command")};
            }
            have_dysymtab  = true;
            indirect_off   = bin.read_u32_le(buf, off + 56)::usize;
            indirect_count = bin.read_u32_le(buf, off + 60);
        }
        or (cmd == format.LC_SYMTAB) {
            if (cmdsize < format.SYMTAB_CMD_SIZE || have_symtab) {
                ret err[fail.Fail].err{fail.message("macho: malformed or duplicate symbol command")};
            }
            symoff      = bin.read_u32_le(buf, off + 8)::usize;
            nsyms       = bin.read_u32_le(buf, off + 12);
            stroff      = bin.read_u32_le(buf, off + 16)::usize;
            strsize     = bin.read_u32_le(buf, off + 20)::usize;
            have_symtab = true;
        }
        off = off + cmdsize;
        c   = c + 1;
    }

    val sec_n_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(sec_total.value);
    if (sel sec_n_fits.err) {
        ret err[fail.Fail].err{fail.message("macho: section count exceeds the u32 limit")};
    }
    val sec_n: u32 = sec_n_fits.ok;

    val vi: err[fail.Fail] = bin.require_region(buf_size, indirect_off, indirect_count::usize * 4, "macho: indirect symbol table out of bounds");
    if (sel vi.err) { ret vi; }
    if (have_symtab) {
        val vsy: err[fail.Fail] = bin.require_region(buf_size, symoff, nsyms::usize * format.NLIST_64_SIZE, "macho: symbol table out of bounds");
        if (sel vsy.err) { ret vsy; }
        val vst: err[fail.Fail] = bin.require_region(buf_size, stroff, strsize, "macho: string table out of bounds");
        if (sel vst.err) { ret vst; }
    }

    if (sec_n > 0) {
        val rsec: res[*of.Section, A.Error] = A.zallocate[of.Section](alloc, sec_n::usize);
        if (sel rsec.err) { ret err[fail.Fail].err{fail.message("macho: section array alloc failed")}; }
        out.sections    = rsec.ok;
        out.section_cap = sec_n;
    }

    var sec_base:   *u64 = nil;
    var sec_anchor: *u32 = nil;
    if (sec_n > 0) {
        val rb: res[*u64, A.Error] = A.zallocate[u64](alloc, sec_n::usize);
        if (sel rb.err) { ret err[fail.Fail].err{fail.message("macho: section base table alloc failed")}; }
        sec_base = rb.ok;
        val ra: res[*u32, A.Error] = A.zallocate[u32](alloc, sec_n::usize);
        if (sel ra.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.message("macho: section anchor table alloc failed")};
        }
        sec_anchor = ra.ok;
    }

    val plan: res[u32, fail.Fail] = plan_section_anchors(buf, buf_size, cputype, ncmds, sec_n, sec_anchor);
    if (sel plan.err) {
        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
        ret err[fail.Fail].err{plan.err};
    }
    val anchor_n: u32 = plan.ok;

    if (nsyms + anchor_n > 0) {
        val rsym: res[*of.Symbol, A.Error] = A.zallocate[of.Symbol](alloc, (nsyms + anchor_n)::usize);
        if (sel rsym.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.message("macho: symbol array alloc failed")};
        }
        out.symbols    = rsym.ok;
        out.symbol_cap = nsyms + anchor_n;
    }
    out.section_count = sec_n;
    out.symbol_count  = nsyms + anchor_n;

    var sec_i: u32 = 0;
    off = format.MACH_HEADER_64_SIZE;
    c   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == format.LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + format.SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val addr:          u64            = bin.read_u64_le(buf, sh + 32);
                val size:          u64            = bin.read_u64_le(buf, sh + 40);
                val sec_off:       usize          = bin.read_u32_le(buf, sh + 48)::usize;
                val align_l:       u32            = bin.read_u32_le(buf, sh + 52);
                val flags:         u32            = bin.read_u32_le(buf, sh + 64);
                val is_text:       bool           = format.fixed16_equals(buf, sh + 16, "__TEXT");
                val is_data_const: bool           = format.fixed16_equals(buf, sh + 16, "__DATA_CONST");
                val is_rodata:     bool           = format.fixed16_equals(buf, sh + 16, "__RODATA");
                val kind:          of.SectionKind = macho_kind_from(flags, is_text, is_data_const, is_rodata);

                var name_buf: [17]u8;
                var ni:       usize = 0;
                for (ni < 16) {
                    name_buf[ni] = buf[sh + ni];
                    ni           = ni + 1;
                }
                name_buf[16] = 0;
                var canon_buf:   [17]u8;
                var canon:       str      = format.canonical_sectname((?name_buf[0])::str, ?canon_buf[0]);
                val native_name: opt[str] = format.macho_sectname(kind);
                val canonical:   opt[str] = of.canonical_section_name(kind);
                if (sel native_name.none) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.message(of.section_kind_rejection(itn, alloc, kind))};
                }
                if (sel canonical.none) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.message(of.section_kind_rejection(itn, alloc, kind))};
                }
                if (kind != of.SK_DEBUG && str_equals(canon, native_name.some)) {
                    canon = canonical.some;
                }
                val rin: res[intern.StrId, A.Error] = intern.intern(itn, canon);
                if (sel rin.err) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.refused(rin.err)};
                }

                out.sections[sec_i].name          = rin.ok;
                out.sections[sec_i].kind          = kind;
                out.sections[sec_i].flags         = 0;
                out.sections[sec_i].native.format = of.OF_MACHO;
                out.sections[sec_i].native.flags  = flags::u64;
                memory.raw_copy((?out.sections[sec_i].native.name[0])::ptr, (buf::usize + sh)::ptr, 16);
                memory.raw_copy((?out.sections[sec_i].native.segment[0])::ptr, (buf::usize + sh + 16)::ptr, 16);
                out.sections[sec_i].native.reserved1 = bin.read_u32_le(buf, sh + 68);
                out.sections[sec_i].native.reserved2 = bin.read_u32_le(buf, sh + 72);
                out.sections[sec_i].native.reserved3 = bin.read_u32_le(buf, sh + 76);
                if ((flags & format.SECTION_TYPE) == format.S_MOD_INIT_FUNC_POINTERS) {
                    out.sections[sec_i].flags = of.SEC_FLAG_INIT_FUNCS;
                }
                if ((flags & format.S_ATTR_NO_DEAD_STRIP) != 0) {
                    out.sections[sec_i].flags = out.sections[sec_i].flags | of.SEC_FLAG_RETAIN;
                }
                out.sections[sec_i].len   = size::u32;
                out.sections[sec_i].align = (1::u32) << align_l;
                out.sections[sec_i].bytes = nil;
                sec_base[sec_i]           = addr;

                if (sec_anchor[sec_i] != format.ANCHOR_NONE) {
                    var ident_buf: [format.SECTION_IDENTITY_SIZE]u8;
                    val ident:     str                        = section_identity(buf, sh, ?ident_buf[0]);
                    val rid:       res[intern.StrId, A.Error] = intern.intern(itn, ident);
                    if (sel rid.err) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret err[fail.Fail].err{fail.refused(rid.err)};
                    }
                    val ax: u32 = nsyms + sec_anchor[sec_i];
                    out.symbols[ax].name    = rid.ok;
                    out.symbols[ax].section = of.section_id(sec_i);
                    out.symbols[ax].offset  = 0;
                    out.symbols[ax].size    = 0;
                    out.symbols[ax].flags   = 0;
                }

                if (kind != of.SK_BSS && size > 0) {
                    if (!bin.region_ok(buf_size, sec_off, size::usize)) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret err[fail.Fail].err{fail.message("macho: section data out of bounds")};
                    }
                    val rbytes: res[*u8, A.Error] = A.allocate[u8](alloc, size::usize);
                    if (sel rbytes.err) {
                        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                        ret err[fail.Fail].err{fail.message("macho: section bytes alloc failed")};
                    }
                    out.sections[sec_i].bytes = rbytes.ok;
                    memory.raw_copy(out.sections[sec_i].bytes::ptr, (buf::usize + sec_off)::ptr, size::usize);
                }
                sec_i = sec_i + 1;
                sh    = sh + format.SECTION_64_SIZE;
                k     = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }

    var si: u32 = 0;
    for (si < nsyms) {
        val so:      usize = symoff + si::usize * format.NLIST_64_SIZE;
        val n_strx:  u32   = bin.read_u32_le(buf, so);
        val n_type:  u8    = buf[so + 4];
        val n_sect:  u8    = buf[so + 5];
        val n_desc:  u16   = bin.read_u16_le(buf, so + 6);
        val n_value: u64   = bin.read_u64_le(buf, so + 8);

        val rnm: res[str, fail.Fail] = bin.cstr_at(buf, buf_size, stroff + n_strx::usize);
        if (sel rnm.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{rnm.err};
        }
        val rin: res[intern.StrId, A.Error] = intern.intern(itn, rnm.ok);
        if (sel rin.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.refused(rin.err)};
        }
        out.symbols[si].name = rin.ok;
        out.symbols[si].size = 0;

        var flags: u32 = 0;
        if ((n_type & format.N_EXT) != 0)                            { flags = flags | of.SYM_OBJ_FLAG_GLOBAL; }
        if ((n_type & format.N_PEXT) != 0)                           { flags = flags | of.SYM_OBJ_FLAG_HIDDEN; }
        if ((n_desc & (format.N_WEAK_DEF | format.N_WEAK_REF)) != 0) { flags = flags | of.SYM_OBJ_FLAG_WEAK; }
        out.symbols[si].native = of.NativeSymbol{format: of.OF_MACHO, kind: n_type::u32, flags: n_desc::u32};
        if ((n_type & format.N_TYPE) == format.N_ABS) {
            out.symbols[si].section        = of.absolute_section();
            out.symbols[si].absolute_value = n_value;
            out.symbols[si].offset         = 0;
        }
        or ((n_type & format.N_TYPE) == format.N_UNDF) {
            flags = flags | of.SYM_OBJ_FLAG_EXTERN;
            if ((n_type & format.N_EXT) != 0 && n_value != 0) {
                if (n_value > 0xFFFFFFFF) {
                    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
                    ret err[fail.Fail].err{fail.message("macho: common symbol exceeds represented size")};
                }
                flags                 = flags | of.SYM_OBJ_FLAG_COMMON;
                out.symbols[si].size  = n_value::u32;
                out.symbols[si].align = 1;
                val log2a: u32 = (n_desc::u32 >> 8) & 0xF;
                if (log2a > 0 && log2a < 32) { out.symbols[si].align = 1 << log2a; }
            }
            if ((n_desc & format.REFERENCE_TYPE_MASK) == format.REFERENCE_FLAG_UNDEFINED_LAZY) { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            out.symbols[si].section = of.external_section();
            out.symbols[si].offset  = 0;
        }
        or (n_sect >= 1 && (n_sect - 1)::u32 < sec_n) {
            val sidx: u32 = (n_sect - 1)::u32;
            out.symbols[si].section = of.section_id(sidx);
            out.symbols[si].offset  = (n_value - sec_base[sidx])::u32;
            flags                   = flags | of.SYM_OBJ_FLAG_SIZE_UNKNOWN;
            if (out.sections[sidx].kind == of.SK_TEXT) { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            or                                         { flags = flags | of.SYM_OBJ_FLAG_OBJECT; }
        }
        or {
            out.symbols[si].section = of.external_section();
            out.symbols[si].offset  = 0;
        }
        out.symbols[si].flags = flags;
        si                    = si + 1;
    }

    val rel_total: res[u32, fail.Fail] = count_relocs(buf, buf_size, cputype, ncmds);
    if (sel rel_total.err) {
        free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
        ret err[fail.Fail].err{rel_total.err};
    }
    val rel_n: u32 = rel_total.ok;
    if (rel_n > 0) {
        val rrel: res[*of.Relocation, A.Error] = A.zallocate[of.Relocation](alloc, rel_n::usize);
        if (sel rrel.err) {
            free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
            ret err[fail.Fail].err{fail.message("macho: reloc array alloc failed")};
        }
        out.relocations = rrel.ok;
        out.reloc_cap   = rel_n;
    }
    out.reloc_count = rel_n;

    val rp: err[fail.Fail] = populate_relocs(alloc, itn, buf, buf_size, cputype, ncmds,
        sec_base, sec_anchor, nsyms, out);
    free_parse_scratch(alloc, sec_base, sec_anchor, sec_n);
    if (sel rp.err) { ret rp; }
    val indirects: err[fail.Fail] = populate_indirects(alloc, buf, indirect_off, indirect_count, nsyms, out);
    if (sel indirects.err) { ret indirects; }
    val requests: err[fail.Fail] = decode_export_requests(alloc, itn, out);
    if (sel requests.err) { ret requests; }
    val recorded: err[fail.Fail] = decode_cache_record(itn, out);
    if (sel recorded.err) { ret recorded; }
    ret decode_carrier(itn, out);
}

# `__MACH,__mach_link` carries a codegen image's link carrier, applied last
# since it splits the sections mach-o merged
fun decode_carrier(itn: *intern.Interner, out: *of.ObjectImage) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.intern(itn, object.CARRIER_SECTNAME);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val found: opt[u32] = exports.find(out, name_r.ok);
    if (sel found.none) { ret err[fail.Fail].ok{}; }
    if (!format.fixed16_equals(?out.sections[found.some].native.segment[0], 0, object.EXPORTS_SEGNAME)) {
        ret err[fail.Fail].ok{};
    }
    ret carrier.take(out, found.some);
}

# `__MACH,__mach_cache` carries the object cache's record into the image and
# is consumed
fun decode_cache_record(itn: *intern.Interner, out: *of.ObjectImage) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.intern(itn, object.RECORD_SECTNAME);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val found: opt[u32] = exports.find(out, name_r.ok);
    if (sel found.none) { ret err[fail.Fail].ok{}; }
    if (!format.fixed16_equals(?out.sections[found.some].native.segment[0], 0, object.EXPORTS_SEGNAME)) {
        ret err[fail.Fail].ok{};
    }
    ret record.take(out, found.some);
}

# `__MACH,__mach_exports` carries the request list into the image and is
# consumed
fun decode_export_requests(alloc: *A.Allocator, itn: *intern.Interner, out: *of.ObjectImage) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.intern(itn, object.EXPORTS_SECTNAME);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val found: opt[u32] = exports.find(out, name_r.ok);
    if (sel found.none) { ret err[fail.Fail].ok{}; }
    if (!format.fixed16_equals(?out.sections[found.some].native.segment[0], 0, object.EXPORTS_SEGNAME)) {
        ret err[fail.Fail].ok{};
    }
    ret exports.decode(alloc, itn, out, found.some);
}

fun populate_indirects(alloc: *A.Allocator, buf: *u8, table: usize, table_count: u32,
    nsyms: u32, out: *of.ObjectImage) err[fail.Fail] {
    var count:   u32 = 0;
    var section: u32 = 0;
    for (section < out.section_count) {
        val planned: res[u32, fail.Fail] = format.indirect_slots(?out.sections[section]);
        if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
        val slots: u32 = planned.ok;
        val base:  u32 = out.sections[section].native.reserved1;
        if (slots != 0 && (base > table_count || slots > table_count - base)) {
            ret err[fail.Fail].err{fail.message("macho: section indirect symbols are outside the table")};
        }
        if (slots > 0xFFFFFFFF - count) { ret err[fail.Fail].err{fail.message("macho: indirect symbol count overflows")}; }
        count   = count + slots;
        section = section + 1;
    }
    if (count == 0) {
        if (table_count != 0) { ret err[fail.Fail].err{fail.message("macho: indirect symbols have no represented section")}; }
        ret err[fail.Fail].ok{};
    }
    val storage: res[*of.NativeIndirect, A.Error] = A.zallocate[of.NativeIndirect](alloc, count::usize);
    if (sel storage.err) { ret err[fail.Fail].err{fail.refused(storage.err)}; }
    out.indirects    = storage.ok;
    out.indirect_cap = count;
    section          = 0;
    for (section < out.section_count) {
        val slots_r: res[u32, fail.Fail] = format.indirect_slots(?out.sections[section]);
        if (sel slots_r.err) { ret err[fail.Fail].err{slots_r.err}; }
        val slots: u32 = slots_r.ok;
        var slot:  u32 = 0;
        for (slot < slots) {
            val index: u32               = out.sections[section].native.reserved1 + slot;
            val value: u32               = bin.read_u32_le(buf, table + index::usize * 4);
            var entry: of.NativeIndirect = of.NativeIndirect{section: of.section_id(section), slot: slot, symbol: of.SYMBOL_NONE};
            entry.flags = value & (of.INDIRECT_LOCAL | of.INDIRECT_ABSOLUTE);
            if (entry.flags == 0) {
                if (value >= nsyms) { ret err[fail.Fail].err{fail.message("macho: indirect symbol index out of bounds")}; }
                entry.symbol = value;
            }
            or (value != entry.flags) { ret err[fail.Fail].err{fail.message("macho: malformed indirect symbol marker")}; }
            out.indirects[out.indirect_count] = entry;
            out.indirect_count                = out.indirect_count + 1;
            slot                              = slot + 1;
        }
        if (slots != 0) { out.sections[section].native.reserved1 = 0; }
        section = section + 1;
    }
    ret err[fail.Fail].ok{};
}

fun free_parse_scratch(alloc: *A.Allocator, sec_base: *u64, sec_anchor: *u32, sec_n: u32) {
    if (sec_base != nil)   { A.deallocate[u64](alloc, sec_base, sec_n::usize); }
    if (sec_anchor != nil) { A.deallocate[u32](alloc, sec_anchor, sec_n::usize); }
}

fun plan_section_anchors(buf: *u8, buf_size: usize, cputype: u32, ncmds: u32, sec_n: u32,
    out: *u32) res[u32, fail.Fail] {
    var i: u32 = 0;
    for (i < sec_n) {
        out[i] = format.ANCHOR_NONE;
        i      = i + 1;
    }

    var anchors: u32   = 0;
    var off:     usize = format.MACH_HEADER_64_SIZE;
    var c:       u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == format.LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + format.SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val reloff: usize          = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32            = bin.read_u32_le(buf, sh + 60);
                val vr:     err[fail.Fail] = bin.require_region(buf_size, reloff, nreloc::usize * format.RELOC_INFO_SIZE, "macho: relocation array out of bounds");
                if (sel vr.err) { ret res[u32, fail.Fail].err{vr.err}; }
                var r: u32 = 0;
                for (r < nreloc) {
                    val word:   u32 = bin.read_u32_le(buf, reloff + r::usize * format.RELOC_INFO_SIZE + 4);
                    val r_type: u32 = (word >> 28) & 0xF;
                    if (cputype == format.CPU_TYPE_ARM64 && r_type == format.ARM64_RELOC_ADDEND) {
                        r = r + 1;
                        cnt;
                    }
                    if (((word >> 27) & 0x1) == 0) {
                        val symnum: u32 = word & 0xFFFFFF;
                        if (symnum < 1 || symnum > sec_n) {
                            ret res[u32, fail.Fail].err{fail.message("macho: section-relative relocation names an out-of-range section")};
                        }
                        if (out[symnum - 1] == format.ANCHOR_NONE) {
                            out[symnum - 1] = anchors;
                            anchors         = anchors + 1;
                        }
                    }
                    r = r + 1;
                }
                sh = sh + format.SECTION_64_SIZE;
                k  = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    ret res[u32, fail.Fail].ok{anchors};
}

fun count_relocs(buf: *u8, buf_size: usize, cputype: u32, ncmds: u32) res[u32, fail.Fail] {
    var total: usize = 0;
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == format.LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + format.SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val reloff: usize          = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc: u32            = bin.read_u32_le(buf, sh + 60);
                val vr:     err[fail.Fail] = bin.require_region(buf_size, reloff, nreloc::usize * format.RELOC_INFO_SIZE, "macho: relocation array out of bounds");
                if (sel vr.err) { ret res[u32, fail.Fail].err{vr.err}; }
                var r: u32 = 0;
                for (r < nreloc) {
                    val word:   u32 = bin.read_u32_le(buf, reloff + r::usize * format.RELOC_INFO_SIZE + 4);
                    val r_type: u32 = (word >> 28) & 0xF;
                    if (cputype == format.CPU_TYPE_ARM64 && r_type == format.ARM64_RELOC_ADDEND) {
                        r = r + 1;
                        cnt;
                    }
                    if (((cputype == format.CPU_TYPE_X86_64 && r_type == format.X86_64_RELOC_SUBTRACTOR)
                        || (cputype == format.CPU_TYPE_ARM64 && r_type == format.ARM64_RELOC_SUBTRACTOR))) {
                        r = r + 1;
                        cnt;
                    }
                    total = total + 1;
                    r     = r + 1;
                }
                sh = sh + format.SECTION_64_SIZE;
                k  = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    val fits: res[u32, layout.CheckCause] = layout.usize_to_u32(total);
    if (sel fits.err) {
        ret res[u32, fail.Fail].err{fail.message("macho: relocation count exceeds the u32 limit")};
    }
    ret res[u32, fail.Fail].ok{fits.ok};
}

fun populate_relocs(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, cputype: u32, ncmds: u32,
    sec_base: *u64, sec_anchor: *u32, nsyms: u32, out: *of.ObjectImage) err[fail.Fail] {
    var rel_i: u32   = 0;
    var sec_i: u32   = 0;
    var off:   usize = format.MACH_HEADER_64_SIZE;
    var c:     u32   = 0;
    for (c < ncmds) {
        val cmd:     u32   = bin.read_u32_le(buf, off);
        val cmdsize: usize = bin.read_u32_le(buf, off + 4)::usize;
        if (cmd == format.LC_SEGMENT_64) {
            val nsects: u32   = bin.read_u32_le(buf, off + 64);
            var sh:     usize = off + format.SEGMENT_CMD_64_SIZE;
            var k:      u32   = 0;
            for (k < nsects) {
                val reloff:       usize = bin.read_u32_le(buf, sh + 56)::usize;
                val nreloc:       u32   = bin.read_u32_le(buf, sh + 60);
                var pending:      i64   = 0;
                var have_pending: bool  = false;
                var sub_sym:      u32   = 0;
                var have_sub:     bool  = false;
                var sub_addr:     u32   = 0;
                var sub_length:   u32   = 0;
                var r:            u32   = 0;
                for (r < nreloc) {
                    val e:        usize = reloff + r::usize * format.RELOC_INFO_SIZE;
                    val address:  u32   = bin.read_u32_le(buf, e);
                    val word:     u32   = bin.read_u32_le(buf, e + 4);
                    val symnum:   u32   = word & 0xFFFFFF;
                    val pcrel:    u32   = (word >> 24) & 0x1;
                    val r_length: u32   = (word >> 25) & 0x3;
                    val extn:     u32   = (word >> 27) & 0x1;
                    val r_type:   u32   = (word >> 28) & 0xF;

                    if (cputype == format.CPU_TYPE_ARM64 && r_type == format.ARM64_RELOC_ADDEND) {
                        pending      = sign_extend24(symnum);
                        have_pending = true;
                        r            = r + 1;
                        cnt;
                    }
                    if (((cputype == format.CPU_TYPE_X86_64 && r_type == format.X86_64_RELOC_SUBTRACTOR)
                        || (cputype == format.CPU_TYPE_ARM64 && r_type == format.ARM64_RELOC_SUBTRACTOR))) {
                        if (have_sub) {
                            ret err[fail.Fail].err{fail.message("macho: two subtractor entries in a row; each one pairs with the UNSIGNED that follows it")};
                        }
                        if (extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor is not symbol-based")};
                        }
                        if (symnum >= nsyms) { ret err[fail.Fail].err{fail.message("macho: relocation symbol index out of range")}; }
                        if (r_length != 2 && r_length != 3) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor field is neither 4 nor 8 bytes")};
                        }
                        sub_sym    = symnum;
                        sub_addr   = address;
                        sub_length = r_length;
                        have_sub   = true;
                        r          = r + 1;
                        cnt;
                    }
                    if (have_sub) {
                        if (r_type != format.X86_64_RELOC_UNSIGNED) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor is not followed by an unsigned relocation")};
                        }
                        if (r_length != sub_length || pcrel != 0 || extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: subtractor pair has incompatible field encodings")};
                        }
                        if (address != sub_addr) {
                            ret err[fail.Fail].err{fail.message("macho: the halves of a subtractor pair patch different addresses")};
                        }
                    }
                    if (cputype == format.CPU_TYPE_X86_64 && relocation.x64_is_signed(r_type) && pcrel == 0) {
                        ret err[fail.Fail].err{fail.message("macho: x86_64 signed relocation is not pc-relative")};
                    }
                    if (cputype == format.CPU_TYPE_X86_64
                        && (r_type == format.X86_64_RELOC_GOT_LOAD || r_type == format.X86_64_RELOC_GOT)) {
                        if (pcrel == 0) {
                            ret err[fail.Fail].err{fail.message("macho: x86_64 GOT relocation is not pc-relative")};
                        }
                        if (extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: x86_64 GOT relocation is not symbol-based")};
                        }
                        if (r_type == format.X86_64_RELOC_GOT_LOAD
                            && !x64_got_load_insn(out.sections[sec_i].bytes,
                            out.sections[sec_i].len::usize,
                            address::usize)) {
                            ret err[fail.Fail].err{fail.message("macho: x86_64 GOT_LOAD relocation does not patch a RIP-relative MOVQ")};
                        }
                    }
                    if (cputype == format.CPU_TYPE_ARM64
                        && (r_type == format.ARM64_RELOC_GOT_LOAD_PAGE21 || r_type == format.ARM64_RELOC_GOT_LOAD_PAGEOFF12)) {
                        if (extn == 0) {
                            ret err[fail.Fail].err{fail.message("macho: arm64 GOT_LOAD relocation is not symbol-based")};
                        }
                        if (have_pending) {
                            ret err[fail.Fail].err{fail.message("macho: arm64 GOT_LOAD relocation follows an ADDEND entry; a GOT slot has no addend")};
                        }
                    }
                    if (extn != 0 && symnum >= nsyms) { ret err[fail.Fail].err{fail.message("macho: relocation symbol index out of range")}; }

                    var insn: u32 = 0;
                    if (out.sections[sec_i].bytes != nil && (address::usize + 4) <= out.sections[sec_i].len::usize) {
                        insn = bin.read_u32_le(out.sections[sec_i].bytes, address::usize);
                    }
                    val rk: res[of.RelocKind, fail.Fail] = relocation.reloc_kind_for(itn, alloc, cputype, r_type, r_length, insn);
                    if (sel rk.err) { ret err[fail.Fail].err{rk.err}; }
                    val kind: of.RelocKind = rk.ok;

                    var target: u32 = symnum;
                    var addend: i64 = 0;
                    if (extn != 0) {
                        val ra: res[i64, fail.Fail] = recover_addend(itn, alloc, out, sec_i, address, cputype, kind,
                            r_type, pcrel, pending, have_pending);
                        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
                        addend = ra.ok;
                    }
                    or {
                        val tsec: u32 = symnum - 1;
                        target = nsyms + sec_anchor[tsec];
                        val sa: res[i64, fail.Fail] = section_addend(itn, alloc, out, sec_base, sec_i, tsec,
                            address, cputype, kind, r_type, pcrel);
                        if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
                        addend = sa.ok;
                    }

                    var out_kind: of.RelocKind = kind;
                    var out_sym2: u32          = 0;
                    if (have_sub) {
                        if (r_length == 3) { out_kind = of.RK_DIFF64; }
                        or (r_length == 2) { out_kind = of.RK_DIFF32; }
                        or {
                            ret err[fail.Fail].err{fail.message("macho: a subtractor pair writes neither 4 nor 8 bytes")};
                        }
                        out_sym2 = sub_sym;
                    }

                    out.relocations[rel_i].section = of.section_id(sec_i);
                    out.relocations[rel_i].offset  = address;
                    out.relocations[rel_i].kind    = out_kind;
                    out.relocations[rel_i].sym     = target;
                    out.relocations[rel_i].addend  = addend;
                    out.relocations[rel_i].sym2    = out_sym2;
                    rel_i                          = rel_i + 1;
                    pending                        = 0;
                    have_pending                   = false;
                    sub_sym                        = 0;
                    have_sub                       = false;
                    sub_addr                       = 0;
                    r                              = r + 1;
                }
                if (have_sub) {
                    ret err[fail.Fail].err{fail.message("macho: an X86_64_RELOC_SUBTRACTOR ends the section's relocations with no UNSIGNED to pair with")};
                }
                sec_i = sec_i + 1;
                sh    = sh + format.SECTION_64_SIZE;
                k     = k + 1;
            }
        }
        off = off + cmdsize;
        c   = c + 1;
    }
    ret err[fail.Fail].ok{};
}

fun sign_extend24(v: u32) i64 {
    var a: i64 = (v & 0xFFFFFF)::i64;
    if ((v & 0x800000) != 0) { a = a - 0x1000000; }
    ret a;
}

# the addend a relocation field carries in place: the absolute and 64-bit
# GOT kinds read it from the field, arm64 carries it in the paired ADDEND
# entry, the pc-relative x86_64 kinds read a biased displacement; a declared
# kind the reader recovers no addend for is unsupported by name
fun recover_addend(itn: *intern.Interner, alloc: *A.Allocator, out: *of.ObjectImage, sec_i: u32, address: u32, cputype: u32, kind: of.RelocKind,
    r_type: u32, pcrel: u32, pending: i64, have_pending: bool) res[i64, fail.Fail] {
    val bytes: *u8   = out.sections[sec_i].bytes;
    val len:   usize = out.sections[sec_i].len::usize;
    if (kind == of.RK_ABS64) {
        if (bytes == nil || (address::usize + 8) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val addend: i64 = bin.read_u64_le(bytes, address::usize)::i64;
        bin.write_u64_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{addend};
    }
    if (kind == of.RK_ABS32) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val addend: i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        bin.write_u32_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{addend};
    }
    if (kind == of.RK_GOTPCREL64_NORELAX) {
        if (bytes == nil || (address::usize + 8) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val raw: u64 = bin.read_u64_le(bytes, address::usize);
        bin.write_u64_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{relocation.add_u64_mod(raw, 0xFFFFFFFFFFFFFFF8)::i64};
    }
    if (cputype == format.CPU_TYPE_ARM64) {
        if (have_pending) { ret res[i64, fail.Fail].ok{pending}; }
        ret res[i64, fail.Fail].ok{0};
    }
    if (pcrel != 0) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: relocation field out of bounds")}; }
        val raw:  i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        val bias: i64 = x64_pcrel_bias(r_type);
        bin.write_u32_le(bytes, address::usize, 0);
        ret res[i64, fail.Fail].ok{(raw + bias) - (4 + bias)};
    }
    ret res[i64, fail.Fail].err{fail.message(of.reloc_kind_rejection(itn, alloc, kind, "macho x86_64 addend recovery"))};
}

fun section_addend(itn: *intern.Interner, alloc: *A.Allocator, out: *of.ObjectImage, sec_base: *u64,
    sec_i: u32, tsec: u32, address: u32, cputype: u32, kind: of.RelocKind,
    r_type: u32, pcrel: u32) res[i64, fail.Fail] {
    val bytes:  *u8   = out.sections[sec_i].bytes;
    val len:    usize = out.sections[sec_i].len::usize;
    var target: u64   = 0;
    if (pcrel == 0 && kind == of.RK_ABS64) {
        if (bytes == nil || (address::usize + 8) > len) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation field out of bounds")}; }
        target = bin.read_u64_le(bytes, address::usize);
        bin.write_u64_le(bytes, address::usize, 0);
    }
    or (pcrel == 0 && kind == of.RK_ABS32) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation field out of bounds")}; }
        target = bin.read_u32_le(bytes, address::usize)::u64;
        bin.write_u32_le(bytes, address::usize, 0);
    }
    or (pcrel != 0 && cputype != format.CPU_TYPE_ARM64 && (kind == of.RK_PC32 || kind == of.RK_PLT32)) {
        if (bytes == nil || (address::usize + 4) > len) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation field out of bounds")}; }
        val disp: i64 = (bin.read_u32_le(bytes, address::usize)::i32)::i64;
        val bias: i64 = x64_pcrel_bias(r_type);
        val tail: u64 = address::u64 + (4 + bias)::u64;
        if (sec_base[sec_i] > 0xFFFFFFFFFFFFFFFF - tail) {
            ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation target overflows address space")};
        }
        val pc: u64 = sec_base[sec_i] + tail;
        if (disp >= 0) {
            if (pc > 0xFFFFFFFFFFFFFFFF - disp::u64) {
                ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation target overflows address space")};
            }
            target = pc + disp::u64;
        }
        or {
            val magnitude: u64 = (-disp)::u64;
            if (pc < magnitude) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation targets before its section")}; }
            target = pc - magnitude;
        }
        bin.write_u32_le(bytes, address::usize, 0);
    }
    or {
        ret res[i64, fail.Fail].err{fail.message(unsupported_section_kind_message(itn, alloc, kind))};
    }

    val base: u64 = sec_base[tsec];
    if (target < base) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation targets before its section")}; }
    val offset: u64 = target - base;
    if (offset > 0x7FFFFFFFFFFFFFFF) { ret res[i64, fail.Fail].err{fail.message("macho: section-relative relocation addend overflows i64")}; }
    if (pcrel != 0)                  { ret res[i64, fail.Fail].ok{offset::i64 - (4 + x64_pcrel_bias(r_type))}; }
    ret res[i64, fail.Fail].ok{offset::i64};
}

test object__x86_64_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: Vector[u8];
    if (!t_emit_x64_object(?alloc, ?i, ?buf)) { ret 1; }
    val main_name: intern.StrId = format.t_intern(?i, "_main");
    val g_name:    intern.StrId = format.t_intern(?i, "g");
    val ext_name:  intern.StrId = format.t_intern(?i, "ext_func");

    if (bin.read_u32_le(buf.data, 0) != format.MH_MAGIC_64)              { ret 1; }
    if (bin.read_u32_le(buf.data, 4) != format.CPU_TYPE_X86_64)          { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != format.MH_OBJECT)               { ret 1; }
    if (bin.read_u32_le(buf.data, 16) != 3)                              { ret 1; }
    if (bin.read_u32_le(buf.data, format.MACH_HEADER_64_SIZE + 64) != 2) { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 2)                                          { ret 1; }
    if (out.symbol_count != 3)                                           { ret 1; }
    if (out.reloc_count != 3)                                            { ret 1; }
    if (out.sections[0].kind != of.SK_TEXT || out.sections[0].len != 24) { ret 1; }
    if (out.sections[1].kind != of.SK_DATA || out.sections[1].len != 8)  { ret 1; }
    if (out.sections[0].align != 16 || out.sections[1].align != 8)       { ret 1; }
    if (out.sections[0].bytes == nil)                                    { ret 1; }
    if (out.sections[0].bytes[0] != 0xE8)                                { ret 1; }

    var saw_main: bool = false;
    var saw_ext:  bool = false;
    var si:       u32  = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == main_name) {
            saw_main = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
            if (of.section_index(out.symbols[si].section) != 0)          { ret 1; }
        }
        if (out.symbols[si].name == ext_name) {
            saw_ext = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) == 0) { ret 1; }
            if (!of.section_is_external(out.symbols[si].section))      { ret 1; }
        }
        si = si + 1;
    }
    if (!saw_main || !saw_ext) { ret 1; }

    var ok_plt: bool = false;
    var ok_pc:  bool = false;
    var ok_abs: bool = false;
    var rj:     u32  = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (rr.offset == 1 && rr.kind == of.RK_PLT32 && of.reloc_symbol_name(?out, rr) == ext_name && rr.addend == -4) { ok_plt = true; }
        if (rr.offset == 8 && rr.kind == of.RK_PC32 && of.reloc_symbol_name(?out, rr) == g_name && rr.addend == -4)    { ok_pc = true; }
        if (rr.offset == 16 && rr.kind == of.RK_ABS64 && of.reloc_symbol_name(?out, rr) == g_name && rr.addend == 0)   { ok_abs = true; }
        rj = rj + 1;
    }
    if (!ok_plt || !ok_pc || !ok_abs) { ret 1; }
    ret 0;
}

test object__x86_64_got_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var data_bytes: [32]u8;
    var k:          usize = 0;
    for (k < 8) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    k = 0;
    for (k < 32) {
        data_bytes[k] = 0;
        k             = k + 1;
    }
    text_bytes[0] = 0x48;
    text_bytes[1] = 0x8B;
    text_bytes[2] = 0x05;

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 32;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "_external");
    syms[1].section = of.external_section();
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [5]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 3;
    relocs[0].kind    = of.RK_GOTPCREL;
    relocs[0].sym     = 1;
    relocs[0].addend  = -4;
    relocs[1].section = of.section_id(1);
    relocs[1].offset  = 0;
    relocs[1].kind    = of.RK_GOTPCREL_NORELAX;
    relocs[1].sym     = 1;
    relocs[1].addend  = -4;
    relocs[2].section = of.section_id(1);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_GOTPCREL64_NORELAX;
    relocs[2].sym     = 1;
    relocs[2].addend  = -8;
    relocs[3].section = of.section_id(1);
    relocs[3].offset  = 16;
    relocs[3].kind    = of.RK_GOTPCREL64_NORELAX;
    relocs[3].sym     = 1;
    relocs[3].addend  = 9223372036854775807;
    relocs[4].section = of.section_id(1);
    relocs[4].offset  = 24;
    relocs[4].kind    = of.RK_GOTPCREL64_NORELAX;
    relocs[4].sym     = 1;
    relocs[4].addend  = -9223372036854775807 - 1;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "got");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 5;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_got");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str            = fixture.path(?tf);
    val em:    err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = format.t_find_lc(buf.data, format.LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val text_sh:     usize = seg + format.SEGMENT_CMD_64_SIZE;
    val data_sh:     usize = text_sh + format.SECTION_64_SIZE;
    val load_e:      usize = t_find_reloc(buf.data, text_sh, 3);
    val got32_e:     usize = t_find_reloc(buf.data, data_sh, 0);
    val got64_e:     usize = t_find_reloc(buf.data, data_sh, 8);
    val got64_max_e: usize = t_find_reloc(buf.data, data_sh, 16);
    val got64_min_e: usize = t_find_reloc(buf.data, data_sh, 24);
    if (load_e == 0 || got32_e == 0 || got64_e == 0
        || got64_max_e == 0 || got64_min_e == 0) { ret 1; }
    val load_w:  u32 = bin.read_u32_le(buf.data, load_e + 4);
    val got32_w: u32 = bin.read_u32_le(buf.data, got32_e + 4);
    val got64_w: u32 = bin.read_u32_le(buf.data, got64_e + 4);
    if (((load_w >> 28) & 0xF) != format.X86_64_RELOC_GOT_LOAD || ((load_w >> 25) & 3) != 2) { ret 1; }
    if (((got32_w >> 28) & 0xF) != format.X86_64_RELOC_GOT || ((got32_w >> 25) & 3) != 2)    { ret 1; }
    if (((got64_w >> 28) & 0xF) != format.X86_64_RELOC_GOT || ((got64_w >> 25) & 3) != 3)    { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)           { ret 1; }
    if (out.reloc_count != 5) { ret 1; }
    if (t_reloc_at(?out, 0, 3).kind != of.RK_GOTPCREL
        || t_reloc_at(?out, 0, 3).addend != -4) { ret 1; }
    if (t_reloc_at(?out, 1, 0).kind != of.RK_GOTPCREL_NORELAX
        || t_reloc_at(?out, 1, 0).addend != -4) { ret 1; }
    if (t_reloc_at(?out, 1, 8).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 8).addend != -8) { ret 1; }
    if (t_reloc_at(?out, 1, 16).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 16).addend != 9223372036854775807) { ret 1; }
    if (t_reloc_at(?out, 1, 24).kind != of.RK_GOTPCREL64_NORELAX
        || t_reloc_at(?out, 1, 24).addend != -9223372036854775807 - 1) { ret 1; }

    bin.write_u32_le(buf.data, load_e + 4, load_w & 0xFEFFFFFF);
    var bad_pc: of.ObjectImage;
    val pp:     err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_pc);
    if (sel pp.ok)                                               { ret 1; }
    if (!str_contains(fail.describe(pp.err), "not pc-relative")) { ret 1; }
    bin.write_u32_le(buf.data, load_e + 4, load_w);

    val text_off: usize = bin.read_u32_le(buf.data, text_sh + 48)::usize;
    buf.data[text_off + 1] = 0x8D;
    var bad_insn: of.ObjectImage;
    val pi:       err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_insn);
    if (sel pi.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(pi.err), "RIP-relative MOVQ")) { ret 1; }
    buf.data[text_off + 1] = 0x8B;

    bin.write_u32_le(buf.data, got32_e + 4, (got32_w & 0xF9FFFFFF) | (1 << 25));
    var bad_width: of.ObjectImage;
    val pw:        err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_width);
    if (sel pw.ok)                                                     { ret 1; }
    if (!str_contains(fail.describe(pw.err), "neither 4 nor 8 bytes")) { ret 1; }
    ret 0;
}

test object__x86_64_signed_variants {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) {
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = -5;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_PC32;
    relocs[1].sym     = 1;
    relocs[1].addend  = -6;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_PC32;
    relocs[2].sym     = 1;
    relocs[2].addend  = -8;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "signed");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 3;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_signed");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str            = fixture.path(?tf);
    val em:    err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = format.t_find_lc(buf.data, format.LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0:      usize = seg + format.SEGMENT_CMD_64_SIZE;
    val text_off: usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    if (!t_set_reloc_type(buf.data, sh0, 0, format.X86_64_RELOC_SIGNED_1)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 4, format.X86_64_RELOC_SIGNED_2)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 8, format.X86_64_RELOC_SIGNED_4)) { ret 1; }
    if (bin.read_u32_le(buf.data, text_off) != 0xFFFFFFFF)                 { ret 1; }
    if (bin.read_u32_le(buf.data, text_off + 4) != 0xFFFFFFFE)             { ret 1; }
    if (bin.read_u32_le(buf.data, text_off + 8) != 0xFFFFFFFC)             { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }
    val r1: *of.Relocation = t_reloc_at(?out, 0, 0);
    val r2: *of.Relocation = t_reloc_at(?out, 0, 4);
    val r4: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (r1 == nil || r2 == nil || r4 == nil)      { ret 1; }
    if (r1.kind != of.RK_PC32 || r1.addend != -5) { ret 1; }
    if (r2.kind != of.RK_PC32 || r2.addend != -6) { ret 1; }
    if (r4.kind != of.RK_PC32 || r4.addend != -8) { ret 1; }

    val tf2_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_signed_rt");
    if (sel tf2_r.err) { ret 1; }
    var tf2: fixture.Output = tf2_r.ok;
    fin { fixture.dnit(?tf2); }
    val tpath2: str            = fixture.path(?tf2);
    val em2:    err[fail.Fail] = object.emit_object(?isa_vt, ?out, tpath2);
    if (sel em2.err) { ret 1; }
    val rb2: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath2);

    if (sel rb2.err) { ret 1; }
    val buf2: Vector[u8] = rb2.ok;
    val seg2: usize      = format.t_find_lc(buf2.data, format.LC_SEGMENT_64);
    if (seg2 == 0) { ret 1; }
    val sh2: usize = seg2 + format.SEGMENT_CMD_64_SIZE;
    val e1:  usize = t_find_reloc(buf2.data, sh2, 0);
    val e2:  usize = t_find_reloc(buf2.data, sh2, 4);
    val e4:  usize = t_find_reloc(buf2.data, sh2, 8);
    if (e1 == 0 || e2 == 0 || e4 == 0)                                                    { ret 1; }
    if (((bin.read_u32_le(buf2.data, e1 + 4) >> 28) & 0xF) != format.X86_64_RELOC_SIGNED) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e2 + 4) >> 28) & 0xF) != format.X86_64_RELOC_SIGNED) { ret 1; }
    if (((bin.read_u32_le(buf2.data, e4 + 4) >> 28) & 0xF) != format.X86_64_RELOC_SIGNED) { ret 1; }
    var out2: of.ObjectImage;
    val pr2:  err[fail.Fail] = parse_object(?alloc, ?i, buf2.data, buf2.len, ?out2);
    if (sel pr2.err) { ret 1; }
    if (t_reloc_at(?out2, 0, 0).addend != -5 || t_reloc_at(?out2, 0, 4).addend != -6
        || t_reloc_at(?out2, 0, 8).addend != -8) { ret 1; }

    val original_word: u32 = bin.read_u32_le(buf.data, t_find_reloc(buf.data, sh0, 8) + 4);
    bin.write_u32_le(buf.data, t_find_reloc(buf.data, sh0, 8), 14);
    var bad_bounds: of.ObjectImage;
    val pb:         err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_bounds);
    if (sel pb.ok)                                             { ret 1; }
    if (!str_contains(fail.describe(pb.err), "out of bounds")) { ret 1; }
    bin.write_u32_le(buf.data, t_find_reloc(buf.data, sh0, 14), 8);
    val e_bad: usize = t_find_reloc(buf.data, sh0, 8);
    bin.write_u32_le(buf.data, e_bad + 4, (original_word & 0xF9FFFFFF) | (1 << 25));
    var bad_width: of.ObjectImage;
    val pw:        err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_width);
    if (sel pw.ok)                                           { ret 1; }
    if (!str_contains(fail.describe(pw.err), "not 4 bytes")) { ret 1; }
    bin.write_u32_le(buf.data, e_bad + 4, original_word & 0xFEFFFFFF);
    var bad_pcrel: of.ObjectImage;
    val pp:        err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_pcrel);
    if (sel pp.ok)                                               { ret 1; }
    if (!str_contains(fail.describe(pp.err), "not pc-relative")) { ret 1; }
    ret 0;
}

test object__relro_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes:  [8]u8;
    var ro_bytes:    [8]u8;
    var relro_bytes: [8]u8;
    var k:           usize = 0;
    for (k < 8) {
        text_bytes[k]  = 0;
        ro_bytes[k]    = 0;
        relro_bytes[k] = 0;
        k              = k + 1;
    }

    var secs: [3]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".rodata");
    secs[1].kind  = of.SK_RODATA;
    secs[1].bytes = ?ro_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;
    secs[1].flags = of.SEC_FLAG_RETAIN;
    secs[2].name  = format.t_intern(?i, ".data.rel.ro");
    secs[2].kind  = of.SK_RELRO;
    secs[2].bytes = ?relro_bytes[0];
    secs[2].len   = 8;
    secs[2].align = 8;

    var syms: [1]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(2);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = 0;
    relocs[0].addend  = 0x10;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 3;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_relro");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 3) { ret 1; }
    var saw_text:  bool = false;
    var saw_ro:    bool = false;
    var saw_relro: bool = false;
    var retained:  u32  = 0;
    var s:         u32  = 0;
    for (s < out.section_count) {
        if (out.sections[s].kind == of.SK_TEXT)   { saw_text = true; }
        if (out.sections[s].kind == of.SK_RODATA) { saw_ro = true; }
        if (out.sections[s].kind == of.SK_RELRO)  { saw_relro = true; }
        if ((out.sections[s].flags & of.SEC_FLAG_RETAIN) != 0) {
            if (out.sections[s].kind != of.SK_RODATA) { ret 1; }
            retained = retained + 1;
        }
        s = s + 1;
    }
    if (!saw_text || !saw_ro || !saw_relro) { ret 1; }
    if (retained != 1)                      { ret 1; }

    if (out.reloc_count != 1)                                                        { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS64 || out.relocations[0].addend != 0x10) { ret 1; }
    ret 0;
}

test object__arm64_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_AARCH64);

    var text_bytes: [16]u8;
    bin.write_u32_le(?text_bytes[0], 0, 0x90000000);
    bin.write_u32_le(?text_bytes[0], 4, 0x91000000);
    bin.write_u32_le(?text_bytes[0], 8, 0xF9400001);
    bin.write_u32_le(?text_bytes[0], 12, 0x94000000);
    var data_bytes: [8]u8;
    var k:          usize = 0;
    for (k < 8) {
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 4;
    secs[1].name  = format.t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name    = format.t_intern(?i, "ext_func");
    syms[2].section = of.external_section();
    syms[2].offset  = 0;
    syms[2].size    = 0;
    syms[2].flags   = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [5]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PAGE21;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_ADD_LO12;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_LDST64_LO12;
    relocs[2].sym     = 1;
    relocs[2].addend  = 0x10;
    relocs[3].section = of.section_id(0);
    relocs[3].offset  = 12;
    relocs[3].kind    = of.RK_PLT32;
    relocs[3].sym     = 2;
    relocs[3].addend  = 0;
    relocs[4].section = of.section_id(1);
    relocs[4].offset  = 0;
    relocs[4].kind    = of.RK_ABS64;
    relocs[4].sym     = 0;
    relocs[4].addend  = 0x20;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 3;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 5;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_a64");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, 0) != format.MH_MAGIC_64)    { ret 1; }
    if (bin.read_u32_le(buf.data, 4) != format.CPU_TYPE_ARM64) { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != format.MH_OBJECT)     { ret 1; }
    val text_sh: usize = format.MACH_HEADER_64_SIZE + format.SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, text_sh + 60) != 5) { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)             { ret 1; }
    if (out.section_count != 2) { ret 1; }
    if (out.reloc_count != 5)   { ret 1; }

    var ok_page: bool = false;
    var ok_add:  bool = false;
    var ok_ldst: bool = false;
    var ok_br:   bool = false;
    var ok_abs:  bool = false;
    var rj:      u32  = 0;
    for (rj < out.reloc_count) {
        val rr: *of.Relocation = ?out.relocations[rj];
        if (of.section_index(rr.section) == 0 && rr.offset == 0 && rr.kind == of.RK_PAGE21 && of.reloc_symbol_name(?out, rr) == syms[1].name)                           { ok_page = true; }
        if (of.section_index(rr.section) == 0 && rr.offset == 4 && rr.kind == of.RK_ADD_LO12 && of.reloc_symbol_name(?out, rr) == syms[1].name)                         { ok_add = true; }
        if (of.section_index(rr.section) == 0 && rr.offset == 8 && rr.kind == of.RK_LDST64_LO12 && of.reloc_symbol_name(?out, rr) == syms[1].name && rr.addend == 0x10) { ok_ldst = true; }
        if (of.section_index(rr.section) == 0 && rr.offset == 12 && rr.kind == of.RK_PLT32 && of.reloc_symbol_name(?out, rr) == syms[2].name)                           { ok_br = true; }
        if (of.section_index(rr.section) == 1 && rr.offset == 0 && rr.kind == of.RK_ABS64 && of.reloc_symbol_name(?out, rr) == syms[0].name && rr.addend == 0x20)       { ok_abs = true; }
        rj = rj + 1;
    }
    if (!ok_page || !ok_add || !ok_ldst || !ok_br || !ok_abs) { ret 1; }
    ret 0;
}

# an `ext val` read on aarch64 is an ADRP/LDR pair carrying the GOT kinds; the
# object writes them as ARM64_RELOC_GOT_LOAD_PAGE21/PAGEOFF12 and the parser
# reads them back, refusing the shapes a GOT slot cannot have: an addend, a
# section-based target, an ADDEND entry in front (#3675)
test object__arm64_got_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_AARCH64);

    var text_bytes: [12]u8;
    bin.write_u32_le(?text_bytes[0], 0, 0x90000008);
    bin.write_u32_le(?text_bytes[0], 4, 0xF9400108);
    bin.write_u32_le(?text_bytes[0], 8, 0xD65F03C0);

    var secs: [1]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 12;
    secs[0].align = 4;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 12;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "_cell");
    syms[1].section = of.external_section();
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_GOT_PAGE21;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_GOT_LO12;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "got_a64");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 2;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_got_a64");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    relocs[1].addend = 8;
    val em_addend: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em_addend.ok)                                                 { ret 1; }
    if (!str_contains(fail.describe(em_addend.err), "carries an addend")) { ret 1; }
    relocs[1].addend = 0;

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val text_sh: usize = format.MACH_HEADER_64_SIZE + format.SEGMENT_CMD_64_SIZE;
    if (bin.read_u32_le(buf.data, text_sh + 60) != 2) { ret 1; }
    val page_e: usize = t_find_reloc(buf.data, text_sh, 0);
    val lo_e:   usize = t_find_reloc(buf.data, text_sh, 4);
    if (page_e == 0 || lo_e == 0) { ret 1; }
    val page_w: u32 = bin.read_u32_le(buf.data, page_e + 4);
    val lo_w:   u32 = bin.read_u32_le(buf.data, lo_e + 4);
    if (((page_w >> 28) & 0xF) != format.ARM64_RELOC_GOT_LOAD_PAGE21 || ((page_w >> 24) & 1) != 1
        || ((page_w >> 25) & 3) != 2 || ((page_w >> 27) & 1) != 1) { ret 1; }
    if (((lo_w >> 28) & 0xF) != format.ARM64_RELOC_GOT_LOAD_PAGEOFF12 || ((lo_w >> 24) & 1) != 0
        || ((lo_w >> 25) & 3) != 2 || ((lo_w >> 27) & 1) != 1) { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)           { ret 1; }
    if (out.reloc_count != 2) { ret 1; }
    val page_r: *of.Relocation = t_reloc_at(?out, 0, 0);
    val lo_r:   *of.Relocation = t_reloc_at(?out, 0, 4);
    if (page_r == nil || lo_r == nil) { ret 1; }
    if (page_r.kind != of.RK_GOT_PAGE21 || page_r.addend != 0
        || of.reloc_symbol_name(?out, page_r) != syms[1].name) { ret 1; }
    if (lo_r.kind != of.RK_GOT_LO12 || lo_r.addend != 0
        || of.reloc_symbol_name(?out, lo_r) != syms[1].name) { ret 1; }

    bin.write_u32_le(buf.data, lo_e + 4, (lo_w & 0xF7FFFFFF) | 1);
    var bad_sect: of.ObjectImage;
    val ps:       err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_sect);
    if (sel ps.ok)                                                { ret 1; }
    if (!str_contains(fail.describe(ps.err), "not symbol-based")) { ret 1; }
    bin.write_u32_le(buf.data, lo_e + 4, lo_w);

    val text_off: usize = bin.read_u32_le(buf.data, text_sh + 48)::usize;
    bin.write_u32_le(buf.data, text_off + 4, 0x39400108);
    var bad_insn: of.ObjectImage;
    val pi:       err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_insn);
    if (sel pi.ok)                                          { ret 1; }
    if (!str_contains(fail.describe(pi.err), "64-bit LDR")) { ret 1; }
    bin.write_u32_le(buf.data, text_off + 4, 0xF9400108);

    bin.write_u32_le(buf.data, page_e, 4);
    bin.write_u32_le(buf.data, page_e + 4, (format.ARM64_RELOC_ADDEND << 28) | (2 << 25) | 8);
    var bad_addend: of.ObjectImage;
    val pa:         err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?bad_addend);
    if (sel pa.ok)                                                       { ret 1; }
    if (!str_contains(fail.describe(pa.err), "follows an ADDEND entry")) { ret 1; }
    ret 0;
}

test object__generated_sections_coalesce_without_erasing_placement {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    val ndata:   u32 = 260;
    val total:   u32 = 1 + ndata;
    val tgt_sec: u32 = 255;

    val rsec: res[*of.Section, A.Error] = A.zallocate[of.Section](?alloc, total::usize);
    if (sel rsec.err) { ret 1; }
    var secs: *of.Section = rsec.ok;

    var text_bytes: [8]u8;
    var k:          usize = 0;
    for (k < 8) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    text_bytes[0] = 0xE8;

    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;

    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) {
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var s: u32 = 1;
    for (s < total) {
        secs[s].name  = format.t_intern(?i, ".rodata");
        secs[s].kind  = of.SK_RODATA;
        secs[s].align = 8;
        secs[s].flags = of.SEC_FLAG_COALESCE;
        if (s == 1) {
            secs[s].flags = 0;
            secs[s].name  = format.t_intern(?i, ".explicit");
        }
        if (s == tgt_sec) {
            secs[s].bytes = ?data_bytes[0];
            secs[s].len   = 8;
        }
        or {
            secs[s].bytes = nil;
            secs[s].len   = 0;
        }
        s = s + 1;
    }

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, ".Lc.target");
    syms[1].section = of.section_id(tgt_sec);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 1;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = -4;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "test");
    img.sections      = secs;
    img.section_count = total;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_many");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 3 || out.sections[1].name != secs[1].name) { ret 1; }

    if (out.reloc_count != 1)                                            { ret 1; }
    if (of.reloc_symbol_name(?out, ?out.relocations[0]) != syms[1].name) { ret 1; }

    var found: bool = false;
    var si:    u32  = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[1].name) {
            found = true;
            if (of.section_is_external(out.symbols[si].section))                              { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) != 0)                        { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0)                        { ret 1; }
            if (of.section_index(out.symbols[si].section) >= out.section_count)               { ret 1; }
            if (out.sections[of.section_index(out.symbols[si].section)].kind != of.SK_RODATA) { ret 1; }
        }
        si = si + 1;
    }
    if (!found) { ret 1; }

    # a codegen image's carrier gives the merged sections back apart, with the
    # symbol sizes, the instruction end and the frame mach-o cannot spell
    var frames: [1]of.FrameUnwind;
    frames[0].section    = of.section_id(0);
    frames[0].offset     = 0;
    frames[0].step_count = 1;
    frames[0].steps[0]   = of.FrameStep{kind: of.FRAME_STEP_PUSH, reg: 5, end_off: 1, value: 0};
    img.frames           = ?frames[0];
    img.frame_count      = 1;
    relocs[0].inst_end   = 4;
    secs[tgt_sec].flags  = of.SEC_FLAG_MERGEABLE | of.SEC_FLAG_COALESCE;
    img.codegen          = true;
    val carried: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel carried.err) { ret 4; }
    val cb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    if (sel cb.err) { ret 4; }
    var back: of.ObjectImage;
    val bp:   err[fail.Fail] = parse_object(?alloc, ?i, cb.ok.data, cb.ok.len, ?back);
    if (sel bp.err)                                                                               { ret 5; }
    if (!back.codegen || back.section_count != total + 1)                                         { ret 6; }
    if (back.sections[tgt_sec].len != 8 || back.sections[tgt_sec].flags != of.SEC_FLAG_MERGEABLE) { ret 7; }
    if (back.reloc_count != 1 || back.relocations[0].inst_end != 4)                               { ret 8; }
    if (back.frame_count != 1 || of.section_index(back.frames[0].section) != 0)                   { ret 9; }
    si = 0;
    for (si < back.symbol_count) {
        val sym: *of.Symbol = ?back.symbols[si];
        if (sym.name == syms[1].name
            && (of.section_index(sym.section) != tgt_sec || sym.offset != 0 || sym.size != 8
            || sym.flags != of.SYM_OBJ_FLAG_OBJECT)) { ret 10; }
        si = si + 1;
    }
    img.frames      = nil;
    img.frame_count = 0;
    img.codegen     = false;

    s = 0;
    for (s < total) {
        secs[s].flags = 0;
        s             = s + 1;
    }
    val explicit_refused: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel explicit_refused.ok) { ret 2; }
    s = 0;
    for (s < total) {
        secs[s].native.format = of.OF_MACHO;
        format.write_fixed16(?secs[s].native.name[0], 0, "__native");
        s = s + 1;
    }
    val native_refused: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel native_refused.ok) { ret 3; }
    ret 0;
}

test parse_object__refuses_bad_magic_and_truncation {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var junk: [32]u8;
    var k:    usize = 0;
    for (k < 32) {
        junk[k] = 0;
        k       = k + 1;
    }
    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, ?junk[0], 32, ?out);
    if (!sel pr.err)                                       { ret 1; }
    if (!str_contains(fail.describe(pr.err), "bad magic")) { ret 1; }

    var tiny: [8]u8;
    k = 0;
    for (k < 8) {
        tiny[k] = 0;
        k       = k + 1;
    }
    var out2: of.ObjectImage;
    val pr2:  err[fail.Fail] = parse_object(?alloc, ?i, ?tiny[0], 8, ?out2);
    if (!sel pr2.err) { ret 1; }
    ret 0;
}

# a hidden definition is a private extern on Mach-O: `N_PEXT` beside `N_EXT`, so
# it stays in the external-definition range of the symbol table (nothing about the
# dysymtab partition moves) and comes back hidden when the object is read (#3412)
test emit_object__hidden_definition_as_private_extern {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var k:          usize = 0;
    for (k < 8) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    var secs: [1]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_open_fn");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 4;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "_shut_fn");
    syms[1].section = of.section_id(0);
    syms[1].offset  = 4;
    syms[1].size    = 4;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_HIDDEN;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "hidden");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_hidden");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, fixture.path(?tf));
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?tf));
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    var seen: u32 = 0;
    var si:   u32 = 0;
    for (si < out.symbol_count) {
        val sym:    *of.Symbol = ?out.symbols[si];
        val hidden: bool       = (sym.flags & of.SYM_OBJ_FLAG_HIDDEN) != 0;
        if (sym.name == syms[0].name) {
            seen = seen + 1;
            if (hidden)                                      { ret 2; }
            if ((sym.native.kind & format.N_PEXT::u32) != 0) { ret 3; }
        }
        if (sym.name == syms[1].name) {
            seen = seen + 1;
            if (!hidden) { ret 4; }
            # the native spelling, and still external so the dysymtab ranges hold
            if ((sym.native.kind & format.N_PEXT::u32) == 0) { ret 5; }
            if ((sym.native.kind & format.N_EXT::u32) == 0)  { ret 6; }
            if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) == 0)   { ret 7; }
        }
        si = si + 1;
    }
    if (seen != 2) { ret 8; }
    ret 0;
}

# the request list has no native mach-o spelling, so it rides in
# `__MACH,__mach_exports` and is consumed on read (#3423)
test emit_object__export_requests_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var k:          usize = 0;
    for (k < 8) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    var secs: [1]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_shut_fn");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_HIDDEN;

    val first:    intern.StrId    = format.t_intern(?i, "_shut_fn");
    val second:   intern.StrId    = format.t_intern(?i, "_a_dependency_pub");
    var requests: [2]intern.StrId = [2]intern.StrId{first, second};

    var img: of.ObjectImage = of.object_image_init(?alloc, ?i, format.t_intern(?i, "exports"));
    img.sections             = ?secs[0];
    img.section_count        = 1;
    img.symbols              = ?syms[0];
    img.symbol_count         = 1;
    img.export_requests      = ?requests[0];
    img.export_request_count = 2;
    # the object cache's record rides beside the requests in `__MACH,__mach_cache`
    var stamp: [2]u8 = [2]u8{4, 2};
    img.cache_record     = ?stamp[0];
    img.cache_record_len = 2;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_exports");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, fixture.path(?tf));
    if (sel em.err)             { ret 1; }
    if (img.section_count != 1) { ret 2; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?tf));
    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;
    if (!format.t_bytes_contain(buf.data, 0, buf.len, object.EXPORTS_SECTNAME)) { ret 3; }
    if (!format.t_bytes_contain(buf.data, 0, buf.len, object.RECORD_SECTNAME))  { ret 3; }
    if (!format.t_bytes_contain(buf.data, 0, buf.len, object.EXPORTS_SEGNAME))  { ret 4; }
    if (format.t_bytes_contain(buf.data, 0, buf.len, "__DWARF"))                { ret 5; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)                                                          { ret 6; }
    if (out.export_request_count != 2)                                       { ret 7; }
    if (out.export_requests[0] != first || out.export_requests[1] != second) { ret 8; }
    val husk: opt[u32] = exports.find(?out, format.t_intern(?i, object.EXPORTS_SECTNAME));
    if (sel husk.none) { ret 9; }
    val hs: *of.Section = ?out.sections[husk.some];
    if (hs.len != 0 || hs.bytes != nil || hs.kind != of.SK_DEBUG) { ret 10; }
    if (out.cache_record_len != 2 || out.cache_record[1] != 2)    { ret 13; }
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == first && (out.symbols[si].flags & of.SYM_OBJ_FLAG_HIDDEN) == 0) { ret 11; }
        si = si + 1;
    }

    # a relocatable re-emit fills the husk rather than adding a second section
    val again: err[fail.Fail] = object.emit_object(?isa_vt, ?out, fixture.path(?tf));
    if (sel again.err) { ret 12; }
    val rb2: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, fixture.path(?tf));
    if (sel rb2.err) { ret 1; }
    val buf2:  Vector[u8]     = rb2.ok;
    var twice: of.ObjectImage;
    val pr2:   err[fail.Fail] = parse_object(?alloc, ?i, buf2.data, buf2.len, ?twice);
    if (sel pr2.err)                                                                 { ret 13; }
    if (twice.section_count != out.section_count || twice.export_request_count != 2) { ret 14; }
    ret 0;
}

test emit_object__debug_dwarf_round_trip {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var k:          usize = 0;
    for (k < 8) {
        text_bytes[k] = 0x90;
        k             = k + 1;
    }
    var info_bytes: [8]u8;
    k = 0;
    for (k < 8) {
        info_bytes[k] = 0;
        k             = k + 1;
    }
    var str_bytes: [6]u8;
    str_bytes[0] = 'h';
    str_bytes[1] = 'i';
    str_bytes[2] = 0;
    str_bytes[3] = 'y';
    str_bytes[4] = 'o';
    str_bytes[5] = 0;

    var secs: [3]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 8;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".debug_info");
    secs[1].kind  = of.SK_DEBUG;
    secs[1].bytes = ?info_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 1;
    secs[2].name  = format.t_intern(?i, ".debug_str");
    secs[2].kind  = of.SK_DEBUG;
    secs[2].bytes = ?str_bytes[0];
    secs[2].len   = 6;
    secs[2].align = 1;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 8;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "l.debug_str");
    syms[1].section = of.section_id(2);
    syms[1].offset  = 0;
    syms[1].size    = 0;
    syms[1].flags   = 0;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(1);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ABS32;
    relocs[0].sym     = 1;
    relocs[0].addend  = 3;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 3;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_odbg");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u32_le(buf.data, format.MACH_HEADER_64_SIZE + 64) != 3) { ret 1; }
    if (!format.t_bytes_contain(buf.data, 0, buf.len, "__debug_info"))   { ret 1; }
    if (!format.t_bytes_contain(buf.data, 0, buf.len, "__debug_str"))    { ret 1; }
    if (!format.t_bytes_contain(buf.data, 0, buf.len, "__DWARF"))        { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 3) { ret 1; }

    val cid_info:   intern.StrId = format.t_intern(?i, ".debug_info");
    val cid_str:    intern.StrId = format.t_intern(?i, ".debug_str");
    var found_info: bool         = false;
    var found_str:  bool         = false;
    var si:         u32          = 0;
    for (si < out.section_count) {
        val sec: *of.Section = ?out.sections[si];
        if (sec.kind == of.SK_DEBUG && sec.name == cid_info) { found_info = true; }
        if (sec.kind == of.SK_DEBUG && sec.name == cid_str)  { found_str = true; }
        si = si + 1;
    }
    if (!found_info || !found_str) { ret 1; }

    if (out.reloc_count != 1)                   { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS32) { ret 1; }
    if (out.relocations[0].addend != 3)         { ret 1; }
    ret 0;
}

#[testing]
fun t_make_section_based(buf: *u8, sh: usize, address: u32, sect: u32) bool {
    val e: usize = t_find_reloc(buf, sh, address);
    if (e == 0) { ret false; }
    bin.write_u32_le(buf, e + 4, (bin.read_u32_le(buf, e + 4) & 0xF7000000) | sect);
    ret true;
}

#[testing]
fun t_find_reloc(buf: *u8, sh: usize, address: u32) usize {
    val reloff: usize = bin.read_u32_le(buf, sh + 56)::usize;
    val nreloc: u32   = bin.read_u32_le(buf, sh + 60);
    var r:      u32   = 0;
    for (r < nreloc) {
        val e: usize = reloff + r::usize * format.RELOC_INFO_SIZE;
        if (bin.read_u32_le(buf, e) == address) { ret e; }
        r = r + 1;
    }
    ret 0;
}

#[testing]
fun t_set_reloc_type(buf: *u8, sh: usize, address: u32, r_type: u32) bool {
    val e: usize = t_find_reloc(buf, sh, address);
    if (e == 0) { ret false; }
    bin.write_u32_le(buf, e + 4, (bin.read_u32_le(buf, e + 4) & 0x0FFFFFFF) | (r_type << 28));
    ret true;
}

#[testing]
fun t_reloc_at(img: *of.ObjectImage, sec: u32, off: u32) *of.Relocation {
    var r: u32 = 0;
    for (r < img.reloc_count) {
        if (of.section_index(img.relocations[r].section) == sec && img.relocations[r].offset == off) { ret ?img.relocations[r]; }
        r = r + 1;
    }
    ret nil;
}

#[testing]
fun t_sym_named(img: *of.ObjectImage, name: intern.StrId) *of.Symbol {
    var s: u32 = 0;
    for (s < img.symbol_count) {
        if (img.symbols[s].name == name) { ret ?img.symbols[s]; }
        s = s + 1;
    }
    ret nil;
}

test parse_object__section_reloc_x86_64 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);

    var text_bytes: [24]u8;
    var k:          usize = 0;
    for (k < 24) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) {
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 24;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 24;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 8;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = -4;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 16;
    relocs[1].kind    = of.RK_ABS64;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 2;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_secrel");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = format.t_find_lc(buf.data, format.LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0:       usize = seg + format.SEGMENT_CMD_64_SIZE;
    val sh1:       usize = sh0 + format.SECTION_64_SIZE;
    val text_addr: u64   = bin.read_u64_le(buf.data, sh0 + 32);
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val data_addr: u64   = bin.read_u64_le(buf.data, sh1 + 32);
    val target:    u64   = data_addr + 6;

    if (!t_make_section_based(buf.data, sh0, 8, 2))  { ret 1; }
    if (!t_make_section_based(buf.data, sh0, 16, 2)) { ret 1; }
    bin.write_u64_le(buf.data, text_off + 16, target);
    bin.write_u32_le(buf.data, text_off + 8, (target::i64 - (text_addr + 8 + 4)::i64)::u32);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.symbol_count != 3) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, format.t_intern(?i, "__DATA,__data"));
    if (anchor == nil)                                               { ret 1; }
    if (of.section_index(anchor.section) != 1 || anchor.offset != 0) { ret 1; }
    if (anchor.size != 0 || anchor.flags != 0)                       { ret 1; }

    val abs64: *of.Relocation = t_reloc_at(?out, 0, 16);
    if (abs64 == nil)                               { ret 1; }
    if (abs64.kind != of.RK_ABS64)                  { ret 1; }
    if (abs64.sym >= out.symbol_count)              { ret 1; }
    if (out.symbols[abs64.sym].name != anchor.name) { ret 1; }
    if (abs64.addend != 6)                          { ret 1; }

    val pc32: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (pc32 == nil)                               { ret 1; }
    if (pc32.kind != of.RK_PC32)                   { ret 1; }
    if (pc32.sym >= out.symbol_count)              { ret 1; }
    if (out.symbols[pc32.sym].name != anchor.name) { ret 1; }
    if (pc32.addend != 2)                          { ret 1; }
    ret 0;
}

test parse_object__section_reloc_x86_64_signed_variants {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt:     of.ObjectTarget = format.t_isa(isa.ARCH_X86_64);
    var text_bytes: [16]u8;
    var data_bytes: [16]u8;
    var k:          usize           = 0;
    for (k < 16) {
        text_bytes[k] = 0;
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 16;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 6;
    syms[1].size    = 4;
    syms[1].flags   = of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_PC32;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;
    relocs[2].section = of.section_id(0);
    relocs[2].offset  = 8;
    relocs[2].kind    = of.RK_PC32;
    relocs[2].sym     = 1;
    relocs[2].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "section_signed");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 3;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_secsigned");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str            = fixture.path(?tf);
    val em:    err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = format.t_find_lc(buf.data, format.LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0:       usize = seg + format.SEGMENT_CMD_64_SIZE;
    val sh1:       usize = sh0 + format.SECTION_64_SIZE;
    val text_addr: u64   = bin.read_u64_le(buf.data, sh0 + 32);
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val target:    u64   = bin.read_u64_le(buf.data, sh1 + 32) + 6;
    if (!t_make_section_based(buf.data, sh0, 0, 2)
        || !t_make_section_based(buf.data, sh0, 4, 2)
        || !t_make_section_based(buf.data, sh0, 8, 2)) { ret 1; }
    if (!t_set_reloc_type(buf.data, sh0, 0, format.X86_64_RELOC_SIGNED_1)
        || !t_set_reloc_type(buf.data, sh0, 4, format.X86_64_RELOC_SIGNED_2)
        || !t_set_reloc_type(buf.data, sh0, 8, format.X86_64_RELOC_SIGNED_4)) { ret 1; }
    bin.write_u32_le(buf.data, text_off, (target::i64 - (text_addr + 0 + 4 + 1)::i64)::u32);
    bin.write_u32_le(buf.data, text_off + 4, (target::i64 - (text_addr + 4 + 4 + 2)::i64)::u32);
    bin.write_u32_le(buf.data, text_off + 8, (target::i64 - (text_addr + 8 + 4 + 4)::i64)::u32);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, format.t_intern(?i, "__DATA,__data"));
    if (anchor == nil) { ret 1; }
    val r1: *of.Relocation = t_reloc_at(?out, 0, 0);
    val r2: *of.Relocation = t_reloc_at(?out, 0, 4);
    val r4: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (r1 == nil || r2 == nil || r4 == nil)                                                      { ret 1; }
    if (r1.sym >= out.symbol_count || out.symbols[r1.sym].name != anchor.name || r1.addend != 1)  { ret 1; }
    if (r2.sym >= out.symbol_count || out.symbols[r2.sym].name != anchor.name || r2.addend != 0)  { ret 1; }
    if (r4.sym >= out.symbol_count || out.symbols[r4.sym].name != anchor.name || r4.addend != -2) { ret 1; }

    bin.write_u64_le(buf.data, sh0 + 32, 0xFFFFFFFFFFFFFFF8);
    var overflow: of.ObjectImage;
    val po:       err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?overflow);
    if (sel po.ok)                                                       { ret 1; }
    if (!str_contains(fail.describe(po.err), "overflows address space")) { ret 1; }
    ret 0;
}

test parse_object__section_reloc_arm64 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = format.t_isa(isa.ARCH_AARCH64);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0;
        k             = k + 1;
    }
    text_bytes[3] = 0x90;
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) {
        data_bytes[k] = 0;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = format.t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = format.t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 8;
    secs[1].align = 8;

    var syms: [2]of.Symbol;
    syms[0].name    = format.t_intern(?i, "_main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = format.t_intern(?i, "g");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 8;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PAGE21;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 8;
    relocs[1].kind    = of.RK_ABS64;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = format.t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 2;

    val tf_r: res[fixture.Output, outcome.Fail] = fixture.create(?alloc, "macho_secrela");
    if (sel tf_r.err) { ret 1; }
    var tf: fixture.Output = tf_r.ok;
    fin { fixture.dnit(?tf); }
    val tpath: str = fixture.path(?tf);

    val em: err[fail.Fail] = object.emit_object(?isa_vt, ?img, tpath);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val seg: usize = format.t_find_lc(buf.data, format.LC_SEGMENT_64);
    if (seg == 0) { ret 1; }
    val sh0:       usize = seg + format.SEGMENT_CMD_64_SIZE;
    val sh1:       usize = sh0 + format.SECTION_64_SIZE;
    val text_off:  usize = bin.read_u32_le(buf.data, sh0 + 48)::usize;
    val data_addr: u64   = bin.read_u64_le(buf.data, sh1 + 32);

    if (!t_make_section_based(buf.data, sh0, 8, 2)) { ret 1; }
    bin.write_u64_le(buf.data, text_off + 8, data_addr + 3);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }
    val anchor: *of.Symbol = t_sym_named(?out, format.t_intern(?i, "__DATA,__data"));
    if (anchor == nil) { ret 1; }
    val abs64: *of.Relocation = t_reloc_at(?out, 0, 8);
    if (abs64 == nil)                               { ret 1; }
    if (abs64.sym >= out.symbol_count)              { ret 1; }
    if (out.symbols[abs64.sym].name != anchor.name) { ret 1; }
    if (abs64.addend != 3)                          { ret 1; }

    if (!t_make_section_based(buf.data, sh0, 0, 2)) { ret 1; }
    var out2: of.ObjectImage;
    val pr2:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out2);
    if (sel pr2.ok)                                      { ret 1; }
    if (!str_contains(fail.describe(pr2.err), "page21")) { ret 1; }
    ret 0;
}

