use mach.lang.fail;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.target.of.macho.loadcmd;
use mach.lang.target.of.plan;
use A: std.allocator;
use std.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

pub fun vm_prot_for(flags: u32) u32 {
    var p: u32 = 0;
    if ((flags & of.SEG_FLAG_READ) != 0)    { p = p | loadcmd.VM_PROT_READ; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { p = p | loadcmd.VM_PROT_WRITE; }
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { p = p | loadcmd.VM_PROT_EXECUTE; }
    if (p == 0)                             { p = loadcmd.VM_PROT_READ; }
    ret p;
}

pub fun exec_segname(flags: u32, rebased: bool) str {
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { ret "__TEXT"; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { ret "__DATA"; }
    if (rebased)                            { ret "__DATA_CONST"; }
    ret "__RODATA";
}

pub fun exec_section_flags(sec: *of.LoadSection) res[u32, fail.Fail] {
    val declared: opt[u32] = loadcmd.macho_section_flags(sec.kind);
    if (sel declared.none) { ret res[u32, fail.Fail].err{fail.message("macho: load section kind is outside the SectionKind catalog")}; }
    var flags: u32 = declared.some;
    if ((sec.flags & of.SEC_FLAG_INIT_FUNCS) != 0) {
        flags = (flags & (~loadcmd.SECTION_TYPE)) | loadcmd.S_MOD_INIT_FUNC_POINTERS;
    }
    ret res[u32, fail.Fail].ok{flags};
}

pub fun frame_cmd_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, pagezero: bool) u32 {
    var n: u32 = seg_group_count(dyn, segs, seg_count);
    if (pagezero) { n = n + 1; }
    ret n;
}

pub fun frame_cmd_bytes(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, pagezero: bool) usize {
    ret frame_cmd_count(dyn, segs, seg_count, pagezero)::usize * loadcmd.SEGMENT_CMD_64_SIZE
        + frame_sect_total(segs, seg_count)::usize * loadcmd.SECTION_64_SIZE;
}

pub fun frame_sect_total(segs: *of.LoadSegment, seg_count: u32) u32 {
    var n:  u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        n  = n + segs[li].section_count;
        li = li + 1;
    }
    ret n;
}

pub fun group_sect_count(segs: *of.LoadSegment, first: u32, last: u32) u32 {
    var n: u32 = 0;
    var m: u32 = first;
    for (m <= last) {
        n = n + segs[m].section_count;
        m = m + 1;
    }
    ret n;
}

pub fun exec_sectname(itn: *intern.Interner, sec: *of.LoadSection) res[str, fail.Fail] {
    val nm:     str      = bin.resolve_name(itn, sec.name);
    val canon:  opt[str] = of.canonical_section_name(sec.kind);
    val native: opt[str] = loadcmd.macho_sectname(sec.kind);
    if (sel canon.none)             { ret res[str, fail.Fail].err{fail.message("macho: load section kind is outside the SectionKind catalog")}; }
    if (sel native.none)            { ret res[str, fail.Fail].err{fail.message("macho: load section kind is outside the SectionKind catalog")}; }
    if (nm == nil)                  { ret res[str, fail.Fail].ok{native.some}; }
    if (str_equals(nm, canon.some)) { ret res[str, fail.Fail].ok{native.some}; }
    ret res[str, fail.Fail].ok{nm};
}

pub fun write_load_sections(buf: *u8, off: usize, itn: *intern.Interner, seg: *of.LoadSegment,
    segname: str, fileoff: usize) res[usize, fail.Fail] {
    var w: usize = off;
    var i: u32   = 0;
    for (i < seg.section_count) {
        val sec:  *of.LoadSection = ?seg.sections[i];
        var soff: u32             = 0;
        if (sec.kind != of.SK_BSS) { soff = (fileoff + sec.offset::usize)::u32; }
        val sectname: res[str, fail.Fail] = exec_sectname(itn, sec);
        if (sel sectname.err) { ret res[usize, fail.Fail].err{sectname.err}; }
        val flags: res[u32, fail.Fail] = exec_section_flags(sec);
        if (sel flags.err) { ret res[usize, fail.Fail].err{flags.err}; }
        w = loadcmd.write_section_64(buf, w, sectname.ok, segname,
            seg.vaddr + sec.offset::u64, sec.len::u64, soff,
            sec.align, flags.ok);
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

pub fun write_frame_cmds(buf: *u8, fp: *plan.FilePlan, lc: usize, itn: *intern.Interner, dyn: *of.DynamicInfo,
    segs: *of.LoadSegment, seg_count: u32, seg_offsets: *usize,
    pagezero_size: u64, text_va: u64, hdr_span: usize, exec_page: u64) res[usize, fail.Fail] {
    var off: usize = lc;
    if (pagezero_size > 0) {
        off = loadcmd.write_segment_cmd(buf, off, "__PAGEZERO", 0, pagezero_size, 0, 0, 0, 0, 0);
    }
    if (seg_count == 0) { ret res[usize, fail.Fail].ok{off}; }

    val text_prot: u32                 = seg_vm_prot(dyn, segs, 0);
    val text_vm:   res[u64, fail.Fail] = plan.align_address(fp, "__TEXT", hdr_span::u64 + segs[0].memsz::u64, exec_page);
    if (sel text_vm.err) { ret res[usize, fail.Fail].err{text_vm.err}; }
    var tsec: usize = loadcmd.write_segment_cmd(buf, off, "__TEXT", text_va,
        text_vm.ok,
        0, hdr_span::u64 + segs[0].filesz::u64, text_prot, text_prot,
        segs[0].section_count);
    if (seg_is_data_const(dyn, segs, 0)) { bin.write_u32_le(buf, off + 68, loadcmd.SG_READ_ONLY); }
    val text_written: res[usize, fail.Fail] = write_load_sections(buf, tsec, itn, ?segs[0], "__TEXT", seg_offsets[0]);
    if (sel text_written.err) { ret text_written; }
    off = text_written.ok;

    var li: u32 = 1;
    for (li < seg_count) {
        val last:    u32 = seg_group_last(dyn, segs, seg_count, li);
        val prot:    u32 = seg_vm_prot(dyn, segs, li);
        val gname:   str = exec_segname(segs[li].flags, seg_is_data_const(dyn, segs, li));
        var grp_fsz: u64 = 0;
        var m:       u32 = li;
        for (m <= last) {
            if (segs[m].filesz > 0) { grp_fsz = (seg_offsets[m] + segs[m].filesz - seg_offsets[li])::u64; }
            m = m + 1;
        }
        val grp_vm: res[u64, fail.Fail] = plan.align_address(fp, gname, segs[last].vaddr + segs[last].memsz::u64 - segs[li].vaddr, exec_page);
        if (sel grp_vm.err) { ret res[usize, fail.Fail].err{grp_vm.err}; }
        val grp_vmsz: u64 = grp_vm.ok;

        var lsec: usize = loadcmd.write_segment_cmd(buf, off, gname, segs[li].vaddr, grp_vmsz,
            seg_offsets[li]::u64, grp_fsz, prot, prot,
            group_sect_count(segs, li, last));
        if (seg_is_data_const(dyn, segs, li)) { bin.write_u32_le(buf, off + 68, loadcmd.SG_READ_ONLY); }
        m = li;
        for (m <= last) {
            val written: res[usize, fail.Fail] = write_load_sections(buf, lsec, itn, ?segs[m], gname, seg_offsets[m]);
            if (sel written.err) { ret written; }
            lsec = written.ok;
            m    = m + 1;
        }
        off = lsec;
        li  = last + 1;
    }
    ret res[usize, fail.Fail].ok{off};
}

pub fun write_segment_bytes(buf: *u8, segs: *of.LoadSegment, seg_count: u32, seg_offsets: *usize) {
    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_offsets[li])::ptr, segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }
}

pub fun seg_offset_loc(dyn: *of.DynamicInfo, ls: u32, seg_offset: u32,
    segs: *of.LoadSegment, text_va: u64, pz: u32,
    out_seg: *u32, out_off: *u64) {
    val first: u32 = seg_group_first(dyn, segs, ls);
    @out_seg = pz + seg_group_of(dyn, segs, ls);
    var seg_vmaddr: u64 = segs[first].vaddr;
    if (first == 0) { seg_vmaddr = text_va; }
    @out_off = (segs[ls].vaddr + seg_offset::u64) - seg_vmaddr;
}

pub fun seg_is_rebased(dyn: *of.DynamicInfo, ls: u32) bool {
    if (dyn == nil) { ret false; }
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == ls) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun seg_is_data_const(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) bool {
    if (vm_prot_for(segs[ls].flags) != loadcmd.VM_PROT_READ) { ret false; }
    ret seg_is_rebased(dyn, ls);
}

pub fun seg_vm_prot(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) u32 {
    if (seg_is_data_const(dyn, segs, ls)) { ret loadcmd.VM_PROT_READ | loadcmd.VM_PROT_WRITE; }
    ret vm_prot_for(segs[ls].flags);
}

pub fun seg_same_macho_segment(dyn: *of.DynamicInfo, segs: *of.LoadSegment, a: u32, b: u32) bool {
    if (vm_prot_for(segs[a].flags) != vm_prot_for(segs[b].flags)) { ret false; }
    ret seg_is_data_const(dyn, segs, a) == seg_is_data_const(dyn, segs, b);
}

pub fun seg_group_of(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) u32 {
    var g: u32 = 0;
    var i: u32 = 1;
    for (i <= ls) {
        if (i == 1 || !seg_same_macho_segment(dyn, segs, i, i - 1)) { g = g + 1; }
        i = i + 1;
    }
    ret g;
}

pub fun seg_group_first(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) u32 {
    if (ls == 0) { ret 0; }
    var f: u32 = ls;
    for (f > 1 && seg_same_macho_segment(dyn, segs, f, f - 1)) { f = f - 1; }
    ret f;
}

pub fun seg_group_last(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32, first: u32) u32 {
    if (first == 0) { ret 0; }
    var l: u32 = first;
    for (l + 1 < seg_count && seg_same_macho_segment(dyn, segs, l + 1, l)) { l = l + 1; }
    ret l;
}

pub fun seg_group_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32) u32 {
    if (seg_count == 0) { ret 0; }
    ret seg_group_of(dyn, segs, seg_count - 1) + 1;
}

pub fun data_const_seg_count(dyn: *of.DynamicInfo, segs: *of.LoadSegment, seg_count: u32) u32 {
    var n:  u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        if (seg_is_data_const(dyn, segs, li) && seg_group_first(dyn, segs, li) == li) { n = n + 1; }
        li = li + 1;
    }
    ret n;
}

pub fun data_const_conflict_message(itn: *intern.Interner, alloc: *A.Allocator, dyn: *of.DynamicInfo,
    segs: *of.LoadSegment, seg_count: u32) str {
    val generic: str = "macho: two separated read-only segments carry base relocations; Mach-O maps a single __DATA_CONST";
    if (itn == nil) { ret generic; }

    var first:  u32 = 0xFFFFFFFF;
    var second: u32 = 0xFFFFFFFF;
    var li:     u32 = 0;
    for (li < seg_count) {
        if (seg_is_data_const(dyn, segs, li) && seg_group_first(dyn, segs, li) == li) {
            if (first == 0xFFFFFFFF) { first = li; }
            or {
                if (second == 0xFFFFFFFF) { second = li; }
            }
        }
        li = li + 1;
    }
    if (second == 0xFFFFFFFF) { ret generic; }

    var slot: u64 = 0;
    var i:    u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == second) {
            slot = dyn.base_relocs[i].seg_offset::u64;
            brk;
        }
        i = i + 1;
    }

    val res_: res[str, format.FormatError] = format.sprint(alloc,
        "macho: read-only load segments {} (vaddr {}) and {} (vaddr {}, e.g. the pointer at +{}) both need base relocations, but Mach-O maps a single read-only __DATA_CONST and they are not adjacent",
        first::u64, segs[first].vaddr, second::u64, segs[second].vaddr, slot);
    if (sel res_.err) { ret generic; }
    val buf: str = res_.ok;
    val msg: str = bin.name_message(itn, alloc, "", buf, generic);
    A.deallocate[u8](alloc, buf::*u8, str_len(buf) + 1);
    ret msg;
}

fun t_exec_section_flags(sec: *of.LoadSection) u32 {
    val r: res[u32, fail.Fail] = exec_section_flags(sec);
    if (sel r.err) { ret 0xFFFFFFFF; }
    ret r.ok;
}

test "mach.lang.target.of.macho.exec_section_flags:init_func_type" {
    var sec: of.LoadSection;
    sec.name  = intern.STR_NIL;
    sec.kind  = of.SK_DATA;
    sec.align = 8;
    sec.len   = 8;

    sec.flags = 0;
    if (t_exec_section_flags(?sec) != 0) { ret 1; }

    sec.flags = of.SEC_FLAG_INIT_FUNCS;
    if ((t_exec_section_flags(?sec) & loadcmd.SECTION_TYPE) != loadcmd.S_MOD_INIT_FUNC_POINTERS) { ret 1; }

    sec.kind  = of.SK_TEXT;
    sec.flags = 0;
    val tf: u32 = t_exec_section_flags(?sec);
    if ((tf & loadcmd.S_ATTR_PURE_INSTRUCTIONS) == 0) { ret 1; }
    if ((tf & loadcmd.S_ATTR_SOME_INSTRUCTIONS) == 0) { ret 1; }
    if ((tf & loadcmd.SECTION_TYPE) != 0)             { ret 1; }

    sec.kind  = of.SK_BSS;
    sec.flags = 0;
    if ((t_exec_section_flags(?sec) & loadcmd.SECTION_TYPE) != loadcmd.S_ZEROFILL) { ret 1; }

    sec.kind = 255::of.SectionKind;
    val r_5070: res[u32, fail.Fail] = exec_section_flags(?sec);
    if (sel r_5070.ok) { ret 2; }
    ret 0;
}
