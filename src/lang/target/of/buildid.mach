# the build id: a content identity every linked image carries, written by the
# format writer after layout and read back by a running compiler from its own
# mapped headers (doc/design/object-cache-3221.md, phase 2a). the byte layouts
# live here so the writers and the run-time reader share one definition.

use mach.lang.target.of.bin;
use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

pub val DIGEST_LEN: usize = 32;
pub val UUID_LEN:   usize = 16;

# elf: `.note.gnu.build-id`, namesz / descsz / type / "GNU\0" / descriptor
pub val ELF_NOTE_NAMESZ:  u32   = 4;
pub val ELF_NOTE_TYPE:    u32   = 3;
pub val ELF_NOTE_HEADER:  usize = 16;
pub val ELF_NOTE_SIZE:    usize = 48;
pub val ELF_NOTE_ALIGN:   usize = 4;
pub val ELF_NOTE_SECTION: str   = ".note.gnu.build-id";

pub fun write_elf_note_header(buf: *u8, off: usize) {
    bin.write_u32_le(buf, off, ELF_NOTE_NAMESZ);
    bin.write_u32_le(buf, off + 4, DIGEST_LEN::u32);
    bin.write_u32_le(buf, off + 8, ELF_NOTE_TYPE);
    buf[off + 12] = 'G';
    buf[off + 13] = 'N';
    buf[off + 14] = 'U';
    buf[off + 15] = 0;
}

pub fun elf_note_header_valid(note: *u8) bool {
    ret bin.read_u32_le(note, 0) == ELF_NOTE_NAMESZ
        && bin.read_u32_le(note, 4) == DIGEST_LEN::u32
        && bin.read_u32_le(note, 8) == ELF_NOTE_TYPE
        && note[12] == 'G' && note[13] == 'N' && note[14] == 'U' && note[15] == 0;
}

# the 16-byte form: the first 16 digest bytes with the rfc 4122 version 4 and
# variant 1 bits forced, as ld64 and lld shape a content-derived uuid
pub fun uuid_from_digest(digest: *u8, out: *u8) {
    var i: usize = 0;
    for (i < UUID_LEN) {
        out[i] = digest[i];
        i      = i + 1;
    }
    out[6] = (out[6] & 0x0F) | 0x40;
    out[8] = (out[8] & 0x3F) | 0x80;
}

# pe: one IMAGE_DEBUG_DIRECTORY entry then the codeview record
# "RSDS" / guid / age / empty path, both inside the `.buildid` section
pub val PE_DEBUG_DIR_SIZE:      usize = 28;
pub val PE_DEBUG_TYPE_CODEVIEW: u32   = 2;
pub val PE_CODEVIEW_SIZE:       usize = 25;
pub val PE_CODEVIEW_GUID:       usize = 4;
pub val PE_BUILDID_SIZE:        usize = 53;
pub val PE_BUILDID_SECTION:     str   = ".buildid";

# the directory entry names the record that follows it; both offsets are the
# entry's own position translated into an rva and a file offset
pub fun write_pe_debug_directory(buf: *u8, off: usize, record_rva: u32, record_file_off: u32) {
    bin.write_u32_le(buf, off, 0);
    bin.write_u32_le(buf, off + 4, 0);
    bin.write_u16_le(buf, off + 8, 0);
    bin.write_u16_le(buf, off + 10, 0);
    bin.write_u32_le(buf, off + 12, PE_DEBUG_TYPE_CODEVIEW);
    bin.write_u32_le(buf, off + 16, PE_CODEVIEW_SIZE::u32);
    bin.write_u32_le(buf, off + 20, record_rva);
    bin.write_u32_le(buf, off + 24, record_file_off);
}

pub fun write_pe_codeview(buf: *u8, off: usize, uuid: *u8) {
    buf[off]     = 'R';
    buf[off + 1] = 'S';
    buf[off + 2] = 'D';
    buf[off + 3] = 'S';
    var i: usize = 0;
    for (i < UUID_LEN) {
        buf[off + PE_CODEVIEW_GUID + i] = uuid[i];
        i                               = i + 1;
    }
    bin.write_u32_le(buf, off + 20, 1);
    buf[off + 24] = 0;
}

pub fun pe_codeview_valid(record: *u8) bool {
    ret record[0] == 'R' && record[1] == 'S' && record[2] == 'D' && record[3] == 'S';
}

# sha-256 over a run of image bytes
pub fun digest_range(st: *sha256.State, buf: *u8, off: usize, len: usize) {
    if (len == 0) { ret; }
    sha256.update(st, (buf::usize + off)::*u8, len);
}

test "mach.lang.target.of.buildid:elf_note_header_roundtrip" {
    var note: [48]u8;
    var i:    usize = 0;
    for (i < 48) {
        note[i] = 0xEE;
        i       = i + 1;
    }
    write_elf_note_header(?note[0], 0);
    if (!elf_note_header_valid(?note[0])) { ret 1; }
    if (note[16] != 0xEE)                 { ret 2; }
    note[4] = 20;
    if (elf_note_header_valid(?note[0])) { ret 3; }
    note[4]  = 32;
    note[13] = 'X';
    if (elf_note_header_valid(?note[0])) { ret 4; }
    ret 0;
}

test "mach.lang.target.of.buildid:uuid_is_the_digest_prefix_with_version_bits" {
    var digest: [32]u8;
    var i:      usize = 0;
    for (i < 32) {
        digest[i] = (0xF0 + i)::u8;
        i         = i + 1;
    }
    var uuid: [16]u8;
    uuid_from_digest(?digest[0], ?uuid[0]);
    i = 0;
    for (i < 16) {
        if (i != 6 && i != 8 && uuid[i] != digest[i]) { ret 1; }
        i = i + 1;
    }
    if ((uuid[6] & 0xF0) != 0x40 || (uuid[6] & 0x0F) != (digest[6] & 0x0F)) { ret 2; }
    if ((uuid[8] & 0xC0) != 0x80 || (uuid[8] & 0x3F) != (digest[8] & 0x3F)) { ret 3; }
    ret 0;
}

test "mach.lang.target.of.buildid:pe_record_layout" {
    var block: [53]u8;
    var i:     usize = 0;
    for (i < 53) {
        block[i] = 0xAA;
        i        = i + 1;
    }
    var uuid: [16]u8;
    i = 0;
    for (i < 16) {
        uuid[i] = (0x10 + i)::u8;
        i       = i + 1;
    }
    write_pe_debug_directory(?block[0], 0, 0x2000 + 28, 0x600 + 28);
    write_pe_codeview(?block[0], PE_DEBUG_DIR_SIZE, ?uuid[0]);
    if (bin.read_u32_le(?block[0], 12) != PE_DEBUG_TYPE_CODEVIEW)                            { ret 1; }
    if (bin.read_u32_le(?block[0], 16) != 25)                                                { ret 2; }
    if (bin.read_u32_le(?block[0], 20) != 0x201C || bin.read_u32_le(?block[0], 24) != 0x61C) { ret 3; }
    if (!pe_codeview_valid(?block[PE_DEBUG_DIR_SIZE]))                                       { ret 4; }
    i = 0;
    for (i < 16) {
        if (block[PE_DEBUG_DIR_SIZE + 4 + i] != (0x10 + i)::u8) { ret 5; }
        i = i + 1;
    }
    if (bin.read_u32_le(?block[0], PE_DEBUG_DIR_SIZE + 20) != 1 || block[52] != 0) { ret 6; }
    if (PE_DEBUG_DIR_SIZE + PE_CODEVIEW_SIZE != PE_BUILDID_SIZE)                   { ret 7; }
    ret 0;
}
