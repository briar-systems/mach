use output: mach.lang.publication.testing;
use txn: std.filesystem.transaction;
use std.format;
use std.allocator.page;
use fs: std.filesystem;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.types.string.str_starts_with;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.target.of.bin;
use mach.lang.publication;

val MAGIC:       str   = "!<arch>\n";
val MAGIC_LEN:   usize = 8;
val HEADER_LEN:  usize = 60;
val SIZE_OFFSET: usize = 48;
val SIZE_LEN:    usize = 10;
val MAX_U32:     usize = 0xFFFFFFFF;

pub rec Member {
    name:     *u8;
    name_len: usize;
    data:     *u8;
    len:      usize;
}

pub rec Step {
    member: Member;
    next:   usize;
    done:   bool;
    ok:     bool;
}

pub fun is_archive(buf: *u8, len: usize) bool {
    if (buf == nil || len < MAGIC_LEN) { ret false; }
    ret str_starts_with(buf::str, MAGIC);
}

pub fun first_member() usize {
    ret MAGIC_LEN;
}

pub fun next_member(buf: *u8, len: usize, pos: usize) Step {
    var step: Step;
    step.member.name     = nil;
    step.member.name_len = 0;
    step.member.data     = nil;
    step.member.len      = 0;
    step.next            = pos;
    step.done            = false;
    step.ok              = true;

    if (pos == len) {
        step.done = true;
        ret step;
    }
    if (pos > len || len - pos < HEADER_LEN) {
        step.ok = false;
        ret step;
    }

    if (buf[pos + HEADER_LEN - 2] != 0x60 || buf[pos + HEADER_LEN - 1] != 0x0A) {
        step.ok = false;
        ret step;
    }

    var ok_size: bool = false;
    val size: usize   = parse_size(buf, pos + SIZE_OFFSET, ?ok_size);
    if (!ok_size) {
        step.ok = false;
        ret step;
    }

    val data_start: usize = pos + HEADER_LEN;
    if (size > len - data_start) {
        step.ok = false;
        ret step;
    }

    step.member.name     = (buf::usize + pos)::*u8;
    step.member.name_len = inline_name_len(buf, pos);
    step.member.data     = (buf::usize + data_start)::*u8;
    step.member.len      = size;

    if (buf[pos] == '#' && buf[pos + 1] == '1' && buf[pos + 2] == '/') {
        var ok_name: bool = false;
        val name_len: usize = parse_extended_name_len(buf, pos, size, ?ok_name);
        if (!ok_name) {
            step.ok = false;
            ret step;
        }
        step.member.name     = (buf::usize + data_start)::*u8;
        step.member.name_len = name_len;
        step.member.data     = (buf::usize + data_start + name_len)::*u8;
        step.member.len      = size - name_len;
    }

    var after: usize = data_start + size;
    if ((size & 1) == 1) {
        if (after >= len) {
            step.ok = false;
            ret step;
        }
        after = after + 1;
    }
    step.next = after;
    ret step;
}

fun inline_name_len(buf: *u8, pos: usize) usize {
    var n: usize = 16;
    for (n > 0 && buf[pos + n - 1] == ' ') { n = n - 1; }
    ret n;
}

fun parse_extended_name_len(buf: *u8, pos: usize, limit: usize, ok: *bool) usize {
    var value:  usize = 0;
    var digits: usize = 0;
    var i:      usize = 3;

    for (i < 16) {
        val c: u8 = buf[pos + i];
        if (c == ' ') { brk; }
        if (c < '0' || c > '9') {
            @ok = false;
            ret 0;
        }
        val digit: usize = (c - '0')::usize;
        if (value > limit / 10 || (value == limit / 10 && digit > limit % 10)) {
            @ok = false;
            ret 0;
        }
        value  = value * 10 + digit;
        digits = digits + 1;
        i      = i + 1;
    }

    for (i < 16) {
        if (buf[pos + i] != ' ') {
            @ok = false;
            ret 0;
        }
        i = i + 1;
    }

    @ok = digits > 0;
    ret value;
}

pub fun is_special(member: Member) bool {
    if (member_name_equals(member, "/"))                 { ret true; }
    if (member_name_equals(member, "//"))                { ret true; }
    if (member_name_equals(member, "/SYM64/"))           { ret true; }
    if (member_name_equals(member, "__.SYMDEF"))          { ret true; }
    if (member_name_equals(member, "__.SYMDEF SORTED"))   { ret true; }
    if (member_name_equals(member, "__.SYMDEF_64"))       { ret true; }
    if (member_name_equals(member, "__.SYMDEF_64 SORTED")) { ret true; }
    ret false;
}

fun member_name_equals(member: Member, want: str) bool {
    if (member.name == nil) { ret false; }
    var actual_len: usize = member.name_len;
    for (actual_len > 0 && member.name[actual_len - 1] == 0) {
        actual_len = actual_len - 1;
    }
    val want_len: usize = str_len(want);
    if (actual_len != want_len) { ret false; }
    var i: usize = 0;
    for (i < want_len) {
        if (member.name[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun parse_size(buf: *u8, at: usize, ok: *bool) usize {
    var size:   usize = 0;
    var digits: usize = 0;
    var i:      usize = 0;

    for (i < SIZE_LEN && buf[at + i] == ' ') { i = i + 1; }

    for (i < SIZE_LEN) {
        val c: u8 = buf[at + i];
        if (c < '0' || c > '9') { brk; }
        size   = size * 10 + (c - '0')::usize;
        digits = digits + 1;
        i      = i + 1;
    }

    @ok = digits > 0;
    ret size;
}

pub rec ArMember {
    name:      str;
    data:      *u8;
    len:       usize;
    sym_names: *str;
    sym_count: u32;
}

fun even(x: usize) usize {
    if ((x & 1) == 1) { ret x + 1; }
    ret x;
}

fun index_offset_fits(total: usize) bool {
    ret total <= MAX_U32;
}

fun inline_name(name: str) bool {
    ret str_len(name) + 1 <= 16;
}

fun dec_digits(v: usize) usize {
    var n: usize = 1;
    var t: usize = v;
    for (t >= 10) { t = t / 10; n = n + 1; }
    ret n;
}

fun put_dec(buf: *u8, off: usize, v: usize) usize {
    val d: usize = dec_digits(v);
    var i: usize = d;
    var t: usize = v;
    for (i > 0) {
        i = i - 1;
        buf[off + i] = ('0'::usize + (t % 10))::u8;
        t = t / 10;
    }
    ret d;
}

fun put_header(buf: *u8, off: usize, size: usize) {
    var i: usize = 0;
    for (i < HEADER_LEN) { buf[off + i] = ' '; i = i + 1; }
    buf[off + 16] = '0';
    buf[off + 28] = '0';
    buf[off + 34] = '0';
    buf[off + 40] = '6'; buf[off + 41] = '4'; buf[off + 42] = '4';
    put_dec(buf, off + SIZE_OFFSET, size);
    buf[off + HEADER_LEN - 2] = 0x60;
    buf[off + HEADER_LEN - 1] = 0x0A;
}

val ARCHIVE_SIZE_GENERIC: str = "archive: the planned archive size and the bytes written disagree";

fun archive_size_message(alloc: *A.Allocator, planned: usize, written: usize) str {
    val r: R.Result[str, str] = format.sprint(alloc,
        "archive: the writer planned a {}-byte archive and wrote {} bytes; a planned size and the bytes written must agree exactly, never by truncation or padding",
        planned::u64, written::u64);
    if (R.is_err[str, str](r)) { ret ARCHIVE_SIZE_GENERIC; }
    ret R.unwrap_ok[str, str](r);
}

pub fun write_archive(alloc: *A.Allocator, members: *ArMember, count: u32, destination: *publication.Destination) R.Result[R.Void, str] {
    if (destination == nil) { ret R.err[R.Void, str]("ar: nil archive destination"); }
    var total_syms: usize = 0;
    var strtab_len: usize = 0;
    var long_len:   usize = 0;
    var i: u32 = 0;
    for (i < count) {
        total_syms = total_syms + members[i].sym_count::usize;
        var s: u32 = 0;
        for (s < members[i].sym_count) { strtab_len = strtab_len + str_len(members[i].sym_names[s]) + 1; s = s + 1; }
        if (!inline_name(members[i].name)) { long_len = long_len + str_len(members[i].name) + 2; }
        i = i + 1;
    }
    val armap_content: usize = 4 + total_syms * 4 + strtab_len;
    val has_long: bool = long_len > 0;

    val res_lo: R.Result[*usize, str] = A.allocate[usize](alloc, count::usize);
    if (R.is_err[*usize, str](res_lo)) { ret R.err[R.Void, str](R.unwrap_err[*usize, str](res_lo)); }
    val long_off: *usize = R.unwrap_ok[*usize, str](res_lo);
    val res_ho: R.Result[*usize, str] = A.allocate[usize](alloc, count::usize);
    if (R.is_err[*usize, str](res_ho)) { A.deallocate[usize](alloc, long_off, count::usize); ret R.err[R.Void, str](R.unwrap_err[*usize, str](res_ho)); }
    val hdr_off: *usize = R.unwrap_ok[*usize, str](res_ho);

    var lo_run: usize = 0;
    i = 0;
    for (i < count) {
        long_off[i] = lo_run;
        if (!inline_name(members[i].name)) { lo_run = lo_run + str_len(members[i].name) + 2; }
        i = i + 1;
    }

    var pos: usize = MAGIC_LEN + HEADER_LEN + even(armap_content);
    if (has_long) { pos = pos + HEADER_LEN + even(long_len); }
    i = 0;
    for (i < count) {
        hdr_off[i] = pos;
        pos = pos + HEADER_LEN + even(members[i].len);
        i = i + 1;
    }
    val total: usize = pos;

    if (!index_offset_fits(total)) {
        A.deallocate[usize](alloc, long_off, count::usize);
        A.deallocate[usize](alloc, hdr_off, count::usize);
        ret R.err[R.Void, str]("archive: total size exceeds the 32-bit symbol-index offset field; a 64-bit symbol index is not supported");
    }

    val res_buf: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](res_buf)) {
        A.deallocate[usize](alloc, long_off, count::usize);
        A.deallocate[usize](alloc, hdr_off, count::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u8, str](res_buf));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var k: usize = 0;
    for (k < MAGIC_LEN) { buf[k] = MAGIC[k]; k = k + 1; }
    var off: usize = MAGIC_LEN;

    put_header(buf, off, armap_content);
    buf[off] = '/';
    off = off + HEADER_LEN;
    bin.write_u32_be(buf, off, total_syms::u32);
    var so: usize = off + 4;
    var st: usize = off + 4 + total_syms * 4;
    i = 0;
    for (i < count) {
        var s: u32 = 0;
        for (s < members[i].sym_count) {
            bin.write_u32_be(buf, so, hdr_off[i]::u32);
            so = so + 4;
            val nm: str = members[i].sym_names[s];
            val nl: usize = str_len(nm);
            var j: usize = 0;
            for (j < nl) { buf[st] = nm[j]; st = st + 1; j = j + 1; }
            buf[st] = 0; st = st + 1;
            s = s + 1;
        }
        i = i + 1;
    }
    off = off + armap_content;
    if ((armap_content & 1) == 1) { buf[off] = 0x0A; off = off + 1; }

    if (has_long) {
        put_header(buf, off, long_len);
        buf[off] = '/'; buf[off + 1] = '/';
        off = off + HEADER_LEN;
        i = 0;
        for (i < count) {
            if (!inline_name(members[i].name)) {
                val nm: str = members[i].name;
                val nl: usize = str_len(nm);
                var j: usize = 0;
                for (j < nl) { buf[off] = nm[j]; off = off + 1; j = j + 1; }
                buf[off] = '/'; off = off + 1;
                buf[off] = 0x0A; off = off + 1;
            }
            i = i + 1;
        }
        if ((long_len & 1) == 1) { buf[off] = 0x0A; off = off + 1; }
    }

    i = 0;
    for (i < count) {
        put_header(buf, off, members[i].len);
        if (inline_name(members[i].name)) {
            val nm: str = members[i].name;
            val nl: usize = str_len(nm);
            var j: usize = 0;
            for (j < nl) { buf[off + j] = nm[j]; j = j + 1; }
            buf[off + nl] = '/';
        }
        or {
            buf[off] = '/';
            put_dec(buf, off + 1, long_off[i]);
        }
        off = off + HEADER_LEN;
        var b: usize = 0;
        for (b < members[i].len) { buf[off] = members[i].data[b]; off = off + 1; b = b + 1; }
        if ((members[i].len & 1) == 1) { buf[off] = 0x0A; off = off + 1; }
        i = i + 1;
    }

    if (off != total) {
        A.deallocate[u8](alloc, buf, total);
        A.deallocate[usize](alloc, long_off, count::usize);
        A.deallocate[usize](alloc, hdr_off, count::usize);
        ret R.err[R.Void, str](archive_size_message(alloc, total, off));
    }

    val wr: R.Result[R.Void, str] = publication.bytes_at(nil, alloc, ?destination.claim, destination.path, buf, total, 0o644, publication.REPLACE, "ar: cannot publish archive", "ar: could not publish archive file", nil);
    A.deallocate[u8](alloc, buf, total);
    A.deallocate[usize](alloc, long_off, count::usize);
    A.deallocate[usize](alloc, hdr_off, count::usize);
    ret wr;
}

fun test_member_header(buf: *u8, cap: usize, name: str, size: usize) {
    var i: usize = 0;
    for (i < cap) { buf[i] = 0; i = i + 1; }
    i = 0;
    for (i < MAGIC_LEN) { buf[i] = MAGIC[i]; i = i + 1; }
    put_header(buf, MAGIC_LEN, size);
    val name_len: usize = str_len(name);
    i = 0;
    for (i < name_len) { buf[MAGIC_LEN + i] = name[i]; i = i + 1; }
}

fun rejects_test_member(name: str, size: usize, visible_len: usize) bool {
    var buf: [96]u8;
    test_member_header(?buf[0], 96, name, size);
    val step: Step = next_member(?buf[0], visible_len, first_member());
    ret !step.ok;
}

test "mach.lang.target.of.ar.next_member:bsd_extended_name_payload" {
    var buf: [82]u8;
    test_member_header(?buf[0], 82, "#1/8", 13);
    val body: usize = MAGIC_LEN + HEADER_LEN;
    buf[body + 0] = 'l'; buf[body + 1] = 'o'; buf[body + 2] = 'n';
    buf[body + 3] = 'g'; buf[body + 4] = '.'; buf[body + 5] = 'o';
    buf[body + 6] = 0;   buf[body + 7] = 0;
    buf[body + 8] = 0xCF; buf[body + 9] = 0xFA; buf[body + 10] = 0xED;
    buf[body + 11] = 0xFE; buf[body + 12] = 7;
    buf[body + 13] = 0x0A;

    val step: Step = next_member(?buf[0], 82, first_member());
    if (!step.ok || step.done || step.next != 82) { ret 1; }
    if (step.member.name_len != 8 || step.member.name[0] != 'l' || step.member.name[5] != 'o') { ret 1; }
    if (step.member.len != 5 || step.member.data[0] != 0xCF || step.member.data[4] != 7) { ret 1; }
    if (is_special(step.member)) { ret 1; }

    val done: Step = next_member(?buf[0], 82, step.next);
    if (!done.ok || !done.done) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.ar.is_special:bsd_extended_symdef" {
    var sym: [84]u8;
    test_member_header(?sym[0], 84, "#1/12", 16);
    val sb: usize = MAGIC_LEN + HEADER_LEN;
    val sym_name: str = "__.SYMDEF";
    var i: usize = 0;
    for (i < str_len(sym_name)) { sym[sb + i] = sym_name[i]; i = i + 1; }
    sym[sb + 12] = 1; sym[sb + 13] = 2; sym[sb + 14] = 3; sym[sb + 15] = 4;
    val ss: Step = next_member(?sym[0], 84, first_member());
    if (!ss.ok || ss.member.len != 4 || !is_special(ss.member)) { ret 1; }

    var sorted: [90]u8;
    test_member_header(?sorted[0], 90, "#1/20", 22);
    val sorted_name: str = "__.SYMDEF SORTED";
    i = 0;
    for (i < str_len(sorted_name)) { sorted[sb + i] = sorted_name[i]; i = i + 1; }
    sorted[sb + 20] = 5; sorted[sb + 21] = 6;
    val so: Step = next_member(?sorted[0], 90, first_member());
    if (!so.ok || so.member.len != 2 || !is_special(so.member)) { ret 1; }

    var sorted64: [94]u8;
    test_member_header(?sorted64[0], 94, "#1/24", 26);
    val sorted64_name: str = "__.SYMDEF_64 SORTED";
    i = 0;
    for (i < str_len(sorted64_name)) { sorted64[sb + i] = sorted64_name[i]; i = i + 1; }
    sorted64[sb + 24] = 7; sorted64[sb + 25] = 8;
    val so64: Step = next_member(?sorted64[0], 94, first_member());
    if (!so64.ok || so64.member.len != 2 || !is_special(so64.member)) { ret 1; }

    var ordinary: [76]u8;
    test_member_header(?ordinary[0], 76, "#1/4", 8);
    ordinary[sb + 0] = 'x'; ordinary[sb + 1] = '.'; ordinary[sb + 2] = 'o'; ordinary[sb + 3] = 0;
    val os: Step = next_member(?ordinary[0], 76, first_member());
    if (!os.ok || is_special(os.member)) { ret 1; }

    var short_sym: [68]u8;
    test_member_header(?short_sym[0], 68, "__.SYMDEF", 0);
    val shs: Step = next_member(?short_sym[0], 68, first_member());
    if (!shs.ok || !is_special(shs.member)) { ret 1; }

    var short_sym64: [68]u8;
    test_member_header(?short_sym64[0], 68, "__.SYMDEF_64", 0);
    val sh64: Step = next_member(?short_sym64[0], 68, first_member());
    if (!sh64.ok || !is_special(sh64.member)) { ret 1; }

    var prefix_obj: [72]u8;
    test_member_header(?prefix_obj[0], 72, "__.SYMDEFAULT", 4);
    val po: Step = next_member(?prefix_obj[0], 72, first_member());
    if (!po.ok || is_special(po.member)) { ret 1; }

    var short_obj: [72]u8;
    test_member_header(?short_obj[0], 72, "short.o", 4);
    short_obj[sb + 0] = 9; short_obj[sb + 1] = 8;
    short_obj[sb + 2] = 7; short_obj[sb + 3] = 6;
    val sho: Step = next_member(?short_obj[0], 72, first_member());
    if (!sho.ok || is_special(sho.member) || sho.member.len != 4 || sho.member.data[3] != 6) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.ar.next_member:bsd_extended_name_malformed" {
    if (!rejects_test_member("#1/",                4, 72)) { ret 1; }
    if (!rejects_test_member("#1/x",               4, 72)) { ret 1; }
    if (!rejects_test_member("#1/1x",              4, 72)) { ret 1; }
    if (!rejects_test_member("#1/5",               4, 72)) { ret 1; }
    if (!rejects_test_member("#1/9999999999999",   4, 72)) { ret 1; }
    if (!rejects_test_member("#1/4",               5, 72)) { ret 1; }
    if (!rejects_test_member("#1/4",               5, 73)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.ar.write_roundtrip" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var code: i32 = 0;

    var d1: [4]u8; d1[0] = 1::u8; d1[1] = 2::u8; d1[2] = 3::u8; d1[3] = 4::u8;
    var d2: [3]u8; d2[0] = 9::u8; d2[1] = 8::u8; d2[2] = 7::u8;
    var s1: [2]str; s1[0] = "foo"; s1[1] = "bar";
    var s2: [1]str; s2[0] = "aVeryLongExportedSymbolName";
    var members: [2]ArMember;
    members[0].name = "short.o";
    members[0].data = ?d1[0]; members[0].len = 4; members[0].sym_names = ?s1[0]; members[0].sym_count = 2;
    members[1].name = "a.long.member.name.needing.the.table.o";
    members[1].data = ?d2[0]; members[1].len = 3; members[1].sym_names = ?s2[0]; members[1].sym_count = 1;

    val res_temp: R.Result[output.Output, str] = output.create(?alloc, "mach_test_ar");
    if (R.is_err[output.Output, str](res_temp)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](res_temp);
    val path: str = output.path(?tf);
    if (R.is_err[R.Void, str](t_planned_write_archive(?alloc, ?members[0], 2, path))) { output.dnit(?tf); ret 1; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path);
    output.dnit(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 1; }
    val b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    if (!is_archive(b.data, b.len)) { ret 1; }

    var pos: usize = first_member();
    var objs: u32 = 0;
    var m0_ok: bool = false;
    var m1_ok: bool = false;
    var walking: bool = true;
    for (walking) {
        val step: Step = next_member(b.data, b.len, pos);
        if (!step.ok) { code = 1; walking = false; }
        or (step.done) { walking = false; }
        or {
            if (!is_special(step.member)) {
                objs = objs + 1;
                if (step.member.len == 4 && step.member.data[0] == 1::u8 && step.member.data[3] == 4::u8) { m0_ok = true; }
                if (step.member.len == 3 && step.member.data[0] == 9::u8 && step.member.data[2] == 7::u8) { m1_ok = true; }
            }
            pos = step.next;
        }
    }
    if (objs != 2) { code = 1; }
    if (!m0_ok || !m1_ok) { code = 1; }
    ret code;
}

test "mach.lang.target.of.ar.write_archive:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var d1: [5]u8; d1[0] = 1::u8; d1[1] = 2::u8; d1[2] = 3::u8; d1[3] = 4::u8; d1[4] = 5::u8;
    var d2: [2]u8; d2[0] = 9::u8; d2[1] = 8::u8;
    var s1: [1]str; s1[0] = "odd_length_member";
    var s2: [1]str; s2[0] = "second";
    var members: [2]ArMember;
    members[0].name = "odd.o";
    members[0].data = ?d1[0]; members[0].len = 5; members[0].sym_names = ?s1[0]; members[0].sym_count = 1;
    members[1].name = "a.long.member.name.needing.the.string.table.o";
    members[1].data = ?d2[0]; members[1].len = 2; members[1].sym_names = ?s2[0]; members[1].sym_count = 1;

    val res_temp: R.Result[output.Output, str] = output.create(?alloc, "mach_test_ar_size");
    if (R.is_err[output.Output, str](res_temp)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](res_temp);
    val path: str = output.path(?tf);
    if (R.is_err[R.Void, str](t_planned_write_archive(?alloc, ?members[0], 2, path))) {
        output.dnit(?tf); ret 2;
    }
    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path);
    output.dnit(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 3; }
    val b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    var walked: usize = first_member();
    var walking: bool = true;
    for (walking) {
        val step: Step = next_member(b.data, b.len, walked);
        if (!step.ok)   { ret 4; }
        or (step.done)  { walking = false; }
        or              { walked = step.next; }
    }
    if (walked != b.len) { ret 5; }
    ret 0;
}

test "mach.lang.target.of.ar.symbol_index:faithful_to_members" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var d1: [4]u8; d1[0] = 1::u8; d1[1] = 2::u8; d1[2] = 3::u8; d1[3] = 4::u8;
    var d2: [3]u8; d2[0] = 9::u8; d2[1] = 8::u8; d2[2] = 7::u8;
    var s1: [2]str; s1[0] = "foo"; s1[1] = "bar";
    var s2: [1]str; s2[0] = "aVeryLongExportedSymbolName";
    var members: [2]ArMember;
    members[0].name = "short.o";
    members[0].data = ?d1[0]; members[0].len = 4; members[0].sym_names = ?s1[0]; members[0].sym_count = 2;
    members[1].name = "a.long.member.name.needing.the.table.o";
    members[1].data = ?d2[0]; members[1].len = 3; members[1].sym_names = ?s2[0]; members[1].sym_count = 1;

    val res_temp: R.Result[output.Output, str] = output.create(?alloc, "mach_test_ar_sym");
    if (R.is_err[output.Output, str](res_temp)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](res_temp);
    val path: str = output.path(?tf);
    if (R.is_err[R.Void, str](t_planned_write_archive(?alloc, ?members[0], 2, path))) { output.dnit(?tf); ret 1; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path);
    output.dnit(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 1; }
    val b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    val symtab_step: Step = next_member(b.data, b.len, first_member());
    if (!symtab_step.ok || symtab_step.done || !is_special(symtab_step.member)) { ret 1; }
    if (!member_name_equals(symtab_step.member, "/")) { ret 1; }

    var m0_off: usize = symtab_step.next;
    var m0_step: Step = next_member(b.data, b.len, m0_off);
    if (!m0_step.ok || m0_step.done) { ret 1; }
    if (is_special(m0_step.member)) {
        if (!member_name_equals(m0_step.member, "//")) { ret 1; }
        m0_off = m0_step.next;
        m0_step = next_member(b.data, b.len, m0_off);
        if (!m0_step.ok || m0_step.done) { ret 1; }
    }
    if (is_special(m0_step.member)) { ret 1; }
    if (m0_step.member.len != 4 || m0_step.member.data[0] != 1::u8) { ret 1; }
    val m1_off: usize = m0_step.next;

    val m1_step: Step = next_member(b.data, b.len, m1_off);
    if (!m1_step.ok || m1_step.done || is_special(m1_step.member)) { ret 1; }
    if (m1_step.member.len != 3 || m1_step.member.data[0] != 9::u8) { ret 1; }

    val idx: Member = symtab_step.member;
    if (idx.len < 4 || bin.read_u32_be(idx.data, 0) != 3) { ret 1; }
    if (bin.read_u32_be(idx.data, 4)::usize != m0_off)  { ret 1; }
    if (bin.read_u32_be(idx.data, 8)::usize != m0_off)  { ret 1; }
    if (bin.read_u32_be(idx.data, 12)::usize != m1_off) { ret 1; }
    var names: [3]str; names[0] = "foo"; names[1] = "bar"; names[2] = "aVeryLongExportedSymbolName";
    var pos: usize = 16;
    var n: usize = 0;
    for (n < 3) {
        val want: str = names[n];
        var j: usize = 0;
        for (j < str_len(want)) {
            if (pos >= idx.len || idx.data[pos] != want[j]::u8) { ret 1; }
            pos = pos + 1; j = j + 1;
        }
        if (pos >= idx.len || idx.data[pos] != 0) { ret 1; }
        pos = pos + 1;
        n = n + 1;
    }
    if (pos != idx.len) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.ar.write_archive:deterministic" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var d1: [4]u8; d1[0] = 1::u8; d1[1] = 2::u8; d1[2] = 3::u8; d1[3] = 4::u8;
    var d2: [3]u8; d2[0] = 9::u8; d2[1] = 8::u8; d2[2] = 7::u8;
    var s1: [2]str; s1[0] = "foo"; s1[1] = "bar";
    var s2: [1]str; s2[0] = "aVeryLongExportedSymbolName";
    var members: [2]ArMember;
    members[0].name = "short.o";
    members[0].data = ?d1[0]; members[0].len = 4; members[0].sym_names = ?s1[0]; members[0].sym_count = 2;
    members[1].name = "a.long.member.name.needing.the.table.o";
    members[1].data = ?d2[0]; members[1].len = 3; members[1].sym_names = ?s2[0]; members[1].sym_count = 1;

    val res_temp1: R.Result[output.Output, str] = output.create(?alloc, "mach_test_ar_det1");
    if (R.is_err[output.Output, str](res_temp1)) { ret 1; }
    var tf1: output.Output = R.unwrap_ok[output.Output, str](res_temp1);
    val path1: str = output.path(?tf1);
    if (R.is_err[R.Void, str](t_planned_write_archive(?alloc, ?members[0], 2, path1))) { output.dnit(?tf1); ret 1; }

    val res_temp2: R.Result[output.Output, str] = output.create(?alloc, "mach_test_ar_det2");
    if (R.is_err[output.Output, str](res_temp2)) { output.dnit(?tf1); ret 1; }
    var tf2: output.Output = R.unwrap_ok[output.Output, str](res_temp2);
    val path2: str = output.path(?tf2);
    if (R.is_err[R.Void, str](t_planned_write_archive(?alloc, ?members[0], 2, path2))) { output.dnit(?tf1); output.dnit(?tf2); ret 1; }

    val rr1: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path1);
    val rr2: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path2);
    output.dnit(?tf1);
    output.dnit(?tf2);
    if (R.is_err[Vector[u8], str](rr1) || R.is_err[Vector[u8], str](rr2)) { ret 1; }
    val b1: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr1);
    val b2: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr2);

    if (b1.len != b2.len) { ret 1; }
    var i: usize = 0;
    for (i < b1.len) {
        if (b1.data[i] != b2.data[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.of.ar.index_offset_fits:boundary" {
    if (!index_offset_fits(MAX_U32)) { ret 1; }
    if (index_offset_fits(MAX_U32 + 1)) { ret 1; }
    ret 0;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) R.Result[*publication.Destination, str] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](initialized))); }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret destination; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](sealed))); }
    ret destination;
}

fun t_publication_close(operation: *publication.Plan, result: R.Result[R.Void, str]) R.Result[R.Void, str] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (R.is_ok[R.Void, str](result) && O.is_some[txn.Error](closed)) {
        ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](closed)));
    }
    ret result;
}

fun t_planned_write_archive(alloc: *A.Allocator, members: *ArMember, count: u32, out_path: str) R.Result[R.Void, str] {
    if (out_path == nil) { ret write_archive(alloc, members, count, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, out_path);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, write_archive(alloc, members, count, R.unwrap_ok[*publication.Destination, str](opened)));
}

test "mach.lang.target.of.ar.write_archive:rejects_nil_destination" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val written: R.Result[R.Void, str] = write_archive(?alloc, nil::*ArMember, 0, nil::*publication.Destination);
    if (R.is_ok[R.Void, str](written)) { ret 2; }
    if (!str_equals(R.unwrap_err[R.Void, str](written), "ar: nil archive destination")) { ret 3; }
    ret 0;
}
