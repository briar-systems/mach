# Unix `ar` static-archive reader
#
# A static library (`.a`) is a flat `ar` archive: the 8-byte magic `!<arch>\n`
# followed by a sequence of members, each a 60-byte fixed header (name, mtime,
# uid, gid, mode, decimal-ASCII size, and the `\x60\n` terminator) immediately
# followed by `size` content bytes, padded with a single `\n` to an even
# boundary. The reader is format-agnostic: it only frames the archive and yields
# each ordinary member as bounded name and payload slices into the original buffer.
# The linker hands each slice to the active object format's `parse_object`, so an
# archive joins the link as the same `of.ObjectImage` stream a loose `.o` does.
#
# Member-selection policy (v1): every ordinary member is pulled, not just the
# ones that satisfy an undefined symbol. Classic `ar` semantics - consult the
# archive symbol table and pull only needed members - is a deliberate non-goal
# here; the linker already rejects only duplicate *strong* definitions, and an
# archive's members rarely collide, so pulling all members links correctly at the
# cost of carrying unreferenced ones. The reader skips the GNU and BSD bookkeeping
# members archivers insert, since those are not objects.

use std.allocator.page;
use fs: std.filesystem;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.target.of.bin;

# the `!<arch>\n` magic that opens every `ar` file
val MAGIC:       str   = "!<arch>\n";
# length of the archive magic, in bytes
val MAGIC_LEN:   usize = 8;
# fixed size of a member header, in bytes
val HEADER_LEN:  usize = 60;
# byte offset of the decimal-ASCII size field within a member header
val SIZE_OFFSET: usize = 48;
# width of the size field, in bytes
val SIZE_LEN:    usize = 10;

# one archive member yielded by the cursor: bounded name and payload slices into
# the archive buffer
#
# Both slices are borrowed - they point into the caller's buffer and are valid
# only while that buffer lives. For BSD `#1/<length>` members, `name` points at
# the body prefix and `data` begins immediately after it. For every other member,
# `name` points at the fixed header field and `data` spans the complete body.
# ---
# name:     pointer to the member name bytes
# name_len: member name length in bytes
# data:     pointer to the member's first payload byte
# len:      member payload length in bytes
pub rec Member {
    name:     *u8;
    name_len: usize;
    data:     *u8;
    len:      usize;
}

# the result of advancing the cursor
#
# Carries the member found (when `ok` and not `done`) and the buffer offset just
# past it. Iteration ends when `done` is true; a malformed header sets `ok` false
# so the caller can reject the archive.
# ---
# member: the member yielded (valid only when ok && !done)
# next:   buffer offset of the following member header
# done:   true once no more members remain
# ok:     false if the header at the cursor was malformed
pub rec Step {
    member: Member;
    next:   usize;
    done:   bool;
    ok:     bool;
}

# whether `buf` opens with the `!<arch>\n` magic
#
# The cheap discriminant the linker uses to route an input file to the archive
# reader instead of the object parser.
# ---
# buf: the file bytes
# len: length of `buf`
# ret: true if `buf` is an `ar` archive
pub fun is_archive(buf: *u8, len: usize) bool {
    if (buf == nil || len < MAGIC_LEN) { ret false; }
    ret str_starts_with(buf::str, MAGIC);
}

# the buffer offset where member iteration begins
#
# Always just past the 8-byte magic. Pair it with `next_member` to walk the
# archive, advancing `pos` to each returned `Step.next` until `Step.done`.
# ---
# ret: the offset of the first member header
pub fun first_member() usize {
    ret MAGIC_LEN;
}

# read the member header at `pos` and yield its content slice
#
# Parses the 60-byte header, validates the `\x60\n` terminator, decodes the
# decimal-ASCII size, decodes a BSD `#1/<length>` name when present, and returns
# the member's bounded name and payload slices plus the offset of the following
# header (the raw member body is padded to an even boundary).
# `pos == len` is the clean end of iteration (`done` true); a truncated header,
# missing terminator, non-numeric size, malformed or out-of-bounds extended name,
# out-of-bounds body, or missing pad byte is a hard stop (`ok` false).
# Bookkeeping members are still yielded here - the caller filters them via
# `is_special` - so offsets stay exact.
# ---
# buf: the archive bytes
# len: length of `buf`
# pos: offset of the member header to read
# ret: a `Step` describing the member and the next position
pub fun next_member(buf: *u8, len: usize, pos: usize) Step {
    var step: Step;
    step.member.name     = nil;
    step.member.name_len = 0;
    step.member.data     = nil;
    step.member.len      = 0;
    step.next            = pos;
    step.done            = false;
    step.ok              = true;

    # exactly at the end: a clean end of iteration.
    if (pos == len) {
        step.done = true;
        ret step;
    }
    # fewer than a header's worth of bytes remain: a truncated archive.
    if (pos > len || len - pos < HEADER_LEN) {
        step.ok = false;
        ret step;
    }

    # the header must end with the `\x60\n` terminator (backtick, newline).
    if (buf[pos + HEADER_LEN - 2] != 0x60 || buf[pos + HEADER_LEN - 1] != 0x0A) {
        step.ok = false;
        ret step;
    }

    # the size field must be a non-empty run of decimal digits.
    var ok_size: bool = false;
    val size: usize   = parse_size(buf, pos + SIZE_OFFSET, ?ok_size);
    if (!ok_size) {
        step.ok = false;
        ret step;
    }

    # the body must fit; compare against the remaining bytes so the sum cannot
    # overflow `usize`.
    val data_start: usize = pos + HEADER_LEN;
    if (size > len - data_start) {
        step.ok = false;
        ret step;
    }

    step.member.name     = (buf::usize + pos)::*u8;
    step.member.name_len = inline_name_len(buf, pos);
    step.member.data     = (buf::usize + data_start)::*u8;
    step.member.len      = size;

    # BSD stores a long member name at the start of the body and writes its byte
    # length as `#1/<length>` in the fixed name field. The header's size covers
    # BOTH that prefix and the object payload, so expose only the bytes after the
    # bounded name. The raw `size` below remains the authority for padding and
    # the following-header offset.
    if (buf[pos] == '#' && buf[pos + 1] == '1' && buf[pos + 2] == '/') {
        var ok_name: bool = false;
        val name_len: usize = parse_extended_name_len(buf, pos, size, ?ok_name);
        if (!ok_name) {
            step.ok = false;
            ret step;
        }
        step.member.name     = (buf::usize + data_start)::*u8;
        step.member.name_len = name_len;
        step.member.data     = (buf::usize + data_start + name_len)::*u8;
        step.member.len      = size - name_len;
    }

    # members are padded to an even boundary with a trailing `\n`; an odd-sized
    # member that runs to the very end is missing its pad - truncated.
    var after: usize = data_start + size;
    if ((size & 1) == 1) {
        if (after >= len) {
            step.ok = false;
            ret step;
        }
        after = after + 1;
    }
    step.next = after;
    ret step;
}

# the bounded length of an inline name field after removing its space padding
fun inline_name_len(buf: *u8, pos: usize) usize {
    var n: usize = 16;
    for (n > 0 && buf[pos + n - 1] == ' ') { n = n - 1; }
    ret n;
}

# decode the decimal suffix of a BSD `#1/<length>` header name
#
# The suffix must contain at least one digit and only trailing spaces after the
# digit run. Every accumulation is compared with the already-bounded raw member
# size before multiplication, so an oversized field is rejected without integer
# overflow and without using bytes outside the member.
# ---
# buf:   archive bytes
# pos:   member-header offset
# limit: raw member-body size
# ok:    out - true when the suffix is numeric and does not exceed `limit`
# ret:   decoded name-prefix length
fun parse_extended_name_len(buf: *u8, pos: usize, limit: usize, ok: *bool) usize {
    var value:  usize = 0;
    var digits: usize = 0;
    var i:      usize = 3;

    for (i < 16) {
        val c: u8 = buf[pos + i];
        if (c == ' ') { brk; }
        if (c < '0' || c > '9') {
            @ok = false;
            ret 0;
        }
        val digit: usize = (c - '0')::usize;
        if (value > limit / 10 || (value == limit / 10 && digit > limit % 10)) {
            @ok = false;
            ret 0;
        }
        value  = value * 10 + digit;
        digits = digits + 1;
        i      = i + 1;
    }

    # once the digit run ends, the rest of the fixed field must be padding.
    for (i < 16) {
        if (buf[pos + i] != ' ') {
            @ok = false;
            ret 0;
        }
        i = i + 1;
    }

    @ok = digits > 0;
    ret value;
}

# whether a member is archive bookkeeping rather than an object
#
# An archiver prepends a symbol directory and, under GNU ar, a long-name table;
# neither is an object and both must be skipped. `next_member` has already
# bounded the name, whether it came from the fixed field or a BSD body prefix.
# The recognized bookkeeping names are:
#   `/`       - GNU symbol table (`/` then spaces)
#   `/SYM64/` - GNU 64-bit symbol table
#   `//`      - GNU long-name table
#   `__.SYMDEF`, `__.SYMDEF SORTED` - BSD symbol table
# A `/<digit>` name is a long-name reference to a real object, so a `/` followed
# by a digit is deliberately not treated as special.
# ---
# member: decoded archive member
# ret: true if the member is a symbol table or long-name table
pub fun is_special(member: Member) bool {
    if (member_name_equals(member, "/"))                 { ret true; }
    if (member_name_equals(member, "//"))                { ret true; }
    if (member_name_equals(member, "/SYM64/"))           { ret true; }
    if (member_name_equals(member, "__.SYMDEF"))         { ret true; }
    if (member_name_equals(member, "__.SYMDEF SORTED"))  { ret true; }
    ret false;
}

# whether a bounded member name exactly equals `want`
#
# BSD archivers round an extended name prefix up and fill the unused suffix with
# NUL bytes. Those bytes belong to the encoded prefix length but not the logical
# name, so trim them before comparing bookkeeping names.
fun member_name_equals(member: Member, want: str) bool {
    if (member.name == nil) { ret false; }
    var actual_len: usize = member.name_len;
    for (actual_len > 0 && member.name[actual_len - 1] == 0) {
        actual_len = actual_len - 1;
    }
    val want_len: usize = str_len(want);
    if (actual_len != want_len) { ret false; }
    var i: usize = 0;
    for (i < want_len) {
        if (member.name[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# decode the space-padded decimal-ASCII size field at `at`
#
# The `ar` size field is `SIZE_LEN` bytes holding a decimal count. It is normally
# left-justified with trailing spaces, but leading spaces are tolerated too; the
# scan skips leading spaces, reads the digit run, and stops at the first
# non-digit (the trailing padding). A field with no digit at all is malformed -
# `ok` is set false and the return value is unused.
# ---
# buf: the archive bytes
# at:  offset of the size field
# ok:  out - true if at least one digit was decoded
# ret: the decoded member size in bytes
fun parse_size(buf: *u8, at: usize, ok: *bool) usize {
    var size:   usize = 0;
    var digits: usize = 0;
    var i:      usize = 0;

    # skip any leading spaces before the digit run.
    for (i < SIZE_LEN && buf[at + i] == ' ') { i = i + 1; }

    # accumulate the digit run, stopping at the first non-digit (trailing pad).
    for (i < SIZE_LEN) {
        val c: u8 = buf[at + i];
        if (c < '0' || c > '9') { brk; }
        size   = size * 10 + (c - '0')::usize;
        digits = digits + 1;
        i      = i + 1;
    }

    @ok = digits > 0;
    ret size;
}

# one member to place into an archive: its file name, object bytes, and the names of
# the global symbols it defines (for the `/` symbol index the linker consults)
# ---
# name:      the member file name (unique within the archive)
# data:      the member's object bytes
# len:       byte length of `data`
# sym_names: the names of the defined global symbols this member exports
# sym_count: number of entries in `sym_names`
pub rec ArMember {
    name:      str;
    data:      *u8;
    len:       usize;
    sym_names: *str;
    sym_count: u32;
}

# the even-padded on-disk length of a member body (members pad to a 2-byte boundary)
fun even(x: usize) usize {
    if ((x & 1) == 1) { ret x + 1; }
    ret x;
}

# whether `name` fits the 16-byte inline name field (the name plus its `/` terminator)
fun inline_name(name: str) bool {
    ret str_len(name) + 1 <= 16;
}

# the number of decimal digits in `v` (at least 1)
fun dec_digits(v: usize) usize {
    var n: usize = 1;
    var t: usize = v;
    for (t >= 10) { t = t / 10; n = n + 1; }
    ret n;
}

# write `v` as left-justified decimal ASCII at `buf[off..]`, returning the digit count
fun put_dec(buf: *u8, off: usize, v: usize) usize {
    val d: usize = dec_digits(v);
    var i: usize = d;
    var t: usize = v;
    for (i > 0) {
        i = i - 1;
        buf[off + i] = ('0'::usize + (t % 10))::u8;
        t = t / 10;
    }
    ret d;
}

# write a 60-byte member header at `buf[off..]` with mtime/uid/gid 0, mode 644, the
# decimal `size`, and the `\x60\n` magic. the 16-byte name field is left as spaces for
# the caller to fill (inline `name/` or `/<longtable-offset>`).
fun put_header(buf: *u8, off: usize, size: usize) {
    var i: usize = 0;
    for (i < HEADER_LEN) { buf[off + i] = ' '; i = i + 1; }
    buf[off + 16] = '0';
    buf[off + 28] = '0';
    buf[off + 34] = '0';
    buf[off + 40] = '6'; buf[off + 41] = '4'; buf[off + 42] = '4';
    put_dec(buf, off + SIZE_OFFSET, size);
    buf[off + HEADER_LEN - 2] = 0x60;
    buf[off + HEADER_LEN - 1] = 0x0A;
}

# write the GNU `ar` archive of `members` to `out_path`: the `!<arch>\n` magic, a `/`
# symbol index mapping every member's defined globals to its header offset, a `//`
# long-name table for names past 15 bytes, then each member header + object bytes
# (padded to an even boundary). external-tool-free - mirrors the format the reader
# above frames. used for ELF/Mach-O `.a` and the COFF `.lib` ar variant.
# ---
# alloc:    allocator for the archive buffer and scratch arrays
# members:  the objects to archive, in link order
# count:    number of members
# out_path: the archive path to write
# ret:      ok(true) on success, or the first allocation / write error
pub fun write_archive(alloc: *A.Allocator, members: *ArMember, count: u32, out_path: str) R.Result[bool, str] {
    var total_syms: usize = 0;
    var strtab_len: usize = 0;
    var long_len:   usize = 0;
    var i: u32 = 0;
    for (i < count) {
        total_syms = total_syms + members[i].sym_count::usize;
        var s: u32 = 0;
        for (s < members[i].sym_count) { strtab_len = strtab_len + str_len(members[i].sym_names[s]) + 1; s = s + 1; }
        if (!inline_name(members[i].name)) { long_len = long_len + str_len(members[i].name) + 2; }
        i = i + 1;
    }
    val armap_content: usize = 4 + total_syms * 4 + strtab_len;
    val has_long: bool = long_len > 0;

    val res_lo: R.Result[*usize, str] = A.allocate[usize](alloc, count::usize);
    if (R.is_err[*usize, str](res_lo)) { ret R.err[bool, str](R.unwrap_err[*usize, str](res_lo)); }
    val long_off: *usize = R.unwrap_ok[*usize, str](res_lo);
    val res_ho: R.Result[*usize, str] = A.allocate[usize](alloc, count::usize);
    if (R.is_err[*usize, str](res_ho)) { A.deallocate[usize](alloc, long_off, count::usize); ret R.err[bool, str](R.unwrap_err[*usize, str](res_ho)); }
    val hdr_off: *usize = R.unwrap_ok[*usize, str](res_ho);

    var lo_run: usize = 0;
    i = 0;
    for (i < count) {
        long_off[i] = lo_run;
        if (!inline_name(members[i].name)) { lo_run = lo_run + str_len(members[i].name) + 2; }
        i = i + 1;
    }

    var pos: usize = MAGIC_LEN + HEADER_LEN + even(armap_content);
    if (has_long) { pos = pos + HEADER_LEN + even(long_len); }
    i = 0;
    for (i < count) {
        hdr_off[i] = pos;
        pos = pos + HEADER_LEN + even(members[i].len);
        i = i + 1;
    }
    val total: usize = pos;

    val res_buf: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](res_buf)) {
        A.deallocate[usize](alloc, long_off, count::usize);
        A.deallocate[usize](alloc, hdr_off, count::usize);
        ret R.err[bool, str](R.unwrap_err[*u8, str](res_buf));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var k: usize = 0;
    for (k < MAGIC_LEN) { buf[k] = MAGIC[k]; k = k + 1; }
    var off: usize = MAGIC_LEN;

    put_header(buf, off, armap_content);
    buf[off] = '/';
    off = off + HEADER_LEN;
    bin.write_u32_be(buf, off, total_syms::u32);
    var so: usize = off + 4;
    var st: usize = off + 4 + total_syms * 4;
    i = 0;
    for (i < count) {
        var s: u32 = 0;
        for (s < members[i].sym_count) {
            bin.write_u32_be(buf, so, hdr_off[i]::u32);
            so = so + 4;
            val nm: str = members[i].sym_names[s];
            val nl: usize = str_len(nm);
            var j: usize = 0;
            for (j < nl) { buf[st] = nm[j]; st = st + 1; j = j + 1; }
            buf[st] = 0; st = st + 1;
            s = s + 1;
        }
        i = i + 1;
    }
    off = off + armap_content;
    if ((armap_content & 1) == 1) { buf[off] = 0x0A; off = off + 1; }

    if (has_long) {
        put_header(buf, off, long_len);
        buf[off] = '/'; buf[off + 1] = '/';
        off = off + HEADER_LEN;
        i = 0;
        for (i < count) {
            if (!inline_name(members[i].name)) {
                val nm: str = members[i].name;
                val nl: usize = str_len(nm);
                var j: usize = 0;
                for (j < nl) { buf[off] = nm[j]; off = off + 1; j = j + 1; }
                buf[off] = '/'; off = off + 1;
                buf[off] = 0x0A; off = off + 1;
            }
            i = i + 1;
        }
        if ((long_len & 1) == 1) { buf[off] = 0x0A; off = off + 1; }
    }

    i = 0;
    for (i < count) {
        put_header(buf, off, members[i].len);
        if (inline_name(members[i].name)) {
            val nm: str = members[i].name;
            val nl: usize = str_len(nm);
            var j: usize = 0;
            for (j < nl) { buf[off + j] = nm[j]; j = j + 1; }
            buf[off + nl] = '/';
        }
        or {
            buf[off] = '/';
            put_dec(buf, off + 1, long_off[i]);
        }
        off = off + HEADER_LEN;
        var b: usize = 0;
        for (b < members[i].len) { buf[off] = members[i].data[b]; off = off + 1; b = b + 1; }
        if ((members[i].len & 1) == 1) { buf[off] = 0x0A; off = off + 1; }
        i = i + 1;
    }

    val wr: O.Option[str] = fs.write_bytes(out_path, buf, total, 0o644);
    A.deallocate[u8](alloc, buf, total);
    A.deallocate[usize](alloc, long_off, count::usize);
    A.deallocate[usize](alloc, hdr_off, count::usize);
    if (O.is_some[str](wr)) { ret R.err[bool, str](O.unwrap[str](wr)); }
    ret R.ok[bool, str](true);
}

# initialize one synthetic archive member for reader tests
fun test_member_header(buf: *u8, cap: usize, name: str, size: usize) {
    var i: usize = 0;
    for (i < cap) { buf[i] = 0; i = i + 1; }
    i = 0;
    for (i < MAGIC_LEN) { buf[i] = MAGIC[i]; i = i + 1; }
    put_header(buf, MAGIC_LEN, size);
    val name_len: usize = str_len(name);
    i = 0;
    for (i < name_len) { buf[MAGIC_LEN + i] = name[i]; i = i + 1; }
}

# whether a synthetic member is rejected when only `visible_len` bytes of its
# backing array belong to the archive
fun rejects_test_member(name: str, size: usize, visible_len: usize) bool {
    var buf: [96]u8;
    test_member_header(?buf[0], 96, name, size);
    val step: Step = next_member(?buf[0], visible_len, first_member());
    ret !step.ok;
}

# a BSD extended name is removed from the yielded payload while the raw member
# size still controls odd-byte padding and the next header offset
test "mach.lang.target.of.ar.next_member:bsd_extended_name_payload" {
    # 8-byte encoded name + 5-byte object payload = 13-byte odd raw body.
    var buf: [82]u8;
    test_member_header(?buf[0], 82, "#1/8", 13);
    val body: usize = MAGIC_LEN + HEADER_LEN;
    buf[body + 0] = 'l'; buf[body + 1] = 'o'; buf[body + 2] = 'n';
    buf[body + 3] = 'g'; buf[body + 4] = '.'; buf[body + 5] = 'o';
    buf[body + 6] = 0;   buf[body + 7] = 0;
    buf[body + 8] = 0xCF; buf[body + 9] = 0xFA; buf[body + 10] = 0xED;
    buf[body + 11] = 0xFE; buf[body + 12] = 7;
    buf[body + 13] = 0x0A;

    val step: Step = next_member(?buf[0], 82, first_member());
    if (!step.ok || step.done || step.next != 82) { ret 1; }
    if (step.member.name_len != 8 || step.member.name[0] != 'l' || step.member.name[5] != 'o') { ret 1; }
    if (step.member.len != 5 || step.member.data[0] != 0xCF || step.member.data[4] != 7) { ret 1; }
    if (is_special(step.member)) { ret 1; }

    val done: Step = next_member(?buf[0], 82, step.next);
    if (!done.ok || !done.done) { ret 1; }
    ret 0;
}

# Darwin encodes both BSD symbol-directory spellings through `#1/<length>`;
# their NUL-rounded names are bookkeeping, while a long ordinary member is not
test "mach.lang.target.of.ar.is_special:bsd_extended_symdef" {
    var sym: [84]u8;
    test_member_header(?sym[0], 84, "#1/12", 16);
    val sb: usize = MAGIC_LEN + HEADER_LEN;
    val sym_name: str = "__.SYMDEF";
    var i: usize = 0;
    for (i < str_len(sym_name)) { sym[sb + i] = sym_name[i]; i = i + 1; }
    sym[sb + 12] = 1; sym[sb + 13] = 2; sym[sb + 14] = 3; sym[sb + 15] = 4;
    val ss: Step = next_member(?sym[0], 84, first_member());
    if (!ss.ok || ss.member.len != 4 || !is_special(ss.member)) { ret 1; }

    var sorted: [90]u8;
    test_member_header(?sorted[0], 90, "#1/20", 22);
    val sorted_name: str = "__.SYMDEF SORTED";
    i = 0;
    for (i < str_len(sorted_name)) { sorted[sb + i] = sorted_name[i]; i = i + 1; }
    sorted[sb + 20] = 5; sorted[sb + 21] = 6;
    val so: Step = next_member(?sorted[0], 90, first_member());
    if (!so.ok || so.member.len != 2 || !is_special(so.member)) { ret 1; }

    var ordinary: [76]u8;
    test_member_header(?ordinary[0], 76, "#1/4", 8);
    ordinary[sb + 0] = 'x'; ordinary[sb + 1] = '.'; ordinary[sb + 2] = 'o'; ordinary[sb + 3] = 0;
    val os: Step = next_member(?ordinary[0], 76, first_member());
    if (!os.ok || is_special(os.member)) { ret 1; }

    # Traditional BSD also permits a short, space-padded name directly in the
    # fixed field. It remains special without using the extended-name path.
    var short_sym: [68]u8;
    test_member_header(?short_sym[0], 68, "__.SYMDEF", 0);
    val shs: Step = next_member(?short_sym[0], 68, first_member());
    if (!shs.ok || !is_special(shs.member)) { ret 1; }

    # A short ordinary BSD name has no GNU `/` terminator; its payload remains
    # untouched and its name is not mistaken for bookkeeping.
    var short_obj: [72]u8;
    test_member_header(?short_obj[0], 72, "short.o", 4);
    short_obj[sb + 0] = 9; short_obj[sb + 1] = 8;
    short_obj[sb + 2] = 7; short_obj[sb + 3] = 6;
    val sho: Step = next_member(?short_obj[0], 72, first_member());
    if (!sho.ok || is_special(sho.member) || sho.member.len != 4 || sho.member.data[3] != 6) { ret 1; }
    ret 0;
}

# malformed BSD extended-name fields never escape the fixed header or raw body:
# require digits only, reject lengths beyond the member, reject a truncated raw
# body, and continue requiring the pad byte for odd raw sizes
test "mach.lang.target.of.ar.next_member:bsd_extended_name_malformed" {
    if (!rejects_test_member("#1/",                4, 72)) { ret 1; }
    if (!rejects_test_member("#1/x",               4, 72)) { ret 1; }
    if (!rejects_test_member("#1/1x",              4, 72)) { ret 1; }
    if (!rejects_test_member("#1/5",               4, 72)) { ret 1; }
    if (!rejects_test_member("#1/9999999999999",   4, 72)) { ret 1; }
    if (!rejects_test_member("#1/4",               5, 72)) { ret 1; }
    if (!rejects_test_member("#1/4",               5, 73)) { ret 1; }
    ret 0;
}

# a written archive round-trips through the reader: valid magic, the `/` symbol index
# and `//` long-name table are skipped as specials, and exactly the two object members
# are yielded with their bytes intact - including a member whose name needs the
# long-name table (#1980)
test "mach.lang.target.of.ar.write_roundtrip" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var code: i32 = 0;

    var d1: [4]u8; d1[0] = 1::u8; d1[1] = 2::u8; d1[2] = 3::u8; d1[3] = 4::u8;
    var d2: [3]u8; d2[0] = 9::u8; d2[1] = 8::u8; d2[2] = 7::u8;
    var s1: [2]str; s1[0] = "foo"; s1[1] = "bar";
    var s2: [1]str; s2[0] = "aVeryLongExportedSymbolName";
    var members: [2]ArMember;
    members[0].name = "short.o";
    members[0].data = ?d1[0]; members[0].len = 4; members[0].sym_names = ?s1[0]; members[0].sym_count = 2;
    members[1].name = "a.long.member.name.needing.the.table.o";
    members[1].data = ?d2[0]; members[1].len = 3; members[1].sym_names = ?s2[0]; members[1].sym_count = 1;

    val res_temp: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach_test_ar");
    if (R.is_err[fs.TempFile, str](res_temp)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](res_temp);
    val path: str = fs.temp_path(?tf);
    if (R.is_err[bool, str](write_archive(?alloc, ?members[0], 2, path))) { fs.temp_close_and_remove(?tf); ret 1; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, path);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 1; }
    val b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    if (!is_archive(b.data, b.len)) { ret 1; }

    var pos: usize = first_member();
    var objs: u32 = 0;
    var m0_ok: bool = false;
    var m1_ok: bool = false;
    var walking: bool = true;
    for (walking) {
        val step: Step = next_member(b.data, b.len, pos);
        if (!step.ok) { code = 1; walking = false; }
        or (step.done) { walking = false; }
        or {
            if (!is_special(step.member)) {
                objs = objs + 1;
                if (step.member.len == 4 && step.member.data[0] == 1::u8 && step.member.data[3] == 4::u8) { m0_ok = true; }
                if (step.member.len == 3 && step.member.data[0] == 9::u8 && step.member.data[2] == 7::u8) { m1_ok = true; }
            }
            pos = step.next;
        }
    }
    if (objs != 2) { code = 1; }
    if (!m0_ok || !m1_ok) { code = 1; }
    ret code;
}
