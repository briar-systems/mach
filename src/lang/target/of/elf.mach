pub rec ElfLayout {
    class:        u8;
    addr_width:   u32;
    ehdr_size:    usize;
    shdr_size:    usize;
    phdr_size:    usize;
    sym_size:     usize;
    rela_size:    usize;
    struct_align: usize;
}

pub fun elf64_layout() ElfLayout {
    var l: ElfLayout;
    l.class        = ELFCLASS64;
    l.addr_width   = 8;
    l.ehdr_size    = 64;
    l.shdr_size    = 64;
    l.phdr_size    = 56;
    l.sym_size     = 24;
    l.rela_size    = 24;
    l.struct_align = 8;
    ret l;
}

pub fun elf32_layout() ElfLayout {
    var l: ElfLayout;
    l.class        = ELFCLASS32;
    l.addr_width   = 4;
    l.ehdr_size    = 52;
    l.shdr_size    = 40;
    l.phdr_size    = 32;
    l.sym_size     = 16;
    l.rela_size    = 12;
    l.struct_align = 4;
    ret l;
}

pub fun layout_for(tgt_isa: *of.ObjectTarget) ElfLayout {
    if (tgt_isa.pointer_width == 4) { ret elf32_layout(); }
    ret elf64_layout();
}

pub fun layout_from_class(cls: u8, out: *ElfLayout) bool {
    if (cls == ELFCLASS32) { @out = elf32_layout(); ret true; }
    if (cls == ELFCLASS64) { @out = elf64_layout(); ret true; }
    ret false;
}

fun write_addr(buf: *u8, off: usize, lay: *ElfLayout, v: u64) {
    if (lay.addr_width == 4) { bin.write_u32_le(buf, off, v::u32); ret; }
    bin.write_u64_le(buf, off, v);
}

fun read_addr(buf: *u8, off: usize, lay: *ElfLayout) u64 {
    if (lay.addr_width == 4) { ret bin.read_u32_le(buf, off)::u64; }
    ret bin.read_u64_le(buf, off);
}

fun write_ehdr(buf: *u8, lay: *ElfLayout, e_type: u16, e_machine: u16, e_flags: u32,
               e_entry: u64, e_phoff: u64, e_shoff: u64,
               e_phnum: u16, e_shnum: u16, e_shstrndx: u16) {
    bin.write_u16_le(buf, 16, e_type);
    bin.write_u16_le(buf, 18, e_machine);
    bin.write_u32_le(buf, 20, 1);
    val w: usize = lay.addr_width::usize;
    write_addr(buf, 24,         lay, e_entry);
    write_addr(buf, 24 + w,     lay, e_phoff);
    write_addr(buf, 24 + 2 * w, lay, e_shoff);
    var o: usize = 24 + 3 * w;
    bin.write_u32_le(buf, o,      e_flags);
    bin.write_u16_le(buf, o + 4,  lay.ehdr_size::u16);
    var phentsize: u16 = 0;
    if (e_phnum != 0) { phentsize = lay.phdr_size::u16; }
    bin.write_u16_le(buf, o + 6,  phentsize);
    bin.write_u16_le(buf, o + 8,  e_phnum);
    bin.write_u16_le(buf, o + 10, lay.shdr_size::u16);
    bin.write_u16_le(buf, o + 12, e_shnum);
    bin.write_u16_le(buf, o + 14, e_shstrndx);
}

fun write_shdr(buf: *u8, off: usize, lay: *ElfLayout,
               name: u32, stype: u32, flags: u64, addr: u64, offset: u64, size: u64,
               link: u32, info: u32, addralign: u64, entsize: u64) usize {
    val w: usize = lay.addr_width::usize;
    bin.write_u32_le(buf, off,     name);
    bin.write_u32_le(buf, off + 4, stype);
    write_addr(buf, off + 8,         lay, flags);
    write_addr(buf, off + 8 + w,     lay, addr);
    write_addr(buf, off + 8 + 2 * w, lay, offset);
    write_addr(buf, off + 8 + 3 * w, lay, size);
    var o: usize = off + 8 + 4 * w;
    bin.write_u32_le(buf, o,     link);
    bin.write_u32_le(buf, o + 4, info);
    write_addr(buf, o + 8,     lay, addralign);
    write_addr(buf, o + 8 + w, lay, entsize);
    ret off + lay.shdr_size;
}

fun write_phdr_at(buf: *u8, off: usize, lay: *ElfLayout,
                  ptype: u32, flags: u32, offset: u64, vaddr: u64, paddr: u64,
                  filesz: u64, memsz: u64, align: u64) usize {
    val w: usize = lay.addr_width::usize;
    bin.write_u32_le(buf, off, ptype);
    if (lay.addr_width == 8) {
        bin.write_u32_le(buf, off + 4, flags);
        write_addr(buf, off + 8,          lay, offset);
        write_addr(buf, off + 8 + w,      lay, vaddr);
        write_addr(buf, off + 8 + 2 * w,  lay, paddr);
        write_addr(buf, off + 8 + 3 * w,  lay, filesz);
        write_addr(buf, off + 8 + 4 * w,  lay, memsz);
        write_addr(buf, off + 8 + 5 * w,  lay, align);
        ret off + lay.phdr_size;
    }
    write_addr(buf, off + 4,      lay, offset);
    write_addr(buf, off + 8,      lay, vaddr);
    write_addr(buf, off + 12,     lay, paddr);
    write_addr(buf, off + 16,     lay, filesz);
    write_addr(buf, off + 20,     lay, memsz);
    bin.write_u32_le(buf, off + 24, flags);
    write_addr(buf, off + 28,     lay, align);
    ret off + lay.phdr_size;
}

fun write_sym_at(buf: *u8, off: usize, lay: *ElfLayout,
                 name: u32, info: u8, other: u8, shndx: u16, value: u64, size: u64) usize {
    bin.write_u32_le(buf, off, name);
    if (lay.addr_width == 8) {
        buf[off + 4] = info;
        buf[off + 5] = other;
        bin.write_u16_le(buf, off + 6, shndx);
        write_addr(buf, off + 8,  lay, value);
        write_addr(buf, off + 16, lay, size);
        ret off + lay.sym_size;
    }
    write_addr(buf, off + 4, lay, value);
    write_addr(buf, off + 8, lay, size);
    buf[off + 12] = info;
    buf[off + 13] = other;
    bin.write_u16_le(buf, off + 14, shndx);
    ret off + lay.sym_size;
}

fun rela_info_pack(lay: *ElfLayout, sym: u32, rtype: u32) u64 {
    if (lay.addr_width == 8) { ret (sym::u64 << 32) | rtype::u64; }
    ret (sym::u64 << 8) | rtype::u64;
}

fun rela_info_split(lay: *ElfLayout, info: u64, sym: *u32, rtype: *u32) {
    if (lay.addr_width == 8) {
        @sym   = (info >> 32)::u32;
        @rtype = (info & 0xFFFFFFFF)::u32;
        ret;
    }
    @sym   = (info >> 8)::u32;
    @rtype = (info & 0xFF)::u32;
}

fun reloc_type_fits_class(lay: *ElfLayout, rtype: u32) bool {
    if (lay.addr_width == 8) { ret true; }
    ret rtype <= 0xFF;
}

fun write_rela_at(buf: *u8, off: usize, lay: *ElfLayout,
                  r_offset: u64, sym: u32, rtype: u32, addend: i64) usize {
    val w: usize = lay.addr_width::usize;
    write_addr(buf, off,         lay, r_offset);
    write_addr(buf, off + w,     lay, rela_info_pack(lay, sym, rtype));
    write_addr(buf, off + 2 * w, lay, addend::u64);
    ret off + lay.rela_size;
}

rec ElfShdr {
    name:      u32;
    stype:     u32;
    flags:     u64;
    addr:      u64;
    offset:    u64;
    size:      u64;
    link:      u32;
    info:      u32;
    addralign: u64;
    entsize:   u64;
}

fun read_shdr(buf: *u8, off: usize, lay: *ElfLayout) ElfShdr {
    val w: usize = lay.addr_width::usize;
    var h: ElfShdr;
    h.name      = bin.read_u32_le(buf, off);
    h.stype     = bin.read_u32_le(buf, off + 4);
    h.flags     = read_addr(buf, off + 8,         lay);
    h.addr      = read_addr(buf, off + 8 + w,     lay);
    h.offset    = read_addr(buf, off + 8 + 2 * w, lay);
    h.size      = read_addr(buf, off + 8 + 3 * w, lay);
    val o: usize = off + 8 + 4 * w;
    h.link      = bin.read_u32_le(buf, o);
    h.info      = bin.read_u32_le(buf, o + 4);
    h.addralign = read_addr(buf, o + 8,     lay);
    h.entsize   = read_addr(buf, o + 8 + w, lay);
    ret h;
}

rec ElfSym {
    name:  u32;
    info:  u8;
    other: u8;
    shndx: u16;
    value: u64;
    size:  u64;
}

fun read_sym(buf: *u8, off: usize, lay: *ElfLayout) ElfSym {
    var s: ElfSym;
    s.name = bin.read_u32_le(buf, off);
    if (lay.addr_width == 8) {
        s.info  = buf[off + 4];
        s.other = buf[off + 5];
        s.shndx = bin.read_u16_le(buf, off + 6);
        s.value = read_addr(buf, off + 8,  lay);
        s.size  = read_addr(buf, off + 16, lay);
        ret s;
    }
    s.value = read_addr(buf, off + 4, lay);
    s.size  = read_addr(buf, off + 8, lay);
    s.info  = buf[off + 12];
    s.other = buf[off + 13];
    s.shndx = bin.read_u16_le(buf, off + 14);
    ret s;
}

fun read_rela(buf: *u8, off: usize, lay: *ElfLayout,
              r_offset: *u64, sym: *u32, rtype: *u32, addend: *i64) {
    val w: usize = lay.addr_width::usize;
    @r_offset = read_addr(buf, off, lay);
    rela_info_split(lay, read_addr(buf, off + w, lay), sym, rtype);
    if (lay.addr_width == 4) {
        @addend = bin.read_u32_le(buf, off + 8)::i32::i64;
        ret;
    }
    @addend = bin.read_u64_le(buf, off + 16)::i64;
}

fun reloc_type_for(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind, tgt_isa: *of.ObjectTarget) R.Result[u32, str] {
    if (tgt_isa == nil || tgt_isa.relocation == nil || !tgt_isa.relocation.has_elf
        || tgt_isa.relocation.elf.reloc_type == nil) {
        ret R.err[u32, str](unsupported_kind_message(itn, alloc, kind));
    }
    val t: u32 = tgt_isa.relocation.elf.reloc_type(kind);
    if (t == 0) { ret R.err[u32, str](unsupported_kind_message(itn, alloc, kind)); }
    ret R.ok[u32, str](t);
}

fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, machine: u16, r_type: u32) R.Result[of.RelocKind, str] {
    if (machine == EM_RISCV) {
        if (r_type == R_RISCV_64)           { ret R.ok[of.RelocKind, str](of.RK_ABS64); }
        if (r_type == R_RISCV_32_PCREL)     { ret R.ok[of.RelocKind, str](of.RK_PC32); }
        if (r_type == R_RISCV_CALL_PLT)     { ret R.ok[of.RelocKind, str](of.RK_PLT32); }
        if (r_type == R_RISCV_GOT_HI20)     { ret R.ok[of.RelocKind, str](of.RK_GOT_PCREL_HI20); }
        if (r_type == R_RISCV_PCREL_HI20)   { ret R.ok[of.RelocKind, str](of.RK_PCREL_HI20); }
        if (r_type == R_RISCV_PCREL_LO12_I) { ret R.ok[of.RelocKind, str](of.RK_PCREL_LO12_I); }
        if (r_type == R_RISCV_PCREL_LO12_S) { ret R.ok[of.RelocKind, str](of.RK_PCREL_LO12_S); }
        if (r_type == R_RISCV_32)           { ret R.ok[of.RelocKind, str](of.RK_ABS32); }
        ret R.err[of.RelocKind, str](unsupported_type_message(itn, alloc, r_type::u64));
    }
    if (r_type == R_X86_64_64 || r_type == R_AARCH64_ABS64)     { ret R.ok[of.RelocKind, str](of.RK_ABS64); }
    if (r_type == R_X86_64_PC32 || r_type == R_AARCH64_PREL32)  { ret R.ok[of.RelocKind, str](of.RK_PC32); }
    if (r_type == R_X86_64_PLT32 || r_type == R_AARCH64_CALL26) { ret R.ok[of.RelocKind, str](of.RK_PLT32); }
    if (r_type == R_AARCH64_JUMP26)                             { ret R.ok[of.RelocKind, str](of.RK_JUMP26); }
    if (r_type == R_X86_64_GOTPCREL || r_type == R_X86_64_GOTPCRELX
        || r_type == R_X86_64_REX_GOTPCRELX)                    { ret R.ok[of.RelocKind, str](of.RK_GOTPCREL); }
    if (r_type == R_X86_64_32S)                                 { ret R.ok[of.RelocKind, str](of.RK_ABS32S); }
    if (r_type == R_X86_64_32 || r_type == R_AARCH64_ABS32)     { ret R.ok[of.RelocKind, str](of.RK_ABS32); }
    if (r_type == R_AARCH64_ADR_PREL_PG_HI21)                   { ret R.ok[of.RelocKind, str](of.RK_PAGE21); }
    if (r_type == R_AARCH64_ADD_ABS_LO12_NC)                    { ret R.ok[of.RelocKind, str](of.RK_ADD_LO12); }
    if (r_type == R_AARCH64_LDST8_ABS_LO12_NC)                  { ret R.ok[of.RelocKind, str](of.RK_LDST8_LO12); }
    if (r_type == R_AARCH64_LDST16_ABS_LO12_NC)                 { ret R.ok[of.RelocKind, str](of.RK_LDST16_LO12); }
    if (r_type == R_AARCH64_LDST32_ABS_LO12_NC)                 { ret R.ok[of.RelocKind, str](of.RK_LDST32_LO12); }
    if (r_type == R_AARCH64_LDST64_ABS_LO12_NC)                 { ret R.ok[of.RelocKind, str](of.RK_LDST64_LO12); }
    if (r_type == R_AARCH64_LDST128_ABS_LO12_NC)                { ret R.ok[of.RelocKind, str](of.RK_LDST128_LO12); }
    if (r_type == R_AARCH64_ADR_GOT_PAGE)                       { ret R.ok[of.RelocKind, str](of.RK_GOT_PAGE21); }
    if (r_type == R_AARCH64_LD64_GOT_LO12_NC)                   { ret R.ok[of.RelocKind, str](of.RK_GOT_LO12); }
    ret R.err[of.RelocKind, str](unsupported_type_message(itn, alloc, r_type::u64));
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret bin.name_message(itn, alloc, "elf: unsupported relocation kind: ",
                         of.reloc_kind_name(kind), "elf: unsupported relocation kind");
}

fun unsupported_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u64) str {
    ret bin.number_message(itn, alloc, "elf: unsupported relocation type ",
                           r_type, "elf: unsupported relocation type");
}

fun unencodable_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u32) str {
    ret bin.number_message(itn, alloc, "elf: relocation type does not fit an ELFCLASS32 r_info: ",
                           r_type::u64, "elf: relocation type does not fit an ELFCLASS32 r_info");
}

fun validate_reloc_kinds(img: *of.ObjectImage, tgt_isa: *of.ObjectTarget, lay: *ElfLayout) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: R.Result[u32, str] = reloc_type_for(img.interner, img.alloc, img.relocations[i].kind, tgt_isa);
        if (R.is_err[u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](r)); }
        if (!reloc_type_fits_class(lay, R.unwrap_ok[u32, str](r))) {
            ret R.err[R.Void, str](unencodable_type_message(img.interner, img.alloc, R.unwrap_ok[u32, str](r)));
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun write_elf_ident(buf: *u8, lay: *ElfLayout) {
    buf[0] = 0x7F; buf[1] = 0x45; buf[2] = 0x4C; buf[3] = 0x46;
    buf[4] = lay.class;
    buf[5] = ELFDATA2LSB;
    buf[6] = EV_CURRENT;
    buf[7] = ELFOSABI_NONE;
}

fun section_type_for(kind: of.SectionKind) u32 {
    if (kind == of.SK_BSS) { ret SHT_NOBITS; }
    ret SHT_PROGBITS;
}

fun section_flags_for_section(sec: *of.Section) u64 {
    var f: u64 = section_flags_for(sec.kind);
    if ((sec.flags & of.SEC_FLAG_MERGEABLE) != 0 && sec.kind != of.SK_BSS) { f = f | SHF_MERGE; }
    ret f;
}

fun section_flags_for(kind: of.SectionKind) u64 {
    if (kind == of.SK_DEBUG) { ret 0; }
    var f: u64 = SHF_ALLOC;
    if (kind == of.SK_TEXT) { f = f | SHF_EXECINSTR; }
    if (kind == of.SK_DATA) { f = f | SHF_WRITE; }
    if (kind == of.SK_BSS)  { f = f | SHF_WRITE; }
    ret f;
}

fun count_relocs_for_section(img: *of.ObjectImage, sec_idx: u32) u32 {
    var len: u32 = 0;
    var i: u32 = 0;
    for (i < img.reloc_count) {
        if (img.relocations[i].section == sec_idx) { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun sections_with_relocs(img: *of.ObjectImage) u32 {
    var len: u32 = 0;
    var s: u32 = 0;
    for (s < img.section_count) {
        if (count_relocs_for_section(img, s) > 0) { len = len + 1; }
        s = s + 1;
    }
    ret len;
}

fun strtab_size(img: *of.ObjectImage) usize {
    var len: usize = 1;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val name: str = bin.resolve_name(img.interner, img.symbols[i].name);
        if (name != nil) { len = len + str_len(name) + 1; } or { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun reloc_sym_index(img: *of.ObjectImage, r: *of.Relocation) R.Result[u32, str] {
    if (r.sym < img.symbol_count) { ret R.ok[u32, str](r.sym); }
    ret R.err[u32, str](unresolved_reloc_message(img.interner, img.alloc,
        of.reloc_symbol_name(img, r)));
}

fun unresolved_reloc_message(itn: *intern.Interner, alloc: *A.Allocator, sym: intern.StrId) str {
    ret bin.name_message(itn, alloc, "elf: unresolved relocation symbol: ",
                         bin.resolve_name(itn, sym), "elf: relocation references an unresolved symbol");
}

fun validate_reloc_symbols(img: *of.ObjectImage) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: R.Result[u32, str] = reloc_sym_index(img, ?img.relocations[i]);
        if (R.is_err[u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun write_symbol(buf: *u8, sym_off: usize, lay: *ElfLayout, str_off: usize, str_pos: *usize,
                 img: *of.ObjectImage, idx: u32, binding: u8) {
    val name_pos: usize = @str_pos;
    @str_pos = @str_pos + bin.write_str(buf, str_off + @str_pos, bin.resolve_name(img.interner, img.symbols[idx].name));

    var sym_type: u8 = STT_NOTYPE;
    var sec_idx: u16 = 0;
    if (img.symbols[idx].section != of.SECTION_EXTERNAL && img.symbols[idx].section < img.section_count) {
        sec_idx = (img.symbols[idx].section + 1)::u16;
    }
    if ((img.symbols[idx].flags & of.SYM_OBJ_FLAG_FUNCTION) != 0) { sym_type = STT_FUNC; }
    or ((img.symbols[idx].flags & of.SYM_OBJ_FLAG_OBJECT) != 0)   { sym_type = STT_OBJECT; }

    val info: u8 = (binding << 4) | (sym_type & 0xF);
    write_sym_at(buf, sym_off, lay, name_pos::u32, info, 0, sec_idx,
                 img.symbols[idx].offset::u64, img.symbols[idx].size::u64);
}

rec SymtabBuild {
    symtab_bytes: *u8;
    symtab_size:  usize;
    strtab_bytes: *u8;
    strtab_size:  usize;
    local_count:  u32;
}

fun build_symtab_bytes(alloc: *A.Allocator, itn: *intern.Interner, lay: *ElfLayout,
                       symtab: *of.SymtabEntry,
                       symtab_count: u32, segs: *of.LoadSegment, seg_count: u32) R.Result[SymtabBuild, str] {
    var out: SymtabBuild;
    out.symtab_bytes = nil; out.symtab_size = 0;
    out.strtab_bytes = nil; out.strtab_size = 0;
    out.local_count  = 0;
    if (symtab_count == 0) { ret R.ok[SymtabBuild, str](out); }

    var strtab_sz: usize = 1;
    var i: u32 = 0;
    for (i < symtab_count) {
        strtab_sz = strtab_sz + str_len(bin.resolve_name(itn, symtab[i].name)) + 1;
        i = i + 1;
    }
    val symtab_sz: usize = lay.sym_size * (symtab_count::usize + 1);

    val sr: R.Result[*u8, str] = A.zallocate[u8](alloc, symtab_sz);
    if (R.is_err[*u8, str](sr)) { ret R.err[SymtabBuild, str]("elf: symtab buffer alloc failed"); }
    val sbuf: *u8 = R.unwrap_ok[*u8, str](sr);

    val tr: R.Result[*u8, str] = A.zallocate[u8](alloc, strtab_sz);
    if (R.is_err[*u8, str](tr)) {
        A.deallocate[u8](alloc, sbuf, symtab_sz);
        ret R.err[SymtabBuild, str]("elf: strtab buffer alloc failed");
    }
    val tbuf: *u8 = R.unwrap_ok[*u8, str](tr);

    tbuf[0] = 0;
    var str_pos: usize = 1;
    i = 0;
    for (i < symtab_count) {
        val name_pos: usize = str_pos;
        str_pos = str_pos + bin.write_str(tbuf, str_pos, bin.resolve_name(itn, symtab[i].name));

        var shndx: u16 = 1;
        var sgi: u32 = 0;
        for (sgi < seg_count) {
            val sv: u64 = segs[sgi].vaddr;
            if (symtab[i].vaddr >= sv && symtab[i].vaddr < sv + segs[sgi].memsz::u64) { shndx = (sgi + 1)::u16; }
            sgi = sgi + 1;
        }

        var binding: u8 = STB_GLOBAL;
        if (!symtab[i].global) { binding = STB_LOCAL; out.local_count = out.local_count + 1; }

        val sym_off: usize = lay.sym_size * (i::usize + 1);
        write_sym_at(sbuf, sym_off, lay, name_pos::u32, (binding << 4) | (STT_FUNC & 0xF), 0,
                     shndx, symtab[i].vaddr, symtab[i].size::u64);

        i = i + 1;
    }

    out.symtab_bytes = sbuf; out.symtab_size = symtab_sz;
    out.strtab_bytes = tbuf; out.strtab_size = strtab_sz;
    out.local_count  = out.local_count + 1;
    ret R.ok[SymtabBuild, str](out);
}

fun free_symtab_bytes(alloc: *A.Allocator, b: *SymtabBuild) {
    if (b.symtab_bytes != nil) { A.deallocate[u8](alloc, b.symtab_bytes, b.symtab_size); }
    if (b.strtab_bytes != nil) { A.deallocate[u8](alloc, b.strtab_bytes, b.strtab_size); }
}

pub def BuildAttributes: of.ElfAttributes;

fun attributes_for(tgt_isa: *of.ObjectTarget) *BuildAttributes {
    if (tgt_isa == nil || tgt_isa.relocation == nil || !tgt_isa.relocation.has_elf) { ret nil; }
    if (!tgt_isa.relocation.elf.has_attributes) { ret nil; }
    ret ?tgt_isa.relocation.elf.attributes;
}

fun uleb128_size(value: u32) usize {
    var v: u32 = value;
    var n: usize = 1;
    for (v >= 0x80) { v = v >> 7; n = n + 1; }
    ret n;
}

fun write_uleb128(buf: *u8, offset: usize, value: u32) usize {
    var v: u32 = value;
    var n: usize = 0;
    var more: bool = true;
    for (more) {
        var b: u8 = (v & 0x7F)::u8;
        v = v >> 7;
        if (v != 0) { b = b | 0x80; } or { more = false; }
        buf[offset + n] = b;
        n = n + 1;
    }
    ret n;
}

fun build_attributes_size(attr: *BuildAttributes, body_len: u32) usize {
    val attr_data: usize = body_len::usize;
    val file_subsec: usize = uleb128_size(ELF_ATTR_TAG_FILE) + 4 + attr_data;
    val vendor_subsec: usize = 4 + (str_len(attr.vendor) + 1) + file_subsec;
    ret 1 + vendor_subsec;
}

fun write_build_attributes(buf: *u8, offset: usize, attr: *BuildAttributes,
                           body: *u8, body_len: u32) {
    var p: usize = offset;
    buf[p] = ELF_ATTR_VERSION_A;
    p = p + 1;

    val attr_data:     usize = body_len::usize;
    val file_subsec:   usize = uleb128_size(ELF_ATTR_TAG_FILE) + 4 + attr_data;
    val vendor_subsec: usize = 4 + (str_len(attr.vendor) + 1) + file_subsec;

    bin.write_u32_le(buf, p, vendor_subsec::u32);
    p = p + 4;
    p = p + bin.write_str(buf, p, attr.vendor);

    p = p + write_uleb128(buf, p, ELF_ATTR_TAG_FILE);
    bin.write_u32_le(buf, p, file_subsec::u32);
    p = p + 4;

    var i: u32 = 0;
    for (i < body_len) { buf[p + i::usize] = body[i]; i = i + 1; }
}

fun emit_object(tgt_isa: *of.ObjectTarget, img: *of.ObjectImage, destination: *publication.Destination) R.Result[R.Void, str] {
    if (tgt_isa == nil || img == nil || destination == nil) {
        ret R.err[R.Void, str]("elf: nil writer argument");
    }
    val alloc: *A.Allocator = img.alloc;

    var lay: ElfLayout = layout_for(tgt_isa);

    val vrs: R.Result[R.Void, str] = validate_reloc_symbols(img);
    if (R.is_err[R.Void, str](vrs)) { ret vrs; }

    val vrk: R.Result[R.Void, str] = validate_reloc_kinds(img, tgt_isa, ?lay);
    if (R.is_err[R.Void, str](vrk)) { ret vrk; }

    var attr: *BuildAttributes = attributes_for(tgt_isa);
    if (img.attributes == nil || img.attributes_len == 0) { attr = nil; }
    var attr_size: usize = 0;
    if (attr != nil) { attr_size = build_attributes_size(attr, img.attributes_len); }

    val num_secs:      u32 = img.section_count;
    val num_syms:      u32 = img.symbol_count;
    val num_rela_secs: u32 = sections_with_relocs(img);

    var total_shdr: u32 = 1 + num_secs + 3 + num_rela_secs;
    if (attr != nil) { total_shdr = total_shdr + 1; }
    if (total_shdr > 0xFEFF) { ret R.err[R.Void, str]("elf: section-header count exceeds the ELF e_shnum limit"); }
    val shdr_table_size: usize = total_shdr::usize * lay.shdr_size;

    var shstrtab_cap: usize = 1;
    var s: u32 = 0;
    for (s < num_secs) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (sn != nil) { shstrtab_cap = shstrtab_cap + str_len(sn) + 1; } or { shstrtab_cap = shstrtab_cap + 1; }
        s = s + 1;
    }
    shstrtab_cap = shstrtab_cap + 8 + 8 + 10;
    if (attr != nil) { shstrtab_cap = shstrtab_cap + str_len(attr.section) + 1; }
    s = 0;
    for (s < num_secs) {
        if (count_relocs_for_section(img, s) > 0) {
            val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
            if (sn != nil) { shstrtab_cap = shstrtab_cap + 5 + str_len(sn) + 1; } or { shstrtab_cap = shstrtab_cap + 5 + 1; }
        }
        s = s + 1;
    }

    val res_shstr: R.Result[*u8, str] = A.zallocate[u8](alloc, shstrtab_cap);
    if (R.is_err[*u8, str](res_shstr)) { ret R.err[R.Void, str]("elf: shstrtab alloc failed"); }
    var shstrtab: *u8 = R.unwrap_ok[*u8, str](res_shstr);

    val res_names: R.Result[*u32, str] = A.zallocate[u32](alloc, (num_secs + 1)::usize);
    if (R.is_err[*u32, str](res_names)) {
        A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
        ret R.err[R.Void, str]("elf: name table alloc failed");
    }
    var name_offsets: *u32 = R.unwrap_ok[*u32, str](res_names);

    val res_rnames: R.Result[*u32, str] = A.zallocate[u32](alloc, (num_secs + 1)::usize);
    if (R.is_err[*u32, str](res_rnames)) {
        A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
        A.deallocate[u32](alloc, name_offsets, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("elf: rela name table alloc failed");
    }
    var rela_name_offsets: *u32 = R.unwrap_ok[*u32, str](res_rnames);

    var shstrtab_off: usize = 1;
    s = 0;
    for (s < num_secs) {
        name_offsets[s] = shstrtab_off::u32;
        shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, bin.resolve_name(img.interner, img.sections[s].name));
        s = s + 1;
    }
    val symtab_name_off: u32 = shstrtab_off::u32;
    shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, ".symtab");
    val strtab_name_off: u32 = shstrtab_off::u32;
    shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, ".strtab");
    val shstrtab_name_off: u32 = shstrtab_off::u32;
    shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, ".shstrtab");
    var attr_name_off: u32 = 0;
    if (attr != nil) {
        attr_name_off = shstrtab_off::u32;
        shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, attr.section);
    }

    s = 0;
    for (s < num_secs) {
        if (count_relocs_for_section(img, s) > 0) {
            rela_name_offsets[s] = shstrtab_off::u32;
            shstrtab[shstrtab_off]     = '.';
            shstrtab[shstrtab_off + 1] = 'r';
            shstrtab[shstrtab_off + 2] = 'e';
            shstrtab[shstrtab_off + 3] = 'l';
            shstrtab[shstrtab_off + 4] = 'a';
            shstrtab_off = shstrtab_off + 5;
            shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, bin.resolve_name(img.interner, img.sections[s].name));
        }
        s = s + 1;
    }
    val shstrtab_len: usize = shstrtab_off;

    var data_offset: usize = lay.ehdr_size;
    s = 0;
    for (s < num_secs) {
        if (img.sections[s].kind != of.SK_BSS) {
            data_offset = bin.align_up(data_offset, img.sections[s].align::usize);
            data_offset = data_offset + img.sections[s].len::usize;
        }
        s = s + 1;
    }

    val symtab_offset: usize = bin.align_up(data_offset, lay.struct_align);
    val symtab_size: usize = (num_syms + 1)::usize * lay.sym_size;
    val strtab_offset: usize = symtab_offset + symtab_size;
    val strtab_sz: usize = strtab_size(img);
    val shstrtab_offset: usize = strtab_offset + strtab_sz;

    val res_roff: R.Result[*usize, str] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (R.is_err[*usize, str](res_roff)) {
        A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
        A.deallocate[u32](alloc, name_offsets, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, rela_name_offsets, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("elf: rela offset table alloc failed");
    }
    var rela_offsets: *usize = R.unwrap_ok[*usize, str](res_roff);

    var rela_offset: usize = shstrtab_offset + shstrtab_len;
    s = 0;
    for (s < num_secs) {
        val rc: u32 = count_relocs_for_section(img, s);
        if (rc > 0) {
            rela_offset = bin.align_up(rela_offset, lay.struct_align);
            rela_offsets[s] = rela_offset;
            rela_offset = rela_offset + rc::usize * lay.rela_size;
        }
        s = s + 1;
    }

    var attr_offset: usize = 0;
    if (attr != nil) {
        attr_offset = rela_offset;
        rela_offset = rela_offset + attr_size;
    }

    val shdr_offset: usize = bin.align_up(rela_offset, lay.struct_align);
    val total_file_size: usize = shdr_offset + shdr_table_size;

    var tile: bin.Layout;
    bin.layout_init(?tile);
    bin.layout_region(?tile, "elf header", 0, lay.ehdr_size);
    s = 0;
    for (s < num_secs) {
        if (img.sections[s].kind != of.SK_BSS) {
            bin.layout_pad(?tile, "section alignment",
                           bin.align_up(tile.end, img.sections[s].align::usize));
            bin.layout_region(?tile, "section data", tile.end, img.sections[s].len::usize);
        }
        s = s + 1;
    }
    bin.layout_pad(?tile, "symbol table alignment", symtab_offset);
    bin.layout_region(?tile, "symbol table", symtab_offset, symtab_size);
    bin.layout_region(?tile, "string table", strtab_offset, strtab_sz);
    bin.layout_region(?tile, "section name table", shstrtab_offset, shstrtab_len);
    s = 0;
    for (s < num_secs) {
        val rc_t: u32 = count_relocs_for_section(img, s);
        if (rc_t > 0) {
            bin.layout_pad(?tile, "relocation alignment", rela_offsets[s]);
            bin.layout_region(?tile, "relocations", rela_offsets[s], rc_t::usize * lay.rela_size);
        }
        s = s + 1;
    }
    if (attr != nil) {
        bin.layout_region(?tile, "build attributes", attr_offset, attr_size);
    }
    bin.layout_pad(?tile, "section header alignment", shdr_offset);
    bin.layout_region(?tile, "section header table", shdr_offset, shdr_table_size);
    val tiled: R.Result[R.Void, str] = bin.layout_seal(?tile, alloc, "elf", total_file_size);
    if (R.is_err[R.Void, str](tiled)) {
        A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
        A.deallocate[u32](alloc, name_offsets, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, rela_name_offsets, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, rela_offsets, (num_secs + 1)::usize);
        ret tiled;
    }

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_file_size);
    if (R.is_err[*u8, str](res_buf)) {
        A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
        A.deallocate[u32](alloc, name_offsets, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, rela_name_offsets, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, rela_offsets, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("elf: output buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    write_elf_ident(buf, ?lay);

    val shstrtab_idx: u16 = (num_secs + 3)::u16;
    write_ehdr(buf, ?lay, ET_REL, tgt_isa.elf_machine::u16, img.machine_flags,
               0, 0, shdr_offset::u64, 0, total_shdr::u16, shstrtab_idx);

    var sec_offset: usize = lay.ehdr_size;
    s = 0;
    for (s < num_secs) {
        if (img.sections[s].kind != of.SK_BSS) {
            sec_offset = bin.align_up(sec_offset, img.sections[s].align::usize);
            if (img.sections[s].bytes != nil && img.sections[s].len > 0) {
                memory.raw_copy((buf::usize + sec_offset)::ptr, img.sections[s].bytes::ptr, img.sections[s].len::usize);
            }
            sec_offset = sec_offset + img.sections[s].len::usize;
        }
        s = s + 1;
    }

    var sym_remap: *u32 = nil;
    if (num_syms > 0) {
        val res_remap: R.Result[*u32, str] = A.zallocate[u32](alloc, num_syms::usize);
        if (R.is_err[*u32, str](res_remap)) {
            A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
            A.deallocate[u32](alloc, name_offsets, (num_secs + 1)::usize);
            A.deallocate[u32](alloc, rela_name_offsets, (num_secs + 1)::usize);
            A.deallocate[usize](alloc, rela_offsets, (num_secs + 1)::usize);
            A.deallocate[u8](alloc, buf, total_file_size);
            ret R.err[R.Void, str]("elf: symbol remap alloc failed");
        }
        sym_remap = R.unwrap_ok[*u32, str](res_remap);
    }

    var sym_off: usize = symtab_offset + lay.sym_size;
    var str_off: usize = strtab_offset;
    buf[str_off] = 0;
    var str_pos: usize = 1;
    var elf_idx: u32 = 1;

    var symi: u32 = 0;
    for (symi < num_syms) {
        if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) { symi = symi + 1; cnt; }
        if (sym_remap != nil)                                        { sym_remap[symi] = elf_idx; }
        write_symbol(buf, sym_off, ?lay, str_off, ?str_pos, img, symi, STB_LOCAL);
        sym_off = sym_off + lay.sym_size;
        elf_idx = elf_idx + 1;
        symi = symi + 1;
    }
    val first_global: u32 = elf_idx;
    symi = 0;
    for (symi < num_syms) {
        if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { symi = symi + 1; cnt; }
        if (sym_remap != nil)                                        { sym_remap[symi] = elf_idx; }
        var bind: u8 = STB_GLOBAL;
        if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_WEAK) != 0) { bind = STB_WEAK; }
        write_symbol(buf, sym_off, ?lay, str_off, ?str_pos, img, symi, bind);
        sym_off = sym_off + lay.sym_size;
        elf_idx = elf_idx + 1;
        symi = symi + 1;
    }

    memory.raw_copy((buf::usize + shstrtab_offset)::ptr, shstrtab::ptr, shstrtab_len);

    s = 0;
    for (s < num_secs) {
        val rc: u32 = count_relocs_for_section(img, s);
        if (rc > 0) {
            var ro: usize = rela_offsets[s];
            var ri: u32 = 0;
            for (ri < img.reloc_count) {
                if (img.relocations[ri].section == s) {
                    val rsi: u32 = R.unwrap_ok[u32, str](reloc_sym_index(img, ?img.relocations[ri]));
                    val elf_type: u32 = R.unwrap_ok[u32, str](reloc_type_for(img.interner, alloc, img.relocations[ri].kind, tgt_isa));
                    ro = write_rela_at(buf, ro, ?lay, img.relocations[ri].offset::u64,
                                       sym_remap[rsi], elf_type, img.relocations[ri].addend);
                }
                ri = ri + 1;
            }
        }
        s = s + 1;
    }

    if (attr != nil) {
        write_build_attributes(buf, attr_offset, attr, img.attributes, img.attributes_len);
    }

    var shdr_pos: usize = shdr_offset;
    memory.raw_zero((buf::usize + shdr_pos)::ptr, lay.shdr_size);
    shdr_pos = shdr_pos + lay.shdr_size;

    sec_offset = lay.ehdr_size;
    s = 0;
    for (s < num_secs) {
        var this_off: usize = 0;
        if (img.sections[s].kind != of.SK_BSS) {
            sec_offset = bin.align_up(sec_offset, img.sections[s].align::usize);
            this_off = sec_offset;
        }
        var sh_off: u64 = this_off::u64;
        if (img.sections[s].kind == of.SK_BSS) { sh_off = 0; }
        var sec_align: usize = img.sections[s].align::usize;
        if (sec_align == 0) { sec_align = 1; }
        var entsize: u64 = 0;
        if ((section_flags_for_section(?img.sections[s]) & SHF_MERGE) != 0) {
            entsize = img.sections[s].len::u64;
        }
        shdr_pos = write_shdr(buf, shdr_pos, ?lay, name_offsets[s],
                              section_type_for(img.sections[s].kind),
                              section_flags_for_section(?img.sections[s]), 0,
                              sh_off, img.sections[s].len::u64, 0, 0,
                              sec_align::u64, entsize);
        if (img.sections[s].kind != of.SK_BSS) {
            sec_offset = sec_offset + img.sections[s].len::usize;
        }
        s = s + 1;
    }

    val symtab_shidx: u32 = 1 + num_secs;
    shdr_pos = write_shdr(buf, shdr_pos, ?lay, symtab_name_off, SHT_SYMTAB, 0, 0,
                          symtab_offset::u64, symtab_size::u64,
                          (symtab_shidx + 1)::u32, first_global::u32,
                          lay.struct_align::u64, lay.sym_size::u64);

    shdr_pos = write_shdr(buf, shdr_pos, ?lay, strtab_name_off, SHT_STRTAB, 0, 0,
                          strtab_offset::u64, strtab_sz::u64, 0, 0, 1, 0);

    shdr_pos = write_shdr(buf, shdr_pos, ?lay, shstrtab_name_off, SHT_STRTAB, 0, 0,
                          shstrtab_offset::u64, shstrtab_len::u64, 0, 0, 1, 0);

    s = 0;
    for (s < num_secs) {
        val rc: u32 = count_relocs_for_section(img, s);
        if (rc > 0) {
            shdr_pos = write_shdr(buf, shdr_pos, ?lay, rela_name_offsets[s], SHT_RELA, 0, 0,
                                  rela_offsets[s]::u64, (rc::usize * lay.rela_size)::u64,
                                  symtab_shidx::u32, (s + 1)::u32,
                                  lay.struct_align::u64, lay.rela_size::u64);
        }
        s = s + 1;
    }

    if (attr != nil) {
        shdr_pos = write_shdr(buf, shdr_pos, ?lay, attr_name_off, attr.sht, 0, 0,
                              attr_offset::u64, attr_size::u64, 0, 0, 1, 0);
    }

    if (sym_remap != nil) { A.deallocate[u32](alloc, sym_remap, num_syms::usize); }

    val pr: R.Result[R.Void, str] = publication.bytes_at(img.interner, img.alloc, ?destination.claim, destination.path, buf, total_file_size, 0o644, publication.REPLACE, "elf: cannot publish", "elf: could not publish output file", nil);

    A.deallocate[u8](alloc, buf, total_file_size);
    A.deallocate[u8](alloc, shstrtab, shstrtab_cap);
    A.deallocate[u32](alloc, name_offsets, (num_secs + 1)::usize);
    A.deallocate[u32](alloc, rela_name_offsets, (num_secs + 1)::usize);
    A.deallocate[usize](alloc, rela_offsets, (num_secs + 1)::usize);

    ret pr;
}

pub fun register(reg: *of.OfRegistry) R.Result[R.Void, str] {
    var elf_vtable: of.OfVTable = of.linker_vtable(
        of.OF_ELF, of.of_name_for(of.OF_ELF), "o", emit_object, parse_object, emit_exec
    );
    of.with_dynamic_exec(?elf_vtable, emit_dyn_exec);
    of.with_shared_output(?elf_vtable, emit_shared);

    elf_vtable.two_level_namespace = false;

    elf_vtable.default_debug    = "dwarf";
    elf_vtable.shared_input_ext = ".so";
    elf_vtable.import_address_prefix = "";
    elf_vtable.header_in_first_segment = false;
    elf_vtable.carries_stack_size = false;
    elf_vtable.default_stack_reserve = 0;
    elf_vtable.executable_section_location = nil;

    elf_vtable.covers_isa_any   = false;
    elf_vtable.covers_isa_count = 0;
    of.cover_isa(?elf_vtable, isa.ARCH_X86_64);
    of.cover_isa(?elf_vtable, isa.ARCH_AARCH64);
    of.cover_isa(?elf_vtable, isa.ARCH_RISCV64);
    of.cover_isa(?elf_vtable, isa.ARCH_RISCV32);

    ret of.register(reg, ?elf_vtable);
}

fun pf_flags_for(flags: u32) u32 {
    var f: u32 = 0;
    if ((flags & of.SEG_FLAG_READ) != 0)    { f = f | PF_R; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { f = f | PF_W; }
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { f = f | PF_X; }
    if (f == 0)                             { f = PF_R; }
    ret f;
}

fun seg_section_name(flags: u32) str {
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { ret ".text"; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { ret ".data"; }
    ret ".rodata";
}

fun seg_section_flags(flags: u32) u64 {
    var f: u64 = SHF_ALLOC;
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { f = f | SHF_EXECINSTR; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { f = f | SHF_WRITE; }
    ret f;
}

fun highest_vaddr(segs: *of.LoadSegment, seg_count: u32) u64 {
    var hi: u64 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        val end: u64 = segs[li].vaddr + segs[li].memsz::u64;
        if (end > hi) { hi = end; }
        li = li + 1;
    }
    ret hi;
}

fun copy_segment_bytes(buf: *u8, segs: *of.LoadSegment, seg_offsets: *usize, seg_count: u32) {
    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_offsets[li])::ptr, segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }
}

fun emit_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
              seg_count: u32, page_size: u64, image_base: u64, entry: u64,
              funcs: *of.ExecFunction,
              func_count: u32, exceptions: *of.Section, exception_count: u32,
              debug: *of.Section, debug_count: u32,
              symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination, name: *u8,
              image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (tgt_isa == nil) { ret R.err[R.Void, str]("elf: nil exec isa"); }
    if (destination == nil)    { ret R.err[R.Void, str]("elf: nil exec path"); }

    var lay: ElfLayout = layout_for(tgt_isa);

    val sb_r: R.Result[SymtabBuild, str] = build_symtab_bytes(alloc, itn, ?lay, symtab, symtab_count, segs, seg_count);
    if (R.is_err[SymtabBuild, str](sb_r)) { ret R.err[R.Void, str](R.unwrap_err[SymtabBuild, str](sb_r)); }
    var sb: SymtabBuild = R.unwrap_ok[SymtabBuild, str](sb_r);

    var attr: *BuildAttributes = attributes_for(tgt_isa);
    if (image_options.attributes == nil || image_options.attributes_len == 0) { attr = nil; }

    val map_headers: bool = image_options.mapped_by_loader;

    var phdr_count: u32 = seg_count;
    if (map_headers) { phdr_count = seg_count + 1; }

    if (map_headers && !header_fits_reserved_page(?lay, phdr_count, page_size)) {
        ret R.err[R.Void, str]("elf: static program headers exceed the one-page header reservation (too many load segments)");
    }

    val phdr_offset: usize = lay.ehdr_size;
    val phdr_table_size: usize = phdr_count::usize * lay.phdr_size;

    var seg_offsets: *usize = nil;
    if (seg_count > 0) {
        val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, seg_count::usize);
        if (R.is_err[*usize, str](ro)) {
            free_symtab_bytes(alloc, ?sb);
            ret R.err[R.Void, str]("elf: exec offset table alloc failed");
        }
        seg_offsets = R.unwrap_ok[*usize, str](ro);
    }

    var total_size: usize = bin.align_up(phdr_offset + phdr_table_size, page_size::usize);
    var li: u32 = 0;
    for (li < seg_count) {
        total_size = bin.align_up(total_size, page_size::usize);
        seg_offsets[li] = total_size;
        total_size = total_size + segs[li].filesz;
        li = li + 1;
    }

    val has_sht: bool = attr != nil || debug_count > 0 || symtab_count > 0;

    var attr_off:        usize = 0;
    var attr_sz:         usize = 0;
    var debug_offs:      *usize = nil;
    var debug_name_rels: *usize = nil;
    var symtab_off:      usize = 0;
    var strtab_off:      usize = 0;
    var shstr_off:       usize = 0;
    var shstr_sz:        usize = 0;
    var attr_name_rel:   usize = 0;
    var symtab_name_rel: usize = 0;
    var strtab_name_rel: usize = 0;
    var shstr_name_rel:  usize = 0;
    var shdr_off:        usize = 0;
    var sht_count:       u32 = 0;
    if (has_sht) {
        if (attr != nil) {
            attr_sz    = build_attributes_size(attr, image_options.attributes_len);
            attr_off   = total_size;
            total_size = total_size + attr_sz;
        }

        if (debug_count > 0) {
            val dro: R.Result[*usize, str] = A.zallocate[usize](alloc, debug_count::usize);
            if (R.is_err[*usize, str](dro)) {
                if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
                free_symtab_bytes(alloc, ?sb);
                ret R.err[R.Void, str]("elf: exec debug offset table alloc failed");
            }
            debug_offs = R.unwrap_ok[*usize, str](dro);
            var di: u32 = 0;
            for (di < debug_count) {
                var da: u32 = debug[di].align;
                if (da == 0) { da = 1; }
                total_size = bin.align_up(total_size, da::usize);
                debug_offs[di] = total_size;
                total_size = total_size + debug[di].len::usize;
                di = di + 1;
            }
        }

        if (sb.symtab_bytes != nil) {
            total_size = bin.align_up(total_size, 8);
            symtab_off = total_size;
            total_size = total_size + sb.symtab_size;
            strtab_off = total_size;
            total_size = total_size + sb.strtab_size;
        }

        shstr_off = total_size;
        shstr_sz  = 1;
        li = 0;
        for (li < seg_count) {
            shstr_sz = shstr_sz + str_len(seg_section_name(segs[li].flags)) + 1;
            li = li + 1;
        }
        if (attr != nil) {
            attr_name_rel = shstr_sz;
            shstr_sz = shstr_sz + str_len(attr.section) + 1;
        }
        if (debug_count > 0) {
            val dnro: R.Result[*usize, str] = A.zallocate[usize](alloc, debug_count::usize);
            if (R.is_err[*usize, str](dnro)) {
                if (debug_offs != nil)  { A.deallocate[usize](alloc, debug_offs, debug_count::usize); }
                if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
                free_symtab_bytes(alloc, ?sb);
                ret R.err[R.Void, str]("elf: exec debug name table alloc failed");
            }
            debug_name_rels = R.unwrap_ok[*usize, str](dnro);
            var di: u32 = 0;
            for (di < debug_count) {
                debug_name_rels[di] = shstr_sz;
                shstr_sz = shstr_sz + str_len(bin.resolve_name(itn, debug[di].name)) + 1;
                di = di + 1;
            }
        }
        if (sb.symtab_bytes != nil) {
            symtab_name_rel = shstr_sz;
            shstr_sz = shstr_sz + str_len(".symtab") + 1;
            strtab_name_rel = shstr_sz;
            shstr_sz = shstr_sz + str_len(".strtab") + 1;
        }
        shstr_name_rel = shstr_sz;
        shstr_sz = shstr_sz + str_len(".shstrtab") + 1;
        total_size = total_size + shstr_sz;

        shdr_off = bin.align_up(total_size, lay.struct_align);
        sht_count = seg_count + 1 + debug_count + 1;
        if (attr != nil) { sht_count = sht_count + 1; }
        if (sb.symtab_bytes != nil) { sht_count = sht_count + 2; }
        total_size = shdr_off + lay.shdr_size * sht_count::usize;
    }

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        if (debug_name_rels != nil) { A.deallocate[usize](alloc, debug_name_rels, debug_count::usize); }
        if (debug_offs != nil)      { A.deallocate[usize](alloc, debug_offs, debug_count::usize); }
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        free_symtab_bytes(alloc, ?sb);
        ret R.err[R.Void, str]("elf: exec buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    write_elf_ident(buf, ?lay);

    var e_shoff: u64 = 0;
    var e_shnum: u16 = 0;
    var e_shstrndx: u16 = 0;
    if (has_sht) {
        e_shoff    = shdr_off::u64;
        e_shnum    = sht_count::u16;
        e_shstrndx = (sht_count - 1)::u16;
    }
    write_ehdr(buf, ?lay, ET_EXEC, tgt_isa.elf_machine::u16, image_options.machine_flags,
               entry, phdr_offset::u64, e_shoff, phdr_count::u16, e_shnum, e_shstrndx);

    var phdr_pos: usize = phdr_offset;

    if (map_headers) {
        var hdr_vaddr: u64 = entry & ~(page_size - 1);
        if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }
        val hdr_filesz: usize = phdr_offset + phdr_table_size;
        phdr_pos = write_phdr_at(buf, phdr_pos, ?lay, PT_LOAD, PF_R, 0, hdr_vaddr, hdr_vaddr,
                                 hdr_filesz::u64, hdr_filesz::u64, page_size);
    }

    li = 0;
    for (li < seg_count) {
        phdr_pos = write_phdr_at(buf, phdr_pos, ?lay, PT_LOAD, pf_flags_for(segs[li].flags),
                                 seg_offsets[li]::u64, segs[li].vaddr, segs[li].vaddr,
                                 segs[li].filesz::u64, segs[li].memsz::u64, page_size);

        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_offsets[li])::ptr, segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }

    if (has_sht) {
        if (attr != nil) {
            write_build_attributes(buf, attr_off, attr,
                                   image_options.attributes, image_options.attributes_len);
        }

        var di: u32 = 0;
        for (di < debug_count) {
            if (debug[di].bytes != nil && debug[di].len > 0) {
                memory.raw_copy((buf::usize + debug_offs[di])::ptr, debug[di].bytes::ptr, debug[di].len::usize);
            }
            di = di + 1;
        }

        if (sb.symtab_bytes != nil) {
            memory.raw_copy((buf::usize + symtab_off)::ptr, sb.symtab_bytes::ptr, sb.symtab_size);
            memory.raw_copy((buf::usize + strtab_off)::ptr, sb.strtab_bytes::ptr, sb.strtab_size);
        }

        buf[shstr_off] = 0;
        var np: usize = 1;
        li = 0;
        for (li < seg_count) {
            np = np + bin.write_str(buf, shstr_off + np, seg_section_name(segs[li].flags));
            li = li + 1;
        }
        if (attr != nil) { np = np + bin.write_str(buf, shstr_off + np, attr.section); }
        di = 0;
        for (di < debug_count) {
            np = np + bin.write_str(buf, shstr_off + np, bin.resolve_name(itn, debug[di].name));
            di = di + 1;
        }
        if (sb.symtab_bytes != nil) {
            np = np + bin.write_str(buf, shstr_off + np, ".symtab");
            np = np + bin.write_str(buf, shstr_off + np, ".strtab");
        }
        bin.write_str(buf, shstr_off + np, ".shstrtab");

        var hp: usize = shdr_off + lay.shdr_size;
        var shidx: u32 = 1;
        var name_cursor: usize = 1;
        li = 0;
        for (li < seg_count) {
            hp = write_shdr(buf, hp, ?lay, name_cursor::u32, SHT_PROGBITS,
                            seg_section_flags(segs[li].flags), segs[li].vaddr,
                            seg_offsets[li]::u64, segs[li].filesz::u64, 0, 0, page_size, 0);
            shidx = shidx + 1;
            name_cursor = name_cursor + str_len(seg_section_name(segs[li].flags)) + 1;
            li = li + 1;
        }

        if (attr != nil) {
            hp = write_shdr(buf, hp, ?lay, attr_name_rel::u32, attr.sht, 0, 0,
                            attr_off::u64, attr_sz::u64, 0, 0, 1, 0);
            shidx = shidx + 1;
        }

        di = 0;
        for (di < debug_count) {
            var da: u32 = debug[di].align;
            if (da == 0) { da = 1; }
            hp = write_shdr(buf, hp, ?lay, debug_name_rels[di]::u32, SHT_PROGBITS, 0, 0,
                            debug_offs[di]::u64, debug[di].len::u64, 0, 0, da::u64, 0);
            shidx = shidx + 1;
            di = di + 1;
        }

        if (sb.symtab_bytes != nil) {
            val strtab_idx: u32 = shidx + 1;
            hp = write_shdr(buf, hp, ?lay, symtab_name_rel::u32, SHT_SYMTAB, 0, 0,
                            symtab_off::u64, sb.symtab_size::u64, strtab_idx, sb.local_count,
                            lay.struct_align::u64, lay.sym_size::u64);
            shidx = shidx + 1;

            hp = write_shdr(buf, hp, ?lay, strtab_name_rel::u32, SHT_STRTAB, 0, 0,
                            strtab_off::u64, sb.strtab_size::u64, 0, 0, 1, 0);
            shidx = shidx + 1;
        }

        write_shdr(buf, hp, ?lay, shstr_name_rel::u32, SHT_STRTAB, 0, 0,
                   shstr_off::u64, shstr_sz::u64, 0, 0, 1, 0);
    }

    if (debug_name_rels != nil) { A.deallocate[usize](alloc, debug_name_rels, debug_count::usize); }
    if (debug_offs != nil)      { A.deallocate[usize](alloc, debug_offs, debug_count::usize); }
    if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
    free_symtab_bytes(alloc, ?sb);

    val res: R.Result[R.Void, str] = publication.bytes_at(itn, alloc, ?destination.claim, destination.path, buf, total_size, 0o755, publication.REPLACE, "elf: cannot publish executable", "elf: could not publish executable file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret res;
}

fun header_fits_reserved_page(lay: *ElfLayout, phdr_count: u32, page_size: u64) bool {
    ret lay.ehdr_size + phdr_count::usize * lay.phdr_size <= page_size::usize;
}

fun header_segment_vaddr(first_seg_vaddr: u64, page_size: u64) u64 {
    ret (first_seg_vaddr & ~(page_size - 1)) - page_size;
}

rec ShtAlloc {
    name:    str;
    sh_type: u32;
    flags:   u64;
    addr:    u64;
    off:     usize;
    size:    usize;
    link:    u32;
    info:    u32;
    entsize: usize;
}

rec DebugSht {
    present:         bool;
    shdr_off:        usize;
    sht_count:       u32;
    shstrndx:        u32;
    debug_offs:      *usize;
    debug_name_rels: *usize;
    aux_name_rels:   *usize;
    symtab_off:      usize;
    strtab_off:      usize;
    symtab_name_rel: usize;
    strtab_name_rel: usize;
    shstr_off:       usize;
    shstr_sz:        usize;
    shstr_name_rel:  usize;
    added:           usize;
}

fun debug_sht_plan(alloc: *A.Allocator, itn: *intern.Interner, lay: *ElfLayout,
                   debug: *of.Section, debug_count: u32,
                   aux: *ShtAlloc, aux_count: u32, sb: *SymtabBuild, base: usize) R.Result[DebugSht, str] {
    var p: DebugSht;
    p.present = false;
    p.shdr_off = 0; p.sht_count = 0; p.shstrndx = 0;
    p.debug_offs = nil; p.debug_name_rels = nil; p.aux_name_rels = nil;
    p.symtab_off = 0; p.strtab_off = 0; p.symtab_name_rel = 0; p.strtab_name_rel = 0;
    p.shstr_off = 0; p.shstr_sz = 0; p.shstr_name_rel = 0; p.added = 0;
    val has_symtab: bool = sb.symtab_bytes != nil;
    if (debug_count == 0 && !has_symtab) { ret R.ok[DebugSht, str](p); }

    val oro: R.Result[*usize, str] = A.zallocate[usize](alloc, debug_count::usize);
    if (R.is_err[*usize, str](oro)) { ret R.err[DebugSht, str](R.unwrap_err[*usize, str](oro)); }
    p.debug_offs = R.unwrap_ok[*usize, str](oro);
    val nro: R.Result[*usize, str] = A.zallocate[usize](alloc, debug_count::usize);
    if (R.is_err[*usize, str](nro)) {
        A.deallocate[usize](alloc, p.debug_offs, debug_count::usize);
        ret R.err[DebugSht, str](R.unwrap_err[*usize, str](nro));
    }
    p.debug_name_rels = R.unwrap_ok[*usize, str](nro);
    if (aux_count > 0) {
        val aro: R.Result[*usize, str] = A.zallocate[usize](alloc, aux_count::usize);
        if (R.is_err[*usize, str](aro)) {
            A.deallocate[usize](alloc, p.debug_offs, debug_count::usize);
            A.deallocate[usize](alloc, p.debug_name_rels, debug_count::usize);
            ret R.err[DebugSht, str](R.unwrap_err[*usize, str](aro));
        }
        p.aux_name_rels = R.unwrap_ok[*usize, str](aro);
    }

    var off: usize = base;
    var di: u32 = 0;
    for (di < debug_count) {
        var da: u32 = debug[di].align;
        if (da == 0) { da = 1; }
        off = bin.align_up(off, da::usize);
        p.debug_offs[di] = off;
        off = off + debug[di].len::usize;
        di = di + 1;
    }

    if (has_symtab) {
        off = bin.align_up(off, 8);
        p.symtab_off = off;
        off = off + sb.symtab_size;
        p.strtab_off = off;
        off = off + sb.strtab_size;
    }

    p.shstr_off = off;
    var sz: usize = 1;
    di = 0;
    for (di < debug_count) {
        p.debug_name_rels[di] = sz;
        sz = sz + str_len(bin.resolve_name(itn, debug[di].name)) + 1;
        di = di + 1;
    }
    var ai: u32 = 0;
    for (ai < aux_count) {
        p.aux_name_rels[ai] = sz;
        sz = sz + str_len(aux[ai].name) + 1;
        ai = ai + 1;
    }
    if (has_symtab) {
        p.symtab_name_rel = sz;
        sz = sz + str_len(".symtab") + 1;
        p.strtab_name_rel = sz;
        sz = sz + str_len(".strtab") + 1;
    }
    p.shstr_name_rel = sz;
    sz = sz + str_len(".shstrtab") + 1;
    p.shstr_sz = sz;
    off = off + sz;

    p.shdr_off = bin.align_up(off, lay.struct_align);
    p.sht_count = 1 + aux_count + debug_count + 1;
    if (has_symtab) { p.sht_count = p.sht_count + 2; }
    p.shstrndx = p.sht_count - 1;
    p.present = true;
    p.added = (p.shdr_off + lay.shdr_size * p.sht_count::usize) - base;
    ret R.ok[DebugSht, str](p);
}

fun debug_sht_write(buf: *u8, itn: *intern.Interner, lay: *ElfLayout,
                    debug: *of.Section, debug_count: u32,
                    aux: *ShtAlloc, aux_count: u32, sb: *SymtabBuild, p: *DebugSht) {
    if (!p.present) { ret; }

    var di: u32 = 0;
    for (di < debug_count) {
        if (debug[di].bytes != nil && debug[di].len > 0) {
            memory.raw_copy((buf::usize + p.debug_offs[di])::ptr, debug[di].bytes::ptr, debug[di].len::usize);
        }
        di = di + 1;
    }

    if (sb.symtab_bytes != nil) {
        memory.raw_copy((buf::usize + p.symtab_off)::ptr, sb.symtab_bytes::ptr, sb.symtab_size);
        memory.raw_copy((buf::usize + p.strtab_off)::ptr, sb.strtab_bytes::ptr, sb.strtab_size);
    }

    buf[p.shstr_off] = 0;
    var np: usize = 1;
    di = 0;
    for (di < debug_count) {
        np = np + bin.write_str(buf, p.shstr_off + np, bin.resolve_name(itn, debug[di].name));
        di = di + 1;
    }
    var ai: u32 = 0;
    for (ai < aux_count) {
        np = np + bin.write_str(buf, p.shstr_off + np, aux[ai].name);
        ai = ai + 1;
    }
    if (sb.symtab_bytes != nil) {
        np = np + bin.write_str(buf, p.shstr_off + np, ".symtab");
        np = np + bin.write_str(buf, p.shstr_off + np, ".strtab");
    }
    bin.write_str(buf, p.shstr_off + np, ".shstrtab");

    var hp: usize = p.shdr_off + lay.shdr_size;
    var shidx: u32 = 1;
    ai = 0;
    for (ai < aux_count) {
        hp = write_shdr(buf, hp, lay, p.aux_name_rels[ai]::u32, aux[ai].sh_type,
                        aux[ai].flags, aux[ai].addr, aux[ai].off::u64, aux[ai].size::u64,
                        aux[ai].link, aux[ai].info, lay.struct_align::u64, aux[ai].entsize::u64);
        shidx = shidx + 1;
        ai = ai + 1;
    }
    di = 0;
    for (di < debug_count) {
        var da: u32 = debug[di].align;
        if (da == 0) { da = 1; }
        hp = write_shdr(buf, hp, lay, p.debug_name_rels[di]::u32, SHT_PROGBITS, 0, 0,
                        p.debug_offs[di]::u64, debug[di].len::u64, 0, 0, da::u64, 0);
        shidx = shidx + 1;
        di = di + 1;
    }

    if (sb.symtab_bytes != nil) {
        val strtab_idx: u32 = shidx + 1;
        hp = write_shdr(buf, hp, lay, p.symtab_name_rel::u32, SHT_SYMTAB, 0, 0,
                        p.symtab_off::u64, sb.symtab_size::u64, strtab_idx, sb.local_count,
                        lay.struct_align::u64, lay.sym_size::u64);
        shidx = shidx + 1;

        hp = write_shdr(buf, hp, lay, p.strtab_name_rel::u32, SHT_STRTAB, 0, 0,
                        p.strtab_off::u64, sb.strtab_size::u64, 0, 0, 1, 0);
        shidx = shidx + 1;
    }

    write_shdr(buf, hp, lay, p.shstr_name_rel::u32, SHT_STRTAB, 0, 0,
               p.shstr_off::u64, p.shstr_sz::u64, 0, 0, 1, 0);
}

fun debug_sht_free(alloc: *A.Allocator, p: *DebugSht, debug_count: u32, aux_count: u32) {
    if (p.debug_offs != nil)      { A.deallocate[usize](alloc, p.debug_offs, debug_count::usize); }
    if (p.debug_name_rels != nil) { A.deallocate[usize](alloc, p.debug_name_rels, debug_count::usize); }
    if (p.aux_name_rels != nil)   { A.deallocate[usize](alloc, p.aux_name_rels, aux_count::usize); }
    p.debug_offs = nil;
    p.debug_name_rels = nil;
    p.aux_name_rels = nil;
}

fun emit_pie_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget,
                  segs: *of.LoadSegment, seg_count: u32, page_size: u64, entry: u64,
                  dyn: *of.DynamicInfo, debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination,
                  image_options: of.ImageOptions) R.Result[R.Void, str] {
    var elay: ElfLayout = layout_for(tgt_isa);
    if (elay.class != ELFCLASS64) {
        ret R.err[R.Void, str]("elf: a position-independent image is ELF64-only (an ELFCLASS32 dynamic image is not implemented)");
    }

    val nrel: u32 = dyn.base_reloc_count;

    val sb_r: R.Result[SymtabBuild, str] = build_symtab_bytes(alloc, itn, ?elay, symtab, symtab_count, segs, seg_count);
    if (R.is_err[SymtabBuild, str](sb_r)) { ret R.err[R.Void, str](R.unwrap_err[SymtabBuild, str](sb_r)); }
    var sb: SymtabBuild = R.unwrap_ok[SymtabBuild, str](sb_r);

    val hi_va: u64 = highest_vaddr(segs, seg_count);
    var li: u32 = 0;

    var relro_extra: u32 = 0;
    if (pie_relro_seg(segs, seg_count, dyn) >= 0) { relro_extra = 1; }
    val phdr_count: u32 = seg_count + 3 + relro_extra;

    if (!header_fits_reserved_page(?elay, phdr_count, page_size)) {
        free_symtab_bytes(alloc, ?sb);
        ret R.err[R.Void, str]("elf: PIE program headers exceed the one-page header reservation (too many load segments)");
    }

    val phdr_offset: usize = ELF_HEADER_SIZE;
    val phdr_table_size: usize = phdr_count::usize * PHDR_SIZE;

    var struct_file: usize = bin.align_up(phdr_offset + phdr_table_size, page_size::usize);
    var seg_offsets: *usize = nil;
    if (seg_count > 0) {
        val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, seg_count::usize);
        if (R.is_err[*usize, str](ro)) {
            free_symtab_bytes(alloc, ?sb);
            ret R.err[R.Void, str]("elf: pie seg-offset alloc failed");
        }
        seg_offsets = R.unwrap_ok[*usize, str](ro);
        li = 0;
        for (li < seg_count) {
            struct_file = bin.align_up(struct_file, page_size::usize);
            seg_offsets[li] = struct_file;
            struct_file = struct_file + segs[li].filesz;
            li = li + 1;
        }
    }

    val ro_off: usize = bin.align_up(struct_file, page_size::usize);
    val ro_va:  u64   = bin.align_up_u64(hi_va, page_size);
    val reladyn_off:  usize = ro_off;
    val reladyn_va:   u64   = ro_va;
    val reladyn_size: usize = nrel::usize * RELA_SIZE;

    val dyn_off: usize = bin.align_up(reladyn_off + reladyn_size, 8);
    val dyn_va:  u64   = bin.align_up_u64(reladyn_va + reladyn_size::u64, 8);
    var dyn_entries: u32 = 1;
    if (nrel > 0) { dyn_entries = dyn_entries + 4; }
    val dyn_size: usize = dyn_entries::usize * DYN_SIZE;

    val struct_total: usize = dyn_off + dyn_size;
    val ro_size: usize = struct_total - ro_off;

    var aux: *ShtAlloc = nil;
    var aux_count: u32 = 0;
    if (sb.symtab_bytes != nil) {
        aux_count = seg_count + 1;
        val axr: R.Result[*ShtAlloc, str] = A.zallocate[ShtAlloc](alloc, aux_count::usize);
        if (R.is_err[*ShtAlloc, str](axr)) {
            free_symtab_bytes(alloc, ?sb);
            if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
            ret R.err[R.Void, str]("elf: pie aux-section table alloc failed");
        }
        aux = R.unwrap_ok[*ShtAlloc, str](axr);
        li = 0;
        for (li < seg_count) {
            aux[li].name = seg_section_name(segs[li].flags);
            aux[li].sh_type = SHT_PROGBITS; aux[li].flags = seg_section_flags(segs[li].flags);
            aux[li].addr = segs[li].vaddr;  aux[li].off = seg_offsets[li]; aux[li].size = segs[li].filesz;
            aux[li].link = 0; aux[li].info = 0; aux[li].entsize = 0;
            li = li + 1;
        }
        aux[seg_count].name = ".dynamic"; aux[seg_count].sh_type = SHT_DYNAMIC; aux[seg_count].flags = SHF_ALLOC;
        aux[seg_count].addr = dyn_va;     aux[seg_count].off = dyn_off;     aux[seg_count].size = dyn_size;
        aux[seg_count].link = 0; aux[seg_count].info = 0; aux[seg_count].entsize = DYN_SIZE;
    }

    var dsht: DebugSht;
    val dp: R.Result[DebugSht, str] = debug_sht_plan(alloc, itn, ?elay, debug, debug_count, aux, aux_count, ?sb, struct_total);
    if (R.is_err[DebugSht, str](dp)) {
        if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
        free_symtab_bytes(alloc, ?sb);
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str](R.unwrap_err[DebugSht, str](dp));
    }
    dsht = R.unwrap_ok[DebugSht, str](dp);
    val total_size: usize = struct_total + dsht.added;

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        debug_sht_free(alloc, ?dsht, debug_count, aux_count);
        if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
        free_symtab_bytes(alloc, ?sb);
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str]("elf: pie buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    write_elf_ident(buf, ?elay);
    var e_shoff: u64 = 0;
    var e_shnum: u16 = 0;
    var e_shstrndx: u16 = 0;
    if (dsht.present) {
        e_shoff    = dsht.shdr_off::u64;
        e_shnum    = dsht.sht_count::u16;
        e_shstrndx = dsht.shstrndx::u16;
    }
    write_ehdr(buf, ?elay, ET_DYN, tgt_isa.elf_machine::u16, image_options.machine_flags,
               entry, phdr_offset::u64, e_shoff, phdr_count::u16, e_shnum, e_shstrndx);

    copy_segment_bytes(buf, segs, seg_offsets, seg_count);

    val rel_type: u32 = relative_type_for(tgt_isa.arch_id);
    var ri: u32 = 0;
    for (ri < nrel) {
        val br: *of.BaseReloc = ?dyn.base_relocs[ri];
        var loc_va: u64 = 0;
        if (br.seg_index < seg_count) { loc_va = segs[br.seg_index].vaddr + br.seg_offset::u64; }
        val rela_off: usize = reladyn_off + ri::usize * RELA_SIZE;
        bin.write_u64_le(buf, rela_off, loc_va);
        bin.write_u64_le(buf, rela_off + 8, rel_type::u64);
        bin.write_u64_le(buf, rela_off + 16, br.target);
        ri = ri + 1;
    }

    var dpos: usize = dyn_off;
    if (nrel > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_RELA,      reladyn_va);
        dpos = write_dyn_entry(buf, dpos, DT_RELASZ,    reladyn_size::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELAENT,   RELA_SIZE::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELACOUNT, nrel::u64);
    }
    dpos = write_dyn_entry(buf, dpos, DT_NULL, 0);

    write_pie_phdrs(buf, phdr_offset, phdr_count, segs, seg_offsets, seg_count,
                    ro_off, ro_va, ro_size, dyn_off, dyn_va, dyn_size, dyn, page_size, false);

    debug_sht_write(buf, itn, ?elay, debug, debug_count, aux, aux_count, ?sb, ?dsht);
    debug_sht_free(alloc, ?dsht, debug_count, aux_count);
    if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
    free_symtab_bytes(alloc, ?sb);

    if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }

    val res: R.Result[R.Void, str] = publication.bytes_at(itn, alloc, ?destination.claim, destination.path, buf, total_size, 0o755, publication.REPLACE, "elf: cannot publish PIE executable", "elf: could not publish PIE executable file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret res;
}

fun write_pie_phdrs(buf: *u8, phdr_offset: usize, phdr_count: u32,
                    segs: *of.LoadSegment, seg_offsets: *usize, seg_count: u32,
                    ro_off: usize, ro_va: u64, ro_size: usize,
                    dyn_off: usize, dyn_va: u64, dyn_size: usize, dyn: *of.DynamicInfo, page_size: u64,
                    emit_gnu_stack: bool) {
    var pos: usize = phdr_offset;
    val phdr_bytes: usize = phdr_count::usize * PHDR_SIZE;

    var hdr_vaddr: u64 = 0;
    if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }

    pos = write_phdr(buf, pos, PT_PHDR, PF_R, phdr_offset, hdr_vaddr + phdr_offset::u64,
                     phdr_bytes, phdr_bytes, 8);

    var li: u32 = 0;
    for (li < seg_count) {
        if (li == 0) {
            val first_filesz: usize = seg_offsets[0] + segs[0].filesz;
            val first_memsz:  usize = seg_offsets[0] + segs[0].memsz;
            pos = write_phdr(buf, pos, PT_LOAD, pie_seg_flags(segs, li, seg_count, dyn), 0,
                             hdr_vaddr, first_filesz, first_memsz, page_size);
        }
        or {
            pos = write_phdr(buf, pos, PT_LOAD, pie_seg_flags(segs, li, seg_count, dyn), seg_offsets[li],
                             segs[li].vaddr, segs[li].filesz, segs[li].memsz, page_size);
        }
        li = li + 1;
    }

    pos = write_phdr(buf, pos, PT_LOAD, PF_R, ro_off, ro_va, ro_size, ro_size, page_size);
    pos = write_phdr(buf, pos, PT_DYNAMIC, PF_R, dyn_off, dyn_va, dyn_size, dyn_size, 8);

    val relro_seg: i64 = pie_relro_seg(segs, seg_count, dyn);
    if (relro_seg >= 0) {
        val ri: u32 = relro_seg::u32;
        val relro_size: usize = segs[ri].memsz;
        pos = write_phdr(buf, pos, PT_GNU_RELRO, PF_R, seg_offsets[ri], segs[ri].vaddr,
                         relro_size, relro_size, 1);
    }

    if (emit_gnu_stack) {
        pos = write_phdr(buf, pos, PT_GNU_STACK, PF_R | PF_W, 0, 0, 0, 0, 0x10);
    }
}

fun seg_has_base_reloc(dyn: *of.DynamicInfo, li: u32, seg_count: u32) bool {
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == li && dyn.base_relocs[i].seg_index < seg_count) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun pie_relro_seg(segs: *of.LoadSegment, seg_count: u32, dyn: *of.DynamicInfo) i64 {
    var li: u32 = 0;
    for (li < seg_count) {
        val f: u32 = pf_flags_for(segs[li].flags);
        if ((f & PF_W) == 0 && (f & PF_X) == 0 && seg_has_base_reloc(dyn, li, seg_count)) {
            ret li::i64;
        }
        li = li + 1;
    }
    ret -1;
}

fun pie_seg_flags(segs: *of.LoadSegment, li: u32, seg_count: u32, dyn: *of.DynamicInfo) u32 {
    val f: u32 = pf_flags_for(segs[li].flags);
    if (seg_has_base_reloc(dyn, li, seg_count)) { ret f | PF_W; }
    ret f;
}

fun so_basename(path: *u8) str {
    val n: usize = str_len(path::str);
    var last: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (path[i] == '/') { last = i + 1; }
        i = i + 1;
    }
    ret ((path::usize + last)::*u8)::str;
}

fun emit_shared(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget,
                segs: *of.LoadSegment, seg_count: u32, page_size: u64,
                exports: *of.ExportSym, export_count: u32, dyn: *of.DynamicInfo,
                debug: *of.Section, debug_count: u32,
                symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination,
                image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (tgt_isa == nil) { ret R.err[R.Void, str]("elf: nil shared isa"); }
    if (destination == nil)    { ret R.err[R.Void, str]("elf: nil shared path"); }
    if (itn == nil)     { ret R.err[R.Void, str]("elf: no interner for shared object"); }

    var elay: ElfLayout = layout_for(tgt_isa);
    if (elay.class != ELFCLASS64) {
        ret R.err[R.Void, str]("elf: a shared object is ELF64-only (an ELFCLASS32 dynamic image is not implemented)");
    }

    val sb_r: R.Result[SymtabBuild, str] = build_symtab_bytes(alloc, itn, ?elay, symtab, symtab_count, segs, seg_count);
    if (R.is_err[SymtabBuild, str](sb_r)) { ret R.err[R.Void, str](R.unwrap_err[SymtabBuild, str](sb_r)); }
    var sb: SymtabBuild = R.unwrap_ok[SymtabBuild, str](sb_r);

    if (dyn.import_addr_fixup_count > 0) {
        free_symtab_bytes(alloc, ?sb);
        ret R.err[R.Void, str]("elf: data imports in a shared object are not yet supported (#2026 is exec-only)");
    }

    val nrel: u32 = dyn.base_reloc_count;
    val nexp: u32 = export_count;

    val hi_va: u64 = highest_vaddr(segs, seg_count);
    var li: u32 = 0;

    var relro_extra: u32 = 0;
    if (pie_relro_seg(segs, seg_count, dyn) >= 0) { relro_extra = 1; }
    val phdr_count: u32 = seg_count + 4 + relro_extra;

    if (!header_fits_reserved_page(?elay, phdr_count, page_size)) {
        free_symtab_bytes(alloc, ?sb);
        ret R.err[R.Void, str]("elf: shared-object program headers exceed the one-page header reservation (too many load segments)");
    }

    val phdr_offset: usize = ELF_HEADER_SIZE;
    val phdr_table_size: usize = phdr_count::usize * PHDR_SIZE;

    var struct_file: usize = bin.align_up(phdr_offset + phdr_table_size, page_size::usize);
    var seg_offsets: *usize = nil;
    if (seg_count > 0) {
        val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, seg_count::usize);
        if (R.is_err[*usize, str](ro)) {
            free_symtab_bytes(alloc, ?sb);
            ret R.err[R.Void, str]("elf: shared seg-offset alloc failed");
        }
        seg_offsets = R.unwrap_ok[*usize, str](ro);
        li = 0;
        for (li < seg_count) {
            struct_file = bin.align_up(struct_file, page_size::usize);
            seg_offsets[li] = struct_file;
            struct_file = struct_file + segs[li].filesz;
            li = li + 1;
        }
    }

    var exp_str: *usize = nil;
    if (nexp > 0) {
        val es: R.Result[*usize, str] = A.zallocate[usize](alloc, nexp::usize);
        if (R.is_err[*usize, str](es)) {
            free_symtab_bytes(alloc, ?sb);
            if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
            ret R.err[R.Void, str]("elf: shared export-name table alloc failed");
        }
        exp_str = R.unwrap_ok[*usize, str](es);
    }

    val ro_off: usize = bin.align_up(struct_file, page_size::usize);
    val ro_va:  u64   = bin.align_up_u64(hi_va, page_size);

    val dynsym_off: usize = ro_off;
    val dynsym_va:  u64   = ro_va;
    val dynsym_size: usize = (nexp + 1)::usize * SYM_SIZE;

    val dynstr_off: usize = dynsym_off + dynsym_size;
    val dynstr_va:  u64   = dynsym_va + dynsym_size::u64;
    val soname: str = so_basename(destination.path::*u8);
    var dynstr_size: usize = 1 + (str_len(soname) + 1);
    var e: u32 = 0;
    for (e < nexp) { dynstr_size = dynstr_size + dynstr_name_len(itn, exports[e].name); e = e + 1; }

    val hash_off: usize = bin.align_up(dynstr_off + dynstr_size, 8);
    val hash_va:  u64   = bin.align_up_u64(dynstr_va + dynstr_size::u64, 8);
    val nchain: usize = (nexp + 1)::usize;
    val hash_size: usize = 8 + 4 + nchain * 4;

    val reladyn_off: usize = bin.align_up(hash_off + hash_size, 8);
    val reladyn_va:  u64   = bin.align_up_u64(hash_va + hash_size::u64, 8);
    val reladyn_size: usize = nrel::usize * RELA_SIZE;

    val dyn_off: usize = bin.align_up(reladyn_off + reladyn_size, 8);
    val dyn_va:  u64   = bin.align_up_u64(reladyn_va + reladyn_size::u64, 8);
    var dyn_entries: u32 = 7;
    if (nrel > 0) { dyn_entries = dyn_entries + 4; }
    val dyn_size: usize = dyn_entries::usize * DYN_SIZE;

    val struct_total: usize = dyn_off + dyn_size;
    val ro_size: usize = struct_total - ro_off;

    val aux_count: u32 = seg_count + 4;
    var aux: *ShtAlloc = nil;
    val axr: R.Result[*ShtAlloc, str] = A.zallocate[ShtAlloc](alloc, aux_count::usize);
    if (R.is_err[*ShtAlloc, str](axr)) {
        free_symtab_bytes(alloc, ?sb);
        if (exp_str != nil)     { A.deallocate[usize](alloc, exp_str, nexp::usize); }
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str]("elf: shared aux-section table alloc failed");
    }
    aux = R.unwrap_ok[*ShtAlloc, str](axr);
    li = 0;
    for (li < seg_count) {
        aux[li].name = seg_section_name(segs[li].flags);
        aux[li].sh_type = SHT_PROGBITS; aux[li].flags = seg_section_flags(segs[li].flags);
        aux[li].addr = segs[li].vaddr;  aux[li].off = seg_offsets[li]; aux[li].size = segs[li].filesz;
        aux[li].link = 0; aux[li].info = 0; aux[li].entsize = 0;
        li = li + 1;
    }
    val i_dynsym: u32 = seg_count + 1;
    val i_dynstr: u32 = seg_count + 2;
    aux[seg_count].name = ".dynsym";      aux[seg_count].sh_type = SHT_DYNSYM;      aux[seg_count].flags = SHF_ALLOC;
    aux[seg_count].addr = dynsym_va;      aux[seg_count].off = dynsym_off;      aux[seg_count].size = dynsym_size;  aux[seg_count].link = i_dynstr; aux[seg_count].info = 1; aux[seg_count].entsize = SYM_SIZE;
    aux[seg_count + 1].name = ".dynstr";  aux[seg_count + 1].sh_type = SHT_STRTAB;  aux[seg_count + 1].flags = SHF_ALLOC;
    aux[seg_count + 1].addr = dynstr_va;  aux[seg_count + 1].off = dynstr_off;  aux[seg_count + 1].size = dynstr_size;  aux[seg_count + 1].link = 0; aux[seg_count + 1].info = 0; aux[seg_count + 1].entsize = 0;
    aux[seg_count + 2].name = ".hash";    aux[seg_count + 2].sh_type = SHT_HASH;    aux[seg_count + 2].flags = SHF_ALLOC;
    aux[seg_count + 2].addr = hash_va;    aux[seg_count + 2].off = hash_off;    aux[seg_count + 2].size = hash_size;    aux[seg_count + 2].link = i_dynsym; aux[seg_count + 2].info = 0; aux[seg_count + 2].entsize = 4;
    aux[seg_count + 3].name = ".dynamic"; aux[seg_count + 3].sh_type = SHT_DYNAMIC; aux[seg_count + 3].flags = SHF_ALLOC;
    aux[seg_count + 3].addr = dyn_va;     aux[seg_count + 3].off = dyn_off;     aux[seg_count + 3].size = dyn_size;     aux[seg_count + 3].link = i_dynstr; aux[seg_count + 3].info = 0; aux[seg_count + 3].entsize = DYN_SIZE;

    var dsht: DebugSht;
    val dp: R.Result[DebugSht, str] = debug_sht_plan(alloc, itn, ?elay, debug, debug_count, aux, aux_count, ?sb, struct_total);
    if (R.is_err[DebugSht, str](dp)) {
        free_symtab_bytes(alloc, ?sb);
        A.deallocate[ShtAlloc](alloc, aux, aux_count::usize);
        if (exp_str != nil)     { A.deallocate[usize](alloc, exp_str, nexp::usize); }
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str](R.unwrap_err[DebugSht, str](dp));
    }
    dsht = R.unwrap_ok[DebugSht, str](dp);
    val total_size: usize = struct_total + dsht.added;

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        debug_sht_free(alloc, ?dsht, debug_count, aux_count);
        free_symtab_bytes(alloc, ?sb);
        A.deallocate[ShtAlloc](alloc, aux, aux_count::usize);
        if (exp_str != nil)     { A.deallocate[usize](alloc, exp_str, nexp::usize); }
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str]("elf: shared buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    write_elf_ident(buf, ?elay);
    var e_shoff: u64 = 0;
    var e_shnum: u16 = 0;
    var e_shstrndx: u16 = 0;
    if (dsht.present) {
        e_shoff    = dsht.shdr_off::u64;
        e_shnum    = dsht.sht_count::u16;
        e_shstrndx = dsht.shstrndx::u16;
    }
    write_ehdr(buf, ?elay, ET_DYN, tgt_isa.elf_machine::u16, image_options.machine_flags,
               0, phdr_offset::u64, e_shoff, phdr_count::u16, e_shnum, e_shstrndx);

    copy_segment_bytes(buf, segs, seg_offsets, seg_count);

    buf[dynstr_off] = 0;
    var str_pos: usize = 1;
    val soname_off: usize = str_pos;
    str_pos = str_pos + bin.write_str(buf, dynstr_off + str_pos, soname);
    e = 0;
    for (e < nexp) {
        exp_str[e] = str_pos;
        str_pos = str_pos + bin.write_str(buf, dynstr_off + str_pos, bin.resolve_name(itn, exports[e].name));
        e = e + 1;
    }

    var sym_off: usize = dynsym_off + SYM_SIZE;
    e = 0;
    for (e < nexp) {
        var st_type: u8 = STT_OBJECT;
        if (exports[e].is_func) { st_type = STT_FUNC; }
        var shndx: u16 = 1;
        var sgi: u32 = 0;
        for (sgi < seg_count) {
            val sv: u64 = segs[sgi].vaddr;
            if (exports[e].vaddr >= sv && exports[e].vaddr < sv + segs[sgi].memsz::u64) { shndx = (sgi + 1)::u16; }
            sgi = sgi + 1;
        }
        bin.write_u32_le(buf, sym_off, exp_str[e]::u32);
        buf[sym_off + 4] = (STB_GLOBAL << 4) | (st_type & 0xF);
        buf[sym_off + 5] = 0;
        bin.write_u16_le(buf, sym_off + 6, shndx);
        bin.write_u64_le(buf, sym_off + 8, exports[e].vaddr);
        bin.write_u64_le(buf, sym_off + 16, 0);
        sym_off = sym_off + SYM_SIZE;
        e = e + 1;
    }

    bin.write_u32_le(buf, hash_off, 1);
    bin.write_u32_le(buf, hash_off + 4, nchain::u32);
    if (nexp > 0) { bin.write_u32_le(buf, hash_off + 8, 1); } or { bin.write_u32_le(buf, hash_off + 8, 0); }
    var c: u32 = 0;
    for (c < nchain::u32) {
        var next: u32 = c + 1;
        if (next >= nchain::u32) { next = 0; }
        bin.write_u32_le(buf, hash_off + 12 + c::usize * 4, next);
        c = c + 1;
    }

    val rel_type: u32 = relative_type_for(tgt_isa.arch_id);
    var ri: u32 = 0;
    for (ri < nrel) {
        val br: *of.BaseReloc = ?dyn.base_relocs[ri];
        var loc_va: u64 = 0;
        if (br.seg_index < seg_count) { loc_va = segs[br.seg_index].vaddr + br.seg_offset::u64; }
        val rela_off: usize = reladyn_off + ri::usize * RELA_SIZE;
        bin.write_u64_le(buf, rela_off, loc_va);
        bin.write_u64_le(buf, rela_off + 8, rel_type::u64);
        bin.write_u64_le(buf, rela_off + 16, br.target);
        ri = ri + 1;
    }

    var dpos: usize = dyn_off;
    dpos = write_dyn_entry(buf, dpos, DT_SONAME, soname_off::u64);
    dpos = write_dyn_entry(buf, dpos, DT_HASH,   hash_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRTAB, dynstr_va);
    dpos = write_dyn_entry(buf, dpos, DT_SYMTAB, dynsym_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRSZ,  dynstr_size::u64);
    dpos = write_dyn_entry(buf, dpos, DT_SYMENT, SYM_SIZE::u64);
    if (nrel > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_RELA,      reladyn_va);
        dpos = write_dyn_entry(buf, dpos, DT_RELASZ,    reladyn_size::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELAENT,   RELA_SIZE::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELACOUNT, nrel::u64);
    }
    dpos = write_dyn_entry(buf, dpos, DT_NULL, 0);

    write_pie_phdrs(buf, phdr_offset, phdr_count, segs, seg_offsets, seg_count,
                    ro_off, ro_va, ro_size, dyn_off, dyn_va, dyn_size, dyn, page_size, true);

    debug_sht_write(buf, itn, ?elay, debug, debug_count, aux, aux_count, ?sb, ?dsht);
    debug_sht_free(alloc, ?dsht, debug_count, aux_count);
    free_symtab_bytes(alloc, ?sb);

    A.deallocate[ShtAlloc](alloc, aux, aux_count::usize);
    if (exp_str != nil)     { A.deallocate[usize](alloc, exp_str, nexp::usize); }
    if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }

    val res: R.Result[R.Void, str] = publication.bytes_at(itn, alloc, ?destination.claim, destination.path, buf, total_size, 0o755, publication.REPLACE, "elf: cannot publish shared object", "elf: could not publish shared-object file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret res;
}

fun jump_slot_for(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret R_AARCH64_JUMP_SLOT; }
    if (arch_id == isa.ARCH_RISCV64) { ret R_RISCV_JUMP_SLOT; }
    ret R_X86_64_JUMP_SLOT;
}

fun glob_dat_for(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret R_AARCH64_GLOB_DAT; }
    if (arch_id == isa.ARCH_RISCV64) { ret R_RISCV_64; }
    ret R_X86_64_GLOB_DAT;
}

fun relative_type_for(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret R_AARCH64_RELATIVE; }
    if (arch_id == isa.ARCH_RISCV64) { ret R_RISCV_RELATIVE; }
    ret R_X86_64_RELATIVE;
}

fun dyn_arch_supported(arch_id: u32) bool {
    ret arch_id == isa.ARCH_X86_64 || arch_id == isa.ARCH_AARCH64 || arch_id == isa.ARCH_RISCV64;
}

fun dyn_bind_now(arch_id: u32) bool {
    ret arch_id != isa.ARCH_X86_64;
}

fun plt_header_size(arch_id: u32) usize {
    if (arch_id == isa.ARCH_X86_64) { ret PLT_ENTRY_SIZE; }
    ret 0;
}

fun plt_stub_va(lay: *DynLayout, n: u32, arch_id: u32) u64 {
    ret lay.plt_va + plt_header_size(arch_id)::u64 + n::u64 * PLT_ENTRY_SIZE::u64;
}

rec DynLayout {
    ro_off: usize;       ro_va: u64;        ro_size: usize;
    interp_off: usize;   interp_va: u64;    interp_size: usize;
    dynsym_off: usize;   dynsym_va: u64;
    dynstr_off: usize;   dynstr_va: u64;    dynstr_size: usize;
    hash_off: usize;     hash_va: u64;      hash_size: usize;
    relaplt_off: usize;  relaplt_va: u64;   relaplt_size: usize;
    reladyn_off: usize;  reladyn_va: u64;   reladyn_size: usize;
    plt_off: usize;      plt_va: u64;       plt_size: usize;
    rw_off: usize;       rw_va: u64;        rw_size: usize;
    gotplt_off: usize;   gotplt_va: u64;    gotplt_size: usize;
    datagot_off: usize;  datagot_va: u64;   datagot_size: usize;
    dynamic_off: usize;  dynamic_va: u64;   dynamic_size: usize;
}

fun func_import_count(dyn: *of.DynamicInfo) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

rec ImportAddressPlan {
    ordinals: *u32;
    import_count: u32;
    count: u32;
}

fun import_address_plan(alloc: *A.Allocator, dyn: *of.DynamicInfo) R.Result[ImportAddressPlan, str] {
    var plan: ImportAddressPlan;
    plan.import_count = dyn.import_count;
    if (dyn.import_addr_fixup_count == 0) { ret R.ok[ImportAddressPlan, str](plan); }
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        if (dyn.import_addr_fixups[i].import_index >= dyn.import_count) {
            ret R.err[ImportAddressPlan, str]("elf: import-address fixup index is out of range");
        }
        i = i + 1;
    }
    val made: R.Result[*u32, str] = A.allocate[u32](alloc, dyn.import_count::usize);
    if (R.is_err[*u32, str](made)) { ret R.err[ImportAddressPlan, str](R.unwrap_err[*u32, str](made)); }
    plan.ordinals = R.unwrap_ok[*u32, str](made);
    i = 0;
    for (i < dyn.import_count) { plan.ordinals[i] = 0xFFFFFFFF; i = i + 1; }
    i = 0;
    for (i < dyn.import_addr_fixup_count) {
        plan.ordinals[dyn.import_addr_fixups[i].import_index] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (plan.ordinals[i] != 0xFFFFFFFF) {
            plan.ordinals[i] = plan.count;
            plan.count = plan.count + 1;
        }
        i = i + 1;
    }
    ret R.ok[ImportAddressPlan, str](plan);
}

fun import_address_plan_dnit(alloc: *A.Allocator, plan: *ImportAddressPlan) {
    if (plan.ordinals != nil) { A.deallocate[u32](alloc, plan.ordinals, plan.import_count::usize); }
    plan.ordinals = nil; plan.import_count = 0; plan.count = 0;
}

fun got_import_ordinal(plan: *ImportAddressPlan, raw: u32) u32 {
    if (raw >= plan.import_count || plan.ordinals == nil) { ret 0xFFFFFFFF; }
    ret plan.ordinals[raw];
}

fun import_symbol_index(dyn: *of.DynamicInfo, raw: u32) u32 {
    var n: u32 = 1;
    if (!dyn.imports[raw].is_func) { n = n + func_import_count(dyn); }
    var i: u32 = 0;
    for (i < raw) {
        if (dyn.imports[i].is_func == dyn.imports[raw].is_func) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun dynstr_name_len(itn: *intern.Interner, id: intern.StrId) usize {
    val s: str = bin.resolve_name(itn, id);
    if (s == nil) { ret 1; }
    ret str_len(s) + 1;
}

fun emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
                  seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                  funcs: *of.ExecFunction,
                  func_count: u32, dyn: *of.DynamicInfo, fixups: *of.PltFixup,
                  fixup_count: u32, exceptions: *of.Section, exception_count: u32,
                  debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination, name: *u8,
                  image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (tgt_isa == nil) { ret R.err[R.Void, str]("elf: nil dyn-exec isa"); }
    if (destination == nil)    { ret R.err[R.Void, str]("elf: nil dyn-exec path"); }
    if (dyn == nil)     { ret R.err[R.Void, str]("elf: nil dynamic plan"); }
    if (itn == nil)     { ret R.err[R.Void, str]("elf: no interner for dyn-exec"); }

    var elay: ElfLayout = layout_for(tgt_isa);
    if (elay.class != ELFCLASS64) {
        ret R.err[R.Void, str]("elf: a dynamically linked executable is ELF64-only (an ELFCLASS32 dynamic image is not implemented)");
    }

    if (!dyn_arch_supported(tgt_isa.arch_id)) {
        ret R.err[R.Void, str]("elf: dynamic linking is not implemented for this architecture");
    }

    if (dyn.pie) {
        if (dyn.import_count > 0 || dyn.lib_count > 0) {
            ret R.err[R.Void, str]("elf: PIE with dynamic imports is not supported (static-PIE only)");
        }
        ret emit_pie_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, entry, dyn, debug, debug_count,
                          symtab, symtab_count, destination, image_options);
    }

    val nimp: u32 = func_import_count(dyn);
    val planned: R.Result[ImportAddressPlan, str] = import_address_plan(alloc, dyn);
    if (R.is_err[ImportAddressPlan, str](planned)) { ret R.err[R.Void, str](R.unwrap_err[ImportAddressPlan, str](planned)); }
    var got: ImportAddressPlan = R.unwrap_ok[ImportAddressPlan, str](planned);
    fin { import_address_plan_dnit(alloc, ?got); }

    val sb_r: R.Result[SymtabBuild, str] = build_symtab_bytes(alloc, itn, ?elay, symtab, symtab_count, segs, seg_count);
    if (R.is_err[SymtabBuild, str](sb_r)) { ret R.err[R.Void, str](R.unwrap_err[SymtabBuild, str](sb_r)); }
    var sb: SymtabBuild = R.unwrap_ok[SymtabBuild, str](sb_r);

    val hi_va: u64 = highest_vaddr(segs, seg_count);
    var li: u32 = 0;

    val phdr_count: u32 = seg_count + 6;

    if (!header_fits_reserved_page(?elay, phdr_count, page_size)) {
        free_symtab_bytes(alloc, ?sb);
        ret R.err[R.Void, str]("elf: dynamic-exec program headers exceed the one-page header reservation (too many load segments)");
    }

    val phdr_offset: usize = ELF_HEADER_SIZE;
    val phdr_table_size: usize = phdr_count::usize * PHDR_SIZE;

    var struct_file: usize = bin.align_up(phdr_offset + phdr_table_size, page_size::usize);
    var seg_offsets: *usize = nil;
    if (seg_count > 0) {
        val ro: R.Result[*usize, str] = A.zallocate[usize](alloc, seg_count::usize);
        if (R.is_err[*usize, str](ro)) {
            free_symtab_bytes(alloc, ?sb);
            ret R.err[R.Void, str]("elf: dyn-exec seg-offset alloc failed");
        }
        seg_offsets = R.unwrap_ok[*usize, str](ro);
        li = 0;
        for (li < seg_count) {
            struct_file = bin.align_up(struct_file, page_size::usize);
            seg_offsets[li] = struct_file;
            struct_file = struct_file + segs[li].filesz;
            li = li + 1;
        }
    }

    var lay: DynLayout;
    compute_dyn_layout(itn, ?lay, dyn, ?got, nimp, tgt_isa.arch_id, bin.align_up(struct_file, page_size::usize),
                       bin.align_up_u64(hi_va, page_size), page_size);

    val struct_total: usize = lay.rw_off + lay.rw_size;

    var aux: *ShtAlloc = nil;
    var aux_count: u32 = 0;
    if (sb.symtab_bytes != nil) {
        aux_count = seg_count + 1;
        val axr: R.Result[*ShtAlloc, str] = A.zallocate[ShtAlloc](alloc, aux_count::usize);
        if (R.is_err[*ShtAlloc, str](axr)) {
            free_symtab_bytes(alloc, ?sb);
            if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
            ret R.err[R.Void, str]("elf: dyn-exec aux-section table alloc failed");
        }
        aux = R.unwrap_ok[*ShtAlloc, str](axr);
        li = 0;
        for (li < seg_count) {
            aux[li].name = seg_section_name(segs[li].flags);
            aux[li].sh_type = SHT_PROGBITS; aux[li].flags = seg_section_flags(segs[li].flags);
            aux[li].addr = segs[li].vaddr;  aux[li].off = seg_offsets[li]; aux[li].size = segs[li].filesz;
            aux[li].link = 0; aux[li].info = 0; aux[li].entsize = 0;
            li = li + 1;
        }
        aux[seg_count].name = ".dynamic"; aux[seg_count].sh_type = SHT_DYNAMIC; aux[seg_count].flags = SHF_ALLOC;
        aux[seg_count].addr = lay.dynamic_va; aux[seg_count].off = lay.dynamic_off; aux[seg_count].size = lay.dynamic_size;
        aux[seg_count].link = 0; aux[seg_count].info = 0; aux[seg_count].entsize = DYN_SIZE;
    }

    var dsht: DebugSht;
    val dp: R.Result[DebugSht, str] = debug_sht_plan(alloc, itn, ?elay, debug, debug_count, aux, aux_count, ?sb, struct_total);
    if (R.is_err[DebugSht, str](dp)) {
        if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
        free_symtab_bytes(alloc, ?sb);
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str](R.unwrap_err[DebugSht, str](dp));
    }
    dsht = R.unwrap_ok[DebugSht, str](dp);
    val total_size: usize = struct_total + dsht.added;

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        debug_sht_free(alloc, ?dsht, debug_count, aux_count);
        if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
        free_symtab_bytes(alloc, ?sb);
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        ret R.err[R.Void, str]("elf: dyn-exec buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    write_elf_ident(buf, ?elay);
    var e_shoff: u64 = 0;
    var e_shnum: u16 = 0;
    var e_shstrndx: u16 = 0;
    if (dsht.present) {
        e_shoff    = dsht.shdr_off::u64;
        e_shnum    = dsht.sht_count::u16;
        e_shstrndx = dsht.shstrndx::u16;
    }
    write_ehdr(buf, ?elay, ET_EXEC, tgt_isa.elf_machine::u16, image_options.machine_flags,
               entry, phdr_offset::u64, e_shoff, phdr_count::u16, e_shnum, e_shstrndx);

    copy_segment_bytes(buf, segs, seg_offsets, seg_count);

    var imp_str: *usize = nil;
    if (dyn.import_count > 0) {
        val ri: R.Result[*usize, str] = A.zallocate[usize](alloc, dyn.import_count::usize);
        if (R.is_err[*usize, str](ri)) {
            debug_sht_free(alloc, ?dsht, debug_count, aux_count);
            if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
            free_symtab_bytes(alloc, ?sb);
            if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
            A.deallocate[u8](alloc, buf, total_size);
            ret R.err[R.Void, str]("elf: dyn-exec import-name table alloc failed");
        }
        imp_str = R.unwrap_ok[*usize, str](ri);
    }
    var lib_str: *usize = nil;
    if (dyn.lib_count > 0) {
        val rl: R.Result[*usize, str] = A.zallocate[usize](alloc, dyn.lib_count::usize);
        if (R.is_err[*usize, str](rl)) {
            debug_sht_free(alloc, ?dsht, debug_count, aux_count);
            if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
            free_symtab_bytes(alloc, ?sb);
            if (imp_str != nil)     { A.deallocate[usize](alloc, imp_str, dyn.import_count::usize); }
            if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
            A.deallocate[u8](alloc, buf, total_size);
            ret R.err[R.Void, str]("elf: dyn-exec lib-name table alloc failed");
        }
        lib_str = R.unwrap_ok[*usize, str](rl);
    }

    write_dyn_structures(itn, buf, ?lay, dyn, ?got, nimp, tgt_isa.arch_id, imp_str, lib_str);
    var fx_r: R.Result[R.Void, str] =
        patch_plt_fixups(buf, ?lay, dyn, fixups, fixup_count, seg_offsets, segs, seg_count, nimp, tgt_isa.arch_id);
    if (R.is_ok[R.Void, str](fx_r)) {
        fx_r = patch_import_addr_fixups(buf, ?lay, dyn, ?got, seg_offsets, segs, seg_count,
                                        tgt_isa.arch_id);
    }

    if (imp_str != nil) { A.deallocate[usize](alloc, imp_str, dyn.import_count::usize); }
    if (lib_str != nil) { A.deallocate[usize](alloc, lib_str, dyn.lib_count::usize); }

    if (R.is_err[R.Void, str](fx_r)) {
        debug_sht_free(alloc, ?dsht, debug_count, aux_count);
        if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
        free_symtab_bytes(alloc, ?sb);
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
        A.deallocate[u8](alloc, buf, total_size);
        ret fx_r;
    }

    write_dyn_phdrs(buf, phdr_offset, ?lay, segs, seg_offsets, seg_count, page_size);

    debug_sht_write(buf, itn, ?elay, debug, debug_count, aux, aux_count, ?sb, ?dsht);
    debug_sht_free(alloc, ?dsht, debug_count, aux_count);
    if (aux != nil) { A.deallocate[ShtAlloc](alloc, aux, aux_count::usize); }
    free_symtab_bytes(alloc, ?sb);

    if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }

    val res: R.Result[R.Void, str] = publication.bytes_at(itn, alloc, ?destination.claim, destination.path, buf, total_size, 0o755, publication.REPLACE, "elf: cannot publish dynamic executable", "elf: could not publish dynamic executable file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret res;
}

fun compute_dyn_layout(itn: *intern.Interner, lay: *DynLayout, dyn: *of.DynamicInfo, got: *ImportAddressPlan, nimp: u32,
                       arch_id: u32, struct_file: usize, struct_va: u64, page_size: u64) {
    val page_sz: usize = page_size::usize;

    val ndata: u32 = got.count;

    lay.ro_off = struct_file;
    lay.ro_va  = struct_va;

    var off: usize = struct_file;
    var va:  u64   = struct_va;

    lay.interp_off  = off;
    lay.interp_va   = va;
    lay.interp_size = dynstr_name_len(itn, dyn.interp);
    off = off + lay.interp_size;
    va  = va  + lay.interp_size::u64;

    off = bin.align_up(off, 8);
    va  = bin.align_up_u64(va, 8);
    lay.dynsym_off = off;
    lay.dynsym_va  = va;
    val dynsym_size: usize = (dyn.import_count + 1)::usize * SYM_SIZE;
    off = off + dynsym_size;
    va  = va  + dynsym_size::u64;

    lay.dynstr_off = off;
    lay.dynstr_va  = va;
    var dynstr_size: usize = 1;
    dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.interp);
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) { dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.imports[i].symbol); }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].is_func) { dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.imports[i].symbol); }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.lib_count) { dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.libs[i].soname); i = i + 1; }
    lay.dynstr_size = dynstr_size;
    off = off + dynstr_size;
    va  = va  + dynstr_size::u64;

    off = bin.align_up(off, 8);
    va  = bin.align_up_u64(va, 8);
    lay.hash_off = off;
    lay.hash_va  = va;
    val nchain: usize = (dyn.import_count + 1)::usize;
    lay.hash_size = 8 + 4 + nchain * 4;
    off = off + lay.hash_size;
    va  = va  + lay.hash_size::u64;

    off = bin.align_up(off, 8);
    va  = bin.align_up_u64(va, 8);
    lay.relaplt_off  = off;
    lay.relaplt_va   = va;
    lay.relaplt_size = nimp::usize * RELA_SIZE;
    off = off + lay.relaplt_size;
    va  = va  + lay.relaplt_size::u64;

    off = bin.align_up(off, 8);
    va  = bin.align_up_u64(va, 8);
    lay.reladyn_off  = off;
    lay.reladyn_va   = va;
    lay.reladyn_size = ndata::usize * RELA_SIZE;
    off = off + lay.reladyn_size;
    va  = va  + lay.reladyn_size::u64;

    lay.ro_size = off - lay.ro_off;

    off = bin.align_up(off, page_sz);
    va  = bin.align_up_u64(va, page_sz::u64);
    lay.plt_off = off;
    lay.plt_va  = va;
    if (nimp > 0) { lay.plt_size = plt_header_size(arch_id) + PLT_ENTRY_SIZE * nimp::usize; } or { lay.plt_size = 0; }
    off = off + lay.plt_size;
    va  = va  + lay.plt_size::u64;

    off = bin.align_up(off, page_sz);
    va  = bin.align_up_u64(va, page_sz::u64);
    lay.rw_off = off;
    lay.rw_va  = va;

    lay.gotplt_off  = off;
    lay.gotplt_va   = va;
    lay.gotplt_size = (nimp + 3)::usize * GOT_ENTRY_SIZE;
    off = off + lay.gotplt_size;
    va  = va  + lay.gotplt_size::u64;

    lay.datagot_off  = off;
    lay.datagot_va   = va;
    lay.datagot_size = ndata::usize * GOT_ENTRY_SIZE;
    off = off + lay.datagot_size;
    va  = va  + lay.datagot_size::u64;

    off = bin.align_up(off, 8);
    va  = bin.align_up_u64(va, 8);
    lay.dynamic_off = off;
    lay.dynamic_va  = va;
    var dyn_entries: u32 = dyn.lib_count + 6;
    if (nimp > 0)              { dyn_entries = dyn_entries + 4; }
    if (ndata > 0)             { dyn_entries = dyn_entries + 3; }
    if (dyn_bind_now(arch_id)) { dyn_entries = dyn_entries + 2; }
    lay.dynamic_size = dyn_entries::usize * DYN_SIZE;
    off = off + lay.dynamic_size;
    va  = va  + lay.dynamic_size::u64;

    lay.rw_size = off - lay.rw_off;
}

fun write_dyn_structures(itn: *intern.Interner, buf: *u8, lay: *DynLayout, dyn: *of.DynamicInfo, got: *ImportAddressPlan, nimp: u32,
                         arch_id: u32, imp_str: *usize, lib_str: *usize) {
    bin.write_str(buf, lay.interp_off, bin.resolve_name(itn, dyn.interp));

    buf[lay.dynstr_off] = 0;
    var str_pos: usize = 1;
    str_pos = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.interp));

    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) {
            imp_str[i] = str_pos;
            str_pos = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.imports[i].symbol));
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].is_func) {
            imp_str[i] = str_pos;
            str_pos = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.imports[i].symbol));
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.lib_count) {
        lib_str[i] = str_pos;
        str_pos = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.libs[i].soname));
        i = i + 1;
    }

    var sym_off: usize = lay.dynsym_off + SYM_SIZE;
    i = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) {
            bin.write_u32_le(buf, sym_off, imp_str[i]::u32);
            buf[sym_off + 4] = (STB_GLOBAL << 4) | (STT_FUNC & 0xF);
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, 0);
            bin.write_u64_le(buf, sym_off + 8, 0);
            bin.write_u64_le(buf, sym_off + 16, 0);
            sym_off = sym_off + SYM_SIZE;
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].is_func) {
            bin.write_u32_le(buf, sym_off, imp_str[i]::u32);
            buf[sym_off + 4] = (STB_GLOBAL << 4) | (STT_OBJECT & 0xF);
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, 0);
            bin.write_u64_le(buf, sym_off + 8, 0);
            bin.write_u64_le(buf, sym_off + 16, 0);
            sym_off = sym_off + SYM_SIZE;
        }
        i = i + 1;
    }

    val ndata_h: u32 = got.count;
    val nchain: u32 = dyn.import_count + 1;
    bin.write_u32_le(buf, lay.hash_off, 1);
    bin.write_u32_le(buf, lay.hash_off + 4, nchain);
    if (dyn.import_count > 0) { bin.write_u32_le(buf, lay.hash_off + 8, 1); } or { bin.write_u32_le(buf, lay.hash_off + 8, 0); }
    var c: u32 = 0;
    for (c < nchain) {
        var next: u32 = c + 1;
        if (next >= nchain) { next = 0; }
        bin.write_u32_le(buf, lay.hash_off + 12 + c::usize * 4, next);
        c = c + 1;
    }

    bin.write_u64_le(buf, lay.gotplt_off, lay.dynamic_va);
    bin.write_u64_le(buf, lay.gotplt_off + 8, 0);
    bin.write_u64_le(buf, lay.gotplt_off + 16, 0);

    if (nimp > 0) {
        if (arch_id == isa.ARCH_X86_64) { write_plt_header(buf, lay); }
        var rela_off: usize = lay.relaplt_off;
        var n: u32 = 0;
        var sym_index: u32 = 1;
        i = 0;
        for (i < dyn.import_count) {
            if (dyn.imports[i].is_func) {
                write_plt_stub(buf, lay, n, arch_id);

                val got_slot_off: usize = lay.gotplt_off + (3 + n)::usize * GOT_ENTRY_SIZE;
                if (arch_id == isa.ARCH_X86_64) {
                    bin.write_u64_le(buf, got_slot_off, plt_stub_va(lay, n, arch_id) + 6);
                }

                val got_slot_va: u64 = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
                bin.write_u64_le(buf, rela_off, got_slot_va);
                val r_info: u64 = (sym_index::u64 << 32) | jump_slot_for(arch_id)::u64;
                bin.write_u64_le(buf, rela_off + 8, r_info);
                bin.write_u64_le(buf, rela_off + 16, 0);
                rela_off = rela_off + RELA_SIZE;

                n = n + 1;
                sym_index = sym_index + 1;
            }
            i = i + 1;
        }
    }

    if (ndata_h > 0) {
        var rd_off:  usize = lay.reladyn_off;
        var d_ord:   u32   = 0;
        i = 0;
        for (i < dyn.import_count) {
            if (got_import_ordinal(got, i) != 0xFFFFFFFF) {
                val slot_va: u64 = lay.datagot_va + d_ord::u64 * GOT_ENTRY_SIZE::u64;
                bin.write_u64_le(buf, rd_off, slot_va);
                val rd_info: u64 = (import_symbol_index(dyn, i)::u64 << 32) | glob_dat_for(arch_id)::u64;
                bin.write_u64_le(buf, rd_off + 8, rd_info);
                bin.write_u64_le(buf, rd_off + 16, 0);
                rd_off = rd_off + RELA_SIZE;
                d_ord = d_ord + 1;
            }
            i = i + 1;
        }
    }

    var dpos: usize = lay.dynamic_off;
    i = 0;
    for (i < dyn.lib_count) {
        dpos = write_dyn_entry(buf, dpos, DT_NEEDED, lib_str[i]::u64);
        i = i + 1;
    }
    dpos = write_dyn_entry(buf, dpos, DT_HASH,   lay.hash_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRTAB, lay.dynstr_va);
    dpos = write_dyn_entry(buf, dpos, DT_SYMTAB, lay.dynsym_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRSZ,  lay.dynstr_size::u64);
    dpos = write_dyn_entry(buf, dpos, DT_SYMENT, SYM_SIZE::u64);
    if (nimp > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_PLTGOT,   lay.gotplt_va);
        dpos = write_dyn_entry(buf, dpos, DT_PLTRELSZ, lay.relaplt_size::u64);
        dpos = write_dyn_entry(buf, dpos, DT_PLTREL,   DT_RELA_TAG);
        dpos = write_dyn_entry(buf, dpos, DT_JMPREL,   lay.relaplt_va);
    }
    if (ndata_h > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_RELA,    lay.reladyn_va);
        dpos = write_dyn_entry(buf, dpos, DT_RELASZ,  lay.reladyn_size::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELAENT, RELA_SIZE::u64);
    }
    if (dyn_bind_now(arch_id)) {
        dpos = write_dyn_entry(buf, dpos, DT_FLAGS,    DF_BIND_NOW);
        dpos = write_dyn_entry(buf, dpos, DT_BIND_NOW, 0);
    }
    dpos = write_dyn_entry(buf, dpos, DT_NULL, 0);
}

fun write_dyn_entry(buf: *u8, off: usize, tag: u64, value: u64) usize {
    bin.write_u64_le(buf, off, tag);
    bin.write_u64_le(buf, off + 8, value);
    ret off + DYN_SIZE;
}

fun write_plt_header(buf: *u8, lay: *DynLayout) {
    val p: usize = lay.plt_off;
    buf[p] = 0xFF; buf[p + 1] = 0x35;
    val next1: u64 = lay.plt_va + 6;
    val got1:  u64 = lay.gotplt_va + 8;
    bin.write_u32_le(buf, p + 2, (got1 - next1)::u32);
    buf[p + 6] = 0xFF; buf[p + 7] = 0x25;
    val next2: u64 = lay.plt_va + 12;
    val got2:  u64 = lay.gotplt_va + 16;
    bin.write_u32_le(buf, p + 8, (got2 - next2)::u32);
    buf[p + 12] = 0x0F; buf[p + 13] = 0x1F; buf[p + 14] = 0x40; buf[p + 15] = 0x00;
}

val A64_PLT_ADRP_X16: u32 = 0x90000010;
val A64_PLT_LDR_X16:  u32 = 0xF9400210;
val A64_PLT_BR_X16:   u32 = 0xD61F0200;
val A64_NOP:          u32 = 0xD503201F;
val RV_PLT_AUIPC_T3:  u32 = 0x00000E17;
val RV_PLT_LD_T3:     u32 = 0x000E3E03;
val RV_PLT_JR_T3:     u32 = 0x000E0067;
val RV_NOP:           u32 = 0x00000013;

fun arm64_adrp_word(base: u32, pc: u64, target: u64) u32 {
    val tgt_page: i64 = (target::i64) - ((target::i64) & 0xFFF);
    val pc_page:  i64 = (pc::i64)     - ((pc::i64)     & 0xFFF);
    val delta: i64 = tgt_page - pc_page;
    val imm21: u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
    val immlo: u32 = imm21 & 0x3;
    val immhi: u32 = (imm21 >> 2) & 0x7FFFF;
    ret base | (immlo << 29) | (immhi << 5);
}

fun arm64_ldr64_lo12_word(base: u32, target: u64) u32 {
    val imm12: u32 = (((target & 0xFFF) >> 3)::u32);
    ret base | (imm12 << 10);
}

fun riscv_hi20_word(base: u32, delta: i64) u32 {
    val hi20: u32 = (((delta + 0x800) >> 12)::u64 & 0xFFFFF)::u32;
    ret base | (hi20 << 12);
}

fun riscv_lo12_i_word(base: u32, delta: i64) u32 {
    val lo12: u32 = (delta::u64 & 0xFFF)::u32;
    ret base | (lo12 << 20);
}

fun write_plt_stub(buf: *u8, lay: *DynLayout, n: u32, arch_id: u32) {
    if (arch_id == isa.ARCH_AARCH64) { write_plt_stub_aarch64(buf, lay, n); ret; }
    if (arch_id == isa.ARCH_RISCV64) { write_plt_stub_riscv64(buf, lay, n); ret; }
    write_plt_stub_x86_64(buf, lay, n);
}

fun write_plt_stub_x86_64(buf: *u8, lay: *DynLayout, n: u32) {
    val stub_off: usize = lay.plt_off + (n + 1)::usize * PLT_ENTRY_SIZE;
    val stub_va:  u64   = lay.plt_va + (n + 1)::u64 * PLT_ENTRY_SIZE::u64;
    buf[stub_off] = 0xFF; buf[stub_off + 1] = 0x25;
    val next: u64 = stub_va + 6;
    val got:  u64 = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
    bin.write_u32_le(buf, stub_off + 2, (got - next)::u32);
    buf[stub_off + 6] = 0x68;
    bin.write_u32_le(buf, stub_off + 7, n);
    buf[stub_off + 11] = 0xE9;
    val plt0: u64 = lay.plt_va;
    val after: u64 = stub_va + 16;
    bin.write_u32_le(buf, stub_off + 12, (plt0 - after)::u32);
}

fun write_plt_stub_aarch64(buf: *u8, lay: *DynLayout, n: u32) {
    val stub_off: usize = lay.plt_off + n::usize * PLT_ENTRY_SIZE;
    val stub_va:  u64   = plt_stub_va(lay, n, isa.ARCH_AARCH64);
    val got_va:   u64   = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
    bin.write_u32_le(buf, stub_off,      arm64_adrp_word(A64_PLT_ADRP_X16, stub_va, got_va));
    bin.write_u32_le(buf, stub_off + 4,  arm64_ldr64_lo12_word(A64_PLT_LDR_X16, got_va));
    bin.write_u32_le(buf, stub_off + 8,  A64_PLT_BR_X16);
    bin.write_u32_le(buf, stub_off + 12, A64_NOP);
}

fun write_plt_stub_riscv64(buf: *u8, lay: *DynLayout, n: u32) {
    val stub_off: usize = lay.plt_off + n::usize * PLT_ENTRY_SIZE;
    val stub_va:  u64   = plt_stub_va(lay, n, isa.ARCH_RISCV64);
    val got_va:   u64   = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
    val delta: i64 = (got_va::i64) - (stub_va::i64);
    bin.write_u32_le(buf, stub_off,      riscv_hi20_word(RV_PLT_AUIPC_T3, delta));
    bin.write_u32_le(buf, stub_off + 4,  riscv_lo12_i_word(RV_PLT_LD_T3, delta));
    bin.write_u32_le(buf, stub_off + 8,  RV_PLT_JR_T3);
    bin.write_u32_le(buf, stub_off + 12, RV_NOP);
}

fun patch_plt_fixups(buf: *u8, lay: *DynLayout, dyn: *of.DynamicInfo,
                     fixups: *of.PltFixup, fixup_count: u32, seg_offsets: *usize,
                     segs: *of.LoadSegment, seg_count: u32, nimp: u32, arch_id: u32) R.Result[R.Void, str] {
    if (nimp == 0) { ret R.ok_void[str](); }
    val width: usize = call_patch_width(arch_id);
    var i: u32 = 0;
    for (i < fixup_count) {
        val fx: *of.PltFixup = ?fixups[i];
        if (fx.seg_index >= seg_count) {
            ret R.err[R.Void, str]("elf: dynamic call-site fixup references an out-of-range segment");
        }
        val n: u32 = func_ordinal(dyn, fx.import_index);
        if (n == 0xFFFFFFFF) {
            ret R.err[R.Void, str]("elf: dynamic call-site fixup targets a non-function import");
        }

        val seg_filesz: usize = segs[fx.seg_index].filesz;
        if (fx.seg_offset::usize + width > seg_filesz) {
            ret R.err[R.Void, str]("elf: dynamic call-site fixup offset out of range");
        }

        val stub_va:  u64   = plt_stub_va(lay, n, arch_id);
        val file_off: usize = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
        val pr: R.Result[R.Void, str] = patch_call_site(buf, file_off, arch_id, stub_va, fx.addend, fx.patch_vaddr);
        if (R.is_err[R.Void, str](pr)) { ret pr; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun patch_import_addr_fixups(buf: *u8, lay: *DynLayout, dyn: *of.DynamicInfo, got: *ImportAddressPlan,
                             seg_offsets: *usize, segs: *of.LoadSegment,
                             seg_count: u32, arch_id: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        val fx: *of.ImportAddrFixup = ?dyn.import_addr_fixups[i];
        if (fx.seg_index >= seg_count) {
            ret R.err[R.Void, str]("elf: data-import GOT fixup references an out-of-range segment");
        }
        val ord: u32 = got_import_ordinal(got, fx.import_index);
        if (ord == 0xFFFFFFFF || ord::usize >= lay.datagot_size / GOT_ENTRY_SIZE) {
            ret R.err[R.Void, str]("elf: import-address fixup has no allocated GOT slot");
        }
        val slot_va: u64 = lay.datagot_va + ord::u64 * GOT_ENTRY_SIZE::u64;

        val seg_filesz: usize = segs[fx.seg_index].filesz;
        if (fx.seg_offset::usize + 4 > seg_filesz) {
            ret R.err[R.Void, str]("elf: data-import GOT fixup offset out of range");
        }
        val file_off: usize = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
        val cur: u32 = bin.read_u32_le(buf, file_off);
        if (arch_id == isa.ARCH_RISCV64 && (fx.kind == of.RK_GOT_PCREL_HI20
            || fx.kind == of.RK_PCREL_LO12_I || fx.kind == of.RK_PCREL_LO12_S)) {
            var target: of.RelocTarget;
            target.vaddr = slot_va;
            val patched: R.Result[bool, relocation.RelocError] = rvrel.apply_reloc(
                fx.kind, (buf::usize + file_off)::*u8, 0, 4, target, fx.addend, fx.patch_vaddr, 0);
            if (R.is_err[bool, relocation.RelocError](patched)) {
                ret R.err[R.Void, str]("elf: RISC-V import-address GOT relocation failed");
            }
        } or (arch_id != isa.ARCH_AARCH64 || fx.addend != 0) {
            ret R.err[R.Void, str]("elf: unsupported import-address GOT relocation or addend");
        } or (fx.kind == of.RK_GOT_PAGE21) {
            bin.write_u32_le(buf, file_off, arm64_adrp_word(cur, fx.patch_vaddr, slot_va));
        } or (fx.kind == of.RK_GOT_LO12) {
            bin.write_u32_le(buf, file_off, arm64_ldr64_lo12_word(cur, slot_va));
        } or {
            ret R.err[R.Void, str]("elf: unsupported data-import GOT relocation kind");
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun call_patch_width(arch_id: u32) usize {
    if (arch_id == isa.ARCH_RISCV64) { ret 8; }
    ret 4;
}

fun patch_call_site(buf: *u8, file_off: usize, arch_id: u32, stub_va: u64,
                    addend: i64, patch_va: u64) R.Result[R.Void, str] {
    if (arch_id == isa.ARCH_AARCH64) {
        val disp: i64 = (stub_va::i64) + addend - (patch_va::i64);
        val lim: i64 = 134217728;
        if (disp < -lim || disp >= lim || (disp & 3) != 0) {
            ret R.err[R.Void, str]("elf: dynamic call-site displacement overflows the BL +-128MB range");
        }
        val word: u32 = bin.read_u32_le(buf, file_off);
        val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
        bin.write_u32_le(buf, file_off, (word & 0xFC000000) | imm26);
        ret R.ok_void[str]();
    }

    if (arch_id == isa.ARCH_RISCV64) {
        val delta: i64 = (stub_va::i64) + addend - (patch_va::i64);
        if (!riscv_pcrel_ok(delta)) {
            ret R.err[R.Void, str]("elf: dynamic call-site displacement overflows the auipc+jalr +-2GB range");
        }
        val auipc: u32 = bin.read_u32_le(buf, file_off);
        bin.write_u32_le(buf, file_off, riscv_hi20_word(auipc & 0xFFF, delta));
        val jalr: u32 = bin.read_u32_le(buf, (file_off + 4));
        bin.write_u32_le(buf, (file_off + 4), riscv_lo12_i_word(jalr & 0x000FFFFF, delta));
        ret R.ok_void[str]();
    }

    val disp: i64 = (stub_va::i64) + addend - (patch_va::i64);
    if (disp > 2147483647 || disp < -2147483648) {
        ret R.err[R.Void, str]("elf: dynamic call-site displacement overflows 32 bits");
    }
    bin.write_u32_le(buf, file_off, (disp::u64)::u32);
    ret R.ok_void[str]();
}

fun riscv_pcrel_ok(delta: i64) bool {
    val adj: i64 = delta + 0x800;
    ret adj >= -2147483648 && adj <= 2147483647;
}

fun func_ordinal(dyn: *of.DynamicInfo, import_index: u32) u32 {
    if (import_index >= dyn.import_count)   { ret 0xFFFFFFFF; }
    if (!dyn.imports[import_index].is_func) { ret 0xFFFFFFFF; }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < import_index) {
        if (dyn.imports[i].is_func) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun write_dyn_phdrs(buf: *u8, phdr_offset: usize, lay: *DynLayout,
                    segs: *of.LoadSegment, seg_offsets: *usize, seg_count: u32, page_size: u64) {
    var pos: usize = phdr_offset;

    var hdr_vaddr: u64 = 0;
    if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }

    pos = write_phdr(buf, pos, PT_PHDR, PF_R, phdr_offset, hdr_vaddr + phdr_offset::u64,
                     phdr_count_bytes(seg_count), phdr_count_bytes(seg_count), 8);

    pos = write_phdr(buf, pos, PT_INTERP, PF_R, lay.interp_off, lay.interp_va,
                     lay.interp_size, lay.interp_size, 1);

    var li: u32 = 0;
    for (li < seg_count) {
        if (li == 0) {
            val first_filesz: usize = seg_offsets[0] + segs[0].filesz;
            val first_memsz:  usize = seg_offsets[0] + segs[0].memsz;
            pos = write_phdr(buf, pos, PT_LOAD, pf_flags_for(segs[0].flags), 0,
                             hdr_vaddr, first_filesz, first_memsz, page_size);
        }
        or {
            pos = write_phdr(buf, pos, PT_LOAD, pf_flags_for(segs[li].flags), seg_offsets[li],
                             segs[li].vaddr, segs[li].filesz, segs[li].memsz, page_size);
        }
        li = li + 1;
    }

    pos = write_phdr(buf, pos, PT_LOAD, PF_R, lay.ro_off, lay.ro_va, lay.ro_size, lay.ro_size, page_size);
    pos = write_phdr(buf, pos, PT_LOAD, PF_R | PF_X, lay.plt_off, lay.plt_va, lay.plt_size, lay.plt_size, page_size);
    pos = write_phdr(buf, pos, PT_LOAD, PF_R | PF_W, lay.rw_off, lay.rw_va, lay.rw_size, lay.rw_size, page_size);

    pos = write_phdr(buf, pos, PT_DYNAMIC, PF_R | PF_W, lay.dynamic_off, lay.dynamic_va,
                     lay.dynamic_size, lay.dynamic_size, 8);
}

fun phdr_count_bytes(seg_count: u32) usize {
    ret (seg_count + 6)::usize * PHDR_SIZE;
}

fun write_phdr(buf: *u8, pos: usize, p_type: u32, flags: u32, off: usize, vaddr: u64,
               filesz: usize, memsz: usize, align: u64) usize {
    bin.write_u32_le(buf, pos, p_type);
    bin.write_u32_le(buf, pos + 4, flags);
    bin.write_u64_le(buf, pos + 8, off::u64);
    bin.write_u64_le(buf, pos + 16, vaddr);
    bin.write_u64_le(buf, pos + 24, vaddr);
    bin.write_u64_le(buf, pos + 32, filesz::u64);
    bin.write_u64_le(buf, pos + 40, memsz::u64);
    bin.write_u64_le(buf, pos + 48, align);
    ret pos + PHDR_SIZE;
}

fun bad_magic_message(itn: *intern.Interner, alloc: *A.Allocator, buf: *u8) str {
    val fallback: str = "elf: not an ELF object (bad magic; expected 0x7F 'E' 'L' 'F')";
    if (itn == nil) { ret fallback; }
    val hex: str = "0123456789ABCDEF";
    val pre: str = "elf: not an ELF object (expected 0x7F 'E' 'L' 'F', got ";
    val suf: str = ")";
    val lpre: usize = str_len(pre);
    val total: usize = lpre + 23 + str_len(suf);
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, total + 1);
    if (R.is_err[*u8, str](r)) { ret fallback; }
    val msg: *u8 = R.unwrap_ok[*u8, str](r);
    memory.raw_copy(msg::ptr, pre::ptr, lpre);
    var off: usize = lpre;
    var bi: usize = 0;
    for (bi < 4) {
        val b: u8 = buf[bi];
        msg[off] = '0'; off = off + 1;
        msg[off] = 'x'; off = off + 1;
        msg[off] = hex[(b >> 4)::usize]; off = off + 1;
        msg[off] = hex[(b & 0x0F)::usize]; off = off + 1;
        if (bi < 3) { msg[off] = ' '; off = off + 1; }
        bi = bi + 1;
    }
    memory.raw_copy((msg::usize + off)::ptr, suf::ptr, str_len(suf));
    msg[total] = 0;
    val ir: R.Result[intern.StrId, str] = intern.intern(itn, msg::str);
    A.deallocate[u8](alloc, msg, total + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }
    val lo: O.Option[str] = intern.lookup(itn, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](lo)) { ret O.unwrap[str](lo); }
    ret fallback;
}

fun bad_class_message(itn: *intern.Interner, alloc: *A.Allocator, cls: u8) str {
    ret bin.number_message(itn, alloc, "elf: unknown ELF class ", cls::u64, "elf: unknown ELF class");
}

fun section_has_bytes(ty: u32, machine: u16) bool {
    if (ty == SHT_PROGBITS || ty == SHT_NOBITS) { ret true; }
    if (ty < SHT_LOPROC || ty > SHT_HIPROC) { ret false; }
    if (machine == EM_X86_64 && ty == SHT_X86_64_UNWIND) { ret true; }
    ret false;
}

fun read_build_attributes(alloc: *A.Allocator, buf: *u8, buf_size: usize, lay: *ElfLayout,
                          e_shoff: usize, e_shentsize: u16, e_shnum: u16,
                          out: *of.ObjectImage) R.Result[R.Void, str] {
    out.attributes = nil;
    out.attributes_len = 0;

    var si: u32 = 0;
    for (si < e_shnum::u32) {
        val sh: ElfShdr = read_shdr(buf, e_shoff + si::usize * e_shentsize::usize, lay);
        si = si + 1;
        if (sh.stype != SHT_RISCV_ATTRIBUTES) { cnt; }

        val sec_off: usize = sh.offset::usize;
        val sec_len: usize = sh.size::usize;
        if (R.is_err[R.Void, str](bin.require_region(buf_size, sec_off, sec_len,
            "elf: build-attributes section out of bounds"))) { cnt; }
        if (sec_len < 2 || buf[sec_off] != ELF_ATTR_VERSION_A) { cnt; }

        var p: usize = sec_off + 1;
        val end: usize = sec_off + sec_len;
        if (p + 4 > end) { cnt; }
        val vend_len: usize = bin.read_u32_le(buf, p)::usize;
        if (vend_len < 5 || p + vend_len > end) { cnt; }
        val vend_end: usize = p + vend_len;
        p = p + 4;
        val vstart: usize = p;
        for (p < vend_end && buf[p] != 0) { p = p + 1; }
        if (p >= vend_end) { cnt; }
        val vlen: usize = p - vstart;
        p = p + 1;
        if (vlen != 5) { cnt; }
        if (buf[vstart] != 114 || buf[vstart + 1] != 105 || buf[vstart + 2] != 115
            || buf[vstart + 3] != 99 || buf[vstart + 4] != 118) { cnt; }

        if (p >= vend_end || buf[p]::u32 != ELF_ATTR_TAG_FILE) { cnt; }
        p = p + 1;
        if (p + 4 > vend_end) { cnt; }
        val file_len: usize = bin.read_u32_le(buf, p)::usize;
        if (file_len < 5) { cnt; }
        val body_len: usize = file_len - 5;
        p = p + 4;
        if (p + body_len > vend_end || body_len == 0) { cnt; }

        val br: R.Result[*u8, str] = A.allocate[u8](alloc, body_len);
        if (R.is_err[*u8, str](br)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](br)); }
        val body: *u8 = R.unwrap_ok[*u8, str](br);
        var k: usize = 0;
        for (k < body_len) { body[k] = buf[p + k]; k = k + 1; }
        out.attributes = body;
        out.attributes_len = body_len::u32;
        ret R.ok_void[str]();
    }
    ret R.ok_void[str]();
}

pub fun parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < 16) {
        ret R.err[R.Void, str]("elf: object too small");
    }
    if (alloc == nil) { ret R.err[R.Void, str]("elf: no allocator for parse"); }
    if (itn == nil)   { ret R.err[R.Void, str]("elf: no interner for parse"); }

    var parsed: of.ObjectImage = of.object_image_init(alloc, itn, intern.STR_NIL);
    val built: R.Result[R.Void, str] = parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (R.is_err[R.Void, str](built)) {
        val reason: str = R.unwrap_err[R.Void, str](built);
        of.object_image_dnit(?parsed);
        ret R.err[R.Void, str](reason);
    }
    val valid: R.Result[R.Void, str] = of.validate_owned_object_or_dnit(?parsed);
    if (R.is_err[R.Void, str](valid)) { ret valid; }
    @out = parsed;
    ret R.ok_void[str]();
}

fun parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < 16) {
        ret R.err[R.Void, str]("elf: object too small");
    }
    if (buf[0] != 0x7F || buf[1] != 0x45 || buf[2] != 0x4C || buf[3] != 0x46) {
        ret R.err[R.Void, str](bad_magic_message(itn, alloc, buf));
    }
    if (itn == nil) { ret R.err[R.Void, str]("elf: no interner for parse"); }
    out.interner = itn;

    var lay: ElfLayout;
    if (!layout_from_class(buf[4], ?lay)) { ret R.err[R.Void, str](bad_class_message(itn, alloc, buf[4])); }
    if (buf_size < lay.ehdr_size) { ret R.err[R.Void, str]("elf: object too small"); }

    val e_machine:   u16   = bin.read_u16_le(buf, 18);
    val hdr_tail:    usize = 24 + 3 * lay.addr_width::usize;
    out.machine_flags      = bin.read_u32_le(buf, hdr_tail);
    val e_shoff:     usize = read_addr(buf, 24 + 2 * lay.addr_width::usize, ?lay)::usize;
    val e_shentsize: u16   = bin.read_u16_le(buf, hdr_tail + 10);
    val e_shnum:     u16   = bin.read_u16_le(buf, hdr_tail + 12);
    val e_shstrndx:  u16   = bin.read_u16_le(buf, hdr_tail + 14);
    if (e_shoff == 0 || e_shnum == 0) { ret R.err[R.Void, str]("elf: no section headers"); }

    if (e_shentsize::usize < lay.shdr_size) { ret R.err[R.Void, str]("elf: section header entry too small"); }
    val vsht: R.Result[R.Void, str] = bin.require_region(buf_size, e_shoff,
        e_shnum::usize * e_shentsize::usize, "elf: section header table out of bounds");
    if (R.is_err[R.Void, str](vsht)) { ret vsht; }

    val vab: R.Result[R.Void, str] = read_build_attributes(alloc, buf, buf_size, ?lay, e_shoff,
                                                        e_shentsize, e_shnum, out);
    if (R.is_err[R.Void, str](vab)) { ret vab; }

    var shstr_off:  usize = 0;
    var have_shstr: bool = false;
    if (e_shstrndx < e_shnum) {
        val sh: ElfShdr = read_shdr(buf, e_shoff + e_shstrndx::usize * e_shentsize::usize, ?lay);
        shstr_off = sh.offset::usize;
        val shstr_size: usize = sh.size::usize;
        val vss: R.Result[R.Void, str] = bin.require_region(buf_size, shstr_off, shstr_size,
            "elf: section-name string table out of bounds");
        if (R.is_err[R.Void, str](vss)) { ret vss; }
        have_shstr = true;
    }

    var strtab_off:  usize = 0;
    var strtab_size: usize = 0;
    var have_strtab: bool = false;
    var symtab: *u8 = nil;
    var symtab_count: u32 = 0;
    var sh: u16 = 0;
    for (sh < e_shnum) {
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize::usize, ?lay);
        if (shh.stype == SHT_SYMTAB) {
            val symtab_off: usize = shh.offset::usize;
            val ent: usize = shh.entsize::usize;
            if (ent > 0) {
                val raw_count: usize = shh.size::usize / ent;
                val fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(raw_count);
                if (R.is_err[u32, layout.CheckCause](fits)) {
                    ret R.err[R.Void, str]("elf: symbol table entry count exceeds the u32 limit");
                }
                symtab_count = R.unwrap_ok[u32, layout.CheckCause](fits);
            }
            val vsy: R.Result[R.Void, str] = bin.require_region(buf_size, symtab_off,
                symtab_count::usize * lay.sym_size, "elf: symbol table out of bounds");
            if (R.is_err[R.Void, str](vsy)) { ret vsy; }
            symtab = (buf::usize + symtab_off)::*u8;
            val link: u32 = shh.link;
            if (link < e_shnum::u32) {
                val lh: ElfShdr = read_shdr(buf, e_shoff + link::usize * e_shentsize::usize, ?lay);
                strtab_off = lh.offset::usize;
                strtab_size = lh.size::usize;
                val vst: R.Result[R.Void, str] = bin.require_region(buf_size, strtab_off, strtab_size,
                    "elf: symbol string table out of bounds");
                if (R.is_err[R.Void, str](vst)) { ret vst; }
                have_strtab = true;
            }
        }
        sh = sh + 1;
    }

    var sec_n: u32 = 0;
    var rel_total: layout.CheckedCount[of.Relocation] = layout.count[of.Relocation](0::usize);
    sh = 0;
    for (sh < e_shnum) {
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize::usize, ?lay);
        if (section_has_bytes(shh.stype, e_machine)) { sec_n = sec_n + 1; }
        if (shh.stype == SHT_RELA) {
            val term: layout.CheckedCount[of.Relocation] =
                layout.count[of.Relocation](shh.size::usize / lay.rela_size);
            val added: R.Result[layout.CheckedCount[of.Relocation], layout.CheckCause] =
                layout.count_add[of.Relocation](rel_total, term);
            if (R.is_err[layout.CheckedCount[of.Relocation], layout.CheckCause](added)) {
                ret R.err[R.Void, str]("elf: relocation count exceeds the u32 limit");
            }
            rel_total = R.unwrap_ok[layout.CheckedCount[of.Relocation], layout.CheckCause](added);
        }
        sh = sh + 1;
    }
    val rel_n_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(rel_total.value);
    if (R.is_err[u32, layout.CheckCause](rel_n_fits)) {
        ret R.err[R.Void, str]("elf: relocation count exceeds the u32 limit");
    }
    val rel_n: u32 = R.unwrap_ok[u32, layout.CheckCause](rel_n_fits);
    val sym_n: u32 = symtab_count;
    var sym_pop: u32 = 0;
    if (sym_n > 0) { sym_pop = sym_n - 1; }

    if (sec_n > 0) {
        val rsec: R.Result[*of.Section, str] = A.zallocate[of.Section](alloc, sec_n::usize);
        if (R.is_err[*of.Section, str](rsec)) { ret R.err[R.Void, str]("elf: section array alloc failed"); }
        out.sections = R.unwrap_ok[*of.Section, str](rsec);
        out.section_cap = sec_n;
    }
    if (sym_pop > 0) {
        val rsym: R.Result[*of.Symbol, str] = A.zallocate[of.Symbol](alloc, sym_pop::usize);
        if (R.is_err[*of.Symbol, str](rsym)) { ret R.err[R.Void, str]("elf: symbol array alloc failed"); }
        out.symbols = R.unwrap_ok[*of.Symbol, str](rsym);
        out.symbol_cap = sym_pop;
    }
    if (rel_n > 0) {
        val rrel: R.Result[*of.Relocation, str] = A.zallocate[of.Relocation](alloc, rel_n::usize);
        if (R.is_err[*of.Relocation, str](rrel)) { ret R.err[R.Void, str]("elf: reloc array alloc failed"); }
        out.relocations = R.unwrap_ok[*of.Relocation, str](rrel);
        out.reloc_cap = rel_n;
    }

    out.section_count = sec_n;
    out.symbol_count  = sym_pop;
    out.reloc_count   = rel_n;

    val res_map: R.Result[*i32, str] = A.zallocate[i32](alloc, e_shnum::usize);
    if (R.is_err[*i32, str](res_map)) { ret R.err[R.Void, str]("elf: section map alloc failed"); }
    var sec_map: *i32 = R.unwrap_ok[*i32, str](res_map);

    var sec_i: u32 = 0;
    sh = 0;
    for (sh < e_shnum) {
        sec_map[sh] = -1;
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize::usize, ?lay);
        val ty: u32 = shh.stype;
        if (section_has_bytes(ty, e_machine)) {
            val flags: u64 = shh.flags;

            var sec_name: str = "";
            if (have_shstr) {
                val rnm: R.Result[str, str] = bin.cstr_at(buf, buf_size, shstr_off + shh.name::usize);
                if (R.is_err[str, str](rnm)) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret R.err[R.Void, str](R.unwrap_err[str, str](rnm));
                }
                sec_name = R.unwrap_ok[str, str](rnm);
            }

            var kind: of.SectionKind = of.SK_DATA;
            if (str_equals(sec_name, ".data.rel.ro")) { kind = of.SK_RELRO; }
            or ((flags & SHF_ALLOC) == 0)     { kind = of.SK_DEBUG; }
            or ((flags & SHF_EXECINSTR) != 0) { kind = of.SK_TEXT; }
            or (ty == SHT_NOBITS)             { kind = of.SK_BSS; }
            or ((flags & SHF_WRITE) == 0)     { kind = of.SK_RODATA; }

            val rin: R.Result[intern.StrId, str] = intern.intern(itn, sec_name);
            if (R.is_err[intern.StrId, str](rin)) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rin));
            }

            val idx: u32 = sec_i;
            out.sections[idx].name  = R.unwrap_ok[intern.StrId, str](rin);
            out.sections[idx].kind  = kind;
            out.sections[idx].align = shh.addralign::u32;
            out.sections[idx].len   = shh.size::u32;
            out.sections[idx].bytes = nil;
            out.sections[idx].flags = 0;
            if ((flags & SHF_MERGE) != 0
                && shh.entsize == out.sections[idx].len::u64
                && out.sections[idx].len > 0) {
                out.sections[idx].flags = of.SEC_FLAG_MERGEABLE;
            }
            if (ty != SHT_NOBITS && out.sections[idx].len > 0) {
                val sz: usize = out.sections[idx].len::usize;
                val src_off: usize = shh.offset::usize;
                if (!bin.region_ok(buf_size, src_off, sz)) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret R.err[R.Void, str]("elf: section data out of bounds");
                }
                val rb: R.Result[*u8, str] = A.allocate[u8](alloc, sz);
                if (R.is_err[*u8, str](rb)) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret R.err[R.Void, str]("elf: section bytes alloc failed");
                }
                out.sections[idx].bytes = R.unwrap_ok[*u8, str](rb);
                val src: *u8 = (buf::usize + src_off)::*u8;
                memory.raw_copy(out.sections[idx].bytes::ptr, src::ptr, sz);
            }
            sec_map[sh] = idx::i32;
            sec_i = sec_i + 1;
        }
        sh = sh + 1;
    }

    var sym_i: u32 = 0;
    if (symtab != nil && have_strtab) {
        var si: u32 = 1;
        for (si < sym_n) {
            val sym: ElfSym = read_sym(symtab, si::usize * lay.sym_size, ?lay);
            val st_info:  u8  = sym.info;
            val st_shndx: u16 = sym.shndx;

            val rnm: R.Result[str, str] = bin.cstr_at(buf, buf_size, strtab_off + sym.name::usize);
            if (R.is_err[str, str](rnm)) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret R.err[R.Void, str](R.unwrap_err[str, str](rnm));
            }
            val rin: R.Result[intern.StrId, str] = intern.intern(itn, R.unwrap_ok[str, str](rnm));
            if (R.is_err[intern.StrId, str](rin)) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rin));
            }

            val idx: u32 = sym_i;
            out.symbols[idx].name = R.unwrap_ok[intern.StrId, str](rin);
            out.symbols[idx].offset = sym.value::u32;
            out.symbols[idx].size = sym.size::u32;
            var flags: u32 = 0;
            if ((st_info >> 4) == STB_GLOBAL) { flags = flags | of.SYM_OBJ_FLAG_GLOBAL; }
            or ((st_info >> 4) == STB_WEAK)    { flags = flags | of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK; }
            if ((st_info & 0xF) == STT_FUNC)   { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }
            or ((st_info & 0xF) == STT_OBJECT) { flags = flags | of.SYM_OBJ_FLAG_OBJECT; }
            if (st_shndx == 0) {
                flags = flags | of.SYM_OBJ_FLAG_EXTERN;
                out.symbols[idx].section = of.SECTION_EXTERNAL;
            } or (st_shndx < e_shnum && sec_map[st_shndx] >= 0) {
                out.symbols[idx].section = sec_map[st_shndx]::u32;
            } or {
                out.symbols[idx].section = of.SECTION_EXTERNAL;
            }
            out.symbols[idx].flags = flags;
            sym_i = sym_i + 1;
            si = si + 1;
        }
    }

    var rel_i: u32 = 0;
    sh = 0;
    for (sh < e_shnum) {
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize::usize, ?lay);
        if (shh.stype == SHT_RELA) {
            val r_base: usize = shh.offset::usize;
            val sh_info: u32 = shh.info;
            val count: u32 = (shh.size::usize / lay.rela_size)::u32;
            if (!bin.region_ok(buf_size, r_base, count::usize * lay.rela_size)) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret R.err[R.Void, str]("elf: relocation array out of bounds");
            }
            var target_sec: i32 = -1;
            if (sh_info < e_shnum::u32) { target_sec = sec_map[sh_info]; }

            var ri: u32 = 0;
            for (ri < count) {
                var r_offset: u64 = 0;
                var r_sym:  u32 = 0;
                var r_type: u32 = 0;
                var r_addend: i64 = 0;
                read_rela(buf, r_base + ri::usize * lay.rela_size, ?lay,
                          ?r_offset, ?r_sym, ?r_type, ?r_addend);

                val idx: u32 = rel_i;
                if (target_sec >= 0) { out.relocations[idx].section = target_sec::u32; }
                or { out.relocations[idx].section = of.SECTION_EXTERNAL; }
                out.relocations[idx].offset = r_offset::u32;
                out.relocations[idx].addend = r_addend;
                val rk: R.Result[of.RelocKind, str] = reloc_kind_for(itn, alloc, e_machine, r_type);
                if (R.is_err[of.RelocKind, str](rk)) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret R.err[R.Void, str](R.unwrap_err[of.RelocKind, str](rk));
                }
                out.relocations[idx].kind = R.unwrap_ok[of.RelocKind, str](rk);
                if (r_sym > 0 && (r_sym - 1) < sym_i) {
                    out.relocations[idx].sym = r_sym - 1;
                } or {
                    out.relocations[idx].sym = of.SYMBOL_NONE;
                }
                rel_i = rel_i + 1;
                ri = ri + 1;
            }
        }
        sh = sh + 1;
    }

    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
    ret R.ok_void[str]();
}

fun t_intern(itn: *intern.Interner, s: str) intern.StrId {
    val r: R.Result[intern.StrId, str] = intern.intern(itn, s);
    if (R.is_err[intern.StrId, str](r)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun t_isa(id: u32, elf_machine: u32, reloc: *isa.RelocSeam) of.ObjectTarget {
    var vt: isa.IsaVTable = isa.machine_isa(id, "test", elf_machine, 8, nil, nil, reloc);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

fun t_apply_reloc(kind: of.RelocKind, bytes: *u8, off: u32, bytes_len: u32,
                  target: of.RelocTarget, addend: i64, place: u64,
                  image_base: u64) R.Result[bool, of.RelocError] {
    ret R.ok[bool, of.RelocError](true);
}

fun t_reloc_traits(kind: of.RelocKind, section_kind: of.SectionKind,
                   external: bool) R.Result[of.RelocTraits, of.RelocError] {
    var traits: of.RelocTraits;
    ret R.ok[of.RelocTraits, of.RelocError](traits);
}

fun t_seam(elf_reloc_type: of.ElfRelocTypeFn) isa.RelocSeam {
    ret isa.reloc_seam(t_apply_reloc, t_reloc_traits, elf_reloc_type);
}

fun t_x64_elf_reloc_type(kind: of.RelocKind) u32 {
    if (kind == of.RK_ABS64)    { ret R_X86_64_64; }
    if (kind == of.RK_PC32)     { ret R_X86_64_PC32; }
    if (kind == of.RK_PLT32)    { ret R_X86_64_PLT32; }
    if (kind == of.RK_GOTPCREL) { ret R_X86_64_GOTPCREL; }
    if (kind == of.RK_ABS32S)   { ret R_X86_64_32S; }
    if (kind == of.RK_ABS32)    { ret R_X86_64_32; }
    ret 0;
}

fun t_riscv_elf_reloc_type(kind: of.RelocKind) u32 {
    if (kind == of.RK_ABS64)        { ret R_RISCV_64; }
    if (kind == of.RK_PLT32)        { ret R_RISCV_CALL_PLT; }
    if (kind == of.RK_GOT_PCREL_HI20) { ret R_RISCV_GOT_HI20; }
    if (kind == of.RK_PCREL_HI20)   { ret R_RISCV_PCREL_HI20; }
    if (kind == of.RK_PCREL_LO12_I) { ret R_RISCV_PCREL_LO12_I; }
    if (kind == of.RK_PCREL_LO12_S) { ret R_RISCV_PCREL_LO12_S; }
    if (kind == of.RK_ABS32)        { ret R_RISCV_32; }
    ret 0;
}

var t_riscv_attrs: BuildAttributes;

test "mach.lang.target.of.elf.emit_object:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [17]u8;
    var k: usize = 0;
    for (k < 17) { text_bytes[k] = 0x90; k = k + 1; }
    var data_bytes: [3]u8;
    data_bytes[0] = 1; data_bytes[1] = 2; data_bytes[2] = 3;

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 17; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 3; secs[1].align = 8;
    secs[2].name = t_intern(?i, ".bss"); secs[2].kind = of.SK_BSS;
    secs[2].bytes = nil; secs[2].len = 64; secs[2].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 17; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "gvar"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 3; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "elf_size");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 2; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 3; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val shoff:     usize = bin.read_u64_le(buf.data, 0x28)::usize;
    val shentsize: usize = bin.read_u16_le(buf.data, 0x3A)::usize;
    val shnum:     usize = bin.read_u16_le(buf.data, 0x3C)::usize;
    if (shoff == 0 || shentsize == 0 || shnum == 0)   { ret 4; }
    if (shoff + shnum * shentsize != buf.len)         { ret 5; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:unresolved_symbol" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "elf_unres");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    fs.temp_close_and_remove(?tf);

    if (!R.is_err[R.Void, str](em))                                   { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "unresolved symbol")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:unmapped_reloc_kind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_ADDR32NB;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "elf_kind");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    fs.temp_close_and_remove(?tf);

    if (!R.is_err[R.Void, str](em))                               { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "addr32nb")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.reloc_kind_for:aarch64_page_lo12_reverse" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var kinds: [9]of.RelocKind;
    kinds[0] = of.RK_PAGE21;      kinds[1] = of.RK_ADD_LO12;
    kinds[2] = of.RK_LDST8_LO12;  kinds[3] = of.RK_LDST16_LO12;
    kinds[4] = of.RK_LDST32_LO12; kinds[5] = of.RK_LDST64_LO12;
    kinds[6] = of.RK_LDST128_LO12;
    kinds[7] = of.RK_GOT_PAGE21;  kinds[8] = of.RK_GOT_LO12;

    var expect: [9]u32;
    expect[0] = R_AARCH64_ADR_PREL_PG_HI21; expect[1] = R_AARCH64_ADD_ABS_LO12_NC;
    expect[2] = R_AARCH64_LDST8_ABS_LO12_NC; expect[3] = R_AARCH64_LDST16_ABS_LO12_NC;
    expect[4] = R_AARCH64_LDST32_ABS_LO12_NC; expect[5] = R_AARCH64_LDST64_ABS_LO12_NC;
    expect[6] = R_AARCH64_LDST128_ABS_LO12_NC;
    expect[7] = R_AARCH64_ADR_GOT_PAGE; expect[8] = R_AARCH64_LD64_GOT_LO12_NC;

    var n: usize = 0;
    for (n < 9) {
        val kr: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 183, expect[n]);
        if (R.is_err[of.RelocKind, str](kr))                { ret 1; }
        if (R.unwrap_ok[of.RelocKind, str](kr) != kinds[n]) { ret 1; }
        n = n + 1;
    }
    ret 0;
}

test "mach.lang.target.of.elf.reloc_kind_for:riscv_machine_keyed_reverse" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var types: [7]u32;
    types[0] = R_RISCV_64;           types[1] = R_RISCV_32_PCREL;
    types[2] = R_RISCV_CALL_PLT;     types[3] = R_RISCV_PCREL_HI20;
    types[4] = R_RISCV_PCREL_LO12_I; types[5] = R_RISCV_PCREL_LO12_S;

    types[6] = R_RISCV_GOT_HI20;

    var kinds: [7]of.RelocKind;
    kinds[0] = of.RK_ABS64;       kinds[1] = of.RK_PC32;
    kinds[2] = of.RK_PLT32;       kinds[3] = of.RK_PCREL_HI20;
    kinds[4] = of.RK_PCREL_LO12_I; kinds[5] = of.RK_PCREL_LO12_S;

    kinds[6] = of.RK_GOT_PCREL_HI20;

    var n: usize = 0;
    for (n < 7) {
        val kr: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, EM_RISCV, types[n]);
        if (R.is_err[of.RelocKind, str](kr))                { ret 1; }
        if (R.unwrap_ok[of.RelocKind, str](kr) != kinds[n]) { ret 1; }
        n = n + 1;
    }

    val xr: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_PC32);
    if (R.is_err[of.RelocKind, str](xr))                       { ret 1; }
    if (R.unwrap_ok[of.RelocKind, str](xr) != of.RK_PC32)      { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.reloc_kind_for:abs32_roundtrip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    if (t_x64_elf_reloc_type(of.RK_ABS32)   != R_X86_64_32) { ret 1; }
    if (t_riscv_elf_reloc_type(of.RK_ABS32) != R_RISCV_32)  { ret 1; }

    val xr: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_32);
    if (R.is_err[of.RelocKind, str](xr) || R.unwrap_ok[of.RelocKind, str](xr) != of.RK_ABS32) { ret 1; }
    val ar: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 183, R_AARCH64_ABS32);
    if (R.is_err[of.RelocKind, str](ar) || R.unwrap_ok[of.RelocKind, str](ar) != of.RK_ABS32) { ret 1; }
    val rr: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, EM_RISCV, R_RISCV_32);
    if (R.is_err[of.RelocKind, str](rr) || R.unwrap_ok[of.RelocKind, str](rr) != of.RK_ABS32) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.reloc_kind_for:gotpcrelx_reads_as_gotpcrel" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    if (R_X86_64_GOTPCRELX != 41 || R_X86_64_REX_GOTPCRELX != 42) { ret 1; }

    val plain: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_GOTPCREL);
    val x:     R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_GOTPCRELX);
    val rex:   R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_REX_GOTPCRELX);
    if (R.is_err[of.RelocKind, str](plain) || R.is_err[of.RelocKind, str](x)
        || R.is_err[of.RelocKind, str](rex)) { ret 1; }
    if (R.unwrap_ok[of.RelocKind, str](plain) != of.RK_GOTPCREL) { ret 1; }
    if (R.unwrap_ok[of.RelocKind, str](x)     != of.RK_GOTPCREL) { ret 1; }
    if (R.unwrap_ok[of.RelocKind, str](rex)   != of.RK_GOTPCREL) { ret 1; }

    if (t_x64_elf_reloc_type(of.RK_GOTPCREL) != R_X86_64_GOTPCREL) { ret 1; }

    val r41: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, EM_RISCV, 41);
    val r42: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, EM_RISCV, 42);
    if (R.is_ok[of.RelocKind, str](r41) || R.is_ok[of.RelocKind, str](r42)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:unknown_reloc_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "elf_ptype");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var rela_off: usize = 0;
    var sh: usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (bin.read_u32_le(buf.data, so + 4) == SHT_RELA) { rela_off = bin.read_u64_le(buf.data, so + 24)::usize; }
        sh = sh + 1;
    }
    if (rela_off == 0) { ret 1; }
    bin.write_u32_le(buf.data, rela_off + 8, 12);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!R.is_err[R.Void, str](pr))                                      { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "relocation type")) { ret 1; }
    if (out.sections != nil || out.section_count != 0 || out.section_cap != 0
        || out.symbols != nil || out.symbol_count != 0 || out.symbol_cap != 0
        || out.relocations != nil || out.reloc_count != 0 || out.reloc_cap != 0
        || out.attributes != nil || out.attributes_len != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:refuses_relocation_count_overflow" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "elf_reloc_ovf");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var rela_so: usize = 0;
    var sh: usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (bin.read_u32_le(buf.data, so + 4) == SHT_RELA) { rela_so = so; }
        sh = sh + 1;
    }
    if (rela_so == 0) { ret 1; }
    bin.write_u64_le(buf.data, rela_so + 32, 0xFFFFFFFFFFFFFFF0);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!R.is_err[R.Void, str](pr))                              { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "exceeds")) { ret 1; }
    ret 0;
}

