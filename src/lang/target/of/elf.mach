pub fun machine_for_arch(arch_id: u32) u16 {
    if (arch_id == isa.ARCH_X86_64)  { ret EM_X86_64; }
    if (arch_id == isa.ARCH_AARCH64) { ret EM_AARCH64; }
    if (arch_id == isa.ARCH_RISCV64) { ret EM_RISCV; }
    if (arch_id == isa.ARCH_RISCV32) { ret EM_RISCV; }
    ret 0;
}

