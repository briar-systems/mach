}

test "mach.lang.target.of.elf.parse_object:x86_64_unwind_section_admitted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var eh_bytes: [16]u8;
    k = 0;
    for (k < 16) { eh_bytes[k] = 0; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".eh_frame"); secs[1].kind = of.SK_RODATA;
    secs[1].bytes = ?eh_bytes[0]; secs[1].len = 16; secs[1].align = 8;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "qz_answer"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(1); relocs[0].offset = 8; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_unwind");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var eh_hdr: usize = 0;
    var found:  bool  = false;
    var sh: usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        val ty:    u32 = bin.read_u32_le(buf.data, so + 4);
        val flags: u64 = bin.read_u64_le(buf.data, so + 8);
        if (ty == SHT_PROGBITS && flags == SHF_ALLOC) { eh_hdr = so; found = true; }
        sh = sh + 1;
    }
    if (!found) { ret 1; }
    bin.write_u32_le(buf.data, eh_hdr + 4, SHT_X86_64_UNWIND);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    if (out.section_count != 2)  { ret 1; }

    var eh_idx: i32 = -1;
    var s: u32 = 0;
    for (s < out.section_count) {
        if (str_equals(bin.resolve_name(?i, out.sections[s].name), ".eh_frame")) { eh_idx = s::i32; }
        s = s + 1;
    }
    if (eh_idx < 0)                                     { ret 1; }
    if (out.sections[eh_idx::u32].kind != of.SK_RODATA)  { ret 1; }
    if (out.sections[eh_idx::u32].len != 16)             { ret 1; }
    if (out.sections[eh_idx::u32].bytes == nil)          { ret 1; }

    if (out.reloc_count != 1)                   { ret 1; }
    if (of.section_index(out.relocations[0].section) != eh_idx::u32) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:riscv_machine_roundtrip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_riscv_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_RISCV64, EM_RISCV::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x13; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "g"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 0; relocs[0].addend = 0;
    relocs[1].section = of.section_id(0); relocs[1].offset = 8; relocs[1].kind = of.RK_PCREL_HI20;
    relocs[1].sym = 0; relocs[1].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 2;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_rv");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u16_le(buf.data, 18) != EM_RISCV) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    if (out.reloc_count != 2)    { ret 1; }

    var saw_abs64: bool = false;
    var saw_hi20:  bool = false;
    var r: u32 = 0;
    for (r < out.reloc_count) {
        if (out.relocations[r].kind == of.RK_ABS64)      { saw_abs64 = true; }
        if (out.relocations[r].kind == of.RK_PCREL_HI20) { saw_hi20 = true; }
        r = r + 1;
    }
    if (!saw_abs64) { ret 1; }
    if (!saw_hi20)  { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf:embed_flag_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var asset: [17]u8;
    var plain: [17]u8;
    var k: usize = 0;
    for (k < 17) { asset[k] = (0x40 + k)::u8; plain[k] = (0x40 + k)::u8; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".rodata"); secs[0].kind = of.SK_RODATA;
    secs[0].bytes = ?asset[0]; secs[0].len = 17; secs[0].align = 8;
    secs[0].flags = of.SEC_FLAG_MERGEABLE;
    secs[1].name = t_intern(?i, ".rodata"); secs[1].kind = of.SK_RODATA;
    secs[1].bytes = ?plain[0]; secs[1].len = 17; secs[1].align = 8;
    secs[1].flags = 0;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "ASSET"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 17; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[1].name = t_intern(?i, "PLAIN"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 17; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = nil::*of.Relocation; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_embed");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var marked:   u32 = 0;
    var unmarked: u32 = 0;
    var si: u32 = 0;
    for (si < out.section_count) {
        if (out.sections[si].kind != of.SK_RODATA) { si = si + 1; cnt; }
        if ((out.sections[si].flags & of.SEC_FLAG_MERGEABLE) != 0) { marked = marked + 1; }
        or                                                     { unmarked = unmarked + 1; }
        si = si + 1;
    }
    if (marked != 1)   { ret 1; }
    if (unmarked != 1) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:truncated" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_trunc");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var ok_out: of.ObjectImage;
    if (R.is_err[R.Void, str](parse_object(?alloc, ?i, buf.data, buf.len, ?ok_out))) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, ELF_HEADER_SIZE, ?out);
    if (!R.is_err[R.Void, str](pr))                                    { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "out of bounds")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.write_build_attributes:riscv_arch_layout" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var attr: BuildAttributes;
    attr.section  = ".riscv.attributes";
    attr.sht      = SHT_RISCV_ATTRIBUTES;
    attr.vendor   = "riscv";

    var body: [10]u8;
    body[0] = 5;
    val archs: str = "rv64i2p0";
    var bi: u32 = 0;
    for (archs[bi::usize] != 0) { body[1 + bi] = archs[bi::usize]::u8; bi = bi + 1; }
    body[1 + bi] = 0;
    val body_len: u32 = bi + 2;

    val sz: usize = build_attributes_size(?attr, body_len);
    if (sz != 26) { ret 1; }

    val rb: R.Result[*u8, str] = A.zallocate[u8](?alloc, sz);
    if (R.is_err[*u8, str](rb)) { ret 1; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    write_build_attributes(buf, 0, ?attr, ?body[0], body_len);

    var bad: bool = false;
    if (buf[0] != ELF_ATTR_VERSION_A)      { bad = true; }
    if (bin.read_u32_le(buf, 1) != 25)     { bad = true; }
    val rv: R.Result[str, str] = bin.cstr_at(buf, sz, 5);
    if (R.is_err[str, str](rv))                          { bad = true; }
    or (!str_equals(R.unwrap_ok[str, str](rv), "riscv")) { bad = true; }
    if (buf[11]::u32 != ELF_ATTR_TAG_FILE) { bad = true; }
    if (bin.read_u32_le(buf, 12) != 15)    { bad = true; }
    if (buf[16]::u32 != 5)                 { bad = true; }
    val ra: R.Result[str, str] = bin.cstr_at(buf, sz, 17);
    if (R.is_err[str, str](ra))                             { bad = true; }
    or (!str_equals(R.unwrap_ok[str, str](ra), "rv64i2p0")) { bad = true; }

    A.deallocate[u8](?alloc, buf, sz);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:riscv_attributes_section" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    if (R.is_err[R.Void, str](register(?of_reg))) { ret 1; }

    t_riscv_attrs.section  = ".riscv.attributes";
    t_riscv_attrs.sht      = SHT_RISCV_ATTRIBUTES;
    t_riscv_attrs.vendor   = "riscv";

    var seam: isa.RelocSeam = t_seam(t_riscv_elf_reloc_type);
    isa.with_elf_attributes(?seam, ?t_riscv_attrs);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_RISCV64, EM_RISCV::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x13; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "g"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    var body: [16]u8;
    body[0] = 5;
    val archs: str = "rv64i2p0_m2p0";
    var bi: u32 = 0;
    for (archs[bi::usize] != 0) { body[1 + bi] = archs[bi::usize]::u8; bi = bi + 1; }
    body[1 + bi] = 0;
    img.attributes = ?body[0];
    img.attributes_len = bi + 2;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_attr");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var attr_off: usize = 0;
    var sh: usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (bin.read_u32_le(buf.data, so + 4) == SHT_RISCV_ATTRIBUTES) {
            attr_off = bin.read_u64_le(buf.data, so + 24)::usize;
        }
        sh = sh + 1;
    }
    if (attr_off == 0) { ret 1; }

    if (buf.data[attr_off] != ELF_ATTR_VERSION_A) { ret 1; }
    val ra: R.Result[str, str] = bin.cstr_at(buf.data, buf.len, attr_off + 17);
    if (R.is_err[str, str](ra)) { ret 1; }
    if (!str_equals(R.unwrap_ok[str, str](ra), "rv64i2p0_m2p0")) { ret 1; }
    if (R.is_err[R.Void, str](output.retain_bytes(?alloc, "elf-riscv-attributes.o", buf.data, buf.len))) { ret 9; }
    ret 0;
}

fun t_emit_dyn_one(alloc: *A.Allocator, itn: *intern.Interner, arch_id: u32, lay: *DynLayout) *u8 {
    var imports: [1]of.DynImport;
    imports[0].symbol = t_intern(itn, "getpid");
    imports[0].lib_index = of.DYNLIB_ANY;
    imports[0].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;            dyn.lib_count = 0;
    dyn.imports = ?imports[0]; dyn.import_count = 1;
    dyn.interp = t_intern(itn, "/lib/ld.so.1");
    dyn.base_relocs = nil;     dyn.base_reloc_count = 0;
    dyn.pie = false;

    var got: ImportAddressPlan;
    val planned: R.Result[plan.FilePlan, str] = plan.init(alloc, itn, "elf", plan.limit_64());
    if (R.is_err[plan.FilePlan, str](planned)) { ret nil; }
    var fp: plan.FilePlan = R.unwrap_ok[plan.FilePlan, str](planned);
    fin { plan.dnit(?fp); }
    if (R.is_err[R.Void, str](compute_dyn_layout(itn, ?fp, lay, ?dyn, ?got, 1, arch_id, 0x400000, 4096))) { ret nil; }
    if (R.is_err[usize, str](plan.seal(?fp))) { ret nil; }
    val total: usize = lay.rw_off + lay.rw_size;
    val rb: R.Result[*u8, str] = A.zallocate[u8](alloc, total);
    if (R.is_err[*u8, str](rb)) { ret nil; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var imp_str: [1]usize;
    var lib_str: [1]usize;
    if (R.is_err[R.Void, str](write_dyn_structures(itn, buf, ?fp, lay, ?dyn, ?got, 1, arch_id, ?imp_str[0], ?lib_str[0]))) {
        A.deallocate[u8](alloc, buf, total);
        ret nil;
    }
    ret buf;
}

fun t_dyn_has(buf: *u8, lay: *DynLayout, tag: u64, value: u64) bool {
    val count: usize = lay.dynamic_size / DYN_SIZE;
    var k: usize = 0;
    for (k < count) {
        val off: usize = lay.dynamic_off + k * DYN_SIZE;
        val t: u64 = bin.read_u64_le(buf, off);
        if (t == tag && bin.read_u64_le(buf, off + 8) == value) { ret true; }
        if (t == DT_NULL) { ret false; }
        k = k + 1;
    }
    ret false;
}

test "mach.lang.target.of.elf.write_plt_stub:eager_arch_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var lay: DynLayout;
    lay.plt_off   = 0;
    lay.plt_va    = 0x2000;
    lay.gotplt_va = 0x4000;

    val rb: R.Result[*u8, str] = A.zallocate[u8](?alloc, 64);
    if (R.is_err[*u8, str](rb)) { ret 1; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var bad: bool = false;

    write_plt_stub(buf, ?lay, 0, isa.ARCH_AARCH64);
    if (bin.read_u32_le(buf, 0)  != 0xD0000010) { bad = true; }
    if (bin.read_u32_le(buf, 4)  != 0xF9400E10) { bad = true; }
    if (bin.read_u32_le(buf, 8)  != 0xD61F0200) { bad = true; }
    if (bin.read_u32_le(buf, 12) != 0xD503201F) { bad = true; }

    write_plt_stub(buf, ?lay, 1, isa.ARCH_AARCH64);
    if (bin.read_u32_le(buf, 16 + 4) != 0xF9401210) { bad = true; }

    write_plt_stub(buf, ?lay, 0, isa.ARCH_RISCV64);
    if (bin.read_u32_le(buf, 0)  != 0x00002E17) { bad = true; }
    if (bin.read_u32_le(buf, 4)  != 0x018E3E03) { bad = true; }
    if (bin.read_u32_le(buf, 8)  != 0x000E0067) { bad = true; }
    if (bin.read_u32_le(buf, 12) != 0x00000013) { bad = true; }

    A.deallocate[u8](?alloc, buf, 64);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.write_plt_stub:x86_64_lazy_unchanged" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var lay: DynLayout;
    lay.plt_off   = 0;
    lay.plt_va    = 0x2000;
    lay.gotplt_va = 0x4000;

    val rb: R.Result[*u8, str] = A.zallocate[u8](?alloc, 64);
    if (R.is_err[*u8, str](rb)) { ret 1; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    write_plt_stub(buf, ?lay, 0, isa.ARCH_X86_64);
    var bad: bool = false;
    if (buf[16] != 0xFF || buf[17] != 0x25)        { bad = true; }
    if (bin.read_u32_le(buf, 18) != 0x2002)        { bad = true; }
    if (buf[22] != 0x68)                           { bad = true; }
    if (bin.read_u32_le(buf, 23) != 0)             { bad = true; }
    if (buf[27] != 0xE9)                           { bad = true; }
    if (bin.read_u32_le(buf, 28) != 0xFFFFFFE0)    { bad = true; }

    A.deallocate[u8](?alloc, buf, 64);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.write_dyn_structures:aarch64_bindnow" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var lay: DynLayout;
    val buf: *u8 = t_emit_dyn_one(?alloc, ?i, isa.ARCH_AARCH64, ?lay);
    if (buf == nil) { ret 1; }

    var bad: bool = false;
    val got3_off: usize = lay.gotplt_off + 3 * GOT_ENTRY_SIZE;
    val got3_va:  u64   = lay.gotplt_va + (3 * GOT_ENTRY_SIZE)::u64;

    if (bin.read_u64_le(buf, lay.gotplt_off) != lay.dynamic_va) { bad = true; }
    if (bin.read_u64_le(buf, got3_off) != 0)                    { bad = true; }

    val want_info: u64 = (1::u64 << 32) | R_AARCH64_JUMP_SLOT::u64;
    if (bin.read_u64_le(buf, lay.relaplt_off) != got3_va)          { bad = true; }
    if (bin.read_u64_le(buf, lay.relaplt_off + 8) != want_info)    { bad = true; }
    if (bin.read_u64_le(buf, lay.relaplt_off + 16) != 0)          { bad = true; }

    val adrp: u32 = arm64_adrp_word(A64_PLT_ADRP_X16, plt_stub_va(?lay, 0, isa.ARCH_AARCH64), got3_va);
    if (bin.read_u32_le(buf, lay.plt_off) != adrp)         { bad = true; }
    if (bin.read_u32_le(buf, lay.plt_off + 8) != A64_PLT_BR_X16) { bad = true; }

    if (!t_dyn_has(buf, ?lay, DT_FLAGS, DF_BIND_NOW)) { bad = true; }
    if (!t_dyn_has(buf, ?lay, DT_BIND_NOW, 0))        { bad = true; }

    A.deallocate[u8](?alloc, buf, lay.rw_off + lay.rw_size);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.write_dyn_structures:riscv64_jump_slot" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var lay: DynLayout;
    val buf: *u8 = t_emit_dyn_one(?alloc, ?i, isa.ARCH_RISCV64, ?lay);
    if (buf == nil) { ret 1; }

    var bad: bool = false;
    val got3_off: usize = lay.gotplt_off + 3 * GOT_ENTRY_SIZE;
    val got3_va:  u64   = lay.gotplt_va + (3 * GOT_ENTRY_SIZE)::u64;

    if (bin.read_u64_le(buf, got3_off) != 0) { bad = true; }

    val want_info: u64 = (1::u64 << 32) | R_RISCV_JUMP_SLOT::u64;
    if (bin.read_u64_le(buf, lay.relaplt_off) != got3_va)       { bad = true; }
    if (bin.read_u64_le(buf, lay.relaplt_off + 8) != want_info) { bad = true; }

    val stub_va: u64 = plt_stub_va(?lay, 0, isa.ARCH_RISCV64);
    val delta: i64 = (got3_va::i64) - (stub_va::i64);
    if (bin.read_u32_le(buf, lay.plt_off) != riscv_hi20_word(RV_PLT_AUIPC_T3, delta)) { bad = true; }
    if (bin.read_u32_le(buf, lay.plt_off + 8) != RV_PLT_JR_T3)                        { bad = true; }

    if (!t_dyn_has(buf, ?lay, DT_FLAGS, DF_BIND_NOW)) { bad = true; }
    if (!t_dyn_has(buf, ?lay, DT_BIND_NOW, 0))        { bad = true; }

    A.deallocate[u8](?alloc, buf, lay.rw_off + lay.rw_size);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.write_dyn_structures:x86_64_lazy_got" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var lay: DynLayout;
    val buf: *u8 = t_emit_dyn_one(?alloc, ?i, isa.ARCH_X86_64, ?lay);
    if (buf == nil) { ret 1; }

    var bad: bool = false;
    val got3_off: usize = lay.gotplt_off + 3 * GOT_ENTRY_SIZE;

    if (bin.read_u64_le(buf, got3_off) != plt_stub_va(?lay, 0, isa.ARCH_X86_64) + 6) { bad = true; }

    val want_info: u64 = (1::u64 << 32) | R_X86_64_JUMP_SLOT::u64;
    if (bin.read_u64_le(buf, lay.relaplt_off + 8) != want_info) { bad = true; }

    if (t_dyn_has(buf, ?lay, DT_BIND_NOW, 0))         { bad = true; }
    if (t_dyn_has(buf, ?lay, DT_FLAGS, DF_BIND_NOW))  { bad = true; }

    A.deallocate[u8](?alloc, buf, lay.rw_off + lay.rw_size);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.patch_plt_fixups:eager_call_sites" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var lay: DynLayout;
    lay.plt_va = 0x3000;

    var imports: [1]of.DynImport;
    imports[0].symbol = intern.STR_NIL;
    imports[0].lib_index = of.DYNLIB_ANY;
    imports[0].is_func = true;
    var dyn: of.DynamicInfo;
    dyn.libs = nil;            dyn.lib_count = 0;
    dyn.imports = ?imports[0]; dyn.import_count = 1;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x2000; segs[0].filesz = 0x100; segs[0].memsz = 0x100;
    segs[0].flags = 0; segs[0].bytes = nil;
    var seg_offsets: [1]usize;
    seg_offsets[0] = 0x100;

    var fx: [1]of.PltFixup;
    fx[0].seg_index = 0; fx[0].seg_offset = 0x10; fx[0].import_index = 0;
    fx[0].patch_vaddr = 0x2000; fx[0].addend = 0;

    val rb: R.Result[*u8, str] = A.zallocate[u8](?alloc, 0x200);
    if (R.is_err[*u8, str](rb)) { ret 1; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    var bad: bool = false;

    bin.write_u32_le(buf, 0x110, 0x94000000);
    val ar: R.Result[R.Void, str] = patch_plt_fixups(buf, ?lay, ?dyn, ?fx[0], 1, ?seg_offsets[0], ?segs[0], 1, 1, isa.ARCH_AARCH64);
    if (R.is_err[R.Void, str](ar))                 { bad = true; }
    if (bin.read_u32_le(buf, 0x110) != 0x94000400) { bad = true; }

    bin.write_u32_le(buf, 0x110, 0x00000097);
    bin.write_u32_le(buf, 0x114, 0x000080E7);
    val rr: R.Result[R.Void, str] = patch_plt_fixups(buf, ?lay, ?dyn, ?fx[0], 1, ?seg_offsets[0], ?segs[0], 1, 1, isa.ARCH_RISCV64);
    if (R.is_err[R.Void, str](rr))                   { bad = true; }
    if (bin.read_u32_le(buf, 0x110) != 0x00001097) { bad = true; }
    if (bin.read_u32_le(buf, 0x114) != 0x000080E7) { bad = true; }

    A.deallocate[u8](?alloc, buf, 0x200);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_pie_exec:static_pie_layout" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    var brs: [1]of.BaseReloc;
    brs[0].seg_index = 0; brs[0].seg_offset = 8; brs[0].target = 0x401000;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;            dyn.lib_count = 0;
    dyn.imports = nil;         dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = ?brs[0]; dyn.base_reloc_count = 1;
    dyn.pie = true;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_pie");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, 0x401000, ?dyn, nil::*of.Section, 0, nil::*of.SymtabEntry, 0, tpath::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;

    if (bin.read_u16_le(buf.data, 16) != ET_DYN) { bad = true; }

    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var dyn_foff: usize = 0;
    var have_interp: bool = false;
    var ph: usize = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        val pt: u32 = bin.read_u32_le(buf.data, po);
        if (pt == PT_DYNAMIC) { dyn_foff = bin.read_u64_le(buf.data, po + 8)::usize; }
        if (pt == PT_INTERP)  { have_interp = true; }
        ph = ph + 1;
    }
    if (have_interp)  { bad = true; }
    if (dyn_foff == 0) { bad = true; }

    var rela_va: u64 = 0;
    var relasz:  u64 = 0;
    var relaent: u64 = 0;
    var relacnt: u64 = 0;
    var d: usize = dyn_foff;
    var seen: u32 = 0;
    for (seen < 32) {
        val tag: u64 = bin.read_u64_le(buf.data, d);
        val v:   u64 = bin.read_u64_le(buf.data, d + 8);
        if (tag == DT_RELA)      { rela_va = v; }
        if (tag == DT_RELASZ)    { relasz  = v; }
        if (tag == DT_RELAENT)   { relaent = v; }
        if (tag == DT_RELACOUNT) { relacnt = v; }
        if (tag == DT_NULL) { seen = 32; } or { d = d + DYN_SIZE; seen = seen + 1; }
    }
    if (rela_va == 0)  { bad = true; }
    if (relasz != 24)  { bad = true; }
    if (relaent != 24) { bad = true; }
    if (relacnt != 1)  { bad = true; }

    var rela_off: usize = 0;
    ph = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, po) == PT_LOAD) {
            val pf:  u64 = bin.read_u64_le(buf.data, po + 8);
            val pv:  u64 = bin.read_u64_le(buf.data, po + 16);
            val psz: u64 = bin.read_u64_le(buf.data, po + 32);
            if (rela_va >= pv && rela_va < pv + psz) { rela_off = (pf + (rela_va - pv))::usize; }
        }
        ph = ph + 1;
    }
    if (rela_off == 0) { bad = true; }
    or {
        if (bin.read_u64_le(buf.data, rela_off) != 0x401008)                  { bad = true; }
        if (bin.read_u64_le(buf.data, rela_off + 8) != R_X86_64_RELATIVE::u64) { bad = true; }
        if (bin.read_u64_le(buf.data, rela_off + 16) != 0x401000)             { bad = true; }
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_shared:exports_and_soname" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    val add_r: R.Result[intern.StrId, str] = intern.intern(?i, "add_fn");
    val mul_r: R.Result[intern.StrId, str] = intern.intern(?i, "mul_fn");
    if (R.is_err[intern.StrId, str](add_r) || R.is_err[intern.StrId, str](mul_r)) { ret 1; }
    var exports: [2]of.ExportSym;
    exports[0].name = R.unwrap_ok[intern.StrId, str](add_r); exports[0].vaddr = 0x401000; exports[0].is_func = true;
    exports[1].name = R.unwrap_ok[intern.StrId, str](mul_r); exports[1].vaddr = 0x401008; exports[1].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;            dyn.lib_count = 0;
    dyn.imports = nil;         dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil;     dyn.base_reloc_count = 0;
    dyn.pie = true;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_shared");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val expected_soname: str = "libfixture.so";
    val name_r: R.Result[str, str] = host_path.join(?alloc, tf.directory, expected_soname);
    if (R.is_err[str, str](name_r)) { ret 1; }
    val tpath: str = R.unwrap_ok[str, str](name_r);
    fin { str_free(?alloc, tpath); }

    val em: R.Result[R.Void, str] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 2, ?dyn, nil::*of.Section, 0, nil::*of.SymtabEntry, 0, tpath::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;

    if (bin.read_u16_le(buf.data, 16) != ET_DYN) { bad = true; }
    if (bin.read_u64_le(buf.data, 24) != 0)      { bad = true; }

    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var dyn_foff: usize = 0;
    var have_interp: bool = false;
    var gnu_stack_flags: u32 = 0;
    var have_gnu_stack: bool = false;
    var ph: usize = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        val pt: u32 = bin.read_u32_le(buf.data, po);
        if (pt == PT_DYNAMIC)   { dyn_foff = bin.read_u64_le(buf.data, po + 8)::usize; }
        if (pt == PT_INTERP)    { have_interp = true; }
        if (pt == PT_GNU_STACK) { have_gnu_stack = true; gnu_stack_flags = bin.read_u32_le(buf.data, po + 4); }
        ph = ph + 1;
    }
    if (have_interp)     { bad = true; }
    if (dyn_foff == 0)   { bad = true; }
    if (!have_gnu_stack) { bad = true; }
    if (gnu_stack_flags != (PF_R | PF_W)) { bad = true; }

    var soname_off: u64 = 0xFFFFFFFFFFFFFFFF;
    var strtab_va:  u64 = 0;
    var symtab_va:  u64 = 0;
    var have_hash:  bool = false;
    var syment:     u64 = 0;
    var d: usize = dyn_foff;
    var seen: u32 = 0;
    for (seen < 32) {
        val tag: u64 = bin.read_u64_le(buf.data, d);
        val v:   u64 = bin.read_u64_le(buf.data, d + 8);
        if (tag == DT_SONAME) { soname_off = v; }
        if (tag == DT_STRTAB) { strtab_va = v; }
        if (tag == DT_SYMTAB) { symtab_va = v; }
        if (tag == DT_HASH)   { have_hash = true; }
        if (tag == DT_SYMENT) { syment = v; }
        if (tag == DT_NULL) { seen = 32; } or { d = d + DYN_SIZE; seen = seen + 1; }
    }
    if (soname_off == 0xFFFFFFFFFFFFFFFF) { bad = true; }
    if (strtab_va == 0) { bad = true; }
    if (symtab_va == 0) { bad = true; }
    if (!have_hash)     { bad = true; }
    if (syment != 24)   { bad = true; }

    var strtab_off: usize = 0;
    var symtab_off: usize = 0;
    ph = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, po) == PT_LOAD) {
            val pf:  u64 = bin.read_u64_le(buf.data, po + 8);
            val pv:  u64 = bin.read_u64_le(buf.data, po + 16);
            val psz: u64 = bin.read_u64_le(buf.data, po + 32);
            if (strtab_va >= pv && strtab_va < pv + psz) { strtab_off = (pf + (strtab_va - pv))::usize; }
            if (symtab_va >= pv && symtab_va < pv + psz) { symtab_off = (pf + (symtab_va - pv))::usize; }
        }
        ph = ph + 1;
    }
    if (strtab_off == 0 || symtab_off == 0) { bad = true; }
    or {
        val sn: str = ((buf.data::usize + strtab_off + soname_off::usize)::*u8)::str;
        if (!str_equals(sn, expected_soname)) { bad = true; }

        val s1: usize = symtab_off + SYM_SIZE;
        val s2: usize = symtab_off + 2 * SYM_SIZE;
        if (buf.data[s1 + 4] != ((STB_GLOBAL << 4) | STT_FUNC)) { bad = true; }
        if (bin.read_u16_le(buf.data, s1 + 6) == 0)             { bad = true; }
        if (bin.read_u64_le(buf.data, s1 + 8) != 0x401000)      { bad = true; }
        if (bin.read_u64_le(buf.data, s2 + 8) != 0x401008)      { bad = true; }

        val n1_off: u64 = bin.read_u32_le(buf.data, s1)::u64;
        val n1: str = ((buf.data::usize + strtab_off + n1_off::usize)::*u8)::str;
        if (!str_equals(n1, "add_fn")) { bad = true; }
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_pie_exec:relro_splits_rodata_from_rel_ro" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text:   [16]u8;
    var rodata: [16]u8;
    var data:   [16]u8;
    var relro:  [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; rodata[k] = 0; data[k] = 0; relro[k] = 0; k = k + 1; }
    var segs: [4]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];
    segs[1].vaddr = 0x402000; segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = ?rodata[0];
    segs[2].vaddr = 0x403000; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE; segs[2].bytes = ?data[0];
    segs[3].vaddr = 0x404000; segs[3].filesz = 16; segs[3].memsz = 16;
    segs[3].flags = of.SEG_FLAG_READ; segs[3].bytes = ?relro[0];

    var brs: [2]of.BaseReloc;
    brs[0].seg_index = 2; brs[0].seg_offset = 8; brs[0].target = 0x401000;
    brs[1].seg_index = 3; brs[1].seg_offset = 8; brs[1].target = 0x401000;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;            dyn.lib_count = 0;
    dyn.imports = nil;         dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = ?brs[0]; dyn.base_reloc_count = 2;
    dyn.pie = true;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_relro");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 4, 4096, 0x401000, ?dyn, nil::*of.Section, 0, nil::*of.SymtabEntry, 0, tpath::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;

    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var relro_seen:        u32 = 0;
    var rodata_load_flags: u32 = 0;
    var data_load_flags:   u32 = 0;
    var relro_load_flags:  u32 = 0;
    var relro_vaddr:       u64 = 0;
    var ph: usize = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        val pt:     u32 = bin.read_u32_le(buf.data, po);
        val pflags: u32 = bin.read_u32_le(buf.data, po + 4);
        val pvaddr: u64 = bin.read_u64_le(buf.data, po + 16);
        if (pt == PT_GNU_RELRO) {
            relro_seen = relro_seen + 1;
            val pfilesz: u64 = bin.read_u64_le(buf.data, po + 32);
            val pmemsz:  u64 = bin.read_u64_le(buf.data, po + 40);
            relro_vaddr = pvaddr;
            if (pflags != PF_R)            { bad = true; }
            if (pvaddr != 0x404000)        { bad = true; }
            if (pfilesz != 16) { bad = true; }
            if (pmemsz != 16)  { bad = true; }
        }
        if (pt == PT_LOAD && pvaddr == 0x402000) { rodata_load_flags = pflags; }
        if (pt == PT_LOAD && pvaddr == 0x403000) { data_load_flags = pflags; }
        if (pt == PT_LOAD && pvaddr == 0x404000) { relro_load_flags = pflags; }
        ph = ph + 1;
    }
    if (relro_seen != 1)                    { bad = true; }
    if (rodata_load_flags != PF_R)          { bad = true; }
    if (relro_vaddr <= 0x402000)            { bad = true; }
    if (data_load_flags != (PF_R | PF_W))   { bad = true; }
    if (relro_load_flags != (PF_R | PF_W))  { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_pie_exec:page_align_congruence_64k" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_AARCH64, EM_AARCH64::u32, nil);

    var text:   [16]u8;
    var rodata: [16]u8;
    var relro:  [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; rodata[k] = 0; relro[k] = 0; k = k + 1; }
    var segs: [3]of.LoadSegment;
    segs[0].vaddr = 0x410000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];
    segs[1].vaddr = 0x420000; segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = ?rodata[0];
    segs[2].vaddr = 0x430000; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ; segs[2].bytes = ?relro[0];

    var brs: [1]of.BaseReloc;
    brs[0].seg_index = 2; brs[0].seg_offset = 8; brs[0].target = 0x410000;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;            dyn.lib_count = 0;
    dyn.imports = nil;         dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = ?brs[0]; dyn.base_reloc_count = 1;
    dyn.pie = true;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_align");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 3, 65536, 0x410000, ?dyn, nil::*of.Section, 0, nil::*of.SymtabEntry, 0, tpath::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;
    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var loads: u32 = 0;
    var ph: usize = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, po) == PT_LOAD) {
            val poff:  u64 = bin.read_u64_le(buf.data, po + 8);
            val pvad:  u64 = bin.read_u64_le(buf.data, po + 16);
            val palgn: u64 = bin.read_u64_le(buf.data, po + 48);
            loads = loads + 1;
            if (palgn != 65536)                     { bad = true; }
            if ((poff & 0xFFFF) != (pvad & 0xFFFF)) { bad = true; }
        }
        ph = ph + 1;
    }
    if (loads == 0) { bad = true; }
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.header_fits_reserved_page:one_page_threshold" {
    var bad: bool = false;
    var l64: ElfLayout = elf64_layout();
    if (!header_fits_reserved_page(?l64, 1, 4096))  { bad = true; }
    if (!header_fits_reserved_page(?l64, 71, 4096)) { bad = true; }
    if (header_fits_reserved_page(?l64, 72, 4096))  { bad = true; }
    if (!header_fits_reserved_page(?l64, 72, 65536)) { bad = true; }
    var l32: ElfLayout = elf32_layout();
    if (!header_fits_reserved_page(?l32, 124, 4096)) { bad = true; }
    if (header_fits_reserved_page(?l32, 125, 4096))  { bad = true; }
    if (bad) { ret 1; }
    ret 0;
}

