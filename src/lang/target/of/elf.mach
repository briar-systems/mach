test "mach.lang.target.of.elf.parse_object:x86_64_unwind_section_admitted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: err[fail.Fail] = register(?of_reg);
    if (sel rr.err) { ret 1; }

    var seam:   isa.RelocSeam   = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0x90;
        k             = k + 1;
    }

    var eh_bytes: [16]u8;
    k = 0;
    for (k < 16) {
        eh_bytes[k] = 0;
        k           = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = t_intern(?i, ".eh_frame");
    secs[1].kind  = of.SK_RODATA;
    secs[1].bytes = ?eh_bytes[0];
    secs[1].len   = 16;
    secs[1].align = 8;

    var syms: [1]of.Symbol;
    syms[0].name    = t_intern(?i, "qz_answer");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(1);
    relocs[0].offset  = 8;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 0;
    relocs[0].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_unwind");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var eh_hdr:      usize = 0;
    var found:       bool  = false;
    var sh:          usize = 0;
    for (sh < e_shnum) {
        val so:    usize = e_shoff + sh * e_shentsize;
        val ty:    u32   = bin.read_u32_le(buf.data, so + 4);
        val flags: u64   = bin.read_u64_le(buf.data, so + 8);
        if (ty == SHT_PROGBITS && flags == SHF_ALLOC) {
            eh_hdr = so;
            found  = true;
        }
        sh = sh + 1;
    }
    if (!found) { ret 1; }
    bin.write_u32_le(buf.data, eh_hdr + 4, SHT_X86_64_UNWIND);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)             { ret 1; }
    if (out.section_count != 2) { ret 1; }

    var eh_idx: i32 = -1;
    var s:      u32 = 0;
    for (s < out.section_count) {
        if (str_equals(bin.resolve_name(?i, out.sections[s].name), ".eh_frame")) { eh_idx = s::i32; }
        s = s + 1;
    }
    if (eh_idx < 0)                                     { ret 1; }
    if (out.sections[eh_idx::u32].kind != of.SK_RODATA) { ret 1; }
    if (out.sections[eh_idx::u32].len != 16)            { ret 1; }
    if (out.sections[eh_idx::u32].bytes == nil)         { ret 1; }

    if (out.reloc_count != 1)                                        { ret 1; }
    if (of.section_index(out.relocations[0].section) != eh_idx::u32) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:riscv_machine_roundtrip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: err[fail.Fail] = register(?of_reg);
    if (sel rr.err) { ret 1; }

    var seam:   isa.RelocSeam   = t_seam(t_riscv_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_RISCV64, EM_RISCV::u32, ?seam);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0x13;
        k             = k + 1;
    }

    var secs: [1]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name    = t_intern(?i, "g");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [2]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_ABS64;
    relocs[0].sym     = 0;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 8;
    relocs[1].kind    = of.RK_PCREL_HI20;
    relocs[1].sym     = 0;
    relocs[1].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 2;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_rv");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    if (bin.read_u16_le(buf.data, 18) != EM_RISCV) { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err)           { ret 1; }
    if (out.reloc_count != 2) { ret 1; }

    var saw_abs64: bool = false;
    var saw_hi20:  bool = false;
    var r:         u32  = 0;
    for (r < out.reloc_count) {
        if (out.relocations[r].kind == of.RK_ABS64)      { saw_abs64 = true; }
        if (out.relocations[r].kind == of.RK_PCREL_HI20) { saw_hi20 = true; }
        r = r + 1;
    }
    if (!saw_abs64) { ret 1; }
    if (!saw_hi20)  { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf:embed_flag_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var seam:   isa.RelocSeam   = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var asset: [17]u8;
    var plain: [17]u8;
    var k:     usize = 0;
    for (k < 17) {
        asset[k] = (0x40 + k)::u8;
        plain[k] = (0x40 + k)::u8;
        k        = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = t_intern(?i, ".rodata");
    secs[0].kind  = of.SK_RODATA;
    secs[0].bytes = ?asset[0];
    secs[0].len   = 17;
    secs[0].align = 8;
    secs[0].flags = of.SEC_FLAG_MERGEABLE;
    secs[1].name  = t_intern(?i, ".rodata");
    secs[1].kind  = of.SK_RODATA;
    secs[1].bytes = ?plain[0];
    secs[1].len   = 17;
    secs[1].align = 8;
    secs[1].flags = 0;

    var syms: [2]of.Symbol;
    syms[0].name    = t_intern(?i, "ASSET");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 17;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[1].name    = t_intern(?i, "PLAIN");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 17;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = nil::*of.Relocation;
    img.reloc_count   = 0;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_embed");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    var marked:   u32 = 0;
    var unmarked: u32 = 0;
    var si:       u32 = 0;
    for (si < out.section_count) {
        if (out.sections[si].kind != of.SK_RODATA) {
            si = si + 1;
            cnt;
        }
        if ((out.sections[si].flags & of.SEC_FLAG_MERGEABLE) != 0) { marked = marked + 1; }
        or                                                         { unmarked = unmarked + 1; }
        si = si + 1;
    }
    if (marked != 1)   { ret 1; }
    if (unmarked != 1) { ret 1; }
    ret 0;
}

