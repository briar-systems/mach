test "mach.lang.target.of.elf.reloc_kind_for:aarch64_page_lo12_reverse" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var kinds: [9]of.RelocKind;
    kinds[0] = of.RK_PAGE21;
    kinds[1] = of.RK_ADD_LO12;
    kinds[2] = of.RK_LDST8_LO12;
    kinds[3] = of.RK_LDST16_LO12;
    kinds[4] = of.RK_LDST32_LO12;
    kinds[5] = of.RK_LDST64_LO12;
    kinds[6] = of.RK_LDST128_LO12;
    kinds[7] = of.RK_GOT_PAGE21;
    kinds[8] = of.RK_GOT_LO12;

    var expect: [9]u32;
    expect[0] = R_AARCH64_ADR_PREL_PG_HI21;
    expect[1] = R_AARCH64_ADD_ABS_LO12_NC;
    expect[2] = R_AARCH64_LDST8_ABS_LO12_NC;
    expect[3] = R_AARCH64_LDST16_ABS_LO12_NC;
    expect[4] = R_AARCH64_LDST32_ABS_LO12_NC;
    expect[5] = R_AARCH64_LDST64_ABS_LO12_NC;
    expect[6] = R_AARCH64_LDST128_ABS_LO12_NC;
    expect[7] = R_AARCH64_ADR_GOT_PAGE;
    expect[8] = R_AARCH64_LD64_GOT_LO12_NC;

    var n: usize = 0;
    for (n < 9) {
        val kr: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 183, expect[n]);
        if (sel kr.err)        { ret 1; }
        if (kr.ok != kinds[n]) { ret 1; }
        n = n + 1;
    }
    ret 0;
}

test "mach.lang.target.of.elf.reloc_kind_for:riscv_machine_keyed_reverse" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var types: [7]u32;
    types[0] = R_RISCV_64;
    types[1] = R_RISCV_32_PCREL;
    types[2] = R_RISCV_CALL_PLT;
    types[3] = R_RISCV_PCREL_HI20;
    types[4] = R_RISCV_PCREL_LO12_I;
    types[5] = R_RISCV_PCREL_LO12_S;

    types[6] = R_RISCV_GOT_HI20;

    var kinds: [7]of.RelocKind;
    kinds[0] = of.RK_ABS64;
    kinds[1] = of.RK_PC32;
    kinds[2] = of.RK_PLT32;
    kinds[3] = of.RK_PCREL_HI20;
    kinds[4] = of.RK_PCREL_LO12_I;
    kinds[5] = of.RK_PCREL_LO12_S;

    kinds[6] = of.RK_GOT_PCREL_HI20;

    var n: usize = 0;
    for (n < 7) {
        val kr: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, EM_RISCV, types[n]);
        if (sel kr.err)        { ret 1; }
        if (kr.ok != kinds[n]) { ret 1; }
        n = n + 1;
    }

    val xr: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_PC32);
    if (sel xr.err)          { ret 1; }
    if (xr.ok != of.RK_PC32) { ret 1; }
    ret 0;
}

# tests: the declared ELF type, or zero for an absent one
fun reloc_type_or_zero(t: opt[u32]) u32 {
    if (sel t.none) { ret 0; }
    ret t.some;
}

test "mach.lang.target.of.elf.reloc_kind_for:abs32_roundtrip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    if (reloc_type_or_zero(t_x64_elf_reloc_type(of.RK_ABS32)) != R_X86_64_32)  { ret 1; }
    if (reloc_type_or_zero(t_riscv_elf_reloc_type(of.RK_ABS32)) != R_RISCV_32) { ret 1; }

    val xr: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_32);
    if (sel xr.err)           { ret 1; }
    if (xr.ok != of.RK_ABS32) { ret 1; }
    val ar: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 183, R_AARCH64_ABS32);
    if (sel ar.err)           { ret 1; }
    if (ar.ok != of.RK_ABS32) { ret 1; }
    val rr: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, EM_RISCV, R_RISCV_32);
    if (sel rr.err)           { ret 1; }
    if (rr.ok != of.RK_ABS32) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.reloc_kind_for:gotpcrelx_reads_as_gotpcrel" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    if (R_X86_64_GOTPCRELX != 41 || R_X86_64_REX_GOTPCRELX != 42) { ret 1; }

    val plain: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_GOTPCREL);
    val x:     res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_GOTPCRELX);
    val rex:   res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, 62, R_X86_64_REX_GOTPCRELX);
    if (sel plain.err)              { ret 1; }
    if (sel x.err)                  { ret 1; }
    if (sel rex.err)                { ret 1; }
    if (plain.ok != of.RK_GOTPCREL) { ret 1; }
    if (x.ok != of.RK_GOTPCREL)     { ret 1; }
    if (rex.ok != of.RK_GOTPCREL)   { ret 1; }

    if (reloc_type_or_zero(t_x64_elf_reloc_type(of.RK_GOTPCREL)) != R_X86_64_GOTPCREL) { ret 1; }

    val r41: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, EM_RISCV, 41);
    val r42: res[of.RelocKind, fail.Fail] = reloc_kind_for(?i, ?alloc, EM_RISCV, 42);
    if (sel r41.ok) { ret 1; }
    if (sel r42.ok) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:unknown_reloc_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: err[fail.Fail] = register(?of_reg);
    if (sel rr.err) { ret 1; }

    var seam:   isa.RelocSeam   = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0x90;
        k             = k + 1;
    }

    var secs: [1]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name    = t_intern(?i, "main");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PC32;
    relocs[0].sym     = 0;
    relocs[0].addend  = 0;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_ptype");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var rela_off:    usize = 0;
    var sh:          usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (bin.read_u32_le(buf.data, so + 4) == SHT_RELA) { rela_off = bin.read_u64_le(buf.data, so + 24)::usize; }
        sh = sh + 1;
    }
    if (rela_off == 0) { ret 1; }
    bin.write_u32_le(buf.data, rela_off + 8, 12);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!sel pr.err)                                             { ret 1; }
    if (!str_contains(fail.describe(pr.err), "relocation type")) { ret 1; }
    if (out.sections != nil || out.section_count != 0 || out.section_cap != 0
        || out.symbols != nil || out.symbol_count != 0 || out.symbol_cap != 0
        || out.relocations != nil || out.reloc_count != 0 || out.reloc_cap != 0
        || out.attributes != nil || out.attributes_len != 0) { ret 1; }
    ret 0;
}

