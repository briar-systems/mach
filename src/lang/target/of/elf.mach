# the row of an instruction set ELF covers, nil for one it does not
fun row_for(arch_id: u32) *IsaRow {
    var i: u32 = 0;
    for (i < 4) {
        if (COVERS_ISAS[i] == arch_id) { ret ?ISAS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the first row an e_machine names, nil for a machine ELF covers no instruction set with
fun row_for_machine(machine: u16) *IsaRow {
    var i: u32 = 0;
    for (i < 4) {
        if (ISAS[i].machine == machine) { ret ?ISAS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun isa_record(arch_id: u32) *target_of.IsaRecord {
    val row: *IsaRow = row_for(arch_id);
    if (row == nil) { ret nil; }
    ret ?row.record;
}

fun object_matches(bytes: *u8, len: usize, arch_id: u32) bool {
    if (bytes == nil || len < 20 || bytes[0] != 0x7F || bytes[1] != 0x45 || bytes[2] != 0x4C || bytes[3] != 0x46) { ret false; }
    val want: u16 = machine_for_arch(arch_id);
    ret want != 0 && bin.read_u16_le(bytes, 18) == want;
}

fun shared_names(path: *u8) bool {
    if (path == nil) { ret false; }
    ret target_of.path_has_suffix(path, ".so", false) || str_contains(path::str, ".so.");
}

# lib<name>.so, then lib<name>.so.6 down to lib<name>.so.0
fun shared_candidate(dir: *u8, name: *u8, index: u32, buf: *u8, cap: usize) bool {
    if (index == 0) {
        var bare: [3]str = [3]str{"lib", name::str, ".so"};
        ret target_of.path_write(buf, cap, dir, ?bare[0], 3);
    }
    if (index > 7) { ret false; }
    var versioned: [4]str = [4]str{"lib", name::str, ".so.", target_of.digit_text(7 - index)};
    ret target_of.path_write(buf, cap, dir, ?versioned[0], 4);
}

# an ELF shared object for the instruction set, named by its DT_SONAME or, with
# none, by its file name
fun shared_identity(bytes: *u8, len: usize, arch_id: u32, path: *u8, out: *u8, cap: usize) bool {
    val want: u16 = machine_for_arch(arch_id);
    if (want == 0 || len < 64 || bytes[0] != 0x7F || bytes[1] != 0x45 || bytes[2] != 0x4C
        || bytes[3] != 0x46 || bytes[4] != 2 || bytes[5] != 1 || bytes[6] != 1
        || bin.read_u16_le(bytes, 16) != ET_DYN || bin.read_u16_le(bytes, 18) != want) {
        ret false;
    }
    if (!soname_read(bytes, len, out, cap)) {
        val base: str   = types_path.filename(path::str);
        val bl:   usize = str_len(base);
        out[0] = 0;
        if (bl + 1 <= cap) {
            var i: usize = 0;
            for (i <= bl) {
                out[i] = base[i];
                i      = i + 1;
            }
        }
    }
    ret true;
}

fun soname_read(buf: *u8, len: usize, out: *u8, cap: usize) bool {
    if (len < 64) { ret false; }
    var lay:   ElfLayout                    = elf64_layout();
    val table: res[SectionTable, fail.Fail] = section_table(buf, len, ?lay);
    if (sel table.err) { ret false; }
    val e_shoff:     usize = table.ok.off;
    val e_shentsize: usize = table.ok.entsize;
    val e_shnum:     usize = table.ok.count::usize;
    if (e_shoff == 0 || e_shnum == 0) { ret false; }

    var dyn_off:    usize = 0;
    var dyn_size:   usize = 0;
    var dynstr_off: usize = 0;
    var sh:         usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (so + 64 > len) { ret false; }
        if (bin.read_u32_le(buf, so + 4) == SHT_DYNAMIC) {
            dyn_off  = bin.read_u64_le(buf, so + 24)::usize;
            dyn_size = bin.read_u64_le(buf, so + 32)::usize;
            val link: usize = bin.read_u32_le(buf, so + 40)::usize;
            if (link < e_shnum) {
                val lo: usize = e_shoff + link * e_shentsize;
                if (lo + 64 <= len) { dynstr_off = bin.read_u64_le(buf, lo + 24)::usize; }
            }
        }
        sh = sh + 1;
    }
    if (dyn_off == 0 || dynstr_off == 0) { ret false; }

    var d: usize = 0;
    for (d + 16 <= dyn_size) {
        val eo: usize = dyn_off + d;
        if (eo + 16 > len) { ret false; }
        val tag: u64 = bin.read_u64_le(buf, eo);
        if (tag == 0) { ret false; }
        if (tag == DT_SONAME) {
            val str_at: usize = dynstr_off + bin.read_u64_le(buf, eo + 8)::usize;
            var k:      usize = 0;
            for (str_at + k < len && buf[str_at + k] != 0 && k + 1 < cap) {
                out[k] = buf[str_at + k];
                k      = k + 1;
            }
            out[k] = 0;
            ret k > 0;
        }
        d = d + 16;
    }
    ret false;
}

val STATIC_SUFFIXES: [2]str = [2]str{"o", "a"};

val SHARED_NAMING: target_of.SharedNaming = target_of.SharedNaming{
    noun:      "an ELF shared object",
    loadable:  "ELF shared object",
    requires:  "an ELF target",
    prefix:    "lib",
    names:     shared_names,
    candidate: shared_candidate,
    identity:  shared_identity,
    absent:    target_of.ABSENT_REFUSED,
};

val INPUT_NAMING: target_of.InputNaming = target_of.InputNaming{
    library_prefix:      "lib",
    static_suffixes:     ?STATIC_SUFFIXES[0],
    static_suffix_count: 2,
    object_matches:      object_matches,
    shared:              ?SHARED_NAMING,
};

# a shared object, an executable the loader binds nothing in, or one it binds
# imports or relocates
fun image_emit(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    if (img.product == catalog_artifact.SHARED) { ret emit_shared(img, dst); }
    if (img.dynamic == nil)                     { ret emit_exec(img, dst); }
    ret emit_dyn_exec(img, dst);
}

# a dynamically linked executable keeps its dynamic structures in two segments
# of their own after the image: the read-only run the loader reads, from the
# interpreter path to the dynamic relocations, and the run it writes, the GOTs
# and the dynamic section
fun segment_tables(img: *target_of.LinkedImage, tables: *target_of.TableList) err[fail.Fail] {
    val dyn: *target_of.DynamicInfo = img.dynamic;
    if (img.product != catalog_artifact.EXECUTABLE || dyn == nil || dyn.pie) { ret err[fail.Fail].ok{}; }
    var elay: ElfLayout = layout_for(img.target);
    if (elay.class != ELFCLASS64 || !dyn_arch_supported(img.target.arch_id)) { ret err[fail.Fail].ok{}; }

    val planned_got: res[ImportAddressPlan, fail.Fail] = import_address_plan(img.alloc, dyn);
    if (sel planned_got.err) { ret err[fail.Fail].err{planned_got.err}; }
    var got: ImportAddressPlan = planned_got.ok;
    fin { import_address_plan_dnit(img.alloc, ?got); }
    val made: res[of_plan.FilePlan, fail.Fail] = of_plan.init(img.alloc, img.interner, "elf", limit(?elay));
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    var scratch: of_plan.FilePlan = made.ok;
    fin { of_plan.dnit(?scratch); }
    var lay:  DynLayout;
    val laid: err[fail.Fail] = compute_dyn_layout(img.interner, ?scratch, ?lay, dyn, ?got, target_of.func_import_count(dyn),
        img.target.arch_id, 0, img.page_size);
    if (sel laid.err) { ret laid; }
    val ro: err[fail.Fail] = target_of.table_add(tables, target_of.TableShape{name: ".interp", size: lay.ro_size, align: 8,
        placement: target_of.TABLE_OWN_SEGMENT, flags: target_of.SEG_FLAG_READ});
    if (sel ro.err) { ret ro; }
    ret target_of.table_add(tables, target_of.TableShape{name: ".got.plt", size: lay.rw_size, align: 8,
        placement: target_of.TABLE_OWN_SEGMENT, flags: target_of.SEG_FLAG_READ | target_of.SEG_FLAG_WRITE});
}

pub val VTABLE: target_of.OfVTable = target_of.OfVTable{
    id:                      target_of.ELF,
    fingerprint_tag:         1,
    name:                    mink_format.ELF.name,
    links_from_image:        true,
    debug_offset_kind:       target_of.RK_ABS32,
    object_suffix:           ".o",
    object_emit:             object_emit,
    parse_object:            parse_object,
    image_emit:              image_emit,
    writes_dynamic:          true,
    writes_shared:           true,
    segment_tables:          segment_tables,
    default_debug:           "dwarf",
    shared_input_ext:        ".so",
    import_address_prefix:   "",
    imports_through_got:     true,
    header_in_first_segment: false,
    maps_by_page:            true,
    carries_stack_size:      false,
    carries_record:          true,
    default_stack_reserve:   0,
    stub_shape:              stub_shape,
    unwind_shape:            unwind_shape,
    covers_isas:             ?COVERS_ISAS[0],
    covers_isa_count:        4,
    isa_record:              isa_record,
    inputs:                  ?INPUT_NAMING,
};

fun pf_flags_for(flags: u32) u32 {
    var f: u32 = 0;
    if ((flags & target_of.SEG_FLAG_READ) != 0)    { f = f | PF_R; }
    if ((flags & target_of.SEG_FLAG_WRITE) != 0)   { f = f | PF_W; }
    if ((flags & target_of.SEG_FLAG_EXECUTE) != 0) { f = f | PF_X; }
    if (f == 0)                                    { f = PF_R; }
    ret f;
}

fun highest_vaddr(segs: *target_of.LoadSegment, seg_count: u32) u64 {
    var hi: u64 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        val end: u64 = segs[li].vaddr + segs[li].memsz::u64;
        if (end > hi) { hi = end; }
        li = li + 1;
    }
    ret hi;
}

fun validate_class_segments(lay: *ElfLayout, segs: *target_of.LoadSegment, seg_count: u32, entry: u64) err[fail.Fail] {
    if (lay.addr_width == 8)     { ret err[fail.Fail].ok{}; }
    if (!class_fits(lay, entry)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "entry address exceeds the ELF32 address width")}; }
    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].memsz::u64 > 0xFFFFFFFF - segs[li].vaddr || segs[li].filesz > segs[li].memsz) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "load segment exceeds the ELF32 address width")};
        }
        li = li + 1;
    }
    ret err[fail.Fail].ok{};
}

fun debug_align(sec: *target_of.Section) usize {
    if (sec.align == 0) { ret 1; }
    ret sec.align::usize;
}

# `.eh_frame_hdr` and `.eh_frame` for the frame records a link keeps and the
# frame descriptions its foreign objects carry in ahead of them
fun unwind_shape(arch_id: u32, frames: *target_of.FrameUnwind, count: u32, foreign: *target_of.ForeignUnwind) res[target_of.UnwindShape, fail.Fail] {
    var shape: target_of.UnwindShape;
    val fo:    opt[cfi.FrameIsa] = cfi.frame_isa(arch_id);
    if (sel fo.none) { ret res[target_of.UnwindShape, fail.Fail].ok{shape}; }
    var fi: cfi.FrameIsa          = fo.some;
    val eh: res[usize, fail.Fail] = cfi.eh_frame_bound(?fi, frames, count);
    if (sel eh.err) { ret res[target_of.UnwindShape, fail.Fail].err{eh.err}; }
    shape.index  = target_of.TableShape{name: ".eh_frame_hdr", size: cfi.eh_frame_hdr_size(count + foreign.fde_count), align: 4, placement: target_of.TABLE_CODE_END};
    shape.frames = target_of.TableShape{name: ".eh_frame", size: foreign.frames_len + eh.ok, align: fi.ptr_size, placement: target_of.TABLE_CODE_END};
    ret res[target_of.UnwindShape, fail.Fail].ok{shape};
}

# fills the unwind tables the linker reserved in the code, trims their sections
# to what they hold and leaves in `hdr` where the search table lies, which a
# PT_GNU_EH_FRAME names; `hdr` is absent when the image carries no tables. the
# frame descriptions of the foreign objects lie first in `.eh_frame`, carried
# and relocated by the linker; this table's own cie and fdes follow them, and
# the search table covers both
fun fill_unwind(alloc: *A.Allocator, arch_id: u32, segs: *target_of.LoadSegment, seg_count: u32,
    funcs: *target_of.ExecFunction, func_count: u32, hdr: *cfi.UnwindRoom) err[fail.Fail] {
    var index:  cfi.UnwindRoom = cfi.unwind_room(segs, seg_count, target_of.SEC_FLAG_UNWIND_INDEX);
    var frames: cfi.UnwindRoom = cfi.unwind_room(segs, seg_count, target_of.SEC_FLAG_UNWIND_FRAMES);
    hdr.present = false;
    if (!index.present && !frames.present) { ret err[fail.Fail].ok{}; }
    if (!index.present || !frames.present) {
        ret err[fail.Fail].err{fail.message("the linker reserved only one of the two unwind tables")};
    }
    val fo: opt[cfi.FrameIsa] = cfi.frame_isa(arch_id);
    if (sel fo.none) { ret err[fail.Fail].err{fail.message("unwind tables reserved for an architecture cfi cannot describe")}; }
    var fi: cfi.FrameIsa = fo.some;

    var foreign:       *cfi.EhFn             = nil;
    var foreign_count: u32                   = 0;
    val scanned:       res[usize, fail.Fail] = cfi.eh_frame_scan(alloc, frames.bytes, frames.cap, frames.vaddr,
        fi.ptr_size, ?foreign, ?foreign_count);
    if (sel scanned.err) { ret err[fail.Fail].err{scanned.err}; }
    fin {
        if (foreign != nil) { A.deallocate[cfi.EhFn](alloc, foreign, foreign_count::usize); }
    }
    val base: usize = scanned.ok;

    var n:  u32                           = 0;
    val fr: res[*cfi.UnwindFn, fail.Fail] = cfi.unwind_functions(alloc, segs, seg_count, funcs, func_count, ?n);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val fns: *cfi.UnwindFn = fr.ok;
    fin {
        if (fns != nil) { A.deallocate[cfi.UnwindFn](alloc, fns, n::usize); }
    }
    var offs: *u32 = nil;
    if (n > 0) {
        val oa: res[*u32, A.Error] = A.zallocate[u32](alloc, n::usize);
        if (sel oa.err) { ret err[fail.Fail].err{fail.refused(oa.err)}; }
        offs = oa.ok;
    }
    fin {
        if (offs != nil) { A.deallocate[u32](alloc, offs, n::usize); }
    }

    val own_vaddr: u64                   = frames.vaddr + base::u64;
    val eh:        res[usize, fail.Fail] = cfi.write_eh_frame(?fi, (frames.bytes::usize + base)::*u8, frames.cap - base,
        own_vaddr, fns, n, offs);
    if (sel eh.err) { ret err[fail.Fail].err{eh.err}; }

    val rows_n: u32         = n + foreign_count;
    var rows:   *cfi.HdrRow = nil;
    if (rows_n > 0) {
        val ra: res[*cfi.HdrRow, A.Error] = A.allocate[cfi.HdrRow](alloc, rows_n::usize);
        if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
        rows = ra.ok;
    }
    fin {
        if (rows != nil) { A.deallocate[cfi.HdrRow](alloc, rows, rows_n::usize); }
    }
    var i: u32 = 0;
    for (i < n) {
        rows[i] = cfi.HdrRow{pc: fns[i].addr, fde: own_vaddr + offs[i]::u64};
        i       = i + 1;
    }
    i = 0;
    for (i < foreign_count) {
        rows[n + i] = cfi.HdrRow{pc: foreign[i].pc, fde: frames.vaddr + foreign[i].fde_off::u64};
        i           = i + 1;
    }
    val hw: err[fail.Fail] = cfi.write_eh_frame_hdr(index.bytes, index.cap, index.vaddr, frames.vaddr, rows, rows_n);
    if (sel hw.err) { ret hw; }
    cfi.unwind_room_trim(segs, ?frames, base + eh.ok);
    cfi.unwind_room_trim(segs, ?index, cfi.eh_frame_hdr_size(rows_n));
    @hdr    = index;
    hdr.cap = cfi.eh_frame_hdr_size(rows_n);
    ret err[fail.Fail].ok{};
}

fun write_eh_frame_phdr(buf: *u8, pos: usize, fp: *of_plan.FilePlan, seg_rows: *u32, segs: *target_of.LoadSegment,
    hdr: *cfi.UnwindRoom) usize {
    val off: usize = of_plan.offset(fp, seg_rows[hdr.seg]) + (hdr.vaddr - segs[hdr.seg].vaddr)::usize;
    ret write_phdr(buf, pos, PT_GNU_EH_FRAME, PF_R, off, hdr.vaddr, hdr.cap, hdr.cap, 4);
}

fun emit_exec(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    var b: ImageBuild;
    fin { image_build_dnit(?b); }
    val begun: err[fail.Fail] = image_begin(?b, img);
    if (sel begun.err) { ret begun; }
    val widths: err[fail.Fail] = validate_class_segments(?b.lay, img.segments, img.segment_count, img.entry);
    if (sel widths.err) { ret widths; }

    val segs:        *target_of.LoadSegment = img.segments;
    val seg_count:   u32                    = img.segment_count;
    val page_size:   u64                    = img.page_size;
    val map_headers: bool                   = img.options.mapped_by_loader;
    var attr:        *BuildAttributes       = attributes_for(img.target);
    if (img.options.attributes == nil || img.options.attributes_len == 0) { attr = nil; }

    var phdr_count: u32 = seg_count + 1;
    if (map_headers)      { phdr_count = phdr_count + 1; }
    if (b.eh_hdr.present) { phdr_count = phdr_count + 1; }
    var overflow: str = "";
    if (map_headers) { overflow = "static program headers exceed the one-page header reservation (too many load segments)"; }
    val prologue: err[fail.Fail] = image_prologue(?b, phdr_count, overflow);
    if (sel prologue.err) { ret prologue; }
    val fp: *of_plan.FilePlan = ?b.fp;

    var attr_row: u32   = of_plan.NO_ROW;
    var attr_sz:  usize = 0;
    var extra:    u32   = 0;
    if (attr != nil) {
        attr_sz = build_attributes_size(attr, img.options.attributes_len);
        val row: res[u32, fail.Fail] = of_plan.place(fp, "build attributes", target_of.no_section(), 1, attr_sz);
        if (sel row.err) { ret err[fail.Fail].err{row.err}; }
        attr_row = row.ok;
        extra    = 1;
    }

    # the header page is mapped only where the loader maps it, and the note's
    # address is in it
    val note_off:   usize = b.pro.note_off;
    var hdr_vaddr:  u64   = 0;
    var note_vaddr: u64   = 0;
    if (map_headers) {
        hdr_vaddr = img.entry & ~(page_size - 1);
        if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }
        note_vaddr = hdr_vaddr + note_off::u64;
    }
    val rows: res[*ShtAlloc, fail.Fail] = image_rows(?b, extra);
    if (sel rows.err) { ret err[fail.Fail].err{rows.err}; }
    fill_note_aux(?b.aux[b.sect_count], note_off, note_vaddr);
    if (attr != nil) {
        val row: *ShtAlloc = rows.ok;
        row.name    = attr.section;
        row.sh_type = attr.sht;
        row.flags   = 0;
        row.addr    = 0;
        row.off     = of_plan.offset(fp, attr_row);
        row.size    = attr_sz;
        row.link    = 0;
        row.info    = 0;
        row.align   = 1;
        row.entsize = 0;
    }

    val sealed: err[fail.Fail] = image_seal(?b, dst, ET_EXEC, img.entry);
    if (sel sealed.err) { ret sealed; }
    val buf: *u8 = b.buf;

    var phdr_pos: usize = b.phdr_offset;
    if (map_headers) {
        val header_end: usize = note_off + buildid.ELF_NOTE_SIZE;
        phdr_pos = write_phdr_at(buf, phdr_pos, ?b.lay, PT_LOAD, PF_R, 0, hdr_vaddr, hdr_vaddr,
            header_end::u64, header_end::u64, page_size);
    }
    buildid.write_elf_note_header(buf, note_off);
    var li: u32 = 0;
    for (li < seg_count) {
        phdr_pos = write_phdr_at(buf, phdr_pos, ?b.lay, PT_LOAD, pf_flags_for(segs[li].flags),
            of_plan.offset(fp, b.pro.seg_rows[li])::u64, segs[li].vaddr, segs[li].vaddr,
            segs[li].filesz::u64, segs[li].memsz::u64, page_size);
        li = li + 1;
    }
    phdr_pos = write_phdr_at(buf, phdr_pos, ?b.lay, PT_NOTE, PF_R, note_off::u64, note_vaddr, note_vaddr,
        buildid.ELF_NOTE_SIZE::u64, buildid.ELF_NOTE_SIZE::u64, buildid.ELF_NOTE_ALIGN::u64);
    if (b.eh_hdr.present) {
        val eh_off: usize = of_plan.offset(fp, b.pro.seg_rows[b.eh_hdr.seg]) + (b.eh_hdr.vaddr - segs[b.eh_hdr.seg].vaddr)::usize;
        phdr_pos = write_phdr_at(buf, phdr_pos, ?b.lay, PT_GNU_EH_FRAME, PF_R, eh_off::u64, b.eh_hdr.vaddr, b.eh_hdr.vaddr,
            b.eh_hdr.cap::u64, b.eh_hdr.cap::u64, 4);
    }

    if (attr_row != of_plan.NO_ROW) {
        val written: usize = write_build_attributes(buf, of_plan.offset(fp, attr_row), attr, img.options.attributes,
            img.options.attributes_len);
        val attr_closed: err[fail.Fail] = of_plan.close_size(fp, attr_row, written);
        if (sel attr_closed.err) { ret attr_closed; }
    }
    ret image_finish(?b, phdr_pos);
}

# the header page holds the header, the program headers and the build id note
fun header_fits_reserved_page(lay: *ElfLayout, phdr_count: u32, page_size: u64) bool {
    ret lay.ehdr_size + phdr_count::usize * lay.phdr_size + buildid.ELF_NOTE_SIZE <= page_size::usize;
}

# the note sits in the header page directly after the program headers, inside
# the first mapping, so a running image reads it from memory
fun place_note_row(fp: *of_plan.FilePlan) res[u32, fail.Fail] {
    ret of_plan.place(fp, "build id note", target_of.no_section(), buildid.ELF_NOTE_ALIGN, buildid.ELF_NOTE_SIZE);
}

fun fill_note_aux(entry: *ShtAlloc, note_off: usize, note_vaddr: u64) {
    entry.name    = buildid.ELF_NOTE_SECTION;
    entry.sh_type = SHT_NOTE;
    entry.flags   = SHF_ALLOC;
    entry.addr    = note_vaddr;
    entry.off     = note_off;
    entry.size    = buildid.ELF_NOTE_SIZE;
    entry.link    = 0;
    entry.info    = 0;
    entry.align   = buildid.ELF_NOTE_ALIGN;
    entry.entsize = 0;
}

# the build id hashes what the loader maps: every PT_LOAD file extent in table
# order, with the section-table header fields and the note payload as zero, so
# `-d` (which adds only unmapped bytes) leaves it unchanged. runs last, over the
# finished image, then fills the payload
fun seal_build_id(buf: *u8, total: usize, lay: *ElfLayout, note_off: usize) err[fail.Fail] {
    val w: usize = lay.addr_width::usize;
    if (note_off + buildid.ELF_NOTE_SIZE > total) { ret err[fail.Fail].err{fail.message("build id note lies outside the image")}; }
    val desc: usize = note_off + buildid.ELF_NOTE_HEADER;
    var k:    usize = 0;
    for (k < buildid.DIGEST_LEN) {
        if (buf[desc + k] != 0) { ret err[fail.Fail].err{fail.message("build id note payload was written before the image was sealed")}; }
        k = k + 1;
    }
    val shoff_at:   usize = 24 + 2 * w;
    val shnum_at:   usize = 24 + 3 * w + 12;
    val e_shoff:    u64   = read_addr(buf, shoff_at, lay);
    val e_shnum:    u16   = bin.read_u16_le(buf, shnum_at);
    val e_shstrndx: u16   = bin.read_u16_le(buf, shnum_at + 2);
    write_addr(buf, shoff_at, lay, 0);
    bin.write_u16_le(buf, shnum_at, 0);
    bin.write_u16_le(buf, shnum_at + 2, 0);
    var hashed:  err[fail.Fail] = err[fail.Fail].ok{};
    var st:      sha256.State   = sha256.init();
    val e_phoff: usize          = read_addr(buf, 24 + w, lay)::usize;
    val e_phnum: usize          = bin.read_u16_le(buf, 24 + 3 * w + 8)::usize;
    var i:       usize          = 0;
    for (i < e_phnum) {
        val ph: usize = e_phoff + i * lay.phdr_size;
        if (ph + lay.phdr_size > total) { hashed = err[fail.Fail].err{fail.message("program header table lies outside the image")}; }
        or (bin.read_u32_le(buf, ph) == PT_LOAD) {
            var p_offset: usize = 0;
            var p_filesz: usize = 0;
            if (lay.addr_width == 8) {
                p_offset = read_addr(buf, ph + 8, lay)::usize;
                p_filesz = read_addr(buf, ph + 32, lay)::usize;
            }
            or {
                p_offset = read_addr(buf, ph + 4, lay)::usize;
                p_filesz = read_addr(buf, ph + 16, lay)::usize;
            }
            if (p_offset > total || p_filesz > total - p_offset) { hashed = err[fail.Fail].err{fail.message("load segment lies outside the image")}; }
            or                                                   { buildid.digest_range(?st, buf, p_offset, p_filesz); }
        }
        i = i + 1;
    }
    write_addr(buf, shoff_at, lay, e_shoff);
    bin.write_u16_le(buf, shnum_at, e_shnum);
    bin.write_u16_le(buf, shnum_at + 2, e_shstrndx);
    if (sel hashed.err) { ret hashed; }
    sha256.final(?st, (buf::usize + desc)::*u8);
    ret err[fail.Fail].ok{};
}

fun header_segment_vaddr(first_seg_vaddr: u64, page_size: u64) u64 {
    ret (first_seg_vaddr & ~(page_size - 1)) - page_size;
}

rec ShtAlloc {
    name:    str;
    sh_type: u32;
    flags:   u64;
    addr:    u64;
    off:     usize;
    size:    usize;
    link:    u32;
    info:    u32;
    align:   usize;
    entsize: usize;
}

rec DebugSht {
    present:         bool;
    shdr_row:        u32;
    sht_count:       u32;
    shstrndx:        u32;
    debug_rows:      *u32;
    debug_name_rels: *usize;
    aux_name_rels:   *usize;
    symtab_row:      u32;
    strtab_row:      u32;
    symtab_name_rel: usize;
    strtab_name_rel: usize;
    shstr_row:       u32;
    shstr_sz:        usize;
    shstr_name_rel:  usize;
    numbering:       SectionNumbering;
}

fun debug_sht_plan(alloc: *A.Allocator, itn: *intern.Interner, lay: *ElfLayout, fp: *of_plan.FilePlan,
    debug: *target_of.Section, debug_count: u32,
    aux: *ShtAlloc, aux_count: u32, sb: *SymtabBuild) res[DebugSht, fail.Fail] {
    var p: DebugSht;
    p.present         = false;
    p.shdr_row        = of_plan.NO_ROW;
    p.sht_count       = 0;
    p.shstrndx        = 0;
    p.debug_rows      = nil;
    p.debug_name_rels = nil;
    p.aux_name_rels   = nil;
    p.symtab_row      = of_plan.NO_ROW;
    p.strtab_row      = of_plan.NO_ROW;
    p.symtab_name_rel = 0;
    p.strtab_name_rel = 0;
    p.shstr_row       = of_plan.NO_ROW;
    p.shstr_sz        = 0;
    p.shstr_name_rel  = 0;
    p.numbering       = SectionNumbering{e_shnum: 0, e_shstrndx: 0, null_size: 0, null_link: 0};
    val has_symtab: bool = sb.symtab_bytes != nil;
    if (debug_count == 0 && !has_symtab) { ret res[DebugSht, fail.Fail].ok{p}; }

    val oro: res[*u32, A.Error] = A.zallocate[u32](alloc, debug_count::usize);
    if (sel oro.err) { ret res[DebugSht, fail.Fail].err{fail.refused(oro.err)}; }
    p.debug_rows = oro.ok;
    val nro: res[*usize, A.Error] = A.zallocate[usize](alloc, debug_count::usize);
    if (sel nro.err) {
        debug_sht_free(alloc, ?p, debug_count, aux_count);
        ret res[DebugSht, fail.Fail].err{fail.refused(nro.err)};
    }
    p.debug_name_rels = nro.ok;
    if (aux_count > 0) {
        val aro: res[*usize, A.Error] = A.zallocate[usize](alloc, aux_count::usize);
        if (sel aro.err) {
            debug_sht_free(alloc, ?p, debug_count, aux_count);
            ret res[DebugSht, fail.Fail].err{fail.refused(aro.err)};
        }
        p.aux_name_rels = aro.ok;
    }

    var di: u32 = 0;
    for (di < debug_count) {
        val row: res[u32, fail.Fail] = of_plan.place(fp, "debug section", target_of.section_id(di), debug_align(?debug[di]), debug[di].len::usize);
        if (sel row.err) {
            debug_sht_free(alloc, ?p, debug_count, aux_count);
            ret res[DebugSht, fail.Fail].err{row.err};
        }
        p.debug_rows[di] = row.ok;
        di               = di + 1;
    }

    if (has_symtab) {
        val srow: res[u32, fail.Fail] = of_plan.place(fp, "symbol table", target_of.no_section(), 8, sb.symtab_size);
        if (sel srow.err) {
            debug_sht_free(alloc, ?p, debug_count, aux_count);
            ret res[DebugSht, fail.Fail].err{srow.err};
        }
        p.symtab_row = srow.ok;
        val trow: res[u32, fail.Fail] = of_plan.place(fp, "string table", target_of.no_section(), 1, sb.strtab_size);
        if (sel trow.err) {
            debug_sht_free(alloc, ?p, debug_count, aux_count);
            ret res[DebugSht, fail.Fail].err{trow.err};
        }
        p.strtab_row = trow.ok;
    }

    var sz: usize = 1;
    di = 0;
    for (di < debug_count) {
        p.debug_name_rels[di] = sz;
        sz                    = sz + str_len(bin.resolve_name(itn, debug[di].name)) + 1;
        di                    = di + 1;
    }
    var ai: u32 = 0;
    for (ai < aux_count) {
        p.aux_name_rels[ai] = sz;
        sz                  = sz + str_len(aux[ai].name) + 1;
        ai                  = ai + 1;
    }
    if (has_symtab) {
        p.symtab_name_rel = sz;
        sz                = sz + str_len(".symtab") + 1;
        p.strtab_name_rel = sz;
        sz                = sz + str_len(".strtab") + 1;
    }
    p.shstr_name_rel = sz;
    sz               = sz + str_len(".shstrtab") + 1;
    p.shstr_sz       = sz;
    val nrow: res[u32, fail.Fail] = of_plan.place(fp, "section name table", target_of.no_section(), 1, sz);
    if (sel nrow.err) {
        debug_sht_free(alloc, ?p, debug_count, aux_count);
        ret res[DebugSht, fail.Fail].err{nrow.err};
    }
    p.shstr_row = nrow.ok;

    p.sht_count = 1 + aux_count + debug_count + 1;
    if (has_symtab) { p.sht_count = p.sht_count + 2; }
    p.shstrndx = p.sht_count - 1;
    val hsize: res[usize, fail.Fail] = of_plan.table(fp, "section header table", p.sht_count::usize, lay.shdr_size);
    if (sel hsize.err) {
        debug_sht_free(alloc, ?p, debug_count, aux_count);
        ret res[DebugSht, fail.Fail].err{hsize.err};
    }
    val hrow: res[u32, fail.Fail] = of_plan.place(fp, "section header table", target_of.no_section(), lay.struct_align, hsize.ok);
    if (sel hrow.err) {
        debug_sht_free(alloc, ?p, debug_count, aux_count);
        ret res[DebugSht, fail.Fail].err{hrow.err};
    }
    p.shdr_row = hrow.ok;
    p.present  = true;
    ret res[DebugSht, fail.Fail].ok{p};
}

fun debug_sht_header(fp: *of_plan.FilePlan, p: *DebugSht, e_shoff: *u64, e_shnum: *u16, e_shstrndx: *u16) err[fail.Fail] {
    @e_shoff    = 0;
    @e_shnum    = 0;
    @e_shstrndx = 0;
    if (!p.present) { ret err[fail.Fail].ok{}; }
    @e_shoff = of_plan.offset(fp, p.shdr_row)::u64;
    val numbering: res[SectionNumbering, fail.Fail] = section_numbering(p.sht_count::usize, p.shstrndx::usize);
    if (sel numbering.err) { ret err[fail.Fail].err{numbering.err}; }
    p.numbering = numbering.ok;
    @e_shnum    = numbering.ok.e_shnum;
    @e_shstrndx = numbering.ok.e_shstrndx;
    ret err[fail.Fail].ok{};
}

fun debug_sht_write(buf: *u8, itn: *intern.Interner, lay: *ElfLayout, fp: *of_plan.FilePlan,
    debug: *target_of.Section, debug_count: u32,
    aux: *ShtAlloc, aux_count: u32, sb: *SymtabBuild, p: *DebugSht) err[fail.Fail] {
    if (!p.present) { ret err[fail.Fail].ok{}; }

    var di: u32 = 0;
    for (di < debug_count) {
        if (debug[di].bytes != nil && debug[di].len > 0) {
            memory.raw_copy((buf::usize + of_plan.offset(fp, p.debug_rows[di]))::ptr, debug[di].bytes::ptr, debug[di].len::usize);
        }
        di = di + 1;
    }

    if (sb.symtab_bytes != nil) {
        memory.raw_copy((buf::usize + of_plan.offset(fp, p.symtab_row))::ptr, sb.symtab_bytes::ptr, sb.symtab_size);
        memory.raw_copy((buf::usize + of_plan.offset(fp, p.strtab_row))::ptr, sb.strtab_bytes::ptr, sb.strtab_size);
    }

    val shstr_off: usize = of_plan.offset(fp, p.shstr_row);
    buf[shstr_off] = 0;
    var np: usize = 1;
    di = 0;
    for (di < debug_count) {
        if (np != p.debug_name_rels[di]) { ret err[fail.Fail].err{fail.message("section name table drifted from its plan")}; }
        np = np + bin.write_str(buf, shstr_off + np, bin.resolve_name(itn, debug[di].name));
        di = di + 1;
    }
    var ai: u32 = 0;
    for (ai < aux_count) {
        if (np != p.aux_name_rels[ai]) { ret err[fail.Fail].err{fail.message("section name table drifted from its plan")}; }
        np = np + bin.write_str(buf, shstr_off + np, aux[ai].name);
        ai = ai + 1;
    }
    if (sb.symtab_bytes != nil) {
        if (np != p.symtab_name_rel) { ret err[fail.Fail].err{fail.message("section name table drifted from its plan")}; }
        np = np + bin.write_str(buf, shstr_off + np, ".symtab");
        np = np + bin.write_str(buf, shstr_off + np, ".strtab");
    }
    if (np != p.shstr_name_rel) { ret err[fail.Fail].err{fail.message("section name table drifted from its plan")}; }
    np = np + bin.write_str(buf, shstr_off + np, ".shstrtab");
    val names_closed: err[fail.Fail] = of_plan.close_size(fp, p.shstr_row, np);
    if (sel names_closed.err) { ret names_closed; }

    var hp:    usize = write_null_shdr(buf, of_plan.offset(fp, p.shdr_row), lay, ?p.numbering);
    var shidx: u32   = 1;
    ai = 0;
    for (ai < aux_count) {
        hp = write_shdr(buf, hp, lay, p.aux_name_rels[ai]::u32, aux[ai].sh_type,
            aux[ai].flags, aux[ai].addr, aux[ai].off::u64, aux[ai].size::u64,
            aux[ai].link, aux[ai].info, aux[ai].align::u64, aux[ai].entsize::u64);
        shidx = shidx + 1;
        ai    = ai + 1;
    }
    di = 0;
    for (di < debug_count) {
        hp = write_shdr(buf, hp, lay, p.debug_name_rels[di]::u32, SHT_PROGBITS, 0, 0,
            of_plan.offset(fp, p.debug_rows[di])::u64, debug[di].len::u64, 0, 0, debug_align(?debug[di])::u64, 0);
        shidx = shidx + 1;
        di    = di + 1;
    }

    if (sb.symtab_bytes != nil) {
        val strtab_idx: u32 = shidx + 1;
        hp = write_shdr(buf, hp, lay, p.symtab_name_rel::u32, SHT_SYMTAB, 0, 0,
            of_plan.offset(fp, p.symtab_row)::u64, sb.symtab_size::u64, strtab_idx, sb.local_count,
            lay.struct_align::u64, lay.sym_size::u64);
        shidx = shidx + 1;

        hp = write_shdr(buf, hp, lay, p.strtab_name_rel::u32, SHT_STRTAB, 0, 0,
            of_plan.offset(fp, p.strtab_row)::u64, sb.strtab_size::u64, 0, 0, 1, 0);
        shidx = shidx + 1;
    }

    hp = write_shdr(buf, hp, lay, p.shstr_name_rel::u32, SHT_STRTAB, 0, 0,
        shstr_off::u64, p.shstr_sz::u64, 0, 0, 1, 0);
    ret of_plan.close(fp, p.shdr_row, hp);
}

fun debug_sht_free(alloc: *A.Allocator, p: *DebugSht, debug_count: u32, aux_count: u32) {
    if (p.debug_rows != nil)      { A.deallocate[u32](alloc, p.debug_rows, debug_count::usize); }
    if (p.debug_name_rels != nil) { A.deallocate[usize](alloc, p.debug_name_rels, debug_count::usize); }
    if (p.aux_name_rels != nil)   { A.deallocate[usize](alloc, p.aux_name_rels, aux_count::usize); }
    p.debug_rows      = nil;
    p.debug_name_rels = nil;
    p.aux_name_rels   = nil;
}

rec ImagePrologue {
    phdr_row: u32;
    note_off: usize;
    seg_rows: *u32;
}

# header, program headers, the build id note, the page pad, then one
# page-aligned row per segment
fun place_image_prologue(alloc: *A.Allocator, fp: *of_plan.FilePlan, lay: *ElfLayout, phdr_count: u32,
    page_size: u64, segs: *target_of.LoadSegment, seg_count: u32) res[ImagePrologue, fail.Fail] {
    var out: ImagePrologue;
    out.phdr_row = of_plan.NO_ROW;
    out.note_off = 0;
    out.seg_rows = nil;
    val header_r: res[u32, fail.Fail] = of_plan.place_at(fp, "elf header", target_of.no_section(), 0, lay.ehdr_size);
    if (sel header_r.err) { ret res[ImagePrologue, fail.Fail].err{header_r.err}; }
    val phdr_size: res[usize, fail.Fail] = of_plan.table(fp, "program headers", phdr_count::usize, lay.phdr_size);
    if (sel phdr_size.err) { ret res[ImagePrologue, fail.Fail].err{phdr_size.err}; }
    val phdr_r: res[u32, fail.Fail] = of_plan.place(fp, "program headers", target_of.no_section(), 1, phdr_size.ok);
    if (sel phdr_r.err) { ret res[ImagePrologue, fail.Fail].err{phdr_r.err}; }
    out.phdr_row = phdr_r.ok;
    val note_r: res[u32, fail.Fail] = place_note_row(fp);
    if (sel note_r.err) { ret res[ImagePrologue, fail.Fail].err{note_r.err}; }
    out.note_off = of_plan.offset(fp, note_r.ok);
    val padded: err[fail.Fail] = of_plan.pad(fp, "first page", page_size::usize);
    if (sel padded.err) { ret res[ImagePrologue, fail.Fail].err{padded.err}; }
    if (seg_count > 0) {
        val ro: res[*u32, A.Error] = A.zallocate[u32](alloc, seg_count::usize);
        if (sel ro.err) { ret res[ImagePrologue, fail.Fail].err{fail.message("seg-offset alloc failed")}; }
        out.seg_rows = ro.ok;
        var li: u32 = 0;
        for (li < seg_count) {
            val row: res[u32, fail.Fail] = of_plan.place(fp, "load segment", target_of.no_section(), page_size::usize, segs[li].filesz);
            if (sel row.err) {
                A.deallocate[u32](alloc, out.seg_rows, seg_count::usize);
                ret res[ImagePrologue, fail.Fail].err{row.err};
            }
            out.seg_rows[li] = row.ok;
            li               = li + 1;
        }
    }
    ret res[ImagePrologue, fail.Fail].ok{out};
}

fun image_prologue_free(alloc: *A.Allocator, p: *ImagePrologue, seg_count: u32) {
    if (p.seg_rows != nil) { A.deallocate[u32](alloc, p.seg_rows, seg_count::usize); }
    p.seg_rows = nil;
}

fun copy_segment_rows(buf: *u8, fp: *of_plan.FilePlan, segs: *target_of.LoadSegment, seg_rows: *u32, seg_count: u32) {
    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + of_plan.offset(fp, seg_rows[li]))::ptr, segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }
}

# the image's allocated section headers are the named sections the linker placed
# inside the mappings, not the mappings themselves: a `#[section]` name, a bss
# section's NOBITS type and its memory size all live here and nowhere else
fun image_section_count(segs: *target_of.LoadSegment, seg_count: u32) u32 {
    var n:  u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        if (!segs[li].table) { n = n + segs[li].section_count; }
        li = li + 1;
    }
    ret n;
}

fun load_section_align(sec: *target_of.LoadSection) usize {
    if (sec.align == 0) { ret 1; }
    ret sec.align::usize;
}

fun fill_image_section_aux(alloc: *A.Allocator, itn: *intern.Interner, fp: *of_plan.FilePlan,
    aux: *ShtAlloc, segs: *target_of.LoadSegment, seg_rows: *u32, seg_count: u32) err[fail.Fail] {
    var w:  u32 = 0;
    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].table) {
            li = li + 1;
            cnt;
        }
        if (segs[li].section_count == 0 || segs[li].sections == nil) {
            ret err[fail.Fail].err{fail.message("load segment carries no named section")};
        }
        val seg_off: usize = of_plan.offset(fp, seg_rows[li]);
        var i:       u32   = 0;
        for (i < segs[li].section_count) {
            val sec: *target_of.LoadSection = ?segs[li].sections[i];
            val ty:  opt[u32]               = section_type_for(sec.kind);
            if (sel ty.none) {
                ret err[fail.Fail].err{fail.message_of(target_of.section_kind_rejection(itn, alloc, sec.kind))};
            }
            aux[w].sh_type = ty.some;
            if ((sec.flags & target_of.SEC_FLAG_INIT_FUNCS) != 0) { aux[w].sh_type = SHT_INIT_ARRAY; }
            aux[w].name  = bin.resolve_name(itn, sec.name);
            aux[w].flags = section_flags_for(sec.kind);
            if ((sec.flags & (target_of.SEC_FLAG_UNWIND_INDEX | target_of.SEC_FLAG_UNWIND_FRAMES)) != 0) {
                aux[w].sh_type = SHT_PROGBITS;
                aux[w].flags   = SHF_ALLOC;
            }
            aux[w].addr    = segs[li].vaddr + sec.offset::u64;
            aux[w].off     = seg_off + sec.offset::usize;
            aux[w].size    = sec.len::usize;
            aux[w].link    = 0;
            aux[w].info    = 0;
            aux[w].align   = load_section_align(sec);
            aux[w].entsize = 0;
            w              = w + 1;
            i              = i + 1;
        }
        li = li + 1;
    }
    ret err[fail.Fail].ok{};
}

# the section header index an image address falls in, in the order
# fill_image_section_aux writes: the allocated sections occupy 1..n in every
# image this writer produces. an address inside no section is absolute
# the image section holding `vaddr`, 0 for an address no section holds
fun image_section_shndx(segs: *target_of.LoadSegment, seg_count: u32, vaddr: u64) u32 {
    var idx: u32 = 1;
    var li:  u32 = 0;
    for (li < seg_count) {
        var i: u32 = 0;
        if (segs[li].table) { i = segs[li].section_count; }
        for (i < segs[li].section_count) {
            val sec: *target_of.LoadSection = ?segs[li].sections[i];
            val lo:  u64                    = segs[li].vaddr + sec.offset::u64;
            if (vaddr >= lo && vaddr < lo + sec.len::u64) { ret idx; }
            idx = idx + 1;
            i   = i + 1;
        }
        li = li + 1;
    }
    ret 0;
}

fun write_relative_relocs(buf: *u8, fp: *of_plan.FilePlan, row: u32, rel_type: u32,
    dyn: *target_of.DynamicInfo, segs: *target_of.LoadSegment, seg_count: u32) err[fail.Fail] {
    var rela_off: usize = of_plan.offset(fp, row);
    var ri:       u32   = 0;
    for (ri < dyn.base_reloc_count) {
        val br:     *target_of.BaseReloc = ?dyn.base_relocs[ri];
        var loc_va: u64                  = 0;
        if (br.seg_index < seg_count) { loc_va = segs[br.seg_index].vaddr + br.seg_offset::u64; }
        bin.write_u64_le(buf, rela_off, loc_va);
        bin.write_u64_le(buf, rela_off + 8, rel_type::u64);
        bin.write_u64_le(buf, rela_off + 16, br.target);
        rela_off = rela_off + RELA_SIZE;
        ri       = ri + 1;
    }
    ret of_plan.close(fp, row, rela_off);
}

# the state every loaded ELF image builds through, whatever its kind: the plan
# and its prologue, the symbol table, the unwind room, the section rows and,
# once the plan is sealed, the buffer
rec ImageBuild {
    img:         *target_of.LinkedImage;
    lay:         ElfLayout;
    fp:          of_plan.FilePlan;
    pro:         ImagePrologue;
    sb:          SymtabBuild;
    eh_hdr:      cfi.UnwindRoom;
    sect_count:  u32;
    hi_va:       u64;
    phdr_count:  u32;
    phdr_offset: usize;
    aux:         *ShtAlloc;
    aux_count:   u32;
    dsht:        DebugSht;
    total_size:  usize;
    buf:         *u8;
}

fun image_build_dnit(b: *ImageBuild) {
    if (b.img == nil) { ret; }
    val alloc: *A.Allocator = b.img.alloc;
    debug_sht_free(alloc, ?b.dsht, b.img.debug_count, b.aux_count);
    if (b.aux != nil) { A.deallocate[ShtAlloc](alloc, b.aux, b.aux_count::usize); }
    b.aux = nil;
    image_prologue_free(alloc, ?b.pro, b.img.segment_count);
    of_plan.dnit(?b.fp);
    free_symtab_bytes(alloc, ?b.sb);
    b.sb.symtab_bytes = nil;
    b.sb.strtab_bytes = nil;
}

# the first phase of a loaded image: its class layout, the unwind room, the
# symbol table and the image's highest address
fun image_begin(b: *ImageBuild, img: *target_of.LinkedImage) err[fail.Fail] {
    b.img = img;
    b.lay = layout_for(img.target);
    val unwound: err[fail.Fail] = fill_unwind(img.alloc, img.target.arch_id, img.segments, img.segment_count, img.functions,
        img.function_count, ?b.eh_hdr);
    if (sel unwound.err) { ret unwound; }
    b.sect_count = image_section_count(img.segments, img.segment_count);
    val sb_r: res[SymtabBuild, fail.Fail] = build_symtab_bytes(img.alloc, img.interner, ?b.lay, img.symbols, img.symbol_count,
        img.segments, img.segment_count);
    if (sel sb_r.err) { ret err[fail.Fail].err{sb_r.err}; }
    b.sb    = sb_r.ok;
    b.hi_va = highest_vaddr(img.segments, img.segment_count);
    ret err[fail.Fail].ok{};
}

# the prologue every loaded image starts with: the header, `phdr_count` program
# headers and the build id note on the header page, then one row per segment
# ---
# overflow: why program headers that do not fit the header page are refused,
#           empty for an image whose loader does not map the header page
fun image_prologue(b: *ImageBuild, phdr_count: u32, overflow: str) err[fail.Fail] {
    val img: *target_of.LinkedImage = b.img;
    if (!str_empty(overflow) && !header_fits_reserved_page(?b.lay, phdr_count, img.page_size)) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, overflow)};
    }
    b.phdr_count = phdr_count;
    val planned: res[of_plan.FilePlan, fail.Fail] = of_plan.init(img.alloc, img.interner, "elf", limit(?b.lay));
    if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
    b.fp = planned.ok;
    val pro_r: res[ImagePrologue, fail.Fail] = place_image_prologue(img.alloc, ?b.fp, ?b.lay, phdr_count, img.page_size,
        img.segments, img.segment_count);
    if (sel pro_r.err) { ret err[fail.Fail].err{pro_r.err}; }
    b.pro         = pro_r.ok;
    b.phdr_offset = of_plan.offset(?b.fp, b.pro.phdr_row);
    ret err[fail.Fail].ok{};
}

# the section rows every loaded image carries, its named sections and the build
# id note, ahead of `extra` rows the kind fills; the first of those is returned
fun image_rows(b: *ImageBuild, extra: u32) res[*ShtAlloc, fail.Fail] {
    val img: *target_of.LinkedImage = b.img;
    b.aux_count = b.sect_count + 1 + extra;
    val axr: res[*ShtAlloc, A.Error] = A.zallocate[ShtAlloc](img.alloc, b.aux_count::usize);
    if (sel axr.err) {
        b.aux_count = 0;
        ret res[*ShtAlloc, fail.Fail].err{fail.refused(axr.err)};
    }
    b.aux = axr.ok;
    val filled: err[fail.Fail] = fill_image_section_aux(img.alloc, img.interner, ?b.fp, b.aux, img.segments, b.pro.seg_rows,
        img.segment_count);
    if (sel filled.err) { ret res[*ShtAlloc, fail.Fail].err{filled.err}; }
    fill_note_aux(?b.aux[b.sect_count], b.pro.note_off, prologue_note_vaddr(img.segments, img.segment_count, b.pro.note_off,
        img.page_size));
    ret res[*ShtAlloc, fail.Fail].ok{?b.aux[b.sect_count + 1]};
}

# seals the plan with the section table after everything the kind placed, then
# writes the header and the segments into the destination's buffer
fun image_seal(b: *ImageBuild, dst: *of_destination.Destination, e_type: u16, entry: u64) err[fail.Fail] {
    val img: *target_of.LinkedImage   = b.img;
    val dp:  res[DebugSht, fail.Fail] = debug_sht_plan(img.alloc, img.interner, ?b.lay, ?b.fp, img.debug, img.debug_count,
        b.aux, b.aux_count, ?b.sb);
    if (sel dp.err) { ret err[fail.Fail].err{dp.err}; }
    b.dsht = dp.ok;
    val sealed: res[usize, fail.Fail] = of_plan.seal(?b.fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    b.total_size = sealed.ok;

    var e_shoff:       u64            = 0;
    var e_shnum:       u16            = 0;
    var e_shstrndx:    u16            = 0;
    val header_fields: err[fail.Fail] = debug_sht_header(?b.fp, ?b.dsht, ?e_shoff, ?e_shnum, ?e_shstrndx);
    if (sel header_fields.err) { ret header_fields; }
    val phnum: res[u16, fail.Fail] = of_plan.field_u16(?b.fp, b.phdr_count::usize, "e_phnum");
    if (sel phnum.err) { ret err[fail.Fail].err{phnum.err}; }

    val res_buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", b.total_size, 0o755);
    if (sel res_buf.err) { ret err[fail.Fail].err{res_buf.err}; }
    b.buf = res_buf.ok;
    write_elf_ident(b.buf, ?b.lay);
    write_ehdr(b.buf, ?b.lay, e_type, machine_for_arch(img.target.arch_id), img.options.machine_flags,
        entry, b.phdr_offset::u64, e_shoff, phnum.ok, e_shnum, e_shstrndx);
    copy_segment_rows(b.buf, ?b.fp, img.segments, b.pro.seg_rows, img.segment_count);
    ret err[fail.Fail].ok{};
}

# closes the program headers the kind wrote up to `phdr_end`, writes the section
# table and seals the build id over the finished image
fun image_finish(b: *ImageBuild, phdr_end: usize) err[fail.Fail] {
    val img:         *target_of.LinkedImage = b.img;
    val phdr_closed: err[fail.Fail]         = of_plan.close(?b.fp, b.pro.phdr_row, phdr_end);
    if (sel phdr_closed.err) { ret phdr_closed; }
    val sht_written: err[fail.Fail] = debug_sht_write(b.buf, img.interner, ?b.lay, ?b.fp, img.debug, img.debug_count, b.aux,
        b.aux_count, ?b.sb, ?b.dsht);
    if (sel sht_written.err) { ret sht_written; }
    ret seal_build_id(b.buf, b.total_size, ?b.lay, b.pro.note_off);
}

# a section row the kind adds, allocated in the image
fun alloc_row(row: *ShtAlloc, name: str, sh_type: u32, addr: u64, off: usize, size: usize, link: u32, info: u32,
    align: usize, entsize: usize) {
    row.name    = name;
    row.sh_type = sh_type;
    row.flags   = SHF_ALLOC;
    row.addr    = addr;
    row.off     = off;
    row.size    = size;
    row.link    = link;
    row.info    = info;
    row.align   = align;
    row.entsize = entsize;
}

# the program headers past one per segment a position-independent image takes:
# the header table, the note, the read-only run and the dynamic section, its
# relro and its unwind index where it has them, and `extra` more
fun pie_phdr_count(b: *ImageBuild, extra: u32) u32 {
    var n: u32 = b.img.segment_count + 4 + extra;
    if (pie_relro_seg(b.img.segments, b.img.segment_count, b.img.dynamic) >= 0) { n = n + 1; }
    if (b.eh_hdr.present)                                                       { n = n + 1; }
    ret n;
}

fun emit_pie_exec(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    var b: ImageBuild;
    fin { image_build_dnit(?b); }
    if (layout_for(img.target).class != ELFCLASS64) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a position-independent image is ELF64-only (an ELFCLASS32 dynamic image is not implemented)")};
    }
    val begun: err[fail.Fail] = image_begin(?b, img);
    if (sel begun.err) { ret begun; }
    val prologue: err[fail.Fail] = image_prologue(?b, pie_phdr_count(?b, 0),
        "PIE program headers exceed the one-page header reservation (too many load segments)");
    if (sel prologue.err) { ret prologue; }

    val dyn:       *target_of.DynamicInfo = img.dynamic;
    val page_size: u64                    = img.page_size;
    val fp:        *of_plan.FilePlan      = ?b.fp;
    val nrel:      u32                    = dyn.base_reloc_count;

    val reladyn_size: res[usize, fail.Fail] = of_plan.table(fp, "relative relocations", nrel::usize, RELA_SIZE);
    if (sel reladyn_size.err) { ret err[fail.Fail].err{reladyn_size.err}; }
    val reladyn_r: res[u32, fail.Fail] = of_plan.place(fp, "relative relocations", target_of.no_section(), page_size::usize, reladyn_size.ok);
    if (sel reladyn_r.err) { ret err[fail.Fail].err{reladyn_r.err}; }
    val reladyn_row: u32                 = reladyn_r.ok;
    val ro_off:      usize               = of_plan.offset(fp, reladyn_row);
    val ro_va_r:     res[u64, fail.Fail] = of_plan.align_address(fp, "read-only structures", b.hi_va, page_size);
    if (sel ro_va_r.err) { ret err[fail.Fail].err{ro_va_r.err}; }
    val ro_va: u64 = ro_va_r.ok;

    var dyn_entries: u32 = 1;
    if (nrel > 0) { dyn_entries = dyn_entries + 4; }
    val dyn_r: res[u32, fail.Fail] = of_plan.place(fp, "dynamic section", target_of.no_section(), 8, dyn_entries::usize * DYN_SIZE);
    if (sel dyn_r.err) { ret err[fail.Fail].err{dyn_r.err}; }
    val dyn_row:  u32                 = dyn_r.ok;
    val dyn_off:  usize               = of_plan.offset(fp, dyn_row);
    val dyn_size: usize               = of_plan.size(fp, dyn_row);
    val dyn_va_r: res[u64, fail.Fail] = of_plan.address(fp, dyn_row, ro_off, ro_va);
    if (sel dyn_va_r.err) { ret err[fail.Fail].err{dyn_va_r.err}; }
    val dyn_va:  u64   = dyn_va_r.ok;
    val ro_size: usize = of_plan.end(fp, dyn_row) - ro_off;

    val rows: res[*ShtAlloc, fail.Fail] = image_rows(?b, 1);
    if (sel rows.err) { ret err[fail.Fail].err{rows.err}; }
    alloc_row(rows.ok, ".dynamic", SHT_DYNAMIC, dyn_va, dyn_off, dyn_size, 0, 0, 8, DYN_SIZE);

    val sealed: err[fail.Fail] = image_seal(?b, dst, ET_DYN, img.entry);
    if (sel sealed.err) { ret sealed; }
    val buf: *u8 = b.buf;

    val relocs_written: err[fail.Fail] = write_relative_relocs(buf, fp, reladyn_row, relative_type_for(img.target.arch_id), dyn,
        img.segments, img.segment_count);
    if (sel relocs_written.err) { ret relocs_written; }

    var dpos: usize = dyn_off;
    if (nrel > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_RELA, ro_va);
        dpos = write_dyn_entry(buf, dpos, DT_RELASZ, of_plan.size(fp, reladyn_row)::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELAENT, RELA_SIZE::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELACOUNT, nrel::u64);
    }
    dpos = write_dyn_entry(buf, dpos, DT_NULL, 0);
    val dyn_closed: err[fail.Fail] = of_plan.close(fp, dyn_row, dpos);
    if (sel dyn_closed.err) { ret dyn_closed; }

    ret image_finish(?b, write_pie_phdrs(buf, fp, b.phdr_offset, b.phdr_count, img.segments, b.pro.seg_rows, img.segment_count,
        b.pro.note_off, ro_off, ro_va, ro_size, dyn_off, dyn_va, dyn_size, dyn, page_size, false, ?b.eh_hdr));
}

# the header page's address in a dyld-style image, where the first PT_LOAD
# starts at file offset zero
fun prologue_note_vaddr(segs: *target_of.LoadSegment, seg_count: u32, note_off: usize, page_size: u64) u64 {
    var hdr_vaddr: u64 = 0;
    if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }
    ret hdr_vaddr + note_off::u64;
}

fun write_note_phdr(buf: *u8, pos: usize, note_off: usize, note_vaddr: u64) usize {
    ret write_phdr(buf, pos, PT_NOTE, PF_R, note_off, note_vaddr,
        buildid.ELF_NOTE_SIZE, buildid.ELF_NOTE_SIZE, buildid.ELF_NOTE_ALIGN::u64);
}

fun write_pie_phdrs(buf: *u8, fp: *of_plan.FilePlan, phdr_offset: usize, phdr_count: u32,
    segs: *target_of.LoadSegment, seg_rows: *u32, seg_count: u32, note_off: usize,
    ro_off: usize, ro_va: u64, ro_size: usize,
    dyn_off: usize, dyn_va: u64, dyn_size: usize, dyn: *target_of.DynamicInfo, page_size: u64,
    emit_gnu_stack: bool, eh_hdr: *cfi.UnwindRoom) usize {
    var pos:        usize = phdr_offset;
    val phdr_bytes: usize = phdr_count::usize * PHDR_SIZE;

    var hdr_vaddr: u64 = 0;
    if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }

    pos = write_phdr(buf, pos, PT_PHDR, PF_R, phdr_offset, hdr_vaddr + phdr_offset::u64,
        phdr_bytes, phdr_bytes, 8);
    buildid.write_elf_note_header(buf, note_off);
    pos = write_note_phdr(buf, pos, note_off, hdr_vaddr + note_off::u64);

    var li: u32 = 0;
    for (li < seg_count) {
        val seg_off: usize = of_plan.offset(fp, seg_rows[li]);
        if (li == 0) {
            val first_filesz: usize = seg_off + segs[0].filesz;
            val first_memsz:  usize = seg_off + segs[0].memsz;
            pos = write_phdr(buf, pos, PT_LOAD, pie_seg_flags(segs, li, seg_count, dyn), 0,
                hdr_vaddr, first_filesz, first_memsz, page_size);
        }
        or {
            pos = write_phdr(buf, pos, PT_LOAD, pie_seg_flags(segs, li, seg_count, dyn), seg_off,
                segs[li].vaddr, segs[li].filesz, segs[li].memsz, page_size);
        }
        li = li + 1;
    }

    pos = write_phdr(buf, pos, PT_LOAD, PF_R, ro_off, ro_va, ro_size, ro_size, page_size);
    pos = write_phdr(buf, pos, PT_DYNAMIC, PF_R, dyn_off, dyn_va, dyn_size, dyn_size, 8);

    val relro_seg: i64 = pie_relro_seg(segs, seg_count, dyn);
    if (relro_seg >= 0) {
        val ri:         u32   = relro_seg::u32;
        val relro_size: usize = segs[ri].memsz;
        pos = write_phdr(buf, pos, PT_GNU_RELRO, PF_R, of_plan.offset(fp, seg_rows[ri]), segs[ri].vaddr,
            relro_size, relro_size, 1);
    }

    if (eh_hdr != nil && eh_hdr.present) {
        pos = write_eh_frame_phdr(buf, pos, fp, seg_rows, segs, eh_hdr);
    }

    if (emit_gnu_stack) {
        pos = write_phdr(buf, pos, PT_GNU_STACK, PF_R | PF_W, 0, 0, 0, 0, 0x10);
    }
    ret pos;
}

fun seg_has_base_reloc(dyn: *target_of.DynamicInfo, li: u32, seg_count: u32) bool {
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == li && dyn.base_relocs[i].seg_index < seg_count) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun pie_relro_seg(segs: *target_of.LoadSegment, seg_count: u32, dyn: *target_of.DynamicInfo) i64 {
    var li: u32 = 0;
    for (li < seg_count) {
        val f: u32 = pf_flags_for(segs[li].flags);
        if ((f & PF_W) == 0 && (f & PF_X) == 0 && seg_has_base_reloc(dyn, li, seg_count)) {
            ret li::i64;
        }
        li = li + 1;
    }
    ret -1;
}

fun pie_seg_flags(segs: *target_of.LoadSegment, li: u32, seg_count: u32, dyn: *target_of.DynamicInfo) u32 {
    val f: u32 = pf_flags_for(segs[li].flags);
    if (seg_has_base_reloc(dyn, li, seg_count)) { ret f | PF_W; }
    ret f;
}

fun place_row(fp: *of_plan.FilePlan, label: str, align: usize, size: usize, row: *u32) err[fail.Fail] {
    val placed: res[u32, fail.Fail] = of_plan.place(fp, label, target_of.no_section(), align, size);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    @row = placed.ok;
    ret err[fail.Fail].ok{};
}

fun row_address(fp: *of_plan.FilePlan, row: u32, file_base: usize, address_base: u64, out: *u64) err[fail.Fail] {
    val va: res[u64, fail.Fail] = of_plan.address(fp, row, file_base, address_base);
    if (sel va.err) { ret err[fail.Fail].err{va.err}; }
    @out = va.ok;
    ret err[fail.Fail].ok{};
}

fun emit_shared(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    var b: ImageBuild;
    fin { image_build_dnit(?b); }
    if (layout_for(img.target).class != ELFCLASS64) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a shared object is ELF64-only (an ELFCLASS32 dynamic image is not implemented)")};
    }
    val begun: err[fail.Fail] = image_begin(?b, img);
    if (sel begun.err) { ret begun; }
    val dyn: *target_of.DynamicInfo = img.dynamic;
    if (dyn.import_addr_fixup_count > 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "data imports in a shared object are not supported")};
    }
    val prologue: err[fail.Fail] = image_prologue(?b, pie_phdr_count(?b, 1),
        "shared-object program headers exceed the one-page header reservation (too many load segments)");
    if (sel prologue.err) { ret prologue; }

    val alloc:     *A.Allocator         = img.alloc;
    val itn:       *intern.Interner     = img.interner;
    val exports:   *target_of.ExportSym = img.exports;
    val page_size: u64                  = img.page_size;
    val fp:        *of_plan.FilePlan    = ?b.fp;
    val nrel:      u32                  = dyn.base_reloc_count;
    val nexp:      u32                  = img.export_count;

    var exp_str: *usize = nil;
    if (nexp > 0) {
        val es: res[*usize, A.Error] = A.zallocate[usize](alloc, nexp::usize);
        if (sel es.err) { ret err[fail.Fail].err{fail.message("shared export-name table alloc failed")}; }
        exp_str = es.ok;
    }
    fin {
        if (exp_str != nil) { A.deallocate[usize](alloc, exp_str, nexp::usize); }
    }

    val ro_va_r: res[u64, fail.Fail] = of_plan.align_address(fp, "read-only structures", b.hi_va, page_size);
    if (sel ro_va_r.err) { ret err[fail.Fail].err{ro_va_r.err}; }
    val ro_va: u64 = ro_va_r.ok;

    var dynsym_row:  u32                   = of_plan.NO_ROW;
    val dynsym_size: res[usize, fail.Fail] = of_plan.table(fp, "dynamic symbols", (nexp + 1)::usize, SYM_SIZE);
    if (sel dynsym_size.err) { ret err[fail.Fail].err{dynsym_size.err}; }
    val r1: err[fail.Fail] = place_row(fp, "dynamic symbols", page_size::usize, dynsym_size.ok, ?dynsym_row);
    if (sel r1.err) { ret r1; }
    val ro_off: usize = of_plan.offset(fp, dynsym_row);

    val soname:      str   = img.library_name;
    var dynstr_size: usize = 1 + (str_len(soname) + 1);
    var e:           u32   = 0;
    for (e < nexp) {
        dynstr_size = dynstr_size + dynstr_name_len(itn, exports[e].name);
        e           = e + 1;
    }
    var dynstr_row: u32            = of_plan.NO_ROW;
    val r2:         err[fail.Fail] = place_row(fp, "dynamic strings", 1, dynstr_size, ?dynstr_row);
    if (sel r2.err) { ret r2; }

    val nchain:   usize          = (nexp + 1)::usize;
    var hash_row: u32            = of_plan.NO_ROW;
    val r3:       err[fail.Fail] = place_row(fp, "hash table", 8, 8 + 4 + nchain * 4, ?hash_row);
    if (sel r3.err) { ret r3; }

    var reladyn_row:  u32                   = of_plan.NO_ROW;
    val reladyn_size: res[usize, fail.Fail] = of_plan.table(fp, "relative relocations", nrel::usize, RELA_SIZE);
    if (sel reladyn_size.err) { ret err[fail.Fail].err{reladyn_size.err}; }
    val r4: err[fail.Fail] = place_row(fp, "relative relocations", 8, reladyn_size.ok, ?reladyn_row);
    if (sel r4.err) { ret r4; }

    var dyn_entries: u32 = 7;
    if (nrel > 0) { dyn_entries = dyn_entries + 4; }
    var dyn_row: u32            = of_plan.NO_ROW;
    val r5:      err[fail.Fail] = place_row(fp, "dynamic section", 8, dyn_entries::usize * DYN_SIZE, ?dyn_row);
    if (sel r5.err) { ret r5; }
    val ro_size: usize = of_plan.end(fp, dyn_row) - ro_off;

    var dynsym_va:  u64            = 0;
    var dynstr_va:  u64            = 0;
    var hash_va:    u64            = 0;
    var reladyn_va: u64            = 0;
    var dyn_va:     u64            = 0;
    val a1:         err[fail.Fail] = row_address(fp, dynsym_row, ro_off, ro_va, ?dynsym_va);
    if (sel a1.err) { ret a1; }
    val a2: err[fail.Fail] = row_address(fp, dynstr_row, ro_off, ro_va, ?dynstr_va);
    if (sel a2.err) { ret a2; }
    val a3: err[fail.Fail] = row_address(fp, hash_row, ro_off, ro_va, ?hash_va);
    if (sel a3.err) { ret a3; }
    val a4: err[fail.Fail] = row_address(fp, reladyn_row, ro_off, ro_va, ?reladyn_va);
    if (sel a4.err) { ret a4; }
    val a5: err[fail.Fail] = row_address(fp, dyn_row, ro_off, ro_va, ?dyn_va);
    if (sel a5.err) { ret a5; }

    val rows: res[*ShtAlloc, fail.Fail] = image_rows(?b, 4);
    if (sel rows.err) { ret err[fail.Fail].err{rows.err}; }
    val i_dynsym: u32       = b.sect_count + 2;
    val i_dynstr: u32       = b.sect_count + 3;
    val row:      *ShtAlloc = rows.ok;
    alloc_row(?row[0], ".dynsym", SHT_DYNSYM, dynsym_va, of_plan.offset(fp, dynsym_row), of_plan.size(fp, dynsym_row), i_dynstr, 1,
        8, SYM_SIZE);
    alloc_row(?row[1], ".dynstr", SHT_STRTAB, dynstr_va, of_plan.offset(fp, dynstr_row), dynstr_size, 0, 0, 1, 0);
    alloc_row(?row[2], ".hash", SHT_HASH, hash_va, of_plan.offset(fp, hash_row), of_plan.size(fp, hash_row), i_dynsym, 0, 4, 4);
    alloc_row(?row[3], ".dynamic", SHT_DYNAMIC, dyn_va, of_plan.offset(fp, dyn_row), of_plan.size(fp, dyn_row), i_dynstr, 0, 8,
        DYN_SIZE);

    val nchain_field: res[u32, fail.Fail] = of_plan.field_u32(fp, nchain, "hash chain count");
    if (sel nchain_field.err) { ret err[fail.Fail].err{nchain_field.err}; }
    val sealed: err[fail.Fail] = image_seal(?b, dst, ET_DYN, 0);
    if (sel sealed.err) { ret sealed; }
    val buf: *u8 = b.buf;

    val dynstr_off: usize = of_plan.offset(fp, dynstr_row);
    buf[dynstr_off] = 0;
    var str_pos:    usize = 1;
    val soname_off: usize = str_pos;
    str_pos = str_pos + bin.write_str(buf, dynstr_off + str_pos, soname);
    e       = 0;
    for (e < nexp) {
        exp_str[e] = str_pos;
        str_pos    = str_pos + bin.write_str(buf, dynstr_off + str_pos, bin.resolve_name(itn, exports[e].name));
        e          = e + 1;
    }
    val dynstr_closed: err[fail.Fail] = of_plan.close_size(fp, dynstr_row, str_pos);
    if (sel dynstr_closed.err) { ret dynstr_closed; }

    val segs:      *target_of.LoadSegment = img.segments;
    val seg_count: u32                    = img.segment_count;
    var sym_off:   usize                  = of_plan.offset(fp, dynsym_row) + SYM_SIZE;
    e = 0;
    for (e < nexp) {
        var st_type: u8 = STT_OBJECT;
        if (exports[e].is_func) { st_type = STT_FUNC; }
        var shndx: u16 = 1;
        var sgi:   u32 = 0;
        for (sgi < seg_count) {
            val sv: u64 = segs[sgi].vaddr;
            if (exports[e].vaddr >= sv && exports[e].vaddr < sv + segs[sgi].memsz::u64) { shndx = (sgi + 1)::u16; }
            sgi = sgi + 1;
        }
        if (exports[e].absolute) { shndx = SHN_ABS; }
        val name_field: res[u32, fail.Fail] = of_plan.field_u32(fp, exp_str[e], "export name offset");
        if (sel name_field.err) { ret err[fail.Fail].err{name_field.err}; }
        bin.write_u32_le(buf, sym_off, name_field.ok);
        buf[sym_off + 4] = (STB_GLOBAL << 4) | (st_type & 0xF);
        buf[sym_off + 5] = 0;
        bin.write_u16_le(buf, sym_off + 6, shndx);
        bin.write_u64_le(buf, sym_off + 8, exports[e].vaddr);
        bin.write_u64_le(buf, sym_off + 16, 0);
        sym_off = sym_off + SYM_SIZE;
        e       = e + 1;
    }
    val dynsym_closed: err[fail.Fail] = of_plan.close(fp, dynsym_row, sym_off);
    if (sel dynsym_closed.err) { ret dynsym_closed; }

    val hash_off: usize = of_plan.offset(fp, hash_row);
    bin.write_u32_le(buf, hash_off, 1);
    bin.write_u32_le(buf, hash_off + 4, nchain_field.ok);
    if (nexp > 0) { bin.write_u32_le(buf, hash_off + 8, 1); }
    or            { bin.write_u32_le(buf, hash_off + 8, 0); }
    var c:        u32   = 0;
    var hash_pos: usize = hash_off + 12;
    for (c < nchain_field.ok) {
        var next: u32 = c + 1;
        if (next >= nchain_field.ok) { next = 0; }
        bin.write_u32_le(buf, hash_pos, next);
        hash_pos = hash_pos + 4;
        c        = c + 1;
    }
    val hash_closed: err[fail.Fail] = of_plan.close(fp, hash_row, hash_pos);
    if (sel hash_closed.err) { ret hash_closed; }

    val relocs_written: err[fail.Fail] = write_relative_relocs(buf, fp, reladyn_row, relative_type_for(img.target.arch_id), dyn,
        segs, seg_count);
    if (sel relocs_written.err) { ret relocs_written; }

    var dpos: usize = of_plan.offset(fp, dyn_row);
    dpos = write_dyn_entry(buf, dpos, DT_SONAME, soname_off::u64);
    dpos = write_dyn_entry(buf, dpos, DT_HASH, hash_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRTAB, dynstr_va);
    dpos = write_dyn_entry(buf, dpos, DT_SYMTAB, dynsym_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRSZ, dynstr_size::u64);
    dpos = write_dyn_entry(buf, dpos, DT_SYMENT, SYM_SIZE::u64);
    if (nrel > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_RELA, reladyn_va);
        dpos = write_dyn_entry(buf, dpos, DT_RELASZ, of_plan.size(fp, reladyn_row)::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELAENT, RELA_SIZE::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELACOUNT, nrel::u64);
    }
    dpos = write_dyn_entry(buf, dpos, DT_NULL, 0);
    val dyn_closed: err[fail.Fail] = of_plan.close(fp, dyn_row, dpos);
    if (sel dyn_closed.err) { ret dyn_closed; }

    ret image_finish(?b, write_pie_phdrs(buf, fp, b.phdr_offset, b.phdr_count, segs, b.pro.seg_rows, seg_count,
        b.pro.note_off, ro_off, ro_va, ro_size, of_plan.offset(fp, dyn_row), dyn_va, of_plan.size(fp, dyn_row), dyn, page_size,
        true, ?b.eh_hdr));
}

fun jump_slot_for(arch_id: u32) u32 {
    ret row_for(arch_id).jump_slot;
}

fun glob_dat_for(arch_id: u32) u32 {
    ret row_for(arch_id).glob_dat;
}

fun relative_type_for(arch_id: u32) u32 {
    ret row_for(arch_id).relative;
}

fun dyn_arch_supported(arch_id: u32) bool {
    val row: *IsaRow = row_for(arch_id);
    ret row != nil && row.dynamic;
}

fun dyn_bind_now(arch_id: u32) bool {
    ret row_for(arch_id).bind_now;
}

fun plt_header_size(arch_id: u32) usize {
    ret row_for(arch_id).plt_header_size;
}

# the .plt the linker reserves at the end of the code, as GNU and LLVM ld lay
# it out beside .text, so a call site's branch reaches its stub whatever data
# the image carries
fun stub_shape(arch_id: u32, count: u32) res[target_of.TableShape, fail.Fail] {
    ret res[target_of.TableShape, fail.Fail].ok{target_of.TableShape{
        name: ".plt", size: plt_header_size(arch_id) + count::usize * PLT_ENTRY_SIZE, align: 16, placement: target_of.TABLE_CODE_END
    }};
}

fun plt_stub_va(lay: *DynLayout, n: u32, arch_id: u32) u64 {
    ret lay.plt_va + plt_header_size(arch_id)::u64 + n::u64 * PLT_ENTRY_SIZE::u64;
}

rec DynLayout {
    interp_row:   u32;
    dynsym_row:   u32;
    dynstr_row:   u32;
    hash_row:     u32;
    relaplt_row:  u32;
    reladyn_row:  u32;
    gotplt_row:   u32;
    datagot_row:  u32;
    dynamic_row:  u32;
    ro_off:       usize;
    ro_va:        u64;
    ro_size:      usize;
    interp_off:   usize;
    interp_va:    u64;
    interp_size:  usize;
    dynsym_off:   usize;
    dynsym_va:    u64;
    dynstr_off:   usize;
    dynstr_va:    u64;
    dynstr_size:  usize;
    hash_off:     usize;
    hash_va:      u64;
    hash_size:    usize;
    relaplt_off:  usize;
    relaplt_va:   u64;
    relaplt_size: usize;
    reladyn_off:  usize;
    reladyn_va:   u64;
    reladyn_size: usize;
    plt_off:      usize;
    plt_va:       u64;
    plt_size:     usize;
    rw_off:       usize;
    rw_va:        u64;
    rw_size:      usize;
    gotplt_off:   usize;
    gotplt_va:    u64;
    gotplt_size:  usize;
    datagot_off:  usize;
    datagot_va:   u64;
    datagot_size: usize;
    dynamic_off:  usize;
    dynamic_va:   u64;
    dynamic_size: usize;
}

rec ImportAddressPlan {
    ordinals:     *u32;
    import_count: u32;
    count:        u32;
}

fun import_address_plan(alloc: *A.Allocator, dyn: *target_of.DynamicInfo) res[ImportAddressPlan, fail.Fail] {
    var plan: ImportAddressPlan;
    plan.import_count = dyn.import_count;
    if (dyn.import_addr_fixup_count == 0) { ret res[ImportAddressPlan, fail.Fail].ok{plan}; }
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        if (dyn.import_addr_fixups[i].import_index >= dyn.import_count) {
            ret res[ImportAddressPlan, fail.Fail].err{fail.message("import-address fixup index is out of range")};
        }
        i = i + 1;
    }
    val made: res[*u32, A.Error] = A.allocate[u32](alloc, dyn.import_count::usize);
    if (sel made.err) { ret res[ImportAddressPlan, fail.Fail].err{fail.refused(made.err)}; }
    plan.ordinals = made.ok;
    i             = 0;
    for (i < dyn.import_count) {
        plan.ordinals[i] = 0xFFFFFFFF;
        i                = i + 1;
    }
    i = 0;
    for (i < dyn.import_addr_fixup_count) {
        plan.ordinals[dyn.import_addr_fixups[i].import_index] = 0;
        i                                                     = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (plan.ordinals[i] != 0xFFFFFFFF) {
            plan.ordinals[i] = plan.count;
            plan.count       = plan.count + 1;
        }
        i = i + 1;
    }
    ret res[ImportAddressPlan, fail.Fail].ok{plan};
}

fun import_address_plan_dnit(alloc: *A.Allocator, plan: *ImportAddressPlan) {
    if (plan.ordinals != nil) { A.deallocate[u32](alloc, plan.ordinals, plan.import_count::usize); }
    plan.ordinals     = nil;
    plan.import_count = 0;
    plan.count        = 0;
}

fun got_import_ordinal(plan: *ImportAddressPlan, raw: u32) u32 {
    if (raw >= plan.import_count || plan.ordinals == nil) { ret 0xFFFFFFFF; }
    ret plan.ordinals[raw];
}

fun dynstr_name_len(itn: *intern.Interner, id: intern.StrId) usize {
    val s: str = bin.resolve_name(itn, id);
    if (s == nil) { ret 1; }
    ret str_len(s) + 1;
}

fun emit_dyn_exec(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    val dyn: *target_of.DynamicInfo = img.dynamic;
    if (layout_for(img.target).class != ELFCLASS64) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "a dynamically linked executable is ELF64-only (an ELFCLASS32 dynamic image is not implemented)")};
    }
    if (!dyn_arch_supported(img.target.arch_id)) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "dynamic linking is not implemented for this architecture")};
    }
    if (dyn.pie) {
        if (dyn.import_count > 0 || dyn.lib_count > 0) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "PIE with dynamic imports is not supported (static-PIE only)")};
        }
        ret emit_pie_exec(img, dst);
    }

    val alloc:     *A.Allocator           = img.alloc;
    val itn:       *intern.Interner       = img.interner;
    val segs:      *target_of.LoadSegment = img.segments;
    val seg_count: u32                    = img.segment_count;
    val arch_id:   u32                    = img.target.arch_id;
    val nimp:      u32                    = target_of.func_import_count(dyn);

    val planned_got: res[ImportAddressPlan, fail.Fail] = import_address_plan(alloc, dyn);
    if (sel planned_got.err) { ret err[fail.Fail].err{planned_got.err}; }
    var got: ImportAddressPlan = planned_got.ok;
    fin { import_address_plan_dnit(alloc, ?got); }

    var b: ImageBuild;
    fin { image_build_dnit(?b); }
    val begun: err[fail.Fail] = image_begin(?b, img);
    if (sel begun.err) { ret begun; }
    # the structures' two segments are the last; the header table, the note,
    # the interpreter and the dynamic section have a program header each
    var phdr_count: u32 = seg_count + 4;
    if (b.eh_hdr.present) { phdr_count = phdr_count + 1; }
    val prologue: err[fail.Fail] = image_prologue(?b, phdr_count,
        "dynamic-exec program headers exceed the one-page header reservation (too many load segments)");
    if (sel prologue.err) { ret prologue; }
    val fp: *of_plan.FilePlan = ?b.fp;

    var seg_offsets: *usize = nil;
    if (seg_count > 0) {
        val so: res[*usize, A.Error] = A.zallocate[usize](alloc, seg_count::usize);
        if (sel so.err) { ret err[fail.Fail].err{fail.message("dyn-exec seg-offset alloc failed")}; }
        seg_offsets = so.ok;
        var li: u32 = 0;
        for (li < seg_count) {
            seg_offsets[li] = of_plan.offset(fp, b.pro.seg_rows[li]);
            li              = li + 1;
        }
    }
    fin {
        if (seg_offsets != nil) { A.deallocate[usize](alloc, seg_offsets, seg_count::usize); }
    }

    # the structures fill the two segments the linker laid out for them, the
    # read-only run and the one the loader writes, planned in a plan of their own
    val ro: *target_of.LoadSegment = target_of.table_segment(img, 0);
    val rw: *target_of.LoadSegment = target_of.table_segment(img, 1);
    if (ro == nil || rw == nil || seg_count < 2) {
        ret err[fail.Fail].err{fail.message("the linker laid out no segments for the dynamic structures")};
    }
    val dp_r: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "elf", limit(?b.lay));
    if (sel dp_r.err) { ret err[fail.Fail].err{dp_r.err}; }
    var dp: of_plan.FilePlan = dp_r.ok;
    fin { of_plan.dnit(?dp); }
    val ro_off: usize          = seg_offsets[seg_count - 2];
    val padded: err[fail.Fail] = of_plan.pad_to(?dp, "dynamic structures", ro_off);
    if (sel padded.err) { ret padded; }
    var lay:  DynLayout;
    val laid: err[fail.Fail] = compute_dyn_layout(itn, ?dp, ?lay, dyn, ?got, nimp, arch_id, ro.vaddr, img.page_size);
    if (sel laid.err) { ret laid; }
    if (lay.ro_off != ro_off || lay.ro_size != ro.filesz || lay.rw_off != seg_offsets[seg_count - 1] || lay.rw_va != rw.vaddr
        || lay.rw_size != rw.filesz) {
        ret err[fail.Fail].err{fail.message("the dynamic structures do not fill the segments the linker laid out for them")};
    }
    val located: err[fail.Fail] = locate_plt(alloc, dyn, nimp, arch_id, segs, seg_count, seg_offsets, ?lay);
    if (sel located.err) { ret located; }

    val rows: res[*ShtAlloc, fail.Fail] = image_rows(?b, 1);
    if (sel rows.err) { ret err[fail.Fail].err{rows.err}; }
    alloc_row(rows.ok, ".dynamic", SHT_DYNAMIC, lay.dynamic_va, lay.dynamic_off, lay.dynamic_size, 0, 0, 8, DYN_SIZE);

    var imp_str: *usize = nil;
    if (dyn.import_count > 0) {
        val ri: res[*usize, A.Error] = A.zallocate[usize](alloc, dyn.import_count::usize);
        if (sel ri.err) { ret err[fail.Fail].err{fail.message("dyn-exec import-name table alloc failed")}; }
        imp_str = ri.ok;
    }
    fin {
        if (imp_str != nil) { A.deallocate[usize](alloc, imp_str, dyn.import_count::usize); }
    }
    var lib_str: *usize = nil;
    if (dyn.lib_count > 0) {
        val rl: res[*usize, A.Error] = A.zallocate[usize](alloc, dyn.lib_count::usize);
        if (sel rl.err) { ret err[fail.Fail].err{fail.message("dyn-exec lib-name table alloc failed")}; }
        lib_str = rl.ok;
    }
    fin {
        if (lib_str != nil) { A.deallocate[usize](alloc, lib_str, dyn.lib_count::usize); }
    }

    val sealed: err[fail.Fail] = image_seal(?b, dst, ET_EXEC, img.entry);
    if (sel sealed.err) { ret sealed; }
    val buf: *u8 = b.buf;

    val structures: err[fail.Fail] = write_dyn_structures(itn, buf, ?dp, ?lay, dyn, ?got, nimp, arch_id, imp_str, lib_str);
    if (sel structures.err) { ret structures; }
    val plt_r: err[fail.Fail] = patch_plt_fixups(buf, ?lay, dyn, dyn.call_fixups, dyn.call_fixup_count, seg_offsets, segs,
        seg_count, nimp, arch_id);
    if (sel plt_r.err) { ret plt_r; }
    val import_r: err[fail.Fail] = patch_import_addr_fixups(buf, ?lay, dyn, ?got, seg_offsets, segs, seg_count, arch_id);
    if (sel import_r.err) { ret import_r; }

    ret image_finish(?b, write_dyn_phdrs(buf, fp, b.phdr_offset, b.phdr_count, ?lay, segs, b.pro.seg_rows, seg_count,
        b.pro.note_off, img.page_size, ?b.eh_hdr));
}

# the dynamic structures are placed from the plan's cursor: the read-only run
# and the read-write run each start on a page, and every address is the file
# offset carried to `struct_va`, so the file and the mapping stay congruent.
# the PLT is not among them: it lives in the code (locate_plt)
fun compute_dyn_layout(itn: *intern.Interner, fp: *of_plan.FilePlan, lay: *DynLayout, dyn: *target_of.DynamicInfo, got: *ImportAddressPlan, nimp: u32,
    arch_id: u32, struct_va: u64, page_size: u64) err[fail.Fail] {
    val page_sz: usize = page_size::usize;
    val ndata:   u32   = got.count;

    lay.interp_size = dynstr_name_len(itn, dyn.interp);
    val r_interp: err[fail.Fail] = place_row(fp, "interpreter path", page_sz, lay.interp_size, ?lay.interp_row);
    if (sel r_interp.err) { ret r_interp; }
    lay.ro_off = of_plan.offset(fp, lay.interp_row);
    lay.ro_va  = struct_va;
    if ((lay.ro_off::u64 % page_size) != (struct_va % page_size)) {
        ret err[fail.Fail].err{fail.message("the dynamic structures' file offset and address are not congruent modulo the page")};
    }
    lay.interp_off = lay.ro_off;
    lay.interp_va  = struct_va;

    val dynsym_size: res[usize, fail.Fail] = of_plan.table(fp, "dynamic symbols", (dyn.import_count + 1)::usize, SYM_SIZE);
    if (sel dynsym_size.err) { ret err[fail.Fail].err{dynsym_size.err}; }
    val r_dynsym: err[fail.Fail] = place_row(fp, "dynamic symbols", 8, dynsym_size.ok, ?lay.dynsym_row);
    if (sel r_dynsym.err) { ret r_dynsym; }

    var dynstr_size: usize = 1;
    dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.interp);
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) { dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.imports[i].symbol); }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].is_func) { dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.imports[i].symbol); }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.lib_count) {
        dynstr_size = dynstr_size + dynstr_name_len(itn, dyn.libs[i].soname);
        i           = i + 1;
    }
    lay.dynstr_size = dynstr_size;
    val r_dynstr: err[fail.Fail] = place_row(fp, "dynamic strings", 1, dynstr_size, ?lay.dynstr_row);
    if (sel r_dynstr.err) { ret r_dynstr; }

    val nchain: usize = (dyn.import_count + 1)::usize;
    lay.hash_size = 8 + 4 + nchain * 4;
    val r_hash: err[fail.Fail] = place_row(fp, "hash table", 8, lay.hash_size, ?lay.hash_row);
    if (sel r_hash.err) { ret r_hash; }

    lay.relaplt_size = nimp::usize * RELA_SIZE;
    val r_relaplt: err[fail.Fail] = place_row(fp, "PLT relocations", 8, lay.relaplt_size, ?lay.relaplt_row);
    if (sel r_relaplt.err) { ret r_relaplt; }

    lay.reladyn_size = ndata::usize * RELA_SIZE;
    val r_reladyn: err[fail.Fail] = place_row(fp, "dynamic relocations", 8, lay.reladyn_size, ?lay.reladyn_row);
    if (sel r_reladyn.err) { ret r_reladyn; }
    lay.ro_size = of_plan.end(fp, lay.reladyn_row) - lay.ro_off;

    lay.gotplt_size = (nimp + 3)::usize * GOT_ENTRY_SIZE;
    val r_gotplt: err[fail.Fail] = place_row(fp, "PLT GOT", page_sz, lay.gotplt_size, ?lay.gotplt_row);
    if (sel r_gotplt.err) { ret r_gotplt; }
    lay.rw_off = of_plan.offset(fp, lay.gotplt_row);

    lay.datagot_size = ndata::usize * GOT_ENTRY_SIZE;
    val r_datagot: err[fail.Fail] = place_row(fp, "data GOT", 1, lay.datagot_size, ?lay.datagot_row);
    if (sel r_datagot.err) { ret r_datagot; }

    var dyn_entries: u32 = dyn.lib_count + 6;
    if (nimp > 0)              { dyn_entries = dyn_entries + 4; }
    if (ndata > 0)             { dyn_entries = dyn_entries + 3; }
    if (dyn_bind_now(arch_id)) { dyn_entries = dyn_entries + 2; }
    lay.dynamic_size = dyn_entries::usize * DYN_SIZE;
    val r_dynamic: err[fail.Fail] = place_row(fp, "dynamic section", 8, lay.dynamic_size, ?lay.dynamic_row);
    if (sel r_dynamic.err) { ret r_dynamic; }
    lay.rw_size = of_plan.end(fp, lay.dynamic_row) - lay.rw_off;

    lay.dynsym_off  = of_plan.offset(fp, lay.dynsym_row);
    lay.dynstr_off  = of_plan.offset(fp, lay.dynstr_row);
    lay.hash_off    = of_plan.offset(fp, lay.hash_row);
    lay.relaplt_off = of_plan.offset(fp, lay.relaplt_row);
    lay.reladyn_off = of_plan.offset(fp, lay.reladyn_row);
    lay.gotplt_off  = of_plan.offset(fp, lay.gotplt_row);
    lay.datagot_off = of_plan.offset(fp, lay.datagot_row);
    lay.dynamic_off = of_plan.offset(fp, lay.dynamic_row);

    val a1: err[fail.Fail] = row_address(fp, lay.dynsym_row, lay.ro_off, struct_va, ?lay.dynsym_va);
    if (sel a1.err) { ret a1; }
    val a2: err[fail.Fail] = row_address(fp, lay.dynstr_row, lay.ro_off, struct_va, ?lay.dynstr_va);
    if (sel a2.err) { ret a2; }
    val a3: err[fail.Fail] = row_address(fp, lay.hash_row, lay.ro_off, struct_va, ?lay.hash_va);
    if (sel a3.err) { ret a3; }
    val a4: err[fail.Fail] = row_address(fp, lay.relaplt_row, lay.ro_off, struct_va, ?lay.relaplt_va);
    if (sel a4.err) { ret a4; }
    val a5: err[fail.Fail] = row_address(fp, lay.reladyn_row, lay.ro_off, struct_va, ?lay.reladyn_va);
    if (sel a5.err) { ret a5; }
    val a7: err[fail.Fail] = row_address(fp, lay.gotplt_row, lay.ro_off, struct_va, ?lay.gotplt_va);
    if (sel a7.err) { ret a7; }
    lay.rw_va = lay.gotplt_va;
    val a8: err[fail.Fail] = row_address(fp, lay.datagot_row, lay.ro_off, struct_va, ?lay.datagot_va);
    if (sel a8.err) { ret a8; }
    val a9: err[fail.Fail] = row_address(fp, lay.dynamic_row, lay.ro_off, struct_va, ?lay.dynamic_va);
    if (sel a9.err) { ret a9; }
    ret err[fail.Fail].ok{};
}

# the PLT lives in the table the linker reserved at the end of the code, so no
# data lies between a call site and its stub
fun locate_plt(alloc: *A.Allocator, dyn: *target_of.DynamicInfo, nimp: u32, arch_id: u32,
    segs: *target_of.LoadSegment, seg_count: u32, seg_offsets: *usize, lay: *DynLayout) err[fail.Fail] {
    lay.plt_off  = 0;
    lay.plt_va   = 0;
    lay.plt_size = 0;
    if (nimp == 0) { ret err[fail.Fail].ok{}; }
    val size: usize = plt_header_size(arch_id) + nimp::usize * PLT_ENTRY_SIZE;
    if (dyn.stubs.size != size) {
        ret err[fail.Fail].err{fail.message("the linker reserved no PLT for the imported functions")};
    }
    val at: res[target_of.SpanLocation, fail.Fail] = target_of.span_locate(alloc, dyn.stubs, segs, seg_count, true, "the PLT");
    if (sel at.err) { ret err[fail.Fail].err{at.err}; }
    lay.plt_off  = seg_offsets[at.ok.segment] + at.ok.offset::usize;
    lay.plt_va   = dyn.stubs.vaddr;
    lay.plt_size = size;
    ret err[fail.Fail].ok{};
}

fun write_dyn_structures(itn: *intern.Interner, buf: *u8, fp: *of_plan.FilePlan, lay: *DynLayout, dyn: *target_of.DynamicInfo, got: *ImportAddressPlan, nimp: u32,
    arch_id: u32, imp_str: *usize, lib_str: *usize) err[fail.Fail] {
    val interp_written: usize          = bin.write_str(buf, lay.interp_off, bin.resolve_name(itn, dyn.interp));
    val interp_closed:  err[fail.Fail] = of_plan.close_size(fp, lay.interp_row, interp_written);
    if (sel interp_closed.err) { ret interp_closed; }

    buf[lay.dynstr_off] = 0;
    var str_pos: usize = 1;
    str_pos = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.interp));

    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) {
            imp_str[i] = str_pos;
            str_pos    = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.imports[i].symbol));
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].is_func) {
            imp_str[i] = str_pos;
            str_pos    = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.imports[i].symbol));
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.lib_count) {
        lib_str[i] = str_pos;
        str_pos    = str_pos + bin.write_str(buf, lay.dynstr_off + str_pos, bin.resolve_name(itn, dyn.libs[i].soname));
        i          = i + 1;
    }
    val dynstr_closed: err[fail.Fail] = of_plan.close_size(fp, lay.dynstr_row, str_pos);
    if (sel dynstr_closed.err) { ret dynstr_closed; }

    var sym_off: usize = lay.dynsym_off + SYM_SIZE;
    i = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) {
            val name_field: res[u32, fail.Fail] = of_plan.field_u32(fp, imp_str[i], "import name offset");
            if (sel name_field.err) { ret err[fail.Fail].err{name_field.err}; }
            bin.write_u32_le(buf, sym_off, name_field.ok);
            buf[sym_off + 4] = (STB_GLOBAL << 4) | (STT_FUNC & 0xF);
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, 0);
            bin.write_u64_le(buf, sym_off + 8, 0);
            bin.write_u64_le(buf, sym_off + 16, 0);
            sym_off = sym_off + SYM_SIZE;
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].is_func) {
            val name_field: res[u32, fail.Fail] = of_plan.field_u32(fp, imp_str[i], "import name offset");
            if (sel name_field.err) { ret err[fail.Fail].err{name_field.err}; }
            bin.write_u32_le(buf, sym_off, name_field.ok);
            buf[sym_off + 4] = (STB_GLOBAL << 4) | (STT_OBJECT & 0xF);
            buf[sym_off + 5] = 0;
            bin.write_u16_le(buf, sym_off + 6, 0);
            bin.write_u64_le(buf, sym_off + 8, 0);
            bin.write_u64_le(buf, sym_off + 16, 0);
            sym_off = sym_off + SYM_SIZE;
        }
        i = i + 1;
    }
    val dynsym_closed: err[fail.Fail] = of_plan.close(fp, lay.dynsym_row, sym_off);
    if (sel dynsym_closed.err) { ret dynsym_closed; }

    val ndata_h: u32                 = got.count;
    val nchain:  res[u32, fail.Fail] = of_plan.count_u32(fp, "hash chain count", dyn.import_count, 1);
    if (sel nchain.err) { ret err[fail.Fail].err{nchain.err}; }
    val chain_count: u32 = nchain.ok;
    bin.write_u32_le(buf, lay.hash_off, 1);
    bin.write_u32_le(buf, lay.hash_off + 4, chain_count);
    if (dyn.import_count > 0) { bin.write_u32_le(buf, lay.hash_off + 8, 1); }
    or                        { bin.write_u32_le(buf, lay.hash_off + 8, 0); }
    var c:        u32   = 0;
    var hash_pos: usize = lay.hash_off + 12;
    for (c < chain_count) {
        var next: u32 = c + 1;
        if (next >= chain_count) { next = 0; }
        bin.write_u32_le(buf, hash_pos, next);
        hash_pos = hash_pos + 4;
        c        = c + 1;
    }
    val hash_closed: err[fail.Fail] = of_plan.close(fp, lay.hash_row, hash_pos);
    if (sel hash_closed.err) { ret hash_closed; }

    bin.write_u64_le(buf, lay.gotplt_off, lay.dynamic_va);
    bin.write_u64_le(buf, lay.gotplt_off + 8, 0);
    bin.write_u64_le(buf, lay.gotplt_off + 16, 0);

    var rela_off: usize = lay.relaplt_off;
    if (nimp > 0) {
        val row: *IsaRow = row_for(arch_id);
        if (row.plt_header != nil) {
            val header_r: err[fail.Fail] = row.plt_header(buf, lay);
            if (sel header_r.err) { ret header_r; }
        }
        var n:         u32 = 0;
        var sym_index: u32 = 1;
        i = 0;
        for (i < dyn.import_count) {
            if (dyn.imports[i].is_func) {
                val stub_r: err[fail.Fail] = write_plt_stub(buf, lay, n, arch_id);
                if (sel stub_r.err) { ret stub_r; }

                val got_slot_off: usize = lay.gotplt_off + (3 + n)::usize * GOT_ENTRY_SIZE;
                if (!row.bind_now) {
                    bin.write_u64_le(buf, got_slot_off, plt_stub_va(lay, n, arch_id) + row.lazy_resume);
                }

                val got_slot_va: u64 = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
                bin.write_u64_le(buf, rela_off, got_slot_va);
                val r_info: u64 = (sym_index::u64 << 32) | jump_slot_for(arch_id)::u64;
                bin.write_u64_le(buf, rela_off + 8, r_info);
                bin.write_u64_le(buf, rela_off + 16, 0);
                rela_off = rela_off + RELA_SIZE;

                n         = n + 1;
                sym_index = sym_index + 1;
            }
            i = i + 1;
        }
    }
    val relaplt_closed: err[fail.Fail] = of_plan.close(fp, lay.relaplt_row, rela_off);
    if (sel relaplt_closed.err) { ret relaplt_closed; }

    var rd_off: usize = lay.reladyn_off;
    if (ndata_h > 0) {
        var d_ord:           u32 = 0;
        var function_symbol: u32 = 1;
        var object_symbol:   u32 = nimp + 1;
        i = 0;
        for (i < dyn.import_count) {
            var symbol: u32 = object_symbol;
            if (dyn.imports[i].is_func) {
                symbol          = function_symbol;
                function_symbol = function_symbol + 1;
            }
            or { object_symbol = object_symbol + 1; }
            if (got_import_ordinal(got, i) != 0xFFFFFFFF) {
                val slot_va: u64 = lay.datagot_va + d_ord::u64 * GOT_ENTRY_SIZE::u64;
                bin.write_u64_le(buf, rd_off, slot_va);
                val rd_info: u64 = (symbol::u64 << 32) | glob_dat_for(arch_id)::u64;
                bin.write_u64_le(buf, rd_off + 8, rd_info);
                bin.write_u64_le(buf, rd_off + 16, 0);
                rd_off = rd_off + RELA_SIZE;
                d_ord  = d_ord + 1;
            }
            i = i + 1;
        }
    }
    val reladyn_closed: err[fail.Fail] = of_plan.close(fp, lay.reladyn_row, rd_off);
    if (sel reladyn_closed.err) { ret reladyn_closed; }

    var dpos: usize = lay.dynamic_off;
    i = 0;
    for (i < dyn.lib_count) {
        dpos = write_dyn_entry(buf, dpos, DT_NEEDED, lib_str[i]::u64);
        i    = i + 1;
    }
    dpos = write_dyn_entry(buf, dpos, DT_HASH, lay.hash_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRTAB, lay.dynstr_va);
    dpos = write_dyn_entry(buf, dpos, DT_SYMTAB, lay.dynsym_va);
    dpos = write_dyn_entry(buf, dpos, DT_STRSZ, lay.dynstr_size::u64);
    dpos = write_dyn_entry(buf, dpos, DT_SYMENT, SYM_SIZE::u64);
    if (nimp > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_PLTGOT, lay.gotplt_va);
        dpos = write_dyn_entry(buf, dpos, DT_PLTRELSZ, lay.relaplt_size::u64);
        dpos = write_dyn_entry(buf, dpos, DT_PLTREL, DT_RELA_TAG);
        dpos = write_dyn_entry(buf, dpos, DT_JMPREL, lay.relaplt_va);
    }
    if (ndata_h > 0) {
        dpos = write_dyn_entry(buf, dpos, DT_RELA, lay.reladyn_va);
        dpos = write_dyn_entry(buf, dpos, DT_RELASZ, lay.reladyn_size::u64);
        dpos = write_dyn_entry(buf, dpos, DT_RELAENT, RELA_SIZE::u64);
    }
    if (dyn_bind_now(arch_id)) {
        dpos = write_dyn_entry(buf, dpos, DT_FLAGS, DF_BIND_NOW);
        dpos = write_dyn_entry(buf, dpos, DT_BIND_NOW, 0);
    }
    dpos = write_dyn_entry(buf, dpos, DT_NULL, 0);
    ret of_plan.close(fp, lay.dynamic_row, dpos);
}

fun write_dyn_entry(buf: *u8, off: usize, tag: u64, value: u64) usize {
    bin.write_u64_le(buf, off, tag);
    bin.write_u64_le(buf, off + 8, value);
    ret off + DYN_SIZE;
}

# the PLT sits in the code and the GOT after the data, so every stub's reach to
# its slot is checked rather than truncated into the instruction
fun plt_got_disp32(slot_va: u64, next_va: u64) res[u32, fail.Fail] {
    val disp: i64 = slot_va::i64 - next_va::i64;
    if (disp > 2147483647 || disp < -2147483648) {
        ret res[u32, fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "a PLT entry's GOT slot lies outside the rip-relative +-2GB range")};
    }
    ret res[u32, fail.Fail].ok{(disp::u64)::u32};
}

fun write_plt_header(buf: *u8, lay: *DynLayout) err[fail.Fail] {
    val p:  usize               = lay.plt_off;
    val d1: res[u32, fail.Fail] = plt_got_disp32(lay.gotplt_va + 8, lay.plt_va + 6);
    if (sel d1.err) { ret err[fail.Fail].err{d1.err}; }
    val d2: res[u32, fail.Fail] = plt_got_disp32(lay.gotplt_va + 16, lay.plt_va + 12);
    if (sel d2.err) { ret err[fail.Fail].err{d2.err}; }
    buf[p]     = 0xFF;
    buf[p + 1] = 0x35;
    bin.write_u32_le(buf, p + 2, d1.ok);
    buf[p + 6] = 0xFF;
    buf[p + 7] = 0x25;
    bin.write_u32_le(buf, p + 8, d2.ok);
    buf[p + 12] = 0x0F;
    buf[p + 13] = 0x1F;
    buf[p + 14] = 0x40;
    buf[p + 15] = 0x00;
    ret err[fail.Fail].ok{};
}

val A64_PLT_ADRP_X16: u32 = 0x90000010;
val A64_PLT_LDR_X16:  u32 = 0xF9400210;
val A64_PLT_BR_X16:   u32 = 0xD61F0200;
val A64_NOP:          u32 = 0xD503201F;
val RV_PLT_AUIPC_T3:  u32 = 0x00000E17;
val RV_PLT_LD_T3:     u32 = 0x000E3E03;
val RV_PLT_JR_T3:     u32 = 0x000E0067;
val RV_NOP:           u32 = 0x00000013;

fun arm64_adrp_word(base: u32, pc: u64, target: u64) u32 {
    val tgt_page: i64 = (target::i64) - ((target::i64) & 0xFFF);
    val pc_page:  i64 = (pc::i64) - ((pc::i64) & 0xFFF);
    val delta:    i64 = tgt_page - pc_page;
    val imm21:    u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
    val immlo:    u32 = imm21 & 0x3;
    val immhi:    u32 = (imm21 >> 2) & 0x7FFFF;
    ret base | (immlo << 29) | (immhi << 5);
}

fun arm64_ldr64_lo12_word(base: u32, target: u64) u32 {
    val imm12: u32 = (((target & 0xFFF) >> 3)::u32);
    ret base | (imm12 << 10);
}

fun riscv_hi20_word(base: u32, delta: i64) u32 {
    val hi20: u32 = (((delta + 0x800) >> 12)::u64 & 0xFFFFF)::u32;
    ret base | (hi20 << 12);
}

fun riscv_lo12_i_word(base: u32, delta: i64) u32 {
    val lo12: u32 = (delta::u64 & 0xFFF)::u32;
    ret base | (lo12 << 20);
}

fun write_plt_stub(buf: *u8, lay: *DynLayout, n: u32, arch_id: u32) err[fail.Fail] {
    val row: *IsaRow = row_for(arch_id);
    if (row == nil || !row.dynamic) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "ELF dynamic linking does not cover this instruction set")};
    }
    val stub_off: usize = lay.plt_off + row.plt_header_size + n::usize * PLT_ENTRY_SIZE;
    ret row.plt_stub(buf, lay, n, stub_off, plt_stub_va(lay, n, arch_id));
}

fun write_plt_stub_x86_64(buf: *u8, lay: *DynLayout, n: u32, stub_off: usize, stub_va: u64) err[fail.Fail] {
    val got:  u64                 = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
    val disp: res[u32, fail.Fail] = plt_got_disp32(got, stub_va + 6);
    if (sel disp.err) { ret err[fail.Fail].err{disp.err}; }
    buf[stub_off]     = 0xFF;
    buf[stub_off + 1] = 0x25;
    bin.write_u32_le(buf, stub_off + 2, disp.ok);
    buf[stub_off + 6] = 0x68;
    bin.write_u32_le(buf, stub_off + 7, n);
    buf[stub_off + 11] = 0xE9;
    val plt0:  u64 = lay.plt_va;
    val after: u64 = stub_va + 16;
    bin.write_u32_le(buf, stub_off + 12, (plt0 - after)::u32);
    ret err[fail.Fail].ok{};
}

fun write_plt_stub_aarch64(buf: *u8, lay: *DynLayout, n: u32, stub_off: usize, stub_va: u64) err[fail.Fail] {
    val got_va: u64 = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
    val pages:  i64 = ((got_va >> 12) << 12)::i64 - ((stub_va >> 12) << 12)::i64;
    if (pages < -4294967296 || pages >= 4294967296) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "a PLT entry's GOT slot lies outside the adrp +-4GB range")};
    }
    bin.write_u32_le(buf, stub_off, arm64_adrp_word(A64_PLT_ADRP_X16, stub_va, got_va));
    bin.write_u32_le(buf, stub_off + 4, arm64_ldr64_lo12_word(A64_PLT_LDR_X16, got_va));
    bin.write_u32_le(buf, stub_off + 8, A64_PLT_BR_X16);
    bin.write_u32_le(buf, stub_off + 12, A64_NOP);
    ret err[fail.Fail].ok{};
}

fun write_plt_stub_riscv64(buf: *u8, lay: *DynLayout, n: u32, stub_off: usize, stub_va: u64) err[fail.Fail] {
    val got_va: u64 = lay.gotplt_va + (3 + n)::u64 * GOT_ENTRY_SIZE::u64;
    val delta:  i64 = (got_va::i64) - (stub_va::i64);
    if (!riscv_pcrel_ok(delta)) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "a PLT entry's GOT slot lies outside the auipc +-2GB range")};
    }
    bin.write_u32_le(buf, stub_off, riscv_hi20_word(RV_PLT_AUIPC_T3, delta));
    bin.write_u32_le(buf, stub_off + 4, riscv_lo12_i_word(RV_PLT_LD_T3, delta));
    bin.write_u32_le(buf, stub_off + 8, RV_PLT_JR_T3);
    bin.write_u32_le(buf, stub_off + 12, RV_NOP);
    ret err[fail.Fail].ok{};
}

fun patch_plt_fixups(buf: *u8, lay: *DynLayout, dyn: *target_of.DynamicInfo,
    fixups: *target_of.ImportFixup, fixup_count: u32, seg_offsets: *usize,
    segs: *target_of.LoadSegment, seg_count: u32, nimp: u32, arch_id: u32) err[fail.Fail] {
    if (nimp == 0) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < fixup_count) {
        val fx: *target_of.ImportFixup = ?fixups[i];
        if (fx.seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup references an out-of-range segment")};
        }
        val width_r: res[usize, fail.Fail] = site_width(row_for(arch_id), fx.kind);
        if (sel width_r.err) { ret err[fail.Fail].err{width_r.err}; }
        val width: usize = width_r.ok;
        val n:     u32   = target_of.func_ordinal(dyn, fx.import_index);
        if (n == 0xFFFFFFFF) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup targets a non-function import")};
        }

        val seg_filesz: usize = segs[fx.seg_index].filesz;
        if (fx.seg_offset::usize + width > seg_filesz) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup offset out of range")};
        }

        val stub_va:  u64            = plt_stub_va(lay, n, arch_id);
        val file_off: usize          = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
        val pr:       err[fail.Fail] = patch_call_site(buf, file_off, arch_id, fx.kind, stub_va, fx.addend, fx.patch_vaddr);
        if (sel pr.err) { ret pr; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun patch_import_addr_fixups(buf: *u8, lay: *DynLayout, dyn: *target_of.DynamicInfo, got: *ImportAddressPlan,
    seg_offsets: *usize, segs: *target_of.LoadSegment,
    seg_count: u32, arch_id: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        val fx: *target_of.ImportFixup = ?dyn.import_addr_fixups[i];
        if (fx.seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("data-import GOT fixup references an out-of-range segment")};
        }
        val ord: u32 = got_import_ordinal(got, fx.import_index);
        if (ord == 0xFFFFFFFF || ord::usize >= lay.datagot_size / GOT_ENTRY_SIZE) {
            ret err[fail.Fail].err{fail.message("import-address fixup has no allocated GOT slot")};
        }
        val slot_va: u64 = lay.datagot_va + ord::u64 * GOT_ENTRY_SIZE::u64;

        val row:     *IsaRow               = row_for(arch_id);
        val width_r: res[usize, fail.Fail] = site_width(row, fx.kind);
        if (sel width_r.err) { ret err[fail.Fail].err{width_r.err}; }
        val width:      usize = width_r.ok;
        val seg_filesz: usize = segs[fx.seg_index].filesz;
        if (fx.seg_offset::u64 + width::u64 > seg_filesz::u64) {
            ret err[fail.Fail].err{fail.message("data-import GOT fixup offset out of range")};
        }
        val file_off: usize          = seg_offsets[fx.seg_index] + fx.seg_offset::usize;
        val bound:    err[fail.Fail] = row.import_address(buf, file_off, fx, slot_va, width);
        if (sel bound.err) { ret bound; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the bytes a site of `kind` patches, one word unless the row says otherwise
fun site_width(row: *IsaRow, kind: target_of.RelocKind) res[usize, fail.Fail] {
    if (row.site_width == nil) { ret res[usize, fail.Fail].ok{4}; }
    ret row.site_width(kind);
}

fun patch_call_site(buf: *u8, file_off: usize, arch_id: u32, kind: target_of.RelocKind, stub_va: u64,
    addend: i64, patch_va: u64) err[fail.Fail] {
    val row: *IsaRow = row_for(arch_id);
    if (target_of.is_pcrel_address_kind(kind)) {
        ret patch_stub_address(buf, file_off, row, kind, stub_va, addend, patch_va);
    }
    ret row.call_patch(buf, file_off, kind, stub_va, addend, patch_va);
}

# one part of a function import's address taken pc-relative, bound to its stub
fun patch_stub_address(buf: *u8, file_off: usize, row: *IsaRow, kind: target_of.RelocKind,
    stub_va: u64, addend: i64, patch_va: u64) err[fail.Fail] {
    val site:    *u8                            = (buf::usize + file_off)::*u8;
    val target:  target_of.RelocTarget          = of_reloc.target(stub_va, 0, 0);
    var patched: res[bool, of_reloc.RelocError] = res[bool, of_reloc.RelocError].err{of_reloc.UNSUPPORTED};
    if (row.stub_address != nil) {
        patched = row.stub_address(kind, site, 0, 4, target, addend, patch_va, 0);
    }
    if (sel patched.err) {
        ret err[fail.Fail].err{fail.message("a function import's address cannot be bound to its PLT entry")};
    }
    ret err[fail.Fail].ok{};
}

# an x86_64 call site holds a 32-bit displacement to the stub
fun x86_64_call_patch(buf: *u8, file_off: usize, kind: target_of.RelocKind, stub_va: u64,
    addend: i64, patch_va: u64) err[fail.Fail] {
    val disp: i64 = (stub_va::i64) + addend - (patch_va::i64);
    if (disp > 2147483647 || disp < -2147483648) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic call-site displacement overflows 32 bits")};
    }
    bin.write_u32_le(buf, file_off, (disp::u64)::u32);
    ret err[fail.Fail].ok{};
}

fun aarch64_call_patch(buf: *u8, file_off: usize, kind: target_of.RelocKind, stub_va: u64,
    addend: i64, patch_va: u64) err[fail.Fail] {
    val disp: i64 = (stub_va::i64) + addend - (patch_va::i64);
    val lim:  i64 = 134217728;
    if (disp < -lim || disp >= lim || (disp & 3) != 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic call-site displacement overflows the BL +-128MB range")};
    }
    val word:  u32 = bin.read_u32_le(buf, file_off);
    val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
    bin.write_u32_le(buf, file_off, (word & 0xFC000000) | imm26);
    ret err[fail.Fail].ok{};
}

# a riscv call site is the auipc+jalr pair under RK_PLT32, or one jal word
fun riscv64_call_patch(buf: *u8, file_off: usize, kind: target_of.RelocKind, stub_va: u64,
    addend: i64, patch_va: u64) err[fail.Fail] {
    val delta: i64 = (stub_va::i64) + addend - (patch_va::i64);
    if (kind == target_of.RK_JAL20) {
        if (!riscv_reloc.jal20_ok(delta)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic jump-site displacement overflows the jal +-1MB range")};
        }
        val jal: u32 = bin.read_u32_le(buf, file_off);
        bin.write_u32_le(buf, file_off, riscv_reloc.set_jal20(jal, delta));
        ret err[fail.Fail].ok{};
    }
    if (!riscv_pcrel_ok(delta)) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic call-site displacement overflows the auipc+jalr +-2GB range")};
    }
    val auipc: u32 = bin.read_u32_le(buf, file_off);
    bin.write_u32_le(buf, file_off, riscv_hi20_word(auipc & 0xFFF, delta));
    val jalr: u32 = bin.read_u32_le(buf, (file_off + 4));
    bin.write_u32_le(buf, (file_off + 4), riscv_lo12_i_word(jalr & 0x000FFFFF, delta));
    ret err[fail.Fail].ok{};
}

fun riscv64_site_width(kind: target_of.RelocKind) res[usize, fail.Fail] {
    if (kind == target_of.RK_PLT32) { ret res[usize, fail.Fail].ok{8}; }
    ret res[usize, fail.Fail].ok{4};
}

# an x86_64 GOT load is the only import address it binds, its field as wide as
# the relocation's
fun x86_64_site_width(kind: target_of.RelocKind) res[usize, fail.Fail] {
    if (!isa_x64_reloc.is_local_got_kind(kind)) { ret res[usize, fail.Fail].ok{4}; }
    val traits: res[of_reloc.RelocTraits, of_reloc.RelocError] = isa_x64_reloc.reloc_traits(kind, target_of.SK_TEXT, false);
    if (sel traits.err) {
        ret res[usize, fail.Fail].err{fail.message("x86-64 import-address relocation has no field traits")};
    }
    ret res[usize, fail.Fail].ok{traits.ok.field_width::usize};
}

fun import_address_refusal(fx: *target_of.ImportFixup) err[fail.Fail] {
    ret err[fail.Fail].err{target_of.reloc_refusal(fx.origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, "unsupported import-address GOT relocation or addend")};
}

fun x86_64_import_address(buf: *u8, file_off: usize, fx: *target_of.ImportFixup, slot_va: u64, width: usize) err[fail.Fail] {
    if (!isa_x64_reloc.is_local_got_kind(fx.kind)) { ret import_address_refusal(fx); }
    var target: target_of.RelocTarget;
    target.vaddr = slot_va;
    val patched: res[bool, of_reloc.RelocError] = isa_x64_reloc.apply_reloc(
        fx.kind, (buf::usize + file_off)::*u8, 0, width::u32, target, fx.addend, fx.patch_vaddr, 0);
    if (sel patched.err) {
        ret err[fail.Fail].err{fail.message("x86-64 import-address GOT relocation failed")};
    }
    ret err[fail.Fail].ok{};
}

fun aarch64_import_address(buf: *u8, file_off: usize, fx: *target_of.ImportFixup, slot_va: u64, width: usize) err[fail.Fail] {
    if (fx.addend != 0) { ret import_address_refusal(fx); }
    val cur: u32 = bin.read_u32_le(buf, file_off);
    if (fx.kind == target_of.RK_GOT_PAGE21) {
        bin.write_u32_le(buf, file_off, arm64_adrp_word(cur, fx.patch_vaddr, slot_va));
        ret err[fail.Fail].ok{};
    }
    if (fx.kind == target_of.RK_GOT_LO12) {
        bin.write_u32_le(buf, file_off, arm64_ldr64_lo12_word(cur, slot_va));
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{target_of.reloc_refusal(fx.origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, "unsupported data-import GOT relocation kind")};
}

fun riscv64_import_address(buf: *u8, file_off: usize, fx: *target_of.ImportFixup, slot_va: u64, width: usize) err[fail.Fail] {
    if (fx.kind != target_of.RK_GOT_PCREL_HI20 && fx.kind != target_of.RK_PCREL_LO12_I && fx.kind != target_of.RK_PCREL_LO12_S) {
        ret import_address_refusal(fx);
    }
    var target: target_of.RelocTarget;
    target.vaddr = slot_va;
    val patched: res[bool, of_reloc.RelocError] = riscv_reloc.apply_reloc(
        fx.kind, (buf::usize + file_off)::*u8, 0, 4, target, fx.addend, fx.patch_vaddr, 0);
    if (sel patched.err) {
        ret err[fail.Fail].err{fail.message("RISC-V import-address GOT relocation failed")};
    }
    ret err[fail.Fail].ok{};
}

fun riscv_pcrel_ok(delta: i64) bool {
    val adj: i64 = delta + 0x800;
    ret adj >= -2147483648 && adj <= 2147483647;
}

fun write_dyn_phdrs(buf: *u8, fp: *of_plan.FilePlan, phdr_offset: usize, phdr_count: u32, lay: *DynLayout,
    segs: *target_of.LoadSegment, seg_rows: *u32, seg_count: u32, note_off: usize, page_size: u64,
    eh_hdr: *cfi.UnwindRoom) usize {
    var pos: usize = phdr_offset;

    var hdr_vaddr: u64 = 0;
    if (seg_count > 0) { hdr_vaddr = header_segment_vaddr(segs[0].vaddr, page_size); }

    pos = write_phdr(buf, pos, PT_PHDR, PF_R, phdr_offset, hdr_vaddr + phdr_offset::u64,
        phdr_count::usize * PHDR_SIZE, phdr_count::usize * PHDR_SIZE, 8);
    buildid.write_elf_note_header(buf, note_off);
    pos = write_note_phdr(buf, pos, note_off, hdr_vaddr + note_off::u64);

    pos = write_phdr(buf, pos, PT_INTERP, PF_R, lay.interp_off, lay.interp_va,
        lay.interp_size, lay.interp_size, 1);

    var li: u32 = 0;
    for (li < seg_count) {
        val seg_off: usize = of_plan.offset(fp, seg_rows[li]);
        if (li == 0) {
            val first_filesz: usize = seg_off + segs[0].filesz;
            val first_memsz:  usize = seg_off + segs[0].memsz;
            pos = write_phdr(buf, pos, PT_LOAD, pf_flags_for(segs[0].flags), 0,
                hdr_vaddr, first_filesz, first_memsz, page_size);
        }
        or {
            pos = write_phdr(buf, pos, PT_LOAD, pf_flags_for(segs[li].flags), seg_off,
                segs[li].vaddr, segs[li].filesz, segs[li].memsz, page_size);
        }
        li = li + 1;
    }

    pos = write_phdr(buf, pos, PT_DYNAMIC, PF_R | PF_W, lay.dynamic_off, lay.dynamic_va,
        lay.dynamic_size, lay.dynamic_size, 8);
    if (eh_hdr.present) {
        pos = write_eh_frame_phdr(buf, pos, fp, seg_rows, segs, eh_hdr);
    }
    ret pos;
}

fun write_phdr(buf: *u8, pos: usize, p_type: u32, flags: u32, off: usize, vaddr: u64,
    filesz: usize, memsz: usize, align: u64) usize {
    bin.write_u32_le(buf, pos, p_type);
    bin.write_u32_le(buf, pos + 4, flags);
    bin.write_u64_le(buf, pos + 8, off::u64);
    bin.write_u64_le(buf, pos + 16, vaddr);
    bin.write_u64_le(buf, pos + 24, vaddr);
    bin.write_u64_le(buf, pos + 32, filesz::u64);
    bin.write_u64_le(buf, pos + 40, memsz::u64);
    bin.write_u64_le(buf, pos + 48, align);
    ret pos + PHDR_SIZE;
}

# the hex part of the bad-magic message: BAD_MAGIC_GROUPS bytes, each written as
# BAD_MAGIC_PREFIX and two hex digits, joined by BAD_MAGIC_SEP. the size and the
# writer both read these, so the layout has one owner
val BAD_MAGIC_PREFIX: str   = "0x";
val BAD_MAGIC_SEP:    str   = " ";
val BAD_MAGIC_GROUPS: usize = 4;

fun bad_magic_group_len() usize {
    ret str_len(BAD_MAGIC_PREFIX) + 2;
}

fun bad_magic_hex_len() usize {
    ret BAD_MAGIC_GROUPS * bad_magic_group_len() + (BAD_MAGIC_GROUPS - 1) * str_len(BAD_MAGIC_SEP);
}

# writes the group for b at dst[at] and returns its length
fun put_bad_magic_group(dst: *u8, at: usize, b: u8) usize {
    val hex: str   = "0123456789ABCDEF";
    val pl:  usize = str_len(BAD_MAGIC_PREFIX);
    memory.raw_copy((dst::usize + at)::ptr, BAD_MAGIC_PREFIX::ptr, pl);
    dst[at + pl]     = hex[(b >> 4)::usize];
    dst[at + pl + 1] = hex[(b & 0x0F)::usize];
    ret bad_magic_group_len();
}

fun bad_magic_message(itn: *intern.Interner, alloc: *A.Allocator, buf: *u8) res[str, fail.Fail] {
    val pre:   str               = "not an ELF object (expected 0x7F 'E' 'L' 'F', got ";
    val suf:   str               = ")";
    val lpre:  usize             = str_len(pre);
    val total: usize             = lpre + bad_magic_hex_len() + str_len(suf);
    val r:     res[*u8, A.Error] = A.allocate[u8](alloc, total + 1);
    if (sel r.err) { ret res[str, fail.Fail].err{fail.refused(r.err)}; }
    val msg: *u8 = r.ok;
    memory.raw_copy(msg::ptr, pre::ptr, lpre);
    var off: usize = lpre;
    var bi:  usize = 0;
    for (bi < BAD_MAGIC_GROUPS) {
        off = off + put_bad_magic_group(msg, off, buf[bi]);
        if (bi < BAD_MAGIC_GROUPS - 1) {
            memory.raw_copy((msg::usize + off)::ptr, BAD_MAGIC_SEP::ptr, str_len(BAD_MAGIC_SEP));
            off = off + str_len(BAD_MAGIC_SEP);
        }
        bi = bi + 1;
    }
    memory.raw_copy((msg::usize + off)::ptr, suf::ptr, str_len(suf));
    msg[total] = 0;
    if (itn == nil) { ret res[str, fail.Fail].ok{msg::str}; }
    ret fail.text_intern(itn, alloc, msg::str);
}

fun bad_class_message(itn: *intern.Interner, alloc: *A.Allocator, cls: u8) res[str, fail.Fail] {
    ret bin.number_message(itn, alloc, "unknown ELF class ", cls::u64);
}

# a section the runtime reaches by its name rather than through a relocation,
# which a final link keeps whatever references it
fun runtime_reached_name(name: str) bool {
    ret str_equals(name, ".init") || str_equals(name, ".fini") || str_equals(name, ".jcr")
        || str_equals(name, ".ctors") || str_equals(name, ".dtors")
        || str_starts_with(name, ".ctors.") || str_starts_with(name, ".dtors.");
}

# the plain bytes of a SHF_COMPRESSED section: its compression header names the
# format, the size and the alignment of the data it stands for, and the
# section takes all three, so relocations, which address the uncompressed
# data, and any output of the section see plain bytes
fun decompress_section(alloc: *A.Allocator, src: *u8, len: usize, lay: *ElfLayout, sec: *target_of.Section) err[fail.Fail] {
    var header: usize = 24;
    if (lay.class == ELFCLASS32) { header = 12; }
    if (len < header) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "a compressed section is shorter than its compression header")};
    }
    val kind:  u32 = bin.read_u32_le(src, 0);
    var size:  u64 = 0;
    var align: u64 = 0;
    if (lay.class == ELFCLASS32) {
        size  = bin.read_u32_le(src, 4)::u64;
        align = bin.read_u32_le(src, 8)::u64;
    }
    or {
        size  = bin.read_u64_le(src, 8);
        align = bin.read_u64_le(src, 16);
    }
    if (kind == ELFCOMPRESS_ZSTD) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "a section is compressed with zstd (ELFCOMPRESS_ZSTD), which this linker does not decompress; build the object with -gz=zlib or -gz=none")};
    }
    if (kind != ELFCOMPRESS_ZLIB) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "a section is compressed with a format other than zlib or zstd; build the object with -gz=zlib or -gz=none")};
    }
    if (size == 0 || size > 0xFFFFFFFF || align > 0xFFFFFFFF) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "a compressed section declares a size or alignment the linker cannot hold")};
    }
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, size::usize);
    if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
    val dst:     *u8                           = rb.ok;
    val zr:      res[usize, zlib.InflateError] = zlib.decompress_into(alloc, (src::usize + header)::*u8, len - header, dst, size::usize);
    var written: usize                         = 0;
    if (sel zr.ok) { written = zr.ok; }
    if (sel zr.err || written != size::usize) {
        A.deallocate[u8](alloc, dst, size::usize);
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "a zlib-compressed section does not inflate to the size its header declares")};
    }
    sec.bytes = dst;
    sec.len   = size::u32;
    sec.align = 1;
    if (align > 1) { sec.align = align::u32; }
    sec.native.flags = sec.native.flags & ~SHF_COMPRESSED;
    ret err[fail.Fail].ok{};
}

# a section of the processor-specific type an instruction set's unwind tables have
fun is_unwind_sht(ty: u32, machine: u16) bool {
    val row: *IsaRow = row_for_machine(machine);
    ret row != nil && row.unwind_sht != 0 && ty == row.unwind_sht;
}

fun section_has_bytes(ty: u32, machine: u16) bool {
    if (ty == SHT_PROGBITS || ty == SHT_NOBITS || ty == SHT_INIT_ARRAY
        || ty == SHT_FINI_ARRAY || ty == SHT_PREINIT_ARRAY || ty == SHT_GROUP) { ret true; }
    if (ty < SHT_LOPROC || ty > SHT_HIPROC) { ret false; }
    ret is_unwind_sht(ty, machine);
}

fun read_build_attributes(alloc: *A.Allocator, buf: *u8, buf_size: usize, lay: *ElfLayout,
    e_machine: u16, table: *SectionTable, out: *target_of.ObjectImage) err[fail.Fail] {
    out.attributes     = nil;
    out.attributes_len = 0;
    val row: *IsaRow = row_for_machine(e_machine);
    if (row == nil || !row.has_attributes) { ret err[fail.Fail].ok{}; }

    var si: u32 = 0;
    for (si < table.count) {
        val sh: ElfShdr = read_shdr(buf, table.off + si::usize * table.entsize, lay);
        si = si + 1;
        if (sh.stype != row.attributes.sht) { cnt; }

        val sec_off: usize          = sh.offset::usize;
        val sec_len: usize          = sh.size::usize;
        val region:  err[fail.Fail] = bin.require_region(buf_size, sec_off, sec_len, "build-attributes section out of bounds");
        if (sel region.err)                                { cnt; }
        if (sec_len < 2 || buf[sec_off] != ATTR_VERSION_A) { cnt; }

        var p:   usize = sec_off + 1;
        val end: usize = sec_off + sec_len;
        if (p + 4 > end) { cnt; }
        val vend_len: usize = bin.read_u32_le(buf, p)::usize;
        if (vend_len < 5 || p + vend_len > end) { cnt; }
        val vend_end: usize = p + vend_len;
        p = p + 4;
        val vstart: usize = p;
        for (p < vend_end && buf[p] != 0) { p = p + 1; }
        if (p >= vend_end) { cnt; }
        val vlen: usize = p - vstart;
        p = p + 1;
        if (vlen != 5) { cnt; }
        if (buf[vstart] != 114 || buf[vstart + 1] != 105 || buf[vstart + 2] != 115
            || buf[vstart + 3] != 99 || buf[vstart + 4] != 118) { cnt; }

        if (p >= vend_end || buf[p]::u32 != ATTR_TAG_FILE) { cnt; }
        p = p + 1;
        if (p + 4 > vend_end) { cnt; }
        val file_len: usize = bin.read_u32_le(buf, p)::usize;
        if (file_len < 5) { cnt; }
        val body_len: usize = file_len - 5;
        p = p + 4;
        if (p + body_len > vend_end || body_len == 0) { cnt; }

        val br: res[*u8, A.Error] = A.allocate[u8](alloc, body_len);
        if (sel br.err) { ret err[fail.Fail].err{fail.refused(br.err)}; }
        val body: *u8   = br.ok;
        var k:    usize = 0;
        for (k < body_len) {
            body[k] = buf[p + k];
            k       = k + 1;
        }
        out.attributes     = body;
        out.attributes_len = body_len::u32;
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].ok{};
}

pub fun parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *target_of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = target_of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < 16) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "ELF object too small")};
    }
    if (alloc == nil) { ret err[fail.Fail].err{fail.message("no allocator for parse")}; }
    if (itn == nil)   { ret err[fail.Fail].err{fail.message("no interner for parse")}; }

    var parsed: target_of.ObjectImage = target_of.object_image_init(alloc, itn, intern.STR_NIL);
    val built:  err[fail.Fail]        = parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (sel built.err) {
        target_of.object_image_dnit(?parsed);
        ret built;
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object_or_dnit(?parsed);
    if (sel valid.err) { ret valid; }
    @out = parsed;
    ret err[fail.Fail].ok{};
}

fun parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *target_of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = target_of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < 16) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "ELF object too small")};
    }
    if (buf[0] != 0x7F || buf[1] != 0x45 || buf[2] != 0x4C || buf[3] != 0x46) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_FORMAT_MISMATCH, bad_magic_message(itn, alloc, buf))};
    }
    if (itn == nil) { ret err[fail.Fail].err{fail.message("no interner for parse")}; }
    out.interner = itn;

    var lay: ElfLayout;
    if (!layout_from_class(buf[4], ?lay)) { ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_MALFORMED, bad_class_message(itn, alloc, buf[4]))}; }
    if (buf_size < lay.ehdr_size)         { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "ELF object too small")}; }

    val e_machine: u16 = bin.read_u16_le(buf, 18);
    out.machine_flags = bin.read_u32_le(buf, 24 + 3 * lay.addr_width::usize);
    val table: res[SectionTable, fail.Fail] = section_table(buf, buf_size, ?lay);
    if (sel table.err) { ret err[fail.Fail].err{table.err}; }
    val e_shoff:     usize = table.ok.off;
    val e_shentsize: usize = table.ok.entsize;
    val e_shnum:     u32   = table.ok.count;
    val e_shstrndx:  u32   = table.ok.shstrndx;
    if (e_shnum == 0) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "no section headers")}; }

    val vab: err[fail.Fail] = read_build_attributes(alloc, buf, buf_size, ?lay, e_machine, ?table.ok, out);
    if (sel vab.err) { ret vab; }

    var shstr_off:  usize = 0;
    var have_shstr: bool  = false;
    if (e_shstrndx < e_shnum) {
        val sh: ElfShdr = read_shdr(buf, e_shoff + e_shstrndx::usize * e_shentsize, ?lay);
        shstr_off = sh.offset::usize;
        val shstr_size: usize          = sh.size::usize;
        val vss:        err[fail.Fail] = bin.require_region(buf_size, shstr_off, shstr_size,
            "section-name string table out of bounds");
        if (sel vss.err) { ret vss; }
        have_shstr = true;
    }

    var strtab_off:   usize = 0;
    var strtab_size:  usize = 0;
    var have_strtab:  bool  = false;
    var symtab:       *u8   = nil;
    var symtab_count: u32   = 0;
    var symtab_index: u32   = 0;
    var xindex_link:  u32   = 0;
    var xindex:       *u8   = nil;
    var xindex_count: u32   = 0;
    var sh:           u32   = 0;
    for (sh < e_shnum) {
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize, ?lay);
        if (shh.stype == SHT_SYMTAB) {
            val symtab_off: usize = shh.offset::usize;
            val ent:        usize = shh.entsize::usize;
            if (ent > 0) {
                val raw_count: usize                        = shh.size::usize / ent;
                val fits:      res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(raw_count);
                if (sel fits.err) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "symbol table entry count exceeds the u32 limit")};
                }
                symtab_count = fits.ok;
            }
            val vsy: err[fail.Fail] = bin.require_region(buf_size, symtab_off,
                symtab_count::usize * lay.sym_size, "symbol table out of bounds");
            if (sel vsy.err) { ret vsy; }
            symtab       = (buf::usize + symtab_off)::*u8;
            symtab_index = sh;
            val link: u32 = shh.link;
            if (link < e_shnum) {
                val lh: ElfShdr = read_shdr(buf, e_shoff + link::usize * e_shentsize, ?lay);
                strtab_off  = lh.offset::usize;
                strtab_size = lh.size::usize;
                val vst: err[fail.Fail] = bin.require_region(buf_size, strtab_off, strtab_size,
                    "symbol string table out of bounds");
                if (sel vst.err) { ret vst; }
                have_strtab = true;
            }
        }
        if (shh.stype == SHT_SYMTAB_SHNDX) {
            val count: usize          = shh.size::usize / 4;
            val vx:    err[fail.Fail] = bin.require_region(buf_size, shh.offset::usize, count * 4, "symbol section index table out of bounds");
            if (sel vx.err) { ret vx; }
            xindex       = (buf::usize + shh.offset::usize)::*u8;
            xindex_count = count::u32;
            xindex_link  = shh.link;
        }
        sh = sh + 1;
    }
    if (xindex != nil && (symtab == nil || xindex_link != symtab_index)) { xindex = nil; }

    var sec_n:     u32                                      = 0;
    var rel_total: lang_checked.Count[target_of.Relocation] = lang_checked.count[target_of.Relocation](0::usize);
    sh = 0;
    for (sh < e_shnum) {
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize, ?lay);
        if (section_has_bytes(shh.stype, e_machine)) { sec_n = sec_n + 1; }
        if (shh.stype == SHT_RELA) {
            val term: lang_checked.Count[target_of.Relocation] =
                lang_checked.count[target_of.Relocation](shh.size::usize / lay.rela_size);
            val added: res[lang_checked.Count[target_of.Relocation], lang_checked.Cause] =
                lang_checked.count_add[target_of.Relocation](rel_total, term);
            if (sel added.err) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "relocation count exceeds the u32 limit")};
            }
            rel_total = added.ok;
        }
        sh = sh + 1;
    }
    val rel_n_fits: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(rel_total.value);
    if (sel rel_n_fits.err) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "relocation count exceeds the u32 limit")};
    }
    val rel_n:   u32 = rel_n_fits.ok;
    val sym_n:   u32 = symtab_count;
    var sym_pop: u32 = 0;
    if (sym_n > 0) { sym_pop = sym_n - 1; }

    if (sec_n > 0) {
        val rsec: res[*target_of.Section, A.Error] = A.zallocate[target_of.Section](alloc, sec_n::usize);
        if (sel rsec.err) { ret err[fail.Fail].err{fail.message("section array alloc failed")}; }
        out.sections    = rsec.ok;
        out.section_cap = sec_n;
    }
    if (sym_pop > 0) {
        val rsym: res[*target_of.Symbol, A.Error] = A.zallocate[target_of.Symbol](alloc, sym_pop::usize);
        if (sel rsym.err) { ret err[fail.Fail].err{fail.message("symbol array alloc failed")}; }
        out.symbols    = rsym.ok;
        out.symbol_cap = sym_pop;
    }
    if (rel_n > 0) {
        val rrel: res[*target_of.Relocation, A.Error] = A.zallocate[target_of.Relocation](alloc, rel_n::usize);
        if (sel rrel.err) { ret err[fail.Fail].err{fail.message("reloc array alloc failed")}; }
        out.relocations = rrel.ok;
        out.reloc_cap   = rel_n;
    }

    out.section_count = sec_n;
    out.symbol_count  = sym_pop;
    out.reloc_count   = rel_n;

    val res_map: res[*i32, A.Error] = A.zallocate[i32](alloc, e_shnum::usize);
    if (sel res_map.err) { ret err[fail.Fail].err{fail.message("section map alloc failed")}; }
    var sec_map: *i32 = res_map.ok;

    var sec_i: u32 = 0;
    sh = 0;
    for (sh < e_shnum) {
        sec_map[sh] = -1;
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize, ?lay);
        val ty:  u32     = shh.stype;
        if (section_has_bytes(ty, e_machine)) {
            val flags: u64 = shh.flags;

            var sec_name: str = "";
            if (have_shstr) {
                val rnm: res[str, fail.Fail] = bin.cstr_at(buf, buf_size, shstr_off + shh.name::usize);
                if (sel rnm.err) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{rnm.err};
                }
                sec_name = rnm.ok;
            }

            var kind: target_of.SectionKind = target_of.SK_DATA;
            if (str_equals(sec_name, ".data.rel.ro")) { kind = target_of.SK_RELRO; }
            or ((flags & SHF_ALLOC) == 0)             { kind = target_of.SK_DEBUG; }
            or ((flags & SHF_EXECINSTR) != 0)         { kind = target_of.SK_TEXT; }
            or (ty == SHT_NOBITS)                     { kind = target_of.SK_BSS; }
            or ((flags & SHF_WRITE) == 0)             { kind = target_of.SK_RODATA; }

            val rin: res[intern.StrId, A.Error] = intern.add(itn, sec_name);
            if (sel rin.err) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret err[fail.Fail].err{fail.refused(rin.err)};
            }

            val idx: u32 = sec_i;
            out.sections[idx].name              = rin.ok;
            out.sections[idx].kind              = kind;
            out.sections[idx].align             = shh.addralign::u32;
            out.sections[idx].len               = shh.size::u32;
            out.sections[idx].bytes             = nil;
            out.sections[idx].flags             = 0;
            out.sections[idx].native.format     = target_of.ELF;
            out.sections[idx].native.flags      = flags;
            out.sections[idx].native.kind       = ty;
            out.sections[idx].native.entry_size = shh.entsize;
            if (ty == SHT_INIT_ARRAY) { out.sections[idx].flags = target_of.SEC_FLAG_INIT_FUNCS; }
            if ((flags & SHF_MERGE) != 0
                && shh.entsize == out.sections[idx].len::u64
                && out.sections[idx].len > 0) {
                out.sections[idx].flags = target_of.SEC_FLAG_MERGEABLE;
            }
            if ((flags & SHF_GNU_RETAIN) != 0 || ty == SHT_FINI_ARRAY || ty == SHT_PREINIT_ARRAY
                || runtime_reached_name(sec_name)) {
                out.sections[idx].flags = out.sections[idx].flags | target_of.SEC_FLAG_RETAIN;
            }
            if (ty == SHT_GROUP) { out.sections[idx].flags = out.sections[idx].flags | target_of.SEC_FLAG_GROUP; }
            # the object's own frame descriptions, which a link building unwind tables carries into them
            if ((flags & SHF_ALLOC) != 0 && (is_unwind_sht(ty, e_machine) || str_equals(sec_name, ".eh_frame"))) {
                out.sections[idx].flags = out.sections[idx].flags | target_of.SEC_FLAG_UNWIND_FRAMES;
            }
            if (ty != SHT_NOBITS && out.sections[idx].len > 0) {
                val sz:      usize = out.sections[idx].len::usize;
                val src_off: usize = shh.offset::usize;
                if (!bin.region_ok(buf_size, src_off, sz)) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "section data out of bounds")};
                }
                val src: *u8 = (buf::usize + src_off)::*u8;
                if ((flags & SHF_COMPRESSED) != 0) {
                    val dr: err[fail.Fail] = decompress_section(alloc, src, sz, ?lay, ?out.sections[idx]);
                    if (sel dr.err) {
                        A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                        ret dr;
                    }
                }
                or {
                    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, sz);
                    if (sel rb.err) {
                        A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                        ret err[fail.Fail].err{fail.message("section bytes alloc failed")};
                    }
                    out.sections[idx].bytes = rb.ok;
                    memory.raw_copy(out.sections[idx].bytes::ptr, src::ptr, sz);
                }
            }
            sec_map[sh] = idx::i32;
            sec_i       = sec_i + 1;
        }
        sh = sh + 1;
    }

    sh = 0;
    for (sh < e_shnum) {
        if (sec_map[sh] >= 0) {
            val header:  ElfShdr            = read_shdr(buf, e_shoff + sh::usize * e_shentsize, ?lay);
            val section: *target_of.Section = ?out.sections[sec_map[sh]::u32];
            if (header.stype == SHT_INIT_ARRAY) { section.flags = section.flags | target_of.SEC_FLAG_INIT_FUNCS; }
            if (header.stype == SHT_GROUP) {
                if (header.info == 0 || header.info >= sym_n || section.len < 4 || section.len % 4 != 0) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed section group")};
                }
                section.native.link_symbol = header.info;
                var at: usize = 4;
                for (at < section.len::usize) {
                    val member: u32 = bin.read_u32_le(section.bytes, at);
                    if (member >= e_shnum) {
                        A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "section group member is out of range")};
                    }
                    var mapped: u32 = 0;
                    if (sec_map[member] >= 0) { mapped = sec_map[member]::u32 + 1; }
                    or {
                        val relation: ElfShdr = read_shdr(buf, e_shoff + member::usize * e_shentsize, ?lay);
                        if (relation.stype != SHT_RELA || relation.info >= e_shnum || sec_map[relation.info] < 0) {
                            A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "section group has an unrepresented member")};
                        }
                        mapped = target_of.NATIVE_GROUP_RELOC | (sec_map[relation.info]::u32 + 1);
                    }
                    bin.write_u32_le(section.bytes, at, mapped);
                    at = at + 4;
                }
            }
            or (header.link != 0) {
                if (header.link >= e_shnum || sec_map[header.link] < 0) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "section link has an unrepresented target")};
                }
                section.native.link_section = sec_map[header.link]::u32 + 1;
                if ((header.flags & SHF_LINK_ORDER) != 0) { section.flags = section.flags | target_of.SEC_FLAG_ASSOCIATED; }
            }
        }
        sh = sh + 1;
    }

    var sym_i: u32 = 0;
    if (symtab != nil && have_strtab) {
        var si: u32 = 1;
        for (si < sym_n) {
            val sym:      ElfSym = read_sym(symtab, si::usize * lay.sym_size, ?lay);
            val st_info:  u8     = sym.info;
            val st_shndx: u16    = sym.shndx;
            # an index in the reserved range names no section unless it is
            # SHN_XINDEX, which defers to the symbol's .symtab_shndx entry
            var section_index: u32 = e_shnum;
            if (st_shndx == SHN_XINDEX) {
                if (xindex == nil || si >= xindex_count) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "extended symbol section index has no .symtab_shndx entry")};
                }
                section_index = bin.read_u32_le(xindex, si::usize * 4);
            }
            or (st_shndx::u32 < SHN_LORESERVE) { section_index = st_shndx::u32; }

            val rnm: res[str, fail.Fail] = bin.cstr_at(buf, buf_size, strtab_off + sym.name::usize);
            if (sel rnm.err) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret err[fail.Fail].err{rnm.err};
            }
            val rin: res[intern.StrId, A.Error] = intern.add(itn, rnm.ok);
            if (sel rin.err) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret err[fail.Fail].err{fail.refused(rin.err)};
            }

            val idx: u32 = sym_i;
            out.symbols[idx].name   = rin.ok;
            out.symbols[idx].offset = sym.value::u32;
            out.symbols[idx].size   = sym.size::u32;
            out.symbols[idx].native = target_of.NativeSymbol{format: target_of.ELF, kind: st_info::u32, flags: sym.other::u32};
            if (sym.size > 0xFFFFFFFF || (st_shndx != SHN_ABS && sym.value > 0xFFFFFFFF)) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "symbol extent exceeds represented width")};
            }
            var flags: u32 = 0;
            if ((st_info >> 4) == STB_GLOBAL || (st_info >> 4) == 10) { flags = flags | target_of.SYM_OBJ_FLAG_GLOBAL; }
            or ((st_info >> 4) == STB_WEAK)                           { flags = flags | target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_WEAK; }
            if ((st_info & 0xF) == STT_FUNC)                          { flags = flags | target_of.SYM_OBJ_FLAG_FUNCTION; }
            or ((st_info & 0xF) == STT_OBJECT)                        { flags = flags | target_of.SYM_OBJ_FLAG_OBJECT; }
            val visibility: u8 = sym.other & 3;
            if (visibility == STV_HIDDEN || visibility == STV_INTERNAL) { flags = flags | target_of.SYM_OBJ_FLAG_HIDDEN; }
            if (st_shndx == 0) {
                flags                    = flags | target_of.SYM_OBJ_FLAG_EXTERN;
                out.symbols[idx].section = target_of.external_section();
            }
            or (st_shndx == SHN_ABS) {
                out.symbols[idx].section        = target_of.absolute_section();
                out.symbols[idx].offset         = 0;
                out.symbols[idx].absolute_value = sym.value;
            }
            or (st_shndx == SHN_COMMON) {
                if (sym.value > 0xFFFFFFFF || sym.size > 0xFFFFFFFF) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "common symbol exceeds represented size or alignment")};
                }
                flags                    = flags | target_of.SYM_OBJ_FLAG_EXTERN | target_of.SYM_OBJ_FLAG_COMMON;
                out.symbols[idx].section = target_of.external_section();
                out.symbols[idx].offset  = 0;
                out.symbols[idx].align   = sym.value::u32;
            }
            or (section_index < e_shnum && sec_map[section_index] >= 0) {
                out.symbols[idx].section = target_of.section_id(sec_map[section_index]::u32);
            }
            or {
                out.symbols[idx].section = target_of.external_section();
            }
            out.symbols[idx].flags = flags;
            sym_i                  = sym_i + 1;
            si                     = si + 1;
        }
    }

    var rel_i: u32 = 0;
    sh = 0;
    for (sh < e_shnum) {
        val shh: ElfShdr = read_shdr(buf, e_shoff + sh::usize * e_shentsize, ?lay);
        if (shh.stype == SHT_RELA) {
            val r_base:  usize = shh.offset::usize;
            val sh_info: u32   = shh.info;
            val count:   u32   = (shh.size::usize / lay.rela_size)::u32;
            if (!bin.region_ok(buf_size, r_base, count::usize * lay.rela_size)) {
                A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "relocation array out of bounds")};
            }
            var target_sec: i32 = -1;
            if (sh_info < e_shnum) { target_sec = sec_map[sh_info]; }

            var ri: u32 = 0;
            for (ri < count) {
                var r_offset: u64 = 0;
                var r_sym:    u32 = 0;
                var r_type:   u32 = 0;
                var r_addend: i64 = 0;
                read_rela(buf, r_base + ri::usize * lay.rela_size, ?lay,
                    ?r_offset, ?r_sym, ?r_type, ?r_addend);

                val idx: u32 = rel_i;
                if (target_sec >= 0) { out.relocations[idx].section = target_of.section_id(target_sec::u32); }
                or                   { out.relocations[idx].section = target_of.external_section(); }
                out.relocations[idx].offset = r_offset::u32;
                out.relocations[idx].addend = r_addend;
                val rk: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(itn, alloc, e_machine, r_type);
                if (sel rk.err) {
                    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
                    ret err[fail.Fail].err{rk.err};
                }
                out.relocations[idx].kind = rk.ok;
                if (r_sym > 0 && (r_sym - 1) < sym_i) {
                    out.relocations[idx].sym = r_sym - 1;
                }
                or {
                    out.relocations[idx].sym = target_of.SYMBOL_NONE;
                }
                rel_i = rel_i + 1;
                ri    = ri + 1;
            }
        }
        sh = sh + 1;
    }

    A.deallocate[i32](alloc, sec_map, e_shnum::usize);
    val requests: err[fail.Fail] = decode_export_requests(alloc, itn, out);
    if (sel requests.err) { ret requests; }
    val recorded: err[fail.Fail] = record.consume(itn, out, record.SECTION_NAME);
    if (sel recorded.err) { ret recorded; }
    ret carrier.consume(itn, out, carrier.SECTION_NAME);
}

# `.mach.exports` carries the request list into the image and is consumed
fun decode_export_requests(alloc: *A.Allocator, itn: *intern.Interner, out: *target_of.ObjectImage) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.add(itn, exports.SECTION_NAME);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val found: opt[u32] = exports.find(out, name_r.ok);
    if (sel found.none) { ret err[fail.Fail].ok{}; }
    ret exports.decode(alloc, itn, out, found.some);
}
