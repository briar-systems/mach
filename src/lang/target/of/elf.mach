    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_reloc_ovf");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var rela_so:     usize = 0;
    var sh:          usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (bin.read_u32_le(buf.data, so + 4) == SHT_RELA) { rela_so = so; }
        sh = sh + 1;
    }
    if (rela_so == 0) { ret 1; }
    bin.write_u64_le(buf.data, rela_so + 32, 0xFFFFFFFFFFFFFFF0);

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!sel pr.err)                                     { ret 1; }
    if (!str_contains(fail.describe(pr.err), "exceeds")) { ret 1; }
    ret 0;
}

