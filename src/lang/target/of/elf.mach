test "mach.lang.target.of.elf.emit_exec:debug_sections_nonalloc" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    var line_bytes: [3]u8;
    line_bytes[0] = 0x11; line_bytes[1] = 0x22; line_bytes[2] = 0x33;

    val nm_info: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_info");
    val nm_line: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_line");
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }
    if (R.is_err[intern.StrId, str](nm_line)) { ret 1; }

    var dbg: [2]of.Section;
    dbg[0].name = R.unwrap_ok[intern.StrId, str](nm_info); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;
    dbg[1].name = R.unwrap_ok[intern.StrId, str](nm_line); dbg[1].kind = of.SK_DEBUG;
    dbg[1].bytes = ?line_bytes[0]; dbg[1].len = 3; dbg[1].align = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_dbg");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                            4096, 0x400000, 0x401000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            ?dbg[0], 2, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "elfdbg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;

    val e_shoff:    usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shnum:    u32 = bin.read_u16_le(buf.data, 60)::u32;
    val e_shstrndx: u32 = bin.read_u16_le(buf.data, 62)::u32;
    if (e_shoff == 0)    { bad = true; }
    if (e_shnum != 6)    { bad = true; }
    if (e_shstrndx != 5) { bad = true; }

    if (bad) { ret 1; }

    val shstr_hdr:  usize = e_shoff + e_shstrndx::usize * SHDR_SIZE;
    val shstr_base: usize = bin.read_u64_le(buf.data, shstr_hdr + 24)::usize;

    val info_want: str = ".debug_info";
    val line_want: str = ".debug_line";

    # the build id note is the allocated section between the segment and the debug sections
    val shn: usize = e_shoff + 2 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, shn + 4) != SHT_NOTE)             { bad = true; }
    if ((bin.read_u64_le(buf.data, shn + 8) & SHF_ALLOC) == 0)      { bad = true; }
    if (bin.read_u64_le(buf.data, shn + 32)::usize != buildid.ELF_NOTE_SIZE) { bad = true; }
    if (!buildid.elf_note_header_valid((buf.data::usize + bin.read_u64_le(buf.data, shn + 24)::usize)::*u8)) { bad = true; }

    val sh2: usize = e_shoff + 3 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, sh2 + 4) != SHT_PROGBITS)         { bad = true; }
    if ((bin.read_u64_le(buf.data, sh2 + 8) & SHF_ALLOC) != 0)      { bad = true; }
    if (bin.read_u64_le(buf.data, sh2 + 16) != 0)                   { bad = true; }
    if (bin.read_u64_le(buf.data, sh2 + 32)::usize != 4)            { bad = true; }
    val n2: usize = shstr_base + bin.read_u32_le(buf.data, sh2)::usize;
    var j: usize = 0;
    for (j < str_len(info_want)) { if (buf.data[n2 + j] != info_want[j]) { bad = true; } j = j + 1; }
    if (buf.data[n2 + str_len(info_want)] != 0)                     { bad = true; }
    val off2: usize = bin.read_u64_le(buf.data, sh2 + 24)::usize;
    if (buf.data[off2] != 0xDE || buf.data[off2 + 1] != 0xAD
        || buf.data[off2 + 2] != 0xBE || buf.data[off2 + 3] != 0xEF) { bad = true; }

    val sh3: usize = e_shoff + 4 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, sh3 + 4) != SHT_PROGBITS)         { bad = true; }
    if ((bin.read_u64_le(buf.data, sh3 + 8) & SHF_ALLOC) != 0)      { bad = true; }
    if (bin.read_u64_le(buf.data, sh3 + 16) != 0)                   { bad = true; }
    if (bin.read_u64_le(buf.data, sh3 + 32)::usize != 3)            { bad = true; }
    val n3: usize = shstr_base + bin.read_u32_le(buf.data, sh3)::usize;
    j = 0;
    for (j < str_len(line_want)) { if (buf.data[n3 + j] != line_want[j]) { bad = true; } j = j + 1; }
    if (buf.data[n3 + str_len(line_want)] != 0)                     { bad = true; }
    val off3: usize = bin.read_u64_le(buf.data, sh3 + 24)::usize;
    if (buf.data[off3] != 0x11 || buf.data[off3 + 1] != 0x22 || buf.data[off3 + 2] != 0x33) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

# the build id descriptor of an ELF64 image, located through its PT_NOTE
fun t_note_desc(buf: *u8, total: usize) usize {
    val e_phoff: usize = bin.read_u64_le(buf, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf, 56)::usize;
    var i: usize = 0;
    for (i < e_phnum) {
        val ph: usize = e_phoff + i * PHDR_SIZE;
        if (bin.read_u32_le(buf, ph) == PT_NOTE) {
            val off: usize = bin.read_u64_le(buf, ph + 8)::usize;
            if (off + buildid.ELF_NOTE_SIZE > total || !buildid.elf_note_header_valid((buf::usize + off)::*u8)) { ret 0; }
            ret off + buildid.ELF_NOTE_HEADER;
        }
        i = i + 1;
    }
    ret 0;
}

# an independent statement of the hash input: every PT_LOAD extent of an ELF64
# image in table order, with the section-table header fields and the note
# payload as zero
fun t_loaded_digest(alloc: *A.Allocator, image: *Vector[u8], out: *u8) bool {
    val total: usize = image.len;
    val copy_r: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](copy_r)) { ret false; }
    val copy: *u8 = R.unwrap_ok[*u8, str](copy_r);
    fin { A.deallocate[u8](alloc, copy, total); }
    memory.raw_copy(copy::ptr, image.data::ptr, total);
    val desc: usize = t_note_desc(copy, total);
    if (desc == 0) { ret false; }
    var k: usize = 0;
    for (k < buildid.DIGEST_LEN) { copy[desc + k] = 0; k = k + 1; }
    bin.write_u64_le(copy, 40, 0);
    bin.write_u16_le(copy, 60, 0);
    bin.write_u16_le(copy, 62, 0);
    var st: sha256.State = sha256.init();
    val e_phoff: usize = bin.read_u64_le(copy, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(copy, 56)::usize;
    var i: usize = 0;
    for (i < e_phnum) {
        val ph: usize = e_phoff + i * PHDR_SIZE;
        if (bin.read_u32_le(copy, ph) == PT_LOAD) {
            sha256.update(?st, (copy::usize + bin.read_u64_le(copy, ph + 8)::usize)::*u8, bin.read_u64_le(copy, ph + 32)::usize);
        }
        i = i + 1;
    }
    sha256.final(?st, out);
    ret true;
}

fun t_emit_exec_bytes(alloc: *A.Allocator, i: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                      debug: *of.Section, debug_count: u32, tpath: str) R.Result[Vector[u8], str] {
    val em: R.Result[R.Void, str] = t_planned_emit_exec(alloc, i, isa_vt, segs, 1,
                                            4096, 0x400000, 0x401000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            debug, debug_count, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "elfid"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret R.err[Vector[u8], str](R.unwrap_err[R.Void, str](em)); }
    ret fs.read_bytes(alloc, tpath);
}

test "mach.lang.target.of.elf.emit_exec:build_id_hashes_the_loaded_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    val nm_info: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_info");
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name = R.unwrap_ok[intern.StrId, str](nm_info); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_build_id");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val plain_r: R.Result[Vector[u8], str] = t_emit_exec_bytes(?alloc, ?i, ?isa_vt, ?segs[0], nil::*of.Section, 0, tpath);
    if (R.is_err[Vector[u8], str](plain_r)) { ret 2; }
    var plain: Vector[u8] = R.unwrap_ok[Vector[u8], str](plain_r);
    val plain_desc: usize = t_note_desc(plain.data, plain.len);
    if (plain_desc == 0) { ret 3; }
    # the note is inside the header mapping and the header page is loaded
    if (bin.read_u64_le(plain.data, 64 + 8) != 0 || bin.read_u64_le(plain.data, 64 + 32)::usize < plain_desc + buildid.DIGEST_LEN) { ret 4; }

    var expected: [32]u8;
    if (!t_loaded_digest(?alloc, ?plain, ?expected[0])) { ret 5; }
    if (!memory.raw_equal((plain.data::usize + plain_desc)::ptr, (?expected[0])::ptr, 32)) { ret 6; }
    var zero: bool = true;
    k = 0;
    for (k < 32) { if (plain.data[plain_desc + k] != 0) { zero = false; } k = k + 1; }
    if (zero) { ret 7; }

    # debug information adds only unmapped bytes, so the identity is unchanged
    val with_debug_r: R.Result[Vector[u8], str] = t_emit_exec_bytes(?alloc, ?i, ?isa_vt, ?segs[0], ?dbg[0], 1, tpath);
    if (R.is_err[Vector[u8], str](with_debug_r)) { ret 8; }
    val with_debug: Vector[u8] = R.unwrap_ok[Vector[u8], str](with_debug_r);
    val debug_desc: usize = t_note_desc(with_debug.data, with_debug.len);
    if (debug_desc != plain_desc || with_debug.len == plain.len) { ret 9; }
    if (!memory.raw_equal((with_debug.data::usize + debug_desc)::ptr, (plain.data::usize + plain_desc)::ptr, 32)) { ret 10; }

    # one loaded byte changes it
    text[3] = 0xC3;
    val changed_r: R.Result[Vector[u8], str] = t_emit_exec_bytes(?alloc, ?i, ?isa_vt, ?segs[0], nil::*of.Section, 0, tpath);
    if (R.is_err[Vector[u8], str](changed_r)) { ret 11; }
    val changed: Vector[u8] = R.unwrap_ok[Vector[u8], str](changed_r);
    val changed_desc: usize = t_note_desc(changed.data, changed.len);
    if (changed_desc != plain_desc) { ret 12; }
    if (memory.raw_equal((changed.data::usize + changed_desc)::ptr, (plain.data::usize + plain_desc)::ptr, 32)) { ret 13; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_pie_exec:debug_sections_trailing_nonloaded" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    var dyn: of.DynamicInfo;
    dyn.libs = nil;          dyn.lib_count = 0;
    dyn.imports = nil;       dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil;   dyn.base_reloc_count = 0;
    dyn.pie = true;

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    val nm_info: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_info");
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name = R.unwrap_ok[intern.StrId, str](nm_info); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_pie_dbg");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, 0x401000, ?dyn, ?dbg[0], 1, nil::*of.SymtabEntry, 0, tpath::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;
    if (bin.read_u16_le(buf.data, 16) != ET_DYN) { bad = true; }

    val e_shoff:    usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shnum:    u32 = bin.read_u16_le(buf.data, 60)::u32;
    val e_shstrndx: u32 = bin.read_u16_le(buf.data, 62)::u32;
    if (e_shoff == 0)    { bad = true; }
    if (e_shnum != 3)    { bad = true; }
    if (e_shstrndx != 2) { bad = true; }
    if (bad) { ret 1; }

    val sh1: usize = e_shoff + 1 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, sh1 + 4) != SHT_PROGBITS)    { bad = true; }
    if ((bin.read_u64_le(buf.data, sh1 + 8) & SHF_ALLOC) != 0) { bad = true; }
    if (bin.read_u64_le(buf.data, sh1 + 16) != 0)              { bad = true; }
    if (bin.read_u64_le(buf.data, sh1 + 32)::usize != 4)       { bad = true; }
    val sh_off: usize = bin.read_u64_le(buf.data, sh1 + 24)::usize;
    if (buf.data[sh_off] != 0xDE || buf.data[sh_off + 1] != 0xAD
        || buf.data[sh_off + 2] != 0xBE || buf.data[sh_off + 3] != 0xEF) { bad = true; }

    val shstr_hdr:  usize = e_shoff + e_shstrndx::usize * SHDR_SIZE;
    val shstr_base: usize = bin.read_u64_le(buf.data, shstr_hdr + 24)::usize;
    val n1: usize = shstr_base + bin.read_u32_le(buf.data, sh1)::usize;
    val info_want: str = ".debug_info";
    var j: usize = 0;
    for (j < str_len(info_want)) { if (buf.data[n1 + j] != info_want[j]) { bad = true; } j = j + 1; }
    if (buf.data[n1 + str_len(info_want)] != 0) { bad = true; }

    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var ph: usize = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, po) == PT_LOAD) {
            val pf:  usize = bin.read_u64_le(buf.data, po + 8)::usize;
            val psz: usize = bin.read_u64_le(buf.data, po + 32)::usize;
            if (sh_off >= pf && sh_off < pf + psz) { bad = true; }
        }
        ph = ph + 1;
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_shared:debug_additive_nonloaded" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    val add_r: R.Result[intern.StrId, str] = intern.intern(?i, "add_fn");
    if (R.is_err[intern.StrId, str](add_r)) { ret 1; }
    var exports: [1]of.ExportSym;
    exports[0].name = R.unwrap_ok[intern.StrId, str](add_r); exports[0].vaddr = 0x401000; exports[0].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;          dyn.lib_count = 0;
    dyn.imports = nil;       dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil;   dyn.base_reloc_count = 0;
    dyn.pie = true;

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    val nm_info: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_info");
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name = R.unwrap_ok[intern.StrId, str](nm_info); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_shared_add");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tp: str = output.path(?tf);

    val e1: R.Result[R.Void, str] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 1, ?dyn, ?dbg[0], 1, nil::*of.SymtabEntry, 0, tp::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](e1)) { ret 1; }
    val rb1: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tp);
    if (R.is_err[Vector[u8], str](rb1)) { ret 1; }
    val b1: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb1);

    val e2: R.Result[R.Void, str] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 1, ?dyn, nil::*of.Section, 0, nil::*of.SymtabEntry, 0, tp::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](e2)) { ret 1; }
    val rb2: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tp);

    if (R.is_err[Vector[u8], str](rb2)) { ret 1; }
    val b2: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb2);

    var bad: bool = false;

    if (bin.read_u64_le(b2.data, 40) != 0) { bad = true; }
    if (bin.read_u64_le(b1.data, 40) == 0) { bad = true; }

    if (b1.len < b2.len) { bad = true; }
    or {
        var j: usize = 0;
        for (j < b2.len) {
            if (j >= 40 && j < 48) { j = j + 1; cnt; }
            if (j >= 60 && j < 64) { j = j + 1; cnt; }
            if (b1.data[j] != b2.data[j]) { bad = true; j = b2.len; cnt; }
            j = j + 1;
        }
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_shared:dynamic_sections_in_sht" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    val add_r: R.Result[intern.StrId, str] = intern.intern(?i, "add_fn");
    val mul_r: R.Result[intern.StrId, str] = intern.intern(?i, "mul_fn");
    if (R.is_err[intern.StrId, str](add_r) || R.is_err[intern.StrId, str](mul_r)) { ret 1; }
    var exports: [2]of.ExportSym;
    exports[0].name = R.unwrap_ok[intern.StrId, str](add_r); exports[0].vaddr = 0x401000; exports[0].is_func = true;
    exports[1].name = R.unwrap_ok[intern.StrId, str](mul_r); exports[1].vaddr = 0x401008; exports[1].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs = nil;          dyn.lib_count = 0;
    dyn.imports = nil;       dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil;   dyn.base_reloc_count = 0;
    dyn.pie = true;

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE; info_bytes[1] = 0xAD; info_bytes[2] = 0xBE; info_bytes[3] = 0xEF;
    val nm_info: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_info");
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name = R.unwrap_ok[intern.StrId, str](nm_info); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0]; dbg[0].len = 4; dbg[0].align = 1;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_shared_sht");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tp: str = output.path(?tf);
    val em: R.Result[R.Void, str] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 2, ?dyn, ?dbg[0], 1, nil::*of.SymtabEntry, 0, tp::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tp);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;

    val e_shoff:  usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shnum:  u32   = bin.read_u16_le(buf.data, 60)::u32;
    if (e_shoff == 0 || e_shnum == 0) { ret 1; }

    var dynsym_hdr: usize = 0;
    var have_dynamic: bool = false;
    var sh: u32 = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh::usize * SHDR_SIZE;
        val ty: u32 = bin.read_u32_le(buf.data, so + 4);
        if (ty == SHT_DYNSYM)  { dynsym_hdr = so; }
        if (ty == SHT_DYNAMIC) { have_dynamic = true; }
        sh = sh + 1;
    }
    if (dynsym_hdr == 0) { bad = true; }
    if (!have_dynamic)   { bad = true; }

    if (dynsym_hdr != 0) {
        if ((bin.read_u64_le(buf.data, dynsym_hdr + 8) & SHF_ALLOC) == 0)     { bad = true; }
        if (bin.read_u64_le(buf.data, dynsym_hdr + 32)::usize != 3 * SYM_SIZE) { bad = true; }
        val link: u32 = bin.read_u32_le(buf.data, dynsym_hdr + 40);
        if (link == 0 || link >= e_shnum) { bad = true; }
        or {
            val lho: usize = e_shoff + link::usize * SHDR_SIZE;
            if (bin.read_u32_le(buf.data, lho + 4) != SHT_STRTAB) { bad = true; }
        }

        val dynsym_off: usize = bin.read_u64_le(buf.data, dynsym_hdr + 24)::usize;
        val shndx: u32 = bin.read_u16_le(buf.data, dynsym_off + SYM_SIZE + 6)::u32;
        if (shndx == 0 || shndx >= e_shnum) { bad = true; }
        or {
            val tho: usize = e_shoff + shndx::usize * SHDR_SIZE;
            val tty: u32 = bin.read_u32_le(buf.data, tho + 4);
            val tfl: u64 = bin.read_u64_le(buf.data, tho + 8);
            if (tty != SHT_PROGBITS)             { bad = true; }
            if ((tfl & SHF_ALLOC) == 0)          { bad = true; }
            if ((tfl & SHF_EXECINSTR) == 0)      { bad = true; }
        }
    }

    if (bad) { ret 1; }
    ret 0;
}

fun t_any_load_overlap(buf: *Vector[u8]) bool {
    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var i: usize = 0;
    for (i < e_phnum) {
        val ioff: usize = e_phoff + i * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, ioff) != PT_LOAD) { i = i + 1; cnt; }
        val ia: u64 = bin.read_u64_le(buf.data, ioff + 16);
        val iz: u64 = bin.read_u64_le(buf.data, ioff + 40);
        var j: usize = i + 1;
        for (j < e_phnum) {
            val joff: usize = e_phoff + j * PHDR_SIZE;
            if (bin.read_u32_le(buf.data, joff) != PT_LOAD) { j = j + 1; cnt; }
            val ja: u64 = bin.read_u64_le(buf.data, joff + 16);
            val jz: u64 = bin.read_u64_le(buf.data, joff + 40);
            if (iz > 0 && jz > 0 && ia < ja + jz && ja < ia + iz) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.target.of.elf.emit_exec:load_segments_do_not_overlap" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var data: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x90; data[k] = 0; k = k + 1; }
    var segs: [2]of.LoadSegment;
    segs[0].vaddr = 0x400000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];
    segs[1].vaddr = 0x401000; segs[1].filesz = 16; segs[1].memsz = 16;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE; segs[1].bytes = ?data[0];

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_overlap");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val em: R.Result[R.Void, str] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2, 4096, 0x400000, 0x400000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, nil::*u8, opts);
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    var buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: i32 = 0;
    if (t_any_load_overlap(?buf)) { bad = 1; }
    ret bad;
}

fun t_isa32(id: u32, elf_machine: u32, reloc: *isa.RelocSeam) of.ObjectTarget {
    var vt: isa.IsaVTable = isa.machine_isa(id, "test32", elf_machine, 4, nil, nil, reloc);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

test "mach.lang.target.of.elf.write_phdr_at:elf32_field_order" {
    var bad: bool = false;

    var l32: ElfLayout = elf32_layout();
    var l64: ElfLayout = elf64_layout();
    if (l32.phdr_size != 32 || l64.phdr_size != 56) { bad = true; }
    if (l32.ehdr_size != 52 || l32.shdr_size != 40) { bad = true; }
    if (l32.sym_size  != 16 || l32.rela_size != 12) { bad = true; }

    var b32: [64]u8;
    var b64: [64]u8;
    var k: usize = 0;
    for (k < 64) { b32[k] = 0; b64[k] = 0; k = k + 1; }

    val end32: usize = write_phdr_at(?b32[0], 0, ?l32, PT_LOAD, PF_R | PF_X,
                                     0x11, 0x22, 0x33, 0x44, 0x55, 0x1000);
    val end64: usize = write_phdr_at(?b64[0], 0, ?l64, PT_LOAD, PF_R | PF_X,
                                     0x11, 0x22, 0x33, 0x44, 0x55, 0x1000);
    if (end32 != 32 || end64 != 56) { bad = true; }

    if (bin.read_u32_le(?b32[0], 0)  != PT_LOAD)         { bad = true; }
    if (bin.read_u32_le(?b32[0], 4)  != 0x11)            { bad = true; }
    if (bin.read_u32_le(?b32[0], 8)  != 0x22)            { bad = true; }
    if (bin.read_u32_le(?b32[0], 12) != 0x33)            { bad = true; }
    if (bin.read_u32_le(?b32[0], 16) != 0x44)            { bad = true; }
    if (bin.read_u32_le(?b32[0], 20) != 0x55)            { bad = true; }
    if (bin.read_u32_le(?b32[0], 24) != (PF_R | PF_X))   { bad = true; }
    if (bin.read_u32_le(?b32[0], 28) != 0x1000)          { bad = true; }

    if (bin.read_u32_le(?b64[0], 4)  != (PF_R | PF_X))   { bad = true; }
    if (bin.read_u64_le(?b64[0], 8)  != 0x11)            { bad = true; }

    var s32: [32]u8;
    var s64: [32]u8;
    k = 0;
    for (k < 32) { s32[k] = 0; s64[k] = 0; k = k + 1; }
    val se32: usize = write_sym_at(?s32[0], 0, ?l32, 7, 0x12, 0, 3, 0xAABB, 0xCC);
    val se64: usize = write_sym_at(?s64[0], 0, ?l64, 7, 0x12, 0, 3, 0xAABB, 0xCC);
    if (se32 != 16 || se64 != 24)               { bad = true; }
    if (bin.read_u32_le(?s32[0], 4)  != 0xAABB) { bad = true; }
    if (bin.read_u32_le(?s32[0], 8)  != 0xCC)   { bad = true; }
    if (s32[12] != 0x12)                        { bad = true; }
    if (bin.read_u16_le(?s32[0], 14) != 3)      { bad = true; }
    if (s64[4] != 0x12)                         { bad = true; }
    if (bin.read_u64_le(?s64[0], 8)  != 0xAABB) { bad = true; }

    if (rela_info_pack(?l32, 0x2B, 0x17) != 0x2B17)       { bad = true; }
    if (rela_info_pack(?l64, 0x2B, 0x17) != 0x2B00000017) { bad = true; }
    if (!reloc_type_fits_class(?l32, 0xFF))               { bad = true; }
    if (reloc_type_fits_class(?l32, 0x100))               { bad = true; }
    if (!reloc_type_fits_class(?l64, 0x100))              { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:riscv32_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var seam: isa.RelocSeam = t_seam(t_riscv_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, ?seam);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x13; k = k + 1; }
    var data_bytes: [4]u8;
    k = 0;
    for (k < 4) { data_bytes[k] = 0x5A; k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 4; secs[1].align = 4;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "g"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "d"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 4;  syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 0; relocs[0].kind = of.RK_PCREL_HI20;
    relocs[0].sym = 1; relocs[0].addend = 0;
    relocs[1].section = of.section_id(0); relocs[1].offset = 4; relocs[1].kind = of.RK_PCREL_LO12_I;
    relocs[1].sym = 1; relocs[1].addend = 0;
    relocs[2].section = of.section_id(1); relocs[2].offset = 0; relocs[2].kind = of.RK_ABS32;
    relocs[2].sym = 0; relocs[2].addend = -8;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "rv32");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 3;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_rv32");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;

    if (buf.data[4] != ELFCLASS32)                  { bad = true; }
    if (bin.read_u16_le(buf.data, 40) != 52)        { bad = true; }
    if (bin.read_u16_le(buf.data, 46) != 40)        { bad = true; }
    val e_shoff: usize = bin.read_u32_le(buf.data, 32)::usize;
    if (e_shoff == 0 || e_shoff >= buf.len)         { bad = true; }
    if (bad) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 2) { ret 1; }
    if (out.symbol_count  != 2) { ret 1; }
    if (out.reloc_count   != 3) { ret 1; }

    var text_i: i32 = -1;
    var data_i: i32 = -1;
    var s: u32 = 0;
    for (s < out.section_count) {
        if (str_equals(bin.resolve_name(?i, out.sections[s].name), ".text")) { text_i = s::i32; }
        if (str_equals(bin.resolve_name(?i, out.sections[s].name), ".data")) { data_i = s::i32; }
        s = s + 1;
    }
    if (text_i < 0 || data_i < 0)                     { ret 1; }
    if (out.sections[text_i::u32].len != 16)          { bad = true; }
    if (out.sections[text_i::u32].kind != of.SK_TEXT) { bad = true; }
    if (out.sections[data_i::u32].len != 4)           { bad = true; }
    if (out.sections[text_i::u32].bytes == nil)       { ret 1; }
    if (out.sections[data_i::u32].bytes == nil)       { ret 1; }
    if (out.sections[text_i::u32].bytes[0] != 0x13)   { bad = true; }
    if (out.sections[data_i::u32].bytes[0] != 0x5A)   { bad = true; }

    var saw_g: bool = false;
    var saw_d: bool = false;
    var y: u32 = 0;
    for (y < out.symbol_count) {
        val nm: str = bin.resolve_name(?i, out.symbols[y].name);
        if (str_equals(nm, "g")) {
            saw_g = true;
            if (out.symbols[y].size != 16)                              { bad = true; }
            if (of.section_index(out.symbols[y].section) != text_i::u32)                  { bad = true; }
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { bad = true; }
        }
        if (str_equals(nm, "d")) {
            saw_d = true;
            if (of.section_index(out.symbols[y].section) != data_i::u32)                  { bad = true; }
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_OBJECT) == 0)   { bad = true; }
        }
        y = y + 1;
    }
    if (!saw_g || !saw_d) { bad = true; }

    var saw_hi: bool = false;
    var saw_lo: bool = false;
    var saw_abs: bool = false;
    var r: u32 = 0;
    for (r < out.reloc_count) {
        if (out.relocations[r].kind == of.RK_PCREL_HI20) {
            saw_hi = true;
            if (out.relocations[r].offset != 0)            { bad = true; }
            if (of.section_index(out.relocations[r].section) != text_i::u32) { bad = true; }
        }
        if (out.relocations[r].kind == of.RK_PCREL_LO12_I) {
            saw_lo = true;
            if (out.relocations[r].offset != 4)            { bad = true; }
        }
        if (out.relocations[r].kind == of.RK_ABS32) {
            saw_abs = true;
            if (of.section_index(out.relocations[r].section) != data_i::u32) { bad = true; }
            if (out.relocations[r].addend != -8)           { bad = true; }
        }
        r = r + 1;
    }
    if (!saw_hi || !saw_lo || !saw_abs) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_exec:riscv32_static_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x13; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x11000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_rv32x");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                            4096, 0x10000, 0x11000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "rv32x"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);

    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: bool = false;
    if (buf.data[4] != ELFCLASS32)                     { bad = true; }
    if (bin.read_u16_le(buf.data, 16) != ET_EXEC)      { bad = true; }
    if (bin.read_u32_le(buf.data, 24) != 0x11000)      { bad = true; }
    if (bin.read_u32_le(buf.data, 28) != 52)           { bad = true; }
    if (bin.read_u16_le(buf.data, 40) != 52)           { bad = true; }
    if (bin.read_u16_le(buf.data, 42) != 32)           { bad = true; }
    if (bad) { ret 1; }

    val e_phnum: usize = bin.read_u16_le(buf.data, 44)::usize;
    if (e_phnum != 3) { ret 1; }

    var saw_text: bool = false;
    var saw_note: bool = false;
    var ph: usize = 0;
    for (ph < e_phnum) {
        val po: usize = 52 + ph * 32;
        val fl: u32 = bin.read_u32_le(buf.data, po + 24);
        if (fl == 0) { bad = true; }
        if (bin.read_u32_le(buf.data, po) == PT_NOTE) {
            saw_note = true;
            val note_off: usize = bin.read_u32_le(buf.data, po + 4)::usize;
            if (note_off % 4 != 0 || note_off >= 4096)    { bad = true; }
            if (bin.read_u32_le(buf.data, po + 16)::usize != buildid.ELF_NOTE_SIZE) { bad = true; }
            if (!buildid.elf_note_header_valid((buf.data::usize + note_off)::*u8)) { bad = true; }
        }
        or (bin.read_u32_le(buf.data, po) != PT_LOAD) { bad = true; }
        if (bin.read_u32_le(buf.data, po + 8) == 0x11000) {
            saw_text = true;
            if (fl != (PF_R | PF_X))                      { bad = true; }
            if (bin.read_u32_le(buf.data, po + 16) != 16) { bad = true; }
        }
        ph = ph + 1;
    }
    if (!saw_text || !saw_note) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:unknown_class_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: [64]u8;
    var k: usize = 0;
    for (k < 64) { buf[k] = 0; k = k + 1; }
    buf[0] = 0x7F; buf[1] = 0x45; buf[2] = 0x4C; buf[3] = 0x46;
    buf[4] = 7;

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = parse_object(?alloc, ?i, ?buf[0], 64, ?out);
    if (!R.is_err[R.Void, str](pr)) { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "unknown ELF class")) { ret 1; }

    var l: ElfLayout;
    if (layout_from_class(7, ?l))                    { ret 1; }
    if (!layout_from_class(ELFCLASS32, ?l))          { ret 1; }
    if (l.addr_width != 4)                           { ret 1; }
    if (!layout_from_class(ELFCLASS64, ?l))          { ret 1; }
    if (l.addr_width != 8)                           { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf:elf32_dynamic_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, nil);

    var text: [16]u8;
    var k: usize = 0;
    for (k < 16) { text[k] = 0x13; k = k + 1; }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x11000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    var dyn: of.DynamicInfo;
    dyn.libs = nil;        dyn.lib_count = 0;
    dyn.imports = nil;     dyn.import_count = 0;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil; dyn.base_reloc_count = 0;
    dyn.pie = true;

    val made: R.Result[output.Output, str] = output.create(?alloc, "elf32_dynamic");
    if (R.is_err[output.Output, str](made)) { ret 2; }
    var file: output.Output = R.unwrap_ok[output.Output, str](made);
    fin { output.dnit(?file); }
    val filename: str = output.path(?file);

    val opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    var bad: bool = false;

    val pe: R.Result[R.Void, str] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, 0x11000,
                                                ?dyn, nil::*of.Section, 0,
                                                nil::*of.SymtabEntry, 0, filename::*u8, opts);
    if (!R.is_err[R.Void, str](pe)) { bad = true; }
    or (!str_contains(R.unwrap_err[R.Void, str](pe), "ELF64-only")) { bad = true; }

    val sh: R.Result[R.Void, str] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096,
                                              nil::*of.ExportSym, 0, ?dyn,
                                              nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                              filename::*u8, opts);
    if (!R.is_err[R.Void, str](sh)) { bad = true; }
    or (!str_contains(R.unwrap_err[R.Void, str](sh), "ELF64-only")) { bad = true; }

    val dx: R.Result[R.Void, str] = t_planned_emit_dyn_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096,
                                                0x10000, 0x11000, nil::*of.ExecFunction, 0,
                                                ?dyn, nil::*of.PltFixup, 0,
                                                nil::*of.Section, 0, nil::*of.Section, 0,
                                                nil::*of.SymtabEntry, 0,
                                                filename::*u8, "x"::*u8, opts);
    if (!R.is_err[R.Void, str](dx)) { bad = true; }
    or (!str_contains(R.unwrap_err[R.Void, str](dx), "ELF64-only")) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) R.Result[*publication.Destination, str] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](initialized))); }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret destination; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](sealed))); }
    ret destination;
}

fun t_publication_close(operation: *publication.Plan, result: R.Result[R.Void, str]) R.Result[R.Void, str] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (R.is_ok[R.Void, str](result) && O.is_some[txn.Error](closed)) {
        ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](closed)));
    }
    ret result;
}

fun t_planned_emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
                  seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                  funcs: *of.ExecFunction,
                  func_count: u32, dyn: *of.DynamicInfo, fixups: *of.PltFixup,
                  fixup_count: u32, exceptions: *of.Section, exception_count: u32,
                  debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
                  image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret emit_dyn_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, emit_dyn_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), name, image_options));
}

fun t_planned_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
              seg_count: u32, page_size: u64, image_base: u64, entry: u64,
              funcs: *of.ExecFunction,
              func_count: u32, exceptions: *of.Section, exception_count: u32,
              debug: *of.Section, debug_count: u32,
              symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
              image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret emit_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, emit_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), name, image_options));
}

fun t_planned_emit_object(tgt_isa: *of.ObjectTarget, img: *of.ObjectImage, path: *u8) R.Result[R.Void, str] {
    if (path == nil) { ret emit_object(tgt_isa, img, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, img.alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, emit_object(tgt_isa, img, R.unwrap_ok[*publication.Destination, str](opened)));
}

fun t_planned_emit_pie_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget,
                  segs: *of.LoadSegment, seg_count: u32, page_size: u64, entry: u64,
                  dyn: *of.DynamicInfo, debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32, path: *u8,
                  image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret emit_pie_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, entry, dyn, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, emit_pie_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, entry, dyn, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), image_options));
}

fun t_planned_emit_shared(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget,
                segs: *of.LoadSegment, seg_count: u32, page_size: u64,
                exports: *of.ExportSym, export_count: u32, dyn: *of.DynamicInfo,
                debug: *of.Section, debug_count: u32,
                symtab: *of.SymtabEntry, symtab_count: u32, path: *u8,
                image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret emit_shared(alloc, itn, tgt_isa, segs, seg_count, page_size, exports, export_count, dyn, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, emit_shared(alloc, itn, tgt_isa, segs, seg_count, page_size, exports, export_count, dyn, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), image_options));
}

fun t_import_call_and_address(arch_id: u32) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var imports: [3]of.DynImport;
    imports[0].symbol = t_intern(?itn, "object");
    imports[1].symbol = t_intern(?itn, "called_and_addressed");
    imports[1].is_func = true;
    imports[2].symbol = t_intern(?itn, "called_only");
    imports[2].is_func = true;
    var fx: [4]of.ImportAddrFixup;
    var j: u32 = 0;
    for (j < 4) {
        fx[j].seg_offset = (j / 2) * 16 + (j % 2) * 4;
        fx[j].patch_vaddr = 0x400000 + fx[j].seg_offset::u64;
        if (j < 2) { fx[j].import_index = 1; }
        if (j % 2 == 0) { fx[j].kind = of.RK_GOT_PAGE21; }
        or { fx[j].kind = of.RK_GOT_LO12; }
        if (arch_id == isa.ARCH_X86_64) {
            fx[j].seg_offset = fx[j].seg_offset + 3;
            fx[j].patch_vaddr = fx[j].patch_vaddr + 3;
            fx[j].kind = of.RK_GOTPCREL;
            fx[j].addend = -4;
        } or (arch_id == isa.ARCH_RISCV64) {
            if (j % 2 == 0) { fx[j].kind = of.RK_GOT_PCREL_HI20; }
            or { fx[j].kind = of.RK_PCREL_LO12_I; fx[j].addend = 4; }
        }
        j = j + 1;
    }
    if (arch_id == isa.ARCH_X86_64) {
        fx[1] = fx[2];
    }
    var dyn: of.DynamicInfo;
    dyn.imports = ?imports[0]; dyn.import_count = 3;
    dyn.import_addr_fixups = ?fx[0]; dyn.import_addr_fixup_count = 4;
    if (arch_id == isa.ARCH_X86_64) { dyn.import_addr_fixup_count = 2; }
    dyn.interp = t_intern(?itn, "/lib/ld.so.1");
    val planned: R.Result[ImportAddressPlan, str] = import_address_plan(?alloc, ?dyn);
    if (R.is_err[ImportAddressPlan, str](planned)) { ret 1; }
    var got: ImportAddressPlan = R.unwrap_ok[ImportAddressPlan, str](planned);
    fin { import_address_plan_dnit(?alloc, ?got); }
    var lay: DynLayout;
    val fp_r: R.Result[plan.FilePlan, str] = plan.init(?alloc, ?itn, "elf", plan.limit_64());
    if (R.is_err[plan.FilePlan, str](fp_r)) { ret 1; }
    var fp: plan.FilePlan = R.unwrap_ok[plan.FilePlan, str](fp_r);
    fin { plan.dnit(?fp); }
    if (R.is_err[u32, str](plan.place_at(?fp, "header", of.no_section(), 0, 64))) { ret 1; }
    if (R.is_err[R.Void, str](compute_dyn_layout(?itn, ?fp, ?lay, ?dyn, ?got, 2, arch_id, 0x401000, 4096))) { ret 1; }
    if (R.is_err[usize, str](plan.seal(?fp))) { ret 1; }
    if (lay.datagot_size != 16 || lay.reladyn_size != 48 || lay.relaplt_size != 48) { ret 1; }
    val total: usize = lay.rw_off + lay.rw_size;
    val made: R.Result[*u8, str] = A.zallocate[u8](?alloc, total);
    if (R.is_err[*u8, str](made)) { ret 2; }
    val buf: *u8 = R.unwrap_ok[*u8, str](made);
    fin { A.deallocate[u8](?alloc, buf, total); }
    var imp_str: [3]usize;
    var lib_str: [1]usize;
    if (R.is_err[R.Void, str](write_dyn_structures(?itn, buf, ?fp, ?lay, ?dyn, ?got, 2, arch_id, ?imp_str[0], ?lib_str[0]))) { ret 2; }
    if (bin.read_u32_le(buf, lay.hash_off + 4) != 4
        || lay.dynstr_off - lay.dynsym_off != 4 * 24) { ret 3; }
    if (buf[lay.dynsym_off + 24 + 4] != 0x12 || buf[lay.dynsym_off + 72 + 4] != 0x11) { ret 4; }
    var addr_type: u32 = 1025;
    var call_type: u32 = 1026;
    if (arch_id == isa.ARCH_RISCV64) { addr_type = 2; call_type = 5; }
    if (arch_id == isa.ARCH_X86_64) { addr_type = 6; call_type = 7; }
    if (bin.read_u64_le(buf, lay.reladyn_off) != lay.datagot_va
        || bin.read_u64_le(buf, lay.reladyn_off + 8) != ((3::u64 << 32) | addr_type::u64)
        || bin.read_u64_le(buf, lay.reladyn_off + 24) != lay.datagot_va + 8
        || bin.read_u64_le(buf, lay.reladyn_off + 32) != ((1::u64 << 32) | addr_type::u64)
        || bin.read_u64_le(buf, lay.relaplt_off + 8) != ((1::u64 << 32) | call_type::u64)) { ret 5; }
    var segment: of.LoadSegment;
    segment.vaddr = 0x400000; segment.filesz = 32;
    var offset: usize = 0;
    j = 0;
    for (j < 2) {
        val at: usize = j::usize * 16;
        if (arch_id == isa.ARCH_X86_64) {
            buf[at] = 0x48; buf[at + 1] = 0x8B; buf[at + 2] = 0x05;
        } or (arch_id == isa.ARCH_RISCV64) {
            bin.write_u32_le(buf, at, 0x00000517);
            bin.write_u32_le(buf, at + 4, 0x00053503);
        } or {
            bin.write_u32_le(buf, at, 0x90000000);
            bin.write_u32_le(buf, at + 4, 0xF9400000);
        }
        j = j + 1;
    }
    if (arch_id == isa.ARCH_X86_64) { buf[8] = 0xE8; }
    or (arch_id == isa.ARCH_RISCV64) {
        bin.write_u32_le(buf, 8, 0x00000097);
        bin.write_u32_le(buf, 12, 0x000080E7);
    } or { bin.write_u32_le(buf, 8, 0x94000000); }
    var call: of.PltFixup;
    call.seg_offset = 8; call.import_index = 1; call.patch_vaddr = 0x400008;
    if (arch_id == isa.ARCH_X86_64) { call.seg_offset = 9; call.patch_vaddr = 0x400009; call.addend = -4; }
    if (R.is_err[R.Void, str](patch_plt_fixups(buf, ?lay, ?dyn, ?call, 1, ?offset, ?segment, 1, 2, arch_id))) { ret 6; }
    if (R.is_err[R.Void, str](patch_import_addr_fixups(buf, ?lay, ?dyn, ?got, ?offset, ?segment, 1, arch_id))) { ret 7; }
    j = 0;
    for (j < 2) {
        val at: usize = j::usize * 16;
        val high: u32 = bin.read_u32_le(buf, at);
        val low: u32 = bin.read_u32_le(buf, at + 4);
        var got_address: u64 = 0;
        if (arch_id == isa.ARCH_X86_64) {
            if (buf[at] != 0x48 || buf[at + 1] != 0x8B || buf[at + 2] != 0x05) { ret 8; }
            got_address = (segment.vaddr::i64 + at::i64 + 7 + bin.read_u32_le(buf, at + 3)::i32::i64)::u64;
        } or (arch_id == isa.ARCH_RISCV64) {
            if ((high & 0xFFF) != 0x517 || (low & 0xFFFFF) != 0x53503) { ret 8; }
            got_address = (segment.vaddr::i64 + at::i64 + (high & 0xFFFFF000)::i32::i64 + (low::i32 >> 20)::i64)::u64;
        } or {
            if ((high & 0x9F00001F) != 0x90000000 || (low & 0xFFC003FF) != 0xF9400000) { ret 8; }
            val imm: u32 = (((high >> 5) & 0x7FFFF) << 2) | ((high >> 29) & 3);
            val pages: i64 = ((imm << 11)::i32 >> 11)::i64;
            got_address = ((segment.vaddr & 0xFFFFFFFFFFFFF000)::i64 + pages * 4096 + ((low >> 10) & 0xFFF)::i64 * 8)::u64;
        }
        var want: u64 = lay.datagot_va;
        if (j == 0) { want = want + 8; }
        if (got_address != want) { ret 9; }
        j = j + 1;
    }
    val ch: u32 = bin.read_u32_le(buf, 8);
    var called: u64 = 0;
    if (arch_id == isa.ARCH_X86_64) {
        if (buf[8] != 0xE8) { ret 10; }
        called = (0x40000D + bin.read_u32_le(buf, 9)::i32::i64)::u64;
    } or (arch_id == isa.ARCH_RISCV64) {
        val cl: u32 = bin.read_u32_le(buf, 12);
        called = (0x400008 + (ch & 0xFFFFF000)::i32::i64 + (cl::i32 >> 20)::i64)::u64;
    } or { called = (0x400008 + ((ch << 6)::i32 >> 4)::i64)::u64; }
    var expected_call: u64 = lay.plt_va;
    if (arch_id == isa.ARCH_X86_64) { expected_call = expected_call + 16; }
    if (called != expected_call || called == lay.datagot_va + 8) { ret 10; }
    fx[0].import_index = 3;
    if (!R.is_err[R.Void, str](patch_import_addr_fixups(buf, ?lay, ?dyn, ?got, ?offset, ?segment, 1, arch_id))) { ret 11; }
    fx[0].import_index = 1;
    fx[0].addend = 1;
    if (arch_id == isa.ARCH_X86_64) { fx[0].patch_vaddr = 0xF00000000; }
    if (!R.is_err[R.Void, str](patch_import_addr_fixups(buf, ?lay, ?dyn, ?got, ?offset, ?segment, 1, arch_id))) { ret 12; }
    ret 0;
}

test "mach.lang.target.of.elf.import_got:arm64_call_and_address" {
    ret t_import_call_and_address(isa.ARCH_AARCH64);
}

test "mach.lang.target.of.elf.import_got:riscv64_call_and_address" {
    ret t_import_call_and_address(isa.ARCH_RISCV64);
}


test "mach.lang.target.of.elf.import_got:x86_64_call_and_address" {
    ret t_import_call_and_address(isa.ARCH_X86_64);
}

test "mach.lang.target.of.elf:relocatable_preserves_groups_native_flags_and_symbol_definitions" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var target: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);
    var data: [8]u8;
    var group: [12]u8;
    bin.write_u32_le(?group[0], 0, 1);
    bin.write_u32_le(?group[0], 4, 1);
    bin.write_u32_le(?group[0], 8, of.NATIVE_GROUP_RELOC | 1);
    var sections: [3]of.Section;
    sections[0] = of.Section{name: t_intern(?itn, ".custom.payload"), kind: of.SK_RODATA,
        bytes: ?data[0], len: 8, align: 8, native: of.NativeSection{format: of.OF_ELF, kind: SHT_PROGBITS, flags: SHF_ALLOC | 0x200 | 0x200000}};
    sections[1] = of.Section{name: t_intern(?itn, ".custom.empty"), kind: of.SK_RODATA, align: 8,
        native: of.NativeSection{format: of.OF_ELF, kind: SHT_PROGBITS, flags: SHF_ALLOC}};
    sections[2] = of.Section{name: t_intern(?itn, ".group"), kind: of.SK_DEBUG, bytes: ?group[0], len: 12, align: 4,
        native: of.NativeSection{format: of.OF_ELF, kind: SHT_GROUP, entry_size: 4, link_symbol: 1}};
    var symbols: [3]of.Symbol;
    symbols[0] = of.Symbol{name: t_intern(?itn, "signature"), section: of.section_id(0), size: 8,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT,
        native: of.NativeSymbol{format: of.OF_ELF, kind: (STB_GLOBAL::u32 << 4) | STT_OBJECT::u32, flags: 2}};
    symbols[1] = of.Symbol{name: t_intern(?itn, "absolute"), section: of.absolute_section(),
        absolute_value: 0xFEDCBA9876543210, flags: of.SYM_OBJ_FLAG_GLOBAL};
    symbols[2] = of.Symbol{name: t_intern(?itn, "common"), section: of.external_section(), size: 33, align: 16,
        flags: of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_COMMON | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_OBJECT};
    var relocation: of.Relocation = of.Relocation{section: of.section_id(0), kind: of.RK_ABS64, sym: 1, addend: 7};
    var image: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    image.sections = ?sections[0]; image.section_count = 3;
    image.symbols = ?symbols[0]; image.symbol_count = 3;
    image.relocations = ?relocation; image.reloc_count = 1;
    val created: R.Result[output.Output, str] = output.create(?alloc, "elf_native_roundtrip");
    if (R.is_err[output.Output, str](created)) { ret 1; }
    var file: output.Output = R.unwrap_ok[output.Output, str](created);
    fin { output.dnit(?file); }
    var first: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    var second: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    fin { of.object_image_dnit(?first); of.object_image_dnit(?second); }
    var input: *of.ObjectImage = ?image;
    var pass: u32 = 0;
    for (pass < 2) {
        val emitted: R.Result[R.Void, str] = t_planned_emit_object(?target, input, output.path(?file));
        if (R.is_err[R.Void, str](emitted)) { ret 2; }
        val read: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, output.path(?file));
        if (R.is_err[Vector[u8], str](read)) { ret 3; }
        var bytes: Vector[u8] = R.unwrap_ok[Vector[u8], str](read);
        fin { if (bytes.data != nil) { A.deallocate[u8](?alloc, bytes.data, bytes.cap); } }
        val shoff: usize = bin.read_u64_le(bytes.data, 40)::usize;
        val group_header: usize = shoff + 3 * SHDR_SIZE;
        if (bin.read_u32_le(bytes.data, group_header + 4) != SHT_GROUP
            || bin.read_u32_le(bytes.data, group_header + 40) != 4
            || bin.read_u32_le(bytes.data, group_header + 44) != 1) { ret 4; }
        var decoded: *of.ObjectImage = ?first;
        if (pass == 1) { decoded = ?second; }
        val parsed: R.Result[R.Void, str] = parse_object(?alloc, ?itn, bytes.data, bytes.len, decoded);
        if (R.is_err[R.Void, str](parsed)) { ret 5; }
        if (decoded.section_count != 3 || decoded.sections[0].name != sections[0].name
            || decoded.sections[0].native.flags != sections[0].native.flags || decoded.sections[1].len != 0
            || decoded.sections[2].native.kind != SHT_GROUP || decoded.sections[2].native.link_symbol != 1
            || bin.read_u32_le(decoded.sections[2].bytes, 4) != 1
            || bin.read_u32_le(decoded.sections[2].bytes, 8) != (of.NATIVE_GROUP_RELOC | 1)
            || decoded.symbols[0].native.flags != 2 || !of.section_is_absolute(decoded.symbols[1].section)
            || decoded.symbols[1].absolute_value != symbols[1].absolute_value
            || (decoded.symbols[2].flags & of.SYM_OBJ_FLAG_COMMON) == 0
            || decoded.symbols[2].size != 33 || decoded.symbols[2].align != 16
            || decoded.reloc_count != 1 || decoded.relocations[0].addend != 7) { ret 6; }
        var evidence: str = "elf-native-first.o";
        if (pass == 1) { evidence = "elf-native-roundtrip.o"; }
        if (R.is_err[R.Void, str](output.retain_bytes(?alloc, evidence, bytes.data, bytes.len))) { ret 9; }
        input = decoded;
        pass = pass + 1;
    }
    ret 0;
}

# the four refusal classes, each constructed as the offending input and
# asserted as a typed error that leaves the destination untouched

fun t_untouched(alloc: *A.Allocator, path: str) bool {
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, path);
    if (R.is_err[Vector[u8], str](rb)) { ret false; }
    ret R.unwrap_ok[Vector[u8], str](rb).len == 0;
}

fun t_oversize_image(alloc: *A.Allocator, i: *intern.Interner, secs: *of.Section, syms: *of.Symbol, bytes: *u8) of.ObjectImage {
    secs[0].name = t_intern(i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = bytes; secs[0].len = 0xFFFFFFF0; secs[0].align = 16; secs[0].flags = 0;
    secs[1].name = t_intern(i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = bytes; secs[1].len = 0x100; secs[1].align = 16; secs[1].flags = 0;
    syms[0].name = t_intern(i, "main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var img: of.ObjectImage;
    img.alloc = alloc;
    img.interner = i;
    img.name = t_intern(i, "oversize");
    img.sections = secs; img.section_count = 2;
    img.symbols = syms; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;
    ret img;
}

test "mach.lang.target.of.elf.emit_object:refuses_section_past_the_elf32_field_width" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var seam: isa.RelocSeam = t_seam(t_riscv_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, ?seam);

    var bytes: [16]u8;
    var secs: [2]of.Section;
    var syms: [1]of.Symbol;
    var img: of.ObjectImage = t_oversize_image(?alloc, ?i, ?secs[0], ?syms[0], ?bytes[0]);

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_oversize");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_ok[R.Void, str](em)) { ret 2; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "field width")) { ret 3; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "section data")) { ret 4; }
    if (!t_untouched(?alloc, tpath)) { ret 5; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_exec:refuses_a_misaligned_debug_placement" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, nil);

    var text: [16]u8;
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x11000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];
    var dbg: [1]of.Section;
    dbg[0].name = t_intern(?i, ".debug_info"); dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?text[0]; dbg[0].len = 16; dbg[0].align = 3; dbg[0].flags = 0;

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_misaligned");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                            4096, 0x10000, 0x11000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            ?dbg[0], 1, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "rv32x"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_ok[R.Void, str](em)) { ret 2; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "not a power of two")) { ret 3; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "debug section")) { ret 4; }
    if (!t_untouched(?alloc, tpath)) { ret 5; }

    dbg[0].align = 4;
    val ok: R.Result[R.Void, str] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                            4096, 0x10000, 0x11000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            ?dbg[0], 1, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "rv32x"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](ok)) { ret 6; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_exec:refuses_a_section_count_past_e_shnum" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x401000; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text[0];

    val count: u32 = 0xFEFF;
    val made: R.Result[*of.Section, str] = A.zallocate[of.Section](?alloc, count::usize);
    if (R.is_err[*of.Section, str](made)) { ret 1; }
    val dbg: *of.Section = R.unwrap_ok[*of.Section, str](made);
    fin { A.deallocate[of.Section](?alloc, dbg, count::usize); }
    val dname: intern.StrId = t_intern(?i, ".debug_x");
    var d: u32 = 0;
    for (d < count) {
        dbg[d].name = dname; dbg[d].kind = of.SK_DEBUG; dbg[d].bytes = nil; dbg[d].len = 0; dbg[d].align = 1; dbg[d].flags = 0;
        d = d + 1;
    }

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "elf_shnum");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: R.Result[R.Void, str] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                            4096, 0x400000, 0x401000,
                                            nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                                            dbg, count, nil::*of.SymtabEntry, 0,
                                            tpath::*u8, "shnum"::*u8,
                                            of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_ok[R.Void, str](em)) { ret 2; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "e_shnum")) { ret 3; }
    if (!t_untouched(?alloc, tpath)) { ret 4; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:allocation_refusal_at_every_ordinal_is_typed" {
    var backing: A.Allocator;
    page.make(?backing);
    var i: intern.Interner = intern.init(?backing);
    var seam: isa.RelocSeam = t_seam(t_x64_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, ?seam);

    var text: [16]u8;
    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text[0]; secs[0].len = 16; secs[0].align = 16; secs[0].flags = 0;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?text[0]; secs[1].len = 8; secs[1].align = 8; secs[1].flags = 0;
    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = of.section_id(0); syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "gvar"); syms[1].section = of.section_id(1); syms[1].offset = 0;
    syms[1].size = 8; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    var relocs: [1]of.Relocation;
    relocs[0].section = of.section_id(0); relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    val tf_r: R.Result[output.Output, str] = output.create(?backing, "elf_failat");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    var refused: u32 = 0;
    var ordinal: usize = 1;
    for (ordinal <= 24) {
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 2; }
        T.fail_at_ordinal(?failing, ordinal);
        var img: of.ObjectImage;
        img.alloc = T.allocator_of(?failing);
        img.interner = ?i;
        img.name = t_intern(?i, "failat");
        img.sections = ?secs[0]; img.section_count = 2;
        img.symbols = ?syms[0]; img.symbol_count = 2;
        img.relocations = ?relocs[0]; img.reloc_count = 1;
        val em: R.Result[R.Void, str] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
        if (T.leaked(?failing)) { ret 3; }
        if (R.is_err[R.Void, str](em)) {
            refused = refused + 1;
            if (!t_untouched(?backing, tpath)) { ret 5; }
        }
        ordinal = ordinal + 1;
    }
    if (refused < 6) { ret 6; }
    ret 0;
}
