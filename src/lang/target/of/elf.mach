val SYM_SIZE:  usize = 24;
val RELA_SIZE: usize = 24;

rec ElfLayout {
    class:        u8;
    addr_width:   u32;
    ehdr_size:    usize;
    shdr_size:    usize;
    phdr_size:    usize;
    sym_size:     usize;
    rela_size:    usize;
    struct_align: usize;
}

fun elf64_layout() ElfLayout {
    var l: ElfLayout;
    l.class        = ELFCLASS64;
    l.addr_width   = 8;
    l.ehdr_size    = 64;
    l.shdr_size    = 64;
    l.phdr_size    = 56;
    l.sym_size     = 24;
    l.rela_size    = 24;
    l.struct_align = 8;
    ret l;
}

fun elf32_layout() ElfLayout {
    var l: ElfLayout;
    l.class        = ELFCLASS32;
    l.addr_width   = 4;
    l.ehdr_size    = 52;
    l.shdr_size    = 40;
    l.phdr_size    = 32;
    l.sym_size     = 16;
    l.rela_size    = 12;
    l.struct_align = 4;
    ret l;
}

fun layout_for(tgt_isa: *target_of.ObjectTarget) ElfLayout {
    if (tgt_isa.pointer_width == 4) { ret elf32_layout(); }
    ret elf64_layout();
}

fun layout_from_class(cls: u8, out: *ElfLayout) bool {
    if (cls == ELFCLASS32) {
        @out = elf32_layout();
        ret true;
    }
    if (cls == ELFCLASS64) {
        @out = elf64_layout();
        ret true;
    }
    ret false;
}

fun write_addr(buf: *u8, off: usize, lay: *ElfLayout, v: u64) {
    if (lay.addr_width == 4) {
        bin.write_u32_le(buf, off, v::u32);
        ret;
    }
    bin.write_u64_le(buf, off, v);
}

fun read_addr(buf: *u8, off: usize, lay: *ElfLayout) u64 {
    if (lay.addr_width == 4) { ret bin.read_u32_le(buf, off)::u64; }
    ret bin.read_u64_le(buf, off);
}

fun write_ehdr(buf: *u8, lay: *ElfLayout, e_type: u16, e_machine: u16, e_flags: u32,
    e_entry: u64, e_phoff: u64, e_shoff: u64,
    e_phnum: u16, e_shnum: u16, e_shstrndx: u16) {
    bin.write_u16_le(buf, 16, e_type);
    bin.write_u16_le(buf, 18, e_machine);
    bin.write_u32_le(buf, 20, 1);
    val w: usize = lay.addr_width::usize;
    write_addr(buf, 24, lay, e_entry);
    write_addr(buf, 24 + w, lay, e_phoff);
    write_addr(buf, 24 + 2 * w, lay, e_shoff);
    var o: usize = 24 + 3 * w;
    bin.write_u32_le(buf, o, e_flags);
    bin.write_u16_le(buf, o + 4, lay.ehdr_size::u16);
    var phentsize: u16 = 0;
    if (e_phnum != 0) { phentsize = lay.phdr_size::u16; }
    bin.write_u16_le(buf, o + 6, phentsize);
    bin.write_u16_le(buf, o + 8, e_phnum);
    bin.write_u16_le(buf, o + 10, lay.shdr_size::u16);
    bin.write_u16_le(buf, o + 12, e_shnum);
    bin.write_u16_le(buf, o + 14, e_shstrndx);
}

fun write_shdr(buf: *u8, off: usize, lay: *ElfLayout,
    name: u32, stype: u32, flags: u64, addr: u64, offset: u64, size: u64,
    link: u32, info: u32, addralign: u64, entsize: u64) usize {
    val w: usize = lay.addr_width::usize;
    bin.write_u32_le(buf, off, name);
    bin.write_u32_le(buf, off + 4, stype);
    write_addr(buf, off + 8, lay, flags);
    write_addr(buf, off + 8 + w, lay, addr);
    write_addr(buf, off + 8 + 2 * w, lay, offset);
    write_addr(buf, off + 8 + 3 * w, lay, size);
    var o: usize = off + 8 + 4 * w;
    bin.write_u32_le(buf, o, link);
    bin.write_u32_le(buf, o + 4, info);
    write_addr(buf, o + 8, lay, addralign);
    write_addr(buf, o + 8 + w, lay, entsize);
    ret off + lay.shdr_size;
}

# how the file header spells a table of `count` section headers whose names
# header `names` holds: a count or an index from SHN_LORESERVE up is extended,
# e_shnum 0 or e_shstrndx SHN_XINDEX with the value in the null header's
# sh_size or sh_link
rec SectionNumbering {
    e_shnum:    u16;
    e_shstrndx: u16;
    null_size:  u64;
    null_link:  u32;
}

fun section_numbering(count: usize, names: usize) res[SectionNumbering, fail.Fail] {
    if (count > 0xFFFFFFFF) { ret res[SectionNumbering, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "section-header count exceeds the ELF section index width")}; }
    if (names >= count)     { ret res[SectionNumbering, fail.Fail].err{fail.message("section name table index lies outside the section table")}; }
    var n: SectionNumbering = SectionNumbering{e_shnum: 0, e_shstrndx: SHN_XINDEX, null_size: 0, null_link: 0};
    if (count < SHN_LORESERVE::usize) { n.e_shnum = count::u16; }
    or                                { n.null_size = count::u64; }
    if (names < SHN_LORESERVE::usize) { n.e_shstrndx = names::u16; }
    or                                { n.null_link = names::u32; }
    ret res[SectionNumbering, fail.Fail].ok{n};
}

# the null header at `off`, which carries the extended section numbering
fun write_null_shdr(buf: *u8, off: usize, lay: *ElfLayout, n: *SectionNumbering) usize {
    ret write_shdr(buf, off, lay, 0, 0, 0, 0, 0, n.null_size, n.null_link, 0, 0, 0);
}

# where a file's section headers lie, how many there are and which one holds
# their names, the count and the index read through the null header when the
# file header extends them; no table at all is a count of 0
rec SectionTable {
    off:      usize;
    entsize:  usize;
    count:    u32;
    shstrndx: u32;
}

fun section_table(buf: *u8, buf_size: usize, lay: *ElfLayout) res[SectionTable, fail.Fail] {
    val w:     usize        = lay.addr_width::usize;
    val tail:  usize        = 24 + 3 * w;
    var t:     SectionTable = SectionTable{off: read_addr(buf, 24 + 2 * w, lay)::usize, entsize: bin.read_u16_le(buf, tail + 10)::usize, count: 0, shstrndx: 0};
    val shnum: u16          = bin.read_u16_le(buf, tail + 12);
    val names: u16          = bin.read_u16_le(buf, tail + 14);
    if (t.off == 0)                { ret res[SectionTable, fail.Fail].ok{t}; }
    if (t.entsize < lay.shdr_size) { ret res[SectionTable, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "section header entry too small")}; }
    t.count    = shnum::u32;
    t.shstrndx = names::u32;
    if (shnum == 0 || names == SHN_XINDEX) {
        val null_region: err[fail.Fail] = bin.require_region(buf_size, t.off, t.entsize, "section header table out of bounds");
        if (sel null_region.err) { ret res[SectionTable, fail.Fail].err{null_region.err}; }
        val null: ElfShdr = read_shdr(buf, t.off, lay);
        if (shnum == 0) {
            if (null.size > 0xFFFFFFFF) { ret res[SectionTable, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "extended section count exceeds the ELF section index width")}; }
            t.count = null.size::u32;
        }
        if (names == SHN_XINDEX) { t.shstrndx = null.link; }
    }
    val region: err[fail.Fail] = bin.require_region(buf_size, t.off, t.count::usize * t.entsize, "section header table out of bounds");
    if (sel region.err) { ret res[SectionTable, fail.Fail].err{region.err}; }
    ret res[SectionTable, fail.Fail].ok{t};
}

fun write_phdr_at(buf: *u8, off: usize, lay: *ElfLayout,
    ptype: u32, flags: u32, offset: u64, vaddr: u64, paddr: u64,
    filesz: u64, memsz: u64, align: u64) usize {
    val w: usize = lay.addr_width::usize;
    bin.write_u32_le(buf, off, ptype);
    if (lay.addr_width == 8) {
        bin.write_u32_le(buf, off + 4, flags);
        write_addr(buf, off + 8, lay, offset);
        write_addr(buf, off + 8 + w, lay, vaddr);
        write_addr(buf, off + 8 + 2 * w, lay, paddr);
        write_addr(buf, off + 8 + 3 * w, lay, filesz);
        write_addr(buf, off + 8 + 4 * w, lay, memsz);
        write_addr(buf, off + 8 + 5 * w, lay, align);
        ret off + lay.phdr_size;
    }
    write_addr(buf, off + 4, lay, offset);
    write_addr(buf, off + 8, lay, vaddr);
    write_addr(buf, off + 12, lay, paddr);
    write_addr(buf, off + 16, lay, filesz);
    write_addr(buf, off + 20, lay, memsz);
    bin.write_u32_le(buf, off + 24, flags);
    write_addr(buf, off + 28, lay, align);
    ret off + lay.phdr_size;
}

fun write_sym_at(buf: *u8, off: usize, lay: *ElfLayout,
    name: u32, info: u8, other: u8, shndx: u16, value: u64, size: u64) usize {
    bin.write_u32_le(buf, off, name);
    if (lay.addr_width == 8) {
        buf[off + 4] = info;
        buf[off + 5] = other;
        bin.write_u16_le(buf, off + 6, shndx);
        write_addr(buf, off + 8, lay, value);
        write_addr(buf, off + 16, lay, size);
        ret off + lay.sym_size;
    }
    write_addr(buf, off + 4, lay, value);
    write_addr(buf, off + 8, lay, size);
    buf[off + 12] = info;
    buf[off + 13] = other;
    bin.write_u16_le(buf, off + 14, shndx);
    ret off + lay.sym_size;
}

fun rela_info_pack(lay: *ElfLayout, sym: u32, rtype: u32) u64 {
    if (lay.addr_width == 8) { ret (sym::u64 << 32) | rtype::u64; }
    ret (sym::u64 << 8) | rtype::u64;
}

fun rela_info_split(lay: *ElfLayout, info: u64, sym: *u32, rtype: *u32) {
    if (lay.addr_width == 8) {
        @sym   = (info >> 32)::u32;
        @rtype = (info & 0xFFFFFFFF)::u32;
        ret;
    }
    @sym   = (info >> 8)::u32;
    @rtype = (info & 0xFF)::u32;
}

fun reloc_type_fits_class(lay: *ElfLayout, rtype: u32) bool {
    if (lay.addr_width == 8) { ret true; }
    ret rtype <= 0xFF;
}

fun write_rela_at(buf: *u8, off: usize, lay: *ElfLayout,
    r_offset: u64, sym: u32, rtype: u32, addend: i64) usize {
    val w: usize = lay.addr_width::usize;
    write_addr(buf, off, lay, r_offset);
    write_addr(buf, off + w, lay, rela_info_pack(lay, sym, rtype));
    write_addr(buf, off + 2 * w, lay, addend::u64);
    ret off + lay.rela_size;
}

rec ElfShdr {
    name:      u32;
    stype:     u32;
    flags:     u64;
    addr:      u64;
    offset:    u64;
    size:      u64;
    link:      u32;
    info:      u32;
    addralign: u64;
    entsize:   u64;
}

fun read_shdr(buf: *u8, off: usize, lay: *ElfLayout) ElfShdr {
    val w: usize = lay.addr_width::usize;
    var h: ElfShdr;
    h.name   = bin.read_u32_le(buf, off);
    h.stype  = bin.read_u32_le(buf, off + 4);
    h.flags  = read_addr(buf, off + 8, lay);
    h.addr   = read_addr(buf, off + 8 + w, lay);
    h.offset = read_addr(buf, off + 8 + 2 * w, lay);
    h.size   = read_addr(buf, off + 8 + 3 * w, lay);
    val o: usize = off + 8 + 4 * w;
    h.link      = bin.read_u32_le(buf, o);
    h.info      = bin.read_u32_le(buf, o + 4);
    h.addralign = read_addr(buf, o + 8, lay);
    h.entsize   = read_addr(buf, o + 8 + w, lay);
    ret h;
}

rec ElfSym {
    name:  u32;
    info:  u8;
    other: u8;
    shndx: u16;
    value: u64;
    size:  u64;
}

fun read_sym(buf: *u8, off: usize, lay: *ElfLayout) ElfSym {
    var s: ElfSym;
    s.name = bin.read_u32_le(buf, off);
    if (lay.addr_width == 8) {
        s.info  = buf[off + 4];
        s.other = buf[off + 5];
        s.shndx = bin.read_u16_le(buf, off + 6);
        s.value = read_addr(buf, off + 8, lay);
        s.size  = read_addr(buf, off + 16, lay);
        ret s;
    }
    s.value = read_addr(buf, off + 4, lay);
    s.size  = read_addr(buf, off + 8, lay);
    s.info  = buf[off + 12];
    s.other = buf[off + 13];
    s.shndx = bin.read_u16_le(buf, off + 14);
    ret s;
}

fun read_rela(buf: *u8, off: usize, lay: *ElfLayout,
    r_offset: *u64, sym: *u32, rtype: *u32, addend: *i64) {
    val w: usize = lay.addr_width::usize;
    @r_offset = read_addr(buf, off, lay);
    rela_info_split(lay, read_addr(buf, off + w, lay), sym, rtype);
    if (lay.addr_width == 4) {
        @addend = bin.read_u32_le(buf, off + 8)::i32::i64;
        ret;
    }
    @addend = bin.read_u64_le(buf, off + 16)::i64;
}

fun reloc_type_for(itn: *intern.Interner, alloc: *A.Allocator, kind: target_of.RelocKind, tgt_isa: *target_of.ObjectTarget, origin: target_of.RelocOrigin) res[u32, fail.Fail] {
    var row: *IsaRow = nil;
    if (tgt_isa != nil) { row = row_for(tgt_isa.arch_id); }
    if (row != nil) {
        var i: u32 = 0;
        for (i < row.reloc_count) {
            if (row.relocs[i].kind == kind) { ret res[u32, fail.Fail].ok{row.relocs[i].r_type}; }
            i = i + 1;
        }
    }
    ret res[u32, fail.Fail].err{target_of.reloc_refusal_made(origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, unsupported_kind_message(itn, alloc, kind))};
}

fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, machine: u16, r_type: u32) res[target_of.RelocKind, fail.Fail] {
    val row: *IsaRow = row_for_machine(machine);
    if (row != nil) {
        var i: u32 = 0;
        for (i < row.reloc_count) {
            if (row.relocs[i].r_type == r_type) { ret res[target_of.RelocKind, fail.Fail].ok{row.relocs[i].kind}; }
            i = i + 1;
        }
    }
    ret res[target_of.RelocKind, fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_UNSUPPORTED, bin.reloc_type_rejection(itn, alloc, r_type::u64))};
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: target_of.RelocKind) res[str, fail.Fail] {
    ret target_of.reloc_kind_rejection(itn, alloc, kind, "elf");
}

fun unencodable_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u32) res[str, fail.Fail] {
    ret bin.number_message(itn, alloc, "relocation type does not fit an ELFCLASS32 r_info: ",
        r_type::u64);
}

fun validate_reloc_kinds(img: *target_of.ObjectImage, tgt_isa: *target_of.ObjectTarget, lay: *ElfLayout) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: res[u32, fail.Fail] = reloc_type_for(img.interner, img.alloc, img.relocations[i].kind, tgt_isa, img.relocations[i].origin);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        if (!reloc_type_fits_class(lay, r.ok)) {
            ret err[fail.Fail].err{fail.message_of(unencodable_type_message(img.interner, img.alloc, r.ok))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun write_elf_ident(buf: *u8, lay: *ElfLayout) {
    buf[0] = 0x7F;
    buf[1] = 0x45;
    buf[2] = 0x4C;
    buf[3] = 0x46;
    buf[4] = lay.class;
    buf[5] = ELFDATA2LSB;
    buf[6] = EV_CURRENT;
    buf[7] = ELFOSABI_NONE;
}

# the ELF section type of a declared kind, absent for a kind outside the catalog
fun section_type_for(kind: target_of.SectionKind) opt[u32] {
    val desc: opt[*target_of.SectionKindDesc] = target_of.section_desc(kind);
    if (sel desc.none)       { ret opt[u32].none{}; }
    if (!desc.some.has_bits) { ret opt[u32].some{SHT_NOBITS}; }
    ret opt[u32].some{SHT_PROGBITS};
}

fun section_flags_for_section(sec: *target_of.Section) u64 {
    if (sec.native.format == target_of.ELF) { ret sec.native.flags; }
    var f: u64 = section_flags_for(sec.kind);
    if ((sec.flags & target_of.SEC_FLAG_MERGEABLE) != 0 && sec.kind != target_of.SK_BSS) { f = f | SHF_MERGE; }
    if ((sec.flags & target_of.SEC_FLAG_STRINGS) != 0)                                   { f = f | SHF_MERGE | SHF_STRINGS; }
    if ((sec.flags & target_of.SEC_FLAG_RETAIN) != 0)                                    { f = f | SHF_GNU_RETAIN; }
    ret f;
}

# the ELF section flags of a declared kind; a kind outside the catalog has
# none, and the section type lookup beside it is what refuses the section
fun section_flags_for(kind: target_of.SectionKind) u64 {
    val desc: opt[*target_of.SectionKindDesc] = target_of.section_desc(kind);
    if (sel desc.none) { ret 0; }
    val row: *target_of.SectionKindDesc = desc.some;
    if (row.debug) { ret 0; }
    var f: u64 = SHF_ALLOC;
    if (row.executable) { f = f | SHF_EXECINSTR; }
    if (row.writable)   { f = f | SHF_WRITE; }
    ret f;
}

# which sections carry a relocation section, read once per object: each section's relocation
# count, whether a group lists its relocations, and the header index of its relocation
# section; every table holds one row per section
rec RelaTables {
    counts:  *u32;
    grouped: *u32;
    index:   *u32;
    # the sections that carry one
    present: u32;
}

fun rela_tables(img: *target_of.ObjectImage, counts: *u32, grouped: *u32, index: *u32) RelaTables {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val sec: u32 = target_of.section_index(img.relocations[i].section);
        if (sec < img.section_count) { counts[sec] = counts[sec] + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < img.section_count) {
        val sec: *target_of.Section = ?img.sections[i];
        if (sec.native.format == target_of.ELF && sec.native.kind == SHT_GROUP) {
            var at: usize = 4;
            for (at < sec.len::usize) {
                val member: u32 = bin.read_u32_le(sec.bytes, at);
                if ((member & target_of.NATIVE_GROUP_RELOC) != 0) {
                    val listed: u32 = (member & ~target_of.NATIVE_GROUP_RELOC) - 1;
                    if (listed < img.section_count) { grouped[listed] = 1; }
                }
                at = at + 4;
            }
        }
        i = i + 1;
    }
    var t: RelaTables = RelaTables{counts: counts, grouped: grouped, index: index, present: 0};
    i = 0;
    for (i < img.section_count) {
        index[i] = img.section_count + 4 + t.present;
        if (rela_present(?t, i)) { t.present = t.present + 1; }
        i = i + 1;
    }
    ret t;
}

fun rela_present(t: *RelaTables, section: u32) bool {
    ret t.counts[section] != 0 || t.grouped[section] != 0;
}

val UNRESOLVED:         str = "unresolved relocation symbol: ";
val UNRESOLVED_UNNAMED: str = "relocation references an unresolved symbol";

# writes symbol `idx`, and returns the section index .symtab_shndx holds for
# it: the real one when st_shndx says SHN_XINDEX, otherwise 0
fun write_symbol(buf: *u8, sym_off: usize, lay: *ElfLayout, str_off: usize, str_pos: *usize,
    img: *target_of.ObjectImage, idx: u32, binding: u8) u32 {
    val name_pos: usize = @str_pos;
    @str_pos = @str_pos + bin.write_str(buf, str_off + @str_pos, bin.resolve_name(img.interner, img.symbols[idx].name));

    var sym_type: u8  = STT_NOTYPE;
    var sec_idx:  u16 = 0;
    var extended: u32 = 0;
    if (!target_of.section_is_external(img.symbols[idx].section) && target_of.section_index(img.symbols[idx].section) < img.section_count) {
        val full: u32 = target_of.section_index(img.symbols[idx].section) + 1;
        if (full < SHN_LORESERVE) { sec_idx = full::u16; }
        or {
            sec_idx  = SHN_XINDEX;
            extended = full;
        }
    }
    if ((img.symbols[idx].flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0) { sym_type = STT_FUNC; }
    or ((img.symbols[idx].flags & target_of.SYM_OBJ_FLAG_OBJECT) != 0)   { sym_type = STT_OBJECT; }

    var symbol_value: u64 = img.symbols[idx].offset::u64;
    if ((img.symbols[idx].flags & target_of.SYM_OBJ_FLAG_COMMON) != 0) {
        sec_idx      = SHN_COMMON;
        extended     = 0;
        symbol_value = img.symbols[idx].align::u64;
    }
    if (target_of.section_is_absolute(img.symbols[idx].section)) {
        sec_idx      = SHN_ABS;
        extended     = 0;
        symbol_value = img.symbols[idx].absolute_value;
    }
    var other: u8 = 0;
    if ((img.symbols[idx].flags & target_of.SYM_OBJ_FLAG_HIDDEN) != 0) { other = STV_HIDDEN; }
    if (img.symbols[idx].native.format == target_of.ELF) {
        sym_type = img.symbols[idx].native.kind::u8 & 0xF;
        other    = img.symbols[idx].native.flags::u8;
    }
    var info: u8 = (binding << 4) | (sym_type & 0xF);
    if (img.symbols[idx].native.format == target_of.ELF) { info = img.symbols[idx].native.kind::u8; }
    write_sym_at(buf, sym_off, lay, name_pos::u32, info, other, sec_idx,
        symbol_value, img.symbols[idx].size::u64);
    ret extended;
}

rec SymtabBuild {
    symtab_bytes: *u8;
    symtab_size:  usize;
    strtab_bytes: *u8;
    strtab_size:  usize;
    local_count:  u32;
}

fun build_symtab_bytes(alloc: *A.Allocator, itn: *intern.Interner, lay: *ElfLayout,
    symtab: *target_of.SymtabEntry,
    symtab_count: u32, segs: *target_of.LoadSegment, seg_count: u32) res[SymtabBuild, fail.Fail] {
    var out: SymtabBuild;
    out.symtab_bytes = nil;
    out.symtab_size  = 0;
    out.strtab_bytes = nil;
    out.strtab_size  = 0;
    out.local_count  = 0;
    if (symtab_count == 0) { ret res[SymtabBuild, fail.Fail].ok{out}; }

    var strtab_sz: usize = 1;
    var i:         u32   = 0;
    for (i < symtab_count) {
        strtab_sz = strtab_sz + str_len(bin.resolve_name(itn, symtab[i].name)) + 1;
        i         = i + 1;
    }
    val symtab_sz: usize = lay.sym_size * (symtab_count::usize + 1);

    val sr: res[*u8, A.Error] = A.zallocate[u8](alloc, symtab_sz);
    if (sel sr.err) { ret res[SymtabBuild, fail.Fail].err{fail.message("symtab buffer alloc failed")}; }
    val sbuf: *u8 = sr.ok;

    val tr: res[*u8, A.Error] = A.zallocate[u8](alloc, strtab_sz);
    if (sel tr.err) {
        A.deallocate[u8](alloc, sbuf, symtab_sz);
        ret res[SymtabBuild, fail.Fail].err{fail.message("strtab buffer alloc failed")};
    }
    val tbuf: *u8 = tr.ok;

    tbuf[0] = 0;
    var str_pos: usize = 1;
    i = 0;
    for (i < symtab_count) {
        val name_pos: usize = str_pos;
        str_pos = str_pos + bin.write_str(tbuf, str_pos, bin.resolve_name(itn, symtab[i].name));

        # an image's symbols name only its allocated sections, which come first
        # and stay far below the reserved indexes, so it carries no .symtab_shndx
        val section: u32 = image_section_shndx(segs, seg_count, symtab[i].vaddr);
        var shndx:   u16 = SHN_ABS;
        if (section >= SHN_LORESERVE) {
            A.deallocate[u8](alloc, sbuf, symtab_sz);
            A.deallocate[u8](alloc, tbuf, strtab_sz);
            ret res[SymtabBuild, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "an image symbol's section index needs extended section numbering")};
        }
        if (section != 0) { shndx = section::u16; }

        var st_type: u8 = STT_NOTYPE;
        if (symtab[i].kind == target_of.SYMT_FUNC)   { st_type = STT_FUNC; }
        or (symtab[i].kind == target_of.SYMT_OBJECT) { st_type = STT_OBJECT; }

        var binding: u8 = STB_GLOBAL;
        if (!symtab[i].global) {
            binding         = STB_LOCAL;
            out.local_count = out.local_count + 1;
        }

        val sym_off: usize = lay.sym_size * (i::usize + 1);
        write_sym_at(sbuf, sym_off, lay, name_pos::u32, (binding << 4) | (st_type & 0xF), 0,
            shndx, symtab[i].vaddr, symtab[i].size::u64);

        i = i + 1;
    }

    out.symtab_bytes = sbuf;
    out.symtab_size  = symtab_sz;
    out.strtab_bytes = tbuf;
    out.strtab_size  = strtab_sz;
    out.local_count  = out.local_count + 1;
    ret res[SymtabBuild, fail.Fail].ok{out};
}

val SYMTAB_SHNDX_NAME: str = ".symtab_shndx";

# the .symtab_shndx entry of ELF symbol `elf_idx`, when the object has the table
fun put_symbol_shndx(buf: *u8, fp: *of_plan.FilePlan, row: u32, elf_idx: u32, index: u32) {
    if (row == of_plan.NO_ROW) { ret; }
    bin.write_u32_le(buf, of_plan.offset(fp, row) + elf_idx::usize * 4, index);
}

fun free_symtab_bytes(alloc: *A.Allocator, b: *SymtabBuild) {
    if (b.symtab_bytes != nil) { A.deallocate[u8](alloc, b.symtab_bytes, b.symtab_size); }
    if (b.strtab_bytes != nil) { A.deallocate[u8](alloc, b.strtab_bytes, b.strtab_size); }
}

# the section an instruction set's build attributes are written to: its name,
# its type, and the vendor whose subsection holds them
rec BuildAttributes {
    section: str;
    sht:     u32;
    vendor:  str;
}

fun attributes_for(tgt_isa: *target_of.ObjectTarget) *BuildAttributes {
    if (tgt_isa == nil) { ret nil; }
    val row: *IsaRow = row_for(tgt_isa.arch_id);
    if (row == nil || !row.has_attributes) { ret nil; }
    ret ?row.attributes;
}

fun build_attributes_size(attr: *BuildAttributes, body_len: u32) usize {
    val attr_data:     usize = body_len::usize;
    val file_subsec:   usize = leb128.unsigned_size(ATTR_TAG_FILE::u64) + 4 + attr_data;
    val vendor_subsec: usize = 4 + (str_len(attr.vendor) + 1) + file_subsec;
    ret 1 + vendor_subsec;
}

fun write_build_attributes(buf: *u8, offset: usize, attr: *BuildAttributes,
    body: *u8, body_len: u32) usize {
    var p: usize = offset;
    buf[p] = ATTR_VERSION_A;
    p      = p + 1;

    val attr_data:     usize = body_len::usize;
    val file_subsec:   usize = leb128.unsigned_size(ATTR_TAG_FILE::u64) + 4 + attr_data;
    val vendor_subsec: usize = 4 + (str_len(attr.vendor) + 1) + file_subsec;

    bin.write_u32_le(buf, p, vendor_subsec::u32);
    p = p + 4;
    p = p + bin.write_str(buf, p, attr.vendor);

    p = p + leb128.put_unsigned(?buf[p], ATTR_TAG_FILE::u64);
    bin.write_u32_le(buf, p, file_subsec::u32);
    p = p + 4;

    var i: u32 = 0;
    for (i < body_len) {
        buf[p + i::usize] = body[i];
        i                 = i + 1;
    }
    ret p + body_len::usize - offset;
}

rec ObjectScratch {
    shstrtab:          *u8;
    shstrtab_cap:      usize;
    name_offsets:      *u32;
    rela_name_offsets: *u32;
    sec_rows:          *u32;
    rela_rows:         *u32;
    rela_counts:       *u32;
    rela_grouped:      *u32;
    rela_index:        *u32;
    rela_ends:         *usize;
    sym_remap:         *u32;
    num_secs:          u32;
    num_syms:          u32;
}

fun object_scratch_free(alloc: *A.Allocator, s: *ObjectScratch) {
    if (s.shstrtab != nil)          { A.deallocate[u8](alloc, s.shstrtab, s.shstrtab_cap); }
    if (s.name_offsets != nil)      { A.deallocate[u32](alloc, s.name_offsets, (s.num_secs + 1)::usize); }
    if (s.rela_name_offsets != nil) { A.deallocate[u32](alloc, s.rela_name_offsets, (s.num_secs + 1)::usize); }
    if (s.sec_rows != nil)          { A.deallocate[u32](alloc, s.sec_rows, (s.num_secs + 1)::usize); }
    if (s.rela_rows != nil)         { A.deallocate[u32](alloc, s.rela_rows, (s.num_secs + 1)::usize); }
    if (s.rela_counts != nil)       { A.deallocate[u32](alloc, s.rela_counts, (s.num_secs + 1)::usize); }
    if (s.rela_grouped != nil)      { A.deallocate[u32](alloc, s.rela_grouped, (s.num_secs + 1)::usize); }
    if (s.rela_index != nil)        { A.deallocate[u32](alloc, s.rela_index, (s.num_secs + 1)::usize); }
    if (s.rela_ends != nil)         { A.deallocate[usize](alloc, s.rela_ends, (s.num_secs + 1)::usize); }
    if (s.sym_remap != nil)         { A.deallocate[u32](alloc, s.sym_remap, s.num_syms::usize); }
    s.shstrtab          = nil;
    s.name_offsets      = nil;
    s.rela_name_offsets = nil;
    s.sec_rows          = nil;
    s.rela_rows         = nil;
    s.rela_counts       = nil;
    s.rela_grouped      = nil;
    s.rela_index        = nil;
    s.rela_ends         = nil;
    s.sym_remap         = nil;
}

fun object_scratch_table(alloc: *A.Allocator, count: u32, what: str) res[*u32, fail.Fail] {
    val made: res[*u32, A.Error] = A.zallocate[u32](alloc, (count + 1)::usize);
    if (sel made.err) { ret res[*u32, fail.Fail].err{fail.message(what)}; }
    if (sel made.err) { ret res[*u32, fail.Fail].err{fail.refused(made.err)}; }
    ret res[*u32, fail.Fail].ok{made.ok};
}

fun limit(lay: *ElfLayout) usize {
    if (lay.addr_width == 4) { ret of_plan.LIMIT_32; }
    ret of_plan.limit_64();
}

# an ELFCLASS32 field is 32 bits wide; every value that reaches one through
# write_addr must be proven to fit before the buffer exists
fun class_fits(lay: *ElfLayout, value: u64) bool {
    if (lay.addr_width == 8) { ret true; }
    ret value <= 0xFFFFFFFF;
}

fun validate_class_widths(img: *target_of.ObjectImage, lay: *ElfLayout) err[fail.Fail] {
    if (lay.addr_width == 8) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if (target_of.section_is_absolute(img.symbols[i].section)
            && !class_fits(lay, img.symbols[i].absolute_value)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "absolute definition exceeds ELF32 value width")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.reloc_count) {
        val addend: i64 = img.relocations[i].addend;
        if (addend > 2147483647 || addend < -2147483648) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "relocation addend exceeds the ELF32 addend width")};
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.section_count) {
        if (!class_fits(lay, img.sections[i].native.flags) || !class_fits(lay, img.sections[i].native.entry_size)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "native section metadata exceeds the ELF32 field width")};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun object_emit(tgt_isa: *target_of.ObjectTarget, img: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    if (!img.codegen) { ret emit_object_record(tgt_isa, img, dst); }

    # elf spells sizes and section flags itself, so a codegen image's carrier
    # holds where each relocation's instruction ends and the unwind frames, in
    # `.mach.link`
    var bytes:   *u8            = nil;
    var len:     u32            = 0;
    val encoded: err[fail.Fail] = carrier.encode(img.alloc, img, img.section_count, nil::*carrier.Host,
        carrier.TABLE_RELOCS | carrier.TABLE_FRAMES, ?bytes, ?len);
    if (sel encoded.err) { ret encoded; }
    fin { A.deallocate[u8](img.alloc, bytes, len::usize); }
    var view:   target_of.ObjectImage;
    val viewed: err[fail.Fail] = carrier.with_carrier(img.alloc, img, carrier.SECTION_NAME,
        target_of.Section{name: intern.STR_NIL, kind: target_of.SK_DEBUG, bytes: nil, len: 0, align: 1}, bytes, len, ?view);
    if (sel viewed.err) { ret viewed; }
    fin { exports.release(img.alloc, ?view); }
    ret emit_object_record(tgt_isa, ?view, dst);
}

fun emit_object_record(tgt_isa: *target_of.ObjectTarget, img: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    if (img.cache_record_len == 0) { ret emit_object_requests(tgt_isa, img, dst); }

    # the cache record rides in `.mach.cache`, a non-alloc section no link loads
    var view:   target_of.ObjectImage;
    val viewed: err[fail.Fail] = record.with_record(img.alloc, img, record.SECTION_NAME,
        target_of.Section{name: intern.STR_NIL, kind: target_of.SK_DEBUG, bytes: nil, len: 0, align: 1}, ?view);
    if (sel viewed.err) { ret viewed; }
    fin { exports.release(img.alloc, ?view); }
    ret emit_object_requests(tgt_isa, ?view, dst);
}

fun emit_object_requests(tgt_isa: *target_of.ObjectTarget, img: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    if (img.export_request_count == 0) { ret emit_object_image(tgt_isa, img, dst); }

    # the request list rides in `.mach.exports`, a non-alloc section elf has
    # no native spelling for
    val alloc: *A.Allocator = img.alloc;

    var bytes: *u8            = nil;
    var len:   u32            = 0;
    val enc:   err[fail.Fail] = exports.encode(alloc, img, ?bytes, ?len);
    if (sel enc.err) { ret enc; }
    fin { A.deallocate[u8](alloc, bytes, len::usize); }
    val name_r: res[intern.StrId, A.Error] = intern.add(img.interner, exports.SECTION_NAME);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    var view:   target_of.ObjectImage;
    val viewed: err[fail.Fail] = exports.with_section(alloc, img, name_r.ok,
        target_of.Section{name: intern.STR_NIL, kind: target_of.SK_DEBUG, bytes: nil, len: 0, align: 4}, bytes, len, ?view);
    if (sel viewed.err) { ret viewed; }
    fin { exports.release(alloc, ?view); }
    ret emit_object_image(tgt_isa, ?view, dst);
}

fun emit_object_image(tgt_isa: *target_of.ObjectTarget, img: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    val alloc: *A.Allocator = img.alloc;

    if (img.import_count != 0) { ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, "attributed imports are not representable in an ELF relocatable object")}; }
    val native_valid: err[fail.Fail] = target_of.validate_native_sections(img, target_of.ELF);
    if (sel native_valid.err) { ret native_valid; }

    var lay:    ElfLayout      = layout_for(tgt_isa);
    val widths: err[fail.Fail] = validate_class_widths(img, ?lay);
    if (sel widths.err) { ret widths; }

    val vrs: err[fail.Fail] = bin.validate_reloc_symbols(img, UNRESOLVED, UNRESOLVED_UNNAMED);
    if (sel vrs.err) { ret vrs; }

    val vrk: err[fail.Fail] = validate_reloc_kinds(img, tgt_isa, ?lay);
    if (sel vrk.err) { ret vrk; }

    var attr: *BuildAttributes = attributes_for(tgt_isa);
    if (img.attributes == nil || img.attributes_len == 0) { attr = nil; }
    var attr_size: usize = 0;
    if (attr != nil) { attr_size = build_attributes_size(attr, img.attributes_len); }

    val num_secs: u32 = img.section_count;
    val num_syms: u32 = img.symbol_count;

    var scratch: ObjectScratch;
    scratch.shstrtab          = nil;
    scratch.name_offsets      = nil;
    scratch.rela_name_offsets = nil;
    scratch.sec_rows          = nil;
    scratch.rela_rows         = nil;
    scratch.rela_counts       = nil;
    scratch.rela_grouped      = nil;
    scratch.rela_index        = nil;
    scratch.rela_ends         = nil;
    scratch.sym_remap         = nil;
    scratch.num_secs          = num_secs;
    scratch.num_syms          = num_syms;
    fin { object_scratch_free(alloc, ?scratch); }

    val res_counts: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "relocation count table alloc failed");
    if (sel res_counts.err) { ret err[fail.Fail].err{res_counts.err}; }
    scratch.rela_counts = res_counts.ok;
    val res_grouped: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "relocation group table alloc failed");
    if (sel res_grouped.err) { ret err[fail.Fail].err{res_grouped.err}; }
    scratch.rela_grouped = res_grouped.ok;
    val res_index: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "relocation index table alloc failed");
    if (sel res_index.err) { ret err[fail.Fail].err{res_index.err}; }
    scratch.rela_index = res_index.ok;
    val res_ends: res[*usize, A.Error] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (sel res_ends.err) { ret err[fail.Fail].err{fail.refused(res_ends.err)}; }
    scratch.rela_ends = res_ends.ok;
    var rela:          RelaTables = rela_tables(img, scratch.rela_counts, scratch.rela_grouped, scratch.rela_index);
    val num_rela_secs: u32        = rela.present;

    # a section indexed from SHN_LORESERVE up is named by its symbols through
    # .symtab_shndx, the last header
    val extended_symbols: bool  = num_secs >= SHN_LORESERVE;
    var total_shdr:       usize = 1 + num_secs::usize + 3 + num_rela_secs::usize;
    if (attr != nil)      { total_shdr = total_shdr + 1; }
    if (extended_symbols) { total_shdr = total_shdr + 1; }
    val numbering: res[SectionNumbering, fail.Fail] = section_numbering(total_shdr, num_secs::usize + 3);
    if (sel numbering.err) { ret err[fail.Fail].err{numbering.err}; }

    var shstrtab_cap: usize = 1;
    var s:            u32   = 0;
    for (s < num_secs) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (sn != nil) { shstrtab_cap = shstrtab_cap + str_len(sn) + 1; }
        or             { shstrtab_cap = shstrtab_cap + 1; }
        s = s + 1;
    }
    shstrtab_cap = shstrtab_cap + 8 + 8 + 10;
    if (attr != nil)      { shstrtab_cap = shstrtab_cap + str_len(attr.section) + 1; }
    if (extended_symbols) { shstrtab_cap = shstrtab_cap + str_len(SYMTAB_SHNDX_NAME) + 1; }
    s = 0;
    for (s < num_secs) {
        if (rela_present(?rela, s)) {
            val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
            if (sn != nil) { shstrtab_cap = shstrtab_cap + 5 + str_len(sn) + 1; }
            or             { shstrtab_cap = shstrtab_cap + 5 + 1; }
        }
        s = s + 1;
    }

    val res_shstr: res[*u8, A.Error] = A.zallocate[u8](alloc, shstrtab_cap);
    if (sel res_shstr.err) { ret err[fail.Fail].err{fail.message("shstrtab alloc failed")}; }
    scratch.shstrtab     = res_shstr.ok;
    scratch.shstrtab_cap = shstrtab_cap;
    val shstrtab: *u8 = scratch.shstrtab;

    val res_names: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "name table alloc failed");
    if (sel res_names.err) { ret err[fail.Fail].err{res_names.err}; }
    scratch.name_offsets = res_names.ok;
    val name_offsets: *u32 = scratch.name_offsets;

    val res_rnames: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "rela name table alloc failed");
    if (sel res_rnames.err) { ret err[fail.Fail].err{res_rnames.err}; }
    scratch.rela_name_offsets = res_rnames.ok;
    val rela_name_offsets: *u32 = scratch.rela_name_offsets;

    val res_srows: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "section row table alloc failed");
    if (sel res_srows.err) { ret err[fail.Fail].err{res_srows.err}; }
    scratch.sec_rows = res_srows.ok;
    val sec_rows: *u32 = scratch.sec_rows;

    val res_rrows: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "rela row table alloc failed");
    if (sel res_rrows.err) { ret err[fail.Fail].err{res_rrows.err}; }
    scratch.rela_rows = res_rrows.ok;
    val rela_rows: *u32 = scratch.rela_rows;

    var shstrtab_off: usize = 1;
    s = 0;
    for (s < num_secs) {
        name_offsets[s] = shstrtab_off::u32;
        shstrtab_off    = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, bin.resolve_name(img.interner, img.sections[s].name));
        s               = s + 1;
    }
    val symtab_name_off: u32 = shstrtab_off::u32;
    shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, ".symtab");
    val strtab_name_off: u32 = shstrtab_off::u32;
    shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, ".strtab");
    val shstrtab_name_off: u32 = shstrtab_off::u32;
    shstrtab_off = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, ".shstrtab");
    var attr_name_off: u32 = 0;
    if (attr != nil) {
        attr_name_off = shstrtab_off::u32;
        shstrtab_off  = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, attr.section);
    }
    var shndx_name_off: u32 = 0;
    if (extended_symbols) {
        shndx_name_off = shstrtab_off::u32;
        shstrtab_off   = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, SYMTAB_SHNDX_NAME);
    }

    s = 0;
    for (s < num_secs) {
        if (rela_present(?rela, s)) {
            rela_name_offsets[s]       = shstrtab_off::u32;
            shstrtab[shstrtab_off]     = '.';
            shstrtab[shstrtab_off + 1] = 'r';
            shstrtab[shstrtab_off + 2] = 'e';
            shstrtab[shstrtab_off + 3] = 'l';
            shstrtab[shstrtab_off + 4] = 'a';
            shstrtab_off               = shstrtab_off + 5;
            shstrtab_off               = shstrtab_off + bin.write_str(shstrtab, shstrtab_off, bin.resolve_name(img.interner, img.sections[s].name));
        }
        s = s + 1;
    }
    val shstrtab_len: usize = shstrtab_off;
    if (shstrtab_len > shstrtab_cap) { ret err[fail.Fail].err{fail.message("section name table exceeds its measured capacity")}; }

    val planned: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, img.interner, "elf", limit(?lay));
    if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
    var fp: of_plan.FilePlan = planned.ok;
    fin { of_plan.dnit(?fp); }

    val header_row: res[u32, fail.Fail] = of_plan.place_at(?fp, "elf header", target_of.no_section(), 0, lay.ehdr_size);
    if (sel header_row.err) { ret err[fail.Fail].err{header_row.err}; }

    s = 0;
    for (s < num_secs) {
        sec_rows[s] = of_plan.NO_ROW;
        if (img.sections[s].kind != target_of.SK_BSS) {
            val row: res[u32, fail.Fail] = of_plan.place(?fp, "section data", target_of.section_id(s),
                img.sections[s].align::usize, img.sections[s].len::usize);
            if (sel row.err) { ret err[fail.Fail].err{row.err}; }
            sec_rows[s] = row.ok;
        }
        s = s + 1;
    }

    val symtab_size: res[usize, fail.Fail] = of_plan.table(?fp, "symbol table", (num_syms + 1)::usize, lay.sym_size);
    if (sel symtab_size.err) { ret err[fail.Fail].err{symtab_size.err}; }
    val symtab_r: res[u32, fail.Fail] = of_plan.place(?fp, "symbol table", target_of.no_section(), lay.struct_align, symtab_size.ok);
    if (sel symtab_r.err) { ret err[fail.Fail].err{symtab_r.err}; }
    val symtab_row: u32 = symtab_r.ok;

    val strtab_r: res[u32, fail.Fail] = of_plan.place(?fp, "string table", target_of.no_section(), 1, bin.strtab_size(img));
    if (sel strtab_r.err) { ret err[fail.Fail].err{strtab_r.err}; }
    val strtab_row: u32 = strtab_r.ok;

    val shstrtab_r: res[u32, fail.Fail] = of_plan.place(?fp, "section name table", target_of.no_section(), 1, shstrtab_len);
    if (sel shstrtab_r.err) { ret err[fail.Fail].err{shstrtab_r.err}; }
    val shstrtab_row: u32 = shstrtab_r.ok;

    s = 0;
    for (s < num_secs) {
        rela_rows[s] = of_plan.NO_ROW;
        if (rela_present(?rela, s)) {
            val rc:        u32                   = rela.counts[s];
            val rela_size: res[usize, fail.Fail] = of_plan.table(?fp, "relocations", rc::usize, lay.rela_size);
            if (sel rela_size.err) { ret err[fail.Fail].err{rela_size.err}; }
            val row: res[u32, fail.Fail] = of_plan.place(?fp, "relocations", target_of.section_id(s), lay.struct_align, rela_size.ok);
            if (sel row.err) { ret err[fail.Fail].err{row.err}; }
            rela_rows[s] = row.ok;
        }
        s = s + 1;
    }

    var attr_row: u32 = of_plan.NO_ROW;
    if (attr != nil) {
        val row: res[u32, fail.Fail] = of_plan.place(?fp, "build attributes", target_of.no_section(), 1, attr_size);
        if (sel row.err) { ret err[fail.Fail].err{row.err}; }
        attr_row = row.ok;
    }

    var shndx_row: u32 = of_plan.NO_ROW;
    if (extended_symbols) {
        val shndx_size: res[usize, fail.Fail] = of_plan.table(?fp, "symbol section indexes", (num_syms + 1)::usize, 4);
        if (sel shndx_size.err) { ret err[fail.Fail].err{shndx_size.err}; }
        val row: res[u32, fail.Fail] = of_plan.place(?fp, "symbol section indexes", target_of.no_section(), 4, shndx_size.ok);
        if (sel row.err) { ret err[fail.Fail].err{row.err}; }
        shndx_row = row.ok;
    }

    val shdr_size: res[usize, fail.Fail] = of_plan.table(?fp, "section header table", total_shdr, lay.shdr_size);
    if (sel shdr_size.err) { ret err[fail.Fail].err{shdr_size.err}; }
    val shdr_r: res[u32, fail.Fail] = of_plan.place(?fp, "section header table", target_of.no_section(), lay.struct_align, shdr_size.ok);
    if (sel shdr_r.err) { ret err[fail.Fail].err{shdr_r.err}; }
    val shdr_row: u32 = shdr_r.ok;

    val sealed: res[usize, fail.Fail] = of_plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_file_size: usize = sealed.ok;

    if (num_syms > 0) {
        val res_remap: res[*u32, A.Error] = A.zallocate[u32](alloc, num_syms::usize);
        if (sel res_remap.err) { ret err[fail.Fail].err{fail.message("symbol remap alloc failed")}; }
        scratch.sym_remap = res_remap.ok;
    }
    val sym_remap: *u32 = scratch.sym_remap;

    val res_buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", total_file_size, 0o644);
    if (sel res_buf.err) { ret err[fail.Fail].err{res_buf.err}; }
    var buf: *u8 = res_buf.ok;

    write_elf_ident(buf, ?lay);
    write_ehdr(buf, ?lay, ET_REL, machine_for_arch(tgt_isa.arch_id), img.machine_flags,
        0, 0, of_plan.offset(?fp, shdr_row)::u64, 0, numbering.ok.e_shnum, numbering.ok.e_shstrndx);

    s = 0;
    for (s < num_secs) {
        if (sec_rows[s] != of_plan.NO_ROW) {
            val sec_offset: usize = of_plan.offset(?fp, sec_rows[s]);
            if (img.sections[s].bytes != nil && img.sections[s].len > 0) {
                memory.raw_copy((buf::usize + sec_offset)::ptr, img.sections[s].bytes::ptr, img.sections[s].len::usize);
                if (img.sections[s].native.format == target_of.ELF && img.sections[s].native.kind == SHT_GROUP) {
                    var at: usize = 4;
                    for (at < img.sections[s].len::usize) {
                        val member: u32 = bin.read_u32_le(img.sections[s].bytes, at);
                        if ((member & target_of.NATIVE_GROUP_RELOC) != 0) {
                            bin.write_u32_le(buf, sec_offset + at,
                                rela.index[(member & ~target_of.NATIVE_GROUP_RELOC) - 1]);
                        }
                        at = at + 4;
                    }
                }
            }
        }
        s = s + 1;
    }

    val symtab_offset: usize = of_plan.offset(?fp, symtab_row);
    val strtab_offset: usize = of_plan.offset(?fp, strtab_row);
    var sym_off:       usize = symtab_offset + lay.sym_size;
    buf[strtab_offset] = 0;
    var str_pos: usize = 1;
    var elf_idx: u32   = 1;

    var symi: u32 = 0;
    for (symi < num_syms) {
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0) {
            symi = symi + 1;
            cnt;
        }
        if (sym_remap != nil) { sym_remap[symi] = elf_idx; }
        put_symbol_shndx(buf, ?fp, shndx_row, elf_idx, write_symbol(buf, sym_off, ?lay, strtab_offset, ?str_pos, img, symi, STB_LOCAL));
        sym_off = sym_off + lay.sym_size;
        elf_idx = elf_idx + 1;
        symi    = symi + 1;
    }
    val first_global: u32 = elf_idx;
    symi = 0;
    for (symi < num_syms) {
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) {
            symi = symi + 1;
            cnt;
        }
        if (sym_remap != nil) { sym_remap[symi] = elf_idx; }
        var bind: u8 = STB_GLOBAL;
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_WEAK) != 0) { bind = STB_WEAK; }
        put_symbol_shndx(buf, ?fp, shndx_row, elf_idx, write_symbol(buf, sym_off, ?lay, strtab_offset, ?str_pos, img, symi, bind));
        sym_off = sym_off + lay.sym_size;
        elf_idx = elf_idx + 1;
        symi    = symi + 1;
    }
    put_symbol_shndx(buf, ?fp, shndx_row, 0, 0);
    if (shndx_row != of_plan.NO_ROW) {
        val shndx_closed: err[fail.Fail] = of_plan.close_size(?fp, shndx_row, (elf_idx::usize) * 4);
        if (sel shndx_closed.err) { ret shndx_closed; }
    }
    val symtab_closed: err[fail.Fail] = of_plan.close(?fp, symtab_row, sym_off);
    if (sel symtab_closed.err) { ret symtab_closed; }
    val strtab_closed: err[fail.Fail] = of_plan.close_size(?fp, strtab_row, str_pos);
    if (sel strtab_closed.err) { ret strtab_closed; }

    memory.raw_copy((buf::usize + of_plan.offset(?fp, shstrtab_row))::ptr, shstrtab::ptr, shstrtab_len);

    val rela_ends: *usize = scratch.rela_ends;
    s = 0;
    for (s < num_secs) {
        if (rela_rows[s] != of_plan.NO_ROW) { rela_ends[s] = of_plan.offset(?fp, rela_rows[s]); }
        s = s + 1;
    }
    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        val rs: u32 = target_of.section_index(img.relocations[ri].section);
        if (rs < num_secs && rela_rows[rs] != of_plan.NO_ROW) {
            val rsi_r: res[u32, fail.Fail] = bin.reloc_sym_index(img, ?img.relocations[ri], UNRESOLVED, UNRESOLVED_UNNAMED);
            if (sel rsi_r.err) { ret err[fail.Fail].err{rsi_r.err}; }
            val rsi:        u32                 = rsi_r.ok;
            val elf_type_r: res[u32, fail.Fail] = reloc_type_for(img.interner, alloc, img.relocations[ri].kind, tgt_isa, img.relocations[ri].origin);
            if (sel elf_type_r.err) { ret err[fail.Fail].err{elf_type_r.err}; }
            rela_ends[rs] = write_rela_at(buf, rela_ends[rs], ?lay, img.relocations[ri].offset::u64,
                sym_remap[rsi], elf_type_r.ok, img.relocations[ri].addend);
        }
        ri = ri + 1;
    }
    s = 0;
    for (s < num_secs) {
        if (rela_rows[s] != of_plan.NO_ROW) {
            val rela_closed: err[fail.Fail] = of_plan.close(?fp, rela_rows[s], rela_ends[s]);
            if (sel rela_closed.err) { ret rela_closed; }
        }
        s = s + 1;
    }

    if (attr_row != of_plan.NO_ROW) {
        val written:     usize          = write_build_attributes(buf, of_plan.offset(?fp, attr_row), attr, img.attributes, img.attributes_len);
        val attr_closed: err[fail.Fail] = of_plan.close_size(?fp, attr_row, written);
        if (sel attr_closed.err) { ret attr_closed; }
    }

    var shdr_pos: usize = write_null_shdr(buf, of_plan.offset(?fp, shdr_row), ?lay, ?numbering.ok);

    s = 0;
    for (s < num_secs) {
        var sh_off: u64 = 0;
        if (sec_rows[s] != of_plan.NO_ROW) { sh_off = of_plan.offset(?fp, sec_rows[s])::u64; }
        # a merged string is one byte wide, any other merged entry the whole section
        var entsize:  u64 = 0;
        val sh_flags: u64 = section_flags_for_section(?img.sections[s]);
        if ((sh_flags & SHF_STRINGS) != 0) { entsize = 1; }
        or ((sh_flags & SHF_MERGE) != 0)   { entsize = img.sections[s].len::u64; }
        val declared_type: opt[u32] = section_type_for(img.sections[s].kind);
        if (sel declared_type.none) {
            ret err[fail.Fail].err{fail.message_of(target_of.section_kind_rejection(img.interner, img.alloc, img.sections[s].kind))};
        }
        var section_type: u32 = declared_type.some;
        if (img.sections[s].native.format == target_of.ELF) {
            section_type = img.sections[s].native.kind;
            entsize      = img.sections[s].native.entry_size;
        }
        var native_link: u32 = img.sections[s].native.link_section;
        var native_info: u32 = 0;
        if (section_type == SHT_GROUP) {
            native_link = 1 + num_secs;
            native_info = sym_remap[img.sections[s].native.link_symbol - 1];
        }
        shdr_pos = write_shdr(buf, shdr_pos, ?lay, name_offsets[s],
            section_type,
            section_flags_for_section(?img.sections[s]), 0,
            sh_off, img.sections[s].len::u64, native_link, native_info,
            img.sections[s].align::u64, entsize);
        s = s + 1;
    }

    val symtab_shidx: u32 = 1 + num_secs;
    shdr_pos = write_shdr(buf, shdr_pos, ?lay, symtab_name_off, SHT_SYMTAB, 0, 0,
        symtab_offset::u64, of_plan.size(?fp, symtab_row)::u64,
        (symtab_shidx + 1)::u32, first_global::u32,
        lay.struct_align::u64, lay.sym_size::u64);

    shdr_pos = write_shdr(buf, shdr_pos, ?lay, strtab_name_off, SHT_STRTAB, 0, 0,
        strtab_offset::u64, of_plan.size(?fp, strtab_row)::u64, 0, 0, 1, 0);

    shdr_pos = write_shdr(buf, shdr_pos, ?lay, shstrtab_name_off, SHT_STRTAB, 0, 0,
        of_plan.offset(?fp, shstrtab_row)::u64, shstrtab_len::u64, 0, 0, 1, 0);

    s = 0;
    for (s < num_secs) {
        if (rela_rows[s] != of_plan.NO_ROW) {
            var flags: u64 = 0;
            if (rela.grouped[s] != 0) { flags = 0x200; }
            shdr_pos = write_shdr(buf, shdr_pos, ?lay, rela_name_offsets[s], SHT_RELA, flags, 0,
                of_plan.offset(?fp, rela_rows[s])::u64, of_plan.size(?fp, rela_rows[s])::u64,
                symtab_shidx::u32, (s + 1)::u32,
                lay.struct_align::u64, lay.rela_size::u64);
        }
        s = s + 1;
    }

    if (attr_row != of_plan.NO_ROW) {
        shdr_pos = write_shdr(buf, shdr_pos, ?lay, attr_name_off, attr.sht, 0, 0,
            of_plan.offset(?fp, attr_row)::u64, attr_size::u64, 0, 0, 1, 0);
    }
    if (shndx_row != of_plan.NO_ROW) {
        shdr_pos = write_shdr(buf, shdr_pos, ?lay, shndx_name_off, SHT_SYMTAB_SHNDX, 0, 0,
            of_plan.offset(?fp, shndx_row)::u64, of_plan.size(?fp, shndx_row)::u64, symtab_shidx, 0, 4, 4);
    }
    val shdr_closed: err[fail.Fail] = of_plan.close(?fp, shdr_row, shdr_pos);
    if (sel shdr_closed.err) { ret shdr_closed; }

    ret err[fail.Fail].ok{};
}

# the type ELF numbers a relocation kind with for one instruction set: the
# first row of a kind is the type written, and every row is a type read
rec RelocRow {
    kind:   target_of.RelocKind;
    r_type: u32;
}

def PltHeaderFn:     fun(*u8, *DynLayout) err[fail.Fail];
def PltStubFn:       fun(*u8, *DynLayout, u32, usize, u64) err[fail.Fail];
def SiteWidthFn:     fun(target_of.RelocKind) res[usize, fail.Fail];
def CallPatchFn:     fun(*u8, usize, target_of.RelocKind, u64, i64, u64) err[fail.Fail];
def ImportAddressFn: fun(*u8, usize, *target_of.ImportFixup, u64, usize) err[fail.Fail];

# everything ELF numbers or encodes for one instruction set it covers, the row
# at that instruction set's index in COVERS_ISAS
rec IsaRow {
    machine:     u16;
    relocs:      *RelocRow;
    reloc_count: u32;
    # the e_flags word and the build attributes, kept for the generic layers
    record:         target_of.IsaRecord;
    attributes:     BuildAttributes;
    has_attributes: bool;
    # the processor-specific type of an unwind table section, 0 for none
    unwind_sht: u32;
    relative:   u32;
    # the instruction set links into dynamic executables; every field below is
    # read only then
    dynamic:   bool;
    jump_slot: u32;
    glob_dat:  u32;
    # every import is bound at load rather than at its first call
    bind_now: bool;
    # where a lazily bound PLT slot first points, as an offset into its stub
    lazy_resume:     u64;
    plt_header_size: usize;
    # nil when the PLT has no header
    plt_header: PltHeaderFn;
    plt_stub:   PltStubFn;
    # nil when every patched site is one word
    site_width: SiteWidthFn;
    call_patch: CallPatchFn;
    # binds one part of a function import's pc-relative address to its stub,
    # nil when the instruction set takes no such address
    stub_address:   target_of.ApplyRelocFn;
    import_address: ImportAddressFn;
}

