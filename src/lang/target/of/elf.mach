}

test "mach.lang.target.of.elf.write_build_attributes:riscv_arch_layout" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var attr: BuildAttributes;
    attr.section = ".riscv.attributes";
    attr.sht     = SHT_RISCV_ATTRIBUTES;
    attr.vendor  = "riscv";

    var body: [10]u8;
    body[0] = 5;
    val archs: str = "rv64i2p0";
    var bi:    u32 = 0;
    for (archs[bi::usize] != 0) {
        body[1 + bi] = archs[bi::usize]::u8;
        bi           = bi + 1;
    }
    body[1 + bi] = 0;
    val body_len: u32 = bi + 2;

    val sz: usize = build_attributes_size(?attr, body_len);
    if (sz != 26) { ret 1; }

    val rb: res[*u8, A.Error] = A.zallocate[u8](?alloc, sz);
    if (sel rb.err) { ret 1; }
    val buf: *u8 = rb.ok;
    write_build_attributes(buf, 0, ?attr, ?body[0], body_len);

    var bad: bool = false;
    if (buf[0] != ELF_ATTR_VERSION_A)  { bad = true; }
    if (bin.read_u32_le(buf, 1) != 25) { bad = true; }
    val rv: res[str, fail.Fail] = bin.cstr_at(buf, sz, 5);
    if (sel rv.ok && !str_equals(rv.ok, "riscv")) { bad = true; }
    if (buf[11]::u32 != ELF_ATTR_TAG_FILE)        { bad = true; }
    if (bin.read_u32_le(buf, 12) != 15)           { bad = true; }
    if (buf[16]::u32 != 5)                        { bad = true; }
    val ra: res[str, fail.Fail] = bin.cstr_at(buf, sz, 17);
    if (sel ra.ok && !str_equals(ra.ok, "rv64i2p0")) { bad = true; }

    A.deallocate[u8](?alloc, buf, sz);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:riscv_attributes_section" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val r_4708: err[fail.Fail] = register(?of_reg);
    if (sel r_4708.err) { ret 1; }

    t_riscv_attrs.section = ".riscv.attributes";
    t_riscv_attrs.sht     = SHT_RISCV_ATTRIBUTES;
    t_riscv_attrs.vendor  = "riscv";

    var seam: isa.RelocSeam = t_seam(t_riscv_elf_reloc_type);
    isa.with_elf_attributes(?seam, ?t_riscv_attrs);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_RISCV64, EM_RISCV::u32, ?seam);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0x13;
        k             = k + 1;
    }

    var secs: [1]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name    = t_intern(?i, "g");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "test");
    img.sections      = ?secs[0];
    img.section_count = 1;
    img.symbols       = ?syms[0];
    img.symbol_count  = 1;
    img.relocations   = nil;
    img.reloc_count   = 0;

    var body: [16]u8;
    body[0] = 5;
    val archs: str = "rv64i2p0_m2p0";
    var bi:    u32 = 0;
    for (archs[bi::usize] != 0) {
        body[1 + bi] = archs[bi::usize]::u8;
        bi           = bi + 1;
    }
    body[1 + bi]       = 0;
    img.attributes     = ?body[0];
    img.attributes_len = bi + 2;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_attr");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    val e_shoff:     usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shentsize: usize = bin.read_u16_le(buf.data, 58)::usize;
    val e_shnum:     usize = bin.read_u16_le(buf.data, 60)::usize;
    var attr_off:    usize = 0;
    var sh:          usize = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh * e_shentsize;
        if (bin.read_u32_le(buf.data, so + 4) == SHT_RISCV_ATTRIBUTES) {
            attr_off = bin.read_u64_le(buf.data, so + 24)::usize;
        }
        sh = sh + 1;
    }
    if (attr_off == 0) { ret 1; }

    if (buf.data[attr_off] != ELF_ATTR_VERSION_A) { ret 1; }
    val ra: res[str, fail.Fail] = bin.cstr_at(buf.data, buf.len, attr_off + 17);
    if (sel ra.err)                          { ret 1; }
    if (!str_equals(ra.ok, "rv64i2p0_m2p0")) { ret 1; }
    val retain_bytes_r: err[outcome.Fail] = output.retain_bytes(?alloc, "elf-riscv-attributes.o", buf.data, buf.len);
    if (sel retain_bytes_r.err) { ret 9; }
    ret 0;
}

fun t_emit_dyn_one(alloc: *A.Allocator, itn: *intern.Interner, arch_id: u32, lay: *DynLayout) *u8 {
    var imports: [1]of.DynImport;
    imports[0].symbol    = t_intern(itn, "getpid");
    imports[0].lib_index = of.DYNLIB_ANY;
    imports[0].is_func   = true;

    var dyn: of.DynamicInfo;
    dyn.libs             = nil;
    dyn.lib_count        = 0;
    dyn.imports          = ?imports[0];
    dyn.import_count     = 1;
    dyn.interp           = t_intern(itn, "/lib/ld.so.1");
    dyn.base_relocs      = nil;
    dyn.base_reloc_count = 0;
    dyn.pie              = false;

    var got:     ImportAddressPlan;
    val planned: res[plan.FilePlan, fail.Fail] = plan.init(alloc, itn, "elf", plan.limit_64());
    if (sel planned.err) { ret nil; }
    var fp: plan.FilePlan = planned.ok;
    fin { plan.dnit(?fp); }
    val r_4802: err[fail.Fail] = compute_dyn_layout(itn, ?fp, lay, ?dyn, ?got, 1, arch_id, 0x400000, 4096);
    if (sel r_4802.err) { ret nil; }
    val r_4803: res[usize, fail.Fail] = plan.seal(?fp);
    if (sel r_4803.err) { ret nil; }
    val total: usize             = lay.rw_off + lay.rw_size;
    val rb:    res[*u8, A.Error] = A.zallocate[u8](alloc, total);
    if (sel rb.err) { ret nil; }
    val buf: *u8 = rb.ok;

    var imp_str: [1]usize;
    var lib_str: [1]usize;
    val r_4811:  err[fail.Fail] = write_dyn_structures(itn, buf, ?fp, lay, ?dyn, ?got, 1, arch_id, ?imp_str[0], ?lib_str[0]);
    if (sel r_4811.err) {
        A.deallocate[u8](alloc, buf, total);
        ret nil;
    }
    ret buf;
}

fun t_dyn_has(buf: *u8, lay: *DynLayout, tag: u64, value: u64) bool {
    val count: usize = lay.dynamic_size / DYN_SIZE;
    var k:     usize = 0;
    for (k < count) {
        val off: usize = lay.dynamic_off + k * DYN_SIZE;
        val t:   u64   = bin.read_u64_le(buf, off);
        if (t == tag && bin.read_u64_le(buf, off + 8) == value) { ret true; }
        if (t == DT_NULL)                                       { ret false; }
        k = k + 1;
    }
    ret false;
}

test "mach.lang.target.of.elf.write_plt_stub:eager_arch_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var lay: DynLayout;
    lay.plt_off   = 0;
    lay.plt_va    = 0x2000;
    lay.gotplt_va = 0x4000;

    val rb: res[*u8, A.Error] = A.zallocate[u8](?alloc, 64);
    if (sel rb.err) { ret 1; }
    val buf: *u8 = rb.ok;

    var bad: bool = false;

    write_plt_stub(buf, ?lay, 0, isa.ARCH_AARCH64);
    if (bin.read_u32_le(buf, 0) != 0xD0000010)  { bad = true; }
    if (bin.read_u32_le(buf, 4) != 0xF9400E10)  { bad = true; }
    if (bin.read_u32_le(buf, 8) != 0xD61F0200)  { bad = true; }
    if (bin.read_u32_le(buf, 12) != 0xD503201F) { bad = true; }

    write_plt_stub(buf, ?lay, 1, isa.ARCH_AARCH64);
    if (bin.read_u32_le(buf, 16 + 4) != 0xF9401210) { bad = true; }

    write_plt_stub(buf, ?lay, 0, isa.ARCH_RISCV64);
    if (bin.read_u32_le(buf, 0) != 0x00002E17)  { bad = true; }
    if (bin.read_u32_le(buf, 4) != 0x018E3E03)  { bad = true; }
    if (bin.read_u32_le(buf, 8) != 0x000E0067)  { bad = true; }
    if (bin.read_u32_le(buf, 12) != 0x00000013) { bad = true; }

    A.deallocate[u8](?alloc, buf, 64);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.write_plt_stub:x86_64_lazy_unchanged" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var lay: DynLayout;
