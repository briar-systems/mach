test "mach.lang.target.of.elf.emit_exec:debug_sections_nonalloc" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x90;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x401000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE;
    info_bytes[1] = 0xAD;
    info_bytes[2] = 0xBE;
    info_bytes[3] = 0xEF;
    var line_bytes: [3]u8;
    line_bytes[0] = 0x11;
    line_bytes[1] = 0x22;
    line_bytes[2] = 0x33;

    val nm_info: res[intern.StrId, A.Error] = intern.intern(?i, ".debug_info");
    val nm_line: res[intern.StrId, A.Error] = intern.intern(?i, ".debug_line");
    if (sel nm_info.err) { ret 1; }
    if (sel nm_line.err) { ret 1; }

    var dbg: [2]of.Section;
    dbg[0].name  = nm_info.ok;
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0];
    dbg[0].len   = 4;
    dbg[0].align = 1;
    dbg[1].name  = nm_line.ok;
    dbg[1].kind  = of.SK_DEBUG;
    dbg[1].bytes = ?line_bytes[0];
    dbg[1].len   = 3;
    dbg[1].align = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_dbg");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
        4096, 0x400000, 0x401000,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        ?dbg[0], 2, nil::*of.SymtabEntry, 0,
        tpath::*u8, "elfdbg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var bad: bool = false;

    val e_shoff:    usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shnum:    u32   = bin.read_u16_le(buf.data, 60)::u32;
    val e_shstrndx: u32   = bin.read_u16_le(buf.data, 62)::u32;
    if (e_shoff == 0)    { bad = true; }
    if (e_shnum != 6)    { bad = true; }
    if (e_shstrndx != 5) { bad = true; }

    if (bad) { ret 1; }

    val shstr_hdr:  usize = e_shoff + e_shstrndx::usize * SHDR_SIZE;
    val shstr_base: usize = bin.read_u64_le(buf.data, shstr_hdr + 24)::usize;

    val info_want: str = ".debug_info";
    val line_want: str = ".debug_line";

    # the build id note is the allocated section between the segment and the debug sections
    val shn: usize = e_shoff + 2 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, shn + 4) != SHT_NOTE)                                                      { bad = true; }
    if ((bin.read_u64_le(buf.data, shn + 8) & SHF_ALLOC) == 0)                                               { bad = true; }
    if (bin.read_u64_le(buf.data, shn + 32)::usize != buildid.ELF_NOTE_SIZE)                                 { bad = true; }
    if (!buildid.elf_note_header_valid((buf.data::usize + bin.read_u64_le(buf.data, shn + 24)::usize)::*u8)) { bad = true; }

    val sh2: usize = e_shoff + 3 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, sh2 + 4) != SHT_PROGBITS)    { bad = true; }
    if ((bin.read_u64_le(buf.data, sh2 + 8) & SHF_ALLOC) != 0) { bad = true; }
    if (bin.read_u64_le(buf.data, sh2 + 16) != 0)              { bad = true; }
    if (bin.read_u64_le(buf.data, sh2 + 32)::usize != 4)       { bad = true; }
    val n2: usize = shstr_base + bin.read_u32_le(buf.data, sh2)::usize;
    var j:  usize = 0;
    for (j < str_len(info_want)) {
        if (buf.data[n2 + j] != info_want[j]) { bad = true; }
        j = j + 1;
    }
    if (buf.data[n2 + str_len(info_want)] != 0) { bad = true; }
    val off2: usize = bin.read_u64_le(buf.data, sh2 + 24)::usize;
    if (buf.data[off2] != 0xDE || buf.data[off2 + 1] != 0xAD
        || buf.data[off2 + 2] != 0xBE || buf.data[off2 + 3] != 0xEF) { bad = true; }

    val sh3: usize = e_shoff + 4 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, sh3 + 4) != SHT_PROGBITS)    { bad = true; }
    if ((bin.read_u64_le(buf.data, sh3 + 8) & SHF_ALLOC) != 0) { bad = true; }
    if (bin.read_u64_le(buf.data, sh3 + 16) != 0)              { bad = true; }
    if (bin.read_u64_le(buf.data, sh3 + 32)::usize != 3)       { bad = true; }
    val n3: usize = shstr_base + bin.read_u32_le(buf.data, sh3)::usize;
    j = 0;
    for (j < str_len(line_want)) {
        if (buf.data[n3 + j] != line_want[j]) { bad = true; }
        j = j + 1;
    }
    if (buf.data[n3 + str_len(line_want)] != 0) { bad = true; }
    val off3: usize = bin.read_u64_le(buf.data, sh3 + 24)::usize;
    if (buf.data[off3] != 0x11 || buf.data[off3 + 1] != 0x22 || buf.data[off3 + 2] != 0x33) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

# the build id descriptor of an ELF64 image, located through its PT_NOTE
fun t_note_desc(buf: *u8, total: usize) usize {
    val e_phoff: usize = bin.read_u64_le(buf, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf, 56)::usize;
    var i:       usize = 0;
    for (i < e_phnum) {
        val ph: usize = e_phoff + i * PHDR_SIZE;
        if (bin.read_u32_le(buf, ph) == PT_NOTE) {
            val off: usize = bin.read_u64_le(buf, ph + 8)::usize;
            if (off + buildid.ELF_NOTE_SIZE > total || !buildid.elf_note_header_valid((buf::usize + off)::*u8)) { ret 0; }
            ret off + buildid.ELF_NOTE_HEADER;
        }
        i = i + 1;
    }
    ret 0;
}

# an independent statement of the hash input: every PT_LOAD extent of an ELF64
# image in table order, with the section-table header fields and the note
# payload as zero
fun t_loaded_digest(alloc: *A.Allocator, image: *Vector[u8], out: *u8) bool {
    val total:  usize             = image.len;
    val copy_r: res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel copy_r.err) { ret false; }
    val copy: *u8 = copy_r.ok;
    fin { A.deallocate[u8](alloc, copy, total); }
    memory.raw_copy(copy::ptr, image.data::ptr, total);
    val desc: usize = t_note_desc(copy, total);
    if (desc == 0) { ret false; }
    var k: usize = 0;
    for (k < buildid.DIGEST_LEN) {
        copy[desc + k] = 0;
        k              = k + 1;
    }
    bin.write_u64_le(copy, 40, 0);
    bin.write_u16_le(copy, 60, 0);
    bin.write_u16_le(copy, 62, 0);
    var st:      sha256.State = sha256.init();
    val e_phoff: usize        = bin.read_u64_le(copy, 32)::usize;
    val e_phnum: usize        = bin.read_u16_le(copy, 56)::usize;
    var i:       usize        = 0;
    for (i < e_phnum) {
        val ph: usize = e_phoff + i * PHDR_SIZE;
        if (bin.read_u32_le(copy, ph) == PT_LOAD) {
            sha256.update(?st, (copy::usize + bin.read_u64_le(copy, ph + 8)::usize)::*u8, bin.read_u64_le(copy, ph + 32)::usize);
        }
        i = i + 1;
    }
    sha256.final(?st, out);
    ret true;
}

fun t_emit_exec_bytes(alloc: *A.Allocator, i: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
    debug: *of.Section, debug_count: u32, tpath: str) res[Vector[u8], fail.Fail] {
    val em: err[fail.Fail] = t_planned_emit_exec(alloc, i, isa_vt, segs, 1,
        4096, 0x400000, 0x401000,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        debug, debug_count, nil::*of.SymtabEntry, 0,
        tpath::*u8, "elfid"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret res[Vector[u8], fail.Fail].err{em.err}; }
    val r_5662: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, tpath);
    if (sel r_5662.err) { ret res[Vector[u8], fail.Fail].err{fail.fs_refused(r_5662.err)}; }
    ret res[Vector[u8], fail.Fail].ok{r_5662.ok};
}

test "mach.lang.target.of.elf.emit_exec:build_id_hashes_the_loaded_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x90;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x401000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE;
    info_bytes[1] = 0xAD;
    info_bytes[2] = 0xBE;
    info_bytes[3] = 0xEF;
    val nm_info: res[intern.StrId, A.Error] = intern.intern(?i, ".debug_info");
    if (sel nm_info.err) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name  = nm_info.ok;
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0];
    dbg[0].len   = 4;
    dbg[0].align = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_build_id");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val plain_r: res[Vector[u8], fail.Fail] = t_emit_exec_bytes(?alloc, ?i, ?isa_vt, ?segs[0], nil::*of.Section, 0, tpath);
    if (sel plain_r.err) { ret 2; }
    var plain:      Vector[u8] = plain_r.ok;
    val plain_desc: usize      = t_note_desc(plain.data, plain.len);
    if (plain_desc == 0) { ret 3; }
    # the note is inside the header mapping and the header page is loaded
    if (bin.read_u64_le(plain.data, 64 + 8) != 0 || bin.read_u64_le(plain.data, 64 + 32)::usize < plain_desc + buildid.DIGEST_LEN) { ret 4; }

    var expected: [32]u8;
    if (!t_loaded_digest(?alloc, ?plain, ?expected[0]))                                    { ret 5; }
    if (!memory.raw_equal((plain.data::usize + plain_desc)::ptr, (?expected[0])::ptr, 32)) { ret 6; }
    var zero: bool = true;
    k = 0;
    for (k < 32) {
        if (plain.data[plain_desc + k] != 0) { zero = false; }
        k = k + 1;
    }
    if (zero) { ret 7; }

    # debug information adds only unmapped bytes, so the identity is unchanged
    val with_debug_r: res[Vector[u8], fail.Fail] = t_emit_exec_bytes(?alloc, ?i, ?isa_vt, ?segs[0], ?dbg[0], 1, tpath);
    if (sel with_debug_r.err) { ret 8; }
    val with_debug: Vector[u8] = with_debug_r.ok;
    val debug_desc: usize      = t_note_desc(with_debug.data, with_debug.len);
    if (debug_desc != plain_desc || with_debug.len == plain.len)                                                  { ret 9; }
    if (!memory.raw_equal((with_debug.data::usize + debug_desc)::ptr, (plain.data::usize + plain_desc)::ptr, 32)) { ret 10; }

    # one loaded byte changes it
    text[3] = 0xC3;
    val changed_r: res[Vector[u8], fail.Fail] = t_emit_exec_bytes(?alloc, ?i, ?isa_vt, ?segs[0], nil::*of.Section, 0, tpath);
    if (sel changed_r.err) { ret 11; }
    val changed:      Vector[u8] = changed_r.ok;
    val changed_desc: usize      = t_note_desc(changed.data, changed.len);
    if (changed_desc != plain_desc)                                                                             { ret 12; }
    if (memory.raw_equal((changed.data::usize + changed_desc)::ptr, (plain.data::usize + plain_desc)::ptr, 32)) { ret 13; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_pie_exec:debug_sections_trailing_nonloaded" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x90;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x401000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    var dyn: of.DynamicInfo;
    dyn.libs             = nil;
    dyn.lib_count        = 0;
    dyn.imports          = nil;
    dyn.import_count     = 0;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = nil;
    dyn.base_reloc_count = 0;
    dyn.pie              = true;

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE;
    info_bytes[1] = 0xAD;
    info_bytes[2] = 0xBE;
    info_bytes[3] = 0xEF;
    val nm_info: res[intern.StrId, A.Error] = intern.intern(?i, ".debug_info");
    if (sel nm_info.err) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name  = nm_info.ok;
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0];
    dbg[0].len   = 4;
    dbg[0].align = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_pie_dbg");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, 0x401000, ?dyn, ?dbg[0], 1, nil::*of.SymtabEntry, 0, tpath::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var bad: bool = false;
    if (bin.read_u16_le(buf.data, 16) != ET_DYN) { bad = true; }

    val e_shoff:    usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shnum:    u32   = bin.read_u16_le(buf.data, 60)::u32;
    val e_shstrndx: u32   = bin.read_u16_le(buf.data, 62)::u32;
    if (e_shoff == 0)    { bad = true; }
    if (e_shnum != 3)    { bad = true; }
    if (e_shstrndx != 2) { bad = true; }
    if (bad)             { ret 1; }

    val sh1: usize = e_shoff + 1 * SHDR_SIZE;
    if (bin.read_u32_le(buf.data, sh1 + 4) != SHT_PROGBITS)    { bad = true; }
    if ((bin.read_u64_le(buf.data, sh1 + 8) & SHF_ALLOC) != 0) { bad = true; }
    if (bin.read_u64_le(buf.data, sh1 + 16) != 0)              { bad = true; }
    if (bin.read_u64_le(buf.data, sh1 + 32)::usize != 4)       { bad = true; }
    val sh_off: usize = bin.read_u64_le(buf.data, sh1 + 24)::usize;
    if (buf.data[sh_off] != 0xDE || buf.data[sh_off + 1] != 0xAD
        || buf.data[sh_off + 2] != 0xBE || buf.data[sh_off + 3] != 0xEF) { bad = true; }

    val shstr_hdr:  usize = e_shoff + e_shstrndx::usize * SHDR_SIZE;
    val shstr_base: usize = bin.read_u64_le(buf.data, shstr_hdr + 24)::usize;
    val n1:         usize = shstr_base + bin.read_u32_le(buf.data, sh1)::usize;
    val info_want:  str   = ".debug_info";
    var j:          usize = 0;
    for (j < str_len(info_want)) {
        if (buf.data[n1 + j] != info_want[j]) { bad = true; }
        j = j + 1;
    }
    if (buf.data[n1 + str_len(info_want)] != 0) { bad = true; }

    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var ph:      usize = 0;
    for (ph < e_phnum) {
        val po: usize = e_phoff + ph * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, po) == PT_LOAD) {
            val pf:  usize = bin.read_u64_le(buf.data, po + 8)::usize;
            val psz: usize = bin.read_u64_le(buf.data, po + 32)::usize;
            if (sh_off >= pf && sh_off < pf + psz) { bad = true; }
        }
        ph = ph + 1;
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_shared:debug_additive_nonloaded" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x90;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x401000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    val add_r: res[intern.StrId, A.Error] = intern.intern(?i, "add_fn");
    if (sel add_r.err) { ret 1; }
    var exports: [1]of.ExportSym;
    exports[0].name    = add_r.ok;
    exports[0].vaddr   = 0x401000;
    exports[0].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs             = nil;
    dyn.lib_count        = 0;
    dyn.imports          = nil;
    dyn.import_count     = 0;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = nil;
    dyn.base_reloc_count = 0;
    dyn.pie              = true;

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE;
    info_bytes[1] = 0xAD;
    info_bytes[2] = 0xBE;
    info_bytes[3] = 0xEF;
    val nm_info: res[intern.StrId, A.Error] = intern.intern(?i, ".debug_info");
    if (sel nm_info.err) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name  = nm_info.ok;
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0];
    dbg[0].len   = 4;
    dbg[0].align = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_shared_add");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tp: str = output.path(?tf);

    val e1: err[fail.Fail] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 1, ?dyn, ?dbg[0], 1, nil::*of.SymtabEntry, 0, tp::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel e1.err) { ret 1; }
    val rb1: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tp);
    if (sel rb1.err) { ret 1; }
    val b1: Vector[u8] = rb1.ok;

    val e2: err[fail.Fail] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 1, ?dyn, nil::*of.Section, 0, nil::*of.SymtabEntry, 0, tp::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel e2.err) { ret 1; }
    val rb2: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tp);

    if (sel rb2.err) { ret 1; }
    val b2: Vector[u8] = rb2.ok;

    var bad: bool = false;

    if (bin.read_u64_le(b2.data, 40) != 0) { bad = true; }
    if (bin.read_u64_le(b1.data, 40) == 0) { bad = true; }

    if (b1.len < b2.len) { bad = true; }
    or {
        var j: usize = 0;
        for (j < b2.len) {
            if (j >= 40 && j < 48) {
                j = j + 1;
                cnt;
            }
            if (j >= 60 && j < 64) {
                j = j + 1;
                cnt;
            }
            if (b1.data[j] != b2.data[j]) {
                bad = true;
                j   = b2.len;
                cnt;
            }
            j = j + 1;
        }
    }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_shared:dynamic_sections_in_sht" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x90;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x401000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    val add_r: res[intern.StrId, A.Error] = intern.intern(?i, "add_fn");
    val mul_r: res[intern.StrId, A.Error] = intern.intern(?i, "mul_fn");
    if (sel add_r.err) { ret 1; }
    if (sel mul_r.err) { ret 1; }
    var exports: [2]of.ExportSym;
    exports[0].name    = add_r.ok;
    exports[0].vaddr   = 0x401000;
    exports[0].is_func = true;
    exports[1].name    = mul_r.ok;
    exports[1].vaddr   = 0x401008;
    exports[1].is_func = true;

    var dyn: of.DynamicInfo;
    dyn.libs             = nil;
    dyn.lib_count        = 0;
    dyn.imports          = nil;
    dyn.import_count     = 0;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = nil;
    dyn.base_reloc_count = 0;
    dyn.pie              = true;

    var info_bytes: [4]u8;
    info_bytes[0] = 0xDE;
    info_bytes[1] = 0xAD;
    info_bytes[2] = 0xBE;
    info_bytes[3] = 0xEF;
    val nm_info: res[intern.StrId, A.Error] = intern.intern(?i, ".debug_info");
    if (sel nm_info.err) { ret 1; }
    var dbg: [1]of.Section;
    dbg[0].name  = nm_info.ok;
    dbg[0].kind  = of.SK_DEBUG;
    dbg[0].bytes = ?info_bytes[0];
    dbg[0].len   = 4;
    dbg[0].align = 1;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_shared_sht");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tp: str            = output.path(?tf);
    val em: err[fail.Fail] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, ?exports[0], 2, ?dyn, ?dbg[0], 1, nil::*of.SymtabEntry, 0, tp::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tp);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var bad: bool = false;

    val e_shoff: usize = bin.read_u64_le(buf.data, 40)::usize;
    val e_shnum: u32   = bin.read_u16_le(buf.data, 60)::u32;
    if (e_shoff == 0 || e_shnum == 0) { ret 1; }

    var dynsym_hdr:   usize = 0;
    var have_dynamic: bool  = false;
    var sh:           u32   = 0;
    for (sh < e_shnum) {
        val so: usize = e_shoff + sh::usize * SHDR_SIZE;
        val ty: u32   = bin.read_u32_le(buf.data, so + 4);
        if (ty == SHT_DYNSYM)  { dynsym_hdr = so; }
        if (ty == SHT_DYNAMIC) { have_dynamic = true; }
        sh = sh + 1;
    }
    if (dynsym_hdr == 0) { bad = true; }
    if (!have_dynamic)   { bad = true; }

    if (dynsym_hdr != 0) {
        if ((bin.read_u64_le(buf.data, dynsym_hdr + 8) & SHF_ALLOC) == 0)      { bad = true; }
        if (bin.read_u64_le(buf.data, dynsym_hdr + 32)::usize != 3 * SYM_SIZE) { bad = true; }
        val link: u32 = bin.read_u32_le(buf.data, dynsym_hdr + 40);
        if (link == 0 || link >= e_shnum) { bad = true; }
        or {
            val lho: usize = e_shoff + link::usize * SHDR_SIZE;
            if (bin.read_u32_le(buf.data, lho + 4) != SHT_STRTAB) { bad = true; }
        }

        val dynsym_off: usize = bin.read_u64_le(buf.data, dynsym_hdr + 24)::usize;
        val shndx:      u32   = bin.read_u16_le(buf.data, dynsym_off + SYM_SIZE + 6)::u32;
        if (shndx == 0 || shndx >= e_shnum) { bad = true; }
        or {
            val tho: usize = e_shoff + shndx::usize * SHDR_SIZE;
            val tty: u32   = bin.read_u32_le(buf.data, tho + 4);
            val tfl: u64   = bin.read_u64_le(buf.data, tho + 8);
            if (tty != SHT_PROGBITS)        { bad = true; }
            if ((tfl & SHF_ALLOC) == 0)     { bad = true; }
            if ((tfl & SHF_EXECINSTR) == 0) { bad = true; }
        }
    }

    if (bad) { ret 1; }
    ret 0;
}

fun t_any_load_overlap(buf: *Vector[u8]) bool {
    val e_phoff: usize = bin.read_u64_le(buf.data, 32)::usize;
    val e_phnum: usize = bin.read_u16_le(buf.data, 56)::usize;
    var i:       usize = 0;
    for (i < e_phnum) {
        val ioff: usize = e_phoff + i * PHDR_SIZE;
        if (bin.read_u32_le(buf.data, ioff) != PT_LOAD) {
            i = i + 1;
            cnt;
        }
        val ia: u64   = bin.read_u64_le(buf.data, ioff + 16);
        val iz: u64   = bin.read_u64_le(buf.data, ioff + 40);
        var j:  usize = i + 1;
        for (j < e_phnum) {
            val joff: usize = e_phoff + j * PHDR_SIZE;
            if (bin.read_u32_le(buf.data, joff) != PT_LOAD) {
                j = j + 1;
                cnt;
            }
            val ja: u64 = bin.read_u64_le(buf.data, joff + 16);
            val jz: u64 = bin.read_u64_le(buf.data, joff + 40);
            if (iz > 0 && jz > 0 && ia < ja + jz && ja < ia + iz) { ret true; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.target.of.elf.emit_exec:load_segments_do_not_overlap" {
    var alloc:  A.Allocator;
    val r_6008: err[A.Error] = page.make(?alloc);
    if (sel r_6008.err) { ret 1; }
    var i:      intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64, EM_X86_64::u32, nil);

    var text: [16]u8;
    var data: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x90;
        data[k] = 0;
        k       = k + 1;
    }
    var segs: [2]of.LoadSegment;
    segs[0].vaddr  = 0x400000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];
    segs[1].vaddr  = 0x401000;
    segs[1].filesz = 16;
    segs[1].memsz  = 16;
    segs[1].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;
    segs[1].bytes  = ?data[0];

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_overlap");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val em:   err[fail.Fail]  = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2, 4096, 0x400000, 0x400000,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        tpath::*u8, nil::*u8, opts);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    var buf: Vector[u8] = rb.ok;

    var bad: i32 = 0;
    if (t_any_load_overlap(?buf)) { bad = 1; }
    ret bad;
}

fun t_isa32(id: u32, elf_machine: u32, reloc: *isa.RelocSeam) of.ObjectTarget {
    var vt:  isa.IsaVTable = isa.machine_isa(id, "test32", elf_machine, 4, nil, nil, reloc);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

test "mach.lang.target.of.elf.write_phdr_at:elf32_field_order" {
    var bad: bool = false;

    var l32: ElfLayout = elf32_layout();
    var l64: ElfLayout = elf64_layout();
    if (l32.phdr_size != 32 || l64.phdr_size != 56) { bad = true; }
    if (l32.ehdr_size != 52 || l32.shdr_size != 40) { bad = true; }
    if (l32.sym_size != 16 || l32.rela_size != 12)  { bad = true; }

    var b32: [64]u8;
    var b64: [64]u8;
    var k:   usize = 0;
    for (k < 64) {
        b32[k] = 0;
        b64[k] = 0;
        k      = k + 1;
    }

    val end32: usize = write_phdr_at(?b32[0], 0, ?l32, PT_LOAD, PF_R | PF_X,
        0x11, 0x22, 0x33, 0x44, 0x55, 0x1000);
    val end64: usize = write_phdr_at(?b64[0], 0, ?l64, PT_LOAD, PF_R | PF_X,
        0x11, 0x22, 0x33, 0x44, 0x55, 0x1000);
    if (end32 != 32 || end64 != 56) { bad = true; }

    if (bin.read_u32_le(?b32[0], 0) != PT_LOAD)        { bad = true; }
    if (bin.read_u32_le(?b32[0], 4) != 0x11)           { bad = true; }
    if (bin.read_u32_le(?b32[0], 8) != 0x22)           { bad = true; }
    if (bin.read_u32_le(?b32[0], 12) != 0x33)          { bad = true; }
    if (bin.read_u32_le(?b32[0], 16) != 0x44)          { bad = true; }
    if (bin.read_u32_le(?b32[0], 20) != 0x55)          { bad = true; }
    if (bin.read_u32_le(?b32[0], 24) != (PF_R | PF_X)) { bad = true; }
    if (bin.read_u32_le(?b32[0], 28) != 0x1000)        { bad = true; }

    if (bin.read_u32_le(?b64[0], 4) != (PF_R | PF_X)) { bad = true; }
    if (bin.read_u64_le(?b64[0], 8) != 0x11)          { bad = true; }

    var s32: [32]u8;
    var s64: [32]u8;
    k = 0;
    for (k < 32) {
        s32[k] = 0;
        s64[k] = 0;
        k      = k + 1;
    }
    val se32: usize = write_sym_at(?s32[0], 0, ?l32, 7, 0x12, 0, 3, 0xAABB, 0xCC);
    val se64: usize = write_sym_at(?s64[0], 0, ?l64, 7, 0x12, 0, 3, 0xAABB, 0xCC);
    if (se32 != 16 || se64 != 24)              { bad = true; }
    if (bin.read_u32_le(?s32[0], 4) != 0xAABB) { bad = true; }
    if (bin.read_u32_le(?s32[0], 8) != 0xCC)   { bad = true; }
    if (s32[12] != 0x12)                       { bad = true; }
    if (bin.read_u16_le(?s32[0], 14) != 3)     { bad = true; }
    if (s64[4] != 0x12)                        { bad = true; }
    if (bin.read_u64_le(?s64[0], 8) != 0xAABB) { bad = true; }

    if (rela_info_pack(?l32, 0x2B, 0x17) != 0x2B17)       { bad = true; }
    if (rela_info_pack(?l64, 0x2B, 0x17) != 0x2B00000017) { bad = true; }
    if (!reloc_type_fits_class(?l32, 0xFF))               { bad = true; }
    if (reloc_type_fits_class(?l32, 0x100))               { bad = true; }
    if (!reloc_type_fits_class(?l64, 0x100))              { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_object:riscv32_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: err[fail.Fail] = register(?of_reg);
    if (sel rr.err) { ret 1; }

    var seam:   isa.RelocSeam   = t_seam(t_riscv_elf_reloc_type);
    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, ?seam);

    var text_bytes: [16]u8;
    var k:          usize = 0;
    for (k < 16) {
        text_bytes[k] = 0x13;
        k             = k + 1;
    }
    var data_bytes: [4]u8;
    k = 0;
    for (k < 4) {
        data_bytes[k] = 0x5A;
        k             = k + 1;
    }

    var secs: [2]of.Section;
    secs[0].name  = t_intern(?i, ".text");
    secs[0].kind  = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0];
    secs[0].len   = 16;
    secs[0].align = 16;
    secs[1].name  = t_intern(?i, ".data");
    secs[1].kind  = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0];
    secs[1].len   = 4;
    secs[1].align = 4;

    var syms: [2]of.Symbol;
    syms[0].name    = t_intern(?i, "g");
    syms[0].section = of.section_id(0);
    syms[0].offset  = 0;
    syms[0].size    = 16;
    syms[0].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name    = t_intern(?i, "d");
    syms[1].section = of.section_id(1);
    syms[1].offset  = 0;
    syms[1].size    = 4;
    syms[1].flags   = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [3]of.Relocation;
    relocs[0].section = of.section_id(0);
    relocs[0].offset  = 0;
    relocs[0].kind    = of.RK_PCREL_HI20;
    relocs[0].sym     = 1;
    relocs[0].addend  = 0;
    relocs[1].section = of.section_id(0);
    relocs[1].offset  = 4;
    relocs[1].kind    = of.RK_PCREL_LO12_I;
    relocs[1].sym     = 1;
    relocs[1].addend  = 0;
    relocs[2].section = of.section_id(1);
    relocs[2].offset  = 0;
    relocs[2].kind    = of.RK_ABS32;
    relocs[2].sym     = 0;
    relocs[2].addend  = -8;

    var img: of.ObjectImage;
    img.alloc         = ?alloc;
    img.interner      = ?i;
    img.name          = t_intern(?i, "rv32");
    img.sections      = ?secs[0];
    img.section_count = 2;
    img.symbols       = ?syms[0];
    img.symbol_count  = 2;
    img.relocations   = ?relocs[0];
    img.reloc_count   = 3;

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_rv32");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_object(?isa_vt, ?img, tpath::*u8);
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var bad: bool = false;

    if (buf.data[4] != ELFCLASS32)           { bad = true; }
    if (bin.read_u16_le(buf.data, 40) != 52) { bad = true; }
    if (bin.read_u16_le(buf.data, 46) != 40) { bad = true; }
    val e_shoff: usize = bin.read_u32_le(buf.data, 32)::usize;
    if (e_shoff == 0 || e_shoff >= buf.len) { bad = true; }
    if (bad)                                { ret 1; }

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (sel pr.err) { ret 1; }

    if (out.section_count != 2) { ret 1; }
    if (out.symbol_count != 2)  { ret 1; }
    if (out.reloc_count != 3)   { ret 1; }

    var text_i: i32 = -1;
    var data_i: i32 = -1;
    var s:      u32 = 0;
    for (s < out.section_count) {
        if (str_equals(bin.resolve_name(?i, out.sections[s].name), ".text")) { text_i = s::i32; }
        if (str_equals(bin.resolve_name(?i, out.sections[s].name), ".data")) { data_i = s::i32; }
        s = s + 1;
    }
    if (text_i < 0 || data_i < 0)                     { ret 1; }
    if (out.sections[text_i::u32].len != 16)          { bad = true; }
    if (out.sections[text_i::u32].kind != of.SK_TEXT) { bad = true; }
    if (out.sections[data_i::u32].len != 4)           { bad = true; }
    if (out.sections[text_i::u32].bytes == nil)       { ret 1; }
    if (out.sections[data_i::u32].bytes == nil)       { ret 1; }
    if (out.sections[text_i::u32].bytes[0] != 0x13)   { bad = true; }
    if (out.sections[data_i::u32].bytes[0] != 0x5A)   { bad = true; }

    var saw_g: bool = false;
    var saw_d: bool = false;
    var y:     u32  = 0;
    for (y < out.symbol_count) {
        val nm: str = bin.resolve_name(?i, out.symbols[y].name);
        if (str_equals(nm, "g")) {
            saw_g = true;
            if (out.symbols[y].size != 16)                               { bad = true; }
            if (of.section_index(out.symbols[y].section) != text_i::u32) { bad = true; }
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0)  { bad = true; }
        }
        if (str_equals(nm, "d")) {
            saw_d = true;
            if (of.section_index(out.symbols[y].section) != data_i::u32) { bad = true; }
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_OBJECT) == 0)    { bad = true; }
        }
        y = y + 1;
    }
    if (!saw_g || !saw_d) { bad = true; }

    var saw_hi:  bool = false;
    var saw_lo:  bool = false;
    var saw_abs: bool = false;
    var r:       u32  = 0;
    for (r < out.reloc_count) {
        if (out.relocations[r].kind == of.RK_PCREL_HI20) {
            saw_hi = true;
            if (out.relocations[r].offset != 0)                              { bad = true; }
            if (of.section_index(out.relocations[r].section) != text_i::u32) { bad = true; }
        }
        if (out.relocations[r].kind == of.RK_PCREL_LO12_I) {
            saw_lo = true;
            if (out.relocations[r].offset != 4) { bad = true; }
        }
        if (out.relocations[r].kind == of.RK_ABS32) {
            saw_abs = true;
            if (of.section_index(out.relocations[r].section) != data_i::u32) { bad = true; }
            if (out.relocations[r].addend != -8)                             { bad = true; }
        }
        r = r + 1;
    }
    if (!saw_hi || !saw_lo || !saw_abs) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.emit_exec:riscv32_static_image" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x13;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x11000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    val tf_r: res[output.Output, outcome.Fail] = output.create(?alloc, "elf_rv32x");
    if (sel tf_r.err) { ret 1; }
    var tf: output.Output = tf_r.ok;
    fin { output.dnit(?tf); }
    val tpath: str = output.path(?tf);

    val em: err[fail.Fail] = t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
        4096, 0x10000, 0x11000,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        tpath::*u8, "rv32x"::*u8,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (sel em.err) { ret 1; }

    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);

    if (sel rb.err) { ret 1; }
    val buf: Vector[u8] = rb.ok;

    var bad: bool = false;
    if (buf.data[4] != ELFCLASS32)                { bad = true; }
    if (bin.read_u16_le(buf.data, 16) != ET_EXEC) { bad = true; }
    if (bin.read_u32_le(buf.data, 24) != 0x11000) { bad = true; }
    if (bin.read_u32_le(buf.data, 28) != 52)      { bad = true; }
    if (bin.read_u16_le(buf.data, 40) != 52)      { bad = true; }
    if (bin.read_u16_le(buf.data, 42) != 32)      { bad = true; }
    if (bad)                                      { ret 1; }

    val e_phnum: usize = bin.read_u16_le(buf.data, 44)::usize;
    if (e_phnum != 3) { ret 1; }

    var saw_text: bool  = false;
    var saw_note: bool  = false;
    var ph:       usize = 0;
    for (ph < e_phnum) {
        val po: usize = 52 + ph * 32;
        val fl: u32   = bin.read_u32_le(buf.data, po + 24);
        if (fl == 0) { bad = true; }
        if (bin.read_u32_le(buf.data, po) == PT_NOTE) {
            saw_note = true;
            val note_off: usize = bin.read_u32_le(buf.data, po + 4)::usize;
            if (note_off % 4 != 0 || note_off >= 4096)                              { bad = true; }
            if (bin.read_u32_le(buf.data, po + 16)::usize != buildid.ELF_NOTE_SIZE) { bad = true; }
            if (!buildid.elf_note_header_valid((buf.data::usize + note_off)::*u8))  { bad = true; }
        }
        or (bin.read_u32_le(buf.data, po) != PT_LOAD) { bad = true; }
        if (bin.read_u32_le(buf.data, po + 8) == 0x11000) {
            saw_text = true;
            if (fl != (PF_R | PF_X))                      { bad = true; }
            if (bin.read_u32_le(buf.data, po + 16) != 16) { bad = true; }
        }
        ph = ph + 1;
    }
    if (!saw_text || !saw_note) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf.parse_object:unknown_class_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var buf: [64]u8;
    var k:   usize = 0;
    for (k < 64) {
        buf[k] = 0;
        k      = k + 1;
    }
    buf[0] = 0x7F;
    buf[1] = 0x45;
    buf[2] = 0x4C;
    buf[3] = 0x46;
    buf[4] = 7;

    var out: of.ObjectImage;
    val pr:  err[fail.Fail] = parse_object(?alloc, ?i, ?buf[0], 64, ?out);
    if (!sel pr.err)                                               { ret 1; }
    if (!str_contains(fail.describe(pr.err), "unknown ELF class")) { ret 1; }

    var l: ElfLayout;
    if (layout_from_class(7, ?l))           { ret 1; }
    if (!layout_from_class(ELFCLASS32, ?l)) { ret 1; }
    if (l.addr_width != 4)                  { ret 1; }
    if (!layout_from_class(ELFCLASS64, ?l)) { ret 1; }
    if (l.addr_width != 8)                  { ret 1; }
    ret 0;
}

test "mach.lang.target.of.elf:elf32_dynamic_refused" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa32(isa.ARCH_RISCV32, EM_RISCV::u32, nil);

    var text: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        text[k] = 0x13;
        k       = k + 1;
    }
    var segs: [1]of.LoadSegment;
    segs[0].vaddr  = 0x11000;
    segs[0].filesz = 16;
    segs[0].memsz  = 16;
    segs[0].flags  = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?text[0];

    var dyn: of.DynamicInfo;
    dyn.libs             = nil;
    dyn.lib_count        = 0;
    dyn.imports          = nil;
    dyn.import_count     = 0;
    dyn.interp           = intern.STR_NIL;
    dyn.base_relocs      = nil;
    dyn.base_reloc_count = 0;
    dyn.pie              = true;

    val made: res[output.Output, outcome.Fail] = output.create(?alloc, "elf32_dynamic");
    if (sel made.err) { ret 2; }
    var file: output.Output = made.ok;
    fin { output.dnit(?file); }
    val filename: str = output.path(?file);

    val opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    var bad:  bool            = false;

    val pe: err[fail.Fail] = t_planned_emit_pie_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, 0x11000,
        ?dyn, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0, filename::*u8, opts);
    if (!sel pe.err)                                                      { bad = true; }
    or (sel pe.err && !str_contains(fail.describe(pe.err), "ELF64-only")) { bad = true; }

    val sh: err[fail.Fail] = t_planned_emit_shared(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096,
        nil::*of.ExportSym, 0, ?dyn,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        filename::*u8, opts);
    if (!sel sh.err)                                                      { bad = true; }
    or (sel sh.err && !str_contains(fail.describe(sh.err), "ELF64-only")) { bad = true; }

    val dx: err[fail.Fail] = t_planned_emit_dyn_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096,
        0x10000, 0x11000, nil::*of.ExecFunction, 0,
        ?dyn, nil::*of.PltFixup, 0,
        nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0,
        filename::*u8, "x"::*u8, opts);
    if (!sel dx.err)                                                      { bad = true; }
    or (sel dx.err && !str_contains(fail.describe(dx.err), "ELF64-only")) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) res[*publication.Destination, fail.Fail] {
    val initialized: err[txn.Error] = publication.plan_init(operation, alloc);
    if (sel initialized.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(initialized.err))}; }
    val destination: res[*publication.Destination, outcome.Fail] = publication.plan_add(operation, name, false);
    if (sel destination.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(outcome.describe(destination.err))}; }
    val sealed: err[txn.Error] = publication.plan_seal(operation);
    if (sel sealed.err)      { ret res[*publication.Destination, fail.Fail].err{fail.message(txn.error_message(sealed.err))}; }
    if (sel destination.err) { ret res[*publication.Destination, fail.Fail].err{fail.message(outcome.describe(destination.err))}; }
    ret res[*publication.Destination, fail.Fail].ok{destination.ok};
}

fun t_publication_close(operation: *publication.Plan, result: err[fail.Fail]) err[fail.Fail] {
    val closed: err[txn.Error] = publication.plan_dnit(operation);
    if (sel closed.err) {
        if (sel result.ok) { ret err[fail.Fail].err{fail.message(txn.error_message(closed.err))}; }
    }
    ret result;
}

fun t_planned_emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
    seg_count: u32, page_size: u64, image_base: u64, entry: u64,
    funcs: *of.ExecFunction,
    func_count: u32, dyn: *of.DynamicInfo, fixups: *of.PltFixup,
    fixup_count: u32, exceptions: *of.Section, exception_count: u32,
    debug: *of.Section, debug_count: u32,
    symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (path == nil) { ret emit_dyn_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened:    res[*publication.Destination, fail.Fail] = t_publication_open(?operation, alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_dyn_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, opened.ok, name, image_options));
}

fun t_planned_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
    seg_count: u32, page_size: u64, image_base: u64, entry: u64,
    funcs: *of.ExecFunction,
    func_count: u32, exceptions: *of.Section, exception_count: u32,
    debug: *of.Section, debug_count: u32,
    symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
    image_options: of.ImageOptions) err[fail.Fail] {
    if (path == nil) { ret emit_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened:    res[*publication.Destination, fail.Fail] = t_publication_open(?operation, alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, opened.ok, name, image_options));
}

fun t_planned_emit_object(tgt_isa: *of.ObjectTarget, img: *of.ObjectImage, path: *u8) err[fail.Fail] {
    if (path == nil) { ret emit_object(tgt_isa, img, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened:    res[*publication.Destination, fail.Fail] = t_publication_open(?operation, img.alloc, path::str);
    if (sel opened.err) { ret t_publication_close(?operation, err[fail.Fail].err{opened.err}); }
    ret t_publication_close(?operation, emit_object(tgt_isa, img, opened.ok));
}

