use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_plan:    mach.lang.target.of.plan;
use A:          std.allocator;
use std_format: std.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

pub rec Expanded {
    image:             target_of.ObjectImage;
    owned:             bool;
    borrowed_sections: u32;
}

pub fun dnit(out: *Expanded) {
    if (!out.owned) { ret; }
    var i: u32 = 0;
    for (i < out.borrowed_sections) {
        out.image.sections[i].bytes = nil;
        i                           = i + 1;
    }
    out.image.frames         = nil;
    out.image.frame_cap      = 0;
    out.image.imports        = nil;
    out.image.import_cap     = 0;
    out.image.attributes     = nil;
    out.image.attributes_len = 0;
    target_of.object_image_dnit(?out.image);
    @out = Expanded{};
}

fun alias(img: *target_of.ObjectImage, prefix: str, name: intern.StrId) res[intern.StrId, fail.Fail] {
    val text: str = bin.resolve_name(img.interner, name);
    if (text == nil) { ret res[intern.StrId, fail.Fail].err{fail.message("coff: import symbol name did not resolve")}; }
    val joined: res[str, std_format.FormatError] = std_format.sprint(img.alloc, "{}{}", prefix, text);
    if (sel joined.err) { ret res[intern.StrId, fail.Fail].err{fail.format_refused(joined.err)}; }
    val buffer: str = joined.ok;
    fin { A.deallocate[u8](img.alloc, buffer, str_len(buffer) + 1); }
    val r_44: res[intern.StrId, A.Error] = intern.intern(img.interner, buffer);
    if (sel r_44.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_44.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_44.ok};
}

fun section(img: *target_of.ObjectImage, name: str, kind: target_of.SectionKind, len: u32, align: u32) err[fail.Fail] {
    val named: res[intern.StrId, A.Error] = intern.intern(img.interner, name);
    if (sel named.err) { ret err[fail.Fail].err{fail.refused(named.err)}; }
    val sec: *target_of.Section = ?img.sections[img.section_count];
    @sec              = target_of.Section{};
    sec.name          = named.ok;
    sec.kind          = kind;
    sec.len           = len;
    sec.align         = align;
    img.section_count = img.section_count + 1;
    if (len != 0) {
        val storage: res[*u8, A.Error] = A.zallocate[u8](img.alloc, len::usize);
        if (sel storage.err) { ret err[fail.Fail].err{fail.refused(storage.err)}; }
        sec.bytes = storage.ok;
    }
    ret err[fail.Fail].ok{};
}

fun symbol(img: *target_of.ObjectImage, name: intern.StrId, sec: u32, offset: u32, flags: u32) u32 {
    val index: u32 = img.symbol_count;
    img.symbols[index]          = target_of.Symbol{};
    img.symbols[index].name     = name;
    img.symbols[index].section  = target_of.section_id(sec);
    img.symbols[index].offset   = offset;
    img.symbols[index].flags    = flags;
    img.symbols[index].fallback = target_of.SYMBOL_NONE;
    img.symbols[index].align    = 1;
    img.symbol_count            = index + 1;
    ret index;
}

fun relocation(img: *target_of.ObjectImage, sec: u32, offset: u32, sym: u32, kind: target_of.RelocKind, addend: i64) {
    val index: u32 = img.reloc_count;
    img.relocations[index]         = target_of.Relocation{};
    img.relocations[index].section = target_of.section_id(sec);
    img.relocations[index].offset  = offset;
    img.relocations[index].sym     = sym;
    img.relocations[index].kind    = kind;
    img.relocations[index].addend  = addend;
    img.reloc_count                = index + 1;
}

fun prior_import(input: *target_of.ObjectImage, index: u32) u32 {
    var i: u32 = 0;
    for (i < index) {
        if (input.imports[i].symbol == input.imports[index].symbol) { ret i; }
        i = i + 1;
    }
    ret index;
}

fun same_import(a: *target_of.ImportDecl, b: *target_of.ImportDecl) bool {
    ret a.symbol == b.symbol && a.import_name == b.import_name && a.library == b.library
        && a.ordinal == b.ordinal && a.by_name == b.by_name && a.is_code == b.is_code;
}

pub fun expand(input: *target_of.ObjectImage, out: *Expanded) err[fail.Fail] {
    @out      = Expanded{};
    out.image = @input;
    if (input.import_count == 0) { ret err[fail.Fail].ok{}; }
    val total:       u32 = input.import_count;
    var n:           u32 = 0;
    var count_index: u32 = 0;
    for (count_index < total) {
        val prior: u32 = prior_import(input, count_index);
        if (prior == count_index) { n = n + 1; }
        or (!same_import(?input.imports[prior], ?input.imports[count_index])) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_IMPORT_CONFLICT, "coff: conflicting attributions for one public import")};
        }
        count_index = count_index + 1;
    }
    if (input.section_count > 0xFFFFFFFF - 6 || n > (0xFFFFFFFF - input.symbol_count) / 5
        || n > (0xFFFFFFFF - input.reloc_count) / 6 || n > 0xFFFFFFFF / 20) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "coff: native import table exceeds its index range")};
    }
    var names_len: u32 = 0;
    var code_len:  u32 = 0;
    var i:         u32 = 0;
    for (i < total) {
        if (prior_import(input, i) != i) {
            i = i + 1;
            cnt;
        }
        val decl:     *target_of.ImportDecl = ?input.imports[i];
        val library:  str                   = bin.resolve_name(input.interner, decl.library);
        val imported: str                   = bin.resolve_name(input.interner, decl.import_name);
        if (library == nil || imported == nil) { ret err[fail.Fail].err{fail.message("coff: import attribution name did not resolve")}; }
        val library_len: usize = str_len(library);
        val import_len:  usize = str_len(imported);
        if (library_len >= (0xFFFFFFFF - names_len)::usize || import_len > 0xFFFFFFFC::usize) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "coff: native import names exceed their range")};
        }
        var end: usize = names_len::usize + library_len + 1;
        if (decl.by_name) {
            val end_r: res[usize, fail.Fail] = of_plan.align_bytes(end, 2);
            if (sel end_r.err) { ret err[fail.Fail].err{end_r.err}; }
            end = end_r.ok + import_len + 3;
        }
        if (end > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "coff: native import names exceed their range")}; }
        names_len = end::u32;
        if (decl.is_code) { code_len = code_len + 6; }
        i = i + 1;
    }
    out.image = target_of.object_image_init(input.alloc, input.interner, input.name);
    out.owned = true;
    var complete: bool = false;
    fin {
        if (!complete) { dnit(out); }
    }
    val img:      *target_of.ObjectImage           = ?out.image;
    val sections: res[*target_of.Section, A.Error] = A.zallocate[target_of.Section](input.alloc, (input.section_count + 6)::usize);
    if (sel sections.err) { ret err[fail.Fail].err{fail.refused(sections.err)}; }
    img.sections          = sections.ok;
    img.section_cap       = input.section_count + 6;
    img.section_count     = input.section_count;
    out.borrowed_sections = input.section_count;
    memory.copy[target_of.Section](img.sections, input.sections, input.section_count::usize);
    val symbols: res[*target_of.Symbol, A.Error] = A.zallocate[target_of.Symbol](input.alloc, (input.symbol_count + n * 5)::usize);
    if (sel symbols.err) { ret err[fail.Fail].err{fail.refused(symbols.err)}; }
    img.symbols      = symbols.ok;
    img.symbol_cap   = input.symbol_count + n * 5;
    img.symbol_count = input.symbol_count;
    memory.copy[target_of.Symbol](img.symbols, input.symbols, input.symbol_count::usize);
    val relocs: res[*target_of.Relocation, A.Error] = A.zallocate[target_of.Relocation](input.alloc, (input.reloc_count + n * 6)::usize);
    if (sel relocs.err) { ret err[fail.Fail].err{fail.refused(relocs.err)}; }
    img.relocations = relocs.ok;
    img.reloc_cap   = input.reloc_count + n * 6;
    img.reloc_count = input.reloc_count;
    memory.copy[target_of.Relocation](img.relocations, input.relocations, input.reloc_count::usize);
    img.frames         = input.frames;
    img.frame_count    = input.frame_count;
    img.attributes     = input.attributes;
    img.attributes_len = input.attributes_len;
    img.machine_flags  = input.machine_flags;
    val local_name_result: res[intern.StrId, A.Error] = intern.intern(input.interner, ".Limport");
    if (sel local_name_result.err) { ret err[fail.Fail].err{fail.refused(local_name_result.err)}; }
    val local_name: intern.StrId   = local_name_result.ok;
    val base:       u32            = input.section_count;
    val made2:      err[fail.Fail] = section(img, ".idata$2", target_of.SK_DATA, n * 20, 4);
    if (sel made2.err) { ret made2; }
    val made3: err[fail.Fail] = section(img, ".idata$3", target_of.SK_DATA, 20, 4);
    if (sel made3.err) { ret made3; }
    val made4: err[fail.Fail] = section(img, ".idata$4", target_of.SK_DATA, n * 16, 8);
    if (sel made4.err) { ret made4; }
    val made5: err[fail.Fail] = section(img, ".idata$5", target_of.SK_DATA, n * 16, 8);
    if (sel made5.err) { ret made5; }
    val made6: err[fail.Fail] = section(img, ".idata$6", target_of.SK_RODATA, names_len, 2);
    if (sel made6.err) { ret made6; }
    val made_text: err[fail.Fail] = section(img, ".text$im", target_of.SK_TEXT, code_len, 2);
    if (sel made_text.err) { ret made_text; }
    var name_at: u32 = 0;
    var code_at: u32 = 0;
    var emitted: u32 = 0;
    i = 0;
    for (i < total) {
        if (prior_import(input, i) != i) {
            i = i + 1;
            cnt;
        }
        val decl:      *target_of.ImportDecl        = ?input.imports[i];
        val addressed: res[intern.StrId, fail.Fail] = alias(input, "__imp_", decl.symbol);
        if (sel addressed.err) { ret err[fail.Fail].err{addressed.err}; }
        val lookup:  u32 = symbol(img, local_name, base + 2, emitted * 16, 0);
        val address: u32 = symbol(img, addressed.ok, base + 3, emitted * 16, target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_OBJECT);
        val library: str = bin.resolve_name(input.interner, decl.library);
        val dll:     u32 = symbol(img, local_name, base + 4, name_at, 0);
        memory.copy[u8]((img.sections[base + 4].bytes::usize + name_at::usize)::*u8, library, str_len(library) + 1);
        name_at = name_at + str_len(library)::u32 + 1;
        var hint: u32 = target_of.SYMBOL_NONE;
        if (decl.by_name) {
            val name_at_r: res[usize, fail.Fail] = of_plan.align_bytes(name_at::usize, 2);
            if (sel name_at_r.err) { ret err[fail.Fail].err{name_at_r.err}; }
            name_at = name_at_r.ok::u32;
            hint    = symbol(img, local_name, base + 4, name_at, 0);
            val imported: str = bin.resolve_name(input.interner, decl.import_name);
            bin.write_u16_le(img.sections[base + 4].bytes, name_at::usize, decl.ordinal);
            memory.copy[u8]((img.sections[base + 4].bytes::usize + name_at::usize + 2)::*u8, imported, str_len(imported) + 1);
            name_at = name_at + str_len(imported)::u32 + 3;
        }
        relocation(img, base, emitted * 20, lookup, target_of.RK_ADDR32NB, 0);
        relocation(img, base, emitted * 20 + 12, dll, target_of.RK_ADDR32NB, 0);
        relocation(img, base, emitted * 20 + 16, address, target_of.RK_ADDR32NB, 0);
        if (decl.by_name) {
            relocation(img, base + 2, emitted * 16, hint, target_of.RK_ADDR32NB, 0);
            relocation(img, base + 3, emitted * 16, hint, target_of.RK_ADDR32NB, 0);
        }
        or {
            bin.write_u64_le(img.sections[base + 2].bytes, (emitted * 16)::usize, 0x8000000000000000 | decl.ordinal::u64);
            bin.write_u64_le(img.sections[base + 3].bytes, (emitted * 16)::usize, 0x8000000000000000 | decl.ordinal::u64);
        }
        if (decl.is_code) {
            symbol(img, decl.symbol, base + 5, code_at, target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION);
            img.sections[base + 5].bytes[code_at]     = 0xFF;
            img.sections[base + 5].bytes[code_at + 1] = 0x25;
            relocation(img, base + 5, code_at + 2, address, target_of.RK_PC32, -4);
            code_at = code_at + 6;
        }
        emitted = emitted + 1;
        i       = i + 1;
    }
    complete = true;
    ret err[fail.Fail].ok{};
}

rec Location {
    section: target_of.SectionId;
    offset:  u32;
}

fun relocation_at(img: *target_of.ObjectImage, sec: u32, offset: u32) *target_of.Relocation {
    var found: *target_of.Relocation = nil;
    var i:     u32                   = 0;
    for (i < img.reloc_count) {
        if (target_of.section_index(img.relocations[i].section) == sec && img.relocations[i].offset == offset) {
            if (found != nil) { ret nil; }
            found = ?img.relocations[i];
        }
        i = i + 1;
    }
    ret found;
}

fun location(img: *target_of.ObjectImage, rel: *target_of.Relocation, expected: target_of.RelocKind) res[Location, fail.Fail] {
    if (rel == nil || rel.kind != expected || rel.sym >= img.symbol_count) {
        ret res[Location, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import address is not a unique relocation")};
    }
    val sym: *target_of.Symbol = ?img.symbols[rel.sym];
    if (target_of.section_index(sym.section) >= img.section_count || rel.addend < 0
        || rel.addend::u64 > 0xFFFFFFFF - sym.offset::u64) {
        ret res[Location, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import address is not locally defined")};
    }
    val offset: u32 = sym.offset + rel.addend::u32;
    if (offset >= img.sections[target_of.section_index(sym.section)].len) {
        ret res[Location, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import address is outside its section")};
    }
    ret res[Location, fail.Fail].ok{Location{section: sym.section, offset: offset}};
}

fun named(img: *target_of.ObjectImage, sec: u32, name: str) bool {
    if (sec >= img.section_count) { ret false; }
    val actual: str = bin.resolve_name(img.interner, img.sections[sec].name);
    ret actual != nil && str_equals(actual, name);
}

fun intern_at(img: *target_of.ObjectImage, loc: Location) res[intern.StrId, fail.Fail] {
    val sec:   *target_of.Section  = ?img.sections[target_of.section_index(loc.section)];
    val value: res[str, fail.Fail] = bin.cstr_at(sec.bytes, sec.len::usize, loc.offset::usize);
    if (sel value.err) { ret res[intern.StrId, fail.Fail].err{value.err}; }
    val r_278: res[intern.StrId, A.Error] = intern.intern(img.interner, value.ok);
    if (sel r_278.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_278.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_278.ok};
}

fun add_import(img: *target_of.ObjectImage, decl: target_of.ImportDecl) err[fail.Fail] {
    if (img.import_count == img.import_cap) {
        var cap: u32 = 8;
        if (img.import_cap != 0) {
            if (img.import_cap > 0x7FFFFFFF) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "coff: import count exceeds its range")}; }
            cap = img.import_cap * 2;
        }
        var grown: res[*target_of.ImportDecl, A.Error];
        if (img.imports == nil) { grown = A.allocate[target_of.ImportDecl](img.alloc, cap::usize); }
        or                      { grown = A.reallocate[target_of.ImportDecl](img.alloc, img.imports, img.import_cap::usize, cap::usize); }
        if (sel grown.err)      { ret err[fail.Fail].err{fail.refused(grown.err)}; }
        img.imports    = grown.ok;
        img.import_cap = cap;
    }
    img.imports[img.import_count] = decl;
    img.import_count              = img.import_count + 1;
    ret err[fail.Fail].ok{};
}

fun public_slot(img: *target_of.ObjectImage, slot: Location) res[u32, fail.Fail] {
    var found: u32 = target_of.SYMBOL_NONE;
    var i:     u32 = 0;
    for (i < img.symbol_count) {
        val sym:  *target_of.Symbol = ?img.symbols[i];
        val name: str               = bin.resolve_name(img.interner, sym.name);
        if (target_of.section_same(sym.section, slot.section) && sym.offset == slot.offset
            && (sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && name != nil && str_len(name) > 6
            && name[0] == '_' && name[1] == '_' && name[2] == 'i'
            && name[3] == 'm' && name[4] == 'p' && name[5] == '_') {
            if (found != target_of.SYMBOL_NONE) { ret res[u32, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import slot has ambiguous public names")}; }
            found = i;
        }
        i = i + 1;
    }
    if (found == target_of.SYMBOL_NONE) { ret res[u32, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import slot has no public address symbol")}; }
    ret res[u32, fail.Fail].ok{found};
}

fun mark_bytes(img: *target_of.ObjectImage, covered: *u8, section: u32, offset: u32, len: u32) {
    var base: usize = 0;
    var i:    u32   = 0;
    for (i < section) {
        if (img.sections[i].bytes != nil) { base = base + img.sections[i].len::usize; }
        i = i + 1;
    }
    i = 0;
    for (i < len) {
        covered[base + offset::usize + i::usize] = 1;
        i                                        = i + 1;
    }
}

fun mark_relocation(img: *target_of.ObjectImage, covered: *u8, relocation: *target_of.Relocation) {
    if (relocation != nil) {
        val index: usize = (relocation::usize - img.relocations::usize) / $size_of(target_of.Relocation);
        covered[index] = 1;
    }
}

pub fun normalize(img: *target_of.ObjectImage) err[fail.Fail] {
    var recognized: bool = false;
    var sec:        u32  = 0;
    for (sec < img.section_count) {
        if (named(img, sec, ".idata$2") && img.sections[sec].len >= 20) {
            val lookup: res[Location, fail.Fail] = location(img, relocation_at(img, sec, 0), target_of.RK_ADDR32NB);
            val iat:    res[Location, fail.Fail] = location(img, relocation_at(img, sec, 16), target_of.RK_ADDR32NB);
            if (sel lookup.ok && sel iat.ok) { recognized = true; }
        }
        sec = sec + 1;
    }
    if (!recognized) { ret err[fail.Fail].ok{}; }
    var payload_size: usize = 0;
    sec = 0;
    for (sec < img.section_count) {
        if (img.sections[sec].bytes != nil) {
            if (img.sections[sec].len::usize > ~0::usize - payload_size) { ret err[fail.Fail].err{fail.message("coff: import coverage size overflows")}; }
            payload_size = payload_size + img.sections[sec].len::usize;
        }
        sec = sec + 1;
    }
    if (img.reloc_count::usize > ~0::usize - payload_size) { ret err[fail.Fail].err{fail.message("coff: import coverage size overflows")}; }
    val coverage_size:   usize             = payload_size + img.reloc_count::usize;
    val coverage_result: res[*u8, A.Error] = A.zallocate[u8](img.alloc, coverage_size);
    if (sel coverage_result.err) { ret err[fail.Fail].err{fail.refused(coverage_result.err)}; }
    val coverage: *u8 = coverage_result.ok;
    fin { A.deallocate[u8](img.alloc, coverage, coverage_size); }
    val relocation_coverage: *u8                = (coverage::usize + payload_size)::*u8;
    val scratch_count:       usize              = img.section_count::usize * 2 + img.symbol_count::usize * 2;
    val scratch:             res[*u32, A.Error] = A.zallocate[u32](img.alloc, scratch_count);
    if (sel scratch.err) { ret err[fail.Fail].err{fail.refused(scratch.err)}; }
    val consumed: *u32 = scratch.ok;
    fin { A.deallocate[u32](img.alloc, consumed, scratch_count); }
    val section_map:    *u32 = (consumed::usize + img.section_count::usize * $size_of(u32))::*u32;
    val public_symbols: *u32 = (section_map::usize + img.section_count::usize * $size_of(u32))::*u32;
    val symbol_map:     *u32 = (public_symbols::usize + img.symbol_count::usize * $size_of(u32))::*u32;
    sec = 0;
    for (sec < img.section_count) {
        if (!named(img, sec, ".idata$2")) {
            sec = sec + 1;
            cnt;
        }
        val descriptors: *target_of.Section = ?img.sections[sec];
        if (descriptors.len % 20 != 0) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import descriptor size is invalid")}; }
        consumed[sec] = 1;
        var at: u32 = 0;
        for (at < descriptors.len) {
            if (bin.read_u32_le(descriptors.bytes, at::usize) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 12) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 16) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 4) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 8) != 0) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: bound native imports are not relocatable declarations")};
            }
            val lr: res[Location, fail.Fail] = location(img, relocation_at(img, sec, at), target_of.RK_ADDR32NB);
            val nr: res[Location, fail.Fail] = location(img, relocation_at(img, sec, at + 12), target_of.RK_ADDR32NB);
            val ar: res[Location, fail.Fail] = location(img, relocation_at(img, sec, at + 16), target_of.RK_ADDR32NB);
            if (sel lr.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: mixed or incomplete native import descriptors")}; }
            if (sel nr.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: mixed or incomplete native import descriptors")}; }
            if (sel ar.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: mixed or incomplete native import descriptors")}; }
            mark_bytes(img, coverage, sec, at, 20);
            mark_relocation(img, relocation_coverage, relocation_at(img, sec, at));
            mark_relocation(img, relocation_coverage, relocation_at(img, sec, at + 12));
            mark_relocation(img, relocation_coverage, relocation_at(img, sec, at + 16));
            var lookup:  Location = lr.ok;
            val dll:     Location = nr.ok;
            var address: Location = ar.ok;
            if (!named(img, target_of.section_index(lookup.section), ".idata$4") || !named(img, target_of.section_index(address.section), ".idata$5")
                || !named(img, target_of.section_index(dll.section), ".idata$6")) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import descriptor points outside its carriers")};
            }
            val library: res[intern.StrId, fail.Fail] = intern_at(img, dll);
            if (sel library.err) { ret err[fail.Fail].err{library.err}; }
            mark_bytes(img, coverage, target_of.section_index(dll.section), dll.offset,
                str_len(bin.resolve_name(img.interner, library.ok))::u32 + 1);
            consumed[target_of.section_index(lookup.section)]  = 1;
            consumed[target_of.section_index(address.section)] = 1;
            consumed[target_of.section_index(dll.section)]     = 1;
            for (true) {
                if (lookup.offset > img.sections[target_of.section_index(lookup.section)].len || address.offset > img.sections[target_of.section_index(address.section)].len
                    || img.sections[target_of.section_index(lookup.section)].len - lookup.offset < 8 || img.sections[target_of.section_index(address.section)].len - address.offset < 8) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import table lacks its terminator")};
                }
                val lv:   u64                   = bin.read_u64_le(img.sections[target_of.section_index(lookup.section)].bytes, lookup.offset::usize);
                val av:   u64                   = bin.read_u64_le(img.sections[target_of.section_index(address.section)].bytes, address.offset::usize);
                val lrel: *target_of.Relocation = relocation_at(img, target_of.section_index(lookup.section), lookup.offset);
                val arel: *target_of.Relocation = relocation_at(img, target_of.section_index(address.section), address.offset);
                mark_bytes(img, coverage, target_of.section_index(lookup.section), lookup.offset, 8);
                mark_bytes(img, coverage, target_of.section_index(address.section), address.offset, 8);
                if (lv == 0 && av == 0 && lrel == nil && arel == nil) { brk; }
                val ps: res[u32, fail.Fail] = public_slot(img, address);
                if (sel ps.err) { ret err[fail.Fail].err{ps.err}; }
                val slot_symbol: u32                        = ps.ok;
                val slot_name:   str                        = bin.resolve_name(img.interner, img.symbols[slot_symbol].name);
                val public_name: res[intern.StrId, A.Error] = intern.intern(img.interner, (slot_name::usize + 6)::str);
                if (sel public_name.err) { ret err[fail.Fail].err{fail.refused(public_name.err)}; }
                var decl: target_of.ImportDecl = target_of.ImportDecl{};
                decl.symbol      = public_name.ok;
                decl.import_name = decl.symbol;
                decl.library     = library.ok;
                if ((lv & 0x8000000000000000) != 0) {
                    if (lv != av || (lv & 0x7FFFFFFFFFFF0000) != 0 || lrel != nil || arel != nil) {
                        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native ordinal import tables disagree")};
                    }
                    decl.ordinal = lv::u16;
                }
                or {
                    if (lv != 0 || av != 0) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: named import has nonzero unrelocated address bits")}; }
                    val hint:  res[Location, fail.Fail] = location(img, lrel, target_of.RK_ADDR32NB);
                    val hint2: res[Location, fail.Fail] = location(img, arel, target_of.RK_ADDR32NB);
                    if (sel hint.err)  { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native named import is not relocated")}; }
                    if (sel hint2.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native named import is not relocated")}; }
                    var name:  Location = hint.ok;
                    val other: Location = hint2.ok;
                    if (!target_of.section_same(name.section, other.section) || name.offset != other.offset || !named(img, target_of.section_index(name.section), ".idata$6")
                        || name.offset % 2 != 0 || img.sections[target_of.section_index(name.section)].len - name.offset < 3) {
                        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native named import tables disagree")};
                    }
                    consumed[target_of.section_index(name.section)] = 1;
                    decl.ordinal                                    = bin.read_u16_le(img.sections[target_of.section_index(name.section)].bytes, name.offset::usize);
                    name.offset                                     = name.offset + 2;
                    val text: res[intern.StrId, fail.Fail] = intern_at(img, name);
                    if (sel text.err) { ret err[fail.Fail].err{text.err}; }
                    decl.import_name = text.ok;
                    decl.by_name     = true;
                    mark_bytes(img, coverage, target_of.section_index(name.section), name.offset - 2,
                        str_len(bin.resolve_name(img.interner, decl.import_name))::u32 + 3);
                    mark_relocation(img, relocation_coverage, lrel);
                    mark_relocation(img, relocation_coverage, arel);
                }
                public_symbols[slot_symbol] = 1;
                var si: u32 = 0;
                for (si < img.symbol_count) {
                    val sym: *target_of.Symbol = ?img.symbols[si];
                    if (sym.name == decl.symbol && target_of.section_index(sym.section) < img.section_count
                        && (sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0) {
                        val code: *target_of.Section    = ?img.sections[target_of.section_index(sym.section)];
                        val jump: *target_of.Relocation = relocation_at(img, target_of.section_index(sym.section), sym.offset + 2);
                        if (code.kind != target_of.SK_TEXT || sym.offset > code.len || code.len - sym.offset < 6
                            || code.bytes[sym.offset] != 0xFF || code.bytes[sym.offset + 1] != 0x25
                            || jump == nil || jump.kind != target_of.RK_PC32 || jump.addend != -4
                            || !target_of.section_same(img.symbols[jump.sym].section, address.section) || img.symbols[jump.sym].offset != address.offset) {
                            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_DUPLICATE_SYMBOL, "coff: import function conflicts with an ordinary definition")};
                        }
                        mark_bytes(img, coverage, target_of.section_index(sym.section), sym.offset, 6);
                        mark_relocation(img, relocation_coverage, jump);
                        public_symbols[si] = 1;
                        decl.is_code       = true;
                    }
                    si = si + 1;
                }
                val added: err[fail.Fail] = add_import(img, decl);
                if (sel added.err) { ret added; }
                lookup.offset  = lookup.offset + 8;
                address.offset = address.offset + 8;
            }
            at = at + 20;
        }
        sec = sec + 1;
    }
    sec = 0;
    for (sec < img.section_count) {
        if (named(img, sec, ".idata$3")) {
            var at: u32 = 0;
            for (at < img.sections[sec].len) {
                if (img.sections[sec].bytes[at] != 0) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "coff: native import terminator contains data")}; }
                at = at + 1;
            }
            consumed[sec] = 1;
        }
        if (named(img, sec, ".text$im")) {
            var at:    u32  = 0;
            var exact: bool = true;
            for (at < img.sections[sec].len) {
                var found: bool = false;
                var si:    u32  = 0;
                for (si < img.symbol_count) {
                    if (public_symbols[si] != 0 && target_of.section_index(img.symbols[si].section) == sec && img.symbols[si].offset == at) { found = true; }
                    si = si + 1;
                }
                if (!found || img.sections[sec].len - at < 6) {
                    exact = false;
                    brk;
                }
                at = at + 6;
            }
            if (exact) { consumed[sec] = 1; }
        }
        sec = sec + 1;
    }
    var coverage_base: usize = 0;
    sec = 0;
    for (sec < img.section_count) {
        if (consumed[sec] != 0) {
            var at: u32 = 0;
            for (at < img.sections[sec].len) {
                if (coverage[coverage_base + at::usize] == 0 && img.sections[sec].bytes[at] != 0) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: import carrier contains unrecognized data")};
                }
                at = at + 1;
            }
        }
        if (img.sections[sec].bytes != nil) { coverage_base = coverage_base + img.sections[sec].len::usize; }
        sec = sec + 1;
    }
    var check_rel: u32 = 0;
    for (check_rel < img.reloc_count) {
        if (consumed[target_of.section_index(img.relocations[check_rel].section)] != 0 && relocation_coverage[check_rel] == 0) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: import carrier contains an unrecognized relocation")};
        }
        check_rel = check_rel + 1;
    }
    var symbol_count: u32 = 0;
    var si:           u32 = 0;
    for (si < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[si];
        symbol_map[si] = target_of.SYMBOL_NONE;
        if (target_of.section_index(sym.section) < img.section_count && consumed[target_of.section_index(sym.section)] != 0 && public_symbols[si] == 0) {
            if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: import carrier contains an unrelated public symbol")}; }
        }
        or {
            symbol_map[si] = symbol_count;
            symbol_count   = symbol_count + 1;
        }
        si = si + 1;
    }
    var section_count: u32 = 0;
    sec = 0;
    for (sec < img.section_count) {
        section_map[sec] = target_of.SECTION_EXTERNAL;
        if (consumed[sec] == 0) {
            section_map[sec] = section_count;
            section_count    = section_count + 1;
        }
        sec = sec + 1;
    }
    sec = 0;
    for (sec < img.section_count) {
        val relation: u32 = img.sections[sec].native.link_section;
        if (consumed[sec] == 0 && relation != 0
            && (relation > img.section_count || section_map[relation - 1] == target_of.SECTION_EXTERNAL)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: section association references an import carrier")};
        }
        sec = sec + 1;
    }
    var relocation_count: u32 = 0;
    var ri:               u32 = 0;
    for (ri < img.reloc_count) {
        var rel: target_of.Relocation = img.relocations[ri];
        if (consumed[target_of.section_index(rel.section)] == 0) {
            if (symbol_map[rel.sym] == target_of.SYMBOL_NONE) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: unrelated relocation references private import carrier")}; }
            rel.section                       = target_of.section_id(section_map[target_of.section_index(rel.section)]);
            rel.sym                           = symbol_map[rel.sym];
            img.relocations[relocation_count] = rel;
            relocation_count                  = relocation_count + 1;
        }
        ri = ri + 1;
    }
    si = 0;
    for (si < img.symbol_count) {
        if (symbol_map[si] != target_of.SYMBOL_NONE) {
            var sym: target_of.Symbol = img.symbols[si];
            if (public_symbols[si] != 0) {
                sym.section = target_of.external_section();
                sym.offset  = 0;
                sym.size    = 0;
                sym.flags   = (sym.flags & ~target_of.SYM_OBJ_FLAG_SIZE_UNKNOWN) | target_of.SYM_OBJ_FLAG_EXTERN;
            }
            or (target_of.section_index(sym.section) < img.section_count) { sym.section = target_of.section_id(section_map[target_of.section_index(sym.section)]); }
            if ((sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
                if (symbol_map[sym.fallback] == target_of.SYMBOL_NONE) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "coff: weak fallback references private import carrier")}; }
                sym.fallback = symbol_map[sym.fallback];
            }
            img.symbols[symbol_map[si]] = sym;
        }
        si = si + 1;
    }
    sec = 0;
    for (sec < img.section_count) {
        if (consumed[sec] != 0) {
            if (img.sections[sec].bytes != nil) { A.deallocate[u8](img.alloc, img.sections[sec].bytes, img.sections[sec].len::usize); }
        }
        or {
            var section: target_of.Section = img.sections[sec];
            if (section.native.link_section != 0) {
                val mapped: u32 = section_map[section.native.link_section - 1];
                section.native.link_section = mapped + 1;
            }
            img.sections[section_map[sec]] = section;
        }
        sec = sec + 1;
    }
    img.section_count = section_count;
    img.symbol_count  = symbol_count;
    img.reloc_count   = relocation_count;
    ret err[fail.Fail].ok{};
}
