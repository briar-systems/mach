use A: std.allocator;
use R: std.types.result;
use std.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.bin;

pub rec Expanded {
    image: of.ObjectImage;
    owned: bool;
    borrowed_sections: u32;
}

pub fun dnit(out: *Expanded) {
    if (!out.owned) { ret; }
    var i: u32 = 0;
    for (i < out.borrowed_sections) { out.image.sections[i].bytes = nil; i = i + 1; }
    out.image.frames = nil;
    out.image.frame_cap = 0;
    out.image.imports = nil;
    out.image.import_cap = 0;
    out.image.attributes = nil;
    out.image.attributes_len = 0;
    of.object_image_dnit(?out.image);
    @out = Expanded{};
}

fun alias(img: *of.ObjectImage, prefix: str, name: intern.StrId) R.Result[intern.StrId, str] {
    val text: str = bin.resolve_name(img.interner, name);
    if (text == nil) { ret R.err[intern.StrId, str]("coff: import symbol name did not resolve"); }
    val joined: R.Result[str, str] = format.sprint(img.alloc, "{}{}", prefix, text);
    if (R.is_err[str, str](joined)) { ret R.err[intern.StrId, str](R.unwrap_err[str, str](joined)); }
    val buffer: str = R.unwrap_ok[str, str](joined);
    fin { A.deallocate[u8](img.alloc, buffer, str_len(buffer) + 1); }
    ret intern.intern(img.interner, buffer);
}

fun section(img: *of.ObjectImage, name: str, kind: of.SectionKind, len: u32, align: u32) R.Result[R.Void, str] {
    val named: R.Result[intern.StrId, str] = intern.intern(img.interner, name);
    if (R.is_err[intern.StrId, str](named)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](named)); }
    val sec: *of.Section = ?img.sections[img.section_count];
    @sec = of.Section{};
    sec.name = R.unwrap_ok[intern.StrId, str](named);
    sec.kind = kind;
    sec.len = len;
    sec.align = align;
    img.section_count = img.section_count + 1;
    if (len != 0) {
        val storage: R.Result[*u8, str] = A.zallocate[u8](img.alloc, len::usize);
        if (R.is_err[*u8, str](storage)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](storage)); }
        sec.bytes = R.unwrap_ok[*u8, str](storage);
    }
    ret R.ok_void[str]();
}

fun symbol(img: *of.ObjectImage, name: intern.StrId, sec: u32, offset: u32, flags: u32) u32 {
    val index: u32 = img.symbol_count;
    img.symbols[index] = of.Symbol{};
    img.symbols[index].name = name;
    img.symbols[index].section = sec;
    img.symbols[index].offset = offset;
    img.symbols[index].flags = flags;
    img.symbols[index].fallback = of.SYMBOL_NONE;
    img.symbols[index].align = 1;
    img.symbol_count = index + 1;
    ret index;
}

fun relocation(img: *of.ObjectImage, sec: u32, offset: u32, sym: u32, kind: of.RelocKind, addend: i64) {
    val index: u32 = img.reloc_count;
    img.relocations[index] = of.Relocation{};
    img.relocations[index].section = sec;
    img.relocations[index].offset = offset;
    img.relocations[index].sym = sym;
    img.relocations[index].kind = kind;
    img.relocations[index].addend = addend;
    img.reloc_count = index + 1;
}

fun prior_import(input: *of.ObjectImage, index: u32) u32 {
    var i: u32 = 0;
    for (i < index) {
        if (input.imports[i].symbol == input.imports[index].symbol) { ret i; }
        i = i + 1;
    }
    ret index;
}

fun same_import(a: *of.ImportDecl, b: *of.ImportDecl) bool {
    ret a.symbol == b.symbol && a.import_name == b.import_name && a.library == b.library
        && a.ordinal == b.ordinal && a.by_name == b.by_name && a.is_code == b.is_code;
}

pub fun expand(input: *of.ObjectImage, out: *Expanded) R.Result[R.Void, str] {
    @out = Expanded{};
    out.image = @input;
    if (input.import_count == 0) { ret R.ok_void[str](); }
    val total: u32 = input.import_count;
    var n: u32 = 0;
    var count_index: u32 = 0;
    for (count_index < total) {
        val prior: u32 = prior_import(input, count_index);
        if (prior == count_index) { n = n + 1; }
        or (!same_import(?input.imports[prior], ?input.imports[count_index])) {
            ret R.err[R.Void, str]("coff: conflicting attributions for one public import");
        }
        count_index = count_index + 1;
    }
    if (input.section_count > 0xFFFFFFFF - 6 || n > (0xFFFFFFFF - input.symbol_count) / 5
        || n > (0xFFFFFFFF - input.reloc_count) / 6 || n > 0xFFFFFFFF / 20) {
        ret R.err[R.Void, str]("coff: native import table exceeds its index range");
    }
    var names_len: u32 = 0;
    var code_len: u32 = 0;
    var i: u32 = 0;
    for (i < total) {
        if (prior_import(input, i) != i) { i = i + 1; cnt; }
        val decl: *of.ImportDecl = ?input.imports[i];
        val library: str = bin.resolve_name(input.interner, decl.library);
        val imported: str = bin.resolve_name(input.interner, decl.import_name);
        if (library == nil || imported == nil) { ret R.err[R.Void, str]("coff: import attribution name did not resolve"); }
        val library_len: usize = str_len(library);
        val import_len: usize = str_len(imported);
        if (library_len >= (0xFFFFFFFF - names_len)::usize || import_len > 0xFFFFFFFC::usize) {
            ret R.err[R.Void, str]("coff: native import names exceed their range");
        }
        var end: usize = names_len::usize + library_len + 1;
        if (decl.by_name) { end = bin.align_up(end, 2) + import_len + 3; }
        if (end > 0xFFFFFFFF::usize) { ret R.err[R.Void, str]("coff: native import names exceed their range"); }
        names_len = end::u32;
        if (decl.is_code) { code_len = code_len + 6; }
        i = i + 1;
    }
    out.image = of.object_image_init(input.alloc, input.interner, input.name);
    out.owned = true;
    var complete: bool = false;
    fin { if (!complete) { dnit(out); } }
    val img: *of.ObjectImage = ?out.image;
    val sections: R.Result[*of.Section, str] = A.zallocate[of.Section](input.alloc, (input.section_count + 6)::usize);
    if (R.is_err[*of.Section, str](sections)) { ret R.err[R.Void, str](R.unwrap_err[*of.Section, str](sections)); }
    img.sections = R.unwrap_ok[*of.Section, str](sections);
    img.section_cap = input.section_count + 6;
    img.section_count = input.section_count;
    out.borrowed_sections = input.section_count;
    memory.copy[of.Section](img.sections, input.sections, input.section_count::usize);
    val symbols: R.Result[*of.Symbol, str] = A.zallocate[of.Symbol](input.alloc, (input.symbol_count + n * 5)::usize);
    if (R.is_err[*of.Symbol, str](symbols)) { ret R.err[R.Void, str](R.unwrap_err[*of.Symbol, str](symbols)); }
    img.symbols = R.unwrap_ok[*of.Symbol, str](symbols);
    img.symbol_cap = input.symbol_count + n * 5;
    img.symbol_count = input.symbol_count;
    memory.copy[of.Symbol](img.symbols, input.symbols, input.symbol_count::usize);
    val relocs: R.Result[*of.Relocation, str] = A.zallocate[of.Relocation](input.alloc, (input.reloc_count + n * 6)::usize);
    if (R.is_err[*of.Relocation, str](relocs)) { ret R.err[R.Void, str](R.unwrap_err[*of.Relocation, str](relocs)); }
    img.relocations = R.unwrap_ok[*of.Relocation, str](relocs);
    img.reloc_cap = input.reloc_count + n * 6;
    img.reloc_count = input.reloc_count;
    memory.copy[of.Relocation](img.relocations, input.relocations, input.reloc_count::usize);
    img.frames = input.frames; img.frame_count = input.frame_count;
    img.attributes = input.attributes; img.attributes_len = input.attributes_len;
    img.machine_flags = input.machine_flags;
    val local_name_result: R.Result[intern.StrId, str] = intern.intern(input.interner, ".Limport");
    if (R.is_err[intern.StrId, str](local_name_result)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](local_name_result)); }
    val local_name: intern.StrId = R.unwrap_ok[intern.StrId, str](local_name_result);
    val base: u32 = input.section_count;
    val made2: R.Result[R.Void, str] = section(img, ".idata$2", of.SK_DATA, n * 20, 4);
    if (R.is_err[R.Void, str](made2)) { ret made2; }
    val made3: R.Result[R.Void, str] = section(img, ".idata$3", of.SK_DATA, 20, 4);
    if (R.is_err[R.Void, str](made3)) { ret made3; }
    val made4: R.Result[R.Void, str] = section(img, ".idata$4", of.SK_DATA, n * 16, 8);
    if (R.is_err[R.Void, str](made4)) { ret made4; }
    val made5: R.Result[R.Void, str] = section(img, ".idata$5", of.SK_DATA, n * 16, 8);
    if (R.is_err[R.Void, str](made5)) { ret made5; }
    val made6: R.Result[R.Void, str] = section(img, ".idata$6", of.SK_RODATA, names_len, 2);
    if (R.is_err[R.Void, str](made6)) { ret made6; }
    val made_text: R.Result[R.Void, str] = section(img, ".text$im", of.SK_TEXT, code_len, 2);
    if (R.is_err[R.Void, str](made_text)) { ret made_text; }
    var name_at: u32 = 0;
    var code_at: u32 = 0;
    var emitted: u32 = 0;
    i = 0;
    for (i < total) {
        if (prior_import(input, i) != i) { i = i + 1; cnt; }
        val decl: *of.ImportDecl = ?input.imports[i];
        val addressed: R.Result[intern.StrId, str] = alias(input, "__imp_", decl.symbol);
        if (R.is_err[intern.StrId, str](addressed)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](addressed)); }
        val lookup: u32 = symbol(img, local_name, base + 2, emitted * 16, 0);
        val address: u32 = symbol(img, R.unwrap_ok[intern.StrId, str](addressed), base + 3, emitted * 16, of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT);
        val library: str = bin.resolve_name(input.interner, decl.library);
        val dll: u32 = symbol(img, local_name, base + 4, name_at, 0);
        memory.copy[u8]((img.sections[base + 4].bytes::usize + name_at::usize)::*u8, library, str_len(library) + 1);
        name_at = name_at + str_len(library)::u32 + 1;
        var hint: u32 = of.SYMBOL_NONE;
        if (decl.by_name) {
            name_at = bin.align_up(name_at::usize, 2)::u32;
            hint = symbol(img, local_name, base + 4, name_at, 0);
            val imported: str = bin.resolve_name(input.interner, decl.import_name);
            bin.write_u16_le(img.sections[base + 4].bytes, name_at::usize, decl.ordinal);
            memory.copy[u8]((img.sections[base + 4].bytes::usize + name_at::usize + 2)::*u8, imported, str_len(imported) + 1);
            name_at = name_at + str_len(imported)::u32 + 3;
        }
        relocation(img, base, emitted * 20, lookup, of.RK_ADDR32NB, 0);
        relocation(img, base, emitted * 20 + 12, dll, of.RK_ADDR32NB, 0);
        relocation(img, base, emitted * 20 + 16, address, of.RK_ADDR32NB, 0);
        if (decl.by_name) {
            relocation(img, base + 2, emitted * 16, hint, of.RK_ADDR32NB, 0);
            relocation(img, base + 3, emitted * 16, hint, of.RK_ADDR32NB, 0);
        } or {
            bin.write_u64_le(img.sections[base + 2].bytes, (emitted * 16)::usize, 0x8000000000000000 | decl.ordinal::u64);
            bin.write_u64_le(img.sections[base + 3].bytes, (emitted * 16)::usize, 0x8000000000000000 | decl.ordinal::u64);
        }
        if (decl.is_code) {
            symbol(img, decl.symbol, base + 5, code_at, of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION);
            img.sections[base + 5].bytes[code_at] = 0xFF;
            img.sections[base + 5].bytes[code_at + 1] = 0x25;
            relocation(img, base + 5, code_at + 2, address, of.RK_PC32, -4);
            code_at = code_at + 6;
        }
        emitted = emitted + 1;
        i = i + 1;
    }
    complete = true;
    ret R.ok_void[str]();
}

rec Location {
    section: u32;
    offset: u32;
}

fun relocation_at(img: *of.ObjectImage, sec: u32, offset: u32) *of.Relocation {
    var found: *of.Relocation = nil;
    var i: u32 = 0;
    for (i < img.reloc_count) {
        if (img.relocations[i].section == sec && img.relocations[i].offset == offset) {
            if (found != nil) { ret nil; }
            found = ?img.relocations[i];
        }
        i = i + 1;
    }
    ret found;
}

fun location(img: *of.ObjectImage, rel: *of.Relocation, expected: of.RelocKind) R.Result[Location, str] {
    if (rel == nil || rel.kind != expected || rel.sym >= img.symbol_count) {
        ret R.err[Location, str]("coff: native import address is not a unique relocation");
    }
    val sym: *of.Symbol = ?img.symbols[rel.sym];
    if (sym.section >= img.section_count || rel.addend < 0
        || rel.addend::u64 > 0xFFFFFFFF - sym.offset::u64) {
        ret R.err[Location, str]("coff: native import address is not locally defined");
    }
    val offset: u32 = sym.offset + rel.addend::u32;
    if (offset >= img.sections[sym.section].len) {
        ret R.err[Location, str]("coff: native import address is outside its section");
    }
    ret R.ok[Location, str](Location{section: sym.section, offset: offset});
}

fun named(img: *of.ObjectImage, sec: u32, name: str) bool {
    if (sec >= img.section_count) { ret false; }
    val actual: str = bin.resolve_name(img.interner, img.sections[sec].name);
    ret actual != nil && str_equals(actual, name);
}

fun intern_at(img: *of.ObjectImage, loc: Location) R.Result[intern.StrId, str] {
    val sec: *of.Section = ?img.sections[loc.section];
    val value: R.Result[str, str] = bin.cstr_at(sec.bytes, sec.len::usize, loc.offset::usize);
    if (R.is_err[str, str](value)) { ret R.err[intern.StrId, str](R.unwrap_err[str, str](value)); }
    ret intern.intern(img.interner, R.unwrap_ok[str, str](value));
}

fun add_import(img: *of.ObjectImage, decl: of.ImportDecl) R.Result[R.Void, str] {
    if (img.import_count == img.import_cap) {
        var cap: u32 = 8;
        if (img.import_cap != 0) {
            if (img.import_cap > 0x7FFFFFFF) { ret R.err[R.Void, str]("coff: import count exceeds its range"); }
            cap = img.import_cap * 2;
        }
        var grown: R.Result[*of.ImportDecl, str];
        if (img.imports == nil) { grown = A.allocate[of.ImportDecl](img.alloc, cap::usize); }
        or { grown = A.reallocate[of.ImportDecl](img.alloc, img.imports, img.import_cap::usize, cap::usize); }
        if (R.is_err[*of.ImportDecl, str](grown)) { ret R.err[R.Void, str](R.unwrap_err[*of.ImportDecl, str](grown)); }
        img.imports = R.unwrap_ok[*of.ImportDecl, str](grown);
        img.import_cap = cap;
    }
    img.imports[img.import_count] = decl;
    img.import_count = img.import_count + 1;
    ret R.ok_void[str]();
}

fun public_slot(img: *of.ObjectImage, slot: Location) R.Result[u32, str] {
    var found: u32 = of.SYMBOL_NONE;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *of.Symbol = ?img.symbols[i];
        val name: str = bin.resolve_name(img.interner, sym.name);
        if (sym.section == slot.section && sym.offset == slot.offset
            && (sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0 && name != nil && str_len(name) > 6
            && name[0] == '_' && name[1] == '_' && name[2] == 'i'
            && name[3] == 'm' && name[4] == 'p' && name[5] == '_') {
            if (found != of.SYMBOL_NONE) { ret R.err[u32, str]("coff: native import slot has ambiguous public names"); }
            found = i;
        }
        i = i + 1;
    }
    if (found == of.SYMBOL_NONE) { ret R.err[u32, str]("coff: native import slot has no public address symbol"); }
    ret R.ok[u32, str](found);
}

fun mark_bytes(img: *of.ObjectImage, covered: *u8, section: u32, offset: u32, len: u32) {
    var base: usize = 0;
    var i: u32 = 0;
    for (i < section) {
        if (img.sections[i].bytes != nil) { base = base + img.sections[i].len::usize; }
        i = i + 1;
    }
    i = 0;
    for (i < len) { covered[base + offset::usize + i::usize] = 1; i = i + 1; }
}

fun mark_relocation(img: *of.ObjectImage, covered: *u8, relocation: *of.Relocation) {
    if (relocation != nil) {
        val index: usize = (relocation::usize - img.relocations::usize) / $size_of(of.Relocation);
        covered[index] = 1;
    }
}

pub fun normalize(img: *of.ObjectImage) R.Result[R.Void, str] {
    var recognized: bool = false;
    var sec: u32 = 0;
    for (sec < img.section_count) {
        if (named(img, sec, ".idata$2") && img.sections[sec].len >= 20) {
            val lookup: R.Result[Location, str] = location(img, relocation_at(img, sec, 0), of.RK_ADDR32NB);
            val iat: R.Result[Location, str] = location(img, relocation_at(img, sec, 16), of.RK_ADDR32NB);
            if (R.is_ok[Location, str](lookup) && R.is_ok[Location, str](iat)) { recognized = true; }
        }
        sec = sec + 1;
    }
    if (!recognized) { ret R.ok_void[str](); }
    var payload_size: usize = 0;
    sec = 0;
    for (sec < img.section_count) {
        if (img.sections[sec].bytes != nil) {
            if (img.sections[sec].len::usize > ~0::usize - payload_size) { ret R.err[R.Void, str]("coff: import coverage size overflows"); }
            payload_size = payload_size + img.sections[sec].len::usize;
        }
        sec = sec + 1;
    }
    if (img.reloc_count::usize > ~0::usize - payload_size) { ret R.err[R.Void, str]("coff: import coverage size overflows"); }
    val coverage_size: usize = payload_size + img.reloc_count::usize;
    val coverage_result: R.Result[*u8, str] = A.zallocate[u8](img.alloc, coverage_size);
    if (R.is_err[*u8, str](coverage_result)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](coverage_result)); }
    val coverage: *u8 = R.unwrap_ok[*u8, str](coverage_result);
    fin { A.deallocate[u8](img.alloc, coverage, coverage_size); }
    val relocation_coverage: *u8 = (coverage::usize + payload_size)::*u8;
    val scratch_count: usize = img.section_count::usize * 2 + img.symbol_count::usize * 2;
    val scratch: R.Result[*u32, str] = A.zallocate[u32](img.alloc, scratch_count);
    if (R.is_err[*u32, str](scratch)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](scratch)); }
    val consumed: *u32 = R.unwrap_ok[*u32, str](scratch);
    fin { A.deallocate[u32](img.alloc, consumed, scratch_count); }
    val section_map: *u32 = (consumed::usize + img.section_count::usize * $size_of(u32))::*u32;
    val public_symbols: *u32 = (section_map::usize + img.section_count::usize * $size_of(u32))::*u32;
    val symbol_map: *u32 = (public_symbols::usize + img.symbol_count::usize * $size_of(u32))::*u32;
    sec = 0;
    for (sec < img.section_count) {
        if (!named(img, sec, ".idata$2")) { sec = sec + 1; cnt; }
        val descriptors: *of.Section = ?img.sections[sec];
        if (descriptors.len % 20 != 0) { ret R.err[R.Void, str]("coff: native import descriptor size is invalid"); }
        consumed[sec] = 1;
        var at: u32 = 0;
        for (at < descriptors.len) {
            if (bin.read_u32_le(descriptors.bytes, at::usize) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 12) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 16) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 4) != 0
                || bin.read_u32_le(descriptors.bytes, at::usize + 8) != 0) {
                ret R.err[R.Void, str]("coff: bound native imports are not relocatable declarations");
            }
            val lr: R.Result[Location, str] = location(img, relocation_at(img, sec, at), of.RK_ADDR32NB);
            val nr: R.Result[Location, str] = location(img, relocation_at(img, sec, at + 12), of.RK_ADDR32NB);
            val ar: R.Result[Location, str] = location(img, relocation_at(img, sec, at + 16), of.RK_ADDR32NB);
            if (R.is_err[Location, str](lr) || R.is_err[Location, str](nr) || R.is_err[Location, str](ar)) {
                ret R.err[R.Void, str]("coff: mixed or incomplete native import descriptors");
            }
            mark_bytes(img, coverage, sec, at, 20);
            mark_relocation(img, relocation_coverage, relocation_at(img, sec, at));
            mark_relocation(img, relocation_coverage, relocation_at(img, sec, at + 12));
            mark_relocation(img, relocation_coverage, relocation_at(img, sec, at + 16));
            var lookup: Location = R.unwrap_ok[Location, str](lr);
            val dll: Location = R.unwrap_ok[Location, str](nr);
            var address: Location = R.unwrap_ok[Location, str](ar);
            if (!named(img, lookup.section, ".idata$4") || !named(img, address.section, ".idata$5")
                || !named(img, dll.section, ".idata$6")) {
                ret R.err[R.Void, str]("coff: native import descriptor points outside its carriers");
            }
            val library: R.Result[intern.StrId, str] = intern_at(img, dll);
            if (R.is_err[intern.StrId, str](library)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](library)); }
            mark_bytes(img, coverage, dll.section, dll.offset,
                str_len(bin.resolve_name(img.interner, R.unwrap_ok[intern.StrId, str](library)))::u32 + 1);
            consumed[lookup.section] = 1; consumed[address.section] = 1; consumed[dll.section] = 1;
            for (true) {
                if (lookup.offset > img.sections[lookup.section].len || address.offset > img.sections[address.section].len
                    || img.sections[lookup.section].len - lookup.offset < 8 || img.sections[address.section].len - address.offset < 8) {
                    ret R.err[R.Void, str]("coff: native import table lacks its terminator");
                }
                val lv: u64 = bin.read_u64_le(img.sections[lookup.section].bytes, lookup.offset::usize);
                val av: u64 = bin.read_u64_le(img.sections[address.section].bytes, address.offset::usize);
                val lrel: *of.Relocation = relocation_at(img, lookup.section, lookup.offset);
                val arel: *of.Relocation = relocation_at(img, address.section, address.offset);
                mark_bytes(img, coverage, lookup.section, lookup.offset, 8);
                mark_bytes(img, coverage, address.section, address.offset, 8);
                if (lv == 0 && av == 0 && lrel == nil && arel == nil) { brk; }
                val ps: R.Result[u32, str] = public_slot(img, address);
                if (R.is_err[u32, str](ps)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](ps)); }
                val slot_symbol: u32 = R.unwrap_ok[u32, str](ps);
                val slot_name: str = bin.resolve_name(img.interner, img.symbols[slot_symbol].name);
                val public_name: R.Result[intern.StrId, str] = intern.intern(img.interner, (slot_name::usize + 6)::str);
                if (R.is_err[intern.StrId, str](public_name)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](public_name)); }
                var decl: of.ImportDecl = of.ImportDecl{};
                decl.symbol = R.unwrap_ok[intern.StrId, str](public_name);
                decl.import_name = decl.symbol;
                decl.library = R.unwrap_ok[intern.StrId, str](library);
                if ((lv & 0x8000000000000000) != 0) {
                    if (lv != av || (lv & 0x7FFFFFFFFFFF0000) != 0 || lrel != nil || arel != nil) {
                        ret R.err[R.Void, str]("coff: native ordinal import tables disagree");
                    }
                    decl.ordinal = lv::u16;
                } or {
                    if (lv != 0 || av != 0) { ret R.err[R.Void, str]("coff: named import has nonzero unrelocated address bits"); }
                    val hint: R.Result[Location, str] = location(img, lrel, of.RK_ADDR32NB);
                    val hint2: R.Result[Location, str] = location(img, arel, of.RK_ADDR32NB);
                    if (R.is_err[Location, str](hint) || R.is_err[Location, str](hint2)) { ret R.err[R.Void, str]("coff: native named import is not relocated"); }
                    var name: Location = R.unwrap_ok[Location, str](hint);
                    val other: Location = R.unwrap_ok[Location, str](hint2);
                    if (name.section != other.section || name.offset != other.offset || !named(img, name.section, ".idata$6")
                        || name.offset % 2 != 0 || img.sections[name.section].len - name.offset < 3) {
                        ret R.err[R.Void, str]("coff: native named import tables disagree");
                    }
                    consumed[name.section] = 1;
                    decl.ordinal = bin.read_u16_le(img.sections[name.section].bytes, name.offset::usize);
                    name.offset = name.offset + 2;
                    val text: R.Result[intern.StrId, str] = intern_at(img, name);
                    if (R.is_err[intern.StrId, str](text)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](text)); }
                    decl.import_name = R.unwrap_ok[intern.StrId, str](text);
                    decl.by_name = true;
                    mark_bytes(img, coverage, name.section, name.offset - 2,
                        str_len(bin.resolve_name(img.interner, decl.import_name))::u32 + 3);
                    mark_relocation(img, relocation_coverage, lrel);
                    mark_relocation(img, relocation_coverage, arel);
                }
                public_symbols[slot_symbol] = 1;
                var si: u32 = 0;
                for (si < img.symbol_count) {
                    val sym: *of.Symbol = ?img.symbols[si];
                    if (sym.name == decl.symbol && sym.section < img.section_count
                        && (sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) {
                        val code: *of.Section = ?img.sections[sym.section];
                        val jump: *of.Relocation = relocation_at(img, sym.section, sym.offset + 2);
                        if (code.kind != of.SK_TEXT || sym.offset > code.len || code.len - sym.offset < 6
                            || code.bytes[sym.offset] != 0xFF || code.bytes[sym.offset + 1] != 0x25
                            || jump == nil || jump.kind != of.RK_PC32 || jump.addend != -4
                            || img.symbols[jump.sym].section != address.section || img.symbols[jump.sym].offset != address.offset) {
                            ret R.err[R.Void, str]("coff: import function conflicts with an ordinary definition");
                        }
                        mark_bytes(img, coverage, sym.section, sym.offset, 6);
                        mark_relocation(img, relocation_coverage, jump);
                        public_symbols[si] = 1;
                        decl.is_code = true;
                    }
                    si = si + 1;
                }
                val added: R.Result[R.Void, str] = add_import(img, decl);
                if (R.is_err[R.Void, str](added)) { ret added; }
                lookup.offset = lookup.offset + 8;
                address.offset = address.offset + 8;
            }
            at = at + 20;
        }
        sec = sec + 1;
    }
    sec = 0;
    for (sec < img.section_count) {
        if (named(img, sec, ".idata$3")) {
            var at: u32 = 0;
            for (at < img.sections[sec].len) {
                if (img.sections[sec].bytes[at] != 0) { ret R.err[R.Void, str]("coff: native import terminator contains data"); }
                at = at + 1;
            }
            consumed[sec] = 1;
        }
        if (named(img, sec, ".text$im")) {
            var at: u32 = 0;
            var exact: bool = true;
            for (at < img.sections[sec].len) {
                var found: bool = false;
                var si: u32 = 0;
                for (si < img.symbol_count) {
                    if (public_symbols[si] != 0 && img.symbols[si].section == sec && img.symbols[si].offset == at) { found = true; }
                    si = si + 1;
                }
                if (!found || img.sections[sec].len - at < 6) { exact = false; brk; }
                at = at + 6;
            }
            if (exact) { consumed[sec] = 1; }
        }
        sec = sec + 1;
    }
    var coverage_base: usize = 0;
    sec = 0;
    for (sec < img.section_count) {
        if (consumed[sec] != 0) {
            var at: u32 = 0;
            for (at < img.sections[sec].len) {
                if (coverage[coverage_base + at::usize] == 0 && img.sections[sec].bytes[at] != 0) {
                    ret R.err[R.Void, str]("coff: import carrier contains unrecognized data");
                }
                at = at + 1;
            }
        }
        if (img.sections[sec].bytes != nil) { coverage_base = coverage_base + img.sections[sec].len::usize; }
        sec = sec + 1;
    }
    var check_rel: u32 = 0;
    for (check_rel < img.reloc_count) {
        if (consumed[img.relocations[check_rel].section] != 0 && relocation_coverage[check_rel] == 0) {
            ret R.err[R.Void, str]("coff: import carrier contains an unrecognized relocation");
        }
        check_rel = check_rel + 1;
    }
    var symbol_count: u32 = 0;
    var si: u32 = 0;
    for (si < img.symbol_count) {
        val sym: *of.Symbol = ?img.symbols[si];
        symbol_map[si] = of.SYMBOL_NONE;
        if (sym.section < img.section_count && consumed[sym.section] != 0 && public_symbols[si] == 0) {
            if ((sym.flags & of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret R.err[R.Void, str]("coff: import carrier contains an unrelated public symbol"); }
        } or {
            symbol_map[si] = symbol_count;
            symbol_count = symbol_count + 1;
        }
        si = si + 1;
    }
    var section_count: u32 = 0;
    sec = 0;
    for (sec < img.section_count) {
        section_map[sec] = of.SECTION_EXTERNAL;
        if (consumed[sec] == 0) { section_map[sec] = section_count; section_count = section_count + 1; }
        sec = sec + 1;
    }
    sec = 0;
    for (sec < img.section_count) {
        val relation: u32 = img.sections[sec].native.link_section;
        if (consumed[sec] == 0 && relation != 0
            && (relation > img.section_count || section_map[relation - 1] == of.SECTION_EXTERNAL)) {
            ret R.err[R.Void, str]("coff: section association references an import carrier");
        }
        sec = sec + 1;
    }
    var relocation_count: u32 = 0;
    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        var rel: of.Relocation = img.relocations[ri];
        if (consumed[rel.section] == 0) {
            if (symbol_map[rel.sym] == of.SYMBOL_NONE) { ret R.err[R.Void, str]("coff: unrelated relocation references private import carrier"); }
            rel.section = section_map[rel.section];
            rel.sym = symbol_map[rel.sym];
            img.relocations[relocation_count] = rel;
            relocation_count = relocation_count + 1;
        }
        ri = ri + 1;
    }
    si = 0;
    for (si < img.symbol_count) {
        if (symbol_map[si] != of.SYMBOL_NONE) {
            var sym: of.Symbol = img.symbols[si];
            if (public_symbols[si] != 0) {
                sym.section = of.SECTION_EXTERNAL;
                sym.offset = 0; sym.size = 0;
                sym.flags = (sym.flags & ~of.SYM_OBJ_FLAG_SIZE_UNKNOWN) | of.SYM_OBJ_FLAG_EXTERN;
            } or (sym.section < img.section_count) { sym.section = section_map[sym.section]; }
            if ((sym.flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
                if (symbol_map[sym.fallback] == of.SYMBOL_NONE) { ret R.err[R.Void, str]("coff: weak fallback references private import carrier"); }
                sym.fallback = symbol_map[sym.fallback];
            }
            img.symbols[symbol_map[si]] = sym;
        }
        si = si + 1;
    }
    sec = 0;
    for (sec < img.section_count) {
        if (consumed[sec] != 0) {
            if (img.sections[sec].bytes != nil) { A.deallocate[u8](img.alloc, img.sections[sec].bytes, img.sections[sec].len::usize); }
        } or {
            var section: of.Section = img.sections[sec];
            if (section.native.link_section != 0) {
                val mapped: u32 = section_map[section.native.link_section - 1];
                section.native.link_section = mapped + 1;
            }
            img.sections[section_map[sec]] = section;
        }
        sec = sec + 1;
    }
    img.section_count = section_count;
    img.symbol_count = symbol_count;
    img.reloc_count = relocation_count;
    ret R.ok_void[str]();
}
