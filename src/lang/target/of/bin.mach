use mach.lang.fail;
use std.encoding.binary;
use std_format: std.format;
use std.memory;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use lang_checked:    mach.lang.checked;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use mach.lang.output;
use target_of: mach.lang.target.of;

# fixed-width numbers at a byte offset, laid out by std binary
pub fun write_u16_le(buf: *u8, offset: usize, value: u16) {
    binary.put_uint(?buf[offset], value::u64, 2, binary.LITTLE);
}

pub fun write_u32_le(buf: *u8, offset: usize, value: u32) {
    binary.put_uint(?buf[offset], value::u64, 4, binary.LITTLE);
}

pub fun write_u64_le(buf: *u8, offset: usize, value: u64) {
    binary.put_uint(?buf[offset], value, 8, binary.LITTLE);
}

pub fun write_u32_be(buf: *u8, offset: usize, value: u32) {
    binary.put_uint(?buf[offset], value::u64, 4, binary.BIG);
}

pub fun write_u64_be(buf: *u8, offset: usize, value: u64) {
    binary.put_uint(?buf[offset], value, 8, binary.BIG);
}

pub fun read_u16_le(buf: *u8, offset: usize) u16 {
    ret binary.get_uint(?buf[offset], 2, binary.LITTLE)::u16;
}

pub fun read_u32_le(buf: *u8, offset: usize) u32 {
    ret binary.get_uint(?buf[offset], 4, binary.LITTLE)::u32;
}

pub fun read_u32_be(buf: *u8, offset: usize) u32 {
    ret binary.get_uint(?buf[offset], 4, binary.BIG)::u32;
}

pub fun read_u64_le(buf: *u8, offset: usize) u64 {
    ret binary.get_uint(?buf[offset], 8, binary.LITTLE);
}

pub fun write_str(buf: *u8, offset: usize, s: str) usize {
    if (s == nil) {
        buf[offset] = 0;
        ret 1;
    }
    val len: usize = str_len(s);
    memory.raw_copy((buf::usize + offset)::ptr, s::ptr, len);
    buf[offset + len] = 0;
    ret len + 1;
}

pub fun region_ok(buf_size: usize, offset: usize, len: usize) bool {
    ret lang_checked.range_fits[lang_checked.ByteUnit](lang_checked.count[lang_checked.ByteUnit](buf_size),
        lang_checked.offset[lang_checked.ByteUnit](offset), lang_checked.count[lang_checked.ByteUnit](len));
}

# an input object's region that its own bytes do not hold: the object is malformed
pub fun require_region(buf_size: usize, offset: usize, len: usize, msg: str) err[fail.Fail] {
    if (!region_ok(buf_size, offset, len)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, msg)}; }
    ret err[fail.Fail].ok{};
}

pub fun cstr_at(buf: *u8, buf_size: usize, offset: usize) res[str, fail.Fail] {
    if (offset >= buf_size) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "bin: string offset out of bounds")}; }
    var i: usize = offset;
    for (i < buf_size) {
        if (buf[i] == 0) { ret res[str, fail.Fail].ok{(buf::usize + offset)::str}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "bin: unterminated string in object")};
}

pub fun resolve_name(itn: *intern.Interner, id: intern.StrId) str {
    if (itn == nil)           { ret nil; }
    if (id == intern.STR_NIL) { ret nil; }
    val opt_text: opt[str] = intern.lookup(itn, id);
    if (sel opt_text.some) { ret opt_text.some; }
    ret nil;
}

pub fun name_message(itn: *intern.Interner, a: *A.Allocator, prefix: str, name: str, generic: str) str {
    if (name == nil || itn == nil) { ret generic; }
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(a, "{}{}", prefix, name);
    if (sel res_msg.err) { ret generic; }
    val buf: str = res_msg.ok;
    ret output.intern_message(itn, a, buf, str_len(buf), generic);
}

# the symbol a relocation names, refused as `prefix` and the symbol's name, or
# as `generic` when it has none, when that symbol did not resolve
pub fun reloc_sym_index(img: *target_of.ObjectImage, r: *target_of.Relocation, prefix: str, generic: str) res[u32, fail.Fail] {
    if (r.sym < img.symbol_count) { ret res[u32, fail.Fail].ok{r.sym}; }
    ret res[u32, fail.Fail].err{fail.message(name_message(img.interner, img.alloc, prefix,
        resolve_name(img.interner, target_of.reloc_symbol_name(img, r)), generic))};
}

pub fun validate_reloc_symbols(img: *target_of.ObjectImage, prefix: str, generic: str) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: res[u32, fail.Fail] = reloc_sym_index(img, ?img.relocations[i], prefix, generic);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun number_message(itn: *intern.Interner, a: *A.Allocator, prefix: str, value: u64, generic: str) str {
    if (itn == nil) { ret generic; }
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(a, "{}{}", prefix, value);
    if (sel res_msg.err) { ret generic; }
    val buf: str = res_msg.ok;
    ret output.intern_message(itn, a, buf, str_len(buf), generic);
}

pub fun reloc_counts(a: *A.Allocator, img: *target_of.ObjectImage) res[*u32, fail.Fail] {
    val n:          usize              = img.section_count::usize;
    val res_counts: res[*u32, A.Error] = A.zallocate[u32](a, n);
    if (sel res_counts.err) { ret res[*u32, fail.Fail].err{fail.message("bin: reloc-count table alloc failed")}; }
    val counts: *u32 = res_counts.ok;
    var i:      u32  = 0;
    for (i < img.reloc_count) {
        val sec: u32 = target_of.section_index(img.relocations[i].section);
        if (sec < img.section_count) { counts[sec] = counts[sec] + 1; }
        i = i + 1;
    }
    ret res[*u32, fail.Fail].ok{counts};
}

test region_ok__wrap_around {
    if (region_ok(0x1000, 0xFFFFFFFFFFFFF800::usize, 0x801::usize)) { ret 1; }
    if (region_ok(0x10, 0x11, 0))                                   { ret 1; }
    if (!region_ok(0x10, 8, 8))                                     { ret 1; }
    if (region_ok(0x10, 8, 9))                                      { ret 1; }
    ret 0;
}
