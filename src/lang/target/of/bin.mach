use output: mach.lang.publication.testing;
use std.memory;
use std.format;
use std.crypto.rand;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.path.Path;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use fs: std.filesystem;
use io_error: std.io.error;
use spath: std.types.path;

use txn: std.filesystem.transaction;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target.of;
use mach.lang.publication;

pub fun write_u16_le(buf: *u8, offset: usize, value: u16) {
    buf[offset]     = (value & 0xFF)::u8;
    buf[offset + 1] = ((value >> 8) & 0xFF)::u8;
}

pub fun write_u32_le(buf: *u8, offset: usize, value: u32) {
    buf[offset]     = (value & 0xFF)::u8;
    buf[offset + 1] = ((value >> 8) & 0xFF)::u8;
    buf[offset + 2] = ((value >> 16) & 0xFF)::u8;
    buf[offset + 3] = ((value >> 24) & 0xFF)::u8;
}

pub fun write_u64_le(buf: *u8, offset: usize, value: u64) {
    write_u32_le(buf, offset,     (value & 0xFFFFFFFF)::u32);
    write_u32_le(buf, offset + 4, ((value >> 32) & 0xFFFFFFFF)::u32);
}

pub fun write_u32_be(buf: *u8, offset: usize, value: u32) {
    buf[offset]     = ((value >> 24) & 0xFF)::u8;
    buf[offset + 1] = ((value >> 16) & 0xFF)::u8;
    buf[offset + 2] = ((value >> 8) & 0xFF)::u8;
    buf[offset + 3] = (value & 0xFF)::u8;
}

pub fun write_u64_be(buf: *u8, offset: usize, value: u64) {
    write_u32_be(buf, offset,     ((value >> 32) & 0xFFFFFFFF)::u32);
    write_u32_be(buf, offset + 4, (value & 0xFFFFFFFF)::u32);
}

pub fun read_u16_le(buf: *u8, offset: usize) u16 {
    ret buf[offset]::u16 | (buf[offset + 1]::u16 << 8);
}

pub fun read_u32_le(buf: *u8, offset: usize) u32 {
    ret buf[offset]::u32 | (buf[offset + 1]::u32 << 8)
      | (buf[offset + 2]::u32 << 16) | (buf[offset + 3]::u32 << 24);
}

pub fun read_u32_be(buf: *u8, offset: usize) u32 {
    ret (buf[offset]::u32 << 24) | (buf[offset + 1]::u32 << 16)
      | (buf[offset + 2]::u32 << 8) | buf[offset + 3]::u32;
}

pub fun read_u64_le(buf: *u8, offset: usize) u64 {
    ret read_u32_le(buf, offset)::u64 | (read_u32_le(buf, offset + 4)::u64 << 32);
}

pub fun write_str(buf: *u8, offset: usize, s: str) usize {
    if (s == nil) {
        buf[offset] = 0;
        ret 1;
    }
    val len: usize = str_len(s);
    memory.raw_copy((buf::usize + offset)::ptr, s::ptr, len);
    buf[offset + len] = 0;
    ret len + 1;
}

pub fun align_up(value: usize, alignment: usize) usize {
    if (alignment == 0) { ret value; }
    ret (value + alignment - 1) & ~(alignment - 1);
}

pub fun align_up_u64(value: u64, alignment: u64) u64 {
    if (alignment == 0) { ret value; }
    ret (value + alignment - 1) & ~(alignment - 1);
}

pub rec Layout {
    end:      usize;
    ok:       bool;
    culprit:  str;
    expected: usize;
    found:    usize;
}

pub fun layout_init(l: *Layout) {
    l.end      = 0;
    l.ok       = true;
    l.culprit  = "";
    l.expected = 0;
    l.found    = 0;
}

pub fun layout_pad(l: *Layout, name: str, to: usize) {
    if (!l.ok)      { ret; }
    if (to < l.end) {
        l.ok       = false;
        l.culprit  = name;
        l.expected = l.end;
        l.found    = to;
        ret;
    }
    l.end = to;
}

pub fun layout_region(l: *Layout, name: str, offset: usize, len: usize) {
    if (!l.ok)          { ret; }
    if (offset != l.end) {
        l.ok       = false;
        l.culprit  = name;
        l.expected = l.end;
        l.found    = offset;
        ret;
    }
    l.end = offset + len;
}

pub fun layout_seal(l: *Layout, a: *A.Allocator, fmt: str, planned: usize) R.Result[R.Void, str] {
    if (!l.ok) {
        val r: R.Result[str, str] = format.sprint(a,
            "{}: the `{}` region starts at byte {} but the regions before it end at byte {}; the writer's layout does not tile the file it planned",
            fmt, l.culprit, l.found::u64, l.expected::u64);
        if (R.is_err[str, str](r)) { ret R.err[R.Void, str](LAYOUT_GENERIC); }
        ret R.err[R.Void, str](R.unwrap_ok[str, str](r));
    }
    if (l.end != planned) {
        val r: R.Result[str, str] = format.sprint(a,
            "{}: the writer planned a {}-byte file and laid out {} bytes; a planned size and the bytes written must agree exactly, never by truncation or padding",
            fmt, planned::u64, l.end::u64);
        if (R.is_err[str, str](r)) { ret R.err[R.Void, str](LAYOUT_GENERIC); }
        ret R.err[R.Void, str](R.unwrap_ok[str, str](r));
    }
    ret R.ok_void[str]();
}

val LAYOUT_GENERIC: str = "object writer: the planned file size and the bytes laid out disagree";

pub fun region_ok(buf_size: usize, offset: usize, len: usize) bool {
    ret layout.range_fits[layout.ByteUnit](layout.count[layout.ByteUnit](buf_size),
        layout.offset[layout.ByteUnit](offset), layout.count[layout.ByteUnit](len));
}

pub fun require_region(buf_size: usize, offset: usize, len: usize, msg: str) R.Result[R.Void, str] {
    if (!region_ok(buf_size, offset, len)) { ret R.err[R.Void, str](msg); }
    ret R.ok_void[str]();
}

pub fun cstr_at(buf: *u8, buf_size: usize, offset: usize) R.Result[str, str] {
    if (offset >= buf_size) { ret R.err[str, str]("bin: string offset out of bounds"); }
    var i: usize = offset;
    for (i < buf_size) {
        if (buf[i] == 0) { ret R.ok[str, str]((buf::usize + offset)::str); }
        i = i + 1;
    }
    ret R.err[str, str]("bin: unterminated string in object");
}

pub fun resolve_name(itn: *intern.Interner, id: intern.StrId) str {
    if (itn == nil)           { ret nil; }
    if (id == intern.STR_NIL) { ret nil; }
    val opt_text: O.Option[str] = intern.lookup(itn, id);
    if (O.is_some[str](opt_text)) { ret O.unwrap[str](opt_text); }
    ret nil;
}

pub fun name_message(itn: *intern.Interner, a: *A.Allocator, prefix: str, name: str, generic: str) str {
    if (name == nil || itn == nil) { ret generic; }
    val res_msg: R.Result[str, str] = format.sprint(a, "{}{}", prefix, name);
    if (R.is_err[str, str](res_msg)) { ret generic; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    ret publication.intern_message(itn, a, buf, str_len(buf), generic);
}

pub fun number_message(itn: *intern.Interner, a: *A.Allocator, prefix: str, value: u64, generic: str) str {
    if (itn == nil) { ret generic; }
    val res_msg: R.Result[str, str] = format.sprint(a, "{}{}", prefix, value);
    if (R.is_err[str, str](res_msg)) { ret generic; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    ret publication.intern_message(itn, a, buf, str_len(buf), generic);
}

pub fun reloc_counts(a: *A.Allocator, img: *of.ObjectImage) R.Result[*u32, str] {
    val n: usize = img.section_count::usize;
    val res_counts: R.Result[*u32, str] = A.zallocate[u32](a, n);
    if (R.is_err[*u32, str](res_counts)) { ret R.err[*u32, str]("bin: reloc-count table alloc failed"); }
    val counts: *u32 = R.unwrap_ok[*u32, str](res_counts);
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val sec: u32 = img.relocations[i].section;
        if (sec < img.section_count) { counts[sec] = counts[sec] + 1; }
        i = i + 1;
    }
    ret R.ok[*u32, str](counts);
}

test "mach.lang.target.of.bin.region_ok:wrap_around" {
    if (region_ok(0x1000, 0xFFFFFFFFFFFFF800::usize, 0x801::usize)) { ret 1; }
    if (region_ok(0x10, 0x11, 0)) { ret 1; }
    if (!region_ok(0x10, 8, 8)) { ret 1; }
    if (region_ok(0x10, 8, 9)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.bin.publish_bytes:replaces_target_content" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "atomic_dst");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }

    val dst: str = output.path(?tf);
    output.close(?tf);

    var content: [4]u8;
    content[0] = 0xDE; content[1] = 0xAD; content[2] = 0xBE; content[3] = 0xEF;

    var digest: [32]u8;
    val wr: R.Result[R.Void, str] = publication.bytes(?itn, ?alloc, dst, ?content[0], 4, 0o644, publication.REPLACE, publication.PARENTS_EXIST, "test: publish", "test: publish failed", ?digest);
    if (R.is_err[R.Void, str](wr)) { ret 1; }

    val or_: R.Result[fs.File, io_error.Error] = fs.open(dst);
    if (R.is_err[fs.File, io_error.Error](or_)) { ret 1; }
    var rf: fs.File = R.unwrap_ok[fs.File, io_error.Error](or_);
    var readback: [4]u8;
    val rr: R.Result[usize, io_error.Error] = fs.read(rf, ?readback[0], 4);
    fs.close(?rf);
    if (R.is_err[usize, io_error.Error](rr))              { ret 1; }
    if (R.unwrap_ok[usize, io_error.Error](rr) != 4)      { ret 1; }
    if (readback[0] != 0xDE || readback[1] != 0xAD
     || readback[2] != 0xBE || readback[3] != 0xEF) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.bin.publish_bytes:open_handle_survives_replace" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val tf_r: R.Result[output.Output, str] = output.create(?alloc, "atomic_live");
    if (R.is_err[output.Output, str](tf_r)) { ret 1; }
    var tf: output.Output = R.unwrap_ok[output.Output, str](tf_r);
    fin { output.dnit(?tf); }

    val dst: str = output.path(?tf);

    var old_content: [4]u8;
    old_content[0] = 0x11; old_content[1] = 0x22; old_content[2] = 0x33; old_content[3] = 0x44;
    val ww: R.Result[usize, io_error.Error] = fs.write(tf.file.file, ?old_content[0], 4);
    if (R.is_err[usize, io_error.Error](ww)) { ret 1; }

    val or_: R.Result[fs.File, io_error.Error] = fs.open(dst);
    if (R.is_err[fs.File, io_error.Error](or_)) { ret 1; }
    var held: fs.File = R.unwrap_ok[fs.File, io_error.Error](or_);
    output.close(?tf);

    var new_content: [4]u8;
    new_content[0] = 0xAA; new_content[1] = 0xBB; new_content[2] = 0xCC; new_content[3] = 0xDD;
    val wr: R.Result[R.Void, str] = publication.bytes(?itn, ?alloc, dst, ?new_content[0], 4, 0o644, publication.REPLACE, publication.PARENTS_EXIST, "test: publish", "test: publish failed", nil);
    if (R.is_err[R.Void, str](wr)) { fs.close(?held); ret 1; }

    var readback_old: [4]u8;
    val rr_old: R.Result[usize, io_error.Error] = fs.read(held, ?readback_old[0], 4);
    fs.close(?held);
    if (R.is_err[usize, io_error.Error](rr_old)) { ret 1; }
    if (readback_old[0] != 0x11 || readback_old[1] != 0x22
     || readback_old[2] != 0x33 || readback_old[3] != 0x44) { ret 1; }

    val or2: R.Result[fs.File, io_error.Error] = fs.open(dst);
    if (R.is_err[fs.File, io_error.Error](or2)) { ret 1; }
    var fresh: fs.File = R.unwrap_ok[fs.File, io_error.Error](or2);
    var readback_new: [4]u8;
    val rr_new: R.Result[usize, io_error.Error] = fs.read(fresh, ?readback_new[0], 4);
    fs.close(?fresh);
    if (R.is_err[usize, io_error.Error](rr_new)) { ret 1; }
    if (readback_new[0] != 0xAA || readback_new[1] != 0xBB
     || readback_new[2] != 0xCC || readback_new[3] != 0xDD) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.bin.publish_bytes:missing_directory_fails_cleanly" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var buf: [4]u8;
    buf[0] = 1; buf[1] = 2; buf[2] = 3; buf[3] = 4;

    val wr: R.Result[R.Void, str] = publication.bytes(?itn, ?alloc, "/mach-2475-no-such-dir/target", ?buf[0], 4, 0o644, publication.REPLACE, publication.PARENTS_EXIST, "test: publish", "test: publish failed", nil);
    if (R.is_ok[R.Void, str](wr)) { ret 1; }
    ret 0;
}
