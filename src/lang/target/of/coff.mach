val IMAGE_FILE_MACHINE_AMD64: u16 = 0x8664;

val IMAGE_FILE_DLL: u16 = 0x2000;

val IMAGE_DOS_SIGNATURE: u16 = 0x5A4D;
val IMAGE_NT_SIGNATURE:  u32 = 0x00004550;
val IMAGE_DOS_LFANEW_OFF: usize = 0x3C;
val IMAGE_COFF_HEADER_SIZE: usize = 20;

pub fun machine_for_arch(arch_id: u32) u16 {
    if (arch_id == isa.ARCH_X86_64) { ret IMAGE_FILE_MACHINE_AMD64; }
    ret 0;
}

pub fun looks_like_dll(buf: *u8, buf_size: usize, expect_machine: u16) bool {
    if (buf == nil || expect_machine == 0 || buf_size < IMAGE_DOS_LFANEW_OFF + 4) { ret false; }
    if (bin.read_u16_le(buf, 0) != IMAGE_DOS_SIGNATURE) { ret false; }
    val pe_off: usize = bin.read_u32_le(buf, IMAGE_DOS_LFANEW_OFF)::usize;
    if (pe_off + 4 + IMAGE_COFF_HEADER_SIZE > buf_size) { ret false; }
    if (bin.read_u32_le(buf, pe_off) != IMAGE_NT_SIGNATURE) { ret false; }
    val coff_off: usize = pe_off + 4;
    if (bin.read_u16_le(buf, coff_off) != expect_machine) { ret false; }
    ret (bin.read_u16_le(buf, coff_off + 18) & IMAGE_FILE_DLL) != 0;
}

val IMAGE_SCN_CNT_CODE:               u32 = 0x00000020;
val IMAGE_SCN_CNT_INITIALIZED_DATA:   u32 = 0x00000040;
val IMAGE_SCN_CNT_UNINITIALIZED_DATA: u32 = 0x00000080;
val IMAGE_SCN_LNK_COMDAT:             u32 = 0x00001000;
val IMAGE_SCN_MEM_DISCARDABLE:        u32 = 0x02000000;
val IMAGE_SCN_MEM_EXECUTE:            u32 = 0x20000000;
val IMAGE_SCN_MEM_READ:               u32 = 0x40000000;
val IMAGE_SCN_MEM_WRITE:              u32 = 0x80000000;

val IMAGE_COMDAT_SELECT_NODUPLICATES: u8 = 1;
val IMAGE_COMDAT_SELECT_ANY:          u8 = 2;
val IMAGE_COMDAT_SELECT_SAME_SIZE:    u8 = 3;
val IMAGE_COMDAT_SELECT_EXACT_MATCH:  u8 = 4;
val IMAGE_COMDAT_SELECT_ASSOCIATIVE:  u8 = 5;
val IMAGE_COMDAT_SELECT_LARGEST:      u8 = 6;

fun comdat_selection_dedups(sel: u8) bool {
    ret sel == IMAGE_COMDAT_SELECT_ANY
        || sel == IMAGE_COMDAT_SELECT_SAME_SIZE
        || sel == IMAGE_COMDAT_SELECT_EXACT_MATCH
        || sel == IMAGE_COMDAT_SELECT_ASSOCIATIVE
        || sel == IMAGE_COMDAT_SELECT_LARGEST;
}

val IMAGE_REL_AMD64_ADDR64:   u16 = 0x0001;
val IMAGE_REL_AMD64_ADDR32:   u16 = 0x0002;
val IMAGE_REL_AMD64_ADDR32NB: u16 = 0x0003;
val IMAGE_REL_AMD64_REL32:    u16 = 0x0004;
val IMAGE_REL_AMD64_REL32_1:  u16 = 0x0005;
val IMAGE_REL_AMD64_REL32_5:  u16 = 0x0009;
val IMAGE_REL_AMD64_SECTION:  u16 = 0x000A;
val IMAGE_REL_AMD64_SECREL:   u16 = 0x000B;

val IMAGE_SYM_CLASS_EXTERNAL:      u8 = 2;
val IMAGE_SYM_CLASS_STATIC:        u8 = 3;
val IMAGE_SYM_CLASS_WEAK_EXTERNAL: u8 = 105;

val IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY: u32 = 1;
val IMAGE_WEAK_EXTERN_SEARCH_LIBRARY:   u32 = 2;
val IMAGE_WEAK_EXTERN_SEARCH_ALIAS: u32 = 3;

val IMAGE_SYM_UNDEFINED: i16 = 0;

val IMAGE_SYM_DTYPE_FUNCTION: u16 = 0x20;

val COFF_HEADER_SIZE:    usize = 20;
val SECTION_HEADER_SIZE: usize = 40;
val SYMBOL_SIZE:         usize = 18;
val RELOCATION_SIZE:     usize = 10;

val IMAGE_FILE_MACHINE_UNKNOWN: u16   = 0x0000;
val BIGOBJ_SIG2:                u16   = 0xFFFF;
val BIGOBJ_MIN_VERSION:         u16   = 2;
val BIGOBJ_HEADER_SIZE:         usize = 56;
val BIGOBJ_SYMBOL_SIZE:         usize = 20;

val IMPORT_OBJECT_HEADER_SIZE: usize = 20;
val IMPORT_OBJECT_TYPE_CODE:       u16 = 0;
val IMPORT_OBJECT_TYPE_CONST:      u16 = 2;
val IMPORT_OBJECT_ORDINAL:         u16 = 0;
val IMPORT_OBJECT_NAME:            u16 = 1;
val IMPORT_OBJECT_NAME_NOPREFIX:   u16 = 2;
val IMPORT_OBJECT_NAME_UNDECORATE: u16 = 3;
val IMPORT_OBJECT_NAME_EXPORTAS:   u16 = 4;

val IMAGE_FILE_RELOCS_STRIPPED:     u16 = 0x0001;
val IMAGE_FILE_EXECUTABLE_IMAGE:    u16 = 0x0002;
val IMAGE_FILE_LINE_NUMS_STRIPPED:  u16 = 0x0004;
val IMAGE_FILE_LOCAL_SYMS_STRIPPED: u16 = 0x0008;
val IMAGE_FILE_LARGE_ADDRESS_AWARE: u16 = 0x0020;

val PE32PLUS_MAGIC:                u16 = 0x020B;
val IMAGE_SUBSYSTEM_WINDOWS_GUI:   u16 = 2;
val IMAGE_SUBSYSTEM_WINDOWS_CUI:   u16 = 3;
val IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE: u16 = 0x0040;
val IMAGE_DLLCHARACTERISTICS_NX_COMPAT: u16 = 0x0100;

val IMAGE_DIRECTORY_ENTRY_IMPORT:    u32 = 1;
val IMAGE_DIRECTORY_ENTRY_RESOURCE:  u32 = 2;
val IMAGE_DIRECTORY_ENTRY_EXCEPTION: u32 = 3;
val IMAGE_DIRECTORY_ENTRY_BASERELOC: u32 = 5;
val IMAGE_DIRECTORY_ENTRY_IAT:       u32 = 12;
val IMAGE_NUMBEROF_DIRECTORY_ENTRIES: u32 = 16;

val IMAGE_REL_BASED_ABSOLUTE: u16 = 0;
val IMAGE_REL_BASED_DIR64:    u16 = 10;
val BASE_RELOC_PAGE:          u64 = 0x1000;
val BASE_RELOC_BLOCK_HEADER:  usize = 8;

val DOS_HEADER_SIZE:     usize = 64;
val PE_SIGNATURE_SIZE:   usize = 4;
val OPTIONAL_HEADER_SIZE: usize = 240;
val DATA_DIR_SIZE:       usize = 8;
val PE_SECTION_ALIGN:    u64   = 0x1000;
val PE_FILE_ALIGN:       u64   = 0x200;

val IMPORT_DESCRIPTOR_SIZE: usize = 20;
val THUNK_SIZE:             usize = 8;
val IMPORT_ORDINAL_FLAG64:  u64   = 0x8000000000000000;
val IMPORT_STUB_SIZE:       usize = 6;
val RUNTIME_FUNCTION_SIZE:  usize = 12;

val UNWIND_VERSION: u8 = 1;
val UWOP_PUSH_NONVOL: u8 = 0;
val UWOP_ALLOC_LARGE: u8 = 1;
val UWOP_ALLOC_SMALL: u8 = 2;
val UWOP_SET_FPREG: u8 = 3;
val UWOP_SAVE_NONVOL: u8 = 4;
val UWOP_SAVE_NONVOL_FAR: u8 = 5;
val UWOP_SAVE_XMM128: u8 = 8;
val UWOP_SAVE_XMM128_FAR: u8 = 9;
val UWREG_RBP: u8 = 5;

fun reloc_type_for(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) R.Result[u16, str] {
    if (kind == of.RK_ABS64)    { ret R.ok[u16, str](IMAGE_REL_AMD64_ADDR64); }
    if (kind == of.RK_PC32)     { ret R.ok[u16, str](IMAGE_REL_AMD64_REL32); }
    if (kind == of.RK_PLT32)    { ret R.ok[u16, str](IMAGE_REL_AMD64_REL32); }
    if (kind == of.RK_ADDR32NB) { ret R.ok[u16, str](IMAGE_REL_AMD64_ADDR32NB); }
    if (kind == of.RK_ABS32)    { ret R.ok[u16, str](IMAGE_REL_AMD64_ADDR32); }
    if (kind == of.RK_SECREL32) { ret R.ok[u16, str](IMAGE_REL_AMD64_SECREL); }
    if (kind == of.RK_SECTION)  { ret R.ok[u16, str](IMAGE_REL_AMD64_SECTION); }
    ret R.err[u16, str](unsupported_kind_message(itn, alloc, kind));
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: of.RelocKind) str {
    ret bin.name_message(itn, alloc, "coff: unsupported relocation kind: ",
                         of.reloc_kind_name(kind), "coff: unsupported relocation kind");
}

fun unsupported_type_message(itn: *intern.Interner, alloc: *A.Allocator, r_type: u64) str {
    ret bin.number_message(itn, alloc, "coff: unsupported relocation type ",
                           r_type, "coff: unsupported relocation type");
}

fun validate_reloc_kinds(img: *of.ObjectImage) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: R.Result[u16, str] = reloc_type_for(img.interner, img.alloc, img.relocations[i].kind);
        if (R.is_err[u16, str](r)) { ret R.err[R.Void, str](R.unwrap_err[u16, str](r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun rel32_bias(r_type: u16) i64 {
    if (r_type < IMAGE_REL_AMD64_REL32_1 || r_type > IMAGE_REL_AMD64_REL32_5) { ret 0; }
    ret (r_type - IMAGE_REL_AMD64_REL32)::i64;
}

fun is_rel32_family(r_type: u16) bool {
    ret r_type == IMAGE_REL_AMD64_REL32
        || (r_type >= IMAGE_REL_AMD64_REL32_1 && r_type <= IMAGE_REL_AMD64_REL32_5);
}

fun read_inplace_addend(sec: *of.Section, r_type: u16, offset: u32) i64 {
    if (sec.bytes == nil)                  { ret 0; }
    if (r_type == IMAGE_REL_AMD64_SECTION) { ret 0; }
    if (r_type == IMAGE_REL_AMD64_ADDR64) {
        if (offset::usize + 8 > sec.len::usize) { ret 0; }
        ret bin.read_u64_le(sec.bytes, offset::usize)::i64;
    }
    if (offset::usize + 4 > sec.len::usize) { ret 0; }
    val field: i64 = (bin.read_u32_le(sec.bytes, offset::usize)::i32)::i64;
    if (is_rel32_family(r_type)) { ret field - 4 - rel32_bias(r_type); }
    ret field;
}

fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, r_type: u16) R.Result[of.RelocKind, str] {
    if (r_type == IMAGE_REL_AMD64_ADDR64)   { ret R.ok[of.RelocKind, str](of.RK_ABS64); }
    if (is_rel32_family(r_type))            { ret R.ok[of.RelocKind, str](of.RK_PC32); }
    if (r_type == IMAGE_REL_AMD64_ADDR32NB) { ret R.ok[of.RelocKind, str](of.RK_ADDR32NB); }
    if (r_type == IMAGE_REL_AMD64_ADDR32)   { ret R.ok[of.RelocKind, str](of.RK_ABS32); }
    if (r_type == IMAGE_REL_AMD64_SECREL)   { ret R.ok[of.RelocKind, str](of.RK_SECREL32); }
    if (r_type == IMAGE_REL_AMD64_SECTION)  { ret R.ok[of.RelocKind, str](of.RK_SECTION); }
    ret R.err[of.RelocKind, str](unsupported_type_message(itn, alloc, r_type::u64));
}

fun section_characteristics_for(kind: of.SectionKind) u32 {
    if (kind == of.SK_TEXT) {
        ret IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    }
    if (kind == of.SK_DATA) {
        ret IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    if (kind == of.SK_RODATA || kind == of.SK_RELRO || kind == of.SK_EXCEPTION) {
        ret IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    }
    if (kind == of.SK_BSS) {
        ret IMAGE_SCN_CNT_UNINITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    ret IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_DISCARDABLE | IMAGE_SCN_MEM_READ;
}

fun align_characteristic(align: u32) u32 {
    var a: u32 = align;
    if (a < 1) { a = 1; }
    var log: u32 = 0;
    for (a > 1) {
        a = a >> 1;
        log = log + 1;
    }
    if (log > 13) { log = 13; }
    ret (log + 1) << 20;
}

fun align_from_characteristics(chars: u32) u32 {
    val field: u32 = (chars >> 20) & 0xF;
    if (field == 0) { ret 1; }
    var a: u32 = 1;
    var n: u32 = field - 1;
    for (n > 0) {
        a = a << 1;
        n = n - 1;
    }
    ret a;
}

fun section_has_data(kind: of.SectionKind) bool {
    ret kind != of.SK_BSS;
}

fun symbol_type_for(kind: of.SectionKind) u16 {
    if (kind == of.SK_TEXT) { ret IMAGE_SYM_DTYPE_FUNCTION; }
    ret 0;
}

fun name_in_strtab(name: str) bool {
    ret name != nil && str_len(name) > 8;
}

fun strtab_size(img: *of.ObjectImage) usize {
    var total: usize = 4;
    var s: u32 = 0;
    for (s < img.section_count) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (name_in_strtab(sn)) { total = total + str_len(sn) + 1; }
        s = s + 1;
    }
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val name: str = bin.resolve_name(img.interner, img.symbols[i].name);
        if (name_in_strtab(name)) { total = total + str_len(name) + 1; }
        i = i + 1;
    }
    ret total;
}

fun write_inline_name(buf: *u8, off: usize, name: str) {
    memory.raw_zero((buf::usize + off)::ptr, 8);
    if (name == nil) { ret; }
    memory.raw_copy((buf::usize + off)::ptr, name::ptr, str_len(name));
}

fun write_decimal(buf: *u8, off: usize, width: usize, value: u32) {
    var digits: usize = 1;
    var scan: u32 = value;
    for (scan >= 10) { digits = digits + 1; scan = scan / 10; }
    if (digits > width) { digits = width; }

    var v: u32 = value;
    var i: usize = digits;
    for (i > 0) {
        i = i - 1;
        buf[off + i] = ('0'::u32 + (v % 10))::u8;
        v = v / 10;
    }

    var p: usize = digits;
    for (p < width) {
        buf[off + p] = 0;
        p = p + 1;
    }
}

fun reloc_sym_index(img: *of.ObjectImage, r: *of.Relocation) R.Result[u32, str] {
    if (r.sym < img.symbol_count) { ret R.ok[u32, str](r.sym); }
    ret R.err[u32, str](unresolved_reloc_message(img.interner, img.alloc,
        of.reloc_symbol_name(img, r)));
}

fun unresolved_reloc_message(itn: *intern.Interner, alloc: *A.Allocator, sym: intern.StrId) str {
    ret bin.name_message(itn, alloc, "coff: unresolved relocation symbol: ",
                         bin.resolve_name(itn, sym), "coff: relocation references an unresolved symbol");
}

fun validate_reloc_symbols(img: *of.ObjectImage) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: R.Result[u32, str] = reloc_sym_index(img, ?img.relocations[i]);
        if (R.is_err[u32, str](r)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](r)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun reloc_field_width(kind: of.RelocKind) usize {
    if (kind == of.RK_ABS64)   { ret 8; }
    if (kind == of.RK_SECTION) { ret 2; }
    ret 4;
}

fun validate_reloc_ranges(img: *of.ObjectImage) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val rsec: u32 = img.relocations[i].section;
        if (rsec >= img.section_count) {
            ret R.err[R.Void, str](bin.number_message(img.interner, img.alloc, "coff: out-of-range section referenced by relocation #", i::u64, "coff: relocation references an out-of-range section"));
        }
        if (!section_has_data(img.sections[rsec].kind)) {
            ret R.err[R.Void, str](bin.number_message(img.interner, img.alloc, "coff: relocation patches a section with no raw data; relocation #", i::u64, "coff: relocation patches a section with no raw data"));
        }
        val w:   usize = reloc_field_width(img.relocations[i].kind);
        val off: usize = img.relocations[i].offset::usize;
        if (off + w > img.sections[rsec].len::usize) {
            ret R.err[R.Void, str](bin.number_message(img.interner, img.alloc, "coff: relocation offset out of range for its section; relocation #", i::u64, "coff: relocation offset out of range for its section"));
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun is_defined_weak(sym: *of.Symbol, num_secs: u32) bool {
    if ((sym.flags & of.SYM_OBJ_FLAG_WEAK) == 0) { ret false; }
    if (sym.section == of.SECTION_EXTERNAL)      { ret false; }
    if (sym.section >= num_secs)                 { ret false; }
    ret true;
}

fun count_defined_weak(img: *of.ObjectImage) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if (is_defined_weak(?img.symbols[i], img.section_count)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun weak_symbol_extent(img: *of.ObjectImage, sym_idx: u32) u32 {
    val sec: u32 = img.symbols[sym_idx].section;
    val start: u32 = img.symbols[sym_idx].offset;
    val sec_len: u32 = img.sections[sec].len;
    var end: u32 = sec_len;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if (i != sym_idx && img.symbols[i].section == sec) {
            val o: u32 = img.symbols[i].offset;
            if (o > start && o < end) { end = o; }
        }
        i = i + 1;
    }
    if (end < start)   { ret 0; }
    if (end > sec_len) { end = sec_len; }
    ret end - start;
}

rec WeakRegion {
    sec:   u32;
    start: u32;
    end:   u32;
}

fun weak_region_cmp(a: *WeakRegion, b: *WeakRegion) i64 {
    if (a.sec < b.sec)     { ret -1; }
    if (a.sec > b.sec)     { ret 1; }
    if (a.start < b.start) { ret -1; }
    if (a.start > b.start) { ret 1; }
    if (a.end < b.end)     { ret -1; }
    if (a.end > b.end)     { ret 1; }
    ret 0;
}

fun carrier_align(off: u32, sec_align: u32) u32 {
    var p: u32 = 1;
    for ((off & p) == 0 && p < sec_align && p < 0x40000000) { p = p << 1; }
    ret p;
}

fun free_build_scratch(alloc: *A.Allocator, regions: *WeakRegion, weak_n: u32,
                       plan: *u32, plan_carrier: *bool, cap: u32,
                       secmeta: *u32, orig_secs: u32) {
    if (regions != nil)      { A.deallocate[WeakRegion](alloc, regions, weak_n::usize); }
    if (plan != nil)         { A.deallocate[u32](alloc, plan, (cap * 3)::usize); }
    if (plan_carrier != nil) { A.deallocate[bool](alloc, plan_carrier, cap::usize); }
    if (secmeta != nil)      { A.deallocate[u32](alloc, secmeta, (orig_secs * 2)::usize); }
}

fun subsection_for(sec_base: *u32, sec_cnt: *u32, p_start: *u32, sec: u32, off: u32) u32 {
    val base: u32 = sec_base[sec];
    var lo: u32 = base;
    var hi: u32 = base + sec_cnt[sec];
    var pick: u32 = base;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (p_start[mid] <= off) { pick = mid; lo = mid + 1; }
        or                       { hi = mid; }
    }
    ret pick;
}

fun build_weak_comdat_image(alloc: *A.Allocator, img: *of.ObjectImage,
                            out: *of.ObjectImage, out_comdat: **bool) R.Result[R.Void, str] {
    val orig_secs: u32 = img.section_count;
    val weak_n: u32 = count_defined_weak(img);

    @out = of.object_image_init(alloc, img.interner, img.name);
    out.symbol_count = img.symbol_count;
    out.reloc_count = img.reloc_count;
    @out_comdat = nil;

    var regions: *WeakRegion = nil;
    if (weak_n > 0) {
        val rw: R.Result[*WeakRegion, str] = A.zallocate[WeakRegion](alloc, weak_n::usize);
        if (R.is_err[*WeakRegion, str](rw)) { ret R.err[R.Void, str]("coff: comdat weak-region alloc failed"); }
        regions = R.unwrap_ok[*WeakRegion, str](rw);
        var w: u32 = 0;
        var i: u32 = 0;
        for (i < img.symbol_count) {
            if (is_defined_weak(?img.symbols[i], orig_secs)) {
                val st: u32 = img.symbols[i].offset;
                regions[w].sec   = img.symbols[i].section;
                regions[w].start = st;
                regions[w].end   = st + weak_symbol_extent(img, i);
                w = w + 1;
            }
            i = i + 1;
        }
        sort.sort[WeakRegion](regions, weak_n::usize, weak_region_cmp);
    }

    val cap: u32 = orig_secs + weak_n * 2;

    var p_src:     *u32  = nil;
    var p_start:   *u32  = nil;
    var p_len:     *u32  = nil;
    var p_carrier: *bool = nil;
    var sec_base:  *u32  = nil;
    var sec_cnt:   *u32  = nil;
    if (cap > 0) {
        val rp: R.Result[*u32, str] = A.zallocate[u32](alloc, (cap * 3)::usize);
        if (R.is_err[*u32, str](rp)) {
            free_build_scratch(alloc, regions, weak_n, nil, nil, cap, nil, orig_secs);
            ret R.err[R.Void, str]("coff: comdat plan alloc failed");
        }
        p_src   = R.unwrap_ok[*u32, str](rp);
        p_start = (p_src::usize + cap::usize * 4)::*u32;
        p_len   = (p_src::usize + cap::usize * 8)::*u32;

        val rpc: R.Result[*bool, str] = A.zallocate[bool](alloc, cap::usize);
        if (R.is_err[*bool, str](rpc)) {
            free_build_scratch(alloc, regions, weak_n, p_src, nil, cap, nil, orig_secs);
            ret R.err[R.Void, str]("coff: comdat plan-flag alloc failed");
        }
        p_carrier = R.unwrap_ok[*bool, str](rpc);
    }
    if (orig_secs > 0) {
        val rm: R.Result[*u32, str] = A.zallocate[u32](alloc, (orig_secs * 2)::usize);
        if (R.is_err[*u32, str](rm)) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, nil, orig_secs);
            ret R.err[R.Void, str]("coff: comdat section-map alloc failed");
        }
        sec_base = R.unwrap_ok[*u32, str](rm);
        sec_cnt  = (sec_base::usize + orig_secs::usize * 4)::*u32;
    }

    var plan_n: u32 = 0;
    var wr: u32 = 0;
    var s: u32 = 0;
    for (s < orig_secs) {
        sec_base[s] = plan_n;
        val seclen: u32 = img.sections[s].len;
        var cursor: u32 = 0;
        var have_prev: bool = false;
        var prev_start: u32 = 0;
        var prev_end: u32 = 0;
        for (wr < weak_n && regions[wr].sec == s) {
            val bstart: u32 = regions[wr].start;
            val bend:   u32 = regions[wr].end;
            wr = wr + 1;
            if (have_prev && bstart == prev_start && bend == prev_end) { cnt; }
            if (bstart < cursor) { cnt; }
            if (bstart > cursor) {
                if (plan_n >= cap) { free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs); ret R.err[R.Void, str]("coff: comdat plan overflow"); }
                p_src[plan_n] = s; p_start[plan_n] = cursor; p_len[plan_n] = bstart - cursor;
                p_carrier[plan_n] = false;
                plan_n = plan_n + 1;
                cursor = bstart;
            }
            if (plan_n >= cap) { free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs); ret R.err[R.Void, str]("coff: comdat plan overflow"); }
            p_src[plan_n] = s; p_start[plan_n] = bstart; p_len[plan_n] = bend - bstart;
            p_carrier[plan_n] = true;
            plan_n = plan_n + 1;
            prev_start = bstart; prev_end = bend; have_prev = true;
            if (bend > cursor) { cursor = bend; }
        }
        if (cursor < seclen || plan_n == sec_base[s]) {
            if (plan_n >= cap) { free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs); ret R.err[R.Void, str]("coff: comdat plan overflow"); }
            p_src[plan_n] = s; p_start[plan_n] = cursor; p_len[plan_n] = seclen - cursor;
            p_carrier[plan_n] = false;
            plan_n = plan_n + 1;
        }
        sec_cnt[s] = plan_n - sec_base[s];
        s = s + 1;
    }

    if (plan_n > 0) {
        val rs: R.Result[*of.Section, str] = A.zallocate[of.Section](alloc, plan_n::usize);
        if (R.is_err[*of.Section, str](rs)) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret R.err[R.Void, str]("coff: comdat section array alloc failed");
        }
        out.sections = R.unwrap_ok[*of.Section, str](rs);
        out.section_count = plan_n;
        out.section_cap = plan_n;

        val rc: R.Result[*bool, str] = A.zallocate[bool](alloc, plan_n::usize);
        if (R.is_err[*bool, str](rc)) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret R.err[R.Void, str]("coff: comdat flag array alloc failed");
        }
        @out_comdat = R.unwrap_ok[*bool, str](rc);
    }
    out.section_count = plan_n;
    val comdat: *bool = @out_comdat;

    if (img.symbol_count > 0) {
        val ry: R.Result[*of.Symbol, str] = A.zallocate[of.Symbol](alloc, img.symbol_count::usize);
        if (R.is_err[*of.Symbol, str](ry)) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret R.err[R.Void, str]("coff: comdat symbol array alloc failed");
        }
        out.symbols = R.unwrap_ok[*of.Symbol, str](ry);
        out.symbol_cap = img.symbol_count;
    }
    if (img.reloc_count > 0) {
        val rr: R.Result[*of.Relocation, str] = A.zallocate[of.Relocation](alloc, img.reloc_count::usize);
        if (R.is_err[*of.Relocation, str](rr)) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret R.err[R.Void, str]("coff: comdat reloc array alloc failed");
        }
        out.relocations = R.unwrap_ok[*of.Relocation, str](rr);
        out.reloc_cap = img.reloc_count;
    }

    var oi: u32 = 0;
    for (oi < plan_n) {
        val src: u32 = p_src[oi];
        out.sections[oi].name = img.sections[src].name;
        out.sections[oi].kind = img.sections[src].kind;
        out.sections[oi].len  = p_len[oi];
        if (p_carrier[oi]) {
            out.sections[oi].align = carrier_align(p_start[oi], img.sections[src].align);
        } or (oi == sec_base[src]) {
            out.sections[oi].align = img.sections[src].align;
        } or {
            out.sections[oi].align = 1;
        }
        if (section_has_data(img.sections[src].kind) && img.sections[src].bytes != nil
            && p_len[oi] > 0) {
            out.sections[oi].bytes = (img.sections[src].bytes::usize + p_start[oi]::usize)::*u8;
        } or {
            out.sections[oi].bytes = nil;
        }
        comdat[oi] = p_carrier[oi];
        oi = oi + 1;
    }

    var i: u32 = 0;
    for (i < img.symbol_count) {
        out.symbols[i] = img.symbols[i];
        val sec: u32 = img.symbols[i].section;
        if (sec != of.SECTION_EXTERNAL && sec < orig_secs) {
            val off: u32 = img.symbols[i].offset;
            var sub: u32 = subsection_for(sec_base, sec_cnt, p_start, sec, off);
            if (p_carrier[sub] && p_len[sub] == 0
                && (img.symbols[i].flags & of.SYM_OBJ_FLAG_WEAK) == 0) {
                for (sub > sec_base[sec] && p_len[sub] == 0) { sub = sub - 1; }
            }
            if (p_carrier[sub]
                && (img.symbols[i].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0
                && (img.symbols[i].flags & of.SYM_OBJ_FLAG_WEAK) == 0) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret R.err[R.Void, str]("coff: non-weak global shares a weak COMDAT carrier");
            }
            out.symbols[i].section = sub;
            out.symbols[i].offset  = off - p_start[sub];
        }
        i = i + 1;
    }

    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        out.relocations[ri] = img.relocations[ri];
        val rsec: u32 = img.relocations[ri].section;
        if (rsec < orig_secs) {
            val ro:  u32 = img.relocations[ri].offset;
            val sub: u32 = subsection_for(sec_base, sec_cnt, p_start, rsec, ro);
            val sub_end: u32 = p_start[sub] + p_len[sub];
            val w:   usize = reloc_field_width(img.relocations[ri].kind);
            if (sub_end < img.sections[rsec].len && ro::usize + w > sub_end::usize) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret R.err[R.Void, str]("coff: relocation field straddles a weak-split boundary");
            }
            out.relocations[ri].section = sub;
            out.relocations[ri].offset  = ro - p_start[sub];
        }
        ri = ri + 1;
    }

    free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
    ret R.ok_void[str]();
}

fun free_weak_comdat_image(alloc: *A.Allocator, out: *of.ObjectImage, comdat: *bool) {
    if (out.sections != nil) {
        A.deallocate[of.Section](alloc, out.sections, out.section_cap::usize);
    }
    if (out.symbols != nil) {
        A.deallocate[of.Symbol](alloc, out.symbols, out.symbol_cap::usize);
    }
    if (out.relocations != nil) {
        A.deallocate[of.Relocation](alloc, out.relocations, out.reloc_cap::usize);
    }
    if (comdat != nil) {
        A.deallocate[bool](alloc, comdat, out.section_count::usize);
    }
}

val MACH_FRAMES_SECTION_NAME: str = ".mach.frames";
val MACH_FRAMES_VERSION: u32 = 1;

fun frames_record_symbol(img: *of.ObjectImage, fr: *of.FrameUnwind) u32 {
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *of.Symbol = ?img.symbols[i];
        if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) != 0
            && sym.section == fr.section && sym.offset == fr.offset) {
            ret i;
        }
        i = i + 1;
    }
    ret of.SYMBOL_NONE;
}

fun encode_frames_section(alloc: *A.Allocator, img: *of.ObjectImage,
                          out_bytes: **u8, out_len: *u32) R.Result[R.Void, str] {
    @out_bytes = nil;
    @out_len = 0;
    if (img.frame_count == 0) { ret R.ok_void[str](); }

    var total: usize = 8;
    var i: u32 = 0;
    for (i < img.frame_count) {
        val fr: *of.FrameUnwind = ?img.frames[i];
        if (fr.step_count > of.FRAME_STEP_CAP) {
            ret R.err[R.Void, str]("coff: frame record step count exceeds capacity");
        }
        val si: u32 = frames_record_symbol(img, fr);
        if (si == of.SYMBOL_NONE) {
            ret R.err[R.Void, str]("coff: frame record has no defined function symbol");
        }
        val nm: str = bin.resolve_name(img.interner, img.symbols[si].name);
        if (nm == nil) {
            ret R.err[R.Void, str]("coff: frame record symbol name did not resolve");
        }
        total = total + 8 + bin.align_up(str_len(nm), 4) + fr.step_count::usize * 16;
        i = i + 1;
    }

    val rb: R.Result[*u8, str] = A.zallocate[u8](alloc, total);
    if (R.is_err[*u8, str](rb)) { ret R.err[R.Void, str]("coff: frame section alloc failed"); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    bin.write_u32_le(buf, 0, MACH_FRAMES_VERSION);
    bin.write_u32_le(buf, 4, img.frame_count);
    var pos: usize = 8;
    i = 0;
    for (i < img.frame_count) {
        val fr: *of.FrameUnwind = ?img.frames[i];
        val si: u32 = frames_record_symbol(img, fr);
        val nm: str = bin.resolve_name(img.interner, img.symbols[si].name);
        val nlen: usize = str_len(nm);
        bin.write_u32_le(buf, pos, nlen::u32);
        bin.write_u32_le(buf, pos + 4, fr.step_count);
        pos = pos + 8;
        memory.raw_copy((buf::usize + pos)::ptr, nm::ptr, nlen);
        pos = pos + bin.align_up(nlen, 4);
        var k: u32 = 0;
        for (k < fr.step_count) {
            buf[pos] = fr.steps[k].kind;
            buf[pos + 1] = fr.steps[k].reg;
            bin.write_u16_le(buf, pos + 2, 0);
            bin.write_u32_le(buf, pos + 4, fr.steps[k].end_off);
            bin.write_u64_le(buf, pos + 8, fr.steps[k].value);
            pos = pos + 16;
            k = k + 1;
        }
        i = i + 1;
    }

    @out_bytes = buf;
    @out_len = total::u32;
    ret R.ok_void[str]();
}

fun coff_emit_object(tgt_isa: *of.ObjectTarget, img: *of.ObjectImage, destination: *publication.Destination) R.Result[R.Void, str] {
    if (tgt_isa == nil || img == nil || destination == nil) {
        ret R.err[R.Void, str]("coff: nil writer argument");
    }
    if (tgt_isa.arch_id != isa.ARCH_X86_64) {
        ret R.err[R.Void, str]("coff: only x86-64 is supported");
    }
    val alloc: *A.Allocator = img.alloc;

    var derived: of.ObjectImage;
    var comdat: *bool = nil;
    val br: R.Result[R.Void, str] = build_weak_comdat_image(alloc, img, ?derived, ?comdat);
    if (R.is_err[R.Void, str](br)) {
        free_weak_comdat_image(alloc, ?derived, comdat);
        ret br;
    }

    var fr_bytes: *u8 = nil;
    var fr_len: u32 = 0;
    var comdat2: *bool = comdat;
    val fe: R.Result[R.Void, str] = encode_frames_section(alloc, img, ?fr_bytes, ?fr_len);
    if (R.is_err[R.Void, str](fe)) {
        free_weak_comdat_image(alloc, ?derived, comdat);
        ret fe;
    }
    if (fr_len > 0) {
        val fnr: R.Result[intern.StrId, str] = intern.intern(img.interner, MACH_FRAMES_SECTION_NAME);
        if (R.is_err[intern.StrId, str](fnr)) {
            A.deallocate[u8](alloc, fr_bytes, fr_len::usize);
            free_weak_comdat_image(alloc, ?derived, comdat);
            ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](fnr));
        }
        val n0: u32 = derived.section_count;
        if (comdat != nil) {
            val gc: R.Result[*bool, str] = A.reallocate[bool](alloc, comdat, n0::usize, (n0 + 1)::usize);
            if (R.is_err[*bool, str](gc)) {
                A.deallocate[u8](alloc, fr_bytes, fr_len::usize);
                free_weak_comdat_image(alloc, ?derived, comdat);
                ret R.err[R.Void, str]("coff: frame comdat append failed");
            }
            comdat2 = R.unwrap_ok[*bool, str](gc);
            comdat2[n0] = false;
        }
        val gs: R.Result[*of.Section, str] =
            A.reallocate[of.Section](alloc, derived.sections, n0::usize, (n0 + 1)::usize);
        if (R.is_err[*of.Section, str](gs)) {
            A.deallocate[u8](alloc, fr_bytes, fr_len::usize);
            if (comdat2 != nil) { A.deallocate[bool](alloc, comdat2, (n0 + 1)::usize); }
            free_weak_comdat_image(alloc, ?derived, nil::*bool);
            ret R.err[R.Void, str]("coff: frame section append failed");
        }
        derived.sections = R.unwrap_ok[*of.Section, str](gs);
        derived.sections[n0].name  = R.unwrap_ok[intern.StrId, str](fnr);
        derived.sections[n0].kind  = of.SK_DEBUG;
        derived.sections[n0].bytes = fr_bytes;
        derived.sections[n0].len   = fr_len;
        derived.sections[n0].align = 4;
        derived.sections[n0].flags = 0;
        derived.section_count = n0 + 1;
        derived.section_cap = n0 + 1;
    }

    val sr: R.Result[R.Void, str] = coff_serialize_image(?derived, comdat2, destination);
    if (fr_bytes != nil) { A.deallocate[u8](alloc, fr_bytes, fr_len::usize); }
    free_weak_comdat_image(alloc, ?derived, comdat2);
    ret sr;
}

fun reloc_ovfl_message(itn: *intern.Interner, alloc: *A.Allocator, name_id: intern.StrId, count: u32) str {
    val fallback: str = "coff: section relocation count exceeds the COFF 0xFFFF limit";
    if (itn == nil) { ret fallback; }
    val nmo: O.Option[str] = intern.lookup(itn, name_id);
    if (!O.is_some[str](nmo)) { ret fallback; }
    val nm: str = O.unwrap[str](nmo);
    val res_msg: R.Result[str, str] = format.sprint(alloc, "coff: section '{}' has {} relocations; this exceeds the COFF limit of 65535", nm, count::usize);
    if (R.is_err[str, str](res_msg)) { ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);
    val ir: R.Result[intern.StrId, str] = intern.intern(itn, buf);
    A.deallocate[u8](alloc, buf, str_len(buf) + 1);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }
    val lo: O.Option[str] = intern.lookup(itn, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](lo)) { ret O.unwrap[str](lo); }
    ret fallback;
}

fun write_bigobj_class_id(buf: *u8, off: usize) {
    bin.write_u32_le(buf, off, 0xD1BAA1C7);
    bin.write_u16_le(buf, off + 4, 0xBAEE);
    bin.write_u16_le(buf, off + 6, 0x4D16);
    buf[off + 8]  = 0xB4;
    buf[off + 9]  = 0x5F;
    buf[off + 10] = 0x9E;
    buf[off + 11] = 0x0E;
    buf[off + 12] = 0x37;
    buf[off + 13] = 0xDB;
    buf[off + 14] = 0x40;
    buf[off + 15] = 0xC1;
}

fun bigobj_class_id_matches(buf: *u8, off: usize) bool {
    if (bin.read_u32_le(buf, off) != 0xD1BAA1C7)      { ret false; }
    if (bin.read_u16_le(buf, off + 4) != 0xBAEE)       { ret false; }
    if (bin.read_u16_le(buf, off + 6) != 0x4D16)       { ret false; }
    if (buf[off + 8]  != 0xB4)  { ret false; }
    if (buf[off + 9]  != 0x5F)  { ret false; }
    if (buf[off + 10] != 0x9E)  { ret false; }
    if (buf[off + 11] != 0x0E)  { ret false; }
    if (buf[off + 12] != 0x37)  { ret false; }
    if (buf[off + 13] != 0xDB)  { ret false; }
    if (buf[off + 14] != 0x40)  { ret false; }
    if (buf[off + 15] != 0xC1)  { ret false; }
    ret true;
}

fun sym_record_size(bigobj: bool) usize {
    if (bigobj) { ret BIGOBJ_SYMBOL_SIZE; }
    ret SYMBOL_SIZE;
}

fun write_sym_tail(buf: *u8, sym_off: usize, bigobj: bool, sec_num: i32, ty: u16, scl: u8, naux: u8) {
    if (bigobj) {
        bin.write_u32_le(buf, sym_off + 12, sec_num::u32);
        bin.write_u16_le(buf, sym_off + 16, ty);
        buf[sym_off + 18] = scl;
        buf[sym_off + 19] = naux;
        ret;
    }
    bin.write_u16_le(buf, sym_off + 12, sec_num::u16);
    bin.write_u16_le(buf, sym_off + 14, ty);
    buf[sym_off + 16] = scl;
    buf[sym_off + 17] = naux;
}

fun read_sym_section_number(buf: *u8, sym_off: usize, bigobj: bool) i32 {
    if (bigobj) { ret bin.read_u32_le(buf, sym_off + 12)::i32; }
    ret bin.read_u16_le(buf, sym_off + 12)::i16::i32;
}

fun read_sym_type(buf: *u8, sym_off: usize, bigobj: bool) u16 {
    if (bigobj) { ret bin.read_u16_le(buf, sym_off + 16); }
    ret bin.read_u16_le(buf, sym_off + 14);
}

fun sym_storage_class_off(sym_off: usize, bigobj: bool) usize {
    if (bigobj) { ret sym_off + 18; }
    ret sym_off + 16;
}

fun sym_naux_off(sym_off: usize, bigobj: bool) usize {
    if (bigobj) { ret sym_off + 19; }
    ret sym_off + 17;
}

fun preserve_weak_external_fallbacks(buf: *u8, symtab_off: usize,
                                     num_records: u32, bigobj: bool,
                                     rec_map: *i32,
                                     out: *of.ObjectImage) R.Result[R.Void, str] {
    val symbol_size: usize = sym_record_size(bigobj);
    var ri: u32 = 0;
    for (ri < num_records) {
        val so: usize = symtab_off + ri::usize * symbol_size;
        val aux: u8 = buf[sym_naux_off(so, bigobj)];
        val scl: u8 = buf[sym_storage_class_off(so, bigobj)];
        if (scl == IMAGE_SYM_CLASS_WEAK_EXTERNAL
            && read_sym_section_number(buf, so, bigobj) == IMAGE_SYM_UNDEFINED::i32) {
            if (aux == 0 || ri + 1 >= num_records) {
                ret R.err[R.Void, str]("coff: weak external has no aux record");
            }
            val ao: usize = so + symbol_size;
            val target_rec: u32 = bin.read_u32_le(buf, ao);
            val search: u32 = bin.read_u32_le(buf, ao + 4);
            if (target_rec >= num_records || rec_map[ri] < 0
                || rec_map[target_rec] < 0) {
                ret R.err[R.Void, str]("coff: weak external fallback target is invalid");
            }
            val public: *of.Symbol = ?out.symbols[rec_map[ri]::u32];
            val target: *of.Symbol = ?out.symbols[rec_map[target_rec]::u32];
            public.fallback = rec_map[target_rec]::u32;
            public.flags = public.flags | of.SYM_OBJ_FLAG_FALLBACK
                | (target.flags & (of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_OBJECT));
            if (search == IMAGE_WEAK_EXTERN_SEARCH_LIBRARY) {
                public.flags = public.flags | of.SYM_OBJ_FLAG_SEARCH;
            }
            if (search == IMAGE_WEAK_EXTERN_SEARCH_ALIAS) {
                public.flags = public.flags | of.SYM_OBJ_FLAG_ALIAS;
            }
        }
        ri = ri + 1 + aux::u32;
    }
    ret R.ok_void[str]();
}

fun coff_serialize_image(img: *of.ObjectImage, comdat: *bool, destination: *publication.Destination) R.Result[R.Void, str] {
    val alloc: *A.Allocator = img.alloc;

    val num_secs: u32 = img.section_count;
    val num_syms: u32 = img.symbol_count;
    var weak_aux_count: u32 = 0;
    var wi: u32 = 0;
    for (wi < num_syms) {
        if ((img.symbols[wi].flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            if (img.symbols[wi].fallback >= num_syms
                || img.symbols[wi].fallback == of.SYMBOL_NONE) {
                ret R.err[R.Void, str]("coff: weak external fallback index is out of range");
            }
            weak_aux_count = weak_aux_count + 1;
        }
        wi = wi + 1;
    }

    val vrk: R.Result[R.Void, str] = validate_reloc_kinds(img);
    if (R.is_err[R.Void, str](vrk)) { ret vrk; }

    val vr: R.Result[R.Void, str] = validate_reloc_ranges(img);
    if (R.is_err[R.Void, str](vr)) { ret vr; }

    val vrs: R.Result[R.Void, str] = validate_reloc_symbols(img);
    if (R.is_err[R.Void, str](vrs)) { ret vrs; }

    if (num_secs > 0x7FFFFFFF) { ret R.err[R.Void, str]("coff: section count exceeds the /bigobj 2^31 limit"); }
    val bigobj: bool = num_secs > 0xFFFF;
    val res_counts: R.Result[*u32, str] = bin.reloc_counts(alloc, img);
    if (R.is_err[*u32, str](res_counts)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](res_counts)); }
    val counts: *u32 = R.unwrap_ok[*u32, str](res_counts);
    var cs: u32 = 0;
    for (cs < num_secs) {
        if (counts[cs] > 0xFFFF) {
            val ovfl_msg: str = reloc_ovfl_message(img.interner, alloc, img.sections[cs].name, counts[cs]);
            A.deallocate[u32](alloc, counts, num_secs::usize);
            ret R.err[R.Void, str](ovfl_msg);
        }
        cs = cs + 1;
    }

    var header_size: usize = COFF_HEADER_SIZE;
    var symbol_size: usize = SYMBOL_SIZE;
    if (bigobj) { header_size = BIGOBJ_HEADER_SIZE; symbol_size = BIGOBJ_SYMBOL_SIZE; }
    val secdata_base: usize = header_size + num_secs::usize * SECTION_HEADER_SIZE;

    val res_doff: R.Result[*usize, str] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (R.is_err[*usize, str](res_doff)) {
        A.deallocate[u32](alloc, counts, num_secs::usize);
        ret R.err[R.Void, str]("coff: data offset table alloc failed");
    }
    var data_offsets: *usize = R.unwrap_ok[*usize, str](res_doff);

    val res_roff: R.Result[*usize, str] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (R.is_err[*usize, str](res_roff)) {
        A.deallocate[u32](alloc, counts, num_secs::usize);
        A.deallocate[usize](alloc, data_offsets, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("coff: reloc offset table alloc failed");
    }
    var reloc_offsets: *usize = R.unwrap_ok[*usize, str](res_roff);

    val res_snoff: R.Result[*u32, str] = A.zallocate[u32](alloc, (num_secs + 1)::usize);
    if (R.is_err[*u32, str](res_snoff)) {
        A.deallocate[u32](alloc, counts, num_secs::usize);
        A.deallocate[usize](alloc, data_offsets, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, reloc_offsets, (num_secs + 1)::usize);
        ret R.err[R.Void, str]("coff: section name offset table alloc failed");
    }
    var sec_name_offsets: *u32 = R.unwrap_ok[*u32, str](res_snoff);

    var cursor: usize = secdata_base;
    var s: u32 = 0;
    for (s < num_secs) {
        if (section_has_data(img.sections[s].kind) && img.sections[s].len > 0) {
            data_offsets[s] = cursor;
            cursor = cursor + img.sections[s].len::usize;
        } or {
            data_offsets[s] = 0;
        }
        s = s + 1;
    }
    s = 0;
    for (s < num_secs) {
        val rc: u32 = counts[s];
        if (rc > 0) {
            reloc_offsets[s] = cursor;
            cursor = cursor + rc::usize * RELOCATION_SIZE;
        } or {
            reloc_offsets[s] = 0;
        }
        s = s + 1;
    }

    val symtab_offset: usize = cursor;
    val total_sym_records: u32 = num_secs * 2 + num_syms + weak_aux_count;
    val symtab_size: usize = total_sym_records::usize * symbol_size;
    val strtab_offset: usize = symtab_offset + symtab_size;
    val strtab_sz: usize = strtab_size(img);
    val total_file_size: usize = strtab_offset + strtab_sz;

    var tile: bin.Layout;
    bin.layout_init(?tile);
    bin.layout_region(?tile, "coff header and section headers", 0, secdata_base);
    s = 0;
    for (s < num_secs) {
        if (data_offsets[s] != 0) {
            bin.layout_region(?tile, "section data", data_offsets[s], img.sections[s].len::usize);
        }
        s = s + 1;
    }
    s = 0;
    for (s < num_secs) {
        if (reloc_offsets[s] != 0) {
            bin.layout_region(?tile, "relocations", reloc_offsets[s],
                              counts[s]::usize * RELOCATION_SIZE);
        }
        s = s + 1;
    }
    bin.layout_region(?tile, "symbol table", symtab_offset, symtab_size);
    bin.layout_region(?tile, "string table", strtab_offset, strtab_sz);
    val tiled: R.Result[R.Void, str] = bin.layout_seal(?tile, alloc, "coff", total_file_size);
    if (R.is_err[R.Void, str](tiled)) {
        A.deallocate[u32](alloc, counts, num_secs::usize);
        A.deallocate[usize](alloc, data_offsets, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, reloc_offsets, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, sec_name_offsets, (num_secs + 1)::usize);
        ret tiled;
    }

    var sym_remap: *u32 = nil;
    if (num_syms > 0) {
        val res_remap: R.Result[*u32, str] = A.zallocate[u32](alloc, num_syms::usize);
        if (R.is_err[*u32, str](res_remap)) {
            A.deallocate[u32](alloc, counts, num_secs::usize);
            A.deallocate[usize](alloc, data_offsets, (num_secs + 1)::usize);
            A.deallocate[usize](alloc, reloc_offsets, (num_secs + 1)::usize);
            A.deallocate[u32](alloc, sec_name_offsets, (num_secs + 1)::usize);
            ret R.err[R.Void, str]("coff: symbol remap alloc failed");
        }
        sym_remap = R.unwrap_ok[*u32, str](res_remap);
    }
    var i: u32 = 0;
    var raw_sym: u32 = num_secs * 2;
    for (i < num_syms) {
        sym_remap[i] = raw_sym;
        raw_sym = raw_sym + 1;
        if ((img.symbols[i].flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            raw_sym = raw_sym + 1;
        }
        i = i + 1;
    }

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_file_size);
    if (R.is_err[*u8, str](res_buf)) {
        A.deallocate[u32](alloc, counts, num_secs::usize);
        A.deallocate[usize](alloc, data_offsets, (num_secs + 1)::usize);
        A.deallocate[usize](alloc, reloc_offsets, (num_secs + 1)::usize);
        A.deallocate[u32](alloc, sec_name_offsets, (num_secs + 1)::usize);
        if (sym_remap != nil) { A.deallocate[u32](alloc, sym_remap, num_syms::usize); }
        ret R.err[R.Void, str]("coff: output buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    if (bigobj) {
        bin.write_u16_le(buf, 0, IMAGE_FILE_MACHINE_UNKNOWN);
        bin.write_u16_le(buf, 2, BIGOBJ_SIG2);
        bin.write_u16_le(buf, 4, BIGOBJ_MIN_VERSION);
        bin.write_u16_le(buf, 6, IMAGE_FILE_MACHINE_AMD64);
        bin.write_u32_le(buf, 8, 0);
        write_bigobj_class_id(buf, 12);
        bin.write_u32_le(buf, 28, (total_file_size - header_size)::u32);
        bin.write_u32_le(buf, 32, 0);
        bin.write_u32_le(buf, 36, 0);
        bin.write_u32_le(buf, 40, 0);
        bin.write_u32_le(buf, 44, num_secs);
        bin.write_u32_le(buf, 48, symtab_offset::u32);
        bin.write_u32_le(buf, 52, total_sym_records);
    } or {
        bin.write_u16_le(buf, 0, IMAGE_FILE_MACHINE_AMD64);
        bin.write_u16_le(buf, 2, num_secs::u16);
        bin.write_u32_le(buf, 4, 0);
        bin.write_u32_le(buf, 8, symtab_offset::u32);
        bin.write_u32_le(buf, 12, total_sym_records);
        bin.write_u16_le(buf, 16, 0);
        bin.write_u16_le(buf, 18, 0);
    }

    var str_pos: usize = 4;

    s = 0;
    for (s < num_secs) {
        val sh: usize = header_size + s::usize * SECTION_HEADER_SIZE;
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (name_in_strtab(sn)) {
            sec_name_offsets[s] = str_pos::u32;
            buf[sh] = '/';
            write_decimal(buf, sh + 1, 7, str_pos::u32);
            str_pos = str_pos + bin.write_str(buf, strtab_offset + str_pos, sn);
        } or {
            sec_name_offsets[s] = 0;
            write_inline_name(buf, sh, sn);
        }

        val seclen: u32 = img.sections[s].len;
        bin.write_u32_le(buf, sh + 8, 0);
        bin.write_u32_le(buf, sh + 12, 0);
        bin.write_u32_le(buf, sh + 16, seclen);
        if (section_has_data(img.sections[s].kind) && seclen > 0) {
            bin.write_u32_le(buf, sh + 20, data_offsets[s]::u32);
        } or {
            bin.write_u32_le(buf, sh + 20, 0);
        }
        val rc: u32 = counts[s];
        if (rc > 0) {
            bin.write_u32_le(buf, sh + 24, reloc_offsets[s]::u32);
        } or {
            bin.write_u32_le(buf, sh + 24, 0);
        }
        bin.write_u32_le(buf, sh + 28, 0);
        bin.write_u16_le(buf, sh + 32, rc::u16);
        bin.write_u16_le(buf, sh + 34, 0);
        var chars: u32 = section_characteristics_for(img.sections[s].kind)
                       | align_characteristic(img.sections[s].align);
        if (comdat != nil && comdat[s]) { chars = chars | IMAGE_SCN_LNK_COMDAT; }
        bin.write_u32_le(buf, sh + 36, chars);
        s = s + 1;
    }

    s = 0;
    for (s < num_secs) {
        if (section_has_data(img.sections[s].kind) && img.sections[s].len > 0
            && img.sections[s].bytes != nil) {
            memory.raw_copy((buf::usize + data_offsets[s])::ptr,
                         img.sections[s].bytes::ptr, img.sections[s].len::usize);
        }
        s = s + 1;
    }

    var ridx: u32 = 0;
    for (ridx < img.reloc_count) {
        val rsec: u32 = img.relocations[ridx].section;
        val rk: of.RelocKind = img.relocations[ridx].kind;
        var eff: i64 = img.relocations[ridx].addend;
        if (rk == of.RK_PC32 || rk == of.RK_PLT32) { eff = eff + 4; }
        if (eff != 0) {
            val fld: usize = data_offsets[rsec] + img.relocations[ridx].offset::usize;
            if (reloc_field_width(rk) == 8) {
                bin.write_u64_le(buf, fld, bin.read_u64_le(buf, fld) + eff::u64);
            } or {
                bin.write_u32_le(buf, fld, bin.read_u32_le(buf, fld) + (eff::u64)::u32);
            }
        }
        ridx = ridx + 1;
    }

    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        val rsec: u32 = img.relocations[ri].section;
        val ro: usize = reloc_offsets[rsec];
        bin.write_u32_le(buf, ro, img.relocations[ri].offset);
        val rsi: u32 = R.unwrap_ok[u32, str](reloc_sym_index(img, ?img.relocations[ri]));
        bin.write_u32_le(buf, ro + 4, sym_remap[rsi]);
        bin.write_u16_le(buf, ro + 8, R.unwrap_ok[u16, str](reloc_type_for(img.interner, alloc, img.relocations[ri].kind)));
        reloc_offsets[rsec] = ro + RELOCATION_SIZE;
        ri = ri + 1;
    }

    var sym_off: usize = symtab_offset;
    s = 0;
    for (s < num_secs) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (name_in_strtab(sn)) {
            bin.write_u32_le(buf, sym_off, 0);
            bin.write_u32_le(buf, sym_off + 4, sec_name_offsets[s]);
        } or {
            write_inline_name(buf, sym_off, sn);
        }
        bin.write_u32_le(buf, sym_off + 8, 0);
        write_sym_tail(buf, sym_off, bigobj, (s + 1)::i32, 0, IMAGE_SYM_CLASS_STATIC, 1);
        sym_off = sym_off + symbol_size;

        bin.write_u32_le(buf, sym_off, img.sections[s].len);
        bin.write_u16_le(buf, sym_off + 4, counts[s]::u16);
        if (comdat != nil && comdat[s]) {
            buf[sym_off + 14] = IMAGE_COMDAT_SELECT_ANY;
        }
        sym_off = sym_off + symbol_size;
        s = s + 1;
    }

    var symi: u32 = 0;
    for (symi < num_syms) {
        val name: str = bin.resolve_name(img.interner, img.symbols[symi].name);
        if (name_in_strtab(name)) {
            bin.write_u32_le(buf, sym_off, 0);
            bin.write_u32_le(buf, sym_off + 4, str_pos::u32);
            str_pos = str_pos + bin.write_str(buf, strtab_offset + str_pos, name);
        } or {
            write_inline_name(buf, sym_off, name);
        }
        bin.write_u32_le(buf, sym_off + 8, img.symbols[symi].offset);

        var sec_num: i32 = IMAGE_SYM_UNDEFINED::i32;
        var sym_ty: u16 = 0;
        if (img.symbols[symi].section != of.SECTION_EXTERNAL
            && img.symbols[symi].section < num_secs) {
            sec_num = (img.symbols[symi].section + 1)::i32;
            sym_ty = symbol_type_for(img.sections[img.symbols[symi].section].kind);
        }
        if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_FUNCTION) != 0) {
            sym_ty = IMAGE_SYM_DTYPE_FUNCTION;
        }

        var scl: u8 = IMAGE_SYM_CLASS_STATIC;
        if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_GLOBAL) != 0
            || (img.symbols[symi].flags & of.SYM_OBJ_FLAG_EXTERN) != 0) {
            scl = IMAGE_SYM_CLASS_EXTERNAL;
        }
        var naux: u8 = 0;
        if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            scl = IMAGE_SYM_CLASS_WEAK_EXTERNAL;
            naux = 1;
        }
        write_sym_tail(buf, sym_off, bigobj, sec_num, sym_ty, scl, naux);
        sym_off = sym_off + symbol_size;
        if (naux == 1) {
            bin.write_u32_le(buf, sym_off, sym_remap[img.symbols[symi].fallback]);
            var search: u32 = IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY;
            if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_SEARCH) != 0) {
                search = IMAGE_WEAK_EXTERN_SEARCH_LIBRARY;
            }
            if ((img.symbols[symi].flags & of.SYM_OBJ_FLAG_ALIAS) != 0) {
                search = IMAGE_WEAK_EXTERN_SEARCH_ALIAS;
            }
            bin.write_u32_le(buf, sym_off + 4, search);
            sym_off = sym_off + symbol_size;
        }
        symi = symi + 1;
    }

    bin.write_u32_le(buf, strtab_offset, str_pos::u32);

    if (sym_remap != nil) { A.deallocate[u32](alloc, sym_remap, num_syms::usize); }
    A.deallocate[u32](alloc, counts, num_secs::usize);
    A.deallocate[usize](alloc, data_offsets, (num_secs + 1)::usize);
    A.deallocate[usize](alloc, reloc_offsets, (num_secs + 1)::usize);
    A.deallocate[u32](alloc, sec_name_offsets, (num_secs + 1)::usize);

    val pr: R.Result[R.Void, str] = publication.bytes_at(img.interner, img.alloc, ?destination.claim, destination.path, buf, total_file_size, 0o644, publication.REPLACE, "coff: cannot publish", "coff: could not publish output file", nil);
    A.deallocate[u8](alloc, buf, total_file_size);
    ret pr;
}

fun framed_name(buf: *u8, off: usize, scratch: *u8) str {
    memory.raw_copy(scratch::ptr, (buf::usize + off)::ptr, 8);
    scratch[8] = 0;
    ret (scratch::usize)::str;
}

fun read_section_name(buf: *u8, buf_size: usize, sh: usize, strtab_base: usize, scratch: *u8) R.Result[str, str] {
    if (buf[sh] == '/') {
        var off: u32 = 0;
        var i: usize = 1;
        for (i < 8) {
            val c: u8 = buf[sh + i];
            if (c >= '0' && c <= '9') { off = off * 10 + (c - '0')::u32; }
            i = i + 1;
        }
        ret bin.cstr_at(buf, buf_size, strtab_base + off::usize);
    }
    ret R.ok[str, str](framed_name(buf, sh, scratch));
}

fun read_symbol_name(buf: *u8, buf_size: usize, so: usize, strtab_base: usize, scratch: *u8) R.Result[str, str] {
    if (bin.read_u32_le(buf, so) == 0) {
        val off: u32 = bin.read_u32_le(buf, so + 4);
        ret bin.cstr_at(buf, buf_size, strtab_base + off::usize);
    }
    ret R.ok[str, str](framed_name(buf, so, scratch));
}

fun comdat_dedups_for_section(buf: *u8, symtab_off: usize, num_records: u32, sec_num: u32, bigobj: bool) bool {
    val rsize: usize = sym_record_size(bigobj);
    var ri: u32 = 0;
    for (ri < num_records) {
        val so: usize = symtab_off + ri::usize * rsize;
        val aux: u8 = buf[sym_naux_off(so, bigobj)];
        if (buf[sym_storage_class_off(so, bigobj)] == IMAGE_SYM_CLASS_STATIC && aux >= 1 && (ri + 1) < num_records
            && read_sym_section_number(buf, so, bigobj) == sec_num::i32 && bin.read_u32_le(buf, so + 8) == 0) {
            val ax: usize = so + rsize;
            ret comdat_selection_dedups(buf[ax + 14]);
        }
        ri = ri + 1 + aux::u32;
    }
    ret false;
}

fun coff_parse_import_record(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8,
                             buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (buf_size < IMPORT_OBJECT_HEADER_SIZE) {
        ret R.err[R.Void, str]("coff: import record too small");
    }
    if (itn == nil) { ret R.err[R.Void, str]("coff: no interner for parse"); }
    if (bin.read_u16_le(buf, 6) != IMAGE_FILE_MACHINE_AMD64) {
        ret R.err[R.Void, str]("coff: not an x86-64 import record");
    }

    val data_size: usize = bin.read_u32_le(buf, 12)::usize;
    val vr: R.Result[R.Void, str] = bin.require_region(buf_size, IMPORT_OBJECT_HEADER_SIZE,
        data_size, "coff: import record name data out of bounds");
    if (R.is_err[R.Void, str](vr)) { ret vr; }

    val hint_ord: u16 = bin.read_u16_le(buf, 16);
    val flags:    u16 = bin.read_u16_le(buf, 18);
    val import_type: u16 = flags & 0x3;
    val name_type:   u16 = (flags >> 2) & 0x7;
    if (import_type > IMPORT_OBJECT_TYPE_CONST) {
        ret R.err[R.Void, str]("coff: import record has an invalid import type");
    }
    if (name_type > IMPORT_OBJECT_NAME_EXPORTAS) {
        ret R.err[R.Void, str]("coff: import record has an invalid name type");
    }
    if ((flags & 0xFFE0) != 0) {
        ret R.err[R.Void, str]("coff: import record has nonzero reserved flags");
    }

    val base: usize = IMPORT_OBJECT_HEADER_SIZE;
    val limit: usize = base + data_size;
    var sym_end: usize = base;
    for (sym_end < limit && buf[sym_end] != 0) { sym_end = sym_end + 1; }
    if (sym_end >= limit) { ret R.err[R.Void, str]("coff: import record symbol name is unterminated"); }
    val dll_start: usize = sym_end + 1;
    var dll_end: usize = dll_start;
    for (dll_end < limit && buf[dll_end] != 0) { dll_end = dll_end + 1; }
    if (dll_end >= limit) { ret R.err[R.Void, str]("coff: import record library name is unterminated"); }
    if (sym_end == base)      { ret R.err[R.Void, str]("coff: import record has an empty symbol name"); }
    if (dll_end == dll_start) { ret R.err[R.Void, str]("coff: import record has an empty library name"); }

    val sym_r: R.Result[intern.StrId, str] = intern.intern(itn, (?buf[base])::str);
    if (R.is_err[intern.StrId, str](sym_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](sym_r)); }
    val dll_r: R.Result[intern.StrId, str] = intern.intern(itn, (?buf[dll_start])::str);
    if (R.is_err[intern.StrId, str](dll_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](dll_r)); }

    var import_name_r: R.Result[intern.StrId, str] = sym_r;
    if (name_type == IMPORT_OBJECT_NAME_NOPREFIX || name_type == IMPORT_OBJECT_NAME_UNDECORATE) {
        var name_start: usize = base;
        if (buf[name_start] == '?'::u8 || buf[name_start] == '@'::u8 || buf[name_start] == '_'::u8) {
            name_start = name_start + 1;
        }
        var name_end: usize = sym_end;
        if (name_type == IMPORT_OBJECT_NAME_UNDECORATE) {
            name_end = name_start;
            for (name_end < sym_end && buf[name_end] != '@'::u8) { name_end = name_end + 1; }
        }
        if (name_end == name_start) {
            ret R.err[R.Void, str]("coff: import record resolves to an empty export name");
        }
        import_name_r = intern.intern_bytes(itn, (?buf[name_start])::str, name_end - name_start);
    }
    or (name_type == IMPORT_OBJECT_NAME_EXPORTAS) {
        val export_start: usize = dll_end + 1;
        var export_end: usize = export_start;
        for (export_end < limit && buf[export_end] != 0) { export_end = export_end + 1; }
        if (export_end >= limit) {
            ret R.err[R.Void, str]("coff: import record export name is unterminated");
        }
        if (export_end == export_start) {
            ret R.err[R.Void, str]("coff: import record has an empty export name");
        }
        import_name_r = intern.intern(itn, (?buf[export_start])::str);
    }
    if (R.is_err[intern.StrId, str](import_name_r)) {
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](import_name_r));
    }

    val ir: R.Result[*of.ImportDecl, str] = A.zallocate[of.ImportDecl](alloc, 1::usize);
    if (R.is_err[*of.ImportDecl, str](ir)) { ret R.err[R.Void, str](R.unwrap_err[*of.ImportDecl, str](ir)); }

    out.imports      = R.unwrap_ok[*of.ImportDecl, str](ir);
    out.import_count = 1;
    out.import_cap   = 1;

    out.imports[0].symbol      = R.unwrap_ok[intern.StrId, str](sym_r);
    out.imports[0].import_name = R.unwrap_ok[intern.StrId, str](import_name_r);
    out.imports[0].library     = R.unwrap_ok[intern.StrId, str](dll_r);
    out.imports[0].by_name     = name_type != IMPORT_OBJECT_ORDINAL;
    out.imports[0].ordinal     = hint_ord;
    out.imports[0].is_code     = import_type == IMPORT_OBJECT_TYPE_CODE;
    ret R.ok_void[str]();
}

fun coff_is_idata_bookkeeping(buf: *u8, secthdr_base: usize, num_secs: u32) bool {
    if (num_secs == 0) { ret false; }
    var i: u32 = 0;
    for (i < num_secs) {
        val off: usize = secthdr_base + i::usize * SECTION_HEADER_SIZE;
        if (buf[off]     != 0x2E) { ret false; }
        if (buf[off + 1] != 0x69) { ret false; }
        if (buf[off + 2] != 0x64) { ret false; }
        if (buf[off + 3] != 0x61) { ret false; }
        if (buf[off + 4] != 0x74) { ret false; }
        if (buf[off + 5] != 0x61) { ret false; }
        if (buf[off + 6] != 0x24) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun coff_parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < 4) {
        ret R.err[R.Void, str]("coff: object too small");
    }
    if (alloc == nil) { ret R.err[R.Void, str]("coff: no allocator for parse"); }
    if (itn == nil)   { ret R.err[R.Void, str]("coff: no interner for parse"); }

    var parsed: of.ObjectImage = of.object_image_init(alloc, itn, intern.STR_NIL);
    val built: R.Result[R.Void, str] = coff_parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (R.is_err[R.Void, str](built)) {
        val reason: str = R.unwrap_err[R.Void, str](built);
        of.object_image_dnit(?parsed);
        ret R.err[R.Void, str](reason);
    }
    val valid: R.Result[R.Void, str] = of.validate_owned_object_or_dnit(?parsed);
    if (R.is_err[R.Void, str](valid)) { ret valid; }
    @out = parsed;
    ret R.ok_void[str]();
}

fun coff_parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out != nil) { @out = of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < 4) {
        ret R.err[R.Void, str]("coff: object too small");
    }
    val sig1: u16 = bin.read_u16_le(buf, 0);
    val sig2: u16 = bin.read_u16_le(buf, 2);
    val anon: bool = sig1 == IMAGE_FILE_MACHINE_UNKNOWN && sig2 == BIGOBJ_SIG2;

    val bigobj: bool = anon && buf_size >= BIGOBJ_HEADER_SIZE
        && bin.read_u16_le(buf, 4) >= BIGOBJ_MIN_VERSION
        && bigobj_class_id_matches(buf, 12);
    if (anon && !bigobj) {
        ret coff_parse_import_record(alloc, itn, buf, buf_size, out);
    }

    var num_secs:     u32   = 0;
    var symtab_off:   usize = 0;
    var num_records:  u32   = 0;
    var secthdr_base: usize = 0;
    if (bigobj) {
        if (buf_size < BIGOBJ_HEADER_SIZE) { ret R.err[R.Void, str]("coff: bigobj object too small"); }
        if (bin.read_u16_le(buf, 4) < BIGOBJ_MIN_VERSION) {
            ret R.err[R.Void, str]("coff: bigobj header version below the minimum");
        }
        if (bin.read_u16_le(buf, 6) != IMAGE_FILE_MACHINE_AMD64) {
            ret R.err[R.Void, str]("coff: not an x86-64 object");
        }
        if (!bigobj_class_id_matches(buf, 12)) {
            ret R.err[R.Void, str]("coff: bigobj header has an unrecognized ClassID");
        }
        num_secs     = bin.read_u32_le(buf, 44);
        symtab_off   = bin.read_u32_le(buf, 48)::usize;
        num_records  = bin.read_u32_le(buf, 52);
        secthdr_base = BIGOBJ_HEADER_SIZE;
    } or {
        if (buf_size < COFF_HEADER_SIZE) { ret R.err[R.Void, str]("coff: object too small"); }
        if (sig1 != IMAGE_FILE_MACHINE_AMD64) { ret R.err[R.Void, str]("coff: not an x86-64 object"); }
        num_secs    = bin.read_u16_le(buf, 2)::u32;
        symtab_off  = bin.read_u32_le(buf, 8)::usize;
        num_records = bin.read_u32_le(buf, 12);
        val opt_size: u16 = bin.read_u16_le(buf, 16);
        secthdr_base = COFF_HEADER_SIZE + opt_size::usize;
    }
    if (itn == nil) { ret R.err[R.Void, str]("coff: no interner for parse"); }
    out.interner = itn;

    val symbol_size: usize = sym_record_size(bigobj);

    val vsh: R.Result[R.Void, str] = bin.require_region(buf_size, secthdr_base,
        num_secs::usize * SECTION_HEADER_SIZE, "coff: section header table out of bounds");
    if (R.is_err[R.Void, str](vsh)) { ret vsh; }
    val vsy: R.Result[R.Void, str] = bin.require_region(buf_size, symtab_off,
        num_records::usize * symbol_size, "coff: symbol table out of bounds");
    if (R.is_err[R.Void, str](vsy)) { ret vsy; }
    val strtab_base:  usize = symtab_off + num_records::usize * symbol_size;

    if (coff_is_idata_bookkeeping(buf, secthdr_base, num_secs)) {
        ret R.ok_void[str]();
    }

    var rel_total: layout.CheckedCount[of.Relocation] = layout.count[of.Relocation](0::usize);
    var s: u32 = 0;
    for (s < num_secs) {
        val sh: usize = secthdr_base + s::usize * SECTION_HEADER_SIZE;
        val term: layout.CheckedCount[of.Relocation] =
            layout.count[of.Relocation](bin.read_u16_le(buf, sh + 32)::usize);
        val added: R.Result[layout.CheckedCount[of.Relocation], layout.CheckCause] =
            layout.count_add[of.Relocation](rel_total, term);
        if (R.is_err[layout.CheckedCount[of.Relocation], layout.CheckCause](added)) {
            ret R.err[R.Void, str]("coff: relocation count exceeds the u32 limit");
        }
        rel_total = R.unwrap_ok[layout.CheckedCount[of.Relocation], layout.CheckCause](added);
        s = s + 1;
    }
    val rel_n_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(rel_total.value);
    if (R.is_err[u32, layout.CheckCause](rel_n_fits)) {
        ret R.err[R.Void, str]("coff: relocation count exceeds the u32 limit");
    }
    val rel_n: u32 = R.unwrap_ok[u32, layout.CheckCause](rel_n_fits);
    var sym_n: u32 = 0;
    var ri: u32 = 0;
    for (ri < num_records) {
        val so: usize = symtab_off + ri::usize * symbol_size;
        val aux: u8 = buf[sym_naux_off(so, bigobj)];
        sym_n = sym_n + 1;
        ri = ri + 1 + aux::u32;
    }

    if (num_secs > 0) {
        val rsec: R.Result[*of.Section, str] = A.zallocate[of.Section](alloc, num_secs::usize);
        if (R.is_err[*of.Section, str](rsec)) { ret R.err[R.Void, str]("coff: section array alloc failed"); }
        out.sections = R.unwrap_ok[*of.Section, str](rsec);
        out.section_cap = num_secs;
    }
    if (sym_n > 0) {
        val rsym: R.Result[*of.Symbol, str] = A.zallocate[of.Symbol](alloc, sym_n::usize);
        if (R.is_err[*of.Symbol, str](rsym)) { ret R.err[R.Void, str]("coff: symbol array alloc failed"); }
        out.symbols = R.unwrap_ok[*of.Symbol, str](rsym);
        out.symbol_cap = sym_n;
    }
    if (rel_n > 0) {
        val rrel: R.Result[*of.Relocation, str] = A.zallocate[of.Relocation](alloc, rel_n::usize);
        if (R.is_err[*of.Relocation, str](rrel)) { ret R.err[R.Void, str]("coff: reloc array alloc failed"); }
        out.relocations = R.unwrap_ok[*of.Relocation, str](rrel);
        out.reloc_cap = rel_n;
    }

    out.section_count = num_secs;
    out.symbol_count  = sym_n;
    out.reloc_count   = rel_n;

    val res_map: R.Result[*i32, str] = A.zallocate[i32](alloc, (num_records + 1)::usize);
    if (R.is_err[*i32, str](res_map)) { ret R.err[R.Void, str]("coff: symbol map alloc failed"); }
    var rec_map: *i32 = R.unwrap_ok[*i32, str](res_map);

    var name_scratch: [9]u8;

    s = 0;
    for (s < num_secs) {
        val sh: usize = secthdr_base + s::usize * SECTION_HEADER_SIZE;
        val rsn: R.Result[str, str] = read_section_name(buf, buf_size, sh, strtab_base, ?name_scratch[0]);
        if (R.is_err[str, str](rsn)) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret R.err[R.Void, str](R.unwrap_err[str, str](rsn));
        }
        val sname: str = R.unwrap_ok[str, str](rsn);
        val rin: R.Result[intern.StrId, str] = intern.intern(itn, sname);
        if (R.is_err[intern.StrId, str](rin)) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rin));
        }

        val chars: u32 = bin.read_u32_le(buf, sh + 36);
        var kind: of.SectionKind = of.SK_DATA;
        if (str_equals(sname, ".pdata"))                     { kind = of.SK_EXCEPTION; }
        or ((chars & IMAGE_SCN_CNT_CODE) != 0)               { kind = of.SK_TEXT; }
        or ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0) { kind = of.SK_BSS; }
        or ((chars & IMAGE_SCN_MEM_DISCARDABLE) != 0)        { kind = of.SK_DEBUG; }
        or ((chars & IMAGE_SCN_MEM_WRITE) == 0) {
            if (str_equals(sname, ".data.rel.ro")) { kind = of.SK_RELRO; }
            or                                     { kind = of.SK_RODATA; }
        }

        out.sections[s].name  = R.unwrap_ok[intern.StrId, str](rin);
        out.sections[s].kind  = kind;
        out.sections[s].len   = bin.read_u32_le(buf, sh + 16);
        out.sections[s].align = align_from_characteristics(chars);
        out.sections[s].bytes = nil;

        val raw_ptr: u32 = bin.read_u32_le(buf, sh + 20);
        if ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) == 0 && raw_ptr != 0
            && out.sections[s].len > 0) {
            val sz: usize = out.sections[s].len::usize;
            if (!bin.region_ok(buf_size, raw_ptr::usize, sz)) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret R.err[R.Void, str]("coff: section raw data out of bounds");
            }
            val rb: R.Result[*u8, str] = A.allocate[u8](alloc, sz);
            if (R.is_err[*u8, str](rb)) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret R.err[R.Void, str]("coff: section bytes alloc failed");
            }
            out.sections[s].bytes = R.unwrap_ok[*u8, str](rb);
            memory.raw_copy(out.sections[s].bytes::ptr, (buf::usize + raw_ptr::usize)::ptr, sz);
        }
        s = s + 1;
    }

    var sym_i: u32 = 0;
    ri = 0;
    for (ri < num_records) {
        rec_map[ri] = -1;
        val so: usize = symtab_off + ri::usize * symbol_size;
        val aux: u8 = buf[sym_naux_off(so, bigobj)];

        val rsyn: R.Result[str, str] = read_symbol_name(buf, buf_size, so, strtab_base, ?name_scratch[0]);
        if (R.is_err[str, str](rsyn)) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret R.err[R.Void, str](R.unwrap_err[str, str](rsyn));
        }
        val rin: R.Result[intern.StrId, str] = intern.intern(itn, R.unwrap_ok[str, str](rsyn));
        if (R.is_err[intern.StrId, str](rin)) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](rin));
        }

        val idx: u32 = sym_i;
        rec_map[ri] = idx::i32;
        out.symbols[idx].name = R.unwrap_ok[intern.StrId, str](rin);
        out.symbols[idx].offset = bin.read_u32_le(buf, so + 8);
        out.symbols[idx].size = 0;

        val sec_num: i32 = read_sym_section_number(buf, so, bigobj);
        val sym_ty:  u16 = read_sym_type(buf, so, bigobj);
        val scl:     u8  = buf[sym_storage_class_off(so, bigobj)];

        var flags: u32 = 0;
        if (scl == IMAGE_SYM_CLASS_EXTERNAL || scl == IMAGE_SYM_CLASS_WEAK_EXTERNAL) {
            flags = flags | of.SYM_OBJ_FLAG_GLOBAL;
        }
        if (scl == IMAGE_SYM_CLASS_WEAK_EXTERNAL) { flags = flags | of.SYM_OBJ_FLAG_WEAK; }
        if (sym_ty == IMAGE_SYM_DTYPE_FUNCTION)   { flags = flags | of.SYM_OBJ_FLAG_FUNCTION; }

        if (sec_num <= IMAGE_SYM_UNDEFINED::i32) {
            flags = flags | of.SYM_OBJ_FLAG_EXTERN;
            out.symbols[idx].section = of.SECTION_EXTERNAL;
        } or ((sec_num::u32 - 1) < num_secs) {
            out.symbols[idx].section = sec_num::u32 - 1;
            flags = flags | of.SYM_OBJ_FLAG_SIZE_UNKNOWN;
        } or {
            out.symbols[idx].section = of.SECTION_EXTERNAL;
        }

        if ((flags & of.SYM_OBJ_FLAG_GLOBAL) != 0
            && out.symbols[idx].section != of.SECTION_EXTERNAL) {
            val dsh: usize = secthdr_base + out.symbols[idx].section::usize * SECTION_HEADER_SIZE;
            if ((bin.read_u32_le(buf, dsh + 36) & IMAGE_SCN_LNK_COMDAT) != 0
                && comdat_dedups_for_section(buf, symtab_off, num_records,
                                                 out.symbols[idx].section + 1, bigobj)) {
                flags = flags | of.SYM_OBJ_FLAG_WEAK;
            }
        }
        out.symbols[idx].flags = flags;
        sym_i = sym_i + 1;

        var a: u32 = 0;
        for (a < aux::u32) {
            if ((ri + 1 + a) < num_records) { rec_map[ri + 1 + a] = idx::i32; }
            a = a + 1;
        }
        ri = ri + 1 + aux::u32;
    }

    val wa: R.Result[R.Void, str] =
        preserve_weak_external_fallbacks(buf, symtab_off, num_records,
                                         bigobj, rec_map, out);
    if (R.is_err[R.Void, str](wa)) {
        A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
        ret wa;
    }

    var rel_i: u32 = 0;
    s = 0;
    for (s < num_secs) {
        val sh: usize = secthdr_base + s::usize * SECTION_HEADER_SIZE;
        val rptr: usize = bin.read_u32_le(buf, sh + 24)::usize;
        val rcount: u32 = bin.read_u16_le(buf, sh + 32)::u32;
        if (rcount > 0 && !bin.region_ok(buf_size, rptr, rcount::usize * RELOCATION_SIZE)) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret R.err[R.Void, str]("coff: relocation array out of bounds");
        }
        var k: u32 = 0;
        for (k < rcount) {
            val ro: usize = rptr + k::usize * RELOCATION_SIZE;
            val idx: u32 = rel_i;
            val r_type: u16 = bin.read_u16_le(buf, ro + 8);
            val r_off:  u32 = bin.read_u32_le(buf, ro);
            out.relocations[idx].section = s;
            out.relocations[idx].offset = r_off;
            val rk: R.Result[of.RelocKind, str] = reloc_kind_for(itn, alloc, r_type);
            if (R.is_err[of.RelocKind, str](rk)) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret R.err[R.Void, str](R.unwrap_err[of.RelocKind, str](rk));
            }
            out.relocations[idx].kind = R.unwrap_ok[of.RelocKind, str](rk);
            out.relocations[idx].addend = read_inplace_addend(?out.sections[s], r_type, r_off);

            val rec: u32 = bin.read_u32_le(buf, ro + 4);
            if (rec < num_records && rec_map[rec] >= 0) {
                out.relocations[idx].sym = rec_map[rec]::u32;
            } or {
                out.relocations[idx].sym = of.SYMBOL_NONE;
            }
            rel_i = rel_i + 1;
            k = k + 1;
        }
        s = s + 1;
    }

    val inf: R.Result[R.Void, str] = infer_extern_function_flags_from_calls(out);

    A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
    if (R.is_err[R.Void, str](inf)) { ret inf; }

    val dfr: R.Result[R.Void, str] = decode_frames_section(alloc, itn, out);
    if (R.is_err[R.Void, str](dfr)) { ret dfr; }
    ret R.ok_void[str]();
}

fun decode_frames_section(alloc: *A.Allocator, itn: *intern.Interner,
                          out: *of.ObjectImage) R.Result[R.Void, str] {
    val fname_r: R.Result[intern.StrId, str] = intern.intern(itn, MACH_FRAMES_SECTION_NAME);
    if (R.is_err[intern.StrId, str](fname_r)) {
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](fname_r));
    }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](fname_r);

    var fs_i: u32 = 0xFFFFFFFF;
    var si: u32 = 0;
    for (si < out.section_count) {
        if (out.sections[si].name == fname) { fs_i = si; brk; }
        si = si + 1;
    }
    if (fs_i == 0xFFFFFFFF) { ret R.ok_void[str](); }

    val sec: *of.Section = ?out.sections[fs_i];
    val blob: *u8 = sec.bytes;
    val blen: usize = sec.len::usize;
    if (blob == nil || blen < 8) { ret R.err[R.Void, str]("coff: malformed .mach.frames section"); }
    if (bin.read_u32_le(blob, 0) != MACH_FRAMES_VERSION) {
        ret R.err[R.Void, str]("coff: unsupported .mach.frames version");
    }
    val count: u32 = bin.read_u32_le(blob, 4);
    if (count::usize > blen / 8) { ret R.err[R.Void, str]("coff: malformed .mach.frames count"); }

    var frames: *of.FrameUnwind = nil;
    if (count > 0) {
        val fa: R.Result[*of.FrameUnwind, str] = A.zallocate[of.FrameUnwind](alloc, count::usize);
        if (R.is_err[*of.FrameUnwind, str](fa)) { ret R.err[R.Void, str]("coff: frame record alloc failed"); }
        frames = R.unwrap_ok[*of.FrameUnwind, str](fa);
    }

    var pos: usize = 8;
    var i: u32 = 0;
    for (i < count) {
        if (pos + 8 > blen) {
            A.deallocate[of.FrameUnwind](alloc, frames, count::usize);
            ret R.err[R.Void, str]("coff: truncated .mach.frames record");
        }
        val nlen: usize = bin.read_u32_le(blob, pos)::usize;
        val step_count: u32 = bin.read_u32_le(blob, pos + 4);
        pos = pos + 8;
        val npad: usize = bin.align_up(nlen, 4);
        if (step_count > of.FRAME_STEP_CAP || nlen == 0
            || pos + npad + step_count::usize * 16 > blen) {
            A.deallocate[of.FrameUnwind](alloc, frames, count::usize);
            ret R.err[R.Void, str]("coff: malformed .mach.frames record");
        }

        val nb: R.Result[*u8, str] = A.allocate[u8](alloc, nlen + 1);
        if (R.is_err[*u8, str](nb)) {
            A.deallocate[of.FrameUnwind](alloc, frames, count::usize);
            ret R.err[R.Void, str]("coff: frame name alloc failed");
        }
        val nbuf: *u8 = R.unwrap_ok[*u8, str](nb);
        memory.raw_copy(nbuf::ptr, (blob::usize + pos)::ptr, nlen);
        nbuf[nlen] = 0;
        val nir: R.Result[intern.StrId, str] = intern.intern(itn, nbuf::str);
        A.deallocate[u8](alloc, nbuf, nlen + 1);
        if (R.is_err[intern.StrId, str](nir)) {
            A.deallocate[of.FrameUnwind](alloc, frames, count::usize);
            ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](nir));
        }
        val nid: intern.StrId = R.unwrap_ok[intern.StrId, str](nir);
        pos = pos + npad;

        var sym: u32 = 0xFFFFFFFF;
        var sy: u32 = 0;
        for (sy < out.symbol_count) {
            if (out.symbols[sy].name == nid
                && (out.symbols[sy].flags & of.SYM_OBJ_FLAG_FUNCTION) != 0
                && out.symbols[sy].section != of.SECTION_EXTERNAL
                && out.symbols[sy].section < out.section_count) {
                sym = sy;
                brk;
            }
            sy = sy + 1;
        }
        if (sym == 0xFFFFFFFF) {
            A.deallocate[of.FrameUnwind](alloc, frames, count::usize);
            ret R.err[R.Void, str]("coff: .mach.frames record names no defined function symbol");
        }

        frames[i].section    = out.symbols[sym].section;
        frames[i].offset     = out.symbols[sym].offset;
        frames[i].step_count = step_count;
        var k: u32 = 0;
        for (k < step_count) {
            frames[i].steps[k].kind    = blob[pos];
            frames[i].steps[k].reg     = blob[pos + 1];
            frames[i].steps[k].end_off = bin.read_u32_le(blob, pos + 4);
            frames[i].steps[k].value   = bin.read_u64_le(blob, pos + 8);
            pos = pos + 16;
            k = k + 1;
        }
        i = i + 1;
    }

    out.frames = frames;
    out.frame_count = count;
    out.frame_cap = count;

    A.deallocate[u8](alloc, sec.bytes, sec.len::usize);
    sec.bytes = nil;
    sec.len = 0;
    ret R.ok_void[str]();
}

fun is_flagless_extern(sym: *of.Symbol) bool {
    if (sym.section != of.SECTION_EXTERNAL)        { ret false; }
    if ((sym.flags & of.SYM_OBJ_FLAG_EXTERN) == 0) { ret false; }
    ret (sym.flags & of.SYM_OBJ_FLAG_FUNCTION) == 0;
}

fun infer_extern_function_flags_from_calls(out: *of.ObjectImage) R.Result[R.Void, str] {
    if (out == nil || out.reloc_count == 0 || out.symbol_count == 0) {
        ret R.ok_void[str]();
    }

    var ri: u32 = 0;
    for (ri < out.reloc_count) {
        val r: *of.Relocation = ?out.relocations[ri];
        if (r.sym >= out.symbol_count)                     { ri = ri + 1; cnt; }
        if (!is_flagless_extern(?out.symbols[r.sym]))      { ri = ri + 1; cnt; }
        if (r.kind != of.RK_PC32 && r.kind != of.RK_PLT32) { ri = ri + 1; cnt; }
        if (r.section >= out.section_count)                { ri = ri + 1; cnt; }
        val sec: *of.Section = ?out.sections[r.section];
        if (sec.bytes == nil || r.offset == 0)    { ri = ri + 1; cnt; }
        if (r.offset::usize + 4 > sec.len::usize) { ri = ri + 1; cnt; }
        val op: u8 = sec.bytes[r.offset::usize - 1];
        if (op != 0xE8 && op != 0xE9) { ri = ri + 1; cnt; }

        out.symbols[r.sym].flags =
            out.symbols[r.sym].flags | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_GLOBAL;
        ri = ri + 1;
    }

    ret R.ok_void[str]();
}

rec PeSection {
    rva:              u64;
    vsize:            u64;
    file_off:         usize;
    file_size:        usize;
    content_rva:      u64;
    content_file_off: usize;
}

rec PeLayout {
    image_base:  u64;
    header_size: usize;
    image_size:  u64;
    seg_secs:    *PeSection;
    stub_sec:    PeSection;
    idata_sec:   PeSection;
    xdata_sec:   PeSection;
    pdata_sec:   PeSection;
    rsrc_sec:    PeSection;
    reloc_sec:   PeSection;
    iat_rva:     u64;
    iat_size:    u64;
    import_dir_rva:  u64;
    import_dir_size: u64;
    exception_rva:   u64;
    exception_size:  u64;
    resource_rva:    u64;
    resource_size:   u64;
    basereloc_rva:   u64;
    basereloc_size:  u64;
    nimp:        u32;
    have_stub:   bool;
    have_idata:  bool;
    have_xdata:  bool;
    have_pdata:  bool;
    have_rsrc:   bool;
    have_reloc:  bool;
    sec_total:   u32;
    debug_secs:  *PeSection;
    debug_count: u32;
    strtab_off:  usize;
    strtab_size: usize;
}

rec UnwindCode {
    end_off:     u8;
    op:          u8;
    info:        u8;
    extra0:      u16;
    extra1:      u16;
    extra_slots: u8;
}

rec FunctionUnwind {
    seg_index:   u32;
    seg_offset:  u32;
    size:        u32;
    prolog_size: u8;
    frame_reg:   u8;
    frame_off:   u8;
    code_count:  u32;
    slot_count:  u32;
    xdata_rva:   u64;
    xdata_size:  usize;
    codes:       [32]UnwindCode;
}

fun foreign_runtime_count(exceptions: *of.Section, exception_count: u32) R.Result[u32, str] {
    var total: u64 = 0;
    var i: u32 = 0;
    for (i < exception_count) {
        if (exceptions == nil || exceptions[i].kind != of.SK_EXCEPTION
            || exceptions[i].len::usize % RUNTIME_FUNCTION_SIZE != 0
            || (exceptions[i].len > 0 && exceptions[i].bytes == nil)) {
            ret R.err[u32, str]("coff: malformed exception metadata");
        }
        total = total + (exceptions[i].len::usize / RUNTIME_FUNCTION_SIZE)::u64;
        if (total > 0xFFFFFFFF) { ret R.err[u32, str]("coff: too many runtime functions"); }
        i = i + 1;
    }
    ret R.ok[u32, str](total::u32);
}

fun foreign_runtime_has_begin(exceptions: *of.Section, exception_count: u32,
                              begin_rva: u32) bool {
    var s: u32 = 0;
    for (s < exception_count) {
        var off: usize = 0;
        for (off + RUNTIME_FUNCTION_SIZE <= exceptions[s].len::usize) {
            if (bin.read_u32_le(exceptions[s].bytes, off) == begin_rva) { ret true; }
            off = off + RUNTIME_FUNCTION_SIZE;
        }
        s = s + 1;
    }
    ret false;
}

fun func_import_count(dyn: *of.DynamicInfo) u32 {
    if (dyn == nil) { ret 0; }
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < dyn.import_count) {
        if (dyn.imports[i].is_func) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun name_len_z(itn: *intern.Interner, id: intern.StrId) usize {
    val s: str = bin.resolve_name(itn, id);
    if (s == nil) { ret 1; }
    ret str_len(s) + 1;
}

fun pe_section_flags(flags: u32, has_data: bool) u32 {
    var c: u32 = 0;
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) {
        c = c | IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    }
    or (!has_data) {
        c = c | IMAGE_SCN_CNT_UNINITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    or ((flags & of.SEG_FLAG_WRITE) != 0) {
        c = c | IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    or {
        c = c | IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    }
    ret c;
}

fun import_dir_bytes(dyn: *of.DynamicInfo) usize {
    ret (dyn.lib_count + 1)::usize * IMPORT_DESCRIPTOR_SIZE;
}

fun base_reloc_cmp(a: *of.BaseReloc, b: *of.BaseReloc) i64 {
    if (a.seg_index != b.seg_index) {
        if (a.seg_index < b.seg_index) { ret -1; }
        ret 1;
    }
    if (a.seg_offset < b.seg_offset) { ret -1; }
    if (a.seg_offset > b.seg_offset) { ret 1; }
    ret 0;
}

fun base_reloc_rva(br: *of.BaseReloc, seg_secs: *PeSection) u64 {
    ret seg_secs[br.seg_index].content_rva + br.seg_offset::u64;
}

fun base_reloc_page(rva: u64) u64 {
    ret (rva / BASE_RELOC_PAGE) * BASE_RELOC_PAGE;
}

fun measure_reloc_bytes(dyn: *of.DynamicInfo, seg_secs: *PeSection) usize {
    if (dyn == nil || dyn.base_reloc_count == 0) { ret 0; }
    var total: usize = 0;
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        val page: u64 = base_reloc_page(base_reloc_rva(?dyn.base_relocs[i], seg_secs));
        var j: u32 = i;
        for (j < dyn.base_reloc_count && base_reloc_page(base_reloc_rva(?dyn.base_relocs[j], seg_secs)) == page) {
            j = j + 1;
        }
        var entries: u32 = j - i;
        if ((entries & 1) != 0) { entries = entries + 1; }
        total = total + BASE_RELOC_BLOCK_HEADER + entries::usize * 2;
        i = j;
    }
    ret total;
}

fun write_reloc_section(buf: *u8, off: usize, dyn: *of.DynamicInfo, seg_secs: *PeSection) usize {
    if (dyn == nil || dyn.base_reloc_count == 0) { ret off; }
    var p: usize = off;
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        val page: u64 = base_reloc_page(base_reloc_rva(?dyn.base_relocs[i], seg_secs));
        var j: u32 = i;
        for (j < dyn.base_reloc_count && base_reloc_page(base_reloc_rva(?dyn.base_relocs[j], seg_secs)) == page) {
            j = j + 1;
        }
        val n: u32 = j - i;
        var entries: u32 = n;
        if ((entries & 1) != 0) { entries = entries + 1; }
        val block_size: usize = BASE_RELOC_BLOCK_HEADER + entries::usize * 2;
        bin.write_u32_le(buf, p, page::u32);
        bin.write_u32_le(buf, p + 4, block_size::u32);
        var q: usize = p + BASE_RELOC_BLOCK_HEADER;
        var k: u32 = i;
        for (k < j) {
            val rva: u64 = base_reloc_rva(?dyn.base_relocs[k], seg_secs);
            val entry: u16 = (IMAGE_REL_BASED_DIR64 << 12) | (rva - page)::u16;
            bin.write_u16_le(buf, q, entry);
            q = q + 2;
            k = k + 1;
        }
        if ((n & 1) != 0) {
            bin.write_u16_le(buf, q, IMAGE_REL_BASED_ABSOLUTE);
        }
        p = p + block_size;
        i = j;
    }
    ret p;
}

fun push_unwind_code(uw: *FunctionUnwind, end_off: u8, op: u8, info: u8,
                     extra0: u16, extra1: u16, extra_slots: u8) bool {
    if (uw.code_count >= 32) { ret false; }
    uw.codes[uw.code_count].end_off = end_off;
    uw.codes[uw.code_count].op = op;
    uw.codes[uw.code_count].info = info;
    uw.codes[uw.code_count].extra0 = extra0;
    uw.codes[uw.code_count].extra1 = extra1;
    uw.codes[uw.code_count].extra_slots = extra_slots;
    uw.code_count = uw.code_count + 1;
    uw.slot_count = uw.slot_count + 1 + extra_slots::u32;
    ret true;
}

fun push_alloc_code(uw: *FunctionUnwind, end_off: u8, alloc: usize) bool {
    if (alloc == 0)       { ret true; }
    if ((alloc & 7) != 0) { ret false; }
    if (alloc <= 128) {
        ret push_unwind_code(uw, end_off, UWOP_ALLOC_SMALL, ((alloc - 8) / 8)::u8, 0, 0, 0);
    }
    val scaled: u32 = (alloc / 8)::u32;
    if (scaled <= 0xFFFF) {
        ret push_unwind_code(uw, end_off, UWOP_ALLOC_LARGE, 0, scaled::u16, 0, 1);
    }
    ret push_unwind_code(uw, end_off, UWOP_ALLOC_LARGE, 1,
                         (alloc & 0xFFFF)::u16, ((alloc >> 16) & 0xFFFF)::u16, 2);
}

fun push_save_nonvol(uw: *FunctionUnwind, end_off: u8, reg: u8, save_off: usize) bool {
    if ((save_off & 7) != 0) { ret false; }
    val scaled: u64 = (save_off / 8)::u64;
    if (scaled <= 0xFFFF) {
        ret push_unwind_code(uw, end_off, UWOP_SAVE_NONVOL, reg, scaled::u16, 0, 1);
    }
    if (save_off > 0xFFFFFFFF::usize) { ret false; }
    ret push_unwind_code(uw, end_off, UWOP_SAVE_NONVOL_FAR, reg,
                         (save_off & 0xFFFF)::u16, ((save_off >> 16) & 0xFFFF)::u16, 2);
}

fun push_save_xmm128(uw: *FunctionUnwind, end_off: u8, reg: u8, save_off: usize) bool {
    if ((save_off & 15) != 0) { ret false; }
    val scaled: u64 = (save_off / 16)::u64;
    if (scaled <= 0xFFFF) {
        ret push_unwind_code(uw, end_off, UWOP_SAVE_XMM128, reg, scaled::u16, 0, 1);
    }
    if (save_off > 0xFFFFFFFF::usize) { ret false; }
    ret push_unwind_code(uw, end_off, UWOP_SAVE_XMM128_FAR, reg,
                         (save_off & 0xFFFF)::u16, ((save_off >> 16) & 0xFFFF)::u16, 2);
}

fun build_function_unwind(uw: *FunctionUnwind, seg_count: u32,
                          funcs: *of.ExecFunction, idx: u32) bool {
    uw.seg_index = funcs[idx].seg_index;
    uw.seg_offset = funcs[idx].seg_offset;
    uw.size = funcs[idx].size;
    uw.prolog_size = 0;
    uw.frame_reg = 0;
    uw.frame_off = 0;
    uw.code_count = 0;
    uw.slot_count = 0;
    uw.xdata_rva = 0;
    uw.xdata_size = 0;

    if (uw.seg_index >= seg_count || uw.size == 0) { ret false; }
    if (funcs[idx].step_count == 0)                { ret false; }
    if (funcs[idx].step_count > of.FRAME_STEP_CAP) { ret false; }

    var prolog_end: u32 = 0;
    var i: u32 = 0;
    for (i < funcs[idx].step_count) {
        val stp: *of.FrameStep = ?funcs[idx].steps[i];
        if (stp.end_off == 0 || stp.end_off > 255)   { ret false; }
        if (stp.end_off::u32 > funcs[idx].size)      { ret false; }
        if (stp.end_off > prolog_end)                { prolog_end = stp.end_off; }
        val end8: u8 = stp.end_off::u8;

        if (stp.kind == of.FRAME_STEP_PUSH) {
            if (!push_unwind_code(uw, end8, UWOP_PUSH_NONVOL, stp.reg & 0x0F, 0, 0, 0)) { ret false; }
        }
        or (stp.kind == of.FRAME_STEP_ALLOC) {
            if (!push_alloc_code(uw, end8, stp.value::usize)) { ret false; }
        }
        or (stp.kind == of.FRAME_STEP_SET_FP) {
            if ((stp.value & 15) != 0 || stp.value / 16 > 15) { ret false; }
            uw.frame_reg = stp.reg & 0x0F;
            uw.frame_off = (stp.value / 16)::u8;
            if (!push_unwind_code(uw, end8, UWOP_SET_FPREG, 0, 0, 0, 0)) { ret false; }
        }
        or (stp.kind == of.FRAME_STEP_SAVE) {
            if (!push_save_nonvol(uw, end8, stp.reg & 0x0F, stp.value::usize)) { ret false; }
        }
        or (stp.kind == of.FRAME_STEP_SAVE_VEC) {
            if (!push_save_xmm128(uw, end8, stp.reg & 0x0F, stp.value::usize)) { ret false; }
        }
        or {
            ret false;
        }
        i = i + 1;
    }

    if (uw.code_count == 0) { ret false; }
    uw.prolog_size = prolog_end::u8;
    uw.xdata_size = bin.align_up(4 + uw.slot_count::usize * 2, 4);
    ret true;
}

fun collect_function_unwind(segs: *of.LoadSegment, seg_count: u32, funcs: *of.ExecFunction,
                            func_count: u32, exceptions: *of.Section, exception_count: u32,
                            image_base: u64, out: *FunctionUnwind) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < func_count) {
        if (build_function_unwind(?out[n], seg_count, funcs, i)) {
            val begin: u64 = segs[out[n].seg_index].vaddr - image_base
                            + out[n].seg_offset::u64;
            if (begin <= 0xFFFFFFFF
                && !foreign_runtime_has_begin(exceptions, exception_count, begin::u32)) {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    ret n;
}

fun compute_pe_layout(itn: *intern.Interner, lay: *PeLayout, segs: *of.LoadSegment, seg_count: u32,
                      dyn: *of.DynamicInfo, seg_secs: *PeSection,
                      image_base: u64,
                      xdata_vsize: usize, pdata_vsize: usize, resource_vsize: usize,
                      debug: *of.Section, debug_count: u32, debug_secs: *PeSection) usize {
    lay.nimp      = func_import_count(dyn);
    lay.seg_secs  = seg_secs;
    lay.have_stub = lay.nimp > 0;
    lay.have_idata = dyn != nil && (dyn.lib_count > 0 || dyn.import_count > 0);
    lay.have_xdata = xdata_vsize > 0;
    lay.have_pdata = pdata_vsize > 0;
    lay.have_rsrc = resource_vsize > 0;
    lay.have_reloc = dyn != nil && dyn.base_reloc_count > 0;
    lay.debug_secs  = debug_secs;
    lay.debug_count = debug_count;
    lay.strtab_off  = 0;
    lay.strtab_size = 0;

    var nsec: u32 = seg_count;
    if (lay.have_stub)  { nsec = nsec + 1; }
    if (lay.have_idata) { nsec = nsec + 1; }
    if (lay.have_xdata) { nsec = nsec + 1; }
    if (lay.have_pdata) { nsec = nsec + 1; }
    if (lay.have_rsrc)  { nsec = nsec + 1; }
    if (lay.have_reloc) { nsec = nsec + 1; }
    nsec = nsec + debug_count;
    lay.sec_total = nsec;

    val headers_raw: usize = DOS_HEADER_SIZE + PE_SIGNATURE_SIZE + COFF_HEADER_SIZE
        + OPTIONAL_HEADER_SIZE + nsec::usize * SECTION_HEADER_SIZE;
    lay.header_size = bin.align_up(headers_raw, PE_FILE_ALIGN::usize);

    val header_reserve: u64 = bin.align_up_u64(lay.header_size::u64, PE_SECTION_ALIGN);
    lay.image_base = image_base;

    var file_off: usize = lay.header_size;
    var rva: u64 = header_reserve;

    var li: u32 = 0;
    for (li < seg_count) {
        val seg_rva: u64 = segs[li].vaddr - lay.image_base;
        var sec_rva: u64 = seg_rva;
        if (li == 0) { sec_rva = header_reserve; }
        val prefix: u64 = seg_rva - sec_rva;
        seg_secs[li].rva              = sec_rva;
        seg_secs[li].vsize            = prefix + segs[li].memsz::u64;
        seg_secs[li].file_off         = file_off;
        seg_secs[li].file_size        = bin.align_up(prefix::usize + segs[li].filesz,
                                                     PE_FILE_ALIGN::usize);
        seg_secs[li].content_rva      = seg_rva;
        seg_secs[li].content_file_off = file_off + prefix::usize;
        file_off = file_off + seg_secs[li].file_size;
        val seg_end: u64 = bin.align_up_u64(seg_rva + segs[li].memsz::u64, PE_SECTION_ALIGN);
        if (seg_end > rva) { rva = seg_end; }
        li = li + 1;
    }

    if (lay.have_stub) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        lay.stub_sec.rva       = rva;
        lay.stub_sec.vsize     = (lay.nimp::usize * IMPORT_STUB_SIZE)::u64;
        lay.stub_sec.file_off  = file_off;
        lay.stub_sec.file_size = bin.align_up(lay.nimp::usize * IMPORT_STUB_SIZE, PE_FILE_ALIGN::usize);
        file_off = file_off + lay.stub_sec.file_size;
        rva = rva + bin.align_up_u64(lay.stub_sec.vsize, PE_SECTION_ALIGN);
    }

    if (lay.have_idata) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        var ioff: usize = 0;

        lay.import_dir_rva = rva;
        lay.import_dir_size = import_dir_bytes(dyn)::u64;
        ioff = ioff + import_dir_bytes(dyn);

        ioff = bin.align_up(ioff, 8);
        ioff = ioff + (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE;

        ioff = bin.align_up(ioff, 8);
        lay.iat_rva  = rva + ioff::u64;
        lay.iat_size = (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE::u64;
        ioff = ioff + (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE;

        ioff = bin.align_up(ioff, 2);
        var i: u32 = 0;
        for (i < dyn.import_count) {
            if (!dyn.imports[i].by_ordinal) {
                ioff = ioff + 2 + name_len_z(itn, dyn.imports[i].symbol);
                ioff = bin.align_up(ioff, 2);
            }
            i = i + 1;
        }

        i = 0;
        for (i < dyn.lib_count) {
            ioff = ioff + name_len_z(itn, dyn.libs[i].soname);
            ioff = bin.align_up(ioff, 2);
            i = i + 1;
        }

        lay.idata_sec.rva       = rva;
        lay.idata_sec.vsize     = ioff::u64;
        lay.idata_sec.file_off  = file_off;
        lay.idata_sec.file_size = bin.align_up(ioff, PE_FILE_ALIGN::usize);
        file_off = file_off + lay.idata_sec.file_size;
        rva = rva + bin.align_up_u64(ioff::u64, PE_SECTION_ALIGN);
    }

    if (lay.have_xdata) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        lay.xdata_sec.rva       = rva;
        lay.xdata_sec.vsize     = xdata_vsize::u64;
        lay.xdata_sec.file_off  = file_off;
        lay.xdata_sec.file_size = bin.align_up(xdata_vsize, PE_FILE_ALIGN::usize);
        file_off = file_off + lay.xdata_sec.file_size;
        rva = rva + bin.align_up_u64(lay.xdata_sec.vsize, PE_SECTION_ALIGN);
    }

    if (lay.have_pdata) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        lay.pdata_sec.rva       = rva;
        lay.pdata_sec.vsize     = pdata_vsize::u64;
        lay.pdata_sec.file_off  = file_off;
        lay.pdata_sec.file_size = bin.align_up(pdata_vsize, PE_FILE_ALIGN::usize);
        lay.exception_rva       = rva;
        lay.exception_size      = pdata_vsize::u64;
        file_off = file_off + lay.pdata_sec.file_size;
        rva = rva + bin.align_up_u64(lay.pdata_sec.vsize, PE_SECTION_ALIGN);
    }

    if (lay.have_rsrc) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        lay.rsrc_sec.rva       = rva;
        lay.rsrc_sec.vsize     = resource_vsize::u64;
        lay.rsrc_sec.file_off  = file_off;
        lay.rsrc_sec.file_size = bin.align_up(resource_vsize, PE_FILE_ALIGN::usize);
        lay.resource_rva       = rva;
        lay.resource_size      = resource_vsize::u64;
        file_off = file_off + lay.rsrc_sec.file_size;
        rva = rva + bin.align_up_u64(resource_vsize::u64, PE_SECTION_ALIGN);
    }

    if (lay.have_reloc) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        val rsize: usize = measure_reloc_bytes(dyn, seg_secs);
        lay.reloc_sec.rva       = rva;
        lay.reloc_sec.vsize     = rsize::u64;
        lay.reloc_sec.file_off  = file_off;
        lay.reloc_sec.file_size = bin.align_up(rsize, PE_FILE_ALIGN::usize);
        lay.basereloc_rva       = rva;
        lay.basereloc_size      = rsize::u64;
        file_off = file_off + lay.reloc_sec.file_size;
        rva = rva + bin.align_up_u64(rsize::u64, PE_SECTION_ALIGN);
    }

    var strtab_bytes: usize = 0;
    var sni: u32 = 0;
    for (sni < seg_count) {
        val sn_has_data: bool = segs[sni].bytes != nil && segs[sni].filesz > 0;
        val sn: str = segment_name(segs[sni].flags, sn_has_data, seg_is_relro(dyn, segs, sni));
        if (name_in_strtab(sn)) { strtab_bytes = strtab_bytes + str_len(sn) + 1; }
        sni = sni + 1;
    }

    var di: u32 = 0;
    for (di < debug_count) {
        rva = bin.align_up_u64(rva, PE_SECTION_ALIGN);
        debug_secs[di].rva       = rva;
        debug_secs[di].vsize     = debug[di].len::u64;
        debug_secs[di].file_off  = file_off;
        debug_secs[di].file_size = bin.align_up(debug[di].len::usize, PE_FILE_ALIGN::usize);
        file_off = file_off + debug_secs[di].file_size;
        rva = rva + bin.align_up_u64(debug[di].len::u64, PE_SECTION_ALIGN);
        val nm: str = bin.resolve_name(itn, debug[di].name);
        if (name_in_strtab(nm)) { strtab_bytes = strtab_bytes + str_len(nm) + 1; }
        di = di + 1;
    }
    if (strtab_bytes > 0) {
        lay.strtab_off  = file_off;
        lay.strtab_size = 4 + strtab_bytes;
        file_off = file_off + lay.strtab_size;
    }

    lay.image_size = bin.align_up_u64(rva, PE_SECTION_ALIGN);
    ret file_off;
}

fun pe_section_fits(sec: *PeSection) bool {
    if (sec.rva > 0xFFFFFFFF || sec.vsize > 0xFFFFFFFF
        || sec.file_off > 0xFFFFFFFF::usize || sec.file_size > 0xFFFFFFFF::usize
        || sec.content_rva > 0xFFFFFFFF || sec.content_file_off > 0xFFFFFFFF::usize) { ret false; }
    if (sec.vsize > 0xFFFFFFFF - sec.rva) { ret false; }
    if (sec.file_size > 0xFFFFFFFF::usize - sec.file_off) { ret false; }
    ret true;
}

fun validate_pe_layout(lay: *PeLayout, seg_count: u32, total_size: usize) R.Result[R.Void, str] {
    if (lay.sec_total > 65535) { ret R.err[R.Void, str]("coff: PE section count exceeds 65535"); }
    if (lay.header_size > 0xFFFFFFFF::usize || lay.image_size > 0xFFFFFFFF
        || total_size > 0xFFFFFFFF::usize) {
        ret R.err[R.Void, str]("coff: PE image exceeds 32-bit header fields");
    }
    var i: u32 = 0;
    for (i < seg_count) {
        if (!pe_section_fits(?lay.seg_secs[i])) { ret R.err[R.Void, str]("coff: PE segment layout exceeds 32-bit fields"); }
        i = i + 1;
    }
    if (lay.have_stub && !pe_section_fits(?lay.stub_sec))   { ret R.err[R.Void, str]("coff: PE import-stub layout exceeds 32-bit fields"); }
    if (lay.have_idata && !pe_section_fits(?lay.idata_sec)) { ret R.err[R.Void, str]("coff: PE import layout exceeds 32-bit fields"); }
    if (lay.have_xdata && !pe_section_fits(?lay.xdata_sec)) { ret R.err[R.Void, str]("coff: PE unwind layout exceeds 32-bit fields"); }
    if (lay.have_pdata && !pe_section_fits(?lay.pdata_sec)) { ret R.err[R.Void, str]("coff: PE exception layout exceeds 32-bit fields"); }
    if (lay.have_rsrc && !pe_section_fits(?lay.rsrc_sec))   { ret R.err[R.Void, str]("coff: PE resource layout exceeds 32-bit fields"); }
    if (lay.have_reloc && !pe_section_fits(?lay.reloc_sec)) { ret R.err[R.Void, str]("coff: PE relocation layout exceeds 32-bit fields"); }
    i = 0;
    for (i < lay.debug_count) {
        if (!pe_section_fits(?lay.debug_secs[i])) { ret R.err[R.Void, str]("coff: PE debug layout exceeds 32-bit fields"); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun coff_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                   seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                   funcs: *of.ExecFunction,
                   func_count: u32, exceptions: *of.Section, exception_count: u32,
                   debug: *of.Section, debug_count: u32,
                   symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination, name: *u8,
                   image_options: of.ImageOptions) R.Result[R.Void, str] {
    ret write_pe(alloc, itn, isa_vt, segs, seg_count, image_base, entry, funcs, func_count,
                 nil, nil, 0, exceptions, exception_count,
                 debug, debug_count, destination, image_options);
}

fun coff_emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                       seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                       funcs: *of.ExecFunction,
                       func_count: u32, dyn: *of.DynamicInfo,
                       fixups: *of.PltFixup, fixup_count: u32,
                       exceptions: *of.Section, exception_count: u32,
                       debug: *of.Section, debug_count: u32,
                       symtab: *of.SymtabEntry, symtab_count: u32,
                       destination: *publication.Destination, name: *u8, image_options: of.ImageOptions) R.Result[R.Void, str] {
    ret write_pe(alloc, itn, isa_vt, segs, seg_count, image_base, entry, funcs, func_count,
                 dyn, fixups, fixup_count, exceptions, exception_count,
                 debug, debug_count, destination, image_options);
}

fun write_pe(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
             seg_count: u32, image_base: u64, entry: u64,
             funcs: *of.ExecFunction, func_count: u32,
             dyn: *of.DynamicInfo,
             fixups: *of.PltFixup, fixup_count: u32,
             exceptions: *of.Section, exception_count: u32,
             debug: *of.Section, debug_count: u32, destination: *publication.Destination,
             image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (isa_vt == nil) { ret R.err[R.Void, str]("coff: nil exec isa"); }
    if (destination == nil)   { ret R.err[R.Void, str]("coff: nil exec path"); }
    if (isa_vt.arch_id != isa.ARCH_X86_64) {
        ret R.err[R.Void, str]("coff: PE emission is only implemented for x86-64");
    }
    if (seg_count == 0) { ret R.err[R.Void, str]("coff: no loadable segments"); }

    val frr: R.Result[u32, str] = foreign_runtime_count(exceptions, exception_count);
    if (R.is_err[u32, str](frr)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](frr)); }
    val foreign_count: u32 = R.unwrap_ok[u32, str](frr);
    if ((image_base & 0xFFFF) != 0) {
        ret R.err[R.Void, str]("coff: PE image base is not 64 KiB-aligned");
    }
    if (segs[0].vaddr < image_base
        || segs[0].vaddr - image_base < PE_SECTION_ALIGN) {
        ret R.err[R.Void, str]("coff: first segment precedes the PE header page");
    }
    if (entry < image_base || entry - image_base > 0xFFFFFFFF) {
        ret R.err[R.Void, str]("coff: PE entry point exceeds the 32-bit RVA field");
    }
    var vsi: u32 = 0;
    for (vsi < seg_count) {
        if (segs[vsi].vaddr < image_base || segs[vsi].vaddr - image_base > 0xFFFFFFFF
            || segs[vsi].filesz > 0xFFFFFFFF::usize
            || segs[vsi].memsz > 0xFFFFFFFF::usize
            || segs[vsi].memsz::u64 > 0xFFFFFFFFFFFFFFFF - segs[vsi].vaddr) {
            ret R.err[R.Void, str]("coff: PE load segment exceeds representable offsets or sizes");
        }
        vsi = vsi + 1;
    }

    var seg_secs: *PeSection = nil;
    val ssr: R.Result[*PeSection, str] = A.zallocate[PeSection](alloc, seg_count::usize);
    if (R.is_err[*PeSection, str](ssr)) { ret R.err[R.Void, str]("coff: segment layout alloc failed"); }
    seg_secs = R.unwrap_ok[*PeSection, str](ssr);

    var debug_secs: *PeSection = nil;
    if (debug_count > 0) {
        val dsr: R.Result[*PeSection, str] = A.zallocate[PeSection](alloc, debug_count::usize);
        if (R.is_err[*PeSection, str](dsr)) {
            A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
            ret R.err[R.Void, str]("coff: debug layout alloc failed");
        }
        debug_secs = R.unwrap_ok[*PeSection, str](dsr);
    }

    var uw_all: *FunctionUnwind = nil;
    var uw_count: u32 = 0;
    var xdata_vsize: usize = 0;
    var pdata_vsize: usize = 0;
    if (func_count > 0 && funcs != nil) {
        val ur: R.Result[*FunctionUnwind, str] = A.zallocate[FunctionUnwind](alloc, func_count::usize);
        if (R.is_err[*FunctionUnwind, str](ur)) {
            if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
            A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
            ret R.err[R.Void, str]("coff: unwind table alloc failed");
        }
        uw_all = R.unwrap_ok[*FunctionUnwind, str](ur);
        uw_count = collect_function_unwind(segs, seg_count, funcs, func_count,
                                           exceptions, exception_count, image_base, uw_all);
        var ui: u32 = 0;
        for (ui < uw_count) {
            xdata_vsize = xdata_vsize + uw_all[ui].xdata_size;
            ui = ui + 1;
        }
        pdata_vsize = (uw_count + foreign_count)::usize * RUNTIME_FUNCTION_SIZE;
    }
    or {
        pdata_vsize = foreign_count::usize * RUNTIME_FUNCTION_SIZE;
    }

    if (dyn != nil && dyn.base_reloc_count > 0) {
        sort.sort[of.BaseReloc](dyn.base_relocs, dyn.base_reloc_count::usize, base_reloc_cmp);
    }

    var resource_image: rs.RsrcImage;
    var resource_ptr: *rs.RsrcImage = nil;
    var resource_size: usize = 0;
    if (image_options.resources != nil) {
        val info: *of.ResourceInfo = image_options.resources;
        val rr: R.Result[rs.RsrcImage, str] = rs.build(alloc, info.icon, info.icon_len,
            info.app_manifest, info.app_manifest_len, info.version, info.internal_name,
            info.original_filename, info.product_name);
        if (R.is_err[rs.RsrcImage, str](rr)) {
            if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
            A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
            if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
            ret R.err[R.Void, str](R.unwrap_err[rs.RsrcImage, str](rr));
        }
        resource_image = R.unwrap_ok[rs.RsrcImage, str](rr);
        resource_ptr = ?resource_image;
        val sr: R.Result[usize, str] = rs.size(resource_ptr);
        if (R.is_err[usize, str](sr)) {
            rs.dnit(alloc, resource_ptr);
            if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
            A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
            if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
            ret R.err[R.Void, str](R.unwrap_err[usize, str](sr));
        }
        resource_size = R.unwrap_ok[usize, str](sr);
    }

    var lay: PeLayout;
    val total_size: usize = compute_pe_layout(itn, ?lay, segs, seg_count, dyn, seg_secs,
                                              image_base, xdata_vsize, pdata_vsize,
                                              resource_size, debug, debug_count, debug_secs);

    val layout_r: R.Result[R.Void, str] = validate_pe_layout(?lay, seg_count, total_size);
    if (R.is_err[R.Void, str](layout_r)) {
        if (resource_ptr != nil) { rs.dnit(alloc, resource_ptr); }
        if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
        A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
        if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
        ret layout_r;
    }

    if (lay.header_size::u64 > PE_SECTION_ALIGN) {
        if (resource_ptr != nil) { rs.dnit(alloc, resource_ptr); }
        if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
        A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
        if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
        ret R.err[R.Void, str]("coff: PE headers exceed the reserved image page");
    }

    val res_buf: R.Result[*u8, str] = A.zallocate[u8](alloc, total_size);
    if (R.is_err[*u8, str](res_buf)) {
        if (resource_ptr != nil) { rs.dnit(alloc, resource_ptr); }
        if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
        A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
        if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
        ret R.err[R.Void, str]("coff: PE buffer alloc failed");
    }
    var buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_secs[li].content_file_off)::ptr,
                            segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }

    var di: u32 = 0;
    for (di < debug_count) {
        if (debug[di].bytes != nil && debug[di].len > 0) {
            memory.raw_copy((buf::usize + debug_secs[di].file_off)::ptr, debug[di].bytes::ptr, debug[di].len::usize);
        }
        di = di + 1;
    }
    if (lay.strtab_size > 0) {
        var str_pos: usize = 4;
        li = 0;
        for (li < seg_count) {
            val sn_has_data: bool = segs[li].bytes != nil && segs[li].filesz > 0;
            val sn: str = segment_name(segs[li].flags, sn_has_data, seg_is_relro(dyn, segs, li));
            if (name_in_strtab(sn)) { str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, sn); }
            li = li + 1;
        }
        di = 0;
        for (di < debug_count) {
            val nm: str = bin.resolve_name(itn, debug[di].name);
            if (name_in_strtab(nm)) { str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, nm); }
            di = di + 1;
        }
        bin.write_u32_le(buf, lay.strtab_off, lay.strtab_size::u32);
    }

    if (lay.have_idata)                   { write_pe_imports(itn, buf, ?lay, dyn); }
    if (lay.have_stub)                    { write_pe_stubs(buf, ?lay, dyn); }
    if (lay.have_xdata || lay.have_pdata) {
        write_pe_unwind(buf, ?lay, uw_all, uw_count, exceptions, exception_count);
    }
    if (lay.have_rsrc) {
        val er: R.Result[usize, str] = rs.emit(resource_ptr, buf, lay.rsrc_sec.file_off,
                                               lay.rsrc_sec.rva);
        if (R.is_err[usize, str](er) || R.unwrap_ok[usize, str](er) != resource_size) {
            var msg: str = "coff: resource size changed during emission";
            if (R.is_err[usize, str](er)) { msg = R.unwrap_err[usize, str](er); }
            rs.dnit(alloc, resource_ptr);
            A.deallocate[u8](alloc, buf, total_size);
            if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
            A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
            if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
            ret R.err[R.Void, str](msg);
        }
    }
    if (lay.have_reloc)                   { write_reloc_section(buf, lay.reloc_sec.file_off, dyn, seg_secs); }

    var fx_r: R.Result[R.Void, str] =
        patch_pe_fixups(buf, ?lay, dyn, fixups, fixup_count, segs, seg_count);
    if (R.is_ok[R.Void, str](fx_r)) {
        fx_r = patch_pe_import_addr_fixups(buf, ?lay, dyn, segs, seg_count);
    }
    if (R.is_err[R.Void, str](fx_r)) {
        if (resource_ptr != nil) { rs.dnit(alloc, resource_ptr); }
        A.deallocate[u8](alloc, buf, total_size);
        if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
        A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
        if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
        ret fx_r;
    }

    val pie: bool = dyn != nil && dyn.pie;
    val header_r: R.Result[R.Void, str] = write_pe_headers(buf, ?lay, segs, seg_count, entry,
        pie, itn, dyn, debug, debug_count, image_options.subsystem,
        image_options.stack_reserve, image_options.stack_commit);
    if (R.is_err[R.Void, str](header_r)) {
        if (resource_ptr != nil) { rs.dnit(alloc, resource_ptr); }
        A.deallocate[u8](alloc, buf, total_size);
        if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
        A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
        if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }
        ret header_r;
    }

    if (resource_ptr != nil) { rs.dnit(alloc, resource_ptr); }
    if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
    A.deallocate[PeSection](alloc, seg_secs, seg_count::usize);
    if (uw_all != nil && func_count > 0) { A.deallocate[FunctionUnwind](alloc, uw_all, func_count::usize); }

    val res: R.Result[R.Void, str] = publication.bytes_at(itn, alloc, ?destination.claim, destination.path, buf, total_size, 0o755, publication.REPLACE, "coff: cannot publish executable", "coff: could not publish executable file", nil);
    A.deallocate[u8](alloc, buf, total_size);
    ret res;
}

fun write_pe_imports(itn: *intern.Interner, buf: *u8, lay: *PeLayout, dyn: *of.DynamicInfo) {
    val sec_off: usize = lay.idata_sec.file_off;
    val sec_rva: u64   = lay.idata_sec.rva;

    var ioff: usize = 0;
    val dir_off: usize = ioff;
    ioff = ioff + import_dir_bytes(dyn);

    ioff = bin.align_up(ioff, 8);
    val ilt_off: usize = ioff;
    ioff = ioff + (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE;

    ioff = bin.align_up(ioff, 8);
    val iat_off: usize = ioff;
    ioff = ioff + (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE;

    ioff = bin.align_up(ioff, 2);
    val hint_off: usize = ioff;

    var hcur: usize = hint_off;
    var thunk_ix: u32 = 0;
    var lib: u32 = 0;
    for (lib < dyn.lib_count) {
        val first_thunk: u32 = thunk_ix;
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (import_lib_of(dyn, imp) == lib) {
                var thunk: u64 = 0;
                if (dyn.imports[imp].by_ordinal) {
                    thunk = IMPORT_ORDINAL_FLAG64 | dyn.imports[imp].ordinal::u64;
                }
                or {
                    thunk = sec_rva + hcur::u64;
                    bin.write_u16_le(buf, sec_off + hcur, dyn.imports[imp].ordinal);
                    hcur = hcur + 2;
                    hcur = hcur + bin.write_str(buf, sec_off + hcur,
                        bin.resolve_name(itn, dyn.imports[imp].symbol));
                    hcur = bin.align_up(hcur, 2);
                }

                bin.write_u64_le(buf, sec_off + ilt_off + thunk_ix::usize * THUNK_SIZE, thunk);
                bin.write_u64_le(buf, sec_off + iat_off + thunk_ix::usize * THUNK_SIZE, thunk);
                thunk_ix = thunk_ix + 1;
            }
            imp = imp + 1;
        }
        bin.write_u64_le(buf, sec_off + ilt_off + thunk_ix::usize * THUNK_SIZE, 0);
        bin.write_u64_le(buf, sec_off + iat_off + thunk_ix::usize * THUNK_SIZE, 0);
        thunk_ix = thunk_ix + 1;

        val name_rva: u64 = sec_rva + hcur::u64;
        hcur = hcur + bin.write_str(buf, sec_off + hcur, bin.resolve_name(itn, dyn.libs[lib].soname));
        hcur = bin.align_up(hcur, 2);

        val d: usize = sec_off + dir_off + lib::usize * IMPORT_DESCRIPTOR_SIZE;
        bin.write_u32_le(buf, d, (sec_rva + ilt_off::u64 + first_thunk::u64 * THUNK_SIZE::u64)::u32);
        bin.write_u32_le(buf, d + 4, 0);
        bin.write_u32_le(buf, d + 8, 0);
        bin.write_u32_le(buf, d + 12, name_rva::u32);
        bin.write_u32_le(buf, d + 16, (sec_rva + iat_off::u64 + first_thunk::u64 * THUNK_SIZE::u64)::u32);
        lib = lib + 1;
    }
}

fun import_lib_of(dyn: *of.DynamicInfo, imp: u32) u32 {
    val li: u32 = dyn.imports[imp].lib_index;
    if (li != of.DYNLIB_ANY && li < dyn.lib_count) { ret li; }
    ret 0;
}

fun pe_iat_slot_rva(lay: *PeLayout, dyn: *of.DynamicInfo, ord: u32) u64 {
    var ioff: usize = import_dir_bytes(dyn);
    ioff = bin.align_up(ioff, 8);
    ioff = ioff + (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE;
    ioff = bin.align_up(ioff, 8);
    val iat_off: usize = ioff;

    var thunk_ix: u32 = 0;
    var fn_ord: u32 = 0;
    var lib: u32 = 0;
    for (lib < dyn.lib_count) {
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (import_lib_of(dyn, imp) == lib) {
                if (dyn.imports[imp].is_func) {
                    if (fn_ord == ord) {
                        ret lay.idata_sec.rva + iat_off::u64
                            + thunk_ix::u64 * THUNK_SIZE::u64;
                    }
                    fn_ord = fn_ord + 1;
                }
                thunk_ix = thunk_ix + 1;
            }
            imp = imp + 1;
        }
        thunk_ix = thunk_ix + 1;
        lib = lib + 1;
    }
    ret 0;
}

fun pe_import_iat_slot_rva(lay: *PeLayout, dyn: *of.DynamicInfo,
                           idx: u32) u64 {
    if (dyn == nil || idx >= dyn.import_count) { ret 0; }
    var ioff: usize = import_dir_bytes(dyn);
    ioff = bin.align_up(ioff, 8);
    ioff = ioff + (dyn.import_count + dyn.lib_count)::usize * THUNK_SIZE;
    ioff = bin.align_up(ioff, 8);
    val iat_off: usize = ioff;

    var thunk_ix: u32 = 0;
    var lib: u32 = 0;
    for (lib < dyn.lib_count) {
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (import_lib_of(dyn, imp) == lib) {
                if (imp == idx) {
                    ret lay.idata_sec.rva + iat_off::u64
                        + thunk_ix::u64 * THUNK_SIZE::u64;
                }
                thunk_ix = thunk_ix + 1;
            }
            imp = imp + 1;
        }
        thunk_ix = thunk_ix + 1;
        lib = lib + 1;
    }
    ret 0;
}

fun func_ordinal(dyn: *of.DynamicInfo, idx: u32) u32 {
    if (idx >= dyn.import_count)   { ret 0xFFFFFFFF; }
    if (!dyn.imports[idx].is_func) { ret 0xFFFFFFFF; }
    var ord: u32 = 0;
    var lib: u32 = 0;
    for (lib < dyn.lib_count) {
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (dyn.imports[imp].is_func && import_lib_of(dyn, imp) == lib) {
                if (imp == idx) { ret ord; }
                ord = ord + 1;
            }
            imp = imp + 1;
        }
        lib = lib + 1;
    }
    ret 0xFFFFFFFF;
}

fun write_pe_stubs(buf: *u8, lay: *PeLayout, dyn: *of.DynamicInfo) {
    var ord: u32 = 0;
    for (ord < lay.nimp) {
        val stub_off: usize = lay.stub_sec.file_off + ord::usize * IMPORT_STUB_SIZE;
        val stub_rva: u64   = lay.stub_sec.rva + ord::u64 * IMPORT_STUB_SIZE::u64;
        val iat_rva:  u64   = pe_iat_slot_rva(lay, dyn, ord);
        buf[stub_off] = 0xFF; buf[stub_off + 1] = 0x25;
        val next: u64 = stub_rva + IMPORT_STUB_SIZE::u64;
        bin.write_u32_le(buf, stub_off + 2, (iat_rva - next)::u32);
        ord = ord + 1;
    }
}

fun write_unwind_xdata(buf: *u8, lay: *PeLayout, uw: *FunctionUnwind) {
    val xoff: usize = lay.xdata_sec.file_off + (uw.xdata_rva - lay.xdata_sec.rva)::usize;
    buf[xoff] = UNWIND_VERSION;
    buf[xoff + 1] = uw.prolog_size;
    buf[xoff + 2] = uw.slot_count::u8;
    buf[xoff + 3] = (uw.frame_reg & 0x0F) | ((uw.frame_off & 0x0F) << 4);

    var used: [32]bool;
    var i: usize = 0;
    for (i < 32) { used[i] = false; i = i + 1; }

    var slots_written: usize = 0;
    var codes_written: u32 = 0;
    for (codes_written < uw.code_count) {
        var best: i32 = -1;
        var best_off: u8 = 0;
        var ci: u32 = 0;
        for (ci < uw.code_count) {
            if (!used[ci::usize]
                && (best < 0 || uw.codes[ci].end_off > best_off)) {
                best = ci::i32;
                best_off = uw.codes[ci].end_off;
            }
            ci = ci + 1;
        }
        if (best < 0) { brk; }
        val c: *UnwindCode = ?uw.codes[best::u32];
        val slot_off: usize = xoff + 4 + slots_written * 2;
        buf[slot_off] = c.end_off;
        buf[slot_off + 1] = c.op | (c.info << 4);
        slots_written = slots_written + 1;
        if (c.extra_slots >= 1) {
            bin.write_u16_le(buf, xoff + 4 + slots_written * 2, c.extra0);
            slots_written = slots_written + 1;
        }
        if (c.extra_slots >= 2) {
            bin.write_u16_le(buf, xoff + 4 + slots_written * 2, c.extra1);
            slots_written = slots_written + 1;
        }
        used[best::usize] = true;
        codes_written = codes_written + 1;
    }
}

fun sort_runtime_functions(buf: *u8, off: usize, count: u32) {
    var i: u32 = 1;
    for (i < count) {
        val at: usize = off + i::usize * RUNTIME_FUNCTION_SIZE;
        val kb: u32 = bin.read_u32_le(buf, at);
        val ke: u32 = bin.read_u32_le(buf, at + 4);
        val ku: u32 = bin.read_u32_le(buf, at + 8);
        var j: u32 = i;
        for (j > 0) {
            val prev: usize = off + (j - 1)::usize * RUNTIME_FUNCTION_SIZE;
            val pb: u32 = bin.read_u32_le(buf, prev);
            val pe: u32 = bin.read_u32_le(buf, prev + 4);
            val pu: u32 = bin.read_u32_le(buf, prev + 8);
            if (pb < kb || (pb == kb && (pe < ke || (pe == ke && pu <= ku)))) { brk; }
            val dst: usize = off + j::usize * RUNTIME_FUNCTION_SIZE;
            bin.write_u32_le(buf, dst, pb);
            bin.write_u32_le(buf, dst + 4, pe);
            bin.write_u32_le(buf, dst + 8, pu);
            j = j - 1;
        }
        val dst: usize = off + j::usize * RUNTIME_FUNCTION_SIZE;
        bin.write_u32_le(buf, dst, kb);
        bin.write_u32_le(buf, dst + 4, ke);
        bin.write_u32_le(buf, dst + 8, ku);
        i = i + 1;
    }
}

fun write_pe_unwind(buf: *u8, lay: *PeLayout, uws: *FunctionUnwind, uw_count: u32,
                    exceptions: *of.Section, exception_count: u32) {
    if (!lay.have_pdata) { ret; }

    var xcur: usize = 0;
    var i: u32 = 0;
    for (i < uw_count) {
        uws[i].xdata_rva = lay.xdata_sec.rva + xcur::u64;
        write_unwind_xdata(buf, lay, ?uws[i]);
        xcur = xcur + uws[i].xdata_size;
        i = i + 1;
    }

    var row: u32 = 0;
    var s: u32 = 0;
    for (s < exception_count) {
        var src: usize = 0;
        for (src < exceptions[s].len::usize) {
            val poff: usize = lay.pdata_sec.file_off + row::usize * RUNTIME_FUNCTION_SIZE;
            bin.write_u32_le(buf, poff, bin.read_u32_le(exceptions[s].bytes, src));
            bin.write_u32_le(buf, poff + 4, bin.read_u32_le(exceptions[s].bytes, src + 4));
            bin.write_u32_le(buf, poff + 8, bin.read_u32_le(exceptions[s].bytes, src + 8));
            row = row + 1;
            src = src + RUNTIME_FUNCTION_SIZE;
        }
        s = s + 1;
    }

    i = 0;
    for (i < uw_count) {
        val poff: usize = lay.pdata_sec.file_off + row::usize * RUNTIME_FUNCTION_SIZE;
        val seg_rva: u64 = lay.seg_secs[uws[i].seg_index].content_rva;
        val begin_rva: u32 = (seg_rva + uws[i].seg_offset::u64)::u32;
        bin.write_u32_le(buf, poff, begin_rva);
        bin.write_u32_le(buf, poff + 4, begin_rva + uws[i].size);
        bin.write_u32_le(buf, poff + 8, uws[i].xdata_rva::u32);
        row = row + 1;
        i = i + 1;
    }
    sort_runtime_functions(buf, lay.pdata_sec.file_off, row);
}

fun patch_pe_fixups(buf: *u8, lay: *PeLayout, dyn: *of.DynamicInfo, fixups: *of.PltFixup,
                    fixup_count: u32, segs: *of.LoadSegment, seg_count: u32) R.Result[R.Void, str] {
    if (dyn == nil || lay.nimp == 0) { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < fixup_count) {
        val fx: *of.PltFixup = ?fixups[i];
        if (fx.seg_index >= seg_count) {
            ret R.err[R.Void, str]("coff: dynamic call-site fixup references an out-of-range segment");
        }
        val ord: u32 = func_ordinal(dyn, fx.import_index);
        if (ord == 0xFFFFFFFF) {
            ret R.err[R.Void, str]("coff: dynamic call-site fixup targets a non-function import");
        }
        if (fx.seg_offset::usize + 4 > segs[fx.seg_index].filesz) {
            ret R.err[R.Void, str]("coff: dynamic call-site fixup offset out of range");
        }

        val stub_va: u64 = lay.image_base + lay.stub_sec.rva
                           + ord::u64 * IMPORT_STUB_SIZE::u64;
        val disp_r: R.Result[i64, str] =
            pe_rel32_disp(stub_va, fx.addend, fx.patch_vaddr);
        if (R.is_err[i64, str](disp_r)) {
            ret R.err[R.Void, str]("coff: dynamic call-site displacement overflows 32 bits");
        }
        val disp: i64 = R.unwrap_ok[i64, str](disp_r);

        val file_off: usize = lay.seg_secs[fx.seg_index].content_file_off + fx.seg_offset::usize;
        bin.write_u32_le(buf, file_off, (disp::u64)::u32);
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun pe_rel32_disp(target_va: u64, addend: i64,
                  patch_va: u64) R.Result[i64, str] {
    val i64_max: i64 = 9223372036854775807;
    val i64_min: i64 = -9223372036854775807 - 1;
    if (target_va > i64_max::u64 || patch_va > i64_max::u64) {
        ret R.err[i64, str]("coff: PE rel32 address exceeds the signed range");
    }
    val delta: i64 = target_va::i64 - patch_va::i64;
    if ((addend > 0 && delta > i64_max - addend)
        || (addend < 0 && delta < i64_min - addend)) {
        ret R.err[i64, str]("coff: PE rel32 signed arithmetic overflow");
    }
    val disp: i64 = delta + addend;
    if (disp > 2147483647 || disp < -2147483648) {
        ret R.err[i64, str]("coff: PE rel32 displacement overflows 32 bits");
    }
    ret R.ok[i64, str](disp);
}

fun patch_pe_import_addr_fixups(buf: *u8, lay: *PeLayout, dyn: *of.DynamicInfo,
                                segs: *of.LoadSegment,
                                seg_count: u32) R.Result[R.Void, str] {
    if (dyn == nil || dyn.import_addr_fixup_count == 0) {
        ret R.ok_void[str]();
    }
    if (dyn.import_addr_fixups == nil) {
        ret R.err[R.Void, str]("coff: nil import-address fixup array");
    }
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        val fx: *of.ImportAddrFixup = ?dyn.import_addr_fixups[i];
        if (fx.kind != of.RK_PC32) {
            ret R.err[R.Void, str]("coff: unsupported import-address relocation kind");
        }
        if (fx.import_index >= dyn.import_count) {
            ret R.err[R.Void, str]("coff: import-address fixup targets an out-of-range import");
        }
        if (fx.seg_index >= seg_count) {
            ret R.err[R.Void, str]("coff: import-address fixup references an out-of-range segment");
        }
        if (fx.seg_offset::usize + 4 > segs[fx.seg_index].filesz) {
            ret R.err[R.Void, str]("coff: import-address fixup offset out of range");
        }

        val slot_rva: u64 = pe_import_iat_slot_rva(lay, dyn, fx.import_index);
        if (slot_rva == 0 || lay.image_base > 0xFFFFFFFFFFFFFFFF - slot_rva) {
            ret R.err[R.Void, str]("coff: import-address fixup has no valid IAT slot");
        }
        val disp_r: R.Result[i64, str] =
            pe_rel32_disp(lay.image_base + slot_rva, fx.addend, fx.patch_vaddr);
        if (R.is_err[i64, str](disp_r)) {
            ret R.err[R.Void, str]("coff: import-address displacement overflows 32 bits");
        }

        val file_off: usize = lay.seg_secs[fx.seg_index].content_file_off
                              + fx.seg_offset::usize;
        bin.write_u32_le(buf, file_off,
                         (R.unwrap_ok[i64, str](disp_r)::u64)::u32);
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun write_section_name_field(buf: *u8, pos: usize, name: str, str_pos: *usize) {
    if (name_in_strtab(name)) {
        memory.raw_zero((buf::usize + pos)::ptr, 8);
        buf[pos] = '/';
        write_decimal(buf, pos + 1, 7, (@str_pos)::u32);
        @str_pos = @str_pos + str_len(name) + 1;
    }
    or {
        write_inline_name(buf, pos, name);
    }
}

fun write_pe_section_header(buf: *u8, pos: usize, name: str, str_pos: *usize, sec: *PeSection, chars: u32) {
    write_section_name_field(buf, pos, name, str_pos);
    bin.write_u32_le(buf, pos + 8, sec.vsize::u32);
    bin.write_u32_le(buf, pos + 12, sec.rva::u32);
    bin.write_u32_le(buf, pos + 16, sec.file_size::u32);
    if (sec.file_size > 0) { bin.write_u32_le(buf, pos + 20, sec.file_off::u32); }
    or { bin.write_u32_le(buf, pos + 20, 0); }
    bin.write_u32_le(buf, pos + 24, 0);
    bin.write_u32_le(buf, pos + 28, 0);
    bin.write_u16_le(buf, pos + 32, 0);
    bin.write_u16_le(buf, pos + 34, 0);
    bin.write_u32_le(buf, pos + 36, chars);
}

val PE_DEFAULT_STACK_RESERVE: u64 = 0x800000;
val PE_DEFAULT_STACK_COMMIT:  u64 = 0x1000;

fun write_pe_headers(buf: *u8, lay: *PeLayout, segs: *of.LoadSegment, seg_count: u32, entry: u64, pie: bool,
                     itn: *intern.Interner, dyn: *of.DynamicInfo, debug: *of.Section, debug_count: u32,
                     subsystem: of.Subsystem, stack_reserve: u64, stack_commit: u64) R.Result[R.Void, str] {
    buf[0] = 'M'; buf[1] = 'Z';
    val pe_off: usize = DOS_HEADER_SIZE;
    bin.write_u32_le(buf, 0x3C, pe_off::u32);

    buf[pe_off] = 'P'; buf[pe_off + 1] = 'E'; buf[pe_off + 2] = 0; buf[pe_off + 3] = 0;

    val ch: usize = pe_off + PE_SIGNATURE_SIZE;
    bin.write_u16_le(buf, ch, IMAGE_FILE_MACHINE_AMD64);
    bin.write_u16_le(buf, ch + 2, lay.sec_total::u16);
    bin.write_u32_le(buf, ch + 4, 0);
    bin.write_u32_le(buf, ch + 8, lay.strtab_off::u32);
    bin.write_u32_le(buf, ch + 12, 0);
    bin.write_u16_le(buf, ch + 16, OPTIONAL_HEADER_SIZE::u16);
    var characteristics: u16 = IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE
        | IMAGE_FILE_LINE_NUMS_STRIPPED | IMAGE_FILE_LOCAL_SYMS_STRIPPED;
    if (!pie) { characteristics = characteristics | IMAGE_FILE_RELOCS_STRIPPED; }
    bin.write_u16_le(buf, ch + 18, characteristics);

    val oh: usize = ch + COFF_HEADER_SIZE;
    bin.write_u16_le(buf, oh, PE32PLUS_MAGIC);
    buf[oh + 2] = 14; buf[oh + 3] = 0;

    bin.write_u32_le(buf, oh + 16, (entry - lay.image_base)::u32);
    bin.write_u32_le(buf, oh + 20, lay.seg_secs[0].rva::u32);

    bin.write_u64_le(buf, oh + 24, lay.image_base);
    bin.write_u32_le(buf, oh + 32, PE_SECTION_ALIGN::u32);
    bin.write_u32_le(buf, oh + 36, PE_FILE_ALIGN::u32);

    bin.write_u16_le(buf, oh + 40, 6); bin.write_u16_le(buf, oh + 42, 0);
    bin.write_u16_le(buf, oh + 44, 0); bin.write_u16_le(buf, oh + 46, 0);
    bin.write_u16_le(buf, oh + 48, 6); bin.write_u16_le(buf, oh + 50, 0);
    bin.write_u32_le(buf, oh + 52, 0);

    bin.write_u32_le(buf, oh + 56, lay.image_size::u32);
    bin.write_u32_le(buf, oh + 60, lay.header_size::u32);
    bin.write_u32_le(buf, oh + 64, 0);

    var subsys: u16 = IMAGE_SUBSYSTEM_WINDOWS_CUI;
    if (subsystem == of.SUBSYSTEM_GUI) { subsys = IMAGE_SUBSYSTEM_WINDOWS_GUI; }
    bin.write_u16_le(buf, oh + 68, subsys);
    var dllchars: u16 = IMAGE_DLLCHARACTERISTICS_NX_COMPAT;
    if (pie) { dllchars = dllchars | IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE; }
    bin.write_u16_le(buf, oh + 70, dllchars);

    var stack_res: u64 = PE_DEFAULT_STACK_RESERVE;
    var stack_com: u64 = PE_DEFAULT_STACK_COMMIT;
    if (stack_reserve != 0) { stack_res = stack_reserve; }
    if (stack_commit  != 0) { stack_com = stack_commit; }
    bin.write_u64_le(buf, oh + 72, stack_res); bin.write_u64_le(buf, oh + 80, stack_com);
    bin.write_u64_le(buf, oh + 88, PE_DEFAULT_STACK_RESERVE); bin.write_u64_le(buf, oh + 96, PE_DEFAULT_STACK_COMMIT);
    bin.write_u32_le(buf, oh + 104, 0);
    bin.write_u32_le(buf, oh + 108, IMAGE_NUMBEROF_DIRECTORY_ENTRIES);

    val dd: usize = oh + 112;
    if (lay.have_idata) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IMPORT::usize * DATA_DIR_SIZE, lay.import_dir_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IMPORT::usize * DATA_DIR_SIZE + 4, lay.import_dir_size::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IAT::usize * DATA_DIR_SIZE, lay.iat_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IAT::usize * DATA_DIR_SIZE + 4, lay.iat_size::u32);
    }
    if (lay.have_rsrc) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_RESOURCE::usize * DATA_DIR_SIZE, lay.resource_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_RESOURCE::usize * DATA_DIR_SIZE + 4, lay.resource_size::u32);
    }
    if (lay.have_pdata) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE, lay.exception_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE + 4, lay.exception_size::u32);
    }
    if (lay.have_reloc) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_BASERELOC::usize * DATA_DIR_SIZE, lay.basereloc_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_BASERELOC::usize * DATA_DIR_SIZE + 4, lay.basereloc_size::u32);
    }

    val sec_table: usize = oh + OPTIONAL_HEADER_SIZE;
    var pos: usize = sec_table;
    var str_pos: usize = 4;
    var li: u32 = 0;
    for (li < seg_count) {
        val has_data: bool = segs[li].bytes != nil && segs[li].filesz > 0;
        write_pe_section_header(buf, pos, segment_name(segs[li].flags, has_data, seg_is_relro(dyn, segs, li)),
            ?str_pos, ?lay.seg_secs[li], pe_section_flags(segs[li].flags, has_data));
        pos = pos + SECTION_HEADER_SIZE;
        li = li + 1;
    }
    if (lay.have_stub) {
        write_pe_section_header(buf, pos, ".itext", ?str_pos, ?lay.stub_sec,
            IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ);
        pos = pos + SECTION_HEADER_SIZE;
    }
    if (lay.have_idata) {
        write_pe_section_header(buf, pos, ".idata", ?str_pos, ?lay.idata_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE);
        pos = pos + SECTION_HEADER_SIZE;
    }
    if (lay.have_xdata) {
        write_pe_section_header(buf, pos, ".xdata", ?str_pos, ?lay.xdata_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
        pos = pos + SECTION_HEADER_SIZE;
    }
    if (lay.have_pdata) {
        write_pe_section_header(buf, pos, ".pdata", ?str_pos, ?lay.pdata_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
        pos = pos + SECTION_HEADER_SIZE;
    }
    if (lay.have_rsrc) {
        write_pe_section_header(buf, pos, ".rsrc", ?str_pos, ?lay.rsrc_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
        pos = pos + SECTION_HEADER_SIZE;
    }
    if (lay.have_reloc) {
        write_pe_section_header(buf, pos, ".reloc", ?str_pos, ?lay.reloc_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_DISCARDABLE);
        pos = pos + SECTION_HEADER_SIZE;
    }

    var di: u32 = 0;
    for (di < debug_count) {
        val nm: str = bin.resolve_name(itn, debug[di].name);
        write_section_name_field(buf, pos, nm, ?str_pos);
        bin.write_u32_le(buf, pos + 8, lay.debug_secs[di].vsize::u32);
        bin.write_u32_le(buf, pos + 12, lay.debug_secs[di].rva::u32);
        bin.write_u32_le(buf, pos + 16, lay.debug_secs[di].file_size::u32);
        if (lay.debug_secs[di].file_size > 0) { bin.write_u32_le(buf, pos + 20, lay.debug_secs[di].file_off::u32); }
        or                                    { bin.write_u32_le(buf, pos + 20, 0); }
        bin.write_u32_le(buf, pos + 24, 0);
        bin.write_u32_le(buf, pos + 28, 0);
        bin.write_u16_le(buf, pos + 32, 0);
        bin.write_u16_le(buf, pos + 34, 0);
        bin.write_u32_le(buf, pos + 36, IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_DISCARDABLE);
        pos = pos + SECTION_HEADER_SIZE;
        di = di + 1;
    }

    var code_size:  u64 = 0;
    var idata_size: u64 = 0;
    var udata_size: u64 = 0;
    sum_pe_section_content(buf, sec_table, lay.sec_total, ?code_size, ?idata_size, ?udata_size);
    if (code_size > 0xFFFFFFFF || idata_size > 0xFFFFFFFF || udata_size > 0xFFFFFFFF) {
        ret R.err[R.Void, str]("coff: PE aggregate section sizes exceed 32-bit header fields");
    }
    bin.write_u32_le(buf, oh + 4, code_size::u32);
    bin.write_u32_le(buf, oh + 8, idata_size::u32);
    bin.write_u32_le(buf, oh + 12, udata_size::u32);

    ret R.ok_void[str]();
}

fun sum_pe_section_content(buf: *u8, sec_table: usize, nsec: u32,
                           code: *u64, idata: *u64, udata: *u64) {
    @code = 0; @idata = 0; @udata = 0;
    var s: u32 = 0;
    for (s < nsec) {
        val sh:    usize = sec_table + s::usize * SECTION_HEADER_SIZE;
        val chars: u32   = bin.read_u32_le(buf, sh + 36);
        val raw:   u64   = bin.read_u32_le(buf, sh + 16)::u64;
        val vsize: u64   = bin.read_u32_le(buf, sh + 8)::u64;
        if ((chars & IMAGE_SCN_CNT_CODE) != 0)               { @code  = @code  + raw; }
        if ((chars & IMAGE_SCN_CNT_INITIALIZED_DATA) != 0)   { @idata = @idata + raw; }
        if ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0) { @udata = @udata + vsize; }
        s = s + 1;
    }
}

fun seg_is_rebased(dyn: *of.DynamicInfo, ls: u32) bool {
    if (dyn == nil) { ret false; }
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == ls) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun seg_is_relro(dyn: *of.DynamicInfo, segs: *of.LoadSegment, ls: u32) bool {
    if ((segs[ls].flags & (of.SEG_FLAG_WRITE | of.SEG_FLAG_EXECUTE)) != 0) { ret false; }
    ret seg_is_rebased(dyn, ls);
}

fun segment_name(flags: u32, has_data: bool, relro: bool) str {
    if ((flags & of.SEG_FLAG_EXECUTE) != 0) { ret ".text"; }
    if (!has_data)                          { ret ".bss"; }
    if ((flags & of.SEG_FLAG_WRITE) != 0)   { ret ".data"; }
    if (relro)                              { ret ".data.rel.ro"; }
    ret ".rdata";
}

fun pe_executable_section_location(image_base: u64, content_vaddr: u64,
                                   segment_index: u32) of.ExecutableSectionLocation {
    var loc: of.ExecutableSectionLocation;
    loc.vaddr = content_vaddr;
    if (segment_index == 0) { loc.vaddr = image_base + PE_SECTION_ALIGN; }
    loc.ordinal = segment_index + 1;
    ret loc;
}

test "mach.lang.target.of.coff.write_decimal:left_justified" {
    var buf: [8]u8;
    var i: usize = 0;
    for (i < 8) { buf[i] = 0xaa; i = i + 1; }

    buf[0] = '/';
    write_decimal(?buf[0], 1, 7, 4);
    if (buf[0] != '/' || buf[1] != '4') { ret 1; }
    i = 2;
    for (i < 8) { if (buf[i] != 0) { ret 1; } i = i + 1; }

    write_decimal(?buf[0], 1, 7, 1048576);
    if (buf[1] != '1' || buf[2] != '0' || buf[3] != '4' || buf[4] != '8') { ret 1; }
    if (buf[5] != '5' || buf[6] != '7' || buf[7] != '6') { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.pe_executable_section_location:alignment_prefix" {
    val first: of.ExecutableSectionLocation =
        pe_executable_section_location(0x140000000, 0x140002000, 0);
    val second: of.ExecutableSectionLocation =
        pe_executable_section_location(0x140000000, 0x140005000, 1);
    if (first.vaddr != 0x140001000 || first.ordinal != 1) { ret 1; }
    if (second.vaddr != 0x140005000 || second.ordinal != 2) { ret 1; }
    ret 0;
}

pub fun register_coff(reg: *of.OfRegistry) R.Result[R.Void, str] {
    var coff_vtable: of.OfVTable = of.linker_vtable(
        of.OF_COFF, of.of_name_for(of.OF_COFF), "o",
        coff_emit_object, coff_parse_object, coff_emit_exec
    );
    of.with_dynamic_exec(?coff_vtable, coff_emit_dyn_exec);

    coff_vtable.two_level_namespace = true;

    coff_vtable.default_debug    = "";
    coff_vtable.shared_input_ext = ".dll";
    coff_vtable.import_address_prefix = "__imp_";
    coff_vtable.header_in_first_segment = false;
    coff_vtable.carries_stack_size = true;
    coff_vtable.default_stack_reserve = PE_DEFAULT_STACK_RESERVE;
    coff_vtable.executable_section_location = pe_executable_section_location;

    coff_vtable.covers_isa_any   = false;
    coff_vtable.covers_isa_count = 0;
    of.cover_isa(?coff_vtable, isa.ARCH_X86_64);

    ret of.register(reg, ?coff_vtable);
}

fun t_isa(id: u32) of.ObjectTarget {
    var vt: isa.IsaVTable = isa.machine_isa(id, "test", 0, 8, nil, nil, nil);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

fun t_intern(i: *intern.Interner, s: str) intern.StrId {
    val r: R.Result[intern.StrId, str] = intern.intern(i, s);
    if (R.is_err[intern.StrId, str](r)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

test "mach.lang.target.of.coff.emit_object:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [17]u8;
    var k: usize = 0;
    for (k < 17) { text_bytes[k] = 0x90; k = k + 1; }
    var data_bytes: [3]u8;
    data_bytes[0] = 1; data_bytes[1] = 2; data_bytes[2] = 3;

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 17; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 3; secs[1].align = 8;
    secs[2].name = t_intern(?i, ".bss"); secs[2].kind = of.SK_BSS;
    secs[2].bytes = nil; secs[2].len = 64; secs[2].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 17; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "a_long_global_variable_name"); syms[1].section = 1;
    syms[1].offset = 0; syms[1].size = 3;
    syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_size");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 2; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 3; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val symptr: usize = bin.read_u32_le(buf.data, 8)::usize;
    val nsyms:  usize = bin.read_u32_le(buf.data, 12)::usize;
    if (symptr == 0 || nsyms == 0) { ret 4; }
    val strtab_off: usize = symptr + nsyms * SYMBOL_SIZE;
    if (strtab_off + 4 > buf.len)  { ret 5; }
    val strtab_sz: usize = bin.read_u32_le(buf.data, strtab_off)::usize;
    if (strtab_off + strtab_sz != buf.len) { ret 6; }
    ret 0;
}

test "mach.lang.target.of.coff:emit_parse_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = (0xE8 + k)::u8; k = k + 1; }
    var data_bytes: [4]u8;
    data_bytes[0] = 0xDE; data_bytes[1] = 0xAD; data_bytes[2] = 0xBE; data_bytes[3] = 0xEF;

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".data"); secs[1].kind = of.SK_DATA;
    secs[1].bytes = ?data_bytes[0]; secs[1].len = 4; secs[1].align = 4;
    secs[2].name = t_intern(?i, ".bss"); secs[2].kind = of.SK_BSS;
    secs[2].bytes = nil; secs[2].len = 16; secs[2].align = 8;

    var syms: [3]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "gvar"); syms[1].section = 1; syms[1].offset = 0;
    syms[1].size = 4; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    syms[2].name = t_intern(?i, "puts"); syms[2].section = of.SECTION_EXTERNAL;
    syms[2].offset = 0; syms[2].size = 0; syms[2].flags = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [2]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 2; relocs[0].addend = -4;
    relocs[1].section = 0; relocs[1].offset = 4; relocs[1].kind = of.RK_ABS64;
    relocs[1].sym = 1; relocs[1].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 3;
    img.relocations = ?relocs[0]; img.reloc_count = 2;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_rt");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u16_le(buf.data, 0) != IMAGE_FILE_MACHINE_AMD64) { ret 1; }
    if (bin.read_u16_le(buf.data, 2) != 3)                        { ret 1; }
    if (bin.read_u16_le(buf.data, 16) != 0)                       { ret 1; }
    if (bin.read_u32_le(buf.data, 12) != 9)                       { ret 1; }

    val sh0: usize = COFF_HEADER_SIZE;
    val chars0: u32 = bin.read_u32_le(buf.data, sh0 + 36);
    if ((chars0 & IMAGE_SCN_CNT_CODE) == 0)       { ret 1; }
    if ((chars0 & IMAGE_SCN_MEM_EXECUTE) == 0)    { ret 1; }
    if (bin.read_u16_le(buf.data, sh0 + 32) != 2) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 3) { ret 1; }
    if (out.symbol_count != 6) { ret 1; }
    if (out.reloc_count != 2)  { ret 1; }

    if (out.sections[0].kind != of.SK_TEXT || out.sections[0].len != 16) { ret 1; }
    if (out.sections[1].kind != of.SK_DATA || out.sections[1].len != 4)  { ret 1; }
    if (out.sections[2].kind != of.SK_BSS  || out.sections[2].len != 16) { ret 1; }
    if (out.sections[0].align != 16 || out.sections[1].align != 4)       { ret 1; }

    if (out.sections[0].bytes == nil) { ret 1; }
    k = 0;
    for (k < 16) {
        if (out.sections[0].bytes[k] != (0xE8 + k)::u8) { ret 1; }
        k = k + 1;
    }
    if (out.sections[2].bytes != nil) { ret 1; }

    var saw_main: bool = false;
    var saw_puts: bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[0].name) {
            saw_main = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
            if (out.symbols[si].section != 0)                            { ret 1; }
        }
        if (out.symbols[si].name == syms[2].name) {
            saw_puts = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) == 0) { ret 1; }
            if (out.symbols[si].section != of.SECTION_EXTERNAL)        { ret 1; }
        }
        si = si + 1;
    }
    if (!saw_main || !saw_puts) { ret 1; }

    var saw_pc32: bool = false;
    var saw_abs64: bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        if (out.relocations[rj].section != 0) { ret 1; }
        if (out.relocations[rj].offset == 1 && out.relocations[rj].kind == of.RK_PC32
            && of.reloc_symbol_name(?out, ?out.relocations[rj]) == syms[2].name) { saw_pc32 = true; }
        if (out.relocations[rj].offset == 4 && out.relocations[rj].kind == of.RK_ABS64
            && of.reloc_symbol_name(?out, ?out.relocations[rj]) == syms[1].name) { saw_abs64 = true; }
        rj = rj + 1;
    }
    if (!saw_pc32 || !saw_abs64) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff:frame_record_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "deep"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "wfn"); syms[1].section = 0; syms[1].offset = 8;
    syms[1].size = 8;
    syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK | of.SYM_OBJ_FLAG_FUNCTION;

    var frames: [2]of.FrameUnwind;
    frames[0].section = 0; frames[0].offset = 0; frames[0].step_count = 2;
    frames[0].steps[0].kind = of.FRAME_STEP_PUSH;  frames[0].steps[0].reg = 5; frames[0].steps[0].end_off = 1;    frames[0].steps[0].value = 0;
    frames[0].steps[1].kind = of.FRAME_STEP_ALLOC; frames[0].steps[1].reg = 0; frames[0].steps[1].end_off = 0x2D; frames[0].steps[1].value = 0x6040;
    frames[1].section = 0; frames[1].offset = 8; frames[1].step_count = 2;
    frames[1].steps[0].kind = of.FRAME_STEP_PUSH; frames[1].steps[0].reg = 5; frames[1].steps[0].end_off = 1; frames[1].steps[0].value = 0;
    frames[1].steps[1].kind = of.FRAME_STEP_SAVE; frames[1].steps[1].reg = 3; frames[1].steps[1].end_off = 8; frames[1].steps[1].value = 0x18;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "frt");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.frames = ?frames[0]; img.frame_count = 2;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_frt");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 2; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 3; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 4; }

    if (out.frame_count != 2) { ret 5; }

    val deep_id: intern.StrId = t_intern(?i, "deep");
    val wfn_id: intern.StrId = t_intern(?i, "wfn");
    var seen_deep: bool = false;
    var seen_wfn: bool = false;
    var fi: u32 = 0;
    for (fi < out.frame_count) {
        val fr: *of.FrameUnwind = ?out.frames[fi];
        var sy: u32 = 0;
        for (sy < out.symbol_count) {
            val sym: *of.Symbol = ?out.symbols[sy];
            if ((sym.flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { sy = sy + 1; cnt; }
            if (sym.section != fr.section || sym.offset != fr.offset) { sy = sy + 1; cnt; }
            if (sym.name == deep_id) {
                if (fr.step_count != 2)                          { ret 6; }
                if (fr.steps[1].kind != of.FRAME_STEP_ALLOC)     { ret 7; }
                if (fr.steps[1].value != 0x6040)                 { ret 8; }
                if (fr.steps[1].end_off != 0x2D)                 { ret 9; }
                seen_deep = true;
            }
            if (sym.name == wfn_id) {
                if (fr.step_count != 2)                      { ret 10; }
                if (fr.steps[1].kind != of.FRAME_STEP_SAVE)  { ret 11; }
                if (fr.steps[1].reg != 3)                    { ret 12; }
                if (fr.steps[1].value != 0x18)               { ret 13; }
                seen_wfn = true;
            }
            sy = sy + 1;
        }
        fi = fi + 1;
    }
    if (!seen_deep || !seen_wfn) { ret 14; }

    var deep_sec: u32 = 0xFFFFFFFF;
    var wfn_sec: u32 = 0xFFFFFFFF;
    var sy2: u32 = 0;
    for (sy2 < out.symbol_count) {
        if (out.symbols[sy2].name == deep_id) { deep_sec = out.symbols[sy2].section; }
        if (out.symbols[sy2].name == wfn_id)  { wfn_sec = out.symbols[sy2].section; }
        sy2 = sy2 + 1;
    }
    if (deep_sec == wfn_sec) { ret 15; }

    val frames_id: intern.StrId = t_intern(?i, MACH_FRAMES_SECTION_NAME);
    var si: u32 = 0;
    for (si < out.section_count) {
        if (out.sections[si].name == frames_id) {
            if (out.sections[si].len != 0 || out.sections[si].bytes != nil) { ret 16; }
        }
        si = si + 1;
    }

    ret 0;
}

test "mach.lang.target.of.coff:exception_section_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var pdata: [12]u8;
    bin.write_u32_le(?pdata[0], 0, 0x1000);
    bin.write_u32_le(?pdata[0], 4, 0x1010);
    bin.write_u32_le(?pdata[0], 8, 0x2000);
    var sec: of.Section;
    sec.name = t_intern(?i, ".pdata"); sec.kind = of.SK_EXCEPTION;
    sec.bytes = ?pdata[0]; sec.len = 12; sec.align = 4;

    var img: of.ObjectImage;
    img.alloc = ?alloc; img.interner = ?i; img.name = t_intern(?i, "pdata_test");
    img.sections = ?sec; img.section_count = 1;
    img.symbols = nil; img.symbol_count = 0;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_pdata_rt");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }
    if (out.section_count != 1 || out.sections[0].kind != of.SK_EXCEPTION) { ret 1; }
    if (out.sections[0].len != 12 || out.sections[0].bytes == nil) { ret 1; }
    if (bin.read_u32_le(out.sections[0].bytes, 0) != 0x1000) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff:relro_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var ro_bytes:   [8]u8;
    var rel_bytes:  [8]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0; ro_bytes[k] = 0; rel_bytes[k] = 0; k = k + 1; }

    var secs: [3]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".rdata"); secs[1].kind = of.SK_RODATA;
    secs[1].bytes = ?ro_bytes[0]; secs[1].len = 8; secs[1].align = 8;
    secs[2].name = t_intern(?i, ".data.rel.ro"); secs[2].kind = of.SK_RELRO;
    secs[2].bytes = ?rel_bytes[0]; secs[2].len = 8; secs[2].align = 8;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 2; relocs[0].offset = 0; relocs[0].kind = of.RK_ABS64;
    relocs[0].sym = 0; relocs[0].addend = 0x20;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 3;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_relro");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 3) { ret 1; }
    if (out.sections[0].kind != of.SK_TEXT)   { ret 1; }
    if (out.sections[1].kind != of.SK_RODATA) { ret 1; }
    if (out.sections[2].kind != of.SK_RELRO)  { ret 1; }

    if (out.reloc_count != 1) { ret 1; }
    if (out.relocations[0].kind != of.RK_ABS64 || out.relocations[0].addend != 0x20) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.preserve_weak_external_fallbacks:modes" {
    var records: [54]u8;
    var z: usize = 0;
    for (z < 54) { records[z] = 0; z = z + 1; }

    write_sym_tail(?records[0], 0, false, IMAGE_SYM_UNDEFINED::i32, 0,
                   IMAGE_SYM_CLASS_WEAK_EXTERNAL, 1);
    bin.write_u32_le(?records[0], SYMBOL_SIZE, 2);
    write_sym_tail(?records[0], SYMBOL_SIZE * 2, false, 1,
                   IMAGE_SYM_DTYPE_FUNCTION, IMAGE_SYM_CLASS_EXTERNAL, 0);

    var rec_map: [3]i32;
    rec_map[0] = 0; rec_map[1] = 0; rec_map[2] = 1;
    var symbols: [2]of.Symbol;
    symbols[0].name = intern.STR_NIL; symbols[0].section = of.SECTION_EXTERNAL;
    symbols[0].offset = 0; symbols[0].size = 0;
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK
        | of.SYM_OBJ_FLAG_EXTERN;
    symbols[0].fallback = of.SYMBOL_NONE;
    symbols[1].name = intern.STR_NIL; symbols[1].section = 0;
    symbols[1].offset = 17; symbols[1].size = 23;
    symbols[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    symbols[1].fallback = of.SYMBOL_NONE;
    var img: of.ObjectImage;
    img.symbols = ?symbols[0]; img.symbol_count = 2;

    var modes: [3]u32;
    modes[0] = IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY;
    modes[1] = IMAGE_WEAK_EXTERN_SEARCH_LIBRARY;
    modes[2] = IMAGE_WEAK_EXTERN_SEARCH_ALIAS;
    var mi: u32 = 0;
    for (mi < 3) {
        bin.write_u32_le(?records[0], SYMBOL_SIZE + 4, modes[mi]);
        symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK
            | of.SYM_OBJ_FLAG_EXTERN;
        symbols[0].fallback = of.SYMBOL_NONE;
        val nr: R.Result[R.Void, str] = preserve_weak_external_fallbacks(
            ?records[0], 0, 3, false, ?rec_map[0], ?img);
        if (R.is_err[R.Void, str](nr) || symbols[0].section != of.SECTION_EXTERNAL
            || symbols[0].fallback != 1
            || (symbols[0].flags & of.SYM_OBJ_FLAG_FALLBACK) == 0
            || (symbols[0].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
        if (((symbols[0].flags & of.SYM_OBJ_FLAG_SEARCH) != 0) != (mi == 1)) { ret 1; }
        if (((symbols[0].flags & of.SYM_OBJ_FLAG_ALIAS) != 0) != (mi == 2)) { ret 1; }
        mi = mi + 1;
    }

    bin.write_u32_le(?records[0], SYMBOL_SIZE, 99);
    val malformed: R.Result[R.Void, str] = preserve_weak_external_fallbacks(
        ?records[0], 0, 3, false, ?rec_map[0], ?img);
    if (!R.is_err[R.Void, str](malformed)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.preserve_weak_external_fallbacks:forward_chain" {
    var records: [90]u8;
    var z: usize = 0;
    for (z < 90) { records[z] = 0; z = z + 1; }
    write_sym_tail(?records[0], 0, false, 1, IMAGE_SYM_DTYPE_FUNCTION,
                   IMAGE_SYM_CLASS_EXTERNAL, 0);
    write_sym_tail(?records[0], SYMBOL_SIZE, false, IMAGE_SYM_UNDEFINED::i32, 0,
                   IMAGE_SYM_CLASS_WEAK_EXTERNAL, 1);
    bin.write_u32_le(?records[0], SYMBOL_SIZE * 2, 3);
    bin.write_u32_le(?records[0], SYMBOL_SIZE * 2 + 4, IMAGE_WEAK_EXTERN_SEARCH_ALIAS);
    write_sym_tail(?records[0], SYMBOL_SIZE * 3, false, IMAGE_SYM_UNDEFINED::i32, 0,
                   IMAGE_SYM_CLASS_WEAK_EXTERNAL, 1);
    bin.write_u32_le(?records[0], SYMBOL_SIZE * 4, 0);
    bin.write_u32_le(?records[0], SYMBOL_SIZE * 4 + 4, IMAGE_WEAK_EXTERN_SEARCH_ALIAS);

    var rec_map: [5]i32;
    rec_map[0] = 0; rec_map[1] = 1; rec_map[2] = 1; rec_map[3] = 2; rec_map[4] = 2;
    var symbols: [3]of.Symbol;
    var i: u32 = 0;
    for (i < 3) {
        symbols[i].name = (i + 1)::intern.StrId;
        symbols[i].section = of.SECTION_EXTERNAL;
        symbols[i].offset = 0; symbols[i].size = 0;
        symbols[i].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK
            | of.SYM_OBJ_FLAG_EXTERN;
        symbols[i].fallback = of.SYMBOL_NONE;
        i = i + 1;
    }
    symbols[0].section = 0;
    symbols[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var img: of.ObjectImage; img.symbols = ?symbols[0]; img.symbol_count = 3;
    val nr: R.Result[R.Void, str] = preserve_weak_external_fallbacks(
        ?records[0], 0, 5, false, ?rec_map[0], ?img);
    if (R.is_err[R.Void, str](nr) || symbols[1].fallback != 2
        || symbols[2].fallback != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff:weak_fallback_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "public");
    syms[0].section = of.SECTION_EXTERNAL; syms[0].offset = 0; syms[0].size = 0;
    syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_WEAK
        | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FALLBACK | of.SYM_OBJ_FLAG_SEARCH;
    syms[0].fallback = 1;
    syms[1].name = t_intern(?i, "fallback");
    syms[1].section = of.SECTION_EXTERNAL; syms[1].offset = 0; syms[1].size = 0;
    syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;
    syms[1].fallback = of.SYMBOL_NONE;
    var img: of.ObjectImage;
    img.alloc = ?alloc; img.interner = ?i; img.name = t_intern(?i, "weak_rt");
    img.sections = nil; img.section_count = 0;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = nil; img.reloc_count = 0;
    img.imports = nil; img.import_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_weak_rt");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] =
        t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);
    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] =
        coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr) || out.symbol_count != 2
        || out.symbols[0].fallback != 1
        || (out.symbols[0].flags & of.SYM_OBJ_FLAG_FALLBACK) == 0
        || (out.symbols[0].flags & of.SYM_OBJ_FLAG_SEARCH) == 0
        || (out.symbols[0].flags & of.SYM_OBJ_FLAG_ALIAS) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_parse_object:short_import_record" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var rec: [39]u8;
    var z: usize = 0;
    for (z < 39) { rec[z] = 0; z = z + 1; }
    rec[2] = 0xFF; rec[3] = 0xFF;
    rec[6] = 0x64; rec[7] = 0x86;
    rec[12] = 19;
    rec[18] = 0x04;
    val sym: str = "Sleep";
    val dll: str = "kernel32.dll";
    var k: usize = 0;
    for (k < 5)  { rec[20 + k] = sym[k]::u8; k = k + 1; }
    k = 0;
    for (k < 12) { rec[26 + k] = dll[k]::u8; k = k + 1; }

    var img: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?rec[0], 39, ?img);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (img.import_count != 1)  { ret 1; }
    if (img.section_count != 0) { ret 1; }
    if (img.symbol_count != 0)  { ret 1; }
    if (img.reloc_count != 0)   { ret 1; }

    val sn: O.Option[str] = intern.lookup(?i, img.imports[0].symbol);
    val en: O.Option[str] = intern.lookup(?i, img.imports[0].import_name);
    val ln: O.Option[str] = intern.lookup(?i, img.imports[0].library);
    if (!O.is_some[str](sn) || !str_equals(O.unwrap[str](sn), "Sleep"))        { ret 1; }
    if (!O.is_some[str](en) || !str_equals(O.unwrap[str](en), "Sleep"))        { ret 1; }
    if (!O.is_some[str](ln) || !str_equals(O.unwrap[str](ln), "kernel32.dll")) { ret 1; }
    if (!img.imports[0].by_name) { ret 1; }
    if (!img.imports[0].is_code) { ret 1; }

    rec[4] = BIGOBJ_MIN_VERSION::u8;
    var img2: of.ObjectImage;
    val br: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?rec[0], 39, ?img2);
    if (R.is_err[R.Void, str](br)) { ret 1; }
    if (img2.import_count != 1) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_parse_object:refuses_relocation_count_overflow" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val num_secs: u32 = 65538;
    val buf_size: usize = BIGOBJ_HEADER_SIZE + num_secs::usize * SECTION_HEADER_SIZE;
    val rb: R.Result[*u8, str] = A.zallocate[u8](?alloc, buf_size);
    if (R.is_err[*u8, str](rb)) { ret 1; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    bin.write_u16_le(buf, 0, IMAGE_FILE_MACHINE_UNKNOWN);
    bin.write_u16_le(buf, 2, BIGOBJ_SIG2);
    bin.write_u16_le(buf, 4, BIGOBJ_MIN_VERSION);
    bin.write_u16_le(buf, 6, IMAGE_FILE_MACHINE_AMD64);
    bin.write_u32_le(buf, 12, 0xD1BAA1C7);
    bin.write_u16_le(buf, 16, 0xBAEE);
    bin.write_u16_le(buf, 18, 0x4D16);
    buf[20] = 0xB4; buf[21] = 0x5F; buf[22] = 0x9E; buf[23] = 0x0E;
    buf[24] = 0x37; buf[25] = 0xDB; buf[26] = 0x40; buf[27] = 0xC1;
    bin.write_u32_le(buf, 44, num_secs);
    bin.write_u32_le(buf, 48, 0);
    bin.write_u32_le(buf, 52, 0);

    var s: u32 = 0;
    for (s < num_secs) {
        val sh: usize = BIGOBJ_HEADER_SIZE + s::usize * SECTION_HEADER_SIZE;
        bin.write_u16_le(buf, sh + 32, 0xFFFF);
        s = s + 1;
    }

    var img: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf, buf_size, ?img);

    A.deallocate[u8](?alloc, buf, buf_size);

    if (!R.is_err[R.Void, str](pr))                              { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "exceeds")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_parse_object:short_import_name_types" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var np: [40]u8;
    var z: usize = 0;
    for (z < 40) { np[z] = 0; z = z + 1; }
    np[2] = 0xFF; np[3] = 0xFF; np[6] = 0x64; np[7] = 0x86;
    np[12] = 20; np[18] = (IMPORT_OBJECT_NAME_NOPREFIX << 2)::u8;
    val np_sym: str = "_Sleep";
    val dll: str = "kernel32.dll";
    var k: usize = 0;
    for (k < 6)  { np[20 + k] = np_sym[k]::u8; k = k + 1; }
    k = 0;
    for (k < 12) { np[27 + k] = dll[k]::u8; k = k + 1; }
    var np_img: of.ObjectImage;
    val np_r: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?np[0], 40, ?np_img);
    if (R.is_err[R.Void, str](np_r)) { ret 1; }
    val np_public: O.Option[str] = intern.lookup(?i, np_img.imports[0].symbol);
    val np_export: O.Option[str] = intern.lookup(?i, np_img.imports[0].import_name);
    if (!O.is_some[str](np_public) || !str_equals(O.unwrap[str](np_public), "_Sleep")) { ret 1; }
    if (!O.is_some[str](np_export) || !str_equals(O.unwrap[str](np_export), "Sleep"))  { ret 1; }

    var ud: [42]u8;
    z = 0;
    for (z < 42) { ud[z] = 0; z = z + 1; }
    ud[2] = 0xFF; ud[3] = 0xFF; ud[6] = 0x64; ud[7] = 0x86;
    ud[12] = 22; ud[18] = (IMPORT_OBJECT_NAME_UNDECORATE << 2)::u8;
    val ud_sym: str = "_Sleep@4";
    k = 0;
    for (k < 8)  { ud[20 + k] = ud_sym[k]::u8; k = k + 1; }
    k = 0;
    for (k < 12) { ud[29 + k] = dll[k]::u8; k = k + 1; }
    var ud_img: of.ObjectImage;
    val ud_r: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?ud[0], 42, ?ud_img);
    if (R.is_err[R.Void, str](ud_r)) { ret 1; }
    val ud_public: O.Option[str] = intern.lookup(?i, ud_img.imports[0].symbol);
    val ud_export: O.Option[str] = intern.lookup(?i, ud_img.imports[0].import_name);
    if (!O.is_some[str](ud_public) || !str_equals(O.unwrap[str](ud_public), "_Sleep@4")) { ret 1; }
    if (!O.is_some[str](ud_export) || !str_equals(O.unwrap[str](ud_export), "Sleep"))    { ret 1; }

    var ea: [51]u8;
    z = 0;
    for (z < 51) { ea[z] = 0; z = z + 1; }
    ea[2] = 0xFF; ea[3] = 0xFF; ea[6] = 0x64; ea[7] = 0x86;
    ea[12] = 31; ea[18] = (IMPORT_OBJECT_NAME_EXPORTAS << 2)::u8;
    val ea_sym: str = "PublicName";
    val ea_dll: str = "demo.dll";
    val ea_export_name: str = "ExportName";
    k = 0;
    for (k < 10) { ea[20 + k] = ea_sym[k]::u8; k = k + 1; }
    k = 0;
    for (k < 8)  { ea[31 + k] = ea_dll[k]::u8; k = k + 1; }
    k = 0;
    for (k < 10) { ea[40 + k] = ea_export_name[k]::u8; k = k + 1; }
    var ea_img: of.ObjectImage;
    val ea_r: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?ea[0], 51, ?ea_img);
    if (R.is_err[R.Void, str](ea_r)) { ret 1; }
    val ea_public: O.Option[str] = intern.lookup(?i, ea_img.imports[0].symbol);
    val ea_export: O.Option[str] = intern.lookup(?i, ea_img.imports[0].import_name);
    if (!O.is_some[str](ea_public) || !str_equals(O.unwrap[str](ea_public), "PublicName")) { ret 1; }
    if (!O.is_some[str](ea_export) || !str_equals(O.unwrap[str](ea_export), "ExportName")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_parse_object:malformed_import_record" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var over: [24]u8;
    var z: usize = 0;
    for (z < 24) { over[z] = 0; z = z + 1; }
    over[2] = 0xFF; over[3] = 0xFF;
    over[6] = 0x64; over[7] = 0x86;
    over[12] = 64;
    var img1: of.ObjectImage;
    val r1: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?over[0], 24, ?img1);
    if (R.is_ok[R.Void, str](r1)) { ret 1; }

    var unterm: [24]u8;
    z = 0;
    for (z < 24) { unterm[z] = 0x41; z = z + 1; }
    unterm[0] = 0; unterm[1] = 0;
    unterm[2] = 0xFF; unterm[3] = 0xFF;
    unterm[4] = 0; unterm[5] = 0;
    unterm[6] = 0x64; unterm[7] = 0x86;
    unterm[8] = 0; unterm[9] = 0; unterm[10] = 0; unterm[11] = 0;
    unterm[12] = 4; unterm[13] = 0; unterm[14] = 0; unterm[15] = 0;
    unterm[16] = 0; unterm[17] = 0; unterm[18] = 4; unterm[19] = 0;
    var img2: of.ObjectImage;
    val r2: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?unterm[0], 24, ?img2);
    if (R.is_ok[R.Void, str](r2)) { ret 1; }

    unterm[18] = (5 << 2)::u8;
    var img3: of.ObjectImage;
    val r3: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?unterm[0], 24, ?img3);
    if (R.is_ok[R.Void, str](r3)) { ret 1; }
    unterm[18] = 0x20;
    var img4: of.ObjectImage;
    val r4: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, ?unterm[0], 24, ?img4);
    if (R.is_ok[R.Void, str](r4)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.read_inplace_addend:rel32_p4_convention" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f0: [4]u8;
    f0[0] = 0; f0[1] = 0; f0[2] = 0; f0[3] = 0;
    var sec0: of.Section;
    sec0.bytes = ?f0[0]; sec0.len = 4;
    if (read_inplace_addend(?sec0, IMAGE_REL_AMD64_REL32, 0) != -4)   { ret 1; }
    if (read_inplace_addend(?sec0, IMAGE_REL_AMD64_ADDR32NB, 0) != 0) { ret 1; }

    var f7: [4]u8;
    f7[0] = 7; f7[1] = 0; f7[2] = 0; f7[3] = 0;
    var sec7: of.Section;
    sec7.bytes = ?f7[0]; sec7.len = 4;
    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_REL32, 0) != 3)    { ret 1; }
    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_ADDR32NB, 0) != 7) { ret 1; }

    var f8: [8]u8;
    var b: usize = 0;
    for (b < 8) { f8[b] = 0; b = b + 1; }
    f8[0] = 0x21; f8[1] = 0x43;
    var sec8: of.Section;
    sec8.bytes = ?f8[0]; sec8.len = 8;
    if (read_inplace_addend(?sec8, IMAGE_REL_AMD64_ADDR64, 0) != 0x4321) { ret 1; }

    var i: intern.Interner = intern.init(?alloc);
    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    var k: usize = 0;
    for (k < 8) { text_bytes[k] = 0; k = k + 1; }
    text_bytes[0] = 0xE8;

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "callee"); syms[1].section = of.SECTION_EXTERNAL;
    syms[1].offset = 0; syms[1].size = 0;
    syms[1].flags =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_p4");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var saw: bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        if (out.relocations[rj].kind == of.RK_PC32 && out.relocations[rj].offset == 1) {
            saw = true;
            if (out.sections[0].bytes == nil)                   { ret 1; }
            if (bin.read_u32_le(out.sections[0].bytes, 1) != 4) { ret 1; }
            if (out.relocations[rj].addend != 0) { ret 1; }
        }
        rj = rj + 1;
    }
    if (!saw) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_object:unresolved_reloc_symbol" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_unres");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    fs.temp_close_and_remove(?tf);

    if (!R.is_err[R.Void, str](em))                                   { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "unresolved symbol")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff:defined_weak_comdat_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = (0x10 + k)::u8; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [3]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 0; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "ok$u64$p$u8"); syms[1].section = 0; syms[1].offset = 8;
    syms[1].size = 0;
    syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_WEAK;
    syms[2].name = t_intern(?i, "puts"); syms[2].section = of.SECTION_EXTERNAL;
    syms[2].offset = 0; syms[2].size = 0; syms[2].flags = of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 12; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 2; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 3;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_wk");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (bin.read_u16_le(buf.data, 2) != 2) { ret 1; }

    var comdat_secs: u32 = 0;
    var sh_i: u32 = 0;
    for (sh_i < 2) {
        val sh: usize = COFF_HEADER_SIZE + sh_i::usize * SECTION_HEADER_SIZE;
        if ((bin.read_u32_le(buf.data, sh + 36) & IMAGE_SCN_LNK_COMDAT) != 0) {
            comdat_secs = comdat_secs + 1;
        }
        sh_i = sh_i + 1;
    }
    if (comdat_secs != 1) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var saw_weak: bool = false;
    var saw_main: bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[1].name) {
            saw_weak = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_WEAK) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret 1; }
            if (out.symbols[si].offset != 0)                              { ret 1; }
            if (out.sections[out.symbols[si].section].kind != of.SK_TEXT) { ret 1; }
            if (out.sections[out.symbols[si].section].len != 8)           { ret 1; }
            val wb: *u8 = out.sections[out.symbols[si].section].bytes;
            if (wb == nil) { ret 1; }
            var wk: usize = 0;
            for (wk < 8) {
                if (wb[wk] != (0x10 + 8 + wk)::u8) { ret 1; }
                wk = wk + 1;
            }
        }
        if (out.symbols[si].name == syms[0].name) {
            saw_main = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_WEAK) != 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret 1; }
        }
        si = si + 1;
    }
    if (!saw_weak || !saw_main) { ret 1; }

    var saw_reloc: bool = false;
    var rj: u32 = 0;
    for (rj < out.reloc_count) {
        if (of.reloc_symbol_name(?out, ?out.relocations[rj]) == syms[2].name && out.relocations[rj].offset == 4) {
            var wsec: u32 = of.SECTION_EXTERNAL;
            var sj: u32 = 0;
            for (sj < out.symbol_count) {
                if (out.symbols[sj].name == syms[1].name) { wsec = out.symbols[sj].section; }
                sj = sj + 1;
            }
            if (out.relocations[rj].section == wsec) { saw_reloc = true; }
        }
        rj = rj + 1;
    }
    if (!saw_reloc) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff:weak_split_no_duplication" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [32]u8;
    var k: usize = 0;
    for (k < 32) { text_bytes[k] = (0x10 + k)::u8; k = k + 1; }
    var ro_bytes: [4]u8;
    ro_bytes[0] = 0xAA; ro_bytes[1] = 0xBB; ro_bytes[2] = 0xCC; ro_bytes[3] = 0xDD;

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 32; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".rodata"); secs[1].kind = of.SK_RODATA;
    secs[1].bytes = ?ro_bytes[0]; secs[1].len = 4; secs[1].align = 4;

    val fn_fl: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var syms: [5]of.Symbol;
    syms[0].name = t_intern(?i, "af"); syms[0].section = 0; syms[0].offset = 0;  syms[0].size = 0; syms[0].flags = fn_fl;
    syms[1].name = t_intern(?i, "bwIu64E"); syms[1].section = 0; syms[1].offset = 8;  syms[1].size = 0; syms[1].flags = fn_fl | of.SYM_OBJ_FLAG_WEAK;
    syms[2].name = t_intern(?i, "cf"); syms[2].section = 0; syms[2].offset = 16; syms[2].size = 0; syms[2].flags = fn_fl;
    syms[3].name = t_intern(?i, "dwIu64E"); syms[3].section = 0; syms[3].offset = 24; syms[3].size = 0; syms[3].flags = fn_fl | of.SYM_OBJ_FLAG_WEAK;
    syms[4].name = t_intern(?i, "rdata"); syms[4].section = 1; syms[4].offset = 0;  syms[4].size = 4; syms[4].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 5;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_sp");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var text_total: u32 = 0;
    var text_secs: u32 = 0;
    var s: u32 = 0;
    for (s < out.section_count) {
        if (out.sections[s].kind == of.SK_TEXT) { text_total = text_total + out.sections[s].len; text_secs = text_secs + 1; }
        s = s + 1;
    }
    if (text_total != 32) { ret 1; }
    if (text_secs != 4) { ret 1; }

    var seen: u32 = 0;
    var y: u32 = 0;
    for (y < out.symbol_count) {
        val nm: intern.StrId = out.symbols[y].name;
        if (nm == syms[1].name || nm == syms[3].name) {
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) == 0) { ret 1; }
            if (out.symbols[y].offset != 0)                          { ret 1; }
            val ws: u32 = out.symbols[y].section;
            if (out.sections[ws].kind != of.SK_TEXT) { ret 1; }
            if (out.sections[ws].len != 8)           { ret 1; }
            var base: u8 = 0x28;
            if (nm == syms[1].name) { base = 0x18; }
            var wk: usize = 0;
            for (wk < 8) { if (out.sections[ws].bytes[wk] != (base + wk::u8)) { ret 1; } wk = wk + 1; }
            seen = seen + 1;
        }
        if (nm == syms[0].name || nm == syms[2].name) {
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) != 0)   { ret 1; }
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret 1; }
            if (out.sections[out.symbols[y].section].kind != of.SK_TEXT) { ret 1; }
            seen = seen + 1;
        }
        if (nm == syms[4].name) {
            val rs: u32 = out.symbols[y].section;
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) != 0) { ret 1; }
            if (out.sections[rs].kind != of.SK_RODATA) { ret 1; }
            if (out.sections[rs].len != 4)             { ret 1; }
            if (out.symbols[y].offset != 0)            { ret 1; }
            if (out.sections[rs].bytes[0] != 0xAA || out.sections[rs].bytes[3] != 0xDD) { ret 1; }
            seen = seen + 1;
        }
        y = y + 1;
    }
    if (seen != 5) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff:zero_extent_weak_terminates" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var t0: [8]u8;
    var k: usize = 0;
    for (k < 8) { t0[k] = (0x40 + k::u8); k = k + 1; }

    var secs: [2]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?t0[0]; secs[0].len = 8; secs[0].align = 16;
    secs[1].name = t_intern(?i, ".text"); secs[1].kind = of.SK_TEXT;
    secs[1].bytes = nil; secs[1].len = 0; secs[1].align = 16;

    val fn_fl: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    var syms: [4]of.Symbol;
    syms[0].name = t_intern(?i, "af");   syms[0].section = 0; syms[0].offset = 0; syms[0].size = 0; syms[0].flags = fn_fl;
    syms[1].name = t_intern(?i, "zend"); syms[1].section = 0; syms[1].offset = 8; syms[1].size = 0; syms[1].flags = fn_fl | of.SYM_OBJ_FLAG_WEAK;
    syms[2].name = t_intern(?i, "eend"); syms[2].section = 0; syms[2].offset = 8; syms[2].size = 0; syms[2].flags = 0;
    syms[3].name = t_intern(?i, "zmt");  syms[3].section = 1; syms[3].offset = 0; syms[3].size = 0; syms[3].flags = fn_fl | of.SYM_OBJ_FLAG_WEAK;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 2;
    img.symbols = ?syms[0]; img.symbol_count = 4;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_ze");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var seen: u32 = 0;
    var y: u32 = 0;
    for (y < out.symbol_count) {
        val nm: intern.StrId = out.symbols[y].name;
        if (nm == syms[1].name || nm == syms[3].name) {
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) == 0) { ret 1; }
            if (out.sections[out.symbols[y].section].len != 0)      { ret 1; }
            seen = seen + 1;
        }
        if (nm == syms[0].name) {
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) != 0) { ret 1; }
            seen = seen + 1;
        }
        if (nm == syms[2].name) {
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) != 0) { ret 1; }
            if (out.sections[out.symbols[y].section].len != 8) { ret 1; }
            seen = seen + 1;
        }
        y = y + 1;
    }
    if (seen != 4) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff:weak_carrier_alignment_preserved" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var d: [32]u8;
    var k: usize = 0;
    for (k < 32) { d[k] = k::u8; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".rodata"); secs[0].kind = of.SK_RODATA;
    secs[0].bytes = ?d[0]; secs[0].len = 32; secs[0].align = 16;

    val ob_fl: u32 = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_OBJECT;
    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "c0");   syms[0].section = 0; syms[0].offset = 0;  syms[0].size = 16; syms[0].flags = ob_fl;
    syms[1].name = t_intern(?i, "wk16"); syms[1].section = 0; syms[1].offset = 16; syms[1].size = 16; syms[1].flags = ob_fl | of.SYM_OBJ_FLAG_WEAK;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_al");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var saw: bool = false;
    var y: u32 = 0;
    for (y < out.symbol_count) {
        if (out.symbols[y].name == syms[1].name) {
            saw = true;
            if ((out.symbols[y].flags & of.SYM_OBJ_FLAG_WEAK) == 0)   { ret 1; }
            val ws: u32 = out.symbols[y].section;
            if (out.sections[ws].kind != of.SK_RODATA) { ret 1; }
            if (out.sections[ws].len != 16)            { ret 1; }
            if (out.symbols[y].offset != 0)            { ret 1; }
            if (out.sections[ws].align != 16)          { ret 1; }
        }
        y = y + 1;
    }
    if (!saw) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff:long_names_string_table" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    val long_sec: str = ".text$mn_generic";
    val long_sym: str = "mach__generic__instance__symbol";

    var data_bytes: [4]u8;
    data_bytes[0] = 1; data_bytes[1] = 2; data_bytes[2] = 3; data_bytes[3] = 4;

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, long_sec); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?data_bytes[0]; secs[0].len = 4; secs[0].align = 1;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, long_sym); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 4; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_ln");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (buf.data[COFF_HEADER_SIZE] != '/') { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    if (out.section_count != 1)               { ret 1; }
    if (out.sections[0].name != secs[0].name) { ret 1; }

    var saw: bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[0].name) { saw = true; }
        si = si + 1;
    }
    if (!saw) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:pe32plus_header" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0; k = k + 1; }

    val base:  u64 = 0x140001000;
    val entry: u64 = base + 4;

    var segs: [2]of.LoadSegment;
    segs[0].vaddr = base; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];
    segs[1].vaddr = base + 0x1000; segs[1].filesz = 8; segs[1].memsz = 8;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE; segs[1].bytes = ?data_bytes[0];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_pe");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2,
                                                 4096, base - PE_SECTION_ALIGN, entry,
                                                 nil, 0, nil::*of.Section, 0, nil::*of.Section, 0,
                                                 nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8, "coffexe"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    if (buf.data[0] != 'M' || buf.data[1] != 'Z') { ret 1; }
    val pe_off: usize = bin.read_u32_le(buf.data, 0x3C)::usize;
    if (buf.data[pe_off] != 'P' || buf.data[pe_off + 1] != 'E'
        || buf.data[pe_off + 2] != 0 || buf.data[pe_off + 3] != 0) { ret 1; }

    val ch: usize = pe_off + PE_SIGNATURE_SIZE;
    if (bin.read_u16_le(buf.data, ch) != IMAGE_FILE_MACHINE_AMD64) { ret 1; }
    if (bin.read_u16_le(buf.data, ch + 2) != 2)                    { ret 1; }

    val oh: usize = ch + COFF_HEADER_SIZE;
    if (bin.read_u16_le(buf.data, oh) != PE32PLUS_MAGIC)                   { ret 1; }
    if (bin.read_u16_le(buf.data, oh + 68) != IMAGE_SUBSYSTEM_WINDOWS_CUI) { ret 1; }

    val image_base: u64 = bin.read_u64_le(buf.data, oh + 24);
    val entry_rva:  u32 = bin.read_u32_le(buf.data, oh + 16);
    if (image_base + entry_rva::u64 != entry) { ret 1; }

    if ((image_base & 0xFFFF) != 0) { ret 1; }
    val sect_align: u32 = bin.read_u32_le(buf.data, oh + 32);
    val hdr_size:   u32 = bin.read_u32_le(buf.data, oh + 60);
    val first_rva:  u32 = bin.read_u32_le(buf.data, oh + OPTIONAL_HEADER_SIZE + 12);
    if (first_rva != bin.align_up_u64(hdr_size::u64, sect_align::u64)::u32) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:subsystem_selection" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    val base:  u64 = 0x140001000;
    val entry: u64 = base + 4;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];

    val cui: R.Result[Vector[u8], str] = emit_subsystem_image(?alloc, ?i, ?isa_vt, ?segs[0], entry, of.SUBSYSTEM_CONSOLE);
    if (R.is_err[Vector[u8], str](cui)) { ret 1; }
    val con: Vector[u8] = R.unwrap_ok[Vector[u8], str](cui);

    val gr: R.Result[Vector[u8], str] = emit_subsystem_image(?alloc, ?i, ?isa_vt, ?segs[0], entry, of.SUBSYSTEM_GUI);
    if (R.is_err[Vector[u8], str](gr)) { ret 1; }
    val gui: Vector[u8] = R.unwrap_ok[Vector[u8], str](gr);

    if (con.len != gui.len) { ret 1; }

    val pe_off: usize = bin.read_u32_le(con.data, 0x3C)::usize;
    val oh:     usize = pe_off + PE_SIGNATURE_SIZE + COFF_HEADER_SIZE;
    if (bin.read_u16_le(con.data, oh + 68) != IMAGE_SUBSYSTEM_WINDOWS_CUI) { ret 1; }
    if (bin.read_u16_le(gui.data, oh + 68) != IMAGE_SUBSYSTEM_WINDOWS_GUI) { ret 1; }

    var b: usize = 0;
    for (b < con.len) {
        if (b != oh + 68 && b != oh + 69) {
            if (con.data[b] != gui.data[b]) { ret 1; }
        }
        b = b + 1;
    }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:stack_reserve_and_commit" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    val base:  u64 = 0x140001000;
    val entry: u64 = base + 4;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];

    var def_opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    val dr: R.Result[Vector[u8], str] = emit_stack_image(?alloc, ?i, ?isa_vt, ?segs[0], entry, ?def_opts);
    if (R.is_err[Vector[u8], str](dr)) { ret 1; }
    val dflt: Vector[u8] = R.unwrap_ok[Vector[u8], str](dr);

    var big_opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    big_opts.stack_reserve = 0x800000;
    big_opts.stack_commit  = 0x2000;
    val br: R.Result[Vector[u8], str] = emit_stack_image(?alloc, ?i, ?isa_vt, ?segs[0], entry, ?big_opts);
    if (R.is_err[Vector[u8], str](br)) { ret 1; }
    val big: Vector[u8] = R.unwrap_ok[Vector[u8], str](br);

    if (dflt.len != big.len) { ret 2; }

    val pe_off: usize = bin.read_u32_le(dflt.data, 0x3C)::usize;
    val oh:     usize = pe_off + PE_SIGNATURE_SIZE + COFF_HEADER_SIZE;

    if (bin.read_u64_le(dflt.data, oh + 72) != PE_DEFAULT_STACK_RESERVE) { ret 3; }
    if (bin.read_u64_le(dflt.data, oh + 80) != PE_DEFAULT_STACK_COMMIT)  { ret 4; }
    if (bin.read_u64_le(big.data, oh + 72) != 0x800000) { ret 5; }
    if (bin.read_u64_le(big.data, oh + 80) != 0x2000)   { ret 6; }

    if (bin.read_u64_le(big.data, oh + 88) != PE_DEFAULT_STACK_RESERVE) { ret 7; }
    if (bin.read_u64_le(big.data, oh + 96) != PE_DEFAULT_STACK_COMMIT)  { ret 8; }

    var b: usize = 0;
    for (b < dflt.len) {
        val in_stack: bool = (b >= oh + 72 && b < oh + 88);
        if (!in_stack && dflt.data[b] != big.data[b]) { ret 9; }
        b = b + 1;
    }
    ret 0;
}

fun emit_stack_image(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget,
                     segs: *of.LoadSegment, entry: u64, opts: *of.ImageOptions) R.Result[Vector[u8], str] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "coff_stack");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[Vector[u8], str]("temp create failed"); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(alloc, itn, isa_vt, segs, 1,
                                                 4096, segs[0].vaddr - PE_SECTION_ALIGN,
                                                 entry, nil, 0,
                                                 nil::*of.Section, 0, nil::*of.Section, 0,
                                                 nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8, "coffstack"::*u8,
                                                 @opts);
    if (R.is_err[R.Void, str](em)) {
        fs.temp_close_and_remove(?tf);
        ret R.err[Vector[u8], str](R.unwrap_err[R.Void, str](em));
    }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    ret rb;
}

fun emit_subsystem_image(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget,
                         segs: *of.LoadSegment, entry: u64, subsystem: of.Subsystem) R.Result[Vector[u8], str] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "coff_subsys");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[Vector[u8], str]("temp create failed"); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(alloc, itn, isa_vt, segs, 1,
                                                 4096, segs[0].vaddr - PE_SECTION_ALIGN,
                                                 entry, nil, 0,
                                                 nil::*of.Section, 0, nil::*of.Section, 0,
                                                 nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8, "coffsubsys"::*u8,
                                                 of.image_options_default(subsystem));
    if (R.is_err[R.Void, str](em)) {
        fs.temp_close_and_remove(?tf);
        ret R.err[Vector[u8], str](R.unwrap_err[R.Void, str](em));
    }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    ret rb;
}

test "mach.lang.target.of.coff:call_target_import_function_flag" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    text_bytes[0] = 0xE8;
    text_bytes[1] = 0; text_bytes[2] = 0; text_bytes[3] = 0; text_bytes[4] = 0;
    text_bytes[5] = 0x90; text_bytes[6] = 0x90; text_bytes[7] = 0xC3;

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "GetCommandLineA"); syms[1].section = of.SECTION_EXTERNAL;
    syms[1].offset = 0; syms[1].size = 0;
    syms[1].flags =
        of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_rtf");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var saw: bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[1].name) {
            saw = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
        }
        si = si + 1;
    }
    if (!saw) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.infer_extern_function_flags_from_calls:foreign_call_relocs" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [8]u8;
    text_bytes[0] = 0xE8;
    text_bytes[1] = 0; text_bytes[2] = 0; text_bytes[3] = 0; text_bytes[4] = 0;
    text_bytes[5] = 0x90; text_bytes[6] = 0x90; text_bytes[7] = 0xC3;

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 8; secs[0].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 8; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "GetCommandLineA"); syms[1].section = of.SECTION_EXTERNAL;
    syms[1].offset = 0; syms[1].size = 0;
    syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_EXTERN;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 1; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 1; relocs[0].addend = -4;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_ifn");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr)) { ret 1; }

    var saw: bool = false;
    var si: u32 = 0;
    for (si < out.symbol_count) {
        if (out.symbols[si].name == syms[1].name) {
            saw = true;
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_EXTERN) == 0)   { ret 1; }
            if ((out.symbols[si].flags & of.SYM_OBJ_FLAG_FUNCTION) == 0) { ret 1; }
        }
        si = si + 1;
    }
    if (!saw) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:unwind_xdata_pdata" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [14]u8;
    text_bytes[0] = 0x55;
    text_bytes[1] = 0x48; text_bytes[2] = 0x89; text_bytes[3] = 0xE5;
    text_bytes[4] = 0x48; text_bytes[5] = 0x83; text_bytes[6] = 0xEC; text_bytes[7] = 0x20;
    text_bytes[8] = 0x48; text_bytes[9] = 0x89; text_bytes[10] = 0x5D; text_bytes[11] = 0xF8;
    text_bytes[12] = 0x90;
    text_bytes[13] = 0xC3;

    val base:  u64 = 0x140001000;
    val entry: u64 = base;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base; segs[0].filesz = 14; segs[0].memsz = 14;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];

    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0;
    funcs[0].seg_offset = 0;
    funcs[0].size = 14;
    funcs[0].step_count = 3;
    funcs[0].steps[0].kind = of.FRAME_STEP_PUSH;  funcs[0].steps[0].reg = 5; funcs[0].steps[0].end_off = 1;  funcs[0].steps[0].value = 0;
    funcs[0].steps[1].kind = of.FRAME_STEP_ALLOC; funcs[0].steps[1].reg = 0; funcs[0].steps[1].end_off = 8;  funcs[0].steps[1].value = 0x20;
    funcs[0].steps[2].kind = of.FRAME_STEP_SAVE;  funcs[0].steps[2].reg = 3; funcs[0].steps[2].end_off = 12; funcs[0].steps[2].value = 0x18;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_unw");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                                 4096, base - PE_SECTION_ALIGN, entry,
                                                 ?funcs[0], 1, nil::*of.Section, 0,
                                                 nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8,
                                                 "coffunwind"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val pe_off: usize = bin.read_u32_le(buf.data, 0x3C)::usize;
    val ch: usize = pe_off + PE_SIGNATURE_SIZE;
    if (bin.read_u16_le(buf.data, ch + 2) != 3) { ret 1; }

    val oh: usize = ch + COFF_HEADER_SIZE;
    val dd: usize = oh + 112;
    val exc_rva: u32 = bin.read_u32_le(buf.data, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE);
    val exc_size: u32 = bin.read_u32_le(buf.data, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE + 4);
    if (exc_rva == 0 || exc_size != RUNTIME_FUNCTION_SIZE::u32) { ret 1; }

    var xdata_rva: u32 = 0;
    var xdata_ptr: u32 = 0;
    var pdata_ptr: u32 = 0;
    var si: u32 = 0;
    var sh: usize = oh + OPTIONAL_HEADER_SIZE;
    for (si < 3) {
        if (buf.data[sh] == '.' && buf.data[sh + 1] == 'x'
            && buf.data[sh + 2] == 'd' && buf.data[sh + 3] == 'a'
            && buf.data[sh + 4] == 't' && buf.data[sh + 5] == 'a') {
            xdata_rva = bin.read_u32_le(buf.data, sh + 12);
            xdata_ptr = bin.read_u32_le(buf.data, sh + 20);
        }
        if (buf.data[sh] == '.' && buf.data[sh + 1] == 'p'
            && buf.data[sh + 2] == 'd' && buf.data[sh + 3] == 'a'
            && buf.data[sh + 4] == 't' && buf.data[sh + 5] == 'a') {
            pdata_ptr = bin.read_u32_le(buf.data, sh + 20);
        }
        sh = sh + SECTION_HEADER_SIZE;
        si = si + 1;
    }
    if (xdata_rva == 0 || xdata_ptr == 0 || pdata_ptr == 0) { ret 1; }

    val begin_rva: u32 = bin.read_u32_le(buf.data, pdata_ptr::usize);
    val end_rva: u32 = bin.read_u32_le(buf.data, pdata_ptr::usize + 4);
    val unwind_rva: u32 = bin.read_u32_le(buf.data, pdata_ptr::usize + 8);
    if (begin_rva == 0 || end_rva <= begin_rva) { ret 1; }
    if (unwind_rva < xdata_rva)                 { ret 1; }
    val uw_ptr: usize = xdata_ptr::usize + (unwind_rva - xdata_rva)::usize;

    if (buf.data[uw_ptr + 0] != 0x01) { ret 1; }
    if (buf.data[uw_ptr + 1] != 0x0C) { ret 1; }
    if (buf.data[uw_ptr + 2] != 0x04) { ret 1; }
    if (buf.data[uw_ptr + 3] != 0x00) { ret 1; }
    if (buf.data[uw_ptr + 4] != 0x0C) { ret 1; }
    if (buf.data[uw_ptr + 5] != 0x34) { ret 1; }
    if (bin.read_u16_le(buf.data, uw_ptr + 6) != 3) { ret 1; }
    if (buf.data[uw_ptr + 8] != 0x08) { ret 1; }
    if (buf.data[uw_ptr + 9] != 0x32) { ret 1; }
    if (buf.data[uw_ptr + 10] != 0x01) { ret 1; }
    if (buf.data[uw_ptr + 11] != 0x50) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:foreign_pdata_authoritative" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [14]u8;
    text_bytes[0] = 0x55;
    text_bytes[1] = 0x48; text_bytes[2] = 0x89; text_bytes[3] = 0xE5;
    text_bytes[4] = 0x48; text_bytes[5] = 0x83; text_bytes[6] = 0xEC; text_bytes[7] = 0x20;
    text_bytes[8] = 0x48; text_bytes[9] = 0x89; text_bytes[10] = 0x5D; text_bytes[11] = 0xF8;
    text_bytes[12] = 0x90; text_bytes[13] = 0xC3;

    var xdata_bytes: [8]u8;
    xdata_bytes[0] = 0x01; xdata_bytes[1] = 0x04; xdata_bytes[2] = 0x01; xdata_bytes[3] = 0;
    xdata_bytes[4] = 0x04; xdata_bytes[5] = 0x42; xdata_bytes[6] = 0; xdata_bytes[7] = 0;

    val image_base: u64 = 0x140000000;
    var segs: [2]of.LoadSegment;
    segs[0].vaddr = image_base + 0x2000; segs[0].filesz = 14; segs[0].memsz = 14;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];
    segs[1].vaddr = image_base + 0x3000; segs[1].filesz = 8; segs[1].memsz = 8;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = ?xdata_bytes[0];

    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0; funcs[0].seg_offset = 0; funcs[0].size = 14;
    funcs[0].step_count = 3;
    funcs[0].steps[0].kind = of.FRAME_STEP_PUSH;  funcs[0].steps[0].reg = 5; funcs[0].steps[0].end_off = 1;  funcs[0].steps[0].value = 0;
    funcs[0].steps[1].kind = of.FRAME_STEP_ALLOC; funcs[0].steps[1].reg = 0; funcs[0].steps[1].end_off = 8;  funcs[0].steps[1].value = 0x20;
    funcs[0].steps[2].kind = of.FRAME_STEP_SAVE;  funcs[0].steps[2].reg = 3; funcs[0].steps[2].end_off = 12; funcs[0].steps[2].value = 0x18;

    var pdata_bytes: [12]u8;
    bin.write_u32_le(?pdata_bytes[0], 0, 0x2000);
    bin.write_u32_le(?pdata_bytes[0], 4, 0x200E);
    bin.write_u32_le(?pdata_bytes[0], 8, 0x3000);
    var exceptions: [1]of.Section;
    exceptions[0].name = t_intern(?i, ".pdata");
    exceptions[0].kind = of.SK_EXCEPTION;
    exceptions[0].bytes = ?pdata_bytes[0]; exceptions[0].len = 12; exceptions[0].align = 4;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_foreign_unw");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2, 4096,
                                                 image_base, segs[0].vaddr, ?funcs[0], 1,
                                                 ?exceptions[0], 1, nil::*of.Section, 0,
                                                 nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8, "coffforeignunwind"::*u8,
                                                 of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val pe_off: usize = bin.read_u32_le(buf.data, 0x3C)::usize;
    val ch: usize = pe_off + PE_SIGNATURE_SIZE;
    if (bin.read_u16_le(buf.data, ch + 2) != 3) { ret 1; }
    val oh: usize = ch + COFF_HEADER_SIZE;
    if (bin.read_u64_le(buf.data, oh + 24) != image_base) { ret 1; }
    val text_sh: usize = oh + OPTIONAL_HEADER_SIZE;
    if (bin.read_u32_le(buf.data, text_sh + 12) != 0x1000) { ret 1; }
    if (bin.read_u32_le(buf.data, text_sh + 8) != 0x100E) { ret 1; }
    val text_ptr: usize = bin.read_u32_le(buf.data, text_sh + 20)::usize;
    if (buf.data[text_ptr + 0x1000] != text_bytes[0]
        || buf.data[text_ptr + 0x100D] != text_bytes[13]) { ret 1; }
    val dd: usize = oh + 112;
    val exc_rva: u32 = bin.read_u32_le(buf.data, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE);
    val exc_size: u32 = bin.read_u32_le(buf.data, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE + 4);
    if (exc_size != RUNTIME_FUNCTION_SIZE::u32) { ret 1; }

    var pdata_ptr: u32 = 0;
    var pdata_rva: u32 = 0;
    var saw_xdata: bool = false;
    var si: u32 = 0;
    var sh: usize = oh + OPTIONAL_HEADER_SIZE;
    for (si < 3) {
        if (buf.data[sh] == '.' && buf.data[sh + 1] == 'p'
            && buf.data[sh + 2] == 'd' && buf.data[sh + 3] == 'a'
            && buf.data[sh + 4] == 't' && buf.data[sh + 5] == 'a') {
            pdata_rva = bin.read_u32_le(buf.data, sh + 12);
            pdata_ptr = bin.read_u32_le(buf.data, sh + 20);
        }
        if (buf.data[sh] == '.' && buf.data[sh + 1] == 'x'
            && buf.data[sh + 2] == 'd' && buf.data[sh + 3] == 'a'
            && buf.data[sh + 4] == 't' && buf.data[sh + 5] == 'a') { saw_xdata = true; }
        sh = sh + SECTION_HEADER_SIZE;
        si = si + 1;
    }
    if (pdata_ptr == 0 || pdata_rva != exc_rva || saw_xdata) { ret 1; }
    if (bin.read_u32_le(buf.data, pdata_ptr::usize) != 0x2000)     { ret 1; }
    if (bin.read_u32_le(buf.data, pdata_ptr::usize + 4) != 0x200E) { ret 1; }
    if (bin.read_u32_le(buf.data, pdata_ptr::usize + 8) != 0x3000) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:rejects_malformed_foreign_pdata" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    var text: [1]u8; text[0] = 0xC3;
    var seg: of.LoadSegment;
    seg.vaddr = 0x140001000; seg.filesz = 1; seg.memsz = 1;
    seg.flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; seg.bytes = ?text[0];
    var bad_bytes: [11]u8;
    var exception: of.Section;
    exception.name = t_intern(?i, ".pdata"); exception.kind = of.SK_EXCEPTION;
    exception.bytes = ?bad_bytes[0]; exception.len = 11; exception.align = 4;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_bad_foreign_unw");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(?alloc, ?i, ?isa_vt, ?seg, 1, 4096,
                                                 0x140000000, seg.vaddr, nil::*of.ExecFunction, 0,
                                                 ?exception, 1, nil::*of.Section, 0,
                                                 nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8, "coffbadforeignunwind"::*u8,
                                                 of.image_options_default(of.SUBSYSTEM_CONSOLE));
    fs.temp_close_and_remove(?tf);
    if (!R.is_err[R.Void, str](em)) { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "malformed exception metadata")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.push_save_nonvol:far_form_unscaled" {
    var uw: FunctionUnwind;
    uw.code_count = 0;
    uw.slot_count = 0;
    val off: usize = 0x88888;
    if (!push_save_nonvol(?uw, 0, 12, off)) { ret 1; }
    if (uw.code_count != 1) { ret 1; }
    val c: *UnwindCode = ?uw.codes[0];
    if (c.op != UWOP_SAVE_NONVOL_FAR) { ret 1; }
    if (c.info != 12)                 { ret 1; }
    if (c.extra_slots != 2)           { ret 1; }
    if (c.extra0 != (off & 0xFFFF)::u16)         { ret 1; }
    if (c.extra1 != ((off >> 16) & 0xFFFF)::u16) { ret 1; }
    val scaled: usize = off / 8;
    if (c.extra0 == (scaled & 0xFFFF)::u16 && c.extra1 == ((scaled >> 16) & 0xFFFF)::u16) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.build_function_unwind:save_xmm128" {
    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0; funcs[0].seg_offset = 0; funcs[0].size = 22;
    funcs[0].step_count = 5;
    funcs[0].steps[0].kind = of.FRAME_STEP_PUSH;     funcs[0].steps[0].reg = 5;  funcs[0].steps[0].end_off = 1;  funcs[0].steps[0].value = 0;
    funcs[0].steps[1].kind = of.FRAME_STEP_ALLOC;    funcs[0].steps[1].reg = 0;  funcs[0].steps[1].end_off = 8;  funcs[0].steps[1].value = 0x40;
    funcs[0].steps[2].kind = of.FRAME_STEP_SAVE;     funcs[0].steps[2].reg = 3;  funcs[0].steps[2].end_off = 12; funcs[0].steps[2].value = 0x38;
    funcs[0].steps[3].kind = of.FRAME_STEP_SAVE_VEC; funcs[0].steps[3].reg = 6;  funcs[0].steps[3].end_off = 16; funcs[0].steps[3].value = 0x20;
    funcs[0].steps[4].kind = of.FRAME_STEP_SAVE_VEC; funcs[0].steps[4].reg = 8;  funcs[0].steps[4].end_off = 21; funcs[0].steps[4].value = 0x10;

    var uw: FunctionUnwind;
    if (!build_function_unwind(?uw, 1, ?funcs[0], 0)) { ret 1; }
    if (uw.code_count != 5) { ret 1; }
    if (uw.prolog_size != 21) { ret 1; }

    val x6: *UnwindCode = ?uw.codes[3];
    if (x6.op != UWOP_SAVE_XMM128) { ret 1; }
    if (x6.info != 6)              { ret 1; }
    if (x6.extra0 != 2) { ret 1; }
    if (x6.end_off != 16) { ret 1; }

    val x8: *UnwindCode = ?uw.codes[4];
    if (x8.op != UWOP_SAVE_XMM128) { ret 1; }
    if (x8.info != 8)              { ret 1; }
    if (x8.extra0 != 1) { ret 1; }
    if (x8.end_off != 21) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.build_function_unwind:save_xmm128_high" {
    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0; funcs[0].seg_offset = 0; funcs[0].size = 19;
    funcs[0].step_count = 4;
    funcs[0].steps[0].kind = of.FRAME_STEP_PUSH;     funcs[0].steps[0].reg = 5;  funcs[0].steps[0].end_off = 1;  funcs[0].steps[0].value = 0;
    funcs[0].steps[1].kind = of.FRAME_STEP_ALLOC;    funcs[0].steps[1].reg = 0;  funcs[0].steps[1].end_off = 8;  funcs[0].steps[1].value = 0x40;
    funcs[0].steps[2].kind = of.FRAME_STEP_SAVE_VEC; funcs[0].steps[2].reg = 14; funcs[0].steps[2].end_off = 13; funcs[0].steps[2].value = 0x30;
    funcs[0].steps[3].kind = of.FRAME_STEP_SAVE_VEC; funcs[0].steps[3].reg = 15; funcs[0].steps[3].end_off = 18; funcs[0].steps[3].value = 0x20;

    var uw: FunctionUnwind;
    if (!build_function_unwind(?uw, 1, ?funcs[0], 0)) { ret 1; }
    if (uw.code_count != 4)   { ret 1; }
    if (uw.prolog_size != 18) { ret 1; }

    val x14: *UnwindCode = ?uw.codes[2];
    if (x14.op != UWOP_SAVE_XMM128) { ret 1; }
    if (x14.info != 14)             { ret 1; }
    if (x14.extra0 != 3) { ret 1; }
    if (x14.end_off != 13) { ret 1; }

    val x15: *UnwindCode = ?uw.codes[3];
    if (x15.op != UWOP_SAVE_XMM128) { ret 1; }
    if (x15.info != 15)             { ret 1; }
    if (x15.extra0 != 2) { ret 1; }
    if (x15.end_off != 18) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.push_save_xmm128:far_form_unscaled" {
    var uw: FunctionUnwind;
    uw.code_count = 0;
    uw.slot_count = 0;
    val off: usize = 0x110000;
    if (!push_save_xmm128(?uw, 0, 9, off)) { ret 1; }
    if (uw.code_count != 1) { ret 1; }
    val c: *UnwindCode = ?uw.codes[0];
    if (c.op != UWOP_SAVE_XMM128_FAR)            { ret 1; }
    if (c.info != 9)                             { ret 1; }
    if (c.extra_slots != 2)                      { ret 1; }
    if (c.extra0 != (off & 0xFFFF)::u16)         { ret 1; }
    if (c.extra1 != ((off >> 16) & 0xFFFF)::u16) { ret 1; }
    uw.code_count = 0;
    uw.slot_count = 0;
    if (push_save_xmm128(?uw, 0, 6, 0x18)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.build_function_unwind:recordless_contributes_nothing" {
    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0; funcs[0].seg_offset = 0; funcs[0].size = 13;
    funcs[0].step_count = 0;

    var uw: FunctionUnwind;
    if (build_function_unwind(?uw, 1, ?funcs[0], 0)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.build_function_unwind:probed_alloc_large" {
    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0; funcs[0].seg_offset = 0; funcs[0].size = 0x200;
    funcs[0].step_count = 2;
    funcs[0].steps[0].kind = of.FRAME_STEP_PUSH;  funcs[0].steps[0].reg = 5; funcs[0].steps[0].end_off = 1;    funcs[0].steps[0].value = 0;
    funcs[0].steps[1].kind = of.FRAME_STEP_ALLOC; funcs[0].steps[1].reg = 0; funcs[0].steps[1].end_off = 0x2D; funcs[0].steps[1].value = 0x6040;

    var uw: FunctionUnwind;
    if (!build_function_unwind(?uw, 1, ?funcs[0], 0)) { ret 1; }
    if (uw.code_count != 2)    { ret 1; }
    if (uw.prolog_size != 0x2D) { ret 1; }
    if (uw.frame_reg != 0)     { ret 1; }

    val a: *UnwindCode = ?uw.codes[1];
    if (a.op != UWOP_ALLOC_LARGE)      { ret 1; }
    if (a.info != 0)                   { ret 1; }
    if (a.extra_slots != 1)            { ret 1; }
    if (a.extra0 != (0x6040 / 8)::u16) { ret 1; }
    if (a.end_off != 0x2D)             { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.build_function_unwind:set_fpreg_realigned" {
    var funcs: [1]of.ExecFunction;
    funcs[0].seg_index = 0; funcs[0].seg_offset = 0; funcs[0].size = 0x80;
    funcs[0].step_count = 2;
    funcs[0].steps[0].kind = of.FRAME_STEP_PUSH;   funcs[0].steps[0].reg = 5; funcs[0].steps[0].end_off = 1; funcs[0].steps[0].value = 0;
    funcs[0].steps[1].kind = of.FRAME_STEP_SET_FP; funcs[0].steps[1].reg = 5; funcs[0].steps[1].end_off = 4; funcs[0].steps[1].value = 0;

    var uw: FunctionUnwind;
    if (!build_function_unwind(?uw, 1, ?funcs[0], 0)) { ret 1; }
    if (uw.code_count != 2)  { ret 1; }
    if (uw.prolog_size != 4) { ret 1; }
    if (uw.frame_reg != 5)   { ret 1; }
    if (uw.frame_off != 0)   { ret 1; }

    val c: *UnwindCode = ?uw.codes[1];
    if (c.op != UWOP_SET_FPREG) { ret 1; }
    if (c.end_off != 4)         { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.reloc_type_for:aarch64_kinds_unsupported" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var kinds: [7]of.RelocKind;
    kinds[0] = of.RK_PAGE21;      kinds[1] = of.RK_ADD_LO12;
    kinds[2] = of.RK_LDST8_LO12;  kinds[3] = of.RK_LDST16_LO12;
    kinds[4] = of.RK_LDST32_LO12; kinds[5] = of.RK_LDST64_LO12;
    kinds[6] = of.RK_LDST128_LO12;

    var n: usize = 0;
    for (n < 7) {
        val tr: R.Result[u16, str] = reloc_type_for(?i, ?alloc, kinds[n]);
        if (!R.is_err[u16, str](tr)) { ret 1; }
        n = n + 1;
    }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_object:unsupported_reloc_kind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_GOTPCREL;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_kind");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    fs.temp_close_and_remove(?tf);

    if (!R.is_err[R.Void, str](em))                               { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "gotpcrel")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.reloc_type_for:debug_kinds_roundtrip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var kinds: [3]of.RelocKind;
    kinds[0] = of.RK_ABS32; kinds[1] = of.RK_SECREL32; kinds[2] = of.RK_SECTION;
    var types: [3]u16;
    types[0] = IMAGE_REL_AMD64_ADDR32; types[1] = IMAGE_REL_AMD64_SECREL; types[2] = IMAGE_REL_AMD64_SECTION;

    var n: usize = 0;
    for (n < 3) {
        val tr: R.Result[u16, str] = reloc_type_for(?i, ?alloc, kinds[n]);
        if (R.is_err[u16, str](tr) || R.unwrap_ok[u16, str](tr) != types[n])                       { ret 1; }
        val kr: R.Result[of.RelocKind, str] = reloc_kind_for(?i, ?alloc, types[n]);
        if (R.is_err[of.RelocKind, str](kr) || R.unwrap_ok[of.RelocKind, str](kr) != kinds[n])      { ret 1; }
        n = n + 1;
    }

    if (reloc_field_width(of.RK_SECTION)  != 2) { ret 1; }
    if (reloc_field_width(of.RK_ABS32)    != 4) { ret 1; }
    if (reloc_field_width(of.RK_SECREL32) != 4) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_parse_object:rejects_unmapped_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var relocs: [1]of.Relocation;
    relocs[0].section = 0; relocs[0].offset = 0; relocs[0].kind = of.RK_PC32;
    relocs[0].sym = 0; relocs[0].addend = 0;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = ?relocs[0]; img.reloc_count = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_ptype");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val rptr: usize = bin.read_u32_le(buf.data, COFF_HEADER_SIZE + 24)::usize;
    if (rptr == 0) { ret 1; }
    bin.write_u16_le(buf.data, rptr + 8, 0x000C);

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (!R.is_err[R.Void, str](pr))                                      { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "relocation type")) { ret 1; }
    if (out.sections != nil || out.section_count != 0 || out.section_cap != 0
        || out.symbols != nil || out.symbol_count != 0 || out.symbol_cap != 0
        || out.relocations != nil || out.reloc_count != 0 || out.reloc_cap != 0
        || out.frames != nil || out.frame_count != 0 || out.frame_cap != 0
        || out.imports != nil || out.import_count != 0 || out.import_cap != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_object:reloc_count_overflow" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    val vt_o: O.Option[*of.OfVTable] = of.lookup(?of_reg, "coff");
    if (!O.is_some[*of.OfVTable](vt_o)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    val nrel: u32 = 65536;
    val rrl: R.Result[*of.Relocation, str] = A.zallocate[of.Relocation](?alloc, nrel::usize);
    if (R.is_err[*of.Relocation, str](rrl)) { ret 1; }
    val relocs: *of.Relocation = R.unwrap_ok[*of.Relocation, str](rrl);
    var r: u32 = 0;
    for (r < nrel) {
        relocs[r].section = 0; relocs[r].offset = 0; relocs[r].kind = of.RK_PC32;
        relocs[r].sym = 0; relocs[r].addend = 0;
        r = r + 1;
    }

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = relocs; img.reloc_count = nrel;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_novfl");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    fs.temp_close_and_remove(?tf);
    A.deallocate[of.Relocation](?alloc, relocs, nrel::usize);

    if (!R.is_err[R.Void, str](em))                              { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "exceeds")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_parse_object:rejects_truncated" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var of_reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?of_reg); }
    val rr: R.Result[R.Void, str] = register_coff(?of_reg);
    if (R.is_err[R.Void, str](rr)) { ret 1; }

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [1]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 16; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 1;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_trunc");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, tpath::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var ok_out: of.ObjectImage;
    if (R.is_err[R.Void, str](coff_parse_object(?alloc, ?i, buf.data, buf.len, ?ok_out))) { ret 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, COFF_HEADER_SIZE + 8, ?out);
    if (!R.is_err[R.Void, str](pr))                                    { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](pr), "out of bounds")) { ret 1; }
    ret 0;
}

fun t_iat_slots_exact(i: *intern.Interner, counts: *u32, nlib: u32) bool {
    var libs: [8]of.DynLib;
    var imports: [64]of.DynImport;
    var total: u32 = 0;
    var l: u32 = 0;
    for (l < nlib) {
        libs[l].soname = t_intern(i, "lib.dll");
        libs[l].rpath = intern.STR_NIL;
        var j: u32 = 0;
        for (j < counts[l]) {
            imports[total].symbol = t_intern(i, "fn");
            imports[total].lib_index = l;
            imports[total].is_func = true;
            imports[total].ordinal = 0;
            imports[total].by_ordinal = false;
            total = total + 1;
            j = j + 1;
        }
        l = l + 1;
    }

    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0]; dyn.lib_count = nlib;
    dyn.imports = ?imports[0]; dyn.import_count = total;
    dyn.interp = intern.STR_NIL;

    var lay: PeLayout;
    lay.nimp = func_import_count(?dyn);
    lay.idata_sec.rva = 0x10000;

    val base: u64 = pe_iat_slot_rva(?lay, ?dyn, 0);
    var ord: u32 = 0;
    var slot: u32 = 0;
    var elib: u32 = 0;
    for (elib < nlib) {
        var j: u32 = 0;
        for (j < counts[elib]) {
            val got:  u64 = pe_iat_slot_rva(?lay, ?dyn, ord);
            val want: u64 = base + slot::u64 * THUNK_SIZE::u64;
            if (got != want) { ret false; }
            ord = ord + 1;
            slot = slot + 1;
            j = j + 1;
        }
        slot = slot + 1;
        elib = elib + 1;
    }
    ret true;
}

test "mach.lang.target.of.coff.pe_iat_slot_rva:per_descriptor_range" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var counts: [4]u32;
    counts[0] = 6; counts[1] = 3; counts[2] = 2; counts[3] = 1;
    if (!t_iat_slots_exact(?i, ?counts[0], 4)) { ret 1; }

    counts[0] = 1; counts[1] = 2; counts[2] = 3; counts[3] = 6;
    if (!t_iat_slots_exact(?i, ?counts[0], 4)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.pe_import_iat_slot_rva:mixed_imports" {
    var libs: [2]of.DynLib;
    var imports: [3]of.DynImport;
    imports[0].lib_index = 1; imports[0].is_func = false;
    imports[1].lib_index = 0; imports[1].is_func = true;
    imports[2].lib_index = 1; imports[2].is_func = true;
    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0]; dyn.lib_count = 2;
    dyn.imports = ?imports[0]; dyn.import_count = 3;
    var lay: PeLayout;
    lay.nimp = 2;
    lay.idata_sec.rva = 0x10000;

    val base: u64 = pe_import_iat_slot_rva(?lay, ?dyn, 1);
    if (base == 0
        || pe_iat_slot_rva(?lay, ?dyn, 0) != base
        || pe_import_iat_slot_rva(?lay, ?dyn, 0)
            != base + 2 * THUNK_SIZE::u64
        || pe_import_iat_slot_rva(?lay, ?dyn, 2)
            != base + 3 * THUNK_SIZE::u64
        || pe_iat_slot_rva(?lay, ?dyn, 1)
            != base + 3 * THUNK_SIZE::u64) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.patch_pe_import_addr_fixups:checked_rel32" {
    var bytes: [32]u8;
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x140001000; segs[0].filesz = 8; segs[0].memsz = 8;
    var seg_secs: [1]PeSection;
    seg_secs[0].content_file_off = 8;
    var libs: [1]of.DynLib;
    var imports: [1]of.DynImport;
    imports[0].lib_index = 0; imports[0].is_func = false;
    var fx: [1]of.ImportAddrFixup;
    fx[0].seg_index = 0; fx[0].seg_offset = 0; fx[0].import_index = 0;
    fx[0].patch_vaddr = segs[0].vaddr; fx[0].kind = of.RK_PC32;
    fx[0].addend = -4;
    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0]; dyn.lib_count = 1;
    dyn.imports = ?imports[0]; dyn.import_count = 1;
    dyn.import_addr_fixups = ?fx[0]; dyn.import_addr_fixup_count = 1;
    var lay: PeLayout;
    lay.image_base = 0x140000000;
    lay.idata_sec.rva = 0x5000;
    lay.seg_secs = ?seg_secs[0];

    val slot_va: u64 = lay.image_base
        + pe_import_iat_slot_rva(?lay, ?dyn, 0);
    val patched: R.Result[R.Void, str] = patch_pe_import_addr_fixups(
        ?bytes[0], ?lay, ?dyn, ?segs[0], 1);
    val want: i64 = slot_va::i64 - 4 - fx[0].patch_vaddr::i64;
    if (R.is_err[R.Void, str](patched)
        || bin.read_u32_le(?bytes[0], 8) != (want::u64)::u32) { ret 1; }

    fx[0].seg_offset = 5;
    if (!R.is_err[R.Void, str](patch_pe_import_addr_fixups(
        ?bytes[0], ?lay, ?dyn, ?segs[0], 1))) { ret 1; }
    fx[0].seg_offset = 0;
    fx[0].kind = of.RK_ABS64;
    if (!R.is_err[R.Void, str](patch_pe_import_addr_fixups(
        ?bytes[0], ?lay, ?dyn, ?segs[0], 1))) { ret 1; }
    fx[0].kind = of.RK_PC32;
    fx[0].patch_vaddr = 0;
    if (!R.is_err[R.Void, str](patch_pe_import_addr_fixups(
        ?bytes[0], ?lay, ?dyn, ?segs[0], 1))) { ret 1; }
    ret 0;
}

fun ts_pe_debug_sections() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }
    val base:  u64 = 0x140001000;
    val entry: u64 = base;
    var segs: [1]of.LoadSegment;
    segs[0].vaddr = base; segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];

    var cv_bytes: [4]u8;
    cv_bytes[0] = 0xDE; cv_bytes[1] = 0xAD; cv_bytes[2] = 0xBE; cv_bytes[3] = 0xEF;
    var info_bytes: [3]u8;
    info_bytes[0] = 0x11; info_bytes[1] = 0x22; info_bytes[2] = 0x33;

    val nm_cv:   R.Result[intern.StrId, str] = intern.intern(?i, ".debug$S");
    val nm_info: R.Result[intern.StrId, str] = intern.intern(?i, ".debug_info");
    if (R.is_err[intern.StrId, str](nm_cv))   { ret 1; }
    if (R.is_err[intern.StrId, str](nm_info)) { ret 1; }

    var dbg: [2]of.Section;
    dbg[0].name = R.unwrap_ok[intern.StrId, str](nm_cv);   dbg[0].kind = of.SK_DEBUG;
    dbg[0].bytes = ?cv_bytes[0];   dbg[0].len = 4; dbg[0].align = 1;
    dbg[1].name = R.unwrap_ok[intern.StrId, str](nm_info); dbg[1].kind = of.SK_DEBUG;
    dbg[1].bytes = ?info_bytes[0]; dbg[1].len = 3; dbg[1].align = 1;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_dbg");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1,
                                                 4096, base - PE_SECTION_ALIGN, entry,
                                                 nil, 0, nil::*of.Section, 0, ?dbg[0], 2,
                                                 nil::*of.SymtabEntry, 0,
                                                 fs.temp_path(?tf)::*u8, "coffdbg"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val pe_off:   usize = bin.read_u32_le(buf.data, 0x3C)::usize;
    val ch:       usize = pe_off + 4;
    val nsec:     u32 = bin.read_u16_le(buf.data, ch + 2)::u32;
    val opt_size: usize = bin.read_u16_le(buf.data, ch + 16)::usize;
    val symtab:   usize = bin.read_u32_le(buf.data, ch + 8)::usize;
    if (nsec != 3)   { ret 1; }
    if (symtab == 0) { ret 1; }

    val info_want: str = ".debug_info";
    var j: usize = 0;
    for (j < str_len(info_want)) { if (buf.data[symtab + 4 + j] != info_want[j]) { ret 1; } j = j + 1; }
    if (buf.data[symtab + 4 + str_len(info_want)] != 0) { ret 1; }

    val sec_table: usize = ch + 20 + opt_size;
    var found_cv:   bool = false;
    var found_info: bool = false;
    var bad:        bool = false;
    var s: u32 = 0;
    for (s < nsec) {
        val sh:    usize = sec_table + s::usize * SECTION_HEADER_SIZE;
        val chars: u32 = bin.read_u32_le(buf.data, sh + 36);
        if ((chars & IMAGE_SCN_MEM_DISCARDABLE) == 0) { s = s + 1; cnt; }
        val vsize:  usize = bin.read_u32_le(buf.data, sh + 8)::usize;
        val rawptr: usize = bin.read_u32_le(buf.data, sh + 20)::usize;

        if (buf.data[sh] == '.' && vsize == 4) {
            found_cv = true;
            if ((chars & IMAGE_SCN_MEM_READ) == 0) { bad = true; }
            if (buf.data[rawptr] != 0xDE || buf.data[rawptr + 1] != 0xAD
                || buf.data[rawptr + 2] != 0xBE || buf.data[rawptr + 3] != 0xEF) { bad = true; }
        }
        if (buf.data[sh] == '/' && vsize == 3) {
            found_info = true;
            if (buf.data[rawptr] != 0x11 || buf.data[rawptr + 1] != 0x22 || buf.data[rawptr + 2] != 0x33) { bad = true; }
        }
        s = s + 1;
    }

    if (bad)         { ret 1; }
    if (!found_cv)   { ret 1; }
    if (!found_info) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:debug_sections_discardable" {
    if (ts_pe_debug_sections() != 0) { ret 1; }
    ret 0;
}

fun ts_dyn_exec_relro_naming() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0xAA; k = k + 1; }
    var rodata_bytes: [16]u8;
    k = 0;
    for (k < 16) { rodata_bytes[k] = 0xBB; k = k + 1; }
    var relro_bytes: [8]u8;
    k = 0;
    for (k < 8) { relro_bytes[k] = 0xCC; k = k + 1; }

    val base: u64 = 0x140001000;
    val pg:   u64 = 0x1000;
    var segs: [5]of.LoadSegment;
    segs[0].vaddr = base;          segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE;  segs[0].bytes = ?text_bytes[0];
    segs[1].vaddr = base + pg;     segs[1].filesz = 8;  segs[1].memsz = 8;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;    segs[1].bytes = ?data_bytes[0];
    segs[2].vaddr = base + pg * 2; segs[2].filesz = 16; segs[2].memsz = 16;
    segs[2].flags = of.SEG_FLAG_READ;                        segs[2].bytes = ?rodata_bytes[0];
    segs[3].vaddr = base + pg * 3; segs[3].filesz = 8;  segs[3].memsz = 8;
    segs[3].flags = of.SEG_FLAG_READ;                        segs[3].bytes = ?relro_bytes[0];
    segs[4].vaddr = base + pg * 4; segs[4].filesz = 0;  segs[4].memsz = 16;
    segs[4].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;    segs[4].bytes = nil;

    var brs: [1]of.BaseReloc;
    brs[0].seg_index = 3; brs[0].seg_offset = 0; brs[0].target = base;

    var dyn: of.DynamicInfo;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = ?brs[0];
    dyn.base_reloc_count = 1;
    dyn.pie = true;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_relro_name");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);

    val em: R.Result[R.Void, str] = t_planned_coff_emit_dyn_exec(?alloc, ?i, ?isa_vt, ?segs[0], 5,
                                                      4096, base - PE_SECTION_ALIGN, base,
                                                      nil::*of.ExecFunction, 0, ?dyn,
                                                      nil::*of.PltFixup, 0, nil::*of.Section, 0,
                                                      nil::*of.Section, 0,
                                                      nil::*of.SymtabEntry, 0,
                                                      fs.temp_path(?tf)::*u8, "coffrelro"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val pe_off:    usize = bin.read_u32_le(buf.data, 0x3C)::usize;
    val ch:        usize = pe_off + 4;
    val nsec:      u32   = bin.read_u16_le(buf.data, ch + 2)::u32;
    val opt_size:  usize = bin.read_u16_le(buf.data, ch + 16)::usize;
    val strtab:    usize = bin.read_u32_le(buf.data, ch + 8)::usize;
    val sec_table: usize = ch + 20 + opt_size;

    var names:   [16]str;
    var scratch: [144]u8;
    var s: u32 = 0;
    var rdata_count: u32 = 0;
    var relro_count: u32 = 0;
    for (s < nsec) {
        val sh: usize = sec_table + s::usize * SECTION_HEADER_SIZE;
        val rn: R.Result[str, str] = read_section_name(buf.data, buf.len, sh, strtab, ?scratch[s::usize * 9]);
        if (R.is_err[str, str](rn)) { ret 1; }
        names[s] = R.unwrap_ok[str, str](rn);
        if (str_equals(names[s], ".rdata"))       { rdata_count = rdata_count + 1; }
        if (str_equals(names[s], ".data.rel.ro")) { relro_count = relro_count + 1; }
        s = s + 1;
    }
    if (rdata_count != 1) { ret 1; }
    if (relro_count != 1) { ret 1; }

    var a: u32 = 0;
    for (a < nsec) {
        var b: u32 = a + 1;
        for (b < nsec) {
            if (str_equals(names[a], names[b])) { ret 1; }
            b = b + 1;
        }
        a = a + 1;
    }

    val relro_sh: usize = sec_table + 3::usize * SECTION_HEADER_SIZE;
    if (bin.read_u32_le(buf.data, relro_sh + 8) != 8) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_dyn_exec:relro_section_naming" {
    if (ts_dyn_exec_relro_naming() != 0) { ret 1; }
    ret 0;
}

fun ts_write_section_name_field() u8 {
    var buf: [9]u8;
    var k: usize = 0;
    for (k < 9) { buf[k] = 0xFF; k = k + 1; }

    var str_pos: usize = 4;
    val long_name: str = ".averylongname";
    write_section_name_field(?buf[0], 0, long_name, ?str_pos);

    if (buf[0] != '/')                                { ret 1; }
    if (str_pos != 4 + str_len(long_name) + 1)         { ret 1; }
    if (buf[8] != 0xFF)                                { ret 1; }

    var buf2: [9]u8;
    k = 0;
    for (k < 9) { buf2[k] = 0xFF; k = k + 1; }
    var str_pos2: usize = 4;
    val fit_name: str = ".rodata8";
    write_section_name_field(?buf2[0], 0, fit_name, ?str_pos2);
    if (buf2[0] != '.')  { ret 1; }
    if (str_pos2 != 4)   { ret 1; }
    if (buf2[8] != 0xFF) { ret 1; }

    ret 0;
}

test "mach.lang.target.of.coff.write_section_name_field:long_name_no_overflow" {
    if (ts_write_section_name_field() != 0) { ret 1; }
    ret 0;
}

fun ts_pe_aggregates_match(file: *u8, code_secs: *u32, idata_secs: *u32) u8 {
    val pe:        usize = bin.read_u32_le(file, 0x3C)::usize;
    val ch:        usize = pe + PE_SIGNATURE_SIZE;
    val oh:        usize = ch + COFF_HEADER_SIZE;
    val nsec:      u32   = bin.read_u16_le(file, ch + 2)::u32;
    val sec_table: usize = oh + bin.read_u16_le(file, ch + 16)::usize;

    var code:  u64 = 0;
    var idata: u64 = 0;
    var udata: u64 = 0;
    @code_secs = 0;
    @idata_secs = 0;
    var s: u32 = 0;
    for (s < nsec) {
        val sh:    usize = sec_table + s::usize * SECTION_HEADER_SIZE;
        val chars: u32   = bin.read_u32_le(file, sh + 36);
        if ((chars & IMAGE_SCN_CNT_CODE) != 0) {
            code = code + bin.read_u32_le(file, sh + 16)::u64;
            @code_secs = @code_secs + 1;
        }
        if ((chars & IMAGE_SCN_CNT_INITIALIZED_DATA) != 0) {
            idata = idata + bin.read_u32_le(file, sh + 16)::u64;
            @idata_secs = @idata_secs + 1;
        }
        if ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0) {
            udata = udata + bin.read_u32_le(file, sh + 8)::u64;
        }
        s = s + 1;
    }

    if (bin.read_u32_le(file, oh + 4)::u64 != code)   { ret 1; }
    if (bin.read_u32_le(file, oh + 8)::u64 != idata)  { ret 1; }
    if (bin.read_u32_le(file, oh + 12)::u64 != udata) { ret 1; }
    ret 0;
}

fun ts_pe_import_stub_accounting() u8 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = 0x90; k = k + 1; }
    var data_bytes: [8]u8;
    k = 0;
    for (k < 8) { data_bytes[k] = 0xAA; k = k + 1; }

    val base: u64 = 0x140001000;
    val pg:   u64 = 0x1000;
    var segs: [3]of.LoadSegment;
    segs[0].vaddr = base;          segs[0].filesz = 16; segs[0].memsz = 16;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?text_bytes[0];
    segs[1].vaddr = base + pg;     segs[1].filesz = 8;  segs[1].memsz = 8;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;   segs[1].bytes = ?data_bytes[0];
    segs[2].vaddr = base + pg * 2; segs[2].filesz = 0;  segs[2].memsz = 32;
    segs[2].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE;   segs[2].bytes = nil;

    var libs: [1]of.DynLib;
    libs[0].name = t_intern(?i, "kernel32"); libs[0].soname = t_intern(?i, "kernel32.dll");
    libs[0].rpath = intern.STR_NIL;

    var imps: [2]of.DynImport;
    imps[0].symbol = t_intern(?i, "ExitProcess"); imps[0].lib_index = 0;
    imps[0].is_func = true; imps[0].ordinal = 0; imps[0].by_ordinal = false;
    imps[1].symbol = t_intern(?i, "GetLastError"); imps[1].lib_index = 0;
    imps[1].is_func = true; imps[1].ordinal = 0; imps[1].by_ordinal = false;

    var dyn: of.DynamicInfo;
    dyn.libs = ?libs[0]; dyn.lib_count = 1;
    dyn.imports = ?imps[0]; dyn.import_count = 2;
    dyn.interp = intern.STR_NIL;
    dyn.base_relocs = nil::*of.BaseReloc; dyn.base_reloc_count = 0;
    dyn.pie = false;
    dyn.import_addr_fixups = nil::*of.ImportAddrFixup; dyn.import_addr_fixup_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_stub_acct");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = t_planned_coff_emit_dyn_exec(?alloc, ?i, ?isa_vt, ?segs[0], 3,
                                                      4096, base - PE_SECTION_ALIGN, base,
                                                      nil::*of.ExecFunction, 0, ?dyn,
                                                      nil::*of.PltFixup, 0, nil::*of.Section, 0,
                                                      nil::*of.Section, 0,
                                                      nil::*of.SymtabEntry, 0,
                                                      fs.temp_path(?tf)::*u8, "coffstub"::*u8,
                                                      of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val file: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var code_secs:  u32 = 0;
    var idata_secs: u32 = 0;
    if (ts_pe_aggregates_match(file.data, ?code_secs, ?idata_secs) != 0) { ret 1; }
    if (code_secs != 2) { ret 1; }
    if (idata_secs != 2) { ret 1; }

    val pe:        usize = bin.read_u32_le(file.data, 0x3C)::usize;
    val ch:        usize = pe + PE_SIGNATURE_SIZE;
    val oh:        usize = ch + COFF_HEADER_SIZE;
    val sec_table: usize = oh + bin.read_u16_le(file.data, ch + 16)::usize;
    if (bin.read_u32_le(file.data, oh + 4) <= bin.read_u32_le(file.data, sec_table + 16)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_dyn_exec:import_stub_code_accounting" {
    if (ts_pe_import_stub_accounting() != 0) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_emit_exec:resource_directory_and_accounting" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text: [16]u8;
    var i: usize = 0;
    for (i < 16) { text[i] = 0x90; i = i + 1; }
    val base: u64 = 0x140001000;
    var seg: of.LoadSegment;
    seg.vaddr = base; seg.filesz = 16; seg.memsz = 16;
    seg.flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; seg.bytes = ?text[0];

    val manifest: str = "<assembly resource-test='yes'/>";
    var info: of.ResourceInfo;
    info.icon = nil; info.icon_len = 0;
    info.app_manifest = manifest::*u8; info.app_manifest_len = str_len(manifest);
    info.version = "7.8.9"; info.internal_name = "resource-test";
    info.original_filename = "renamed-resource-test.exe";
    info.product_name = "resource-test";
    var opts: of.ImageOptions = of.image_options_default(of.SUBSYSTEM_CONSOLE);
    opts.resources = ?info;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_resource");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = t_planned_coff_emit_exec(?alloc, ?itn, ?isa_vt, ?seg, 1,
        4096, base - PE_SECTION_ALIGN, base, nil, 0, nil::*of.Section, 0,
        nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
        fs.temp_path(?tf)::*u8, "resource-test"::*u8, opts);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 1; }
    val file: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val pe: usize = bin.read_u32_le(file.data, 0x3C)::usize;
    val ch: usize = pe + PE_SIGNATURE_SIZE;
    val oh: usize = ch + COFF_HEADER_SIZE;
    if (bin.read_u16_le(file.data, ch + 2) != 2) { ret 1; }
    val rsh: usize = oh + OPTIONAL_HEADER_SIZE + SECTION_HEADER_SIZE;
    if (file.data[rsh] != '.' || file.data[rsh + 1] != 'r'
        || file.data[rsh + 2] != 's' || file.data[rsh + 3] != 'r'
        || file.data[rsh + 4] != 'c') { ret 1; }
    val rsrc_vsize: u32 = bin.read_u32_le(file.data, rsh + 8);
    val rsrc_rva: u32 = bin.read_u32_le(file.data, rsh + 12);
    val rsrc_raw_size: u32 = bin.read_u32_le(file.data, rsh + 16);
    val rsrc_raw: usize = bin.read_u32_le(file.data, rsh + 20)::usize;
    val dd: usize = oh + 112 + IMAGE_DIRECTORY_ENTRY_RESOURCE::usize * DATA_DIR_SIZE;
    if (bin.read_u32_le(file.data, dd) != rsrc_rva
        || bin.read_u32_le(file.data, dd + 4) != rsrc_vsize) { ret 1; }
    var code_secs:  u32 = 0;
    var idata_secs: u32 = 0;
    if (ts_pe_aggregates_match(file.data, ?code_secs, ?idata_secs) != 0) { ret 1; }
    if (code_secs != 1 || idata_secs != 1)                   { ret 1; }
    if (bin.read_u32_le(file.data, oh + 8) != rsrc_raw_size) { ret 1; }

    if (bin.read_u16_le(file.data, rsrc_raw + 14) != 2) { ret 1; }
    val root_manifest: usize = rsrc_raw + 16 + 8;
    if (bin.read_u32_le(file.data, root_manifest) != rs.RT_MANIFEST) { ret 1; }
    val l2: usize = rsrc_raw + (bin.read_u32_le(file.data, root_manifest + 4) & 0x7FFFFFFF)::usize;
    val l3: usize = rsrc_raw + (bin.read_u32_le(file.data, l2 + 16 + 4) & 0x7FFFFFFF)::usize;
    val de: usize = rsrc_raw + bin.read_u32_le(file.data, l3 + 16 + 4)::usize;
    val payload: usize = rsrc_raw + (bin.read_u32_le(file.data, de) - rsrc_rva)::usize;
    if (bin.read_u32_le(file.data, de + 4)::usize != str_len(manifest)) { ret 1; }
    i = 0;
    for (i < str_len(manifest)) {
        if (file.data[payload + i] != manifest[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.target.of.coff.validate_pe_layout:rejects_narrowing" {
    var lay: PeLayout;
    lay.sec_total = 65536;
    val count_r: R.Result[R.Void, str] = validate_pe_layout(?lay, 0, 0);
    if (R.is_ok[R.Void, str](count_r)) { ret 1; }
    lay.sec_total = 1; lay.have_rsrc = true;
    lay.rsrc_sec.rva = 0x100000000; lay.rsrc_sec.vsize = 1;
    val rsrc_r: R.Result[R.Void, str] = validate_pe_layout(?lay, 0, 1);
    if (R.is_ok[R.Void, str](rsrc_r)) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.coff.coff_serialize_image:bigobj_round_trip" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    val n: u32 = 70000;
    val rsec: R.Result[*of.Section, str] = A.zallocate[of.Section](?alloc, n::usize);
    if (R.is_err[*of.Section, str](rsec)) { ret 1; }
    val secs: *of.Section = R.unwrap_ok[*of.Section, str](rsec);
    val text_name: intern.StrId = t_intern(?i, ".text");
    var s: u32 = 0;
    for (s < n) {
        secs[s].name = text_name;
        secs[s].kind = of.SK_TEXT;
        secs[s].bytes = nil;
        secs[s].len = 0;
        secs[s].align = 1;
        s = s + 1;
    }

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "first"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 0; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "last"); syms[1].section = n - 1; syms[1].offset = 0;
    syms[1].size = 0; syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "bigobj_test");
    img.sections = secs; img.section_count = n;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_bigobj");
    if (R.is_err[fs.TempFile, str](tf_r)) { A.deallocate[of.Section](?alloc, secs, n::usize); ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] = t_planned_coff_serialize_image(?img, nil, tpath::*u8);
    if (R.is_err[R.Void, str](em)) {
        fs.temp_close_and_remove(?tf);
        A.deallocate[of.Section](?alloc, secs, n::usize);
        ret 1;
    }

    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { A.deallocate[of.Section](?alloc, secs, n::usize); ret 1; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    var bad: i32 = 0;
    if (bin.read_u16_le(buf.data, 0) != IMAGE_FILE_MACHINE_UNKNOWN) { bad = 1; }
    or (bin.read_u16_le(buf.data, 2) != BIGOBJ_SIG2)                { bad = 1; }

    var out: of.ObjectImage;
    val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
    if (R.is_err[R.Void, str](pr))     { bad = 1; }
    or (out.section_count != n)      { bad = 1; }
    or (out.symbol_count != n + 2)   { bad = 1; }

    if (bad == 0) {
        var saw_first: bool = false;
        var saw_last:  bool = false;
        var si: u32 = 0;
        for (si < out.symbol_count) {
            if (out.symbols[si].name == syms[0].name) {
                saw_first = true;
                if (out.symbols[si].section != 0) { bad = 1; }
            }
            if (out.symbols[si].name == syms[1].name) {
                saw_last = true;
                if (out.symbols[si].section != n - 1) { bad = 1; }
            }
            si = si + 1;
        }
        if (!saw_first || !saw_last) { bad = 1; }
    }

    A.deallocate[of.Section](?alloc, secs, n::usize);
    ret bad;
}

test "mach.lang.target.of.coff.read_inplace_addend:rel32_biased_forms" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var f0: [4]u8;
    f0[0] = 0; f0[1] = 0; f0[2] = 0; f0[3] = 0;
    var sec0: of.Section;
    sec0.bytes = ?f0[0]; sec0.len = 4;

    if (read_inplace_addend(?sec0, IMAGE_REL_AMD64_REL32,     0) != -4)  { ret 1; }
    if (read_inplace_addend(?sec0, 0x0005, 0) != -5)  { ret 2; }
    if (read_inplace_addend(?sec0, 0x0006, 0) != -6)  { ret 3; }
    if (read_inplace_addend(?sec0, 0x0007, 0) != -7)  { ret 4; }
    if (read_inplace_addend(?sec0, 0x0008, 0) != -8)  { ret 5; }
    if (read_inplace_addend(?sec0, IMAGE_REL_AMD64_REL32_5,   0) != -9)  { ret 6; }

    var f7: [4]u8;
    f7[0] = 7; f7[1] = 0; f7[2] = 0; f7[3] = 0;
    var sec7: of.Section;
    sec7.bytes = ?f7[0]; sec7.len = 4;
    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_REL32,   0) != 3) { ret 7; }
    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_REL32_1, 0) != 2) { ret 8; }
    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_REL32_5, 0) != -2) { ret 9; }

    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_SECTION, 0) != 0) { ret 10; }
    if (read_inplace_addend(?sec7, IMAGE_REL_AMD64_SECREL,  0) != 7) { ret 11; }
    ret 0;
}

test "mach.lang.target.of.coff.reloc_kind_for:rel32_biased_forms_are_pc32" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    var t: u16 = IMAGE_REL_AMD64_REL32;
    for (t <= IMAGE_REL_AMD64_REL32_5) {
        val r: R.Result[of.RelocKind, str] = reloc_kind_for(?itn, ?alloc, t);
        if (R.is_err[of.RelocKind, str](r)) { ret 1; }
        if (R.unwrap_ok[of.RelocKind, str](r) != of.RK_PC32) { ret 2; }
        t = t + 1;
    }

    val sect: R.Result[of.RelocKind, str] = reloc_kind_for(?itn, ?alloc, IMAGE_REL_AMD64_SECTION);
    if (R.is_err[of.RelocKind, str](sect)) { ret 3; }
    if (R.unwrap_ok[of.RelocKind, str](sect) == of.RK_PC32) { ret 4; }
    ret 0;
}

fun t_comdat_selection_off(buf: *u8) usize {
    val symtab_off:  usize = bin.read_u32_le(buf, 8)::usize;
    val num_records: u32   = bin.read_u32_le(buf, 12);
    val rsize: usize = sym_record_size(false);
    var ri: u32 = 0;
    for (ri < num_records) {
        val so: usize = symtab_off + ri::usize * rsize;
        val aux: u8 = buf[sym_naux_off(so, false)];
        if (buf[sym_storage_class_off(so, false)] == IMAGE_SYM_CLASS_STATIC
            && aux >= 1 && (ri + 1) < num_records && bin.read_u32_le(buf, so + 8) == 0) {
            val secn: i32 = read_sym_section_number(buf, so, false);
            if (secn >= 1) {
                val sh: usize = COFF_HEADER_SIZE + (secn - 1)::u32::usize * SECTION_HEADER_SIZE;
                if ((bin.read_u32_le(buf, sh + 36) & IMAGE_SCN_LNK_COMDAT) != 0) {
                    ret so + rsize + 14;
                }
            }
        }
        ri = ri + 1 + aux::u32;
    }
    ret 0;
}

test "mach.lang.target.of.coff.comdat_selection_dedups:every_one_of_n_selection" {
    if (!comdat_selection_dedups(IMAGE_COMDAT_SELECT_ANY))          { ret 1; }
    if (!comdat_selection_dedups(IMAGE_COMDAT_SELECT_SAME_SIZE))    { ret 2; }
    if (!comdat_selection_dedups(IMAGE_COMDAT_SELECT_EXACT_MATCH))  { ret 3; }
    if (!comdat_selection_dedups(IMAGE_COMDAT_SELECT_ASSOCIATIVE))  { ret 4; }
    if (!comdat_selection_dedups(IMAGE_COMDAT_SELECT_LARGEST))      { ret 5; }

    if (comdat_selection_dedups(IMAGE_COMDAT_SELECT_NODUPLICATES))  { ret 6; }

    if (comdat_selection_dedups(0)) { ret 7; }
    if (comdat_selection_dedups(7)) { ret 8; }
    ret 0;
}

test "mach.lang.target.of.coff:default_stack_reserve_is_8mib" {
    var reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](register_coff(?reg)))                      { ret 4; }
    val registered: O.Option[*of.OfVTable] = of.lookup(?reg, of.of_name_for(of.OF_COFF));
    if (O.is_none[*of.OfVTable](registered))                           { ret 4; }
    val coff_vtable: *of.OfVTable = O.unwrap[*of.OfVTable](registered);
    if (PE_DEFAULT_STACK_RESERVE != 0x800000)                          { ret 1; }
    if (of.effective_stack_reserve(coff_vtable, 0) != 0x800000)        { ret 2; }
    if (of.effective_stack_reserve(coff_vtable, 1048576) != 1048576)   { ret 3; }
    ret 0;
}

test "mach.lang.target.of.coff:comdat_selection_decides_weakness_on_read" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var text_bytes: [16]u8;
    var k: usize = 0;
    for (k < 16) { text_bytes[k] = (0x10 + k)::u8; k = k + 1; }

    var secs: [1]of.Section;
    secs[0].name = t_intern(?i, ".text"); secs[0].kind = of.SK_TEXT;
    secs[0].bytes = ?text_bytes[0]; secs[0].len = 16; secs[0].align = 16;

    var syms: [2]of.Symbol;
    syms[0].name = t_intern(?i, "main"); syms[0].section = 0; syms[0].offset = 0;
    syms[0].size = 0; syms[0].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION;
    syms[1].name = t_intern(?i, "vtable$T"); syms[1].section = 0; syms[1].offset = 8;
    syms[1].size = 0;
    syms[1].flags = of.SYM_OBJ_FLAG_GLOBAL | of.SYM_OBJ_FLAG_FUNCTION | of.SYM_OBJ_FLAG_WEAK;

    var img: of.ObjectImage;
    img.alloc = ?alloc;
    img.interner = ?i;
    img.name = t_intern(?i, "test");
    img.sections = ?secs[0]; img.section_count = 1;
    img.symbols = ?syms[0]; img.symbol_count = 2;
    img.relocations = nil; img.reloc_count = 0;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "coff_sel");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val em: R.Result[R.Void, str] = t_planned_coff_emit_object(?isa_vt, ?img, fs.temp_path(?tf)::*u8);
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 2; }
    val rb: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rb)) { ret 3; }
    val buf: Vector[u8] = R.unwrap_ok[Vector[u8], str](rb);

    val soff: usize = t_comdat_selection_off(buf.data);
    if (soff == 0)                                          { ret 4; }
    if (buf.data[soff] != IMAGE_COMDAT_SELECT_ANY)          { ret 5; }

    var sels: [6]u8;
    sels[0] = IMAGE_COMDAT_SELECT_ANY;
    sels[1] = IMAGE_COMDAT_SELECT_SAME_SIZE;
    sels[2] = IMAGE_COMDAT_SELECT_EXACT_MATCH;
    sels[3] = IMAGE_COMDAT_SELECT_ASSOCIATIVE;
    sels[4] = IMAGE_COMDAT_SELECT_LARGEST;
    sels[5] = IMAGE_COMDAT_SELECT_NODUPLICATES;

    var si: usize = 0;
    for (si < 6) {
        buf.data[soff] = sels[si];
        var out: of.ObjectImage;
        val pr: R.Result[R.Void, str] = coff_parse_object(?alloc, ?i, buf.data, buf.len, ?out);
        if (R.is_err[R.Void, str](pr)) { ret 6; }

        var seen: bool = false;
        var oi: u32 = 0;
        for (oi < out.symbol_count) {
            if (out.symbols[oi].name == syms[1].name) {
                seen = true;
                val weak: bool = (out.symbols[oi].flags & of.SYM_OBJ_FLAG_WEAK) != 0;
                if (si == 5 && weak)  { ret 7; }
                if (si != 5 && !weak) { ret 8; }
            }
            oi = oi + 1;
        }
        if (!seen) { ret 9; }
        si = si + 1;
    }
    ret 0;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) R.Result[*publication.Destination, str] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](initialized))); }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret destination; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](sealed))); }
    ret destination;
}

fun t_publication_close(operation: *publication.Plan, result: R.Result[R.Void, str]) R.Result[R.Void, str] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (R.is_ok[R.Void, str](result) && O.is_some[txn.Error](closed)) {
        ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](closed)));
    }
    ret result;
}

fun t_planned_coff_emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                       seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                       funcs: *of.ExecFunction,
                       func_count: u32, dyn: *of.DynamicInfo,
                       fixups: *of.PltFixup, fixup_count: u32,
                       exceptions: *of.Section, exception_count: u32,
                       debug: *of.Section, debug_count: u32,
                       symtab: *of.SymtabEntry, symtab_count: u32,
                       path: *u8, name: *u8, image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret coff_emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, coff_emit_dyn_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, dyn, fixups, fixup_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), name, image_options));
}

fun t_planned_coff_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, isa_vt: *of.ObjectTarget, segs: *of.LoadSegment,
                   seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                   funcs: *of.ExecFunction,
                   func_count: u32, exceptions: *of.Section, exception_count: u32,
                   debug: *of.Section, debug_count: u32,
                   symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
                   image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret coff_emit_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, coff_emit_exec(alloc, itn, isa_vt, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), name, image_options));
}

fun t_planned_coff_emit_object(tgt_isa: *of.ObjectTarget, img: *of.ObjectImage, path: *u8) R.Result[R.Void, str] {
    if (path == nil) { ret coff_emit_object(tgt_isa, img, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, img.alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, coff_emit_object(tgt_isa, img, R.unwrap_ok[*publication.Destination, str](opened)));
}

fun t_planned_coff_serialize_image(img: *of.ObjectImage, comdat: *bool, path: *u8) R.Result[R.Void, str] {
    if (path == nil) { ret coff_serialize_image(img, comdat, nil::*publication.Destination); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, img.alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, coff_serialize_image(img, comdat, R.unwrap_ok[*publication.Destination, str](opened)));
}
