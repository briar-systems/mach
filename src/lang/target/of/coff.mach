val UWOP_SAVE_XMM128:     u8 = 8;
val UWOP_SAVE_XMM128_FAR: u8 = 9;

# the relocation kinds COFF honors: the AMD64 relocation type each one is
# written as and the width of the field it patches. a declared kind without a
# row is unsupported by COFF; a kind outside the catalog is internal
rec CoffRelocDesc {
    kind:        target_of.RelocKind;
    r_type:      u16;
    field_width: usize;
}

val RELOC_N: usize = 7;

val RELOCS: [RELOC_N]CoffRelocDesc = [RELOC_N]CoffRelocDesc{
    CoffRelocDesc{kind: target_of.RK_ABS64, r_type: IMAGE_REL_AMD64_ADDR64, field_width: 8},
    CoffRelocDesc{kind: target_of.RK_PC32, r_type: IMAGE_REL_AMD64_REL32, field_width: 4},
    CoffRelocDesc{kind: target_of.RK_PLT32, r_type: IMAGE_REL_AMD64_REL32, field_width: 4},
    CoffRelocDesc{kind: target_of.RK_ADDR32NB, r_type: IMAGE_REL_AMD64_ADDR32NB, field_width: 4},
    CoffRelocDesc{kind: target_of.RK_ABS32, r_type: IMAGE_REL_AMD64_ADDR32, field_width: 4},
    CoffRelocDesc{kind: target_of.RK_SECREL32, r_type: IMAGE_REL_AMD64_SECREL, field_width: 4},
    CoffRelocDesc{kind: target_of.RK_SECTION, r_type: IMAGE_REL_AMD64_SECTION, field_width: 2},
};

fun reloc(kind: target_of.RelocKind) opt[*CoffRelocDesc] {
    var i: usize = 0;
    for (i < RELOC_N) {
        if (RELOCS[i].kind == kind) { ret opt[*CoffRelocDesc].some{?RELOCS[i]}; }
        i = i + 1;
    }
    ret opt[*CoffRelocDesc].none{};
}

fun reloc_type_for(itn: *intern.Interner, alloc: *A.Allocator, kind: target_of.RelocKind, origin: target_of.RelocOrigin) res[u16, fail.Fail] {
    val desc: opt[*CoffRelocDesc] = reloc(kind);
    if (sel desc.none) { ret res[u16, fail.Fail].err{target_of.reloc_refusal_made(origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, unsupported_kind_message(itn, alloc, kind))}; }
    ret res[u16, fail.Fail].ok{desc.some.r_type};
}

fun reloc_field_width(itn: *intern.Interner, alloc: *A.Allocator, kind: target_of.RelocKind, origin: target_of.RelocOrigin) res[usize, fail.Fail] {
    val desc: opt[*CoffRelocDesc] = reloc(kind);
    if (sel desc.none) { ret res[usize, fail.Fail].err{target_of.reloc_refusal_made(origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, unsupported_kind_message(itn, alloc, kind))}; }
    ret res[usize, fail.Fail].ok{desc.some.field_width};
}

fun unsupported_kind_message(itn: *intern.Interner, alloc: *A.Allocator, kind: target_of.RelocKind) res[str, fail.Fail] {
    ret target_of.reloc_kind_rejection(itn, alloc, kind, "coff");
}

fun validate_reloc_kinds(img: *target_of.ObjectImage) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val r: res[u16, fail.Fail] = reloc_type_for(img.interner, img.alloc, img.relocations[i].kind, img.relocations[i].origin);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun rel32_bias(r_type: u16) i64 {
    if (r_type < IMAGE_REL_AMD64_REL32_1 || r_type > IMAGE_REL_AMD64_REL32_5) { ret 0; }
    ret (r_type - IMAGE_REL_AMD64_REL32)::i64;
}

fun is_rel32_family(r_type: u16) bool {
    ret r_type == IMAGE_REL_AMD64_REL32
        || (r_type >= IMAGE_REL_AMD64_REL32_1 && r_type <= IMAGE_REL_AMD64_REL32_5);
}

fun read_inplace_addend(sec: *target_of.Section, r_type: u16, offset: u32) i64 {
    if (sec.bytes == nil) { ret 0; }
    if (r_type == IMAGE_REL_AMD64_SECTION) {
        if (offset::usize + 2 > sec.len::usize) { ret 0; }
        ret bin.read_u16_le(sec.bytes, offset::usize)::i64;
    }
    if (r_type == IMAGE_REL_AMD64_ADDR64) {
        if (offset::usize + 8 > sec.len::usize) { ret 0; }
        ret bin.read_u64_le(sec.bytes, offset::usize)::i64;
    }
    if (offset::usize + 4 > sec.len::usize) { ret 0; }
    val field: i64 = (bin.read_u32_le(sec.bytes, offset::usize)::i32)::i64;
    if (is_rel32_family(r_type)) { ret field - 4 - rel32_bias(r_type); }
    ret field;
}

fun reloc_kind_for(itn: *intern.Interner, alloc: *A.Allocator, r_type: u16) res[target_of.RelocKind, fail.Fail] {
    if (r_type == IMAGE_REL_AMD64_ADDR64)   { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_ABS64}; }
    if (is_rel32_family(r_type))            { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_PC32}; }
    if (r_type == IMAGE_REL_AMD64_ADDR32NB) { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_ADDR32NB}; }
    if (r_type == IMAGE_REL_AMD64_ADDR32)   { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_ABS32}; }
    if (r_type == IMAGE_REL_AMD64_SECREL)   { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_SECREL32}; }
    if (r_type == IMAGE_REL_AMD64_SECTION)  { ret res[target_of.RelocKind, fail.Fail].ok{target_of.RK_SECTION}; }
    ret res[target_of.RelocKind, fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_UNSUPPORTED, bin.reloc_type_rejection(itn, alloc, r_type::u64))};
}

fun section_characteristics_for(kind: target_of.SectionKind) u32 {
    if (kind == target_of.SK_TEXT) {
        ret IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    }
    if (kind == target_of.SK_DATA) {
        ret IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    if (kind == target_of.SK_RODATA || kind == target_of.SK_RELRO || kind == target_of.SK_EXCEPTION) {
        ret IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    }
    if (kind == target_of.SK_BSS) {
        ret IMAGE_SCN_CNT_UNINITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    ret IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_DISCARDABLE | IMAGE_SCN_MEM_READ;
}

fun align_characteristic(align: u32) u32 {
    var a: u32 = align;
    if (a < 1) { a = 1; }
    var log: u32 = 0;
    for (a > 1) {
        a   = a >> 1;
        log = log + 1;
    }
    if (log > 13) { log = 13; }
    ret (log + 1) << 20;
}

fun align_from_characteristics(chars: u32) u32 {
    val field: u32 = (chars >> 20) & 0xF;
    if (field == 0) { ret 1; }
    var a: u32 = 1;
    var n: u32 = field - 1;
    for (n > 0) {
        a = a << 1;
        n = n - 1;
    }
    ret a;
}

# a kind outside the catalog carries no data; every image here was validated
# at entry, so such a kind never reaches this predicate
fun section_has_data(kind: target_of.SectionKind) bool {
    val desc: opt[*target_of.SectionKindDesc] = target_of.section_desc(kind);
    ret sel desc.some && desc.some.has_bits;
}

# the COFF symbol type a symbol takes from its section's kind, absent for a
# kind outside the catalog
fun symbol_type_for(kind: target_of.SectionKind) opt[u16] {
    val desc: opt[*target_of.SectionKindDesc] = target_of.section_desc(kind);
    if (sel desc.none)        { ret opt[u16].none{}; }
    if (desc.some.executable) { ret opt[u16].some{IMAGE_SYM_DTYPE_FUNCTION}; }
    ret opt[u16].some{0};
}

fun name_in_strtab(name: str) bool {
    ret name != nil && str_len(name) > 8;
}

fun strtab_size(img: *target_of.ObjectImage) usize {
    var total: usize = 4;
    var s:     u32   = 0;
    for (s < img.section_count) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (name_in_strtab(sn)) { total = total + str_len(sn) + 1; }
        s = s + 1;
    }
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val name: str = bin.resolve_name(img.interner, img.symbols[i].name);
        if (name_in_strtab(name)) { total = total + str_len(name) + 1; }
        i = i + 1;
    }
    ret total;
}

fun write_inline_name(buf: *u8, off: usize, name: str) {
    memory.raw_zero((buf::usize + off)::ptr, 8);
    if (name == nil) { ret; }
    memory.raw_copy((buf::usize + off)::ptr, name::ptr, str_len(name));
}

# a zero-padded field of `width` bytes holding the value's last `width` digits
fun write_decimal(buf: *u8, off: usize, width: usize, value: u32) {
    var digits: [std_format.DECIMAL_MAX]u8;
    val len:    usize = std_format.put_u64(?digits[0], value::u64);
    var keep:   usize = len;
    if (keep > width) { keep = width; }
    memory.raw_copy((buf::usize + off)::ptr, (?digits[len - keep])::ptr, keep);
    var p: usize = keep;
    for (p < width) {
        buf[off + p] = 0;
        p            = p + 1;
    }
}

val UNRESOLVED:         str = "unresolved relocation symbol: ";
val UNRESOLVED_UNNAMED: str = "relocation references an unresolved symbol";

fun validate_reloc_ranges(img: *target_of.ObjectImage) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.reloc_count) {
        val rsec: u32 = target_of.section_index(img.relocations[i].section);
        if (rsec >= img.section_count) {
            ret err[fail.Fail].err{fail.message_of(bin.number_message(img.interner, img.alloc, "out-of-range section referenced by relocation #", i::u64))};
        }
        if (!section_has_data(img.sections[rsec].kind)) {
            ret err[fail.Fail].err{fail.message_of(bin.number_message(img.interner, img.alloc, "relocation patches a section with no raw data; relocation #", i::u64))};
        }
        val wr: res[usize, fail.Fail] = reloc_field_width(img.interner, img.alloc, img.relocations[i].kind, img.relocations[i].origin);
        if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
        val w:   usize = wr.ok;
        val off: usize = img.relocations[i].offset::usize;
        if (off + w > img.sections[rsec].len::usize) {
            ret err[fail.Fail].err{fail.message_of(bin.number_message(img.interner, img.alloc, "relocation offset out of range for its section; relocation #", i::u64))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun is_defined_weak(sym: *target_of.Symbol, num_secs: u32) bool {
    if ((sym.flags & target_of.SYM_OBJ_FLAG_WEAK) == 0)   { ret false; }
    if (target_of.section_is_external(sym.section))       { ret false; }
    if (target_of.section_index(sym.section) >= num_secs) { ret false; }
    ret true;
}

# a coff linker collects only comdat sections, so every other placed section
# is kept whatever reaches it; the unwind tables are kept through the functions
# they describe
fun retain_outside_comdats(img: *target_of.ObjectImage) {
    val described: u32 = target_of.SEC_FLAG_UNWIND_INDEX | target_of.SEC_FLAG_UNWIND_FRAMES | target_of.SEC_FLAG_ASSOCIATED;
    var s:         u32 = 0;
    for (s < img.section_count) {
        val sec: *target_of.Section = ?img.sections[s];
        if (sec.native.selection == 0 && sec.kind != target_of.SK_DEBUG && (sec.flags & described) == 0) {
            sec.flags = sec.flags | target_of.SEC_FLAG_RETAIN;
        }
        s = s + 1;
    }
}

fun is_synthetic_weak(img: *target_of.ObjectImage, sym: *target_of.Symbol) bool {
    if (!is_defined_weak(sym, img.section_count)) { ret false; }
    val native: *target_of.NativeSection = ?img.sections[target_of.section_index(sym.section)].native;
    ret native.format != target_of.COFF || native.selection == 0;
}

fun count_defined_weak(img: *target_of.ObjectImage) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < img.symbol_count) {
        if (is_synthetic_weak(img, ?img.symbols[i])) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun weak_symbol_extent(img: *target_of.ObjectImage, sym_idx: u32) u32 {
    val sec:     u32 = target_of.section_index(img.symbols[sym_idx].section);
    val start:   u32 = img.symbols[sym_idx].offset;
    val sec_len: u32 = img.sections[sec].len;
    var end:     u32 = sec_len;
    var i:       u32 = 0;
    for (i < img.symbol_count) {
        if (i != sym_idx && target_of.section_index(img.symbols[i].section) == sec) {
            val o: u32 = img.symbols[i].offset;
            if (o > start && o < end) { end = o; }
        }
        i = i + 1;
    }
    if (end < start)   { ret 0; }
    if (end > sec_len) { end = sec_len; }
    ret end - start;
}

rec WeakRegion {
    sec:   u32;
    start: u32;
    end:   u32;
}

fun carrier_align(off: u32, sec_align: u32) u32 {
    var p: u32 = 1;
    for ((off & p) == 0 && p < sec_align && p < 0x40000000) { p = p << 1; }
    ret p;
}

fun free_build_scratch(alloc: *A.Allocator, regions: *WeakRegion, weak_n: u32,
    plan: *u32, plan_carrier: *bool, cap: u32,
    secmeta: *u32, orig_secs: u32) {
    if (regions != nil)      { A.deallocate[WeakRegion](alloc, regions, weak_n::usize); }
    if (plan != nil)         { A.deallocate[u32](alloc, plan, (cap * 3)::usize); }
    if (plan_carrier != nil) { A.deallocate[bool](alloc, plan_carrier, cap::usize); }
    if (secmeta != nil)      { A.deallocate[u32](alloc, secmeta, (orig_secs * 2)::usize); }
}

fun subsection_for(sec_base: *u32, sec_cnt: *u32, p_start: *u32, sec: u32, off: u32) u32 {
    val base: u32 = sec_base[sec];
    var lo:   u32 = base;
    var hi:   u32 = base + sec_cnt[sec];
    var pick: u32 = base;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (p_start[mid] <= off) {
            pick = mid;
            lo   = mid + 1;
        }
        or { hi = mid; }
    }
    ret pick;
}

fun build_weak_comdat_image(alloc: *A.Allocator, img: *target_of.ObjectImage,
    out: *target_of.ObjectImage, out_comdat: **bool) err[fail.Fail] {
    val orig_secs: u32 = img.section_count;

    val weak_n: u32 = count_defined_weak(img);

    @out             = target_of.object_image_init(alloc, img.interner, img.name);
    out.symbol_count = img.symbol_count;
    out.reloc_count  = img.reloc_count;
    @out_comdat      = nil;

    var regions: *WeakRegion = nil;
    if (weak_n > 0) {
        val rw: res[*WeakRegion, A.Error] = A.zallocate[WeakRegion](alloc, weak_n::usize);
        if (sel rw.err) { ret err[fail.Fail].err{fail.message("comdat weak-region alloc failed")}; }
        regions = rw.ok;
        var w: u32 = 0;
        var i: u32 = 0;
        for (i < img.symbol_count) {
            if (is_synthetic_weak(img, ?img.symbols[i])) {
                val st: u32 = img.symbols[i].offset;
                regions[w].sec   = target_of.section_index(img.symbols[i].section);
                regions[w].start = st;
                regions[w].end   = st + weak_symbol_extent(img, i);
                w                = w + 1;
            }
            i = i + 1;
        }
        sort.sort[WeakRegion](regions, weak_n::usize);
    }

    val cap: u32 = orig_secs + weak_n * 2;

    var p_src:     *u32  = nil;
    var p_start:   *u32  = nil;
    var p_len:     *u32  = nil;
    var p_carrier: *bool = nil;
    var sec_base:  *u32  = nil;
    var sec_cnt:   *u32  = nil;
    if (cap > 0) {
        val rp: res[*u32, A.Error] = A.zallocate[u32](alloc, (cap * 3)::usize);
        if (sel rp.err) {
            free_build_scratch(alloc, regions, weak_n, nil, nil, cap, nil, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat plan alloc failed")};
        }
        p_src   = rp.ok;
        p_start = (p_src::usize + cap::usize * 4)::*u32;
        p_len   = (p_src::usize + cap::usize * 8)::*u32;

        val rpc: res[*bool, A.Error] = A.zallocate[bool](alloc, cap::usize);
        if (sel rpc.err) {
            free_build_scratch(alloc, regions, weak_n, p_src, nil, cap, nil, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat plan-flag alloc failed")};
        }
        p_carrier = rpc.ok;
    }
    if (orig_secs > 0) {
        val rm: res[*u32, A.Error] = A.zallocate[u32](alloc, (orig_secs * 2)::usize);
        if (sel rm.err) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, nil, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat section-map alloc failed")};
        }
        sec_base = rm.ok;
        sec_cnt  = (sec_base::usize + orig_secs::usize * 4)::*u32;
    }

    var plan_n: u32 = 0;
    var wr:     u32 = 0;
    var s:      u32 = 0;
    for (s < orig_secs) {
        sec_base[s] = plan_n;
        val seclen:     u32  = img.sections[s].len;
        var cursor:     u32  = 0;
        var have_prev:  bool = false;
        var prev_start: u32  = 0;
        var prev_end:   u32  = 0;
        for (wr < weak_n && regions[wr].sec == s) {
            val bstart: u32 = regions[wr].start;
            val bend:   u32 = regions[wr].end;
            wr = wr + 1;
            if (have_prev && bstart == prev_start && bend == prev_end) { cnt; }
            if (bstart < cursor)                                       { cnt; }
            if (bstart > cursor) {
                if (plan_n >= cap) {
                    free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                    ret err[fail.Fail].err{fail.message("comdat plan overflow")};
                }
                p_src[plan_n]     = s;
                p_start[plan_n]   = cursor;
                p_len[plan_n]     = bstart - cursor;
                p_carrier[plan_n] = false;
                plan_n            = plan_n + 1;
                cursor            = bstart;
            }
            if (plan_n >= cap) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret err[fail.Fail].err{fail.message("comdat plan overflow")};
            }
            p_src[plan_n]     = s;
            p_start[plan_n]   = bstart;
            p_len[plan_n]     = bend - bstart;
            p_carrier[plan_n] = true;
            plan_n            = plan_n + 1;
            prev_start        = bstart;
            prev_end          = bend;
            have_prev         = true;
            if (bend > cursor) { cursor = bend; }
        }
        if (cursor < seclen || plan_n == sec_base[s]) {
            if (plan_n >= cap) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret err[fail.Fail].err{fail.message("comdat plan overflow")};
            }
            p_src[plan_n]     = s;
            p_start[plan_n]   = cursor;
            p_len[plan_n]     = seclen - cursor;
            p_carrier[plan_n] = false;
            plan_n            = plan_n + 1;
        }
        sec_cnt[s] = plan_n - sec_base[s];
        s          = s + 1;
    }

    if (plan_n > 0) {
        val rs: res[*target_of.Section, A.Error] = A.zallocate[target_of.Section](alloc, plan_n::usize);
        if (sel rs.err) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat section array alloc failed")};
        }
        out.sections      = rs.ok;
        out.section_count = plan_n;
        out.section_cap   = plan_n;

        val rc: res[*bool, A.Error] = A.zallocate[bool](alloc, plan_n::usize);
        if (sel rc.err) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat flag array alloc failed")};
        }
        @out_comdat = rc.ok;
    }
    out.section_count = plan_n;
    val comdat: *bool = @out_comdat;

    if (img.symbol_count > 0) {
        val ry: res[*target_of.Symbol, A.Error] = A.zallocate[target_of.Symbol](alloc, img.symbol_count::usize);
        if (sel ry.err) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat symbol array alloc failed")};
        }
        out.symbols    = ry.ok;
        out.symbol_cap = img.symbol_count;
    }
    if (img.reloc_count > 0) {
        val rr: res[*target_of.Relocation, A.Error] = A.zallocate[target_of.Relocation](alloc, img.reloc_count::usize);
        if (sel rr.err) {
            free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
            ret err[fail.Fail].err{fail.message("comdat reloc array alloc failed")};
        }
        out.relocations = rr.ok;
        out.reloc_cap   = img.reloc_count;
    }

    var oi: u32 = 0;
    for (oi < plan_n) {
        val src: u32 = p_src[oi];
        out.sections[oi]      = img.sections[src];
        out.sections[oi].kind = img.sections[src].kind;
        out.sections[oi].len  = p_len[oi];
        if (p_carrier[oi]) {
            out.sections[oi].align = carrier_align(p_start[oi], img.sections[src].align);
        }
        or (oi == sec_base[src]) {
            out.sections[oi].align = img.sections[src].align;
        }
        or {
            out.sections[oi].align = 1;
        }
        if (section_has_data(img.sections[src].kind) && img.sections[src].bytes != nil
            && p_len[oi] > 0) {
            out.sections[oi].bytes = (img.sections[src].bytes::usize + p_start[oi]::usize)::*u8;
        }
        or {
            out.sections[oi].bytes = nil;
        }
        if (out.sections[oi].native.link_section != 0) {
            out.sections[oi].native.link_section = sec_base[out.sections[oi].native.link_section - 1] + 1;
        }
        comdat[oi] = p_carrier[oi];
        oi         = oi + 1;
    }

    var i: u32 = 0;
    for (i < img.symbol_count) {
        out.symbols[i] = img.symbols[i];
        val sec: u32 = target_of.section_index(img.symbols[i].section);
        if (sec != target_of.SECTION_EXTERNAL && sec < orig_secs) {
            val off: u32 = img.symbols[i].offset;
            var sub: u32 = subsection_for(sec_base, sec_cnt, p_start, sec, off);
            if (p_carrier[sub] && p_len[sub] == 0
                && (img.symbols[i].flags & target_of.SYM_OBJ_FLAG_WEAK) == 0) {
                for (sub > sec_base[sec] && p_len[sub] == 0) { sub = sub - 1; }
            }
            if (p_carrier[sub]
                && (img.symbols[i].flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0
                && (img.symbols[i].flags & target_of.SYM_OBJ_FLAG_WEAK) == 0) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret err[fail.Fail].err{fail.message("non-weak global shares a weak COMDAT carrier")};
            }
            out.symbols[i].section = target_of.section_id(sub);
            out.symbols[i].offset  = off - p_start[sub];
        }
        i = i + 1;
    }

    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        out.relocations[ri] = img.relocations[ri];
        val rsec: u32 = target_of.section_index(img.relocations[ri].section);
        if (rsec < orig_secs) {
            val ro:      u32                   = img.relocations[ri].offset;
            val sub:     u32                   = subsection_for(sec_base, sec_cnt, p_start, rsec, ro);
            val sub_end: u32                   = p_start[sub] + p_len[sub];
            val wr:      res[usize, fail.Fail] = reloc_field_width(img.interner, alloc, img.relocations[ri].kind, img.relocations[ri].origin);
            if (sel wr.err) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret err[fail.Fail].err{wr.err};
            }
            val w: usize = wr.ok;
            if (sub_end < img.sections[rsec].len && ro::usize + w > sub_end::usize) {
                free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
                ret err[fail.Fail].err{fail.message("relocation field straddles a weak-split boundary")};
            }
            out.relocations[ri].section = target_of.section_id(sub);
            out.relocations[ri].offset  = ro - p_start[sub];
        }
        ri = ri + 1;
    }

    free_build_scratch(alloc, regions, weak_n, p_src, p_carrier, cap, sec_base, orig_secs);
    ret err[fail.Fail].ok{};
}

fun free_weak_comdat_image(alloc: *A.Allocator, out: *target_of.ObjectImage, comdat: *bool) {
    if (out.sections != nil) {
        A.deallocate[target_of.Section](alloc, out.sections, out.section_cap::usize);
    }
    if (out.symbols != nil) {
        A.deallocate[target_of.Symbol](alloc, out.symbols, out.symbol_cap::usize);
    }
    if (out.relocations != nil) {
        A.deallocate[target_of.Relocation](alloc, out.relocations, out.reloc_cap::usize);
    }
    if (comdat != nil) {
        A.deallocate[bool](alloc, comdat, out.section_count::usize);
    }
}

val MACH_FRAMES_SECTION_NAME: str = ".mach.frames";
val MACH_FRAMES_VERSION:      u32 = 1;

fun frames_record_symbol(img: *target_of.ObjectImage, fr: *target_of.FrameUnwind) u32 {
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[i];
        if ((sym.flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0
            && target_of.section_same(sym.section, fr.section) && sym.offset == fr.offset) {
            ret i;
        }
        i = i + 1;
    }
    ret target_of.SYMBOL_NONE;
}

fun encode_frames_section(alloc: *A.Allocator, img: *target_of.ObjectImage,
    out_bytes: **u8, out_len: *u32) err[fail.Fail] {
    @out_bytes = nil;
    @out_len   = 0;
    if (img.frame_count == 0) { ret err[fail.Fail].ok{}; }

    var total: usize = 8;
    var i:     u32   = 0;
    for (i < img.frame_count) {
        val fr: *target_of.FrameUnwind = ?img.frames[i];
        if (fr.step_count > target_of.FRAME_STEP_CAP) {
            ret err[fail.Fail].err{fail.message("frame record step count exceeds capacity")};
        }
        val si: u32 = frames_record_symbol(img, fr);
        if (si == target_of.SYMBOL_NONE) {
            ret err[fail.Fail].err{fail.message("frame record has no defined function symbol")};
        }
        val nm: str = bin.resolve_name(img.interner, img.symbols[si].name);
        if (nm == nil) {
            ret err[fail.Fail].err{fail.message("frame record symbol name did not resolve")};
        }
        total = total + 8 + of_plan.align_bounded(str_len(nm), 4) + fr.step_count::usize * 16;
        i     = i + 1;
    }

    val rb: res[*u8, A.Error] = A.zallocate[u8](alloc, total);
    if (sel rb.err) { ret err[fail.Fail].err{fail.message("frame section alloc failed")}; }
    val buf: *u8 = rb.ok;
    bin.write_u32_le(buf, 0, MACH_FRAMES_VERSION);
    bin.write_u32_le(buf, 4, img.frame_count);
    var pos: usize = 8;
    i = 0;
    for (i < img.frame_count) {
        val fr:   *target_of.FrameUnwind = ?img.frames[i];
        val si:   u32                    = frames_record_symbol(img, fr);
        val nm:   str                    = bin.resolve_name(img.interner, img.symbols[si].name);
        val nlen: usize                  = str_len(nm);
        bin.write_u32_le(buf, pos, nlen::u32);
        bin.write_u32_le(buf, pos + 4, fr.step_count);
        pos = pos + 8;
        memory.raw_copy((buf::usize + pos)::ptr, nm::ptr, nlen);
        pos = pos + of_plan.align_bounded(nlen, 4);
        var k: u32 = 0;
        for (k < fr.step_count) {
            buf[pos]     = fr.steps[k].kind;
            buf[pos + 1] = fr.steps[k].reg;
            bin.write_u16_le(buf, pos + 2, 0);
            bin.write_u32_le(buf, pos + 4, fr.steps[k].end_off);
            bin.write_u64_le(buf, pos + 8, fr.steps[k].value);
            pos = pos + 16;
            k   = k + 1;
        }
        i = i + 1;
    }

    @out_bytes = buf;
    @out_len   = total::u32;
    ret err[fail.Fail].ok{};
}

fun object_emit(tgt_isa: *target_of.ObjectTarget, img: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    if (row_for(tgt_isa.arch_id) == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_UNSUPPORTED, "only x86-64 COFF objects are supported")};
    }
    val alloc: *A.Allocator = img.alloc;

    val source_valid: err[fail.Fail] = target_of.validate_native_sections(img, target_of.COFF);
    if (sel source_valid.err) { ret source_valid; }
    # the record stays the caller's; the expanded image does not carry it
    val cache_record:     *u8  = img.cache_record;
    val cache_record_len: u32  = img.cache_record_len;
    val codegen:          bool = img.codegen;
    val source_sections:  u32  = img.section_count;

    var expanded:      coff_imports.Expanded;
    val imports_ready: err[fail.Fail] = coff_imports.expand(img, ?expanded);
    if (sel imports_ready.err) { ret imports_ready; }
    fin { coff_imports.dnit(?expanded); }
    img = ?expanded.image;

    var derived: target_of.ObjectImage;
    var comdat:  *bool          = nil;
    val br:      err[fail.Fail] = build_weak_comdat_image(alloc, img, ?derived, ?comdat);
    if (sel br.err) {
        free_weak_comdat_image(alloc, ?derived, comdat);
        ret br;
    }

    # a codegen image's carrier describes the sections the parse gives back
    # ahead of the import tables it folds away, as they stand before any info
    # section lands: their flags, which coff cannot spell, the symbol sizes and
    # types, and where each instruction ends
    var lk_bytes: *u8 = nil;
    var lk_len:   u32 = 0;
    if (codegen) {
        val described: u32            = derived.section_count - (img.section_count - source_sections);
        val le:        err[fail.Fail] = carrier.encode(alloc, ?derived, described, nil::*carrier.Host,
            carrier.TABLE_SECTIONS | carrier.TABLE_SYMBOLS | carrier.TABLE_RELOCS, ?lk_bytes, ?lk_len);
        if (sel le.err) {
            free_weak_comdat_image(alloc, ?derived, comdat);
            ret le;
        }
    }
    fin {
        if (lk_bytes != nil) { A.deallocate[u8](alloc, lk_bytes, lk_len::usize); }
    }

    var fr_bytes: *u8            = nil;
    var fr_len:   u32            = 0;
    var comdat2:  *bool          = comdat;
    val fe:       err[fail.Fail] = encode_frames_section(alloc, img, ?fr_bytes, ?fr_len);
    if (sel fe.err) {
        free_weak_comdat_image(alloc, ?derived, comdat);
        ret fe;
    }
    if (fr_len > 0) {
        val fa: err[fail.Fail] = append_info_section(alloc, ?derived, ?comdat2, MACH_FRAMES_SECTION_NAME,
            fr_bytes, fr_len, target_of.SK_DEBUG, 0, 4);
        if (sel fa.err) {
            A.deallocate[u8](alloc, fr_bytes, fr_len::usize);
            free_weak_comdat_image(alloc, ?derived, comdat2);
            ret fa;
        }
    }

    var dr_bytes: *u8            = nil;
    var dr_len:   u32            = 0;
    val de:       err[fail.Fail] = encode_directives_section(alloc, img, ?dr_bytes, ?dr_len);
    if (sel de.err) {
        if (fr_bytes != nil) { A.deallocate[u8](alloc, fr_bytes, fr_len::usize); }
        free_weak_comdat_image(alloc, ?derived, comdat2);
        ret de;
    }
    if (dr_bytes != nil) {
        val da: err[fail.Fail] = append_info_section(alloc, ?derived, ?comdat2, DIRECTIVES_SECTION_NAME,
            dr_bytes, dr_len, target_of.SK_DEBUG, IMAGE_SCN_LNK_INFO | IMAGE_SCN_LNK_REMOVE, 1);
        if (sel da.err) {
            A.deallocate[u8](alloc, dr_bytes, dr_len::usize);
            if (fr_bytes != nil) { A.deallocate[u8](alloc, fr_bytes, fr_len::usize); }
            free_weak_comdat_image(alloc, ?derived, comdat2);
            ret da;
        }
    }

    # the object cache's record is linker information the link removes, a
    # sibling of `.mach.frames`
    if (cache_record_len > 0) {
        val ra: err[fail.Fail] = append_info_section(alloc, ?derived, ?comdat2, record.SECTION_NAME,
            cache_record, cache_record_len, target_of.SK_DEBUG, IMAGE_SCN_LNK_INFO | IMAGE_SCN_LNK_REMOVE, 1);
        if (sel ra.err) {
            if (dr_bytes != nil) { A.deallocate[u8](alloc, dr_bytes, dr_len::usize); }
            if (fr_bytes != nil) { A.deallocate[u8](alloc, fr_bytes, fr_len::usize); }
            free_weak_comdat_image(alloc, ?derived, comdat2);
            ret ra;
        }
    }

    if (lk_bytes != nil) {
        val la: err[fail.Fail] = append_info_section(alloc, ?derived, ?comdat2, carrier.SECTION_NAME,
            lk_bytes, lk_len, target_of.SK_DEBUG, IMAGE_SCN_LNK_INFO | IMAGE_SCN_LNK_REMOVE, 1);
        if (sel la.err) {
            if (dr_bytes != nil) { A.deallocate[u8](alloc, dr_bytes, dr_len::usize); }
            if (fr_bytes != nil) { A.deallocate[u8](alloc, fr_bytes, fr_len::usize); }
            free_weak_comdat_image(alloc, ?derived, comdat2);
            ret la;
        }
    }

    val sr: err[fail.Fail] = serialize_image(?derived, comdat2, dst);
    if (fr_bytes != nil) { A.deallocate[u8](alloc, fr_bytes, fr_len::usize); }
    if (dr_bytes != nil) { A.deallocate[u8](alloc, dr_bytes, dr_len::usize); }
    free_weak_comdat_image(alloc, ?derived, comdat2);
    ret sr;
}

# appends a linker-information section carrying `bytes` to the derived image,
# or fills the zero-length husk an earlier parse left under the same name. the
# comdat side table grows with the sections. `native_flags` of zero takes the
# characteristics the section kind implies, anything else is written verbatim
fun append_info_section(alloc: *A.Allocator, derived: *target_of.ObjectImage, comdat: **bool, name: str,
    bytes: *u8, len: u32, kind: target_of.SectionKind, native_flags: u32, align: u32) err[fail.Fail] {
    val nr: res[intern.StrId, A.Error] = intern.add(derived.interner, name);
    if (sel nr.err) { ret err[fail.Fail].err{fail.refused(nr.err)}; }
    val name_id: intern.StrId = nr.ok;
    val n0:      u32          = derived.section_count;
    var slot:    u32          = n0;
    var fi:      u32          = 0;
    for (fi < n0) {
        if (intern.str_same(derived.sections[fi].name, name_id) && derived.sections[fi].len == 0) {
            slot = fi;
            brk;
        }
        fi = fi + 1;
    }
    if (slot == n0) {
        val gs: err[A.Error] = growth.reserve[target_of.Section](alloc, ?derived.sections, ?derived.section_cap, n0::usize + 1);
        if (sel gs.err) { ret err[fail.Fail].err{fail.message("info section append failed")}; }
        derived.sections[n0] = target_of.Section{};
        # sections are freed at cap and the comdat table at count, so a
        # failure here leaves both sized for the free
        if (@comdat != nil) {
            var comdat_cap: u32          = n0;
            val gc:         err[A.Error] = growth.resize[bool](alloc, comdat, ?comdat_cap, n0::usize + 1);
            if (sel gc.err) { ret err[fail.Fail].err{fail.message("info section comdat append failed")}; }
            (@comdat)[n0] = false;
        }
        derived.section_count = n0 + 1;
    }
    val sec: *target_of.Section = ?derived.sections[slot];
    sec.name   = name_id;
    sec.kind   = kind;
    sec.bytes  = bytes;
    sec.len    = len;
    sec.align  = align;
    sec.flags  = 0;
    sec.native = target_of.NativeSection{};
    if (native_flags != 0) {
        sec.native.format = target_of.COFF;
        sec.native.flags  = native_flags::u64;
    }
    ret err[fail.Fail].ok{};
}

# `.drectve`: the linker directives of the object. mach writes one `/EXPORT:`
# per visible global definition and one per export request, which makes
# absence from the list the coff spelling of `SYM_OBJ_FLAG_HIDDEN`, exactly as
# link.exe reads the same object. the section is written whenever the object
# has a global definition or a request, so an object that exports nothing
# says so rather than reading like a foreign object with no directives
val DIRECTIVES_SECTION_NAME: str = ".drectve";
val EXPORT_DIRECTIVE:        str = " /EXPORT:";

fun write_ascii(buf: *u8, off: usize, s: str) usize {
    val len: usize = str_len(s);
    memory.raw_copy((buf::usize + off)::ptr, s::ptr, len);
    ret len;
}

fun directive_names_symbol(sym: *target_of.Symbol) bool {
    ret (sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && !target_of.section_is_external(sym.section);
}

fun encode_directives_section(alloc: *A.Allocator, img: *target_of.ObjectImage,
    out_bytes: **u8, out_len: *u32) err[fail.Fail] {
    @out_bytes = nil;
    @out_len   = 0;
    var total: usize = 0;
    var any:   bool  = img.export_request_count > 0;
    var i:     u32   = 0;
    for (i < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[i];
        if (directive_names_symbol(sym)) {
            any = true;
            if ((sym.flags & target_of.SYM_OBJ_FLAG_HIDDEN) == 0) {
                val nm: str = bin.resolve_name(img.interner, sym.name);
                if (nm == nil) { ret err[fail.Fail].err{fail.message("exported symbol name did not resolve")}; }
                total = total + str_len(EXPORT_DIRECTIVE) + str_len(nm);
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.export_request_count) {
        val nm: str = bin.resolve_name(img.interner, img.export_requests[i]);
        if (nm == nil) { ret err[fail.Fail].err{fail.message("export request name did not resolve")}; }
        total = total + str_len(EXPORT_DIRECTIVE) + str_len(nm);
        i     = i + 1;
    }
    if (!any)               { ret err[fail.Fail].ok{}; }
    if (total > 0xFFFFFFFF) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "directive section exceeds the section size field")}; }

    # an empty directive list still needs a byte to own, so the section has
    # data the parser can find
    var cap: usize = total;
    if (cap == 0) { cap = 1; }
    val rb: res[*u8, A.Error] = A.zallocate[u8](alloc, cap);
    if (sel rb.err) { ret err[fail.Fail].err{fail.message("directive section alloc failed")}; }
    val buf: *u8   = rb.ok;
    var pos: usize = 0;
    i = 0;
    for (i < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[i];
        if (directive_names_symbol(sym) && (sym.flags & target_of.SYM_OBJ_FLAG_HIDDEN) == 0) {
            pos = pos + write_ascii(buf, pos, EXPORT_DIRECTIVE);
            pos = pos + write_ascii(buf, pos, bin.resolve_name(img.interner, sym.name));
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.export_request_count) {
        pos = pos + write_ascii(buf, pos, EXPORT_DIRECTIVE);
        pos = pos + write_ascii(buf, pos, bin.resolve_name(img.interner, img.export_requests[i]));
        i   = i + 1;
    }
    if (pos != total) {
        A.deallocate[u8](alloc, buf, cap);
        ret err[fail.Fail].err{fail.message("directive section drifted from its plan")};
    }
    if (total == 0) { buf[0] = ' '; }
    @out_bytes = buf;
    @out_len   = cap::u32;
    ret err[fail.Fail].ok{};
}

# a section past the u16 header count sets IMAGE_SCN_LNK_NRELOC_OVFL, writes 0xFFFF as
# NumberOfRelocations and leads its table with an entry whose VirtualAddress is the
# entry count including itself
fun reloc_count_overflows(count: u32) bool {
    ret count > 0xFFFF;
}

# a section's relocation entries: `first` is the file offset of the first real entry
rec RelocTable {
    first: usize;
    count: u32;
}

# reads the section header at `sh`, taking the extended count of an overflowed section
fun section_reloc_table(buf: *u8, buf_size: usize, sh: usize) res[RelocTable, fail.Fail] {
    val rptr:  usize = bin.read_u32_le(buf, sh + 24)::usize;
    val count: u32   = bin.read_u16_le(buf, sh + 32)::u32;
    if ((bin.read_u32_le(buf, sh + 36) & IMAGE_SCN_LNK_NRELOC_OVFL) == 0 || count != 0xFFFF) {
        ret res[RelocTable, fail.Fail].ok{RelocTable{first: rptr, count: count}};
    }
    if (!bin.region_ok(buf_size, rptr, RELOCATION_SIZE)) {
        ret res[RelocTable, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "relocation array out of bounds")};
    }
    val total: u32 = bin.read_u32_le(buf, rptr);
    if (total == 0) {
        ret res[RelocTable, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "extended relocation count is zero")};
    }
    ret res[RelocTable, fail.Fail].ok{RelocTable{first: rptr + RELOCATION_SIZE, count: total - 1}};
}

fun write_bigobj_class_id(buf: *u8, off: usize) {
    var i: usize = 0;
    for (i < 16) {
        buf[off + i] = BIGOBJ_CLASS_ID[i];
        i            = i + 1;
    }
}

fun bigobj_class_id_matches(buf: *u8, off: usize) bool {
    var i: usize = 0;
    for (i < 16) {
        if (buf[off + i] != BIGOBJ_CLASS_ID[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun sym_record_size(bigobj: bool) usize {
    if (bigobj) { ret BIGOBJ_SYMBOL_SIZE; }
    ret SYMBOL_SIZE;
}

fun common_alignment(size: u32) u32 {
    var alignment: u32 = 1;
    for (alignment < size && alignment < 32) { alignment = alignment * 2; }
    ret alignment;
}

fun write_sym_tail(buf: *u8, sym_off: usize, bigobj: bool, sec_num: i32, ty: u16, scl: u8, naux: u8) {
    if (bigobj) {
        bin.write_u32_le(buf, sym_off + 12, sec_num::u32);
        bin.write_u16_le(buf, sym_off + 16, ty);
        buf[sym_off + 18] = scl;
        buf[sym_off + 19] = naux;
        ret;
    }
    bin.write_u16_le(buf, sym_off + 12, sec_num::u16);
    bin.write_u16_le(buf, sym_off + 14, ty);
    buf[sym_off + 16] = scl;
    buf[sym_off + 17] = naux;
}

fun read_sym_section_number(buf: *u8, sym_off: usize, bigobj: bool) i32 {
    if (bigobj) { ret bin.read_u32_le(buf, sym_off + 12)::i32; }
    ret bin.read_u16_le(buf, sym_off + 12)::i16::i32;
}

fun read_sym_type(buf: *u8, sym_off: usize, bigobj: bool) u16 {
    if (bigobj) { ret bin.read_u16_le(buf, sym_off + 16); }
    ret bin.read_u16_le(buf, sym_off + 14);
}

fun sym_storage_class_off(sym_off: usize, bigobj: bool) usize {
    if (bigobj) { ret sym_off + 18; }
    ret sym_off + 16;
}

fun sym_naux_off(sym_off: usize, bigobj: bool) usize {
    if (bigobj) { ret sym_off + 19; }
    ret sym_off + 17;
}

fun preserve_weak_external_fallbacks(buf: *u8, symtab_off: usize,
    num_records: u32, bigobj: bool,
    rec_map: *i32,
    out: *target_of.ObjectImage) err[fail.Fail] {
    val symbol_size: usize = sym_record_size(bigobj);
    var ri:          u32   = 0;
    for (ri < num_records) {
        val so:  usize = symtab_off + ri::usize * symbol_size;
        val aux: u8    = buf[sym_naux_off(so, bigobj)];
        val scl: u8    = buf[sym_storage_class_off(so, bigobj)];
        if (scl == IMAGE_SYM_CLASS_WEAK_EXTERNAL
            && read_sym_section_number(buf, so, bigobj) == IMAGE_SYM_UNDEFINED::i32) {
            if (aux == 0 || ri + 1 >= num_records) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "weak external has no aux record")};
            }
            val ao:         usize = so + symbol_size;
            val target_rec: u32   = bin.read_u32_le(buf, ao);
            val search:     u32   = bin.read_u32_le(buf, ao + 4);
            if (target_rec >= num_records || rec_map[ri] < 0
                || rec_map[target_rec] < 0) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "weak external fallback target is invalid")};
            }
            val public: *target_of.Symbol = ?out.symbols[rec_map[ri]::u32];
            val target: *target_of.Symbol = ?out.symbols[rec_map[target_rec]::u32];
            public.fallback = rec_map[target_rec]::u32;
            public.flags    = public.flags | target_of.SYM_OBJ_FLAG_FALLBACK
                | (target.flags & (target_of.SYM_OBJ_FLAG_FUNCTION | target_of.SYM_OBJ_FLAG_OBJECT));
            if (search == IMAGE_WEAK_EXTERN_SEARCH_LIBRARY) {
                public.flags = public.flags | target_of.SYM_OBJ_FLAG_SEARCH;
            }
            if (search == IMAGE_WEAK_EXTERN_SEARCH_ALIAS) {
                public.flags = public.flags | target_of.SYM_OBJ_FLAG_ALIAS;
            }
        }
        ri = ri + 1 + aux::u32;
    }
    ret err[fail.Fail].ok{};
}

rec ObjectScratch {
    counts:           *u32;
    sec_rows:         *u32;
    reloc_rows:       *u32;
    reloc_cursors:    *usize;
    sec_name_offsets: *u32;
    sym_remap:        *u32;
    num_secs:         u32;
    num_syms:         u32;
}

fun object_scratch_free(alloc: *A.Allocator, s: *ObjectScratch) {
    if (s.counts != nil)           { A.deallocate[u32](alloc, s.counts, s.num_secs::usize); }
    if (s.sec_rows != nil)         { A.deallocate[u32](alloc, s.sec_rows, (s.num_secs + 1)::usize); }
    if (s.reloc_rows != nil)       { A.deallocate[u32](alloc, s.reloc_rows, (s.num_secs + 1)::usize); }
    if (s.reloc_cursors != nil)    { A.deallocate[usize](alloc, s.reloc_cursors, (s.num_secs + 1)::usize); }
    if (s.sec_name_offsets != nil) { A.deallocate[u32](alloc, s.sec_name_offsets, (s.num_secs + 1)::usize); }
    if (s.sym_remap != nil)        { A.deallocate[u32](alloc, s.sym_remap, s.num_syms::usize); }
    s.counts           = nil;
    s.sec_rows         = nil;
    s.reloc_rows       = nil;
    s.reloc_cursors    = nil;
    s.sec_name_offsets = nil;
    s.sym_remap        = nil;
}

fun object_scratch_table(alloc: *A.Allocator, count: u32, what: str) res[*u32, fail.Fail] {
    val made: res[*u32, A.Error] = A.zallocate[u32](alloc, (count + 1)::usize);
    if (sel made.err) { ret res[*u32, fail.Fail].err{fail.message(what)}; }
    if (sel made.err) { ret res[*u32, fail.Fail].err{fail.refused(made.err)}; }
    ret res[*u32, fail.Fail].ok{made.ok};
}

# the "/1234567" long-name form carries at most seven decimal digits
val STRTAB_DECIMAL_NAME_LIMIT: usize = 9999999;

fun serialize_image(img: *target_of.ObjectImage, comdat: *bool, dst: *of_destination.Destination) err[fail.Fail] {
    val native_valid: err[fail.Fail] = target_of.validate_native_sections(img, target_of.COFF);
    if (sel native_valid.err) { ret native_valid; }
    var common_i: u32 = 0;
    for (common_i < img.symbol_count) {
        val symbol: *target_of.Symbol = ?img.symbols[common_i];
        if (target_of.section_is_absolute(symbol.section) && symbol.absolute_value > 0xFFFFFFFF) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "absolute definition exceeds native value width")};
        }
        if ((symbol.flags & target_of.SYM_OBJ_FLAG_COMMON) != 0
            && (symbol.size == 0 || (symbol.align != 0 && symbol.align != common_alignment(symbol.size)))) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "common size or explicit alignment is not natively representable")};
        }
        common_i = common_i + 1;
    }
    val alloc: *A.Allocator = img.alloc;

    val num_secs: u32 = img.section_count;
    val num_syms: u32 = img.symbol_count;

    var weak_aux_count: u32 = 0;
    var wi:             u32 = 0;
    for (wi < num_syms) {
        if ((img.symbols[wi].flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            if (img.symbols[wi].fallback >= num_syms
                || img.symbols[wi].fallback == target_of.SYMBOL_NONE) {
                ret err[fail.Fail].err{fail.message("weak external fallback index is out of range")};
            }
            weak_aux_count = weak_aux_count + 1;
        }
        wi = wi + 1;
    }

    val vrk: err[fail.Fail] = validate_reloc_kinds(img);
    if (sel vrk.err) { ret vrk; }

    val vr: err[fail.Fail] = validate_reloc_ranges(img);
    if (sel vr.err) { ret vr; }

    val vrs: err[fail.Fail] = bin.validate_reloc_symbols(img, UNRESOLVED, UNRESOLVED_UNNAMED);
    if (sel vrs.err) { ret vrs; }

    if (num_secs > 0x7FFFFFFF) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "section count exceeds the /bigobj 2^31 limit")}; }
    val bigobj: bool = num_secs > 0xFFFF;

    var scratch: ObjectScratch;
    scratch.counts           = nil;
    scratch.sec_rows         = nil;
    scratch.reloc_rows       = nil;
    scratch.reloc_cursors    = nil;
    scratch.sec_name_offsets = nil;
    scratch.sym_remap        = nil;
    scratch.num_secs         = num_secs;
    scratch.num_syms         = num_syms;
    fin { object_scratch_free(alloc, ?scratch); }

    val res_counts: res[*u32, fail.Fail] = bin.reloc_counts(alloc, img);
    if (sel res_counts.err) { ret err[fail.Fail].err{res_counts.err}; }
    scratch.counts = res_counts.ok;
    val counts: *u32 = scratch.counts;

    var header_size: usize = HEADER_SIZE;
    var symbol_size: usize = SYMBOL_SIZE;
    if (bigobj) {
        header_size = BIGOBJ_HEADER_SIZE;
        symbol_size = BIGOBJ_SYMBOL_SIZE;
    }

    val res_srows: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "data offset table alloc failed");
    if (sel res_srows.err) { ret err[fail.Fail].err{res_srows.err}; }
    scratch.sec_rows = res_srows.ok;
    val sec_rows: *u32 = scratch.sec_rows;

    val res_rrows: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "reloc offset table alloc failed");
    if (sel res_rrows.err) { ret err[fail.Fail].err{res_rrows.err}; }
    scratch.reloc_rows = res_rrows.ok;
    val reloc_rows: *u32 = scratch.reloc_rows;

    val res_rcur: res[*usize, A.Error] = A.zallocate[usize](alloc, (num_secs + 1)::usize);
    if (sel res_rcur.err) { ret err[fail.Fail].err{fail.message("reloc cursor table alloc failed")}; }
    scratch.reloc_cursors = res_rcur.ok;
    val reloc_cursors: *usize = scratch.reloc_cursors;

    val res_snoff: res[*u32, fail.Fail] = object_scratch_table(alloc, num_secs, "section name offset table alloc failed");
    if (sel res_snoff.err) { ret err[fail.Fail].err{res_snoff.err}; }
    scratch.sec_name_offsets = res_snoff.ok;
    val sec_name_offsets: *u32 = scratch.sec_name_offsets;

    val planned: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, img.interner, "coff", of_plan.LIMIT_32);
    if (sel planned.err) { ret err[fail.Fail].err{planned.err}; }
    var fp: of_plan.FilePlan = planned.ok;
    fin { of_plan.dnit(?fp); }

    val header_r: res[u32, fail.Fail] = of_plan.place_at(?fp, "coff header", target_of.no_section(), 0, header_size);
    if (sel header_r.err) { ret err[fail.Fail].err{header_r.err}; }
    val sht_size: res[usize, fail.Fail] = of_plan.table(?fp, "section headers", num_secs::usize, SECTION_HEADER_SIZE);
    if (sel sht_size.err) { ret err[fail.Fail].err{sht_size.err}; }
    val sht_r: res[u32, fail.Fail] = of_plan.place(?fp, "section headers", target_of.no_section(), 1, sht_size.ok);
    if (sel sht_r.err) { ret err[fail.Fail].err{sht_r.err}; }
    val sht_row: u32 = sht_r.ok;

    var s: u32 = 0;
    for (s < num_secs) {
        sec_rows[s] = of_plan.NO_ROW;
        if (section_has_data(img.sections[s].kind) && img.sections[s].len > 0) {
            val row: res[u32, fail.Fail] = of_plan.place(?fp, "section data", target_of.section_id(s), 1, img.sections[s].len::usize);
            if (sel row.err) { ret err[fail.Fail].err{row.err}; }
            sec_rows[s] = row.ok;
        }
        s = s + 1;
    }
    s = 0;
    for (s < num_secs) {
        reloc_rows[s] = of_plan.NO_ROW;
        if (counts[s] > 0) {
            var entries: usize = counts[s]::usize;
            if (reloc_count_overflows(counts[s])) { entries = entries + 1; }
            val rsize: res[usize, fail.Fail] = of_plan.table(?fp, "relocations", entries, RELOCATION_SIZE);
            if (sel rsize.err) { ret err[fail.Fail].err{rsize.err}; }
            val row: res[u32, fail.Fail] = of_plan.place(?fp, "relocations", target_of.section_id(s), 1, rsize.ok);
            if (sel row.err) { ret err[fail.Fail].err{row.err}; }
            reloc_rows[s] = row.ok;
        }
        s = s + 1;
    }

    val sec_records: res[u32, fail.Fail] = of_plan.count_u32(?fp, "symbol records", num_secs, num_secs);
    if (sel sec_records.err) { ret err[fail.Fail].err{sec_records.err}; }
    val with_syms: res[u32, fail.Fail] = of_plan.count_u32(?fp, "symbol records", sec_records.ok, num_syms);
    if (sel with_syms.err) { ret err[fail.Fail].err{with_syms.err}; }
    val all_records: res[u32, fail.Fail] = of_plan.count_u32(?fp, "symbol records", with_syms.ok, weak_aux_count);
    if (sel all_records.err) { ret err[fail.Fail].err{all_records.err}; }
    val total_sym_records: u32                   = all_records.ok;
    val symtab_bytes:      res[usize, fail.Fail] = of_plan.table(?fp, "symbol table", total_sym_records::usize, symbol_size);
    if (sel symtab_bytes.err) { ret err[fail.Fail].err{symtab_bytes.err}; }
    val symtab_r: res[u32, fail.Fail] = of_plan.place(?fp, "symbol table", target_of.no_section(), 1, symtab_bytes.ok);
    if (sel symtab_r.err) { ret err[fail.Fail].err{symtab_r.err}; }
    val symtab_row: u32                 = symtab_r.ok;
    val strtab_r:   res[u32, fail.Fail] = of_plan.place(?fp, "string table", target_of.no_section(), 1, strtab_size(img));
    if (sel strtab_r.err) { ret err[fail.Fail].err{strtab_r.err}; }
    val strtab_row: u32 = strtab_r.ok;

    val sealed: res[usize, fail.Fail] = of_plan.seal(?fp);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }
    val total_file_size: usize               = sealed.ok;
    val symtab_offset:   usize               = of_plan.offset(?fp, symtab_row);
    val strtab_offset:   usize               = of_plan.offset(?fp, strtab_row);
    val symtab_field:    res[u32, fail.Fail] = of_plan.field_u32(?fp, symtab_offset, "PointerToSymbolTable");
    if (sel symtab_field.err) { ret err[fail.Fail].err{symtab_field.err}; }
    val strtab_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, of_plan.size(?fp, strtab_row), "string table size");
    if (sel strtab_field.err) { ret err[fail.Fail].err{strtab_field.err}; }

    if (num_syms > 0) {
        val res_remap: res[*u32, A.Error] = A.zallocate[u32](alloc, num_syms::usize);
        if (sel res_remap.err) { ret err[fail.Fail].err{fail.message("symbol remap alloc failed")}; }
        scratch.sym_remap = res_remap.ok;
    }
    val sym_remap: *u32 = scratch.sym_remap;
    var i:         u32  = 0;
    var raw_sym:   u32  = sec_records.ok;
    for (i < num_syms) {
        sym_remap[i] = raw_sym;
        raw_sym      = raw_sym + 1;
        if ((img.symbols[i].flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            raw_sym = raw_sym + 1;
        }
        i = i + 1;
    }
    if (raw_sym != total_sym_records) { ret err[fail.Fail].err{fail.message("symbol record count drifted from its plan")}; }

    val res_buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", total_file_size, 0o644);
    if (sel res_buf.err) { ret err[fail.Fail].err{res_buf.err}; }
    var buf: *u8 = res_buf.ok;

    if (bigobj) {
        bin.write_u16_le(buf, 0, IMAGE_FILE_MACHINE_UNKNOWN);
        bin.write_u16_le(buf, 2, BIGOBJ_SIG2);
        bin.write_u16_le(buf, 4, BIGOBJ_MIN_VERSION);
        bin.write_u16_le(buf, 6, IMAGE_FILE_MACHINE_AMD64);
        bin.write_u32_le(buf, 8, 0);
        write_bigobj_class_id(buf, 12);
        val body: res[u32, fail.Fail] = of_plan.field_u32(?fp, total_file_size - header_size, "bigobj body size");
        if (sel body.err) { ret err[fail.Fail].err{body.err}; }
        bin.write_u32_le(buf, 28, body.ok);
        bin.write_u32_le(buf, 32, 0);
        bin.write_u32_le(buf, 36, 0);
        bin.write_u32_le(buf, 40, 0);
        bin.write_u32_le(buf, 44, num_secs);
        bin.write_u32_le(buf, 48, symtab_field.ok);
        bin.write_u32_le(buf, 52, total_sym_records);
    }
    or {
        val nsec: res[u16, fail.Fail] = of_plan.field_u16(?fp, num_secs::usize, "NumberOfSections");
        if (sel nsec.err) { ret err[fail.Fail].err{nsec.err}; }
        bin.write_u16_le(buf, 0, IMAGE_FILE_MACHINE_AMD64);
        bin.write_u16_le(buf, 2, nsec.ok);
        bin.write_u32_le(buf, 4, 0);
        bin.write_u32_le(buf, 8, symtab_field.ok);
        bin.write_u32_le(buf, 12, total_sym_records);
        bin.write_u16_le(buf, 16, 0);
        bin.write_u16_le(buf, 18, 0);
    }

    var str_pos: usize = 4;

    var sh: usize = of_plan.offset(?fp, sht_row);
    s = 0;
    for (s < num_secs) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (name_in_strtab(sn)) {
            if (str_pos > STRTAB_DECIMAL_NAME_LIMIT) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "a section's long-name offset exceeds the seven-digit name field")}; }
            sec_name_offsets[s] = str_pos::u32;
            buf[sh]             = '/';
            write_decimal(buf, sh + 1, 7, str_pos::u32);
            str_pos = str_pos + bin.write_str(buf, strtab_offset + str_pos, sn);
        }
        or {
            sec_name_offsets[s] = 0;
            write_inline_name(buf, sh, sn);
        }

        val seclen: u32 = img.sections[s].len;
        bin.write_u32_le(buf, sh + 8, 0);
        bin.write_u32_le(buf, sh + 12, 0);
        bin.write_u32_le(buf, sh + 16, seclen);
        if (sec_rows[s] != of_plan.NO_ROW) {
            val data_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, of_plan.offset(?fp, sec_rows[s]), "PointerToRawData");
            if (sel data_field.err) { ret err[fail.Fail].err{data_field.err}; }
            bin.write_u32_le(buf, sh + 20, data_field.ok);
        }
        or {
            bin.write_u32_le(buf, sh + 20, 0);
        }
        val rc: u32 = counts[s];
        if (reloc_rows[s] != of_plan.NO_ROW) {
            val reloc_field: res[u32, fail.Fail] = of_plan.field_u32(?fp, of_plan.offset(?fp, reloc_rows[s]), "PointerToRelocations");
            if (sel reloc_field.err) { ret err[fail.Fail].err{reloc_field.err}; }
            bin.write_u32_le(buf, sh + 24, reloc_field.ok);
        }
        or {
            bin.write_u32_le(buf, sh + 24, 0);
        }
        bin.write_u32_le(buf, sh + 28, 0);
        bin.write_u16_le(buf, sh + 34, 0);
        var chars: u32 = section_characteristics_for(img.sections[s].kind)
            | align_characteristic(img.sections[s].align);
        if (img.sections[s].native.format == target_of.COFF) {
            chars = (img.sections[s].native.flags::u32 & ~(0x00F00000 | IMAGE_SCN_LNK_NRELOC_OVFL))
                | align_characteristic(img.sections[s].align);
        }
        if (comdat != nil && comdat[s]) { chars = chars | IMAGE_SCN_LNK_COMDAT; }
        if (reloc_count_overflows(rc)) {
            bin.write_u16_le(buf, sh + 32, 0xFFFF);
            chars = chars | IMAGE_SCN_LNK_NRELOC_OVFL;
        }
        or {
            bin.write_u16_le(buf, sh + 32, rc::u16);
        }
        bin.write_u32_le(buf, sh + 36, chars);
        sh = sh + SECTION_HEADER_SIZE;
        s  = s + 1;
    }
    val sht_closed: err[fail.Fail] = of_plan.close(?fp, sht_row, sh);
    if (sel sht_closed.err) { ret sht_closed; }

    s = 0;
    for (s < num_secs) {
        if (sec_rows[s] != of_plan.NO_ROW && img.sections[s].bytes != nil) {
            memory.raw_copy((buf::usize + of_plan.offset(?fp, sec_rows[s]))::ptr,
                img.sections[s].bytes::ptr, img.sections[s].len::usize);
        }
        s = s + 1;
    }

    var ridx: u32 = 0;
    for (ridx < img.reloc_count) {
        val rsec: u32                 = target_of.section_index(img.relocations[ridx].section);
        val rk:   target_of.RelocKind = img.relocations[ridx].kind;
        var eff:  i64                 = img.relocations[ridx].addend;
        if (rk == target_of.RK_PC32 || rk == target_of.RK_PLT32) { eff = eff + 4; }
        if (eff != 0) {
            if (sec_rows[rsec] == of_plan.NO_ROW) { ret err[fail.Fail].err{fail.message("relocation addend targets a section without data")}; }
            val fld: usize                 = of_plan.offset(?fp, sec_rows[rsec]) + img.relocations[ridx].offset::usize;
            val wr:  res[usize, fail.Fail] = reloc_field_width(img.interner, img.alloc, rk, img.relocations[ridx].origin);
            if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
            val w: usize = wr.ok;
            if (!target_of.addend_fits_field(eff, w, rk == target_of.RK_PC32 || rk == target_of.RK_PLT32)) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "relocation addend does not fit the field it is stored in")};
            }
            if (w == 8) {
                bin.write_u64_le(buf, fld, bin.read_u64_le(buf, fld) + eff::u64);
            }
            or (w == 2) {
                bin.write_u16_le(buf, fld, (bin.read_u16_le(buf, fld)::u64 + eff::u64)::u16);
            }
            or {
                bin.write_u32_le(buf, fld, bin.read_u32_le(buf, fld) + (eff::u64)::u32);
            }
        }
        ridx = ridx + 1;
    }

    s = 0;
    for (s < num_secs) {
        reloc_cursors[s] = 0;
        if (reloc_rows[s] != of_plan.NO_ROW) { reloc_cursors[s] = of_plan.offset(?fp, reloc_rows[s]); }
        if (reloc_count_overflows(counts[s])) {
            val total: res[u32, fail.Fail] = of_plan.field_u32(?fp, counts[s]::usize + 1, "extended relocation count");
            if (sel total.err) { ret err[fail.Fail].err{total.err}; }
            bin.write_u32_le(buf, reloc_cursors[s], total.ok);
            bin.write_u32_le(buf, reloc_cursors[s] + 4, 0);
            bin.write_u16_le(buf, reloc_cursors[s] + 8, 0);
            reloc_cursors[s] = reloc_cursors[s] + RELOCATION_SIZE;
        }
        s = s + 1;
    }
    var ri: u32 = 0;
    for (ri < img.reloc_count) {
        val rsec: u32   = target_of.section_index(img.relocations[ri].section);
        val ro:   usize = reloc_cursors[rsec];
        bin.write_u32_le(buf, ro, img.relocations[ri].offset);
        val rsi_r: res[u32, fail.Fail] = bin.reloc_sym_index(img, ?img.relocations[ri], UNRESOLVED, UNRESOLVED_UNNAMED);
        if (sel rsi_r.err) { ret err[fail.Fail].err{rsi_r.err}; }
        val rsi: u32 = rsi_r.ok;
        bin.write_u32_le(buf, ro + 4, sym_remap[rsi]);
        val reloc_type: res[u16, fail.Fail] = reloc_type_for(img.interner, alloc, img.relocations[ri].kind, img.relocations[ri].origin);
        if (sel reloc_type.err) { ret err[fail.Fail].err{reloc_type.err}; }
        bin.write_u16_le(buf, ro + 8, reloc_type.ok);
        reloc_cursors[rsec] = ro + RELOCATION_SIZE;
        ri                  = ri + 1;
    }
    s = 0;
    for (s < num_secs) {
        if (reloc_rows[s] != of_plan.NO_ROW) {
            val relocs_closed: err[fail.Fail] = of_plan.close(?fp, reloc_rows[s], reloc_cursors[s]);
            if (sel relocs_closed.err) { ret relocs_closed; }
        }
        s = s + 1;
    }

    var sym_off: usize = symtab_offset;
    s = 0;
    for (s < num_secs) {
        val sn: str = bin.resolve_name(img.interner, img.sections[s].name);
        if (name_in_strtab(sn)) {
            bin.write_u32_le(buf, sym_off, 0);
            bin.write_u32_le(buf, sym_off + 4, sec_name_offsets[s]);
        }
        or {
            write_inline_name(buf, sym_off, sn);
        }
        bin.write_u32_le(buf, sym_off + 8, 0);
        write_sym_tail(buf, sym_off, bigobj, (s + 1)::i32, 0, IMAGE_SYM_CLASS_STATIC, 1);
        sym_off = sym_off + symbol_size;

        bin.write_u32_le(buf, sym_off, img.sections[s].len);
        bin.write_u16_le(buf, sym_off + 4, counts[s]::u16);
        if (img.sections[s].native.format == target_of.COFF && img.sections[s].native.selection != 0) {
            val native: *target_of.NativeSection = ?img.sections[s].native;
            bin.write_u32_le(buf, sym_off + 8, native.checksum);
            bin.write_u16_le(buf, sym_off + 12, native.link_section::u16);
            bin.write_u16_le(buf, sym_off + 16, (native.link_section >> 16)::u16);
            buf[sym_off + 14] = native.selection::u8;
        }
        or (comdat != nil && comdat[s]) {
            buf[sym_off + 14] = IMAGE_COMDAT_SELECT_ANY;
        }
        sym_off = sym_off + symbol_size;
        s       = s + 1;
    }

    var symi: u32 = 0;
    for (symi < num_syms) {
        val name: str = bin.resolve_name(img.interner, img.symbols[symi].name);
        if (name_in_strtab(name)) {
            bin.write_u32_le(buf, sym_off, 0);
            bin.write_u32_le(buf, sym_off + 4, str_pos::u32);
            str_pos = str_pos + bin.write_str(buf, strtab_offset + str_pos, name);
        }
        or {
            write_inline_name(buf, sym_off, name);
        }
        var value: u32 = img.symbols[symi].offset;
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_COMMON) != 0) { value = img.symbols[symi].size; }
        if (target_of.section_is_absolute(img.symbols[symi].section))       { value = img.symbols[symi].absolute_value::u32; }
        bin.write_u32_le(buf, sym_off + 8, value);

        var sec_num: i32 = IMAGE_SYM_UNDEFINED::i32;
        var sym_ty:  u16 = 0;
        if (!target_of.section_is_external(img.symbols[symi].section)
            && target_of.section_index(img.symbols[symi].section) < num_secs) {
            sec_num = (target_of.section_index(img.symbols[symi].section) + 1)::i32;
            val section_kind:  target_of.SectionKind = img.sections[target_of.section_index(img.symbols[symi].section)].kind;
            val declared_type: opt[u16]              = symbol_type_for(section_kind);
            if (sel declared_type.none) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_SECTION_UNSUPPORTED, target_of.section_kind_rejection(img.interner, img.alloc, section_kind))};
            }
            sym_ty = declared_type.some;
        }
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0) {
            sym_ty = IMAGE_SYM_DTYPE_FUNCTION;
        }

        var scl: u8 = IMAGE_SYM_CLASS_STATIC;
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0
            || (img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_EXTERN) != 0) {
            scl = IMAGE_SYM_CLASS_EXTERNAL;
        }
        var naux: u8 = 0;
        if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            scl  = IMAGE_SYM_CLASS_WEAK_EXTERNAL;
            naux = 1;
        }
        if (target_of.section_is_absolute(img.symbols[symi].section)) { sec_num = -1; }
        if (img.symbols[symi].native.format == target_of.COFF) {
            sym_ty = img.symbols[symi].native.kind::u16;
            scl    = img.symbols[symi].native.flags::u8;
        }
        write_sym_tail(buf, sym_off, bigobj, sec_num, sym_ty, scl, naux);
        sym_off = sym_off + symbol_size;
        if (naux == 1) {
            bin.write_u32_le(buf, sym_off, sym_remap[img.symbols[symi].fallback]);
            var search: u32 = IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY;
            if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_SEARCH) != 0) {
                search = IMAGE_WEAK_EXTERN_SEARCH_LIBRARY;
            }
            if ((img.symbols[symi].flags & target_of.SYM_OBJ_FLAG_ALIAS) != 0) {
                search = IMAGE_WEAK_EXTERN_SEARCH_ALIAS;
            }
            bin.write_u32_le(buf, sym_off + 4, search);
            sym_off = sym_off + symbol_size;
        }
        symi = symi + 1;
    }
    val symtab_closed: err[fail.Fail] = of_plan.close(?fp, symtab_row, sym_off);
    if (sel symtab_closed.err) { ret symtab_closed; }
    val strtab_closed: err[fail.Fail] = of_plan.close_size(?fp, strtab_row, str_pos);
    if (sel strtab_closed.err) { ret strtab_closed; }

    bin.write_u32_le(buf, strtab_offset, strtab_field.ok);

    ret err[fail.Fail].ok{};
}

fun framed_name(buf: *u8, off: usize, scratch: *u8) str {
    memory.raw_copy(scratch::ptr, (buf::usize + off)::ptr, 8);
    scratch[8] = 0;
    ret (scratch::usize)::str;
}

fun read_section_name(buf: *u8, buf_size: usize, sh: usize, strtab_base: usize, scratch: *u8) res[str, fail.Fail] {
    if (buf[sh] == '/') {
        var off: u32   = 0;
        var i:   usize = 1;
        for (i < 8) {
            val c: u8 = buf[sh + i];
            if (c >= '0' && c <= '9') { off = off * 10 + (c - '0')::u32; }
            i = i + 1;
        }
        ret bin.cstr_at(buf, buf_size, strtab_base + off::usize);
    }
    ret res[str, fail.Fail].ok{framed_name(buf, sh, scratch)};
}

fun read_symbol_name(buf: *u8, buf_size: usize, so: usize, strtab_base: usize, scratch: *u8) res[str, fail.Fail] {
    if (bin.read_u32_le(buf, so) == 0) {
        val off: u32 = bin.read_u32_le(buf, so + 4);
        ret bin.cstr_at(buf, buf_size, strtab_base + off::usize);
    }
    ret res[str, fail.Fail].ok{framed_name(buf, so, scratch)};
}

fun comdat_dedups_for_section(buf: *u8, symtab_off: usize, num_records: u32, sec_num: u32, bigobj: bool) bool {
    val rsize: usize = sym_record_size(bigobj);
    var ri:    u32   = 0;
    for (ri < num_records) {
        val so:  usize = symtab_off + ri::usize * rsize;
        val aux: u8    = buf[sym_naux_off(so, bigobj)];
        if (buf[sym_storage_class_off(so, bigobj)] == IMAGE_SYM_CLASS_STATIC && aux >= 1 && (ri + 1) < num_records
            && read_sym_section_number(buf, so, bigobj) == sec_num::i32 && bin.read_u32_le(buf, so + 8) == 0) {
            val ax: usize = so + rsize;
            ret comdat_selection_dedups(buf[ax + 14]);
        }
        ri = ri + 1 + aux::u32;
    }
    ret false;
}

fun parse_import_record(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8,
    buf_size: usize, out: *target_of.ObjectImage) err[fail.Fail] {
    if (buf_size < IMPORT_OBJECT_HEADER_SIZE) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record too small")};
    }
    if (itn == nil) { ret err[fail.Fail].err{fail.message("no interner for parse")}; }
    if (bin.read_u16_le(buf, 6) != IMAGE_FILE_MACHINE_AMD64) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_FORMAT_MISMATCH, "not an x86-64 COFF import record")};
    }

    val data_size: usize          = bin.read_u32_le(buf, 12)::usize;
    val vr:        err[fail.Fail] = bin.require_region(buf_size, IMPORT_OBJECT_HEADER_SIZE,
        data_size, "import record name data out of bounds");
    if (sel vr.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, fail.describe(vr.err))}; }

    val hint_ord:    u16 = bin.read_u16_le(buf, 16);
    val flags:       u16 = bin.read_u16_le(buf, 18);
    val import_type: u16 = flags & 0x3;
    val name_type:   u16 = (flags >> 2) & 0x7;
    if (import_type > IMPORT_OBJECT_TYPE_CONST) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record has an invalid import type")};
    }
    if (name_type > IMPORT_OBJECT_NAME_EXPORTAS) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record has an invalid name type")};
    }
    if ((flags & 0xFFE0) != 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record has nonzero reserved flags")};
    }

    val base:    usize = IMPORT_OBJECT_HEADER_SIZE;
    val limit:   usize = base + data_size;
    var sym_end: usize = base;
    for (sym_end < limit && buf[sym_end] != 0) { sym_end = sym_end + 1; }
    if (sym_end >= limit) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record symbol name is unterminated")}; }
    val dll_start: usize = sym_end + 1;
    var dll_end:   usize = dll_start;
    for (dll_end < limit && buf[dll_end] != 0) { dll_end = dll_end + 1; }
    if (dll_end >= limit)     { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record library name is unterminated")}; }
    if (sym_end == base)      { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record has an empty symbol name")}; }
    if (dll_end == dll_start) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record has an empty library name")}; }

    val sym_r: res[intern.StrId, A.Error] = intern.add(itn, (?buf[base])::str);
    if (sel sym_r.err) { ret err[fail.Fail].err{fail.refused(sym_r.err)}; }
    val dll_r: res[intern.StrId, A.Error] = intern.add(itn, (?buf[dll_start])::str);
    if (sel dll_r.err) { ret err[fail.Fail].err{fail.refused(dll_r.err)}; }

    var import_name_r: res[intern.StrId, A.Error] = sym_r;
    if (name_type == IMPORT_OBJECT_NAME_NOPREFIX || name_type == IMPORT_OBJECT_NAME_UNDECORATE) {
        var name_start: usize = base;
        if (buf[name_start] == '?'::u8 || buf[name_start] == '@'::u8 || buf[name_start] == '_'::u8) {
            name_start = name_start + 1;
        }
        var name_end: usize = sym_end;
        if (name_type == IMPORT_OBJECT_NAME_UNDECORATE) {
            name_end = name_start;
            for (name_end < sym_end && buf[name_end] != '@'::u8) { name_end = name_end + 1; }
        }
        if (name_end == name_start) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record resolves to an empty export name")};
        }
        import_name_r = intern.bytes_add(itn, (?buf[name_start])::str, name_end - name_start);
    }
    or (name_type == IMPORT_OBJECT_NAME_EXPORTAS) {
        val export_start: usize = dll_end + 1;
        var export_end:   usize = export_start;
        for (export_end < limit && buf[export_end] != 0) { export_end = export_end + 1; }
        if (export_end >= limit) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record export name is unterminated")};
        }
        if (export_end == export_start) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "import record has an empty export name")};
        }
        import_name_r = intern.add(itn, (?buf[export_start])::str);
    }
    if (sel import_name_r.err) {
        ret err[fail.Fail].err{fail.refused(import_name_r.err)};
    }

    val ir: res[*target_of.ImportDecl, A.Error] = A.zallocate[target_of.ImportDecl](alloc, 1::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }

    out.imports      = ir.ok;
    out.import_count = 1;
    out.import_cap   = 1;

    out.imports[0].symbol      = sym_r.ok;
    out.imports[0].import_name = import_name_r.ok;
    out.imports[0].library     = dll_r.ok;
    out.imports[0].by_name     = name_type != IMPORT_OBJECT_ORDINAL;
    out.imports[0].ordinal     = hint_ord;
    out.imports[0].is_code     = import_type == IMPORT_OBJECT_TYPE_CODE;
    ret err[fail.Fail].ok{};
}

fun parse_object(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *target_of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = target_of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (out == nil || buf == nil || buf_size < 4) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "COFF object too small")};
    }
    if (alloc == nil) { ret err[fail.Fail].err{fail.message("no allocator for parse")}; }
    if (itn == nil)   { ret err[fail.Fail].err{fail.message("no interner for parse")}; }

    var parsed: target_of.ObjectImage = target_of.object_image_init(alloc, itn, intern.STR_NIL);
    val built:  err[fail.Fail]        = parse_object_into(alloc, itn, buf, buf_size, ?parsed);
    if (sel built.err) {
        target_of.object_image_dnit(?parsed);
        ret built;
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object_or_dnit(?parsed);
    if (sel valid.err) { ret valid; }
    @out = parsed;
    ret err[fail.Fail].ok{};
}

fun parse_object_into(alloc: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_size: usize, out: *target_of.ObjectImage) err[fail.Fail] {
    if (out != nil) { @out = target_of.object_image_init(alloc, itn, intern.STR_NIL); }
    if (buf == nil || out == nil || buf_size < 4) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "COFF object too small")};
    }
    val sig1: u16  = bin.read_u16_le(buf, 0);
    val sig2: u16  = bin.read_u16_le(buf, 2);
    val anon: bool = sig1 == IMAGE_FILE_MACHINE_UNKNOWN && sig2 == BIGOBJ_SIG2;

    val bigobj: bool = anon && buf_size >= BIGOBJ_HEADER_SIZE
        && bin.read_u16_le(buf, 4) >= BIGOBJ_MIN_VERSION
        && bigobj_class_id_matches(buf, 12);
    if (anon && !bigobj) {
        ret parse_import_record(alloc, itn, buf, buf_size, out);
    }

    var num_secs:     u32   = 0;
    var symtab_off:   usize = 0;
    var num_records:  u32   = 0;
    var secthdr_base: usize = 0;
    if (bigobj) {
        if (buf_size < BIGOBJ_HEADER_SIZE) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "bigobj object too small")}; }
        if (bin.read_u16_le(buf, 4) < BIGOBJ_MIN_VERSION) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "bigobj header version below the minimum")};
        }
        if (bin.read_u16_le(buf, 6) != IMAGE_FILE_MACHINE_AMD64) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_FORMAT_MISMATCH, "not an x86-64 COFF object")};
        }
        if (!bigobj_class_id_matches(buf, 12)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "bigobj header has an unrecognized ClassID")};
        }
        num_secs     = bin.read_u32_le(buf, 44);
        symtab_off   = bin.read_u32_le(buf, 48)::usize;
        num_records  = bin.read_u32_le(buf, 52);
        secthdr_base = BIGOBJ_HEADER_SIZE;
    }
    or {
        if (buf_size < HEADER_SIZE)           { ret err[fail.Fail].err{fail.message("COFF object too small")}; }
        if (sig1 != IMAGE_FILE_MACHINE_AMD64) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_FORMAT_MISMATCH, "not an x86-64 COFF object")}; }
        num_secs    = bin.read_u16_le(buf, 2)::u32;
        symtab_off  = bin.read_u32_le(buf, 8)::usize;
        num_records = bin.read_u32_le(buf, 12);
        val opt_size: u16 = bin.read_u16_le(buf, 16);
        secthdr_base = HEADER_SIZE + opt_size::usize;
    }
    if (itn == nil) { ret err[fail.Fail].err{fail.message("no interner for parse")}; }
    out.interner = itn;

    val symbol_size: usize = sym_record_size(bigobj);

    val vsh: err[fail.Fail] = bin.require_region(buf_size, secthdr_base,
        num_secs::usize * SECTION_HEADER_SIZE, "section header table out of bounds");
    if (sel vsh.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, fail.describe(vsh.err))}; }
    val vsy: err[fail.Fail] = bin.require_region(buf_size, symtab_off,
        num_records::usize * symbol_size, "symbol table out of bounds");
    if (sel vsy.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, fail.describe(vsy.err))}; }
    val strtab_base: usize = symtab_off + num_records::usize * symbol_size;

    var rel_total: lang_checked.Count[target_of.Relocation] = lang_checked.count[target_of.Relocation](0::usize);
    var s:         u32                                      = 0;
    for (s < num_secs) {
        val table: res[RelocTable, fail.Fail] = section_reloc_table(buf, buf_size, secthdr_base + s::usize * SECTION_HEADER_SIZE);
        if (sel table.err) { ret err[fail.Fail].err{table.err}; }
        val term:  lang_checked.Count[target_of.Relocation]                          = lang_checked.count[target_of.Relocation](table.ok.count::usize);
        val added: res[lang_checked.Count[target_of.Relocation], lang_checked.Cause] =
            lang_checked.count_add[target_of.Relocation](rel_total, term);
        if (sel added.err) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "relocation count exceeds the u32 limit")};
        }
        rel_total = added.ok;
        s         = s + 1;
    }
    val rel_n_fits: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(rel_total.value);
    if (sel rel_n_fits.err) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "relocation count exceeds the u32 limit")};
    }
    val rel_n: u32 = rel_n_fits.ok;
    var sym_n: u32 = 0;
    var ri:    u32 = 0;
    for (ri < num_records) {
        val so:  usize = symtab_off + ri::usize * symbol_size;
        val aux: u8    = buf[sym_naux_off(so, bigobj)];
        sym_n = sym_n + 1;
        ri    = ri + 1 + aux::u32;
    }

    if (num_secs > 0) {
        val rsec: res[*target_of.Section, A.Error] = A.zallocate[target_of.Section](alloc, num_secs::usize);
        if (sel rsec.err) { ret err[fail.Fail].err{fail.message("section array alloc failed")}; }
        out.sections    = rsec.ok;
        out.section_cap = num_secs;
    }
    if (sym_n > 0) {
        val rsym: res[*target_of.Symbol, A.Error] = A.zallocate[target_of.Symbol](alloc, sym_n::usize);
        if (sel rsym.err) { ret err[fail.Fail].err{fail.message("symbol array alloc failed")}; }
        out.symbols    = rsym.ok;
        out.symbol_cap = sym_n;
    }
    if (rel_n > 0) {
        val rrel: res[*target_of.Relocation, A.Error] = A.zallocate[target_of.Relocation](alloc, rel_n::usize);
        if (sel rrel.err) { ret err[fail.Fail].err{fail.message("reloc array alloc failed")}; }
        out.relocations = rrel.ok;
        out.reloc_cap   = rel_n;
    }

    out.section_count = num_secs;
    out.symbol_count  = sym_n;
    out.reloc_count   = rel_n;

    val res_map: res[*i32, A.Error] = A.zallocate[i32](alloc, (num_records + 1)::usize);
    if (sel res_map.err) { ret err[fail.Fail].err{fail.message("symbol map alloc failed")}; }
    var rec_map: *i32 = res_map.ok;

    var name_scratch: [9]u8;

    s = 0;
    for (s < num_secs) {
        val sh:  usize               = secthdr_base + s::usize * SECTION_HEADER_SIZE;
        val rsn: res[str, fail.Fail] = read_section_name(buf, buf_size, sh, strtab_base, ?name_scratch[0]);
        if (sel rsn.err) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret err[fail.Fail].err{rsn.err};
        }
        val sname: str                        = rsn.ok;
        val rin:   res[intern.StrId, A.Error] = intern.add(itn, sname);
        if (sel rin.err) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret err[fail.Fail].err{fail.refused(rin.err)};
        }

        val chars: u32                   = bin.read_u32_le(buf, sh + 36);
        var kind:  target_of.SectionKind = target_of.SK_DATA;
        # a grouped `.pdata$<name>` (gcc and clang for mingw, with a section per function) is the same table
        if (str_equals(sname, ".pdata") || str_starts_with(sname, ".pdata$")) { kind = target_of.SK_EXCEPTION; }
        or ((chars & (IMAGE_SCN_LNK_INFO | IMAGE_SCN_LNK_REMOVE)) != 0)       { kind = target_of.SK_DEBUG; }
        or ((chars & IMAGE_SCN_CNT_CODE) != 0)                                { kind = target_of.SK_TEXT; }
        or ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0)                  { kind = target_of.SK_BSS; }
        or ((chars & IMAGE_SCN_MEM_DISCARDABLE) != 0)                         { kind = target_of.SK_DEBUG; }
        or ((chars & IMAGE_SCN_MEM_WRITE) == 0) {
            if (str_equals(sname, ".data.rel.ro")) { kind = target_of.SK_RELRO; }
            or                                     { kind = target_of.SK_RODATA; }
        }

        out.sections[s].name          = rin.ok;
        out.sections[s].kind          = kind;
        out.sections[s].len           = bin.read_u32_le(buf, sh + 16);
        out.sections[s].align         = align_from_characteristics(chars);
        out.sections[s].bytes         = nil;
        out.sections[s].native.format = target_of.COFF;
        out.sections[s].native.flags  = (chars & ~IMAGE_SCN_LNK_NRELOC_OVFL)::u64;
        # the object's function table: a RUNTIME_FUNCTION per function it describes
        if (kind == target_of.SK_EXCEPTION) {
            out.sections[s].flags             = target_of.SEC_FLAG_UNWIND_INDEX;
            out.sections[s].native.entry_size = RUNTIME_FUNCTION_SIZE::u64;
        }

        val raw_ptr: u32 = bin.read_u32_le(buf, sh + 20);
        if ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) == 0 && raw_ptr != 0
            && out.sections[s].len > 0) {
            val sz: usize = out.sections[s].len::usize;
            if (!bin.region_ok(buf_size, raw_ptr::usize, sz)) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "section raw data out of bounds")};
            }
            val rb: res[*u8, A.Error] = A.allocate[u8](alloc, sz);
            if (sel rb.err) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret err[fail.Fail].err{fail.message("section bytes alloc failed")};
            }
            out.sections[s].bytes = rb.ok;
            memory.raw_copy(out.sections[s].bytes::ptr, (buf::usize + raw_ptr::usize)::ptr, sz);
        }
        s = s + 1;
    }

    var sym_i: u32 = 0;
    ri = 0;
    for (ri < num_records) {
        rec_map[ri] = -1;
        val so:  usize = symtab_off + ri::usize * symbol_size;
        val aux: u8    = buf[sym_naux_off(so, bigobj)];

        val rsyn: res[str, fail.Fail] = read_symbol_name(buf, buf_size, so, strtab_base, ?name_scratch[0]);
        if (sel rsyn.err) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret err[fail.Fail].err{rsyn.err};
        }
        val rin: res[intern.StrId, A.Error] = intern.add(itn, rsyn.ok);
        if (sel rin.err) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret err[fail.Fail].err{fail.refused(rin.err)};
        }

        val idx: u32 = sym_i;
        rec_map[ri]             = idx::i32;
        out.symbols[idx].name   = rin.ok;
        out.symbols[idx].offset = bin.read_u32_le(buf, so + 8);
        out.symbols[idx].size   = 0;

        val sec_num: i32 = read_sym_section_number(buf, so, bigobj);
        val sym_ty:  u16 = read_sym_type(buf, so, bigobj);
        val scl:     u8  = buf[sym_storage_class_off(so, bigobj)];

        var flags: u32 = 0;
        if (scl == IMAGE_SYM_CLASS_EXTERNAL || scl == IMAGE_SYM_CLASS_WEAK_EXTERNAL) {
            flags = flags | target_of.SYM_OBJ_FLAG_GLOBAL;
        }
        if (scl == IMAGE_SYM_CLASS_WEAK_EXTERNAL) { flags = flags | target_of.SYM_OBJ_FLAG_WEAK; }
        if (sym_ty == IMAGE_SYM_DTYPE_FUNCTION)   { flags = flags | target_of.SYM_OBJ_FLAG_FUNCTION; }

        out.symbols[idx].native = target_of.NativeSymbol{format: target_of.COFF, kind: sym_ty::u32, flags: scl::u32};
        if (sec_num == -1) {
            out.symbols[idx].section        = target_of.absolute_section();
            out.symbols[idx].absolute_value = out.symbols[idx].offset::u64;
            out.symbols[idx].offset         = 0;
        }
        or (sec_num <= IMAGE_SYM_UNDEFINED::i32) {
            flags                    = flags | target_of.SYM_OBJ_FLAG_EXTERN;
            out.symbols[idx].section = target_of.external_section();
            if (sec_num == IMAGE_SYM_UNDEFINED::i32 && scl == IMAGE_SYM_CLASS_EXTERNAL
                && out.symbols[idx].offset != 0) {
                flags                   = flags | target_of.SYM_OBJ_FLAG_COMMON | target_of.SYM_OBJ_FLAG_OBJECT;
                out.symbols[idx].size   = out.symbols[idx].offset;
                out.symbols[idx].offset = 0;
                out.symbols[idx].align  = common_alignment(out.symbols[idx].size);
            }
        }
        or ((sec_num::u32 - 1) < num_secs) {
            out.symbols[idx].section = target_of.section_id(sec_num::u32 - 1);
            flags                    = flags | target_of.SYM_OBJ_FLAG_SIZE_UNKNOWN;
        }
        or {
            out.symbols[idx].section = target_of.external_section();
        }

        if (scl == IMAGE_SYM_CLASS_STATIC && aux >= 1 && ri + 1 < num_records
            && sec_num > 0 && sec_num::u32 <= num_secs && out.symbols[idx].offset == 0) {
            val native: *target_of.NativeSection = ?out.sections[sec_num::u32 - 1].native;
            if ((native.flags::u32 & IMAGE_SCN_LNK_COMDAT) != 0) {
                val ax: usize = so + symbol_size;
                native.selection = buf[ax + 14]::u32;
                native.checksum  = bin.read_u32_le(buf, ax + 8);
                if (native.selection == IMAGE_COMDAT_SELECT_ASSOCIATIVE::u32) {
                    native.link_section = bin.read_u16_le(buf, ax + 12)::u32
                        | (bin.read_u16_le(buf, ax + 16)::u32 << 16);
                    if (native.link_section == 0 || native.link_section > num_secs
                        || native.link_section == sec_num::u32) {
                        A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "associative COMDAT section is out of range")};
                    }
                    out.sections[sec_num::u32 - 1].flags = out.sections[sec_num::u32 - 1].flags | target_of.SEC_FLAG_ASSOCIATED;
                }
            }
        }

        if ((flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0
            && target_of.section_index(out.symbols[idx].section) < num_secs) {
            val dsh: usize = secthdr_base + target_of.section_index(out.symbols[idx].section)::usize * SECTION_HEADER_SIZE;
            if ((bin.read_u32_le(buf, dsh + 36) & IMAGE_SCN_LNK_COMDAT) != 0
                && comdat_dedups_for_section(buf, symtab_off, num_records,
                target_of.section_index(out.symbols[idx].section) + 1, bigobj)) {
                flags = flags | target_of.SYM_OBJ_FLAG_WEAK;
            }
        }
        out.symbols[idx].flags = flags;
        sym_i                  = sym_i + 1;

        var a: u32 = 0;
        for (a < aux::u32) {
            if ((ri + 1 + a) < num_records) { rec_map[ri + 1 + a] = idx::i32; }
            a = a + 1;
        }
        ri = ri + 1 + aux::u32;
    }

    val wa: err[fail.Fail] =
        preserve_weak_external_fallbacks(buf, symtab_off, num_records,
        bigobj, rec_map, out);
    if (sel wa.err) {
        A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
        ret wa;
    }
    retain_outside_comdats(out);

    var rel_i: u32 = 0;
    s = 0;
    for (s < num_secs) {
        val table: res[RelocTable, fail.Fail] = section_reloc_table(buf, buf_size, secthdr_base + s::usize * SECTION_HEADER_SIZE);
        if (sel table.err) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret err[fail.Fail].err{table.err};
        }
        val rptr:   usize = table.ok.first;
        val rcount: u32   = table.ok.count;
        if (rcount > 0 && !bin.region_ok(buf_size, rptr, rcount::usize * RELOCATION_SIZE)) {
            A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "relocation array out of bounds")};
        }
        var k: u32 = 0;
        for (k < rcount) {
            val ro:     usize = rptr + k::usize * RELOCATION_SIZE;
            val idx:    u32   = rel_i;
            val r_type: u16   = bin.read_u16_le(buf, ro + 8);
            val r_off:  u32   = bin.read_u32_le(buf, ro);
            out.relocations[idx].section = target_of.section_id(s);
            out.relocations[idx].offset  = r_off;
            val rk: res[target_of.RelocKind, fail.Fail] = reloc_kind_for(itn, alloc, r_type);
            if (sel rk.err) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret err[fail.Fail].err{rk.err};
            }
            out.relocations[idx].kind = rk.ok;
            val wr: res[usize, fail.Fail] = reloc_field_width(itn, alloc, out.relocations[idx].kind, target_of.RELOC_CODEGEN);
            if (sel wr.err) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret err[fail.Fail].err{wr.err};
            }
            val field_width: usize = wr.ok;
            if (out.sections[s].bytes == nil || r_off::usize > out.sections[s].len::usize
                || field_width > out.sections[s].len::usize - r_off::usize) {
                A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "relocation field is out of bounds")};
            }
            out.relocations[idx].addend = read_inplace_addend(?out.sections[s], r_type, r_off);
            memory.raw_zero((out.sections[s].bytes::usize + r_off::usize)::ptr, field_width);

            val rec: u32 = bin.read_u32_le(buf, ro + 4);
            if (rec < num_records && rec_map[rec] >= 0) {
                out.relocations[idx].sym = rec_map[rec]::u32;
            }
            or {
                out.relocations[idx].sym = target_of.SYMBOL_NONE;
            }
            rel_i = rel_i + 1;
            k     = k + 1;
        }
        s = s + 1;
    }

    val native_view: err[fail.Fail] = target_of.validate_object_view(out);
    if (sel native_view.err) {
        A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
        ret native_view;
    }
    val native_normalized: err[fail.Fail] = coff_imports.normalize(out);
    if (sel native_normalized.err) {
        A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
        ret native_normalized;
    }
    val inf: err[fail.Fail] = infer_extern_function_flags_from_calls(out);

    A.deallocate[i32](alloc, rec_map, (num_records + 1)::usize);
    if (sel inf.err) { ret inf; }

    val dfr: err[fail.Fail] = decode_frames_section(alloc, itn, out);
    if (sel dfr.err) { ret dfr; }
    val ddr: err[fail.Fail] = decode_directives_section(alloc, itn, out);
    if (sel ddr.err) { ret ddr; }
    val recorded: err[fail.Fail] = record.consume(itn, out, record.SECTION_NAME);
    if (sel recorded.err) { ret recorded; }
    ret carrier.consume(itn, out, carrier.SECTION_NAME);
}

# true when `tok` spells `-export:` or `/export:` in any case, with the name
# starting at `tok[8]`
fun is_export_directive(tok: *u8, len: usize) bool {
    if (len < 8 || (tok[0] != '-' && tok[0] != '/')) { ret false; }
    val word: str   = "export:";
    var i:    usize = 0;
    for (i < 7) {
        if (char_to_lower(tok[1 + i]) != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# reads `.drectve` and applies export-by-absence: a global definition the
# directives name stays visible, every other global definition is hidden, and
# a directive naming no definition here is an export request. the section is
# consumed so a foreign object's directives never land in the image. an
# object with no `.drectve` says nothing about its surface and is left as
# its symbol records spell it
fun decode_directives_section(alloc: *A.Allocator, itn: *intern.Interner, out: *target_of.ObjectImage) err[fail.Fail] {
    val dname_r: res[intern.StrId, A.Error] = intern.add(itn, DIRECTIVES_SECTION_NAME);
    if (sel dname_r.err) { ret err[fail.Fail].err{fail.refused(dname_r.err)}; }
    var ds_i: u32 = 0xFFFFFFFF;
    var si:   u32 = 0;
    for (si < out.section_count) {
        if (intern.str_same(out.sections[si].name, dname_r.ok)) {
            ds_i = si;
            brk;
        }
        si = si + 1;
    }
    if (ds_i == 0xFFFFFFFF) { ret err[fail.Fail].ok{}; }
    val sec:  *target_of.Section = ?out.sections[ds_i];
    val blob: *u8                = sec.bytes;
    val blen: usize              = sec.len::usize;

    # every global definition starts hidden; a directive brings it back
    var sy: u32 = 0;
    for (sy < out.symbol_count) {
        if (directive_names_symbol(?out.symbols[sy])) {
            out.symbols[sy].flags = out.symbols[sy].flags | target_of.SYM_OBJ_FLAG_HIDDEN;
        }
        sy = sy + 1;
    }

    var requests: *intern.StrId = nil;
    var req_n:    u32           = 0;
    var req_cap:  u32           = 0;
    var pos:      usize         = 0;
    for (blob != nil && pos < blen) {
        for (pos < blen && (blob[pos] == ' ' || blob[pos] == '\t' || blob[pos] == '\n' || blob[pos] == '\r' || blob[pos] == 0)) { pos = pos + 1; }
        if (pos >= blen) { brk; }
        var tok_start: usize = pos;
        var quoted:    bool  = false;
        for (pos < blen) {
            val c: u8 = blob[pos];
            if (c == '"')                                                               { quoted = !quoted; }
            or (!quoted && (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0)) { brk; }
            pos = pos + 1;
        }
        val tok_len: usize = pos - tok_start;
        if (!is_export_directive(?blob[tok_start], tok_len)) { cnt; }

        # the name runs to `,` (a DATA/ordinal suffix) or `=` (an alias
        # target), with any quotes stripped
        var name_len: usize             = 0;
        var name_buf: *u8               = nil;
        val nb:       res[*u8, A.Error] = A.allocate[u8](alloc, tok_len + 1);
        if (sel nb.err) {
            if (requests != nil) { A.deallocate[intern.StrId](alloc, requests, req_cap::usize); }
            ret err[fail.Fail].err{fail.message("directive name alloc failed")};
        }
        name_buf = nb.ok;
        var k: usize = 8;
        for (k < tok_len) {
            val c: u8 = blob[tok_start + k];
            if (c == ',' || c == '=') { brk; }
            if (c != '"') {
                name_buf[name_len] = c;
                name_len           = name_len + 1;
            }
            k = k + 1;
        }
        name_buf[name_len] = 0;
        if (name_len == 0) {
            A.deallocate[u8](alloc, name_buf, tok_len + 1);
            cnt;
        }
        val nir: res[intern.StrId, A.Error] = intern.add(itn, name_buf::str);
        A.deallocate[u8](alloc, name_buf, tok_len + 1);
        if (sel nir.err) {
            if (requests != nil) { A.deallocate[intern.StrId](alloc, requests, req_cap::usize); }
            ret err[fail.Fail].err{fail.refused(nir.err)};
        }
        val nid: intern.StrId = nir.ok;

        var defined: bool = false;
        sy = 0;
        for (sy < out.symbol_count) {
            if (intern.str_same(out.symbols[sy].name, nid) && directive_names_symbol(?out.symbols[sy])) {
                out.symbols[sy].flags = out.symbols[sy].flags & ~target_of.SYM_OBJ_FLAG_HIDDEN;
                defined               = true;
            }
            sy = sy + 1;
        }
        if (defined) { cnt; }

        var seen: bool = false;
        var r:    u32  = 0;
        for (r < req_n) {
            if (intern.str_same(requests[r], nid)) { seen = true; }
            r = r + 1;
        }
        if (seen) { cnt; }
        if (req_n == req_cap) {
            val ra: err[A.Error] = growth.reserve[intern.StrId](alloc, ?requests, ?req_cap, req_n::usize + 1);
            if (sel ra.err) {
                if (requests != nil) { A.deallocate[intern.StrId](alloc, requests, req_cap::usize); }
                ret err[fail.Fail].err{fail.message("export request alloc failed")};
            }
        }
        requests[req_n] = nid;
        req_n           = req_n + 1;
    }

    out.export_requests      = requests;
    out.export_request_count = req_n;
    out.export_request_cap   = req_cap;

    if (sec.bytes != nil) { A.deallocate[u8](alloc, sec.bytes, sec.len::usize); }
    sec.bytes = nil;
    sec.len   = 0;
    ret err[fail.Fail].ok{};
}

fun decode_frames_section(alloc: *A.Allocator, itn: *intern.Interner,
    out: *target_of.ObjectImage) err[fail.Fail] {
    val fname_r: res[intern.StrId, A.Error] = intern.add(itn, MACH_FRAMES_SECTION_NAME);
    if (sel fname_r.err) {
        ret err[fail.Fail].err{fail.refused(fname_r.err)};
    }
    val fname: intern.StrId = fname_r.ok;

    var fs_i: u32 = 0xFFFFFFFF;
    var si:   u32 = 0;
    for (si < out.section_count) {
        if (intern.str_same(out.sections[si].name, fname)) {
            fs_i = si;
            brk;
        }
        si = si + 1;
    }
    if (fs_i == 0xFFFFFFFF) { ret err[fail.Fail].ok{}; }

    val sec: *target_of.Section = ?out.sections[fs_i];
    # the zero-length husk an earlier parse left, written back out, is no frames
    if (sec.len == 0) { ret err[fail.Fail].ok{}; }
    val blob: *u8   = sec.bytes;
    val blen: usize = sec.len::usize;
    if (blob == nil || blen < 8) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed .mach.frames section")}; }
    if (bin.read_u32_le(blob, 0) != MACH_FRAMES_VERSION) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "unsupported .mach.frames version")};
    }
    val count: u32 = bin.read_u32_le(blob, 4);
    if (count::usize > blen / 8) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed .mach.frames count")}; }

    var frames: *target_of.FrameUnwind = nil;
    if (count > 0) {
        val fa: res[*target_of.FrameUnwind, A.Error] = A.zallocate[target_of.FrameUnwind](alloc, count::usize);
        if (sel fa.err) { ret err[fail.Fail].err{fail.message("frame record alloc failed")}; }
        frames = fa.ok;
    }

    var pos: usize = 8;
    var i:   u32   = 0;
    for (i < count) {
        if (pos + 8 > blen) {
            A.deallocate[target_of.FrameUnwind](alloc, frames, count::usize);
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "truncated .mach.frames record")};
        }
        val nlen:       usize = bin.read_u32_le(blob, pos)::usize;
        val step_count: u32   = bin.read_u32_le(blob, pos + 4);
        pos = pos + 8;
        val npad: usize = of_plan.align_bounded(nlen, 4);
        if (step_count > target_of.FRAME_STEP_CAP || nlen == 0
            || pos + npad + step_count::usize * 16 > blen) {
            A.deallocate[target_of.FrameUnwind](alloc, frames, count::usize);
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed .mach.frames record")};
        }

        val nb: res[*u8, A.Error] = A.allocate[u8](alloc, nlen + 1);
        if (sel nb.err) {
            A.deallocate[target_of.FrameUnwind](alloc, frames, count::usize);
            ret err[fail.Fail].err{fail.message("frame name alloc failed")};
        }
        val nbuf: *u8 = nb.ok;
        memory.raw_copy(nbuf::ptr, (blob::usize + pos)::ptr, nlen);
        nbuf[nlen] = 0;
        val nir: res[intern.StrId, A.Error] = intern.add(itn, nbuf::str);
        A.deallocate[u8](alloc, nbuf, nlen + 1);
        if (sel nir.err) {
            A.deallocate[target_of.FrameUnwind](alloc, frames, count::usize);
            ret err[fail.Fail].err{fail.refused(nir.err)};
        }
        val nid: intern.StrId = nir.ok;
        pos = pos + npad;

        var sym: u32 = 0xFFFFFFFF;
        var sy:  u32 = 0;
        for (sy < out.symbol_count) {
            if (intern.str_same(out.symbols[sy].name, nid)
                && (out.symbols[sy].flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0
                && !target_of.section_is_external(out.symbols[sy].section)
                && target_of.section_index(out.symbols[sy].section) < out.section_count) {
                sym = sy;
                brk;
            }
            sy = sy + 1;
        }
        if (sym == 0xFFFFFFFF) {
            A.deallocate[target_of.FrameUnwind](alloc, frames, count::usize);
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, ".mach.frames record names no defined function symbol")};
        }

        frames[i].section    = out.symbols[sym].section;
        frames[i].offset     = out.symbols[sym].offset;
        frames[i].step_count = step_count;
        var k: u32 = 0;
        for (k < step_count) {
            frames[i].steps[k].kind    = blob[pos];
            frames[i].steps[k].reg     = blob[pos + 1];
            frames[i].steps[k].end_off = bin.read_u32_le(blob, pos + 4);
            frames[i].steps[k].value   = bin.read_u64_le(blob, pos + 8);
            pos                        = pos + 16;
            k                          = k + 1;
        }
        i = i + 1;
    }

    out.frames      = frames;
    out.frame_count = count;
    out.frame_cap   = count;

    A.deallocate[u8](alloc, sec.bytes, sec.len::usize);
    sec.bytes = nil;
    sec.len   = 0;
    ret err[fail.Fail].ok{};
}

fun is_flagless_extern(sym: *target_of.Symbol) bool {
    if (!target_of.section_is_external(sym.section))      { ret false; }
    if ((sym.flags & target_of.SYM_OBJ_FLAG_EXTERN) == 0) { ret false; }
    ret (sym.flags & target_of.SYM_OBJ_FLAG_FUNCTION) == 0;
}

fun infer_extern_function_flags_from_calls(out: *target_of.ObjectImage) err[fail.Fail] {
    if (out == nil || out.reloc_count == 0 || out.symbol_count == 0) {
        ret err[fail.Fail].ok{};
    }

    var ri: u32 = 0;
    for (ri < out.reloc_count) {
        val r: *target_of.Relocation = ?out.relocations[ri];
        if (r.sym >= out.symbol_count) {
            ri = ri + 1;
            cnt;
        }
        if (!is_flagless_extern(?out.symbols[r.sym])) {
            ri = ri + 1;
            cnt;
        }
        if (r.kind != target_of.RK_PC32 && r.kind != target_of.RK_PLT32) {
            ri = ri + 1;
            cnt;
        }
        if (target_of.section_index(r.section) >= out.section_count) {
            ri = ri + 1;
            cnt;
        }
        val sec: *target_of.Section = ?out.sections[target_of.section_index(r.section)];
        if (sec.bytes == nil || r.offset == 0) {
            ri = ri + 1;
            cnt;
        }
        if (r.offset::usize + 4 > sec.len::usize) {
            ri = ri + 1;
            cnt;
        }
        val op: u8 = sec.bytes[r.offset::usize - 1];
        if (op != 0xE8 && op != 0xE9) {
            ri = ri + 1;
            cnt;
        }

        out.symbols[r.sym].flags =
            out.symbols[r.sym].flags | target_of.SYM_OBJ_FLAG_FUNCTION | target_of.SYM_OBJ_FLAG_GLOBAL;
        ri = ri + 1;
    }

    ret err[fail.Fail].ok{};
}

rec ImportDirLayout {
    dir_off:   usize;
    ilt_off:   usize;
    iat_off:   usize;
    hint_off:  usize;
    hint_size: usize;
    vsize:     usize;
}

# the import directory is its own small plan, relative to the .idata section
fun plan_import_directory(alloc: *A.Allocator, itn: *intern.Interner, dyn: *target_of.DynamicInfo, out: *ImportDirLayout) err[fail.Fail] {
    val made: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "coff", of_plan.LIMIT_32);
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    var ip: of_plan.FilePlan = made.ok;
    fin { of_plan.dnit(?ip); }

    val dir_size: res[usize, fail.Fail] = of_plan.table(?ip, "import directory", (dyn.lib_count::usize + 1), IMPORT_DESCRIPTOR_SIZE);
    if (sel dir_size.err) { ret err[fail.Fail].err{dir_size.err}; }
    val dir_r: res[u32, fail.Fail] = of_plan.place(?ip, "import directory", target_of.no_section(), 1, dir_size.ok);
    if (sel dir_r.err) { ret err[fail.Fail].err{dir_r.err}; }

    val thunk_count: res[u32, fail.Fail] = of_plan.count_u32(?ip, "import thunks", dyn.import_count, dyn.lib_count);
    if (sel thunk_count.err) { ret err[fail.Fail].err{thunk_count.err}; }
    val thunk_bytes: res[usize, fail.Fail] = of_plan.table(?ip, "import thunks", thunk_count.ok::usize, THUNK_SIZE);
    if (sel thunk_bytes.err) { ret err[fail.Fail].err{thunk_bytes.err}; }
    val ilt_r: res[u32, fail.Fail] = of_plan.place(?ip, "import lookup table", target_of.no_section(), 8, thunk_bytes.ok);
    if (sel ilt_r.err) { ret err[fail.Fail].err{ilt_r.err}; }
    val iat_r: res[u32, fail.Fail] = of_plan.place(?ip, "import address table", target_of.no_section(), 8, thunk_bytes.ok);
    if (sel iat_r.err) { ret err[fail.Fail].err{iat_r.err}; }

    var hints: usize = 0;
    var i:     u32   = 0;
    for (i < dyn.import_count) {
        if (!dyn.imports[i].by_ordinal) {
            val grown: res[usize, fail.Fail] = of_plan.sum(?ip, "import names", hints, 2 + name_len_z(itn, dyn.imports[i].symbol));
            if (sel grown.err) { ret err[fail.Fail].err{grown.err}; }
            val aligned: res[usize, fail.Fail] = of_plan.align_up(?ip, "import names", grown.ok, 2);
            if (sel aligned.err) { ret err[fail.Fail].err{aligned.err}; }
            hints = aligned.ok;
        }
        i = i + 1;
    }
    i = 0;
    for (i < dyn.lib_count) {
        val grown: res[usize, fail.Fail] = of_plan.sum(?ip, "import names", hints, name_len_z(itn, dyn.libs[i].soname));
        if (sel grown.err) { ret err[fail.Fail].err{grown.err}; }
        val aligned: res[usize, fail.Fail] = of_plan.align_up(?ip, "import names", grown.ok, 2);
        if (sel aligned.err) { ret err[fail.Fail].err{aligned.err}; }
        hints = aligned.ok;
        i     = i + 1;
    }
    val hint_r: res[u32, fail.Fail] = of_plan.place(?ip, "import names", target_of.no_section(), 2, hints);
    if (sel hint_r.err) { ret err[fail.Fail].err{hint_r.err}; }
    val sealed: res[usize, fail.Fail] = of_plan.seal(?ip);
    if (sel sealed.err) { ret err[fail.Fail].err{sealed.err}; }

    out.dir_off   = of_plan.offset(?ip, dir_r.ok);
    out.ilt_off   = of_plan.offset(?ip, ilt_r.ok);
    out.iat_off   = of_plan.offset(?ip, iat_r.ok);
    out.hint_off  = of_plan.offset(?ip, hint_r.ok);
    out.hint_size = hints;
    out.vsize     = sealed.ok;
    ret err[fail.Fail].ok{};
}

rec PeSection {
    rva:              u64;
    vsize:            u64;
    file_off:         usize;
    file_size:        usize;
    content_rva:      u64;
    content_file_off: usize;
    file_row:         u32;
}

rec PeLayout {
    fp:              of_plan.FilePlan;
    rp:              of_plan.FilePlan;
    image_base:      u64;
    header_size:     usize;
    image_size:      u64;
    seg_secs:        *PeSection;
    stub_sec:        PeSection;
    idata_sec:       PeSection;
    xdata_sec:       PeSection;
    pdata_sec:       PeSection;
    rsrc_sec:        PeSection;
    reloc_sec:       PeSection;
    buildid_sec:     PeSection;
    idata:           ImportDirLayout;
    iat_rva:         u64;
    iat_size:        u64;
    import_dir_rva:  u64;
    import_dir_size: u64;
    exception_rva:   u64;
    exception_size:  u64;
    resource_rva:    u64;
    resource_size:   u64;
    basereloc_rva:   u64;
    basereloc_size:  u64;
    nimp:            u32;
    have_stub:       bool;
    have_idata:      bool;
    have_xdata:      bool;
    have_pdata:      bool;
    have_rsrc:       bool;
    have_reloc:      bool;
    sec_total:       u32;
    debug_secs:      *PeSection;
    debug_count:     u32;
    strtab_row:      u32;
    strtab_off:      usize;
    strtab_size:     usize;
    total_size:      usize;
}

fun layout_dnit(lay: *PeLayout) {
    of_plan.dnit(?lay.fp);
    of_plan.dnit(?lay.rp);
}

# one PE section: a file-aligned row in the file plan and a page-aligned (or
# dictated) row in the address plan
fun place_pe_section(lay: *PeLayout, label: str, sec: *PeSection, dictated_rva: bool, rva: u64,
    vsize: u64, raw_file: usize) err[fail.Fail] {
    val file_size: res[usize, fail.Fail] = of_plan.align_up(?lay.fp, label, raw_file, FILE_ALIGN::usize);
    if (sel file_size.err) { ret err[fail.Fail].err{file_size.err}; }
    val frow: res[u32, fail.Fail] = of_plan.place(?lay.fp, label, target_of.no_section(), FILE_ALIGN::usize, file_size.ok);
    if (sel frow.err) { ret err[fail.Fail].err{frow.err}; }
    sec.file_row  = frow.ok;
    sec.file_off  = of_plan.offset(?lay.fp, sec.file_row);
    sec.file_size = of_plan.size(?lay.fp, sec.file_row);
    var rrow: res[u32, fail.Fail] = res[u32, fail.Fail].ok{of_plan.NO_ROW};
    if (dictated_rva) { rrow = of_plan.place_at(?lay.rp, label, target_of.no_section(), rva::usize, vsize::usize); }
    or                { rrow = of_plan.place(?lay.rp, label, target_of.no_section(), SECTION_ALIGN::usize, vsize::usize); }
    if (sel rrow.err) { ret err[fail.Fail].err{rrow.err}; }
    sec.rva              = of_plan.offset(?lay.rp, rrow.ok)::u64;
    sec.vsize            = vsize;
    sec.content_rva      = sec.rva;
    sec.content_file_off = sec.file_off;
    ret err[fail.Fail].ok{};
}

rec UnwindCode {
    end_off:     u8;
    op:          u8;
    info:        u8;
    extra0:      u16;
    extra1:      u16;
    extra_slots: u8;
}

rec FunctionUnwind {
    seg_index:   u32;
    seg_offset:  u32;
    size:        u32;
    prolog_size: u8;
    frame_reg:   u8;
    frame_off:   u8;
    code_count:  u32;
    slot_count:  u32;
    xdata_rva:   u64;
    xdata_size:  usize;
    codes:       [32]UnwindCode;
}

fun foreign_runtime_count(exceptions: *target_of.Section, exception_count: u32) res[u32, fail.Fail] {
    var total: u64 = 0;
    var i:     u32 = 0;
    for (i < exception_count) {
        if (exceptions == nil || exceptions[i].kind != target_of.SK_EXCEPTION
            || exceptions[i].len::usize % RUNTIME_FUNCTION_SIZE != 0
            || (exceptions[i].len > 0 && exceptions[i].bytes == nil)) {
            ret res[u32, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed exception metadata")};
        }
        total = total + (exceptions[i].len::usize / RUNTIME_FUNCTION_SIZE)::u64;
        if (total > 0xFFFFFFFF) { ret res[u32, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "too many runtime functions")}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{total::u32};
}

fun foreign_runtime_has_begin(exceptions: *target_of.Section, exception_count: u32,
    begin_rva: u32) bool {
    var s: u32 = 0;
    for (s < exception_count) {
        var off: usize = 0;
        for (off + RUNTIME_FUNCTION_SIZE <= exceptions[s].len::usize) {
            if (bin.read_u32_le(exceptions[s].bytes, off) == begin_rva) { ret true; }
            off = off + RUNTIME_FUNCTION_SIZE;
        }
        s = s + 1;
    }
    ret false;
}

fun name_len_z(itn: *intern.Interner, id: intern.StrId) usize {
    val s: str = bin.resolve_name(itn, id);
    if (s == nil) { ret 1; }
    ret str_len(s) + 1;
}

fun section_flags(flags: u32, has_data: bool) u32 {
    var c: u32 = 0;
    if ((flags & target_of.SEG_FLAG_EXECUTE) != 0) {
        c = c | IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ;
    }
    or (!has_data) {
        c = c | IMAGE_SCN_CNT_UNINITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    or ((flags & target_of.SEG_FLAG_WRITE) != 0) {
        c = c | IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
    }
    or {
        c = c | IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ;
    }
    ret c;
}

fun import_dir_bytes(dyn: *target_of.DynamicInfo) usize {
    ret (dyn.lib_count + 1)::usize * IMPORT_DESCRIPTOR_SIZE;
}

fun base_reloc_cmp(a: *target_of.BaseReloc, b: *target_of.BaseReloc) i64 {
    if (a.seg_index != b.seg_index) {
        if (a.seg_index < b.seg_index) { ret -1; }
        ret 1;
    }
    if (a.seg_offset < b.seg_offset) { ret -1; }
    if (a.seg_offset > b.seg_offset) { ret 1; }
    ret 0;
}

fun base_reloc_rva(br: *target_of.BaseReloc, seg_secs: *PeSection) u64 {
    ret seg_secs[br.seg_index].content_rva + br.seg_offset::u64;
}

fun base_reloc_page(rva: u64) u64 {
    ret (rva / BASE_RELOC_PAGE) * BASE_RELOC_PAGE;
}

fun measure_reloc_bytes(dyn: *target_of.DynamicInfo, seg_secs: *PeSection) usize {
    if (dyn == nil || dyn.base_reloc_count == 0) { ret 0; }
    var total: usize = 0;
    var i:     u32   = 0;
    for (i < dyn.base_reloc_count) {
        val page: u64 = base_reloc_page(base_reloc_rva(?dyn.base_relocs[i], seg_secs));
        var j:    u32 = i;
        for (j < dyn.base_reloc_count && base_reloc_page(base_reloc_rva(?dyn.base_relocs[j], seg_secs)) == page) {
            j = j + 1;
        }
        var entries: u32 = j - i;
        if ((entries & 1) != 0) { entries = entries + 1; }
        total = total + BASE_RELOC_BLOCK_HEADER + entries::usize * 2;
        i     = j;
    }
    ret total;
}

fun write_reloc_section(buf: *u8, off: usize, dyn: *target_of.DynamicInfo, seg_secs: *PeSection) usize {
    if (dyn == nil || dyn.base_reloc_count == 0) { ret off; }
    var p: usize = off;
    var i: u32   = 0;
    for (i < dyn.base_reloc_count) {
        val page: u64 = base_reloc_page(base_reloc_rva(?dyn.base_relocs[i], seg_secs));
        var j:    u32 = i;
        for (j < dyn.base_reloc_count && base_reloc_page(base_reloc_rva(?dyn.base_relocs[j], seg_secs)) == page) {
            j = j + 1;
        }
        val n:       u32 = j - i;
        var entries: u32 = n;
        if ((entries & 1) != 0) { entries = entries + 1; }
        val block_size: usize = BASE_RELOC_BLOCK_HEADER + entries::usize * 2;
        bin.write_u32_le(buf, p, page::u32);
        bin.write_u32_le(buf, p + 4, block_size::u32);
        var q: usize = p + BASE_RELOC_BLOCK_HEADER;
        var k: u32   = i;
        for (k < j) {
            val rva:   u64 = base_reloc_rva(?dyn.base_relocs[k], seg_secs);
            val entry: u16 = (IMAGE_REL_BASED_DIR64 << 12) | (rva - page)::u16;
            bin.write_u16_le(buf, q, entry);
            q = q + 2;
            k = k + 1;
        }
        if ((n & 1) != 0) {
            bin.write_u16_le(buf, q, IMAGE_REL_BASED_ABSOLUTE);
        }
        p = p + block_size;
        i = j;
    }
    ret p;
}

fun push_unwind_code(uw: *FunctionUnwind, end_off: u8, op: u8, info: u8,
    extra0: u16, extra1: u16, extra_slots: u8) bool {
    if (uw.code_count >= 32) { ret false; }
    uw.codes[uw.code_count].end_off     = end_off;
    uw.codes[uw.code_count].op          = op;
    uw.codes[uw.code_count].info        = info;
    uw.codes[uw.code_count].extra0      = extra0;
    uw.codes[uw.code_count].extra1      = extra1;
    uw.codes[uw.code_count].extra_slots = extra_slots;
    uw.code_count                       = uw.code_count + 1;
    uw.slot_count                       = uw.slot_count + 1 + extra_slots::u32;
    ret true;
}

fun push_alloc_code(uw: *FunctionUnwind, end_off: u8, alloc: usize) bool {
    if (alloc == 0)       { ret true; }
    if ((alloc & 7) != 0) { ret false; }
    if (alloc <= 128) {
        ret push_unwind_code(uw, end_off, UWOP_ALLOC_SMALL, ((alloc - 8) / 8)::u8, 0, 0, 0);
    }
    val scaled: u32 = (alloc / 8)::u32;
    if (scaled <= 0xFFFF) {
        ret push_unwind_code(uw, end_off, UWOP_ALLOC_LARGE, 0, scaled::u16, 0, 1);
    }
    ret push_unwind_code(uw, end_off, UWOP_ALLOC_LARGE, 1,
        (alloc & 0xFFFF)::u16, ((alloc >> 16) & 0xFFFF)::u16, 2);
}

fun push_save_nonvol(uw: *FunctionUnwind, end_off: u8, reg: u8, save_off: usize) bool {
    if ((save_off & 7) != 0) { ret false; }
    val scaled: u64 = (save_off / 8)::u64;
    if (scaled <= 0xFFFF) {
        ret push_unwind_code(uw, end_off, UWOP_SAVE_NONVOL, reg, scaled::u16, 0, 1);
    }
    if (save_off > 0xFFFFFFFF::usize) { ret false; }
    ret push_unwind_code(uw, end_off, UWOP_SAVE_NONVOL_FAR, reg,
        (save_off & 0xFFFF)::u16, ((save_off >> 16) & 0xFFFF)::u16, 2);
}

fun push_save_xmm128(uw: *FunctionUnwind, end_off: u8, reg: u8, save_off: usize) bool {
    if ((save_off & 15) != 0) { ret false; }
    val scaled: u64 = (save_off / 16)::u64;
    if (scaled <= 0xFFFF) {
        ret push_unwind_code(uw, end_off, UWOP_SAVE_XMM128, reg, scaled::u16, 0, 1);
    }
    if (save_off > 0xFFFFFFFF::usize) { ret false; }
    ret push_unwind_code(uw, end_off, UWOP_SAVE_XMM128_FAR, reg,
        (save_off & 0xFFFF)::u16, ((save_off >> 16) & 0xFFFF)::u16, 2);
}

fun build_function_unwind(uw: *FunctionUnwind, seg_count: u32,
    funcs: *target_of.ExecFunction, idx: u32) bool {
    uw.seg_index   = funcs[idx].seg_index;
    uw.seg_offset  = funcs[idx].seg_offset;
    uw.size        = funcs[idx].size;
    uw.prolog_size = 0;
    uw.frame_reg   = 0;
    uw.frame_off   = 0;
    uw.code_count  = 0;
    uw.slot_count  = 0;
    uw.xdata_rva   = 0;
    uw.xdata_size  = 0;

    if (uw.seg_index >= seg_count || uw.size == 0)        { ret false; }
    if (funcs[idx].step_count == 0)                       { ret false; }
    if (funcs[idx].step_count > target_of.FRAME_STEP_CAP) { ret false; }

    # rsp is static across the body unless the prologue realigns it, and only
    # then does windows need the frame register to find the frame
    var realigned: bool = false;
    var i:         u32  = 0;
    for (i < funcs[idx].step_count) {
        if (funcs[idx].steps[i].kind == target_of.FRAME_STEP_REALIGN) { realigned = true; }
        i = i + 1;
    }

    # a save is found from the frame register, which cannot reach one under a
    # realigned rsp, so a prologue that saves after realigning has no record
    var prolog_end:   u32  = 0;
    var past_realign: bool = false;
    i = 0;
    for (i < funcs[idx].step_count) {
        val stp: *target_of.FrameStep = ?funcs[idx].steps[i];
        if (stp.kind == target_of.FRAME_STEP_REALIGN)                                                             { past_realign = true; }
        if (past_realign && (stp.kind == target_of.FRAME_STEP_SAVE || stp.kind == target_of.FRAME_STEP_SAVE_VEC)) { ret false; }
        if (stp.kind == target_of.FRAME_STEP_REALIGN || (stp.kind == target_of.FRAME_STEP_SET_FP && !realigned)) {
            i = i + 1;
            cnt;
        }
        if (stp.end_off == 0 || stp.end_off > 255) { ret false; }
        if (stp.end_off::u32 > funcs[idx].size)    { ret false; }
        if (stp.end_off > prolog_end)              { prolog_end = stp.end_off; }
        val end8: u8 = stp.end_off::u8;

        if (stp.kind == target_of.FRAME_STEP_PUSH) {
            if (!push_unwind_code(uw, end8, UWOP_PUSH_NONVOL, stp.reg & 0x0F, 0, 0, 0)) { ret false; }
        }
        or (stp.kind == target_of.FRAME_STEP_ALLOC) {
            if (!push_alloc_code(uw, end8, stp.value::usize)) { ret false; }
        }
        or (stp.kind == target_of.FRAME_STEP_SET_FP) {
            if ((stp.value & 15) != 0 || stp.value / 16 > 15) { ret false; }
            uw.frame_reg = stp.reg & 0x0F;
            uw.frame_off = (stp.value / 16)::u8;
            if (!push_unwind_code(uw, end8, UWOP_SET_FPREG, 0, 0, 0, 0)) { ret false; }
        }
        or (stp.kind == target_of.FRAME_STEP_SAVE) {
            if (!push_save_nonvol(uw, end8, stp.reg & 0x0F, stp.value::usize)) { ret false; }
        }
        or (stp.kind == target_of.FRAME_STEP_SAVE_VEC) {
            if (!push_save_xmm128(uw, end8, stp.reg & 0x0F, stp.value::usize)) { ret false; }
        }
        or {
            ret false;
        }
        i = i + 1;
    }

    if (uw.code_count == 0) { ret false; }
    uw.prolog_size = prolog_end::u8;
    uw.xdata_size  = of_plan.align_bounded(4 + uw.slot_count::usize * 2, 4);
    ret true;
}

fun collect_function_unwind(segs: *target_of.LoadSegment, seg_count: u32, funcs: *target_of.ExecFunction,
    func_count: u32, exceptions: *target_of.Section, exception_count: u32,
    image_base: u64, out: *FunctionUnwind) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < func_count) {
        if (build_function_unwind(?out[n], seg_count, funcs, i)) {
            val begin: u64 = segs[out[n].seg_index].vaddr - image_base
                + out[n].seg_offset::u64;
            if (begin <= 0xFFFFFFFF
                && !foreign_runtime_has_begin(exceptions, exception_count, begin::u32)) {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    ret n;
}

# the unwind codes of every function the image describes that no foreign
# entry already does, and the bytes the unwind data and the exception table take
rec PeUnwind {
    all:        *FunctionUnwind;
    cap:        u32;
    count:      u32;
    xdata_size: usize;
    pdata_size: usize;
}

fun pe_unwind_measure(img: *target_of.LinkedImage) res[PeUnwind, fail.Fail] {
    var u:   PeUnwind;
    val frr: res[u32, fail.Fail] = foreign_runtime_count(img.exceptions, img.exception_count);
    if (sel frr.err) { ret res[PeUnwind, fail.Fail].err{frr.err}; }
    val foreign_count: u32 = frr.ok;
    if (img.function_count == 0 || img.functions == nil) {
        u.pdata_size = foreign_count::usize * RUNTIME_FUNCTION_SIZE;
        ret res[PeUnwind, fail.Fail].ok{u};
    }
    val ur: res[*FunctionUnwind, A.Error] = A.zallocate[FunctionUnwind](img.alloc, img.function_count::usize);
    if (sel ur.err) { ret res[PeUnwind, fail.Fail].err{fail.message("unwind table alloc failed")}; }
    u.all   = ur.ok;
    u.cap   = img.function_count;
    u.count = collect_function_unwind(img.segments, img.segment_count, img.functions, img.function_count,
        img.exceptions, img.exception_count, img.image_base, u.all);
    var ui: u32 = 0;
    for (ui < u.count) {
        val grown: res[usize, lang_checked.Cause] = lang_checked.usize_add(u.xdata_size, u.all[ui].xdata_size);
        if (sel grown.err) {
            pe_unwind_dnit(img.alloc, ?u);
            ret res[PeUnwind, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE unwind data exceeds the file offset width")};
        }
        u.xdata_size = grown.ok;
        ui           = ui + 1;
    }
    if (foreign_count > 0xFFFFFFFF - u.count) {
        pe_unwind_dnit(img.alloc, ?u);
        ret res[PeUnwind, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE exception table count overflows")};
    }
    u.pdata_size = (u.count + foreign_count)::usize * RUNTIME_FUNCTION_SIZE;
    ret res[PeUnwind, fail.Fail].ok{u};
}

fun pe_unwind_dnit(alloc: *A.Allocator, u: *PeUnwind) {
    if (u.all != nil) { A.deallocate[FunctionUnwind](alloc, u.all, u.cap::usize); }
    u.all = nil;
}

fun compute_pe_layout(alloc: *A.Allocator, itn: *intern.Interner, lay: *PeLayout, segs: *target_of.LoadSegment, seg_count: u32,
    dyn: *target_of.DynamicInfo, seg_secs: *PeSection,
    image_base: u64,
    xdata_vsize: usize, pdata_vsize: usize, resource_vsize: usize,
    debug: *target_of.Section, debug_count: u32, debug_secs: *PeSection) err[fail.Fail] {
    lay.nimp        = target_of.func_import_count(dyn);
    lay.seg_secs    = seg_secs;
    lay.have_stub   = lay.nimp > 0;
    lay.have_idata  = dyn != nil && (dyn.lib_count > 0 || dyn.import_count > 0);
    lay.have_xdata  = xdata_vsize > 0;
    lay.have_pdata  = pdata_vsize > 0;
    lay.have_rsrc   = resource_vsize > 0;
    lay.have_reloc  = dyn != nil && dyn.base_reloc_count > 0;
    lay.debug_secs  = debug_secs;
    lay.debug_count = debug_count;
    lay.strtab_row  = of_plan.NO_ROW;
    lay.strtab_off  = 0;
    lay.strtab_size = 0;
    lay.image_base  = image_base;

    val fp_r: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "coff", of_plan.LIMIT_32);
    if (sel fp_r.err) { ret err[fail.Fail].err{fp_r.err}; }
    lay.fp = fp_r.ok;
    val rp_r: res[of_plan.FilePlan, fail.Fail] = of_plan.init(alloc, itn, "coff", of_plan.LIMIT_32);
    if (sel rp_r.err) {
        of_plan.dnit(?lay.fp);
        ret err[fail.Fail].err{rp_r.err};
    }
    lay.rp = rp_r.ok;

    var nsec: u32 = seg_count + 1;
    if (lay.have_rsrc)  { nsec = nsec + 1; }
    if (lay.have_reloc) { nsec = nsec + 1; }
    val nsec_r: res[u32, fail.Fail] = of_plan.count_u32(?lay.fp, "section headers", nsec, debug_count);
    if (sel nsec_r.err) { ret err[fail.Fail].err{nsec_r.err}; }
    nsec          = nsec_r.ok;
    lay.sec_total = nsec;

    val sht_bytes: res[usize, fail.Fail] = of_plan.table(?lay.fp, "section headers", nsec::usize, SECTION_HEADER_SIZE);
    if (sel sht_bytes.err) { ret err[fail.Fail].err{sht_bytes.err}; }
    val headers_raw: usize = DOS_HEADER_SIZE + SIGNATURE_SIZE + HEADER_SIZE
        + OPTIONAL_HEADER_SIZE + sht_bytes.ok;
    val header_size: res[usize, fail.Fail] = of_plan.align_up(?lay.fp, "headers", headers_raw, FILE_ALIGN::usize);
    if (sel header_size.err) { ret err[fail.Fail].err{header_size.err}; }
    lay.header_size = header_size.ok;
    val hrow: res[u32, fail.Fail] = of_plan.place_at(?lay.fp, "headers", target_of.no_section(), 0, lay.header_size);
    if (sel hrow.err) { ret err[fail.Fail].err{hrow.err}; }
    val hrva: res[u32, fail.Fail] = of_plan.place_at(?lay.rp, "headers", target_of.no_section(), 0, lay.header_size);
    if (sel hrva.err) { ret err[fail.Fail].err{hrva.err}; }

    var li: u32 = 0;
    for (li < seg_count) {
        val seg_rva: u64 = segs[li].vaddr - lay.image_base;
        if (li == 0) {
            val header_reserve: res[u64, fail.Fail] = of_plan.align_address(?lay.rp, "headers", lay.header_size::u64, SECTION_ALIGN);
            if (sel header_reserve.err) { ret err[fail.Fail].err{header_reserve.err}; }
            val sec_rva: u64 = header_reserve.ok;
            if (seg_rva < sec_rva) { ret err[fail.Fail].err{fail.message("first segment precedes the PE header page")}; }
            val prefix: u64            = seg_rva - sec_rva;
            val placed: err[fail.Fail] = place_pe_section(lay, "load segment", ?seg_secs[li], false, 0,
                prefix + segs[li].memsz::u64, prefix::usize + segs[li].filesz);
            if (sel placed.err)              { ret placed; }
            if (seg_secs[li].rva != sec_rva) { ret err[fail.Fail].err{fail.message("first segment does not follow the header page")}; }
            seg_secs[li].content_rva      = seg_rva;
            seg_secs[li].content_file_off = seg_secs[li].file_off + prefix::usize;
        }
        or {
            val placed: err[fail.Fail] = place_pe_section(lay, "load segment", ?seg_secs[li], true, seg_rva,
                segs[li].memsz::u64, segs[li].filesz);
            if (sel placed.err) { ret placed; }
        }
        li = li + 1;
    }

    # the stubs and the import directory lie in the segments the linker
    # reserved for them, after every other
    if (lay.have_stub) {
        val k: u32 = table_segment(itn, segs, seg_count, STUBS_TABLE, lay.nimp::usize * IMPORT_STUB_SIZE);
        if (k == NO_TABLE_SEGMENT) {
            ret err[fail.Fail].err{fail.message("the linker laid out no import stub table for the imported functions")};
        }
        lay.stub_sec = seg_secs[k];
    }
    if (lay.have_idata) {
        val idata_planned: err[fail.Fail] = plan_import_directory(alloc, itn, dyn, ?lay.idata);
        if (sel idata_planned.err) { ret idata_planned; }
        val k: u32 = table_segment(itn, segs, seg_count, IMPORTS_TABLE, lay.idata.vsize);
        if (k == NO_TABLE_SEGMENT) {
            ret err[fail.Fail].err{fail.message("the linker laid out no import directory for the imports")};
        }
        lay.idata_sec       = seg_secs[k];
        lay.import_dir_rva  = lay.idata_sec.rva + lay.idata.dir_off::u64;
        lay.import_dir_size = import_dir_bytes(dyn)::u64;
        lay.iat_rva         = lay.idata_sec.rva + lay.idata.iat_off::u64;
        lay.iat_size        = (lay.idata.hint_off - lay.idata.iat_off)::u64;
    }

    if (lay.have_xdata) {
        val k: u32 = table_segment(itn, segs, seg_count, UNWIND_DATA_TABLE, xdata_vsize);
        if (k == NO_TABLE_SEGMENT) { ret err[fail.Fail].err{fail.message("the linker laid out no unwind data for the image's functions")}; }
        lay.xdata_sec = seg_secs[k];
    }

    if (lay.have_pdata) {
        val k: u32 = table_segment(itn, segs, seg_count, EXCEPTION_TABLE, pdata_vsize);
        if (k == NO_TABLE_SEGMENT) { ret err[fail.Fail].err{fail.message("the linker laid out no exception table for the image's functions")}; }
        lay.pdata_sec      = seg_secs[k];
        lay.exception_rva  = lay.pdata_sec.rva;
        lay.exception_size = pdata_vsize::u64;
    }

    if (lay.have_rsrc) {
        val placed: err[fail.Fail] = place_pe_section(lay, "resources", ?lay.rsrc_sec, false, 0, resource_vsize::u64, resource_vsize);
        if (sel placed.err) { ret placed; }
        lay.resource_rva  = lay.rsrc_sec.rva;
        lay.resource_size = resource_vsize::u64;
    }

    if (lay.have_reloc) {
        val rsize:  usize          = measure_reloc_bytes(dyn, seg_secs);
        val placed: err[fail.Fail] = place_pe_section(lay, "base relocations", ?lay.reloc_sec, false, 0, rsize::u64, rsize);
        if (sel placed.err) { ret placed; }
        lay.basereloc_rva  = lay.reloc_sec.rva;
        lay.basereloc_size = rsize::u64;
    }

    val identified: err[fail.Fail] = place_pe_section(lay, "build id", ?lay.buildid_sec, false, 0,
        buildid.PE_BUILDID_SIZE::u64, buildid.PE_BUILDID_SIZE);
    if (sel identified.err) { ret identified; }

    var strtab_bytes: usize = 0;
    var sni:          u32   = 0;
    for (sni < seg_count) {
        val sn_has_data: bool = segs[sni].bytes != nil && segs[sni].filesz > 0;
        val sn:          str  = pe_segment_name(itn, segs, sni, sn_has_data, dyn);
        if (name_in_strtab(sn)) { strtab_bytes = strtab_bytes + str_len(sn) + 1; }
        sni = sni + 1;
    }

    var di: u32 = 0;
    for (di < debug_count) {
        val placed: err[fail.Fail] = place_pe_section(lay, "debug section", ?debug_secs[di], false, 0,
            debug[di].len::u64, debug[di].len::usize);
        if (sel placed.err) { ret placed; }
        val nm: str = bin.resolve_name(itn, debug[di].name);
        if (name_in_strtab(nm)) {
            val grown: res[usize, fail.Fail] = of_plan.sum(?lay.fp, "string table", strtab_bytes, str_len(nm) + 1);
            if (sel grown.err) { ret err[fail.Fail].err{grown.err}; }
            strtab_bytes = grown.ok;
        }
        di = di + 1;
    }
    if (strtab_bytes > 0) {
        val srow: res[u32, fail.Fail] = of_plan.place(?lay.fp, "string table", target_of.no_section(), 1, 4 + strtab_bytes);
        if (sel srow.err) { ret err[fail.Fail].err{srow.err}; }
        lay.strtab_row  = srow.ok;
        lay.strtab_off  = of_plan.offset(?lay.fp, lay.strtab_row);
        lay.strtab_size = of_plan.size(?lay.fp, lay.strtab_row);
    }

    val image_end: res[usize, fail.Fail] = of_plan.seal(?lay.rp);
    if (sel image_end.err) { ret err[fail.Fail].err{image_end.err}; }
    val image_size: res[u64, fail.Fail] = of_plan.align_address(?lay.rp, "image", image_end.ok::u64, SECTION_ALIGN);
    if (sel image_size.err) { ret err[fail.Fail].err{image_size.err}; }
    lay.image_size = image_size.ok;
    if (lay.image_size > of_plan.LIMIT_32::u64) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE image exceeds 32-bit header fields")}; }
    val total: res[usize, fail.Fail] = of_plan.seal(?lay.fp);
    if (sel total.err) { ret err[fail.Fail].err{total.err}; }
    lay.total_size = total.ok;
    ret err[fail.Fail].ok{};
}

fun validate_pe_layout(lay: *PeLayout, seg_count: u32) err[fail.Fail] {
    if (lay.sec_total > 65535) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE section count exceeds 65535")}; }
    if (lay.header_size::u64 > SECTION_ALIGN) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE headers exceed the reserved image page")};
    }
    ret err[fail.Fail].ok{};
}

fun image_emit(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    val alloc:           *A.Allocator            = img.alloc;
    val itn:             *intern.Interner        = img.interner;
    val isa_vt:          *target_of.ObjectTarget = img.target;
    val segs:            *target_of.LoadSegment  = img.segments;
    val seg_count:       u32                     = img.segment_count;
    val image_base:      u64                     = img.image_base;
    val entry:           u64                     = img.entry;
    val funcs:           *target_of.ExecFunction = img.functions;
    val func_count:      u32                     = img.function_count;
    val dyn:             *target_of.DynamicInfo  = img.dynamic;
    val exceptions:      *target_of.Section      = img.exceptions;
    val exception_count: u32                     = img.exception_count;
    val debug:           *target_of.Section      = img.debug;
    val debug_count:     u32                     = img.debug_count;

    val image_options: target_of.ImageOptions = img.options;

    if (row_for(isa_vt.arch_id) == nil) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_UNSUPPORTED, "PE emission is only implemented for x86-64")};
    }
    if (seg_count == 0) { ret err[fail.Fail].err{fail.message("no loadable segments")}; }

    if ((image_base & 0xFFFF) != 0) {
        ret err[fail.Fail].err{fail.message("PE image base is not 64 KiB-aligned")};
    }
    if (segs[0].vaddr < image_base
        || segs[0].vaddr - image_base < SECTION_ALIGN) {
        ret err[fail.Fail].err{fail.message("first segment precedes the PE header page")};
    }
    if (entry < image_base || entry - image_base > 0xFFFFFFFF) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE entry point exceeds the 32-bit RVA field")};
    }
    var vsi: u32 = 0;
    for (vsi < seg_count) {
        if (segs[vsi].vaddr < image_base || segs[vsi].vaddr - image_base > 0xFFFFFFFF
            || segs[vsi].filesz > 0xFFFFFFFF::usize
            || segs[vsi].memsz > 0xFFFFFFFF::usize
            || segs[vsi].memsz::u64 > 0xFFFFFFFFFFFFFFFF - segs[vsi].vaddr) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE load segment exceeds representable offsets or sizes")};
        }
        vsi = vsi + 1;
    }
    if (dyn != nil) {
        var bri: u32 = 0;
        for (bri < dyn.base_reloc_count) {
            if (dyn.base_relocs[bri].seg_index >= seg_count) {
                ret err[fail.Fail].err{fail.message("base relocation references an out-of-range segment")};
            }
            bri = bri + 1;
        }
    }

    val ssr: res[*PeSection, A.Error] = A.zallocate[PeSection](alloc, seg_count::usize);
    if (sel ssr.err) { ret err[fail.Fail].err{fail.message("segment layout alloc failed")}; }
    var seg_secs: *PeSection = ssr.ok;
    fin { A.deallocate[PeSection](alloc, seg_secs, seg_count::usize); }

    var debug_secs: *PeSection = nil;
    if (debug_count > 0) {
        val dsr: res[*PeSection, A.Error] = A.zallocate[PeSection](alloc, debug_count::usize);
        if (sel dsr.err) { ret err[fail.Fail].err{fail.message("debug layout alloc failed")}; }
        debug_secs = dsr.ok;
    }
    fin {
        if (debug_secs != nil) { A.deallocate[PeSection](alloc, debug_secs, debug_count::usize); }
    }

    val measured: res[PeUnwind, fail.Fail] = pe_unwind_measure(img);
    if (sel measured.err) { ret err[fail.Fail].err{measured.err}; }
    var unwind: PeUnwind = measured.ok;
    fin { pe_unwind_dnit(alloc, ?unwind); }
    val uw_all:      *FunctionUnwind = unwind.all;
    val uw_count:    u32             = unwind.count;
    val xdata_vsize: usize           = unwind.xdata_size;
    val pdata_vsize: usize           = unwind.pdata_size;

    if (dyn != nil && dyn.base_reloc_count > 0) {
        sort.sort_by[target_of.BaseReloc](dyn.base_relocs, dyn.base_reloc_count::usize, base_reloc_cmp);
    }

    var resource_image: rsrc.RsrcImage;
    var resource_ptr:   *rsrc.RsrcImage = nil;
    var resource_size:  usize           = 0;
    if (image_options.resources != nil) {
        val info: *target_of.ResourceInfo        = image_options.resources;
        val rr:   res[rsrc.RsrcImage, fail.Fail] = rsrc.build(alloc, info.icon, info.icon_len,
            info.app_manifest, info.app_manifest_len, info.version, info.internal_name,
            info.original_filename, info.product_name);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        resource_image = rr.ok;
        resource_ptr   = ?resource_image;
    }
    fin {
        if (resource_ptr != nil) { rsrc.dnit(alloc, resource_ptr); }
    }
    if (resource_ptr != nil) {
        val sr: res[usize, fail.Fail] = rsrc.size(resource_ptr);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        resource_size = sr.ok;
    }

    var lay:  PeLayout;
    val laid: err[fail.Fail] = compute_pe_layout(alloc, itn, ?lay, segs, seg_count, dyn, seg_secs,
        image_base, xdata_vsize, pdata_vsize,
        resource_size, debug, debug_count, debug_secs);
    if (sel laid.err) { ret laid; }
    fin { layout_dnit(?lay); }
    val total_size: usize = lay.total_size;

    val layout_r: err[fail.Fail] = validate_pe_layout(?lay, seg_count);
    if (sel layout_r.err) { ret layout_r; }

    val res_buf: res[*u8, fail.Fail] = of_destination.file_add(dst, "", total_size, 0o755);
    if (sel res_buf.err) { ret err[fail.Fail].err{res_buf.err}; }
    var buf: *u8 = res_buf.ok;

    var li: u32 = 0;
    for (li < seg_count) {
        if (segs[li].bytes != nil && segs[li].filesz > 0) {
            memory.raw_copy((buf::usize + seg_secs[li].content_file_off)::ptr,
                segs[li].bytes::ptr, segs[li].filesz);
        }
        li = li + 1;
    }

    var di: u32 = 0;
    for (di < debug_count) {
        if (debug[di].bytes != nil && debug[di].len > 0) {
            memory.raw_copy((buf::usize + debug_secs[di].file_off)::ptr, debug[di].bytes::ptr, debug[di].len::usize);
        }
        di = di + 1;
    }
    if (lay.strtab_row != of_plan.NO_ROW) {
        var str_pos: usize = 4;
        li = 0;
        for (li < seg_count) {
            val sn_has_data: bool = segs[li].bytes != nil && segs[li].filesz > 0;
            val sn:          str  = pe_segment_name(itn, segs, li, sn_has_data, dyn);
            if (name_in_strtab(sn)) { str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, sn); }
            li = li + 1;
        }
        di = 0;
        for (di < debug_count) {
            val nm: str = bin.resolve_name(itn, debug[di].name);
            if (name_in_strtab(nm)) { str_pos = str_pos + bin.write_str(buf, lay.strtab_off + str_pos, nm); }
            di = di + 1;
        }
        val strtab_closed: err[fail.Fail] = of_plan.close_size(?lay.fp, lay.strtab_row, str_pos);
        if (sel strtab_closed.err) { ret strtab_closed; }
        val strtab_field: res[u32, fail.Fail] = of_plan.field_u32(?lay.fp, lay.strtab_size, "string table size");
        if (sel strtab_field.err) { ret err[fail.Fail].err{strtab_field.err}; }
        bin.write_u32_le(buf, lay.strtab_off, strtab_field.ok);
    }

    if (lay.have_idata) {
        val imports_written: err[fail.Fail] = write_pe_imports(itn, buf, ?lay, dyn);
        if (sel imports_written.err) { ret imports_written; }
    }
    if (lay.have_stub) { write_pe_stubs(buf, ?lay, dyn); }
    if (lay.have_xdata || lay.have_pdata) {
        val unwind_written: err[fail.Fail] = write_pe_unwind(buf, ?lay, uw_all, uw_count, exceptions, exception_count, xdata_vsize, pdata_vsize);
        if (sel unwind_written.err) { ret unwind_written; }
    }
    if (lay.have_rsrc) {
        val er: res[usize, fail.Fail] = rsrc.emit(resource_ptr, buf, lay.rsrc_sec.file_off,
            lay.rsrc_sec.rva);
        if (sel er.err)             { ret err[fail.Fail].err{er.err}; }
        if (er.ok != resource_size) { ret err[fail.Fail].err{fail.message("resource size changed during emission")}; }
    }
    if (lay.have_reloc) {
        val reloc_end: usize = write_reloc_section(buf, lay.reloc_sec.file_off, dyn, seg_secs);
        if (reloc_end != lay.reloc_sec.file_off + lay.reloc_sec.vsize::usize) {
            ret err[fail.Fail].err{fail.message("base relocation section drifted from its plan")};
        }
    }

    val plt_r: err[fail.Fail] =
        patch_pe_fixups(buf, ?lay, dyn, segs, seg_count);
    if (sel plt_r.err) { ret plt_r; }
    val import_r: err[fail.Fail] = patch_pe_import_addr_fixups(buf, ?lay, dyn, segs, seg_count);
    if (sel import_r.err) { ret import_r; }

    write_pe_build_id_records(buf, ?lay);

    val pie:      bool           = dyn != nil && dyn.pie;
    val header_r: err[fail.Fail] = write_pe_headers(buf, ?lay, segs, seg_count, entry,
        pie, itn, dyn, debug, debug_count, image_options.subsystem,
        image_options.stack_reserve, image_options.stack_commit);
    if (sel header_r.err) { ret header_r; }

    val identified: err[fail.Fail] = seal_build_id(buf, total_size, ?lay);
    if (sel identified.err) { ret identified; }

    ret err[fail.Fail].ok{};
}

# the `.buildid` section: the debug directory entry, then the codeview record
# it names, whose guid seal_build_id fills once every other byte is final
fun write_pe_build_id_records(buf: *u8, lay: *PeLayout) {
    val off:        usize = lay.buildid_sec.file_off;
    val record_off: usize = off + buildid.PE_DEBUG_DIR_SIZE;
    val record_rva: u64   = lay.buildid_sec.rva + buildid.PE_DEBUG_DIR_SIZE::u64;
    buildid.write_pe_debug_directory(buf, off, record_rva::u32, record_off::u32);
    var zero: [16]u8;
    var k:    usize = 0;
    for (k < 16) {
        zero[k] = 0;
        k       = k + 1;
    }
    buildid.write_pe_codeview(buf, record_off, ?zero[0]);
}

# the build id is the sha-256 of the whole file with the guid as zero, shaped
# as a version 4 uuid
fun seal_build_id(buf: *u8, total: usize, lay: *PeLayout) err[fail.Fail] {
    val guid: usize = lay.buildid_sec.file_off + buildid.PE_DEBUG_DIR_SIZE + buildid.PE_CODEVIEW_GUID;
    if (guid + buildid.UUID_LEN > total) { ret err[fail.Fail].err{fail.message("build id record lies outside the image")}; }
    var k: usize = 0;
    for (k < buildid.UUID_LEN) {
        if (buf[guid + k] != 0) { ret err[fail.Fail].err{fail.message("build id guid was written before the image was sealed")}; }
        k = k + 1;
    }
    var digest: [32]u8;
    sha256.hash(buf, total, ?digest[0]);
    buildid.uuid_from_digest(?digest[0], (buf::usize + guid)::*u8);
    ret err[fail.Fail].ok{};
}

fun write_pe_imports(itn: *intern.Interner, buf: *u8, lay: *PeLayout, dyn: *target_of.DynamicInfo) err[fail.Fail] {
    val sec_off: usize = lay.idata_sec.file_off;
    val sec_rva: u64   = lay.idata_sec.rva;
    val dir_off: usize = lay.idata.dir_off;
    val ilt_off: usize = lay.idata.ilt_off;
    val iat_off: usize = lay.idata.iat_off;

    var hcur:     usize = lay.idata.hint_off;
    var thunk_ix: u32   = 0;
    var lib:      u32   = 0;
    for (lib < dyn.lib_count) {
        val first_thunk: u32 = thunk_ix;
        var imp:         u32 = 0;
        for (imp < dyn.import_count) {
            if (import_lib_of(dyn, imp) == lib) {
                var thunk: u64 = 0;
                if (dyn.imports[imp].by_ordinal) {
                    thunk = IMPORT_ORDINAL_FLAG64 | dyn.imports[imp].ordinal::u64;
                }
                or {
                    thunk = sec_rva + hcur::u64;
                    bin.write_u16_le(buf, sec_off + hcur, dyn.imports[imp].ordinal);
                    hcur = hcur + 2;
                    hcur = hcur + bin.write_str(buf, sec_off + hcur,
                        bin.resolve_name(itn, dyn.imports[imp].symbol));
                    hcur = hcur + (hcur & 1);
                }

                bin.write_u64_le(buf, sec_off + ilt_off + thunk_ix::usize * THUNK_SIZE, thunk);
                bin.write_u64_le(buf, sec_off + iat_off + thunk_ix::usize * THUNK_SIZE, thunk);
                thunk_ix = thunk_ix + 1;
            }
            imp = imp + 1;
        }
        bin.write_u64_le(buf, sec_off + ilt_off + thunk_ix::usize * THUNK_SIZE, 0);
        bin.write_u64_le(buf, sec_off + iat_off + thunk_ix::usize * THUNK_SIZE, 0);
        thunk_ix = thunk_ix + 1;

        val name_rva: u64 = sec_rva + hcur::u64;
        hcur = hcur + bin.write_str(buf, sec_off + hcur, bin.resolve_name(itn, dyn.libs[lib].soname));
        hcur = hcur + (hcur & 1);

        val d:       usize               = sec_off + dir_off + lib::usize * IMPORT_DESCRIPTOR_SIZE;
        val ilt_rva: res[u32, fail.Fail] = of_plan.field_u64_u32(?lay.fp, sec_rva + ilt_off::u64 + first_thunk::u64 * THUNK_SIZE::u64, "import lookup table RVA");
        if (sel ilt_rva.err) { ret err[fail.Fail].err{ilt_rva.err}; }
        val name_field: res[u32, fail.Fail] = of_plan.field_u64_u32(?lay.fp, name_rva, "import library name RVA");
        if (sel name_field.err) { ret err[fail.Fail].err{name_field.err}; }
        val iat_rva: res[u32, fail.Fail] = of_plan.field_u64_u32(?lay.fp, sec_rva + iat_off::u64 + first_thunk::u64 * THUNK_SIZE::u64, "import address table RVA");
        if (sel iat_rva.err) { ret err[fail.Fail].err{iat_rva.err}; }
        bin.write_u32_le(buf, d, ilt_rva.ok);
        bin.write_u32_le(buf, d + 4, 0);
        bin.write_u32_le(buf, d + 8, 0);
        bin.write_u32_le(buf, d + 12, name_field.ok);
        bin.write_u32_le(buf, d + 16, iat_rva.ok);
        lib = lib + 1;
    }
    if (thunk_ix::usize * THUNK_SIZE != iat_off - ilt_off) {
        ret err[fail.Fail].err{fail.message("import thunk table drifted from its plan")};
    }
    if (hcur != lay.idata.hint_off + lay.idata.hint_size) {
        ret err[fail.Fail].err{fail.message("import name table drifted from its plan")};
    }
    ret err[fail.Fail].ok{};
}

fun import_lib_of(dyn: *target_of.DynamicInfo, imp: u32) u32 {
    val li: u32 = dyn.imports[imp].lib_index;
    if (li != target_of.DYNLIB_ANY && li < dyn.lib_count) { ret li; }
    ret 0;
}

# the IAT slot of the n-th function import, in the order the thunks were written
fun iat_slot_rva(lay: *PeLayout, dyn: *target_of.DynamicInfo, ord: u32) u64 {
    val iat_off:  usize = lay.idata.iat_off;
    var thunk_ix: u32   = 0;
    var fn_ord:   u32   = 0;
    var lib:      u32   = 0;
    for (lib < dyn.lib_count) {
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (import_lib_of(dyn, imp) == lib) {
                if (dyn.imports[imp].is_func) {
                    if (fn_ord == ord) {
                        ret lay.idata_sec.rva + iat_off::u64
                            + thunk_ix::u64 * THUNK_SIZE::u64;
                    }
                    fn_ord = fn_ord + 1;
                }
                thunk_ix = thunk_ix + 1;
            }
            imp = imp + 1;
        }
        thunk_ix = thunk_ix + 1;
        lib      = lib + 1;
    }
    ret 0;
}

fun import_iat_slot_rva(lay: *PeLayout, dyn: *target_of.DynamicInfo,
    idx: u32) u64 {
    if (dyn == nil || idx >= dyn.import_count) { ret 0; }
    val iat_off:  usize = lay.idata.iat_off;
    var thunk_ix: u32   = 0;
    var lib:      u32   = 0;
    for (lib < dyn.lib_count) {
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (import_lib_of(dyn, imp) == lib) {
                if (imp == idx) {
                    ret lay.idata_sec.rva + iat_off::u64
                        + thunk_ix::u64 * THUNK_SIZE::u64;
                }
                thunk_ix = thunk_ix + 1;
            }
            imp = imp + 1;
        }
        thunk_ix = thunk_ix + 1;
        lib      = lib + 1;
    }
    ret 0;
}

# an imported function's place among the imported functions grouped by their
# library, the order the import address table and the call stubs follow;
# 0xFFFFFFFF for an import that is not a function
fun func_ordinal_by_library(dyn: *target_of.DynamicInfo, idx: u32) u32 {
    if (idx >= dyn.import_count)   { ret 0xFFFFFFFF; }
    if (!dyn.imports[idx].is_func) { ret 0xFFFFFFFF; }
    var ord: u32 = 0;
    var lib: u32 = 0;
    for (lib < dyn.lib_count) {
        var imp: u32 = 0;
        for (imp < dyn.import_count) {
            if (dyn.imports[imp].is_func && import_lib_of(dyn, imp) == lib) {
                if (imp == idx) { ret ord; }
                ord = ord + 1;
            }
            imp = imp + 1;
        }
        lib = lib + 1;
    }
    ret 0xFFFFFFFF;
}

fun write_pe_stubs(buf: *u8, lay: *PeLayout, dyn: *target_of.DynamicInfo) {
    var ord: u32 = 0;
    for (ord < lay.nimp) {
        val stub_off: usize = lay.stub_sec.file_off + ord::usize * IMPORT_STUB_SIZE;
        val stub_rva: u64   = lay.stub_sec.rva + ord::u64 * IMPORT_STUB_SIZE::u64;
        val iat_rva:  u64   = iat_slot_rva(lay, dyn, ord);
        buf[stub_off]     = 0xFF;
        buf[stub_off + 1] = 0x25;
        val next: u64 = stub_rva + IMPORT_STUB_SIZE::u64;
        bin.write_u32_le(buf, stub_off + 2, (iat_rva - next)::u32);
        ord = ord + 1;
    }
}

fun write_unwind_xdata(buf: *u8, lay: *PeLayout, uw: *FunctionUnwind) {
    val xoff: usize = lay.xdata_sec.file_off + (uw.xdata_rva - lay.xdata_sec.rva)::usize;
    buf[xoff]     = UNWIND_VERSION;
    buf[xoff + 1] = uw.prolog_size;
    buf[xoff + 2] = uw.slot_count::u8;
    buf[xoff + 3] = (uw.frame_reg & 0x0F) | ((uw.frame_off & 0x0F) << 4);

    var used: [32]bool;
    var i:    usize = 0;
    for (i < 32) {
        used[i] = false;
        i       = i + 1;
    }

    var slots_written: usize = 0;
    var codes_written: u32   = 0;
    for (codes_written < uw.code_count) {
        var best:     i32 = -1;
        var best_off: u8  = 0;
        var ci:       u32 = 0;
        # latest first, and of codes ending together the later one, so the
        # unwinder undoes them in the reverse of the prologue's order
        for (ci < uw.code_count) {
            if (!used[ci::usize]
                && (best < 0 || uw.codes[ci].end_off >= best_off)) {
                best     = ci::i32;
                best_off = uw.codes[ci].end_off;
            }
            ci = ci + 1;
        }
        if (best < 0) { brk; }
        val c:        *UnwindCode = ?uw.codes[best::u32];
        val slot_off: usize       = xoff + 4 + slots_written * 2;
        buf[slot_off]     = c.end_off;
        buf[slot_off + 1] = c.op | (c.info << 4);
        slots_written     = slots_written + 1;
        if (c.extra_slots >= 1) {
            bin.write_u16_le(buf, xoff + 4 + slots_written * 2, c.extra0);
            slots_written = slots_written + 1;
        }
        if (c.extra_slots >= 2) {
            bin.write_u16_le(buf, xoff + 4 + slots_written * 2, c.extra1);
            slots_written = slots_written + 1;
        }
        used[best::usize] = true;
        codes_written     = codes_written + 1;
    }
}

fun sort_runtime_functions(buf: *u8, off: usize, count: u32) {
    var i: u32 = 1;
    for (i < count) {
        val at: usize = off + i::usize * RUNTIME_FUNCTION_SIZE;
        val kb: u32   = bin.read_u32_le(buf, at);
        val ke: u32   = bin.read_u32_le(buf, at + 4);
        val ku: u32   = bin.read_u32_le(buf, at + 8);
        var j:  u32   = i;
        for (j > 0) {
            val prev: usize = off + (j - 1)::usize * RUNTIME_FUNCTION_SIZE;
            val pb:   u32   = bin.read_u32_le(buf, prev);
            val pe:   u32   = bin.read_u32_le(buf, prev + 4);
            val pu:   u32   = bin.read_u32_le(buf, prev + 8);
            if (pb < kb || (pb == kb && (pe < ke || (pe == ke && pu <= ku)))) { brk; }
            val dst: usize = off + j::usize * RUNTIME_FUNCTION_SIZE;
            bin.write_u32_le(buf, dst, pb);
            bin.write_u32_le(buf, dst + 4, pe);
            bin.write_u32_le(buf, dst + 8, pu);
            j = j - 1;
        }
        val dst: usize = off + j::usize * RUNTIME_FUNCTION_SIZE;
        bin.write_u32_le(buf, dst, kb);
        bin.write_u32_le(buf, dst + 4, ke);
        bin.write_u32_le(buf, dst + 8, ku);
        i = i + 1;
    }
}

fun write_pe_unwind(buf: *u8, lay: *PeLayout, uws: *FunctionUnwind, uw_count: u32,
    exceptions: *target_of.Section, exception_count: u32,
    xdata_vsize: usize, pdata_vsize: usize) err[fail.Fail] {
    if (!lay.have_pdata) { ret err[fail.Fail].ok{}; }

    var xcur: usize = 0;
    var i:    u32   = 0;
    for (i < uw_count) {
        uws[i].xdata_rva = lay.xdata_sec.rva + xcur::u64;
        write_unwind_xdata(buf, lay, ?uws[i]);
        xcur = xcur + uws[i].xdata_size;
        i    = i + 1;
    }

    var row: u32 = 0;
    var s:   u32 = 0;
    for (s < exception_count) {
        var src: usize = 0;
        for (src < exceptions[s].len::usize) {
            val poff: usize = lay.pdata_sec.file_off + row::usize * RUNTIME_FUNCTION_SIZE;
            bin.write_u32_le(buf, poff, bin.read_u32_le(exceptions[s].bytes, src));
            bin.write_u32_le(buf, poff + 4, bin.read_u32_le(exceptions[s].bytes, src + 4));
            bin.write_u32_le(buf, poff + 8, bin.read_u32_le(exceptions[s].bytes, src + 8));
            row = row + 1;
            src = src + RUNTIME_FUNCTION_SIZE;
        }
        s = s + 1;
    }

    i = 0;
    for (i < uw_count) {
        val poff:      usize = lay.pdata_sec.file_off + row::usize * RUNTIME_FUNCTION_SIZE;
        val seg_rva:   u64   = lay.seg_secs[uws[i].seg_index].content_rva;
        val begin_rva: u32   = (seg_rva + uws[i].seg_offset::u64)::u32;
        bin.write_u32_le(buf, poff, begin_rva);
        bin.write_u32_le(buf, poff + 4, begin_rva + uws[i].size);
        val xdata_field: res[u32, fail.Fail] = of_plan.field_u64_u32(?lay.fp, uws[i].xdata_rva, "unwind info RVA");
        if (sel xdata_field.err) { ret err[fail.Fail].err{xdata_field.err}; }
        bin.write_u32_le(buf, poff + 8, xdata_field.ok);
        row = row + 1;
        i   = i + 1;
    }
    if (xcur != xdata_vsize || row::usize * RUNTIME_FUNCTION_SIZE != pdata_vsize) {
        ret err[fail.Fail].err{fail.message("unwind tables drifted from their plan")};
    }
    sort_runtime_functions(buf, lay.pdata_sec.file_off, row);
    ret err[fail.Fail].ok{};
}

fun patch_pe_fixups(buf: *u8, lay: *PeLayout, dyn: *target_of.DynamicInfo, segs: *target_of.LoadSegment,
    seg_count: u32) err[fail.Fail] {
    if (dyn == nil || lay.nimp == 0) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < dyn.call_fixup_count) {
        val fx: *target_of.ImportFixup = ?dyn.call_fixups[i];
        if (fx.seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup references an out-of-range segment")};
        }
        val ord: u32 = func_ordinal_by_library(dyn, fx.import_index);
        if (ord == 0xFFFFFFFF) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup targets a non-function import")};
        }
        if (fx.seg_offset::usize + 4 > segs[fx.seg_index].filesz) {
            ret err[fail.Fail].err{fail.message("dynamic call-site fixup offset out of range")};
        }

        val stub_va: u64 = lay.image_base + lay.stub_sec.rva
            + ord::u64 * IMPORT_STUB_SIZE::u64;
        val disp_r: res[i64, fail.Fail] =
            rel32_disp(stub_va, fx.addend, fx.patch_vaddr);
        if (sel disp_r.err) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "dynamic call-site displacement overflows 32 bits")};
        }
        val disp: i64 = disp_r.ok;

        val file_off: usize = lay.seg_secs[fx.seg_index].content_file_off + fx.seg_offset::usize;
        bin.write_u32_le(buf, file_off, (disp::u64)::u32);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun rel32_disp(target_va: u64, addend: i64,
    patch_va: u64) res[i64, fail.Fail] {
    val i64_max: i64 = 9223372036854775807;
    val i64_min: i64 = -9223372036854775807 - 1;
    if (target_va > i64_max::u64 || patch_va > i64_max::u64) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "PE rel32 address exceeds the signed range")};
    }
    val delta: i64 = target_va::i64 - patch_va::i64;
    if ((addend > 0 && delta > i64_max - addend)
        || (addend < 0 && delta < i64_min - addend)) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "PE rel32 signed arithmetic overflow")};
    }
    val disp: i64 = delta + addend;
    if (disp > 2147483647 || disp < -2147483648) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "PE rel32 displacement overflows 32 bits")};
    }
    ret res[i64, fail.Fail].ok{disp};
}

fun patch_pe_import_addr_fixups(buf: *u8, lay: *PeLayout, dyn: *target_of.DynamicInfo,
    segs: *target_of.LoadSegment,
    seg_count: u32) err[fail.Fail] {
    if (dyn == nil || dyn.import_addr_fixup_count == 0) {
        ret err[fail.Fail].ok{};
    }
    if (dyn.import_addr_fixups == nil) {
        ret err[fail.Fail].err{fail.message("nil import-address fixup array")};
    }
    var i: u32 = 0;
    for (i < dyn.import_addr_fixup_count) {
        val fx: *target_of.ImportFixup = ?dyn.import_addr_fixups[i];
        if (fx.kind != target_of.RK_PC32) {
            ret err[fail.Fail].err{target_of.reloc_refusal(fx.origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, "unsupported import-address relocation kind")};
        }
        if (fx.import_index >= dyn.import_count) {
            ret err[fail.Fail].err{fail.message("import-address fixup targets an out-of-range import")};
        }
        if (fx.seg_index >= seg_count) {
            ret err[fail.Fail].err{fail.message("import-address fixup references an out-of-range segment")};
        }
        if (fx.seg_offset::usize + 4 > segs[fx.seg_index].filesz) {
            ret err[fail.Fail].err{fail.message("import-address fixup offset out of range")};
        }

        val slot_rva: u64 = import_iat_slot_rva(lay, dyn, fx.import_index);
        if (slot_rva == 0 || lay.image_base > 0xFFFFFFFFFFFFFFFF - slot_rva) {
            ret err[fail.Fail].err{fail.message("import-address fixup has no valid IAT slot")};
        }
        val disp_r: res[i64, fail.Fail] =
            rel32_disp(lay.image_base + slot_rva, fx.addend, fx.patch_vaddr);
        if (sel disp_r.err) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_RELOCATION_OVERFLOW, "import-address displacement overflows 32 bits")};
        }

        val file_off: usize = lay.seg_secs[fx.seg_index].content_file_off
            + fx.seg_offset::usize;
        bin.write_u32_le(buf, file_off,
            (disp_r.ok::u64)::u32);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun write_section_name_field(buf: *u8, pos: usize, name: str, str_pos: *usize) {
    if (name_in_strtab(name)) {
        memory.raw_zero((buf::usize + pos)::ptr, 8);
        buf[pos] = '/';
        write_decimal(buf, pos + 1, 7, (@str_pos)::u32);
        @str_pos = @str_pos + str_len(name) + 1;
    }
    or {
        write_inline_name(buf, pos, name);
    }
}

fun write_pe_section_header(buf: *u8, pos: usize, name: str, str_pos: *usize, sec: *PeSection, chars: u32) {
    write_section_name_field(buf, pos, name, str_pos);
    bin.write_u32_le(buf, pos + 8, sec.vsize::u32);
    bin.write_u32_le(buf, pos + 12, sec.rva::u32);
    bin.write_u32_le(buf, pos + 16, sec.file_size::u32);
    if (sec.file_size > 0) { bin.write_u32_le(buf, pos + 20, sec.file_off::u32); }
    or                     { bin.write_u32_le(buf, pos + 20, 0); }
    bin.write_u32_le(buf, pos + 24, 0);
    bin.write_u32_le(buf, pos + 28, 0);
    bin.write_u16_le(buf, pos + 32, 0);
    bin.write_u16_le(buf, pos + 34, 0);
    bin.write_u32_le(buf, pos + 36, chars);
}

val DEFAULT_STACK_RESERVE: u64 = 0x800000;
val DEFAULT_STACK_COMMIT:  u64 = 0x1000;

fun write_pe_headers(buf: *u8, lay: *PeLayout, segs: *target_of.LoadSegment, seg_count: u32, entry: u64, pie: bool,
    itn: *intern.Interner, dyn: *target_of.DynamicInfo, debug: *target_of.Section, debug_count: u32,
    subsystem: catalog_subsystem.Subsystem, stack_reserve: u64, stack_commit: u64) err[fail.Fail] {
    buf[0] = 'M';
    buf[1] = 'Z';
    val pe_off: usize = DOS_HEADER_SIZE;
    bin.write_u32_le(buf, 0x3C, pe_off::u32);

    buf[pe_off]     = 'P';
    buf[pe_off + 1] = 'E';
    buf[pe_off + 2] = 0;
    buf[pe_off + 3] = 0;

    val ch:   usize               = pe_off + SIGNATURE_SIZE;
    val nsec: res[u16, fail.Fail] = of_plan.field_u16(?lay.fp, lay.sec_total::usize, "NumberOfSections");
    if (sel nsec.err) { ret err[fail.Fail].err{nsec.err}; }
    val symtab_ptr: res[u32, fail.Fail] = of_plan.field_u32(?lay.fp, lay.strtab_off, "PointerToSymbolTable");
    if (sel symtab_ptr.err) { ret err[fail.Fail].err{symtab_ptr.err}; }
    bin.write_u16_le(buf, ch, IMAGE_FILE_MACHINE_AMD64);
    bin.write_u16_le(buf, ch + 2, nsec.ok);
    bin.write_u32_le(buf, ch + 4, 0);
    bin.write_u32_le(buf, ch + 8, symtab_ptr.ok);
    bin.write_u32_le(buf, ch + 12, 0);
    bin.write_u16_le(buf, ch + 16, OPTIONAL_HEADER_SIZE::u16);
    var characteristics: u16 = IMAGE_FILE_EXECUTABLE_IMAGE | IMAGE_FILE_LARGE_ADDRESS_AWARE
        | IMAGE_FILE_LINE_NUMS_STRIPPED | IMAGE_FILE_LOCAL_SYMS_STRIPPED;
    if (!pie) { characteristics = characteristics | IMAGE_FILE_RELOCS_STRIPPED; }
    bin.write_u16_le(buf, ch + 18, characteristics);

    val oh: usize = ch + HEADER_SIZE;
    bin.write_u16_le(buf, oh, PE32PLUS_MAGIC);
    buf[oh + 2] = 14;
    buf[oh + 3] = 0;

    bin.write_u32_le(buf, oh + 16, (entry - lay.image_base)::u32);
    bin.write_u32_le(buf, oh + 20, lay.seg_secs[0].rva::u32);

    bin.write_u64_le(buf, oh + 24, lay.image_base);
    bin.write_u32_le(buf, oh + 32, SECTION_ALIGN::u32);
    bin.write_u32_le(buf, oh + 36, FILE_ALIGN::u32);

    bin.write_u16_le(buf, oh + 40, 6);
    bin.write_u16_le(buf, oh + 42, 0);
    bin.write_u16_le(buf, oh + 44, 0);
    bin.write_u16_le(buf, oh + 46, 0);
    bin.write_u16_le(buf, oh + 48, 6);
    bin.write_u16_le(buf, oh + 50, 0);
    bin.write_u32_le(buf, oh + 52, 0);

    val image_field: res[u32, fail.Fail] = of_plan.field_u64_u32(?lay.fp, lay.image_size, "SizeOfImage");
    if (sel image_field.err) { ret err[fail.Fail].err{image_field.err}; }
    val headers_field: res[u32, fail.Fail] = of_plan.field_u32(?lay.fp, lay.header_size, "SizeOfHeaders");
    if (sel headers_field.err) { ret err[fail.Fail].err{headers_field.err}; }
    bin.write_u32_le(buf, oh + 56, image_field.ok);
    bin.write_u32_le(buf, oh + 60, headers_field.ok);
    bin.write_u32_le(buf, oh + 64, 0);

    var subsys: u16 = IMAGE_SUBSYSTEM_WINDOWS_CUI;
    if (subsystem == catalog_subsystem.GUI) { subsys = IMAGE_SUBSYSTEM_WINDOWS_GUI; }
    bin.write_u16_le(buf, oh + 68, subsys);
    var dllchars: u16 = IMAGE_DLLCHARACTERISTICS_NX_COMPAT;
    if (pie) { dllchars = dllchars | IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE; }
    bin.write_u16_le(buf, oh + 70, dllchars);

    var stack_res: u64 = DEFAULT_STACK_RESERVE;
    var stack_com: u64 = DEFAULT_STACK_COMMIT;
    if (stack_reserve != 0) { stack_res = stack_reserve; }
    if (stack_commit != 0)  { stack_com = stack_commit; }
    bin.write_u64_le(buf, oh + 72, stack_res);
    bin.write_u64_le(buf, oh + 80, stack_com);
    bin.write_u64_le(buf, oh + 88, DEFAULT_STACK_RESERVE);
    bin.write_u64_le(buf, oh + 96, DEFAULT_STACK_COMMIT);
    bin.write_u32_le(buf, oh + 104, 0);
    bin.write_u32_le(buf, oh + 108, IMAGE_NUMBEROF_DIRECTORY_ENTRIES);

    val dd: usize = oh + 112;
    if (lay.have_idata) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IMPORT::usize * DATA_DIR_SIZE, lay.import_dir_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IMPORT::usize * DATA_DIR_SIZE + 4, lay.import_dir_size::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IAT::usize * DATA_DIR_SIZE, lay.iat_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_IAT::usize * DATA_DIR_SIZE + 4, lay.iat_size::u32);
    }
    if (lay.have_rsrc) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_RESOURCE::usize * DATA_DIR_SIZE, lay.resource_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_RESOURCE::usize * DATA_DIR_SIZE + 4, lay.resource_size::u32);
    }
    if (lay.have_pdata) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE, lay.exception_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_EXCEPTION::usize * DATA_DIR_SIZE + 4, lay.exception_size::u32);
    }
    if (lay.have_reloc) {
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_BASERELOC::usize * DATA_DIR_SIZE, lay.basereloc_rva::u32);
        bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_BASERELOC::usize * DATA_DIR_SIZE + 4, lay.basereloc_size::u32);
    }
    bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_DEBUG::usize * DATA_DIR_SIZE, lay.buildid_sec.rva::u32);
    bin.write_u32_le(buf, dd + IMAGE_DIRECTORY_ENTRY_DEBUG::usize * DATA_DIR_SIZE + 4, buildid.PE_DEBUG_DIR_SIZE::u32);

    val sec_table: usize = oh + OPTIONAL_HEADER_SIZE;
    var pos:       usize = sec_table;
    var str_pos:   usize = 4;
    var li:        u32   = 0;
    for (li < seg_count) {
        val has_data: bool = segs[li].bytes != nil && segs[li].filesz > 0;
        write_pe_section_header(buf, pos, pe_segment_name(itn, segs, li, has_data, dyn),
            ?str_pos, ?lay.seg_secs[li], section_flags(segs[li].flags, has_data));
        pos = pos + SECTION_HEADER_SIZE;
        li  = li + 1;
    }
    if (lay.have_rsrc) {
        write_pe_section_header(buf, pos, ".rsrc", ?str_pos, ?lay.rsrc_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
        pos = pos + SECTION_HEADER_SIZE;
    }
    if (lay.have_reloc) {
        write_pe_section_header(buf, pos, ".reloc", ?str_pos, ?lay.reloc_sec,
            IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_DISCARDABLE);
        pos = pos + SECTION_HEADER_SIZE;
    }
    write_pe_section_header(buf, pos, buildid.PE_BUILDID_SECTION, ?str_pos, ?lay.buildid_sec,
        IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
    pos = pos + SECTION_HEADER_SIZE;

    var di: u32 = 0;
    for (di < debug_count) {
        val nm: str = bin.resolve_name(itn, debug[di].name);
        write_section_name_field(buf, pos, nm, ?str_pos);
        bin.write_u32_le(buf, pos + 8, lay.debug_secs[di].vsize::u32);
        bin.write_u32_le(buf, pos + 12, lay.debug_secs[di].rva::u32);
        bin.write_u32_le(buf, pos + 16, lay.debug_secs[di].file_size::u32);
        if (lay.debug_secs[di].file_size > 0) { bin.write_u32_le(buf, pos + 20, lay.debug_secs[di].file_off::u32); }
        or                                    { bin.write_u32_le(buf, pos + 20, 0); }
        bin.write_u32_le(buf, pos + 24, 0);
        bin.write_u32_le(buf, pos + 28, 0);
        bin.write_u16_le(buf, pos + 32, 0);
        bin.write_u16_le(buf, pos + 34, 0);
        bin.write_u32_le(buf, pos + 36, IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_DISCARDABLE);
        pos = pos + SECTION_HEADER_SIZE;
        di  = di + 1;
    }

    if (pos != sec_table + lay.sec_total::usize * SECTION_HEADER_SIZE) {
        ret err[fail.Fail].err{fail.message("PE section table drifted from its plan")};
    }
    if (lay.strtab_row != of_plan.NO_ROW && str_pos != lay.strtab_size) {
        ret err[fail.Fail].err{fail.message("PE section names drifted from their plan")};
    }
    if (lay.strtab_row == of_plan.NO_ROW && str_pos != 4) {
        ret err[fail.Fail].err{fail.message("PE section names drifted from their plan")};
    }
    var code_size:  u64 = 0;
    var idata_size: u64 = 0;
    var udata_size: u64 = 0;
    sum_pe_section_content(buf, sec_table, lay.sec_total, ?code_size, ?idata_size, ?udata_size);
    if (code_size > 0xFFFFFFFF || idata_size > 0xFFFFFFFF || udata_size > 0xFFFFFFFF) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "PE aggregate section sizes exceed 32-bit header fields")};
    }
    bin.write_u32_le(buf, oh + 4, code_size::u32);
    bin.write_u32_le(buf, oh + 8, idata_size::u32);
    bin.write_u32_le(buf, oh + 12, udata_size::u32);

    ret err[fail.Fail].ok{};
}

fun sum_pe_section_content(buf: *u8, sec_table: usize, nsec: u32,
    code: *u64, idata: *u64, udata: *u64) {
    @code  = 0;
    @idata = 0;
    @udata = 0;
    var s: u32 = 0;
    for (s < nsec) {
        val sh:    usize = sec_table + s::usize * SECTION_HEADER_SIZE;
        val chars: u32   = bin.read_u32_le(buf, sh + 36);
        val raw:   u64   = bin.read_u32_le(buf, sh + 16)::u64;
        val vsize: u64   = bin.read_u32_le(buf, sh + 8)::u64;
        if ((chars & IMAGE_SCN_CNT_CODE) != 0)               { @code = @code + raw; }
        if ((chars & IMAGE_SCN_CNT_INITIALIZED_DATA) != 0)   { @idata = @idata + raw; }
        if ((chars & IMAGE_SCN_CNT_UNINITIALIZED_DATA) != 0) { @udata = @udata + vsize; }
        s = s + 1;
    }
}

fun seg_is_rebased(dyn: *target_of.DynamicInfo, ls: u32) bool {
    if (dyn == nil) { ret false; }
    var i: u32 = 0;
    for (i < dyn.base_reloc_count) {
        if (dyn.base_relocs[i].seg_index == ls) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun seg_is_relro(dyn: *target_of.DynamicInfo, segs: *target_of.LoadSegment, ls: u32) bool {
    if ((segs[ls].flags & (target_of.SEG_FLAG_WRITE | target_of.SEG_FLAG_EXECUTE)) != 0) { ret false; }
    ret seg_is_rebased(dyn, ls);
}

val NO_TABLE_SEGMENT: u32 = 0xFFFFFFFF;

# the PE tables the linker lays out in sections of their own after the image,
# in the order the loader's tools expect them
val STUBS_TABLE:       str = ".itext";
val IMPORTS_TABLE:     str = ".idata";
val UNWIND_DATA_TABLE: str = ".xdata";
val EXCEPTION_TABLE:   str = ".pdata";

# the segment the linker laid out for the table `name` of `size` bytes,
# NO_TABLE_SEGMENT when it laid out none
fun table_segment(itn: *intern.Interner, segs: *target_of.LoadSegment, seg_count: u32, name: str, size: usize) u32 {
    var i: u32 = 0;
    for (i < seg_count) {
        if (segs[i].table && segs[i].section_count == 1 && segs[i].filesz == size
            && str_equals(bin.resolve_name(itn, segs[i].sections[0].name), name)) {
            ret i;
        }
        i = i + 1;
    }
    ret NO_TABLE_SEGMENT;
}

# a segment's section name: a reserved table's own, and otherwise the name its
# protection gives it
fun pe_segment_name(itn: *intern.Interner, segs: *target_of.LoadSegment, li: u32, has_data: bool, dyn: *target_of.DynamicInfo) str {
    if (segs[li].table && segs[li].section_count == 1) { ret bin.resolve_name(itn, segs[li].sections[0].name); }
    ret segment_name(segs[li].flags, has_data, seg_is_relro(dyn, segs, li));
}

fun segment_name(flags: u32, has_data: bool, relro: bool) str {
    if ((flags & target_of.SEG_FLAG_EXECUTE) != 0) { ret ".text"; }
    if (!has_data)                                 { ret ".bss"; }
    if ((flags & target_of.SEG_FLAG_WRITE) != 0)   { ret ".data"; }
    if (relro)                                     { ret ".data.rel.ro"; }
    ret ".rdata";
}

fun executable_section_location(image_base: u64, content_vaddr: u64,
    segment_index: u32) target_of.ExecutableSectionLocation {
    var loc: target_of.ExecutableSectionLocation;
    loc.vaddr = content_vaddr;
    if (segment_index == 0) { loc.vaddr = image_base + SECTION_ALIGN; }
    loc.ordinal = segment_index + 1;
    ret loc;
}

val COVERS_ISAS: [1]u32 = [1]u32{catalog_arch.X86_64};

# a relocatable object, or a short import object, for the instruction set
fun object_matches(bytes: *u8, len: usize, arch_id: u32) bool {
    if (bytes == nil || len < 4) { ret false; }
    val want: u16 = machine_for_arch(arch_id);
    if (want == 0) { ret false; }
    val sig1: u16 = bin.read_u16_le(bytes, 0);
    if (sig1 == 0) { ret len >= 8 && bin.read_u16_le(bytes, 6) == want; }
    ret sig1 == want;
}

fun shared_names(path: *u8) bool {
    ret target_of.path_has_suffix(path, ".dll", true);
}

# a DLL for the instruction set, which the loader finds by its file name
fun shared_identity(bytes: *u8, len: usize, arch_id: u32, path: *u8, out: *u8, cap: usize) bool {
    if (!looks_like_dll(bytes, len, machine_for_arch(arch_id))) { ret false; }
    val base: str   = types_path.filename(path::str);
    val bl:   usize = str_len(base);
    out[0] = 0;
    if (bl + 1 <= cap) {
        var i: usize = 0;
        for (i <= bl) {
            out[i] = base[i];
            i      = i + 1;
        }
    }
    ret true;
}

val STATIC_SUFFIXES: [4]str = [4]str{"o", "obj", "a", "lib"};

val SHARED_NAMING: target_of.SharedNaming = target_of.SharedNaming{
    noun:     "a Windows DLL",
    loadable: "PE DLL",
    requires: "a PE/COFF target",
    prefix:   "",
    names:    shared_names,
    identity: shared_identity,
    absent:   target_of.ABSENT_BY_NAME,
};

val INPUT_NAMING: target_of.InputNaming = target_of.InputNaming{
    library_prefix:      "lib",
    static_suffixes:     ?STATIC_SUFFIXES[0],
    static_suffix_count: 4,
    folds_case:          true,
    object_matches:      object_matches,
    shared:              ?SHARED_NAMING,
};

# the tables a PE image keeps in sections of their own after its segments: the
# import stubs, one jump through the import address table each, the import
# directory with that table inside it, and the unwind data and exception
# table the platform unwinder reads
fun segment_tables(img: *target_of.LinkedImage, tables: *target_of.TableList) err[fail.Fail] {
    val dyn:   *target_of.DynamicInfo = img.dynamic;
    val stubs: err[fail.Fail]         = target_of.table_add(tables, target_of.TableShape{name: STUBS_TABLE,
        size:      target_of.func_import_count(dyn)::usize * IMPORT_STUB_SIZE, align: 16,
        placement: target_of.TABLE_OWN_SEGMENT, flags: target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE});
    if (sel stubs.err) { ret stubs; }
    if (dyn != nil && (dyn.lib_count > 0 || dyn.import_count > 0)) {
        var dir:     ImportDirLayout;
        val planned: err[fail.Fail] = plan_import_directory(img.alloc, img.interner, dyn, ?dir);
        if (sel planned.err) { ret planned; }
        val imports: err[fail.Fail] = target_of.table_add(tables, target_of.TableShape{name: IMPORTS_TABLE, size: dir.vsize,
            align: 8, placement: target_of.TABLE_OWN_SEGMENT, flags: target_of.SEG_FLAG_READ | target_of.SEG_FLAG_WRITE});
        if (sel imports.err) { ret imports; }
    }
    val measured: res[PeUnwind, fail.Fail] = pe_unwind_measure(img);
    if (sel measured.err) { ret err[fail.Fail].err{measured.err}; }
    var unwind: PeUnwind = measured.ok;
    fin { pe_unwind_dnit(img.alloc, ?unwind); }
    val xdata: err[fail.Fail] = target_of.table_add(tables, target_of.TableShape{name: UNWIND_DATA_TABLE, size: unwind.xdata_size,
        align: 4, placement: target_of.TABLE_OWN_SEGMENT, flags: target_of.SEG_FLAG_READ});
    if (sel xdata.err) { ret xdata; }
    ret target_of.table_add(tables, target_of.TableShape{name: EXCEPTION_TABLE, size: unwind.pdata_size, align: 4,
        placement: target_of.TABLE_OWN_SEGMENT, flags: target_of.SEG_FLAG_READ});
}

pub val VTABLE: target_of.OfVTable = target_of.OfVTable{
    id:                  target_of.COFF,
    fingerprint_tag:     3,
    name:                mink_format.COFF.name,
    links_from_image:    true,
    object_suffix:       ".o",
    object_emit:         object_emit,
    parse_object:        parse_object,
    image_emit:          image_emit,
    writes_dynamic:      true,
    segment_tables:      segment_tables,
    two_level_namespace: true,
    default_debug:       "dwarf",
    # a PE image maps its debug sections at addresses, so an offset into one is section-relative
    debug_offset_kind:           target_of.RK_SECREL32,
    shared_input_ext:            ".dll",
    import_address_prefix:       "__imp_",
    header_in_first_segment:     false,
    maps_by_page:                true,
    carries_stack_size:          true,
    carries_record:              true,
    carries_subsystem:           true,
    carries_resources:           true,
    epilogue_by_code:            true,
    default_stack_reserve:       DEFAULT_STACK_RESERVE,
    executable_section_location: executable_section_location,
    covers_isas:                 ?COVERS_ISAS[0],
    covers_isa_count:            1,
    inputs:                      ?INPUT_NAMING,
};
