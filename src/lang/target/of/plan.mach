use mach.lang.fail;
use mach.lang.growth;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use lang_checked:    mach.lang.checked;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use target_of: mach.lang.target.of;

# the one file layout every object writer sizes and serializes from
#
# a plan is an ordered list of regions. a writer places every region it will
# write, seals the plan, allocates exactly the sealed total, and then writes
# each region at the offset the plan recorded; nothing after sealing recomputes
# an offset. placement is checked: an alignment that is zero or not a power of
# two, an offset or size that overflows, or a result past the format's field
# width is refused with a message naming the region, before any buffer exists.
# a region written through a running cursor is closed with `close`, which
# refuses when the cursor did not land on the region's planned end, so a
# measure/write pair that drifts apart is a refusal, never a corrupt file.

rec FileUnit {}

rec Region {
    label:   str;
    section: target_of.SectionId;
    align:   usize;
    offset:  usize;
    size:    usize;
}

pub rec FilePlan {
    alloc:  *A.Allocator;
    itn:    *intern.Interner;
    format: str;
    rows:   *Region;
    count:  u32;
    cap:    u32;
    end:    usize;
    limit:  usize;
    sealed: bool;
    total:  usize;
}

pub val NO_ROW: u32 = 0xFFFFFFFF;

pub val LIMIT_32: usize = 0xFFFFFFFF;

pub fun limit_64() usize {
    ret ~(0::usize);
}

val ROW_CAP_FIRST: u32 = 16;

# the text of a refused region, interned when the plan holds an interner so
# it outlives the writer's storage, else owned by the plan's allocator
fun message(p: *FilePlan, what: str, label: str, value: u64, bound: u64) res[str, fail.Fail] {
    if (p.itn == nil) { ret fail.format(p.alloc, "{}: the `{}` region {} ({} against {})", p.format, label, what, value, bound); }
    ret fail.format_intern(p.itn, p.alloc, "{}: the `{}` region {} ({} against {})", p.format, label, what, value, bound);
}

# a refused region the writer itself planned: a compiler defect
fun defect(p: *FilePlan, what: str, label: str, value: u64, bound: u64) fail.Fail {
    ret fail.message_of(message(p, what, label, value, bound));
}

# a region the input made too large for the format's fields
fun too_large(p: *FilePlan, what: str, label: str, value: u64, bound: u64) fail.Fail {
    ret fail.user_of(diagnostic_kind.LINK_SIZE_LIMIT, message(p, what, label, value, bound));
}

pub fun init(alloc: *A.Allocator, itn: *intern.Interner, format: str, limit: usize) res[FilePlan, fail.Fail] {
    var p: FilePlan;
    p.alloc  = alloc;
    p.itn    = itn;
    p.format = format;
    p.rows   = nil;
    p.count  = 0;
    p.cap    = 0;
    p.end    = 0;
    p.limit  = limit;
    p.sealed = false;
    p.total  = 0;
    if (alloc == nil) { ret res[FilePlan, fail.Fail].err{fail.message("object writer: a file plan needs an allocator")}; }
    val made: res[*Region, A.Error] = A.zallocate[Region](alloc, ROW_CAP_FIRST::usize);
    if (sel made.err) { ret res[FilePlan, fail.Fail].err{fail.message("object writer: file plan alloc failed")}; }
    p.rows = made.ok;
    p.cap  = ROW_CAP_FIRST;
    ret res[FilePlan, fail.Fail].ok{p};
}

pub fun dnit(p: *FilePlan) {
    if (p.rows != nil) { A.deallocate[Region](p.alloc, p.rows, p.cap::usize); }
    p.rows  = nil;
    p.count = 0;
    p.cap   = 0;
}

fun push(p: *FilePlan, label: str, section: target_of.SectionId, align: usize, offset: usize, size: usize) res[u32, fail.Fail] {
    val grown: err[A.Error] = growth.reserve[Region](p.alloc, ?p.rows, ?p.cap, p.count::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    val row: u32 = p.count;
    p.rows[row].label   = label;
    p.rows[row].section = section;
    p.rows[row].align   = align;
    p.rows[row].offset  = offset;
    p.rows[row].size    = size;
    p.count             = row + 1;
    p.end               = offset + size;
    ret res[u32, fail.Fail].ok{row};
}

fun fits(p: *FilePlan, label: str, offset: usize, size: usize) res[usize, fail.Fail] {
    val summed: res[usize, lang_checked.Cause] = lang_checked.usize_add(offset, size);
    if (sel summed.err) {
        ret res[usize, fail.Fail].err{defect(p, "overflows the file offset", label, offset::u64, size::u64)};
    }
    val end: usize = summed.ok;
    if (offset > p.limit || size > p.limit || end > p.limit) {
        ret res[usize, fail.Fail].err{too_large(p, "does not fit the format's field width", label, end::u64, p.limit::u64)};
    }
    ret res[usize, fail.Fail].ok{end};
}

# place a region at the next offset that satisfies `align`
pub fun place(p: *FilePlan, label: str, section: target_of.SectionId, align: usize, size: usize) res[u32, fail.Fail] {
    if (p.sealed) { ret res[u32, fail.Fail].err{fail.message("object writer: a sealed file plan cannot place a region")}; }
    val checked_align: res[lang_checked.PowerAlignment[FileUnit], lang_checked.Cause] =
        lang_checked.power_alignment[FileUnit](align);
    if (sel checked_align.err) {
        ret res[u32, fail.Fail].err{defect(p, "has an alignment that is not a power of two", label, align::u64, 0)};
    }
    val general: res[lang_checked.Alignment[FileUnit], lang_checked.Cause] =
        lang_checked.alignment[FileUnit](align);
    if (sel general.err) {
        ret res[u32, fail.Fail].err{defect(p, "has an alignment that is not a power of two", label, align::u64, 0)};
    }
    val aligned: res[lang_checked.Offset[FileUnit], lang_checked.Cause] =
        lang_checked.align_offset_up[FileUnit](lang_checked.offset[FileUnit](p.end),
        general.ok);
    if (sel aligned.err) {
        ret res[u32, fail.Fail].err{defect(p, "overflows the file offset", label, p.end::u64, align::u64)};
    }
    val offset: usize                 = aligned.ok.value;
    val end:    res[usize, fail.Fail] = fits(p, label, offset, size);
    if (sel end.err) { ret res[u32, fail.Fail].err{end.err}; }
    ret push(p, label, section, align, offset, size);
}

# place a region whose offset is dictated; it must not overlap what came before
pub fun place_at(p: *FilePlan, label: str, section: target_of.SectionId, offset: usize, size: usize) res[u32, fail.Fail] {
    if (p.sealed) { ret res[u32, fail.Fail].err{fail.message("object writer: a sealed file plan cannot place a region")}; }
    if (offset < p.end) {
        ret res[u32, fail.Fail].err{defect(p, "starts before the regions placed ahead of it end", label, offset::u64, p.end::u64)};
    }
    val end: res[usize, fail.Fail] = fits(p, label, offset, size);
    if (sel end.err) { ret res[u32, fail.Fail].err{end.err}; }
    ret push(p, label, section, 1, offset, size);
}

# advance the cursor to a dictated offset without placing a region
pub fun pad_to(p: *FilePlan, label: str, offset: usize) err[fail.Fail] {
    if (p.sealed) { ret err[fail.Fail].err{fail.message("object writer: a sealed file plan cannot pad")}; }
    if (offset < p.end) {
        ret err[fail.Fail].err{defect(p, "starts before the regions placed ahead of it end", label, offset::u64, p.end::u64)};
    }
    if (offset > p.limit) {
        ret err[fail.Fail].err{too_large(p, "does not fit the format's field width", label, offset::u64, p.limit::u64)};
    }
    p.end = offset;
    ret err[fail.Fail].ok{};
}

# advance the cursor to `align` without placing a region; the gap is padding
pub fun pad(p: *FilePlan, label: str, align: usize) err[fail.Fail] {
    if (p.sealed) { ret err[fail.Fail].err{fail.message("object writer: a sealed file plan cannot pad")}; }
    val placed: res[u32, fail.Fail] = place(p, label, target_of.no_section(), align, 0);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    p.count = p.count - 1;
    ret err[fail.Fail].ok{};
}

pub fun seal(p: *FilePlan) res[usize, fail.Fail] {
    if (p.sealed) { ret res[usize, fail.Fail].err{fail.message("object writer: a file plan is sealed once")}; }
    p.sealed = true;
    p.total  = p.end;
    ret res[usize, fail.Fail].ok{p.total};
}

# the next unplaced offset
pub fun cursor(p: *FilePlan) usize {
    ret p.end;
}

pub fun offset(p: *FilePlan, row: u32) usize {
    ret p.rows[row].offset;
}

pub fun size(p: *FilePlan, row: u32) usize {
    ret p.rows[row].size;
}

pub fun end(p: *FilePlan, row: u32) usize {
    ret p.rows[row].offset + p.rows[row].size;
}

# a region written through a cursor must end exactly where it was planned
pub fun close(p: *FilePlan, row: u32, cursor: usize) err[fail.Fail] {
    val planned: usize = end(p, row);
    if (cursor != planned) {
        ret err[fail.Fail].err{defect(p, "wrote to a cursor that is not the planned end", p.rows[row].label, cursor::u64, planned::u64)};
    }
    ret err[fail.Fail].ok{};
}

# a region filled by a writer that reports the bytes it produced
pub fun close_size(p: *FilePlan, row: u32, written: usize) err[fail.Fail] {
    if (written != p.rows[row].size) {
        ret err[fail.Fail].err{defect(p, "wrote a length that is not the planned size", p.rows[row].label, written::u64, p.rows[row].size::u64)};
    }
    ret err[fail.Fail].ok{};
}

pub fun field_u32(p: *FilePlan, value: usize, what: str) res[u32, fail.Fail] {
    val narrowed: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(value);
    if (sel narrowed.err) {
        ret res[u32, fail.Fail].err{too_large(p, "does not fit a 32-bit field width", what, value::u64, LIMIT_32::u64)};
    }
    ret res[u32, fail.Fail].ok{narrowed.ok};
}

pub fun field_u16(p: *FilePlan, value: usize, what: str) res[u16, fail.Fail] {
    val narrowed: res[u16, lang_checked.Cause] = lang_checked.usize_to_u16(value);
    if (sel narrowed.err) {
        ret res[u16, fail.Fail].err{too_large(p, "does not fit a 16-bit field width", what, value::u64, 0xFFFF)};
    }
    ret res[u16, fail.Fail].ok{narrowed.ok};
}

pub fun field_u64_u32(p: *FilePlan, value: u64, what: str) res[u32, fail.Fail] {
    val narrowed: res[u32, lang_checked.Cause] = lang_checked.u64_to_u32(value);
    if (sel narrowed.err) {
        ret res[u32, fail.Fail].err{too_large(p, "does not fit a 32-bit field width", what, value, LIMIT_32::u64)};
    }
    ret res[u32, fail.Fail].ok{narrowed.ok};
}

# a checked address: `base + (file offset - file base)`, the mapped twin of a row
pub fun address(p: *FilePlan, row: u32, file_base: usize, address_base: u64) res[u64, fail.Fail] {
    val off: usize = p.rows[row].offset;
    if (off < file_base) {
        ret res[u64, fail.Fail].err{defect(p, "is mapped before its address base", p.rows[row].label, off::u64, file_base::u64)};
    }
    val delta: u64 = (off - file_base)::u64;
    if (delta > ~(0::u64) - address_base) {
        ret res[u64, fail.Fail].err{defect(p, "overflows its virtual address", p.rows[row].label, delta, address_base)};
    }
    ret res[u64, fail.Fail].ok{address_base + delta};
}

# a checked alignment for a writer that has no plan of its own: the same
# primitive, refusing an invalid alignment and an overflowing round-up
pub fun align_bytes(value: usize, align: usize) res[usize, fail.Fail] {
    val checked: res[lang_checked.PowerAlignment[FileUnit], lang_checked.Cause] =
        lang_checked.power_alignment[FileUnit](align);
    if (sel checked.err) {
        ret res[usize, fail.Fail].err{fail.message("object writer: an alignment is not a power of two")};
    }
    val general: res[lang_checked.Alignment[FileUnit], lang_checked.Cause] = lang_checked.alignment[FileUnit](align);
    if (sel general.err) {
        ret res[usize, fail.Fail].err{fail.message("object writer: an alignment is not a power of two")};
    }
    val aligned: res[lang_checked.Offset[FileUnit], lang_checked.Cause] =
        lang_checked.align_offset_up[FileUnit](lang_checked.offset[FileUnit](value),
        general.ok);
    if (sel aligned.err) {
        ret res[usize, fail.Fail].err{fail.message("object writer: an aligned offset overflows the file")};
    }
    ret res[usize, fail.Fail].ok{aligned.ok.value};
}

# `align_bytes` for a value its writer has already bounded far below the file
# limit, as a name or a step count is. total over such a value: one whose
# round-up overflows usize is a caller defect
pub fun align_bounded(value: usize, align: usize) usize {
    val aligned: res[usize, fail.Fail] = align_bytes(value, align);
    if (sel aligned.err) {
        panic("object writer: a bounded value overflowed its round-up\n");
        ret 0;
    }
    ret aligned.ok;
}

# a checked aligned size, the size-side twin of `place`
pub fun align_up(p: *FilePlan, label: str, value: usize, align: usize) res[usize, fail.Fail] {
    val checked: res[lang_checked.PowerAlignment[FileUnit], lang_checked.Cause] =
        lang_checked.power_alignment[FileUnit](align);
    if (sel checked.err) {
        ret res[usize, fail.Fail].err{defect(p, "has an alignment that is not a power of two", label, align::u64, 0)};
    }
    val general: res[lang_checked.Alignment[FileUnit], lang_checked.Cause] = lang_checked.alignment[FileUnit](align);
    if (sel general.err) {
        ret res[usize, fail.Fail].err{defect(p, "has an alignment that is not a power of two", label, align::u64, 0)};
    }
    val aligned: res[lang_checked.Offset[FileUnit], lang_checked.Cause] =
        lang_checked.align_offset_up[FileUnit](lang_checked.offset[FileUnit](value),
        general.ok);
    if (sel aligned.err) {
        ret res[usize, fail.Fail].err{defect(p, "overflows the file offset", label, value::u64, align::u64)};
    }
    ret res[usize, fail.Fail].ok{aligned.ok.value};
}

# a checked count-times-size product for a table region
pub fun table(p: *FilePlan, label: str, count: usize, entry: usize) res[usize, fail.Fail] {
    val product: res[usize, lang_checked.Cause] = lang_checked.usize_mul(count, entry);
    if (sel product.err) {
        ret res[usize, fail.Fail].err{defect(p, "overflows the file offset", label, count::u64, entry::u64)};
    }
    ret res[usize, fail.Fail].ok{product.ok};
}

# a checked sum for a size accumulated before placement
pub fun sum(p: *FilePlan, label: str, left: usize, right: usize) res[usize, fail.Fail] {
    val added: res[usize, lang_checked.Cause] = lang_checked.usize_add(left, right);
    if (sel added.err) {
        ret res[usize, fail.Fail].err{defect(p, "overflows the file offset", label, left::u64, right::u64)};
    }
    ret res[usize, fail.Fail].ok{added.ok};
}

# a checked u32 count that a format field carries
pub fun count_u32(p: *FilePlan, label: str, left: u32, right: u32) res[u32, fail.Fail] {
    if (right > 0xFFFFFFFF - left) {
        ret res[u32, fail.Fail].err{too_large(p, "overflows a 32-bit count", label, left::u64, right::u64)};
    }
    ret res[u32, fail.Fail].ok{left + right};
}

# an aligned address in a mapped space, the address-side twin of `place`
pub fun align_address(p: *FilePlan, label: str, value: u64, align: u64) res[u64, fail.Fail] {
    val aligned: res[u64, lang_checked.Cause] = lang_checked.align_u64_up(value, align);
    if (sel aligned.err) {
        if (aligned.err == lang_checked.ADD_OVERFLOW) {
            ret res[u64, fail.Fail].err{defect(p, "overflows its virtual address", label, value, align)};
        }
        ret res[u64, fail.Fail].err{defect(p, "has an alignment that is not a power of two", label, align, 0)};
    }
    ret res[u64, fail.Fail].ok{aligned.ok};
}
