use mach.lang.fail;
use std.allocator.page;
use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.layout;
use mach.lang.publication;
use mach.lang.target.of;

# the one file layout every object writer sizes and serializes from
#
# a plan is an ordered list of regions. a writer places every region it will
# write, seals the plan, allocates exactly the sealed total, and then writes
# each region at the offset the plan recorded; nothing after sealing recomputes
# an offset. placement is checked: an alignment that is zero or not a power of
# two, an offset or size that overflows, or a result past the format's field
# width is refused with a message naming the region, before any buffer exists.
# a region written through a running cursor is closed with `close`, which
# refuses when the cursor did not land on the region's planned end, so a
# measure/write pair that drifts apart is a refusal, never a corrupt file.

pub rec FileUnit {}

pub rec Region {
    label:   str;
    section: of.SectionId;
    align:   usize;
    offset:  usize;
    size:    usize;
}

pub rec FilePlan {
    alloc:  *A.Allocator;
    itn:    *intern.Interner;
    format: str;
    rows:   *Region;
    count:  u32;
    cap:    u32;
    end:    usize;
    limit:  usize;
    sealed: bool;
    total:  usize;
}

pub val NO_ROW: u32 = 0xFFFFFFFF;

pub val LIMIT_32: usize = 0xFFFFFFFF;

pub fun limit_64() usize {
    ret ~(0::usize);
}

val ROW_CAP_FIRST: u32 = 16;

fun generic(p: *FilePlan, what: str) str {
    if (str_contains(what, "alignment")) { ret "object writer: a region's alignment is not a power of two"; }
    if (str_contains(what, "overflow"))  { ret "object writer: a region's offset overflows the file"; }
    if (str_contains(what, "width"))     { ret "object writer: a region does not fit the format's field width"; }
    if (str_contains(what, "cursor"))    { ret "object writer: a region's bytes do not end where the plan placed them"; }
    ret "object writer: file layout refused";
}

fun message(p: *FilePlan, what: str, label: str, value: u64, bound: u64) str {
    val fallback: str = generic(p, what);
    if (p.itn == nil) { ret fallback; }
    val rendered: res[str, format.FormatError] = format.sprint(p.alloc,
        "{}: the `{}` region {} ({} against {})", p.format, label, what, value, bound);
    if (sel rendered.err) { ret fallback; }
    val text: str = rendered.ok;
    ret publication.intern_message(p.itn, p.alloc, text::*u8, str_len(text), fallback);
}

pub fun init(alloc: *A.Allocator, itn: *intern.Interner, format: str, limit: usize) res[FilePlan, fail.Fail] {
    var p: FilePlan;
    p.alloc  = alloc;
    p.itn    = itn;
    p.format = format;
    p.rows   = nil;
    p.count  = 0;
    p.cap    = 0;
    p.end    = 0;
    p.limit  = limit;
    p.sealed = false;
    p.total  = 0;
    if (alloc == nil) { ret res[FilePlan, fail.Fail].err{fail.message("object writer: a file plan needs an allocator")}; }
    val made: res[*Region, A.Error] = A.zallocate[Region](alloc, ROW_CAP_FIRST::usize);
    if (sel made.err) { ret res[FilePlan, fail.Fail].err{fail.message("object writer: file plan alloc failed")}; }
    p.rows = made.ok;
    p.cap  = ROW_CAP_FIRST;
    ret res[FilePlan, fail.Fail].ok{p};
}

pub fun dnit(p: *FilePlan) {
    if (p.rows != nil) { A.deallocate[Region](p.alloc, p.rows, p.cap::usize); }
    p.rows  = nil;
    p.count = 0;
    p.cap   = 0;
}

fun grow(p: *FilePlan) err[fail.Fail] {
    if (p.count < p.cap) { ret err[fail.Fail].ok{}; }
    val doubled: res[usize, layout.CheckCause] = layout.usize_mul(p.cap::usize, 2);
    if (sel doubled.err) { ret err[fail.Fail].err{fail.message("object writer: file plan row count overflows")}; }
    val next_cap: usize                       = doubled.ok;
    val narrowed: res[u32, layout.CheckCause] = layout.usize_to_u32(next_cap);
    if (sel narrowed.err) { ret err[fail.Fail].err{fail.message("object writer: file plan row count overflows")}; }
    val moved: res[*Region, A.Error] = A.reallocate[Region](p.alloc, p.rows, p.cap::usize, next_cap);
    if (sel moved.err) { ret err[fail.Fail].err{fail.message("object writer: file plan alloc failed")}; }
    p.rows = moved.ok;
    p.cap  = narrowed.ok;
    ret err[fail.Fail].ok{};
}

fun push(p: *FilePlan, label: str, section: of.SectionId, align: usize, offset: usize, size: usize) res[u32, fail.Fail] {
    val grown: err[fail.Fail] = grow(p);
    if (sel grown.err) { ret res[u32, fail.Fail].err{grown.err}; }
    val row: u32 = p.count;
    p.rows[row].label   = label;
    p.rows[row].section = section;
    p.rows[row].align   = align;
    p.rows[row].offset  = offset;
    p.rows[row].size    = size;
    p.count             = row + 1;
    p.end               = offset + size;
    ret res[u32, fail.Fail].ok{row};
}

fun fits(p: *FilePlan, label: str, offset: usize, size: usize) res[usize, fail.Fail] {
    val summed: res[usize, layout.CheckCause] = layout.usize_add(offset, size);
    if (sel summed.err) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "overflows the file offset", label, offset::u64, size::u64))};
    }
    val end: usize = summed.ok;
    if (offset > p.limit || size > p.limit || end > p.limit) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "does not fit the format's field width", label, end::u64, p.limit::u64))};
    }
    ret res[usize, fail.Fail].ok{end};
}

# place a region at the next offset that satisfies `align`
pub fun place(p: *FilePlan, label: str, section: of.SectionId, align: usize, size: usize) res[u32, fail.Fail] {
    if (p.sealed) { ret res[u32, fail.Fail].err{fail.message("object writer: a sealed file plan cannot place a region")}; }
    val checked_align: res[layout.CheckedPowerAlignment[FileUnit], layout.CheckCause] =
        layout.power_alignment[FileUnit](align);
    if (sel checked_align.err) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "has an alignment that is not a power of two", label, align::u64, 0))};
    }
    val general: res[layout.CheckedAlignment[FileUnit], layout.CheckCause] =
        layout.alignment[FileUnit](align);
    if (sel general.err) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "has an alignment that is not a power of two", label, align::u64, 0))};
    }
    val aligned: res[layout.CheckedOffset[FileUnit], layout.CheckCause] =
        layout.align_offset_up[FileUnit](layout.offset[FileUnit](p.end),
        general.ok);
    if (sel aligned.err) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "overflows the file offset", label, p.end::u64, align::u64))};
    }
    val offset: usize                 = aligned.ok.value;
    val end:    res[usize, fail.Fail] = fits(p, label, offset, size);
    if (sel end.err) { ret res[u32, fail.Fail].err{end.err}; }
    ret push(p, label, section, align, offset, size);
}

# place a region whose offset is dictated; it must not overlap what came before
pub fun place_at(p: *FilePlan, label: str, section: of.SectionId, offset: usize, size: usize) res[u32, fail.Fail] {
    if (p.sealed) { ret res[u32, fail.Fail].err{fail.message("object writer: a sealed file plan cannot place a region")}; }
    if (offset < p.end) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "starts before the regions placed ahead of it end", label, offset::u64, p.end::u64))};
    }
    val end: res[usize, fail.Fail] = fits(p, label, offset, size);
    if (sel end.err) { ret res[u32, fail.Fail].err{end.err}; }
    ret push(p, label, section, 1, offset, size);
}

# advance the cursor to a dictated offset without placing a region
pub fun pad_to(p: *FilePlan, label: str, offset: usize) err[fail.Fail] {
    if (p.sealed) { ret err[fail.Fail].err{fail.message("object writer: a sealed file plan cannot pad")}; }
    if (offset < p.end) {
        ret err[fail.Fail].err{fail.message(message(p, "starts before the regions placed ahead of it end", label, offset::u64, p.end::u64))};
    }
    if (offset > p.limit) {
        ret err[fail.Fail].err{fail.message(message(p, "does not fit the format's field width", label, offset::u64, p.limit::u64))};
    }
    p.end = offset;
    ret err[fail.Fail].ok{};
}

# advance the cursor to `align` without placing a region; the gap is padding
pub fun pad(p: *FilePlan, label: str, align: usize) err[fail.Fail] {
    if (p.sealed) { ret err[fail.Fail].err{fail.message("object writer: a sealed file plan cannot pad")}; }
    val placed: res[u32, fail.Fail] = place(p, label, of.no_section(), align, 0);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    p.count = p.count - 1;
    ret err[fail.Fail].ok{};
}

pub fun seal(p: *FilePlan) res[usize, fail.Fail] {
    if (p.sealed) { ret res[usize, fail.Fail].err{fail.message("object writer: a file plan is sealed once")}; }
    p.sealed = true;
    p.total  = p.end;
    ret res[usize, fail.Fail].ok{p.total};
}

# the next unplaced offset
pub fun cursor(p: *FilePlan) usize {
    ret p.end;
}

pub fun total(p: *FilePlan) usize {
    ret p.total;
}

pub fun row_count(p: *FilePlan) u32 {
    ret p.count;
}

pub fun offset(p: *FilePlan, row: u32) usize {
    ret p.rows[row].offset;
}

pub fun size(p: *FilePlan, row: u32) usize {
    ret p.rows[row].size;
}

pub fun end(p: *FilePlan, row: u32) usize {
    ret p.rows[row].offset + p.rows[row].size;
}

pub fun label(p: *FilePlan, row: u32) str {
    ret p.rows[row].label;
}

pub fun section(p: *FilePlan, row: u32) of.SectionId {
    ret p.rows[row].section;
}

# a region written through a cursor must end exactly where it was planned
pub fun close(p: *FilePlan, row: u32, cursor: usize) err[fail.Fail] {
    val planned: usize = end(p, row);
    if (cursor != planned) {
        ret err[fail.Fail].err{fail.message(message(p, "wrote to a cursor that is not the planned end", p.rows[row].label, cursor::u64, planned::u64))};
    }
    ret err[fail.Fail].ok{};
}

# a region filled by a writer that reports the bytes it produced
pub fun close_size(p: *FilePlan, row: u32, written: usize) err[fail.Fail] {
    if (written != p.rows[row].size) {
        ret err[fail.Fail].err{fail.message(message(p, "wrote a length that is not the planned size", p.rows[row].label, written::u64, p.rows[row].size::u64))};
    }
    ret err[fail.Fail].ok{};
}

pub fun field_u32(p: *FilePlan, value: usize, what: str) res[u32, fail.Fail] {
    val narrowed: res[u32, layout.CheckCause] = layout.usize_to_u32(value);
    if (sel narrowed.err) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "does not fit a 32-bit field width", what, value::u64, LIMIT_32::u64))};
    }
    ret res[u32, fail.Fail].ok{narrowed.ok};
}

pub fun field_u16(p: *FilePlan, value: usize, what: str) res[u16, fail.Fail] {
    val narrowed: res[u16, layout.CheckCause] = layout.usize_to_u16(value);
    if (sel narrowed.err) {
        ret res[u16, fail.Fail].err{fail.message(message(p, "does not fit a 16-bit field width", what, value::u64, 0xFFFF))};
    }
    ret res[u16, fail.Fail].ok{narrowed.ok};
}

pub fun field_u8(p: *FilePlan, value: usize, what: str) res[u8, fail.Fail] {
    val narrowed: res[u8, layout.CheckCause] = layout.usize_to_u8(value);
    if (sel narrowed.err) {
        ret res[u8, fail.Fail].err{fail.message(message(p, "does not fit an 8-bit field width", what, value::u64, 0xFF))};
    }
    ret res[u8, fail.Fail].ok{narrowed.ok};
}

pub fun field_u64_u32(p: *FilePlan, value: u64, what: str) res[u32, fail.Fail] {
    val narrowed: res[u32, layout.CheckCause] = layout.u64_to_u32(value);
    if (sel narrowed.err) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "does not fit a 32-bit field width", what, value, LIMIT_32::u64))};
    }
    ret res[u32, fail.Fail].ok{narrowed.ok};
}

# a checked address: `base + (file offset - file base)`, the mapped twin of a row
pub fun address(p: *FilePlan, row: u32, file_base: usize, address_base: u64) res[u64, fail.Fail] {
    val off: usize = p.rows[row].offset;
    if (off < file_base) {
        ret res[u64, fail.Fail].err{fail.message(message(p, "is mapped before its address base", p.rows[row].label, off::u64, file_base::u64))};
    }
    val delta: u64 = (off - file_base)::u64;
    if (delta > ~(0::u64) - address_base) {
        ret res[u64, fail.Fail].err{fail.message(message(p, "overflows its virtual address", p.rows[row].label, delta, address_base))};
    }
    ret res[u64, fail.Fail].ok{address_base + delta};
}

# a checked alignment for a writer that has no plan of its own: the same
# primitive, refusing an invalid alignment and an overflowing round-up
pub fun align_bytes(value: usize, align: usize) res[usize, fail.Fail] {
    val checked: res[layout.CheckedPowerAlignment[FileUnit], layout.CheckCause] =
        layout.power_alignment[FileUnit](align);
    if (sel checked.err) {
        ret res[usize, fail.Fail].err{fail.message("object writer: an alignment is not a power of two")};
    }
    val general: res[layout.CheckedAlignment[FileUnit], layout.CheckCause] = layout.alignment[FileUnit](align);
    if (sel general.err) {
        ret res[usize, fail.Fail].err{fail.message("object writer: an alignment is not a power of two")};
    }
    val aligned: res[layout.CheckedOffset[FileUnit], layout.CheckCause] =
        layout.align_offset_up[FileUnit](layout.offset[FileUnit](value),
        general.ok);
    if (sel aligned.err) {
        ret res[usize, fail.Fail].err{fail.message("object writer: an aligned offset overflows the file")};
    }
    ret res[usize, fail.Fail].ok{aligned.ok.value};
}

# a checked aligned size, the size-side twin of `place`
pub fun align_up(p: *FilePlan, label: str, value: usize, align: usize) res[usize, fail.Fail] {
    val checked: res[layout.CheckedPowerAlignment[FileUnit], layout.CheckCause] =
        layout.power_alignment[FileUnit](align);
    if (sel checked.err) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "has an alignment that is not a power of two", label, align::u64, 0))};
    }
    val general: res[layout.CheckedAlignment[FileUnit], layout.CheckCause] = layout.alignment[FileUnit](align);
    if (sel general.err) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "has an alignment that is not a power of two", label, align::u64, 0))};
    }
    val aligned: res[layout.CheckedOffset[FileUnit], layout.CheckCause] =
        layout.align_offset_up[FileUnit](layout.offset[FileUnit](value),
        general.ok);
    if (sel aligned.err) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "overflows the file offset", label, value::u64, align::u64))};
    }
    ret res[usize, fail.Fail].ok{aligned.ok.value};
}

# a checked count-times-size product for a table region
pub fun table(p: *FilePlan, label: str, count: usize, entry: usize) res[usize, fail.Fail] {
    val product: res[usize, layout.CheckCause] = layout.usize_mul(count, entry);
    if (sel product.err) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "overflows the file offset", label, count::u64, entry::u64))};
    }
    ret res[usize, fail.Fail].ok{product.ok};
}

# a checked sum for a size accumulated before placement
pub fun sum(p: *FilePlan, label: str, left: usize, right: usize) res[usize, fail.Fail] {
    val added: res[usize, layout.CheckCause] = layout.usize_add(left, right);
    if (sel added.err) {
        ret res[usize, fail.Fail].err{fail.message(message(p, "overflows the file offset", label, left::u64, right::u64))};
    }
    ret res[usize, fail.Fail].ok{added.ok};
}

# a checked u32 count that a format field carries
pub fun count_u32(p: *FilePlan, label: str, left: u32, right: u32) res[u32, fail.Fail] {
    if (right > 0xFFFFFFFF - left) {
        ret res[u32, fail.Fail].err{fail.message(message(p, "overflows a 32-bit count", label, left::u64, right::u64))};
    }
    ret res[u32, fail.Fail].ok{left + right};
}

# an aligned address in a mapped space, the address-side twin of `place`
pub fun align_address(p: *FilePlan, label: str, value: u64, align: u64) res[u64, fail.Fail] {
    val aligned: res[u64, layout.CheckCause] = layout.align_u64_up(value, align);
    if (sel aligned.err) {
        if (aligned.err == layout.CHECK_ADD_OVERFLOW) {
            ret res[u64, fail.Fail].err{fail.message(message(p, "overflows its virtual address", label, value, align))};
        }
        ret res[u64, fail.Fail].err{fail.message(message(p, "has an alignment that is not a power of two", label, align, 0))};
    }
    ret res[u64, fail.Fail].ok{aligned.ok};
}

test "mach.lang.target.of.plan.place:aligns_and_records_rows_in_order" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, nil, "test", limit_64());
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }

    val h: res[u32, fail.Fail] = place(?p, "header", of.no_section(), 1, 64);
    if (sel h.err) { ret 2; }
    val a: res[u32, fail.Fail] = place(?p, "a", of.section_id(0), 16, 17);
    if (sel a.err) { ret 3; }
    val b: res[u32, fail.Fail] = place(?p, "b", of.section_id(1), 8, 3);
    if (sel b.err)                                { ret 4; }
    if (offset(?p, h.ok) != 0)                    { ret 5; }
    if (offset(?p, a.ok) != 64)                   { ret 6; }
    if (offset(?p, b.ok) != 88)                   { ret 7; }
    if (end(?p, b.ok) != 91)                      { ret 8; }
    if (of.section_index(section(?p, b.ok)) != 1) { ret 9; }
    val sealed: res[usize, fail.Fail] = seal(?p);
    if (sel sealed.err)  { ret 10; }
    if (sealed.ok != 91) { ret 11; }
    val r_404: res[u32, fail.Fail] = place(?p, "late", of.no_section(), 1, 1);
    if (sel r_404.ok) { ret 12; }
    ret 0;
}

test "mach.lang.target.of.plan.place:refuses_non_power_of_two_and_zero_alignment" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:  intern.Interner          = intern.init(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, ?itn, "test", limit_64());
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }
    val three: res[u32, fail.Fail] = place(?p, "odd", of.no_section(), 3, 8);
    if (sel three.ok)                                                  { ret 2; }
    if (!str_contains(fail.describe(three.err), "`odd`"))              { ret 3; }
    if (!str_contains(fail.describe(three.err), "not a power of two")) { ret 4; }
    val r_420: res[u32, fail.Fail] = place(?p, "zero", of.no_section(), 0, 8);
    if (sel r_420.ok)       { ret 5; }
    if (row_count(?p) != 0) { ret 6; }
    if (p.end != 0)         { ret 7; }
    ret 0;
}

test "mach.lang.target.of.plan.place:refuses_offset_overflow_before_any_row_exists" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, nil, "test", limit_64());
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }
    val big:   usize               = ~(0::usize) - 8;
    val first: res[u32, fail.Fail] = place(?p, "first", of.no_section(), 1, big);
    if (sel first.err) { ret 2; }
    val second: res[u32, fail.Fail] = place(?p, "second", of.no_section(), 16, 1);
    if (sel second.ok)                                         { ret 3; }
    if (!str_contains(fail.describe(second.err), "overflows")) { ret 4; }
    val third: res[u32, fail.Fail] = place(?p, "third", of.no_section(), 1, 16);
    if (sel third.ok)       { ret 5; }
    if (row_count(?p) != 1) { ret 6; }
    ret 0;
}

test "mach.lang.target.of.plan.place:refuses_a_region_past_the_field_width" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, nil, "test", LIMIT_32);
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }
    val a: res[u32, fail.Fail] = place(?p, "a", of.section_id(0), 1, 0xFFFFFFF0);
    if (sel a.err) { ret 2; }
    val b: res[u32, fail.Fail] = place(?p, "b", of.section_id(1), 1, 0x10);
    if (sel b.ok)                                           { ret 3; }
    if (!str_contains(fail.describe(b.err), "field width")) { ret 4; }
    ret 0;
}

test "mach.lang.target.of.plan.place_at:refuses_overlap" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, nil, "test", limit_64());
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }
    val r_467: res[u32, fail.Fail] = place(?p, "a", of.no_section(), 1, 100);
    if (sel r_467.err) { ret 2; }
    val r_468: res[u32, fail.Fail] = place_at(?p, "b", of.no_section(), 99, 1);
    if (sel r_468.ok) { ret 3; }
    val c: res[u32, fail.Fail] = place_at(?p, "c", of.no_section(), 4096, 1);
    if (sel c.err)                { ret 4; }
    if (offset(?p, c.ok) != 4096) { ret 5; }
    val r_472: err[fail.Fail] = pad_to(?p, "back", 4000);
    if (sel r_472.ok) { ret 6; }
    val r_473: err[fail.Fail] = pad_to(?p, "forward", 8192);
    if (sel r_473.err)      { ret 7; }
    if (cursor(?p) != 8192) { ret 8; }
    ret 0;
}

test "mach.lang.target.of.plan.close:refuses_a_cursor_off_the_planned_end" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, nil, "test", limit_64());
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }
    val a: res[u32, fail.Fail] = place(?p, "strings", of.no_section(), 1, 10);
    if (sel a.err) { ret 2; }
    val row:   u32            = a.ok;
    val r_488: err[fail.Fail] = close(?p, row, 10);
    if (sel r_488.err) { ret 3; }
    val r_489: err[fail.Fail] = close(?p, row, 9);
    if (sel r_489.ok) { ret 4; }
    val r_490: err[fail.Fail] = close(?p, row, 11);
    if (sel r_490.ok) { ret 5; }
    val r_491: err[fail.Fail] = close_size(?p, row, 10);
    if (sel r_491.err) { ret 6; }
    val r_492: err[fail.Fail] = close_size(?p, row, 0);
    if (sel r_492.ok) { ret 7; }
    ret 0;
}

test "mach.lang.target.of.plan.field:refuses_narrowing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val made: res[FilePlan, fail.Fail] = init(?alloc, nil, "test", limit_64());
    if (sel made.err) { ret 1; }
    var p: FilePlan = made.ok;
    fin { dnit(?p); }
    val r_503: res[u32, fail.Fail] = field_u32(?p, 0xFFFFFFFF, "x");
    if (sel r_503.err) { ret 2; }
    val r_504: res[u32, fail.Fail] = field_u32(?p, 0x100000000, "x");
    if (sel r_504.ok) { ret 3; }
    val r_505: res[u16, fail.Fail] = field_u16(?p, 0xFFFF, "x");
    if (sel r_505.err) { ret 4; }
    val r_506: res[u16, fail.Fail] = field_u16(?p, 0x10000, "x");
    if (sel r_506.ok) { ret 5; }
    val r_507: res[u8, fail.Fail] = field_u8(?p, 0xFF, "x");
    if (sel r_507.err) { ret 6; }
    val r_508: res[u8, fail.Fail] = field_u8(?p, 0x100, "x");
    if (sel r_508.ok) { ret 7; }
    val r_509: res[u32, fail.Fail] = field_u64_u32(?p, 0x100000000, "x");
    if (sel r_509.ok) { ret 8; }
    val r_510: res[usize, fail.Fail] = table(?p, "t", ~(0::usize), 2);
    if (sel r_510.ok) { ret 9; }
    val r_511: res[usize, fail.Fail] = sum(?p, "s", ~(0::usize), 1);
    if (sel r_511.ok) { ret 10; }
    val r_512: res[u32, fail.Fail] = count_u32(?p, "c", 0xFFFFFFFF, 1);
    if (sel r_512.ok) { ret 11; }
    val r_513: res[u64, fail.Fail] = align_address(?p, "va", ~(0::u64) - 1, 4096);
    if (sel r_513.ok) { ret 12; }
    val r_514: res[u64, fail.Fail] = align_address(?p, "va", 0, 3);
    if (sel r_514.ok) { ret 13; }
    val r_515: res[usize, fail.Fail] = align_up(?p, "sz", ~(0::usize) - 1, 4096);
    if (sel r_515.ok) { ret 15; }
    val r_516: res[usize, fail.Fail] = align_up(?p, "sz", 8, 6);
    if (sel r_516.ok) { ret 16; }
    val sz: res[usize, fail.Fail] = align_up(?p, "sz", 513, 512);
    if (sel sz.err)    { ret 17; }
    if (sz.ok != 1024) { ret 17; }
    val va: res[u64, fail.Fail] = align_address(?p, "va", 4097, 4096);
    if (sel va.err)    { ret 14; }
    if (va.ok != 8192) { ret 14; }
    ret 0;
}

test "mach.lang.target.of.plan.init:allocation_refusal_is_a_typed_error" {
    var failing: T.Testing;
    val r_528:   err[A.Error] = T.make(?failing);
    if (sel r_528.err) { ret 1; }
    T.fail_at_ordinal(?failing, 1);
    val made: res[FilePlan, fail.Fail] = init(T.allocator_of(?failing), nil, "test", limit_64());
    if (sel made.ok)                                            { ret 1; }
    if (!str_contains(fail.describe(made.err), "alloc failed")) { ret 2; }

    T.clear_failure(?failing);
    val ok: res[FilePlan, fail.Fail] = init(T.allocator_of(?failing), nil, "test", limit_64());
    if (sel ok.err) { ret 3; }
    var p: FilePlan = ok.ok;
    var i: u32      = 0;
    for (i < ROW_CAP_FIRST) {
        val r_540: res[u32, fail.Fail] = place(?p, "row", of.no_section(), 1, 1);
        if (sel r_540.err) {
            dnit(?p);
            ret 4;
        }
        i = i + 1;
    }
    T.fail_at_ordinal(?failing, T.attempt_count(?failing) + 1);
    val grown: res[u32, fail.Fail] = place(?p, "row", of.no_section(), 1, 1);
    if (sel grown.ok) {
        dnit(?p);
        ret 5;
    }
    if (row_count(?p) != ROW_CAP_FIRST) {
        dnit(?p);
        ret 6;
    }
    dnit(?p);
    if (T.leaked(?failing)) { ret 7; }
    ret 0;
}
