use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use output_testing: mach.lang.output.testing;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.memory;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;

use lang_checked: mach.lang.checked;
use mach.lang.intern;
use catalog_arch:      mach.lang.target.catalog.arch;
use catalog_subsystem: mach.lang.target.catalog.subsystem;
use mach.lang.target.isa;
use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_destination: mach.lang.target.of.destination;

val RAW_UNSUPPORTED: str = "raw output supports only executables";

fun segment_extent(seg: *target_of.LoadSegment) res[lang_checked.Address[lang_checked.MemorySpace], fail.Fail] {
    val start: lang_checked.Address[lang_checked.MemorySpace]                          = lang_checked.address[lang_checked.MemorySpace](seg.vaddr::usize);
    val ext:   res[lang_checked.Address[lang_checked.MemorySpace], lang_checked.Cause] =
        lang_checked.address_add[lang_checked.MemorySpace](start, lang_checked.count[lang_checked.ByteUnit](seg.memsz));
    if (sel ext.err) {
        ret res[lang_checked.Address[lang_checked.MemorySpace], fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "segment extent overflows the address space")};
    }
    ret res[lang_checked.Address[lang_checked.MemorySpace], fail.Fail].ok{ext.ok};
}

# the segments copied to their offsets from the lowest one, the gaps and the
# zero-fill as zeroes, as the destination's artifact, its base the lowest address
fun flat_image(segs: *target_of.LoadSegment, seg_count: u32, dst: *of_destination.Destination) err[fail.Fail] {
    if (seg_count == 0) { ret err[fail.Fail].err{fail.message("no loadable segments")}; }

    var base: lang_checked.Address[lang_checked.MemorySpace]                 = lang_checked.address[lang_checked.MemorySpace](segs[0].vaddr::usize);
    val end0: res[lang_checked.Address[lang_checked.MemorySpace], fail.Fail] = segment_extent(?segs[0]);
    if (sel end0.err) { ret err[fail.Fail].err{end0.err}; }
    var end: lang_checked.Address[lang_checked.MemorySpace] = end0.ok;

    var i: u32 = 1;
    for (i < seg_count) {
        if (segs[i].vaddr::usize < base.value) { base = lang_checked.address[lang_checked.MemorySpace](segs[i].vaddr::usize); }
        val e: res[lang_checked.Address[lang_checked.MemorySpace], fail.Fail] = segment_extent(?segs[i]);
        if (sel e.err) { ret err[fail.Fail].err{e.err}; }
        val ev: lang_checked.Address[lang_checked.MemorySpace] = e.ok;
        if (ev.value > end.value) { end = ev; }
        i = i + 1;
    }

    val size: usize = end.value - base.value;
    if (size == 0) { ret err[fail.Fail].err{fail.message("flat image has no bytes")}; }

    val rb: res[*u8, fail.Fail] = of_destination.file_add(dst, "", size, 0o755);
    if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
    val buf: *u8 = rb.ok;

    i = 0;
    for (i < seg_count) {
        if (segs[i].bytes != nil && segs[i].filesz > 0) {
            val off: usize = segs[i].vaddr::usize - base.value;
            if (!bin.region_ok(size, off, segs[i].filesz)) {
                ret err[fail.Fail].err{fail.message("segment content escapes the flat image bounds")};
            }
            memory.raw_copy((buf::usize + off)::ptr, segs[i].bytes::ptr, segs[i].filesz);
        }
        i = i + 1;
    }

    dst.base = base.value::u64;
    ret err[fail.Fail].ok{};
}

fun object_emit(isa_vt: *target_of.ObjectTarget, image: *target_of.ObjectImage, dst: *of_destination.Destination) err[fail.Fail] {
    ret err[fail.Fail].err{fail.user(diagnostic_kind.TARGET_OUTPUT_UNSUPPORTED, RAW_UNSUPPORTED)};
}

fun parse_object(a: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_len: usize, out: *target_of.ObjectImage) err[fail.Fail] {
    ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, RAW_UNSUPPORTED)};
}

# a flat image enters at its base, the first byte the loader copies
fun image_emit(img: *target_of.LinkedImage, dst: *of_destination.Destination) err[fail.Fail] {
    val built: err[fail.Fail] = flat_image(img.segments, img.segment_count, dst);
    if (sel built.err) { ret built; }
    if (img.entry != dst.base) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_ENTRY_PLACEMENT, "flat image must enter at its base address")};
    }
    ret err[fail.Fail].ok{};
}

val STATIC_SUFFIXES: [2]str = [2]str{"o", "a"};

# a flat image links only the archives a bare name or a path finds
val INPUT_NAMING: target_of.InputNaming = target_of.InputNaming{
    library_prefix:      "lib",
    static_suffixes:     ?STATIC_SUFFIXES[0],
    static_suffix_count: 2,
};

pub val VTABLE: target_of.OfVTable = target_of.OfVTable{
    id:                      target_of.OF_RAW,
    name:                    "raw",
    produces_image:          true,
    links_from_image:        true,
    debug_offset_kind:       target_of.RK_ABS32,
    object_ext:              "",
    object_emit:             object_emit,
    parse_object:            parse_object,
    image_emit:              image_emit,
    default_debug:           "",
    shared_input_ext:        "",
    import_address_prefix:   "",
    header_in_first_segment: false,
    maps_by_page:            false,
    carries_stack_size:      false,
    default_stack_reserve:   0,
    covers_isa_any:          true,
    inputs:                  ?INPUT_NAMING,
};

#[testing]
fun t_isa(id: u32) target_of.ObjectTarget {
    ret target_of.ObjectTarget{arch_id: id, pointer_width: 8};
}

# segments land at their offset from the base, gaps and a trailing bss are
# zeroes, and the planned image size is the written size
test image_emit__flat_layout {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i:      intern.Interner        = intern.init(?alloc);
    var isa_vt: target_of.ObjectTarget = t_isa(catalog_arch.X86_64);

    var code_bytes: [5]u8;
    code_bytes[0] = 0xEB;
    code_bytes[1] = 0xFE;
    code_bytes[2] = 0x90;
    code_bytes[3] = 0x90;
    code_bytes[4] = 0x90;
    var data_bytes: [3]u8;
    data_bytes[0] = 0xDE;
    data_bytes[1] = 0xAD;
    data_bytes[2] = 0xBE;

    var segs: [3]target_of.LoadSegment;
    segs[0].vaddr  = 0x2000;
    segs[0].filesz = 5;
    segs[0].memsz  = 5;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];
    segs[1].vaddr  = 0x2011;
    segs[1].filesz = 3;
    segs[1].memsz  = 3;
    segs[1].flags  = target_of.SEG_FLAG_READ;
    segs[1].bytes  = ?data_bytes[0];
    segs[2].vaddr  = 0x2014;
    segs[2].filesz = 0;
    segs[2].memsz  = 12;
    segs[2].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_WRITE;
    segs[2].bytes  = nil;

    var planned: of_destination.Destination = of_destination.init(?alloc);
    fin { of_destination.dnit(?planned); }
    val ir: err[fail.Fail] = flat_image(?segs[0], 3, ?planned);
    if (sel ir.err) { ret 1; }
    val planned_size: usize = of_destination.artifact(?planned).len;
    if (planned.base != 0x2000) { ret 2; }
    if (planned_size != 0x20)   { ret 3; }

    val tf_r: res[output_testing.Output, fail.Fail] = output_testing.create(?alloc, "raw_flat");
    if (sel tf_r.err) { ret 4; }
    var tf: output_testing.Output = tf_r.ok;
    fin { output_testing.dnit(?tf); }
    val tpath: str = output_testing.path(?tf);

    val em: err[fail.Fail] = target_of.image_write(image_emit, target_of.LinkedImage{alloc: ?alloc, interner: ?i, target: ?isa_vt,
        segments: ?segs[0], segment_count: 3, page_size: 4096, image_base: 0x2000, entry: 0x2000, name: "rawflat"::*u8,
        options:  target_of.image_options_default(catalog_subsystem.CONSOLE)}, tpath);
    if (sel em.err) { ret 5; }

    val rr: res[Vector[u8], fs.FsError] = fs.read_bytes(?alloc, tpath);
    if (sel rr.err) { ret 6; }
    var b: Vector[u8] = rr.ok;
    fin { collections_vector.dnit[u8](?b); }
    if (b.len != planned_size)                        { ret 7; }
    if (b.data[0] != 0xEB || b.data[4] != 0x90)       { ret 8; }
    if (b.data[0x11] != 0xDE || b.data[0x13] != 0xBE) { ret 9; }
    var k: usize = 5;
    for (k < 0x20) {
        if ((k < 0x11 || k >= 0x14) && b.data[k] != 0x00) { ret 10; }
        k = k + 1;
    }
    ret 0;
}

test image_emit__entry_must_be_base {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: target_of.ObjectTarget = t_isa(catalog_arch.X86_64);

    var code_bytes: [4]u8;
    code_bytes[0] = 0x90;
    code_bytes[1] = 0x90;
    code_bytes[2] = 0x90;
    code_bytes[3] = 0x90;

    var segs: [1]target_of.LoadSegment;
    segs[0].vaddr  = 0x1000;
    segs[0].filesz = 4;
    segs[0].memsz  = 4;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];

    var dst: of_destination.Destination = of_destination.init(?alloc);
    fin { of_destination.dnit(?dst); }
    var img: target_of.LinkedImage = target_of.LinkedImage{alloc: ?alloc, interner: ?i, target: ?isa_vt,
        segments: ?segs[0], segment_count: 1, page_size: 4096, image_base: 0x1000, entry: 0x1008, name: "rawbad"::*u8,
        options:  target_of.image_options_default(catalog_subsystem.CONSOLE)};
    val em: err[fail.Fail] = image_emit(?img, ?dst);
    if (!sel em.err)                                  { ret 1; }
    if (!str_contains(fail.describe(em.err), "base")) { ret 1; }
    ret 0;
}

test flat_image__refuses_filesz_beyond_memsz {
    var alloc: A.Allocator;
    page.make(?alloc);

    var code_bytes: [8]u8;
    var z:          usize = 0;
    for (z < 8) {
        code_bytes[z] = 0x90;
        z             = z + 1;
    }

    var segs: [1]target_of.LoadSegment;
    segs[0].vaddr  = 0x1000;
    segs[0].filesz = 8;
    segs[0].memsz  = 4;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];

    var dst: of_destination.Destination = of_destination.init(?alloc);
    fin { of_destination.dnit(?dst); }
    val rb: err[fail.Fail] = flat_image(?segs[0], 1, ?dst);
    if (!sel rb.err)                                     { ret 1; }
    if (!str_contains(fail.describe(rb.err), "escapes")) { ret 1; }
    ret 0;
}

test flat_image__refuses_address_space_overflow {
    var alloc: A.Allocator;
    page.make(?alloc);

    var code_bytes: [8]u8;
    var z:          usize = 0;
    for (z < 8) {
        code_bytes[z] = 0x90;
        z             = z + 1;
    }

    var segs: [1]target_of.LoadSegment;
    segs[0].vaddr  = 0xFFFFFFFFFFFFFFF0;
    segs[0].filesz = 8;
    segs[0].memsz  = 32;
    segs[0].flags  = target_of.SEG_FLAG_READ | target_of.SEG_FLAG_EXECUTE;
    segs[0].bytes  = ?code_bytes[0];

    var dst: of_destination.Destination = of_destination.init(?alloc);
    fin { of_destination.dnit(?dst); }
    val rb: err[fail.Fail] = flat_image(?segs[0], 1, ?dst);
    if (!sel rb.err)                                      { ret 1; }
    if (!str_contains(fail.describe(rb.err), "overflow")) { ret 1; }
    ret 0;
}
