use txn: std.filesystem.transaction;
use std.allocator.page;
use fs: std.filesystem;
use io_error: std.io.error;
use std.collections.vector;
use std.collections.vector.Vector;
use std.memory;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.layout;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use mach.lang.publication;

val RAW_UNSUPPORTED: str = "raw output supports only executables";

fun segment_extent(seg: *of.LoadSegment) R.Result[layout.CheckedAddress[layout.MemorySpace], str] {
    val start: layout.CheckedAddress[layout.MemorySpace] = layout.address[layout.MemorySpace](seg.vaddr::usize);
    val ext: R.Result[layout.CheckedAddress[layout.MemorySpace], layout.CheckCause] =
        layout.address_add[layout.MemorySpace](start, layout.count[layout.ByteUnit](seg.memsz));
    if (R.is_err[layout.CheckedAddress[layout.MemorySpace], layout.CheckCause](ext)) {
        ret R.err[layout.CheckedAddress[layout.MemorySpace], str]("raw: segment extent overflows the address space");
    }
    ret R.ok[layout.CheckedAddress[layout.MemorySpace], str](
        R.unwrap_ok[layout.CheckedAddress[layout.MemorySpace], layout.CheckCause](ext));
}

fun build_flat_image(alloc: *A.Allocator, segs: *of.LoadSegment, seg_count: u32,
                     out_base: *u64, out_size: *usize) R.Result[*u8, str] {
    if (seg_count == 0) { ret R.err[*u8, str]("raw: no loadable segments"); }

    var base: layout.CheckedAddress[layout.MemorySpace] = layout.address[layout.MemorySpace](segs[0].vaddr::usize);
    val end0: R.Result[layout.CheckedAddress[layout.MemorySpace], str] = segment_extent(?segs[0]);
    if (R.is_err[layout.CheckedAddress[layout.MemorySpace], str](end0)) {
        ret R.err[*u8, str](R.unwrap_err[layout.CheckedAddress[layout.MemorySpace], str](end0));
    }
    var end: layout.CheckedAddress[layout.MemorySpace] = R.unwrap_ok[layout.CheckedAddress[layout.MemorySpace], str](end0);

    var i: u32 = 1;
    for (i < seg_count) {
        if (segs[i].vaddr::usize < base.value) { base = layout.address[layout.MemorySpace](segs[i].vaddr::usize); }
        val e: R.Result[layout.CheckedAddress[layout.MemorySpace], str] = segment_extent(?segs[i]);
        if (R.is_err[layout.CheckedAddress[layout.MemorySpace], str](e)) {
            ret R.err[*u8, str](R.unwrap_err[layout.CheckedAddress[layout.MemorySpace], str](e));
        }
        val ev: layout.CheckedAddress[layout.MemorySpace] = R.unwrap_ok[layout.CheckedAddress[layout.MemorySpace], str](e);
        if (ev.value > end.value) { end = ev; }
        i = i + 1;
    }

    val size: usize = end.value - base.value;
    if (size == 0) { ret R.err[*u8, str]("raw: flat image has no bytes"); }

    val rb: R.Result[*u8, str] = A.zallocate[u8](alloc, size);
    if (R.is_err[*u8, str](rb)) { ret R.err[*u8, str]("raw: flat image buffer alloc failed"); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    i = 0;
    for (i < seg_count) {
        if (segs[i].bytes != nil && segs[i].filesz > 0) {
            val off: usize = segs[i].vaddr::usize - base.value;
            val vr: R.Result[R.Void, str] = bin.require_region(size, off, segs[i].filesz,
                "raw: segment content escapes the flat image bounds");
            if (R.is_err[R.Void, str](vr)) {
                A.deallocate[u8](alloc, buf, size);
                ret R.err[*u8, str](R.unwrap_err[R.Void, str](vr));
            }
            memory.raw_copy((buf::usize + off)::ptr, segs[i].bytes::ptr, segs[i].filesz);
        }
        i = i + 1;
    }

    @out_base = base.value::u64;
    @out_size = size;
    ret R.ok[*u8, str](buf);
}

fun emit_object(isa_vt: *of.ObjectTarget, image: *of.ObjectImage, destination: *publication.Destination) R.Result[R.Void, str] {
    ret R.err[R.Void, str](RAW_UNSUPPORTED);
}

fun parse_object(a: *A.Allocator, itn: *intern.Interner, buf: *u8, buf_len: usize, out: *of.ObjectImage) R.Result[R.Void, str] {
    ret R.err[R.Void, str](RAW_UNSUPPORTED);
}

fun exec_image(alloc: *A.Allocator, segs: *of.LoadSegment, seg_count: u32, entry: u64,
               out_base: *u64, out_size: *usize) R.Result[*u8, str] {
    var flat_base: u64 = 0;
    var size: usize = 0;
    val rb: R.Result[*u8, str] = build_flat_image(alloc, segs, seg_count, ?flat_base, ?size);
    if (R.is_err[*u8, str](rb)) { ret rb; }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);

    if (entry != flat_base) {
        A.deallocate[u8](alloc, buf, size);
        ret R.err[*u8, str]("raw: flat image must enter at its base address");
    }

    @out_base = flat_base;
    @out_size = size;
    ret R.ok[*u8, str](buf);
}

fun emit_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
              seg_count: u32, page_size: u64, image_base: u64, entry: u64,
              funcs: *of.ExecFunction,
              func_count: u32, exceptions: *of.Section, exception_count: u32,
              debug: *of.Section, debug_count: u32,
              symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination, name: *u8,
              image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (tgt_isa == nil) { ret R.err[R.Void, str]("raw: nil exec isa"); }
    if (destination == nil)    { ret R.err[R.Void, str]("raw: nil exec path"); }

    var flat_base: u64 = 0;
    var size: usize = 0;
    val rb: R.Result[*u8, str] = exec_image(alloc, segs, seg_count, entry, ?flat_base, ?size);
    if (R.is_err[*u8, str](rb)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](rb)); }
    var buf: *u8 = R.unwrap_ok[*u8, str](rb);

    val pr: R.Result[R.Void, str] = publication.bytes_at(itn, alloc, ?destination.claim, destination.path, buf, size, 0o755, publication.REPLACE, "raw: cannot publish executable", "raw: could not publish executable file", nil);
    A.deallocate[u8](alloc, buf, size);
    ret pr;
}

fun emit_dyn_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
                  seg_count: u32, page_size: u64, image_base: u64, entry: u64,
                  funcs: *of.ExecFunction, func_count: u32,
                  dyn: *of.DynamicInfo, fixups: *of.PltFixup, fixup_count: u32,
                  exceptions: *of.Section, exception_count: u32,
                  debug: *of.Section, debug_count: u32,
                  symtab: *of.SymtabEntry, symtab_count: u32, destination: *publication.Destination, name: *u8,
                  image_options: of.ImageOptions) R.Result[R.Void, str] {
    ret R.err[R.Void, str](RAW_UNSUPPORTED);
}

pub fun register(reg: *of.OfRegistry) R.Result[R.Void, str] {
    var raw_vtable: of.OfVTable = of.direct_image_vtable(
        of.OF_RAW, of.of_name_for(of.OF_RAW), "",
        emit_object, parse_object, emit_exec, exec_image
    );
    of.with_dynamic_exec(?raw_vtable, emit_dyn_exec);

    raw_vtable.two_level_namespace = false;

    raw_vtable.default_debug    = "";
    raw_vtable.shared_input_ext = "";
    raw_vtable.import_address_prefix = "";
    raw_vtable.header_in_first_segment = false;
    raw_vtable.carries_stack_size = false;
    raw_vtable.default_stack_reserve = 0;
    raw_vtable.executable_section_location = nil;

    raw_vtable.covers_isa_any   = true;
    raw_vtable.covers_isa_count = 0;

    ret of.register(reg, ?raw_vtable);
}

fun t_isa(id: u32) of.ObjectTarget {
    var vt: isa.IsaVTable = isa.machine_isa(id, "test", 0, 8, nil, nil, nil);
    var out: of.ObjectTarget;
    isa.object_target(?vt, ?out);
    ret out;
}

test "mach.lang.target.of.raw.register:installs_vtable" {
    var reg: of.OfRegistry = of.registry_init();
    fin { of.registry_dnit(?reg); }

    val res_register: R.Result[R.Void, str] = register(?reg);
    if (R.is_err[R.Void, str](res_register)) { ret 1; }

    val opt_vt: O.Option[*of.OfVTable] = of.lookup(?reg, "raw");
    if (!O.is_some[*of.OfVTable](opt_vt)) { ret 1; }
    if (O.unwrap[*of.OfVTable](opt_vt).id != of.OF_RAW) { ret 1; }

var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    var image:  of.ObjectImage;

    val res_obj: R.Result[R.Void, str] = emit_object(?isa_vt, ?image, nil::*publication.Destination);
    if (!R.is_err[R.Void, str](res_obj))                                   { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](res_obj), "executables")) { ret 1; }
    ret 0;
}

test "mach.lang.target.of.raw.emit_exec:flat_layout" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code_bytes: [4]u8;
    code_bytes[0] = 0xEB; code_bytes[1] = 0xFE; code_bytes[2] = 0x90; code_bytes[3] = 0x90;
    var data_bytes: [4]u8;
    data_bytes[0] = 0xDE; data_bytes[1] = 0xAD; data_bytes[2] = 0xBE; data_bytes[3] = 0xEF;

    var segs: [2]of.LoadSegment;
    segs[0].vaddr = 0x1000; segs[0].filesz = 4; segs[0].memsz = 4;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];
    segs[1].vaddr = 0x1010; segs[1].filesz = 4; segs[1].memsz = 4;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = ?data_bytes[0];

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "raw_flat");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] =
        t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2, 4096, 0x1000, 0x1000,
                  nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                  nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                  tpath::*u8, "rawflat"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 1; }
    var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    if (b.len != 0x14) { vector.dnit[u8](?b); ret 1; }

    if (b.data[0] == 0x7F)   { vector.dnit[u8](?b); ret 1; }
    if (b.data[0] != 0xEB)   { vector.dnit[u8](?b); ret 1; }
    if (b.data[1] != 0xFE)   { vector.dnit[u8](?b); ret 1; }

    var k: usize = 4;
    for (k < 0x10) {
        if (b.data[k] != 0x00) { vector.dnit[u8](?b); ret 1; }
        k = k + 1;
    }

    if (b.data[0x10] != 0xDE) { vector.dnit[u8](?b); ret 1; }
    if (b.data[0x13] != 0xEF) { vector.dnit[u8](?b); ret 1; }

    vector.dnit[u8](?b);
    ret 0;
}

test "mach.lang.target.of.raw.emit_exec:planned_size_is_the_written_size" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code_bytes: [5]u8;
    code_bytes[0] = 0xEB; code_bytes[1] = 0xFE; code_bytes[2] = 0x90;
    code_bytes[3] = 0x90; code_bytes[4] = 0x90;
    var data_bytes: [3]u8;
    data_bytes[0] = 0xDE; data_bytes[1] = 0xAD; data_bytes[2] = 0xBE;

    var segs: [2]of.LoadSegment;
    segs[0].vaddr = 0x2000; segs[0].filesz = 5; segs[0].memsz = 5;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];
    segs[1].vaddr = 0x2011; segs[1].filesz = 3; segs[1].memsz = 3;
    segs[1].flags = of.SEG_FLAG_READ; segs[1].bytes = ?data_bytes[0];

    var planned_base: u64 = 0;
    var planned_size: usize = 0;
    val ir: R.Result[*u8, str] =
        exec_image(?alloc, ?segs[0], 2, 0x2000, ?planned_base, ?planned_size);
    if (R.is_err[*u8, str](ir)) { ret 1; }
    A.deallocate[u8](?alloc, R.unwrap_ok[*u8, str](ir), planned_size);
    if (planned_base != 0x2000) { ret 2; }
    if (planned_size != 0x14)   { ret 3; }

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "raw_size");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 4; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] =
        t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2, 4096, 0x2000, 0x2000,
                  nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                  nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                  tpath::*u8, "rawsize"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 5; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 6; }
    var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);
    val written: usize = b.len;
    vector.dnit[u8](?b);
    if (written != planned_size) { ret 7; }
    ret 0;
}

test "mach.lang.target.of.raw.emit_exec:bss_is_stored_as_zeroes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code_bytes: [8]u8;
    code_bytes[0] = 0xEB; code_bytes[1] = 0xFE; code_bytes[2] = 0x90; code_bytes[3] = 0x90;
    code_bytes[4] = 0x90; code_bytes[5] = 0x90; code_bytes[6] = 0x90; code_bytes[7] = 0x90;

    var segs: [2]of.LoadSegment;
    segs[0].vaddr = 0x1000; segs[0].filesz = 8; segs[0].memsz = 8;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];
    segs[1].vaddr = 0x1008; segs[1].filesz = 0; segs[1].memsz = 64;
    segs[1].flags = of.SEG_FLAG_READ | of.SEG_FLAG_WRITE; segs[1].bytes = nil;

    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "raw_bss");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret 1; }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val tpath: str = fs.temp_path(?tf);

    val em: R.Result[R.Void, str] =
        t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 2, 4096, 0x1000, 0x1000,
                  nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                  nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                  tpath::*u8, "rawbss"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_err[R.Void, str](em)) { fs.temp_close_and_remove(?tf); ret 1; }

    val rr: R.Result[Vector[u8], str] = fs.read_bytes(?alloc, tpath);
    fs.temp_close_and_remove(?tf);
    if (R.is_err[Vector[u8], str](rr)) { ret 1; }
    var b: Vector[u8] = R.unwrap_ok[Vector[u8], str](rr);

    if (b.len != 72) { vector.dnit[u8](?b); ret 1; }

    if (b.data[0] != 0xEB) { vector.dnit[u8](?b); ret 1; }
    if (b.data[7] != 0x90) { vector.dnit[u8](?b); ret 1; }

    var k: usize = 8;
    for (k < 72) {
        if (b.data[k] != 0x00) { vector.dnit[u8](?b); ret 1; }
        k = k + 1;
    }

    vector.dnit[u8](?b);
    ret 0;
}

test "mach.lang.target.of.raw.emit_exec:entry_must_be_base" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var i: intern.Interner = intern.init(?alloc);

    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);

    var code_bytes: [4]u8;
    code_bytes[0] = 0x90; code_bytes[1] = 0x90; code_bytes[2] = 0x90; code_bytes[3] = 0x90;

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x1000; segs[0].filesz = 4; segs[0].memsz = 4;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];

    val em: R.Result[R.Void, str] =
        t_planned_emit_exec(?alloc, ?i, ?isa_vt, ?segs[0], 1, 4096, 0x1000, 0x1008,
                  nil::*of.ExecFunction, 0, nil::*of.Section, 0,
                  nil::*of.Section, 0, nil::*of.SymtabEntry, 0,
                  "raw_should_not_exist"::*u8,
                  "rawbad"::*u8, of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (!R.is_err[R.Void, str](em))                                { ret 1; }
    if (!str_contains(R.unwrap_err[R.Void, str](em), "base"))      { ret 1; }
    ret 0;
}

test "mach.lang.target.of.raw.exec_image:refuses_filesz_beyond_memsz" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var code_bytes: [8]u8;
    var z: usize = 0;
    for (z < 8) { code_bytes[z] = 0x90; z = z + 1; }

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0x1000; segs[0].filesz = 8; segs[0].memsz = 4;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];

    var flat_base: u64 = 0;
    var size: usize = 0;
    val rb: R.Result[*u8, str] = exec_image(?alloc, ?segs[0], 1, 0x1000, ?flat_base, ?size);
    if (!R.is_err[*u8, str](rb))                                          { ret 1; }
    if (!str_contains(R.unwrap_err[*u8, str](rb), "escapes"))            { ret 1; }
    ret 0;
}

test "mach.lang.target.of.raw.exec_image:refuses_address_space_overflow" {
    var alloc: A.Allocator;
    page.make(?alloc);

    var code_bytes: [8]u8;
    var z: usize = 0;
    for (z < 8) { code_bytes[z] = 0x90; z = z + 1; }

    var segs: [1]of.LoadSegment;
    segs[0].vaddr = 0xFFFFFFFFFFFFFFF0; segs[0].filesz = 8; segs[0].memsz = 32;
    segs[0].flags = of.SEG_FLAG_READ | of.SEG_FLAG_EXECUTE; segs[0].bytes = ?code_bytes[0];

    var flat_base: u64 = 0;
    var size: usize = 0;
    val rb: R.Result[*u8, str] = exec_image(?alloc, ?segs[0], 1, 0xFFFFFFFFFFFFFFF0, ?flat_base, ?size);
    if (!R.is_err[*u8, str](rb))                                        { ret 1; }
    if (!str_contains(R.unwrap_err[*u8, str](rb), "overflow"))         { ret 1; }
    ret 0;
}


fun t_publication_open(operation: *publication.Plan, alloc: *A.Allocator, name: str) R.Result[*publication.Destination, str] {
    val initialized: O.Option[txn.Error] = publication.plan_init(operation, alloc);
    if (O.is_some[txn.Error](initialized)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](initialized))); }
    val destination: R.Result[*publication.Destination, str] = publication.plan_add(operation, name, false);
    if (R.is_err[*publication.Destination, str](destination)) { ret destination; }
    val sealed: O.Option[txn.Error] = publication.plan_seal(operation);
    if (O.is_some[txn.Error](sealed)) { ret R.err[*publication.Destination, str](txn.error_message(O.unwrap[txn.Error](sealed))); }
    ret destination;
}

fun t_publication_close(operation: *publication.Plan, result: R.Result[R.Void, str]) R.Result[R.Void, str] {
    val closed: O.Option[txn.Error] = publication.plan_dnit(operation);
    if (R.is_ok[R.Void, str](result) && O.is_some[txn.Error](closed)) {
        ret R.err[R.Void, str](txn.error_message(O.unwrap[txn.Error](closed)));
    }
    ret result;
}

fun t_planned_emit_exec(alloc: *A.Allocator, itn: *intern.Interner, tgt_isa: *of.ObjectTarget, segs: *of.LoadSegment,
              seg_count: u32, page_size: u64, image_base: u64, entry: u64,
              funcs: *of.ExecFunction,
              func_count: u32, exceptions: *of.Section, exception_count: u32,
              debug: *of.Section, debug_count: u32,
              symtab: *of.SymtabEntry, symtab_count: u32, path: *u8, name: *u8,
              image_options: of.ImageOptions) R.Result[R.Void, str] {
    if (path == nil) { ret emit_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, nil::*publication.Destination, name, image_options); }
    var operation: publication.Plan;
    val opened: R.Result[*publication.Destination, str] = t_publication_open(?operation, alloc, path::str);
    if (R.is_err[*publication.Destination, str](opened)) { ret t_publication_close(?operation, R.err[R.Void, str](R.unwrap_err[*publication.Destination, str](opened))); }
    ret t_publication_close(?operation, emit_exec(alloc, itn, tgt_isa, segs, seg_count, page_size, image_base, entry, funcs, func_count, exceptions, exception_count, debug, debug_count, symtab, symtab_count, R.unwrap_ok[*publication.Destination, str](opened), name, image_options));
}

test "mach.lang.target.of.raw.emit_exec:rejects_nil_destination" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var isa_vt: of.ObjectTarget = t_isa(isa.ARCH_X86_64);
    val written: R.Result[R.Void, str] = emit_exec(?alloc, ?itn, ?isa_vt,
        nil::*of.LoadSegment, 0, 4096, 0x1000, 0x1000,
        nil::*of.ExecFunction, 0, nil::*of.Section, 0, nil::*of.Section, 0,
        nil::*of.SymtabEntry, 0, nil::*publication.Destination, "test"::*u8,
        of.image_options_default(of.SUBSYSTEM_CONSOLE));
    if (R.is_ok[R.Void, str](written)) { ret 2; }
    if (!str_contains(R.unwrap_err[R.Void, str](written), "nil exec path")) { ret 3; }
    ret 0;
}
