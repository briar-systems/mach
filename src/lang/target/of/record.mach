# the object cache's record: opaque bytes an object carries for the build
# that wrote it, in a section no link loads. elf and coff name it
# `.mach.cache`, mach-o `__MACH,__mach_cache`. the emitter writes the section
# when the image carries a record, and the parser moves its bytes back into
# the image, leaving the zero-length husk the linker already skips, so an
# object with a record links exactly as one without

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.target.of;
use mach.lang.target.of.exports;
use std.allocator.page;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

pub val SECTION_NAME: str = ".mach.cache";

# a view of `img` whose sections carry the record in a section named `name`
# shaped by `template`; the caller releases it with `exports.release`. the
# record bytes stay the image's
pub fun with_record(alloc: *A.Allocator, img: *of.ObjectImage, name: str, template: of.Section,
    out: *of.ObjectImage) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.intern(img.interner, name);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    ret exports.with_section(alloc, img, name_r.ok, template, img.cache_record, img.cache_record_len, out);
}

# moves the record out of section `index` into the image and leaves the husk.
# a husk reads as no record
pub fun take(img: *of.ObjectImage, index: u32) err[fail.Fail] {
    val sec: *of.Section = ?img.sections[index];
    if (sec.len == 0)            { ret err[fail.Fail].ok{}; }
    if (sec.bytes == nil)        { ret err[fail.Fail].err{fail.message("of: .mach.cache section has no contents")}; }
    if (img.cache_record != nil) { ret err[fail.Fail].err{fail.message("of: cache record decoded twice into one image")}; }
    img.cache_record     = sec.bytes;
    img.cache_record_len = sec.len;
    sec.bytes            = nil;
    sec.len              = 0;
    ret err[fail.Fail].ok{};
}

# the section named `name`, when the object has one, moved into the image
pub fun consume(itn: *intern.Interner, img: *of.ObjectImage, name: str) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.intern(itn, name);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val found: opt[u32] = exports.find(img, name_r.ok);
    if (sel found.none) { ret err[fail.Fail].ok{}; }
    ret take(img, found.some);
}

test take__moves_the_record_and_leaves_a_husk {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val name_r: res[intern.StrId, A.Error] = intern.intern(?itn, SECTION_NAME);
    if (sel name_r.err) { ret 1; }
    val bytes_r: res[*u8, A.Error] = A.allocate[u8](?alloc, 3);
    if (sel bytes_r.err) { ret 1; }
    bytes_r.ok[0] = 7;
    val sections_r: res[*of.Section, A.Error] = A.zallocate[of.Section](?alloc, 1);
    if (sel sections_r.err) { ret 1; }
    var img: of.ObjectImage = of.object_image_init(?alloc, ?itn, intern.STR_NIL);
    fin { of.object_image_dnit(?img); }
    img.sections          = sections_r.ok;
    img.section_count     = 1;
    img.section_cap       = 1;
    img.sections[0].name  = name_r.ok;
    img.sections[0].kind  = of.SK_DEBUG;
    img.sections[0].bytes = bytes_r.ok;
    img.sections[0].len   = 3;
    val taken: err[fail.Fail] = consume(?itn, ?img, SECTION_NAME);
    if (sel taken.err)                                               { ret 2; }
    if (img.cache_record != bytes_r.ok || img.cache_record_len != 3) { ret 3; }
    if (img.sections[0].len != 0 || img.sections[0].bytes != nil)    { ret 4; }
    # the husk reads as no record and leaves the one already taken alone
    val again: err[fail.Fail] = consume(?itn, ?img, SECTION_NAME);
    if (sel again.err)                  { ret 5; }
    if (img.cache_record != bytes_r.ok) { ret 6; }
    ret 0;
}
