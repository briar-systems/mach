use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use mach.lang.ct;
use mach.lang.float;
use extension_riscv: mach.lang.target.extension.riscv;
use target_model:    mach.lang.target.model;

pub val GPR_COUNT: i32 = 32;

pub val FPR_COUNT: i32 = 30;

pub val HAS_FLOAT: bool = true;

val CLASSES: [2]target_model.RegClass = [2]target_model.RegClass{
    target_model.RegClass{name: "gpr", kind: target_model.RC_GENERAL, len: GPR_COUNT::u32},
    target_model.RegClass{name: "fpr", kind: target_model.RC_FLOAT, len: FPR_COUNT::u32},
};

# Zfhmin converts f16 to and from binary32 (fcvt.s.h, fcvt.h.s) and, with D,
# binary64 (fcvt.d.h, fcvt.h.d), and Zfh adds the arithmetic, comparisons
# and integer conversions on the h format. each is the correctly rounded
# result, and a NaN comes out as the canonical NaN, which is riscv's
# CANONICAL rule the expansion follows too. the 64-bit integer rows are
# rv64's alone
val HALF_FORMS: [17]target_model.PackedForm = [17]target_model.PackedForm{
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 32, from_bits: 16, ext: extension_riscv.ZFHMIN},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 32, ext: extension_riscv.ZFHMIN},
    target_model.PackedForm{op: target_model.VEC_OP_FP_EXT, is_float: true, lane_bits: 64, from_bits: 16, ext: extension_riscv.ZFHMIN | extension_riscv.D},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TRUNC, is_float: true, lane_bits: 16, from_bits: 64, ext: extension_riscv.ZFHMIN | extension_riscv.D},
    target_model.PackedForm{op: target_model.VEC_OP_ADD, is_float: true, lane_bits: 16, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_SUB, is_float: true, lane_bits: 16, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_MUL, is_float: true, lane_bits: 16, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_DIV, is_float: true, lane_bits: 16, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_CMP, is_float: true, lane_bits: 16, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 32, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 32, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 32, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_SI, is_float: false, lane_bits: 64, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_FP_TO_UI, is_float: false, lane_bits: 64, from_bits: 16, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_SI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: extension_riscv.ZFH},
    target_model.PackedForm{op: target_model.VEC_OP_UI_TO_FP, is_float: true, lane_bits: 16, from_bits: 64, ext: extension_riscv.ZFH},
};

# RISC-V Cryptography Extensions Volume I (scalar), chapter "Data Independent
# Execution Latency Subset: Zkt", table RVM lists mul, mulh, mulhsu, mulhu and (rv64)
# mulw and excludes div and rem; riscv64 declares them for a selection holding M and
# Zkt, riscv32 declares none yet
val CT_MUL: [7]ct.CtMulForm = [7]ct.CtMulForm{
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 8, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT},
    ct.CtMulForm{op: ct.CT_MUL_LOW, width: 64, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_U, width: 64, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_S, width: 64, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT},
    ct.CtMulForm{op: ct.CT_MUL_HIGH_SU, width: 64, lanes: 0, cond: ct.CT_MUL_EXTENSION, ext: extension_riscv.M | extension_riscv.ZKT}
};

val ALU_WIDTHS64: [2]target_model.AluWidth = [2]target_model.AluWidth{
    target_model.AluWidth{bytes: 4, ext: 0},
    target_model.AluWidth{bytes: 8, ext: 0},
};

val ALU_WIDTHS32: [1]target_model.AluWidth = [1]target_model.AluWidth{
    target_model.AluWidth{bytes: 4, ext: 0},
};

pub val MACHINE64: target_model.Machine = target_model.Machine{
    pointer_width:          8,
    gpr_width:              8,
    alu_widths:             ?ALU_WIDTHS64[0],
    alu_width_len:          2,
    spill_width:            8,
    endianness:             target_model.ENDIAN_LITTLE,
    reg_classes:            ?CLASSES[0],
    reg_class_len:          2,
    vector_bits:            target_model.VECTOR_BITS_128,
    max_vector_lanes:       target_model.VECTOR_LANES_UNBOUNDED,
    vec_mem_widths:         target_model.VEC_MEM_NONE,
    xbank_widths:           target_model.XBANK_4_8,
    slot_read_widths:       target_model.SLOT_READ_NONE,
    ct_mul_forms:           ?CT_MUL[0],
    ct_mul_form_len:        7,
    has_var_shift:          true,
    shift_count_mod_widths: target_model.SHIFT_MOD_4_8,
    has_mul:                true,
    has_float:              HAS_FLOAT,
    mul_hi_width:           8,
    # a 128-bit integer is two XLEN lanes on rv64; on rv32 it would be four
    # and go by reference under the psABI, which no consumer asks for
    int_widths:              target_model.INT_WIDTHS_1_2_4_8_16,
    mul_wide_form:           target_model.MULW_THREE_ADDRESS,
    flat_addressing:         true,
    indexed_memory:          false,
    sym_offset_bits:         25,
    mem_disp_bits:           0,
    function_align:          2,
    code_fill:               0,
    structured_control_flow: false,
    ct_trust_var_shift:      true,
    half_forms:              ?HALF_FORMS[0],
    half_form_len:           17,
    flen_bits:               64,
    # fcvt between float formats returns the canonical NaN (unprivileged ISA, NaN generation)
    nan_rule: float.NAN_CANONICAL,
    # every NaN an operation returns is the canonical one, whatever its operands
    nan_first_operand:    false,
    extensions:           extension_riscv.ALL,
    extension_table:      ?extension_riscv.NAMES[0],
    extension_count:      extension_riscv.NAME_COUNT,
    index_width:          64,
    vector_op_bytes:      16,
    vectors_in_registers: true,
    auto_vectorize:       true,
};

pub val MACHINE32: target_model.Machine = target_model.Machine{
    pointer_width:          4,
    gpr_width:              4,
    alu_widths:             ?ALU_WIDTHS32[0],
    alu_width_len:          1,
    spill_width:            4,
    endianness:             target_model.ENDIAN_LITTLE,
    reg_classes:            ?CLASSES[0],
    reg_class_len:          2,
    vector_bits:            target_model.VECTOR_BITS_128,
    max_vector_lanes:       target_model.VECTOR_LANES_UNBOUNDED,
    vec_mem_widths:         target_model.VEC_MEM_NONE,
    xbank_widths:           target_model.XBANK_4,
    slot_read_widths:       target_model.SLOT_READ_NONE,
    has_var_shift:          true,
    shift_count_mod_widths: target_model.SHIFT_MOD_4,
    has_mul:                true,
    has_float:              HAS_FLOAT,
    mul_hi_width:           4,
    # a 128-bit integer is two XLEN lanes on rv64; on rv32 it would be four
    # and go by reference under the psABI, which no consumer asks for
    int_widths:              target_model.INT_WIDTHS_1_2_4_8,
    mul_wide_form:           target_model.MULW_THREE_ADDRESS,
    flat_addressing:         true,
    indexed_memory:          false,
    sym_offset_bits:         25,
    mem_disp_bits:           0,
    function_align:          2,
    code_fill:               0,
    structured_control_flow: false,
    ct_trust_var_shift:      true,
    half_forms:              ?HALF_FORMS[0],
    half_form_len:           13,
    flen_bits:               64,
    # fcvt between float formats returns the canonical NaN (unprivileged ISA, NaN generation)
    nan_rule: float.NAN_CANONICAL,
    # every NaN an operation returns is the canonical one, whatever its operands
    nan_first_operand:    false,
    extensions:           extension_riscv.ALL,
    extension_table:      ?extension_riscv.NAMES[0],
    extension_count:      extension_riscv.NAME_COUNT,
    index_width:          32,
    vector_op_bytes:      16,
    vectors_in_registers: true,
    auto_vectorize:       true,
};

# the rows are Zkt's multiply list on riscv64, held for a selection with M and
# Zkt and for no other; riscv32 declares none
# narrows the registered template to one selection: the float and multiply facts,
# the register classes and the cross-bank widths follow the selected extensions
pub fun features_select(model: *target_model.Machine, bits: u64) {
    model.extensions    = bits;
    model.has_mul       = extension_riscv.has(bits, extension_riscv.M);
    model.mul_hi_width  = 0;
    model.mul_wide_form = target_model.MULW_NONE;
    if (model.has_mul) {
        model.mul_hi_width  = model.gpr_width;
        model.mul_wide_form = target_model.MULW_THREE_ADDRESS;
    }
    or {
        model.ct_mul_forms    = nil;
        model.ct_mul_form_len = 0;
    }
    model.has_float     = extension_riscv.has(bits, extension_riscv.F);
    model.flen_bits     = 0;
    model.reg_class_len = 1;
    model.xbank_widths  = target_model.XBANK_NONE;
    if (model.has_float) {
        model.reg_class_len = 2;
        model.flen_bits     = 32;
        model.xbank_widths  = target_model.XBANK_4;
        if (extension_riscv.has(bits, extension_riscv.D)) {
            model.flen_bits = 64;
            if (model.gpr_width == 8) { model.xbank_widths = target_model.XBANK_4_8; }
        }
    }
}

test model__declares_the_zkt_multiply_list {
    val none: ct.CtMulMask = ct.mul_mask_none();
    var want: ct.CtMulMask = ct.mul_mask_none();
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 8, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 16, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 32, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_HIGH_SU, 64, false));
    # realized, not declared: the full product is mul + mulh, and the low half
    # of a 128-bit product is the schoolbook over those
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_U, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_WIDE_S, 64, false));
    ct.mul_mask_add(?want, ct.mul_cell(ct.CT_MUL_LOW, 128, false));

    val m64: *target_model.Machine = ?MACHINE64;
    if (m64.ct_mul_form_len != 7) { ret 2; }
    var i: u32 = 0;
    for (i < m64.ct_mul_form_len) {
        if (m64.ct_mul_forms[i].cond != ct.CT_MUL_EXTENSION || m64.ct_mul_forms[i].ext != (extension_riscv.M | extension_riscv.ZKT)) { ret 3; }
        i = i + 1;
    }

    var zkt: target_model.Machine = @m64;
    features_select(?zkt, extension_riscv.DEFAULT64 | extension_riscv.ZKT);
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(?zkt, false), want)) { ret 4; }
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(?zkt, true), want))  { ret 5; }
    var bare: target_model.Machine = @m64;
    features_select(?bare, extension_riscv.I | extension_riscv.M | extension_riscv.ZKT);
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(?bare, false), want)) { ret 6; }
    var plain: target_model.Machine = @m64;
    features_select(?plain, extension_riscv.DEFAULT64);
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(?plain, true), none)) { ret 7; }
    var no_mul: target_model.Machine = @m64;
    features_select(?no_mul, extension_riscv.I | extension_riscv.ZKT);
    val no_mul_bad: opt[str] = target_model.ct_mul_forms_refusal(?no_mul);
    if (no_mul.ct_mul_form_len != 0 || sel no_mul_bad.some)                       { ret 8; }
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(?no_mul, true), none)) { ret 9; }

    var narrow: target_model.Machine = MACHINE32;
    if (narrow.ct_mul_form_len != 0) { ret 10; }
    features_select(?narrow, extension_riscv.DEFAULT32 | extension_riscv.ZKT);
    if (!ct.mul_mask_equals(target_model.ct_mul_rows_admit(?narrow, true), none)) { ret 11; }
    ret 0;
}

test features_select__narrows_the_template {
    var full: target_model.Machine = MACHINE64;
    features_select(?full, extension_riscv.DEFAULT64);
    if (full.extensions != extension_riscv.DEFAULT64 || !full.has_mul || full.mul_hi_width != 8
        || full.mul_wide_form != target_model.MULW_THREE_ADDRESS || full.int_widths != target_model.INT_WIDTHS_1_2_4_8_16
        || !full.has_float || full.flen_bits != 64 || full.reg_class_len != 2
        || full.xbank_widths != target_model.XBANK_4_8) { ret 2; }

    var base: target_model.Machine = MACHINE64;
    features_select(?base, extension_riscv.I);
    if (base.has_mul || base.mul_hi_width != 0 || base.mul_wide_form != target_model.MULW_NONE || base.has_float
        || base.flen_bits != 0 || base.reg_class_len != 1 || base.xbank_widths != target_model.XBANK_NONE) { ret 3; }

    var single: target_model.Machine = MACHINE64;
    features_select(?single, extension_riscv.I | extension_riscv.F | extension_riscv.ZICSR);
    if (single.has_mul || !single.has_float || single.flen_bits != 32
        || single.reg_class_len != 2 || single.xbank_widths != target_model.XBANK_4) { ret 4; }

    var narrow: target_model.Machine = MACHINE32;
    features_select(?narrow, extension_riscv.DEFAULT32);
    if (narrow.extensions != extension_riscv.DEFAULT32 || !narrow.has_mul || narrow.mul_hi_width != 4
        || narrow.mul_wide_form != target_model.MULW_THREE_ADDRESS || narrow.int_widths != target_model.INT_WIDTHS_1_2_4_8
        || narrow.has_float || narrow.flen_bits != 0 || narrow.reg_class_len != 1
        || narrow.xbank_widths != target_model.XBANK_NONE) { ret 5; }
    features_select(?narrow, extension_riscv.DEFAULT32 | extension_riscv.F | extension_riscv.D | extension_riscv.ZICSR);
    if (narrow.flen_bits != 64 || narrow.reg_class_len != 2 || narrow.xbank_widths != target_model.XBANK_4) { ret 6; }
    ret 0;
}
