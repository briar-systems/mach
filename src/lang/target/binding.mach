# a resolved target bound to the registry members it was resolved from: the
# description every stage reads and the vtables only the backend follows
use std.types.error.err;
use std.types.result.res;

use mach.lang.fail;
use mach.lang.target.abi;
use mach.lang.target.isa;
use target_of:       mach.lang.target.of;
use lang_target_os:  mach.lang.target.os;
use target_registry: mach.lang.target.registry;
use mach.lang.target.resolved;

# a binding borrows every vtable from the registry it was resolved against;
# the borrow is live exactly while that registry stays published
pub rec Binding {
    target:   resolved.Target;
    registry: *target_registry.TargetRegistry;
    os:       *lang_target_os.OsVTable;
    isa:      *isa.IsaVTable;
    object:   target_of.ObjectTarget;
    arch:     *isa.RegMachine;
    abi:      *abi.AbiVTable;
    of:       *target_of.OfVTable;
    debug:    *target_of.DebugVTable;
}

# the borrow check every backend entry runs before following a vtable:
# a binding resolved from a registry that has since been released is refused
pub fun live(b: *Binding) err[fail.Fail] {
    if (b == nil) { ret err[fail.Fail].err{fail.message("target: nil resolved target")}; }
    if (!target_registry.registry_published(b.registry)) {
        ret err[fail.Fail].err{fail.message("target: resolved target outlived the registry it was resolved against")};
    }
    ret err[fail.Fail].ok{};
}

# the view a backend reads, refused for a binding that is no longer live
pub fun backend_target(b: *Binding) res[isa.BackendTarget, fail.Fail] {
    val borrow: err[fail.Fail] = live(b);
    if (sel borrow.err) { ret res[isa.BackendTarget, fail.Fail].err{borrow.err}; }
    val tgt:  *resolved.Target = ?b.target;
    var view: isa.BackendTarget;
    view.identity.arch_id               = tgt.arch_id;
    view.identity.os_id                 = tgt.os_id;
    view.identity.abi_id                = tgt.abi_id;
    view.identity.of_id                 = tgt.of_id;
    view.identity.debug_id              = tgt.debug_id;
    view.identity.arch_name             = b.isa.name;
    view.identity.os_name               = b.os.name;
    view.identity.abi_name              = b.abi.name;
    view.identity.of_name               = b.of.name;
    view.identity.env_id                = tgt.env_id;
    view.identity.env_profile           = tgt.env_profile;
    view.identity.env_name              = tgt.env_name;
    view.model                          = tgt.model;
    view.ct_mul                         = resolved.ct_mul_admitted(tgt);
    view.defs                           = tgt.defs;
    view.abi.gp_arg_regs                = b.abi.gp_arg_regs;
    view.abi.callee_saved               = b.abi.callee_saved;
    view.abi.indirect_result_reg        = b.abi.indirect_result_reg;
    view.abi.indirect_result_in_argfile = b.abi.indirect_result_in_argfile;
    view.abi.consumes_agg_layout        = b.abi.consumes_agg_layout;
    view.abi.fp_callee_saved_bytes      = b.abi.fp_callee_saved_bytes;
    view.abi.float_arg_bits             = b.abi.float_arg_bits;
    view.abi.arg_slot_granularity       = b.abi.arg_slot_granularity;
    view.abi.variadic_args_on_stack     = tgt.variadic_args_on_stack;
    view.abi.fixed_args_natural_size    = tgt.fixed_args_natural_size;
    view.abi.reg_arg_align              = tgt.reg_arg_align;
    view.abi.reg_arg_extend             = tgt.reg_arg_extend;
    view.abi.agg_arg_natural_align      = tgt.agg_arg_natural_align;
    view.abi.va_list_size               = tgt.va_list_size;
    view.abi.va_list_align              = tgt.va_list_align;
    view.os.entry_symbol                = b.os.entry_symbol;
    view.os.c_symbol_prefix             = b.os.c_symbol_prefix;
    view.os.image_base                  = tgt.base;
    if (view.os.image_base == 0) { view.os.image_base = b.os.base_addr; }
    view.os.page_size        = tgt.page_size;
    view.os.stack_probe      = b.os.stack_probe;
    view.os.mapped_by_loader = b.os.mapped_by_loader;
    view.os.stack_reserve    = tgt.stack_reserve;
    view.os.stack_commit     = tgt.stack_commit;
    ret res[isa.BackendTarget, fail.Fail].ok{view};
}
