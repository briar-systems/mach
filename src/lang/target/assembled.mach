# the target mirl assembles from a resolved target's tuple
#
# a resolved target names the five parts of mirl's tuple as their owners spell
# them: mink's architecture, system and environment, the member of the
# architecture's convention axis and masc's baseline. mirl assembles the target
# from them and opens the build the target's added extensions select, and every
# fact of layout and float behaviour the front end reads is read from it
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.bitset;
use std.collections.slice.Slice;
use std.collections.vector;
use std.memory;

use masc_extension: masc.core.extension;
use masc.core.requirement;
use mirl.ir.module.Tuple;
use types:           mirl.ir.type;
use mirl_target:     mirl.target;
use mirl_va:         mirl.target.abi.va;
use mirl_basis:      mirl.target.basis;
use mirl_capability: mirl.target.capability;
use mirl_record:     mirl.target.record;

use mach.lang.fail;
use mach.lang.layout;
use mach.lang.target.resolved;

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# the tuple a resolved target names its owners' parts by
pub fun tuple_of(t: *resolved.Target) Tuple {
    var env: str = mirl_record.NONE;
    if (sel t.env.some) { env = t.env.some.name; }
    ret Tuple{arch: view_of(t.arch.name), sys: view_of(t.sys.name), env: view_of(env), abi: view_of(t.abi), isa: view_of(t.isa)};
}

# the target mirl assembles from `tuple`, refused when it assembles none: a baseline
# that does not hold what the convention requires, or parts the owners rule out.
# given back by mirl_target.release
pub fun made(a: *A.Allocator, tuple: Tuple) res[mirl_target.Target, fail.Fail] {
    val made: res[mirl_target.Target, mirl_target.Refusal] = mirl_target.assemble(a, tuple);
    if (sel made.ok) { ret res[mirl_target.Target, fail.Fail].ok{made.ok}; }
    if (sel made.err.requires) {
        var unmet: mirl_target.Unmet = made.err.requires;
        fin { mirl_target.unmet_release(a, ?unmet); }
        val change: res[str, fail.Fail] = baseline_change(a, ?unmet);
        if (sel change.err) { ret res[mirl_target.Target, fail.Fail].err{change.err}; }
        ret res[mirl_target.Target, fail.Fail].err{fail.formatted(a,
            "target: isa `{}` does not hold what calling convention `{}` requires on {}, so mirl assembles no target from it; {}",
            tuple.isa.data::str, tuple.abi.data::str, tuple.arch.data::str, change.ok)};
    }
    ret res[mirl_target.Target, fail.Fail].err{fail.formatted(a, "target: mirl assembles no target from arch {}, sys {}, env {}, abi {}, isa {}: {}",
        tuple.arch.data::str, tuple.sys.data::str, tuple.env.data::str, tuple.abi.data::str, tuple.isa.data::str, mirl_target.rule(made.err))};
}

# the cheapest change to a baseline that admits a convention's requirement, as the atoms to
# add and the atoms to drop, each spelled as a manifest's `isa` spells it
fun baseline_change(a: *A.Allocator, u: *mirl_target.Unmet) res[str, fail.Fail] {
    val at: opt[usize] = mirl_target.nearest(u);
    if (sel at.none) { ret res[str, fail.Fail].ok{"state an isa that holds it"}; }
    val m:   *mirl_target.Missing = ?u.alternatives.data[at.some];
    var out: vector.Vector[u8]    = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    val written: err[A.Error] = change_put(a, ?out, u, m);
    if (sel written.err) { ret res[str, fail.Fail].err{fail.refused(written.err)}; }
    val copied: res[*u8, A.Error] = A.allocate[u8](a, out.len + 1);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.refused(copied.err)}; }
    memory.raw_copy(copied.ok::ptr, out.data::ptr, out.len);
    copied.ok[out.len] = 0;
    ret res[str, fail.Fail].ok{copied.ok::str};
}

# the atoms `m` lacks and bars, worded onto `out`
fun change_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_target.Unmet, m: *mirl_target.Missing) err[A.Error] {
    if (m.lacks.len > 0) {
        val lead: err[A.Error] = text_put(out, "add ");
        if (sel lead.err) { ret lead; }
        val lacks: err[A.Error] = atoms_put(a, out, u, m.lacks);
        if (sel lacks.err) { ret lacks; }
    }
    if (m.bars.len > 0) {
        var word: str = "drop ";
        if (m.lacks.len > 0) { word = " and drop "; }
        val lead: err[A.Error] = text_put(out, word);
        if (sel lead.err) { ret lead; }
        val bars: err[A.Error] = atoms_put(a, out, u, m.bars);
        if (sel bars.err) { ret bars; }
    }
    ret text_put(out, " to its isa");
}

# the atoms `ids` spelled onto `out`, joined by `+`
fun atoms_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_target.Unmet, ids: requirement.Ids) err[A.Error] {
    var i: u32 = 0;
    for (i < ids.len) {
        if (i > 0) {
            val joined: err[A.Error] = text_put(out, "+");
            if (sel joined.err) { ret joined; }
        }
        val put: err[A.Error] = atom_put(a, out, u, ids.at[i]);
        if (sel put.err) { ret put; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# atom `id` spelled onto `out`: masc's spelling of a selection of the one extension in the
# architecture's syntax, without its `+`, else the catalog's name for it
fun atom_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_target.Unmet, id: requirement.Id) err[A.Error] {
    if (sel u.set.some) {
        val c: *masc_extension.Catalog = u.set.some.extensions;
        if (id < c.count) {
            val made: res[bitset.Bitset, A.Error] = bitset.init(a, c.count::usize);
            if (sel made.err) { ret err[A.Error].err{made.err}; }
            var one: masc_extension.Selection = masc_extension.Selection{catalog: c, members: made.ok, stated: masc_extension.Stated{at: [masc_extension.MAX_STATED]requirement.Id{0, 0, 0, 0, 0, 0, 0, 0}, len: 0}};
            fin { val dropped: err[A.Error] = bitset.dnit(?one.members); }
            bitset.set(?one.members, id::usize);
            var spelled: vector.Vector[u8] = vector.init[u8](a);
            fin { vector.dnit[u8](?spelled); }
            val wrote: err[A.Error] = masc_extension.spell(?one, ?spelled);
            if (sel wrote.err) { ret wrote; }
            var from: usize = 0;
            if (spelled.len > 0 && spelled.data[0] == '+') { from = 1; }
            for (from < spelled.len) {
                val pushed: res[usize, A.Error] = vector.push[u8](out, spelled.data[from]);
                if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
                from = from + 1;
            }
            ret err[A.Error].ok{};
        }
    }
    val named: opt[str] = mirl_target.unmet_name(u, id);
    if (sel named.some) { ret text_put(out, named.some); }
    ret text_put(out, "an atom of the architecture's state");
}

fun text_put(out: *vector.Vector[u8], text: str) err[A.Error] {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, text[i]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the target mirl assembled for a resolved target and the build basis its added
# extensions opened, which lowering lays types out under and compilation adds the
# added names to
# ---
# tuple: the five parts the target was assembled from, which name its modules
# names: the names of masc's catalog the target adds over its baseline
pub rec Assembled {
    tuple:  Tuple;
    target: mirl_target.Target;
    basis:  mirl_target.Basis;
    based:  bool;
    names:  [resolved.MAX_ADDED]str;
    count:  usize;
}

# the target mirl assembles for `t`, with the build its added extensions select
# opened. given back by release
pub fun assemble(a: *A.Allocator, t: *resolved.Target) res[*Assembled, fail.Fail] {
    if (!resolved.is_selected(t)) { ret res[*Assembled, fail.Fail].err{fail.message("target: no target is selected, so mirl assembles none")}; }
    val tuple: Tuple                              = tuple_of(t);
    val built: res[mirl_target.Target, fail.Fail] = made(a, tuple);
    if (sel built.err) { ret res[*Assembled, fail.Fail].err{built.err}; }
    val boxed: res[*Assembled, A.Error] = A.allocate[Assembled](a, 1);
    if (sel boxed.err) {
        var target: mirl_target.Target = built.ok;
        mirl_target.release(a, ?target);
        ret res[*Assembled, fail.Fail].err{fail.refused(boxed.err)};
    }
    val x: *Assembled = boxed.ok;
    x.tuple  = tuple;
    x.target = built.ok;
    x.based  = false;
    x.count  = t.added_count::usize;
    var i: usize = 0;
    for (i < x.count) {
        x.names[i] = t.added[i];
        i          = i + 1;
    }
    if (sel x.target.isa.required) {
        val chosen: err[mirl_basis.Error] = mirl_target.choose(?x.basis, a, ?x.target, added(x));
        if (sel chosen.err) {
            mirl_target.release(a, ?x.target);
            A.deallocate[Assembled](a, x, 1);
            ret res[*Assembled, fail.Fail].err{fail.formatted(a, "target: mirl opens no build of {} {} over isa `{}` with the extensions the target adds: {}",
                t.arch.name, t.sys.name, t.isa, mirl_basis.fact(chosen.err))};
        }
        x.based = true;
    }
    ret res[*Assembled, fail.Fail].ok{x};
}

# the names the target adds over its baseline
pub fun added(x: *Assembled) Slice[str] {
    ret Slice[str]{data: ?x.names[0], size: x.count};
}

# the build basis the added extensions opened, none for a target that states no baseline
pub fun basis_of(x: *Assembled) opt[*mirl_target.Basis] {
    if (x.based) { ret opt[*mirl_target.Basis].some{?x.basis}; }
    ret mirl_target.NONE;
}

pub fun release(a: *A.Allocator, x: *Assembled) {
    if (x.based) { mirl_target.drop(?x.basis); }
    mirl_target.release(a, ?x.target);
    A.deallocate[Assembled](a, x, 1);
}

# the nan each float format's operations return on the assembled target, unstated
# for a format it holds under no row
pub fun nans_of(x: *Assembled) resolved.Nans {
    var out: resolved.Nans = resolved.nans_none();
    var i:   usize         = 0;
    for (i < 3) {
        val got: res[mirl_capability.Nans, mirl_basis.Error] = mirl_target.nans(basis_of(x), ?x.target.caps, format_of(layout.FLOAT_WIDTHS[i]));
        if (sel got.ok) { out.formats[i] = got.ok; }
        i = i + 1;
    }
    ret out;
}

# the `va_list` of the assembled target's own convention, as mirl's row of the
# convention states it and its data layout lays it out
pub fun va_list_of(a: *A.Allocator, x: *Assembled) resolved.VaList {
    var t: types.Table = types.init(a);
    fin { types.dnit(?t); }
    var l:      mirl_target.Layout                      = mirl_target.of(?x.target, ?t, mirl_target.context_of(basis_of(x)));
    val listed: res[opt[mirl_va.Listed], mirl_va.Error] = mirl_va.va_list(?l, View{data: "", len: 0});
    if (sel listed.err)     { ret resolved.VaList.refused{va_refusal(listed.err)}; }
    if (sel listed.ok.none) { ret resolved.VaList.unlisted{}; }
    ret resolved.VaList.listed{layout.extent(listed.ok.some.size::u32, listed.ok.some.align::u32)};
}

# why mirl answered no `va_list`, as a refusal of `abi_type("va_list")` says it
fun va_refusal(why: mirl_va.Error) str {
    if (sel why.alloc)       { ret "mirl had no storage to lay it out"; }
    if (sel why.conventions) { ret "mirl carries no convention of the target"; }
    if (sel why.named)       { ret "mirl's target names no row of the convention"; }
    if (sel why.unstated)    { ret "mirl's row of the convention leaves it unstated"; }
    if (sel why.layout)      { ret "mirl's data layout of the target does not lay it out"; }
    ret "mirl's data layout of the target disagrees with the convention's row";
}

# the extent mirl lays `shape` out at on `l`'s target, in the default address space
fun extent_of(l: *mirl_target.Layout, t: *types.Table, shape: types.Shape) res[layout.Extent, mirl_target.Error] {
    val ty: res[types.Type, types.Error] = types.intern(t, shape);
    if (sel ty.err) { ret res[layout.Extent, mirl_target.Error].err{mirl_target.Error.types{ty.err}}; }
    val e: res[mirl_target.Extent, mirl_target.Error] = mirl_target.extent(l, ty.ok, types.DEFAULT_SPACE);
    if (sel e.err) { ret res[layout.Extent, mirl_target.Error].err{e.err}; }
    ret res[layout.Extent, mirl_target.Error].ok{layout.extent(e.ok.size::u32, e.ok.align::u32)};
}

# the format of a float width
fun format_of(bits: u32) types.Format {
    if (bits == 16) { ret types.BINARY16; }
    if (bits == 32) { ret types.BINARY32; }
    ret types.BINARY64;
}

# the vector registers mirl fits a vector to, none where it states no register fit
# and a vector aligns to its element
fun registers_of(x: *Assembled) opt[layout.Registers] {
    val rule: mirl_capability.VectorRule = x.target.data.vectors;
    if (!(sel rule.register)) { ret opt[layout.Registers].none{}; }
    val widest: res[u64, mirl_capability.Unread] = mirl_capability.widest_register(mirl_target.context_of(basis_of(x)), rule.register);
    if (sel widest.err) { ret opt[layout.Registers].none{}; }
    ret opt[layout.Registers].some{layout.Registers{narrow: rule.register.narrow, widest: widest.ok::u32}};
}

# the extents mirl's data layout of the assembled target gives every primitive under its
# build basis, and the vector registers it fits vectors to. a pointer mirl holds logically,
# or under an addressing model that holds no address of it, has none
pub fun scalars_of(a: *A.Allocator, x: *Assembled) res[layout.Scalars, fail.Fail] {
    var t: types.Table = types.init(a);
    fin { types.dnit(?t); }
    var l: mirl_target.Layout = mirl_target.of(?x.target, ?t, mirl_target.context_of(basis_of(x)));
    var s: layout.Scalars     = layout.scalars_none();
    var i: usize              = 0;
    for (i < 5) {
        val e: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.integer{types.Integer{width: layout.INTEGER_WIDTHS[i]}});
        if (sel e.err) { ret res[layout.Scalars, fail.Fail].err{fail.formatted(a, "target: mirl lays out no {}-bit integer on this target", layout.INTEGER_WIDTHS[i])}; }
        s.integers[i] = e.ok;
        i             = i + 1;
    }
    i = 0;
    for (i < 3) {
        val e: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.float{types.Float{format: format_of(layout.FLOAT_WIDTHS[i])}});
        if (sel e.err) { ret res[layout.Scalars, fail.Fail].err{fail.formatted(a, "target: mirl lays out no {}-bit float on this target", layout.FLOAT_WIDTHS[i])}; }
        s.floats[i] = e.ok;
        i           = i + 1;
    }
    val p: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
    if (sel p.ok) { s.pointer = opt[layout.Extent].some{p.ok}; }
    or (sel p.err) {
        if (!(sel p.err.unsized) && !(sel p.err.unmodelled)) { ret res[layout.Scalars, fail.Fail].err{fail.message("target: mirl lays out no pointer on this target")}; }
    }
    s.vectors = registers_of(x);
    s.held    = true;
    ret res[layout.Scalars, fail.Fail].ok{s};
}
