# the owners' target each mach target cell means
#
# a mach target cell, an operating system, an instruction set and a calling
# convention, names one target of mirl's, assembled from the five parts of its
# tuple the lower layers own: mink's architecture, system and environment, the
# architecture's convention and masc's baseline. the cell states every part as
# its owners spell it and mirl assembles it, so mach states which target it
# means and none of its facts. a cell no owner assembles yet keeps mach's own
# facts until one does (#4779)
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.page;
use std.collections.bitset;
use std.collections.slice.Slice;
use std.collections.vector;
use std.memory;

use masc_extension: masc.core.extension;
use masc.core.requirement;
use mirl.ir.module.Tuple;
use types:           mirl.ir.type;
use mirl_target:     mirl.target;
use mirl_basis:      mirl.target.basis;
use mirl_capability: mirl.target.capability;

use mach.lang.fail;
use mach.lang.float;
use mach.lang.layout;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.extension;
use target_host: mach.lang.target.host;
use mach.lang.target.resolved;

# one mach target cell and the tuple its owners spell it by
# ---
# os, arch, abi: the cell, by mach's catalog ids
# system:       mink's system row
# architecture: mink's architecture row
# convention:   the member of the architecture's convention axis
# baseline:     masc's spelling of the selection a cell whose host states no
#               floor stands on, nil where the host's floor is it. a build adds
#               the extensions mach selects to it
rec Named {
    os:           u32;
    arch:         u32;
    abi:          u32;
    system:       str;
    architecture: str;
    convention:   str;
    baseline:     str;
}

# x86-64's baseline as masc spells it
val X86_64_BASE: str = "cmov,cx8,x87,fxsr,mmx,osfxsr,sce,sse,sse2";

# every cell an owner assembles. a hosted cell stands on its host's floor.
# riscv32 freestanding is rv32imac under ilp32, as mach's riscv32 freestanding
# has always selected imac, and aarch64 freestanding holds the fp and simd its
# convention passes in. vulkan states its own, since mink's vulkan floor names no
# SPIR-V version and mirl assembles no target from it. darwin on aarch64 is
# darwinpcs, the convention it is called under
val NAMED_COUNT: usize              = 10;
val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{os: catalog_os.LINUX, arch: catalog_arch.X86_64, abi: catalog_abi.SYSV, system: "linux", architecture: "x86_64", convention: "sysv64", baseline: nil},
    Named{os: catalog_os.DARWIN, arch: catalog_arch.X86_64, abi: catalog_abi.SYSV, system: "darwin", architecture: "x86_64", convention: "sysv64", baseline: nil},
    Named{os: catalog_os.WINDOWS, arch: catalog_arch.X86_64, abi: catalog_abi.WIN64, system: "windows", architecture: "x86_64", convention: "win64", baseline: nil},
    Named{os: catalog_os.FREESTANDING, arch: catalog_arch.X86_64, abi: catalog_abi.SYSV, system: "freestanding", architecture: "x86_64", convention: "sysv64", baseline: X86_64_BASE},
    Named{os: catalog_os.LINUX, arch: catalog_arch.AARCH64, abi: catalog_abi.AAPCS64, system: "linux", architecture: "aarch64", convention: "aapcs64", baseline: nil},
    Named{os: catalog_os.DARWIN, arch: catalog_arch.AARCH64, abi: catalog_abi.AAPCS64, system: "darwin", architecture: "aarch64", convention: "darwinpcs", baseline: nil},
    Named{os: catalog_os.FREESTANDING, arch: catalog_arch.AARCH64, abi: catalog_abi.AAPCS64, system: "freestanding", architecture: "aarch64", convention: "aapcs64", baseline: "armv8-a+fp+simd"},
    Named{os: catalog_os.LINUX, arch: catalog_arch.RISCV64, abi: catalog_abi.LP64D, system: "linux", architecture: "riscv64", convention: "lp64d", baseline: nil},
    Named{os: catalog_os.FREESTANDING, arch: catalog_arch.RISCV32, abi: catalog_abi.ILP32, system: "freestanding", architecture: "riscv32", convention: "ilp32", baseline: "rv32imac"},
    Named{os: catalog_os.VULKAN, arch: catalog_arch.SPIRV, abi: catalog_abi.SPIRV, system: "vulkan", architecture: "spirv", convention: "shader", baseline: "spv1.0,Shader"},
};

# the environment part of mirl's tuple for a target whose manifest states no `env`
val NO_ENV: str = "none";

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun named_of(os_id: u32, arch_id: u32, abi_id: u32) opt[*Named] {
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        val n: *Named = ?NAMED[i];
        if (n.os == os_id && n.arch == arch_id && n.abi == abi_id) { ret opt[*Named].some{n}; }
        i = i + 1;
    }
    ret opt[*Named].none{};
}

# the selection a named cell stands on: its own, else its host's floor
fun baseline_of(a: *A.Allocator, n: *Named, env: str) res[str, fail.Fail] {
    if (n.baseline != nil) { ret res[str, fail.Fail].ok{n.baseline}; }
    val floor: res[opt[str], fail.Fail] = target_host.floor(a, n.os, n.arch, n.abi, env);
    if (sel floor.err) { ret res[str, fail.Fail].err{floor.err}; }
    if (sel floor.ok.none) {
        ret res[str, fail.Fail].err{fail.formatted(a, "target: the host of {} {} states no floor for the cell to stand on", n.architecture, n.system)};
    }
    ret res[str, fail.Fail].ok{floor.ok.some};
}

# the target a named cell means over `baseline`, refused when mirl assembles none
# from its tuple: a baseline that does not hold what the convention requires, or
# the table here and the owners disagree. given back by mirl_target.release
fun assembled(a: *A.Allocator, n: *Named, env: str, baseline: str) res[mirl_target.Target, fail.Fail] {
    val tuple: Tuple                                        = Tuple{arch: view_of(n.architecture), sys: view_of(n.system), env: view_of(env), abi: view_of(n.convention), isa: view_of(baseline)};
    val made:  res[mirl_target.Target, mirl_target.Refusal] = mirl_target.assemble(a, tuple);
    if (sel made.err) {
        if (sel made.err.requires) {
            var unmet: mirl_target.Unmet = made.err.requires;
            fin { mirl_target.unmet_release(a, ?unmet); }
            val change: res[str, fail.Fail] = baseline_change(a, ?unmet);
            if (sel change.err) { ret res[mirl_target.Target, fail.Fail].err{change.err}; }
            ret res[mirl_target.Target, fail.Fail].err{fail.formatted(a,
                "target: baseline `{}` does not hold what calling convention `{}` requires on {}, so mirl assembles no target from it; {}",
                baseline, n.convention, n.architecture, change.ok)};
        }
        ret res[mirl_target.Target, fail.Fail].err{fail.formatted(a, "target: mirl assembles no target from {} {} {} {} {}: {}",
            n.architecture, n.system, env, n.convention, baseline, mirl_target.rule(made.err))};
    }
    ret res[mirl_target.Target, fail.Fail].ok{made.ok};
}

# the cheapest change to a baseline that admits a convention's requirement, as the atoms to
# add and the atoms to drop, each spelled as a manifest's baseline spells it
fun baseline_change(a: *A.Allocator, u: *mirl_target.Unmet) res[str, fail.Fail] {
    val at: opt[usize] = mirl_target.nearest(u);
    if (sel at.none) { ret res[str, fail.Fail].ok{"state a baseline that holds it"}; }
    val m:   *mirl_target.Missing = ?u.alternatives.data[at.some];
    var out: vector.Vector[u8]    = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    val written: err[A.Error] = change_put(a, ?out, u, m);
    if (sel written.err) { ret res[str, fail.Fail].err{fail.refused(written.err)}; }
    val copied: res[*u8, A.Error] = A.allocate[u8](a, out.len + 1);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.refused(copied.err)}; }
    memory.raw_copy(copied.ok::ptr, out.data::ptr, out.len);
    copied.ok[out.len] = 0;
    ret res[str, fail.Fail].ok{copied.ok::str};
}

# the atoms `m` lacks and bars, worded onto `out`
fun change_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_target.Unmet, m: *mirl_target.Missing) err[A.Error] {
    if (m.lacks.len > 0) {
        val lead: err[A.Error] = text_put(out, "add ");
        if (sel lead.err) { ret lead; }
        val lacks: err[A.Error] = atoms_put(a, out, u, m.lacks);
        if (sel lacks.err) { ret lacks; }
    }
    if (m.bars.len > 0) {
        var word: str = "drop ";
        if (m.lacks.len > 0) { word = " and drop "; }
        val lead: err[A.Error] = text_put(out, word);
        if (sel lead.err) { ret lead; }
        val bars: err[A.Error] = atoms_put(a, out, u, m.bars);
        if (sel bars.err) { ret bars; }
    }
    ret text_put(out, " to its baseline");
}

# the atoms `ids` spelled onto `out`, joined by `+` as a baseline joins them
fun atoms_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_target.Unmet, ids: requirement.Ids) err[A.Error] {
    var i: u32 = 0;
    for (i < ids.len) {
        if (i > 0) {
            val joined: err[A.Error] = text_put(out, "+");
            if (sel joined.err) { ret joined; }
        }
        val put: err[A.Error] = atom_put(a, out, u, ids.at[i]);
        if (sel put.err) { ret put; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# atom `id` spelled onto `out` as a manifest's baseline names it: masc's spelling of a
# selection of the one extension in the architecture's syntax, without its `+`, else the
# catalog's name for it
fun atom_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_target.Unmet, id: requirement.Id) err[A.Error] {
    if (sel u.set.some) {
        val c: *masc_extension.Catalog = u.set.some.extensions;
        if (id < c.count) {
            val made: res[bitset.Bitset, A.Error] = bitset.init(a, c.count::usize);
            if (sel made.err) { ret err[A.Error].err{made.err}; }
            var one: masc_extension.Selection = masc_extension.Selection{catalog: c, members: made.ok, stated: masc_extension.Stated{at: [masc_extension.MAX_STATED]requirement.Id{0, 0, 0, 0, 0, 0, 0, 0}, len: 0}};
            fin { val dropped: err[A.Error] = bitset.dnit(?one.members); }
            bitset.set(?one.members, id::usize);
            var spelled: vector.Vector[u8] = vector.init[u8](a);
            fin { vector.dnit[u8](?spelled); }
            val wrote: err[A.Error] = masc_extension.spell(?one, ?spelled);
            if (sel wrote.err) { ret wrote; }
            var from: usize = 0;
            if (spelled.len > 0 && spelled.data[0] == '+') { from = 1; }
            for (from < spelled.len) {
                val pushed: res[usize, A.Error] = vector.push[u8](out, spelled.data[from]);
                if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
                from = from + 1;
            }
            ret err[A.Error].ok{};
        }
    }
    val named: opt[str] = mirl_target.unmet_name(u, id);
    if (sel named.some) { ret text_put(out, named.some); }
    ret text_put(out, "an atom of the architecture's state");
}

fun text_put(out: *vector.Vector[u8], text: str) err[A.Error] {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        val pushed: res[usize, A.Error] = vector.push[u8](out, text[i]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the names of masc's catalog a selection of `t` holds, as a build adds them
# over its baseline, none for a table no masc catalog states
fun added_names(t: *extension.Table, bits: u64, out: *str, cap: usize) usize {
    if (t == nil || t.catalog == nil) { ret 0; }
    var n: usize = 0;
    var i: u32   = 0;
    for (i < t.count && n < cap) {
        val row: *extension.Extension = ?t.rows[i];
        if ((bits & row.bit) != 0 && row.handle < t.catalog.count) {
            out[n] = t.catalog.extensions[row.handle].name;
            n      = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

# what the owners state of one cell for mach's front end, read once when the
# target resolves
# ---
# scalars: the extents of every primitive and the vector registers
# nans:    the nan each float format's operations return
pub rec Owned {
    scalars: layout.Scalars;
    nans:    resolved.Nans;
}

# the most extensions a build adds over a cell's baseline
val ADDED_CAP: usize = 64;

# the target a cell means as mirl assembled it, and the build basis its selection opened,
# which lowering lays types out under and compilation adds the selection's names to
# ---
# tuple: the five parts the target was assembled from, which name its modules
# names: the names of masc's catalog the selection adds over the baseline
pub rec Assembled {
    tuple:  Tuple;
    target: mirl_target.Target;
    basis:  mirl_target.Basis;
    based:  bool;
    names:  [ADDED_CAP]str;
    count:  usize;
}

# the target of the cell of `os_id`, `arch_id` and `abi_id` standing on the selection the
# target spells, `spelled`, else the cell's own, under the selection `bits` of mach's
# extension table `t`, none for a cell no owner assembles yet. given back by release
pub fun assemble_for(a: *A.Allocator, os_id: u32, arch_id: u32, abi_id: u32, stated_env: str, spelled: opt[str], t: *extension.Table, bits: u64) res[opt[*Assembled], fail.Fail] {
    val n: opt[*Named] = named_of(os_id, arch_id, abi_id);
    if (sel n.none) { ret res[opt[*Assembled], fail.Fail].ok{opt[*Assembled].none{}}; }
    var env: str = stated_env;
    if (str_empty(env)) { env = NO_ENV; }
    var baseline: str = nil;
    if (sel spelled.some) { baseline = spelled.some; }
    or {
        val stands: res[str, fail.Fail] = baseline_of(a, n.some, stated_env);
        if (sel stands.err) { ret res[opt[*Assembled], fail.Fail].err{stands.err}; }
        baseline = stands.ok;
    }
    val made: res[mirl_target.Target, fail.Fail] = assembled(a, n.some, env, baseline);
    if (sel made.err) { ret res[opt[*Assembled], fail.Fail].err{made.err}; }
    val boxed: res[*Assembled, A.Error] = A.allocate[Assembled](a, 1);
    if (sel boxed.err) {
        var target: mirl_target.Target = made.ok;
        mirl_target.release(a, ?target);
        ret res[opt[*Assembled], fail.Fail].err{fail.refused(boxed.err)};
    }
    val x: *Assembled = boxed.ok;
    x.tuple  = Tuple{arch: view_of(n.some.architecture), sys: view_of(n.some.system), env: view_of(env), abi: view_of(n.some.convention), isa: view_of(baseline)};
    x.target = made.ok;
    x.based  = false;
    x.count  = added_names(t, bits, ?x.names[0], ADDED_CAP);
    if (sel x.target.isa.required) {
        val chosen: err[mirl_basis.Error] = mirl_target.choose(?x.basis, a, ?x.target, added(x));
        if (sel chosen.err) {
            mirl_target.release(a, ?x.target);
            A.deallocate[Assembled](a, x, 1);
            ret res[opt[*Assembled], fail.Fail].err{fail.formatted(a, "target: mirl opens no build of {} {} over {}", n.some.architecture, n.some.system, baseline)};
        }
        x.based = true;
    }
    ret res[opt[*Assembled], fail.Fail].ok{opt[*Assembled].some{x}};
}

# the target a resolved cell means, assembled over the selection it stands on
pub fun assemble_resolved(a: *A.Allocator, t: *resolved.Target) res[opt[*Assembled], fail.Fail] {
    ret assemble_for(a, t.os_id, t.arch_id, t.abi_id, t.env_name, t.stands, t.model.extension_table, t.model.extensions);
}

# the names the selection adds over the baseline
pub fun added(x: *Assembled) Slice[str] {
    ret Slice[str]{data: ?x.names[0], size: x.count};
}

# the build basis the selection opened, none for a target that states no baseline
pub fun basis_of(x: *Assembled) opt[*mirl_target.Basis] {
    if (x.based) { ret opt[*mirl_target.Basis].some{?x.basis}; }
    ret mirl_target.NONE;
}

pub fun release(a: *A.Allocator, x: *Assembled) {
    if (x.based) { mirl_target.drop(?x.basis); }
    mirl_target.release(a, ?x.target);
    A.deallocate[Assembled](a, x, 1);
}

# what the owners state of the cell of `os_id`, `arch_id` and `abi_id` standing on
# the selection the target spells, `spelled`, else the cell's own, under the
# selection `bits` of mach's extension table `t`, none for a cell no owner
# assembles yet
pub fun owned_for(a: *A.Allocator, os_id: u32, arch_id: u32, abi_id: u32, env: str, spelled: opt[str], t: *extension.Table, bits: u64) res[opt[Owned], fail.Fail] {
    val made: res[opt[*Assembled], fail.Fail] = assemble_for(a, os_id, arch_id, abi_id, env, spelled, t, bits);
    if (sel made.err)     { ret res[opt[Owned], fail.Fail].err{made.err}; }
    if (sel made.ok.none) { ret res[opt[Owned], fail.Fail].ok{opt[Owned].none{}}; }
    val x: *Assembled = made.ok.some;
    fin { release(a, x); }
    val held: res[layout.Scalars, fail.Fail] = scalars_of(a, ?x.target, basis_of(x));
    if (sel held.err) { ret res[opt[Owned], fail.Fail].err{held.err}; }
    ret res[opt[Owned], fail.Fail].ok{opt[Owned].some{Owned{scalars: held.ok, nans: nans_of(?x.target, basis_of(x))}}};
}

# the nan each float format's operations return on `target` under `basis`,
# unstated for a format it holds under no row
fun nans_of(target: *mirl_target.Target, basis: opt[*mirl_target.Basis]) resolved.Nans {
    var out: resolved.Nans = resolved.nans_none();
    var i:   usize         = 0;
    for (i < 3) {
        val got: res[mirl_capability.Nans, mirl_basis.Error] = mirl_target.nans(basis, ?target.caps, format_of(layout.FLOAT_WIDTHS[i]));
        if (sel got.ok) { out.formats[i] = got.ok; }
        i = i + 1;
    }
    ret out;
}

# the extent mirl lays `shape` out at on `l`'s target, in the default address space
fun extent_of(l: *mirl_target.Layout, t: *types.Table, shape: types.Shape) res[layout.Extent, mirl_target.Error] {
    val ty: res[types.Type, types.Error] = types.intern(t, shape);
    if (sel ty.err) { ret res[layout.Extent, mirl_target.Error].err{mirl_target.Error.types{ty.err}}; }
    val e: res[mirl_target.Extent, mirl_target.Error] = mirl_target.extent(l, ty.ok, types.DEFAULT_SPACE);
    if (sel e.err) { ret res[layout.Extent, mirl_target.Error].err{e.err}; }
    ret res[layout.Extent, mirl_target.Error].ok{layout.extent(e.ok.size::u32, e.ok.align::u32)};
}

# the format of a float width
fun format_of(bits: u32) types.Format {
    if (bits == 16) { ret types.BINARY16; }
    if (bits == 32) { ret types.BINARY32; }
    ret types.BINARY64;
}

# the vector registers mirl fits a vector to on `row` under `basis`, none where
# it states no register fit. spir-v's rule aligns a vector to its element, which
# mach's logical lowering does not take yet, so mach keeps its own there
fun registers_of(row: *mirl_target.Target, basis: opt[*mirl_target.Basis]) opt[layout.Registers] {
    val rule: mirl_capability.VectorRule = row.data.vectors;
    if (!(sel rule.register)) { ret opt[layout.Registers].none{}; }
    val widest: res[u64, mirl_capability.Unread] = mirl_capability.widest_register(mirl_target.context_of(basis), rule.register);
    if (sel widest.err) { ret opt[layout.Registers].none{}; }
    ret opt[layout.Registers].some{layout.Registers{narrow: rule.register.narrow, widest: widest.ok::u32}};
}

# the extents mirl's data layout of `row` gives every primitive under the build
# `basis` opened, and the vector registers it fits vectors to. a pointer mirl
# holds logically, or under an addressing model that holds no address of it, has none
fun scalars_of(a: *A.Allocator, row: *mirl_target.Target, basis: opt[*mirl_target.Basis]) res[layout.Scalars, fail.Fail] {
    var t: types.Table = types.init(a);
    fin { types.dnit(?t); }
    var l: mirl_target.Layout = mirl_target.of(row, ?t, mirl_target.context_of(basis));
    var s: layout.Scalars     = layout.scalars_none();
    var i: usize              = 0;
    for (i < 5) {
        val e: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.integer{types.Integer{width: layout.INTEGER_WIDTHS[i]}});
        if (sel e.err) { ret res[layout.Scalars, fail.Fail].err{fail.formatted(a, "target: mirl lays out no {}-bit integer on this target", layout.INTEGER_WIDTHS[i])}; }
        s.integers[i] = e.ok;
        i             = i + 1;
    }
    i = 0;
    for (i < 3) {
        val e: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.float{types.Float{format: format_of(layout.FLOAT_WIDTHS[i])}});
        if (sel e.err) { ret res[layout.Scalars, fail.Fail].err{fail.formatted(a, "target: mirl lays out no {}-bit float on this target", layout.FLOAT_WIDTHS[i])}; }
        s.floats[i] = e.ok;
        i           = i + 1;
    }
    val p: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
    if (sel p.ok) { s.pointer = opt[layout.Extent].some{p.ok}; }
    or (sel p.err) {
        if (!(sel p.err.unsized) && !(sel p.err.unmodelled)) { ret res[layout.Scalars, fail.Fail].err{fail.message("target: mirl lays out no pointer on this target")}; }
    }
    s.vectors = registers_of(row, basis);
    s.held    = true;
    ret res[layout.Scalars, fail.Fail].ok{s};
}
