# the host a target runs on
#
# a target's host is mink's row for its system, under the environment the
# target's manifest states and none where it states none, for its architecture,
# held under the traits its calling convention states, as riscv's float abi
# picks one of linux's riscv64 rows. what a host says of the target, the
# capabilities it offers, the instruction set floor every machine it runs has,
# its default convention and how it names libraries, is read from that row and
# stated nowhere in mach
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mink_fail: mink.base.fail;
use mink.base.table;
use mink.base.table.Table;
use mink_arch:  mink.catalog.arch;
use mink_os:    mink.catalog.os;
use mink_trait: mink.catalog.trait;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;

pub fun refusal(a: *A.Allocator, f: mink_fail.Fail) fail.Fail {
    if (f.subject == nil) { ret fail.formatted(a, "target: mink's catalog: {}", f.text); }
    ret fail.formatted(a, "target: mink's catalog: {}: {}", f.subject, f.text);
}

# mink's host of `system` running `arch` under `env`, held under the traits the
# convention `abi` states, "" for a convention not yet chosen. refused where no
# host of the system holds
pub fun of(a: *A.Allocator, system: *mink_os.System, env: opt[*mink_os.Env], arch: *mink_arch.Arch, abi: str) res[*mink_os.Host, fail.Fail] {
    var ts:       Table[mink_trait.Trait]            = table.make[mink_trait.Trait](a);
    val h:        res[*mink_os.Host, mink_fail.Fail] = held(?ts, system, env, arch, abi);
    val released: err[mink_fail.Fail]                = table.release[mink_trait.Trait](?ts);
    if (sel h.err && sel env.none) {
        ret res[*mink_os.Host, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_INVALID_VALUE,
            "target: mink's catalog holds no host of {} on {} without an environment, and the target states no `env`", system.name, arch.name)};
    }
    if (sel h.err)        { ret res[*mink_os.Host, fail.Fail].err{refusal(a, h.err)}; }
    if (sel released.err) { ret res[*mink_os.Host, fail.Fail].err{refusal(a, released.err)}; }
    ret res[*mink_os.Host, fail.Fail].ok{h.ok};
}

# the host of `system` under `env` for `arch` that holds of the traits the
# convention `abi` states, gathered into `ts`. a convention mink's family of the
# architecture does not name states none
fun held(ts: *Table[mink_trait.Trait], system: *mink_os.System, env: opt[*mink_os.Env], arch: *mink_arch.Arch, abi: str) res[*mink_os.Host, mink_fail.Fail] {
    val convention: opt[*mink_arch.Abi] = mink_arch.abi(arch, abi);
    if (sel convention.some) {
        var i: usize = 0;
        for (i < convention.some.count) {
            val put: err[mink_fail.Fail] = mink_trait.add(ts, convention.some.settings[i]);
            if (sel put.err) { ret res[*mink_os.Host, mink_fail.Fail].err{put.err}; }
            i = i + 1;
        }
    }
    ret mink_os.host(system, env, arch, ts);
}

# the calling convention the host calls by default, none where the architecture's
# family names none or the host derives it from an ISA string
pub fun default_abi(h: *mink_os.Host) opt[str] {
    if (sel h.abi.row) { ret opt[str].some{h.abi.row.name}; }
    ret opt[str].none{};
}

# the instruction set floor of the host, in masc's selection spelling, none where
# the system bounds the machine not at all, as a freestanding one
pub fun floor(h: *mink_os.Host) opt[str] {
    if (sel h.floor.none) { ret opt[str].none{}; }
    ret opt[str].some{h.floor.some};
}
