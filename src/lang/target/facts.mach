# what a program may ask of its target while it compiles, read once from the back end a
# build opens: the tag ids of mink's rows, masc's selection, and what mirl's assembled
# target lays out and guarantees
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use masc_set:  masc.core.set;
use masc_isa:  masc.isa;
use mink_arch: mink.catalog.arch;
use mirl_ct:   mirl.ct;
use mirl.ir.opcode.row.Opcode;
use opcode:          mirl.ir.opcode.table;
use types_calling:   mirl.ir.type.calling;
use types_format:    mirl.ir.type.format;
use types:           mirl.ir.type.table;
use mirl_timing:     mirl.machine.timing;
use mirl_va:         mirl.target.abi.va;
use mirl_basis:      mirl.target.basis;
use mirl_build:      mirl.target.build;
use mirl_capability: mirl.target.capability;
use mirl_families:   mirl.target.families;
use mirl_family:     mirl.target.family;
use mirl_layout:     mirl.target.layout;
use mirl_record:     mirl.target.record;
use register_family: mirl.target.register.family;
use register_isa:    mirl.target.register.isa;
use register:        mirl.target.register.machine;

use mach.lang.ct;
use mach.lang.fail;
use mach.lang.float;
use mach.lang.target.assembled;
use mach.lang.target.resolved;
use target_tags: mach.lang.target.tags;
use mach.lang.type.shape;

# what mirl says of the `va_list` of the target's own convention
# ---
# listed:   its size and alignment under the target's data layout
# unlisted: the convention has no `va_list`
# refused:  mirl answers none for the target, with why
pub tag VaList: u8 {
    listed: Listed;
    unlisted;
    refused: str;
}

# the size and alignment of a `va_list`
pub rec Listed {
    size:  u32;
    align: u32;
}

# the vector registers a vector aligns to: `narrow` the narrowest and `widest` the widest
# the build meets, in bits
pub rec Registers {
    narrow: u32;
    widest: u32;
}

# the nan a target's float operations return in each format, binary16, binary32
# and binary64 at the index of mirl's format, which mirl's folder reads
pub rec Nans {
    formats: [3]mirl_capability.Nans;
}

# no format's rule stated, as where no target is selected
pub fun nans_none() Nans {
    var n: Nans;
    var i: usize = 0;
    for (i < 3) {
        n.formats[i] = mirl_capability.Nans.unstated{};
        i            = i + 1;
    }
    ret n;
}

# the rule of the format of width `w`, binary64 for any other width
pub fun nans_at(n: *Nans, w: float.FloatWidth) mirl_capability.Nans {
    if (w == float.FLOAT_W_16) { ret n.formats[0]; }
    if (w == float.FLOAT_W_32) { ret n.formats[1]; }
    ret n.formats[2];
}

# whether any format's rule is stated, as it is wherever a target is selected
pub fun nans_held(n: *Nans) bool {
    var i: usize = 0;
    for (i < 3) {
        if (!(sel n.formats[i].unstated)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the vector registers of a target, 0 where mirl fits a vector to no register and aligns it
# to its element
fun vector_bits(r: opt[Registers]) u32 {
    if (sel r.some) { ret r.some.narrow; }
    ret 0;
}

fun register_bits(r: opt[Registers]) u32 {
    if (sel r.some) { ret r.some.widest; }
    ret 0;
}

# what a program may ask of its target while it compiles: the tag ids, the
# extents of its primitives and vectors, the selection its extensions are read
# against, what a float operation makes of a NaN, and whether `asm` reaches an
# assembler
pub rec Facts {
    os_id:         u32;
    arch_id:       u32;
    abi_id:        u32;
    pointer_width: u32;
    vector_bits:   u32;
    register_bits: u32;
    selected:      resolved.Selected;
    has_assembly:  bool;
    # whether a pointer is an address, or on a logical target a reference to a declared type
    flat_addressing: bool;
    # the nan each float format's operations return, which comptime folds by
    nans: Nans;
    # the `va_list` of the target's convention, which `abi_type("va_list")` declares
    va_list: VaList;
    # the scalar multiplies mirl runs in time independent of their operands, which
    # `$mach.build.ct_mul` reads
    multiplies: ct.CtMulMask;
    # the build guarantees every timing mode a soft constant-time function's code may be held
    # under, so a hard function may call a soft one
    soft_guaranteed: bool;
}

# the facts of the target `t` mirl assembled as `x`: mink's rows by their tag ids, masc's
# selection, and what mirl lays out and guarantees
pub fun of(a: *A.Allocator, x: *assembled.Assembled, t: *resolved.Target) res[Facts, fail.Fail] {
    val pointer: res[opt[u32], fail.Fail] = pointer_width_of(a, x);
    if (sel pointer.err) { ret res[Facts, fail.Fail].err{pointer.err}; }
    val timing: res[Timing, fail.Fail] = timing_of(a, x);
    if (sel timing.err) { ret res[Facts, fail.Fail].err{timing.err}; }
    val registers: opt[Registers]     = registers_of(x);
    val served:    opt[*masc_set.Set] = masc_isa.find(?masc_isa.REGISTRY, t.target.arch);
    var f:         Facts;
    f.os_id   = target_tags.sys_id(t.target.sys);
    f.arch_id = target_tags.arch_id(t.target.arch);
    f.abi_id  = target_tags.NONE;
    val convention: *mink_arch.Abi = resolved.abi(t);
    if (convention != nil) { f.abi_id = target_tags.abi_id(convention); }
    # a pointer mirl holds logically has no address width: it is a reference to its
    # declared type, and every type the code needs is checked against that model
    f.pointer_width   = 0;
    f.flat_addressing = false;
    if (sel pointer.ok.some) {
        f.pointer_width   = pointer.ok.some;
        f.flat_addressing = true;
    }
    f.vector_bits     = vector_bits(registers);
    f.register_bits   = register_bits(registers);
    f.selected        = t.selected;
    f.has_assembly    = sel served.some;
    f.nans            = nans_of(x);
    f.va_list         = va_list_of(a, x);
    f.multiplies      = timing.ok.multiplies;
    f.soft_guaranteed = timing.ok.soft_guaranteed;
    ret res[Facts, fail.Fail].ok{f};
}

# no target's facts, as where no target is selected
pub fun none() Facts {
    var f: Facts;
    f.os_id           = target_tags.NONE;
    f.arch_id         = target_tags.NONE;
    f.abi_id          = target_tags.NONE;
    f.pointer_width   = 0;
    f.vector_bits     = 0;
    f.register_bits   = 0;
    f.selected        = resolved.selected_none();
    f.has_assembly    = false;
    f.flat_addressing = true;
    f.nans            = nans_none();
    f.va_list         = VaList.unlisted{};
    f.multiplies      = ct.mul_mask_none();
    f.soft_guaranteed = false;
    ret f;
}

# what the assembled target's build guarantees of constant-time code
# ---
# multiplies:      the scalar multiplies of mach's catalog that mirl runs in time independent of
#                  their operands under the timing modes the build guarantees, as a hard
#                  constant-time function holds them. a widening multiply is its low and its high half
# soft_guaranteed: the build guarantees every mode a soft function's code may be held under
rec Timing {
    multiplies:      ct.CtMulMask;
    soft_guaranteed: bool;
}

# the timing facts of the assembled target. only a register machine's selection classifies an
# instruction's timing, so a target another family serves guarantees nothing
fun timing_of(a: *A.Allocator, x: *assembled.Assembled) res[Timing, fail.Fail] {
    var t: Timing = Timing{multiplies: ct.mul_mask_none(), soft_guaranteed: false};
    if (!x.based) { ret res[Timing, fail.Fail].ok{t}; }
    val served: res[*mirl_family.Family, mirl_family.Error] = mirl_families.served(?x.target);
    if (sel served.err)                       { ret res[Timing, fail.Fail].ok{t}; }
    if (served.ok != ?register_family.FAMILY) { ret res[Timing, fail.Fail].ok{t}; }
    var b:      mirl_build.Build;
    val opened: err[mirl_basis.Error] = register.open(?b, a, ?x.target, assembled.added(x));
    if (sel opened.err) { ret res[Timing, fail.Fail].err{fail.formatted(a, "target: mirl opens no build to classify its multiplies by: {}", mirl_basis.fact(opened.err))}; }
    fin { register.close(?b); }
    t.soft_guaranteed = mirl_ct.soft_guaranteed(b.basis.set, ?b.basis.context);
    var op: u32 = 1;
    for (op < ct.CT_MUL_OP_COUNT) {
        var w: u32 = 8;
        for (w <= 128) {
            val held: res[bool, A.Error] = multiply_held(a, ?b, op::ct.CtMulOp, w);
            if (sel held.err) { ret res[Timing, fail.Fail].err{fail.refused(held.err)}; }
            if (held.ok)      { ct.mul_mask_add(?t.multiplies, ct.mul_cell(op::ct.CtMulOp, w::u8, false)); }
            w = w * 2;
        }
        op = op + 1;
    }
    ret res[Timing, fail.Fail].ok{t};
}

# whether mirl runs the multiply `op` of `width` bits on build `b` in time independent of its operands
fun multiply_held(a: *A.Allocator, b: *mirl_build.Build, op: ct.CtMulOp, width: u32) res[bool, A.Error] {
    var halves: [2]Opcode = [2]Opcode{opcode.MUL, opcode.MUL};
    var n:      u32       = 1;
    if (op == ct.CT_MUL_HIGH_U)  { halves[0] = opcode.MUL_HIGH_U; }
    if (op == ct.CT_MUL_HIGH_S)  { halves[0] = opcode.MUL_HIGH_S; }
    if (op == ct.CT_MUL_HIGH_SU) { halves[0] = opcode.MUL_HIGH_SU; }
    if (op == ct.CT_MUL_WIDE_U) {
        halves[1] = opcode.MUL_HIGH_U;
        n         = 2;
    }
    if (op == ct.CT_MUL_WIDE_S) {
        halves[1] = opcode.MUL_HIGH_S;
        n         = 2;
    }
    var i: u32 = 0;
    for (i < n) {
        val got: res[bool, A.Error] = mirl_timing.multiply_guaranteed(a, ?register_isa.ISAS, b, halves[i], width);
        if (sel got.err) { ret got; }
        if (!got.ok)     { ret got; }
        i = i + 1;
    }
    ret res[bool, A.Error].ok{true};
}

# the nan each float format's operations return on the assembled target, unstated
# for a format it holds under no row
fun nans_of(x: *assembled.Assembled) Nans {
    var out: Nans  = nans_none();
    var i:   usize = 0;
    for (i < 3) {
        val f: opt[types_format.Format] = shape.format(FLOAT_WIDTHS[i]);
        i = i + 1;
        if (sel f.none) { cnt; }
        val got: res[mirl_capability.Nans, mirl_basis.Error] = mirl_basis.nans(assembled.basis_of(x), ?x.target.caps, f.some);
        if (sel got.ok) { out.formats[i - 1] = got.ok; }
    }
    ret out;
}

# the `va_list` of the assembled target's own convention, as mirl's row of the
# convention states it and its data layout lays it out
fun va_list_of(a: *A.Allocator, x: *assembled.Assembled) VaList {
    var t: types.Table = types.init(a);
    fin { types.dnit(?t); }
    var l:      mirl_layout.Layout                      = mirl_layout.of(?x.target, ?t, mirl_basis.context_of(assembled.basis_of(x)));
    val listed: res[opt[mirl_va.Listed], mirl_va.Error] = mirl_va.va_list(?l, opt[types_calling.Calling].none{});
    if (sel listed.err)     { ret VaList.refused{va_refusal(listed.err)}; }
    if (sel listed.ok.none) { ret VaList.unlisted{}; }
    ret VaList.listed{Listed{size: listed.ok.some.size::u32, align: listed.ok.some.align::u32}};
}

# why mirl answered no `va_list`, as a refusal of `abi_type("va_list")` says it
fun va_refusal(why: mirl_va.Error) str {
    if (sel why.alloc)       { ret "mirl had no storage to lay it out"; }
    if (sel why.conventions) { ret "mirl carries no convention of the target"; }
    if (sel why.named)       { ret "mirl's target names no row of the convention"; }
    if (sel why.unstated)    { ret "mirl's row of the convention leaves it unstated"; }
    if (sel why.layout)      { ret "mirl's data layout of the target does not lay it out"; }
    ret "mirl's data layout of the target disagrees with the convention's row";
}

# the float widths mirl's formats hold, binary16, binary32 and binary64
val FLOAT_WIDTHS: [3]u32 = [3]u32{16, 32, 64};

# the vector registers mirl fits a vector to under the build basis, none where it states no
# register fit and a vector aligns to its element
fun registers_of(x: *assembled.Assembled) opt[Registers] {
    val rule: mirl_capability.VectorRule = x.target.data.vectors;
    if (!(sel rule.register)) { ret opt[Registers].none{}; }
    val widest: res[u64, mirl_capability.Error] = mirl_capability.widest_register(mirl_basis.context_of(assembled.basis_of(x)), rule.register);
    if (sel widest.err) { ret opt[Registers].none{}; }
    ret opt[Registers].some{Registers{narrow: rule.register.narrow, widest: widest.ok::u32}};
}

# the width of an address of the default space, mirl's layout of a pointer under the build
# basis. none for a pointer mirl holds logically, or under an addressing model that holds no
# address of it
fun pointer_width_of(a: *A.Allocator, x: *assembled.Assembled) res[opt[u32], fail.Fail] {
    var t: types.Table = types.init(a);
    fin { types.dnit(?t); }
    var l:  mirl_layout.Layout           = mirl_layout.of(?x.target, ?t, mirl_basis.context_of(assembled.basis_of(x)));
    val ty: res[types.Type, types.Error] = types.intern(?t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
    if (sel ty.err) { ret res[opt[u32], fail.Fail].err{fail.message("target: mirl's type table refused a pointer")}; }
    val e: res[mirl_capability.Extent, mirl_record.Error] = mirl_layout.extent(?l, ty.ok, types.DEFAULT_SPACE);
    if (sel e.ok)                                      { ret res[opt[u32], fail.Fail].ok{opt[u32].some{e.ok.size::u32}}; }
    if ((sel e.err.unsized) || (sel e.err.unmodelled)) { ret res[opt[u32], fail.Fail].ok{opt[u32].none{}}; }
    ret res[opt[u32], fail.Fail].err{fail.message("target: mirl lays out no pointer on this target")};
}
