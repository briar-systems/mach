use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use catalog_arch:   mach.lang.target.catalog.arch;
use catalog_os:     mach.lang.target.catalog.os;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

pub val BASE_ADDR: u64 = 0x400000;

pub val PAGE_SIZE: u64 = 4096;

val X86_64_FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    platform_lib:        "",
    dynamic_interpreter: "/lib64/ld-linux-x86-64.so.2",
    libdirs:             [catalog_os.LIBDIR_MAX]str{"/lib64", "/usr/lib64", "/lib/x86_64-linux-gnu", "/usr/lib/x86_64-linux-gnu", "/usr/lib", "/lib", "", ""},
    libdir_len:          6,
};

val AARCH64_FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    platform_lib:        "",
    dynamic_interpreter: "/lib/ld-linux-aarch64.so.1",
    libdirs:             [catalog_os.LIBDIR_MAX]str{"/lib/aarch64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib", "", ""},
    libdir_len:          6,
};

val RISCV64_FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    platform_lib:        "",
    dynamic_interpreter: "/lib/ld-linux-riscv64-lp64d.so.1",
    libdirs:             [catalog_os.LIBDIR_MAX]str{"/lib/riscv64-linux-gnu", "/usr/lib/riscv64-linux-gnu", "/lib64", "/usr/lib64", "/usr/lib", "/lib", "", ""},
    libdir_len:          6,
};

val SUPPORTED_OFS: [1]str = [1]str{"elf"};

val ISA_ROWS: [3]lang_target_os.IsaRow = [3]lang_target_os.IsaRow{
    lang_target_os.IsaRow{
        arch:      catalog_arch.X86_64,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"sysv64", "", "", ""}, len: 1},
        page_size: PAGE_SIZE,
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?X86_64_FS_POLICY,
    },
    lang_target_os.IsaRow{
        arch: catalog_arch.AARCH64,
        abis: lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"aapcs64", "", "", ""}, len: 1},
        # the largest page an aarch64 kernel may use
        page_size: 65536,
        va_list:   lang_target_os.VaList{size: 32, align: 8},
        fs_policy: ?AARCH64_FS_POLICY,
        # linux guarantees PSTATE.DIT for an aarch64 process: the kernel exposes
        # the processor's FEAT_DIT as HWCAP_DIT (1 << 24) in AT_HWCAP since
        # v4.17 (commit 7206dc93a58f "arm64: Expose Arm v8.4 features",
        # 2018-03; Documentation/arch/arm64/elf_hwcaps.rst: "Functionality
        # implied by ID_AA64PFR0_EL1.DIT == 0b0001"), user code sets the bit
        # with `msr dit, #1` (Arm ARM DDI 0487, "About PSTATE.DIT": a direct
        # write to DIT is permitted at EL0), and PSTATE is saved to SPSR_EL1 on
        # every exception entry and restored on return, so the bit outlives a
        # context switch. no other instruction set has a DIT_MODE row, so no
        # other declares it
        dit_guaranteed: true,
    },
    lang_target_os.IsaRow{
        arch: catalog_arch.RISCV64,
        # the kernel syscall abi is integer-only and std carries no libc, so
        # every riscv64 psABI float variant runs on linux; lp64d is the native one
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"lp64d", "lp64", "lp64f", ""}, len: 3},
        page_size: PAGE_SIZE,
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?RISCV64_FS_POLICY,
    },
};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                 catalog_os.LINUX,
    name:               "linux",
    default_of:         "elf",
    supported_ofs:      ?SUPPORTED_OFS[0],
    supported_of_count: 1,
    isa_rows:           ?ISA_ROWS[0],
    isa_row_count:      3,
    entry_symbol:       "_start",
    c_symbol_prefix:    "",
    base_addr:          BASE_ADDR,
    page_size:          PAGE_SIZE,
    stack_probe:        true,
    mapped_by_loader:   true,
    naming:             target_of.SystemNaming{static_prefix: "lib", static_suffix: ".a", executable_suffix: ""},
};

test vtable__wires_dit_guaranteed {
    if (!lang_target_os.dit_guaranteed_for(?VTABLE, catalog_arch.AARCH64)) { ret 3; }
    if (lang_target_os.dit_guaranteed_for(?VTABLE, catalog_arch.X86_64))   { ret 4; }
    ret 0;
}

#[testing]
fun policy_of(arch_id: u32) catalog_os.FsPolicy {
    val r: res[opt[catalog_os.FsPolicy], fail.Fail] = lang_target_os.fs_policy_checked_for(?VTABLE, arch_id);
    if (sel r.ok) {
        val o: opt[catalog_os.FsPolicy] = r.ok;
        if (sel o.some) { ret o.some; }
    }
    var absent: catalog_os.FsPolicy;
    ret absent;
}

test fs_policy__per_arch_interpreter_and_libdirs {
    var bad: bool = false;

    val x64: catalog_os.FsPolicy = policy_of(catalog_arch.X86_64);
    if (!str_equals(x64.dynamic_interpreter, "/lib64/ld-linux-x86-64.so.2")) { bad = true; }
    if (x64.libdir_len != 6)                                                 { bad = true; }
    if (!str_equals(x64.libdirs[0], "/lib64"))                               { bad = true; }
    if (!str_equals(x64.libdirs[2], "/lib/x86_64-linux-gnu"))                { bad = true; }

    val a64: catalog_os.FsPolicy = policy_of(catalog_arch.AARCH64);
    if (!str_equals(a64.dynamic_interpreter, "/lib/ld-linux-aarch64.so.1")) { bad = true; }
    if (a64.libdir_len != 6)                                                { bad = true; }
    if (!str_equals(a64.libdirs[0], "/lib/aarch64-linux-gnu"))              { bad = true; }

    val r64: catalog_os.FsPolicy = policy_of(catalog_arch.RISCV64);
    if (!str_equals(r64.dynamic_interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { bad = true; }
    if (r64.libdir_len != 6)                                                      { bad = true; }
    if (!str_equals(r64.libdirs[0], "/lib/riscv64-linux-gnu"))                    { bad = true; }

    var li: u32 = 0;
    for (li < x64.libdir_len) {
        var lj: u32 = 0;
        for (lj < a64.libdir_len) {
            if (str_equals(x64.libdirs[li], a64.libdirs[lj])
                && !str_equals(x64.libdirs[li], "/lib64")
                && !str_equals(x64.libdirs[li], "/usr/lib64")
                && !str_equals(x64.libdirs[li], "/usr/lib")
                && !str_equals(x64.libdirs[li], "/lib")) { bad = true; }
            lj = lj + 1;
        }
        li = li + 1;
    }
    if (str_equals(x64.dynamic_interpreter, a64.dynamic_interpreter)) { bad = true; }
    if (str_equals(x64.dynamic_interpreter, r64.dynamic_interpreter)) { bad = true; }
    if (str_equals(a64.dynamic_interpreter, r64.dynamic_interpreter)) { bad = true; }

    if (lang_target_os.supports_isa(?VTABLE, catalog_arch.SPIRV)) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}
