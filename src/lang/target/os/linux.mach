use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

pub val LINUX_BASE_ADDR: u64 = 0x400000;

pub val LINUX_PAGE_SIZE: u64 = 4096;

fun linux_page_size(arch_id: u32) u64 {
    if (arch_id == isa.ARCH_AARCH64) { ret 65536; }
    ret LINUX_PAGE_SIZE;
}

val LINUX_X86_64_DYNAMIC_LINKER:  str = "/lib64/ld-linux-x86-64.so.2";
val LINUX_AARCH64_DYNAMIC_LINKER: str = "/lib/ld-linux-aarch64.so.1";
val LINUX_RISCV64_DYNAMIC_LINKER: str = "/lib/ld-linux-riscv64-lp64d.so.1";

fun linux_fs_policy(arch_id: u32) opt[lang_target_os.FsPolicy] {
    var p: lang_target_os.FsPolicy;
    p.sysroot        = "";
    p.toolchain_root = "";
    p.platform_lib   = "";
    if (arch_id == isa.ARCH_X86_64) {
        p.dynamic_interpreter = LINUX_X86_64_DYNAMIC_LINKER;
        p.libdirs[0]          = "/lib64";
        p.libdirs[1]          = "/usr/lib64";
        p.libdirs[2]          = "/lib/x86_64-linux-gnu";
        p.libdirs[3]          = "/usr/lib/x86_64-linux-gnu";
        p.libdirs[4]          = "/usr/lib";
        p.libdirs[5]          = "/lib";
        p.libdir_len          = 6;
        ret opt[lang_target_os.FsPolicy].some{p};
    }
    if (arch_id == isa.ARCH_AARCH64) {
        p.dynamic_interpreter = LINUX_AARCH64_DYNAMIC_LINKER;
        p.libdirs[0]          = "/lib/aarch64-linux-gnu";
        p.libdirs[1]          = "/usr/lib/aarch64-linux-gnu";
        p.libdirs[2]          = "/lib64";
        p.libdirs[3]          = "/usr/lib64";
        p.libdirs[4]          = "/usr/lib";
        p.libdirs[5]          = "/lib";
        p.libdir_len          = 6;
        ret opt[lang_target_os.FsPolicy].some{p};
    }
    if (arch_id == isa.ARCH_RISCV64) {
        p.dynamic_interpreter = LINUX_RISCV64_DYNAMIC_LINKER;
        p.libdirs[0]          = "/lib/riscv64-linux-gnu";
        p.libdirs[1]          = "/usr/lib/riscv64-linux-gnu";
        p.libdirs[2]          = "/lib64";
        p.libdirs[3]          = "/usr/lib64";
        p.libdirs[4]          = "/usr/lib";
        p.libdirs[5]          = "/lib";
        p.libdir_len          = 6;
        ret opt[lang_target_os.FsPolicy].some{p};
    }
    ret opt[lang_target_os.FsPolicy].none{};
}

# the kernel syscall abi is integer-only and std carries no libc, so every
# riscv64 psABI float variant runs on linux; lp64d is the native one
fun linux_accepted_abis(arch_id: u32) lang_target_os.AbiSet {
    if (arch_id == isa.ARCH_X86_64)  { ret lang_target_os.abi_set_one("sysv64"); }
    if (arch_id == isa.ARCH_AARCH64) { ret lang_target_os.abi_set_one("aapcs64"); }
    if (arch_id == isa.ARCH_RISCV64) {
        var s: lang_target_os.AbiSet = lang_target_os.abi_set_one("lp64d");
        lang_target_os.abi_set_add(?s, "lp64");
        lang_target_os.abi_set_add(?s, "lp64f");
        ret s;
    }
    ret lang_target_os.abi_set_none();
}

# linux guarantees PSTATE.DIT for an aarch64 process: the kernel exposes the
# processor's FEAT_DIT as HWCAP_DIT (1 << 24) in AT_HWCAP since v4.17 (commit
# 7206dc93a58f "arm64: Expose Arm v8.4 features", 2018-03;
# Documentation/arch/arm64/elf_hwcaps.rst: "Functionality implied by
# ID_AA64PFR0_EL1.DIT == 0b0001"), user code sets the bit with `msr dit, #1`
# (Arm ARM DDI 0487, "About PSTATE.DIT": a direct write to DIT is permitted at
# EL0), and PSTATE is saved to SPSR_EL1 on every exception entry and restored
# on return, so the bit outlives a context switch. no other instruction set
# has a DIT_MODE row, so no other declares it (#3508)
fun linux_dit_guaranteed(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

fun linux_va_list(arch_id: u32) opt[lang_target_os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_AARCH64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(32, 8)}; }
    if (arch_id == isa.ARCH_RISCV64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    ret opt[lang_target_os.VaList].none{};
}

pub fun register_linux(reg: *lang_target_os.OsRegistry) err[fail.Fail] {
    var linux_vtable: lang_target_os.OsVTable;
    linux_vtable.id                 = lang_target_os.OS_LINUX;
    linux_vtable.name               = lang_target_os.os_name_for(lang_target_os.OS_LINUX);
    linux_vtable.default_of         = target_of.of_name_for(target_of.OF_ELF);
    linux_vtable.supported_of_count = 0;
    lang_target_os.support_of(?linux_vtable, target_of.of_name_for(target_of.OF_ELF));
    linux_vtable.supported_isa_any   = false;
    linux_vtable.supported_isa_count = 0;
    lang_target_os.support_isa(?linux_vtable, isa.ARCH_X86_64);
    lang_target_os.support_isa(?linux_vtable, isa.ARCH_AARCH64);
    lang_target_os.support_isa(?linux_vtable, isa.ARCH_RISCV64);
    linux_vtable.entry_symbol       = "_start";
    linux_vtable.c_symbol_prefix    = "";
    linux_vtable.fs_policy          = linux_fs_policy;
    linux_vtable.base_addr          = LINUX_BASE_ADDR;
    linux_vtable.page_size          = LINUX_PAGE_SIZE;
    linux_vtable.page_size_for      = linux_page_size;
    linux_vtable.stack_probe        = true;
    linux_vtable.mapped_by_loader   = true;
    linux_vtable.accepted_abis      = linux_accepted_abis;
    linux_vtable.variadic_stack     = nil;
    linux_vtable.natural_stack_args = nil;
    linux_vtable.reg_arg_align      = nil;
    linux_vtable.reg_arg_extend     = nil;
    linux_vtable.declared_agg_align = nil;
    linux_vtable.va_list_layout     = linux_va_list;
    linux_vtable.dit_guaranteed     = linux_dit_guaranteed;

    ret lang_target_os.register(reg, ?linux_vtable);
}

test register_linux__wires_dit_guaranteed {
    var reg:   lang_target_os.OsRegistry = lang_target_os.registry_init();
    val r_reg: err[fail.Fail]            = register_linux(?reg);
    if (sel r_reg.err) {
        lang_target_os.registry_dnit(?reg);
        ret 1;
    }
    val found: opt[*lang_target_os.OsVTable] = lang_target_os.lookup(?reg, "linux");
    if (sel found.none) {
        lang_target_os.registry_dnit(?reg);
        ret 2;
    }
    val a64: bool = lang_target_os.dit_guaranteed_for(found.some, isa.ARCH_AARCH64);
    val x64: bool = lang_target_os.dit_guaranteed_for(found.some, isa.ARCH_X86_64);
    lang_target_os.registry_dnit(?reg);
    if (!a64) { ret 3; }
    if (x64)  { ret 4; }
    ret 0;
}

#[testing]
fun opt_str(o: opt[lang_target_os.FsPolicy]) lang_target_os.FsPolicy {
    if (sel o.some) { ret o.some; }
    var absent: lang_target_os.FsPolicy;
    ret absent;
}

test linux_fs_policy__per_arch_interpreter_and_libdirs {
    var bad: bool = false;

    val x64: lang_target_os.FsPolicy = opt_str(linux_fs_policy(isa.ARCH_X86_64));
    if (!str_equals(x64.dynamic_interpreter, "/lib64/ld-linux-x86-64.so.2")) { bad = true; }
    if (x64.libdir_len != 6)                                                 { bad = true; }
    if (!str_equals(x64.libdirs[0], "/lib64"))                               { bad = true; }
    if (!str_equals(x64.libdirs[2], "/lib/x86_64-linux-gnu"))                { bad = true; }

    val a64: lang_target_os.FsPolicy = opt_str(linux_fs_policy(isa.ARCH_AARCH64));
    if (!str_equals(a64.dynamic_interpreter, "/lib/ld-linux-aarch64.so.1")) { bad = true; }
    if (a64.libdir_len != 6)                                                { bad = true; }
    if (!str_equals(a64.libdirs[0], "/lib/aarch64-linux-gnu"))              { bad = true; }

    val r64: lang_target_os.FsPolicy = opt_str(linux_fs_policy(isa.ARCH_RISCV64));
    if (!str_equals(r64.dynamic_interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { bad = true; }
    if (r64.libdir_len != 6)                                                      { bad = true; }
    if (!str_equals(r64.libdirs[0], "/lib/riscv64-linux-gnu"))                    { bad = true; }

    var li: u32 = 0;
    for (li < x64.libdir_len) {
        var lj: u32 = 0;
        for (lj < a64.libdir_len) {
            if (str_equals(x64.libdirs[li], a64.libdirs[lj])
                && !str_equals(x64.libdirs[li], "/lib64")
                && !str_equals(x64.libdirs[li], "/usr/lib64")
                && !str_equals(x64.libdirs[li], "/usr/lib")
                && !str_equals(x64.libdirs[li], "/lib")) { bad = true; }
            lj = lj + 1;
        }
        li = li + 1;
    }
    if (str_equals(x64.dynamic_interpreter, a64.dynamic_interpreter)) { bad = true; }
    if (str_equals(x64.dynamic_interpreter, r64.dynamic_interpreter)) { bad = true; }
    if (str_equals(a64.dynamic_interpreter, r64.dynamic_interpreter)) { bad = true; }

    val r_153: opt[lang_target_os.FsPolicy] = linux_fs_policy(isa.ARCH_SPIRV);
    if (sel r_153.some) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}
