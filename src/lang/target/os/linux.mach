use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_equals;


use mach.lang.target.of;
use mach.lang.target.os;
use mach.lang.target.isa;

pub val LINUX_BASE_ADDR: u64 = 0x400000;

pub val LINUX_PAGE_SIZE: u64 = 4096;

fun linux_page_size(arch_id: u32) u64 {
    if (arch_id == isa.ARCH_AARCH64) { ret 65536; }
    ret LINUX_PAGE_SIZE;
}

pub val LINUX_X86_64_DYNAMIC_LINKER:  str = "/lib64/ld-linux-x86-64.so.2";
pub val LINUX_AARCH64_DYNAMIC_LINKER: str = "/lib/ld-linux-aarch64.so.1";
pub val LINUX_RISCV64_DYNAMIC_LINKER: str = "/lib/ld-linux-riscv64-lp64d.so.1";

fun linux_fs_policy(arch_id: u32) opt[os.FsPolicy] {
    var p: os.FsPolicy;
    p.sysroot = "";
    p.toolchain_root = "";
    p.platform_lib = "";
    if (arch_id == isa.ARCH_X86_64) {
        p.dynamic_interpreter = LINUX_X86_64_DYNAMIC_LINKER;
        p.libdirs[0] = "/lib64";
        p.libdirs[1] = "/usr/lib64";
        p.libdirs[2] = "/lib/x86_64-linux-gnu";
        p.libdirs[3] = "/usr/lib/x86_64-linux-gnu";
        p.libdirs[4] = "/usr/lib";
        p.libdirs[5] = "/lib";
        p.libdir_len = 6;
        ret opt[os.FsPolicy].some{p};
    }
    if (arch_id == isa.ARCH_AARCH64) {
        p.dynamic_interpreter = LINUX_AARCH64_DYNAMIC_LINKER;
        p.libdirs[0] = "/lib/aarch64-linux-gnu";
        p.libdirs[1] = "/usr/lib/aarch64-linux-gnu";
        p.libdirs[2] = "/usr/lib";
        p.libdirs[3] = "/lib";
        p.libdir_len = 4;
        ret opt[os.FsPolicy].some{p};
    }
    if (arch_id == isa.ARCH_RISCV64) {
        p.dynamic_interpreter = LINUX_RISCV64_DYNAMIC_LINKER;
        p.libdirs[0] = "/lib/riscv64-linux-gnu";
        p.libdirs[1] = "/usr/lib/riscv64-linux-gnu";
        p.libdirs[2] = "/usr/lib";
        p.libdirs[3] = "/lib";
        p.libdir_len = 4;
        ret opt[os.FsPolicy].some{p};
    }
    ret opt[os.FsPolicy].none{};
}

fun linux_native_abi(arch_id: u32) str {
    if (arch_id == isa.ARCH_X86_64)  { ret "sysv64"; }
    if (arch_id == isa.ARCH_AARCH64) { ret "aapcs64"; }
    if (arch_id == isa.ARCH_RISCV64) { ret "lp64d"; }
    ret "";
}

pub fun linux_va_list(arch_id: u32) opt[os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret opt[os.VaList].some{os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_AARCH64) { ret opt[os.VaList].some{os.va_list(32, 8)}; }
    if (arch_id == isa.ARCH_RISCV64) { ret opt[os.VaList].some{os.va_list(8, 8)}; }
    ret opt[os.VaList].none{};
}

pub fun register_linux(reg: *os.OsRegistry) err[fail.Fail] {
    var linux_vtable: os.OsVTable;
    linux_vtable.id             = os.OS_LINUX;
    linux_vtable.name           = os.os_name_for(os.OS_LINUX);
    linux_vtable.default_of     = of.of_name_for(of.OF_ELF);
    linux_vtable.supported_of_count = 0;
    os.support_of(?linux_vtable, of.of_name_for(of.OF_ELF));
    linux_vtable.supported_isa_any   = false;
    linux_vtable.supported_isa_count = 0;
    os.support_isa(?linux_vtable, isa.ARCH_X86_64);
    os.support_isa(?linux_vtable, isa.ARCH_AARCH64);
    os.support_isa(?linux_vtable, isa.ARCH_RISCV64);
    linux_vtable.entry_symbol   = "_start";
    linux_vtable.c_symbol_prefix = "";
    linux_vtable.fs_policy      = linux_fs_policy;
    linux_vtable.base_addr      = LINUX_BASE_ADDR;
    linux_vtable.page_size      = LINUX_PAGE_SIZE;
    linux_vtable.page_size_for  = linux_page_size;
    linux_vtable.stack_probe    = false;
    linux_vtable.mapped_by_loader = true;
    linux_vtable.native_abi     = linux_native_abi;
    linux_vtable.variadic_stack = nil;
    linux_vtable.natural_stack_args = nil;
    linux_vtable.va_list_layout = linux_va_list;

    ret os.register(reg, ?linux_vtable);
}

test "mach.lang.target.os.linux.linux_page_size:per_arch_max_page" {
    var bad: bool = false;
    if (linux_page_size(isa.ARCH_AARCH64) != 65536) { bad = true; }
    if (linux_page_size(isa.ARCH_X86_64)  != 4096)  { bad = true; }
    if (linux_page_size(isa.ARCH_RISCV64) != 4096)  { bad = true; }
    if (bad) { ret 1; }
    ret 0;
}

fun opt_str(o: opt[os.FsPolicy]) os.FsPolicy {
    if (sel o.some) { ret o.some; }
    var absent: os.FsPolicy;
    ret absent;
}

test "mach.lang.target.os.linux.linux_fs_policy:each_architecture_names_its_own_interpreter_and_libdirs" {
    var bad: bool = false;

    val x64: os.FsPolicy = opt_str(linux_fs_policy(isa.ARCH_X86_64));
    if (!str_equals(x64.dynamic_interpreter, "/lib64/ld-linux-x86-64.so.2")) { bad = true; }
    if (x64.libdir_len != 6)                                                 { bad = true; }
    if (!str_equals(x64.libdirs[0], "/lib64"))                               { bad = true; }
    if (!str_equals(x64.libdirs[2], "/lib/x86_64-linux-gnu"))                { bad = true; }

    val a64: os.FsPolicy = opt_str(linux_fs_policy(isa.ARCH_AARCH64));
    if (!str_equals(a64.dynamic_interpreter, "/lib/ld-linux-aarch64.so.1")) { bad = true; }
    if (a64.libdir_len != 4)                                                { bad = true; }
    if (!str_equals(a64.libdirs[0], "/lib/aarch64-linux-gnu"))              { bad = true; }

    val r64: os.FsPolicy = opt_str(linux_fs_policy(isa.ARCH_RISCV64));
    if (!str_equals(r64.dynamic_interpreter, "/lib/ld-linux-riscv64-lp64d.so.1")) { bad = true; }
    if (r64.libdir_len != 4)                                                      { bad = true; }
    if (!str_equals(r64.libdirs[0], "/lib/riscv64-linux-gnu"))                    { bad = true; }

    var li: u32 = 0;
    for (li < x64.libdir_len) {
        var lj: u32 = 0;
        for (lj < a64.libdir_len) {
            if (str_equals(x64.libdirs[li], a64.libdirs[lj])
                && !str_equals(x64.libdirs[li], "/usr/lib")
                && !str_equals(x64.libdirs[li], "/lib")) { bad = true; }
            lj = lj + 1;
        }
        li = li + 1;
    }
    if (str_equals(x64.dynamic_interpreter, a64.dynamic_interpreter)) { bad = true; }
    if (str_equals(x64.dynamic_interpreter, r64.dynamic_interpreter)) { bad = true; }
    if (str_equals(a64.dynamic_interpreter, r64.dynamic_interpreter)) { bad = true; }

    val r_153: opt[os.FsPolicy] = linux_fs_policy(isa.ARCH_SPIRV);
    if (sel r_153.some) { bad = true; }

    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.target.os.linux.linux_fs_policy:per_arch_glibc_path" {
    if (!str_equals(opt_str(linux_fs_policy(isa.ARCH_X86_64)).dynamic_interpreter, LINUX_X86_64_DYNAMIC_LINKER))   { ret 1; }
    if (!str_equals(opt_str(linux_fs_policy(isa.ARCH_AARCH64)).dynamic_interpreter, LINUX_AARCH64_DYNAMIC_LINKER)) { ret 1; }
    if (!str_equals(opt_str(linux_fs_policy(isa.ARCH_RISCV64)).dynamic_interpreter, LINUX_RISCV64_DYNAMIC_LINKER)) { ret 1; }
    val r_163: opt[os.FsPolicy] = linux_fs_policy(isa.ARCH_UNKNOWN);
    if (sel r_163.some) { ret 1; }
    ret 0;
}
