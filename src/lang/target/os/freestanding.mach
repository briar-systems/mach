use mach.lang.fail;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

val BASE_ADDR: u64 = 0;

# no loader of its own: a page-mapping format takes the isa's hardware page, a
# flat image has no page
val PAGE_SIZE: u64 = 0;

val FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    dynamic_interpreter: "",
    platform_lib:        "",
    libdir_len:          0,
};

val SUPPORTED_OFS: [3]str = [3]str{"raw", "elf", "spv"};

# no runtime calls a platform, so every convention the isa covers is accepted;
# the named one is only the default `mach init` scaffolds. no kernel, so nobody
# sets or preserves PSTATE.DIT for the program
val ISA_ROWS: [4]lang_target_os.IsaRow = [4]lang_target_os.IsaRow{
    lang_target_os.IsaRow{
        arch:      catalog_arch.X86_64,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"sysv64", "", "", ""}, len: 1, unconstrained: true},
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?FS_POLICY,
    },
    lang_target_os.IsaRow{
        arch:      catalog_arch.AARCH64,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"aapcs64", "", "", ""}, len: 1, unconstrained: true},
        va_list:   lang_target_os.VaList{size: 32, align: 8},
        fs_policy: ?FS_POLICY,
    },
    lang_target_os.IsaRow{
        arch:      catalog_arch.RISCV64,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"lp64d", "", "", ""}, len: 1, unconstrained: true},
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?FS_POLICY,
    },
    lang_target_os.IsaRow{
        arch:      catalog_arch.RISCV32,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"ilp32", "", "", ""}, len: 1, unconstrained: true},
        va_list:   lang_target_os.VaList{size: 4, align: 4},
        fs_policy: ?FS_POLICY,
    },
};

# every other isa runs too, with no default convention and no va_list layout
val ISA_ANY: lang_target_os.IsaRow = lang_target_os.IsaRow{
    arch:      catalog_arch.UNKNOWN,
    abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"", "", "", ""}, len: 0, unconstrained: true},
    fs_policy: ?FS_POLICY,
};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                 catalog_os.FREESTANDING,
    name:               "freestanding",
    default_of:         "raw",
    supported_ofs:      ?SUPPORTED_OFS[0],
    supported_of_count: 3,
    isa_rows:           ?ISA_ROWS[0],
    isa_row_count:      4,
    isa_any:            ?ISA_ANY,
    entry_symbol:       "_start",
    c_symbol_prefix:    "",
    base_addr:          BASE_ADDR,
    page_size:          PAGE_SIZE,
    stack_probe:        false,
    mapped_by_loader:   false,
    naming:             target_of.SystemNaming{static_prefix: "lib", static_suffix: ".a", executable_suffix: ""},
};
