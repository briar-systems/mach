use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.os;

pub val FREESTANDING_BASE_ADDR: u64 = 0;

# no loader of its own: a page-mapping format takes the isa's hardware page, a
# flat image has no page (#3360)
pub val FREESTANDING_PAGE_SIZE: u64 = 0;

# no runtime calls a platform, so every convention the isa covers is accepted;
# the named one is only the default `mach init` scaffolds
fun freestanding_accepted_abis(arch_id: u32) os.AbiSet {
    if (arch_id == isa.ARCH_X86_64)  { ret os.abi_set_unconstrained("sysv64"); }
    if (arch_id == isa.ARCH_AARCH64) { ret os.abi_set_unconstrained("aapcs64"); }
    if (arch_id == isa.ARCH_RISCV64) { ret os.abi_set_unconstrained("lp64d"); }
    if (arch_id == isa.ARCH_RISCV32) { ret os.abi_set_unconstrained("ilp32"); }
    var any: os.AbiSet = os.abi_set_none();
    any.unconstrained = true;
    ret any;
}

pub fun freestanding_va_list(arch_id: u32) opt[os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret opt[os.VaList].some{os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_AARCH64) { ret opt[os.VaList].some{os.va_list(32, 8)}; }
    if (arch_id == isa.ARCH_RISCV64) { ret opt[os.VaList].some{os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_RISCV32) { ret opt[os.VaList].some{os.va_list(4, 4)}; }
    ret opt[os.VaList].none{};
}

fun freestanding_fs_policy(arch_id: u32) opt[os.FsPolicy] {
    var p: os.FsPolicy;
    p.sysroot             = "";
    p.toolchain_root      = "";
    p.dynamic_interpreter = "";
    p.platform_lib        = "";
    p.libdir_len          = 0;
    ret opt[os.FsPolicy].some{p};
}

pub fun register_freestanding(reg: *os.OsRegistry) err[fail.Fail] {
    var freestanding_vtable: os.OsVTable;
    freestanding_vtable.id                 = os.OS_FREESTANDING;
    freestanding_vtable.name               = os.os_name_for(os.OS_FREESTANDING);
    freestanding_vtable.default_of         = of.of_name_for(of.OF_RAW);
    freestanding_vtable.supported_of_count = 0;
    os.support_of(?freestanding_vtable, of.of_name_for(of.OF_RAW));
    os.support_of(?freestanding_vtable, of.of_name_for(of.OF_ELF));
    os.support_of(?freestanding_vtable, of.of_name_for(of.OF_SPV));
    freestanding_vtable.supported_isa_any   = true;
    freestanding_vtable.supported_isa_count = 0;
    freestanding_vtable.entry_symbol        = "_start";
    freestanding_vtable.c_symbol_prefix     = "";
    freestanding_vtable.fs_policy           = freestanding_fs_policy;
    freestanding_vtable.base_addr           = FREESTANDING_BASE_ADDR;
    freestanding_vtable.page_size           = FREESTANDING_PAGE_SIZE;
    freestanding_vtable.stack_probe         = false;
    freestanding_vtable.mapped_by_loader    = false;
    freestanding_vtable.accepted_abis       = freestanding_accepted_abis;
    freestanding_vtable.variadic_stack      = nil;
    freestanding_vtable.natural_stack_args  = nil;
    freestanding_vtable.reg_arg_align       = nil;
    freestanding_vtable.reg_arg_extend      = nil;
    freestanding_vtable.va_list_layout      = freestanding_va_list;
    # no kernel, so nobody sets or preserves PSTATE.DIT for the program (#3508)
    freestanding_vtable.dit_guaranteed = nil;

    ret os.register(reg, ?freestanding_vtable);
}
