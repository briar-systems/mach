use mach.lang.fail;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

val FREESTANDING_BASE_ADDR: u64 = 0;

# no loader of its own: a page-mapping format takes the isa's hardware page, a
# flat image has no page
val FREESTANDING_PAGE_SIZE: u64 = 0;

# no runtime calls a platform, so every convention the isa covers is accepted;
# the named one is only the default `mach init` scaffolds
fun freestanding_accepted_abis(arch_id: u32) lang_target_os.AbiSet {
    if (arch_id == catalog_arch.X86_64)  { ret lang_target_os.abi_set_unconstrained("sysv64"); }
    if (arch_id == catalog_arch.AARCH64) { ret lang_target_os.abi_set_unconstrained("aapcs64"); }
    if (arch_id == catalog_arch.RISCV64) { ret lang_target_os.abi_set_unconstrained("lp64d"); }
    if (arch_id == catalog_arch.RISCV32) { ret lang_target_os.abi_set_unconstrained("ilp32"); }
    var any: lang_target_os.AbiSet = lang_target_os.abi_set_none();
    any.unconstrained = true;
    ret any;
}

fun freestanding_va_list(arch_id: u32) opt[lang_target_os.VaList] {
    if (arch_id == catalog_arch.X86_64)  { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == catalog_arch.AARCH64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(32, 8)}; }
    if (arch_id == catalog_arch.RISCV64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == catalog_arch.RISCV32) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(4, 4)}; }
    ret opt[lang_target_os.VaList].none{};
}

fun freestanding_fs_policy(arch_id: u32) opt[catalog_os.FsPolicy] {
    var p: catalog_os.FsPolicy;
    p.sysroot             = "";
    p.toolchain_root      = "";
    p.dynamic_interpreter = "";
    p.platform_lib        = "";
    p.libdir_len          = 0;
    ret opt[catalog_os.FsPolicy].some{p};
}

val SUPPORTED_OFS: [3]str = [3]str{"raw", "elf", "spv"};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                 catalog_os.FREESTANDING,
    name:               "freestanding",
    default_of:         "raw",
    supported_ofs:      ?SUPPORTED_OFS[0],
    supported_of_count: 3,
    supported_isa_any:  true,
    entry_symbol:       "_start",
    c_symbol_prefix:    "",
    fs_policy:          freestanding_fs_policy,
    base_addr:          FREESTANDING_BASE_ADDR,
    page_size:          FREESTANDING_PAGE_SIZE,
    stack_probe:        false,
    mapped_by_loader:   false,
    accepted_abis:      freestanding_accepted_abis,
    va_list_layout:     freestanding_va_list,
    # no kernel, so nobody sets or preserves PSTATE.DIT for the program
    dit_guaranteed: nil,
};
