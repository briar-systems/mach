use mach.lang.fail;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;

use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

val FREESTANDING_BASE_ADDR: u64 = 0;

# no loader of its own: a page-mapping format takes the isa's hardware page, a
# flat image has no page (#3360)
val FREESTANDING_PAGE_SIZE: u64 = 0;

# no runtime calls a platform, so every convention the isa covers is accepted;
# the named one is only the default `mach init` scaffolds
fun freestanding_accepted_abis(arch_id: u32) lang_target_os.AbiSet {
    if (arch_id == isa.ARCH_X86_64)  { ret lang_target_os.abi_set_unconstrained("sysv64"); }
    if (arch_id == isa.ARCH_AARCH64) { ret lang_target_os.abi_set_unconstrained("aapcs64"); }
    if (arch_id == isa.ARCH_RISCV64) { ret lang_target_os.abi_set_unconstrained("lp64d"); }
    if (arch_id == isa.ARCH_RISCV32) { ret lang_target_os.abi_set_unconstrained("ilp32"); }
    var any: lang_target_os.AbiSet = lang_target_os.abi_set_none();
    any.unconstrained = true;
    ret any;
}

fun freestanding_va_list(arch_id: u32) opt[lang_target_os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_AARCH64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(32, 8)}; }
    if (arch_id == isa.ARCH_RISCV64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_RISCV32) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(4, 4)}; }
    ret opt[lang_target_os.VaList].none{};
}

fun freestanding_fs_policy(arch_id: u32) opt[lang_target_os.FsPolicy] {
    var p: lang_target_os.FsPolicy;
    p.sysroot             = "";
    p.toolchain_root      = "";
    p.dynamic_interpreter = "";
    p.platform_lib        = "";
    p.libdir_len          = 0;
    ret opt[lang_target_os.FsPolicy].some{p};
}

pub fun register_freestanding(reg: *lang_target_os.OsRegistry) err[fail.Fail] {
    var freestanding_vtable: lang_target_os.OsVTable;
    freestanding_vtable.id                 = lang_target_os.OS_FREESTANDING;
    freestanding_vtable.name               = lang_target_os.os_name_for(lang_target_os.OS_FREESTANDING);
    freestanding_vtable.default_of         = target_of.of_name_for(target_of.OF_RAW);
    freestanding_vtable.supported_of_count = 0;
    lang_target_os.support_of(?freestanding_vtable, target_of.of_name_for(target_of.OF_RAW));
    lang_target_os.support_of(?freestanding_vtable, target_of.of_name_for(target_of.OF_ELF));
    lang_target_os.support_of(?freestanding_vtable, target_of.of_name_for(target_of.OF_SPV));
    freestanding_vtable.supported_isa_any   = true;
    freestanding_vtable.supported_isa_count = 0;
    freestanding_vtable.entry_symbol        = "_start";
    freestanding_vtable.c_symbol_prefix     = "";
    freestanding_vtable.fs_policy           = freestanding_fs_policy;
    freestanding_vtable.base_addr           = FREESTANDING_BASE_ADDR;
    freestanding_vtable.page_size           = FREESTANDING_PAGE_SIZE;
    freestanding_vtable.stack_probe         = false;
    freestanding_vtable.mapped_by_loader    = false;
    freestanding_vtable.accepted_abis       = freestanding_accepted_abis;
    freestanding_vtable.variadic_stack      = nil;
    freestanding_vtable.natural_stack_args  = nil;
    freestanding_vtable.reg_arg_align       = nil;
    freestanding_vtable.reg_arg_extend      = nil;
    freestanding_vtable.declared_agg_align  = nil;
    freestanding_vtable.va_list_layout      = freestanding_va_list;
    # no kernel, so nobody sets or preserves PSTATE.DIT for the program (#3508)
    freestanding_vtable.dit_guaranteed = nil;

    ret lang_target_os.register(reg, ?freestanding_vtable);
}
