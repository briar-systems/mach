# BareMetal (bmos) operating-system implementation
#
# Supplies the `OsVTable` for ReturnInfinity's BareMetal exokernel: an x86-64-only
# OS that loads a program as a flat image at a fixed high-canonical address and
# enters it with a plain `call`. It is a real OS with its own load contract, not a
# flavour of `freestanding` - hence its own id, name, and vtable.
#
# The contract this vtable encodes, taken from the kernel and its demo programs:
#
#   - LOAD ADDRESS. `app_start` in BareMetal's `src/sysvar.asm` is
#     0xFFFF800000000000, the same address the monitor holds in `ProgramLocation`
#     and the same `.` the demo programs' `c.ld` sets. It is fixed: the loader
#     reads the file straight to that address with no relocation step.
#   - IMAGE FORMAT. A container-free flat binary - `c.ld` declares
#     `OUTPUT_FORMAT(binary)`, and the assembly demos are assembled with nasm's
#     default flat output. The monitor copies the file's bytes verbatim from
#     storage to the load address, so there is no header to skip and no metadata
#     to read.
#   - ENTRY. Execution begins at the first byte of the image: the monitor does
#     `call [ProgramLocation]`. A program therefore ENTERS AT ITS BASE, and the
#     `raw` writer's entry-at-base contract is exactly this fact.
#   - EXIT. The program leaves by RETURNING - the demos end in `ret`, which
#     returns to the monitor's command loop. There is no exit syscall.
#
# Two consequences for anything built on top of this vtable. The stack is NOT
# guaranteed 16-byte aligned at entry (BareMetal's own `crt0.c` aligns RSP itself
# before calling into C, precisely because SSE faults otherwise), and `.bss` is
# not zeroed by the loader (the flat image stores file bytes only). Both belong to
# a bmos startup shim, not to this vtable.
#
# The kernel API is not syscalls: it is a table of absolute function pointers at
# 0x100010..0x100040 called indirectly (`call [b_output]`), under a custom
# register convention. That is a library-side fact, reached from Mach through
# inline asm; nothing in the compiler encodes it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use R: std.types.result;

use mach.lang.target.os;
use mach.lang.target.isa;

# the fixed virtual address BareMetal loads a program at, and the address its
# loader calls: `app_start` in the kernel's sysvar.asm, `ProgramLocation` in the
# monitor, and the linker script origin the C demos are linked at. not
# configurable - the loader performs no relocation
pub val BMOS_BASE_ADDR: u64 = 0xFFFF800000000000;

# segment alignment for a bmos image. the loader copies the file contiguously to
# the load address, so a page-aligned segment start would only pad the image with
# zeroes; 1 packs the segments tightly and leaves each section its own alignment
pub val BMOS_PAGE_SIZE: u64 = 1;

# BareMetal's native calling convention per architecture: SysV AMD64 on x86-64,
# the convention its own C programs are compiled under. "" everywhere else, since
# bmos runs on no other architecture
# ---
# arch_id: the target architecture id (one of isa.ARCH_*)
# ret:     "sysv64" on x86_64, "" otherwise
fun bmos_native_abi(arch_id: u32) str {
    if (arch_id == isa.ARCH_X86_64) { ret "sysv64"; }
    ret "";
}

# the bmos OS vtable. populated by register_bmos on first call and handed out as a
# borrowed pointer to the registry; remains valid for the process lifetime
var bmos_vtable: os.OsVTable;

# build and install the bmos OsVTable
#
# Fills the module-level vtable with the flat-image format, the `_start` entry
# symbol (a program marks its entry fn `#[symbol("_start")]`), the fixed
# 0xFFFF800000000000 load address, and x86-64 as the only architecture the kernel
# runs on, then installs it into `reg` under the "bmos" key. There is no dynamic
# loader, no system library directory, no platform library, and no stack-probe
# contract: a bmos program is a static image the kernel copies and calls. It is
# never position-independent either - the image is copied to one fixed address
# and entered there - so it declares no PIE policy and carries no base
# relocations. The vtable strings are not interned here. Must be invoked at
# startup before target.select requests a bmos target.
# ---
# reg: the OS registry to install the vtable into
# ret: ok(true) always; the Result return is kept for registrar-signature parity
pub fun register_bmos(reg: *os.OsRegistry) R.Result[bool, str] {
    bmos_vtable.id             = os.OS_BMOS;
    bmos_vtable.name           = "bmos";
    bmos_vtable.default_of     = "raw";
    # the loader copies the file's bytes to the load address and calls the first
    # one; a flat image is the only shape it can enter.
    bmos_vtable.supported_of_count = 0;
    os.support_of(?bmos_vtable, "raw");
    # BareMetal is a 64-bit x86 exokernel and is written in x86-64 assembly; it has
    # been ported to no other architecture.
    bmos_vtable.supported_isa_any   = false;
    bmos_vtable.supported_isa_count = 0;
    os.support_isa(?bmos_vtable, isa.ARCH_X86_64);
    bmos_vtable.entry_symbol   = "_start";
    bmos_vtable.libdir_len     = 0;
    bmos_vtable.dynamic_linker = "";
    bmos_vtable.base_addr      = BMOS_BASE_ADDR;
    bmos_vtable.page_size      = BMOS_PAGE_SIZE;
    # the kernel maps the application region up front; there is no guard-page
    # commit to walk, so no per-page probe.
    bmos_vtable.stack_probe    = false;
    # SysV AMD64, the convention BareMetal's own C programs are built under.
    bmos_vtable.native_abi     = bmos_native_abi;

    os.register(reg, ?bmos_vtable);
    ret R.ok[bool, str](true);
}
