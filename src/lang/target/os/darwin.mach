use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

pub val DARWIN_BASE_ADDR: u64 = 0x100000000;

val DARWIN_PAGE_SIZE: u64 = 4096;

fun darwin_pie_exec(arch_id: u32) bool {
    ret arch_id == catalog_arch.AARCH64;
}

fun darwin_page_size(arch_id: u32) u64 {
    if (arch_id == catalog_arch.AARCH64) { ret 16384; }
    ret DARWIN_PAGE_SIZE;
}

fun darwin_accepted_abis(arch_id: u32) lang_target_os.AbiSet {
    if (arch_id == catalog_arch.X86_64)  { ret lang_target_os.abi_set_one("sysv64"); }
    if (arch_id == catalog_arch.AARCH64) { ret lang_target_os.abi_set_one("aapcs64"); }
    ret lang_target_os.abi_set_none();
}

fun darwin_variadic_stack(arch_id: u32) bool {
    ret arch_id == catalog_arch.AARCH64;
}

fun darwin_natural_stack_args(arch_id: u32) bool {
    ret arch_id == catalog_arch.AARCH64;
}

# Apple, "Writing ARM64 code for Apple platforms", section "Pass arguments to
# functions correctly": an argument with 16-byte alignment may start in an
# odd-numbered x register, where AAPCS64 C.10 rounds it up to an even one
fun darwin_reg_arg_align(arch_id: u32) u32 {
    if (arch_id == catalog_arch.AARCH64) { ret 8; }
    ret 0;
}

# Apple, "Writing ARM64 code for Apple platforms", section "Pass arguments to
# functions correctly": the caller sign- or zero-extends an argument narrower
# than 32 bits, where AAPCS64 leaves the upper bits to the callee
fun darwin_reg_arg_extend(arch_id: u32) u32 {
    if (arch_id == catalog_arch.AARCH64) { ret 32; }
    ret 0;
}

# Apple clang places a record argument by its declared alignment, #[align]
# included, where AAPCS64 takes the alignment its members give it: a 16-byte
# record raised to 16 goes to a 16-byte aligned stack slot
fun darwin_declared_agg_align(arch_id: u32) bool {
    ret arch_id == catalog_arch.AARCH64;
}

val DARWIN_AARCH64_X18: u32 = 18;

fun darwin_reserved_gp(arch_id: u32) u32 {
    if (arch_id == catalog_arch.AARCH64) { ret 1::u32 << DARWIN_AARCH64_X18; }
    ret 0;
}

# darwin guarantees PSTATE.DIT for an aarch64 process: Apple, "Writing ARM64
# code for Apple platforms", section "Enable DIT for constant-time
# cryptographic operations", documents the mode as per-thread processor state
# user code turns on with `msr dit, #1` and reads back as bit 24 of `mrs dit`,
# and names `hw.optional.arm.FEAT_DIT` (sysctl) as the check for a processor
# that has it; the runtime fails closed when that answers 0 rather than
# assuming every Apple silicon part has it
fun darwin_dit_guaranteed(arch_id: u32) bool {
    ret arch_id == catalog_arch.AARCH64;
}

fun darwin_va_list(arch_id: u32) opt[lang_target_os.VaList] {
    if (arch_id == catalog_arch.X86_64)  { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == catalog_arch.AARCH64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    ret opt[lang_target_os.VaList].none{};
}

fun darwin_fs_policy(arch_id: u32) opt[catalog_os.FsPolicy] {
    if (arch_id != catalog_arch.X86_64 && arch_id != catalog_arch.AARCH64) { ret opt[catalog_os.FsPolicy].none{}; }
    var p: catalog_os.FsPolicy;
    p.sysroot             = "";
    p.toolchain_root      = "";
    p.dynamic_interpreter = "";
    p.platform_lib        = "/usr/lib/libSystem.B.dylib";
    p.libdirs[0]          = "/usr/lib";
    p.libdirs[1]          = "/usr/local/lib";
    p.libdir_len          = 2;
    ret opt[catalog_os.FsPolicy].some{p};
}

val SUPPORTED_OFS: [1]str = [1]str{"macho"};

val SUPPORTED_ISAS: [2]u32 = [2]u32{catalog_arch.X86_64, catalog_arch.AARCH64};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                  catalog_os.DARWIN,
    name:                "darwin",
    default_of:          "macho",
    supported_ofs:       ?SUPPORTED_OFS[0],
    supported_of_count:  1,
    supported_isas:      ?SUPPORTED_ISAS[0],
    supported_isa_count: 2,
    entry_symbol:        "start",
    c_symbol_prefix:     "_",
    fs_policy:           darwin_fs_policy,
    base_addr:           DARWIN_BASE_ADDR,
    page_size:           DARWIN_PAGE_SIZE,
    stack_probe:         true,
    mapped_by_loader:    true,
    pie_exec:            darwin_pie_exec,
    page_size_for:       darwin_page_size,
    accepted_abis:       darwin_accepted_abis,
    variadic_stack:      darwin_variadic_stack,
    natural_stack_args:  darwin_natural_stack_args,
    reg_arg_align:       darwin_reg_arg_align,
    reg_arg_extend:      darwin_reg_arg_extend,
    declared_agg_align:  darwin_declared_agg_align,
    va_list_layout:      darwin_va_list,
    reserved_gp:         darwin_reserved_gp,
    dit_guaranteed:      darwin_dit_guaranteed,
};

test vtable__wires_per_arch_policy {
    val vt: *lang_target_os.OsVTable = ?VTABLE;
    if (lang_target_os.reserved_gp_for(vt, catalog_arch.AARCH64) != (1::u32 << 18))                                                           { ret 3; }
    if (lang_target_os.reserved_gp_for(vt, catalog_arch.X86_64) != 0)                                                                         { ret 4; }
    if (!lang_target_os.dit_guaranteed_for(vt, catalog_arch.AARCH64))                                                                         { ret 5; }
    if (lang_target_os.dit_guaranteed_for(vt, catalog_arch.X86_64))                                                                           { ret 6; }
    if (lang_target_os.reg_arg_align_for(vt, catalog_arch.AARCH64) != 8 || lang_target_os.reg_arg_align_for(vt, catalog_arch.X86_64) != 0)    { ret 7; }
    if (lang_target_os.reg_arg_extend_for(vt, catalog_arch.AARCH64) != 32 || lang_target_os.reg_arg_extend_for(vt, catalog_arch.X86_64) != 0) { ret 8; }
    if (!lang_target_os.declared_agg_align_for(vt, catalog_arch.AARCH64) || lang_target_os.declared_agg_align_for(vt, catalog_arch.X86_64))   { ret 9; }
    ret 0;
}
