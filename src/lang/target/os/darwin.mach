use std.types.bool.true;
use std.types.string.str;

use catalog_arch:   mach.lang.target.catalog.arch;
use catalog_os:     mach.lang.target.catalog.os;
use lang_target_os: mach.lang.target.os;

pub val BASE_ADDR: u64 = 0x100000000;

val PAGE_SIZE: u64 = 4096;

val FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    dynamic_interpreter: "",
    platform_lib:        "/usr/lib/libSystem.B.dylib",
    libdirs:             [catalog_os.LIBDIR_MAX]str{"/usr/lib", "/usr/local/lib", "", "", "", "", "", ""},
    libdir_len:          2,
};

val SUPPORTED_OFS: [1]str = [1]str{"macho"};

val AARCH64_X18: u32 = 18;

val ISA_ROWS: [2]lang_target_os.IsaRow = [2]lang_target_os.IsaRow{
    lang_target_os.IsaRow{
        arch:      catalog_arch.X86_64,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"sysv64", "", "", ""}, len: 1},
        page_size: PAGE_SIZE,
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?FS_POLICY,
    },
    lang_target_os.IsaRow{
        arch:               catalog_arch.AARCH64,
        abis:               lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"aapcs64", "", "", ""}, len: 1},
        page_size:          16384,
        va_list:            lang_target_os.VaList{size: 8, align: 8},
        fs_policy:          ?FS_POLICY,
        pie_exec:           true,
        variadic_stack:     true,
        natural_stack_args: true,
        # Apple, "Writing ARM64 code for Apple platforms", section "Pass
        # arguments to functions correctly": an argument with 16-byte alignment
        # may start in an odd-numbered x register, where AAPCS64 C.10 rounds it
        # up to an even one
        reg_arg_align: 8,
        # the same section: the caller sign- or zero-extends an argument
        # narrower than 32 bits, where AAPCS64 leaves the upper bits to the
        # callee
        reg_arg_extend: 32,
        # Apple clang places a record argument by its declared alignment,
        # #[align] included, where AAPCS64 takes the alignment its members give
        # it: a 16-byte record raised to 16 goes to a 16-byte aligned stack slot
        declared_agg_align: true,
        reserved_gp:        1::u32 << AARCH64_X18,
        # darwin guarantees PSTATE.DIT for an aarch64 process: Apple, "Writing
        # ARM64 code for Apple platforms", section "Enable DIT for constant-time
        # cryptographic operations", documents the mode as per-thread processor
        # state user code turns on with `msr dit, #1` and reads back as bit 24
        # of `mrs dit`, and names `hw.optional.arm.FEAT_DIT` (sysctl) as the
        # check for a processor that has it; the runtime fails closed when that
        # answers 0 rather than assuming every Apple silicon part has it
        dit_guaranteed: true,
    },
};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                 catalog_os.DARWIN,
    name:               "darwin",
    default_of:         "macho",
    supported_ofs:      ?SUPPORTED_OFS[0],
    supported_of_count: 1,
    isa_rows:           ?ISA_ROWS[0],
    isa_row_count:      2,
    entry_symbol:       "start",
    c_symbol_prefix:    "_",
    base_addr:          BASE_ADDR,
    page_size:          PAGE_SIZE,
    stack_probe:        true,
    mapped_by_loader:   true,
    framework_root:     "/System/Library/Frameworks",
};

test vtable__wires_per_arch_policy {
    val vt: *lang_target_os.OsVTable = ?VTABLE;
    if (lang_target_os.reserved_gp_for(vt, catalog_arch.AARCH64) != (1::u32 << 18))                                                           { ret 3; }
    if (lang_target_os.reserved_gp_for(vt, catalog_arch.X86_64) != 0)                                                                         { ret 4; }
    if (!lang_target_os.dit_guaranteed_for(vt, catalog_arch.AARCH64))                                                                         { ret 5; }
    if (lang_target_os.dit_guaranteed_for(vt, catalog_arch.X86_64))                                                                           { ret 6; }
    if (lang_target_os.reg_arg_align_for(vt, catalog_arch.AARCH64) != 8 || lang_target_os.reg_arg_align_for(vt, catalog_arch.X86_64) != 0)    { ret 7; }
    if (lang_target_os.reg_arg_extend_for(vt, catalog_arch.AARCH64) != 32 || lang_target_os.reg_arg_extend_for(vt, catalog_arch.X86_64) != 0) { ret 8; }
    if (!lang_target_os.declared_agg_align_for(vt, catalog_arch.AARCH64) || lang_target_os.declared_agg_align_for(vt, catalog_arch.X86_64))   { ret 9; }
    ret 0;
}
