use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;


use mach.lang.target.of;
use mach.lang.target.os;
use mach.lang.target.isa;

pub val DARWIN_BASE_ADDR: u64 = 0x100000000;

pub val DARWIN_PAGE_SIZE: u64 = 4096;

fun darwin_pie_exec(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

fun darwin_page_size(arch_id: u32) u64 {
    if (arch_id == isa.ARCH_AARCH64) { ret 16384; }
    ret DARWIN_PAGE_SIZE;
}

fun darwin_native_abi(arch_id: u32) str {
    if (arch_id == isa.ARCH_X86_64)  { ret "sysv64"; }
    if (arch_id == isa.ARCH_AARCH64) { ret "aapcs64"; }
    ret "";
}

fun darwin_variadic_stack(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

fun darwin_natural_stack_args(arch_id: u32) bool {
    ret arch_id == isa.ARCH_AARCH64;
}

val DARWIN_AARCH64_X18: u32 = 18;

fun darwin_reserved_gp(arch_id: u32) u32 {
    if (arch_id == isa.ARCH_AARCH64) { ret 1::u32 << DARWIN_AARCH64_X18; }
    ret 0;
}

pub fun darwin_va_list(arch_id: u32) opt[os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret opt[os.VaList].some{os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_AARCH64) { ret opt[os.VaList].some{os.va_list(8, 8)}; }
    ret opt[os.VaList].none{};
}

fun darwin_fs_policy(arch_id: u32) opt[os.FsPolicy] {
    if (arch_id != isa.ARCH_X86_64 && arch_id != isa.ARCH_AARCH64) { ret opt[os.FsPolicy].none{}; }
    var p: os.FsPolicy;
    p.sysroot = "";
    p.toolchain_root = "";
    p.dynamic_interpreter = "";
    p.platform_lib = "/usr/lib/libSystem.B.dylib";
    p.libdirs[0] = "/usr/lib";
    p.libdirs[1] = "/usr/local/lib";
    p.libdir_len = 2;
    ret opt[os.FsPolicy].some{p};
}

pub fun register_darwin(reg: *os.OsRegistry) err[fail.Fail] {
    var darwin_vtable: os.OsVTable;
    darwin_vtable.id             = os.OS_DARWIN;
    darwin_vtable.name           = os.os_name_for(os.OS_DARWIN);
    darwin_vtable.default_of     = of.of_name_for(of.OF_MACHO);
    darwin_vtable.supported_of_count = 0;
    os.support_of(?darwin_vtable, of.of_name_for(of.OF_MACHO));
    darwin_vtable.supported_isa_any   = false;
    darwin_vtable.supported_isa_count = 0;
    os.support_isa(?darwin_vtable, isa.ARCH_X86_64);
    os.support_isa(?darwin_vtable, isa.ARCH_AARCH64);
    darwin_vtable.entry_symbol   = "start";
    darwin_vtable.c_symbol_prefix = "_";
    darwin_vtable.fs_policy      = darwin_fs_policy;
    darwin_vtable.base_addr      = DARWIN_BASE_ADDR;
    darwin_vtable.page_size      = DARWIN_PAGE_SIZE;
    darwin_vtable.stack_probe    = false;
    darwin_vtable.mapped_by_loader = true;
    darwin_vtable.pie_exec       = darwin_pie_exec;
    darwin_vtable.page_size_for  = darwin_page_size;
    darwin_vtable.native_abi     = darwin_native_abi;
    darwin_vtable.variadic_stack = darwin_variadic_stack;
    darwin_vtable.natural_stack_args = darwin_natural_stack_args;
    darwin_vtable.va_list_layout = darwin_va_list;
    darwin_vtable.reserved_gp    = darwin_reserved_gp;

    ret os.register(reg, ?darwin_vtable);
}

test "mach.lang.target.os.darwin.darwin_reserved_gp:x18_only_on_aarch64" {
    if (darwin_reserved_gp(isa.ARCH_AARCH64) != (1::u32 << 18)) { ret 1; }
    if (darwin_reserved_gp(isa.ARCH_X86_64)  != 0)               { ret 2; }
    if (darwin_reserved_gp(isa.ARCH_RISCV64) != 0)               { ret 3; }
    ret 0;
}

test "mach.lang.target.os.darwin.register_darwin:wires_reserved_gp" {
    var reg: os.OsRegistry = os.registry_init();
    val r_104: err[fail.Fail] = register_darwin(?reg);
    if (sel r_104.err) { os.registry_dnit(?reg); ret 1; }
    val opt_: opt[*os.OsVTable] = os.lookup(?reg, "darwin");
    if (sel opt_.none) { os.registry_dnit(?reg); ret 2; }
    val vt: *os.OsVTable = opt_.some;
    if (os.reserved_gp_for(vt, isa.ARCH_AARCH64) != (1::u32 << 18)) { os.registry_dnit(?reg); ret 3; }
    if (os.reserved_gp_for(vt, isa.ARCH_X86_64)  != 0)               { os.registry_dnit(?reg); ret 4; }
    os.registry_dnit(?reg);
    ret 0;
}
