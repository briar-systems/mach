use std.types.bool.true;
use std.types.string.str;

use catalog_arch:   mach.lang.target.catalog.arch;
use catalog_os:     mach.lang.target.catalog.os;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

val BASE_ADDR: u64 = 0x140000000;

val PAGE_SIZE: u64 = 4096;

val FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    dynamic_interpreter: "",
    platform_lib:        "",
    libdirs:             [catalog_os.LIBDIR_MAX]str{"C:\\Windows\\System32", "", "", "", "", "", "", ""},
    libdir_len:          1,
};

val SUPPORTED_OFS: [1]str = [1]str{"coff"};

# no DIT declaration: windows on aarch64 documents no user-settable PSTATE.DIT
# contract yet, so a DIT_MODE multiply row is refused there
val ISA_ROWS: [2]lang_target_os.IsaRow = [2]lang_target_os.IsaRow{
    lang_target_os.IsaRow{
        arch:      catalog_arch.X86_64,
        abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"win64", "", "", ""}, len: 1},
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?FS_POLICY,
        pie_exec:  true,
    },
    lang_target_os.IsaRow{
        arch:      catalog_arch.AARCH64,
        va_list:   lang_target_os.VaList{size: 8, align: 8},
        fs_policy: ?FS_POLICY,
    },
};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                 catalog_os.WINDOWS,
    name:               "windows",
    default_of:         "coff",
    supported_ofs:      ?SUPPORTED_OFS[0],
    supported_of_count: 1,
    isa_rows:           ?ISA_ROWS[0],
    isa_row_count:      2,
    entry_symbol:       "mainCRTStartup",
    c_symbol_prefix:    "",
    base_addr:          BASE_ADDR,
    page_size:          PAGE_SIZE,
    stack_probe:        true,
    mapped_by_loader:   true,
    naming:             target_of.SystemNaming{static_prefix: "", static_suffix: ".lib", executable_suffix: ".exe"},
};
