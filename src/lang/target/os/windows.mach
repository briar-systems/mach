use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;

use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

pub val WINDOWS_BASE_ADDR: u64 = 0x140000000;

pub val WINDOWS_PAGE_SIZE: u64 = 4096;

fun windows_pie_exec(arch_id: u32) bool {
    ret arch_id == isa.ARCH_X86_64;
}

fun windows_accepted_abis(arch_id: u32) lang_target_os.AbiSet {
    if (arch_id == isa.ARCH_X86_64) { ret lang_target_os.abi_set_one("win64"); }
    ret lang_target_os.abi_set_none();
}

pub fun windows_va_list(arch_id: u32) opt[lang_target_os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == isa.ARCH_AARCH64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    ret opt[lang_target_os.VaList].none{};
}

fun windows_fs_policy(arch_id: u32) opt[lang_target_os.FsPolicy] {
    if (arch_id != isa.ARCH_X86_64 && arch_id != isa.ARCH_AARCH64) { ret opt[lang_target_os.FsPolicy].none{}; }
    var p: lang_target_os.FsPolicy;
    p.sysroot             = "";
    p.toolchain_root      = "";
    p.dynamic_interpreter = "";
    p.platform_lib        = "";
    p.libdirs[0]          = "C:\\Windows\\System32";
    p.libdir_len          = 1;
    ret opt[lang_target_os.FsPolicy].some{p};
}

pub fun register_windows(reg: *lang_target_os.OsRegistry) err[fail.Fail] {
    var windows_vtable: lang_target_os.OsVTable;
    windows_vtable.id                 = lang_target_os.OS_WINDOWS;
    windows_vtable.name               = lang_target_os.os_name_for(lang_target_os.OS_WINDOWS);
    windows_vtable.default_of         = target_of.of_name_for(target_of.OF_COFF);
    windows_vtable.supported_of_count = 0;
    lang_target_os.support_of(?windows_vtable, target_of.of_name_for(target_of.OF_COFF));
    windows_vtable.supported_isa_any   = false;
    windows_vtable.supported_isa_count = 0;
    lang_target_os.support_isa(?windows_vtable, isa.ARCH_X86_64);
    lang_target_os.support_isa(?windows_vtable, isa.ARCH_AARCH64);
    windows_vtable.entry_symbol       = "mainCRTStartup";
    windows_vtable.c_symbol_prefix    = "";
    windows_vtable.fs_policy          = windows_fs_policy;
    windows_vtable.base_addr          = WINDOWS_BASE_ADDR;
    windows_vtable.page_size          = WINDOWS_PAGE_SIZE;
    windows_vtable.stack_probe        = true;
    windows_vtable.mapped_by_loader   = true;
    windows_vtable.pie_exec           = windows_pie_exec;
    windows_vtable.accepted_abis      = windows_accepted_abis;
    windows_vtable.variadic_stack     = nil;
    windows_vtable.natural_stack_args = nil;
    windows_vtable.reg_arg_align      = nil;
    windows_vtable.reg_arg_extend     = nil;
    windows_vtable.declared_agg_align = nil;
    windows_vtable.va_list_layout     = windows_va_list;
    # no DIT declaration: windows on aarch64 documents no user-settable
    # PSTATE.DIT contract yet, so a DIT_MODE multiply row is refused there (#3508)
    windows_vtable.dit_guaranteed = nil;

    ret lang_target_os.register(reg, ?windows_vtable);
}
