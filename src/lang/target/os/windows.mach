use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.isa;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

val WINDOWS_BASE_ADDR: u64 = 0x140000000;

val WINDOWS_PAGE_SIZE: u64 = 4096;

fun windows_pie_exec(arch_id: u32) bool {
    ret arch_id == catalog_arch.X86_64;
}

fun windows_accepted_abis(arch_id: u32) lang_target_os.AbiSet {
    if (arch_id == catalog_arch.X86_64) { ret lang_target_os.abi_set_one("win64"); }
    ret lang_target_os.abi_set_none();
}

fun windows_va_list(arch_id: u32) opt[lang_target_os.VaList] {
    if (arch_id == catalog_arch.X86_64)  { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    if (arch_id == catalog_arch.AARCH64) { ret opt[lang_target_os.VaList].some{lang_target_os.va_list(8, 8)}; }
    ret opt[lang_target_os.VaList].none{};
}

fun windows_fs_policy(arch_id: u32) opt[catalog_os.FsPolicy] {
    if (arch_id != catalog_arch.X86_64 && arch_id != catalog_arch.AARCH64) { ret opt[catalog_os.FsPolicy].none{}; }
    var p: catalog_os.FsPolicy;
    p.sysroot             = "";
    p.toolchain_root      = "";
    p.dynamic_interpreter = "";
    p.platform_lib        = "";
    p.libdirs[0]          = "C:\\Windows\\System32";
    p.libdir_len          = 1;
    ret opt[catalog_os.FsPolicy].some{p};
}

val SUPPORTED_OFS: [1]str = [1]str{"coff"};

val SUPPORTED_ISAS: [2]u32 = [2]u32{catalog_arch.X86_64, catalog_arch.AARCH64};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                  catalog_os.WINDOWS,
    name:                "windows",
    default_of:          "coff",
    supported_ofs:       ?SUPPORTED_OFS[0],
    supported_of_count:  1,
    supported_isas:      ?SUPPORTED_ISAS[0],
    supported_isa_count: 2,
    entry_symbol:        "mainCRTStartup",
    c_symbol_prefix:     "",
    fs_policy:           windows_fs_policy,
    base_addr:           WINDOWS_BASE_ADDR,
    page_size:           WINDOWS_PAGE_SIZE,
    stack_probe:         true,
    mapped_by_loader:    true,
    pie_exec:            windows_pie_exec,
    accepted_abis:       windows_accepted_abis,
    va_list_layout:      windows_va_list,
    # no DIT declaration: windows on aarch64 documents no user-settable
    # PSTATE.DIT contract yet, so a DIT_MODE multiply row is refused there
    dit_guaranteed: nil,
};
