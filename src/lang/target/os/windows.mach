use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use O: std.types.option;
use R: std.types.result;

use mach.lang.target.of;
use mach.lang.target.os;
use mach.lang.target.isa;

pub val WINDOWS_BASE_ADDR: u64 = 0x140000000;

pub val WINDOWS_PAGE_SIZE: u64 = 4096;

fun windows_pie_exec(arch_id: u32) bool {
    ret arch_id == isa.ARCH_X86_64;
}

fun windows_native_abi(arch_id: u32) str {
    if (arch_id == isa.ARCH_X86_64) { ret "win64"; }
    ret "";
}

pub fun windows_va_list(arch_id: u32) O.Option[os.VaList] {
    if (arch_id == isa.ARCH_X86_64)  { ret O.some[os.VaList](os.va_list(8, 8)); }
    if (arch_id == isa.ARCH_AARCH64) { ret O.some[os.VaList](os.va_list(8, 8)); }
    ret O.none[os.VaList]();
}

fun windows_fs_policy(arch_id: u32) O.Option[os.FsPolicy] {
    if (arch_id != isa.ARCH_X86_64 && arch_id != isa.ARCH_AARCH64) { ret O.none[os.FsPolicy](); }
    var p: os.FsPolicy;
    p.sysroot = "";
    p.toolchain_root = "";
    p.dynamic_interpreter = "";
    p.platform_lib = "";
    p.libdirs[0] = "C:\\Windows\\System32";
    p.libdir_len = 1;
    ret O.some[os.FsPolicy](p);
}

pub fun register_windows(reg: *os.OsRegistry) R.Result[R.Void, str] {
    var windows_vtable: os.OsVTable;
    windows_vtable.id             = os.OS_WINDOWS;
    windows_vtable.name           = os.os_name_for(os.OS_WINDOWS);
    windows_vtable.default_of     = of.of_name_for(of.OF_COFF);
    windows_vtable.supported_of_count = 0;
    os.support_of(?windows_vtable, of.of_name_for(of.OF_COFF));
    windows_vtable.supported_isa_any   = false;
    windows_vtable.supported_isa_count = 0;
    os.support_isa(?windows_vtable, isa.ARCH_X86_64);
    os.support_isa(?windows_vtable, isa.ARCH_AARCH64);
    windows_vtable.entry_symbol   = "mainCRTStartup";
    windows_vtable.c_symbol_prefix = "";
    windows_vtable.fs_policy      = windows_fs_policy;
    windows_vtable.base_addr      = WINDOWS_BASE_ADDR;
    windows_vtable.page_size      = WINDOWS_PAGE_SIZE;
    windows_vtable.stack_probe    = true;
    windows_vtable.mapped_by_loader = true;
    windows_vtable.pie_exec       = windows_pie_exec;
    windows_vtable.native_abi     = windows_native_abi;
    windows_vtable.variadic_stack = nil;
    windows_vtable.natural_stack_args = nil;
    windows_vtable.va_list_layout = windows_va_list;

    ret os.register(reg, ?windows_vtable);
}
