# a directory listing read by name, for the sites that look for sources,
# manifests or dependency slots in it
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;

# the UTF-8 names of `entries` in its order, borrowed from the listing, which
# keeps them. an entry with no UTF-8 spelling, which only a windows directory
# can hold, is never a name these sites look for, so it refuses the listing
# with a failure naming `dir` rather than being passed over
# ---
# a:       allocator for the vector of names
# dir:     the directory listed, as the failure names it
# entries: the read_dir listing
# ret:     the names, released with collections_vector.dnit, or the refusal
pub fun names(a: *A.Allocator, dir: str, entries: *Vector[fs.Listed]) res[Vector[str], fail.Fail] {
    var out:    Vector[str] = collections_vector.init[str](a);
    var handed: bool        = false;
    fin {
        if (!handed) { collections_vector.dnit[str](?out); }
    }
    var i: usize = 0;
    for (i < entries.len) {
        val entry: fs.Listed = entries.data[i];
        if (sel entry.unspellable) { ret res[Vector[str], fail.Fail].err{unspellable(a, dir)}; }
        or (sel entry.name) {
            val pushed: res[usize, A.Error] = collections_vector.push[str](?out, entry.name);
            if (sel pushed.err) { ret res[Vector[str], fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    handed = true;
    ret res[Vector[str], fail.Fail].ok{out};
}

# the failure for a directory holding an entry with no UTF-8 spelling
pub fun unspellable(a: *A.Allocator, dir: str) fail.Fail {
    val text: res[str, fail.Fail] = fail.format(a, "'{}' holds an entry with no UTF-8 spelling", dir);
    if (sel text.err) { ret text.err; }
    ret fail.environment(diagnostic_kind.FS_READ, text.ok);
}
