# the deprecation notices and their arguments, checked over whole projects
use A: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.driver;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.me.ir.value;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.toolchain;
use mach.lang.type;

use mach.lang.driver.tests.testing.ut_build;
use mach.lang.driver.tests.testing.ut_sema_rejects_with;
use mach.lang.driver.tests.testing.ut_str_contains;

#[testing]
fun t_deprecated_notices(names: *str, texts: *str, count: u32, expected: u32, decoded: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val built: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, names, texts, count);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err)         { ret 4; }
    if (diagnostic.has_errors(?s.diags)) { ret 5; }
    var notices:     u32   = 0;
    var saw_decoded: bool  = str_len(decoded) == 0;
    var i:           usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (!diagnostic_kind.is_error(d.kind) && ut_str_contains(d.message, "is deprecated")) {
            val file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, d.loc.file);
            if (sel file.none)                         { ret 6; }
            if (!str_equals(file.some.text, texts[0])) { ret 6; }
            val span: lang_source.Span = d.loc.span;
            if (span.len == 0 || span.offset + span.len > str_len(texts[0])) { ret 7; }
            var j: usize = 0;
            for (j < span.len) {
                val c: u8 = texts[0][span.offset + j];
                if (c == '.' || c == '[' || c == '(' || c == '{' || c == ' ') { ret 8; }
                j = j + 1;
            }
            j = 0;
            for (j < i) {
                val prior: *diagnostic.Diagnostic = ?s.diags.items.data[j];
                if (!diagnostic_kind.is_error(prior.kind) && ut_str_contains(prior.message, "is deprecated")
                    && lang_source.file_same(prior.loc.file, d.loc.file) && prior.loc.span.offset == span.offset) { ret 9; }
                j = j + 1;
            }
            if (ut_str_contains(d.message, decoded)) { saw_decoded = true; }
            notices = notices + 1;
        }
        i = i + 1;
    }
    if (notices != expected || !saw_decoded) { ret 10; }
    ret 0;
}

test deprecated__external_sites_decode_and_count_generics_once {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nfun local[T](x: T) i32 { ret api.CONST; }\nfun main() i32 { var r: api.OldRec; var u: api.OldUni; val n: api.OldId = 0; ret api.old[i32](1) + api.old[i64](2)::i32 + api.CONST + api.mutable + local[i32](1) + local[i64](2); }\n";
    texts[1] = "#[deprecated(\"use \\\"new\\\"\\nnext\")]\npub fun old[T](x: T) T { ret x; }\n#[deprecated]\npub rec OldRec { n: i32; }\n#[deprecated]\npub uni OldUni { n: i32; }\n#[deprecated]\npub def OldId: i32;\n#[deprecated]\npub val CONST: i32 = 1;\n#[deprecated]\npub var mutable: i32 = 2;\nfun own() i32 { var r: OldRec; var u: OldUni; val n: OldId = 0; ret old[i32](CONST) + mutable; }\n";
    ret t_deprecated_notices(?names[0], ?texts[0], 2, 8, "use \"new\"\nnext");
}

test deprecated__reexports_keep_their_owner_and_spare_clean_aliases {
    var names: [4]str = [4]str{"main.mach", "mid.mach", "leaf.mach", "bridge.mach"};
    var texts: [4]str;
    texts[0] = "use uniontest.mid;\nuse alias: uniontest.mid.retired;\nuse clean: uniontest.mid.clean;\nuse uniontest.bridge;\nfun main() i32 { ret mid.clean() + mid.retired() + alias() + bridge.retired() + mid.clean(); }\n";
    texts[1] = "#[deprecated(\"use clean\")]\nfwd retired: uniontest.leaf.current;\nfwd clean: uniontest.leaf.current;\npub fun own() i32 { ret retired(); }\n";
    texts[2] = "pub fun current() i32 { ret 0; }\n";
    texts[3] = "fwd uniontest.mid.retired;\n";
    val first: i32 = t_deprecated_notices(?names[0], ?texts[0], 4, 3, "use clean");
    if (first != 0) { ret first; }
    texts[0] = "use uniontest.mid;\nuse clean: uniontest.mid.clean;\nuse alias: uniontest.mid.retired;\nuse uniontest.bridge;\nfun main() i32 { ret mid.retired() + mid.clean() + alias() + bridge.retired() + mid.clean(); }\n";
    ret t_deprecated_notices(?names[0], ?texts[0], 4, 3, "use clean");
}

test deprecated__refuses_malformed_arguments {
    if (!ut_sema_rejects_with("#[deprecated(1)]\nfun old() {}\nfun main() i32 { ret 0; }\n", "message must be a string"))                                                                              { ret 1; }
    if (!ut_sema_rejects_with("#[deprecated(\"a\", \"b\")]\nfun old() {}\nfun main() i32 { ret 0; }\n", "takes zero or one string argument"))                                                          { ret 2; }
    if (!ut_sema_rejects_with("#[deprecated]\n#[deprecated(\"again\")]\nfun old() {}\nfun main() i32 { ret 0; }\n", "may appear only once"))                                                           { ret 3; }
    if (!ut_sema_rejects_with("#[deprecated]\ntest unsupported { ret 0; }\nfun main() i32 { ret 0; }\n", "applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations and tag cases")) { ret 4; }
    if (!ut_sema_rejects_with("tag Reply: u8 { #[inline] empty; value: i64; }\nfun main() i32 { ret 0; }\n", "a tag case takes only the `deprecated` decorator"))                                      { ret 5; }
    if (!ut_sema_rejects_with("tag Reply: u8 { #[deprecated(2)] empty; value: i64; }\nfun main() i32 { ret 0; }\n", "message must be a string"))                                                       { ret 6; }
    if (!ut_sema_rejects_with("tag Reply: u8 { #[deprecated] #[deprecated] empty; value: i64; }\nfun main() i32 { ret 0; }\n", "may appear only once"))                                                { ret 7; }
    ret 0;
}

# a deprecated tag, generic tag and ext fun warn once per external site, and a deprecated
# tag case warns at construction, `sel` and payload places, `$cases` included
test deprecated__tags_cases_and_ext_funs_warn_once_per_site {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nfun main() i32 { var r: api.Reply = api.Reply.value{1}; var b: api.Box[i32] = api.Box[i32].some{2}; if (sel r.value) { if (sel b.some) { ret r.value::i32 + b.some + api.exit_code(); } } ret 0; }\n";
    texts[1] = "#[deprecated(\"tag gone\")]\npub tag Reply: u8 { empty; value: i64; }\n#[deprecated]\npub tag Box[T]: u8 { none; some: T; }\n#[deprecated(\"ext gone\")]\npub ext fun exit_code() i32;\nfun own() i32 { var r: Reply = Reply.value{1}; var b: Box[i32] = Box[i32].some{2}; if (sel r.value) { if (sel b.some) { ret r.value::i32 + b.some + exit_code(); } } ret 0; }\n";
    val decls: i32 = t_deprecated_notices(?names[0], ?texts[0], 2, 5, "tag gone");
    if (decls != 0) { ret decls; }
    texts[0] = "use uniontest.api;\nfun main() i32 { var r: api.Reply = api.Reply.value{1}; var b: api.Box[i32] = api.Box[i32].some{2}; var f: api.Reply = api.Reply.fresh{3}; if (sel r.value) { if (sel b.some) { if (sel f.fresh) { ret r.value::i32 + b.some + f.fresh::i32; } } } $each c in $cases(api.Reply) { if (sel r.[c]) { ret 1; } } ret 0; }\n";
    texts[1] = "pub tag Reply: u8 { empty; #[deprecated(\"use fresh\")] value: i64; fresh: i64; }\npub tag Box[T]: u8 { none; #[deprecated] some: T; }\nfun own() i32 { var r: Reply = Reply.value{1}; var b: Box[i32] = Box[i32].some{2}; if (sel r.value) { if (sel b.some) { ret r.value::i32 + b.some; } } ret 0; }\n";
    val cases: i32 = t_deprecated_notices(?names[0], ?texts[0], 2, 6, "use fresh");
    if (cases != 0) { ret 30 + cases; }
    ret 0;
}

# a deprecated leaf identifier written after a line comment inside a dotted type path is
# reported at the identifier itself, never at the comment's dot
test deprecated__dotted_type_locates_the_leaf_after_a_comment {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nfun stale() api.  # a note. with dots\n    Old { ret api.Old.empty{}; }\n";
    texts[1] = "#[deprecated(\"tag gone\")]\npub tag Old: u8 { empty; }\n";
    val counted: i32 = t_deprecated_notices(?names[0], ?texts[0], 2, 2, "tag gone");
    if (counted != 0) { ret counted; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 20; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 21; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val built: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel built.err) { ret 22; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.err) { ret 23; }
    # the return-type leaf is the `Old` that opens line 3 after four spaces
    val line3:       usize = str_len("use uniontest.api;\nfun stale() api.  # a note. with dots\n");
    val leaf_offset: usize = line3 + 4;
    var located:     bool  = false;
    var i:           usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (!diagnostic_kind.is_error(d.kind) && ut_str_contains(d.message, "is deprecated")
            && d.loc.span.offset == leaf_offset && d.loc.span.len == 3) {
            val file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, d.loc.file);
            if (sel file.none) { ret 24; }
            val pos: lang_source.Position = lang_source.position(file.some, d.loc.span.offset);
            if (pos.line != 3 || pos.col != 5) { ret 24; }
            located = true;
        }
        i = i + 1;
    }
    if (!located) { ret 25; }
    ret 0;
}
