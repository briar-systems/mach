use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use map: std.collections.map;
use page: std.allocator.page;
use string: std.text.string;

use mach.lang.alloc;
use mach.lang.fe.token;

pub def StrId: u32;

pub val STR_NIL: StrId = 0xFFFFFFFF;

pub rec Interner {
    a:       *A.Allocator;
    strings: *str;
    len:     usize;
    cap:     usize;
    dedup:   map.Map[str, StrId];
    base:     *Interner;
    base_len: usize;
}

val INITIAL_CAP: usize = 32;

pub fun init(a: *A.Allocator) Interner {
    var itn: Interner;
    itn.a        = a;
    itn.strings  = nil;
    itn.len      = 0;
    itn.cap      = 0;
    itn.dedup    = map.init[str, StrId](a, map.hash_str, map.eq_str);
    itn.base     = nil;
    itn.base_len = 0;
    ret itn;
}

pub fun make_child(base: *Interner, a: *A.Allocator) Interner {
    var itn: Interner;
    itn.a        = a;
    itn.strings  = nil;
    itn.len      = 0;
    itn.cap      = 0;
    itn.dedup    = map.init[str, StrId](a, map.hash_str, map.eq_str);
    itn.base     = base;
    itn.base_len = base.len;
    ret itn;
}

pub fun dnit(itn: *Interner) {
    if (itn == nil) { ret; }

    var i: usize = 0;
    for (i < itn.len) {
        string.str_free(itn.a, itn.strings[i]);
        i = i + 1;
    }

    if (itn.strings != nil && itn.cap > 0) {
        A.deallocate[str](itn.a, itn.strings, itn.cap);
    }

    map.dnit[str, StrId](?itn.dedup);

    itn.strings = nil;
    itn.len     = 0;
    itn.cap     = 0;
}

pub fun lookup_typed(itn: *Interner, id: StrId) opt[str] {
    if (itn.base != nil) {
        if (id::usize < itn.base_len) { ret lookup_typed(itn.base, id); }
        val local: usize = id::usize - itn.base_len;
        if (local >= itn.len) { ret opt[str].none{}; }
        ret opt[str].some{itn.strings[local]};
    }
    if (id::usize >= itn.len) { ret opt[str].none{}; }
    ret opt[str].some{itn.strings[id]};
}

pub fun intern_typed(itn: *Interner, text: str) res[StrId, A.Error] {
    if (itn.base != nil) {
        val res_base: opt[*StrId] = map.get[str, StrId](?itn.base.dedup, ?text);
        if (sel res_base.some) {
            ret res[StrId, A.Error].ok{@res_base.some};
        }
    }

    val res_existing: opt[*StrId] = map.get[str, StrId](?itn.dedup, ?text);
    if (sel res_existing.some) {
        ret res[StrId, A.Error].ok{@res_existing.some};
    }

    val res_dup: res[str, A.Error] = string.str_dup(itn.a, text);
    if (sel res_dup.err) {
        ret res[StrId, A.Error].err{res_dup.err};
    }

    ret store_and_index(itn, res_dup.ok);
}

pub fun intern_span_typed(itn: *Interner, source: str, span: token.Span) res[StrId, A.Error] {
    ret intern_range(itn, source, span.offset, span.len);
}

pub fun intern_bytes_typed(itn: *Interner, data: str, len: usize) res[StrId, A.Error] {
    ret intern_range(itn, data, 0, len);
}

fun intern_range(itn: *Interner, source: str, offset: usize, len: usize) res[StrId, A.Error] {
    val res_dup: res[str, A.Error] = string.str_dup_range(itn.a, source, offset, len);
    if (sel res_dup.err) {
        ret res[StrId, A.Error].err{res_dup.err};
    }
    val owned: str = res_dup.ok;

    if (itn.base != nil) {
        val res_base: opt[*StrId] = map.get[str, StrId](?itn.base.dedup, ?owned);
        if (sel res_base.some) {
            string.str_free(itn.a, owned);
            ret res[StrId, A.Error].ok{@res_base.some};
        }
    }

    val res_existing: opt[*StrId] = map.get[str, StrId](?itn.dedup, ?owned);
    if (sel res_existing.some) {
        string.str_free(itn.a, owned);
        ret res[StrId, A.Error].ok{@res_existing.some};
    }

    ret store_and_index(itn, owned);
}

fun store_and_index(itn: *Interner, owned: str) res[StrId, A.Error] {
    if (itn.strings == nil) {
        val res_alloc: res[*str, A.Error] = A.allocate[str](itn.a, INITIAL_CAP);
        if (sel res_alloc.err) {
            string.str_free(itn.a, owned);
            ret res[StrId, A.Error].err{res_alloc.err};
        }
        itn.strings = res_alloc.ok;
        itn.cap     = INITIAL_CAP;
    }
    or (itn.len == itn.cap) {
        val new_cap: usize = itn.cap * 2;
        val res_realloc: res[*str, A.Error] = A.reallocate[str](itn.a, itn.strings, itn.cap, new_cap);
        if (sel res_realloc.err) {
            string.str_free(itn.a, owned);
            ret res[StrId, A.Error].err{res_realloc.err};
        }
        itn.strings = res_realloc.ok;
        itn.cap     = new_cap;
    }

    val new_id: StrId = (itn.base_len + itn.len)::u32;
    itn.strings[itn.len] = owned;
    itn.len = itn.len + 1;

    val res_insert: res[bool, A.Error] = map.insert[str, StrId](?itn.dedup, owned, new_id);
    if (sel res_insert.err) {
        string.str_free(itn.a, owned);
        itn.strings[itn.len - 1] = nil;
        itn.len = itn.len - 1;
        ret res[StrId, A.Error].err{res_insert.err};
    }

    ret res[StrId, A.Error].ok{new_id};
}

# translation shims (#3226): the legacy carriers the unmigrated neighbours
# still read (me, be, driver, cli, build, session, query, editor, fail). each
# spells the typed outcome above as the 1.x carrier and is deleted by the
# boundary flip, when the `_typed` core takes its name
pub fun intern(itn: *Interner, text: str) R.Result[StrId, str] {
    val r: res[StrId, A.Error] = intern_typed(itn, text);
    if (sel r.err) { ret R.err[StrId, str](alloc.text(r.err)); }
    ret R.ok[StrId, str](r.ok);
}

pub fun intern_span(itn: *Interner, source: str, span: token.Span) R.Result[StrId, str] {
    val r: res[StrId, A.Error] = intern_span_typed(itn, source, span);
    if (sel r.err) { ret R.err[StrId, str](alloc.text(r.err)); }
    ret R.ok[StrId, str](r.ok);
}

pub fun intern_bytes(itn: *Interner, data: str, len: usize) R.Result[StrId, str] {
    val r: res[StrId, A.Error] = intern_bytes_typed(itn, data, len);
    if (sel r.err) { ret R.err[StrId, str](alloc.text(r.err)); }
    ret R.ok[StrId, str](r.ok);
}

pub fun lookup(itn: *Interner, id: StrId) O.Option[str] {
    val found: opt[str] = lookup_typed(itn, id);
    if (sel found.some) { ret O.some[str](found.some); }
    ret O.none[str]();
}

pub fun reintern_child(child: *Interner, alloc_: *A.Allocator) R.Result[ReinternMap, str] {
    val r: res[ReinternMap, A.Error] = reintern_child_typed(child, alloc_);
    if (sel r.err) { ret R.err[ReinternMap, str](alloc.text(r.err)); }
    ret R.ok[ReinternMap, str](r.ok);
}

pub fun child_base_len(itn: *Interner) usize {
    ret itn.base_len;
}

pub fun count(itn: *Interner) usize {
    ret itn.len;
}

pub rec ReinternMap {
    base_len: usize;
    ids:      *StrId;
    len:      usize;
}

pub fun reintern_map_dnit(alloc: *A.Allocator, remap: *ReinternMap) {
    if (remap == nil) { ret; }
    if (remap.ids != nil && remap.len > 0) {
        A.deallocate[StrId](alloc, remap.ids, remap.len);
    }
    remap.base_len = 0;
    remap.ids      = nil;
    remap.len      = 0;
}

# a non-child interner is a contract violation of the receiver, reported as
# the allocator layer reports its own (`invalid`)
pub fun reintern_child_typed(child: *Interner, alloc_: *A.Allocator) res[ReinternMap, A.Error] {
    if (child.base == nil) { ret res[ReinternMap, A.Error].err{A.Error.invalid{}}; }
    var out: ReinternMap;
    out.base_len = child.base_len;
    out.ids      = nil;
    out.len      = child.len;
    if (child.len == 0) { ret res[ReinternMap, A.Error].ok{out}; }

    val res_map: res[*StrId, A.Error] = A.allocate[StrId](alloc_, child.len);
    if (sel res_map.err) {
        ret res[ReinternMap, A.Error].err{res_map.err};
    }
    val remap: *StrId = res_map.ok;

    var i: usize = 0;
    for (i < child.len) {
        val res_id: res[StrId, A.Error] = intern_typed(child.base, child.strings[i]);
        if (sel res_id.err) {
            A.deallocate[StrId](alloc_, remap, child.len);
            ret res[ReinternMap, A.Error].err{res_id.err};
        }
        remap[i] = res_id.ok;
        i = i + 1;
    }
    out.ids = remap;
    ret res[ReinternMap, A.Error].ok{out};
}

fun t_present(o: opt[str]) bool { ret sel o.some; }

test "mach.lang.intern.intern:dedups_and_roundtrips" {
    var alloc: A.Allocator;
    val made: err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var itn: Interner = init(?alloc);

    val res_a1: res[StrId, A.Error] = intern_typed(?itn, "alpha");
    val res_a2: res[StrId, A.Error] = intern_typed(?itn, "alpha");
    val res_b: res[StrId, A.Error] = intern_typed(?itn, "beta");
    if (sel res_a1.err) { dnit(?itn); ret 1; }
    if (sel res_a2.err) { dnit(?itn); ret 1; }
    if (sel res_b.err)  { dnit(?itn); ret 1; }

    val alpha_id: StrId = res_a1.ok;
    val beta_id:  StrId = res_b.ok;
    if (alpha_id != res_a2.ok) { dnit(?itn); ret 1; }
    if (alpha_id == beta_id)                         { dnit(?itn); ret 1; }

    val opt_text: opt[str] = lookup_typed(?itn, alpha_id);
    if (!sel opt_text.some) { dnit(?itn); ret 1; }
    val res_round: res[StrId, A.Error] = intern_typed(?itn, opt_text.some);
    if (sel res_round.err)                { dnit(?itn); ret 1; }
    if (res_round.ok != alpha_id) { dnit(?itn); ret 1; }

    dnit(?itn);
    ret 0;
}

test "mach.lang.intern.intern_span:dedups_against_intern" {
    var alloc: A.Allocator;
    val made: err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var itn: Interner = init(?alloc);

    val res_full: res[StrId, A.Error] = intern_typed(?itn, "hello");
    if (sel res_full.err) { dnit(?itn); ret 1; }
    val hello_id: StrId = res_full.ok;

    var sp: token.Span;
    sp.offset = 1;
    sp.len    = 5;
    val res_span: res[StrId, A.Error] = intern_span_typed(?itn, "xhellox", sp);
    if (sel res_span.err)                { dnit(?itn); ret 1; }
    if (res_span.ok != hello_id) { dnit(?itn); ret 1; }

    val res_bytes: res[StrId, A.Error] = intern_bytes_typed(?itn, "hello!!", 5);
    if (sel res_bytes.err)                { dnit(?itn); ret 1; }
    if (res_bytes.ok != hello_id) { dnit(?itn); ret 1; }

    dnit(?itn);
    ret 0;
}

test "mach.lang.intern.make_child:layers_and_reinterns" {
    var alloc: A.Allocator;
    val made: err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var base: Interner = init(?alloc);

    val res_a: res[StrId, A.Error] = intern_typed(?base, "alpha");
    val res_b: res[StrId, A.Error] = intern_typed(?base, "beta");
    if (sel res_a.err) { dnit(?base); ret 1; }
    if (sel res_b.err) { dnit(?base); ret 1; }
    val alpha_id: StrId = res_a.ok;

    var child: Interner = make_child(?base, ?alloc);
    if (child_base_len(?child) != 2) { dnit(?child); dnit(?base); ret 1; }

    val opt_a: opt[str] = lookup_typed(?child, alpha_id);
    if (!sel opt_a.some) { dnit(?child); dnit(?base); ret 1; }
    val res_a2: res[StrId, A.Error] = intern_typed(?child, "alpha");
    if (sel res_a2.err)                { dnit(?child); dnit(?base); ret 1; }
    if (res_a2.ok != alpha_id) { dnit(?child); dnit(?base); ret 1; }

    val res_g: res[StrId, A.Error] = intern_typed(?child, "gamma");
    if (sel res_g.err) { dnit(?child); dnit(?base); ret 1; }
    val gamma_id: StrId = res_g.ok;
    if (gamma_id::usize != 2) { dnit(?child); dnit(?base); ret 1; }
    if (!t_present(lookup_typed(?child, gamma_id)))  { dnit(?child); dnit(?base); ret 1; }
    if (t_present(lookup_typed(?base, gamma_id)))   { dnit(?child); dnit(?base); ret 1; }
    val res_g2: res[StrId, A.Error] = intern_typed(?child, "gamma");
    if (sel res_g2.err)                { dnit(?child); dnit(?base); ret 1; }
    if (res_g2.ok != gamma_id) { dnit(?child); dnit(?base); ret 1; }

    val res_rm: res[ReinternMap, A.Error] = reintern_child_typed(?child, ?alloc);
    if (sel res_rm.err) { dnit(?child); dnit(?base); ret 1; }
    var remap: ReinternMap = res_rm.ok;
    if (remap.ids == nil || remap.base_len != child_base_len(?child)
        || remap.len != child.len) { dnit(?child); dnit(?base); ret 1; }
    val gamma_base: StrId = remap.ids[gamma_id::usize - remap.base_len];
    if (!t_present(lookup_typed(?base, gamma_base))) { reintern_map_dnit(?alloc, ?remap); dnit(?child); dnit(?base); ret 1; }
    val res_gb2: res[StrId, A.Error] = intern_typed(?base, "gamma");
    if (sel res_gb2.err)                 { reintern_map_dnit(?alloc, ?remap); dnit(?child); dnit(?base); ret 1; }
    if (res_gb2.ok != gamma_base) { reintern_map_dnit(?alloc, ?remap); dnit(?child); dnit(?base); ret 1; }

    reintern_map_dnit(?alloc, ?remap);
    dnit(?child);
    dnit(?base);
    ret 0;
}

test "mach.lang.intern.lookup:out_of_range_is_none" {
    var alloc: A.Allocator;
    val made: err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var itn: Interner = init(?alloc);

    if (t_present(lookup_typed(?itn, 0::StrId))) { dnit(?itn); ret 1; }
    if (t_present(lookup_typed(?itn, STR_NIL)))  { dnit(?itn); ret 1; }

    val res_x: res[StrId, A.Error] = intern_typed(?itn, "x");
    if (sel res_x.err) { dnit(?itn); ret 1; }
    val x_id: StrId = res_x.ok;
    if (!t_present(lookup_typed(?itn, x_id)))     { dnit(?itn); ret 1; }
    if (t_present(lookup_typed(?itn, x_id + 1))) { dnit(?itn); ret 1; }

    dnit(?itn);
    ret 0;
}
