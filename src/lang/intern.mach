use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.page;
use std.collections.map;
use std.text.string;

use mach.lang.alloc;
use mach.lang.fe.token;

pub def StrId: u32;

pub val STR_NIL: StrId = 0xFFFFFFFF;

pub rec Interner {
    a:        *A.Allocator;
    strings:  *str;
    len:      usize;
    cap:      usize;
    dedup:    map.Map[str, StrId];
    base:     *Interner;
    base_len: usize;
}

val INITIAL_CAP: usize = 32;

pub fun init(a: *A.Allocator) Interner {
    var itn: Interner;
    itn.a        = a;
    itn.strings  = nil;
    itn.len      = 0;
    itn.cap      = 0;
    itn.dedup    = map.init[str, StrId](a);
    itn.base     = nil;
    itn.base_len = 0;
    ret itn;
}

pub fun make_child(base: *Interner, a: *A.Allocator) Interner {
    var itn: Interner;
    itn.a        = a;
    itn.strings  = nil;
    itn.len      = 0;
    itn.cap      = 0;
    itn.dedup    = map.init[str, StrId](a);
    itn.base     = base;
    itn.base_len = base.len;
    ret itn;
}

pub fun dnit(itn: *Interner) {
    if (itn == nil) { ret; }

    var i: usize = 0;
    for (i < itn.len) {
        string.str_free(itn.a, itn.strings[i]);
        i = i + 1;
    }

    if (itn.strings != nil && itn.cap > 0) {
        A.deallocate[str](itn.a, itn.strings, itn.cap);
    }

    map.dnit[str, StrId](?itn.dedup);

    itn.strings = nil;
    itn.len     = 0;
    itn.cap     = 0;
}

pub fun lookup(itn: *Interner, id: StrId) opt[str] {
    if (itn.base != nil) {
        if (id::usize < itn.base_len) { ret lookup(itn.base, id); }
        val local: usize = id::usize - itn.base_len;
        if (local >= itn.len) { ret opt[str].none{}; }
        ret opt[str].some{itn.strings[local]};
    }
    if (id::usize >= itn.len) { ret opt[str].none{}; }
    ret opt[str].some{itn.strings[id]};
}

pub fun intern(itn: *Interner, text: str) res[StrId, A.Error] {
    if (itn.base != nil) {
        val res_base: opt[*StrId] = map.get[str, StrId](?itn.base.dedup, ?text);
        if (sel res_base.some) {
            ret res[StrId, A.Error].ok{@res_base.some};
        }
    }

    val res_existing: opt[*StrId] = map.get[str, StrId](?itn.dedup, ?text);
    if (sel res_existing.some) {
        ret res[StrId, A.Error].ok{@res_existing.some};
    }

    val res_dup: res[str, A.Error] = string.str_dup(itn.a, text);
    if (sel res_dup.err) {
        ret res[StrId, A.Error].err{res_dup.err};
    }

    ret store_and_index(itn, res_dup.ok);
}

pub fun intern_span(itn: *Interner, source: str, span: token.Span) res[StrId, A.Error] {
    ret intern_range(itn, source, span.offset, span.len);
}

pub fun intern_bytes(itn: *Interner, data: str, len: usize) res[StrId, A.Error] {
    ret intern_range(itn, data, 0, len);
}

fun intern_range(itn: *Interner, source: str, offset: usize, len: usize) res[StrId, A.Error] {
    val res_dup: res[str, A.Error] = string.str_dup_range(itn.a, source, offset, len);
    if (sel res_dup.err) {
        ret res[StrId, A.Error].err{res_dup.err};
    }
    val owned: str = res_dup.ok;

    if (itn.base != nil) {
        val res_base: opt[*StrId] = map.get[str, StrId](?itn.base.dedup, ?owned);
        if (sel res_base.some) {
            string.str_free(itn.a, owned);
            ret res[StrId, A.Error].ok{@res_base.some};
        }
    }

    val res_existing: opt[*StrId] = map.get[str, StrId](?itn.dedup, ?owned);
    if (sel res_existing.some) {
        string.str_free(itn.a, owned);
        ret res[StrId, A.Error].ok{@res_existing.some};
    }

    ret store_and_index(itn, owned);
}

fun store_and_index(itn: *Interner, owned: str) res[StrId, A.Error] {
    if (itn.strings == nil) {
        val res_alloc: res[*str, A.Error] = A.allocate[str](itn.a, INITIAL_CAP);
        if (sel res_alloc.err) {
            string.str_free(itn.a, owned);
            ret res[StrId, A.Error].err{res_alloc.err};
        }
        itn.strings = res_alloc.ok;
        itn.cap     = INITIAL_CAP;
    }
    or (itn.len == itn.cap) {
        val new_cap:     usize              = itn.cap * 2;
        val res_realloc: res[*str, A.Error] = A.reallocate[str](itn.a, itn.strings, itn.cap, new_cap);
        if (sel res_realloc.err) {
            string.str_free(itn.a, owned);
            ret res[StrId, A.Error].err{res_realloc.err};
        }
        itn.strings = res_realloc.ok;
        itn.cap     = new_cap;
    }

    val new_id: StrId = (itn.base_len + itn.len)::u32;
    itn.strings[itn.len] = owned;
    itn.len              = itn.len + 1;

    val res_insert: res[bool, A.Error] = map.insert[str, StrId](?itn.dedup, owned, new_id);
    if (sel res_insert.err) {
        string.str_free(itn.a, owned);
        itn.strings[itn.len - 1] = nil;
        itn.len                  = itn.len - 1;
        ret res[StrId, A.Error].err{res_insert.err};
    }

    ret res[StrId, A.Error].ok{new_id};
}

#[testing]
pub fun child_base_len(itn: *Interner) usize {
    ret itn.base_len;
}

#[testing]
pub fun count(itn: *Interner) usize {
    ret itn.len;
}

pub rec ReinternMap {
    base_len: usize;
    ids:      *StrId;
    len:      usize;
}

pub fun reintern_map_dnit(alloc: *A.Allocator, remap: *ReinternMap) {
    if (remap == nil) { ret; }
    if (remap.ids != nil && remap.len > 0) {
        A.deallocate[StrId](alloc, remap.ids, remap.len);
    }
    remap.base_len = 0;
    remap.ids      = nil;
    remap.len      = 0;
}

# a non-child interner is a contract violation of the receiver, reported as
# the allocator layer reports its own (`invalid`)
pub fun reintern_child(child: *Interner, alloc_: *A.Allocator) res[ReinternMap, A.Error] {
    if (child.base == nil) { ret res[ReinternMap, A.Error].err{A.Error.invalid{}}; }
    var out: ReinternMap;
    out.base_len = child.base_len;
    out.ids      = nil;
    out.len      = child.len;
    if (child.len == 0) { ret res[ReinternMap, A.Error].ok{out}; }

    val res_map: res[*StrId, A.Error] = A.allocate[StrId](alloc_, child.len);
    if (sel res_map.err) {
        ret res[ReinternMap, A.Error].err{res_map.err};
    }
    val remap: *StrId = res_map.ok;

    var i: usize = 0;
    for (i < child.len) {
        val res_id: res[StrId, A.Error] = intern(child.base, child.strings[i]);
        if (sel res_id.err) {
            A.deallocate[StrId](alloc_, remap, child.len);
            ret res[ReinternMap, A.Error].err{res_id.err};
        }
        remap[i] = res_id.ok;
        i        = i + 1;
    }
    out.ids = remap;
    ret res[ReinternMap, A.Error].ok{out};
}

#[testing]
fun t_present(o: opt[str]) bool {
    ret sel o.some;
}

# a string interns to one id whichever entry point names it, and lookup answers
# only the ids it handed out
test intern__dedups_across_entry_points_and_lookup_is_bounded {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var itn: Interner = init(?alloc);
    fin { dnit(?itn); }
    if (t_present(lookup(?itn, 0::StrId)) || t_present(lookup(?itn, STR_NIL))) { ret 2; }
    val hello: res[StrId, A.Error] = intern(?itn, "hello");
    val again: res[StrId, A.Error] = intern(?itn, "hello");
    val other: res[StrId, A.Error] = intern(?itn, "beta");
    if (sel hello.err)                                { ret 3; }
    if (sel again.err)                                { ret 3; }
    if (sel other.err)                                { ret 3; }
    if (hello.ok != again.ok || hello.ok == other.ok) { ret 4; }
    var sp: token.Span;
    sp.offset = 1;
    sp.len    = 5;
    val spanned: res[StrId, A.Error] = intern_span(?itn, "xhellox", sp);
    val bytes:   res[StrId, A.Error] = intern_bytes(?itn, "hello!!", 5);
    if (sel spanned.err)                                { ret 5; }
    if (sel bytes.err)                                  { ret 5; }
    if (spanned.ok != hello.ok || bytes.ok != hello.ok) { ret 6; }
    val text: opt[str] = lookup(?itn, hello.ok);
    if (sel text.none)                         { ret 7; }
    if (!str_equals(text.some, "hello"))       { ret 7; }
    if (t_present(lookup(?itn, other.ok + 1))) { ret 8; }
    ret 0;
}

# a child reads its base, interns new strings past it, and reinterning moves them
# into the base under the ids the base then answers
test make_child__layers_and_reinterns {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var base: Interner = init(?alloc);
    fin { dnit(?base); }
    val alpha: res[StrId, A.Error] = intern(?base, "alpha");
    val beta:  res[StrId, A.Error] = intern(?base, "beta");
    if (sel alpha.err) { ret 1; }
    if (sel beta.err)  { ret 1; }
    var child: Interner = make_child(?base, ?alloc);
    fin { dnit(?child); }
    if (child_base_len(?child) != 2)          { ret 2; }
    if (!t_present(lookup(?child, alpha.ok))) { ret 3; }
    val alpha_again: res[StrId, A.Error] = intern(?child, "alpha");
    if (sel alpha_again.err)        { ret 4; }
    if (alpha_again.ok != alpha.ok) { ret 4; }
    val gamma:  res[StrId, A.Error] = intern(?child, "gamma");
    val gamma2: res[StrId, A.Error] = intern(?child, "gamma");
    if (sel gamma.err)                                                              { ret 5; }
    if (sel gamma2.err)                                                             { ret 5; }
    if (gamma.ok::usize != 2 || gamma2.ok != gamma.ok)                              { ret 6; }
    if (!t_present(lookup(?child, gamma.ok)) || t_present(lookup(?base, gamma.ok))) { ret 7; }
    val remapped: res[ReinternMap, A.Error] = reintern_child(?child, ?alloc);
    if (sel remapped.err) { ret 8; }
    var remap: ReinternMap = remapped.ok;
    fin { reintern_map_dnit(?alloc, ?remap); }
    if (remap.ids == nil || remap.base_len != child_base_len(?child) || remap.len != child.len) { ret 9; }
    val gamma_base: StrId = remap.ids[gamma.ok::usize - remap.base_len];
    if (!t_present(lookup(?base, gamma_base))) { ret 10; }
    val in_base: res[StrId, A.Error] = intern(?base, "gamma");
    if (sel in_base.err)          { ret 11; }
    if (in_base.ok != gamma_base) { ret 11; }
    ret 0;
}
