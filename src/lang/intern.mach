use std.allocator.page;
use std.collections.map;
use std.text.string;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.token;

pub def StrId: u32;

pub val STR_NIL: StrId = 0xFFFFFFFF;

pub rec Interner {
    a:       *A.Allocator;
    strings: *str;
    len:     usize;
    cap:     usize;
    dedup:   map.Map[str, StrId];
    base:     *Interner;
    base_len: usize;
}

val INITIAL_CAP: usize = 32;

pub fun init(a: *A.Allocator) Interner {
    var itn: Interner;
    itn.a        = a;
    itn.strings  = nil;
    itn.len      = 0;
    itn.cap      = 0;
    itn.dedup    = map.init[str, StrId](a, map.hash_str, map.eq_str);
    itn.base     = nil;
    itn.base_len = 0;
    ret itn;
}

pub fun make_child(base: *Interner, a: *A.Allocator) Interner {
    var itn: Interner;
    itn.a        = a;
    itn.strings  = nil;
    itn.len      = 0;
    itn.cap      = 0;
    itn.dedup    = map.init[str, StrId](a, map.hash_str, map.eq_str);
    itn.base     = base;
    itn.base_len = base.len;
    ret itn;
}

pub fun dnit(itn: *Interner) {
    if (itn == nil) { ret; }

    var i: usize = 0;
    for (i < itn.len) {
        string.str_free(itn.a, itn.strings[i]);
        i = i + 1;
    }

    if (itn.strings != nil && itn.cap > 0) {
        A.deallocate[str](itn.a, itn.strings, itn.cap);
    }

    map.dnit[str, StrId](?itn.dedup);

    itn.strings = nil;
    itn.len     = 0;
    itn.cap     = 0;
}

pub fun lookup(itn: *Interner, id: StrId) O.Option[str] {
    if (itn.base != nil) {
        if (id::usize < itn.base_len) { ret lookup(itn.base, id); }
        val local: usize = id::usize - itn.base_len;
        if (local >= itn.len) { ret O.none[str](); }
        ret O.some[str](itn.strings[local]);
    }
    if (id::usize >= itn.len) { ret O.none[str](); }
    ret O.some[str](itn.strings[id]);
}

pub fun intern(itn: *Interner, text: str) R.Result[StrId, str] {
    if (itn.base != nil) {
        val res_base: R.Result[*StrId, str] = map.get[str, StrId](?itn.base.dedup, ?text);
        if (R.is_ok[*StrId, str](res_base)) {
            ret R.ok[StrId, str](@R.unwrap_ok[*StrId, str](res_base));
        }
    }

    val res_existing: R.Result[*StrId, str] = map.get[str, StrId](?itn.dedup, ?text);
    if (R.is_ok[*StrId, str](res_existing)) {
        ret R.ok[StrId, str](@R.unwrap_ok[*StrId, str](res_existing));
    }

    val res_dup: R.Result[str, str] = string.str_dup(itn.a, text);
    if (R.is_err[str, str](res_dup)) {
        ret R.err[StrId, str](R.unwrap_err[str, str](res_dup));
    }

    ret store_and_index(itn, R.unwrap_ok[str, str](res_dup));
}

pub fun intern_span(itn: *Interner, source: str, span: token.Span) R.Result[StrId, str] {
    ret intern_range(itn, source, span.offset, span.len);
}

pub fun intern_bytes(itn: *Interner, data: str, len: usize) R.Result[StrId, str] {
    ret intern_range(itn, data, 0, len);
}

fun intern_range(itn: *Interner, source: str, offset: usize, len: usize) R.Result[StrId, str] {
    val res_dup: R.Result[str, str] = string.str_dup_range(itn.a, source, offset, len);
    if (R.is_err[str, str](res_dup)) {
        ret R.err[StrId, str](R.unwrap_err[str, str](res_dup));
    }
    val owned: str = R.unwrap_ok[str, str](res_dup);

    if (itn.base != nil) {
        val res_base: R.Result[*StrId, str] = map.get[str, StrId](?itn.base.dedup, ?owned);
        if (R.is_ok[*StrId, str](res_base)) {
            string.str_free(itn.a, owned);
            ret R.ok[StrId, str](@R.unwrap_ok[*StrId, str](res_base));
        }
    }

    val res_existing: R.Result[*StrId, str] = map.get[str, StrId](?itn.dedup, ?owned);
    if (R.is_ok[*StrId, str](res_existing)) {
        string.str_free(itn.a, owned);
        ret R.ok[StrId, str](@R.unwrap_ok[*StrId, str](res_existing));
    }

    ret store_and_index(itn, owned);
}

fun store_and_index(itn: *Interner, owned: str) R.Result[StrId, str] {
    if (itn.strings == nil) {
        val res_alloc: R.Result[*str, str] = A.allocate[str](itn.a, INITIAL_CAP);
        if (R.is_err[*str, str](res_alloc)) {
            string.str_free(itn.a, owned);
            ret R.err[StrId, str](R.unwrap_err[*str, str](res_alloc));
        }
        itn.strings = R.unwrap_ok[*str, str](res_alloc);
        itn.cap     = INITIAL_CAP;
    }
    or (itn.len == itn.cap) {
        val new_cap: usize = itn.cap * 2;
        val res_realloc: R.Result[*str, str] = A.reallocate[str](itn.a, itn.strings, itn.cap, new_cap);
        if (R.is_err[*str, str](res_realloc)) {
            string.str_free(itn.a, owned);
            ret R.err[StrId, str](R.unwrap_err[*str, str](res_realloc));
        }
        itn.strings = R.unwrap_ok[*str, str](res_realloc);
        itn.cap     = new_cap;
    }

    val new_id: StrId = (itn.base_len + itn.len)::u32;
    itn.strings[itn.len] = owned;
    itn.len = itn.len + 1;

    val res_insert: R.Result[bool, str] = map.insert[str, StrId](?itn.dedup, owned, new_id);
    if (R.is_err[bool, str](res_insert)) {
        string.str_free(itn.a, owned);
        itn.strings[itn.len - 1] = nil;
        itn.len = itn.len - 1;
        ret R.err[StrId, str](R.unwrap_err[bool, str](res_insert));
    }

    ret R.ok[StrId, str](new_id);
}

pub fun child_base_len(itn: *Interner) usize {
    ret itn.base_len;
}

pub fun count(itn: *Interner) usize {
    ret itn.len;
}

pub rec ReinternMap {
    base_len: usize;
    ids:      *StrId;
    len:      usize;
}

pub fun reintern_map_dnit(alloc: *A.Allocator, remap: *ReinternMap) {
    if (remap == nil) { ret; }
    if (remap.ids != nil && remap.len > 0) {
        A.deallocate[StrId](alloc, remap.ids, remap.len);
    }
    remap.base_len = 0;
    remap.ids      = nil;
    remap.len      = 0;
}

pub fun reintern_child(child: *Interner, alloc: *A.Allocator) R.Result[ReinternMap, str] {
    if (child.base == nil) { ret R.err[ReinternMap, str]("reintern_child: not a child interner"); }
    var out: ReinternMap;
    out.base_len = child.base_len;
    out.ids      = nil;
    out.len      = child.len;
    if (child.len == 0) { ret R.ok[ReinternMap, str](out); }

    val res_map: R.Result[*StrId, str] = A.allocate[StrId](alloc, child.len);
    if (R.is_err[*StrId, str](res_map)) {
        ret R.err[ReinternMap, str](R.unwrap_err[*StrId, str](res_map));
    }
    val remap: *StrId = R.unwrap_ok[*StrId, str](res_map);

    var i: usize = 0;
    for (i < child.len) {
        val res_id: R.Result[StrId, str] = intern(child.base, child.strings[i]);
        if (R.is_err[StrId, str](res_id)) {
            A.deallocate[StrId](alloc, remap, child.len);
            ret R.err[ReinternMap, str](R.unwrap_err[StrId, str](res_id));
        }
        remap[i] = R.unwrap_ok[StrId, str](res_id);
        i = i + 1;
    }
    out.ids = remap;
    ret R.ok[ReinternMap, str](out);
}

test "mach.lang.intern.intern:dedups_and_roundtrips" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: Interner = init(?alloc);

    val res_a1: R.Result[StrId, str] = intern(?itn, "alpha");
    val res_a2: R.Result[StrId, str] = intern(?itn, "alpha");
    val res_b:  R.Result[StrId, str] = intern(?itn, "beta");
    if (R.is_err[StrId, str](res_a1)) { dnit(?itn); ret 1; }
    if (R.is_err[StrId, str](res_a2)) { dnit(?itn); ret 1; }
    if (R.is_err[StrId, str](res_b))  { dnit(?itn); ret 1; }

    val alpha_id: StrId = R.unwrap_ok[StrId, str](res_a1);
    val beta_id:  StrId = R.unwrap_ok[StrId, str](res_b);
    if (alpha_id != R.unwrap_ok[StrId, str](res_a2)) { dnit(?itn); ret 1; }
    if (alpha_id == beta_id)                         { dnit(?itn); ret 1; }

    val opt_text: O.Option[str] = lookup(?itn, alpha_id);
    if (O.is_none[str](opt_text)) { dnit(?itn); ret 1; }
    val res_round: R.Result[StrId, str] = intern(?itn, O.unwrap[str](opt_text));
    if (R.is_err[StrId, str](res_round))                { dnit(?itn); ret 1; }
    if (R.unwrap_ok[StrId, str](res_round) != alpha_id) { dnit(?itn); ret 1; }

    dnit(?itn);
    ret 0;
}

test "mach.lang.intern.intern_span:dedups_against_intern" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: Interner = init(?alloc);

    val res_full: R.Result[StrId, str] = intern(?itn, "hello");
    if (R.is_err[StrId, str](res_full)) { dnit(?itn); ret 1; }
    val hello_id: StrId = R.unwrap_ok[StrId, str](res_full);

    var sp: token.Span;
    sp.offset = 1;
    sp.len    = 5;
    val res_span: R.Result[StrId, str] = intern_span(?itn, "xhellox", sp);
    if (R.is_err[StrId, str](res_span))                { dnit(?itn); ret 1; }
    if (R.unwrap_ok[StrId, str](res_span) != hello_id) { dnit(?itn); ret 1; }

    val res_bytes: R.Result[StrId, str] = intern_bytes(?itn, "hello!!", 5);
    if (R.is_err[StrId, str](res_bytes))                { dnit(?itn); ret 1; }
    if (R.unwrap_ok[StrId, str](res_bytes) != hello_id) { dnit(?itn); ret 1; }

    dnit(?itn);
    ret 0;
}

test "mach.lang.intern.make_child:layers_and_reinterns" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var base: Interner = init(?alloc);

    val res_a: R.Result[StrId, str] = intern(?base, "alpha");
    val res_b: R.Result[StrId, str] = intern(?base, "beta");
    if (R.is_err[StrId, str](res_a)) { dnit(?base); ret 1; }
    if (R.is_err[StrId, str](res_b)) { dnit(?base); ret 1; }
    val alpha_id: StrId = R.unwrap_ok[StrId, str](res_a);

    var child: Interner = make_child(?base, ?alloc);
    if (child_base_len(?child) != 2) { dnit(?child); dnit(?base); ret 1; }

    val opt_a: O.Option[str] = lookup(?child, alpha_id);
    if (O.is_none[str](opt_a)) { dnit(?child); dnit(?base); ret 1; }
    val res_a2: R.Result[StrId, str] = intern(?child, "alpha");
    if (R.is_err[StrId, str](res_a2))                { dnit(?child); dnit(?base); ret 1; }
    if (R.unwrap_ok[StrId, str](res_a2) != alpha_id) { dnit(?child); dnit(?base); ret 1; }

    val res_g: R.Result[StrId, str] = intern(?child, "gamma");
    if (R.is_err[StrId, str](res_g)) { dnit(?child); dnit(?base); ret 1; }
    val gamma_id: StrId = R.unwrap_ok[StrId, str](res_g);
    if (gamma_id::usize != 2) { dnit(?child); dnit(?base); ret 1; }
    if (O.is_none[str](lookup(?child, gamma_id)))  { dnit(?child); dnit(?base); ret 1; }
    if (O.is_some[str](lookup(?base, gamma_id)))   { dnit(?child); dnit(?base); ret 1; }
    val res_g2: R.Result[StrId, str] = intern(?child, "gamma");
    if (R.is_err[StrId, str](res_g2))                { dnit(?child); dnit(?base); ret 1; }
    if (R.unwrap_ok[StrId, str](res_g2) != gamma_id) { dnit(?child); dnit(?base); ret 1; }

    val res_rm: R.Result[ReinternMap, str] = reintern_child(?child, ?alloc);
    if (R.is_err[ReinternMap, str](res_rm)) { dnit(?child); dnit(?base); ret 1; }
    var remap: ReinternMap = R.unwrap_ok[ReinternMap, str](res_rm);
    if (remap.ids == nil || remap.base_len != child_base_len(?child)
        || remap.len != child.len) { dnit(?child); dnit(?base); ret 1; }
    val gamma_base: StrId = remap.ids[gamma_id::usize - remap.base_len];
    if (O.is_none[str](lookup(?base, gamma_base))) { reintern_map_dnit(?alloc, ?remap); dnit(?child); dnit(?base); ret 1; }
    val res_gb2: R.Result[StrId, str] = intern(?base, "gamma");
    if (R.is_err[StrId, str](res_gb2))                 { reintern_map_dnit(?alloc, ?remap); dnit(?child); dnit(?base); ret 1; }
    if (R.unwrap_ok[StrId, str](res_gb2) != gamma_base) { reintern_map_dnit(?alloc, ?remap); dnit(?child); dnit(?base); ret 1; }

    reintern_map_dnit(?alloc, ?remap);
    dnit(?child);
    dnit(?base);
    ret 0;
}

test "mach.lang.intern.lookup:out_of_range_is_none" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: Interner = init(?alloc);

    if (O.is_some[str](lookup(?itn, 0::StrId))) { dnit(?itn); ret 1; }
    if (O.is_some[str](lookup(?itn, STR_NIL)))  { dnit(?itn); ret 1; }

    val res_x: R.Result[StrId, str] = intern(?itn, "x");
    if (R.is_err[StrId, str](res_x)) { dnit(?itn); ret 1; }
    val x_id: StrId = R.unwrap_ok[StrId, str](res_x);
    if (O.is_none[str](lookup(?itn, x_id)))     { dnit(?itn); ret 1; }
    if (O.is_some[str](lookup(?itn, x_id + 1))) { dnit(?itn); ret 1; }

    dnit(?itn);
    ret 0;
}
