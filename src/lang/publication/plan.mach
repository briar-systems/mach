use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.build.outcome;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use page: std.allocator.page;
use std.text.string.str_free;
use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use fs: std.filesystem;
use path: std.types.path;
use txn: std.filesystem.transaction;

rec Directory {
    root: txn.Root;
    held: txn.Lock;
    identity: txn.Identity;
    opened: bool;
    locked: bool;
    next: *Directory;
}

pub rec Destination {
    claim: txn.Claim;
    path: str;
    directory: *Directory;
    reserved: bool;
    next: *Destination;
}

val PLANNING: u8 = 1;
val ADMITTING: u8 = 2;
val READY: u8 = 3;
val CLOSING: u8 = 4;

pub rec Plan {
    address: usize;
    alloc: *A.Allocator;
    directories: *Directory;
    destinations: *Destination;
    state: u8;
}

# translation shim (#3226): the legacy carrier for call sites in lanes that
# read it as such; removed with the last one
pub fun init(out: *Plan, alloc: *A.Allocator) O.Option[txn.Error] {
    val r: err[txn.Error] = init_typed(out, alloc);
    if (sel r.err) { ret O.some[txn.Error](r.err); }
    ret O.none[txn.Error]();
}

pub fun init_typed(out: *Plan, alloc: *A.Allocator) err[txn.Error] {
    if (out == nil || alloc == nil || out.address != 0) {
        ret err[txn.Error].err{txn.error(txn.INVALID, txn.OP_PREPARE)};
    }
    out.alloc = alloc;
    out.directories = nil;
    out.destinations = nil;
    out.state = PLANNING;
    out.address = out::usize;
    ret err[txn.Error].ok{};
}

fun valid(plan: *Plan) bool {
    ret plan != nil && plan.address == plan::usize;
}

# roots are compared by held identity before acquiring their exclusive locks
fun directory(plan: *Plan, parent: str, create: bool) res[*Directory, outcome.Fail] {
    if (create) {
        val made: err[fs.FsError] = fs.create_dir_all(plan.alloc, parent, 0o755);
        if (sel made.err) { ret res[*Directory, outcome.Fail].err{outcome.environment(outcome.fs_text(made.err))}; }
    }
    val allocated: res[*Directory, A.Error] = A.zallocate[Directory](plan.alloc, 1);
    if (sel allocated.err) { ret res[*Directory, outcome.Fail].err{outcome.refused(allocated.err)}; }
    val item: *Directory = allocated.ok;
    val opened: err[txn.Error] = txn.root_open(?item.root, parent, "");
    if (sel opened.err) {
        A.deallocate[Directory](plan.alloc, item, 1);
        ret res[*Directory, outcome.Fail].err{outcome.environment(txn.error_message(opened.err))};
    }
    item.opened = true;
    val observed: res[txn.Identity, txn.Error] = txn.root_identity(?item.root);
    if (sel observed.err) {
        val closed: err[txn.Error] = txn.root_dnit(?item.root);
        A.deallocate[Directory](plan.alloc, item, 1);
        if (sel closed.err) { ret res[*Directory, outcome.Fail].err{outcome.environment(txn.error_message(closed.err))}; }
        ret res[*Directory, outcome.Fail].err{outcome.environment(txn.error_message(observed.err))};
    }
    item.identity = observed.ok;
    var existing: *Directory = plan.directories;
    for (existing != nil) {
        if (txn.identity_equal(existing.identity, item.identity)) {
            val closed: err[txn.Error] = txn.root_dnit(?item.root);
            A.deallocate[Directory](plan.alloc, item, 1);
            if (sel closed.err) { ret res[*Directory, outcome.Fail].err{outcome.environment(txn.error_message(closed.err))}; }
            ret res[*Directory, outcome.Fail].ok{existing};
        }
        existing = existing.next;
    }
    item.next = plan.directories;
    plan.directories = item;
    ret res[*Directory, outcome.Fail].ok{item};
}

# destinations remain at their final addresses throughout planning and execution
# translation shim (#3226): the legacy carrier for call sites in lanes that
# read it as such; removed with the last one
pub fun add(plan: *Plan, name: str, create_parents: bool) R.Result[*Destination, str] {
    ret outcome.lower[*Destination](add_typed(plan, name, create_parents));
}

pub fun add_typed(plan: *Plan, name: str, create_parents: bool) res[*Destination, outcome.Fail] {
    if (!valid(plan) || plan.state != PLANNING) {
        ret res[*Destination, outcome.Fail].err{outcome.environment("publication destinations require an open plan")};
    }
    val cleaned: res[str, A.Error] = path.clean(plan.alloc, name);
    if (sel cleaned.err) { ret res[*Destination, outcome.Fail].err{outcome.refused(cleaned.err)}; }
    val spelling: str = cleaned.ok;
    var retained: bool = false;
    fin { if (!retained) { str_free(plan.alloc, spelling); } }
    val parent_r: res[str, A.Error] = path.parent(plan.alloc, spelling);
    if (sel parent_r.err) { ret res[*Destination, outcome.Fail].err{outcome.refused(parent_r.err)}; }
    val parent: str = parent_r.ok;
    fin { str_free(plan.alloc, parent); }
    val owner_r: res[*Directory, outcome.Fail] = directory(plan, parent, create_parents);
    if (sel owner_r.err) { ret res[*Destination, outcome.Fail].err{owner_r.err}; }
    val owner: *Directory = owner_r.ok;
    var existing: *Destination = plan.destinations;
    for (existing != nil) {
        if (existing.directory == owner && str_equals(path.filename(existing.path), path.filename(spelling))) {
            ret res[*Destination, outcome.Fail].ok{existing};
        }
        existing = existing.next;
    }
    val allocated: res[*Destination, A.Error] = A.zallocate[Destination](plan.alloc, 1);
    if (sel allocated.err) { ret res[*Destination, outcome.Fail].err{outcome.refused(allocated.err)}; }
    val item: *Destination = allocated.ok;
    item.path = spelling;
    item.directory = owner;
    item.next = plan.destinations;
    plan.destinations = item;
    retained = true;
    ret res[*Destination, outcome.Fail].ok{item};
}

# recovery completes everywhere before the first reservation or worker admission
# translation shim (#3226): the legacy carrier for call sites in lanes that
# read it as such; removed with the last one
pub fun seal(plan: *Plan) O.Option[txn.Error] {
    val r: err[txn.Error] = seal_typed(plan);
    if (sel r.err) { ret O.some[txn.Error](r.err); }
    ret O.none[txn.Error]();
}

pub fun seal_typed(plan: *Plan) err[txn.Error] {
    if (!valid(plan) || plan.state != PLANNING) {
        ret err[txn.Error].err{txn.error(txn.INVALID, txn.OP_PREPARE)};
    }
    plan.state = ADMITTING;
    var owner: *Directory = plan.directories;
    for (owner != nil) {
        val locked: err[txn.Error] = txn.lock(?owner.held, ?owner.root);
        if (sel locked.err) { ret locked; }
        owner.locked = true;
        owner = owner.next;
    }
    var item: *Destination = plan.destinations;
    for (item != nil) {
        val recovered: res[usize, txn.Error] = txn.recover(plan.alloc, ?item.directory.held, path.filename(item.path));
        if (sel recovered.err) { ret err[txn.Error].err{recovered.err}; }
        item = item.next;
    }
    item = plan.destinations;
    for (item != nil) {
        val reserved: err[txn.Error] = txn.claim(?item.claim, plan.alloc, ?item.directory.held, path.filename(item.path));
        if (sel reserved.err) { ret reserved; }
        item.reserved = true;
        item = item.next;
    }
    plan.state = READY;
    ret err[txn.Error].ok{};
}

# live transaction misuse retains the remaining owners for an explicit retry
# translation shim (#3226): the legacy carrier for call sites in lanes that
# read it as such; removed with the last one
pub fun dnit(plan: *Plan) O.Option[txn.Error] {
    val r: err[txn.Error] = dnit_typed(plan);
    if (sel r.err) { ret O.some[txn.Error](r.err); }
    ret O.none[txn.Error]();
}

pub fun dnit_typed(plan: *Plan) err[txn.Error] {
    if (plan == nil) { ret err[txn.Error].err{txn.error(txn.INVALID, txn.OP_LOCK)}; }
    if (plan.address == 0) { ret err[txn.Error].ok{}; }
    if (!valid(plan)) { ret err[txn.Error].err{txn.error(txn.INVALID, txn.OP_LOCK)}; }
    plan.state = CLOSING;
    var failure: err[txn.Error] = err[txn.Error].ok{};
    for (plan.destinations != nil) {
        val item: *Destination = plan.destinations;
        if (item.reserved) {
            val released: err[txn.Error] = txn.release_claim(?item.claim);
            if (sel released.err) {
                if (released.err.kind == txn.INVALID) { ret released; }
                val first_released: bool = sel failure.ok; if (first_released) { failure = released; }
            }
        }
        plan.destinations = item.next;
        str_free(plan.alloc, item.path);
        A.deallocate[Destination](plan.alloc, item, 1);
    }
    for (plan.directories != nil) {
        val owner: *Directory = plan.directories;
        if (owner.locked) {
            val released: err[txn.Error] = txn.unlock(?owner.held);
            if (sel released.err) {
                if (released.err.kind == txn.INVALID) { ret released; }
                val first_released: bool = sel failure.ok; if (first_released) { failure = released; }
            }
            owner.locked = false;
        }
        if (owner.opened) {
            val released: err[txn.Error] = txn.root_dnit(?owner.root);
            if (sel released.err) {
                if (released.err.kind == txn.INVALID) { ret released; }
                val first_released: bool = sel failure.ok; if (first_released) { failure = released; }
            }
        }
        plan.directories = owner.next;
        A.deallocate[Directory](plan.alloc, owner, 1);
    }
    plan.address = 0;
    plan.state = 0;
    ret failure;
}

fun t_plan_lifetime(conflict: bool) i32 {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val temporary: res[fs.TempFile, fs.FsError] = fs.temp_create(?alloc, "mach-publication-plan");
    if (sel temporary.err) { ret 1; }
    var temp: fs.TempFile = temporary.ok;
    val root: str = fs.temp_path(?temp);
    val temp_close_and_remove_r: err[io_error.Error] = fs.temp_close_and_remove(?temp);
    if (sel temp_close_and_remove_r.err) { str_free(?alloc, root); ret 1; }
    fin { fs.remove_all(?alloc, root); str_free(?alloc, root); }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?alloc, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }
    val first_r: res[str, A.Error] = path.join(?alloc, root, "first");
    if (sel first_r.err) { ret 1; }
    val first: str = first_r.ok;
    fin { str_free(?alloc, first); }
    var second_leaf: str = "second";
    if (conflict) { second_leaf = ".machtxn.reserved"; }
    val second_r: res[str, A.Error] = path.join(?alloc, root, second_leaf);
    if (sel second_r.err) { ret 1; }
    val second: str = second_r.ok;
    fin { str_free(?alloc, second); }
    var plan: Plan;
    val init_r: err[txn.Error] = init_typed(?plan, ?alloc);
    if (sel init_r.err) { ret 2; }
    fin { dnit_typed(?plan); }
    val a: res[*Destination, outcome.Fail] = add_typed(?plan, first, false);
    val b: res[*Destination, outcome.Fail] = add_typed(?plan, second, false);
    if (sel a.err) { ret 2; }
    if (sel b.err) { ret 2; }
    val one: *Destination = a.ok;
    val two: *Destination = b.ok;
    if (one == two || one.directory != two.directory) { ret 3; }
    var copied: Plan = plan;
    val dnit_r: err[txn.Error] = dnit_typed(?copied);
    if (sel dnit_r.ok) { ret 4; }
    val admitted: err[txn.Error] = seal_typed(?plan);
    if (conflict) {
        if (sel admitted.ok) { ret 5; }
        val exists_r: res[bool, io_error.Error] = fs.exists(first);
        val exists_r2: res[bool, io_error.Error] = fs.exists(second);
        if ((sel exists_r.ok && exists_r.ok)) { ret 6; }
        if ((sel exists_r2.ok && exists_r2.ok)) { ret 6; }
        val dnit_r2: err[txn.Error] = dnit_typed(?plan);
        if (sel dnit_r2.err) { ret 7; }
        ret 0;
    }
    if (sel admitted.err) { ret 5; }
    if (!one.reserved || !two.reserved) { ret 6; }
    val add_r: res[*Destination, outcome.Fail] = add_typed(?plan, first, false);
    if (sel add_r.ok) { ret 7; }
    var competing_root: txn.Root;
    val root_open_r: err[txn.Error] = txn.root_open(?competing_root, root, "");
    if (sel root_open_r.err) { ret 8; }
    fin { txn.root_dnit(?competing_root); }
    var competing_lock: txn.Lock;
    val lock_r: err[txn.Error] = txn.lock(?competing_lock, ?competing_root);
    if (sel lock_r.ok) {
        txn.unlock(?competing_lock);
        ret 9;
    }
    var transaction: txn.Transaction;
    val prepared: err[txn.Error] = txn.prepare_bytes(?transaction, ?alloc, ?one.claim,
        "content", 7, 0o600, false,
        txn.PrepareOptions{precondition: txn.PRE_ABSENT, durability: txn.durability_none()});
    if (sel prepared.err) { ret 10; }
    val premature: err[txn.Error] = dnit_typed(?plan);
    val aborted: err[txn.Error] = txn.abort(?transaction);
    if (sel premature.ok) { ret 11; }
    if (premature.err.kind != txn.INVALID) { ret 11; }
    if (sel aborted.err) { ret 12; }
    val dnit_r3: err[txn.Error] = dnit_typed(?plan);
    if (sel dnit_r3.err) { ret 13; }
    val lock_r2: err[txn.Error] = txn.lock(?competing_lock, ?competing_root);
    if (sel lock_r2.err) { ret 14; }
    val unlock_r: err[txn.Error] = txn.unlock(?competing_lock);
    if (sel unlock_r.err) { ret 15; }
    val exists_r3: res[bool, io_error.Error] = fs.exists(first);
    val exists_r4: res[bool, io_error.Error] = fs.exists(second);
    if ((sel exists_r3.ok && exists_r3.ok)) { ret 16; }
    if ((sel exists_r4.ok && exists_r4.ok)) { ret 16; }
    ret 0;
}

test "mach.lang.publication.plan: holds one coordinator through prepared output cleanup" {
    ret t_plan_lifetime(false);
}

test "mach.lang.publication.plan: refuses invalid destinations before publication" {
    ret t_plan_lifetime(true);
}
