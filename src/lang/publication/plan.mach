use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.allocator.page;
use std.text.string.str_free;
use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use fs: std.filesystem;
use path: std.types.path;
use txn: std.filesystem.transaction;

rec Directory {
    root: txn.Root;
    held: txn.Lock;
    identity: txn.Identity;
    opened: bool;
    locked: bool;
    next: *Directory;
}

pub rec Destination {
    claim: txn.Claim;
    path: str;
    directory: *Directory;
    reserved: bool;
    next: *Destination;
}

val PLANNING: u8 = 1;
val ADMITTING: u8 = 2;
val READY: u8 = 3;
val CLOSING: u8 = 4;

pub rec Plan {
    address: usize;
    alloc: *A.Allocator;
    directories: *Directory;
    destinations: *Destination;
    state: u8;
}

pub fun init(out: *Plan, alloc: *A.Allocator) O.Option[txn.Error] {
    if (out == nil || alloc == nil || out.address != 0) {
        ret O.some[txn.Error](txn.error(txn.INVALID, txn.OP_PREPARE));
    }
    out.alloc = alloc;
    out.directories = nil;
    out.destinations = nil;
    out.state = PLANNING;
    out.address = out::usize;
    ret O.none[txn.Error]();
}

fun valid(plan: *Plan) bool {
    ret plan != nil && plan.address == plan::usize;
}

# roots are compared by held identity before acquiring their exclusive locks
fun directory(plan: *Plan, parent: str, create: bool) R.Result[*Directory, str] {
    if (create) {
        val made: O.Option[str] = fs.create_dir_all(plan.alloc, parent, 0o755);
        if (O.is_some[str](made)) { ret R.err[*Directory, str](O.unwrap[str](made)); }
    }
    val allocated: R.Result[*Directory, str] = A.zallocate[Directory](plan.alloc, 1);
    if (R.is_err[*Directory, str](allocated)) { ret allocated; }
    val item: *Directory = R.unwrap_ok[*Directory, str](allocated);
    val opened: O.Option[txn.Error] = txn.root_open(?item.root, parent, "");
    if (O.is_some[txn.Error](opened)) {
        A.deallocate[Directory](plan.alloc, item, 1);
        ret R.err[*Directory, str](txn.error_message(O.unwrap[txn.Error](opened)));
    }
    item.opened = true;
    val observed: R.Result[txn.Identity, txn.Error] = txn.root_identity(?item.root);
    if (R.is_err[txn.Identity, txn.Error](observed)) {
        val closed: O.Option[txn.Error] = txn.root_dnit(?item.root);
        A.deallocate[Directory](plan.alloc, item, 1);
        if (O.is_some[txn.Error](closed)) { ret R.err[*Directory, str](txn.error_message(O.unwrap[txn.Error](closed))); }
        ret R.err[*Directory, str](txn.error_message(R.unwrap_err[txn.Identity, txn.Error](observed)));
    }
    item.identity = R.unwrap_ok[txn.Identity, txn.Error](observed);
    var existing: *Directory = plan.directories;
    for (existing != nil) {
        if (txn.identity_equal(existing.identity, item.identity)) {
            val closed: O.Option[txn.Error] = txn.root_dnit(?item.root);
            A.deallocate[Directory](plan.alloc, item, 1);
            if (O.is_some[txn.Error](closed)) { ret R.err[*Directory, str](txn.error_message(O.unwrap[txn.Error](closed))); }
            ret R.ok[*Directory, str](existing);
        }
        existing = existing.next;
    }
    item.next = plan.directories;
    plan.directories = item;
    ret R.ok[*Directory, str](item);
}

# destinations remain at their final addresses throughout planning and execution
pub fun add(plan: *Plan, name: str, create_parents: bool) R.Result[*Destination, str] {
    if (!valid(plan) || plan.state != PLANNING) {
        ret R.err[*Destination, str]("publication destinations require an open plan");
    }
    val cleaned: R.Result[str, str] = path.clean(plan.alloc, name);
    if (R.is_err[str, str](cleaned)) { ret R.err[*Destination, str](R.unwrap_err[str, str](cleaned)); }
    val spelling: str = R.unwrap_ok[str, str](cleaned);
    var retained: bool = false;
    fin { if (!retained) { str_free(plan.alloc, spelling); } }
    val parent_r: R.Result[str, str] = path.parent(plan.alloc, spelling);
    if (R.is_err[str, str](parent_r)) { ret R.err[*Destination, str](R.unwrap_err[str, str](parent_r)); }
    val parent: str = R.unwrap_ok[str, str](parent_r);
    fin { str_free(plan.alloc, parent); }
    val owner_r: R.Result[*Directory, str] = directory(plan, parent, create_parents);
    if (R.is_err[*Directory, str](owner_r)) { ret R.err[*Destination, str](R.unwrap_err[*Directory, str](owner_r)); }
    val owner: *Directory = R.unwrap_ok[*Directory, str](owner_r);
    var existing: *Destination = plan.destinations;
    for (existing != nil) {
        if (existing.directory == owner && str_equals(path.filename(existing.path), path.filename(spelling))) {
            ret R.ok[*Destination, str](existing);
        }
        existing = existing.next;
    }
    val allocated: R.Result[*Destination, str] = A.zallocate[Destination](plan.alloc, 1);
    if (R.is_err[*Destination, str](allocated)) { ret allocated; }
    val item: *Destination = R.unwrap_ok[*Destination, str](allocated);
    item.path = spelling;
    item.directory = owner;
    item.next = plan.destinations;
    plan.destinations = item;
    retained = true;
    ret R.ok[*Destination, str](item);
}

# recovery completes everywhere before the first reservation or worker admission
pub fun seal(plan: *Plan) O.Option[txn.Error] {
    if (!valid(plan) || plan.state != PLANNING) {
        ret O.some[txn.Error](txn.error(txn.INVALID, txn.OP_PREPARE));
    }
    plan.state = ADMITTING;
    var owner: *Directory = plan.directories;
    for (owner != nil) {
        val locked: O.Option[txn.Error] = txn.lock(?owner.held, ?owner.root);
        if (O.is_some[txn.Error](locked)) { ret locked; }
        owner.locked = true;
        owner = owner.next;
    }
    var item: *Destination = plan.destinations;
    for (item != nil) {
        val recovered: R.Result[usize, txn.Error] = txn.recover(plan.alloc, ?item.directory.held, path.filename(item.path));
        if (R.is_err[usize, txn.Error](recovered)) { ret O.some[txn.Error](R.unwrap_err[usize, txn.Error](recovered)); }
        item = item.next;
    }
    item = plan.destinations;
    for (item != nil) {
        val reserved: O.Option[txn.Error] = txn.claim(?item.claim, plan.alloc, ?item.directory.held, path.filename(item.path));
        if (O.is_some[txn.Error](reserved)) { ret reserved; }
        item.reserved = true;
        item = item.next;
    }
    plan.state = READY;
    ret O.none[txn.Error]();
}

# live transaction misuse retains the remaining owners for an explicit retry
pub fun dnit(plan: *Plan) O.Option[txn.Error] {
    if (plan == nil) { ret O.some[txn.Error](txn.error(txn.INVALID, txn.OP_LOCK)); }
    if (plan.address == 0) { ret O.none[txn.Error](); }
    if (!valid(plan)) { ret O.some[txn.Error](txn.error(txn.INVALID, txn.OP_LOCK)); }
    plan.state = CLOSING;
    var failure: O.Option[txn.Error] = O.none[txn.Error]();
    for (plan.destinations != nil) {
        val item: *Destination = plan.destinations;
        if (item.reserved) {
            val released: O.Option[txn.Error] = txn.release_claim(?item.claim);
            if (O.is_some[txn.Error](released)) {
                if (O.unwrap[txn.Error](released).kind == txn.INVALID) { ret released; }
                if (O.is_none[txn.Error](failure)) { failure = released; }
            }
        }
        plan.destinations = item.next;
        str_free(plan.alloc, item.path);
        A.deallocate[Destination](plan.alloc, item, 1);
    }
    for (plan.directories != nil) {
        val owner: *Directory = plan.directories;
        if (owner.locked) {
            val released: O.Option[txn.Error] = txn.unlock(?owner.held);
            if (O.is_some[txn.Error](released)) {
                if (O.unwrap[txn.Error](released).kind == txn.INVALID) { ret released; }
                if (O.is_none[txn.Error](failure)) { failure = released; }
            }
            owner.locked = false;
        }
        if (owner.opened) {
            val released: O.Option[txn.Error] = txn.root_dnit(?owner.root);
            if (O.is_some[txn.Error](released)) {
                if (O.unwrap[txn.Error](released).kind == txn.INVALID) { ret released; }
                if (O.is_none[txn.Error](failure)) { failure = released; }
            }
        }
        plan.directories = owner.next;
        A.deallocate[Directory](plan.alloc, owner, 1);
    }
    plan.address = 0;
    plan.state = 0;
    ret failure;
}

fun t_plan_lifetime(conflict: bool) i32 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val temporary: R.Result[fs.TempFile, str] = fs.temp_create(?alloc, "mach-publication-plan");
    if (R.is_err[fs.TempFile, str](temporary)) { ret 1; }
    var temp: fs.TempFile = R.unwrap_ok[fs.TempFile, str](temporary);
    val root: str = fs.temp_path(?temp);
    if (O.is_some[str](fs.temp_close_and_remove(?temp))) { str_free(?alloc, root); ret 1; }
    fin { fs.remove_all(?alloc, root); str_free(?alloc, root); }
    if (O.is_some[str](fs.create_dir_all(?alloc, root, 0o755))) { ret 1; }
    val first_r: R.Result[str, str] = path.join(?alloc, root, "first");
    if (R.is_err[str, str](first_r)) { ret 1; }
    val first: str = R.unwrap_ok[str, str](first_r);
    fin { str_free(?alloc, first); }
    var second_leaf: str = "second";
    if (conflict) { second_leaf = ".machtxn.reserved"; }
    val second_r: R.Result[str, str] = path.join(?alloc, root, second_leaf);
    if (R.is_err[str, str](second_r)) { ret 1; }
    val second: str = R.unwrap_ok[str, str](second_r);
    fin { str_free(?alloc, second); }
    var plan: Plan;
    if (O.is_some[txn.Error](init(?plan, ?alloc))) { ret 2; }
    fin { dnit(?plan); }
    val a: R.Result[*Destination, str] = add(?plan, first, false);
    val b: R.Result[*Destination, str] = add(?plan, second, false);
    if (R.is_err[*Destination, str](a) || R.is_err[*Destination, str](b)) { ret 2; }
    val one: *Destination = R.unwrap_ok[*Destination, str](a);
    val two: *Destination = R.unwrap_ok[*Destination, str](b);
    if (one == two || one.directory != two.directory) { ret 3; }
    var copied: Plan = plan;
    if (O.is_none[txn.Error](dnit(?copied))) { ret 4; }
    val admitted: O.Option[txn.Error] = seal(?plan);
    if (conflict) {
        if (O.is_none[txn.Error](admitted)) { ret 5; }
        if (fs.exists(first) || fs.exists(second)) { ret 6; }
        if (O.is_some[txn.Error](dnit(?plan))) { ret 7; }
        ret 0;
    }
    if (O.is_some[txn.Error](admitted)) { ret 5; }
    if (!one.reserved || !two.reserved) { ret 6; }
    if (R.is_ok[*Destination, str](add(?plan, first, false))) { ret 7; }
    var competing_root: txn.Root;
    if (O.is_some[txn.Error](txn.root_open(?competing_root, root, ""))) { ret 8; }
    fin { txn.root_dnit(?competing_root); }
    var competing_lock: txn.Lock;
    if (O.is_none[txn.Error](txn.lock(?competing_lock, ?competing_root))) {
        txn.unlock(?competing_lock);
        ret 9;
    }
    var transaction: txn.Transaction;
    val prepared: O.Option[txn.Error] = txn.prepare_bytes(?transaction, ?alloc, ?one.claim,
        "content", 7, 0o600, false,
        txn.PrepareOptions{precondition: txn.PRE_ABSENT, durability: txn.durability_none()});
    if (O.is_some[txn.Error](prepared)) { ret 10; }
    val premature: O.Option[txn.Error] = dnit(?plan);
    val aborted: O.Option[txn.Error] = txn.abort(?transaction);
    if (O.is_none[txn.Error](premature) || O.unwrap[txn.Error](premature).kind != txn.INVALID) { ret 11; }
    if (O.is_some[txn.Error](aborted)) { ret 12; }
    if (O.is_some[txn.Error](dnit(?plan))) { ret 13; }
    if (O.is_some[txn.Error](txn.lock(?competing_lock, ?competing_root))) { ret 14; }
    if (O.is_some[txn.Error](txn.unlock(?competing_lock))) { ret 15; }
    if (fs.exists(first) || fs.exists(second)) { ret 16; }
    ret 0;
}

test "mach.lang.publication.plan: holds one coordinator through prepared output cleanup" {
    ret t_plan_lifetime(false);
}

test "mach.lang.publication.plan: refuses invalid destinations before publication" {
    ret t_plan_lifetime(true);
}
