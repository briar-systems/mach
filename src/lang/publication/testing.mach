# private output directories for publication fixtures.

use std.format;
use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use fs: std.filesystem;
use io_handle: std.io.handle;
use std.system.os;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_join;
use std.text.string.str_free;

# owns an output file and its private directory until dnit.
pub rec Output {
    alloc: *A.Allocator;
    directory: str;
    file: fs.TempFile;
    closed: bool;
}

# creates an exclusive file inside a private temporary directory.
pub fun create(alloc: *A.Allocator, prefix: str) R.Result[Output, str] {
    val reserved: R.Result[fs.TempFile, str] = fs.temp_create(alloc, prefix);
    if (R.is_err[fs.TempFile, str](reserved)) { ret R.err[Output, str](R.unwrap_err[fs.TempFile, str](reserved)); }
    var marker: fs.TempFile = R.unwrap_ok[fs.TempFile, str](reserved);
    fin { fs.temp_close_and_remove(?marker); str_free(alloc, marker.path); }
    val joined: R.Result[str, str] = str_join(alloc, marker.path, ".dir");
    if (R.is_err[str, str](joined)) { ret R.err[Output, str](R.unwrap_err[str, str](joined)); }
    val directory: str = R.unwrap_ok[str, str](joined);
    var retained: bool = false;
    fin { if (!retained) { str_free(alloc, directory); } }
    val created: O.Option[str] = fs.create_dir(directory, 0o700);
    if (O.is_some[str](created)) { ret R.err[Output, str](O.unwrap[str](created)); }
    fin { if (!retained) { fs.remove_all(alloc, directory); } }
    val named: R.Result[str, str] = str_join(alloc, directory, "/output");
    if (R.is_err[str, str](named)) { ret R.err[Output, str](R.unwrap_err[str, str](named)); }
    val name: str = R.unwrap_ok[str, str](named);
    fin { if (!retained) { str_free(alloc, name); } }
    val fd: i64 = os.open(os.AT_FDCWD, name, os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600);
    if (fd < 0) { ret R.err[Output, str](os.message(fd)); }
    retained = true;
    ret R.ok[Output, str](Output{alloc: alloc, directory: directory,
        file: fs.TempFile{file: fs.File{handle: io_handle.FileHandle{value: fd::usize}}, path: name}});
}

# borrows the output path until dnit.
pub fun path(file: *Output) str {
    ret fs.temp_path(?file.file);
}

# closes the file while retaining the output path and directory.
pub fun close(file: *Output) O.Option[str] {
    if (file.closed) { ret O.none[str](); }
    file.closed = true;
    ret fs.temp_close(?file.file);
}

# closes the file, removes the owned directory and frees both paths.
pub fun dnit(file: *Output) O.Option[str] {
    val closed: O.Option[str] = close(file);
    val removed: O.Option[fs.RemovalError] = fs.remove_all(file.alloc, file.directory);
    str_free(file.alloc, file.file.path);
    str_free(file.alloc, file.directory);
    if (O.is_none[fs.RemovalError](removed)) { ret closed; }
    val error: fs.RemovalError = O.unwrap[fs.RemovalError](removed);
    var message: R.Result[str, str];
    if (O.is_some[str](closed)) {
        message = format.sprint(file.alloc, "{}; output directory removal failed: {} (code {}, cleanup code {})",
            O.unwrap[str](closed), fs.removal_message(error), error.code, error.cleanup_code);
    }
    or {
        message = format.sprint(file.alloc, "output directory removal failed: {} (code {}, cleanup code {})",
            fs.removal_message(error), error.code, error.cleanup_code);
    }
    if (R.is_err[str, str](message)) { ret O.some[str](R.unwrap_err[str, str](message)); }
    ret O.some[str](R.unwrap_ok[str, str](message));
}

# copies fixture bytes only when a dedicated evidence directory is supplied.
pub fun retain_bytes(alloc: *A.Allocator, label: str, bytes: *u8, len: usize) R.Result[R.Void, str] {
    var probe: [1]u8;
    val length: i64 = env.get("MACH_TEST_OBJECT_EVIDENCE", ?probe[0], 1);
    if (length == -1) { ret R.ok[R.Void, str](R.Void{}); }
    if (length < 0) { ret R.err[R.Void, str](os.message(length)); }
    if (length == 0) { ret R.err[R.Void, str]("empty object evidence directory"); }
    val directory_result: R.Result[str, str] = env.value(alloc, "MACH_TEST_OBJECT_EVIDENCE");
    if (R.is_err[str, str](directory_result)) { ret R.err[R.Void, str](R.unwrap_err[str, str](directory_result)); }
    val directory: str = R.unwrap_ok[str, str](directory_result);
    fin { str_free(alloc, directory); }
    val named: R.Result[str, str] = format.sprint(alloc, "{}/{}", directory, label);
    if (R.is_err[str, str](named)) { ret R.err[R.Void, str](R.unwrap_err[str, str](named)); }
    val name: str = R.unwrap_ok[str, str](named);
    fin { str_free(alloc, name); }
    val copied: O.Option[str] = fs.write_bytes(name, bytes, len, 0o600);
    if (O.is_some[str](copied)) { ret R.err[R.Void, str](O.unwrap[str](copied)); }
    ret R.ok[R.Void, str](R.Void{});
}
