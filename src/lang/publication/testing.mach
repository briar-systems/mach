# private output directories for publication fixtures.

use std.types.result.res;
use std.types.error.err;
use std.types.option.opt;
use mach.lang.build.outcome;
use io_error: std.io.error;
use string: std.types.string;
use A: std.allocator;
use fs: std.filesystem;
use io_handle: std.io.handle;
use std.system.os;
use env: std.process.env;
use format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_join;
use std.text.string.str_free;

# owns an output file and its private directory until dnit.
pub rec Output {
    alloc: *A.Allocator;
    directory: str;
    file: fs.TempFile;
    closed: bool;
}

pub fun create(alloc: *A.Allocator, prefix: str) res[Output, outcome.Fail] {
    val reserved: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, prefix);
    if (sel reserved.err) { ret res[Output, outcome.Fail].err{outcome.environment(outcome.fs_text(reserved.err))}; }
    var marker: fs.TempFile = reserved.ok;
    fin { fs.temp_close_and_remove(?marker); str_free(alloc, marker.path); }
    val joined: res[str, string.StrError] = str_join(alloc, marker.path, ".dir");
    if (sel joined.err) { ret res[Output, outcome.Fail].err{outcome.environment(outcome.str_text(joined.err))}; }
    val directory: str = joined.ok;
    var retained: bool = false;
    fin { if (!retained) { str_free(alloc, directory); } }
    val created: err[io_error.Error] = fs.create_dir(directory, 0o700);
    if (sel created.err) { ret res[Output, outcome.Fail].err{outcome.environment(outcome.io_text(created.err))}; }
    fin { if (!retained) { fs.remove_all(alloc, directory); } }
    val named: res[str, string.StrError] = str_join(alloc, directory, "/output");
    if (sel named.err) { ret res[Output, outcome.Fail].err{outcome.environment(outcome.str_text(named.err))}; }
    val name: str = named.ok;
    fin { if (!retained) { str_free(alloc, name); } }
    val fd: i64 = os.open(os.AT_FDCWD, name, os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600);
    if (fd < 0) { ret res[Output, outcome.Fail].err{outcome.environment(os.message(fd))}; }
    retained = true;
    ret res[Output, outcome.Fail].ok{Output{alloc: alloc, directory: directory,
        file: fs.TempFile{file: fs.File{handle: io_handle.FileHandle{value: fd::usize}}, path: name}}};
}

# borrows the output path until dnit.
pub fun path(file: *Output) str {
    ret fs.temp_path(?file.file);
}

pub fun close(file: *Output) err[outcome.Fail] {
    if (file.closed) { ret err[outcome.Fail].ok{}; }
    file.closed = true;
    val closed: err[io_error.Error] = fs.temp_close(?file.file);
    if (sel closed.err) { ret err[outcome.Fail].err{outcome.environment(outcome.io_text(closed.err))}; }
    ret err[outcome.Fail].ok{};
}

pub fun dnit(file: *Output) err[outcome.Fail] {
    val closed: err[outcome.Fail] = close(file);
    val removed: err[fs.FsError] = fs.remove_all(file.alloc, file.directory);
    str_free(file.alloc, file.file.path);
    str_free(file.alloc, file.directory);
    if (sel closed.err) { ret err[outcome.Fail].err{closed.err}; }
    if (sel removed.err) { ret err[outcome.Fail].err{outcome.environment(outcome.fs_text(removed.err))}; }
    ret err[outcome.Fail].ok{};
}

pub fun retain_bytes(alloc: *A.Allocator, label: str, bytes: *u8, len: usize) err[outcome.Fail] {
    val directory_result: res[opt[string.OwnedString], env.EnvError] = env.value(alloc, "MACH_TEST_OBJECT_EVIDENCE");
    if (sel directory_result.err) { ret err[outcome.Fail].err{outcome.environment(outcome.env_text(directory_result.err))}; }
    if (sel directory_result.ok.none) { ret err[outcome.Fail].ok{}; }
    var owned: string.OwnedString = directory_result.ok.some;
    fin { string.owned_release(?owned); }
    val directory: str = owned.data;
    if (owned.len == 0) { ret err[outcome.Fail].err{outcome.environment("empty object evidence directory")}; }
    val named: res[str, format.FormatError] = format.sprint(alloc, "{}/{}", directory, label);
    if (sel named.err) { ret err[outcome.Fail].err{outcome.environment(outcome.format_text(named.err))}; }
    val name: str = named.ok;
    fin { str_free(alloc, name); }
    val copied: err[fs.FsError] = fs.write_bytes(name, bytes, len, 0o600);
    if (sel copied.err) { ret err[outcome.Fail].err{outcome.environment(outcome.fs_text(copied.err))}; }
    ret err[outcome.Fail].ok{};
}
