# pull: `mach dep pull`, which realizes a project's dependency closure and notes every
# package the closure pins at more than one commit
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.session;

use package_agreement: mach.lang.package.agreement;
use package_closure:   mach.lang.package.closure;
use mach.lang.package.report;

# realize the dependency closure of a project: acquire every declared dependency
# transitively, check each realized manifest's project id against its declared name, and
# report realized directories under dep/ that are no longer in the closure and packages
# pinned at different commits within it
# ---
# s:     the session; a failure may borrow from it, so the caller shows it before ending it
# a:     the storage the operation works in
# root:  the project root directory
# quiet: report no progress lines
# rep:   receives progress, notes, and the effects a failure left
# ret:   err naming the failure
pub fun project_closure(s: *session.Session, a: *A.Allocator, root: str, quiet: bool, rep: *report.Report) err[fail.Fail] {
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, rep);
    if (sel opened.err) { ret err[fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }
    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.free_requests(a, ?reqs); }
    val walked: err[fail.Fail] = package_closure.realize(?op, ?reqs, quiet, false, false, nil, nil);
    if (sel walked.err) { ret walked; }
    var split: Vector[str] = collections_vector.init[str](a);
    fin { package_agreement.free_lines(a, ?split); }
    val checked: err[fail.Fail] = package_agreement.disagreements(?op, ?reqs, ?split);
    if (sel checked.err) { ret checked; }
    var i: usize = 0;
    for (i < split.len) {
        report.notef(rep, a, "note: {}", split.data[i]);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
