# the pin contract: where a project records the exact revision each dependency is held at,
# and how it reads one back. git is the member today: a pin is the gitlink the enclosing
# repository commits at dep/<id>, registered in .gitmodules. a member recording pins
# elsewhere, beside a source served over http, fills the same table
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use mach.lang.fail;
use mach.lang.package.report;

# how a project records pins: a repository root records its own at dep/<id>; a project in
# a subdirectory of a repository records them under its prefix when the enclosing
# repository commits one, and a project in no repository records none
pub val REPOSITORY_ROOT: u8 = 0;
pub val SUBPROJECT:      u8 = 1;

# begin: start recording pins for the project at a root that records none yet
def BeginFn: fun(ptr, str) err[fail.Fail];
# mode: how the project at a root records pins
def ModeFn: fun(ptr, str) res[u8, fail.Fail];
# read: the pin the project at a root records for an id, owned by the session
def ReadFn: fun(ptr, str, str) res[opt[str], fail.Fail];
# read_at: the pin a dependency's own project at a directory records for an id at a revision
def ReadAtFn: fun(ptr, str, str, str) res[opt[str], fail.Fail];
# tracked: whether a directory is in a place that records pins
def TrackedFn: fun(ptr, str) res[bool, fail.Fail];
# recorded: whether the project at a root records a pin for an id (root, id, mode)
def RecordedFn: fun(ptr, str, str, u8) res[bool, fail.Fail];
# record: record what dep/<id> holds as its pin (root, id)
def RecordFn: fun(ptr, str, str) err[fail.Fail];
# drop: stop recording a pin for an id (root, id, mode), noting to the report what it leaves
def DropFn: fun(ptr, str, str, u8, *report.Report) err[fail.Fail];

pub rec Pin {
    ctx:      ptr;
    begin:    BeginFn;
    mode:     ModeFn;
    read:     ReadFn;
    read_at:  ReadAtFn;
    tracked:  TrackedFn;
    recorded: RecordedFn;
    record:   RecordFn;
    drop:     DropFn;
}
