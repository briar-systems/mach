# path: the member that realizes a dependency declared by a local `path`. it has no
# releases and no pin: every pull syncs dep/<id> with its source, copying what the source's
# git keeps when the source is in a work tree, and leaving behind the build output and the
# realized dependencies of every project inside it
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.data.toml;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.memory;
use std.process.exec;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use system_os: std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use driver_load:     mach.lang.driver.load;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.session;

use driver_closure: mach.lang.driver.closure;
use mach.lang.package;
use mach.lang.package.git;
use mach.lang.package.report;

# a name in native units, owned, released with native_free
fun native_free(alloc: *A.Allocator, name: *Unit) {
    A.deallocate[Unit](alloc, name, types_path.native_len(name) + 1);
}

# `text` in native units, owned
fun native_of(alloc: *A.Allocator, text: str) res[*Unit, fail.Fail] {
    var converted: system_os.NativePath;
    if (system_os.native_path(text::*u8, ?converted) < 0) {
        val said: res[str, fail.Fail] = fail.format(alloc, "'{}' has no native spelling", text);
        if (sel said.err) { ret res[*Unit, fail.Fail].err{said.err}; }
        ret res[*Unit, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, said.ok)};
    }
    val cloned: res[*Unit, A.Error] = types_path.native_clone(alloc, converted.units);
    system_os.native_path_release(?converted);
    if (sel cloned.err) { ret res[*Unit, fail.Fail].err{fail.refused(cloned.err)}; }
    ret res[*Unit, fail.Fail].ok{cloned.ok};
}

fun native_join(alloc: *A.Allocator, left: *Unit, right: *Unit) res[*Unit, fail.Fail] {
    val joined: res[*Unit, A.Error] = types_path.native_join(alloc, left, right);
    if (sel joined.err) { ret res[*Unit, fail.Fail].err{fail.refused(joined.err)}; }
    ret res[*Unit, fail.Fail].ok{joined.ok};
}

# `name` spelled in UTF-8, owned, or nil for a name with no UTF-8 spelling, which only windows can hold
fun native_spelled(alloc: *A.Allocator, name: NativeName) res[str, fail.Fail] {
    val measured: i64 = system_os.native_spelling(name.units, name.length, nil, 0);
    if (measured < 0) { ret res[str, fail.Fail].ok{nil}; }
    val n:   usize             = measured::usize;
    val got: res[*u8, A.Error] = A.allocate[u8](alloc, n + 1);
    if (sel got.err) { ret res[str, fail.Fail].err{fail.refused(got.err)}; }
    if (system_os.native_spelling(name.units, name.length, got.ok, n) < 0) {
        A.deallocate[u8](alloc, got.ok, n + 1);
        ret res[str, fail.Fail].ok{nil};
    }
    got.ok[n] = 0;
    ret res[str, fail.Fail].ok{got.ok::str};
}

# an order over names in native units, unit by unit
fun native_compare(a: *Unit, b: *Unit) i64 {
    var i: usize = 0;
    for (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    if (a[i] < b[i]) { ret -1; }
    if (a[i] > b[i]) { ret 1; }
    ret 0;
}

fun cmp_native_name(a: *NativeName, b: *NativeName) i64 {
    ret native_compare(a.units, b.units);
}

# the directory `dir` and everything beneath it hold no symlink, walked by native names so a
# name with no UTF-8 spelling is passed over like any other
fun contained_tree_walk(alloc: *A.Allocator, dir: *Unit) err[fail.Fail] {
    val listed: res[Vector[NativeName], fs.FsError] = fs.read_dir_native(alloc, dir);
    if (sel listed.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.fs_text(listed.err))}; }
    var names: Vector[NativeName] = listed.ok;
    fin { fs.native_names_free(?names); }
    sort.sort_by[NativeName](names.data, names.len, cmp_native_name);
    var i: usize = 0;
    for (i < names.len) {
        val full_r: res[*Unit, fail.Fail] = native_join(alloc, dir, names.data[i].units);
        if (sel full_r.err) { ret err[fail.Fail].err{full_r.err}; }
        val full: *Unit = full_r.ok;
        fin { native_free(alloc, full); }
        val meta_r: res[fs.Metadata, io_error.Error] = fs.metadata_link_native(full);
        if (sel meta_r.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.io_text(meta_r.err))}; }
        val meta: fs.Metadata = meta_r.ok;
        if (fs.meta_is_symlink(?meta)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_SYMLINK, "path dependency realization must contain no symlinks")}; }
        if (fs.meta_is_dir(?meta)) {
            val walk_r: err[fail.Fail] = contained_tree_walk(alloc, full);
            if (sel walk_r.err) { ret walk_r; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# what `mach dep verify` checks of a path dependency's copy: no repository metadata and no
# symlink anywhere in it
# ---
# ret: the realized content an exact selector is checked against
pub fun verify(s: *session.Session, alias: str, dep_dir: str) res[intern.StrId, fail.Fail] {
    val meta_r: res[str, fail.Fail] = driver_load.join_path(s.build_alloc, dep_dir, ".git");
    if (sel meta_r.err) { ret res[intern.StrId, fail.Fail].err{meta_r.err}; }
    val meta:     str                       = meta_r.ok;
    val exists_r: res[bool, io_error.Error] = fs.exists(meta);
    val has_meta: bool                      = (sel exists_r.ok && exists_r.ok);
    str_free(s.build_alloc, meta);
    if (has_meta) { ret res[intern.StrId, fail.Fail].err{fail.user(diagnostic_kind.DEP_REPOSITORY_METADATA, "path dependency realization contains forbidden repository metadata")}; }
    val dir_r: res[*Unit, fail.Fail] = native_of(s.build_alloc, dep_dir);
    if (sel dir_r.err) { ret res[intern.StrId, fail.Fail].err{dir_r.err}; }
    val walk_r: err[fail.Fail] = contained_tree_walk(s.build_alloc, dir_r.ok);
    native_free(s.build_alloc, dir_r.ok);
    if (sel walk_r.err) { ret res[intern.StrId, fail.Fail].err{walk_r.err}; }
    val content_text_r: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "path/{}", alias);
    if (sel content_text_r.err) { ret res[intern.StrId, fail.Fail].err{fail.message(fail.format_text(content_text_r.err))}; }
    val content_text: str                        = content_text_r.ok;
    val content_r:    res[intern.StrId, A.Error] = intern.add(?s.interner, content_text);
    str_free(s.build_alloc, content_text);
    if (sel content_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(content_r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{content_r.ok};
}

# an entry of a tree being copied, named by its path below the root in native units, so a
# windows name with no UTF-8 spelling is copied as it is
# ---
# rel:   the path below the root in native units, owned
# shown: its UTF-8 rendering for notes, owned, a component with no UTF-8 spelling shown as U+FFFD
rec CopyEntry {
    rel:       *Unit;
    shown:     str;
    directory: bool;
    mode:      i32;
}

fun cmp_copy_entry(a: *CopyEntry, b: *CopyEntry) i64 {
    ret native_compare(a.rel, b.rel);
}

fun copy_entries_free(alloc: *A.Allocator, entries: *Vector[CopyEntry]) {
    var i: usize = 0;
    for (i < entries.len) {
        native_free(alloc, entries.data[i].rel);
        str_free(alloc, entries.data[i].shown);
        i = i + 1;
    }
    collections_vector.dnit[CopyEntry](entries);
}

# the directory a project's `[project].work` names, which is the template's leading
# segment: `out/{target.name}/{profile.name}` is written under `out`. a template that
# opens with a variable names no directory this can exclude, and names the conventional
# one. the name is owned by `alloc`
fun out_dir_segment(alloc: *A.Allocator, template: str) res[str, fail.Fail] {
    val n: usize = str_len(template);
    var i: usize = 0;
    for (i < n && template[i] != '/' && template[i] != '\\' && template[i] != '{') { i = i + 1; }
    var copied: res[str, types_string.StrError] = str_copy_slice(alloc, template, 0::usize, i);
    if (i == 0 || (i < n && template[i] == '{')) { copied = str_copy_slice(alloc, "out", 0::usize, 3); }
    if (sel copied.err)                          { ret res[str, fail.Fail].err{fail.str_refused(copied.err)}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

# the work directory of a project directory, owned by `alloc`: its manifest's `work`, or
# the conventional name when the manifest names none. a directory without a manifest is
# not a project and excludes nothing, so it answers none; a manifest that cannot be read
# or does not parse is the failure
# ---
# dir:   the directory in native units
# shown: its UTF-8 rendering, which the manifest's diagnostics name
fun project_work_name(alloc: *A.Allocator, dir: *Unit, shown: str) res[opt[str], fail.Fail] {
    val leaf_r: res[*Unit, fail.Fail] = native_of(alloc, manifest.MANIFEST_FILE);
    if (sel leaf_r.err) { ret res[opt[str], fail.Fail].err{leaf_r.err}; }
    fin { native_free(alloc, leaf_r.ok); }
    val mf_r: res[*Unit, fail.Fail] = native_join(alloc, dir, leaf_r.ok);
    if (sel mf_r.err) { ret res[opt[str], fail.Fail].err{mf_r.err}; }
    val mf: *Unit = mf_r.ok;
    fin { native_free(alloc, mf); }
    val present: res[bool, io_error.Error] = fs.is_file_native(mf);
    if (sel present.err) { ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.io_text(present.err))}; }
    if (!present.ok)     { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes_native(alloc, mf);
    if (sel bytes_r.err) { ret res[opt[str], fail.Fail].err{fail.fs_environment(diagnostic_kind.FS_READ, bytes_r.err)}; }
    var bytes: Vector[u8] = bytes_r.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    val shown_r: res[str, fail.Fail] = driver_load.join_path(alloc, shown, manifest.MANIFEST_FILE);
    if (sel shown_r.err) { ret res[opt[str], fail.Fail].err{shown_r.err}; }
    val doc_r: res[manifest.Doc, fail.Fail] = manifest.doc_parse_bytes(alloc, shown_r.ok, bytes.data, bytes.len);
    str_free(alloc, shown_r.ok);
    if (sel doc_r.err) { ret res[opt[str], fail.Fail].err{doc_r.err}; }
    var doc: manifest.Doc = doc_r.ok;
    fin { manifest.doc_dnit(alloc, ?doc); }
    var template: str      = "out";
    val declared: opt[str] = toml.get_str(?doc.table, "project.work");
    if (sel declared.some) {
        if (!str_empty(declared.some)) { template = declared.some; }
    }
    val named: res[str, fail.Fail] = out_dir_segment(alloc, template);
    if (sel named.err) { ret res[opt[str], fail.Fail].err{named.err}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{named.ok}};
}

# what git considers part of a path dependency's source: its tracked files and the
# untracked ones its ignore rules keep, listed once. inactive outside a work tree,
# and for a source the enclosing repository ignores, which that repository does not hold
rec PathFilter {
    active: bool;
    paths:  Vector[str];
    top:    str;
}

val FILTER_SKIP:  u8 = 0;
val FILTER_WALK:  u8 = 1;
val FILTER_WHOLE: u8 = 2;

# a path order that reads `\` as `/`, so a joined path compares with git's
fun cmp_rel(a: str, b: str) i64 {
    var i: usize = 0;
    for (true) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret ca::i64 - cb::i64; }
        if (ca == 0)    { ret 0; }
        i = i + 1;
    }
    ret 0;
}

fun cmp_rel_ptr(a: *str, b: *str) i64 {
    ret cmp_rel(@a, @b);
}

fun path_filter_free(alloc: *A.Allocator, f: *PathFilter) {
    if (f.active)     { package.free_name_vector(alloc, ?f.paths); }
    if (f.top != nil) { str_free(alloc, f.top); }
    f.active = false;
    f.top    = nil;
}

# whether `git status` from a subdirectory reports it, or a directory holding it, as ignored.
# entries are relative to the work tree top, as `prefix` is, and an ignored directory ends in `/`
fun status_ignores_prefix(bytes: *git.Bytes, prefix: str) bool {
    val n:  usize = str_len(prefix);
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        val len: usize = end - at;
        if (len > 3 && len - 3 <= n && bytes.data[at] == '!' && bytes.data[at + 1] == '!' && bytes.data[end - 1] == '/') {
            var k: usize = 0;
            for (k < len - 3 && bytes.data[at + 3 + k] == prefix[k]) { k = k + 1; }
            if (k == len - 3) { ret true; }
        }
        at = end + 1;
    }
    ret false;
}

fun path_filter_refusal(alloc: *A.Allocator, what: str, src: str, top: str, cause: fail.Fail) fail.Fail {
    val mr: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "path dependency '{}': cannot {} the git repository at '{}': {}", src, what, top, fail.describe(cause));
    if (sel mr.err) { ret cause; }
    ret fail.owning(fail.with_text(cause, mr.ok));
}

# the kept listing of a source, from the repository that holds it. an empty listing below the
# top of a work tree is the one case where the source may be ignored rather than empty, and only
# then is the ignore state asked for, so a source costs two git processes, or three in that case
fun path_filter_load(alloc: *A.Allocator, environ: exec.Environment, src: str) res[PathFilter, fail.Fail] {
    var f:    PathFilter                    = PathFilter{active: false, top: nil};
    val gi_r: res[git.Inspector, fail.Fail] = git.inspector_init(alloc, environ);
    if (sel gi_r.err) { ret res[PathFilter, fail.Fail].ok{f}; }
    var gi: git.Inspector = gi_r.ok;
    fin { git.inspector_dnit(alloc, ?gi); }
    var where_args: [4]str;
    where_args[0] = "rev-parse";
    where_args[1] = "--is-inside-work-tree";
    where_args[2] = "--show-prefix";
    where_args[3] = "--show-toplevel";
    # a source outside any repository is an expected answer, so git's complaint about it is captured, not shown
    val where_r: res[git.Bytes, fail.Fail] = git.query_capture(alloc, ?gi, src, ?where_args[0], 4, false, nil, system_os.INVALID_HANDLE, true);
    if (sel where_r.err) { ret res[PathFilter, fail.Fail].ok{f}; }
    var where: git.Bytes = where_r.ok;
    fin { git.bytes_free(alloc, ?where); }
    var first: usize = 0;
    for (first < where.len && where.data[first] != '\n') { first = first + 1; }
    if (first >= where.len) { ret res[PathFilter, fail.Fail].ok{f}; }
    where.data[first] = 0;
    if (!str_equals(where.data::str, "true")) { ret res[PathFilter, fail.Fail].ok{f}; }
    val prefix_at: usize = first + 1;
    var second:    usize = prefix_at;
    for (second < where.len && where.data[second] != '\n') { second = second + 1; }
    if (second >= where.len) { ret res[PathFilter, fail.Fail].ok{f}; }
    where.data[second] = 0;
    val prefix:  str   = (?where.data[prefix_at])::str;
    var top_end: usize = where.len;
    for (top_end > second + 1 && (where.data[top_end - 1] == '\n' || where.data[top_end - 1] == '\r')) { top_end = top_end - 1; }
    val top_r: res[str, types_string.StrError] = str_copy_slice(alloc, (?where.data[second + 1])::str, 0, top_end - second - 1);
    if (sel top_r.err) { ret res[PathFilter, fail.Fail].err{fail.message(fail.str_text(top_r.err))}; }
    f.top = top_r.ok;
    var handed: bool = false;
    fin {
        if (!handed) { path_filter_free(alloc, ?f); }
    }
    var list_args: [5]str;
    list_args[0] = "ls-files";
    list_args[1] = "--cached";
    list_args[2] = "--others";
    list_args[3] = "--exclude-standard";
    list_args[4] = "-z";
    val listed: res[git.Bytes, fail.Fail] = git.query_capture(alloc, ?gi, src, ?list_args[0], 5, false, nil, system_os.INVALID_HANDLE, true);
    if (sel listed.err) {
        ret res[PathFilter, fail.Fail].err{path_filter_refusal(alloc, "list the files kept by", src, f.top, listed.err)};
    }
    var bytes: git.Bytes = listed.ok;
    fin { git.bytes_free(alloc, ?bytes); }
    if (bytes.len == 0 && !str_empty(prefix)) {
        var status_args: [6]str;
        status_args[0] = "status";
        status_args[1] = "--porcelain=v1";
        status_args[2] = "-z";
        status_args[3] = "--ignored=matching";
        status_args[4] = "--";
        status_args[5] = ".";
        val status_r: res[git.Bytes, fail.Fail] = git.query_capture(alloc, ?gi, src, ?status_args[0], 6, false, nil, system_os.INVALID_HANDLE, true);
        if (sel status_r.err) {
            ret res[PathFilter, fail.Fail].err{path_filter_refusal(alloc, "read the ignore state from", src, f.top, status_r.err)};
        }
        var status:  git.Bytes = status_r.ok;
        val ignored: bool      = status_ignores_prefix(?status, prefix);
        git.bytes_free(alloc, ?status);
        if (ignored) {
            path_filter_free(alloc, ?f);
            ret res[PathFilter, fail.Fail].ok{f};
        }
    }
    f.paths  = collections_vector.init[str](alloc);
    f.active = true;
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        if (end > at) {
            val one: res[str, types_string.StrError] = str_copy_slice(alloc, (?bytes.data[at])::str, 0, end - at);
            if (sel one.err) { ret res[PathFilter, fail.Fail].err{fail.message(fail.str_text(one.err))}; }
            val pushed: res[usize, A.Error] = collections_vector.push[str](?f.paths, one.ok);
            if (sel pushed.err) {
                str_free(alloc, one.ok);
                ret res[PathFilter, fail.Fail].err{fail.refused(pushed.err)};
            }
        }
        at = end + 1;
    }
    sort.sort_by[str](f.paths.data, f.paths.len, cmp_rel_ptr);
    handed = true;
    ret res[PathFilter, fail.Fail].ok{f};
}

# `path` against `rel` followed by a separator, in cmp_rel's order
fun cmp_rel_below(path: str, rel: str) i64 {
    var i: usize = 0;
    for (rel[i] != 0) {
        var ca: u8 = path[i];
        var cb: u8 = rel[i];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret ca::i64 - cb::i64; }
        i = i + 1;
    }
    var ca: u8 = path[i];
    if (ca == '\\') { ca = '/'; }
    ret ca::i64 - '/'::i64;
}

# a listed path is kept, and a directory is walked when a listed path lies beneath it; a listed
# directory is a submodule gitlink, whose content git does not list, so it is kept whole
fun filter_decides(f: *PathFilter, rel: str) u8 {
    var lo: usize = 0;
    var hi: usize = f.paths.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (cmp_rel(f.paths.data[mid], rel) < 0) { lo = mid + 1; }
        or                                       { hi = mid; }
    }
    if (lo < f.paths.len && cmp_rel(f.paths.data[lo], rel) == 0) { ret FILTER_WHOLE; }
    # the first listed path at or after `rel/`, which lies beneath `rel` exactly when it starts so
    lo = 0;
    hi = f.paths.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (cmp_rel_below(f.paths.data[mid], rel) < 0) { lo = mid + 1; }
        or                                             { hi = mid; }
    }
    if (lo >= f.paths.len) { ret FILTER_SKIP; }
    val n: usize = str_len(rel);
    if (str_len(f.paths.data[lo]) <= n) { ret FILTER_SKIP; }
    var k: usize = 0;
    for (k < n) {
        var ca: u8 = f.paths.data[lo][k];
        var cb: u8 = rel[k];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret FILTER_SKIP; }
        k = k + 1;
    }
    val sep: u8 = f.paths.data[lo][n];
    if (sep == '/' || sep == '\\') { ret FILTER_WALK; }
    ret FILTER_SKIP;
}

# the inventory of a path dependency is its source: at every project
# boundary (a directory holding a manifest) the realized dependencies and
# the build output are left behind, so a re-pull copies what the first did.
# `keep`, when active, narrows it to what git keeps. the tree is listed by
# native names, and a name with no UTF-8 spelling matches no UTF-8 name: it
# is never the metadata, a boundary's directories, or a path git lists
# ---
# root:  the tree's root in native units
# rel:   the directory listed, below root in native units
# shown: rel's UTF-8 rendering
fun copy_inventory(alloc: *A.Allocator, root: *Unit, rel: *Unit, shown: str, source: bool,
    excluded: *fs.Identity, excluded_n: usize, entries: *Vector[CopyEntry], keep: *PathFilter) err[fail.Fail] {
    val dir_r: res[*Unit, fail.Fail] = native_join(alloc, root, rel);
    if (sel dir_r.err) { ret err[fail.Fail].err{dir_r.err}; }
    val dir: *Unit = dir_r.ok;
    fin { native_free(alloc, dir); }
    var out:     str  = nil;
    var project: bool = false;
    if (source) {
        val work: res[opt[str], fail.Fail] = project_work_name(alloc, dir, shown);
        if (sel work.err) { ret err[fail.Fail].err{work.err}; }
        if (sel work.ok.some) {
            project = true;
            out     = work.ok.some;
        }
    }
    fin {
        if (out != nil) { str_free(alloc, out); }
    }
    val listed: res[Vector[NativeName], fs.FsError] = fs.read_dir_native(alloc, dir);
    if (sel listed.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.fs_text(listed.err))}; }
    var names: Vector[NativeName] = listed.ok;
    fin { fs.native_names_free(?names); }
    sort.sort_by[NativeName](names.data, names.len, cmp_native_name);
    var i: usize = 0;
    for (i < names.len) {
        val name: NativeName = names.data[i];
        i = i + 1;
        val spelled_r: res[str, fail.Fail] = native_spelled(alloc, name);
        if (sel spelled_r.err) { ret err[fail.Fail].err{spelled_r.err}; }
        val spelled: str = spelled_r.ok;
        fin {
            if (spelled != nil) { str_free(alloc, spelled); }
        }
        if (spelled != nil && source && str_equals(spelled, ".git"))                                                                { cnt; }
        if (spelled != nil && project && (str_equals(spelled, driver_closure.DEP_DIR) || (out != nil && str_equals(spelled, out)))) { cnt; }
        var decision: u8 = FILTER_WHOLE;
        if (keep != nil && keep.active) {
            decision = FILTER_SKIP;
            if (spelled != nil) {
                val probe_r: res[str, fail.Fail] = driver_load.join_path(alloc, shown, spelled);
                if (sel probe_r.err) { ret err[fail.Fail].err{probe_r.err}; }
                decision = filter_decides(keep, probe_r.ok);
                str_free(alloc, probe_r.ok);
            }
        }
        if (decision == FILTER_SKIP) { cnt; }
        val child_r: res[*Unit, fail.Fail] = native_join(alloc, rel, name.units);
        if (sel child_r.err) { ret err[fail.Fail].err{child_r.err}; }
        val child:       *Unit = child_r.ok;
        var transferred: bool  = false;
        fin {
            if (!transferred) { native_free(alloc, child); }
        }
        var leaf: str = spelled;
        if (leaf == nil) { leaf = "\xef\xbf\xbd"; }
        val child_shown_r: res[str, fail.Fail] = driver_load.join_path(alloc, shown, leaf);
        if (sel child_shown_r.err) { ret err[fail.Fail].err{child_shown_r.err}; }
        val child_shown: str = child_shown_r.ok;
        fin {
            if (!transferred) { str_free(alloc, child_shown); }
        }
        val full_r: res[*Unit, fail.Fail] = native_join(alloc, root, child);
        if (sel full_r.err) { ret err[fail.Fail].err{full_r.err}; }
        val full: *Unit = full_r.ok;
        fin { native_free(alloc, full); }
        val mr: res[fs.Metadata, io_error.Error] = fs.metadata_link_native(full);
        if (sel mr.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.io_text(mr.err))}; }
        val meta:      fs.Metadata = mr.ok;
        val directory: bool        = fs.meta_is_dir(?meta);
        if (!directory && !fs.meta_is_file(?meta)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_SYMLINK, "path dependency inventory contains a symlink or non-regular entry; existing files retained")};
        }
        if (directory && excluded_n != 0) {
            var identity: fs.Identity;
            if (system_os.identity_at_native(system_os.working_dir(), full, ?identity) < 0) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, "cannot observe path dependency source directory identity")}; }
            var hit: bool  = false;
            var k:   usize = 0;
            for (k < excluded_n) {
                if (fs.identity_equal(identity, excluded[k])) { hit = true; }
                k = k + 1;
            }
            if (hit) { cnt; }
        }
        val pushed: res[usize, A.Error] = collections_vector.push[CopyEntry](entries, CopyEntry{rel: child, shown: child_shown, directory: directory, mode: (meta.mode & 0o777)::i32});
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        transferred = true;
        if (directory) {
            var nested_keep: *PathFilter = keep;
            if (decision == FILTER_WHOLE) { nested_keep = nil; }
            val nested: err[fail.Fail] = copy_inventory(alloc, root, child, child_shown, source, excluded, excluded_n, entries, nested_keep);
            if (sel nested.err) { ret err[fail.Fail].err{nested.err}; }
        }
    }
    ret err[fail.Fail].ok{};
}

# the entry of a sorted inventory at `rel`, or nil
fun inventory_find(entries: *Vector[CopyEntry], rel: *Unit) *CopyEntry {
    var lo: usize = 0;
    var hi: usize = entries.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val cmp: i64   = native_compare(entries.data[mid].rel, rel);
        if (cmp == 0) { ret ?entries.data[mid]; }
        if (cmp < 0)  { lo = mid + 1; }
        or            { hi = mid; }
    }
    ret nil;
}

# whether the source inventory holds `prior` with the same kind
fun source_has(entries: *Vector[CopyEntry], prior: *CopyEntry) bool {
    val found: *CopyEntry = inventory_find(entries, prior.rel);
    ret found != nil && found.directory == prior.directory;
}

fun bytes_equal(a: *Vector[u8], b: *Vector[u8]) bool {
    ret a.len == b.len && memory.equal[u8](a.data, b.data, a.len);
}

# a source's inventory is never silently empty, and a project source keeps its manifest,
# since an empty or manifest-less copy fails later with a cause that points elsewhere
fun inventory_keeps_source(alloc: *A.Allocator, src: str, entries: *Vector[CopyEntry], keep: *PathFilter) err[fail.Fail] {
    var holds: bool = entries.len != 0;
    if (holds) {
        val mf_r: res[str, fail.Fail] = driver_load.join_path(alloc, src, manifest.MANIFEST_FILE);
        if (sel mf_r.err) { ret err[fail.Fail].err{mf_r.err}; }
        val present: res[bool, io_error.Error] = fs.is_file(mf_r.ok);
        str_free(alloc, mf_r.ok);
        if (sel present.ok && present.ok) {
            val leaf_r: res[*Unit, fail.Fail] = native_of(alloc, manifest.MANIFEST_FILE);
            if (sel leaf_r.err) { ret err[fail.Fail].err{leaf_r.err}; }
            var wanted: CopyEntry = CopyEntry{rel: leaf_r.ok, shown: manifest.MANIFEST_FILE, directory: false, mode: 0};
            holds = source_has(entries, ?wanted);
            native_free(alloc, leaf_r.ok);
        }
    }
    if (holds) { ret err[fail.Fail].ok{}; }
    var mr: res[str, std_format.FormatError];
    if (keep.active) {
        mr = std_format.sprint(alloc,
            "path dependency source '{}' keeps no {} under the rules of the git repository at '{}', which ignores it; un-ignore or track it there, or make the source its own repository",
            src, manifest.MANIFEST_FILE, keep.top);
    }
    or              { mr = std_format.sprint(alloc, "path dependency source '{}' has nothing to copy", src); }
    if (sel mr.err) { ret err[fail.Fail].err{fail.format_refused(mr.err)}; }
    ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_PATH_EMPTY, mr.ok)};
}

# sync `dst` with `src` and report whether anything in it changed: false when the copy
# already matched its source and was reused as it stood
fun copy_tree(alloc: *A.Allocator, environ: exec.Environment, src: str, dst: str, consumer: str, rep: *report.Report) res[bool, fail.Fail] {
    val sm: res[fs.Metadata, io_error.Error] = fs.metadata_link(src);
    if (sel sm.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.io_text(sm.err))}; }
    val source_meta: fs.Metadata = sm.ok;
    if (!fs.meta_is_dir(?source_meta)) { ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_DIRECTORY, "path dependency source must be a physical directory")}; }
    var destination_identity: fs.Identity;
    val observed:             i64 = system_os.identity_at(system_os.working_dir(), dst::*u8, ?destination_identity);
    if (observed < 0 && system_os.error_kind(observed) != io_error.NOT_FOUND) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, "cannot inspect the path dependency destination")}; }
    var excluded:   [2]fs.Identity;
    var excluded_n: usize = 0;
    if (observed == 0) {
        val dm: res[fs.Metadata, io_error.Error] = fs.metadata_link(dst);
        if (sel dm.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.io_text(dm.err))}; }
        val destination_meta: fs.Metadata = dm.ok;
        if (!fs.meta_is_dir(?destination_meta)) { ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_DIRECTORY, "path dependency destination must be a physical directory")}; }
        var source_identity: fs.Identity;
        if (system_os.identity_at(system_os.working_dir(), src::*u8, ?source_identity) < 0) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, "cannot inspect the path dependency source identity")}; }
        if (fs.identity_equal(source_identity, destination_identity))                       { ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.DEP_PATH_SAME, "path dependency source and destination are the same directory")}; }
        excluded[0] = destination_identity;
        excluded_n  = 1;
    }
    # the consumer's own root, whichever level of the source it sits at, is never part of its dependency
    var consumer_identity: fs.Identity;
    if (system_os.identity_at(system_os.working_dir(), consumer::*u8, ?consumer_identity) < 0) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, "cannot inspect the path dependency consumer root")}; }
    excluded[excluded_n] = consumer_identity;
    excluded_n           = excluded_n + 1;
    val src_r: res[*Unit, fail.Fail] = native_of(alloc, src);
    if (sel src_r.err) { ret res[bool, fail.Fail].err{src_r.err}; }
    val src_n: *Unit = src_r.ok;
    fin { native_free(alloc, src_n); }
    val dst_r: res[*Unit, fail.Fail] = native_of(alloc, dst);
    if (sel dst_r.err) { ret res[bool, fail.Fail].err{dst_r.err}; }
    val dst_n: *Unit = dst_r.ok;
    fin { native_free(alloc, dst_n); }
    var top: [1]Unit;
    top[0] = 0;
    var entries: Vector[CopyEntry] = collections_vector.init[CopyEntry](alloc);
    fin { copy_entries_free(alloc, ?entries); }
    val filter_r: res[PathFilter, fail.Fail] = path_filter_load(alloc, environ, src);
    if (sel filter_r.err) { ret res[bool, fail.Fail].err{filter_r.err}; }
    var keep: PathFilter = filter_r.ok;
    fin { path_filter_free(alloc, ?keep); }
    val collected: err[fail.Fail] = copy_inventory(alloc, src_n, ?top[0], "", true, ?excluded[0], excluded_n, ?entries, ?keep);
    if (sel collected.err) { ret res[bool, fail.Fail].err{collected.err}; }
    sort.sort_by[CopyEntry](entries.data, entries.len, cmp_copy_entry);
    val kept: err[fail.Fail] = inventory_keeps_source(alloc, src, ?entries, ?keep);
    if (sel kept.err) { ret res[bool, fail.Fail].err{kept.err}; }
    var existing: Vector[CopyEntry] = collections_vector.init[CopyEntry](alloc);
    fin { copy_entries_free(alloc, ?existing); }
    if (observed == 0) {
        val collected_dst: err[fail.Fail] = copy_inventory(alloc, dst_n, ?top[0], "", false, nil, 0, ?existing, nil);
        if (sel collected_dst.err) { ret res[bool, fail.Fail].err{collected_dst.err}; }
    }
    sort.sort_by[CopyEntry](existing.data, existing.len, cmp_copy_entry);
    var changed: bool = observed != 0;
    # the realization is its source: an entry the source no longer has is removed rather
    # than kept, and every removal is named, since the destination is mach's own copy
    var i: usize = existing.len;
    for (i > 0) {
        i = i - 1;
        val prior: CopyEntry = existing.data[i];
        if (source_has(?entries, ?prior)) { cnt; }
        val full_r: res[*Unit, fail.Fail] = native_join(alloc, dst_n, prior.rel);
        if (sel full_r.err) { ret res[bool, fail.Fail].err{full_r.err}; }
        val full: *Unit = full_r.ok;
        fin { native_free(alloc, full); }
        var why: str = nil;
        if (prior.directory) {
            val pruned: err[fs.FsError] = fs.remove_all_native(alloc, full);
            if (sel pruned.err) { why = fail.fs_text(pruned.err); }
        }
        or {
            val unlinked: err[io_error.Error] = fs.remove_file_native(full);
            if (sel unlinked.err) { why = fail.io_text(unlinked.err); }
        }
        if (why != nil) {
            val msg: res[str, std_format.FormatError] = std_format.sprint(alloc,
                "path dependency destination '{}' holds '{}', which the source no longer has, and it could not be removed: {}", dst, prior.shown, why);
            if (sel msg.err) { ret res[bool, fail.Fail].err{fail.format_refused(msg.err)}; }
            ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_REMOVE, msg.ok)};
        }
        report.notef(rep, alloc, "note: path dependency '{}': removed '{}', which its source no longer has", dst, prior.shown);
        changed = true;
    }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(alloc, dst, 0o755);
    if (sel create_dir_all_r.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, "cannot create the copy destination")}; }
    i = 0;
    var complete: bool = false;
    fin {
        if (!complete) { report.notef(rep, alloc, "note: path dependency copy stopped after {} entries; destination '{}' retained for inspection", i, dst); }
    }
    for (i < entries.len) {
        val entry:  CopyEntry             = entries.data[i];
        val from_r: res[*Unit, fail.Fail] = native_join(alloc, src_n, entry.rel);
        if (sel from_r.err) { ret res[bool, fail.Fail].err{from_r.err}; }
        val from: *Unit = from_r.ok;
        fin { native_free(alloc, from); }
        val to_r: res[*Unit, fail.Fail] = native_join(alloc, dst_n, entry.rel);
        if (sel to_r.err) { ret res[bool, fail.Fail].err{to_r.err}; }
        val to: *Unit = to_r.ok;
        fin { native_free(alloc, to); }
        if (entry.directory) {
            if (inventory_find(?existing, entry.rel) == nil) { changed = true; }
            val made: err[fs.FsError] = fs.create_dir_all_native(alloc, to, 0o755);
            if (sel made.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(made.err))}; }
        }
        or {
            val bytes_r: res[Vector[u8], fs.FsError] = fs.read_bytes_native(alloc, from);
            if (sel bytes_r.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.fs_text(bytes_r.err))}; }
            var bytes: Vector[u8] = bytes_r.ok;
            fin { collections_vector.dnit[u8](?bytes); }
            # a file the copy already holds is left alone when it matches, and named when replaced,
            # since a re-pull overwrites whatever the copy was edited to
            val prior:    *CopyEntry = inventory_find(?existing, entry.rel);
            var replaced: bool       = false;
            if (prior != nil && !prior.directory) {
                val held_r: res[Vector[u8], fs.FsError] = fs.read_bytes_native(alloc, to);
                if (sel held_r.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, fail.fs_text(held_r.err))}; }
                var held: Vector[u8] = held_r.ok;
                val same: bool       = bytes_equal(?held, ?bytes);
                collections_vector.dnit[u8](?held);
                if (same && prior.mode == entry.mode) {
                    i = i + 1;
                    cnt;
                }
                replaced = !same;
            }
            changed = true;
            val written: err[fs.FsError] = fs.write_bytes_native(to, bytes.data, bytes.len, entry.mode);
            if (sel written.err) { ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(written.err))}; }
            if (replaced)        { report.notef(rep, alloc, "note: path dependency '{}': replaced '{}' with its source's content", dst, entry.shown); }
        }
        i = i + 1;
    }
    complete = true;
    ret res[bool, fail.Fail].ok{changed};
}

# sync dep/<id> with a path dependency's source
# ---
# ret: true when the copy was refreshed, false when it already matched its source and was reused
pub fun realize(s: *session.Session, root: str, id: str, src_dir: str, rep: *report.Report) res[bool, fail.Fail] {
    val id_r: err[fail.Fail] = package.verify_dep_manifest_id(s, src_dir, id);
    if (sel id_r.err) { ret res[bool, fail.Fail].err{id_r.err}; }
    val dep_full_r: res[str, fail.Fail] = package.dep_full_of(s.build_alloc, root, id);
    if (sel dep_full_r.err) { ret res[bool, fail.Fail].err{dep_full_r.err}; }
    val dep_full: str = dep_full_r.ok;
    fin { str_free(s.build_alloc, dep_full); }
    ret copy_tree(s.build_alloc, s.environ, src_dir, dep_full, root, rep);
}
