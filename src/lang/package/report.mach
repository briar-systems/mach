# where dependency management reports while it works. a progress line, a note and a
# failure the operation goes on past stream to the caller as they happen; `effects` collects
# a note for each change an operation made before it failed, which the caller shows after
# the failure, so a failed command still names the state it left
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_free;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;

# a progress line, written to standard output
def LineFn: fun(ptr, str);
# a note, written to standard error
def NoteFn: fun(ptr, str);
# a failure the operation reports and goes on past
def FaultFn: fun(ptr, fail.Fail);

pub rec Report {
    ctx:     ptr;
    line:    LineFn;
    note:    NoteFn;
    fault:   FaultFn;
    effects: Vector[str];
}

# a report over the given sink, whose effects `a` owns
pub fun init(a: *A.Allocator, ctx: ptr, on_line: LineFn, on_note: NoteFn, on_fault: FaultFn) Report {
    ret Report{ctx: ctx, line: on_line, note: on_note, fault: on_fault, effects: collections_vector.init[str](a)};
}

pub fun dnit(r: *Report) {
    var i: usize = 0;
    for (i < r.effects.len) {
        str_free(r.effects.a, r.effects.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](?r.effects);
}

pub fun line(r: *Report, text: str) {
    r.line(r.ctx, text);
}

pub fun note(r: *Report, text: str) {
    r.note(r.ctx, text);
}

pub fun fault(r: *Report, f: fail.Fail) {
    r.fault(r.ctx, f);
}

# keep an effect note formatted as std.format formats it; a note that cannot be kept is
# dropped, since it only explains a failure already reported
pub fun effectf(r: *Report, fmt: str, va: ...) {
    val text: res[str, std_format.FormatError] = std_format.sprint(r.effects.a, fmt, va...);
    if (sel text.err) { ret; }
    val pushed: res[usize, A.Error] = collections_vector.push[str](?r.effects, text.ok);
    if (sel pushed.err) { str_free(r.effects.a, text.ok); }
}

# a progress line formatted as std.format formats it, through storage `a` lends for the call
pub fun linef(r: *Report, a: *A.Allocator, fmt: str, va: ...) {
    val text: res[str, std_format.FormatError] = std_format.sprint(a, fmt, va...);
    if (sel text.err) { ret; }
    r.line(r.ctx, text.ok);
    str_free(a, text.ok);
}

# a note formatted as std.format formats it, through storage `a` lends for the call
pub fun notef(r: *Report, a: *A.Allocator, fmt: str, va: ...) {
    val text: res[str, std_format.FormatError] = std_format.sprint(a, fmt, va...);
    if (sel text.err) { ret; }
    r.note(r.ctx, text.ok);
    str_free(a, text.ok);
}

fun discard_text(ctx: ptr, text: str) {}

fun discard_fault(ctx: ptr, f: fail.Fail) {}

# a report that keeps nothing, for work that has nothing to say or a test that checks state
# rather than what is said
pub fun discard(a: *A.Allocator) Report {
    ret init(a, nil, discard_text, discard_text, discard_fault);
}
