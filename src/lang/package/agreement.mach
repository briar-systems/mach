# agreement: one package pinned at one commit across a whole dependency closure. every
# project of the closure records the commits of the dependencies it declares, so two
# projects, one reached through a path dependency, can pin the same package differently
# and a build would mix two versions of it with nothing saying so. identity is the
# dependency key, which the closure already holds equal to the dependency's project id.
# pins are compared among declarations that select the same source and ref: declarations
# that select differently are the root's override or a conflict, which the closure walk
# already notes or refuses, and a version range is reconciled by resolution, so a
# requirer's pin of it is only a seed
use collections_vector: std.collections.vector;
use std.collections.map;
use std.collections.map.Map;
use std.collections.vector.Vector;
use std.data.toml;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.manifest;

use mach.lang.package;
use package_closure: mach.lang.package.closure;

# the first pin seen for an identity: the commit, and the gitlink that records it
rec Seen {
    commit: str;
    place:  str;
}

# one line per pin that differs from the first one seen for its identity, in closure order
# ---
# op:   the operation
# reqs: the realized closure
# out:  receives the lines, owned by `op.a`; free with `free_lines`
# ret:  err naming the first failure to read a manifest or a pin
pub fun disagreements(op: *package_closure.Operation, reqs: *Vector[package_closure.Request], out: *Vector[str]) err[fail.Fail] {
    val a:    *A.Allocator   = op.a;
    var seen: Map[str, Seen] = map.init[str, Seen](a);
    var keep: Vector[str]    = collections_vector.init[str](a);
    fin {
        var i: usize = 0;
        for (i < keep.len) {
            str_free(a, keep.data[i]);
            i = i + 1;
        }
        collections_vector.dnit[str](?keep);
        map.dnit[str, Seen](?seen);
    }

    val root_r: err[fail.Fail] = project_pins(op, op.root, ?seen, ?keep, out);
    if (sel root_r.err) { ret root_r; }
    var i: usize = 0;
    for (i < reqs.len) {
        val r: *package_closure.Request = ?reqs.data[i];
        i = i + 1;
        var dir: str = r.src_path;
        if (r.is_git) {
            val full: res[str, fail.Fail] = package.dep_full_of(a, op.root, r.id);
            if (sel full.err)             { ret err[fail.Fail].err{full.err}; }
            if (!kept(a, ?keep, full.ok)) { ret err[fail.Fail].err{package_closure.oom()}; }
            dir = full.ok;
        }
        val read_r: err[fail.Fail] = project_pins(op, dir, ?seen, ?keep, out);
        if (sel read_r.err) { ret read_r; }
    }
    ret err[fail.Fail].ok{};
}

pub fun free_lines(a: *A.Allocator, lines: *Vector[str]) {
    var i: usize = 0;
    for (i < lines.len) {
        str_free(a, lines.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](lines);
}

# take ownership of `s` so it outlives the walk; false when the list refused it
fun kept(a: *A.Allocator, keep: *Vector[str], s: str) bool {
    val pushed: res[usize, A.Error] = collections_vector.push[str](keep, s);
    if (sel pushed.err) {
        str_free(a, s);
        ret false;
    }
    ret true;
}

# the pins the project at `dir` records for the dependencies its manifest takes from git,
# each checked against the first pin seen for its identity. a project in no place that
# records pins records none
fun project_pins(op: *package_closure.Operation, dir: str, seen: *Map[str, Seen], keep: *Vector[str],
    out: *Vector[str]) err[fail.Fail] {
    val a:      *A.Allocator         = op.a;
    val inside: res[bool, fail.Fail] = op.pins.tracked(op.pins.ctx, dir);
    if (sel inside.err) { ret err[fail.Fail].err{inside.err}; }
    if (!inside.ok)     { ret err[fail.Fail].ok{}; }
    val path_r: res[str, A.Error] = types_path.join(a, dir, package_closure.MANIFEST);
    if (sel path_r.err) { ret err[fail.Fail].err{package_closure.oom()}; }
    val path: str = path_r.ok;
    fin { str_free(a, path); }
    val doc_r: res[manifest.Doc, fail.Fail] = package_closure.parse_file(a, path);
    if (sel doc_r.err) { ret err[fail.Fail].err{doc_r.err}; }
    var doc: manifest.Doc = doc_r.ok;
    fin { manifest.doc_dnit(a, ?doc); }
    val deps_o: opt[*toml.Table] = toml.get_table(?doc.table, "dep");
    if (sel deps_o.none) { ret err[fail.Fail].ok{}; }
    val deps: *toml.Table = deps_o.some;
    val n:    usize       = toml.table_len(deps);
    var i:    usize       = 0;
    for (i < n) {
        val key_o: opt[str] = toml.table_key(deps, i);
        if (sel key_o.none) { brk; }
        val key:     str              = key_o.some;
        val value_o: opt[*toml.Value] = toml.table_value(deps, i);
        if (sel value_o.none) { brk; }
        val value: *toml.Value = value_o.some;
        i = i + 1;
        if (value.tag != toml.TYPE_TABLE) { cnt; }
        val url: str = package_closure.key_text(?value.data.table, "git");
        if (str_empty(url))                                                     { cnt; }
        if (!str_empty(package_closure.key_text(?value.data.table, "version"))) { cnt; }
        val pin_r: res[opt[str], fail.Fail] = op.pins.read(op.pins.ctx, dir, key);
        if (sel pin_r.err) { ret err[fail.Fail].err{pin_r.err}; }
        val pin: opt[str] = pin_r.ok;
        if (sel pin.none) { cnt; }
        val commit: str = package_closure.own(a, pin.some);
        str_free(op.s.build_alloc, pin.some);
        if (commit == nil || !kept(a, keep, commit)) { ret err[fail.Fail].err{package_closure.oom()}; }
        val full: res[str, fail.Fail] = package.dep_full_of(a, dir, key);
        if (sel full.err)            { ret err[fail.Fail].err{full.err}; }
        if (!kept(a, keep, full.ok)) { ret err[fail.Fail].err{package_closure.oom()}; }
        val id: str = package_closure.own(a, key);
        if (id == nil || !kept(a, keep, id)) { ret err[fail.Fail].err{package_closure.oom()}; }

        val group_r: res[str, std_format.FormatError] = std_format.sprint(a, "{}\n{}\n{}", key, url, package_closure.key_text(?value.data.table, "ref"));
        if (sel group_r.err)            { ret err[fail.Fail].err{package_closure.oom()}; }
        if (!kept(a, keep, group_r.ok)) { ret err[fail.Fail].err{package_closure.oom()}; }
        val group: str        = group_r.ok;
        val first: opt[*Seen] = map.get[str, Seen](seen, ?group);
        if (sel first.none) {
            val put: res[bool, A.Error] = map.insert[str, Seen](seen, group, Seen{commit: commit, place: full.ok});
            if (sel put.err) { ret err[fail.Fail].err{package_closure.oom()}; }
            cnt;
        }
        if (str_equals(first.some.commit, commit)) { cnt; }
        val line: res[str, std_format.FormatError] = std_format.sprint(a,
            "dependency '{}' is pinned at two commits: {} at {}, and {} at {}; pin it at one commit across the closure",
            id, first.some.commit, first.some.place, commit, full.ok);
        if (sel line.err) { ret err[fail.Fail].err{package_closure.oom()}; }
        val pushed: res[usize, A.Error] = collections_vector.push[str](out, line.ok);
        if (sel pushed.err) {
            str_free(a, line.ok);
            ret err[fail.Fail].err{package_closure.oom()};
        }
    }
    ret err[fail.Fail].ok{};
}
