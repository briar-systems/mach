# list: what `mach dep list` shows: each root declaration with its winning selection, its
# pin and its state, and under it every requirement of the identity that selection overrides
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.data.toml;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.manifest;
use manifest_version: mach.lang.manifest.version;

use mach.lang.package;
use package_closure: mach.lang.package.closure;
use mach.lang.package.report;

# the lines `mach dep list` shows, appended to `out`
# ---
# op:  the operation
# out: receives one line per root declaration and one per requirement it overrides
# ret: err naming the failure
pub fun lines(op: *package_closure.Operation, out: *Vector[str]) err[fail.Fail] {
    val a:         *A.Allocator      = op.a;
    val mt_path_r: res[str, A.Error] = types_path.join(a, op.root, package_closure.MANIFEST);
    if (sel mt_path_r.err) { ret err[fail.Fail].err{package_closure.oom()}; }
    val mt_r: res[manifest.Doc, fail.Fail] = package_closure.parse_file(a, mt_path_r.ok);
    if (sel mt_r.err) { ret err[fail.Fail].err{mt_r.err}; }
    var mt: manifest.Doc = mt_r.ok;
    fin { manifest.doc_dnit(a, ?mt); }

    val deps_t_o: opt[*toml.Table] = toml.get_table(?mt.table, "dep");
    var deps_t:   *toml.Table      = nil;
    var n:        usize            = 0;
    if (sel deps_t_o.some) {
        deps_t = deps_t_o.some;
        n      = toml.table_len(deps_t);
    }
    if (n == 0) {
        collections_vector.push[str](out, "no dependencies");
        ret err[fail.Fail].ok{};
    }

    # the closure as the realized checkouts and path sources declare it
    var closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.free_requests(a, ?closure); }
    var walk:   package_closure.Walk = package_closure.Walk{offline: true, all: false, name: nil};
    val walked: err[fail.Fail]       = package_closure.preflight(op, ?mt, ?closure, true, ?walk);
    if (sel walked.err) { report.notef(op.rep, a, "note: the dependency closure could not be read, so overridden requirements are not shown: {}", fail.describe(walked.err)); }

    var i: usize = 0;
    for (i < n) {
        val key_o: opt[str] = toml.table_key(deps_t, i);
        if (sel key_o.none) { brk; }
        val key:     str              = key_o.some;
        val value_o: opt[*toml.Value] = toml.table_value(deps_t, i);
        if (sel value_o.none) { brk; }
        val value: *toml.Value = value_o.some;
        i = i + 1;
        if (value.tag != toml.TYPE_TABLE) {
            collections_vector.push[str](out, package_closure.concat3(a, "  ", key, "  (invalid)"));
            cnt;
        }
        val full_r: res[str, fail.Fail] = package.dep_full_of(a, op.root, key);
        var state:  str                 = "missing";
        if (sel full_r.ok) {
            val is_dir_r: res[bool, io_error.Error] = fs.is_dir(full_r.ok);
            if ((sel is_dir_r.ok && is_dir_r.ok)) { state = "realized"; }
        }
        var line:    str = package_closure.concat3(a, "  ", key, "");
        val git_src: str = package_closure.key_text(?value.data.table, "git");
        if (!str_empty(git_src)) {
            line = package_closure.concat3(a, line, "  git=", git_src);
            val ref: str = package_closure.key_text(?value.data.table, "ref");
            if (!str_empty(ref)) { line = package_closure.concat3(a, line, "  ref=", ref); }
            val version: str = package_closure.key_text(?value.data.table, "version");
            if (!str_empty(version)) { line = package_closure.concat3(a, line, "  version=", version); }
            val pinned_r: res[opt[str], fail.Fail] = op.pins.read(op.pins.ctx, op.root, key);
            if (sel pinned_r.ok) {
                val pinned_o: opt[str] = pinned_r.ok;
                if (sel pinned_o.some) { line = package_closure.concat3(a, line, "  pin=", pinned_o.some); }
            }
            if (sel full_r.ok) {
                if (!str_empty(version) && str_equals(state, "realized")) { state = range_state(op, key, full_r.ok, version); }
            }
        }
        or { line = package_closure.concat3(a, line, "  path=", package_closure.key_text(?value.data.table, "path")); }
        collections_vector.push[str](out, package_closure.concat3(a, line, "  ", state));
        val at: i64 = package_closure.index(?closure, key);
        if (at < 0 || !closure.data[at::usize].root_decl) { cnt; }
        val winner: *package_closure.Request = ?closure.data[at::usize];
        var k:      usize                    = 0;
        for (k < winner.overrode.len) {
            val o:    *package_closure.Overridden      = ?winner.overrode.data[k];
            val over: res[str, std_format.FormatError] = std_format.sprint(a, "    overrides {}, which requires {}", o.chain, o.asked);
            if (sel over.err) { ret err[fail.Fail].err{package_closure.oom()}; }
            collections_vector.push[str](out, over.ok);
            k = k + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

# a realized version-selected dependency's state in `mach dep list`: "realized" while its range
# admits the pinned release, and out of range, naming why, when it does not
fun range_state(op: *package_closure.Operation, id: str, dep_full: str, want: str) str {
    val rel: res[str, fail.Fail] = op.checkouts.release_at(op.checkouts.ctx, op.root, id, dep_full, false);
    if (sel rel.err) { ret "realized"; }
    if (str_empty(rel.ok)) {
        val tagged: res[bool, fail.Fail] = op.checkouts.has_releases(op.checkouts.ctx, dep_full);
        if (sel tagged.ok && !tagged.ok) { ret "release unknown (its checkout holds no tags; run `mach dep pull` to fetch them)"; }
        ret "out of range (no release tag in its checkout names the pinned commit)";
    }
    val rr: res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(want);
    val vr: res[manifest_version.Version, str]                       = manifest_version.parse_version(rel.ok);
    if (sel rr.err) { ret "realized"; }
    if (sel vr.err) { ret "realized"; }
    var r: manifest_version.Range   = rr.ok;
    var v: manifest_version.Version = vr.ok;
    if (manifest_version.satisfies(?r, ?v)) { ret "realized"; }
    val text: res[str, std_format.FormatError] = std_format.sprint(op.a, "out of range (the pinned release {} is outside {})", rel.ok, want);
    if (sel text.err) { ret "out of range"; }
    ret text.ok;
}
