# the source contract: where a dependency named by a url comes from. it has two halves,
# each a table of operations a source member fills:
#
# - Releases: the releases published at a url and the manifest each ships, which version
#   resolution reads
# - Checkouts: how dep/<id> holds a source's content: bringing it to a selection, saying what
#   it holds, and checking it against what selected it
#
# git is the member today: its releases are `v`-prefixed semver tags and its checkouts are
# submodules. a source served over http would list releases from an index and unpack a
# release archive into the same slot, filling the same two tables. a selector beyond a
# release (a `ref` naming a branch, a tag or a commit) is a source's own vocabulary, and a
# member without one refuses it
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use manifest_version: mach.lang.manifest.version;

# one release: its version (whose pre-release text borrows from `text`), the tag that
# names it and the commit it points at, all owned by the list's allocator
pub rec Release {
    version: manifest_version.Version;
    text:    str;
    tag:     str;
    commit:  str;
}

# a release's manifest as resolution reads it: `manifest` when the release is a candidate,
# and otherwise `excluded` says why it is not one, its manifest not loading or naming
# another version. the manifest is owned by the caller
pub rec Shipped {
    manifest: manifest.Manifest;
    excluded: str;
}

# every release reachable at `url`, appended to `out` in no particular order
def ListFn: fun(ptr, str, *Vector[Release]) err[fail.Fail];

# the manifest a release ships; err when the release cannot be read at all
def ShippedFn: fun(ptr, str, *Release) res[Shipped, fail.Fail];

# the version of the release at `url` whose revision is the given one, owned by the caller,
# or an owned "" when no release names it
def ReleaseOfFn: fun(ptr, str, str) res[str, fail.Fail];

# a realized copy of `url` at the directory given, which an offline listing reads from
def RememberFn: fun(ptr, str, str) err[fail.Fail];

def CloseFn: fun(ptr);

pub rec Releases {
    ctx:        ptr;
    list:       ListFn;
    shipped:    ShippedFn;
    release_of: ReleaseOfFn;
    remember:   RememberFn;
    close:      CloseFn;
}

# what acquiring dep/<id> changed
pub val REALIZED_NOTHING:     u8 = 0;
pub val REALIZED_INITIALIZED: u8 = 1;
pub val REALIZED_PINNED:      u8 = 2;
pub val REALIZED_REGISTERED:  u8 = 3;
pub val REALIZED_ADOPTED:     u8 = 4;
pub val REALIZED_CLONED:      u8 = 5;

# nothing pins the dependency and nothing holds it, so a selection by range alone has nothing to realize
pub val REALIZED_UNPINNED: u8 = 6;

# one acquisition of dep/<id>: bring it to `selector` from `url` and record its pin as the
# project records pins (`mode`, a pin.mach mode). `accept` takes an existing checkout as the
# dependency, as `mach dep add` does; `pinned_only` is a selection by range alone, which
# acquires only what a pin or an existing checkout already names
pub rec Acquisition {
    root:        str;
    id:          str;
    url:         str;
    selector:    str;
    mode:        u8;
    accept:      bool;
    offline:     bool;
    pinned_only: bool;
}

# acquire: bring dep/<id> to the acquisition, returning what changed (REALIZED_*)
def AcquireFn: fun(ptr, *Acquisition) res[u8, fail.Fail];

# revision: the revision dep/<id>'s content is at, owned by the session
def RevisionFn: fun(ptr, str) res[str, fail.Fail];

# advance: move the checkout at a directory to a selector (id, dir, selector, offline)
def AdvanceFn: fun(ptr, str, str, str, bool) err[fail.Fail];

# hydrate: give the checkout of a selection what reading its releases needs (root, id, dir,
# selector, ranged, offline); true when it fetched something
def HydrateFn: fun(ptr, str, str, str, str, bool, bool) res[bool, fail.Fail];

# selection: the revision a selector picks for the checkout at a directory (root, id, dir,
# selector, moves, offline); `moves` reads a moving selector at its fetched tip
def SelectionFn: fun(ptr, str, str, str, str, bool, bool) res[str, fail.Fail];

# manifest_of: the manifest of the checkout at a directory as it is at a revision, allocated by `a`
def ManifestOfFn: fun(ptr, *A.Allocator, str, str) res[manifest.Doc, fail.Fail];

# release_at: the release the pin of dep/<id> is (root, id, dir, fetch), "" when no release names it
def ReleaseAtFn: fun(ptr, str, str, str, bool) res[str, fail.Fail];

# at_release: whether dep/<id> is pinned at the release `version` and holds it (root, id, dir, version)
def AtReleaseFn: fun(ptr, str, str, str, str) bool;

# has_releases: whether the checkout at a directory holds what names its releases
def HasReleasesFn: fun(ptr, str) res[bool, fail.Fail];

# holds: whether a directory is a checkout of its own
def HoldsFn: fun(ptr, str) bool;

# verify: check dep/<id> against its pin and selection (alias, project root, dependency
# directory, dependency root name, declaration), returning the realized content an exact
# selector is checked against
def VerifyFn: fun(ptr, str, str, str, str, *manifest.DepDef) res[intern.StrId, fail.Fail];

# satisfies: check a requirer's selector against realized content (alias, chain, project
# root, dependency root name, the requirer's declaration, content, whether the root declares it)
def SatisfiesFn: fun(ptr, str, str, str, str, *manifest.DepDef, intern.StrId, bool) err[fail.Fail];

pub rec Checkouts {
    ctx:          ptr;
    acquire:      AcquireFn;
    revision:     RevisionFn;
    advance:      AdvanceFn;
    hydrate:      HydrateFn;
    selection:    SelectionFn;
    manifest_of:  ManifestOfFn;
    release_at:   ReleaseAtFn;
    at_release:   AtReleaseFn;
    has_releases: HasReleasesFn;
    holds:        HoldsFn;
    verify:       VerifyFn;
    satisfies:    SatisfiesFn;
    close:        CloseFn;
}

fun release_free(a: *A.Allocator, r: *Release) {
    str_free(a, r.text);
    str_free(a, r.tag);
    str_free(a, r.commit);
}

pub fun releases_free(a: *A.Allocator, list: *Vector[Release]) {
    var i: usize = 0;
    for (i < list.len) {
        release_free(a, ?list.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[Release](list);
}
