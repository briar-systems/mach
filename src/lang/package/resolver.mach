use std.allocator.arena;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_dup;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use manifest_version: mach.lang.manifest.version;

use lang_catalog: mach.lang.catalog;
use mach.lang.diagnostic;
use package_source: mach.lang.package.source;

# dependency version resolution: PubGrub (Weizenbaum 2018, as in Dart's pub)
# over finite domains. an identity's domain is its listed releases, so a set of versions is
# a bitset over them and complement is exact. the running compiler is checked per release as
# its own incompatibility, and a failure is explained from the derivation that proved it

# `who` names the requirer a diagnostic attributes a root need to: the root itself
# ("" reads as the problem's root) or the chain of a dependency that declared the
# range, since every requirer's range takes part in the root's problem
pub rec Need {
    id:    str;
    url:   str;
    range: str;
    who:   str;
}

# what a release asks for: the compiler range its manifest states ("" for none) and its
# dependencies selected by version range. `excluded` is "" for a candidate and otherwise says
# why the release is not one (its manifest does not load, or names another version): the
# release is set aside and the reason explains a failure it takes part in, while a failure to
# read the release at all is the NeedsFn's err and stops resolution
pub rec ReleaseNeeds {
    mach:     str;
    needs:    Vector[Need];
    excluded: str;
}

# fills `out` (initialized by the caller over the solve's allocator) for one release
def NeedsFn: fun(ptr, str, str, *package_source.Release, *ReleaseNeeds) err[fail.Fail];

# a preferred version, kept while it still satisfies every requirement (`update <name>`)
pub rec Lock {
    id:      str;
    version: str;
}

# fixed ids are identities the root selects itself (an exact or branch ref, or a path): the root
# overrides them, so no requirement on them takes part in resolution
pub rec Problem {
    root:        str;
    needs:       *Need;
    need_count:  u32;
    fixed:       *str;
    fixed_count: u32;
    compiler:    str;
    lowest:      bool;
    locks:       *Lock;
    lock_count:  u32;
}

pub rec Choice {
    id:      str;
    url:     str;
    tag:     str;
    commit:  str;
    version: str;
}

rec Pkg {
    id:         str;
    url:        str;
    rels:       Vector[package_source.Release];
    words:      usize;
    listed:     bool;
    list_error: str;
}

rec Term {
    pkg:      u32;
    set:      *u64;
    positive: bool;
}

def CauseKind: u8;
val C_ROOT:        CauseKind = 0;
val C_DEP:         CauseKind = 1;
val C_NO_VERSIONS: CauseKind = 2;
val C_COMPILER:    CauseKind = 3;
val C_UNLISTED:    CauseKind = 4;
val C_DERIVED:     CauseKind = 5;
val C_BASE:        CauseKind = 6;
val C_EXCLUDED:    CauseKind = 7;

rec Incompat {
    terms:   Vector[Term];
    kind:    CauseKind;
    left:    u32;
    right:   u32;
    owner:   u32;
    version: u32;
    target:  u32;
    text:    str;
    who:     str;
}

rec Assign {
    term:    Term;
    level:   u32;
    cause:   i64;
    version: i64;
}

rec Solver {
    a:        *A.Allocator;
    src:      *package_source.Releases;
    needs:    NeedsFn;
    ctx:      ptr;
    problem:  *Problem;
    compiler: manifest_version.Version;
    pkgs:     Vector[Pkg];
    incs:     Vector[Incompat];
    assigns:  Vector[Assign];
    level:    u32;
    failure:  str;
}

val NO_INCOMPAT: i64 = -1;

# add_incompat's answer for an incompatibility that can never hold and is not recorded
val VACUOUS: u32 = 0xFFFFFFFF;

fun domain(s: *Solver, p: u32) usize {
    if (p == 0) { ret 1; }
    ret s.pkgs.data[p].rels.len;
}

# a version set over package `p`: every version when `full`, none otherwise; or the
# refusal to allocate it
fun set_new(s: *Solver, p: u32, full: bool) res[*u64, fail.Fail] {
    val words: usize              = s.pkgs.data[p].words;
    val r:     res[*u64, A.Error] = A.allocate[u64](s.a, words);
    if (sel r.err) { ret res[*u64, fail.Fail].err{fail.refused(r.err)}; }
    val bits: *u64  = r.ok;
    var i:    usize = 0;
    for (i < words) {
        bits[i] = 0;
        i       = i + 1;
    }
    if (full) {
        val n: usize = domain(s, p);
        var k: usize = 0;
        for (k < n) {
            bits[k / 64] = bits[k / 64] | (1::u64 << (k % 64)::u64);
            k            = k + 1;
        }
    }
    ret res[*u64, fail.Fail].ok{bits};
}

fun set_has(bits: *u64, k: usize) bool {
    ret (bits[k / 64] & (1::u64 << (k % 64)::u64)) != 0;
}

fun set_put(bits: *u64, k: usize) {
    bits[k / 64] = bits[k / 64] | (1::u64 << (k % 64)::u64);
}

def SetOp: u8;
val OP_AND:    SetOp = 0;
val OP_OR:     SetOp = 1;
val OP_ANDNOT: SetOp = 2;

fun set_combine(s: *Solver, p: u32, x: *u64, y: *u64, op: SetOp) res[*u64, fail.Fail] {
    val made: res[*u64, fail.Fail] = set_new(s, p, false);
    if (sel made.err) { ret made; }
    val out:   *u64  = made.ok;
    val words: usize = s.pkgs.data[p].words;
    var i:     usize = 0;
    for (i < words) {
        if (op == OP_AND) { out[i] = x[i] & y[i]; }
        or (op == OP_OR)  { out[i] = x[i] | y[i]; }
        or                { out[i] = x[i] & ~y[i]; }
        i = i + 1;
    }
    ret res[*u64, fail.Fail].ok{out};
}

fun set_empty(s: *Solver, p: u32, x: *u64) bool {
    val words: usize = s.pkgs.data[p].words;
    var i:     usize = 0;
    for (i < words) {
        if (x[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun set_count(s: *Solver, p: u32, x: *u64) usize {
    var n: usize = 0;
    var k: usize = 0;
    for (k < domain(s, p)) {
        if (set_has(x, k)) { n = n + 1; }
        k = k + 1;
    }
    ret n;
}

fun set_equal(s: *Solver, p: u32, x: *u64, y: *u64) bool {
    val words: usize = s.pkgs.data[p].words;
    var i:     usize = 0;
    for (i < words) {
        if (x[i] != y[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun term_equal(s: *Solver, x: *Term, y: *Term) bool {
    ret x.pkg == y.pkg && x.positive == y.positive && set_equal(s, x.pkg, x.set, y.set);
}

# the conjunction of two terms on one package
fun term_intersect(s: *Solver, x: *Term, y: *Term) res[Term, fail.Fail] {
    var a:  *u64  = x.set;
    var b:  *u64  = y.set;
    var op: SetOp = OP_OR;
    if (x.positive && y.positive) { op = OP_AND; }
    or (x.positive)               { op = OP_ANDNOT; }
    or (y.positive) {
        a  = y.set;
        b  = x.set;
        op = OP_ANDNOT;
    }
    val set: res[*u64, fail.Fail] = set_combine(s, x.pkg, a, b, op);
    if (sel set.err) { ret res[Term, fail.Fail].err{set.err}; }
    ret res[Term, fail.Fail].ok{Term{pkg: x.pkg, set: set.ok, positive: x.positive || y.positive}};
}

# the term that package `p` takes exactly its `k`th release
fun single_term(s: *Solver, p: u32, k: usize) res[Term, fail.Fail] {
    val made: res[*u64, fail.Fail] = set_new(s, p, false);
    if (sel made.err) { ret res[Term, fail.Fail].err{made.err}; }
    set_put(made.ok, k);
    ret res[Term, fail.Fail].ok{Term{pkg: p, set: made.ok, positive: true}};
}

# the term over every version of package `p`
fun full_term(s: *Solver, p: u32, positive: bool) res[Term, fail.Fail] {
    val made: res[*u64, fail.Fail] = set_new(s, p, true);
    if (sel made.err) { ret res[Term, fail.Fail].err{made.err}; }
    ret res[Term, fail.Fail].ok{Term{pkg: p, set: made.ok, positive: positive}};
}

fun term_inverse(t: *Term) Term {
    ret Term{pkg: t.pkg, set: t.set, positive: !t.positive};
}

# a positive term over no version can never hold
fun term_void(s: *Solver, t: *Term) bool {
    ret t.positive && set_empty(s, t.pkg, t.set);
}

rec Known {
    allowed:  *u64;
    selected: bool;
}

# what the first `upto` assignments say about package `p`
fun known(s: *Solver, p: u32, upto: usize) res[Known, fail.Fail] {
    val all: res[*u64, fail.Fail] = set_new(s, p, true);
    if (sel all.err) { ret res[Known, fail.Fail].err{all.err}; }
    var k: Known = Known{allowed: all.ok, selected: false};
    var i: usize = 0;
    for (i < upto) {
        val as: *Assign = ?s.assigns.data[i];
        if (as.term.pkg == p) {
            var op: SetOp = OP_ANDNOT;
            if (as.term.positive) {
                op         = OP_AND;
                k.selected = true;
            }
            val narrowed: res[*u64, fail.Fail] = set_combine(s, p, k.allowed, as.term.set, op);
            if (sel narrowed.err) { ret res[Known, fail.Fail].err{narrowed.err}; }
            k.allowed = narrowed.ok;
        }
        i = i + 1;
    }
    ret res[Known, fail.Fail].ok{k};
}

def Relation: u8;
val REL_SATISFIED:    Relation = 0;
val REL_CONTRADICTED: Relation = 1;
val REL_OPEN:         Relation = 2;

fun relation(s: *Solver, t: *Term, k: *Known) res[Relation, fail.Fail] {
    val outside: res[*u64, fail.Fail] = set_combine(s, t.pkg, k.allowed, t.set, OP_ANDNOT);
    if (sel outside.err) { ret res[Relation, fail.Fail].err{outside.err}; }
    val inside: res[*u64, fail.Fail] = set_combine(s, t.pkg, k.allowed, t.set, OP_AND);
    if (sel inside.err) { ret res[Relation, fail.Fail].err{inside.err}; }
    val within: bool     = set_empty(s, t.pkg, outside.ok);
    val apart:  bool     = set_empty(s, t.pkg, inside.ok);
    var r:      Relation = REL_OPEN;
    if (t.positive) {
        if (k.selected && within) { r = REL_SATISFIED; }
        or (apart)                { r = REL_CONTRADICTED; }
    }
    or {
        if (apart)                { r = REL_SATISFIED; }
        or (k.selected && within) { r = REL_CONTRADICTED; }
    }
    ret res[Relation, fail.Fail].ok{r};
}

# how `t` stands against the first `upto` assignments
fun relation_at(s: *Solver, t: *Term, upto: usize) res[Relation, fail.Fail] {
    val k: res[Known, fail.Fail] = known(s, t.pkg, upto);
    if (sel k.err) { ret res[Relation, fail.Fail].err{k.err}; }
    var kn: Known = k.ok;
    ret relation(s, t, ?kn);
}

# the index of the earliest assignment after which `t` holds
fun satisfier(s: *Solver, t: *Term) res[usize, fail.Fail] {
    var i: usize = 0;
    for (i < s.assigns.len) {
        if (s.assigns.data[i].term.pkg == t.pkg) {
            val rel: res[Relation, fail.Fail] = relation_at(s, t, i + 1);
            if (sel rel.err)             { ret res[usize, fail.Fail].err{rel.err}; }
            if (rel.ok == REL_SATISFIED) { ret res[usize, fail.Fail].ok{i}; }
        }
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{s.assigns.len};
}

fun assign(s: *Solver, t: Term, cause: i64, version: i64) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[Assign](?s.assigns, Assign{term: t, level: s.level, cause: cause, version: version});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun decided(s: *Solver, p: u32) bool {
    var i: usize = 0;
    for (i < s.assigns.len) {
        if (s.assigns.data[i].term.pkg == p && s.assigns.data[i].cause == NO_INCOMPAT) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun backtrack(s: *Solver, level: u32) {
    var keep: usize = 0;
    for (keep < s.assigns.len && s.assigns.data[keep].level <= level) { keep = keep + 1; }
    collections_vector.truncate[Assign](?s.assigns, keep);
    s.level = level;
}

fun add_incompat(s: *Solver, made: res[Vector[Term], fail.Fail], kind: CauseKind, left: u32, right: u32,
    owner: u32, version: u32, target: u32, text: str, who: str) res[u32, fail.Fail] {
    if (sel made.err) { ret res[u32, fail.Fail].err{made.err}; }
    val terms: Vector[Term] = made.ok;
    # terms on one package are conjoined; a derived fact never needs the root's own term
    var merged: Vector[Term] = collections_vector.init[Term](s.a);
    var i:      usize        = 0;
    for (i < terms.len) {
        var t: Term = terms.data[i];
        # `not p in {}` always holds, so it constrains nothing
        if (!t.positive && set_empty(s, t.pkg, t.set)) {
            i = i + 1;
            cnt;
        }
        var found: bool  = false;
        var j:     usize = 0;
        for (j < merged.len) {
            if (merged.data[j].pkg == t.pkg) {
                val joined: res[Term, fail.Fail] = term_intersect(s, ?merged.data[j], ?t);
                if (sel joined.err) { ret res[u32, fail.Fail].err{joined.err}; }
                merged.data[j] = joined.ok;
                found          = true;
            }
            j = j + 1;
        }
        if (!found) {
            val p: res[usize, A.Error] = collections_vector.push[Term](?merged, t);
            if (sel p.err) { ret res[u32, fail.Fail].err{fail.refused(p.err)}; }
        }
        i = i + 1;
    }
    # a term no assignment can satisfy makes the whole incompatibility vacuous
    var v: usize = 0;
    for (v < merged.len) {
        if (term_void(s, ?merged.data[v])) { ret res[u32, fail.Fail].ok{VACUOUS}; }
        v = v + 1;
    }
    if (kind == C_DERIVED && merged.len > 1) {
        var w: usize = 0;
        var r: usize = 0;
        for (r < merged.len) {
            if (!(merged.data[r].pkg == 0 && merged.data[r].positive)) {
                merged.data[w] = merged.data[r];
                w              = w + 1;
            }
            r = r + 1;
        }
        collections_vector.truncate[Term](?merged, w);
    }
    val inc: Incompat = Incompat{terms: merged, kind: kind, left: left, right: right, owner: owner,
        version: version, target: target, text: text, who: who};
    val pushed: res[usize, A.Error] = collections_vector.push[Incompat](?s.incs, inc);
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{(pushed.ok - 1)::u32};
}

# the terms `x`, and `y` when there is one, or the failure that refused to make either or
# to hold them
fun terms_of(s: *Solver, x: res[Term, fail.Fail], y: opt[Term]) res[Vector[Term], fail.Fail] {
    if (sel x.err) { ret res[Vector[Term], fail.Fail].err{x.err}; }
    var v:     Vector[Term]        = collections_vector.init[Term](s.a);
    val first: res[usize, A.Error] = collections_vector.push[Term](?v, x.ok);
    if (sel first.err) { ret res[Vector[Term], fail.Fail].err{fail.refused(first.err)}; }
    if (sel y.some) {
        val second: res[usize, A.Error] = collections_vector.push[Term](?v, y.some);
        if (sel second.err) { ret res[Vector[Term], fail.Fail].err{fail.refused(second.err)}; }
    }
    ret res[Vector[Term], fail.Fail].ok{v};
}

# a term made in the solver, which cannot fail to make
fun made(t: Term) res[Term, fail.Fail] {
    ret res[Term, fail.Fail].ok{t};
}

val PROP_NONE:     i64 = -1;
val PROP_CONFLICT: i64 = -2;

# derive from an incompatibility all of whose terms but one hold
fun propagate_one(s: *Solver, ii: u32) res[i64, fail.Fail] {
    var open:  i64   = -1;
    val count: usize = s.incs.data[ii].terms.len;
    var t:     usize = 0;
    for (t < count) {
        val term:  *Term                    = ?s.incs.data[ii].terms.data[t];
        val rel_r: res[Relation, fail.Fail] = relation_at(s, term, s.assigns.len);
        if (sel rel_r.err) { ret res[i64, fail.Fail].err{rel_r.err}; }
        val rel: Relation = rel_r.ok;
        if (rel == REL_CONTRADICTED) { ret res[i64, fail.Fail].ok{PROP_NONE}; }
        if (rel == REL_OPEN) {
            if (open >= 0) { ret res[i64, fail.Fail].ok{PROP_NONE}; }
            open = t::i64;
        }
        t = t + 1;
    }
    if (open < 0) { ret res[i64, fail.Fail].ok{PROP_CONFLICT}; }
    val term:  Term           = s.incs.data[ii].terms.data[open::usize];
    val added: err[fail.Fail] = assign(s, term_inverse(?term), ii::i64, -1);
    if (sel added.err) { ret res[i64, fail.Fail].err{added.err}; }
    ret res[i64, fail.Fail].ok{term.pkg::i64};
}

fun mentions(s: *Solver, ii: u32, p: u32) bool {
    var t: usize = 0;
    for (t < s.incs.data[ii].terms.len) {
        if (s.incs.data[ii].terms.data[t].pkg == p) { ret true; }
        t = t + 1;
    }
    ret false;
}

fun is_failure(s: *Solver, ii: u32) bool {
    val terms: *Vector[Term] = ?s.incs.data[ii].terms;
    if (terms.len == 0) { ret true; }
    ret terms.len == 1 && terms.data[0].pkg == 0 && terms.data[0].positive;
}

# learn from a conflict until the partial solution can be repaired by backjumping
fun resolve_conflict(s: *Solver, start: u32) res[u32, fail.Fail] {
    var ii: u32 = start;
    for (true) {
        if (is_failure(s, ii)) { ret res[u32, fail.Fail].err{fail.user_of(diagnostic_kind.DEP_UNSATISFIABLE, explain(s, ii))}; }
        var recent_term: Term  = s.incs.data[ii].terms.data[0];
        var recent:      i64   = -1;
        var previous:    u32   = 1;
        var difference:  Term;
        var has_diff:    bool  = false;
        var t:           usize = 0;
        for (t < s.incs.data[ii].terms.len) {
            val term: Term                  = s.incs.data[ii].terms.data[t];
            val at_r: res[usize, fail.Fail] = satisfier(s, ?term);
            if (sel at_r.err) { ret res[u32, fail.Fail].err{at_r.err}; }
            val at: usize = at_r.ok;
            if (recent < 0) {
                recent_term = term;
                recent      = at::i64;
            }
            or (recent::usize < at) {
                if (s.assigns.data[recent::usize].level > previous) { previous = s.assigns.data[recent::usize].level; }
                recent_term = term;
                recent      = at::i64;
                has_diff    = false;
            }
            or {
                if (s.assigns.data[at].level > previous) { previous = s.assigns.data[at].level; }
            }
            if (term_equal(s, ?recent_term, ?term)) {
                val not_term: Term                 = term_inverse(?term);
                val diff_r:   res[Term, fail.Fail] = term_intersect(s, ?s.assigns.data[recent::usize].term, ?not_term);
                if (sel diff_r.err) { ret res[u32, fail.Fail].err{diff_r.err}; }
                difference = diff_r.ok;
                has_diff   = !term_void(s, ?difference);
                if (has_diff) {
                    val inv:  Term                  = term_inverse(?difference);
                    val di_r: res[usize, fail.Fail] = satisfier(s, ?inv);
                    if (sel di_r.err) { ret res[u32, fail.Fail].err{di_r.err}; }
                    val di: usize = di_r.ok;
                    if (di < s.assigns.len && s.assigns.data[di].level > previous) { previous = s.assigns.data[di].level; }
                }
            }
            t = t + 1;
        }
        val sat: *Assign = ?s.assigns.data[recent::usize];
        if (previous < sat.level || sat.cause == NO_INCOMPAT) {
            backtrack(s, previous);
            ret res[u32, fail.Fail].ok{ii};
        }
        var terms: Vector[Term] = collections_vector.init[Term](s.a);
        t = 0;
        for (t < s.incs.data[ii].terms.len) {
            val term: Term = s.incs.data[ii].terms.data[t];
            if (!term_equal(s, ?term, ?recent_term)) {
                val kept: res[usize, A.Error] = collections_vector.push[Term](?terms, term);
                if (sel kept.err) { ret res[u32, fail.Fail].err{fail.refused(kept.err)}; }
            }
            t = t + 1;
        }
        val cause: u32 = sat.cause::u32;
        t = 0;
        for (t < s.incs.data[cause].terms.len) {
            val term: Term = s.incs.data[cause].terms.data[t];
            if (term.pkg != sat.term.pkg) {
                val kept: res[usize, A.Error] = collections_vector.push[Term](?terms, term);
                if (sel kept.err) { ret res[u32, fail.Fail].err{fail.refused(kept.err)}; }
            }
            t = t + 1;
        }
        if (has_diff) {
            val kept: res[usize, A.Error] = collections_vector.push[Term](?terms, term_inverse(?difference));
            if (sel kept.err) { ret res[u32, fail.Fail].err{fail.refused(kept.err)}; }
        }
        val derived: res[u32, fail.Fail] = add_incompat(s, res[Vector[Term], fail.Fail].ok{terms}, C_DERIVED, ii, cause, 0, 0, 0, "", "");
        if (sel derived.err)       { ret derived; }
        if (derived.ok == VACUOUS) { ret res[u32, fail.Fail].err{fail.message("internal: conflict resolution derived a vacuous incompatibility")}; }
        ii = derived.ok;
    }
    ret res[u32, fail.Fail].ok{ii};
}

fun propagate(s: *Solver, first: u32) err[fail.Fail] {
    var changed: Vector[u32]         = collections_vector.init[u32](s.a);
    val seeded:  res[usize, A.Error] = collections_vector.push[u32](?changed, first);
    if (sel seeded.err) { ret err[fail.Fail].err{fail.refused(seeded.err)}; }
    for (changed.len > 0) {
        val p: u32 = changed.data[changed.len - 1];
        collections_vector.truncate[u32](?changed, changed.len - 1);
        var n: usize = s.incs.len;
        for (n > 0) {
            n = n - 1;
            if (!mentions(s, n::u32, p)) { cnt; }
            val r: res[i64, fail.Fail] = propagate_one(s, n::u32);
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
            if (r.ok == PROP_CONFLICT) {
                val root_cause: res[u32, fail.Fail] = resolve_conflict(s, n::u32);
                if (sel root_cause.err) { ret err[fail.Fail].err{root_cause.err}; }
                val again: res[i64, fail.Fail] = propagate_one(s, root_cause.ok);
                if (sel again.err) { ret err[fail.Fail].err{again.err}; }
                collections_vector.truncate[u32](?changed, 0);
                if (again.ok >= 0) {
                    val queued: res[usize, A.Error] = collections_vector.push[u32](?changed, again.ok::u32);
                    if (sel queued.err) { ret err[fail.Fail].err{fail.refused(queued.err)}; }
                }
                brk;
            }
            if (r.ok >= 0) {
                val queued: res[usize, A.Error] = collections_vector.push[u32](?changed, r.ok::u32);
                if (sel queued.err) { ret err[fail.Fail].err{fail.refused(queued.err)}; }
            }
        }
    }
    ret err[fail.Fail].ok{};
}

fun find_pkg(s: *Solver, id: str) i64 {
    var i: usize = 0;
    for (i < s.pkgs.len) {
        if (str_equals(s.pkgs.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun sort_releases(rels: *Vector[package_source.Release]) {
    var i: usize = 1;
    for (i < rels.len) {
        var j: usize = i;
        for (j > 0 && manifest_version.compare(?rels.data[j - 1].version, ?rels.data[j].version) > 0) {
            val tmp: package_source.Release = rels.data[j - 1];
            rels.data[j - 1] = rels.data[j];
            rels.data[j]     = tmp;
            j                = j - 1;
        }
        i = i + 1;
    }
}

# the package for `id`, its releases listed the first time it is seen; a listing failure is
# kept and becomes an incompatibility when the package is needed
fun package(s: *Solver, id: str, url: str) res[u32, fail.Fail] {
    val seen: i64 = find_pkg(s, id);
    if (seen >= 0) { ret res[u32, fail.Fail].ok{seen::u32}; }
    var p:      Pkg            = Pkg{id: id, url: url, rels: collections_vector.init[package_source.Release](s.a), words: 1, listed: true, list_error: ""};
    val listed: err[fail.Fail] = s.src.list(s.src.ctx, url, ?p.rels);
    if (sel listed.err) {
        p.listed     = false;
        p.list_error = fail.describe(listed.err);
        collections_vector.truncate[package_source.Release](?p.rels, 0);
    }
    sort_releases(?p.rels);
    p.words = (p.rels.len + 64) / 64;
    val pushed: res[usize, A.Error] = collections_vector.push[Pkg](?s.pkgs, p);
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{(pushed.ok - 1)::u32};
}

fun range_set(s: *Solver, p: u32, text: str, who: str) res[*u64, fail.Fail] {
    val parsed: res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(text);
    if (sel parsed.err) {
        val msg: res[str, std_format.FormatError] = std_format.sprint(s.a, "{} requires {} \"{}\": {} (clause {})",
            who, s.pkgs.data[p].id, text, parsed.err.reason, parsed.err.clause);
        if (sel msg.err) { ret res[*u64, fail.Fail].err{fail.format_refused(msg.err)}; }
        ret res[*u64, fail.Fail].err{fail.user(diagnostic_kind.VERSION_INVALID_RANGE, msg.ok)};
    }
    var r:    manifest_version.Range = parsed.ok;
    val made: res[*u64, fail.Fail]   = set_new(s, p, false);
    if (sel made.err) { ret made; }
    val bits: *u64  = made.ok;
    var k:    usize = 0;
    for (k < s.pkgs.data[p].rels.len) {
        if (manifest_version.satisfies(?r, ?s.pkgs.data[p].rels.data[k].version)) { set_put(bits, k); }
        k = k + 1;
    }
    ret res[*u64, fail.Fail].ok{bits};
}

fun is_fixed(s: *Solver, id: str) bool {
    var i: u32 = 0;
    for (i < s.problem.fixed_count) {
        if (str_equals(s.problem.fixed[i], id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun locked_index(s: *Solver, p: u32, allowed: *u64) i64 {
    var i: u32 = 0;
    for (i < s.problem.lock_count) {
        if (str_equals(s.problem.locks[i].id, s.pkgs.data[p].id)) {
            var k: usize = 0;
            for (k < s.pkgs.data[p].rels.len) {
                if (set_has(allowed, k) && str_equals(s.pkgs.data[p].rels.data[k].text, s.problem.locks[i].version)) { ret k::i64; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret -1;
}

fun needs_incompats(s: *Solver, p: u32, k: usize, rn: *ReleaseNeeds, out_conflict: *bool) err[fail.Fail] {
    val rel: *package_source.Release = ?s.pkgs.data[p].rels.data[k];
    if (!str_empty(rn.mach)) {
        val admitted: res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(rn.mach);
        var ok:       bool                                                     = false;
        if (sel admitted.ok) {
            var r: manifest_version.Range = admitted.ok;
            ok = manifest_version.satisfies(?r, ?s.compiler);
        }
        if (!ok) {
            val ci: res[u32, fail.Fail] = add_incompat(s, terms_of(s, single_term(s, p, k), opt[Term].none{}),
                C_COMPILER, 0, 0, p, k::u32, 0, rn.mach, "");
            if (sel ci.err) { ret err[fail.Fail].err{ci.err}; }
            @out_conflict = true;
            ret err[fail.Fail].ok{};
        }
    }
    var i: usize = 0;
    for (i < rn.needs.len) {
        val need: *Need = ?rn.needs.data[i];
        if (is_fixed(s, need.id)) {
            i = i + 1;
            cnt;
        }
        val dp: res[u32, fail.Fail] = package(s, need.id, need.url);
        if (sel dp.err) { ret err[fail.Fail].err{dp.err}; }
        if (!s.pkgs.data[dp.ok].listed) {
            val ui: res[u32, fail.Fail] = add_incompat(s, terms_of(s, single_term(s, p, k), opt[Term].none{}),
                C_UNLISTED, 0, 0, p, k::u32, dp.ok, s.pkgs.data[dp.ok].list_error, "");
            if (sel ui.err) { ret err[fail.Fail].err{ui.err}; }
            @out_conflict = true;
            i             = i + 1;
            cnt;
        }
        val who: res[str, std_format.FormatError] = std_format.sprint(s.a, "{} {}", s.pkgs.data[p].id, rel.text);
        if (sel who.err) { ret err[fail.Fail].err{fail.format_refused(who.err)}; }
        val set: res[*u64, fail.Fail] = range_set(s, dp.ok, need.range, who.ok);
        if (sel set.err) { ret err[fail.Fail].err{set.err}; }
        val ii: res[u32, fail.Fail] = add_incompat(s,
            terms_of(s, single_term(s, p, k), opt[Term].some{Term{pkg: dp.ok, set: set.ok, positive: false}}),
            C_DEP, 0, 0, p, k::u32, dp.ok, need.range, "");
        if (sel ii.err) { ret err[fail.Fail].err{ii.err}; }
        if (ii.ok == VACUOUS) {
            i = i + 1;
            cnt;
        }
        var all: bool  = true;
        var t:   usize = 0;
        for (t < s.incs.data[ii.ok].terms.len) {
            val term: *Term = ?s.incs.data[ii.ok].terms.data[t];
            if (term.pkg != p) {
                val rel: res[Relation, fail.Fail] = relation_at(s, term, s.assigns.len);
                if (sel rel.err)             { ret err[fail.Fail].err{rel.err}; }
                if (rel.ok != REL_SATISFIED) { all = false; }
            }
            t = t + 1;
        }
        if (all) { @out_conflict = true; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# decide one version of the most constrained package still open; -1 when all are decided
fun decide_next(s: *Solver) res[i64, fail.Fail] {
    var best:       i64   = -1;
    var best_count: usize = 0;
    var best_allow: *u64  = nil;
    var p:          u32   = 1;
    for (p < s.pkgs.len::u32) {
        val k_r: res[Known, fail.Fail] = known(s, p, s.assigns.len);
        if (sel k_r.err) { ret res[i64, fail.Fail].err{k_r.err}; }
        val k: Known = k_r.ok;
        if (k.selected && !decided(s, p)) {
            val n: usize = set_count(s, p, k.allowed);
            if (best < 0 || n < best_count) {
                best       = p::i64;
                best_count = n;
                best_allow = k.allowed;
            }
        }
        p = p + 1;
    }
    if (best < 0) { ret res[i64, fail.Fail].ok{-1}; }
    val bp: u32 = best::u32;
    if (best_count == 0) {
        val all: res[*u64, fail.Fail] = set_new(s, bp, true);
        if (sel all.err) { ret res[i64, fail.Fail].err{all.err}; }
        var pos: *u64  = all.ok;
        var i:   usize = 0;
        for (i < s.assigns.len) {
            if (s.assigns.data[i].term.pkg == bp && s.assigns.data[i].term.positive) {
                val narrowed: res[*u64, fail.Fail] = set_combine(s, bp, pos, s.assigns.data[i].term.set, OP_AND);
                if (sel narrowed.err) { ret res[i64, fail.Fail].err{narrowed.err}; }
                pos = narrowed.ok;
            }
            i = i + 1;
        }
        val ni: res[u32, fail.Fail] = add_incompat(s, terms_of(s, made(Term{pkg: bp, set: pos, positive: true}), opt[Term].none{}),
            C_NO_VERSIONS, 0, 0, bp, 0, 0, "", "");
        if (sel ni.err) { ret res[i64, fail.Fail].err{ni.err}; }
        ret res[i64, fail.Fail].ok{best};
    }
    var pick: i64 = locked_index(s, bp, best_allow);
    if (pick < 0) {
        var k: usize = 0;
        for (k < s.pkgs.data[bp].rels.len) {
            if (set_has(best_allow, k)) {
                if (s.problem.lowest) {
                    if (pick < 0) { pick = k::i64; }
                }
                or { pick = k::i64; }
            }
            k = k + 1;
        }
    }
    var rn:     ReleaseNeeds   = ReleaseNeeds{mach: "", needs: collections_vector.init[Need](s.a), excluded: ""};
    val filled: err[fail.Fail] = s.needs(s.ctx, s.pkgs.data[bp].id, s.pkgs.data[bp].url,
        ?s.pkgs.data[bp].rels.data[pick::usize], ?rn);
    if (sel filled.err) { ret res[i64, fail.Fail].err{filled.err}; }
    # a release that is no candidate is ruled out, like one the compiler refuses
    if (!str_empty(rn.excluded)) {
        val xi: res[u32, fail.Fail] = add_incompat(s, terms_of(s, single_term(s, bp, pick::usize), opt[Term].none{}),
            C_EXCLUDED, 0, 0, bp, pick::u32, 0, rn.excluded, "");
        if (sel xi.err) { ret res[i64, fail.Fail].err{xi.err}; }
        ret res[i64, fail.Fail].ok{best};
    }
    var conflict: bool           = false;
    val made:     err[fail.Fail] = needs_incompats(s, bp, pick::usize, ?rn, ?conflict);
    if (sel made.err) { ret res[i64, fail.Fail].err{made.err}; }
    if (!conflict) {
        s.level = s.level + 1;
        val chosen: res[Term, fail.Fail] = single_term(s, bp, pick::usize);
        if (sel chosen.err) { ret res[i64, fail.Fail].err{chosen.err}; }
        val d: err[fail.Fail] = assign(s, chosen.ok, NO_INCOMPAT, pick);
        if (sel d.err) { ret res[i64, fail.Fail].err{d.err}; }
    }
    ret res[i64, fail.Fail].ok{best};
}

fun describe(s: *Solver, ii: u32) res[str, fail.Fail] {
    val inc: *Incompat                        = ?s.incs.data[ii];
    var r:   res[str, std_format.FormatError] = res[str, std_format.FormatError].ok{""};
    if (inc.kind == C_ROOT) {
        r = std_format.sprint(s.a, "{} requires {} {}", inc.who, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_DEP) {
        r = std_format.sprint(s.a, "{} {} requires {} {}", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_COMPILER) {
        r = std_format.sprint(s.a, "{} {} requires mach {}, and this is mach {}", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, inc.text, s.problem.compiler);
    }
    or (inc.kind == C_UNLISTED && inc.owner == 0) {
        r = std_format.sprint(s.a, "{} requires {}, and the releases of {} cannot be listed: {}", inc.who,
            s.pkgs.data[inc.target].id, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_UNLISTED) {
        r = std_format.sprint(s.a, "{} {} requires {}, and the releases of {} cannot be listed: {}", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, s.pkgs.data[inc.target].id, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_EXCLUDED) {
        r = std_format.sprint(s.a, "{} {} is not a candidate: {}", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, inc.text);
    }
    or (inc.kind == C_NO_VERSIONS) {
        r = std_format.sprint(s.a, "no release of {} is left that every requirement accepts", s.pkgs.data[inc.owner].id);
    }
    if (sel r.err)       { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
    if (str_empty(r.ok)) { ret res[str, fail.Fail].err{lang_catalog.unknown_catalog(s.a, "CauseKind", inc.kind::u32)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

fun collect_external(s: *Solver, ii: u32, seen: *bool, lines: *Vector[str]) err[fail.Fail] {
    if (seen[ii]) { ret err[fail.Fail].ok{}; }
    seen[ii] = true;
    val inc: *Incompat = ?s.incs.data[ii];
    if (inc.kind == C_DERIVED) {
        val left: err[fail.Fail] = collect_external(s, inc.left, seen, lines);
        if (sel left.err) { ret left; }
        ret collect_external(s, inc.right, seen, lines);
    }
    val line: res[str, fail.Fail] = describe(s, ii);
    if (sel line.err) { ret err[fail.Fail].err{line.err}; }
    val pushed: res[usize, A.Error] = collections_vector.push[str](lines, line.ok);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun decider(s: *Solver, ii: u32) str {
    val inc: *Incompat = ?s.incs.data[ii];
    if (inc.kind == C_DERIVED) {
        val l: str = decider(s, inc.left);
        if (!str_empty(l)) { ret l; }
        ret decider(s, inc.right);
    }
    if (inc.kind == C_DEP || inc.kind == C_ROOT || inc.kind == C_UNLISTED)             { ret s.pkgs.data[inc.target].id; }
    if (inc.kind == C_COMPILER || inc.kind == C_NO_VERSIONS || inc.kind == C_EXCLUDED) { ret s.pkgs.data[inc.owner].id; }
    ret "";
}

fun explain(s: *Solver, ii: u32) res[str, fail.Fail] {
    val sr: res[*bool, A.Error] = A.allocate[bool](s.a, s.incs.len);
    if (sel sr.err) { ret res[str, fail.Fail].err{fail.refused(sr.err)}; }
    val seen: *bool = sr.ok;
    var i:    usize = 0;
    for (i < s.incs.len) {
        seen[i] = false;
        i       = i + 1;
    }
    var lines:     Vector[str]    = collections_vector.init[str](s.a);
    val collected: err[fail.Fail] = collect_external(s, ii, seen, ?lines);
    if (sel collected.err) { ret res[str, fail.Fail].err{collected.err}; }
    var text: str = "no set of releases satisfies every requirement:";
    i = 0;
    for (i < lines.len) {
        val r: res[str, fail.Fail] = diagnostic.format(s.a, "{}\n    {}", text, lines.data[i]);
        if (sel r.err) { ret r; }
        text = r.ok;
        i    = i + 1;
    }
    val id: str = decider(s, ii);
    if (str_empty(id)) { ret res[str, fail.Fail].ok{text}; }
    ret diagnostic.format(s.a,
        "{}\n  the root decides by declaring the identity itself, for example:\n    [dep.{}]\n    version = \"<a range the root can use>\"", text, id);
}

fun copy_out(a: *A.Allocator, text: str) res[str, fail.Fail] {
    val r: res[str, A.Error] = str_dup(a, text);
    if (sel r.err) { ret res[str, fail.Fail].err{fail.refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# the selection of one identity, its texts copied out of the solver's arena into `a`
fun choice_copy(a: *A.Allocator, pk: *Pkg, rel: *package_source.Release) res[Choice, fail.Fail] {
    val id: res[str, fail.Fail] = copy_out(a, pk.id);
    if (sel id.err) { ret res[Choice, fail.Fail].err{id.err}; }
    val url: res[str, fail.Fail] = copy_out(a, pk.url);
    if (sel url.err) { ret res[Choice, fail.Fail].err{url.err}; }
    val tag: res[str, fail.Fail] = copy_out(a, rel.tag);
    if (sel tag.err) { ret res[Choice, fail.Fail].err{tag.err}; }
    val commit: res[str, fail.Fail] = copy_out(a, rel.commit);
    if (sel commit.err) { ret res[Choice, fail.Fail].err{commit.err}; }
    val version: res[str, fail.Fail] = copy_out(a, rel.text);
    if (sel version.err) { ret res[Choice, fail.Fail].err{version.err}; }
    ret res[Choice, fail.Fail].ok{Choice{id: id.ok, url: url.ok, tag: tag.ok, commit: commit.ok, version: version.ok}};
}

# the failure with its text copied out of the solver's arena into `a`, or the
# refusal to copy it
fun text_kept(a: *A.Allocator, f: fail.Fail) fail.Fail {
    val kept: res[str, fail.Fail] = copy_out(a, fail.describe(f));
    if (sel kept.err) { ret kept.err; }
    ret fail.owning(fail.with_text(f, kept.ok));
}

# the selected release of every identity the root reaches, allocated in `a`;
# the solver's scratch arena grows from `a` and returns to it
pub fun resolve(a: *A.Allocator, src: *package_source.Releases, needs: NeedsFn, needs_ctx: ptr,
    problem: *Problem) res[Vector[Choice], fail.Fail] {
    var ar:     arena.Arena;
    val init_r: err[A.Error] = arena.init(?ar, a, 0);
    if (sel init_r.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(init_r.err)}; }
    fin { arena.dnit(?ar); }
    var sa:     A.Allocator;
    val made_a: err[A.Error] = arena.make(?sa, ?ar);
    if (sel made_a.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(made_a.err)}; }

    val compiler: res[manifest_version.Version, str] = manifest_version.parse_version(problem.compiler);
    if (sel compiler.err) { ret res[Vector[Choice], fail.Fail].err{fail.message("the compiler version does not parse")}; }
    var s: Solver = Solver{a: ?sa, src: src, needs: needs, ctx: needs_ctx, problem: problem, compiler: compiler.ok,
        pkgs: collections_vector.init[Pkg](?sa), incs: collections_vector.init[Incompat](?sa), assigns: collections_vector.init[Assign](?sa), level: 0, failure: ""};

    val root:   Pkg                 = Pkg{id: problem.root, url: "", rels: collections_vector.init[package_source.Release](?sa), words: 1, listed: true, list_error: ""};
    val rooted: res[usize, A.Error] = collections_vector.push[Pkg](?s.pkgs, root);
    if (sel rooted.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(rooted.err)}; }
    # the root must be selected
    val base: res[u32, fail.Fail] = add_incompat(?s, terms_of(?s, full_term(?s, 0, false), opt[Term].none{}),
        C_BASE, 0, 0, 0, 0, 0, "", "");
    if (sel base.err) { ret res[Vector[Choice], fail.Fail].err{base.err}; }
    var i: u32 = 0;
    for (i < problem.need_count) {
        val need: *Need               = ?problem.needs[i];
        val dp:   res[u32, fail.Fail] = package(?s, need.id, need.url);
        if (sel dp.err) { ret res[Vector[Choice], fail.Fail].err{dp.err}; }
        var who: str = need.who;
        if (str_empty(who)) { who = problem.root; }
        if (!s.pkgs.data[dp.ok].listed) {
            val ui: res[u32, fail.Fail] = add_incompat(?s, terms_of(?s, full_term(?s, 0, true), opt[Term].none{}),
                C_UNLISTED, 0, 0, 0, 0, dp.ok, s.pkgs.data[dp.ok].list_error, who);
            if (sel ui.err) { ret res[Vector[Choice], fail.Fail].err{ui.err}; }
            i = i + 1;
            cnt;
        }
        val set: res[*u64, fail.Fail] = range_set(?s, dp.ok, need.range, who);
        if (sel set.err) { ret res[Vector[Choice], fail.Fail].err{set.err}; }
        val ri: res[u32, fail.Fail] = add_incompat(?s,
            terms_of(?s, full_term(?s, 0, true), opt[Term].some{Term{pkg: dp.ok, set: set.ok, positive: false}}),
            C_ROOT, 0, 0, 0, 0, dp.ok, need.range, who);
        if (sel ri.err) { ret res[Vector[Choice], fail.Fail].err{ri.err}; }
        i = i + 1;
    }
    # the root is the first decision, so backjumping to level 1 keeps it
    s.level = 1;
    val root_term: res[Term, fail.Fail] = full_term(?s, 0, true);
    if (sel root_term.err) { ret res[Vector[Choice], fail.Fail].err{root_term.err}; }
    val root_dec: err[fail.Fail] = assign(?s, root_term.ok, NO_INCOMPAT, 0);
    if (sel root_dec.err) { ret res[Vector[Choice], fail.Fail].err{root_dec.err}; }

    var next: i64 = 0;
    for (next >= 0) {
        val prop: err[fail.Fail] = propagate(?s, next::u32);
        if (sel prop.err) { ret res[Vector[Choice], fail.Fail].err{text_kept(a, prop.err)}; }
        val chosen: res[i64, fail.Fail] = decide_next(?s);
        if (sel chosen.err) { ret res[Vector[Choice], fail.Fail].err{text_kept(a, chosen.err)}; }
        next = chosen.ok;
    }

    var out: Vector[Choice] = collections_vector.init[Choice](a);
    var j:   usize          = 0;
    for (j < s.assigns.len) {
        val as: *Assign = ?s.assigns.data[j];
        if (as.cause == NO_INCOMPAT && as.term.pkg != 0) {
            val pk:     *Pkg                    = ?s.pkgs.data[as.term.pkg];
            val rel:    *package_source.Release = ?pk.rels.data[as.version::usize];
            val choice: res[Choice, fail.Fail]  = choice_copy(a, pk, rel);
            if (sel choice.err) { ret res[Vector[Choice], fail.Fail].err{choice.err}; }
            val pushed: res[usize, A.Error] = collections_vector.push[Choice](?out, choice.ok);
            if (sel pushed.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(pushed.err)}; }
        }
        j = j + 1;
    }
    ret res[Vector[Choice], fail.Fail].ok{out};
}
