# verify: `mach dep verify`, which checks a realized closure without changing it. the
# closure is located as a build locates it, and every edge is held to its pin and selectors
# through the source's checkouts table, to the identity and flat layout rules, and to the
# release rule; a root override of a requirer's selector is reported, not refused
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.driver;
use driver_closure: mach.lang.driver.closure;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.session;

use mach.lang.package;
use package_agreement: mach.lang.package.agreement;
use package_closure:   mach.lang.package.closure;
use git_member:        mach.lang.package.git.member;
use package_path:      mach.lang.package.path;
use mach.lang.package.report;
use package_source: mach.lang.package.source;

# a requirer's selector that the root's own declaration replaced. a root `ref` or `path`
# wins over every requirer with no check that the dependency supports it; a root
# `version` intersects with the requirers' ranges instead, so it is never one
# ---
# name:      the dependency key both declarations use
# chain:     the requiring chain, ending at the dependency
# requested: the requirer's selector, as `ref = "..."`, `version = "..."` or `path = "..."`
# declared:  the root's selector, in the same form
pub rec RootOverride {
    name:      intern.StrId;
    chain:     intern.StrId;
    requested: intern.StrId;
    declared:  intern.StrId;
}

# every edge of a realized closure whose selector a root override replaced, in closure order
# ---
# s:         the session; the returned ids are interned in it
# root_m:    the root manifest
# deps:      the realized closure
# dep_count: its length
# out:       receives one RootOverride per replaced edge
fun root_overrides(s: *session.Session, root_m: *manifest.Manifest, deps: *project.DepEntry, dep_count: u32,
    out: *Vector[RootOverride]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < dep_count) {
        val requirer: *project.DepEntry = ?deps[i];
        i = i + 1;
        var k: u32 = 0;
        for (k < requirer.manifest.dep_count) {
            val asked: *manifest.DepDef = ?requirer.manifest.deps[k];
            k = k + 1;
            val root_dep: *manifest.DepDef = driver_closure.root_dependency(root_m, asked.name);
            if (root_dep == nil || !intern.str_is_nil(root_dep.version)) { cnt; }
            if (same_selector(asked, root_dep))                          { cnt; }
            val chain: res[intern.StrId, fail.Fail] = intern_formatted(s, std_format.sprint(s.build_alloc, "{} -> {}", intern.text(?s.interner, requirer.chain), intern.text(?s.interner, asked.name)));
            if (sel chain.err) { ret err[fail.Fail].err{chain.err}; }
            val requested: res[intern.StrId, fail.Fail] = selector_id(s, asked);
            if (sel requested.err) { ret err[fail.Fail].err{requested.err}; }
            val declared: res[intern.StrId, fail.Fail] = selector_id(s, root_dep);
            if (sel declared.err) { ret err[fail.Fail].err{declared.err}; }
            val pushed: res[usize, A.Error] = collections_vector.push[RootOverride](out, RootOverride{name: asked.name, chain: chain.ok,
                requested: requested.ok, declared: declared.ok});
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
    }
    ret err[fail.Fail].ok{};
}

# the note `mach dep verify` prints for one override
pub fun root_override_text(s: *session.Session, o: *RootOverride) res[str, fail.Fail] {
    ret package.override_note(s.build_alloc, intern.text(?s.interner, o.name), intern.text(?s.interner, o.declared), intern.text(?s.interner, o.chain), intern.text(?s.interner, o.requested));
}

fun same_selector(a: *manifest.DepDef, b: *manifest.DepDef) bool {
    ret intern.str_same(a.git, b.git) && intern.str_same(a.path, b.path) && intern.str_same(a.ref, b.ref) && intern.str_same(a.version, b.version);
}

fun selector_id(s: *session.Session, d: *manifest.DepDef) res[intern.StrId, fail.Fail] {
    if (!intern.str_is_nil(d.version)) { ret intern_formatted(s, std_format.sprint(s.build_alloc, "version = \"{}\"", intern.text(?s.interner, d.version))); }
    if (!intern.str_is_nil(d.ref))     { ret intern_formatted(s, std_format.sprint(s.build_alloc, "ref = \"{}\"", package.ref_of(s, d))); }
    if (!intern.str_is_nil(d.path))    { ret intern_formatted(s, std_format.sprint(s.build_alloc, "path = \"{}\"", intern.text(?s.interner, d.path))); }
    ret intern_formatted(s, std_format.sprint(s.build_alloc, "git = \"{}\"", intern.text(?s.interner, d.git)));
}

fun intern_formatted(s: *session.Session, r: res[str, std_format.FormatError]) res[intern.StrId, fail.Fail] {
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.message(fail.format_text(r.err))}; }
    val id: res[intern.StrId, A.Error] = intern.add(?s.interner, r.ok);
    str_free(s.build_alloc, r.ok);
    if (sel id.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(id.err)}; }
    ret res[intern.StrId, fail.Fail].ok{id.ok};
}

# a manifest reached through a release (a version range or a `tag/`) may itself select only
# releases, so the release is reproducible from its tag all the way down
# ---
# s:     the session
# chain: the requirer chain that reached `m`, or the root's name
# what:  how `m` was selected, as its manifest line spells it
# m:     the manifest to check
# ret:   err naming the first dependency selected by a branch, a commit or a path
fun release_selects_releases(s: *session.Session, chain: str, what: str, m: *manifest.Manifest,
    root: *manifest.Manifest) err[fail.Fail] {
    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: *manifest.DepDef = ?m.deps[i];
        i = i + 1;
        if (root != nil && driver_closure.root_dependency(root, d.name) != nil) { cnt; }
        var line_r: res[str, std_format.FormatError];
        if (intern.str_is_nil(d.git)) {
            line_r = std_format.sprint(s.build_alloc, "path = \"{}\"", intern.text(?s.interner, d.path));
        }
        or (!intern.str_is_nil(d.version) || str_starts_with(package.ref_of(s, d), "tag/")) { cnt; }
        or                                                                                  { line_r = std_format.sprint(s.build_alloc, "ref = \"{}\"", package.ref_of(s, d)); }
        if (sel line_r.err)                                                                 { ret err[fail.Fail].err{fail.format_refused(line_r.err)}; }
        val mr: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
            "{} is a release ({}), and its manifest selects [dep.{}] by {}; a release may select its dependencies only by `version` or an exact `tag/`, so it cannot be reproduced from its tag",
            chain, what, intern.text(?s.interner, d.name), line_r.ok);
        str_free(s.build_alloc, line_r.ok);
        if (sel mr.err) { ret err[fail.Fail].err{fail.format_refused(mr.err)}; }
        var remedy: res[str, std_format.FormatError];
        if (root == nil) {
            remedy = std_format.sprint(s.build_alloc, "{}; select [dep.{}] by `version` or an exact `tag/` before tagging", mr.ok, intern.text(?s.interner, d.name));
        }
        or {
            remedy = std_format.sprint(s.build_alloc,
                "{}; declare [dep.{}] in your root manifest to select it yourself, or have the dependency cut a release that selects it by `version` or an exact `tag/`",
                mr.ok, intern.text(?s.interner, d.name));
        }
        str_free(s.build_alloc, mr.ok);
        if (sel remedy.err) { ret err[fail.Fail].err{fail.format_refused(remedy.err)}; }
        ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_RELEASE_SELECTOR, remedy.ok)};
    }
    ret err[fail.Fail].ok{};
}

# how a dependency line selects its target when that target is a release ("" otherwise)
fun release_selection(s: *session.Session, d: *manifest.DepDef) res[str, fail.Fail] {
    var r: res[str, std_format.FormatError];
    if (intern.str_is_nil(d.git))      { ret res[str, fail.Fail].ok{""}; }
    if (!intern.str_is_nil(d.version)) { r = std_format.sprint(s.build_alloc, "version = \"{}\"", intern.text(?s.interner, d.version)); }
    or {
        val ref: str = package.ref_of(s, d);
        if (!str_starts_with(ref, "tag/")) { ret res[str, fail.Fail].ok{""}; }
        r = std_format.sprint(s.build_alloc, "ref = \"{}\"", ref);
    }
    if (sel r.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(r.err))}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# a release reached through `selected` selects only releases, apart from identities the root
# declares: the root's selector replaces the release's there, so the closure stays reproducible
fun edge_release_rule(s: *session.Session, chain: str, selected: *manifest.DepDef, m: *manifest.Manifest,
    root_m: *manifest.Manifest) err[fail.Fail] {
    val what: res[str, fail.Fail] = release_selection(s, selected);
    if (sel what.err)       { ret err[fail.Fail].err{what.err}; }
    if (str_empty(what.ok)) { ret err[fail.Fail].ok{}; }
    val r: err[fail.Fail] = release_selects_releases(s, chain, what.ok, m, root_m);
    str_free(s.build_alloc, what.ok);
    ret r;
}

# what `mach dep verify` holds the located closure to beyond what a build reads: each
# checkout against its pin and selectors, the identity, the flat layout and the release
# rule, through the source's checkouts table. a build locates the closure with no check
rec Verifier {
    checkouts: *package_source.Checkouts;
}

# what `mach dep verify` checks of one located dependency: its checkout against its pin
# (a source) or its contained tree (a path), its project id against its key, and no nested
# realization under it
# ---
# ret: the realized content the closure's exact selectors are checked against
fun located(ctx: ptr, s: *session.Session, alias: str, parent_root: str,
    dir_dep: str, d: *manifest.DepDef, entry: *project.DepEntry) res[intern.StrId, fail.Fail] {
    val v:         *Verifier = ctx::*Verifier;
    val dep_dir:   str       = intern.text(?s.interner, entry.vendor_root);
    var content_r: res[intern.StrId, fail.Fail];
    if (intern.str_is_nil(d.git)) { content_r = package_path.verify(s, alias, dep_dir); }
    or                            { content_r = v.checkouts.verify(v.checkouts.ctx, alias, parent_root, dep_dir, dir_dep, d); }
    if (sel content_r.err)        { ret content_r; }
    val identity: err[fail.Fail] = package.check_dep_identity(s, alias, intern.text(?s.interner, entry.project_id));
    if (sel identity.err) { ret res[intern.StrId, fail.Fail].err{identity.err}; }
    val nested: err[fail.Fail] = package.refuse_nested_realization(s, alias, dep_dir);
    if (sel nested.err) { ret res[intern.StrId, fail.Fail].err{nested.err}; }
    ret content_r;
}

fun release(ctx: ptr, s: *session.Session, chain: str, selected: *manifest.DepDef, m: *manifest.Manifest,
    root_m: *manifest.Manifest) err[fail.Fail] {
    ret edge_release_rule(s, chain, selected, m, root_m);
}

fun selector(ctx: ptr, s: *session.Session, alias: str, chain: str, project_root: str, dir_dep: str,
    d: *manifest.DepDef, content: intern.StrId, root_own: bool) err[fail.Fail] {
    val v: *Verifier = ctx::*Verifier;
    ret v.checkouts.satisfies(v.checkouts.ctx, alias, chain, project_root, dir_dep, d, content, root_own);
}

# the project's id, or `fallback` for a manifest that names no project
fun label_or(s: *session.Session, id: intern.StrId, fallback: str) str {
    if (intern.str_is_nil(id)) { ret fallback; }
    val t: str = intern.text(?s.interner, id);
    if (str_empty(t)) { ret fallback; }
    ret t;
}

# check a project's realized dependency closure without changing it
# ---
# s:            the session
# project_root: the root project's directory
# release_rule: also hold the root to the release rule: every dependency selected by
#               `version` or an exact `tag/`, as a release about to be tagged must be
# overrides:    when not nil, receives every requirer selector a root override replaced
# ret:          err naming the first mismatch
pub fun dependencies(s: *session.Session, project_root: str, release_rule: bool,
    overrides: *Vector[RootOverride]) err[fail.Fail] {
    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(s, project_root);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    var m: manifest.Manifest = mr.ok;
    fin { manifest.dnit(?m, s.build_alloc); }
    if (release_rule) {
        val who: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "project '{}'", label_or(s, m.id, project_root));
        if (sel who.err) { ret err[fail.Fail].err{fail.format_refused(who.err)}; }
        val rr: err[fail.Fail] = release_selects_releases(s, who.ok, "checked by `mach dep verify --release`", ?m, nil);
        str_free(s.build_alloc, who.ok);
        if (sel rr.err) { ret rr; }
    }
    var quiet: report.Report = report.discard(s.build_alloc);
    fin { report.dnit(?quiet); }
    val opened: res[package_source.Checkouts, fail.Fail] = git_member.checkouts(s, ?quiet);
    if (sel opened.err) { ret err[fail.Fail].err{opened.err}; }
    var checkouts: package_source.Checkouts = opened.ok;
    fin { checkouts.close(checkouts.ctx); }
    var v:        Verifier                        = Verifier{checkouts: ?checkouts};
    var check:    driver_closure.Check            = driver_closure.Check{ctx: (?v)::ptr, located: located, release: release, selector: selector};
    val realized: res[project.Project, fail.Fail] = driver.closure_checked(s, ?m, project_root, ?check);
    if (sel realized.err) { ret err[fail.Fail].err{realized.err}; }
    var p:     project.Project = realized.ok;
    var noted: err[fail.Fail]  = err[fail.Fail].ok{};
    if (overrides != nil) { noted = root_overrides(s, ?m, p.config.deps, p.config.dep_count, overrides); }
    project.dnit_project(?p);
    ret noted;
}

# `mach dep verify`: check that every dependency of a project is realized and consistent
# without changing anything. a project root that is not a repository root is verified from
# the realized checkouts, and a realized directory under dep/ outside the closure is refused,
# where pull notes and retains it; each root override of a requirer's selector is reported
# ---
# s:            the session; a failure may borrow from it, so the caller shows it before ending it
# a:            the storage the operation works in
# root:         the project root directory
# release_rule: also refuse a root dependency selected by a branch, a commit or a path
# rep:          receives each override note and every refusal past the first
# ret:          err naming the failure
pub fun project_closure(s: *session.Session, a: *A.Allocator, root: str, release_rule: bool, rep: *report.Report) err[fail.Fail] {
    val opened: res[package_closure.Operation, fail.Fail] = package_closure.open(s, a, root, rep);
    if (sel opened.err) { ret err[fail.Fail].err{opened.err}; }
    var op: package_closure.Operation = opened.ok;
    fin { package_closure.close(?op); }

    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.free_requests(a, ?reqs); }
    var overrides: Vector[RootOverride] = collections_vector.init[RootOverride](a);
    fin { collections_vector.dnit[RootOverride](?overrides); }
    val walked: err[fail.Fail] = package_closure.realize(?op, ?reqs, true, false, true, nil, nil);
    if (sel walked.err) { ret walked; }
    val checked: err[fail.Fail] = dependencies(s, root, release_rule, ?overrides);
    if (sel checked.err) { ret checked; }
    var split: Vector[str] = collections_vector.init[str](a);
    fin { package_agreement.free_lines(a, ?split); }
    val agreed: err[fail.Fail] = package_agreement.disagreements(?op, ?reqs, ?split);
    if (sel agreed.err) { ret agreed; }
    if (split.len > 0) {
        var k: usize = 1;
        for (k < split.len) {
            report.fault(rep, fail.user(diagnostic_kind.DEP_CONFLICT, split.data[k]));
            k = k + 1;
        }
        val first: res[str, fail.Fail] = fail.text_retain(?s.interner, split.data[0]);
        if (sel first.err) { ret err[fail.Fail].err{first.err}; }
        ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_CONFLICT, first.ok)};
    }
    var i: usize = 0;
    for (i < overrides.len) {
        val text: res[str, fail.Fail] = root_override_text(s, ?overrides.data[i]);
        i = i + 1;
        if (sel text.err) { ret err[fail.Fail].err{text.err}; }
        report.line(rep, text.ok);
        str_free(s.build_alloc, text.ok);
    }
    ret err[fail.Fail].ok{};
}
