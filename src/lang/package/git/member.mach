# member: git as a member of the source and pin contracts, its tables assembled from the
# parts beside it. the closure engine opens a source's tables here and works through them,
# never naming git itself
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.session;

use mach.lang.package.git;
use git_checkout: mach.lang.package.git.checkout;
use git_gitlink:  mach.lang.package.git.gitlink;
use git_tags:     mach.lang.package.git.tags;
use git_verify:   mach.lang.package.git.verify;
use package_pin:  mach.lang.package.pin;
use mach.lang.package.report;
use package_source: mach.lang.package.source;

# what the checkouts table runs git through: the session, the report its notes go to, and one
# inspector every verification shares, so a verified closure costs a constant number of git
# processes per checkout
rec Runner {
    s:   *session.Session;
    gi:  git.Inspector;
    rep: *report.Report;
}

# the checkouts table of git: dep/<id> is a submodule
# ---
# s:   the session; the table's state is allocated from it
# rep: receives the notes naming what a failure left behind
# ret: the table, released with its own `close`
pub fun checkouts(s: *session.Session, rep: *report.Report) res[package_source.Checkouts, fail.Fail] {
    val held: res[*Runner, A.Error] = A.allocate[Runner](s.build_alloc, 1);
    if (sel held.err) { ret res[package_source.Checkouts, fail.Fail].err{fail.refused(held.err)}; }
    held.ok[0] = Runner{s: s, gi: git.Inspector{program: nil}, rep: rep};
    ret res[package_source.Checkouts, fail.Fail].ok{package_source.Checkouts{ctx: held.ok::ptr, acquire: acquire, revision: revision,
        advance:    advance, hydrate: hydrate, selection: selection, manifest_of: manifest_of, release_at: release_at,
        at_release: at_release, has_releases: has_releases, holds: holds, verify: verify, satisfies: satisfies,
        close:      checkouts_close}};
}

fun checkouts_close(ctx: ptr) {
    val c: *Runner      = ctx::*Runner;
    val a: *A.Allocator = c.s.build_alloc;
    git.inspector_dnit(a, ?c.gi);
    A.deallocate[Runner](a, c, 1);
}

fun acquire(ctx: ptr, q: *package_source.Acquisition) res[u8, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.acquire(c.s, q, c.rep);
}

fun revision(ctx: ptr, dir: str) res[str, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.revision(c.s, dir);
}

fun advance(ctx: ptr, id: str, dir: str, selector: str, offline: bool) err[fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.fetch_and_checkout(c.s, id, dir, selector, offline, c.rep);
}

fun hydrate(ctx: ptr, root: str, id: str, dir: str, selector: str, ranged: bool, offline: bool) res[bool, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.fetch_selection_tags(c.s, root, id, dir, selector, ranged, offline);
}

fun selection(ctx: ptr, root: str, id: str, dir: str, selector: str, moves: bool, offline: bool) res[str, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.selection_commit(c.s, root, id, dir, selector, moves, offline);
}

fun manifest_of(ctx: ptr, a: *A.Allocator, dir: str, rev: str) res[manifest.Doc, fail.Fail] {
    ret git_checkout.manifest_at(a, dir, rev);
}

fun release_at(ctx: ptr, root: str, id: str, dir: str, fetch: bool) res[str, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.release_at_pin(c.s, root, id, dir, fetch);
}

fun at_release(ctx: ptr, root: str, id: str, dir: str, version: str) bool {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.pinned_at_release(c.s, root, id, dir, version);
}

fun has_releases(ctx: ptr, dir: str) res[bool, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.holds_tags(c.s, dir);
}

fun holds(ctx: ptr, dir: str) bool {
    val c: *Runner = ctx::*Runner;
    ret git_checkout.own_work_tree(c.s.build_alloc, dir);
}

fun verify(ctx: ptr, alias: str, root: str, dep_dir: str, dir_dep: str, d: *manifest.DepDef) res[intern.StrId, fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_verify.realized(c.s, ?c.gi, alias, root, dep_dir, dir_dep, d);
}

fun satisfies(ctx: ptr, alias: str, chain: str, root: str, dir_dep: str, d: *manifest.DepDef,
    content: intern.StrId, root_own: bool) err[fail.Fail] {
    val c: *Runner = ctx::*Runner;
    ret git_verify.requirer_selector_satisfied(c.s, ?c.gi, alias, chain, root, dir_dep, d, content, root_own);
}

# the releases table of git: a url's releases are its `v`-prefixed semver tags
# ---
# s:       the session; the table's state is allocated from it
# offline: read releases only from local checkouts the table is told of, reaching no network
# local:   a repository every url's releases are read from offline, or "" for none
# ret:     the table, released with its own `close`; err when git cannot be run
pub fun releases(s: *session.Session, offline: bool, local: str) res[package_source.Releases, fail.Fail] {
    val opened: res[git_tags.Remotes, fail.Fail] = git_tags.open(s, offline, local);
    if (sel opened.err) { ret res[package_source.Releases, fail.Fail].err{opened.err}; }
    var remotes: git_tags.Remotes                = opened.ok;
    val held:    res[*git_tags.Remotes, A.Error] = A.allocate[git_tags.Remotes](s.build_alloc, 1);
    if (sel held.err) {
        git_tags.close(?remotes);
        ret res[package_source.Releases, fail.Fail].err{fail.refused(held.err)};
    }
    held.ok[0] = remotes;
    ret res[package_source.Releases, fail.Fail].ok{package_source.Releases{ctx: held.ok::ptr, list: git_tags.releases,
        shipped: git_tags.shipped, release_of: release_of, remember: remember, close: releases_close}};
}

fun release_of(ctx: ptr, url: str, rev: str) res[str, fail.Fail] {
    ret git_tags.release_of(ctx::*git_tags.Remotes, url, rev);
}

fun remember(ctx: ptr, url: str, dir: str) err[fail.Fail] {
    ret git_tags.remember(ctx::*git_tags.Remotes, url, dir);
}

fun releases_close(ctx: ptr) {
    val r: *git_tags.Remotes = ctx::*git_tags.Remotes;
    val a: *A.Allocator      = r.s.build_alloc;
    git_tags.close(r);
    A.deallocate[git_tags.Remotes](a, r, 1);
}

# the pin table of git: a pin is the gitlink the enclosing repository stages at dep/<id>
pub fun pin(s: *session.Session) package_pin.Pin {
    ret package_pin.Pin{ctx: s::ptr, begin: begin, mode: pin_mode, read: read, read_at: read_at, tracked: tracked,
        recorded: recorded, record: record, drop: drop};
}

fun begin(ctx: ptr, root: str) err[fail.Fail] {
    ret git_gitlink.begin(ctx::*session.Session, root);
}

fun pin_mode(ctx: ptr, root: str) res[u8, fail.Fail] {
    ret git_gitlink.recording_mode(ctx::*session.Session, root);
}

fun read(ctx: ptr, root: str, id: str) res[opt[str], fail.Fail] {
    ret git_gitlink.read(ctx::*session.Session, root, id);
}

fun read_at(ctx: ptr, dir: str, rev: str, id: str) res[opt[str], fail.Fail] {
    ret git_gitlink.read_at(ctx::*session.Session, dir, rev, id);
}

fun tracked(ctx: ptr, dir: str) res[bool, fail.Fail] {
    ret git_gitlink.tracked(ctx::*session.Session, dir);
}

fun recorded(ctx: ptr, root: str, id: str, mode: u8) res[bool, fail.Fail] {
    ret git_checkout.gitlink_recorded(ctx::*session.Session, root, id, mode);
}

fun record(ctx: ptr, root: str, id: str) err[fail.Fail] {
    ret git_gitlink.record(ctx::*session.Session, root, id);
}

fun drop(ctx: ptr, root: str, id: str, mode: u8, rep: *report.Report) err[fail.Fail] {
    ret git_gitlink.drop(ctx::*session.Session, root, id, mode, rep);
}
