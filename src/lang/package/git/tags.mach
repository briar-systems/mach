# tags: the git half of the source contract that lists releases. a release is a
# `v`-prefixed semver tag at a url, listed with one `ls-remote` each; the manifest of a
# release is read from a scratch bare repository after a shallow fetch of its tag. offline,
# both come from a local repository, a realized checkout of the url, and nothing reaches
# the network
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.text.string.str_dup;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use manifest_version: mach.lang.manifest.version;
use mach.lang.session;
use lang_source: mach.lang.source;

use mach.lang.diagnostic;
use manifest_load:  mach.lang.manifest.load;
use manifest_model: mach.lang.manifest.model;
use mach.lang.package.git;
use package_source: mach.lang.package.source;

# a url's tag listing, read once per command
rec CachedListing {
    url:  str;
    text: str;
}

# offline, each url's releases come from its own local repository
rec LocalRepo {
    url: str;
    dir: str;
}

pub rec Remotes {
    s:             *session.Session;
    gi:            git.Inspector;
    listings:      Vector[CachedListing];
    locals:        Vector[LocalRepo];
    offline:       bool;
    local:         str;
    scratch:       str;
    scratch_ready: bool;
}

pub fun open(s: *session.Session, offline: bool, local: str) res[Remotes, fail.Fail] {
    val gi_r: res[git.Inspector, fail.Fail] = git.inspector_init(s.build_alloc, s.environ);
    if (sel gi_r.err) { ret res[Remotes, fail.Fail].err{gi_r.err}; }
    ret res[Remotes, fail.Fail].ok{Remotes{s: s, gi: gi_r.ok, listings: collections_vector.init[CachedListing](s.build_alloc),
        locals: collections_vector.init[LocalRepo](s.build_alloc), offline: offline, local: local, scratch: "", scratch_ready: false}};
}

# release the table; a candidate scratch that stays is the failure, once
# everything else is released
pub fun close(c: *Remotes) err[fail.Fail] {
    var out: err[fail.Fail] = err[fail.Fail].ok{};
    if (c.scratch_ready) {
        val removed: err[fs.FsError] = fs.remove_all(c.s.build_alloc, c.scratch);
        if (sel removed.err) { out = err[fail.Fail].err{fail.environment_of(diagnostic_kind.FS_REMOVE, diagnostic.format(c.s.build_alloc, "cannot remove the release candidate scratch '{}': {}", c.scratch, fail.fs_text(removed.err)))}; }
        str_free(c.s.build_alloc, c.scratch);
        c.scratch_ready = false;
    }
    var i: usize = 0;
    for (i < c.listings.len) {
        str_free(c.s.build_alloc, c.listings.data[i].url);
        str_free(c.s.build_alloc, c.listings.data[i].text);
        i = i + 1;
    }
    collections_vector.dnit[CachedListing](?c.listings);
    i = 0;
    for (i < c.locals.len) {
        str_free(c.s.build_alloc, c.locals.data[i].url);
        str_free(c.s.build_alloc, c.locals.data[i].dir);
        i = i + 1;
    }
    collections_vector.dnit[LocalRepo](?c.locals);
    git.inspector_dnit(c.s.build_alloc, ?c.gi);
    ret out;
}

# the local repository offline resolution reads `url`'s releases from; the first existing one
# named wins, so a url with no checkout yet is refused by offline_dir and not by git
pub fun remember(c: *Remotes, url: str, dir: str) err[fail.Fail] {
    if (!str_empty(local_dir_for(c, url))) { ret err[fail.Fail].ok{}; }
    val present: res[bool, io_error.Error] = fs.exists(dir);
    if (!(sel present.ok && present.ok)) { ret err[fail.Fail].ok{}; }
    val a:  *A.Allocator      = c.s.build_alloc;
    val ur: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel ur.err) { ret err[fail.Fail].err{fail.refused(ur.err)}; }
    var moved: bool = false;
    fin {
        if (!moved) { str_free(a, ur.ok); }
    }
    val dr: res[str, A.Error] = str_dup_range(a, dir, 0, str_len(dir));
    if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
    fin {
        if (!moved) { str_free(a, dr.ok); }
    }
    val pushed: res[usize, A.Error] = collections_vector.push[LocalRepo](?c.locals, LocalRepo{url: ur.ok, dir: dr.ok});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    moved = true;
    ret err[fail.Fail].ok{};
}

fun local_dir_for(c: *Remotes, url: str) str {
    var i: usize = 0;
    for (i < c.locals.len) {
        if (str_equals(c.locals.data[i].url, url)) { ret c.locals.data[i].dir; }
        i = i + 1;
    }
    ret c.local;
}

fun offline_dir(c: *Remotes, url: str) res[str, fail.Fail] {
    val dir: str = local_dir_for(c, url);
    if (str_empty(dir)) {
        val msg: res[str, std_format.FormatError] = std_format.sprint(c.s.build_alloc, "no local checkout of {} to read its releases from offline; run without --offline once", url);
        if (sel msg.err) { ret res[str, fail.Fail].err{fail.format_refused(msg.err)}; }
        ret res[str, fail.Fail].err{fail.user(diagnostic_kind.DEP_OFFLINE, msg.ok)};
    }
    ret res[str, fail.Fail].ok{dir};
}

fun is_hex_id(p: *u8, n: usize) bool {
    if (n != 40 && n != 64) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val b: u8 = p[i];
        if (!((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun release_index(out: *Vector[package_source.Release], tag: *u8, tag_len: usize) i64 {
    var i: usize = 0;
    for (i < out.len) {
        val t: str = out.data[i].tag;
        if (str_len(t) == tag_len) {
            var k: usize = 0;
            for (k < tag_len && t[k] == tag[k]) { k = k + 1; }
            if (k == tag_len) { ret i::i64; }
        }
        i = i + 1;
    }
    ret -1;
}

# one listing line, `<object id><space or tab>refs/tags/<tag>[^{}]`; a peeled line gives the
# commit an annotated tag points at and replaces the tag object's id
fun take_release_line(a: *A.Allocator, line: *u8, n: usize, out: *Vector[package_source.Release]) err[fail.Fail] {
    var sp: usize = 0;
    for (sp < n && line[sp] != ' ' && line[sp] != '\t') { sp = sp + 1; }
    if (sp == n || !is_hex_id(line, sp)) { ret err[fail.Fail].ok{}; }
    var ref_at: usize = sp;
    for (ref_at < n && (line[ref_at] == ' ' || line[ref_at] == '\t')) { ref_at = ref_at + 1; }
    val prefix: str   = "refs/tags/";
    var k:      usize = 0;
    for (k < 10) {
        if (ref_at + k >= n || line[ref_at + k] != prefix[k]) { ret err[fail.Fail].ok{}; }
        k = k + 1;
    }
    val tag_at:  usize = ref_at + 10;
    var tag_len: usize = n - tag_at;
    var peeled:  bool  = false;
    if (tag_len > 3 && line[n - 3] == '^' && line[n - 2] == '{' && line[n - 1] == '}') {
        tag_len = tag_len - 3;
        peeled  = true;
    }
    if (tag_len < 6 || line[tag_at] != 'v') { ret err[fail.Fail].ok{}; }
    val commit_r: res[str, A.Error] = str_dup_range(a, line::str, 0, sp);
    if (sel commit_r.err) { ret err[fail.Fail].err{fail.refused(commit_r.err)}; }
    var moved: bool = false;
    fin {
        if (!moved) { str_free(a, commit_r.ok); }
    }
    val seen: i64 = release_index(out, ?line[tag_at], tag_len);
    if (seen >= 0) {
        if (peeled) {
            str_free(a, out.data[seen::usize].commit);
            out.data[seen::usize].commit = commit_r.ok;
            moved                        = true;
        }
        ret err[fail.Fail].ok{};
    }
    val tag_r: res[str, A.Error] = str_dup_range(a, line::str, tag_at, tag_len);
    if (sel tag_r.err) { ret err[fail.Fail].err{fail.refused(tag_r.err)}; }
    fin {
        if (!moved) { str_free(a, tag_r.ok); }
    }
    val text_r: res[str, A.Error] = str_dup_range(a, line::str, tag_at + 1, tag_len - 1);
    if (sel text_r.err) { ret err[fail.Fail].err{fail.refused(text_r.err)}; }
    fin {
        if (!moved) { str_free(a, text_r.ok); }
    }
    val parsed: res[manifest_version.Version, str] = manifest_version.parse_version(text_r.ok);
    if (sel parsed.err) { ret err[fail.Fail].ok{}; }
    if (sel parsed.ok) {
        val pushed: res[usize, A.Error] = collections_vector.push[package_source.Release](out,
            package_source.Release{version: parsed.ok, text: text_r.ok, tag: tag_r.ok, commit: commit_r.ok});
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        moved = true;
    }
    ret err[fail.Fail].ok{};
}

pub fun releases(ctx: ptr, url: str, out: *Vector[package_source.Release]) err[fail.Fail] {
    val c:      *Remotes            = ctx::*Remotes;
    val a:      *A.Allocator        = c.s.build_alloc;
    val listed: res[str, fail.Fail] = cached_listing(c, url);
    if (sel listed.err) { ret err[fail.Fail].err{listed.err}; }
    val text: str   = listed.ok;
    val n:    usize = str_len(text);
    var at:   usize = 0;
    for (at < n) {
        var end: usize = at;
        for (end < n && text[end] != '\n') { end = end + 1; }
        val taken: err[fail.Fail] = take_release_line(a, ?text[at], end - at, out);
        if (sel taken.err) { ret taken; }
        at = end + 1;
    }
    ret err[fail.Fail].ok{};
}

# the release of `url` whose commit is `commit`, as its version text owned by the
# caller, or an owned "" when no release tag names that commit: a dependency's committed
# gitlink is a commit, and resolution deals in releases
pub fun release_of(c: *Remotes, url: str, commit: str) res[str, fail.Fail] {
    val a:    *A.Allocator                   = c.s.build_alloc;
    var rels: Vector[package_source.Release] = collections_vector.init[package_source.Release](a);
    fin { package_source.releases_free(a, ?rels); }
    val listed: err[fail.Fail] = releases((c)::ptr, url, ?rels);
    if (sel listed.err) { ret res[str, fail.Fail].err{listed.err}; }
    var i: usize = 0;
    for (i < rels.len) {
        if (str_equals(rels.data[i].commit, commit)) {
            val text: res[str, A.Error] = str_dup_range(a, rels.data[i].text, 0, str_len(rels.data[i].text));
            if (sel text.err) { ret res[str, fail.Fail].err{fail.refused(text.err)}; }
            ret res[str, fail.Fail].ok{text.ok};
        }
        i = i + 1;
    }
    val none: res[str, A.Error] = str_dup(a, "");
    if (sel none.err) { ret res[str, fail.Fail].err{fail.refused(none.err)}; }
    ret res[str, fail.Fail].ok{none.ok};
}

# the listing stays owned by the cache
fun cached_listing(c: *Remotes, url: str) res[str, fail.Fail] {
    val a: *A.Allocator = c.s.build_alloc;
    var i: usize        = 0;
    for (i < c.listings.len) {
        if (str_equals(c.listings.data[i].url, url)) { ret res[str, fail.Fail].ok{c.listings.data[i].text}; }
        i = i + 1;
    }
    var listed: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("unset")};
    if (c.offline) {
        var args: [3]str;
        args[0] = "for-each-ref";
        args[1] = "--format=%(objectname) %(refname)%0a%(*objectname) %(refname)^{}";
        args[2] = "refs/tags";
        val dir: res[str, fail.Fail] = offline_dir(c, url);
        if (sel dir.err) { ret res[str, fail.Fail].err{dir.err}; }
        listed = git.query_raw(a, ?c.gi, dir.ok, ?args[0], 3);
    }
    or {
        var args: [3]str;
        args[0] = "ls-remote";
        args[1] = "--tags";
        args[2] = url;
        listed  = git.query_raw(a, ?c.gi, ".", ?args[0], 3);
    }
    if (sel listed.err) { ret listed; }
    var cached: bool = false;
    fin {
        if (!cached) { str_free(a, listed.ok); }
    }
    val url_r: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel url_r.err) { ret res[str, fail.Fail].err{fail.refused(url_r.err)}; }
    fin {
        if (!cached) { str_free(a, url_r.ok); }
    }
    val pushed: res[usize, A.Error] = collections_vector.push[CachedListing](?c.listings, CachedListing{url: url_r.ok, text: listed.ok});
    if (sel pushed.err) { ret res[str, fail.Fail].err{fail.refused(pushed.err)}; }
    cached = true;
    ret listed;
}

fun ensure_scratch(c: *Remotes) err[fail.Fail] {
    if (c.scratch_ready) { ret err[fail.Fail].ok{}; }
    val a:    *A.Allocator                 = c.s.build_alloc;
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(a, "mach_candidates");
    if (sel tf_r.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_TEMP, fail.fs_text(tf_r.err))}; }
    var tf:    fs.TempFile         = tf_r.ok;
    val dup_r: res[str, A.Error]   = str_dup_range(a, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
    val freed: err[io_error.Error] = fs.temp_close_and_remove(?tf);
    var held:  err[fail.Fail]      = err[fail.Fail].ok{};
    if (sel freed.err) { held = err[fail.Fail].err{fail.environment_of(diagnostic_kind.FS_REMOVE, diagnostic.format(a, "cannot free the release candidate scratch name '{}': {}", fs.temp_path(?tf), fail.io_text(freed.err)))}; }
    if (sel dup_r.err) {
        if (sel held.err) { ret err[fail.Fail].err{fail.with_secondary(a, fail.refused(dup_r.err), held.err)}; }
        ret err[fail.Fail].err{fail.refused(dup_r.err)};
    }
    if (sel held.err) {
        str_free(a, dup_r.ok);
        ret held;
    }
    val made: err[fs.FsError] = fs.create_dir_all(a, dup_r.ok, 448);
    if (sel made.err) {
        str_free(a, dup_r.ok);
        ret err[fail.Fail].err{fail.environment(diagnostic_kind.FS_WRITE, fail.fs_text(made.err))};
    }
    c.scratch       = dup_r.ok;
    c.scratch_ready = true;
    var args: [3]str;
    args[0] = "init";
    args[1] = "--bare";
    args[2] = "-q";
    val init_r: res[str, fail.Fail] = git.op(a, ?c.gi, c.scratch, ?args[0], 3, nil);
    if (sel init_r.err) { ret err[fail.Fail].err{init_r.err}; }
    str_free(a, init_r.ok);
    ret err[fail.Fail].ok{};
}

fun excluded(why: str) res[package_source.Shipped, fail.Fail] {
    var out: package_source.Shipped;
    out.excluded = why;
    ret res[package_source.Shipped, fail.Fail].ok{out};
}

# why a release whose manifest failed to load is no candidate, from the load's own message
fun unloadable(a: *A.Allocator, fault: fail.Fail) res[package_source.Shipped, fail.Fail] {
    var text: str = fail.describe(fault);
    if (str_starts_with(text, "mach.toml: ")) { text = (?text[11])::str; }
    val r: res[str, fail.Fail] = diagnostic.format(a, "its mach.toml does not load: {}", text);
    if (sel r.err) { ret res[package_source.Shipped, fail.Fail].err{r.err}; }
    ret excluded(r.ok);
}

pub fun shipped(ctx: ptr, url: str, rel: *package_source.Release) res[package_source.Shipped, fail.Fail] {
    val c:   *Remotes     = ctx::*Remotes;
    val a:   *A.Allocator = c.s.build_alloc;
    var dir: str          = c.local;
    if (c.offline) {
        val od: res[str, fail.Fail] = offline_dir(c, url);
        if (sel od.err) { ret res[package_source.Shipped, fail.Fail].err{od.err}; }
        dir = od.ok;
    }
    or {
        val ready: err[fail.Fail] = ensure_scratch(c);
        if (sel ready.err) { ret res[package_source.Shipped, fail.Fail].err{ready.err}; }
        dir = c.scratch;
        val refspec_r: res[str, std_format.FormatError] = std_format.sprint(a, "+refs/tags/{}:refs/tags/{}", rel.tag, rel.tag);
        if (sel refspec_r.err) { ret res[package_source.Shipped, fail.Fail].err{fail.message(fail.format_text(refspec_r.err))}; }
        # automatic maintenance, detached after one fetch, rewrites the shallow file the next
        # fetch has read, so the throwaway scratch never maintains itself
        var args: [9]str;
        args[0] = "-c";
        args[1] = "gc.auto=0";
        args[2] = "-c";
        args[3] = "maintenance.auto=false";
        args[4] = "fetch";
        args[5] = "-q";
        args[6] = "--depth=1";
        args[7] = url;
        args[8] = refspec_r.ok;
        val fetched: res[str, fail.Fail] = git.op(a, ?c.gi, dir, ?args[0], 9, nil);
        str_free(a, refspec_r.ok);
        if (sel fetched.err) { ret res[package_source.Shipped, fail.Fail].err{fetched.err}; }
        str_free(a, fetched.ok);
    }
    val spec_r: res[str, std_format.FormatError] = std_format.sprint(a, "{}:{}", rel.commit, manifest_load.MANIFEST_FILE);
    if (sel spec_r.err) { ret res[package_source.Shipped, fail.Fail].err{fail.message(fail.format_text(spec_r.err))}; }
    var show: [2]str;
    show[0] = "show";
    show[1] = spec_r.ok;
    val shown: res[str, fail.Fail] = git.query_raw(a, ?c.gi, dir, ?show[0], 2);
    str_free(a, spec_r.ok);
    if (sel shown.err) { ret res[package_source.Shipped, fail.Fail].err{shown.err}; }
    val text: str = shown.ok;
    fin { str_free(a, text); }
    # the release's manifest is only probed, its refusal never shown, so its text lives apart
    var probed: lang_source.SourceMap = lang_source.init(a);
    fin { lang_source.dnit(?probed); }
    val doc_r: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(a, ?probed, manifest_load.MANIFEST_FILE, text);
    if (sel doc_r.err) { ret excluded("its mach.toml is not valid TOML"); }
    var doc: manifest_load.Doc = doc_r.ok;
    fin { manifest_load.doc_dnit(a, ?doc); }
    val parsed: res[manifest_model.Manifest, fail.Fail] = manifest_load.parse(a, ?c.s.interner, ?doc);
    if (sel parsed.err) { ret unloadable(a, parsed.err); }
    var m:        manifest_model.Manifest = parsed.ok;
    val declared: opt[str]                = intern.get(?c.s.interner, m.version);
    var agrees:   bool                    = false;
    if (sel declared.some) { agrees = str_equals(declared.some, rel.text); }
    if (!agrees) {
        manifest_model.dnit(?m, a);
        ret excluded("its [project].version does not match the tag");
    }
    ret res[package_source.Shipped, fail.Fail].ok{package_source.Shipped{manifest: m, excluded: ""}};
}
