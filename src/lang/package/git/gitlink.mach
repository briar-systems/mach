# gitlink: the git member of the pin contract. a dependency's pin is the gitlink the
# enclosing repository stages at dep/<id>, registered in .gitmodules with its source url;
# a project in a subdirectory of a repository records its pins under its prefix
use std_format: std.format;
use system_os:  std.system.os;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.session;

use mach.lang.package;
use mach.lang.package.git;
use package_pin: mach.lang.package.pin;
use mach.lang.package.report;

# whether `dir` lies inside a Git work tree; false for a plain directory
pub fun tracked(s: *session.Session, dir: str) res[bool, fail.Fail] {
    var gi:                    git.Inspector  = git.inspector_pending(s.environ);
    val err_inspector_require: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel err_inspector_require.err) { ret res[bool, fail.Fail].err{err_inspector_require.err}; }
    val res_inside: res[bool, fail.Fail] = git.is_work_tree(s.build_alloc, ?gi, dir);
    git.inspector_dnit(s.build_alloc, ?gi);
    ret res_inside;
}

pub fun begin(s: *session.Session, root: str) err[fail.Fail] {
    var gi:           git.Inspector  = git.inspector_pending(s.environ);
    val err_required: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel err_required.err) { ret err[fail.Fail].err{err_required.err}; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    val res_inside: res[bool, fail.Fail] = git.is_work_tree(s.build_alloc, ?gi, root);
    if (sel res_inside.err) { ret err[fail.Fail].err{res_inside.err}; }
    if (res_inside.ok)      { ret err[fail.Fail].ok{}; }
    var args:            [1]str              = [1]str{"init"};
    val res_initialized: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?args[0], 1, nil);
    if (sel res_initialized.err) { ret err[fail.Fail].err{res_initialized.err}; }
    str_free(s.build_alloc, res_initialized.ok);
    ret err[fail.Fail].ok{};
}

# record a gitlink the index already holds in .gitmodules from the manifest's source;
# `top` is the repository's top level and `rel` the gitlink's path from there
pub fun register(s: *session.Session, gi: *git.Inspector, root: str, id: str, rel: str, url: str,
    extra_env: **u8, rep: *report.Report) err[fail.Fail] {
    val err_metadata: err[fail.Fail] = git.require_matches_index(s, gi, id, root, ".gitmodules", "dependency metadata before registration");
    if (sel err_metadata.err) { ret err_metadata; }
    val res_path_key: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel res_path_key.err) { ret err[fail.Fail].err{fail.message(fail.format_text(res_path_key.err))}; }
    fin { str_free(s.build_alloc, res_path_key.ok); }
    val res_url_key: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}.url", rel);
    if (sel res_url_key.err) { ret err[fail.Fail].err{fail.message(fail.format_text(res_url_key.err))}; }
    fin { str_free(s.build_alloc, res_url_key.ok); }

    var path_args: [5]str              = [5]str{"config", "-f", ".gitmodules", res_path_key.ok, rel};
    val res_path:  res[str, fail.Fail] = git.op(s.build_alloc, gi, root, ?path_args[0], 5, extra_env);
    if (sel res_path.err) { ret err[fail.Fail].err{res_path.err}; }
    str_free(s.build_alloc, res_path.ok);
    var url_args: [5]str              = [5]str{"config", "-f", ".gitmodules", res_url_key.ok, url};
    val res_url:  res[str, fail.Fail] = git.op(s.build_alloc, gi, root, ?url_args[0], 5, extra_env);
    if (sel res_url.err) {
        report.notef(rep, s.build_alloc, ".gitmodules names dep/{} without its URL; inspect native Git state before retrying", id);
        ret err[fail.Fail].err{res_url.err};
    }
    str_free(s.build_alloc, res_url.ok);
    var stage_args: [3]str              = [3]str{"add", "--", ".gitmodules"};
    val res_stage:  res[str, fail.Fail] = git.op(s.build_alloc, gi, root, ?stage_args[0], 3, extra_env);
    if (sel res_stage.err) {
        report.notef(rep, s.build_alloc, ".gitmodules registers dep/{}; staging it failed; native state retained", id);
        ret err[fail.Fail].err{res_stage.err};
    }
    str_free(s.build_alloc, res_stage.ok);
    ret err[fail.Fail].ok{};
}

pub fun recording_mode(s: *session.Session, root: str) res[u8, fail.Fail] {
    var gi:                         git.Inspector      = git.inspector_pending(s.environ);
    val res_project_root_authority: res[u8, fail.Fail] = git.project_root_authority(s, ?gi, "project", root);
    git.inspector_dnit(s.build_alloc, ?gi);
    if (sel res_project_root_authority.err)                  { ret res[u8, fail.Fail].err{res_project_root_authority.err}; }
    if (res_project_root_authority.ok == git.AUTHORITY_REPO) { ret res[u8, fail.Fail].ok{package_pin.REPOSITORY_ROOT}; }
    ret res[u8, fail.Fail].ok{package_pin.SUBPROJECT};
}

fun parse_staged(alloc: *A.Allocator, bytes: *git.Bytes, rel: str) res[opt[str], fail.Fail] {
    var selected:     usize = 0;
    var selected_len: usize = 0;
    var start:        usize = 0;
    for (start < bytes.len) {
        var end: usize = start;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        if (end == bytes.len) { ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index record is not nul terminated")}; }
        var mode_end: usize = start;
        for (mode_end < end && bytes.data[mode_end] != ' ') { mode_end = mode_end + 1; }
        var oid_end: usize = mode_end + 1;
        for (oid_end < end && bytes.data[oid_end] != ' ') { oid_end = oid_end + 1; }
        if (mode_end == start || oid_end <= mode_end + 1 || oid_end + 3 > end ||
            bytes.data[oid_end + 1] < '0' || bytes.data[oid_end + 1] > '3' || bytes.data[oid_end + 2] != '\t') {
            ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index record has invalid mode, object, or stage fields")};
        }
        val name: str = (?bytes.data[oid_end + 3])::str;
        if (str_equals(name, rel)) {
            if (bytes.data[oid_end + 1] != '0') { ret res[opt[str], fail.Fail].err{fail.user(diagnostic_kind.DEP_INDEX_CONFLICT, "dependency index entry has unresolved conflict stages")}; }
            var i: usize = mode_end + 1;
            for (i < oid_end) {
                val c: u8 = bytes.data[i];
                if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
                    ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index object id is not hexadecimal")};
                }
                i = i + 1;
            }
            if (mode_end - start == 6 && bytes.data[start] == '1' && bytes.data[start + 1] == '6' &&
                bytes.data[start + 2] == '0' && bytes.data[start + 3] == '0' && bytes.data[start + 4] == '0' && bytes.data[start + 5] == '0') {
                if (selected_len != 0) { ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index contains duplicate dependency entries")}; }
                selected     = mode_end + 1;
                selected_len = oid_end - selected;
            }
        }
        start = end + 1;
    }
    if (selected_len == 0) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val res_copied: res[str, types_string.StrError] = str_copy_slice(alloc, (?bytes.data[selected])::str, 0, selected_len);
    if (sel res_copied.err) { ret res[opt[str], fail.Fail].err{fail.message(fail.str_text(res_copied.err))}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{res_copied.ok}};
}

pub fun read(s: *session.Session, root: str, id: str) res[opt[str], fail.Fail] {
    var gi:                    git.Inspector  = git.inspector_pending(s.environ);
    val err_inspector_require: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel err_inspector_require.err) { ret res[opt[str], fail.Fail].err{err_inspector_require.err}; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    val res_rel: res[str, fail.Fail] = package.dep_rel_of(s.build_alloc, id);
    if (sel res_rel.err) { ret res[opt[str], fail.Fail].err{res_rel.err}; }
    val rel: str = res_rel.ok;
    fin { str_free(s.build_alloc, rel); }
    var args:              [5]str                    = [5]str{"ls-files", "--stage", "-z", "--", rel};
    val res_query_capture: res[git.Bytes, fail.Fail] = git.query_capture(s.build_alloc, ?gi, root, ?args[0], 5, false, nil, system_os.INVALID_HANDLE, false);
    if (sel res_query_capture.err) { ret res[opt[str], fail.Fail].err{res_query_capture.err}; }
    var bytes: git.Bytes = res_query_capture.ok;
    fin { git.bytes_free(s.build_alloc, ?bytes); }
    ret parse_staged(s.build_alloc, ?bytes, rel);
}

# the gitlink the tree of the commit `rev` in the repository at `dir` records for dep/<id>
pub fun read_at(s: *session.Session, dir: str, rev: str, id: str) res[opt[str], fail.Fail] {
    val a:       *A.Allocator        = s.build_alloc;
    val res_rel: res[str, fail.Fail] = package.dep_rel_of(a, id);
    if (sel res_rel.err) { ret res[opt[str], fail.Fail].err{res_rel.err}; }
    val rel: str = res_rel.ok;
    fin { str_free(a, rel); }
    var gi:                    git.Inspector  = git.inspector_pending(s.environ);
    val err_inspector_require: err[fail.Fail] = git.inspector_require(a, ?gi);
    if (sel err_inspector_require.err) { ret res[opt[str], fail.Fail].err{err_inspector_require.err}; }
    fin { git.inspector_dnit(a, ?gi); }
    var args:       [4]str              = [4]str{"ls-tree", rev, "--", rel};
    val res_listed: res[str, fail.Fail] = git.query(a, ?gi, dir, ?args[0], 4);
    if (sel res_listed.err) { ret res[opt[str], fail.Fail].err{res_listed.err}; }
    val line: str = res_listed.ok;
    fin { str_free(a, line); }
    val lead: str = "160000 commit ";
    if (!str_starts_with(line, lead)) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val start: usize = str_len(lead);
    var end:   usize = start;
    val n:     usize = str_len(line);
    for (end < n && line[end] != '\t') { end = end + 1; }
    val res_oid: res[str, A.Error] = str_dup_range(a, line, start, end - start);
    if (sel res_oid.err) { ret res[opt[str], fail.Fail].err{fail.refused(res_oid.err)}; }
    if (!git.object_id_valid(res_oid.ok)) {
        str_free(a, res_oid.ok);
        ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git tree entry for a dependency has no valid object id")};
    }
    ret res[opt[str], fail.Fail].ok{opt[str].some{res_oid.ok}};
}

pub fun drop(s: *session.Session, root: str, id: str, mode: u8, rep: *report.Report) err[fail.Fail] {
    if (mode == package_pin.SUBPROJECT) { ret err[fail.Fail].ok{}; }
    val res_rel: res[str, fail.Fail] = package.dep_rel_of(s.build_alloc, id);
    if (sel res_rel.err) { ret err[fail.Fail].err{res_rel.err}; }
    val rel: str = res_rel.ok;
    fin { str_free(s.build_alloc, rel); }
    val res_selected: res[opt[str], fail.Fail] = read(s, root, id);
    if (sel res_selected.err) { ret err[fail.Fail].err{res_selected.err}; }
    val opt_gitlink: opt[str] = res_selected.ok;
    if (sel opt_gitlink.none) { ret err[fail.Fail].ok{}; }
    fin { str_free(s.build_alloc, opt_gitlink.some); }
    var gi:           git.Inspector  = git.inspector_pending(s.environ);
    val err_required: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel err_required.err) { ret err[fail.Fail].err{err_required.err}; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    val err_clean: err[fail.Fail] = git.require_matches_index(s, ?gi, id, root, ".gitmodules", "dependency metadata before removal");
    if (sel err_clean.err) { ret err[fail.Fail].err{err_clean.err}; }
    val res_key: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel res_key.err) { ret err[fail.Fail].err{fail.message(fail.format_text(res_key.err))}; }
    val key: str = res_key.ok;
    fin { str_free(s.build_alloc, key); }
    var query:       [5]str              = [5]str{"config", "-f", ".gitmodules", "--get", key};
    val res_checked: res[str, fail.Fail] = git.query(s.build_alloc, ?gi, root, ?query[0], 5);
    if (sel res_checked.err) { ret err[fail.Fail].err{res_checked.err}; }
    val registered: str = res_checked.ok;
    fin { str_free(s.build_alloc, registered); }
    if (!str_equals(registered, rel)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_GITMODULES_MISMATCH, "dependency submodule registration does not match its path")}; }

    var untrack:     [5]str                    = [5]str{"rm", "--force", "--cached", "--", rel};
    val res_removed: res[git.Bytes, fail.Fail] = git.query_capture(s.build_alloc, ?gi, root, ?untrack[0], 5, true, nil, system_os.INVALID_HANDLE, false);
    if (sel res_removed.err) {
        report.notef(rep, s.build_alloc, "dep/{} was not removed from the index; checkout retained", id);
        ret err[fail.Fail].err{res_removed.err};
    }
    var removed_output: git.Bytes = res_removed.ok;
    git.bytes_free(s.build_alloc, ?removed_output);
    val res_section: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}", rel);
    if (sel res_section.err) { ret err[fail.Fail].err{fail.message("dependency removed from the index; could not allocate its submodule section name; checkout retained")}; }
    val section: str = res_section.ok;
    fin { str_free(s.build_alloc, section); }
    var unregister:       [5]str              = [5]str{"config", "-f", ".gitmodules", "--remove-section", section};
    val res_unregistered: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?unregister[0], 5, nil);
    if (sel res_unregistered.err) { ret err[fail.Fail].err{fail.prefixed(s.build_alloc, "dependency removed from the index and checkout retained, but updating .gitmodules failed: ", res_unregistered.err)}; }
    str_free(s.build_alloc, res_unregistered.ok);
    var stage:      [3]str              = [3]str{"add", "--", ".gitmodules"};
    val res_staged: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?stage[0], 3, nil);
    if (sel res_staged.err) { ret err[fail.Fail].err{fail.prefixed(s.build_alloc, "dependency removed from the index and .gitmodules and checkout retained, but staging .gitmodules failed: ", res_staged.err)}; }
    str_free(s.build_alloc, res_staged.ok);
    ret err[fail.Fail].ok{};
}

pub fun record(s: *session.Session, root: str, id: str) err[fail.Fail] {
    val res_rel: res[str, fail.Fail] = package.dep_rel_of(s.build_alloc, id);
    if (sel res_rel.err) { ret err[fail.Fail].err{res_rel.err}; }
    val rel: str = res_rel.ok;
    fin { str_free(s.build_alloc, rel); }
    var gi:                    git.Inspector  = git.inspector_pending(s.environ);
    val err_inspector_require: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel err_inspector_require.err) { ret err_inspector_require; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    var args:   [3]str              = [3]str{"add", "--", rel};
    val res_op: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?args[0], 3, nil);
    if (sel res_op.err) { ret err[fail.Fail].err{res_op.err}; }
    str_free(s.build_alloc, res_op.ok);
    ret err[fail.Fail].ok{};
}
