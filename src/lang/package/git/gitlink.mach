# gitlink: the git member of the pin contract. a dependency's pin is the gitlink the
# enclosing repository stages at dep/<id>, registered in .gitmodules with its source url;
# a project in a subdirectory of a repository records its pins under its prefix
use std.allocator.page;
use std_format: std.format;
use system_os:  std.system.os;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.session;

use mach.lang.package;
use mach.lang.package.git;
use package_pin: mach.lang.package.pin;
use mach.lang.package.report;

# whether `dir` lies inside a Git work tree; false for a plain directory
pub fun tracked(s: *session.Session, dir: str) res[bool, fail.Fail] {
    var gi: git.Inspector  = git.inspector_pending(s.environ);
    val er: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret res[bool, fail.Fail].err{er.err}; }
    val inside: bool = git.is_work_tree(s.build_alloc, ?gi, dir);
    git.inspector_dnit(s.build_alloc, ?gi);
    ret res[bool, fail.Fail].ok{inside};
}

pub fun begin(s: *session.Session, root: str) err[fail.Fail] {
    var gi:       git.Inspector  = git.inspector_pending(s.environ);
    val required: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret err[fail.Fail].err{required.err}; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    if (git.is_work_tree(s.build_alloc, ?gi, root)) { ret err[fail.Fail].ok{}; }
    var args:        [1]str              = [1]str{"init"};
    val initialized: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?args[0], 1, nil);
    if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
    str_free(s.build_alloc, initialized.ok);
    ret err[fail.Fail].ok{};
}

# record a gitlink the index already holds in .gitmodules from the manifest's source;
# `top` is the repository's top level and `rel` the gitlink's path from there
pub fun register(s: *session.Session, gi: *git.Inspector, root: str, id: str, rel: str, url: str,
    extra_env: **u8, rep: *report.Report) err[fail.Fail] {
    val metadata: err[fail.Fail] = git.require_matches_index(s, gi, id, root, ".gitmodules", "dependency metadata before registration");
    if (sel metadata.err) { ret metadata; }
    val path_key_r: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel path_key_r.err) { ret err[fail.Fail].err{fail.message(fail.format_text(path_key_r.err))}; }
    fin { str_free(s.build_alloc, path_key_r.ok); }
    val url_key_r: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}.url", rel);
    if (sel url_key_r.err) { ret err[fail.Fail].err{fail.message(fail.format_text(url_key_r.err))}; }
    fin { str_free(s.build_alloc, url_key_r.ok); }

    var path_args: [5]str              = [5]str{"config", "-f", ".gitmodules", path_key_r.ok, rel};
    val path_r:    res[str, fail.Fail] = git.op(s.build_alloc, gi, root, ?path_args[0], 5, extra_env);
    if (sel path_r.err) { ret err[fail.Fail].err{path_r.err}; }
    str_free(s.build_alloc, path_r.ok);
    var url_args: [5]str              = [5]str{"config", "-f", ".gitmodules", url_key_r.ok, url};
    val url_r:    res[str, fail.Fail] = git.op(s.build_alloc, gi, root, ?url_args[0], 5, extra_env);
    if (sel url_r.err) {
        report.notef(rep, s.build_alloc, "note: .gitmodules names dep/{} without its URL; inspect native Git state before retrying", id);
        ret err[fail.Fail].err{url_r.err};
    }
    str_free(s.build_alloc, url_r.ok);
    var stage_args: [3]str              = [3]str{"add", "--", ".gitmodules"};
    val stage_r:    res[str, fail.Fail] = git.op(s.build_alloc, gi, root, ?stage_args[0], 3, extra_env);
    if (sel stage_r.err) {
        report.notef(rep, s.build_alloc, "note: .gitmodules registers dep/{}; staging it failed; native state retained", id);
        ret err[fail.Fail].err{stage_r.err};
    }
    str_free(s.build_alloc, stage_r.ok);
    ret err[fail.Fail].ok{};
}

pub fun recording_mode(s: *session.Session, root: str) res[u8, fail.Fail] {
    var gi: git.Inspector      = git.inspector_pending(s.environ);
    val r:  res[u8, fail.Fail] = git.project_root_authority(s, ?gi, "project", root);
    git.inspector_dnit(s.build_alloc, ?gi);
    if (sel r.err)                  { ret res[u8, fail.Fail].err{r.err}; }
    if (r.ok == git.AUTHORITY_REPO) { ret res[u8, fail.Fail].ok{package_pin.REPOSITORY_ROOT}; }
    ret res[u8, fail.Fail].ok{package_pin.SUBPROJECT};
}

fun parse_staged(alloc: *A.Allocator, bytes: *git.Bytes, rel: str) res[opt[str], fail.Fail] {
    var selected:     usize = 0;
    var selected_len: usize = 0;
    var start:        usize = 0;
    for (start < bytes.len) {
        var end: usize = start;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        if (end == bytes.len) { ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index record is not nul terminated")}; }
        var mode_end: usize = start;
        for (mode_end < end && bytes.data[mode_end] != ' ') { mode_end = mode_end + 1; }
        var oid_end: usize = mode_end + 1;
        for (oid_end < end && bytes.data[oid_end] != ' ') { oid_end = oid_end + 1; }
        if (mode_end == start || oid_end <= mode_end + 1 || oid_end + 3 > end ||
            bytes.data[oid_end + 1] < '0' || bytes.data[oid_end + 1] > '3' || bytes.data[oid_end + 2] != '\t') {
            ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index record has invalid mode, object, or stage fields")};
        }
        val name: str = (?bytes.data[oid_end + 3])::str;
        if (str_equals(name, rel)) {
            if (bytes.data[oid_end + 1] != '0') { ret res[opt[str], fail.Fail].err{fail.user(diagnostic_kind.DEP_INDEX_CONFLICT, "dependency index entry has unresolved conflict stages")}; }
            var i: usize = mode_end + 1;
            for (i < oid_end) {
                val c: u8 = bytes.data[i];
                if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
                    ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index object id is not hexadecimal")};
                }
                i = i + 1;
            }
            if (mode_end - start == 6 && bytes.data[start] == '1' && bytes.data[start + 1] == '6' &&
                bytes.data[start + 2] == '0' && bytes.data[start + 3] == '0' && bytes.data[start + 4] == '0' && bytes.data[start + 5] == '0') {
                if (selected_len != 0) { ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git index contains duplicate dependency entries")}; }
                selected     = mode_end + 1;
                selected_len = oid_end - selected;
            }
        }
        start = end + 1;
    }
    if (selected_len == 0) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val copied: res[str, types_string.StrError] = str_copy_slice(alloc, (?bytes.data[selected])::str, 0, selected_len);
    if (sel copied.err) { ret res[opt[str], fail.Fail].err{fail.message(fail.str_text(copied.err))}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{copied.ok}};
}

pub fun read(s: *session.Session, root: str, id: str) res[opt[str], fail.Fail] {
    var gi: git.Inspector  = git.inspector_pending(s.environ);
    val er: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret res[opt[str], fail.Fail].err{er.err}; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    val rel_r: res[str, fail.Fail] = package.dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret res[opt[str], fail.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(s.build_alloc, rel); }
    var args: [5]str                    = [5]str{"ls-files", "--stage", "-z", "--", rel};
    val q:    res[git.Bytes, fail.Fail] = git.query_capture(s.build_alloc, ?gi, root, ?args[0], 5, false, nil, system_os.INVALID_HANDLE, false);
    if (sel q.err) { ret res[opt[str], fail.Fail].err{q.err}; }
    var bytes: git.Bytes = q.ok;
    fin { git.bytes_free(s.build_alloc, ?bytes); }
    ret parse_staged(s.build_alloc, ?bytes, rel);
}

#[testing]
pub fun staged_paths(s: *session.Session, root: str, rel: str) res[str, fail.Fail] {
    var gi: git.Inspector  = git.inspector_pending(s.environ);
    val er: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel er.err) { ret res[str, fail.Fail].err{er.err}; }
    var args: [4]str;
    args[0] = "ls-files";
    args[1] = "--stage";
    args[2] = "--";
    args[3] = rel;
    val q: res[str, fail.Fail] = git.query_raw(s.build_alloc, ?gi, root, ?args[0], 4);
    git.inspector_dnit(s.build_alloc, ?gi);
    ret q;
}

# the gitlink the tree of the commit `rev` in the repository at `dir` records for dep/<id>
pub fun read_at(s: *session.Session, dir: str, rev: str, id: str) res[opt[str], fail.Fail] {
    val a:     *A.Allocator        = s.build_alloc;
    val rel_r: res[str, fail.Fail] = package.dep_rel_of(a, id);
    if (sel rel_r.err) { ret res[opt[str], fail.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(a, rel); }
    var gi: git.Inspector  = git.inspector_pending(s.environ);
    val er: err[fail.Fail] = git.inspector_require(a, ?gi);
    if (sel er.err) { ret res[opt[str], fail.Fail].err{er.err}; }
    fin { git.inspector_dnit(a, ?gi); }
    var args:   [4]str              = [4]str{"ls-tree", rev, "--", rel};
    val listed: res[str, fail.Fail] = git.query(a, ?gi, dir, ?args[0], 4);
    if (sel listed.err) { ret res[opt[str], fail.Fail].err{listed.err}; }
    val line: str = listed.ok;
    fin { str_free(a, line); }
    val lead: str = "160000 commit ";
    if (!str_starts_with(line, lead)) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val start: usize = str_len(lead);
    var end:   usize = start;
    val n:     usize = str_len(line);
    for (end < n && line[end] != '\t') { end = end + 1; }
    val oid: res[str, A.Error] = str_dup_range(a, line, start, end - start);
    if (sel oid.err) { ret res[opt[str], fail.Fail].err{fail.refused(oid.err)}; }
    if (!git.object_id_valid(oid.ok)) {
        str_free(a, oid.ok);
        ret res[opt[str], fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git tree entry for a dependency has no valid object id")};
    }
    ret res[opt[str], fail.Fail].ok{opt[str].some{oid.ok}};
}

pub fun drop(s: *session.Session, root: str, id: str, mode: u8, rep: *report.Report) err[fail.Fail] {
    if (mode == package_pin.SUBPROJECT) { ret err[fail.Fail].ok{}; }
    val rel_r: res[str, fail.Fail] = package.dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret err[fail.Fail].err{rel_r.err}; }
    val rel: str = rel_r.ok;
    fin { str_free(s.build_alloc, rel); }
    val selected: res[opt[str], fail.Fail] = read(s, root, id);
    if (sel selected.err) { ret err[fail.Fail].err{selected.err}; }
    val gitlink: opt[str] = selected.ok;
    if (sel gitlink.none) { ret err[fail.Fail].ok{}; }
    fin { str_free(s.build_alloc, gitlink.some); }
    var gi:       git.Inspector  = git.inspector_pending(s.environ);
    val required: err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel required.err) { ret err[fail.Fail].err{required.err}; }
    fin { git.inspector_dnit(s.build_alloc, ?gi); }
    val clean: err[fail.Fail] = git.require_matches_index(s, ?gi, id, root, ".gitmodules", "dependency metadata before removal");
    if (sel clean.err) { ret err[fail.Fail].err{clean.err}; }
    val key_r: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}.path", rel);
    if (sel key_r.err) { ret err[fail.Fail].err{fail.message(fail.format_text(key_r.err))}; }
    val key: str = key_r.ok;
    fin { str_free(s.build_alloc, key); }
    var query:   [5]str              = [5]str{"config", "-f", ".gitmodules", "--get", key};
    val checked: res[str, fail.Fail] = git.query(s.build_alloc, ?gi, root, ?query[0], 5);
    if (sel checked.err) { ret err[fail.Fail].err{checked.err}; }
    val registered: str = checked.ok;
    fin { str_free(s.build_alloc, registered); }
    if (!str_equals(registered, rel)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_GITMODULES_MISMATCH, "dependency submodule registration does not match its path")}; }

    var untrack: [5]str                    = [5]str{"rm", "--force", "--cached", "--", rel};
    val removed: res[git.Bytes, fail.Fail] = git.query_capture(s.build_alloc, ?gi, root, ?untrack[0], 5, true, nil, system_os.INVALID_HANDLE, false);
    if (sel removed.err) {
        report.notef(rep, s.build_alloc, "note: dep/{} was not removed from the index; checkout retained", id);
        ret err[fail.Fail].err{removed.err};
    }
    var removed_output: git.Bytes = removed.ok;
    git.bytes_free(s.build_alloc, ?removed_output);
    val section_r: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "submodule.{}", rel);
    if (sel section_r.err) { ret err[fail.Fail].err{fail.message("dependency removed from the index; could not allocate its submodule section name; checkout retained")}; }
    val section: str = section_r.ok;
    fin { str_free(s.build_alloc, section); }
    var unregister:   [5]str              = [5]str{"config", "-f", ".gitmodules", "--remove-section", section};
    val unregistered: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?unregister[0], 5, nil);
    if (sel unregistered.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.GIT_COMMAND, "dependency removed from the index; updating .gitmodules failed; checkout retained")}; }
    str_free(s.build_alloc, unregistered.ok);
    var stage:  [3]str              = [3]str{"add", "--", ".gitmodules"};
    val staged: res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?stage[0], 3, nil);
    if (sel staged.err) { ret err[fail.Fail].err{fail.environment(diagnostic_kind.GIT_COMMAND, "dependency removed from the index and .gitmodules; staging .gitmodules failed; checkout retained")}; }
    str_free(s.build_alloc, staged.ok);
    ret err[fail.Fail].ok{};
}

pub fun record(s: *session.Session, root: str, id: str) err[fail.Fail] {
    val rel_r: res[str, fail.Fail] = package.dep_rel_of(s.build_alloc, id);
    if (sel rel_r.err) { ret err[fail.Fail].err{rel_r.err}; }
    val rel: str            = rel_r.ok;
    var gi:  git.Inspector  = git.inspector_pending(s.environ);
    val er:  err[fail.Fail] = git.inspector_require(s.build_alloc, ?gi);
    if (sel er.err) {
        str_free(s.build_alloc, rel);
        ret er;
    }
    var args: [3]str              = [3]str{"add", "--", rel};
    val r:    res[str, fail.Fail] = git.op(s.build_alloc, ?gi, root, ?args[0], 3, nil);
    git.inspector_dnit(s.build_alloc, ?gi);
    str_free(s.build_alloc, rel);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    str_free(s.build_alloc, r.ok);
    ret err[fail.Fail].ok{};
}

test staged_gitlink__complete_object_and_exact_stage_zero_record {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val oid:       str                              = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    val formatted: res[str, std_format.FormatError] = std_format.sprint(?a,
        "100644 {} 0\tdep/a/child\n160000 {} 0\tdep/a\n", oid, oid);
    if (sel formatted.err) { ret 1; }
    val text:   str   = formatted.ok;
    val length: usize = str_len(text);
    fin { A.deallocate[u8](?a, text::*u8, length + 1); }
    var i: usize = 0;
    for (i < length) {
        if (text[i] == '\n') { text[i] = 0; }
        i = i + 1;
    }
    var bytes: git.Bytes                = git.Bytes{data: text::*u8, len: length};
    val found: res[opt[str], fail.Fail] = parse_staged(?a, ?bytes, "dep/a");
    if (sel found.err) { ret 2; }
    val selected: opt[str] = found.ok;
    if (sel selected.none) { ret 3; }
    val actual: str = selected.some;
    fin { str_free(?a, actual); }
    if (!str_equals(actual, oid)) { ret 4; }
    val sibling: res[opt[str], fail.Fail] = parse_staged(?a, ?bytes, "dep/ab");
    if (sel sibling.err)     { ret 5; }
    if (sel sibling.ok.some) { ret 5; }
    i = 0;
    for (i < length) {
        if (text[i] == '\t' && i > 0) { text[i - 1] = '2'; }
        i = i + 1;
    }
    val parse_staged_gitlink_r: res[opt[str], fail.Fail] = parse_staged(?a, ?bytes, "dep/a");
    if (sel parse_staged_gitlink_r.ok) { ret 6; }
    ret 0;
}
