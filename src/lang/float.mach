use std.math.bignum;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

pub def FloatWidth: u8;

pub val FLOAT_W_NONE: FloatWidth = 0;
pub val FLOAT_W_16:   FloatWidth = 16;
pub val FLOAT_W_32:   FloatWidth = 32;
pub val FLOAT_W_64:   FloatWidth = 64;

# the float type a width names, as its source spelling
pub fun width_name(w: FloatWidth) str {
    if (w == FLOAT_W_16) { ret "f16"; }
    if (w == FLOAT_W_32) { ret "f32"; }
    ret "f64";
}

# the width of a float `bits` wide, FLOAT_W_NONE for a width no float type has
pub fun width_of_bits(bits: u32) FloatWidth {
    if (bits == 16) { ret FLOAT_W_16; }
    if (bits == 32) { ret FLOAT_W_32; }
    if (bits == 64) { ret FLOAT_W_64; }
    ret FLOAT_W_NONE;
}

pub fun f64_bits(f: f64) u64 {
    var u: uni { f: f64; i: u64; };
    u.f = f;
    ret u.i;
}

pub fun bits_f64(bits: u64) f64 {
    var u: uni { f: f64; i: u64; };
    u.i = bits;
    ret u.f;
}

pub fun f64_neg(f: f64) f64 {
    ret bits_f64(f64_bits(f) ^ 0x8000000000000000);
}

pub fun f64_signbit(f: f64) bool {
    ret (f64_bits(f) >> 63) != 0;
}

pub fun f64_to_f32_bits(d: u64) u32 {
    val sign: u32 = ((d >> 63) & 0x1)::u32;
    val exp:  u32 = ((d >> 52) & 0x7FF)::u32;
    val mant: u64 = d & 0xFFFFFFFFFFFFF;

    if (exp == 0x7FF) {
        if (mant != 0) { ret (sign << 31) | 0x7FC00000; }
        ret (sign << 31) | 0x7F800000;
    }

    val e: i32 = exp::i32 - 1023 + 127;

    if (e >= 0xFF) { ret (sign << 31) | 0x7F800000; }

    if (e <= 0) {
        if (e < -23) { ret sign << 31; }
        val full:  u64 = mant | 0x10000000000000;
        val shift: u32 = (1 - e)::u32 + 29;
        var frac:  u32 = (full >> shift::u64)::u32;
        val rem:   u64 = full & ((1::u64 << shift::u64) - 1);
        val half:  u64 = 1::u64 << (shift - 1)::u64;
        if (rem > half || (rem == half && (frac & 0x1) != 0)) {
            frac = frac + 1;
        }
        ret (sign << 31) | frac;
    }

    var frac: u32 = (mant >> 29)::u32;
    val rem:  u64 = mant & 0x1FFFFFFF;
    val half: u64 = 0x10000000;
    var em:   u32 = e::u32;
    if (rem > half || (rem == half && (frac & 0x1) != 0)) {
        frac = frac + 1;
        if (frac == 0x800000) {
            frac = 0;
            em   = em + 1;
            if (em >= 0xFF) { ret (sign << 31) | 0x7F800000; }
        }
    }
    ret (sign << 31) | (em << 23) | frac;
}

pub fun f32_bits_to_f64_bits(s: u32) u64 {
    val sign: u64 = ((s >> 31) & 0x1)::u64;
    val exp:  u32 = (s >> 23) & 0xFF;
    val mant: u32 = s & 0x7FFFFF;

    if (exp == 0xFF) { ret (sign << 63) | 0x7FF0000000000000 | (mant::u64 << 29); }

    if (exp == 0) {
        if (mant == 0) { ret sign << 63; }
        var p: u32 = 22;
        for ((mant & (1::u32 << p)) == 0) { p = p - 1; }
        val e64: u64 = (p + 874)::u64;
        val m64: u64 = (mant::u64 << (52 - p)::u64) & 0xFFFFFFFFFFFFF;
        ret (sign << 63) | (e64 << 52) | m64;
    }

    ret (sign << 63) | ((exp + 896)::u64 << 52) | (mant::u64 << 29);
}

# `f` rounded once, to nearest with ties to even, to the format of `w`, and carried back
# exactly in an f64. binary64 holds every narrower format exactly with more than twice its
# precision plus two bits, so a `+ - * /` of two values at `w` computed in f64 and rounded
# here is the correctly rounded result at `w`
pub fun round_at(f: f64, w: FloatWidth) f64 {
    if (w == FLOAT_W_16) { ret bits_f64(widen_bits(narrow_bits(f64_bits(f), format_of(w)), format_of(w))); }
    if (w != FLOAT_W_32) { ret f; }
    ret bits_f64(f32_bits_to_f64_bits(f64_to_f32_bits(f64_bits(f))));
}

# the encoding at `w` of `v`, a value already representable at `w`: the bits `:~` reads
pub fun bits_at(v: f64, w: FloatWidth) u64 {
    if (w == FLOAT_W_16) { ret narrow_bits(f64_bits(v), format_of(w)); }
    if (w == FLOAT_W_32) { ret ((v::f32):~u32)::u64; }
    ret f64_bits(v);
}

# the value an encoding at `w` holds, carried exactly in an f64: the value `:~` makes
pub fun value_of_bits(bits: u64, w: FloatWidth) f64 {
    if (w == FLOAT_W_16) { ret bits_f64(widen_bits(bits & 0xFFFF, format_of(w))); }
    if (w == FLOAT_W_32) { ret (bits::u32):~f32::f64; }
    ret bits_f64(bits);
}

pub fun widths_agree(a: FloatWidth, b: FloatWidth) bool {
    ret a == b || a == FLOAT_W_NONE || b == FLOAT_W_NONE;
}

pub fun unify_width(a: FloatWidth, b: FloatWidth) FloatWidth {
    if (a == FLOAT_W_NONE) { ret b; }
    ret a;
}

# a binary interchange format: its significand precision, the hidden bit counted, and the
# width of its exponent field. every width a float type can take has one row in format_of
pub rec Format {
    precision: u32;
    exp_bits:  u32;
}

# the format a width names; FLOAT_W_NONE is the unsuffixed default, binary64
pub fun format_of(w: FloatWidth) Format {
    if (w == FLOAT_W_16) { ret Format{precision: 11, exp_bits: 5}; }
    if (w == FLOAT_W_32) { ret Format{precision: 24, exp_bits: 8}; }
    ret Format{precision: 53, exp_bits: 11};
}

fun format_bias(f: Format) i64 {
    ret (1::i64 << (f.exp_bits - 1)::u64) - 1;
}

# the exponent of the least significant bit of the smallest subnormal
fun format_lsb_min(f: Format) i64 {
    ret 2 - format_bias(f) - f.precision::i64;
}

pub def Fit: u8;

pub val FIT_EXACT:     Fit = 0;
pub val FIT_INEXACT:   Fit = 1;
pub val FIT_OVERFLOW:  Fit = 2;
pub val FIT_UNDERFLOW: Fit = 3;

# a decimal rounded to one format: the value, carried exactly in an f64, and how it fit.
# an overflow carries +inf and an underflow of a nonzero decimal carries +0
pub rec Rounded {
    value: f64;
    fit:   Fit;
}

fun bitlen_u64(v: u64) i64 {
    var n: i64 = 0;
    var x: u64 = v;
    for (x > 0) {
        n = n + 1;
        x = x >> 1;
    }
    ret n;
}

# q * 2^lsb as an f64, for q below 2^53 and a value inside the binary64 range
fun compose(q: u64, lsb: i64) f64 {
    if (q == 0) { ret 0.0; }
    val n:   i64 = bitlen_u64(q);
    val top: i64 = lsb + n - 1;
    if (top >= -1022) {
        val m: u64 = q << (53 - n)::u64;
        ret bits_f64(((top + 1023)::u64 << 52) | (m & 0xFFFFFFFFFFFFF));
    }
    ret bits_f64(q << (lsb + 1074)::u64);
}

# binary64 bits `d` rounded to nearest with ties to even into the encoding of `f`, a format
# narrower than binary64: a value past the largest finite overflows to infinity, one below
# the smallest normal rounds into the subnormals, and a NaN keeps its sign and the top of its
# payload with the quiet bit set, as hardware narrowing does
# ---
# d:   the binary64 encoding to narrow
# f:   the format to round into
# ret: the encoding in `f`, in the low bits
pub fun narrow_bits(d: u64, f: Format) u64 {
    val m:    u64 = (f.precision - 1)::u64;
    val emax: u64 = (1::u64 << f.exp_bits::u64) - 1;
    val sign: u64 = (d >> 63) << (f.exp_bits::u64 + m);
    val exp:  u64 = (d >> 52) & 0x7FF;
    val mant: u64 = d & 0xFFFFFFFFFFFFF;
    val inf:  u64 = sign | (emax << m);

    if (exp == 0x7FF) {
        if (mant == 0) { ret inf; }
        ret inf | (1::u64 << (m - 1)) | (mant >> (52 - m));
    }
    # a binary64 subnormal lies below half the narrower format's smallest subnormal
    if (exp == 0) { ret sign; }

    val sig: u64 = mant | 0x10000000000000;
    var e:   i64 = exp::i64 - 1023 + format_bias(f);
    var s:   i64 = (52 - m)::i64;
    if (e <= 0) { s = s + 1 - e; }
    # below half the smallest subnormal: rounds to zero
    if (s > 53) { ret sign; }

    var q:    u64 = sig >> s::u64;
    val rem:  u64 = sig & ((1::u64 << s::u64) - 1);
    val half: u64 = 1::u64 << (s - 1)::u64;
    if (rem > half || (rem == half && (q & 1) != 0)) { q = q + 1; }

    # a subnormal that rounds up to 2^m is the smallest normal, which its encoding already spells
    if (e <= 0) { ret sign | q; }
    if (q == 1::u64 << (m + 1)) {
        q = q >> 1;
        e = e + 1;
    }
    if (e::u64 >= emax) { ret inf; }
    ret sign | (e::u64 << m) | (q & ((1::u64 << m) - 1));
}

# an encoding of `f`, a format narrower than binary64, as binary64 bits: exact, a subnormal
# normalised and a NaN's payload kept in its top bits
# ---
# b:   the encoding in `f`, in the low bits
# f:   the format it is encoded in
# ret: the same value as binary64 bits
pub fun widen_bits(b: u64, f: Format) u64 {
    val m:    u64 = (f.precision - 1)::u64;
    val emax: u64 = (1::u64 << f.exp_bits::u64) - 1;
    val sign: u64 = ((b >> (f.exp_bits::u64 + m)) & 1) << 63;
    val exp:  u64 = (b >> m) & emax;
    val mant: u64 = b & ((1::u64 << m) - 1);

    if (exp == emax) { ret sign | 0x7FF0000000000000 | (mant << (52 - m)); }
    if (exp == 0) {
        if (mant == 0) { ret sign; }
        val top: i64 = bitlen_u64(mant) - 1;
        val e64: i64 = top - m::i64 + 1 - format_bias(f) + 1023;
        ret sign | (e64::u64 << 52) | ((mant << (52 - top)::u64) & 0xFFFFFFFFFFFFF);
    }
    ret sign | ((exp::i64 - format_bias(f) + 1023)::u64 << 52) | (mant << (52 - m));
}

fun cmp_ratio_pow2(num: *bignum.Big, den: *bignum.Big, p: i64) i64 {
    var a: bignum.Big;
    var b: bignum.Big;
    bignum.copy(?a, num);
    bignum.copy(?b, den);
    if (p >= 0) { bignum.shl(?b, p::usize); }
    or          { bignum.shl(?a, (0 - p)::usize); }
    ret bignum.cmp(?a, ?b);
}

fun rounded(value: f64, fit: Fit) Rounded {
    var r: Rounded;
    r.value = value;
    r.fit   = fit;
    ret r;
}

# round mant * 10^exp10 straight to the format of `w`, to nearest with ties to even, in
# exact arithmetic. `trunc` says digits past mant were dropped and at least one was nonzero,
# so the true value lies just above mant * 10^exp10
# ---
# mant:  the significant digits as an integer
# exp10: the decimal exponent of mant's last digit
# trunc: a nonzero digit was dropped past mant
# w:     the width to round to
# ret:   the rounded value and whether it was exact, inexact, or left the format's range
pub fun round_decimal(mant: *bignum.Big, exp10: i64, trunc: bool, w: FloatWidth) Rounded {
    if (bignum.is_zero(mant)) { ret rounded(0.0, FIT_EXACT); }

    val fmt:     Format = format_of(w);
    val p:       i64    = fmt.precision::i64;
    val lsb_min: i64    = format_lsb_min(fmt);
    val inf:     f64    = bits_f64(0x7FF0000000000000);

    val approx: i64 = exp10 + (bignum.bitlen(mant)::i64 * 1233) / 4096;
    if (approx > 320)  { ret rounded(inf, FIT_OVERFLOW); }
    if (approx < -340) { ret rounded(0.0, FIT_UNDERFLOW); }

    var num: bignum.Big;
    var den: bignum.Big;
    bignum.copy(?num, mant);
    bignum.from_u64(?den, 1);
    if (exp10 >= 0) { bignum.mul_pow10(?num, exp10::usize); }
    or              { bignum.mul_pow10(?den, (0 - exp10)::usize); }

    var e2:   i64  = bignum.bitlen(?num)::i64 - bignum.bitlen(?den)::i64 - p;
    var done: bool = false;
    for (!done) {
        if (cmp_ratio_pow2(?num, ?den, e2 + p) >= 0) {
            e2 = e2 + 1;
            cnt;
        }
        if (cmp_ratio_pow2(?num, ?den, e2 + p - 1) < 0) {
            e2 = e2 - 1;
            cnt;
        }
        done = true;
    }

    var lsb: i64 = e2;
    if (lsb < lsb_min) { lsb = lsb_min; }

    var nn: bignum.Big;
    var dd: bignum.Big;
    bignum.copy(?nn, ?num);
    bignum.copy(?dd, ?den);
    if (lsb >= 0) { bignum.shl(?dd, lsb::usize); }
    or            { bignum.shl(?nn, (0 - lsb)::usize); }

    var q:   u64 = 0;
    var rem: bignum.Big;
    bignum.copy(?rem, ?nn);
    var b: i64 = p;
    for (b >= 0) {
        var t: bignum.Big;
        bignum.copy(?t, ?dd);
        bignum.shl(?t, b::usize);
        if (bignum.cmp(?rem, ?t) >= 0) {
            bignum.sub(?rem, ?t);
            q = q | (1::u64 << b::u64);
        }
        b = b - 1;
    }

    val exact: bool = bignum.is_zero(?rem) && !trunc;
    var rem2:  bignum.Big;
    bignum.copy(?rem2, ?rem);
    bignum.shl(?rem2, 1);
    val c: i64 = bignum.cmp(?rem2, ?dd);
    if (c > 0) { q = q + 1; }
    or (c == 0) {
        if (trunc)        { q = q + 1; }
        or ((q & 1) == 1) { q = q + 1; }
    }

    if (q == 1::u64 << p::u64) {
        q   = 1::u64 << (p - 1)::u64;
        lsb = lsb + 1;
    }
    if (q == 0)                                     { ret rounded(0.0, FIT_UNDERFLOW); }
    if (lsb + bitlen_u64(q) - 1 > format_bias(fmt)) { ret rounded(inf, FIT_OVERFLOW); }
    if (exact)                                      { ret rounded(compose(q, lsb), FIT_EXACT); }
    ret rounded(compose(q, lsb), FIT_INEXACT);
}

pub val SHORTEST_DIGITS: usize = 20;

# the shortest decimal that rounds back to a value in its format: digit values 0..9, and the
# exponent that places them, value = 0.d1 d2 .. dn * 10^exp10
pub rec Shortest {
    digits: [20]u8;
    len:    usize;
    exp10:  i64;
}

# the shortest round-trip decimal of a positive finite nonzero value representable in the
# format of `w`, by exact bignum arithmetic (Steele and White's dragon4) over that format's
# own neighbours, ties read the way round-to-nearest-even reads them back
# ---
# v:   the value, carried in an f64
# w:   the width whose neighbours bound the round trip
# ret: its shortest digits and their exponent
pub fun shortest(v: f64, w: FloatWidth) Shortest {
    val fmt:     Format = format_of(w);
    val p:       i64    = fmt.precision::i64;
    val lsb_min: i64    = format_lsb_min(fmt);

    val bits:     u64 = f64_bits(v) & 0x7FFFFFFFFFFFFFFF;
    val exp_bits: u64 = bits >> 52;
    var f:        u64 = bits & 0xFFFFFFFFFFFFF;
    var e:        i64 = -1074;
    if (exp_bits != 0) {
        f = f | 0x10000000000000;
        e = exp_bits::i64 - 1075;
    }
    var fe: i64 = e + bitlen_u64(f) - p;
    if (fe < lsb_min) { fe = lsb_min; }
    if (fe >= e)      { f = f >> (fe - e)::u64; }
    or                { f = f << (e - fe)::u64; }
    e = fe;

    val hidden: u64  = 1::u64 << (p - 1)::u64;
    val asym:   bool = f == hidden && e != lsb_min;

    var R:  bignum.Big;
    var S:  bignum.Big;
    var Mp: bignum.Big;
    var Mm: bignum.Big;
    bignum.from_u64(?R, f);
    if (e >= 0) {
        if (!asym) {
            bignum.shl(?R, (e + 1)::usize);
            bignum.from_u64(?S, 2);
            bignum.from_u64(?Mp, 1);
            bignum.shl(?Mp, e::usize);
            bignum.from_u64(?Mm, 1);
            bignum.shl(?Mm, e::usize);
        }
        or {
            bignum.shl(?R, (e + 2)::usize);
            bignum.from_u64(?S, 4);
            bignum.from_u64(?Mp, 1);
            bignum.shl(?Mp, (e + 1)::usize);
            bignum.from_u64(?Mm, 1);
            bignum.shl(?Mm, e::usize);
        }
    }
    or {
        if (!asym) {
            bignum.shl(?R, 1);
            bignum.from_u64(?S, 1);
            bignum.shl(?S, (1 - e)::usize);
            bignum.from_u64(?Mp, 1);
            bignum.from_u64(?Mm, 1);
        }
        or {
            bignum.shl(?R, 2);
            bignum.from_u64(?S, 1);
            bignum.shl(?S, (2 - e)::usize);
            bignum.from_u64(?Mp, 2);
            bignum.from_u64(?Mm, 1);
        }
    }

    # scale so R/S lands in [0.1, 1)
    val binexp: i64 = e + bitlen_u64(f) - 1;
    var k:      i64 = (binexp * 1233) / 4096 + 1;
    if (k >= 0) { bignum.mul_pow10(?S, k::usize); }
    or {
        bignum.mul_pow10(?R, (0 - k)::usize);
        bignum.mul_pow10(?Mp, (0 - k)::usize);
        bignum.mul_pow10(?Mm, (0 - k)::usize);
    }
    for (bignum.cmp(?R, ?S) >= 0) {
        bignum.mul_small(?S, 10);
        k = k + 1;
    }
    var r10: bignum.Big;
    bignum.copy(?r10, ?R);
    bignum.mul_small(?r10, 10);
    for (bignum.cmp(?r10, ?S) < 0) {
        bignum.mul_small(?R, 10);
        bignum.mul_small(?Mp, 10);
        bignum.mul_small(?Mm, 10);
        k = k - 1;
        bignum.copy(?r10, ?R);
        bignum.mul_small(?r10, 10);
    }

    var out: Shortest;
    out.len = 0;
    val even: bool = (f & 1) == 0;
    var tmp:  bignum.Big;
    var done: bool = false;
    for (!done && out.len < SHORTEST_DIGITS - 1) {
        bignum.mul_small(?R, 10);
        bignum.mul_small(?Mp, 10);
        bignum.mul_small(?Mm, 10);
        var d: u8 = 0;
        for (bignum.cmp(?R, ?S) >= 0) {
            bignum.sub(?R, ?S);
            d = d + 1;
        }
        var low: bool = false;
        if (even) { low = bignum.cmp(?R, ?Mm) <= 0; }
        or        { low = bignum.cmp(?R, ?Mm) < 0; }
        bignum.copy(?tmp, ?R);
        bignum.add(?tmp, ?Mp);
        var high: bool = false;
        if (even) { high = bignum.cmp(?tmp, ?S) >= 0; }
        or        { high = bignum.cmp(?tmp, ?S) > 0; }

        if (low || high) {
            var up: bool = high && !low;
            if (low && high) {
                bignum.copy(?tmp, ?R);
                bignum.shl(?tmp, 1);
                val c: i64 = bignum.cmp(?tmp, ?S);
                up = c > 0 || (c == 0 && (d & 1) == 1);
            }
            if (up) { d = d + 1; }
            done = true;
        }
        out.digits[out.len] = d;
        out.len             = out.len + 1;
    }

    # a round-up carry can leave a terminating 10
    if (out.digits[out.len - 1] == 10) {
        out.digits[out.len - 1] = 0;
        var carry: bool  = true;
        var i:     usize = out.len - 1;
        for (carry && i > 0) {
            out.digits[i - 1] = out.digits[i - 1] + 1;
            if (out.digits[i - 1] == 10) {
                out.digits[i - 1] = 0;
                i                 = i - 1;
            }
            or { carry = false; }
        }
        if (carry) {
            var j: usize = out.len;
            for (j > 0) {
                out.digits[j] = out.digits[j - 1];
                j             = j - 1;
            }
            out.digits[0] = 1;
            out.len       = out.len + 1;
            k             = k + 1;
        }
    }
    for (out.len > 1 && out.digits[out.len - 1] == 0) { out.len = out.len - 1; }
    out.exp10 = k;
    ret out;
}

pub val SHORTEST_TEXT_CAP: usize = 48;

# the shortest digits spelled as a float literal, positional for a modest exponent and in
# scientific form otherwise, terminated, in a SHORTEST_TEXT_CAP buffer
pub fun shortest_text(s: *Shortest, buf: *u8) str {
    var n: usize = 0;
    if (s.exp10 > 0 && s.exp10 <= 17) {
        var i: usize = 0;
        for (i < s.exp10::usize) {
            if (i < s.len) { buf[n] = s.digits[i] + '0'; }
            or             { buf[n] = '0'; }
            n = n + 1;
            i = i + 1;
        }
        buf[n] = '.';
        n      = n + 1;
        if (s.len <= s.exp10::usize) {
            buf[n] = '0';
            n      = n + 1;
        }
        for (i < s.len) {
            buf[n] = s.digits[i] + '0';
            n      = n + 1;
            i      = i + 1;
        }
    }
    or (s.exp10 <= 0 && s.exp10 > -4) {
        buf[0] = '0';
        buf[1] = '.';
        n      = 2;
        var z: i64 = s.exp10;
        for (z < 0) {
            buf[n] = '0';
            n      = n + 1;
            z      = z + 1;
        }
        var i: usize = 0;
        for (i < s.len) {
            buf[n] = s.digits[i] + '0';
            n      = n + 1;
            i      = i + 1;
        }
    }
    or {
        buf[0] = s.digits[0] + '0';
        buf[1] = '.';
        n      = 2;
        if (s.len == 1) {
            buf[n] = '0';
            n      = n + 1;
        }
        var i: usize = 1;
        for (i < s.len) {
            buf[n] = s.digits[i] + '0';
            n      = n + 1;
            i      = i + 1;
        }
        buf[n] = 'e';
        n      = n + 1;
        var x: i64 = s.exp10 - 1;
        if (x < 0) {
            buf[n] = '-';
            n      = n + 1;
            x      = 0 - x;
        }
        var rev: [8]u8;
        var rn:  usize = 0;
        for (x > 0 || rn == 0) {
            rev[rn] = (x % 10)::u8 + '0';
            rn      = rn + 1;
            x       = x / 10;
        }
        for (rn > 0) {
            rn     = rn - 1;
            buf[n] = rev[rn];
            n      = n + 1;
        }
    }
    buf[n] = 0;
    ret buf::str;
}

#[testing]
val T_NARROW_LEN: usize = 23;

# binary64 inputs and their correctly rounded binary16 encodings: signed zeros, the
# subnormal edges and their ties, the carry from the largest subnormal into the smallest
# normal, the largest finite and its overflow tie, underflow to zero, and the infinities
#[testing]
val T_NARROW_IN: [T_NARROW_LEN]u64 = [T_NARROW_LEN]u64{
    0x0000000000000000, 0x8000000000000000, 0x3FF0000000000000, 0xC000000000000000,
    0x40EFFC0000000000, 0x40EFFDFFAE147AE1, 0x40EFFE0000000000, 0xC0EFFE0000000000,
    0x3E70000000000000, 0xBE70000000000000, 0x3E60000000000000, 0x3E60000000000001,
    0x3E78000000000000, 0x3F0FF80000000000, 0x3F10000000000000, 0x3F0FFC0000000000,
    0x3FF0020000000000, 0x3FF0060000000000, 0x3FD5555555555555, 0x3DDB7CDFD9D7BDBB,
    0x0000000000000001, 0x7FF0000000000000, 0xFFF0000000000000,
};

#[testing]
val T_NARROW_OUT: [T_NARROW_LEN]u64 = [T_NARROW_LEN]u64{
    0x0000, 0x8000, 0x3C00, 0xC000,
    0x7BFF, 0x7BFF, 0x7C00, 0xFC00,
    0x0001, 0x8001, 0x0000, 0x0001,
    0x0002, 0x03FF, 0x0400, 0x0400,
    0x3C00, 0x3C02, 0x3555, 0x0000,
    0x0000, 0x7C00, 0xFC00,
};

test narrow_bits__binary16_rounds_to_nearest_even {
    val h: Format = format_of(FLOAT_W_16);
    var i: usize  = 0;
    for (i < T_NARROW_LEN) {
        if (narrow_bits(T_NARROW_IN[i], h) != T_NARROW_OUT[i]) { ret (i + 1)::i32; }
        i = i + 1;
    }
    # a NaN is quieted and keeps its sign and the top of its payload
    if (narrow_bits(0x7FF8000000000000, h) != 0x7E00) { ret 30; }
    if (narrow_bits(0xFFF4000000000000, h) != 0xFF00) { ret 31; }
    ret 0;
}

# every binary16 encoding widens exactly and narrows back to itself, a NaN quieted
test widen_bits__binary16_round_trips_every_encoding {
    val h: Format = format_of(FLOAT_W_16);
    var b: u64    = 0;
    for (b < 0x10000) {
        var want: u64 = b;
        if ((b & 0x7C00) == 0x7C00 && (b & 0x03FF) != 0) { want = b | 0x0200; }
        if (narrow_bits(widen_bits(b, h), h) != want)    { ret 1; }
        b = b + 1;
    }
    if (bits_f64(widen_bits(0x0001, h)) != bits_f64(0x3E70000000000000))          { ret 2; }
    if (bits_f64(widen_bits(0x03FF, h)) != 1023.0 * bits_f64(0x3E70000000000000)) { ret 3; }
    if (bits_f64(widen_bits(0x7BFF, h)) != 65504.0)                               { ret 4; }
    if (widen_bits(0x8000, h) != 0x8000000000000000)                              { ret 5; }
    if (widen_bits(0xFC00, h) != 0xFFF0000000000000)                              { ret 6; }
    ret 0;
}

#[testing]
fun t_h(bits: u64) f64 {
    ret value_of_bits(bits, FLOAT_W_16);
}

#[testing]
fun t_hb(v: f64) u64 {
    ret bits_at(round_at(v, FLOAT_W_16), FLOAT_W_16);
}

#[testing]
fun t_is_nan16(bits: u64) bool {
    ret (bits & 0x7C00) == 0x7C00 && (bits & 0x03FF) != 0;
}

# each operator computed in binary64 and rounded once at binary16 is the correctly rounded
# binary16 result, through its ties, subnormals, overflow and the special values
test round_at__binary16_operators {
    if (t_hb(t_h(0x7BFF) + t_h(0x4C00)) != 0x7C00)                    { ret 1; }
    if (t_hb(t_h(0x7BFF) + t_h(0x4BFF)) != 0x7BFF)                    { ret 2; }
    if (t_hb(t_h(0x6800) + t_h(0x3C00)) != 0x6800)                    { ret 3; }
    if (t_hb(t_h(0x6800) + t_h(0x4200)) != 0x6802)                    { ret 4; }
    if (t_hb(t_h(0x0400) - t_h(0x0001)) != 0x03FF)                    { ret 5; }
    if (t_hb(t_h(0x0001) * t_h(0x3800)) != 0x0000)                    { ret 6; }
    if (t_hb(t_h(0x0001) * t_h(0x3E00)) != 0x0002)                    { ret 7; }
    if (t_hb(t_h(0x03FF) * t_h(0x4000)) != 0x07FE)                    { ret 8; }
    if (t_hb(t_h(0x5C00) * t_h(0x5C00)) != 0x7C00)                    { ret 9; }
    if (t_hb(t_h(0x2E66) * t_h(0x2E66)) != 0x211E)                    { ret 10; }
    if (t_hb(t_h(0x3C00) / t_h(0x4200)) != 0x3555)                    { ret 11; }
    if (t_hb(t_h(0x3C00) / t_h(0x7BFF)) != 0x0100)                    { ret 12; }
    if (t_hb(t_h(0xBC00) / t_h(0x0000)) != 0xFC00)                    { ret 13; }
    if (!t_is_nan16(t_hb(t_h(0x0000) / t_h(0x0000))))                 { ret 14; }
    if (!t_is_nan16(t_hb(t_h(0x7C00) - t_h(0x7C00))))                 { ret 15; }
    if (t_hb(f64_neg(t_h(0x3C00))) != 0xBC00)                         { ret 16; }
    if (t_hb(f64_neg(t_h(0x0000))) != 0x8000)                         { ret 17; }
    if (t_h(0x0000) != t_h(0x8000))                                   { ret 18; }
    if (t_h(0x7E00) == t_h(0x7E00))                                   { ret 19; }
    if (!(t_h(0x03FF) < t_h(0x0400)) || !(t_h(0xFC00) < t_h(0xFBFF))) { ret 20; }
    ret 0;
}
