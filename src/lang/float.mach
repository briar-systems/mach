use std_format: std.format;
use std.math.bignum;
use std.math.ieee;
use text_parse: std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

pub def FloatWidth: u8;

pub val FLOAT_W_NONE: FloatWidth = 0;
pub val FLOAT_W_16:   FloatWidth = 16;
pub val FLOAT_W_32:   FloatWidth = 32;
pub val FLOAT_W_64:   FloatWidth = 64;

# the float type a width names, as its source spelling
pub fun width_name(w: FloatWidth) str {
    if (w == FLOAT_W_16) { ret "f16"; }
    if (w == FLOAT_W_32) { ret "f32"; }
    ret "f64";
}

# the width of a float `bits` wide, FLOAT_W_NONE for a width no float type has
pub fun width_of_bits(bits: u32) FloatWidth {
    if (bits == 16) { ret FLOAT_W_16; }
    if (bits == 32) { ret FLOAT_W_32; }
    if (bits == 64) { ret FLOAT_W_64; }
    ret FLOAT_W_NONE;
}

pub fun f64_bits(f: f64) u64 {
    var u: uni { f: f64; i: u64; };
    u.f = f;
    ret u.i;
}

pub fun bits_f64(bits: u64) f64 {
    var u: uni { f: f64; i: u64; };
    u.i = bits;
    ret u.f;
}

pub fun f64_neg(f: f64) f64 {
    ret bits_f64(f64_bits(f) ^ 0x8000000000000000);
}

pub fun f64_signbit(f: f64) bool {
    ret (f64_bits(f) >> 63) != 0;
}

# what the target makes of a NaN it computes, a conversion between two float formats
# among them, which comptime folds by (see doc/language/operators.md)
pub def NanRule: u8;

# no rule declared: a machine model that leaves it here is refused
pub val NAN_RULE_NONE: NanRule = 0;
# the sign and the top of the payload kept, the quiet bit set: x86-64 and aarch64
pub val NAN_PRESERVE: NanRule = 1;
# the canonical NaN, positive and quiet with an empty payload: RISC-V
pub val NAN_CANONICAL: NanRule = 2;
# not a conversion but a value carried between its own format and binary64, whose
# NaN keeps every bit it has
val NAN_CARRY: NanRule = 3;
# no NaN the target computes is specified, so comptime folds none: SPIR-V under
# Vulkan with no float-controls execution mode
pub val NAN_UNSPECIFIED: NanRule = 4;

pub fun nan_rule_valid(r: NanRule) bool {
    ret r == NAN_PRESERVE || r == NAN_CANONICAL || r == NAN_UNSPECIFIED;
}

# the binary32 encoding of binary64 bits that carry a binary32 value: rounded to
# nearest even, a NaN keeping every bit binary32 has
pub fun f64_to_f32_bits(d: u64) u32 {
    ret narrow_bits(d, format_of(FLOAT_W_32), NAN_CARRY)::u32;
}

pub fun f32_bits_to_f64_bits(s: u32) u64 {
    val sign: u64 = ((s >> 31) & 0x1)::u64;
    val exp:  u32 = (s >> 23) & 0xFF;
    val mant: u32 = s & 0x7FFFFF;

    if (exp == 0xFF) { ret (sign << 63) | 0x7FF0000000000000 | (mant::u64 << 29); }

    if (exp == 0) {
        if (mant == 0) { ret sign << 63; }
        var p: u32 = 22;
        for ((mant & (1::u32 << p)) == 0) { p = p - 1; }
        val e64: u64 = (p + 874)::u64;
        val m64: u64 = (mant::u64 << (52 - p)::u64) & 0xFFFFFFFFFFFFF;
        ret (sign << 63) | (e64 << 52) | m64;
    }

    ret (sign << 63) | ((exp + 896)::u64 << 52) | (mant::u64 << 29);
}

# `f` rounded once, to nearest with ties to even, to the format of `w`, and carried back
# exactly in an f64. binary64 holds every narrower format exactly with more than twice its
# precision plus two bits, so a `+ - * /` of two values at `w` computed in f64 and rounded
# here is the correctly rounded result at `w`
pub fun round_at(f: f64, w: FloatWidth) f64 {
    if (w == FLOAT_W_16) { ret bits_f64(widen_bits(narrow_bits(f64_bits(f), format_of(w), NAN_CARRY), format_of(w), NAN_CARRY)); }
    if (w != FLOAT_W_32) { ret f; }
    ret bits_f64(f32_bits_to_f64_bits(f64_to_f32_bits(f64_bits(f))));
}

# the encoding at `w` of `v`, a value already representable at `w`: the bits `:~` reads
pub fun bits_at(v: f64, w: FloatWidth) u64 {
    if (w == FLOAT_W_16) { ret narrow_bits(f64_bits(v), format_of(w), NAN_CARRY); }
    if (w == FLOAT_W_32) { ret f64_to_f32_bits(f64_bits(v))::u64; }
    ret f64_bits(v);
}

# the value an encoding at `w` holds, carried exactly in an f64: the value `:~` makes
pub fun value_of_bits(bits: u64, w: FloatWidth) f64 {
    if (w == FLOAT_W_16) { ret bits_f64(widen_bits(bits & 0xFFFF, format_of(w), NAN_CARRY)); }
    if (w == FLOAT_W_32) { ret bits_f64(f32_bits_to_f64_bits(bits::u32)); }
    ret bits_f64(bits);
}

pub fun widths_agree(a: FloatWidth, b: FloatWidth) bool {
    ret a == b || a == FLOAT_W_NONE || b == FLOAT_W_NONE;
}

pub fun unify_width(a: FloatWidth, b: FloatWidth) FloatWidth {
    if (a == FLOAT_W_NONE) { ret b; }
    ret a;
}

# a binary interchange format: its significand precision, the hidden bit counted, and the
# width of its exponent field. every width a float type can take has one row in format_of
pub rec Format {
    precision: u32;
    exp_bits:  u32;
}

# the format a width names; FLOAT_W_NONE is the unsuffixed default, binary64
fun format_of(w: FloatWidth) Format {
    if (w == FLOAT_W_16) { ret Format{precision: 11, exp_bits: 5}; }
    if (w == FLOAT_W_32) { ret Format{precision: 24, exp_bits: 8}; }
    ret Format{precision: 53, exp_bits: 11};
}

fun format_bias(f: Format) i64 {
    ret (1::i64 << (f.exp_bits - 1)::u64) - 1;
}

# the exponent of the least significant bit of the smallest subnormal
fun format_lsb_min(f: Format) i64 {
    ret 2 - format_bias(f) - f.precision::i64;
}

pub def Fit: u8;

pub val FIT_EXACT:     Fit = 0;
pub val FIT_INEXACT:   Fit = 1;
pub val FIT_OVERFLOW:  Fit = 2;
pub val FIT_UNDERFLOW: Fit = 3;

# a decimal rounded to one format: the value, carried exactly in an f64, and how it fit.
# an overflow carries +inf and an underflow of a nonzero decimal carries +0
pub rec Rounded {
    value: f64;
    fit:   Fit;
}

fun bitlen_u64(v: u64) i64 {
    var n: i64 = 0;
    var x: u64 = v;
    for (x > 0) {
        n = n + 1;
        x = x >> 1;
    }
    ret n;
}

# binary64 bits `d` rounded to nearest with ties to even into the encoding of `f`, a format
# narrower than binary64: a value past the largest finite overflows to infinity, one below
# the smallest normal rounds into the subnormals, and a NaN is made by `rule`
# ---
# d:    the binary64 encoding to narrow
# f:    the format to round into
# rule: what the conversion makes of a NaN
# ret:  the encoding in `f`, in the low bits
fun narrow_bits(d: u64, f: Format, rule: NanRule) u64 {
    val m:    u64 = (f.precision - 1)::u64;
    val emax: u64 = (1::u64 << f.exp_bits::u64) - 1;
    val sign: u64 = (d >> 63) << (f.exp_bits::u64 + m);
    val exp:  u64 = (d >> 52) & 0x7FF;
    val mant: u64 = d & 0xFFFFFFFFFFFFF;
    val inf:  u64 = sign | (emax << m);

    if (exp == 0x7FF) {
        if (mant == 0)             { ret inf; }
        if (rule == NAN_CANONICAL) { ret (emax << m) | (1::u64 << (m - 1)); }
        val top: u64 = mant >> (52 - m);
        # a carried NaN keeps its quiet bit, and one whose payload lies only in the
        # dropped bits is quieted so that it stays a NaN
        if (rule == NAN_CARRY && top != 0) { ret inf | top; }
        ret inf | (1::u64 << (m - 1)) | top;
    }
    # a binary64 subnormal lies below half the narrower format's smallest subnormal
    if (exp == 0) { ret sign; }

    val sig: u64 = mant | 0x10000000000000;
    var e:   i64 = exp::i64 - 1023 + format_bias(f);
    var s:   i64 = (52 - m)::i64;
    if (e <= 0) { s = s + 1 - e; }
    # below half the smallest subnormal: rounds to zero
    if (s > 53) { ret sign; }

    var q:    u64 = sig >> s::u64;
    val rem:  u64 = sig & ((1::u64 << s::u64) - 1);
    val half: u64 = 1::u64 << (s - 1)::u64;
    if (rem > half || (rem == half && (q & 1) != 0)) { q = q + 1; }

    # a subnormal that rounds up to 2^m is the smallest normal, which its encoding already spells
    if (e <= 0) { ret sign | q; }
    if (q == 1::u64 << (m + 1)) {
        q = q >> 1;
        e = e + 1;
    }
    if (e::u64 >= emax) { ret inf; }
    ret sign | (e::u64 << m) | (q & ((1::u64 << m) - 1));
}

# an encoding of `f`, a format narrower than binary64, as binary64 bits: exact, a subnormal
# normalised and a NaN made by `rule`
# ---
# b:    the encoding in `f`, in the low bits
# f:    the format it is encoded in
# rule: what the conversion makes of a NaN
# ret:  the same value as binary64 bits
fun widen_bits(b: u64, f: Format, rule: NanRule) u64 {
    val m:    u64 = (f.precision - 1)::u64;
    val emax: u64 = (1::u64 << f.exp_bits::u64) - 1;
    val sign: u64 = ((b >> (f.exp_bits::u64 + m)) & 1) << 63;
    val exp:  u64 = (b >> m) & emax;
    val mant: u64 = b & ((1::u64 << m) - 1);

    if (exp == emax) {
        if (mant == 0)             { ret sign | 0x7FF0000000000000; }
        if (rule == NAN_CANONICAL) { ret 0x7FF8000000000000; }
        if (rule == NAN_CARRY)     { ret sign | 0x7FF0000000000000 | (mant << (52 - m)); }
        ret sign | 0x7FF8000000000000 | (mant << (52 - m));
    }
    if (exp == 0) {
        if (mant == 0) { ret sign; }
        val top: i64 = bitlen_u64(mant) - 1;
        val e64: i64 = top - m::i64 + 1 - format_bias(f) + 1023;
        ret sign | (e64::u64 << 52) | ((mant << (52 - top)::u64) & 0xFFFFFFFFFFFFF);
    }
    ret sign | ((exp::i64 - format_bias(f) + 1023)::u64 << 52) | (mant << (52 - m));
}

# the decimal `s`, its first `len` bytes, rounded once to nearest with ties to even at `w` by
# std's parse and carried exactly in an f64, none when the parse refuses the text
pub fun parse_decimal(s: str, len: usize, w: FloatWidth) opt[f64] {
    var f: ieee.Format = ieee.F64;
    if (w == FLOAT_W_16) { f = ieee.F16; }
    or (w == FLOAT_W_32) { f = ieee.F32; }
    # parse's work for the widest format a decimal rounds into, its four bignums of f64's limbs
    var work: [4 * ieee.F64_LIMBS]u32;
    val got:  res[u128, text_parse.ParseError] = text_parse.parse_float(f, text_parse.Radix.decimal{}, s, len, true, ?work[0]);
    if (sel got.err) { ret opt[f64].none{}; }
    ret opt[f64].some{value_of_bits(got.ok::u64, w)};
}

# how the decimal mant * 10^exp10 fit `value`, the value it was rounded to: exact when the two are
# equal, an overflow when it rounded to infinity and an underflow when a nonzero decimal rounded to
# zero. `trunc` says a nonzero digit past mant was dropped, so the decimal is never exact
pub fun fit_of(value: f64, mant: *bignum.Big, exp10: i64, trunc: bool) Rounded {
    val bits: u64 = f64_bits(value) & 0x7FFFFFFFFFFFFFFF;
    if (bignum.is_zero(mant) && !trunc) { ret Rounded{value: value, fit: FIT_EXACT}; }
    if (bits == 0x7FF0000000000000)     { ret Rounded{value: value, fit: FIT_OVERFLOW}; }
    if (bits == 0)                      { ret Rounded{value: value, fit: FIT_UNDERFLOW}; }
    if (trunc)                          { ret Rounded{value: value, fit: FIT_INEXACT}; }
    val field: i64 = (bits >> 52)::i64;
    var q:     u64 = bits & 0xFFFFFFFFFFFFF;
    var e:     i64 = -1074;
    if (field != 0) {
        q = q | 0x10000000000000;
        e = field - 1075;
    }
    var lhs: bignum.Big;
    var rhs: bignum.Big;
    bignum.copy(?lhs, mant);
    bignum.from_u64(?rhs, q);
    if (exp10 >= 0)                  { bignum.mul_pow10(?lhs, exp10::usize); }
    or                               { bignum.mul_pow10(?rhs, (0 - exp10)::usize); }
    if (e >= 0)                      { bignum.shl(?rhs, e::usize); }
    or                               { bignum.shl(?lhs, (0 - e)::usize); }
    if (bignum.cmp(?lhs, ?rhs) == 0) { ret Rounded{value: value, fit: FIT_EXACT}; }
    ret Rounded{value: value, fit: FIT_INEXACT};
}

val SHORTEST_DIGITS: usize = 20;

# the shortest decimal that rounds back to a value in its format: digit values 0..9, and the
# exponent that places them, value = 0.d1 d2 .. dn * 10^exp10
pub rec Shortest {
    digits: [20]u8;
    len:    usize;
    exp10:  i64;
}

# the shortest round-trip decimal of a positive finite nonzero value representable in the
# format of `w`, by exact bignum arithmetic (Steele and White's dragon4) over that format's
# own neighbours, ties read the way round-to-nearest-even reads them back
# ---
# v:   the value, carried in an f64
# w:   the width whose neighbours bound the round trip
# ret: its shortest digits and their exponent
pub fun shortest(v: f64, w: FloatWidth) Shortest {
    val fmt:     Format = format_of(w);
    val p:       i64    = fmt.precision::i64;
    val lsb_min: i64    = format_lsb_min(fmt);

    val bits:     u64 = f64_bits(v) & 0x7FFFFFFFFFFFFFFF;
    val exp_bits: u64 = bits >> 52;
    var f:        u64 = bits & 0xFFFFFFFFFFFFF;
    var e:        i64 = -1074;
    if (exp_bits != 0) {
        f = f | 0x10000000000000;
        e = exp_bits::i64 - 1075;
    }
    var fe: i64 = e + bitlen_u64(f) - p;
    if (fe < lsb_min) { fe = lsb_min; }
    if (fe >= e)      { f = f >> (fe - e)::u64; }
    or                { f = f << (e - fe)::u64; }
    e = fe;

    val hidden: u64  = 1::u64 << (p - 1)::u64;
    val asym:   bool = f == hidden && e != lsb_min;

    var R:  bignum.Big;
    var S:  bignum.Big;
    var Mp: bignum.Big;
    var Mm: bignum.Big;
    bignum.from_u64(?R, f);
    if (e >= 0) {
        if (!asym) {
            bignum.shl(?R, (e + 1)::usize);
            bignum.from_u64(?S, 2);
            bignum.from_u64(?Mp, 1);
            bignum.shl(?Mp, e::usize);
            bignum.from_u64(?Mm, 1);
            bignum.shl(?Mm, e::usize);
        }
        or {
            bignum.shl(?R, (e + 2)::usize);
            bignum.from_u64(?S, 4);
            bignum.from_u64(?Mp, 1);
            bignum.shl(?Mp, (e + 1)::usize);
            bignum.from_u64(?Mm, 1);
            bignum.shl(?Mm, e::usize);
        }
    }
    or {
        if (!asym) {
            bignum.shl(?R, 1);
            bignum.from_u64(?S, 1);
            bignum.shl(?S, (1 - e)::usize);
            bignum.from_u64(?Mp, 1);
            bignum.from_u64(?Mm, 1);
        }
        or {
            bignum.shl(?R, 2);
            bignum.from_u64(?S, 1);
            bignum.shl(?S, (2 - e)::usize);
            bignum.from_u64(?Mp, 2);
            bignum.from_u64(?Mm, 1);
        }
    }

    # scale so R/S lands in [0.1, 1)
    val binexp: i64 = e + bitlen_u64(f) - 1;
    var k:      i64 = (binexp * 1233) / 4096 + 1;
    if (k >= 0) { bignum.mul_pow10(?S, k::usize); }
    or {
        bignum.mul_pow10(?R, (0 - k)::usize);
        bignum.mul_pow10(?Mp, (0 - k)::usize);
        bignum.mul_pow10(?Mm, (0 - k)::usize);
    }
    for (bignum.cmp(?R, ?S) >= 0) {
        bignum.mul_small(?S, 10);
        k = k + 1;
    }
    var r10: bignum.Big;
    bignum.copy(?r10, ?R);
    bignum.mul_small(?r10, 10);
    for (bignum.cmp(?r10, ?S) < 0) {
        bignum.mul_small(?R, 10);
        bignum.mul_small(?Mp, 10);
        bignum.mul_small(?Mm, 10);
        k = k - 1;
        bignum.copy(?r10, ?R);
        bignum.mul_small(?r10, 10);
    }

    var out: Shortest;
    out.len = 0;
    val even: bool = (f & 1) == 0;
    var tmp:  bignum.Big;
    var done: bool = false;
    for (!done && out.len < SHORTEST_DIGITS - 1) {
        bignum.mul_small(?R, 10);
        bignum.mul_small(?Mp, 10);
        bignum.mul_small(?Mm, 10);
        var d: u8 = 0;
        for (bignum.cmp(?R, ?S) >= 0) {
            bignum.sub(?R, ?S);
            d = d + 1;
        }
        var low: bool = false;
        if (even) { low = bignum.cmp(?R, ?Mm) <= 0; }
        or        { low = bignum.cmp(?R, ?Mm) < 0; }
        bignum.copy(?tmp, ?R);
        bignum.add(?tmp, ?Mp);
        var high: bool = false;
        if (even) { high = bignum.cmp(?tmp, ?S) >= 0; }
        or        { high = bignum.cmp(?tmp, ?S) > 0; }

        if (low || high) {
            var up: bool = high && !low;
            if (low && high) {
                bignum.copy(?tmp, ?R);
                bignum.shl(?tmp, 1);
                val c: i64 = bignum.cmp(?tmp, ?S);
                up = c > 0 || (c == 0 && (d & 1) == 1);
            }
            if (up) { d = d + 1; }
            done = true;
        }
        out.digits[out.len] = d;
        out.len             = out.len + 1;
    }

    # a round-up carry can leave a terminating 10
    if (out.digits[out.len - 1] == 10) {
        out.digits[out.len - 1] = 0;
        var carry: bool  = true;
        var i:     usize = out.len - 1;
        for (carry && i > 0) {
            out.digits[i - 1] = out.digits[i - 1] + 1;
            if (out.digits[i - 1] == 10) {
                out.digits[i - 1] = 0;
                i                 = i - 1;
            }
            or { carry = false; }
        }
        if (carry) {
            var j: usize = out.len;
            for (j > 0) {
                out.digits[j] = out.digits[j - 1];
                j             = j - 1;
            }
            out.digits[0] = 1;
            out.len       = out.len + 1;
            k             = k + 1;
        }
    }
    for (out.len > 1 && out.digits[out.len - 1] == 0) { out.len = out.len - 1; }
    out.exp10 = k;
    ret out;
}

pub val SHORTEST_TEXT_CAP: usize = 48;

# the shortest digits spelled as a float literal, positional for a modest exponent and in
# scientific form otherwise, terminated, in a SHORTEST_TEXT_CAP buffer
pub fun shortest_text(s: *Shortest, buf: *u8) str {
    var n: usize = 0;
    if (s.exp10 > 0 && s.exp10 <= 17) {
        var i: usize = 0;
        for (i < s.exp10::usize) {
            if (i < s.len) { buf[n] = s.digits[i] + '0'; }
            or             { buf[n] = '0'; }
            n = n + 1;
            i = i + 1;
        }
        buf[n] = '.';
        n      = n + 1;
        if (s.len <= s.exp10::usize) {
            buf[n] = '0';
            n      = n + 1;
        }
        for (i < s.len) {
            buf[n] = s.digits[i] + '0';
            n      = n + 1;
            i      = i + 1;
        }
    }
    or (s.exp10 <= 0 && s.exp10 > -4) {
        buf[0] = '0';
        buf[1] = '.';
        n      = 2;
        var z: i64 = s.exp10;
        for (z < 0) {
            buf[n] = '0';
            n      = n + 1;
            z      = z + 1;
        }
        var i: usize = 0;
        for (i < s.len) {
            buf[n] = s.digits[i] + '0';
            n      = n + 1;
            i      = i + 1;
        }
    }
    or {
        buf[0] = s.digits[0] + '0';
        buf[1] = '.';
        n      = 2;
        if (s.len == 1) {
            buf[n] = '0';
            n      = n + 1;
        }
        var i: usize = 1;
        for (i < s.len) {
            buf[n] = s.digits[i] + '0';
            n      = n + 1;
            i      = i + 1;
        }
        buf[n] = 'e';
        n      = n + 1;
        n      = n + std_format.put_i64(?buf[n], s.exp10 - 1);
    }
    buf[n] = 0;
    ret buf::str;
}
