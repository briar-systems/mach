use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use diagnostic_kind: mach.lang.diagnostic.kind;
# the dudect probes, held to the leaky and constant-time references

# an inline-asm block the constant-time scan refuses
# ---
# kind:    the diagnostic kind the refusal is reported as
# message: what the block does with the secret
pub rec AsmRefusal {
    kind:    diagnostic_kind.Kind;
    message: str;
}

pub def CtOp: u8;

pub val CT_OP_NONE:       CtOp = 0;
pub val CT_OP_INT_DIVMOD: CtOp = 1;
pub val CT_OP_FLOAT:      CtOp = 2;
pub val CT_OP_INT_MUL:    CtOp = 3;
pub val CT_OP_VAR_SHIFT:  CtOp = 4;
# a repeated string instruction: it runs once per element of its count, and a
# compare stops at the first element that differs, so its timing is its data
pub val CT_OP_REP_STRING: CtOp = 5;

pub def CtCap: u8;

pub val CT_CAP_OK:        CtCap = 0;
pub val CT_CAP_ALWAYS:    CtCap = 1;
pub val CT_CAP_MUL:       CtCap = 2;
val     CT_CAP_VAR_SHIFT: CtCap = 3;

# the capability a target must provide for an operation to be constant-time,
# absent for an operation outside the catalog: an unknown operation is never
# answered with "no capability needed"
pub fun ct_cap(op: CtOp) opt[CtCap] {
    if (op == CT_OP_NONE)       { ret opt[CtCap].some{CT_CAP_OK}; }
    if (op == CT_OP_INT_DIVMOD) { ret opt[CtCap].some{CT_CAP_ALWAYS}; }
    if (op == CT_OP_FLOAT)      { ret opt[CtCap].some{CT_CAP_ALWAYS}; }
    if (op == CT_OP_INT_MUL)    { ret opt[CtCap].some{CT_CAP_MUL}; }
    if (op == CT_OP_VAR_SHIFT)  { ret opt[CtCap].some{CT_CAP_VAR_SHIFT}; }
    if (op == CT_OP_REP_STRING) { ret opt[CtCap].some{CT_CAP_ALWAYS}; }
    ret opt[CtCap].none{};
}

# what a secret operand of `op` does where the target does not provide its capability,
# worded to follow the name of the code that does it; every stage that refuses one reads
# it here. none for an operation outside the catalog
pub fun latency_refusal(op: CtOp) opt[str] {
    if (op == CT_OP_INT_DIVMOD) {
        ret opt[str].some{"uses a secret value in a variable-latency integer divide or remainder; the division unit's latency is data-dependent, so it leaks the secret operand. compute branch-free over public data"};
    }
    if (op == CT_OP_FLOAT) {
        ret opt[str].some{"uses a secret value in a variable-latency floating-point operation; the FP unit's timing can depend on the secret operand. compute on public data, or `:>T`-declassify when disclosure is intended"};
    }
    if (op == CT_OP_INT_MUL) {
        ret opt[str].some{"uses a secret value in a variable-latency integer multiply; this target documents no data-independent multiply timing, so the product's latency can leak the secret operand. compute branch-free over public data, or run on a target whose DIT/DOITM mode is trusted"};
    }
    if (op == CT_OP_VAR_SHIFT) {
        ret opt[str].some{"uses a secret value as a variable shift count on a target without a barrel shifter; the shift's cycle count leaks the secret amount. shift by a public count, or run on a target whose variable shift is constant-time"};
    }
    if (op == CT_OP_REP_STRING) {
        ret opt[str].some{"uses a secret value in a variable-latency repeated string operation; it runs once per element and a compare stops at the first difference, so its timing is its data. use a fixed-length loop over public bounds"};
    }
    ret opt[str].none{};
}

# the refusal of a secret multiply the instruction set declares data-independent only
# under a mode the operating system declares no guarantee for, formatted with the mode,
# the instruction set and the operating system
pub val DIT_REFUSAL: str =
    "uses a secret value in an integer multiply whose timing is data-independent only under {}; the `{}` instruction set declares the multiply under that mode and the `{}` operating system declares no guarantee that a process can set and hold it. compute branch-free over public data, or build for an operating system that declares the guarantee";

pub fun cap_at_sema(cap: CtCap) bool {
    ret cap == CT_CAP_ALWAYS;
}

# the multiply a machine instruction realizes: the low half of a same-width
# product, the high half by operand signedness, or the full double-width
# product
pub def CtMulOp: u8;

pub val CT_MUL_NONE:    CtMulOp = 0;
pub val CT_MUL_LOW:     CtMulOp = 1;
pub val CT_MUL_HIGH_U:  CtMulOp = 2;
pub val CT_MUL_HIGH_S:  CtMulOp = 3;
pub val CT_MUL_HIGH_SU: CtMulOp = 4;
pub val CT_MUL_WIDE_U:  CtMulOp = 5;
pub val CT_MUL_WIDE_S:  CtMulOp = 6;

pub val CT_MUL_OP_COUNT: u32 = 7;

# what a declared multiply row needs before its timing is data-independent
pub def CtMulCond: u8;

pub val CT_MUL_ALWAYS:    CtMulCond = 0;
pub val CT_MUL_DIT_MODE:  CtMulCond = 1;
pub val CT_MUL_EXTENSION: CtMulCond = 2;

val CT_MUL_COND_COUNT: u32 = 3;

# the DIT runtime contract between the compiler and the std start code.
# a module that multiplies a secret in a DIT_MODE cell carries the marker: a
# local absolute symbol, value 1, that names the need and reaches no linked
# image. on a target whose os declares the mode guaranteed, the linker defines
# the cell in every executable: a hidden one-byte read-only object, 1 when any
# input carries the marker, else 0. the start code reads the cell and, when it
# is set, turns PSTATE.DIT on or fails closed. the names and the byte are
# frozen: std builds against them
pub val DIT_NEED_MARKER:   str = "__mach_needs_dit";
pub val DIT_REQUIRED_CELL: str = "__mach_dit_required";
pub val DIT_NEED_VALUE:    u64 = 1;

# one declared row: this multiply at this operand width (and, for a lane
# multiply, this lane count) has data-independent timing under `cond`; `ext`
# names the ISA extension bits an EXTENSION row needs
pub rec CtMulForm {
    op:    CtMulOp;
    width: u8;
    lanes: u8;
    cond:  CtMulCond;
    ext:   u64;
}

# the multiply an emitted instruction realizes, at an operand width in bits;
# `vector` for a lane multiply
pub rec CtMulCell {
    op:     CtMulOp;
    width:  u8;
    vector: bool;
}

# the admitted cells, one bit per (op, width) in a scalar and a vector plane
pub rec CtMulMask {
    scalar: u64;
    vector: u64;
}

pub fun mul_cell(op: CtMulOp, width: u8, vector: bool) CtMulCell {
    ret CtMulCell{op: op, width: width, vector: vector};
}

pub fun mul_mask_none() CtMulMask {
    ret CtMulMask{scalar: 0, vector: 0};
}

fun mul_op_valid(op: CtMulOp) bool {
    ret op != CT_MUL_NONE && op::u32 < CT_MUL_OP_COUNT;
}

# the operand widths a target may declare a row at
pub fun mul_width_valid(width: u8) bool {
    ret width == 8 || width == 16 || width == 32 || width == 64;
}

# the operand widths a cell may have: a 128-bit cell is never declared, it is
# admitted through the cells that realize it
pub fun mul_cell_width_valid(width: u8) bool {
    ret mul_width_valid(width) || width == 128;
}

fun mul_cond_valid(cond: CtMulCond) bool {
    ret cond::u32 < CT_MUL_COND_COUNT;
}

val MUL_OP_NAMES: [7]str = [7]str{"", "low", "high_u", "high_s", "high_su", "wide_u", "wide_s"};

# the spelling `$mach.build.ct_mul` reads, absent for NONE or an unknown tag
pub fun mul_op_name(op: CtMulOp) opt[str] {
    if (!mul_op_valid(op)) { ret opt[str].none{}; }
    ret opt[str].some{MUL_OP_NAMES[op::usize]};
}

# the valid op spellings, for a refusal that lists them
pub val MUL_OP_SPELLINGS: str = "low, high_u, high_s, high_su, wide_u, wide_s";

val MUL_BIT_WIDTHS: u64 = 5;

fun mul_bit(op: CtMulOp, width: u8) u64 {
    if (!mul_op_valid(op) || !mul_cell_width_valid(width)) { ret 0; }
    var w: u64 = 0;
    if (width == 16)  { w = 1; }
    if (width == 32)  { w = 2; }
    if (width == 64)  { w = 3; }
    if (width == 128) { w = 4; }
    ret 1::u64 << ((op::u64 - 1) * MUL_BIT_WIDTHS + w);
}

pub fun mul_mask_add(mask: *CtMulMask, cell: CtMulCell) {
    if (cell.vector) { mask.vector = mask.vector | mul_bit(cell.op, cell.width); }
    or               { mask.scalar = mask.scalar | mul_bit(cell.op, cell.width); }
}

# whether the admitted cells cover this multiply; an unknown cell never is
pub fun mul_mask_has(mask: CtMulMask, cell: CtMulCell) bool {
    val bit: u64 = mul_bit(cell.op, cell.width);
    if (bit == 0)    { ret false; }
    if (cell.vector) { ret (mask.vector & bit) != 0; }
    ret (mask.scalar & bit) != 0;
}

# why a declared row is malformed, absent for a well-formed one; `ext_domain`
# is every extension bit the ISA models
fun mul_form_refusal(form: *CtMulForm, ext_domain: u64) opt[str] {
    if (!mul_op_valid(form.op))       { ret opt[str].some{"names a multiply outside the catalog"}; }
    if (!mul_width_valid(form.width)) { ret opt[str].some{"names an operand width other than 8, 16, 32 or 64 bits"}; }
    if (form.lanes != 0)              { ret opt[str].some{"declares a lane multiply; vector multiply rows are not defined yet"}; }
    if (!mul_cond_valid(form.cond))   { ret opt[str].some{"names a condition outside the catalog"}; }
    if (form.cond == CT_MUL_EXTENSION) {
        if (form.ext == 0)                 { ret opt[str].some{"is conditioned on an extension without naming one"}; }
        if ((form.ext & ~ext_domain) != 0) { ret opt[str].some{"is conditioned on an extension the instruction set does not model"}; }
    }
    or (form.ext != 0) { ret opt[str].some{"names extension bits on a row that is not conditioned on an extension"}; }
    ret opt[str].none{};
}

# why a row table is malformed: a malformed row, a cell declared twice, or any
# row on a machine with no multiply
pub fun mul_forms_refusal(forms: *CtMulForm, len: u32, ext_domain: u64, has_mul: bool) opt[str] {
    if (len > 0 && forms == nil) { ret opt[str].some{"declares constant-time multiply rows without storage"}; }
    if (len > 0 && !has_mul)     { ret opt[str].some{"declares constant-time multiply rows on a machine with no multiply"}; }
    var i: u32 = 0;
    for (i < len) {
        val bad: opt[str] = mul_form_refusal(?forms[i], ext_domain);
        if (sel bad.some) { ret bad; }
        var j: u32 = 0;
        for (j < i) {
            if (forms[j].op == forms[i].op && forms[j].width == forms[i].width && forms[j].lanes == forms[i].lanes) {
                ret opt[str].some{"declares one constant-time multiply cell twice"};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# whether a target covers a capability; the multiply capability asks for the
# exact cell the site emits. false for every other capability, which no
# target provides (a partition, enumerated by its test)
pub fun target_provides(mul: CtMulMask, cell: CtMulCell, trust_var_shift: bool, cap: CtCap) bool {
    if (cap == CT_CAP_OK)        { ret true; }
    if (cap == CT_CAP_ALWAYS)    { ret false; }
    if (cap == CT_CAP_MUL)       { ret mul_mask_has(mul, cell); }
    if (cap == CT_CAP_VAR_SHIFT) { ret trust_var_shift; }
    ret false;
}

pub fun ct_op_gates_count_only(op: CtOp) bool {
    ret op == CT_OP_VAR_SHIFT;
}

# the two secrecy facts an inline-asm binding carries into the constant-time scan.
# `value` when the binding's own storage is secret (`^usize`, `^*T`): the register it is
# staged into holds a secret, so it is refused as an address. `pointee` when the binding is
# a pointer whose target reaches a secret (`*^T`): the register holds a public address, and a
# load through it produces a secret. a pointer to a secret is a public address and a secret
# load; a secret pointer is a secret address
pub rec BindSecrecy {
    value:   bool;
    pointee: bool;
}

pub fun bind_secrecy(value: bool, pointee: bool) BindSecrecy {
    var b: BindSecrecy;
    b.value   = value;
    b.pointee = pointee;
    ret b;
}

pub fun bind_public() BindSecrecy {
    ret bind_secrecy(false, false);
}

# true when the scan has anything to track for the binding
pub fun bind_tracked(b: BindSecrecy) bool {
    ret b.value || b.pointee;
}

# a binding the scan tracks, by the name its `{name}` operand spells
pub rec AsmSecret {
    name:    str;
    secrecy: BindSecrecy;
}

pub fun asm_secret(name: str, secrecy: BindSecrecy) AsmSecret {
    var s: AsmSecret;
    s.name    = name;
    s.secrecy = secrecy;
    ret s;
}

pub rec AsmClass {
    op: CtOp;
    # the multiply an INT_MUL instruction realizes, NONE otherwise; `mul_one`
    # when the instruction is written with its one explicit operand (x86's
    # widening forms); `mul_width` in bits, 0 for the first operand's width
    mul:           CtMulOp;
    mul_one:       CtMulOp;
    mul_width:     u8;
    mul_vector:    bool;
    known:         bool;
    cond_flags:    bool;
    cond_reg:      bool;
    flags_stated:  bool;
    writes_flags:  bool;
    defines_flags: bool;
    opaque_flags:  bool;
    reads_flags:   bool;
}

pub fun asm_unknown() AsmClass {
    var a: AsmClass;
    a.op            = CT_OP_NONE;
    a.mul           = CT_MUL_NONE;
    a.mul_one       = CT_MUL_NONE;
    a.mul_width     = 0;
    a.mul_vector    = false;
    a.known         = false;
    a.cond_flags    = false;
    a.cond_reg      = false;
    a.flags_stated  = false;
    a.writes_flags  = true;
    a.defines_flags = false;
    a.opaque_flags  = false;
    a.reads_flags   = false;
    ret a;
}

pub fun flags_untouched(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = false;
    o.defines_flags = false;
    ret o;
}

pub fun flags_defined(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = true;
    ret o;
}

pub fun flags_written(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = false;
    ret o;
}

pub fun flags_opaque(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = false;
    o.opaque_flags  = true;
    ret o;
}

pub fun flags_read(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.reads_flags   = true;
    o.writes_flags  = false;
    o.defines_flags = false;
    ret o;
}

pub fun asm_op(op: CtOp) AsmClass {
    var a: AsmClass = asm_unknown();
    a.op    = op;
    a.known = true;
    ret a;
}

# a multiply instruction realizing `mul` at its first operand's width
pub fun asm_mul(mul: CtMulOp) AsmClass {
    var a: AsmClass = asm_op(CT_OP_INT_MUL);
    a.mul     = mul;
    a.mul_one = mul;
    ret a;
}

# a multiply realizing `mul` with two or more explicit operands and `one` with
# a single one
pub fun asm_mul_forms(mul: CtMulOp, one: CtMulOp) AsmClass {
    var a: AsmClass = asm_mul(mul);
    a.mul_one = one;
    ret a;
}

# a lane multiply at a fixed lane width
pub fun asm_mul_lanes(mul: CtMulOp, lane_bits: u8) AsmClass {
    var a: AsmClass = asm_mul(mul);
    a.mul_width  = lane_bits;
    a.mul_vector = true;
    ret a;
}

# a fixed-width multiply, whatever its operands name
pub fun asm_mul_width(mul: CtMulOp, bits: u8) AsmClass {
    var a: AsmClass = asm_mul(mul);
    a.mul_width = bits;
    ret a;
}

# the cell an emitted or assembled multiply realizes, from its class, its
# count of explicit operands and its first operand's byte width
pub fun asm_mul_cell(cls: AsmClass, explicit_ops: u32, op0_bytes: u8) CtMulCell {
    var op: CtMulOp = cls.mul;
    if (explicit_ops == 1 && cls.mul_one != CT_MUL_NONE) { op = cls.mul_one; }
    var width: u32 = cls.mul_width::u32;
    if (width == 0)  { width = op0_bytes::u32 * 8; }
    if (width > 255) { width = 0; }
    ret mul_cell(op, width::u8, cls.mul_vector);
}

pub fun asm_branch_flags() AsmClass {
    var a: AsmClass = flags_untouched(asm_op(CT_OP_NONE));
    a.cond_flags = true;
    ret a;
}

pub fun asm_branch_reg() AsmClass {
    var a: AsmClass = asm_op(CT_OP_NONE);
    a.cond_reg = true;
    ret a;
}

pub fun untouched_branch_reg() AsmClass {
    var a: AsmClass = flags_untouched(asm_op(CT_OP_NONE));
    a.cond_reg = true;
    ret a;
}
