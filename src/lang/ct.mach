use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;

pub def CtOp: u8;

pub val CT_OP_NONE:       CtOp = 0;
pub val CT_OP_INT_DIVMOD: CtOp = 1;
pub val CT_OP_FLOAT:      CtOp = 2;
pub val CT_OP_INT_MUL:    CtOp = 3;
pub val CT_OP_VAR_SHIFT:  CtOp = 4;

pub def CtCap: u8;

pub val CT_CAP_OK:        CtCap = 0;
pub val CT_CAP_ALWAYS:    CtCap = 1;
pub val CT_CAP_MUL:       CtCap = 2;
pub val CT_CAP_VAR_SHIFT: CtCap = 3;

pub val CT_OP_COUNT: u32 = 5;

pub fun ct_op_valid(op: CtOp) bool {
    ret op::u32 < CT_OP_COUNT;
}

# the capability a target must provide for an operation to be constant-time,
# absent for an operation outside the catalog: an unknown operation is never
# answered with "no capability needed"
pub fun ct_cap(op: CtOp) opt[CtCap] {
    if (op == CT_OP_NONE)       { ret opt[CtCap].some{CT_CAP_OK}; }
    if (op == CT_OP_INT_DIVMOD) { ret opt[CtCap].some{CT_CAP_ALWAYS}; }
    if (op == CT_OP_FLOAT)      { ret opt[CtCap].some{CT_CAP_ALWAYS}; }
    if (op == CT_OP_INT_MUL)    { ret opt[CtCap].some{CT_CAP_MUL}; }
    if (op == CT_OP_VAR_SHIFT)  { ret opt[CtCap].some{CT_CAP_VAR_SHIFT}; }
    ret opt[CtCap].none{};
}

# tests and the sema gate: the declared capability, or the one no target
# provides for an operation outside the catalog
pub fun ct_cap_or_always(op: CtOp) CtCap {
    val cap: opt[CtCap] = ct_cap(op);
    if (sel cap.none) { ret CT_CAP_ALWAYS; }
    ret cap.some;
}

pub fun cap_at_sema(cap: CtCap) bool {
    ret cap == CT_CAP_ALWAYS;
}

pub fun cap_at_mir(cap: CtCap) bool {
    ret cap == CT_CAP_MUL || cap == CT_CAP_VAR_SHIFT;
}

# the multiply a machine instruction realizes: the low half of a same-width
# product, the high half by operand signedness, or the full double-width
# product
pub def CtMulOp: u8;

pub val CT_MUL_NONE:    CtMulOp = 0;
pub val CT_MUL_LOW:     CtMulOp = 1;
pub val CT_MUL_HIGH_U:  CtMulOp = 2;
pub val CT_MUL_HIGH_S:  CtMulOp = 3;
pub val CT_MUL_HIGH_SU: CtMulOp = 4;
pub val CT_MUL_WIDE_U:  CtMulOp = 5;
pub val CT_MUL_WIDE_S:  CtMulOp = 6;

pub val CT_MUL_OP_COUNT: u32 = 7;

# what a declared multiply row needs before its timing is data-independent
pub def CtMulCond: u8;

pub val CT_MUL_ALWAYS:    CtMulCond = 0;
pub val CT_MUL_DIT_MODE:  CtMulCond = 1;
pub val CT_MUL_EXTENSION: CtMulCond = 2;

pub val CT_MUL_COND_COUNT: u32 = 3;

# one declared row: this multiply at this operand width (and, for a lane
# multiply, this lane count) has data-independent timing under `cond`; `ext`
# names the ISA extension bits an EXTENSION row needs
pub rec CtMulForm {
    op:    CtMulOp;
    width: u8;
    lanes: u8;
    cond:  CtMulCond;
    ext:   u64;
}

# the multiply an emitted instruction realizes, at an operand width in bits;
# `vector` for a lane multiply
pub rec CtMulCell {
    op:     CtMulOp;
    width:  u8;
    vector: bool;
}

# the admitted cells, one bit per (op, width) in a scalar and a vector plane
pub rec CtMulMask {
    scalar: u64;
    vector: u64;
}

pub fun mul_cell(op: CtMulOp, width: u8, vector: bool) CtMulCell {
    ret CtMulCell{op: op, width: width, vector: vector};
}

pub fun mul_mask_none() CtMulMask {
    ret CtMulMask{scalar: 0, vector: 0};
}

pub fun mul_op_valid(op: CtMulOp) bool {
    ret op != CT_MUL_NONE && op::u32 < CT_MUL_OP_COUNT;
}

pub fun mul_width_valid(width: u8) bool {
    ret width == 8 || width == 16 || width == 32 || width == 64;
}

pub fun mul_cond_valid(cond: CtMulCond) bool {
    ret cond::u32 < CT_MUL_COND_COUNT;
}

val MUL_OP_NAMES: [7]str = [7]str{"", "low", "high_u", "high_s", "high_su", "wide_u", "wide_s"};

# the spelling `$mach.build.ct_mul` reads, absent for NONE or an unknown tag
pub fun mul_op_name(op: CtMulOp) opt[str] {
    if (!mul_op_valid(op)) { ret opt[str].none{}; }
    ret opt[str].some{MUL_OP_NAMES[op::usize]};
}

pub fun mul_op_by_name(name: str) opt[CtMulOp] {
    var i: u32 = 1;
    for (i < CT_MUL_OP_COUNT) {
        if (str_equals(MUL_OP_NAMES[i::usize], name)) { ret opt[CtMulOp].some{i::CtMulOp}; }
        i = i + 1;
    }
    ret opt[CtMulOp].none{};
}

# the valid op spellings, for a refusal that lists them
pub val MUL_OP_SPELLINGS: str = "low, high_u, high_s, high_su, wide_u, wide_s";

fun mul_bit(op: CtMulOp, width: u8) u64 {
    if (!mul_op_valid(op) || !mul_width_valid(width)) { ret 0; }
    var w: u64 = 0;
    if (width == 16) { w = 1; }
    if (width == 32) { w = 2; }
    if (width == 64) { w = 3; }
    ret 1::u64 << ((op::u64 - 1) * 4 + w);
}

pub fun mul_mask_add(mask: *CtMulMask, cell: CtMulCell) {
    if (cell.vector) { mask.vector = mask.vector | mul_bit(cell.op, cell.width); }
    or               { mask.scalar = mask.scalar | mul_bit(cell.op, cell.width); }
}

# whether the admitted cells cover this multiply; an unknown cell never is
pub fun mul_mask_has(mask: CtMulMask, cell: CtMulCell) bool {
    val bit: u64 = mul_bit(cell.op, cell.width);
    if (bit == 0)    { ret false; }
    if (cell.vector) { ret (mask.vector & bit) != 0; }
    ret (mask.scalar & bit) != 0;
}

# why a declared row is malformed, absent for a well-formed one; `ext_domain`
# is every extension bit the ISA models
pub fun mul_form_refusal(form: *CtMulForm, ext_domain: u64) opt[str] {
    if (!mul_op_valid(form.op))       { ret opt[str].some{"names a multiply outside the catalog"}; }
    if (!mul_width_valid(form.width)) { ret opt[str].some{"names an operand width other than 8, 16, 32 or 64 bits"}; }
    if (form.lanes != 0)              { ret opt[str].some{"declares a lane multiply; vector multiply rows are not defined yet"}; }
    if (!mul_cond_valid(form.cond))   { ret opt[str].some{"names a condition outside the catalog"}; }
    if (form.cond == CT_MUL_EXTENSION) {
        if (form.ext == 0)                 { ret opt[str].some{"is conditioned on an extension without naming one"}; }
        if ((form.ext & ~ext_domain) != 0) { ret opt[str].some{"is conditioned on an extension the instruction set does not model"}; }
    }
    or (form.ext != 0) { ret opt[str].some{"names extension bits on a row that is not conditioned on an extension"}; }
    ret opt[str].none{};
}

# why a row table is malformed: a malformed row, a cell declared twice, or any
# row on a machine with no multiply
pub fun mul_forms_refusal(forms: *CtMulForm, len: u32, ext_domain: u64, has_mul: bool) opt[str] {
    if (len > 0 && forms == nil) { ret opt[str].some{"declares constant-time multiply rows without storage"}; }
    if (len > 0 && !has_mul)     { ret opt[str].some{"declares constant-time multiply rows on a machine with no multiply"}; }
    var i: u32 = 0;
    for (i < len) {
        val bad: opt[str] = mul_form_refusal(?forms[i], ext_domain);
        if (sel bad.some) { ret bad; }
        var j: u32 = 0;
        for (j < i) {
            if (forms[j].op == forms[i].op && forms[j].width == forms[i].width && forms[j].lanes == forms[i].lanes) {
                ret opt[str].some{"declares one constant-time multiply cell twice"};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret opt[str].none{};
}

# whether a target covers a capability; the multiply capability asks for the
# exact cell the site emits. false for every other capability, which no
# target provides (a partition, enumerated by its test)
pub fun target_provides(mul: CtMulMask, cell: CtMulCell, trust_var_shift: bool, cap: CtCap) bool {
    if (cap == CT_CAP_OK)        { ret true; }
    if (cap == CT_CAP_ALWAYS)    { ret false; }
    if (cap == CT_CAP_MUL)       { ret mul_mask_has(mul, cell); }
    if (cap == CT_CAP_VAR_SHIFT) { ret trust_var_shift; }
    ret false;
}

pub fun ct_op_gates_count_only(op: CtOp) bool {
    ret op == CT_OP_VAR_SHIFT;
}

test "mach.lang.ct.ct_cap:table" {
    val ct_cap_r: opt[CtCap] = ct_cap(255::CtOp);
    if (sel ct_cap_r.some)                                     { ret 2; }
    if (ct_cap_or_always(255::CtOp) != CT_CAP_ALWAYS)          { ret 3; }
    if (ct_cap_or_always(CT_OP_NONE) != CT_CAP_OK)             { ret 1; }
    if (ct_cap_or_always(CT_OP_INT_DIVMOD) != CT_CAP_ALWAYS)   { ret 1; }
    if (ct_cap_or_always(CT_OP_FLOAT) != CT_CAP_ALWAYS)        { ret 1; }
    if (ct_cap_or_always(CT_OP_INT_MUL) != CT_CAP_MUL)         { ret 1; }
    if (ct_cap_or_always(CT_OP_VAR_SHIFT) != CT_CAP_VAR_SHIFT) { ret 1; }

    if (!cap_at_sema(ct_cap_or_always(CT_OP_INT_DIVMOD))) { ret 1; }
    if (!cap_at_sema(ct_cap_or_always(CT_OP_FLOAT)))      { ret 1; }
    if (!cap_at_mir(ct_cap_or_always(CT_OP_INT_MUL)))     { ret 1; }
    if (!cap_at_mir(ct_cap_or_always(CT_OP_VAR_SHIFT)))   { ret 1; }

    val low64: CtMulCell = mul_cell(CT_MUL_LOW, 64, false);
    var all:   CtMulMask = mul_mask_none();
    mul_mask_add(?all, low64);
    if (!target_provides(all, low64, false, CT_CAP_MUL))               { ret 1; }
    if (target_provides(all, low64, false, CT_CAP_VAR_SHIFT))          { ret 1; }
    if (target_provides(mul_mask_none(), low64, false, CT_CAP_ALWAYS)) { ret 1; }
    if (!target_provides(mul_mask_none(), low64, false, CT_CAP_OK))    { ret 1; }

    if (!ct_op_gates_count_only(CT_OP_VAR_SHIFT)) { ret 1; }
    if (ct_op_gates_count_only(CT_OP_INT_MUL))    { ret 1; }
    ret 0;
}

pub rec AsmClass {
    op: CtOp;
    # the multiply an INT_MUL instruction realizes, NONE otherwise; `mul_one`
    # when the instruction is written with its one explicit operand (x86's
    # widening forms); `mul_width` in bits, 0 for the first operand's width
    mul:           CtMulOp;
    mul_one:       CtMulOp;
    mul_width:     u8;
    mul_vector:    bool;
    known:         bool;
    cond_flags:    bool;
    cond_reg:      bool;
    flags_stated:  bool;
    writes_flags:  bool;
    defines_flags: bool;
    opaque_flags:  bool;
    reads_flags:   bool;
}

pub fun asm_unknown() AsmClass {
    var a: AsmClass;
    a.op            = CT_OP_NONE;
    a.mul           = CT_MUL_NONE;
    a.mul_one       = CT_MUL_NONE;
    a.mul_width     = 0;
    a.mul_vector    = false;
    a.known         = false;
    a.cond_flags    = false;
    a.cond_reg      = false;
    a.flags_stated  = false;
    a.writes_flags  = true;
    a.defines_flags = false;
    a.opaque_flags  = false;
    a.reads_flags   = false;
    ret a;
}

pub fun flags_untouched(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = false;
    o.defines_flags = false;
    ret o;
}

pub fun flags_defined(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = true;
    ret o;
}

pub fun flags_written(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = false;
    ret o;
}

pub fun flags_opaque(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = false;
    o.opaque_flags  = true;
    ret o;
}

pub fun flags_read(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.reads_flags   = true;
    o.writes_flags  = false;
    o.defines_flags = false;
    ret o;
}

pub fun asm_op(op: CtOp) AsmClass {
    var a: AsmClass = asm_unknown();
    a.op    = op;
    a.known = true;
    ret a;
}

# a multiply instruction realizing `mul` at its first operand's width
pub fun asm_mul(mul: CtMulOp) AsmClass {
    var a: AsmClass = asm_op(CT_OP_INT_MUL);
    a.mul     = mul;
    a.mul_one = mul;
    ret a;
}

# a multiply realizing `mul` with two or more explicit operands and `one` with
# a single one
pub fun asm_mul_forms(mul: CtMulOp, one: CtMulOp) AsmClass {
    var a: AsmClass = asm_mul(mul);
    a.mul_one = one;
    ret a;
}

# a lane multiply at a fixed lane width
pub fun asm_mul_lanes(mul: CtMulOp, lane_bits: u8) AsmClass {
    var a: AsmClass = asm_mul(mul);
    a.mul_width  = lane_bits;
    a.mul_vector = true;
    ret a;
}

# a fixed-width multiply, whatever its operands name
pub fun asm_mul_width(mul: CtMulOp, bits: u8) AsmClass {
    var a: AsmClass = asm_mul(mul);
    a.mul_width = bits;
    ret a;
}

# the cell an emitted or assembled multiply realizes, from its class, its
# count of explicit operands and its first operand's byte width
pub fun asm_mul_cell(cls: AsmClass, explicit_ops: u32, op0_bytes: u8) CtMulCell {
    var op: CtMulOp = cls.mul;
    if (explicit_ops == 1 && cls.mul_one != CT_MUL_NONE) { op = cls.mul_one; }
    var width: u32 = cls.mul_width::u32;
    if (width == 0)  { width = op0_bytes::u32 * 8; }
    if (width > 255) { width = 0; }
    ret mul_cell(op, width::u8, cls.mul_vector);
}

pub fun asm_branch_flags() AsmClass {
    var a: AsmClass = flags_untouched(asm_op(CT_OP_NONE));
    a.cond_flags = true;
    ret a;
}

pub fun asm_branch_reg() AsmClass {
    var a: AsmClass = asm_op(CT_OP_NONE);
    a.cond_reg = true;
    ret a;
}

pub fun untouched_branch_reg() AsmClass {
    var a: AsmClass = flags_untouched(asm_op(CT_OP_NONE));
    a.cond_reg = true;
    ret a;
}

# the role an emitted instruction gives one of its operand positions
# (isa.Inst dst, src1, src2, src3), the part of the effect description that
# ct_class does not carry: which registers a notification defines and which
# it only reads, and whether a memory operand is loaded, stored, or only its
# address computed
pub def OperandRole: u8;

pub val ROLE_NONE:  OperandRole = 0;
pub val ROLE_READ:  OperandRole = 1;
pub val ROLE_WRITE: OperandRole = 2;
pub val ROLE_RW:    OperandRole = 3;
# the address registers are read as values and no memory is accessed (lea)
pub val ROLE_ADDR: OperandRole = 4;

pub val INST_OPERANDS: u32 = 4;

pub def Transfer: u8;

pub val XFER_NONE: Transfer = 0;
# conditional: may fall through
pub val XFER_BRANCH: Transfer = 1;
# unconditional: never falls through
pub val XFER_JUMP: Transfer = 2;
# falls through after the callee returns
pub val XFER_CALL: Transfer = 3;
pub val XFER_RET:  Transfer = 4;
pub val XFER_TRAP: Transfer = 5;

pub def TargetKind: u8;

pub val TARGET_NONE: TargetKind = 0;
# a basic block of the same function
pub val TARGET_BLOCK: TargetKind = 1;
# an offset inside the same expansion or inline-asm body, backward or of
# unknown direction
pub val TARGET_LOCAL:    TargetKind = 2;
pub val TARGET_EXTERNAL: TargetKind = 3;
# through a register operand
pub val TARGET_REGISTER: TargetKind = 4;
# an offset inside the same expansion, known to lie ahead
pub val TARGET_LOCAL_FWD: TargetKind = 5;

# the complete effect description of one emitted instruction: the closed
# class table's row plus the operand roles and the implicit register and
# memory effects. masks are over general-purpose register indexes
pub rec InstEffects {
    cls:             AsmClass;
    roles:           [INST_OPERANDS]OperandRole;
    implicit_reads:  u64;
    implicit_writes: u64;
    # vector registers read without an operand naming them (sha256rnds2's xmm0)
    implicit_fp_reads: u64;
    # registers used as an address without a memory operand (rep movsb)
    implicit_addr: u64;
    # accesses memory with no explicit address (push, pop, call, ret)
    implicit_mem: bool;
    # the destination is a constant whatever the sources hold (xor r, r)
    zero_idiom: bool;
    # the shift-count position for a count-gated class, -1 otherwise
    count_pos: i8;
    # bytes a memory operand covers when not its operand size (ldp/stp)
    mem_bytes:    u8;
    xfer:         Transfer;
    target:       TargetKind;
    target_block: u32;
    # a local target's byte displacement from this instruction, 0 when the
    # encoder resolved it without recording it
    local_disp: i32;
}

pub fun inst_effects_unknown() InstEffects {
    var e: InstEffects;
    e.cls = asm_unknown();
    var k: u32 = 0;
    for (k < INST_OPERANDS) {
        e.roles[k] = ROLE_NONE;
        k          = k + 1;
    }
    e.implicit_reads    = 0;
    e.implicit_writes   = 0;
    e.implicit_fp_reads = 0;
    e.implicit_addr     = 0;
    e.implicit_mem    = false;
    e.zero_idiom      = false;
    e.count_pos       = -1;
    e.mem_bytes       = 0;
    e.xfer            = XFER_NONE;
    e.target          = TARGET_NONE;
    e.target_block    = 0;
    e.local_disp      = 0;
    ret e;
}

pub fun reg_bit(index: i32) u64 {
    if (index < 0 || index >= 64) { ret 0; }
    ret 1::u64 << index::u64;
}

test "mach.lang.ct.inst_effects_unknown:is_unknown_with_no_effects" {
    val e: InstEffects = inst_effects_unknown();
    if (e.cls.known) { ret 1; }
    var k: u32 = 0;
    for (k < INST_OPERANDS) {
        if (e.roles[k] != ROLE_NONE) { ret 2; }
        k = k + 1;
    }
    if (e.implicit_reads != 0 || e.implicit_writes != 0 || e.implicit_addr != 0)         { ret 3; }
    if (e.implicit_fp_reads != 0)                                                        { ret 7; }
    if (e.implicit_mem || e.zero_idiom || e.count_pos != -1 || e.mem_bytes != 0)         { ret 4; }
    if (e.xfer != XFER_NONE || e.target != TARGET_NONE || e.local_disp != 0)             { ret 5; }
    if (reg_bit(0) != 1 || reg_bit(11) != 0x800 || reg_bit(64) != 0 || reg_bit(-1) != 0) { ret 6; }
    ret 0;
}

test "mach.lang.ct.target_provides:partition_CtCap" {
    val cell: CtMulCell = mul_cell(CT_MUL_LOW, 32, false);
    var yes:  CtMulMask = mul_mask_none();
    mul_mask_add(?yes, cell);
    val no: CtMulMask = mul_mask_none();
    if (!target_provides(no, cell, false, CT_CAP_OK))        { ret 1; }
    if (target_provides(yes, cell, true, CT_CAP_ALWAYS))     { ret 2; }
    if (!target_provides(yes, cell, false, CT_CAP_MUL))      { ret 3; }
    if (target_provides(no, cell, true, CT_CAP_MUL))         { ret 4; }
    if (!target_provides(no, cell, true, CT_CAP_VAR_SHIFT))  { ret 5; }
    if (target_provides(yes, cell, false, CT_CAP_VAR_SHIFT)) { ret 6; }
    if (target_provides(yes, cell, true, 4::CtCap))          { ret 7; }
    # the multiply capability asks for the exact cell
    if (target_provides(yes, mul_cell(CT_MUL_LOW, 64, false), false, CT_CAP_MUL))    { ret 8; }
    if (target_provides(yes, mul_cell(CT_MUL_HIGH_U, 32, false), false, CT_CAP_MUL)) { ret 9; }
    if (target_provides(yes, mul_cell(CT_MUL_LOW, 32, true), false, CT_CAP_MUL))     { ret 10; }
    ret 0;
}

# every (op, width, plane) cell has its own bit: admitting one admits nothing
# else, and an unknown op or width is never admitted
test "mach.lang.ct.mul_mask_has:each_cell_is_its_own_bit" {
    val widths: [4]u8 = [4]u8{8, 16, 32, 64};
    var op:     u32   = 1;
    for (op < CT_MUL_OP_COUNT) {
        var wi: usize = 0;
        for (wi < 4) {
            var plane: u32 = 0;
            for (plane < 2) {
                val cell: CtMulCell = mul_cell(op::CtMulOp, widths[wi], plane == 1);
                var m:    CtMulMask = mul_mask_none();
                mul_mask_add(?m, cell);
                if (!mul_mask_has(m, cell)) { ret 1; }
                var op2: u32 = 0;
                for (op2 < CT_MUL_OP_COUNT + 1) {
                    var wj: usize = 0;
                    for (wj < 4) {
                        var p2: u32 = 0;
                        for (p2 < 2) {
                            val other: bool = op2 != op || wj != wi || p2 != plane;
                            if (other && mul_mask_has(m, mul_cell(op2::CtMulOp, widths[wj], p2 == 1))) { ret 2; }
                            p2 = p2 + 1;
                        }
                        wj = wj + 1;
                    }
                    op2 = op2 + 1;
                }
                plane = plane + 1;
            }
            wi = wi + 1;
        }
        op = op + 1;
    }
    var full: CtMulMask = CtMulMask{scalar: 0xFFFFFFFFFFFFFFFF, vector: 0xFFFFFFFFFFFFFFFF};
    if (mul_mask_has(full, mul_cell(CT_MUL_NONE, 64, false)))             { ret 3; }
    if (mul_mask_has(full, mul_cell(CT_MUL_LOW, 12, false)))              { ret 4; }
    if (mul_mask_has(full, mul_cell(CT_MUL_OP_COUNT::CtMulOp, 8, false))) { ret 5; }
    ret 0;
}

fun t_some(o: opt[str]) bool {
    ret sel o.some;
}

fun t_some_op(o: opt[CtMulOp]) bool {
    ret sel o.some;
}

test "mach.lang.ct.mul_op_name:round_trips_every_op" {
    var op: u32 = 1;
    for (op < CT_MUL_OP_COUNT) {
        val name: opt[str] = mul_op_name(op::CtMulOp);
        if (sel name.none) { ret 1; }
        val back: opt[CtMulOp] = mul_op_by_name(name.some);
        if (!(sel back.some && back.some == op::CtMulOp)) { ret 2; }
        if (!str_contains(MUL_OP_SPELLINGS, name.some))   { ret 3; }
        op = op + 1;
    }
    if (t_some(mul_op_name(CT_MUL_NONE)))              { ret 4; }
    if (t_some(mul_op_name(CT_MUL_OP_COUNT::CtMulOp))) { ret 5; }
    if (t_some_op(mul_op_by_name("")))                 { ret 6; }
    if (t_some_op(mul_op_by_name("mul")))              { ret 7; }
    ret 0;
}

# each malformed field is refused on its own, and the table refuses twins,
# rows without storage and rows on a machine with no multiply
test "mach.lang.ct.mul_forms_refusal:refuses_each_malformed_row" {
    val ext:  u64          = 0x6;
    var good: [3]CtMulForm = [3]CtMulForm{
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_ALWAYS, ext: 0},
        CtMulForm{op: CT_MUL_HIGH_SU, width: 32, lanes: 0, cond: CT_MUL_DIT_MODE, ext: 0},
        CtMulForm{op: CT_MUL_WIDE_S, width: 8, lanes: 0, cond: CT_MUL_EXTENSION, ext: 0x2}
    };
    if (t_some(mul_forms_refusal(?good[0], 3, ext, true)))   { ret 1; }
    if (t_some(mul_forms_refusal(nil, 0, 0, false)))         { ret 2; }
    if (!t_some(mul_forms_refusal(nil, 1, ext, true)))       { ret 3; }
    if (!t_some(mul_forms_refusal(?good[0], 3, ext, false))) { ret 4; }

    var bad: [8]CtMulForm = [8]CtMulForm{
        CtMulForm{op: CT_MUL_NONE, width: 64, lanes: 0, cond: CT_MUL_ALWAYS, ext: 0},
        CtMulForm{op: CT_MUL_OP_COUNT::CtMulOp, width: 64, lanes: 0, cond: CT_MUL_ALWAYS, ext: 0},
        CtMulForm{op: CT_MUL_LOW, width: 24, lanes: 0, cond: CT_MUL_ALWAYS, ext: 0},
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 2, cond: CT_MUL_ALWAYS, ext: 0},
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_COND_COUNT::CtMulCond, ext: 0},
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_EXTENSION, ext: 0},
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_EXTENSION, ext: 0x8},
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_DIT_MODE, ext: 0x2}
    };
    var i: usize = 0;
    for (i < 8) {
        if (!t_some(mul_form_refusal(?bad[i], ext)))           { ret 10 + i::i32; }
        if (!t_some(mul_forms_refusal(?bad[i], 1, ext, true))) { ret 20 + i::i32; }
        i = i + 1;
    }
    val vector_why: opt[str] = mul_form_refusal(?bad[3], ext);
    if (!(sel vector_why.some && str_contains(vector_why.some, "not defined yet"))) { ret 30; }

    var twins: [2]CtMulForm = [2]CtMulForm{
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_ALWAYS, ext: 0},
        CtMulForm{op: CT_MUL_LOW, width: 64, lanes: 0, cond: CT_MUL_DIT_MODE, ext: 0}
    };
    if (!t_some(mul_forms_refusal(?twins[0], 2, ext, true))) { ret 31; }
    ret 0;
}
