use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use O: std.types.option;

pub def CtOp: u8;

pub val CT_OP_NONE:       CtOp = 0;
pub val CT_OP_INT_DIVMOD: CtOp = 1;
pub val CT_OP_FLOAT:      CtOp = 2;
pub val CT_OP_INT_MUL:    CtOp = 3;
pub val CT_OP_VAR_SHIFT:  CtOp = 4;

pub def CtCap: u8;

pub val CT_CAP_OK:        CtCap = 0;
pub val CT_CAP_ALWAYS:    CtCap = 1;
pub val CT_CAP_MUL:       CtCap = 2;
pub val CT_CAP_VAR_SHIFT: CtCap = 3;

pub val CT_OP_COUNT: u32 = 5;

pub fun ct_op_valid(op: CtOp) bool {
    ret op::u32 < CT_OP_COUNT;
}

# the capability a target must provide for an operation to be constant-time,
# absent for an operation outside the catalog: an unknown operation is never
# answered with "no capability needed"
pub fun ct_cap(op: CtOp) O.Option[CtCap] {
    if (op == CT_OP_NONE)       { ret O.some[CtCap](CT_CAP_OK); }
    if (op == CT_OP_INT_DIVMOD) { ret O.some[CtCap](CT_CAP_ALWAYS); }
    if (op == CT_OP_FLOAT)      { ret O.some[CtCap](CT_CAP_ALWAYS); }
    if (op == CT_OP_INT_MUL)    { ret O.some[CtCap](CT_CAP_MUL); }
    if (op == CT_OP_VAR_SHIFT)  { ret O.some[CtCap](CT_CAP_VAR_SHIFT); }
    ret O.none[CtCap]();
}

# tests and the sema gate: the declared capability, or the one no target
# provides for an operation outside the catalog
pub fun ct_cap_or_always(op: CtOp) CtCap {
    val cap: O.Option[CtCap] = ct_cap(op);
    if (O.is_none[CtCap](cap)) { ret CT_CAP_ALWAYS; }
    ret O.unwrap[CtCap](cap);
}

pub fun cap_at_sema(cap: CtCap) bool {
    ret cap == CT_CAP_ALWAYS;
}

pub fun cap_at_mir(cap: CtCap) bool {
    ret cap == CT_CAP_MUL || cap == CT_CAP_VAR_SHIFT;
}

pub fun target_provides(trust_mul: bool, trust_var_shift: bool, cap: CtCap) bool {
    if (cap == CT_CAP_OK)        { ret true; }
    if (cap == CT_CAP_ALWAYS)    { ret false; }
    if (cap == CT_CAP_MUL)       { ret trust_mul; }
    if (cap == CT_CAP_VAR_SHIFT) { ret trust_var_shift; }
    ret false;
}

pub fun ct_op_gates_count_only(op: CtOp) bool {
    ret op == CT_OP_VAR_SHIFT;
}

test "mach.lang.ct.ct_cap:table" {
    if (O.is_some[CtCap](ct_cap(255::CtOp)))                   { ret 2; }
    if (ct_cap_or_always(255::CtOp)        != CT_CAP_ALWAYS)    { ret 3; }
    if (ct_cap_or_always(CT_OP_NONE)       != CT_CAP_OK)        { ret 1; }
    if (ct_cap_or_always(CT_OP_INT_DIVMOD) != CT_CAP_ALWAYS)    { ret 1; }
    if (ct_cap_or_always(CT_OP_FLOAT)      != CT_CAP_ALWAYS)    { ret 1; }
    if (ct_cap_or_always(CT_OP_INT_MUL)    != CT_CAP_MUL)       { ret 1; }
    if (ct_cap_or_always(CT_OP_VAR_SHIFT)  != CT_CAP_VAR_SHIFT) { ret 1; }

    if (!cap_at_sema(ct_cap_or_always(CT_OP_INT_DIVMOD)))  { ret 1; }
    if (!cap_at_sema(ct_cap_or_always(CT_OP_FLOAT)))       { ret 1; }
    if (!cap_at_mir(ct_cap_or_always(CT_OP_INT_MUL)))      { ret 1; }
    if (!cap_at_mir(ct_cap_or_always(CT_OP_VAR_SHIFT)))    { ret 1; }

    if (!target_provides(true, false, CT_CAP_MUL))        { ret 1; }
    if (target_provides(true, false, CT_CAP_VAR_SHIFT))   { ret 1; }
    if (target_provides(false, false, CT_CAP_ALWAYS))     { ret 1; }
    if (!target_provides(false, false, CT_CAP_OK))        { ret 1; }

    if (!ct_op_gates_count_only(CT_OP_VAR_SHIFT)) { ret 1; }
    if (ct_op_gates_count_only(CT_OP_INT_MUL))    { ret 1; }
    ret 0;
}

pub rec AsmClass {
    op:            CtOp;
    known:         bool;
    cond_flags:    bool;
    cond_reg:      bool;
    flags_stated:  bool;
    writes_flags:  bool;
    defines_flags: bool;
    opaque_flags:  bool;
    reads_flags:   bool;
}

pub fun asm_unknown() AsmClass {
    var a: AsmClass;
    a.op            = CT_OP_NONE;
    a.known         = false;
    a.cond_flags    = false;
    a.cond_reg      = false;
    a.flags_stated  = false;
    a.writes_flags  = true;
    a.defines_flags = false;
    a.opaque_flags  = false;
    a.reads_flags   = false;
    ret a;
}

pub fun flags_untouched(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = false;
    o.defines_flags = false;
    ret o;
}

pub fun flags_defined(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = true;
    ret o;
}

pub fun flags_written(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = false;
    ret o;
}

pub fun flags_opaque(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.writes_flags  = true;
    o.defines_flags = false;
    o.opaque_flags  = true;
    ret o;
}

pub fun flags_read(a: AsmClass) AsmClass {
    var o: AsmClass = a;
    o.flags_stated  = true;
    o.reads_flags   = true;
    o.writes_flags  = false;
    o.defines_flags = false;
    ret o;
}

pub fun asm_op(op: CtOp) AsmClass {
    var a: AsmClass = asm_unknown();
    a.op    = op;
    a.known = true;
    ret a;
}

pub fun asm_branch_flags() AsmClass {
    var a: AsmClass = flags_untouched(asm_op(CT_OP_NONE));
    a.cond_flags = true;
    ret a;
}

pub fun asm_branch_reg() AsmClass {
    var a: AsmClass = asm_op(CT_OP_NONE);
    a.cond_reg = true;
    ret a;
}

pub fun untouched_branch_reg() AsmClass {
    var a: AsmClass = flags_untouched(asm_op(CT_OP_NONE));
    a.cond_reg = true;
    ret a;
}

# the role an emitted instruction gives one of its operand positions
# (isa.Inst dst, src1, src2, src3), the part of the effect description that
# ct_class does not carry: which registers a notification defines and which
# it only reads, and whether a memory operand is loaded, stored, or only its
# address computed
pub def OperandRole: u8;

pub val ROLE_NONE:  OperandRole = 0;
pub val ROLE_READ:  OperandRole = 1;
pub val ROLE_WRITE: OperandRole = 2;
pub val ROLE_RW:    OperandRole = 3;
# the address registers are read as values and no memory is accessed (lea)
pub val ROLE_ADDR:  OperandRole = 4;

pub val INST_OPERANDS: u32 = 4;

pub def Transfer: u8;

pub val XFER_NONE:   Transfer = 0;
# conditional: may fall through
pub val XFER_BRANCH: Transfer = 1;
# unconditional: never falls through
pub val XFER_JUMP:   Transfer = 2;
# falls through after the callee returns
pub val XFER_CALL:   Transfer = 3;
pub val XFER_RET:    Transfer = 4;
pub val XFER_TRAP:   Transfer = 5;

pub def TargetKind: u8;

pub val TARGET_NONE:     TargetKind = 0;
# a basic block of the same function
pub val TARGET_BLOCK:    TargetKind = 1;
# an offset inside the same expansion or inline-asm body, backward or of
# unknown direction
pub val TARGET_LOCAL:     TargetKind = 2;
pub val TARGET_EXTERNAL:  TargetKind = 3;
# through a register operand
pub val TARGET_REGISTER:  TargetKind = 4;
# an offset inside the same expansion, known to lie ahead
pub val TARGET_LOCAL_FWD: TargetKind = 5;

# the complete effect description of one emitted instruction: the closed
# class table's row plus the operand roles and the implicit register and
# memory effects. masks are over general-purpose register indexes
pub rec InstEffects {
    cls:             AsmClass;
    roles:           [INST_OPERANDS]OperandRole;
    implicit_reads:  u64;
    implicit_writes: u64;
    # registers used as an address without a memory operand (rep movsb)
    implicit_addr:   u64;
    # accesses memory with no explicit address (push, pop, call, ret)
    implicit_mem:    bool;
    # the destination is a constant whatever the sources hold (xor r, r)
    zero_idiom:      bool;
    # the shift-count position for a count-gated class, -1 otherwise
    count_pos:       i8;
    # bytes a memory operand covers when not its operand size (ldp/stp)
    mem_bytes:       u8;
    xfer:            Transfer;
    target:          TargetKind;
    target_block:    u32;
    # a local target's byte displacement from this instruction, 0 when the
    # encoder resolved it without recording it
    local_disp:      i32;
}

pub fun inst_effects_unknown() InstEffects {
    var e: InstEffects;
    e.cls = asm_unknown();
    var k: u32 = 0;
    for (k < INST_OPERANDS) { e.roles[k] = ROLE_NONE; k = k + 1; }
    e.implicit_reads  = 0;
    e.implicit_writes = 0;
    e.implicit_addr   = 0;
    e.implicit_mem    = false;
    e.zero_idiom      = false;
    e.count_pos       = -1;
    e.mem_bytes       = 0;
    e.xfer            = XFER_NONE;
    e.target          = TARGET_NONE;
    e.target_block    = 0;
    e.local_disp      = 0;
    ret e;
}

pub fun reg_bit(index: i32) u64 {
    if (index < 0 || index >= 64) { ret 0; }
    ret 1::u64 << index::u64;
}

test "mach.lang.ct.inst_effects_unknown:is_unknown_with_no_effects" {
    val e: InstEffects = inst_effects_unknown();
    if (e.cls.known) { ret 1; }
    var k: u32 = 0;
    for (k < INST_OPERANDS) { if (e.roles[k] != ROLE_NONE) { ret 2; } k = k + 1; }
    if (e.implicit_reads != 0 || e.implicit_writes != 0 || e.implicit_addr != 0) { ret 3; }
    if (e.implicit_mem || e.zero_idiom || e.count_pos != -1 || e.mem_bytes != 0) { ret 4; }
    if (e.xfer != XFER_NONE || e.target != TARGET_NONE || e.local_disp != 0) { ret 5; }
    if (reg_bit(0) != 1 || reg_bit(11) != 0x800 || reg_bit(64) != 0 || reg_bit(-1) != 0) { ret 6; }
    ret 0;
}
