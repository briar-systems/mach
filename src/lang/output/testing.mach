# private output directories for writer fixtures.

use mach.lang.build.outcome;
use diagnostic_kind: mach.lang.diagnostic.kind;
use std_allocator:   std.allocator;
use std_filesystem:  std.filesystem;
use std_format:      std.format;
use io_error:        std.io.error;
use io_handle:       std.io.handle;
use std.process.env;
use system_os: std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_join;

# owns an output file and its private directory until dnit.
#[testing]
pub rec Output {
    alloc:     *std_allocator.Allocator;
    directory: str;
    file:      std_filesystem.TempFile;
    closed:    bool;
}

#[testing]
pub fun create(alloc: *std_allocator.Allocator, prefix: str) res[Output, outcome.Fail] {
    val reserved: res[std_filesystem.TempFile, std_filesystem.FsError] = std_filesystem.temp_create(alloc, prefix);
    if (sel reserved.err) { ret res[Output, outcome.Fail].err{outcome.environment(diagnostic_kind.FS_TEMP, outcome.fs_text(reserved.err))}; }
    var marker: std_filesystem.TempFile = reserved.ok;
    fin {
        std_filesystem.temp_close_and_remove(?marker);
        str_free(alloc, marker.path);
    }
    val joined: res[str, types_string.StrError] = str_join(alloc, marker.path, ".dir");
    if (sel joined.err) { ret res[Output, outcome.Fail].err{outcome.internal(outcome.str_text(joined.err))}; }
    val directory: str  = joined.ok;
    var retained:  bool = false;
    fin {
        if (!retained) { str_free(alloc, directory); }
    }
    val created: err[io_error.Error] = std_filesystem.create_dir(directory, 0o700);
    if (sel created.err) { ret res[Output, outcome.Fail].err{outcome.environment(diagnostic_kind.FS_CREATE, outcome.io_text(created.err))}; }
    fin {
        if (!retained) { std_filesystem.remove_all(alloc, directory); }
    }
    val named: res[str, types_string.StrError] = str_join(alloc, directory, "/output");
    if (sel named.err) { ret res[Output, outcome.Fail].err{outcome.internal(outcome.str_text(named.err))}; }
    val name: str = named.ok;
    fin {
        if (!retained) { str_free(alloc, name); }
    }
    var fd_handle: usize = system_os.INVALID_HANDLE;
    val fd:        i64   = system_os.open(system_os.working_dir(), name, system_os.O_CREAT | system_os.O_EXCL | system_os.O_RDWR, 0o600, ?fd_handle);
    if (fd < 0) { ret res[Output, outcome.Fail].err{outcome.environment(diagnostic_kind.FS_OPEN, system_os.error_message(fd))}; }
    retained = true;
    ret res[Output, outcome.Fail].ok{Output{alloc: alloc, directory: directory,
        file: std_filesystem.TempFile{file: std_filesystem.File{handle: io_handle.FileHandle{value: fd_handle}}, path: name}}};
}

# borrows the output path until dnit.
#[testing]
pub fun path(file: *Output) str {
    ret std_filesystem.temp_path(?file.file);
}

#[testing]
pub fun close(file: *Output) err[outcome.Fail] {
    if (file.closed) { ret err[outcome.Fail].ok{}; }
    file.closed = true;
    val closed: err[io_error.Error] = std_filesystem.temp_close(?file.file);
    if (sel closed.err) { ret err[outcome.Fail].err{outcome.environment(diagnostic_kind.FS_CLOSE, outcome.io_text(closed.err))}; }
    ret err[outcome.Fail].ok{};
}

#[testing]
pub fun dnit(file: *Output) err[outcome.Fail] {
    val closed:  err[outcome.Fail]           = close(file);
    val removed: err[std_filesystem.FsError] = std_filesystem.remove_all(file.alloc, file.directory);
    str_free(file.alloc, file.file.path);
    str_free(file.alloc, file.directory);
    if (sel closed.err)  { ret err[outcome.Fail].err{closed.err}; }
    if (sel removed.err) { ret err[outcome.Fail].err{outcome.environment(diagnostic_kind.FS_REMOVE, outcome.fs_text(removed.err))}; }
    ret err[outcome.Fail].ok{};
}

#[testing]
pub fun retain_bytes(alloc: *std_allocator.Allocator, label: str, bytes: *u8, len: usize) err[outcome.Fail] {
    val directory_result: res[opt[types_string.OwnedString], env.EnvError] = env.value(alloc, "MACH_TEST_OBJECT_EVIDENCE");
    if (sel directory_result.err)     { ret err[outcome.Fail].err{outcome.environment(diagnostic_kind.ENV_READ, outcome.env_text(directory_result.err))}; }
    if (sel directory_result.ok.none) { ret err[outcome.Fail].ok{}; }
    var owned: types_string.OwnedString = directory_result.ok.some;
    fin { types_string.owned_release(?owned); }
    val directory: str = owned.data;
    if (owned.len == 0) { ret err[outcome.Fail].err{outcome.environment(diagnostic_kind.ENV_READ, "empty object evidence directory")}; }
    val named: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}/{}", directory, label);
    if (sel named.err) { ret err[outcome.Fail].err{outcome.internal(outcome.format_text(named.err))}; }
    val name: str = named.ok;
    fin { str_free(alloc, name); }
    val copied: err[std_filesystem.FsError] = std_filesystem.write_bytes(name, bytes, len, 0o600);
    if (sel copied.err) { ret err[outcome.Fail].err{outcome.environment(diagnostic_kind.FS_WRITE, outcome.fs_text(copied.err))}; }
    ret err[outcome.Fail].ok{};
}
