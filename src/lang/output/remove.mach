# descriptor-relative removal beneath a project root: every component is
use std.types.error.err;
# opened without following symlinks so no part of the path is resolved as a
# string and a link out of the tree is refused rather than followed
use std.filesystem.removal;
use io_error:  std.io.error;
use system_os: std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

$if ($mach.build.os == $mach.os.linux)  { use native: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use native: std.system.os.darwin; }

pub val MAX_DEPTH: usize = 64;

# a failed removal names its kind; code is the native code behind it, 0 when
# the removal refused on its own
pub rec Removal {
    removed:     usize;
    failed:      bool;
    kind:        io_error.Kind;
    code:        i64;
    containment: bool;
}

pub fun message(r: Removal) str {
    if (r.containment) { ret "it escapes the project root or is reached through a symlink"; }
    if (r.code < 0)    { ret system_os.error_message(r.code); }
    ret io_error.kind_name(r.kind);
}

fun refused(kind: io_error.Kind) Removal {
    ret Removal{failed: true, kind: kind, containment: true};
}

fun native_failure(code: i64) Removal {
    val kind: io_error.Kind = system_os.error_kind(code);
    ret Removal{failed: true, kind: kind, code: code, containment: kind == io_error.NOT_DIRECTORY || kind == io_error.LOOP};
}

# open a directory entry beneath `dir` without following a symlink, writing its handle to out
pub fun open_dir(dir: usize, name: str, out: *usize) i64 {
    var flags: i32 = system_os.O_RDONLY | system_os.O_DIRECTORY;
    $if ($mach.build.os != $mach.os.windows) { flags = flags | native.O_NOFOLLOW; }
    ret system_os.open(dir, name, flags, 0, out);
}

pub fun open_path(root: str, out: *usize) i64 {
    ret system_os.open(system_os.working_dir(), root, system_os.O_RDONLY | system_os.O_DIRECTORY, 0, out);
}

# remove the tree at `rel` beneath `root_fd`, walking to the parent of the
# last component with a descriptor held at each step
pub fun relative(root_fd: usize, rel: str) Removal {
    var fd:    usize = root_fd;
    var held:  bool  = false;
    val n:     usize = str_len(rel);
    var start: usize = 0;
    var name:  [256]u8;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end - start >= 256) {
            if (held) { system_os.close(fd); }
            ret refused(io_error.NAME_TOO_LONG);
        }
        var k: usize = 0;
        for (k < end - start) {
            name[k] = rel[start + k];
            k       = k + 1;
        }
        name[k] = 0;
        if (end >= n) {
            var removed: usize              = 0;
            val result:  err[removal.Error] = removal.tree(fd, ?name[0], ?removed, MAX_DEPTH);
            if (held) { system_os.close(fd); }
            if (sel result.err) {
                val e: removal.Error = result.err;
                ret Removal{failed: true, kind: e.kind, code: e.code, containment: e.containment};
            }
            ret Removal{removed: removed};
        }
        var next:   usize = system_os.INVALID_HANDLE;
        val opened: i64   = open_dir(fd, ?name[0], ?next);
        if (held)                                               { system_os.close(fd); }
        if (system_os.error_kind(opened) == io_error.NOT_FOUND) { ret Removal{}; }
        if (opened < 0)                                         { ret native_failure(opened); }
        fd    = next;
        held  = true;
        start = end + 1;
    }
    if (held) { system_os.close(fd); }
    ret refused(io_error.INVALID);
}

use mach.lang.build.outcome;
use fixture:       mach.lang.output.testing;
use std_allocator: std.allocator;
use std.allocator.page;
use std.types.result.res;

# a nul-terminated component of `n` bytes, or nil
#[testing]
pub fun t_component(a: *std_allocator.Allocator, n: usize) str {
    val made: res[*u8, std_allocator.Error] = std_allocator.allocate[u8](a, n + 1);
    if (sel made.err) { ret nil; }
    var i: usize = 0;
    for (i < n) {
        made.ok[i] = 'a';
        i          = i + 1;
    }
    made.ok[n] = 0;
    ret made.ok::str;
}

# a removal's own refusals have no native code, so only failed and kind say they failed
test relative__refusals_fail_with_their_kind {
    var a:      std_allocator.Allocator;
    val make_r: err[std_allocator.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[fixture.Output, outcome.Fail] = fixture.create(?a, "mach-remove");
    if (sel created.err) { ret 2; }
    var owner: fixture.Output = created.ok;
    fin { fixture.dnit(?owner); }
    var root: usize = system_os.INVALID_HANDLE;
    if (open_path(owner.directory, ?root) < 0) { ret 3; }
    fin { system_os.close(root); }
    if (system_os.make_dir(root, "kept", 0o700) < 0) { ret 4; }
    val long: str = t_component(?a, 256);
    if (long == nil) { ret 5; }
    val too_long: Removal = relative(root, long);
    if (!too_long.failed || too_long.kind != io_error.NAME_TOO_LONG || !too_long.containment || too_long.code != 0) { ret 6; }
    val trailing: Removal = relative(root, "kept/");
    if (!trailing.failed || trailing.kind != io_error.INVALID || !trailing.containment || trailing.code != 0) { ret 7; }
    val absent: Removal = relative(root, "absent/leaf");
    if (absent.failed || absent.removed != 0) { ret 8; }
    val removed: Removal = relative(root, "kept");
    if (removed.failed) { ret 9; }
    var st: system_os.stat_t;
    if (system_os.error_kind(system_os.stat_path(root, "kept", ?st, system_os.AT_SYMLINK_NOFOLLOW)) != io_error.NOT_FOUND) { ret 10; }
    ret 0;
}
