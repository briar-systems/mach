# descriptor-relative removal beneath a project root: every component is
use std.types.error.err;
# opened without following symlinks so no part of the path is resolved as a
# string and a link out of the tree is refused rather than followed
use std.filesystem.removal;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

$if ($mach.build.os == $mach.os.linux)  { use native: std.system.os.linux; }
$or ($mach.build.os == $mach.os.darwin) { use native: std.system.os.darwin; }

pub val MAX_DEPTH: usize = 64;

# the pinned std exports ELOOP from neither posix os module
$if ($mach.build.os == $mach.os.linux)  { val ELOOP: i64 = -40; }
$or ($mach.build.os == $mach.os.darwin) { val ELOOP: i64 = -62; }

pub rec Removal {
    removed:     usize;
    code:        i64;
    containment: bool;
}

pub fun message(r: Removal) str {
    if (r.containment) { ret "it escapes the project root or is reached through a symlink"; }
    ret os.message(r.code);
}

# open a directory entry beneath `dirfd` without following a symlink
pub fun open_dir(dirfd: i32, name: str) i64 {
    var flags: i32 = os.O_RDONLY | os.O_DIRECTORY;
    $if ($mach.build.os != $mach.os.windows) { flags = flags | native.O_NOFOLLOW; }
    ret os.open(dirfd, name, flags, 0);
}

pub fun open_path(root: str) i64 {
    ret os.open(os.AT_FDCWD, root, os.O_RDONLY | os.O_DIRECTORY, 0);
}

fun escaped(code: i64) bool {
    if (code == os.ENOTDIR) { ret true; }
    $if ($mach.build.os != $mach.os.windows) { if (code == ELOOP) { ret true; } }
    ret false;
}

# remove the tree at `rel` beneath `root_fd`, walking to the parent of the
# last component with a descriptor held at each step
pub fun relative(root_fd: i32, rel: str) Removal {
    var fd:    i32   = root_fd;
    var held:  bool  = false;
    val n:     usize = str_len(rel);
    var start: usize = 0;
    var name:  [256]u8;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end - start >= 256) {
            if (held) { os.close(fd); }
            ret Removal{code: os.ENAMETOOLONG, containment: true};
        }
        var k: usize = 0;
        for (k < end - start) {
            name[k] = rel[start + k];
            k       = k + 1;
        }
        name[k] = 0;
        if (end >= n) {
            var removed: usize              = 0;
            val result:  err[removal.Error] = removal.tree(fd, ?name[0], ?removed, MAX_DEPTH);
            if (held) { os.close(fd); }
            if (sel result.err) { ret Removal{code: result.err.code, containment: result.err.containment}; }
            ret Removal{removed: removed};
        }
        val next: i64 = open_dir(fd, ?name[0]);
        if (held) { os.close(fd); }
        if (next == os.ENOENT) { ret Removal{}; }
        if (next < 0)          { ret Removal{code: next, containment: escaped(next)}; }
        fd    = next::i32;
        held  = true;
        start = end + 1;
    }
    if (held) { os.close(fd); }
    ret Removal{code: os.EINVAL, containment: true};
}
