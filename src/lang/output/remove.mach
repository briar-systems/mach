# descriptor-relative removal beneath a project root: every component is
# opened without following symlinks so no part of the path is resolved as a
# string and a link out of the tree is refused rather than followed
use std.types.error.err;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.host;
use A: std.allocator;
use std.filesystem.removal;
use io_error:  std.io.error;
use system_os: std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

val MAX_DEPTH: usize = 64;

# a failed removal names its kind; code is the native code behind it, 0 when
# the removal refused on its own, and cleanup_code the first close that failed
# on the way out, 0 when none did
pub rec Removal {
    removed:      usize;
    failed:       bool;
    kind:         io_error.Kind;
    code:         i64;
    containment:  bool;
    cleanup_code: i64;
}

pub fun message(r: Removal) str {
    if (r.containment) { ret "it escapes the project root or is reached through a symlink"; }
    if (r.code < 0)    { ret system_os.error_message(r.code); }
    ret io_error.kind_name(r.kind);
}

# the failure `f` reported for removal `r` of `tree`, also naming the close that
# failed on the way out when there was one
pub fun with_cleanup(a: *A.Allocator, f: fail.Fail, r: Removal, tree: str) fail.Fail {
    if (r.cleanup_code == 0) { ret f; }
    val op: fail.Op = fail.Op{verb: "close", role: "a directory beneath", path: tree};
    ret fail.with_secondary(a, f, fail.refusal(a, diagnostic_kind.FS_CLOSE, op, fail.Cause.native{r.cleanup_code}));
}

# the failure of removing `op`'s path, which `r` refused outside containment, also
# naming the close that failed on the way out
pub fun refusal(a: *A.Allocator, k: diagnostic_kind.Kind, op: fail.Op, r: Removal) fail.Fail {
    ret with_cleanup(a, fail.refusal(a, k, op, fail.Cause.text{message(r)}), r, op.path);
}

fun refused(kind: io_error.Kind) Removal {
    ret Removal{failed: true, kind: kind, containment: true};
}

fun native_failure(code: i64) Removal {
    val kind: io_error.Kind = system_os.error_kind(code);
    ret Removal{failed: true, kind: kind, code: code, containment: kind == io_error.NOT_DIRECTORY || kind == io_error.LOOP};
}

# open a directory entry beneath `dir` without following a symlink, writing its handle to out
pub fun open_dir(dir: usize, name: str, out: *usize) i64 {
    ret system_os.open(dir, name, system_os.O_RDONLY | system_os.O_DIRECTORY | host.OPEN_NOFOLLOW, 0, out);
}

pub fun open_path(root: str, out: *usize) i64 {
    ret system_os.open(system_os.working_dir(), root, system_os.O_RDONLY | system_os.O_DIRECTORY, 0, out);
}

# remove the tree at `rel` beneath `root_fd`, walking to the parent of the
# last component with a descriptor held at each step
pub fun relative(root_fd: usize, rel: str) Removal {
    var fd:    usize = root_fd;
    var held:  bool  = false;
    val n:     usize = str_len(rel);
    var start: usize = 0;
    var name:  [256]u8;
    for (start < n) {
        var end: usize = start;
        for (end < n && rel[end] != '/'::u8) { end = end + 1; }
        if (end - start >= 256) {
            # a directory opened read-only loses nothing to a refused close
            if (held) { system_os.close(fd); }
            ret refused(io_error.NAME_TOO_LONG);
        }
        var k: usize = 0;
        for (k < end - start) {
            name[k] = rel[start + k];
            k       = k + 1;
        }
        name[k] = 0;
        if (end >= n) {
            var removed: usize              = 0;
            val result:  err[removal.Error] = removal.tree(fd, ?name[0], ?removed, MAX_DEPTH);
            # a directory opened read-only loses nothing to a refused close
            if (held) { system_os.close(fd); }
            if (sel result.err) {
                val e: removal.Error = result.err;
                ret Removal{failed: true, kind: e.kind, code: e.code, containment: e.containment, cleanup_code: e.cleanup_code};
            }
            ret Removal{removed: removed};
        }
        var next:   usize = system_os.INVALID_HANDLE;
        val opened: i64   = open_dir(fd, ?name[0], ?next);
        # a directory opened read-only loses nothing to a refused close
        if (held)                                               { system_os.close(fd); }
        if (system_os.error_kind(opened) == io_error.NOT_FOUND) { ret Removal{}; }
        if (opened < 0)                                         { ret native_failure(opened); }
        fd    = next;
        held  = true;
        start = end + 1;
    }
    # a directory opened read-only loses nothing to a refused close
    if (held) { system_os.close(fd); }
    ret refused(io_error.INVALID);
}
