    out.bytes = nil;
    out.len   = 0;
    ret R.ok[QueryOutput, fail.Fail](out);
}

test "mach.lang.query.get:direct_self_recursion_reports_a_cycle_not_an_empty_value" {
    var alloc: A.Allocator;
