fun t_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) { p.live = p.live + size::i64; }
    ret r;
}

fun t_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) { p.live = p.live - old_size::i64 + new_size::i64; }
    ret r;
}

fun t_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *FailProbe = ctx::*FailProbe;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

rec FailProbe {
    backing: A.Allocator;
    calls:   u32;
    fail_at: u32;
    live:    i64;
}

fun failprobe_make(p: *FailProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.calls   = 0;
    p.fail_at = fail_at;
    p.live    = 0;
    alloc.ctx           = p::ptr;
    alloc.fn_allocate    = t_probe_allocate;
    alloc.fn_reallocate  = t_probe_reallocate;
    alloc.fn_deallocate  = t_probe_deallocate;
    ret true;
}

test "mach.lang.query.runtime:rejects_each_missing_required_capability" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);

    val no_db: res[QueryRuntime[TestQueryContext], fail.Fail] = runtime[TestQueryContext](nil, t_dispatch);
    if (sel no_db.ok) {
        diagnostic.store_dnit(?diags);
        ret 1;
    }

    val db_r: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel db_r.err) { diagnostic.store_dnit(?diags); ret 1; }
    var db: QueryDb = db_r.ok;

    val no_compute: res[QueryRuntime[TestQueryContext], fail.Fail] = runtime[TestQueryContext](?db, nil::TestComputeFn);
    if (sel no_compute.ok) {
        dnit(?db);
        diagnostic.store_dnit(?diags);
        ret 1;
    }

    dnit(?db);
    diagnostic.store_dnit(?diags);
    ret 0;
}

test "mach.lang.query.get:diag_capture_failure_after_a_successful_compute_is_fatal" {
    var saw_capture_failure: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= 80) {
        var db_alloc: A.Allocator;
        var probe: FailProbe;
        if (!failprobe_make(?probe, ?db_alloc, 0)) { ret 1; }

        var diag_alloc: A.Allocator;
        page.make(?diag_alloc);

        val db_r: res[QueryDb, fail.Fail] = init(?db_alloc);
        if (sel db_r.err) { ret 1; }
        var db: QueryDb = db_r.ok;
        var ctx: TestQueryContext;
        if (!t_context_init_with(?ctx, ?db, ?diag_alloc, T_MODE_OWNED_DIAG)) { dnit(?db); ret 1; }
        t_live = 0;

        val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
        if (sel register_input_r.err) {
            dnit(?db); t_context_dnit(?ctx); ret 1;
        }
        val register_derived_owned_r: err[fail.Fail] = register_derived_owned(?db, Q_PARSE, t_owned_finalize);
        if (sel register_derived_owned_r.err) {
            dnit(?db); t_context_dnit(?ctx); ret 1;
        }
        val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "x"::*u8, 1);
        if (sel set_input_r.err) {
            dnit(?db); t_context_dnit(?ctx); ret 1;
        }

        val opened: res[Operation, fail.Fail] = begin(?db);
        if (sel opened.err) { dnit(?db); t_context_dnit(?ctx); ret 2; }
        val operation: Operation = opened.ok;
        probe.calls = 0;
        probe.fail_at = fail_at;
        val get_r: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1);
        probe.fail_at = 0;
        val ended: err[fail.Fail] = end(?db, operation);
        var code: i32 = 0;
        if (ctx.diagnostic_refused) {
            saw_capture_failure = true;
            if (sel get_r.ok || sel ended.ok) { code = 3; }
        }
        if (sel get_r.err) {
            if (!fail.is_message(get_r.err)
                || sel ended.ok || t_live != 0 || shard_len(?db, Q_PARSE) != 0) { code = 4; }
        }
        if (sel get_r.ok) {
            if (sel ended.err || t_live != 1) { code = 5; }
        }
        val t_present_r: err[fail.Fail] = t_present(?ctx, operation, Q_PARSE, 1);
        if (sel t_present_r.err) { code = 6; }
        if (sel get_r.err) {
            val ready: res[bool, fail.Fail] = t_reusable(?ctx, Q_PARSE, 1);
            if (sel ready.err) { code = 7; }
            if (sel ready.ok) { if (ready.ok) { code = 8; } }
            t_diag_reset(?ctx);
            val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
            if (sel t_get_r.err) { code = 9; }
            if (t_live != 1 || diagnostic.len(?ctx.diags) != 1) { code = 10; }
        }
        if (code != 0) { dnit(?db); t_context_dnit(?ctx); ret code; }

        probe.fail_at = 0;
        dnit(?db);
        t_context_dnit(?ctx);
        if (t_live != 0 || probe.live != 0) { ret 1; }
        fail_at = fail_at + 1;
    }

    if (!saw_capture_failure) { ret 1; }
    ret 0;
}

test "mach.lang.query.get:diag_replay_failure_on_a_cache_hit_is_surfaced" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val db_r: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel db_r.err) { ret 1; }
    var db: QueryDb = db_r.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_DIAG)) { dnit(?db); ret 1; }

    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
    if (sel register_derived_r.err) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "x"::*u8, 1);
    if (sel set_input_r.err) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel t_get_r.err) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }

    diagnostic.store_dnit(?ctx.diags);
    var replay_alloc: A.Allocator;
    var probe: FailProbe;
    if (!failprobe_make(?probe, ?replay_alloc, 1)) { dnit(?db); ret 1; }
    ctx.diags = diagnostic.store_init(?replay_alloc);

    val replay_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel replay_r.ok) {
        probe.fail_at = 0;
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (diagnostic.len(?ctx.diags) != 0) {
        probe.fail_at = 0;
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (probe.calls == 0) {
        probe.fail_at = 0;
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }

    probe.calls   = 0;
    probe.fail_at = 0;
    val t_get_r2: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel t_get_r2.err) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (diagnostic.len(?ctx.diags) != 1) { dnit(?db); t_context_dnit(?ctx); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

