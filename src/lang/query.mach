    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel res_buf.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;
    buf[0] = 7;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

