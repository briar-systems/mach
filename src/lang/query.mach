    if (!R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_SEMA, 1))) { dnit(?db); ret 1; }
    if (db.stack.len != 0)                                { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

