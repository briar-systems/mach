    val g: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ctx, Q_TOKENIZE, key);
    if (sel g.err) { ret res[QueryOutput, fail.Fail].err{g.err}; }
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel res_buf.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;
    buf[0] = 3;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

test "mach.lang.query.get:allocation_failure_during_automatic_dependency_capture_fails_closed" {
    var saw_failure: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= 40) {
        var pa: A.Allocator;
        var probe: FailProbe;
        if (!failprobe_make(?probe, ?pa, 0)) { ret 1; }

        val res_db: res[QueryDb, fail.Fail] = init(?pa);
        if (sel res_db.err) { ret 1; }
        var db: QueryDb = res_db.ok;
        var ctx: TestQueryContext;
        if (!t_context_init(?ctx, ?db, T_MODE_AUTO_DEP)) { dnit(?db); ret 1; }

        val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
        if (sel register_input_r.err)                        { dnit(?db); ret 1; }
        val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
        if (sel register_derived_r.err) { dnit(?db); ret 1; }
        val register_derived_r2: err[fail.Fail] = register_derived(?db, Q_PARSE);
        if (sel register_derived_r2.err)    { dnit(?db); ret 1; }

        val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
        if (sel set_input_r.err) { dnit(?db); ret 1; }
        val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
        if (sel t_get_r.err)              { dnit(?db); ret 1; }

        val opened: res[Operation, fail.Fail] = begin(?db);
        if (sel opened.err) { dnit(?db); t_context_dnit(?ctx); ret 2; }
        val operation: Operation = opened.ok;
        probe.calls = 0;
        probe.fail_at = fail_at;
        val res_g: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1);
        probe.fail_at = 0;
        val ended: err[fail.Fail] = end(?db, operation);
        var code: i32 = 0;
        if (sel res_g.err) {
            saw_failure = true;
            if (!fail.is_message(res_g.err)
                || sel ended.ok || shard_len(?db, Q_PARSE) != 0) { code = 3; }
        }
        if (sel res_g.ok) {
            if (sel ended.err || res_g.ok.dep_len != 1) { code = 4; }
        }
        val t_present_r: err[fail.Fail] = t_present(?ctx, operation, Q_PARSE, 1);
        if (sel t_present_r.err) { code = 5; }
        if (sel res_g.err) {
            val ready: res[bool, fail.Fail] = t_reusable(?ctx, Q_PARSE, 1);
            if (sel ready.err) { code = 6; }
            if (sel ready.ok) { if (ready.ok) { code = 7; } }
            val retry: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
            if (sel retry.err) { code = 8; }
            if (sel retry.ok) {
                val entry: *QueryEntry = retry.ok;
                if (entry.dep_len != 1 || entry.deps[0].kind != Q_TOKENIZE || entry.deps[0].key != 1
                    || !entry.deps[0].observed || entry.value_len != 1 || entry.value[0] != 3) { code = 9; }
            }
            val valid: res[bool, fail.Fail] = t_reusable(?ctx, Q_PARSE, 1);
            if (sel valid.err) { code = 10; }
            if (sel valid.ok) { if (!valid.ok) { code = 11; } }
        }
        if (code != 0) { dnit(?db); t_context_dnit(?ctx); ret code; }

        dnit(?db);
        t_context_dnit(?ctx);
        if (probe.live != 0) { ret 12; }
        fail_at = fail_at + 1;
    }

    if (!saw_failure) { ret 1; }
    ret 0;
}

rec GrowLoopProbe {
    allocate_calls:   u32;
    reallocate_calls: u32;
}

fun growloop_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret opt[ptr].none{};
}

fun growloop_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun growloop_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.query.storage_grow:refuses_a_u32_doubling_that_wraps_without_hanging" {
    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    var db: QueryDb;
    db.a           = ?pa;
    db.storage     = nil;
    db.storage_cap = 0x80000000;
    db.kinds       = 0;

    val outcome_r: err[fail.Fail] = storage_grow(?db, 0x80000001);
    if (sel outcome_r.ok)    { ret 1; }
    if (probe.allocate_calls != 0)    { ret 1; }
    if (probe.reallocate_calls != 0)  { ret 1; }
    ret 0;
}

test "mach.lang.query.deps_reserve:refuses_an_initial_u32_doubling_that_wraps_without_hanging" {
    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    var db: QueryDb;
    db.a = ?pa;

    var entry: QueryEntry;
    entry.deps    = nil;
    entry.dep_len = 0;
    entry.dep_cap = 0;

    val outcome_r: err[fail.Fail] = deps_reserve(?db, ?entry, 0x80000001);
    if (sel outcome_r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.query.deps_reserve:refuses_a_grown_u32_doubling_that_wraps_without_hanging" {
    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
