    val rd2: err[fail.Fail] = depend[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel rd2.err) { ret res[QueryOutput, fail.Fail].err{rd2.err}; }
    val g: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel g.err) { ret res[QueryOutput, fail.Fail].err{g.err}; }
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel res_buf.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;
    buf[0] = 9;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

