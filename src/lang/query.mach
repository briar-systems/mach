}

test "mach.lang.query.set_input:identical_bytes_early_cutoff" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_FAIL)) { dnit(?db); ret 1; }

    val register_input_r: err[fail.Fail] = register_input(?db, Q_PROJECT_ROOT);
    if (sel register_input_r.err) { dnit(?db); ret 1; }

    val set_input_r: err[fail.Fail] = set_input(?db, Q_PROJECT_ROOT, 1, "hello"::*u8, 5);
    if (sel set_input_r.err) { dnit(?db); ret 1; }
    val res_entry_a: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PROJECT_ROOT, 1);
    if (sel res_entry_a.err) { dnit(?db); ret 1; }
    val lc_a: Revision = res_entry_a.ok.last_changed;

    val set_input_r2: err[fail.Fail] = set_input(?db, Q_PROJECT_ROOT, 1, "hello"::*u8, 5);
    if (sel set_input_r2.err) { dnit(?db); ret 1; }
    val res_entry_b: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PROJECT_ROOT, 1);
    if (sel res_entry_b.err) { dnit(?db); ret 1; }
    val lc_b: Revision = res_entry_b.ok.last_changed;
    if (lc_b != lc_a) { dnit(?db); ret 1; }

    val set_input_r3: err[fail.Fail] = set_input(?db, Q_PROJECT_ROOT, 1, "world"::*u8, 5);
    if (sel set_input_r3.err) { dnit(?db); ret 1; }
    val res_entry_c: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PROJECT_ROOT, 1);
    if (sel res_entry_c.err) { dnit(?db); ret 1; }
    val lc_c: Revision = res_entry_c.ok.last_changed;
    if (lc_c <= lc_a) { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

test "mach.lang.query.get:derived_dep_tracking_early_cutoff" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_TOKENIZE)) { dnit(?db); ret 1; }

    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err)                 { dnit(?db); ret 1; }
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
    if (sel register_derived_r.err) { dnit(?db); ret 1; }

    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 7, "v1"::*u8, 2);
    if (sel set_input_r.err) { dnit(?db); ret 1; }
    val res_warm: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 7);
    if (sel res_warm.err) { dnit(?db); ret 1; }
    val lc_warm: Revision = res_warm.ok.last_changed;

    val set_input_r2: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 7, "v2"::*u8, 2);
    if (sel set_input_r2.err) { dnit(?db); ret 1; }
    val res_v2: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 7);
    if (sel res_v2.err) { dnit(?db); ret 1; }
    val lc_v2: Revision = res_v2.ok.last_changed;

    val set_input_r3: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 7, "v1"::*u8, 2);
    if (sel set_input_r3.err) { dnit(?db); ret 1; }
    val res_v1: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 7);
    if (sel res_v1.err) { dnit(?db); ret 1; }
    val lc_v1: Revision = res_v1.ok.last_changed;

    if (lc_v2 != lc_warm) { dnit(?db); ret 1; }
    if (lc_v1 != lc_warm) { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

test "mach.lang.query.register_derived_owned:finalizer_frees_artifacts" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_OWNED)) { dnit(?db); ret 1; }
    t_live = 0;

    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err)                                        { dnit(?db); ret 1; }
    val register_derived_owned_r: err[fail.Fail] = register_derived_owned(?db, Q_PARSE, t_owned_finalize);
    if (sel register_derived_owned_r.err) { dnit(?db); ret 1; }

    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
    if (sel set_input_r.err) { dnit(?db); ret 1; }
    val res_g1: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel res_g1.err) { dnit(?db); ret 1; }
    if (t_live != 1)                        { dnit(?db); ret 1; }
    val p1: ptr = t_handle_ptr(res_g1.ok);

    val set_input_r2: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
    if (sel set_input_r2.err) { dnit(?db); ret 1; }
    val res_g2: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel res_g2.err)                        { dnit(?db); ret 1; }
    if (t_live != 1)                                               { dnit(?db); ret 1; }
    if (t_handle_ptr(res_g2.ok) != p1) { dnit(?db); ret 1; }

    val set_input_r3: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r3.err) { dnit(?db); ret 1; }
    val res_g3: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel res_g3.err)                        { dnit(?db); ret 1; }
    if (t_live != 1)                                               { dnit(?db); ret 1; }
    if (t_handle_ptr(res_g3.ok) == p1) { dnit(?db); ret 1; }

    val set_input_r4: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 2, "c"::*u8, 1);
    if (sel set_input_r4.err) { dnit(?db); ret 1; }
    val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 2);
    if (sel t_get_r.err)                 { dnit(?db); ret 1; }
    if (t_live != 2)                                                      { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    if (t_live != 0) { ret 1; }
    ret 0;
}

fun t_diag_reset(ctx: *TestQueryContext) {
    val a: *A.Allocator = ctx.diags.a;
    diagnostic.store_dnit(?ctx.diags);
    ctx.diags = diagnostic.store_init(a);
}

fun t_emit_diag(diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = 1;
    ret diagnostic.error(diags, 0, span, "query diagnostic");
}

fun t_inner_diag_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val db: *QueryDb = ctx.runtime.db;
    val rd: err[fail.Fail] = depend[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel rd.err) { ret res[QueryOutput, fail.Fail].err{rd.err}; }
    val de: err[fail.Fail] = t_emit_diag(diags);
    if (sel de.err) { ret res[QueryOutput, fail.Fail].err{de.err}; }
    val rb: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel rb.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;
    buf[0] = 1;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

fun t_outer_diag_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val db: *QueryDb = ctx.runtime.db;
    val rd: err[fail.Fail] = depend[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel rd.err) { ret res[QueryOutput, fail.Fail].err{rd.err}; }
    val de: err[fail.Fail] = t_emit_diag(diags);
    if (sel de.err) { ret res[QueryOutput, fail.Fail].err{de.err}; }
    val g: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ctx, Q_TOKENIZE, key);
    if (sel g.err) { ret res[QueryOutput, fail.Fail].err{g.err}; }
    val rb: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel rb.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(rb.err)}; }
    val buf: *u8 = rb.ok;
    buf[0] = 2;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

test "mach.lang.query.get:reused_entry_replays_diagnostics" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_DIAG)) { dnit(?db); ret 1; }

    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err)                        { dnit(?db); ret 1; }
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
    if (sel register_derived_r.err) { dnit(?db); ret 1; }
    val register_derived_r2: err[fail.Fail] = register_derived(?db, Q_PARSE);
    if (sel register_derived_r2.err)    { dnit(?db); ret 1; }
    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "x"::*u8, 1);
    if (sel set_input_r.err)             { dnit(?db); ret 1; }

    t_diag_reset(?ctx);
    val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel t_get_r.err) { dnit(?db); ret 1; }
    if (diagnostic.len(?ctx.diags) != 1)                      { dnit(?db); ret 1; }

    t_diag_reset(?ctx);
    val t_get_r2: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel t_get_r2.err) { dnit(?db); ret 1; }
    if (diagnostic.len(?ctx.diags) != 1)                      { dnit(?db); ret 1; }

    t_diag_reset(?ctx);
    val t_get_r3: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel t_get_r3.err) { dnit(?db); ret 1; }
    if (diagnostic.len(?ctx.diags) != 2)                   { dnit(?db); ret 1; }

    t_diag_reset(?ctx);
    val t_get_r4: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel t_get_r4.err) { dnit(?db); ret 1; }
    if (diagnostic.len(?ctx.diags) != 2)                   { dnit(?db); ret 1; }

    val invalidate_r: err[fail.Fail] = invalidate(?db, Q_PARSE, 1);
    if (sel invalidate_r.err) { dnit(?db); ret 1; }
    if (shard_len(?db, Q_PARSE) != 0)                     { dnit(?db); ret 1; }

    t_diag_reset(?ctx);
    val t_get_r5: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel t_get_r5.err) { dnit(?db); ret 1; }
    if (diagnostic.len(?ctx.diags) != 2)                   { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

fun t_direct_tokenize_recompute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val g: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ctx, Q_TOKENIZE, key);
    if (sel g.err) { ret res[QueryOutput, fail.Fail].err{g.err}; }
    val seen: *QueryEntry = g.ok;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel res_buf.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;
    buf[0] = 0;
    if (seen.value != nil && seen.value_len > 0) { buf[0] = seen.value[0]; }
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

test "mach.lang.query.get:a_stale_entry_under_recomputation_is_a_cycle_not_its_old_value" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_TOKENIZE)) { dnit(?db); ret 1; }

    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err)    { dnit(?db); ret 1; }
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
    if (sel register_derived_r.err)   { dnit(?db); ret 1; }
    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
    if (sel set_input_r.err) { dnit(?db); ret 1; }

    val first: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel first.err)                 { dnit(?db); ret 1; }
    val complete: *QueryEntry = first.ok;
    if (complete.value == nil || complete.value[0] != 42)        { dnit(?db); ret 1; }

    val set_input_r2: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r2.err) { dnit(?db); ret 1; }
    val valid_1: res[bool, fail.Fail] = t_reusable(?ctx, Q_TOKENIZE, 1);
    if (sel valid_1.err) { dnit(?db); ret 1; }
    if (valid_1.ok)                          { dnit(?db); ret 1; }

    ctx.mode = T_MODE_DIRECT_TOKENIZE;
    val again: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel again.ok)                { dnit(?db); ret 1; }
    if (!str_contains(fail.describe(again.err), "query cycle")) { dnit(?db); ret 1; }
    if (db.stack.len != 0)                                       { dnit(?db); ret 1; }
    val valid_2: res[bool, fail.Fail] = t_reusable(?ctx, Q_TOKENIZE, 1);
    if (sel valid_2.err) { dnit(?db); ret 1; }
    if (valid_2.ok)                          { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

fun t_direct_cycle_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val g: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ctx, Q_SEMA, key);
    if (sel g.err) { ret res[QueryOutput, fail.Fail].err{g.err}; }
    var out: QueryOutput;
    out.bytes = nil;
    out.len   = 0;
    ret res[QueryOutput, fail.Fail].ok{out};
}

