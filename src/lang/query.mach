use mach.lang.build.outcome;
use std.types.canonical.res;
use std.types.canonical.err;
use std.types.canonical.opt;
use page: std.allocator.page;
use map: std.collections.map;
use std.collections.map.Map;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use format: std.format;
use std.memory;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;

use A: std.allocator;

use mach.lang.handle;
use mach.lang.diagnostic;
use mach.lang.fe.token;
use mach.lang.layout;
use mach.lang.textbuild;
use mach.lang.fail;

pub def QueryKind: u16;

pub val Q_PROJECT_ROOT: QueryKind = 0;
pub val Q_TARGET: QueryKind = 1;
pub val Q_FILE_TEXT: QueryKind = 2;
pub val Q_TOKENIZE: QueryKind = 3;
pub val Q_PARSE: QueryKind = 4;
pub val Q_MODULE_ID_FOR_FQN: QueryKind = 5;
pub val Q_COMPTIME_CTX: QueryKind = 6;
pub val Q_RESOLVE: QueryKind = 7;
pub val Q_EXPORTS: QueryKind = 8;
pub val Q_SEMA: QueryKind = 9;
pub val Q_LOWER: QueryKind = 10;
pub val Q_CODEGEN: QueryKind = 11;
pub val Q_LINK: QueryKind = 12;
pub val Q_TYPED_EXPORTS: QueryKind = 13;
pub val Q_MODULE_NUMBER: QueryKind = 14;
pub val Q_LINK_CONFIG: QueryKind = 15;
pub val Q_LOWERED_SURFACE: QueryKind = 17;
pub val Q_EMBED_FILE: QueryKind = 18;
pub val Q_CODEGEN_FLAGS: QueryKind = 19;
pub val Q_GATE_TERMINAL: QueryKind = 20;
pub val Q_INLINE_BODIES: QueryKind = 21;
pub val Q_CELL_SNAPSHOT: QueryKind = 22;

pub def Revision: u64;

pub def ShardRole: u8;

pub val SHARD_INPUT:    ShardRole = 0;
pub val SHARD_DERIVED:  ShardRole = 1;
pub val SHARD_METADATA: ShardRole = 2;

pub def FinalizeFn: fun(*u8, u32, *A.Allocator);

pub rec MetadataRevision {
    present: bool;
    revision: Revision;
}

pub def RevisionFn: fun(ptr, u64) res[MetadataRevision, fail.Fail];

pub rec RevisionProvider {
    context: ptr;
    read: RevisionFn;
}

pub rec QueryKey {
    kind: QueryKind;
    key: u64;
}

# a handle on one query operation: the span between begin and end in which products are
# computed and validated. it is stale once end ran and collect or discard released the
# presentation; every entry point that takes one refuses a stale or foreign handle
# ---
# owner: the QueryDb that issued it
# sequence: the operation number, unique within the db
pub rec Operation {
    owner: ptr;
    sequence: u64;
}

pub rec PreparedQuery {
    operation: Operation;
    key: QueryKey;
}

# what collect hands the caller after an operation: the diagnostics of every product
# reachable from the roots, copied into a store the caller's allocator owns, and the
# operation's failure if it had one. released with presentation_dnit, exactly once
# ---
# alloc: owns the presentation and its store
# diags: the collected diagnostics, in dependency order, each product once
# failure: the operation's failure; absent when every product computed
# message: the failure's text when one was recorded, owned by the db's allocator
pub rec Presentation {
    alloc: *A.Allocator;
    diags: diagnostic.DiagnosticStore;
    failure: opt[fail.Fail];
    message: str;
    message_alloc: *A.Allocator;
}

rec MetadataSample {
    key: QueryKey;
    value: MetadataRevision;
}

rec Attempt {
    key: QueryKey;
    prepared: *QueryEntry;
    fresh: bool;
    cancelled: bool;
    failed: bool;
    evidence: QueryEntry;
}

pub rec QueryOutput {
    bytes: *u8;
    len:   u32;
}

pub rec Dep {
    kind:         QueryKind;
    key:          u64;
    last_changed: Revision;
    diagnostics_changed: Revision;
    present: bool;
    observed: bool;
}

# a borrowed view of a published product's bytes. valid only inside the operation that
# produced it and until the next set_input, invalidate, retirement or teardown of the db;
# the caller never frees it
# ---
# value: the bytes the product published, owned by the db or the product's finalizer
# value_len: their length
# last_changed: the revision the bytes last changed at
pub rec QueryView {
    value: *u8;
    value_len: u32;
    last_changed: Revision;
}

rec QueryEntry {
    key:          u64;
    value:        *u8;
    value_len:    u32;
    last_changed: Revision;
    deps:         *Dep;
    dep_len:      u32;
    dep_cap:      u32;
    diags:        *diagnostic.DiagnosticStore;
    diagnostics_changed: Revision;
    ready: bool;
}

pub rec QueryEntryDomain {}

rec QueryIndexEntry {
    key: u64;
    id:  handle.HandleId[QueryEntryDomain];
}

rec StackFrame {
    kind:  QueryKind;
    key:   u64;
    entry: *QueryEntry;
}

pub rec QueryShard {
    kind:       QueryKind;
    role:       ShardRole;
    revisions:  RevisionProvider;
    finalize:   FinalizeFn;
    equal: fun(*u8, u32, *u8, u32) bool;
    registered: bool;
    entries:    handle.HandleTable[QueryEntry, QueryEntryDomain];
    index:      Vector[QueryIndexEntry];
    by_key:     Map[u64, handle.HandleId[QueryEntryDomain]];
}

pub rec QueryDb {
    a:            *A.Allocator;
    revision:     Revision;
    storage:      *QueryShard;
    storage_cap:  u32;
    kinds:        u32;
    compute_depth: u32;
    stack:        Vector[StackFrame];
    prepared_count: usize;
    operation_sequence: u64;
    operation_active: bool;
    presentation_pending: bool;
    operation_failure: opt[fail.Fail];
    operation_message: str;
    attempts: Vector[Attempt];
    attempt_index: Map[QueryKey, usize];
    validated: Map[QueryKey, Revision];
    metadata: Vector[MetadataSample];
    metadata_index: Map[QueryKey, usize];
}

pub rec QueryCapabilities[T] {
    compute: fun(*T, QueryKind, u64, *A.Allocator, *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail];
}

pub rec QueryRuntime[T] {
    db:    *QueryDb;
    caps:  QueryCapabilities[T];
}

val INITIAL_DEP_CAP: u32 = 4;

val FIRST_REVISION: Revision = 1;

# a database over a caller-owned allocator; register every kind before the first begin
# and tear down with dnit, which runs every owned product's finalizer
# ---
# a: owns the db, its shards and every derived product's bytes
pub fun init(a: *A.Allocator) res[QueryDb, fail.Fail] {
    var db: QueryDb;
    db.a             = a;
    db.revision      = FIRST_REVISION;
    db.storage       = nil;
    db.storage_cap   = 0;
    db.kinds         = 0;
    db.compute_depth = 0;
    db.stack         = vector.init[StackFrame](a);
    db.prepared_count = 0;
    db.operation_sequence = 0;
    db.operation_active = false;
    db.presentation_pending = false;
    db.operation_failure = opt[fail.Fail].none{};
    db.operation_message = nil;
    db.attempts = vector.init[Attempt](a);
    db.attempt_index = map.init[QueryKey, usize](a, query_key_hash, query_key_equal);
    db.validated = map.init[QueryKey, Revision](a, query_key_hash, query_key_equal);
    db.metadata = vector.init[MetadataSample](a);
    db.metadata_index = map.init[QueryKey, usize](a, query_key_hash, query_key_equal);
    ret res[QueryDb, fail.Fail].ok{db};
}

# tear the database down: every owned product's finalizer runs on its bytes, every shard
# and the operation state are released. nil is a no-op
pub fun dnit(db: *QueryDb) {
    if (db == nil) { ret; }

    attempts_clear(db);
    if (db.operation_message != nil) { str_free(db.a, db.operation_message); db.operation_message = nil; }
    vector.dnit[Attempt](?db.attempts);
    map.dnit[QueryKey, usize](?db.attempt_index);

    if (db.storage != nil) {
        var i: u32 = 0;
        for (i < db.kinds) {
            shard_entries_free(db, ?db.storage[i]);
            i = i + 1;
        }
        if (db.storage_cap > 0) {
            A.deallocate[QueryShard](db.a, db.storage, db.storage_cap::usize);
        }
    }

    vector.dnit[StackFrame](?db.stack);
    map.dnit[QueryKey, Revision](?db.validated);
    vector.dnit[MetadataSample](?db.metadata);
    map.dnit[QueryKey, usize](?db.metadata_index);
    db.operation_active = false;

    db.storage     = nil;
    db.storage_cap = 0;
    db.kinds       = 0;
    db.revision    = 0;
}

pub fun register_input(db: *QueryDb, kind: QueryKind) err[fail.Fail] {
    ret register(db, kind, SHARD_INPUT, RevisionProvider{});
}

pub fun register_derived(db: *QueryDb, kind: QueryKind) err[fail.Fail] {
    ret register(db, kind, SHARD_DERIVED, RevisionProvider{});
}

pub fun register_derived_owned(db: *QueryDb, kind: QueryKind, finalize: FinalizeFn) err[fail.Fail] {
    val res_register: err[fail.Fail] = register(db, kind, SHARD_DERIVED, RevisionProvider{});
    if (sel res_register.err) { ret res_register; }

    val sh: *QueryShard = ?db.storage[kind::u32];
    sh.finalize = finalize;
    ret err[fail.Fail].ok{};
}

pub fun register_derived_equatable(db: *QueryDb, kind: QueryKind, finalize: FinalizeFn,
                                  equal: fun(*u8, u32, *u8, u32) bool) err[fail.Fail] {
    if (finalize == nil || equal == nil) { ret err[fail.Fail].err{fail.message("owned query equality requires a finalizer and comparator")}; }
    val registered: err[fail.Fail] = register_derived_owned(db, kind, finalize);
    if (sel registered.err) { ret registered; }
    db.storage[kind::u32].equal = equal;
    ret err[fail.Fail].ok{};
}

pub fun register_metadata(db: *QueryDb, kind: QueryKind, provider: RevisionProvider) err[fail.Fail] {
    if (provider.read == nil) { ret err[fail.Fail].err{fail.message("metadata query requires a revision provider")}; }
    ret register(db, kind, SHARD_METADATA, provider);
}

pub fun runtime[T](db: *QueryDb, compute: fun(*T, QueryKind, u64, *A.Allocator, *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail]) res[QueryRuntime[T], fail.Fail] {
    if (db == nil) { ret res[QueryRuntime[T], fail.Fail].err{fail.message("query runtime requires a database")}; }
    if (compute == nil) { ret res[QueryRuntime[T], fail.Fail].err{fail.message("query runtime requires a compute capability")}; }
    var caps: QueryCapabilities[T];
    caps.compute = compute;
    var rt: QueryRuntime[T];
    rt.db    = db;
    rt.caps  = caps;
    ret res[QueryRuntime[T], fail.Fail].ok{rt};
}

fun query_key_hash(raw: ptr) u64 {
    val key: *QueryKey = raw::*QueryKey;
    var mixed: u64 = key.key ^ (key.kind::u64 * 0x9e3779b97f4a7c15);
    mixed = (mixed ^ (mixed >> 30)) * 0xbf58476d1ce4e5b9;
    mixed = (mixed ^ (mixed >> 27)) * 0x94d049bb133111eb;
    ret mixed ^ (mixed >> 31);
}

fun query_key_equal(left: ptr, right: ptr) bool {
    val a: *QueryKey = left::*QueryKey;
    val b: *QueryKey = right::*QueryKey;
    ret a.kind == b.kind && a.key == b.key;
}

# open an operation. one is open at a time, and the previous one's presentation must
# have been collected or discarded first; the validated set and metadata samples of the
# last operation are cleared
# ---
# db: the database
# ret: the handle every get, prepare and end of this operation takes
pub fun begin(db: *QueryDb) res[Operation, fail.Fail] {
    if (db == nil) { ret res[Operation, fail.Fail].err{fail.message("query operation requires a database")}; }
    if (db.operation_active || db.stack.len != 0) { ret res[Operation, fail.Fail].err{fail.message("query operation is already active")}; }
    if (db.presentation_pending) { ret res[Operation, fail.Fail].err{fail.message("collect or discard the previous query presentation first")}; }
    if (db.operation_sequence == ~(0::u64)) { ret res[Operation, fail.Fail].err{fail.message("query operation sequence exhausted")}; }
    map.clear[QueryKey, Revision](?db.validated);
    map.clear[QueryKey, usize](?db.metadata_index);
    db.metadata.len = 0;
    db.operation_sequence = db.operation_sequence + 1;
    db.operation_active = true;
    db.operation_failure = opt[fail.Fail].none{};
    ret res[Operation, fail.Fail].ok{Operation{ owner: db::ptr, sequence: db.operation_sequence }};
}

# close an operation: no computation may be on the stack and no prepared product may be
# unfinished. the operation's presentation becomes pending and must be collected or
# discarded before the next begin. err carries the failure the operation recorded, or a
# metadata provider that changed under it; the presentation is pending either way
# ---
# db: the database
# operation: the handle begin returned
pub fun end(db: *QueryDb, operation: Operation) err[fail.Fail] {
    if (db == nil || operation.owner != db::ptr || !db.operation_active || operation.sequence != db.operation_sequence) {
        ret err[fail.Fail].err{fail.message("query operation is stale or belongs to another database")};
    }
    if (db.stack.len != 0) { ret err[fail.Fail].err{fail.message("cannot end a query operation during computation")}; }
    if (db.prepared_count != 0) { ret err[fail.Fail].err{fail.message("cannot end a query operation with unfinished prepared products")}; }
    fin {
        db.operation_active = false;
        db.presentation_pending = true;
    }
    if (sel db.operation_failure.some) { ret err[fail.Fail].err{db.operation_failure.some}; }
    var i: usize = 0;
    for (i < db.metadata.len) {
        val sample: MetadataSample = db.metadata.data[i];
        val provider: RevisionProvider = db.storage[sample.key.kind::u32].revisions;
        val current: res[MetadataRevision, fail.Fail] = provider.read(provider.context, sample.key.key);
        if (sel current.err) {
            ret err[fail.Fail].err{operation_fail(db, current.err)};
        }
        val value: MetadataRevision = current.ok;
        if (value.present != sample.value.present || value.revision != sample.value.revision) {
            ret err[fail.Fail].err{operation_fail(db, fail.message("external query metadata changed during the operation"))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# records the operation's failure (the first message wins over a later one,
# a reported failure never displaces a message) and answers the failure the
# operation now carries
fun operation_fail(db: *QueryDb, failure: fail.Fail) fail.Fail {
    if (sel db.operation_failure.some) {
        if (fail.is_message(db.operation_failure.some)) { ret db.operation_failure.some; }
        if (sel failure.reported) { ret db.operation_failure.some; }
    }
    if (sel failure.reported) { db.operation_failure = opt[fail.Fail].some{failure}; ret failure; }
    val copied: res[str, A.Error] = str_dup(db.a, fail.describe(failure));
    if (sel copied.err) {
        val refused: fail.Fail = fail.refused(copied.err);
        db.operation_failure = opt[fail.Fail].some{refused};
        ret refused;
    }
    db.operation_message = copied.ok;
    val recorded: fail.Fail = fail.message(db.operation_message);
    db.operation_failure = opt[fail.Fail].some{recorded};
    ret recorded;
}

fun attempt_prepare(db: *QueryDb, key: QueryKey) res[usize, fail.Fail] {
    var lookup: QueryKey = key;
    val prior: opt[*usize] = map.get[QueryKey, usize](?db.attempt_index, ?lookup);
    if (sel prior.some) { ret res[usize, fail.Fail].ok{@prior.some}; }
    val index: usize = db.attempts.len;
    val added: res[usize, A.Error] = vector.push[Attempt](?db.attempts, Attempt{ key: key });
    if (sel added.err) { ret res[usize, fail.Fail].err{fail.refused(added.err)}; }
    val indexed: res[bool, A.Error] = map.insert[QueryKey, usize](?db.attempt_index, key, index);
    if (sel indexed.err) {
        db.attempts.len = index;
        ret res[usize, fail.Fail].err{fail.refused(indexed.err)};
    }
    ret res[usize, fail.Fail].ok{index};
}

fun attempt_preserve(db: *QueryDb, sh: *QueryShard, index: usize, candidate: *QueryEntry) {
    val attempt: *Attempt = ?db.attempts.data[index];
    attempt.failed = true;
    attempt.evidence.deps = candidate.deps;
    attempt.evidence.dep_len = candidate.dep_len;
    attempt.evidence.dep_cap = candidate.dep_cap;
    attempt.evidence.diags = candidate.diags;
    candidate.deps = nil;
    candidate.dep_len = 0;
    candidate.dep_cap = 0;
    candidate.diags = nil;
    entry_free(db, sh, candidate);
}

fun attempts_clear(db: *QueryDb) {
    var i: usize = 0;
    for (i < db.attempts.len) {
        val attempt: *Attempt = ?db.attempts.data[i];
        if (attempt.prepared != nil) {
            entry_free(db, ?db.storage[attempt.key.kind::u32], attempt.prepared);
            A.deallocate[QueryEntry](db.a, attempt.prepared, 1);
        }
        entry_free(db, ?db.storage[attempt.key.kind::u32], ?attempt.evidence);
        i = i + 1;
    }
    db.attempts.len = 0;
    db.prepared_count = 0;
    map.clear[QueryKey, usize](?db.attempt_index);
}

# release a pending presentation without collecting it: the attempts, the failure and
# its message are dropped and the db accepts the next begin
# ---
# db: the database
# operation: the ended operation's handle
pub fun discard(db: *QueryDb, operation: Operation) err[fail.Fail] {
    if (db == nil || operation.owner != db::ptr || operation.sequence != db.operation_sequence
        || db.operation_active || !db.presentation_pending) {
        ret err[fail.Fail].err{fail.message("query presentation is stale or not ready")};
    }
    attempts_clear(db);
    if (db.operation_message != nil) { str_free(db.a, db.operation_message); db.operation_message = nil; }
    map.clear[QueryKey, Revision](?db.validated);
    map.clear[QueryKey, usize](?db.metadata_index);
    db.metadata.len = 0;
    db.operation_failure = opt[fail.Fail].none{};
    db.presentation_pending = false;
    ret err[fail.Fail].ok{};
}

# take ownership of the ended operation's failure text before discarding it; the string
# is allocated by the db's allocator and the caller frees it. nil when none was recorded
# ---
# db: the database
# operation: the ended operation's handle
pub fun take_failure_message(db: *QueryDb, operation: Operation) res[str, fail.Fail] {
    if (db == nil || operation.owner != db::ptr || operation.sequence != db.operation_sequence
        || db.operation_active || !db.presentation_pending) {
        ret res[str, fail.Fail].err{fail.message("query failure message is stale or not ready")};
    }
    val message: str = db.operation_message;
    db.operation_message = nil;
    ret res[str, fail.Fail].ok{message};
}

# collect the ended operation's presentation: the diagnostics of every product reachable
# from the roots through recorded dependencies, each once, plus the operation's failure
# and message, then discard the pending state. on success the operation is over; on a
# failure nothing was released and the presentation is still pending
# ---
# db: the database
# operation: the ended operation's handle
# roots: the products to walk from; nil only with count 0
# count: how many roots
# a: owns the returned presentation
# ret: the presentation, released with presentation_dnit, or the copy failure
pub fun collect(db: *QueryDb, operation: Operation, roots: *QueryKey, count: usize,
                a: *A.Allocator) res[*Presentation, fail.Fail] {
    if (db == nil || operation.owner != db::ptr || operation.sequence != db.operation_sequence
        || db.operation_active || !db.presentation_pending) {
        ret res[*Presentation, fail.Fail].err{fail.message("query presentation is stale or not ready")};
    }
    if (roots == nil && count != 0) { ret res[*Presentation, fail.Fail].err{fail.message("query presentation roots are nil")}; }
    val allocated: res[*Presentation, A.Error] = A.allocate[Presentation](a, 1);
    if (sel allocated.err) { ret res[*Presentation, fail.Fail].err{fail.refused(allocated.err)}; }
    val result: *Presentation = allocated.ok;
    result.alloc = a;
    result.diags = diagnostic.store_init(a);
    result.failure = opt[fail.Fail].none{};
    result.message = nil;
    result.message_alloc = db.a;
    val store: *diagnostic.DiagnosticStore = ?result.diags;
    var complete: bool = false;
    fin {
        if (!complete) {
            presentation_dnit(result);
        }
    }
    var visited: Map[QueryKey, u8] = map.init[QueryKey, u8](a, query_key_hash, query_key_equal);
    fin { map.dnit[QueryKey, u8](?visited); }
    var i: usize = 0;
    for (i < count) {
        val copied: err[fail.Fail] = collect_node(db, roots[i], ?visited, store);
        if (sel copied.err) { ret res[*Presentation, fail.Fail].err{copied.err}; }
        i = i + 1;
    }
    result.failure = db.operation_failure;
    result.message = db.operation_message;
    db.operation_message = nil;
    val released: err[fail.Fail] = discard(db, operation);
    if (sel released.err) { ret res[*Presentation, fail.Fail].err{released.err}; }
    complete = true;
    ret res[*Presentation, fail.Fail].ok{result};
}

# release a presentation, its store and its failure text; nil is a no-op
pub fun presentation_dnit(p: *Presentation) {
    if (p == nil) { ret; }
    val a: *A.Allocator = p.alloc;
    diagnostic.store_dnit(?p.diags);
    if (p.message != nil) { str_free(p.message_alloc, p.message); }
    A.deallocate[Presentation](a, p, 1);
}

fun collect_node(db: *QueryDb, key: QueryKey, visited: *Map[QueryKey, u8],
                 into: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var lookup: QueryKey = key;
    val prior: opt[*u8] = map.get[QueryKey, u8](visited, ?lookup);
    if (sel prior.some) {
        if (@prior.some == 1) { ret err[fail.Fail].err{fail.message("query diagnostic provenance contains a cycle")}; }
        ret err[fail.Fail].ok{};
    }
    val entered: res[bool, A.Error] = map.insert[QueryKey, u8](visited, key, 1);
    if (sel entered.err) { ret err[fail.Fail].err{fail.refused(entered.err)}; }
    var entry: *QueryEntry = nil;
    val attempted: opt[*usize] = map.get[QueryKey, usize](?db.attempt_index, ?lookup);
    if (sel attempted.some) {
        val attempt: *Attempt = ?db.attempts.data[@attempted.some];
        if (attempt.failed) { entry = ?attempt.evidence; }
    }
    if (entry == nil) {
        val current: opt[*Revision] = map.get[QueryKey, Revision](?db.validated, ?lookup);
        if (sel current.some) {
            if (@current.some != 0) {
                val sh: *QueryShard = ?db.storage[key.kind::u32];
                entry = entry_find(sh, key.key);
                if (entry == nil || !entry.ready || entry.last_changed != @current.some) {
                    ret err[fail.Fail].err{fail.message("query presentation owner changed after validation")};
                }
        }
        }
    }
    if (entry != nil) {
        var i: u32 = 0;
        for (i < entry.dep_len) {
            val dep: Dep = entry.deps[i];
            val copied: err[fail.Fail] = collect_node(db, QueryKey{ kind: dep.kind, key: dep.key }, visited, into);
            if (sel copied.err) { ret copied; }
            i = i + 1;
        }
        if (entry.diags != nil) {
            if (entry.diags.lost != 0) { ret err[fail.Fail].err{fail.message("query diagnostics contain a lost emission")}; }
            val copied: err[fail.Fail] = diagnostic.replay_into(into, entry.diags);
            if (sel copied.err) { ret copied; }
        }
    }
    val state: opt[*u8] = map.get[QueryKey, u8](visited, ?lookup);
    if (sel state.none) { ret err[fail.Fail].err{fail.message("query cycle walk lost a visited entry")}; }
    @state.some = 2;
    ret err[fail.Fail].ok{};
}

fun sample_metadata(db: *QueryDb, kind: QueryKind, key: u64) res[MetadataRevision, fail.Fail] {
    if (!db.operation_active) { ret res[MetadataRevision, fail.Fail].err{fail.message("metadata read requires an active query operation")}; }
    val sr: res[*QueryShard, fail.Fail] = shard_get(db, kind);
    if (sel sr.err) { ret res[MetadataRevision, fail.Fail].err{sr.err}; }
    val sh: *QueryShard = sr.ok;
    if (sh.role != SHARD_METADATA) { ret res[MetadataRevision, fail.Fail].err{fail.message("metadata read requires a metadata query")}; }
    var pair: QueryKey = QueryKey{ kind: kind, key: key };
    val prior: opt[*usize] = map.get[QueryKey, usize](?db.metadata_index, ?pair);
    if (sel prior.some) { ret res[MetadataRevision, fail.Fail].ok{db.metadata.data[@prior.some].value}; }
    val read: res[MetadataRevision, fail.Fail] = sh.revisions.read(sh.revisions.context, key);
    if (sel read.err) { ret read; }
    val value: MetadataRevision = read.ok;
    val index: usize = db.metadata.len;
    val pushed: res[usize, A.Error] = vector.push[MetadataSample](?db.metadata, MetadataSample{ key: pair, value: value });
    if (sel pushed.err) { ret res[MetadataRevision, fail.Fail].err{fail.refused(pushed.err)}; }
    val indexed: res[bool, A.Error] = map.insert[QueryKey, usize](?db.metadata_index, pair, index);
    if (sel indexed.err) {
        db.metadata.len = index;
        ret res[MetadataRevision, fail.Fail].err{fail.refused(indexed.err)};
    }
    ret res[MetadataRevision, fail.Fail].ok{value};
}

pub fun is_registered(db: *QueryDb, kind: QueryKind) bool {
    if (kind::u32 >= db.kinds) { ret false; }
    ret (?db.storage[kind::u32]).registered;
}

fun next_revision(db: *QueryDb) res[Revision, fail.Fail] {
    if (db.revision == ~(0::Revision)) { ret res[Revision, fail.Fail].err{fail.message("query revision sequence exhausted")}; }
    db.revision = db.revision + 1;
    ret res[Revision, fail.Fail].ok{db.revision};
}

pub fun set_input(db: *QueryDb, kind: QueryKind, key: u64, value: *u8, value_len: u32) err[fail.Fail] {
    if (db.operation_active || db.presentation_pending) { ret err[fail.Fail].err{fail.message("cannot change query inputs before the operation is released")}; }
    val res_shard: res[*QueryShard, fail.Fail] = shard_get(db, kind);
    if (sel res_shard.err) { ret err[fail.Fail].err{res_shard.err}; }
    val sh: *QueryShard = res_shard.ok;
    if (sh.role != SHARD_INPUT) { ret err[fail.Fail].err{fail.message("set_input: kind is not an input query")}; }
    if (value_len != 0 && value == nil) { ret err[fail.Fail].err{fail.message("input bytes are nil")}; }
    var entry: *QueryEntry = entry_find(sh, key);
    if (entry != nil && entry.ready && entry.value_len == value_len
        && memory.raw_equal(entry.value::ptr, value::ptr, value_len::usize)) { ret err[fail.Fail].ok{}; }
    if (db.revision == ~(0::Revision)) { ret err[fail.Fail].err{fail.message("query revision sequence exhausted")}; }
    val copied: res[*u8, fail.Fail] = bytes_dup(db.a, value, value_len);
    if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
    val bytes: *u8 = copied.ok;
    if (entry == nil) {
        val added: res[*QueryEntry, fail.Fail] = entry_append(db, sh, key);
        if (sel added.err) {
            if (bytes != nil && value_len != 0) { A.deallocate[u8](db.a, bytes, value_len::usize); }
            ret err[fail.Fail].err{added.err};
        }
        entry = added.ok;
    }
    if (entry.value != nil && entry.value_len != 0) { A.deallocate[u8](db.a, entry.value, entry.value_len::usize); }
    entry.value = bytes;
    entry.value_len = value_len;
    entry.ready = true;
    val next_revision_r: res[Revision, fail.Fail] = next_revision(db);
    if (sel next_revision_r.err) { ret err[fail.Fail].err{next_revision_r.err}; }
    entry.last_changed = next_revision_r.ok;
    ret err[fail.Fail].ok{};
}

pub fun invalidate(db: *QueryDb, kind: QueryKind, key: u64) err[fail.Fail] {
    if (db.operation_active || db.presentation_pending) { ret err[fail.Fail].err{fail.message("cannot retire a query before the operation is released")}; }
    val res_shard: res[*QueryShard, fail.Fail] = shard_get(db, kind);
    if (sel res_shard.err) { ret err[fail.Fail].err{res_shard.err}; }
    val sh: *QueryShard = res_shard.ok;
    if (entry_find(sh, key) == nil) { ret err[fail.Fail].ok{}; }
    val rev: res[Revision, fail.Fail] = next_revision(db);
    if (sel rev.err) { ret err[fail.Fail].err{rev.err}; }
    entry_remove(db, sh, key);
    ret err[fail.Fail].ok{};
}

pub rec PreparedRetirement {
    owner: *QueryDb;
    operation: u64;
    revision: Revision;
    keys: Vector[QueryKey];
    selected: Map[QueryKey, usize];
}

rec RetireNode {
    key: QueryKey;
    entry: *QueryEntry;
    first: usize;
    dependents: usize;
    selected: bool;
}

rec RetireEdge {
    dependent: usize;
    next: usize;
}

pub fun discard_retirement(prepared: *PreparedRetirement) {
    if (prepared.owner == nil) { ret; }
    vector.dnit[QueryKey](?prepared.keys);
    map.dnit[QueryKey, usize](?prepared.selected);
    prepared.owner = nil;
}

pub fun prepare_retirement(db: *QueryDb, roots: *QueryKey, count: usize) res[PreparedRetirement, fail.Fail] {
    if (db == nil || db.operation_active || db.presentation_pending) {
        ret res[PreparedRetirement, fail.Fail].err{fail.message("cannot prepare query retirement during query use")};
    }
    if (roots == nil && count != 0) { ret res[PreparedRetirement, fail.Fail].err{fail.message("retirement roots are nil")}; }
    var prepared: PreparedRetirement = PreparedRetirement{
        owner: db, operation: db.operation_sequence, revision: db.revision,
        keys: vector.init[QueryKey](db.a), selected: map.init[QueryKey, usize](db.a, query_key_hash, query_key_equal)
    };
    var complete: bool = false;
    fin { if (!complete) { discard_retirement(?prepared); } }
    var nodes: Vector[RetireNode] = vector.init[RetireNode](db.a);
    fin { vector.dnit[RetireNode](?nodes); }
    var edges: Vector[RetireEdge] = vector.init[RetireEdge](db.a);
    fin { vector.dnit[RetireEdge](?edges); }
    var pending: Vector[usize] = vector.init[usize](db.a);
    fin { vector.dnit[usize](?pending); }
    var index: Map[QueryKey, usize] = map.init[QueryKey, usize](db.a, query_key_hash, query_key_equal);
    fin { map.dnit[QueryKey, usize](?index); }
    var kind: u32 = 0;
    for (kind < db.kinds) {
        val sh: *QueryShard = ?db.storage[kind];
        if (sh.entries.editing) { ret res[PreparedRetirement, fail.Fail].err{fail.message("query shard has an active editor")}; }
        var j: usize = 0;
        for (j < sh.index.len) {
            val indexed: QueryIndexEntry = sh.index.data[j];
            val entry: res[*QueryEntry, handle.Error] = handle.get[QueryEntry, QueryEntryDomain](?sh.entries, indexed.id);
            if (sel entry.err) { ret res[PreparedRetirement, fail.Fail].err{fail.message(handle.text(entry.err))}; }
            val key: QueryKey = QueryKey{ kind: kind::QueryKind, key: indexed.key };
            val added: res[usize, A.Error] = vector.push[RetireNode](?nodes,
                RetireNode{ key: key, entry: entry.ok, first: ~(0::usize) });
            if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
            val mapped: res[bool, A.Error] = map.insert[QueryKey, usize](?index, key, nodes.len - 1);
            if (sel mapped.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(mapped.err)}; }
            j = j + 1;
        }
        kind = kind + 1;
    }
    var i: usize = 0;
    for (i < count) {
        var key: QueryKey = roots[i];
        if (key.kind::u32 >= db.kinds || !db.storage[key.kind::u32].registered) {
            ret res[PreparedRetirement, fail.Fail].err{fail.message("retirement root kind is not registered")};
        }
        val get_r: opt[*usize] = map.get[QueryKey, usize](?index, ?key);
        if (sel get_r.none) {
            val added: res[usize, A.Error] = vector.push[RetireNode](?nodes,
                RetireNode{ key: key, first: ~(0::usize) });
            if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
            val mapped: res[bool, A.Error] = map.insert[QueryKey, usize](?index, key, nodes.len - 1);
            if (sel mapped.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(mapped.err)}; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < nodes.len) {
        val entry: *QueryEntry = nodes.data[i].entry;
        if (entry == nil) { i = i + 1; cnt; }
        var j: u32 = 0;
        for (j < entry.dep_len) {
            var key: QueryKey = QueryKey{ kind: entry.deps[j].kind, key: entry.deps[j].key };
            val found: opt[*usize] = map.get[QueryKey, usize](?index, ?key);
            if (sel found.some) {
                val child: usize = @found.some;
                val added: res[usize, A.Error] = vector.push[RetireEdge](?edges,
                    RetireEdge{ dependent: i, next: nodes.data[child].first });
                if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
                nodes.data[child].first = edges.len - 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        var key: QueryKey = roots[i];
        val found: opt[*usize] = map.get[QueryKey, usize](?index, ?key);
        if (sel found.some) {
            val n: usize = @found.some;
            if (!nodes.data[n].selected) {
                nodes.data[n].selected = true;
                val added: res[usize, A.Error] = vector.push[usize](?pending, n);
                if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < pending.len) {
        var edge: usize = nodes.data[pending.data[i]].first;
        for (edge != ~(0::usize)) {
            val n: usize = edges.data[edge].dependent;
            if (!nodes.data[n].selected) {
                nodes.data[n].selected = true;
                val added: res[usize, A.Error] = vector.push[usize](?pending, n);
                if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
            }
            edge = edges.data[edge].next;
        }
        i = i + 1;
    }
    val selected: usize = pending.len;
    pending.len = 0;
    i = 0;
    for (i < nodes.len) {
        if (nodes.data[i].selected) {
            var edge: usize = nodes.data[i].first;
            for (edge != ~(0::usize)) {
                if (nodes.data[edges.data[edge].dependent].selected) {
                    nodes.data[i].dependents = nodes.data[i].dependents + 1;
                }
                edge = edges.data[edge].next;
            }
            if (nodes.data[i].dependents == 0) {
                val added: res[usize, A.Error] = vector.push[usize](?pending, i);
                if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < pending.len) {
        val node: RetireNode = nodes.data[pending.data[i]];
        val added: res[usize, A.Error] = vector.push[QueryKey](?prepared.keys, node.key);
        if (sel added.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(added.err)}; }
        var j: u32 = 0;
        for (node.entry != nil && j < node.entry.dep_len) {
            var key: QueryKey = QueryKey{ kind: node.entry.deps[j].kind, key: node.entry.deps[j].key };
            val found: opt[*usize] = map.get[QueryKey, usize](?index, ?key);
            if (sel found.some) {
                val child: usize = @found.some;
                if (nodes.data[child].selected) {
                    nodes.data[child].dependents = nodes.data[child].dependents - 1;
                    if (nodes.data[child].dependents == 0) {
                        val queued: res[usize, A.Error] = vector.push[usize](?pending, child);
                        if (sel queued.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(queued.err)}; }
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (prepared.keys.len != selected) { ret res[PreparedRetirement, fail.Fail].err{fail.message("query retirement contains a dependency cycle")}; }
    if (selected != 0 && db.revision == ~(0::Revision)) { ret res[PreparedRetirement, fail.Fail].err{fail.message("query revision sequence exhausted")}; }
    kind = 0;
    for (kind < db.kinds) {
        val sh: *QueryShard = ?db.storage[kind];
        var removals: usize = 0;
        i = 0;
        for (i < sh.index.len) {
            val item: QueryIndexEntry = sh.index.data[i];
            var key: QueryKey = QueryKey{ kind: kind::QueryKind, key: item.key };
            val found: opt[*usize] = map.get[QueryKey, usize](?index, ?key);
            if (sel found.some && nodes.data[@found.some].selected) {
                if (item.id.generation == ~(0::u32)) { ret res[PreparedRetirement, fail.Fail].err{fail.message("query handle generation exhausted")}; }
                removals = removals + 1;
            }
            i = i + 1;
        }
        if (removals::u64 > (~(0::u64)) - sh.entries.store_epoch) { ret res[PreparedRetirement, fail.Fail].err{fail.message("query shard generation exhausted")}; }
        val reserved: res[usize, A.Error] = vector.reserve[usize](?sh.entries.free_list, removals);
        if (sel reserved.err) { ret res[PreparedRetirement, fail.Fail].err{fail.refused(reserved.err)}; }
        kind = kind + 1;
    }
    i = 0;
    for (i < nodes.len) {
        if (!nodes.data[i].selected) {
            var key: QueryKey = nodes.data[i].key;
            map.remove[QueryKey, usize](?index, ?key);
        }
        i = i + 1;
    }
    map.dnit[QueryKey, usize](?prepared.selected);
    prepared.selected = index;
    index = map.init[QueryKey, usize](db.a, query_key_hash, query_key_equal);
    complete = true;
    ret res[PreparedRetirement, fail.Fail].ok{prepared};
}

pub fun validate_retirement(prepared: *PreparedRetirement) err[fail.Fail] {
    val db: *QueryDb = prepared.owner;
    if (db == nil || db.operation_active || db.presentation_pending || db.operation_sequence != prepared.operation
        || db.revision != prepared.revision) { ret err[fail.Fail].err{fail.message("prepared query retirement is stale")}; }
    ret err[fail.Fail].ok{};
}

pub fun commit_retirement(prepared: *PreparedRetirement) err[fail.Fail] {
    val valid: err[fail.Fail] = validate_retirement(prepared);
    if (sel valid.err) { ret valid; }
    val db: *QueryDb = prepared.owner;
    if (prepared.keys.len != 0) {
        db.revision = db.revision + 1;
        var i: usize = 0;
        for (i < prepared.keys.len) {
            val key: QueryKey = prepared.keys.data[i];
            val sh: *QueryShard = ?db.storage[key.kind::u32];
            val entry: *QueryEntry = entry_find(sh, key.key);
            if (entry != nil) { entry_free(db, sh, entry); }
            i = i + 1;
        }
        var kind: u32 = 0;
        for (kind < db.kinds) {
            val sh: *QueryShard = ?db.storage[kind];
            var write: usize = 0;
            i = 0;
            for (i < sh.index.len) {
                val item: QueryIndexEntry = sh.index.data[i];
                var key: QueryKey = QueryKey{ kind: kind::QueryKind, key: item.key };
                val get_r: opt[*usize] = map.get[QueryKey, usize](?prepared.selected, ?key);
                if (sel get_r.some) {
                    val edit_r: res[handle.HandleEditor[QueryEntry, QueryEntryDomain], handle.Error] = handle.edit[QueryEntry, QueryEntryDomain](?sh.entries);
                    if (sel edit_r.err) { ret err[fail.Fail].err{fail.message(handle.text(edit_r.err))}; }
                    var editor: handle.HandleEditor[QueryEntry, QueryEntryDomain] = edit_r.ok;
                    val editor_remove_r: res[QueryEntry, handle.Error] = handle.editor_remove[QueryEntry, QueryEntryDomain](?editor, item.id);
                    handle.editor_finish[QueryEntry, QueryEntryDomain](?editor);
                    if (sel editor_remove_r.err) { ret err[fail.Fail].err{fail.message(handle.text(editor_remove_r.err))}; }
                    var removed: u64 = item.key;
                    map.remove[u64, handle.HandleId[QueryEntryDomain]](?sh.by_key, ?removed);
                }
                if (sel get_r.none) {
                    sh.index.data[write] = item;
                    write = write + 1;
                }
                i = i + 1;
            }
            sh.index.len = write;
            kind = kind + 1;
        }
    }
    discard_retirement(prepared);
    ret err[fail.Fail].ok{};
}

# successful end permits serial reads until the next begin, input mutation, or retirement
# the current value of a product, computing or revalidating it inside the open operation
# and recording it as a dependency of the product being computed, if any
# ---
# rt: the runtime whose compute callback builds derived products
# ctx: the callback's context
# kind: the registered kind
# key: the product's key within the kind
# ret: a borrowed view (QueryView's lifetime), or the product's failure
pub fun get[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) res[QueryView, fail.Fail] {
    val acquired: res[*QueryEntry, fail.Fail] = acquire_entry[T](rt, ctx, kind, key);
    if (sel acquired.err) { ret res[QueryView, fail.Fail].err{acquired.err}; }
    val entry: *QueryEntry = acquired.ok;
    ret res[QueryView, fail.Fail].ok{QueryView{ value: entry.value, value_len: entry.value_len, last_changed: entry.last_changed }};
}

# validation may refresh dependencies but never computes the requested product
pub fun reusable[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) res[bool, fail.Fail] {
    if (rt == nil || rt.db == nil || ctx == nil || rt.caps.compute == nil) {
        ret res[bool, fail.Fail].err{fail.message("query reuse requires a complete runtime")};
    }
    val db: *QueryDb = rt.db;
    if (!db.operation_active || db.stack.len != 0) {
        ret res[bool, fail.Fail].err{fail.message("query reuse requires an active owner-thread operation")};
    }
    if (sel db.operation_failure.some) { ret res[bool, fail.Fail].err{db.operation_failure.some}; }
    val result: res[bool, fail.Fail] = reusable_inner[T](rt, ctx, kind, key);
    if (sel result.err) {
        ret res[bool, fail.Fail].err{operation_fail(db, result.err)};
    }
    ret result;
}

fun reusable_inner[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) res[bool, fail.Fail] {
    val db: *QueryDb = rt.db;
    val found: res[*QueryShard, fail.Fail] = shard_get(db, kind);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    val sh: *QueryShard = found.ok;
    if (sh.role != SHARD_DERIVED) { ret res[bool, fail.Fail].err{fail.message("query reuse requires a derived product")}; }
    var pair: QueryKey = QueryKey{ kind: kind, key: key };
    val pending: opt[*usize] = map.get[QueryKey, usize](?db.attempt_index, ?pair);
    if (sel pending.some && (db.attempts.data[@pending.some].prepared != nil
        || db.attempts.data[@pending.some].cancelled)) {
        ret res[bool, fail.Fail].err{fail.message("query product is awaiting owner completion")};
    }
    val entry: *QueryEntry = entry_find(sh, key);
    if (entry == nil || !entry.ready) { ret res[bool, fail.Fail].ok{false}; }
    val prior: opt[*Revision] = map.get[QueryKey, Revision](?db.validated, ?pair);
    if (sel prior.some) {
        if (@prior.some != 0) {
            if (@prior.some != entry.last_changed) {
                ret res[bool, fail.Fail].err{fail.message("validated query owner changed during reuse")};
            }
            ret res[bool, fail.Fail].ok{true};
    }
    }
    val reserved: res[bool, A.Error] = map.insert[QueryKey, Revision](?db.validated, pair, 0);
    if (sel reserved.err) { ret res[bool, fail.Fail].err{fail.refused(reserved.err)}; }
    val prepared: res[usize, fail.Fail] = attempt_prepare(db, pair);
    if (sel prepared.err) { ret res[bool, fail.Fail].err{prepared.err}; }
    val pushed: err[fail.Fail] = stack_push(db, kind, key, nil);
    if (sel pushed.err) { ret res[bool, fail.Fail].err{pushed.err}; }
    fin { stack_pop(db); }
    var evidence: QueryEntry = QueryEntry{};
    val current: res[bool, fail.Fail] = refresh_dependencies[T](rt, ctx, entry, ?evidence);
    if (sel current.err) {
        attempt_preserve(db, sh, prepared.ok, ?evidence);
        ret current;
    }
    entry_free(db, sh, ?evidence);
    if (!current.ok) { ret current; }
    val slot: opt[*Revision] = map.get[QueryKey, Revision](?db.validated, ?pair);
    if (sel slot.none) { ret res[bool, fail.Fail].err{fail.message("reused query lost its validation revision")}; }
    @slot.some = entry.last_changed;
    ret current;
}

pub fun prepare[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64,
                   compute: fun(*T, QueryKind, u64, *A.Allocator, *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail]) res[PreparedQuery, fail.Fail] {
    val result: res[PreparedQuery, fail.Fail] = prepare_inner[T](rt, ctx, kind, key, compute);
    if (sel result.err) {
        if (rt != nil && rt.db != nil && rt.db.operation_active) {
            ret res[PreparedQuery, fail.Fail].err{operation_fail(rt.db, result.err)};
    }
    }
    ret result;
}

fun prepare_inner[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64,
                   compute: fun(*T, QueryKind, u64, *A.Allocator, *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail]) res[PreparedQuery, fail.Fail] {
    if (compute == nil) { ret res[PreparedQuery, fail.Fail].err{fail.message("prepared query requires a compute callback")}; }
    val current: res[bool, fail.Fail] = reusable[T](rt, ctx, kind, key);
    if (sel current.err) { ret res[PreparedQuery, fail.Fail].err{current.err}; }
    if (current.ok) { ret res[PreparedQuery, fail.Fail].err{fail.message("cannot prepare a query owner already acquired in this operation")}; }
    val db: *QueryDb = rt.db;
    val sh: *QueryShard = ?db.storage[kind::u32];
    val pair: QueryKey = QueryKey{ kind: kind, key: key };
    val reserved: res[usize, fail.Fail] = attempt_prepare(db, pair);
    if (sel reserved.err) { ret res[PreparedQuery, fail.Fail].err{reserved.err}; }
    val index: usize = reserved.ok;
    if (db.attempts.data[index].prepared != nil) { ret res[PreparedQuery, fail.Fail].err{fail.message("query product is already prepared")}; }
    val allocated: res[*QueryEntry, A.Error] = A.allocate[QueryEntry](db.a, 1);
    if (sel allocated.err) { ret res[PreparedQuery, fail.Fail].err{fail.refused(allocated.err)}; }
    val candidate: *QueryEntry = allocated.ok;
    @candidate = QueryEntry{ key: key };
    val fresh: bool = entry_find(sh, key) == nil;
    var retained: bool = false;
    fin {
        if (!retained) {
            attempt_preserve(db, sh, index, candidate);
            A.deallocate[QueryEntry](db.a, candidate, 1);
            if (fresh) { entry_remove(db, sh, key); }
        }
    }
    if (fresh) {
        val added: res[*QueryEntry, fail.Fail] = entry_append(db, sh, key);
        if (sel added.err) { ret res[PreparedQuery, fail.Fail].err{added.err}; }
    }
    var lookup: QueryKey = pair;
    val marked: res[bool, A.Error] = map.insert[QueryKey, Revision](?db.validated, lookup, 0);
    if (sel marked.err) { ret res[PreparedQuery, fail.Fail].err{fail.refused(marked.err)}; }
    val pushed: err[fail.Fail] = stack_push(db, kind, key, nil);
    if (sel pushed.err) { ret res[PreparedQuery, fail.Fail].err{pushed.err}; }
    val computed: err[fail.Fail] = candidate_compute[T](rt, ctx, sh, key, candidate, compute);
    stack_pop(db);
    if (sel computed.err) {
        ret res[PreparedQuery, fail.Fail].err{operation_fail(db, computed.err)};
    }
    db.attempts.data[index].prepared = candidate;
    db.attempts.data[index].fresh = fresh;
    db.prepared_count = db.prepared_count + 1;
    retained = true;
    ret res[PreparedQuery, fail.Fail].ok{PreparedQuery{
        operation: Operation{ owner: db::ptr, sequence: db.operation_sequence }, key: pair
    }};
}

fun prepared_attempt(db: *QueryDb, prepared: PreparedQuery) res[*Attempt, fail.Fail] {
    if (db == nil || prepared.operation.owner != db::ptr || prepared.operation.sequence != db.operation_sequence
        || !db.operation_active || db.stack.len != 0) { ret res[*Attempt, fail.Fail].err{fail.message("prepared query belongs to another operation")}; }
    var key: QueryKey = prepared.key;
    val index: opt[*usize] = map.get[QueryKey, usize](?db.attempt_index, ?key);
    if (sel index.none) { ret res[*Attempt, fail.Fail].err{fail.message("prepared query is no longer owned")}; }
    val attempt: *Attempt = ?db.attempts.data[@index.some];
    if (attempt.prepared == nil) { ret res[*Attempt, fail.Fail].err{fail.message("prepared query has already been consumed")}; }
    ret res[*Attempt, fail.Fail].ok{attempt};
}

pub fun prepared_view(db: *QueryDb, prepared: PreparedQuery) res[QueryView, fail.Fail] {
    val owner: res[*Attempt, fail.Fail] = prepared_attempt(db, prepared);
    if (sel owner.err) { ret res[QueryView, fail.Fail].err{owner.err}; }
    val candidate: *QueryEntry = owner.ok.prepared;
    ret res[QueryView, fail.Fail].ok{QueryView{ value: candidate.value, value_len: candidate.value_len }};
}

pub fun cancel_prepared(db: *QueryDb, prepared: PreparedQuery) err[fail.Fail] {
    val owner: res[*Attempt, fail.Fail] = prepared_attempt(db, prepared);
    if (sel owner.err) { ret err[fail.Fail].err{owner.err}; }
    val attempt: *Attempt = owner.ok;
    val candidate: *QueryEntry = attempt.prepared;
    val sh: *QueryShard = ?db.storage[prepared.key.kind::u32];
    var key: QueryKey = prepared.key;
    val index: opt[*usize] = map.get[QueryKey, usize](?db.attempt_index, ?key);
    if (sel index.none) { ret err[fail.Fail].err{fail.message("prepared query lost its attempt index")}; }
    attempt_preserve(db, sh, @index.some, candidate);
    A.deallocate[QueryEntry](db.a, candidate, 1);
    attempt.prepared = nil;
    attempt.cancelled = true;
    db.prepared_count = db.prepared_count - 1;
    if (attempt.fresh) { entry_remove(db, sh, prepared.key.key); }
    ret err[fail.Fail].ok{};
}

pub fun complete_prepared(db: *QueryDb, prepared: PreparedQuery, result: err[fail.Fail]) err[fail.Fail] {
    val owner: res[*Attempt, fail.Fail] = prepared_attempt(db, prepared);
    if (sel owner.err) { ret err[fail.Fail].err{owner.err}; }
    if (sel result.err) { operation_fail(db, result.err); }
    if (sel db.operation_failure.some) {
        val cancelled: err[fail.Fail] = cancel_prepared(db, prepared);
        if (sel cancelled.err) { ret cancelled; }
        ret err[fail.Fail].err{db.operation_failure.some};
    }
    val attempt: *Attempt = owner.ok;
    val sh: *QueryShard = ?db.storage[prepared.key.kind::u32];
    val entry: *QueryEntry = entry_find(sh, prepared.key.key);
    if (entry == nil) { ret err[fail.Fail].err{fail.message("prepared query lost its publication slot")}; }
    var key: QueryKey = prepared.key;
    val revision: opt[*Revision] = map.get[QueryKey, Revision](?db.validated, ?key);
    if (sel revision.none) { ret err[fail.Fail].err{fail.message("prepared query lost its validation revision")}; }
    val published: res[*QueryEntry, fail.Fail] = candidate_publish(db, sh, entry, attempt.prepared);
    if (sel published.err) {
        val recorded: fail.Fail = operation_fail(db, published.err);
        val cancelled: err[fail.Fail] = cancel_prepared(db, prepared);
        if (sel cancelled.err) { ret cancelled; }
        ret err[fail.Fail].err{recorded};
    }
    @revision.some = entry.last_changed;
    A.deallocate[QueryEntry](db.a, attempt.prepared, 1);
    attempt.prepared = nil;
    db.prepared_count = db.prepared_count - 1;
    ret err[fail.Fail].ok{};
}

fun acquire_entry[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) res[*QueryEntry, fail.Fail] {
    if (rt == nil || rt.db == nil) { ret res[*QueryEntry, fail.Fail].err{fail.message("query get requires a live runtime")}; }
    if (sel rt.db.operation_failure.some) {
        if (rt.db.operation_active) {
            ret res[*QueryEntry, fail.Fail].err{rt.db.operation_failure.some};
    }
    }
    val result: res[*QueryEntry, fail.Fail] = get_acquired[T](rt, ctx, kind, key);
    if (sel result.err) {
        if (rt.db.operation_active) {
            ret res[*QueryEntry, fail.Fail].err{operation_fail(rt.db, result.err)};
    }
    }
    ret result;
}

fun get_acquired[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) res[*QueryEntry, fail.Fail] {
    if (rt == nil || rt.db == nil || rt.caps.compute == nil || ctx == nil) {
        ret res[*QueryEntry, fail.Fail].err{fail.message("query get requires a complete live runtime")};
    }
    val db: *QueryDb = rt.db;
    var owner: *QueryEntry = nil;
    if (db.stack.len != 0) { owner = db.stack.data[db.stack.len - 1].entry; }
    if (owner != nil && !stack_contains(db, kind, key)) {
        val edge: err[fail.Fail] = dep_prepare(db, owner, kind, key);
        if (sel edge.err) { ret res[*QueryEntry, fail.Fail].err{edge.err}; }
    }
    val res_shard: res[*QueryShard, fail.Fail] = shard_get(db, kind);
    if (sel res_shard.err) {
        ret res[*QueryEntry, fail.Fail].err{res_shard.err};
    }
    val sh: *QueryShard = res_shard.ok;

    val inner: res[*QueryEntry, fail.Fail] = get_inner[T](rt, ctx, sh, kind, key);
    if (sel inner.err) { ret inner; }
    val entry: *QueryEntry = inner.ok;

    if (db.stack.len > 0) {
        val owner: *StackFrame = ?db.stack.data[db.stack.len - 1];
        if (owner.entry == nil) { ret res[*QueryEntry, fail.Fail].ok{entry}; }
        val dep_r: res[Revision, fail.Fail] = dep_upsert(db, owner.entry, kind, key, entry.last_changed, entry.diagnostics_changed, true);
        if (sel dep_r.err) {
            ret res[*QueryEntry, fail.Fail].err{dep_r.err};
        }
    }

    ret res[*QueryEntry, fail.Fail].ok{entry};
}

fun get_inner[T](rt: *QueryRuntime[T], ctx: *T, sh: *QueryShard, kind: QueryKind, key: u64) res[*QueryEntry, fail.Fail] {
    val db: *QueryDb = rt.db;
    if (!db.operation_active) { ret res[*QueryEntry, fail.Fail].err{fail.message("query read requires an active operation")}; }
    var pair: QueryKey = QueryKey{ kind: kind, key: key };
    val pending: opt[*usize] = map.get[QueryKey, usize](?db.attempt_index, ?pair);
    if (sel pending.some && (db.attempts.data[@pending.some].prepared != nil
        || db.attempts.data[@pending.some].cancelled)) {
        ret res[*QueryEntry, fail.Fail].err{fail.message("query product is awaiting owner completion")};
    }
    val prior: opt[*Revision] = map.get[QueryKey, Revision](?db.validated, ?pair);
    if (sel prior.some) {
        if (@prior.some != 0) {
            val entry: *QueryEntry = entry_find(sh, key);
            if (entry == nil || !entry.ready || entry.last_changed != @prior.some) {
                ret res[*QueryEntry, fail.Fail].err{fail.message("validated query owner changed during the operation")};
            }
            ret res[*QueryEntry, fail.Fail].ok{entry};
    }
    }
    if (stack_contains(db, kind, key)) { ret res[*QueryEntry, fail.Fail].err{cycle_failure(db, kind, key)}; }
    val reserved: res[bool, A.Error] = map.insert[QueryKey, Revision](?db.validated, pair, 0);
    if (sel reserved.err) { ret res[*QueryEntry, fail.Fail].err{fail.refused(reserved.err)}; }
    val prepared: res[usize, fail.Fail] = attempt_prepare(db, pair);
    if (sel prepared.err) { ret res[*QueryEntry, fail.Fail].err{prepared.err}; }
    val refreshed: res[*QueryEntry, fail.Fail] = refresh_entry[T](rt, ctx, sh, kind, key, prepared.ok);
    if (sel refreshed.err) { ret refreshed; }
    val revision: opt[*Revision] = map.get[QueryKey, Revision](?db.validated, ?pair);
    if (sel revision.none) { ret res[*QueryEntry, fail.Fail].err{fail.message("refreshed query lost its validation revision")}; }
    @revision.some = refreshed.ok.last_changed;
    ret refreshed;
}

fun refresh_entry[T](rt: *QueryRuntime[T], ctx: *T, sh: *QueryShard, kind: QueryKind, key: u64, attempt: usize) res[*QueryEntry, fail.Fail] {
    val db: *QueryDb = rt.db;
    if (sh.role == SHARD_METADATA) { ret res[*QueryEntry, fail.Fail].err{fail.message("get: metadata kinds have no stored value")}; }
    if (sh.role == SHARD_INPUT) {
        val entry: *QueryEntry = entry_find(sh, key);
        if (entry == nil || !entry.ready) { ret res[*QueryEntry, fail.Fail].err{fail.message("get: input query has no value for key")}; }
        ret res[*QueryEntry, fail.Fail].ok{entry};
    }
    if (stack_contains(db, kind, key)) { ret res[*QueryEntry, fail.Fail].err{cycle_failure(db, kind, key)}; }
    val pushed: err[fail.Fail] = stack_push(db, kind, key, nil);
    if (sel pushed.err) { ret res[*QueryEntry, fail.Fail].err{pushed.err}; }
    fin { stack_pop(db); }
    var entry: *QueryEntry = entry_find(sh, key);
    if (entry != nil && entry.ready) {
        var validation: QueryEntry = QueryEntry{};
        val valid: res[bool, fail.Fail] = refresh_dependencies[T](rt, ctx, entry, ?validation);
        if (sel valid.err) {
            attempt_preserve(db, sh, attempt, ?validation);
            ret res[*QueryEntry, fail.Fail].err{valid.err};
        }
        entry_free(db, sh, ?validation);
        if (valid.ok) { ret res[*QueryEntry, fail.Fail].ok{entry}; }
    }
    val fresh: bool = entry == nil;
    if (fresh) {
        val added: res[*QueryEntry, fail.Fail] = entry_append(db, sh, key);
        if (sel added.err) { ret added; }
        entry = added.ok;
    }
    val computed: res[*QueryEntry, fail.Fail] = recompute[T](rt, ctx, sh, entry, key, attempt);
    if (fresh && sel computed.err) { entry_remove(db, sh, key); }
    ret computed;
}

fun refresh_dependencies[T](rt: *QueryRuntime[T], ctx: *T, entry: *QueryEntry, evidence: *QueryEntry) res[bool, fail.Fail] {
    val db: *QueryDb = rt.db;
    var i: u32 = 0;
    for (i < entry.dep_len) {
        val dep: Dep = entry.deps[i];
        if (!dep.observed) { ret res[bool, fail.Fail].err{fail.message("cached query has an incomplete dependency")}; }
        if (evidence != nil) {
            val edge: err[fail.Fail] = dep_prepare(db, evidence, dep.kind, dep.key);
            if (sel edge.err) { ret res[bool, fail.Fail].err{edge.err}; }
        }
        val shard: res[*QueryShard, fail.Fail] = shard_get(db, dep.kind);
        if (sel shard.err) { ret res[bool, fail.Fail].err{shard.err}; }
        val sh: *QueryShard = shard.ok;
        if (sh.role == SHARD_METADATA) {
            val sampled: res[MetadataRevision, fail.Fail] = sample_metadata(db, dep.kind, dep.key);
            if (sel sampled.err) { ret res[bool, fail.Fail].err{sampled.err}; }
            val current: MetadataRevision = sampled.ok;
            if (current.present != dep.present || current.revision != dep.last_changed) { ret res[bool, fail.Fail].ok{false}; }
        } or {
            if (sh.role == SHARD_DERIVED) {
                val child: res[*QueryEntry, fail.Fail] = get_inner[T](rt, ctx, sh, dep.kind, dep.key);
                if (sel child.err) { ret res[bool, fail.Fail].err{child.err}; }
            }
            if (last_changed_get(db, dep.kind, dep.key) != dep.last_changed) { ret res[bool, fail.Fail].ok{false}; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

fun stack_push(db: *QueryDb, kind: QueryKind, key: u64, entry: *QueryEntry) err[fail.Fail] {
    var f: StackFrame;
    f.kind  = kind;
    f.key   = key;
    f.entry = entry;
    val r: res[usize, A.Error] = vector.push[StackFrame](?db.stack, f);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    ret err[fail.Fail].ok{};
}

fun stack_pop(db: *QueryDb) {
    vector.pop[StackFrame](?db.stack);
}

fun stack_contains(db: *QueryDb, kind: QueryKind, key: u64) bool {
    var i: usize = 0;
    for (i < db.stack.len) {
        val f: *StackFrame = ?db.stack.data[i];
        if (f.kind == kind && f.key == key) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun cycle_failure(db: *QueryDb, kind: QueryKind, key: u64) fail.Fail {
    val built: res[str, fail.Fail] = cycle_message(db, kind, key);
    if (sel built.err) { ret operation_fail(db, built.err); }
    val text: str = built.ok;
    if (sel db.operation_failure.some) {
        if (fail.is_message(db.operation_failure.some)) {
            str_free(db.a, text);
            ret db.operation_failure.some;
        }
    }
    db.operation_message = text;
    val recorded: fail.Fail = fail.message(text);
    db.operation_failure = opt[fail.Fail].some{recorded};
    ret recorded;
}

fun cycle_message(db: *QueryDb, kind: QueryKind, key: u64) res[str, fail.Fail] {
    var b: textbuild.TextBuilder = textbuild.tb_init(db.a);
    fin { textbuild.tb_dnit(?b); }
    val prefix: err[textbuild.Error] = textbuild.tb_append(?b, "query cycle: ");
    if (sel prefix.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(prefix.err))}; }
    var i: usize = 0;
    for (i < db.stack.len) {
        val frame: *StackFrame = ?db.stack.data[i];
        val segment: res[str, format.FormatError] = format.sprint(db.a, "{}:{} -> ", frame.kind, frame.key);
        if (sel segment.err) { ret res[str, fail.Fail].err{fail.format_refused(segment.err)}; }
        val text: str = segment.ok;
        val appended: err[textbuild.Error] = textbuild.tb_append(?b, text);
        str_free(db.a, text);
        if (sel appended.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(appended.err))}; }
        i = i + 1;
    }
    val tail: res[str, format.FormatError] = format.sprint(db.a, "{}:{} (already computing)", kind, key);
    if (sel tail.err) { ret res[str, fail.Fail].err{fail.format_refused(tail.err)}; }
    val text: str = tail.ok;
    val appended: err[textbuild.Error] = textbuild.tb_append(?b, text);
    str_free(db.a, text);
    if (sel appended.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(appended.err))}; }
    val finished: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel finished.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(finished.err))}; }
    ret res[str, fail.Fail].ok{finished.ok};
}

pub fun revision[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) res[Revision, fail.Fail] {
    val read: res[QueryView, fail.Fail] = get[T](rt, ctx, kind, key);
    if (sel read.err) { ret res[Revision, fail.Fail].err{read.err}; }
    ret res[Revision, fail.Fail].ok{read.ok.last_changed};
}

pub fun depend[T](rt: *QueryRuntime[T], ctx: *T, kind: QueryKind, key: u64) err[fail.Fail] {
    val observed: res[Revision, fail.Fail] = revision[T](rt, ctx, kind, key);
    if (sel observed.err) { ret err[fail.Fail].err{observed.err}; }
    ret err[fail.Fail].ok{};
}

pub fun observe(db: *QueryDb, kind: QueryKind, key: u64) res[MetadataRevision, fail.Fail] {
    val result: res[MetadataRevision, fail.Fail] = observe_inner(db, kind, key);
    if (sel result.err) {
        if (db != nil && db.operation_active) {
            ret res[MetadataRevision, fail.Fail].err{operation_fail(db, result.err)};
        }
    }
    ret result;
}

fun observe_inner(db: *QueryDb, kind: QueryKind, key: u64) res[MetadataRevision, fail.Fail] {
    if (db == nil || db.stack.len == 0 || db.stack.data[db.stack.len - 1].entry == nil) {
        ret res[MetadataRevision, fail.Fail].err{fail.message("metadata dependency requires an active computation")};
    }
    val sampled: res[MetadataRevision, fail.Fail] = sample_metadata(db, kind, key);
    if (sel sampled.err) { ret sampled; }
    val value: MetadataRevision = sampled.ok;
    val recorded: res[Revision, fail.Fail] = dep_upsert(db, db.stack.data[db.stack.len - 1].entry,
        kind, key, value.revision, 0, value.present);
    if (sel recorded.err) { ret res[MetadataRevision, fail.Fail].err{recorded.err}; }
    ret sampled;
}

fun dep_prepare(db: *QueryDb, entry: *QueryEntry, kind: QueryKind, key: u64) err[fail.Fail] {
    var i: u32 = 0;
    for (i < entry.dep_len) {
        if (entry.deps[i].kind == kind && entry.deps[i].key == key) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    val reserved: err[fail.Fail] = deps_reserve(db, entry, 1);
    if (sel reserved.err) { ret reserved; }
    entry.deps[entry.dep_len] = Dep{ kind: kind, key: key };
    entry.dep_len = entry.dep_len + 1;
    ret err[fail.Fail].ok{};
}

fun dep_upsert(db: *QueryDb, entry: *QueryEntry, dep_kind: QueryKind, dep_key: u64, rev: Revision, diagnostic_revision: Revision, present: bool) res[Revision, fail.Fail] {
    var i: u32 = 0;
    for (i < entry.dep_len) {
        val d: *Dep = ?entry.deps[i];
        if (d.kind == dep_kind && d.key == dep_key) {
            if (!d.observed) {
                d.last_changed = rev;
                d.diagnostics_changed = diagnostic_revision;
                d.present = present;
                d.observed = true;
                ret res[Revision, fail.Fail].ok{rev};
            }
            if (d.last_changed != rev || d.diagnostics_changed != diagnostic_revision || d.present != present) {
                ret res[Revision, fail.Fail].err{fail.message("query dependency changed after acquisition")};
            }
            ret res[Revision, fail.Fail].ok{d.last_changed};
        }
        i = i + 1;
    }

    val res_reserve: err[fail.Fail] = deps_reserve(db, entry, 1);
    if (sel res_reserve.err) { ret res[Revision, fail.Fail].err{res_reserve.err}; }

    val dep: *Dep = ?entry.deps[entry.dep_len];
    dep.observed     = true;
    dep.kind         = dep_kind;
    dep.key          = dep_key;
    dep.last_changed = rev;
    dep.present = present;
    dep.diagnostics_changed = diagnostic_revision;
    entry.dep_len = entry.dep_len + 1;
    ret res[Revision, fail.Fail].ok{rev};
}

# observation copies recorded keys without validating or exposing a cached product
pub fun cached_dependency_keys(db: *QueryDb, kind: QueryKind, key: u64,
                               a: *A.Allocator) res[Vector[QueryKey], fail.Fail] {
    val found: res[*QueryEntry, fail.Fail] = peek(db, kind, key);
    if (sel found.err) { ret res[Vector[QueryKey], fail.Fail].err{found.err}; }
    val entry: *QueryEntry = found.ok;
    var keys: Vector[QueryKey] = vector.init[QueryKey](a);
    var transferred: bool = false;
    fin { if (!transferred) { vector.dnit[QueryKey](?keys); } }
    var i: u32 = 0;
    for (i < entry.dep_len) {
        val dep: Dep = entry.deps[i];
        val copied: res[usize, A.Error] = vector.push[QueryKey](?keys, QueryKey{ kind: dep.kind, key: dep.key });
        if (sel copied.err) { ret res[Vector[QueryKey], fail.Fail].err{fail.refused(copied.err)}; }
        i = i + 1;
    }
    transferred = true;
    ret res[Vector[QueryKey], fail.Fail].ok{keys};
}

pub fun peek_revision(db: *QueryDb, kind: QueryKind, key: u64) Revision {
    ret last_changed_get(db, kind, key);
}

fun peek(db: *QueryDb, kind: QueryKind, key: u64) res[*QueryEntry, fail.Fail] {
    val sh_r: res[*QueryShard, fail.Fail] = shard_get(db, kind);
    if (sel sh_r.err) {
        ret res[*QueryEntry, fail.Fail].err{sh_r.err};
    }
    val sh: *QueryShard = sh_r.ok;
    if (sh.role == SHARD_METADATA) {
        ret res[*QueryEntry, fail.Fail].err{fail.message("peek: metadata kinds have no stored value")};
    }
    val entry: *QueryEntry = entry_find(sh, key);
    if (entry == nil) { ret res[*QueryEntry, fail.Fail].err{fail.message("peek: query has no stored value for key")}; }
    ret res[*QueryEntry, fail.Fail].ok{entry};
}

pub fun shard_len(db: *QueryDb, kind: QueryKind) u32 {
    if (kind::u32 >= db.kinds) { ret 0; }
    val sh: *QueryShard = ?db.storage[kind::u32];
    ret sh.index.len::u32;
}

fun register(db: *QueryDb, kind: QueryKind, role: ShardRole, revisions: RevisionProvider) err[fail.Fail] {
    if (db.operation_active || db.presentation_pending) { ret err[fail.Fail].err{fail.message("cannot register a query before the operation is released")}; }
    val need: u32 = kind::u32 + 1;
    if (need > db.kinds) {
        val res_grow: err[fail.Fail] = storage_grow(db, need);
        if (sel res_grow.err) { ret res_grow; }
    }

    val sh: *QueryShard = ?db.storage[kind::u32];
    if (sh.registered) {
        ret err[fail.Fail].err{fail.message("register: kind already registered")};
    }
    sh.kind       = kind;
    sh.role       = role;
    sh.revisions  = revisions;
    sh.registered = true;
    ret err[fail.Fail].ok{};
}

fun storage_grow(db: *QueryDb, need: u32) err[fail.Fail] {
    if (need <= db.kinds) { ret err[fail.Fail].ok{}; }

    if (need > db.storage_cap) {
        var base_cap: u32 = db.storage_cap;
        if (base_cap == 0) { base_cap = need; }
        val grown_r: res[layout.CheckedCount[QueryShard], layout.CheckCause] = layout.count_grow[QueryShard](layout.count[QueryShard](base_cap::usize), layout.count[QueryShard](need::usize));
        if (sel grown_r.err) {
            ret err[fail.Fail].err{fail.message("query: storage growth count overflow")};
        }
        val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
            grown_r.ok.value);
        if (sel new_cap_fits.err) {
            ret err[fail.Fail].err{fail.message("query: storage capacity exceeds the u32 limit")};
        }
        val new_cap: u32 = new_cap_fits.ok;

        if (db.storage == nil) {
            val res_alloc: res[*QueryShard, A.Error] = A.allocate[QueryShard](db.a, new_cap::usize);
            if (sel res_alloc.err) {
                ret err[fail.Fail].err{fail.refused(res_alloc.err)};
            }
            db.storage = res_alloc.ok;
        }
        or {
            val res_alloc: res[*QueryShard, A.Error] = A.reallocate[QueryShard](db.a, db.storage, db.storage_cap::usize, new_cap::usize);
            if (sel res_alloc.err) {
                ret err[fail.Fail].err{fail.refused(res_alloc.err)};
            }
            db.storage = res_alloc.ok;
        }
        db.storage_cap = new_cap;
    }

    var i: u32 = db.kinds;
    for (i < need) {
        val sh: *QueryShard = ?db.storage[i];
        sh.kind       = i::QueryKind;
        sh.role       = SHARD_INPUT;
        sh.revisions  = RevisionProvider{};
        sh.finalize   = nil::FinalizeFn;
        sh.equal = nil;
        sh.registered = false;

        val te_r: res[handle.HandleTable[QueryEntry, QueryEntryDomain], handle.Error] = handle.table_init[QueryEntry, QueryEntryDomain](db.a);
        if (sel te_r.err) {
            ret err[fail.Fail].err{fail.message(handle.text(te_r.err))};
        }
        sh.entries = te_r.ok;
        sh.index   = vector.init[QueryIndexEntry](db.a);
        sh.by_key  = map.init[u64, handle.HandleId[QueryEntryDomain]](db.a, map.hash_u64, map.eq_u64);

        db.kinds = i + 1;
        i = i + 1;
    }

    ret err[fail.Fail].ok{};
}

fun shard_get(db: *QueryDb, kind: QueryKind) res[*QueryShard, fail.Fail] {
    if (kind::u32 >= db.kinds) {
        ret res[*QueryShard, fail.Fail].err{fail.message("query: kind out of range")};
    }
    val sh: *QueryShard = ?db.storage[kind::u32];
    if (!sh.registered) {
        ret res[*QueryShard, fail.Fail].err{fail.message("query: kind not registered")};
    }
    ret res[*QueryShard, fail.Fail].ok{sh};
}

fun entry_find(sh: *QueryShard, key: u64) *QueryEntry {
    var k: u64 = key;
    val id_r: opt[*handle.HandleId[QueryEntryDomain]] = map.get[u64, handle.HandleId[QueryEntryDomain]](?sh.by_key, ?k);
    if (sel id_r.none) { ret nil; }
    val id: handle.HandleId[QueryEntryDomain] = @id_r.some;
    val e_r: res[*QueryEntry, handle.Error] = handle.get[QueryEntry, QueryEntryDomain](?sh.entries, id);
    if (sel e_r.err) { ret nil; }
    ret e_r.ok;
}

fun entry_append(db: *QueryDb, sh: *QueryShard, key: u64) res[*QueryEntry, fail.Fail] {
    var fresh: QueryEntry;
    fresh.key          = key;
    fresh.value        = nil;
    fresh.value_len    = 0;
    fresh.last_changed = 0;
    fresh.deps         = nil;
    fresh.dep_len      = 0;
    fresh.dep_cap      = 0;
    fresh.diags        = nil;
    fresh.diagnostics_changed = 0;
    fresh.ready = false;

    val ed_r: res[handle.HandleEditor[QueryEntry, QueryEntryDomain], handle.Error] = handle.edit[QueryEntry, QueryEntryDomain](?sh.entries);
    if (sel ed_r.err) {
        ret res[*QueryEntry, fail.Fail].err{fail.message(handle.text(ed_r.err))};
    }
    var ed: handle.HandleEditor[QueryEntry, QueryEntryDomain] =
        ed_r.ok;
    val ins_r: res[handle.HandleId[QueryEntryDomain], handle.Error] = handle.editor_insert[QueryEntry, QueryEntryDomain](?ed, fresh);
    handle.editor_finish[QueryEntry, QueryEntryDomain](?ed);
    if (sel ins_r.err) {
        ret res[*QueryEntry, fail.Fail].err{fail.message(handle.text(ins_r.err))};
    }
    val id: handle.HandleId[QueryEntryDomain] = ins_r.ok;

    var ie: QueryIndexEntry;
    ie.key = key;
    ie.id  = id;
    val push_r: res[usize, A.Error] = vector.push[QueryIndexEntry](?sh.index, ie);
    if (sel push_r.err) {
        val ed2_r: res[handle.HandleEditor[QueryEntry, QueryEntryDomain], handle.Error] = handle.edit[QueryEntry, QueryEntryDomain](?sh.entries);
        if (sel ed2_r.ok) {
            var ed2: handle.HandleEditor[QueryEntry, QueryEntryDomain] =
                ed2_r.ok;
            handle.editor_remove[QueryEntry, QueryEntryDomain](?ed2, id);
            handle.editor_finish[QueryEntry, QueryEntryDomain](?ed2);
        }
        ret res[*QueryEntry, fail.Fail].err{fail.refused(push_r.err)};
    }

    val map_r: res[bool, A.Error] = map.insert[u64, handle.HandleId[QueryEntryDomain]](?sh.by_key, key, id);
    if (sel map_r.err) {
        sh.index.len = sh.index.len - 1;
        val ed3_r: res[handle.HandleEditor[QueryEntry, QueryEntryDomain], handle.Error] = handle.edit[QueryEntry, QueryEntryDomain](?sh.entries);
        if (sel ed3_r.ok) {
            var ed3: handle.HandleEditor[QueryEntry, QueryEntryDomain] =
                ed3_r.ok;
            handle.editor_remove[QueryEntry, QueryEntryDomain](?ed3, id);
            handle.editor_finish[QueryEntry, QueryEntryDomain](?ed3);
        }
        ret res[*QueryEntry, fail.Fail].err{fail.refused(map_r.err)};
    }

    val got: res[*QueryEntry, handle.Error] = handle.get[QueryEntry, QueryEntryDomain](?sh.entries, id);
    if (sel got.err) { ret res[*QueryEntry, fail.Fail].err{fail.message(handle.text(got.err))}; }
    ret res[*QueryEntry, fail.Fail].ok{got.ok};
}

fun entry_remove(db: *QueryDb, sh: *QueryShard, key: u64) {
    var i: usize = 0;
    for (i < sh.index.len) {
        val ie: *QueryIndexEntry = ?sh.index.data[i];
        if (ie.key == key) {
            val e_r: res[*QueryEntry, handle.Error] = handle.get[QueryEntry, QueryEntryDomain](?sh.entries, ie.id);
            if (sel e_r.ok) {
                entry_free(db, sh, e_r.ok);
            }

            val ed_r: res[handle.HandleEditor[QueryEntry, QueryEntryDomain], handle.Error] = handle.edit[QueryEntry, QueryEntryDomain](?sh.entries);
            if (sel ed_r.ok) {
                var ed: handle.HandleEditor[QueryEntry, QueryEntryDomain] =
                    ed_r.ok;
                handle.editor_remove[QueryEntry, QueryEntryDomain](?ed, ie.id);
                handle.editor_finish[QueryEntry, QueryEntryDomain](?ed);
            }

            val last: usize = sh.index.len - 1;
            if (i != last) { sh.index.data[i] = sh.index.data[last]; }
            sh.index.len = last;

            var rk: u64 = key;
            map.remove[u64, handle.HandleId[QueryEntryDomain]](?sh.by_key, ?rk);
            ret;
        }
        i = i + 1;
    }
}

fun entry_free(db: *QueryDb, sh: *QueryShard, entry: *QueryEntry) {
    if (entry.value != nil && entry.value_len > 0) {
        if (sh.finalize != nil) { sh.finalize(entry.value, entry.value_len, db.a); }
        A.deallocate[u8](db.a, entry.value, entry.value_len::usize);
    }
    if (entry.deps != nil && entry.dep_cap > 0) {
        A.deallocate[Dep](db.a, entry.deps, entry.dep_cap::usize);
    }
    if (entry.diags != nil) {
        diagnostic.store_dnit(entry.diags);
        A.deallocate[diagnostic.DiagnosticStore](db.a, entry.diags, 1::usize);
    }
    entry.value     = nil;
    entry.value_len = 0;
    entry.deps      = nil;
    entry.dep_len   = 0;
    entry.dep_cap   = 0;
    entry.diags     = nil;
    entry.ready     = false;
}

fun shard_entries_free(db: *QueryDb, sh: *QueryShard) {
    var i: usize = 0;
    for (i < sh.index.len) {
        val ie: *QueryIndexEntry = ?sh.index.data[i];
        val e_r: res[*QueryEntry, handle.Error] = handle.get[QueryEntry, QueryEntryDomain](?sh.entries, ie.id);
        if (sel e_r.ok) {
            entry_free(db, sh, e_r.ok);
        }
        i = i + 1;
    }
    handle.table_dnit[QueryEntry, QueryEntryDomain](?sh.entries);
    vector.dnit[QueryIndexEntry](?sh.index);
    map.dnit[u64, handle.HandleId[QueryEntryDomain]](?sh.by_key);
}

fun last_changed_get(db: *QueryDb, kind: QueryKind, key: u64) Revision {
    if (kind::u32 >= db.kinds) { ret 0; }
    val sh: *QueryShard = ?db.storage[kind::u32];
    if (sh.role == SHARD_METADATA) { ret 0; }
    val entry: *QueryEntry = entry_find(sh, key);
    if (entry == nil) { ret 0; }
    ret entry.last_changed;
}

fun diagnostics_changed_get(db: *QueryDb, kind: QueryKind, key: u64) Revision {
    if (kind::u32 >= db.kinds) { ret 0; }
    val sh: *QueryShard = ?db.storage[kind::u32];
    if (sh.role != SHARD_DERIVED) { ret 0; }
    val entry: *QueryEntry = entry_find(sh, key);
    if (entry == nil || !entry.ready) { ret 0; }
    ret entry.diagnostics_changed;
}

fun diagnostic_dependencies_equal(left: *QueryEntry, right: *QueryEntry) bool {
    var i: u32 = 0;
    var j: u32 = 0;
    for (true) {
        for (i < left.dep_len && left.deps[i].diagnostics_changed == 0) { i = i + 1; }
        for (j < right.dep_len && right.deps[j].diagnostics_changed == 0) { j = j + 1; }
        if (i == left.dep_len || j == right.dep_len) { ret i == left.dep_len && j == right.dep_len; }
        val l: Dep = left.deps[i];
        val r: Dep = right.deps[j];
        if (l.kind != r.kind || l.key != r.key || l.diagnostics_changed != r.diagnostics_changed) { ret false; }
        i = i + 1;
        j = j + 1;
    }
    ret false;
}

fun has_diagnostics(entry: *QueryEntry) bool {
    if (entry.diags != nil && diagnostic.len(entry.diags) != 0) { ret true; }
    var i: u32 = 0;
    for (i < entry.dep_len) {
        if (entry.deps[i].diagnostics_changed != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun candidate_compute[T](rt: *QueryRuntime[T], ctx: *T, sh: *QueryShard, key: u64,
                         candidate: *QueryEntry,
                         compute: fun(*T, QueryKind, u64, *A.Allocator, *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail]) err[fail.Fail] {
    val db: *QueryDb = rt.db;
    val diags_r: res[*diagnostic.DiagnosticStore, A.Error] = A.allocate[diagnostic.DiagnosticStore](db.a, 1);
    if (sel diags_r.err) {
        ret err[fail.Fail].err{fail.refused(diags_r.err)};
    }
    candidate.diags = diags_r.ok;
    @candidate.diags = diagnostic.store_init(db.a);
    val frame: usize = db.stack.len - 1;
    db.stack.data[frame].entry = candidate;
    fin { db.stack.data[frame].entry = nil; }
    db.compute_depth = db.compute_depth + 1;
    val computed: res[QueryOutput, fail.Fail] = compute(ctx, sh.kind, key, db.a, candidate.diags);
    db.compute_depth = db.compute_depth - 1;
    if (sel computed.err) {
        ret err[fail.Fail].err{operation_fail(db, computed.err)};
    }
    val out: QueryOutput = computed.ok;
    candidate.value = out.bytes;
    candidate.value_len = out.len;
    if ((out.len != 0 && out.bytes == nil) || (out.len == 0 && out.bytes != nil)) {
        ret err[fail.Fail].err{fail.message("query output has an inconsistent byte extent")};
    }
    if (sel db.operation_failure.some) {
        ret err[fail.Fail].err{db.operation_failure.some};
    }
    ret err[fail.Fail].ok{};
}

fun candidate_publish(db: *QueryDb, sh: *QueryShard, entry: *QueryEntry, candidate: *QueryEntry) res[*QueryEntry, fail.Fail] {
    candidate.ready = true;
    val diag_equal: res[bool, fail.Fail] = diagnostic.content_equal(entry.diags, candidate.diags);
    if (sel diag_equal.err) { ret res[*QueryEntry, fail.Fail].err{diag_equal.err}; }
    val same_diags: bool = diag_equal.ok && diagnostic_dependencies_equal(entry, candidate);
    var same_value: bool = false;
    if (entry.ready) {
        if (sh.equal != nil) { same_value = sh.equal(entry.value, entry.value_len, candidate.value, candidate.value_len); }
        or (sh.finalize == nil) {
            same_value = entry.value_len == candidate.value_len
                && memory.raw_equal(entry.value::ptr, candidate.value::ptr, candidate.value_len::usize);
        }
    }
    var revision: Revision = entry.last_changed;
    if (!same_value || !same_diags) {
        val changed: res[Revision, fail.Fail] = next_revision(db);
        if (sel changed.err) { ret res[*QueryEntry, fail.Fail].err{changed.err}; }
        revision = changed.ok;
    }
    candidate.last_changed = revision;
    if (has_diagnostics(candidate)) {
        if (same_diags) { candidate.diagnostics_changed = entry.diagnostics_changed; }
        or { candidate.diagnostics_changed = revision; }
    }
    if (same_value) {
        if (sh.finalize != nil) { sh.finalize(candidate.value, candidate.value_len, db.a); }
        if (candidate.value != nil && candidate.value_len != 0) { A.deallocate[u8](db.a, candidate.value, candidate.value_len::usize); }
        candidate.value = entry.value;
        candidate.value_len = entry.value_len;
        entry.value = nil;
        entry.value_len = 0;
    }
    entry_free(db, sh, entry);
    @entry = @candidate;
    @candidate = QueryEntry{};
    ret res[*QueryEntry, fail.Fail].ok{entry};
}

fun recompute[T](rt: *QueryRuntime[T], ctx: *T, sh: *QueryShard, entry: *QueryEntry, key: u64, attempt: usize) res[*QueryEntry, fail.Fail] {
    val db: *QueryDb = rt.db;
    var candidate: QueryEntry = QueryEntry{ key: key };
    var committed: bool = false;
    fin {
        if (!committed) { attempt_preserve(db, sh, attempt, ?candidate); }
        entry_free(db, sh, ?candidate);
    }
    val computed: err[fail.Fail] = candidate_compute[T](rt, ctx, sh, key, ?candidate, rt.caps.compute);
    if (sel computed.err) { ret res[*QueryEntry, fail.Fail].err{computed.err}; }
    val published: res[*QueryEntry, fail.Fail] = candidate_publish(db, sh, entry, ?candidate);
    if (sel published.ok) { committed = true; }
    ret published;
}

fun deps_reserve(db: *QueryDb, entry: *QueryEntry, need: u32) err[fail.Fail] {
    if (entry.deps == nil) {
        val init_grown_r: res[layout.CheckedCount[Dep], layout.CheckCause] = layout.count_grow[Dep](layout.count[Dep](INITIAL_DEP_CAP::usize), layout.count[Dep](need::usize));
        if (sel init_grown_r.err) {
            ret err[fail.Fail].err{fail.message("query: dependency list initial growth count overflow")};
        }
        val init_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
            init_grown_r.ok.value);
        if (sel init_cap_fits.err) {
            ret err[fail.Fail].err{fail.message("query: dependency list capacity exceeds the u32 limit")};
        }
        val cap: u32 = init_cap_fits.ok;
        val res_alloc: res[*Dep, A.Error] = A.allocate[Dep](db.a, cap::usize);
        if (sel res_alloc.err) {
            ret err[fail.Fail].err{fail.refused(res_alloc.err)};
        }
        entry.deps    = res_alloc.ok;
        entry.dep_cap = cap;
        ret err[fail.Fail].ok{};
    }

    val required_r: res[layout.CheckedCount[Dep], layout.CheckCause] = layout.count_add[Dep](layout.count[Dep](entry.dep_len::usize), layout.count[Dep](need::usize));
    if (sel required_r.err) {
        ret err[fail.Fail].err{fail.message("query: dependency list reservation overflow")};
    }
    val required: layout.CheckedCount[Dep] = required_r.ok;
    if (required.value <= entry.dep_cap::usize) { ret err[fail.Fail].ok{}; }

    val grown_r: res[layout.CheckedCount[Dep], layout.CheckCause] = layout.count_grow[Dep](layout.count[Dep](entry.dep_cap::usize), required);
    if (sel grown_r.err) {
        ret err[fail.Fail].err{fail.message("query: dependency list growth count overflow")};
    }
    val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
        grown_r.ok.value);
    if (sel new_cap_fits.err) {
        ret err[fail.Fail].err{fail.message("query: dependency list capacity exceeds the u32 limit")};
    }
    val new_cap: u32 = new_cap_fits.ok;
    val res_alloc: res[*Dep, A.Error] = A.reallocate[Dep](db.a, entry.deps, entry.dep_cap::usize, new_cap::usize);
    if (sel res_alloc.err) {
        ret err[fail.Fail].err{fail.refused(res_alloc.err)};
    }
    entry.deps    = res_alloc.ok;
    entry.dep_cap = new_cap;
    ret err[fail.Fail].ok{};
}

fun bytes_dup(a: *A.Allocator, src: *u8, len: u32) res[*u8, fail.Fail] {
    if (len == 0) { ret res[*u8, fail.Fail].ok{nil}; }
    val res_alloc: res[*u8, A.Error] = A.allocate[u8](a, len::usize);
    if (sel res_alloc.err) { ret res[*u8, fail.Fail].err{fail.refused(res_alloc.err)}; }
    val dst: *u8 = res_alloc.ok;
    memory.raw_copy(dst::ptr, src::ptr, len::usize);
    ret res[*u8, fail.Fail].ok{dst};
}

def TestComputeMode: u8;

val T_MODE_FAIL:       TestComputeMode = 0;
val T_MODE_TOKENIZE:   TestComputeMode = 1;
val T_MODE_OWNED:      TestComputeMode = 2;
val T_MODE_DIAG:       TestComputeMode = 3;
val T_MODE_DIRECT:     TestComputeMode = 4;
val T_MODE_INDIRECT:   TestComputeMode = 5;
val T_MODE_PARSE_DEPS: TestComputeMode = 6;
val T_MODE_DEDUP:      TestComputeMode = 7;
val T_MODE_AUTO_DEP:   TestComputeMode = 8;
val T_MODE_OWNED_DIAG: TestComputeMode = 9;
val T_MODE_DIRECT_TOKENIZE: TestComputeMode = 10;
val T_MODE_BRANCH: TestComputeMode = 11;

rec TestQueryContext {
    runtime: QueryRuntime[TestQueryContext];
    diags:   diagnostic.DiagnosticStore;
    mode:    TestComputeMode;
    last_presentation: *Presentation;
    diagnostic_refused: bool;
}

def TestComputeFn: fun(*TestQueryContext, QueryKind, u64, *A.Allocator, *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail];

fun t_context_init_with(ctx: *TestQueryContext, db: *QueryDb, diag_alloc: *A.Allocator,
                        mode: TestComputeMode) bool {
    ctx.diags = diagnostic.store_init(diag_alloc);
    val rt_r: res[QueryRuntime[TestQueryContext], fail.Fail] = runtime[TestQueryContext](db, t_dispatch);
    if (sel rt_r.err) {
        diagnostic.store_dnit(?ctx.diags);
        ret false;
    }
    ctx.runtime = rt_r.ok;
    ctx.mode    = mode;
    ctx.last_presentation = nil;
    ctx.diagnostic_refused = false;
    ret true;
}

fun t_context_init(ctx: *TestQueryContext, db: *QueryDb, mode: TestComputeMode) bool {
    ret t_context_init_with(ctx, db, db.a, mode);
}

fun t_context_dnit(ctx: *TestQueryContext) {
    presentation_dnit(ctx.last_presentation);
    ctx.last_presentation = nil;
    diagnostic.store_dnit(?ctx.diags);
}

fun t_present(ctx: *TestQueryContext, operation: Operation, kind: QueryKind, key: u64) err[fail.Fail] {
    var root: QueryKey = QueryKey{ kind: kind, key: key };
    val presented: res[*Presentation, fail.Fail] = collect(ctx.runtime.db, operation, ?root, 1, ctx.diags.a);
    if (sel presented.err) { ret err[fail.Fail].err{presented.err}; }
    presentation_dnit(ctx.last_presentation);
    ctx.last_presentation = presented.ok;
    ret diagnostic.replay_into(?ctx.diags, ?ctx.last_presentation.diags);
}

fun t_get(ctx: *TestQueryContext, kind: QueryKind, key: u64) res[*QueryEntry, fail.Fail] {
    presentation_dnit(ctx.last_presentation);
    ctx.last_presentation = nil;
    if (ctx.runtime.db.presentation_pending) {
        val released: err[fail.Fail] = discard(ctx.runtime.db,
            Operation{ owner: ctx.runtime.db::ptr, sequence: ctx.runtime.db.operation_sequence });
        if (sel released.err) { ret res[*QueryEntry, fail.Fail].err{released.err}; }
    }
    val opened: res[Operation, fail.Fail] = begin(ctx.runtime.db);
    if (sel opened.err) { ret res[*QueryEntry, fail.Fail].err{opened.err}; }
    val result: res[*QueryEntry, fail.Fail] = acquire_entry[TestQueryContext](?ctx.runtime, ctx, kind, key);
    val closed: err[fail.Fail] = end(ctx.runtime.db, opened.ok);
    val shown: err[fail.Fail] = t_present(ctx, opened.ok, kind, key);
    if (sel result.err) { ret result; }
    if (sel shown.err) { ret res[*QueryEntry, fail.Fail].err{shown.err}; }
    if (sel closed.err) { ret res[*QueryEntry, fail.Fail].err{closed.err}; }
    ret result;
}

fun t_reusable(ctx: *TestQueryContext, kind: QueryKind, key: u64) res[bool, fail.Fail] {
    val opened: res[Operation, fail.Fail] = begin(ctx.runtime.db);
    if (sel opened.err) { ret res[bool, fail.Fail].err{opened.err}; }
    val result: res[bool, fail.Fail] = reusable[TestQueryContext](?ctx.runtime, ctx, kind, key);
    val closed: err[fail.Fail] = end(ctx.runtime.db, opened.ok);
    if (sel result.err) { ret result; }
    if (sel closed.err) { ret res[bool, fail.Fail].err{closed.err}; }
    val released: err[fail.Fail] = discard(ctx.runtime.db, opened.ok);
    if (sel released.err) { ret res[bool, fail.Fail].err{released.err}; }
    ret result;
}

fun t_always_fail(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    ret res[QueryOutput, fail.Fail].err{fail.message("compute always fails")};
}

fun t_tok_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val db: *QueryDb = ctx.runtime.db;
    val res_dep: err[fail.Fail] = depend[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel res_dep.err) {
        ret res[QueryOutput, fail.Fail].err{res_dep.err};
    }
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel res_buf.err) {
        ret res[QueryOutput, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;
    buf[0] = 42;

    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret res[QueryOutput, fail.Fail].ok{out};
}

var t_live: i64 = 0;

fun t_handle_ptr(entry: *QueryEntry) ptr {
    if (entry.value == nil || entry.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = entry.value::ptr::*ptr;
    ret slot[0];
}

fun t_owned_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val db: *QueryDb = ctx.runtime.db;
    val res_dep: err[fail.Fail] = depend[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel res_dep.err) {
        ret res[QueryOutput, fail.Fail].err{res_dep.err};
    }
    val res_art: res[*u64, A.Error] = A.allocate[u64](a, 1::usize);
    if (sel res_art.err) {
        ret res[QueryOutput, fail.Fail].err{fail.refused(res_art.err)};
    }
    val art: *u64 = res_art.ok;
    art[0] = key;
    t_live = t_live + 1;

    val n: u32 = $size_of(ptr)::u32;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, n::usize);
    if (sel res_buf.err) {
        A.deallocate[u64](a, art, 1::usize);
        t_live = t_live - 1;
        ret res[QueryOutput, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = art::ptr;

    var out: QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[QueryOutput, fail.Fail].ok{out};
}

fun t_owned_finalize(value: *u8, value_len: u32, a: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    val art: *u64 = slot[0]::*u64;
    if (art == nil) { ret; }
    A.deallocate[u64](a, art, 1::usize);
    t_live = t_live - 1;
}

fun t_owned_diag_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val out_r: res[QueryOutput, fail.Fail] = t_owned_compute(ctx, key, a, diags);
    if (sel out_r.err) { ret out_r; }
    val out: QueryOutput = out_r.ok;
    val diag_r: err[fail.Fail] = t_emit_diag(diags);
    if (sel diag_r.err) {
        ctx.diagnostic_refused = true;
        t_owned_finalize(out.bytes, out.len, a);
        if (out.bytes != nil && out.len > 0) { A.deallocate[u8](a, out.bytes, out.len::usize); }
        ret res[QueryOutput, fail.Fail].err{diag_r.err};
    }
    ret res[QueryOutput, fail.Fail].ok{out};
}

fun t_dispatch(ctx: *TestQueryContext, kind: QueryKind, key: u64,
               a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    if (ctx.mode == T_MODE_BRANCH) { ret t_branch_compute(ctx, kind, key, a, diags); }
    if (ctx.mode == T_MODE_FAIL) { ret t_always_fail(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_TOKENIZE) { ret t_tok_compute(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_OWNED) { ret t_owned_compute(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_DIAG) {
        if (kind == Q_TOKENIZE) { ret t_inner_diag_compute(ctx, key, a, diags); }
        if (kind == Q_PARSE)    { ret t_outer_diag_compute(ctx, key, a, diags); }
    }
    if (ctx.mode == T_MODE_DIRECT) { ret t_direct_cycle_compute(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_DIRECT_TOKENIZE) { ret t_direct_tokenize_recompute(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_INDIRECT) {
        if (kind == Q_SEMA)  { ret t_cycle_a_compute(ctx, key, a, diags); }
        if (kind == Q_LOWER) { ret t_cycle_b_compute(ctx, key, a, diags); }
    }
    if (ctx.mode == T_MODE_PARSE_DEPS) {
        if (kind == Q_TOKENIZE) { ret t_tok_compute(ctx, key, a, diags); }
        if (kind == Q_PARSE)    { ret t_parse_deps_on_tokenize(ctx, key, a, diags); }
    }
    if (ctx.mode == T_MODE_DEDUP)      { ret t_dedup_owner_compute(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_OWNED_DIAG) { ret t_owned_diag_compute(ctx, key, a, diags); }
    if (ctx.mode == T_MODE_AUTO_DEP) {
        if (kind == Q_TOKENIZE) { ret t_tok_compute(ctx, key, a, diags); }
        if (kind == Q_PARSE)    { ret t_auto_dep_outer_compute(ctx, key, a, diags); }
    }
    ret res[QueryOutput, fail.Fail].err{fail.message("test query kind has no compute capability")};
}

