    if (R.is_err[R.Void, str](set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1))) { dnit(?db); ret 1; }
    if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1)))              { dnit(?db); ret 1; }
    if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1)))                 { dnit(?db); ret 1; }
    if (!peek_valid(?db, Q_PARSE, 1))                                     { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](invalidate(?db, Q_TOKENIZE, 1)))  { dnit(?db); ret 1; }
    if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1)))  { dnit(?db); ret 1; }

    if (peek_valid(?db, Q_PARSE, 1)) { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

test "mach.lang.query.init:first_revision_is_never_the_absent_sentinel" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: R.Result[QueryDb, str] = init(?alloc);
    if (R.is_err[QueryDb, str](res_db)) { ret 1; }
    var db: QueryDb = R.unwrap_ok[QueryDb, str](res_db);

    if (db.revision == 0) { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](register_derived(?db, Q_SEMA))) { dnit(?db); ret 1; }
    if (peek_revision(?db, Q_SEMA, 1) != 0) { dnit(?db); ret 1; }

    dnit(?db);
    ret 0;
}

fun t_dedup_owner_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator) R.Result[QueryOutput, fail.Fail] {
    val db: *QueryDb = ctx.runtime.db;
    val rd1: R.Result[R.Void, str] = record_dep(db, Q_PARSE, key, Q_FILE_TEXT, key);
    if (R.is_err[R.Void, str](rd1)) { ret R.err[QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rd1))); }
    val rd2: R.Result[R.Void, str] = record_dep(db, Q_PARSE, key, Q_FILE_TEXT, key);
    if (R.is_err[R.Void, str](rd2)) { ret R.err[QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rd2))); }
    val g: R.Result[*QueryEntry, fail.Fail] = get[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (R.is_err[*QueryEntry, fail.Fail](g)) { ret R.err[QueryOutput, fail.Fail](R.unwrap_err[*QueryEntry, fail.Fail](g)); }
    val res_buf: R.Result[*u8, str] = A.allocate[u8](a, 1);
    if (R.is_err[*u8, str](res_buf)) { ret R.err[QueryOutput, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf))); }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);
    buf[0] = 9;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret R.ok[QueryOutput, fail.Fail](out);
}

test "mach.lang.query.record_dep:manual_and_automatic_edges_to_the_same_pair_dedupe" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: R.Result[QueryDb, str] = init(?alloc);
    if (R.is_err[QueryDb, str](res_db)) { ret 1; }
    var db: QueryDb = R.unwrap_ok[QueryDb, str](res_db);
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_DEDUP)) { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](register_input(?db, Q_FILE_TEXT)))                        { dnit(?db); ret 1; }
    if (R.is_err[R.Void, str](register_derived(?db, Q_PARSE))) { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1))) { dnit(?db); ret 1; }
    val res_g: R.Result[*QueryEntry, fail.Fail] = get[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1);
    if (R.is_err[*QueryEntry, fail.Fail](res_g)) { dnit(?db); ret 1; }

    if (R.unwrap_ok[*QueryEntry, fail.Fail](res_g).dep_len != 1) { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

test "mach.lang.query.record_dep_rev:rejects_an_unregistered_or_lookup_less_dependency_kind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: R.Result[QueryDb, str] = init(?alloc);
    if (R.is_err[QueryDb, str](res_db)) { ret 1; }
    var db: QueryDb = R.unwrap_ok[QueryDb, str](res_db);
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_TOKENIZE)) { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](register_input(?db, Q_FILE_TEXT)))                 { dnit(?db); ret 1; }
    if (R.is_err[R.Void, str](register_derived(?db, Q_TOKENIZE))) { dnit(?db); ret 1; }
    if (R.is_err[R.Void, str](register_metadata(?db, Q_SEMA, nil::RevisionFn)))  { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1))) { dnit(?db); ret 1; }
    if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1)))              { dnit(?db); ret 1; }

    if (!R.is_err[Revision, str](record_dep_rev(?db, Q_TOKENIZE, 1, Q_LOWER, 1))) { dnit(?db); ret 1; }
    if (!R.is_err[Revision, str](record_dep_rev(?db, Q_TOKENIZE, 1, Q_SEMA, 1)))  { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

fun t_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (O.is_some[ptr](r)) { p.live = p.live + size::i64; }
    ret r;
}

fun t_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret O.none[ptr](); }
    val r: O.Option[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (O.is_some[ptr](r)) { p.live = p.live - old_size::i64 + new_size::i64; }
    ret r;
}

fun t_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *FailProbe = ctx::*FailProbe;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

rec FailProbe {
    backing: A.Allocator;
    calls:   u32;
    fail_at: u32;
    live:    i64;
}

fun failprobe_make(p: *FailProbe, alloc: *A.Allocator, fail_at: u32) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.calls   = 0;
    p.fail_at = fail_at;
    p.live    = 0;
    alloc.ctx           = p::ptr;
    alloc.fn_allocate    = t_probe_allocate;
    alloc.fn_reallocate  = t_probe_reallocate;
    alloc.fn_deallocate  = t_probe_deallocate;
    ret true;
}

test "mach.lang.query.runtime:rejects_each_missing_required_capability" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);

    val no_db: R.Result[QueryRuntime[TestQueryContext], str] =
        runtime[TestQueryContext](nil, ?diags, t_dispatch);
    if (!R.is_err[QueryRuntime[TestQueryContext], str](no_db)) {
        diagnostic.store_dnit(?diags);
        ret 1;
    }

    val db_r: R.Result[QueryDb, str] = init(?alloc);
    if (R.is_err[QueryDb, str](db_r)) { diagnostic.store_dnit(?diags); ret 1; }
    var db: QueryDb = R.unwrap_ok[QueryDb, str](db_r);

    val no_diags: R.Result[QueryRuntime[TestQueryContext], str] =
        runtime[TestQueryContext](?db, nil, t_dispatch);
    if (!R.is_err[QueryRuntime[TestQueryContext], str](no_diags)) {
        dnit(?db);
        diagnostic.store_dnit(?diags);
        ret 1;
    }

    val no_compute: R.Result[QueryRuntime[TestQueryContext], str] =
        runtime[TestQueryContext](?db, ?diags, nil::TestComputeFn);
    if (!R.is_err[QueryRuntime[TestQueryContext], str](no_compute)) {
        dnit(?db);
        diagnostic.store_dnit(?diags);
        ret 1;
    }

    dnit(?db);
    diagnostic.store_dnit(?diags);
    ret 0;
}

test "mach.lang.query.get:diag_capture_failure_after_a_successful_compute_is_fatal" {
    var saw_capture_failure: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= 80) {
        var db_alloc: A.Allocator;
        var probe: FailProbe;
        if (!failprobe_make(?probe, ?db_alloc, 0)) { ret 1; }

        var diag_alloc: A.Allocator;
        page.make(?diag_alloc);

        val db_r: R.Result[QueryDb, str] = init(?db_alloc);
        if (R.is_err[QueryDb, str](db_r)) { ret 1; }
        var db: QueryDb = R.unwrap_ok[QueryDb, str](db_r);
        var ctx: TestQueryContext;
        if (!t_context_init_with(?ctx, ?db, ?diag_alloc, T_MODE_OWNED_DIAG)) { dnit(?db); ret 1; }
        t_live = 0;

        if (R.is_err[R.Void, str](register_input(?db, Q_FILE_TEXT))) {
            dnit(?db); t_context_dnit(?ctx); ret 1;
        }
        if (R.is_err[R.Void, str](register_derived_owned(?db, Q_PARSE, t_owned_finalize))) {
            dnit(?db); t_context_dnit(?ctx); ret 1;
        }
        if (R.is_err[R.Void, str](set_input(?db, Q_FILE_TEXT, 1, "x"::*u8, 1))) {
            dnit(?db); t_context_dnit(?ctx); ret 1;
        }

        probe.calls   = 0;
        probe.fail_at = fail_at;
        val get_r: R.Result[*QueryEntry, fail.Fail] =
            get[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1);

        if (R.is_err[*QueryEntry, fail.Fail](get_r) && diagnostic.len(?ctx.diags) == 1) {
            saw_capture_failure = true;
            if (t_live != 0 || shard_len(?db, Q_PARSE) != 0) {
                probe.fail_at = 0;
                dnit(?db); t_context_dnit(?ctx); ret 1;
            }

            probe.fail_at = 0;
            if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1))) {
                dnit(?db); t_context_dnit(?ctx); ret 1;
            }
            if (t_live != 1 || !peek_valid(?db, Q_PARSE, 1)) {
                dnit(?db); t_context_dnit(?ctx); ret 1;
            }
        }

        probe.fail_at = 0;
        dnit(?db);
        t_context_dnit(?ctx);
        if (t_live != 0 || probe.live != 0) { ret 1; }
        fail_at = fail_at + 1;
    }

    if (!saw_capture_failure) { ret 1; }
    ret 0;
}

test "mach.lang.query.get:diag_replay_failure_on_a_cache_hit_is_surfaced" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val db_r: R.Result[QueryDb, str] = init(?alloc);
    if (R.is_err[QueryDb, str](db_r)) { ret 1; }
    var db: QueryDb = R.unwrap_ok[QueryDb, str](db_r);
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_DIAG)) { dnit(?db); ret 1; }

    if (R.is_err[R.Void, str](register_input(?db, Q_FILE_TEXT))) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (R.is_err[R.Void, str](register_derived(?db, Q_TOKENIZE))) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (R.is_err[R.Void, str](set_input(?db, Q_FILE_TEXT, 1, "x"::*u8, 1))) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1))) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }

    diagnostic.store_dnit(?ctx.diags);
    var replay_alloc: A.Allocator;
    var probe: FailProbe;
    if (!failprobe_make(?probe, ?replay_alloc, 1)) { dnit(?db); ret 1; }
    ctx.diags = diagnostic.store_init(?replay_alloc);

    val replay_r: R.Result[*QueryEntry, fail.Fail] =
        get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1);
    if (!R.is_err[*QueryEntry, fail.Fail](replay_r) || diagnostic.len(?ctx.diags) != 0 || probe.calls == 0) {
        probe.fail_at = 0;
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }

    probe.calls   = 0;
    probe.fail_at = 0;
    if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1))) {
        dnit(?db); t_context_dnit(?ctx); ret 1;
    }
    if (diagnostic.len(?ctx.diags) != 1) { dnit(?db); t_context_dnit(?ctx); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

fun t_auto_dep_outer_compute(ctx: *TestQueryContext, key: u64, a: *A.Allocator) R.Result[QueryOutput, fail.Fail] {
    val g: R.Result[*QueryEntry, fail.Fail] = get[TestQueryContext](?ctx.runtime, ctx, Q_TOKENIZE, key);
    if (R.is_err[*QueryEntry, fail.Fail](g)) { ret R.err[QueryOutput, fail.Fail](R.unwrap_err[*QueryEntry, fail.Fail](g)); }
    val res_buf: R.Result[*u8, str] = A.allocate[u8](a, 1);
    if (R.is_err[*u8, str](res_buf)) { ret R.err[QueryOutput, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf))); }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);
    buf[0] = 3;
    var out: QueryOutput;
    out.bytes = buf;
    out.len   = 1;
    ret R.ok[QueryOutput, fail.Fail](out);
}

test "mach.lang.query.get:allocation_failure_during_automatic_dependency_capture_fails_closed" {
    var saw_failure: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= 40) {
        var pa: A.Allocator;
        var probe: FailProbe;
        if (!failprobe_make(?probe, ?pa, 0)) { ret 1; }

        val res_db: R.Result[QueryDb, str] = init(?pa);
        if (R.is_err[QueryDb, str](res_db)) { ret 1; }
        var db: QueryDb = R.unwrap_ok[QueryDb, str](res_db);
        var ctx: TestQueryContext;
        if (!t_context_init(?ctx, ?db, T_MODE_AUTO_DEP)) { dnit(?db); ret 1; }

        if (R.is_err[R.Void, str](register_input(?db, Q_FILE_TEXT)))                        { dnit(?db); ret 1; }
        if (R.is_err[R.Void, str](register_derived(?db, Q_TOKENIZE))) { dnit(?db); ret 1; }
        if (R.is_err[R.Void, str](register_derived(?db, Q_PARSE)))    { dnit(?db); ret 1; }

        if (R.is_err[R.Void, str](set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1))) { dnit(?db); ret 1; }
        if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_TOKENIZE, 1)))              { dnit(?db); ret 1; }

        probe.calls   = 0;
        probe.fail_at = fail_at;

        val res_g: R.Result[*QueryEntry, fail.Fail] = get[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1);
        if (R.is_err[*QueryEntry, fail.Fail](res_g)) {
            saw_failure = true;

            if (peek_valid(?db, Q_PARSE, 1)) { dnit(?db); ret 1; }

            probe.fail_at = 0;
            if (R.is_err[*QueryEntry, fail.Fail](get[TestQueryContext](?ctx.runtime, ?ctx, Q_PARSE, 1))) { dnit(?db); ret 1; }
            if (!peek_valid(?db, Q_PARSE, 1))                     { dnit(?db); ret 1; }
        } or {
            if (R.unwrap_ok[*QueryEntry, fail.Fail](res_g).dep_len == 0) { saw_failure = true; dnit(?db); ret 1; }
        }

        dnit(?db);
        t_context_dnit(?ctx);
        fail_at = fail_at + 1;
    }

    if (!saw_failure) { ret 1; }
    ret 0;
}

rec GrowLoopProbe {
    allocate_calls:   u32;
    reallocate_calls: u32;
}

fun growloop_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.allocate_calls = g.allocate_calls + 1;
    ret O.none[ptr]();
}

fun growloop_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *GrowLoopProbe = ctx::*GrowLoopProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun growloop_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.query.storage_grow:refuses_a_u32_doubling_that_wraps_without_hanging" {
    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    var db: QueryDb;
    db.a           = ?pa;
    db.storage     = nil;
    db.storage_cap = 0x80000000;
    db.kinds       = 0;

    val res: R.Result[R.Void, str] = storage_grow(?db, 0x80000001);
    if (!R.is_err[R.Void, str](res))    { ret 1; }
    if (probe.allocate_calls != 0)    { ret 1; }
    if (probe.reallocate_calls != 0)  { ret 1; }
    ret 0;
}

test "mach.lang.query.deps_reserve:refuses_an_initial_u32_doubling_that_wraps_without_hanging" {
    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    var db: QueryDb;
    db.a = ?pa;

    var entry: QueryEntry;
    entry.deps    = nil;
    entry.dep_len = 0;
    entry.dep_cap = 0;

    val res: R.Result[R.Void, str] = deps_reserve(?db, ?entry, 0x80000001);
    if (!R.is_err[R.Void, str](res)) { ret 1; }
    ret 0;
}

test "mach.lang.query.deps_reserve:refuses_a_grown_u32_doubling_that_wraps_without_hanging" {
    var probe: GrowLoopProbe;
    probe.allocate_calls   = 0;
    probe.reallocate_calls = 0;
    var pp: *GrowLoopProbe = ?probe;
    var pa: A.Allocator;
    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    var db: QueryDb;
    db.a = ?pa;

    var dummy: Dep;
    var entry: QueryEntry;
    entry.deps    = ?dummy;
    entry.dep_len = 1;
    entry.dep_cap = 0x80000000;

    val res: R.Result[R.Void, str] = deps_reserve(?db, ?entry, 0x80000000);
    if (!R.is_err[R.Void, str](res))    { ret 1; }
    if (probe.allocate_calls != 0)    { ret 1; }
    if (probe.reallocate_calls != 0)  { ret 1; }
    ret 0;
}
