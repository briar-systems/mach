    pa.ctx           = pp::ptr;
    pa.fn_allocate   = growloop_probe_allocate;
    pa.fn_reallocate = growloop_probe_reallocate;
    pa.fn_deallocate = growloop_probe_deallocate;

    var db: QueryDb;
    db.a = ?pa;

    var dummy: Dep;
    var entry: QueryEntry;
    entry.deps    = ?dummy;
    entry.dep_len = 1;
    entry.dep_cap = 0x80000000;

    val outcome_r: err[fail.Fail] = deps_reserve(?db, ?entry, 0x80000000);
    if (sel outcome_r.ok)    { ret 1; }
    if (probe.allocate_calls != 0)    { ret 1; }
    if (probe.reallocate_calls != 0)  { ret 1; }
    ret 0;
}

rec MetadataFixture {
    db: QueryDb;
    diags: diagnostic.DiagnosticStore;
    runtime: QueryRuntime[MetadataFixture];
    stamp: MetadataRevision;
    refuse: bool;
    constant_parent: bool;
    reads: u32;
    child_calls: u32;
    parent_calls: u32;
}

fun metadata_fixture_read(raw: ptr, key: u64) res[MetadataRevision, fail.Fail] {
    val fixture: *MetadataFixture = raw::*MetadataFixture;
    fixture.reads = fixture.reads + 1;
    if (fixture.refuse) { ret res[MetadataRevision, fail.Fail].err{fail.message("metadata producer refused")}; }
    ret res[MetadataRevision, fail.Fail].ok{fixture.stamp};
}

fun metadata_fixture_compute(fixture: *MetadataFixture, kind: QueryKind, key: u64,
                             alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    var byte: u8 = 0;
    if (kind == Q_TOKENIZE) {
        fixture.child_calls = fixture.child_calls + 1;
        val state: res[MetadataRevision, fail.Fail] = observe(?fixture.db, Q_TARGET, 0);
        if (sel state.err) { ret res[QueryOutput, fail.Fail].err{state.err}; }
        val stamp: MetadataRevision = state.ok;
        if (stamp.present) { byte = (stamp.revision & 0x7f)::u8 | 0x80; }
    } or {
        fixture.parent_calls = fixture.parent_calls + 1;
        val child: res[*QueryEntry, fail.Fail] = acquire_entry[MetadataFixture](?fixture.runtime, fixture, Q_TOKENIZE, 0);
        if (sel child.err) { ret res[QueryOutput, fail.Fail].err{child.err}; }
        byte = child.ok.value[0];
        if (fixture.constant_parent) { byte = 9; }
    }
    val storage: res[*u8, A.Error] = A.allocate[u8](alloc, 1);
    if (sel storage.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(storage.err)}; }
    val bytes: *u8 = storage.ok;
    bytes[0] = byte;
    ret res[QueryOutput, fail.Fail].ok{QueryOutput{ bytes: bytes, len: 1 }};
}

fun metadata_fixture_init(fixture: *MetadataFixture, alloc: *A.Allocator) err[fail.Fail] {
    val database: res[QueryDb, fail.Fail] = init(alloc);
    if (sel database.err) { ret err[fail.Fail].err{database.err}; }
    fixture.db = database.ok;
    fixture.diags = diagnostic.store_init(alloc);
    fixture.stamp = MetadataRevision{ present: true, revision: 1 };
    fixture.refuse = false;
    fixture.constant_parent = false;
    fixture.reads = 0;
    fixture.child_calls = 0;
    fixture.parent_calls = 0;
    val runtime_r: res[QueryRuntime[MetadataFixture], fail.Fail] = runtime[MetadataFixture](
        ?fixture.db, metadata_fixture_compute);
    if (sel runtime_r.err) {
        dnit(?fixture.db);
        diagnostic.store_dnit(?fixture.diags);
        ret err[fail.Fail].err{runtime_r.err};
    }
    fixture.runtime = runtime_r.ok;
    val meta: err[fail.Fail] = register_metadata(?fixture.db, Q_TARGET,
        RevisionProvider{ context: fixture::ptr, read: metadata_fixture_read });
    val child: err[fail.Fail] = register_derived(?fixture.db, Q_TOKENIZE);
    val parent: err[fail.Fail] = register_derived(?fixture.db, Q_PARSE);
    if (sel meta.err || sel child.err || sel parent.err) {
        dnit(?fixture.db);
        diagnostic.store_dnit(?fixture.diags);
        if (sel meta.err) { ret meta; }
        if (sel child.err) { ret child; }
        ret parent;
    }
    ret err[fail.Fail].ok{};
}

fun metadata_fixture_dnit(fixture: *MetadataFixture) {
    dnit(?fixture.db);
    diagnostic.store_dnit(?fixture.diags);
}

fun metadata_fixture_get(fixture: *MetadataFixture) res[*QueryEntry, fail.Fail] {
    val opened: res[Operation, fail.Fail] = begin(?fixture.db);
    if (sel opened.err) { ret res[*QueryEntry, fail.Fail].err{opened.err}; }
    val result: res[*QueryEntry, fail.Fail] = acquire_entry[MetadataFixture](?fixture.runtime, fixture, Q_PARSE, 0);
    val closed: err[fail.Fail] = end(?fixture.db, opened.ok);
    if (sel result.err) { ret result; }
    if (sel closed.err) { ret res[*QueryEntry, fail.Fail].err{closed.err}; }
    val released: err[fail.Fail] = discard(?fixture.db, opened.ok);
    if (sel released.err) { ret res[*QueryEntry, fail.Fail].err{released.err}; }
    ret result;
}

test "mach.lang.query.refresh:external_change_refreshes_transitively_without_a_local_input_write" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var fixture: MetadataFixture;
    val metadata_fixture_init_r: err[fail.Fail] = metadata_fixture_init(?fixture, ?alloc);
    if (sel metadata_fixture_init_r.err) { ret 1; }
    fin { metadata_fixture_dnit(?fixture); }
    val first: res[*QueryEntry, fail.Fail] = metadata_fixture_get(?fixture);
    if (sel first.err) { ret 2; }
    val before: Revision = first.ok.last_changed;
    fixture.stamp.revision = 2;
    val second: res[*QueryEntry, fail.Fail] = metadata_fixture_get(?fixture);
    if (sel second.err) { ret 3; }
    val entry: *QueryEntry = second.ok;
    if (entry.value[0] != 0x82 || entry.last_changed <= before) { ret 4; }
    if (fixture.child_calls != 2 || fixture.parent_calls != 2) { ret 5; }
    if (fixture.reads != 4) { ret 6; }
    ret 0;
}

test "mach.lang.query.refresh:constant_parent_cuts_off_after_refreshing_its_changed_child" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var fixture: MetadataFixture;
    val metadata_fixture_init_r: err[fail.Fail] = metadata_fixture_init(?fixture, ?alloc);
    if (sel metadata_fixture_init_r.err) { ret 1; }
    fin { metadata_fixture_dnit(?fixture); }
    fixture.constant_parent = true;
    val first: res[*QueryEntry, fail.Fail] = metadata_fixture_get(?fixture);
    if (sel first.err) { ret 2; }
    val before: Revision = first.ok.last_changed;
    fixture.stamp.revision = 2;
    val second: res[*QueryEntry, fail.Fail] = metadata_fixture_get(?fixture);
    if (sel second.err) { ret 3; }
    val entry: *QueryEntry = second.ok;
    if (entry.value[0] != 9 || entry.last_changed != before) { ret 4; }
    if (fixture.child_calls != 2 || fixture.parent_calls != 2) { ret 5; }
    val metadata_fixture_get_r: res[*QueryEntry, fail.Fail] = metadata_fixture_get(?fixture);
    if (sel metadata_fixture_get_r.err) { ret 6; }
    if (fixture.child_calls != 2 || fixture.parent_calls != 2) { ret 7; }
    ret 0;
}

test "mach.lang.query.operation:sampled_metadata_is_stable_and_a_changed_final_stamp_refuses_success" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var fixture: MetadataFixture;
    val metadata_fixture_init_r: err[fail.Fail] = metadata_fixture_init(?fixture, ?alloc);
    if (sel metadata_fixture_init_r.err) { ret 1; }
    fin { metadata_fixture_dnit(?fixture); }
    val opened: res[Operation, fail.Fail] = begin(?fixture.db);
    if (sel opened.err) { ret 2; }
    val operation: Operation = opened.ok;
    val first: res[*QueryEntry, fail.Fail] = acquire_entry[MetadataFixture](?fixture.runtime, ?fixture, Q_PARSE, 0);
    if (sel first.err) { end(?fixture.db, operation); ret 3; }
    fixture.stamp.revision = 2;
    val second: res[*QueryEntry, fail.Fail] = acquire_entry[MetadataFixture](?fixture.runtime, ?fixture, Q_PARSE, 0);
    if (sel second.err) { end(?fixture.db, operation); ret 4; }
    if (fixture.child_calls != 1 || fixture.parent_calls != 1 || fixture.reads != 1) { end(?fixture.db, operation); ret 5; }
    val closed: err[fail.Fail] = end(?fixture.db, operation);
    if (sel closed.ok) { ret 6; }
    if (fixture.db.operation_active) { ret 6; }
    if (!str_contains(fail.describe(closed.err), "changed during")) { ret 7; }
    ret 0;
}

rec ProvenanceFixture {
    db: QueryDb;
    runtime: QueryRuntime[ProvenanceFixture];
    presentation: diagnostic.DiagnosticStore;
    calls: [5]u32;
    fail_leaf: bool;
    swallow: bool;
}

fun provenance_compute(f: *ProvenanceFixture, kind: QueryKind, key: u64, a: *A.Allocator,
                       diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    if (kind != Q_PARSE || key >= 5) { ret res[QueryOutput, fail.Fail].err{fail.message("unexpected provenance fixture key")}; }
    f.calls[key] = f.calls[key] + 1;
    var message: str = "branch";
    var offset: usize = 11;
    if (key == 0) { message = "root"; offset = 0; }
    or (key == 3) { message = "leaf"; offset = 3; }
    or (key == 4) { message = "other"; offset = 4; }
    val emitted: err[fail.Fail] = diagnostic.error(diags, 0, token.Span{ offset: offset, len: 1 }, message);
    if (sel emitted.err) { ret res[QueryOutput, fail.Fail].err{emitted.err}; }
    if (key == 3 && f.fail_leaf) { ret res[QueryOutput, fail.Fail].err{fail.message("provenance leaf failed")}; }
    if (key <= 2) {
        var child: u64 = 3;
        if (key == 0) { child = 1; }
        val read: res[*QueryEntry, fail.Fail] = acquire_entry[ProvenanceFixture](?f.runtime, f, Q_PARSE, child);
        if (sel read.err) { if (!f.swallow) { ret res[QueryOutput, fail.Fail].err{read.err}; } }
        if (key == 0) {
            val second: res[*QueryEntry, fail.Fail] = acquire_entry[ProvenanceFixture](?f.runtime, f, Q_PARSE, 2);
            if (sel second.err) { ret res[QueryOutput, fail.Fail].err{second.err}; }
        }
    }
    val bytes: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel bytes.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(bytes.err)}; }
    val value: *u8 = bytes.ok;
    value[0] = key::u8;
    ret res[QueryOutput, fail.Fail].ok{QueryOutput{ bytes: value, len: 1 }};
}

fun provenance_init(f: *ProvenanceFixture, a: *A.Allocator) err[fail.Fail] {
    val initialized: res[QueryDb, fail.Fail] = init(a);
    if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
    f.db = initialized.ok;
    f.presentation = diagnostic.store_init(a);
    f.calls = [5]u32{ 0, 0, 0, 0, 0 };
    f.fail_leaf = false;
    f.swallow = false;
    val configured: res[QueryRuntime[ProvenanceFixture], fail.Fail] = runtime[ProvenanceFixture](?f.db, provenance_compute);
    if (sel configured.err) {
        dnit(?f.db);
        diagnostic.store_dnit(?f.presentation);
        ret err[fail.Fail].err{configured.err};
    }
    f.runtime = configured.ok;
    val registered: err[fail.Fail] = register_derived(?f.db, Q_PARSE);
    if (sel registered.err) {
        dnit(?f.db);
        diagnostic.store_dnit(?f.presentation);
    }
    ret registered;
}

fun provenance_dnit(f: *ProvenanceFixture) {
    dnit(?f.db);
    diagnostic.store_dnit(?f.presentation);
}

fun provenance_collect(f: *ProvenanceFixture, roots: *QueryKey, count: usize) res[*Presentation, fail.Fail] {
    val opened: res[Operation, fail.Fail] = begin(?f.db);
    if (sel opened.err) { ret res[*Presentation, fail.Fail].err{opened.err}; }
    val operation: Operation = opened.ok;
    var i: usize = 0;
    for (i < count) {
        val read: res[*QueryEntry, fail.Fail] = acquire_entry[ProvenanceFixture](?f.runtime, f, roots[i].kind, roots[i].key);
        if (sel read.err) {
            end(?f.db, operation);
            ret res[*Presentation, fail.Fail].err{read.err};
        }
        i = i + 1;
    }
    val closed: err[fail.Fail] = end(?f.db, operation);
    if (sel closed.err) {
        ret res[*Presentation, fail.Fail].err{closed.err};
    }
    ret collect(?f.db, operation, roots, count, f.db.a);
}

fun provenance_store_free(a: *A.Allocator, store: *Presentation) {
    presentation_dnit(store);
}

test "mach.lang.query.collect:diamond_order_and_distinct_origins_are_cold_warm_invariant" {
    var a: A.Allocator;
    page.make(?a);
    var f: ProvenanceFixture;
    val provenance_init_r: err[fail.Fail] = provenance_init(?f, ?a);
    if (sel provenance_init_r.err) { ret 1; }
    fin { provenance_dnit(?f); }
    var roots: [2]QueryKey = [2]QueryKey{ QueryKey{ kind: Q_PARSE, key: 0 }, QueryKey{ kind: Q_PARSE, key: 4 } };
    val cold_r: res[*Presentation, fail.Fail] = provenance_collect(?f, ?roots[0], 2);
    if (sel cold_r.err) { ret 2; }
    val cold: *Presentation = cold_r.ok;
    fin { provenance_store_free(?a, cold); }
    if (diagnostic.len(?cold.diags) != 5) { ret 3; }
    if (cold.diags.items.data[0].loc.span.offset != 3 || cold.diags.items.data[1].loc.span.offset != 11
        || cold.diags.items.data[2].loc.span.offset != 11 || cold.diags.items.data[3].loc.span.offset != 0
        || cold.diags.items.data[4].loc.span.offset != 4) { ret 4; }
    if (diagnostic.len(?f.presentation) != 0) { ret 5; }
    val warm_r: res[*Presentation, fail.Fail] = provenance_collect(?f, ?roots[0], 2);
    if (sel warm_r.err) { ret 6; }
    val warm: *Presentation = warm_r.ok;
    fin { provenance_store_free(?a, warm); }
    val equal: res[bool, fail.Fail] = diagnostic.content_equal(?cold.diags, ?warm.diags);
    if (sel equal.err) { ret 7; }
    if (!equal.ok) { ret 7; }
    var i: usize = 0;
    for (i < 5) { if (f.calls[i] != 1) { ret 8; } i = i + 1; }
    if (f.db.attempts.len != 0 || f.db.presentation_pending) { ret 9; }
    ret 0;
}

test "mach.lang.query.collect:failed_child_cannot_be_swallowed_and_attempt_evidence_is_released" {
    var a: A.Allocator;
    page.make(?a);
    var f: ProvenanceFixture;
    val provenance_init_r: err[fail.Fail] = provenance_init(?f, ?a);
    if (sel provenance_init_r.err) { ret 1; }
    fin { provenance_dnit(?f); }
    f.fail_leaf = true;
    f.swallow = true;
    val opened: res[Operation, fail.Fail] = begin(?f.db);
    if (sel opened.err) { ret 2; }
    val operation: Operation = opened.ok;
    val read: res[*QueryEntry, fail.Fail] = acquire_entry[ProvenanceFixture](?f.runtime, ?f, Q_PARSE, 0);
    if (sel read.ok) { ret 3; }
    val closed: err[fail.Fail] = end(?f.db, operation);
    if (sel closed.ok) { ret 4; }
    if (shard_len(?f.db, Q_PARSE) != 0 || f.calls[2] != 0 || f.db.attempts.len != 3) { ret 5; }
    var root: QueryKey = QueryKey{ kind: Q_PARSE, key: 0 };
    val presented: res[*Presentation, fail.Fail] = collect(?f.db, operation, ?root, 1, ?a);
    if (sel presented.err) { ret 6; }
    val store: *Presentation = presented.ok;
    fin { provenance_store_free(?a, store); }
    if (diagnostic.len(?store.diags) != 3 || store.diags.items.data[0].loc.span.offset != 3
        || store.diags.items.data[1].loc.span.offset != 11 || store.diags.items.data[2].loc.span.offset != 0) { ret 7; }
    if (f.db.attempts.len != 0 || f.db.presentation_pending) { ret 8; }
    f.fail_leaf = false;
    f.swallow = false;
    val retried: res[*Presentation, fail.Fail] = provenance_collect(?f, ?root, 1);
    if (sel retried.err) { ret 9; }
    provenance_store_free(?a, retried.ok);
    ret 0;
}

test "mach.lang.query.collect:allocation_refusal_keeps_one_retryable_presentation_owner" {
    var a: A.Allocator;
    page.make(?a);
    var f: ProvenanceFixture;
    val provenance_init_r: err[fail.Fail] = provenance_init(?f, ?a);
    if (sel provenance_init_r.err) { ret 1; }
    fin { provenance_dnit(?f); }
    val opened: res[Operation, fail.Fail] = begin(?f.db);
    if (sel opened.err) { ret 2; }
    val operation: Operation = opened.ok;
    val acquire_entry_r: res[*QueryEntry, fail.Fail] = acquire_entry[ProvenanceFixture](?f.runtime, ?f, Q_PARSE, 0);
    if (sel acquire_entry_r.err) { ret 3; }
    val end_r: err[fail.Fail] = end(?f.db, operation);
    if (sel end_r.err) { ret 4; }
    var probe: FailProbe;
    var refusing: A.Allocator;
    if (!failprobe_make(?probe, ?refusing, 2)) { ret 5; }
    var root: QueryKey = QueryKey{ kind: Q_PARSE, key: 0 };
    val refused: res[*Presentation, fail.Fail] = collect(?f.db, operation, ?root, 1, ?refusing);
    if (sel refused.ok) { ret 6; }
    if (probe.live != 0) { ret 6; }
    if (!f.db.presentation_pending || f.db.attempts.len != 4) { ret 7; }
    val begin_r: res[Operation, fail.Fail] = begin(?f.db);
    if (sel begin_r.ok) { ret 8; }
    val invalidate_r: err[fail.Fail] = invalidate(?f.db, Q_PARSE, 0);
    if (sel invalidate_r.ok) { ret 9; }
    probe.fail_at = 0;
    val retried: res[*Presentation, fail.Fail] = collect(?f.db, operation, ?root, 1, ?refusing);
    if (sel retried.err) { ret 10; }
    val store: *Presentation = retried.ok;
    if (diagnostic.len(?store.diags) != 4) { provenance_store_free(?refusing, store); ret 11; }
    provenance_store_free(?refusing, store);
    if (probe.live != 0 || f.db.presentation_pending || f.db.attempts.len != 0) { ret 12; }
    ret 0;
}

test "mach.lang.query.cycle:rich_failure_transfers_to_the_presentation_without_per_attempt_growth" {
    var alloc: A.Allocator;
    var probe: FailProbe;
    if (!failprobe_make(?probe, ?alloc, 0)) { ret 1; }
    val initialized: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel initialized.err) { ret 2; }
    var db: QueryDb = initialized.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_INDIRECT)) { dnit(?db); ret 3; }
    val register_derived_r2: err[fail.Fail] = register_derived(?db, Q_SEMA);
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_LOWER);
    if (sel register_derived_r2.err) { t_context_dnit(?ctx); dnit(?db); ret 4; }
    if (sel register_derived_r.err) { t_context_dnit(?ctx); dnit(?db); ret 4; }
    var baseline: i64 = 0;
    var i: u32 = 0;
    for (i < 32) {
        val result: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_SEMA, 7);
        if (sel result.ok) { t_context_dnit(?ctx); dnit(?db); ret 5; }
        val failure: fail.Fail = result.err;
        if (!sel failure.message) {
            t_context_dnit(?ctx); dnit(?db); ret 6;
        }
        if (!str_contains(fail.describe(failure), "9:7 -> 10:7 -> 9:7")) {
            t_context_dnit(?ctx); dnit(?db); ret 6;
        }
        if (ctx.last_presentation == nil || db.operation_message != nil || db.attempts.len != 0) {
            t_context_dnit(?ctx); dnit(?db); ret 7;
        }
        presentation_dnit(ctx.last_presentation);
        ctx.last_presentation = nil;
        if (i == 1) { baseline = probe.live; }
        if (i > 1 && probe.live != baseline) { t_context_dnit(?ctx); dnit(?db); ret 8; }
        i = i + 1;
    }
    t_context_dnit(?ctx);
    dnit(?db);
    if (probe.live != 0) { ret 9; }
    ret 0;
}

test "mach.lang.query.reusable:validates_transitive_inputs_without_computing_the_requested_product" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var fixture: MetadataFixture;
    val metadata_fixture_init_r: err[fail.Fail] = metadata_fixture_init(?fixture, ?alloc);
    if (sel metadata_fixture_init_r.err) { ret 2; }
    fin { metadata_fixture_dnit(?fixture); }
    val metadata_fixture_get_r: res[*QueryEntry, fail.Fail] = metadata_fixture_get(?fixture);
    if (sel metadata_fixture_get_r.err) { ret 3; }
    fixture.stamp.revision = 2;
    val begun: res[Operation, fail.Fail] = begin(?fixture.db);
    if (sel begun.err) { ret 4; }
    val operation: Operation = begun.ok;
    val stale: res[bool, fail.Fail] = reusable[MetadataFixture](?fixture.runtime, ?fixture, Q_PARSE, 0);
    if (sel stale.err) { ret 5; }
    if (stale.ok) { ret 5; }
    if (fixture.child_calls != 2 || fixture.parent_calls != 1) { ret 6; }
    val current: res[QueryView, fail.Fail] = get[MetadataFixture](?fixture.runtime, ?fixture, Q_PARSE, 0);
    if (sel current.err) { ret 7; }
    if (current.ok.value[0] != 0x82) { ret 7; }
    if (fixture.child_calls != 2 || fixture.parent_calls != 2) { ret 8; }
    val warm: res[bool, fail.Fail] = reusable[MetadataFixture](?fixture.runtime, ?fixture, Q_PARSE, 0);
    if (sel warm.err) { ret 9; }
    if (!warm.ok) { ret 9; }
    val end_r: err[fail.Fail] = end(?fixture.db, operation);
    if (sel end_r.err) { ret 10; }
    val discard_r: err[fail.Fail] = discard(?fixture.db, operation);
    if (sel discard_r.err) { ret 11; }
    fixture.refuse = true;
    val retry: res[Operation, fail.Fail] = begin(?fixture.db);
    if (sel retry.err) { ret 12; }
    val refused: res[bool, fail.Fail] = reusable[MetadataFixture](?fixture.runtime, ?fixture, Q_PARSE, 0);
    if (sel refused.ok) { ret 13; }
    if (!str_equals(fail.describe(refused.err), "metadata producer refused")) { ret 14; }
    val end_r2: err[fail.Fail] = end(?fixture.db, retry.ok);
    if (sel end_r2.ok) { ret 15; }
    if (fixture.parent_calls != 2) { ret 16; }
    ret 0;
}

fun t_branch_compute(ctx: *TestQueryContext, kind: QueryKind, key: u64,
                     a: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    val selected: res[QueryView, fail.Fail] = get[TestQueryContext](?ctx.runtime, ctx, Q_FILE_TEXT, key);
    if (sel selected.err) { ret res[QueryOutput, fail.Fail].err{selected.err}; }
    val branch: u8 = selected.ok.value[0];
    if (kind == Q_TOKENIZE && branch != 0) {
        ret res[QueryOutput, fail.Fail].err{fail.message("the previous branch has no current definition")};
    }
    var byte: u8 = branch;
    if (kind == Q_TOKENIZE) { byte = 77; }
    or (branch == 0) {
        val child: res[QueryView, fail.Fail] = get[TestQueryContext](?ctx.runtime, ctx, Q_TOKENIZE, key);
        if (sel child.err) { ret res[QueryOutput, fail.Fail].err{child.err}; }
        byte = child.ok.value[0];
    }
    val copied: res[*u8, fail.Fail] = bytes_dup(a, ?byte, 1);
    if (sel copied.err) { ret res[QueryOutput, fail.Fail].err{copied.err}; }
    ret res[QueryOutput, fail.Fail].ok{QueryOutput{ bytes: copied.ok, len: 1 }};
}

test "mach.lang.query.get:changed_selector_does_not_validate_an_obsolete_branch" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[QueryDb, fail.Fail] = init(?a);
    if (sel initialized.err) { ret 2; }
    var db: QueryDb = initialized.ok;
    fin { dnit(?db); }
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_BRANCH)) { ret 3; }
    fin { t_context_dnit(?ctx); }
    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err) { ret 4; }
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
    if (sel register_derived_r.err) { ret 5; }
    val register_derived_r2: err[fail.Fail] = register_derived(?db, Q_PARSE);
    if (sel register_derived_r2.err) { ret 6; }
    var turn: u32 = 0;
    for (turn < 4) {
        var branch: u8 = (turn & 1)::u8;
        val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, ?branch, 1);
        if (sel set_input_r.err) { ret 7; }
        val reusable_r: res[bool, fail.Fail] = t_reusable(?ctx, Q_PARSE, 1);
        if (sel reusable_r.err) { ret 8; }
        if (reusable_r.ok) { ret 8; }
        val read: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
        if (sel read.err) { ret 9; }
        var expected: u8 = 77;
        if (branch != 0) { expected = branch; }
        if (read.ok.value[0] != expected) { ret 10; }
        turn = turn + 1;
    }
    ret 0;
}

fun t_owned_equal(a: *u8, a_len: u32, b: *u8, b_len: u32) bool {
    if (a_len != $size_of(ptr)::u32 || b_len != a_len) { ret false; }
    val x: *u64 = (@(a::*ptr))::*u64;
    val y: *u64 = (@(b::*ptr))::*u64;
    ret @x == @y;
}

test "mach.lang.query:equal_owned_candidates_preserve_identity_and_release_once" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[QueryDb, fail.Fail] = init(?a);
    if (sel initialized.err) { ret 2; }
    var db: QueryDb = initialized.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_OWNED)) { dnit(?db); ret 3; }
    fin { t_context_dnit(?ctx); }
    t_live = 0;
    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    val register_derived_equatable_r: err[fail.Fail] = register_derived_equatable(?db, Q_PARSE, t_owned_finalize, t_owned_equal);
    if (sel register_input_r.err) { dnit(?db); ret 4; }
    if (sel register_derived_equatable_r.err) { dnit(?db); ret 4; }
    var identity: ptr = nil;
    var revision: Revision = 0;
    var i: u8 = 0;
    var code: i32 = 0;
    for (i < 4) {
        val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, ?i, 1);
        if (sel set_input_r.err) { code = 5; brk; }
        val result: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
        if (sel result.err) { code = 6; brk; }
        val entry: *QueryEntry = result.ok;
        if (i == 0) { identity = t_handle_ptr(entry); revision = entry.last_changed; }
        if (t_handle_ptr(entry) != identity || entry.last_changed != revision || t_live != 1) { code = 7; brk; }
        i = i + 1;
    }
    dnit(?db);
    if (t_live != 0) { ret 8; }
    ret code;
}

rec ChainFixture {
    db: QueryDb;
    runtime: QueryRuntime[ChainFixture];
    presentation: *Presentation;
    b_calls: u32;
    c_calls: u32;
    t_calls: u32;
    b_constant: bool;
    b_fail: bool;
    b_diag: bool;
}

fun chain_byte(alloc: *A.Allocator, byte: u8) res[QueryOutput, fail.Fail] {
    val storage: res[*u8, A.Error] = A.allocate[u8](alloc, 1);
    if (sel storage.err) { ret res[QueryOutput, fail.Fail].err{fail.refused(storage.err)}; }
    val bytes: *u8 = storage.ok;
    bytes[0] = byte;
    ret res[QueryOutput, fail.Fail].ok{QueryOutput{ bytes: bytes, len: 1 }};
}

# a = Q_FILE_TEXT input, b = Q_TOKENIZE over a, c = Q_PARSE over b, t = Q_SEMA over a and the Q_TARGET input
fun chain_compute(f: *ChainFixture, kind: QueryKind, key: u64,
                  alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[QueryOutput, fail.Fail] {
    if (kind == Q_TOKENIZE) {
        f.b_calls = f.b_calls + 1;
        val a: res[QueryView, fail.Fail] = get[ChainFixture](?f.runtime, f, Q_FILE_TEXT, 1);
        if (sel a.err) { ret res[QueryOutput, fail.Fail].err{a.err}; }
        if (f.b_diag) {
            val emitted: err[fail.Fail] = diagnostic.error(diags, 0, token.Span{ offset: 0, len: 1 }, "b changed");
            if (sel emitted.err) { ret res[QueryOutput, fail.Fail].err{emitted.err}; }
        }
        if (f.b_fail) { ret res[QueryOutput, fail.Fail].err{fail.message("b failed")}; }
        var byte: u8 = a.ok.value[0];
        if (f.b_constant) { byte = 7; }
        ret chain_byte(alloc, byte);
    }
    if (kind == Q_PARSE) {
        f.c_calls = f.c_calls + 1;
        val b: res[QueryView, fail.Fail] = get[ChainFixture](?f.runtime, f, Q_TOKENIZE, 1);
        if (sel b.err) { ret res[QueryOutput, fail.Fail].err{b.err}; }
        ret chain_byte(alloc, b.ok.value[0] + 1);
    }
    if (kind == Q_SEMA) {
        f.t_calls = f.t_calls + 1;
        val a: res[QueryView, fail.Fail] = get[ChainFixture](?f.runtime, f, Q_FILE_TEXT, 1);
        if (sel a.err) { ret res[QueryOutput, fail.Fail].err{a.err}; }
        val target: res[QueryView, fail.Fail] = get[ChainFixture](?f.runtime, f, Q_TARGET, 0);
        if (sel target.err) { ret res[QueryOutput, fail.Fail].err{target.err}; }
        ret chain_byte(alloc, a.ok.value[0] + target.ok.value[0]);
    }
    if (kind == Q_LOWER) {
        val c: res[QueryView, fail.Fail] = get[ChainFixture](?f.runtime, f, Q_PARSE, 1);
        if (sel c.err) { ret res[QueryOutput, fail.Fail].err{c.err}; }
        ret chain_byte(alloc, c.ok.value[0]);
    }
    ret res[QueryOutput, fail.Fail].err{fail.message("chain fixture has no such query")};
}

fun chain_init(f: *ChainFixture, alloc: *A.Allocator) err[fail.Fail] {
    val initialized: res[QueryDb, fail.Fail] = init(alloc);
    if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
    f.db = initialized.ok;
    f.presentation = nil;
    f.b_calls = 0;
    f.c_calls = 0;
    f.t_calls = 0;
    f.b_constant = false;
    f.b_fail = false;
    f.b_diag = false;
    val configured: res[QueryRuntime[ChainFixture], fail.Fail] = runtime[ChainFixture](?f.db, chain_compute);
    if (sel configured.err) { dnit(?f.db); ret err[fail.Fail].err{configured.err}; }
    f.runtime = configured.ok;
    val register_input_r2: err[fail.Fail] = register_input(?f.db, Q_FILE_TEXT);
    val register_input_r: err[fail.Fail] = register_input(?f.db, Q_TARGET);
    val register_derived_r4: err[fail.Fail] = register_derived(?f.db, Q_TOKENIZE);
    val register_derived_r3: err[fail.Fail] = register_derived(?f.db, Q_PARSE);
    val register_derived_r2: err[fail.Fail] = register_derived(?f.db, Q_SEMA);
    val register_derived_r: err[fail.Fail] = register_derived(?f.db, Q_LOWER);
    if (sel register_input_r2.err) {
        dnit(?f.db);
        ret err[fail.Fail].err{fail.message("chain fixture registration failed")};
    }
    if (sel register_input_r.err) {
        dnit(?f.db);
        ret err[fail.Fail].err{fail.message("chain fixture registration failed")};
    }
    if (sel register_derived_r4.err) {
        dnit(?f.db);
        ret err[fail.Fail].err{fail.message("chain fixture registration failed")};
    }
    if (sel register_derived_r3.err) {
        dnit(?f.db);
        ret err[fail.Fail].err{fail.message("chain fixture registration failed")};
    }
    if (sel register_derived_r2.err) {
        dnit(?f.db);
        ret err[fail.Fail].err{fail.message("chain fixture registration failed")};
    }
    if (sel register_derived_r.err) {
        dnit(?f.db);
        ret err[fail.Fail].err{fail.message("chain fixture registration failed")};
    }
    ret set_input(?f.db, Q_FILE_TEXT, 1, "a"::*u8, 1);
}

fun chain_dnit(f: *ChainFixture) {
    presentation_dnit(f.presentation);
    f.presentation = nil;
    dnit(?f.db);
}

# one operation: read the root, end, and keep its presentation for inspection
fun chain_get(f: *ChainFixture, kind: QueryKind, key: u64) res[QueryView, fail.Fail] {
    presentation_dnit(f.presentation);
    f.presentation = nil;
    val opened: res[Operation, fail.Fail] = begin(?f.db);
    if (sel opened.err) { ret res[QueryView, fail.Fail].err{opened.err}; }
    val operation: Operation = opened.ok;
    val result: res[QueryView, fail.Fail] = get[ChainFixture](?f.runtime, f, kind, key);
    val closed: err[fail.Fail] = end(?f.db, operation);
    var root: QueryKey = QueryKey{ kind: kind, key: key };
    val presented: res[*Presentation, fail.Fail] = collect(?f.db, operation, ?root, 1, f.db.a);
    if (sel presented.err) { ret res[QueryView, fail.Fail].err{presented.err}; }
    f.presentation = presented.ok;
    if (sel result.err) { ret result; }
    if (sel closed.err) { ret res[QueryView, fail.Fail].err{closed.err}; }
    ret result;
}

fun chain_reusable(f: *ChainFixture, kind: QueryKind, key: u64) res[bool, fail.Fail] {
    val opened: res[Operation, fail.Fail] = begin(?f.db);
    if (sel opened.err) { ret res[bool, fail.Fail].err{opened.err}; }
    val operation: Operation = opened.ok;
    val result: res[bool, fail.Fail] = reusable[ChainFixture](?f.runtime, f, kind, key);
    val closed: err[fail.Fail] = end(?f.db, operation);
    val released: err[fail.Fail] = discard(?f.db, operation);
    if (sel result.err) { ret result; }
    if (sel closed.err) { ret res[bool, fail.Fail].err{closed.err}; }
    if (sel released.err) { ret res[bool, fail.Fail].err{released.err}; }
    ret result;
}

test "mach.lang.query.get:a_change_below_b_refreshes_c_through_b" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: ChainFixture;
    val chain_init_r: err[fail.Fail] = chain_init(?f, ?alloc);
    if (sel chain_init_r.err) { ret 2; }
    fin { chain_dnit(?f); }
    val cold: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel cold.err) { ret 3; }
    if (cold.ok.value[0] != 'a'::u8 + 1) { ret 3; }
    if (f.b_calls != 1 || f.c_calls != 1) { ret 4; }
    val c_before: Revision = peek_revision(?f.db, Q_PARSE, 1);
    val b_before: Revision = peek_revision(?f.db, Q_TOKENIZE, 1);
    val set_input_r: err[fail.Fail] = set_input(?f.db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r.err) { ret 5; }
    val stale: res[bool, fail.Fail] = chain_reusable(?f, Q_PARSE, 1);
    if (sel stale.err) { ret 6; }
    if (stale.ok) { ret 6; }
    val warm: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel warm.err) { ret 7; }
    if (warm.ok.value[0] != 'b'::u8 + 1) { ret 7; }
    if (f.b_calls != 2 || f.c_calls != 2) { ret 8; }
    if (peek_revision(?f.db, Q_PARSE, 1) <= c_before || peek_revision(?f.db, Q_TOKENIZE, 1) <= b_before) { ret 9; }
    val same: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel same.err) { ret 10; }
    if (f.b_calls != 2) { ret 10; }
    if (f.c_calls != 2) { ret 10; }
    ret 0;
}

test "mach.lang.query.get:an_equal_recomputed_b_cuts_off_c" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: ChainFixture;
    val chain_init_r: err[fail.Fail] = chain_init(?f, ?alloc);
    if (sel chain_init_r.err) { ret 2; }
    fin { chain_dnit(?f); }
    f.b_constant = true;
    val cold: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel cold.err) { ret 3; }
    if (cold.ok.value[0] != 8) { ret 3; }
    val c_before: Revision = peek_revision(?f.db, Q_PARSE, 1);
    val b_before: Revision = peek_revision(?f.db, Q_TOKENIZE, 1);
    val set_input_r: err[fail.Fail] = set_input(?f.db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r.err) { ret 4; }
    val warm: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel warm.err) { ret 5; }
    if (warm.ok.value[0] != 8) { ret 5; }
    if (f.b_calls != 2 || f.c_calls != 1) { ret 6; }
    if (peek_revision(?f.db, Q_PARSE, 1) != c_before || peek_revision(?f.db, Q_TOKENIZE, 1) != b_before) { ret 7; }
    ret 0;
}

test "mach.lang.query.get:a_failed_b_cannot_leave_a_stale_successful_c" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: ChainFixture;
    val chain_init_r: err[fail.Fail] = chain_init(?f, ?alloc);
    if (sel chain_init_r.err) { ret 2; }
    fin { chain_dnit(?f); }
    val chain_get_r: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel chain_get_r.err) { ret 3; }
    val set_input_r: err[fail.Fail] = set_input(?f.db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r.err) { ret 4; }
    f.b_fail = true;
    val failed: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel failed.ok) { ret 5; }
    if (!str_contains(fail.describe(failed.err), "b failed")) { ret 5; }
    if (f.b_calls != 2 || f.c_calls != 1) { ret 6; }
    val still: res[bool, fail.Fail] = chain_reusable(?f, Q_PARSE, 1);
    if (sel still.ok && still.ok) { ret 7; }
    val again: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel again.ok) { ret 8; }
    if (f.c_calls != 1) { ret 8; }
    f.b_fail = false;
    val recovered: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel recovered.err) { ret 9; }
    if (recovered.ok.value[0] != 'b'::u8 + 1) { ret 9; }
    if (f.b_calls != 5 || f.c_calls != 2) { ret 10; }
    ret 0;
}

test "mach.lang.query.publish:changed_diagnostics_with_equal_bytes_are_observable" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: ChainFixture;
    val chain_init_r: err[fail.Fail] = chain_init(?f, ?alloc);
    if (sel chain_init_r.err) { ret 2; }
    fin { chain_dnit(?f); }
    f.b_constant = true;
    val chain_get_r: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel chain_get_r.err) { ret 3; }
    if (diagnostic.len(?f.presentation.diags) != 0) { ret 4; }
    val b_before: Revision = peek_revision(?f.db, Q_TOKENIZE, 1);
    val set_input_r: err[fail.Fail] = set_input(?f.db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r.err) { ret 5; }
    f.b_diag = true;
    val warm: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel warm.err) { ret 6; }
    if (warm.ok.value[0] != 8) { ret 6; }
    if (diagnostic.len(?f.presentation.diags) != 1 || !str_contains(f.presentation.diags.items.data[0].message, "b changed")) { ret 7; }
    if (peek_revision(?f.db, Q_TOKENIZE, 1) == b_before) { ret 8; }
    val replayed: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel replayed.err) { ret 9; }
    if (diagnostic.len(?f.presentation.diags) != 1) { ret 9; }
    if (f.b_calls != 2) { ret 10; }
    ret 0;
}

test "mach.lang.query.get:a_selected_target_change_invalidates_products_that_read_it" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: ChainFixture;
    val chain_init_r: err[fail.Fail] = chain_init(?f, ?alloc);
    if (sel chain_init_r.err) { ret 2; }
    fin { chain_dnit(?f); }
    val set_input_r: err[fail.Fail] = set_input(?f.db, Q_TARGET, 0, "\x01"::*u8, 1);
    if (sel set_input_r.err) { ret 3; }
    val host: res[QueryView, fail.Fail] = chain_get(?f, Q_SEMA, 1);
    if (sel host.err) { ret 4; }
    if (host.ok.value[0] != 'a'::u8 + 1) { ret 4; }
    val before: Revision = peek_revision(?f.db, Q_SEMA, 1);
    val set_input_r2: err[fail.Fail] = set_input(?f.db, Q_TARGET, 0, "\x02"::*u8, 1);
    if (sel set_input_r2.err) { ret 5; }
    val stale: res[bool, fail.Fail] = chain_reusable(?f, Q_SEMA, 1);
    if (sel stale.err) { ret 6; }
    if (stale.ok) { ret 6; }
    val other: res[QueryView, fail.Fail] = chain_get(?f, Q_SEMA, 1);
    if (sel other.err) { ret 7; }
    if (other.ok.value[0] != 'a'::u8 + 2) { ret 7; }
    if (f.t_calls != 2 || peek_revision(?f.db, Q_SEMA, 1) <= before) { ret 8; }
    val set_input_r3: err[fail.Fail] = set_input(?f.db, Q_TARGET, 0, "\x02"::*u8, 1);
    if (sel set_input_r3.err) { ret 9; }
    val chain_get_r: res[QueryView, fail.Fail] = chain_get(?f, Q_SEMA, 1);
    if (sel chain_get_r.err) { ret 10; }
    if (f.t_calls != 2) { ret 10; }
    ret 0;
}

test "mach.lang.query.get:validating_a_stale_dependency_records_no_incidental_edge" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: ChainFixture;
    val chain_init_r: err[fail.Fail] = chain_init(?f, ?alloc);
    if (sel chain_init_r.err) { ret 2; }
    fin { chain_dnit(?f); }
    f.b_constant = true;
    val chain_get_r: res[QueryView, fail.Fail] = chain_get(?f, Q_PARSE, 1);
    if (sel chain_get_r.err) { ret 3; }
    val set_input_r: err[fail.Fail] = set_input(?f.db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r.err) { ret 4; }
    val chain_get_r2: res[QueryView, fail.Fail] = chain_get(?f, Q_LOWER, 1);
    if (sel chain_get_r2.err) { ret 5; }
    if (f.b_calls != 2 || f.c_calls != 1) { ret 6; }
    val root: res[Vector[QueryKey], fail.Fail] = cached_dependency_keys(?f.db, Q_LOWER, 1, ?alloc);
    if (sel root.err) { ret 7; }
    var root_keys: Vector[QueryKey] = root.ok;
    fin { vector.dnit[QueryKey](?root_keys); }
    if (root_keys.len != 1 || root_keys.data[0].kind != Q_PARSE) { ret 8; }
    val mid: res[Vector[QueryKey], fail.Fail] = cached_dependency_keys(?f.db, Q_PARSE, 1, ?alloc);
    if (sel mid.err) { ret 9; }
    var mid_keys: Vector[QueryKey] = mid.ok;
    fin { vector.dnit[QueryKey](?mid_keys); }
    if (mid_keys.len != 1 || mid_keys.data[0].kind != Q_TOKENIZE) { ret 10; }
    ret 0;
}

var t_retire_db: *QueryDb = nil;
var t_retire_order: u32 = 0;
var t_retire_inputs_live: bool = true;

fun t_retire_parent(value: *u8, len: u32, a: *A.Allocator) {
    t_retire_order = t_retire_order * 10 + 1;
    val child: res[*QueryEntry, fail.Fail] = peek(t_retire_db, Q_TOKENIZE, 1);
    if (!(sel child.ok && child.ok.value != nil)) {
        t_retire_inputs_live = false;
    }
}

fun t_retire_child(value: *u8, len: u32, a: *A.Allocator) {
    t_retire_order = t_retire_order * 10 + 2;
    val input: res[*QueryEntry, fail.Fail] = peek(t_retire_db, Q_FILE_TEXT, 1);
    if (!(sel input.ok && input.ok.value != nil)) {
        t_retire_inputs_live = false;
    }
}

test "mach.lang.query.retirement:dependents_retire_before_inputs_and_unrelated_roots_survive" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val init_r: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel init_r.err) { ret 99; }
    var db: QueryDb = init_r.ok;
    fin { dnit(?db); t_retire_db = nil; }
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_PARSE_DEPS)) { ret 1; }
    fin { t_context_dnit(?ctx); }
    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err) { ret 99; }
    val register_derived_owned_r: err[fail.Fail] = register_derived_owned(?db, Q_TOKENIZE, t_retire_child);
    if (sel register_derived_owned_r.err) { ret 99; }
    val register_derived_owned_r2: err[fail.Fail] = register_derived_owned(?db, Q_PARSE, t_retire_parent);
    if (sel register_derived_owned_r2.err) { ret 99; }
    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
    if (sel set_input_r.err) { ret 99; }
    val set_input_r2: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 2, "unrelated"::*u8, 9);
    if (sel set_input_r2.err) { ret 99; }
    val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_PARSE, 1);
    if (sel t_get_r.err) { ret 99; }
    val unrelated: Revision = peek_revision(?db, Q_FILE_TEXT, 2);
    t_retire_db = ?db;
    t_retire_order = 0;
    t_retire_inputs_live = true;
    var root: QueryKey = QueryKey{ kind: Q_FILE_TEXT, key: 1 };
    val prepare_retirement_r: res[PreparedRetirement, fail.Fail] = prepare_retirement(?db, ?root, 1);
    if (sel prepare_retirement_r.err) { ret 99; }
    var prepared: PreparedRetirement = prepare_retirement_r.ok;
    fin { discard_retirement(?prepared); }
    if (t_retire_order != 0 || shard_len(?db, Q_FILE_TEXT) != 2) { ret 2; }
    val commit_retirement_r: err[fail.Fail] = commit_retirement(?prepared);
    if (sel commit_retirement_r.err) { ret 99; }
    if (t_retire_order != 12 || !t_retire_inputs_live) { ret 3; }
    if (shard_len(?db, Q_PARSE) != 0 || shard_len(?db, Q_TOKENIZE) != 0 || shard_len(?db, Q_FILE_TEXT) != 1) { ret 4; }
    if (peek_revision(?db, Q_FILE_TEXT, 2) != unrelated || peek_revision(?db, Q_FILE_TEXT, 1) != 0) { ret 5; }
    ret 0;
}

test "mach.lang.query.retirement:input_mutation_refuses_a_stale_preparation_without_retiring_owners" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val init_r: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel init_r.err) { ret 99; }
    var db: QueryDb = init_r.ok;
    fin { dnit(?db); }
    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err) { ret 99; }
    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
    if (sel set_input_r.err) { ret 99; }
    var root: QueryKey = QueryKey{ kind: Q_FILE_TEXT, key: 1 };
    val prepare_retirement_r: res[PreparedRetirement, fail.Fail] = prepare_retirement(?db, ?root, 1);
    if (sel prepare_retirement_r.err) { ret 99; }
    var prepared: PreparedRetirement = prepare_retirement_r.ok;
    fin { discard_retirement(?prepared); }
    val set_input_r2: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "b"::*u8, 1);
    if (sel set_input_r2.err) { ret 99; }
    val changed: Revision = peek_revision(?db, Q_FILE_TEXT, 1);
    val commit_retirement_r: err[fail.Fail] = commit_retirement(?prepared);
    if (sel commit_retirement_r.ok) { ret 1; }
    if (shard_len(?db, Q_FILE_TEXT) != 1 || peek_revision(?db, Q_FILE_TEXT, 1) != changed) { ret 2; }
    val peek_r: res[*QueryEntry, fail.Fail] = peek(?db, Q_FILE_TEXT, 1);
    if (sel peek_r.err) { ret 99; }
    if (peek_r.ok.value[0] != 'b'::u8) { ret 3; }
    ret 0;
}
