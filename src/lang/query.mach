test "mach.lang.query.get:indirect_two_kind_cycle_reports_the_full_chain" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_INDIRECT)) { dnit(?db); ret 1; }

    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_SEMA);
    if (sel register_derived_r.err)  { dnit(?db); ret 1; }
    val register_derived_r2: err[fail.Fail] = register_derived(?db, Q_LOWER);
    if (sel register_derived_r2.err) { dnit(?db); ret 1; }

    val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_SEMA, 1);
    if (sel t_get_r.ok) { dnit(?db); ret 1; }
    if (db.stack.len != 0)                                { dnit(?db); ret 1; }
    val valid_4: res[bool, fail.Fail] = t_reusable(?ctx, Q_SEMA, 1);
    if (sel valid_4.err) { dnit(?db); ret 1; }
    if (valid_4.ok)                        { dnit(?db); ret 1; }
    val valid_5: res[bool, fail.Fail] = t_reusable(?ctx, Q_LOWER, 1);
    if (sel valid_5.err) { dnit(?db); ret 1; }
    if (valid_5.ok)                       { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

test "mach.lang.query.invalidate:advances_revision_so_a_dependent_cannot_see_reuse" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_db: res[QueryDb, fail.Fail] = init(?alloc);
    if (sel res_db.err) { ret 1; }
    var db: QueryDb = res_db.ok;
    var ctx: TestQueryContext;
    if (!t_context_init(?ctx, ?db, T_MODE_TOKENIZE)) { dnit(?db); ret 1; }

    val register_input_r: err[fail.Fail] = register_input(?db, Q_FILE_TEXT);
    if (sel register_input_r.err)                 { dnit(?db); ret 1; }
    val register_derived_r: err[fail.Fail] = register_derived(?db, Q_TOKENIZE);
    if (sel register_derived_r.err) { dnit(?db); ret 1; }

    val set_input_r: err[fail.Fail] = set_input(?db, Q_FILE_TEXT, 1, "a"::*u8, 1);
    if (sel set_input_r.err) { dnit(?db); ret 1; }
    val t_get_r: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel t_get_r.err)              { dnit(?db); ret 1; }
    val r1: Revision = peek_revision(?db, Q_TOKENIZE, 1);

    val invalidate_r: err[fail.Fail] = invalidate(?db, Q_TOKENIZE, 1);
    if (sel invalidate_r.err)     { dnit(?db); ret 1; }
    val t_get_r2: res[*QueryEntry, fail.Fail] = t_get(?ctx, Q_TOKENIZE, 1);
    if (sel t_get_r2.err)     { dnit(?db); ret 1; }
    val r2: Revision = peek_revision(?db, Q_TOKENIZE, 1);

    if (r2 == r1) { dnit(?db); ret 1; }
    if (r2 < r1)  { dnit(?db); ret 1; }

    dnit(?db);
    t_context_dnit(?ctx);
    ret 0;
}

