# the supervisor of a host that starts no process. an owner here never holds a child: its one
# spawn is refused, it is never running, and everything that needs a running child refuses with
# the same cause, so the diagnostic a command ends with names what the host cannot do

use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use system_os:       std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_is_empty;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.host.subprocess.shape.CaptureIoResult;
use mach.host.subprocess.shape.STATE_SPAWN_FAILURE;
use mach.host.subprocess.shape.STATE_UNSTARTED;
use mach.host.subprocess.shape.SpawnOptions;
use mach.host.subprocess.shape.SubprocessTerminal;

val CAUSE: str = "this host cannot start a process";

# the one refusal of this member, named with the pathname the caller gave
# ---
# identity: the pathname of the child that was not started, borrowed from the caller
pub rec Error {
    identity: str;
}

# the machine's refusal `e` to `verb` the child, an environment failure under `k` naming the child
# and, when `cwd` is given, the directory it would have run in
pub fun refusal(a: *A.Allocator, k: diagnostic_kind.Kind, verb: str, e: Error, cwd: str) fail.Fail {
    var op: fail.Op = fail.Op{verb: verb, role: "the process", path: e.identity};
    if (cwd != nil && !str_is_empty(cwd)) {
        op.link  = "in";
        op.other = cwd;
    }
    ret refusal_of(a, k, op, e);
}

# the machine's refusal `e` of `op`, which names the child as its caller knows it
pub fun refusal_of(a: *A.Allocator, k: diagnostic_kind.Kind, op: fail.Op, e: Error) fail.Fail {
    ret fail.refusal(a, k, op, fail.Cause.text{CAUSE});
}

# what refused in `e`, static, for a line that names the child itself
pub fun reason(e: Error) str {
    ret CAUSE;
}

# the refusal every spawn here meets, named by `identity`, so a command that would start a
# process can say so before it does the work that leads up to one
pub fun unable(identity: str) opt[Error] {
    ret opt[Error].some{Error{identity: identity}};
}

# refuse the search: no program found on PATH could be started
pub fun resolve(a: *A.Allocator, name: str) res[str, Error] {
    ret res[str, Error].err{Error{identity: name}};
}

# the owner of a child that is never started
# ---
# terminal: STATE_UNSTARTED, then STATE_SPAWN_FAILURE once its spawn was refused
# pathname: the pathname its spawn was given, naming its refusals, borrowed from the caller
# timeout:  the bound `bound` was given
pub rec OwnedSubprocess {
    terminal: SubprocessTerminal;
    pathname: str;
    timeout:  chrono_duration.Duration;
}

fun refused(p: *OwnedSubprocess) Error {
    if (p.pathname == nil) { ret Error{identity: "subprocess"}; }
    ret Error{identity: p.pathname};
}

pub fun init(p: *OwnedSubprocess) {
    @p = OwnedSubprocess{terminal: SubprocessTerminal{kind: STATE_UNSTARTED, code: 0}};
}

# record the bound a child would have run under
pub fun bound(p: *OwnedSubprocess, timeout: chrono_duration.Duration) err[Error] {
    p.timeout = timeout;
    ret err[Error].ok{};
}

# false: no child ran to outlive its bound
pub fun expired(p: *OwnedSubprocess) bool {
    ret false;
}

pub fun dnit(a: *A.Allocator, p: *OwnedSubprocess) {}

# refuse the spawn: the host starts no process
pub fun spawn(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: system_os.Environment,
    options: SpawnOptions) err[Error] {
    p.pathname      = pathname;
    p.terminal.kind = STATE_SPAWN_FAILURE;
    ret err[Error].err{refused(p)};
}

# refuse the spawn: the host starts no process
pub fun spawn_native(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: system_os.NativeEnvironment,
    options: SpawnOptions) err[Error] {
    p.pathname      = pathname;
    p.terminal.kind = STATE_SPAWN_FAILURE;
    ret err[Error].err{refused(p)};
}

# false: no owner here ever holds a child
pub fun running(p: *OwnedSubprocess) bool {
    ret false;
}

pub fun wait(a: *A.Allocator, p: *OwnedSubprocess) res[SubprocessTerminal, Error] {
    ret res[SubprocessTerminal, Error].err{refused(p)};
}

pub fun wait_any(a: *A.Allocator, owners: *OwnedSubprocess, count: u32, interruptible: bool) res[*OwnedSubprocess, Error] {
    ret res[*OwnedSubprocess, Error].err{Error{identity: "subprocess"}};
}

pub fun finish_capture(a: *A.Allocator, p: *OwnedSubprocess, retain: bool) res[CaptureIoResult, Error] {
    ret res[CaptureIoResult, Error].err{refused(p)};
}

pub fun abandon_capture(p: *OwnedSubprocess) {}

# nil and no bytes: no child wrote a capture
pub fun capture_bytes(p: *OwnedSubprocess, len: *usize) *u8 {
    @len = 0;
    ret nil;
}

pub fun capture_dnit(a: *A.Allocator, p: *OwnedSubprocess) err[Error] {
    ret err[Error].ok{};
}

pub fun timeout(a: *A.Allocator, p: *OwnedSubprocess, grace: chrono_duration.Duration) res[SubprocessTerminal, Error] {
    ret res[SubprocessTerminal, Error].err{refused(p)};
}

pub fun cancel(a: *A.Allocator, p: *OwnedSubprocess, grace: chrono_duration.Duration) res[SubprocessTerminal, Error] {
    ret res[SubprocessTerminal, Error].err{refused(p)};
}
