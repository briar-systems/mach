# the layout a build owns beneath a cell's expanded `[project].work`: where its
# objects, IR, assembly, tests, compiler state, step staging and dependency
# artifacts go. the manifest names the work directory; everything under it is
# placed here, and `trees` is what a build of a cell writes there
use std.types.result.res;
use types_path: std.types.path;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use mach.base.diagnostic;
use mach.base.fail;

# each module's objects, one subdirectory per project id
pub val OBJ: str = "obj";
# `-e ir` output
pub val IR: str = "ir";
# `-e ir-opt` output
pub val IR_OPT: str = "ir-opt";
# `-e asm` output
pub val ASM: str = "asm";
# a test run's dispatcher and logs, one subdirectory per tested artifact
pub val TEST: str = "test";
# compiler-only state: nothing but the compiler reads or writes it
pub val CACHE: str = ".cache";
# one fingerprint stamp per build step, under CACHE
pub val STEPS: str = ".cache/steps";
# build step scratch space, one subdirectory per step, reset before the step runs
pub val STAGE: str = ".stage";
# a dependency's artifact outputs, one subdirectory per dependency id
pub val DEPENDENCY: str = "dep";

# every tree beneath the work directory a build writes, STEPS within CACHE
pub val TREE_COUNT: u32    = 8;
pub val TREES:      [8]str = [8]str{OBJ, IR, IR_OPT, ASM, TEST, CACHE, STAGE, DEPENDENCY};

# `rel`, a path relative to the project root, placed beneath `root`. past the root a
# build spells every path it places with `/` on every host, which windows reads as it
# reads its own separator, so `relative` reads a placed path back with no host rule
# ---
# a:   owns the path
# ret: the path; err when it cannot be formatted
pub fun placed(a: *A.Allocator, root: str, rel: str) res[str, fail.Fail] {
    val n: usize = str_len(root);
    if (n == 0 || types_path.is_separator(root[n - 1])) { ret diagnostic.format(a, "{}{}", root, rel); }
    ret diagnostic.format(a, "{}/{}", root, rel);
}

# `path`, which `placed` put beneath `root`, relative to the root, as a view into it
# ---
# ret: the relative path, nil when `path` is not beneath `root` or names the root itself
pub fun relative(root: str, path: str) str {
    if (!str_starts_with(path, root)) { ret nil; }
    val n:     usize = str_len(path);
    var start: usize = str_len(root);
    if (start > 0 && !types_path.is_separator(root[start - 1])) {
        if (n <= start || path[start] != '/') { ret nil; }
        start = start + 1;
    }
    if (n <= start) { ret nil; }
    ret (?path[start])::str;
}

# `tree` beneath the work directory `work`
# ---
# a:   owns the path
# ret: the path; err when it cannot be formatted
pub fun under(a: *A.Allocator, work: str, tree: str) res[str, fail.Fail] {
    ret diagnostic.format(a, "{}/{}", work, tree);
}

# `name` within `tree` beneath `work`: a project's objects, a tested artifact's
# runs, a step's staging or a dependency's artifacts
pub fun within(a: *A.Allocator, work: str, tree: str, name: str) res[str, fail.Fail] {
    ret diagnostic.format(a, "{}/{}/{}", work, tree, name);
}
