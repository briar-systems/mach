# supervised child processes, where the host can start one. both members export one surface over
# the shapes in mach.host.subprocess.shape. where the host has no process to start, every spawn is
# refused, so a command that needs a child ends with a diagnostic that says so

use std.system.capability;

# what std.process.exec needs of a target
$if (capability.HAS_CLOCK && capability.HAS_FILES && capability.HAS_PROCESS && capability.HAS_THREADS) {
    use impl: mach.host.subprocess.native;
}
$or {
    use impl: mach.host.subprocess.absent;
}

use mach.host.subprocess.shape;

fwd shape.STATE_UNSTARTED;
fwd shape.STATE_SPAWN_FAILURE;
fwd shape.STATE_EXITED;
fwd shape.STATE_SIGNALED;
fwd shape.SubprocessTerminal;
fwd shape.CaptureIoResult;
fwd shape.SpawnOptions;
fwd shape.spawn_options;

fwd impl.Error;
fwd impl.refusal;
fwd impl.refusal_of;
fwd impl.resolve;
fwd impl.OwnedSubprocess;
fwd impl.init;
fwd impl.bound;
fwd impl.expired;
fwd impl.dnit;
fwd impl.spawn;
fwd impl.spawn_native;
fwd impl.running;
fwd impl.wait;
fwd impl.wait_any;
fwd impl.finish_capture;
fwd impl.abandon_capture;
fwd impl.capture_bytes;
fwd impl.capture_dnit;
fwd impl.timeout;
fwd impl.cancel;
