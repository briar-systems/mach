# the process's interrupt. while a command holds something it must release before it ends
# (a scratch directory, a child it waits on), the signals or console events that would end
# the process are caught instead of ending it. the first one caught is kept for the rest of
# the process: every wait and every step that can stop asks `taken` and stops, the holder
# releases what it made, and the command ends with `status`. holds nest, and the first hold
# claims the process's one event source (std.process.events), the last returns it
use io_error: std.io.error;
use std.process.events;
use system_os: std.system.os;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# the process's interrupt state
# ---
# holds:  how many holds are open, the event source is claimed while it is above zero
# source: the claimed event source
# taken:  whether an ending event has been caught
# kind:   the first event caught, meaningful once taken is set
rec Held {
    holds:  usize;
    source: events.Source;
    taken:  bool;
    kind:   events.Kind;
}

# one per process, as the event source it wraps is
var global_held: Held;

# catch the ending events from here until the matching `release`
# ---
# ret: the refusal to claim the event source, which leaves nothing held
pub fun hold() err[io_error.Error] {
    if (global_held.holds == 0) {
        val err_made: err[io_error.Error] = events.make(?global_held.source);
        if (sel err_made.err) { ret err_made; }
    }
    global_held.holds = global_held.holds + 1;
    ret err[io_error.Error].ok{};
}

# end one hold; the last restores the default handling, and an event caught before it stays taken
# ---
# ret: the refusal to restore the handlers
pub fun release() err[io_error.Error] {
    if (global_held.holds == 0) { ret err[io_error.Error].ok{}; }
    if (global_held.holds > 1) {
        global_held.holds = global_held.holds - 1;
        ret err[io_error.Error].ok{};
    }
    drain();
    global_held.holds = 0;
    ret events.close(?global_held.source);
}

# keep the first pending event; every kind ends a command, a hangup (RELOAD) as well
fun drain() {
    if (global_held.holds == 0) { ret; }
    for (true) {
        val res_next: res[opt[events.Event], io_error.Error] = events.next(?global_held.source);
        if (!sel res_next.ok)      { ret; }
        if (!sel res_next.ok.some) { ret; }
        if (!global_held.taken) {
            global_held.taken = true;
            global_held.kind  = res_next.ok.some.kind;
        }
    }
}

# the wait queue every caught event wakes while something holds the interrupt, so
# a wait blocked on it ends for an event as well as for what it watches there
# ---
# ret: the queue, borrowed until the last release, or nil when nothing holds it
pub fun queue() *system_os.IoQueue {
    if (global_held.holds == 0) { ret nil; }
    ret events.queue(?global_held.source);
}

# whether an ending event has been caught, now or earlier in the process
pub fun taken() bool {
    drain();
    ret global_held.taken;
}

# the name of the event taken: the signal on linux and darwin, the console or service event
# on windows
pub fun name() str {
    $if ($mach.build.sys == $mach.sys.windows) {
        if (global_held.kind == events.TERMINATE)     { ret "Ctrl+Break"; }
        if (global_held.kind == events.CONSOLE_CLOSE) { ret "console close"; }
        if (global_held.kind == events.SERVICE_STOP)  { ret "service stop"; }
        ret "Ctrl+C";
    }
    $or {
        if (global_held.kind == events.TERMINATE) { ret "SIGTERM"; }
        if (global_held.kind == events.RELOAD)    { ret "SIGHUP"; }
        ret "SIGINT";
    }
}

# the exit status of a process ended by the event taken: 128 plus the signal's number, as a
# shell reports a process the signal ended, and the console's own status on windows
pub fun status() i64 {
    $if ($mach.build.sys == $mach.sys.windows) {
        ret 0xC000013A;
    }
    $or {
        if (global_held.kind == events.TERMINATE) { ret 143; }
        if (global_held.kind == events.RELOAD)    { ret 129; }
        ret 130;
    }
}
