test "mach.subprocess:termination_failure_keeps_live_ownership_and_can_retry" {
    var p: OwnedSubprocess;
    fake_owner(?p, 45);
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: FakeLifecycle = FakeLifecycle{
        soft: 0, hard: 0, polls: 0, sleeps: 0, finish_poll: 0,
        kind: STATE_EXITED, code: 0, fail_soft: true, fail_hard: true,
    };
    val rr: res[SubprocessTerminal, Error] = fake_request(?p, ?alloc, REQUEST_TIMED_OUT, 2, ?f);
    if (sel rr.ok) { ret 1; }
    if (!running(?p) || p.reap_count != 0 || p.requested != REQUEST_TIMED_OUT) { ret 1; }
    val again: res[SubprocessTerminal, Error] = fake_request(?p, ?alloc, REQUEST_CANCELLED, 2, ?f);
    if (sel again.ok) { ret 1; }
    if (f.soft != 2) { ret 1; }
    if (f.hard != 2) { ret 1; }
    f.fail_hard = false;
    val final: res[SubprocessTerminal, Error] = fake_request(?p, ?alloc, REQUEST_CANCELLED, 2, ?f);
    if (sel final.err) { ret 1; }
    if (p.state != STATE_REAPED || p.reap_count != 1 || p.requested != REQUEST_CANCELLED) { ret 1; }
    ret 0;
}

