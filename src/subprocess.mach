    ret 0;
}

test "mach.subprocess:capture_facts_and_borrows_have_one_owner" {
    var a: A.Allocator;
    page.make(?a);
    val allocated: R.Result[*u8, str] = A.allocate[u8](?a, 8);
    if (R.is_err[*u8, str](allocated)) { ret 1; }
    val id_r: R.Result[*u8, str] = dup_cstr(?a, "capture-owner-fixture");
    if (R.is_err[*u8, str](id_r)) { ret 1; }
    var p: OwnedSubprocess;
    init(?p);
    p.has_capture = true;
    p.capture = empty_capture(8);
    p.capture.identity = R.unwrap_ok[*u8, str](id_r);
    p.capture.finished = true;
    p.capture.buffer = R.unwrap_ok[*u8, str](allocated);
    p.capture.capacity = 8;
    p.capture.result.bytes = 8;
    p.capture.result.truncated = true;
    p.capture.result.short_read = true;
    p.capture.result.read_failed = true;
    p.capture.result.write_failed = true;
    p.capture.result.close_failed = true;
    var n: usize = 0;
    if (capture_bytes(?p, ?n) == nil || n != 8) { ret 1; }
    val released: R.Result[R.Void, str] = release_capture(?a, ?p);
    if (R.is_err[R.Void, str](released)) { ret 1; }
    if (capture_bytes(?p, ?n) != nil || n != 0 || p.capture.result.owned) { ret 1; }
    if (!p.capture.released) { ret 1; }
    val double: R.Result[R.Void, str] = release_capture(?a, ?p);
    if (R.is_ok[R.Void, str](double)) { ret 1; }
    ret 0;
}

