    if (sel negative.ok) { ret 1; }
    if (p.requested != REQUEST_ACTIVE) { ret 1; }
    val excessive: duration.Duration = 4294967296::i64 * duration.MILLISECOND;
    val large: res[SubprocessTerminal, Error] = cancel(?alloc, ?p, excessive);
    if (sel large.ok) { ret 1; }
    if (p.requested != REQUEST_ACTIVE) { ret 1; }
    ret 0;
}

test "mach.subprocess:capture_facts_and_borrows_have_one_owner" {
    var a: A.Allocator;
    page.make(?a);
    val allocated: res[*u8, allocator.Error] = A.allocate[u8](?a, 8);
    if (sel allocated.err) { ret 1; }
    val id_r: res[*u8, Error] = dup_cstr(?a, "capture-owner-fixture");
    if (sel id_r.err) { ret 1; }
    var p: OwnedSubprocess;
    init(?p);
    p.has_capture = true;
    p.capture = empty_capture(8);
    p.capture.identity = id_r.ok;
    p.capture.finished = true;
    p.capture.buffer = allocated.ok;
    p.capture.capacity = 8;
    p.capture.result.bytes = 8;
    p.capture.result.truncated = true;
    p.capture.result.short_read = true;
    p.capture.result.read_failed = true;
    p.capture.result.write_failed = true;
    p.capture.result.close_failed = true;
    var n: usize = 0;
    if (capture_bytes(?p, ?n) == nil || n != 8) { ret 1; }
    val released: err[Error] = release_capture(?a, ?p);
    if (sel released.err) { ret 1; }
    if (capture_bytes(?p, ?n) != nil || n != 0 || p.capture.result.owned) { ret 1; }
    if (!p.capture.released) { ret 1; }
    val double: err[Error] = release_capture(?a, ?p);
    if (sel double.ok) { ret 1; }
    ret 0;
}

