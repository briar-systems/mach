use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use io_error: std.io.error;
use io_handle: std.io.handle;
use mach.lang.alloc;

$if ($mach.build.os == $mach.os.linux) {
    use std.system.os.linux;
}
$or ($mach.build.os == $mach.os.darwin) {
    use std.system.os.darwin;
}
$or ($mach.build.os == $mach.os.windows) {
    use std.system.os.windows;
}

pub def SubprocessState: u8;

pub val STATE_UNSTARTED:     SubprocessState = 0;
pub val STATE_SPAWN_FAILURE: SubprocessState = 1;
pub val STATE_RUNNING:       SubprocessState = 2;
pub val STATE_EXITED:        SubprocessState = 3;
pub val STATE_SIGNALED:      SubprocessState = 4;
pub val STATE_REAPED:        SubprocessState = 7;

# the termination a supervisor asked for, mirrored from the cancellation
# scope's reason: the oracle in mach.lang.validation records this kind, so
# the codes are the scope's 1.x reason codes and never change
pub def Request: u8;

pub val REQUEST_ACTIVE:    Request = 0;
pub val REQUEST_CANCELLED: Request = 1;
pub val REQUEST_TIMED_OUT: Request = 2;
pub val REQUEST_DESTROYED: Request = 3;
pub val REQUEST_INVALID:   Request = 4;

pub fun request_of(reason: cnc.Reason) Request {
    if (sel reason.active)    { ret REQUEST_ACTIVE; }
    if (sel reason.cancelled) { ret REQUEST_CANCELLED; }
    if (sel reason.timed_out) { ret REQUEST_TIMED_OUT; }
    if (sel reason.destroyed) { ret REQUEST_DESTROYED; }
    ret REQUEST_INVALID;
}

# a supervised process's refusal, named with the identity the supervisor
# knows it by (its pathname, or "subprocess" before one is recorded): the
# allocator's, the process layer's, a capture file's, or a lifecycle the
# caller drove out of order
pub tag Cause: u8 {
    alloc:      A.Error;
    exec:       exec.Error;
    io:         io_error.Error;
    native:     i64;
    attempted;
    idle;
    not_running;
    invalid_status;
    transition;
    request;
    incomplete;
    capture_released;
    capture_running;
    capture_unfinished;
    capture_release;
    termination;
    reap;
    grace_negative;
    grace_large;
}

pub rec Error {
    identity: str;
    cause:    Cause;
}

pub fun failure(identity: str, cause: Cause) Error {
    ret Error{identity: identity, cause: cause};
}

pub fun cause_text(c: Cause) str {
    if (sel c.alloc)      { ret alloc.text(c.alloc); }
    or (sel c.exec)       { ret exec.error_message(c.exec); }
    or (sel c.io)         { ret io_error.message(c.io); }
    or (sel c.native)     { ret os.message(c.native); }
    or (sel c.attempted)  { ret "subprocess spawn already attempted"; }
    or (sel c.idle)       { ret "no owned subprocess is running"; }
    or (sel c.not_running)    { ret "subprocess is not running"; }
    or (sel c.invalid_status) { ret "invalid subprocess terminal status"; }
    or (sel c.transition) { ret "invalid subprocess terminal transition"; }
    or (sel c.request)    { ret "invalid subprocess termination request"; }
    or (sel c.incomplete) { ret "subprocess lifecycle capability is incomplete"; }
    or (sel c.capture_released)   { ret "subprocess capture already released"; }
    or (sel c.capture_running)    { ret "subprocess capture cannot finish while the child is running"; }
    or (sel c.capture_unfinished) { ret "subprocess capture must finish before it can be released"; }
    or (sel c.capture_release)    { ret "capture deallocation failed"; }
    or (sel c.termination)        { ret "subprocess termination failed"; }
    or (sel c.reap)               { ret "subprocess reap failed"; }
    or (sel c.grace_negative)     { ret "subprocess termination grace cannot be negative"; }
    ret "subprocess termination grace is too large";
}

# "identity: cause", owned by `a` (released with str_free); the static
# fallback when even that cannot be formatted
pub fun text(a: *A.Allocator, e: Error) str {
    val r: res[str, format.FormatError] = format.sprint(a, "{}: {}", e.identity, cause_text(e.cause));
    if (sel r.err) { ret "subprocess operation failed"; }
    ret r.ok;
}

pub rec SubprocessTerminal {
    kind: SubprocessState;
    code: i32;
}

pub rec CaptureIoResult {
    bytes:        usize;
    truncated:    bool;
    short_read:   bool;
    read_failed:  bool;
    write_failed: bool;
    close_failed: bool;
    closed:       bool;
    owned:        bool;
}

pub rec OwnedCapture {
    file:     filesystem.File;
    identity: *u8;
    buffer:   *u8;
    capacity: usize;
    limit:    usize;
    result:   CaptureIoResult;
    finished: bool;
    released: bool;
}

pub rec OwnedSubprocess {
    child:      exec.Child;
    state:      SubprocessState;
    terminal:   SubprocessTerminal;
    requested:  Request;
    capture:    OwnedCapture;
    has_capture: bool;
    spawn_attempted: bool;
    reap_count: u8;
    pathname:   *u8;
    has_deadline: bool;
    deadline:   tm.Time;
    timeout_seconds: i64;
}

fun dup_cstr(a: *A.Allocator, s: *u8) res[*u8, Error] {
    val r: res[str, allocator.Error] = str_dup(a, s::str);
    if (sel r.err) { ret res[*u8, Error].err{failure(s::str, Cause.alloc{r.err})}; }
    ret res[*u8, Error].ok{r.ok::*u8};
}

fun free_cstr(a: *A.Allocator, s: *u8) {
    str_free(a, s::str);
}

fun cstr_count(list: **u8) usize {
    var n: usize = 0;
    for (list[n] != nil) { n = n + 1; }
    ret n;
}

fun free_cstr_list(a: *A.Allocator, list: **u8) {
    if (list == nil) { ret; }
    var n: usize = 0;
    for (list[n] != nil) { free_cstr(a, list[n]); n = n + 1; }
    A.deallocate[*u8](a, list, n + 1);
}

fun dup_cstr_list(a: *A.Allocator, list: **u8) res[**u8, Error] {
    val n: usize = cstr_count(list);
    val ar: res[**u8, allocator.Error] = A.allocate[*u8](a, n + 1);
    if (sel ar.err) { ret res[**u8, Error].err{failure("subprocess", Cause.alloc{ar.err})}; }
    val out: **u8 = ar.ok;
    var i: usize = 0;
    for (i < n) {
        val dr: res[*u8, Error] = dup_cstr(a, list[i]);
        if (sel dr.err) {
            var j: usize = 0;
            for (j < i) { free_cstr(a, out[j]); j = j + 1; }
            A.deallocate[*u8](a, out, n + 1);
            ret res[**u8, Error].err{dr.err};
        }
        out[i] = dr.ok;
        i = i + 1;
    }
    out[n] = nil;
    ret res[**u8, Error].ok{out};
}

rec SpawnCopy {
    pathname: *u8;
    argv:     **u8;
    envp:     **u8;
}

fun spawn_copy_free_request(a: *A.Allocator, c: *SpawnCopy) {
    free_cstr_list(a, c.argv);
    free_cstr_list(a, c.envp);
    c.argv = nil;
    c.envp = nil;
}

fun prepare_spawn_copy(a: *A.Allocator, pathname: str, argv: **u8, envp: **u8) res[SpawnCopy, Error] {
    var c: SpawnCopy = SpawnCopy{pathname: nil, argv: nil, envp: nil};
    val pr: res[*u8, Error] = dup_cstr(a, pathname::*u8);
    if (sel pr.err) { ret res[SpawnCopy, Error].err{pr.err}; }
    c.pathname = pr.ok;
    val ar: res[**u8, Error] = dup_cstr_list(a, argv);
    if (sel ar.err) {
        free_cstr(a, c.pathname);
        ret res[SpawnCopy, Error].err{ar.err};
    }
    c.argv = ar.ok;
    val er: res[**u8, Error] = dup_cstr_list(a, envp);
    if (sel er.err) {
        free_cstr(a, c.pathname);
        free_cstr_list(a, c.argv);
        ret res[SpawnCopy, Error].err{er.err};
    }
    c.envp = er.ok;
    ret res[SpawnCopy, Error].ok{c};
}

fun owner_identity(p: *OwnedSubprocess) str {
    if (p.pathname == nil) { ret "subprocess"; }
    ret p.pathname::str;
}

fun empty_capture(limit: usize) OwnedCapture {
    ret OwnedCapture{
        file: filesystem.File{handle: io_handle.invalid_file()},
        identity: nil,
        buffer: nil,
        capacity: 0,
        limit: limit,
        result: CaptureIoResult{
            bytes: 0,
            truncated: false,
            short_read: false,
            read_failed: false,
            write_failed: false,
            close_failed: false,
            closed: true,
            owned: true,
        },
        finished: false,
        released: false,
    };
}

pub fun init(p: *OwnedSubprocess) {
    p.child.pid   = 0;
    p.state       = STATE_UNSTARTED;
    p.terminal    = SubprocessTerminal{kind: STATE_UNSTARTED, code: 0};
    p.requested   = REQUEST_ACTIVE;
    p.capture     = empty_capture(0);
    p.has_capture = false;
    p.spawn_attempted = false;
    p.reap_count  = 0;
    p.pathname    = nil;
    p.has_deadline = false;
    p.deadline    = tm.Time{sec: 0, nsec: 0};
    p.timeout_seconds = 0;
}

pub fun set_deadline(p: *OwnedSubprocess, deadline: tm.Time) bool {
    if (p.state != STATE_UNSTARTED && p.state != STATE_RUNNING) { ret false; }
    if (deadline.sec < 0 || deadline.nsec < 0 || deadline.nsec >= 1000000000) { ret false; }
    p.has_deadline = true;
    p.deadline     = deadline;
    ret true;
}

pub fun bound_seconds(p: *OwnedSubprocess, seconds: i64) bool {
    if (seconds < 1) { ret false; }
    val now: tm.Clock = tm.monotonic();
    if (sel now.err) { ret false; }
    if (!set_deadline(p, tm.time_add(now.ok, duration.SECOND * seconds))) { ret false; }
    p.timeout_seconds = seconds;
    ret true;
}

pub fun deadline_reached(p: *OwnedSubprocess, now: tm.Time) bool {
    if (!p.has_deadline) { ret false; }
    ret !tm.time_before(now, p.deadline);
}

pub fun expired(p: *OwnedSubprocess) bool {
    ret p.requested == REQUEST_TIMED_OUT;
}

pub fun dnit(a: *A.Allocator, p: *OwnedSubprocess) {
    free_cstr(a, p.pathname);
    p.pathname = nil;
    if (p.capture.identity != nil) {
        close_capture(?p.capture);
        free_cstr(a, p.capture.identity);
        p.capture.identity = nil;
    }
}

fun observe_spawn(p: *OwnedSubprocess, child: exec.Child) {
    p.child      = child;
    p.state      = STATE_RUNNING;
    p.terminal   = SubprocessTerminal{kind: STATE_RUNNING, code: 0};
    p.requested  = REQUEST_ACTIVE;
    p.spawn_attempted = true;
    p.reap_count = 0;
}

fun observe_spawn_failure(p: *OwnedSubprocess) {
    p.state    = STATE_SPAWN_FAILURE;
    p.terminal = SubprocessTerminal{kind: STATE_SPAWN_FAILURE, code: 0};
}

fun begin_spawn(p: *OwnedSubprocess) bool {
    if (p.spawn_attempted || p.state != STATE_UNSTARTED) { ret false; }
    p.spawn_attempted = true;
    ret true;
}

fun observe_terminal(p: *OwnedSubprocess, kind: SubprocessState, code: i32) bool {
    if (p.state != STATE_RUNNING) { ret false; }
    if (kind != STATE_EXITED && kind != STATE_SIGNALED) { ret false; }
    p.state    = kind;
    p.terminal = SubprocessTerminal{kind: kind, code: code};
    ret true;
}

fun close_capture(c: *OwnedCapture) {
    if (c.result.closed) { ret; }
    val close_r: err[io_error.Error] = filesystem.close(?c.file);
    if (sel close_r.err) { c.result.close_failed = true; }
    c.file          = filesystem.File{handle: io_handle.invalid_file()};
    c.result.closed = true;
}

fun mark_reaped(p: *OwnedSubprocess) bool {
    if (p.state != STATE_EXITED && p.state != STATE_SIGNALED) { ret false; }
    if (p.reap_count != 0) { ret false; }
    p.reap_count = 1;
    p.state      = STATE_REAPED;
    ret true;
}

fun observe_status(p: *OwnedSubprocess, st: exec.ExitStatus) bool {
    var kind: SubprocessState = STATE_EXITED;
    var code: i32 = 0;
    if (exec.signaled(st)) {
        kind = STATE_SIGNALED;
        code = exec.signal(st);
    }
    or (exec.exited(st)) {
        code = exec.code(st)::i32;
    }
    or { ret false; }
    ret observe_terminal(p, kind, code) && mark_reaped(p);
}

pub fun spawn(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8) err[Error] {
    if (!begin_spawn(p)) { ret err[Error].err{failure(owner_identity(p), Cause.attempted{})}; }
    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) {
        observe_spawn_failure(p);
        ret err[Error].err{cr.err};
    }
    var c: SpawnCopy = cr.ok;
    val sr: res[exec.Child, exec.Error] = exec.spawn(c.pathname::str, c.argv, c.envp);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        val msg: Error = failure(pathname, Cause.exec{sr.err});
        free_cstr(a, c.pathname);
        observe_spawn_failure(p);
        ret err[Error].err{msg};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    ret err[Error].ok{};
}

pub fun spawn_in(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8,
                 cwd: str) err[Error] {
    if (!begin_spawn(p)) { ret err[Error].err{failure(owner_identity(p), Cause.attempted{})}; }
    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) {
        observe_spawn_failure(p);
        ret err[Error].err{cr.err};
    }
    var c: SpawnCopy = cr.ok;
    val sr: res[exec.Child, exec.Error] = exec.spawn_redirected_in(c.pathname::str, c.argv, c.envp, cwd, -1, -1, -1);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        val msg: Error = failure(pathname, Cause.exec{sr.err});
        free_cstr(a, c.pathname);
        observe_spawn_failure(p);
        ret err[Error].err{msg};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    ret err[Error].ok{};
}

pub fun spawn_captured(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8,
                       identity: str, limit: usize) err[Error] {
    ret spawn_captured_input(a, p, pathname, argv, envp, -1, true, identity, limit);
}

pub fun spawn_captured_input(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8,
                             stdin_fd: i32, capture_stderr: bool, identity: str, limit: usize) err[Error] {
    if (!begin_spawn(p)) { ret err[Error].err{failure(owner_identity(p), Cause.attempted{})}; }
    val idr: res[*u8, Error] = dup_cstr(a, identity::*u8);
    if (sel idr.err) {
        observe_spawn_failure(p);
        ret err[Error].err{idr.err};
    }
    p.capture = empty_capture(limit);
    p.capture.identity = idr.ok;
    p.has_capture = true;

    val raw: i64 = os.open(os.AT_FDCWD, p.capture.identity::str,
        os.O_CREAT | os.O_TRUNC | os.O_RDWR, 420);
    if (raw < 0) {
        p.capture.result.write_failed = true;
        val msg: Error = failure(pathname, Cause.native{raw});
        observe_spawn_failure(p);
        dnit(a, p);
        ret err[Error].err{msg};
    }
    p.capture.file          = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
    p.capture.result.closed = false;

    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) {
        val msg: Error = cr.err;
        observe_spawn_failure(p);
        dnit(a, p);
        ret err[Error].err{msg};
    }
    var c: SpawnCopy = cr.ok;
    var stderr_fd: i32 = -1;
    if (capture_stderr) { stderr_fd = p.capture.file.handle.value::i32; }
    val sr: res[exec.Child, exec.Error] = exec.spawn_redirected_in(
        c.pathname::str, c.argv, c.envp, "", stdin_fd, p.capture.file.handle.value::i32, stderr_fd);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        val msg: Error = failure(pathname, Cause.exec{sr.err});
        free_cstr(a, c.pathname);
        observe_spawn_failure(p);
        dnit(a, p);
        ret err[Error].err{msg};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    ret err[Error].ok{};
}

pub fun spawn_grouped(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8) err[Error] {
    if (!begin_spawn(p)) { ret err[Error].err{failure(owner_identity(p), Cause.attempted{})}; }
    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) {
        observe_spawn_failure(p);
        ret err[Error].err{cr.err};
    }
    var c: SpawnCopy = cr.ok;
    val sr: res[exec.Child, exec.Error] = exec.spawn_grouped(c.pathname::str, c.argv, c.envp);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        val msg: Error = failure(pathname, Cause.exec{sr.err});
        free_cstr(a, c.pathname);
        observe_spawn_failure(p);
        ret err[Error].err{msg};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    ret err[Error].ok{};
}

pub fun spawn_in_grouped(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8,
                         cwd: str) err[Error] {
    if (!begin_spawn(p)) { ret err[Error].err{failure(owner_identity(p), Cause.attempted{})}; }
    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) {
        observe_spawn_failure(p);
        ret err[Error].err{cr.err};
    }
    var c: SpawnCopy = cr.ok;
    val sr: res[exec.Child, exec.Error] = exec.spawn_redirected_in_grouped(
        c.pathname::str, c.argv, c.envp, cwd, -1, -1, -1);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        val msg: Error = failure(pathname, Cause.exec{sr.err});
        free_cstr(a, c.pathname);
        observe_spawn_failure(p);
        ret err[Error].err{msg};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    ret err[Error].ok{};
}

pub fun spawn_captured_grouped(a: *A.Allocator, p: *OwnedSubprocess, pathname: str, argv: **u8, envp: **u8,
                               identity: str, limit: usize) err[Error] {
    if (!begin_spawn(p)) { ret err[Error].err{failure(owner_identity(p), Cause.attempted{})}; }
    val idr: res[*u8, Error] = dup_cstr(a, identity::*u8);
    if (sel idr.err) {
        observe_spawn_failure(p);
        ret err[Error].err{idr.err};
    }
    p.capture = empty_capture(limit);
    p.capture.identity = idr.ok;
    p.has_capture = true;

    val raw: i64 = os.open(os.AT_FDCWD, p.capture.identity::str,
        os.O_CREAT | os.O_TRUNC | os.O_RDWR, 420);
    if (raw < 0) {
        p.capture.result.write_failed = true;
        val msg: Error = failure(pathname, Cause.native{raw});
        observe_spawn_failure(p);
        dnit(a, p);
        ret err[Error].err{msg};
    }
    p.capture.file          = filesystem.File{handle: io_handle.FileHandle{value: raw::usize}};
    p.capture.result.closed = false;

    val cr: res[SpawnCopy, Error] = prepare_spawn_copy(a, pathname, argv, envp);
    if (sel cr.err) {
        val msg: Error = cr.err;
        observe_spawn_failure(p);
        dnit(a, p);
        ret err[Error].err{msg};
    }
    var c: SpawnCopy = cr.ok;
    val sr: res[exec.Child, exec.Error] = exec.spawn_redirected_grouped(
        c.pathname::str, c.argv, c.envp, p.capture.file.handle.value::i32, p.capture.file.handle.value::i32);
    spawn_copy_free_request(a, ?c);
    if (sel sr.err) {
        val msg: Error = failure(pathname, Cause.exec{sr.err});
        free_cstr(a, c.pathname);
        observe_spawn_failure(p);
        dnit(a, p);
        ret err[Error].err{msg};
    }
    p.pathname = c.pathname;
    observe_spawn(p, sr.ok);
    ret err[Error].ok{};
}

pub fun running(p: *OwnedSubprocess) bool {
    ret p.state == STATE_RUNNING;
}

pub fun pid(p: *OwnedSubprocess) i64 {
    if (!running(p)) { ret 0; }
    ret p.child.pid;
}

pub fun wait(a: *A.Allocator, p: *OwnedSubprocess) res[SubprocessTerminal, Error] {
    if (!running(p)) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.not_running{})};
    }
    val wr: res[exec.ExitStatus, exec.Error] = exec.wait(p.child);
    if (sel wr.err) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.exec{wr.err})};
    }
    if (!observe_status(p, wr.ok)) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.invalid_status{})};
    }
    ret res[SubprocessTerminal, Error].ok{p.terminal};
}

fun capture_over_limit(p: *OwnedSubprocess) bool {
    if (!p.has_capture) { ret false; }
    val mr: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(p.capture.file);
    if (sel mr.err) { ret false; }
    ret mr.ok.size > p.capture.limit;
}

pub fun wait_any(a: *A.Allocator, owners: *OwnedSubprocess, count: u32, scope: *cnc.Scope, source: *events.Source) res[*OwnedSubprocess, Error] {
    for (true) {
        val clock: tm.Clock = tm.monotonic();
        if (sel clock.err) { ret res[*OwnedSubprocess, Error].err{failure("subprocess", Cause.io{clock.err})}; }
        val now: tm.Time = clock.ok;
        var fired: Request = REQUEST_ACTIVE;
        if (scope != nil) {
            if (source != nil) {
                val next: res[opt[events.Event], io_error.Error] = events.next(source);
                if (sel next.ok) {
                    if (sel next.ok.some) {
                        val event: events.Event = next.ok.some;
                        if (event.kind == events.TERMINATE || event.kind == events.INTERRUPT
                            || event.kind == events.CONSOLE_CLOSE || event.kind == events.SERVICE_STOP) {
                            cnc.cancel(scope);
                        }
                    }
                }
            }
            cnc.expire(scope, now);
            fired = request_of(cnc.reason(scope));
        }

        var live: bool = false;
        var i: u32 = 0;
        for (i < count) {
            val p: *OwnedSubprocess = ?owners[i];
            if (running(p)) {
                live = true;
                if (fired == REQUEST_TIMED_OUT || fired == REQUEST_CANCELLED) {
                    var tr: res[SubprocessTerminal, Error];
                    if (fired == REQUEST_TIMED_OUT) { tr = timeout(a, p, 0); }
                    or { tr = cancel(a, p, 0); }
                    if (sel tr.err) {
                        ret res[*OwnedSubprocess, Error].err{tr.err};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
                if (deadline_reached(p, now)) {
                    val dr: res[SubprocessTerminal, Error] = timeout(a, p, 0);
                    if (sel dr.err) {
                        ret res[*OwnedSubprocess, Error].err{dr.err};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
                if (capture_over_limit(p)) {
                    val cr: res[SubprocessTerminal, Error] = cancel(a, p, 0);
                    if (sel cr.err) {
                        ret res[*OwnedSubprocess, Error].err{cr.err};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
                val wr: res[opt[exec.ExitStatus], exec.Error] = exec.try_wait(p.child);
                if (sel wr.err) {
                    ret res[*OwnedSubprocess, Error].err{failure(owner_identity(p), Cause.exec{wr.err})};
                }
                val got: opt[exec.ExitStatus] = wr.ok;
                if (sel got.some) {
                    if (!observe_status(p, got.some)) {
                        ret res[*OwnedSubprocess, Error].err{failure(owner_identity(p), Cause.invalid_status{})};
                    }
                    ret res[*OwnedSubprocess, Error].ok{p};
                }
            }
            i = i + 1;
        }
        if (!live) { ret res[*OwnedSubprocess, Error].err{failure("subprocess", Cause.idle{})}; }
        os.sleep(duration.MILLISECOND);
    }
}

fun finalize_capture_file(a: *A.Allocator, c: *OwnedCapture, keep: bool) {
    val mr: res[filesystem.Metadata, io_error.Error] = filesystem.stat_of(c.file);
    if (sel mr.err) {
        c.result.read_failed = true;
        ret;
    }
    val source: usize = mr.ok.size;
    var stored: usize = source;
    if (stored > c.limit) {
        stored = c.limit;
        c.result.truncated = true;
    }
    if (stored == 0) { ret; }

    val sk: res[i64, io_error.Error] = filesystem.seek(c.file, 0, filesystem.SEEK_SET);
    if (sel sk.err) {
        c.result.read_failed = true;
        ret;
    }

    val br: res[*u8, allocator.Error] = A.allocate[u8](a, stored);
    if (sel br.err) {
        c.result.read_failed = true;
        ret;
    }
    val buf: *u8 = br.ok;

    var got: usize = 0;
    for (got < stored) {
        val rr: res[usize, io_error.Error] = filesystem.read(c.file, (buf::usize + got)::*u8, stored - got);
        if (sel rr.err) {
            c.result.read_failed = true;
            brk;
        }
        val n: usize = rr.ok;
        if (n == 0) { brk; }
        got = got + n;
    }
    c.result.bytes = got;
    if (got < stored && !c.result.read_failed) { c.result.short_read = true; }

    if (keep && !c.result.read_failed) {
        c.buffer   = buf;
        c.capacity = stored;
    }
    or {
        A.deallocate[u8](a, buf, stored);
    }
}

pub fun finish_capture(a: *A.Allocator, p: *OwnedSubprocess, retain: bool) res[CaptureIoResult, Error] {
    if (!p.has_capture) { ret res[CaptureIoResult, Error].ok{p.capture.result}; }
    if (p.capture.released) {
        ret res[CaptureIoResult, Error].err{failure(owner_identity(p), Cause.capture_released{})};
    }
    if (p.state == STATE_RUNNING) {
        ret res[CaptureIoResult, Error].err{failure(owner_identity(p), Cause.capture_running{})};
    }
    if (!p.capture.finished) {
        finalize_capture_file(a, ?p.capture, retain);
        p.capture.finished = true;
    }
    close_capture(?p.capture);
    ret res[CaptureIoResult, Error].ok{p.capture.result};
}

pub fun abandon_capture(p: *OwnedSubprocess) {
    if (!p.has_capture) { ret; }
    close_capture(?p.capture);
    p.capture.finished = true;
    p.capture.result.read_failed = true;
}

pub fun capture_bytes(p: *OwnedSubprocess, len: *usize) *u8 {
    @len = 0;
    if (!p.has_capture || !p.capture.result.owned || !p.capture.finished) { ret nil; }
    @len = p.capture.result.bytes;
    ret p.capture.buffer;
}

pub fun release_capture(a: *A.Allocator, p: *OwnedSubprocess) err[Error] {
    if (!p.has_capture) { ret err[Error].ok{}; }
    if (p.capture.released) {
        ret err[Error].err{failure(owner_identity(p), Cause.capture_released{})};
    }
    if (!p.capture.finished) {
        ret err[Error].err{failure(owner_identity(p), Cause.capture_unfinished{})};
    }
    close_capture(?p.capture);
    if (p.capture.result.owned && p.capture.buffer != nil) {
        val released: err[allocator.Error] = A.deallocate[u8](a, p.capture.buffer, p.capture.capacity);
        if (sel released.err) {
            ret err[Error].err{failure(owner_identity(p), Cause.capture_release{})};
        }
    }
    free_cstr(a, p.capture.identity);
    p.capture.identity     = nil;
    p.capture.result.owned = false;
    p.capture.buffer       = nil;
    p.capture.capacity     = 0;
    p.capture.result.bytes = 0;
    p.capture.released     = true;
    ret err[Error].ok{};
}

fun pid_string(buf: *u8, child_pid: i64) *u8 {
    var value: i64 = child_pid;
    var digits: usize = 1;
    var scale: i64 = 10;
    for (value >= scale && digits < 19) {
        digits = digits + 1;
        scale = scale * 10;
    }
    var i: usize = digits;
    buf[i] = 0;
    for (i > 0) {
        i = i - 1;
        buf[i] = ('0'::i64 + value % 10)::u8;
        value = value / 10;
    }
    ret buf;
}

fun actual_terminate(a: *A.Allocator, child: exec.Child, hard: bool) bool {
    if (hard) {
        val terminated: err[exec.Error] = exec.terminate_child(exec.Child{pid: child.pid});
        ret sel terminated.ok;
    }
    if (child.pgid != 0) {
        val grouped: err[exec.Error] = exec.terminate_group(child);
        ret sel grouped.ok;
    }
    var pid_buf: [24]u8;
    val pid_arg: *u8 = pid_string(?pid_buf[0], child.pid);
    var argv: [5]*u8;
    var pathname: *u8;
    $if ($mach.build.os == $mach.os.windows) {
        pathname = "taskkill.exe";
        argv[0] = pathname;
        argv[1] = "/PID";
        argv[2] = pid_arg;
        argv[3] = nil;
    }
    $or {
        pathname = "/bin/kill";
        argv[0] = pathname;
        argv[1] = "-TERM";
        argv[2] = pid_arg;
        argv[3] = nil;
    }

    var helper: OwnedSubprocess;
    init(?helper);
    val sr: err[Error] = spawn(a, ?helper, pathname, ?argv[0], env.environ());
    if (sel sr.err) { dnit(a, ?helper); ret false; }
    val wr: res[SubprocessTerminal, Error] = wait(a, ?helper);
    dnit(a, ?helper);
    if (sel wr.err) { ret false; }
    val terminal: SubprocessTerminal = wr.ok;
    ret terminal.kind == STATE_EXITED && terminal.code == 0;
}

fun actual_wait(a: *A.Allocator, child_pid: i64, block: bool,
                kind: *SubprocessState, code: *i32) i8 {
    val child: exec.Child = exec.Child{pid: child_pid, pgid: 0};
    var st: exec.ExitStatus;
    if (block) {
        val br: res[exec.ExitStatus, exec.Error] = exec.wait(child);
        if (sel br.err) { ret -1; }
        st = br.ok;
    }
    or {
        val pr: res[opt[exec.ExitStatus], exec.Error] = exec.try_wait(child);
        if (sel pr.err) { ret -1; }
        val got: opt[exec.ExitStatus] = pr.ok;
        if (sel got.none) { ret 0; }
        st = got.some;
    }
    if (exec.signaled(st)) {
        @kind = STATE_SIGNALED;
        @code = exec.signal(st);
    }
    or (exec.exited(st)) {
        @kind = STATE_EXITED;
        @code = exec.code(st)::i32;
    }
    or { ret -1; }
    ret 1;
}

fun actual_sleep(a: *A.Allocator) {
    os.sleep(duration.MILLISECOND);
}

fun request_with[T](p: *OwnedSubprocess, a: *A.Allocator, request: Request, attempts: u32,
                    ctx: *T, terminate: fun(*T, exec.Child, bool) bool,
                    wait_child: fun(*T, i64, bool, *SubprocessState, *i32) i8,
                    sleep: fun(*T)) res[SubprocessTerminal, Error] {
    if (ctx == nil || terminate == nil || wait_child == nil || sleep == nil) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.incomplete{})};
    }
    if (!running(p)) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.not_running{})};
    }
    if (request != REQUEST_TIMED_OUT && request != REQUEST_CANCELLED) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.request{})};
    }
    p.requested = request;

    val soft_sent: bool = terminate(ctx, p.child, false);
    var i: u32 = 0;
    for (soft_sent && i < attempts) {
        var kind: SubprocessState = STATE_EXITED;
        var code: i32 = 0;
        val wr: i8 = wait_child(ctx, p.child.pid, false, ?kind, ?code);
        if (wr > 0) {
            if (!observe_terminal(p, kind, code) || !mark_reaped(p)) {
                ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.transition{})};
            }
            ret res[SubprocessTerminal, Error].ok{p.terminal};
        }
        if (wr < 0) { brk; }
        sleep(ctx);
        i = i + 1;
    }

    if (!terminate(ctx, p.child, true)) {
        var pkind: SubprocessState = STATE_EXITED;
        var pcode: i32 = 0;
        val polled: i8 = wait_child(ctx, p.child.pid, false, ?pkind, ?pcode);
        if (polled <= 0) {
            ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.termination{})};
        }
        if (!observe_terminal(p, pkind, pcode) || !mark_reaped(p)) {
            ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.transition{})};
        }
        ret res[SubprocessTerminal, Error].ok{p.terminal};
    }

    var kind: SubprocessState = STATE_EXITED;
    var code: i32 = 0;
    if (wait_child(ctx, p.child.pid, true, ?kind, ?code) <= 0) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.reap{})};
    }
    if (!observe_terminal(p, kind, code) || !mark_reaped(p)) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.transition{})};
    }
    ret res[SubprocessTerminal, Error].ok{p.terminal};
}

fun request(p: *OwnedSubprocess, a: *A.Allocator, state: Request,
            grace: duration.Duration) res[SubprocessTerminal, Error] {
    if (grace < 0) {
        ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.grace_negative{})};
    }
    var attempts: u32 = 0;
    if (grace > 0) {
        var millis: i64 = grace / duration.MILLISECOND;
        if (grace % duration.MILLISECOND != 0) { millis = millis + 1; }
        if (millis > 4294967295) {
            ret res[SubprocessTerminal, Error].err{failure(owner_identity(p), Cause.grace_large{})};
        }
        attempts = millis::u32;
    }
    ret request_with[A.Allocator](p, a, state, attempts, a, actual_terminate, actual_wait,
                                  actual_sleep);
}

pub fun timeout(a: *A.Allocator, p: *OwnedSubprocess, grace: duration.Duration) res[SubprocessTerminal, Error] {
    ret request(p, a, REQUEST_TIMED_OUT, grace);
}

pub fun cancel(a: *A.Allocator, p: *OwnedSubprocess, grace: duration.Duration) res[SubprocessTerminal, Error] {
    ret request(p, a, REQUEST_CANCELLED, grace);
}

rec FakeLifecycle {
    soft:        u32;
    hard:        u32;
    group_soft:  u32;
    polls:       u32;
    sleeps:      u32;
    finish_poll: u32;
    kind:        SubprocessState;
    code:        i32;
    fail_soft:   bool;
    fail_hard:   bool;
    fail_group_soft: bool;
}

fun fake_terminate(f: *FakeLifecycle, child: exec.Child, hard: bool) bool {
    if (hard) {
        f.hard = f.hard + 1;
        ret !f.fail_hard;
    }
    if (child.pgid != 0) {
        f.group_soft = f.group_soft + 1;
        ret !f.fail_group_soft;
    }
    f.soft = f.soft + 1;
    ret !f.fail_soft;
}

fun fake_wait(f: *FakeLifecycle, child_pid: i64, block: bool,
              kind: *SubprocessState, code: *i32) i8 {
    f.polls = f.polls + 1;
    if (!block && (f.finish_poll == 0 || f.polls < f.finish_poll)) { ret 0; }
    @kind = f.kind;
    @code = f.code;
    ret 1;
}

fun fake_sleep(f: *FakeLifecycle) {
    f.sleeps = f.sleeps + 1;
}

fun fake_owner(p: *OwnedSubprocess, child_pid: i64) {
    init(p);
    p.spawn_attempted = true;
    observe_spawn(p, exec.Child{pid: child_pid});
}

fun fake_owner_grouped(p: *OwnedSubprocess, child_pid: i64) {
    init(p);
    p.spawn_attempted = true;
    observe_spawn(p, exec.Child{pid: child_pid, pgid: child_pid});
}

fun fake_request(p: *OwnedSubprocess, a: *A.Allocator, request: Request, attempts: u32,
                 f: *FakeLifecycle) res[SubprocessTerminal, Error] {
    ret request_with[FakeLifecycle](p, a, request, attempts, f, fake_terminate, fake_wait,
                                    fake_sleep);
}

rec CaptureProbe {
    backing: A.Allocator;
    live:    i64;
    calls:   u32;
    fail_at: u32;
}

fun capture_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *CaptureProbe = ctx::*CaptureProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) { p.live = p.live + size::i64; }
    ret r;
}

fun capture_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *CaptureProbe = ctx::*CaptureProbe;
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) { p.live = p.live - old_size::i64 + new_size::i64; }
    ret r;
}

fun capture_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *CaptureProbe = ctx::*CaptureProbe;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun capture_probe_make(p: *CaptureProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[allocator.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live    = 0;
    p.calls   = 0;
    p.fail_at = fail_at;
    val probe: *CaptureProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = capture_probe_allocate;
    alloc.fn_reallocate = capture_probe_reallocate;
    alloc.fn_deallocate = capture_probe_deallocate;
    ret true;
}

test "mach.subprocess:spawn_captured_open_failure_leaks_nothing" {
    var identity: *u8;
    $if ($mach.build.os == $mach.os.windows) { identity = "Z:\\mach-no-parent\\capture-probe-open"; }
    $or { identity = "/mach-no-parent/capture-probe-open"; }
    var argv: [2]*u8;
    argv[0] = identity;
    argv[1] = nil;
    var probe: CaptureProbe;
    var alloc: A.Allocator;
    if (!capture_probe_make(?probe, ?alloc, 0)) { ret 1; }
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, identity, ?argv[0], env.environ(), identity, 8);
    if (sel sr.ok) { ret 1; }
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.subprocess:spawn_captured_prepare_failure_leaks_nothing" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var plain: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?plain);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?plain, "mach_subprocess_probe_prepare");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val identity: str = filesystem.temp_path(?tf);
    filesystem.temp_close_and_remove(?tf);

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "printf hi";
    argv[3] = nil;

    var probe: CaptureProbe;
    var alloc: A.Allocator;
    if (!capture_probe_make(?probe, ?alloc, 2)) { ret 1; }
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), identity, 64);
    var bad: bool = false;
    if (sel sr.ok) { bad = true; }
    if (probe.live != 0) { bad = true; }
    filesystem.remove_file(identity);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:double_dnit_after_spawn_failure_is_idempotent" {
    var identity: *u8;
    $if ($mach.build.os == $mach.os.windows) { identity = "Z:\\mach-no-parent\\capture-double-dnit"; }
    $or { identity = "/mach-no-parent/capture-double-dnit"; }
    var argv: [2]*u8;
    argv[0] = identity;
    argv[1] = nil;
    var probe: CaptureProbe;
    var alloc: A.Allocator;
    if (!capture_probe_make(?probe, ?alloc, 0)) { ret 1; }
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, identity, ?argv[0], env.environ(), identity, 8);
    if (sel sr.ok) { ret 1; }
    if (probe.live != 0) { ret 1; }
    dnit(?alloc, ?p);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.subprocess:dnit_after_release_frees_nothing_twice" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var plain: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?plain);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?plain, "mach_subprocess_dnit_release");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val identity: str = filesystem.temp_path(?tf);
    filesystem.temp_close_and_remove(?tf);

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "printf hi";
    argv[3] = nil;

    var probe: CaptureProbe;
    var alloc: A.Allocator;
    if (!capture_probe_make(?probe, ?alloc, 0)) { ret 1; }
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), identity, 64);
    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        val wr: res[SubprocessTerminal, Error] = wait(?alloc, ?p);
        if (sel wr.err) { bad = true; }
        if (sel wr.ok) {
            val cr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, true);
            if (sel cr.err) { bad = true; }
            if (sel cr.ok) {
                val rel: err[Error] = release_capture(?alloc, ?p);
                if (sel rel.err) { bad = true; }
                if (sel rel.ok) {
                    dnit(?alloc, ?p);
                    if (probe.live != 0) { bad = true; }
                    dnit(?alloc, ?p);
                    if (probe.live != 0) { bad = true; }
                }
            }
        }
    }
    filesystem.remove_file(identity);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:legal_exit_and_reap_is_exactly_once" {
    var p: OwnedSubprocess;
    fake_owner(?p, 41);
    if (!observe_terminal(?p, STATE_EXITED, 7)) { ret 1; }
    if (!mark_reaped(?p)) { ret 1; }
    if (p.state != STATE_REAPED || p.terminal.kind != STATE_EXITED || p.terminal.code != 7) { ret 1; }
    if (p.reap_count != 1 || mark_reaped(?p) || observe_terminal(?p, STATE_SIGNALED, 9)) { ret 1; }
    ret 0;
}

test "mach.subprocess:illegal_terminal_transitions_are_rejected" {
    var p: OwnedSubprocess;
    init(?p);
    if (observe_terminal(?p, STATE_EXITED, 0)) { ret 1; }
    fake_owner(?p, 42);
    if (observe_terminal(?p, STATE_UNSTARTED, 0)) { ret 1; }
    if (mark_reaped(?p)) { ret 1; }
    ret 0;
}

test "mach.subprocess:unstarted_is_distinct_from_spawn_failure" {
    var p: OwnedSubprocess;
    init(?p);
    if (p.state != STATE_UNSTARTED || p.terminal.kind != STATE_UNSTARTED) { ret 1; }
    if (running(?p) || p.spawn_attempted) { ret 1; }

    var identity: *u8;
    $if ($mach.build.os == $mach.os.windows) { identity = "Z:\\mach-no-parent\\capture-unstarted"; }
    $or { identity = "/mach-no-parent/capture-unstarted"; }
    var argv: [2]*u8;
    argv[0] = identity;
    argv[1] = nil;
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: err[Error] = spawn_captured(?alloc, ?p, identity, ?argv[0], env.environ(), identity, 8);
    if (sel sr.ok) { ret 1; }
    if (p.state != STATE_SPAWN_FAILURE || p.terminal.kind != STATE_SPAWN_FAILURE) { ret 1; }
    if (!str_equals(sr.err.identity, identity::str)) { ret 1; }
    val retry: err[Error] = spawn_captured(?alloc, ?p, identity, ?argv[0], env.environ(), identity, 8);
    if (sel retry.ok) { ret 1; }
    ret 0;
}

test "mach.subprocess:cancel_reaps_a_real_running_child" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "sleep 30";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn(?alloc, ?p, "/bin/sh", ?argv[0], env.environ());
    if (sel sr.err) { ret 1; }
    if (!running(?p)) { ret 1; }
    val cr: res[SubprocessTerminal, Error] = cancel(?alloc, ?p, duration.MILLISECOND * 50);
    if (sel cr.err) { ret 1; }
    val terminal: SubprocessTerminal = cr.ok;
    if (terminal.kind != STATE_SIGNALED && terminal.kind != STATE_EXITED) { ret 1; }
    if (p.state != STATE_REAPED || p.reap_count != 1 || p.requested != REQUEST_CANCELLED) { ret 1; }
    dnit(?alloc, ?p);
    ret 0;
}

test "mach.subprocess:wait_any_reaps_the_child_that_exits" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var fast_argv: [4]*u8;
    fast_argv[0] = "/bin/sh";
    fast_argv[1] = "-c";
    fast_argv[2] = "exit 3";
    fast_argv[3] = nil;
    var slow_argv: [4]*u8;
    slow_argv[0] = "/bin/sh";
    slow_argv[1] = "-c";
    slow_argv[2] = "sleep 30";
    slow_argv[3] = nil;

    var owners: [2]OwnedSubprocess;
    init(?owners[0]);
    init(?owners[1]);
    val fast_r: err[Error] = spawn(?alloc, ?owners[0], "/bin/sh", ?fast_argv[0], env.environ());
    if (sel fast_r.err) { ret 1; }
    val slow_r: err[Error] = spawn(?alloc, ?owners[1], "/bin/sh", ?slow_argv[0], env.environ());
    if (sel slow_r.err) { dnit(?alloc, ?owners[0]); ret 1; }

    val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?owners[0], 2, nil, nil);
    var bad: bool = false;
    if (sel wr.err) { bad = true; }
    if (sel wr.ok) {
        val reaped: *OwnedSubprocess = wr.ok;
        if (reaped != ?owners[0] || reaped.terminal.kind != STATE_EXITED || reaped.terminal.code != 3) { bad = true; }
        if (running(?owners[1])) {
            val cr: res[SubprocessTerminal, Error] = cancel(?alloc, ?owners[1], 0);
            if (sel cr.err) { bad = true; }
        }
        or { bad = true; }
    }
    dnit(?alloc, ?owners[0]);
    dnit(?alloc, ?owners[1]);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:capture_reads_back_through_the_same_descriptor" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?alloc, "mach_subprocess_capture_readback");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val identity: str = filesystem.temp_path(?tf);
    filesystem.temp_close_and_remove(?tf);

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "printf hello";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), identity, 64);
    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        val wr: res[SubprocessTerminal, Error] = wait(?alloc, ?p);
        if (sel wr.err) { bad = true; }
        if (sel wr.ok) {
            val cr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, true);
            if (sel cr.err) { bad = true; }
            if (sel cr.ok) {
                val capture: CaptureIoResult = cr.ok;
                if (capture.bytes != 5 || capture.truncated || capture.read_failed) { bad = true; }
                var n: usize = 0;
                val bytes: *u8 = capture_bytes(?p, ?n);
                if (bytes == nil || n != 5 || bytes[0] != 'h' || bytes[4] != 'o') { bad = true; }
                val rel: err[Error] = release_capture(?alloc, ?p);
                if (sel rel.err) { bad = true; }
            }
        }
    }
    filesystem.remove_file(identity);
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:spawn_does_not_borrow_caller_pathname_or_argv" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var pathname_buf: [10]u8;
    val original: str = "/bin/true";
    var i: usize = 0;
    for (i < 9) { pathname_buf[i] = original[i]; i = i + 1; }
    pathname_buf[9] = 0;

    var argv: [2]*u8;
    argv[0] = ?pathname_buf[0];
    argv[1] = nil;

    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn(?alloc, ?p, (?pathname_buf[0])::str, ?argv[0], env.environ());
    if (sel sr.err) { ret 1; }

    var j: usize = 0;
    for (j < 9) { pathname_buf[j] = 'X'::u8; j = j + 1; }

    val first: res[SubprocessTerminal, Error] = wait(?alloc, ?p);
    var bad: bool = false;
    if (sel first.err) { bad = true; }

    val second: res[SubprocessTerminal, Error] = wait(?alloc, ?p);
    if (sel second.ok) { bad = true; }
    if (sel second.err) {
        val msg: str = text(?alloc, second.err);
        if (!str_contains(msg, "/bin/true")) { bad = true; }
        if (str_contains(msg, "XXXXXXXXX")) { bad = true; }
        str_free(?alloc, msg);
    }
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:spawn_captured_does_not_borrow_caller_identity" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?alloc, "mach_subprocess_identity_borrow");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val real_path: *u8 = filesystem.temp_path(?tf)::*u8;
    filesystem.temp_close_and_remove(?tf);

    var identity_buf: [256]u8;
    var cleanup_buf: [256]u8;
    var n: usize = 0;
    for (n < 255 && real_path[n] != 0) {
        identity_buf[n] = real_path[n];
        cleanup_buf[n]  = real_path[n];
        n = n + 1;
    }
    identity_buf[n] = 0;
    cleanup_buf[n]  = 0;

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "printf hi";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), (?identity_buf[0])::str, 64);
    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        var k: usize = 0;
        for (k < n) { identity_buf[k] = 'Z'::u8; k = k + 1; }

        val wr: res[SubprocessTerminal, Error] = wait(?alloc, ?p);
        if (sel wr.err) { bad = true; }
        if (sel wr.ok) {
            val cr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, true);
            if (sel cr.err) { bad = true; }
            if (sel cr.ok) {
                val capture: CaptureIoResult = cr.ok;
                if (capture.bytes != 2 || capture.read_failed) { bad = true; }
                val rel: err[Error] = release_capture(?alloc, ?p);
                if (sel rel.err) { bad = true; }
            }
        }
    }
    filesystem.remove_file((?cleanup_buf[0])::str);
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

