test "mach.subprocess:wait_any_bounds_a_runaway_capture" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?alloc, "mach_subprocess_capture_limit");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val identity: str = filesystem.temp_path(?tf);
    filesystem.temp_close_and_remove(?tf);

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "while true; do echo 0123456789; done";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), identity, 64);
    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?p, 1, nil, nil);
        if (sel wr.err) { bad = true; }
        if (sel wr.ok) {
            if (p.state != STATE_REAPED || p.requested != REQUEST_CANCELLED) { bad = true; }

            val disk_r: res[filesystem.Metadata, io_error.Error] = filesystem.metadata(identity);
            if (sel disk_r.err) { bad = true; }
            if (sel disk_r.ok) {
                val disk_size: usize = disk_r.ok.size;
                if (disk_size < 64 || disk_size >= 1048576) { bad = true; }
            }

            val cr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, true);
            if (sel cr.err) { bad = true; }
            if (sel cr.ok) {
                val capture: CaptureIoResult = cr.ok;
                if (!capture.truncated || capture.bytes != 64 || capture.read_failed) { bad = true; }
                var n: usize = 0;
                val bytes: *u8 = capture_bytes(?p, ?n);
                if (bytes == nil || n != 64) { bad = true; }
                val rel: err[Error] = release_capture(?alloc, ?p);
                if (sel rel.err) { bad = true; }
            }
        }
    }
    filesystem.remove_file(identity);
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

