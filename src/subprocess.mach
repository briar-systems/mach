    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        if (p.child.pgid == 0) { bad = true; }
        os.sleep(duration.MILLISECOND * 100);
        val cr: res[SubprocessTerminal, Error] = cancel(?alloc, ?p, duration.MILLISECOND * 50);
        if (sel cr.err) { bad = true; }
        if (sel cr.ok) {
            val fr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, true);
            if (sel fr.err) { bad = true; }
            if (sel fr.ok) {
                var n: usize = 0;
                val bytes: *u8 = capture_bytes(?p, ?n);
                var grandchild: i64 = 0;
                var i: usize = 0;
                for (i < n && bytes[i] >= '0'::u8 && bytes[i] <= '9'::u8) {
                    grandchild = grandchild * 10 + (bytes[i] - '0'::u8)::i64;
                    i = i + 1;
                }
                if (grandchild <= 0) { bad = true; }
                or {
                    var tries: usize = 0;
                    var gone: bool = false;
                    for (tries < 50 && !gone) {
                        $if ($mach.build.os == $mach.os.linux) {
                            if (linux.getpgid(grandchild) < 0) { gone = true; }
                        }
                        $or ($mach.build.os == $mach.os.darwin) {
                            if (darwin.getpgid(grandchild) < 0) { gone = true; }
                        }
                        if (!gone) { os.sleep(duration.MILLISECOND * 20); }
                        tries = tries + 1;
                    }
                    if (!gone) { bad = true; }
                }
                val rel: err[Error] = release_capture(?alloc, ?p);
                if (sel rel.err) { bad = true; }
            }
        }
    }
    filesystem.remove_file(identity);
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:grouped_termination_failure_keeps_live_ownership_and_can_retry" {
    var p: OwnedSubprocess;
    fake_owner_grouped(?p, 50);
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var f: FakeLifecycle = FakeLifecycle{
        soft: 0, hard: 0, group_soft: 0, polls: 0, sleeps: 0, finish_poll: 0,
        kind: STATE_EXITED, code: 0, fail_soft: false, fail_hard: true, fail_group_soft: true,
    };
    val rr: res[SubprocessTerminal, Error] = fake_request(?p, ?alloc, REQUEST_TIMED_OUT, 2, ?f);
    if (sel rr.ok) { ret 1; }
    if (!running(?p) || p.reap_count != 0 || p.requested != REQUEST_TIMED_OUT) { ret 1; }
    if (f.group_soft != 1 || f.soft != 0 || f.hard != 1) { ret 1; }
    f.fail_group_soft = false;
    f.fail_hard = false;
    val retry: res[SubprocessTerminal, Error] = fake_request(?p, ?alloc, REQUEST_CANCELLED, 2, ?f);
    if (sel retry.err) { ret 1; }
    if (p.state != STATE_REAPED || p.reap_count != 1 || p.requested != REQUEST_CANCELLED) { ret 1; }
    if (f.group_soft != 2) { ret 1; }
    ret 0;
}

test "mach.subprocess:wait_any_scoped_deadline_cancels_a_running_child" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?alloc, "mach_subprocess_deadline");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val identity: str = filesystem.temp_path(?tf);
    filesystem.temp_close_and_remove(?tf);

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "sleep 30";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), identity, 64);
    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        var scope: cnc.Scope;
        val clock: tm.Clock = tm.monotonic();
        if (sel clock.err) { ret 1; }
        val deadline: tm.Time = tm.time_add(clock.ok, duration.MILLISECOND * 60);
        cnc.make_root(?scope, true, deadline);
        val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?p, 1, ?scope, nil);
        if (sel wr.err) { bad = true; }
        if (sel wr.ok) {
            if (p.state != STATE_REAPED || p.requested != REQUEST_TIMED_OUT) { bad = true; }
            val reason: cnc.Reason = cnc.reason(?scope);
            if (!sel reason.timed_out) { bad = true; }
        }
        cnc.destroy(?scope);
        val fr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, false);
        if (sel fr.err) { bad = true; }
    }
    filesystem.remove_file(identity);
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:wait_any_scoped_cancellation_races_a_fast_exit" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "exit 7";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn(?alloc, ?p, "/bin/sh", ?argv[0], env.environ());
    var bad: bool = false;
    if (sel sr.err) { bad = true; }
    if (sel sr.ok) {
        var scope: cnc.Scope;
        cnc.make_root(?scope, false, tm.Time{sec: 0, nsec: 0});
        cnc.cancel(?scope);
        os.sleep(duration.MILLISECOND * 30);
        val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?p, 1, ?scope, nil);
        if (sel wr.err) { bad = true; }
        if (sel wr.ok) {
            if (p.state != STATE_REAPED || p.reap_count != 1) { bad = true; }
            if (p.requested != REQUEST_CANCELLED) { bad = true; }
            if (p.terminal.kind != STATE_EXITED && p.terminal.kind != STATE_SIGNALED) { bad = true; }
        }
        cnc.destroy(?scope);
    }
    dnit(?alloc, ?p);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.subprocess:an_owner_deadline_terminates_the_group_and_reaps_the_grandchild" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tf_r: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(?alloc, "mach_subprocess_owner_deadline");
    if (sel tf_r.err) { ret 1; }
    var tf: filesystem.TempFile = tf_r.ok;
    val identity: str = filesystem.temp_path(?tf);
    filesystem.temp_close_and_remove(?tf);

    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "sleep 30 & echo $!; wait";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_captured_grouped(?alloc, ?p, "/bin/sh", ?argv[0], env.environ(), identity, 32);
    var bad: i32 = 0;
    if (sel sr.err) { bad = 1; }
    if (sel sr.ok) {
        if (p.child.pgid == 0) { bad = 2; }
        os.sleep(duration.MILLISECOND * 100);
        if (!bound_seconds(?p, 1)) { bad = 3; }
        if (p.timeout_seconds != 1) { bad = 4; }
        val start_clock: tm.Clock = tm.monotonic();
        if (sel start_clock.err) { ret 1; }
        val started: tm.Time = start_clock.ok;
        val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?p, 1, nil, nil);
        if (sel wr.err) { bad = 5; }
        if (sel wr.ok) {
            if (!expired(?p)) { bad = 6; }
            if (p.state != STATE_REAPED) { bad = 7; }
            val end_clock: tm.Clock = tm.monotonic();
            if (sel end_clock.err) { ret 1; }
            val waited: duration.Duration = tm.time_sub(end_clock.ok, started);
            if (waited > duration.SECOND * 20) { bad = 8; }
            val fr: res[CaptureIoResult, Error] = finish_capture(?alloc, ?p, true);
            if (sel fr.err) { bad = 9; }
            if (sel fr.ok) {
                var n: usize = 0;
                val bytes: *u8 = capture_bytes(?p, ?n);
                var grandchild: i64 = 0;
                var i: usize = 0;
                for (i < n && bytes[i] >= '0'::u8 && bytes[i] <= '9'::u8) {
                    grandchild = grandchild * 10 + (bytes[i] - '0'::u8)::i64;
                    i = i + 1;
                }
                if (grandchild <= 0) { bad = 10; }
                or {
                    var tries: usize = 0;
                    var gone: bool = false;
                    for (tries < 50 && !gone) {
                        $if ($mach.build.os == $mach.os.linux) {
                            if (linux.getpgid(grandchild) < 0) { gone = true; }
                        }
                        $or ($mach.build.os == $mach.os.darwin) {
                            if (darwin.getpgid(grandchild) < 0) { gone = true; }
                        }
                        if (!gone) { os.sleep(duration.MILLISECOND * 20); }
                        tries = tries + 1;
                    }
                    if (!gone) { bad = 11; }
                }
                val rel: err[Error] = release_capture(?alloc, ?p);
                if (sel rel.err) { bad = 12; }
            }
        }
    }
    filesystem.remove_file(identity);
    dnit(?alloc, ?p);
    ret bad;
}

test "mach.subprocess:an_unbounded_owner_runs_to_its_own_exit" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "sleep 1; exit 5";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_grouped(?alloc, ?p, "/bin/sh", ?argv[0], env.environ());
    var bad: i32 = 0;
    if (sel sr.err) { bad = 1; }
    if (sel sr.ok) {
        if (p.has_deadline) { bad = 2; }
        val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?p, 1, nil, nil);
        if (sel wr.err) { bad = 3; }
        if (sel wr.ok) {
            if (expired(?p)) { bad = 4; }
            if (p.terminal.kind != STATE_EXITED || p.terminal.code != 5) { bad = 5; }
        }
    }
    dnit(?alloc, ?p);
    ret bad;
}

test "mach.subprocess:a_child_that_beats_its_deadline_is_not_reported_timed_out" {
    $if ($mach.build.os == $mach.os.windows) { ret 0; }
    var alloc: A.Allocator;
    val make_r: err[allocator.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var argv: [4]*u8;
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "exit 3";
    argv[3] = nil;
    var p: OwnedSubprocess;
    init(?p);
    val sr: err[Error] = spawn_grouped(?alloc, ?p, "/bin/sh", ?argv[0], env.environ());
    var bad: i32 = 0;
    if (sel sr.err) { bad = 1; }
    if (sel sr.ok) {
        if (!bound_seconds(?p, 30)) { bad = 2; }
        val wr: res[*OwnedSubprocess, Error] = wait_any(?alloc, ?p, 1, nil, nil);
        if (sel wr.err) { bad = 3; }
        if (sel wr.ok) {
            if (expired(?p)) { bad = 4; }
            if (p.terminal.kind != STATE_EXITED || p.terminal.code != 3) { bad = 5; }
        }
    }
    dnit(?alloc, ?p);
    ret bad;
}

test "mach.subprocess.bound_seconds:rejects_a_nonpositive_bound_and_a_finished_owner" {
    var p: OwnedSubprocess;
    init(?p);
    if (bound_seconds(?p, 0))  { ret 1; }
    if (bound_seconds(?p, -1)) { ret 2; }
    if (p.has_deadline || p.timeout_seconds != 0) { ret 3; }
    if (!bound_seconds(?p, 4)) { ret 4; }
    if (!p.has_deadline || p.timeout_seconds != 4) { ret 5; }
    if (deadline_reached(?p, tm.Time{sec: 0, nsec: 0})) { ret 6; }

    var q: OwnedSubprocess;
    fake_owner(?q, 90);
    if (!bound_seconds(?q, 2)) { ret 7; }
    q.state = STATE_REAPED;
    if (bound_seconds(?q, 2)) { ret 8; }
    ret 0;
}
