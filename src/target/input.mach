# link inputs: how a link token names a file or a library
#
# a token names a file by its path, located here, or a library by name, which
# mink's search finds when the link runs: the search its host row states for the
# target's system, environment and architecture. mach looks for no library of
# its own
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_to_lower;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy;
use std.types.string.str_ends_with;
use std.types.string.str_is_empty;
use std.types.string.str_len;

use A:        std.allocator;
use fs:       std.filesystem;
use io_error: std.io.error;

use mink_os:      mink.catalog.os;
use mink_os_list: mink.catalog.os.list;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;

# how an input is named: a file at a path, or a library or a framework by
# name that mink's search finds
pub def Form: u8;

pub val FILE:      Form = 0;
pub val LIBRARY:   Form = 1;
pub val FRAMEWORK: Form = 2;

# what a library named by name must be, judged by mink's search from what the
# file holds. nothing else is taken in its place, so a wrong kind or a miss is
# a refusal
pub def Kind: u8;

pub val SHARED: Kind = 0;
pub val STATIC: Kind = 1;
# an import module the image's host supplies by its name, as a wasm module
# imports a function from, which no file holds
pub val MODULE: Kind = 2;

# a link input: a file at the path `text`, located, or a library or framework
# of the name `text`. `include_referenced` whether the image loads it only
# when a live import references it, and `kind` what a library by name must be,
# SHARED for any other input
pub rec Input {
    form:               Form;
    text:               str;
    include_referenced: bool;
    kind:               Kind;
}

val PATH_CAP: usize = 4096;

# whether `tok` ends as pattern `p` names a file
fun pattern_names(p: *mink_os.Pattern, tok: str) bool {
    ret !str_is_empty(p.suffix) && str_ends_with(tok, p.suffix) && str_len(tok) > str_len(p.suffix);
}

# whether `tok` ends as a pattern of the order `o` names a file
fun order_names(o: *mink_os.Order, tok: str) bool {
    var i: usize = 0;
    for (i < o.count) {
        val step: *mink_os.Step = ?o.steps[i];
        if (sel step.files) {
            var k: usize = 0;
            for (k < step.files.count) {
                val p: *mink_os.Pattern = step.files.rows[k];
                if (pattern_names(p, tok)) { ret true; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret false;
}

# whether a token names a file by path rather than a library by name: it holds a
# separator, or it ends the way a file any system of mink's catalog searches for
# is named
pub fun token_is_path(tok: *u8) bool {
    if (tok == nil || str_is_empty(tok::str)) { ret false; }
    if (types_path.has_separator(tok::str))   { ret true; }
    var s: usize = 0;
    for (s < mink_os_list.count()) {
        val sys: *mink_os.System = mink_os_list.at(s);
        var h:   usize           = 0;
        for (h < sys.host_count) {
            val opt_naming: opt[*mink_os.Naming] = sys.hosts[h].naming;
            if (sel opt_naming.some) {
                if (order_names(?opt_naming.some.static_first, tok::str) || order_names(?opt_naming.some.shared_first, tok::str)) { ret true; }
            }
            h = h + 1;
        }
        s = s + 1;
    }
    ret false;
}

# whether `tok` ends in `stem`, compared without case, with a name before it
fun stem_names(stem: str, tok: str) bool {
    val n: usize = str_len(tok);
    val s: usize = str_len(stem);
    if (n <= s) { ret false; }
    var i: usize = 0;
    for (i < s) {
        if (char_to_lower(tok[n - s + i]::char) != char_to_lower(stem[i]::char)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a library's name names a file, which states its own kind: a path, or
# a name ending in the suffix a system's naming states for the file its loader
# loads, as `kernel32.dll` does
pub fun names_file(tok: *u8) bool {
    if (token_is_path(tok)) { ret true; }
    var s: usize = 0;
    for (s < mink_os_list.count()) {
        val sys: *mink_os.System = mink_os_list.at(s);
        var h:   usize           = 0;
        for (h < sys.host_count) {
            val opt_naming: opt[*mink_os.Naming] = sys.hosts[h].naming;
            if (sel opt_naming.some) {
                if (opt_naming.some.stem != nil && stem_names(opt_naming.some.stem, tok::str)) { ret true; }
            }
            h = h + 1;
        }
        s = s + 1;
    }
    ret false;
}

# the input a link token names: a path, located as written, or a library by
# name, left to mink's search. a manifest's local path is anchored where its
# entry is read, so a relative path is one the command line gave, read against
# the working directory
pub fun token_input(a: *A.Allocator, tok: *u8) res[Input, fail.Fail] {
    if (!token_is_path(tok)) { ret res[Input, fail.Fail].ok{named(LIBRARY, tok::str)}; }
    var buf:         [PATH_CAP]u8;
    var parts:       [1]str               = [1]str{tok::str};
    val res_located: res[bool, fail.Fail] = candidate_present(a, tok, ?buf[0], nil, ?parts[0], 1);
    if (sel res_located.err) { ret res[Input, fail.Fail].err{res_located.err}; }
    if (!res_located.ok) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
    }
    val res_copied: res[str, types_string.StrError] = str_copy(a, ?buf[0]);
    if (sel res_copied.err) { ret res[Input, fail.Fail].err{fail.str_refused(res_copied.err)}; }
    ret res[Input, fail.Fail].ok{named(FILE, res_copied.ok)};
}

# a framework by name, left to mink's search
pub fun framework_input(name: *u8) Input {
    ret named(FRAMEWORK, name::str);
}

fun named(form: Form, text: str) Input {
    ret Input{form: form, text: text, include_referenced: false, kind: SHARED};
}

# `dir`, a separator, then the `count` parts at `parts` written to `buf` with its
# terminator, false when they do not fit in `cap` bytes
fun path_write(buf: *u8, cap: usize, dir: *u8, parts: *str, count: u32) bool {
    var k: usize = 0;
    var i: usize = 0;
    if (dir != nil) {
        val dl: usize = str_len(dir::str);
        if (dl + 2 > cap) { ret false; }
        for (i < dl) {
            buf[k] = dir[i];
            k      = k + 1;
            i      = i + 1;
        }
        if (k > 0 && buf[k - 1] != '/') {
            buf[k] = '/';
            k      = k + 1;
        }
    }
    var p: u32 = 0;
    for (p < count) {
        val part: str   = parts[p];
        val pl:   usize = str_len(part);
        if (k + pl + 1 > cap) { ret false; }
        i = 0;
        for (i < pl) {
            buf[k] = part[i];
            k      = k + 1;
            i      = i + 1;
        }
        p = p + 1;
    }
    buf[k] = 0;
    ret true;
}

# whether `dir` and the concatenated `parts`, written to `buf`, name a file; a
# path longer than a link input's path can be is refused, naming the input `tok`
fun candidate_present(a: *A.Allocator, tok: *u8, buf: *u8, dir: *u8, parts: *str, count: u32) res[bool, fail.Fail] {
    if (!path_write(buf, PATH_CAP, dir, parts, count)) {
        ret res[bool, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND,
            "a path searched for link input '{}' is longer than {} bytes", tok::str, PATH_CAP)};
    }
    ret file_present(a, buf);
}

# whether `p` names a regular file; a query the system refuses, other than for
# a path that does not exist, is a failure
fun file_present(a: *A.Allocator, p: *u8) res[bool, fail.Fail] {
    val res_is_file: res[bool, io_error.Error] = fs.is_file(p);
    if (sel res_is_file.err) {
        ret res[bool, fail.Fail].err{fail.refusal(a, diagnostic_kind.LINK_INPUT_UNREADABLE, fail.Op{verb: "inspect", role: "the link input", path: p::str, given: true}, fail.Cause.io{res_is_file.err})};
    }
    ret res[bool, fail.Fail].ok{res_is_file.ok};
}
