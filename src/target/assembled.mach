# the target mirl assembles from a resolved target
#
# mirl assembles a target from the target mink resolved, masc's check of its baseline and
# the output kind under build, reading no text, and opens the build the target's added
# extensions select over it. the tuple of the target's parts names the modules built for it
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.bitset;
use std.collections.slice.Slice;
use std.collections.vector;
use std.memory;

use masc_extension: masc.core.extension;
use masc.core.requirement;
use masc_isa:    masc.isa;
use mink_fail:   mink.base.fail;
use mink_target: mink.catalog.target;
use mirl.ir.module.Tuple;
use mirl_assemble: mirl.target.assemble;
use mirl_basis:    mirl.target.basis;
use mirl_record:   mirl.target.record;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.target.resolved;

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# the tuple a resolved target names its owners' parts by
pub fun tuple_of(t: *resolved.Target) Tuple {
    var env: str = mirl_record.NONE;
    if (sel t.target.env.some) { env = t.target.env.some.name; }
    ret Tuple{arch: view_of(t.target.arch.name), sys: view_of(t.target.sys.name), env: view_of(env), abi: view_of(resolved.abi_name(t)), isa: view_of(resolved.isa(t))};
}

# the target mirl assembles from the target mink resolved for `t`, masc's check of its
# baseline and the code model the target picks, for the output kind under build. refused when it
# assembles none: a baseline that does not hold what the convention requires, a code model mirl declines, or a combination mirl
# does not carry. given back by mirl_assemble.dnit
fun made(a: *A.Allocator, t: *resolved.Target) res[mirl_record.Target, fail.Fail] {
    # the baseline alone: the extensions the target adds are opened over it (`added`)
    val res_checked: res[opt[masc_isa.Checked], mink_fail.Fail] = masc_isa.check(a, ?t.target);
    if (sel res_checked.err) { ret res[mirl_record.Target, fail.Fail].err{resolved.refused(a, diagnostic_kind.TARGET_UNSUPPORTED, res_checked.err)}; }
    val res_made: res[mirl_record.Target, mirl_assemble.Error] = mirl_assemble.assemble_resolved(a, t.target, res_checked.ok, t.code_model, t.output);
    if (sel res_made.ok) { ret res[mirl_record.Target, fail.Fail].ok{res_made.ok}; }
    val arch: str = t.target.arch.name;
    val sys:  str = t.target.sys.name;
    if (sel res_made.err.requires) {
        var unmet: mirl_assemble.Requires = res_made.err.requires;
        fin { mirl_assemble.unmet_dnit(a, ?unmet); }
        val res_change: res[str, fail.Fail] = baseline_change(a, ?unmet);
        if (sel res_change.err) { ret res[mirl_record.Target, fail.Fail].err{res_change.err}; }
        ret res[mirl_record.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED,
            "isa `{}` does not hold what calling convention `{}` requires on {}. {}",
            resolved.isa(t), resolved.abi_name(t), arch, res_change.ok)};
    }
    if (sel res_made.err.code) {
        val named: str = code_named(t);
        ret res[mirl_record.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "code model `{}` is not available for arch {} on {}", named, arch, sys)};
    }
    if (sel res_made.err.declined) {
        val named: str = code_named(t);
        ret res[mirl_record.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "code model `{}` cannot be used for arch {} on {} ({})", named, arch, sys, res_made.err.declined)};
    }
    if (sel res_made.err.alloc) { ret res[mirl_record.Target, fail.Fail].err{fail.refused(res_made.err.alloc)}; }
    ret res[mirl_record.Target, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "no target can be assembled for arch {}, sys {}, abi {}, isa {} ({})",
        arch, sys, resolved.abi_name(t), resolved.isa(t), mirl_assemble.rule(res_made.err))};
}

# the name of the code model the target is built under: the one it picks, else its host's
# default, which mink resolved
fun code_named(t: *resolved.Target) str {
    if (sel t.code_model.some)        { ret t.code_model.some.name; }
    if (sel t.target.code_model.some) { ret t.target.code_model.some.name; }
    ret "the default";
}

# the cheapest change to a baseline that admits a convention's requirement, as the atoms to
# add and the atoms to drop, each spelled as a manifest's `isa` spells it
fun baseline_change(a: *A.Allocator, u: *mirl_assemble.Requires) res[str, fail.Fail] {
    val opt_nearest: opt[usize] = mirl_assemble.nearest(u);
    if (sel opt_nearest.none) { ret res[str, fail.Fail].ok{"state an isa that holds it"}; }
    val m:   *mirl_assemble.Lacking = ?u.alternatives.data[opt_nearest.some];
    var out: vector.Vector[u8]      = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    val err_written: err[A.Error] = change_put(a, ?out, u, m);
    if (sel err_written.err) { ret res[str, fail.Fail].err{fail.refused(err_written.err)}; }
    val res_copied: res[*u8, A.Error] = A.allocate[u8](a, out.len + 1);
    if (sel res_copied.err) { ret res[str, fail.Fail].err{fail.refused(res_copied.err)}; }
    memory.raw_copy(res_copied.ok::ptr, out.data::ptr, out.len);
    res_copied.ok[out.len] = 0;
    ret res[str, fail.Fail].ok{res_copied.ok::str};
}

# the atoms `m` lacks and bars, worded onto `out`
fun change_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_assemble.Requires, m: *mirl_assemble.Lacking) err[A.Error] {
    if (m.lacks.len > 0) {
        val err_lead: err[A.Error] = text_put(out, "add ");
        if (sel err_lead.err) { ret err_lead; }
        val err_lacks: err[A.Error] = atoms_put(a, out, u, m.lacks);
        if (sel err_lacks.err) { ret err_lacks; }
    }
    if (m.bars.len > 0) {
        var word: str = "drop ";
        if (m.lacks.len > 0) { word = " and drop "; }
        val err_lead: err[A.Error] = text_put(out, word);
        if (sel err_lead.err) { ret err_lead; }
        val err_bars: err[A.Error] = atoms_put(a, out, u, m.bars);
        if (sel err_bars.err) { ret err_bars; }
    }
    ret text_put(out, " to its isa");
}

# the atoms `ids` spelled onto `out`, joined by `+`
fun atoms_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_assemble.Requires, ids: requirement.Ids) err[A.Error] {
    var i: u32 = 0;
    for (i < ids.len) {
        if (i > 0) {
            val err_joined: err[A.Error] = text_put(out, "+");
            if (sel err_joined.err) { ret err_joined; }
        }
        val err_put: err[A.Error] = atom_put(a, out, u, ids.at[i]);
        if (sel err_put.err) { ret err_put; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# atom `id` spelled onto `out`: masc's spelling of a selection of the one extension in the
# architecture's syntax, without its `+`, else the catalog's name for it
fun atom_put(a: *A.Allocator, out: *vector.Vector[u8], u: *mirl_assemble.Requires, id: requirement.Id) err[A.Error] {
    if (sel u.set.some) {
        val c: *masc_extension.Catalog = u.set.some.extensions;
        if (id < c.count) {
            val res_made: res[bitset.Bitset, A.Error] = bitset.init(a, c.count::usize);
            if (sel res_made.err) { ret err[A.Error].err{res_made.err}; }
            var one: masc_extension.Selection = masc_extension.Selection{catalog: c, members: res_made.ok, stated: masc_extension.Stated{at: [masc_extension.MAX_STATED]requirement.Id{0, 0, 0, 0, 0, 0, 0, 0}, len: 0}};
            fin { val err_dropped: err[A.Error] = bitset.dnit(?one.members); }
            bitset.set(?one.members, id::usize);
            var spelled: vector.Vector[u8] = vector.init[u8](a);
            fin { vector.dnit[u8](?spelled); }
            val err_wrote: err[A.Error] = masc_extension.spell(?one, ?spelled);
            if (sel err_wrote.err) { ret err_wrote; }
            var from: usize = 0;
            if (spelled.len > 0 && spelled.data[0] == '+') { from = 1; }
            for (from < spelled.len) {
                val res_pushed: res[usize, A.Error] = vector.push[u8](out, spelled.data[from]);
                if (sel res_pushed.err) { ret err[A.Error].err{res_pushed.err}; }
                from = from + 1;
            }
            ret err[A.Error].ok{};
        }
    }
    val opt_named: opt[str] = mirl_assemble.unmet_name(u, id);
    if (sel opt_named.some) { ret text_put(out, opt_named.some); }
    ret text_put(out, "an atom of the architecture's state");
}

fun text_put(out: *vector.Vector[u8], text: str) err[A.Error] {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        val res_pushed: res[usize, A.Error] = vector.push[u8](out, text[i]);
        if (sel res_pushed.err) { ret err[A.Error].err{res_pushed.err}; }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the target mirl assembled for a resolved target and the build basis its added
# extensions opened, which lowering lays types out under and compilation adds the
# added names to
# ---
# tuple: the five parts the target was assembled from, which name its modules
# names: the names of masc's catalog the target adds over its baseline
pub rec Assembled {
    tuple:  Tuple;
    target: mirl_record.Target;
    basis:  mirl_basis.Basis;
    based:  bool;
    names:  [resolved.MAX_ADDED]str;
    count:  usize;
}

# the target mirl assembles for `t`, with the build its added extensions select
# opened. given back by release
pub fun assemble(a: *A.Allocator, t: *resolved.Target) res[*Assembled, fail.Fail] {
    if (!resolved.is_selected(t)) { ret res[*Assembled, fail.Fail].err{fail.message("target: no target is selected, so mirl assembles none")}; }
    val tuple:     Tuple                              = tuple_of(t);
    val res_built: res[mirl_record.Target, fail.Fail] = made(a, t);
    if (sel res_built.err) { ret res[*Assembled, fail.Fail].err{res_built.err}; }
    val res_boxed: res[*Assembled, A.Error] = A.allocate[Assembled](a, 1);
    if (sel res_boxed.err) {
        var target: mirl_record.Target = res_built.ok;
        mirl_assemble.dnit(a, ?target);
        ret res[*Assembled, fail.Fail].err{fail.refused(res_boxed.err)};
    }
    val x: *Assembled = res_boxed.ok;
    x.tuple  = tuple;
    x.target = res_built.ok;
    x.based  = false;
    x.count  = t.added_count::usize;
    var i: usize = 0;
    for (i < x.count) {
        x.names[i] = t.added[i];
        i          = i + 1;
    }
    if (sel x.target.isa.required) {
        val err_chosen: err[mirl_basis.Error] = mirl_basis.choose(?x.basis, a, ?x.target, added(x));
        if (sel err_chosen.err) {
            mirl_assemble.dnit(a, ?x.target);
            A.deallocate[Assembled](a, x, 1);
            if (sel err_chosen.err.alloc) { ret res[*Assembled, fail.Fail].err{fail.refused(err_chosen.err.alloc)}; }
            ret res[*Assembled, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.TARGET_UNSUPPORTED, "no build of {} {} over isa `{}` with the target's extensions can be opened ({})",
                t.target.arch.name, t.target.sys.name, resolved.isa(t), mirl_basis.fact(err_chosen.err))};
        }
        x.based = true;
    }
    ret res[*Assembled, fail.Fail].ok{x};
}

# the names the target adds over its baseline
pub fun added(x: *Assembled) Slice[str] {
    ret Slice[str]{data: ?x.names[0], size: x.count};
}

# the build basis the added extensions opened, none for a target that states no baseline
pub fun basis_of(x: *Assembled) opt[*mirl_basis.Basis] {
    if (x.based) { ret opt[*mirl_basis.Basis].some{?x.basis}; }
    ret mirl_basis.NONE;
}

pub fun dnit(a: *A.Allocator, x: *Assembled) {
    if (x.based) { mirl_basis.dnit(?x.basis); }
    mirl_assemble.dnit(a, ?x.target);
    A.deallocate[Assembled](a, x, 1);
}
