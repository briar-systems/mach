# tags: the git half of the source contract that lists releases. a release is a
# `v`-prefixed semver tag at a url, listed with one `ls-remote` each. the first manifest read
# at a url brings every listed release's manifest into a scratch bare repository at once:
# one shallow fetch of the listed tags without file contents, then one fetch of each
# release's mach.toml by its object id. offline, both come from a local repository, a
# realized checkout of the url, and nothing reaches the network
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.text.string.str_dup;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source:      mach.base.source;
use compile_closure:  mach.compile.closure;
use manifest_version: mach.manifest.version;
use mach.report.readout;
use mach.session;

use mach.base.diagnostic;
use manifest_load:  mach.manifest.load;
use manifest_model: mach.manifest.model;
use mach.package.git;
use mach.package.report;
use mach.package.scratch;
use package_source: mach.package.source;

# a url's tag listing, read once per command
rec CachedListing {
    url:  str;
    text: str;
}

# offline, each url's releases come from its own local repository
rec LocalRepo {
    url: str;
    dir: str;
}

# `fetched` holds each url whose listed releases' manifests the scratch holds. `rep` hears a
# line before each url's releases are read from the network, nil for none
pub rec Remotes {
    s:             *session.Session;
    gi:            git.Inspector;
    listings:      Vector[CachedListing];
    locals:        Vector[LocalRepo];
    fetched:       Vector[str];
    offline:       bool;
    local:         str;
    scratch:       str;
    scratch_ready: bool;
    rep:           *report.Report;
}

# open a releases table over git
# ---
# s:       the session, whose allocator holds the table's state
# offline: read releases only from local repositories, reaching no network
# local:   the repository a url with no remembered checkout is read from offline, or ""
# rep:     hears a line before a url's releases are read from the network, nil for none
# ret:     the table, released with dnit, err when git is not on PATH
pub fun init(s: *session.Session, offline: bool, local: str, rep: *report.Report) res[Remotes, fail.Fail] {
    val res_inspector_init: res[git.Inspector, fail.Fail] = git.inspector_init(s.build_alloc, s.environ);
    if (sel res_inspector_init.err) { ret res[Remotes, fail.Fail].err{res_inspector_init.err}; }
    ret res[Remotes, fail.Fail].ok{Remotes{s: s, gi: res_inspector_init.ok, listings: collections_vector.init[CachedListing](s.build_alloc),
        locals: collections_vector.init[LocalRepo](s.build_alloc), fetched: collections_vector.init[str](s.build_alloc), offline: offline,
        local:  local, scratch: "", scratch_ready: false, rep: rep}};
}

# release the table; a candidate scratch that stays is the failure, once
# everything else is released
pub fun dnit(c: *Remotes) err[fail.Fail] {
    var err_out: err[fail.Fail] = err[fail.Fail].ok{};
    if (c.scratch_ready) {
        val err_removed: err[fs.FsError] = fs.remove_all(c.s.build_alloc, c.scratch);
        if (sel err_removed.err) { err_out = err[fail.Fail].err{fail.refusal(c.s.build_alloc, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: SCRATCH_ROLE, path: c.scratch}, fail.Cause.fs{err_removed.err})}; }
        str_free(c.s.build_alloc, c.scratch);
        c.scratch_ready = false;
    }
    var i: usize = 0;
    for (i < c.listings.len) {
        str_free(c.s.build_alloc, c.listings.data[i].url);
        str_free(c.s.build_alloc, c.listings.data[i].text);
        i = i + 1;
    }
    collections_vector.dnit[CachedListing](?c.listings);
    i = 0;
    for (i < c.locals.len) {
        str_free(c.s.build_alloc, c.locals.data[i].url);
        str_free(c.s.build_alloc, c.locals.data[i].dir);
        i = i + 1;
    }
    collections_vector.dnit[LocalRepo](?c.locals);
    i = 0;
    for (i < c.fetched.len) {
        str_free(c.s.build_alloc, c.fetched.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](?c.fetched);
    git.inspector_dnit(c.s.build_alloc, ?c.gi);
    ret err_out;
}

# the local repository offline resolution reads `url`'s releases from; the first existing one
# named wins, so a url with no checkout yet is refused by offline_dir and not by git
pub fun remember(c: *Remotes, url: str, dir: str) err[fail.Fail] {
    if (!str_is_empty(local_dir_for(c, url))) { ret err[fail.Fail].ok{}; }
    val res_present: res[bool, io_error.Error] = fs.exists(dir);
    if (!(sel res_present.ok && res_present.ok)) { ret err[fail.Fail].ok{}; }
    val a:                 *A.Allocator      = c.s.build_alloc;
    val res_str_dup_range: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel res_str_dup_range.err) { ret err[fail.Fail].err{fail.refused(res_str_dup_range.err)}; }
    var moved: bool = false;
    fin {
        if (!moved) { str_free(a, res_str_dup_range.ok); }
    }
    val res_str_dup_range_dir: res[str, A.Error] = str_dup_range(a, dir, 0, str_len(dir));
    if (sel res_str_dup_range_dir.err) { ret err[fail.Fail].err{fail.refused(res_str_dup_range_dir.err)}; }
    fin {
        if (!moved) { str_free(a, res_str_dup_range_dir.ok); }
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[LocalRepo](?c.locals, LocalRepo{url: res_str_dup_range.ok, dir: res_str_dup_range_dir.ok});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    moved = true;
    ret err[fail.Fail].ok{};
}

# the local repository remembered for `url`, else the table's fallback, "" when there is none
fun local_dir_for(c: *Remotes, url: str) str {
    var i: usize = 0;
    for (i < c.locals.len) {
        if (str_equals(c.locals.data[i].url, url)) { ret c.locals.data[i].dir; }
        i = i + 1;
    }
    ret c.local;
}

# the local repository offline resolution reads `url` from, refused when there is none
fun offline_dir(c: *Remotes, url: str) res[str, fail.Fail] {
    val dir: str = local_dir_for(c, url);
    if (str_is_empty(dir)) {
        val res_msg: res[str, std_format.FormatError] = std_format.sprint(c.s.build_alloc, "no local checkout of {} holds its releases. run once without --offline", url);
        if (sel res_msg.err) { ret res[str, fail.Fail].err{fail.format_refused(res_msg.err)}; }
        ret res[str, fail.Fail].err{fail.user(diagnostic_kind.DEP_OFFLINE, res_msg.ok)};
    }
    ret res[str, fail.Fail].ok{dir};
}

fun is_hex_id(p: *u8, n: usize) bool {
    if (n != 40 && n != 64) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val b: u8 = p[i];
        if (!((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the index of the release named by the tag of `tag_len` bytes at `tag`, -1 when none is
fun release_index(out: *Vector[package_source.Release], tag: *u8, tag_len: usize) i64 {
    var i: usize = 0;
    for (i < out.len) {
        val t: str = out.data[i].tag;
        if (str_len(t) == tag_len) {
            var k: usize = 0;
            for (k < tag_len && t[k] == tag[k]) { k = k + 1; }
            if (k == tag_len) { ret i::i64; }
        }
        i = i + 1;
    }
    ret -1;
}

# one listing line, `<object id><space or tab>refs/tags/<tag>[^{}]`; a peeled line gives the
# commit an annotated tag points at and replaces the tag object's id
fun take_release_line(a: *A.Allocator, line: *u8, n: usize, out: *Vector[package_source.Release]) err[fail.Fail] {
    var sp: usize = 0;
    for (sp < n && line[sp] != ' ' && line[sp] != '\t') { sp = sp + 1; }
    if (sp == n || !is_hex_id(line, sp)) { ret err[fail.Fail].ok{}; }
    var ref_at: usize = sp;
    for (ref_at < n && (line[ref_at] == ' ' || line[ref_at] == '\t')) { ref_at = ref_at + 1; }
    val prefix: str   = "refs/tags/";
    var k:      usize = 0;
    for (k < 10) {
        if (ref_at + k >= n || line[ref_at + k] != prefix[k]) { ret err[fail.Fail].ok{}; }
        k = k + 1;
    }
    val tag_at:  usize = ref_at + 10;
    var tag_len: usize = n - tag_at;
    var peeled:  bool  = false;
    if (tag_len > 3 && line[n - 3] == '^' && line[n - 2] == '{' && line[n - 1] == '}') {
        tag_len = tag_len - 3;
        peeled  = true;
    }
    if (tag_len < 6 || line[tag_at] != 'v') { ret err[fail.Fail].ok{}; }
    val res_commit: res[str, A.Error] = str_dup_range(a, line::str, 0, sp);
    if (sel res_commit.err) { ret err[fail.Fail].err{fail.refused(res_commit.err)}; }
    var moved: bool = false;
    fin {
        if (!moved) { str_free(a, res_commit.ok); }
    }
    val seen: i64 = release_index(out, ?line[tag_at], tag_len);
    if (seen >= 0) {
        if (peeled) {
            str_free(a, out.data[seen::usize].commit);
            out.data[seen::usize].commit = res_commit.ok;
            moved                        = true;
        }
        ret err[fail.Fail].ok{};
    }
    val res_tag: res[str, A.Error] = str_dup_range(a, line::str, tag_at, tag_len);
    if (sel res_tag.err) { ret err[fail.Fail].err{fail.refused(res_tag.err)}; }
    fin {
        if (!moved) { str_free(a, res_tag.ok); }
    }
    val res_text: res[str, A.Error] = str_dup_range(a, line::str, tag_at + 1, tag_len - 1);
    if (sel res_text.err) { ret err[fail.Fail].err{fail.refused(res_text.err)}; }
    fin {
        if (!moved) { str_free(a, res_text.ok); }
    }
    val res_parsed: res[manifest_version.Version, str] = manifest_version.parse_version(res_text.ok);
    if (sel res_parsed.err) { ret err[fail.Fail].ok{}; }
    if (sel res_parsed.ok) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[package_source.Release](out,
            package_source.Release{version: res_parsed.ok, text: res_text.ok, tag: res_tag.ok, commit: res_commit.ok});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        moved = true;
    }
    ret err[fail.Fail].ok{};
}

# every `v`-prefixed semver tag at a url as a release, listed once per url and cached
# ---
# ctx: the table, a *Remotes
# url: the source url
# out: receives the releases, their strings owned by the session's allocator
# ret: err when the tags cannot be listed or a release cannot be kept
pub fun releases(ctx: ptr, url: str, out: *Vector[package_source.Release]) err[fail.Fail] {
    val c:          *Remotes            = ctx::*Remotes;
    val a:          *A.Allocator        = c.s.build_alloc;
    val res_listed: res[str, fail.Fail] = cached_listing(c, url);
    if (sel res_listed.err) { ret err[fail.Fail].err{res_listed.err}; }
    val text: str   = res_listed.ok;
    val n:    usize = str_len(text);
    var at:   usize = 0;
    for (at < n) {
        var end: usize = at;
        for (end < n && text[end] != '\n') { end = end + 1; }
        val err_taken: err[fail.Fail] = take_release_line(a, ?text[at], end - at, out);
        if (sel err_taken.err) { ret err_taken; }
        at = end + 1;
    }
    ret err[fail.Fail].ok{};
}

# the release of `url` whose commit is `commit`, as its version text owned by the
# caller, or an owned "" when no release tag names that commit: a dependency's committed
# gitlink is a commit, and resolution deals in releases
pub fun release_of(c: *Remotes, url: str, commit: str) res[str, fail.Fail] {
    val a:    *A.Allocator                   = c.s.build_alloc;
    var rels: Vector[package_source.Release] = collections_vector.init[package_source.Release](a);
    fin { package_source.releases_dnit(a, ?rels); }
    val err_listed: err[fail.Fail] = releases((c)::ptr, url, ?rels);
    if (sel err_listed.err) { ret res[str, fail.Fail].err{err_listed.err}; }
    var i: usize = 0;
    for (i < rels.len) {
        if (str_equals(rels.data[i].commit, commit)) {
            val res_text: res[str, A.Error] = str_dup_range(a, rels.data[i].text, 0, str_len(rels.data[i].text));
            if (sel res_text.err) { ret res[str, fail.Fail].err{fail.refused(res_text.err)}; }
            ret res[str, fail.Fail].ok{res_text.ok};
        }
        i = i + 1;
    }
    val res_none: res[str, A.Error] = str_dup(a, "");
    if (sel res_none.err) { ret res[str, fail.Fail].err{fail.refused(res_none.err)}; }
    ret res[str, fail.Fail].ok{res_none.ok};
}

# the listing stays owned by the cache
fun cached_listing(c: *Remotes, url: str) res[str, fail.Fail] {
    val a: *A.Allocator = c.s.build_alloc;
    var i: usize        = 0;
    for (i < c.listings.len) {
        if (str_equals(c.listings.data[i].url, url)) { ret res[str, fail.Fail].ok{c.listings.data[i].text}; }
        i = i + 1;
    }
    var res_listed: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("unset")};
    if (c.offline) {
        var args: [3]str;
        args[0] = "for-each-ref";
        args[1] = "--format=%(objectname) %(refname)%0a%(*objectname) %(refname)^{}";
        args[2] = "refs/tags";
        val res_dir: res[str, fail.Fail] = offline_dir(c, url);
        if (sel res_dir.err) { ret res[str, fail.Fail].err{res_dir.err}; }
        res_listed = git.query_raw(a, ?c.gi, res_dir.ok, ?args[0], 3);
    }
    or {
        if (c.rep != nil) { report.fetching(c.rep, url); }
        val began: readout.Instant = readout.sample();
        var args:  [3]str;
        args[0]    = "ls-remote";
        args[1]    = "--tags";
        args[2]    = url;
        res_listed = git.query_raw(a, ?c.gi, ".", ?args[0], 3);
        if (c.rep != nil) { report.fetched(c.rep, url, readout.elapsed(began)); }
    }
    if (sel res_listed.err) { ret res_listed; }
    var cached: bool = false;
    fin {
        if (!cached) { str_free(a, res_listed.ok); }
    }
    val res_url: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel res_url.err) { ret res[str, fail.Fail].err{fail.refused(res_url.err)}; }
    fin {
        if (!cached) { str_free(a, res_url.ok); }
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[CachedListing](?c.listings, CachedListing{url: res_url.ok, text: res_listed.ok});
    if (sel res_pushed.err) { ret res[str, fail.Fail].err{fail.refused(res_pushed.err)}; }
    cached = true;
    ret res_listed;
}

val SCRATCH_ROLE: str = "the release candidate scratch";

# make the bare scratch repository release manifests are fetched into, once per table
fun ensure_scratch(c: *Remotes) err[fail.Fail] {
    if (c.scratch_ready) { ret err[fail.Fail].ok{}; }
    val a:       *A.Allocator        = c.s.build_alloc;
    val res_dup: res[str, fail.Fail] = scratch.path(a, "candidates");
    if (sel res_dup.err) { ret err[fail.Fail].err{res_dup.err}; }
    val err_made: err[fs.FsError] = fs.create_dir_all(a, res_dup.ok, 448);
    if (sel err_made.err) {
        val refused: fail.Fail = fail.refusal(a, diagnostic_kind.FS_CREATE, fail.Op{verb: "create", role: SCRATCH_ROLE, path: res_dup.ok}, fail.Cause.fs{err_made.err});
        str_free(a, res_dup.ok);
        ret err[fail.Fail].err{refused};
    }
    c.scratch       = res_dup.ok;
    c.scratch_ready = true;
    var args: [3]str;
    args[0] = "init";
    args[1] = "--bare";
    args[2] = "-q";
    val res_init: res[str, fail.Fail] = git.op(a, ?c.gi, c.scratch, ?args[0], 3, nil);
    if (sel res_init.err) { ret err[fail.Fail].err{res_init.err}; }
    str_free(a, res_init.ok);
    ret err[fail.Fail].ok{};
}

# a release that is no candidate, for the reason `why` and with no detail
fun excluded(why: str) res[package_source.Shipped, fail.Fail] {
    var out: package_source.Shipped;
    out.excluded = why;
    ret res[package_source.Shipped, fail.Fail].ok{out};
}

# why a release whose manifest failed to load is no candidate, with the load's own message
fun unloadable(fault: fail.Fail) res[package_source.Shipped, fail.Fail] {
    var text: str = fail.describe(fault);
    if (str_starts_with(text, "mach.toml: ")) { text = (?text[11])::str; }
    var out: package_source.Shipped;
    out.excluded = "its mach.toml does not load";
    out.detail   = text;
    ret res[package_source.Shipped, fail.Fail].ok{out};
}

fun is_fetched(c: *Remotes, url: str) bool {
    var i: usize = 0;
    for (i < c.fetched.len) {
        if (str_equals(c.fetched.data[i], url)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# run git in the scratch with automatic maintenance off: maintenance detached after one fetch
# rewrites the shallow file the next fetch reads, and the throwaway scratch never needs it
fun scratch_git(c: *Remotes, args: *Vector[str]) err[fail.Fail] {
    val res_ran: res[str, fail.Fail] = git.op(c.s.build_alloc, ?c.gi, c.scratch, args.data, args.len, nil);
    if (sel res_ran.err) { ret err[fail.Fail].err{res_ran.err}; }
    str_free(c.s.build_alloc, res_ran.ok);
    ret err[fail.Fail].ok{};
}

# append `n` borrowed words to a vector
fun push_all(v: *Vector[str], words: *str, n: usize) err[fail.Fail] {
    var i: usize = 0;
    for (i < n) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[str](v, words[i]);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# bring the manifest of every release listed at `url` into the scratch, once per url. the
# search reads only each release's commit and its mach.toml, so the first fetch takes the listed
# tags' commits and trees without file contents, and the second takes each mach.toml by the id
# its tree names: two round trips whatever the number or size of the releases. the tags are the
# listing's own, so the scratch holds what the listing named and nothing pushed since
fun fetch_manifests(c: *Remotes, url: str) err[fail.Fail] {
    if (is_fetched(c, url)) { ret err[fail.Fail].ok{}; }
    val err_ready: err[fail.Fail] = ensure_scratch(c);
    if (sel err_ready.err) { ret err_ready; }
    val a:    *A.Allocator                   = c.s.build_alloc;
    var rels: Vector[package_source.Release] = collections_vector.init[package_source.Release](a);
    fin { package_source.releases_dnit(a, ?rels); }
    val err_listed: err[fail.Fail] = releases((c)::ptr, url, ?rels);
    if (sel err_listed.err) { ret err_listed; }
    var owned: Vector[str] = collections_vector.init[str](a);
    fin {
        var k: usize = 0;
        for (k < owned.len) {
            str_free(a, owned.data[k]);
            k = k + 1;
        }
        collections_vector.dnit[str](?owned);
    }
    var head: [9]str;
    head[0] = "-c";
    head[1] = "gc.auto=0";
    head[2] = "-c";
    head[3] = "maintenance.auto=false";
    head[4] = "fetch";
    head[5] = "-q";
    head[6] = "--depth=1";
    head[7] = "--filter=blob:none";
    head[8] = url;
    var args: Vector[str] = collections_vector.init[str](a);
    fin { collections_vector.dnit[str](?args); }
    val err_head: err[fail.Fail] = push_all(?args, ?head[0], 9);
    if (sel err_head.err) { ret err_head; }
    var i: usize = 0;
    for (i < rels.len) {
        val res_refspec: res[str, std_format.FormatError] = std_format.sprint(a, "+refs/tags/{}:refs/tags/{}", rels.data[i].tag, rels.data[i].tag);
        if (sel res_refspec.err) { ret err[fail.Fail].err{fail.format_refused(res_refspec.err)}; }
        val res_kept: res[usize, A.Error] = collections_vector.push[str](?owned, res_refspec.ok);
        if (sel res_kept.err) {
            str_free(a, res_refspec.ok);
            ret err[fail.Fail].err{fail.refused(res_kept.err)};
        }
        val err_pushed: err[fail.Fail] = push_all(?args, ?owned.data[owned.len - 1], 1);
        if (sel err_pushed.err) { ret err_pushed; }
        i = i + 1;
    }
    if (rels.len > 0) {
        val err_trees: err[fail.Fail] = scratch_git(c, ?args);
        if (sel err_trees.err) { ret err_trees; }
    }
    # a manifest's id is read from its release's tree, which the first fetch brought
    collections_vector.truncate[str](?args, 0);
    var blob_head: [12]str;
    blob_head[0]  = "-c";
    blob_head[1]  = "gc.auto=0";
    blob_head[2]  = "-c";
    blob_head[3]  = "maintenance.auto=false";
    blob_head[4]  = "-c";
    blob_head[5]  = "fetch.negotiationAlgorithm=noop";
    blob_head[6]  = "fetch";
    blob_head[7]  = "-q";
    blob_head[8]  = "--no-tags";
    blob_head[9]  = "--no-write-fetch-head";
    blob_head[10] = "--filter=blob:none";
    blob_head[11] = url;
    val err_blob_head: err[fail.Fail] = push_all(?args, ?blob_head[0], 12);
    if (sel err_blob_head.err) { ret err_blob_head; }
    i = 0;
    for (i < rels.len) {
        var tree: [5]str;
        tree[0] = "ls-tree";
        tree[1] = "--format=%(objectname)";
        tree[2] = rels.data[i].commit;
        tree[3] = "--";
        tree[4] = manifest_load.MANIFEST_FILE;
        i       = i + 1;
        val res_id: res[str, fail.Fail] = git.query(a, ?c.gi, c.scratch, ?tree[0], 5);
        if (sel res_id.err) { ret err[fail.Fail].err{res_id.err}; }
        # a release with no mach.toml has no id, and reading it fails as before
        if (str_is_empty(res_id.ok)) {
            str_free(a, res_id.ok);
            cnt;
        }
        val res_kept: res[usize, A.Error] = collections_vector.push[str](?owned, res_id.ok);
        if (sel res_kept.err) {
            str_free(a, res_id.ok);
            ret err[fail.Fail].err{fail.refused(res_kept.err)};
        }
        val err_pushed: err[fail.Fail] = push_all(?args, ?owned.data[owned.len - 1], 1);
        if (sel err_pushed.err) { ret err_pushed; }
    }
    if (args.len > 12) {
        val err_blobs: err[fail.Fail] = scratch_git(c, ?args);
        if (sel err_blobs.err) { ret err_blobs; }
    }
    val res_url: res[str, A.Error] = str_dup_range(a, url, 0, str_len(url));
    if (sel res_url.err) { ret err[fail.Fail].err{fail.refused(res_url.err)}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[str](?c.fetched, res_url.ok);
    if (sel res_pushed.err) {
        str_free(a, res_url.ok);
        ret err[fail.Fail].err{fail.refused(res_pushed.err)};
    }
    ret err[fail.Fail].ok{};
}

# the manifest a release ships, read at its commit from the scratch, or offline from the local
# repository
# ---
# ctx: the table, a *Remotes
# url: the source url
# rel: the release
# ret: the manifest, owned by the caller, or why the release is no candidate when its
#      manifest is not valid TOML, states a compiler range the running compiler is outside
#      of, does not load or names another version, err when the manifest cannot be fetched
#      or read at all
pub fun shipped(ctx: ptr, url: str, rel: *package_source.Release) res[package_source.Shipped, fail.Fail] {
    val c:   *Remotes     = ctx::*Remotes;
    val a:   *A.Allocator = c.s.build_alloc;
    var dir: str          = c.local;
    if (c.offline) {
        val res_offline_dir: res[str, fail.Fail] = offline_dir(c, url);
        if (sel res_offline_dir.err) { ret res[package_source.Shipped, fail.Fail].err{res_offline_dir.err}; }
        dir = res_offline_dir.ok;
    }
    or {
        val err_fetched: err[fail.Fail] = fetch_manifests(c, url);
        if (sel err_fetched.err) { ret res[package_source.Shipped, fail.Fail].err{err_fetched.err}; }
        dir = c.scratch;
    }
    val res_spec: res[str, std_format.FormatError] = std_format.sprint(a, "{}:{}", rel.commit, manifest_load.MANIFEST_FILE);
    if (sel res_spec.err) { ret res[package_source.Shipped, fail.Fail].err{fail.message(fail.format_text(res_spec.err))}; }
    var show: [2]str;
    show[0] = "show";
    show[1] = res_spec.ok;
    val res_shown: res[str, fail.Fail] = git.query_raw(a, ?c.gi, dir, ?show[0], 2);
    str_free(a, res_spec.ok);
    if (sel res_shown.err) { ret res[package_source.Shipped, fail.Fail].err{res_shown.err}; }
    val text: str = res_shown.ok;
    fin { str_free(a, text); }
    # the release's manifest is only probed, its refusal never shown, so its text lives apart
    var probed: base_source.SourceMap = base_source.init(a);
    fin { base_source.dnit(?probed); }
    val res_doc: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(a, ?probed, manifest_load.MANIFEST_FILE, text);
    if (sel res_doc.err) { ret excluded("its mach.toml is not valid TOML"); }
    var doc: manifest_load.Doc = res_doc.ok;
    fin { manifest_load.doc_dnit(a, ?doc); }
    val header:   manifest_load.Header       = manifest_load.header(?doc);
    val res_mach: res[intern.StrId, A.Error] = intern.add(c.s.interner, header.mach);
    if (sel res_mach.err) { ret res[package_source.Shipped, fail.Fail].err{fail.refused(res_mach.err)}; }
    val mach:      str                         = intern.text(c.s.interner, res_mach.ok);
    val opt_range: opt[manifest_version.Range] = compile_closure.range_outside(mach);
    if (sel opt_range.some) { ret res[package_source.Shipped, fail.Fail].ok{package_source.Shipped{mach: mach, mach_range: opt_range}}; }
    val res_parsed: res[manifest_model.Manifest, fail.Fail] = manifest_load.parse(a, c.s.interner, ?doc);
    if (sel res_parsed.err) { ret unloadable(res_parsed.err); }
    var m:            manifest_model.Manifest = res_parsed.ok;
    val opt_declared: opt[str]                = intern.get(c.s.interner, m.version);
    var agrees:       bool                    = false;
    if (sel opt_declared.some) { agrees = str_equals(opt_declared.some, rel.text); }
    if (!agrees) {
        manifest_model.dnit(?m, a);
        ret excluded("its [project].version does not match the tag");
    }
    ret res[package_source.Shipped, fail.Fail].ok{package_source.Shipped{manifest: m, excluded: ""}};
}
