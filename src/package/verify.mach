# verify: `mach dep verify`, which checks a realized closure without changing it. the
# closure is located as a build locates it, and every edge is held to its pin and selectors
# through the source's checkouts table, to the identity and flat layout rules, and to the
# release rule; a root override of a requirer's selector is reported, not refused
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_is_empty;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use mach.compile;
use compile_closure: mach.compile.closure;
use mach.compile.project;
use mach.session;

use manifest_model: mach.manifest.model;
use mach.package;
use package_agreement: mach.package.agreement;
use package_closure:   mach.package.closure;
use git_member:        mach.package.git.member;
use package_path:      mach.package.path;
use mach.package.report;
use package_source: mach.package.source;

# a requirer's selector that the root's own declaration replaced. a root `ref` or `path`
# wins over every requirer with no check that the dependency supports it; a root
# `version` intersects with the requirers' ranges instead, so it is never one
# ---
# name:      the dependency key both declarations use
# chain:     the requiring chain, ending at the dependency
# requested: the requirer's selector, as `ref = "..."`, `version = "..."` or `path = "..."`
# declared:  the root's selector, in the same form
pub rec RootOverride {
    name:      intern.StrId;
    chain:     intern.StrId;
    requested: intern.StrId;
    declared:  intern.StrId;
}

# every edge of a realized closure whose selector a root override replaced, in closure order
# ---
# s:         the session; the returned ids are interned in it
# root_m:    the root manifest
# deps:      the realized closure
# dep_count: its length
# out:       receives one RootOverride per replaced edge
fun root_overrides(s: *session.Session, root_m: *manifest_model.Manifest, deps: *project.DepEntry, dep_count: u32,
    out: *Vector[RootOverride]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < dep_count) {
        val requirer: *project.DepEntry = ?deps[i];
        i = i + 1;
        var k: u32 = 0;
        for (k < requirer.manifest.dep_count) {
            val asked: *manifest_model.DepDef = ?requirer.manifest.deps[k];
            k = k + 1;
            val root_dep: *manifest_model.DepDef = compile_closure.root_dependency(root_m, asked.name);
            if (root_dep == nil || !intern.str_is_nil(root_dep.version)) { cnt; }
            if (same_selector(asked, root_dep))                          { cnt; }
            val res_chain: res[intern.StrId, fail.Fail] = intern_formatted(s, std_format.sprint(s.build_alloc, "{} -> {}", intern.text(?s.interner, requirer.chain), intern.text(?s.interner, asked.name)));
            if (sel res_chain.err) { ret err[fail.Fail].err{res_chain.err}; }
            val res_requested: res[intern.StrId, fail.Fail] = selector_id(s, asked);
            if (sel res_requested.err) { ret err[fail.Fail].err{res_requested.err}; }
            val res_declared: res[intern.StrId, fail.Fail] = selector_id(s, root_dep);
            if (sel res_declared.err) { ret err[fail.Fail].err{res_declared.err}; }
            val res_pushed: res[usize, A.Error] = collections_vector.push[RootOverride](out, RootOverride{name: asked.name, chain: res_chain.ok,
                requested: res_requested.ok, declared: res_declared.ok});
            if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        }
    }
    ret err[fail.Fail].ok{};
}

# the note `mach dep verify` prints for one override
pub fun root_override_text(s: *session.Session, o: *RootOverride) res[str, fail.Fail] {
    ret package.override_note(s.build_alloc, intern.text(?s.interner, o.name), intern.text(?s.interner, o.declared), intern.text(?s.interner, o.chain), intern.text(?s.interner, o.requested));
}

fun same_selector(a: *manifest_model.DepDef, b: *manifest_model.DepDef) bool {
    ret intern.str_same(a.git, b.git) && intern.str_same(a.path, b.path) && intern.str_same(a.ref, b.ref) && intern.str_same(a.version, b.version);
}

fun selector_id(s: *session.Session, d: *manifest_model.DepDef) res[intern.StrId, fail.Fail] {
    if (!intern.str_is_nil(d.version)) { ret intern_formatted(s, std_format.sprint(s.build_alloc, "version = \"{}\"", intern.text(?s.interner, d.version))); }
    if (!intern.str_is_nil(d.ref))     { ret intern_formatted(s, std_format.sprint(s.build_alloc, "ref = \"{}\"", package.ref_of(s, d))); }
    if (!intern.str_is_nil(d.path))    { ret intern_formatted(s, std_format.sprint(s.build_alloc, "path = \"{}\"", intern.text(?s.interner, d.path))); }
    ret intern_formatted(s, std_format.sprint(s.build_alloc, "git = \"{}\"", intern.text(?s.interner, d.git)));
}

fun intern_formatted(s: *session.Session, r: res[str, std_format.FormatError]) res[intern.StrId, fail.Fail] {
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.message(fail.format_text(r.err))}; }
    val res_interner_added: res[intern.StrId, A.Error] = intern.add(?s.interner, r.ok);
    str_free(s.build_alloc, r.ok);
    if (sel res_interner_added.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_interner_added.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_interner_added.ok};
}

# a manifest reached through a release (a version range or a `tag/`) may itself select only
# releases, so the release is reproducible from its tag all the way down
# ---
# s:     the session
# chain: the requirer chain that reached `m`, or the root's name
# what:  how `m` was selected, as its manifest line spells it
# m:     the manifest to check
# ret:   err naming the first dependency selected by a branch, a commit or a path
fun release_selects_releases(s: *session.Session, chain: str, what: str, m: *manifest_model.Manifest,
    root: *manifest_model.Manifest) err[fail.Fail] {
    var i: u32 = 0;
    for (i < m.dep_count) {
        val d: *manifest_model.DepDef = ?m.deps[i];
        i = i + 1;
        if (root != nil && compile_closure.root_dependency(root, d.name) != nil) { cnt; }
        var res_line: res[str, std_format.FormatError];
        if (intern.str_is_nil(d.git)) {
            res_line = std_format.sprint(s.build_alloc, "path = \"{}\"", intern.text(?s.interner, d.path));
        }
        or (!intern.str_is_nil(d.version) || str_starts_with(package.ref_of(s, d), "tag/")) { cnt; }
        or                                                                                  { res_line = std_format.sprint(s.build_alloc, "ref = \"{}\"", package.ref_of(s, d)); }
        if (sel res_line.err)                                                               { ret err[fail.Fail].err{fail.format_refused(res_line.err)}; }
        val res_sprint: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
            "{} is a release ({}) whose manifest selects [dep.{}] by {}, so it cannot be reproduced from its tag",
            chain, what, intern.text(?s.interner, d.name), res_line.ok);
        str_free(s.build_alloc, res_line.ok);
        if (sel res_sprint.err) { ret err[fail.Fail].err{fail.format_refused(res_sprint.err)}; }
        var res_remedy: res[str, std_format.FormatError];
        if (root == nil) {
            res_remedy = std_format.sprint(s.build_alloc, "{}. select [dep.{}] by `version` or an exact `tag/` before tagging", res_sprint.ok, intern.text(?s.interner, d.name));
        }
        or {
            res_remedy = std_format.sprint(s.build_alloc,
                "{}. declare [dep.{}] in your root manifest, or have the dependency cut a release that selects it by `version` or an exact `tag/`",
                res_sprint.ok, intern.text(?s.interner, d.name));
        }
        str_free(s.build_alloc, res_sprint.ok);
        if (sel res_remedy.err) { ret err[fail.Fail].err{fail.format_refused(res_remedy.err)}; }
        ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_RELEASE_SELECTOR, res_remedy.ok)};
    }
    ret err[fail.Fail].ok{};
}

# how a dependency line selects its target when that target is a release ("" otherwise)
fun release_selection(s: *session.Session, d: *manifest_model.DepDef) res[str, fail.Fail] {
    var res_sprint: res[str, std_format.FormatError];
    if (intern.str_is_nil(d.git))      { ret res[str, fail.Fail].ok{""}; }
    if (!intern.str_is_nil(d.version)) { res_sprint = std_format.sprint(s.build_alloc, "version = \"{}\"", intern.text(?s.interner, d.version)); }
    or {
        val ref: str = package.ref_of(s, d);
        if (!str_starts_with(ref, "tag/")) { ret res[str, fail.Fail].ok{""}; }
        res_sprint = std_format.sprint(s.build_alloc, "ref = \"{}\"", ref);
    }
    if (sel res_sprint.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(res_sprint.err))}; }
    ret res[str, fail.Fail].ok{res_sprint.ok};
}

# a release reached through `selected` selects only releases, apart from identities the root
# declares: the root's selector replaces the release's there, so the closure stays reproducible
fun edge_release_rule(s: *session.Session, chain: str, selected: *manifest_model.DepDef, m: *manifest_model.Manifest,
    root_m: *manifest_model.Manifest) err[fail.Fail] {
    val res_what: res[str, fail.Fail] = release_selection(s, selected);
    if (sel res_what.err)          { ret err[fail.Fail].err{res_what.err}; }
    if (str_is_empty(res_what.ok)) { ret err[fail.Fail].ok{}; }
    val err_release_selects_releases: err[fail.Fail] = release_selects_releases(s, chain, res_what.ok, m, root_m);
    str_free(s.build_alloc, res_what.ok);
    ret err_release_selects_releases;
}

# what `mach dep verify` holds the located closure to beyond what a build reads: each
# checkout against its pin and selectors, the identity, the flat layout and the release
# rule, through the source's checkouts table. a build locates the closure with no check
rec Verifier {
    checkouts: *package_source.Checkouts;
}

# what `mach dep verify` checks of one located dependency: its checkout against its pin
# (a source) or its contained tree (a path), its project id against its key, and no nested
# realization under it
# ---
# ret: the realized content the closure's exact selectors are checked against
fun located(ctx: ptr, s: *session.Session, alias: str, parent_root: str,
    dir_dep: str, d: *manifest_model.DepDef, entry: *project.DepEntry) res[intern.StrId, fail.Fail] {
    val v:           *Verifier = ctx::*Verifier;
    val dep_dir:     str       = intern.text(?s.interner, entry.vendor_root);
    var res_content: res[intern.StrId, fail.Fail];
    if (intern.str_is_nil(d.git)) { res_content = package_path.verify(s, alias, dep_dir); }
    or                            { res_content = v.checkouts.verify(v.checkouts.ctx, alias, parent_root, dep_dir, dir_dep, d); }
    if (sel res_content.err)      { ret res_content; }
    val err_identity: err[fail.Fail] = package.check_dep_identity(s, alias, intern.text(?s.interner, entry.project_id));
    if (sel err_identity.err) { ret res[intern.StrId, fail.Fail].err{err_identity.err}; }
    val err_nested: err[fail.Fail] = package.refuse_nested_realization(s, alias, dep_dir);
    if (sel err_nested.err) { ret res[intern.StrId, fail.Fail].err{err_nested.err}; }
    ret res_content;
}

fun release(ctx: ptr, s: *session.Session, chain: str, selected: *manifest_model.DepDef, m: *manifest_model.Manifest,
    root_m: *manifest_model.Manifest) err[fail.Fail] {
    ret edge_release_rule(s, chain, selected, m, root_m);
}

fun selector(ctx: ptr, s: *session.Session, alias: str, chain: str, project_root: str, dir_dep: str,
    d: *manifest_model.DepDef, content: intern.StrId, root_own: bool) err[fail.Fail] {
    val v: *Verifier = ctx::*Verifier;
    ret v.checkouts.satisfies(v.checkouts.ctx, alias, chain, project_root, dir_dep, d, content, root_own);
}

# the project's id, or `fallback` for a manifest that names no project
fun label_or(s: *session.Session, id: intern.StrId, fallback: str) str {
    if (intern.str_is_nil(id)) { ret fallback; }
    val t: str = intern.text(?s.interner, id);
    if (str_is_empty(t)) { ret fallback; }
    ret t;
}

# check a project's realized dependency closure without changing it
# ---
# s:            the session
# project_root: the root project's directory
# release_rule: also hold the root to the release rule: every dependency selected by
#               `version` or an exact `tag/`, as a release about to be tagged must be
# overrides:    when not nil, receives every requirer selector a root override replaced
# ret:          err naming the first mismatch
pub fun dependencies(s: *session.Session, project_root: str, release_rule: bool,
    overrides: *Vector[RootOverride]) err[fail.Fail] {
    val res_load_manifest: res[manifest_model.Manifest, fail.Fail] = compile.load_manifest(s, project_root);
    if (sel res_load_manifest.err) { ret err[fail.Fail].err{res_load_manifest.err}; }
    var m: manifest_model.Manifest = res_load_manifest.ok;
    fin { manifest_model.dnit(?m, s.build_alloc); }
    if (release_rule) {
        val res_who: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "project '{}'", label_or(s, m.id, project_root));
        if (sel res_who.err) { ret err[fail.Fail].err{fail.format_refused(res_who.err)}; }
        val err_release_selects_releases: err[fail.Fail] = release_selects_releases(s, res_who.ok, "checked by `mach dep verify --release`", ?m, nil);
        str_free(s.build_alloc, res_who.ok);
        if (sel err_release_selects_releases.err) { ret err_release_selects_releases; }
    }
    var quiet: report.Report = report.discard(s.build_alloc);
    fin { report.dnit(?quiet); }
    val res_opened: res[package_source.Checkouts, fail.Fail] = git_member.checkouts(s, ?quiet);
    if (sel res_opened.err) { ret err[fail.Fail].err{res_opened.err}; }
    var checkouts: package_source.Checkouts = res_opened.ok;
    fin { checkouts.close(checkouts.ctx); }
    var v:            Verifier                        = Verifier{checkouts: ?checkouts};
    var check:        compile_closure.Check           = compile_closure.Check{ctx: (?v)::ptr, located: located, release: release, selector: selector};
    val res_realized: res[project.Closure, fail.Fail] = compile.closure_checked(s, ?m, project_root, ?check);
    if (sel res_realized.err) { ret err[fail.Fail].err{res_realized.err}; }
    var closure: project.Closure = res_realized.ok;
    fin { project.closure_dnit(?closure); }
    if (overrides != nil) { ret root_overrides(s, ?m, closure.deps, closure.count, overrides); }
    ret err[fail.Fail].ok{};
}

# `mach dep verify`: check that every dependency of a project is realized and consistent
# without changing anything. a project root that is not a repository root is verified from
# the realized checkouts, and a realized directory under dep/ outside the closure is refused,
# where pull notes and retains it; each root override of a requirer's selector is reported
# ---
# s:            the session; a failure may borrow from it, so the caller shows it before ending it
# a:            the storage the operation works in
# root:         the project root directory
# release_rule: also refuse a root dependency selected by a branch, a commit or a path
# rep:          receives each override note and every refusal past the first
# ret:          err naming the failure
pub fun project_closure(s: *session.Session, a: *A.Allocator, root: str, release_rule: bool, rep: *report.Report) err[fail.Fail] {
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(s, a, root, rep);
    if (sel res_opened.err) { ret err[fail.Fail].err{res_opened.err}; }
    var op: package_closure.Operation = res_opened.ok;
    ret package_closure.ended(?op, verified(?op, release_rule));
}

fun verified(op: *package_closure.Operation, release_rule: bool) err[fail.Fail] {
    val s:    *session.Session                = op.s;
    val a:    *A.Allocator                    = op.a;
    val root: str                             = op.root;
    val rep:  *report.Report                  = op.rep;
    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?reqs); }
    var overrides: Vector[RootOverride] = collections_vector.init[RootOverride](a);
    fin { collections_vector.dnit[RootOverride](?overrides); }
    val err_walked: err[fail.Fail] = package_closure.realize(op, ?reqs, true, false, true, nil, nil);
    if (sel err_walked.err) { ret err_walked; }
    val err_checked: err[fail.Fail] = dependencies(s, root, release_rule, ?overrides);
    if (sel err_checked.err) { ret err_checked; }
    var split: Vector[str] = collections_vector.init[str](a);
    fin { package_agreement.lines_dnit(a, ?split); }
    val err_agreed: err[fail.Fail] = package_agreement.disagreements(op, ?reqs, ?split);
    if (sel err_agreed.err) { ret err_agreed; }
    val err_refused: err[fail.Fail] = package_agreement.refused(op, ?split);
    if (sel err_refused.err) { ret err_refused; }
    var i: usize = 0;
    for (i < overrides.len) {
        val res_text: res[str, fail.Fail] = root_override_text(s, ?overrides.data[i]);
        i = i + 1;
        if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
        report.note(rep, res_text.ok);
        str_free(s.build_alloc, res_text.ok);
    }
    ret err[fail.Fail].ok{};
}
