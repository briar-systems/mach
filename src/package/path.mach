# path: the member that realizes a dependency declared by a local `path`. it has no
# releases and no pin: every pull syncs dep/<id> with its source, copying what the source's
# git keeps when the source is in a work tree, and leaving behind the build output and the
# realized dependencies of every project inside it
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.memory;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use system_os: std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use toml_lookup: toml.lookup;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source:  mach.base.source;
use compile_load: mach.compile.load;
use mach.compile.project;
use mach.session;

use mach.base.diagnostic;
use compile_closure: mach.compile.closure;
use manifest_load:   mach.manifest.load;
use mach.package;
use mach.package.git;
use mach.package.report;

# a name in native units, owned, released with native_free
fun native_free(alloc: *A.Allocator, name: *Unit) {
    A.deallocate[Unit](alloc, name, types_path.native_len(name) + 1);
}

# `text` in native units, owned
fun native_of(alloc: *A.Allocator, text: str) res[*Unit, fail.Fail] {
    var converted: system_os.NativePath;
    if (system_os.native_path(text::*u8, ?converted) < 0) {
        val res_said: res[str, fail.Fail] = diagnostic.format(alloc, "'{}' has no native spelling", text);
        if (sel res_said.err) { ret res[*Unit, fail.Fail].err{res_said.err}; }
        ret res[*Unit, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, res_said.ok)};
    }
    val res_cloned: res[*Unit, A.Error] = types_path.native_clone(alloc, converted.units);
    system_os.native_path_dnit(?converted);
    if (sel res_cloned.err) { ret res[*Unit, fail.Fail].err{fail.refused(res_cloned.err)}; }
    ret res[*Unit, fail.Fail].ok{res_cloned.ok};
}

fun native_join(alloc: *A.Allocator, left: *Unit, right: *Unit) res[*Unit, fail.Fail] {
    val res_joined: res[*Unit, A.Error] = types_path.native_join(alloc, left, right);
    if (sel res_joined.err) { ret res[*Unit, fail.Fail].err{fail.refused(res_joined.err)}; }
    ret res[*Unit, fail.Fail].ok{res_joined.ok};
}

# `name` spelled in UTF-8, owned, or nil for a name with no UTF-8 spelling, which only windows can hold
fun native_spelled(alloc: *A.Allocator, name: NativeName) res[str, fail.Fail] {
    val measured: i64 = system_os.native_spelling(name.units, name.length, nil, 0);
    if (measured < 0) { ret res[str, fail.Fail].ok{nil}; }
    val n:            usize             = measured::usize;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, n + 1);
    if (sel res_allocate.err) { ret res[str, fail.Fail].err{fail.refused(res_allocate.err)}; }
    if (system_os.native_spelling(name.units, name.length, res_allocate.ok, n) < 0) {
        A.deallocate[u8](alloc, res_allocate.ok, n + 1);
        ret res[str, fail.Fail].ok{nil};
    }
    res_allocate.ok[n] = 0;
    ret res[str, fail.Fail].ok{res_allocate.ok::str};
}

# an order over names in native units, unit by unit
fun native_compare(a: *Unit, b: *Unit) i64 {
    var i: usize = 0;
    for (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    if (a[i] < b[i]) { ret -1; }
    if (a[i] > b[i]) { ret 1; }
    ret 0;
}

fun cmp_native_name(a: *NativeName, b: *NativeName) i64 {
    ret native_compare(a.units, b.units);
}

# `rel`, a UTF-8 rendering below `root`, joined to it, owned; an empty `rel` is the root
fun shown_below(alloc: *A.Allocator, root: str, rel: str) res[str, fail.Fail] {
    if (str_is_empty(rel)) { ret compile_load.join_path(alloc, root, "."); }
    ret compile_load.join_path(alloc, root, rel);
}

# the refusal of `verb` on the entry `rel` below `root`, both UTF-8 renderings
fun entry_refusal(alloc: *A.Allocator, k: diagnostic_kind.Kind, verb: str, role: str, root: str, rel: str, cause: fail.Cause) fail.Fail {
    val res_full: res[str, fail.Fail] = shown_below(alloc, root, rel);
    if (sel res_full.err) { ret res_full.err; }
    ret fail.refusal(alloc, k, fail.Op{verb: verb, role: role, path: res_full.ok}, cause);
}

# the UTF-8 rendering of a native name, a name with no UTF-8 spelling shown as U+FFFD, owned
fun native_shown(alloc: *A.Allocator, name: NativeName) res[str, fail.Fail] {
    val res_spelled: res[str, fail.Fail] = native_spelled(alloc, name);
    if (sel res_spelled.err)   { ret res_spelled; }
    if (res_spelled.ok != nil) { ret res_spelled; }
    val res_copied: res[str, types_string.StrError] = str_copy_slice(alloc, "\xef\xbf\xbd", 0, 3);
    if (sel res_copied.err) { ret res[str, fail.Fail].err{fail.str_refused(res_copied.err)}; }
    ret res[str, fail.Fail].ok{res_copied.ok};
}

# the directory `dir` and everything beneath it hold no symlink, walked by native names so a
# name with no UTF-8 spelling is passed over like any other
# ---
# shown: dir's UTF-8 rendering, which a refusal names
fun contained_tree_walk(alloc: *A.Allocator, dir: *Unit, shown: str) err[fail.Fail] {
    val res_listed: res[Vector[NativeName], fs.FsError] = fs.read_dir_native(alloc, dir);
    if (sel res_listed.err) { ret err[fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_READ, fail.Op{verb: "list", role: "the path dependency copy", path: shown}, fail.Cause.fs{res_listed.err})}; }
    var names: Vector[NativeName] = res_listed.ok;
    fin { fs.native_names_dnit(?names); }
    sort.sort_by[NativeName](names.data, names.len, cmp_native_name);
    var i: usize = 0;
    for (i < names.len) {
        val res_full: res[*Unit, fail.Fail] = native_join(alloc, dir, names.data[i].units);
        if (sel res_full.err) { ret err[fail.Fail].err{res_full.err}; }
        val full: *Unit = res_full.ok;
        fin { native_free(alloc, full); }
        val res_leaf: res[str, fail.Fail] = native_shown(alloc, names.data[i]);
        if (sel res_leaf.err) { ret err[fail.Fail].err{res_leaf.err}; }
        fin { str_free(alloc, res_leaf.ok); }
        val res_meta: res[fs.Metadata, io_error.Error] = fs.metadata_link_native(full);
        if (sel res_meta.err) { ret err[fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_READ, "inspect", "the path dependency copy entry", shown, res_leaf.ok, fail.Cause.io{res_meta.err})}; }
        val meta: fs.Metadata = res_meta.ok;
        if (fs.meta_is_symlink(?meta)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_SYMLINK, "path dependency realization must contain no symlinks")}; }
        if (fs.meta_is_dir(?meta)) {
            val res_nested: res[str, fail.Fail] = shown_below(alloc, shown, res_leaf.ok);
            if (sel res_nested.err) { ret err[fail.Fail].err{res_nested.err}; }
            val err_walk: err[fail.Fail] = contained_tree_walk(alloc, full, res_nested.ok);
            str_free(alloc, res_nested.ok);
            if (sel err_walk.err) { ret err_walk; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# what `mach dep verify` checks of a path dependency's copy: no repository metadata and no
# symlink anywhere in it
# ---
# ret: the realized content an exact selector is checked against
pub fun verify(s: *session.Session, alias: str, dep_dir: str) res[intern.StrId, fail.Fail] {
    val res_meta: res[str, fail.Fail] = compile_load.join_path(s.build_alloc, dep_dir, ".git");
    if (sel res_meta.err) { ret res[intern.StrId, fail.Fail].err{res_meta.err}; }
    val meta:       str                       = res_meta.ok;
    val res_exists: res[bool, io_error.Error] = fs.exists(meta);
    val has_meta:   bool                      = (sel res_exists.ok && res_exists.ok);
    str_free(s.build_alloc, meta);
    if (has_meta) { ret res[intern.StrId, fail.Fail].err{fail.user(diagnostic_kind.DEP_REPOSITORY_METADATA, "path dependency realization contains forbidden repository metadata")}; }
    val res_dir: res[*Unit, fail.Fail] = native_of(s.build_alloc, dep_dir);
    if (sel res_dir.err) { ret res[intern.StrId, fail.Fail].err{res_dir.err}; }
    val err_walk: err[fail.Fail] = contained_tree_walk(s.build_alloc, res_dir.ok, dep_dir);
    native_free(s.build_alloc, res_dir.ok);
    if (sel err_walk.err) { ret res[intern.StrId, fail.Fail].err{err_walk.err}; }
    val res_content_text: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "path/{}", alias);
    if (sel res_content_text.err) { ret res[intern.StrId, fail.Fail].err{fail.message(fail.format_text(res_content_text.err))}; }
    val content_text: str                        = res_content_text.ok;
    val res_content:  res[intern.StrId, A.Error] = intern.add(s.interner, content_text);
    str_free(s.build_alloc, content_text);
    if (sel res_content.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_content.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_content.ok};
}

# an entry of a tree being copied, named by its path below the root in native units, so a
# windows name with no UTF-8 spelling is copied as it is
# ---
# rel:   the path below the root in native units, owned
# shown: its UTF-8 rendering for notes, owned, a component with no UTF-8 spelling shown as U+FFFD
rec CopyEntry {
    rel:       *Unit;
    shown:     str;
    directory: bool;
    mode:      i32;
}

fun cmp_copy_entry(a: *CopyEntry, b: *CopyEntry) i64 {
    ret native_compare(a.rel, b.rel);
}

fun copy_entries_dnit(alloc: *A.Allocator, entries: *Vector[CopyEntry]) {
    var i: usize = 0;
    for (i < entries.len) {
        native_free(alloc, entries.data[i].rel);
        str_free(alloc, entries.data[i].shown);
        i = i + 1;
    }
    collections_vector.dnit[CopyEntry](entries);
}

# the directory a project's `[project].work` names, which is the template's leading
# segment: `out/{target.name}/{profile.name}` is written under `out`. a template that
# opens with a variable names no directory this can exclude, and names the conventional
# one. the name is owned by `alloc`
fun out_dir_segment(alloc: *A.Allocator, template: str) res[str, fail.Fail] {
    val n: usize = str_len(template);
    var i: usize = 0;
    for (i < n && template[i] != '/' && template[i] != '\\' && template[i] != '{') { i = i + 1; }
    var res_copied: res[str, types_string.StrError] = str_copy_slice(alloc, template, 0::usize, i);
    if (i == 0 || (i < n && template[i] == '{')) { res_copied = str_copy_slice(alloc, "out", 0::usize, 3); }
    if (sel res_copied.err)                      { ret res[str, fail.Fail].err{fail.str_refused(res_copied.err)}; }
    ret res[str, fail.Fail].ok{res_copied.ok};
}

# the work directory of a project directory, owned by `alloc`: its manifest's `work`, or
# the conventional name when the manifest names none. a directory without a manifest is
# not a project and excludes nothing, so it answers none; a manifest that cannot be read
# or does not parse is the failure
# ---
# dir:   the directory in native units
# shown: its UTF-8 rendering, which the manifest's diagnostics name
fun project_work_name(alloc: *A.Allocator, sources: *base_source.SourceMap, dir: *Unit, shown: str) res[opt[str], fail.Fail] {
    val res_leaf: res[*Unit, fail.Fail] = native_of(alloc, manifest_load.MANIFEST_FILE);
    if (sel res_leaf.err) { ret res[opt[str], fail.Fail].err{res_leaf.err}; }
    fin { native_free(alloc, res_leaf.ok); }
    val res_native_join: res[*Unit, fail.Fail] = native_join(alloc, dir, res_leaf.ok);
    if (sel res_native_join.err) { ret res[opt[str], fail.Fail].err{res_native_join.err}; }
    val mf: *Unit = res_native_join.ok;
    fin { native_free(alloc, mf); }
    val res_shown: res[str, fail.Fail] = compile_load.join_path(alloc, shown, manifest_load.MANIFEST_FILE);
    if (sel res_shown.err) { ret res[opt[str], fail.Fail].err{res_shown.err}; }
    fin { str_free(alloc, res_shown.ok); }
    val res_present: res[bool, io_error.Error] = fs.is_file_native(mf);
    if (sel res_present.err) { ret res[opt[str], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", path: res_shown.ok}, fail.Cause.io{res_present.err})}; }
    if (!res_present.ok)     { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val res_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes_native(alloc, mf);
    if (sel res_bytes.err) { ret res[opt[str], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_READ, fail.Op{verb: "read", path: res_shown.ok}, fail.Cause.fs{res_bytes.err})}; }
    var bytes: Vector[u8] = res_bytes.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    val res_doc: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse_bytes(alloc, sources, res_shown.ok, bytes.data, bytes.len);
    if (sel res_doc.err) { ret res[opt[str], fail.Fail].err{res_doc.err}; }
    var doc: manifest_load.Doc = res_doc.ok;
    fin { manifest_load.doc_dnit(alloc, ?doc); }
    var template:     str      = "out";
    val opt_declared: opt[str] = toml_lookup.get_str(?doc.table, "project.work");
    if (sel opt_declared.some) {
        if (!str_is_empty(opt_declared.some)) { template = opt_declared.some; }
    }
    val res_named: res[str, fail.Fail] = out_dir_segment(alloc, template);
    if (sel res_named.err) { ret res[opt[str], fail.Fail].err{res_named.err}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{res_named.ok}};
}

# what git considers part of a path dependency's source: its tracked files and the
# untracked ones its ignore rules keep, listed once. inactive outside a work tree,
# and for a source the enclosing repository ignores, which that repository does not hold
rec PathFilter {
    active: bool;
    paths:  Vector[str];
    top:    str;
}

val FILTER_SKIP:  u8 = 0;
val FILTER_WALK:  u8 = 1;
val FILTER_WHOLE: u8 = 2;

# a path order that reads `\` as `/`, so a joined path compares with git's
fun cmp_rel(a: str, b: str) i64 {
    var i: usize = 0;
    for (true) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret ca::i64 - cb::i64; }
        if (ca == 0)    { ret 0; }
        i = i + 1;
    }
    ret 0;
}

fun cmp_rel_ptr(a: *str, b: *str) i64 {
    ret cmp_rel(@a, @b);
}

fun path_filter_dnit(alloc: *A.Allocator, f: *PathFilter) {
    if (f.active)     { package.name_vector_dnit(alloc, ?f.paths); }
    if (f.top != nil) { str_free(alloc, f.top); }
    f.active = false;
    f.top    = nil;
}

# whether `git status` from a subdirectory reports it, or a directory holding it, as ignored.
# entries are relative to the work tree top, as `prefix` is, and an ignored directory ends in `/`
fun status_ignores_prefix(bytes: *git.Bytes, prefix: str) bool {
    val n:  usize = str_len(prefix);
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        val len: usize = end - at;
        if (len > 3 && len - 3 <= n && bytes.data[at] == '!' && bytes.data[at + 1] == '!' && bytes.data[end - 1] == '/') {
            var k: usize = 0;
            for (k < len - 3 && bytes.data[at + 3 + k] == prefix[k]) { k = k + 1; }
            if (k == len - 3) { ret true; }
        }
        at = end + 1;
    }
    ret false;
}

# `cause` reworded to name the source and the repository a git query on it failed in, or
# `cause` as it is when the text cannot be formatted
fun path_filter_refusal(alloc: *A.Allocator, what: str, src: str, top: str, cause: fail.Fail) fail.Fail {
    val res_sprint: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "path dependency '{}' cannot {} the git repository at '{}' ({})", src, what, top, fail.describe(cause));
    if (sel res_sprint.err) { ret cause; }
    ret fail.owning(fail.with_text(cause, res_sprint.ok));
}

# the kept listing of a source, from the repository that holds it. an empty listing below the
# top of a work tree is the one case where the source may be ignored rather than empty, and only
# then is the ignore state asked for, so a source costs two git processes, or three in that case
fun path_filter_load(alloc: *A.Allocator, environ: system_os.Environment, src: str) res[PathFilter, fail.Fail] {
    var f:                  PathFilter                    = PathFilter{active: false, top: nil};
    val res_inspector_init: res[git.Inspector, fail.Fail] = git.inspector_init(alloc, environ);
    if (sel res_inspector_init.err) { ret res[PathFilter, fail.Fail].ok{f}; }
    var gi: git.Inspector = res_inspector_init.ok;
    fin { git.inspector_dnit(alloc, ?gi); }
    var where_args: [4]str;
    where_args[0] = "rev-parse";
    where_args[1] = "--is-inside-work-tree";
    where_args[2] = "--show-prefix";
    where_args[3] = "--show-toplevel";
    # a source outside any repository is an expected answer, so git's complaint about it is captured, not shown
    val res_where: res[git.Bytes, fail.Fail] = git.query_capture(alloc, ?gi, src, ?where_args[0], 4, false, nil, system_os.INVALID_HANDLE, true);
    if (sel res_where.err) { ret res[PathFilter, fail.Fail].ok{f}; }
    var where: git.Bytes = res_where.ok;
    fin { git.bytes_dnit(alloc, ?where); }
    var first: usize = 0;
    for (first < where.len && where.data[first] != '\n') { first = first + 1; }
    if (first >= where.len) { ret res[PathFilter, fail.Fail].ok{f}; }
    where.data[first] = 0;
    if (!str_equals(where.data::str, "true")) { ret res[PathFilter, fail.Fail].ok{f}; }
    val prefix_at: usize = first + 1;
    var second:    usize = prefix_at;
    for (second < where.len && where.data[second] != '\n') { second = second + 1; }
    if (second >= where.len) { ret res[PathFilter, fail.Fail].ok{f}; }
    where.data[second] = 0;
    val prefix:  str   = (?where.data[prefix_at])::str;
    var top_end: usize = where.len;
    for (top_end > second + 1 && (where.data[top_end - 1] == '\n' || where.data[top_end - 1] == '\r')) { top_end = top_end - 1; }
    val res_top: res[str, types_string.StrError] = str_copy_slice(alloc, (?where.data[second + 1])::str, 0, top_end - second - 1);
    if (sel res_top.err) { ret res[PathFilter, fail.Fail].err{fail.message(fail.str_text(res_top.err))}; }
    f.top = res_top.ok;
    var handed: bool = false;
    fin {
        if (!handed) { path_filter_dnit(alloc, ?f); }
    }
    var list_args: [5]str;
    list_args[0] = "ls-files";
    list_args[1] = "--cached";
    list_args[2] = "--others";
    list_args[3] = "--exclude-standard";
    list_args[4] = "-z";
    val res_listed: res[git.Bytes, fail.Fail] = git.query_capture(alloc, ?gi, src, ?list_args[0], 5, false, nil, system_os.INVALID_HANDLE, true);
    if (sel res_listed.err) {
        ret res[PathFilter, fail.Fail].err{path_filter_refusal(alloc, "list the files kept by", src, f.top, res_listed.err)};
    }
    var bytes: git.Bytes = res_listed.ok;
    fin { git.bytes_dnit(alloc, ?bytes); }
    if (bytes.len == 0 && !str_is_empty(prefix)) {
        var status_args: [6]str;
        status_args[0] = "status";
        status_args[1] = "--porcelain=v1";
        status_args[2] = "-z";
        status_args[3] = "--ignored=matching";
        status_args[4] = "--";
        status_args[5] = ".";
        val res_status: res[git.Bytes, fail.Fail] = git.query_capture(alloc, ?gi, src, ?status_args[0], 6, false, nil, system_os.INVALID_HANDLE, true);
        if (sel res_status.err) {
            ret res[PathFilter, fail.Fail].err{path_filter_refusal(alloc, "read the ignore state from", src, f.top, res_status.err)};
        }
        var status:  git.Bytes = res_status.ok;
        val ignored: bool      = status_ignores_prefix(?status, prefix);
        git.bytes_dnit(alloc, ?status);
        if (ignored) {
            path_filter_dnit(alloc, ?f);
            ret res[PathFilter, fail.Fail].ok{f};
        }
    }
    f.paths  = collections_vector.init[str](alloc);
    f.active = true;
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        if (end > at) {
            val res_one: res[str, types_string.StrError] = str_copy_slice(alloc, (?bytes.data[at])::str, 0, end - at);
            if (sel res_one.err) { ret res[PathFilter, fail.Fail].err{fail.message(fail.str_text(res_one.err))}; }
            val res_pushed: res[usize, A.Error] = collections_vector.push[str](?f.paths, res_one.ok);
            if (sel res_pushed.err) {
                str_free(alloc, res_one.ok);
                ret res[PathFilter, fail.Fail].err{fail.refused(res_pushed.err)};
            }
        }
        at = end + 1;
    }
    sort.sort_by[str](f.paths.data, f.paths.len, cmp_rel_ptr);
    handed = true;
    ret res[PathFilter, fail.Fail].ok{f};
}

# `path` against `rel` followed by a separator, in cmp_rel's order
fun cmp_rel_below(path: str, rel: str) i64 {
    var i: usize = 0;
    for (rel[i] != 0) {
        var ca: u8 = path[i];
        var cb: u8 = rel[i];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret ca::i64 - cb::i64; }
        i = i + 1;
    }
    var ca: u8 = path[i];
    if (ca == '\\') { ca = '/'; }
    ret ca::i64 - '/'::i64;
}

# a listed path is kept, and a directory is walked when a listed path lies beneath it; a listed
# directory is a submodule gitlink, whose content git does not list, so it is kept whole
fun filter_decides(f: *PathFilter, rel: str) u8 {
    var lo: usize = 0;
    var hi: usize = f.paths.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (cmp_rel(f.paths.data[mid], rel) < 0) { lo = mid + 1; }
        or                                       { hi = mid; }
    }
    if (lo < f.paths.len && cmp_rel(f.paths.data[lo], rel) == 0) { ret FILTER_WHOLE; }
    # the first listed path at or after `rel/`, which lies beneath `rel` exactly when it starts so
    lo = 0;
    hi = f.paths.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (cmp_rel_below(f.paths.data[mid], rel) < 0) { lo = mid + 1; }
        or                                             { hi = mid; }
    }
    if (lo >= f.paths.len) { ret FILTER_SKIP; }
    val n: usize = str_len(rel);
    if (str_len(f.paths.data[lo]) <= n) { ret FILTER_SKIP; }
    var k: usize = 0;
    for (k < n) {
        var ca: u8 = f.paths.data[lo][k];
        var cb: u8 = rel[k];
        if (ca == '\\') { ca = '/'; }
        if (cb == '\\') { cb = '/'; }
        if (ca != cb)   { ret FILTER_SKIP; }
        k = k + 1;
    }
    val sep: u8 = f.paths.data[lo][n];
    if (sep == '/' || sep == '\\') { ret FILTER_WALK; }
    ret FILTER_SKIP;
}

# the inventory of a path dependency is its source: at every project
# boundary (a directory holding a manifest) the realized dependencies and
# the build output are left behind, so a re-pull copies what the first did.
# `keep`, when active, narrows it to what git keeps. the tree is listed by
# native names, and a name with no UTF-8 spelling matches no UTF-8 name: it
# is never the metadata, a boundary's directories, or a path git lists
# ---
# root:       the tree's root in native units
# rel:        the directory listed, below root in native units
# shown:      rel's UTF-8 rendering
# root_shown: root's UTF-8 rendering, which a refusal names with `shown` below it
# role:       what the tree is, as a refusal names it
fun copy_inventory(alloc: *A.Allocator, sources: *base_source.SourceMap, root: *Unit, rel: *Unit, shown: str, root_shown: str, role: str, source: bool,
    excluded: *fs.Identity, excluded_n: usize, entries: *Vector[CopyEntry], keep: *PathFilter) err[fail.Fail] {
    val res_dir: res[*Unit, fail.Fail] = native_join(alloc, root, rel);
    if (sel res_dir.err) { ret err[fail.Fail].err{res_dir.err}; }
    val dir: *Unit = res_dir.ok;
    fin { native_free(alloc, dir); }
    var out:     str  = nil;
    var project: bool = false;
    if (source) {
        val res_dir_shown: res[str, fail.Fail] = shown_below(alloc, root_shown, shown);
        if (sel res_dir_shown.err) { ret err[fail.Fail].err{res_dir_shown.err}; }
        val res_work: res[opt[str], fail.Fail] = project_work_name(alloc, sources, dir, res_dir_shown.ok);
        str_free(alloc, res_dir_shown.ok);
        if (sel res_work.err) { ret err[fail.Fail].err{res_work.err}; }
        if (sel res_work.ok.some) {
            project = true;
            out     = res_work.ok.some;
        }
    }
    fin {
        if (out != nil) { str_free(alloc, out); }
    }
    val res_listed: res[Vector[NativeName], fs.FsError] = fs.read_dir_native(alloc, dir);
    if (sel res_listed.err) { ret err[fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_READ, "list", role, root_shown, shown, fail.Cause.fs{res_listed.err})}; }
    var names: Vector[NativeName] = res_listed.ok;
    fin { fs.native_names_dnit(?names); }
    sort.sort_by[NativeName](names.data, names.len, cmp_native_name);
    var i: usize = 0;
    for (i < names.len) {
        val name: NativeName = names.data[i];
        i = i + 1;
        val res_spelled: res[str, fail.Fail] = native_spelled(alloc, name);
        if (sel res_spelled.err) { ret err[fail.Fail].err{res_spelled.err}; }
        val spelled: str = res_spelled.ok;
        fin {
            if (spelled != nil) { str_free(alloc, spelled); }
        }
        if (spelled != nil && source && str_equals(spelled, ".git"))                                                                 { cnt; }
        if (spelled != nil && project && (str_equals(spelled, compile_closure.DEP_DIR) || (out != nil && str_equals(spelled, out)))) { cnt; }
        var decision: u8 = FILTER_WHOLE;
        if (keep != nil && keep.active) {
            decision = FILTER_SKIP;
            if (spelled != nil) {
                val res_probe: res[str, fail.Fail] = compile_load.join_path(alloc, shown, spelled);
                if (sel res_probe.err) { ret err[fail.Fail].err{res_probe.err}; }
                decision = filter_decides(keep, res_probe.ok);
                str_free(alloc, res_probe.ok);
            }
        }
        if (decision == FILTER_SKIP) { cnt; }
        val res_child: res[*Unit, fail.Fail] = native_join(alloc, rel, name.units);
        if (sel res_child.err) { ret err[fail.Fail].err{res_child.err}; }
        val child:       *Unit = res_child.ok;
        var transferred: bool  = false;
        fin {
            if (!transferred) { native_free(alloc, child); }
        }
        var leaf: str = spelled;
        if (leaf == nil) { leaf = "\xef\xbf\xbd"; }
        val res_child_shown: res[str, fail.Fail] = compile_load.join_path(alloc, shown, leaf);
        if (sel res_child_shown.err) { ret err[fail.Fail].err{res_child_shown.err}; }
        val child_shown: str = res_child_shown.ok;
        fin {
            if (!transferred) { str_free(alloc, child_shown); }
        }
        val res_full: res[*Unit, fail.Fail] = native_join(alloc, root, child);
        if (sel res_full.err) { ret err[fail.Fail].err{res_full.err}; }
        val full: *Unit = res_full.ok;
        fin { native_free(alloc, full); }
        val res_metadata_link_native: res[fs.Metadata, io_error.Error] = fs.metadata_link_native(full);
        if (sel res_metadata_link_native.err) { ret err[fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_STAT, "inspect", role, root_shown, child_shown, fail.Cause.io{res_metadata_link_native.err})}; }
        val meta:      fs.Metadata = res_metadata_link_native.ok;
        val directory: bool        = fs.meta_is_dir(?meta);
        if (!directory && !fs.meta_is_file(?meta)) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_SYMLINK, "the path dependency holds a symlink or another entry that is not a regular file, so existing files were kept")};
        }
        if (directory && excluded_n != 0) {
            var identity:   fs.Identity;
            val identified: i64 = system_os.identity_at_native(system_os.working_dir(), full, ?identity);
            if (identified < 0) { ret err[fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_STAT, "identify", role, root_shown, child_shown, fail.Cause.native{identified})}; }
            var hit: bool  = false;
            var k:   usize = 0;
            for (k < excluded_n) {
                if (fs.identity_equal(identity, excluded[k])) { hit = true; }
                k = k + 1;
            }
            if (hit) { cnt; }
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[CopyEntry](entries, CopyEntry{rel: child, shown: child_shown, directory: directory, mode: (meta.mode & 0o777)::i32});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        transferred = true;
        if (directory) {
            var nested_keep: *PathFilter = keep;
            if (decision == FILTER_WHOLE) { nested_keep = nil; }
            val err_nested: err[fail.Fail] = copy_inventory(alloc, sources, root, child, child_shown, root_shown, role, source, excluded, excluded_n, entries, nested_keep);
            if (sel err_nested.err) { ret err[fail.Fail].err{err_nested.err}; }
        }
    }
    ret err[fail.Fail].ok{};
}

# the entry of a sorted inventory at `rel`, or nil
fun inventory_find(entries: *Vector[CopyEntry], rel: *Unit) *CopyEntry {
    var lo: usize = 0;
    var hi: usize = entries.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val cmp: i64   = native_compare(entries.data[mid].rel, rel);
        if (cmp == 0) { ret ?entries.data[mid]; }
        if (cmp < 0)  { lo = mid + 1; }
        or            { hi = mid; }
    }
    ret nil;
}

# whether the source inventory holds `prior` with the same kind
fun source_has(entries: *Vector[CopyEntry], prior: *CopyEntry) bool {
    val found: *CopyEntry = inventory_find(entries, prior.rel);
    ret found != nil && found.directory == prior.directory;
}

fun bytes_equal(a: *Vector[u8], b: *Vector[u8]) bool {
    ret a.len == b.len && memory.equal[u8](a.data, b.data, a.len);
}

# a source's inventory is never silently empty, and a project source keeps its manifest,
# since an empty or manifest-less copy fails later with a cause that points elsewhere
fun inventory_keeps_source(alloc: *A.Allocator, src: str, entries: *Vector[CopyEntry], keep: *PathFilter) err[fail.Fail] {
    var holds: bool = entries.len != 0;
    if (holds) {
        val res_join_path: res[str, fail.Fail] = compile_load.join_path(alloc, src, manifest_load.MANIFEST_FILE);
        if (sel res_join_path.err) { ret err[fail.Fail].err{res_join_path.err}; }
        val res_present: res[bool, io_error.Error] = fs.is_file(res_join_path.ok);
        str_free(alloc, res_join_path.ok);
        if (sel res_present.ok && res_present.ok) {
            val res_leaf: res[*Unit, fail.Fail] = native_of(alloc, manifest_load.MANIFEST_FILE);
            if (sel res_leaf.err) { ret err[fail.Fail].err{res_leaf.err}; }
            var wanted: CopyEntry = CopyEntry{rel: res_leaf.ok, shown: manifest_load.MANIFEST_FILE, directory: false, mode: 0};
            holds = source_has(entries, ?wanted);
            native_free(alloc, res_leaf.ok);
        }
    }
    if (holds) { ret err[fail.Fail].ok{}; }
    var res_sprint: res[str, std_format.FormatError];
    if (keep.active) {
        res_sprint = std_format.sprint(alloc,
            "path dependency source '{}' has no {} that the git repository at '{}' tracks. un-ignore or track it there, or make the source its own repository",
            src, manifest_load.MANIFEST_FILE, keep.top);
    }
    or                      { res_sprint = std_format.sprint(alloc, "path dependency source '{}' has nothing to copy", src); }
    if (sel res_sprint.err) { ret err[fail.Fail].err{fail.format_refused(res_sprint.err)}; }
    ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_PATH_EMPTY, res_sprint.ok)};
}

val COPY_ROLE:  str = "the path dependency copy";
val STALE_ROLE: str = "the entry its source no longer has";

# what syncing a path dependency's copy did: made it where none existed, refreshed what
# differed from its source, or reused it as it stood
pub val COPY_REFRESHED: u8 = 1;
pub val COPY_REUSED:    u8 = 2;
pub val COPY_MADE:      u8 = 3;

# the refusal to copy the file `rel` of `src` to the same place in `dst`, naming both
fun copy_refusal(alloc: *A.Allocator, src: str, dst: str, rel: str, cause: fail.Cause) fail.Fail {
    val res_from: res[str, fail.Fail] = shown_below(alloc, src, rel);
    if (sel res_from.err) { ret res_from.err; }
    val res_shown_below: res[str, fail.Fail] = shown_below(alloc, dst, rel);
    if (sel res_shown_below.err) { ret res_shown_below.err; }
    ret fail.refusal(alloc, diagnostic_kind.FS_WRITE, fail.Op{verb: "copy", path: res_from.ok, link: "to", other: res_shown_below.ok}, cause);
}

# sync `dst` with `src` and report what the sync did: COPY_MADE when `dst` did not exist,
# COPY_REFRESHED when anything in it changed, COPY_REUSED when it already matched its source
fun copy_tree(alloc: *A.Allocator, sources: *base_source.SourceMap, environ: system_os.Environment, src: str, dst: str, consumer: str, rep: *report.Report) res[u8, fail.Fail] {
    val res_metadata_link: res[fs.Metadata, io_error.Error] = fs.metadata_link(src);
    if (sel res_metadata_link.err) { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: "the path dependency source", path: src, given: true}, fail.Cause.io{res_metadata_link.err})}; }
    val source_meta: fs.Metadata = res_metadata_link.ok;
    if (!fs.meta_is_dir(?source_meta)) { ret res[u8, fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_DIRECTORY, "path dependency source must be a physical directory")}; }
    var destination_identity: fs.Identity;
    val observed:             i64 = system_os.identity_at(system_os.working_dir(), dst::*u8, ?destination_identity);
    if (observed < 0 && system_os.error_kind(observed) != io_error.NOT_FOUND) { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "identify", role: COPY_ROLE, path: dst}, fail.Cause.native{observed})}; }
    var excluded:   [2]fs.Identity;
    var excluded_n: usize = 0;
    if (observed == 0) {
        val res_metadata_link: res[fs.Metadata, io_error.Error] = fs.metadata_link(dst);
        if (sel res_metadata_link.err) { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: COPY_ROLE, path: dst}, fail.Cause.io{res_metadata_link.err})}; }
        val destination_meta: fs.Metadata = res_metadata_link.ok;
        if (!fs.meta_is_dir(?destination_meta)) { ret res[u8, fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_DIRECTORY, "path dependency destination must be a physical directory")}; }
        var source_identity: fs.Identity;
        val identified:      i64 = system_os.identity_at(system_os.working_dir(), src::*u8, ?source_identity);
        if (identified < 0)                                           { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "identify", role: "the path dependency source", path: src, given: true}, fail.Cause.native{identified})}; }
        if (fs.identity_equal(source_identity, destination_identity)) { ret res[u8, fail.Fail].err{fail.user(diagnostic_kind.DEP_PATH_SAME, "path dependency source and destination are the same directory")}; }
        excluded[0] = destination_identity;
        excluded_n  = 1;
    }
    # the consumer's own root, whichever level of the source it sits at, is never part of its dependency
    var consumer_identity:   fs.Identity;
    val consumer_identified: i64 = system_os.identity_at(system_os.working_dir(), consumer::*u8, ?consumer_identity);
    if (consumer_identified < 0) { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "identify", role: "the project root", path: consumer}, fail.Cause.native{consumer_identified})}; }
    excluded[excluded_n] = consumer_identity;
    excluded_n           = excluded_n + 1;
    val res_src: res[*Unit, fail.Fail] = native_of(alloc, src);
    if (sel res_src.err) { ret res[u8, fail.Fail].err{res_src.err}; }
    val src_n: *Unit = res_src.ok;
    fin { native_free(alloc, src_n); }
    val res_dst: res[*Unit, fail.Fail] = native_of(alloc, dst);
    if (sel res_dst.err) { ret res[u8, fail.Fail].err{res_dst.err}; }
    val dst_n: *Unit = res_dst.ok;
    fin { native_free(alloc, dst_n); }
    var top: [1]Unit;
    top[0] = 0;
    var entries: Vector[CopyEntry] = collections_vector.init[CopyEntry](alloc);
    fin { copy_entries_dnit(alloc, ?entries); }
    val res_filter: res[PathFilter, fail.Fail] = path_filter_load(alloc, environ, src);
    if (sel res_filter.err) { ret res[u8, fail.Fail].err{res_filter.err}; }
    var keep: PathFilter = res_filter.ok;
    fin { path_filter_dnit(alloc, ?keep); }
    val err_collected: err[fail.Fail] = copy_inventory(alloc, sources, src_n, ?top[0], "", src, "the path dependency source entry", true, ?excluded[0], excluded_n, ?entries, ?keep);
    if (sel err_collected.err) { ret res[u8, fail.Fail].err{err_collected.err}; }
    sort.sort_by[CopyEntry](entries.data, entries.len, cmp_copy_entry);
    val err_kept: err[fail.Fail] = inventory_keeps_source(alloc, src, ?entries, ?keep);
    if (sel err_kept.err) { ret res[u8, fail.Fail].err{err_kept.err}; }
    var existing: Vector[CopyEntry] = collections_vector.init[CopyEntry](alloc);
    fin { copy_entries_dnit(alloc, ?existing); }
    if (observed == 0) {
        val err_collected_dst: err[fail.Fail] = copy_inventory(alloc, sources, dst_n, ?top[0], "", dst, "the path dependency copy entry", false, nil, 0, ?existing, nil);
        if (sel err_collected_dst.err) { ret res[u8, fail.Fail].err{err_collected_dst.err}; }
    }
    sort.sort_by[CopyEntry](existing.data, existing.len, cmp_copy_entry);
    var changed: bool = observed != 0;
    # the realization is its source: an entry the source no longer has is removed rather
    # than kept, and every removal is named, since the destination is mach's own copy
    var i: usize = existing.len;
    for (i > 0) {
        i = i - 1;
        val prior: CopyEntry = existing.data[i];
        if (source_has(?entries, ?prior)) { cnt; }
        val res_full: res[*Unit, fail.Fail] = native_join(alloc, dst_n, prior.rel);
        if (sel res_full.err) { ret res[u8, fail.Fail].err{res_full.err}; }
        val full: *Unit = res_full.ok;
        fin { native_free(alloc, full); }
        if (prior.directory) {
            val err_pruned: err[fs.FsError] = fs.remove_all_native(alloc, full);
            if (sel err_pruned.err) { ret res[u8, fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_REMOVE, "remove", STALE_ROLE, dst, prior.shown, fail.Cause.fs{err_pruned.err})}; }
        }
        or {
            val err_unlinked: err[io_error.Error] = fs.remove_file_native(full);
            if (sel err_unlinked.err) { ret res[u8, fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_REMOVE, "remove", STALE_ROLE, dst, prior.shown, fail.Cause.io{err_unlinked.err})}; }
        }
        report.notef(rep, alloc, "path dependency '{}' removed '{}', which its source no longer has", dst, prior.shown);
        changed = true;
    }
    val err_create_dir_all: err[fs.FsError] = fs.create_dir_all(alloc, dst, 0o755);
    if (sel err_create_dir_all.err) { ret res[u8, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_CREATE, fail.Op{verb: "create", role: COPY_ROLE, path: dst}, fail.Cause.fs{err_create_dir_all.err})}; }
    i = 0;
    var complete: bool = false;
    fin {
        if (!complete) { report.notef(rep, alloc, "the path dependency copy stopped after {} entries. destination '{}' was kept for inspection", i, dst); }
    }
    for (i < entries.len) {
        val entry:    CopyEntry             = entries.data[i];
        val res_from: res[*Unit, fail.Fail] = native_join(alloc, src_n, entry.rel);
        if (sel res_from.err) { ret res[u8, fail.Fail].err{res_from.err}; }
        val from: *Unit = res_from.ok;
        fin { native_free(alloc, from); }
        val res_native_join: res[*Unit, fail.Fail] = native_join(alloc, dst_n, entry.rel);
        if (sel res_native_join.err) { ret res[u8, fail.Fail].err{res_native_join.err}; }
        val to: *Unit = res_native_join.ok;
        fin { native_free(alloc, to); }
        if (entry.directory) {
            if (inventory_find(?existing, entry.rel) == nil) { changed = true; }
            val err_made: err[fs.FsError] = fs.create_dir_all_native(alloc, to, 0o755);
            if (sel err_made.err) { ret res[u8, fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_CREATE, "create", "the path dependency copy directory", dst, entry.shown, fail.Cause.fs{err_made.err})}; }
        }
        or {
            val res_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes_native(alloc, from);
            if (sel res_bytes.err) { ret res[u8, fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_READ, "read", "the path dependency source file", src, entry.shown, fail.Cause.fs{res_bytes.err})}; }
            var bytes: Vector[u8] = res_bytes.ok;
            fin { collections_vector.dnit[u8](?bytes); }
            # a file the copy already holds is left alone when it matches, and named when replaced,
            # since a re-pull overwrites whatever the copy was edited to
            val prior:    *CopyEntry = inventory_find(?existing, entry.rel);
            var replaced: bool       = false;
            if (prior != nil && !prior.directory) {
                val res_held: res[Vector[u8], fs.FsError] = fs.read_bytes_native(alloc, to);
                if (sel res_held.err) { ret res[u8, fail.Fail].err{entry_refusal(alloc, diagnostic_kind.FS_READ, "read", "the path dependency copy file", dst, entry.shown, fail.Cause.fs{res_held.err})}; }
                var held: Vector[u8] = res_held.ok;
                val same: bool       = bytes_equal(?held, ?bytes);
                collections_vector.dnit[u8](?held);
                if (same && prior.mode == entry.mode) {
                    i = i + 1;
                    cnt;
                }
                replaced = !same;
            }
            changed = true;
            val err_written: err[fs.FsError] = fs.write_bytes_native(to, bytes.data, bytes.len, entry.mode);
            if (sel err_written.err) { ret res[u8, fail.Fail].err{copy_refusal(alloc, src, dst, entry.shown, fail.Cause.fs{err_written.err})}; }
            if (replaced)            { report.notef(rep, alloc, "path dependency '{}' replaced '{}' with its source's content", dst, entry.shown); }
        }
        i = i + 1;
    }
    complete = true;
    if (observed != 0) { ret res[u8, fail.Fail].ok{COPY_MADE}; }
    if (changed)       { ret res[u8, fail.Fail].ok{COPY_REFRESHED}; }
    ret res[u8, fail.Fail].ok{COPY_REUSED};
}

# sync dep/<id> with a path dependency's source
# ---
# ret: COPY_MADE, COPY_REFRESHED or COPY_REUSED, what the sync did to the copy
pub fun realize(s: *session.Session, root: str, id: str, src_dir: str, rep: *report.Report) res[u8, fail.Fail] {
    val err_verify_dep_manifest_id: err[fail.Fail] = package.verify_dep_manifest_id(s, src_dir, id);
    if (sel err_verify_dep_manifest_id.err) { ret res[u8, fail.Fail].err{err_verify_dep_manifest_id.err}; }
    val res_dep_full: res[str, fail.Fail] = package.dep_full_of(s.build_alloc, root, id);
    if (sel res_dep_full.err) { ret res[u8, fail.Fail].err{res_dep_full.err}; }
    val dep_full: str = res_dep_full.ok;
    fin { str_free(s.build_alloc, dep_full); }
    ret copy_tree(s.build_alloc, s.sources, s.environ, src_dir, dep_full, root, rep);
}
