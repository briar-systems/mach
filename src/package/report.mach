# where dependency management reports while it works. a result line (a verb from
# mach.report.layout's table and what it acted on), a note, a failure the operation goes on
# past, and each remote whose releases it fetches stream to the caller as they happen; `effects`
# collects a note for each change an operation made before it failed, which the caller shows
# after the failure, so a failed command still names the state it left
use chrono_duration:    std.chrono.duration;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.base.fail;
use mach.report.layout;

# a result line: its verb and the texts after it, written to standard output
def SaidFn: fun(ptr, layout.Verb, *str, usize);
# a note, written to standard error
def NoteFn: fun(ptr, str);
# a failure the operation reports and goes on past
def FaultFn: fun(ptr, fail.Fail);
# a fetch from the remote at a url began: the url, how many fetches of the caller's stage are
# done, how many it expects, 0 when it cannot count them, and whether the caller opened a stage
def FetchingFn: fun(ptr, str, u32, u32, bool);
# that fetch ended, after the duration it took, and whether the caller opened a stage over it
def FetchedFn: fun(ptr, str, chrono_duration.Duration, bool);

# what a report's sink does with each thing reported
# ---
# said:     writes a result line
# note:     writes a note
# fault:    reports a failure the operation goes on past
# fetching: shows a fetch beginning
# fetched:  shows a fetch ended
pub rec Sink {
    said:     SaidFn;
    note:     NoteFn;
    fault:    FaultFn;
    fetching: FetchingFn;
    fetched:  FetchedFn;
}

# a sink for result lines, notes, faults and fetches, with the effect notes an operation
# collected and the fetches it made
# ---
# ctx:      the context each callback receives
# sink:     what the callbacks are
# effects:  the effect notes kept so far, owned by the report
# staged:   whether the caller opened a stage over the fetches, which then show as its items
# expected: the fetches the caller expects in its stage, 0 when it cannot count them
# fetches:  the fetches ended since the stage opened
# fetching: the time they took together
pub rec Report {
    ctx:      ptr;
    sink:     Sink;
    effects:  Vector[str];
    staged:   bool;
    expected: u32;
    fetches:  u32;
    fetching: chrono_duration.Duration;
}

# a report over the given sink, whose effects `a` owns
pub fun init(a: *A.Allocator, ctx: ptr, sink: Sink) Report {
    ret Report{ctx: ctx, sink: sink, effects: collections_vector.init[str](a), staged: false, expected: 0, fetches: 0, fetching: 0};
}

# free the effect notes the report kept
# ---
# r: the report to release
pub fun dnit(r: *Report) {
    var i: usize = 0;
    for (i < r.effects.len) {
        str_free(r.effects.a, r.effects.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](?r.effects);
}

# write a result line to the sink: verb v, then the n texts at `texts`, borrowed for the call
pub fun said(r: *Report, v: layout.Verb, texts: *str, n: usize) {
    r.sink.said(r.ctx, v, texts, n);
}

# a result line of verb v and what it acted on
pub fun said1(r: *Report, v: layout.Verb, a: str) {
    var texts: [1]str = [1]str{a};
    r.sink.said(r.ctx, v, ?texts[0], 1);
}

# a result line of verb v, what it acted on and one detail
pub fun said2(r: *Report, v: layout.Verb, a: str, b: str) {
    var texts: [2]str = [2]str{a, b};
    r.sink.said(r.ctx, v, ?texts[0], 2);
}

# a result line of verb v, what it acted on and two details
pub fun said3(r: *Report, v: layout.Verb, a: str, b: str, c: str) {
    var texts: [3]str = [3]str{a, b, c};
    r.sink.said(r.ctx, v, ?texts[0], 3);
}

# write a note to the sink
# ---
# r:    the report
# text: the note, borrowed for the call
pub fun note(r: *Report, text: str) {
    r.sink.note(r.ctx, text);
}

# report a failure the operation goes on past
# ---
# r: the report
# f: the failure
pub fun fault(r: *Report, f: fail.Fail) {
    r.sink.fault(r.ctx, f);
}

# the caller opened a stage over the fetches from here, which it expects `n` of, 0 when it cannot
# count them; the sink counts them as they begin and shows each as an item of that stage
pub fun stage(r: *Report, n: u32) {
    r.staged   = true;
    r.expected = n;
    r.fetches  = 0;
    r.fetching = 0;
}

# a fetch from the remote at `url` begins
pub fun fetching(r: *Report, url: str) {
    r.sink.fetching(r.ctx, url, r.fetches, r.expected, r.staged);
}

# the fetch from `url` ended after `d`
pub fun fetched(r: *Report, url: str, d: chrono_duration.Duration) {
    r.fetches  = r.fetches + 1;
    r.fetching = r.fetching + d;
    r.sink.fetched(r.ctx, url, d, r.staged);
}

# keep an effect note formatted as std.format formats it; a note that cannot be kept is
# dropped, since it only explains a failure already reported
pub fun effectf(r: *Report, fmt: str, va: ...) {
    val res_text: res[str, std_format.FormatError] = std_format.sprint(r.effects.a, fmt, va...);
    if (sel res_text.err) { ret; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[str](?r.effects, res_text.ok);
    if (sel res_pushed.err) { str_free(r.effects.a, res_text.ok); }
}

# a note formatted as std.format formats it, through storage `a` lends for the call
pub fun notef(r: *Report, a: *A.Allocator, fmt: str, va: ...) {
    val res_text: res[str, std_format.FormatError] = std_format.sprint(a, fmt, va...);
    if (sel res_text.err) { ret; }
    r.sink.note(r.ctx, res_text.ok);
    str_free(a, res_text.ok);
}

fun discard_text(ctx: ptr, text: str) {}

fun discard_said(ctx: ptr, v: layout.Verb, texts: *str, n: usize) {}

fun discard_fault(ctx: ptr, f: fail.Fail) {}

fun discard_fetching(ctx: ptr, url: str, done: u32, total: u32, staged: bool) {}

fun discard_fetched(ctx: ptr, url: str, d: chrono_duration.Duration, staged: bool) {}

# a report that keeps nothing, for work that has nothing to say or a test that checks state
# rather than what is said
pub fun discard(a: *A.Allocator) Report {
    ret init(a, nil, Sink{said: discard_said, note: discard_text, fault: discard_fault, fetching: discard_fetching, fetched: discard_fetched});
}
