# git: the one outside tool mach runs. a dependency is acquired and pinned through git
# (package/git holds the source and pin members built on it); nothing else in the
# toolchain spawns it, and a build never does. every git process starts here, with one
# environment that keeps the user's configuration and drops whatever would redirect git to
# another repository, and every failure names the command, how it ended and what git printed
use std.collections.sort;
use std.chrono.time;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.process.env;
use std.process.exec;
use std.runtime.native.view.NativeName;
use std.runtime.native.view.Unit;
use sync_cancel: std.sync.cancel;
use system_os:   std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use compile_load: mach.compile.load;
use mach.host;
use host_environment: mach.host.environment;
use mach.host.interrupt;
use mach.host.subprocess;
use mach.package.scratch;
use mach.session;

pub rec Entry {
    path: str;
    mode: str;
}

# one checked-out tree's committed entries, as `git ls-tree -r -t --full-tree HEAD` lists
# them: repository-relative paths with their object modes, sorted by path
rec Tree {
    dir:     str;
    entries: Vector[Entry];
}

# an inspector spawns git with one environment and answers every committed-mode question
# about a checkout from one tree listing, so verification costs a constant number of git
# processes per checkout rather than one per walked path. a command that can move
# a checkout drops the listings.
pub rec Inspector {
    program:       str;
    inherited_env: exec.Environment;
    alloc:         *A.Allocator;
    env_ready:     bool;
    env_inherited: exec.Environment;
    env:           host_environment.Strings;
    trees:         Vector[Tree];
    trees_ready:   bool;
}

# an inspector whose git processes inherit `environ`, a session's environment
pub fun inspector_init(alloc: *A.Allocator, environ: exec.Environment) res[Inspector, fail.Fail] {
    val res_resolve: res[str, exec.Error] = exec.resolve(alloc, "git");
    if (sel res_resolve.err) { ret res[Inspector, fail.Fail].err{fail.environment(diagnostic_kind.GIT_MISSING, "git is not on PATH, and verifying dependencies needs it")}; }
    ret res[Inspector, fail.Fail].ok{Inspector{program: res_resolve.ok, inherited_env: environ, alloc: alloc}};
}

fun tree_dnit(alloc: *A.Allocator, t: *Tree) {
    str_free(alloc, t.dir);
    var i: usize = 0;
    for (i < t.entries.len) {
        str_free(alloc, t.entries.data[i].path);
        str_free(alloc, t.entries.data[i].mode);
        i = i + 1;
    }
    collections_vector.dnit[Entry](?t.entries);
}

fun trees_dnit(gi: *Inspector) {
    if (!gi.trees_ready) { ret; }
    var i: usize = 0;
    for (i < gi.trees.len) {
        tree_dnit(gi.alloc, ?gi.trees.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[Tree](?gi.trees);
    gi.trees_ready = false;
}

pub fun inspector_dnit(alloc: *A.Allocator, gi: *Inspector) {
    trees_dnit(gi);
    if (gi.env_ready) { host_environment.strings_dnit(gi.alloc, ?gi.env); }
    gi.env_ready = false;
    str_free(alloc, gi.program);
    gi.program       = nil;
    gi.inherited_env = exec.Environment.inherit{};
}

pub rec Bytes {
    data: *u8;
    len:  usize;
}

pub fun bytes_dnit(alloc: *A.Allocator, bytes: *Bytes) {
    if (bytes.data != nil) { A.deallocate[u8](alloc, bytes.data, bytes.len + 1); }
    bytes.data = nil;
    bytes.len  = 0;
}

fun captured_bytes(alloc: *A.Allocator, p: *subprocess.OwnedSubprocess, trim_line_end: bool) res[Bytes, fail.Fail] {
    var n:   usize = 0;
    val src: *u8   = subprocess.capture_bytes(p, ?n);
    for (trim_line_end && n > 0 && (src[n - 1] == '\n' || src[n - 1] == '\r')) { n = n - 1; }
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, n + 1);
    if (sel res_allocate.err) { ret res[Bytes, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val out: *u8   = res_allocate.ok;
    var i:   usize = 0;
    for (i < n) {
        out[i] = src[i];
        i      = i + 1;
    }
    out[n] = 0;
    ret res[Bytes, fail.Fail].ok{Bytes{data: out, len: n}};
}

# release a run's child and capture file; a capture file that stays is the failure
fun capture_dnit(alloc: *A.Allocator, capture: str, child: *subprocess.OwnedSubprocess, release: bool) err[fail.Fail] {
    # a capture finished once refuses release only when its own buffer's free is refused, which leaves no file behind
    if (release) { subprocess.capture_dnit(alloc, child); }
    subprocess.dnit(alloc, child);
    val err_removed: err[fail.Fail] = capture_removed(alloc, capture);
    str_free(alloc, capture);
    ret err_removed;
}

val CAPTURE_ROLE: str = "the git output capture file";

# the capture file removed; one never made or already gone is no failure
fun capture_removed(alloc: *A.Allocator, capture: str) err[fail.Fail] {
    val err_removed: err[io_error.Error] = fs.remove_file(capture);
    if (sel err_removed.ok)                         { ret err[fail.Fail].ok{}; }
    if (err_removed.err.kind == io_error.NOT_FOUND) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: CAPTURE_ROLE, path: capture}, fail.Cause.io{err_removed.err})};
}

pub fun count_nil_terminated(arr: **u8) usize {
    if (arr == nil) { ret 0; }
    var n: usize = 0;
    for (arr[n] != nil) { n = n + 1; }
    ret n;
}

# whether the name of `entry`, NAME=value in native units, begins with the
# segments of `prefix` by the host's environment name identity. a prefix ending
# in '=' names the whole variable
fun env_prefix(alloc: *A.Allocator, entry: *Unit, prefix: str) res[bool, fail.Fail] {
    val prefix_size: usize = str_len(prefix);
    val exact:       bool  = prefix[prefix_size - 1] == '=';
    var wanted:      usize = 0;
    var i:           usize = 0;
    for (i < prefix_size) {
        if (prefix[i] == '_') { wanted = wanted + 1; }
        i = i + 1;
    }
    var size:  usize = 0;
    var parts: usize = 0;
    for (entry[size] != 0 && entry[size] != '='::Unit) {
        if (!exact && entry[size] == '_'::Unit) {
            parts = parts + 1;
            if (parts == wanted) {
                size = size + 1;
                brk;
            }
        }
        size = size + 1;
    }
    var compared: usize = prefix_size;
    if (exact) {
        if (entry[size] != '='::Unit) { ret res[bool, fail.Fail].ok{false}; }
        compared = compared - 1;
    }
    or (parts != wanted) { ret res[bool, fail.Fail].ok{false}; }
    val res_str_copy_slice: res[str, types_string.StrError] = str_copy_slice(alloc, prefix, 0, compared);
    if (sel res_str_copy_slice.err) { ret res[bool, fail.Fail].err{fail.message(fail.str_text(res_str_copy_slice.err))}; }
    val res_native_text: res[NativeName, host.NativeTextError] = host.native_text(alloc, res_str_copy_slice.ok);
    str_free(alloc, res_str_copy_slice.ok);
    if (sel res_native_text.err) { ret res[bool, fail.Fail].err{fail.message(host.native_text_message(res_native_text.err))}; }
    var right: NativeName = res_native_text.ok;
    fin { host.native_text_dnit(alloc, ?right); }
    val res_order: res[i32, fail.Fail] = host.compare_env_names(alloc, entry, size, right.units, right.length);
    if (sel res_order.err) { ret res[bool, fail.Fail].err{res_order.err}; }
    ret res[bool, fail.Fail].ok{res_order.ok == 0};
}

fun env_names_config(alloc: *A.Allocator, entry: *Unit) res[bool, fail.Fail] {
    var prefixes: [3]str = [3]str{"GIT_CONFIG_COUNT=", "GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"};
    var i:        usize  = 0;
    for (i < 3) {
        val res_found: res[bool, fail.Fail] = env_prefix(alloc, entry, prefixes[i]);
        if (sel res_found.err) { ret res_found; }
        if (res_found.ok)      { ret res_found; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun inherits_env(alloc: *A.Allocator, entry: *Unit, config_override: bool) res[bool, fail.Fail] {
    val res_family: res[bool, fail.Fail] = env_prefix(alloc, entry, "GIT_");
    if (sel res_family.err) { ret res[bool, fail.Fail].err{res_family.err}; }
    if (!res_family.ok)     { ret res[bool, fail.Fail].ok{true}; }
    val res_config: res[bool, fail.Fail] = env_names_config(alloc, entry);
    if (sel res_config.err) { ret res[bool, fail.Fail].err{res_config.err}; }
    if (res_config.ok)      { ret res[bool, fail.Fail].ok{!config_override}; }
    # a ceiling only narrows git's search for a repository, so the user's still holds
    var allowed: [6]str = [6]str{"GIT_CONFIG_GLOBAL=", "GIT_CONFIG_SYSTEM=", "GIT_CONFIG_NOSYSTEM=", "GIT_ATTR_NOSYSTEM=", "GIT_CEILING_DIRECTORIES=", "GIT_CONFIG_PARAMETERS="};
    var count:   usize  = 6;
    if (config_override) { count = 5; }
    var i: usize = 0;
    for (i < count) {
        val res_found: res[bool, fail.Fail] = env_prefix(alloc, entry, allowed[i]);
        if (sel res_found.err) { ret res_found; }
        if (res_found.ok)      { ret res_found; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# whether two environments are one: both inherited, or the same given array
fun same_environment(left: exec.Environment, right: exec.Environment) bool {
    if (sel left.given) {
        if (sel right.given) { ret left.given == right.given; }
        ret false;
    }
    ret sel right.inherit;
}

# git's environment over `environ`, with `extras` layered on top. the inherited
# entries stay in native units, so a variable with no UTF-8 spelling reaches git
fun environment(alloc: *A.Allocator, environ: exec.Environment, extras: **u8) res[host_environment.Strings, fail.Fail] {
    var override: bool  = false;
    var i:        usize = 0;
    for (extras != nil && extras[i] != nil) {
        val res_entry_text: res[host_environment.Entry, fail.Fail] = host_environment.entry_text(alloc, extras[i]::str);
        if (sel res_entry_text.err) { ret res[host_environment.Strings, fail.Fail].err{res_entry_text.err}; }
        var extra:      host_environment.Entry = res_entry_text.ok;
        val res_config: res[bool, fail.Fail]   = env_names_config(alloc, extra.units);
        host_environment.entry_dnit(alloc, ?extra);
        if (sel res_config.err) { ret res[host_environment.Strings, fail.Fail].err{res_config.err}; }
        if (res_config.ok)      { override = true; }
        i = i + 1;
    }
    val res_captured: res[host_environment.Environment, fail.Fail] = host_environment.capture(alloc, environ);
    if (sel res_captured.err) { ret res[host_environment.Strings, fail.Fail].err{res_captured.err}; }
    var values: host_environment.Environment = res_captured.ok;
    fin { host_environment.dnit(?values); }
    i = 0;
    for (i < values.entries.len) {
        val res_keep: res[bool, fail.Fail] = inherits_env(alloc, values.entries.data[i].units, override);
        if (sel res_keep.err) { ret res[host_environment.Strings, fail.Fail].err{res_keep.err}; }
        if (res_keep.ok)      { i = i + 1; }
        or                    { host_environment.remove(?values, i); }
    }
    val err_locks: err[fail.Fail] = host_environment.put(?values, "GIT_OPTIONAL_LOCKS", "0", true);
    if (sel err_locks.err) { ret res[host_environment.Strings, fail.Fail].err{err_locks.err}; }
    val err_prompt: err[fail.Fail] = host_environment.put(?values, "GIT_TERMINAL_PROMPT", "0", true);
    if (sel err_prompt.err) { ret res[host_environment.Strings, fail.Fail].err{err_prompt.err}; }
    i = 0;
    for (extras != nil && extras[i] != nil) {
        val res_entry_text: res[host_environment.Entry, fail.Fail] = host_environment.entry_text(alloc, extras[i]::str);
        if (sel res_entry_text.err) { ret res[host_environment.Strings, fail.Fail].err{res_entry_text.err}; }
        var extra:    host_environment.Entry = res_entry_text.ok;
        val res_keep: res[bool, fail.Fail]   = inherits_env(alloc, extra.units, false);
        if (sel res_keep.err) {
            host_environment.entry_dnit(alloc, ?extra);
            ret res[host_environment.Strings, fail.Fail].err{res_keep.err};
        }
        if (res_keep.ok) {
            val err_added: err[fail.Fail] = host_environment.put_owned(?values, extra, true);
            if (sel err_added.err) { ret res[host_environment.Strings, fail.Fail].err{err_added.err}; }
        }
        or { host_environment.entry_dnit(alloc, ?extra); }
        i = i + 1;
    }
    ret host_environment.to_strings(?values);
}

fun command_text(alloc: *A.Allocator, args: **u8) res[str, std_format.FormatError] {
    val res_first: res[str, std_format.FormatError] = std_format.sprint(alloc, "git");
    if (sel res_first.err) { ret res_first; }
    var text: str   = res_first.ok;
    var i:    usize = 0;
    for (args[i] != nil) {
        val res_longer: res[str, std_format.FormatError] = std_format.sprint(alloc, "{} {}", text, args[i]::str);
        str_free(alloc, text);
        if (sel res_longer.err) { ret res_longer; }
        text = res_longer.ok;
        i    = i + 1;
    }
    ret res[str, std_format.FormatError].ok{text};
}

# the failure of a git command names the command, the directory it ran in, how it ended,
# and what git printed
fun failure(alloc: *A.Allocator, child: *subprocess.OwnedSubprocess, args: **u8, dir: str,
    terminal: subprocess.SubprocessTerminal) fail.Fail {
    val res_command: res[str, std_format.FormatError] = command_text(alloc, args);
    if (sel res_command.err) { ret fail.format_refused(res_command.err); }
    fin { str_free(alloc, res_command.ok); }
    val ran:   fail.Op = fail.Op{verb: "run", path: res_command.ok, link: "in", other: dir};
    var ended: str     = "it did not exit normally";
    if (terminal.kind == subprocess.STATE_EXITED) {
        val res_sprint: res[str, std_format.FormatError] = std_format.sprint(alloc, "it exited with status {}", terminal.code);
        if (sel res_sprint.err) { ret fail.format_refused(res_sprint.err); }
        ended = res_sprint.ok;
    }
    val res_output: res[Bytes, fail.Fail] = captured_bytes(alloc, child, true);
    if (sel res_output.err) { ret fail.refusal(alloc, diagnostic_kind.GIT_COMMAND, ran, fail.Cause.text{ended}); }
    var bytes: Bytes = res_output.ok;
    fin { bytes_dnit(alloc, ?bytes); }
    var start: usize = 0;
    for (start < bytes.len && (bytes.data[start] == '\n' || bytes.data[start] == '\r' || bytes.data[start] == ' ')) { start = start + 1; }
    if (start == bytes.len || str_len(bytes.data::str) != bytes.len) { ret fail.refusal(alloc, diagnostic_kind.GIT_COMMAND, ran, fail.Cause.text{ended}); }
    val res_full: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}, and printed {}", ended, (?bytes.data[start])::str);
    if (sel res_full.err) { ret fail.refusal(alloc, diagnostic_kind.GIT_COMMAND, ran, fail.Cause.text{ended}); }
    ret fail.refusal(alloc, diagnostic_kind.GIT_COMMAND, ran, fail.Cause.text{res_full.ok});
}

# the failure of a git command an interrupt stopped, or kept from starting
fun interrupted(alloc: *A.Allocator, args: **u8, dir: str) fail.Fail {
    val res_command: res[str, std_format.FormatError] = command_text(alloc, args);
    if (sel res_command.err) { ret fail.format_refused(res_command.err); }
    fin { str_free(alloc, res_command.ok); }
    ret fail.refusal(alloc, diagnostic_kind.GIT_COMMAND, fail.Op{verb: "run", path: res_command.ok, link: "in", other: dir}, fail.Cause.text{"the command was interrupted"});
}

fun run_capture(alloc: *A.Allocator, gi: *Inspector, argv: **u8, shown: **u8, trim_line_end: bool, extra_env: **u8, stdin_fd: usize, capture_stderr: bool) res[Bytes, fail.Fail] {
    val res_ran: res[opt[Bytes], fail.Fail] = run(alloc, gi, argv, shown, trim_line_end, extra_env, stdin_fd, capture_stderr, false);
    if (sel res_ran.err)     { ret res[Bytes, fail.Fail].err{res_ran.err}; }
    if (sel res_ran.ok.some) { ret res[Bytes, fail.Fail].ok{res_ran.ok.some}; }
    ret res[Bytes, fail.Fail].err{fail.message("git: a run that fails on a refused exit answered none")};
}

# run git and capture its output: none when it exits refusing and `quiet_exit` asks that
# exit answered rather than failed, so a question whose answer is the exit can ask it
fun run(alloc: *A.Allocator, gi: *Inspector, argv: **u8, shown: **u8, trim_line_end: bool, extra_env: **u8, stdin_fd: usize, capture_stderr: bool,
    quiet_exit: bool) res[opt[Bytes], fail.Fail] {
    if (interrupt.taken()) { ret res[opt[Bytes], fail.Fail].err{interrupted(alloc, shown, argv_dir(argv))}; }
    val res_capture: res[str, fail.Fail] = scratch.path(alloc, "capture");
    if (sel res_capture.err) { ret res[opt[Bytes], fail.Fail].err{res_capture.err}; }

    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    var captured:    bool                       = false;
    val res_ran:     res[opt[Bytes], fail.Fail] = run_captured(alloc, gi, res_capture.ok, ?child, ?captured, argv, shown, trim_line_end, extra_env, stdin_fd, capture_stderr, quiet_exit);
    val err_cleaned: err[fail.Fail]             = capture_dnit(alloc, res_capture.ok, ?child, captured);
    if (sel err_cleaned.err) {
        if (sel res_ran.err) { ret res[opt[Bytes], fail.Fail].err{fail.with_secondary(alloc, res_ran.err, err_cleaned.err)}; }
        if (sel res_ran.ok.some) {
            var answered: Bytes = res_ran.ok.some;
            bytes_dnit(alloc, ?answered);
        }
        ret res[opt[Bytes], fail.Fail].err{err_cleaned.err};
    }
    ret res_ran;
}

# `run` once its capture file is made: git spawned, waited on and its output read
# ---
# captured: set once the capture is finished, so its release is owed
fun run_captured(alloc: *A.Allocator, gi: *Inspector, capture: str, child: *subprocess.OwnedSubprocess, captured: *bool,
    argv: **u8, shown: **u8, trim_line_end: bool, extra_env: **u8, stdin_fd: usize, capture_stderr: bool, quiet_exit: bool) res[opt[Bytes], fail.Fail] {
    if (!argv_reads_only(argv)) { trees_dnit(gi); }
    var shared: bool = extra_env == nil && gi.alloc != nil;
    if (shared && gi.env_ready && !same_environment(gi.env_inherited, gi.inherited_env)) {
        host_environment.strings_dnit(gi.alloc, ?gi.env);
        gi.env_ready = false;
    }
    if (shared && !gi.env_ready) {
        val res_built: res[host_environment.Strings, fail.Fail] = environment(gi.alloc, gi.inherited_env, nil);
        if (sel res_built.err) { ret res[opt[Bytes], fail.Fail].err{res_built.err}; }
        gi.env           = res_built.ok;
        gi.env_inherited = gi.inherited_env;
        gi.env_ready     = true;
    }
    var git_env: host_environment.Strings;
    if (shared) { git_env = gi.env; }
    or {
        val res_env: res[host_environment.Strings, fail.Fail] = environment(alloc, gi.inherited_env, extra_env);
        if (sel res_env.err) { ret res[opt[Bytes], fail.Fail].err{res_env.err}; }
        git_env = res_env.ok;
    }
    fin {
        if (!shared) { host_environment.strings_dnit(alloc, ?git_env); }
    }
    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.stdin          = stdin_fd;
    options.capture        = capture;
    options.capture_stderr = capture_stderr;
    options.capture_limit  = 1048576;
    val dir:              str                   = argv_dir(argv);
    val err_spawn_native: err[subprocess.Error] = subprocess.spawn_native(alloc, child, gi.program, argv, exec.NativeEnvironment.given{git_env.items}, options);
    if (sel err_spawn_native.err) { ret res[opt[Bytes], fail.Fail].err{subprocess.refusal(alloc, diagnostic_kind.GIT_COMMAND, "run", err_spawn_native.err, dir)}; }
    # the scope is cancelled by a caught interrupt, which stops git before the scratch is released
    var scope: sync_cancel.Scope;
    sync_cancel.make_root(?scope, opt[time.Instant].none{});
    val res_wait: res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(alloc, child, 1, ?scope);
    # a root scope made here holds no child, registration or waiter once the wait returns, so destroy cannot refuse
    sync_cancel.dnit(?scope);
    if (sel res_wait.err) {
        subprocess.abandon_capture(child);
        ret res[opt[Bytes], fail.Fail].err{subprocess.refusal(alloc, diagnostic_kind.GIT_COMMAND, "wait for", res_wait.err, dir)};
    }
    if (interrupt.taken()) {
        subprocess.abandon_capture(child);
        ret res[opt[Bytes], fail.Fail].err{interrupted(alloc, shown, dir)};
    }
    val terminal:           subprocess.SubprocessTerminal                     = child.terminal;
    val res_finish_capture: res[subprocess.CaptureIoResult, subprocess.Error] = subprocess.finish_capture(alloc, child, true);
    if (sel res_finish_capture.err) { ret res[opt[Bytes], fail.Fail].err{subprocess.refusal(alloc, diagnostic_kind.GIT_COMMAND, "read the output of", res_finish_capture.err, dir)}; }
    val cap: subprocess.CaptureIoResult = res_finish_capture.ok;
    @captured = true;
    if (cap.read_failed || cap.write_failed || cap.close_failed || cap.short_read || cap.truncated) {
        ret res[opt[Bytes], fail.Fail].err{fail.refusal(alloc, diagnostic_kind.GIT_COMMAND, fail.Op{verb: "capture all of the git output in", role: CAPTURE_ROLE, path: capture}, fail.Cause.text{"the capture was cut short"})};
    }
    if (terminal.kind != subprocess.STATE_EXITED || terminal.code != 0) {
        if (quiet_exit) { ret res[opt[Bytes], fail.Fail].ok{opt[Bytes].none{}}; }
        ret res[opt[Bytes], fail.Fail].err{failure(alloc, child, shown, dir, terminal)};
    }
    val res_bytes: res[Bytes, fail.Fail] = captured_bytes(alloc, child, trim_line_end);
    if (sel res_bytes.err) { ret res[opt[Bytes], fail.Fail].err{res_bytes.err}; }
    ret res[opt[Bytes], fail.Fail].ok{opt[Bytes].some{res_bytes.ok}};
}

# the subcommand after git's leading `-c <k=v>` and `-C <dir>` options
fun argv_subcommand(argv: **u8) str {
    var i: usize = 1;
    for (argv[i] != nil && (str_equals(argv[i]::str, "-c") || str_equals(argv[i]::str, "-C"))) {
        if (argv[i + 1] == nil) { ret ""; }
        i = i + 2;
    }
    if (argv[i] == nil) { ret ""; }
    ret argv[i]::str;
}

# the directory git's leading `-C <dir>` option runs it in, nil when it names none
fun argv_dir(argv: **u8) str {
    var dir: str   = nil;
    var i:   usize = 1;
    for (argv[i] != nil && (str_equals(argv[i]::str, "-c") || str_equals(argv[i]::str, "-C"))) {
        if (argv[i + 1] == nil)             { ret dir; }
        if (str_equals(argv[i]::str, "-C")) { dir = argv[i + 1]::str; }
        i = i + 2;
    }
    ret dir;
}

# whether a git command leaves every checkout's HEAD and tree where they were
fun argv_reads_only(argv: **u8) bool {
    val sub: str = argv_subcommand(argv);
    ret str_equals(sub, "ls-tree") || str_equals(sub, "rev-parse") || str_equals(sub, "status")
        || str_equals(sub, "ls-files") || str_equals(sub, "cat-file") || str_equals(sub, "config");
}

pub fun query_capture(alloc: *A.Allocator, gi: *Inspector, dir: str, args: *str, count: usize,
    trim_line_end: bool, extra_env: **u8, stdin_fd: usize, capture_stderr: bool) res[Bytes, fail.Fail] {
    val res_allocate: res[**u8, A.Error] = A.allocate[*u8](alloc, count + 8);
    if (sel res_allocate.err) { ret res[Bytes, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val argv: **u8 = res_allocate.ok;
    argv[0] = gi.program::*u8;
    argv[1] = "-c";
    argv[2] = "core.fsmonitor=false";
    argv[3] = "-c";
    argv[4] = "core.untrackedCache=false";
    argv[5] = "-C";
    argv[6] = dir::*u8;
    var i: usize = 0;
    for (i < count) {
        argv[i + 7] = args[i]::*u8;
        i           = i + 1;
    }
    argv[count + 7] = nil;
    val res_run_capture: res[Bytes, fail.Fail] = run_capture(alloc, gi, argv, ?argv[7], trim_line_end, extra_env, stdin_fd, capture_stderr);
    A.deallocate[*u8](alloc, argv, count + 8);
    ret res_run_capture;
}

fun query_mode(alloc: *A.Allocator, gi: *Inspector, dir: str, args: *str, count: usize,
    trim_line_end: bool, extra_env: **u8) res[str, fail.Fail] {
    val res_query_capture: res[Bytes, fail.Fail] = query_capture(alloc, gi, dir, args, count, trim_line_end, extra_env, system_os.INVALID_HANDLE, true);
    if (sel res_query_capture.err) { ret res[str, fail.Fail].err{res_query_capture.err}; }
    var bytes: Bytes = res_query_capture.ok;
    if (str_len(bytes.data::str) != bytes.len) {
        bytes_dnit(alloc, ?bytes);
        ret res[str, fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git text output contains an embedded nul byte")};
    }
    ret res[str, fail.Fail].ok{bytes.data::str};
}

pub fun query(alloc: *A.Allocator, gi: *Inspector, dir: str, args: *str, count: usize) res[str, fail.Fail] {
    ret query_mode(alloc, gi, dir, args, count, true, nil);
}

pub fun query_raw(alloc: *A.Allocator, gi: *Inspector, dir: str, args: *str, count: usize) res[str, fail.Fail] {
    ret query_mode(alloc, gi, dir, args, count, false, nil);
}

pub fun op(alloc: *A.Allocator, gi: *Inspector, dir: str, args: *str, count: usize, extra_env: **u8) res[str, fail.Fail] {
    ret query_mode(alloc, gi, dir, args, count, true, extra_env);
}

fun cmp_entry(a: *Entry, b: *Entry) i64 {
    ret str_compare(a.path, b.path);
}

# list a checkout's committed tree once: `<mode> <path>` records, nul-terminated
fun tree_load(s: *session.Session, gi: *Inspector, alias: str, git_dir: str) res[usize, fail.Fail] {
    var args: [6]str;
    args[0] = "ls-tree";
    args[1] = "-r";
    args[2] = "-t";
    args[3] = "-z";
    args[4] = "--full-tree";
    args[5] = "--format=%(objectmode) %(path)";
    var argv: [7]str;
    var k:    usize = 0;
    for (k < 6) {
        argv[k] = args[k];
        k       = k + 1;
    }
    argv[6] = "HEAD";
    val res_listed: res[Bytes, fail.Fail] = query_capture(gi.alloc, gi, git_dir, ?argv[0], 7, false, nil, system_os.INVALID_HANDLE, true);
    if (sel res_listed.err) {
        val res_sprint: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
            "dependency '{}' has a nested gitlink that cannot be verified ({})", alias, fail.describe(res_listed.err));
        if (sel res_sprint.err) { ret res[usize, fail.Fail].err{res_listed.err}; }
        ret res[usize, fail.Fail].err{fail.owning(fail.with_text(res_listed.err, res_sprint.ok))};
    }
    var bytes: Bytes = res_listed.ok;
    fin { bytes_dnit(gi.alloc, ?bytes); }
    val res_dir: res[str, types_string.StrError] = str_copy_slice(gi.alloc, git_dir, 0, str_len(git_dir));
    if (sel res_dir.err) { ret res[usize, fail.Fail].err{fail.message(fail.str_text(res_dir.err))}; }
    var tree: Tree = Tree{dir: res_dir.ok, entries: collections_vector.init[Entry](gi.alloc)};
    var ok:   bool = false;
    fin {
        if (!ok) { tree_dnit(gi.alloc, ?tree); }
    }
    var at: usize = 0;
    for (at < bytes.len) {
        var end: usize = at;
        for (end < bytes.len && bytes.data[end] != 0) { end = end + 1; }
        var space: usize = at;
        for (space < end && bytes.data[space] != ' ') { space = space + 1; }
        if (space == end) { ret res[usize, fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git tree listing has a malformed record")}; }
        val res_mode: res[str, types_string.StrError] = str_copy_slice(gi.alloc, (?bytes.data[at])::str, 0, space - at);
        if (sel res_mode.err) { ret res[usize, fail.Fail].err{fail.message(fail.str_text(res_mode.err))}; }
        var moved: bool = false;
        fin {
            if (!moved) { str_free(gi.alloc, res_mode.ok); }
        }
        val res_path: res[str, types_string.StrError] = str_copy_slice(gi.alloc, (?bytes.data[space + 1])::str, 0, end - space - 1);
        if (sel res_path.err) { ret res[usize, fail.Fail].err{fail.message(fail.str_text(res_path.err))}; }
        fin {
            if (!moved) { str_free(gi.alloc, res_path.ok); }
        }
        val res_pushed_entry: res[usize, A.Error] = collections_vector.push[Entry](?tree.entries, Entry{path: res_path.ok, mode: res_mode.ok});
        if (sel res_pushed_entry.err) { ret res[usize, fail.Fail].err{fail.refused(res_pushed_entry.err)}; }
        moved = true;
        at    = end + 1;
    }
    # git orders a tree as if its name ended in a separator, so the listing is re-sorted plainly
    sort.sort_by[Entry](tree.entries.data, tree.entries.len, cmp_entry);
    if (!gi.trees_ready) {
        gi.trees       = collections_vector.init[Tree](gi.alloc);
        gi.trees_ready = true;
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[Tree](?gi.trees, tree);
    if (sel res_pushed.err) { ret res[usize, fail.Fail].err{fail.refused(res_pushed.err)}; }
    ok = true;
    ret res[usize, fail.Fail].ok{gi.trees.len - 1};
}

fun tree_for(s: *session.Session, gi: *Inspector, alias: str, git_dir: str) res[usize, fail.Fail] {
    if (gi.trees_ready) {
        var i: usize = 0;
        for (i < gi.trees.len) {
            if (str_equals(gi.trees.data[i].dir, git_dir)) { ret res[usize, fail.Fail].ok{i}; }
            i = i + 1;
        }
    }
    ret tree_load(s, gi, alias, git_dir);
}

# the committed mode of `<prefix><rel>` at HEAD, or "" when HEAD has no such entry
pub fun path_mode(s: *session.Session, gi: *Inspector, alias: str,
    git_dir: str, git_prefix: str, rel: str) res[str, fail.Fail] {
    val res_tree: res[usize, fail.Fail] = tree_for(s, gi, alias, git_dir);
    if (sel res_tree.err) { ret res[str, fail.Fail].err{res_tree.err}; }
    val tree:     *Tree                            = ?gi.trees.data[res_tree.ok];
    val res_path: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc, "{}{}", git_prefix, rel);
    if (sel res_path.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(res_path.err))}; }
    var want: str = res_path.ok;
    fin { str_free(s.build_alloc, want); }
    # a directory is asked for with a trailing separator; the listing names it without one
    var n: usize = str_len(want);
    for (n > 0 && want[n - 1] == '/') { n = n - 1; }
    want[n] = 0;
    var lo: usize = 0;
    var hi: usize = tree.entries.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        val c:   i64   = str_compare(tree.entries.data[mid].path, want);
        if (c == 0) {
            val mode:       str                             = tree.entries.data[mid].mode;
            val res_copied: res[str, types_string.StrError] = str_copy_slice(s.build_alloc, mode, 0, str_len(mode));
            if (sel res_copied.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(res_copied.err))}; }
            ret res[str, fail.Fail].ok{res_copied.ok};
        }
        if (c < 0) { lo = mid + 1; }
        or         { hi = mid; }
    }
    val res_empty: res[str, types_string.StrError] = str_copy_slice(s.build_alloc, "", 0, 0);
    if (sel res_empty.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(res_empty.err))}; }
    ret res[str, fail.Fail].ok{res_empty.ok};
}

# an inspector that resolves git on first use, its processes inheriting `environ`
pub fun inspector_pending(environ: exec.Environment) Inspector {
    ret Inspector{program: nil, inherited_env: environ};
}

# start a pending inspector; one already started is left as it is
pub fun inspector_require(alloc: *A.Allocator, gi: *Inspector) err[fail.Fail] {
    if (!str_is_empty(gi.program)) { ret err[fail.Fail].ok{}; }
    val res_inspector_init: res[Inspector, fail.Fail] = inspector_init(alloc, gi.inherited_env);
    if (sel res_inspector_init.err) { ret err[fail.Fail].err{res_inspector_init.err}; }
    @gi = res_inspector_init.ok;
    ret err[fail.Fail].ok{};
}

pub fun query_named(s: *session.Session, gi: *Inspector, alias: str, dir: str,
    args: *str, count: usize, fact: str) res[str, fail.Fail] {
    val res_query: res[str, fail.Fail] = query(s.build_alloc, gi, dir, args, count);
    if (sel res_query.ok) { ret res_query; }
    val res_sprint: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
        "cannot verify {} of dependency '{}' ({})", fact, alias, fail.describe(res_query.err));
    if (sel res_sprint.err) { ret res[str, fail.Fail].err{res_query.err}; }
    ret res[str, fail.Fail].err{fail.owning(fail.with_text(res_query.err, res_sprint.ok))};
}

pub fun require_root(s: *session.Session, gi: *Inspector, alias: str, dir: str,
    subject: str) err[fail.Fail] {
    var inside_args: [2]str;
    inside_args[0] = "rev-parse";
    inside_args[1] = "--is-inside-work-tree";
    val res_inside: res[str, fail.Fail] = query_named(s, gi, alias, dir, ?inside_args[0], 2, subject);
    if (sel res_inside.err) { ret err[fail.Fail].err{res_inside.err}; }
    val inside: str = res_inside.ok;
    fin { str_free(s.build_alloc, inside); }
    if (!str_equals(inside, "true")) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_NO_REPOSITORY, "dependency declaring package is not a Git work tree")};
    }

    ret err[fail.Fail].ok{};
}

pub val AUTHORITY_REPO:   u8 = 0;
pub val AUTHORITY_NESTED: u8 = 1;

pub fun project_root_authority(s: *session.Session, gi: *Inspector, alias: str,
    project_root: str) res[u8, fail.Fail] {
    val res_marker: res[str, fail.Fail] = compile_load.join_path(s.build_alloc, project_root, ".git");
    if (sel res_marker.err) { ret res[u8, fail.Fail].err{res_marker.err}; }
    val marker: str = res_marker.ok;
    fin { str_free(s.build_alloc, marker); }
    var st:       system_os.stat_t;
    val observed: i64 = system_os.stat_path(system_os.working_dir(), marker, ?st, system_os.AT_SYMLINK_NOFOLLOW);
    if (system_os.error_kind(observed) == io_error.NOT_FOUND) { ret res[u8, fail.Fail].ok{AUTHORITY_NESTED}; }
    if (observed < 0)                                         { ret res[u8, fail.Fail].err{fail.refusal(s.build_alloc, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: "the project's git marker", path: marker}, fail.Cause.native{observed})}; }
    val err_required: err[fail.Fail] = inspector_require(s.build_alloc, gi);
    if (sel err_required.err) { ret res[u8, fail.Fail].err{err_required.err}; }
    var inside_args: [2]str;
    inside_args[0] = "rev-parse";
    inside_args[1] = "--is-inside-work-tree";
    val res_inside: res[str, fail.Fail] = query(s.build_alloc, gi, project_root, ?inside_args[0], 2);
    if (sel res_inside.err) {
        val res_sprint: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
            "dependency '{}' cannot be verified, because project root '{}' is not inside a Git repository",
            alias, project_root);
        if (sel res_sprint.err) { ret res[u8, fail.Fail].err{fail.format_refused(res_sprint.err)}; }
        ret res[u8, fail.Fail].err{fail.user(diagnostic_kind.DEP_NO_REPOSITORY, res_sprint.ok)};
    }
    val inside:  str  = res_inside.ok;
    val is_tree: bool = str_equals(inside, "true");
    str_free(s.build_alloc, inside);
    if (!is_tree) {
        val res_sprint: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
            "dependency '{}' cannot be verified, because project root '{}' is not inside a Git repository",
            alias, project_root);
        if (sel res_sprint.err) { ret res[u8, fail.Fail].err{fail.format_refused(res_sprint.err)}; }
        ret res[u8, fail.Fail].err{fail.user(diagnostic_kind.DEP_NO_REPOSITORY, res_sprint.ok)};
    }
    val res_prefix: res[str, fail.Fail] = declaring_prefix(s, gi, alias, project_root);
    if (sel res_prefix.err) { ret res[u8, fail.Fail].err{res_prefix.err}; }
    val prefix: str  = res_prefix.ok;
    val nested: bool = !str_is_empty(prefix);
    str_free(s.build_alloc, prefix);
    if (nested) { ret res[u8, fail.Fail].ok{AUTHORITY_NESTED}; }
    ret res[u8, fail.Fail].ok{AUTHORITY_REPO};
}

pub fun declaring_prefix(s: *session.Session, gi: *Inspector, alias: str, dir: str) res[str, fail.Fail] {
    var args: [2]str;
    args[0] = "rev-parse";
    args[1] = "--show-prefix";
    ret query_named(s, gi, alias, dir, ?args[0], 2, "declaring package identity");
}

pub fun object_id_valid(id: str) bool {
    val n: usize = str_len(id);
    if (n != 40 && n != 64) { ret false; }
    var i: usize = 0;
    for (i < n) {
        val c: u8 = id[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun index_entry_field(s: *session.Session, gi: *Inspector, alias: str, root: str,
    rel: str, field: usize, fact: str) res[str, fail.Fail] {
    var args: [4]str;
    args[0] = "ls-files";
    args[1] = "--stage";
    args[2] = "--";
    args[3] = rel;
    val res_query_named: res[str, fail.Fail] = query_named(s, gi, alias, root, ?args[0], 4, fact);
    if (sel res_query_named.err) { ret res[str, fail.Fail].err{res_query_named.err}; }
    val line:    str   = res_query_named.ok;
    val n:       usize = str_len(line);
    var start_i: usize = 0;
    var f:       usize = 0;
    for (f < field) {
        for (start_i < n && line[start_i] != ' ') { start_i = start_i + 1; }
        if (start_i < n) { start_i = start_i + 1; }
        f = f + 1;
    }
    var end_i: usize = start_i;
    for (end_i < n && line[end_i] != ' ' && line[end_i] != '\t') { end_i = end_i + 1; }
    val res_out: res[str, types_string.StrError] = str_copy_slice(s.build_alloc, line, start_i, end_i - start_i);
    str_free(s.build_alloc, line);
    if (sel res_out.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(res_out.err))}; }
    ret res[str, fail.Fail].ok{res_out.ok};
}

fun porcelain_has_worktree_change(text: str) bool {
    val n: usize = str_len(text);
    var i: usize = 0;
    for (i < n) {
        var j: usize = i;
        for (j < n && text[j] != '\n') { j = j + 1; }
        if (j - i >= 2 && text[i + 1] != ' ') { ret true; }
        i = j + 1;
    }
    ret false;
}

pub fun require_matches_index(s: *session.Session, gi: *Inspector, alias: str, root: str,
    rel: str, subject: str) err[fail.Fail] {
    var args: [5]str;
    args[0] = "status";
    args[1] = "--porcelain=v1";
    args[2] = "--untracked-files=all";
    args[3] = "--";
    args[4] = rel;
    val res_query_raw: res[str, fail.Fail] = query_raw(s.build_alloc, gi, root, ?args[0], 5);
    if (sel res_query_raw.err) {
        val res_query_named: res[str, fail.Fail] = query_named(s, gi, alias, root, ?args[0], 5, subject);
        if (sel res_query_named.err) { ret err[fail.Fail].err{res_query_named.err}; }
        str_free(s.build_alloc, res_query_named.ok);
        ret err[fail.Fail].ok{};
    }
    val out:   str  = res_query_raw.ok;
    val dirty: bool = porcelain_has_worktree_change(out);
    str_free(s.build_alloc, out);
    if (!dirty) { ret err[fail.Fail].ok{}; }
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
        "dependency '{}' has '{}' in the working tree, which does not match what is staged", alias, rel);
    if (sel res_msg.err) { ret err[fail.Fail].err{fail.format_refused(res_msg.err)}; }
    ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_UNSTAGED, res_msg.ok)};
}

pub fun require_tracked(s: *session.Session, gi: *Inspector, alias: str, root: str,
    rel: str, subject: str) err[fail.Fail] {
    var args: [4]str;
    args[0] = "ls-files";
    args[1] = "--";
    args[2] = rel;
    args[3] = "";
    val res_query_named: res[str, fail.Fail] = query_named(s, gi, alias, root, ?args[0], 3, subject);
    if (sel res_query_named.err) { ret err[fail.Fail].err{res_query_named.err}; }
    val out:     str  = res_query_named.ok;
    val present: bool = !str_is_empty(out);
    str_free(s.build_alloc, out);
    if (present) { ret err[fail.Fail].ok{}; }
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(s.build_alloc,
        "dependency '{}' has '{}' unstaged. run `mach dep pull <path>` for project '{}'", alias, rel, root);
    if (sel res_msg.err) { ret err[fail.Fail].err{fail.format_refused(res_msg.err)}; }
    ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_UNSTAGED, res_msg.ok)};
}

# whether `dir` lies inside a git work tree: git answers by its exit, so a refusing exit is
# false, and a failure to run git or read its answer is the failure
pub fun is_work_tree(alloc: *A.Allocator, gi: *Inspector, dir: str) res[bool, fail.Fail] {
    val res_allocate: res[**u8, A.Error] = A.allocate[*u8](alloc, 10);
    if (sel res_allocate.err) { ret res[bool, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val argv: **u8 = res_allocate.ok;
    fin { A.deallocate[*u8](alloc, argv, 10); }
    argv[0] = gi.program::*u8;
    argv[1] = "-c";
    argv[2] = "core.fsmonitor=false";
    argv[3] = "-c";
    argv[4] = "core.untrackedCache=false";
    argv[5] = "-C";
    argv[6] = dir::*u8;
    argv[7] = "rev-parse";
    argv[8] = "--is-inside-work-tree";
    argv[9] = nil;
    val res_ran: res[opt[Bytes], fail.Fail] = run(alloc, gi, argv, ?argv[7], true, nil, system_os.INVALID_HANDLE, true, true);
    if (sel res_ran.err)     { ret res[bool, fail.Fail].err{res_ran.err}; }
    if (sel res_ran.ok.none) { ret res[bool, fail.Fail].ok{false}; }
    var answer: Bytes = res_ran.ok.some;
    fin { bytes_dnit(alloc, ?answer); }
    if (str_len(answer.data::str) != answer.len) {
        ret res[bool, fail.Fail].err{fail.environment(diagnostic_kind.GIT_OUTPUT_MALFORMED, "Git text output contains an embedded nul byte")};
    }
    ret res[bool, fail.Fail].ok{str_equals(answer.data::str, "true")};
}
