# closure: the walk every dependency command shares. it reads the root's declarations,
# then the declarations of each realized dependency, whether it was reached by a version
# range, a git ref or a path; the root's dep/ holds every identity once, and a version range
# any project in the closure declares is pinned there:
#
# - a range's pin is the pin the project records. for a repository root it is the root's own
#   gitlink at dep/<id>; for a subproject, a project in a subdirectory of a repository, it is
#   the gitlink the enclosing repository commits under the subproject's prefix. pull realizes
#   the pin on a fresh clone and restores a checkout that drifted from it, and update records
#   the moved pin. a subproject with no pin for a dependency gets a plain clone, as a project
#   outside any repository does
# - a range a dependency declares resolves with the root's own (mach dep add, mach dep
#   update), whether the dependency was reached by a ref or a path: when the root holds no
#   checkout of the identity yet, it is seeded by the dependency's own pin for it, update
#   --all moves it to the highest release every range admits, and a root declaration of the
#   same identity overrides it
# - a range with neither a pin nor a checkout under the root is refused with `run mach dep
#   update <root> <id>`, which pins it whether the root or a dependency declares it
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;
use toml_write:  toml.write;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source:     mach.base.source;
use compile_closure: mach.compile.closure;
use mach.session;

use mach.base.diagnostic;
use manifest_load:   mach.manifest.load;
use manifest_model:  mach.manifest.model;
use manifest_schema: mach.manifest.schema;
use mach.package;
use git_member:   mach.package.git.member;
use package_path: mach.package.path;
use package_pin:  mach.package.pin;
use mach.package.report;
use mach.package.resolver;
use package_source: mach.package.source;

# one operation on a project's dependencies: the session and storage it works in, the
# project root, the tables of the source and pin members, and where it reports. `releases`
# is the one table every resolution of the operation reads a url's releases from, so a url is
# listed and its manifests fetched once however many times the operation resolves; it is
# opened by the first resolution, and `releases_open` says whether it has been
pub rec Operation {
    s:             *session.Session;
    a:             *A.Allocator;
    root:          str;
    checkouts:     package_source.Checkouts;
    pins:          package_pin.Pin;
    rep:           *report.Report;
    releases:      package_source.Releases;
    releases_open: bool;
}

# open an operation on the project at `root`, which need not exist yet, released with `dnit`
pub fun init(s: *session.Session, a: *A.Allocator, root: str, rep: *report.Report) res[Operation, fail.Fail] {
    val res_opened: res[package_source.Checkouts, fail.Fail] = git_member.checkouts(s, rep);
    if (sel res_opened.err) { ret res[Operation, fail.Fail].err{res_opened.err}; }
    ret res[Operation, fail.Fail].ok{Operation{s: s, a: a, root: root, checkouts: res_opened.ok, pins: git_member.pin(s), rep: rep, releases_open: false}};
}

# release the operation; err names the releases table's scratch it could not remove, once the
# rest is released
pub fun dnit(op: *Operation) err[fail.Fail] {
    op.checkouts.close(op.checkouts.ctx);
    if (!op.releases_open) { ret err[fail.Fail].ok{}; }
    op.releases_open = false;
    ret op.releases.close(op.releases.ctx);
}

# `outcome` of the work an operation held, then the operation released: a failure to release
# it is the outcome when the work succeeded, and is reported beside it otherwise
pub fun ended(op: *Operation, outcome: err[fail.Fail]) err[fail.Fail] {
    val err_released: err[fail.Fail] = dnit(op);
    if (sel err_released.ok) { ret outcome; }
    if (sel outcome.ok)      { ret err_released; }
    ret err[fail.Fail].err{fail.with_secondary(op.a, outcome.err, err_released.err)};
}

# the releases table of the operation, opened by its first resolution as `walk` reads: offline
# or not, and announcing each url it reads from the network unless quiet. every later
# resolution of the operation reads the same table
pub fun releases(op: *Operation, walk: *Walk) res[*package_source.Releases, fail.Fail] {
    if (op.releases_open) { ret res[*package_source.Releases, fail.Fail].ok{?op.releases}; }
    var hears: *report.Report = op.rep;
    if (walk.quiet) { hears = nil; }
    val res_opened: res[package_source.Releases, fail.Fail] = git_member.releases(op.s, walk.offline, "", hears);
    if (sel res_opened.err) { ret res[*package_source.Releases, fail.Fail].err{res_opened.err}; }
    op.releases      = res_opened.ok;
    op.releases_open = true;
    ret res[*package_source.Releases, fail.Fail].ok{?op.releases};
}

# a further range declared for the identity of a request by another requirer: the closure
# keeps one request per identity, and every range on it takes part in resolution
rec RangeDecl {
    range:    str;
    requirer: str;
}

# one declared dependency of the closure. `via_release` marks a declaration read from a
# manifest reached through a release-selected edge, whose requirements the resolver reads
# itself from the chosen release; every other declaration is the closure's own. `seed` is the
# revision the declaring dependency's own pin holds for a range it declares, "" when it has
# none. `decl` is the request's selector as its manifest line spells it; `overrode` holds, on
# a root declaration by `ref` or `path`, every differing requirement of the same identity it
# replaced; `copied` is what realizing a path dependency did to its copy
pub rec Request {
    id:          str;
    url:         str;
    src_path:    str;
    ref:         str;
    version:     str;
    chain:       str;
    requirer:    str;
    root_decl:   bool;
    is_git:      bool;
    via_release: bool;
    seed:        str;
    effect:      str;
    also:        Vector[RangeDecl];
    decl:        str;
    overrode:    Vector[Overridden];
    copied:      u8;
}

# a requirement a root declaration replaced: `chain` asked for `asked`
pub rec Overridden {
    chain: str;
    asked: str;
}

pub val COPY_NONE:      u8 = 0;
pub val COPY_REFRESHED: u8 = 1;
pub val COPY_REUSED:    u8 = 2;

# how a closure walk reads a fixed git dependency: at the revision its selector picks,
# fetching one its checkout lacks unless `offline`. a branch is read at its pin, or at its
# fetched tip when the walk is an update that moves it: every one under `all`, or the
# identity `name` names. a walk that reads releases from the network says so first unless `quiet`
pub rec Walk {
    offline: bool;
    all:     bool;
    name:    str;
    quiet:   bool;
}

fun walk_moves(w: *Walk, id: str) bool {
    ret w.all || (w.name != nil && str_equals(w.name, id));
}

# a release-selected git dependency: its requirements are the chosen release's
pub fun selects_release(r: *Request) bool {
    ret r.is_git && is_ranged(r);
}

# a manifest reached through `parent` is read through a release when the parent was, or is one
fun reached_via_release(parent: *Request) bool {
    ret parent.via_release || selects_release(parent);
}

fun is_ranged(r: *Request) bool {
    ret r.version != nil && !str_is_empty(r.version);
}

# walk and realize the closure into `reqs`, the root's manifest read from `candidate` when
# it is not nil and otherwise from the project; `verify_only` realizes nothing and refuses a
# directory under dep/ outside the closure, where a realizing walk notes and retains it
# ---
# op:          the operation
# reqs:        receives the closure, which the caller frees
# quiet:       report no progress lines
# offline:     fetch nothing
# verify_only: change nothing
# candidate:   the root manifest's table, or nil to read it from the project
# picks:       the releases resolution chose, or nil
# ret:         err naming the first failure
pub fun realize(op: *Operation, reqs: *Vector[Request], quiet: bool, offline: bool, verify_only: bool,
    candidate: *toml_value.Table, picks: *Vector[resolver.Choice]) err[fail.Fail] {
    val a:        *A.Allocator       = op.a;
    val res_mode: res[u8, fail.Fail] = op.pins.mode(op.pins.ctx, op.root);
    if (sel res_mode.err) { ret err[fail.Fail].err{res_mode.err}; }
    val mode: u8 = res_mode.ok;

    val res_guard: res[bool, fail.Fail] = compile_closure.check_dep_root(a, op.root);
    if (sel res_guard.err) { ret err[fail.Fail].err{res_guard.err}; }

    var parsed: manifest_load.Doc;
    var mt:     *toml_value.Table = candidate;
    if (mt == nil) {
        val res_mt_path: res[str, A.Error] = types_path.join(a, op.root, manifest_load.MANIFEST_FILE);
        if (sel res_mt_path.err) { ret err[fail.Fail].err{fail.refused(res_mt_path.err)}; }
        val mt_path: str = res_mt_path.ok;
        fin { str_free(a, mt_path); }
        val res_parse_file: res[manifest_load.Doc, fail.Fail] = parse_file(a, op.s.sources, mt_path);
        if (sel res_parse_file.err) { ret err[fail.Fail].err{res_parse_file.err}; }
        parsed = res_parse_file.ok;
        mt     = ?parsed.table;
    }
    fin {
        if (candidate == nil) { manifest_load.doc_dnit(a, ?parsed); }
    }
    var complete: bool = false;
    fin {
        if (!complete) { effects(op, reqs); }
    }

    var root_id: str = key_text(mt, "project.id");
    if (str_is_empty(root_id)) { root_id = "(project)"; }

    val err_seed: err[fail.Fail] = enqueue(a, reqs, op.root, mt, root_id, true, false);
    if (sel err_seed.err) { ret err_seed; }
    apply_picks(a, reqs, picks);
    if (reqs.len == 0) {
        if (!quiet) { report.line(op.rep, "no dependencies"); }
        complete = true;
        ret strays(op, reqs, verify_only);
    }

    var i: usize = 0;
    for (i < reqs.len) {
        if (!verify_only) {
            val err_realized: err[fail.Fail] = ensure_realized(op, ?reqs.data[i], mode, quiet, offline);
            if (sel err_realized.err) { ret err_realized; }
        }
        val res_dep_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, reqs.data[i].id);
        if (sel res_dep_full.err) { ret err[fail.Fail].err{res_dep_full.err}; }
        val dep_full: str = res_dep_full.ok;
        fin { str_free(a, dep_full); }
        # a checkout cloned shallow holds none of what its selection is read by
        if (!verify_only && reqs.data[i].is_git) {
            val res_fetched: res[bool, fail.Fail] = op.checkouts.hydrate(op.checkouts.ctx, op.root, reqs.data[i].id, dep_full, reqs.data[i].ref,
                is_ranged(?reqs.data[i]), offline);
            if (sel res_fetched.err)      { ret err[fail.Fail].err{res_fetched.err}; }
            if (res_fetched.ok && !quiet) { report.linef(op.rep, a, "fetched the tags of {}", reqs.data[i].id); }
        }
        val res_is_dir: res[bool, io_error.Error] = fs.is_dir(dep_full);
        if (sel res_is_dir.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: "the dependency checkout", path: dep_full}, fail.Cause.io{res_is_dir.err})}; }
        if (!(res_is_dir.ok)) {
            val res_msg: res[str, std_format.FormatError] = std_format.sprint(a, "dependency '{}' is not realized at {}", reqs.data[i].id, dep_full);
            if (sel res_msg.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_UNREALIZED, "a dependency is not realized")}; }
            ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_UNREALIZED, res_msg.ok)};
        }
        val res_sub_path: res[str, A.Error] = types_path.join(a, dep_full, manifest_load.MANIFEST_FILE);
        if (sel res_sub_path.err) { ret err[fail.Fail].err{fail.refused(res_sub_path.err)}; }
        val sub_path: str = res_sub_path.ok;
        fin { str_free(a, sub_path); }
        val res_sub: res[manifest_load.Doc, fail.Fail] = parse_file(a, op.s.sources, sub_path);
        if (sel res_sub.err) { ret err[fail.Fail].err{res_sub.err}; }
        var sub: manifest_load.Doc = res_sub.ok;
        fin { manifest_load.doc_dnit(a, ?sub); }

        val declared:  str            = key_text(?sub.table, "project.id");
        val err_ident: err[fail.Fail] = package.check_dep_identity(op.s, reqs.data[i].id, declared);
        if (sel err_ident.err) { ret err_ident; }
        val err_nested: err[fail.Fail] = package.refuse_nested_realization(op.s, reqs.data[i].id, dep_full);
        if (sel err_nested.err) { ret err_nested; }

        val err_child: err[fail.Fail] = enqueue(a, reqs, dep_full, ?sub.table, reqs.data[i].chain, false, reached_via_release(?reqs.data[i]));
        if (sel err_child.err) { ret err_child; }
        apply_picks(a, reqs, picks);
        i = i + 1;
    }
    # verify reports the overrides its own resolution finds
    if (!verify_only) { note_overridden(op, reqs); }
    val err_strays: err[fail.Fail] = strays(op, reqs, verify_only);
    complete = sel err_strays.ok;
    ret err_strays;
}

# one note per requirement a root declaration overrode, beside the other notes, so neither
# --quiet nor a log that keeps only standard error drops it
fun note_overridden(op: *Operation, reqs: *Vector[Request]) {
    var i: usize = 0;
    for (i < reqs.len) {
        val r: *Request = ?reqs.data[i];
        i = i + 1;
        var k: usize = 0;
        for (k < r.overrode.len) {
            val o:        *Overridden         = ?r.overrode.data[k];
            val res_note: res[str, fail.Fail] = package.override_note(op.a, r.id, r.decl, o.chain, o.asked);
            k = k + 1;
            if (sel res_note.err) {
                report.fault(op.rep, res_note.err);
                cnt;
            }
            report.note(op.rep, res_note.ok);
            str_free(op.a, res_note.ok);
        }
    }
}

# a directory under dep/ outside the closure: verify refuses each one, and every other walk
# notes it and leaves it for explicit removal
fun strays(op: *Operation, reqs: *Vector[Request], verify_only: bool) err[fail.Fail] {
    val res_ids: res[Vector[str], fail.Fail] = package.realized_ids(op.a, op.root);
    if (sel res_ids.err) { ret err[fail.Fail].err{res_ids.err}; }
    var ids:     Vector[str] = res_ids.ok;
    var i:       usize       = 0;
    var refused: bool        = false;
    for (i < ids.len) {
        if (index(reqs, ids.data[i]) < 0) {
            if (verify_only) {
                val res_msg: res[str, std_format.FormatError] = std_format.sprint(op.a, "dep/{} is not in the dependency closure", ids.data[i]);
                if (sel res_msg.ok) { report.fault(op.rep, fail.user(diagnostic_kind.DEP_NOT_IN_CLOSURE, res_msg.ok)); }
                or                  { report.fault(op.rep, fail.user(diagnostic_kind.DEP_NOT_IN_CLOSURE, "a directory under dep/ is not in the dependency closure")); }
                refused = true;
            }
            or { report.notef(op.rep, op.a, "dep/{} is outside the dependency closure. the directory is kept for explicit removal", ids.data[i]); }
        }
        i = i + 1;
    }
    if (refused) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

# the command that pins and realizes a version-selected dependency with no checkout yet;
# pull's refusal and init's --no-deps hint both name it
pub fun pin_command(a: *A.Allocator, root: str, id: str) res[str, fail.Fail] {
    ret diagnostic.format(a, "mach dep update {} {}", root, id);
}

pub fun unpinned_refusal(a: *A.Allocator, root: str, id: str, version: str) res[str, fail.Fail] {
    val res_command: res[str, fail.Fail] = pin_command(a, root, id);
    if (sel res_command.err) { ret res_command; }
    ret diagnostic.format(a,
        "dependency '{}' selects releases by `version = \"{}\"` and has no pin yet. run `{}`", id, version, res_command.ok);
}

fun ensure_realized(op: *Operation, r: *Request, mode: u8, quiet: bool, offline: bool) err[fail.Fail] {
    if (r.is_git) {
        var effect: u8 = package_source.REALIZED_NOTHING;
        ret acquire(op, r, mode, false, quiet, offline, is_ranged(r) && str_is_empty(r.ref), ?effect);
    }
    val a:            *A.Allocator        = op.a;
    val res_dep_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, r.id);
    if (sel res_dep_full.err) { ret err[fail.Fail].err{res_dep_full.err}; }
    val dep_full: str = res_dep_full.ok;
    fin { str_free(a, dep_full); }

    # a path dependency has no pin, so every pull syncs its copy with the declared source
    val res_is_symlink: res[bool, io_error.Error] = fs.is_symlink(dep_full);
    if ((sel res_is_symlink.ok && res_is_symlink.ok)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_DIRECTORY, "the dependency checkout is a symlink and was left in place")}; }
    val res_realize: res[bool, fail.Fail] = package_path.realize(op.s, op.root, r.id, r.src_path, op.rep);
    if (sel res_realize.err) { ret err[fail.Fail].err{res_realize.err}; }
    var how: str = " (copy reused: it already matched its source)";
    r.copied = COPY_REUSED;
    if (res_realize.ok) {
        how      = " (copy refreshed from its source)";
        r.copied = COPY_REFRESHED;
        r.effect = "copied the local dependency source";
    }
    if (!quiet) { report.linef(op.rep, a, "realized {} from {}{}", r.id, r.src_path, how); }
    ret err[fail.Fail].ok{};
}

# acquire a git dependency's slot through the source and report what changed; `accept` is
# add taking an existing checkout, and `pinned_only` a range with no selector, which only a
# pin or an existing checkout realizes
pub fun acquire(op: *Operation, r: *Request, mode: u8, accept: bool, quiet: bool, offline: bool,
    pinned_only: bool, effect: *u8) err[fail.Fail] {
    var q: package_source.Acquisition = package_source.Acquisition{root: op.root, id: r.id, url: r.url, selector: r.ref, mode: mode,
        accept: accept, offline: offline, pinned_only: pinned_only};
    val res_realized: res[u8, fail.Fail] = op.checkouts.acquire(op.checkouts.ctx, ?q);
    if (sel res_realized.err)                                { ret err[fail.Fail].err{res_realized.err}; }
    if (res_realized.ok == package_source.REALIZED_UNPINNED) { ret err[fail.Fail].err{fail.user_of(diagnostic_kind.DEP_UNPINNED, unpinned_refusal(op.a, op.root, r.id, r.version))}; }
    @effect = res_realized.ok;
    if (res_realized.ok == package_source.REALIZED_NOTHING) { ret err[fail.Fail].ok{}; }

    val res_dep_full: res[str, fail.Fail] = package.dep_full_of(op.a, op.root, r.id);
    if (sel res_dep_full.err) { ret err[fail.Fail].err{res_dep_full.err}; }
    val dep_full: str = res_dep_full.ok;
    fin { str_free(op.a, dep_full); }
    var note: str = "";
    if (res_realized.ok == package_source.REALIZED_INITIALIZED) {
        r.effect = "initialized the recorded gitlink";
        note     = " (initialized the committed gitlink)";
    }
    or (res_realized.ok == package_source.REALIZED_PINNED) {
        r.effect = "checked out the recorded pin";
        note     = " (restored to the recorded pin)";
    }
    or (res_realized.ok == package_source.REALIZED_REGISTERED) {
        r.effect = "registered the recorded gitlink in .gitmodules";
        note     = " (registered the recorded gitlink)";
    }
    or (res_realized.ok == package_source.REALIZED_ADOPTED) {
        r.effect = "registered and staged the existing checkout";
        note     = " (registered the existing checkout)";
    }
    or         { r.effect = "realized the Git dependency"; }
    if (quiet) { ret err[fail.Fail].ok{}; }
    val res_head: res[str, fail.Fail] = op.checkouts.revision(op.checkouts.ctx, dep_full);
    if (sel res_head.err) { ret err[fail.Fail].err{res_head.err}; }
    report.linef(op.rep, op.a, "realized {} @ {}{}", r.id, res_head.ok, note);
    ret err[fail.Fail].ok{};
}

pub fun index(reqs: *Vector[Request], id: str) i64 {
    var i: usize = 0;
    for (i < reqs.len) {
        if (str_equals(reqs.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun request_dnit(a: *A.Allocator, request: *Request) {
    str_free(a, request.id);
    str_free(a, request.url);
    str_free(a, request.src_path);
    str_free(a, request.ref);
    if (request.version != nil) { str_free(a, request.version); }
    str_free(a, request.chain);
    str_free(a, request.requirer);
    if (request.seed != nil) { str_free(a, request.seed); }
    if (request.decl != nil) { str_free(a, request.decl); }
    var k: usize = 0;
    for (k < request.also.len) {
        str_free(a, request.also.data[k].range);
        str_free(a, request.also.data[k].requirer);
        k = k + 1;
    }
    collections_vector.dnit[RangeDecl](?request.also);
    k = 0;
    for (k < request.overrode.len) {
        str_free(a, request.overrode.data[k].chain);
        str_free(a, request.overrode.data[k].asked);
        k = k + 1;
    }
    collections_vector.dnit[Overridden](?request.overrode);
}

pub fun requests_dnit(a: *A.Allocator, requests: *Vector[Request]) {
    var i: usize = 0;
    for (i < requests.len) {
        request_dnit(a, ?requests.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[Request](requests);
}

# the root's own declarations in the manifest table `mt`, appended to `reqs`
pub fun declared(a: *A.Allocator, reqs: *Vector[Request], root: str, mt: *toml_value.Table) err[fail.Fail] {
    var root_id: str = key_text(mt, "project.id");
    if (str_is_empty(root_id)) { root_id = "(project)"; }
    ret enqueue(a, reqs, root, mt, root_id, true, false);
}

fun enqueue(a: *A.Allocator, reqs: *Vector[Request], manifest_dir: str, mt: *toml_value.Table,
    chain: str, root_decl: bool, via_release: bool) err[fail.Fail] {
    val opt_deps_t: opt[*toml_value.Table] = toml_lookup.get_table(mt, "dep");
    if (sel opt_deps_t.none) { ret err[fail.Fail].ok{}; }
    val deps_t: *toml_value.Table = opt_deps_t.some;
    val n:      usize             = toml_lookup.table_len(deps_t);
    var i:      usize             = 0;
    for (i < n) {
        val opt_key: opt[str] = toml_lookup.table_key(deps_t, i);
        if (sel opt_key.none) { brk; }
        val key:       str                    = opt_key.some;
        val opt_value: opt[*toml_value.Value] = toml_lookup.table_value(deps_t, i);
        if (sel opt_value.none) { brk; }
        val value: *toml_value.Value = opt_value.some;
        i = i + 1;
        if (value.tag != toml_value.TYPE_TABLE) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MANIFEST_VALUE_TYPE, "[dep.{}] is not a table", key)};
        }
        if (!manifest_schema.is_project_id(key)) { ret err[fail.Fail].err{manifest_schema.dep_name_refused(a, key)}; }
        val git_src:  str  = key_text(?value.data.table, "git");
        val path_src: str  = key_text(?value.data.table, "path");
        val has_git:  bool = !str_is_empty(git_src);
        val has_path: bool = !str_is_empty(path_src);
        if (has_git == has_path) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.DEP_SOURCE_COUNT, "[dep.{}] needs exactly one source key, 'git' or 'path'", key)};
        }

        var r:        Request;
        var retained: bool = false;
        fin {
            if (!retained) { request_dnit(a, ?r); }
        }
        val res_copied: res[str, fail.Fail] = copied(a, key);
        if (sel res_copied.err) { ret err[fail.Fail].err{res_copied.err}; }
        r.id          = res_copied.ok;
        r.root_decl   = root_decl;
        r.is_git      = has_git;
        r.via_release = via_release;
        r.seed        = nil;
        r.also        = collections_vector.init[RangeDecl](a);
        r.overrode    = collections_vector.init[Overridden](a);
        r.decl        = nil;
        r.copied      = COPY_NONE;
        if (has_git) {
            val res_url: res[str, fail.Fail] = copied(a, git_src);
            if (sel res_url.err) { ret err[fail.Fail].err{res_url.err}; }
            r.url = res_url.ok;
            val res_ref: res[str, fail.Fail] = copied(a, key_text(?value.data.table, "ref"));
            if (sel res_ref.err) { ret err[fail.Fail].err{res_ref.err}; }
            r.ref = res_ref.ok;
            val res_version: res[str, fail.Fail] = copied(a, key_text(?value.data.table, "version"));
            if (sel res_version.err) { ret err[fail.Fail].err{res_version.err}; }
            r.version = res_version.ok;
        }
        or {
            if (types_path.is_abs(path_src)) {
                val res_src: res[str, fail.Fail] = copied(a, path_src);
                if (sel res_src.err) { ret err[fail.Fail].err{res_src.err}; }
                r.src_path = res_src.ok;
            }
            or {
                val res_joined: res[str, A.Error] = types_path.join(a, manifest_dir, path_src);
                if (sel res_joined.err) { ret err[fail.Fail].err{fail.refused(res_joined.err)}; }
                r.src_path = res_joined.ok;
            }
        }
        val res_chain: res[str, std_format.FormatError] = std_format.sprint(a, "{} -> {}", chain, key);
        if (sel res_chain.err) { ret err[fail.Fail].err{fail.format_refused(res_chain.err)}; }
        r.chain = res_chain.ok;
        val res_requirer: res[str, fail.Fail] = copied(a, chain);
        if (sel res_requirer.err) { ret err[fail.Fail].err{res_requirer.err}; }
        r.requirer = res_requirer.ok;
        var res_decl: res[str, std_format.FormatError];
        if (!has_git)                 { res_decl = std_format.sprint(a, "path = \"{}\"", path_src); }
        or (!str_is_empty(r.version)) { res_decl = std_format.sprint(a, "version = \"{}\"", r.version); }
        or (!str_is_empty(r.ref))     { res_decl = std_format.sprint(a, "ref = \"{}\"", r.ref); }
        or                            { res_decl = std_format.sprint(a, "git = \"{}\"", r.url); }
        if (sel res_decl.err)         { ret err[fail.Fail].err{fail.format_refused(res_decl.err)}; }
        r.decl = res_decl.ok;

        val existing: i64 = index(reqs, r.id);
        if (existing >= 0) {
            val e: *Request = ?reqs.data[existing::usize];
            # a second range on a release-selected identity is one more need of the
            # same problem; a fixed root selection overrides every range on it
            if (both_ranged(e, ?r) && !via_release) {
                val err_kept: err[fail.Fail] = keep_range(e, ?r);
                if (sel err_kept.err) { ret err_kept; }
                cnt;
            }
            if (e.root_decl) {
                val err_noted: err[fail.Fail] = note_root_override(a, e, ?r);
                if (sel err_noted.err) { ret err_noted; }
                cnt;
            }
            if (selection_agrees(e, ?r)) { cnt; }
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.DEP_CONFLICT, conflict_text(a, ?r, e, ?r))};
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Request](reqs, r);
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        retained = true;
    }
    ret err[fail.Fail].ok{};
}

# a root declaration by `ref` or `path` replaces a differing requirement of its identity,
# which it records; a root `version` intersects with the requirers' ranges instead
fun note_root_override(a: *A.Allocator, e: *Request, r: *Request) err[fail.Fail] {
    if (is_ranged(e) || selection_agrees(e, r)) { ret err[fail.Fail].ok{}; }
    # the source is named too when the requirement asks for another one
    var res_asked: res[str, std_format.FormatError];
    if (r.is_git && (!e.is_git || !str_equals(e.url, r.url))) { res_asked = std_format.sprint(a, "git = \"{}\", {}", r.url, r.decl); }
    or                                                        { res_asked = std_format.sprint(a, "{}", r.decl); }
    if (sel res_asked.err)                                    { ret err[fail.Fail].err{fail.format_refused(res_asked.err)}; }
    val asked:     str                 = res_asked.ok;
    val res_chain: res[str, fail.Fail] = copied(a, r.chain);
    if (sel res_chain.err) {
        str_free(a, asked);
        ret err[fail.Fail].err{res_chain.err};
    }
    val chain:      str                 = res_chain.ok;
    val res_pushed: res[usize, A.Error] = collections_vector.push[Overridden](?e.overrode, Overridden{chain: chain, asked: asked});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# two release selections of one identity from the same repository
fun both_ranged(e: *Request, r: *Request) bool {
    ret selects_release(e) && selects_release(r) && str_equals(e.url, r.url);
}

# `r` is a further range on the identity `e` holds: its range and requirer move
# to `e`, so the request it came from is freed without them
fun keep_range(e: *Request, r: *Request) err[fail.Fail] {
    val res_pushed: res[usize, A.Error] = collections_vector.push[RangeDecl](?e.also, RangeDecl{range: r.version, requirer: r.requirer});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    r.version  = nil;
    r.requirer = nil;
    ret err[fail.Fail].ok{};
}

# a version-selected request realizes the release resolution chose for it
fun apply_picks(a: *A.Allocator, reqs: *Vector[Request], picks: *Vector[resolver.Choice]) {
    if (picks == nil) { ret; }
    var i: usize = 0;
    for (i < reqs.len) {
        val r: *Request = ?reqs.data[i];
        i = i + 1;
        if (!r.is_git || !is_ranged(r) || !str_is_empty(r.ref)) { cnt; }
        var k: usize = 0;
        for (k < picks.len) {
            if (str_equals(picks.data[k].id, r.id)) {
                val res_tag: res[str, std_format.FormatError] = std_format.sprint(a, "tag/{}", picks.data[k].tag);
                if (sel res_tag.ok) {
                    str_free(a, r.ref);
                    r.ref = res_tag.ok;
                }
            }
            k = k + 1;
        }
    }
}

fun selection_agrees(x: *Request, y: *Request) bool {
    if (x.is_git != y.is_git) { ret false; }
    # two version ranges are reconciled by resolution, not by equality
    if (x.is_git && is_ranged(x) && is_ranged(y)) { ret str_equals(x.url, y.url); }
    if (x.is_git)                                 { ret str_equals(x.url, y.url) && str_equals(x.ref, y.ref); }
    ret str_equals(x.src_path, y.src_path);
}

fun selection_text(a: *A.Allocator, r: *Request) res[str, fail.Fail] {
    if (r.is_git) { ret diagnostic.format(a, "git {} @ {}", r.url, r.ref); }
    ret diagnostic.format(a, "path {}", r.src_path);
}

# the example table is valid TOML as printed: values are escaped as the
# manifest writer would write them
pub fun conflict_text(a: *A.Allocator, subject: *Request, x: *Request, y: *Request) res[str, fail.Fail] {
    var res_decl: res[str, fail.Fail] = res[str, fail.Fail].err{fail.reported()};
    if (subject.is_git) {
        val res_url: res[str, A.Error] = toml_write.escape(a, subject.url);
        if (sel res_url.err) { ret res[str, fail.Fail].err{fail.refused(res_url.err)}; }
        val res_ref: res[str, A.Error] = toml_write.escape(a, subject.ref);
        if (sel res_ref.err) { ret res[str, fail.Fail].err{fail.refused(res_ref.err)}; }
        res_decl = diagnostic.format(a, "[dep.{}]\n    git = \"{}\"\n    ref = \"{}\"", subject.id, res_url.ok, res_ref.ok);
    }
    or {
        val res_path: res[str, A.Error] = toml_write.escape(a, subject.src_path);
        if (sel res_path.err) { ret res[str, fail.Fail].err{fail.refused(res_path.err)}; }
        res_decl = diagnostic.format(a, "[dep.{}]\n    path = \"{}\"", subject.id, res_path.ok);
    }
    if (sel res_decl.err) { ret res_decl; }
    val res_x_text: res[str, fail.Fail] = selection_text(a, x);
    if (sel res_x_text.err) { ret res_x_text; }
    val res_y_text: res[str, fail.Fail] = selection_text(a, y);
    if (sel res_y_text.err) { ret res_y_text; }
    ret diagnostic.format(a,
        "project id '{}' is reached with two different selections\n    {} requires {}\n    {} requires {}\n  the root decides by declaring the identity itself, for example\n    {}",
        subject.id, x.chain, res_x_text.ok, y.chain, res_y_text.ok, res_decl.ok);
}

# a fixed git dependency's manifest, and the pins it commits for its ranges, are read at the
# revision its selector picks, never from whatever its checkout holds
pub fun preflight(op: *Operation, doc: *manifest_load.Doc, reqs: *Vector[Request], inspect_git: bool, walk: *Walk) err[fail.Fail] {
    val a:           *A.Allocator                            = op.a;
    val res_checked: res[manifest_model.Manifest, fail.Fail] = manifest_load.parse(a, ?op.s.interner, doc);
    if (sel res_checked.err) { ret err[fail.Fail].err{res_checked.err}; }
    var parsed: manifest_model.Manifest = res_checked.ok;
    manifest_model.dnit(?parsed, a);
    var root_id: str = key_text(?doc.table, "project.id");
    if (str_is_empty(root_id)) { root_id = "(project)"; }
    val err_seeded: err[fail.Fail] = enqueue(a, reqs, op.root, ?doc.table, root_id, true, false);
    if (sel err_seeded.err) { ret err_seeded; }
    var i: usize = 0;
    for (i < reqs.len) {
        val request: Request = reqs.data[i];
        i = i + 1;
        var source: str  = request.src_path;
        var owned:  bool = false;
        fin {
            if (owned) { str_free(a, source); }
        }
        if (request.is_git) {
            if (!inspect_git) { cnt; }
            val res_joined: res[str, fail.Fail] = package.dep_full_of(a, op.root, request.id);
            if (sel res_joined.err) { ret err[fail.Fail].err{res_joined.err}; }
            source = res_joined.ok;
            owned  = true;
            val res_held: res[bool, fail.Fail] = op.checkouts.holds(op.checkouts.ctx, source);
            if (sel res_held.err) { ret err[fail.Fail].err{res_held.err}; }
            if (!res_held.ok)     { cnt; }
        }
        var rev: str = nil;
        fin {
            if (rev != nil) { str_free(op.s.build_alloc, rev); }
        }
        var res_read: res[manifest_load.Doc, fail.Fail];
        if (request.is_git && !is_ranged(?request)) {
            val res_selection: res[str, fail.Fail] = op.checkouts.selection(op.checkouts.ctx, op.root, request.id, source, request.ref,
                walk_moves(walk, request.id), walk.offline);
            if (sel res_selection.err) { ret err[fail.Fail].err{res_selection.err}; }
            rev      = res_selection.ok;
            res_read = op.checkouts.manifest_of(op.checkouts.ctx, a, source, rev);
        }
        or {
            val res_file: res[str, A.Error] = types_path.join(a, source, manifest_load.MANIFEST_FILE);
            if (sel res_file.err) { ret err[fail.Fail].err{fail.refused(res_file.err)}; }
            res_read = parse_file(a, op.s.sources, res_file.ok);
            str_free(a, res_file.ok);
        }
        if (sel res_read.err) { ret err[fail.Fail].err{res_read.err}; }
        var dependency: manifest_load.Doc = res_read.ok;
        fin { manifest_load.doc_dnit(a, ?dependency); }
        val err_identity: err[fail.Fail] = package.check_dep_identity(op.s, request.id, key_text(?dependency.table, "project.id"));
        if (sel err_identity.err) { ret err_identity; }
        val first_child: usize          = reqs.len;
        val err_more:    err[fail.Fail] = enqueue(a, reqs, source, ?dependency.table, request.chain, false, reached_via_release(?request));
        if (sel err_more.err) { ret err_more; }
        # a range this dependency declares is seeded by the pin its own project records for it
        if (!reached_via_release(?request)) {
            val err_seeded_children: err[fail.Fail] = seed_from_source(op, source, rev, reqs, first_child);
            if (sel err_seeded_children.err) { ret err_seeded_children; }
        }
    }
    ret err[fail.Fail].ok{};
}

# the pin `source`, a dependency's own project, records for each range it declares from
# `first` on: the one the revision `rev` records, or with no `rev` the one it records now. a
# source in no place that records pins, or without a pin for the identity, seeds nothing
fun seed_from_source(op: *Operation, source: str, rev: str, reqs: *Vector[Request], first: usize) err[fail.Fail] {
    var k:   usize = first;
    var any: bool  = false;
    for (k < reqs.len) {
        if (selects_release(?reqs.data[k]) && str_is_empty(reqs.data[k].ref)) { any = true; }
        k = k + 1;
    }
    if (!any) { ret err[fail.Fail].ok{}; }
    if (rev == nil) {
        val res_inside: res[bool, fail.Fail] = op.pins.tracked(op.pins.ctx, source);
        if (sel res_inside.err) { ret err[fail.Fail].err{res_inside.err}; }
        if (!res_inside.ok)     { ret err[fail.Fail].ok{}; }
    }
    k = first;
    for (k < reqs.len) {
        val child: *Request = ?reqs.data[k];
        k = k + 1;
        if (!selects_release(child) || !str_is_empty(child.ref)) { cnt; }
        var res_link: res[opt[str], fail.Fail];
        if (rev == nil)       { res_link = op.pins.read(op.pins.ctx, source, child.id); }
        or                    { res_link = op.pins.read_at(op.pins.ctx, source, rev, child.id); }
        if (sel res_link.err) { ret err[fail.Fail].err{res_link.err}; }
        val opt_pin: opt[str] = res_link.ok;
        if (sel opt_pin.some) {
            val res_kept: res[str, fail.Fail] = copied(op.a, opt_pin.some);
            str_free(op.s.build_alloc, opt_pin.some);
            if (sel res_kept.err) { ret err[fail.Fail].err{res_kept.err}; }
            child.seed = res_kept.ok;
        }
    }
    ret err[fail.Fail].ok{};
}

# a note for each change made before a failure, which the caller shows after it
pub fun effects(op: *Operation, reqs: *Vector[Request]) {
    var i: usize = 0;
    for (i < reqs.len) {
        if (!str_is_empty(reqs.data[i].effect)) {
            report.effectf(op.rep, "{} for dep/{} before this failure, and that state was kept", reqs.data[i].effect, reqs.data[i].id);
        }
        i = i + 1;
    }
}

# a string key as the dependency commands read it: absent reads as empty
pub fun key_text(t: *toml_value.Table, key: str) str {
    val opt_str: opt[str] = toml_lookup.get_str(t, key);
    if (sel opt_str.some) { ret opt_str.some; }
    ret "";
}

pub fun parse_file(a: *A.Allocator, sources: *base_source.SourceMap, p: str) res[manifest_load.Doc, fail.Fail] {
    val res_doc: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_read(a, sources, p);
    if (sel res_doc.ok) { ret res_doc; }
    val f: fail.Fail = res_doc.err;
    if (fail.kind_of(f) == diagnostic_kind.TOML_MALFORMED) {
        val res_said: res[str, fail.Fail] = diagnostic.format(a, "{} is not valid TOML ({})", p, fail.describe(f));
        if (sel res_said.err) { ret res[manifest_load.Doc, fail.Fail].err{res_said.err}; }
        ret res[manifest_load.Doc, fail.Fail].err{fail.owning(fail.with_text(f, res_said.ok))};
    }
    ret res_doc;
}

# a copy of `s` owned by `a`, or the refusal to make it
fun copied(a: *A.Allocator, s: str) res[str, fail.Fail] {
    val res_dup: res[str, A.Error] = str_dup(a, s);
    if (sel res_dup.err) { ret res[str, fail.Fail].err{fail.refused(res_dup.err)}; }
    ret res[str, fail.Fail].ok{res_dup.ok};
}
