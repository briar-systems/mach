# list: what `mach dep list` shows: each root declaration with its winning selection, its
# pin, its state and its source, and under it every requirement of the identity that selection
# overrides. why a pin or a state cannot be read goes to the report as a note, so the rows
# stay one table
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use mach.base.fail;
use manifest_version: mach.manifest.version;
use mach.report.layout;

use mach.base.diagnostic;
use manifest_load: mach.manifest.load;
use mach.package;
use package_closure: mach.package.closure;
use mach.package.report;

# one row of `mach dep list`: a root declaration's cells, or under it, with no name, a
# requirement it overrides
# ---
# name:    the declared id, nil for an override
# version: the range or the ref it selects by, `-` for a path
# pin:     the pinned commit, short, `-` for none, or `unreadable`
# state:   realized, missing, out of range, release unknown, unreadable or invalid
# source:  its git url or its path
# text:    an override's line, nil for a declaration
pub rec Row {
    name:    str;
    version: str;
    pin:     str;
    state:   str;
    source:  str;
    text:    str;
}

# what a row lists for what it does not have
val NONE: str = "-";

# the rows `mach dep list` shows, appended to `out`, none when the manifest declares no
# dependency
# ---
# op:  the operation
# out: receives one row per root declaration and one per requirement it overrides
# ret: err naming the failure
pub fun lines(op: *package_closure.Operation, out: *Vector[Row]) err[fail.Fail] {
    val a:           *A.Allocator      = op.a;
    val res_mt_path: res[str, A.Error] = types_path.join(a, op.root, manifest_load.MANIFEST_FILE);
    if (sel res_mt_path.err) { ret err[fail.Fail].err{fail.refused(res_mt_path.err)}; }
    val res_parse_file: res[manifest_load.Doc, fail.Fail] = package_closure.parse_file(a, op.s.sources, res_mt_path.ok);
    if (sel res_parse_file.err) { ret err[fail.Fail].err{res_parse_file.err}; }
    var mt: manifest_load.Doc = res_parse_file.ok;
    fin { manifest_load.doc_dnit(a, ?mt); }

    val opt_deps_t: opt[*toml_value.Table] = toml_lookup.get_table(?mt.table, "dep");
    var deps_t:     *toml_value.Table      = nil;
    var n:          usize                  = 0;
    if (sel opt_deps_t.some) {
        deps_t = opt_deps_t.some;
        n      = toml_lookup.table_len(deps_t);
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    # the closure as the realized checkouts and path sources declare it
    var closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?closure); }
    var walk:       package_closure.Walk = package_closure.Walk{offline: true, all: false, name: nil, quiet: true};
    val err_walked: err[fail.Fail]       = package_closure.preflight(op, ?mt, ?closure, true, ?walk);
    if (sel err_walked.err) { report.notef(op.rep, a, "the dependency closure could not be read, so overridden requirements are not shown ({})", fail.describe(err_walked.err)); }

    var pins: Pins  = Pins{asked: false, tracked: res[bool, fail.Fail].ok{false}};
    var i:    usize = 0;
    for (i < n) {
        val opt_key: opt[str] = toml_lookup.table_key(deps_t, i);
        if (sel opt_key.none) { brk; }
        val key:       str                    = opt_key.some;
        val opt_value: opt[*toml_value.Value] = toml_lookup.table_value(deps_t, i);
        if (sel opt_value.none) { brk; }
        val value: *toml_value.Value = opt_value.some;
        i = i + 1;
        if (value.tag != toml_value.TYPE_TABLE) {
            val err_invalid: err[fail.Fail] = put(out, res[Row, fail.Fail].ok{Row{name: key, version: NONE, pin: NONE, state: "invalid", source: NONE, text: nil}});
            if (sel err_invalid.err) { ret err_invalid; }
            cnt;
        }
        val err_kept: err[fail.Fail] = put(out, entry_row(op, key, ?value.data.table, ?pins));
        if (sel err_kept.err) { ret err_kept; }
        val at: i64 = package_closure.index(?closure, key);
        if (at < 0 || !closure.data[at::usize].root_decl) { cnt; }
        val winner: *package_closure.Request = ?closure.data[at::usize];
        var k:      usize                    = 0;
        for (k < winner.overrode.len) {
            val o:        *package_closure.Overridden = ?winner.overrode.data[k];
            val res_text: res[str, fail.Fail]         = diagnostic.format(a, "overrides {}, which requires {}", o.chain, o.asked);
            if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
            val err_over: err[fail.Fail] = put(out, res[Row, fail.Fail].ok{Row{name: nil, version: nil, pin: nil, state: nil, source: nil, text: res_text.ok}});
            if (sel err_over.err) { ret err_over; }
            k = k + 1;
        }
    }
    if (!pins.asked) { ret err[fail.Fail].ok{}; }
    val tracked: res[bool, fail.Fail] = pins.tracked;
    if (sel tracked.ok && !tracked.ok) { report.note(op.rep, "the project is in no Git repository, so it records no pins. each Git dependency is the checkout under dep/"); }
    ret err[fail.Fail].ok{};
}

# whether the project records pins, asked of the pin member once, at the first Git declaration
# `mach dep list` lists, since a project of path dependencies alone needs no Git at all
# ---
# asked:   whether the member has been asked
# tracked: its answer, or why it could not answer
rec Pins {
    asked:   bool;
    tracked: res[bool, fail.Fail];
}

# whether the project at the operation's root records pins, asking the member the first time
fun records_pins(op: *package_closure.Operation, pins: *Pins) res[bool, fail.Fail] {
    if (!pins.asked) {
        pins.tracked = op.pins.tracked(op.pins.ctx, op.root);
        pins.asked   = true;
    }
    ret pins.tracked;
}

# appends a row to `out`, or the failure that refused to make or keep it
fun put(out: *Vector[Row], row: res[Row, fail.Fail]) err[fail.Fail] {
    if (sel row.err) { ret err[fail.Fail].err{row.err}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[Row](out, row.ok);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the row of the root declaration `key`, whose table is `t`. a project in no repository records
# no pin, so none is listed. a directory or a pin that cannot be read is listed as unreadable,
# with why in a note, so `list` still lists the rest
fun entry_row(op: *package_closure.Operation, key: str, t: *toml_value.Table, pins: *Pins) res[Row, fail.Fail] {
    val a:        *A.Allocator        = op.a;
    val res_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, key);
    if (sel res_full.err) { ret res[Row, fail.Fail].err{res_full.err}; }
    val full:       str                       = res_full.ok;
    var row:        Row                       = Row{name: key, version: NONE, pin: NONE, state: "missing", source: NONE, text: nil};
    val res_is_dir: res[bool, io_error.Error] = fs.is_dir(full);
    if (sel res_is_dir.err) {
        row.state = "unreadable";
        report.notef(op.rep, a, "dep/{} cannot be read ({})", key, fail.cause_text(fail.Cause.io{res_is_dir.err}));
    }
    if (sel res_is_dir.ok) {
        if (res_is_dir.ok) { row.state = "realized"; }
    }
    val git_src: str = package_closure.key_text(t, "git");
    if (str_is_empty(git_src)) {
        row.source = package_closure.key_text(t, "path");
        ret res[Row, fail.Fail].ok{row};
    }
    row.source = git_src;
    val version: str = package_closure.key_text(t, "version");
    val ref:     str = package_closure.key_text(t, "ref");
    if (!str_is_empty(version)) { row.version = version; }
    or (!str_is_empty(ref))     { row.version = ref; }
    var res_pinned:  res[opt[str], fail.Fail] = res[opt[str], fail.Fail].ok{opt[str].none{}};
    val res_records: res[bool, fail.Fail]     = records_pins(op, pins);
    if (sel res_records.err)                  { res_pinned = res[opt[str], fail.Fail].err{res_records.err}; }
    if (sel res_records.ok && res_records.ok) { res_pinned = op.pins.read(op.pins.ctx, op.root, key); }
    if (sel res_pinned.err) {
        row.pin = "unreadable";
        report.notef(op.rep, a, "the pin of {} cannot be read ({})", key, fail.describe(res_pinned.err));
    }
    if (sel res_pinned.ok) {
        val opt_pinned: opt[str] = res_pinned.ok;
        if (sel opt_pinned.some) {
            var ct:        layout.Text;
            val res_short: res[str, fail.Fail] = diagnostic.format(a, "{}", layout.commit(?ct, opt_pinned.some));
            if (sel res_short.err) { ret res[Row, fail.Fail].err{res_short.err}; }
            row.pin = res_short.ok;
        }
    }
    if (str_equals(row.state, "realized") && !str_is_empty(version)) {
        val res_state: res[str, fail.Fail] = range_state(op, key, full, version);
        if (sel res_state.err) { ret res[Row, fail.Fail].err{res_state.err}; }
        row.state = res_state.ok;
    }
    ret res[Row, fail.Fail].ok{row};
}

# a realized version-selected dependency's state in `mach dep list`: "realized" while its range
# admits the pinned release, and out of range when it does not, with why in a note. a range or
# release that does not parse states nothing to hold the pin to, so the dependency reads as realized
fun range_state(op: *package_closure.Operation, id: str, dep_full: str, want: str) res[str, fail.Fail] {
    val res_rel: res[str, fail.Fail] = op.checkouts.release_at(op.checkouts.ctx, op.root, id, dep_full, false);
    # a pin that cannot be read is listed with why, so `list` still lists the rest
    if (sel res_rel.err) {
        if (fail.is_message(res_rel.err)) { ret res_rel; }
        report.notef(op.rep, op.a, "the release of {} is unknown ({})", id, fail.describe(res_rel.err));
        ret res[str, fail.Fail].ok{UNKNOWN};
    }
    if (str_is_empty(res_rel.ok)) {
        val res_tagged: res[bool, fail.Fail] = op.checkouts.has_releases(op.checkouts.ctx, dep_full);
        if (sel res_tagged.err) { ret res[str, fail.Fail].err{res_tagged.err}; }
        if (!res_tagged.ok) {
            report.notef(op.rep, op.a, "the release of {} is unknown: its checkout holds no tags, which `mach dep pull` fetches", id);
            ret res[str, fail.Fail].ok{UNKNOWN};
        }
        report.notef(op.rep, op.a, "{} is out of range: no release tag in its checkout names the pinned commit", id);
        ret res[str, fail.Fail].ok{OUT_OF_RANGE};
    }
    val res_parse_range:   res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(want);
    val res_parse_version: res[manifest_version.Version, str]                       = manifest_version.parse_version(res_rel.ok);
    if (sel res_parse_range.err)   { ret res[str, fail.Fail].ok{"realized"}; }
    if (sel res_parse_version.err) { ret res[str, fail.Fail].ok{"realized"}; }
    var r: manifest_version.Range   = res_parse_range.ok;
    var v: manifest_version.Version = res_parse_version.ok;
    if (manifest_version.satisfies(?r, ?v)) { ret res[str, fail.Fail].ok{"realized"}; }
    report.notef(op.rep, op.a, "{} is out of range: the pinned release {} is outside {}", id, res_rel.ok, want);
    ret res[str, fail.Fail].ok{OUT_OF_RANGE};
}

# the states of a version-selected dependency whose pin its range does not hold
val UNKNOWN:      str = "release unknown";
val OUT_OF_RANGE: str = "out of range";
