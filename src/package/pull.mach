# pull: `mach dep pull`, which realizes a project's dependency closure and refuses one that
# pins a package at more than one commit
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mach.base.fail;
use mach.session;

use package_agreement: mach.package.agreement;
use package_closure:   mach.package.closure;
use mach.package.report;

# realize the dependency closure of a project: acquire every declared dependency
# transitively, check each realized manifest's project id against its declared name, and
# report realized directories under dep/ that are no longer in the closure, then refuse a
# package pinned at different commits within it, the closure realized all the same
# ---
# s:     the session; a failure may borrow from it, so the caller shows it before ending it
# a:     the storage the operation works in
# root:  the project root directory
# quiet: report no progress lines
# rep:   receives progress, notes, and the effects a failure left
# ret:   err naming the failure
pub fun project_closure(s: *session.Session, a: *A.Allocator, root: str, quiet: bool, rep: *report.Report) err[fail.Fail] {
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(s, a, root, rep);
    if (sel res_opened.err) { ret err[fail.Fail].err{res_opened.err}; }
    var op: package_closure.Operation = res_opened.ok;
    ret package_closure.ended(?op, pulled(?op, quiet));
}

# realize the closure through an open operation, then refuse a package pinned at two commits
fun pulled(op: *package_closure.Operation, quiet: bool) err[fail.Fail] {
    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](op.a);
    fin { package_closure.requests_dnit(op.a, ?reqs); }
    val err_walked: err[fail.Fail] = package_closure.realize(op, ?reqs, quiet, true, false, false, nil, nil);
    if (sel err_walked.err) { ret err_walked; }
    var split: Vector[str] = collections_vector.init[str](op.a);
    fin { package_agreement.lines_dnit(op.a, ?split); }
    val err_checked: err[fail.Fail] = package_agreement.disagreements(op, ?reqs, ?split);
    if (sel err_checked.err) { ret err_checked; }
    ret package_agreement.refused(op, ?split);
}
