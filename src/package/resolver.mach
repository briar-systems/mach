# dependency version resolution: PubGrub over the releases each identity lists
#
# the algorithm is Weizenbaum's (2018), as in Dart's pub, over finite domains. an
# identity's domain is its listed releases, so a set of versions is a bitset over them and
# complement is exact. the running compiler is checked per release as its own
# incompatibility, and a failure is explained from the derivation that proved it.

use std.allocator.arena;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_dup;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use manifest_version: mach.manifest.version;

use base_catalog: mach.base.catalog;
use mach.base.diagnostic;
use package_source: mach.package.source;

# `who` names the requirer a diagnostic attributes a root need to: the root itself
# ("" reads as the problem's root) or the chain of a dependency that declared the
# range, since every requirer's range takes part in the root's problem. `range` is the range
# as written and `admits` it parsed where it entered, borrowing from it
pub rec Need {
    id:     str;
    url:    str;
    range:  str;
    admits: manifest_version.Range;
    who:    str;
}

# what a release asks for: the compiler range its manifest states ("" for none, and
# `mach_range` it parsed, none for none) and its
# dependencies selected by version range. `excluded` is "" for a candidate and otherwise says
# why the release is not one (its manifest does not load, or names another version): the
# release is set aside and the reason explains a failure it takes part in, while a failure to
# read the release at all is the NeedsFn's err and stops resolution. `detail` is what the
# manifest's load said, or nil
pub rec ReleaseNeeds {
    mach:       str;
    mach_range: opt[manifest_version.Range];
    needs:      Vector[Need];
    excluded:   str;
    detail:     str;
}

# fills `out` (initialized by the caller over the solve's allocator) for one release
def NeedsFn: fun(ptr, str, str, *package_source.Release, *ReleaseNeeds) err[fail.Fail];

# a preferred version, kept while it still satisfies every requirement (`update <name>`)
pub rec Lock {
    id:      str;
    version: str;
}

# fixed ids are identities the root, or a dependency it reaches by ref or path, selects by ref
# or path: that selection overrides them, so no requirement on them takes part in resolution
pub rec Problem {
    root:        str;
    needs:       *Need;
    need_count:  u32;
    fixed:       *str;
    fixed_count: u32;
    compiler:    str;
    lowest:      bool;
    locks:       *Lock;
    lock_count:  u32;
}

# the release resolution selected for one identity, its texts owned by the caller's allocator
# ---
# id:      the identity
# url:     the source it is listed at
# tag:     the tag that names the release
# commit:  the commit the tag points at
# version: the release's version text
pub rec Choice {
    id:      str;
    url:     str;
    tag:     str;
    commit:  str;
    version: str;
}

rec Pkg {
    id:         str;
    url:        str;
    rels:       Vector[package_source.Release];
    words:      usize;
    listed:     bool;
    list_error: str;
}

# a statement that package `pkg` takes a version in `set` (positive) or not in it (negative)
rec Term {
    pkg:      u32;
    set:      *u64;
    positive: bool;
}

def CauseKind: u8;
val C_ROOT:        CauseKind = 0;
val C_DEP:         CauseKind = 1;
val C_NO_VERSIONS: CauseKind = 2;
val C_COMPILER:    CauseKind = 3;
val C_UNLISTED:    CauseKind = 4;
val C_DERIVED:     CauseKind = 5;
val C_BASE:        CauseKind = 6;
val C_EXCLUDED:    CauseKind = 7;

# a set of terms that cannot all hold, and why: `left` and `right` are the incompatibilities a
# derived one came from, `owner` and `version` the release a fact is about, `target` the
# package it requires, `text` its range or reason, `who` the requirer of a root need and
# `detail` what an excluded release's manifest load said
rec Incompat {
    terms:   Vector[Term];
    kind:    CauseKind;
    left:    u32;
    right:   u32;
    owner:   u32;
    version: u32;
    target:  u32;
    text:    str;
    who:     str;
    detail:  str;
}

# one entry of the partial solution: a term, its decision level, the incompatibility that
# derived it (NO_INCOMPAT for a decision) and the release index a decision picked
rec Assign {
    term:    Term;
    level:   u32;
    cause:   i64;
    version: i64;
}

rec Solver {
    a:        *A.Allocator;
    src:      *package_source.Releases;
    needs:    NeedsFn;
    ctx:      ptr;
    problem:  *Problem;
    compiler: manifest_version.Version;
    pkgs:     Vector[Pkg];
    incs:     Vector[Incompat];
    assigns:  Vector[Assign];
    level:    u32;
    failure:  str;
}

val NO_INCOMPAT: i64 = -1;

# add_incompat's answer for an incompatibility that can never hold and is not recorded
val VACUOUS: u32 = 0xFFFFFFFF;

# the number of versions package `p` can take: the root has one
fun domain(s: *Solver, p: u32) usize {
    if (p == 0) { ret 1; }
    ret s.pkgs.data[p].rels.len;
}

# a version set over package `p`: every version when `full`, none otherwise; or the
# refusal to allocate it
fun set_init(s: *Solver, p: u32, full: bool) res[*u64, fail.Fail] {
    val words:        usize              = s.pkgs.data[p].words;
    val res_allocate: res[*u64, A.Error] = A.allocate[u64](s.a, words);
    if (sel res_allocate.err) { ret res[*u64, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val bits: *u64  = res_allocate.ok;
    var i:    usize = 0;
    for (i < words) {
        bits[i] = 0;
        i       = i + 1;
    }
    if (full) {
        val n: usize = domain(s, p);
        var k: usize = 0;
        for (k < n) {
            bits[k / 64] = bits[k / 64] | (1::u64 << (k % 64)::u64);
            k            = k + 1;
        }
    }
    ret res[*u64, fail.Fail].ok{bits};
}

fun set_has(bits: *u64, k: usize) bool {
    ret (bits[k / 64] & (1::u64 << (k % 64)::u64)) != 0;
}

fun set_put(bits: *u64, k: usize) {
    bits[k / 64] = bits[k / 64] | (1::u64 << (k % 64)::u64);
}

def SetOp: u8;
val OP_AND:    SetOp = 0;
val OP_OR:     SetOp = 1;
val OP_ANDNOT: SetOp = 2;

# a fresh version set over package `p` combining `x` and `y` by `op`
fun set_combine(s: *Solver, p: u32, x: *u64, y: *u64, op: SetOp) res[*u64, fail.Fail] {
    val res_made: res[*u64, fail.Fail] = set_init(s, p, false);
    if (sel res_made.err) { ret res_made; }
    val out:   *u64  = res_made.ok;
    val words: usize = s.pkgs.data[p].words;
    var i:     usize = 0;
    for (i < words) {
        if (op == OP_AND) { out[i] = x[i] & y[i]; }
        or (op == OP_OR)  { out[i] = x[i] | y[i]; }
        or                { out[i] = x[i] & ~y[i]; }
        i = i + 1;
    }
    ret res[*u64, fail.Fail].ok{out};
}

fun set_is_empty(s: *Solver, p: u32, x: *u64) bool {
    val words: usize = s.pkgs.data[p].words;
    var i:     usize = 0;
    for (i < words) {
        if (x[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun set_count(s: *Solver, p: u32, x: *u64) usize {
    var n: usize = 0;
    var k: usize = 0;
    for (k < domain(s, p)) {
        if (set_has(x, k)) { n = n + 1; }
        k = k + 1;
    }
    ret n;
}

fun set_equal(s: *Solver, p: u32, x: *u64, y: *u64) bool {
    val words: usize = s.pkgs.data[p].words;
    var i:     usize = 0;
    for (i < words) {
        if (x[i] != y[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun term_equal(s: *Solver, x: *Term, y: *Term) bool {
    ret x.pkg == y.pkg && x.positive == y.positive && set_equal(s, x.pkg, x.set, y.set);
}

# the conjunction of two terms on one package
fun term_intersect(s: *Solver, x: *Term, y: *Term) res[Term, fail.Fail] {
    var a:  *u64  = x.set;
    var b:  *u64  = y.set;
    var op: SetOp = OP_OR;
    if (x.positive && y.positive) { op = OP_AND; }
    or (x.positive)               { op = OP_ANDNOT; }
    or (y.positive) {
        a  = y.set;
        b  = x.set;
        op = OP_ANDNOT;
    }
    val res_set: res[*u64, fail.Fail] = set_combine(s, x.pkg, a, b, op);
    if (sel res_set.err) { ret res[Term, fail.Fail].err{res_set.err}; }
    ret res[Term, fail.Fail].ok{Term{pkg: x.pkg, set: res_set.ok, positive: x.positive || y.positive}};
}

# the term that package `p` takes exactly its `k`th release
fun single_term(s: *Solver, p: u32, k: usize) res[Term, fail.Fail] {
    val res_made: res[*u64, fail.Fail] = set_init(s, p, false);
    if (sel res_made.err) { ret res[Term, fail.Fail].err{res_made.err}; }
    set_put(res_made.ok, k);
    ret res[Term, fail.Fail].ok{Term{pkg: p, set: res_made.ok, positive: true}};
}

# the term over every version of package `p`
fun full_term(s: *Solver, p: u32, positive: bool) res[Term, fail.Fail] {
    val res_made: res[*u64, fail.Fail] = set_init(s, p, true);
    if (sel res_made.err) { ret res[Term, fail.Fail].err{res_made.err}; }
    ret res[Term, fail.Fail].ok{Term{pkg: p, set: res_made.ok, positive: positive}};
}

fun term_inverse(t: *Term) Term {
    ret Term{pkg: t.pkg, set: t.set, positive: !t.positive};
}

# a positive term over no version can never hold
fun term_void(s: *Solver, t: *Term) bool {
    ret t.positive && set_is_empty(s, t.pkg, t.set);
}

rec Known {
    allowed:  *u64;
    selected: bool;
}

# what the first `upto` assignments say about package `p`
fun known(s: *Solver, p: u32, upto: usize) res[Known, fail.Fail] {
    val res_all: res[*u64, fail.Fail] = set_init(s, p, true);
    if (sel res_all.err) { ret res[Known, fail.Fail].err{res_all.err}; }
    var k: Known = Known{allowed: res_all.ok, selected: false};
    var i: usize = 0;
    for (i < upto) {
        val as: *Assign = ?s.assigns.data[i];
        if (as.term.pkg == p) {
            var op: SetOp = OP_ANDNOT;
            if (as.term.positive) {
                op         = OP_AND;
                k.selected = true;
            }
            val res_narrowed: res[*u64, fail.Fail] = set_combine(s, p, k.allowed, as.term.set, op);
            if (sel res_narrowed.err) { ret res[Known, fail.Fail].err{res_narrowed.err}; }
            k.allowed = res_narrowed.ok;
        }
        i = i + 1;
    }
    ret res[Known, fail.Fail].ok{k};
}

def Relation: u8;
val REL_SATISFIED:    Relation = 0;
val REL_CONTRADICTED: Relation = 1;
val REL_OPEN:         Relation = 2;

# whether what is known of a package satisfies `t`, contradicts it, or leaves it open
fun relation(s: *Solver, t: *Term, k: *Known) res[Relation, fail.Fail] {
    val res_outside: res[*u64, fail.Fail] = set_combine(s, t.pkg, k.allowed, t.set, OP_ANDNOT);
    if (sel res_outside.err) { ret res[Relation, fail.Fail].err{res_outside.err}; }
    val res_inside: res[*u64, fail.Fail] = set_combine(s, t.pkg, k.allowed, t.set, OP_AND);
    if (sel res_inside.err) { ret res[Relation, fail.Fail].err{res_inside.err}; }
    val within: bool     = set_is_empty(s, t.pkg, res_outside.ok);
    val apart:  bool     = set_is_empty(s, t.pkg, res_inside.ok);
    var r:      Relation = REL_OPEN;
    if (t.positive) {
        if (k.selected && within) { r = REL_SATISFIED; }
        or (apart)                { r = REL_CONTRADICTED; }
    }
    or {
        if (apart)                { r = REL_SATISFIED; }
        or (k.selected && within) { r = REL_CONTRADICTED; }
    }
    ret res[Relation, fail.Fail].ok{r};
}

# how `t` stands against the first `upto` assignments
fun relation_at(s: *Solver, t: *Term, upto: usize) res[Relation, fail.Fail] {
    val res_known: res[Known, fail.Fail] = known(s, t.pkg, upto);
    if (sel res_known.err) { ret res[Relation, fail.Fail].err{res_known.err}; }
    var kn: Known = res_known.ok;
    ret relation(s, t, ?kn);
}

# the index of the earliest assignment after which `t` holds
fun satisfier(s: *Solver, t: *Term) res[usize, fail.Fail] {
    var i: usize = 0;
    for (i < s.assigns.len) {
        if (s.assigns.data[i].term.pkg == t.pkg) {
            val res_rel: res[Relation, fail.Fail] = relation_at(s, t, i + 1);
            if (sel res_rel.err)             { ret res[usize, fail.Fail].err{res_rel.err}; }
            if (res_rel.ok == REL_SATISFIED) { ret res[usize, fail.Fail].ok{i}; }
        }
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{s.assigns.len};
}

fun assign(s: *Solver, t: Term, cause: i64, version: i64) err[fail.Fail] {
    val res_pushed: res[usize, A.Error] = collections_vector.push[Assign](?s.assigns, Assign{term: t, level: s.level, cause: cause, version: version});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# whether the partial solution holds a decision for package `p`
fun decided(s: *Solver, p: u32) bool {
    var i: usize = 0;
    for (i < s.assigns.len) {
        if (s.assigns.data[i].term.pkg == p && s.assigns.data[i].cause == NO_INCOMPAT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# drop every assignment made above decision level `level`
fun backtrack(s: *Solver, level: u32) {
    var keep: usize = 0;
    for (keep < s.assigns.len && s.assigns.data[keep].level <= level) { keep = keep + 1; }
    collections_vector.truncate[Assign](?s.assigns, keep);
    s.level = level;
}

# record an incompatibility, its terms on one package conjoined, and return its index, or
# VACUOUS without recording anything when one of its terms can never hold
fun add_incompat(s: *Solver, made: res[Vector[Term], fail.Fail], kind: CauseKind, left: u32, right: u32,
    owner: u32, version: u32, target: u32, text: str, who: str) res[u32, fail.Fail] {
    if (sel made.err) { ret res[u32, fail.Fail].err{made.err}; }
    val terms: Vector[Term] = made.ok;
    # terms on one package are conjoined; a derived fact never needs the root's own term
    var merged: Vector[Term] = collections_vector.init[Term](s.a);
    var i:      usize        = 0;
    for (i < terms.len) {
        var t: Term = terms.data[i];
        # `not p in {}` always holds, so it constrains nothing
        if (!t.positive && set_is_empty(s, t.pkg, t.set)) {
            i = i + 1;
            cnt;
        }
        var found: bool  = false;
        var j:     usize = 0;
        for (j < merged.len) {
            if (merged.data[j].pkg == t.pkg) {
                val res_joined: res[Term, fail.Fail] = term_intersect(s, ?merged.data[j], ?t);
                if (sel res_joined.err) { ret res[u32, fail.Fail].err{res_joined.err}; }
                merged.data[j] = res_joined.ok;
                found          = true;
            }
            j = j + 1;
        }
        if (!found) {
            val res_merged_pushed: res[usize, A.Error] = collections_vector.push[Term](?merged, t);
            if (sel res_merged_pushed.err) { ret res[u32, fail.Fail].err{fail.refused(res_merged_pushed.err)}; }
        }
        i = i + 1;
    }
    # a term no assignment can satisfy makes the whole incompatibility vacuous
    var v: usize = 0;
    for (v < merged.len) {
        if (term_void(s, ?merged.data[v])) { ret res[u32, fail.Fail].ok{VACUOUS}; }
        v = v + 1;
    }
    if (kind == C_DERIVED && merged.len > 1) {
        var w: usize = 0;
        var r: usize = 0;
        for (r < merged.len) {
            if (!(merged.data[r].pkg == 0 && merged.data[r].positive)) {
                merged.data[w] = merged.data[r];
                w              = w + 1;
            }
            r = r + 1;
        }
        collections_vector.truncate[Term](?merged, w);
    }
    val inc: Incompat = Incompat{terms: merged, kind: kind, left: left, right: right, owner: owner,
        version: version, target: target, text: text, who: who, detail: nil};
    val res_pushed: res[usize, A.Error] = collections_vector.push[Incompat](?s.incs, inc);
    if (sel res_pushed.err) { ret res[u32, fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret res[u32, fail.Fail].ok{(res_pushed.ok - 1)::u32};
}

# the terms `x`, and `y` when there is one, or the failure that refused to make either or
# to hold them
fun terms_of(s: *Solver, x: res[Term, fail.Fail], y: opt[Term]) res[Vector[Term], fail.Fail] {
    if (sel x.err) { ret res[Vector[Term], fail.Fail].err{x.err}; }
    var v:         Vector[Term]        = collections_vector.init[Term](s.a);
    val res_first: res[usize, A.Error] = collections_vector.push[Term](?v, x.ok);
    if (sel res_first.err) { ret res[Vector[Term], fail.Fail].err{fail.refused(res_first.err)}; }
    if (sel y.some) {
        val res_second: res[usize, A.Error] = collections_vector.push[Term](?v, y.some);
        if (sel res_second.err) { ret res[Vector[Term], fail.Fail].err{fail.refused(res_second.err)}; }
    }
    ret res[Vector[Term], fail.Fail].ok{v};
}

# a term made in the solver, which cannot fail to make
fun made(t: Term) res[Term, fail.Fail] {
    ret res[Term, fail.Fail].ok{t};
}

val PROP_NONE:     i64 = -1;
val PROP_CONFLICT: i64 = -2;

# derive from an incompatibility all of whose terms but one hold
fun propagate_one(s: *Solver, ii: u32) res[i64, fail.Fail] {
    var open:  i64   = -1;
    val count: usize = s.incs.data[ii].terms.len;
    var t:     usize = 0;
    for (t < count) {
        val term:    *Term                    = ?s.incs.data[ii].terms.data[t];
        val res_rel: res[Relation, fail.Fail] = relation_at(s, term, s.assigns.len);
        if (sel res_rel.err) { ret res[i64, fail.Fail].err{res_rel.err}; }
        val rel: Relation = res_rel.ok;
        if (rel == REL_CONTRADICTED) { ret res[i64, fail.Fail].ok{PROP_NONE}; }
        if (rel == REL_OPEN) {
            if (open >= 0) { ret res[i64, fail.Fail].ok{PROP_NONE}; }
            open = t::i64;
        }
        t = t + 1;
    }
    if (open < 0) { ret res[i64, fail.Fail].ok{PROP_CONFLICT}; }
    val term:      Term           = s.incs.data[ii].terms.data[open::usize];
    val err_added: err[fail.Fail] = assign(s, term_inverse(?term), ii::i64, -1);
    if (sel err_added.err) { ret res[i64, fail.Fail].err{err_added.err}; }
    ret res[i64, fail.Fail].ok{term.pkg::i64};
}

fun mentions(s: *Solver, ii: u32, p: u32) bool {
    var t: usize = 0;
    for (t < s.incs.data[ii].terms.len) {
        if (s.incs.data[ii].terms.data[t].pkg == p) { ret true; }
        t = t + 1;
    }
    ret false;
}

# whether an incompatibility proves no solution exists: it has no term, or only the root's
fun is_failure(s: *Solver, ii: u32) bool {
    val terms: *Vector[Term] = ?s.incs.data[ii].terms;
    if (terms.len == 0) { ret true; }
    ret terms.len == 1 && terms.data[0].pkg == 0 && terms.data[0].positive;
}

# learn from a conflict until the partial solution can be repaired by backjumping
fun resolve_conflict(s: *Solver, start: u32) res[u32, fail.Fail] {
    var ii: u32 = start;
    for (true) {
        if (is_failure(s, ii)) { ret res[u32, fail.Fail].err{fail.user_of(diagnostic_kind.DEP_UNSATISFIABLE, explain(s, ii))}; }
        var recent_term: Term  = s.incs.data[ii].terms.data[0];
        var recent:      i64   = -1;
        var previous:    u32   = 1;
        var difference:  Term;
        var has_diff:    bool  = false;
        var t:           usize = 0;
        for (t < s.incs.data[ii].terms.len) {
            val term:          Term                  = s.incs.data[ii].terms.data[t];
            val res_satisfier: res[usize, fail.Fail] = satisfier(s, ?term);
            if (sel res_satisfier.err) { ret res[u32, fail.Fail].err{res_satisfier.err}; }
            val at: usize = res_satisfier.ok;
            if (recent < 0) {
                recent_term = term;
                recent      = at::i64;
            }
            or (recent::usize < at) {
                if (s.assigns.data[recent::usize].level > previous) { previous = s.assigns.data[recent::usize].level; }
                recent_term = term;
                recent      = at::i64;
                has_diff    = false;
            }
            or {
                if (s.assigns.data[at].level > previous) { previous = s.assigns.data[at].level; }
            }
            if (term_equal(s, ?recent_term, ?term)) {
                val not_term: Term                 = term_inverse(?term);
                val res_diff: res[Term, fail.Fail] = term_intersect(s, ?s.assigns.data[recent::usize].term, ?not_term);
                if (sel res_diff.err) { ret res[u32, fail.Fail].err{res_diff.err}; }
                difference = res_diff.ok;
                has_diff   = !term_void(s, ?difference);
                if (has_diff) {
                    val inv:           Term                  = term_inverse(?difference);
                    val res_satisfier: res[usize, fail.Fail] = satisfier(s, ?inv);
                    if (sel res_satisfier.err) { ret res[u32, fail.Fail].err{res_satisfier.err}; }
                    val di: usize = res_satisfier.ok;
                    if (di < s.assigns.len && s.assigns.data[di].level > previous) { previous = s.assigns.data[di].level; }
                }
            }
            t = t + 1;
        }
        val sat: *Assign = ?s.assigns.data[recent::usize];
        if (previous < sat.level || sat.cause == NO_INCOMPAT) {
            backtrack(s, previous);
            ret res[u32, fail.Fail].ok{ii};
        }
        var terms: Vector[Term] = collections_vector.init[Term](s.a);
        t = 0;
        for (t < s.incs.data[ii].terms.len) {
            val term: Term = s.incs.data[ii].terms.data[t];
            if (!term_equal(s, ?term, ?recent_term)) {
                val res_kept: res[usize, A.Error] = collections_vector.push[Term](?terms, term);
                if (sel res_kept.err) { ret res[u32, fail.Fail].err{fail.refused(res_kept.err)}; }
            }
            t = t + 1;
        }
        val cause: u32 = sat.cause::u32;
        t = 0;
        for (t < s.incs.data[cause].terms.len) {
            val term: Term = s.incs.data[cause].terms.data[t];
            if (term.pkg != sat.term.pkg) {
                val res_kept: res[usize, A.Error] = collections_vector.push[Term](?terms, term);
                if (sel res_kept.err) { ret res[u32, fail.Fail].err{fail.refused(res_kept.err)}; }
            }
            t = t + 1;
        }
        if (has_diff) {
            val res_kept: res[usize, A.Error] = collections_vector.push[Term](?terms, term_inverse(?difference));
            if (sel res_kept.err) { ret res[u32, fail.Fail].err{fail.refused(res_kept.err)}; }
        }
        val res_derived: res[u32, fail.Fail] = add_incompat(s, res[Vector[Term], fail.Fail].ok{terms}, C_DERIVED, ii, cause, 0, 0, 0, "", "");
        if (sel res_derived.err)       { ret res_derived; }
        if (res_derived.ok == VACUOUS) { ret res[u32, fail.Fail].err{fail.message("conflict resolution derived a vacuous incompatibility")}; }
        ii = res_derived.ok;
    }
    ret res[u32, fail.Fail].ok{ii};
}

# unit propagation from package `first` and every package it changes, resolving each conflict
fun propagate(s: *Solver, first: u32) err[fail.Fail] {
    var changed:    Vector[u32]         = collections_vector.init[u32](s.a);
    val res_seeded: res[usize, A.Error] = collections_vector.push[u32](?changed, first);
    if (sel res_seeded.err) { ret err[fail.Fail].err{fail.refused(res_seeded.err)}; }
    for (changed.len > 0) {
        val p: u32 = changed.data[changed.len - 1];
        collections_vector.truncate[u32](?changed, changed.len - 1);
        var n: usize = s.incs.len;
        for (n > 0) {
            n = n - 1;
            if (!mentions(s, n::u32, p)) { cnt; }
            val res_propagate_one: res[i64, fail.Fail] = propagate_one(s, n::u32);
            if (sel res_propagate_one.err) { ret err[fail.Fail].err{res_propagate_one.err}; }
            if (res_propagate_one.ok == PROP_CONFLICT) {
                val res_root_cause: res[u32, fail.Fail] = resolve_conflict(s, n::u32);
                if (sel res_root_cause.err) { ret err[fail.Fail].err{res_root_cause.err}; }
                val res_again: res[i64, fail.Fail] = propagate_one(s, res_root_cause.ok);
                if (sel res_again.err) { ret err[fail.Fail].err{res_again.err}; }
                collections_vector.truncate[u32](?changed, 0);
                if (res_again.ok >= 0) {
                    val res_queued: res[usize, A.Error] = collections_vector.push[u32](?changed, res_again.ok::u32);
                    if (sel res_queued.err) { ret err[fail.Fail].err{fail.refused(res_queued.err)}; }
                }
                brk;
            }
            if (res_propagate_one.ok >= 0) {
                val res_queued: res[usize, A.Error] = collections_vector.push[u32](?changed, res_propagate_one.ok::u32);
                if (sel res_queued.err) { ret err[fail.Fail].err{fail.refused(res_queued.err)}; }
            }
        }
    }
    ret err[fail.Fail].ok{};
}

fun find_pkg(s: *Solver, id: str) i64 {
    var i: usize = 0;
    for (i < s.pkgs.len) {
        if (str_equals(s.pkgs.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun sort_releases(rels: *Vector[package_source.Release]) {
    var i: usize = 1;
    for (i < rels.len) {
        var j: usize = i;
        for (j > 0 && manifest_version.compare(?rels.data[j - 1].version, ?rels.data[j].version) > 0) {
            val tmp: package_source.Release = rels.data[j - 1];
            rels.data[j - 1] = rels.data[j];
            rels.data[j]     = tmp;
            j                = j - 1;
        }
        i = i + 1;
    }
}

# the package for `id`, its releases listed the first time it is seen; a listing failure is
# kept and becomes an incompatibility when the package is needed
fun package(s: *Solver, id: str, url: str) res[u32, fail.Fail] {
    val seen: i64 = find_pkg(s, id);
    if (seen >= 0) { ret res[u32, fail.Fail].ok{seen::u32}; }
    var p:          Pkg            = Pkg{id: id, url: url, rels: collections_vector.init[package_source.Release](s.a), words: 1, listed: true, list_error: ""};
    val err_listed: err[fail.Fail] = s.src.list(s.src.ctx, url, ?p.rels);
    if (sel err_listed.err) {
        p.listed     = false;
        p.list_error = fail.describe(err_listed.err);
        collections_vector.truncate[package_source.Release](?p.rels, 0);
    }
    sort_releases(?p.rels);
    p.words = (p.rels.len + 64) / 64;
    val res_pushed: res[usize, A.Error] = collections_vector.push[Pkg](?s.pkgs, p);
    if (sel res_pushed.err) { ret res[u32, fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret res[u32, fail.Fail].ok{(res_pushed.ok - 1)::u32};
}

# the versions of package `p` the range `r` admits
fun range_set(s: *Solver, p: u32, r: *manifest_version.Range) res[*u64, fail.Fail] {
    val res_made: res[*u64, fail.Fail] = set_init(s, p, false);
    if (sel res_made.err) { ret res_made; }
    val bits: *u64  = res_made.ok;
    var k:    usize = 0;
    for (k < s.pkgs.data[p].rels.len) {
        if (manifest_version.satisfies(r, ?s.pkgs.data[p].rels.data[k].version)) { set_put(bits, k); }
        k = k + 1;
    }
    ret res[*u64, fail.Fail].ok{bits};
}

fun is_fixed(s: *Solver, id: str) bool {
    var i: u32 = 0;
    for (i < s.problem.fixed_count) {
        if (str_equals(s.problem.fixed[i], id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the index of package `p`'s locked release when `allowed` still holds it, else -1
fun locked_index(s: *Solver, p: u32, allowed: *u64) i64 {
    var i: u32 = 0;
    for (i < s.problem.lock_count) {
        if (str_equals(s.problem.locks[i].id, s.pkgs.data[p].id)) {
            var k: usize = 0;
            for (k < s.pkgs.data[p].rels.len) {
                if (set_has(allowed, k) && str_equals(s.pkgs.data[p].rels.data[k].text, s.problem.locks[i].version)) { ret k::i64; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    ret -1;
}

# record the incompatibilities release `k` of package `p` brings: the compiler it refuses, a
# requirement whose releases cannot be listed, and each range it requires. `out_conflict` is
# set when one of them already holds, so the release is not decided
fun needs_incompats(s: *Solver, p: u32, k: usize, rn: *ReleaseNeeds, out_conflict: *bool) err[fail.Fail] {
    if (sel rn.mach_range.some) {
        if (!manifest_version.satisfies(?rn.mach_range.some, ?s.compiler)) {
            val res_add_incompat: res[u32, fail.Fail] = add_incompat(s, terms_of(s, single_term(s, p, k), opt[Term].none{}),
                C_COMPILER, 0, 0, p, k::u32, 0, rn.mach, "");
            if (sel res_add_incompat.err) { ret err[fail.Fail].err{res_add_incompat.err}; }
            @out_conflict = true;
            ret err[fail.Fail].ok{};
        }
    }
    var i: usize = 0;
    for (i < rn.needs.len) {
        val need: *Need = ?rn.needs.data[i];
        if (is_fixed(s, need.id)) {
            i = i + 1;
            cnt;
        }
        val res_package: res[u32, fail.Fail] = package(s, need.id, need.url);
        if (sel res_package.err) { ret err[fail.Fail].err{res_package.err}; }
        if (!s.pkgs.data[res_package.ok].listed) {
            val res_add_incompat: res[u32, fail.Fail] = add_incompat(s, terms_of(s, single_term(s, p, k), opt[Term].none{}),
                C_UNLISTED, 0, 0, p, k::u32, res_package.ok, s.pkgs.data[res_package.ok].list_error, "");
            if (sel res_add_incompat.err) { ret err[fail.Fail].err{res_add_incompat.err}; }
            @out_conflict = true;
            i             = i + 1;
            cnt;
        }
        val res_set: res[*u64, fail.Fail] = range_set(s, res_package.ok, ?need.admits);
        if (sel res_set.err) { ret err[fail.Fail].err{res_set.err}; }
        val res_add_incompat: res[u32, fail.Fail] = add_incompat(s,
            terms_of(s, single_term(s, p, k), opt[Term].some{Term{pkg: res_package.ok, set: res_set.ok, positive: false}}),
            C_DEP, 0, 0, p, k::u32, res_package.ok, need.range, "");
        if (sel res_add_incompat.err) { ret err[fail.Fail].err{res_add_incompat.err}; }
        if (res_add_incompat.ok == VACUOUS) {
            i = i + 1;
            cnt;
        }
        var all: bool  = true;
        var t:   usize = 0;
        for (t < s.incs.data[res_add_incompat.ok].terms.len) {
            val term: *Term = ?s.incs.data[res_add_incompat.ok].terms.data[t];
            if (term.pkg != p) {
                val res_rel: res[Relation, fail.Fail] = relation_at(s, term, s.assigns.len);
                if (sel res_rel.err)             { ret err[fail.Fail].err{res_rel.err}; }
                if (res_rel.ok != REL_SATISFIED) { all = false; }
            }
            t = t + 1;
        }
        if (all) { @out_conflict = true; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# decide one version of the most constrained package still open; -1 when all are decided
fun decide_next(s: *Solver) res[i64, fail.Fail] {
    var best:       i64   = -1;
    var best_count: usize = 0;
    var best_allow: *u64  = nil;
    var p:          u32   = 1;
    for (p < s.pkgs.len::u32) {
        val res_known: res[Known, fail.Fail] = known(s, p, s.assigns.len);
        if (sel res_known.err) { ret res[i64, fail.Fail].err{res_known.err}; }
        val k: Known = res_known.ok;
        if (k.selected && !decided(s, p)) {
            val n: usize = set_count(s, p, k.allowed);
            if (best < 0 || n < best_count) {
                best       = p::i64;
                best_count = n;
                best_allow = k.allowed;
            }
        }
        p = p + 1;
    }
    if (best < 0) { ret res[i64, fail.Fail].ok{-1}; }
    val bp: u32 = best::u32;
    if (best_count == 0) {
        val res_all: res[*u64, fail.Fail] = set_init(s, bp, true);
        if (sel res_all.err) { ret res[i64, fail.Fail].err{res_all.err}; }
        var pos: *u64  = res_all.ok;
        var i:   usize = 0;
        for (i < s.assigns.len) {
            if (s.assigns.data[i].term.pkg == bp && s.assigns.data[i].term.positive) {
                val res_narrowed: res[*u64, fail.Fail] = set_combine(s, bp, pos, s.assigns.data[i].term.set, OP_AND);
                if (sel res_narrowed.err) { ret res[i64, fail.Fail].err{res_narrowed.err}; }
                pos = res_narrowed.ok;
            }
            i = i + 1;
        }
        val res_add_incompat: res[u32, fail.Fail] = add_incompat(s, terms_of(s, made(Term{pkg: bp, set: pos, positive: true}), opt[Term].none{}),
            C_NO_VERSIONS, 0, 0, bp, 0, 0, "", "");
        if (sel res_add_incompat.err) { ret res[i64, fail.Fail].err{res_add_incompat.err}; }
        ret res[i64, fail.Fail].ok{best};
    }
    var pick: i64 = locked_index(s, bp, best_allow);
    if (pick < 0) {
        var k: usize = 0;
        for (k < s.pkgs.data[bp].rels.len) {
            if (set_has(best_allow, k)) {
                if (s.problem.lowest) {
                    if (pick < 0) { pick = k::i64; }
                }
                or { pick = k::i64; }
            }
            k = k + 1;
        }
    }
    var rn:         ReleaseNeeds   = ReleaseNeeds{mach: "", mach_range: opt[manifest_version.Range].none{}, needs: collections_vector.init[Need](s.a), excluded: "", detail: nil};
    val err_filled: err[fail.Fail] = s.needs(s.ctx, s.pkgs.data[bp].id, s.pkgs.data[bp].url,
        ?s.pkgs.data[bp].rels.data[pick::usize], ?rn);
    if (sel err_filled.err) { ret res[i64, fail.Fail].err{err_filled.err}; }
    # a release that is no candidate is ruled out, like one the compiler refuses
    if (!str_is_empty(rn.excluded)) {
        val res_add_incompat: res[u32, fail.Fail] = add_incompat(s, terms_of(s, single_term(s, bp, pick::usize), opt[Term].none{}),
            C_EXCLUDED, 0, 0, bp, pick::u32, 0, rn.excluded, "");
        if (sel res_add_incompat.err) { ret res[i64, fail.Fail].err{res_add_incompat.err}; }
        s.incs.data[res_add_incompat.ok].detail = rn.detail;
        ret res[i64, fail.Fail].ok{best};
    }
    var conflict: bool           = false;
    val err_made: err[fail.Fail] = needs_incompats(s, bp, pick::usize, ?rn, ?conflict);
    if (sel err_made.err) { ret res[i64, fail.Fail].err{err_made.err}; }
    if (!conflict) {
        s.level = s.level + 1;
        val res_chosen: res[Term, fail.Fail] = single_term(s, bp, pick::usize);
        if (sel res_chosen.err) { ret res[i64, fail.Fail].err{res_chosen.err}; }
        val err_assign: err[fail.Fail] = assign(s, res_chosen.ok, NO_INCOMPAT, pick);
        if (sel err_assign.err) { ret res[i64, fail.Fail].err{err_assign.err}; }
    }
    ret res[i64, fail.Fail].ok{best};
}

# one external fact as a line of an unsatisfiable resolution's explanation
fun describe(s: *Solver, ii: u32) res[str, fail.Fail] {
    val inc:        *Incompat                        = ?s.incs.data[ii];
    var res_sprint: res[str, std_format.FormatError] = res[str, std_format.FormatError].ok{""};
    if (inc.kind == C_ROOT) {
        res_sprint = std_format.sprint(s.a, "{} requires {} {}", inc.who, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_DEP) {
        res_sprint = std_format.sprint(s.a, "{} {} requires {} {}", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_COMPILER) {
        res_sprint = std_format.sprint(s.a, "{} {} requires mach {}, and this is mach {}", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, inc.text, s.problem.compiler);
    }
    or (inc.kind == C_UNLISTED && inc.owner == 0) {
        res_sprint = std_format.sprint(s.a, "{} requires {}, and the releases of {} cannot be listed ({})", inc.who,
            s.pkgs.data[inc.target].id, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_UNLISTED) {
        res_sprint = std_format.sprint(s.a, "{} {} requires {}, and the releases of {} cannot be listed ({})", s.pkgs.data[inc.owner].id,
            s.pkgs.data[inc.owner].rels.data[inc.version].text, s.pkgs.data[inc.target].id, s.pkgs.data[inc.target].id, inc.text);
    }
    or (inc.kind == C_NO_VERSIONS) {
        res_sprint = std_format.sprint(s.a, "no release of {} is left that every requirement accepts", s.pkgs.data[inc.owner].id);
    }
    if (sel res_sprint.err)          { ret res[str, fail.Fail].err{fail.format_refused(res_sprint.err)}; }
    if (str_is_empty(res_sprint.ok)) { ret res[str, fail.Fail].err{base_catalog.unknown_catalog(s.a, "CauseKind", inc.kind::u32)}; }
    ret res[str, fail.Fail].ok{res_sprint.ok};
}

# the external facts a derivation rests on, in the order it reaches them
fun collect_external(s: *Solver, ii: u32, seen: *bool, facts: *Vector[u32]) err[fail.Fail] {
    if (seen[ii]) { ret err[fail.Fail].ok{}; }
    seen[ii] = true;
    val inc: *Incompat = ?s.incs.data[ii];
    if (inc.kind == C_DERIVED) {
        val err_left: err[fail.Fail] = collect_external(s, inc.left, seen, facts);
        if (sel err_left.err) { ret err_left; }
        ret collect_external(s, inc.right, seen, facts);
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[u32](facts, ii);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# whether `y` excludes a release of the same package as `x` for the same reason and detail
fun excluded_alike(s: *Solver, x: u32, y: u32) bool {
    val a: *Incompat = ?s.incs.data[x];
    val b: *Incompat = ?s.incs.data[y];
    if (b.kind != C_EXCLUDED || a.owner != b.owner || !str_equals(a.text, b.text)) { ret false; }
    if (a.detail == nil || b.detail == nil)                                        { ret a.detail == b.detail; }
    ret str_equals(a.detail, b.detail);
}

# the releases of one package excluded for one reason, the same words from the same load, from
# the excluded fact at `facts[at]`, each marked `done`: one line for a single release, and
# otherwise one with their count and range and the reason, named at the newest
fun describe_excluded(s: *Solver, facts: *Vector[u32], at: usize, done: *bool) res[str, fail.Fail] {
    val first:  u32   = facts.data[at];
    var count:  usize = 0;
    var oldest: u32   = first;
    var newest: u32   = first;
    var k:      usize = at;
    for (k < facts.len) {
        val f: u32 = facts.data[k];
        if (!done[k] && excluded_alike(s, first, f)) {
            done[k] = true;
            count   = count + 1;
            val rels: *package_source.Release = s.pkgs.data[s.incs.data[f].owner].rels.data;
            if (manifest_version.compare(?rels[s.incs.data[f].version].version, ?rels[s.incs.data[oldest].version].version) < 0) { oldest = f; }
            if (manifest_version.compare(?rels[s.incs.data[f].version].version, ?rels[s.incs.data[newest].version].version) > 0) { newest = f; }
        }
        k = k + 1;
    }
    val inc:      *Incompat           = ?s.incs.data[newest];
    val id:       str                 = s.pkgs.data[inc.owner].id;
    val latest:   str                 = s.pkgs.data[inc.owner].rels.data[inc.version].text;
    var res_said: res[str, fail.Fail] = diagnostic.format(s.a, "{} {} is not a candidate, because {}", id, latest, inc.text);
    if (count > 1) {
        val earliest: str = s.pkgs.data[inc.owner].rels.data[s.incs.data[oldest].version].text;
        res_said = diagnostic.format(s.a, "{} releases of {}, {} to {}, are not candidates, each because {}", count::u64, id, earliest, latest, inc.text);
    }
    if (sel res_said.err)  { ret res_said; }
    if (inc.detail == nil) { ret res_said; }
    if (count > 1)         { ret diagnostic.format(s.a, "{} (in {} {}, {})", res_said.ok, id, latest, inc.detail); }
    ret diagnostic.format(s.a, "{} ({})", res_said.ok, inc.detail);
}

# whether the root itself requires `id`, so declaring it is no way out
fun root_requires(s: *Solver, id: str) bool {
    var i: u32 = 0;
    for (i < s.problem.need_count) {
        val need: *Need = ?s.problem.needs[i];
        if (str_equals(need.id, id) && (str_is_empty(need.who) || str_equals(need.who, s.problem.root))) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the first package a derivation's facts are about, which the root can decide by declaring it
fun decider(s: *Solver, ii: u32) str {
    val inc: *Incompat = ?s.incs.data[ii];
    if (inc.kind == C_DERIVED) {
        val l: str = decider(s, inc.left);
        if (!str_is_empty(l)) { ret l; }
        ret decider(s, inc.right);
    }
    if (inc.kind == C_DEP || inc.kind == C_ROOT || inc.kind == C_UNLISTED)             { ret s.pkgs.data[inc.target].id; }
    if (inc.kind == C_COMPILER || inc.kind == C_NO_VERSIONS || inc.kind == C_EXCLUDED) { ret s.pkgs.data[inc.owner].id; }
    ret "";
}

# the text of an unsatisfiable resolution: every external fact the failure rests on, and how
# the root can decide when it does not already require the identity
fun explain(s: *Solver, ii: u32) res[str, fail.Fail] {
    val res_allocate: res[*bool, A.Error] = A.allocate[bool](s.a, s.incs.len);
    if (sel res_allocate.err) { ret res[str, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val seen: *bool = res_allocate.ok;
    var i:    usize = 0;
    for (i < s.incs.len) {
        seen[i] = false;
        i       = i + 1;
    }
    var facts:         Vector[u32]    = collections_vector.init[u32](s.a);
    val err_collected: err[fail.Fail] = collect_external(s, ii, seen, ?facts);
    if (sel err_collected.err) { ret res[str, fail.Fail].err{err_collected.err}; }
    val res_done: res[*bool, A.Error] = A.allocate[bool](s.a, facts.len + 1);
    if (sel res_done.err) { ret res[str, fail.Fail].err{fail.refused(res_done.err)}; }
    val done: *bool = res_done.ok;
    i = 0;
    for (i < facts.len) {
        done[i] = false;
        i       = i + 1;
    }
    var text: str = "no set of releases satisfies every requirement";
    i = 0;
    for (i < facts.len) {
        var res_line: res[str, fail.Fail] = res[str, fail.Fail].ok{""};
        if (done[i]) {
            i = i + 1;
            cnt;
        }
        if (s.incs.data[facts.data[i]].kind == C_EXCLUDED) { res_line = describe_excluded(s, ?facts, i, done); }
        or                                                 { res_line = describe(s, facts.data[i]); }
        if (sel res_line.err)                              { ret res_line; }
        val res_format: res[str, fail.Fail] = diagnostic.format(s.a, "{}\n    {}", text, res_line.ok);
        if (sel res_format.err) { ret res_format; }
        text = res_format.ok;
        i    = i + 1;
    }
    val id: str = decider(s, ii);
    if (str_is_empty(id) || root_requires(s, id)) { ret res[str, fail.Fail].ok{text}; }
    ret diagnostic.format(s.a,
        "{}\n  the root decides by declaring the identity itself, for example\n    [dep.{}]\n    version = \"<a range the root can use>\"", text, id);
}

fun copy_out(a: *A.Allocator, text: str) res[str, fail.Fail] {
    val res_str_dup: res[str, A.Error] = str_dup(a, text);
    if (sel res_str_dup.err) { ret res[str, fail.Fail].err{fail.refused(res_str_dup.err)}; }
    ret res[str, fail.Fail].ok{res_str_dup.ok};
}

# the selection of one identity, its texts copied out of the solver's arena into `a`
fun choice_copy(a: *A.Allocator, pk: *Pkg, rel: *package_source.Release) res[Choice, fail.Fail] {
    val res_copy_out: res[str, fail.Fail] = copy_out(a, pk.id);
    if (sel res_copy_out.err) { ret res[Choice, fail.Fail].err{res_copy_out.err}; }
    val res_url: res[str, fail.Fail] = copy_out(a, pk.url);
    if (sel res_url.err) { ret res[Choice, fail.Fail].err{res_url.err}; }
    val res_tag: res[str, fail.Fail] = copy_out(a, rel.tag);
    if (sel res_tag.err) { ret res[Choice, fail.Fail].err{res_tag.err}; }
    val res_commit: res[str, fail.Fail] = copy_out(a, rel.commit);
    if (sel res_commit.err) { ret res[Choice, fail.Fail].err{res_commit.err}; }
    val res_version: res[str, fail.Fail] = copy_out(a, rel.text);
    if (sel res_version.err) { ret res[Choice, fail.Fail].err{res_version.err}; }
    ret res[Choice, fail.Fail].ok{Choice{id: res_copy_out.ok, url: res_url.ok, tag: res_tag.ok, commit: res_commit.ok, version: res_version.ok}};
}

# the failure with its text copied out of the solver's arena into `a`, or the
# refusal to copy it
fun text_kept(a: *A.Allocator, f: fail.Fail) fail.Fail {
    val res_kept: res[str, fail.Fail] = copy_out(a, fail.describe(f));
    if (sel res_kept.err) { ret res_kept.err; }
    ret fail.owning(fail.with_text(f, res_kept.ok));
}

# the selected release of every identity the root reaches, allocated in `a`;
# the solver's scratch arena grows from `a` and returns to it
pub fun resolve(a: *A.Allocator, src: *package_source.Releases, needs: NeedsFn, needs_ctx: ptr,
    problem: *Problem) res[Vector[Choice], fail.Fail] {
    var ar:       arena.Arena;
    val err_init: err[A.Error] = arena.init(?ar, a, 0);
    if (sel err_init.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(err_init.err)}; }
    fin { arena.dnit(?ar); }
    var sa:         A.Allocator;
    val err_made_a: err[A.Error] = arena.allocator(?sa, ?ar);
    if (sel err_made_a.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(err_made_a.err)}; }
    val res_solved: res[Vector[Choice], fail.Fail] = solve(a, ?sa, src, needs, needs_ctx, problem);
    # a failure's text may live in the arena released on return
    if (sel res_solved.err) { ret res[Vector[Choice], fail.Fail].err{text_kept(a, res_solved.err)}; }
    ret res_solved;
}

# the selections for `problem`, solved in the scratch allocator `sa` and copied into `a`
fun solve(a: *A.Allocator, sa: *A.Allocator, src: *package_source.Releases, needs: NeedsFn, needs_ctx: ptr,
    problem: *Problem) res[Vector[Choice], fail.Fail] {
    val res_compiler: res[manifest_version.Version, str] = manifest_version.parse_version(problem.compiler);
    if (sel res_compiler.err) { ret res[Vector[Choice], fail.Fail].err{fail.message("the compiler version does not parse")}; }
    var s: Solver = Solver{a: sa, src: src, needs: needs, ctx: needs_ctx, problem: problem, compiler: res_compiler.ok,
        pkgs: collections_vector.init[Pkg](sa), incs: collections_vector.init[Incompat](sa), assigns: collections_vector.init[Assign](sa), level: 0, failure: ""};

    val root:       Pkg                 = Pkg{id: problem.root, url: "", rels: collections_vector.init[package_source.Release](sa), words: 1, listed: true, list_error: ""};
    val res_rooted: res[usize, A.Error] = collections_vector.push[Pkg](?s.pkgs, root);
    if (sel res_rooted.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(res_rooted.err)}; }
    # the root must be selected
    val res_base: res[u32, fail.Fail] = add_incompat(?s, terms_of(?s, full_term(?s, 0, false), opt[Term].none{}),
        C_BASE, 0, 0, 0, 0, 0, "", "");
    if (sel res_base.err) { ret res[Vector[Choice], fail.Fail].err{res_base.err}; }
    var i: u32 = 0;
    for (i < problem.need_count) {
        val need:        *Need               = ?problem.needs[i];
        val res_package: res[u32, fail.Fail] = package(?s, need.id, need.url);
        if (sel res_package.err) { ret res[Vector[Choice], fail.Fail].err{res_package.err}; }
        var who: str = need.who;
        if (str_is_empty(who)) { who = problem.root; }
        if (!s.pkgs.data[res_package.ok].listed) {
            val res_add_incompat: res[u32, fail.Fail] = add_incompat(?s, terms_of(?s, full_term(?s, 0, true), opt[Term].none{}),
                C_UNLISTED, 0, 0, 0, 0, res_package.ok, s.pkgs.data[res_package.ok].list_error, who);
            if (sel res_add_incompat.err) { ret res[Vector[Choice], fail.Fail].err{res_add_incompat.err}; }
            i = i + 1;
            cnt;
        }
        val res_set: res[*u64, fail.Fail] = range_set(?s, res_package.ok, ?need.admits);
        if (sel res_set.err) { ret res[Vector[Choice], fail.Fail].err{res_set.err}; }
        val res_add_incompat: res[u32, fail.Fail] = add_incompat(?s,
            terms_of(?s, full_term(?s, 0, true), opt[Term].some{Term{pkg: res_package.ok, set: res_set.ok, positive: false}}),
            C_ROOT, 0, 0, 0, 0, res_package.ok, need.range, who);
        if (sel res_add_incompat.err) { ret res[Vector[Choice], fail.Fail].err{res_add_incompat.err}; }
        i = i + 1;
    }
    # the root is the first decision, so backjumping to level 1 keeps it
    s.level = 1;
    val res_root_term: res[Term, fail.Fail] = full_term(?s, 0, true);
    if (sel res_root_term.err) { ret res[Vector[Choice], fail.Fail].err{res_root_term.err}; }
    val err_root_dec: err[fail.Fail] = assign(?s, res_root_term.ok, NO_INCOMPAT, 0);
    if (sel err_root_dec.err) { ret res[Vector[Choice], fail.Fail].err{err_root_dec.err}; }

    var next: i64 = 0;
    for (next >= 0) {
        val err_prop: err[fail.Fail] = propagate(?s, next::u32);
        if (sel err_prop.err) { ret res[Vector[Choice], fail.Fail].err{err_prop.err}; }
        val res_chosen: res[i64, fail.Fail] = decide_next(?s);
        if (sel res_chosen.err) { ret res[Vector[Choice], fail.Fail].err{res_chosen.err}; }
        next = res_chosen.ok;
    }

    var out: Vector[Choice] = collections_vector.init[Choice](a);
    var j:   usize          = 0;
    for (j < s.assigns.len) {
        val as: *Assign = ?s.assigns.data[j];
        if (as.cause == NO_INCOMPAT && as.term.pkg != 0) {
            val pk:         *Pkg                    = ?s.pkgs.data[as.term.pkg];
            val rel:        *package_source.Release = ?pk.rels.data[as.version::usize];
            val res_choice: res[Choice, fail.Fail]  = choice_copy(a, pk, rel);
            if (sel res_choice.err) { ret res[Vector[Choice], fail.Fail].err{res_choice.err}; }
            val res_pushed: res[usize, A.Error] = collections_vector.push[Choice](?out, res_choice.ok);
            if (sel res_pushed.err) { ret res[Vector[Choice], fail.Fail].err{fail.refused(res_pushed.err)}; }
        }
        j = j + 1;
    }
    ret res[Vector[Choice], fail.Fail].ok{out};
}
