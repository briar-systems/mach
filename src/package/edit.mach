# edit: the commands that change a project's dependencies: add and remove edit the
# manifest's [dep] tables, update moves selectors and pins. each is a transaction over the
# project root held open: the manifest is published only after the closure it declares is
# realized, and a failure names, through the report's effects, every change it leaves behind
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use std_format: std.format;
use io_error:   std.io.error;
use system_os:  std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use compile_closure: mach.compile.closure;
use mach.host.output;
use mach.host.output.remove;
use mach.session;

use manifest_edit: mach.manifest.edit;
use manifest_load: mach.manifest.load;
use mach.package;
use package_closure: mach.package.closure;
use git_member:      mach.package.git.member;
use package_path:    mach.package.path;
use package_pin:     mach.package.pin;
use mach.package.report;
use package_resolve: mach.package.resolve;
use mach.package.resolver;
use package_source: mach.package.source;

# the project root held open for an edit: the manifest is replaced through a sibling
# temporary and the dependency root is reached through it
# ---
# a:       holds the text of a refusal
# root:    the project root, as a refusal names it
# root_fd: the project root held open
pub rec Edit {
    a:       *A.Allocator;
    root:    str;
    root_fd: usize;
}

pub fun begin(edit: *Edit, a: *A.Allocator, root: str) err[fail.Fail] {
    edit.a       = a;
    edit.root    = root;
    edit.root_fd = system_os.INVALID_HANDLE;
    val opened: i64 = remove.open_path(root, ?edit.root_fd);
    if (opened < 0) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_OPEN, fail.Op{verb: "open", role: "the project root", path: root}, fail.Cause.native{opened})}; }
    val res_root: res[bool, fail.Fail] = compile_closure.check_dep_root(a, root);
    if (sel res_root.err) { ret err[fail.Fail].err{res_root.err}; }
    ret err[fail.Fail].ok{};
}

# release the project root; err when closing it fails
pub fun finish(edit: *Edit) err[fail.Fail] {
    if (edit.root_fd == system_os.INVALID_HANDLE) { ret err[fail.Fail].ok{}; }
    val closed: i64 = system_os.close(edit.root_fd);
    edit.root_fd = system_os.INVALID_HANDLE;
    if (closed < 0) { ret err[fail.Fail].err{fail.refusal(edit.a, diagnostic_kind.FS_CLOSE, fail.Op{verb: "close", role: "the project root", path: edit.root}, fail.Cause.native{closed})}; }
    ret err[fail.Fail].ok{};
}

# `outcome` of the work an edit held the root for, then the edit released: a failure to close
# the root is the outcome when the work succeeded, and is reported beside it otherwise
fun finished(edit: *Edit, outcome: err[fail.Fail], rep: *report.Report) err[fail.Fail] {
    val err_closed: err[fail.Fail] = finish(edit);
    if (sel err_closed.ok) { ret outcome; }
    if (sel outcome.ok)    { ret err_closed; }
    report.fault(rep, err_closed.err);
    ret outcome;
}

# start recording pins for a new project at `root`, as `mach init` does before it adds the
# project's dependencies; a root that records them already is left as it is
pub fun start(s: *session.Session, root: str) err[fail.Fail] {
    val pins:      package_pin.Pin = git_member.pin(s);
    val err_begun: err[fail.Fail]  = pins.begin(pins.ctx, root);
    if (sel err_begun.err) { ret err_begun; }
    val res_mode: res[u8, fail.Fail] = pins.mode(pins.ctx, root);
    if (sel res_mode.err) { ret err[fail.Fail].err{res_mode.err}; }
    ret err[fail.Fail].ok{};
}

# `mach dep update`: move one root-declared or transitive identity, or every one under `all`
# ---
# s:       the session; a failure may borrow from it, so the caller shows it before ending it
# a:       the storage the operation works in
# root:    the project root directory
# all:     move every identity
# name:    the identity to move when not `all`
# quiet:   report no progress lines
# lowest:  resolve each range to its lowest admitted release
# offline: fetch nothing
# rep:     receives progress, notes, and the effects a failure left
# ret:     err naming the failure
pub fun update(s: *session.Session, a: *A.Allocator, root: str, all: bool, name: str, quiet: bool, lowest: bool, offline: bool,
    rep: *report.Report) err[fail.Fail] {
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(s, a, root, rep);
    if (sel res_opened.err) { ret err[fail.Fail].err{res_opened.err}; }
    var op: package_closure.Operation = res_opened.ok;
    fin { package_closure.dnit(?op); }
    val res_mode: res[u8, fail.Fail] = op.pins.mode(op.pins.ctx, root);
    if (sel res_mode.err) { ret err[fail.Fail].err{res_mode.err}; }
    var edit:    Edit;
    val err_txn: err[fail.Fail] = begin(?edit, a, root);
    if (sel err_txn.err) { ret finished(?edit, err_txn, rep); }
    var closure:     Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    val err_applied: err[fail.Fail]                  = update_apply(?op, res_mode.ok, all, name, quiet, lowest, offline, ?closure);
    package_closure.requests_dnit(a, ?closure);
    ret finished(?edit, err_applied, rep);
}

# update: the fixed git selectors move first (a ref is fetched and checked out), so their
# manifests are the closure's when the version ranges resolve; then every chosen release is
# realized and the closure is pulled, which syncs every path copy once and reports it
#
# `closure` receives the closure the final pull realized, which the caller frees
pub fun update_apply(op: *package_closure.Operation, mode: u8, all: bool, name: str, quiet: bool, lowest: bool,
    offline: bool, closure: *Vector[package_closure.Request]) err[fail.Fail] {
    val a:           *A.Allocator      = op.a;
    val res_mt_path: res[str, A.Error] = types_path.join(a, op.root, manifest_load.MANIFEST_FILE);
    if (sel res_mt_path.err) { ret err[fail.Fail].err{fail.refused(res_mt_path.err)}; }
    val res_parse_file: res[manifest_load.Doc, fail.Fail] = package_closure.parse_file(a, op.s.sources, res_mt_path.ok);
    if (sel res_parse_file.err) { ret err[fail.Fail].err{res_parse_file.err}; }
    var mt: manifest_load.Doc = res_parse_file.ok;

    var reqs: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?reqs); }
    val err_seed: err[fail.Fail] = package_closure.declared(a, ?reqs, op.root, ?mt.table);
    if (sel err_seed.err) { ret err_seed; }
    var known: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?known); }
    var complete: bool = false;
    fin {
        if (!complete) {
            package_closure.effects(op, ?reqs);
            package_closure.effects(op, ?known);
        }
    }

    # a name the root does not declare is looked up in the realized closure
    val transitive: bool = !all && package_closure.index(?reqs, name) < 0;
    if (!transitive) {
        val err_advanced: err[fail.Fail] = advance_fixed(op, mode, ?reqs, true, all, name, quiet, offline);
        if (sel err_advanced.err) { ret err_advanced; }
    }
    var walk:          package_closure.Walk = package_closure.Walk{offline: offline, all: all, name: name, quiet: quiet};
    val err_preflight: err[fail.Fail]       = package_closure.preflight(op, ?mt, ?known, true, ?walk);
    if (sel err_preflight.err) { ret err_preflight; }
    if (transitive && package_closure.index(?known, name) < 0) {
        val res_msg: res[str, std_format.FormatError] = std_format.sprint(a, "dependency '{}' is not in the dependency closure", name);
        if (sel res_msg.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_IN_CLOSURE, "the dependency is not in the dependency closure")}; }
        ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_IN_CLOSURE, res_msg.ok)};
    }
    # version ranges resolve together; naming one unlocks only that identity
    var unlocked: str = nil;
    if (!all) { unlocked = name; }
    val res_resolved: res[package_resolve.Resolution, fail.Fail] = package_resolve.versions(op, ?mt, lowest, !all, unlocked, false, ?walk);
    if (sel res_resolved.err) { ret err[fail.Fail].err{res_resolved.err}; }
    if (!quiet)               { notes(op.rep, ?res_resolved.ok.notes); }
    var picks:  Vector[resolver.Choice] = res_resolved.ok.picks;
    val picked: bool                    = !all && package_resolve.pick_index(?picks, name) >= 0;
    # a fixed selector the closure declares moves to the commit resolution read it at
    if (all || (transitive && !picked)) {
        val err_advanced: err[fail.Fail] = advance_fixed(op, mode, ?known, false, all, name, quiet, offline);
        if (sel err_advanced.err) { ret err_advanced; }
    }

    val err_moved: err[fail.Fail] = realize_picks(op, mode, ?picks, quiet, offline);
    if (sel err_moved.err) { ret err_moved; }

    val err_pulled: err[fail.Fail] = package_closure.realize(op, closure, quiet, offline, false, nil, ?picks);
    if (sel err_pulled.err) { ret err_pulled; }
    complete = true;
    ret err[fail.Fail].ok{};
}

# a resolution's notes, as a command shows them unless --quiet
pub fun notes(rep: *report.Report, lines: *Vector[str]) {
    var i: usize = 0;
    for (i < lines.len) {
        report.line(rep, lines.data[i]);
        i = i + 1;
    }
}

# move every fixed git selector among `targets` (all of them, or the one `name` names), the
# root's own declarations among them only when `roots`: its ref is fetched and checked out, and
# a recorded pin is moved with it. a path has no selector to move; the closure pull that follows
# syncs its copy
fun advance_fixed(op: *package_closure.Operation, mode: u8, targets: *Vector[package_closure.Request],
    roots: bool, all: bool, name: str, quiet: bool, offline: bool) err[fail.Fail] {
    val a: *A.Allocator = op.a;
    var i: usize        = 0;
    for (i < targets.len) {
        val r: *package_closure.Request = ?targets.data[i];
        i = i + 1;
        if (r.root_decl && !roots)                           { cnt; }
        if (!all && !str_equals(r.id, name))                 { cnt; }
        if (package_closure.selects_release(r) || !r.is_git) { cnt; }

        val res_dep_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, r.id);
        if (sel res_dep_full.err) { ret err[fail.Fail].err{res_dep_full.err}; }
        val dep_full: str = res_dep_full.ok;

        # a slot realized at the selector just now has nothing to advance
        var realized: u8             = package_source.REALIZED_NOTHING;
        val err_slot: err[fail.Fail] = package_closure.acquire(op, r, mode, false, quiet, offline, false, ?realized);
        if (sel err_slot.err)                                                                          { ret err_slot; }
        if (realized == package_source.REALIZED_CLONED || realized == package_source.REALIZED_ADOPTED) { cnt; }

        val res_old: res[str, fail.Fail] = op.checkouts.revision(op.checkouts.ctx, dep_full);
        if (sel res_old.err) { ret err[fail.Fail].err{res_old.err}; }
        val old:         str            = res_old.ok;
        val exact:       bool           = !ref_advanceable(r.ref);
        val err_advance: err[fail.Fail] = op.checkouts.advance(op.checkouts.ctx, r.id, dep_full, r.ref, offline);
        if (sel err_advance.err) { ret err_advance; }
        r.effect = "fetched and checked out the requested selector";
        val res_recorded: res[bool, fail.Fail] = op.pins.recorded(op.pins.ctx, op.root, r.id, mode);
        if (sel res_recorded.err) { ret err[fail.Fail].err{res_recorded.err}; }
        if (res_recorded.ok) {
            val err_record: err[fail.Fail] = op.pins.record(op.pins.ctx, op.root, r.id);
            if (sel err_record.err) { ret err_record; }
            r.effect = "checked out and staged the requested selector";
        }
        val res_fresh: res[str, fail.Fail] = op.checkouts.revision(op.checkouts.ctx, dep_full);
        if (sel res_fresh.err) { ret err[fail.Fail].err{res_fresh.err}; }
        val fresh: str = res_fresh.ok;
        if (!quiet) {
            if (exact && str_equals(old, fresh)) { report.linef(op.rep, a, "{}: {} (exact selector, already pinned)", r.id, old); }
            or (exact)                           { report.linef(op.rep, a, "{}: {} -> {} (pinned to the exact selector)", r.id, old, fresh); }
            or                                   { report.linef(op.rep, a, "{}: {} -> {}", r.id, old, fresh); }
        }
    }
    ret err[fail.Fail].ok{};
}

fun ref_advanceable(ref: str) bool {
    if (str_is_empty(ref))               { ret true; }
    if (str_starts_with(ref, "branch/")) { ret true; }
    if (str_starts_with(ref, "tag/"))    { ret false; }
    if (str_starts_with(ref, "commit/")) { ret false; }
    ret true;
}

# move every chosen release's slot to its tag: a missing slot is acquired, and one pinned
# elsewhere is checked out and its pin recorded
fun realize_picks(op: *package_closure.Operation, mode: u8, picks: *Vector[resolver.Choice], quiet: bool,
    offline: bool) err[fail.Fail] {
    val a: *A.Allocator = op.a;
    var i: usize        = 0;
    for (i < picks.len) {
        val pick: *resolver.Choice = ?picks.data[i];
        i = i + 1;
        val res_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, pick.id);
        if (sel res_full.err) { ret err[fail.Fail].err{res_full.err}; }
        val full:    str                              = res_full.ok;
        val res_ref: res[str, std_format.FormatError] = std_format.sprint(a, "tag/{}", pick.tag);
        if (sel res_ref.err) { ret err[fail.Fail].err{fail.format_refused(res_ref.err)}; }
        var request: package_closure.Request = package_closure.Request{id: pick.id, url: pick.url, src_path: "", ref: res_ref.ok, version: "", chain: "",
            root_decl: false, is_git: true, effect: ""};
        val res_present: res[bool, io_error.Error] = fs.exists(full);
        if (!(sel res_present.ok && res_present.ok)) {
            var realized:     u8             = package_source.REALIZED_NOTHING;
            val err_acquired: err[fail.Fail] = package_closure.acquire(op, ?request, mode, false, quiet, offline, false, ?realized);
            if (sel err_acquired.err) { ret err_acquired; }
            cnt;
        }
        # the pin is the recorded one: a checkout at the chosen release that drifted from its
        # pin still moves, or the closure pull after this would restore the old pin
        val res_at_release: res[bool, fail.Fail] = op.checkouts.at_release(op.checkouts.ctx, op.root, pick.id, full, pick.version);
        if (sel res_at_release.err) { ret err[fail.Fail].err{res_at_release.err}; }
        if (res_at_release.ok)      { cnt; }
        val err_advance: err[fail.Fail] = op.checkouts.advance(op.checkouts.ctx, pick.id, full, request.ref, offline);
        if (sel err_advance.err) { ret err_advance; }
        val res_recorded: res[bool, fail.Fail] = op.pins.recorded(op.pins.ctx, op.root, pick.id, mode);
        if (sel res_recorded.err) { ret err[fail.Fail].err{res_recorded.err}; }
        if (res_recorded.ok) {
            val err_record: err[fail.Fail] = op.pins.record(op.pins.ctx, op.root, pick.id);
            if (sel err_record.err) { ret err_record; }
        }
        if (!quiet) { report.linef(op.rep, a, "{}: {} (release {})", pick.id, pick.tag, pick.version); }
    }
    ret err[fail.Fail].ok{};
}

# the caret range of the release resolution picks for the running compiler for the git
# dependency `spec` declares, added to the manifest `text` of the project at `root`, which
# need not exist yet. nothing is written or checked out, as `mach init` resolves its
# dependencies before it writes the project
# ---
# s:     the session; a failure may borrow from it, so the caller shows it before ending it
# a:     the storage the operation works in
# root:  the project root directory
# text:  the project's manifest, as it will be written
# spec:  the dependency, a git source with no selector
# quiet: report no progress line
# rep:   receives progress and notes
# ret:   the range, `^X.Y.Z`; err naming the failure
pub fun release_range(s: *session.Session, a: *A.Allocator, root: str, text: str, spec: *manifest_edit.DepTableSpec,
    quiet: bool, rep: *report.Report) res[str, fail.Fail] {
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(s, a, root, rep);
    if (sel res_opened.err) { ret res[str, fail.Fail].err{res_opened.err}; }
    var op: package_closure.Operation = res_opened.ok;
    fin { package_closure.dnit(?op); }
    val res_mt_path: res[str, A.Error] = types_path.join(a, root, manifest_load.MANIFEST_FILE);
    if (sel res_mt_path.err) { ret res[str, fail.Fail].err{fail.refused(res_mt_path.err)}; }
    var walk: package_closure.Walk = package_closure.Walk{offline: false, all: false, name: nil, quiet: quiet};
    ret chosen_range(?op, res_mt_path.ok, text, spec, ?walk);
}

# the caret range of the release resolution picks for the git dependency `spec` declares
# without a selector, resolved over the manifest `text` at `mt_path` with the dependency added
fun chosen_range(op: *package_closure.Operation, mt_path: str, text: str, spec: *manifest_edit.DepTableSpec, walk: *package_closure.Walk) res[str, fail.Fail] {
    val a:     *A.Allocator               = op.a;
    var probe: manifest_edit.DepTableSpec = @spec;
    probe.version = ">=0.0.0";
    val res_probe: res[str, fail.Fail] = manifest_edit.dep_table_add(a, text, ?probe);
    if (sel res_probe.err) { ret res_probe; }
    val res_probe_doc: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(a, op.s.sources, mt_path, res_probe.ok);
    if (sel res_probe_doc.err) { ret res[str, fail.Fail].err{res_probe_doc.err}; }
    var doc:        manifest_load.Doc                          = res_probe_doc.ok;
    val res_chosen: res[package_resolve.Resolution, fail.Fail] = package_resolve.versions(op, ?doc, false, true, spec.name, false, walk);
    manifest_load.doc_dnit(a, ?doc);
    if (sel res_chosen.err) { ret res[str, fail.Fail].err{res_chosen.err}; }
    val at: i64 = package_resolve.pick_index(?res_chosen.ok.picks, spec.name);
    if (at < 0) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.DEP_NO_RELEASE, "resolution chose no release for the new dependency")}; }
    val res_caret: res[str, std_format.FormatError] = std_format.sprint(a, "^{}", res_chosen.ok.picks.data[at::usize].version);
    if (sel res_caret.err) { ret res[str, fail.Fail].err{fail.format_refused(res_caret.err)}; }
    ret res[str, fail.Fail].ok{res_caret.ok};
}

# add or remove the [dep] table `spec` describes and realize the closure it leaves
# ---
# s:       the session; a failure may borrow from it, so the caller shows it before ending it
# a:       the storage the operation works in
# root:    the project root directory
# spec:    the table to add, or the name to remove
# name:    the dependency identity
# adding:  add the table; false removes it
# purge:   on remove, delete dep/<name> as well
# quiet:   report no progress lines
# realize: realize the closure; false only writes the table
# offline: fetch nothing
# rep:     receives progress, notes, and the effects a failure left
# ret:     err naming the failure
pub fun change(s: *session.Session, a: *A.Allocator, root: str, spec: *manifest_edit.DepTableSpec, name: str, adding: bool,
    purge: bool, quiet: bool, realize: bool, offline: bool, rep: *report.Report) err[fail.Fail] {
    val res_opened: res[package_closure.Operation, fail.Fail] = package_closure.init(s, a, root, rep);
    if (sel res_opened.err) { ret err[fail.Fail].err{res_opened.err}; }
    var op: package_closure.Operation = res_opened.ok;
    fin { package_closure.dnit(?op); }
    val res_mode: res[u8, fail.Fail] = op.pins.mode(op.pins.ctx, root);
    if (sel res_mode.err) { ret err[fail.Fail].err{res_mode.err}; }
    var edit:    Edit;
    val err_txn: err[fail.Fail] = begin(?edit, a, root);
    if (sel err_txn.err) { ret finished(?edit, err_txn, rep); }
    val err_applied: err[fail.Fail] = apply(?edit, ?op, res_mode.ok, spec, name, adding, purge, quiet, realize, offline);
    ret finished(?edit, err_applied, rep);
}

# realize the dependency `add` declares by path or by ref, naming what it did in `completed`
fun realize_added(op: *package_closure.Operation, mode: u8, spec: *manifest_edit.DepTableSpec,
    name: str, quiet: bool, offline: bool, completed: *str) err[fail.Fail] {
    if (spec.source == manifest_edit.DEP_SOURCE_PATH) {
        var src: str = spec.value;
        if (!types_path.is_abs(src)) {
            val res_join: res[str, A.Error] = types_path.join(op.a, op.root, spec.value);
            if (sel res_join.err) { ret err[fail.Fail].err{fail.refused(res_join.err)}; }
            src = res_join.ok;
        }
        val res_realize: res[bool, fail.Fail] = package_path.realize(op.s, op.root, name, src, op.rep);
        if (sel res_realize.err) { ret err[fail.Fail].err{res_realize.err}; }
        @completed = "copied the local source";
        ret err[fail.Fail].ok{};
    }
    var request: package_closure.Request;
    request.version     = "";
    request.id          = name;
    request.url         = spec.value;
    request.src_path    = "";
    request.ref         = spec.ref;
    request.chain       = "";
    request.root_decl   = true;
    request.is_git      = true;
    request.via_release = false;
    request.seed        = nil;
    request.effect      = "";
    var realized:     u8             = package_source.REALIZED_NOTHING;
    val err_acquired: err[fail.Fail] = package_closure.acquire(op, ?request, mode, true, quiet, offline, false, ?realized);
    if (!str_is_empty(request.effect)) { @completed = request.effect; }
    ret err_acquired;
}

# add or remove a declaration within an open edit. realize false only declares: the manifest
# gains the table (a git one at its resolved range) and nothing is checked out
pub fun apply(edit: *Edit, op: *package_closure.Operation, mode: u8, spec: *manifest_edit.DepTableSpec, name: str, adding: bool,
    purge: bool, quiet: bool, realize: bool, offline: bool) err[fail.Fail] {
    val a:           *A.Allocator         = op.a;
    var walk:        package_closure.Walk = package_closure.Walk{offline: offline, all: false, name: nil, quiet: quiet};
    val res_mt_path: res[str, A.Error]    = types_path.join(a, op.root, manifest_load.MANIFEST_FILE);
    if (sel res_mt_path.err) { ret err[fail.Fail].err{fail.refused(res_mt_path.err)}; }
    val mt_path: str = res_mt_path.ok;
    fin { str_free(a, mt_path); }

    val res_source: res[str, fs.FsError] = fs.read_string(a, mt_path);
    if (sel res_source.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "read", path: mt_path}, fail.Cause.fs{res_source.err})}; }
    val source: str = res_source.ok;
    fin { str_free(a, source); }

    # a git dependency added without a selector takes the caret range of the release resolution picks
    val choose_range: bool = adding && spec.source == manifest_edit.DEP_SOURCE_GIT && str_is_empty(spec.ref)
        && (spec.version == nil || str_is_empty(spec.version));
    if (choose_range) {
        val res_range: res[str, fail.Fail] = chosen_range(op, mt_path, source, spec, ?walk);
        if (sel res_range.err) { ret err[fail.Fail].err{res_range.err}; }
        spec.version = res_range.ok;
    }

    var res_candidate: res[str, fail.Fail];
    if (adding)                { res_candidate = manifest_edit.dep_table_add(a, source, spec); }
    or                         { res_candidate = manifest_edit.dep_table_remove(a, source, name); }
    if (sel res_candidate.err) { ret err[fail.Fail].err{res_candidate.err}; }
    val candidate: str = res_candidate.ok;
    fin { str_free(a, candidate); }
    if (!realize) { ret publish(op, mt_path, candidate, name, adding, quiet); }

    val res_table: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(a, op.s.sources, mt_path, candidate);
    if (sel res_table.err) { ret err[fail.Fail].err{res_table.err}; }
    var table: manifest_load.Doc = res_table.ok;
    fin { manifest_load.doc_dnit(a, ?table); }
    var known: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?known); }
    val err_preflight: err[fail.Fail] = package_closure.preflight(op, ?table, ?known, true, ?walk);
    if (sel err_preflight.err) { ret err_preflight; }
    val still_required: bool = !adding && package_closure.index(?known, name) >= 0;
    if (still_required && purge) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_STILL_REQUIRED, "the dependency is still required by the closure, so its checkout cannot be purged")}; }
    var removing_git: bool = false;
    if (!adding) {
        val res_original: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_parse(a, op.s.sources, mt_path, source);
        if (sel res_original.err) { ret err[fail.Fail].err{res_original.err}; }
        var original:         manifest_load.Doc      = res_original.ok;
        val opt_declarations: opt[*toml_value.Table] = toml_lookup.get_table(?original.table, "dep");
        if (sel opt_declarations.some) {
            val opt_declaration: opt[*toml_value.Table] = toml_lookup.get_table(opt_declarations.some, name);
            if (sel opt_declaration.some) { removing_git = !str_is_empty(package_closure.key_text(opt_declaration.some, "git")); }
        }
        manifest_load.doc_dnit(a, ?original);
    }
    if (adding && spec.source == manifest_edit.DEP_SOURCE_PATH) {
        val res_destination: res[str, fail.Fail] = package.dep_full_of(a, op.root, name);
        if (sel res_destination.err) { ret err[fail.Fail].err{res_destination.err}; }
        val destination: str = res_destination.ok;
        fin { str_free(a, destination); }
        val res_exists:     res[bool, io_error.Error] = fs.exists(destination);
        val res_is_symlink: res[bool, io_error.Error] = fs.is_symlink(destination);
        if ((sel res_exists.ok && res_exists.ok))         { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_DESTINATION_EXISTS, "the dependency destination already exists and was left in place")}; }
        if ((sel res_is_symlink.ok && res_is_symlink.ok)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.DEP_DESTINATION_EXISTS, "the dependency destination already exists and was left in place")}; }
    }
    var completed: str  = nil;
    var success:   bool = false;
    fin {
        if (!success && completed != nil) {
            report.effectf(op.rep, "{} for dep/{} before this failure. inspect Git and mach.toml before retrying", completed, name);
        }
    }

    # a dependency added by path or by ref is realized first, so the ranges it declares
    # are the closure's when they resolve; one added by range is a pick of that resolution
    val fixed_add: bool = adding && (spec.source == manifest_edit.DEP_SOURCE_PATH || spec.version == nil || str_is_empty(spec.version));
    if (fixed_add) {
        val err_placed: err[fail.Fail] = realize_added(op, mode, spec, name, quiet, offline, ?completed);
        if (sel err_placed.err) { ret err_placed; }
    }
    val res_resolved: res[package_resolve.Resolution, fail.Fail] = package_resolve.versions(op, ?table, false, true, name, false, ?walk);
    if (sel res_resolved.err) { ret err[fail.Fail].err{res_resolved.err}; }
    if (!quiet)               { notes(op.rep, ?res_resolved.ok.notes); }
    var picks: Vector[resolver.Choice] = res_resolved.ok.picks;

    if (!adding) {
        if (!still_required && removing_git) {
            val err_drop: err[fail.Fail] = op.pins.drop(op.pins.ctx, op.root, name, mode, op.rep);
            if (sel err_drop.err)                    { ret err_drop; }
            if (mode == package_pin.REPOSITORY_ROOT) { completed = "removed the dependency registration and kept its checkout"; }
        }
        if (purge) {
            val res_removed: res[usize, fail.Fail] = purge_beneath(op.a, edit.root_fd, name);
            if (sel res_removed.err) { ret err[fail.Fail].err{res_removed.err}; }
            completed = "removed the dependency registration and purged its checkout";
        }
    }
    or (!fixed_add) {
        val err_placed: err[fail.Fail] = realize_picks(op, mode, ?picks, quiet, offline);
        if (sel err_placed.err) { ret err_placed; }
        completed = "realized the selected release";
    }

    var closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?closure); }
    val err_pulled: err[fail.Fail] = package_closure.realize(op, ?closure, quiet, offline, false, ?table.table, ?picks);
    if (sel err_pulled.err) { ret err_pulled; }
    val err_published: err[fail.Fail] = publish(op, mt_path, candidate, name, adding, quiet);
    if (sel err_published.err) {
        package_closure.effects(op, ?closure);
        ret err_published;
    }
    success = true;
    ret err[fail.Fail].ok{};
}

fun publish(op: *package_closure.Operation, mt_path: str, text: str, name: str, adding: bool, quiet: bool) err[fail.Fail] {
    val err_replace: err[fail.Fail] = output.replace(op.a, mt_path, text::*u8, str_len(text), 0o644);
    if (sel err_replace.err) { ret err_replace; }
    if (!quiet) {
        if (adding) { report.linef(op.rep, op.a, "added [dep.{}]", name); }
        or          { report.linef(op.rep, op.a, "removed [dep.{}]", name); }
    }
    ret err[fail.Fail].ok{};
}

fun purge_beneath(a: *A.Allocator, root_fd: usize, name: str) res[usize, fail.Fail] {
    var fd:     usize = system_os.INVALID_HANDLE;
    val opened: i64   = remove.open_dir(root_fd, compile_closure.DEP_DIR, ?fd);
    if (system_os.error_kind(opened) == io_error.NOT_FOUND) { ret res[usize, fail.Fail].ok{0}; }
    val refused: io_error.Kind = system_os.error_kind(opened);
    if (opened < 0 && (refused == io_error.NOT_DIRECTORY || refused == io_error.LOOP)) { ret res[usize, fail.Fail].err{fail.user(diagnostic_kind.DEP_NOT_DIRECTORY, compile_closure.DEP_ROOT_REFUSED)}; }
    if (opened < 0)                                                                    { ret res[usize, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_OPEN, fail.Op{verb: "open", role: "the dependency root", path: compile_closure.DEP_DIR}, fail.Cause.native{opened})}; }
    # a directory opened read-only loses nothing to a refused close
    fin { system_os.close(fd); }
    val res_shown: res[types_path.Path, A.Error] = types_path.join(a, compile_closure.DEP_DIR, name);
    if (sel res_shown.err) { ret res[usize, fail.Fail].err{fail.refused(res_shown.err)}; }
    val shown: str = res_shown.ok;
    fin { str_free(a, shown); }
    val rr: remove.Removal = remove.relative(fd, name);
    if (rr.failed) {
        if (rr.containment) { ret res[usize, fail.Fail].err{remove.with_cleanup(a, fail.user(diagnostic_kind.DEP_PATH_ESCAPE, "the dependency directory is outside the dependency root or reached through a symlink, so nothing was removed"), rr, shown)}; }
        ret res[usize, fail.Fail].err{remove.refusal(a, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: "the dependency checkout", path: shown}, rr)};
    }
    ret res[usize, fail.Fail].ok{rr.removed};
}
