# resolve: version resolution over a project's closure. every identity the closure reaches
# through a version range resolves together against the releases its source publishes
# (resolver.mach); an identity the root or a fixed edge selects by ref or path is fixed, and a
# requirement on it is overridden
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_version:     mach.base.version;
use compile_closure:  mach.compile.closure;
use manifest_version: mach.manifest.version;
use mach.session;

use manifest_load:  mach.manifest.load;
use manifest_model: mach.manifest.model;
use mach.package;
use package_closure: mach.package.closure;
use git_member:      mach.package.git.member;
use mach.package.report;
use mach.package.resolver;
use package_source: mach.package.source;

# notes are the lines a command prints unless --quiet: an --offline resolution, and each
# requirement a root `ref` or `path` overrides
pub rec Resolution {
    picks:  Vector[resolver.Choice];
    ranged: bool;
    notes:  Vector[str];
}

# what reading a release's requirements works through: the releases table, the root
# manifest (an identity it declares is the root's to select, not a release's), and the
# project whose dep/<id> checkouts serve offline listings of transitive identities
rec Needs {
    s:          *session.Session;
    releases:   *package_source.Releases;
    root:       *manifest_model.Manifest;
    local_root: str;
}

pub fun pick_index(picks: *Vector[resolver.Choice], id: str) i64 {
    var i: usize = 0;
    for (i < picks.len) {
        if (str_equals(picks.data[i].id, id)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

fun str_listed(list: *Vector[str], id: str) bool {
    var i: usize = 0;
    for (i < list.len) {
        if (str_equals(list.data[i], id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# keep an owned release version as a lock, freeing it when it names no release or is not kept
fun lock_push(a: *A.Allocator, locks: *Vector[resolver.Lock], id: str, version: str) {
    if (str_is_empty(version)) {
        str_free(a, version);
        ret;
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[resolver.Lock](locks, resolver.Lock{id: id, version: version});
    if (sel res_pushed.err) { str_free(a, version); }
}

fun locks_dnit(a: *A.Allocator, locks: *Vector[resolver.Lock]) {
    var i: usize = 0;
    for (i < locks.len) {
        str_free(a, locks.data[i].version);
        i = i + 1;
    }
    collections_vector.dnit[resolver.Lock](locks);
}

fun lock_listed(locks: *Vector[resolver.Lock], id: str) bool {
    var i: usize = 0;
    for (i < locks.len) {
        if (str_equals(locks.data[i].id, id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# resolve every identity the closure reaches through a version range: the root's
# own ranges and every range a dependency reached by a ref or a path declares,
# read from the same closure walk `pull` realizes. an identity the root or such a
# dependency selects by ref or path is fixed, and a requirement on it is
# overridden. locks keep each realized version-selected checkout where it is
# unless `unlocked` names it or `lock` is false; an identity with no checkout yet
# is seeded by the pin of the dependency declaring it, when one exists and the range
# admits it, so a dependency pulls its own tested pin in
#
# `root_notes` names the root's own overrides of a chosen release's requirements too; a
# command that pulls the closure afterwards leaves them to the pull, which names every
# requirement the root overrides
pub fun versions(op: *package_closure.Operation, doc: *manifest_load.Doc, lowest: bool, lock: bool, unlocked: str,
    root_notes: bool, walk: *package_closure.Walk) res[Resolution, fail.Fail] {
    var hears: *report.Report = op.rep;
    if (walk.quiet) { hears = nil; }
    val res_opened: res[package_source.Releases, fail.Fail] = git_member.releases(op.s, walk.offline, "", hears);
    if (sel res_opened.err) { ret res[Resolution, fail.Fail].err{res_opened.err}; }
    var releases:     package_source.Releases    = res_opened.ok;
    val res_resolved: res[Resolution, fail.Fail] = versions_listed(op, doc, lowest, lock, unlocked, root_notes, walk, ?releases);
    val err_closed:   err[fail.Fail]             = releases.close(releases.ctx);
    if (sel err_closed.err) {
        if (sel res_resolved.err) { ret res[Resolution, fail.Fail].err{fail.with_secondary(op.a, res_resolved.err, err_closed.err)}; }
        ret res[Resolution, fail.Fail].err{err_closed.err};
    }
    ret res_resolved;
}

# `versions` reading the releases each identity offers from `releases`
fun versions_listed(op: *package_closure.Operation, doc: *manifest_load.Doc, lowest: bool, lock: bool, unlocked: str,
    root_notes: bool, walk: *package_closure.Walk, releases: *package_source.Releases) res[Resolution, fail.Fail] {
    val s:          *session.Session                        = op.s;
    val a:          *A.Allocator                            = op.a;
    val offline:    bool                                    = walk.offline;
    var out:        Resolution                              = Resolution{picks: collections_vector.init[resolver.Choice](a), ranged: false, notes: collections_vector.init[str](a)};
    val res_parsed: res[manifest_model.Manifest, fail.Fail] = manifest_load.parse(a, ?s.interner, doc);
    if (sel res_parsed.err) { ret res[Resolution, fail.Fail].err{res_parsed.err}; }
    var m: manifest_model.Manifest = res_parsed.ok;
    fin { manifest_model.dnit(?m, a); }
    var needs_of:  Vector[resolver.Need] = collections_vector.init[resolver.Need](a);
    var fixed:     Vector[str]           = collections_vector.init[str](a);
    var fixed_by:  Vector[str]           = collections_vector.init[str](a);
    var fixed_who: Vector[str]           = collections_vector.init[str](a);
    var fixed_own: Vector[bool]          = collections_vector.init[bool](a);
    var locks:     Vector[resolver.Lock] = collections_vector.init[resolver.Lock](a);
    fin { locks_dnit(s.build_alloc, ?locks); }
    var nd:      Needs = Needs{s: s, releases: releases, root: ?m, local_root: op.root};
    var root_id: str   = package_closure.key_text(?doc.table, "project.id");
    if (str_is_empty(root_id)) { root_id = "(project)"; }

    var closure: Vector[package_closure.Request] = collections_vector.init[package_closure.Request](a);
    fin { package_closure.requests_dnit(a, ?closure); }
    val err_walked: err[fail.Fail] = package_closure.preflight(op, doc, ?closure, true, walk);
    if (sel err_walked.err) { ret res[Resolution, fail.Fail].err{err_walked.err}; }

    # fixed identities first: a range on one of them is overridden
    var i: usize = 0;
    for (i < closure.len) {
        val r: *package_closure.Request = ?closure.data[i];
        i = i + 1;
        if (r.via_release || package_closure.selects_release(r)) { cnt; }
        collections_vector.push[str](?fixed, r.id);
        var res_sprint: res[str, std_format.FormatError];
        if (!r.is_git)          { res_sprint = std_format.sprint(a, "path \"{}\"", r.src_path); }
        or                      { res_sprint = std_format.sprint(a, "ref \"{}\"", r.ref); }
        if (sel res_sprint.err) { ret res[Resolution, fail.Fail].err{fail.message(fail.format_text(res_sprint.err))}; }
        collections_vector.push[str](?fixed_by, res_sprint.ok);
        var who: str = root_id;
        if (!r.root_decl) { who = r.chain; }
        collections_vector.push[str](?fixed_who, who);
        collections_vector.push[bool](?fixed_own, r.root_decl);
    }
    i = 0;
    for (i < closure.len) {
        val r: *package_closure.Request = ?closure.data[i];
        i = i + 1;
        if (!package_closure.selects_release(r)) { cnt; }
        if (str_listed(?fixed, r.id))            { cnt; }
        # a range read through a release is the release's own need, which the
        # resolver reads from its manifest; the ranges declared beside it are not
        if (!r.via_release) {
            var who: str = "";
            if (!r.root_decl) { who = r.requirer; }
            collections_vector.push[resolver.Need](?needs_of, resolver.Need{id: r.id, url: r.url, range: r.version, who: who});
        }
        var k: usize = 0;
        for (k < r.also.len) {
            collections_vector.push[resolver.Need](?needs_of, resolver.Need{id: r.id, url: r.url, range: r.also.data[k].range, who: r.also.data[k].requirer});
            k = k + 1;
        }
        val res_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, r.id);
        if (sel res_full.ok) {
            val err_noted: err[fail.Fail] = releases.remember(releases.ctx, r.url, res_full.ok);
            if (sel err_noted.err) { ret res[Resolution, fail.Fail].err{err_noted.err}; }
        }
    }
    if (needs_of.len == 0) { ret res[Resolution, fail.Fail].ok{out}; }
    out.ranged = true;
    if (offline) { collections_vector.push[str](?out.notes, "resolving from releases already fetched (--offline)"); }
    if (lock) {
        val res_ids: res[Vector[str], fail.Fail] = package.realized_ids(a, op.root);
        if (sel res_ids.ok) {
            var j: usize = 0;
            for (j < res_ids.ok.len) {
                val id: str = res_ids.ok.data[j];
                j = j + 1;
                if (unlocked != nil && str_equals(id, unlocked)) { cnt; }
                val res_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, id);
                if (sel res_full.err) { cnt; }
                val res_release_at: res[str, fail.Fail] = op.checkouts.release_at(op.checkouts.ctx, op.root, id, res_full.ok, !offline);
                if (sel res_release_at.ok) { lock_push(s.build_alloc, ?locks, id, res_release_at.ok); }
            }
        }
        # a range with no checkout yet starts at the declaring dependency's own pin
        i = 0;
        for (i < closure.len) {
            val r: *package_closure.Request = ?closure.data[i];
            i = i + 1;
            if (r.seed == nil || str_is_empty(r.seed))         { cnt; }
            if (unlocked != nil && str_equals(r.id, unlocked)) { cnt; }
            if (lock_listed(?locks, r.id))                     { cnt; }
            val res_release_of: res[str, fail.Fail] = releases.release_of(releases.ctx, r.url, r.seed);
            if (sel res_release_of.err) { ret res[Resolution, fail.Fail].err{res_release_of.err}; }
            lock_push(s.build_alloc, ?locks, r.id, res_release_of.ok);
        }
    }
    var problem: resolver.Problem = resolver.Problem{root: root_id, needs: needs_of.data, need_count: needs_of.len::u32,
        fixed: fixed.data, fixed_count: fixed.len::u32, compiler: base_version.MACH_VERSION, lowest: lowest,
        locks: locks.data, lock_count: locks.len::u32};
    val res_solved: res[Vector[resolver.Choice], fail.Fail] = resolver.resolve(a, releases, needs, (?nd)::ptr, ?problem);
    if (sel res_solved.err) { ret res[Resolution, fail.Fail].err{res_solved.err}; }
    out.picks = res_solved.ok;
    if (fixed.len > 0) {
        val err_noted: err[fail.Fail] = note_overrides(a, ?nd, root_id, ?out.picks, ?fixed, ?fixed_by, ?fixed_who, ?fixed_own, root_notes, ?out.notes);
        if (sel err_noted.err) { ret res[Resolution, fail.Fail].err{err_noted.err}; }
    }
    ret res[Resolution, fail.Fail].ok{out};
}

# name every requirement of a chosen release that a `ref` or `path` declaration overrides,
# the root's or one along the closure's fixed edges
fun note_overrides(a: *A.Allocator, nd: *Needs, root_id: str, picks: *Vector[resolver.Choice],
    fixed: *Vector[str], fixed_by: *Vector[str], fixed_who: *Vector[str], fixed_own: *Vector[bool], root_notes: bool,
    notes: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < picks.len) {
        val pick: *resolver.Choice = ?picks.data[i];
        i = i + 1;
        val res_parse_version: res[manifest_version.Version, str] = manifest_version.parse_version(pick.version);
        if (sel res_parse_version.err) { ret err[fail.Fail].err{fail.user(diagnostic_kind.VERSION_INVALID, res_parse_version.err)}; }
        var rel:       package_source.Release = package_source.Release{version: res_parse_version.ok, text: pick.version, tag: pick.tag, commit: pick.commit};
        var rn:        resolver.ReleaseNeeds  = resolver.ReleaseNeeds{mach: "", needs: collections_vector.init[resolver.Need](a), excluded: ""};
        val err_needs: err[fail.Fail]         = needs(nd::ptr, pick.id, pick.url, ?rel, ?rn);
        if (sel err_needs.err) { ret err_needs; }
        var k: usize = 0;
        for (k < rn.needs.len) {
            val need: *resolver.Need = ?rn.needs.data[k];
            k = k + 1;
            var f: usize = 0;
            for (f < fixed.len) {
                if (str_equals(fixed.data[f], need.id) && (root_notes || !fixed_own.data[f])) {
                    val res_line: res[str, std_format.FormatError] = std_format.sprint(a, "{} declares {} by {}, overriding {} -> {} {} requires {} {}",
                        fixed_who.data[f], need.id, fixed_by.data[f], root_id, pick.id, pick.version, need.id, need.range);
                    if (sel res_line.err) { ret err[fail.Fail].err{fail.message(fail.format_text(res_line.err))}; }
                    collections_vector.push[str](notes, res_line.ok);
                }
                f = f + 1;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# a release's requirements as the resolver reads them: its compiler range and its dependencies
# selected by version range, or by an exact release tag. a release selecting anything else
# (a branch, a commit, a path) is not reproducible from its tag and is refused,
# unless the root declares that identity and so selects it itself. a release whose
# manifest does not load or names another version is no candidate, which `out.excluded` says
fun needs(ctx: ptr, id: str, url: str, rel: *package_source.Release, out: *resolver.ReleaseNeeds) err[fail.Fail] {
    val nd:          *Needs                                 = ctx::*Needs;
    val s:           *session.Session                       = nd.s;
    val a:           *A.Allocator                           = s.build_alloc;
    val res_shipped: res[package_source.Shipped, fail.Fail] = nd.releases.shipped(nd.releases.ctx, url, rel);
    if (sel res_shipped.err) { ret err[fail.Fail].err{res_shipped.err}; }
    if (!str_is_empty(res_shipped.ok.excluded)) {
        out.excluded = res_shipped.ok.excluded;
        out.detail   = res_shipped.ok.detail;
        ret err[fail.Fail].ok{};
    }
    var m: manifest_model.Manifest = res_shipped.ok.manifest;
    fin { manifest_model.dnit(?m, a); }
    if (!intern.str_is_nil(m.mach)) { out.mach = intern.text(?s.interner, m.mach); }
    var i: u32 = 0;
    for (i < m.dep_count) {
        val d:    *manifest_model.DepDef = ?m.deps[i];
        val name: str                    = intern.text(?s.interner, d.name);
        i = i + 1;
        # an unreproducible selector the root overrides is not a requirement: the root's own selector is
        val overridden: bool = nd.root != nil && compile_closure.root_dependency(nd.root, d.name) != nil;
        if (intern.str_is_nil(d.git)) {
            if (overridden) { cnt; }
            ret err[fail.Fail].err{unreproducible(a, id, rel, name, "a path")};
        }
        val dep_url: str = intern.text(?s.interner, d.git);
        var want:    str = "";
        if (!intern.str_is_nil(d.version)) { want = intern.text(?s.interner, d.version); }
        or {
            val ref: str = package.ref_of(s, d);
            if (!str_starts_with(ref, "tag/v")) {
                if (overridden) { cnt; }
                ret err[fail.Fail].err{unreproducible(a, id, rel, name, ref)};
            }
            val res_exact: res[str, std_format.FormatError] = std_format.sprint(a, "={}", (?ref[5])::str);
            if (sel res_exact.err) { ret err[fail.Fail].err{fail.message(fail.format_text(res_exact.err))}; }
            want = res_exact.ok;
        }
        val res_pushed: res[usize, A.Error] = collections_vector.push[resolver.Need](?out.needs, resolver.Need{id: name, url: dep_url, range: want, who: ""});
        if (sel res_pushed.err)          { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        if (str_is_empty(nd.local_root)) { cnt; }
        val res_local: res[str, fail.Fail] = package.dep_full_of(a, nd.local_root, name);
        if (sel res_local.ok) {
            val err_noted: err[fail.Fail] = nd.releases.remember(nd.releases.ctx, dep_url, res_local.ok);
            if (sel err_noted.err) { ret err_noted; }
        }
    }
    ret err[fail.Fail].ok{};
}

fun unreproducible(a: *A.Allocator, id: str, rel: *package_source.Release, name: str, selector: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.DEP_UNREPRODUCIBLE,
        "release {} of {} selects dependency '{}' by {}, so it cannot be reproduced from its tag. declare [dep.{}] in your root manifest, or have {} cut a release that selects it by `version` or an exact `tag/`",
        rel.tag, id, name, selector, name, id);
}

# one version-selected identity as `mach dep outdated` shows it: the release its pin is ("-"
# for none), the highest this compiler and every range accept, and the highest published
pub rec OutdatedRow {
    id:         str;
    pinned:     str;
    compatible: str;
    latest:     str;
}

# what `mach dep outdated` shows: the resolution's notes, whether any identity selects
# releases by version, and a row for each that does
pub rec Outdated {
    notes:  Vector[str];
    ranged: bool;
    rows:   Vector[OutdatedRow];
}

# each version-selected identity's pinned release, the highest this compiler and every range
# accept, and the highest release published
pub fun outdated(op: *package_closure.Operation, doc: *manifest_load.Doc, offline: bool) res[Outdated, fail.Fail] {
    val s:            *session.Session           = op.s;
    val a:            *A.Allocator               = op.a;
    var walk:         package_closure.Walk       = package_closure.Walk{offline: offline, all: false, name: nil, quiet: false};
    val res_resolved: res[Resolution, fail.Fail] = versions(op, doc, false, false, nil, true, ?walk);
    if (sel res_resolved.err) { ret res[Outdated, fail.Fail].err{res_resolved.err}; }
    var out: Outdated = Outdated{notes: res_resolved.ok.notes, ranged: res_resolved.ok.ranged, rows: collections_vector.init[OutdatedRow](a)};
    if (!res_resolved.ok.ranged) { ret res[Outdated, fail.Fail].ok{out}; }
    var picks: Vector[resolver.Choice] = res_resolved.ok.picks;
    # the resolution above announced reading each url, and this listing reads them again
    val res_opened: res[package_source.Releases, fail.Fail] = git_member.releases(s, offline, "", nil);
    if (sel res_opened.err) { ret res[Outdated, fail.Fail].err{res_opened.err}; }
    var releases: package_source.Releases = res_opened.ok;
    var i:        usize                   = 0;
    for (i < picks.len) {
        val pick: *resolver.Choice = ?picks.data[i];
        i = i + 1;
        var pinned:   str                 = "-";
        val res_full: res[str, fail.Fail] = package.dep_full_of(a, op.root, pick.id);
        if (sel res_full.ok) {
            if (offline) { releases.remember(releases.ctx, pick.url, res_full.ok); }
            val res_release_at: res[str, fail.Fail] = op.checkouts.release_at(op.checkouts.ctx, op.root, pick.id, res_full.ok, !offline);
            if (sel res_release_at.ok) {
                if (!str_is_empty(res_release_at.ok)) { pinned = res_release_at.ok; }
            }
        }
        var list:       Vector[package_source.Release] = collections_vector.init[package_source.Release](a);
        var latest:     str                            = pick.version;
        val err_listed: err[fail.Fail]                 = releases.list(releases.ctx, pick.url, ?list);
        if (sel err_listed.ok) {
            var best: manifest_version.Version = list.data[0].version;
            var k:    usize                    = 0;
            for (k < list.len) {
                val v: *manifest_version.Version = ?list.data[k].version;
                if (v.pre_len == 0 && (str_equals(latest, pick.version) || manifest_version.compare(v, ?best) > 0)) {
                    if (manifest_version.compare(v, ?best) >= 0 || k == 0) {
                        best   = @v;
                        latest = list.data[k].text;
                    }
                }
                k = k + 1;
            }
        }
        collections_vector.push[OutdatedRow](?out.rows, OutdatedRow{id: pick.id, pinned: pinned, compatible: pick.version, latest: latest});
    }
    val err_closed: err[fail.Fail] = releases.close(releases.ctx);
    if (sel err_closed.err) { ret res[Outdated, fail.Fail].err{err_closed.err}; }
    ret res[Outdated, fail.Fail].ok{out};
}
