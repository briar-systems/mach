# how every line a command prints for a person is laid out: progress lines, rows of columns,
# bars, and the one written form of a duration, a size, a count and a commit
#
# a row is cells in columns. each column has a width, sits its cells left or right, and has
# the spaces that part it from the column before. a blank cell keeps its column, so the cells
# after it stay in theirs, and a row never ends in spaces: padding is written only when text
# follows it. a block of lines shares one set of columns, measured from what it shows or from
# the tables it draws its labels from, so a new line cannot drift out of them.
#
# a number is rounded to the nearest of its last digit, and shows a tenth while it is under ten
# of its unit: a size is exact bytes below a KiB, then KiB, MiB or GiB (`1.5 KiB`, `51 KiB`); a
# measured duration is microseconds below a millisecond, milliseconds below a second (`1.5ms`,
# `468ms`), seconds to a tenth below a minute (`18.5s`), then minutes and whole seconds. a count
# of one takes the singular noun, and a count shown among others groups its digits by three
# (`30,634`). a commit is its first COMMIT_SHORT hex digits.
#
# a progress line is a verb from one closed table, right-aligned in a gutter of GUTTER, then
# what it acted on; its detail sits on lines beneath, indented past the gutter. a bar is `#`
# up to BAR long, scaled to the largest of its table.

use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use chrono_duration: std.chrono.duration;
use std_format:      std.format;
use io_writer:       std.io.writer;

# where a cell sits in its column
pub def Align: u8;

pub val LEFT:  Align = 0;
pub val RIGHT: Align = 1;

# the spaces between two columns, unless a column states its own
pub val GAP: usize = 2;

# one column of a block
# ---
# width: the cells' room; a longer cell takes more and pushes the rest of its row
# align: LEFT or RIGHT
# gap:   the spaces before the column; the first column's gap indents the row
pub rec Column {
    width: usize;
    align: Align;
    gap:   usize;
}

# widen a column to hold `s`
pub fun fit(c: *Column, s: str) {
    if (s == nil) { ret; }
    val l: usize = str_len(s);
    if (l > c.width) { c.width = l; }
}

# write a row's cells in their columns and no line end, so an aside can follow on the line
# ---
# w:     where the row goes
# cols:  the block's columns
# texts: one text per column, nil or empty for a blank cell
# n:     how many columns
pub fun cells(w: *io_writer.Writer, cols: *Column, texts: *str, n: usize) {
    var owed: usize = 0;
    var i:    usize = 0;
    for (i < n) {
        val c: *Column = ?cols[i];
        val s: str     = texts[i];
        i = i + 1;
        var l: usize = 0;
        if (s != nil) { l = str_len(s); }
        var pad: usize = 0;
        if (l < c.width) { pad = c.width - l; }
        owed = owed + c.gap;
        if (l == 0) {
            owed = owed + pad;
            cnt;
        }
        if (c.align == RIGHT) {
            owed = owed + pad;
            pad  = 0;
        }
        spaces(w, owed);
        std_format.write_str(w, s);
        owed = pad;
    }
}

# write a row's cells in their columns and end the line
pub fun row(w: *io_writer.Writer, cols: *Column, texts: *str, n: usize) {
    cells(w, cols, texts, n);
    std_format.write_newline(w);
}

# write a remark after a row's cells, parted from them by GAP
pub fun aside(w: *io_writer.Writer, text: str) {
    spaces(w, GAP);
    std_format.write_str(w, text);
}

# write n spaces
pub fun spaces(w: *io_writer.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        std_format.write_byte(w, ' ');
        i = i + 1;
    }
}

# the room one written number, duration, size or commit takes, its terminator included
pub val TEXT_CAP: usize = 48;

# storage one written value lives in while its line is written
# storage one written value lives in while its line is written, and how much a text writer
# has put in it
pub rec Text {
    bytes: [TEXT_CAP]u8;
    len:   usize;
}

# a writer into t, from its start: what does not fit is dropped, and text_end closes it
pub fun text_writer(t: *Text) io_writer.Writer {
    t.len = 0;
    ret io_writer.Writer{ctx: t::ptr, fn_write: text_write};
}

# what a text writer wrote into t
pub fun text_end(t: *Text) str {
    ret finish(t, t.len);
}

fun text_write(ctx: ptr, buf: *u8, len: usize) res[usize, io_writer.WriteError] {
    val t: *Text = ctx::*Text;
    var i: usize = 0;
    for (i < len && t.len + 1 < TEXT_CAP) {
        t.bytes[t.len] = buf[i];
        t.len          = t.len + 1;
        i              = i + 1;
    }
    ret res[usize, io_writer.WriteError].ok{len};
}

# a count in decimal
pub fun count(t: *Text, n: u64) str {
    ret finish(t, put_u64(t, 0, n));
}

# a measured duration, rounded to the nearest of its last digit: a tenth below ten of
# microseconds or milliseconds and whole above, seconds to a tenth below a minute, then minutes
# and whole seconds. zero is `0us`
pub fun duration(t: *Text, d: chrono_duration.Duration) str {
    if (d <= 0) { ret finish(t, put(t, 0, "0us")); }
    val n:  u64 = d::u64;
    val us: u64 = chrono_duration.MICROSECOND::u64;
    val ms: u64 = chrono_duration.MILLISECOND::u64;
    val s:  u64 = chrono_duration.SECOND::u64;
    if (tenths(n, us) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, us)), "us")); }
    if (whole(n, us) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, us)), "us")); }
    if (tenths(n, ms) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, ms)), "ms")); }
    if (whole(n, ms) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, ms)), "ms")); }
    if (tenths(n, s) < 600)  { ret finish(t, put(t, put_tenths(t, tenths(n, s)), "s")); }
    val all: u64   = whole(n, s);
    var l:   usize = put_u64(t, 0, all / 60);
    l = put(t, l, "m");
    l = put_u64(t, l, all % 60);
    ret finish(t, put(t, l, "s"));
}

# a size in bytes: exact below a KiB, then the largest binary unit it holds one of, rounded to
# the nearest tenth below ten of the unit and to the nearest whole above
pub fun size(t: *Text, bytes: u64) str {
    val ki: u64 = 1024;
    if (bytes < ki) { ret finish(t, put(t, put_u64(t, 0, bytes), " B")); }
    val units: [3]str = [3]str{" KiB", " MiB", " GiB"};
    var per:   u64    = ki;
    var k:     usize  = 0;
    for (k < 2 && whole(bytes, per) >= ki) {
        per = per * ki;
        k   = k + 1;
    }
    if (tenths(bytes, per) < 100) { ret finish(t, put(t, put_tenths(t, tenths(bytes, per)), units[k])); }
    ret finish(t, put(t, put_u64(t, 0, whole(bytes, per)), units[k]));
}

# n in tenths of `per`, rounded to nearest
fun tenths(n: u64, per: u64) u64 {
    ret (n * 10 + per / 2) / per;
}

# n in wholes of `per`, rounded to nearest
fun whole(n: u64, per: u64) u64 {
    ret (n + per / 2) / per;
}

# tenths written as `<whole>.<tenth>` at the start of t
fun put_tenths(t: *Text, n: u64) usize {
    var l: usize = put_u64(t, 0, n / 10);
    l = put(t, l, ".");
    ret put_u64(t, l, n % 10);
}

fun put_u64(t: *Text, at: usize, n: u64) usize {
    ret at + std_format.put_u64(?t.bytes[at], n);
}

fun finish(t: *Text, l: usize) str {
    t.bytes[l] = 0;
    ret (?t.bytes[0])::str;
}

# the hex digits a commit is shown by, unless a listing asks for the whole of it
pub val COMMIT_SHORT: usize = 12;

# a commit as it is shown: its first COMMIT_SHORT digits
pub fun commit(t: *Text, full: str) str {
    var i: usize = 0;
    for (i < COMMIT_SHORT && full[i] != 0) {
        t.bytes[i] = full[i];
        i          = i + 1;
    }
    t.bytes[i] = 0;
    ret (?t.bytes[0])::str;
}

# the noun a count takes
pub fun noun(n: u64, one: str, many: str) str {
    if (n == 1) { ret one; }
    ret many;
}

fun put(t: *Text, at: usize, s: str) usize {
    var l: usize = at;
    var i: usize = 0;
    for (s[i] != 0) {
        t.bytes[l] = s[i];
        l          = l + 1;
        i          = i + 1;
    }
    ret l;
}

# a count with a comma between each group of three digits
pub fun grouped(t: *Text, n: u64) str {
    var digits: Text;
    val l:      usize = std_format.put_u64(?digits.bytes[0], n);
    var at:     usize = 0;
    var i:      usize = 0;
    for (i < l) {
        if (i > 0 && (l - i) % 3 == 0) {
            t.bytes[at] = ',';
            at          = at + 1;
        }
        t.bytes[at] = digits.bytes[i];
        at          = at + 1;
        i           = i + 1;
    }
    ret finish(t, at);
}

# what a progress line says was done, the word in its gutter
pub def Verb: u8;

pub val CREATED:    Verb = 0;
pub val REALIZED:   Verb = 1;
pub val UPDATED:    Verb = 2;
pub val UNCHANGED:  Verb = 3;
pub val ADDED:      Verb = 4;
pub val REMOVED:    Verb = 5;
pub val BUILT:      Verb = 6;
pub val CHECKED:    Verb = 7;
pub val FORMATTED:  Verb = 8;
pub val DIFFERS:    Verb = 9;
pub val DOCUMENTED: Verb = 10;
pub val VERIFIED:   Verb = 11;
pub val FETCHED:    Verb = 12;
pub val READING:    Verb = 13;
pub val PASSED:     Verb = 14;
pub val FAILED:     Verb = 15;
pub val SKIPPED:    Verb = 16;
pub val COMPILING:  Verb = 17;
pub val MIGRATED:   Verb = 18;

val VERB_COUNT: usize = 19;

val VERBS: [VERB_COUNT]str = [VERB_COUNT]str{
    "created", "realized", "updated", "unchanged", "added", "removed", "built", "checked", "formatted",
    "differs", "documented", "verified", "fetched", "reading", "passed", "failed", "skipped", "compiling", "migrated",
};

# the gutter's width: the widest verb, right-aligned in it
pub val GUTTER: usize = 10;

# the gutter of a progress line: its verb right-aligned, then the gap before what it acted on
pub fun said(w: *io_writer.Writer, v: Verb) {
    val word: str = VERBS[v];
    spaces(w, GUTTER - str_len(word));
    std_format.write_str(w, word);
    spaces(w, GAP);
}

# the lead of a detail line beneath a progress line: the gutter and its gap, empty
pub fun beneath(w: *io_writer.Writer) {
    spaces(w, GUTTER + GAP);
}

# the room a bar may take
pub val BAR: usize = 24;

# the length of the bar of `part` against the largest `most`, rounded to nearest, zero for a
# part too small to show
pub fun bar_length(part: u64, most: u64) usize {
    if (most == 0) { ret 0; }
    ret ((part * BAR::u64 + most / 2) / most)::usize;
}

# a bar of n `#`, nil when n is zero
pub fun bar_text(t: *Text, n: usize) str {
    if (n == 0) { ret nil; }
    var i: usize = 0;
    for (i < n && i + 1 < TEXT_CAP) {
        t.bytes[i] = '#';
        i          = i + 1;
    }
    ret finish(t, i);
}
