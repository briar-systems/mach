# the report records: one emitter, two encodings
#
# every record a command writes under `--report json` or `--report lines` is written here,
# field by field in the order the record page lists them, and the encoding the mode chose
# lays it out. json writes one object a line. lines writes one record a line: the record's
# kind bare, then each field as `key=value` parted by tabs, a nested field's key the path of
# keys to it joined by `.`, each element of a list a repeat of the list's key, a null field
# left out, and in a value a tab, a newline and a backslash written `\t`, `\n` and `\\`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;

use json_ndjson: json.ndjson;
use std_format:  std.format;
use io_writer:   std.io.writer;

# how records are laid out
pub def Encoding: u8;

pub val JSON:  Encoding = 0;
pub val LINES: Encoding = 1;

# the version every record carries in `schema`. adding a field, a record type or a value of an
# enumerated field keeps it; changing or removing one bumps it (doc/language/report-records.md)
pub val SCHEMA: i64 = 3;

# the deepest a field sits under nested records and lists
val DEPTH: usize = 4;

# an open record, or a record nested in one: its encoding, where it goes, the json object
# under json, and under lines the keys that lead to it
pub rec Record {
    enc:   Encoding;
    w:     *io_writer.Writer;
    json:  json_ndjson.Object;
    path:  [DEPTH]str;
    depth: usize;
}

# an open list field: as a record, its path ending in the list's key
pub rec List {
    enc:   Encoding;
    w:     *io_writer.Writer;
    json:  json_ndjson.Array;
    path:  [DEPTH]str;
    depth: usize;
}

# open a record of `kind` on w: its schema and kind, the first fields every record has
pub fun begin(w: *io_writer.Writer, enc: Encoding, r: *Record, kind: str) {
    r.enc   = enc;
    r.w     = w;
    r.depth = 0;
    if (enc == JSON) {
        json_ndjson.object_begin(w, ?r.json);
        json_ndjson.field_i64(?r.json, "schema", SCHEMA);
        json_ndjson.field_str(?r.json, "record", kind);
        ret;
    }
    escaped(w, kind);
    int(r, "schema", SCHEMA);
}

# close a record and its line
pub fun end(r: *Record) {
    if (r.enc == JSON) {
        json_ndjson.object_end(?r.json);
        ret;
    }
    std_format.write_newline(r.w);
}

# a text field
pub fun text(r: *Record, key: str, v: str) {
    if (r.enc == JSON) {
        json_ndjson.field_str(?r.json, key, v);
        ret;
    }
    lead(r.w, ?r.path[0], r.depth, key);
    escaped(r.w, v);
}

# a text field, null when v is nil
pub fun text_or_null(r: *Record, key: str, v: str) {
    if (v == nil) {
        null(r, key);
        ret;
    }
    text(r, key, v);
}

# a null field, which lines leaves out
pub fun null(r: *Record, key: str) {
    if (r.enc == JSON) { json_ndjson.field_null(?r.json, key); }
}

# an integer field
pub fun int(r: *Record, key: str, v: i64) {
    if (r.enc == JSON) {
        json_ndjson.field_i64(?r.json, key, v);
        ret;
    }
    lead(r.w, ?r.path[0], r.depth, key);
    std_format.write_i64(r.w, v);
}

# a truth field, `true` or `false` in both encodings
pub fun flag(r: *Record, key: str, v: bool) {
    if (r.enc == JSON) {
        json_ndjson.field_bool(?r.json, key, v);
        ret;
    }
    lead(r.w, ?r.path[0], r.depth, key);
    if (v) { std_format.write_str(r.w, "true"); }
    or     { std_format.write_str(r.w, "false"); }
}

# open a record-valued field `key` of r as child
pub fun nested_begin(r: *Record, key: str, child: *Record) {
    child.enc = r.enc;
    child.w   = r.w;
    if (r.enc == JSON) {
        json_ndjson.field_object_begin(?r.json, key, ?child.json);
        ret;
    }
    deeper(?r.path[0], r.depth, key, ?child.path[0], ?child.depth);
}

# close a nested record
pub fun nested_end(child: *Record) {
    if (child.enc == JSON) { json_ndjson.object_end_value(?child.json); }
}

# open a list field `key` of r
pub fun list_begin(r: *Record, key: str, l: *List) {
    l.enc = r.enc;
    l.w   = r.w;
    if (r.enc == JSON) {
        json_ndjson.field_array_begin(?r.json, key, ?l.json);
        ret;
    }
    deeper(?r.path[0], r.depth, key, ?l.path[0], ?l.depth);
}

# close a list
pub fun list_end(l: *List) {
    if (l.enc == JSON) { json_ndjson.array_end(?l.json); }
}

# a text element of a list
pub fun list_text(l: *List, v: str) {
    if (l.enc == JSON) {
        if (!l.json.first) { std_format.write_byte(l.w, ','); }
        l.json.first = false;
        json_ndjson.write_json_string(l.w, v);
        ret;
    }
    std_format.write_byte(l.w, '\t');
    keys(l.w, ?l.path[0], l.depth);
    std_format.write_byte(l.w, '=');
    escaped(l.w, v);
}

# open a record element of a list as child, closed with nested_end
pub fun list_record_begin(l: *List, child: *Record) {
    child.enc = l.enc;
    child.w   = l.w;
    if (l.enc == JSON) {
        json_ndjson.array_object_begin(?l.json, ?child.json);
        ret;
    }
    var i: usize = 0;
    for (i < l.depth) {
        child.path[i] = l.path[i];
        i             = i + 1;
    }
    child.depth = l.depth;
}

# the path one key below `from`
fun deeper(from: *str, depth: usize, key: str, to: *str, to_depth: *usize) {
    var i: usize = 0;
    for (i < depth) {
        to[i] = from[i];
        i     = i + 1;
    }
    to[depth] = key;
    @to_depth = depth + 1;
}

# the separator and key of a field under lines, up to its `=`
fun lead(w: *io_writer.Writer, path: *str, depth: usize, key: str) {
    std_format.write_byte(w, '\t');
    if (depth > 0) {
        keys(w, path, depth);
        std_format.write_byte(w, '.');
    }
    std_format.write_str(w, key);
    std_format.write_byte(w, '=');
}

fun keys(w: *io_writer.Writer, path: *str, depth: usize) {
    var i: usize = 0;
    for (i < depth) {
        if (i > 0) { std_format.write_byte(w, '.'); }
        std_format.write_str(w, path[i]);
        i = i + 1;
    }
}

# a value under lines, its tabs, newlines and backslashes escaped
fun escaped(w: *io_writer.Writer, v: str) {
    if (v == nil) { ret; }
    var i: usize = 0;
    for (v[i] != 0) {
        val c: u8 = v[i];
        if (c == '\t') { std_format.write_str(w, "\\t"); }
        or (c == '\n') { std_format.write_str(w, "\\n"); }
        or (c == '\\') { std_format.write_str(w, "\\\\"); }
        or             { std_format.write_byte(w, c); }
        i = i + 1;
    }
}
