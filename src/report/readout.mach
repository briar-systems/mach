# the progress events a command reports, and the timed phase rows of a build unit
#
# the build engine and the test runner report what happens as it happens, in order, to a sink
# the command supplies, which renders each event when it arrives. the compiler does no terminal
# i/o here: every rendering is the sink's. an event's payload is borrowed for the call and never
# retained by the stream, except a test run's results, which stay in place from run_start to
# run_end.
#
# a phase row is timed from its phase_begin to its phase_end. a phase that runs inside another
# (lower inside prepare) is carved: phase_carved marks it hosted and span_end moves each measured
# span out of the host into it, so no time is counted twice. a phase that runs on worker threads
# beside its host is summed: what each thread spent is added to it and to nothing else. a phase
# with a parent is one part of that parent's row, which is the sum of its parts' own time, the
# summed parts aside. a unit's `other` time is its wall time less every row with no parent.
#
# a diagnostic is reported once, when the store it stands in settles at a phase's close: settle
# delivers each report the unit has not delivered before, so what a phase found lands before the
# phase's row.
#
# a counter is a number an owner keeps of what it made, posted per module and closed into the
# unit's total, a sum or the most any module reached.
#
# the live slot is the one line a terminal shows of what runs now: the open phase, its time so
# far, how far it is and what it reached last. the engine writes it, the sink draws it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use collections_vector: std.collections.vector;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use std.chrono.time;
use std.sync.mutex;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source: mach.base.source;
use mach.report.testrun;

# a readout phase, an index into the phase table, which is the order a unit's rows are read in
pub def Phase: u32;

# the build's target resolved and its back half opened: mink's formats, mirl's assembled and readied target
pub val TARGET: Phase = 0;
# the build steps a project and its dependencies declare
pub val STEPS: Phase = 1;
pub val LOAD:  Phase = 2;
# the object cache keyed and read, inside resolve
pub val CACHE:   Phase = 3;
pub val RESOLVE: Phase = 4;
pub val SEMA:    Phase = 5;
# the objects made: the sum of its parts below
pub val CODEGEN: Phase = 6;
# what the owner does for each unit beside the parts it hosts
pub val PREPARE: Phase = 7;
pub val LOWER:   Phase = 8;
# the lowered modules held to mirl's verifier
pub val VERIFY: Phase = 9;
# mirl's pass schedule, the target's lowering rows and the neutral ones
pub val PASSES: Phase = 10;
# mirl's instruction selection
pub val SELECT: Phase = 11;
# mirl's register allocation
pub val ALLOC: Phase = 12;
# mirl's frame and the steps that finish framed code
pub val FRAME: Phase = 13;
# mirl's block layout, variable ranges and texts, less masc's two
pub val EMIT: Phase = 14;
# masc laying out the object
pub val LAYOUT: Phase = 15;
# masc encoding the settled layout
pub val ENCODE: Phase = 16;
# each object written to its file
pub val WRITE: Phase = 17;
pub val LINK:  Phase = 18;

pub val PHASE_COUNT: usize = 19;

# no phase: a row's parent when it has none
pub val PHASE_NONE: Phase = 0xffffffff;

# mirl's and masc's stages, the rows a module's step carves out of prepare, in the order mirl runs them
pub val STAGE_COUNT: usize              = 7;
pub val STAGES:      [STAGE_COUNT]Phase = [STAGE_COUNT]Phase{PASSES, SELECT, ALLOC, FRAME, EMIT, LAYOUT, ENCODE};

# what a phase's line says after its time
pub def Detail: u8;

# its count and the noun that counts it: `55 modules`
pub val DETAIL_COUNT: Detail = 0;
# the unit's target and profile: `linux-x86_64 debug`
pub val DETAIL_TARGET: Detail = 1;
# what the cache reused: `none reused`, `51 reused`
pub val DETAIL_REUSED: Detail = 2;
# the artifact's size when one file was written, `up to date` when none was, else its count
pub val DETAIL_SIZE: Detail = 3;

# what the readout shows of a phase: its row label, the phase whose row it is a part of, what its
# line says after its time, and whether it has a line when it processed nothing
rec PhaseSpec {
    label:  str;
    parent: Phase;
    detail: Detail;
    zero:   bool;
}

val PHASES: [PHASE_COUNT]PhaseSpec = [PHASE_COUNT]PhaseSpec{
    PhaseSpec{label: "target", parent: PHASE_NONE, detail: DETAIL_TARGET, zero: true},
    PhaseSpec{label: "steps", parent: PHASE_NONE, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "load", parent: PHASE_NONE, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "cache", parent: PHASE_NONE, detail: DETAIL_REUSED, zero: true},
    PhaseSpec{label: "resolve", parent: PHASE_NONE, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "sema", parent: PHASE_NONE, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "codegen", parent: PHASE_NONE, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "prepare", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "lower", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "verify", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "passes", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "select", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "alloc", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "frame", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "emit", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "layout", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "encode", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "write", parent: CODEGEN, detail: DETAIL_COUNT, zero: false},
    PhaseSpec{label: "link", parent: PHASE_NONE, detail: DETAIL_SIZE, zero: true},
};

# the row label of phase ph
pub fun label_of(ph: Phase) str {
    ret PHASES[ph].label;
}

# the phase whose row ph is a part of, PHASE_NONE for a row of its own
pub fun parent_of(ph: Phase) Phase {
    ret PHASES[ph].parent;
}

# what phase ph's line says after its time
pub fun detail_of(ph: Phase) Detail {
    ret PHASES[ph].detail;
}

# whether phase ph has a line when it processed nothing
pub fun shows_zero(ph: Phase) bool {
    ret PHASES[ph].zero;
}

# whether phase ph is a parent, its row the sum of its parts
fun whole(ph: Phase) bool {
    var i: usize = 0;
    for (i < PHASE_COUNT) {
        if (PHASES[i].parent == ph) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what a phase row counts, an index into the noun table
pub def Noun: u8;

pub val NOUN_TARGETS:   Noun = 0;
pub val NOUN_MODULES:   Noun = 1;
pub val NOUN_OBJECTS:   Noun = 2;
pub val NOUN_BINARIES:  Noun = 3;
pub val NOUN_ARCHIVES:  Noun = 4;
pub val NOUN_LIBRARIES: Noun = 5;
pub val NOUN_STEPS:     Noun = 6;

val NOUN_COUNT: usize = 7;

# a noun's spelling for a count of one and for any other count
rec NounSpec {
    one:  str;
    many: str;
}

val NOUNS: [NOUN_COUNT]NounSpec = [NOUN_COUNT]NounSpec{
    NounSpec{one: "target", many: "targets"},
    NounSpec{one: "module", many: "modules"},
    NounSpec{one: "object", many: "objects"},
    NounSpec{one: "binary", many: "binaries"},
    NounSpec{one: "archive", many: "archives"},
    NounSpec{one: "library", many: "libraries"},
    NounSpec{one: "step", many: "steps"},
};

# noun n as a count of `count` takes it
pub fun noun_of(n: Noun, count: u64) str {
    if (count == 1) { ret NOUNS[n].one; }
    ret NOUNS[n].many;
}

# a readout counter, an index into the counter table
pub def Counter: u32;

# the functions of the lowered modules, as mirl's module holds them
pub val FUNCTIONS: Counter = 0;
# the instructions lowering built into the modules' bodies, as mirl's bodies hold them
pub val IR_INSTRUCTIONS: Counter = 1;
# the runs of mirl's verifier over the lowered modules, mach's and mirl's own
pub val VERIFY_RUNS: Counter = 2;
# the blocks a step allocated from its own heap, which the lowered module lives on, as std's heap counts them
pub val ALLOCATED_BLOCKS: Counter = 3;
# the bytes of those allocations
pub val ALLOCATED_BYTES: Counter = 4;
# the most bytes a step's own heap mapped, as for the blocks
pub val HEAP_PEAK: Counter = 5;
# the machine instructions mirl's selection made
pub val SELECTED: Counter = 6;
# the machine instructions after mirl's register allocation
pub val ALLOCATED: Counter = 7;
# the rounds of mirl's register allocation
pub val ALLOC_ROUNDS: Counter = 8;

pub val COUNTER_COUNT: usize = 9;

# the line a person reads a counter on: what the code came to, or what building it took of memory
pub def Group: u8;

pub val GROUP_CODE:   Group = 0;
pub val GROUP_MEMORY: Group = 1;

# what the readout shows of a counter: its label, which the records name it by, its head in the
# module table, whether the unit's total is the most any module reached rather than the sum,
# whether it counts bytes, which a person reads as a size, its group, and the word its value
# takes on its group's line for a count of one and for any other count
rec CounterSpec {
    label: str;
    head:  str;
    most:  bool;
    bytes: bool;
    group: Group;
    one:   str;
    many:  str;
}

val COUNTERS: [COUNTER_COUNT]CounterSpec = [COUNTER_COUNT]CounterSpec{
    CounterSpec{label: "functions", head: "functions", most: false, bytes: false, group: GROUP_CODE, one: "function", many: "functions"},
    CounterSpec{label: "ir instrs", head: "ir", most: false, bytes: false, group: GROUP_CODE, one: "ir", many: "ir"},
    CounterSpec{label: "verify runs", head: "verify runs", most: false, bytes: false, group: GROUP_CODE, one: "verify run", many: "verify runs"},
    CounterSpec{label: "heap blocks", head: "heap blocks", most: false, bytes: false, group: GROUP_MEMORY, one: "block", many: "blocks"},
    CounterSpec{label: "heap bytes", head: "heap bytes", most: false, bytes: true, group: GROUP_MEMORY, one: "allocated", many: "allocated"},
    CounterSpec{label: "heap peak", head: "heap peak", most: true, bytes: true, group: GROUP_MEMORY, one: "peak", many: "peak"},
    CounterSpec{label: "selected instrs", head: "selected", most: false, bytes: false, group: GROUP_CODE, one: "selected", many: "selected"},
    CounterSpec{label: "allocated instrs", head: "allocated", most: false, bytes: false, group: GROUP_CODE, one: "allocated", many: "allocated"},
    CounterSpec{label: "alloc rounds", head: "rounds", most: false, bytes: false, group: GROUP_CODE, one: "alloc round", many: "alloc rounds"},
};

# the group counter c is shown on
pub fun counter_group(c: Counter) Group {
    ret COUNTERS[c].group;
}

# the word counter c takes on its group's line for a value of `count`
pub fun counter_word(c: Counter, count: u64) str {
    if (count == 1) { ret COUNTERS[c].one; }
    ret COUNTERS[c].many;
}

# the label of counter c
pub fun counter_label(c: Counter) str {
    ret COUNTERS[c].label;
}

# the head of counter c's column in the module table
pub fun counter_head(c: Counter) str {
    ret COUNTERS[c].head;
}

# whether counter c counts bytes
pub fun counter_bytes(c: Counter) bool {
    ret COUNTERS[c].bytes;
}

# what a sink asks to receive. every level receives the unit, its summary, failure,
# diagnostic and test run events; phases adds the phase rows and counters, items adds
# one event per module or file a phase processed and the target's facts. a test
# renderer reads the level for how much of each test it shows
pub val LEVEL_RESULTS: u8 = 0;
pub val LEVEL_PHASES:  u8 = 1;
pub val LEVEL_ITEMS:   u8 = 2;

# a unit of the plan starts: what its goal calls the work (`building`,
# `checking`), the artifact, the target and the profile
pub rec Unit {
    artifact: str;
    target:   str;
    profile:  str;
    verb:     str;
}

# a phase row closes: the count it processed, the noun that counts it, its time, the
# threads that time is summed over (0 for a row of wall time), the modules it dropped as
# target-gated, under LEVEL_ITEMS its slowest item, nil when it had fewer than two, the
# size of what it wrote when `sized`, and the errors and warnings reported while it ran
pub rec PhaseEnd {
    phase:           Phase;
    count:           u32;
    noun:            Noun;
    elapsed:         chrono_duration.Duration;
    threads:         u32;
    dropped:         u32;
    slowest:         str;
    slowest_elapsed: chrono_duration.Duration;
    bytes:           u64;
    sized:           bool;
    errors:          u32;
    warnings:        u32;
}

# one module or file a phase finished, when it finished
pub rec Item {
    phase:   Phase;
    name:    str;
    elapsed: chrono_duration.Duration;
}

# a counter's value: one module's under LEVEL_ITEMS, named by it, or the unit's total
# under LEVEL_PHASES, with a nil name
pub rec Tally {
    counter: Counter;
    name:    str;
    value:   u64;
}

# one fact of what a phase settled, under LEVEL_ITEMS: the target's isa, abi and the rest
pub rec Fact {
    key:   str;
    value: str;
}

# what a unit's summary closes: an artifact built, a check, a test build's dispatcher, or a
# unit that failed or was never built
pub def Closed: u8;

pub val CLOSED_BUILT:   Closed = 0;
pub val CLOSED_CHECKED: Closed = 1;
pub val CLOSED_TESTS:   Closed = 2;
pub val CLOSED_FAILED:  Closed = 3;

# a unit finished: what it closed, its artifact, target and profile, the output path, the
# modules in it, the compiled units the build made code for of the units it holds, whether
# the output was written, its size in bytes when the output is one file, whether phase rows
# were kept and so `other` holds the time no row accounts for, and the unit's wall time
pub rec Summary {
    closed:   Closed;
    artifact: str;
    target:   str;
    profile:  str;
    out:      str;
    modules:  u32;
    compiled: u32;
    units:    u32;
    written:  bool;
    bytes:    usize;
    has_size: bool;
    rows:     bool;
    other:    chrono_duration.Duration;
    total:    chrono_duration.Duration;
}

# a failure that reached no diagnostic store, and the phase it is reported under
pub rec Failure {
    fail:   *fail.Fail;
    origin: diagnostic.Origin;
}

# one diagnostic, reported once, with the sources it points into
pub rec Reported {
    sources: *base_source.SourceMap;
    diag:    *diagnostic.Diagnostic;
}

# one test's result, filled in place when the test finishes. start is the instant it
# was launched, none for a test that never ran or when the clock refused, and elapsed
# its wall time from then. log is the file its captured output is kept in, nil when
# none could be named. launch is the command the test was launched through, its
# runner's words and the program before the test's index, nil when the program ran
# itself
pub rec TestResult {
    art:       *testrun.TestArtifact;
    done:      bool;
    result:    testrun.GateResult;
    code:      i32;
    start:     Instant;
    elapsed:   chrono_duration.Duration;
    bound:     chrono_duration.Duration;
    out:       *u8;
    out_len:   usize;
    truncated: bool;
    log:       str;
    launch:    str;
}

# a test run starts over count tests in collection order, each with its art set
# and none done. tests stays valid and in place until the run's run_end, so a
# renderer may read every result as it finishes
pub rec RunStart {
    tests: *TestResult;
    count: u32;
}

# the test at position at of the run finished, whatever its outcome
pub rec TestEnd {
    tests: *TestResult;
    at:    u32;
}

# a test run ended: its results in collection order, the counts of passed,
# failed, skipped and timed-out tests among those that finished, the run's wall
# time, and the gate tally over every finished result
pub rec RunEnd {
    tests:     *TestResult;
    count:     u32;
    passed:    u32;
    failed:    u32;
    skipped:   u32;
    timed_out: u32;
    wall:      chrono_duration.Duration;
    tally:     *testrun.GateTally;
}

# a growing cycle of instances being expanded: the module that declares its templates,
# the templates on it, and how many instances of it the module being typed has made
pub rec Growth {
    module:    str;
    members:   str;
    instances: u32;
}

# one event of a command, in the order it happened. a new kind is a new member
# here and a new arm in each renderer, which skips a member it does not render
pub tag Event: u8 {
    unit:      Unit;
    phase:     PhaseEnd;
    item:      Item;
    tally:     Tally;
    fact:      Fact;
    summary:   Summary;
    failure:   Failure;
    reported:  Reported;
    run_start: RunStart;
    test_end:  TestEnd;
    run_end:   RunEnd;
    growth:    Growth;
}

# where a build's events go: on_event is called once per event, in order, never
# from two threads at once, and may be called from a worker thread. level is
# what the sink asks to receive, and live the slot it draws what runs now from,
# nil when it draws none
pub rec Sink {
    ctx:      ptr;
    on_event: fun(ptr, *Event);
    level:    u8;
    live:     *Live;
}

# whether a sink is present and asks for events at `level` or below
fun wants(sink: *Sink, level: u8) bool {
    ret sink != nil && sink.level >= level;
}

fun deliver(sink: *Sink, ev: Event) {
    var e: Event = ev;
    sink.on_event(sink.ctx, ?e);
}

# the live slot of sink, nil for a nil sink or one that draws none
pub fun live_of(sink: *Sink) *Live {
    if (sink == nil) { ret nil; }
    ret sink.live;
}

# a failure reached no store; a nil sink is a no-op
pub fun failure(sink: *Sink, f: *fail.Fail, origin: diagnostic.Origin) {
    if (sink == nil) { ret; }
    deliver(sink, Event.failure{Failure{fail: f, origin: origin}});
}

# a growing cycle expanded to `instances` instances, sent under the phase readout; a nil
# sink is a no-op
pub fun growth(sink: *Sink, module: str, members: str, instances: u32) {
    if (!wants(sink, LEVEL_PHASES)) { ret; }
    deliver(sink, Event.growth{Growth{module: module, members: members, instances: instances}});
}

# a test run starts; a nil sink is a no-op
pub fun run_start(sink: *Sink, tests: *TestResult, count: u32) {
    if (sink == nil) { ret; }
    deliver(sink, Event.run_start{RunStart{tests: tests, count: count}});
}

# the test at position at finished, its result filled and marked done; a nil
# sink is a no-op
pub fun test_end(sink: *Sink, tests: *TestResult, at: u32) {
    if (sink == nil) { ret; }
    deliver(sink, Event.test_end{TestEnd{tests: tests, at: at}});
}

# a test run ended; a nil sink is a no-op
pub fun run_end(sink: *Sink, end: RunEnd) {
    if (sink == nil) { ret; }
    deliver(sink, Event.run_end{end});
}

# an instant a readout measures from: absent when the platform clock refused
# the sample, so a duration measured from it is zero rather than invented
pub def Instant: opt[time.Instant];

# the instant now, or none when the clock refused
pub fun sample() Instant {
    val res_instant: time.InstantClock = time.instant();
    if (sel res_instant.ok) { ret Instant.some{res_instant.ok}; }
    ret Instant.none{};
}

# the time since start, zero when either sample is absent
pub fun elapsed(start: Instant) chrono_duration.Duration {
    if (sel start.none) { ret 0; }
    val res_instant: time.InstantClock = time.instant();
    if (sel res_instant.err) { ret 0; }
    ret time.instant_sub(res_instant.ok, start.some);
}

# the wall span of the tests from `first` to `last`, from the earliest launch to the latest
# finish, zero when none of them was launched at a sampled instant
# ---
# tests: the results, indexed by test
# first: the index of the first test of the span
# last:  the index of the last test of the span, inclusive
# ret:   the time from the earliest launch to the latest finish
pub fun span(tests: *TestResult, first: u32, last: u32) chrono_duration.Duration {
    var opt_earliest: Instant = Instant.none{};
    var j:            u32     = first;
    for (j <= last) {
        val t: *TestResult = ?tests[j];
        j = j + 1;
        if (sel t.start.none)                                                               { cnt; }
        if (sel opt_earliest.some && !time.instant_before(t.start.some, opt_earliest.some)) { cnt; }
        opt_earliest = t.start;
    }
    if (sel opt_earliest.none) { ret 0; }
    var reach: chrono_duration.Duration = 0;
    j = first;
    for (j <= last) {
        val t: *TestResult = ?tests[j];
        j = j + 1;
        if (sel t.start.none) { cnt; }
        val finish: chrono_duration.Duration = time.instant_sub(t.start.some, opt_earliest.some) + t.elapsed;
        if (finish > reach) { reach = finish; }
    }
    ret reach;
}

# the most bytes of a name the live slot keeps
pub val LIVE_NAME: usize = 256;

# what runs now, written by the engine from any thread and read by the sink's drawer under
# `lock`: the open stage's label, nil when nothing runs, when it opened, how many of its total
# it has done, 0 of 0 when it counts nothing, and the last name it reached
pub rec Live {
    lock:     mutex.Mutex;
    label:    str;
    started:  Instant;
    done:     u32;
    total:    u32;
    name:     [LIVE_NAME]u8;
    name_len: usize;
}

# the live slot as a drawer reads it at one instant: the stage, its time so far, its count and name
pub rec LiveView {
    label:    str;
    elapsed:  chrono_duration.Duration;
    done:     u32;
    total:    u32;
    name:     [LIVE_NAME]u8;
    name_len: usize;
}

# an empty live slot in place
pub fun live_init(l: *Live) {
    l.lock     = mutex.make();
    l.label    = nil;
    l.started  = Instant.none{};
    l.done     = 0;
    l.total    = 0;
    l.name_len = 0;
}

# the stage `label` runs now, opened at `started`: its count and name start over. the label
# must outlive the slot. a nil slot is a no-op
pub fun live_stage(l: *Live, label: str, started: Instant) {
    if (l == nil) { ret; }
    mutex.lock(?l.lock);
    l.label    = label;
    l.started  = started;
    l.done     = 0;
    l.total    = 0;
    l.name_len = 0;
    mutex.unlock(?l.lock);
}

# the running stage has done `done` of `total` and reached `name`, cut to LIVE_NAME. a nil
# slot is a no-op
pub fun live_reach(l: *Live, done: u32, total: u32, name: str) {
    if (l == nil) { ret; }
    mutex.lock(?l.lock);
    l.done  = done;
    l.total = total;
    var n: usize = 0;
    if (name != nil)   { n = str_len(name); }
    if (n > LIVE_NAME) { n = LIVE_NAME; }
    var i: usize = 0;
    for (i < n) {
        l.name[i] = name[i];
        i         = i + 1;
    }
    l.name_len = n;
    mutex.unlock(?l.lock);
}

# nothing runs now. a nil slot is a no-op
pub fun live_close(l: *Live) {
    if (l == nil) { ret; }
    mutex.lock(?l.lock);
    l.label = nil;
    mutex.unlock(?l.lock);
}

# the live slot as it stands now, into v
# ---
# ret: whether a stage runs, v untouched when none does
pub fun live_view(l: *Live, v: *LiveView) bool {
    if (l == nil) { ret false; }
    mutex.lock(?l.lock);
    val running: bool = l.label != nil;
    if (running) {
        v.label    = l.label;
        v.elapsed  = elapsed(l.started);
        v.done     = l.done;
        v.total    = l.total;
        v.name_len = l.name_len;
        var i: usize = 0;
        for (i < l.name_len) {
            v.name[i] = l.name[i];
            i         = i + 1;
        }
    }
    mutex.unlock(?l.lock);
    ret running;
}

# one phase row while it runs: whether it is open and when it opened, the time carved out of
# it for hosted phases, the wall time carved into it and the thread time summed into it,
# whether it is hosted, the most threads it sums over, the modules it dropped, its item count
# and slowest item, and the unit's error and warning counts when it opened
rec PhaseState {
    open:            bool;
    started:         Instant;
    carved:          chrono_duration.Duration;
    borrowed:        chrono_duration.Duration;
    summed_time:     chrono_duration.Duration;
    hosted:          bool;
    summed:          u32;
    dropped:         u32;
    items:           u32;
    slowest:         str;
    slowest_elapsed: chrono_duration.Duration;
    errors_at:       u32;
    warnings_at:     u32;
}

# one unit's progress: its wall time, and its phase rows, timed as they run and sent to the
# sink as each closes when `rows`, the errors and warnings it reported and the keys of the
# reports it has delivered, so each is delivered once. a run with no sink has no progress, and
# a progress without rows times no span or item and sends no row
pub rec Progress {
    sink:       *Sink;
    rows:       bool;
    unit_start: Instant;
    unit_rows:  chrono_duration.Duration;
    phases:     [PHASE_COUNT]PhaseState;
    counts:     [COUNTER_COUNT]u64;
    errors:     u32;
    warnings:   u32;
    said:       collections_vector.Vector[u64];
}

# start a unit's progress over sink, timed from now, and send its unit event
# ---
# pr:   the storage, which must outlive every use of the returned pointer
# sink: the command's sink, or nil
# a:    holds the keys of the reports the unit delivers, until its summary
# u:    the unit
# ret:  pr, or nil when there is no sink
pub fun start(pr: *Progress, sink: *Sink, a: *A.Allocator, u: Unit) *Progress {
    if (sink == nil) { ret nil; }
    pr.sink = sink;
    # the live line's stage time is a row's own time, so a sink that draws one keeps rows too
    pr.rows       = sink.level >= LEVEL_PHASES || sink.live != nil;
    pr.unit_start = sample();
    pr.unit_rows  = 0;
    pr.errors     = 0;
    pr.warnings   = 0;
    pr.said       = collections_vector.init[u64](a);
    var i: usize = 0;
    for (i < PHASE_COUNT) {
        phase_reset(?pr.phases[i]);
        pr.phases[i].open    = false;
        pr.phases[i].started = Instant.none{};
        i                    = i + 1;
    }
    var c: usize = 0;
    for (c < COUNTER_COUNT) {
        pr.counts[c] = 0;
        c            = c + 1;
    }
    deliver(sink, Event.unit{u});
    ret pr;
}

fun phase_reset(p: *PhaseState) {
    p.carved          = 0;
    p.borrowed        = 0;
    p.summed_time     = 0;
    p.hosted          = false;
    p.summed          = 0;
    p.dropped         = 0;
    p.items           = 0;
    p.slowest         = nil;
    p.slowest_elapsed = 0;
}

# phase ph's row opens now; its time runs to phase_end, less what is carved out of it. a
# phase with no parent is what the live slot shows from now
pub fun phase_begin(pr: *Progress, ph: Phase) {
    if (pr == nil) { ret; }
    val p: *PhaseState = ?pr.phases[ph];
    phase_reset(p);
    p.open        = true;
    p.started     = sample();
    p.hosted      = whole(ph);
    p.errors_at   = pr.errors;
    p.warnings_at = pr.warnings;
    if (PHASES[ph].parent == PHASE_NONE) { live_stage(pr.sink.live, PHASES[ph].label, p.started); }
}

# phase ph runs inside another phase and is timed by the spans moved into it
pub fun phase_carved(pr: *Progress, ph: Phase) {
    if (!rows(pr)) { ret; }
    pr.phases[ph].hosted = true;
}

# phase ph runs on up to `threads` threads beside its host, timed by the sum of what each
# spent (summed_into): its row is part of no other and says how many threads it sums. a phase
# summed twice sums over the most threads either names
pub fun phase_summed(pr: *Progress, ph: Phase, threads: u32) {
    if (!rows(pr)) { ret; }
    val p: *PhaseState = ?pr.phases[ph];
    if (threads > p.summed) { p.summed = threads; }
    p.hosted = true;
}

# the time d one thread spent in the summed phase ph
pub fun summed_into(pr: *Progress, ph: Phase, d: chrono_duration.Duration) {
    if (!rows(pr)) { ret; }
    val c: *PhaseState = ?pr.phases[ph];
    c.summed_time = c.summed_time + d;
    c.hosted      = true;
}

# phase ph dropped n modules as target-gated
pub fun phase_dropped(pr: *Progress, ph: Phase, n: u32) {
    if (!rows(pr)) { ret; }
    pr.phases[ph].dropped = n;
}

# the start of a span that span_end moves into a hosted phase
pub fun span_begin(pr: *Progress) Instant {
    if (!rows(pr)) { ret Instant.none{}; }
    ret sample();
}

# the span from start belongs to ph, and leaves the phase host that ran it
pub fun span_end(pr: *Progress, ph: Phase, host: Phase, start: Instant) {
    if (!rows(pr)) { ret; }
    carve(pr, ph, host, elapsed(start));
}

# the span from start belongs to the hosted phase ph, and was spent outside every other row
pub fun span_into(pr: *Progress, ph: Phase, start: Instant) {
    if (!rows(pr)) { ret; }
    val c: *PhaseState = ?pr.phases[ph];
    c.borrowed = c.borrowed + elapsed(start);
    c.hosted   = true;
}

# the time d belongs to ph, and leaves the phase host that spent it
pub fun carve(pr: *Progress, ph: Phase, host: Phase, d: chrono_duration.Duration) {
    if (!rows(pr)) { ret; }
    val c: *PhaseState = ?pr.phases[ph];
    c.borrowed = c.borrowed + d;
    c.hosted   = true;
    val h: *PhaseState = ?pr.phases[host];
    h.carved = h.carved + d;
}

# the start of an item, sampled only when the sink takes items
pub fun item_begin(pr: *Progress) Instant {
    if (!items(pr)) { ret Instant.none{}; }
    ret sample();
}

# whether the sink takes items, which a caller asks before it spends on naming one
pub fun items(pr: *Progress) bool {
    ret rows(pr) && pr.sink.level >= LEVEL_ITEMS;
}

# whether a progress keeps phase rows, which every span and item call asks
pub fun rows(pr: *Progress) bool {
    ret pr != nil && pr.rows;
}

# the running phase has done `done` of its `total`, the last of them `name`, shown on the live
# slot; a total of 0 counts nothing and shows the name alone
pub fun reached(pr: *Progress, done: u32, total: u32, name: str) {
    if (pr == nil) { ret; }
    live_reach(pr.sink.live, done, total, name);
}

# name finished phase ph, measured from start
pub fun item(pr: *Progress, ph: Phase, name: str, start: Instant) {
    if (!items(pr)) { ret; }
    item_send(pr, Item{phase: ph, name: name, elapsed: elapsed(start)});
}

# name spent d in phase ph, measured by its caller
pub fun item_spent(pr: *Progress, ph: Phase, name: str, d: chrono_duration.Duration) {
    if (!items(pr)) { ret; }
    item_send(pr, Item{phase: ph, name: name, elapsed: d});
}

# one fact the running phase settled, sent under LEVEL_ITEMS
pub fun fact(pr: *Progress, key: str, value: str) {
    if (!items(pr)) { ret; }
    deliver(pr.sink, Event.fact{Fact{key: key, value: value}});
}

# the module name's value of counter c, added to the unit's total and sent under LEVEL_ITEMS
pub fun count(pr: *Progress, c: Counter, name: str, value: u64) {
    if (!rows(pr)) { ret; }
    if (COUNTERS[c].most) {
        if (value > pr.counts[c]) { pr.counts[c] = value; }
    }
    or             { pr.counts[c] = pr.counts[c] + value; }
    if (items(pr)) { deliver(pr.sink, Event.tally{Tally{counter: c, name: name, value: value}}); }
}

# send the unit's total of every counter posted since the last close, then start them over
pub fun counts_end(pr: *Progress) {
    if (!rows(pr)) { ret; }
    var c: usize = 0;
    for (c < COUNTER_COUNT) {
        if (pr.counts[c] != 0) { deliver(pr.sink, Event.tally{Tally{counter: c::Counter, name: nil, value: pr.counts[c]}}); }
        pr.counts[c] = 0;
        c            = c + 1;
    }
}

# count an item against its phase, keep it when it is the slowest, and send it
fun item_send(pr: *Progress, it: Item) {
    val p: *PhaseState = ?pr.phases[it.phase];
    p.items = p.items + 1;
    if (p.slowest == nil || it.elapsed > p.slowest_elapsed) {
        p.slowest         = it.name;
        p.slowest_elapsed = it.elapsed;
    }
    deliver(pr.sink, Event.item{it});
}

# close phase ph's row: count is what it processed, counted by noun
pub fun phase_end(pr: *Progress, ph: Phase, count: u32, noun: Noun) {
    phase_close(pr, ph, count, noun, 0, false);
}

# close phase ph's row over the one file it wrote, `bytes` long
pub fun phase_end_sized(pr: *Progress, ph: Phase, count: u32, noun: Noun, bytes: u64) {
    phase_close(pr, ph, count, noun, bytes, true);
}

fun phase_close(pr: *Progress, ph: Phase, count: u32, noun: Noun, bytes: u64, sized: bool) {
    if (pr == nil) { ret; }
    val p:      *PhaseState = ?pr.phases[ph];
    val parent: Phase       = PHASES[ph].parent;
    p.open = false;
    if (parent == PHASE_NONE) { live_resume(pr); }
    if (!pr.rows)             { ret; }

    var wall: chrono_duration.Duration = elapsed(p.started) - p.carved;
    if (p.hosted) { wall = p.borrowed; }
    if (wall < 0) { wall = 0; }
    var threads: u32 = 0;
    if (p.summed > 1 && p.summed_time > 0) { threads = p.summed; }
    if (parent != PHASE_NONE) {
        val host: *PhaseState = ?pr.phases[parent];
        host.borrowed = host.borrowed + wall;
    }
    or { pr.unit_rows = pr.unit_rows + wall; }

    var slowest: str = nil;
    if (p.items >= 2 && p.slowest_elapsed > 0) { slowest = p.slowest; }
    deliver(pr.sink, Event.phase{PhaseEnd{phase: ph, count: count, noun: noun, elapsed: wall + p.summed_time, threads: threads,
        dropped: p.dropped, slowest: slowest, slowest_elapsed: p.slowest_elapsed, bytes: bytes, sized: sized,
        errors:  pr.errors - p.errors_at, warnings: pr.warnings - p.warnings_at}});
}

# the live slot shows the latest phase with no parent still open, or nothing when none is
fun live_resume(pr: *Progress) {
    var latest: Phase = PHASE_NONE;
    var i:      usize = 0;
    for (i < PHASE_COUNT) {
        val p:    *PhaseState = ?pr.phases[i];
        val shut: bool        = !p.open || PHASES[i].parent != PHASE_NONE;
        i = i + 1;
        if (shut) { cnt; }
        if (latest == PHASE_NONE) {
            latest = (i - 1)::Phase;
            cnt;
        }
        val q: *PhaseState = ?pr.phases[latest];
        if (sel q.started.none) {
            latest = (i - 1)::Phase;
            cnt;
        }
        if (sel p.started.some) {
            if (time.instant_after(p.started.some, q.started.some)) { latest = (i - 1)::Phase; }
        }
    }
    if (latest == PHASE_NONE) {
        live_close(pr.sink.live);
        ret;
    }
    # the time carved out of the phase for the hosted ones that ran inside it is not its own
    val opened:  Instant = pr.phases[latest].started;
    var started: Instant = opened;
    if (sel opened.some) { started = Instant.some{time.instant_add(opened.some, pr.phases[latest].carved)}; }
    live_stage(pr.sink.live, PHASES[latest].label, started);
}

# deliver each report of `store` the unit has not delivered before, counting its errors and
# warnings; a report whose key cannot be kept is delivered and may be again. a nil progress is
# a no-op
# ---
# pr:      the unit's progress
# sources: the source map the reports point into
# store:   the unit's store, as it stands now
pub fun settle(pr: *Progress, sources: *base_source.SourceMap, store: *diagnostic.DiagnosticStore) {
    if (pr == nil) { ret; }
    val n: usize = diagnostic.len(store);
    var i: usize = 0;
    for (i < n) {
        val d: *diagnostic.Diagnostic = ?store.items.data[i];
        i = i + 1;
        val key: u64 = diagnostic.report_key(d);
        if (said(pr, key)) { cnt; }
        val res_kept: res[usize, A.Error] = collections_vector.push[u64](?pr.said, key);
        if (diagnostic.is_error(d))           { pr.errors = pr.errors + 1; }
        or (!diagnostic_kind.is_note(d.kind)) { pr.warnings = pr.warnings + 1; }
        deliver(pr.sink, Event.reported{Reported{sources: sources, diag: d}});
    }
}

# whether the report keyed `key` has been delivered
fun said(pr: *Progress, key: u64) bool {
    var i: usize = 0;
    for (i < pr.said.len) {
        if (pr.said.data[i] == key) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the errors and warnings the unit has reported so far
pub fun errors_of(pr: *Progress) u32 {
    if (pr == nil) { ret 0; }
    ret pr.errors;
}

# the unit finished: its wall time is measured here, and the time no row accounts for, which
# floors at zero, is set when the progress kept rows. the live slot is emptied and the keys
# of what it reported let go. a nil progress is a no-op
pub fun summary(pr: *Progress, sum: Summary) {
    if (pr == nil) { ret; }
    live_close(pr.sink.live);
    var s: Summary = sum;
    s.total = elapsed(pr.unit_start);
    s.rows  = pr.rows;
    s.other = 0;
    if (pr.rows) {
        s.other = s.total - pr.unit_rows;
        if (s.other < 0) { s.other = 0; }
    }
    val err_freed: err[A.Error] = collections_vector.dnit[u64](?pr.said);
    deliver(pr.sink, Event.summary{s});
}
