# the status a phase ends with: accepted, rejected through diagnostics, or failed
#
# a status counts its rejections, keeps the first failure that is not the input's, and merges
# into another.

use std.types.bool.bool;
use std.types.option.opt;

use mach.base.fail;

# phase status is independent of diagnostic storage and rendering: accepted,
# rejected through recorded diagnostics, or failed with the first failure that
# is not the input's, a defect or the machine's refusal, which borrows its text
# and keeps where it points
pub tag PhaseKind: u8 {
    accepted;
    rejected;
    internal: fail.Fail;
}

# the status of one phase and how many rejections it recorded
# ---
# kind:       accepted, rejected or failed internally
# rejections: the number of rejections recorded against the phase
pub rec PhaseStatus {
    kind:       PhaseKind;
    rejections: u64;
}

# a status that is accepted with no rejections
# ---
# ret: the fresh status
pub fun accepted() PhaseStatus {
    var s: PhaseStatus;
    s.kind       = PhaseKind.accepted{};
    s.rejections = 0;
    ret s;
}

# count one rejection, turning an accepted status rejected and leaving an internal failure as it is
# ---
# s: the status to update
pub fun reject(s: *PhaseStatus) {
    s.rejections = s.rejections + 1;
    val was_accepted: bool = sel s.kind.accepted;
    if (was_accepted) { s.kind = PhaseKind.rejected{}; }
}

# fail the phase with the defect `f` names, or with `f` itself when the machine refused, which
# is no defect, unless it failed so already
pub fun internal(s: *PhaseStatus, f: fail.Fail) {
    val already: bool = sel s.kind.internal;
    if (already) { ret; }
    if (fail.is_environment(f)) {
        s.kind = PhaseKind.internal{f};
        ret;
    }
    s.kind = PhaseKind.internal{fail.defect(f)};
}

# whether the phase is still accepted
# ---
# s:   the status to inspect
# ret: true when it was never rejected and never failed internally
pub fun is_accepted(s: PhaseStatus) bool {
    ret sel s.kind.accepted;
}

# the internal failure, absent unless the phase failed internally
pub fun internal_failure(s: PhaseStatus) opt[fail.Fail] {
    if (sel s.kind.internal) { ret opt[fail.Fail].some{s.kind.internal}; }
    ret opt[fail.Fail].none{};
}

# the failure a phase ends with
# ---
# s:   the status to read
# ret: the reported marker when it was rejected, the internal failure when it failed, and
#      a message failure when it was accepted, which callers never ask
pub fun phase_failure(s: PhaseStatus) fail.Fail {
    if (sel s.kind.rejected) { ret fail.reported(); }
    or (sel s.kind.internal) { ret s.kind.internal; }
    ret fail.message("an accepted phase has no failure");
}

# fold one status into another, adding its rejections and keeping the first internal failure
# ---
# into: the status that takes the result
# from: the status merged in
pub fun merge(into: *PhaseStatus, from: PhaseStatus) {
    into.rejections = into.rejections + from.rejections;
    if (sel from.kind.internal) { internal(into, from.kind.internal); }
    or (sel from.kind.rejected) {
        val was_accepted: bool = sel into.kind.accepted;
        if (was_accepted) { into.kind = PhaseKind.rejected{}; }
    }
}
