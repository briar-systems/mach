# the mirl shape of a source type: the one place mach decides how a type is held in mirl's
# type table, which lowering interns into its module's table and sema into the table it lays
# types out over, so the size sema answers and the type codegen builds cannot disagree
#
# a record or union is its fields in order at the alignment and packing it declares, a tag
# its discriminator then a union of payloads per area its placement gives, an opaque abi
# type a structure of its bytes at its alignment. what reaching a member type means,
# substitution, a memo, a cycle on the path, and how a tag's cases are placed, is the
# caller's, through `Reach`
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.collections.slice.Slice;

use types_format: mirl.ir.type.format;
use types:        mirl.ir.type.table;
use mirl.ir.type.table.Type;

use mach.type;
use type_field: mach.type.field;
use type_kind:  mach.type.kind;
use type_prim:  mach.type.prim;

# why a source type has no shape
# ---
# member:        reaching a member type refused it, the caller's reason held by its context
# unknown:       a kind that has no shape: a type parameter, a pack, an unresolved nominal
# empty_tag:     a tag with no cases
# discriminator: a tag with no discriminator type
# table:         mirl's type table refused a type
# alloc:         no storage for a member list
# placement:     placing a tag's cases was refused, the caller's reason held by its context
pub tag Unshaped: u8 {
    member;
    unknown;
    empty_tag;
    discriminator;
    table: types.Error;
    alloc: A.Error;
    placement;
}

# how a caller reaches what the shape of a type is made of
# ---
# ctx:     the caller's context
# member:  the type of a member, element or payload, interned in the same table, none when
#          the caller refuses it with a reason it holds
# handle:  the type of a target handle
# place:   the placement of a tag's cases, none when the caller refuses it with a reason it
#          holds
# pointer: the type a pointer is held in
pub rec Reach[T] {
    ctx:     *T;
    member:  fun(*T, type_kind.TypeId) opt[Type];
    handle:  fun(*T, *type.Type) opt[Type];
    place:   fun(*T, type_kind.TypeId) opt[Placement];
    pointer: Type;
}

fun interned(t: *types.Table, s: types.Shape) res[Type, Unshaped] {
    val res_intern: res[Type, types.Error] = types.intern(t, s);
    if (sel res_intern.err) { ret res[Type, Unshaped].err{Unshaped.table{res_intern.err}}; }
    ret res[Type, Unshaped].ok{res_intern.ok};
}

fun stated(align: u32) opt[u64] {
    if (align == 0) { ret opt[u64].none{}; }
    ret opt[u64].some{align::u64};
}

# a signless integer of `bits`, rounded up to a width mirl holds
pub fun integer(t: *types.Table, bits: u32) res[Type, Unshaped] {
    var w: u32 = 1;
    if (bits > 1) {
        w = 8;
        for (w < bits) { w = w * 2; }
    }
    ret interned(t, types.Shape.integer{types.Integer{width: w}});
}

# the format of a float of `bits`, none for a width mirl has no format for
pub fun format(bits: u32) opt[types_format.Format] {
    if (bits == 16) { ret opt[types_format.Format].some{types_format.BINARY16}; }
    if (bits == 32) { ret opt[types_format.Format].some{types_format.BINARY32}; }
    if (bits == 64) { ret opt[types_format.Format].some{types_format.BINARY64}; }
    ret opt[types_format.Format].none{};
}

# an integer or float primitive
pub fun scalar(t: *types.Table, d: type_prim.PrimDesc) res[Type, Unshaped] {
    if (d.class == type_prim.PRIM_CLASS_FLOAT) {
        val opt_format: opt[types_format.Format] = format(d.bits);
        if (sel opt_format.none) { ret res[Type, Unshaped].err{Unshaped.unknown{}}; }
        ret interned(t, types.Shape.float{types.Float{format: opt_format.some}});
    }
    ret integer(t, d.bits);
}

# an opaque type of `size` bytes at the alignment `align`
pub fun opaque(t: *types.Table, size: u32, align: u32) res[Type, Unshaped] {
    val res_byte: res[Type, Unshaped] = integer(t, 8);
    if (sel res_byte.err) { ret res_byte; }
    val res_bytes: res[Type, Unshaped] = interned(t, types.Shape.array{types.Array{count: size::u64, element: res_byte.ok, stride: opt[u64].none{}}});
    if (sel res_bytes.err) { ret res_bytes; }
    var member: Type = res_bytes.ok;
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?member, size: 1}, offsets: opt[Slice[u64]].none{}, align: stated(align), packed: false}});
}

# the shape of the source type `tid`, its secrecy and its substitution already the caller's.
# a nil type is an empty structure
pub fun of[T](t: *types.Table, ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T]) res[Type, Unshaped] {
    if (type_kind.is_nil(tid)) { ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: nil, size: 0}, offsets: opt[Slice[u64]].none{}, align: opt[u64].none{}, packed: false}}); }
    val opt_tid_entry: opt[*type.Type] = type.get(ti, tid);
    if (sel opt_tid_entry.none) { ret res[Type, Unshaped].err{Unshaped.unknown{}}; }
    val ty: *type.Type         = opt_tid_entry.some;
    val k:  type_kind.TypeKind = ty.kind;

    if (k == type_kind.TYPE_SECRET) { ret reached[T](r, ty.data.secret.base); }
    val d: type_prim.PrimDesc = type_prim.prim_desc(k);
    if (d.class == type_prim.PRIM_CLASS_INT || d.class == type_prim.PRIM_CLASS_FLOAT)                  { ret scalar(t, d); }
    if (d.class == type_prim.PRIM_CLASS_PTR || k == type_kind.TYPE_POINTER || k == type_kind.TYPE_FUN) { ret res[Type, Unshaped].ok{r.pointer}; }
    if (k == type_kind.TYPE_ARRAY) {
        val res_element: res[Type, Unshaped] = reached[T](r, ty.data.array.base);
        if (sel res_element.err) { ret res_element; }
        ret interned(t, types.Shape.array{types.Array{count: ty.data.array.count::u64, element: res_element.ok, stride: opt[u64].none{}}});
    }
    if (k == type_kind.TYPE_VECTOR) {
        val res_lane: res[Type, Unshaped] = scalar(t, type_prim.prim_desc(ty.data.vector.element));
        if (sel res_lane.err) { ret res_lane; }
        ret interned(t, types.Shape.vector{types.Vector{lanes: ty.data.vector.lanes, element: res_lane.ok}});
    }
    if (k == type_kind.TYPE_HANDLE) {
        val handle:   fun(*T, *type.Type) opt[Type] = r.handle;
        val opt_made: opt[Type]                     = handle(r.ctx, ty);
        if (sel opt_made.none) { ret res[Type, Unshaped].err{Unshaped.member{}}; }
        ret res[Type, Unshaped].ok{opt_made.some};
    }
    if (k == type_kind.TYPE_ABI) { ret opaque(t, ty.data.abi.size, ty.data.abi.align); }
    if (k == type_kind.TYPE_REC || k == type_kind.TYPE_UNI || k == type_kind.TYPE_TAG || k == type_kind.TYPE_INSTANCE) {
        val opt_table: opt[*type_field.Table] = type.field_table_for(ti, tid);
        if (sel opt_table.none)      { ret res[Type, Unshaped].err{Unshaped.unknown{}}; }
        if (type.is_tag(ti, tid))    { ret tagged[T](t, ti, tid, r); }
        if (type.is_union(ti, tid))  { ret nominal[T](t, ti, tid, r, true); }
        if (type.is_record(ti, tid)) { ret nominal[T](t, ti, tid, r, false); }
    }
    ret res[Type, Unshaped].err{Unshaped.unknown{}};
}

fun reached[T](r: *Reach[T], tid: type_kind.TypeId) res[Type, Unshaped] {
    val member:   fun(*T, type_kind.TypeId) opt[Type] = r.member;
    val opt_made: opt[Type]                           = member(r.ctx, tid);
    if (sel opt_made.none) { ret res[Type, Unshaped].err{Unshaped.member{}}; }
    ret res[Type, Unshaped].ok{opt_made.some};
}

# the types of the fields of `tid` in order onto `out`, a tag's caseless cases skipped
fun members[T](ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T], payloads: bool, out: *Type, len: *u32) err[Unshaped] {
    val n: u32 = type.field_count(ti, tid);
    var i: u32 = 0;
    for (i < n) {
        val opt_field_at: opt[*type_field.Entry] = type.field_at(ti, tid, i);
        i = i + 1;
        if (sel opt_field_at.none)                              { ret err[Unshaped].err{Unshaped.unknown{}}; }
        if (payloads && type_kind.is_nil(opt_field_at.some.ty)) { cnt; }
        val res_reached: res[Type, Unshaped] = reached[T](r, opt_field_at.some.ty);
        if (sel res_reached.err) { ret err[Unshaped].err{res_reached.err}; }
        out[@len] = res_reached.ok;
        @len      = @len + 1;
    }
    ret err[Unshaped].ok{};
}

# a record or union: its fields in order, at the alignment and packing it declares
fun nominal[T](t: *types.Table, ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T], overlaid: bool) res[Type, Unshaped] {
    val dec:      type_field.Decoration = type.decoration_of(ti, tid);
    val n:        usize                 = type.field_count(ti, tid)::usize + 1;
    val res_held: res[*Type, A.Error]   = A.allocate[Type](ti.a, n);
    if (sel res_held.err) { ret res[Type, Unshaped].err{Unshaped.alloc{res_held.err}}; }
    val buf: *Type = res_held.ok;
    fin { A.deallocate[Type](ti.a, buf, n); }
    var len:        u32           = 0;
    val err_walked: err[Unshaped] = members[T](ti, tid, r, false, buf, ?len);
    if (sel err_walked.err) { ret res[Type, Unshaped].err{err_walked.err}; }
    val list: Slice[Type] = Slice[Type]{data: buf, size: len::usize};
    if (overlaid) { ret interned(t, types.Shape.union{types.Union{members: list, align: stated(dec.align), packed: dec.packed}}); }
    ret interned(t, types.Shape.structure{types.Structure{members: list, offsets: opt[Slice[u64]].none{}, align: stated(dec.align), packed: dec.packed}});
}

# the member of a tag's structure that holds its discriminator. the areas of its payloads
# follow it, the first at member 1
pub val TAG_DISCRIMINANT: u32 = 0;
pub val TAG_AREA:         u32 = 1;

# where a tag holds the payload of a case
# ---
# area:   the member of the tag's structure that is the union of the payloads it shares,
#         NO_AREA for a case with no payload
# member: the member of that union the payload is laid out as
pub rec Carried {
    area:   u32;
    member: u32;
}

pub val NO_AREA: u32 = 0;

# how a tag's cases share bytes: two cases share an area only where they agree on the
# secrecy of every byte both cover, which mach.type.query.areas decides for the target
# ---
# cases: where each case's payload is held, in case order
# areas: the count of areas
pub rec Placement {
    cases: Slice[Carried];
    areas: u32;
}

# where case `i` holds its payload, none for a case with no payload
pub fun carried(p: Placement, i: u32) opt[Carried] {
    if (i::usize >= p.cases.size)        { ret opt[Carried].none{}; }
    if (p.cases.data[i].area == NO_AREA) { ret opt[Carried].none{}; }
    ret opt[Carried].some{p.cases.data[i]};
}

# a tag: its discriminator, then one union per area of the payloads its placement puts
# there, each in case order, at the alignment and packing it declares
fun tagged[T](t: *types.Table, ti: *type.TypeInterner, tid: type_kind.TypeId, r: *Reach[T]) res[Type, Unshaped] {
    val bytes: u32 = type.tag_discriminator_bytes(ti, tid);
    if (bytes == 0) { ret res[Type, Unshaped].err{Unshaped.discriminator{}}; }
    val cases: u32 = type.field_count(ti, tid);
    if (cases == 0) { ret res[Type, Unshaped].err{Unshaped.empty_tag{}}; }
    val res_disc: res[Type, Unshaped] = integer(t, bytes * 8);
    if (sel res_disc.err) { ret res_disc; }

    val res_buf: res[*Type, A.Error] = A.allocate[Type](ti.a, cases::usize);
    if (sel res_buf.err) { ret res[Type, Unshaped].err{Unshaped.alloc{res_buf.err}}; }
    val buf: *Type = res_buf.ok;
    fin { A.deallocate[Type](ti.a, buf, cases::usize); }
    var len:        u32           = 0;
    val err_walked: err[Unshaped] = members[T](ti, tid, r, true, buf, ?len);
    if (sel err_walked.err) { ret res[Type, Unshaped].err{err_walked.err}; }

    # asked once the members are reached, so every type a payload's bytes need is laid
    val place:     fun(*T, type_kind.TypeId) opt[Placement] = r.place;
    val opt_place: opt[Placement]                           = place(r.ctx, tid);
    if (sel opt_place.none) { ret res[Type, Unshaped].err{Unshaped.placement{}}; }
    val p: Placement = opt_place.some;

    val count:     usize               = 1 + p.areas::usize;
    val res_parts: res[*Type, A.Error] = A.allocate[Type](ti.a, count);
    if (sel res_parts.err) { ret res[Type, Unshaped].err{Unshaped.alloc{res_parts.err}}; }
    val parts: *Type = res_parts.ok;
    fin { A.deallocate[Type](ti.a, parts, count); }
    val res_area: res[*Type, A.Error] = A.allocate[Type](ti.a, cases::usize);
    if (sel res_area.err) { ret res[Type, Unshaped].err{Unshaped.alloc{res_area.err}}; }
    val area: *Type = res_area.ok;
    fin { A.deallocate[Type](ti.a, area, cases::usize); }

    val dec: type_field.Decoration = type.decoration_of(ti, tid);
    parts[TAG_DISCRIMINANT] = res_disc.ok;
    var k: u32 = 0;
    for (k < p.areas) {
        # the payloads `buf` holds in case order, skipping the cases with none
        var area_len: u32 = 0;
        var at:       u32 = 0;
        var c:        u32 = 0;
        for (c < cases && c::usize < p.cases.size) {
            val placed: Carried = p.cases.data[c];
            c = c + 1;
            if (placed.area == NO_AREA) { cnt; }
            if (placed.area == TAG_AREA + k) {
                area[area_len] = buf[at];
                area_len       = area_len + 1;
            }
            at = at + 1;
        }
        val res_union: res[Type, Unshaped] = interned(t, types.Shape.union{types.Union{members: Slice[Type]{data: area, size: area_len::usize}, align: opt[u64].none{}, packed: dec.packed}});
        if (sel res_union.err) { ret res_union; }
        parts[TAG_AREA + k] = res_union.ok;
        k                   = k + 1;
    }
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: parts, size: count}, offsets: opt[Slice[u64]].none{}, align: stated(dec.align), packed: dec.packed}});
}
