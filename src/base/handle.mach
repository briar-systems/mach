# stores whose elements never move
#
# a `StableChunks` grows by fixed chunks, so a pointer to an element stays valid until the store
# is released, and one exclusive editor appends at a time.

use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use base_alloc: mach.base.alloc;

# a chunk holds a power of two of elements, so an index splits into chunk and offset by its bits
val CHUNK_SHIFT:    usize = 6;
val CHUNK_CAPACITY: usize = 1 << CHUNK_SHIFT;
val CHUNK_MASK:     usize = CHUNK_CAPACITY - 1;

# a store's refusal: the allocator's, a store or editor that is not live, or a
# second exclusive editor
pub tag Error: u8 {
    alloc: A.Error;
    absent;
    busy;
}

# the text of a store's refusal
pub fun text(e: Error) str {
    if (sel e.alloc)  { ret base_alloc.text(e.alloc); }
    or (sel e.absent) { ret "store is not live"; }
    ret "store already has an exclusive editor";
}

# elements kept in fixed chunks, so an element never moves until the store is released. a store may
# borrow another's chunks (chunk_borrow): its first `borrowed` chunks are the lender's, and until its
# first edit so is the list of them
# ---
# a:        owns the chunks past the borrowed ones
# chunks:   the chunks, each CHUNK_CAPACITY elements
# len:      how many elements the store holds, the lender's included
# editing:  an editor holds the store
# borrowed: how many leading chunks are the lender's, never released by this store
# lent:     the list of chunks is still the lender's, copied at the first edit
pub rec StableChunks[T] {
    a:        *A.Allocator;
    chunks:   Vector[*T];
    len:      usize;
    editing:  bool;
    borrowed: usize;
    lent:     bool;
}

# the exclusive right to append to one store, from chunk_editor until chunk_editor_finish
# ---
# store: the store it edits, nil once finished
pub rec ChunkEditor[T] {
    store: *StableChunks[T];
}

# an empty store, released with chunk_dnit
pub fun chunk_init[T](a: *A.Allocator) StableChunks[T] {
    var s: StableChunks[T];
    s.a        = a;
    s.chunks   = collections_vector.init[*T](a);
    s.len      = 0;
    s.editing  = false;
    s.borrowed = 0;
    s.lent     = false;
    ret s;
}

# a store that reads every element of `from` as its own and adds its own past them: it borrows
# `from`'s chunks, which take nothing new while it lives, and at its first edit copies the list of
# them and the last one when `from` left it part full
pub fun chunk_borrow[T](a: *A.Allocator, from: *StableChunks[T]) StableChunks[T] {
    var s: StableChunks[T];
    s.a        = a;
    s.chunks   = from.chunks;
    s.len      = from.len;
    s.editing  = false;
    s.borrowed = from.chunks.len;
    s.lent     = true;
    ret s;
}

# the borrowed list of chunks made the store's own, the lender's part-full last chunk copied, so an
# edit writes nothing the lender holds
fun chunk_own[T](s: *StableChunks[T]) err[Error] {
    var own: Vector[*T] = collections_vector.init[*T](s.a);
    var i:   usize      = 0;
    for (i < s.chunks.len) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[*T](?own, s.chunks.data[i]);
        if (sel res_pushed.err) {
            collections_vector.dnit[*T](?own);
            ret err[Error].err{Error.alloc{res_pushed.err}};
        }
        i = i + 1;
    }
    if ((s.len & CHUNK_MASK) != 0) {
        val res_alloc: res[*T, A.Error] = A.zallocate[T](s.a, CHUNK_CAPACITY);
        if (sel res_alloc.err) {
            collections_vector.dnit[*T](?own);
            ret err[Error].err{Error.alloc{res_alloc.err}};
        }
        val last: usize = own.len - 1;
        var k:    usize = 0;
        for (k < (s.len & CHUNK_MASK)) {
            res_alloc.ok[k] = own.data[last][k];
            k               = k + 1;
        }
        own.data[last] = res_alloc.ok;
        s.borrowed     = last;
    }
    s.chunks = own;
    s.lent   = false;
    ret err[Error].ok{};
}

# release a store and its chunks; a nil store holds nothing
pub fun chunk_dnit[T](s: *StableChunks[T]) {
    if (s == nil) { ret; }
    var i: usize = s.borrowed;
    for (i < s.chunks.len) {
        A.deallocate[T](s.a, s.chunks.data[i], CHUNK_CAPACITY);
        i = i + 1;
    }
    if (!s.lent) { collections_vector.dnit[*T](?s.chunks); }
    s.chunks   = collections_vector.init[*T](s.a);
    s.len      = 0;
    s.editing  = false;
    s.borrowed = 0;
    s.lent     = false;
}

# how many elements the store holds, none for a nil store
pub fun chunk_count[T](s: *StableChunks[T]) usize {
    if (s == nil) { ret 0; }
    ret s.len;
}

# the element at `index`, absent past the end or on a nil store
pub fun chunk_at[T](s: *StableChunks[T], index: usize) opt[*T] {
    if (s == nil)       { ret opt[*T].none{}; }
    if (index >= s.len) { ret opt[*T].none{}; }
    val chunk: *T = s.chunks.data[index >> CHUNK_SHIFT];
    ret opt[*T].some{?chunk[index & CHUNK_MASK]};
}

# the element at `index`, which the store handed out and so lies before its end; any
# other index is a broken precondition of the caller, and it stops the compiler
pub fun chunk_get[T](s: *StableChunks[T], index: usize) *T {
    if (index >= s.len) { panic("handle: chunk read past the end of its store\n"); }
    val chunk: *T = s.chunks.data[index >> CHUNK_SHIFT];
    ret ?chunk[index & CHUNK_MASK];
}

# open the store's one exclusive editor
# ---
# s:   the store
# ret: the editor, or absent for a nil store and busy when an editor is already open
pub fun chunk_editor[T](s: *StableChunks[T]) res[ChunkEditor[T], Error] {
    if (s == nil)  { ret res[ChunkEditor[T], Error].err{Error.absent{}}; }
    if (s.editing) { ret res[ChunkEditor[T], Error].err{Error.busy{}}; }
    if (s.lent) {
        val err_owned: err[Error] = chunk_own[T](s);
        if (sel err_owned.err) { ret res[ChunkEditor[T], Error].err{err_owned.err}; }
    }
    s.editing = true;
    var e: ChunkEditor[T];
    e.store = s;
    ret res[ChunkEditor[T], Error].ok{e};
}

# end an edit of a store; an editor that opened no store ends nothing
pub fun chunk_editor_finish[T](e: *ChunkEditor[T]) {
    if (e == nil || e.store == nil) { ret; }
    e.store.editing = false;
    e.store         = nil;
}

fun chunk_grow_one[T](s: *StableChunks[T]) err[Error] {
    val res_alloc: res[*T, A.Error] = A.zallocate[T](s.a, CHUNK_CAPACITY);
    if (sel res_alloc.err) { ret err[Error].err{Error.alloc{res_alloc.err}}; }
    val new_chunk: *T = res_alloc.ok;

    val res_push: res[usize, A.Error] = collections_vector.push[*T](?s.chunks, new_chunk);
    if (sel res_push.err) {
        A.deallocate[T](s.a, new_chunk, CHUNK_CAPACITY);
        ret err[Error].err{Error.alloc{res_push.err}};
    }
    ret err[Error].ok{};
}

# make room for `additional` more elements, so the appends that fill it cannot allocate
# ---
# e:          an open editor
# additional: how many elements to make room for
# ret:        absent for an editor that opened no store, or the allocator's refusal, which
#             releases the chunks this call added
pub fun chunk_grow[T](e: *ChunkEditor[T], additional: usize) err[Error] {
    if (e == nil || e.store == nil) { ret err[Error].err{Error.absent{}}; }
    val s: *StableChunks[T] = e.store;

    val needed:   usize = s.len + additional;
    var capacity: usize = s.chunks.len * CHUNK_CAPACITY;
    var grown:    usize = 0;

    for (capacity < needed) {
        val err_grow: err[Error] = chunk_grow_one[T](s);
        if (sel err_grow.err) {
            var u: usize = 0;
            for (u < grown) {
                val opt_popped: opt[*T] = collections_vector.pop[*T](?s.chunks);
                if (sel opt_popped.some) {
                    A.deallocate[T](s.a, opt_popped.some, CHUNK_CAPACITY);
                }
                u = u + 1;
            }
            ret err_grow;
        }
        grown    = grown + 1;
        capacity = capacity + CHUNK_CAPACITY;
    }

    ret err[Error].ok{};
}

# append `value`, growing by one chunk when the store is full
# ---
# e:     an open editor
# value: the element
# ret:   where the element now lives, stable until the store is released, or absent for an
#        editor that opened no store, or the allocator's refusal
pub fun chunk_append[T](e: *ChunkEditor[T], value: T) res[*T, Error] {
    if (e == nil || e.store == nil) { ret res[*T, Error].err{Error.absent{}}; }
    val s:        *StableChunks[T] = e.store;
    val capacity: usize            = s.chunks.len * CHUNK_CAPACITY;

    if (s.len == capacity) {
        val err_grow: err[Error] = chunk_grow_one[T](s);
        if (sel err_grow.err) { ret res[*T, Error].err{err_grow.err}; }
    }

    val offset: usize = s.len & CHUNK_MASK;
    val chunk:  *T    = s.chunks.data[s.len >> CHUNK_SHIFT];
    chunk[offset] = value;
    s.len         = s.len + 1;
    ret res[*T, Error].ok{?chunk[offset]};
}
