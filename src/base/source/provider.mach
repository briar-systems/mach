# the contract a module load reads source through: which names are modules and their text
#
# a provider answers where a module would be read from, whether it exists, its text, and which
# package ids it holds. a member answers a name it does not hold by saying so, never by failing,
# so one provider can stand in front of another, as the editor's overlay stands in front of the
# disk.

use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use mach.base.fail;
use mach.base.intern;

# the package that owns a module and the file it is read from inside that package
# ---
# file:    the module's file relative to its package, `/`-separated on every host, what
#          `$mach.source.file` reads
# package: the owning package's id, what `$mach.project.id` reads
# version: the owning package's version
# root:    the package being built owns it, not one of its dependencies
# warned:  the build shows the owning package's warnings
pub rec Home {
    file:    intern.StrId;
    package: intern.StrId;
    version: intern.StrId;
    root:    bool;
    warned:  bool;
}

# where a module's text is read from
# ---
# path: how the source map names the module's file, owned by the caller of `module_locate`
# home: the package that owns it
pub rec Origin {
    path: str;
    home: Home;
}

# a module's text: borrowed from the provider, or owned by the reader when `owned`
pub rec Text {
    data:  str;
    owned: bool;
}

# the module namespace a load reads: which names are modules, where each is read from, and
# which package ids it holds. every member answers for names it does not hold by
# saying so, never by failing, so a provider can stand in front of another one
# ---
# ctx:     the member's own state
# locate:  where the module an fqn names would be read from, none when no package owns the
#          fqn's head segment; it does not say the module exists
# exists:  whether the fqn names a module, spelled exactly as the provider holds it
# read:    the text at a path `locate` gave
# site:    the path `locate` would give for an fqn spelled out, none when no package owns its head
#          segment. it checks nothing and records nothing, so the owner may ask it ahead of a load
# peek:    the text `read` would give at a path, none where `read` would refuse. it reports and
#          records nothing and reads only the file system and what the provider holds unchanged,
#          so it may run on any thread
# package: whether a package has the id
pub rec Provider {
    ctx:     ptr;
    locate:  fun(ptr, *A.Allocator, intern.StrId) res[opt[Origin], fail.Fail];
    exists:  fun(ptr, *A.Allocator, intern.StrId) res[bool, fail.Fail];
    read:    fun(ptr, *A.Allocator, str) res[Text, fail.Fail];
    site:    fun(ptr, *A.Allocator, str) res[opt[str], fail.Fail];
    peek:    fun(ptr, *A.Allocator, str) opt[Text];
    package: fun(ptr, intern.StrId) bool;
}

pub fun module_locate(p: *Provider, a: *A.Allocator, fqn: intern.StrId) res[opt[Origin], fail.Fail] {
    ret p.locate(p.ctx, a, fqn);
}

pub fun module_exists(p: *Provider, a: *A.Allocator, fqn: intern.StrId) res[bool, fail.Fail] {
    ret p.exists(p.ctx, a, fqn);
}

pub fun module_read(p: *Provider, a: *A.Allocator, path: str) res[Text, fail.Fail] {
    ret p.read(p.ctx, a, path);
}

pub fun module_site(p: *Provider, a: *A.Allocator, fqn: str) res[opt[str], fail.Fail] {
    ret p.site(p.ctx, a, fqn);
}

pub fun module_peek(p: *Provider, a: *A.Allocator, path: str) opt[Text] {
    ret p.peek(p.ctx, a, path);
}

pub fun package_known(p: *Provider, id: intern.StrId) bool {
    ret p.package(p.ctx, id);
}

pub fun origin_dnit(a: *A.Allocator, o: *Origin) {
    if (o.path != nil) { str_free(a, o.path); }
    o.path = nil;
}

pub fun text_dnit(a: *A.Allocator, t: *Text) {
    if (t.owned && t.data != nil) { str_free(a, t.data); }
    t.data  = nil;
    t.owned = false;
}
