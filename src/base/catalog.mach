# the refusal of a catalog member that no arm of a dispatch names
#
# a dispatch over a finite catalog never answers an unknown member with a default. it refuses
# through one of these, and the class says where the fault lies: a declared member a target,
# format or phase cannot honor is unsupported and the user's, and a member the compiler produced
# that its own catalog lacks is internal.

use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;

use A:          std.allocator;
use std_format: std.format;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;

# closed catalogs. a dispatch over a finite catalog that reaches a member no
# arm names rejects through one of these, so one message shape names the
# catalog and the member and one class says where the fault lies: the member
# is valid but the target or phase declares it cannot honor it, or the
# compiler produced a member its own catalog lacks. no site answers an unknown
# member with a default.
rec Member {
    catalog: str;
    tag:     u32;
    where:   str;
}

rec Unsupported {
    catalog: str;
    member:  str;
    by:      str;
}

pub tag Catalog: u8 {
    unsupported: Unsupported;
    internal:    Member;
}

# a declared member that `by` (a target, format or phase) does not honor
pub fun unsupported_member(catalog: str, member: str, by: str) Catalog {
    ret Catalog.unsupported{Unsupported{catalog: catalog, member: member, by: by}};
}

# a member the compiler produced that its own catalog does not declare
pub fun unknown_member(catalog: str, tag: u32) Catalog {
    ret Catalog.internal{Member{catalog: catalog, tag: tag, where: ""}};
}

# the same, named with the site that produced it
pub fun unknown_member_in(catalog: str, tag: u32, where: str) Catalog {
    ret Catalog.internal{Member{catalog: catalog, tag: tag, where: where}};
}

fun member_text(a: *A.Allocator, lead: str, m: Member) res[str, std_format.FormatError] {
    if (str_len(m.where) == 0) { ret std_format.sprint(a, "{} {} tag {}", lead, m.catalog, m.tag); }
    ret std_format.sprint(a, "{} {} tag {} in {}", lead, m.catalog, m.tag, m.where);
}

# the message, owned by the caller's allocator (extent str_len + 1, released
# with str_free); the only failure a literal format can meet is the allocator's
pub fun catalog_text(a: *A.Allocator, c: Catalog) res[str, std_format.FormatError] {
    if (sel c.unsupported) {
        if (str_len(c.unsupported.by) == 0) { ret std_format.sprint(a, "{} {} is not available", c.unsupported.catalog, c.unsupported.member); }
        ret std_format.sprint(a, "{} {} is not available on {}", c.unsupported.catalog, c.unsupported.member, c.unsupported.by);
    }
    ret member_text(a, "unknown", c.internal);
}

# the message, owned by the interner so it outlives temporary phase storage,
# with `a` as scratch
pub fun catalog_interned(itn: *intern.Interner, a: *A.Allocator, c: Catalog) res[str, fail.Fail] {
    val res_formatted: res[str, std_format.FormatError] = catalog_text(a, c);
    if (sel res_formatted.err) { ret res[str, fail.Fail].err{fail.format_refused(res_formatted.err)}; }
    ret diagnostic.text_intern(itn, a, res_formatted.ok);
}

# the closed-catalog policy as a failure: a capability fault is the user's, a
# compiler-produced member is internal. the failure owns the message through
# the caller's allocator
pub fun catalog(a: *A.Allocator, c: Catalog) fail.Fail {
    val res_formatted: res[str, std_format.FormatError] = catalog_text(a, c);
    if (sel res_formatted.err) { ret fail.format_refused(res_formatted.err); }
    if (sel c.unsupported)     { ret fail.owning(fail.user(diagnostic_kind.CATALOG_UNSUPPORTED, res_formatted.ok)); }
    ret fail.owning(fail.message(res_formatted.ok));
}

pub fun unknown_catalog(a: *A.Allocator, catalog_name: str, tag: u32) fail.Fail {
    ret catalog(a, unknown_member(catalog_name, tag));
}
