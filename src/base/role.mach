# which side of a build the calling thread works on, the owner or a worker, and a check that a
# worker leaves the build's shared stores alone. the check is compiled in only when CHECKED is set:
# each store's write path calls touched, which counts a touch made on the worker side, and report
# prints the counts when a build ends. a store may also be frozen for a while, when no thread may
# write it, the owner's included, and a touch of it is counted apart. a normal build compiles
# neither the role nor the counts

use fs:         std.filesystem;
use std_format: std.format;
use std.io.writer;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

# whether the shared-store check is compiled in
pub val CHECKED: bool = false;

# the stores the check watches, each an index into the counts
pub val INTERN_ADD:  usize = 0;
pub val INTERN_FIND: usize = 1;
pub val TYPE_ADD:    usize = 2;
pub val TYPE_MEMO:   usize = 3;
pub val TYPE_SCAN:   usize = 4;
pub val TYPE_FACTS:  usize = 5;
pub val QUERY:       usize = 6;
pub val DIAGNOSTIC:  usize = 7;
pub val DEMAND:      usize = 8;
pub val IDENTITY:    usize = 9;
pub val LINKAGE:     usize = 10;
pub val EMBED:       usize = 11;
pub val SOURCES:     usize = 12;
pub val MODULES:     usize = 13;
val     STORES:      usize = 14;

val NAMES: [STORES]str = [STORES]str{"interner add", "interner find", "type table add", "type table memo", "type table scan", "type facts", "query db", "diagnostic store", "instance registry", "identity", "linkage", "embed cache", "source map", "module registry"};

#[thread]
var worker_side: bool;

# the most stores a worker may own, or the owner may freeze, at once
pub val OWNED: usize = 8;

# the stores of its own a worker was given, which it may write
#[thread]
var owned: [OWNED]ptr;

# the stores no thread may write while they are frozen
var frozen: [OWNED]ptr;

var counts:        [STORES]i64;
var frozen_counts: [STORES]i64;

# the calling thread starts working on the worker side
pub fun enter() {
    worker_side = true;
}

# the calling thread stops working on the worker side
pub fun leave() {
    worker_side = false;
}

# whether the calling thread works on the worker side
pub fun worker() bool {
    ret worker_side;
}

# the calling worker owns the `count` stores at `stores` until it names others, none for nil
pub fun permit(stores: *ptr, count: usize) {
    var i: usize = 0;
    for (i < OWNED) {
        owned[i] = nil;
        if (i < count) { owned[i] = stores[i]; }
        i = i + 1;
    }
}

# the `count` stores at `stores` frozen until others are named, none for nil. called by the owner
# while no worker runs
pub fun freeze(stores: *ptr, count: usize) {
    var i: usize = 0;
    for (i < OWNED) {
        frozen[i] = nil;
        if (i < count) { frozen[i] = stores[i]; }
        i = i + 1;
    }
}

fun held(list: *ptr, at: ptr) bool {
    var i: usize = 0;
    for (i < OWNED) {
        if (list[i] == at) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the store `store` at `at` was touched; counted when the calling thread works on the worker side
# and does not own it, and counted apart when it is frozen. `at` is nil for a store only ever shared
pub fun touched(store: usize, at: ptr) {
    if (at != nil && held(?frozen[0], at))                  { atomic.fetch_add(?frozen_counts[store], 1); }
    if (worker_side && (at == nil || !held(?owned[0], at))) { counted(store); }
}

fun counted(store: usize) {
    atomic.fetch_add(?counts[store], 1);
}

# every store a worker touched and how often, on stderr
pub fun report() {
    var w: writer.Writer = fs.writer(fs.STDERR);
    var i: usize         = 0;
    for (i < STORES) {
        val n: i64 = atomic.load(?counts[i]);
        if (n != 0) { std_format.format(?w, "role: worker touched {} {} times\n", NAMES[i], n); }
        val f: i64 = atomic.load(?frozen_counts[i]);
        if (f != 0) { std_format.format(?w, "role: frozen {} touched {} times\n", NAMES[i], f); }
        i = i + 1;
    }
}
