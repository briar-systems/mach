# the build steps a manifest declares: each step's inputs are collected, its
# invocation expanded, its outputs staged and published, and its stamp kept, so
# a step runs again only when what it reads changed. the build engine runs a
# project's own steps and its dependencies' steps as phases of a unit

use crypto.hash.sha256;
use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.duration;
use mach.base.fail;
use base_fingerprint: mach.base.fingerprint;
use mach.base.intern;
use base_source: mach.base.source;
use mach.base.wire;
use step_glob:       mach.build.step.glob;
use step_walk:       mach.build.step.walk;
use compile_closure: mach.compile.closure;
use mach.compile.config;
use compile_load: mach.compile.load;
use mach.compile.project;
use mach.host;
use host_environment: mach.host.environment;
use mach.host.interrupt;
use mach.host.listing;
use mach.host.output;
use mach.host.output.layout;
use mach.host.subprocess;
use manifest_model:  mach.manifest.model;
use manifest_plan:   mach.manifest.plan;
use manifest_schema: mach.manifest.schema;
use mach.manifest.template;
use mach.report.readout;
use A:               std.allocator;
use chrono_duration: std.chrono.duration;
use std.chrono.time;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use encoding_hex: std.encoding.hex;
use fs:           std.filesystem;
use io_error:     std.io.error;
use std.process.env;
use std.process.exec;
use std.runtime.native.view.Unit;
use sync_cancel: std.sync.cancel;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_contains_char;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

fun collect_step_inputs(alloc: *A.Allocator, p: *project.Project, step: *manifest_model.StepDef, execution_root: str, output_root: str, out: *collections_vector.Vector[str]) err[fail.Fail] {
    var v: template.Values = compile_closure.cell_tmpl_vars(p);
    var i: u32             = 0;
    for (i < step.in_count) {
        val raw:                   str                      = intern.text(p.s.interner, step.in[i]);
        val res_resolve_step_path: res[StepPath, fail.Fail] = resolve_step_path(alloc, raw, output_root, ?v, execution_root, output_root, "a build step input", true);
        if (sel res_resolve_step_path.err) { ret err[fail.Fail].err{fail.at(res_resolve_step_path.err, manifest_model.site_of(step.in_at, i))}; }
        var sp: StepPath = res_resolve_step_path.ok;
        fin { step_path_dnit(alloc, ?sp); }
        if (!str_contains_char(sp.rel, '*')) {
            val err_physical: err[fail.Fail] = step_walk.path_check(alloc, sp.root, sp.rel, step_walk.PHYSICAL_REGULAR, "build step input");
            if (sel err_physical.err) { ret err_physical; }
            val res_out_pushed: res[usize, A.Error] = collections_vector.push[str](out, sp.abs);
            if (sel res_out_pushed.err) { ret err[fail.Fail].err{fail.refused(res_out_pushed.err)}; }
            sp.abs = nil;
        }
        or {
            if (!step_glob.shape_ok(sp.rel)) {
                val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_SHAPE, "mach.toml: step input glob '{}' is not allowed. a wildcard may appear only in the last path segment, with an optional '**' directory segment, as in 'dir/*.c' or 'dir/**/*.c'", sp.rel);
                ret err[fail.Fail].err{msg};
            }
            val before:     usize          = out.len;
            val err_expand: err[fail.Fail] = step_glob.expand(alloc, sp.root, sp.rel, out);
            if (sel err_expand.err) { ret err_expand; }
            if (out.len == before) {
                val msg: fail.Fail = fail.formatted_user(alloc, diagnostic_kind.GLOB_NO_MATCH, "mach.toml: step input glob '{}' matched no files", sp.rel);
                ret err[fail.Fail].err{msg};
            }
            var gi: usize = before;
            for (gi < out.len) {
                val res_abs: res[str, A.Error] = types_path.resolve(alloc, sp.root, out.data[gi]);
                if (sel res_abs.err) { ret err[fail.Fail].err{fail.refused(res_abs.err)}; }
                str_free(alloc, out.data[gi]);
                out.data[gi] = res_abs.ok;
                gi           = gi + 1;
            }
        }
        i = i + 1;
    }
    sort.sort[str](out.data, out.len);
    ret err[fail.Fail].ok{};
}

fun step_inputs_dnit(alloc: *A.Allocator, ins: *collections_vector.Vector[str]) {
    var i: usize = 0;
    for (i < ins.len) {
        str_free(alloc, ins.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[str](ins);
}

rec StepStrings {
    items: **u8;
    count: u32;
}

# a step's expanded command: what the child receives, and of its environment the
# entries the step declares, which alone key it
# ---
# argv:  the expanded arguments
# env:   the whole environment the child receives
# keyed: the entries `env` declares, the target variables and the inherited
#        variables `env_in` names, as the child receives them
rec StepInvocation {
    argv:  StepStrings;
    env:   host_environment.Strings;
    keyed: host_environment.Strings;
}

# the child's environment and the declared projection of it that keys the step
rec StepEnvironment {
    env:   host_environment.Strings;
    keyed: host_environment.Strings;
}

rec StepPath {
    root: str;
    rel:  str;
    abs:  str;
}

fun step_path_dnit(a: *A.Allocator, path: *StepPath) {
    str_free(a, path.rel);
    str_free(a, path.abs);
    # nil, not "": str_free no-ops on nil and would hand a static empty literal
    # to the allocator, so an empty reset makes a second free an invalid free
    path.rel = nil;
    path.abs = nil;
}

fun step_paths_dnit(a: *A.Allocator, paths: *Vector[StepPath]) {
    var i: usize = 0;
    for (i < paths.len) {
        step_path_dnit(a, ?paths.data[i]);
        i = i + 1;
    }
    collections_vector.dnit[StepPath](paths);
}

fun absolute_path_in_root(path: str, root: str, allow_root: bool) bool {
    if (!types_path.is_abs(path) || !types_path.is_abs(root)) { ret false; }
    if (str_equals(path, root))                               { ret allow_root; }
    val rn: usize = str_len(root);
    if (!str_starts_with(path, root) || str_len(path) <= rn) { ret false; }
    ret types_path.is_separator(path[rn]);
}

fun step_path_error(a: *A.Allocator, field: str) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.STEP_PATH_OUTSIDE, "mach.toml: {} must expand to a canonical path under the step's execution root, or start with '{{project.work}}/' and stay under the output root", field);
}

fun resolve_step_path(a: *A.Allocator, raw: str, project_work: str, v: *template.Values,
    execution_root: str, output_root: str, field: str,
    allow_output_root: bool) res[StepPath, fail.Fail] {
    var empty:        StepPath            = StepPath{root: "", rel: "", abs: ""};
    val res_expanded: res[str, fail.Fail] = template.expand(a, raw, template.CONTEXT_PATH, project_work, v);
    if (sel res_expanded.err) { ret res[StepPath, fail.Fail].err{res_expanded.err}; }
    val expanded:      str  = res_expanded.ok;
    var expanded_kept: bool = false;
    fin {
        if (!expanded_kept) { str_free(a, expanded); }
    }
    val marker:          str  = "{project.work}";
    val absolute_output: bool = types_path.is_abs(project_work) && str_contains(raw, marker);
    if (!absolute_output && manifest_schema.is_project_path(expanded)) {
        val res_abs: res[str, A.Error] = types_path.resolve(a, execution_root, expanded);
        if (sel res_abs.err) { ret res[StepPath, fail.Fail].err{fail.refused(res_abs.err)}; }
        expanded_kept = true;
        ret res[StepPath, fail.Fail].ok{StepPath{root: execution_root, rel: expanded, abs: res_abs.ok}};
    }

    val mn: usize = str_len(marker);
    val rn: usize = str_len(raw);
    if (!types_path.is_abs(expanded) || !str_starts_with(raw, marker)
        || (rn != mn && (rn <= mn || raw[mn] != '/'::u8))) {
        ret res[StepPath, fail.Fail].err{step_path_error(a, field)};
    }

    var handed: bool = false;
    var rel:    str  = nil;
    fin {
        if (!handed) { str_free(a, rel); }
    }
    if (rn == mn) {
        if (!allow_output_root) { ret res[StepPath, fail.Fail].err{step_path_error(a, field)}; }
        val res_rel: res[str, A.Error] = str_dup(a, ".");
        if (sel res_rel.err) { ret res[StepPath, fail.Fail].err{fail.refused(res_rel.err)}; }
        rel = res_rel.ok;
    }
    or {
        val suffix:  str                 = ?raw[mn + 1];
        val res_rel: res[str, fail.Fail] = template.path_expand(a, suffix, template.CONTEXT_PATH, "", v, field);
        if (sel res_rel.err) { ret res[StepPath, fail.Fail].err{res_rel.err}; }
        rel = res_rel.ok;
    }

    val res_joined: res[str, A.Error] = types_path.resolve(a, output_root, rel);
    if (sel res_joined.err) { ret res[StepPath, fail.Fail].err{fail.refused(res_joined.err)}; }
    val joined:    str               = res_joined.ok;
    val res_clean: res[str, A.Error] = types_path.clean(a, joined);
    str_free(a, joined);
    if (sel res_clean.err) { ret res[StepPath, fail.Fail].err{fail.refused(res_clean.err)}; }
    val clean: str = res_clean.ok;
    fin {
        if (!handed) { str_free(a, clean); }
    }
    val res_clean_root: res[str, A.Error] = types_path.clean(a, output_root);
    if (sel res_clean_root.err) { ret res[StepPath, fail.Fail].err{fail.refused(res_clean_root.err)}; }
    val clean_root: str = res_clean_root.ok;
    fin { str_free(a, clean_root); }
    if (!absolute_path_in_root(clean, clean_root, allow_output_root)) { ret res[StepPath, fail.Fail].err{step_path_error(a, field)}; }
    empty  = StepPath{root: output_root, rel: rel, abs: clean};
    handed = true;
    ret res[StepPath, fail.Fail].ok{empty};
}

# release a list of strings; an empty list owns nothing
fun step_strings_dnit(a: *A.Allocator, values: *StepStrings) {
    if (values.items == nil) { ret; }
    var i: u32 = 0;
    for (i < values.count) {
        str_free(a, values.items[i]::str);
        i = i + 1;
    }
    A.deallocate[*u8](a, values.items, values.count::usize + 1);
    values.items = nil;
    values.count = 0;
}

# expand each of the `count` values at `ids`, written at `sites`; a refusal points at the value
fun expand_step_strings(a: *A.Allocator, p: *project.Project, ids: *intern.StrId, sites: *base_source.Location,
    count: u32, project_work: str, v: *template.Values) res[StepStrings, fail.Fail] {
    var out: StepStrings;
    out.items = nil;
    out.count = 0;
    if (count == 0) { ret res[StepStrings, fail.Fail].ok{out}; }

    val res_allocate: res[**u8, A.Error] = A.allocate[*u8](a, count::usize + 1);
    if (sel res_allocate.err) { ret res[StepStrings, fail.Fail].err{fail.refused(res_allocate.err)}; }
    out.items = res_allocate.ok;
    out.count = count;
    var cleared: usize = 0;
    for (cleared <= count::usize) {
        out.items[cleared] = nil;
        cleared            = cleared + 1;
    }
    var i: u32 = 0;
    for (i < count) {
        val res_expand: res[str, fail.Fail] = template.expand(a, intern.text(p.s.interner, ids[i]), template.CONTEXT_STEP_VALUE, project_work, v);
        if (sel res_expand.err) {
            step_strings_dnit(a, ?out);
            ret res[StepStrings, fail.Fail].err{fail.at(res_expand.err, manifest_model.site_of(sites, i))};
        }
        out.items[i] = res_expand.ok::*u8;
        i            = i + 1;
    }
    out.items[count] = nil;
    out.count        = count;
    ret res[StepStrings, fail.Fail].ok{out};
}

fun expand_step_invocation(a: *A.Allocator, p: *project.Project, step: *manifest_model.StepDef,
    project_work: str, v: *template.Values) res[StepInvocation, fail.Fail] {
    var invocation: StepInvocation;
    invocation.argv  = StepStrings{items: nil, count: 0};
    invocation.env   = host_environment.Strings{items: nil, count: 0};
    invocation.keyed = host_environment.Strings{items: nil, count: 0};

    val res_argv: res[StepStrings, fail.Fail] = expand_step_strings(a, p, step.argv, step.argv_at, step.argv_count, project_work, v);
    if (sel res_argv.err) { ret res[StepInvocation, fail.Fail].err{res_argv.err}; }
    invocation.argv = res_argv.ok;
    var handed: bool = false;
    fin {
        if (!handed) { step_strings_dnit(a, ?invocation.argv); }
    }
    if (invocation.argv.count == 0 || str_is_empty(invocation.argv.items[0]::str)) {
        ret res[StepInvocation, fail.Fail].err{fail.user(diagnostic_kind.STEP_ARGV_EMPTY, "mach.toml: expanded build step argv[0] must name an executable")};
    }

    val res_environment: res[StepEnvironment, fail.Fail] = expand_step_environment(a, p, step, project_work, v, exec.Environment.inherit{});
    if (sel res_environment.err) { ret res[StepInvocation, fail.Fail].err{res_environment.err}; }
    invocation.env   = res_environment.ok.env;
    invocation.keyed = res_environment.ok.keyed;
    handed           = true;
    ret res[StepInvocation, fail.Fail].ok{invocation};
}

fun expand_step_environment(a: *A.Allocator, p: *project.Project, step: *manifest_model.StepDef,
    project_work: str, v: *template.Values, inherited: exec.Environment) res[StepEnvironment, fail.Fail] {
    val res_captured: res[host_environment.Environment, fail.Fail] = host_environment.capture(a, inherited);
    if (sel res_captured.err) { ret res[StepEnvironment, fail.Fail].err{res_captured.err}; }
    var environment: host_environment.Environment = res_captured.ok;
    fin { host_environment.dnit(?environment); }
    var i: u32 = 0;
    for (i < step.env_count) {
        val key:          str                  = intern.text(p.s.interner, step.env_keys[i]);
        val res_reserved: res[bool, fail.Fail] = is_target_env_key(a, key);
        if (sel res_reserved.err) { ret res[StepEnvironment, fail.Fail].err{res_reserved.err}; }
        if (res_reserved.ok) {
            i = i + 1;
            cnt;
        }
        val res_value: res[str, fail.Fail] = template.expand(a, intern.text(p.s.interner, step.env_values[i]), template.CONTEXT_STEP_VALUE, project_work, v);
        if (sel res_value.err) { ret res[StepEnvironment, fail.Fail].err{fail.at(res_value.err, manifest_model.site_of(step.env_at, i))}; }
        val value:     str            = res_value.ok;
        val err_added: err[fail.Fail] = host_environment.put(?environment, key, value, true);
        str_free(a, value);
        if (sel err_added.err) { ret res[StepEnvironment, fail.Fail].err{err_added.err}; }
        i = i + 1;
    }
    var ti: usize = 0;
    for (ti < TARGET_ENV_N) {
        val err_added: err[fail.Fail] = host_environment.put(?environment, TARGET_ENV_KEYS[ti], target_env_value(v, ti), true);
        if (sel err_added.err) { ret res[StepEnvironment, fail.Fail].err{err_added.err}; }
        ti = ti + 1;
    }

    var keyed: host_environment.Environment = host_environment.init(a);
    fin { host_environment.dnit(?keyed); }
    i = 0;
    for (i < step.env_count) {
        val err_kept: err[fail.Fail] = keep_entry(?environment, ?keyed, intern.text(p.s.interner, step.env_keys[i]));
        if (sel err_kept.err) { ret res[StepEnvironment, fail.Fail].err{err_kept.err}; }
        i = i + 1;
    }
    ti = 0;
    for (ti < TARGET_ENV_N) {
        val err_kept: err[fail.Fail] = keep_entry(?environment, ?keyed, TARGET_ENV_KEYS[ti]);
        if (sel err_kept.err) { ret res[StepEnvironment, fail.Fail].err{err_kept.err}; }
        ti = ti + 1;
    }
    i = 0;
    for (i < step.env_in_count) {
        val err_kept: err[fail.Fail] = keep_entry(?environment, ?keyed, intern.text(p.s.interner, step.env_in[i]));
        if (sel err_kept.err) { ret res[StepEnvironment, fail.Fail].err{err_kept.err}; }
        i = i + 1;
    }

    val res_env: res[host_environment.Strings, fail.Fail] = host_environment.to_strings(?environment);
    if (sel res_env.err) { ret res[StepEnvironment, fail.Fail].err{res_env.err}; }
    var child:     host_environment.Strings                 = res_env.ok;
    val res_keyed: res[host_environment.Strings, fail.Fail] = host_environment.to_strings(?keyed);
    if (sel res_keyed.err) {
        host_environment.strings_dnit(a, ?child);
        ret res[StepEnvironment, fail.Fail].err{res_keyed.err};
    }
    ret res[StepEnvironment, fail.Fail].ok{StepEnvironment{env: child, keyed: res_keyed.ok}};
}

# copy the entry named `name` from `from` into `into`; a name `from` does not hold
# is left out, so an unset variable keys differently from an empty one
fun keep_entry(from: *host_environment.Environment, into: *host_environment.Environment, name: str) err[fail.Fail] {
    val res_found: res[opt[usize], fail.Fail] = host_environment.find(from, name);
    if (sel res_found.err) { ret err[fail.Fail].err{res_found.err}; }
    val opt_found: opt[usize] = res_found.ok;
    if (sel opt_found.none) { ret err[fail.Fail].ok{}; }
    val res_copy: res[host_environment.Entry, fail.Fail] = host_environment.entry_native(into.entries.a, from.entries.data[opt_found.some].units);
    if (sel res_copy.err) { ret err[fail.Fail].err{res_copy.err}; }
    ret host_environment.put_owned(into, res_copy.ok, false);
}

val TARGET_ENV_N:    usize             = 3;
val TARGET_ENV_KEYS: [TARGET_ENV_N]str = [TARGET_ENV_N]str{
    "MACH_TARGET_ARCH",
    "MACH_TARGET_SYS",
    "MACH_TARGET_ABI",
};

fun target_env_value(v: *template.Values, idx: usize) str {
    if (idx == 0) { ret v.arch; }
    if (idx == 1) { ret v.sys; }
    ret v.abi;
}

fun is_target_env_key(a: *A.Allocator, key: str) res[bool, fail.Fail] {
    var i: usize = 0;
    for (i < TARGET_ENV_N) {
        val res_order: res[i32, env.EnvError] = env.compare_names(key, TARGET_ENV_KEYS[i]);
        if (sel res_order.err) { ret res[bool, fail.Fail].err{fail.refusal(a, diagnostic_kind.STEP_ENVIRONMENT, fail.Op{verb: "compare", role: "the environment variable name", path: key, given: true}, fail.Cause.env{res_order.err})}; }
        if (res_order.ok == 0) { ret res[bool, fail.Fail].ok{true}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun step_invocation_dnit(a: *A.Allocator, invocation: *StepInvocation) {
    step_strings_dnit(a, ?invocation.argv);
    host_environment.strings_dnit(a, ?invocation.env);
    host_environment.strings_dnit(a, ?invocation.keyed);
}

fun collect_step_outputs(a: *A.Allocator, p: *project.Project, step: *manifest_model.StepDef, execution_root: str, output_root: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    var v:  template.Values = compile_closure.cell_tmpl_vars(p);
    var oi: u32             = 0;
    for (oi < step.out_count) {
        val res_resolve_step_path: res[StepPath, fail.Fail] = resolve_step_path(a, intern.text(p.s.interner, step.out[oi]), output_root, ?v, execution_root, output_root, "a build step output", false);
        if (sel res_resolve_step_path.err) { ret err[fail.Fail].err{fail.at(res_resolve_step_path.err, manifest_model.site_of(step.out_at, oi))}; }
        val sp:       StepPath            = res_resolve_step_path.ok;
        val res_push: res[usize, A.Error] = collections_vector.push[StepPath](outputs, sp);
        if (sel res_push.err) {
            var lost: StepPath = sp;
            step_path_dnit(a, ?lost);
            ret err[fail.Fail].err{fail.refused(res_push.err)};
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_make_output_dirs(a: *A.Allocator, outputs: *Vector[StepPath]) err[fail.Fail] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp:      *StepPath         = ?outputs.data[oi];
        val res_dir: res[str, A.Error] = types_path.parent(a, sp.rel);
        if (sel res_dir.err) { ret err[fail.Fail].err{fail.refused(res_dir.err)}; }
        val rel_dir:  str            = res_dir.ok;
        val err_make: err[fail.Fail] = step_walk.directory_ensure(a, sp.root, rel_dir, "build step output directory");
        str_free(a, rel_dir);
        if (sel err_make.err) { ret err[fail.Fail].err{err_make.err}; }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_step_program(a: *A.Allocator, execution_root: str, invocation: *StepInvocation) res[str, fail.Fail] {
    val name: str = invocation.argv.items[0]::str;
    if (types_path.has_separator(name)) {
        val res_resolve: res[types_path.Path, A.Error] = types_path.resolve(a, execution_root, name);
        if (sel res_resolve.err) { ret res[str, fail.Fail].err{fail.refused(res_resolve.err)}; }
        ret res[str, fail.Fail].ok{res_resolve.ok};
    }
    val res_program_resolve: res[str, fail.Fail] = host.program_resolve(a, name);
    if (sel res_program_resolve.err) {
        ret res[str, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_EXECUTABLE_NOT_FOUND, "mach.toml: build step executable '{}' was not found on the planner PATH", name)};
    }
    val found: str = res_program_resolve.ok;
    if (types_path.is_abs(found)) { ret res[str, fail.Fail].ok{found}; }
    fin { str_free(a, found); }
    val res_cwd: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { ret res[str, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, CWD_OP, fail.Cause.env{res_cwd.err})}; }
    var cwd:     types_string.OwnedString = res_cwd.ok;
    val res_abs: res[str, A.Error]        = types_path.resolve(a, cwd.data, found);
    types_string.owned_dnit(?cwd);
    if (sel res_abs.err) { ret res[str, fail.Fail].err{fail.refused(res_abs.err)}; }
    ret res[str, fail.Fail].ok{res_abs.ok};
}

val STEP_ROLE: str = "the build step executable";

val CWD_OP: fail.Op = fail.Op{verb: "read", role: "the working directory"};

fun execute_step_invocation(a: *A.Allocator, execution_root: str, program: str,
    invocation: *StepInvocation, step_name: str,
    timeout: chrono_duration.Duration) err[fail.Fail] {
    var child: subprocess.OwnedSubprocess;
    subprocess.init(?child);
    fin { subprocess.dnit(a, ?child); }
    var options: subprocess.SpawnOptions = subprocess.spawn_options();
    options.cwd     = execution_root;
    options.grouped = true;
    if (timeout > 0) {
        val err_bounded: err[subprocess.Error] = subprocess.bound(?child, timeout);
        if (sel err_bounded.err) { ret err[fail.Fail].err{subprocess.refusal_of(a, diagnostic_kind.STEP_SPAWN, fail.Op{verb: "set the timeout of", role: STEP_ROLE, path: program}, err_bounded.err)}; }
    }
    val err_spawn: err[subprocess.Error] = subprocess.spawn_native(a, ?child, program, invocation.argv.items,
        exec.NativeEnvironment.given{invocation.env.items}, options);
    if (sel err_spawn.err) {
        val op: fail.Op = fail.Op{verb: "run", role: STEP_ROLE, path: program, link: "in", other: execution_root, given: true};
        ret err[fail.Fail].err{subprocess.refusal_of(a, diagnostic_kind.STEP_SPAWN, op, err_spawn.err)};
    }

    var scope: sync_cancel.Scope;
    sync_cancel.make_root(?scope, opt[time.Instant].none{});
    val err_held: err[io_error.Error] = interrupt.hold();
    var held:     bool                = sel err_held.ok;

    val res_wait:     res[*subprocess.OwnedSubprocess, subprocess.Error] = subprocess.wait_any(a, ?child, 1, ?scope);
    var err_released: err[fail.Fail]                                     = err[fail.Fail].ok{};
    if (held) { err_released = interrupt_released(a); }
    # a root scope made here holds no child, registration or waiter once the wait returns, so destroy cannot refuse
    sync_cancel.dnit(?scope);
    val err_ended: err[fail.Fail] = step_ended(a, ?child, res_wait, program, step_name, timeout);
    if (sel err_released.err) {
        if (sel err_ended.err) { ret err[fail.Fail].err{fail.with_secondary(a, err_ended.err, err_released.err)}; }
        ret err_released;
    }
    ret err_ended;
}

# the step's hold on the interrupt released; a refusal is the step's failure, since the
# handlers may still be installed
fun interrupt_released(a: *A.Allocator) err[fail.Fail] {
    val err_closed: err[io_error.Error] = interrupt.release();
    if (sel err_closed.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.STEP_WAIT, fail.Op{verb: "restore", role: "the process event handlers"}, fail.Cause.io{err_closed.err})}; }
    ret err[fail.Fail].ok{};
}

# how a build step's executable ended, once `wait_r` answered for `child`
fun step_ended(a: *A.Allocator, child: *subprocess.OwnedSubprocess, wait_r: res[*subprocess.OwnedSubprocess, subprocess.Error],
    program: str, step_name: str, timeout: chrono_duration.Duration) err[fail.Fail] {
    if (sel wait_r.err) {
        val wait_err:   subprocess.Error                                     = wait_r.err;
        val res_cancel: res[subprocess.SubprocessTerminal, subprocess.Error] = subprocess.cancel(a, child, 0);
        val waited:     fail.Fail                                            = subprocess.refusal_of(a, diagnostic_kind.STEP_WAIT, fail.Op{verb: "wait for", role: STEP_ROLE, path: program}, wait_err);
        if (sel res_cancel.err) {
            ret err[fail.Fail].err{fail.with_secondary(a, waited, subprocess.refusal_of(a, diagnostic_kind.STEP_WAIT, fail.Op{verb: "stop", role: STEP_ROLE, path: program}, res_cancel.err))};
        }
        val res_reaped: res[str, fail.Fail] = diagnostic.join(a, fail.describe(waited), ". the process was cancelled and reaped");
        if (sel res_reaped.err) { ret err[fail.Fail].err{waited}; }
        ret err[fail.Fail].err{fail.with_text(waited, res_reaped.ok)};
    }
    if (subprocess.expired(child)) {
        val t:   duration.Text = duration.text(timeout);
        val msg: fail.Fail     = fail.formatted_user(a, diagnostic_kind.STEP_TIMEOUT, "build step '{}' exceeded its timeout of {}{} and its process group was terminated", step_name, t.n, t.unit);
        ret err[fail.Fail].err{msg};
    }
    val terminal: subprocess.SubprocessTerminal = child.terminal;
    if (terminal.kind == subprocess.STATE_EXITED) {
        if (terminal.code == 0) { ret err[fail.Fail].ok{}; }
        val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_EXIT, "build step exited with code {}", terminal.code);
        ret err[fail.Fail].err{msg};
    }
    if (terminal.kind == subprocess.STATE_SIGNALED) {
        val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_SIGNAL, "build step terminated by signal {}", terminal.code);
        ret err[fail.Fail].err{msg};
    }
    ret err[fail.Fail].err{fail.message("build step reached an invalid terminal state")};
}

rec TreeFile {
    path:   str;
    kind:   u8;
    sec:    i64;
    nsec:   i64;
    size:   usize;
    digest: [32]u8;
}

val TREE_FILE:      u8 = 1;
val TREE_DIRECTORY: u8 = 2;

val TREE_ROLE: str = "the build step snapshot entry";

fun collect_tree_files(a: *A.Allocator, dir: str, out: *collections_vector.Vector[TreeFile]) err[fail.Fail] {
    val res_is_symlink: res[bool, io_error.Error] = fs.is_symlink(dir);
    if ((sel res_is_symlink.ok && res_is_symlink.ok)) { ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_SNAPSHOT, "cannot snapshot symlink tree root '{}'", dir)}; }
    val res_exists: res[bool, io_error.Error] = fs.exists(dir);
    if (!(sel res_exists.ok && res_exists.ok)) { ret err[fail.Fail].ok{}; }
    val res_root_meta: res[fs.Metadata, io_error.Error] = fs.metadata_link(dir);
    if (sel res_root_meta.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: TREE_ROLE, path: dir}, fail.Cause.io{res_root_meta.err})}; }
    val root_meta: fs.Metadata = res_root_meta.ok;
    if (!fs.meta_is_dir(?root_meta)) { ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_SNAPSHOT, "cannot snapshot non-directory tree root '{}'", dir)}; }
    val res_root_path: res[str, A.Error] = types_path.clean(a, dir);
    if (sel res_root_path.err) { ret err[fail.Fail].err{fail.refused(res_root_path.err)}; }
    var root_entry: TreeFile;
    root_entry.path = res_root_path.ok;
    root_entry.kind = TREE_DIRECTORY;
    root_entry.sec  = 0;
    root_entry.nsec = 0;
    root_entry.size = 0;
    var root_digest_i: usize = 0;
    for (root_digest_i < 32) {
        root_entry.digest[root_digest_i] = 0;
        root_digest_i                    = root_digest_i + 1;
    }
    val res_root_push: res[usize, A.Error] = collections_vector.push[TreeFile](out, root_entry);
    if (sel res_root_push.err) {
        str_free(a, root_entry.path);
        ret err[fail.Fail].err{fail.refused(res_root_push.err)};
    }
    val res_listed: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(a, root_entry.path);
    if (sel res_listed.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "list", role: TREE_ROLE, path: root_entry.path}, fail.Cause.fs{res_listed.err})}; }
    var entries: Vector[fs.Listed] = res_listed.ok;
    fin { fs.listed_dnit(?entries); }
    val res_names: res[Vector[str], fail.Fail] = listing.names(a, root_entry.path, ?entries);
    if (sel res_names.err) { ret err[fail.Fail].err{res_names.err}; }
    var names: Vector[str] = res_names.ok;
    fin { collections_vector.dnit[str](?names); }
    sort.sort[str](names.data, names.len);

    var i: usize = 0;
    for (i < names.len) {
        val res_child: res[str, fail.Fail] = compile_load.join_path(a, root_entry.path, names.data[i]);
        if (sel res_child.err) { ret err[fail.Fail].err{res_child.err}; }
        val child: str  = res_child.ok;
        var kept:  bool = false;
        fin {
            if (!kept) { str_free(a, child); }
        }
        val res_metadata_link: res[fs.Metadata, io_error.Error] = fs.metadata_link(child);
        if (sel res_metadata_link.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: TREE_ROLE, path: child}, fail.Cause.io{res_metadata_link.err})}; }
        val fi: fs.Metadata = res_metadata_link.ok;
        if (fs.meta_is_dir(?fi)) {
            val err_child_walk: err[fail.Fail] = collect_tree_files(a, child, out);
            if (sel err_child_walk.err) { ret err_child_walk; }
        }
        or (fs.meta_is_file(?fi)) {
            var tf: TreeFile;
            tf.path = child;
            tf.kind = TREE_FILE;
            tf.sec  = fi.modified.sec;
            tf.nsec = fi.modified.nsec;
            tf.size = fi.size;
            val err_digest: err[fail.Cause] = base_fingerprint.file_sha256(child, ?tf.digest[0]);
            if (sel err_digest.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "digest", role: TREE_ROLE, path: child}, err_digest.err)}; }
            val res_out_pushed: res[usize, A.Error] = collections_vector.push[TreeFile](out, tf);
            if (sel res_out_pushed.err) { ret err[fail.Fail].err{fail.refused(res_out_pushed.err)}; }
            kept = true;
        }
        or {
            val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_SNAPSHOT, "cannot snapshot entry '{}', which is neither a file, a directory nor a symlink", child);
            ret err[fail.Fail].err{msg};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun tree_files_dnit(a: *A.Allocator, v: *Vector[TreeFile]) {
    var i: usize = 0;
    for (i < v.len) {
        str_free(a, v.data[i].path);
        i = i + 1;
    }
    collections_vector.dnit[TreeFile](v);
}

fun snapshot_holds(snap: *Vector[TreeFile], f: *TreeFile) bool {
    var i: usize = 0;
    for (i < snap.len) {
        val s: *TreeFile = ?snap.data[i];
        if (str_equals(s.path, f.path)) {
            if (s.kind != f.kind)                                       { ret false; }
            if (s.kind == TREE_DIRECTORY)                               { ret true; }
            if (s.sec != f.sec || s.nsec != f.nsec || s.size != f.size) { ret false; }
            var j: usize = 0;
            for (j < 32) {
                if (s.digest[j] != f.digest[j]) { ret false; }
                j = j + 1;
            }
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun check_step_left_obj_tree(a: *A.Allocator, before: *Vector[TreeFile], tree: str, name: str) err[fail.Fail] {
    var after: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { tree_files_dnit(a, ?after); }
    val err_collect: err[fail.Fail] = collect_tree_files(a, tree, ?after);
    if (sel err_collect.err) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNVERIFIABLE, "build step '{}' left the compiler's module object tree in a state that cannot be verified ({})", name, fail.describe(err_collect.err))};
    }

    var err_verdict: err[fail.Fail] = err[fail.Fail].ok{};
    var i:           usize          = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i])) {
            err_verdict = err[fail.Fail].err{config.step_out_reserved_error(a, "build step", name, after.data[i].path, tree, "the module object tree")};
            i           = after.len;
        }
        or { i = i + 1; }
    }
    i = 0;
    for (sel err_verdict.ok && i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i])) {
            err_verdict = err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_RESERVED, "build step '{}' removed '{}' from '{}/', the compiler-owned module object tree", name, before.data[i].path, tree)};
            i           = before.len;
        }
        or { i = i + 1; }
    }
    ret err_verdict;
}

fun step_paths_absolute(a: *A.Allocator, paths: *Vector[StepPath], out: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < paths.len) {
        val res_dup: res[str, A.Error] = str_dup(a, paths.data[i].abs);
        if (sel res_dup.err) { ret err[fail.Fail].err{fail.refused(res_dup.err)}; }
        val dup:      str                 = res_dup.ok;
        val res_push: res[usize, A.Error] = collections_vector.push[str](out, dup);
        if (sel res_push.err) {
            str_free(a, dup);
            ret err[fail.Fail].err{fail.refused(res_push.err)};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_paths_rel_for_root(a: *A.Allocator, paths: *Vector[StepPath], root: str, out: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < paths.len) {
        val sp: *StepPath = ?paths.data[i];
        if (str_equals(sp.root, root)) {
            val res_dup: res[str, A.Error] = str_dup(a, sp.rel);
            if (sel res_dup.err) { ret err[fail.Fail].err{fail.refused(res_dup.err)}; }
            val dup:      str                 = res_dup.ok;
            val res_push: res[usize, A.Error] = collections_vector.push[str](out, dup);
            if (sel res_push.err) {
                str_free(a, dup);
                ret err[fail.Fail].err{fail.refused(res_push.err)};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun output_path_declared(path: str, declared: *Vector[str]) bool {
    var i: usize = 0;
    for (i < declared.len) {
        if (config.path_in_module_obj_tree(path, declared.data[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun validate_declared_step_outputs(a: *A.Allocator, root: str, outputs: *Vector[str], name: str) err[fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val err_physical: err[fail.Fail] = step_walk.path_check(a, root, outputs.data[i], step_walk.PHYSICAL_ENTRY, "declared build step output");
        if (sel err_physical.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_MISSING, "build step '{}' did not publish its declared output '{}' ({})", name, outputs.data[i], fail.describe(err_physical.err))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_step_output_effects(a: *A.Allocator, before: *Vector[TreeFile], tree: str, declared: *Vector[str], name: str) err[fail.Fail] {
    var after: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { tree_files_dnit(a, ?after); }
    val err_collect: err[fail.Fail] = collect_tree_files(a, tree, ?after);
    if (sel err_collect.err) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNVERIFIABLE, "build step '{}' left the project output tree in a state that cannot be verified ({})", name, fail.describe(err_collect.err))};
    }
    var i: usize = 0;
    for (i < after.len) {
        if (!snapshot_holds(before, ?after.data[i]) && !output_path_declared(after.data[i].path, declared)) {
            val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNDECLARED, "build step '{}' created or changed output '{}' under '{}', which it does not declare. add it to the step's outputs", name, after.data[i].path, tree);
            ret err[fail.Fail].err{msg};
        }
        i = i + 1;
    }
    i = 0;
    for (i < before.len) {
        if (!snapshot_holds(?after, ?before.data[i]) && !output_path_declared(before.data[i].path, declared)) {
            val msg: fail.Fail = fail.formatted_user(a, diagnostic_kind.STEP_OUTPUT_UNDECLARED, "build step '{}' removed output '{}' under '{}', which it does not declare. add it to the step's outputs", name, before.data[i].path, tree);
            ret err[fail.Fail].err{msg};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun combine_step_terminal_results(a: *A.Allocator, object_integrity: err[fail.Fail], output_integrity: err[fail.Fail], execution: err[fail.Fail]) err[fail.Fail] {
    if (sel object_integrity.err) {
        if (sel output_integrity.err) {
            if (sel execution.err) {
                ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(object_integrity.err), "{}. the project output check also failed ({}), and so did the step ({})", fail.describe(object_integrity.err), fail.describe(output_integrity.err), fail.describe(execution.err))};
            }
        }
        if (sel output_integrity.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(object_integrity.err), "{}. the project output check also failed ({})", fail.describe(object_integrity.err), fail.describe(output_integrity.err))};
        }
        if (sel execution.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(object_integrity.err), "{}. the step also failed ({})", fail.describe(object_integrity.err), fail.describe(execution.err))};
        }
        ret object_integrity;
    }
    if (sel output_integrity.err) {
        if (sel execution.err) {
            ret err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(output_integrity.err), "{}. the step also failed ({})", fail.describe(output_integrity.err), fail.describe(execution.err))};
        }
        ret output_integrity;
    }
    ret execution;
}

fun absolute_execution_root(a: *A.Allocator, root: str) res[str, fail.Fail] {
    if (types_path.is_abs(root)) {
        val res_str_dup: res[str, A.Error] = str_dup(a, root);
        if (sel res_str_dup.err) { ret res[str, fail.Fail].err{fail.refused(res_str_dup.err)}; }
        ret res[str, fail.Fail].ok{res_str_dup.ok};
    }
    val res_cwd: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel res_cwd.err) { ret res[str, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_CURRENT_DIR, CWD_OP, fail.Cause.env{res_cwd.err})}; }
    var cwd:        types_string.OwnedString = res_cwd.ok;
    val res_joined: res[str, A.Error]        = types_path.resolve(a, cwd.data, root);
    types_string.owned_dnit(?cwd);
    if (sel res_joined.err) { ret res[str, fail.Fail].err{fail.refused(res_joined.err)}; }
    val joined:    str               = res_joined.ok;
    val res_clean: res[str, A.Error] = types_path.clean(a, joined);
    str_free(a, joined);
    if (sel res_clean.err) { ret res[str, fail.Fail].err{fail.refused(res_clean.err)}; }
    ret res[str, fail.Fail].ok{res_clean.ok};
}

val STEP_FP_SCHEMA: u8 = 1;

fun digest_hex(a: *A.Allocator, digest: *u8, len: usize) res[str, fail.Fail] {
    val opt_cap: opt[usize] = encoding_hex.encoded_len(len);
    if (sel opt_cap.none) { ret res[str, fail.Fail].err{fail.refused(A.Error.overflow{})}; }
    val cap:          usize             = opt_cap.some;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](a, cap);
    if (sel res_allocate.err) { ret res[str, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val buf: *u8 = res_allocate.ok;
    encoding_hex.encode(digest, len, buf, cap);
    ret res[str, fail.Fail].ok{buf::str};
}

fun step_stamp_path(a: *A.Allocator, root_project: str, root_out: str, owner_id: str, step_name: str) res[str, fail.Fail] {
    val res_fname: res[str, fail.Fail] = diagnostic.format(a, "{}.{}.stamp", owner_id, step_name);
    if (sel res_fname.err) { ret res_fname; }
    val fname: str = res_fname.ok;
    fin { str_free(a, fname); }
    val res_out_dir_joined: res[str, fail.Fail] = compile_load.join_path(a, root_project, root_out);
    if (sel res_out_dir_joined.err) { ret res_out_dir_joined; }
    val d1:                   str                 = res_out_dir_joined.ok;
    val res_steps_dir_joined: res[str, fail.Fail] = compile_load.join_path(a, d1, layout.STEPS);
    str_free(a, d1);
    if (sel res_steps_dir_joined.err) { ret res_steps_dir_joined; }
    val d2:       str                 = res_steps_dir_joined.ok;
    val res_path: res[str, fail.Fail] = compile_load.join_path(a, d2, fname);
    str_free(a, d2);
    ret res_path;
}

# whether the stamp at `path` records `text`; a step never stamped has no stamp to match
fun stamp_matches(a: *A.Allocator, path: str, text: str) res[bool, fail.Fail] {
    val res_read_string: res[str, fs.FsError] = fs.read_string(a, path);
    if (sel res_read_string.err) {
        if (sel res_read_string.err.io && res_read_string.err.io.kind == io_error.NOT_FOUND) { ret res[bool, fail.Fail].ok{false}; }
        ret res[bool, fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "read", role: "the build step stamp", path: path}, fail.Cause.fs{res_read_string.err})};
    }
    val prior: str  = res_read_string.ok;
    val eq:    bool = str_equals(prior, text);
    str_free(a, prior);
    ret res[bool, fail.Fail].ok{eq};
}

# the stamp lives in the layout beneath the root project's output directory
fun write_stamp(a: *A.Allocator, root_project: str, root_out: str, path: str, text: str) err[fail.Fail] {
    val res_out: res[str, fail.Fail] = compile_load.join_path(a, root_project, root_out);
    if (sel res_out.err) { ret err[fail.Fail].err{res_out.err}; }
    val err_reserved: err[fail.Fail] = output.reserve(a, res_out.ok, path);
    str_free(a, res_out.ok);
    if (sel err_reserved.err) { ret err_reserved; }
    ret output.bytes(nil, a, path, text::*u8, str_len(text), 0o644, "the build step stamp");
}

val STAMP_LINE: usize = 65;

# the stamp of a step whose fingerprint is `hex` and whose declared outputs are
# in place: the fingerprint, then each output's content digest in declared
# order, one per line. none when an output the path checks refuse is not in
# place, and a compiler failure on the way is the failure
fun stamp_text(a: *A.Allocator, hex: str, outputs: *Vector[StepPath]) res[opt[str], fail.Fail] {
    val n:       usize             = outputs.len;
    val cap:     usize             = (n + 1) * STAMP_LINE + 1;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, cap);
    if (sel res_buf.err) { ret res[opt[str], fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf:    *u8  = res_buf.ok;
    var handed: bool = false;
    fin {
        if (!handed) { A.deallocate[u8](a, buf, cap); }
    }
    var at: usize = 0;
    for (at < STAMP_LINE - 1) {
        buf[at] = hex[at];
        at      = at + 1;
    }
    buf[at] = '\n';
    at      = at + 1;
    var i: usize = 0;
    for (i < n) {
        val sp:        *StepPath      = ?outputs.data[i];
        val err_check: err[fail.Fail] = step_walk.path_check(a, sp.root, sp.rel, step_walk.PHYSICAL_ENTRY, "build step output");
        if (sel err_check.err) {
            if (fail.is_message(err_check.err)) { ret res[opt[str], fail.Fail].err{err_check.err}; }
            ret res[opt[str], fail.Fail].ok{opt[str].none{}};
        }
        var digest:     [32]u8;
        val err_digest: err[fail.Fail] = output_digest(a, sp.abs, ?digest);
        if (sel err_digest.err) { ret res[opt[str], fail.Fail].err{err_digest.err}; }
        encoding_hex.encode(?digest[0], 32, ?buf[at], cap - at);
        at      = at + STAMP_LINE - 1;
        buf[at] = '\n';
        at      = at + 1;
        i       = i + 1;
    }
    buf[at] = 0;
    handed  = true;
    ret res[opt[str], fail.Fail].ok{opt[str].some{buf::str}};
}

# the content digest of a step output: a file's bytes, or for a directory every
# entry beneath it by path, kind and bytes
fun output_digest(a: *A.Allocator, path: str, digest: *[32]u8) err[fail.Fail] {
    val res_meta: res[fs.Metadata, io_error.Error] = fs.metadata_link(path);
    if (sel res_meta.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_STAT, fail.Op{verb: "inspect", role: OUTPUT_ROLE, path: path}, fail.Cause.io{res_meta.err})}; }
    val meta: fs.Metadata = res_meta.ok;
    if (!fs.meta_is_dir(?meta)) {
        val err_file: err[fail.Cause] = base_fingerprint.file_sha256(path, ?(@digest)[0]);
        if (sel err_file.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "digest", role: OUTPUT_ROLE, path: path}, err_file.err)}; }
        ret err[fail.Fail].ok{};
    }
    var tree: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { tree_files_dnit(a, ?tree); }
    val err_tree: err[fail.Fail] = collect_tree_files(a, path, ?tree);
    if (sel err_tree.err) { ret err_tree; }
    var s: wire.Sink = wire.digest();
    var i: usize     = 0;
    for (i < tree.len) {
        val f: *TreeFile = ?tree.data[i];
        wire.put_u8(?s, f.kind);
        base_fingerprint.put_text(?s, f.path);
        if (f.kind == TREE_FILE) { wire.put_bytes(?s, ?f.digest[0], 32); }
        i = i + 1;
    }
    wire.digest_final(?s, digest);
    ret err[fail.Fail].ok{};
}

val OUTPUT_ROLE: str = "the build step output";

fun put_step_count(s: *wire.Sink, n: u32) {
    var b: [4]u8;
    b[0] = (n & 0xFF)::u8;
    b[1] = ((n >> 8) & 0xFF)::u8;
    b[2] = ((n >> 16) & 0xFF)::u8;
    b[3] = ((n >> 24) & 0xFF)::u8;
    base_fingerprint.put_domain_bytes(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?b[0], 4);
}

fun put_step_file(s: *wire.Sink, a: *A.Allocator, path: str) err[fail.Fail] {
    val res_read_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel res_read_bytes.err) { ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.FS_READ, fail.Op{verb: "read", role: "the build step input", path: path, given: true}, fail.Cause.fs{res_read_bytes.err})}; }
    var buf:    Vector[u8] = res_read_bytes.ok;
    var digest: [32]u8;
    sha256.hash(buf.data, buf.len, ?digest[0]);
    collections_vector.dnit[u8](?buf);
    base_fingerprint.put_domain_bytes(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, ?digest[0], 32);
    ret err[fail.Fail].ok{};
}

fun put_step_strings(s: *wire.Sink, values: *StepStrings) {
    put_step_count(s, values.count);
    var i: u32 = 0;
    for (i < values.count) {
        base_fingerprint.put_domain_str(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.items[i]::str);
        i = i + 1;
    }
}

# each entry by its native units, so a value with no UTF-8 spelling still
# keys the step
fun put_step_environment(s: *wire.Sink, values: *host_environment.Strings) {
    put_step_count(s, values.count);
    var i: u32 = 0;
    for (i < values.count) {
        val units: usize = host_environment.units_length(values.items[i]);
        base_fingerprint.put_domain_bytes(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.items[i]::*u8, units * $size_of(Unit));
        i = i + 1;
    }
}

fun put_step_paths(s: *wire.Sink, values: *Vector[str]) err[fail.Fail] {
    if (values.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.STEP_TOO_MANY_PATHS, "build step has too many declared paths")}; }
    put_step_count(s, values.len::u32);
    var i: usize = 0;
    for (i < values.len) {
        base_fingerprint.put_domain_str(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i]);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun put_step_inputs(s: *wire.Sink, a: *A.Allocator, values: *Vector[str]) err[fail.Fail] {
    if (values.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.STEP_TOO_MANY_PATHS, "build step has too many expanded inputs")}; }
    put_step_count(s, values.len::u32);
    var i: usize = 0;
    for (i < values.len) {
        base_fingerprint.put_domain_str(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, values.data[i]);
        val err_put_step_file: err[fail.Fail] = put_step_file(s, a, values.data[i]);
        if (sel err_put_step_file.err) { ret err_put_step_file; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun put_step(s: *wire.Sink, a: *A.Allocator, target_s: str, profile_s: str, program: str,
    argv: *StepStrings, env: *host_environment.Strings, prerequisites: *StepStrings,
    ins: *Vector[str], outputs: *Vector[str]) err[fail.Fail] {
    base_fingerprint.put_domain_str(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, target_s);
    base_fingerprint.put_domain_str(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, profile_s);
    base_fingerprint.put_domain_str(s, base_fingerprint.DOMAIN_BUILD_STEP, STEP_FP_SCHEMA, program);
    val err_wpc: err[fail.Fail] = put_step_file(s, a, program);
    if (sel err_wpc.err) { ret err_wpc; }
    put_step_strings(s, argv);
    put_step_environment(s, env);
    put_step_strings(s, prerequisites);
    val err_put_step_paths: err[fail.Fail] = put_step_paths(s, outputs);
    if (sel err_put_step_paths.err) { ret err_put_step_paths; }
    ret put_step_inputs(s, a, ins);
}

fun step_fingerprint(a: *A.Allocator, target_s: str, profile_s: str, program: str,
    argv: *StepStrings, env: *host_environment.Strings, prerequisites: *StepStrings,
    ins: *Vector[str], outputs: *Vector[str], digest: *u8) err[fail.Fail] {
    var s: wire.Sink = wire.grown(a);
    fin { wire.dnit(?s); }
    val err_put: err[fail.Fail] = put_step(?s, a, target_s, profile_s, program, argv, env, prerequisites, ins, outputs);
    if (sel err_put.err) { ret err_put; }
    val opt_failed: opt[fail.Fail] = wire.failure(?s);
    if (sel opt_failed.some) { ret err[fail.Fail].err{opt_failed.some}; }
    sha256.hash(wire.bytes(?s), s.len, digest);
    ret err[fail.Fail].ok{};
}

val STAGING_ROLE: str = "the build step staging area";

fun step_staging_root(a: *A.Allocator, output_root: str, step_name: str) res[str, fail.Fail] {
    ret layout.within(a, output_root, layout.STAGE, step_name);
}

# a staging root the step could not clear on its way out
fun staging_left(a: *A.Allocator, staging_root: str, e: fs.FsError) fail.Fail {
    ret fail.refusal(a, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: STAGING_ROLE, path: staging_root}, fail.Cause.fs{e});
}

fun step_prepare_staging(a: *A.Allocator, output_root: str, staging_root: str, step_name: str) err[fail.Fail] {
    val err_stage: err[fail.Fail] = step_walk.owned_directory_ensure(a, output_root, layout.STAGE, "build step staging area");
    if (sel err_stage.err) { ret err_stage; }
    val res_rel: res[str, fail.Fail] = diagnostic.format(a, "{}/{}", layout.STAGE, step_name);
    if (sel res_rel.err) { ret err[fail.Fail].err{res_rel.err}; }
    val rel: str = res_rel.ok;
    fin { str_free(a, rel); }
    val err_ancestors: err[fail.Fail] = step_walk.ancestors_check(a, output_root, rel, "build step staging area");
    if (sel err_ancestors.err) { ret err_ancestors; }
    val err_remove_all: err[fs.FsError] = fs.remove_all(a, staging_root);
    if (sel err_remove_all.err) {
        ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.STEP_STAGING, fail.Op{verb: "clear", role: STAGING_ROLE, path: staging_root}, fail.Cause.fs{err_remove_all.err})};
    }
    ret step_walk.owned_directory_ensure(a, output_root, rel, "build step staging area");
}

fun step_make_staging_dirs(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    var oi: usize = 0;
    for (oi < outputs.len) {
        val sp: *StepPath = ?outputs.data[oi];
        if (str_equals(sp.root, output_root)) {
            val res_dir: res[str, A.Error] = types_path.parent(a, sp.rel);
            if (sel res_dir.err) { ret err[fail.Fail].err{fail.refused(res_dir.err)}; }
            val rel_dir:  str            = res_dir.ok;
            val err_make: err[fail.Fail] = step_walk.directory_ensure(a, staging_root, rel_dir, "build step staging output directory");
            str_free(a, rel_dir);
            if (sel err_make.err) { ret err[fail.Fail].err{err_make.err}; }
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_paths_staged_absolute(a: *A.Allocator, output_root: str, staging_root: str, outputs: *Vector[StepPath], out: *Vector[str]) err[fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val res_abs: res[str, A.Error] = types_path.resolve(a, staging_root, sp.rel);
            if (sel res_abs.err) { ret err[fail.Fail].err{fail.refused(res_abs.err)}; }
            val joined:    str               = res_abs.ok;
            val res_clean: res[str, A.Error] = types_path.clean(a, joined);
            str_free(a, joined);
            if (sel res_clean.err) { ret err[fail.Fail].err{fail.refused(res_clean.err)}; }
            val abs:      str                 = res_clean.ok;
            val res_push: res[usize, A.Error] = collections_vector.push[str](out, abs);
            if (sel res_push.err) {
                str_free(a, abs);
                ret err[fail.Fail].err{fail.refused(res_push.err)};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun publish_staged_outputs(a: *A.Allocator, staging_root: str, output_root: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    var i: usize = 0;
    for (i < outputs.len) {
        val sp: *StepPath = ?outputs.data[i];
        if (str_equals(sp.root, output_root)) {
            val res_staged: res[str, A.Error] = types_path.resolve(a, staging_root, sp.rel);
            if (sel res_staged.err) { ret err[fail.Fail].err{fail.refused(res_staged.err)}; }
            val staged: str = res_staged.ok;
            fin { str_free(a, staged); }
            val err_rename: err[io_error.Error] = fs.rename(staged, sp.abs);
            if (sel err_rename.err) {
                val op: fail.Op = fail.Op{verb: "publish", role: "the build step output", path: sp.abs, link: "from its staged copy", other: staged};
                ret err[fail.Fail].err{fail.refusal(a, diagnostic_kind.STEP_PUBLISH, op, fail.Cause.io{err_rename.err})};
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# whether the stamp records fingerprint `hex` and the bytes every declared
# output holds now, so an output changed or replaced since the step ran runs it again
fun step_current(a: *A.Allocator, stamp_path: str, hex: str, outputs: *Vector[StepPath]) res[bool, fail.Fail] {
    val res_text: res[opt[str], fail.Fail] = stamp_text(a, hex, outputs);
    if (sel res_text.err) { ret res[bool, fail.Fail].err{res_text.err}; }
    val opt_text: opt[str] = res_text.ok;
    if (sel opt_text.none) { ret res[bool, fail.Fail].ok{false}; }
    fin { str_free(a, opt_text.some); }
    ret stamp_matches(a, stamp_path, opt_text.some);
}

# the stamp of a step that ran, over the outputs it published
fun stamp_outputs(a: *A.Allocator, root_project: str, root_out: str, stamp_path: str, hex: str, outputs: *Vector[StepPath]) err[fail.Fail] {
    val res_text: res[opt[str], fail.Fail] = stamp_text(a, hex, outputs);
    if (sel res_text.err) { ret err[fail.Fail].err{res_text.err}; }
    val opt_text: opt[str] = res_text.ok;
    if (sel opt_text.none) { ret err[fail.Fail].err{fail.message("a published build step output is not in place")}; }
    fin { str_free(a, opt_text.some); }
    ret write_stamp(a, root_project, root_out, stamp_path, opt_text.some);
}

fun run_one_step(a: *A.Allocator, p: *project.Project, step: *manifest_model.StepDef, project_root: str, home_out: str, owner_id: str) err[fail.Fail] {
    val execution_root: str             = project_root;
    var v:              template.Values = compile_closure.owner_tmpl_vars(p, owner_id);
    val step_name:      str             = intern.text(p.s.interner, step.name);
    val root_project:   str             = intern.text(p.s.interner, p.config.home_root);
    val root_out:       str             = intern.text(p.s.interner, p.config.project_work);

    val res_output_root: res[str, A.Error] = types_path.resolve(a, execution_root, home_out);
    if (sel res_output_root.err) { ret err[fail.Fail].err{fail.refused(res_output_root.err)}; }
    val output_root: str = res_output_root.ok;
    fin { str_free(a, output_root); }

    var ins: collections_vector.Vector[str] = collections_vector.init[str](a);
    fin { step_inputs_dnit(a, ?ins); }
    val err_cir: err[fail.Fail] = collect_step_inputs(a, p, step, execution_root, output_root, ?ins);
    if (sel err_cir.err) { ret err_cir; }

    val res_invocation: res[StepInvocation, fail.Fail] = expand_step_invocation(a, p, step, home_out, ?v);
    if (sel res_invocation.err) { ret err[fail.Fail].err{res_invocation.err}; }
    var invocation: StepInvocation = res_invocation.ok;
    fin { step_invocation_dnit(a, ?invocation); }

    val res_program: res[str, fail.Fail] = resolve_step_program(a, execution_root, ?invocation);
    if (sel res_program.err) { ret err[fail.Fail].err{res_program.err}; }
    val program: str = res_program.ok;
    fin { str_free(a, program); }

    var outputs: Vector[StepPath] = collections_vector.init[StepPath](a);
    fin { step_paths_dnit(a, ?outputs); }
    val err_outputs: err[fail.Fail] = collect_step_outputs(a, p, step, execution_root, output_root, ?outputs);
    if (sel err_outputs.err) { ret err_outputs; }
    val err_output_root_dir: err[fail.Fail] = step_walk.directory_ensure(a, root_project, root_out, "project output directory");
    if (sel err_output_root_dir.err) { ret err_output_root_dir; }
    val err_mdr: err[fail.Fail] = step_make_output_dirs(a, ?outputs);
    if (sel err_mdr.err) { ret err_mdr; }

    var output_paths: Vector[str] = collections_vector.init[str](a);
    fin { step_inputs_dnit(a, ?output_paths); }
    val err_output_paths: err[fail.Fail] = step_paths_absolute(a, ?outputs, ?output_paths);
    if (sel err_output_paths.err) { ret err_output_paths; }

    val res_prerequisites: res[StepStrings, fail.Fail] = expand_step_strings(a, p, step.need, step.need_at, step.need_count, home_out, ?v);
    if (sel res_prerequisites.err) { ret err[fail.Fail].err{res_prerequisites.err}; }
    var prerequisites: StepStrings = res_prerequisites.ok;
    fin { step_strings_dnit(a, ?prerequisites); }

    var digest:  [32]u8;
    val err_fpr: err[fail.Fail] = step_fingerprint(a, v.target, v.profile, program, ?invocation.argv, ?invocation.keyed, ?prerequisites, ?ins, ?output_paths, ?digest[0]);
    if (sel err_fpr.err) { ret err_fpr; }

    val res_stamp_path: res[str, fail.Fail] = step_stamp_path(a, root_project, root_out, owner_id, step_name);
    if (sel res_stamp_path.err) { ret err[fail.Fail].err{res_stamp_path.err}; }
    val stamp_path: str = res_stamp_path.ok;
    fin { str_free(a, stamp_path); }
    val res_hex: res[str, fail.Fail] = digest_hex(a, ?digest[0], 32::usize);
    if (sel res_hex.err) { ret err[fail.Fail].err{res_hex.err}; }
    val hex: str = res_hex.ok;
    fin { str_free(a, hex); }

    if (!p.req.no_cache && step.out_count > 0) {
        val res_current: res[bool, fail.Fail] = step_current(a, stamp_path, hex, ?outputs);
        if (sel res_current.err) { ret err[fail.Fail].err{res_current.err}; }
        if (res_current.ok)      { ret err[fail.Fail].ok{}; }
    }

    val res_staging_root: res[str, fail.Fail] = step_staging_root(a, output_root, step_name);
    if (sel res_staging_root.err) { ret err[fail.Fail].err{res_staging_root.err}; }
    val staging_root: str = res_staging_root.ok;
    fin { str_free(a, staging_root); }
    val res_staging_home_out: res[str, fail.Fail] = step_staging_root(a, home_out, step_name);
    if (sel res_staging_home_out.err) { ret err[fail.Fail].err{res_staging_home_out.err}; }
    val staging_home_out: str = res_staging_home_out.ok;
    fin { str_free(a, staging_home_out); }

    val err_prep: err[fail.Fail] = step_prepare_staging(a, output_root, staging_root, step_name);
    if (sel err_prep.err) { ret err_prep; }
    val err_staging_dirs: err[fail.Fail] = step_make_staging_dirs(a, output_root, staging_root, ?outputs);
    if (sel err_staging_dirs.err) { ret err_staging_dirs; }

    val res_staging_invocation: res[StepInvocation, fail.Fail] = expand_step_invocation(a, p, step, staging_home_out, ?v);
    if (sel res_staging_invocation.err) { ret err[fail.Fail].err{res_staging_invocation.err}; }
    var staging_invocation: StepInvocation = res_staging_invocation.ok;
    fin { step_invocation_dnit(a, ?staging_invocation); }

    val opt_started: readout.Instant = readout.item_begin(p.progress);

    val res_obj_tree: res[str, fail.Fail] = config.module_obj_tree(a, output_root, owner_id);
    if (sel res_obj_tree.err) { ret err[fail.Fail].err{res_obj_tree.err}; }
    val obj_tree: str = res_obj_tree.ok;
    fin { str_free(a, obj_tree); }
    var obj_before: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { tree_files_dnit(a, ?obj_before); }
    val err_snapshot: err[fail.Fail] = collect_tree_files(a, obj_tree, ?obj_before);
    if (sel err_snapshot.err) { ret err_snapshot; }

    var staging_before: Vector[TreeFile] = collections_vector.init[TreeFile](a);
    fin { tree_files_dnit(a, ?staging_before); }
    val err_staging_snapshot: err[fail.Fail] = collect_tree_files(a, staging_root, ?staging_before);
    if (sel err_staging_snapshot.err) { ret err_staging_snapshot; }

    val err_run: err[fail.Fail] = execute_step_invocation(a, execution_root, program, ?staging_invocation,
        step_name, step.timeout);

    val err_object_integrity: err[fail.Fail] = check_step_left_obj_tree(a, ?obj_before, obj_tree, step_name);

    var staging_declared: Vector[str] = collections_vector.init[str](a);
    fin { step_inputs_dnit(a, ?staging_declared); }
    var staging_declared_abs: Vector[str] = collections_vector.init[str](a);
    fin { step_inputs_dnit(a, ?staging_declared_abs); }
    var err_output_integrity: err[fail.Fail] = step_paths_rel_for_root(a, ?outputs, output_root, ?staging_declared);
    val staged_ok:            bool           = sel err_output_integrity.ok;
    if (staged_ok) { err_output_integrity = step_paths_staged_absolute(a, output_root, staging_root, ?outputs, ?staging_declared_abs); }
    val effects_ok: bool = sel err_output_integrity.ok;
    if (effects_ok) {
        err_output_integrity = check_step_output_effects(a, ?staging_before, staging_root, ?staging_declared_abs, step_name);
        if (sel err_run.ok) {
            var declared_exec: Vector[str] = collections_vector.init[str](a);
            fin { step_inputs_dnit(a, ?declared_exec); }
            var err_declared:  err[fail.Fail] = step_paths_rel_for_root(a, ?outputs, execution_root, ?declared_exec);
            val exec_declared: bool           = sel err_declared.ok && declared_exec.len > 0;
            if (exec_declared) { err_declared = validate_declared_step_outputs(a, execution_root, ?declared_exec, step_name); }
            val staging_declared_ok: bool = sel err_declared.ok && staging_declared.len > 0;
            if (staging_declared_ok) { err_declared = validate_declared_step_outputs(a, staging_root, ?staging_declared, step_name); }
            if (sel err_declared.err) {
                var err_combined: err[fail.Fail] = err_declared;
                if (sel err_output_integrity.err) {
                    err_combined = err[fail.Fail].err{fail.formatted_user(a, fail.kind_of(err_output_integrity.err), "{}. the declared output check also failed ({})", fail.describe(err_output_integrity.err), fail.describe(err_declared.err))};
                }
                err_output_integrity = err_combined;
            }
        }
    }

    val err_finished: err[fail.Fail] = combine_step_terminal_results(a, err_object_integrity, err_output_integrity, err_run);
    if (sel err_finished.err) {
        val err_cleared: err[fs.FsError] = fs.remove_all(a, staging_root);
        if (sel err_cleared.err) { ret err[fail.Fail].err{fail.with_secondary(a, err_finished.err, staging_left(a, staging_root, err_cleared.err))}; }
        ret err_finished;
    }

    val err_publish: err[fail.Fail] = publish_staged_outputs(a, staging_root, output_root, ?outputs);
    if (sel err_publish.err) { ret err_publish; }
    # the outputs are published, and the next run of the step clears a staging root left here before it stages
    fs.remove_all(a, staging_root);

    var err_stamped: err[fail.Fail] = err[fail.Fail].ok{};
    if (!p.req.no_cache && step.out_count > 0) {
        val err_written: err[fail.Fail] = stamp_outputs(a, root_project, root_out, stamp_path, hex, ?outputs);
        if (sel err_written.err) {
            err_stamped = err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.STEP_CACHE_RECORD, "build step '{}' completed, but its cache record could not be published ({})", step_name, fail.describe(err_written.err))};
        }
    }

    if (sel err_stamped.ok) { readout.item(p.progress, readout.STEPS, step_name, opt_started); }
    ret err_stamped;
}

# run the declaring project's prerequisite steps for the configured cell, in its
# own directory. a dependency's cell runs them as a dependency step runs, homed
# in the root's output tree through an absolute `{project.work}`
pub fun run(a: *A.Allocator, p: *project.Project) err[fail.Fail] {
    if (p.config.step_order_count == 0) { ret err[fail.Fail].ok{}; }
    val res_abs_root: res[str, fail.Fail] = absolute_execution_root(a, intern.text(p.s.interner, p.config.project_root));
    if (sel res_abs_root.err) { ret err[fail.Fail].err{res_abs_root.err}; }
    val abs_root: str = res_abs_root.ok;
    fin { str_free(a, abs_root); }
    var home_out:  str  = intern.text(p.s.interner, p.config.project_work);
    var home_held: bool = false;
    val owner_id:  str  = intern.text(p.s.interner, p.config.id);
    if (p.config.dependency_owned) {
        val res_dependency_out_home: res[str, fail.Fail] = dependency_out_home(a, intern.text(p.s.interner, p.config.home_root), home_out);
        if (sel res_dependency_out_home.err) { ret err[fail.Fail].err{res_dependency_out_home.err}; }
        home_out  = res_dependency_out_home.ok;
        home_held = true;
    }
    fin {
        if (home_held) { str_free(a, home_out); }
    }
    readout.phase_begin(p.progress, readout.STEPS);
    var i: u32 = 0;
    for (i < p.config.step_order_count) {
        val idx:              u32            = p.config.step_order[i];
        val err_run_one_step: err[fail.Fail] = run_one_step(a, p, ?p.config.steps[idx], abs_root, home_out, owner_id);
        if (sel err_run_one_step.err) { ret err_run_one_step; }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.STEPS, p.config.step_order_count, "step", "steps");
    ret err[fail.Fail].ok{};
}

fun dep_resolve_relative_root(alloc: *A.Allocator, cwd: str, rel: str) res[str, fail.Fail] {
    val cwd_len:      usize             = str_len(cwd);
    val rel_len:      usize             = str_len(rel);
    val cap:          usize             = cwd_len + rel_len + 2;
    val res_allocate: res[*u8, A.Error] = A.allocate[u8](alloc, cap);
    if (sel res_allocate.err) { ret res[str, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val buf: *u8 = res_allocate.ok;
    fin { A.deallocate[u8](alloc, buf, cap); }

    var k: usize = 0;
    for (k < cwd_len) {
        buf[k] = cwd[k];
        k      = k + 1;
    }

    var i: usize = 0;
    for (i < rel_len) {
        for (i < rel_len && types_path.is_separator(rel[i])) { i = i + 1; }
        if (i >= rel_len) { brk; }
        val start: usize = i;
        for (i < rel_len && !types_path.is_separator(rel[i])) { i = i + 1; }
        val len: usize = i - start;

        if (len == 1 && rel[start] == '.'::u8) { cnt; }
        if (len == 2 && rel[start] == '.'::u8 && rel[start + 1] == '.'::u8) {
            buf[k] = 0;
            val res_parent: res[str, A.Error] = types_path.parent(alloc, buf::str);
            if (sel res_parent.err) { ret res[str, fail.Fail].err{fail.refused(res_parent.err)}; }
            val parent:     str   = res_parent.ok;
            val parent_len: usize = str_len(parent);
            k = 0;
            for (k < parent_len) {
                buf[k] = parent[k];
                k      = k + 1;
            }
            str_free(alloc, parent);
            cnt;
        }

        if (k > 0 && !types_path.is_separator(buf[k - 1])) {
            buf[k] = types_path.separator();
            k      = k + 1;
        }
        var j: usize = 0;
        for (j < len) {
            buf[k] = rel[start + j];
            k      = k + 1;
            j      = j + 1;
        }
    }
    buf[k] = 0;

    val res_out: res[str, types_string.StrError] = str_copy_slice(alloc, buf::str, 0, k);
    if (sel res_out.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(res_out.err))}; }
    ret res[str, fail.Fail].ok{res_out.ok};
}

fun dependency_out_home(alloc: *A.Allocator, project_root: str, root_out: str) res[str, fail.Fail] {
    if (types_path.is_abs(project_root)) {
        val res_resolve: res[types_path.Path, A.Error] = types_path.resolve(alloc, project_root, root_out);
        if (sel res_resolve.err) { ret res[str, fail.Fail].err{fail.refused(res_resolve.err)}; }
        ret res[str, fail.Fail].ok{res_resolve.ok};
    }

    val res_cwd: res[types_string.OwnedString, env.EnvError] = env.current_dir(alloc);
    if (sel res_cwd.err) { ret res[str, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_CURRENT_DIR, CWD_OP, fail.Cause.env{res_cwd.err})}; }
    var cwd: types_string.OwnedString = res_cwd.ok;

    val res_root: res[str, fail.Fail] = dep_resolve_relative_root(alloc, cwd.data, project_root);
    types_string.owned_dnit(?cwd);
    if (sel res_root.err) { ret res[str, fail.Fail].err{res_root.err}; }
    val root: str = res_root.ok;

    val res_out: res[str, A.Error] = types_path.resolve(alloc, root, root_out);
    str_free(alloc, root);
    if (sel res_out.err) { ret res[str, fail.Fail].err{fail.refused(res_out.err)}; }
    ret res[str, fail.Fail].ok{res_out.ok};
}

# one exported dependency step selected for a cell, by position in the closure
# ---
# dependency: index into `p.config.deps`
# step:       index into that dependency manifest's `steps`
pub rec Dependency {
    dependency: u32;
    step:       u32;
}

# the exported dependency steps a cell runs, in execution order: each realized
# dependency's export step plan for the cell target, dependencies in closure
# order. shared by `dependency_run` and the build plan display
# ---
# p: the configured project
# isa, os, abi: the cell target tuple
# ret: the ordered steps, owned by the caller; err from the export plan
pub fun dependency_plan(p: *project.Project, isa: intern.StrId, os: intern.StrId, abi: intern.StrId) res[Vector[Dependency], fail.Fail] {
    var steps:    Vector[Dependency] = collections_vector.init[Dependency](p.alloc);
    var retained: bool               = false;
    fin {
        if (!retained) { collections_vector.dnit[Dependency](?steps); }
    }
    val n: u32 = p.config.dep_count;
    if (n == 0) {
        retained = true;
        ret res[Vector[Dependency], fail.Fail].ok{steps};
    }

    var tgt: manifest_model.TargetDef;
    tgt.arch = isa;
    tgt.sys  = os;
    tgt.abi  = abi;

    val root_out: str             = intern.text(p.s.interner, p.config.project_work);
    var cv:       template.Values = compile_closure.cell_tmpl_vars(p);
    var i:        u32             = 0;
    for (i < n) {
        val mfd:         *manifest_model.Manifest = ?p.config.deps[i].manifest;
        var order:       *u32                     = nil;
        var count:       u32                      = 0;
        val err_planned: err[fail.Fail]           = manifest_plan.plan_export_steps(p.alloc, p.s.interner, mfd, ?tgt, root_out, ?cv, ?order, ?count);
        if (sel err_planned.err) { ret res[Vector[Dependency], fail.Fail].err{err_planned.err}; }
        fin {
            if (order != nil && count > 0) { A.deallocate[u32](p.alloc, order, count::usize); }
        }
        var si: u32 = 0;
        for (si < count) {
            val res_pushed: res[usize, A.Error] = collections_vector.push[Dependency](?steps, Dependency{dependency: i, step: order[si]});
            if (sel res_pushed.err) { ret res[Vector[Dependency], fail.Fail].err{fail.refused(res_pushed.err)}; }
            si = si + 1;
        }
        i = i + 1;
    }
    retained = true;
    ret res[Vector[Dependency], fail.Fail].ok{steps};
}

pub fun dependency_run(p: *project.Project, isa: intern.StrId, os: intern.StrId, abi: intern.StrId) err[fail.Fail] {
    val res_planned: res[Vector[Dependency], fail.Fail] = dependency_plan(p, isa, os, abi);
    if (sel res_planned.err) { ret err[fail.Fail].err{res_planned.err}; }
    var steps: Vector[Dependency] = res_planned.ok;
    fin { collections_vector.dnit[Dependency](?steps); }
    if (steps.len == 0) { ret err[fail.Fail].ok{}; }

    val root_out:                str                 = intern.text(p.s.interner, p.config.project_work);
    val root_project:            str                 = intern.text(p.s.interner, p.config.home_root);
    val res_dependency_out_home: res[str, fail.Fail] = dependency_out_home(p.alloc, root_project, root_out);
    if (sel res_dependency_out_home.err) { ret err[fail.Fail].err{res_dependency_out_home.err}; }
    val dep_home: str = res_dependency_out_home.ok;
    fin { str_free(p.alloc, dep_home); }

    readout.phase_begin(p.progress, readout.STEPS);
    var i: usize = 0;
    for (i < steps.len) {
        val selected:    Dependency               = steps.data[i];
        val mfd:         *manifest_model.Manifest = ?p.config.deps[selected.dependency].manifest;
        val vendor_root: str                      = intern.text(p.s.interner, p.config.deps[selected.dependency].vendor_root);
        val dep_owner:   str                      = intern.text(p.s.interner, mfd.id);
        val res_dep_abs: res[str, fail.Fail]      = absolute_execution_root(p.alloc, vendor_root);
        if (sel res_dep_abs.err) { ret err[fail.Fail].err{res_dep_abs.err}; }
        val dep_abs:          str            = res_dep_abs.ok;
        val err_run_one_step: err[fail.Fail] = run_one_step(p.alloc, p, ?mfd.steps[selected.step], dep_abs, dep_home, dep_owner);
        str_free(p.alloc, dep_abs);
        if (sel err_run_one_step.err) { ret err[fail.Fail].err{err_run_one_step.err}; }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.STEPS, steps.len::u32, "step", "steps");
    ret err[fail.Fail].ok{};
}
