# the build engine, which runs a plan cell by cell through its phases
#
# each unit runs cold, on a session and a heap of its own torn down when it finishes. a
# unit whose requirement failed is recorded as blocked and skipped, a unit that fails does
# not stop the rest, and the plan's outcome carries the worst unit's severity.

use crypto.hash.sha256;
use std.allocator.heap;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:        std.filesystem;
use io_error:  std.io.error;
use system_os: std.system.os;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use base_catalog: mach.base.catalog;
use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_fingerprint: mach.base.fingerprint;
use mach.base.intern;
use mach.base.wire;
use build_declassified: mach.build.declassified;
use build_emit:         mach.build.emit;
use mach.build.outcome;
use build_plan: mach.build.plan;
use mach.build.step;
use build_testing: mach.build.testing;
use mach.compile;
use mach.compile.backend;
use mach.compile.cache;
use mach.compile.codec;
use compile_frontend: mach.compile.frontend;
use mach.compile.passes;
use mach.compile.project;
use mach.compile.request;
use mach.host.output;
use mach.host.output.remove;
use mach.lower.testrunner;
use manifest_model: mach.manifest.model;
use report_phase:   mach.report.phase;
use mach.report.readout;
use mach.session;
use mach.session.query;
use mach_target: mach.target;
use mach.target.input;
use mink_output: mink.catalog.output;
use mink.catalog.output.Spelled;
use mink.format.contract;
use mink.link.input.Given;

rec UnitState {
    inputs:  *contract.Input;
    obj_len: u32;

    out_path: *u8;
    scope:    build_testing.TestScope;
    # the units the build compiles, one object, mirl text and listing each
    unit_len: u32;
    objects:  *str;
    # beside objects: the test object path of each emitted module that has one, else nil
    test_objects: *str;
    ir_outputs:   *str;
    asm_outputs:  *str;
    artifact:     str;
    dispatcher:   str;
}

fun label_failed(failed: *Vector[str], label: str) bool {
    var j: usize = 0;
    for (j < failed.len) {
        if (str_equals(failed.data[j], label)) { ret true; }
        j = j + 1;
    }
    ret false;
}

# the label of a failed cell `u` waits on, none when none has failed. a manifest
# requirement is labelled in `u`'s own scope, `<owner>.<artifact>` for a dependency
fun blocking_requirement(oa: *A.Allocator, failed: *Vector[str], u: *build_plan.BuildUnit) res[opt[str], fail.Fail] {
    var i: usize = 0;
    for (i < u.requires.len) {
        var label: str = u.requires.data[i];
        if (!str_is_empty(u.owner)) {
            val res_owned: res[str, fail.Fail] = diagnostic.join(oa, u.owner, ".", label);
            if (sel res_owned.err) { ret res[opt[str], fail.Fail].err{res_owned.err}; }
            label = res_owned.ok;
        }
        if (label_failed(failed, label)) { ret res[opt[str], fail.Fail].ok{opt[str].some{label}}; }
        i = i + 1;
    }
    i = 0;
    for (i < u.dep_requires.len) {
        if (label_failed(failed, u.dep_requires.data[i])) { ret res[opt[str], fail.Fail].ok{opt[str].some{u.dep_requires.data[i]}}; }
        i = i + 1;
    }
    ret res[opt[str], fail.Fail].ok{opt[str].none{}};
}

fun record_blocked_unit(bo: *outcome.BuildOutcome, sink: *readout.Sink, oa: *A.Allocator, failed: *Vector[str],
    u: *build_plan.BuildUnit, blocked_by: str) err[fail.Fail] {
    var f: fail.Fail = fail.user_of(diagnostic_kind.ARTIFACT_BLOCKED, diagnostic.join(oa,
        "artifact '", u.label, "' was not built, because it needs artifact '", blocked_by,
        "', which failed to build"));
    readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
    outcome.fold_fail(bo, ?f);
    val res_failed_pushed: res[usize, A.Error] = collections_vector.push[str](failed, u.label);
    if (sel res_failed_pushed.err) { ret err[fail.Fail].err{fail.refused(res_failed_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# run every planned cell cold: each unit gets its own session and heap over `spans`
# and is torn down when it finishes, so nothing of one unit's frontend survives into the
# next. a unit whose requirement failed is recorded as blocked and skipped; a unit that
# fails is recorded and the remaining units still run. ok is the outcome of the whole
# plan, its severity the worst unit's; err is a failure of the engine itself, never of a
# unit
# ---
# bp:      the plan, its closure located; read only, and trusted as planned
# backing: the allocator a unit's scratch work draws from and returns to
# spans:   the pool each unit's heap and each module's draws its spans from and gives them
#          back to when it is torn down
# oa:      owns the returned outcome and every path and text in it
# sink:    where every unit, failure, diagnostic and phase row is sent as it happens; nil for none
# ret:     the outcome, released with outcome.outcome_dnit, or an engine failure whose text
#          `oa` owns
pub fun execute(bp: *build_plan.BuildPlan, backing: *A.Allocator, spans: *heap.Pool, oa: *A.Allocator,
    sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    var bo:     outcome.BuildOutcome = outcome.outcome_init(oa);
    var failed: Vector[str]          = collections_vector.init[str](oa);
    var handed: bool                 = false;
    fin {
        if (!handed) { outcome.outcome_dnit(?bo); }
    }

    var i: usize = 0;
    for (i < bp.units.len) {
        val unit: *build_plan.BuildUnit = ?bp.units.data[i];
        readout.unit(sink, unit.label, unit.sel_target, unit.profile, request.goal_verb(unit.goal));

        val res_blocked_by: res[opt[str], fail.Fail] = blocking_requirement(oa, ?failed, unit);
        if (sel res_blocked_by.err) { ret res[outcome.BuildOutcome, fail.Fail].err{res_blocked_by.err}; }
        if (sel res_blocked_by.ok.some) {
            val err_record_blocked_unit: err[fail.Fail] = record_blocked_unit(?bo, sink, oa, ?failed, unit, res_blocked_by.ok.some);
            if (sel err_record_blocked_unit.err) { ret res[outcome.BuildOutcome, fail.Fail].err{err_record_blocked_unit.err}; }
            withdraw(oa, bp.request.project_root, unit, ?bo, sink);
            i = i + 1;
            cnt;
        }

        var unit_failed:      bool                                 = false;
        val res_execute_unit: res[outcome.BuildOutcome, fail.Fail] = execute_unit(bp, i, backing, spans, oa, sink);
        if (sel res_execute_unit.err) {
            var f: fail.Fail = res_execute_unit.err;
            readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
            outcome.fold_fail(?bo, ?f);
            val res_failed_pushed: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
            if (sel res_failed_pushed.err) { ret res[outcome.BuildOutcome, fail.Fail].err{fail.refused(res_failed_pushed.err)}; }
            unit_failed = true;
        }
        if (sel res_execute_unit.ok) {
            var ubo:       outcome.BuildOutcome = res_execute_unit.ok;
            var ubo_moved: bool                 = false;
            fin {
                if (!ubo_moved) { outcome.outcome_dnit(?ubo); }
            }
            if (ubo.severity != outcome.BUILD_OK) {
                val res_failed_pushed: res[usize, A.Error] = collections_vector.push[str](?failed, unit.label);
                if (sel res_failed_pushed.err) { ret res[outcome.BuildOutcome, fail.Fail].err{fail.refused(res_failed_pushed.err)}; }
                unit_failed = true;
            }
            val err_merge: err[A.Error] = outcome.merge(?bo, ?ubo);
            if (sel err_merge.err) { ret res[outcome.BuildOutcome, fail.Fail].err{fail.message("failed to merge build outcome")}; }
            ubo_moved = true;
        }
        if (unit_failed) { withdraw(oa, bp.request.project_root, unit, ?bo, sink); }
        i = i + 1;
    }
    handed = true;
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

# run one planned cell on its own session over a heap drawn from `spans`, the
# session's allocator the build's too, so whatever the unit frees is given back as
# it goes and the rest when the unit ends
# ---
# unit_index: the cell to run
# oa:         owns the returned outcome
# sink:       where the unit's failures, diagnostics and phase rows are sent as they happen; nil for none
# ret:        the outcome of that one unit, released with outcome.outcome_dnit, or an engine failure
fun execute_unit(bp: *build_plan.BuildPlan, unit_index: usize, backing: *A.Allocator, spans: *heap.Pool,
    oa: *A.Allocator, sink: *readout.Sink) res[outcome.BuildOutcome, fail.Fail] {
    var bo: outcome.BuildOutcome = outcome.outcome_init(oa);
    if (unit_index >= bp.units.len) { ret unit_fail(?bo, sink, fail.message("build unit index out of range")); }
    var u_src:  heap.Source;
    var u_heap: heap.Heap;
    heap.pool_source(?u_src, spans);
    val err_init: err[A.Error] = heap.init(?u_heap, ?u_src, 0);
    if (sel err_init.err) { ret unit_fail(?bo, sink, fail.message("failed to initialise allocator")); }
    fin { val err_freed: err[A.Error] = heap.dnit(?u_heap); }
    var u_alloc:  A.Allocator;
    val err_make: err[A.Error] = heap.allocator(?u_alloc, ?u_heap);
    if (sel err_make.err) { ret unit_fail(?bo, sink, fail.message("failed to initialise allocator")); }

    # the unit's session reads the plan's names, so its manifest and cells read as planned
    val res_session: res[session.Session, fail.Fail] = session.init_over(?u_alloc, bp.names, bp.sources);
    if (sel res_session.err) {
        ret unit_fail(?bo, sink, fail.prefixed(?u_alloc, "cannot start the compiler session", res_session.err));
    }
    var sv: session.Session = res_session.ok;
    fin { session.dnit(?sv); }
    sv.backing = backing;
    sv.spans   = spans;
    val s:       *session.Session      = ?sv;
    val planned: *build_plan.BuildUnit = ?bp.units.data[unit_index];

    var progress: readout.Progress;
    val pr:       *readout.Progress = readout.start(?progress, sink);

    val err_held: err[fail.Fail] = plan_held(bp, s);
    if (sel err_held.err) { ret unit_fail(?bo, sink, err_held.err); }

    var req: request.BuildRequest =
        request.for_cell(?bp.request, planned.owner, planned.sel_target, planned.sel_artifact,
        planned.subsystem, planned.goal);

    val res_begin: res[project.Project, fail.Fail] = compile.begin_build(s, bp.manifest, ?bp.closure, ?req, pr);
    if (sel res_begin.err) {
        readout.diagnostics(sink, s.sources, ?s.diags);
        ret unit_fail(?bo, sink, res_begin.err);
    }
    var p: project.Project = res_begin.ok;
    fin { project.dnit_project(?p); }

    val unit: *build_plan.BuildUnit = planned;
    # the cell's objects live in its obj directory, which is the object cache
    p.object_dir = unit.obj_dir;
    p.cache_dir  = unit.cache_dir;
    p.out_dir    = unit.out_dir;

    var st: UnitState;
    st.inputs        = nil;
    st.obj_len       = 0;
    st.out_path      = nil;
    st.scope.have    = false;
    st.scope.pick    = nil;
    st.scope.sel_len = 0;

    var err_run_phase: err[fail.Fail]    = err[fail.Fail].ok{};
    var failed_origin: diagnostic.Origin = diagnostic.ORIGIN_BUILD;
    var pi:            usize             = 0;
    for (pi < unit.phases.len) {
        err_run_phase = run_phase(unit.phases.data[pi], ?p, unit, ?st, ?bo, oa);
        if (sel err_run_phase.err) {
            failed_origin = build_plan.phase_origin(unit.phases.data[pi]);
            val raised: diagnostic.Origin = query.origin_of(?p.s.queries, err_run_phase.err);
            if (raised != diagnostic.ORIGIN_NONE) { failed_origin = raised; }
            brk;
        }
        pi = pi + 1;
    }

    val result_ok3: bool = sel err_run_phase.ok && req.goal == request.GOAL_TEST_LIST;
    if (result_ok3) {
        err_run_phase = list_tests(?p, unit, ?st, ?bo, oa);
    }

    val listing: bool = sel err_run_phase.ok && req.goal == request.GOAL_CHECK && p.req.declassified;
    if (listing) {
        err_run_phase = build_declassified.list(?p, ?bo);
    }

    val result_ok4: bool = sel err_run_phase.ok;
    if (result_ok4) {
        err_run_phase = record_artifact(?p, unit, ?st, ?bo);
    }

    if (st.out_path != nil) { st.out_path = unit.out_path::*u8; }
    outputs_dnit(?p, ?st);
    val err_refreshed: err[fail.Fail] = compile_frontend.refresh_diagnostics(?p);
    if (sel err_run_phase.err) {
        var f: fail.Fail = err_run_phase.err;
        readout.failure(sink, ?f, failed_origin);
    }
    if (sel err_refreshed.err) {
        var failure: fail.Fail = err_refreshed.err;
        readout.failure(sink, ?failure, diagnostic.ORIGIN_BUILD);
        outcome.fold_fail(?bo, ?failure);
        val result_ok: bool = sel err_run_phase.ok;
        if (result_ok) { err_run_phase = err_refreshed; }
    }
    if (sel err_run_phase.ok && pr != nil && req.goal != request.GOAL_CHECK) {
        emit_unit_summary(?p, ?st);
    }

    readout.diagnostics(sink, s.sources, ?s.diags);
    build_testing.scope_dnit(?p, ?st.scope);
    project.all_staged_dnit(?p);

    if (sel err_run_phase.err) {
        var f: fail.Fail = err_run_phase.err;
        outcome.fold_fail(?bo, ?f);
    }
    ret res[outcome.BuildOutcome, fail.Fail].ok{bo};
}

# a cell that failed or was not built leaves no product a reader could take for its own: the
# file at its output path, whether this build wrote it or an earlier one did, and the trees of
# the views `--emit ir` and `--emit asm` write are removed. its objects stay, as each is the
# object cache's, keyed by everything that made it. a removal that fails is a failure of the
# build beside the cell's own
fun withdraw(oa: *A.Allocator, root: str, unit: *build_plan.BuildUnit, bo: *outcome.BuildOutcome, sink: *readout.Sink) {
    # a test build's dispatcher sits in the work directory's test tree, which is its runner's
    if (unit.goal != request.GOAL_ARTIFACT && unit.goal != request.GOAL_OBJECTS) { ret; }
    var paths: [3]str;
    paths[0] = unit.ir_dir;
    paths[1] = unit.asm_dir;
    paths[2] = "";
    # an object product's output path is its obj directory, which is the cache
    if (!str_equals(unit.out_path, unit.obj_dir)) { paths[2] = unit.out_path; }
    var root_fd: usize = system_os.INVALID_HANDLE;
    var k:       usize = 0;
    for (k < 3) {
        val path: str = paths[k];
        k = k + 1;
        val rel: str = beneath(root, path);
        if (rel == nil) { cnt; }
        if (root_fd == system_os.INVALID_HANDLE) {
            val opened: i64 = remove.open_path(root, ?root_fd);
            if (opened < 0) {
                var f: fail.Fail = fail.refusal(oa, diagnostic_kind.FS_OPEN, fail.Op{verb: "open", role: "the project root", path: root}, fail.Cause.native{opened});
                readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
                outcome.fold_fail(bo, ?f);
                ret;
            }
        }
        val rr: remove.Removal = remove.relative(root_fd, rel);
        if (rr.failed && !(rr.kind == io_error.NOT_FOUND && !rr.containment)) {
            var f: fail.Fail = remove.refusal(oa, diagnostic_kind.FS_REMOVE, fail.Op{verb: "remove", role: "the output of a cell that failed", path: path}, rr);
            readout.failure(sink, ?f, diagnostic.ORIGIN_BUILD);
            outcome.fold_fail(bo, ?f);
        }
    }
    # a directory opened read-only loses nothing to a refused close
    if (root_fd != system_os.INVALID_HANDLE) { system_os.close(root_fd); }
}

# `path` as a path beneath the project `root`, nil when it is empty or not provably beneath it
fun beneath(root: str, path: str) str {
    if (str_is_empty(path)) { ret nil; }
    val n:    usize = str_len(path);
    var skip: usize = str_len(root);
    if (skip > 0 && root[skip - 1] != '/')                                { skip = skip + 1; }
    if (n > skip && str_starts_with(path, root) && path[skip - 1] == '/') { ret (?path[skip])::str; }
    # a root given as `.` places relative paths beneath it as they are written
    if ((str_equals(root, ".") || str_equals(root, "./")) && path[0] != '/') { ret path; }
    ret nil;
}

# a session runs a plan it reads as planned: the plan located its closure, and
# the session holds the plan's names, layered over them
fun plan_held(bp: *build_plan.BuildPlan, s: *session.Session) err[fail.Fail] {
    if (!bp.located) { ret err[fail.Fail].err{fail.message("a plan runs only once its dependency closure is located")}; }
    if (?s.interner != bp.names && !intern.descends(?s.interner, bp.names)) {
        ret err[fail.Fail].err{fail.message("the session does not hold the plan's names")};
    }
    ret err[fail.Fail].ok{};
}

fun unit_fail(bo: *outcome.BuildOutcome, sink: *readout.Sink, f: fail.Fail) res[outcome.BuildOutcome, fail.Fail] {
    var fv: fail.Fail = f;
    readout.failure(sink, ?fv, diagnostic.ORIGIN_BUILD);
    outcome.fold_fail(bo, ?fv);
    ret res[outcome.BuildOutcome, fail.Fail].ok{@bo};
}

# each unit's output under `base`, named for its module with the suffix `suffix`
fun plan_unit_outputs(p: *project.Project, base: str, suffix: str) res[*str, fail.Fail] {
    val count: u32 = project.unit_count(p);
    if (count == 0) { ret res[*str, fail.Fail].ok{nil}; }
    val res_allocated: res[*str, A.Error] = A.zallocate[str](p.alloc, count::usize);
    if (sel res_allocated.err) {
        ret res[*str, fail.Fail].err{fail.refused(res_allocated.err)};
    }
    val destinations: *str = res_allocated.ok;
    var complete:     bool = false;
    fin {
        if (!complete) { names_dnit(p, destinations, count); }
    }
    var i: u32 = 0;
    for (i < count) {
        val m:       *project.ModuleEntry = project.unit_module(p, i);
        val opt_fqn: opt[str]             = intern.get(?p.s.interner, m.fqn);
        if (sel opt_fqn.none) {
            ret res[*str, fail.Fail].err{fail.message("module FQN not interned")};
        }
        val res_name: res[str, fail.Fail] = output.mirror_fqn(p.alloc, base, opt_fqn.some, suffix);
        if (sel res_name.err) {
            ret res[*str, fail.Fail].err{res_name.err};
        }
        val name:         str            = res_name.ok;
        val err_reserved: err[fail.Fail] = reserve_output(p, name);
        if (sel err_reserved.err) {
            str_free(p.alloc, name);
            ret res[*str, fail.Fail].err{err_reserved.err};
        }
        destinations[i] = name;
        i               = i + 1;
    }
    complete = true;
    ret res[*str, fail.Fail].ok{destinations};
}

# an output's parent directory exists before its phase runs; the file itself
# is written in place, a build product regenerable by the next build
fun reserve_output(p: *project.Project, name: str) err[fail.Fail] {
    ret output.reserve(p.alloc, p.out_dir, name);
}

# the one object an object product's build wrote, copied to the file `-o` names. a build that
# writes more than one is refused, as `-o` names one file
fun object_output(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState) err[fail.Fail] {
    if (st.obj_len != 1 || st.inputs == nil) {
        ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.CLI_OUTPUT_PATH,
            "-o names one file, and an object product writes one object per module, {} of them in {}. leave -o out and take them from there", st.obj_len, unit.obj_dir)};
    }
    val from:     str                        = st.inputs[0].file;
    val res_read: res[Vector[u8], fail.Fail] = output.read_back(p.alloc, from);
    if (sel res_read.err) { ret err[fail.Fail].err{res_read.err}; }
    var bytes: Vector[u8] = res_read.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    ret output.bytes(?p.s.interner, p.alloc, unit.out_path, bytes.data, bytes.len, 0o644, nil);
}

fun plan_outputs(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState) err[fail.Fail] {
    st.unit_len = project.unit_count(p);
    val goal:    request.BuildGoal = p.req.goal;
    val flat:    bool              = mach_target.flat_image(?p.target);
    val objects: bool              = (goal == request.GOAL_ARTIFACT && !flat)
        || goal == request.GOAL_OBJECTS || goal == request.GOAL_TESTS;
    if (objects) {
        val res_planned: res[*str, fail.Fail] = plan_unit_outputs(p, unit.obj_dir, backend.OBJECT_EXT);
        if (sel res_planned.err) { ret err[fail.Fail].err{res_planned.err}; }
        st.objects = res_planned.ok;
    }
    if (p.req.emit_ir) {
        val res_planned: res[*str, fail.Fail] = plan_unit_outputs(p, unit.ir_dir, "ir");
        if (sel res_planned.err) { ret err[fail.Fail].err{res_planned.err}; }
        st.ir_outputs = res_planned.ok;
    }
    if (p.req.emit_asm) {
        val opt_unlisted: opt[str] = backend.unlisted(?p.back);
        if (sel opt_unlisted.some) {
            ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.CLI_FLAG_INAPPLICABLE,
                "'--emit asm' does not apply to this target, because mirl's {} family writes objects without a listing", opt_unlisted.some)};
        }
        val res_planned: res[*str, fail.Fail] = plan_unit_outputs(p, unit.asm_dir, "s");
        if (sel res_planned.err) { ret err[fail.Fail].err{res_planned.err}; }
        st.asm_outputs = res_planned.ok;
    }
    # an object product's objects are its output, already reserved above, unless -o names a file
    val delivered: bool = goal == request.GOAL_TESTS
        || (goal == request.GOAL_ARTIFACT && (!mach_target.per_module(p.target_entry.kind) || !str_is_empty(p.req.out)));
    if (delivered) {
        val err_reserved: err[fail.Fail] = reserve_output(p, unit.out_path);
        if (sel err_reserved.err) { ret err_reserved; }
        st.artifact = unit.out_path;
    }
    if (goal == request.GOAL_TESTS) {
        val res_file: res[str, fail.Fail] = diagnostic.join(p.alloc, "dispatch.", backend.OBJECT_EXT);
        if (sel res_file.err) { ret err[fail.Fail].err{res_file.err}; }
        val res_name: res[str, A.Error] = types_path.join(p.alloc, unit.test_dir, res_file.ok);
        str_free(p.alloc, res_file.ok);
        if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
        val name:         str            = res_name.ok;
        val err_reserved: err[fail.Fail] = reserve_output(p, name);
        if (sel err_reserved.err) {
            str_free(p.alloc, name);
            ret err_reserved;
        }
        st.dispatcher = name;
        val res_planned: res[*str, fail.Fail] = plan_test_outputs(p);
        if (sel res_planned.err) { ret err[fail.Fail].err{res_planned.err}; }
        st.test_objects = res_planned.ok;
    }
    ret err[fail.Fail].ok{};
}

# `obj/<project>/<module>.test.<object suffix>` for each emitted module with a test object
fun plan_test_outputs(p: *project.Project) res[*str, fail.Fail] {
    if (p.emit_len == 0) { ret res[*str, fail.Fail].ok{nil}; }
    val res_allocated: res[*str, A.Error] = A.zallocate[str](p.alloc, p.emit_len::usize);
    if (sel res_allocated.err) { ret res[*str, fail.Fail].err{fail.refused(res_allocated.err)}; }
    val destinations: *str = res_allocated.ok;
    var complete:     bool = false;
    fin {
        if (!complete) { names_dnit(p, destinations, p.emit_len); }
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (passes.has_test_object(p, m)) {
            val res_named: res[str, fail.Fail] = cache.test_object_path(p, m, p.alloc);
            if (sel res_named.err) { ret res[*str, fail.Fail].err{res_named.err}; }
            destinations[i] = res_named.ok;
            val err_reserved: err[fail.Fail] = reserve_output(p, res_named.ok);
            if (sel err_reserved.err) { ret res[*str, fail.Fail].err{err_reserved.err}; }
        }
        i = i + 1;
    }
    complete = true;
    ret res[*str, fail.Fail].ok{destinations};
}

# release the `count` destination names `names`; a nil list owns nothing
fun names_dnit(p: *project.Project, names: *str, count: u32) {
    if (names == nil) { ret; }
    var i: usize = 0;
    for (i < count::usize) {
        if (names[i] != nil) { str_free(p.alloc, names[i]); }
        i = i + 1;
    }
    A.deallocate[str](p.alloc, names, count::usize);
}

fun outputs_dnit(p: *project.Project, st: *UnitState) {
    names_dnit(p, st.objects, st.unit_len);
    names_dnit(p, st.test_objects, p.emit_len);
    names_dnit(p, st.ir_outputs, st.unit_len);
    names_dnit(p, st.asm_outputs, st.unit_len);
    st.objects      = nil;
    st.test_objects = nil;
    st.ir_outputs   = nil;
    st.asm_outputs  = nil;
    if (st.dispatcher != nil) {
        str_free(p.alloc, st.dispatcher);
        st.dispatcher = nil;
    }
    st.artifact = nil;
}

fun run_phase(ph: build_plan.PhaseKind, p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    val opt_phase_name: opt[str] = build_plan.phase_name(ph);
    if (sel opt_phase_name.none) {
        ret err[fail.Fail].err{build_plan.unknown_phase(oa, ph)};
    }
    var err_phase_finish: err[fail.Fail] = err[fail.Fail].err{fail.message("unknown build phase")};
    if (ph == build_plan.PH_STEPS) { err_phase_finish = compile.phase_finish(p, step.run(p.alloc, p)); }
    if (ph == build_plan.PH_DEP_STEPS) {
        val te: *project.TargetEntry = p.target_entry;
        err_phase_finish = compile.phase_finish(p, step.dependency_run(p, te.isa_name, te.os_name, te.abi_name));
    }
    if (ph == build_plan.PH_LOAD) { err_phase_finish = load_phase(p); }
    if (ph == build_plan.PH_SEMA) { err_phase_finish = compile.run_sema_pass(p); }
    if (ph == build_plan.PH_CODEGEN) {
        err_phase_finish = plan_outputs(p, unit, st);
        val planned: bool = sel err_phase_finish.ok;
        if (planned) { err_phase_finish = plan_unit_writes(p, st); }
        val result_ok: bool = sel err_phase_finish.ok;
        if (result_ok) { err_phase_finish = codegen_phase(p, st); }
    }
    if (ph == build_plan.PH_TEST) { err_phase_finish = test_phase(p, st); }
    if (ph == build_plan.PH_EMIT) { err_phase_finish = emit_phase(p, unit, st, bo); }
    if (ph == build_plan.PH_LINK) { err_phase_finish = link_phase(p, unit, st, bo, oa); }

    if (sel err_phase_finish.err) { ret err_phase_finish; }
    if (ph == build_plan.PH_LOAD || ph == build_plan.PH_SEMA) {
        val status: report_phase.PhaseStatus = compile_frontend.frontend_status(p);
        if (!sel status.kind.accepted) { ret err[fail.Fail].err{report_phase.phase_failure(status)}; }
    }
    ret err_phase_finish;
}

fun load_phase(p: *project.Project) err[fail.Fail] {
    val err_run_load_phase: err[fail.Fail] = compile.run_load_phase(p);
    if (sel err_run_load_phase.err) { ret err_run_load_phase; }
    if (project.module_count(p) == 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.PROJECT_EMPTY, "the entry point loaded no modules")};
    }
    ret err[fail.Fail].ok{};
}

# tests are gathered in module order from the lowered test ir, or from the facts
# a restored test object carries, so a cached test build lists the same tests in
# the same order as a clean one
fun collect_test_scope(p: *project.Project, st: *UnitState) err[fail.Fail] {
    var col: testrunner.Collected = testrunner.collected_init();
    var i:   u32                  = 0;
    for (i < project.module_count(p)) {
        val err_gathered: err[fail.Fail] = cache.collect_tests(p, project.module_at(p, i), i, ?col);
        if (sel err_gathered.err) {
            testrunner.collected_dnit(p.s, ?col);
            ret err[fail.Fail].err{err_gathered.err};
        }
        i = i + 1;
    }
    ret build_testing.collect_scope(p, col, ?st.scope);
}

# each unit's step writes mirl's text of its module before compiling it, masc's listing of the
# object as it compiles it, and the object once it completes
fun plan_unit_writes(p: *project.Project, st: *UnitState) err[fail.Fail] {
    var i: u32 = 0;
    for (i < st.unit_len) {
        val m: *project.ModuleEntry = project.unit_module(p, i);
        if (st.objects != nil) { m.object_output = st.objects[i]; }
        if (p.req.emit_ir)     { m.ir_output = st.ir_outputs[i]; }
        if (p.req.emit_asm)    { m.asm_output = st.asm_outputs[i]; }
        i = i + 1;
    }
    if (st.test_objects == nil) { ret err[fail.Fail].ok{}; }
    i = 0;
    for (i < p.emit_len) {
        if (st.test_objects[i] != nil) { project.module_at(p, p.topo[i]::u32).test.object_output = st.test_objects[i]; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a test build's test objects: each lowered against its module's normal object, verified
# and generated, or restored from `obj/`, read out as test lower, test verify and test
# codegen rows, the first two carved out of the third, and the counters' totals. the tests
# they hold are collected here
fun test_phase(p: *project.Project, st: *UnitState) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.TEST_LOWER);
    readout.phase_carved(p.progress, readout.TEST_LOWER);
    readout.phase_begin(p.progress, readout.TEST_VERIFY);
    readout.phase_carved(p.progress, readout.TEST_VERIFY);
    var objects: u32 = 0;
    var i:       u32 = 0;
    for (i < p.emit_len) {
        if (passes.has_test_object(p, project.module_at(p, p.topo[i]::u32))) { objects = objects + 1; }
        i = i + 1;
    }
    readout.phase_begin(p.progress, readout.TEST_CODEGEN);
    val err_made: err[fail.Fail] = compile.run_test_pass(p);
    if (sel err_made.err) { ret err_made; }

    val err_collected: err[fail.Fail] = collect_test_scope(p, st);
    if (sel err_collected.err) { ret err_collected; }
    readout.phase_end(p.progress, readout.TEST_LOWER, objects, "object", "objects");
    readout.phase_end(p.progress, readout.TEST_VERIFY, objects, "object", "objects");
    readout.phase_end(p.progress, readout.TEST_CODEGEN, objects, "object", "objects");
    stage_rows_end(p, lowered_objects(p) + objects);
    readout.counts_end(p.progress);
    ret err[fail.Fail].ok{};
}

# the objects the build lowered: each module's but those whose object the load restored
fun lowered_objects(p: *project.Project) u32 {
    ret cache.lowered_count(p);
}

# the lower and verify rows count the objects that lowered: a module whose object the load
# restored does not. each unit is lowered just before it is compiled, so lower is carved out of
# the codegen row by each lowering's own span and verify by what each compile measured, and the
# counters' totals close the rows. each object is written as its unit completes, so the emit row
# opens here, carved out of codegen by each write's span, and its own phase closes it
fun codegen_phase(p: *project.Project, st: *UnitState) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.EMIT);
    readout.phase_carved(p.progress, readout.EMIT);
    readout.phase_begin(p.progress, readout.LOWER);
    readout.phase_carved(p.progress, readout.LOWER);
    readout.phase_begin(p.progress, readout.VERIFY);
    readout.phase_carved(p.progress, readout.VERIFY);
    stage_rows_begin(p);
    readout.phase_begin(p.progress, readout.CODEGEN);
    val err_made: err[fail.Fail] = compile.run_codegen_pass(p);
    if (sel err_made.err) { ret err_made; }

    val lowered: u32 = lowered_objects(p);
    readout.phase_end(p.progress, readout.LOWER, lowered, "object", "objects");
    readout.phase_end(p.progress, readout.VERIFY, lowered, "object", "objects");
    readout.phase_end(p.progress, readout.CODEGEN, cache.generated_count(p), "object", "objects");
    # a test build's test objects add to the stage rows, which its test phase closes
    if (!passes.test_build(p)) { stage_rows_end(p, lowered); }
    readout.counts_end(p.progress);
    ret err[fail.Fail].ok{};
}

# the stage rows open carved, timed by what each step moves out of the codegen and test codegen rows
fun stage_rows_begin(p: *project.Project) {
    var i: usize = 0;
    for (i < readout.STAGE_COUNT) {
        readout.phase_begin(p.progress, readout.STAGES[i]);
        readout.phase_carved(p.progress, readout.STAGES[i]);
        i = i + 1;
    }
}

# the stage rows close over the `compiled` modules and test objects whose steps fed them
fun stage_rows_end(p: *project.Project, compiled: u32) {
    var i: usize = 0;
    for (i < readout.STAGE_COUNT) {
        readout.phase_end(p.progress, readout.STAGES[i], compiled, "object", "objects");
        i = i + 1;
    }
}

fun emit_phase(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome) err[fail.Fail] {
    val goal:   request.BuildGoal = p.req.goal;
    val flat:   bool              = mach_target.flat_image(?p.target);
    val t_emit: readout.Instant   = readout.span_begin(p.progress);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.span_into(p.progress, readout.EMIT, t_emit);
            readout.phase_end(p.progress, readout.EMIT, 0, "object", "objects");
            ret err[fail.Fail].ok{};
        }
    }

    val objects: bool = (goal == request.GOAL_ARTIFACT && !flat)
        || goal == request.GOAL_OBJECTS
        || goal == request.GOAL_TESTS;
    if (objects) {
        val err_inputs: err[fail.Fail] = build_emit.object_inputs(p, st.objects, ?st.inputs);
        if (sel err_inputs.err) { ret err_inputs; }
        st.obj_len = build_emit.object_count(p);
    }
    # the digests follow the objects they describe into place
    val err_store: err[fail.Fail] = cache.store_written(p);
    if (sel err_store.err) { ret err_store; }

    if (goal == request.GOAL_OBJECTS) {
        st.out_path = unit.out_path::*u8;
    }

    readout.span_into(p.progress, readout.EMIT, t_emit);
    if (objects) { readout.phase_end(p.progress, readout.EMIT, st.obj_len, "object", "objects"); }
    or           { readout.phase_end(p.progress, readout.EMIT, p.emit_len, "module", "modules"); }
    ret err[fail.Fail].ok{};
}

# how a link job writes its artifact
def LinkHow: u8;
# an image of the kind the work names, from the objects and the external inputs it names
val LINK_IMAGE: LinkHow = 0;
# a static archive of the written objects
val LINK_ARCHIVE: LinkHow = 1;
# the test dispatcher, linked with the test objects and the normal objects
val LINK_DISPATCH: LinkHow = 2;

# the state a link job reads when the link stage runs it
# ---
# how:    how the artifact is written
# st:     the unit's state, holding the destinations and the written objects
# out:    LINK_IMAGE's image kind, mink's row
# loaded: LINK_IMAGE's loaded-image options, nil for none
# links:  LINK_IMAGE's and LINK_DISPATCH's inputs beyond the objects, nil for none
rec LinkWork {
    how:    LinkHow;
    st:     *UnitState;
    out:    *mink_output.Kind;
    loaded: *build_emit.LoadedImageOptions;
    links:  *Vector[input.Input];
}

# the link stage over `w`, writing the unit's artifact
fun link_stage(p: *project.Project, w: *LinkWork) err[fail.Fail] {
    var job: project.LinkJob = project.LinkJob{artifact: w.st.artifact, ctx: w::ptr, run: link_run};
    ret compile.run_link_pass(p, ?job);
}

# the link job's action, run by the link stage only when the artifact must be written
fun link_run(raw: ptr, p: *project.Project, diags: *diagnostic.DiagnosticStore) res[backend.LinkRead, fail.Fail] {
    val w:  *LinkWork  = raw::*LinkWork;
    val st: *UnitState = w.st;
    if (w.how == LINK_ARCHIVE) {
        var written:      *u8            = nil;
        val err_archived: err[fail.Fail] = build_emit.emit_static_archive(p, st.artifact, st.inputs, ?written);
        if (sel err_archived.err) { ret res[backend.LinkRead, fail.Fail].err{err_archived.err}; }
        ret res[backend.LinkRead, fail.Fail].ok{backend.link_read_init(p.alloc)};
    }
    if (w.how == LINK_DISPATCH) {
        val res_gathered: res[ObjectList, fail.Fail] = test_link_objects(p);
        if (sel res_gathered.err) { ret res[backend.LinkRead, fail.Fail].err{res_gathered.err}; }
        var objects: ObjectList = res_gathered.ok;
        fin { A.deallocate[Given](p.alloc, objects.data, objects.cap::usize); }
        ret build_testing.link_dispatcher(p, diags, ?st.scope, w.links, objects.data, objects.len, st.dispatcher, st.artifact);
    }
    if (w.how != LINK_IMAGE) { ret res[backend.LinkRead, fail.Fail].err{base_catalog.unknown_catalog(p.alloc, "link job", w.how::u32)}; }
    val res_ordered: res[*Given, fail.Fail] = build_emit.ordered_inputs(p);
    if (sel res_ordered.err) { ret res[backend.LinkRead, fail.Fail].err{res_ordered.err}; }
    fin { build_emit.ordered_inputs_free(p, res_ordered.ok); }
    var links: *input.Input = nil;
    var count: u32          = 0;
    if (w.links != nil) {
        links = w.links.data;
        count = w.links.len::u32;
    }
    ret build_emit.link_image(p, diags, w.out, res_ordered.ok, build_emit.object_count(p), links, count, st.artifact, w.loaded);
}

fun link_phase(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    val goal: request.BuildGoal = p.req.goal;
    project.set_origin(p, diagnostic.ORIGIN_LINK);

    readout.phase_begin(p.progress, readout.LINK);
    val opt_t_link: readout.Instant = readout.item_begin(p.progress);

    if (goal == request.GOAL_TESTS) {
        if (st.scope.sel_len == 0) {
            readout.phase_end(p.progress, readout.LINK, 0, "binary", "binaries");
            ret err[fail.Fail].ok{};
        }
        val err_link_dispatch_phase: err[fail.Fail] = link_dispatch_phase(p, unit, st);
        if (sel err_link_dispatch_phase.err) { ret err_link_dispatch_phase; }
        val err_record_tests: err[fail.Fail] = build_testing.record_tests(p, ?st.scope, unit.out_path::*u8,
            intern.text(?p.s.interner, unit.target_entry.name), unit.profile, bo, oa);
        if (sel err_record_tests.err) { ret err_record_tests; }
        st.out_path = unit.out_path::*u8;
        readout.item(p.progress, readout.LINK, unit.out_path, opt_t_link);
        readout.phase_end(p.progress, readout.LINK, 1, "binary", "binaries");
        ret err[fail.Fail].ok{};
    }

    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) { ret err[fail.Fail].err{fail.message("no target selected")}; }

    # an object product is each module's object, for a later link to take. `-o` names one
    # file, which takes the object when the build writes exactly one
    if (mach_target.per_module(te.kind)) {
        st.out_path = unit.obj_dir::*u8;
        if (!str_is_empty(p.req.out)) {
            val err_placed: err[fail.Fail] = object_output(p, unit, st);
            if (sel err_placed.err) { ret err_placed; }
            st.out_path = unit.out_path::*u8;
        }
        readout.phase_end(p.progress, readout.LINK, st.obj_len, "object", "objects");
        ret err[fail.Fail].ok{};
    }

    val artifact: str                 = st.artifact;
    val product:  *u8                 = build_emit.artifact_product_name(p);
    var w:        LinkWork            = LinkWork{how: LINK_IMAGE, st: st, out: nil, loaded: nil, links: nil};
    var noun:     str                 = "binary";
    var nouns:    str                 = "binaries";
    var loaded:   build_emit.LoadedImageOptions;
    var held:     bool                = false;
    var links:    Vector[input.Input] = collections_vector.init[input.Input](p.alloc);
    fin {
        if (held) { build_emit.dnit_image_options(p.alloc, ?loaded); }
        collections_vector.dnit[input.Input](?links);
    }
    val made: Spelled = te.kind;
    if (mach_target.is_row(made, ?mink_output.ARCHIVE)) {
        w.how = LINK_ARCHIVE;
        noun  = "archive";
        nouns = "archives";
    }
    or (sel made.row) {
        w.out = made.row;
        if (made.row == ?mink_output.MODULE) {
            noun  = "module";
            nouns = "modules";
        }
        or {
            val res_ext: res[Vector[input.Input], fail.Fail] = build_emit.external_inputs(p, unit);
            if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
            collections_vector.dnit[input.Input](?links);
            links   = res_ext.ok;
            w.links = ?links;
            noun    = "library";
            nouns   = "libraries";
        }
    }
    or {
        if (sel p.target.target.linkage.none) { ret err[fail.Fail].err{fail.message("an executable is linked with no linkage resolved")}; }
        w.out = p.target.target.linkage.some;
        # a flat image takes no external input and carries no resource
        if (!mach_target.flat_image(?p.target)) {
            val res_ext: res[Vector[input.Input], fail.Fail] = build_emit.external_inputs(p, unit);
            if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
            collections_vector.dnit[input.Input](?links);
            links = res_ext.ok;
            val res_loaded: res[build_emit.LoadedImageOptions, fail.Fail] = build_emit.load_image_options(p, te.kind, artifact::*u8);
            if (sel res_loaded.err) { ret err[fail.Fail].err{res_loaded.err}; }
            loaded   = res_loaded.ok;
            held     = true;
            w.loaded = ?loaded;
            w.links  = ?links;
        }
    }
    val err_configured: err[fail.Fail] = set_link_config_input(p, artifact::*u8, product, te.kind, w.out, w.links, w.loaded);
    if (sel err_configured.err) { ret err_configured; }

    val err_linked: err[fail.Fail] = link_stage(p, ?w);
    if (sel err_linked.err) { ret err_linked; }

    st.out_path = artifact::*u8;
    readout.item(p.progress, readout.LINK, artifact, opt_t_link);
    readout.phase_end(p.progress, readout.LINK, 1, noun, nouns);
    ret err[fail.Fail].ok{};
}

fun link_dispatch_phase(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState) err[fail.Fail] {
    val res_external_inputs: res[Vector[input.Input], fail.Fail] = build_emit.external_inputs(p, unit);
    if (sel res_external_inputs.err) {
        ret err[fail.Fail].err{res_external_inputs.err};
    }
    var links: Vector[input.Input] = res_external_inputs.ok;
    fin { collections_vector.dnit[input.Input](?links); }

    val err_cfg: err[fail.Fail] = set_dispatch_config_input(p, st.artifact::*u8, ?links, ?st.scope);
    if (sel err_cfg.err) { ret err_cfg; }

    var w: LinkWork = LinkWork{how: LINK_DISPATCH, st: st, loaded: nil, links: ?links};
    ret link_stage(p, ?w);
}

rec ObjectList {
    # one slot past the objects for the dispatcher's own
    data: *Given;
    len:  u32;
    cap:  u32;
}

# the objects a dispatcher links after its own: every emitted module's test object, then the
# build's objects in the link's order
fun test_link_objects(p: *project.Project) res[ObjectList, fail.Fail] {
    val cap:           u32                  = p.emit_len + build_emit.object_count(p) + 1;
    val res_allocated: res[*Given, A.Error] = A.allocate[Given](p.alloc, cap::usize);
    if (sel res_allocated.err) { ret res[ObjectList, fail.Fail].err{fail.refused(res_allocated.err)}; }
    var list:      ObjectList     = ObjectList{data: res_allocated.ok, len: 0, cap: cap};
    val err_backs: err[fail.Fail] = cache.test_objects_back(p);
    if (sel err_backs.err) {
        A.deallocate[Given](p.alloc, list.data, cap::usize);
        ret res[ObjectList, fail.Fail].err{err_backs.err};
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.test.object != nil) {
            val res_named: res[str, fail.Fail] = build_emit.test_input_name(p, m);
            if (sel res_named.err) {
                A.deallocate[Given](p.alloc, list.data, cap::usize);
                ret res[ObjectList, fail.Fail].err{res_named.err};
            }
            list.data[list.len] = Given{name: res_named.ok, object: m.test.object};
            list.len            = list.len + 1;
        }
        i = i + 1;
    }
    val err_filled: err[fail.Fail] = build_emit.objects_into(p, ?list.data[list.len]);
    if (sel err_filled.err) {
        A.deallocate[Given](p.alloc, list.data, cap::usize);
        ret res[ObjectList, fail.Fail].err{err_filled.err};
    }
    list.len = list.len + build_emit.object_count(p);
    ret res[ObjectList, fail.Fail].ok{list};
}

fun set_dispatch_config_input(p: *project.Project, out_path: *u8, links: *Vector[input.Input],
    sc: *build_testing.TestScope) err[fail.Fail] {
    val res_out: res[*mink_output.Kind, fail.Fail] = mach_target.executable_output(p.alloc, ?p.target);
    if (sel res_out.err) { ret err[fail.Fail].err{res_out.err}; }
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    write_link_config(?fb, p, out_path, build_emit.artifact_product_name(p), Spelled.executable{}, res_out.ok, links, nil);
    build_testing.fingerprint_scope(?fb, p, sc);
    ret set_link_config(p, ?fb, links);
}

fun list_tests(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    ret build_testing.record_tests(p, ?st.scope, nil, intern.text(?p.s.interner, unit.target_entry.name), unit.profile, bo, oa);
}

fun record_artifact(p: *project.Project, unit: *build_plan.BuildUnit, st: *UnitState, bo: *outcome.BuildOutcome) err[fail.Fail] {
    if (st.out_path == nil) { ret err[fail.Fail].ok{}; }

    var kind: Spelled = Spelled.executable{};
    if (p.req.goal == request.GOAL_OBJECTS) { kind = Spelled.row{?mink_output.RELOCATABLE}; }
    or (p.req.goal == request.GOAL_TESTS)   { kind = Spelled.executable{}; }
    or (p.target_entry != nil)              { kind = p.target_entry.kind; }

    val err_rec: err[A.Error] = outcome.record_artifact(bo, kind, st.out_path::str);
    if (sel err_rec.err) { ret err[fail.Fail].err{fail.refused(err_rec.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_unit_summary(p: *project.Project, st: *UnitState) {
    var out_str: str = "<output>";
    if (st.out_path != nil) { out_str = st.out_path::str; }

    val te:       *project.TargetEntry = p.target_entry;
    val emit_obj: bool                 = p.req.goal == request.GOAL_OBJECTS;
    val is_lib:   bool                 = emit_obj || (te != nil && (mach_target.is_library(te.kind) || mach_target.per_module(te.kind)));

    if (!is_lib && st.out_path != nil) {
        val res_metadata: res[fs.Metadata, io_error.Error] = fs.metadata(st.out_path::str);
        if (sel res_metadata.ok) {
            readout.summary(p.progress, out_str, p.emit_len, res_metadata.ok.size, true);
            ret;
        }
    }
    readout.summary(p.progress, out_str, p.emit_len, 0, false);
}

# publish the link configuration of a project as the Q_LINK_CONFIG query input: the
# output path, product name, the artifact's kind and the output kind it links as, the inputs
# beyond the objects with the directories a library is searched in, and the loaded-image
# options, fingerprinted so an unchanged configuration keeps its revision and any change
# invalidates the link
# ---
# p:    the project whose session holds the query db
# made: the artifact's kind
# out:  the image kind it links as, nil for an archive
# ret:  ok, or the fingerprint or query failure
fun set_link_config_input(p: *project.Project, out_path: *u8, product: *u8, made: Spelled, out: *mink_output.Kind,
    links: *Vector[input.Input], image: *build_emit.LoadedImageOptions) err[fail.Fail] {
    var fb: wire.Sink = wire.grown(p.alloc);
    fin { wire.dnit(?fb); }
    write_link_config(?fb, p, out_path, product, made, out, links, image);
    ret set_link_config(p, ?fb, links);
}

# the link configuration a sink holds, as the link's query input, and its digest and whether
# `links` names an input found by name, as the link's key reads them
fun set_link_config(p: *project.Project, fb: *wire.Sink, links: *Vector[input.Input]) err[fail.Fail] {
    val res_taken: res[query.QueryOutput, fail.Fail] = codec.output(fb);
    if (sel res_taken.err) { ret err[fail.Fail].err{res_taken.err}; }
    sha256.hash(res_taken.ok.bytes, res_taken.ok.len::usize, ?p.link_config[0]);
    p.link_config_keyed = true;
    p.link_by_name      = false;
    if (links != nil) {
        var i: usize = 0;
        for (i < links.len) {
            if (links.data[i].form != input.FILE) { p.link_by_name = true; }
            i = i + 1;
        }
    }
    val err_set_input: err[fail.Fail] = query.set_input(?p.s.queries, ?passes.LINK_CONFIG, 0, res_taken.ok.bytes, res_taken.ok.len);
    if (res_taken.ok.bytes != nil) { A.deallocate[u8](p.alloc, res_taken.ok.bytes, res_taken.ok.len::usize); }
    ret err_set_input;
}

fun write_link_config(fb: *wire.Sink, p: *project.Project, out_path: *u8, product: *u8, made: Spelled, out: *mink_output.Kind,
    links: *Vector[input.Input], image: *build_emit.LoadedImageOptions) {
    base_fingerprint.put_text(fb, mach_target.kind_name(made));
    var kind: str = "";
    if (out != nil) { kind = out.name; }
    base_fingerprint.put_text(fb, kind);
    base_fingerprint.put_text(fb, out_path::str);
    base_fingerprint.put_text(fb, product::str);
    var subsystem: str = "";
    if (sel p.req.subsystem.some) { subsystem = p.req.subsystem.some.name; }
    base_fingerprint.put_text(fb, subsystem);

    var has_resources: u32 = 0;
    if (image != nil && image.declared) { has_resources = 1; }
    wire.put_u32(fb, has_resources);
    if (has_resources != 0) {
        base_fingerprint.put_text(fb, image.icon_path);
        base_fingerprint.put_content(fb, image.icon_bytes.data, image.icon_bytes.len);
        base_fingerprint.put_text(fb, image.manifest_path);
        base_fingerprint.put_content(fb, image.manifest_bytes.data, image.manifest_bytes.len);
        base_fingerprint.put_text(fb, image.version);
        base_fingerprint.put_text(fb, image.internal_name);
        base_fingerprint.put_text(fb, image.original_filename);
        base_fingerprint.put_text(fb, image.product_name);
    }

    # a library named by name is fingerprinted by its name and the directories searched,
    # since mink finds its file only as the link runs
    if (links == nil) {
        wire.put_u32(fb, 0);
        ret;
    }
    wire.put_u32(fb, links.len::u32);
    var i: usize = 0;
    for (i < links.len) {
        val li: *input.Input = ?links.data[i];
        wire.put_u8(fb, li.form);
        base_fingerprint.put_text(fb, li.text);
        if (li.form == input.FILE) { base_fingerprint.put_file(fb, ?p.s.interner, p.alloc, li.text); }
        var referenced: u8 = 0;
        if (li.include_referenced) { referenced = 1; }
        wire.put_u8(fb, referenced);
        wire.put_u8(fb, li.kind);
        i = i + 1;
    }
    wire.put_u32(fb, p.req.lib_dirs.len::u32);
    var d: usize = 0;
    for (d < p.req.lib_dirs.len) {
        base_fingerprint.put_text(fb, p.req.lib_dirs.data[d]);
        d = d + 1;
    }
    put_layout(fb, p);
}

# the layout the cell's artifact states its image: its section order, size ceiling and
# memory regions. a global's placement is its object's, which the link reads already
fun put_layout(fb: *wire.Sink, p: *project.Project) {
    val art: *manifest_model.ArtifactDef = p.config.artifact;
    if (art == nil) {
        wire.put_u32(fb, 0);
        ret;
    }
    wire.put_u32(fb, art.section_count + 1);
    var i: u32 = 0;
    for (i < art.section_count) {
        base_fingerprint.put_name(fb, ?p.s.interner, art.sections[i]);
        i = i + 1;
    }
    var size: u64 = 0;
    if (sel art.size.some) { size = art.size.some; }
    wire.put_u64(fb, size);
    wire.put_u32(fb, art.region_count);
    i = 0;
    for (i < art.region_count) {
        val r: *manifest_model.RegionDef = ?art.regions[i];
        base_fingerprint.put_name(fb, ?p.s.interner, r.name);
        wire.put_u64(fb, r.origin);
        wire.put_u64(fb, r.length);
        wire.put_u8(fb, r.access);
        wire.put_u32(fb, r.run_count);
        var k: u32 = 0;
        for (k < r.run_count) {
            base_fingerprint.put_name(fb, ?p.s.interner, r.run[k]);
            k = k + 1;
        }
        wire.put_u32(fb, r.load_count);
        k = 0;
        for (k < r.load_count) {
            base_fingerprint.put_name(fb, ?p.s.interner, r.load[k]);
            k = k + 1;
        }
        i = i + 1;
    }
}
