pub fun classify_subprocess(term: *subprocess.SubprocessTerminal, expired: bool, cap_ok: bool, cap: *subprocess.CaptureIoResult) testrun.GateResult {
    if (cap_ok && (cap.read_failed || cap.write_failed || cap.close_failed)) {
        ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (!cap_ok) {
        ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_CAPTURE, nil);
    }
    if (expired) {
        ret testrun.gate_result(testrun.RESULT_RESOURCE_EXHAUSTION, testrun.CAUSE_ORACLE_TIMEOUT, nil);
    }
    if (term.kind == subprocess.STATE_EXITED && term.code == 0) {
        ret testrun.gate_result(testrun.RESULT_PASS, testrun.CAUSE_PASS, nil);
    }
    if (term.kind == subprocess.STATE_EXITED && term.code == testrun.EXIT_SKIP) {
        ret testrun.gate_result(testrun.RESULT_SKIP, testrun.CAUSE_SKIP, nil);
    }
    if (term.kind == subprocess.STATE_EXITED) {
        ret testrun.gate_result(testrun.RESULT_SEMANTIC_MISMATCH, testrun.CAUSE_ORACLE_EXIT, nil);
    }
    if (term.kind == subprocess.STATE_SIGNALED) {
        ret testrun.gate_result(testrun.RESULT_SEMANTIC_MISMATCH, testrun.CAUSE_ORACLE_SIGNAL, nil);
    }
    if (term.kind == subprocess.STATE_SPAWN_FAILURE) {
        ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_SPAWN_FAILURE, nil);
    }
    ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_INVALID_TERMINAL, nil);
}

pub fun classify_setup_failure() testrun.GateResult {
    ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_ORACLE_SPAWN_FAILURE, nil);
}

pub fun classify_wait_failure() testrun.GateResult {
    ret testrun.gate_result(testrun.RESULT_INFRASTRUCTURE_FAILURE, testrun.CAUSE_INVALID_TERMINAL, nil);
}

pub rec TestScope {
    col:     testrunner.Collected;
    have:    bool;
    pick:    *testrunner.Test;
    sel_len: u32;
}

# col is the unit's test declarations in module order; the scope owns it from here
pub fun collect_scope(p: *project.Project, col: testrunner.Collected, sc: *TestScope) err[fail.Fail] {
    sc.have    = false;
    sc.pick    = nil;
    sc.sel_len = 0;

    sc.col  = col;
    sc.have = true;
    var handed: bool = false;
    fin {
        if (!handed) { scope_dnit(p, sc); }
    }
    if (sc.col.count == 0) {
        handed = true;
        ret err[fail.Fail].ok{};
    }

    val res_sel: res[*testrunner.Test, A.Error] = A.allocate[testrunner.Test](p.alloc, sc.col.count::usize);
    if (sel res_sel.err) { ret err[fail.Fail].err{fail.refused(res_sel.err)}; }
    sc.pick = res_sel.ok;
    var i: u32 = 0;
    for (i < sc.col.count) {
        if (test_selected(p, ?sc.col.tests[i])) {
            sc.pick[sc.sel_len] = sc.col.tests[i];
            sc.sel_len          = sc.sel_len + 1;
        }
        i = i + 1;
    }
    handed = true;
    ret err[fail.Fail].ok{};
}

pub fun scope_dnit(p: *project.Project, sc: *TestScope) {
    if (sc.pick != nil && sc.have && sc.col.count > 0) {
        A.deallocate[testrunner.Test](p.alloc, sc.pick, sc.col.count::usize);
    }
    sc.pick    = nil;
    sc.sel_len = 0;
    if (sc.have) {
        testrunner.collected_dnit(p.s, ?sc.col);
        sc.have = false;
    }
}

pub fun record_tests(p: *project.Project, sc: *TestScope, exe: *u8, target: str, profile: str,
    bo: *outcome.BuildOutcome, oa: *A.Allocator) err[fail.Fail] {
    var k: u32 = 0;
    for (k < sc.sel_len) {
        val err_record_test: err[fail.Fail] = record_test(p, ?sc.pick[k], exe, target, profile, k, bo);
        if (sel err_record_test.err) { ret err_record_test; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# a run selects the project's own tests, or its dependencies' too under
# `--include-deps`, whose qualified name contains the filter
fun test_selected(p: *project.Project, t: *testrunner.Test) bool {
    if (!p.req.include_deps && !test_in_project(p, t)) { ret false; }
    if (str_is_empty(p.req.test_filter))               { ret true; }
    val opt_name: opt[str] = intern.get(?p.s.interner, t.name);
    if (sel opt_name.none) { ret false; }
    ret str_contains(opt_name.some, p.req.test_filter);
}

fun test_in_project(p: *project.Project, t: *testrunner.Test) bool {
    if (t.mod_idx >= project.module_count(p)) { ret false; }
    val m: *project.ModuleEntry = project.module_at(p, t.mod_idx);
    ret passes.module_in_current_project(p, m.fqn);
}

# synthesize the dispatcher over the selected tests, write its object to `dispatcher`, and
# link it with the test objects and the normal objects into `artifact`, answering what the link
# read
# ---
# modules: the build's current objects: test and normal objects in topological order
pub fun link_dispatcher(p: *project.Project, diags: *diagnostic.DiagnosticStore, sc: *TestScope, links: *Vector[input.Input],
    modules: *Given, module_len: u32, dispatcher: str, artifact: str) res[backend.LinkRead, fail.Fail] {
    if (p.target_entry == nil) { ret res[backend.LinkRead, fail.Fail].err{fail.message("no target selected")}; }
    ret build_dispatch_executable(p, diags, dispatcher, artifact, sc.pick, sc.sel_len, modules, module_len, links);
}

pub fun fingerprint_scope(s: *wire.Sink, p: *project.Project, sc: *TestScope) {
    wire.put_u32(s, sc.sel_len);
    var i: u32 = 0;
    for (i < sc.sel_len) {
        val t: *testrunner.Test = ?sc.pick[i];
        base_fingerprint.put_text(s, scope_name(p, t.name)::str);
        wire.put_u32(s, t.line);
        wire.put_u32(s, t.mod_idx);
        i = i + 1;
    }
}

fun scope_name(p: *project.Project, id: intern.StrId) *u8 {
    val opt_interner_entry: opt[str] = intern.get(?p.s.interner, id);
    if (sel opt_interner_entry.some) { ret opt_interner_entry.some::*u8; }
    ret ""::*u8;
}

# the name the link gives the object of the test dispatcher
val DISPATCHER_INPUT: str = "the test dispatcher";

fun build_dispatch_executable(p: *project.Project, diags: *diagnostic.DiagnosticStore, dispatcher: str, artifact: str,
    pick: *testrunner.Test, sel_len: u32,
    modules: *Given, module_len: u32, links: *Vector[input.Input]) res[backend.LinkRead, fail.Fail] {
    val res_machine: res[*lower_context.Machine, fail.Fail] = backend.machine(?p.back);
    if (sel res_machine.err) { ret res[backend.LinkRead, fail.Fail].err{res_machine.err}; }
    project.set_origin(p, diagnostic.ORIGIN_LOWER);
    val res_c_main: res[intern.StrId, A.Error] = intern.add(?p.s.interner, testrunner.MAIN_LINKAGE);
    if (sel res_c_main.err) { ret res[backend.LinkRead, fail.Fail].err{fail.refused(res_c_main.err)}; }
    val res_linked_main: res[intern.StrId, fail.Fail] = project.link_name_for(p, res_c_main.ok);
    if (sel res_linked_main.err) { ret res[backend.LinkRead, fail.Fail].err{res_linked_main.err}; }
    val res_synth: res[Module, fail.Fail] = testrunner.synthesize_dispatcher(p.s, res_machine.ok, res_linked_main.ok, pick, sel_len);
    if (sel res_synth.err) { ret res[backend.LinkRead, fail.Fail].err{res_synth.err}; }
    var entry: Module = res_synth.ok;
    fin { mirl_module.dnit(?entry); }

    project.set_origin(p, diagnostic.ORIGIN_CODEGEN);
    val res_compiled: res[Object, fail.Fail] = passes.compile_module(p, diags, ?entry, "__mach_test_dispatch");
    if (sel res_compiled.err) { ret res[backend.LinkRead, fail.Fail].err{res_compiled.err}; }
    var entry_object: Object = res_compiled.ok;
    fin { backend.object_dnit(?entry_object); }
    var written:  build_emit.ObjectWrite = build_emit.ObjectWrite{p: p, o: ?entry_object, record: nil};
    var target:   output.Temporary       = output.Temporary{a: p.alloc, path: dispatcher, destination: dispatcher};
    val err_emit: err[fail.Fail]         = build_emit.write_object(?written, ?target);
    if (sel err_emit.err) { ret res[backend.LinkRead, fail.Fail].err{err_emit.err}; }

    # the dispatcher is the test executable's `main`: an artifact's own `main` yields to it
    # as a weak definition, in a copy, so the normal object stays as the cache holds it
    val total:    u32                  = module_len + 1;
    val res_made: res[*Given, A.Error] = A.allocate[Given](p.alloc, total::usize);
    if (sel res_made.err) { ret res[backend.LinkRead, fail.Fail].err{fail.refused(res_made.err)}; }
    val objects: *Given = res_made.ok;
    fin { A.deallocate[Given](p.alloc, objects, total::usize); }
    var yielded: Object;
    var yields:  bool = false;
    fin {
        if (yields) { backend.object_dnit(?yielded); }
    }
    objects[0] = Given{name: DISPATCHER_INPUT, object: ?entry_object};
    var i: u32 = 0;
    for (i < module_len) {
        objects[i + 1] = modules[i];
        if (!yields) {
            val res_weak: res[opt[Object], fail.Fail] = backend.weakened(p.s.backing, modules[i].object, intern.text(?p.s.interner, res_linked_main.ok));
            if (sel res_weak.err) { ret res[backend.LinkRead, fail.Fail].err{res_weak.err}; }
            if (sel res_weak.ok.some) {
                yielded               = res_weak.ok.some;
                yields                = true;
                objects[i + 1].object = ?yielded;
            }
        }
        i = i + 1;
    }

    project.set_origin(p, diagnostic.ORIGIN_LINK);
    val res_out: res[*mink_output.Kind, fail.Fail] = mach_target.executable_output(p.alloc, ?p.target);
    if (sel res_out.err) { ret res[backend.LinkRead, fail.Fail].err{res_out.err}; }
    ret build_emit.link_image(p, diags, res_out.ok, objects, total, links.data, links.len::u32, artifact, nil);
}

fun record_test(p: *project.Project, t: *testrunner.Test, exe: *u8, target: str, profile: str, idx: u32,
    bo: *outcome.BuildOutcome) err[fail.Fail] {
    val name: str = intern.text(?p.s.interner, t.name);
    if (t.mod_idx >= project.module_count(p)) { ret err[fail.Fail].err{fail.message("a test names a module the project never loaded")}; }
    val m:        *project.ModuleEntry         = project.module_at(p, t.mod_idx);
    val opt_file: opt[*base_source.SourceFile] = base_source.get(p.s.sources, m.file_id);
    if (sel opt_file.none) { ret err[fail.Fail].err{fail.message("a test's module has no source file")}; }

    val res_located: res[str, fail.Fail] = cache.test_object_path(p, m, p.alloc);
    if (sel res_located.err) { ret err[fail.Fail].err{res_located.err}; }
    val object:  *u8          = res_located.ok::*u8;
    val err_rec: err[A.Error] = outcome.record_test(bo, testrun.TestArtifact{
        module: intern.text(?p.s.interner, m.fqn)::*u8, name: name::*u8, file: opt_file.some.path::*u8,
        line:   t.line, object: object, exe: exe, idx: idx, target: target::*u8, profile: profile::*u8
    });
    if (object != nil)   { str_free(p.alloc, object::str); }
    if (sel err_rec.err) { ret err[fail.Fail].err{fail.refused(err_rec.err)}; }
    ret err[fail.Fail].ok{};
}
