# writing a build's products: objects into `obj/`, the static archive and the linked image
#
# the link's inputs are gathered here too: the build's objects in link order, the
# libraries the manifest, its dependencies and the command line name, and the
# resources an executable declares.

use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source:    mach.base.source;
use build_plan:     mach.build.plan;
use build_resource: mach.build.resource;
use mach.compile.backend;
use mach.compile.cache;
use mach.compile.claims;
use mach.compile.project;
use mach.host.output;
use mach.lower.linkage;
use mach.lower.placement;
use manifest_link:  mach.manifest.link;
use manifest_model: mach.manifest.model;
use mach.report.readout;
use mach_target: mach.target;
use mach.target.input;
use mink_fail: mink.base.fail;
use mink.base.store.Bytes;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink_output: mink.catalog.output;
use mink.catalog.output.Spelled;
use mink_ar: mink.format.ar.write;
use mink.format.contract;
use mink_file:    mink.format.file;
use mink_formats: mink.link.formats;
use mink_input:   mink.link.input;
use mink.link.input.Given;
use mink.link.input.Include;
use mink.link.input.Request;
use mink.link.input.Source;
use mink.link.options.Area;
use mink.link.options.Offset;
use mink.link.options.Within;
use mink.model.object.Object;

pub fun artifact_product_name(p: *project.Project) *u8 {
    val opt_interner_entry: opt[str] = intern.get(p.s.interner, p.config.bin_name);
    if (sel opt_interner_entry.some) { ret opt_interner_entry.some::*u8; }
    ret ""::*u8;
}

# the resources an executable declares: its icon and manifest, read, with the
# version and names an image's version resource states
pub rec LoadedImageOptions {
    declared:          bool;
    icon_bytes:        Vector[u8];
    manifest_bytes:    Vector[u8];
    icon_path:         str;
    manifest_path:     str;
    version:           str;
    internal_name:     str;
    original_filename: str;
    product_name:      str;
}

# release loaded image options; nil options own nothing
pub fun dnit_image_options(a: *A.Allocator, loaded: *LoadedImageOptions) {
    if (loaded == nil) { ret; }
    collections_vector.dnit[u8](?loaded.icon_bytes);
    collections_vector.dnit[u8](?loaded.manifest_bytes);
    if (loaded.icon_path != nil)     { str_free(a, loaded.icon_path); }
    if (loaded.manifest_path != nil) { str_free(a, loaded.manifest_path); }
}

# the resources an executable declares, read where the target's images state a
# subsystem, as mink's host of it names; an image of another host carries none
pub fun load_image_options(p: *project.Project, out_kind: Spelled,
    exe_path: *u8) res[LoadedImageOptions, fail.Fail] {
    var loaded: LoadedImageOptions;
    var handed: bool = false;
    loaded.declared          = false;
    loaded.icon_bytes        = collections_vector.init[u8](p.alloc);
    loaded.manifest_bytes    = collections_vector.init[u8](p.alloc);
    loaded.icon_path         = nil;
    loaded.manifest_path     = nil;
    loaded.version           = "";
    loaded.internal_name     = "";
    loaded.original_filename = "";
    loaded.product_name      = "";
    fin {
        if (!handed) { dnit_image_options(p.alloc, ?loaded); }
    }

    if (!mach_target.is_executable(out_kind) || !mach_target.states_subsystem(?p.target)) {
        handed = true;
        ret res[LoadedImageOptions, fail.Fail].ok{loaded};
    }
    if (intern.str_is_nil(p.config.icon) && intern.str_is_nil(p.config.app_manifest)) {
        handed = true;
        ret res[LoadedImageOptions, fail.Fail].ok{loaded};
    }

    val opt_root: opt[str] = intern.get(p.s.interner, p.config.project_root);
    val opt_ver:  opt[str] = intern.get(p.s.interner, p.config.version);
    val opt_name: opt[str] = intern.get(p.s.interner, p.config.bin_name);
    if (sel opt_root.none) { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }
    if (sel opt_ver.none)  { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }
    if (sel opt_name.none) { ret res[LoadedImageOptions, fail.Fail].err{fail.message("resource metadata is not interned")}; }

    val err_icon: err[fail.Fail] = declared_resource_read(p, opt_root.some, p.config.icon, "icon", ?loaded.icon_path, ?loaded.icon_bytes);
    if (sel err_icon.err) { ret res[LoadedImageOptions, fail.Fail].err{err_icon.err}; }
    val err_manifest_read: err[fail.Fail] = declared_resource_read(p, opt_root.some, p.config.app_manifest, "manifest",
        ?loaded.manifest_path, ?loaded.manifest_bytes);
    if (sel err_manifest_read.err) { ret res[LoadedImageOptions, fail.Fail].err{err_manifest_read.err}; }

    loaded.declared          = true;
    loaded.version           = opt_ver.some;
    loaded.internal_name     = opt_name.some;
    loaded.original_filename = types_path.filename(exe_path::str);
    loaded.product_name      = opt_name.some;
    handed                   = true;
    ret res[LoadedImageOptions, fail.Fail].ok{loaded};
}

# reads the artifact resource `rel` declares, relative to the project root,
# into `bytes`, recording its path; nothing when it declares none. `noun` names
# the resource in a refusal
fun declared_resource_read(p: *project.Project, root: str, rel: intern.StrId, noun: str,
    path: *str, bytes: *Vector[u8]) err[fail.Fail] {
    if (intern.str_is_nil(rel)) { ret err[fail.Fail].ok{}; }
    val opt_rel: opt[str] = intern.get(p.s.interner, rel);
    if (sel opt_rel.none) { ret err[fail.Fail].err{fail.message_of(diagnostic.join(p.alloc, "artifact ", noun, " path is not interned"))}; }
    val res_join: res[str, A.Error] = types_path.join(p.alloc, root, opt_rel.some);
    if (sel res_join.err) { ret err[fail.Fail].err{fail.refused(res_join.err)}; }
    @path = res_join.ok;
    val res_read_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(p.alloc, @path);
    if (sel res_read_bytes.err) {
        val res_role: res[str, fail.Fail] = diagnostic.join(p.alloc, "the artifact ", noun);
        if (sel res_role.err) { ret err[fail.Fail].err{res_role.err}; }
        ret err[fail.Fail].err{fail.refusal(p.alloc, diagnostic_kind.ARTIFACT_RESOURCE_UNREADABLE, fail.Op{verb: "read", role: res_role.ok, path: @path, given: true}, fail.Cause.fs{res_read_bytes.err})};
    }
    collections_vector.dnit[u8](bytes);
    @bytes = res_read_bytes.ok;
    if (bytes.len == 0) {
        ret err[fail.Fail].err{fail.user_of(diagnostic_kind.ARTIFACT_RESOURCE_EMPTY, diagnostic.join(p.alloc,
            "artifact ", noun, " '", opt_rel.some, "' is empty"))};
    }
    ret err[fail.Fail].ok{};
}

fun read_bufs_dnit(alloc: *A.Allocator, bufs: *Vector[u8], cap: u32) {
    var i: u32 = 0;
    for (i < cap) {
        collections_vector.dnit[u8](?bufs[i]);
        i = i + 1;
    }
    A.deallocate[Vector[u8]](alloc, bufs, cap::usize);
}

# the archive of the build's objects, each unit's, read back from `inputs` in their
# order, as mink's archive writer lays one out in the variant its
# registry states for the target's format, its index naming each member's exported symbols
pub fun emit_static_archive(p: *project.Project, destination: str, inputs: *contract.Input, out_path: **u8) err[fail.Fail] {
    val len:         u32                              = object_count(p);
    val res_variant: res[*mink_ar.Variant, fail.Fail] = backend.archive_variant(?p.back, p.alloc);
    if (sel res_variant.err) { ret err[fail.Fail].err{res_variant.err}; }

    val res_src: res[*mink_ar.Source, A.Error] = A.allocate[mink_ar.Source](p.alloc, len::usize + 1);
    if (sel res_src.err) { ret err[fail.Fail].err{fail.refused(res_src.err)}; }
    val sources: *mink_ar.Source = res_src.ok;
    fin { A.deallocate[mink_ar.Source](p.alloc, sources, len::usize + 1); }

    val res_bufs: res[*Vector[u8], A.Error] = A.allocate[Vector[u8]](p.alloc, len::usize);
    if (sel res_bufs.err) { ret err[fail.Fail].err{fail.refused(res_bufs.err)}; }
    val bufs: *Vector[u8] = res_bufs.ok;
    fin { read_bufs_dnit(p.alloc, bufs, len); }

    var i: u32 = 0;
    for (i < len) {
        bufs[i] = collections_vector.init[u8](p.alloc);
        i       = i + 1;
    }

    val err_backs: err[fail.Fail] = cache.objects_back(p);
    if (sel err_backs.err) { ret err_backs; }
    i = 0;
    for (i < len) {
        val m:      *project.ModuleEntry = project.unit_module(p, i);
        val member: intern.StrId         = m.fqn;
        val object: *Object              = m.object;
        if (object == nil) { ret err[fail.Fail].err{fail.message("an archive requires every current object")}; }
        val opt_named: opt[str] = intern.get(p.s.interner, member);
        if (sel opt_named.none) { ret err[fail.Fail].err{fail.message("archive member name not interned")}; }

        val res_read_back: res[Vector[u8], fail.Fail] = output.read_back(p.alloc, inputs[i].file);
        if (sel res_read_back.err) { ret err[fail.Fail].err{res_read_back.err}; }
        bufs[i]    = res_read_back.ok;
        sources[i] = mink_ar.Source{
            name:   Bytes{data: opt_named.some::*u8, len: str_len(opt_named.some)}, data: Bytes{data: bufs[i].data, len: bufs[i].len},
            object: object, names: nil, count: 0
        };
        i = i + 1;
    }

    val res_written: res[Sink, mink_fail.Fail] = mink_ar.build(p.alloc, res_variant.ok, sources, len::usize);
    if (sel res_written.err) { ret err[fail.Fail].err{backend.refused_by_mink(p.alloc, "the archive could not be written", res_written.err)}; }
    var bytes: Sink = res_written.ok;
    fin { val err_freed: err[mink_fail.Fail] = sink.dnit(?bytes); }
    var img:                   Image          = Image{data: sink.data(?bytes), len: sink.len(?bytes), mode: mink_file.mode_of(?mink_output.ARCHIVE)};
    val err_through_temporary: err[fail.Fail] = output.through_temporary[Image](p.alloc, destination, ?img, write_image);
    if (sel err_through_temporary.err) { ret err_through_temporary; }
    @out_path = destination::*u8;
    ret err[fail.Fail].ok{};
}

# an image's bytes and the mode its file is written with
rec Image {
    data: *u8;
    len:  usize;
    mode: i32;
}

# the name the link gives the resource file mach writes of an executable's resources
val RESOURCE_INPUT: str = "the artifact's resources";

# the resource file of the resources `image` declares, owned by the caller
fun resource_file(p: *project.Project, image: *LoadedImageOptions) res[Sink, fail.Fail] {
    var d: build_resource.Declared = build_resource.Declared{
        icon:              nil,
        icon_len:          0,
        manifest:          nil,
        manifest_len:      0,
        version:           image.version,
        internal_name:     image.internal_name,
        original_filename: image.original_filename,
        product_name:      image.product_name
    };
    if (image.icon_path != nil) {
        d.icon     = image.icon_bytes.data;
        d.icon_len = image.icon_bytes.len;
    }
    if (image.manifest_path != nil) {
        d.manifest     = image.manifest_bytes.data;
        d.manifest_len = image.manifest_bytes.len;
    }
    ret build_resource.file_of(p.alloc, ?d);
}

fun write_image(img: *Image, t: *output.Temporary) err[fail.Fail] {
    ret output.fill(t, img.data, img.len, img.mode);
}

# the layout the artifact states and the placements its objects carry, handed to mink as one
# link plan: its section order, size ceiling and regions, and an offset for each section a
# global's `#[at]` places, read from the section's name, kept by the link whether referenced
# or not. the layout names only the output sections the link lays some object's section into,
# as mink's layout rules name them, since one artifact's layout serves whatever program it links
rec PlanHeld {
    plan:        backend.Plan;
    present:     Vector[str];
    keep:        Vector[str];
    sections:    Vector[str];
    regions:     Vector[Area];
    runs:        Vector[Within];
    loads:       Vector[Within];
    offsets:     Vector[Offset];
    sections_at: Vector[base_source.Location];
    regions_at:  Vector[base_source.Location];
}

fun plan_init(a: *A.Allocator) PlanHeld {
    var h: PlanHeld;
    h.present     = collections_vector.init[str](a);
    h.keep        = collections_vector.init[str](a);
    h.sections    = collections_vector.init[str](a);
    h.regions     = collections_vector.init[Area](a);
    h.runs        = collections_vector.init[Within](a);
    h.loads       = collections_vector.init[Within](a);
    h.offsets     = collections_vector.init[Offset](a);
    h.sections_at = collections_vector.init[base_source.Location](a);
    h.regions_at  = collections_vector.init[base_source.Location](a);
    h.plan        = backend.Plan{keep: nil, keep_count: 0, sections: nil, section_count: 0, regions: nil, region_count: 0, runs: nil, run_count: 0,
        loads: nil, load_count: 0, offsets: nil, offset_count: 0, size: opt[u64].none{}};
    ret h;
}

fun plan_dnit(h: *PlanHeld) {
    collections_vector.dnit[str](?h.present);
    collections_vector.dnit[str](?h.keep);
    collections_vector.dnit[str](?h.sections);
    collections_vector.dnit[Area](?h.regions);
    collections_vector.dnit[Within](?h.runs);
    collections_vector.dnit[Within](?h.loads);
    collections_vector.dnit[Offset](?h.offsets);
    collections_vector.dnit[base_source.Location](?h.sections_at);
    collections_vector.dnit[base_source.Location](?h.regions_at);
}

# the plan of the artifact and its `count` objects at `objects` into `h`, whether it states
# anything at all
fun plan_of(p: *project.Project, inputs: *Given, count: u32, h: *PlanHeld) res[bool, fail.Fail] {
    var names: Vector[View] = collections_vector.init[View](p.alloc);
    fin { collections_vector.dnit[View](?names); }
    var symbols: Vector[View] = collections_vector.init[View](p.alloc);
    fin { collections_vector.dnit[View](?symbols); }
    val res_laying: res[opt[backend.Laying], fail.Fail] = backend.laying(?p.back, p.alloc);
    if (sel res_laying.err) { ret res[bool, fail.Fail].err{res_laying.err}; }
    var opt_laying: opt[backend.Laying] = res_laying.ok;
    fin {
        if (sel opt_laying.some) { backend.laying_dnit(?opt_laying.some); }
    }
    var o: u32 = 0;
    for (o < count) {
        names.len = 0;
        val err_listed: err[fail.Fail] = backend.section_names(inputs[o].object, ?names);
        if (sel err_listed.err) { ret res[bool, fail.Fail].err{err_listed.err}; }
        var k: usize = 0;
        for (k < names.len) {
            val view: View = names.data[k];
            k = k + 1;
            val res_held: res[intern.StrId, A.Error] = intern.range_add(p.s.interner, view.data::str, 0, view.len);
            if (sel res_held.err) { ret res[bool, fail.Fail].err{fail.refused(res_held.err)}; }
            val name:  str  = intern.text(p.s.interner, res_held.ok);
            val first: bool = !plan_holds(h, name);
            if (first) {
                val res_kept: res[usize, A.Error] = collections_vector.push[str](?h.present, name);
                if (sel res_kept.err) { ret res[bool, fail.Fail].err{fail.refused(res_kept.err)}; }
            }
            val opt_offset_of: opt[u64] = placement.offset_of(view);
            if (sel opt_offset_of.none) { cnt; }
            if (!first) {
                ret res[bool, fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_SECTION_UNSUPPORTED,
                    "two globals are placed at offset {} of the image, and one offset holds one global", opt_offset_of.some)};
            }
            val res_pushed: res[usize, A.Error] = collections_vector.push[Offset](?h.offsets, Offset{section: name, offset: opt_offset_of.some});
            if (sel res_pushed.err) { ret res[bool, fail.Fail].err{fail.refused(res_pushed.err)}; }
            symbols.len = 0;
            val err_placed: err[fail.Fail] = backend.globals_in(inputs[o].object, view, ?symbols);
            if (sel err_placed.err) { ret res[bool, fail.Fail].err{err_placed.err}; }
            var y:      usize = 0;
            var holder: str   = "";
            for (y < symbols.len) {
                val res_sym: res[intern.StrId, A.Error] = intern.range_add(p.s.interner, symbols.data[y].data::str, 0, symbols.data[y].len);
                y = y + 1;
                if (sel res_sym.err) { ret res[bool, fail.Fail].err{fail.refused(res_sym.err)}; }
                val held: str = intern.text(p.s.interner, res_sym.ok);
                # one module's globals at one offset share the section named for it
                if (y > 1) {
                    ret res[bool, fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_SECTION_UNSUPPORTED,
                        "globals '{}' and '{}' are both placed at offset {} of the image, and one offset holds one global", holder, held, opt_offset_of.some)};
                }
                holder = held;
                val res_kept: res[usize, A.Error] = collections_vector.push[str](?h.keep, held);
                if (sel res_kept.err) { ret res[bool, fail.Fail].err{fail.refused(res_kept.err)}; }
            }
        }
        # after its own names, so a placed section's name is first seen as its own
        if (sel opt_laying.some) {
            val err_laid: err[fail.Fail] = plan_laid(p, ?opt_laying.some, inputs[o].object, h);
            if (sel err_laid.err) { ret res[bool, fail.Fail].err{err_laid.err}; }
        }
        o = o + 1;
    }
    val art: *manifest_model.ArtifactDef = p.config.artifact;
    if (art != nil) {
        var i: u32 = 0;
        for (i < art.section_count) {
            val name: str = intern.text(p.s.interner, art.sections[i]);
            i = i + 1;
            if (!plan_holds(h, name)) { cnt; }
            val res_pushed: res[usize, A.Error] = collections_vector.push[str](?h.sections, name);
            if (sel res_pushed.err) { ret res[bool, fail.Fail].err{fail.refused(res_pushed.err)}; }
            val res_placed: res[usize, A.Error] = collections_vector.push[base_source.Location](?h.sections_at, manifest_model.site_of(art.sections_at, i - 1));
            if (sel res_placed.err) { ret res[bool, fail.Fail].err{fail.refused(res_placed.err)}; }
        }
        h.plan.size = art.size;
        i           = 0;
        for (i < art.region_count) {
            val r:          *manifest_model.RegionDef = ?art.regions[i];
            val res_pushed: res[usize, A.Error]       = collections_vector.push[Area](?h.regions, Area{name: intern.text(p.s.interner, r.name), origin: r.origin, length: r.length, access: r.access});
            if (sel res_pushed.err) { ret res[bool, fail.Fail].err{fail.refused(res_pushed.err)}; }
            val res_placed: res[usize, A.Error] = collections_vector.push[base_source.Location](?h.regions_at, r.at);
            if (sel res_placed.err) { ret res[bool, fail.Fail].err{fail.refused(res_placed.err)}; }
            var k: u32 = 0;
            for (k < r.run_count) {
                val name: str = intern.text(p.s.interner, r.run[k]);
                k = k + 1;
                if (!plan_holds(h, name)) { cnt; }
                val res_run: res[usize, A.Error] = collections_vector.push[Within](?h.runs, Within{section: name, region: i::usize});
                if (sel res_run.err) { ret res[bool, fail.Fail].err{fail.refused(res_run.err)}; }
            }
            k = 0;
            for (k < r.load_count) {
                val name: str = intern.text(p.s.interner, r.load[k]);
                k = k + 1;
                if (!plan_holds(h, name)) { cnt; }
                val res_load: res[usize, A.Error] = collections_vector.push[Within](?h.loads, Within{section: name, region: i::usize});
                if (sel res_load.err) { ret res[bool, fail.Fail].err{fail.refused(res_load.err)}; }
            }
            i = i + 1;
        }
    }
    h.plan.keep          = h.keep.data;
    h.plan.keep_count    = h.keep.len;
    h.plan.sections      = h.sections.data;
    h.plan.section_count = h.sections.len;
    h.plan.regions       = h.regions.data;
    h.plan.region_count  = h.regions.len;
    h.plan.runs          = h.runs.data;
    h.plan.run_count     = h.runs.len;
    h.plan.loads         = h.loads.data;
    h.plan.load_count    = h.loads.len;
    h.plan.offsets       = h.offsets.data;
    h.plan.offset_count  = h.offsets.len;
    ret res[bool, fail.Fail].ok{h.sections.len + h.regions.len + h.offsets.len > 0 || sel h.plan.size.some};
}

# the output sections the link lays the sections of `o` into, added to what `h` holds
fun plan_laid(p: *project.Project, laying: *backend.Laying, o: *Object, h: *PlanHeld) err[fail.Fail] {
    var i: usize = 0;
    for (i < backend.section_count(o)) {
        val res_laid: res[View, fail.Fail] = backend.laid_name(p.alloc, laying, o, i);
        i = i + 1;
        if (sel res_laid.err) { ret err[fail.Fail].err{res_laid.err}; }
        val res_held: res[intern.StrId, A.Error] = intern.range_add(p.s.interner, res_laid.ok.data::str, 0, res_laid.ok.len);
        if (sel res_held.err) { ret err[fail.Fail].err{fail.refused(res_held.err)}; }
        val name: str = intern.text(p.s.interner, res_held.ok);
        if (plan_holds(h, name)) { cnt; }
        val res_kept: res[usize, A.Error] = collections_vector.push[str](?h.present, name);
        if (sel res_kept.err) { ret err[fail.Fail].err{fail.refused(res_kept.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether some object of the link holds the section `name`
fun plan_holds(h: *PlanHeld, name: str) bool {
    var i: usize = 0;
    for (i < h.present.len) {
        if (str_equals(h.present.data[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the image of `kind` mink links in memory from the `count` objects at `inputs`, in link order,
# then the `link_count` inputs at `links`, written to `destination` with the resources
# `image` declares, laid out as the artifact and its placed globals state, what the link tells of
# itself reported to `diags`, answering what the link read
pub fun link_image(p: *project.Project, diags: *diagnostic.DiagnosticStore, kind: *mink_output.Kind, inputs: *Given, count: u32,
    links: *input.Input, link_count: u32, destination: str, image: *LoadedImageOptions) res[backend.LinkRead, fail.Fail] {
    val res_linked: res[backend.Linked, fail.Fail] = linked_image(p, diags, kind, inputs, count, links, link_count, destination, image);
    if (sel res_linked.err) { ret res[backend.LinkRead, fail.Fail].err{res_linked.err}; }
    var made: backend.Linked = res_linked.ok;
    fin { val err_freed: err[mink_fail.Fail] = sink.dnit(?made.image); }
    var img:         Image          = Image{data: sink.data(?made.image), len: sink.len(?made.image), mode: mink_file.mode_of(kind)};
    val err_written: err[fail.Fail] = output.through_temporary[Image](p.alloc, destination, ?img, write_image);
    if (sel err_written.err) {
        backend.link_read_dnit(p.alloc, ?made.read);
        ret res[backend.LinkRead, fail.Fail].err{err_written.err};
    }
    ret res[backend.LinkRead, fail.Fail].ok{made.read};
}

# the image link_image writes, linked in memory, and what its link read
fun linked_image(p: *project.Project, diags: *diagnostic.DiagnosticStore, kind: *mink_output.Kind, inputs: *Given, count: u32,
    links: *input.Input, link_count: u32, destination: str, image: *LoadedImageOptions) res[backend.Linked, fail.Fail] {
    if (count == 0) { ret res[backend.Linked, fail.Fail].err{fail.message("a link requires an object")}; }

    var opt_resources: opt[Sink] = opt[Sink].none{};
    fin {
        if (sel opt_resources.some) { val err_freed: err[mink_fail.Fail] = sink.dnit(?opt_resources.some); }
    }
    if (image != nil && image.declared) {
        val res_made: res[Sink, fail.Fail] = resource_file(p, image);
        if (sel res_made.err) { ret res[backend.Linked, fail.Fail].err{res_made.err}; }
        opt_resources = opt[Sink].some{res_made.ok};
    }
    var carried: usize = 0;
    if (sel opt_resources.some) { carried = 1; }
    val res_stated: res[opt[Object], fail.Fail] = image_stack(p, inputs, count);
    if (sel res_stated.err) { ret res[backend.Linked, fail.Fail].err{res_stated.err}; }
    var opt_stack: opt[Object] = res_stated.ok;
    fin {
        if (sel opt_stack.some) { backend.object_dnit(?opt_stack.some); }
    }
    var stacked: usize = 0;
    if (sel opt_stack.some) { stacked = 1; }

    val total:    usize                  = count::usize + link_count::usize + stacked + carried;
    val res_made: res[*Request, A.Error] = A.allocate[Request](p.alloc, total);
    if (sel res_made.err) { ret res[backend.Linked, fail.Fail].err{fail.refused(res_made.err)}; }
    val requests: *Request = res_made.ok;
    fin { A.deallocate[Request](p.alloc, requests, total); }
    var i: u32 = 0;
    for (i < count) {
        requests[i] = Request.source{Source.object{inputs[i]}};
        i           = i + 1;
    }
    i = 0;
    for (i < link_count) {
        requests[count + i] = link_request(?links[i]);
        i                   = i + 1;
    }
    if (sel opt_stack.some) {
        requests[count::usize + link_count::usize] = Request.source{Source.object{Given{name: STACK_INPUT, object: ?opt_stack.some}}};
    }
    if (sel opt_resources.some) {
        requests[count::usize + link_count::usize + stacked] = Request.source{Source.bytes{contract.Input{file: RESOURCE_INPUT, data: sink.data(?opt_resources.some), len: sink.len(?opt_resources.some)}}};
    }
    # a library named by name is searched for in the `-L` directories, then the working
    # directory, then the system's
    val dir_count: usize              = p.req.lib_dirs.len + 1;
    val res_dirs:  res[*str, A.Error] = A.allocate[str](p.alloc, dir_count);
    if (sel res_dirs.err) { ret res[backend.Linked, fail.Fail].err{fail.refused(res_dirs.err)}; }
    val dirs: *str = res_dirs.ok;
    fin { A.deallocate[str](p.alloc, dirs, dir_count); }
    var d: usize = 0;
    for (d < p.req.lib_dirs.len) {
        dirs[d] = p.req.lib_dirs.data[d];
        d       = d + 1;
    }
    dirs[d] = ".";
    var held_plan: PlanHeld = plan_init(p.alloc);
    fin { plan_dnit(?held_plan); }
    if (sel opt_stack.some) {
        val res_held: res[usize, A.Error] = collections_vector.push[str](?held_plan.present, backend.STACK_SECTION);
        if (sel res_held.err) { ret res[backend.Linked, fail.Fail].err{fail.refused(res_held.err)}; }
    }
    val res_planned: res[bool, fail.Fail] = plan_of(p, inputs, count, ?held_plan);
    if (sel res_planned.err) { ret res[backend.Linked, fail.Fail].err{res_planned.err}; }
    var placed: backend.Image = backend.Image{
        base:          opt[u64].none{},
        subsystem:     p.req.subsystem,
        libdirs:       dirs,
        libdir_count:  dir_count,
        stack_reserve: opt[u64].none{},
        stack_commit:  opt[u64].none{},
        plan:          nil,
        stated:        stated_of(p, ?held_plan)
    };
    if (res_planned.ok)     { placed.plan = ?held_plan.plan; }
    if (p.target.base != 0) { placed.base = opt[u64].some{p.target.base}; }
    if (!backend.lays_stack(?p.target)) {
        if (p.target.stack_reserve != 0) { placed.stack_reserve = opt[u64].some{p.target.stack_reserve}; }
        if (p.target.stack_commit != 0)  { placed.stack_commit = opt[u64].some{p.target.stack_commit}; }
    }
    ret backend.link(?p.back, p.alloc, diags, kind, requests, total, destination, true, ?placed, p.req.threads);
}

# where the manifest, or `--set`, states each option the link hands mink: the target's values
# and the artifact's, the sections and regions parallel to the plan `h` holds
fun stated_of(p: *project.Project, h: *PlanHeld) backend.Stated {
    var s: backend.Stated = backend.Stated{sections: h.sections_at.data, regions: h.regions_at.data};
    if (p.target_entry != nil) {
        val d: *manifest_model.TargetDef = ?p.target_entry.declared;
        s.target        = d.at;
        s.base          = d.base_from.at;
        s.stack_reserve = d.stack_reserve_from.at;
        s.stack_commit  = d.stack_commit_from.at;
    }
    val art: *manifest_model.ArtifactDef = p.config.artifact;
    if (art != nil) {
        s.kind      = art.kind_at;
        s.subsystem = art.subsystem_from.at;
        s.size      = art.size_at;
        if (!intern.str_is_nil(art.linkage)) { s.kind = art.linkage_from.at; }
    }
    ret s;
}

# the name the link gives the object mach makes of the image's stack
val STACK_INPUT: str = "the image's stack";

# mink's bound names of the start and the top of the stack's section
val STACK_START: str = "__run_start_.stack";
val STACK_TOP:   str = "__run_stop_.stack";

# the object holding the stack of an image whose target lays it as a section, from the
# target's `stack_reserve`. none where the image's headers record its stack or its loader
# gives it one, where the image lays its stack below its base, which mink places from the
# reserve, and where the target states no stack and no object refers to one. an image that
# refers to the stack's bounds and states no size is refused at the target's table, naming the
# key, since nothing but the manifest knows how much stack a bare machine has to give
fun image_stack(p: *project.Project, inputs: *Given, count: u32) res[opt[Object], fail.Fail] {
    if (backend.stacks_below_base(?p.target)) {
        val err_based: err[fail.Fail] = stack_whole(p, "laid out whole below the image's base", "the stack it lays out below the image's base");
        if (sel err_based.err) { ret res[opt[Object], fail.Fail].err{err_based.err}; }
        val reserve: u64 = p.target.stack_reserve;
        if (reserve != 0 && p.target.base != 0 && p.target.base != reserve) {
            val declared: *manifest_model.TargetDef = ?p.target_entry.declared;
            ret res[opt[Object], fail.Fail].err{fail.at(fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
                "{} is {} bytes and {} is {}, and an image whose stack lies below its base starts its data where the stack ends, so the two are one address. state only one of them",
                declared.stack_reserve_from.named, reserve, declared.base_from.named, p.target.base), declared.stack_reserve_from.at)};
        }
        ret res[opt[Object], fail.Fail].ok{opt[Object].none{}};
    }
    if (!backend.lays_stack(?p.target)) { ret res[opt[Object], fail.Fail].ok{opt[Object].none{}}; }
    val label:    str                       = target_label(p);
    val declared: *manifest_model.TargetDef = ?p.target_entry.declared;
    val size:     u64                       = p.target.stack_reserve;
    if (size == 0 && p.target.stack_commit == 0) {
        var o: u32 = 0;
        for (o < count) {
            if (backend.refers(inputs[o].object, STACK_TOP) || backend.refers(inputs[o].object, STACK_START)) {
                ret res[opt[Object], fail.Fail].err{fail.at(fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
                    "mach.toml: [target.{}] needs `stack_reserve`, because the image uses the bounds of the `{}` section, which holds its stack. state the stack's size in bytes as `stack_reserve`",
                    label, backend.STACK_SECTION), declared.at)};
            }
            o = o + 1;
        }
        ret res[opt[Object], fail.Fail].ok{opt[Object].none{}};
    }
    val err_whole: err[fail.Fail] = stack_whole(p, "a section laid out whole", "the `.stack` section it lays out");
    if (sel err_whole.err) { ret res[opt[Object], fail.Fail].err{err_whole.err}; }
    if (size == 0)         { ret res[opt[Object], fail.Fail].ok{opt[Object].none{}}; }
    val res_made: res[Object, fail.Fail] = backend.stack_object(?p.back, p.alloc, size);
    if (sel res_made.err) { ret res[opt[Object], fail.Fail].err{res_made.err}; }
    ret res[opt[Object], fail.Fail].ok{opt[Object].some{res_made.ok}};
}

# the stack an image lays out itself, as `laid`, is the whole stack, so a commit is refused,
# and `holder` keeps its top aligned, so `stack_reserve` is a multiple of STACK_ALIGN
fun stack_whole(p: *project.Project, laid: str, holder: str) err[fail.Fail] {
    val declared: *manifest_model.TargetDef = ?p.target_entry.declared;
    if (p.target.stack_commit != 0) {
        ret err[fail.Fail].err{fail.at(fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
            "{} cannot be stated for an image no loader maps, because its stack is {}. state its size as `stack_reserve`", declared.stack_commit_from.named, laid),
            declared.stack_commit_from.at)};
    }
    val size: u64 = p.target.stack_reserve;
    if (size % backend.STACK_ALIGN != 0) {
        ret err[fail.Fail].err{fail.at(fail.formatted_user(p.alloc, diagnostic_kind.TARGET_STACK_SIZE,
            "{} is {} bytes, and {} keeps its top aligned to {}. state a multiple of {}",
            declared.stack_reserve_from.named, size, holder, backend.STACK_ALIGN, backend.STACK_ALIGN), declared.stack_reserve_from.at)};
    }
    ret err[fail.Fail].ok{};
}

# the name the manifest declares the build's target under
fun target_label(p: *project.Project) str {
    val te: *project.TargetEntry = p.target_entry;
    if (te == nil) { ret "(unnamed)"; }
    ret intern.text(p.s.interner, te.name);
}

# how mink's link takes the input `li`: a file at its path, a framework mink finds by its
# bundle, or a library mink searches for by name as the one kind it must be, with no fallback
fun link_request(li: *input.Input) Request {
    var include: Include = Include.always{};
    if (li.include_referenced) { include = Include.referenced{}; }
    if (li.form == input.FILE) { ret Request.file{mink_input.File{path: li.text, include: include}}; }
    if (li.form == input.FRAMEWORK) {
        ret Request.library{mink_input.Wanted{form: mink_input.Form.framework{}, name: li.text, include: include, prefer: mink_input.Prefer.shared_first{}}};
    }
    var prefer: mink_input.Prefer = mink_input.Prefer.shared_only{};
    if (li.kind == input.STATIC) { prefer = mink_input.Prefer.static_only{}; }
    ret Request.library{mink_input.Wanted{form: mink_input.Form.system{}, name: li.text, include: include, prefer: prefer}};
}

# the objects every program of the build links: each unit's
pub fun object_count(p: *project.Project) u32 {
    ret project.unit_count(p);
}

# the build's objects as the link's inputs, in the link's order: the units' in the topological
# order of their modules
pub fun ordered_inputs(p: *project.Project) res[*Given, fail.Fail] {
    val count:    u32                  = object_count(p);
    val res_made: res[*Given, A.Error] = A.allocate[Given](p.alloc, count::usize + 1);
    if (sel res_made.err) { ret res[*Given, fail.Fail].err{fail.refused(res_made.err)}; }
    val err_filled: err[fail.Fail] = objects_into(p, res_made.ok);
    if (sel err_filled.err) {
        A.deallocate[Given](p.alloc, res_made.ok, count::usize + 1);
        ret res[*Given, fail.Fail].err{err_filled.err};
    }
    ret res[*Given, fail.Fail].ok{res_made.ok};
}

pub fun ordered_inputs_free(p: *project.Project, inputs: *Given) {
    A.deallocate[Given](p.alloc, inputs, object_count(p)::usize + 1);
}

# the build's objects in the link's order into `into`, which holds object_count of them
pub fun objects_into(p: *project.Project, into: *Given) err[fail.Fail] {
    val err_backs: err[fail.Fail] = cache.objects_back(p);
    if (sel err_backs.err) { ret err_backs; }
    var i: u32 = 0;
    for (i < project.unit_count(p)) {
        val m: *project.ModuleEntry = project.unit_module(p, i);
        if (m.object == nil) { ret err[fail.Fail].err{fail.message("a link requires every unit's current object")}; }
        into[i] = Given{name: input_name(p, m), object: m.object};
        i       = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# what the link calls the objects of module `m`: its source file, which outlives the link
pub fun input_name(p: *project.Project, m: *project.ModuleEntry) str {
    val opt_file: opt[*base_source.SourceFile] = base_source.get(p.s.sources, m.file_id);
    if (sel opt_file.some) { ret opt_file.some.path; }
    ret intern.text(p.s.interner, m.fqn);
}

# the name module m's test object goes to the link under, set apart from its object's
pub fun test_input_name(p: *project.Project, m: *project.ModuleEntry) res[str, fail.Fail] {
    val res_joined: res[str, fail.Fail] = diagnostic.join(p.alloc, input_name(p, m), " (tests)");
    if (sel res_joined.err) { ret res_joined; }
    val res_named: res[intern.StrId, A.Error] = intern.add(p.s.interner, res_joined.ok);
    str_free(p.alloc, res_joined.ok);
    if (sel res_named.err) { ret res[str, fail.Fail].err{fail.refused(res_named.err)}; }
    ret res[str, fail.Fail].ok{intern.text(p.s.interner, res_named.ok)};
}

# the inputs the unit links beyond its objects, in link order: the manifest's link entries,
# those its dependencies cascade, then the command line's. an input named twice is linked
# once, and each library registers the symbols it claims. a library the link makes from
# the claims the objects carry is no input of its own
pub fun external_inputs(p: *project.Project, unit: *build_plan.BuildUnit) res[Vector[input.Input], fail.Fail] {
    var links:  Vector[input.Input] = collections_vector.init[input.Input](p.alloc);
    var handed: bool                = false;
    fin {
        if (!handed) { collections_vector.dnit[input.Input](?links); }
    }
    val res_describes: res[bool, fail.Fail] = backend.describes_claims(?p.back, p.alloc);
    if (sel res_describes.err) { ret res[Vector[input.Input], fail.Fail].err{res_describes.err}; }
    val te: *project.TargetEntry = p.target_entry;
    if (te != nil) {
        var i: u32 = 0;
        for (i < te.lib_count) {
            val err_added: err[fail.Fail] = requirement_add(p, ?te.libs[i], res_describes.ok, ?links);
            if (sel err_added.err) { ret res[Vector[input.Input], fail.Fail].err{err_added.err}; }
            i = i + 1;
        }
    }
    var c: u32 = 0;
    for (c < p.config.cascade_lib_count) {
        val err_added: err[fail.Fail] = requirement_add(p, ?p.config.cascade_libs[c], res_describes.ok, ?links);
        if (sel err_added.err) { ret res[Vector[input.Input], fail.Fail].err{err_added.err}; }
        c = c + 1;
    }
    var t: usize = 0;
    for (t < unit.link_inputs.len) {
        val err_added: err[fail.Fail] = input_add(p, unit.link_inputs.data[t], ?links);
        if (sel err_added.err) { ret res[Vector[input.Input], fail.Fail].err{err_added.err}; }
        t = t + 1;
    }
    val err_keys: err[fail.Fail] = keys_distinct(p);
    if (sel err_keys.err) { ret res[Vector[input.Input], fail.Fail].err{err_keys.err}; }
    val err_pins: err[fail.Fail] = pins_linked(p, unit);
    if (sel err_pins.err) { ret res[Vector[input.Input], fail.Fail].err{err_pins.err}; }
    handed = true;
    ret res[Vector[input.Input], fail.Fail].ok{links};
}

# the link entries the unit's link takes: the manifest's, then those its dependencies cascade
fun entry_count(p: *project.Project) u32 {
    if (p.target_entry == nil) { ret p.config.cascade_lib_count; }
    ret p.target_entry.lib_count + p.config.cascade_lib_count;
}

fun entry_at(p: *project.Project, i: u32) *manifest_link.LinkRequirement {
    val te: *project.TargetEntry = p.target_entry;
    if (te == nil)        { ret ?p.config.cascade_libs[i]; }
    if (i < te.lib_count) { ret ?te.libs[i]; }
    ret ?p.config.cascade_libs[i - te.lib_count];
}

# no entry's key is the loader name of an entry under another key, so a pin names one entry
fun keys_distinct(p: *project.Project) err[fail.Fail] {
    val count: u32 = entry_count(p);
    var i:     u32 = 0;
    for (i < count) {
        val keyed: *manifest_link.LinkRequirement = entry_at(p, i);
        var j:     u32                            = 0;
        for (j < count) {
            val named: *manifest_link.LinkRequirement = entry_at(p, j);
            if (!intern.str_same(keyed.key, named.key) && intern.str_same(keyed.key, named.text)) {
                ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_LOADER_NAME_CONFLICT,
                    "the key of link entry '{}' is the loader name of link entry '{}'",
                    intern.text(p.s.interner, keyed.key), intern.text(p.s.interner, named.key))};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# every pinned import names an entry of the link by its key or a command-line library by its
# name, on every format, whether or not the format records the library
fun pins_linked(p: *project.Project, unit: *build_plan.BuildUnit) err[fail.Fail] {
    var k: usize = 0;
    for (k < p.linkage.imports.len) {
        val im: *linkage.Import = ?p.linkage.imports.data[k];
        k = k + 1;
        if (pin_answered(p, unit, im.lib)) { cnt; }
        val sym:   str = intern.text(p.s.interner, im.name);
        val lib:   str = intern.text(p.s.interner, im.lib);
        val count: u32 = entry_count(p);
        var i:     u32 = 0;
        for (i < count) {
            val req: *manifest_link.LinkRequirement = entry_at(p, i);
            if (intern.str_same(req.text, im.lib)) {
                val key: str = intern.text(p.s.interner, req.key);
                ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_IMPORT_LIBRARY,
                    "import '{}' is attributed to '{}', the loader name of link entry '{}'. #[library] names a link entry by its table key, so write #[library(\"{}\")]",
                    sym, lib, key, key)};
            }
            i = i + 1;
        }
        ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_IMPORT_LIBRARY,
            "import '{}' pinned to library '{}' not among the link's dependencies", sym, lib)};
    }
    ret err[fail.Fail].ok{};
}

# whether `lib` is the key of a link entry or the name of a command-line library
fun pin_answered(p: *project.Project, unit: *build_plan.BuildUnit, lib: intern.StrId) bool {
    val count: u32 = entry_count(p);
    var i:     u32 = 0;
    for (i < count) {
        val req: *manifest_link.LinkRequirement = entry_at(p, i);
        if (intern.str_same(req.key, lib)) { ret true; }
        i = i + 1;
    }
    val name: str   = intern.text(p.s.interner, lib);
    var t:    usize = 0;
    for (t < unit.link_inputs.len) {
        val li: *input.Input = ?unit.link_inputs.data[t];
        if (li.form == input.LIBRARY && str_equals(li.text, name)) { ret true; }
        t = t + 1;
    }
    ret false;
}

# the input a manifest link entry names joins `links`, its text held by the session's names,
# and the symbols it claims are registered as imported from its library. a library the link
# makes from its claim joins nothing, so nothing looks for a file of its name
fun requirement_add(p: *project.Project, req: *manifest_link.LinkRequirement, describes: bool, links: *Vector[input.Input]) err[fail.Fail] {
    if (claims.described(req, describes)) {
        val err_named: err[fail.Fail] = describable(p, req);
        if (sel err_named.err) { ret err_named; }
        ret register_link_claims(p, req);
    }
    val res_requirement_input: res[input.Input, fail.Fail] = build_plan.requirement_input(p.alloc, p.s.interner, p.req.project_root, req);
    if (sel res_requirement_input.err) { ret err[fail.Fail].err{res_requirement_input.err}; }
    var li: input.Input = res_requirement_input.ok;
    if (li.form == input.FILE) {
        val res_held: res[intern.StrId, A.Error] = intern.add(p.s.interner, li.text);
        str_free(p.alloc, li.text);
        if (sel res_held.err) { ret err[fail.Fail].err{fail.refused(res_held.err)}; }
        li.text = intern.text(p.s.interner, res_held.ok);
    }
    val err_claimed: err[fail.Fail] = register_link_claims(p, req);
    if (sel err_claimed.err) { ret err_claimed; }
    ret input_add(p, li, links);
}

# a library the link makes from its claim is refused where the target's format names no
# library by the name the manifest entry `req` writes, naming the entry, as the link
# would refuse it from whichever object first carries the claim
fun describable(p: *project.Project, req: *manifest_link.LinkRequirement) err[fail.Fail] {
    val name:      str                 = intern.text(p.s.interner, req.text);
    val err_named: err[mink_fail.Fail] = mink_formats.describable(p.back.target.format, View{data: name::*u8, len: str_len(name)});
    if (sel err_named.ok) { ret err[fail.Fail].ok{}; }
    val res_lead: res[str, types_string.StrError] = str_join(p.alloc, "link library '", intern.text(p.s.interner, req.key), "' is linked from its claim");
    if (sel res_lead.err) { ret err[fail.Fail].err{fail.str_refused(res_lead.err)}; }
    val refused: fail.Fail = backend.refused_by_mink(p.alloc, res_lead.ok, mink_fail.about(err_named.err, name));
    str_free(p.alloc, res_lead.ok);
    ret err[fail.Fail].err{refused};
}

# `li` joins `links` unless an input of its form and text is there already. one library named
# as both kinds is refused, as a link holds each input once
fun input_add(p: *project.Project, li: input.Input, links: *Vector[input.Input]) err[fail.Fail] {
    var i: usize = 0;
    for (i < links.len) {
        if (links.data[i].form == li.form && str_equals(links.data[i].text, li.text)) {
            if (links.data[i].kind != li.kind) {
                ret err[fail.Fail].err{fail.formatted_user(p.alloc, diagnostic_kind.LINK_INPUT_INVALID, "library '{}' is named both shared and static", li.text)};
            }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    val res_pushed: res[usize, A.Error] = collections_vector.push[input.Input](links, li);
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun register_link_claims(p: *project.Project, req: *manifest_link.LinkRequirement) err[fail.Fail] {
    var i: u32 = 0;
    for (i < req.symbol_count) {
        val res_link_name_for: res[intern.StrId, fail.Fail] = project.link_name_for(p, req.symbols[i]);
        if (sel res_link_name_for.err) {
            ret err[fail.Fail].err{res_link_name_for.err};
        }
        val sym:  intern.StrId = res_link_name_for.ok;
        val prev: intern.StrId = linkage.import_library(?p.linkage, sym);
        if (!intern.str_is_nil(prev)) {
            val had: intern.StrId = prev;
            if (!intern.str_same(had, req.key)) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_SYMBOL_CLAIM_CONFLICT,
                    claim_conflict_message(p, sym, had, req.key))};
            }
            i = i + 1;
            cnt;
        }
        val err_register_import_library: err[fail.Fail] = linkage.register_import_library(?p.linkage, sym, req.key, linkage.UNSTATED);
        if (sel err_register_import_library.err) { ret err_register_import_library; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun claim_conflict_message(p: *project.Project, sym: intern.StrId,
    first: intern.StrId, second: intern.StrId) res[str, fail.Fail] {
    val res_str_join: res[str, types_string.StrError] = str_join(p.alloc,
        "symbol '", intern.text(p.s.interner, sym), "' is claimed by link library '",
        intern.text(p.s.interner, first), "' and '", intern.text(p.s.interner, second),
        "'. a symbol may have only one providing library");
    if (sel res_str_join.err) { ret res[str, fail.Fail].err{fail.str_refused(res_str_join.err)}; }
    ret res[str, fail.Fail].ok{res_str_join.ok};
}

# every unit's object as a file input: each reached `obj/` when its unit completed
# (cache.object_written), and a module the cache restored was there already
pub fun object_inputs(p: *project.Project, destinations: *str, inputs_out: **contract.Input) err[fail.Fail] {
    val len: u32 = object_count(p);
    if (len == 0) {
        @inputs_out = nil;
        ret err[fail.Fail].ok{};
    }
    val res_inputs: res[*contract.Input, A.Error] = A.allocate[contract.Input](p.alloc, len::usize);
    if (sel res_inputs.err) { ret err[fail.Fail].err{fail.refused(res_inputs.err)}; }
    val inputs: *contract.Input = res_inputs.ok;
    var i:      u32             = 0;
    var filled: u32             = 0;
    var handed: bool            = false;
    fin {
        if (!handed) { inputs_dnit(p.alloc, inputs, filled, len); }
    }
    for (i < len) {
        val m: *project.ModuleEntry = project.unit_module(p, i);
        if (!m.object_away && !cache.restored(p, m)) { ret err[fail.Fail].err{fail.message("an object was not written when its unit completed")}; }
        val res_copied: res[str, A.Error] = str_dup(p.alloc, destinations[i]);
        if (sel res_copied.err) { ret err[fail.Fail].err{fail.refused(res_copied.err)}; }
        inputs[i] = contract.Input{file: res_copied.ok, data: nil, len: 0};
        filled    = i + 1;
        i         = i + 1;
    }
    handed      = true;
    @inputs_out = inputs;
    ret err[fail.Fail].ok{};
}

# release `n` object inputs and their array of `cap`; a nil array owns nothing
pub fun inputs_dnit(a: *A.Allocator, inputs: *contract.Input, n: u32, cap: u32) {
    if (inputs == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        if (inputs[i].file != nil) { A.deallocate[u8](a, inputs[i].file::*u8, (str_len(inputs[i].file) + 1)::usize); }
        i = i + 1;
    }
    if (cap > 0) { A.deallocate[contract.Input](a, inputs, cap::usize); }
}
