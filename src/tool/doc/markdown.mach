# the markdown renderer of the document model: GitHub-flavoured pages, one per module,
# one `README.md` per directory, and the project's page at the root
#
# a page's path is relative to the directory the reference is written in, and every
# link on it is relative to the page. anchors follow GitHub's rule for headings, a
# repeated heading on one page taking `-1`, `-2` and so on, and every page's anchors
# are planned before any page is written, so a link to another page's entry names
# the heading that page will carry. pages are plain markdown and ASCII: no HTML, no
# site-only syntax, and prose keeps `<`, `&` and `\` readable by a backslash, never an
# entity
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.base.fail;
use mach.base.growth;
use mach.tool.doc.model;

# one page: its path below the reference's directory and its text
pub rec Page {
    path: str;
    text: str;
}

# the text of one page as it is written; the first refusal of the allocator is latched
rec Out {
    a:      *A.Allocator;
    buf:    *u8;
    len:    usize;
    cap:    usize;
    failed: bool;
    fault:  A.Error;
}

# what a page heads: the anchor of each entry of each module, and the anchor each group of
# a module heads
rec Plan {
    anchors: Vector[Vector[str]];
    plain:   Vector[Vector[str]];
}

# the render's state: every allocation is the arena's, and the first refusal is latched
rec Renderer {
    a:    *A.Allocator;
    m:    *model.Project;
    plan: Plan;
    # the project root as seen from the reference's directory, ending in `/`
    root:   str;
    failed: bool;
    fault:  A.Error;
}

# every page of `m`
# ---
# a:    the arena the pages are built in
# m:    the model
# root: the project root as seen from the reference's directory, such as `../../`
# out:  receives the pages, the project's page first
# ret:  ok, or the allocator's refusal
pub fun render(a: *A.Allocator, m: *model.Project, root: str, out: *Vector[Page]) err[fail.Fail] {
    var r:  Renderer = Renderer{a: a, m: m, plan: Plan{anchors: collections_vector.init[Vector[str]](a), plain: collections_vector.init[Vector[str]](a)}, root: root, failed: false, fault: A.Error.exhausted{}};
    var mi: usize    = 0;
    for (mi < m.modules.len) {
        plan_module(?r, ?m.modules.data[mi]);
        mi = mi + 1;
    }
    var di: usize = 0;
    for (di < m.dirs.len) {
        var o: Out = out_make(a);
        dir_page(?r, ?o, di::u32);
        page_add(?r, out, dir_page_path(?r, ?m.dirs.data[di]), ?o);
        di = di + 1;
    }
    mi = 0;
    for (mi < m.modules.len) {
        if (m.modules.data[mi].declares) {
            var o: Out = out_make(a);
            module_page(?r, ?o, mi::u32);
            page_add(?r, out, join(?r, m.modules.data[mi].rel, ".md"), ?o);
        }
        mi = mi + 1;
    }
    if (r.failed) { ret err[fail.Fail].err{fail.refused(r.fault)}; }
    ret err[fail.Fail].ok{};
}

# latch the first refusal of the allocator
fun refuse(r: *Renderer, e: A.Error) {
    if (!r.failed) { r.fault = e; }
    r.failed = true;
}

# add the page `o` wrote at `path`, latching a refusal it met
fun page_add(r: *Renderer, out: *Vector[Page], path: str, o: *Out) {
    if (o.failed) { refuse(r, o.fault); }
    val res_pushed: res[usize, A.Error] = collections_vector.push[Page](out, Page{path: path, text: finish(o)});
    if (sel res_pushed.err) { refuse(r, res_pushed.err); }
}

# push `x` onto `v`, latching a refusal
fun keep[T](r: *Renderer, v: *Vector[T], x: T) {
    val res_pushed: res[usize, A.Error] = collections_vector.push[T](v, x);
    if (sel res_pushed.err) { refuse(r, res_pushed.err); }
}

fun out_make(a: *A.Allocator) Out {
    ret Out{a: a, buf: nil, len: 0, cap: 0, failed: false, fault: A.Error.exhausted{}};
}

# append `n` bytes from `p`, keeping room for the terminator, latching a refusal
fun put_n(o: *Out, p: *u8, n: usize) {
    if (o.failed || n == 0) { ret; }
    val err_grown: err[A.Error] = growth.reserve_usize[u8](o.a, ?o.buf, ?o.cap, o.len + n + 1);
    if (sel err_grown.err) {
        o.failed = true;
        o.fault  = err_grown.err;
        ret;
    }
    memory.raw_copy(?o.buf[o.len], p, n);
    o.len = o.len + n;
}

fun put(o: *Out, s: str) {
    put_n(o, s::*u8, str_len(s));
}

# append `n` in decimal
fun put_u32(o: *Out, n: u32) {
    var digits: [10]u8;
    var i:      usize = 10;
    var v:      u32   = n;
    for {
        i         = i - 1;
        digits[i] = '0' + (v % 10)::u8;
        v         = v / 10;
        if (v == 0) { brk; }
    }
    put_n(o, ?digits[i], 10 - i);
}

# the text written so far, terminated, "" when nothing was written
fun finish(o: *Out) str {
    if (o.buf == nil) { ret ""; }
    o.buf[o.len] = 0;
    ret o.buf::str;
}

# `x` then `y` in a new text
fun join(r: *Renderer, x: str, y: str) str {
    var o: Out = out_make(r.a);
    put(?o, x);
    put(?o, y);
    if (o.failed) { refuse(r, o.fault); }
    ret finish(?o);
}

# `../` once for each directory a path below the reference's directory descends
fun put_up(o: *Out, rel: str) {
    var i: usize = 0;
    for (rel[i] != 0) {
        if (rel[i] == '/') { put(o, "../"); }
        i = i + 1;
    }
}

# the directory part of `rel`, its length up to the last `/`, 0 for none
fun dir_len(rel: str) usize {
    var at: usize = 0;
    var i:  usize = 0;
    for (rel[i] != 0) {
        if (rel[i] == '/') { at = i; }
        i = i + 1;
    }
    ret at;
}

# a link from the page at `from` to the page at `to`, both below the reference's
# directory: the directories they share are stepped over
fun put_link(o: *Out, from: str, to: str) {
    val fd:   usize = dir_len(from);
    var pf:   usize = 0;
    var pt:   usize = 0;
    var rest: bool  = fd > 0;
    for (rest) {
        var ef: usize = pf;
        for (ef < fd && from[ef] != '/') { ef = ef + 1; }
        var et: usize = pt;
        for (to[et] != 0 && to[et] != '/') { et = et + 1; }
        if (to[et] != '/' || ef - pf != et - pt || !memory.raw_equal(?from[pf], ?to[pt], ef - pf)) { brk; }
        pt = et + 1;
        if (ef == fd) { rest = false; }
        or            { pf = ef + 1; }
    }
    if (rest) {
        put(o, "../");
        var j: usize = pf;
        for (j < fd) {
            if (from[j] == '/') { put(o, "../"); }
            j = j + 1;
        }
    }
    put(o, (?to[pt])::str);
}

# a GitHub heading slug: lowercase, spaces as `-`, every byte but letters, digits, `-`
# and `_` dropped, and `-n` after a slug the page has already issued
fun slug(r: *Renderer, seen: *Vector[str], heading: str) str {
    var o: Out   = out_make(r.a);
    var i: usize = 0;
    for (heading[i] != 0) {
        var c: u8 = heading[i];
        if (c >= 'A' && c <= 'Z')                                                                  { c = c + 32; }
        if (c == ' ')                                                                              { c = '-'; }
        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c >= 0x80) { put_n(?o, ?c, 1); }
        i = i + 1;
    }
    val base: str = finish(?o);
    var made: str = base;
    var n:    u32 = 0;
    for (listed(seen, made)) {
        n = n + 1;
        var s: Out = out_make(r.a);
        put(?s, base);
        put(?s, "-");
        put_u32(?s, n);
        made = finish(?s);
    }
    keep[str](r, seen, made);
    ret made;
}

fun listed(v: *Vector[str], s: str) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (str_equals(v.data[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the heading a group with no type carries
fun plain_title(k: model.Kind) str {
    if (k == model.KIND_FUN) { ret "Functions"; }
    if (k == model.KIND_VAL) { ret "Constants"; }
    if (k == model.KIND_VAR) { ret "Variables"; }
    ret "Forwards";
}

# whether an entry of kind `k` is shown in a table rather than under a heading of its own
fun tabled(k: model.Kind) bool {
    ret k == model.KIND_VAL || k == model.KIND_VAR;
}

# the anchors of a module page, in the order the page heads them: its title, each type and
# the functions grouped under it, then each plain group and its entries
fun plan_module(r: *Renderer, m: *model.Module) {
    var seen:    Vector[str] = collections_vector.init[str](r.a);
    var anchors: Vector[str] = collections_vector.init[str](r.a);
    var plain:   Vector[str] = collections_vector.init[str](r.a);
    var i:       usize       = 0;
    for (i < m.entries.len) {
        keep[str](r, ?anchors, "");
        i = i + 1;
    }
    slug(r, ?seen, m.path);
    var gi: usize = 0;
    for (gi < m.groups.len) {
        val g:    *model.Group = ?m.groups.data[gi];
        var head: str          = "";
        if (g.owner != model.NONE) {
            head                  = slug(r, ?seen, m.entries.data[g.owner].name);
            anchors.data[g.owner] = head;
        }
        or {
            head = slug(r, ?seen, plain_title(g.kind));
        }
        keep[str](r, ?plain, head);
        var k: usize = 0;
        for (k < g.members.len) {
            val e: u32 = g.members.data[k];
            if (tabled(m.entries.data[e].kind)) { anchors.data[e] = head; }
            or                                  { anchors.data[e] = slug(r, ?seen, m.entries.data[e].name); }
            k = k + 1;
        }
        gi = gi + 1;
    }
    keep[Vector[str]](r, ?r.plan.anchors, anchors);
    keep[Vector[str]](r, ?r.plan.plain, plain);
}

# prose with markdown's own escape before `<`, `&` and `\` outside code spans, so they
# read as written; in a table cell `|` is escaped and a line break is a space
fun put_prose(o: *Out, s: str, cell: bool) {
    var code: bool  = false;
    var i:    usize = 0;
    for (s[i] != 0) {
        val c: u8 = s[i];
        if (c == '`')          { code = !code; }
        if (cell && c == '|')  { put(o, "\\|"); }
        or (cell && c == '\n') { put(o, " "); }
        or (!code && (c == '<' || c == '&' || c == '\\')) {
            put(o, "\\");
            put_n(o, ?s[i], 1);
        }
        or { put_n(o, ?s[i], 1); }
        i = i + 1;
    }
}

# text as one code span, fenced by more backticks than it holds in a row, each run of
# layout one space; in a cell `|` is escaped
fun put_code(o: *Out, s: str, cell: bool) {
    var run:  usize = 0;
    var most: usize = 0;
    var i:    usize = 0;
    for (s[i] != 0) {
        if (s[i] == '`') { run = run + 1; }
        or               { run = 0; }
        if (run > most)  { most = run; }
        i = i + 1;
    }
    var f: usize = 0;
    for (f <= most) {
        put(o, "`");
        f = f + 1;
    }
    if (most > 0) { put(o, " "); }
    var space: bool = false;
    i = 0;
    for (s[i] != 0) {
        val c:      u8   = s[i];
        val layout: bool = c == ' ' || c == '\t' || c == '\n' || c == '\r';
        if (layout) {
            space = true;
        }
        or {
            if (space) { put(o, " "); }
            space = false;
            if (cell && c == '|') { put(o, "\\|"); }
            or                    { put_n(o, ?s[i], 1); }
        }
        i = i + 1;
    }
    if (most > 0) { put(o, " "); }
    f = 0;
    for (f <= most) {
        put(o, "`");
        f = f + 1;
    }
}

# source text as a page shows it: every import alias written as the module path it names
fun put_text(o: *Out, t: *model.Text) {
    var i: usize = 0;
    for (i < t.pieces.len) {
        val p: *model.Piece = ?t.pieces.data[i];
        if (str_len(p.path) > 0) { put(o, p.path); }
        or                       { put(o, p.text); }
        i = i + 1;
    }
}

# source text as a page shows it, as one string
fun text_of(r: *Renderer, t: *model.Text) str {
    var o: Out = out_make(r.a);
    put_text(?o, t);
    if (o.failed) { refuse(r, o.fault); }
    ret finish(?o);
}

# whether two texts read alike, a run of layout matching any other
fun text_same(r: *Renderer, x: *model.Text, y: *model.Text) bool {
    ret layout_same(text_of(r, x), text_of(r, y));
}

# whether two strings read alike, a run of layout matching any other
fun layout_same(x: str, y: str) bool {
    var i: usize = 0;
    var k: usize = 0;
    for {
        val sx: bool = is_layout(x[i]);
        val sy: bool = is_layout(y[k]);
        if (sx != sy) { ret false; }
        if (sx) {
            for (is_layout(x[i])) { i = i + 1; }
            for (is_layout(y[k])) { k = k + 1; }
            cnt;
        }
        if (x[i] != y[k]) { ret false; }
        if (x[i] == 0)    { ret true; }
        i = i + 1;
        k = k + 1;
    }
    ret true;
}

fun is_layout(c: u8) bool {
    ret c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

# every paragraph of a doc comment as prose, each followed by a blank line
fun put_doc_body(o: *Out, d: *model.Doc) {
    var i: usize = 0;
    for (i < d.paragraphs.len) {
        put_prose(o, d.paragraphs.data[i], false);
        put(o, "\n\n");
        i = i + 1;
    }
}

# whether module `mi` has a page: it exists and declares something
fun has_page(r: *Renderer, mi: u32) bool {
    ret mi != model.NONE && r.m.modules.data[mi].declares;
}

# the path of module `mi`'s page below the reference's directory
fun module_page_path(r: *Renderer, mi: u32) str {
    ret join(r, r.m.modules.data[mi].rel, ".md");
}

# a link to entry `e` of module `mi` from the page of module `from`
fun put_entry_link(r: *Renderer, o: *Out, from: u32, mi: u32, e: u32) {
    if (mi != from) { put_link(o, r.m.modules.data[from].rel, module_page_path(r, mi)); }
    put(o, "#");
    put(o, r.plan.anchors.data[mi].data[e]);
}

# whether an item of `items` before `i`, inside the same arms as item `i` above depth
# `d`, sits in the arm whose condition is `text` at depth `d`
fun arm_listed(items: *Vector[*Vector[model.Clause]], i: usize, d: usize, text: str) bool {
    val own: *Vector[model.Clause] = items.data[i];
    var j:   usize                 = 0;
    for (j < i) {
        val x:    *Vector[model.Clause] = items.data[j];
        var same: bool                  = x.len > d && str_equals(x.data[d].text, text);
        var k:    usize                 = 0;
        for (same && k < d) {
            same = clause_same(?x.data[k], ?own.data[k]);
            k    = k + 1;
        }
        if (same) { ret true; }
        j = j + 1;
    }
    ret false;
}

fun clause_same(x: *model.Clause, y: *model.Clause) bool {
    if (!str_equals(x.text, y.text) || x.prior.len != y.prior.len) { ret false; }
    var i: usize = 0;
    for (i < x.prior.len) {
        if (!str_equals(x.prior.data[i], y.prior.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the condition of item `i` of `items`, a run of arms shown together and tried in order, the
# first whose condition holds being taken: each arm's own condition, and of the earlier arms
# it excludes only those the run does not show before it, so a lone arm reads exactly and
# an arm of a whole chain reads as its own condition alone, the last bare one as otherwise.
# in a table cell `|` is escaped
fun put_cond(o: *Out, items: *Vector[*Vector[model.Clause]], i: usize, cap: bool, cell: bool) {
    val own:  *Vector[model.Clause] = items.data[i];
    var said: bool                  = false;
    var d:    usize                 = 0;
    for (d < own.len) {
        val c: *model.Clause = ?own.data[d];
        if (str_len(c.text) > 0) {
            if (said) { put(o, " and "); }
            or (cap)  { put(o, "Where "); }
            or        { put(o, "where "); }
            put_code(o, c.text, cell);
            said = true;
        }
        var missing: usize = 0;
        var k:       usize = 0;
        for (k < c.prior.len) {
            if (!arm_listed(items, i, d, c.prior.data[k])) { missing = missing + 1; }
            k = k + 1;
        }
        var n: usize = 0;
        k = 0;
        for (k < c.prior.len) {
            if (!arm_listed(items, i, d, c.prior.data[k])) {
                if (n > 0 && n + 1 == missing) { put(o, " nor "); }
                or (n > 0)                     { put(o, ", "); }
                or (said)                      { put(o, " and not "); }
                or (cap)                       { put(o, "Where not "); }
                or                             { put(o, "where not "); }
                put_code(o, c.prior.data[k], cell);
                said = true;
                n    = n + 1;
            }
            k = k + 1;
        }
        d = d + 1;
    }
    if (!said && cap) { put(o, "Otherwise"); }
    or (!said)        { put(o, "otherwise"); }
}

# the conditions of every arm of `arms`, as `put_cond` reads them
fun arm_items(r: *Renderer, arms: *Vector[model.Arm]) Vector[*Vector[model.Clause]] {
    var items: Vector[*Vector[model.Clause]] = collections_vector.init[*Vector[model.Clause]](r.a);
    var i:     usize                         = 0;
    for (i < arms.len) {
        keep[*Vector[model.Clause]](r, ?items, ?arms.data[i].clauses);
        i = i + 1;
    }
    ret items;
}

# a declaration's arms: a lone one after the sentence naming its condition, several after
# one line stating that the first whose condition holds is taken, each under its own
fun put_arms(r: *Renderer, o: *Out, arms: *Vector[model.Arm], values: bool) {
    var items: Vector[*Vector[model.Clause]] = arm_items(r, arms);
    if (arms.len > 1) { put(o, "Declared by the first of these arms whose condition holds.\n\n"); }
    var i: usize = 0;
    for (i < arms.len) {
        var arm: model.Arm = arms.data[i];
        if (!values) { arm.value = ""; }
        if (arms.len > 1) {
            put_cond(o, ?items, i, true, false);
            put(o, ":\n\n");
        }
        or (arm.clauses.len > 0) {
            put(o, "Only ");
            put_cond(o, ?items, i, false, false);
            put(o, ".\n\n");
        }
        put_block(o, ?arm);
        i = i + 1;
    }
}

# one declaration as a block: its decorators, as the source places them, and its signature
fun put_block(o: *Out, arm: *model.Arm) {
    put(o, "```mach\n");
    var i: usize = 0;
    for (i < arm.decorators.len) {
        put(o, arm.decorators.data[i]);
        put(o, "\n");
        i = i + 1;
    }
    put_text(o, ?arm.signature);
    if (str_len(arm.value) > 0) {
        put(o, " = ");
        put(o, arm.value);
    }
    put(o, "\n```\n\n");
}

# the entry's deprecation line, nothing when it is not deprecated
fun put_deprecation(o: *Out, e: *model.Entry) {
    if (!e.deprecated) { ret; }
    put(o, "**Deprecated:**");
    if (str_len(e.deprecation) > 0) {
        put(o, " ");
        put_prose(o, e.deprecation, true);
    }
    put(o, "\n\n");
}

# the element of an entry named `name`, nil when it has none
fun element_of(e: *model.Entry, name: str) *model.Element {
    var i: usize = 0;
    for (i < e.elements.len) {
        if (str_equals(e.elements.data[i].name, name)) { ret ?e.elements.data[i]; }
        i = i + 1;
    }
    ret nil;
}

# the component lines as a table: a function's parameters with `ret` as its returns row, or
# a type's fields or cases with their types
fun put_components(r: *Renderer, o: *Out, e: *model.Entry) {
    val cs: *Vector[model.Component] = ?e.doc.components;
    if (cs.len == 0) { ret; }
    val typed: bool = e.kind != model.KIND_FUN;
    if (e.kind == model.KIND_FUN) { put(o, "| Parameter | |\n| :--- | :--- |\n"); }
    or (e.kind == model.KIND_TAG) { put(o, "| Case | Payload | |\n| :--- | :--- | :--- |\n"); }
    or                            { put(o, "| Field | Type | |\n| :--- | :--- | :--- |\n"); }
    var i: usize = 0;
    for (i < cs.len) {
        val c: *model.Component = ?cs.data[i];
        put(o, "| ");
        if (!typed && str_equals(c.name, "ret")) { put(o, "**returns**"); }
        or                                       { put_code(o, c.name, true); }
        if (typed) {
            put(o, " | ");
            val el: *model.Element = element_of(e, c.name);
            if (el != nil && el.ty.pieces.len > 0) { put_code(o, text_of(r, ?el.ty), true); }
        }
        put(o, " | ");
        put_prose(o, c.text, true);
        put(o, " |\n");
        i = i + 1;
    }
    put(o, "\n");
}

# the keyword that declares an entry of kind `k`
fun kind_word(k: model.Kind) str {
    if (k == model.KIND_FUN) { ret "fun"; }
    if (k == model.KIND_REC) { ret "rec"; }
    if (k == model.KIND_UNI) { ret "uni"; }
    if (k == model.KIND_TAG) { ret "tag"; }
    if (k == model.KIND_DEF) { ret "def"; }
    if (k == model.KIND_VAL) { ret "val"; }
    if (k == model.KIND_VAR) { ret "var"; }
    ret "fwd";
}

# one way a `fwd` resolves: the forwards it passes through, the arms each is chosen under
# and the declaration it ends at, nil when the project does not document one
rec Leaf {
    hops:    Vector[*model.Provider];
    clauses: Vector[model.Clause];
    entry:   *model.Entry;
}

# every way provider `p` resolves, after the forwards `hops` under the arms `clauses`, a
# forward of a forward followed link by link
fun leaf_add(r: *Renderer, p: *model.Provider, hops: *Vector[*model.Provider], clauses: *Vector[model.Clause], out: *Vector[Leaf]) {
    var path:  Vector[*model.Provider] = collections_vector.init[*model.Provider](r.a);
    var under: Vector[model.Clause]    = collections_vector.init[model.Clause](r.a);
    var k:     usize                   = 0;
    for (k < hops.len) {
        keep[*model.Provider](r, ?path, hops.data[k]);
        k = k + 1;
    }
    keep[*model.Provider](r, ?path, p);
    k = 0;
    for (k < clauses.len) {
        keep[model.Clause](r, ?under, clauses.data[k]);
        k = k + 1;
    }
    k = 0;
    for (k < p.clauses.len) {
        keep[model.Clause](r, ?under, p.clauses.data[k]);
        k = k + 1;
    }
    var to: *model.Entry = nil;
    if (p.module != model.NONE && p.entry != model.NONE) { to = ?r.m.modules.data[p.module].entries.data[p.entry]; }
    if (to != nil && to.kind == model.KIND_FWD && path.len < 16) {
        var i: usize = 0;
        for (i < to.providers.len) {
            leaf_add(r, ?to.providers.data[i], ?path, ?under, out);
            i = i + 1;
        }
        ret;
    }
    if (to != nil && to.kind == model.KIND_FWD) { to = nil; }
    keep[Leaf](r, out, Leaf{hops: path, clauses: under, entry: to});
}

# a provider's path, linked to its entry or its module's page when the project has one
fun put_provider(r: *Renderer, o: *Out, from: u32, p: *model.Provider) {
    if (!has_page(r, p.module)) {
        put_code(o, p.target, false);
        ret;
    }
    put(o, "[");
    put_code(o, p.target, false);
    put(o, "](");
    if (p.entry != model.NONE) { put_entry_link(r, o, from, p.module, p.entry); }
    or                         { put_link(o, r.m.modules.data[from].rel, module_page_path(r, p.module)); }
    put(o, ")");
}

# the forwards a leaf passes through, each linked
fun put_hops(r: *Renderer, o: *Out, from: u32, l: *Leaf) {
    var k: usize = 0;
    for (k < l.hops.len) {
        if (k > 0) { put(o, ", which forwards "); }
        put_provider(r, o, from, l.hops.data[k]);
        k = k + 1;
    }
}

# the declaration every leaf of `all` ends at when they all read alike, else nil
fun alike(r: *Renderer, all: *Vector[Leaf]) *model.Entry {
    var first: *model.Entry = nil;
    var i:     usize        = 0;
    for (i < all.len) {
        val t: *model.Entry = all.data[i].entry;
        if (t == nil)                                 { ret nil; }
        if (first != nil && !entry_same(r, first, t)) { ret nil; }
        first = t;
        i     = i + 1;
    }
    ret first;
}

# a `fwd`'s body: the modules providing it, each under its condition when there are
# several, the forwarded declaration once when every provider's reads alike and under
# each provider when they differ, and its own doc or else the forwarded declaration's.
# a provider that is itself a forward is followed, and shown link by link only where
# what it leads to differs by platform
fun put_forward(r: *Renderer, o: *Out, from: u32, e: *model.Entry) {
    var per:  Vector[Vector[Leaf]] = collections_vector.init[Vector[Leaf]](r.a);
    var reps: Vector[*model.Entry] = collections_vector.init[*model.Entry](r.a);
    var one:  *model.Entry         = nil;
    var same: bool                 = true;
    var i:    usize                = 0;
    for (i < e.providers.len) {
        var hops:  Vector[*model.Provider] = collections_vector.init[*model.Provider](r.a);
        var under: Vector[model.Clause]    = collections_vector.init[model.Clause](r.a);
        var all:   Vector[Leaf]            = collections_vector.init[Leaf](r.a);
        leaf_add(r, ?e.providers.data[i], ?hops, ?under, ?all);
        val rep: *model.Entry = alike(r, ?all);
        if (rep == nil)               { same = false; }
        or (one == nil)               { one = rep; }
        or (!entry_same(r, one, rep)) { same = false; }
        keep[Vector[Leaf]](r, ?per, all);
        keep[*model.Entry](r, ?reps, rep);
        i = i + 1;
    }
    if (e.providers.len == 1 && e.providers.data[0].clauses.len == 0 && same) {
        put(o, "Forwards ");
        put_provider(r, o, from, ?e.providers.data[0]);
        put(o, ".\n\n");
        put_target(r, o, one);
    }
    or (same) {
        var items: Vector[*Vector[model.Clause]] = collections_vector.init[*Vector[model.Clause]](r.a);
        i = 0;
        for (i < e.providers.len) {
            keep[*Vector[model.Clause]](r, ?items, ?e.providers.data[i].clauses);
            i = i + 1;
        }
        if (e.providers.len == 1) {
            put(o, "Forwards ");
            put_provider(r, o, from, ?e.providers.data[0]);
            put(o, ", only ");
            put_cond(o, ?items, 0, false, false);
            put(o, ".\n\n");
        }
        or {
            put(o, "Forwards the first of these whose condition holds:\n\n");
            i = 0;
            for (i < e.providers.len) {
                put(o, "- ");
                put_provider(r, o, from, ?e.providers.data[i]);
                put(o, ", ");
                put_cond(o, ?items, i, false, false);
                put(o, "\n");
                i = i + 1;
            }
            put(o, "\n");
        }
        put_target(r, o, one);
    }
    or {
        var items: Vector[*Vector[model.Clause]] = collections_vector.init[*Vector[model.Clause]](r.a);
        var rows:  Vector[Leaf]                  = collections_vector.init[Leaf](r.a);
        i = 0;
        for (i < e.providers.len) {
            val p: *model.Provider = ?e.providers.data[i];
            if (reps.data[i] != nil) {
                var hops: Vector[*model.Provider] = collections_vector.init[*model.Provider](r.a);
                keep[*model.Provider](r, ?hops, p);
                keep[Leaf](r, ?rows, Leaf{hops: hops, clauses: p.clauses, entry: reps.data[i]});
            }
            or {
                var k: usize = 0;
                for (k < per.data[i].len) {
                    keep[Leaf](r, ?rows, per.data[i].data[k]);
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        i = 0;
        for (i < rows.len) {
            keep[*Vector[model.Clause]](r, ?items, ?rows.data[i].clauses);
            i = i + 1;
        }
        put(o, "Forwards the first of these whose condition holds, and they differ.\n\n");
        i = 0;
        for (i < rows.len) {
            val l: *Leaf = ?rows.data[i];
            put_cond(o, ?items, i, true, false);
            put(o, ": ");
            put_hops(r, o, from, l);
            put(o, ".\n\n");
            if (l.entry != nil) { put_target(r, o, l.entry); }
            i = i + 1;
        }
    }
    put_deprecation(o, e);
    if (str_len(e.doc.summary) > 0 || one == nil) { put_doc_body(o, ?e.doc); }
    or                                            { put_doc_body(o, ?one.doc); }
}

# a forwarded declaration: each of its arms with its decorators and signature, a
# binding's with its value
fun put_target(r: *Renderer, o: *Out, e: *model.Entry) {
    put_arms(r, o, ?e.arms, true);
}

# whether two declarations read alike: the same signatures in the same arms
fun entry_same(r: *Renderer, x: *model.Entry, y: *model.Entry) bool {
    if (x.arms.len != y.arms.len) { ret false; }
    var i: usize = 0;
    for (i < x.arms.len) {
        if (!text_same(r, ?x.arms.data[i].signature, ?y.arms.data[i].signature)) { ret false; }
        if (!layout_same(x.arms.data[i].value, y.arms.data[i].value))            { ret false; }
        i = i + 1;
    }
    ret true;
}

# the body of an entry under its heading
fun put_entry(r: *Renderer, o: *Out, from: u32, e: *model.Entry) {
    if (e.kind == model.KIND_FWD) {
        put_forward(r, o, from, e);
        ret;
    }
    put_arms(r, o, ?e.arms, false);
    put_deprecation(o, e);
    put_doc_body(o, ?e.doc);
    put_components(r, o, e);
}

# the table of bindings `members` holds: name, type unless the group is its type's, value
# under each arm, and summary
fun put_bindings(r: *Renderer, o: *Out, m: *model.Module, members: *Vector[u32], typed: bool) {
    var any: bool  = false;
    var k:   usize = 0;
    for (k < members.len) {
        val e: *model.Entry = ?m.entries.data[members.data[k]];
        if (tabled(e.kind)) {
            if (!any && typed)  { put(o, "| Name | Type | Value | |\n| :--- | :--- | :--- | :--- |\n"); }
            if (!any && !typed) { put(o, "| Name | Value | |\n| :--- | :--- | :--- |\n"); }
            any = true;
            put(o, "| ");
            put_code(o, e.name, true);
            if (e.kind == model.KIND_VAR) { put(o, " (var)"); }
            put(o, " | ");
            if (typed) {
                if (e.elements.len > 0) { put_code(o, text_of(r, ?e.elements.data[0].ty), true); }
                put(o, " | ");
            }
            var items: Vector[*Vector[model.Clause]] = arm_items(r, ?e.arms);
            var ai:    usize                         = 0;
            for (ai < e.arms.len) {
                val arm: *model.Arm = ?e.arms.data[ai];
                if (ai > 0)                 { put(o, "; "); }
                if (str_len(arm.value) > 0) { put_code(o, arm.value, true); }
                if (arm.clauses.len > 0 || e.arms.len > 1) {
                    put(o, " ");
                    put_cond(o, ?items, ai, false, true);
                }
                ai = ai + 1;
            }
            put(o, " | ");
            if (e.deprecated) {
                put(o, "**Deprecated:**");
                if (str_len(e.deprecation) > 0) {
                    put(o, " ");
                    put_prose(o, e.deprecation, true);
                }
                put(o, " ");
            }
            put_prose(o, e.doc.summary, true);
            put(o, " |\n");
        }
        k = k + 1;
    }
    if (any) { put(o, "\n"); }
}

# one row of the map per entry, a run of entries with no summary sharing one
fun put_map_rows(r: *Renderer, o: *Out, mi: u32, members: *Vector[u32]) {
    val m:    *model.Module = ?r.m.modules.data[mi];
    var open: bool          = false;
    var k:    usize         = 0;
    for (k < members.len) {
        val e:     *model.Entry = ?m.entries.data[members.data[k]];
        val blank: bool         = str_len(e.doc.summary) == 0;
        if (open && !blank) { put(o, " | |\n"); }
        if (open && blank)  { put(o, ", "); }
        or                  { put(o, "| "); }
        put(o, "[");
        put_code(o, e.name, true);
        put(o, "](");
        put_entry_link(r, o, mi, mi, members.data[k]);
        put(o, ")");
        open = blank;
        if (!blank) {
            put(o, " | ");
            put_prose(o, e.doc.summary, true);
            put(o, " |\n");
        }
        k = k + 1;
    }
    if (open) { put(o, " | |\n"); }
}

# the breadcrumb of a page in directory `dir`, `leaf` in bold at its end
fun put_crumbs(r: *Renderer, o: *Out, page_rel: str, dir: u32, leaf: str) {
    var chain: Vector[u32] = collections_vector.init[u32](r.a);
    var at:    u32         = dir;
    for (at != model.NONE) {
        keep[u32](r, ?chain, at);
        at = r.m.dirs.data[at].parent;
    }
    var i: usize = chain.len;
    for (i > 0) {
        i = i - 1;
        val d: *model.Dir = ?r.m.dirs.data[chain.data[i]];
        put(o, "[");
        if (str_len(d.rel) == 0) { put(o, r.m.id); }
        or                       { put(o, d.leaf); }
        put(o, "](");
        put_link(o, page_rel, dir_page_path(r, d));
        put(o, ") / ");
    }
    put(o, "**");
    put(o, leaf);
    put(o, "**\n\n");
}

# the path of a directory's page below the reference's directory
fun dir_page_path(r: *Renderer, d: *model.Dir) str {
    if (str_len(d.rel) == 0) { ret "README.md"; }
    ret join(r, d.rel, "/README.md");
}

# the page of module `mi`: its breadcrumb, doc, source link and the modules it uses, a map of
# its types and groups, then each group and entry under its heading
fun module_page(r: *Renderer, o: *Out, mi: u32) {
    val m:    *model.Module = ?r.m.modules.data[mi];
    val page: str           = module_page_path(r, mi);

    put_crumbs(r, o, page, m.dir, m.leaf);
    put(o, "# ");
    put(o, m.path);
    put(o, "\n\n");
    put_doc_body(o, ?m.doc);
    put(o, "Source: [`");
    put(o, m.file);
    put(o, "`](");
    put_up(o, page);
    put(o, r.root);
    put(o, m.file);
    put(o, ")\n\n");
    var said: bool  = false;
    var k:    usize = 0;
    for (k < m.mentions.len) {
        val to: u32 = m.mentions.data[k];
        if (has_page(r, to)) {
            if (said) { put(o, ", "); }
            or        { put(o, "Uses types from "); }
            said = true;
            put(o, "[`");
            put(o, r.m.modules.data[to].path);
            put(o, "`](");
            put_link(o, page, module_page_path(r, to));
            put(o, ")");
        }
        k = k + 1;
    }
    if (said) { put(o, ".\n\n"); }

    val plain: *Vector[str] = ?r.plan.plain.data[mi];
    var types: bool         = false;
    var gi:    usize        = 0;
    for (gi < m.groups.len) {
        val g: *model.Group = ?m.groups.data[gi];
        if (g.owner != model.NONE) {
            if (!types) { put(o, "| Type | | |\n| :--- | :--- | :--- |\n"); }
            types = true;
            val e: *model.Entry = ?m.entries.data[g.owner];
            put(o, "| [");
            put_code(o, e.name, true);
            put(o, "](#");
            put(o, plain.data[gi]);
            put(o, ") | `");
            put(o, kind_word(e.kind));
            put(o, "` | ");
            put_prose(o, e.doc.summary, true);
            put(o, " |\n");
        }
        gi = gi + 1;
    }
    if (types) { put(o, "\n"); }
    gi = 0;
    for (gi < m.groups.len) {
        val g: *model.Group = ?m.groups.data[gi];
        if (g.members.len > 0) {
            if (g.owner != model.NONE) {
                put(o, "| On ");
                put_code(o, m.entries.data[g.owner].name, true);
            }
            or {
                put(o, "| ");
                put(o, plain_title(g.kind));
            }
            put(o, " | |\n| :--- | :--- |\n");
            put_map_rows(r, o, mi, ?g.members);
            put(o, "\n");
        }
        gi = gi + 1;
    }
    if (m.entries.len > 0) { put(o, "---\n\n"); }

    gi = 0;
    for (gi < m.groups.len) {
        val g: *model.Group = ?m.groups.data[gi];
        put(o, "## ");
        if (g.owner != model.NONE) {
            put(o, m.entries.data[g.owner].name);
            put(o, "\n\n");
            put_entry(r, o, mi, ?m.entries.data[g.owner]);
        }
        or {
            put(o, plain_title(g.kind));
            put(o, "\n\n");
        }
        put_bindings(r, o, m, ?g.members, g.owner == model.NONE);
        k = 0;
        for (k < g.members.len) {
            val e: *model.Entry = ?m.entries.data[g.members.data[k]];
            if (!tabled(e.kind)) {
                put(o, "### ");
                put(o, e.name);
                put(o, "\n\n");
                put_entry(r, o, mi, e);
            }
            k = k + 1;
        }
        gi = gi + 1;
    }
}

# a table of the modules with pages: each linked from the page at `page`, with its summary
fun put_module_rows(r: *Renderer, o: *Out, page: str, modules: *Vector[u32]) {
    var any: bool  = false;
    var i:   usize = 0;
    for (i < modules.len) {
        if (has_page(r, modules.data[i])) {
            val m: *model.Module = ?r.m.modules.data[modules.data[i]];
            if (!any) { put(o, "| Module | |\n| :--- | :--- |\n"); }
            any = true;
            put(o, "| [`");
            put(o, m.leaf);
            put(o, "`](");
            put_link(o, page, module_page_path(r, modules.data[i]));
            put(o, ") | ");
            put_prose(o, m.doc.summary, true);
            put(o, " |\n");
        }
        i = i + 1;
    }
    if (any) { put(o, "\n"); }
}

# a table of directories, each linked from the page at `page`, with its root module's summary
fun put_dir_rows(r: *Renderer, o: *Out, page: str, dirs: *Vector[u32]) {
    if (dirs.len == 0) { ret; }
    put(o, "| Directory | |\n| :--- | :--- |\n");
    var i: usize = 0;
    for (i < dirs.len) {
        val d: *model.Dir = ?r.m.dirs.data[dirs.data[i]];
        put(o, "| [`");
        put(o, d.leaf);
        put(o, "/`](");
        put_link(o, page, dir_page_path(r, d));
        put(o, ") | ");
        if (d.root != model.NONE) { put_prose(o, r.m.modules.data[d.root].doc.summary, true); }
        put(o, " |\n");
        i = i + 1;
    }
    put(o, "\n");
}

# the page of directory `di`. the root's page names the project, its version, artifacts,
# directories, modules and dependencies, and any other names the directory and its root module
fun dir_page(r: *Renderer, o: *Out, di: u32) {
    val d:    *model.Dir = ?r.m.dirs.data[di];
    val page: str        = dir_page_path(r, d);

    if (di == 0) {
        put(o, "# ");
        put(o, r.m.id);
        put(o, "\n\nVersion ");
        put(o, r.m.version);
        put(o, ".\n\n");
        if (r.m.artifacts.len > 0) {
            put(o, "| Artifact | Kind | Entry |\n| :--- | :--- | :--- |\n");
            var ai: usize = 0;
            for (ai < r.m.artifacts.len) {
                val art: *model.Artifact = ?r.m.artifacts.data[ai];
                put(o, "| ");
                put_code(o, art.name, true);
                put(o, " | ");
                put_code(o, art.kind, true);
                put(o, " | ");
                if (has_page(r, art.module)) {
                    put(o, "[");
                    put_code(o, art.entry, true);
                    put(o, "](");
                    put_link(o, page, module_page_path(r, art.module));
                    put(o, ")");
                }
                or {
                    put_code(o, art.entry, true);
                }
                put(o, " |\n");
                ai = ai + 1;
            }
            put(o, "\n");
        }
        put_dir_rows(r, o, page, ?d.dirs);
        put_module_rows(r, o, page, ?d.modules);
        if (r.m.deps.len > 0) {
            put(o, "Depends on ");
            var k: usize = 0;
            for (k < r.m.deps.len) {
                if (k > 0) { put(o, ", "); }
                put_code(o, r.m.deps.data[k], false);
                k = k + 1;
            }
            put(o, ".\n");
        }
        ret;
    }

    put_crumbs(r, o, page, d.parent, d.leaf);
    put(o, "# ");
    put(o, r.m.id);
    put(o, ".");
    var i: usize = 0;
    for (d.rel[i] != 0) {
        if (d.rel[i] == '/') { put(o, "."); }
        or                   { put_n(o, ?d.rel[i], 1); }
        i = i + 1;
    }
    put(o, "\n\n");
    if (d.root != model.NONE) {
        put_doc_body(o, ?r.m.modules.data[d.root].doc);
        if (has_page(r, d.root)) {
            val root: *model.Module = ?r.m.modules.data[d.root];
            put(o, "The directory's root module is [`");
            put(o, root.path);
            put(o, "`](");
            put_link(o, page, module_page_path(r, d.root));
            put(o, ").\n\n");
        }
    }
    put_module_rows(r, o, page, ?d.modules);
    put_dir_rows(r, o, page, ?d.dirs);
}
