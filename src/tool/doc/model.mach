# the document model `mach doc` renders: one project, its directories, its modules
# and the entries each module exports
#
# the model is the contract between the builder (`mach.tool.doc.build`) and a
# renderer (`mach.tool.doc.markdown`). it holds what the source declares and how
# the declarations relate, as text taken verbatim from the source's syntax tree, and
# nothing of how a page shows it: headings, anchors, links and escaping are a
# renderer's. modules are ordered by path and directories by path, the project's
# root directory first; entries are in source order. every string and vector lives
# in the arena the model was built in
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.string.str;

# an absent index
pub val NONE: u32 = 0xFFFFFFFF;

# what an entry declares
pub def Kind: u8;

pub val KIND_FUN: Kind = 0;
pub val KIND_REC: Kind = 1;
pub val KIND_UNI: Kind = 2;
pub val KIND_TAG: Kind = 3;
pub val KIND_DEF: Kind = 4;
pub val KIND_VAL: Kind = 5;
pub val KIND_VAR: Kind = 6;
pub val KIND_FWD: Kind = 7;

# one component line of a doc comment: the name as written (`x`, `$order`, `[T]`, `ret`)
# and its description
pub rec Component {
    name: str;
    text: str;
}

# a doc comment without its comment marks: its summary, the first sentence of its first
# paragraph as `mach.front.doc.summary_len` reads it, every paragraph of its prose, the
# first included, and its components; all empty when there is none
pub rec Doc {
    summary:    str;
    paragraphs: Vector[str];
    components: Vector[Component];
}

# one `$if` or `$or` arm a declaration sits in: its condition as written, "" for a
# final bare `$or`, and the conditions of the arms before it in its chain, none of
# which holds where it applies
pub rec Clause {
    text:  str;
    prior: Vector[str];
}

# one declaration of an entry
# ---
# clauses:    the arms it sits in, outermost first; none at the top level
# decorators: each `#[...]` as written but `#[deprecated]`, which is the entry's deprecation
# signature:  the declaration as written without its decorators: a function without its
#             body, a record, union or tag with its fields or cases, a `def` with its base,
#             a binding without its value, a `fwd` with its path
# value:      a binding's initializer as written, "" for every other kind
pub rec Arm {
    clauses:    Vector[Clause];
    decorators: Vector[str];
    signature:  str;
    value:      str;
}

# an element a component line can document: a parameter (`$name` when it is comptime), a
# generic (`[T]`), a field or a case, with its type as written, "" for a generic or a
# case with no payload; a binding's one element is itself, with its declared type
pub rec Element {
    name: str;
    ty:   str;
}

# a name an entry's types use that the reader cannot look up on the page: an import
# alias with the module path it names and that module's index when the project has it,
# or a type this module keeps private (target "", module NONE)
pub rec Alias {
    name:    str;
    target:  str;
    module:  u32;
    private: bool;
}

# what a `fwd` forwards, as name resolution decided it for the target analyzed
# ---
# resolved: resolution decided the target; false when the arms that declare it were not
#           selected, and every other field is then empty
# whole:    it forwards a whole module
# target:   the target's module path, then `.name` unless it is a whole module
# module:   the target's module when the project has it, else NONE
# entry:    the target's entry in that module, NONE for a whole module or one not there
pub rec Forward {
    resolved: bool;
    whole:    bool;
    target:   str;
    module:   u32;
    entry:    u32;
}

# one public name of a module
# ---
# external:    an `ext fun`
# doc:         its own doc comment, or else that of an arm declaring it, or else that of
#              the `$if` around it
# deprecation: the message of `#[deprecated]`, "" without one; deprecated says it is there
# arms:        one per declaration, in source order: a name several `$if` arms declare is
#              one entry
# elements:    what its first declaration's component lines can name
# aliases:     what its declarations' types name through an import or privately, in order
#              of first use
# owner:       the type entry it is grouped under, NONE for none
pub rec Entry {
    name:        str;
    kind:        Kind;
    external:    bool;
    doc:         Doc;
    deprecated:  bool;
    deprecation: str;
    arms:        Vector[Arm];
    elements:    Vector[Element];
    aliases:     Vector[Alias];
    forward:     Forward;
    owner:       u32;
}

# the entries shown together: a type with the functions and constants that belong to it
# (owner is the type's entry), or the entries of one kind that belong to no type (owner
# NONE, kind theirs); members in source order
pub rec Group {
    owner:   u32;
    kind:    Kind;
    members: Vector[u32];
}

# one module of the project
# ---
# path:      its dotted path, `mach.base.intern`
# rel:       its path below the project, `base/intern`
# leaf:      its last segment
# file:      its source file relative to the project root
# dir:       the directory holding it
# groups:    every type first, in declaration order, then what belongs to no type: functions,
#            constants, variables, forwards
# imports:   the project's modules it imports, by index, ascending
# importers: the project's modules importing it, ascending
pub rec Module {
    path:      str;
    rel:       str;
    leaf:      str;
    file:      str;
    dir:       u32;
    doc:       Doc;
    entries:   Vector[Entry];
    groups:    Vector[Group];
    imports:   Vector[u32];
    importers: Vector[u32];
}

# one directory of the project's source tree
# ---
# rel:       its path below the project, "" for the root
# leaf:      its last segment
# parent:    the directory holding it, NONE for the root
# root:      its root module, the file beside it of the same name, NONE when it has none
# modules:   the modules directly in it
# dirs:      the directories directly in it
# total:     the modules in it and below it
# imports:   the other top-level directories its modules import, by index
# importers: the other top-level directories whose modules import its modules
pub rec Dir {
    rel:       str;
    leaf:      str;
    parent:    u32;
    root:      u32;
    modules:   Vector[u32];
    dirs:      Vector[u32];
    total:     u32;
    imports:   Vector[u32];
    importers: Vector[u32];
}

# one artifact of the manifest: its kind as the manifest spells it, the path of its entry
# module and that module's index, NONE when it is not documented
pub rec Artifact {
    name:   str;
    kind:   str;
    entry:  str;
    module: u32;
}

# the whole project: its id and version, its artifacts in manifest order, the ids of its
# dependencies, every module some artifact reaches, and every directory holding one
pub rec Project {
    id:        str;
    version:   str;
    artifacts: Vector[Artifact];
    deps:      Vector[str];
    modules:   Vector[Module];
    dirs:      Vector[Dir];
}

# whether an entry of kind `k` is a type
pub fun is_type(k: Kind) bool {
    ret k == KIND_REC || k == KIND_UNI || k == KIND_TAG || k == KIND_DEF;
}
