# a project written for the previous major, rewritten into this one's spelling,
# which `mach migrate` applies
#
# a renamed spelling is data its owner already holds: a manifest key a major
# removed or retired is a row of the manifest schema with a rewrite, a target
# value's retired spelling is a row of the target reader's, a template variable's
# previous name is a row of the template's renamed table, a comptime path's is a
# row of the comptime path registry's, a decorator's is a row of the decorator
# registry's, and an `asm` head's, a truth alias's and a step option's are rows
# of the transition table's. so a name a later major retires is migrated by the
# row that retires it, and no rule here spells one
#
# what changed meaning rather than spelling has no owner's row, so its rule here
# names what it reads: `[project].mach` for the range, a step's `argv` for which
# step runs mach, `[project].out` and each artifact's `out` for the output a
# previous major rooted, a freestanding target's `isa` and `of` for the machine and
# the format a previous major assumed, a profile's `allow` for warnings no build
# raises any more, a dependency's `[artifact.*]` `export`, `default`, `kind` and
# `entry` for the module a bare `use` bound, an artifact's `default` and `kind` for the
# library whose `need` travelled, and its `kind` and `targets` for a spir-v module
#
# the rules are rows themselves, each tagged with the major it migrates from. a
# release carries the rows of the major before it: 8.0.0 deletes every row tagged
# 6 and adds its own
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.string.str_starts_with;
use toml_error:  toml.error;
use toml_lookup: toml.lookup;
use toml_parse:  toml.parse;
use toml_tree:   toml.tree;
use toml_value:  toml.value;

use A: std.allocator;

use mach.base.diagnostic;
use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use base_source: mach.base.source;
use mach.base.version;
use compile_closure: mach.compile.closure;
use comptime_path:   mach.front.comptime.path;
use mach.front.decorator;
use mach.front.lexer;
use mach.front.lexis;
use mach.front.token;
use mach.front.transition;
use manifest_load: mach.manifest.load;
use mach.manifest.schema;
use mach.manifest.schema.Fix;
use manifest_target: mach.manifest.target;
use mach.manifest.template;
use mach_target: mach.target;
use target_tags: mach.target.tags;
use mink_fail:   mink.base.fail;
use mink_output: mink.catalog.output;
use mink.catalog.output.Spelled;

# the deepest comptime path a source names that the rewrite reads
val MAX_SEGMENTS: usize = 16;

# the major this release migrates from
pub val FROM_MAJOR: u32 = 6;

# a dependency in the root project's closure, as `mach migrate` reads it
# ---
# id:     its key under `[dep]`
# range:  its `[project].mach`, nil when dep/ holds no manifest for it
# module: the module its exported artifact's entry is, nil when it exports none
pub rec Dependency {
    id:     str;
    range:  str;
    module: str;
}

# one pass over a source, called with each token's index
# ---
# a:      owns the text a fix writes
# text:   the source
# stream: its tokens
# fixes:  the rewrites made so far
# deps:   the root project's dependencies
rec Walk {
    a:      *A.Allocator;
    text:   str;
    stream: *lexer.TokenStream;
    fixes:  *Vector[Fix];
    deps:   *Vector[Dependency];
}

# a rule over a source's tokens
# ---
# from:  the major it migrates from
# apply: what it does at a token
rec SourceRule {
    from:  u32;
    apply: fun(*Walk, usize) err[fail.Fail];
}

val SOURCE_RULE_COUNT: usize                         = 5;
val SOURCE_RULES:      [SOURCE_RULE_COUNT]SourceRule = [SOURCE_RULE_COUNT]SourceRule{
    SourceRule{from: 6, apply: rule_path},
    SourceRule{from: 6, apply: rule_decorator},
    SourceRule{from: 6, apply: rule_asm_head},
    SourceRule{from: 6, apply: rule_alias},
    SourceRule{from: 6, apply: rule_bare_use},
};

# a rule over a manifest
# ---
# from:  the major it migrates from
# apply: the fixes it makes of the document in `text`
rec ManifestRule {
    from:  u32;
    apply: fun(*A.Allocator, str, *toml_value.Table, *Vector[Fix]) err[fail.Fail];
}

val MANIFEST_RULE_COUNT: usize                             = 10;
val MANIFEST_RULES:      [MANIFEST_RULE_COUNT]ManifestRule = [MANIFEST_RULE_COUNT]ManifestRule{
    ManifestRule{from: 6, apply: rule_keys},
    ManifestRule{from: 6, apply: rule_targets},
    ManifestRule{from: 6, apply: rule_templates},
    ManifestRule{from: 6, apply: rule_range},
    ManifestRule{from: 6, apply: rule_step_flags},
    ManifestRule{from: 6, apply: rule_rooted_out},
    ManifestRule{from: 6, apply: rule_freestanding},
    ManifestRule{from: 6, apply: rule_retired_allow},
    ManifestRule{from: 6, apply: rule_default_export},
    ManifestRule{from: 6, apply: rule_finished_module},
};

# a manifest's text in this major's spelling: each key the schema retires with
# a rewrite rewritten, and each template variable a previous major named
# renamed wherever a string writes it. a text that is not TOML is refused, and
# one already in this spelling comes back unchanged
# ---
# a:    owns the returned text
# text: the manifest's text
# ret:  the rewritten text, owned by `a`
pub fun manifest(a: *A.Allocator, text: str) res[str, fail.Fail] {
    val res_parsed: res[toml_value.Table, toml_error.TomlError] = toml_parse.parse(a, text);
    if (sel res_parsed.err) { ret res[str, fail.Fail].err{fail.toml_refused(res_parsed.err)}; }
    var doc: toml_value.Table = res_parsed.ok;
    fin { toml_tree.dnit(a, ?doc); }
    var fixes: Vector[Fix] = collections_vector.init[Fix](a);
    fin { collections_vector.dnit[Fix](?fixes); }
    var r: usize = 0;
    for (r < MANIFEST_RULE_COUNT) {
        if (MANIFEST_RULES[r].from == FROM_MAJOR) {
            val err_applied: err[fail.Fail] = MANIFEST_RULES[r].apply(a, text, ?doc, ?fixes);
            if (sel err_applied.err) { ret res[str, fail.Fail].err{err_applied.err}; }
        }
        r = r + 1;
    }
    var i: usize = 0;
    for (i < fixes.len) {
        whole_line(text, ?fixes.data[i]);
        i = i + 1;
    }
    ret splice(a, text, ?fixes);
}

# each key the schema retires with a rewrite
fun rule_keys(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val err_keyed: err[A.Error] = schema.rewrites(a, doc, fixes);
    if (sel err_keyed.err) { ret err[fail.Fail].err{fail.refused(err_keyed.err)}; }
    var k: usize = 0;
    for (k < fixes.len) {
        aligned(text, ?fixes.data[k]);
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# each target spelling the previous major wrote that the target reader retires with a rewrite
fun rule_targets(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    ret manifest_target.rewrites(a, doc, fixes);
}

# each template variable a previous major named
fun rule_templates(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val err_renamed: err[A.Error] = templates_in(text, doc, fixes);
    if (sel err_renamed.err) { ret err[fail.Fail].err{fail.refused(err_renamed.err)}; }
    ret err[fail.Fail].ok{};
}

# the major this compiler is, the leading digits of its version
fun running_major() u32 {
    var major: u32   = 0;
    var i:     usize = 0;
    for (version.MACH_VERSION[i] >= '0' && version.MACH_VERSION[i] <= '9') {
        major = major * 10 + (version.MACH_VERSION[i] - '0')::u32;
        i     = i + 1;
    }
    ret major;
}

# a `[project].mach` range on the major before the running compiler's, replaced inside its
# quotes by the range `mach init` writes. a range the compiler admits is left as written, and
# any other is a project this release does not migrate, refused before anything is written
fun rule_range(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    if (running_major() <= FROM_MAJOR) { ret err[fail.Fail].ok{}; }
    val opt_range: opt[*toml_value.Value] = toml_lookup.get(doc, "project.mach");
    if (sel opt_range.none)                           { ret err[fail.Fail].ok{}; }
    if (opt_range.some.tag != toml_value.TYPE_STRING) { ret err[fail.Fail].ok{}; }
    val range: str = opt_range.some.data.string;
    if (!on_previous_major(range)) {
        if (compile_closure.compiler_admitted(range)) { ret err[fail.Fail].ok{}; }
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.MACH_VERSION_UNACCEPTED, "this project requires mach {}, and mach migrate moves a project from mach {}. migrate it with mach {} first", range, FROM_MAJOR, FROM_MAJOR)};
    }
    val res_floor: res[str, std_format.FormatError] = compile_closure.running_mach_range_floor(a);
    if (sel res_floor.err) { ret err[fail.Fail].err{fail.format_refused(res_floor.err)}; }
    ret string_fix(text, opt_range.some.span, res_floor.ok, fixes);
}

# a fix of the bytes inside the quotes of the string literal at `span`, written as `to`
fun string_fix(text: str, span: toml_value.Span, to: str, fixes: *Vector[Fix]) err[fail.Fail] {
    val start:  usize = string_start(text, span);
    var quotes: usize = 1;
    if (start - span.at > 1) { quotes = 3; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: start, len: span.at + span.len - quotes - start, text: to, pad: 0});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the number the `len` digits of `text` at `at` spell
fun major_at(text: str, at: usize, len: usize) u32 {
    var major: u32   = 0;
    var i:     usize = 0;
    for (i < len) {
        major = major * 10 + (text[at + i] - '0')::u32;
        i     = i + 1;
    }
    ret major;
}

# whether a dependency's `[project].mach` range stands on the major this release migrates
pub fun on_previous_major(range: str) bool {
    var at: usize = 0;
    for (range[at] != 0 && (range[at] < '0' || range[at] > '9')) { at = at + 1; }
    var len: usize = 0;
    for (range[at + len] >= '0' && range[at + len] <= '9') { len = len + 1; }
    ret len != 0 && major_at(range, at, len) == FROM_MAJOR;
}

# each dependency in the closure of the manifest `text`, whose project is at `root`, as dep/
# holds it: its own `[dep]`, then each `[dep]` of a manifest dep/ holds for one, which the
# flat closure places in dep/ beside it
# ---
# a:       owns what `out` holds
# sources: receives the text of each dependency's manifest dep/ holds
# root:    the project's directory
# text:    its manifest's text
# out:     receives the dependencies
pub fun dependencies(a: *A.Allocator, sources: *base_source.SourceMap, root: str, text: str, out: *Vector[Dependency]) err[fail.Fail] {
    val res_parsed: res[toml_value.Table, toml_error.TomlError] = toml_parse.parse(a, text);
    if (sel res_parsed.err) { ret err[fail.Fail].err{fail.toml_refused(res_parsed.err)}; }
    var doc: toml_value.Table = res_parsed.ok;
    fin { toml_tree.dnit(a, ?doc); }
    val err_queued: err[fail.Fail] = dependencies_queued(a, ?doc, out);
    if (sel err_queued.err) { ret err_queued; }
    var i: usize = 0;
    for (i < out.len) {
        val err_read: err[fail.Fail] = dependency_read(a, sources, root, out, i);
        if (sel err_read.err) { ret err_read; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# each key of the manifest `doc`'s `[dep]` that `out` does not hold yet, added to it unread
fun dependencies_queued(a: *A.Allocator, doc: *toml_value.Table, out: *Vector[Dependency]) err[fail.Fail] {
    val opt_deps: opt[*toml_value.Table] = toml_lookup.get_table(doc, "dep");
    if (sel opt_deps.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_deps.some)) {
        val opt_key: opt[str] = toml_lookup.table_key(opt_deps.some, i);
        i = i + 1;
        if (sel opt_key.none)         { cnt; }
        if (holds(out, opt_key.some)) { cnt; }
        val res_copied: res[str, StrError] = str_copy_slice(a, opt_key.some, 0, str_len(opt_key.some));
        if (sel res_copied.err) { ret err[fail.Fail].err{fail.str_refused(res_copied.err)}; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Dependency](out, Dependency{id: res_copied.ok, range: nil, module: nil});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether `deps` holds the dependency `id`
fun holds(deps: *Vector[Dependency], id: str) bool {
    var i: usize = 0;
    for (i < deps.len) {
        if (str_equals(deps.data[i].id, id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what the manifest dep/ holds for the dependency `at` of `deps` says, its own dependencies
# queued after it. a dependency dep/ does not hold keeps nil
fun dependency_read(a: *A.Allocator, sources: *base_source.SourceMap, root: str, deps: *Vector[Dependency], at: usize) err[fail.Fail] {
    val id:       str                 = deps.data[at].id;
    val res_path: res[str, fail.Fail] = diagnostic.join(a, root, "/dep/", id, "/mach.toml");
    if (sel res_path.err) { ret err[fail.Fail].err{res_path.err}; }
    val res_read: res[manifest_load.Doc, fail.Fail] = manifest_load.doc_read(a, sources, res_path.ok);
    if (sel res_read.err) { ret err[fail.Fail].ok{}; }
    var held: manifest_load.Doc = res_read.ok;
    fin { manifest_load.doc_dnit(a, ?held); }
    val opt_range: opt[*toml_value.Value] = toml_lookup.get(?held.table, "project.mach");
    if (sel opt_range.some) {
        if (opt_range.some.tag == toml_value.TYPE_STRING) {
            val res_copied: res[str, StrError] = str_copy_slice(a, opt_range.some.data.string, 0, str_len(opt_range.some.data.string));
            if (sel res_copied.err) { ret err[fail.Fail].err{fail.str_refused(res_copied.err)}; }
            deps.data[at].range = res_copied.ok;
        }
    }
    val err_queued: err[fail.Fail] = dependencies_queued(a, ?held.table, deps);
    if (sel err_queued.err) { ret err_queued; }
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(?held.table, "artifact");
    if (sel opt_artifacts.none) { ret err[fail.Fail].ok{}; }
    val entry: str = exported_entry(opt_artifacts.some);
    if (entry == nil) { ret err[fail.Fail].ok{}; }
    val res_module: res[str, fail.Fail] = module_of(a, id, entry);
    if (sel res_module.err) { ret err[fail.Fail].err{res_module.err}; }
    deps.data[at].module = res_module.ok;
    ret err[fail.Fail].ok{};
}

# the entry of the artifact a bare `use` of a project bound in a previous major: the
# one it marks `export`, else a default library
fun exported_entry(artifacts: *toml_value.Table) str {
    var fallback: str   = nil;
    var i:        usize = 0;
    for (i < toml_lookup.table_len(artifacts)) {
        val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(artifacts, i);
        i = i + 1;
        if (sel opt_table_value.none)                          { cnt; }
        if (opt_table_value.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val row:       *toml_value.Table      = ?opt_table_value.some.data.table;
        val opt_entry: opt[*toml_value.Value] = toml_lookup.get(row, "entry");
        if (sel opt_entry.none)                           { cnt; }
        if (opt_entry.some.tag != toml_value.TYPE_STRING) { cnt; }
        if (flag_of(row, "export"))                       { ret opt_entry.some.data.string; }
        if (default_library(row))                         { fallback = opt_entry.some.data.string; }
    }
    ret fallback;
}

# whether `t` sets `key` to the boolean true
fun flag_of(t: *toml_value.Table, key: str) bool {
    val opt_key_entry: opt[*toml_value.Value] = toml_lookup.get(t, key);
    if (sel opt_key_entry.none) { ret false; }
    ret opt_key_entry.some.tag == toml_value.TYPE_BOOL && opt_key_entry.some.data.boolean;
}

# the output kind the artifact `t` states, none when its `kind` spells none
fun kind_of(t: *toml_value.Table) opt[Spelled] {
    val opt_kind: opt[str] = toml_lookup.get_str(t, "kind");
    if (sel opt_kind.none) { ret opt[Spelled].none{}; }
    val res_kind: res[Spelled, mink_fail.Fail] = mink_output.spelled(opt_kind.some);
    if (sel res_kind.err) { ret opt[Spelled].none{}; }
    ret opt[Spelled].some{res_kind.ok};
}

# whether the artifact `t` is a library marked `default = true`, which a previous major made
# its project's export surface
pub fun default_library(t: *toml_value.Table) bool {
    if (!flag_of(t, "default")) { ret false; }
    val opt_kind: opt[Spelled] = kind_of(t);
    ret sel opt_kind.some && mach_target.is_library(opt_kind.some);
}

# the module path of `entry`, a file under the source directory of the project `id`
fun module_of(a: *A.Allocator, id: str, entry: str) res[str, fail.Fail] {
    val res_joined: res[str, fail.Fail] = diagnostic.join(a, id, ".", entry);
    if (sel res_joined.err) { ret res_joined; }
    val path: *u8   = res_joined.ok::*u8;
    val len:  usize = str_len(res_joined.ok);
    var i:    usize = 0;
    for (i < len) {
        if (path[i] == '/') { path[i] = '.'; }
        i = i + 1;
    }
    # the entry's `.mach` is no part of the module's path
    if (len > 5) { path[len - 5] = 0; }
    ret res[str, fail.Fail].ok{res_joined.ok};
}

# the offset of `word` standing as a word in `text` from `at` to `end`, `end` when it does
# not: after a quote, a space or a path's `/`, and before a quote, a space or an `=`
pub fun word_in(text: str, at: usize, end: usize, word: str) usize {
    val len: usize = str_len(word);
    var i:   usize = at;
    for (i + len <= end) {
        var before: u8 = ' ';
        if (i > at) { before = text[i - 1]; }
        val after:  u8   = text[i + len];
        val opens:  bool = before == '"' || before == '\'' || before == ' ' || before == '\t' || before == '/';
        val closes: bool = i + len == end || after == '"' || after == '\'' || after == ' ' || after == '\t' || after == '=' || after == '\r';
        if (opens && closes && spells(text, i, word, len)) { ret i; }
        i = i + 1;
    }
    ret end;
}

# each option a previous major spelled otherwise in a step's `argv`, in a step that runs
# mach: another program's `--jobs` is its own
fun rule_step_flags(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val opt_steps: opt[*toml_value.Table] = toml_lookup.get_table(doc, "step");
    if (sel opt_steps.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_steps.some)) {
        val opt_step: opt[*toml_value.Value] = toml_lookup.table_value(opt_steps.some, i);
        i = i + 1;
        if (sel opt_step.none)                          { cnt; }
        if (opt_step.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val opt_argv: opt[*toml_value.Value] = toml_lookup.get(?opt_step.some.data.table, "argv");
        if (sel opt_argv.none)                          { cnt; }
        if (opt_argv.some.tag != toml_value.TYPE_ARRAY) { cnt; }
        val args: *toml_value.Array = ?opt_argv.some.data.array;
        if (!runs_mach(text, args)) { cnt; }
        var k: usize = 0;
        for (k < toml_lookup.array_len(args)) {
            val opt_arg: opt[*toml_value.Value] = toml_lookup.array_get(args, k);
            k = k + 1;
            if (sel opt_arg.none) { cnt; }
            var f: usize = 0;
            for (f < transition.FLAG_COUNT) {
                val row:  *transition.Flag = transition.flag_at(f);
                val end:  usize            = opt_arg.some.span.at + opt_arg.some.span.len;
                var from: usize            = opt_arg.some.span.at;
                f = f + 1;
                for (from < end) {
                    val found: usize = word_in(text, from, end, row.from);
                    if (found == end) { brk; }
                    val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: found, len: str_len(row.from), text: row.to, pad: 0});
                    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
                    from = found + str_len(row.from);
                }
            }
        }
    }
    ret err[fail.Fail].ok{};
}

# each artifact `out` of a manifest that writes the previous major's `[project].out`, which rooted
# every artifact `out` under it, written from `{project.work}` as this major's paths are. an `out`
# that names a `{project.` variable already, or whose leading bytes another rule rewrites, is left
# to it
fun rule_rooted_out(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val opt_root: opt[*toml_value.Value] = toml_lookup.get(doc, "project.out");
    if (sel opt_root.none) { ret err[fail.Fail].ok{}; }
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(doc, "artifact");
    if (sel opt_artifacts.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_artifacts.some)) {
        val opt_row: opt[*toml_value.Value] = toml_lookup.table_value(opt_artifacts.some, i);
        i = i + 1;
        if (sel opt_row.none)                          { cnt; }
        if (opt_row.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val opt_out: opt[*toml_value.Value] = toml_lookup.get(?opt_row.some.data.table, "out");
        if (sel opt_out.none)                                       { cnt; }
        if (opt_out.some.tag != toml_value.TYPE_STRING)             { cnt; }
        if (str_starts_with(opt_out.some.data.string, "{project.")) { cnt; }
        val start: usize = string_start(text, opt_out.some.span);
        if (rewritten(fixes, start, 1)) { cnt; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: start, len: 0, text: "{project.work}/", pad: 0});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# the instruction set a previous major gave a freestanding target of an architecture, which it
# wrote as `isa` and this major requires the target to state
# ---
# arch: the architecture
# isa:  its instruction set, as masc's catalog spells it
rec Floor {
    arch: str;
    isa:  str;
}

# x86_64 stood on SSE2, aarch64 on AdvSIMD, and riscv64 and riscv32 on the selections `riscv64`
# and `riscv32` meant, GC and IMAC
val FLOOR_COUNT: usize              = 4;
val FLOORS:      [FLOOR_COUNT]Floor = [FLOOR_COUNT]Floor{
    Floor{arch: "x86_64", isa: "x86-64"},
    Floor{arch: "aarch64", isa: "armv8-a+fp+simd"},
    Floor{arch: "riscv64", isa: "rv64gc"},
    Floor{arch: "riscv32", isa: "rv32imac"},
};

# each freestanding target a previous major wrote, which names no `arch`: its `isa` naming an
# architecture stood on that architecture's floor, which this major requires the target to
# state, and a target with no `of` was a flat image, where this major's default is elf. both
# are written on the line after its `isa`. a spir-v target's system is a retired spelling,
# which the target reader's rows rewrite
fun rule_freestanding(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val opt_targets: opt[*toml_value.Table] = toml_lookup.get_table(doc, "target");
    if (sel opt_targets.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_targets.some)) {
        val opt_entry: opt[*toml_value.Value] = toml_lookup.table_value(opt_targets.some, i);
        i = i + 1;
        if (sel opt_entry.none)                          { cnt; }
        if (opt_entry.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val sub:      *toml_value.Table      = ?opt_entry.some.data.table;
        val opt_arch: opt[*toml_value.Value] = toml_lookup.get(sub, "arch");
        val opt_isa:  opt[*toml_value.Value] = toml_lookup.get(sub, "isa");
        if (sel opt_arch.some)                           { cnt; }
        if (sel opt_isa.none)                            { cnt; }
        if (opt_isa.some.tag != toml_value.TYPE_STRING)  { cnt; }
        if (!str_equals(system_of(sub), "freestanding")) { cnt; }
        val written: str  = opt_isa.some.data.string;
        val floor:   str  = floor_of(written);
        val named:   bool = target_tags.arch_named(written) != target_tags.NONE;
        if (named && floor == nil) { cnt; }
        var add: str = "";
        if (floor != nil) {
            val res_isa: res[str, fail.Fail] = diagnostic.join(a, "\nisa = \"", floor, "\"");
            if (sel res_isa.err) { ret err[fail.Fail].err{res_isa.err}; }
            add = res_isa.ok;
        }
        val opt_of: opt[*toml_value.Value] = toml_lookup.get(sub, "of");
        if (sel opt_of.none) {
            val res_of: res[str, fail.Fail] = diagnostic.join(a, add, "\nof = \"flat\"");
            if (sel res_of.err) { ret err[fail.Fail].err{res_of.err}; }
            add = res_of.ok;
        }
        if (str_len(add) == 0) { cnt; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: line_end(text, opt_isa.some.span.at + opt_isa.some.span.len), len: 0, text: add, pad: 0});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# the system a target table names, under this major's key or the previous one's; "" for none
fun system_of(sub: *toml_value.Table) str {
    val opt_sys: opt[str] = toml_lookup.get_str(sub, "sys");
    if (sel opt_sys.some) { ret opt_sys.some; }
    val opt_os: opt[str] = toml_lookup.get_str(sub, "os");
    if (sel opt_os.some) { ret opt_os.some; }
    ret "";
}

# the floor a previous major gave a freestanding target of the architecture `arch`, nil for one
# it gave none
fun floor_of(arch: str) str {
    var f: usize = 0;
    for (f < FLOOR_COUNT) {
        if (str_equals(FLOORS[f].arch, arch)) { ret FLOORS[f].isa; }
        f = f + 1;
    }
    ret nil;
}

# the offset where the line holding byte `at` ends, before its line break
fun line_end(text: str, at: usize) usize {
    var end: usize = at;
    for (text[end] != 0 && text[end] != '\n' && text[end] != '\r') { end = end + 1; }
    ret end;
}

# each entry of a profile's `allow` that names a warning no build raises any more, which the
# registry keeps as a retired row. silencing it silenced nothing, so the entry is removed, and
# the array is written again with the entries it keeps
fun rule_retired_allow(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val opt_profiles: opt[*toml_value.Table] = toml_lookup.get_table(doc, "profile");
    if (sel opt_profiles.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_profiles.some)) {
        val opt_entry: opt[*toml_value.Value] = toml_lookup.table_value(opt_profiles.some, i);
        i = i + 1;
        if (sel opt_entry.none)                          { cnt; }
        if (opt_entry.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val opt_allow: opt[*toml_value.Value] = toml_lookup.get(?opt_entry.some.data.table, "allow");
        if (sel opt_allow.none)                          { cnt; }
        if (opt_allow.some.tag != toml_value.TYPE_ARRAY) { cnt; }
        val arr:  *toml_value.Array = ?opt_allow.some.data.array;
        var kept: Vector[u8]        = collections_vector.init[u8](a);
        fin { collections_vector.dnit[u8](?kept); }
        var dropped:    bool         = false;
        var first:      bool         = true;
        var k:          usize        = 0;
        val err_opened: err[A.Error] = append(?kept, "[", 0, 1);
        if (sel err_opened.err) { ret err[fail.Fail].err{fail.refused(err_opened.err)}; }
        for (k < toml_lookup.array_len(arr)) {
            val opt_element: opt[*toml_value.Value] = toml_lookup.array_get(arr, k);
            k = k + 1;
            if (sel opt_element.none) { cnt; }
            val e: *toml_value.Value = opt_element.some;
            if (e.tag == toml_value.TYPE_STRING && retired_warning(e.data.string)) {
                dropped = true;
                cnt;
            }
            if (!first) {
                val err_comma: err[A.Error] = append(?kept, ", ", 0, 2);
                if (sel err_comma.err) { ret err[fail.Fail].err{fail.refused(err_comma.err)}; }
            }
            first = false;
            val err_kept: err[A.Error] = append(?kept, text, e.span.at, e.span.len);
            if (sel err_kept.err) { ret err[fail.Fail].err{fail.refused(err_kept.err)}; }
        }
        if (!dropped) { cnt; }
        val err_closed: err[A.Error] = append(?kept, "]", 0, 1);
        if (sel err_closed.err) { ret err[fail.Fail].err{fail.refused(err_closed.err)}; }
        val res_text: res[str, StrError] = str_copy_slice(a, kept.data::str, 0, kept.len);
        if (sel res_text.err) { ret err[fail.Fail].err{fail.str_refused(res_text.err)}; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: opt_allow.some.span.at, len: opt_allow.some.span.len, text: res_text.ok, pad: 0});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether `key` is exactly the key of a warning the registry retired
fun retired_warning(key: str) bool {
    val opt_kind: opt[diagnostic_kind.Kind] = diagnostic_kind.named(key);
    if (sel opt_kind.none) { ret false; }
    ret !diagnostic_kind.live(opt_kind.some) && !diagnostic_kind.is_error(opt_kind.some) && !diagnostic_kind.is_note(opt_kind.some);
}

# the one library a previous major's `default = true` made its project's export surface, whose
# `need` travelled to consumers, marked `export = true` on the line after its `default` as this
# major spells that surface. a manifest that states `export` on an artifact is left as written,
# and one with several default libraries has no one answer, which `mach migrate` reports
fun rule_default_export(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(doc, "artifact");
    if (sel opt_artifacts.none)                     { ret err[fail.Fail].ok{}; }
    if (export_candidates(opt_artifacts.some) != 1) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_artifacts.some)) {
        val opt_row: opt[*toml_value.Value] = toml_lookup.table_value(opt_artifacts.some, i);
        i = i + 1;
        if (sel opt_row.none)                           { cnt; }
        if (opt_row.some.tag != toml_value.TYPE_TABLE)  { cnt; }
        if (!default_library(?opt_row.some.data.table)) { cnt; }
        val opt_default: opt[*toml_value.Value] = toml_lookup.get(?opt_row.some.data.table, "default");
        if (sel opt_default.none) { cnt; }
        val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: line_end(text, opt_default.some.span.at + opt_default.some.span.len), len: 0, text: "\nexport = true", pad: 0});
        if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# how many artifacts of the `[artifact]` table `artifacts` are default libraries a previous
# major made the export surface, 0 when one states `export`, as this major's manifest does
pub fun export_candidates(artifacts: *toml_value.Table) usize {
    var count: usize = 0;
    var i:     usize = 0;
    for (i < toml_lookup.table_len(artifacts)) {
        val opt_row: opt[*toml_value.Value] = toml_lookup.table_value(artifacts, i);
        i = i + 1;
        if (sel opt_row.none)                          { cnt; }
        if (opt_row.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val opt_export: opt[*toml_value.Value] = toml_lookup.get(?opt_row.some.data.table, "export");
        if (sel opt_export.some)                       { ret 0; }
        if (default_library(?opt_row.some.data.table)) { count = count + 1; }
    }
    ret count;
}

# each `bin` artifact a previous major built for spir-v targets only, whose `kind` this major
# writes as a `module`, the one kind a spir-v target builds. one that lists a spir-v target
# beside another has no one answer, which `mach migrate` reports
fun rule_finished_module(a: *A.Allocator, text: str, doc: *toml_value.Table, fixes: *Vector[Fix]) err[fail.Fail] {
    val opt_artifacts: opt[*toml_value.Table] = toml_lookup.get_table(doc, "artifact");
    if (sel opt_artifacts.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_artifacts.some)) {
        val opt_row: opt[*toml_value.Value] = toml_lookup.table_value(opt_artifacts.some, i);
        i = i + 1;
        if (sel opt_row.none)                          { cnt; }
        if (opt_row.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val row:    *toml_value.Table = ?opt_row.some.data.table;
        var listed: usize             = 0;
        val spirv:  usize             = spirv_listed(doc, row, ?listed);
        if (spirv == 0 || spirv != listed) { cnt; }
        val opt_kind: opt[*toml_value.Value] = toml_lookup.get(row, "kind");
        if (sel opt_kind.none) { cnt; }
        val err_fixed: err[fail.Fail] = string_fix(text, opt_kind.some.span, mink_output.MODULE.spelled, fixes);
        if (sel err_fixed.err) { ret err_fixed; }
    }
    ret err[fail.Fail].ok{};
}

# whether the `bin` artifact `row` of the manifest `doc` lists a spir-v target beside another,
# which no one kind builds
pub fun spirv_mixed(doc: *toml_value.Table, row: *toml_value.Table) bool {
    var listed: usize = 0;
    val spirv:  usize = spirv_listed(doc, row, ?listed);
    ret spirv != 0 && spirv != listed;
}

# how many of the targets the `bin` artifact `row` of the manifest `doc` lists stand on spir-v,
# `listed` receiving how many it lists. an artifact of another kind lists none
fun spirv_listed(doc: *toml_value.Table, row: *toml_value.Table, listed: *usize) usize {
    @listed = 0;
    val opt_kind: opt[Spelled] = kind_of(row);
    if (sel opt_kind.none)                         { ret 0; }
    if (!mach_target.is_executable(opt_kind.some)) { ret 0; }
    val opt_targets: opt[*toml_value.Array] = toml_lookup.get_array(row, "targets");
    if (sel opt_targets.none) { ret 0; }
    var spirv: usize = 0;
    var i:     usize = 0;
    for (i < toml_lookup.array_len(opt_targets.some)) {
        val opt_name: opt[*toml_value.Value] = toml_lookup.array_get(opt_targets.some, i);
        i       = i + 1;
        @listed = @listed + 1;
        if (sel opt_name.none)                            { cnt; }
        if (opt_name.some.tag != toml_value.TYPE_STRING)  { cnt; }
        if (spirv_target(doc, opt_name.some.data.string)) { spirv = spirv + 1; }
    }
    ret spirv;
}

# whether the target `name` of the manifest `doc` stands on spir-v, as this major's `arch` or
# the previous one's `isa` names it
fun spirv_target(doc: *toml_value.Table, name: str) bool {
    val opt_targets: opt[*toml_value.Table] = toml_lookup.get_table(doc, "target");
    if (sel opt_targets.none) { ret false; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(opt_targets.some)) {
        val opt_key:   opt[str]               = toml_lookup.table_key(opt_targets.some, i);
        val opt_entry: opt[*toml_value.Value] = toml_lookup.table_value(opt_targets.some, i);
        i = i + 1;
        if (sel opt_key.none)                            { cnt; }
        if (sel opt_entry.none)                          { cnt; }
        if (opt_entry.some.tag != toml_value.TYPE_TABLE) { cnt; }
        if (!str_equals(opt_key.some, name))             { cnt; }
        val opt_arch: opt[str] = toml_lookup.get_str(?opt_entry.some.data.table, "arch");
        if (sel opt_arch.some) { ret str_equals(opt_arch.some, "spirv"); }
        val opt_isa: opt[str] = toml_lookup.get_str(?opt_entry.some.data.table, "isa");
        ret sel opt_isa.some && str_equals(opt_isa.some, "spirv");
    }
    ret false;
}

# the offset of the table header line above the byte `at` of a manifest's text, the line a
# diff names beside a change there; the text's length where none stands above it
pub fun table_heading(text: str, at: usize) usize {
    var head: usize = str_len(text);
    var line: usize = 0;
    for (line < at && text[line] != 0) {
        var c: usize = line;
        for (text[c] == ' ' || text[c] == '\t') { c = c + 1; }
        if (text[c] == '[') { head = line; }
        for (text[line] != 0 && text[line] != '\n') { line = line + 1; }
        if (text[line] == '\n') { line = line + 1; }
    }
    ret head;
}

# whether a fix made so far rewrites a byte of the `len` bytes at `at`
fun rewritten(fixes: *Vector[Fix], at: usize, len: usize) bool {
    var i: usize = 0;
    for (i < fixes.len) {
        val f: *Fix = ?fixes.data[i];
        i = i + 1;
        if (f.at < at + len && at < f.at + f.len) { ret true; }
    }
    ret false;
}

# the offset of the first byte of the string literal at `span`: past its one quote, or past its
# three and the line break TOML trims after them
fun string_start(text: str, span: toml_value.Span) usize {
    val q: u8 = text[span.at];
    if (span.len < 6 || text[span.at + 1] != q || text[span.at + 2] != q) { ret span.at + 1; }
    var at: usize = span.at + 3;
    if (text[at] == '\r' && text[at + 1] == '\n') { ret at + 2; }
    if (text[at] == '\n')                         { ret at + 1; }
    ret at;
}

# whether a step's `argv`, its literals in `text`, runs mach
pub fun runs_mach(text: str, args: *toml_value.Array) bool {
    var i: usize = 0;
    for (i < toml_lookup.array_len(args)) {
        val opt_arg: opt[*toml_value.Value] = toml_lookup.array_get(args, i);
        i = i + 1;
        if (sel opt_arg.none) { cnt; }
        val end: usize = opt_arg.some.span.at + opt_arg.some.span.len;
        if (word_in(text, opt_arg.some.span.at, end, "mach") != end) { ret true; }
    }
    ret false;
}

# a renamed key keeps the column its `=` stood at when a line beside it aligns
# its `=` there, and the spacing it was written with when none does
fun aligned(text: str, fix: *Fix) {
    if (str_len(fix.text) == 0) { ret; }
    var spaces: usize = 0;
    for (text[fix.at + fix.len + spaces] == ' ') { spaces = spaces + 1; }
    if (text[fix.at + fix.len + spaces] != '=') { ret; }
    val column: usize = fix.len + spaces;
    val name:   usize = str_len(fix.text);
    val start:  usize = line_start(text, fix.at);
    val at:     usize = fix.at + column - start;
    fix.len = column;
    fix.pad = spaces;
    if (!beside_at(text, start, fix.at, at)) { ret; }
    fix.pad = 1;
    if (column > name) { fix.pad = column - name; }
}

# whether the line before or after the one from `start` holds its first `=` at
# column `at`, `within` being any byte of that line
fun beside_at(text: str, start: usize, within: usize, at: usize) bool {
    if (start > 0 && equals_at(text, line_start(text, start - 1)) == at) { ret true; }
    var end: usize = within;
    for (text[end] != 0 && text[end] != '\n') { end = end + 1; }
    if (text[end] == 0) { ret false; }
    ret equals_at(text, end + 1) == at;
}

# the offset of the line holding byte `at`
fun line_start(text: str, at: usize) usize {
    var start: usize = at;
    for (start > 0 && text[start - 1] != '\n') { start = start - 1; }
    ret start;
}

# the column of the first `=` on the line from `start`, or the line's length
# plus one when it writes none, which no key's column is
fun equals_at(text: str, start: usize) usize {
    var i: usize = start;
    for (text[i] != 0 && text[i] != '\n') {
        if (text[i] == '=') { ret i - start; }
        i = i + 1;
    }
    ret i - start + 1;
}

# a fix that removes all a line writes removes the line
fun whole_line(text: str, fix: *Fix) {
    if (str_len(fix.text) != 0) { ret; }
    var start: usize = fix.at;
    for (start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\t')) { start = start - 1; }
    if (start > 0 && text[start - 1] != '\n') { ret; }
    var end: usize = fix.at + fix.len;
    for (text[end] == ' ' || text[end] == '\t' || text[end] == '\r') { end = end + 1; }
    if (text[end] != '\n') { ret; }
    fix.at  = start;
    fix.len = end + 1 - start;
}

# a source's text in this major's spelling: each comptime path whose leading
# segments a previous major named, each decorator it named, each `asm` head, each
# truth alias over a width and each bare use of a project rewritten. only tokens
# are read, so a comment or a string that spells one is left as written
# ---
# a:     owns the returned text
# text:  the source's text
# diags: receives the lexer's diagnostics of a text that is not source
# deps:  the root project's dependencies
# ret:   the rewritten text, owned by `a`, reported when the text has lexical errors, or the
#        lexer's refusal
pub fun source(a: *A.Allocator, text: str, diags: *diagnostic.DiagnosticStore, deps: *Vector[Dependency]) res[str, fail.Fail] {
    val res_lexed: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(text, a, base_source.file_id(1));
    if (sel res_lexed.err) { ret res[str, fail.Fail].err{res_lexed.err}; }
    var stream: lexer.TokenStream = res_lexed.ok;
    fin { lexer.dnit(?stream, a); }
    val err_emitted: err[fail.Fail] = lexer.emit_diagnostics(?stream, diags);
    if (sel err_emitted.err)   { ret res[str, fail.Fail].err{err_emitted.err}; }
    if (stream.error_len != 0) { ret res[str, fail.Fail].err{fail.reported()}; }
    var fixes: Vector[Fix] = collections_vector.init[Fix](a);
    fin { collections_vector.dnit[Fix](?fixes); }
    var walk: Walk  = Walk{a: a, text: text, stream: ?stream, fixes: ?fixes, deps: deps};
    var i:    usize = 0;
    for (i < stream.len) {
        var r: usize = 0;
        for (r < SOURCE_RULE_COUNT) {
            if (SOURCE_RULES[r].from == FROM_MAJOR) {
                val err_applied: err[fail.Fail] = SOURCE_RULES[r].apply(?walk, i);
                if (sel err_applied.err) { ret res[str, fail.Fail].err{err_applied.err}; }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    ret splice(a, text, ?fixes);
}

# a fix that writes `text` over the bytes of `span`
fun fix_of(w: *Walk, span: base_source.Span, text: str) err[fail.Fail] {
    val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](w.fixes, Fix{at: span.offset, len: span.len, text: text, pad: 0});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# token `i` of the walk's source, nil past its end
fun token_at(w: *Walk, i: usize) *token.Token {
    if (i >= w.stream.len) { ret nil; }
    ret ?w.stream.tokens[i];
}

# whether token `i` is of `kind`
fun kind_at(w: *Walk, i: usize, kind: token.Kind) bool {
    val t: *token.Token = token_at(w, i);
    ret t != nil && t.kind == kind;
}

# whether token `i` is the identifier `word`
fun word_at(w: *Walk, i: usize, word: str) bool {
    if (!kind_at(w, i, token.KIND_IDENT)) { ret false; }
    val t: *token.Token = token_at(w, i);
    ret str_region_equals(w.text, t.span.offset, t.span.len, word);
}

# `$path`: the comptime path the registry renamed
fun rule_path(w: *Walk, i: usize) err[fail.Fail] {
    if (!kind_at(w, i, token.KIND_DOLLAR)) { ret err[fail.Fail].ok{}; }
    ret path_in(w.text, w.stream, i + 1, w.fixes);
}

# `#[name...]`: the name a previous major gave it, a flag's mode written as its argument
# and bare-word arguments written as strings
fun rule_decorator(w: *Walk, i: usize) err[fail.Fail] {
    if (!kind_at(w, i, token.KIND_DECORATOR_OPEN) || !kind_at(w, i + 1, token.KIND_IDENT)) { ret err[fail.Fail].ok{}; }
    val name: *token.Token = token_at(w, i + 1);
    val open: bool         = kind_at(w, i + 2, token.KIND_LPAREN);
    var args: u32          = 0;
    if (open) { args = 1; }
    val to: decorator.Rewrite = decorator.rewrite_of(w.text, name.span, args);
    if (to.name == nil) { ret err[fail.Fail].ok{}; }
    if (to.mode != nil) {
        val res_with: res[str, fail.Fail] = diagnostic.join(w.a, to.name, "(\"", to.mode, "\")");
        if (sel res_with.err) { ret err[fail.Fail].err{res_with.err}; }
        ret fix_of(w, name.span, res_with.ok);
    }
    val err_named: err[fail.Fail] = fix_of(w, name.span, to.name);
    if (sel err_named.err || !to.words || !open) { ret err_named; }
    var j: usize = i + 3;
    for (j < w.stream.len && !kind_at(w, j, token.KIND_RPAREN)) {
        val t: *token.Token = token_at(w, j);
        j = j + 1;
        if (t.kind != token.KIND_IDENT) { cnt; }
        val res_word: res[str, StrError] = str_copy_slice(w.a, w.text, t.span.offset, t.span.len);
        if (sel res_word.err) { ret err[fail.Fail].err{fail.str_refused(res_word.err)}; }
        val res_quoted: res[str, fail.Fail] = diagnostic.join(w.a, "\"", res_word.ok, "\"");
        if (sel res_quoted.err) { ret err[fail.Fail].err{res_quoted.err}; }
        val err_placed: err[fail.Fail] = fix_of(w, t.span, res_quoted.ok);
        if (sel err_placed.err) { ret err_placed; }
    }
    ret err[fail.Fail].ok{};
}

# `asm <architecture> {`: the selection the transition table holds for the head
fun rule_asm_head(w: *Walk, i: usize) err[fail.Fail] {
    if (!word_at(w, i, lexis.KW_ASM) || !kind_at(w, i + 1, token.KIND_IDENT) || !kind_at(w, i + 2, token.KIND_LBRACE)) { ret err[fail.Fail].ok{}; }
    val head: *token.Token     = token_at(w, i + 1);
    val row:  *transition.Head = transition.head_of(w.text, head.span);
    if (row == nil) { ret err[fail.Fail].ok{}; }
    ret fix_of(w, head.span, row.to);
}

# `def name: over;`: a truth alias the transition table holds, onto `u1`
fun rule_alias(w: *Walk, i: usize) err[fail.Fail] {
    if (!word_at(w, i, lexis.KW_DEF) || !kind_at(w, i + 1, token.KIND_IDENT) || !kind_at(w, i + 2, token.KIND_COLON)
        || !kind_at(w, i + 3, token.KIND_IDENT) || !kind_at(w, i + 4, token.KIND_SEMI)) { ret err[fail.Fail].ok{}; }
    val over: *token.Token      = token_at(w, i + 3);
    val row:  *transition.Alias = transition.alias_of(w.text, token_at(w, i + 1).span, over.span);
    if (row == nil) { ret err[fail.Fail].ok{}; }
    ret fix_of(w, over.span, row.to);
}

# `use id;`, `use name: id;` or `fwd id;`: one segment names a project and no module since
# #4754, so it becomes the path of the module the old rule bound
fun rule_bare_use(w: *Walk, i: usize) err[fail.Fail] {
    if (!word_at(w, i, lexis.KW_USE) && !word_at(w, i, lexis.KW_FWD)) { ret err[fail.Fail].ok{}; }
    var at: usize = i + 1;
    if (kind_at(w, at + 1, token.KIND_COLON))                                      { at = at + 2; }
    if (!kind_at(w, at, token.KIND_IDENT) || !kind_at(w, at + 1, token.KIND_SEMI)) { ret err[fail.Fail].ok{}; }
    val id: *token.Token = token_at(w, at);
    var d:  usize        = 0;
    for (d < w.deps.len) {
        val dep: *Dependency = ?w.deps.data[d];
        d = d + 1;
        if (dep.module != nil && str_region_equals(w.text, id.span.offset, id.span.len, dep.id)) { ret fix_of(w, id.span, dep.module); }
    }
    ret err[fail.Fail].ok{};
}

# the fix of the comptime path whose segments start at token `first`, when the
# registry renamed its leading segments
fun path_in(text: str, stream: *lexer.TokenStream, first: usize, fixes: *Vector[Fix]) err[fail.Fail] {
    var segments: [MAX_SEGMENTS]base_source.Span;
    var n:        usize = 0;
    var j:        usize = first;
    for (j < stream.len && n < MAX_SEGMENTS && stream.tokens[j].kind == token.KIND_IDENT) {
        segments[n] = stream.tokens[j].span;
        n           = n + 1;
        j           = j + 1;
        if (j + 1 >= stream.len || stream.tokens[j].kind != token.KIND_DOT) { brk; }
        j = j + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }
    # the registry reads a path innermost segment first
    var stack: [MAX_SEGMENTS]base_source.Span;
    var k:     usize = 0;
    for (k < n) {
        stack[k] = segments[n - 1 - k];
        k        = k + 1;
    }
    val moved: *comptime_path.Renamed = comptime_path.renamed(text, ?stack[0], n::u32);
    if (moved == nil) { ret err[fail.Fail].ok{}; }
    val last:       base_source.Span    = segments[comptime_path.renamed_depth(moved)::usize - 1];
    val at:         usize               = segments[0].offset;
    val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at, len: last.offset + last.len - at, text: moved.to, pad: 0});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the fixes of every template variable a previous major named, in each string
# the table `t` holds at any depth. the raw text of a string is searched, so an
# escape before a variable does not move it
fun templates_in(text: str, t: *toml_value.Table, fixes: *Vector[Fix]) err[A.Error] {
    var i: usize = 0;
    for (i < toml_lookup.table_len(t)) {
        val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(t, i);
        i = i + 1;
        if (sel opt_table_value.none) { cnt; }
        val err_held: err[A.Error] = templates_of(text, opt_table_value.some, fixes);
        if (sel err_held.err) { ret err_held; }
    }
    ret err[A.Error].ok{};
}

# the fixes of every renamed template variable in the strings `v` holds at any depth
fun templates_of(text: str, v: *toml_value.Value, fixes: *Vector[Fix]) err[A.Error] {
    if (v.tag == toml_value.TYPE_TABLE) { ret templates_in(text, ?v.data.table, fixes); }
    if (v.tag == toml_value.TYPE_ARRAY) {
        var i: usize = 0;
        for (i < toml_lookup.array_len(?v.data.array)) {
            val opt_array_get: opt[*toml_value.Value] = toml_lookup.array_get(?v.data.array, i);
            i = i + 1;
            if (sel opt_array_get.none) { cnt; }
            val err_held: err[A.Error] = templates_of(text, opt_array_get.some, fixes);
            if (sel err_held.err) { ret err_held; }
        }
        ret err[A.Error].ok{};
    }
    if (v.tag != toml_value.TYPE_STRING) { ret err[A.Error].ok{}; }
    var r: usize = 0;
    for {
        val row: *template.Renamed = template.renamed(r);
        if (row == nil) { brk; }
        r = r + 1;
        val err_placed: err[A.Error] = variables_in(text, v.span, row, fixes);
        if (sel err_placed.err) { ret err_placed; }
    }
    ret err[A.Error].ok{};
}

# a fix of each `{from}` the raw text at `span` writes
fun variables_in(text: str, span: toml_value.Span, row: *template.Renamed, fixes: *Vector[Fix]) err[A.Error] {
    val from: usize = str_len(row.from);
    var at:   usize = span.at;
    for (at + from + 2 <= span.at + span.len) {
        if (text[at] == '{' && text[at + from + 1] == '}' && spells(text, at + 1, row.from, from)) {
            val res_pushed: res[usize, A.Error] = collections_vector.push[Fix](fixes, Fix{at: at + 1, len: from, text: row.to, pad: 0});
            if (sel res_pushed.err) { ret err[A.Error].err{res_pushed.err}; }
            at = at + from + 2;
            cnt;
        }
        at = at + 1;
    }
    ret err[A.Error].ok{};
}

# whether the `len` bytes of `text` at `at` are the first `len` bytes of `word`
fun spells(text: str, at: usize, word: str, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (text[at + i] != word[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun by_offset(x: *Fix, y: *Fix) i64 {
    if (x.at < y.at) { ret -1; }
    if (x.at > y.at) { ret 1; }
    ret 0;
}

# `text` with each fix applied, in offset order. two fixes of one byte are the
# rules contradicting each other, which is refused
fun splice(a: *A.Allocator, text: str, fixes: *Vector[Fix]) res[str, fail.Fail] {
    sort.sort_by[Fix](fixes.data, fixes.len, by_offset);
    var out: Vector[u8] = collections_vector.init[u8](a);
    fin { collections_vector.dnit[u8](?out); }
    val len:  usize = str_len(text);
    var from: usize = 0;
    var i:    usize = 0;
    for (i <= fixes.len) {
        var to: usize = len;
        if (i < fixes.len) { to = fixes.data[i].at; }
        if (to < from)     { ret res[str, fail.Fail].err{fail.message("two migration rules rewrite the same bytes")}; }
        val err_kept: err[A.Error] = append(?out, text, from, to - from);
        if (sel err_kept.err) { ret res[str, fail.Fail].err{fail.refused(err_kept.err)}; }
        if (i == fixes.len)   { brk; }
        val fix:      *Fix         = ?fixes.data[i];
        val err_made: err[A.Error] = append(?out, fix.text, 0, str_len(fix.text));
        if (sel err_made.err) { ret res[str, fail.Fail].err{fail.refused(err_made.err)}; }
        var p: usize = 0;
        for (p < fix.pad) {
            val err_padded: err[A.Error] = append(?out, " ", 0, 1);
            if (sel err_padded.err) { ret res[str, fail.Fail].err{fail.refused(err_padded.err)}; }
            p = p + 1;
        }
        from = fix.at + fix.len;
        i    = i + 1;
    }
    # the copy reads its source as a nul-terminated string
    val res_ended: res[usize, A.Error] = collections_vector.push[u8](?out, 0);
    if (sel res_ended.err) { ret res[str, fail.Fail].err{fail.refused(res_ended.err)}; }
    val res_copied: res[str, StrError] = str_copy_slice(a, out.data::str, 0, out.len - 1);
    if (sel res_copied.err) { ret res[str, fail.Fail].err{fail.message(fail.str_text(res_copied.err))}; }
    ret res[str, fail.Fail].ok{res_copied.ok};
}

# append `len` bytes of `text` from `at`, keeping room for a terminator
fun append(out: *Vector[u8], text: str, at: usize, len: usize) err[A.Error] {
    val res_room: res[usize, A.Error] = collections_vector.reserve[u8](out, len + 1);
    if (sel res_room.err) { ret err[A.Error].err{res_room.err}; }
    var i: usize = 0;
    for (i < len) {
        out.data[out.len] = text[at + i];
        collections_vector.commit[u8](out, 1);
        i = i + 1;
    }
    ret err[A.Error].ok{};
}
