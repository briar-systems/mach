# editing a manifest's text in place: adding and removing a `[dep.<name>]`
# table, leaving every other byte as it was written
use mach.base.fail;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use toml_error:  toml.error;
use toml_lookup: toml.lookup;
use toml_parse:  toml.parse;
use toml_tree:   toml.tree;
use toml_value:  toml.value;
use toml_write:  toml.write;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;

use base_catalog: mach.base.catalog;
use mach.manifest.refusal.refuse;
use mach.manifest.refusal.sfmt;
use mach.manifest.schema.dep_name_refused;
use mach.manifest.schema.is_project_id;
use mach.manifest.schema.is_valid_id;

# the source key a `mach dep add` writes
pub def DepSource: u8;

# a `git = "<url>"` dependency, with an optional `ref`
pub val DEP_SOURCE_GIT: DepSource = 1;
# a `path = "<dir>"` dependency
pub val DEP_SOURCE_PATH: DepSource = 2;

# a `[dep.<name>]` table to append to a manifest's text
# ---
# name:    the dependency name, a project id
# source:  which key `value` is written under
# value:   the git URL or the path; escaped as a TOML basic string
# ref:     the `ref` value; written only for a git source and only when non-empty
# version: the `version` range; written only for a git source, only when set, and never with a ref
pub rec DepTableSpec {
    name:    str;
    source:  DepSource;
    value:   str;
    ref:     str;
    version: str;
}

val DEP_LOOKUP_ABSENT:    u8 = 0;
val DEP_LOOKUP_TABLE:     u8 = 1;
val DEP_LOOKUP_NON_TABLE: u8 = 2;

fun source_uses_crlf(source: str) bool {
    val n: usize = str_len(source);
    var i: usize = 0;
    for (i < n) {
        if (source[i] == '\n'::u8) { ret i > 0 && source[i - 1] == '\r'::u8; }
        i = i + 1;
    }
    ret false;
}

fun source_ends_with_newline(source: str) bool {
    val n: usize = str_len(source);
    ret n > 0 && source[n - 1] == '\n'::u8;
}

# how `name` is declared under `[dep]` in `source_text`: absent, as a table, or as another
# value, err when the text is not TOML
fun dep_entry_kind(alloc: *A.Allocator, source_text: str, name: str) res[u8, fail.Fail] {
    val res_parse: res[toml_value.Table, toml_error.TomlError] = toml_parse.parse(alloc, source_text);
    if (sel res_parse.err) { ret res[u8, fail.Fail].err{fail.toml_refused(res_parse.err)}; }
    var tbl:      toml_value.Table       = res_parse.ok;
    val opt_deps: opt[*toml_value.Table] = toml_lookup.get_table(?tbl, "dep");
    var kind:     u8                     = DEP_LOOKUP_ABSENT;
    if (sel opt_deps.some) {
        val deps: *toml_value.Table = opt_deps.some;
        val len:  usize             = toml_lookup.table_len(deps);
        var i:    usize             = 0;
        for (i < len) {
            val opt_key: opt[str] = toml_lookup.table_key(deps, i);
            if (sel opt_key.none) { brk; }
            if (str_equals(opt_key.some, name)) {
                val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(deps, i);
                if (sel opt_table_value.none)                          { brk; }
                if (opt_table_value.some.tag == toml_value.TYPE_TABLE) { kind = DEP_LOOKUP_TABLE; }
                or                                                     { kind = DEP_LOOKUP_NON_TABLE; }
            }
            i = i + 1;
        }
    }
    toml_tree.dnit(alloc, ?tbl);
    ret res[u8, fail.Fail].ok{kind};
}

# where a top-level table header line sits in manifest text
# ---
# found:     a line is exactly the header
# ambiguous: more than one line is
# start:     the offset of the last such line
# body_end:  the offset of the next header line after it, or the text's end
rec HeaderSpan {
    found:     bool;
    ambiguous: bool;
    start:     usize;
    body_end:  usize;
}

fun find_top_level_table(source: str, header: str) HeaderSpan {
    var hs:            HeaderSpan;
    val n:             usize = str_len(source);
    var pending_start: usize = 0;
    var in_target:     bool  = false;
    var i:             usize = 0;
    for (i <= n) {
        val at_end: bool = i == n;
        val at_nl:  bool = !at_end && source[i] == '\n'::u8;
        if (at_end || at_nl) {
            val line_start: usize = pending_start;
            var line_end:   usize = i;
            if (line_end > line_start && source[line_end - 1] == '\r'::u8) { line_end = line_end - 1; }
            val is_header: bool = line_end > line_start && source[line_start] == '['::u8;
            if (is_header) {
                val matches: bool = str_region_equals(source, line_start, line_end - line_start, header);
                if (in_target) {
                    hs.body_end = line_start;
                    in_target   = false;
                }
                if (matches) {
                    if (hs.found) { hs.ambiguous = true; }
                    hs.found  = true;
                    hs.start  = line_start;
                    in_target = true;
                }
            }
            pending_start = i + 1;
        }
        i = i + 1;
    }
    if (in_target) { hs.body_end = n; }
    ret hs;
}

# the manifest key a dependency source is written under; absent for a tag
# outside the catalog
fun dep_key_name(source: DepSource) opt[str] {
    if (source == DEP_SOURCE_GIT)  { ret opt[str].some{"git"}; }
    if (source == DEP_SOURCE_PATH) { ret opt[str].some{"path"}; }
    ret opt[str].none{};
}

# the text of a `[dep.<name>]` table for `spec`, each line ended by `nl`, owned by `alloc`
fun build_dep_block(alloc: *A.Allocator, nl: str, spec: *DepTableSpec) res[str, fail.Fail] {
    val res_esc_value: res[str, A.Error] = toml_write.escape(alloc, spec.value);
    if (sel res_esc_value.err) { ret res[str, fail.Fail].err{fail.refused(res_esc_value.err)}; }
    val esc_value: str = res_esc_value.ok;
    fin { str_free(alloc, esc_value); }

    val has_version: bool = spec.source == DEP_SOURCE_GIT && spec.version != nil && !str_is_empty(spec.version);
    val has_ref:     bool = spec.source == DEP_SOURCE_GIT && (has_version || !str_is_empty(spec.ref));
    var esc_ref:     str  = nil;
    fin { str_free(alloc, esc_ref); }
    if (has_ref) {
        var selector: str = spec.ref;
        if (has_version) { selector = spec.version; }
        val res_esc_ref: res[str, A.Error] = toml_write.escape(alloc, selector);
        if (sel res_esc_ref.err) { ret res[str, fail.Fail].err{fail.refused(res_esc_ref.err)}; }
        esc_ref = res_esc_ref.ok;
    }

    val opt_key: opt[str] = dep_key_name(spec.source);
    if (sel opt_key.none) { ret res[str, fail.Fail].err{base_catalog.unknown_catalog(alloc, "DepSource", spec.source::u32)}; }
    val key:       str = opt_key.some;
    var res_block: res[str, std_format.FormatError];
    if (has_ref) {
        var selector_key: str = "ref";
        if (has_version) { selector_key = "version"; }
        res_block = std_format.sprint(alloc, "[dep.{}]{}{} = \"{}\"{}{} = \"{}\"{}", spec.name, nl, key, esc_value, nl, selector_key, esc_ref, nl);
    }
    or {
        res_block = std_format.sprint(alloc, "[dep.{}]{}{} = \"{}\"{}", spec.name, nl, key, esc_value, nl);
    }
    if (sel res_block.err) { ret res[str, fail.Fail].err{fail.format_refused(res_block.err)}; }
    ret res[str, fail.Fail].ok{res_block.ok};
}

# append a `[dep.<name>]` table to manifest text, leaving every existing byte in
# place. the block uses the file's line ending and is separated by one blank
# line (two when the text lacks a trailing newline)
# ---
# alloc:       owns the returned text
# source_text: the current `mach.toml`
# spec:        the table to add
# ret:         the new text; err when the name is not a project id, the source is not
#              git or path, the text is not valid TOML, the dependency is already declared
#              in any form, or the result does not reparse with the table present
pub fun dep_table_add(alloc: *A.Allocator, source_text: str, spec: *DepTableSpec) res[str, fail.Fail] {
    if (!is_project_id(spec.name))                                       { ret res[str, fail.Fail].err{dep_name_refused(alloc, spec.name)}; }
    if (spec.source != DEP_SOURCE_GIT && spec.source != DEP_SOURCE_PATH) { ret res[str, fail.Fail].err{fail.message("unrecognized dependency source")}; }

    val res_kind: res[u8, fail.Fail] = dep_entry_kind(alloc, source_text, spec.name);
    if (sel res_kind.err) { ret res[str, fail.Fail].err{not_toml(alloc, res_kind.err)}; }
    if (res_kind.ok != DEP_LOOKUP_ABSENT) {
        ret res[str, fail.Fail].err{refuse(alloc, diagnostic_kind.DEP_ALREADY_DECLARED, "dependency '{}' is already declared in mach.toml", spec.name)};
    }

    val nl:        str                 = if_crlf(source_text);
    val res_block: res[str, fail.Fail] = build_dep_block(alloc, nl, spec);
    if (sel res_block.err) { ret res_block; }
    val block: str = res_block.ok;
    fin { str_free(alloc, block); }

    var sep: str = nl;
    fin {
        if (sep != nl) { str_free(alloc, sep); }
    }
    if (!source_ends_with_newline(source_text)) {
        val res_doubled: res[str, fail.Fail] = sfmt(alloc, "{}{}", nl, nl);
        if (sel res_doubled.err) { ret res_doubled; }
        sep = res_doubled.ok;
    }

    val res_candidate: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}{}{}", source_text, sep, block);
    if (sel res_candidate.err) { ret res[str, fail.Fail].err{fail.format_refused(res_candidate.err)}; }
    val candidate: str  = res_candidate.ok;
    var handed:    bool = false;
    fin {
        if (!handed) { str_free(alloc, candidate); }
    }

    val res_verify: res[u8, fail.Fail] = dep_entry_kind(alloc, candidate, spec.name);
    if (sel res_verify.err)                { ret res[str, fail.Fail].err{fail.message("added dependency table did not verify after reparse")}; }
    if (res_verify.ok != DEP_LOOKUP_TABLE) { ret res[str, fail.Fail].err{fail.message("added dependency table did not verify after reparse")}; }
    handed = true;
    ret res[str, fail.Fail].ok{candidate};
}

# cut a `[dep.<name>]` table out of manifest text, from its header line to the
# next header, leaving everything else byte for byte
# ---
# alloc:       owns the returned text
# source_text: the current `mach.toml`
# name:        the dependency name
# ret:         the new text; err when the name is not an identifier, the text is not
#              valid TOML, the dependency is absent, is declared but not as a table, is
#              declared more than once, or its header is not spelled exactly `[dep.<name>]`
#              at the start of a line
pub fun dep_table_remove(alloc: *A.Allocator, source_text: str, name: str) res[str, fail.Fail] {
    if (!is_valid_id(name)) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "dependency name must be a portable identifier (letters, digits, '_', '-')")}; }

    val res_kind: res[u8, fail.Fail] = dep_entry_kind(alloc, source_text, name);
    if (sel res_kind.err) { ret res[str, fail.Fail].err{not_toml(alloc, res_kind.err)}; }
    val kind: u8 = res_kind.ok;
    if (kind == DEP_LOOKUP_ABSENT)    { ret res[str, fail.Fail].err{refuse(alloc, diagnostic_kind.DEP_NOT_DECLARED, "dependency '{}' is not declared in mach.toml", name)}; }
    if (kind == DEP_LOOKUP_NON_TABLE) { ret res[str, fail.Fail].err{refuse(alloc, diagnostic_kind.DEP_MANUAL_EDIT, "dependency '{}' in mach.toml is not a table. edit it by hand", name)}; }

    val res_header: res[str, fail.Fail] = sfmt(alloc, "[dep.{}]", name);
    if (sel res_header.err) { ret res_header; }
    val hs: HeaderSpan = find_top_level_table(source_text, res_header.ok);
    str_free(alloc, res_header.ok);
    if (hs.ambiguous) { ret res[str, fail.Fail].err{refuse(alloc, diagnostic_kind.DEP_MANUAL_EDIT, "dependency '{}' is declared more than once in mach.toml. edit it by hand", name)}; }
    if (!hs.found)    { ret res[str, fail.Fail].err{refuse(alloc, diagnostic_kind.DEP_MANUAL_EDIT, "'[dep.{}]' is not written as a plain table header that mach can edit. edit it by hand", name)}; }

    val res_before: res[str, types_string.StrError] = str_copy_slice(alloc, source_text, 0, hs.start);
    if (sel res_before.err) { ret res[str, fail.Fail].err{fail.str_refused(res_before.err)}; }
    val before: str = res_before.ok;
    fin { str_free(alloc, before); }
    val res_after: res[str, types_string.StrError] = str_copy_slice(alloc, source_text, hs.body_end, str_len(source_text) - hs.body_end);
    if (sel res_after.err) { ret res[str, fail.Fail].err{fail.str_refused(res_after.err)}; }
    val after: str = res_after.ok;
    fin { str_free(alloc, after); }

    val res_candidate: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}{}", before, after);
    if (sel res_candidate.err) { ret res[str, fail.Fail].err{fail.format_refused(res_candidate.err)}; }
    val candidate: str  = res_candidate.ok;
    var handed:    bool = false;
    fin {
        if (!handed) { str_free(alloc, candidate); }
    }

    val res_verify: res[u8, fail.Fail] = dep_entry_kind(alloc, candidate, name);
    if (sel res_verify.err)                 { ret res[str, fail.Fail].err{fail.message("removed dependency table still verifies after reparse")}; }
    if (res_verify.ok != DEP_LOOKUP_ABSENT) { ret res[str, fail.Fail].err{fail.message("removed dependency table still verifies after reparse")}; }
    handed = true;
    ret res[str, fail.Fail].ok{candidate};
}

fun if_crlf(source: str) str {
    if (source_uses_crlf(source)) { ret "\r\n"; }
    ret "\n";
}

# the refusal of manifest text that is not TOML; a refused allocation stays itself
fun not_toml(alloc: *A.Allocator, f: fail.Fail) fail.Fail {
    if (fail.is_message(f)) { ret f; }
    ret refuse(alloc, diagnostic_kind.TOML_MALFORMED, "mach.toml is not valid TOML ({})", fail.describe(f));
}
