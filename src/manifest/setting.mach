# `--set`: a manifest key written over every table of its section for one invocation. the key
# and its value are read by the rows and decoders that read the key in a manifest, so a value
# `--set` gives is held to every rule the key keeps in mach.toml. a profile key is written over
# every profile, so the profile a build selects holds it whichever that is
use mach.base.fail;
use std.text.string.str_free;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use toml_tree: toml.tree;

use A: std.allocator;

use mach.base.intern;
use base_source: mach.base.source;
use mach.manifest.artifact.artifact_set;
use mach.manifest.model.ArtifactDef;
use mach.manifest.model.Manifest;
use mach.manifest.model.Origin;
use mach.manifest.model.ProfileDef;
use mach.manifest.model.TargetDef;
use mach.manifest.profile.profile_set;
use mach.manifest.schema;
use mach.manifest.target.target_set;

# one `--set <key>=<value>`, split at its first `=`
# ---
# key:   the manifest key, as mach.toml writes it
# value: the value, as written
pub rec Assignment {
    key:   str;
    value: str;
}

# write each assignment over every table of its key's section in `m`, in order, so a later
# assignment of a key wins
# ---
# alloc:   owns a refusal's text
# itn:     receives the strings
# sources: receives each assignment's text, which a refusal points into
# m:       the manifest, its native target included
# list:    the assignments
# n:       length of `list`
# ret:     ok, or the refusal of the first key `--set` does not write or value its key does not
#          accept
pub fun apply(alloc: *A.Allocator, itn: *intern.Interner, sources: *base_source.SourceMap, m: *Manifest, list: *Assignment,
    n: usize) err[fail.Fail] {
    var i: usize = 0;
    for (i < n) {
        val res_read: res[schema.Setting, fail.Fail] = schema.setting(alloc, sources, list[i].key, list[i].value);
        if (sel res_read.err) { ret err[fail.Fail].err{res_read.err}; }
        var s:           schema.Setting = res_read.ok;
        val err_written: err[fail.Fail] = write(alloc, itn, m, ?s);
        toml_tree.dnit(alloc, ?s.doc);
        str_free(alloc, s.text);
        if (sel err_written.err) { ret err[fail.Fail].err{fail.placed(err_written.err, s.file)}; }
        resolve(m, s.file);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# place in `file`, the `--set` text, every site a value it wrote records, so a later refusal of
# the value points at the `--set` that wrote it. a site mach.toml wrote is placed already
fun resolve(m: *Manifest, file: base_source.FileId) {
    var t: u32 = 0;
    for (t < m.target_count) {
        target_resolve(file, ?m.targets[t]);
        t = t + 1;
    }
    if (m.native_target != nil) { target_resolve(file, m.native_target); }
    var k: u32 = 0;
    for (k < m.artifact_count) {
        resolved(file, ?m.artifacts[k].subsystem_from);
        k = k + 1;
    }
    var p: u32 = 0;
    for (p < m.profile_count) {
        val pf: *ProfileDef = ?m.profiles[p];
        var e:  u32         = 0;
        for (e < pf.relax.count) {
            placed(file, ?pf.relax.sites[e]);
            e = e + 1;
        }
        p = p + 1;
    }
}

fun target_resolve(file: base_source.FileId, d: *TargetDef) {
    resolved(file, ?d.platform_from);
    resolved(file, ?d.base_from);
    resolved(file, ?d.stack_reserve_from);
    resolved(file, ?d.stack_commit_from);
}

fun resolved(file: base_source.FileId, o: *Origin) {
    placed(file, ?o.at);
}

fun placed(file: base_source.FileId, at: *base_source.Location) {
    if (base_source.file_same(at.file, base_source.FILE_PENDING)) { @at = base_source.location(file, at.span); }
}

fun write(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, s: *schema.Setting) err[fail.Fail] {
    if (str_equals(s.section, "target")) {
        var t: u32 = 0;
        for (t < m.target_count) {
            val err_set: err[fail.Fail] = target_set(alloc, itn, ?s.doc, nil, ?m.targets[t]);
            if (sel err_set.err) { ret err_set; }
            t = t + 1;
        }
        if (m.native_target != nil) { ret target_set(alloc, itn, ?s.doc, nil, m.native_target); }
        ret err[fail.Fail].ok{};
    }
    if (str_equals(s.section, "artifact")) {
        # the value is refused in a project that declares no artifact as in one that does
        var probe:    ArtifactDef;
        val err_read: err[fail.Fail] = artifact_set(alloc, itn, nil, ?s.doc, ?probe);
        if (sel err_read.err) { ret err_read; }
        var k: u32 = 0;
        for (k < m.artifact_count) {
            val err_set: err[fail.Fail] = artifact_set(alloc, itn, nil, ?s.doc, ?m.artifacts[k]);
            if (sel err_set.err) { ret err_set; }
            k = k + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (str_equals(s.section, "profile")) {
        var p: u32 = 0;
        for (p < m.profile_count) {
            val err_set: err[fail.Fail] = profile_set(alloc, itn, ?s.doc, nil, ?m.profiles[p]);
            if (sel err_set.err) { ret err_set; }
            m.profiles[p].written = true;
            p                     = p + 1;
        }
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("a key the schema marks for --set belongs to a section --set does not write")};
}
