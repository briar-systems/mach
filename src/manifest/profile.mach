# the decoding of the `[profile.<name>]` tables, and the rule of at most one default

use mach.base.fail;
use base_source: mach.base.source;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.intern;

use mach.manifest.model;
use mach.manifest.model.Manifest;
use mach.manifest.model.NameList;
use mach.manifest.model.Origin;
use mach.manifest.model.PassChoices;
use mach.manifest.model.ProfileDef;
use mach.manifest.model.SimdMode;
use mach.manifest.model.id_of;
use mach.manifest.refusal.Sites;
use mach.manifest.refusal.element_sites;
use mach.manifest.refusal.point_at;
use mach.manifest.refusal.refuse;
use mach.manifest.refusal.sfmt;
use mach.manifest.refusal.sites_add;
use mach.manifest.refusal.sites_fail;
use mach.manifest.refusal.sites_init;
use mach.manifest.refusal.span_site;
use mach.manifest.schema.SET_PATH;
use mach.manifest.schema.StrArr;
use mach.manifest.schema.flag;
use mach.manifest.schema.ids_of;
use mach.manifest.schema.key_span;
use mach.manifest.schema.origin;
use mach.manifest.schema.value_span;
use mach.manifest.schema.value_text;
use mach.manifest.schema.written_value;

# the names the array `arr` lists, each where it is written. a name listed
# twice is refused at its second place
# ---
# label: the table's label in mach.toml, or `--set`
# key:   the key that writes the array
# named: the key as a refusal names it, its table's label or `--set` before it
fun names_decode(alloc: *A.Allocator, itn: *intern.Interner, arr: *toml_value.Array, label: str, key: str, named: str) res[NameList, fail.Fail] {
    var out:         NameList               = NameList{items: nil, sites: nil, count: 0};
    val res_decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr, label, key);
    if (sel res_decoded.err) { ret res[NameList, fail.Fail].err{res_decoded.err}; }
    out.items = res_decoded.ok.items;
    out.count = res_decoded.ok.count;
    var handed: bool = false;
    fin {
        if (!handed) { model.names_dnit(alloc, ?out); }
    }
    val res_placed: res[*base_source.Location, fail.Fail] = element_sites(alloc, arr);
    if (sel res_placed.err) { ret res[NameList, fail.Fail].err{res_placed.err}; }
    out.sites = res_placed.ok;
    var i: u32 = 0;
    for (i < out.count) {
        var j: u32 = 0;
        for (j < i) {
            if (intern.str_same(out.items[i], out.items[j])) {
                val f: fail.Fail = fail.at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "{} lists \"{}\" twice", named, intern.text(itn, out.items[i])), out.sites[i]);
                ret res[NameList, fail.Fail].err{f};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    handed = true;
    ret res[NameList, fail.Fail].ok{out};
}

# the keys of a `passes` table into `c`, each where its key is written, a name `c` holds already taking the
# value written last. the schema check holds every value a boolean, and which names are passes is the build
# request's to check against mirl's list
# ---
# alloc: owns the choices' storage
# itn:   interns each pass name
# tab:   the `passes` table
# named: the table as a refusal names it, its table's label or `--set` before it
# c:     receives the choices
# ret:   ok, or the failure of interning a name or growing `c`
fun passes_decode(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml_value.Table, named: str, c: *PassChoices) err[fail.Fail] {
    val n: usize = toml_lookup.table_len(tab);
    var i: usize = 0;
    for (i < n) {
        val opt_key:   opt[str]               = toml_lookup.table_key(tab, i);
        val opt_value: opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
        if (sel opt_key.none)   { brk; }
        if (sel opt_value.none) { brk; }
        val res_name: res[intern.StrId, fail.Fail] = id_of(itn, opt_key.some);
        if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
        val err_set: err[fail.Fail] = model.choices_set(alloc, c, res_name.ok, opt_value.some.data.boolean, named, span_site(key_span(tab, i)));
        if (sel err_set.err) { ret err_set; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# `simd`, the value `v`, as the key named `named` writes it
fun parse_simd_mode(alloc: *A.Allocator, named: str, v: *toml_value.Value) res[SimdMode, fail.Fail] {
    val opt_named: opt[SimdMode] = model.simd_named(v.data.string);
    if (sel opt_named.some) { ret res[SimdMode, fail.Fail].ok{opt_named.some}; }
    val res_value_text: res[str, fail.Fail] = value_text(alloc, v);
    if (sel res_value_text.err) { ret res[SimdMode, fail.Fail].err{res_value_text.err}; }
    ret res[SimdMode, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "{} must be \"scalarize\" or \"require\", found {}", named, res_value_text.ok), v.span)};
}

# `[profile.X].allow`: the warning kinds the profile silences, each entry a key
# or a family of keys from the diagnostic kind table, named once. an unknown
# entry is refused, and so is one that covers only errors, since only a warning
# can be silenced
fun parse_allow(alloc: *A.Allocator, named: str, arr: *toml_value.Array) res[diagnostic_kind.KindSet, fail.Fail] {
    var set: diagnostic_kind.KindSet = diagnostic_kind.set_make();
    val n:   usize                   = toml_lookup.array_len(arr);
    var i:   usize                   = 0;
    for (i < n) {
        val opt_array_get: opt[*toml_value.Value] = toml_lookup.array_get(arr, i);
        if (sel opt_array_get.none) { brk; }
        val e:      *toml_value.Value         = opt_array_get.some;
        val entry:  str                       = e.data.string;
        var picked: diagnostic_kind.Selection = diagnostic_kind.select(entry);
        if (diagnostic_kind.selection_unknown(?picked)) {
            val res_keys: res[str, fail.Fail] = warning_keys(alloc);
            if (sel res_keys.err) { ret res[diagnostic_kind.KindSet, fail.Fail].err{res_keys.err}; }
            ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.ALLOW_UNKNOWN_KEY, "{} entry \"{}\" is not a warning key. the warning keys are {}", named, entry, res_keys.ok), e.span)};
        }
        if (diagnostic_kind.selection_is_empty(?picked)) {
            ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.ALLOW_ERROR_KEY, "{} entry \"{}\" names an error, and only a warning can be silenced", named, entry), e.span)};
        }
        var j: usize = 0;
        for (j < i) {
            val opt_prior: opt[*toml_value.Value] = toml_lookup.array_get(arr, j);
            if (sel opt_prior.some) {
                val pv: *toml_value.Value = opt_prior.some;
                if (pv.tag == toml_value.TYPE_STRING && str_equals(pv.data.string, entry)) {
                    ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.ALLOW_DUPLICATE_KEY, "{} lists \"{}\" twice", named, entry), e.span)};
                }
            }
            j = j + 1;
        }
        diagnostic_kind.set_union(?set, ?picked.warnings);
        i = i + 1;
    }
    ret res[diagnostic_kind.KindSet, fail.Fail].ok{set};
}

# the keys an allow entry can name, the warning rows that are not retired, quoted and comma
# separated
fun warning_keys(alloc: *A.Allocator) res[str, fail.Fail] {
    var names: str   = "";
    var i:     usize = 0;
    for (i < diagnostic_kind.COUNT) {
        val row: *diagnostic_kind.Spec = diagnostic_kind.at(i);
        i = i + 1;
        if (row.level != diagnostic_kind.LEVEL_WARNING || row.retired) { cnt; }
        var res_longer: res[str, fail.Fail];
        if (str_is_empty(names))  { res_longer = sfmt(alloc, "\"{}\"", row.key); }
        or                        { res_longer = sfmt(alloc, "{}, \"{}\"", names, row.key); }
        if (!str_is_empty(names)) { str_free(alloc, names); }
        if (sel res_longer.err)   { ret res_longer; }
        names = res_longer.ok;
    }
    ret res[str, fail.Fail].ok{names};
}

# more than one `default = true` profile is refused, pointing at the first
# `default` value and naming the others as related
pub fun default_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { count = count + 1; }
        i = i + 1;
    }
    if (count <= 1) { ret err[fail.Fail].ok{}; }
    var names: str = "";
    i = 0;
    for (i < m.profile_count) {
        val pf: *ProfileDef = ?m.profiles[i];
        i = i + 1;
        if (!pf.is_default) { cnt; }
        var res_longer: res[str, fail.Fail];
        if (str_is_empty(names)) { res_longer = sfmt(alloc, "[profile.{}]", intern.text(itn, pf.name)); }
        or                       { res_longer = sfmt(alloc, "{}, [profile.{}]", names, intern.text(itn, pf.name)); }
        if (sel res_longer.err)  { ret err[fail.Fail].err{res_longer.err}; }
        names = res_longer.ok;
    }
    var sites: Sites = sites_init(alloc);
    i = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { sites_add(?sites, m.profiles[i].default_at); }
        i = i + 1;
    }
    ret err[fail.Fail].err{sites_fail(alloc, ?sites, refuse(alloc, diagnostic_kind.SELECTION_DUPLICATE_DEFAULT,
        "mach.toml: {} profiles declare `default = true` ({}), and only one may", count, names))};
}

# every key of a profile the table `sub` holds, decoded over `pf`: `optimize`, `debug`,
# `linker_relax`, `symbols`, `sections`, `unwind`, `relax`, `simd` and `allow`. a key `sub` does not hold leaves `pf` as it is,
# and `default`, which picks the profile a build selects, is read by the caller
# ---
# alloc: owns a refusal's text and the lists it decodes
# itn:   receives the strings
# sub:   the table
# lead:  the table's label in mach.toml, nil for a `--set` value
# pf:    the profile
# ret:   ok, or the refusal of a value its key does not take, or a refused allocation
pub fun profile_set(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, lead: str, pf: *ProfileDef) err[fail.Fail] {
    val opt_debug: opt[bool] = toml_lookup.get_bool(sub, "debug");
    if (sel opt_debug.some) { pf.debug = opt_debug.some; }
    val opt_optimize: opt[bool] = toml_lookup.get_bool(sub, "optimize");
    if (sel opt_optimize.some) { pf.optimize = opt_optimize.some; }
    val opt_linker_relax: opt[bool] = toml_lookup.get_bool(sub, "linker_relax");
    if (sel opt_linker_relax.some) { pf.linker_relax = opt_linker_relax.some; }
    val opt_symbols: opt[bool] = toml_lookup.get_bool(sub, "symbols");
    if (sel opt_symbols.some) { pf.symbols = opt_symbols.some; }
    val opt_sections: opt[bool] = toml_lookup.get_bool(sub, "sections");
    if (sel opt_sections.some) { pf.sections = opt_sections.some; }
    val opt_unwind: opt[bool] = toml_lookup.get_bool(sub, "unwind");
    if (sel opt_unwind.some) { pf.unwind = opt_unwind.some; }
    var label: str = lead;
    if (label == nil) { label = SET_PATH; }
    val opt_relax: opt[*toml_value.Array] = toml_lookup.get_array(sub, "relax");
    if (sel opt_relax.some) {
        val res_from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "relax");
        if (sel res_from.err) { ret err[fail.Fail].err{res_from.err}; }
        val res_relax: res[NameList, fail.Fail] = names_decode(alloc, itn, opt_relax.some, label, "relax", res_from.ok.named);
        if (sel res_relax.err) { ret err[fail.Fail].err{res_relax.err}; }
        model.names_dnit(alloc, ?pf.relax);
        pf.relax       = res_relax.ok;
        pf.relax_named = res_from.ok.named;
    }
    val opt_passes: opt[*toml_value.Table] = toml_lookup.get_table(sub, "passes");
    if (sel opt_passes.some) {
        val res_from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "passes");
        if (sel res_from.err) { ret err[fail.Fail].err{res_from.err}; }
        val err_chosen: err[fail.Fail] = passes_decode(alloc, itn, opt_passes.some, res_from.ok.named, ?pf.passes);
        if (sel err_chosen.err) { ret err_chosen; }
    }
    val v: *toml_value.Value = written_value(sub, "simd");
    if (v != nil) {
        val res_from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "simd");
        if (sel res_from.err) { ret err[fail.Fail].err{res_from.err}; }
        val res_simd: res[SimdMode, fail.Fail] = parse_simd_mode(alloc, res_from.ok.named, v);
        if (sel res_simd.err) { ret err[fail.Fail].err{res_simd.err}; }
        pf.simd = res_simd.ok;
    }
    val opt_allow: opt[*toml_value.Array] = toml_lookup.get_array(sub, "allow");
    if (sel opt_allow.some) {
        val res_from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "allow");
        if (sel res_from.err) { ret err[fail.Fail].err{res_from.err}; }
        val res_allow: res[diagnostic_kind.KindSet, fail.Fail] = parse_allow(alloc, res_from.ok.named, opt_allow.some);
        if (sel res_allow.err) { ret err[fail.Fail].err{res_allow.err}; }
        pf.allow = res_allow.ok;
    }
    ret err[fail.Fail].ok{};
}

# the `[profile.*]` tables; the schema check admits no manifest without one
pub fun parse_profiles(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val opt_tab: opt[*toml_value.Table] = toml_lookup.get_table(t, "profile");
    if (sel opt_tab.none) { ret err[fail.Fail].err{fail.message("a manifest passed its schema check without [profile.*]")}; }
    val tab: *toml_value.Table = opt_tab.some;
    val n:   usize             = toml_lookup.table_len(tab);
    if (n == 0) { ret err[fail.Fail].err{fail.message("a manifest passed its schema check without [profile.*]")}; }

    val res_profiles: res[*ProfileDef, A.Error] = A.allocate[ProfileDef](alloc, n);
    if (sel res_profiles.err) { ret err[fail.Fail].err{fail.refused(res_profiles.err)}; }
    m.profiles      = res_profiles.ok;
    m.profile_count = n::u32;
    var z: usize = 0;
    for (z < n) {
        m.profiles[z] = model.profile_def();
        z             = z + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val opt_name:        opt[str]               = toml_lookup.table_key(tab, i);
        val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
        if (sel opt_name.none)        { brk; }
        if (sel opt_table_value.none) { brk; }
        val name: str               = opt_name.some;
        val v:    *toml_value.Value = opt_table_value.some;
        val sub:  *toml_value.Table = ?v.data.table;

        val res_name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
        if (sel res_name_id.err) { ret err[fail.Fail].err{res_name_id.err}; }
        # the manifest holds the profile before its lists are decoded, so a refusal frees them with it
        val pf: *ProfileDef = ?m.profiles[i];
        pf.name       = res_name_id.ok;
        pf.at         = span_site(v.key);
        pf.default_at = span_site(value_span(sub, "default"));
        pf.is_default = flag(sub, "default");
        val res_label: res[str, fail.Fail] = sfmt(alloc, "[profile.{}]", name);
        if (sel res_label.err) { ret err[fail.Fail].err{res_label.err}; }
        val err_set: err[fail.Fail] = profile_set(alloc, itn, sub, res_label.ok, pf);
        str_free(alloc, res_label.ok);
        if (sel err_set.err) { ret err_set; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
