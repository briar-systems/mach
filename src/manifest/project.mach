# the decoding of the `[project]` table, and the expansion of its `work` directory

use mach.base.fail;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use toml_value: toml.value;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.intern;
use manifest_version: mach.manifest.version;

use mach.manifest.model.Manifest;
use mach.manifest.model.id_of;
use mach.manifest.refusal.fail_at;
use mach.manifest.refusal.refuse;
use mach.manifest.refusal.span_site;
use mach.manifest.schema.check_path;
use mach.manifest.schema.is_project_id;
use mach.manifest.schema.key_text;
use mach.manifest.schema.project_id_refused;
use mach.manifest.schema.value_span;
use mach.manifest.schema.written_value;
use mach.manifest.template;

# decode the `[project]` table of `t` into `m`: its id, version, src, work and
# `mach` compiler range
# ---
# alloc: owns a refusal's text
# itn:   interns the values
# t:     the manifest's root table, its `[project]` already held to the schema
# m:     the manifest the fields are set on
# ret:   ok, or the refusal of a path, of an id that is not a project id, of a
#        version that is not a version, or of a `mach` value that is not a valid range
pub fun parse_project(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val proj_v: *toml_value.Value = written_value(t, "project");
    if (proj_v == nil) { ret err[fail.Fail].err{fail.message("a manifest passed its schema check without [project]")}; }
    m.project_at = span_site(proj_v.span);
    val proj: *toml_value.Table = ?proj_v.data.table;

    val id_str:   str = key_text(proj, "id");
    val ver_str:  str = key_text(proj, "version");
    val src_str:  str = key_text(proj, "src");
    val work_str: str = key_text(proj, "work");

    val err_check_src: err[fail.Fail] = check_path(alloc, src_str, "[project].src", value_span(proj, "src"));
    if (sel err_check_src.err) { ret err_check_src; }
    val err_check_work: err[fail.Fail] = check_path(alloc, work_str, "[project].work", value_span(proj, "work"));
    if (sel err_check_work.err) { ret err_check_work; }

    if (!is_project_id(id_str)) { ret fail_at(project_id_refused(alloc, id_str), value_span(proj, "id")); }
    val res_ver: res[manifest_version.Version, str] = manifest_version.parse_version(ver_str);
    if (sel res_ver.err) {
        ret fail_at(refuse(alloc, diagnostic_kind.VERSION_INVALID, "mach.toml: [project].version = \"{}\" is not a version ({}). a version is major.minor.patch, as 1.2.3, with an optional -pre-release and +build", ver_str, res_ver.err), value_span(proj, "version"));
    }
    val mach_str:   str                                                      = key_text(proj, "mach");
    val mach_span:  toml_value.Span                                          = value_span(proj, "mach");
    val res_parsed: res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(mach_str);
    if (sel res_parsed.err) {
        ret fail_at(refuse(alloc, diagnostic_kind.VERSION_INVALID_RANGE, "mach.toml: [project].mach = \"{}\" is not a valid range. {} (clause {})", mach_str, res_parsed.err.reason, res_parsed.err.clause), mach_span);
    }
    val res_mach_id: res[intern.StrId, fail.Fail] = id_of(itn, mach_str);
    if (sel res_mach_id.err) { ret err[fail.Fail].err{res_mach_id.err}; }
    m.mach    = res_mach_id.ok;
    m.mach_at = span_site(mach_span);
    val res_id_of: res[intern.StrId, fail.Fail] = id_of(itn, id_str);
    if (sel res_id_of.err) { ret err[fail.Fail].err{res_id_of.err}; }
    val res_version: res[intern.StrId, fail.Fail] = id_of(itn, ver_str);
    if (sel res_version.err) { ret err[fail.Fail].err{res_version.err}; }
    val res_src: res[intern.StrId, fail.Fail] = id_of(itn, src_str);
    if (sel res_src.err) { ret err[fail.Fail].err{res_src.err}; }
    val res_work: res[intern.StrId, fail.Fail] = id_of(itn, work_str);
    if (sel res_work.err) { ret err[fail.Fail].err{res_work.err}; }
    m.id        = res_id_of.ok;
    m.version   = res_version.ok;
    m.src       = res_src.ok;
    m.work_tmpl = res_work.ok;
    m.work_at   = span_site(value_span(proj, "work"));
    ret err[fail.Fail].ok{};
}

# expand `m`'s `[project].work` with `v`; a refusal points at the `work` value
pub fun expand_project_work(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, v: *template.Values) res[str, fail.Fail] {
    val res_path_expand: res[str, fail.Fail] = template.path_expand(alloc, intern.text(itn, m.work_tmpl), template.CONTEXT_PROJECT_WORK, "", v, "[project].work");
    if (sel res_path_expand.err) { ret res[str, fail.Fail].err{fail.at(res_path_expand.err, m.work_at)}; }
    ret res_path_expand;
}
