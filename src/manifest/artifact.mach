# the `[artifact.<name>]` tables: their decoding, `--set` over them, and lookups
#
# at most one artifact is `export = true`, an artifact's `out` expands through the
# template engine, and its PE subsystem is named as mink spells it.

use mach.base.fail;
use base_source: mach.base.source;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.intern;
use mach_target: mach.target;
use mach.target.resolved;
use mink_fail:   mink.base.fail;
use mink_output: mink.catalog.output;
use mink.catalog.output.Spelled;
use mink_subsystem: mink.catalog.subsystem;
use mink_layout:    mink.link.layout;

use mach.manifest.model.ArtifactDef;
use mach.manifest.model.Manifest;
use mach.manifest.model.Origin;
use mach.manifest.model.RegionDef;
use mach.manifest.model.artifact_def;
use mach.manifest.model.id_of;
use mach.manifest.need;
use mach.manifest.refusal.Sites;
use mach.manifest.refusal.element_sites;
use mach.manifest.refusal.fail_at;
use mach.manifest.refusal.point_at;
use mach.manifest.refusal.refuse;
use mach.manifest.refusal.sfmt;
use mach.manifest.refusal.sites_add;
use mach.manifest.refusal.sites_fail;
use mach.manifest.refusal.sites_init;
use mach.manifest.refusal.span_site;
use mach.manifest.schema.StrArr;
use mach.manifest.schema.check_path;
use mach.manifest.schema.flag;
use mach.manifest.schema.ids_of;
use mach.manifest.schema.key_text;
use mach.manifest.schema.origin;
use mach.manifest.schema.value_span;
use mach.manifest.schema.written_value;
use mach.manifest.target.resolve_declared;
use mach.manifest.template;

# every key `--set` writes over an artifact that the table `sub` holds, decoded over `d` with
# where it was written; a key `sub` does not hold leaves `d` as it is
# ---
# alloc: owns a refusal's text
# itn:   holds the name a refusal of the value leads with
# lead:  the artifact table's label in mach.toml, nil for a `--set` value
# sub:   the table
# d:     the artifact
# ret:   ok, or the refusal of a value the key does not accept
pub fun artifact_set(alloc: *A.Allocator, itn: *intern.Interner, lead: str, sub: *toml_value.Table, d: *ArtifactDef) err[fail.Fail] {
    val v: *toml_value.Value = written_value(sub, "subsystem");
    if (v == nil) { ret err[fail.Fail].ok{}; }
    val res_from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "subsystem");
    if (sel res_from.err) { ret err[fail.Fail].err{res_from.err}; }
    val res_parsed: res[*mink_subsystem.Subsystem, str] = subsystem_named(alloc, v.data.string);
    if (sel res_parsed.err) { ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "{} is invalid. {}", res_from.ok.named, res_parsed.err), v.span)}; }
    d.subsystem          = res_parsed.ok;
    d.subsystem_declared = true;
    d.subsystem_from     = res_from.ok;
    ret err[fail.Fail].ok{};
}

# the PE subsystem mink spells `name`, or why it names none: the spelling a previous major took
# for the graphical subsystem is refused naming mink's, and any other unknown name is refused
# listing mink's
# ---
# a:   owns the refusal's text
# ret: mink's row, or the refusal's text
pub fun subsystem_named(a: *A.Allocator, name: str) res[*mink_subsystem.Subsystem, str] {
    val res_found: res[*mink_subsystem.Subsystem, mink_fail.Fail] = mink_subsystem.by_name(name);
    if (sel res_found.ok) { ret res[*mink_subsystem.Subsystem, str].ok{res_found.ok}; }
    if (str_equals(name, "gui")) {
        ret res[*mink_subsystem.Subsystem, str].err{"\"gui\" is spelled \"windows\" since v7, as mink spells the PE subsystem (mach migrate rewrites it)"};
    }
    var names: str   = "";
    var i:     usize = 0;
    for (i < mink_subsystem.count()) {
        val row:        *mink_subsystem.Subsystem = mink_subsystem.at(i);
        var res_joined: res[str, fail.Fail]       = sfmt(a, "{}, \"{}\"", names, row.name);
        if (i == 0)             { res_joined = sfmt(a, "\"{}\"", row.name); }
        if (sel res_joined.err) { ret res[*mink_subsystem.Subsystem, str].err{"names no PE subsystem mink states"}; }
        names = res_joined.ok;
        i     = i + 1;
    }
    val res_text: res[str, fail.Fail] = sfmt(a, "\"{}\" is not a PE subsystem. write one of {}", name, names);
    if (sel res_text.err) { ret res[*mink_subsystem.Subsystem, str].err{"names no PE subsystem mink states"}; }
    ret res[*mink_subsystem.Subsystem, str].err{res_text.ok};
}

fun parse_resource_path(alloc: *A.Allocator, itn: *intern.Interner, label: str,
    sub: *toml_value.Table, key: str) res[intern.StrId, fail.Fail] {
    val v: *toml_value.Value = written_value(sub, key);
    if (v == nil) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    val res_field: res[str, fail.Fail] = sfmt(alloc, "{}.{}", label, key);
    if (sel res_field.err) { ret res[intern.StrId, fail.Fail].err{res_field.err}; }
    val err_checked: err[fail.Fail] = check_path(alloc, v.data.string, res_field.ok, v.span);
    str_free(alloc, res_field.ok);
    if (sel err_checked.err) { ret res[intern.StrId, fail.Fail].err{err_checked.err}; }
    ret id_of(itn, v.data.string);
}

pub fun parse_artifacts(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val opt_arts: opt[*toml_value.Table] = toml_lookup.get_table(t, "artifact");
    if (sel opt_arts.none) { ret err[fail.Fail].ok{}; }
    val arts: *toml_value.Table = opt_arts.some;
    val n:    usize             = toml_lookup.table_len(arts);
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val res_artifacts: res[*ArtifactDef, A.Error] = A.allocate[ArtifactDef](alloc, n);
    if (sel res_artifacts.err) { ret err[fail.Fail].err{fail.refused(res_artifacts.err)}; }
    m.artifacts      = res_artifacts.ok;
    m.artifact_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        m.artifacts[initialized] = artifact_def();
        initialized              = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val err_artifact: err[fail.Fail] = parse_one_artifact(alloc, itn, arts, i, ?m.artifacts[i]);
        if (sel err_artifact.err) { ret err_artifact; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun parse_one_artifact(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml_value.Table, k: usize, d: *ArtifactDef) err[fail.Fail] {
    val opt_name:        opt[str]               = toml_lookup.table_key(tab, k);
    val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(tab, k);
    if (sel opt_name.none)        { ret err[fail.Fail].err{fail.message("an [artifact] entry index is outside its table")}; }
    if (sel opt_table_value.none) { ret err[fail.Fail].err{fail.message("an [artifact] entry index is outside its table")}; }
    val res_label: res[str, fail.Fail] = sfmt(alloc, "[artifact.{}]", opt_name.some);
    if (sel res_label.err) { ret err[fail.Fail].err{res_label.err}; }
    fin { str_free(alloc, res_label.ok); }
    ret artifact_decode(alloc, itn, opt_name.some, res_label.ok, opt_table_value.some, ?opt_table_value.some.data.table, d);
}

# the ids of the string array `key` of `sub` and where each is written, into
# `items`, `count` and `sites`; nothing when the key is not written
fun entries_decode(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, label: str, key: str,
    items: **intern.StrId, count: *u32, sites: **base_source.Location) err[fail.Fail] {
    val opt_arr: opt[*toml_value.Array] = toml_lookup.get_array(sub, key);
    if (sel opt_arr.none) { ret err[fail.Fail].ok{}; }
    val res_decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, opt_arr.some, label, key);
    if (sel res_decoded.err) { ret err[fail.Fail].err{res_decoded.err}; }
    @items = res_decoded.ok.items;
    @count = res_decoded.ok.count;
    val res_placed: res[*base_source.Location, fail.Fail] = element_sites(alloc, opt_arr.some);
    if (sel res_placed.err) { ret err[fail.Fail].err{res_placed.err}; }
    @sites = res_placed.ok;
    ret err[fail.Fail].ok{};
}

fun artifact_decode(alloc: *A.Allocator, itn: *intern.Interner, name: str, label: str, v: *toml_value.Value,
    sub: *toml_value.Table, d: *ArtifactDef) err[fail.Fail] {
    val res_name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel res_name_id.err) { ret err[fail.Fail].err{res_name_id.err}; }
    d.name       = res_name_id.ok;
    d.at         = span_site(v.key);
    d.default_at = span_site(value_span(sub, "default"));
    d.is_default = flag(sub, "default");
    d.export_at  = span_site(value_span(sub, "export"));
    d.is_export  = flag(sub, "export");

    val res_kind: res[Spelled, mink_fail.Fail] = mink_output.spelled(key_text(sub, "kind"));
    if (sel res_kind.err) {
        val res_why: res[str, fail.Fail] = resolved.summary(alloc, res_kind.err);
        if (sel res_why.err) { ret err[fail.Fail].err{res_why.err}; }
        val refused: fail.Fail = refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: in {}.kind, {}", label, res_why.ok);
        ret fail_at(refused, value_span(sub, "kind"));
    }
    d.kind    = res_kind.ok;
    d.kind_at = span_site(value_span(sub, "kind"));

    val err_linked: err[fail.Fail] = linkage_decode(alloc, itn, label, sub, d);
    if (sel err_linked.err) { ret err_linked; }

    val entry_s:         str                 = key_text(sub, "entry");
    val res_entry_field: res[str, fail.Fail] = sfmt(alloc, "{}.entry", label);
    if (sel res_entry_field.err) { ret err[fail.Fail].err{res_entry_field.err}; }
    val err_check_entry: err[fail.Fail] = check_path(alloc, entry_s, res_entry_field.ok, value_span(sub, "entry"));
    str_free(alloc, res_entry_field.ok);
    if (sel err_check_entry.err) { ret err_check_entry; }
    val res_entry_id: res[intern.StrId, fail.Fail] = id_of(itn, entry_s);
    if (sel res_entry_id.err) { ret err[fail.Fail].err{res_entry_id.err}; }
    d.entry    = res_entry_id.ok;
    d.entry_at = span_site(value_span(sub, "entry"));

    # an object artifact's objects stay under obj/, so it states no out, which the schema refuses
    # as written; every other kind delivers one file at its out
    val out_s: str = key_text(sub, "out");
    if (mach_target.per_module(d.kind)) { ret artifact_rest(alloc, itn, label, sub, d); }
    if (str_is_empty(out_s)) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} is missing required key 'out', where a kind = \"{}\" artifact delivers its file", label, mach_target.kind_name(d.kind)), v.span);
    }
    val res_out_field: res[str, fail.Fail] = sfmt(alloc, "{}.out", label);
    if (sel res_out_field.err) { ret err[fail.Fail].err{res_out_field.err}; }
    val err_check_out: err[fail.Fail] = check_path(alloc, out_s, res_out_field.ok, value_span(sub, "out"));
    str_free(alloc, res_out_field.ok);
    if (sel err_check_out.err) { ret err_check_out; }
    val res_out_id: res[intern.StrId, fail.Fail] = id_of(itn, out_s);
    if (sel res_out_id.err) { ret err[fail.Fail].err{res_out_id.err}; }
    d.out    = res_out_id.ok;
    d.out_at = span_site(value_span(sub, "out"));
    ret artifact_rest(alloc, itn, label, sub, d);
}

# the keys an artifact states besides its kind, linkage, entry and out
fun artifact_rest(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml_value.Table, d: *ArtifactDef) err[fail.Fail] {
    d.targets_at = span_site(value_span(sub, "targets"));
    val opt_targets: opt[*toml_value.Array] = toml_lookup.get_array(sub, "targets");
    if (sel opt_targets.none) { ret err[fail.Fail].err{fail.message("an artifact passed its schema check without targets")}; }
    val res_targets: res[StrArr, fail.Fail] = ids_of(alloc, itn, opt_targets.some, label, "targets");
    if (sel res_targets.err) { ret err[fail.Fail].err{res_targets.err}; }
    d.targets      = res_targets.ok.items;
    d.target_count = res_targets.ok.count;

    val err_links: err[fail.Fail] = entries_decode(alloc, itn, sub, label, "link", ?d.link, ?d.link_count, ?d.link_at);
    if (sel err_links.err) { ret err_links; }
    val err_needs: err[fail.Fail] = entries_decode(alloc, itn, sub, label, "need", ?d.need, ?d.need_count, ?d.need_at);
    if (sel err_needs.err) { ret err_needs; }

    val err_set: err[fail.Fail] = artifact_set(alloc, itn, label, sub, d);
    if (sel err_set.err) { ret err_set; }

    val res_icon: res[intern.StrId, fail.Fail] = parse_resource_path(alloc, itn, label, sub, "icon");
    if (sel res_icon.err) { ret err[fail.Fail].err{res_icon.err}; }
    d.icon = res_icon.ok;

    val res_manifest: res[intern.StrId, fail.Fail] = parse_resource_path(alloc, itn, label, sub, "manifest");
    if (sel res_manifest.err) { ret err[fail.Fail].err{res_manifest.err}; }
    d.app_manifest = res_manifest.ok;

    val err_placed: err[fail.Fail] = layout_decode(alloc, itn, label, sub, d);
    if (sel err_placed.err) { ret err_placed; }

    if (d.is_export && !mach_target.is_library(d.kind)) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.export marks the library whose requirements travel to consumers, and a kind = \"{}\" artifact is no library", label, mach_target.kind_name(d.kind)), value_span(sub, "export"));
    }

    if (!mach_target.is_executable(d.kind) && (!intern.str_is_nil(d.icon) || !intern.str_is_nil(d.app_manifest))) {
        var conflict: toml_value.Span = value_span(sub, "icon");
        if (intern.str_is_nil(d.icon)) { conflict = value_span(sub, "manifest"); }
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.icon and .manifest apply only to kind = \"bin\" artifacts", label), conflict);
    }
    ret err[fail.Fail].ok{};
}

# the `linkage` an artifact states its executable with, by name, refused for a kind other than
# bin, which no linkage applies to. mink resolves the name against the target's host as the
# target resolves, and refuses one it names no executable of, or one the host's loader runs not
fun linkage_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml_value.Table, d: *ArtifactDef) err[fail.Fail] {
    val v: *toml_value.Value = written_value(sub, "linkage");
    if (v == nil) { ret err[fail.Fail].ok{}; }
    val res_from: res[Origin, fail.Fail] = origin(alloc, itn, sub, label, "linkage");
    if (sel res_from.err) { ret err[fail.Fail].err{res_from.err}; }
    if (!mach_target.is_executable(d.kind)) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT,
            "{} is not allowed here, because a linkage applies only to kind = \"bin\", as only an executable is linked as one, and this artifact is kind = \"{}\"", res_from.ok.named, mach_target.kind_name(d.kind)), v.span)};
    }
    val res_named: res[intern.StrId, fail.Fail] = id_of(itn, v.data.string);
    if (sel res_named.err) { ret err[fail.Fail].err{res_named.err}; }
    d.linkage      = res_named.ok;
    d.linkage_from = res_from.ok;
    ret err[fail.Fail].ok{};
}

# the layout an artifact states its link: the section order, the size ceiling and the
# memory regions, each section running in at most one region and loading in at most one
# other, which mink lays out as a linker script's MEMORY and AT> do
fun layout_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml_value.Table, d: *ArtifactDef) err[fail.Fail] {
    val err_ordered: err[fail.Fail] = entries_decode(alloc, itn, sub, label, "sections", ?d.sections, ?d.section_count, ?d.sections_at);
    if (sel err_ordered.err) { ret err_ordered; }
    val opt_size: opt[i64] = toml_lookup.get_int(sub, "size");
    if (sel opt_size.some) {
        if (opt_size.some <= 0) { ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.size must be a positive byte count", label), value_span(sub, "size")); }
        d.size    = opt[u64].some{opt_size.some::u64};
        d.size_at = span_site(value_span(sub, "size"));
    }
    val opt_regions: opt[*toml_value.Table] = toml_lookup.get_table(sub, "region");
    if (sel opt_regions.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml_value.Table = opt_regions.some;
    val n:   usize             = toml_lookup.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_made: res[*RegionDef, A.Error] = A.allocate[RegionDef](alloc, n);
    if (sel res_made.err) { ret err[fail.Fail].err{fail.refused(res_made.err)}; }
    d.regions      = res_made.ok;
    d.region_count = n::u32;
    var i: usize = 0;
    for (i < n) {
        d.regions[i].run        = nil;
        d.regions[i].run_count  = 0;
        d.regions[i].load       = nil;
        d.regions[i].load_count = 0;
        i                       = i + 1;
    }
    i = 0;
    for (i < n) {
        val err_decoded: err[fail.Fail] = region_decode(alloc, itn, label, tab, i, ?d.regions[i]);
        if (sel err_decoded.err) { ret err_decoded; }
        i = i + 1;
    }
    ret regions_check(alloc, itn, label, sub, d);
}

fun region_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, tab: *toml_value.Table, i: usize, r: *RegionDef) err[fail.Fail] {
    val opt_name:        opt[str]               = toml_lookup.table_key(tab, i);
    val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
    if (sel opt_name.none)        { ret err[fail.Fail].err{fail.message("a region entry index is outside its table")}; }
    if (sel opt_table_value.none) { ret err[fail.Fail].err{fail.message("a region entry index is outside its table")}; }
    val sub:      *toml_value.Table            = ?opt_table_value.some.data.table;
    val res_name: res[intern.StrId, fail.Fail] = id_of(itn, opt_name.some);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    r.name = res_name.ok;
    r.at   = span_site(opt_table_value.some.key);
    val start: i64 = written_integer(sub, "origin");
    if (start < 0) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.region.{}.origin must not be negative, as it is an address", label, opt_name.some), value_span(sub, "origin"));
    }
    val span: i64 = written_integer(sub, "length");
    if (span <= 0) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.region.{}.length must be a positive byte count", label, opt_name.some), value_span(sub, "length"));
    }
    r.origin = start::u64;
    r.length = span::u64;
    val access: str   = key_text(sub, "access");
    var bits:   u8    = 0;
    var k:      usize = 0;
    for (access[k] != 0) {
        var bit: u8 = 0;
        if (access[k] == 'r') { bit = mink_layout.READABLE; }
        or (access[k] == 'w') { bit = mink_layout.WRITABLE; }
        or (access[k] == 'x') { bit = mink_layout.EXECUTABLE; }
        if (bit == 0 || (bits & bit) != 0) {
            ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.region.{}.access is the letters r, w and x, each at most once (got \"{}\")", label, opt_name.some, access), value_span(sub, "access"));
        }
        bits = bits | bit;
        k    = k + 1;
    }
    r.access = bits;
    var run_at:   *base_source.Location = nil;
    val err_runs: err[fail.Fail]        = entries_decode(alloc, itn, sub, label, "run", ?r.run, ?r.run_count, ?run_at);
    if (run_at != nil && r.run_count > 0) { A.deallocate[base_source.Location](alloc, run_at, r.run_count::usize); }
    if (sel err_runs.err)                 { ret err_runs; }
    var load_at:   *base_source.Location = nil;
    val err_loads: err[fail.Fail]        = entries_decode(alloc, itn, sub, label, "load", ?r.load, ?r.load_count, ?load_at);
    if (load_at != nil && r.load_count > 0) { A.deallocate[base_source.Location](alloc, load_at, r.load_count::usize); }
    ret err_loads;
}

# the integer the schema check admitted under `key`, 0 when it is not written
fun written_integer(sub: *toml_value.Table, key: str) i64 {
    val opt_int: opt[i64] = toml_lookup.get_int(sub, key);
    if (sel opt_int.some) { ret opt_int.some; }
    ret 0;
}

# each section runs in at most one region and loads in at most one, and a section that
# loads in a region runs in another
fun regions_check(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml_value.Table, d: *ArtifactDef) err[fail.Fail] {
    val at: toml_value.Span = value_span(sub, "region");
    var i:  u32             = 0;
    for (i < d.region_count) {
        val r: *RegionDef = ?d.regions[i];
        var k: u32        = 0;
        for (k < r.run_count) {
            if (regions_holding(d, r.run[k], true) > 1) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} runs section '{}' in more than one region", label, intern.text(itn, r.run[k])), at);
            }
            k = k + 1;
        }
        k = 0;
        for (k < r.load_count) {
            if (regions_holding(d, r.load[k], false) > 1) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} loads section '{}' in more than one region", label, intern.text(itn, r.load[k])), at);
            }
            if (regions_holding(d, r.load[k], true) == 0) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} loads section '{}' in region '{}' but runs it in no region. a section loads apart only from the region it runs in", label, intern.text(itn, r.load[k]), intern.text(itn, r.name)), at);
            }
            if (holds(r.run, r.run_count, r.load[k])) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} loads section '{}' in region '{}', the same region it runs in. a section loads apart only from the region it runs in", label, intern.text(itn, r.load[k]), intern.text(itn, r.name)), at);
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# how many regions of `d` run, or with `run` false load, the section `s`
fun regions_holding(d: *ArtifactDef, s: intern.StrId, run: bool) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < d.region_count) {
        val r: *RegionDef = ?d.regions[i];
        if (run && holds(r.run, r.run_count, s))    { n = n + 1; }
        if (!run && holds(r.load, r.load_count, s)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun holds(items: *intern.StrId, count: u32, s: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(items[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# more than one `export = true` artifact is refused, pointing at each `export` value
pub fun export_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var names: str = "";
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        i = i + 1;
        if (!a.is_export) { cnt; }
        var res_longer: res[str, fail.Fail];
        if (count == 0)         { res_longer = sfmt(alloc, "[artifact.{}]", intern.text(itn, a.name)); }
        or                      { res_longer = sfmt(alloc, "{}, [artifact.{}]", names, intern.text(itn, a.name)); }
        if (sel res_longer.err) { ret err[fail.Fail].err{res_longer.err}; }
        names = res_longer.ok;
        count = count + 1;
    }
    if (count <= 1) { ret err[fail.Fail].ok{}; }
    var sites: Sites = sites_init(alloc);
    i = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].is_export) { sites_add(?sites, m.artifacts[i].export_at); }
        i = i + 1;
    }
    ret err[fail.Fail].err{sites_fail(alloc, ?sites, refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT,
        "mach.toml: {} artifacts declare `export = true` ({}), and a project exports at most one library", count, names))};
}

# the export library: the one artifact marked `export = true`, nil when none is
pub fun export_artifact(m: *Manifest) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].is_export) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

# the artifact `m` declares under `name`, nil when none is
pub fun find_artifact(itn: *intern.Interner, m: *Manifest, name: str) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (str_equals(intern.text(itn, m.artifacts[i].name), name)) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_artifact_by_name(m: *Manifest, name: intern.StrId) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (intern.str_same(m.artifacts[i].name, name)) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether a `need` entry of `a` selects `other`, a different artifact
pub fun artifact_needs_artifact(itn: *intern.Interner, a: *ArtifactDef, other: *ArtifactDef) bool {
    if (a == other) { ret false; }
    var i: u32 = 0;
    for (i < a.need_count) {
        if (need.selects(itn, a.need[i], need.CATEGORY_ARTIFACT, other.name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# expand an artifact's `out` for the target `vars` names. a refusal of the target points at the
# target, one of the artifact's kind at its `kind`, and one of the template at its `out`
pub fun expand_artifact_output(alloc: *A.Allocator, itn: *intern.Interner, a: *ArtifactDef, project_work: str, vars: *template.Values) res[str, fail.Fail] {
    val tmpl: str             = intern.text(itn, a.out);
    var v:    template.Values = @vars;
    if (str_contains(tmpl, "{artifact.suffix}")) {
        if (v.declared == nil) { ret res[str, fail.Fail].err{fail.message("{artifact.suffix} expanded with no target")}; }
        val res_selected: res[resolved.Target, fail.Fail] = resolve_declared(alloc, itn, v.declared, a.linkage, ?a.linkage_from);
        if (sel res_selected.err) { ret res[str, fail.Fail].err{res_selected.err}; }
        var target:    resolved.Target                          = res_selected.ok;
        val res_named: res[mach_target.ArtifactName, fail.Fail] = mach_target.artifact_naming(alloc, ?target, a.kind);
        if (sel res_named.err) { ret res[str, fail.Fail].err{fail.at(res_named.err, a.kind_at)}; }
        v.artifact_suffix = res_named.ok.suffix;
    }
    val res_expanded: res[str, fail.Fail] = template.path_expand(alloc, tmpl, template.CONTEXT_ARTIFACT_OUT, project_work, ?v, "an artifact output");
    if (sel res_expanded.err) { ret res[str, fail.Fail].err{fail.at(res_expanded.err, a.out_at)}; }
    ret res_expanded;
}

# whether an artifact's `targets` lists a target name or "*"
# ---
# itn:   resolves the names
# a:     the artifact
# tname: the target name
# ret:   true when listed
pub fun artifact_supports_target(itn: *intern.Interner, a: *ArtifactDef, tname: intern.StrId) bool {
    var i: u32 = 0;
    for (i < a.target_count) {
        if (intern.str_same(a.targets[i], tname) || str_equals(intern.text(itn, a.targets[i]), "*")) { ret true; }
        i = i + 1;
    }
    ret false;
}
