    RetiredExt{old: "subgroup_vote", new: "GroupNonUniformVote"},
    RetiredExt{old: "subgroup_ballot", new: "GroupNonUniformBallot"},
    RetiredExt{old: "subgroup_shuffle", new: "GroupNonUniformShuffle"},
    RetiredExt{old: "subgroup_shuffle_relative", new: "GroupNonUniformShuffleRelative"},
    RetiredExt{old: "subgroup_quad", new: "GroupNonUniformQuad"},
    RetiredExt{old: "subgroup_graphics_stages", new: ""},
    RetiredExt{old: "buffer_int64_atomics", new: "Int64Atomics"},
    RetiredExt{old: "shared_int64_atomics", new: "Int64Atomics"},
    RetiredExt{old: "buffer_float32_atomics", new: ""},
    RetiredExt{old: "buffer_float32_atomic_add", new: "AtomicFloat32AddEXT"},
    RetiredExt{old: "buffer_float32_atomic_add", new: "SPV_EXT_shader_atomic_float_add"},
    RetiredExt{old: "buffer_float32_atomic_min_max", new: "AtomicFloat32MinMaxEXT"},
    RetiredExt{old: "buffer_float32_atomic_min_max", new: "SPV_EXT_shader_atomic_float_min_max"},
    RetiredExt{old: "buffer_float64_atomics", new: ""},
    RetiredExt{old: "buffer_float64_atomic_add", new: "AtomicFloat64AddEXT"},
    RetiredExt{old: "buffer_float64_atomic_add", new: "SPV_EXT_shader_atomic_float_add"},
    RetiredExt{old: "buffer_float64_atomic_min_max", new: "AtomicFloat64MinMaxEXT"},
    RetiredExt{old: "buffer_float64_atomic_min_max", new: "SPV_EXT_shader_atomic_float_min_max"},
    RetiredExt{old: "shared_float32_atomics", new: ""},
    RetiredExt{old: "shared_float32_atomic_add", new: "AtomicFloat32AddEXT"},
    RetiredExt{old: "shared_float32_atomic_add", new: "SPV_EXT_shader_atomic_float_add"},
    RetiredExt{old: "shared_float32_atomic_min_max", new: "AtomicFloat32MinMaxEXT"},
    RetiredExt{old: "shared_float32_atomic_min_max", new: "SPV_EXT_shader_atomic_float_min_max"},
    RetiredExt{old: "shared_float64_atomics", new: ""},
    RetiredExt{old: "shared_float64_atomic_add", new: "AtomicFloat64AddEXT"},
    RetiredExt{old: "shared_float64_atomic_add", new: "SPV_EXT_shader_atomic_float_add"},
    RetiredExt{old: "shared_float64_atomic_min_max", new: "AtomicFloat64MinMaxEXT"},
    RetiredExt{old: "shared_float64_atomic_min_max", new: "SPV_EXT_shader_atomic_float_min_max"},
    RetiredExt{old: "storage_image_multisample", new: "StorageImageMultisample"},
    RetiredExt{old: "storage_image_multisample", new: "ImageMSArray"},
    RetiredExt{old: "resource_min_lod", new: "MinLod"},
    RetiredExt{old: "image_gather_extended", new: "ImageGatherExtended"},
    RetiredExt{old: "maintenance8", new: ""},
    RetiredExt{old: "image_int64_atomics", new: "Int64Atomics"},
