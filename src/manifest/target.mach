# the `[target.<name>]` tables: their decoding, `--set`, migration and resolution
#
# `resolve_declared` is the one place a declared target becomes mink's spelling and
# narrowing. the host's target, made for a manifest that declares none, and the
# `<sys>-<arch>` spelling of a target are made here too.

use mach.base.fail;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.intern;
use base_source:     mach.base.source;
use mach_target:     mach.target;
use target_baseline: mach.target.baseline;
use mach.target.resolved;
use target_tags: mach.target.tags;
use mink_fail:   mink.base.fail;
use mink_arch:   mink.catalog.arch;
use mink_target: mink.catalog.target;

use mach.manifest.model.Manifest;
use mach.manifest.model.Origin;
use mach.manifest.model.TARGET_PART_KEYS;
use mach.manifest.model.TargetDef;
use mach.manifest.model.id_of;
use mach.manifest.model.optional_id_of;
use mach.manifest.model.target_def;
use mach.manifest.refusal.element_sites;
use mach.manifest.refusal.fail_at;
use mach.manifest.refusal.refuse;
use mach.manifest.refusal.sfmt;
use mach.manifest.refusal.span_site;
use mach.manifest.schema.Fix;
use mach.manifest.schema.StrArr;
use mach.manifest.schema.element_span;
use mach.manifest.schema.ids_of;
use mach.manifest.schema.key_span;
use mach.manifest.schema.key_text;
use mach.manifest.schema.origin;
use mach.manifest.schema.value_span;
use mach.manifest.schema.written_address;

# the host as `mach info` names it, by `tuple_of`
# ---
# alloc: owns the returned string
# ret:   the formatted tuple; err when the allocator refused it
pub fun host_tuple(alloc: *A.Allocator) res[str, fail.Fail] {
    ret tuple_of(alloc, mach_target.host_sys_name(), mach_target.host_arch_name());
}

# the one spelling of a (sys, arch) pair, "<sys>-<arch>", e.g. "linux-x86_64"
# ---
# alloc:    owns the returned string
# os_name:  the system's name
# isa_name: the architecture's name
# ret:      the formatted tuple; err when the allocator refused it
pub fun tuple_of(alloc: *A.Allocator, os_name: str, isa_name: str) res[str, fail.Fail] {
    ret sfmt(alloc, "{}-{}", os_name, isa_name);
}

# `[target.X].ext`: an array of names of masc's extension catalog, each listed
# once. the names are checked against masc's catalog of the architecture when
# the target resolves
fun parse_target_extensions(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, label: str,
    d: *TargetDef) err[fail.Fail] {
    val opt_sub_entry: opt[*toml_value.Value] = toml_lookup.get(sub, "ext");
    if (sel opt_sub_entry.none) { ret err[fail.Fail].ok{}; }
    val v:   *toml_value.Value = opt_sub_entry.some;
    val arr: *toml_value.Array = ?v.data.array;
    val n:   usize             = toml_lookup.array_len(arr);
    if (n > resolved.MAX_ADDED::usize) {
        ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_TOO_MANY, "mach.toml: {}.ext names more than {} extensions", label, resolved.MAX_ADDED), v.span);
    }
    var i: usize = 0;
    for (i < n) {
        val opt_array_get: opt[*toml_value.Value] = toml_lookup.array_get(arr, i);
        if (sel opt_array_get.none) { brk; }
        val e:    *toml_value.Value = opt_array_get.some;
        val name: str               = e.data.string;
        if (str_len(name) == 0) {
            ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_INVALID_NAME, "mach.toml: {}.ext entry \"\" names no extension", label), e.span);
        }
        val res_id_of: res[intern.StrId, fail.Fail] = id_of(itn, name);
        if (sel res_id_of.err) { ret err[fail.Fail].err{res_id_of.err}; }
        val id: intern.StrId = res_id_of.ok;
        var j:  u32          = 0;
        for (j < d.ext_count) {
            if (intern.str_same(d.ext[j], id)) {
                ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_DUPLICATE, "mach.toml: {}.ext lists \"{}\" twice", label, name), e.span);
            }
            j = j + 1;
        }
        d.ext[d.ext_count] = id;
        d.ext_count        = d.ext_count + 1;
        i                  = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# decode every `[target.<name>]` table of `t` into `m.targets`, nothing when there is none
# ---
# alloc: owns the target array, its runner lists and a refusal's text
# itn:   interns the names and values
# t:     the manifest's root table
# m:     the manifest the targets are set on
# ret:   ok, or the refusal of a table named `native`, of a retired spelling, or of the
#        first target that does not decode
pub fun parse_targets(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val opt_tab: opt[*toml_value.Table] = toml_lookup.get_table(t, "target");
    if (sel opt_tab.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml_value.Table = opt_tab.some;
    val n:   usize             = toml_lookup.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_targets: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, n);
    if (sel res_targets.err) { ret err[fail.Fail].err{fail.refused(res_targets.err)}; }
    m.targets      = res_targets.ok;
    m.target_count = n::u32;
    var cleared: usize = 0;
    for (cleared < n) {
        m.targets[cleared] = target_def();
        cleared            = cleared + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val opt_name:        opt[str]               = toml_lookup.table_key(tab, i);
        val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
        if (sel opt_name.none)        { brk; }
        if (sel opt_table_value.none) { brk; }
        val name: str = opt_name.some;
        if (str_equals(name, "native")) {
            ret fail_at(fail.user(diagnostic_kind.TARGET_RESERVED_NAME, "mach.toml: [target.native] is reserved, because 'native' names the declared target for the host"), key_span(tab, i));
        }
        val res_label: res[str, fail.Fail] = sfmt(alloc, "[target.{}]", name);
        if (sel res_label.err) { ret err[fail.Fail].err{res_label.err}; }
        val err_decoded: err[fail.Fail] = target_decode(alloc, itn, tab, i, res_label.ok, ?m.targets[i]);
        str_free(alloc, res_label.ok);
        if (sel err_decoded.err) { ret err_decoded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a spelling a target key no longer takes, and mink's name for the row it meant
# ---
# key:  the target key
# was:  the key's previous name, which a manifest of the previous major writes it under; "" for none
# old:  the retired spelling
# new:  the spelling that replaces it, mink's name for the row
# arch: the architecture the spelling is retired under, "" under every one
# sys:  the system the spelling is retired under, "" under every one
rec Retired {
    key:  str;
    was:  str;
    old:  str;
    new:  str;
    arch: str;
    sys:  str;
}

# raw and spv were mach's own names for mink's flat and spirv formats, a spir-v module's
# system is vulkan, never freestanding, under the shader convention v6 named spirv, and
# darwin on aarch64 runs only darwin's variant of aapcs64, which v6 named aapcs64
val RETIRED_COUNT: usize                  = 5;
val RETIRED:       [RETIRED_COUNT]Retired = [RETIRED_COUNT]Retired{
    Retired{key: "of", was: "", old: "raw", new: "flat", arch: "", sys: ""},
    Retired{key: "of", was: "", old: "spv", new: "spirv", arch: "", sys: ""},
    Retired{key: "sys", was: "os", old: "freestanding", new: "vulkan", arch: "spirv", sys: ""},
    Retired{key: "abi", was: "", old: "spirv", new: "shader", arch: "spirv", sys: ""},
    Retired{key: "abi", was: "", old: "aapcs64", new: "darwinpcs", arch: "aarch64", sys: "darwin"},
};

# one name that replaces a device feature name of the previous major's closed spir-v `ext`
# vocabulary, which this major spells as masc's capability and SPIR-V extension names
# ---
# old: the retired name
# new: one name that replaces it, "" for a feature that enables no capability
rec RetiredExt {
    old: str;
    new: str;
}

# a name replaced by several has a row for each, and one that enables no capability has one
# row with no replacement
val RETIRED_EXT_COUNT: usize                         = 72;
val RETIRED_EXT:       [RETIRED_EXT_COUNT]RetiredExt = [RETIRED_EXT_COUNT]RetiredExt{
    RetiredExt{old: "float16", new: "Float16"},
    RetiredExt{old: "zero_init_workgroup", new: ""},
