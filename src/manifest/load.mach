# reading a manifest: its TOML held to the schema, decoded into the model and checked
#
# one rule holds for every key whoever reads the manifest, so a dependency's manifest is
# held to exactly the rules of the project being built. a refusal points at the key or
# value it concerns.

use std.allocator.arena;
use T: std.allocator.testing;
use std.print;
use std.text.string.str_dup;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use toml_error: toml.error;
use toml_parse: toml.parse;
use toml_tree:  toml.tree;
use toml_value: toml.value;

use A:                  std.allocator;
use chrono_duration:    std.chrono.duration;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:         std.filesystem;
use types_path: std.types.path;

use diagnostic_kind: mach.base.diagnostic.kind;
use mach.base.fail;
use mach.base.intern;
use base_source: mach.base.source;
use mach.manifest.artifact.export_validate;
use mach.manifest.artifact.parse_artifacts;
use mach.manifest.dep.parse_deps;
use mach.manifest.link.find_link_by_name;
use mach.manifest.link.parse_links;
use mach.manifest.model.ArtifactDef;
use mach.manifest.model.LINK_LOCAL;
use mach.manifest.model.LinkDef;
use mach.manifest.model.Manifest;
use mach.manifest.model.StepDef;
use mach.manifest.model.TARGET_PART_KEYS;
use mach.manifest.model.TargetDef;
use mach.manifest.model.dnit;
use mach.manifest.model.init;
use mach.manifest.model.site_of;
use mach.manifest.need;
use mach.manifest.profile;
use mach.manifest.project.parse_project;
use mach.manifest.refusal.refuse;
use mach.manifest.refusal.sfmt;
use mach.manifest.schema;
use mach.manifest.step.parse_steps;
use mach.manifest.target.native_target_init;
use mach.manifest.target.parse_targets;
use mach.manifest.template;

# build a `Manifest` from a parsed TOML document, in three stages. the schema
# check holds the document to the rows of `mach.manifest.schema`: a key no
# row names, a value of the wrong shape, a missing required key and a removed key
# are refused where they are written. decoding then reads each table into the
# model and refuses a value its key does not accept. validation last checks the
# rules that span entries and values: `need` entries and their cycles, `link`
# names, at most one `default = true` profile, and every template against what
# its place admits. one rule holds for every key whoever reads the manifest, so
# a dependency's manifest is held to exactly the rules of the project being
# built. on any error every array allocated so far is freed
# ---
# alloc: owns the manifest's arrays
# itn:   receives every string of the manifest
# doc:   the manifest's text and its TOML document
# ret:   the manifest, or the first error as a "mach.toml: ..." message pointing at
#        the key or value in `doc` it concerns. the manifest records where each
#        field a later refusal names is written, in `doc`'s file
pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, doc: *Doc) res[Manifest, fail.Fail] {
    val res_parse_table: res[Manifest, fail.Fail] = parse_table(alloc, itn, ?doc.table);
    if (sel res_parse_table.err) { ret res[Manifest, fail.Fail].err{fail.placed(res_parse_table.err, doc.file)}; }
    var m: Manifest = res_parse_table.ok;
    resolve_sites(doc.file, ?m);
    ret res[Manifest, fail.Fail].ok{m};
}

# place every site the model recorded while parsing in `lines`, the manifest's file
fun resolve_sites(lines: base_source.FileId, m: *Manifest) {
    m.project_at = resolved(lines, m.project_at);
    m.mach_at    = resolved(lines, m.mach_at);
    m.work_at    = resolved(lines, m.work_at);
    var i: u32 = 0;
    for (i < m.target_count) {
        val d: *TargetDef = ?m.targets[i];
        d.at                    = resolved(lines, d.at);
        d.platform_from.at      = resolved(lines, d.platform_from.at);
        d.base_from.at          = resolved(lines, d.base_from.at);
        d.stack_reserve_from.at = resolved(lines, d.stack_reserve_from.at);
        d.stack_commit_from.at  = resolved(lines, d.stack_commit_from.at);
        resolve_all(lines, ?d.parts_at[0], TARGET_PART_KEYS::u32);
        i = i + 1;
    }
    i = 0;
    for (i < m.profile_count) {
        m.profiles[i].at         = resolved(lines, m.profiles[i].at);
        m.profiles[i].default_at = resolved(lines, m.profiles[i].default_at);
        resolve_all(lines, m.profiles[i].relax.sites, m.profiles[i].relax.count);
        var c: u32 = 0;
        for (c < m.profiles[i].passes.count) {
            m.profiles[i].passes.items[c].at = resolved(lines, m.profiles[i].passes.items[c].at);
            c                                = c + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        a.at                = resolved(lines, a.at);
        a.kind_at           = resolved(lines, a.kind_at);
        a.size_at           = resolved(lines, a.size_at);
        a.pad_at            = resolved(lines, a.pad_at);
        a.default_at        = resolved(lines, a.default_at);
        a.export_at         = resolved(lines, a.export_at);
        a.entry_at          = resolved(lines, a.entry_at);
        a.out_at            = resolved(lines, a.out_at);
        a.targets_at        = resolved(lines, a.targets_at);
        a.subsystem_from.at = resolved(lines, a.subsystem_from.at);
        a.linkage_from.at   = resolved(lines, a.linkage_from.at);
        resolve_all(lines, a.link_at, a.link_count);
        resolve_all(lines, a.sections_at, a.section_count);
        resolve_all(lines, a.need_at, a.need_count);
        var r: u32 = 0;
        for (r < a.region_count) {
            a.regions[r].at = resolved(lines, a.regions[r].at);
            r               = r + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        m.links[i].at      = resolved(lines, m.links[i].at);
        m.links[i].path_at = resolved(lines, m.links[i].path_at);
        m.links[i].dir_at  = resolved(lines, m.links[i].dir_at);
        i                  = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s: *StepDef = ?m.steps[i];
        s.at = resolved(lines, s.at);
        resolve_all(lines, s.argv_at, s.argv_count);
        resolve_all(lines, s.env_at, s.env_count);
        resolve_all(lines, s.env_in_at, s.env_in_count);
        resolve_all(lines, s.in_at, s.in_count);
        resolve_all(lines, s.out_at, s.out_count);
        resolve_all(lines, s.need_at, s.need_count);
        i = i + 1;
    }
}

# `at` placed in `lines` when it is still pending a file, else as it is
fun resolved(lines: base_source.FileId, at: base_source.Location) base_source.Location {
    if (!base_source.file_same(at.file, base_source.FILE_PENDING)) { ret at; }
    ret base_source.location(lines, at.span);
}

fun resolve_all(lines: base_source.FileId, sites: *base_source.Location, count: u32) {
    if (sites == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        sites[i] = resolved(lines, sites[i]);
        i        = i + 1;
    }
}

# the `[project]` table of a parsed TOML document alone, held to its rows as
# `parse` holds it, for a reader such as `mach fmt` that needs nothing else
# ---
# alloc: owns the refusal's text
# itn:   receives the table's strings
# t:     the document root
# m:     receives the project fields
# ret:   ok, or the first refusal
pub fun project_parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val err_shaped: err[fail.Fail] = schema.section_check(alloc, t, "project");
    if (sel err_shaped.err) { ret err_shaped; }
    ret parse_project(alloc, itn, t, m);
}

# a manifest's text, the file it was read from, its slot in the source map its
# reader holds, and its TOML tree, owned through the allocator that made it and
# released with `doc_dnit`. a failure that names a key points into `file`
pub rec Doc {
    path:  str;
    text:  str;
    file:  base_source.FileId;
    table: toml_value.Table;
}

# `text`, the manifest at `path`, as a doc whose text is loaded into `sources`:
# bytes a manifest refuses and a document that is not TOML are failures pointing
# at the byte refused. the doc keeps its own copies of both
pub fun doc_parse(alloc: *A.Allocator, sources: *base_source.SourceMap, path: str, text: str) res[Doc, fail.Fail] {
    ret doc_parse_bytes(alloc, sources, path, text::*u8, str_len(text));
}

# `doc_parse` over the `n` bytes at `data`, which need not end in a NUL and may
# hold one, which is refused where it is written
pub fun doc_parse_bytes(alloc: *A.Allocator, sources: *base_source.SourceMap, path: str, data: *u8, n: usize) res[Doc, fail.Fail] {
    val res_loaded: res[base_source.FileId, fail.Fail] = source_load(alloc, sources, path, data, n);
    if (sel res_loaded.err) { ret res[Doc, fail.Fail].err{res_loaded.err}; }
    val res_table: res[toml_value.Table, toml_error.TomlError] = toml_parse.parse_bytes(alloc, data, n);
    if (sel res_table.err) { ret res[Doc, fail.Fail].err{fail.placed(fail.toml_refused(res_table.err), res_loaded.ok)}; }
    var table:  toml_value.Table = res_table.ok;
    var handed: bool             = false;
    fin {
        if (!handed) { toml_tree.dnit(alloc, ?table); }
    }
    val res_path: res[str, A.Error] = str_dup(alloc, path);
    if (sel res_path.err) { ret res[Doc, fail.Fail].err{fail.refused(res_path.err)}; }
    val path_copy: str = res_path.ok;
    fin {
        if (!handed) { str_free(alloc, path_copy); }
    }
    val res_text: res[str, A.Error] = str_dup_range(alloc, data::str, 0, n);
    if (sel res_text.err) { ret res[Doc, fail.Fail].err{fail.refused(res_text.err)}; }
    handed = true;
    ret res[Doc, fail.Fail].ok{Doc{path: res_path.ok, text: res_text.ok, file: res_loaded.ok, table: table}};
}

# the `n` bytes at `data`, the file at `path`, loaded into `sources` so a refusal can point
# into them; a NUL ends the text the map holds, and a refusal at it points at its end
pub fun source_load(alloc: *A.Allocator, sources: *base_source.SourceMap, path: str, data: *u8, n: usize) res[base_source.FileId, fail.Fail] {
    val res_text: res[str, A.Error] = str_dup_range(alloc, data::str, 0, n);
    if (sel res_text.err) { ret res[base_source.FileId, fail.Fail].err{fail.refused(res_text.err)}; }
    val text: str = res_text.ok;
    fin { str_free(alloc, text); }
    val res_loaded: res[base_source.FileId, base_source.Error] = base_source.load(sources, path, text);
    if (sel res_loaded.err) { ret res[base_source.FileId, fail.Fail].err{fail.source_refused(res_loaded.err)}; }
    ret res[base_source.FileId, fail.Fail].ok{res_loaded.ok};
}

# the manifest file at `path` read and parsed as `doc_parse` parses it; a file
# that cannot be read is refused as a path the project names
pub fun doc_read(alloc: *A.Allocator, sources: *base_source.SourceMap, path: str) res[Doc, fail.Fail] {
    val res_read_bytes: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel res_read_bytes.err) { ret res[Doc, fail.Fail].err{fail.refusal(alloc, diagnostic_kind.FS_READ, fail.Op{verb: "read", path: path, given: true}, fail.Cause.fs{res_read_bytes.err})}; }
    var bytes: Vector[u8] = res_read_bytes.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    ret doc_parse_bytes(alloc, sources, path, bytes.data, bytes.len);
}

# the file name of a project manifest, looked up in a project root
pub val MANIFEST_FILE: str = "mach.toml";

# the manifest `text`, read from `path`, parsed and checked
# ---
# alloc:   owns the manifest, released with `dnit`, and a refusal's text
# itn:     interns its names
# sources: receives the text, which a refusal points into
# ret:     the manifest; err as the text does not parse or fails a check
pub fun parse_text(alloc: *A.Allocator, itn: *intern.Interner, sources: *base_source.SourceMap, path: str, text: str) res[Manifest, fail.Fail] {
    val res_doc: res[Doc, fail.Fail] = doc_parse(alloc, sources, path, text);
    if (sel res_doc.err) { ret res[Manifest, fail.Fail].err{res_doc.err}; }
    var doc: Doc = res_doc.ok;
    fin { doc_dnit(alloc, ?doc); }
    ret parse(alloc, itn, ?doc);
}

# the manifest of the project rooted at `dir`, read off disk and parsed
# ---
# alloc:   owns the manifest, released with `dnit`, and a refusal's text
# itn:     interns its names
# sources: receives the text, which a refusal points into
# dir:     the project root, which holds MANIFEST_FILE
# ret:     the manifest; err from the environment when it cannot be read, else as
#          it does not parse or fails a check
pub fun read_at(alloc: *A.Allocator, itn: *intern.Interner, sources: *base_source.SourceMap, dir: str) res[Manifest, fail.Fail] {
    val res_path: res[str, A.Error] = types_path.join(alloc, dir, MANIFEST_FILE);
    if (sel res_path.err) { ret res[Manifest, fail.Fail].err{fail.refused(res_path.err)}; }
    val path: str = res_path.ok;
    fin { str_free(alloc, path); }
    val res_doc: res[Doc, fail.Fail] = doc_read(alloc, sources, path);
    if (sel res_doc.err) { ret res[Manifest, fail.Fail].err{res_doc.err}; }
    var doc: Doc = res_doc.ok;
    fin { doc_dnit(alloc, ?doc); }
    ret parse(alloc, itn, ?doc);
}

# what a manifest states that every compiler reads alike, before holding it to its own schema:
# the project id and the compiler range it builds with, and where the range is written. a
# manifest written for another compiler's schema is read this far, so its range can refuse it
# ahead of a key this schema removed or renamed. each text is empty when the manifest does not
# write it as a string, and borrows from the doc
# ---
# id:      `[project].id`
# mach:    `[project].mach`
# mach_at: where `mach`'s value is written, in the doc's file, or nowhere
pub rec Header {
    id:      str;
    mach:    str;
    mach_at: base_source.Location;
}

# the header `doc` states, read from its TOML tree with no schema check
pub fun header(doc: *Doc) Header {
    var at: base_source.Location = base_source.location_nil();
    val sp: toml_value.Span      = schema.value_span(?doc.table, "project.mach");
    if (sp.at != 0 || sp.len != 0) { at = base_source.location(doc.file, base_source.span(sp.at, sp.len)); }
    ret Header{id: schema.key_text(?doc.table, "project.id"), mach: schema.key_text(?doc.table, "project.mach"), mach_at: at};
}

# release a doc and everything it owns
pub fun doc_dnit(alloc: *A.Allocator, d: *Doc) {
    toml_tree.dnit(alloc, ?d.table);
    if (d.text != nil) { str_free(alloc, d.text); }
    if (d.path != nil) { str_free(alloc, d.path); }
    d.text = nil;
    d.path = nil;
}

fun parse_table(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table) res[Manifest, fail.Fail] {
    val err_shaped: err[fail.Fail] = schema.check(alloc, t);
    if (sel err_shaped.err) { ret res[Manifest, fail.Fail].err{err_shaped.err}; }

    var m:           Manifest = init();
    var transferred: bool     = false;
    fin {
        if (!transferred) { dnit(?m, alloc); }
    }

    val err_project: err[fail.Fail] = parse_project(alloc, itn, t, ?m);
    if (sel err_project.err) { ret res[Manifest, fail.Fail].err{err_project.err}; }

    val err_targets: err[fail.Fail] = parse_targets(alloc, itn, t, ?m);
    if (sel err_targets.err) { ret res[Manifest, fail.Fail].err{err_targets.err}; }

    val err_artifacts: err[fail.Fail] = parse_artifacts(alloc, itn, t, ?m);
    if (sel err_artifacts.err) { ret res[Manifest, fail.Fail].err{err_artifacts.err}; }

    val err_profiles: err[fail.Fail] = profile.parse_profiles(alloc, itn, t, ?m);
    if (sel err_profiles.err) { ret res[Manifest, fail.Fail].err{err_profiles.err}; }

    val err_deps: err[fail.Fail] = parse_deps(alloc, itn, t, ?m);
    if (sel err_deps.err) { ret res[Manifest, fail.Fail].err{err_deps.err}; }

    val err_links: err[fail.Fail] = parse_links(alloc, itn, t, ?m);
    if (sel err_links.err) { ret res[Manifest, fail.Fail].err{err_links.err}; }

    val err_steps: err[fail.Fail] = parse_steps(alloc, itn, t, ?m);
    if (sel err_steps.err) { ret res[Manifest, fail.Fail].err{err_steps.err}; }

    val err_checked: err[fail.Fail] = check(alloc, itn, ?m);
    if (sel err_checked.err) { ret res[Manifest, fail.Fail].err{err_checked.err}; }
    transferred = true;
    ret res[Manifest, fail.Fail].ok{m};
}

# the checks every manifest model passes, whether decoded from mach.toml or made by an entry
# build: the rules that span its entries and values, then the host target it builds for where
# it declares none
# ---
# alloc: owns the model's arrays and a refusal's text
# itn:   holds the model's strings
# m:     the model, which gains its native target where it declares none
# ret:   ok, or the first refusal
pub fun check(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    val err_valid: err[fail.Fail] = validate(alloc, itn, m);
    if (sel err_valid.err) { ret err_valid; }
    if (m.target_count == 0) {
        val res_native: res[*TargetDef, fail.Fail] = native_target_init(alloc, itn);
        if (sel res_native.err) { ret err[fail.Fail].err{res_native.err}; }
        m.native_target = res_native.ok;
    }
    ret err[fail.Fail].ok{};
}

# the rules that span entries and values of a decoded manifest: every `need`
# entry names a declaration and no `need` chain cycles, every artifact `link`
# names a declared `[link.*]`, at most one profile is the default, at most one
# artifact is exported, and every template names only what its place admits
fun validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    val err_needs: err[fail.Fail] = need.validate(alloc, itn, m);
    if (sel err_needs.err) { ret err_needs; }
    val err_links: err[fail.Fail] = link_refs_validate(alloc, itn, m);
    if (sel err_links.err) { ret err_links; }
    val err_profiles: err[fail.Fail] = profile.default_validate(alloc, itn, m);
    if (sel err_profiles.err) { ret err_profiles; }
    val err_exports: err[fail.Fail] = export_validate(alloc, itn, m);
    if (sel err_exports.err) { ret err_exports; }
    ret templates_validate(alloc, itn, m);
}

fun link_refs_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                val res_known: res[str, fail.Fail] = link_table_names(alloc, itn, m);
                if (sel res_known.err) { ret err[fail.Fail].err{res_known.err}; }
                ret err[fail.Fail].err{fail.at(refuse(alloc, diagnostic_kind.LINK_UNKNOWN_TABLE, "mach.toml: [artifact.{}].link names '{}', which is no [link.*] table ({})",
                    intern.text(itn, a.name), intern.text(itn, a.link[li]), res_known.ok), site_of(a.link_at, li))};
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret err[fail.Fail].ok{};
}

# the declared `[link.*]` tables, as an unknown link's refusal lists them
fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) res[str, fail.Fail] {
    if (m.link_count == 0) { ret res[str, fail.Fail].ok{"no [link.*] table is declared"}; }
    var s: str = "the declared tables are ";
    var i: u32 = 0;
    for (i < m.link_count) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        val res_longer: res[str, fail.Fail] = sfmt(alloc, "{}{}[link.{}]", s, sep, intern.text(itn, m.links[i].name));
        if (sel res_longer.err) { ret res_longer; }
        s = res_longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# every template the manifest writes, checked against the variables its place
# admits; a refusal points at the template
fun templates_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    val err_work: err[fail.Fail] = template_validate(alloc, itn, m.work_tmpl, template.CONTEXT_PROJECT_WORK, m.work_at);
    if (sel err_work.err) { ret err_work; }
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        i = i + 1;
        if (intern.str_is_nil(a.out)) { cnt; }
        val err_checked: err[fail.Fail] = template_validate(alloc, itn, a.out, template.CONTEXT_ARTIFACT_OUT, a.out_at);
        if (sel err_checked.err) { ret err_checked; }
    }
    i = 0;
    for (i < m.link_count) {
        val l: *LinkDef = ?m.links[i];
        if (l.source == LINK_LOCAL) {
            val err_checked: err[fail.Fail] = template_validate(alloc, itn, l.path, template.CONTEXT_PATH, l.path_at);
            if (sel err_checked.err) { ret err_checked; }
        }
        if (!intern.str_is_nil(l.dir)) {
            val err_checked: err[fail.Fail] = template_validate(alloc, itn, l.dir, template.CONTEXT_PATH, l.dir_at);
            if (sel err_checked.err) { ret err_checked; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.target_count) {
        val t:           *TargetDef     = ?m.targets[i];
        val err_checked: err[fail.Fail] = templates_validate_each(alloc, itn, t.runner, t.runner_at, t.runner_count, template.CONTEXT_RUNNER);
        if (sel err_checked.err) { ret err_checked; }
        i = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s:        *StepDef       = ?m.steps[i];
        val err_argv: err[fail.Fail] = templates_validate_each(alloc, itn, s.argv, s.argv_at, s.argv_count, template.CONTEXT_STEP_VALUE);
        if (sel err_argv.err) { ret err_argv; }
        val err_envs: err[fail.Fail] = templates_validate_each(alloc, itn, s.env_values, s.env_at, s.env_count, template.CONTEXT_STEP_VALUE);
        if (sel err_envs.err) { ret err_envs; }
        val err_ins: err[fail.Fail] = templates_validate_each(alloc, itn, s.in, s.in_at, s.in_count, template.CONTEXT_PATH);
        if (sel err_ins.err) { ret err_ins; }
        val err_outs: err[fail.Fail] = templates_validate_each(alloc, itn, s.out, s.out_at, s.out_count, template.CONTEXT_PATH);
        if (sel err_outs.err) { ret err_outs; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun templates_validate_each(alloc: *A.Allocator, itn: *intern.Interner, ids: *intern.StrId, sites: *base_source.Location, count: u32,
    ctx: template.Context) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val err_checked: err[fail.Fail] = template_validate(alloc, itn, ids[i], ctx, site_of(sites, i));
        if (sel err_checked.err) { ret err_checked; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun template_validate(alloc: *A.Allocator, itn: *intern.Interner, id: intern.StrId, ctx: template.Context, at: base_source.Location) err[fail.Fail] {
    val err_checked: err[fail.Fail] = template.check(alloc, intern.text(itn, id), ctx);
    if (sel err_checked.err) { ret err[fail.Fail].err{fail.at(err_checked.err, at)}; }
    ret err_checked;
}
